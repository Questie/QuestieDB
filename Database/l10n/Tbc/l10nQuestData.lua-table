[1282] = {
  {
    'Chamam-no Jim Sorridente‡Зовут его Улыбка Джим‡Sie nennen ihn den lächelnden Jim‡유쾌한 짐이라 불리는 사나이‡Le llaman Jim Sonrisas‡Le llaman Jim Sonrisas‡Ils l\'appellent Jim le Souriant‡微笑的吉姆‡他們叫他微笑的吉姆',
    nil,
    'Fale com o Capitão Garrido Valente, no último andar da Cidadela do Esteio.‡Поговорите с капитаном Гарраном Ваймсом на верхнем этаже цитадели.‡Sprecht mit Hauptmann Garran Mumm auf der obersten Etage der Wehrzitadelle in Theramore.‡거점 요새의 최상층에 있는 사령관 개런 바임스와 대화해야 합니다.‡Habla con el capitán Garran Vimes que está en el piso de arriba de la Ciudadela Garrida.‡Habla con el capitán Garran Vimes que está en el piso de arriba de la Ciudadela Garrida.‡Parler au Capitaine Garran Vimaire au dernier étage de la citadelle de Theramore.‡与塞拉摩城堡顶层的盖兰·维米斯队长谈一谈。‡與塞拉摩堡壘的蓋蘭·維米斯上尉談話。',
  }
},
[1283] = {
  {
    '‡‡‡‡‡‡‡‡樹蔭旅店的大火',
    nil,
    nil,
  }
},
[1284] = {
  {
    'Pegadas em forma de casco‡Подозрительные следы копыт‡Verdächtige Hufabdrücke‡수상한 발굽 자국‡Huellas de pezuñas sospechosas‡Huellas de pezuñas sospechosas‡Des empreintes de sabots suspectes‡可疑的蹄印‡可疑的蹄印',
    nil,
    'Informe o Capitão Garrido Valente, em Theramore, sobre as pegadas suspeitas na Estalagem Pouso do Umbral.‡Доложите о подозрительных следах возле таверны "Последний привал" капитану Гаррану Ваймсу в Терамор.‡Berichtet Hauptmann Garran Mumm in Theramore von den verdächtigen Abdrücken beim Gasthaus Zur süßen Ruh.‡테라모어에 있는 사령관 개런 바임스에게 그늘 쉼터 여관의 수상한 흔적에 대해 보고해야 합니다.‡Informa al capitán Garran Vimes de Theramore sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Informa al capitán Garran Vimes, en Theramore, sobre las huellas sospechosas de la Posada Reposo Umbrío.‡Rapporter la présence des empreintes suspectes à l\'auberge du Repos ombragé au capitaine Vimaire à Theramore.‡把树荫旅店的可疑蹄印报告给塞拉摩的盖兰·维米斯队长。‡把樹蔭旅店的可疑蹄印報告給塞拉摩的蓋蘭·維米斯上尉。',
  }
},
[1285] = {
  {
    'Os homens de Daelin‡Солдаты Даэлина‡Daelins Männer‡대린의 부하‡Los hombres de Daelin‡Los hombres de Daelin‡Les hommes de Daelin‡戴林的下属‡戴林的下屬',
    nil,
    'Leve as informações sobre Reethe ao Capitão Garrido Valente em Theramore.‡Вернитесь с информацией о Рите к капитану Гаррану Ваймсу в Терамор.‡Kehrt mit den Informationen über Reethe zu Hauptmann Garran Mumm in Theramore zurück.‡테라모어에 있는 사령관 개런 바임스에게 돌아가 리테에 대한 정보를 전해야 합니다.‡Lleva la información sobre Reethe al capitán Garran Vimes a Theramore.‡Lleva la información sobre Reethe al capitán Garran Vimes a Theramore.‡Ramener l\'information concernant Reethe au capitaine Vimaire à Theramore.‡把雷瑟的资料报告给塞拉摩的盖兰·维米斯队长。‡把雷瑟的資料報告給塞拉摩的蓋蘭·維米斯上尉。',
  }
},
[1286] = {
  {
    'Os desertores‡Дезертиры‡Die Deserteure‡탈영병‡Los desertores‡Los desertores‡Les déserteurs‡背叛者‡叛逃者',
    nil,
    'Obtenha informações sobre Reethe de Balos Xavier e dos desertores no Pântano Vadeoso.‡Расспросите о Рите Балоса Хакена и его дезертиров в Пылевых топях.‡Sammelt Informationen über Reethe von Balos Jacken und den Deserteuren in den Düstermarschen.‡먼지진흙 습지대에 있는 밸로스 제킨과 탈영병들로부터 리테에 대한 정보를 알아내야 합니다.‡Consigue información sobre Reethe hablando con Balos Jacken y los desertores del Marjal Revolcafango.‡Consigue información sobre Reethe hablando con Balos Jacken y los desertores del Marjal Revolcafango.‡Obtenir des informations sur Reethe de Balos Jacken et des déserteurs dans le marécage d\'Âprefange.‡从巴鲁斯·加科因及尘泥沼泽的背叛者那里打探消息。‡從巴魯斯·加科因及塵泥沼澤的背叛者那裡打探消息。',
  }
},
[1287] = {
  {
    'Os desertores‡Дезертиры‡Die Deserteure‡탈영병‡Los desertores‡Los desertores‡Les déserteurs‡背叛者‡叛逃者',
    nil,
    'Fale sobre Reethe com o Capitão Garrido Valente em Theramore.‡Поговорите с капитаном Гарраном Ваймсом в Тераморе.‡Sprecht mit Hauptmann Garran Mumm in Theramore über Reethe.‡테라모어에 있는 사령관 개런 바임스와 리테에 대해 대화해야 합니다.‡Ve a Theramore y habla con el capitán Garran Vimes sobre Reethe.‡Ve a Theramore y habla con el capitán Garran Vimes sobre Reethe.‡Parler au Capitaine Garran Vimaire à Theramore à propos de Reethe.‡和塞拉摩的盖兰·维米斯队长谈一谈关于雷瑟的事。‡和塞拉摩的蓋蘭·維米斯上尉談談關於雷瑟的事。',
  }
},
[1288] = {
  {
    'O relatório de Valente‡Донесение Ваймса‡Mumms Bericht‡‡El informe de Vimes‡‡Le rapport de Vimaire‡维米斯的报告‡維米斯的報告',
    nil,
    'Leve o Relatório de Valente para a Grã-senhora Jaina Proudmore em Theramore.‡Отнесите донесение Ваймса леди Джайне Праудмур в Терамор.‡Bringt Mumms Bericht zu Lady Jaina Prachtmeer in Theramore.‡‡Lleva el informe de Vimes a Lady Jaina Valiente a Theramore.‡Lleva el informe de Vimes a Lady Jaina Valiente a Theramore.‡Donner le Rapport de Vimaire à Dame Portvaillant à Theramore.‡把维米斯的报告送给塞拉摩的吉安娜·普罗德摩尔女士。‡把維米斯的報告送給塞拉摩的珍娜·普勞德摩爾女士。',
  }
},
[1289] = {
  {
    '<nyi> Vimes\'s Report‡<nyi> Доклад Ваймса‡<nyi> Mumms Bericht‡‡<nyi> El informe de Vimes‡‡<nyi> Rapport de Vimaire‡‡',
    nil,
    'Return to Captain Garran Vimes in Theramore.‡Вернитесь к капитану Ваймсу в Терамор.‡Kehrt zu Hauptmann Garran Mumm in Theramore zurück.‡‡Vuelve junto al capitán Garran Vimes a Theramore.‡Vuelve junto al capitán Garran Vimes a Theramore.‡Retourner voir le capitaine Garran Vimaire à Theramore.‡‡',
  }
},
[1301] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆士·海爾',
    nil,
    'Fale com Vincent Hyal no Porto de Menethil.‡Поговорите с Винсентом Хьялом в Гавани Менетилов.‡Sprecht mit Vincent Hyal im Hafen von Menethil.‡메네실 항구에 있는 빈센트 하이얄과 대화해야 합니다.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Discuter avec Vincent Hyal au Port de Menethil.‡和米奈希尔港的文森特·海厄尔谈一谈。‡和米奈希爾港的文森·海爾談話。',
  }
},
[1302] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆士·海爾',
    nil,
    'Fale com o Tabelião Lendry na Cidadela do Esteio, que fica em Theramore.‡Поговорите с клерком Лендри в Цитадели в Тераморе.‡Sprecht mit Amtmann Lendry bei der Wehrzitadelle in Theramore.‡테라모어 거점 요새에 있는 서기관 렌드리와 대화해야 합니다.‡Habla con el secretario Lendry, que está en la Ciudadela Garrida en Theramore.‡Habla con el secretario Lendry, que está en la Ciudadela Garrida en Theramore.‡Parler au greffier Lendry à la citadelle de Theramore.‡与塞拉摩城堡中的书记员伦德瑞谈一谈。‡和塞拉摩要塞的書記員倫德瑞談話。',
  }
},
[1318] = {
  {
    'Negócios pendentes‡Неоконченное дело Гордоков‡Die offene Rechnung der Gordok‡고르독 일 마무리‡Asunto Gordok sin finiquitar‡Asuntos Pendientes con Gordok‡Affaires inachevées chez les Gordok‡戈多克食人魔的事务‡戈多克巨魔的事務',
    nil,
    'Encontre as Manoplas do Poder de Gordok e devolva-as para o Capitão Kebrapaw no Gládio Cruel.nnDe acordo com Kebrapaw, a "história de ancião diz que Tortheldrin — um elfo "medonho" que se diz príncipe — roubou as manoplas de um dos reis Gordok.‡Добудьте латную рукавицу Мощи Гордока и вернитесь с ней к капитану Давигрому в Забытом Городе.nnПо словам Давигрома, в "старых байках" говорится, что Тортелдрин – "страшный эльф", называющий себя принцем, – похитил эту рукавицу у одного из королей Гордоков.‡Findet die Stulpen der Gordokmacht und bringt sie zu Hauptmann Krombruch in Düsterbruch.nnKrombruch zufolge sagen die "Alte Zeit Geschichten", dass Tortheldrin - ein "gruseliger" Elf, der sich selbst als Prinz bezeichnet- sie einem der Gordokkönige gestohlen hat.‡권력의 고르독 건틀릿을 찾아 혈투의 전장에 있는 대장 크롬크러쉬에게 가져가야 합니다.nn크롬크러쉬의 "옛날 얘기"에 따르면 자칭 왕자라는 토르텔드린이라는 이름의 "기분 나쁜" 엘프가 고르독 왕에게서 빼앗아갔다고 합니다.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush en La Masacre.nnSegún Kromcrush, la "antigua historia" cuenta que Tortheldrin, un elfo "espeluznante" que decía ser un príncipe, se lo había robado a uno de los reyes Gordok.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre.|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Trouvez le Gantelet de puissance gordok et rendez-le au Capitaine Kromcrush à Hache-tripes.nnSelon Kromcrush, les histoires des « vieux » racontent que Tortheldrin - un « vilain » elfe qui se fait appeler prince - l\'a volé à l\'un des rois gordok.‡找到戈多克力量护手，并将它交给厄运之槌的克罗卡斯。nn根据克罗卡斯所说的，“传说”自称是王子的精灵托塞德林从一名戈多克食人魔手中偷走了那件神器。‡找到戈多克力量護手，並將它交給厄運之槌的克羅卡斯。|n根據克羅卡斯所說的，「傳說」自稱是王子的精靈托塞德林從一名戈多克巨魔手中偷走了那件神器。',
  }
},
[1319] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Caz Doismancal em Theramore.‡Покажите потемневший железный Щит Казу Дваждыдвацу из Терамора.‡Zeigt den geschwärzten Eisenschild Caz Doppelspross in Theramore.‡테라모어에 있는 카즈 투스프로켓에게 검은 철제 방패를 보여줘야 합니다.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Montrer le Bouclier en fer noirci à Caz Bi-douille à Theramore.‡把被熏黑的铁盾牌拿给塞拉摩的卡兹·双链看一看。‡把被燻黑的鐵盾牌拿給塞拉摩的卡茲·雙鏈看一看。',
  }
},
[1320] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com o Capitão Garrido Valente em Theramore.‡Поговорите с капитаном Гарраном Ваймсом в Тераморе.‡Sprecht mit Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스와 대화해야 합니다.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Discuter avec le capitaine Garran Vimaire à Theramore.‡与塞拉摩的盖兰·维米斯队长谈一谈。‡與塞拉摩的蓋蘭·維米斯隊長談話。',
  }
},
[1321] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Do\'gol na Aldeia Muralha Verde.‡Покажите потемневший железный щит До\'голу из Деревни Гиблотопь.‡Zeigt den geschwärzten Eisenschild Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골에게 검은 철제 방패를 보여줘야 합니다.‡Muestra el escudo de hierro ennegrecido a Do\'gol del Poblado Murohelecho.‡Muestra el escudo de hierro ennegrecido a Do\'gol en el Poblado Murohelecho.‡Montrer le Bouclier en fer noirci à Do\'gol au village de Mur-de-Fougères.‡把被熏黑的铁盾牌拿给蕨墙村的杜高尔看一看。‡',
  }
},
[1322] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Obtenha 5 Vesículas de Peçonha Ácida para Do\'gol na Aldeia Muralha Verde.‡Добудьте 5 ядовитых желез Паука Черного Тумана для До\'гола из Деревни Гиблотопь.‡Bringt 5 säurehaltige Giftbeutel zu Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골을 위해 산성 독주머니 5개를 구해야 합니다.‡Consigue 5 glándulas de veneno ácido para Do\'gol del Poblado Murohelecho.‡Consigue 5 glándulas de veneno ácido para Do\'gol del Poblado Murohelecho.‡Trouver 5 Sacs de Venin acide pour Do\'gol de Mur-de-Fougères.‡为蕨墙村的杜高尔收集5个酸性毒囊。‡為蕨牆村的杜高爾收集5個酸性毒囊。',
  }
},
[1323] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡',
    nil,
    'Fale com Krog na Aldeia Muralha Verde.‡Поговорите с Крогом в Деревне Гиблотопь.‡Sprecht mit Krog in Brackenwall.‡담쟁이 마을에 있는 크로그와 대화해야 합니다.‡Ve al Poblado Murohelecho y habla con Krog.‡Ve al Poblado Murohelecho y habla con Krog.‡Parler à Krog au village de Mur-de-Fougères.‡和蕨墙村的克罗格谈一谈。‡',
  }
},
[1324] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrota o Recruta Remos in Pântano Vadeoso.‡Победите рядового Хендела в Пылевых топях.‡Besiegt den Gefreiten Hendel in den Düstermarschen.‡먼지진흙 습지대에 있는 병사 헨델과 싸워서 이겨야 합니다.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Battre le soldat Hendel dans le marécage d\'Âprefange.‡击败尘泥沼泽的亨德尔下士。‡擊敗塵泥沼澤的士兵亨德爾。',
  }
},
[1338] = {
  {
    'Ordens dos Lançatroz‡Заказ Грозовой Вершины‡Sturmlanzes Bestellung‡스톰파이크의 주문서‡Un pedido de Pico Tormenta‡Un pedido de Pico Tormenta‡La mission de Foudrepique‡卡尔·雷矛的订单‡雷矛的訂單',
    nil,
    'Entregue o Pedido de Lançatroz para Furen Barbalonga em Ventobravo.‡Отнесите заказ Грозовой Вершины Фьюрену Длиннобороду в Штормград.‡Bringt Sturmlanzes Anforderung zu Furen Langbart in Sturmwind.‡스톰윈드에 있는 푸렌 롱비어드에게 스톰파이크의 주문서를 가져가야 합니다.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Porter la commande de Foudrepique à Furen Barbe-longue à Hurlevent.‡把卡尔·雷矛的订单交给暴风城的弗伦·长须。‡把雷矛的訂單交給暴風城的弗倫·長鬚。',
  }
},
[1339] = {
  {
    'Uma tarefa do Montanhista Lançatroz‡Задание Грозовой Вершины‡Gebirgsjäger Sturmlanzes Aufgabe‡산악경비대 스톰파이크의 임무‡La tarea del montaraz Pico Tormenta‡La tarea del montaraz Pico Tormenta‡La mission du Montagnard Foudrepique‡巡山人卡尔·雷矛的任务‡巡山人雷矛的任務',
    nil,
    'Fale com o Montanhista Lançatroz.‡Поговорите с горным пехотинцем Грозовой Вершиной.‡Sprecht mit Gebirgsjäger Sturmlanze.‡산악경비대 스톰파이크와 대화하십시오.‡Habla con el montaraz Pico Tormenta.‡Habla con el montaraz Pico Tormenta.‡Parler au Montagnard Foudrepique.‡和巡山人卡尔·雷矛谈一谈。‡和巡山人雷矛談話。',
  }
},
[1358] = {
  {
    'Uma amostra para Hermógenes‡Образец для Хелбрима‡Probe für Helbrim‡헬브림에게 가져갈 견본‡Muestra para Helbrim‡Muestra para Helbrim‡Un échantillon pour Helbrim‡给赫布瑞姆的样本‡給赫布瑞姆的樣本',
    nil,
    'Leve a Amostra de Coração de Lobo para Boticário Hermógenes nos Sertões.‡Принесите препарат сердца волка аптекарю Хелбриму в Степи.‡Bringt die Wolfherzprobe zu Apotheker Helbrim ins Brachland.‡불모의 땅에 있는 연금술사 헬브림에게 늑대 심장 견본을 가져가야 합니다.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Apporter l\'échantillon de coeur de loup à l\'Apothicaire Helbrim dans les Tarides.‡把一箱蜘蛛毒带给贫瘠之地的药剂师赫布瑞姆。‡把狼心樣本交給貧瘠之地的藥劑師赫布瑞姆。',
  }
},
[1359] = {
  {
    'Entrega para Zilda‡Посылка для Зинг‡Zinges Lieferung‡진게의 소포‡Una entrega de Zinge‡Una entrega de Zinge‡Une livraison pour Zinge‡给金格的货物‡給金格的貨物',
    nil,
    'Leve a Amostras de Coração de Lobo para Boticária Zilda na Cidade Baixa.‡Отнесите препараты сердца волка аптекарю Зинг в Подгород.‡Bringt die Wolfherzproben zu Apothekerin Zinge nach Unterstadt.‡언더시티에 있는 연금술사 진게에게 늑대 심장 견본을 가져가야 합니다.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Apporter les Échantillons de cœurs de loups à l\'Apothicaire Zinge à Fossoyeuse.‡将狼心样本交给幽暗城的药剂师金格。‡將狼心樣品交給幽暗城的藥劑師金格。',
  }
},
[1360] = {
  {
    'Tesouros recuperados‡Возвращенные сокровища‡Wiederbeschaffte Schätze‡보물 찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡失而复得‡尋回寶物',
    nil,
    'Pegue a posse querida de Krom Braçoforte em seu baú no Saguão Norte de Uldaman e leve-a para ele na Altaforja.‡Достаньте сокровище Крома Крепкорука из сундука в северном зале Ульдамана и принесите ему в Стальгорн.‡Holt Krom Starkarms wertvollen Besitz aus seiner Truhe in der nördlichen Bankenhalle von Uldaman und bringt den Schatz zu ihm nach Eisenschmiede.‡울다만의 북쪽 대전당에 있는 궤짝에서 크롬 스타우트암의 보물을 찾아서 아이언포지에 있는 크롬 스타우트암에게 가져다주어야 합니다.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Récupérer les biens de Krom Stoutarm dans son coffre dans le hall commun nord d\'Uldaman et les lui rapporter à Ironforge.‡到奥达曼的北部大厅去找到克罗姆·粗臂的箱子，从里面拿出他的宝贵财产，然后回到铁炉堡把东西交给他。‡到奧達曼的北部大廳去找到克羅姆·粗臂的箱子，從裡面拿出他的寶貴財產，然後回到鐵爐堡把東西交給他。',
  }
},
[1361] = {
  {
    'Regthar Portões-da-morte‡Регтар Врата Смерти‡Regthar Totenfurt‡렉타르 데스게이트‡Regthar Portamorta‡Regthar Portamorta‡Regthar Seuil-de-mort‡雷戈萨·死门‡雷戈薩·死門',
    nil,
    'Fale com Regthar Portões-da-morte.‡Поговорите с Регтаром Врата Смерти.‡Sprecht mit Regthar Totenfurt.‡렉타르 데스게이트와 대화해야 합니다.‡Habla con Regthar Portamorta.‡Habla con Regthar Portamorta.‡Discuter avec Regthar Seuil-de-mort.‡和雷戈萨·死门谈一谈。‡和雷戈薩·死門談話。',
  }
},
[1362] = {
  {
    'Os Kolkar de Desolação‡Кентавры Пустошей‡Die Kolkar von Desolace‡잊혀진 땅의 콜카르‡Los Kolkar de Desolace‡Los Kolkar de Desolace‡Les Kolkar de Désolace‡凄凉之地的科卡尔部族‡淒涼之地的科卡爾部族',
    nil,
    'Fale com o Felgur Doiscortes no Entreposto do Espírito que Anda, em Desolação.‡Найдите на Заставе Скитающихся Духов в Пустошах Фелгура Бью-Двоих и поговорите с ним.‡Sprecht mit Felgur Zweischneid beim Geistwandlerposten in Desolace.‡잊혀진 땅의 침묵의 초소에 있는 펠굴 투커츠와 대화해야 합니다.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Discuter avec Felgur Doublecoupe au poste de Rôdeur-fantôme en Désolace.‡和凄凉之地幽灵岗哨的费古尔·双刃谈一谈。‡和淒涼之地鬼旅崗哨的費古爾·雙刃談話。',
  }
},
[1363] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Fale com o Acólito Dellis em Ventobravo.‡Поговорите с послушником Деллисом в Штормграде.‡Sprecht mit Akolyth Dellis in Sturmwind.‡스톰윈드에 있는 수행사제 델리스와 대화해야 합니다.‡Habla con el acólito Dellis en Ventormenta.‡Habla con el acólito Dellis en Ventormenta.‡Parler à l\'acolyte Dellis à Hurlevent.‡与暴风城里的助手迪利斯谈一谈。‡與暴風城裡的隨從迪利斯談話。',
  }
},
[1364] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Recupere os Ensaios de Hadggar sobre Convergência Dimensional e entregue-os para Vigia Mahar Ba, na Bastilha de Etergarde.‡Верните "Рассуждения Кадгара о пространственной сходимости" и доставьте сочинение дозорному Махару Ба в Крепость Стражей Пустоты.‡Rettet Khadgars \'Abhandlungen über dimensionale Konvergenz\' und bringt sie zu Behüter Mahar Ba in der Burg Nethergarde.‡차원의 집합점에 대한 카드가의 평론을 찾아 네더가드 요새에 있는 감시자 마할 바에게 전해야 합니다.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Retrouver les Essais de Khadgar sur la convergence dimensionnelle et les porter au Gardien Mahar Ba au Rempart-du-Néant.‡夺回《卡德加的空间收敛研究笔记》，将它送给守望堡的看守者马哈尔巴。‡奪回《卡德加的空間收斂研究筆記》，將它送給守望堡的看守者馬哈爾巴。',
  }
},
[1365] = {
  {
    'Khan Dez\'hepah‡Вождь Дез\'хеп‡Khan Dez\'hepah‡칸 데즈헤파‡Khan Dez\'hepah‡Khan Dez\'hepah‡Khan Dez\'hepah‡戴兹帕可汗‡戴茲帕可汗',
    nil,
    'Leve a Cabeça de Khan Dez\'hepah para Felgur Doiscortes na Desolação.‡Принесиет Фелгуру Бью-Двоих голову вождя Дез\'хепа.‡Bringt Khan Dez\'hepahs Kopf zu Felgur Zweischneid in Desolace.‡칸 데즈헤파를 처치하고 그 증거로 그의 머리카락을 잊혀진 땅에 있는 펠굴 투커츠에게 가져가야 합니다.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Rapporter la Tête du khan Dez\'hepah à Felgur Doublecoupe en Désolace.‡把戴兹帕可汗的头颅交给凄凉之地的费古尔·双刃。‡把戴茲帕可汗的頭顱交給淒涼之地的費古爾·雙刃。',
  }
},
[1366] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Felgur Doiscortes em Desolação.‡Принесите в Пустоши 15 ушей кентавров и отдайте Фелгуру Бью-Двоих.‡Bringt 15 Zentaurenohren zu Felgur Zweischneid in Desolace.‡잊혀진 땅의 펠굴 투커츠에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Apporter 15 Oreilles de centaure à Felgur Doublecoupe, en Désolace.‡收集15只半人马的耳朵，把它们交给凄凉之地的费古尔·双刃。‡收集15個半人馬的耳朵，把它們交給淒涼之地的費古爾·雙刃。',
  }
},
[1367] = {
  {
    'Aliança com os Magram‡Союз с племенем Маграм‡Allianz mit den Magram‡마그람 동맹‡La alianza con los Magram‡La alianza con los Magram‡L\'alliance avec les Magram‡玛格拉姆部族‡瑪格拉姆族的聯盟',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux envers vous, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆族建立良好的關係，然後和瓦魯格談話。',
  }
},
[1368] = {
  {
    'Aliança com os Gelkis‡Союз с племенем Гелкис‡Allianz mit den Gelkis‡겔키스 동맹‡La alianza con los Gelkis‡La alianza con los Gelkis‡L\'alliance avec les Gelkis‡吉尔吉斯部族‡吉爾吉斯族的聯盟',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut Euch einen Ruf als freundliche Person bei den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Faire en sorte que les Gelkis deviennent Amicaux envers vous, puis aller parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯族建立良好的關係，然後和『智者』烏泰克談話。',
  }
},
[1369] = {
  {
    'Lágrimas partidas‡Россыпи Слез‡Zerbrochene Tränen‡눈물의 파편‡Lágrimas rotas‡Lágrimas rotas‡Larmes brisées‡破碎之泪‡破碎之淚',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Lágrimas Partidas para Warug na Aldeia Magram.‡Для поддержания отношений с племенем Маграм принесите 3 кристалла Россыпи Слез Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt 3 zerbrochene Tränen zu Warug im Dorf Magram.‡마그람에게 우호적인 평판을 유지하면서 마그람 마을에 있는 와루그에게 눈물의 파편 3개를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Maintenir votre réputation auprès des Magram et ramener 3 Larmes brisées à Warug au village des Magram.‡继续和玛格拉姆部族保持良好的关系，把3块破碎之泪交给玛格拉姆村庄的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關係，把3塊破碎之淚交給瑪格拉姆村莊的瓦魯格。',
  }
},
[1370] = {
  {
    'Assalto à dispensa‡Похищение припасов‡Diebstahl von Vorräten‡보급품 훔치기‡¡A robar provisiones!‡¡A robar provisiones!‡Voleur de viande‡偷取物资‡偷取物資',
    nil,
    'Entregue 6 sacos de Carne Mal Desidratada para Uthek, a Sábia, na Aldeia Gelkis.‡Принесите 6 мешков недосушенного мяса в деревню Гелкис и отдайте Уте Мудрой.‡Bringt 6 Taschen primitiv getrocknetes Fleisch zu Uthek der Weisen im Dorf Gelkis.‡겔키스 마을에 있는 현자 우텍에게 말린 고기 6개를 가져가야 합니다.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Rapporter 6 Sacs de viande grossièrement séchée à Uthek la Sage au village des Gelkis.‡把6包粗制干肉交给吉尔吉斯村的智者乌泰克。‡把6包粗製肉乾交給吉爾吉斯村的『智者』烏泰克。',
  }
},
[1371] = {
  {
    'Engenhoca para Warug‡Игрушка для Варуга‡Gizmo für Warug‡와루그의 물건‡Un cacharro para Warug‡Un cacharro para Warug‡Un bidule pour Warug‡瓦鲁格的玩具‡瓦魯格的玩具',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Bonecos-alvo Avançado para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите усовершенствованный манекен-мишень Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt eine hochentwickelte Zielattrappe zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 고급 표적 허수아비를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram et rapporter un Leurre perfectionné à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，给玛格拉姆村的瓦鲁格找到一个高级假人。‡繼續和瑪格拉姆部族保持良好的關係，給瑪格拉姆村的瓦魯格找到一個高級假人。',
  }
},
[1372] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Fale com Boticário Faustino no Refúgio dos Mendigos.‡Поговорите с аптекарем Фаустином в Приюте Бродяги.‡Sprecht mit Apotheker Faustin im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 연금술사 파우스틴과 대화해야 합니다.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Parler à l\'Apothicaire Faustin, au Repaire des mendiants.‡到乞丐鬼屋去和药剂师法奥斯丁谈一谈。‡到乞丐鬼屋去和藥劑師法奧斯丁談話。',
  }
},
[1373] = {
  {
    'Ongekan‡Онгеку‡Ongeku‡온게쿠‡Ongeku‡Ongeku‡Ongeku‡盎格库尔‡盎格庫',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue um Estilhaço de Draenetista para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите осколок дренейского аметиста Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt einen Draenethystsplitter zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 드레니시스트 파편 하나를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis et rapporter un Éclat de draenéthyste à Uthek la Sage au village des Gelkis, en Désolace.‡继续和吉尔吉斯部族保持良好的关系，并把德莱尼水晶碎片交给凄凉之地吉尔吉斯村的智者乌泰克。‡維持你在吉爾吉斯族中的名聲，並把德萊尼水晶裂片交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1374] = {
  {
    'Khan Jehn‡Вождь Джен‡Khan Jehn‡칸 젠‡Khan Jehn‡Khan Jehn‡Khan Jehn‡杰恩可汗‡傑恩可汗',
    nil,
    'Entregue a Cabeça de Khan Jehn para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Принесите голову вождя Джехна Уте Мудрой в деревню Гелкис.‡Bringt Khan Jehns Kopf zu Uthek der Weisen im Dorf Gelkis in Desolace.‡칸 젠을 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 가져가야 합니다.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Rapporter la Tête du khan Jehn à Uthek la Sage au village des Gelkis, en Désolace.‡把杰恩可汗的头颅交给凄凉之地吉尔吉斯村的智者乌泰克。‡把傑恩可汗的頭顱交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1375] = {
  {
    'Khan Shaka‡Вождь Шак‡Khan Shaka‡칸 샤카‡Khan Shaka‡Khan Shaka‡Khan Shaka‡沙卡可汗‡沙卡可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue a Cabeça de Khan Shaka para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите голову вождя Шака Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt den Kopf von Khan Shaka zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 칸 샤카를 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 마그람 마을에 있는 와루그에게 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva la cabeza de Khan Shaka a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva la cabeza de Khan Shaka a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation parmi les Magram et rapporter la Tête du khan Shaka à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，把沙卡可汗的头颅交给凄凉之地玛格拉姆村的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關係，把沙卡可汗的頭顱交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1380] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫蘭薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue o Fragmento de Chave dos Maraudinos para Uthek, a Sábia, na Aldeia Gelkis.‡Для поддержания отношений с племенем Гелкис принесите фрагмент Ключа Мародина Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt das Schlüsselfragment der Maraudine zu Uthek der Weisen im Dorf Gelkis.‡겔키스에게 우호적인 평판을 유지하면서 겔키스 마을에 있는 현자 우텍에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva el trozo de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Mantén tu reputación con los Gelkis y lleva el trozo de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Maintenir votre réputation auprès des Gelkis, et apporter le Fragment de clé des Maraudine à Uthek la Sage au village des Gelkis.‡继续和吉尔吉斯部族保持良好的关系，把玛洛迪钥匙碎片交给吉尔吉斯村的智者乌泰克。‡繼續和吉爾吉斯部族保持良好的關係，把瑪洛迪鑰匙碎片交給吉爾吉斯村的『智者』烏泰克。',
  }
},
[1381] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫蘭薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue o Fragmento de Chave dos Maraudinos para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите фрагмент Ключа Мародина Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt das Schlüsselfragment der Maraudine zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva el trozo de llave Maraudine a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva el trozo de llave Maraudine a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram, et apporter le Fragment de clé des Maraudine à Warug au village des Magram en Désolace.‡和玛格拉姆保持良好的关系，把玛洛迪钥匙碎片交给凄凉之地玛格拉姆村的瓦鲁格。‡維持你在瑪格拉姆族的名聲，並把瑪洛迪鑰匙碎片交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1382] = {
  {
    'Aliança inusitada‡Странный союз‡Seltsame Allianz‡이상한 동맹‡Extraña alianza‡Extraña alianza‡Une étrange alliance‡奇怪的联盟‡奇怪的聯盟',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut eine freundliche Beziehung zu den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Obtenir que les Gelkis se montrent Amicaux, puis parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯部族建立良好的關係，然後和『智者』烏泰克談話。',
  }
},
[1383] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'O Boticário Faustino, no Refúgio dos Mendigos, precisa de 5 Corações de Pantera das Sombras, de Fungo do Senhor do Brejo e de Sangue de Dragonete Verde.‡Принесите аптекарю Фаустину в Приют Бродяги 5 сердец пантер тени, мох хозяина болота и немного крови зеленого дракончика.‡Apotheker Faustin im Bettlerschlupfwinkel braucht 5 Schattenpantherherzen, Morastlordfungus und etwas Blut eines grünen Welpen.‡부랑자 소굴에 있는 연금술사 파우스틴에게 흑표범 심장 5개, 우두머리 늪괴물 곰팡이, 그리고 새끼 녹색용 피를 조금 가져가야 합니다.‡El boticario Faustin del Refugio de los Mendigos necesita 5 corazones de pantera sombría, hongos de Señor del Lodo y sangre de cría verde.‡El boticario Faustin del Refugio de los Mendigos necesita 5 corazones de pantera sombría, hongos de Señor del Lodo y sangre de cría verde.‡L\'apothicaire Faustin, du repaire des mendiants, a besoin de 5 Cœurs de panthère des ombres, d\'un Champignon de Boueux et de Sang de dragonnet vert.‡乞丐鬼屋的药剂师法奥斯丁需要5颗暗影黑豹的心脏、1颗泥沼之王的蘑菇和一些绿色雏龙之血。‡乞丐鬼屋的藥劑師法奧斯丁需要5顆暗影黑豹的心臟，一顆泥沼之王的蘑菇和一些綠色幼龍之血。',
  }
},
[1384] = {
  {
    'Onde os fracos não têm vez‡Набег на племя Колкар‡Überfall auf die Kolkar‡콜카르 습격‡Asalta a los Kolkar‡Asalta a los Kolkar‡Raid sur les Kolkar‡突袭科卡尔‡突襲科卡爾',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue 10 Patuás Grosseiros para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите 10 грубых оберегов Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt 10 kunstlose Glücksbringer zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 조잡한 부적 10개를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis, et apporter 10 Charmes bruts à Uthek la Sage dans le village des Gelkis, en Désolace.‡和吉尔吉斯部族保持良好的关系，把10个粗制咒符交给凄凉之地吉尔吉斯村的智者乌泰克。‡和吉爾吉斯部族保持良好的關係，把10個粗製符咒交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1385] = {
  {
    'Política feroz‡Политика силы‡Brutale Politik‡야비한 정책‡Políticas brutales‡Políticas brutales‡Une violente politique‡野蛮外交‡野蠻外交',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux à votre égard, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆部族建立良好的關係，然後和瓦魯格談話。',
  }
},
[1386] = {
  {
    'Ataque aos Kolkar!‡Нападение на племя Колкар‡Angriff auf die Kolkar‡콜카르 공격‡Ataca a los Kolkar‡Ataca a los Kolkar‡Assaut sur les Kolkar‡突袭科卡尔部族‡',
    nil,
    'Mantenha alta sua reputação junto aos Magram. Mate 12 Centauros Kolkar, 12 Batedores Kolkar e 6 Espancadores Kolkar. Em seguida, fale novamente com Warug, na Vila Magram, em Desolação.‡Для поддержания отношений с племенем Маграм вы должны убить 12 кентавров из племени Колкар, 12 разведчиков из племени Колкар и 6 извергов из племени Колкар, а затем вернуться к Варугу в деревню Маграм.‡Haltet Euren Ruf bei den Magram aufrecht. Tötet 12 Zentauren der Kolkar, 12 Späher der Kolkar sowie 6 Raufer der Kolkar und kehrt dann zu Warug ins Magramdorf in Desolace zurück.‡마그람에게 우호적인 평판을 유지하면서 콜카르 켄타우로스 12명, 콜카르일족 척후병 12명, 콜카르일족 투사 6명을 처치한 다음 잊혀진 땅의 마그람 마을에 있는 와루그에게 돌아가야 합니다.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 exploradores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 exploradores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Maintenir votre réputation auprès des Magram, tuer 12 Centaures kolkar, 12 Eclaireurs kolkar, 6 Marteleurs kolkar, puis retourner voir Warug, dans le village des Magram, en Désolace.‡继续保持和玛格拉姆部族的良好关系，杀掉12个科卡尔半人马，12个科卡尔斥候和6个科卡尔虐待者，然后回到凄凉之地向玛格拉姆部族的瓦鲁格报告。‡',
  }
},
[1387] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Cabo Melquias no Posto do Nijel em Desolação.‡Принесите в город Высота Найджела 15 ушей кентавров и отдайте их капралу Мелкису.‡Bringt 15 Zentaurenohren zu Korporal Melkins bei der Nijelspitze in Desolace.‡잊혀진 땅의 나이젤의 야영지에 있는 하사관 멜킨스에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Apporter 15 Oreilles de centaures au caporal Melkins, à la combe de Nijel, en Désolace.‡收集15个半人马耳朵，把它们交给尼耶尔前哨站的麦尔金斯下士。‡收集15個半人馬耳朵給尼耶爾前哨站的麥爾金斯下士。',
  }
},
[1388] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡',
    nil,
    'Entregue o Soro da Verdade do Faustino para Sicário Zaqueu no Refúgio dos Mendigos.‡Отдайте сыворотку правды Фаустина стражу смерти Зредусу в Приюте Бродяги.‡Gebt Faustins Wahrheitsserum dem Todespirscher Zraedus im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 죽음의추적자 즈레더스에게 파우스틴의 진실의 물약을 가져가야 합니다.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Remettre le Sérum de vérité de Faustin au Nécrotraqueur Zraedus au Repaire des mendiants.‡把法奥斯丁的真言药水交给乞丐鬼屋的亡灵哨兵莱度斯。‡',
  }
},
[1389] = {
  {
    'Cristais de draenetista‡Кристаллы дренейского аметиста‡Draenethystkristalle‡드레니시스트 수정‡Cristales draenetistas‡Cristales draenetistas‡Les cristaux de draenéthyste‡德莱尼水晶‡德萊尼水晶',
    nil,
    'Leve 6 Cristais de Draenetista para Magtoor no Pântano das Mágoas.‡Принесите 6 кристаллов дренейского аметиста Магтуру в Убежище в Болоте Печали.‡Bringt 6 Draenethystkristalle zu Magtoor im sicheren Hafen in den Sümpfen des Elends.‡슬픔의 늪의 피난처에 있는 막투르에게 드레니시스트 수정 6개를 가져가야 합니다.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Apporter 6 Cristaux de draenéthyste à Magtoor au Havre boueux du marais des Chagrins.‡给悲伤沼泽避难营地里的玛格图尔带去6块德莱尼水晶。‡給悲傷沼澤避難營地裡的瑪格圖爾帶去6塊德萊尼水晶。',
  }
},
[1390] = {
  {
    '<nyi> Oops, We Killed Them Again.‡<nyi> Упал на нож и так семь раз.‡<nyi> Upps, wir haben sie schon wieder ins Jenseits geschickt.‡‡<nyi> Ups, les hemos matado de otra vez‡‡<nyi> Oups, on les a encore tués !‡‡',
    nil,
    nil,
  }
},
[1391] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡',
    nil,
    'Leve a Cerveja de Zaerdus para Infiltrador Marksen no Pedregal.‡Отнесите бражку Зредуса секретному агенту Марксену в Каменор.‡Bringt Zraedus\' Bräu zu Spitzel Marksen in Steinard.‡스토나드에 있는 첩보원 마크슨에게 즈레더스의 맥주를 가져가야 합니다.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Apporter la Bière de Zraedus à l\'Infiltrateur Marksen à Pierrêche.‡把莱度斯的酒带给斯通纳德的间谍玛克森。‡',
  }
},
[1392] = {
  {
    'Noboru, a Borduna‡Нобору Дубина‡Noboru der Knüppler‡곤봉잡이 노보루‡Noboru el Garrote‡Noboru el Garrote‡Noboru le Gourdin‡木棒诺博鲁‡『鬥棍』諾博魯',
    nil,
    'Leve a Clava de Noboru ao líder do Refúgio no Pântano das Mágoas.‡Принесите дубину Нобору главе Убежища на Болото Печали.‡Bringt Noborus Knüppel zum Anführer des sicheren Hafens in den Sümpfen des Elends.‡슬픔의 늪에 있는 피난처의 우두머리에게 노보루의 곤봉을 가져가야 합니다.‡Llévale la cayada de Noboru al líder de El Puerto del Pantano de las Penas.‡Llévale el garrote de Noboru al líder de El Puerto del Pantano de las Penas.‡Apporter le Casse-tête de Noboru au Chef du Havre boueux dans le marais des Chagrins.‡把诺博鲁的木棒交到悲伤沼泽中的避难营领导人手中。‡把諾博魯的鬥棍交給悲傷沼澤中的避難營領導人。',
  }
},
[1393] = {
  {
    'A fuga de Galen‡Побег Галена‡Galens Flucht‡갈렌 구출‡La huida de Galen‡La huida de Galen‡L\'évasion de Galen‡加林的逃亡‡加林的逃亡',
    nil,
    'Escolte Galen até a segurança para, então, encontrar seu acampamento no Pântano das Mágoas e abrir seu cofre.‡Выведите Галена из опасного места, затем найдите его лагерь на Болоте Печали и откройте его сейф.‡Eskortiert Galen, bis er außer Gefahr ist, sucht dann sein Lager in den Sümpfen des Elends und öffnet seine Geldkassette.‡갈렌이 위험에서 벗어나도록 호위한 다음 슬픔의 늪에 있는 그의 야영지를 찾아 갈렌의 금고를 열어야 합니다.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Escorter Galen jusqu\'à ce qu\'il soit hors de danger, puis trouver son camp dans le marais des Chagrins et ouvrir son coffre.‡护送加林逃出困境，然后打开他放在悲伤沼泽营地里的保险箱。‡護送加林逃出困境，然後去開啟他放在傷心沼澤營地裡的保險箱。',
  }
},
[1394] = {
  {
    'Passagem final‡Финальное испытание‡Letzte Überfahrt‡최후의 시험‡La recta final‡La recta final‡Le dernier voyage‡通过试炼‡',
    nil,
    'Fale com Dorn Espreitaprados em Mil Agulhas.‡Поговорите с Дорном Вольным Ловчим в Тысяче Игл.‡Sprecht mit Dorn Ebenenpirscher in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커와 대화하십시오.‡Habla con Dorn Acechaprados en Las Mil Agujas.‡Habla con Dorn Acechallanos en Las Mil Agujas.‡Parler à Dorn Traqueur-des-plaines aux Mille pointes.‡和千针石林的多恩·平原行者谈一谈。‡',
  }
},
[1395] = {
  {
    'Suprimentos para Etergarde‡Поставки для Стражей Пустоты‡Vorräte für Nethergarde‡네더가드 요새 보급품‡Suministros para Nethergarde‡Suministros para Nethergarde‡Fournitures pour Rempart-du-Néant‡守望堡的物资‡守望堡的補給物資',
    nil,
    'Leve o Caixote de Pedras de Poder para Intendente Lungertz antes que expirem.‡Отнесите ящик камней силы интенданту Лунгерцу прежде, чем камни утратят силу.‡Bringt die Kiste mit den Kraftsteinen zu Rüstmeister Lungertz, bevor die Kraft verbraucht ist.‡마법석의 힘이 다하기 전에 병참장교 룬겔츠에게 마법석 상자를 가져가야 합니다.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Apporter la Caisse de Pierres de puissance à l\'Intendant Lungertz, avant que le pouvoir des pierres n\'expire.‡在能量石的魔法效果消失以前，把它们带给守望堡的军需官朗格尔斯。‡在能量石的效力消失以前，把它們交給守望堡的軍需官朗格茲。',
  }
},
[1396] = {
  {
    'Invasão da vida selvagem‡Атака тварей‡Lauernde Tierwelt‡야생 짐승의 공격‡Contra la fauna feroz‡Contra la fauna feroz‡Des créatures sauvages rôdent‡逼近的野兽‡逼近的野獸',
    nil,
    'Mate 8 Crocoliscos Dentesserras Jovens, 10 Tece-mágoas e 10 Jaguares do Pântano, então fale novamente com Vigia Biggs no Pântano das Mágoas.‡Убейте 8 молодых острозубых кроколисков, 10 ткачей скорби и 10 болотных ягуаров и потом вернитесь к дозорному Биггсу на Болоте Печали.‡Tötet 8 junge Sägezahnkrokilisken, 10 Trauerspinner sowie 10 Sumpfjaguare und kehrt dann zu Behüter Biggs in den Sümpfen des Elends zurück.‡새끼 톱니악어 8마리, 늪그물거미 10마리, 늪지재규어 10마리를 처치한 다음 슬픔의 늪에 있는 파수병 비그스에게 돌아가야 합니다.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 girapenas y 10 jaguares del pantano, y después ve a ver al vigía Biggs al Pantano de las Penas.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 hilapenas y 10 jaguares del pantano, y después ve a ver al vigía Biggs al Pantano de las Penas.‡Tuer 8 Jeunes crocilisques Dents-de-scie, 10 Tisseuses des pleurs et 10 Jaguars du marécage, puis retourner voir le Gardien Biggs, dans le marais des Chagrins.‡杀死8只小盐齿鳄鱼、10只沼泽纺丝蛛和10只沼泽虎，然后向悲伤沼泽的卫兵比格斯报告。‡殺死8隻小鋸齒鱷魚、10隻沼澤紡絲蛛和10隻沼澤虎，然後向悲傷沼澤的衛兵比格斯報告。',
  }
},
[1398] = {
  {
    'Madeira Flutuante‡Плавник‡Treibholz‡유목‡Madera a la deriva‡Madera a la deriva‡Bois flotté‡晒干的流木‡曬乾的流木',
    nil,
    'Leve 8 peças de Madeira Flutuante Seca ao Sol para Vigia Biggs no Pântano das Mágoas.‡Принести 8 кусков сухого плавника дозорному Биггсу на Болоте Печали.‡Bringt 8 Stücke sonnengetrocknetes Treibholz zu Behüter Biggs in den Sümpfen des Elends.‡슬픔의 늪에 있는 파수병 비그스에게 볕에 말린 유목 8개를 가져가야 합니다.‡Llévale 8 piezas de madera a la deriva desecada al vigía Biggs en el Pantano de las Penas.‡Llévale 8 piezas de madera a la deriva desecada al vigilante Biggs en el Pantano de las Penas.‡Apporter 8 Morceaux de Bois flotté séché au soleil au Gardien Biggs dans le marais des Chagrins.‡给悲伤沼泽的卫兵比格斯带回8块晒干的流木。‡給悲傷沼澤的衛兵比格斯帶回8塊曬乾的流木。',
  }
},
[1418] = {
  {
    'Nika Cicatriz-de-sangue‡Ника Алый Шрам‡Neeka Blutnarbe‡니카 블러드스카‡Neeka Marca de Sangre‡Neeka Marca de Sangre‡Neeka Balafre-sanglante‡尼卡·血痕‡尼卡·血痕',
    nil,
    'Fale com Nika Cicatriz-de-sangue.‡Поговорите с Никой Алый Шрам.‡Sprecht mit Neeka Blutnarbe.‡니카 블러드스카와 대화해야 합니다.‡Habla con Neeka Marca de Sangre.‡Habla con Neeka Marca de Sangre.‡Parler à Neeka Balafre-sanglante.‡和尼卡·血痕谈一谈。‡和尼卡·血痕談話。',
  }
},
[1419] = {
  {
    'Coiotes ladrões‡Койоты-воры‡Kojoten-Diebe‡도둑 코요테‡Ladrones coyote‡Ladrones coyote‡Les coyotes voleurs‡捕猎山狗‡捕獵山狗',
    nil,
    'Leve 30 Mandíbulas de Coiote para Nika Cicatriz-de-sangue em Karrath.‡Принесите 30 челюстей койотов Нике Алый Шрам в Каргат.‡Bringt 30 Kojotenkieferknochen zu Neeka Blutnarbe in Kargath.‡카르가스에 있는 니카 블러드스카에게 코요테 턱뼈 30개를 가져가야 합니다.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Apporter 30 Mâchoires de coyotes à Neeka Balafre-sanglante à Kargath.‡带30块山狗的颚骨去见卡加斯的尼卡·血痕。‡帶30塊山狗的顎骨去見卡加斯的尼卡·血痕。',
  }
},
[1420] = {
  {
    'Relatório para Helgrum‡Донесение Хелгруму‡Bericht für Helgrum‡헬그럼에게 보고‡Un informe para Helgrum‡Un informe para Helgrum‡Le rapport à Helgrum‡向赫格拉姆报到‡向赫格拉姆報到',
    nil,
    'Leve o Relatório de Nika para Helgrum, o Ligeiro em Pedregal.‡Отнесите донесение Ники Хелгруму Быстроногому в Каменор.‡Bringt Neekas Bericht zu Helgrum dem Hurtigen in Steinard.‡스토나드에 있는 날쌘돌이 헬그럼에게 니카의 보고서를 가져가야 합니다.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Apporter le Rapport de Neeka à Helgrum l\'Agile à Pierrêche.‡把尼卡的报告交给斯通纳德的赫格拉姆。‡把尼卡的報告帶去給斯通納德的迅捷的赫格拉姆。',
  }
},
[1421] = {
  {
    'A caravana perdida‡Пропавший караван‡Die verlorene Karawane‡사라진 짐마차‡La caravana perdida‡La caravana perdida‡Le chariot perdu‡丢失的货物‡走失的商隊',
    nil,
    'Encontre o Baú da Caravana no Retiro Alqueivado, obtenha os Reagentes do Teurgo e leve-os para Vigia Biggs.‡Найдите похищенный из каравана сундук в Болотном пристанище, добудьте реактивы магов и принесите их дозорному Биггсу.‡Sucht die Karawanentruhe in der Zuflucht der Verirrten, beschafft Euch die Reagenzien der Hexer und bringt sie zu Behüter Biggs.‡드레노어 성역에서 마법사들의 재료가 들어 있는 짐마차 상자를 찾아 파수병 비그스에게 가져가야 합니다.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigía Biggs.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigía Biggs.‡Trouver le Coffre de la Caravane, dans le Sanctuaire des friches, obtenir les Composants pour les sorciers, et les apporter au Gardien Biggs.‡在农田避难所中找到商队的货物，并拿到巫师的材料，把它交给卫兵比格斯。‡找到商隊被劫去巨魔村落的箱子，把原料帶回來給衛兵比格斯。',
  }
},
[1422] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡',
    nil,
    'Fale com Katar no Pântano das Mágoas.‡Поговорите с Катором на Болоте Печали.‡Sprecht mit Katar in den Sümpfen des Elends.‡슬픔의 늪에 있는 카타르와 대화해야 합니다.‡Habla con Katar en el Pantano de las Penas.‡Habla con Katar en el Pantano de las Penas.‡Parler à Katar, dans le marais des Chagrins.‡与悲伤沼泽的卡塔尔谈一谈。‡',
  }
},
[1423] = {
  {
    'Os suprimentos perdidos‡Потерянные припасы‡Die verlorenen Vorräte‡잃어버린 보급품‡Los suministros perdidos‡Los suministros perdidos‡Les marchandises perdues‡遗失的补给品‡遺失的補給物資',
    nil,
    'Leve os Suprimentos Perdidos para Intendente Lungertz.‡Принесите потерянные припасы интенданту Лунгерцу.‡Bringt die verlorenen Vorräte zu Rüstmeister Lungertz.‡병참장교 룬겔츠에게 잃어버린 보급품을 가져가야 합니다.‡Llévale las provisiones extraviadas al intendente Lungertz.‡Llévale los suministros perdidos al intendente Lungertz.‡Apporter les Marchandises perdues à l\'Intendant Lungertz.‡把遗失的货物交给军需官朗格尔斯。‡把遺失的補給物資交給軍需官朗格茲。',
  }
},
[1424] = {
  {
    'Poço de Lágrimas‡Озеро Слез‡Tränenteich‡눈물의 연못‡Charca de Lágrimas‡Charca de Lágrimas‡Le bassin des larmes‡泪水之池‡淚水之池',
    nil,
    'Vil\'zerul, no Pedregal, quer que você colete 10 Artefatos Atal\'ai.‡Соберите 10 артефактов Атал\'ай для Фелзерула из Каменора.‡Fel\'Zerul in Steinard möchte, dass Ihr 10 Artefakte der Atal\'ai sammelt.‡스토나드에 있는 펠제룰이 아탈라이 유물 10개를 모아 달라고 부탁했습니다.‡Fel\'zerul, en Rocal, quiere que consigas 10 artefactos Atal\'ai.‡Fel\'zerul, en Rocal, quiere que consigas 5 artefactos Atal\'ai.‡Fel\'zerul à Pierrêche veut que vous rassembliez 10 Artefacts atal\'ai.‡斯通纳德的费泽鲁尔要求你收集10件阿塔莱神器。‡斯通納德的費澤盧爾要求你收集10件阿塔萊神器。',
  }
},
[1425] = {
  {
    'Entregue a remessa‡Доставка груза‡Überbringen der Lieferung‡보급품 전달‡Envío de suministros‡Envío de suministros‡La remise du chargement‡运送货物‡運送貨物',
    nil,
    'Leve a Remessa para Etergarde ao Intendente Lungertz na Bastilha de Etergarde.‡Доставьте груз в Крепость Стражей Пустоты интенданту Лунгерцу.‡Bringt die Lieferung nach Nethergarde zu Rüstmeister Lungertz in der Burg Nethergarde.‡네더가드 요새에 있는 병참장교 룬겔츠에게 네더가드 뱃짐을 가져가야 합니다.‡Entrégale el envío a Nethergarde al intendente Lungertz del Castillo de Nethergarde.‡Entrégale los suministros al intendente Lungertz del Castillo de Nethergarde.‡Apporter la Cargaison pour Rempart-du-Néant à l\'Intendant Lungertz au Rempart-du-Néant.‡把货物带给守望堡的军需官朗格尔斯。‡把貨物帶給守望堡的軍需官朗格爾斯。',
  }
},
[1426] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡',
    nil,
    'Mate 10 Murlocs do Pântano, 10 Jogatintas do Pântano e 10 Comecarnes do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных мурлоков, 10 болотных чернильщиков и 10 болотных трупоедов, затем вернитесь к Котору в Болото Печали.‡Tötet 10 Marschenmurlocs, 10 Marschentintenspucker und 10 Marschenfleischfresser und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 10마리, 늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가십시오.‡Mata a 10 múrlocs de marisma, 10 vomitatintas de marisma y 10 comecarnes de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 múrlocs de marisma, 10 vomitatintas de marisma y 10 comecarnes de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Murlocs des marais, 10 Cracheurs des marais, 10 Dévoreurs des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10个沼泽鱼人、10个沼泽喷墨鱼人和10个沼泽食腐鱼人，然后向悲伤沼泽的卡塔尔回报。‡',
  }
},
[1427] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡',
    nil,
    'Fale com Tok\'Kar no Pântano das Mágoas.‡Поговорите с Ток\'Каром в Болоте Печали.‡Sprecht mit Tok\'Kar in den Sümpfen des Elends.‡슬픔의 늪에 있는 톡카르와 대화해야 합니다.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Parler à Tok\'Kar dans le marais des Chagrins.‡与悲伤沼泽的托克卡尔谈一谈。‡',
  }
},
[1428] = {
  {
    'Ameaça contínua‡Продолжающаяся угроза‡Fortwährende Gefahr‡계속되는 위협‡La amenaza continua‡La amenaza continua‡Le danger permanent‡海中的威胁‡持續的威脅',
    nil,
    'Mate 10 Jogatintas do Pântano, 10 Comecarnes do Pântano e 10 Oráculos do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных чернильщиков, 10 болотных трупоедов и 10 болотных оракулов, затем вернитесь к Котору в Болоте Печали.‡Tötet 10 Marschentintenspucker, 10 Marschenfleischfresser und 10 Marschenorakel und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리, 늪지멀록 점쟁이 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가야 합니다.‡Mata a 10 vomitatintas de marisma, 10 comecarnes de marisma y 10 oráculos de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 vomitatintas de marisma, 10 comecarnes de marisma y 10 oráculos de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Cracheurs des marais, 10 Dévoreurs des marais, 10 Oracles des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10名沼泽喷墨鱼人、10名沼泽食腐鱼人和10名沼泽鱼人智者，然后向悲伤沼泽的卡塔尔回报。‡殺掉10名沼澤噴墨魚人、10名沼澤食腐魚人和10名沼澤魚人神諭者，然後向悲傷沼澤的卡塔爾回報。',
  }
},
[1429] = {
  {
    'O exilado Atal\'ai‡Изгнанник Атал\'ай‡Der Verbannte der Atal\'ai‡추방된 아탈라이 트롤‡El exiliado Atal\'ai‡El exiliado Atal\'ai‡L\'Exilé atal\'ai‡阿塔莱流放者‡阿塔萊流放者',
    nil,
    'Leve o Saco de Artefatos Atal\'ai para o Exilado Atal\'ai nas Terras Agrestes.‡Принесите сверток с артефактами Атал\'ай к изгнаннику Атал\'ай во Внутренние земли.‡Bringt das Artefaktbündel der Atal\'ai zu dem Verbannten der Atal\'ai ins Hinterland.‡동부 내륙지에 있는 추방된 아탈라이트롤에게 아탈라이 유물 자루를 가져가야 합니다.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Apporter les Artefacts atal\'ai à l\'Exilé atal\'ai dans les Hinterlands.‡将一捆阿塔莱神器交给辛特兰的阿塔莱流放者。‡將一包阿塔萊神器交給辛特蘭的阿塔萊流放者。',
  }
},
[1430] = {
  {
    'Carne fresca‡Свежее мясо‡Frischfleisch‡싱싱한 고기‡Carne fresca‡Carne fresca‡Viande fraîche‡新鲜的螃蟹腿‡新鮮的螃蟹腿',
    nil,
    'Leve 10 Pernas de Rastejante Monstruoso para Dar no Pântano das Mágoas.‡Принесите 10 ног чудовищного краба Дару на Болото Печали.‡Bringt 10 monströse Kriecherbeine zu Dar in den Sümpfen des Elends.‡슬픔의 늪에 있는 다르에게 괴물게 집게발 10개를 가져가야 합니다.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Apporter 10 Pattes de clampants monstrueux à Dar dans le marais des Chagrins.‡给悲伤沼泽的达尔带去10条巨大的螃蟹腿。‡給悲傷沼澤的達爾帶去10條巨大的螃蟹腿。',
  }
},
[1431] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдрином в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화하십시오.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡與奧格瑪的科爾丹談話。',
  }
},
[1432] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Stahlklinge in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화하십시오.‡Habla con Takata Hojacero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parler à Takata Lamacier en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡與淒涼之地的塔卡塔·鋼刃談話。',
  }
},
[1433] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡',
    nil,
    'Fale com Maurin Rachaosso em Desolação.‡Поговорите с Морином Костоломом в Пустошах.‡Sprecht mit Maurin Knochenspalter in Desolace.‡잊혀진 땅에 있는 마우린 본스플리터와 대화해야 합니다.‡Habla con Maurin Partehuesos en Desolace.‡Habla con Maurin Partehuesos en Desolace.‡Parler à Maurin Craquossement en Désolace.‡去找凄凉之地的玛乌林·碎骨谈一谈。‡',
  }
},
[1434] = {
  {
    'Mácula dos sátiros‡Опоганенные сатиры‡Beschmutzt durch Satyrn‡사티로스의 출몰‡La contaminación del sátiro‡La contaminación del sátiro‡Souillé par les satyres‡萨特的威胁‡薩特的威脅',
    nil,
    'Mate 7 Errantes Furiódios, 7 Devotos Vis Furiódios, 7 Traidores Furiódios e 7 Arautos Infernais Furiódios. Depois fale com Takta Laminaço em Desolação.‡Убейте 7 разбойников из племени Ярой Ненависти, 7 скверноподданных из племени Ярой Ненависти, 7 предателей из племени Ярой Ненависти и 7 адских сатиров из племени Ярой Ненависти и вернуться к Такате Стальному Клинку в Пустоши.‡Besiegt 7 Schurken der Zornsäer, 7 Teufelsanbeter der Zornsäer, 7 Verräter der Zornsäer sowie 7 Höllenrufer der Zornsäer und kehrt zu Takata Stahlklinge in Desolace zurück.‡서릿발분노의 암살자 7명, 서릿발분노의 악마추종자 7명, 서릿발분노의 배반자 7명, 그리고 서릿발분노의 지옥소환사 7명을 처치한 후 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가야 합니다.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hojacero a Desolace.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hoja de Acero a Desolace.‡Massacrer 7 Voleurs Fielfurie, 7 Gangreliges Fielfurie, 7 Traîtres Fielfurie et 7 Implorateurs de l\'enfer Fielfurie, puis retourner voir Takata Lamacier en Désolace.‡杀死7只怨怒潜行者、7只怨怒魔仆、7只怨怒背叛者和7只怨怒唤魔者，然后向凄凉之地的塔卡塔·钢刃复命。‡殺死7隻怨怒盜賊、7隻怨怒魔僕、7隻怨怒背叛者和7隻怨怒喚魔者，然後向淒涼之地的塔卡塔·鋼刃覆命。',
  }
},
[1435] = {
  {
    'A queima dos espíritos‡Сжигание душ‡Brennender Geist‡불타는 영혼‡Los espíritus ardientes‡Los espíritus ardientes‡Esprits consumés‡灵魂的燃烧‡靈魂的燃燒',
    nil,
    'Devolva a Gema Ardente e leve 15 Gemas Ardentes Infusas para Maurin Rachaosso na Desolação.‡Верните пылающий самоцвет и 15 усиленных пылающих самоцветов Морину Костолому в Пустошах.‡Bringt den brennenden Edelstein und 15 erfüllte brennende Edelsteine nach Desolace zu Maurin Knochenspalter.‡잊혀진 땅에 있는 마우린 본스플리터에게 빌린 불타는 보석 하나와 영혼이 깃든 불타는 보석 15개를 가져가야 합니다.‡LLeva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Lleva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Apporter une Gemme ardente et 15 Gemmes ardentes canalisées à Maurin Craquossement en Désolace.‡将15块燃烧宝石转变为灌入灵魂的燃烧宝石，然后把它们交给凄凉之地的玛乌林·碎骨。‡將燃燒寶石和15顆靈魂灌注的燃燒寶石交給淒涼之地的莫林·碎骨者。',
  }
},
[1436] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдрином в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화하십시오.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡',
  }
},
[1437] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Procure a carroça de Tyranis e Dalinda Malem na Desolação.‡Отправляйтесь в Пустоши и попытайтесь отыскать повозку Тираниса и Далинды Малем.‡Sucht und findet den Wagen von Tyranis und Dalinda Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘과 달린다 말렘의 마차를 찾아 조사해야 합니다.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Rechercher le chariot de Tyranis et de Dalinda Malem en Désolace.‡去凄凉之地寻找泰拉尼斯·玛雷姆和黛琳达·玛雷姆的马车。‡去淒涼之地尋找泰拉尼斯·瑪雷姆和黛琳達·瑪雷姆的馬車。',
  }
},
[1438] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Encontre Dalinda Malem na Desolação.‡Найдите в Пустошах Далинду Малем.‡Sucht Dalinda Malem in Desolace.‡잊혀진 땅에서 달린다 말렘을 찾아야 합니다.‡Encuentra a Dalinda Malem en Desolace.‡Encuentra a Dalinda Malem en Desolace.‡Trouver Dalinda Malem en Désolace.‡去凄凉之地找到黛琳达·玛雷姆。‡去淒涼之地找到黛琳達·瑪雷姆。',
  }
},
[1439] = {
  {
    'A busca por Tyranis‡Поиски Тираниса‡Suche nach Tyranis‡티라니스 수색‡Buscando a Tyranis‡Buscando a Tyranis‡À la recherche de Tyranis‡寻找泰拉尼斯‡尋找泰拉尼斯',
    nil,
    'Encontre Tyranis Malem na Desolação.‡Разыщите в безлюдье Тираниса Малема.‡Sucht Tyranis Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘을 찾아야 합니다.‡Encuentra a Tyranis Malem en Desolace.‡Encuentra a Tyranis Malem en Desolace.‡Trouver Tyranis Malem en Désolace.‡去凄凉之地找到泰拉尼斯·玛雷姆。‡去淒涼之地找到泰拉尼斯·瑪雷姆。',
  }
},
[1440] = {
  {
    'O retorno a Vahlarriel‡Возвращение к Валарриэлю‡Rückkehr zu Vahlarriel‡발라리엘에게 돌아가기‡Vuelve con Vahlarriel‡Regresa junto a Vahlarriel‡Le retour vers Vahlarriel‡回复瓦拉里尔‡',
    nil,
    'Escolte Dalinda Malem a partir da Fortaleza Machado do Trovão e fale novamente com Vahlarriel Matademônios na Desolação.‡Выведите Далинду Малем из Крепости Громового Топора, а затем вернитесь в Пустоши к Валлариелю Истребителю Демонов.‡Begleitet Dalinda Malem aus der Festung Donneraxt und kehrt zu Vahlarriel Dämonenjäger nach Desolace zurück.‡천둥도끼 요새에서 달린다 말렘을 호위해 잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 돌아가야 합니다.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escorter Dalinda Malem depuis la forteresse de Hache-Tonnerre et retourner voir Vahlarriel Tueur-de-démons, en Désolace.‡护送黛琳达·玛雷姆离开雷斧堡垒，然后回到凄凉之地的瓦拉里尔·屠魔者那里。‡',
  }
},
[1442] = {
  {
    'Em busca da Gema Kor‡Поиск самоцвета Кора‡Suche nach dem Koredelstein‡코르석을 찾아서‡La búsqueda de la gema Kor‡La búsqueda de la gema Kor‡À la recherche de la gemme de Kor‡寻找科尔宝石‡',
    nil,
    'Leve a Gema Kor para Trovejius Tecevento, na Costa Negra.‡Принесите самоцвет Кора Тандрису Ветропряду на Темных берегах.‡Bringt einen Koredelstein zu Thundris Windwirker in Dunkelküste.‡어둠의 해안에 있는 툰드리스 윈드위버에게 코르석을 하나 가져가야 합니다.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Apporter une Gemme de Kor à Thundris Tissevent à Sombrivage.‡给黑海岸的桑迪斯·织风带去一块科尔宝石。‡',
  }
},
[1444] = {
  {
    'Retorno a Vil\'zerul‡Возвращение к Фел\'зерулу‡Rückkehr zu Fel\'Zerul‡펠제룰에게 돌아가기‡Vuelve con Fel\'Zerul‡Regresa junto a Fel\'Zerul‡De retour vers Fel’Zerul‡向费泽鲁尔复命‡向費澤盧爾覆命',
    nil,
    'Fale novamente com Vil\'Zerul em Pedregal.‡Вернитесь в Каменор к Фел\'зерулу.‡Kehrt zu Fel\'Zerul in Steinard zurück.‡스토나드에 있는 펠제룰에게 돌아가야 합니다.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Retourner voir Fel\'Zerul à Pierrêche.‡向斯通纳德的费泽鲁尔回报。‡向斯通納德的費澤盧爾回報。',
  }
},
[1445] = {
  {
    'O templo de Atal\'Hakkar‡Храм Атал\'Хаккар‡Der Tempel von Atal\'Hakkar‡아탈학카르 신전‡El Templo de Atal\'Hakkar‡El Templo de Atal\'Hakkar‡Le temple d\'Atal\'Hakkar‡阿塔哈卡神庙‡阿塔哈卡神廟',
    nil,
    'Obtenha 20 Fetiches de Hakkar e leve-os para Vil\'Zerul em Pedregal.‡Соберите 20 фетишей Хаккара и принесите их Фел\'зерулу в Каменор.‡Sammelt 20 Fetische von Hakkar und bringt sie zu Fel\'Zerul in Steinard.‡스토나드에 있는 펠제룰에게 학카르의 우상 20개를 가져가야 합니다.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Rassembler 20 Fétiches d\'Hakkar et les apporter à Fel\'Zerul à Pierrêche.‡收集20个哈卡神像，把它们带给斯通纳德的费泽鲁尔。‡收集20個哈卡神像，並把它們交給斯通納德的費澤盧爾。',
  }
},
[1446] = {
  {
    'Jammal\'an, o Profeta‡Джаммал\'ан Пророк‡Jammal\'an der Prophet‡예언자 잠말란‡Jammal\'an el Profeta‡Jammal\'an el Profeta‡Jammal\'an le Prophète‡预言者迦玛兰‡『預言者』迦瑪蘭',
    nil,
    'O Exilado Atal\'ai nas Terras Agrestes quer a Cabeça de Jammal\'an.‡Принесите изгнаннику Атал\'ай из Внутренних земель голову Джаммал\'ана.‡Der Verbannte der Atal\'ai im Hinterland möchte den Kopf von Jammal\'an.‡잠말란을 처치하고 그 증거로 그의 머리카락을 동부 내륙지에 있는 추방된 아탈라이트롤에게 가져가야 합니다.‡El exiliado Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡El exiliado Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡L\'Exilé atal\'ai des Hinterlands veut la Tête de Jammal\'an.‡辛特兰的阿塔莱流放者要你给他带回迦玛兰的头。‡辛特蘭的阿塔萊流放者想要迦瑪蘭的頭。',
  }
},
[1447] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrote Dashel Punhopétreo em Ventobravo.‡Победите Дашеля Каменного Кулака в Штормграде.‡Besiegt Dashel Steinfaust in Sturmwind.‡스톰윈드에 있는 다셸 스톤피스트와 싸워 이겨야 합니다.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Battre Dashel Poing-de-pierre à Hurlevent.‡击败暴风城的达舍尔·石拳。‡擊敗暴風城的達舍爾·石拳。',
  }
},
[1448] = {
  {
    'Em busca do templo‡В поисках Храма‡Auf der Suche nach dem Tempel‡신전을 찾아서‡En búsqueda del templo‡En búsqueda del templo‡À la recherche du temple‡调查神庙‡調查神廟',
    nil,
    'Brohann Barrilga, em Ventobravo, quer que você saia à procura do Templo de Atal\'Hakkar.‡Найдите храм Атал\'Хаккар и сообщите о его местонахождении Брохану Бочкопузу из Штормграда.‡Brohann Fassbauch in Sturmwind möchte, dass Ihr den Tempel von Atal\'Hakkar sucht.‡스톰윈드에 있는 브로한 캐스크벨리가 아탈학카르 신전을 찾아 달라고 부탁했습니다.‡Brohann Barriliga, en Ventormenta, quiere que busques el Templo de Atal\'Hakkar.‡Brohann Barriliga, en Ventormenta, quiere que busques El Templo de Atal\'Hakkar.‡Brohann Ventrabière à Hurlevent veut que vous recherchiez le temple d\'Atal\'Hakkar.‡暴风城的布罗哈恩·铁桶要求你去找到阿塔哈卡神庙。‡暴風城的布羅哈恩·鐵桶要求你去找到阿塔哈卡神廟。',
  }
},
[1449] = {
  {
    'Rumo às Terras Agrestes‡Во Внутренние земли‡Ins Hinterland‡동부 내륙지로‡A las Tierras del Interior‡A las Tierras del Interior‡Vers les Hinterlands‡去辛特兰的旅程‡前往辛特蘭',
    nil,
    'Fale com o Alto Thane Falstad Martelo Feroz no Ninho da Águia nas Terras Agrestes.‡Поговорите с верховным таном Фалстадом Громовым Молотом в Заоблачном Пике, что во Внутренних землях.‡Sprecht mit dem obersten Than, Falstad Wildhammer, am Nistgipfel im Hinterland.‡동부 내륙지 맹금의 봉우리에 있는 대영주 폴스타트 와일드해머와 대화해야 합니다.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Parler au haut-thane Falstad Marteau-hardi, au Nid-de-l\'Aigle des Hinterlands.‡找到辛特兰的弗斯塔德·蛮锤。‡到辛特蘭的鷹巢山找男爵族長弗斯塔德·蠻錘。',
  }
},
[1450] = {
  {
    'Mestre de Grifos Garra-de-acha‡Укротитель грифонов Разящий Коготь‡Greifenmeister Krallenaxt‡그리핀 조련사 탈론액스‡Maestro de grifos Garracha‡Maestro de grifos Garracha‡Le Maître des gryphons Talonaxe‡狮鹫管理员‡獅鷲獸管理員沙拉克·鷹斧',
    nil,
    'Fale com o Mestre de Grifos Garra-de-acha no Aviário do Ninho da Águia.‡Поговорите с укротителем грифонов Разящим Когтем в питомнике на Заоблачном Пике.‡Sprecht mit Greifenmeister Krallenaxt im Horst beim Nistgipfel.‡맹금의 봉우리 출격장 안에 있는 그리핀 조련사 탈론액스와 대화해야 합니다.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Parlez au Maître des griffons Hachegriffe dans la Volière de Nid-de-l\'Aigle.‡与辛特兰的鹰巢山狮鹫饲养场里的狮鹫管理员沙拉克·鹰斧谈一谈。‡與辛特蘭的鷹巢山獅鷲獸飼養場裡的獅鷲獸管理員沙拉克·鷹斧談話。',
  }
},
[1451] = {
  {
    'Rapsódico Festanjeiro‡Рапсод Землекоп‡Rhapsodie Kniegräber‡랩소디 신디거‡Rapsodio Machacacanillas‡Rapsodio Machacacanillas‡Rhapsody Shindigger‡拉普索迪·铁铲‡拉普索迪·鐵鏟',
    nil,
    'Procure Rapsódico Festanjeiro nas Terras Agrestes.‡Найдите Рапсода Землекопа во Внутренних землях.‡Sucht Rhapsodie Kniegräber im Hinterland.‡동부 내륙지에서 랩소디 신디거를 찾아야 합니다.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Chercher Rhapsody Croquejarret dans les Hinterlands.‡去辛特兰找到拉普索迪·铁铲。‡去辛特蘭找到拉普索迪·鐵鏟。',
  }
},
[1452] = {
  {
    'O Coquetel de Kalimdor do Rapsódico‡Калимдорский коктейль‡Rhapsodies Kalimdor-Cocktail‡랩소디의 칼림도어 칵테일‡El cubata de Kalimdor de Rapsodio‡El cubata de Kalimdor de Rapsodio‡Le Kocktail Kalimdor de Rhapsody‡拉普索迪的卡利姆多鸡尾酒‡拉普索迪的卡林多雞尾酒',
    nil,
    'Rapsódico Festanjeiro, nas Terras Agrestes, quer que você consiga 3 Moelas de Roca, 3 Fígados de Groddoc e 3 Fígados de Veloférreo.‡Принесите Рапсоду Землекопу 3 куска потрохов руха, 3 печени гроддока и 3 печени железномеха.‡Rhapsodie Kniegräber im Hinterland möchte, dass Ihr ihm 3 Muskelmägen eines Roc, 3 Groddoclebern und 3 Eisenfelllebern bringt.‡동부 내륙지에 있는 랩소디 신디거가 로크 모래주머니 3개, 그로독 고릴라 간 3개, 무쇠곰 간 3개를 가져다 달라고 부탁했습니다.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de Roc, 3 hígados de Groddoc y 3 hígados de Cueracero.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de roc, 3 hígados de Groddoc y 3 hígados de Cueracero.‡Rhapsody Shindigger dans les Hinterlands veut que vous lui rameniez 3 Gésiers de roc, 3 Foies de Groddoc et 3 Foies de Ferpoil.‡辛特兰的拉普索迪·铁铲要求你带给他3块大鹏的砂囊、3块格罗多克猩猩的肝脏和3块铁鬃熊的肝脏。‡辛特蘭的拉普索迪·鐵鏟要求你帶給他3塊大鵬的砂囊、3塊格羅多克猩猩的肝臟和3塊鐵鬃熊的肝臟。',
  }
},
[1453] = {
  {
    'Trago qualquer coisa em três dias‡Дела Поисковой корпорации в Пустошах‡Die Geschäfte der Wiederholer in Desolace‡잊혀진 땅에서의 회수 임무‡Los negocios de los Reivindicadores en Desolace‡Los negocios de los Recuperadores en Desolace‡Les affaires de Récupérateurs SA en Désolace‡寻物公司的业务‡尋物公司的業務',
    nil,
    'Fale com Kreldig Ungor, em Desolação.‡Поговорите с Крелдигом Унгором в Пустошах.‡Sprecht mit Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르와 대화해야 합니다.‡Habla con Kreldig Ungor en Desolace.‡Habla con Kreldig Ungor en Desolace.‡Parler à Kreldig Ungor en Désolace.‡和凄凉之地的克雷迪格·安戈尔谈一谈。‡和淒涼之地的克雷迪格·安戈爾談話。',
  }
},
[1454] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre o Baú de Karnitol em Desolação.‡Найдите в Пустошах сундук Карнитола.‡Sucht Karnitols Truhe in Desolace.‡잊혀진 땅에서 카니톨의 궤짝을 찾아야 합니다.‡Encuentra el cofre de Karnitol en Desolace.‡Encuentra el cofre de Karnitol en Desolace.‡Retrouver le Coffre de Karnitol en Désolace.‡在凄凉之地找到卡尼托的箱子。‡在淒涼之地找到卡尼托的箱子。',
  }
},
[1455] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Fale novamente com Kreldig Ungor em Desolação.‡Вернитесь в Пустоши к Крелдигу Унгору.‡Kehrt zu Kreldig Ungor in Desolace zurück.‡잊혀진 땅에 있는 크렐디그 운고르에게 돌아가야 합니다.‡Vuelve a Desolace a hablar con Kreldig Ungor.‡Vuelve a Desolace a hablar con Kreldig Ungor.‡Retourner voir Kreldig Ungor en Désolace.‡回到凄凉之地的克雷迪格·安戈尔那里。‡回到淒涼之地的克雷迪格·安戈爾那裡。',
  }
},
[1456] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre a Algibeira de Karnitol e leve-a de volta para Kreldig Ungor em Desolação.‡Найдите сумку для книг, принадлежащую Карнитолу, и отнесите ее в Пустоши Крелдигу Унгору.‡Sucht Karnitols Ranzen und bringt ihn zu Kreldig Ungor in Desolace zurück.‡카니톨의 가방을 찾아 잊혀진 땅에 있는 크렐디그 운고르에게 가져가야 합니다.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Retrouver la Sacoche de Karnitol et la rapporter à Kreldig Ungor en Désolace.‡找到卡尼托的背包，把它交给凄凉之地的克雷迪格·安戈尔。‡找到卡尼托的背包，把它交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1457] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的背包‡卡尼托的海難',
    nil,
    'Leve a Algibeira de Karnitol para Putren Rochamalho em Altaforja.‡Отнесите сумку для книг, принадлежащую Карнитолу, в Стальгорн, и отдайте ее Ройттену Камнемолоту.‡Bringt Karnitols Ranzen zu Roetten Steinhammer in Eisenschmiede.‡아이언포지에 있는 로이튼 스톤해머에게 카니톨의 가방을 가져가야 합니다.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Apporter la Sacoche de Karnitol à Roetten Martel-de-pierre à Forgefer.‡把卡尼托的背包交给铁炉堡的罗顿·石锤。‡把卡尼托的背包交給鐵爐堡的羅頓·石錘。',
  }
},
[1458] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 10 Garras Furiódio e 10 Chifres Furiódio para Kreldig Ungor na Desolação.‡Принесите 10 когтей и 10 рогов сатиров Ярой Ненависти в Пустоши Крелдигу Унгору.‡Bringt 10 Zornsäerklauen und 10 Zornsäerhörner zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 서릿발분노의 사티로스 발톱 10개와 서릿발분노의 사티로스 뿔 10개를 가져가야 합니다.‡Lleva 10 garras de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Lleva 10 zarpas de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Apporter 10 Griffes de Fielfurie et 10 Cornes de Fielfurie à Kreldig Ungor en Désolace.‡收集10只怨怒萨特的爪子和10根怨怒萨特的角，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10隻怨怒薩特的爪子和10根怨怒薩特的角，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1459] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 7 ampolas de Peçonha de Scorpachi e 3 Pelegos Envelhecidos de Kodo para Kreldig Ungor na Desolação.‡Принесите 7 фиалов скорпионьего яда и 3 шкуры старого кодо в Пустоши Крелдигу Унгору.‡Bringt 7 Phiolen Skorpashigift und 3 Bälge von gealterten Kodos zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 스콜파시 독 7병과 늙은 코도 통가죽 3개를 가져가야 합니다.‡Lleva 7 viales de veneno Scorpashi y 3 pellejos de kodo envejecido a Kreldig Ungor a Desolace.‡Lleva 7 viales de veneno de Scorpashi y 3 pellejos de kodo envejecido a Kreldig Ungor a Desolace.‡Apporter 7 Fioles de venin scorpashi et 3 Peaux de vieux kodo à Kreldig Ungor, en Désolace.‡收集7瓶鞭尾蝎的毒液和3块老迈科多兽的毛皮，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集7瓶鞭尾蠍的毒液和3塊老邁科多獸的毛皮，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1462] = {
  {
    'Sapta da Terra‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    'Fale com a Vidente Pena do Corvo para obter outra Sapta da Terra.‡Попросите у провидицы Воронье Перо еще одну сапту земли.‡Sprecht mit Seherin Rabenfeder wegen eines weiteren Erdsaptas.‡예언자 레이븐페더에게 대지의 정기를 하나 더 부탁해야 합니다.‡Pide otra sapta de tierra a la profetisa Plumacuervo.‡Pide otra sapta de tierra a la vidente Pluma de Cuervo.‡Parler à la Prophétesse Plume-de-corbeau pour obtenir un autre Sapta de terre.‡向鸦羽先知要另一瓶大地灵契。‡',
  }
},
[1463] = {
  {
    'Sapta da Terra‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    'Fale com Ranago Arauto da Terra para obter outra Sapta da Terra.‡Поговорите с Канагой заклинателем земли, чтобы получить еще один сапту земли.‡Sprecht mit Canaga Erdenrufer wegen eines weiteren Erdsaptas.‡카나가 어스콜러에게 대지의 정기를 하나 더 달라고 부탁하십시오.‡Pide a Canaga Clamor de Tierra otra Sapta de tierra.‡Pide a Canaga Clamatierras otra sapta de tierra.‡Parler à Canaga Hucheterre pour obtenir un autre Sapta de terre.‡向坎纳甘·地鸣要另一瓶大地灵契。‡',
  }
},
[1464] = {
  {
    'Sapta do Fogo‡Сапта огня‡Feuersapta‡불의 정기‡La sapta de fuego‡La sapta de fuego‡Le sapta de feu‡火焰灵契‡火焰靈契',
    nil,
    'Fale com Telf Joolam para obter outra Sapta do Fogo.‡Поговорите с Телфом Джоламом, чтобы получить еще одну сапту огня.‡Sprecht mit Telf Joolam wegen eines weiteren Feuersaptas.‡텔프 줄람에게 불의 정기를 하나 더 부탁하십시오.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Parler à Telf Joolam pour obtenir un autre Sapta de feu.‡向泰尔夫·祖拉姆再要一个 火焰灵契。‡',
  }
},
[1465] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Entregue o Pingente de Malem a Vahlarriel Matademônios na Desolação.‡Принесите подвеску Малемов в Пустоши Валарриелю Истребителю Демонов.‡Kehrt mit Malems Anhänger zu Vahlarriel Dämonenjäger in Desolace zurück.‡잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 말렘 펜던트를 가져가야 합니다.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Lleva el colgante Malem a Vahlarriel Destripademonios a Desolace.‡Rapporter le Pendentif de Malem à Vahlarriel Tueur-de-démons en Désolace.‡向凄凉之地的瓦拉里尔·屠魔者回复。‡將瑪雷姆墜子帶回去給淒涼之地的瓦拉里爾·屠魔者。',
  }
},
[1466] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 10 Cérebros de Canisvil, 10 Asas Etéreas e 10 ampolas de Sangue do Guardião da Ruína para Kreldig Ungor na Desolação.‡Принесите 10 мозгов гончих Скверны, 10 крыльев пустоты и 10 фиалов крови Тюремщика Судеб в Пустоши Крелдигу Унгору.‡Bringt 10 Teufelshundgehirne, 10 Netherflügel und 10 Phiolen Verdammniswächterblut zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 지옥사냥개 뇌 10개, 황천의 날개 10개, 파멸의경비대 혈액 10병을 가져가야 합니다.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de Guardiavil a Kreldig Ungor a Desolace.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de guardiavil a Kreldig Ungor a Desolace.‡Apporter 10 Cervelles de gangrechiens, 10 Ailes du Néant et 10 Fioles de Sang de garde funeste à Kreldig Ungor, en Désolace.‡收集10个地狱犬的脑子、10对魔女之翼和10瓶末日看守之血，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10個虛空犬的腦子、10對魔女之翼和10瓶末日守衛之血，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1467] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реактивы для Поисковой корпорации‡Reagenzien für die Wiederholer AG.‡회수전문회사를 위한 재료‡Componentes para Reivindicadores y Cía.‡Componentes para Recuperadores S.A.‡Des réactifs pour Récupérateurs SA‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve a Encomenda de Sinismago para Putren Rochamalho em Altaforja.‡Доставьте коробку Скрытного Кудесника в Стальгорн Ройттену Камнемолоту.‡Bringt Leftwitchs Päckchen zu Roetten Steinhammer in Eisenschmiede zurück.‡아이언포지에 있는 로이튼 스톤해머에게 레프트위치의 소포를 가져가야 합니다.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Rapporter la Caisse de Leftwitch à Roetten Martel-de-pierre à Forgefer.‡把莱弗维奇的包裹交给铁炉堡的罗顿·石锤。‡把萊弗維奇的包裹交給鐵爐堡的羅頓·石錘。',
  }
},
[1468] = {
  {
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童週',
    nil,
    'Use o Apito de Órfão Humano para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Чтобы поговорить с ребенком, за которым вы будете присматривать, используйте сиротский свисток.‡Benutzt die Pfeife des Menschenwaisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡인간 고아 호루라기를 사용해 어린이 주간 동안 돌보게 될 아이와 대화하십시오.‡Utiliza el silbato de huérfano humano para hablar con el niño a quien tienes que cuidar durante la Semana de los niños.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utilisez le Sifflet d\'orphelin humain pour parler à l\'enfant que vous protégerez pendant la Semaine des enfants.‡使用人类孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用人類孤兒哨來和你在兒童週期間要照顧的孩子進行對話。',
  }
},
[1469] = {
  {
    'O caso do Rapsódico‡Рапсодия о болоте‡Rhapsodies Geschichte‡랩소디의 이야기‡El relato de Rapsodio‡El relato de Rapsodio‡L\'histoire de Rhapsody‡拉普索迪的故事‡拉普索迪的故事',
    nil,
    'Leve o Fragmento de Tabuleta Atal\'ai para Brohann Barrilga em Ventobravo.‡Отнесите фрагмент таблички Атал\'ай Брохану Бочкопузу в Штормград.‡Bringt das Schrifttafelfragment der Atal\'ai zu Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 조각을 가져가야 합니다.‡Lleva el trozo de tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Lleva el fragmento de la tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Apporter le Fragment de tablette atal\'ai à Brohann Ventrabière à Hurlevent.‡将阿塔莱石板碎片交给暴风城的布罗哈恩·铁桶。‡將阿塔萊石板碎片交給暴風城的布羅哈恩·鐵桶。',
  }
},
[1470] = {
  {
    'Perfurando o véu‡Приоткрывая завесу‡Der zerrissene Schleier‡저 너머의 세계‡Descubrir el misterio‡Descubrir el misterio‡Lever le voile‡控制小鬼‡控制小鬼',
    nil,
    'Leve 3 Crânios de Range-ossos para Vênia Martingil.‡Принесите Вении Мартанд 3 черепа скелетов-костетрясов.‡Bringt Venya Marthand 3 Schädel eines klappernden Skeletts.‡벤야 말선드에게 덜그럭거리는 해골 3개를 가져가야 합니다.‡Lleva 3 calaveras armadóseas a Venya Martmani.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Apporter 3 Crânes de Cliquethorax à Venya Marthand.‡收集3个断骨骷髅的颅骨，把它们交给温雅·玛山德。‡收集3個斷骨骷髏的顱骨，把它們交給溫雅·瑪山德。',
  }
},
[1471] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    'Usando as Runas de Evocação, evoque e subjugue um Emissário do Caos. Depois, devolva os Glifos de Evocação para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи рун призыва вызовите и подчините себе демона Бездны, а потом верните руны призыва Карендину Халгару в Квартале магов Подгорода.‡Beschwört mit Hilfe der Runen der Beschwörung einen Leerwandler, unterwerft ihn und bringt die Runen der Beschwörung dann zu Carendin Halgar im Magieviertel von Unterstadt zurück.‡소환의 룬을 사용하여 보이드워커를 소환하여 제압한 다음 언더시티의 마법 지구에 있는 카렌딘 할가르에게 소환의 룬을 가지고 돌아가야 합니다.‡Utilizando las Runas de Invocación, invoca y domina a un abisario, y después devuélvele las Runas de Invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Runes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Runes d\'invocation à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只虚空行者，然后将召唤符文还给诅咒神庙中的凯伦丁·哈加尔。‡',
  }
},
[1472] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼에 굶주린 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Godofredo Fasano no Templo dos Malditos.‡Поговорите с Годриком Фарсаном в Храме Проклятых.‡Sprecht mit Godrick Farsan im Tempel der Verdammten.‡저주의 사원에 있는 고드릭 파선과 대화해야 합니다.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Parler à Godrick Farsan au Temple des damnés.‡与诅咒神殿中的高德瑞克·法杉谈一谈。‡與詛咒神殿中的高德瑞克·法杉談話。',
  }
},
[1473] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 피조물‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere o Grimório de Egalin e leve-o para Silvério Hidalgo no Templo dos Malditos.‡Найдите гримуар Эгалина и отнесите его Карендину Халгару в Храм Проклятых.‡Beschafft Egalins Zauberfolianten und bringt ihn zu Carendin Halgar in den Tempel der Verdammten.‡에갈린의 흑마법서를 되찾아 저주의 사원에 있는 카렌딘 할가르에게 가져가야 합니다.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Retrouver le Grimoire d\'Egalin et l\'apporter à Carendin Halgar au Temple des damnés.‡夺回埃加林的魔典，把它交给诅咒神庙中的凯伦丁·哈加尔。‡奪回埃加林的魔典，把它交給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1474] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Corações Puros, evoque e subjugue uma súcubo. Depois, devolva os Corações Puros para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи чистых сердец призовите и подчините суккуба, а потом верните чистые сердца Карендину Халгару в Квартале магов Подгорода.‡Beschwört mit Hilfe der reinen Herzen einen Sukkubus, unterwerft ihn und bringt die reinen Herzen dann zu Carendin Halgar im Magieviertel von Unterstadt zurück.‡순수한 심장을 사용하여 서큐버스를 소환하여 제압한 다음, 언더시티에 있는 마법 지구에 있는 카렌딘 할가르에게 순수한 심장을 가져가야 합니다.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Coeurs purs pour invoquer et soumettre une succube, puis rapporter les Coeurs purs à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只魅魔，然后将纯洁的心还给诅咒神庙里的凯伦丁·哈加尔。‡召喚並征服一隻魅魔，然後將純潔的心還給詛咒神廟裡的凱倫丁·哈加爾。',
  }
},
[1475] = {
  {
    'No templo de Atal\'Hakkar‡В храм Атал\'Хаккар‡Im Tempel von Atal\'Hakkar‡아탈학카르 신전으로‡En El Templo de Atal\'Hakkar‡En El Templo de Atal\'Hakkar‡Dans le temple d\'Atal\'Hakkar‡进入阿塔哈卡神庙‡進入阿塔哈卡神廟',
    nil,
    'Leve 10 Tabuletas Atal\'ai para Brohann Barrilga em Ventobravo.‡Соберите 10 табличек Атал\'ай для Брохана Бочкопуза из Штормграда.‡Sammelt 10 Schrifttafeln der Atal\'ai für Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 10개를 가져가야 합니다.‡Consigue 10 tablillas Atal\'ai para Brohann Barriliga, en Ventormenta.‡Consigue 10 tablillas de Atal\'ai para Brohann Barriliga, en Ventormenta.‡Rassembler 10 Tablettes atal\'ai pour Brohann Ventrabière à Hurlevent.‡为暴风城的布罗哈恩·铁桶收集10块阿塔莱石板。‡為暴風城的布羅哈恩·鐵桶收集10塊阿塔萊石板。',
  }
},
[1476] = {
  {
    'Corações dos Puros‡Чистые сердца‡Herzen der Reinen‡선한 자의 유품‡Corazones puros‡Corazones puros‡Des cœurs purs‡纯洁者之心‡純潔者之心',
    nil,
    'Leve os corações de Dalin Forjífice e Comar Villard para Silvério Hidalgo no Templo dos Malditos.‡Принесите сердца Далина Искусника и Комера Вилларда Карендину Халгару в Храм Проклятых.‡Bringt die Herzen von Dalin Schmiedevater und Comar Villard zu Carendin Halgar im Tempel der Verdammten.‡저주의 사원에 있는 카렌딘 할가르에게 달린의 유품과 코마의 유품을 가져가야 합니다.‡Llévale los corazones de Dalin Forjador y Comar Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Llévale los corazones de Dalin Forjador y Comar Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Apporter les Cœurs de Dalin Forgebusier et de Comar Villard à Carendin Halgar dans le Temple des Damnés.‡将达林和科马的心脏交给诅咒神殿里的凯伦丁·哈加尔。‡將達林和科馬的心臟交給詛咒神殿裡的凱倫丁·哈加爾。',
  }
},
[1477] = {
  {
    'Suprimentos Vitais‡Важные поставки‡Überaus wichtige Vorräte‡중요한 보급품‡Suministros de vital importancia‡Suministros de vital importancia‡Fournitures vitales‡重要的补给‡重要的補給',
    nil,
    'Fale com Mestre-Vigia Sorigal.‡Поговорите с начальником стражи Соригелом.‡Sprecht mit Wachhauptmann Sorigal.‡순찰대장 소리갈을 만나 이야기를 나눠야 합니다.‡Habla con el maestro de vigilantes Sorigal.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Parler au Maître de guet Sorigal.‡和守卫队长索里加尔谈一谈。‡和守衛隊長索里加爾談話。',
  }
},
[1478] = {
  {
    'Convocação de Hidalgo‡Призыв Халгара‡Halgars Beschwörung‡할가르의 부름‡Las invocaciones de Halgar‡Las invocaciones de Halgar‡Les invocations de Halgar‡哈加尔的召唤‡哈加爾的召喚',
    nil,
    'Fale com Silvério Hidalgo na Cidade Baixa.‡Поговорите с Карендином Халгаром в Подгороде.‡Sprecht mit Carendin Halgar in Unterstadt.‡언더시티에 있는 카렌딘 할가르와 대화해야 합니다.‡Habla con Carendin Halgar en Entrañas.‡Habla con Carendin Halgar en Entrañas.‡Parler à Carendin Halgar à Fossoyeuse.‡与幽暗城的凯伦丁·哈加尔谈一谈。‡與幽暗城的凱倫丁·哈加爾談話。',
  }
},
[1479] = {
  {
    'O Ramo dos Eternos‡Купина Вечности‡Der Baum der Ewigen‡영원의 줄기‡La Rama de los Eternos‡La Rama de los Eternos‡Le Rameau des Éternels‡永恒之树‡',
    nil,
    'Leve o órfão ao banco de Darnassus. O banco foi esculpido dentro de uma árvore, conhecida como o Ramo dos Eternos.‡Отведите сироту к банку Дарнасса. Банк находится в дупле дерева, которое называется Купина Вечности.‡Begleitet Euren Schützling zur Bank in Darnassus. Die dortige Bank ist in einen Baum gebaut, welcher als der Baum der Ewigen bekannt ist.‡랜디스를 다르나서스 은행에 데려다 주어야 합니다. 은행 자체는 영원의 줄기라고 알려진 나무 안에 있습니다.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Conduire l\'orphelin à la banque de Darnassus. La banque est creusée dans le tronc d\'un arbre connu sous le nom du Rameau des Éternels.‡带着你看护的孤儿去达纳苏斯的银行。银行就坐落在一棵中空的树里，它被称为永恒之树。‡',
  }
},
[1480] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve a Pele de Demônio Esfolada a Maurin Rachaosso na Desolação.‡Отнесите рваную шкуру демона Морину Костолому в Пустоши.‡Bringt die geschundene Dämonenhaut nach Desolace zu Maurin Knochenspalter.‡잊혀진 땅에 있는 마우린 본스플리터에게 악마의 가죽을 가져다주십시오.‡Lleva la piel de demonio despellejada a Maurin Partehuesos a Desolace.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Apporter une Peau de démon écorché à Maurin Craquossement en Désolace.‡把恶魔之皮拿给凄凉之地的玛乌林·碎骨看看。‡把這塊惡魔之皮拿給淒涼之地的莫林·碎骨看看。',
  }
},
[1481] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Escalpo de Assombrante para Maurin Rachaosso na Desolação.‡Принесите скальп тенелова Морину Костолому в Пустошах.‡Bringt Maurin Knochenspalter in Desolace einen Schattenpirscherskalp.‡잊혀진 땅에 있는 마우린 본스플리터에게 그림자추적자 머릿가죽을 가져가야 합니다.‡Lleva 1 cabellera Acechasombras a Maurin Partehuesos a Desolace.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Apporter un Scalp de traqueur des ombres à Maurin Craquossement en Désolace.‡给凄凉之地的玛乌林·碎骨带回一张巡影者的头皮。‡帶一張巡影者的頭皮回來給淒涼之地的莫林·碎骨者。',
  }
},
[1482] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Cristal de Oráculo para Maurin Rachaosso em Desolação.‡Принесите кристалл оракула Морину Костолому в Пустоши.‡Bringt Maurin Knochenspalter in Desolace einen Orakelkristall.‡잊혀진 땅에 있는 마우린 본스플리터에게 예언의 수정구를 가져가야 합니다.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Apporter un Cristal d\'oracle à Maurin Craquossement, en Désolace.‡给凄凉之地的玛乌林·碎骨带回一块神谕水晶。‡帶一塊神諭水晶回來給淒涼之地的莫林·碎骨者。',
  }
},
[1483] = {
  {
    'Zé Fízzica‡Зиз Физзикс‡Ziz Fizziks‡지즈 피직스‡Ziz Fizziks‡Ziz Fizziks‡Ziz Fizzik‡菲兹克斯‡菲茲克斯',
    nil,
    'Fale com Zé Fízzica em Rochedo Cortavento.‡Поговорите с Зизом Физзиксом на Утесе Ветрорезов.‡Sprecht mit Ziz Fizziks bei der Scherwindklippe.‡칼바람 바위산에 있는 지즈 피직스와 대화하십시오.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Habla con Ziz Fizziks en Risco Cortaviento.‡Parler à Ziz Fizzik dans la Combe des Cisailles.‡和狂风峭壁的菲兹克斯谈一谈。‡和狂風峭壁的菲茲克斯談話。',
  }
},
[1484] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Stahlklinge in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화하십시오.‡Habla con Takata Hojacero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parler à Takata Lamacier en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡',
  }
},
[1485] = {
  {
    'Familiares Vis‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Leve 6 Cabeças de Demônios Familiares Vis para Ruzan.‡Принесите Рузану 6 голов злобных фамильяров.‡Bringt 6 Köpfe übler Familiare zu Ruzan.‡루잔에게 악마의 하수인 머리 6개를 가져가야 합니다.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Apporter 6 Têtes de vils quasits à Ruzan.‡给鲁赞带回6颗邪灵劣魔的头颅。‡帶6顆邪靈劣魔的頭顱回來給魯贊。',
  }
},
[1486] = {
  {
    'Pelegos anormais‡Шкуры загадочных существ‡Deviatbälge‡돌연변이 통가죽‡Pellejo de los descarriados‡Pellejos descarriados‡Les peaux de déviants‡变异皮革‡變異皮革',
    nil,
    'Nalpak na Caverna Ululante quer 20 Pelegos Anormais.‡Принесите 20 искаженных шкур Налпаку в Пещерах Стенаний.‡Nalpak in den Höhlen des Wehklagens möchte 20 Deviatbälge.‡통곡의 동굴에 있는 날팍이 돌연변이 통가죽 20개를 가져다 달라고 부탁했습니다.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos de los descarriados.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos descarriados.‡Nalpak, dans les Cavernes des lamentations, veut 20 Peaux de déviants.‡哀嚎洞穴的纳尔帕克想要20张变异皮革。‡哀嚎洞穴的納爾派克想要20張變異皮革。',
  }
},
[1487] = {
  {
    'Erradicação de Anormais‡Искоренение Скверны‡Ausrottung der Deviat‡돌연변이 짐승 섬멸‡Erradicación de descarriados‡Erradicación de descarriados‡L\'éradication des déviants‡清除变异者‡清除變異者',
    nil,
    'Ebru, na Caverna Ululante, quer que você mate 7 Assoladores Anormais, 7 Víboras Anormais, 7 Trôpegos Anormais e 7 Presáteras Anormais.‡Убейте для Эбру 7 загадочных опустошителей, 7 загадочных гадюк, 7 загадочных шаркунов и 7 загадочных страхозубов.‡Ebru in den Höhlen des Wehklagens möchte, dass Ihr 7 Deviatverheerer, 7 Deviatvipern, 7 Deviatschlurfer und 7 Deviatschreckensfange tötet.‡통곡의 동굴에 있는 에브루가 돌연변이 약탈자랩터 7마리, 돌연변이 독사 7마리, 돌연변이 늪괴물 7마리, 돌연변이 송곳니천둥매 7마리를 처치해 달라고 부탁했습니다.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrados descarriados y 7 colminfernos descarriados.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrapiés descarriados y 7 colminfernos descarriados.‡Ebru, dans les Cavernes des lamentations, veut que vous tuiez 7 Ravageurs déviants, 7 Vipères déviantes, 7 Traînards déviants et 7 Crocs-d\'effroi déviants.‡哀嚎洞穴的厄布鲁要求你杀掉7只变异破坏者、7只剧毒飞蛇、7只变异蹒跚者和7只变异尖牙风蛇。‡哀嚎洞穴的厄布魯要求你殺掉7隻變異劫毀者、7隻劇毒飛蛇、7隻變異蹣跚者和7只變異尖牙風蛇。',
  }
},
[1488] = {
  {
    'O corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Mate Lorde Azrethoc e Jugkar Grim\'rod e fale novamente com Takta Laminaço em Desolação.‡Убейте лорда Азретока и Джуккара Грим\'рода и вернитесь к Такате Стальному Клинку в Пустоши.‡Besiegt Lord Azrethoc und Jugkar Grimm\'rod. Kehrt dann zu Takata Stahlklinge in Desolace zurück.‡제왕 아즈레토크와 죽카르 그림로드를 처치하고 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가야 합니다.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hojacero a Desolace.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Tuer le seigneur Azrethoc et Jugkar Grim\'rod puis retourner voir Takata Lamacier en Désolace.‡杀掉魔王阿兹雷索克和祖格卡，然后向凄凉之地的塔卡塔·钢刃复命。‡殺掉阿茲雷索克領主和祖格卡，然後向淒涼之地的塔卡塔·鋼刃覆命。',
  }
},
[1489] = {
  {
    'Hamuul Runa Totem‡Хамуул Рунический Тотем‡Hamuul Runentotem‡하뮬 룬토템‡Hamuul Runatótem‡Hamuul Runatótem‡Hamuul Runetotem‡哈缪尔·符文图腾‡哈繆爾·符文圖騰',
    nil,
    'Fale com Hamuul Runa Totem.‡Поговорите с Хамуулом Руническим Тотемом.‡Sprecht mit Hamuul Runentotem.‡하뮬 룬토템과 대화하십시오.‡Habla con Hamuul Runatótem.‡Habla con Hamuul Runatótem.‡Parler à Hamuul Runetotem.‡和哈缪尔·符文图腾谈一谈。‡和哈繆爾·符文圖騰談話。',
  }
},
[1490] = {
  {
    'Nara Juba Agreste‡Нара Буйногривая‡Nara Wildmähne‡나라 와일드메인‡Nara Bravacrín‡Nara Ferocrín‡Nara Wildmane‡纳拉·蛮鬃‡納拉·蠻鬃',
    nil,
    'Fale com Nara Juba Agreste.‡Поговорите с Нарой Буйногривой.‡Sprecht mit Nara Wildmähne.‡나라 와일드메인과 대화하십시오.‡Habla con Nara Bravacrín.‡Habla con Nara Ferocrín.‡Parler à Nara Wildmane.‡和纳拉·蛮鬃谈一谈。‡和納拉·蠻鬃談話。',
  }
},
[1491] = {
  {
    'Bebidas inteligentes‡Умный напиток‡Klugheitstränke‡영리해지는 음료‡Las bebidas astutas‡Bebidas de inteligencia‡Les potions d\'intelligence‡智慧饮料‡智慧飲料',
    nil,
    'Leve 6 porções de Essência Ululante para Cáliper Porcatraca na Vila Catraca.‡Принесите 6 порций воющей субстанции Мебоку Миззриксу в Кабестан.‡Bringt 6 Portionen Klageessenz zu Mebok Mizzyrix in Ratschet.‡톱니항에 있는 메보크 미지릭스에게 통곡의 정수 6병을 가져가야 합니다.‡Llévale 6 unidades de esencia de lamentos a Mebok Mizzyrix en Trinquete‡Reúne 6 unidades de esencia de lamentos.‡Apporter 6 doses d\'Essence de lamentation à Mebok Mizzyrix, à Ratchet.‡收集6份哀嚎香精，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集6份哀嚎香精，把它們交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1492] = {
  {
    'Mestre Portuário Caruncho‡Управляющий пристанью Головокружилкинc‡Werftmeister Flunkerblick‡부두주임 디지위그‡Maestro de muelles Vertipeluca‡Maestro de muelles Vertipeluca‡Maître des quais Tournoupette‡码头管理员迪兹维格‡碼頭管理員迪茲維格',
    nil,
    'Leve o Caixote Fechado para o Mestre Portuário Caruncho na Vila Catraca.‡Отнесите надежный ящик управляющему пристанью Головокружилкинcу в Кабестан.‡Bringt die gesicherte Kiste zu Werftmeister Flunkerblick in Ratschet.‡톱니항에 있는 부두주임 디지위그에게 단단히 잠긴 상자를 가져가야 합니다.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Apporter la Caisse sûre au Maître des quais Tournoupette à Cabestan.‡把保险箱交给棘齿城的码头管理员迪兹维格。‡把保險箱交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1498] = {
  {
    'Caminho da defesa‡Путь защиты‡Weg der Verteidigung‡수호자의 길‡Camino de defensa‡Camino de defensa‡La voie de la défense‡防御之道‡防禦之道',
    nil,
    'Leve 5 Escamas Chamuscadas para Uzzek no Posto Remoto, nos Sertões.‡Принесите 5 оплавленных чешуек Уззеку на Дальнюю заставу в Степях.‡Bringt 5 versengte Schuppen zu Uzzek bei der Fernwacht im Brachland.‡불모의 땅의 전초 기지에 있는 우제크에게 그슬린 비늘 5개를 가져가야 합니다.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Apporter 5 Ecailles roussies à Uzzek au Poste de garde extérieur dans les Tarides.‡给贫瘠之地前沿哨所的犹塞克带回5块烧焦的鳞片。‡帶5塊燒焦的鱗片回來給貧瘠之地前沿哨所的猶塞克。',
  }
},
[1499] = {
  {
    'Familiares torpes‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Fale com Zureta Vista-longa.‡Поговорите с Зуритой Востроглазой.‡Sprecht mit Zureetha Fernblick.‡주리타 파게이즈와 대화해야 합니다.‡Habla con Zureetha Vistalonga.‡Habla con Zureetha Vistalonga.‡Parler à Zureetha Mireloin.‡与祖雷萨谈一谈。‡與祖雷薩談話。',
  }
},
[1500] = {
  {
    'Despertando Naralex‡Пробуждение Наралекса‡Die Erweckung von Naralex‡깨어나는 나랄렉스‡Naralex ambulante‡‡Le réveil de Naralex‡唤醒纳拉雷克斯‡喚醒納拉雷克斯',
    nil,
    nil,
  }
},
[1501] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 존재‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere a Tabuleta de Verga para Gan\'rul Olho de Sangue em Orgrimmar.‡Добудьте табличку Верги для Ган\'рула Кровавого Глаза в Оргриммаре.‡Holt die Schrifttafel der Verga für Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이가 베르가의 서판을 되찾아 오라고 부탁했습니다.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Récupérer la Tablette de Verga pour Gan\'rul Oeil-sanglant à Orgrimmar.‡为奥格瑞玛的甘鲁尔·血眼找回维尔加石板。‡為奧格瑪的甘盧爾·血眼找回維爾加石板。',
  }
},
[1502] = {
  {
    'Thun\'grim Olhafogo‡Тун\'грим Огневзор‡Thun\'grim Brandblick‡툰그림 파이어게이즈‡Thun\'grim Vistafuego‡Thun\'grim Vistafuego‡Thun\'grim Firegaze‡索恩格瑞姆·火眼‡索恩格瑞姆·火眼',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화하십시오.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Mirefeu dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談話。',
  }
},
[1503] = {
  {
    'Aço forjado‡Стальные слитки‡Geschmiedeter Stahl‡단조된 강철‡Acero fundido‡Acero fundido‡Acier forgé‡锻造好的钢锭‡鍛造好的鋼錠',
    nil,
    'Leve as Barras de Aço Forjado para Thun\'grim Olhafogo nos Sertões.‡Принесите стальные слитки Тун\'гриму Огневзору из Степей.‡Bringt die Schmiedestahlbarren zu Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈에게 단조된 강철 주괴를 가져가야 합니다.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Apporter les Barres d\'Acier forgé à Thun\'grim Mirefeu dans les Tarides.‡把锻造好的钢锭带给贫瘠之地的索恩格瑞姆·火眼。‡把鍛造好的鋼錠帶給貧瘠之地的索恩格瑞姆·火眼。',
  }
},
[1504] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Glifos de Evocação, evoque e subjugue um Emissário do Caos; depois, devolva os Glifos de Evocação para Gan\'rul Olho de Sangue em Orgrimmar.‡Используя знаки призыва, призовите и подчините своей воле демона Бездны. Верните знаки призыва Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mit Hilfe der Glyphen der Beschwörung einen Leerwandler, unterwerft ihn und bringt dann die Glyphen der Beschwörung zu Gan\'rul Blutauge in Orgrimmar zurück.‡소환의 문양을 사용해 보이드워커를 소환하여 굴복시킨 다음 오그리마에 있는 간룰 블러드아이에게 사용한 소환의 문양을 가지고 돌아가십시오.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser les Glyphes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Glyphes d\'invocation à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只虚空行者，然后带着召唤铭文向奥格瑞玛的甘鲁尔·血眼回报。‡召喚並征服一隻虛無行者，然後帶著召喚雕紋向奧格瑪的甘盧爾·血眼回報。',
  }
},
[1505] = {
  {
    'Veterano Uzzek‡Ветеран Уззек‡Veteran Uzzek‡노련한 우제크‡Uzzek, el veterano‡Uzzek, el veterano‡Le vétéran Uzzek‡老兵犹塞克‡老兵猶塞克',
    nil,
    'Fale com Uzzek no Posto Remoto.‡Поговорите с Уззеком на Дальней заставе.‡Sprecht mit Uzzek bei der Fernwacht.‡전초 기지에 있는 우제크과 대화하십시오.‡Habla con Uzzek en Avanzada del Puente.‡Habla con Uzzek en Avanzada del Puente.‡Parler à Uzzek au Poste de garde extérieur.‡和前沿哨所的犹塞克谈一谈。‡和前沿哨所的猶塞克談話。',
  }
},
[1506] = {
  {
    'Convocação de Gan\'rul‡Призыв от Ган\'рула‡Gan\'ruls Beschwörung‡간룰의 소환‡Las invocaciones de Gan\'rul‡Las invocaciones de Gan\'rul‡Les invocations de Gan\'rul‡甘鲁尔的召唤‡甘盧爾的召喚',
    nil,
    'Fale com Gan\'rul Olho de Sangue em Orgrimmar.‡Найдите Ган\'рула Кровавого Глаза в Оргриммаре и поговорите с ним.‡Sprecht mit Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이와 대화하십시오.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Parler à Gan\'rul Oeil-sanglant à Orgrimmar.‡去奥格瑞玛和甘鲁尔·血眼谈一谈。‡去奧格瑪和甘盧爾·血眼談話。',
  }
},
[1507] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼을 삼키는 존재‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Cazul no Antro das Sombras.‡Поговорите с Казулом в расселине Теней.‡Sprecht mit Cazul in der Kluft der Schatten.‡어둠의 틈에 있는 카줄과 대화하십시오.‡Habla con Cazul en el Circo de las Sombras.‡Habla con Cazul en el Circo de las Sombras.‡Parlez à Cazul à la Faille de l\'ombre.‡和暗影裂口的卡祖尔谈一谈。‡和暗影裂口的卡祖爾談話。',
  }
},
[1508] = {
  {
    'Cazul cego‡Слепой Казул‡Der blinde Cazul‡눈 먼 카줄‡Cazul, el ciego‡Cazul, el ciego‡Cazul l\'aveugle‡盲眼卡祖尔‡盲眼卡祖爾',
    nil,
    'Fale com Zankaja em Orgrimmar.‡Поговорите с Занкайей в Оргриммаре.‡Sprecht mit Zankaja in Orgrimmar.‡오그리마에 있는 잔카자와 대화하십시오.‡Habla con Zankaja en Orgrimmar.‡Habla con Zankaja en Orgrimmar.‡Parler à Zankaja à Orgrimmar.‡和奥格瑞玛的赞卡沙谈一谈。‡和奧格瑪的贊卡沙談話。',
  }
},
[1509] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Gazrog na Encruzilhada.‡Поговорите с Газрогом в Перекрестке.‡Sprecht mit Gazrog beim Wegekreuz.‡크로스로드에 있는 가즈록과 대화하십시오.‡Habla con Gazrog en El Cruce.‡Habla con Gazrog en El Cruce.‡Parler à Gazrog à la Croisée.‡找到十字路口的加兹罗格并和他谈一谈。‡找到十字路口的加茲羅格並和他談話。',
  }
},
[1510] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Ken\'zigla em Malaka\'jin.‡Поговорите с Кен\'зиглой в Малака\'джине.‡Sprecht mit Ken\'zigla am Malaka\'jin.‡말라카진에 있는 켄지글라와 대화하십시오.‡Habla con Ken\'zigla en Malaka\'jin.‡Habla con Ken\'zigla en Malaka\'jin.‡Parler à Ken\'zigla, au village de Malaka\'jin.‡找到玛拉卡金的肯兹格拉并和他谈一谈。‡找到瑪拉卡金的肯茲格拉並和他談話。',
  }
},
[1511] = {
  {
    'Trago do Ken\'zigla‡Зелье Кен\'зиглы‡Ken\'ziglas Trunk‡켄지글라의 술‡Jarabe de Ken\'zigla‡Jarabe de Ken\'zigla‡Breuvage de Ken\'zigla‡肯兹格拉的伤药‡肯茲格拉的傷藥',
    nil,
    'Leve o Trago do Ken\'zigla para o Bruto Logmar no Acampamento Taurajo.‡Отнесите зелье Кен\'зиглы рубаке Логмару в Лагерь Таурахо.‡Bringt Ken\'ziglas Trunk zu Grunzer Logmar im Camp Taurajo.‡타우라조 야영지에 있는 그런트 로그마르에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Apporter le Breuvage de Ken\'zigla au grunt Logmar, au Camp Taurajo.‡将肯兹格拉的伤药交给陶拉祖营地的步兵劳格玛。‡將肯茲格拉的傷藥交給陶拉祖營地的蠻兵勞格瑪。',
  }
},
[1512] = {
  {
    'Presente do amor‡Дар любви‡Die Liebesgabe‡사랑의 선물‡Un regalo de amor‡Un regalo de amor‡Le cadeau de l\'amour‡爱的礼物‡愛的禮物',
    nil,
    'Leve o Pingente Coberto de Terra para Gan\'rul Olho de Sangue em Orgrimmar.‡Отнесите подвеску, испачканную грязью, Ган\'рулу Кровавому Глазу в Оргриммар.‡Bringt den schmutzverkrusteten Anhänger zu Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이에게 진흙투성이 목걸이를 가져가야 합니다.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Rapporter le Pendentif de poussière à Gan\'rul Oeil-sanglant à Orgrimmar.‡把沾满泥土的坠饰带给奥格瑞玛的甘鲁尔-血眼。‡把沾滿泥土的墜飾帶給奧格瑪的甘盧爾·血眼。',
  }
},
[1513] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Com o Pingente de Dogran, evoque e subjugue uma Súcubo; depois, devolva o Pingente de Dogran a Gan\'rul Olho de Sangue, em Orgrimmar.‡Призовите и подчините суккуба с помощью подвески Дограна. Верните подвеску Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mit Hilfe von Dograns Anhänger einen Sukkubus, unterwerft ihn und bringt dann Dograns Anhänger zu Gan\'rul Blutauge in Orgrimmar zurück.‡도그란의 목걸이를 사용해 서큐버스를 소환하여 처치한 다음 오그리마에 있는 간룰 블러드아이에게 도그란의 목걸이를 가지고 돌아가십시오.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser le Pendentif de Dogran pour invoquer et soumettre une succube, puis rapporter le Pendentif de Dogran à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只魅魔，然后将多格兰的坠饰还给奥格瑞玛的甘鲁尔·血眼。‡召喚並征服一隻魅魔，然後將多格蘭的墜飾還給奧格瑪的甘盧爾·血眼。',
  }
},
[1514] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려있는 열매는 썩어서 독성을 품게 된 것 같습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[1515] = {
  {
    'O cativeiro de Dogran‡Догран в плену‡Dograns Gefangenschaft‡포로가 된 도그란‡El cautiverio de Dogran‡El cautiverio de Dogran‡La captivité de Dogran‡多格兰之囚‡多格蘭之囚',
    nil,
    'Leve o Trago do Ken\'zigla para Dogran nos Sertões.‡Отнесите зелье Кен\'зиглы Дограну в Степях.‡Bringt Ken\'ziglas Trunk zu Dogran im Brachland.‡불모의 땅에 있는 도그란에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Apporter le Breuvage de Ken\'zigla à Dogran dans les Tarides.‡把肯兹格拉的伤药带给贫瘠之地的多格兰。‡把肯茲格拉的傷藥帶給貧瘠之地的多格蘭。',
  }
},
[1516] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    'Leve 2 Cascos de Espreitador Vil para Ranago Arauto da Terra no Vale das Provações.‡Принесите Канаге заклинателю земли 2 копыта ловцов Скверны.‡Bringt 2 Teufelspirscherhufe zu Canaga Erdenrufer im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 하급 지옥사냥개 발굽 2개를 가져가야 합니다.‡Lleva 2 pezuñas de acechador vil a Canaga Clamor de Tierra en el Valle de los Retos.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierras en el Valle de los Retos.‡Apporter 2 Sabots de traqueur corrompu à Canaga Earthcaller dans la Vallée des épreuves.‡给试炼谷的坎纳甘·地鸣带去2只地狱捕猎者的蹄子。‡',
  }
},
[1517] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Encontre a Rocha dos Espíritos e beba o Sapta da Terra.‡Найдите Священный Камень и выпейте рядом с ним сапту Земли.‡Sucht den Geisterfelsen und trinkt das Erdsapta.‡정기 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Trouver le Rocher des esprits et boire le Sapta de terre.‡找到灵魂石地，在那里喝下大地灵契。‡找到靈魂石地，在那裡喝下大地靈契。',
  }
},
[1518] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    'Leve o Quartzo Grosseiro para Ranago Arauto da Terra no Vale das Provações.‡Отнесите необработанный кварц Канаге заклинателю земли в долину Испытаний.‡Bringt den Rohquarz zu Canaga Erdenrufer im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 천연 석영을 가져가야 합니다.‡Lleva el Cuarzo en bruto a Canaga Clamor de Tierra en el Valle de los Retos.‡Lleva el cuarzo en bruto a Canaga Clamatierras en el Valle de los Retos.‡Apporter le Quartz brut à Canaga Hucheterre dans la Vallée des épreuves.‡把粗石英交给试炼谷的坎纳甘·地鸣。‡',
  }
},
[1519] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Leve 2 aplicações de Unguento de Ritual à Vidente Pena do Corvo na Aldeia Narache.‡Принесите 2 порции ритуальной мази провидице Воронье Перо в Лагерь Нараче.‡Bringt 2 Dosen Ritualsalbe zu Seherin Rabenfeder im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 의식의 물약 2개를 가져가야 합니다.‡Lleva 2 dosis de ungüento de ritual a la vidente Plumacuervo al Campamento Narache.‡Lleva 2 dosis de bálsamo ritual a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter 2 Applications de Baume rituel à la Prophétesse Plume-de-corbeau au Camp Narache.‡给纳拉其营地的鸦羽先知带回2份仪式药膏。‡給納拉其營地的鴉羽先知帶回2份儀式藥膏。',
  }
},
[1520] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Encontre a Rocha dos Kodos e beba o Sapta da Terra.‡Найдите Дольмен Кодо и выпейте сапту земли.‡Sucht den Kodofels und trinkt das Erdsapta.‡코도 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Trouver le Rocher des kodos et boire le Sapta de terre.‡找到科多石并喝下大地灵契。‡找到科多石並喝下大地靈契。',
  }
},
[1521] = {
  {
    'Clamor da Terra‡Зов земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡',
    nil,
    'Leve o Quartzo Grosseiro à Vidente Pena do Corvo na Aldeia Narache.‡Отнесите грубый кварц провидице Воронье Перо в Лагерь Нараче.‡Bringt den Rohquarz zu Seherin Rabenfeder im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 천연 석영을 가져가야 합니다.‡Lleva el cuarzo en bruto a la vidente Plumacuervo al Campamento Narache.‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter le Quartz brut à la prophétesse Plume-de-corbeau au Camp Narache.‡将粗石英带给纳拉其营地的鸦羽先知。‡',
  }
},
[1522] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1523] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1524] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Leve a Tocha da Chama Latente para Telf Joolam em Durotar.‡Отнесите факел Дремлющего Пламени Телфу Джуламу в Дуротаре.‡Bringt die Fackel der schlafenden Flamme zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 희미한 불씨의 횃불을 가져가야 합니다.‡Lleva la antorcha de la Llama durmiente a Telf Joolam a Durotar.‡Lleva la antorcha de la Llama Latente a Telf Joolam a Durotar.‡Apporter la Torche de la flamme dormante à Telf Joolam en Durotar.‡把眠炎火炬带给杜隆塔尔的泰尔夫·祖拉姆。‡把眠炎火炬帶給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1525] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Traga 1 Piche Ígneo e 1 Bornal de Reagentes para Telf Joolam em Durotar.‡Принесите 1 порцию огненной смолы и 1 мешочек с реагентами Телфу Джуламу в Дуротаре.‡Bringt 1 Feuerteerstück und 1 Reagenzienbeutel zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 불붙인 타르 1개와 시약 주머니 1개를 가져가야 합니다.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Apporter 1 Goudron de feu et 1 Bourse de réactifs à Telf Joolam en Durotar.‡找到1个火焰焦油和1个试剂袋，把它们交给杜隆塔尔的泰尔夫·祖拉姆。‡找到1個火焰焦油和1個試劑袋，把它們交給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1526] = {
  {
    'Clamor do fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡',
    nil,
    'Derrote a Manifestação Menor do Fogo e coloque a Brasa Faiscante no braseiro do Altar da Chama Eterna.‡Сразитесь с низшим воплощением огня и поместите светящийся уголек в жаровню в святилище Неугасимого Пламени.‡Besiegt die schwache Feuermanifestation und legt Glut in die Kohlenpfanne auf dem Schrein der ewigen Flamme.‡하급 불의 현신을 물리친 다음 희미한 불꽃의 화로에 타오르는 불꽃을 넣어야 합니다.‡Derrota a la Manifestación de fuego menor y coloca las ascuas resplandecientes sobre el altar de la llama eterna.‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Vaincre la Manifestation de feu mineure, et placer sa Braise rougeoyante dans le brasero, en haut de l\'Autel de la flamme éternelle.‡击败火焰之魂，将余烬放在恒焰圣殿屋顶的火盆里。‡',
  }
},
[1527] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡',
    nil,
    'Leve a Tocha da Chama Eterna a Kranal Fiss nos Sertões.‡Принесите факел Неугасимого Пламени Краналу Фиссу в Степи.‡Bringt die Fackel der ewigen Flamme zu Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스에게 영원한 불꽃의 횃불을 가져가야 합니다.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Apporter la Torche de la flamme éternelle à Kranal Fiss dans les Tarides.‡将恒焰火炬交给贫瘠之地的卡纳尔·菲斯。‡',
  }
},
[1528] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1529] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1530] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    'Encontre Salma nos Sertões Meridionais.‡Отыщите Брин в южной части Степей.‡Sucht Brine im südlichen Brachland.‡불모의 땅 남쪽에 있는 브린을 찾아야 합니다.‡Encuentra a Salmuera en los Baldíos del Sur.‡Encuentra a Salmuera en la Loma Espina Negra, en Los Baldíos del Sur.‡Trouver Brine dans les Tarides du sud.‡到南贫瘠之地去找到布瑞恩。‡',
  }
},
[1531] = {
  {
    'Clamor do ar‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Nubevidente en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·雲眼。',
  }
},
[1532] = {
  {
    'Clamor do ar‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Nubevidente en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·雲眼。',
  }
},
[1534] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Azul Vazio nas Ruínas de Poeira Estelar, que fica no Vale Gris, e devolva-o para Salma nos Sertões.‡Наполните пустой синий бурдюк для воды в руинах Звездной Пыли и отнесите воду Брин из Степей.‡Füllt den leeren blauen Wasserschlauch bei den Sternenstaubruinen im Eschental und kehrt zu Brine im Brachland zurück.‡잿빛 골짜기에 있는 별가루의 폐허에서 빈 파란색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre bleue vide aux Ruines de Chimétoile à Ashenvale et la rapporter à Brine dans les Tarides.‡到灰谷的星尘废墟去，将空的蓝色水囊盛满泉水，然后把它交给贫瘠之地的布瑞恩。‡到梣谷的星辰廢墟去，將空的藍色水囊盛滿泉水，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1535] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    'Encha o Odre Marrom Vazio no laguinho abaixo da cabana de Salma e leve para ela nos Sertões.‡Наполните пустой коричневый бурдюк для воды в источнике ниже хижины Брин и отнесите ей воду.‡Füllt den leeren braunen Wasserschlauch im Wasserloch unterhalb von Brines Hütte und kehrt damit zu Brine im Brachland zurück.‡브린의 거처 아래에 있는 물 구멍으로 가서 빈 갈색 물주머니에 물을 채우십시오. 그런 다음 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Remplir l\'Outre marron vide au trou d’eau, derrière la hutte de Brine, puis rapportez-lui la, dans les Tarides.‡到野猪人的水池去，用井中的水装满空的棕色水囊，然后把水囊交给贫瘠之地的布瑞恩。‡',
  }
},
[1536] = {
  {
    'O clamor da água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡',
    nil,
    'Encha o Odre Vermelho Vazio no poço da Serraria Tarren e entregue-o para Salma nos Sertões.‡Наполните пустой красный бурдюк для воды в Мельнице Таррен и отнесите воду Брин в Степи.‡Füllt den leeren roten Wasserschlauch am Brunnen in Tarrens Mühle und kehrt zu Brine im Brachland zurück.‡타렌 밀농장에 있는 우물에서 빈 빨간색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre rouge vide au puits de Moulin-de-Tarren et retourner voir Brine dans les Tarides.‡用塔伦米尔的井水装满空的红色水囊，然后把它交给贫瘠之地的布瑞恩。‡',
  }
},
[1558] = {
  {
    'O Dique Lapidado‡Каменная дамба‡Der Steinwerkdamm‡돌다지 댐‡Presa de las Tres Cabezas‡Presa de las Tres Cabezas‡Le barrage de Formepierre‡巨石水坝‡巨石水壩',
    nil,
    'Leve o órfão ao Dique Lapidado em Loch Modan. Vá com ele até o meio do dique para que ele possa ver por cima da cachoeira.‡Отведите сироту к Каменной дамбе у озера Лок Модан. Пусть постоит в центре дамбы и полюбуется огромным водопадом.‡Begleitet Euren Schützling zum Steinwerkdamm in Loch Modan. Geht mit ihm zur Mitte des Damms, damit er auf den riesigen Wasserfall heruntersehen kann.‡랜디스를 모단 호수에 있는 돌다지 댐에 데려다 줘야 합니다. 거대한 폭포를 볼 수 있도록 댐 중간까지 데려다 주십시오.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Conduire l\'orphelin au barrage de Formepierre au Loch Modan. Vous devez le conduire au milieu du barrage pour qu\'il puisse voir par-dessus l\'immense chute d\'eau.‡带着你看护的孤儿去洛克莫丹的巨石水坝。你应该带他去水坝的中间，然后让他俯瞰巨大的瀑布。‡帶著你看護的孤兒去洛克莫丹的巨石水壩。你應該帶他去水壩的中間，然後讓他俯瞰巨大的瀑布。',
  }
},
[1559] = {
  {
    'Receita de bomba de clarão‡Секрет изготовления световой бомбы‡Blitzstrahlbombenanleitung‡섬광탄 제조법‡Receta de bomba cegadora‡Receta de bomba cegadora‡La recette de la bombe éclairante‡闪光弹的制法‡',
    nil,
    '‡Так ты у нас инженер, да? Ну что ж, за то, что нашел для меня жемчужины, вот тебе секрет изготовления световых бомб. nnТы с ними только уж поосторожней, как бы самому не ослепнуть!‡Ihr seid also Ingenieur, hm? Als Dank für Eure Hilfe bei der Beschaffung der Perlen bekommt Ihr eine Anleitung für Blitzstrahlbomben.nnViel Glück und versucht, Euch nicht selbst zu blenden!‡오호, 당신 기술자로군? 그 진주를 찾는 걸 도와줬으니 여기 섬광탄 설계도를 주도록 하지.nn행운을 빌겠어. 장님이 안 되도록 조심하라고!‡¿Conque eres ingeniero, eh? Bueno, por tu ayuda para conseguir esas perlas, aquí tienes la receta de las bombas centelleantes.nn¡Suerte y ojito con dejarte ciego!‡‡Alors vous êtes l\'ingénieur, hein ? Bien, en contrepartie de votre aide pour ces perles, voici la recette de la bombe éclairante.nnBonne chance et tâchez de ne pas vous aveugler !‡‡',
  }
},
[1560] = {
  {
    'A missão de Tuga‡Задание Тооги‡Toogas Bitte‡길 잃은 투가‡La misión de Tooga‡La misión de Tooga‡La quête de Tooga‡图加的任务‡圖加的任務',
    nil,
    'Leve Tuga até a mulher dele, Tarta.‡Сопроводите Тоогу к его жене, Торте.‡Zeigt Tooga den Weg zurück zu seiner Frau Torta.‡투가를 아내 토르타에게 데려다 주어야 합니다.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Montrer à Tooga le chemin du retour vers sa femme, Torta.‡把图加带回到他的妻子托尔塔身边。‡把圖加帶回到他的妻子托爾塔身邊。',
  }
},
[1578] = {
  {
    'Suprimentos para o front‡Помощь фронту‡Nachschub für die Front‡전방 보급품 조달‡Abastecer al frente‡Abastecer al frente‡Rééquiper le front‡前线的补给‡前線的補給',
    nil,
    'Entregue 6 Machados de Cobre e 6 Cintos Encadeados de Cobre para Thorvald, na torre de vigia sul de Loch Modan.‡Отнесите 6 медных топоров и 6 медных плетеных поясов Торвальду в южную сторожевую башню озера Лок Модан.‡Bringt 6 Kupferäxte und 6 kupferne Kettengürtel zu Thorvald im südlichen Wachturm des Loch Modan.‡모단 호수 남쪽 방어탑에 있는 토발트에게 구리 도끼 6개와 구리 사슬 허리띠 6개를 주어야 합니다.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Apporter 6 Haches en cuivre et 6 Ceintures en anneaux de cuivre à Thorvald dans la Tour de garde méridionale du Loch Modan.‡给洛克莫丹南部警戒塔的索瓦尔德带去6把铜斧和6条铜质链甲腰带。‡給洛克莫丹南部警戒塔的索瓦爾德帶去6把銅斧和6條銅質鍊甲腰帶。',
  }
},
[1579] = {
  {
    'Deschanfradores‡Суперразъемы‡Klemmmuffen‡개퍼 잭‡Mecanismos eléctricos‡Mecanismos eléctricos‡Rouages électriques‡小齿轮‡小齒輪',
    nil,
    'Entregue 8 Deschanfradores para Xafetim Manigiro em Auberdine.‡Принесите Бацбаху Кривошипу в Аубердин 8 суперразъемов.‡Bringt 8 Klemmmuffen zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 개퍼 잭 8개를 가져가야 합니다.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Apporter 8 Rouages électriques à Wizbang Cranktoggle à Auberdine.‡收集8个小齿轮，把它们交给奥伯丁的维兹班恩·曲针。‡收集8個小齒輪，把它們交給奧伯丁的維茲班恩·曲針。',
  }
},
[1580] = {
  {
    'Eletromolas‡Электропеллеры‡Elektropeller‡전력추진기‡Los electromuelles‡Los electromuelles‡Pêche aux Electropellers‡导电器‡',
    nil,
    'Entregue 12 Eletromolas para o Xafetim Manigiro em Auberdine.‡Принесите 12 электропеллеров Бацбаху Кривошипу в Аубердин.‡Bringt 12 Elektropeller zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 전력추진기 12개를 가져가야 합니다.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Apporter 12 Electropellers à Wizbang Cranktoggle à Auberdine.‡收集12个导电器，把它们交给奥伯丁的维兹班恩·曲针。‡',
  }
},
[1581] = {
  {
    'Elixires para os Folhâminas‡Эликсиры для клана Режущего Листа‡Elixiere für die Messerblatts‡블레이드리프를 위한 비약‡Elixires para Filohoja‡Elixires para Filohoja‡Les élixirs pour les Feuillelame‡刃叶的药剂‡刃葉的藥劑',
    nil,
    'Traga 6 Elixires de Força de Leão e 2 Elixires de Defesa Menor para Syral Folhâmina, em Dolanaar.‡Доставьте 6 эликсиров Львиной силы и 2 слабых эликсира защиты Сирел Остролист в Доланаар.‡Bringt 6 Elixiere der Löwenstärke und 2 Elixiere der schwachen Verteidigung zu Syral Messerblatt in Dolanaar.‡돌라나르에 있는 시랄 블레이드리프에게 사자의 힘 비약 6개와 최하급 방어의 비약 2개를 가져가야 합니다.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Apporter 6 Elixirs de force du lion et 2 Elixirs de défense mineure à Syral Feuillelame à Dolanaar.‡给在多兰纳尔的塞拉尔·刃叶带去6瓶狮王之力药剂和2瓶初级防御药剂。‡給在多蘭納爾的塞拉爾·刃葉帶去6瓶獅王之力藥劑和2瓶初級防禦藥劑。',
  }
},
[1582] = {
  {
    'O colete brilho da lua‡Жилет лунного сияния‡Mondscheinweste‡달빛 조끼‡El jubón resplandor lunar‡El jubón resplandor lunar‡Veste de Moonglow‡月光外衣‡月光外衣',
    nil,
    'Leve 1 par de Luvas de Couro com Relevo, 5 pares de Botas de Couro com Relevo e 5 Mantos de Couro com Relevo para Lotherias, em Darnassus.‡Принесите 1 пару тисненых кожаных перчаток, 5 пар тисненых кожаных сапог и 5 тисненых кожаных плащей Лотериас в Дарнасс.‡Bringt 1 geprägten Lederhandschuh, 5 geprägte Lederstiefel und 5 geprägte Lederumhänge zu Lotherias in Darnassus.‡다르나서스에 있는 로서리아스에게 새김무늬 가죽 장갑 1개, 새김무늬 가죽 장화 5개, 새김무늬 가죽 망토 5개를 가져가야 합니다.‡Trae 1 par de guantes de cuero estampado, 5 botas de cuero estampado y 5 capas de cuero estampado para Lotherias en Darnassus.‡Trae 1 par de guantes de cuero estampados, 5 botas de cuero estampadas y 5 capas de cuero estampadas para Lotherias en Darnassus.‡Apporter 1 paire de Gants en cuir estampé, 5 paires de Bottes en cuir estampé et 5 Capes en cuir estampé à Lotherias à Darnassus.‡把1双雕花皮手套、5双雕花皮靴和5件雕花皮质披风交给达纳苏斯的洛瑟里亚斯。‡把1雙雕花皮甲手套、5雙雕花皮甲長靴和5件雕花皮甲披風交給達納蘇斯的洛瑟里亞斯。',
  }
},
[1598] = {
  {
    'Ladrão que rouba ladrão...‡Украденная книга‡Der gestohlene Foliant‡도난 당한 책‡El libro robado‡El libro robado‡Le Tome dérobé‡失窃的典籍‡失竊的典籍',
    nil,
    'Tome Poderes do Caos para Drusilla La Salle.‡Принесите книгу "Силы Бездны" Друзилле ла Салле.‡Holt "Die Macht der Leere" für Drusilla La Salle zurück.‡드루실라 라 살르를 위해 공허의 힘을 찾아 와야 합니다.‡LLeva los Poderes del vacío a Drusilla La Salle.‡Lleva los Poderes del Vacío a Drusilla La Salle.‡Retrouver la Puissance du Vide pour Drusilla La Salle.‡为杜希拉·拉萨雷找回《虚空灵能》。‡為杜希拉·拉薩雷找回《虛無靈能》。',
  }
},
[1599] = {
  {
    'Primeiros passos‡В начале славных дел‡Anfänge‡시작‡Novato‡Novato‡Les débuts‡开端‡',
    nil,
    'Leve 3 Patuás de Penas para Alamar Carranca em Sidermar.‡Добудьте 3 оберега из перьев и отнесите их Аламару Гримму в Старую Наковальню.‡Bringt 3 Federglücksbringer zu Alamar Grimm in Ambossar.‡앤빌마에 있는 알라마 그림에게 깃털 부적 3개를 가져가야 합니다.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Apporter 3 Charmes de plume à Alamar Grimm à Courbenclume.‡给安威玛尔的阿拉玛尔·格里姆带回3个羽毛咒符。‡',
  }
},
[1618] = {
  {
    'Armamentos para Cristarrubra‡Экипирование Красногорья‡Die Aufrüstung im Rotkammgebirge‡붉은마루산맥 무기 조달‡Equipar Crestagrana‡Equipar Crestagrana‡Le rééquipement des Carmines‡赤脊山的补给‡支援赤脊山',
    nil,
    'Tormus Baixaforja quer que você dê 4 Cintos Rúnicos de Cobre e 4 Malhos Pesados de Cobre para Vervo Obom, em Cristarrubra.‡Отнесите 4 рунических медных пояса и 4 тяжелых медных кувалды Вернеру Осгуду в Красногорье.‡Tormus Tiefenschmied möchte, dass Ihr 4 runenverzierte Kupfergürtel und 4 schwere Kupferschlägel zu Verner Gutmark ins Rotkammgebirge bringt.‡토르무스 딥포지가 붉은마루 산맥에 있는 베르너 오스구드에게 구리 룬문자 허리띠 4개와 무거운 구리 마울 4개를 가져다 달라고 부탁했습니다.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 grandes mazas de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 mazas grandes de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forge-profonde veut que vous apportiez 4 Ceintures runiques en cuivre et 4 Grands maillets en cuivre à Verner Bongoulot, dans les Carmines.‡托姆斯·深炉要你给赤脊山的弗纳·奥斯古带去4条铜质符文腰带和4把铜质大锤。‡托姆斯·深爐要你帶4條銅質符文腰帶和4把重銅大槌給赤脊山的弗納·奧斯古。',
  }
},
[1638] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Die Ausbildung eines Kriegers‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡L\'entraînement du guerrier‡战士的训练‡戰士的訓練',
    nil,
    'Fale com Ari Barbotina.‡Поговорите с Гарри Берлгардом.‡Sprecht mit Harry Burlwacht.‡해리 벌가드와 대화하십시오.‡Habla con Harry Burlguard.‡Habla con Harry Burlguard en Ventormenta.‡Parler à Harry Burlguard.‡和哈里·伯加德谈一谈。‡和哈里·伯加德談話。',
  }
},
[1639] = {
  {
    'Bartolino, o bebum‡Бартлби Пьянь‡Bartleby der Trunkenbold‡주정뱅이 바틀비‡Bartleby, el borracho‡Bartleby, el borracho‡Bartleby le poivrot‡醉鬼巴特莱比‡醉鬼巴托比',
    nil,
    'Fale com Bartolino.‡Поговорите с Бартлби.‡Sprecht mit Bartleby.‡바틀비와 대화하십시오.‡Habla con Bartleby.‡Habla con Bartleby.‡Parler à Bartleby.‡和巴特莱比谈一谈。‡和巴托比談話。',
  }
},
[1640] = {
  {
    'Que surra, Bartolino!‡Побить Бартлби‡Besiegt Bartleby‡바틀비와의 대결‡Vence a Bartleby‡Vence a Bartleby‡Battre Bartleby‡击败巴特莱比‡擊敗巴托比',
    nil,
    'Vença o Bartolino e converse com ele.‡Побейте Бартлби и снова поговорите с ним.‡Besiegt Bartleby und redet dann mit ihm.‡바틀비와 싸워 이긴 후 그와 대화하십시오.‡Derrota a Bartleby y habla con él.‡Golpea a Bartleby y habla con él.‡Battre Bartleby, puis lui parler.‡打败巴特莱比，然后再和他谈一谈。‡打敗巴托比，然後再和他談話。',
  }
},
[1641] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Aqui em Ventobravo, eu sou responsável por botar os paladinos na trilha da virtude maior enquanto eles se dedicam à Luz e à defesa de Azeroth do Flagelo e qualquer ameaça.nnChegou a hora de você dar o primeiro passo rumo à verdadeira virtude. Se aceitar, eu darei a você o Livro de Divindade. Por meio do estudo dele, você aprenderá sobre a Luz e sobre o que se espera de você. Se for capaz de entender o que ele ensina e tiver a força necessária, você poderá obter habilidades ainda mais poderosas.‡Здесь, в Штормграде, я – наставник паладинов. Я – тот, кто ведет их стезей добродетели к Истинному Свету, дабы они защищали Азерот от нашествия нежити и иных бедствий.nnИ для тебя пришло время сделать первый шаг на пути праведности. Если ты решишься принять этот путь, я дам тебе Фолиант Божественности. Изучая его, ты узнаешь кое-что о Свете и о том, чего от тебя ожидают. Постигнув мудрость, заключенную в этой книге, ты откроешь в себе новые, удивительные способности.‡Hier in Stormwind bin ich dafür verantwortlich, die Paladine auf den Pfad der größten Tugend zu bringen, sobald sie sich dem Weg des Lichts verschreiben und Azeroth vor der Geißel und anderen Bedrohungen verteidigen.nnDie Zeit ist gekommen, den ersten Schritt hin zu wahrer Tugend zu tun. Wenn Ihr einverstanden seid, gebe ich Euch das Buch der Offenbarung. Wenn Ihr es studiert, erfahrt Ihr etwas über das Licht und was von Euch erwartet wird. Wenn Ihr es versteht und tüchtig seid, werdet Ihr erfolgreich größere Fähigkeiten erlangen.‡‡Aquí, en Ventormenta, yo me encargo de poner en el camino de la virtud a los paladines que se consagran a la Luz y defienden Azeroth de la Plaga y otras amenazas. nnY ha llegado el momento de que tú des tus primeros pasos hacia la virtud verdadera. Si aceptas, te daré un escrito sobre divinidad. Estudiándolo, aprenderás algo sobre la Luz y sobre lo que se espera de ti. Si lo entiendes y tienes capacidad para ello, conseguirás mayores habilidades.‡‡A Stormwind, je suis chargé de guider les paladins sur le chemin de la vertu quand ils se consacrent à la Lumière et à la défense d’Azeroth contre le Fléau et autres menaces.nnLe temps est venu pour vous de faire vos premiers pas vers la véritable vertu. Si vous l\'acceptez, je vous donnerai un livre de divinité. En l\'étudiant, vous en apprendrez plus sur la Lumière, et sur ce qu\'on attend de vous. Si vous le comprenez, et en avez l’étoffe, vous réussirez à atteindre de plus hautes compétences.‡‡',
  }
},
[1642] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1643] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Procure Stephanie Turner no Distrito Comercial de Ventobravo.‡Обыщите Торговый квартал и найдите Стефани Тернер.‡Sucht im Handelsdistrikt von Sturmwind nach Stephanie Turner.‡스톰윈드의 상업 지구에서 스테파니 터너를 찾아야 합니다.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Chercher Stephanie Turner dans le Quartier commerçant de Hurlevent.‡在暴风城的贸易区找到斯蒂芬妮·特纳。‡',
  }
},
[1644] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Leve 10 pedaços de Linho para Stephanie Turner em Ventobravo.‡Принесите 10 отрезов льна в Штормград и отдайте Стефани Тернер.‡Bringt 10 Stück Leinenstoff zu Stephanie Turner in Sturmwind.‡스톰윈드에 있는 스테파니 터너에게 리넨 옷감 10개를 가져가야 합니다.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Apporter 10 morceaux d\'étoffe de lin à Stephanie Turner à Stormwind.‡给暴风城的斯蒂芬妮·特纳收集10块亚麻布。‡',
  }
},
[1645] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡El Libro de la Divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    '‡Приятно встретить тебя, Палсдубиной. Я направляю паладинов на путь высших добродетелей, когда они посвящают себя Свету и защите Азерота от Плети и прочих бед.nnПришла пора сделать первый шаг по пути истинных добродетелей. Если ты принимаешь этот путь, я дам тебе Фолиант Божественности. Изучая его, ты узнаешь кое-что о Свете и о том, что тебя ждет. Если ты это поймешь и окажешься способным учеником, то откроешь путь к великим возможностям.‡Welche Freude, Euch zu sehen, <Name>. Ich bringe die Paladine auf den Pfad der Tugend, wenn sie sich dem Weg des Lichts verschreiben und Azeroth vor der Geißel und anderen Bedrohungen beschützen.nnDie Zeit ist gekommen, den ersten Schritt hin zu wahrer Tugend zu tun. Wenn Ihr einverstanden seid, gebe ich Euch den Folianten der Offenbarung. Wenn Ihr es studiert, erfahrt Ihr etwas über das Licht und was von Euch erwartet wird. Wenn Ihr es versteht und tüchtig seid, werdet Ihr erfolgreich größere Fähigkeiten erlangen.‡‡Es un placer conocerte, <nombre>. Yo me encargo de poner en el camino de la virtud a los paladines que se consagran a la Luz y defienden Azeroth de la Plaga y otras amenazas.nnY ha llegado el momento de que tú des tus primeros pasos hacia la virtud verdadera. Si aceptas, te daré un Libro de la Divinidad. Estudiándolo, aprenderás algo sobre la Luz y sobre lo que se espera de ti. Si lo entiendes y tienes capacidad para ello, conseguirás mayores habilidades.‡‡Un plaisir de vous rencontrer, <nom>. Je suis chargée de guider les paladins sur le chemin d\'une plus grande vertu quand ils se consacrent à la Lumière et à la défense d’Azeroth.nnLe temps est venu pour vous de faire vos premiers pas vers la véritable vertu. Si vous acceptez cet engagement, je vous donnerai un livre de divinité. En l\'étudiant, vous en apprendrez plus sur la Lumière, et sur ce que l\'on attend de vous. Si vous le comprenez, et si vous en avez l’étoffe, alors vous réussirez à atteindre de plus hautes compétences.‡‡',
  }
},
[1646] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[1647] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Vasculhe o anel externo de Altaforja para João Turner.‡Найдите во внешнем круге Стальгорна Джона Тернера.‡Sucht im äußeren Ring von Eisenschmiede nach John Turner.‡아이언포지의 외곽 지역에 있는 존 터너를 찾아야 합니다.‡Busca a John Turner en el anillo exterior de Forjaz.‡Busca a John Turner en el anillo exterior de Forjaz.‡Chercher John Turner à la périphérie de Forgefer.‡在铁炉堡的外环区域找到约翰·特纳。‡',
  }
},
[1648] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Leve 10 peças de Linho para João Turner em Altaforja.‡Принесите 10 отрезов льняной ткани Джону Тернеру в Стальгорн.‡Bringt 10 Stück Leinenstoff zu John Turner in Eisenschmiede.‡아이언포지에 있는 존 터너에게 리넨 옷감 10개를 가져가 기부해야 합니다.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Apporter 10 morceaux d\'étoffe de lin à John Turner à Forgefer.‡收集10块亚麻布，把它们交给铁炉堡的约翰·特纳。‡',
  }
},
[1649] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1650] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Encontre Dafne Calmafonte no Cerro Oeste.‡Найдите Дафну Стилвелл в Западном Крае.‡Sucht Daphne Stillbrunn in Westfall.‡서부 몰락지대에 있는 대프니 스틸웰을 찾아야 합니다.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Trouver Daphne Stilwell dans la marche de l\'Ouest‡在西部荒野找到达芙妮·斯迪威尔。‡在西部荒野找到達芙妮·斯迪威爾。',
  }
},
[1651] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Proteja Dafne Calmafonte do ataque dos Défias.nnPara obter êxito, seus espíritos não podem ser despidos do lodo mortal.nnQuando você conseguir, fale novamente com Dafne Calmafonte.‡Защитите Дафну Стилвелл от нападения Братства Справедливости. Проследите, чтобы ни ее, ни ваша душа в случае смерти не покинули свои тела, иначе испытание не будет засчитано.nnПосле победы поговорите с Дафной Стилвелл.‡Verteidigt Daphne Stillbrunn vor dem Angriff der Defias.nnKeiner Eurer Geister darf aus seinen irdischen Fesseln befreit werden, wenn Ihr erfolgreich sein wollt.nnSprecht erneut mit Daphne Stillbrunn, wenn Ihr erfolgreich wart.‡데피아즈단의 공격으로부터 대프니 스틸웰을 보호하십시오.nn둘 중 하나라도 죽으면 실패하게 됩니다.nn성공한 후에 대프니 스틸웰과 다시 대화해야 합니다.‡Defiende a Daphne Fontana del ataque de los Defias.nnSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.nnCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Defiende a Daphne Fontana del ataque de los Defias.|nSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Défendez Daphne Morpuits contre les attaques des Défias.nnAucun de vous deux ne doit mourir, si vous voulez réussir la quête.nnQuand vous aurez réussi, reparlez à Daphne Morpuits.‡在迪菲亚兄弟会进攻时保护达芙妮·斯迪威尔的安全。nn如果你想成功的话，你和达芙妮都不能死在他们的剑下。‡在迪菲亞兄弟會進攻時保護達芙妮·斯迪威爾的安全。|n如果你想成功的話，你和達芙妮都不能死在他們的劍下。',
  }
},
[1652] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1653] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Fale com Jardel Calmafonte em Altaforja.‡Поговорите с Джорданом Стилвеллом в Стальгорне.‡Sprecht mit Jordan Stillbrunn in Eisenschmiede.‡아이언포지에 있는 조던 스틸웰과 대화해야 합니다.‡Habla con Jordan Fontana en Forjaz.‡Habla con Jordan Fontana en Forjaz.‡Parler à Jordan Morpuits à Forgefe‡去和铁炉堡的乔丹·斯迪威尔谈一谈。‡去和鐵爐堡的喬丹·斯迪威爾談話。',
  }
},
[1654] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Usando as Anotações do Jardel sobre Armas, encontre Madeira de Carvalho de Pedralva, o Carregamento de Minério Refinado do Bailor, o Martelo de Ferreiro de Jardel e uma Gema Kor. Depois, entregue tudo a Jardel Calmafonte em Altaforja.‡Возьмите список Джордана, добудьте немного древесины белокаменного дуба, партию очищенной руды Бэйлора, кузнечный молот Джордана и самоцвет Кора и отдайте их Джордану Стилвеллу в Стальгорне.‡Sucht mit Jordans Waffennotizen etwas Weißsteineichenholz, Bailors aufbereitete Erzlieferung, Jordans Schmiedehammer und einen Koredelstein und bringt alles zusammen zu Jordan Stillbrunn in Eisenschmiede.‡조던의 쪽지를 참고해 흰돌참나무 재목, 조던의 제련된 광석 상자, 조던의 대장장이 망치, 그리고 코르석을 찾아 아이언포지에 있는 조던 스틸웰에게 가져가야 합니다.‡Consulta los apuntes sobre armas y llévale a Jordan Fontana de Forjaz lo siquiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrería de Jordan y una gema Kor.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siguiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Utiliser les Notes sur les armes de Jordan, trouver du Bois de chêne de blanchepierre, la Cargaison de Minerai raffiné de Bailor, le Marteau de forge de Jordan et une Gemme de Kor, puis revenir voir Jordan Morpuits à Forgefer.‡按照乔丹的武器材料单上的说明去寻找一些白石橡木、精炼矿石、乔丹的铁锤和一块科尔宝石，然后回到铁炉堡去见乔丹·斯迪威尔。‡按照喬丹的武器材料單上的說明去尋找一些白石橡木、精煉礦石、喬丹的鐵錘和一塊科爾寶石，然後回到鐵爐堡去見喬丹·斯迪威爾。',
  }
},
[1655] = {
  {
    'Carregamento de minério do Bailor‡Партия руды Балора‡Bailors Erzlieferung‡조던의 광석 상자‡Envío de mena de Bailor‡Envío de mena de Bailor‡Cargaison de minerai de Bailor‡白洛尔的矿石‡',
    nil,
    'Leve o Carregamento de Minério do Jardel até Bailor Manopedra, em Loch Modan.‡Доставьте партию руды для Джордана Балору Крепкоруку к озеру Лок Модан.‡Bringt Jordans Erzlieferung zu Bailor Steinhand am Loch Modan.‡모단 호수에 있는 베일러 스톤핸드에게 조던의 광석 상자를 가져가야 합니다.‡Lleva el envío de mena de Jordan a Bailor Petramano a Loch Modan.‡Lleva el envío de Jordan a Bailor Petramano a Loch Modan.‡Apporter la Cargaison de minerai de Jordan à Bailor Main-de-pierre au Loch Modan.‡把乔丹的矿石带给洛克莫丹的白洛尔·石手。‡',
  }
},
[1656] = {
  {
    'Serviço pela metade‡Незаконченное задание‡Eine unvollendete Aufgabe‡완수하지 못한 임무‡Una tarea por terminar‡Una tarea por terminar‡Une tâche inachevée‡未完的任务‡未完的任務',
    nil,
    'Leve a Trouxa de Peles para o Estalajadeiro Kauth na Aldeia Casco Sangrento.‡Отнесите сверток мехов хозяину таверны Кауту в Деревню Кровавого Копыта.‡Bringt das Bündel Felle zu Gastwirt Kauth ins Dorf der Bluthufe.‡블러드후프 마을에 있는 여관주인 카우스에게 모피 묶음을 가져가야 합니다.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Livrer le Ballot de fourrures à l\'aubergiste Kauth à Sabot-de-sang.‡将一捆毛皮带给血蹄村的旅店老板考乌斯。‡將一捆毛皮帶給血蹄村的旅店老闆考烏斯。',
  }
},
[1657] = {
  {
    'Fedor na Costa Sul‡Чем пахнет в Южнобережье‡Die Verpestung von Süderstade‡사우스쇼어에 구린내 폭탄 투하‡Apesta Costasur‡Apesta Costasur‡Empuantir Southshore‡臭气熏天的南海镇‡薰死南海鎮',
    nil,
    'Atire três Bombas Fedidas dos Renegados no coração da Costa Sul, em Eira dos Montes, e fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Бросьте три бомбы-вонючки Отрекшихся в центр Южнобережья в Хилсбраде и вернитесь к призывательнице тьмы Янке на фестиваль Плетеного человека в Тирисфальских лесах.‡Werft drei Stinkbomben der Verlassenen ins Herz von Süderstade im Hügelland und kehrt zu Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡힐스브래드에 있는 사우스쇼어 한가운데에 3개의 포세이큰 구린내 폭탄을 던진 후, 티리스팔 숲의 밀짚인형 축제가 열리는 곳에 있는 암흑의 소환사 얀카에게 돌아가야 합니다.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a Llamasombra Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lancer trois Boules puantes des Réprouvés au milieu d\'Austrivage en Hautebrande, puis revenez voir la sombre imploratrice Yanka à la Fête de l\'homme d\'osier, aux Clairières de Tirisfal.‡将三颗亡灵臭气弹放置在希尔斯布莱德丘陵的南海镇中心，完成任务之后回到提瑞斯法林地的黑暗召唤者雅恩卡那里。‡在希爾斯布萊德的南海鎮中心投擲三顆被遺忘者臭彈，然後回去找在提里斯法林地的稻草人節的黑暗召喚者雅恩卡。',
  }
},
[1658] = {
  {
    'Penetra no Festival do Homem de Palha‡Сорвать праздник Плетеного человека‡Bespitzelt das Fest des Weidenmanns‡밀짚인형 축제 정탐‡Arruinar el Festival del Hombre de Mimbre‡Arruinar el Festival del Hombre de Mimbre‡Un intrus à la Fête de l\'homme d\'osier‡稻草人的节日‡破壞稻草人節',
    nil,
    'Localize o Festival do Homem de Palha nas Clareiras de Tirisfal. Depois, fale novamente com o Sargento Hartman na Costa Sul.‡Отыщите место проведения фестиваля Плетеного человека в Тирисфальских лугах и возвращайтесь в Южнобережье к сержанту Хартману.‡Macht das Fest des Weidenmanns der Verlassenen in Tirisfal ausfindig. Kehrt zu Unteroffizier Hartman in Süderstade zurück, sobald Ihr Eure Mission erfüllt habt.‡티리스팔 숲에서 포세이큰의 밀짚인형 축제가 열리고 있는 곳을 찾아 정탐한 후 사우스쇼어에 있는 하사관 허트만에게 돌아가야 합니다.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Allez voir la Fête de l\'homme d\'osier des Réprouvés dans les clairières de Tirisfal. Revenez voir le Sergent Hartman à Austrivage quand ce sera fait.‡在提瑞斯法林地找到被遗忘者的稻草人节日举办地点。任务完成之后回到南海镇的哈特曼中士那里。‡找出提里斯法林地的被遺忘者的稻草人節所在地。完成後回去向南海鎮的哈特曼中士覆命。',
  }
},
[1661] = {
  {
    'O Tomo de Nobreza‡Фолиант Благородства‡Der Foliant des Adels‡고결함의 고서‡Libro de la nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡高貴之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1665] = {
  {
    'A caneca do Bartolino‡Кружка Бартлби‡Bartlebys Becher‡바틀비의 술잔‡La jarra de Bartleby‡La jarra de Bartleby‡Tasse de Bartleby‡巴特莱比的酒杯‡巴托比的酒杯',
    nil,
    'Leve a Caneca do Bartolino para o Barbotina‡Отнесите кружку Бартлби Берлгарду.‡Bringt Bartlebys Becher zu Burlwacht.‡벌가드에게 바틀비의 술잔을 가져가야 합니다.‡Lleva la jarra de Bartleby a Burlguard.‡Lleva la jarra de Bartleby a Burlguard.‡Apporter la Tasse de Bartleby à Burlguard.‡把巴特莱比的酒杯交给伯加德。‡把巴托比的酒杯交給伯加德。',
  }
},
[1666] = {
  {
    'Delegado Fadigas‡Маршал Хаггард‡Marschall Haggard‡치안대장 해거드‡El mariscal Haggard‡El mariscal Haggard‡Le maréchal Haggard‡治安官哈迦德‡治安官哈迦德',
    nil,
    'Fale com o Delegado Fadigas.‡Поговорите с маршалом Хаггардом.‡Sprecht mit Marschall Haggard.‡치안대장 해거드와 대화하십시오.‡Habla con el mariscal Haggard.‡Habla con el mariscal Haggard.‡Parler au maréchal Haggard.‡和治安官哈迦德谈一谈。‡和治安官哈迦德談話。',
  }
},
[1667] = {
  {
    'Diogo Dente-podre‡Джек Мертвозуб‡Stumpfzahn Jack‡썩은니 잭‡Jack Dentomuerto‡Jack Dentomuerto‡Jack Dent-Morte‡蛀牙杰克‡蛀牙傑克',
    nil,
    'Recupere o Distintivo do Fadigas que está no acampamento de Diogo Dente-podre e fale novamente com o Delegado Fadigas.‡Добыть знак маршала Хаггарда из лагеря Джека Мертвозуба и вернуться к маршалу Хаггарду.‡Holt Marschall Haggards Abzeichen aus Stumpfzahn Jacks Lager und kehrt zu Marschall Haggard zurück.‡썩은니 잭의 야영지에서 치안대장 헤거드의 휘장을 찾아 치안대장 해거드에게 돌아가야 합니다.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el mariscal Haggard.‡Recupera la insignia de Haggar del campamento de Jack Dentomuerto y regresa con el mariscal Haggard.‡Retrouver la Plaque du maréchal Haggard au Camp de Jack Dent-Morte, et la rapporter au maréchal Haggard.‡从蛀牙杰克的营地里取回治安官哈迦德的徽章，把它交给治安官哈迦德。‡從蛀牙傑克的營地裡取回治安官哈迦德的徽章，把它交給治安官哈迦德。',
  }
},
[1678] = {
  {
    'Vejrek‡Веджрек‡Vejrek‡베즈렉‡Vejrek‡Vejrek‡Vejrek‡维吉雷克‡維吉雷克',
    nil,
    'Leve a Cabeça de Vejrek para Muren Lançatroz em Altaforja.‡Принесите голову Веджрека Марену Грозовой Вершине в Стальгорн.‡Bringt Vejreks Kopf zu Muren Sturmlanze in Eisenschmiede.‡베즈렉을 처치하고 그 증거로 그의 머리카락을 아이언포지에 있는 무렌 스톰파이크에게 가져가야 합니다.‡Lleva la Cabeza de Vejrek\'s a Muren Pico Tormenta en Forjaz.‡Lleva la Cabeza de Vejrek a Muren Pico Tormenta en Forjaz.‡Apporter la Tête de Vejrek à Muren Foudrepique à Forgefer.‡将维吉雷克的头颅交给铁炉堡的穆伦·雷矛。‡將維吉雷克的頭顱交給鐵爐堡的穆倫·雷矛。',
  }
},
[1679] = {
  {
    'Muren Lançatroz‡Марен Грозовая Вершина‡Muren Sturmlanze‡무렌 스톰파이크‡Muren Pico Tormenta‡Muren Pico Tormenta‡Muren Foudrepique‡穆伦·雷矛‡穆倫·雷矛',
    nil,
    'Fale com Muren Lançatroz.‡Поговорите с Мареном Грозовой Вершиной.‡Sprecht mit Muren Sturmlanze.‡무렌 스톰파이크와 대화하십시오.‡Habla con Muren Pico Tormenta.‡Habla con Muren Pico Tormenta.‡Parler à Muren Foudrepique.‡和穆伦·雷矛谈一谈。‡和穆倫·雷矛談話。',
  }
},
[1680] = {
  {
    'Tormus Baixaforja‡Тормус Подземная Кузня‡Tormus Tiefenschmied‡토르무스 딥포지‡Tormus Forjahonda‡Tormus Forjahonda‡Tormus Forge-profonde‡托姆斯·深炉‡托姆斯·深爐',
    nil,
    'Fale com Tormus Baixaforja.‡Поговорите с Тормусом Подземной Кузней.‡Sprecht mit Tormus Tiefenschmied.‡토르무스 딥포지와 대화하십시오.‡Habla con Tormus Forjahonda.‡Habla con Tormus Forjahonda.‡Parler à Tormus Forge-profonde.‡和托姆斯·深炉谈一谈。‡和托姆斯·深爐談話。',
  }
},
[1681] = {
  {
    'Complexo do Bandaferro‡Мастерская Сталекрута‡Eisenbands Truppenlager‡아이언밴드 야영지‡Complejo Vetaferro‡Complejo Vetaferro‡Base de Baguefer‡铁环营地‡鐵環營地',
    nil,
    'Leve um pouco de Minério Umbrático para Tormus Baixaforja em Altaforja.‡Принесите мрачную руду Тормусу Подземной Кузне в Стальгорн.‡Bringt eine Ladung Umbralerz zu Tormus Tiefenschmied in Eisenschmiede.‡아이언포지에 있는 토르무스 딥포지에게 움브랄 광석을 가져가야 합니다.‡Lleva un cargamento de mena umbría a Tormus Forjahonda en Forjaz.‡Lleva una pieza de mena umbría a Tormus Forjahonda en Forjaz.‡Rapporter du Minerai umbral à Tormus Forge-profonde à Forgefer.‡把暗影矿石交给铁炉堡的托姆斯·深炉。‡把陰影礦石交給鐵爐堡的托姆斯·深爐。',
  }
},
[1682] = {
  {
    'Armas de ferro cinza‡Оружие из серой стали‡Waffen aus grauem Eisen‡움브랄 광석 무기‡Armas de hierro gris‡Armas de hierro gris‡Armes en fer gris‡灰铁武器‡灰鐵武器',
    nil,
    '‡Вот тебе оружие, только что с наковальни. На него пошла добытая тобой мрачная руда!nnЧто же, Хрофтгор, выбирай!‡Hier ein paar Waffen, frisch vom Amboss und aus dem neuen Umbralerz gefertigt, das Ihr mir gebracht habt!nnBitte, <Name>, sucht Euch eine aus!‡‡Estas son algunas armas combadas sobre el yunque y hechas con el mineral umbrío que me trajiste.nn¡Por favor, <nombre>, elige lo que quieras!‡‡Voici quelques armes, tout juste sorties de la forge. Elles sont faites avec le Minerai d\'Umbral que vous m\'avez apporté !nnS\'il vous plaît, <nom>, servez-vous !‡‡',
  }
},
[1683] = {
  {
    'Vorlus Cascruel‡Ворлус Подлое Копыто‡Vorlus Elendshuf‡볼루스 바일후프‡Vorlus Pezuñavil‡Vorlus Pezuñavil‡Vorlus Vilsabot‡沃鲁斯·邪蹄‡沃魯斯·邪蹄',
    nil,
    'Leve a Trompa de Vorlus para Elanaria em Darnassus.‡Принесите рог Ворлуса Эланарии из Дарнасса.‡Bringt das Horn von Vorlus zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 볼루스의 뿔을 가져가야 합니다.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Rapporter la Corne de Vorlus Vilsabot à Elanaria à Darnassus.‡将沃鲁斯的角交给达纳苏斯的艾兰娜瑞。‡將沃魯斯的角交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1684] = {
  {
    'Elanaria‡Эланария‡Elanaria‡엘라나리아‡Elanaria‡Elanaria‡Elanaria‡艾兰娜瑞‡艾蘭娜瑞',
    nil,
    'Fale com Elanaria.‡Поговорите с Эланарией.‡Sprecht mit Elanaria.‡엘라나리아와 대화하십시오.‡Habla con Elanaria.‡Habla con Elanaria.‡Parler à Elanaria.‡和艾兰娜瑞谈一谈。‡和艾蘭娜瑞談話。',
  }
},
[1685] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고해야 합니다.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1686] = {
  {
    'O vulto de Elura‡Тень Элуры‡Eluras Schemen‡엘룰라의 유령‡La sombra de Elura‡La sombra de Elura‡L\'Ombre d\'Elura‡艾鲁拉的阴影‡艾魯拉的陰影',
    nil,
    'Leve 8 cargas de Minério de Elunita e o Medalhão de Elura para Elanaria em Darnassus.‡Принесите 8 партий элунитовой руды и медальон Элуры Эланарии из Дарнасса.‡Bringt 8 Ladungen Eluniterz und das Medaillon von Elura zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 엘루니트 광석 상자 8개와 엘루라의 메달을 가져가야 합니다.‡Lleva 8 cargamentos de mena de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Apporter 8 Caisses de minerai d\'élunite et le Médaillon d\'Elura à Elanaria à Darnassus.‡将艾鲁拉的徽章和8块月神矿石交给达纳苏斯的艾兰娜瑞。‡將艾魯拉的勳章和8塊月神礦石交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1687] = {
  {
    'Farol assombrado‡Маяк с привидениями‡Der gruselige Leuchtturm‡무서운 등대‡El faro fantasma‡El faro fantasma‡Le phare hanté‡幽灵灯塔‡',
    nil,
    'Leve o órfão ao Farol, na costa de Cerro Oeste.‡Отведите сироту к маяку на побережье Западного Края.‡Besucht mit Eurem Schützling den Leuchtturm an der Küste von Westfall.‡랜디스를 서부 몰락지대 해안에 있는 등대로 데려가야 합니다.‡Lleva al huérfano a ver el faro de la costa de los Páramos de Poniente.|n‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.‡Emmenez l\'orphelin voir le phare sur la côte de la marche de l\'Ouest.‡带着你看护的孤儿去西部荒野海岸边的灯塔。‡',
  }
},
[1688] = {
  {
    'Surena Caledon‡Сурена Каледон‡Surena Caledon‡슈레나 캘리돈‡Surena Caledon‡Surena Caledon‡Surena Caledon‡苏伦娜·凯尔东‡蘇倫娜·凱爾東',
    nil,
    'Recupere a Gargantilha de Surena e entregue-a a Gakin, o Neromante, em Ventobravo.‡Верните колье Кровавого камня Гакину Темной Вязи в Штормград.‡Beschafft Surenas Kropfband für Gakin den Dunkelbinder in Sturmwind.‡슈레나의 목걸이를 찾아 스톰윈드에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Retrouver le Foulard de Surena pour Gakin le Tisse-noir à Hurlevent.‡为暴风城的黑暗缚灵者加科因夺回苏伦娜的项圈。‡為暴風城的『黑暗縛靈師』加金奪回蘇倫娜的頸飾。',
  }
},
[1689] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    'Usando a Gargantilha de Pedra-sangrenta, evoque e sobrepuje um emissário do caos. Depois, devolva a Gargantilha de Pedra-sangrenta a Gakin, o Neromante, em Ventobravo.‡С помощью колье кровавого камня призовите и подчините демона Бездны, затем верните колье кровавого камня Гакину Темнопряду.‡Beschwört mit Hilfe des Blutsteinkropfband einen Leerwandler, unterwerft ihn und bringt dann den Blutsteinkropfband zu Gakin dem Dunkelbinder in Sturmwind zurück.‡혈석 목걸이를 사용하여 보이드워커를 소환해 제압한 후, 스톰윈드에 있는 대흑마법사 게이킨에게 혈석 목걸이를 돌려주어야 합니다.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Utiliser l\'Écharpe de pierre de sang pour invoquer et soumettre un marcheur du Vide, puis la rapporter à Gakin le Tisse-noir, à Hurlevent.‡召唤并制服一个虚空行者，然后将血石颈环还给暴风城的黑暗缚灵者加科因。‡',
  }
},
[1690] = {
  {
    'O erro dos Errantes‡Расправа над Скитальцами Пустыни‡Wüstenläufergerechtigkeit‡사막유랑단 처단‡Justicia para bandidos‡Justicia para los Vagayermos‡Châtier les Bat-le-désert‡废土的公正‡制裁廢土遊民',
    nil,
    'Elimine 10 Bandidos e Ladrões Errantes a leste de Geringontzan, depois fale novamente com o Engenheiro-chefe Silvadágua.‡Убейте 10 бандитов и 10 воров из шайки Скитальцев Пустыни на востоке от Прибамбасска и возвращайтесь к главному инженеру Чепухастеру.‡Erledigt 10 Banditen und Diebe der Wüstenläufer östlich von Gadgetzan und meldet Euch dann wieder bei Chefingenieur Bilgenritzel.‡가젯잔의 동쪽에서 10명의 사막유랑단 약탈자와 좀도둑을 처치한 후, 선임기술자 빌지위즐에게 돌아와 보고하십시오.‡Acaba con 10 bandidos y ladrones Deambuladores al este de Gadgetzan y después vuelve a ver al ingeniero jefe Silvaina.‡Acaba con 10 bandidos y ladrones Vagayermos al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Abattre 10 Bandits et 10 Larrons Bat-le-désert à l\'est de Gadgetzan, puis revenir au rapport auprès de l\'ingénieur en chef Vizisanie.‡去加基森的东面杀掉10个废土窃贼和10个废土强盗，然后向总工程师比格维兹复命。‡去加基森的東面殺掉10個廢土竊賊和10個廢土強盜，然後向首席工程師比格維茲覆命。',
  }
},
[1691] = {
  {
    'O enterro dos Errantes‡Еще одна расправа над Скитальцами Пустыни‡Noch mehr Wüstenläufergerechtigkeit‡사막유랑단 추가 처단‡Más justicia para bandidos‡Más justicia para los Vagayermos‡Continuer à châtier les Bat-le-désert‡废土的公正‡制裁更多廢土遊民',
    nil,
    'Elimine 10 Magos das Sombras Errantes, 8 Ladinos Errantes e 6 Assassinos Errantes para o Engenheiro-chefe Silvadágua em Geringontzan.‡Убейте 10 темных магов, 8 разбойников и 6 убийц из шайки Скитальцев Пустыни по поручению главного инженера Чепухастера из Прибамбасска.‡Erledigt 10 Schattenmagier der Wüstenläufer, 8 Schurken der Wüstenläufer und 6 Auftragsmörder der Wüstenläufer für Chefingenieur Bilgenritzel in Gadgetzan.‡가젯잔에 있는 선임기술자 빌지위즐을 위해 사막유랑단 도적 8명, 사막유랑단 암살자 6명, 그리고 사막유랑단 어둠마법사 10명을 처치해야 합니다.‡Acaba con 10 magos oscuros Deambuladores, 8 pícaros Deambuladores y 6 asesinos Deambuladores para el ingeniero jefe Silvaina de Gadgetzan.|n‡Acaba con 10 magos oscuros Vagayermos, 8 pícaros Vagayermos y 6 asesinos Vagayermos para el ingeniero jefe Pasaquillas de Gadgetzan.‡Tuer 10 Mages de l\'ombre Bat-le-désert, 8 Voleurs Bat-le-désert et 6 Assassins Bat-le-désert pour l\'ingénieur en chef Vizisanie à Gadgetzan.‡杀死10个废土暗法师、8个废土游荡者和6个废土刺客，然后向加基森的总工程师比格维兹报告。‡殺死10個廢土暗法師、8個廢土遊蕩者和6個廢土刺客，然後向加基森的首席工程師比格維茲報告。',
  }
},
[1692] = {
  {
    'Mathiel, o ferreiro‡Кузнец Матиль‡Schmied Mathiel‡대장장이 메시엘‡Mathiel, el herrero‡Mathiel, el herrero‡Forgeron Mathiel‡铁匠玛希尔‡',
    nil,
    'Leve o Caixote de Elunita para Mathiel, o Ferreiro.‡Отнесите сундук элунита кузнецу Матилю.‡Bringt die Kiste mit Elunit zu Schmied Mathiel.‡엘루니트 상자를 대장장이 메시엘에게 가져가야 합니다.‡Lleva la caja de elunita al herrero Mathiel.‡Lleva el estuche de elunita al herrero Mathiel.‡Apporter la Caisse d\'élunite au Forgeron Mathiel.‡把这箱月神矿石交给铁匠玛希尔。‡',
  }
},
[1693] = {
  {
    'Armas de elunita‡Оружие из элунита‡Waffen aus Elunit‡엘루니트의 무기‡Armas de Elunita‡Armas de Elunita‡Armes en Elunite‡月神武器‡',
    nil,
    '‡Это оружие я выковал из принесенного тобой элунита. Можешь взять себе любое.nnБольшое спасибо. Работать с элунитом – не только удовольствие, но и великая честь.‡<Name>, ich habe mit dem Elunit, das Ihr mir brachtet, diese Waffen hergestellt. Bitte nehmt die, die Euch am angenehmsten ist.nnUnd ich muss Euch danken. Es ist eine Ehre und Freude, mit Elunit zu arbeiten.‡‡<nombre>, he hecho estas armas con la elunita que me trajiste. Por favor, coge la que te sea más útil.nnDebo darte las gracias. Trabajar con elunita es un honor y todo un placer.‡‡<nom>, j\'ai fabriqué ces armes avec l\'Elunite que vous m’avez apportée. Prenez celle qui vous convient.nnEt je dois vous remercier. Car travailler l\'Elunite est un honneur et un plaisir.‡‡',
  }
},
[1698] = {
  {
    'Yorus Cervevada‡Йорус Ячменовар‡Yorus Gerstenbräu‡요루스 발리브루‡Yorus Cebadiz‡Yorus Cebadiz‡Yorus Barleybrew‡犹鲁斯·麦酒‡猶魯斯·麥酒',
    nil,
    'Fale com Yorus Cervevada.‡Поговорите с Йорусом Ячменоваром.‡Sprecht mit Yorus Gerstenbräu.‡요루스 발리브루와 대화하십시오.‡Habla con Yorus Cebadiz.‡Habla con Yorus Cebadiz.‡Parler à Yorus Brasselorge.‡与犹鲁斯·麦酒谈一谈。‡與猶魯斯·麥酒談話。',
  }
},
[1699] = {
  {
    'Desafio da Retibana‡Ретбанский вызов‡Der Rethbanspießrutenlauf‡레스밴 도전‡El guantelete de Rethban‡El guantelete de Rethban‡Le défi de Rethban‡往返瑞斯班洞穴‡往返瑞斯班洞穴',
    nil,
    'Entre nas Cavernas Retibanas, chegue à primeira bifurcação e volte até Yorus Cervevada no tempo estipulado.nnMorrer e libertar o espírito não é permitido.‡Войдите в пещеры Ретбана, доберитесь до первой развилки и вернитесь к Йорусу Ячменовару за отведенное время.nnВы не должны умирать и освобождать свой дух.‡Betretet die Rethbanhöhlen, geht bis zur ersten Gabelung und kehrt innerhalb der zulässigen Zeit zu Yorus Gerstenbräu zurück.nnIhr dürft nicht sterben und Euren Geist befreien.‡주어진 시간 내에 레스밴 동굴의 첫번째 분기점까지 들어갔다가 요루스 발리브루에게로 되돌아와야 합니다.nn죽어서 영혼이 빠져나가서는 안 됩니다.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.nnNo debes morir y liberar tu espíritu.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|nNo debes morir y liberar tu espíritu.‡Entrer dans les Cavernes de Rethban jusqu\'à la première fourche, et revenir voir Brasselorge dans le temps imparti.nnVous ne devez pas mourir et libérer votre esprit.‡进入瑞斯班洞穴，然后在规定的时间内回到犹鲁斯·麦酒那里。nn在整个过程中你都不能死掉或者释放灵魂，否则任务就宣告失败。‡進入瑞斯班洞穴，然後在規定的時間內回到猶魯斯·麥酒那裡。|n在整個過程中你都不能死掉或者釋放靈魂，否則任務就宣告失敗。',
  }
},
[1700] = {
  {
    'Grimand Elmore‡Гриманд Элмор‡Grimand Elmore‡그리만트 엘모어‡Grimand Elmore‡Grimand Elmore‡Grimand Elmore‡格瑞曼德·艾尔默‡格瑞曼德·艾爾默',
    nil,
    'Leve as Notas de Furen para Grimand Elmore.‡Отнесите записки Фьюрена Гриманду Элмору.‡Bringt Furens Notizen zu Grimand Elmore.‡그리만트 엘모어에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Grimand Elmore.‡Lleva las notas de Furen a Grimand Elmore.‡Porter les Notes de Furen à Grimand Elmore.‡把弗伦的笔记交给格瑞曼德·艾尔默。‡把弗倫的筆記交給格瑞曼德·艾爾默。',
  }
},
[1701] = {
  {
    'Malha endurecida a fogo‡Закаленный доспех‡Feuergehärteter Panzer‡불에 달궈 만든 갑옷‡Armadura de mallas endurecida con fuego‡Armadura de malla endurecida con fuego‡Une cotte de mailles en acier trempé‡弗伦的铠甲‡淬火鎖甲',
    nil,
    'Colete as matérias-primas pedidas por Furen Barbalonga e leve-as para ele em Ventobravo.‡Соберите все необходимые материалы для Фьюрена Длинноборода и отнесите их в Штормград.‡Sammelt die Materialien, die Furen Langbart benötigt, und bringt sie zu ihm nach Sturmwind.‡스톰윈드에 있는 푸렌 롱비어드에게 그가 필요로 하는 재료들을 모아서 가져가야 합니다.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Réunir les matériaux dont Furen Barbe-longue a besoin et lui apporter à Hurlevent.‡收集必需的材料，将它们交给暴风城的弗伦·长须。‡收集必需的材料，將它們交給暴風城的弗倫·長鬚。',
  }
},
[1702] = {
  {
    'O fabricante de escudos‡Щитник‡Der Schildschmied‡방패 상인‡El forjador de escudos‡El forjador de escudos‡Fabricant de bouclier‡铸盾师‡',
    nil,
    'Leve o Barril de Grogue para Furen Barbalonga.‡Отнесите бочонок жгучего пива Фьюрену Длиннобороду.‡Bringt das Fässlein mit Gerstenbräu zu Furen Langbart.‡푸렌 롱비어드에게 스칼더 술통을 가져가야 합니다.‡Lleva el tonel de brebaje a Furen Barbalarga.‡Lleva el barril de brebaje a Furen Barbalarga.‡Apporter la Barrique de Scalder à Furen Barbe-longue.‡将这桶热酒交给弗伦·长须。‡',
  }
},
[1703] = {
  {
    'Mathiel‡Матиль‡Mathiel‡메시엘‡Mathiel‡Mathiel‡Mathiel‡玛希尔‡',
    nil,
    'Leve as Notas de Furen para Mathiel.‡Отнесите Матилю записки Фьюрена.‡Bringt Furens Notizen zu Mathiel.‡메시엘에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Mathiel.‡Lleva las notas de Furen a Mathiel.‡Apporter les Notes de Furen à Mathiel.‡把弗伦的笔记交给玛希尔。‡',
  }
},
[1704] = {
  {
    'Cronomorfus Espanafuso‡Клацморт Гайкокрут‡Klockmort Spannersplint‡클락몰트 스패너스판‡Klockmort Palmalicate‡Klockmort Palmalicate‡Pléthorloge Cléventail‡科罗莫特·钢尺‡科羅莫特·鋼尺',
    nil,
    'Leve as Notas de Furen para Cronomorfus Espanafuso.‡Отнесите записки Фьюрена Клацморту Гайкокруту.‡Bringt Furens Notizen zu Klockmort Spannersplint.‡클락몰트 스패너스판에게 푸렌의 쪽지를 가져가야 합니다.‡Lleva las notas de Furen a Klockmort Palmalicate.‡Lleva las notas de Furen a Klockmort Palmalicate.‡Apporter les Notes de Furen à Pléthorloge Cléventail.‡把弗伦的笔记交给科罗莫特·钢尺。‡',
  }
},
[1705] = {
  {
    'Sangue Ardente‡Пылающая кровь‡Brennendes Blut‡불타는 혈액‡Sangre ardiente‡Sangre ardiente‡Le sang ardent‡燃烧之血‡燃燒之血',
    nil,
    'Leve 20 ampolas de Sangue Ardente e 1 Pedra Ardente para Grimand Elmore em Ventobravo.‡Принесите 20 сосудов горящей крови и 1 горящий камень Гриманду Элмору из Штормграда.‡Bringt 20 Phiolen brennendes Blut und 1 brennenden Fels zu Grimand Elmore in Sturmwind.‡스톰윈드에 있는 그리만트 엘모어에게 불타는 혈액 20개와 불타는 보석 1개를 가져가야 합니다.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Lleva 20 viales de sangre ardiente y 1 roca ardiente a Grimand Elmore en Ventormenta.‡Rapporter 20 Fioles de sang ardent et 1 Roc ardent à Grimand Elmore à Hurlevent.‡把20瓶燃烧之血和1块燃烧之石交给暴风城的格瑞曼德·艾尔默。‡把20瓶燃燒之血和1塊燃燒之石交給暴風城的格瑞曼德·艾爾默。',
  }
},
[1706] = {
  {
    'Armadura de Grimand‡Доспехи Гриманда‡Grimands Rüstung‡그리먼트의 갑옷‡La armadura de Grimand‡La armadura de Grimand‡L\'armure de Grimand‡格瑞曼德的铠甲‡格瑞曼德的鎧甲',
    nil,
    '‡Глазам своим не верю! Технология Фьюрена оказалась удачной, и этот доспех способен выдержать серьезную нагрузку.nnДержи, Ишт. И огромное тебе спасибо. Если бы ты не принес мне все необходимые материалы, я бы так и не поверил в открытие Фьюрина.‡Ich kann es kaum glauben! Furens Technik war ein Erfolg. Seine Rüstung sollte ungeheuren Belastungen standhalten können.nnDa habt Ihr sie, <Name>. Und habt Dank. Ich hätte nicht an Furens Entdeckung geglaubt, wenn Ihr nicht die Materialien gesammelt hättet, die ich für einen Test brauchte.‡‡‡‡Je peux à peine le croire ! La technique de Furen fonctionne, et cette armure peut résister à des coups incroyables.nnVoilà pour vous, <nom>. Et merci. Je n\'y aurais pas cru si vous ne m\'aviez pas apporté les éléments nécessaires pour le tester moi-même.‡‡',
  }
},
[1707] = {
  {
    'Bolsas de água pra refrescar‡Награда за воду‡Wasserbeutelkopfgeld‡물주머니 현상금‡Cazador de faltriqueras de agua‡Cazador de faltriqueras de agua‡Prime de la poche à eau‡收集水袋‡收集水袋',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Operador de Torneira Rastamala em Geringontzan.‡Принесите 5 бурдюков Скитальцев Пустыни оператору крана Тормозиллеру в Прибамбасск.‡Bringt Leitungshahnmaschinist Lochbeutel in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 양수기기사 루글룬켓에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 faltriqueras de agua de Deambulador al grifoperador Luglunket, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al grifoperador Llantalunket, que está en Gadgetzan.‡Apporter 5 Outres de Bat-le-désert à l\'Opérateur du robinet Trimballot à Gadgetzan.‡收集5只废土水袋，把它们交给加基森的鲁格伦克。‡收集5個廢土水袋，把它們交給加基森的魯葛蘭克。',
  }
},
[1708] = {
  {
    'Coral de Ferro‡Железный коралл‡Eisenkoralle‡철산호‡Coral férreo‡Coral férreo‡Le corail de fer‡铁珊瑚‡鐵珊瑚',
    nil,
    'Leve 20 peças de Coral Causticante para Cronomorfus Espanafuso em Altaforja.‡Принесите 20 партий выжженного коралла Клацморту Гайкокруту в Стальгорн.‡Bringt 20 Ladungen Sengkoralle zu Klockmort Spannersplint in Eisenschmiede.‡아이언포지에 있는 클락몰트 스패너스판에게 철산호 20개를 가져가야 합니다.‡Lleva 20 piezas de coral abrasador a Klockmort Palmalicate en Forjaz.‡Lleva 20 piezas de coral férreo a Klockmort Palmalicate en Forjaz.‡Apporter 20 Coraux torrides à Pléthorloge Cléventail à Forgefer.‡收集20块灼热珊瑚，把它们交给铁炉堡的科罗莫特·钢尺。‡收集20塊灼熱珊瑚，把它們交給鐵爐堡的科羅莫特·鋼尺。',
  }
},
[1709] = {
  {
    'Criação do Cronomorfus‡Творение Клацморта‡Klockmorts Kreation‡클락몰트의 창작품‡La creación de Klockmort‡La creación de Klockmort‡La création de Pléthorloge‡科罗莫特的成果‡科羅莫特的成果',
    nil,
    '‡Вот твои доспехи, Бронетазик. Идея Фьюрена отлично сработала. Идеально! Чудесно, если правду сказать!nnПо этой броне можно осадные орудия прокатить, и она сохранит форму!‡Hier ist Eure Rüstung, <Name>. Furens Prozess hat ausgezeichnet funktioniert! Perfekt! Wunderbar, ehrlich!nnMan könnte mit einer Belagerungsmaschine über diese Rüstung fahren und sie würde wieder ihre alte Form annehmen!‡‡‡‡Voilà votre armure, <nom>. Le procédé de Furen fonctionne à la perfection ! À la perfection ! Merveilleux, vraiment !nnVous pourriez rouler sur cette armure avec un engin de siège, elle reprendrait sa forme en un instant !‡‡',
  }
},
[1710] = {
  {
    'Cascas queimadas de sol‡Высохшая скорлупа‡Sonnenverbrannte Schalen‡바짝 마른 알껍질‡Cáscaras asoladas‡Cáscaras asoladas‡Coquilles desséchées au soleil‡晒焦的蛋壳‡',
    nil,
    'Leve 20 Cascas Queimadas de Sol para Mathiel em Darnassus.‡Принесите 20 кусков высохшей на солнце скорлупы Матилю из Дарнасса.‡Bringt 20 sonnenverbrannte Schalen zu Mathiel in Darnassus.‡다르나서스에 있는 메시엘에게 바짝 마른 알껍질 20개를 가져가야 합니다.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Apporter 20 Coquilles desséchées au soleil à Mathiel à Darnassus.‡把20个晒焦的蛋壳交给达纳苏斯的玛希尔。‡',
  }
},
[1711] = {
  {
    'A armadura de Mathiel‡Доспехи Матиля‡Mathiels Rüstung‡메시엘의 방어구‡La armadura de Mathiel‡La armadura de Mathiel‡L\'armure de Mathiel‡玛希尔的铠甲‡',
    nil,
    '‡‡Ich habe Eure Rüstung vollendet und bin recht zufrieden. Furens neue Techniken passen ausgezeichnet zu meinen. Ich bin sicher, diese Rüstung wird sehr widerstandsfähig sein.nnDanke, <Name>. Möge sie Euch in künftigen Kämpfen nützlich sein.‡‡‡‡J\'ai fini votre armure, et j\'en suis satisfait. Les techniques de Furen cadrent parfaitement avec les miennes et je suis sûr que cette armure est extrêmement résistante.nnMerci, <nom>. Et qu\'elle vous serve pour vos combats futurs !‡‡',
  }
},
[1712] = {
  {
    'Ciclonium‡Циклониан‡Cyclonian‡사이클로니안‡Ciclonio‡Ciclonio‡Cyclonien‡塞克隆尼亚‡塞克隆尼亞',
    nil,
    'Leve os itens listados no Pergaminho de Bath\'rah para Bath\'rah, o Vigia dos Ventos, em Alterac.‡Принесите Бат\'ра Ветростражу все предметы из его списка.‡Bringt die Gegenstände auf Bath\'rahs Pergament zu Bath\'rah dem Windbehüter in Alterac.‡알터랙에 있는 바람의감시자 바스라에게 바스라의 양피지에 적혀 있는 물건들을 가져가야 합니다.‡Lleva los objetos sobre el papiro de Bath\'rah a Bath\'rah el Vigía del viento en Alterac.‡Lleva los objetos sobre el papiro de Bath\'rah a Bath\'rah el Vigía del viento en Alterac.‡Apporter les objets du Parchemin de Bath\'rah à Bath\'rah la Vigie des vents à Alterac.‡把巴斯拉的羊皮纸上列出的东西交给奥特兰克的捕风者巴斯拉。‡把巴斯拉的羊皮紙上列出的東西交給奧特蘭克的『觀風者』巴斯拉。',
  }
},
[1713] = {
  {
    'A evocação‡Призыв‡Die Beschwörung‡소환‡La invocación‡La invocación‡L\'invocation‡召唤‡召喚',
    nil,
    'Leve o Coração Rodopiante para Bath\'rah, o Vigia dos Ventos.‡Отнести сердце Вихря Бат-ра Ветростражу.‡Bringt das Wirbelherz zu Bath\'rah dem Windbehüter.‡바람의감시자 바스라에게 소용돌이의 눈을 가져가야 합니다.‡Lleva el corazón de espirálico a Bath\'rah el Vigía del viento.‡Lleva el corazón de espirálico a Bath\'rah el Vigía del viento.‡Rapporter le Cœur de tourbillon à Bath\'rah la Vigie des vents.‡将旋风之心带给捕风者巴斯拉。‡將旋風之心帶給捕風者巴斯拉。',
  }
},
[1714] = {
  {
    'Essência dos exilados‡Субстанция Изгнанников‡Essenz der Verbannung‡떠도는 정령의 정수‡Esencia del exilio‡Esencia del exilio‡Essence d\'exil‡流放精华‡流放精華',
    nil,
    'O caldeirão borbulha. Os vapores chamam...‡Котел бурлит, и его пары так и манят...‡Der Kessel blubbert. Seine Dämpfe locken...‡가마솥이 끓고 증기가 하늘거립니다...‡La caldera burbujea. Los vapores se elevan como una señal...‡‡Le chaudron bouillonne. Ces vapeurs attirent...‡‡',
  }
},
[1715] = {
  {
    'O Cordeiro Imolado‡Таверна "Забитый ягненок"‡Zum Geschlachteten Lamm‡어둠의 희생양‡El Cordero Degollado‡El Cordero Degollado‡L\'Agneau assassiné‡已宰的羔羊‡已宰的羔羊',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고하십시오.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1716] = {
  {
    'Devoradora de almas‡Пожирательница душ‡Verschlinger der Seelen‡영혼에 굶주린 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Takar, o Vidente, nos Sertões.‡Поговорите с Такаром Провидцем в Степях.‡Sprecht mit Takar dem Seher im Brachland.‡불모의 땅에 있는 현자 타카르와 대화하십시오.‡Habla con Takar el Vidente en Los Baldíos.‡Habla con Takar el Vidente en Los Baldíos.‡Parler à Takar le Prophète dans les Tarides.‡与贫瘠之地的先知塔卡尔交谈。‡與貧瘠之地的『先知』塔卡爾交談。',
  }
},
[1717] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고하십시오.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1718] = {
  {
    'O ilhéu‡Островитянин‡Der Inselbewohner‡섬 사람‡El isleño‡El isleño‡L\'île mortelle‡岛民‡島民',
    nil,
    'Fale com Klannoc Macleod.‡Поговорите с Кланноком Маклеодом.‡Sprecht mit Klannoc Macleod.‡클라녹 맥클라우드와 대화해야 합니다.‡Habla con Klannoc Macleod.‡Habla con Klannoc Macleod.‡Parler à Klannoc Macleod.‡和克兰诺克·马克雷德谈一谈。‡和克蘭諾克·馬克雷德談話。',
  }
},
[1719] = {
  {
    'A contenda‡Побоище‡Der Ringkampf‡격투장‡La Reyerta‡La Reyerta‡La Dispute‡格斗考验‡格鬥考驗',
    nil,
    'Mate o Grande Gui. Em seguida, fale com Klannoc Macleod na Ilha da Peleja.‡Убейте Большого Билла и поговорите с Кланноком Маклеодом на Острове Битв.‡Tötet Big Will und sprecht mit Klannoc Macleod auf dem Prügeleiland.‡싸움꾼 윌을 꺾고 격투의 섬에 있는 클라녹 맥클라우드과 대화해야 합니다.‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Mata a Will el Grande y habla con Klannoc Macleod en Isla de Batalla.‡Tuer le Grand Will et parler à Klannoc Macleod sur l\'île de la Dispute.‡杀掉比格维尔，然后向勇士岛的克兰诺克·马克雷德回复。‡殺掉比格維爾，然後向勇士島的克蘭諾克·馬克雷德回覆。',
  }
},
[1738] = {
  {
    'Palocórdio‡Сердцедрево‡Herzholz‡사랑나무‡Duramen‡Duramen‡Le cœur du bois‡同心树‡同心樹',
    nil,
    'Obtenha o Palocórdio no Vale Gris e leve-o a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Раздобудьте в Ясеневом лесу сердцедрево и принесите его Гакину Темнопряду в Квартал магов Штормграда.‡Holt das Herzholz aus dem Eschental und bringt es zu Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡잿빛 골짜기에서 사랑나무를 찾아 스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Recupera el duramen de Vallefresno y llévaselo a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Trouver le Cœur du bois en Orneval et le porter à Gakin le Tisse-noir dans le quartier des mages de Hurlevent.‡从灰谷取回同心树，把它交给暴风城法师区里的黑暗缚灵者加科因。‡',
  }
},
[1739] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡',
    nil,
    'Usando o Cerne de Palocórdio, evoque e sobrepuje uma súcubo. Em seguida, devolva o Cerne de Palocórdio a Gakin, o Neromante, no Cordeiro Imolado.‡Призовите и подчините суккуба, используя сердцевину сердцедрева, затем верните сердцевину сердцедрева Гакину Темнопряду. Он будет ждать вас в "Забитом ягненке".‡Beschwört mit Hilfe des Herzholzkerns einen Sukkubus, unterwerft ihn und bringt dann den Herzholzkern zu Gakin dem Dunkelbinder im geschlachteten Lamm zurück.‡사랑나무 줄기를 사용하여 서큐버스를 소환해 제압한 후, 어둠의 희생양 선술집에 있는 대흑마법사 게이킨에게 사랑나무 줄기를 가져가야 합니다.‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utilizando el corazón del duramen, invoca y somete a un súcubo. Después devuelve el corazón del duramen a Gakin el Presotenebra en El Cordero Degollado.‡Utiliser le Noyau du cœur du bois pour invoquer et soumettre une succube, puis rapporter le Noyau de cœur du bois à Gakin le Tisse-noir, à l\'Agneau assassiné.‡召唤并制服一个魅魔，然后将同心树之核还给已宰的羔羊旅店的黑暗缚灵者加科因。‡',
  }
},
[1740] = {
  {
    'O orbe de Soran\'ruk‡Шар Соран\'рука‡Die Kugel von Soran\'ruk‡소랜루크 수정구‡El orbe de Soran\'ruk‡El orbe de Soran\'ruk‡L\'Orbe de Soran\'ruk‡索兰鲁克宝珠‡索蘭魯克寶珠',
    nil,
    'Encontre 3 Fragmentos de Soran\'ruk e 1 Fragmento Grande de Soran\'ruk e entregue-os a Doan Karhan nos Sertões.‡Соберите 3 фрагмента Соран\'рука и 1 большой фрагмент Соран\'рука и принесите их Доану Кархану в Степи.‡Sucht 3 Fragmente von Soran\'ruk und 1 großes Fragment von Soran\'ruk und bringt sie zu Doan Karhan im Brachland.‡소랜루크 조각 3개와 큰 소랜루크 조각 1개를 찾아 불모의 땅에 있는 도안 카르한에게 가져가야 합니다.‡Encuentra 3 trozos de Soran\'ruk y 1 trozo de Soran\'ruk grande y llévaselos a Doan Karhan en Los Baldíos.‡Encuentra 3 fragmentos de Soran\'ruk y 1 fragmento grande de Soran\'ruk y llévaselos a Doan Karhan en Los Baldíos.‡Trouver 3 Fragments de Soran\'ruk et 1 Grand Fragment de Soran\'ruk et les rapporter à Doan Karhan dans les Tarides.‡找到3块索兰鲁克宝珠的碎片和1块索兰鲁克宝珠的大碎片，把它们交给贫瘠之地的杜安·卡汉。‡找到3塊索蘭魯克寶珠的碎片和1塊索蘭魯克寶珠的大碎片，把它們交給貧瘠之地的杜安·卡漢。',
  }
},
[1758] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Fale com Krom Braçoforte em Altaforja.‡Поговорите с Кромом Крепкоруком в Стальгорне.‡Sprecht mit Krom Starkarm in Eisenschmiede.‡아이언포지에 있는 크롬 스타우트암과 대화해야 합니다.‡Habla con Krom Brazorrecio en Forjaz.‡Habla con Krom Brazorrecio en Forjaz.‡Parler à Krom Rudebras à Forgefer.‡与铁炉堡的克罗姆·粗臂谈一谈。‡與鐵爐堡的克羅姆·粗臂談話。',
  }
},
[1778] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[1779] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Pegue o Símbolo da Vida e fale com Muiredon Beloforja em Altaforja.‡Возьмите знак жизни и поговорите с Майридоном Кузнебоем в Стальгорне.‡Nehmt das Symbol des Lebens und sprecht mit Muiredon Kriegshammer in Eisenschmiede.‡생명의 징표를 가지고 가서 아이언포지에 있는 뮈레돈 배틀포지와 대화하십시오.‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Coge el Símbolo de la Vida y habla con Muiredon Forjabatalla. Está en Forjaz.‡Prendre le Symbole de vie et parler à Muiredon Forgeguerre à Forgefer.‡带上生命符记，和铁炉堡的穆里顿·热炉谈一谈。‡',
  }
},
[1780] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1781] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Leve o Símbolo da Vida para Gazin Tenorm em Ventobravo.‡Отнесите знак Жизни Газину Тенорму в Штормград.‡Bringt das Symbol des Lebens zu Gazin Tenorm in Sturmwind.‡스톰윈드에 있는 가쟁 테놈에게 생명의 징표를 가져가야 합니다.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Lleva el Símbolo de la Vida a Gazin Tenorm a Ventormenta.‡Porter le Symbole de vie à Gazin Tenorm à Hurlevent.‡把生命符记带给暴风城的贾森·坦诺姆。‡',
  }
},
[1782] = {
  {
    'A armadura do Furen‡Доспехи Фьюрена‡Furens Rüstung‡푸렌의 갑옷‡La armadura de Furen‡La armadura de Furen‡L\'armure de Furen‡弗伦的铠甲‡弗倫的護甲',
    nil,
    '‡Вот твои доспехи, Ишт. Они выдержат любой удар, не будь я Фьюрен Длиннобород!nnИ спасибо большое. Я многому научился, работая с принесенными тобой материалами. Думаю, в один прекрасный день я совершу новое открытие!nnА результаты этого я отправлю другим кузнецам Альянса.nnЯ скажу им, что ты мне очень помог, может быть, они тоже решат отблагодарить тебя.‡Hier ist Eure Rüstung, <Name>. Sie wird dem stärksten Angriff standhalten, oder ich will nicht mehr Furen Longbeard heißen!nnUnd ich habe Euch zu danken. Ich habe bei der Arbeit mit dem Material, das Ihr mir brachtet, viel gelernt. Ich glaube, eines Tages werde ich einen weiteren Durchbruch schaffen!nnIch werde das, was ich gelernt habe, den anderen Schmieden der Allianz schicken.nnIch sage ihnen, was für eine große Hilfe Ihr wart. Vielleicht möchten sie den Gefallen erwidern.‡‡‡‡Voici votre armure, <nom>. Elle résistera au plus dur des coups ou je ne m\'appelle pas Furen Longbeard !nnEt je dois vous remercier. J\'ai beaucoup appris en travaillant les matériaux que vous m\'avez apportés. Je pense que je ferai une autre découverte capitale un de ces jours !nnJe vais transmettre ce que j\'ai appris aux autres forgerons de l\'Alliance.nnJe leur dirai que vous m\'avez été d\'une grande aide, et peut-être qu\'ils vous récompenseront.‡‡',
  }
},
[1783] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Leve o Símbolo da Vida e ressuscite Narm Faulk em Dun Morogh.‡Возьмите знак Жизни и воскресите Нарма Фолка в Дун Мороге.‡Nehmt das Symbol des Lebens und erweckt Narm Faulk in Dun Morogh wieder zum Leben.‡생명의 징표를 가져가서 던 모로에 있는 나름 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Coge el Símbolo de la Vida y resucita a Narm Faulk en Dun Morogh.‡Prendre le Symbole de vie et ressusciter Narm Faulk dans Dun Morogh.‡使用生命符记复活丹莫罗的纳姆·法奥克。‡',
  }
},
[1784] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Obtenha uma Carta de Ferro Negro com os anões Ferro Negro perto do Lago Helm e fale novamente com Muiredon Beloforja em Altaforja.‡Добудьте приказ клана Черного Железа у дворфов из клана Черного Железа возле Хельмова Ложа и вернитесь к Майридону Кузнебою в Стальгорн.‡Beschafft ein Dunkeleisenmanuskript von den Dunkeleisenzwergen beim Helmsbettsee und kehrt zu Muiredon Kriegshammer in Eisenschmiede zurück.‡투구바닥 호수 근처에 있는 검은무쇠단 드워프들에게서 검은무쇠단 문서를 빼앗아 아이언포지에 있는 뮈레돈 배틀포지에게 돌아가십시오.‡Consigue una misiva Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Consigue una misiva Hierro Negro de los enanos Hierro Negro que están cerca de Helm y luego vuelve a Forjaz y busca a Muiredon Forjabatalla.‡Récupérer un Script des nains Sombrefer près du lac du Lit d\'Helm et le rapporter à Muiredon Forgeguerre à Forgefer.‡从盔枕湖附近的黑铁矮人那里取回一份黑铁手稿，把它交给铁炉堡的穆里顿·热炉。‡',
  }
},
[1785] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[1786] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve o Símbolo da Vida e ressuscite Henze Faulk em Elwynn.‡Возьмите знак Жизни, пойдите в Элвиннский лес и воскресите Хенза Фолка.‡Nehmt das Symbol des Lebens und erweckt Henze Faulk in Elwynn wieder zum Leben.‡생명의 징표를 가져가서 엘윈에 있는 헨즈 폴크를 되살려야 합니다.‡Coge el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Coge el Símbolo de la Vida y resucita a Henze Faulk en Elwynn.‡Apporter le Symbole de vie et ressusciter Henze Faulk à Elwynn.‡把生命符记带到艾尔文森林的英烈碑去，复活亨兹·法奥克。‡把生命符記帶到艾爾文森林的英烈碑去，復活亨茲·法奧克。',
  }
},
[1787] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Obtenha uma Carta de Défias dos Teurgos Proscritos em Elwynn e fale novamente com Gazin Tenorm em Ventobravo.‡Найдите волшебников из Братства Справедливости в Элвиннском лесу, заберите у них бумаги и отнесите их Газину Тенорму в Штормград.‡Beschafft eine Schrift der Defias von den abtrünnigen Hexern der Defias in Elwynn und kehrt zu Gazin Tenorm in Sturmwind zurück.‡엘윈 숲에 있는 데피아즈단 수습마술사들에게서 데피아즈단 문서를 빼앗아 스톰윈드에 있는 가쟁 테놈에게 가져가야 합니다.‡Recupera 1 misiva Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Recupera 1 misiva Defias de los zahoríes bribones Defias de Elwynn y vuelve con Gazin Tenorm a Ventormenta.‡Retrouver un Script Défias sur les Sorciers-voleurs défias d\'Elwynn et le rapporter à Gazin Tenorm à Hurlevent.‡从石碑湖小岛上的迪菲亚巫师手中拿到迪菲亚手稿，把它交给暴风城的贾森·坦诺姆。‡',
  }
},
[1788] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[1789] = {
  {
    'O símbolo da vida‡Знак Жизни‡Das Symbol des Lebens‡생명의 징표‡El Símbolo de la Vida‡El Símbolo de la Vida‡Le Symbole de vie‡生命符记‡',
    nil,
    '‡‡Solltet Ihr es nicht schaffen, Narm zu helfen, nachdem Ihr das Symbol des Lebens benutzt habt, <Name>, dann kommt zu mir zurück und ich werde Euch ein weiteres geben.nnEs ist sowohl für meinen Ehemann als auch für mich wichtig, dass Ihr erfolgreich zurückkehrt. Bitte sputet Euch.‡‡‡‡‡‡',
  }
},
[1790] = {
  {
    'O símbolo da vida‡Знак Жизни‡Das Symbol des Lebens‡생명의 징표‡El Símbolo de la Vida‡El Símbolo de la Vida‡Le Symbole de vie‡生命符记‡生命符記',
    nil,
    '‡Поспеши, Болвар! Слишком много жизней зависит от твоего успеха или неудачи.nnЕсли ты не сумеешь помочь Газину и Хензу, возвращайся: я дам тебе новый знак Жизни.nnНе думай, что я помогаю тебе просто так, нет: тебе, как и всякому другому паладину, нужно доказать, что ты достоин своего звания. Постоянные неудачи – не лучшая рекомендация...‡Sputet Euch, <Name>, mehr als ein Leben steht auf dem Spiel, wenn Ihr scheitert.nnWenn Ihr Gazin und Henze aus irgendeinem Grund nicht helfen könnt, dann kommt zu mir zurück und ich gebe Euch ein weiteres Symbol des Lebens für Eure Reisen.nnVersteht meine Unterstützung nicht als reine Wohltätigkeit. Ihr müsst Euch wie jeder andere <Klasse> beweisen, und wenn Ihr ständig scheitert, fällt das später auf Euch zurück.‡‡‡‡Hâtez-vous, <nom>, de nombreuses vies seront en danger si vous échouez.nnSi pour une raison quelconque vous n\'arrivez pas à aider Gazin et Henze, revenez me voir et je vous donnerai un autre Symbole de vie pour cette entreprise.nnNe prenez pas cela pour de la charité : vous devez prouver que vous êtes un <classe> aussi brave que les autres, et des échecs répétés auraient des répercussions plus tard.‡‡',
  }
},
[1791] = {
  {
    'O vigia dos ventos‡Ветростраж‡Der Windbehüter‡바람의감시자‡El Vigía del viento‡El Vigía del viento‡La Vigie des vents‡捕风者‡捕風者',
    nil,
    'Fale com Bath\'rah, o Vigia dos Ventos.‡Поговорите с Бат\'ра Ветростражем.‡Sprecht mit Bath\'rah dem Windbehüter.‡바람의감시자 바스라와 대화하십시오.‡Habla con Bath\'rah el Vigía del viento.‡Habla con Bath\'rah el Vigía del viento.‡Parler à Bath\'rah la Vigie des vents.‡和捕风者巴斯拉谈一谈。‡和『觀風者』巴斯拉談話。',
  }
},
[1792] = {
  {
    'Arma do redemoinho‡Оружие Смерча‡Wirbelwaffe‡소용돌이 무기‡Arma torbellino‡Arma torbellino‡Arme Tourbillon‡旋风武器‡',
    nil,
    'Tenho o coração rodopiante e estou pronto para colocá-lo no receptáculo à sua escolha.nnEscolha sua arma, <name>, e saiba que seu poder é o poder de Ciclonium.‡У меня есть сердце Вихря, и я могу подобрать ему вместилище по твоему выбору.nnВозьми любое оружие, и знай, что его сила – сила Циклониана.‡Ich habe das Wirbelherz und bin bereit, es in ein Gefäß Eurer Wahl zu legen.nnWählt eine Waffe, <Name>, und wisset, dass ihre Macht die Macht des Cyclonian ist.‡소용돌이의 눈도 있고 이제 자네가 선택할 무기에 그 힘을 불어넣을 준비가 되었네.nn자, 고르게나. 이 힘은 사이클로니안의 힘일세.‡Tengo el corazón de torbellino y ya puedo colocarlo en el recipiente que elijas. nnElige tu arma, <nombre>, y no olvides que su poder será el poder del Ciclonio.‡‡J\'ai le Cœur de tourbillon, et je suis prêt à le placer dans le réceptacle de votre choix.nnChoisissez l\'arme, <nom>, et sachez que ce pouvoir est le pouvoir du Cyclonien.‡‡',
  }
},
[1793] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Já está comprovado que a Luz é convosco, <name>. Contudo, conforme nosso tempo se torna mais e mais perigoso, torna-se importante conhecer a força que jaz sob a carne. Quando demônios, dragões ou qualquer outro mal puser os pés em nossas terras, seu estofo será testado. Mas será que você terá a força necessária?nnA bravura independentemente da situação é parte do que significa ser um <class>, tanto quanto a Luz, sua armadura ou sua arma. Proteger os fracos e não perder a fé são duas lições que você precisa aprender ao estudar aqui na Catedral da Luz.‡Теперь доказано, что ты – приверженец сил Света, Палинус, но времена наступают все более опасные, и поэтому важно знать, какая сила скрывается в твоем сердце. Когда демоны, драконы или какое другое зло ступят на нашу землю, тогда и подвергнется испытанию твой дух. Достанет ли у тебя сил?nnХрабрость в любой ситуации – такая же неотъемлемая часть сущности паладина, как Свет, доспех и оружие. Необходимость защищать слабых и не терять веры – вот еще два урока, которые ты должен усвоить, пока проходишь обучение в Соборе Света.‡Es steht fest, dass das Licht mit Euch ist, <Name>, doch da die Zeiten zunehmend gefährlicher werden, ist es wichtig zu wissen, welche Kräfte dem Fleische innewohnen. Wenn Dämonen, Großdrachen oder ein anderes Übel einen Fuß in unser Land setzen, wird Eure Tapferkeit auf die Probe gestellt. Werdet Ihr stark genug sein?nnTapferkeit in jedweder Situation gehört ebenso zu einem <Klasse> wie das Licht, seine Rüstung und seine Waffe. Die Schwachen beschützen und den Glauben nicht verlieren, sind zwei weitere Lektionen, die Ihr meistern müsst, wenn Ihr in der Kathedrale des Lichts studiert.‡‡Se ha demostrado que la Luz camina a tu lado, <nombre>, pero el peligro nos acecha cada día y es importante saber qué fuerza se esconde en el interior de cada uno. Tu temple se pondrá a prueba cuando demonios, dragones, o cualquier otro ser malvado entre en tus tierras. ¿Serás lo suficientemente fuerte?nnEl coraje, sin tener en cuenta en qué situación, es tan necesario para los paladines como la Luz, tu armadura y tu arma. Proteger a los débiles y no perder la fe, son dos lecciones más que tendrás que aprender cuando estudies en la Catedral de la Luz.‡‡Il a été prouvé que la Lumière était avec vous, <nom>, mais en ces temps de grands dangers, il est primordial de savoir quelles sont vos forces. Parce que des démons, des dragons et toutes sortes de créatures malfaisantes convoitent nos terres, votre courage sera mis à l\'épreuve. Serez-vous assez fort ?nnLa bravoure, quelle que soit la situation, est une part importante de la voie du <classe>, au même titre que la Lumière, votre armure et votre arme. Quand vous étudiez dans la cathédrale de la Lumière, les deux leçons que vous devez apprendre sont : protéger les faibles et ne jamais perdre la foi.‡‡',
  }
},
[1794] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Libro del valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    '‡Что же, теперь нет сомнений, что благодать Света пребывает с тобой, Отхилюотпорю, но чем опаснее времена, тем важнее знать, какую силу скрывает плоть. Когда на твои земли ступят демоны, драконы или иное зло, твоя доблесть подвергнется испытанию. Достанет ли тебе сил?nnНе бывает паладина без отваги в любой ситуации, как не бывает паладина без Света, доспеха и оружия. Защищай слабых, не теряй веры – вот два урока, которые тебе следует усвоить во время обучения в Соборе Света.‡Es steht fest, dass das Licht mit Euch ist, <Name>, doch da die Zeiten zunehmend gefährlicher werden, ist es wichtig zu wissen, welche Kräfte dem Fleische innewohnen. Wenn Dämonen, Großdrachen oder ein anderes Übel einen Fuß in unser Land setzen, wird Eure Tapferkeit auf die Probe gestellt. Werdet Ihr stark genug sein?nnTapferkeit in jedweder Situation gehört ebenso zu einem <Klasse> wie das Licht, seine Rüstung und seine Waffe. Die Schwachen beschützen und den Glauben nicht verlieren, sind zwei weitere Lektionen, die Ihr meistern müsst, wenn Ihr in der Kathedrale des Lichts studiert.‡‡‡‡‡‡',
  }
},
[1795] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando the Tomo do Conluio, evoque e subjugue um caçador vil, depois devolva o Tomo do Conluio a Strahad Farsan na Vila Catraca.‡Призовите и одолейте охотника скверны при помощи фолианта Заговора и верните фолиант Страхаду Фарсану из Кабестана.‡Beschwört mit Hilfe des \'Folianten der Kabale\' einen Teufelsjäger, unterwerft ihn und bringt den \'Folianten der Kabale\' zu Strahad Farsan in Ratschet zurück.‡비밀의 고서를 사용해 지옥사냥개를 소환해 제압한 다음 톱니항에 있는 스트라드 파선에게 사용한 고서를 돌려주어야 합니다.‡Mediante el libro del conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Mediante el libro del conciliábulo invoca y subyuga a un manáfago y luego devuélvele el Libro del Conciliábulo a Strahad Farsan en Trinquete.‡Utiliser le Tome de la Cabale pour invoquer et soumettre un Chasseur corrompu, puis rapporter le Tome de la Cabale à Strahad Farsan, à Cabestan.‡召唤地狱猎犬并打败它，然后把阴谋之书交给棘齿城的斯坦哈德·法尔杉。‡召喚惡魔獵犬並打敗它，然後把陰謀之書交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1796] = {
  {
    'Componentes para um Robessangre Dourado Encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Leve Vestes de Arcana para Menara Nihila nos Sertões.‡Принесите одеяния Аркана Менаре Расщепительнице Бездны в Степи.‡Bringt die Roben von Arcana zu Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더에게 아카나의 로브를 가져가야 합니다.‡Llévale las togas de Arcana a Menara Nadiz en Los Baldíos.‡Llévale las togas de Arcana a Menara Nadiz en Los Baldíos.‡Apporter une Robe d\'Arcana à Menara Taillevide, dans les Tarides.‡将奥法之袍交给贫瘠之地的梅纳拉·沃伦德。‡將秘法之袍交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[1798] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите со Страхадом Фарсаном в Степях.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parler à Strahad Farsan dans les Tarides.‡与贫瘠之地的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地的斯坦哈德·法爾杉談話。',
  }
},
[1799] = {
  {
    'Fragmentos do Orbe de Orahil‡Части шара Орахила‡Fragmente der Kugel von Orahil‡오라힐 보주의 파편‡Los trozos del orbe de Orahil‡Los trozos del orbe de Orahil‡Fragments de l\'Orbe d\'Orahil‡宝珠碎片‡寶珠碎片',
    nil,
    'Fale com os acólitos de Menara dentro da torre acima da Vila Catraca e escolha um caminho a seguir.nnDepois, leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Поговорите с послушниками Менары в башне над Кабестаном и изберите свой путь.nnПосле этого принесите Табете в Пыльную трясину сферу Подземного огня.‡Sprecht mit Menaras Akolythen im Inneren des Turms über Ratschet und wählt einen ihrer Wege, um ihm zu folgen.nnBringt danach eine Höllenkugel zu Tabetha in den Düstermarschen.‡톱니항이 내려다보이는 탑 안에 살고 있는 미네라의 조수들과 대화하고 그들이 제시하는 길 중 하나를 따라가야 합니다.nn그 후엔 지옥의 보주를 구해 먼지진흙 습지대의 타베사에게 가져가야 합니다.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.nnDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Habla con los acólitos de Menara que están en el interior de la torre que domina Trinquete y elige uno de sus caminos para seguirlo.|nDespués, llévale un orbe infernal a Tabetha en Marjal Revolcafango.‡Parler aux acolytes de Menara dans la tour qui domine Cabestan et choisir de suivre l\'une de leurs voies.nnEnsuite, apporter un Orbe infernal à Tabetha, dans le marécage d\'Âprefange.‡在棘齿城外的塔里与梅纳拉的侍僧们谈话，选择自己修行的方式。nn然后给尘泥沼泽的塔贝萨带去一颗地狱火珠。‡在棘齒城外的塔里與梅納拉的侍僧們談話，選擇自己修行的方式。|n然後給塵泥沼澤的塔貝薩帶去一顆地獄火珠。',
  }
},
[1800] = {
  {
    'Sala do Trono de Lordaeron‡Тронный зал Лордерона‡Der Thronsaal von Lordaeron‡로데론의 왕실‡Sala del Trono de Lordaeron‡Sala del Trono de Lordaeron‡La salle du trône de Lordaeron‡洛丹伦的王座‡',
    nil,
    'Leve o seu protegido para a antiga Sala do Trono de Lordaeron, que fica logo antes da entrada subterrânea para a Cidade Baixa.‡Отведите своего подопечного в старый тронный зал Лордерона, который находится как раз у входа в Подгород.‡Besucht mit Eurem Schützling den alten Thronsaal in Lordaeron. Er befindet sich kurz vor dem Abgang nach Unterstadt.‡언더시티로 내려가기 바로 전에 있는 고대 로데론의 왕실로 돌보고 있는 고아를 데리고 가야 합니다.‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.‡Lleva a tu pupilo a la antigua Sala del Trono de Lordaeron. La encontrarás justo antes de llegar al acceso a Entrañas.‡Emmenez votre protégé à la vieille salle du trône de Lordaeron, qui se trouve juste avant l\'endroit où il faut descendre pour aller à Fossoyeuse.‡带着你看护的孤儿去幽暗城电梯外的王座大厅。‡',
  }
},
[1801] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Fale com Jonas Anísio na Cidade Baixa.‡Поговорите с Джорахом Аннисоном в Подгороде.‡Sprecht mit Jorah Annison in Unterstadt.‡언더시티에 있는 조라 애니슨과 대화해야 합니다.‡Habla con Jorah Annison en Entrañas.‡Habla con Jorah Annison en Entrañas.‡Parler à Jorah Annison à Fossoyeuse.‡和幽暗城的约拉·安尼森谈一谈。‡和幽暗城的約拉·安尼森談話。',
  }
},
[1802] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Krom Braçoforte em Altaforja.‡Добудьте заплесневелый фолиант и потрепанный манускрипт для Крома Крепкорука из Стальгорна.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Krom Starkarm in Eisenschmiede.‡아이언포지에 있는 크롬 스타우트암에게 곰팡이 슨 고서와 너덜너덜한 필사본을 가져가야 합니다.‡Lleva el escrito mohoso y el manuscrito andrajoso a Krom Brazorrecio a Forjaz.‡Lleva el escrito mohoso y el manuscrito maltrecho a Krom Brazorrecio a Forjaz.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Krom Rudebras à Forgefer.‡为铁炉堡的克罗姆·粗臂找回发霉的书籍和破损的手稿。‡為鐵爐堡的克羅姆·粗臂找回發黴的書籍和破損的手稿。',
  }
},
[1803] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Recupere o Tomo Mofado e o Manuscrito Rasgado para Jonas Anísio na Cidade Baixa.‡Отыщите заплесневелый фолиант и потрепанный манускрипт для Йораха Аннисона из Подгорода.‡Beschafft den schimmeligen Folianten und das zerlumpte Manuskript für Jorah Annison in Unterstadt.‡곰팡이 슨 고서와 너덜너덜한 필사본을 찾아 언더시티에 있는 조라 애니슨에게 가져가야 합니다.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Recupera el escrito mohoso y el manuscrito andrajoso para Jorah Annison de Entrañas.‡Retrouver le Tome moisi et le Manuscrit en lambeaux pour Jorah Annison à Fossoyeuse.‡给幽暗城的约拉·安尼森带回发霉的书籍和破损的手稿。‡給幽暗城的約拉·安尼森帶回發黴的書籍和破損的手稿。',
  }
},
[1804] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный фолиант и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Kanalisierungsruten zu Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el escrito reconstruido y 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apporter le Tome recomposé et 3 Bâtonnet de canalisation à Strahad Farsan à Ratchet.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1805] = {
  {
    'Tomo do Conluio‡Фолиант Заговора‡Foliant der Kabale‡비밀의 고서‡Libro del conciliábulo‡Libro del conciliábulo‡Tome de la Cabale‡阴谋之书‡陰謀之書',
    nil,
    'Leve o Tomo Reformado e 3 Bastões de Canalização para Strahad Farsan na Vila Catraca.‡Принесите восстановленный фолиант и три жезла направления Страхаду Фарсану в Кабестан.‡Bringt den rekonstruierten Folianten und 3 Ruten des Kanalisierens zu Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선에게 복원된 고서와 정신 집중의 마법봉 3개를 가져가야 합니다.‡Lleva el escrito reconstruido y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Lleva el tomo restaurado y las 3 varas de mediación a Strahad Farsan a Trinquete.‡Apporter le Tome recomposé et 3 Bâtonnets de canalisation à Strahad Farsan à Cabestan.‡将翻修过的书籍和3根导能魔棒交给棘齿城的斯坦哈德·法尔杉。‡將翻修過的書籍和3根導能魔棒交給棘齒城的斯坦哈德·法爾杉。',
  }
},
[1806] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡',
    nil,
    'Espere que Jardel Calmafonte termine de forjar uma arma para você.‡Подождите, пока Джордан Стилвелл не закончит изготовление оружия.‡Wartet, bis Jordan Stillbrunn eine Waffe für Euch geschmiedet hat.‡조던 스틸웰이 무기를 다 만들 때까지 기다려야 합니다.‡Espera mientras Jordan Fontana te forja un arma.‡Espera mientras Jordan Fontana te forja un arma.‡Attendre que Jordan Morpuits finisse de forger votre arme.‡等待乔丹·斯迪威尔为你铸造武器。‡',
  }
},
[1818] = {
  {
    'Uma conversa com Dinis‡Разговор с Диллинджером‡Gespräch mit Dillinger‡딜링거와의 대화‡Habla con Dillinger‡Habla con Dillinger‡Parler à Dillinger‡迪林格尔‡迪林格爾',
    nil,
    'Fale com o Necroguarda Dinis em Montalvo.‡Поговорите со стражем смерти Диллинджером в Брилле.‡Sprecht mit Todeswache Dillinger in Brill.‡브릴에 있는 죽음의경비병 딜링거와 대화하십시오.‡Habla con el Guardia de la Muerte Dillinger en Rémol.‡Habla con el Guardia de la Muerte Dillinger en Rémol.‡Parler au Nécrogarde Dillinger à Brill.‡和布瑞尔的亡灵卫兵迪林格尔谈一谈。‡和布瑞爾的亡靈衛兵迪林格爾談話。',
  }
},
[1819] = {
  {
    'Ulag, o Cutelo‡Улаг Колун‡Ulag der Spalter‡학살자 울라그‡Ulag, el cuchillero‡Ulag el Cuchilla‡Ulag le Fendeur‡切割者奥拉格‡『斬擊者』奧拉格',
    nil,
    'Mate Ulag, o Cutelo, depois fale com Necroguarda Dinis.‡Убейте Улага Колуна и поговорите со стражем смерти Диллинджером.‡Tötet Ulag den Spalter und sprecht dann mit Todeswache Dillinger.‡학살자 울라그를 처치한 후 죽음의경비병 딜링거와 대화하십시오.‡Mata a Ulag el Cuchillero y ve a hablar con el Guardia de la Muerte Dillinger.‡Mata a Ulag el Cuchilla y ve a hablar con el Guardia de la Muerte Dillinger.‡Tuer Ulag le Fendeur, puis parler au Nécrogarde Dillinger.‡杀死切割者奥拉格，然后和亡灵卫兵迪林格尔谈一谈。‡殺死『斬擊者』奧拉格，然後和亡靈衛兵迪林格爾談話。',
  }
},
[1820] = {
  {
    'Encontrando Eurico‡Разговор с Колманом‡Gespräch mit Coleman‡콜만과의 대화‡Habla con Coleman‡Habla con Coleman‡Parler à Coleman‡库勒曼‡庫勒曼',
    nil,
    'Fale com Eurico Palhares.‡Поговорите с Колманом Фартингом.‡Sprecht mit Coleman Heller.‡콜만 파딩과 대화하십시오.‡Habla con Coleman Lontananza.‡Habla con Coleman Farthing.‡Parler à Coleman Farthing.‡和库勒曼·法席恩谈一谈。‡和庫勒曼·法席恩談話。',
  }
},
[1821] = {
  {
    'A herança dos Agamand‡Наследие Агамондов‡Agamanderbstücke‡아가만드 가문의 가보‡Reliquias Agamand‡Reliquias Agamand‡L\'héritage des Agamand‡阿加曼德家传武器‡阿加曼德家傳武器',
    nil,
    'Leve para Eurico Palhares o Machado da Família Agamand, a Espada da Família Agamand, a Maça da Família Agamand e a adaga da Família Agamand.‡Принесите Колману Фартингу фамильный топор Агамондов, фамильный меч Агамондов, фамильную палицу Агамондов, фамильный кинжал Агамондов.‡Bringt Coleman Heller die Axt, das Schwert, den Streitkolben und den Dolch der Familie Agamand.‡콜만 파딩에게 아가만드 가문의 도끼, 아가만드 가문의 검, 아가만드 가문의 철퇴, 그리고 아가만드 가문의 단검을 가져가야 합니다.‡Lleva a Coleman Lontananza el hacha de la familia de Agamand, la espada de la familia de Agamand, la maza de la familia de Agamand y la daga de la familia de Agamand.‡Lleva a Coleman Farthing el hacha de la familia Agamand, la espada de la familia Agamand, la maza de la familia Agamand y la daga de la familia Agamand.‡Rapporter à Coleman Farthing la Hache de la famille Agamand, l\'Epée de la famille Agamand, la Masse de la famille Agamand et la Dague de la famille Agamand.‡把阿加曼德家传长剑、阿加曼德家传战斧、阿加曼德家传钉锤和阿加曼德家传匕首交给库勒曼·法席恩。‡把阿加曼德家傳長劍、阿加曼德家傳戰斧、阿加曼德家傳釘錘和阿加曼德家傳匕首交給庫勒曼·法席恩。',
  }
},
[1822] = {
  {
    'Meu ódio será sua herança‡Фамильное оружие‡Erbstückwaffe‡가보 무기‡Arma reliquia‡Arma reliquia‡Une arme en héritage‡祖传武器‡',
    nil,
    '‡Я оставлю принесенное тобой оружие на память о понесенных потерях. Впрочем, ты можешь выбрать наиболее полюбившуюся тебе вещь и оставить ее себе.nnДа послужит она тебе лучше, чем прежним проклятым владельцами.‡Ich behalte drei der Waffen, die Ihr mir gebracht habt, als Andenken an meinen Schmerz und Verlust. Aber bitte, <Name>, wählt Euer Lieblingserbstück und behaltet es für Euch.nnMöge es Euch besser dienen als seinen verfluchten vorherigen Besitzern.‡‡Conservaré tres de las armas que me has devuelto, como recuerdos de mi sufrimiento y de mi pérdida. Pero por favor, <nombre>, elige tu favorita entre las reliquias y quédatela.nnQue te sea de más ayuda que a sus antiguos y malditos propietarios.‡‡‡‡',
  }
},
[1823] = {
  {
    'Fale com Ruga‡Разговор с Ругой‡Gespräch mit Ruga‡루가와의 대화‡Habla con Ruga‡Habla con Ruga‡Parler à Ruga‡和鲁迦交谈‡和魯迦交談',
    nil,
    'Fale com Ruga Totem da Fúria.‡Поговорите с Ругой Тотемом Ярости.‡Sprecht mit Ruga Rachtotem.‡루가 레이지토템과 대화하십시오.‡Habla con Ruga Furiatótem.‡Habla con Ruga Tótem de Ira.‡Parler à Ruga Totem-de-rage.‡和鲁迦·狂暴图腾谈一谈。‡和魯迦·狂暴圖騰談話。',
  }
},
[1824] = {
  {
    'Provação no Campo dos Gigantes‡Испытание на Полях Великанов‡Prüfung auf dem Feld der Riesen‡거인의 들판에서의 시험‡Prueba en Tierra de Gigantes‡Prueba en Tierra de Gigantes‡L\'épreuve du Champ des géants‡巨人旷野的试炼‡巨人曠野的試煉',
    nil,
    'Leve 5 antenas tremelicantes para Ruga Totem da Fúria no Acampamento Taurajo‡Принесите 5 дергающихся усиков Руге Тотему Ярости в Лагерь Таурахо.‡Bringt 5 zuckende Fühler zu Ruga Rachtotem im Camp Taurajo.‡타우라조 야영지에 있는 루가 레이지토템에게 꿈틀거리는 더듬이 5개를 가져가야 합니다.‡Lleva 5 antenas agitadas a Ruga Furiatótem de Campamento Taurajo.‡Lleva 5 antenas agitadas a Ruga Tótem de Ira de Campamento Taurajo.‡Apporter 5 Antennes mobiles à Ruga Totem-de-rage au Camp Taurajo.‡收集5根颤抖的触角，把它们带给贫瘠之地陶拉祖营地的鲁迦。‡收集5根顫抖的觸角，把它們帶給貧瘠之地陶拉祖營地的魯迦。',
  }
},
[1825] = {
  {
    'Fale com Thun\'grim‡Разговор с Тун\'гримом‡Gespräch mit Thun\'grim‡툰그림과의 대화‡Habla con Thun\'grim‡Habla con Thun\'grim‡Parler à Thun\'grim‡和索恩格瑞姆交谈‡',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화하십시오.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Mirefeu dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡',
  }
},
[1838] = {
  {
    'Armadura brutal‡Доспехи Жестокости‡Brutale Rüstung‡투사의 방어구‡Armadura brutal‡Armadura brutal‡Armure de brutalité‡野蛮护甲‡野蠻護甲',
    nil,
    'Leve para Thun\'grim Olhafogo 15 Lingotes Fumegantes de Ferro, 10 Azuritas Pulverizadas, 10 Barras de Ferro e a Ampola de Flogisto.‡Принесите Тун\'гриму Огневзору 15 закопченных железных слитков, 10 мер толченого азурита, 10 железных слитков и сосуд флогистона.‡Bringt Thun\'grim Brandblick 15 rauchige Eisenblöcke, 10 pulverisierte Azurite, 10 Eisenbarren und 1 Phiole mit Phlogiston.‡툰그림 파이어게이즈에게 연기나는 철제 주괴 15개, 아주라이트 가루 10개, 철 주괴 10개, 연소 약병 1개를 가져가야 합니다.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 barras de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Lleva 15 lingotes de hierro humeantes, 10 azuritas en polvo, 10 barras de hierro y un vial de flogisto a Thun\'grim Vistafuego.‡Apporter à Thun\'grim Mirefeu 15 Lingots de Fer cendré, 10 Azurites en poudre, 10 Barres de Fer et une Fiole de Phlogiston.‡为索恩格瑞姆收集15根烟雾铁锭、10份蓝铜粉、10块铁锭和1瓶燃素。‡為索恩格瑞姆收集15根煙霧鐵錠、10份藍銅粉、10塊鐵錠和1瓶燃素。',
  }
},
[1839] = {
  {
    'Ula\'elek e as Manoplas Brutais‡Ула\'елек и рукавицы Жестокости‡Ula\'elek und die brutalen Stulpen‡울라엘레크와 투사 건틀릿‡Ula\'elek y los guanteletes brutales‡Ula\'elek y los guanteletes brutales‡Ula\'elek et les Gantelets de brutalité‡尤拉莱克和野蛮护手‡尤拉萊克和野蠻護手',
    nil,
    'Fale com Ula\'elek em Durotar.‡Поговорите с Ула\'елеком из Дуротара.‡Sprecht mit Ula\'elek in Durotar.‡듀로타에 있는 울라엘레크와 대화하십시오.‡Habla con Ula\'elek en Durotar.‡Habla con Ula\'elek en Durotar.‡Parler à Ula\'elek en Durotar.‡与杜隆塔尔的尤拉莱克谈一谈。‡與杜洛塔的尤拉萊克談話。',
  }
},
[1840] = {
  {
    'Orm Casco de Pedra e o Elmo Brutal‡Орм Каменное Копыто и шлем Жестокости‡Orm Steinhuf und der brutale Helm‡오름 스톤후프와 투사 투구‡Orm Pezuñapétrea y el yelmo brutal‡Orm Pezuña Pétrea y el yelmo brutal‡Orm Sabot-de-pierre et le Camail de brutalité‡奥姆·石蹄和野蛮头盔‡歐姆·石蹄和野蠻頭盔',
    nil,
    'Fale com Orm Casco de Pedra no Penhasco do Trovão.‡Обратитесь к Орму Каменному Копыту из Громового Утеса.‡Sprecht mit Orm Steinhuf in Donnerfels.‡썬더 블러프에서 오름 스톤후프와 대화하십시오.‡Habla con Orm Pezuñapétrea en Cima del Trueno.‡Habla con Orm Pezuña Pétrea en Cima del Trueno.‡Parler à Orm Sabot-de-pierre aux Pitons du Tonnerre.‡和雷霆崖的奥姆·石蹄谈一谈。‡和雷霆崖的歐姆·石蹄談話。',
  }
},
[1841] = {
  {
    'Velora Noitile e as Guarda-pernas Brutais‡Велора Нители и Набедренники Жестокости‡Velora Nachtens und die brutalen Beinschützer‡벨로라 나이틀리와 투사 다리보호구‡Velora Noctis y las musleras brutal‡Velora Noctis y las musleras brutal‡Velora Nitely et les Jambières de brutalité‡维罗拉·奈特雷和野蛮腿甲‡維羅拉·奈特雷和野蠻腿甲',
    nil,
    'Fale com Velora Noitile na Cidade Baixa.‡Поговорите с Велорой Нители из Подгорода.‡Sprecht in Unterstadt mit Velora Nachtens.‡언더시티에 있는 벨로라 나이틀리와 대화하십시오.‡Habla con Velora Noctis en Entrañas.‡Habla con Velora Noctis en Entrañas.‡Parler à Velora Nitely à Fossoyeuse.‡与幽暗城的维罗拉·奈特雷谈一谈。‡與幽暗城的維羅拉·奈特雷談話。',
  }
},
[1842] = {
  {
    'Cascos de Sátiro‡Копыта сатиров‡Satyrhufe‡사티로스 발굽‡Pezuñas de sátiro‡Pezuñas de sátiro‡Les sabots de satyre‡萨特之蹄‡',
    nil,
    'Leve 7 Cascos Não-fendidos de Sátiro para Ula\'elek na Aldeia Sen\'jin, em Durotar.‡Принесите 7 целых копыт сатиров Ула\'елеку в Дуротар, в деревню Сен\'джин.‡Bringt 7 ungespaltene Satyrhufe zu Ula\'elek in Sen\'jin in Durotar.‡듀로타의 센진 마을에 있는 울라엘레크에게 사티로스 통발굽 7개를 가져가야 합니다.‡Lleva 7 pezuñas de sátiro sin rajar a Ula\'elek de Poblado Sen\'jin en Durotar.‡Lleva 7 pezuñas de sátiro sin rajar a Ula\'elek de Poblado Sen\'jin en Durotar.‡Rapporter 7 Sabots fendus de satyre à Ula\'elek au village de Sen\'jin en Durotar.‡收集7只完整的萨特之蹄，把它们交给杜隆塔尔森金村的尤拉莱克。‡',
  }
},
[1843] = {
  {
    'Manoplas Brutais‡Рукавицы Жестокости‡Brutale Stulpen‡투사 건틀릿‡Guanteletes brutales‡Guanteletes brutales‡Gantelets de brutalité‡野蛮护手‡野蠻護手',
    nil,
    '‡Спасибо, Коммибро. Эти рукавицы – мое величайшее достижение. Возьми их. Ты окажешь мне честь, если пойдешь в них в бой.‡Danke, <Name>. Diese Stulpen sind meine beste Arbeit. Nehmt sie. Wenn Ihr sie tragt, bringt es mir und meinen Vorfahren Ehre.‡‡‡‡Merci, <nom>. Ces Gantelets sont ma plus belle réussite. Prenez-les. En les portant, vous nous honorerez, moi et mes ancêtres.‡‡',
  }
},
[1844] = {
  {
    'Chifre quimérico‡Рог химеры‡Schimärenhorn‡키메라의 뿔‡Cuerno de quimera‡Cuerno de quimera‡La corne de chimère‡奇美拉之角‡',
    nil,
    'Leve um Chifre Galvanizado para Orm Casco de Pedra no Penhasco do Trovão.‡Принести Орму Каменному Копыту из Громового Утеса гальванизированный рог.‡Bringt ein galvanisiertes Horn zu Orm Steinhuf in Donnerfels.‡썬더 블러프에 있는 오름 스톤후프에게 번개 뿔을 가져가야 합니다.‡Lleva un cuerno galvanizado a Orm Pezuñapétrea de Cima del Trueno.‡Lleva un cuerno galvanizado a Orm Pezuña Pétrea de Cima del Trueno.‡Apporter une Corne galvanisée à Orm Sabot-de-pierre aux Pitons du Tonnerre.‡把光滑的奇美拉角交给雷霆崖的奥姆·石蹄。‡',
  }
},
[1845] = {
  {
    'Elmo brutal‡Шлем Жестокости‡Brutaler Helm‡투사 투구‡Yelmo brutal‡Yelmo brutal‡Camail de brutalité‡野蛮头盔‡野蠻頭盔',
    nil,
    '‡Возьми этот шлем.nnТебя привели ко мне великие свершения, и если Матери-земле будет угодно... тебе предстоит немало подвигов.‡Ich gebe Euch diesen Helm.nnGroße Taten brachten Euch zu mir, <Name>, und wenn es der Erdenmutter gefällt... liegen noch größere vor Euch.‡‡Te concedo este yelmo.nnMe diste grandes gestas, <nombre>, y si la Madre Tierra quiere... aún te esperan gestas mayores.‡‡Je vous donne ce casque.nnCe sont vos actes héroïques qui vous ont conduit jusqu\'à moi, <nom>, et la volonté de notre Mère la Terre... Des actes encore plus héroïques vous attendent.‡‡',
  }
},
[1846] = {
  {
    'Tíbias de Presa do Dragão‡Берцовые кости‡Schienbeinknochen der Drachenmalorcs‡용아귀부족 다리뼈‡Tibias de Faucedraco‡Tibias de Faucedraco‡Les tibias de Dragonmaw‡龙喉胫骨‡龍喉脛骨',
    nil,
    'Leve 8 Tíbias Firmes de Presa do Dragão para Velora Noitile na Cidade Baixa.‡Принесите 8 крепких берцовых костей Драконьей Пасти Велоре Нители в Подгород.‡Bringt 8 stabile Schienbeinknochen eines Drachenmalorcs zu Velora Nachtens in Unterstadt.‡언더시티에 있는 벨로라 나이틀리에게 단단한 용아귀부족 다리뼈 8개를 가져가야 합니다.‡Lleva 8 tibias de Faucedraco robustas a Velora Noctis de Entrañas.‡Lleva 8 tibias de Faucedraco robustas a Velora Noctis de Entrañas.‡Apporter 8 Solides tibias de Gueule-de-dragon à Velora Nitely, à Fossoyeuse.‡给幽暗城的维罗拉·奈特雷带去8根结实的龙喉胫骨。‡給幽暗城的維羅拉·奈特雷帶去8根結實的龍喉脛骨。',
  }
},
[1847] = {
  {
    'Guarda-pernas Brutais‡Набедренники Жестокости‡Brutale Beinschützer‡투사 다리보호구‡Musleras brutales‡Musleras brutales‡Jambières de brutalité‡野蛮腿甲‡野蠻腿甲',
    nil,
    '‡Вот твои набедренники, Большойзмей. Ну как, подходят? Или надо что-то менять? Мне хочется угодить заказчику! По крайней мере всегда хотелось.nnТеперь ремесло утратило прежнюю прелесть. Но все лучше, чем быть безмозглым рабом Плети!nnНаверное.‡Hier sind Eure Beinschützer, <Name>. Lasst mich wissen, ob sie passen oder geändert werden müssen. Ich möchte zufriedene Kunden! Zumindest früher wollte ich das.nnHeutzutage liegt mir nicht mehr viel an meinem Handwerk. Aber immer noch besser, als eine hirnlose Dienerin der Geißel zu sein!nnDenke ich.‡‡‡‡Voici vos jambières, <nom>. Dites-moi si cela vous convient ou si vous avez besoin de modifications. J\'essaie toujours de satisfaire mon client ! Du moins j\'essayais.nnEn ce moment, je ne me soucie pas beaucoup de mon métier. Mais ça met hors jeu d\'être un stupide pion du Fléau ! nnJe suppose…‡‡',
  }
},
[1848] = {
  {
    'Cota brutal‡Хауберк Жестокости‡Brutale Halsberge‡투사 갑옷‡Camisote brutal‡Camisote brutal‡Le haubert de brutalité‡野蛮锁甲‡野蠻鍊衫',
    nil,
    '‡Тебе несомненно пришлось пролить немало крови, чтобы справиться с моим заданием, Коммибро. Вот плод твоих трудов.nnНоси с удовольствием. Как-нибудь заходи, расскажешь, как он тебе пригодился в бою.‡Ich bin sicher, Ihr habt bei dieser Aufgabe viele Unannehmlichkeiten erduldet und viel Blut vergossen, <Name>. Hier ist das Produkt Eurer Mühsal.nnMöge es Euch gute Dienste leisten und möget Ihr eines Tages wiederkommen und erzählen, wie nützlich sie Euch waren.‡‡Habrás tenido que soportar duras privaciones y habrás derramado mucha sangre cumpliendo mi tarea, <nombre>. Este es el producto de todo tu esfuerzo.nnUtilízalo bien y quizás un día vuelvas a contarme cuántas veces te ha sido de ayuda.‡‡Je sais que vous avez enduré beaucoup de privations et versé beaucoup de sang à mon service, <nom>. Voici le fruit de votre dur labeur.nnPuissiez-vous bien le porter et revenir ici un jour pour me conter les services qu\'il vous aura rendus.‡‡',
  }
},
[1858] = {
  {
    'A Mão Despedaçada‡Изувеченная Длань‡Die Zerschmetterte Hand‡으스러진 손‡Mano Destrozada‡Mano Destrozada‡La Main brisée‡碎手氏族‡',
    nil,
    'Roube a chave de Tazan e use-a para abrir a Algibeira dele, levando o conteúdo para Therzok no Antro das Sombras, em Orgrimmar.‡Украдите ключ Тазана, откройте сумку Тазана и отнесите содержимое сумки Терзоку в расселину Теней в Оргриммаре.‡Stehlt Tazans Schlüssel, öffnet seinen Ranzen damit und bringt den Inhalt zu Therzok in der Kluft der Schatten in Orgrimmar.‡타잔의 열쇠를 훔쳐 가방을 열고 그 속에 든 물건들을 오그리마의 어둠의 틈에 있는 테르조크에게 가져가야 합니다.‡Roba la llave de Tazan, abre su cartera y llévale el contenido a Therzok al Circo de las Sombras, en Orgrimmar.‡Roba la llave de Tazan, abre su cartera y llévale el contenido a Therzok al Circo de las Sombras, en Orgrimmar.‡Voler la Clé de Tazan puis l\'utiliser pour ouvrir sa Sacoche et livrer son contenu à Therzok dans la Faille de l\'ombre à Orgrimmar.‡偷来塔赞的钥匙，用它打开他的背包，然后将里面的物品交给奥格瑞玛暗影裂口的瑟祖克。‡',
  }
},
[1859] = {
  {
    'Therzok‡Терзок‡Therzok‡테르조크‡Therzok‡Therzok‡Therzok‡瑟祖克‡',
    nil,
    'Fale com Therzok no Antro das Sombras em Orgrimmar.‡Поговорите с Терзоком в расселине Теней в Оргриммаре.‡Sprecht mit Therzok in der Kluft der Schatten in Orgrimmar.‡오그리마의 어둠의 틈에 있는 테르조크와 대화하십시오.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Therzok.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Therzok.‡Aller voir Therzok dans la Faille de l\'ombre à Orgrimmar.‡到奥格瑞玛的暗影裂口和瑟祖克谈谈。‡',
  }
},
[1860] = {
  {
    'Fale com Jana‡Поговорите с Джиннией‡Gespräch mit Jennea‡제니아와의 대화‡Habla con Jennea‡Habla con Jennea‡Parler à Jennea‡和詹妮亚交谈‡',
    nil,
    'Fale com Jana Catão em Ventobravo.‡Поговорите с Джиннией Пушкой в Штормграде.‡Sprecht in Sturmwind mit Jennea Haubitz.‡스톰윈드에 있는 제니아 캐논과 대화하십시오.‡Habla con Jennea Cañón en Ventormenta.‡Habla con Jennea Cañón en Ventormenta.‡Parler à Jennea Cannon à Hurlevent.‡和暴风城的詹妮亚·坎农谈一谈。‡',
  }
},
[1861] = {
  {
    'Lago Espelhado‡Зеркальное озеро‡Spiegelsee‡거울 호수‡Lago Espejo‡Lago Espejo‡Le lac Miroir‡明镜湖‡明鏡湖',
    nil,
    'Traga uma amostra do Lago Espelhado para Jana Catão em Ventobravo.‡Отнесите пробу воды из Зеркального озера Джиннии Пушке из Штормграда.‡Bringt eine Probe des Spiegelseewassers zu Jennea Haubitz in Sturmwind.‡스톰윈드에 있는 제니아 캐논에게 거울 호수 견본을 가져가야 합니다.‡Lleva una muestra del Lago Espejo a Jennea Cañón en Ventormenta.‡Lleva una muestra del Lago Espejo a Jennea Cañón en Ventormenta.‡Apporter un échantillon d\'Eau du lac Miroir à Jennea Cannon à Hurlevent.‡把一份明镜湖水的样本交给暴风城的詹妮亚·坎农。‡把一份明鏡湖水的樣本交給暴風城的詹妮亞·坎農。',
  }
},
[1878] = {
  {
    'Bolsas de água pra refrescar‡Награда за воду‡Wasserbeutelkopfgeld‡물주머니 현상금‡Cazador de faltriqueras de agua‡Cazador de faltriqueras de agua‡Prime de la poche à eau‡收集水袋‡收集水袋',
    nil,
    'Voltou, <name>? Se você tiver mais cinco bolsas de água do errante pra mim, eu tenho um kit de sobrevivência pra você!‡Опять ты здесь? Если ты несешь еще пять бурдюков с водой Скитальцев Пустыни, то тебя ждет еще один именной полевой набор!‡Ihr seid ja schon wieder da, <Name>! Wenn Ihr noch fünf Wasserbeutel eines Wüstenläufers für mich habt, dann habe ich hier ein kleines Paket, das nur auf Euch wartet!‡부지런한 <name> 양반, 또 오셨군. 사막유랑단 물주머니 5개를 더 가져왔다면 선물세트를 주겠소! 이름도 큼직하게 새겨서 말이오.‡¿Ya has vuelto, <nombre>? Si tienes cinco bolsas más de agua te puedo dar ya mismo tu recompensa.‡‡Vous revoici, <nom> ? Si vous avez cinq outres de Bat-le-désert de plus, alors j\'ai un paquet qui porte votre nom !‡又回来了，<name>？如果你找到五只废土水袋，那我就再给你一个包裹！‡',
  }
},
[1879] = {
  {
    'Fale com Bink‡Поговорите с Бинк‡Gespräch mit Bink‡빙크와의 대화‡Habla con Bink‡Habla con Bink‡Parler à Bink‡和彬克交谈‡',
    nil,
    'Fale com Bink em Altaforja.‡Поговорите с Бинк из Стальгорна.‡Sprecht mit Bink in Eisenschmiede.‡아이언포지에 있는 빙크와 대화하십시오.‡Habla con Bink en Forjaz.‡Habla con Bink en Forjaz.‡Parler à Bink à Forgefer.‡和铁炉堡的彬克谈一谈。‡',
  }
},
[1880] = {
  {
    'Treconitor magostático‡Маг-тастический гизмонитор‡Magitastischer Gizmonitor‡마법사의 기억장치‡Trastónitor maguitronic‡Trastónitor maguitronic‡Le Bidulotron de youplala‡法师文档存储器‡法師文檔記憶體',
    nil,
    'Devolva o Treconitor Magostático a Bink.‡Верните Бинк маг-тастический гизмонитор.‡Bringt Bink ihren magitastischen Gizmonitor.‡빙크에게 마법사의 기억장치를 가져가야 합니다.‡Llévale a Bink su trastónitor maguitronic.‡Llévale a Bink su trastónitor maguitrónic.‡Rapporter à Bink son Bidulotron de Youplala.‡帮彬克找回她的法师文档存储器。‡幫彬克找回她的法師文檔記憶體。',
  }
},
[1881] = {
  {
    'Fale com Anastácia Cordato‡Разговор с Анастасией‡Gespräch mit Anastasia‡아나스타샤와의 대화‡Habla con Anastasia‡Habla con Anastasia‡Parler à Anastasia‡安娜斯塔西娅‡',
    nil,
    'Fale com Anastácia Cordato.‡Поговорите с Анастасией Хартвелл.‡Sprecht mit Anastasia Hirschbrunn.‡아나스타샤 하트웰과 대화하십시오.‡Habla con Anastasia Pozovenado.‡Habla con Anastasia Hartwell.‡Aller voir Anastasia Hartwell.‡和安娜斯塔西娅·哈特威尔谈一谈。‡',
  }
},
[1882] = {
  {
    'A Fazenda dos Balnir‡Ферма Балнира‡Balnirs Bauernhof‡발니르 농장‡La Hacienda Balnir‡La Hacienda Balnir‡La ferme des Balnir‡巴尼尔农场‡巴尼爾農場',
    nil,
    'Traga Bocas-de-Leão de Balnir para Anastácia Cordato no Distrito dos Magos da Cidade Baixa.‡Принесите львиный зев Бальнира Анастасии Хартвелл в Магический Квартал Подгорода.‡Bringt Balnirlöwenmäulchen zu Anastasia Hirschbrunn im Magierviertel von Unterstadt.‡언더시티의 마법 지구에 있는 아나스타샤 하트웰에게 발니르 금어초를 가져가야 합니다.‡Lleva las Bocas de dragón de Balnir a Anastasia Pozovenado en el Barrio de los Magos de Entrañas.‡Lleva las Bocas de dragón de Balnir a Anastasia Hartwell en el Barrio de los Magos de Entrañas.‡Apporter des Gueules-de-loup du jardin des Balnir à Anastasia Hartwell dans le Quartier des mages de Fossoyeuse.‡将巴尼尔金鱼草交给幽暗城法师区的安娜斯塔西娅·哈特威尔。‡將巴尼爾金魚草交給幽暗城法師區的安娜斯塔西婭·哈特威爾。',
  }
},
[1883] = {
  {
    'Fale com Un\'Thuwa‡Разговор с Ун\'Тувой‡Gespräch mit Un\'thuwa‡운투와와의 대화‡Habla con Un\'thuwa‡Habla con Un\'thuwa‡Parler à Un\'thuwa‡安苏瓦‡安蘇瓦',
    nil,
    'Fale com Un\'Thuwa.‡Поговорите с Ун\'Тувой.‡Sprecht mit Un\'thuwa.‡운투와와 대화하십시오.‡Habla con Un\'thuwa.‡Habla con Un\'thuwa.‡Aller voir Un\'thuwa.‡和安苏瓦谈一谈。‡和安蘇瓦談話。',
  }
},
[1884] = {
  {
    'Pilhas de ju-ju‡Груды джуджу‡Jujuhaufen‡주주 해골‡Montones de Ju-Ju‡Montones de Ju-Ju‡Les Tas de Ju-Ju‡魂能骨堆‡',
    nil,
    'Destrua 4 Pilhas de Ju-Ju, depois fale novamente com Un\'Thuwa na Aldeia Sen\'jin.‡Уничтожьте 4 груды джуджу и вернитесь к Ун\'Туве из деревни Сен\'джин.‡Zerstört 4 Jujuhaufen und kehrt dann zu Un\'thuwa in Sen\'jin zurück.‡주주 해골 4개를 파괴하고 센진 마을에 있는 운투와에게 돌아가야 합니다.‡Destruye 4 montones de Ju-Ju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Destruye 4 montones de Juju y vuelve con Un\'thuwa en Poblado Sen\'jin.‡Détruire 4 Tas de Ju-Ju, puis retourner voir Un\'thuwa au village de Sen\'jin.‡摧毁4个魂能骨堆，然后向森金村的安苏瓦汇报。‡',
  }
},
[1885] = {
  {
    'Júnio Aquino‡Меннит Каркад‡Mennet Carkad‡메넷 칼카드‡Mennet Carkad‡Mennet Carkad‡Mennet Carkad‡米奈特·卡加德‡米奈特·卡加德',
    nil,
    'Fale com Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Поговорите с Меннитом Каркадом в Квартале Разбойников Подгорода.‡Sprecht mit Mennet Carkad im Schurkenviertel von Unterstadt.‡언더시티의 도적 지구에 있는 메넷 칼카드와 대화해야 합니다.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Habla con Mennet Carkad en el Barrio de los Pícaros de Entrañas.‡Aller voir Mennet Carkad dans le Quartier des voleurs de Fossoyeuse.‡与幽暗城潜行者区的米奈特·卡加德谈一谈。‡與幽暗城盜賊區的米奈特·卡加德談話。',
  }
},
[1886] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Obtenha a Carta de Apresentação do Astolfo e leve até Júnio Aquino no Distrito dos Ladinos.‡Принесите рекомендательное письмо Астора Менниту Каркаду в Квартал Разбойников Подгорода.‡Beschafft Astors Vorstellungsschreiben und bringt es zu Mennet Carkad im Schurkenviertel.‡도적 지구에 있는 메네세 칼카드에게 아스토르의 소개장을 가져가야 합니다.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, que está en el Barrio de los Pícaros.‡Consigue la carta de presentación de Astor y devuélvesela a Mennet Carkad, en el Barrio de los Pícaros.‡Trouver la Lettre de recommandation d\'Astor et l\'apporter à Mennet Carkad dans le Quartier des voleurs.‡得到阿斯托的介绍信，并将其交给潜行者区的米奈特·卡加德。‡得到阿斯托的介紹信，並將其交給盜賊區的米奈特·卡加德。',
  }
},
[1898] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Fale com Andron Gante na Cidade Baixa.‡Поговорите с Андроном Гантом в Подгороде.‡Sprecht mit Andron Gant in Unterstadt.‡언더시티에 있는 안드론 건트와 대화해야 합니다.‡Habla con Andron Gant en Entrañas.‡Habla con Andron Gant en Entrañas.‡Aller voir Andron Gant à Fossoyeuse.‡与幽暗城的安德隆·甘特交谈。‡與幽暗城的安德隆·甘特交談。',
  }
},
[1899] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Entregue o Livro-caixa de Andron a Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Отнесите гроссбух Андрона Менниту Каркаду в Квартал Разбойников Подгорода.‡Bringt Androns Geschäftsbuch zu Mennet Carkad im Schurkenviertel von Unterstadt.‡언더시티에 있는 메넷 칼카드에게 안드론의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Llévale el libro de contabilidad de Andron a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Apporter le Grand Livre d\'Andron à Mennet Carkad dans le Quartier des voleurs de Fossoyeuse.‡将阿斯托的账本交给幽暗城盗贼区的米奈特·卡加德。‡將安德隆的帳本交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[1918] = {
  {
    'O elemento conspurcado‡Оскверненная стихия‡Das beschmutzte Element‡타락한 정령‡El elemento contaminado‡El elemento contaminado‡Les éléments souillés‡被污染的水元素‡被污染的水元素',
    nil,
    'Entregue o Globo d\'Água Conspurcado a Mastok Wrilehiss no Posto Machadada, no Vale Gris.‡Отнесите оскверненную водяную сферу Мастоку Райльшипу на заставу Расщепленного Дерева в Ясеневый лес.‡Bringt die beschmutzte Wasserkugel zu Mastok Wutfauch im Splitterholzposten im Eschental.‡잿빛 골짜기 토막나무 주둔지에 있는 마스토크 윌리히스에게 더럽혀진 물구슬을 가져가야 합니다.‡Llévale el globo de agua contaminada a Mastok Sibilante en el Puesto del Hachazo, Vallefresno.‡Llévale el globo de agua contaminada a Mastok Bufido en el Puesto del Hachazo, Vallefresno.‡Apporter le Globe d\'eau souillée à Mastok Torvesiffle, au Poste de Bois-brisé, à Orneval.‡将被污染的水球交给灰谷碎木哨岗的马斯托克·维尔西斯。‡將被污染的水球交給梣谷碎木崗哨的馬斯托克·維爾西斯。',
  }
},
[1919] = {
  {
    'Jana tem uma missão‡Задание Джиннии‡Meldung bei Jennea‡제니아에게 보고‡Preséntate ante Jennea‡Preséntate ante Jennea‡Rendre compte à Jennea‡向詹妮亚报告‡向詹妮亞報告',
    nil,
    'Fale com Jana Catão em Ventobravo.‡Поговорите с Джиннией Пушкой в Штормграде.‡Sprecht in Sturmwind mit Jennea Haubitz.‡스톰윈드에 있는 제니아 캐논과 대화하십시오.‡Habla con Jennea Cañón en Ventormenta.‡Habla con Jennea Cañón en Ventormenta.‡Parler à Jennea Cannon à Hurlevent.‡和暴风城的詹妮亚·坎农谈一谈。‡和暴風城的詹妮亞·坎農談談。',
  }
},
[1920] = {
  {
    'Investigue o Recôndito Azulego‡Синий Отшельник‡Untersuchungen im Blauen Eremiten‡고독한 은둔자 선술집 조사‡Investiga lo que pasa en El Ermitaño Azul‡Investiga lo que pasa en El Ermitaño Taciturno‡Trouver le Solitaire bleu‡调查蓝色隐士‡調查藍色隱士',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Jana Catão. Leve 3 Cofres de Contenção Cheios para Jana no Sacrário dos Teurgos.‡Возьмите свиток заклятия Проявления и ящик с шкатулками-духоловками за спиной у Джиннии Пушки. Принесите 3 заполненных шкатулки-духоловки Джиннии в Башню магов.‡Nehmt Euch die Inkantation der Manifestation und die Truhe mit Verwahrungskästen vom Tisch, hinter Jennea Haubitz. Bringt 3 gefüllte Verwahrungskästen zu Jennea im Magiersanktum.‡제니아 캐논의 뒤에 있는 현신의 주문서와 속박의 상자를 집으십시오. 마법사의 성소에 있는 제니아에게 채워진 속박의 상자 3개를 가져가야 합니다.‡Detrás de Jennea Cañón encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva las arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Detrás de Jennea Cañón encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas a Jennea, en el Sagrario del Mago.‡Obtenir un Chant de manifestation et une Caisse de coffres de retenue placée derrière Jennea Cannon. Apporter 3 Coffres de retenue remplis à Jennea Cannon au Sanctuaire du sorcier.‡从詹妮亚·坎农身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给巫师圣殿里的詹妮亚·坎农。‡從詹妮亞·坎農身後拿取一根顯形卷軸以及一盒封靈箱。將3個裝滿的封靈箱交給巫師聖所裡的詹妮亞·坎農。',
  }
},
[1921] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 peças de Linho e as 6 Gemas Energizadas da Fenda para Manoela Galante em Ventobravo.‡Отнесите 10 кусков льна и 6 заряженных самоцветов Расселины Уинн Ларсон в Штормград.‡Bringt 10 Leinenstoff und 6 aufgeladene Rissedelsteine zu Wynne Larson in Sturmwind.‡스톰윈드에 있는 위니 라슨에게 리넨 옷감 10장과 충만한 균열석 6개를 가져가야 합니다.‡Consigue 10 paños de lino y 6 gemas cargadas de la falla para Wynne Larson en Ventormenta.‡Consigue 10 paños de lino y 6 gemas cargadas de la falla para Wynne Larson en Ventormenta.‡Apporter 10 morceaux d\'Etoffe de lin et 6 Gemmes chargées de la faille à Wynne Larson à Hurlevent.‡把10匹亚麻布和6颗充能裂隙宝石交给暴风城的维恩·拉尔森。‡把10匹亞麻布和6顆充能裂隙寶石交給暴風城的威恩·拉爾森。',
  }
},
[1938] = {
  {
    'Tratado de Ur sobre Umbromancia‡Трактат Ура по темной магии‡Urs Abhandlung über Schattenmagie‡우르의 흑마법 논문‡Tratado de Ur sobre la Magia de las Sombras‡Tratado de Ur sobre la Magia de las Sombras‡Traité d\'Ur sur la Magie des Ombres‡乌尔的暗影魔法研究论文‡烏爾的暗影魔法研究論文',
    nil,
    'Entregue o Tratado de Ur sobre Umbromancia ao Grão-feiticeiro Andromath em Ventobravo.‡Принесите Трактат Ура по темной магии верховному колдуну Андромату из Штормграда.‡Bringt \'Urs Abhandlung über Schattenmagie\' zu Zaubermeister Andromath in Sturmwind.‡스톰윈드에 있는 고위마술사 안드로매스에게 우르의 흑마법 논문을 가져가야 합니다.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Lleva el Tratado de Ur sobre la Magia de las Sombras al sumo hechicero Andromath en Ventormenta.‡Apporter le « Traité d\'Ur sur la magie des Ombres » au Grand Sorcier Andromath à Hurlevent.‡将《乌尔的暗影魔法研究论文》交给暴风城的高阶巫师安多玛斯。‡將《烏爾的暗影魔法研究論文》交給暴風城的高階巫士安多瑪斯。',
  }
},
[1939] = {
  {
    'Grão-feiticeiro Andromath‡Верховный колдун Андромат‡Zaubermeister Andromath‡고위마술사 안드로매스‡Sumo Hechicero Andromath‡Sumo Hechicero Andromath‡Grand sorcier Andromath‡高阶巫师安多玛斯‡高階巫士安多瑪斯',
    nil,
    'Fale com o Grão-Feiticeiro Andromath.‡Поговорите с верховным колдуном Андроматом.‡Sprecht mit Zaubermeister Andromath.‡고위마술사 안드로매스와 대화하십시오.‡Habla con el sumo hechicero Andromath.‡Habla con el sumo hechicero Andromath.‡Aller voir le Grand Sorcier Andromath.‡和高阶巫师安多玛斯谈一谈。‡和高階巫士安多瑪斯談話。',
  }
},
[1940] = {
  {
    'Seda pura de aranha‡Безупречная паутина‡Makellose Spinnenseide‡온전한 거미줄‡Seda prístina de araña‡Seda prístina de araña‡Soie d\'araignée en parfait état‡新鲜的蜘蛛丝‡新鮮的蜘蛛絲',
    nil,
    'Leve 8 Sedas Puras de Aranha para Manoela Galante em Ventobravo.‡Принесите 8 кусков безупречной паутины Уинн Ларсон в Штормград.‡Bringt 8 Rollen makelloser Spinnenseide zu Wynne Larson in Sturmwind.‡스톰윈드에 있는 위니 라슨에게 온전한 거미줄 8개를 가져가야 합니다.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Lleva 8 sedas prístinas de araña a Wynne Larson en Ventormenta.‡Apporter 8 Soies d\'araignée en parfait état à Wynne Larson à Hurlevent.‡找到8束新鲜的蜘蛛丝，把它们交给暴风城的维恩·拉尔森。‡',
  }
},
[1941] = {
  {
    'Veste de fios de mana‡Одеяние из ткани маны‡Managewirkte Robe‡마나매듭 로브‡Toga Tejemaná‡Toga Tejemaná‡La robe en tisse-mana‡法纹长袍‡法力之紋長袍',
    nil,
    '‡Вот твое одеяние. Один из моих шедевров! Носи на здоровье, а если тебя спросят, кто шил... Посоветуй им обратиться в суконную лавку Ларсона!‡Hier ist Eure Robe. Er ist eine meiner besten bisher! Tragt sie voller Stolz, und wenn die Leute Euch fragen... sagt ihnen, Ihr habt sie vom Konfektionsgeschäft Larson.‡자, 로브 여기 있어요. 지금까지 만든 것 중 최고랍니다! 자부심을 갖고 입으시고 어디서 만든 거냐고 묻거든... 라슨의 의상실에서 만든 거라고 말해주세요!‡Aquí está tu toga. ¡Es una de las mejores que he hecho nunca! Llévala con orgullo y cuando te pregunten... ¡di que te la hicieron en Diseños Larson!‡‡Voici votre robe. C\'est l’une des plus belles que j\'ai confectionnées ! Portez-la avec fierté. Et si les gens vous interrogent, dites-leur qu\'elle sort de l’atelier des couturiers Larson !‡‡',
  }
},
[1942] = {
  {
    'Traje do nó astral‡Одеяние волшебного плетения‡Astralknotengewand‡별매듭 로브‡Prendas de nudo astral‡Prendas de nudo astral‡L\'Habit du noeud astral‡星结之衣‡',
    nil,
    'Seu traje está pronto! E seda que você trouxe era de ótima qualidade... Fiz um pouquinho mais curto porque guardei um pouco da seda pra mim, tudo bem?nnBrincadeirinha... Vai ficar perfeito em você, é ideal para aventuras e também jantares formais. Sucesso com o traje!‡Твое одеяние готово! Отличный шелк тебе достался... Ты уж прости, одеяние получилось довольно короткое, часть шелка я себе оставила.nnШучу, шучу. Оно тебе идеально подойдет, причем будет уместно смотреться как в бою, так и на торжественном обеде. Наслаждайся!‡Euer Gewand ist fertig! Die Seide, die Ihr mir gebracht hattet, war so hübsch... es stört Euch doch nicht, dass ich es etwas kürzer gemacht habe, damit noch etwas Seide für mich übrig bleibt, oder?nnDas war nur ein Witz. Das Gewand wird sitzen wie angegossen und es eignet sich gleichermaßen gut, um damit in Abenteuer zu ziehen oder zu einem Empfang zu gehen. Viel Spaß damit!‡자, 옷이 다 됐어요! 당신이 모아온 비단이 얼마나 좋은지 몰라요. 저, 당신 옷을 좀 짧게 만들고 남은 비단으로 제 옷을 만들어도 될까요?nn호호, 농담이에요. 이 로브는 모험을 할 때나 격식을 갖춘 만찬에 참석할 때나 모두 잘 어울리고 잘 맞을 겁니다. 잘 입으세요!‡¡Ya está lista! La seda que trajiste era tan delicada... que te hice la prenda un poco pequeña para quedarme yo con algo de sobra, ¿no te importa, verdad?nnEs una broma. Te quedará perfecta y será ideal tanto para tus aventuras como para una cena formal. ¡Que la disfrutes!‡‡Votre habit est prêt. Cette soie que vous avez apportée était si belle... Ça ne vous fait rien si je l\'ai cousu un peu court pour pouvoir en conserver un morceau ? nnMais non, je plaisante ! Il vous ira comme un gant, au plus fort de l\'aventure comme dans les occasions plus mondaines ! Profitez-en bien !‡‡',
  }
},
[1943] = {
  {
    'Fale com Denya‡Разговор с Дейно‡Gespräch mit Deino‡다이노와의 대화‡Habla con Deino‡Habla con Deino‡Parler à Deino‡巨魔法师迪诺‡食人妖法師迪諾',
    nil,
    'Fale com Denya.‡Поговорите с Дейно.‡Sprecht mit Deino.‡다이노와 대화하십시오.‡Habla con Deino.‡Habla con Deino.‡Aller voir Deino.‡和迪诺谈一谈。‡和迪諾談話。',
  }
},
[1944] = {
  {
    'Águas de Xavian‡Воды Ксавиана‡Wasser von Xavian‡사비안의 폭포수‡Aguas de Xavian‡Aguas de Xavian‡Les Eaux de Xavian‡克萨维亚之水‡薩維亞之水',
    nil,
    'Leve uma Amostra de Água Xaviana para Denya em Orgrimmar.‡Принесите пробу воды из Ксавиана Дейно в Оргриммар.‡Bringt die Wasserprobe von Xavian zu Deino in Orgrimmar.‡오그리마에 있는 다이노에게 사비안 폭포수 견본을 가져가야 합니다.‡Lleva la muestra de agua de Xavian a Deino en Orgrimmar.‡Lleva la muestra de agua de Xavian a Deino en Orgrimmar.‡Apporter l\'Échantillon d\'Eau de Xavian à Deino à Orgrimmar.‡将克萨维亚水样交给奥格瑞玛的迪诺。‡將克薩維亞水樣交給奧格瑪的迪諾。',
  }
},
[1945] = {
  {
    'Irmãs Risonhas‡Смеющиеся сестры‡Lachende Schwestern‡미소띤 자매‡Hermanas sonrientes‡Hermanas sonrientes‡Les sœurs rieuses‡欢笑的姐妹‡歡笑的姐妹',
    nil,
    'Leve 12 Cabelos das Irmãs Risonhas para Kil\'hala na Encruzilhada.‡Принесите 12 волос Смеющихся сестер Кил\'хале с Перекрестка.‡Bringt 12 Haarlocken der lachenden Schwestern zu Kil\'hala beim Wegekreuz.‡크로스로드에 있는 킬할라에게 미소띤 자매의 머리카락 12개를 가져가야 합니다.‡Lleva 12 cabellos de hermana sonriente a Kil\'hala en El Cruce.‡Lleva 12 cabellos de hermana sonriente a Kil\'hala en El Cruce.‡Apporter 12 Cheveux de sœurs rieuses à Kil\'hala à la Croisée.‡给十字路口的基尔哈拉带去12缕欢笑姐妹的头发。‡給十字路口的基爾哈拉帶去12縷歡笑姐妹的頭髮。',
  }
},
[1946] = {
  {
    'Traje do laço etéreo‡Одеяние из кружева Пустоты‡Netherspitzengewand‡황천의 로브‡Prendas de encaje Abisal‡Prendas de encaje Abisal‡L\'Habit du néant‡虚灵长袍‡',
    nil,
    '‡Вот твое пустокружево. Оно прочное и удобное и хранит в себе магию волос Смеющейся сестрички.nnНаслаждайся. Если понравится, не забудь упомянуть об этом в разговоре с Дейно. Вот уж с кем бы не хотелось ссориться...‡Hier habt Ihr Euer Gewand aus Netherspitze, <Name>. Es ist bequem und strapazierfähig und enthält die Magie des Haars der lachenden Schwestern.nnViel Spaß damit, und wenn Euch das Gewand zusagt, dann lasst es doch bitte auch Deino wissen. Sie ist eine Magierin, mit der ich es mir nicht verderben möchte ...‡‡Aquí tienes tu encaje abisal, <nombre>. Es cómodo y duradero y alberga la magia del cabello de hermana sonriente.nnDisfrútalo y si lo encuentras adecuado menciónaselo a Deino, la maga. Me gustaría estar de su lado...‡‡Voici votre robe du Néant, <nom>. À la fois confortable et solide, elle contient la magie des cheveux des sœurs rieuses. nnSi elle vous plaît, parlez-en à Deino. C\'est un <classe> d\'une telle puissance que je préfère être de son côté !‡‡',
  }
},
[1947] = {
  {
    'Jornada ao pântano‡Путь в болото‡Reise in die Marschen‡습지대로의 여행‡Viaje al pantano‡Viaje al pantano‡Voyager vers le Marais‡沼泽之旅‡沼澤之旅',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화하십시오.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1948] = {
  {
    'Itens do poder‡Волшебные предметы‡Gegenstände der Macht‡강력한 물건‡Objetos de poder‡Objetos de poder‡Les Objets de Puissance‡强大的物品‡強大的物品',
    nil,
    'Traga 1 Jade e a Morácea Carregada por Raio para Tabetha no Pântano Vadeoso.‡Принесите 1 нефрит и шипастый жезл Молний Табете в Пыльную трясину.‡Bringt 1 Stück Jade und den vom Blitz aufgeladenen Dornbusch zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 비취 1개와 벼락 맞은 나뭇가지를 가져가야 합니다.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Apporter 1 Jade et le Roncier de foudre à Tabetha, dans le marécage d\'Âprefange.‡将电能草莓和1颗翡翠交给尘泥沼泽的塔贝萨。‡將電能草莓和1顆翡翠交給塵泥沼澤的塔貝薩。',
  }
},
[1949] = {
  {
    'Segredos ocultos‡Великие тайны‡Verborgene Geheimnisse‡숨겨진 비밀‡Secretos escondidos‡Secretos escondidos‡Des secrets cachés‡隐藏的秘密‡隱藏的秘密',
    nil,
    'Fale com Tirth, o Mago, no Salar Cintilante.‡Поговорите с волхвом Тиртом на Мерцающей равнине.‡Sprecht mit Magus Tirth in der schimmernden Ebene.‡소금 평원에 있는 학자 틸스와 대화하십시오.‡Habla con Magus Tirth en El Desierto de Sal.‡Habla con Magus Tirth en El Desierto de Sal.‡Parler au magus Tirth dans les Salines.‡和闪光平原的大法师提尔斯谈一谈。‡和閃光平原的魔導師提爾斯談話。',
  }
},
[1950] = {
  {
    'Tente a sorte‡Волшебное слово‡Der Knüller schlechthin‡주문 알아오기‡Santo y seña‡Santo y seña‡Trouver le Scoop‡解封咒语‡解封咒語',
    nil,
    'Encontre a frase que abre o cofre de Tirth e fale novamente com ele.‡Узнайте волшебные слова, отпирающие сейф Тирта и вернитесь к Тирту.‡Bringt den Satz für Tirths Geldkassette in Erfahrung und kehrt zu Tirth zurück.‡틸스의 금고를 여는 주문을 알아서 틸스에게 돌아가야 합니다.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Trouver l\'Incantation pour ouvrir le coffre-fort de Tirth puis retourner voir Tirth.‡找到提尔斯保险箱的解封咒语，然后向提尔斯复命。‡找到提爾斯保險箱的解封咒語，然後向提爾斯覆命。',
  }
},
[1951] = {
  {
    'Rituais do Poder‡Обряды силы‡Rituale der Macht‡마력의 의식‡Rituales de poder‡Rituales de poder‡Rituels du Pouvoir‡能量仪祭‡能量儀式',
    nil,
    'Leve o livro Rituais do Poder para Tabetha no Pântano Vadeoso.‡Принесите книгу "Обряды силы" Табете в Пыльную трясину.‡Bringt das Buch \'Rituale der Macht\' zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 마력의 의식을 가져가야 합니다.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Apporter le livre des « Rituels du pouvoir » à Tabetha dans le marécage d\'Âprefange.‡将《能量仪祭》交给尘泥沼泽的塔贝萨。‡將《能量儀式》交給塵泥沼澤的塔貝薩。',
  }
},
[1952] = {
  {
    'Varinha do Mago‡Магический жезл‡Der Zauberstab des Magiers‡마법사의 마법봉‡Varitas de mago‡Varitas de mago‡La baguette du mage‡法师的魔杖‡法師的魔杖',
    nil,
    'Fale com Tabetha depois do ritual.‡Поговорите с Табетой по завершении ритуала.‡Sprecht nach ihrem Ritual mit Tabetha.‡의식이 끝나면 타베사와 대화하십시오.‡Habla con Tabetha cuando termine su ritual.‡Habla con Tabetha cuando termine su ritual.‡Parler à Tabetha après son rituel.‡等塔贝萨的仪式完成后，和她谈一谈。‡等塔貝薩的儀式完成後，和她談話。',
  }
},
[1953] = {
  {
    'Retorno ao pântano‡Назад в болото‡Rückkehr in die Marschen‡다시 습지대로‡Regreso al pantano‡Regresa a la Marisma‡Retourner dans le Marais‡返回沼泽‡回到沼澤',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화하십시오.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1954] = {
  {
    'O Orbe Infernal‡Сфера Подземного огня‡Die Höllenkugel‡지옥의 보주‡El orbe infernal‡El orbe infernal‡L\'orbe infernal‡地狱火宝珠‡地獄火寶珠',
    nil,
    'Leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Принесите сферу Подземного огня Табете из Пылевых топей.‡Bringt eine Höllenkugel zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 지옥의 보주를 가져가야 합니다.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Apporter un Orbe infernal à Tabetha dans le marécage d\'Âprefange.‡将一颗地狱火宝珠交给尘泥沼泽的塔贝萨。‡將一顆地獄火寶珠交給塵泥沼澤的塔貝薩。',
  }
},
[1955] = {
  {
    'O Exorcismo‡Поединок с демоном‡Die Austreibung‡악마 퇴치‡El exorcismo‡El exorcismo‡L\'Exorcisme‡驱除魔鬼‡',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화해야 합니다.‡Mata al demonio del orbe y habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuer le démon de l\'Orbe puis parler à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡',
  }
},
[1956] = {
  {
    'Poder em Uldaman‡Сила Ульдамана‡Macht in Uldaman‡울다만의 마력원천‡Poder en Uldaman‡Poder en Uldaman‡L\'Energie d\'Uldaman‡奥达曼的能量源‡奧達曼的能量源',
    nil,
    'Recupere uma Fonte de Energia de Obsidiana e leve-a para Tabetha no Pântano Vadeoso.‡Добудьте обсидиановый источник силы и принесите его Табете в Пыльную трясину.‡Beschafft Euch eine Obsidiankraftquelle und bringt sie in die Düstermarschen zu Tabetha.‡흑요석 마력원천을 구해서 먼지진흙 습지대에 있는 타베사에게 가져가야 합니다.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Récupérer une Source d\'énergie en obsidienne et la rapporter à Tabetha dans le marécage d\'Âprefange.‡找到一个黑曜石能量源，将其交给尘泥沼泽的塔贝萨。‡找到一個黑曜石能量源，將其交給塵泥沼澤的塔貝薩。',
  }
},
[1957] = {
  {
    'Surtos de mana‡Волнолов маны‡Manawogen‡마력의 폭풍‡Oleadas de maná‡Oleadas de maná‡Les éruptions de mana‡法力怒灵‡',
    nil,
    'Mate 12 Surtos de Mana no tempo limite permitido.‡Убейте 12 волноловов маны за отведенное время.‡Vernichtet 12 Manawogen innerhalb des Zeitlimits.‡주어진 시간 안에 마력의 폭풍 12마리를 물리쳐야 합니다.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Tuer 12 Eruptions de mana dans la limite de temps imposée.‡在限定时间内杀死12只法力怒灵。‡',
  }
},
[1958] = {
  {
    'Poder celestial‡Небесная сила‡Himmlische Macht‡천공의 힘‡Poder celestial‡Poder celestial‡L\'énergie céleste‡苍穹之力‡',
    nil,
    '‡‡Ihr solltet stolz auf Euch sein, <Name>. Viele <Klasse> fielen den Kreaturen zum Opfer, denen Ihr getrotzt habt.nnDie Himmelskugel ist fertig. Wenn Ihr möchtet, kann ich sie oben an einem Stab anbringen. Es liegt bei Euch. Mir persönlich wäre die Kugel allein ja lieber, aber wer bin ich, mir ein Urteil zu erlauben?‡‡‡‡Vous pouvez ressentir de la fierté, <nom>. Bien des mages auraient échoué face aux créatures que vous avez affrontées !nnL\'Orbe céleste est prêt. Je peux aussi le fixer sur un bâton, c\'est à vous de choisir. Moi, je choisirais l\'Orbe, mais qui suis-je pour avoir un avis ?‡‡',
  }
},
[1959] = {
  {
    'Apresente-se a Anastácia‡Задание Анастасии‡Meldung bei Anastasia‡아나스타샤에게 보고‡Preséntate ante Anastasia‡Preséntate ante Anastasia‡Rendre compte à Anastasia‡向安娜斯塔西娅报告‡',
    nil,
    'Fale com Anastácia Cordato.‡Поговорите с Анастасией Хартвелл.‡Sprecht mit Anastasia Hirschbrunn.‡아나스타샤 하트웰과 대화해야 합니다.‡Habla con Anastasia Pozovenado.‡Habla con Anastasia Hartwell.‡Aller voir Anastasia Hartwell.‡和安娜斯塔西娅·哈特威尔谈一谈。‡',
  }
},
[1960] = {
  {
    'Investigue a Loja de Alquimia‡Лавка алхимика‡Untersuchungen im Alchimistenladen‡연금술 상점 조사‡Investiga la tienda de alquimia‡Investiga la tienda de alquimia‡Enquêter dans le magasin de l\'Alchimiste‡调查炼金店‡調查鍊金店',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Anastácia Cordato. Traga 3 Cofres de Contenção Cheios, o Baú de Cofres de Contenção e o Cantochão da Manifestação para Anastácia na Cidade Baixa.‡Возьмите свиток заклятия Проявления и ящик с шкатулками-духоловками за спиной у Анастасии Хартвелл. Принесите 3 заполненных шкатулки-духоловки, ящик со шкатулками духоловками и заклинание Проявления Анастасии в Подгород.‡Besorgt eine Inkantation der Manifestation und eine Truhe mit Verwahrungskästen von Anastasia Hirschbrunn. Bringt 3 gefüllte Verwahrungskästen, die Truhe mit Verwahrungskästen sowie die Inkantation der Manifestation zu Anastasia in Unterstadt.‡아나스타샤 하트웰의 뒤에 있는 현신의 주문서와 속박의 상자를 집어야 합니다. 언더시티에 있는 아나스타샤 하트웰에게 채워진 속박의 상자 3개와, 속박의 상자, 현신의 주문서를 가져가야 합니다.‡Detrás de Anastasia Pozovenado encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Detrás de Anastasia Hartwell encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Obtenir une Incantation de Manifestation et une Caisse de Coffres de retenue placée derrière Anastasia Hartwell. Apporter 3 Coffres de retenue remplis, la Caisse de Coffres de retenue et l\'Incantation de Manifestation à Anastasia Hartwell à Undercity.‡从安娜斯塔西娅·哈特威尔身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给幽暗城的安娜斯塔西娅·哈特威尔。‡從安娜斯塔西婭·哈特威爾身後拿取一根顯形卷軸以及一盒封靈箱。將3個裝滿的封靈箱交給幽暗城的安娜斯塔西婭·哈特威爾。',
  }
},
[1961] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 peças de Linho e 6 Gemas de Mana de Dalaran para Josefo Gregório.‡Принесите 10 кусков льна и 6 даларанских самоцветов маны Джозефу Грегориану.‡Bringt 10 Leinenstoff und 6 Manaedelsteine aus Dalaran zu Josef Gregorian.‡조셉 그레고리안에게 리넨 옷감 10장과 달라란 마나석 6개를 가져가야 합니다.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Apporter 10 morceaux d\'Etoffe de lin et 6 Gemmes de mana de Dalaran à Josef Gregorian.‡把10块亚麻布和6块达拉然法力宝石带给乔瑟夫·格里高利。‡把10塊亞麻布和6塊達拉然法力寶石帶給喬瑟夫·格里高利。',
  }
},
[1962] = {
  {
    'Vestes de fogo místico‡Одеяние из чароткани‡Roben des Zauberfeuers‡마법불꽃 로브‡Toga fuego de hechizo‡Togas del hechizo del fuego‡Robe du feu-sorcier‡魔焰长袍‡',
    nil,
    '‡Вот твое новое одеяние, Тузвколоде. Носи на здоровье.‡Hier sind Eure Roben, <Name>. Tragt sie mit Bedacht.‡‡Aquí tienes tu toga, <nombre>. Utilízala bien.‡‡Voici votre robe, <nom>. Portez-la bien.‡‡',
  }
},
[1963] = {
  {
    'A Mão Despedaçada‡Изувеченная Длань‡Die Zerschmetterte Hand‡으스러진 손‡Mano Destrozada‡Mano Destrozada‡La Main brisée‡碎手氏族‡破碎之手氏族',
    nil,
    'Mate Tazan e leve a Algibeira dele para Therzok no Antro das Sombras, que fica em Orgrimmar.‡Убейте Тазана и принесите его сумку Терзоку в расселину Теней в Оргриммаре.‡Tötet Tazan und bringt seinen Ranzen zu Therzok in der Kluft der Schatten in Orgrimmar.‡타잔을 죽이고 그의 가방을 오그리마의 어둠의 틈에 있는 테르조크에게 가져가야 합니다.‡Mata a Tazan y llévale su cartera a Therzok al Circo de las Sombras, en Orgrimmar.‡Mata a Tazan y llévale su cartera a Therzok al Circo de las Sombras, en Orgrimmar.‡Tuer Tazan et apporter sa Sacoche à Therzok, à la Faille de l\'ombre à Orgrimmar.‡杀死塔赞，把他的背包带给奥格瑞玛暗影裂口的瑟祖克。‡殺死塔贊，把他的背包帶給奧格瑪暗影裂口的瑟祖克。',
  }
},
[1978] = {
  {
    'Os Sicários‡Стражи смерти‡Die Todespirscher‡죽음의추적자‡Los Mortacechadores‡Los mortacechadores‡Les Traqueurs noirs‡亡灵哨兵‡亡靈哨兵',
    nil,
    'Entregue o Livro-caixa de Andron a Varimatras no Salão da Dama Sombria, que fica na Cidade Baixa.‡Отнесите гроссбух Андрона Вариматрасу в Зал Темной Госпожи в Подгороде.‡Bringt Androns Geschäftsbuch zu Varimathras in der Halle der dunklen Fürstin in Unterstadt.‡언더시티의 실바나스의 전당에 있는 바리마트라스에게 안드론의 장부를 가져가야 합니다.‡Entrégale el libro de contabilidad de Andron a Varimathras, que está en la Cámara de la Dama Oscura en Entrañas.‡Entrégale el libro de contabilidad de Andron a Varimathras, que está en la Cámara de la Dama Oscura en Entrañas.‡Livrer le Grand Livre d\'Andron à Varimathras au Hall de la Dame noire à Fossoyeuse.‡将安德隆的账本交给幽暗城黑暗女王大厅里的瓦里玛萨斯。‡將安德隆的帳本交給幽暗城黑暗女王大廳裡的瓦里瑪薩斯。',
  }
},
[1998] = {
  {
    'Fernão Thatros‡Фенвик Татрос‡Fenwick Thatros‡펜윅 타트로스‡Fenwick Thatros‡Fenwick Thatros‡Fenwick Thatros‡芬维克·萨托斯‡芬維克·薩托斯',
    nil,
    'Mate Fernão Thatros e leve a cabeça dele para Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Убейте Фенвика Татроса и принесите его голову Менниту Каркаду в Квартал Разбойников Подгорода.‡Tötet Fenwick Thatros und bringt seinen Kopf zu Mennet Carkad im Schurkenviertel von Unterstadt.‡펜윅 타트로스를 처치하고 그 증거로 그의 머리카락을 언더시티의 도적 지구에 있는 메넷 칼카드에게 가져가야 합니다.‡Mata a Fenwick Thatros y llévale su cabeza a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Mata a Fenwick Thatros y llévale su cabeza a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Tuer Fenwick Thatros et rapporter sa Tête à Mennet Carkad dans le Quartier des voleurs de Fossoyeuse.‡杀掉芬维克·萨托斯，把他的头颅交给幽暗城潜行者区的米奈特·卡加德。‡殺掉芬維克·薩托斯，把他的頭顱交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[1999] = {
  {
    'Ferramentas do ofício‡Предметы торговли‡Werkzeuge des Handwerks‡거래의 도구‡Herramientas de comercio‡Herramientas de comercio‡Les outils du métier‡交易工具‡交易工具',
    nil,
    'Encontre o Relatório Situacional de Dalaran e devolva-o a Júnio Aquino no Distrito dos Ladinos da Cidade Baixa.‡Отыщите отчет о состоянии Даларана и отдайте его Менниту Каркаду в Квартале Разбойников Подгорода.‡Sucht den Statusbericht von Dalaran und bringt ihn zu Mennet Carkad im Schurkenviertel von Unterstadt.‡달라란 상황 보고서를 찾아 언더시티의 도적 지구에 있는 메넷 칼카드에게 가져가야 합니다.‡Encuentra el informe de estado de Dalaran y devuélveselo a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Encuentra el informe de estado de Dalaran y devuélveselo a Mennet Carkad, que está en el Barrio de los Pícaros de Entrañas.‡Trouver le Rapport de situation de Dalaran et le remettre à Mennet Carkad dans le Quartier des voleurs de Fossoyeuse.‡找到达拉然形势报告，把它交给幽暗城潜行者区的米奈特·卡加德。‡找到達拉然形勢報告，把它交給幽暗城盜賊區的米奈特·卡加德。',
  }
},
[2000] = {
  {
    'Rokar Laminumbra‡Рокар Тень Клинка‡Rokar Klingenschatten‡로카르 블래이드섀도‡Rokar Filosombra‡Rokar Filosombra‡Rokar Ombrelame‡洛卡·刃影‡洛卡·刃影',
    nil,
    'Fale com Rokar Laminumbra em Durotar.‡Поговорите с Рокаром Тенью Клинка в Дуротаре.‡Sprecht mit Rokar Klingenschatten in Durotar.‡듀로타에 있는 로카르 블래이드섀도와 대화하십시오.‡Habla con Rokar Filosombra en Durotar.‡Habla con Rokar Filosombra en Durotar.‡Aller voir Rokar Ombrelame en Durotar.‡去找杜隆塔尔的洛卡·刃影谈一谈。‡',
  }
},
[2018] = {
  {
    'Rokar\'s Test‡Испытание Рокара‡Rokars Test‡‡La prueba de Rokar‡La prueba de Rokar‡L\'épreuve de Rokar‡‡',
    nil,
    'Kill Overseer Glibby and return his Whistle to Rokar Bladeshadow in Durotar.‡Убейте надзирателя Глибби и отдайте его свисток Рокару Тени Клинка в Дуротаре.‡Tötet Vorarbeiter Glibby und bringt seine Pfeife zu Rokar Klingenschatten in Durotar.‡‡Mata al vigía Glibby y llévale su silbato a Rokar Filosombra a Durotar.‡Mata al vigía Glibby y llévale su silbato a Rokar Filosombra a Durotar.‡Tuer le Surveillant Glibby et apporter son Sifflet à Rokar Ombrelame en Durotar.‡‡',
  }
},
[2019] = {
  {
    'Tools of the Trade‡Профессиональные инструменты‡Werkzeuge des Handwerks‡‡Herramientas de comercio‡‡Les outils du métier‡‡',
    nil,
    'Return to Therzok in the Cleft of Shadow in Orgrimmar.‡Вернитесь к Терзоку в Расселину Теней в Оргриммаре.‡Kehrt zu Therzok in der Kluft der Schatten in Orgrimmar zurück.‡‡Habla con Therzok en el Circo de las Sombras de Orgrimmar.‡Habla con Therzok en el Circo de las Sombras de Orgrimmar.‡Retourner voir Therzok à la Faille de l\'Ombre à Orgrimmar.‡‡',
  }
},
[2038] = {
  {
    'Os suprimentos desaparecidos do Gomez‡Пропавшее снаряжение Бинглза‡Bingles\' verschwundene Werkzeuge‡사라진 빙글스의 물건들‡Suministros de Bingles‡Suministros de Bingles‡Les fournitures perdues de Bingles‡宾格斯的补给品‡賓格斯的補給品',
    nil,
    'Encontre e devolva os suprimentos do Gomez:nnChave de Boca do Gomez, Chave de Fenda do Gomez, Martelo do Gomez e Detona-cuca do Gomez.‡Найдите и верните Бинглзу гаечный ключ Бинглза, отвертку Бинглза, молот Бинглза и сорвиголовку Бинглза.‡Sucht Bingles\' Werkzeuge und bringt sie ihm zurück. Es sind:nnBingles\' Schraubenschlüssel, Bingles\' Schraubendreher, Bingles\' Hammer und Bingles\' Superspreng.‡빙글스의 물건들을 찾아서 돌아와야 합니다.nn빙글스의 스패너, 빙글스의 드라이버, 빙글스의 망치, 빙글스의 깡그리싸그리 폭탄을 찾아야 합니다.‡Localiza las herramientas de Bingles y devuélveselas:nnllave inglesa, destornillador, martillo y cartucho.‡Localiza las herramientas de Bingles y devuélveselas:|nllave inglesa, destornillador, martillo y cartucho de explosivos.‡Trouver et rapporter à Bingles son matériel :nnLa Clé de Bingles, le Tournevis de Bingles, le Marteau de Bingles et le Capsuleur soufflant de Bingles.‡找回宾格斯的装备：n$宾格斯的气压炸弹、宾格斯的扳手、宾格斯的榔头和宾格斯的螺丝起子。‡找回賓格斯的裝備:|n賓格斯的氣壓炸彈、賓格斯的扳手、賓格斯的榔頭和賓格斯的螺絲起子。',
  }
},
[2039] = {
  {
    'Cadê o Bingles?‡Найти Бинглза‡Sucht Bingles‡빙글스 찾기‡Encuentra a Bingles‡Encuentra a Bingles‡Trouvez Bingles‡寻找宾格斯‡尋找賓格斯',
    nil,
    'Encontre Gomez Plosivo em Loch Modan.‡Найдите Бинглза Покрышкинса в Лок Модане.‡Sucht Bingles Blastenheimer am Loch Modan.‡모단 호수에서 빙글스 블라스텐하이머를 찾아야 합니다.‡Encuentra a Bingles Pimpampum en Loch Modan.‡Encuentra a Bingles Pimpampum en Loch Modan.‡Trouver Bingles Explonheimer, au Loch Modan.‡去洛克莫丹寻找宾格斯。‡去洛克莫丹尋找賓格斯·布萊頓海默。',
  }
},
[2040] = {
  {
    'Ataque subterrâneo‡Битва под землей‡Unterirdischer Angriff‡지하 공격‡Asalto subterráneo‡Asalto subterráneo‡Assaut souterrain‡地底突袭‡地底突襲',
    nil,
    'Recupere o Engrenotreco Gnomo das Minas Mortas e devolva a Shoni, a Shilenchiosa, em Ventobravo.‡Принесите Шони Молшунье в Штормград зубчатый спрек-механизм гномов из Мертвых копей.‡Holt das Gnoamsprenkelspross aus den Todesminen und bringt es Shoni der Schtillen in Sturmwind.‡죽음의 폐광에서 노암 톱니구동장치를 찾아 스톰윈드에 있는 쇼니에게 가져가야 합니다.‡Recupera la dentrituradora goblin de Las Minas de la Muerte y devuélvesela a Shoni la Shilenshiosha en Ventormenta.‡Recupera la Dentrituradora goblin de Las Minas de la Muerte y devuélveselo a Shoni la Shilenshiosha, en Ventormenta.‡Récupérer l\'Indicateur Gnoam dans les mortemines et le ramener à Shoni la Silencieuse à Hurlevent.‡从死亡矿井中带回小型高能发动机，将其带给暴风城矮人区中的沉默的舒尼。‡從死亡礦坑中帶回小型高能發動機，將其帶給暴風城矮人區中的沉默的舒尼。',
  }
},
[2041] = {
  {
    'Fale com Shoni‡Разговор с Шони‡Sprecht mit Shoni‡쇼니와의 대화‡Habla con Shoni‡Habla con Shoni‡Allez voir Shoni‡沉默的舒尼‡沉默的舒尼',
    nil,
    'Fale com Shoni, a Shilenchiosa, em Ventobravo.‡Поговорите с Шони Молшуньей в Штормграде.‡Sprecht mit Shoni der Schtillen in Sturmwind.‡스톰윈드에 있는 쇼니와 대화하십시오.‡Habla con Shoni la Shilenshiosha en Ventormenta.‡Habla con Shoni la Shilenshiosha en el Distrito de los Enanos en Ventormenta.‡Aller voir Shoni la Silencieuse à Hurlevent.‡去暴风城和舒尼谈一谈。‡去暴風城和舒尼談話。',
  }
},
[2078] = {
  {
    'A revanche de Giramastro‡Месть Гиромачта‡Gyromasts Rache‡자이로마스트의 복수‡La venganza de Gyromast‡La venganza de Gyromast‡La vengeance de Gyromast‡基尔卡克的报复‡',
    nil,
    'Encontre o Imediato de Gelkak e o Mangual-eliminator Pro Giramastro 4100, e leve-o de volta a Gelkak.‡Найдите первого помощника Гелхака, Бешенатора 4100, и отведите его к Гелхаку.‡Sucht Gelkaks Ersten Maat, den Dreschonator 4100, und führt ihn zu Gelkak zurück.‡겔카크의 일등항해사인 망나니탈곡기 4100을 찾아서 겔카크에게 데리고 오거나 처치해야 합니다.‡Encuentra el Trillomajareitor 4100, el contramaestre de Gelkak, y condúcelo hasta él.‡Encuentra el Trillomajareitor 4100, el contramaestre de Gelkak, y condúcelo hasta él.‡Trouver le Premier officier de Gelkak, le Destructomembreur 4100, et le ramener à Gelkak.‡找到基尔卡克的大副——机械打手4100型，把他带到基尔卡克那里。‡',
  }
},
[2098] = {
  {
    'Uma mão para Giramastro‡Помощь Гиромачту‡Gyromasts Rettung‡자이로마스트의 수색‡La búsqueda de Gyromast‡La búsqueda de Gyromast‡La recherche de Gyromast‡基尔卡克的钥匙‡基爾卡克的鑰匙復原',
    nil,
    'Encontre e devolva as três partes da Chave de Gelkak para Gelkak Giramastro.‡Отыщите три фрагмента ключа и отнесите их Гелхаку Гиромачту.‡Sucht die drei Stücke von Gelkaks Schlüssel und bringt sie Gelkak Gyromast.‡겔카크의 열쇠 조각 3개를 찾아 겔카크 자이로마스트에게 가져가야 합니다.‡Encuentra los tres fragmentos de la llave de Gelkak Gyromast y llévaselas.‡Encuentra y devuelve los tres fragmentos de la llave de Gelkak Gyromast.‡Trouver et rapporter les 3 Morceaux de la clé de Gelkak à Gelkak Gyromast.‡找到基尔卡可钥匙的3段碎片，把它们交给基尔卡克·旋杆。‡找到基爾卡可鑰匙的3段碎片，把它們交給基爾卡克·旋杆。',
  }
},
[2118] = {
  {
    'Terras pestilentas‡Зачумленные земли‡Verseuchtes Land‡역병에 걸린 땅‡Tierras apestadas‡Tierras apestadas‡Terres malades‡瘟疫蔓延‡瘟疫蔓延',
    nil,
    'Capture um ursocardo raivoso e traga de volta para Tharnariun.nnSe não conseguir capturar um ursocardo raivoso e perder a armadilha, fale novamente com Tharnariun Tratárvore e solicite outra.‡Поймайте бешеного колючешерстного медведя отведите его Тарнариуну.nnЕсли вам не удастся поймать зверя и вы потеряете ловушку, вернитесь к Тарнариуну Целителю Деревьев и попросите у него еще одну.‡Fangt einen lebenden tollwütigen Distelbären und bringt ihn zu Tharnariun.nnSolltet Ihr keinen tollwütigen Distelbären fangen können und Eure Falle verlieren, dann kehrt zu Tharnariun Baumwahrer zurück und bittet um eine neue Falle.‡광포한 엉겅퀴곰을 생포해 타나리운에게 데리고 와야 합니다.nn광포한 엉겅퀴곰을 생포하는 데 실패하고 덫을 잃으면, 타나리운 트리텐더에게 돌아가 다른 덫을 받아야만 합니다.‡Captura un Oso Cardo rabioso vivo y llévaselo a Tharnariun. nnSi no consigues capturar un Oso Cardo rabioso y pierdes la trampa, pídele otra a Tharnariun Espinarbolado.‡Captura un oso cardo rabioso vivo y llévaselo a Tharnariun.|nSi no consigues capturar un oso cardo rabioso y pierdes la trampa, pídele otra a Tharnariun Espinarbolado.‡Capturer vivant un Ours des chardons enragé, puis le ramener à Tharnariun.‡活捉一只狂暴蓟熊，把它带到萨纳瑞恩那里。‡你帶回染病的薊熊了嗎，<name>?|n萬一陷阱失敗了也不用著急─薩納瑞恩的希望是永遠不會破滅的。如果你需要一個新的陷阱，請先放棄你的任務，然後再回來向我報告。',
  }
},
[2138] = {
  {
    'Purificação dos infectados‡Избавление от заразы‡Ausrottung der Infizierten‡병든 엉겅퀴곰 처치‡La limpieza de la infección‡La limpieza de la infección‡Nettoyage de l\'infection‡清除疫病‡清除疫疾',
    nil,
    'Purifique a floresta matando 20 Ursocardos Raivosos e fale novamente com Tharnariun Tratárvore na Costa Negra.‡Очистите лес от 20 бешеных колючешерстных медведей и возвращайтесь к Тарнариуну Исцелителю Деревьев на Темный Берег.‡Befreit den Wald von 20 tollwütigen Distelbären und kehrt dann zu Tharnariun Baumwahrer in Dunkelküste zurück.‡숲에서 광포한 엉겅퀴곰 20마리를 처치한 후 어둠의 해안에 있는 타나리운 트리텐더에게 돌아가야 합니다.‡Libra al bosque de 20 osos Cardo rabiosos y ve a buscar a Tharnariun Espinarbolado a Costa Oscura.‡Libra al bosque de 20 Osos Cardo rabiosos y ve a buscar a Tharnariun Espinarbolado a Costa Oscura.‡Débarrasser la forêt de 20 Ours des chardons enragés et retourner voir Tharnariun Soigneflore, à Sombrivage.‡到森林里去杀掉20头狂暴蓟熊。‡到森林裡去殺掉20隻狂暴薊熊。',
  }
},
[2139] = {
  {
    'Esperança de Tharnariun‡Надежда Тарнариуна‡Tharnariuns Hoffnung‡타나리운의 희망‡La esperanza de Tharnariun‡La esperanza de Tharnariun‡Espoir de Tharnariun‡萨纳瑞恩的希望‡薩納瑞恩的希望',
    nil,
    'Encontre e mate a Matriarca do Covil.‡Найдите и убейте мать-медведицу.‡Sucht und tötet die Höhlenmutter.‡우두머리 엉겅퀴곰을 찾아서 처치해야 합니다.‡Encuentra a la madre del cubil y mátala.‡Encuentra a la madre del cubil y mátala.‡Trouver et tuer la Mère de la tanière.‡找到雌蓟熊，然后杀掉它。‡找到雌薊熊，然後殺掉它。',
  }
},
[2158] = {
  {
    'Repouso e relaxamento‡Отдых и покой‡Ruhe und Entspannung‡평안과 휴식‡Descanso y relajación‡Descanso y relajación‡Repos et détente‡休息和放松‡休息和放鬆',
    nil,
    'Fale com o Estalajadeiro Fábio na Estalagem do Leão Orgulhoso.‡Побеседуйте с Фарли, хозяином "Гордости льва".‡Sprecht im Gasthaus Zur Höhle des Löwen mit Gastwirt Farley.‡사자무리 여관에 있는 여관주인 팔레이와 대화해야 합니다.‡Habla con el tabernero Farley de la Posada Orgullo de León.‡Habla con el tabernero Farley de la Posada Orgullo de León.‡Parler à l\'aubergiste Farley, à l\'auberge de la Fierté du lion.‡和狮王之傲旅店的旅店老板法雷谈一谈。‡和獅王之傲旅店的旅店老闆法雷談話。',
  }
},
[2159] = {
  {
    'Entrega para Dolanaar‡Посылка в Доланаар‡Lieferung für Dolanaar‡돌라나르로의 배달‡Paquete de Dolanaar‡Paquete de Dolanaar‡Livraison à Dolanaar‡多兰纳尔的货物‡多蘭納爾的貨物',
    nil,
    'Leve a Entrega para Dolanaar para o Estalajadeiro Keldamyr.‡Отнесите посылку хозяину таверны Кельдамиру в Доланааре.‡Bringt die Lieferung für Dolanaar zu Gastwirt Keldamyr.‡여관주인 켈다미르에게 돌라나르 배달물을 가져가야 합니다.‡Llévale el paquete de Dolanaar al tabernero Keldamyr.‡Llévale el paquete de Dolanaar al tabernero Keldamyr.‡Apporter la Livraison de Dolanaar à l\'aubergiste Keldamyr.‡把药草送到旅店老板凯达米尔手中。‡把藥草送到旅店老闆凱達米爾手中。',
  }
},
[2160] = {
  {
    'Suprimentos para Tannok‡Припасы для Таннока‡Vorräte für Tannok‡탄노크에게 보급품 전달‡Suministros para Tannok‡Suministros para Tannok‡Des provisions pour Tannok‡塔诺克的补给品‡塔諾克的補給品',
    nil,
    'Entregue um Caixote com Provisões para Estalagem a Tannok Marrãogélido, em Kharanos.‡Отнесите ящик с припасами хозяину таверны Танноку Молоту Стужи в Караносе.‡Bringt die Kiste mit Gasthausvorräten zu Tannok Frosthammer in Kharanos.‡카라노스에 있는 탄노크 프로스트해머에게 여관 보급품 상자를 전해 주어야 합니다.‡Lleva a Kharanos el cajón de suministros del mesón y entrégaselo a Tannok Martilloescarcha.‡Lleva a Kharanos el cajón de suministros del mesón y entrégaselo a Tannok Martilloescarcha.‡Livrer la Caisse de ravitaillement à l\'auberge de Tannok Martel-de-givre à Kharanos.‡给卡拉诺斯的塔诺克·霜锤带去一箱旅店补给品。‡把旅店補給木箱帶給卡拉諾斯的塔諾克·霜錘。',
  }
},
[2161] = {
  {
    'O fardo de um peão‡Ноша батрака‡Die Bürde eines Peons‡일꾼의 짐‡Un cargamento de peón‡Un cargamento de peón‡Un Fardeau de Péon‡苦工的重担‡苦工的重擔',
    nil,
    'Leve o Fardo de Ulkor para o Estalajadeiro Grosk no Monte Navalha.‡Отнесите сумку Укора хозяину таверны Гроску в Колючий Холм.‡Bringt Ukors Bürde zu Gastwirt Grosk in Klingenhügel.‡칼바위 언덕에 있는 여관주인 그로스크에게 우코르의 짐을 가져가야 합니다.‡Lleva la carga de Ukor al tabernero Grosk a Cerrotajo.‡Lleva la carga de Ukor al tabernero Grosk a Cerrotajo.‡Apporter le Fardeau d\'Ukor à l\'aubergiste Grosk à Tranchecolline.‡把乌克尔的货物交给剃刀岭的旅店老板格罗斯克。‡把烏克爾的貨物帶給剃刀嶺的旅館主人格羅斯克。',
  }
},
[2178] = {
  {
    'Moa a quem moer‡Спокойная жизнь долгоногов‡Schreitereintopf‡간단한 타조 요리‡Guiso de zancudo‡Guiso de zancudo‡Brouet de trotteur‡炖陆行鸟‡燉陸行鳥',
    nil,
    'Leve 5 porções de Carne de Moa para Alanndária Noturcanto, em Auberdine.‡Принесите 5 кусков мяса долгонога Аландариан Песне Ночи в Аубердин.‡Bringt 5 Stücke Schreiterfleisch zu Alanndarian Nachtweise in Auberdine.‡아우버다인에 있는 알란다리안 나이트송에게 타조 고기 5개를 가져가야 합니다.‡Llévale 5 piezas de carne de zancudo a Alanndarian Arrullanoche a Auberdine.‡Llévale 5 piezas de carne de zancudo a Alanndarian Arrullanoche a Auberdine.‡Apporter 5 morceaux de Viande de trotteur à Alanndarian Chantenuit, à Auberdine.‡给急弯河的奥兰达利亚·夜歌带回5块陆行鸟肉。‡給急彎河的奧蘭達利亞·夜歌帶回5塊陸行鳥肉。',
  }
},
[2198] = {
  {
    'O colar estilhaçado‡Порванное ожерелье‡Die zerrissene Halskette‡부서진 목걸이‡El collar hecho añicos‡El collar hecho añicos‡Le Collier brisé‡破碎的项链‡破碎的項鍊',
    nil,
    'Procure o criador original do colar estilhaçado para saber sobre seu valor potencial.‡Найдите создателя ожерелья, чтобы узнать, чего оно стоит.‡Sucht nach dem Erschaffer der zerrissenen Halskette, um etwas über ihren möglichen Wert zu erfahren.‡부서진 목걸이의 잠재적 가치를 알아내기 위해 원 제작자를 찾아야 합니다.‡Busca al creador del collar hecho añicos y descubre para qué sirve.‡Busca al creador del collar hecho añicos y descubre para qué sirve.‡Chercher celui qui a fabriqué le Collier brisé pour découvrir sa valeur potentielle.‡找到破碎的项链的来源，从而了解其潜在的价值。‡找到破碎的項鍊的來源，從而瞭解其潛在的價值。',
  }
},
[2199] = {
  {
    'Aí tem truta!‡Мудрость за деньги‡Lehren haben ihren Preis‡정보의 대가‡Esa información tiene un precio‡Esa información tiene un precio‡Le Prix de la Connaissance‡昂贵的知识‡昂貴的知識',
    nil,
    'Leve cinco barras de prata para Didiê Du Mocó em Altaforja.‡Принесите пять серебряных слитков Талвашу де Кисселю в Стальгорн.‡Bringt fünf Silberbarren zu Talvash del Kissel in Eisenschmiede.‡아이언포지에 있는 탈바쉬 델 키젤에게 은괴 5개를 가져가야 합니다.‡Lleva 5 lingotes de plata a Talvash del Kissel a Forjaz.‡Lleva cinco lingotes de plata a Talvash del Kissel a Forjaz.‡Apporter 5 Barres d\'Argent à Talvash del Kissel, à Forgefer.‡给铁炉堡的塔瓦斯德·基瑟尔带去五块银锭。‡給鐵爐堡的塔瓦斯德·基瑟爾帶去五塊銀錠。',
  }
},
[2200] = {
  {
    'De volta a Uldaman‡Назад в Ульдаман‡Rückkehr nach Uldaman‡울다만으로 돌아가기‡El regreso a Uldaman‡El regreso a Uldaman‡Retour à Uldaman‡回到奥达曼‡回到奧達曼',
    nil,
    'Procure pistas sobre disposição atual do colar de Didiê dentro de Uldaman. O paladino morto que ele mencionou foi a última pessoa a portá-lo.‡Выясните, где именно в Ульдамане находится ожерелье Талваша. Убитый паладин, о котором он упоминал, был последним владельцем этого ожерелья.‡Sucht in Uldaman nach Hinweisen auf den momentanen Zustand von Talvashs Halskette. Der getötete Paladin, den Talvash erwähnte, hatte die Kette zuletzt.‡울다만 안에서 탈바쉬의 목걸이의 행방에 대한 단서를 찾아야 합니다. 탈바쉬가 말했던 성기사가 그 단서를 가진 최후의 인물일 것입니다.‡Busca pistas sobre el paradero del collar de Talvash en Uldaman. Dijo que un paladín muerto fue su último dueño.‡Busca pistas sobre el paradero del collar de Talvash en Uldaman. Dijo que un paladín muerto fue su último dueño.‡Chercher des indices sur le Collier de Talvash à Uldaman. Le paladin dont il a parlé est la dernière personne à l\'avoir porté.‡去奥达曼寻找塔瓦斯的魔法项链，被杀的圣骑士是最后一个拿着它的人。‡去奧達曼尋找塔瓦斯的魔法項鍊，被殺的聖騎士是最後一個拿著它的人。',
  }
},
[2201] = {
  {
    'Encontre as gemas‡Время собирать камни‡Suche nach den Edelsteinen‡보석 찾기‡Encuentra las gemas‡Encuentra las gemas‡Trouver les Gemmes‡寻找宝石‡',
    nil,
    'Encontre o rubi, a safira e o topázio que foram espalhados por toda Uldaman. Uma vez adquiridos, entre em contato com Didiê Du Mocó remotamente, usando o Frasco de Vidência que ele lhe deu.nnDe acordo com o diário...n* O rubi está escondido em uma área barricada de Umbraforja.n* O topázio está escondido numa urna em uma das áreas dos troggs, perto dos anões da Aliança.nn* A safira foi reivindicada por Grimlok, o líder dos troggs.‡Найдите рубин, сапфир, и топаз, которые спрятаны в разных местах Ульдамана. Когда найдете, свяжитесь с Талвашем де Кисселем, используя фиал Видения, который он предоставил.nnИз дневника вы узнали следующее:n*Рубин укрыт в забаррикадированной Кузне Теней.n*Топаз спрятан в урне в одной из областей, занятых троггами, недалеко от расположения дворфов Альянса.nn*Сапфир присвоил себе Гримлок, лидер троггов.‡Findet den Rubin, den Saphir und den Topas, die in ganz Uldaman verstreut sind. Wenn Ihr sie habt, wendet Euch aus der Ferne an Talvash del Kissel, indem Ihr die Wahrsagephiole nutzt, die er Euch zuvor gegeben hat.nnAus dem Tagebuch, wisst Ihr...n* Der Rubin wurde in einer Bastion der Zwerge der Schattenschmiede versteckt.n* Der Topas steckt in einer Urne in einem der Trogggebiete, in der Nähe einiger Zwerge der Allianz.nn* Der Saphir wurde von Grimlok, dem Anführer der Troggs, mitgenommen.‡울다만에 흩어져 있는 루비, 사파이어, 토파즈를 찾아야 합니다. 모두 찾으면 탈바쉬가 준 수정점 유리병을 사용하여 그에게 연락해야 합니다.nn일지에 의하면... n*루비는 어둠괴철로단 드워프들이 있는 지역에 숨겨져 있습니다.n*토파즈는 얼라이언스 드워프들이 있는 곳 근처에 트로그 지역에 있는 항아리 중 하나에 숨겨져 있습니다.nn*사파이어는 트로그 대장인 그림로크가 가지고 있습니다.‡Encuentra el rubí, el zafiro y el topacio que están desperdigados por Uldaman. Cuando los tengas, contacta con Talvash del Kissel mediante la ampolla de adivinación que él te dio.nnA través del diario, sabes que...n*El rubí está escondido en una zona de Forjatiniebla con barricadas.n*El topacio permanece oculto en una urna en una de las zonas de los troggs, cerca de algunos enanos de la Alianza.nn*El zafiro obra en poder de Grimlok, el líder de los enanos, según él mismo afirma.‡Encuentra el rubí, el zafiro y el topacio que están desperdigados por Uldaman. Cuando los tengas, contacta con Talvash del Kissel mediante la ampolla de adivinación que él te dio.|nA través del diario, sabes que...|n*El rubí está escondido en una zona de Forjatiniebla con barricadas.|n*El topacio permanece oculto en una urna en una de las zonas de los troggs, cerca de algunos enanos de la Alianza.|n*El zafiro obra en poder de Grimlok, el líder de los troggs, según él mismo afirma.‡Trouvez le rubis, le saphir et la topaze qui sont éparpillés à travers Uldaman. Une fois que vous les aurez, contactez Talvash del Kissel en utilisant la Fiole de divination qu’il vous a donnée précédemment.nnC\'est dans le journal, vous savez...n* Le rubis a été caché dans une zone barricadée des Ombreforge.n* La topaze a été dissimulée dans une urne, dans l’une des zones trogg, pas très loin de nains de Alliance.n* Le saphir est en possession du chef trogg, Grimlok.‡在奥达曼寻找红宝石、蓝宝石和黄宝石的下落。找到它们之后，通过塔瓦斯德给你的占卜之瓶和他进行联系。‡',
  }
},
[2202] = {
  {
    'Busca pelos reagentes de Uldaman‡В Ульдаман за реактивом‡Reagenzsuche in Uldaman‡울다만에서 재료 찾기‡Componentes de Uldaman‡Componentes de Uldaman‡Rechercher les composants à Uldaman‡奥达曼的蘑菇‡奧達曼的蘑菇',
    nil,
    'Leve 12 Campânulas de Fungo Magenta para Jarkal Limuno em Karrath.‡Принести 12 грибов-малиновиков Джаркалу Замшелому Клыку в Каргат.‡Bringt 12 magenta Funguskappen nach Kargath zu Jarkal Moosblut.‡카르가스에 있는 자칼 모스멜드에게 자홍버섯 12개를 가져가야 합니다.‡Llévale 12 setas magenta a Jarkal Musgofusión en Kargath.‡Llévale 12 setas magenta a Jarkal Musgofusión en Kargath.‡Apporter 12 Champignons magenta à Jarkal Fondemousse à Kargath.‡收集12颗紫色蘑菇，把它们交给卡加斯的加卡尔。‡收集12顆紫色蘑菇，把它們交給卡加斯的加卡爾。',
  }
},
[2203] = {
  {
    'Busca pelos reagentes dos Ermos Parte II‡Пробежка по Бесплодным землям-2‡Reagenziensuche im Ödland II‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas II‡Componentes de Tierras Inhóspitas II‡Les réactifs des Terres ingrates II‡荒芜之地的试剂 II‡',
    nil,
    'Use os recipientes de taumaturgia vazios em dragões guardiões calcinados encontrados nos Ermos. Quando enchê-los, leve-os para Jarkal Limuno em Karrath.‡Наполните пустые волшебные сосуды кровью опаленных драконов-стражей в Бесплодных землях и принесите их Джаркалу Замшелому Клыку в Каргат.‡Benutzt die leeren thaumaturgischen Gefäße bei versengten Wächtergroßdrachen im Ödland. Wenn Ihr sie gefüllt habt, bringt sie zu Jarkal Moosblut in Kargath.‡빈 요술 유리병을 황야의 땅에 있는 화염의 수호비룡에게 사용해야 합니다. 세 개를 다 채우면 카르가스에 있는 자칼 모스멜드에게 가져가야 합니다.‡Usa las vasijas de taumaturgia vacías con los dragones guardianes agostados de las Tierras Inhóspitas. Cuando las hayas llenado, llévaselas a Jarkal Musgofusión en Kargath.‡Usa las vasijas de taumaturgia vacías con los dragones guardianes agostados de las Tierras Inhóspitas. Cuando las hayas llenado, llévaselas a Jarkal Musgofusión en Kargath.‡Utiliser les 3 Récipients thaumaturgiques vides sur des dragons gardiens des terres brûlées dans les Terres ingrates. Une fois remplis, les rapporter à Jarkal Fondemousse à Kargath.‡用空的魔瓶吸收荒芜之地的烈焰守护者的血液。装满所有瓶子之后，把它们交给卡加斯的加卡尔。‡',
  }
},
[2204] = {
  {
    'Restaurando o colar‡Восстановление ожерелье‡Restaurierung der Halskette‡목걸이 복원‡Restaurar el collar‡Restaurar el collar‡Réparer le Collier‡修复项链‡修復項鍊',
    nil,
    'Obtenha uma fonte de energia do constructo mais poderoso que você encontrar em Uldaman e entregue-a a Didiê Du Mocó em Altaforja.‡Добудьте источник энергии из самого мощного волшебного создания, которое найдете в Ульдамане и доставьте его Талвашу де Кисселю в Стальгорн.‡Besorgt Euch eine Kraftquelle vom mächtigsten Konstrukt, das Ihr in Uldaman finden könnt, und liefert sie bei Talvash del Kissel in Eisenschmiede ab.‡울다만에서 가장 강력한 피조물을 찾아 부서진 목걸이의 마력원천을 손에 넣은 다음, 아이언포지에 있는 탈바쉬 델 키젤에게 목걸이와 함께 가져가야 합니다.‡Obtén una fuente de energía del constructo más poderoso que encuentres en Uldaman, y entrégasela a Talvash del Kissel en Forjaz.‡Obtén una fuente de energía del ensamblaje más poderoso que encuentres en Uldaman, y entrégasela a Talvash del Kissel en Forjaz.‡Obtenir une Source d\'énergie de la construction la plus puissante que vous pouvez trouver à Uldaman, puis la remettre à Talvash del Kissel à Ironforge.‡从奥达曼最强大的石人身上获得能量源，然后将其交给铁炉堡的塔瓦斯德。‡從奧達曼最強大的石人身上獲得能量源，然後將其交給鐵爐堡的塔瓦斯德。',
  }
},
[2205] = {
  {
    'Em busca da AVIN‡Выход на ШРУ‡Aufsuchen des SI: 7‡SI: 7 찾기‡Busca el SI: 7‡Busca el IV:7‡Chercher le SI:7‡军情七处‡尋找軍情七處',
    nil,
    'Entregue o pacote de Anabela Cabreira para o mestre Mathias Shaw nos Quartel de Ventobravo.‡Доставьте пакет от Керина Сильвиуса мастеру Матиасу Шоу в казармы Штормграда.‡Liefert Keryn Sylvius\' Päckchen an Meister Mathias Shaw in der Kaserne von Sturmwind.‡스톰윈드 병영에 있는 단장 마티아스 쇼에게 소포를 가져가야 합니다.‡Entrega el paquete de Keryn Sylvius al maestro Mathias Shaw que está en el Cuartel de Ventormenta.‡Entrega el paquete de Keryn Sylvius al maestro Mathias Shaw que está en el Cuartel de Ventormenta.‡Remettre le colis de Keryn Sylvius à maître Mathias Shaw à la Caserne de Hurlevent.‡把科瑞恩·塞尔留斯的包裹带给暴风城兵营的马迪亚斯·肖尔。‡把科瑞恩·塞爾留斯的包裹帶給暴風城兵營的馬迪亞斯·肖爾。',
  }
},
[2206] = {
  {
    'O punguista‡Держи-хватай!‡Schneller Eingriff‡선적 일정 입수‡El robo‡El robo‡Effraction‡连偷带抢‡',
    nil,
    'Encontre o Mestre de Doca dos Défias, pegue o Horário de Embarque e entregue-o para o Mestre Mathias Shaw.‡Найдите портового начальника из Братства Справедливости и добудьте расписание поставок для мастера Матиаса Шоу.‡Sucht den Dockmeister der Defias und beschafft den Lieferzeitplan für Meister Mathias Shaw.‡데피아즈단 부두주임에게서 데피아즈단 선적 일정표를 빼앗아 단장 마티아스 쇼에게 가져가야 합니다.‡Encuentra al maestro de embarcadero Defias y recupera el calendario de envíos para el maestro Mathias Shaw.|n‡Encuentra al maestro de embarcadero y recupera el calendario de envíos para el maestro Mathias Shaw.‡Trouver le maître des docks défias et récupérer le programme d\'embarquement, pour le compte de maître Mathias Shaw.‡找到迪菲亚码头主管，从他那里为马迪亚斯·肖尔拿到迪菲亚船运时间表。‡',
  }
},
[2218] = {
  {
    'Estrada para a salvação‡Путь к спасению‡Straße der Rettung‡구원의 길‡El camino hacia la salvación‡El camino hacia la salvación‡La voie du salut‡救赎之路‡',
    nil,
    'Fale com Hulfdan Barbanegra em Altaforja.‡Поговорите с Хальфданом Чернобородом в Стальгорне.‡Sprecht mit Hulfdan Schwarzbart in Eisenschmiede.‡아이언포지에 있는 훌프단 블랙비어드와 대화하십시오.‡Ve a Forjaz y habla con Hulfdan Barbanegra.‡Ve a Forjaz y habla con Hulfdan Barbanegra.‡Parler à Hulfdan Barbe-noire à Forgefer.‡和铁炉堡的霍夫丹·黑须谈一谈。‡',
  }
},
[2238] = {
  {
    'Simples subterfúgio‡Простая уловка‡Einfache List‡순진한 핑계‡Un simple subterfugio‡Un simple subterfugio‡Simple subterfuge‡国王的财宝‡國王的財寶',
    nil,
    'Encontre Onin MacHammar em Gnomeregan.‡Найдите Онина Макмолота в Гномрегане.‡Sucht Onin MacHammar bei Gnomeregan.‡놈리건에서 오닌 맥해머를 찾아야 합니다.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Encuentra a Onin MacHammar cerca de Gnomeregan.‡Trouver Onin MacHammar à Gnomeregan.‡在诺莫瑞根附近找到奥宁·雨锤。‡在諾姆瑞根附近找到奧寧·雨錘。',
  }
},
[2239] = {
  {
    'Relatório de Onin‡Донесение Онина‡Onins Bericht‡오닌의 보고서‡El informe de Onin‡El informe de Onin‡Rapport d\'Onin‡奥宁的报告‡奧寧的報告',
    nil,
    'Leve o relatório de Onin para Hulfdan em Altaforja.‡Доставьте донесение Онина Хальфдану в Стальгорн.‡Bringt Onins Bericht zu Hulfdan in Eisenschmiede.‡아이언포지에 있는 훌프단에게 오닌의 보고서를 가져가야 합니다.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Lleva el informe de Onin a Hulfdan a Forjaz.‡Porter le rapport d\'Onin à Hulfdan à Forgefer.‡把奥宁的报告交给铁炉堡的霍夫丹。‡',
  }
},
[2240] = {
  {
    'A câmara oculta‡Потайной чертог‡Die geheime Kammer‡비밀 석실‡La cámara oculta‡La cámara oculta‡La Chambre secrète‡密室‡密室',
    nil,
    'Leia o Diário de Baelog, explore a câmara oculta, depois fale com o Prospector Lançatroz.‡Прочитайте журнал Балеога, исследуйте, потайной чертог и потом доложите об увиденном геологу Грозовой Вершине.‡Lest Baelogs Tagebuch, erforscht die geheime Kammer und erstattet dann Ausgrabungsleiter Sturmlanze Bericht.‡밸로그의 일지를 읽고 비밀 석실을 조사한 후 발굴조사단장 스톰파이크에게 보고해야 합니다.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lee el diario de Baelog, inspecciona la cámara oculta y ve a informar al prospector Pico Tormenta.‡Lire le journal de Baelog, explorer la Chambre secrète, puis rendre compte au Prospecteur Foudrepique.‡阅读巴尔洛戈的日记，探索密室，然后向铁炉堡的勘察员塔伯斯·雷矛汇报。‡閱讀巴爾洛戈的日記，探索密室，然後向鐵爐堡的勘察員塔伯斯·雷矛彙報。',
  }
},
[2241] = {
  {
    'Amor só dura em liberdade‡Катись, яблочко...‡Der Apfel fällt‡짝사랑‡Cuando cae la manzana‡Cuando cae la manzana‡Pomme d\'amour‡詹诺克的花‡詹諾克的花',
    nil,
    'Leve a flor de Jannok para Syurna em Darnassus.‡Отнесите розу Джаннока Сиарне в Дарнасс.‡Bringt Jannoks Rose zu Syurna in Darnassus.‡다르나서스에 있는 시우르나에게 잔노크의 장미를 가져가야 합니다.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Llévale la rosa de Jannok a Syurna, que está en Darnassus.‡Porter la Rose de Jannok à Syurna à Darnassus.‡把詹诺克的玫瑰带给达纳苏斯的塞尤娜。‡把詹諾克的玫瑰帶給達納蘇斯的塞尤娜。',
  }
},
[2242] = {
  {
    'O destino chama‡Зов судьбы‡Das Schicksal ruft‡운명의 부름‡La llamada del destino‡La llamada del destino‡L\'appel du destin‡命运的召唤‡',
    nil,
    'Encontre Sethir, o Antigo, e leve qualquer pista a respeito de Syurna.‡Найдите Сетира Древнего и принесите все, что сумеете найти, Сиарне.‡Sucht Sethir den Uralten und bringt alle Hinweise, die Ihr finden könnt, zu Syurna.‡고대정령 세시르를 찾아 시우르나에게 가져갈 만한 어떤 단서든지 찾아와야 합니다.‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.|n‡Encuentra a Sethir el Ancestro y ve a contarle todo lo que descubras a Syurna.‡Trouver Sethir l\'Ancien et rapporter tout indice découvert à Syurna.‡找到远古的塞希尔，带回任何你可能发现的线索。‡',
  }
},
[2258] = {
  {
    'Busca pelos reagentes dos Ermos‡Пробежка по Бесплодным землям‡Reagenziensuche im Ödland‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas‡Componentes de Tierras Inhóspitas‡Les réactifs des Terres ingrates‡荒芜之地的试剂‡荒蕪之地的試劑',
    nil,
    'Leve 5 Moelas de Urubu, 10 Presas de Coiote do Rochedo e 5 Estilhaços de Elemental da Rocha para Jarkal Limuno em Karrath, Ermos.‡Принесите 5 вторых желудков канюка, 10 клыков скального койота и 5 осколков каменных элементалей Джаркалу Смешанному Лишайнику в Каргат.‡Bringt Jarkal Moosblut in Kargath im Ödland 5 Bussardmuskelmägen, 10 Klippenkojotenfangzähne und 5 Felselementarsplitter.‡황야의 땅에서 자칼 모스멜드에게 대머리수리 모래주머니 5개, 바위산코요테 송곳니 10개, 바위 정령 파편 5개를 가져가야 합니다.‡Llévale 5 mollejas de águila ratonera, 10 colmillos de coyote del risco y 5 fragmentos de elemental de roca a Jarkal Musgofusión en Kargath, en las Tierras Inhóspitas.‡Llévale 5 mollejas de águila ratonera, 10 colmillos de coyote del risco y 5 fragmentos de elemental de roca a Jarkal Musgofusión en Kargath, en las Tierras Inhóspitas.‡Apporter 5 Gésiers de busard, 10 Crocs de coyote des rochers et 5 Fragments d\'élémentaire de roche à Jarkal Fondemousse, à Kargath, dans les Terres ingrates.‡前往荒芜之地取回加卡尔需要的试剂，然后回到卡加斯把试剂交给他。‡將5個禿鷲的胃囊，10顆峭壁山狗的牙齒，還有5個石元素的裂片交給荒蕪之地，卡加斯的加卡爾。',
  }
},
[2259] = {
  {
    'Erion Umbrurmúrio‡Эрион Шепот Тени‡Erion Schattenflüsterer‡에리온 셰이드위스퍼‡Erion Sombrusurro‡Erion Sombrusurro‡Erion Murmombre‡艾瑞安·影语‡艾里安·影語',
    nil,
    'Fale com Erion Umbrurmúrio em Darnassus.‡Встретьтесь в Дарнассе с Эрионом Шепотом Тени.‡Kontaktiert Erion Schattenflüsterer in Darnassus.‡다르나서스에 있는 에리온 셰이드위스퍼를 만나야 합니다.‡Localiza a Erion Sombrusurro en Darnassus.|n‡Localiza a Erion Sombrusurro en Darnassus.‡Contacter Erion Murmombre à Darnassus.‡与达那苏斯的艾瑞安·影语取得联系。‡與達納蘇斯的艾里安·影語取得聯繫。',
  }
},
[2260] = {
  {
    'A mando de Erion‡Директива Эриона‡Erions Befehl‡에리온의 부탁‡La orden de Erion‡La orden de Erion‡L\'ordre d\'Erion‡艾瑞安的命令‡艾里安的命令',
    nil,
    'Vá para Ventobravo e procure o conselho de Renzik, "O Bicudo".‡Отправляйтесь в Штормград и посоветуйтесь с Рензиком Ножом.‡Reist zur Stadt Sturmwind und meldet Euch bei Renzik "Das Messer".‡스톰윈드로 가서 칼잡이 렌직에게 조언을 구해야 합니다.‡Viaja a la Ciudad de Ventormenta y habla con Renzik "Renzik "Chafarote".‡Viaja a la Ciudad de Ventormenta y habla con Renzik "Chafarote".‡Voyager vers Hurlevent pour y rencontrer Renzik "le Kriss".‡到暴风城去找到"剃刀"雷吉克。‡到暴風城去找到「剃刃」雷吉克。',
  }
},
[2278] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Fale com o vigia de pedra e descubra quais são os segredos da história antiga que ele guarda. Após aprender os segredos históricos, ative os Discos de Norgannon.‡Поговорите с каменным Стражем и запомните все, что он передаст вам. Когда он закончит свой пересказ событий древности, активируйте диски Норганнона.‡Sprecht mit dem Steinbehüter und findet heraus, welche uralten Lehren er aufbewahrt. Sobald Ihr alles erfahren habt, was er weiß, aktiviert die Scheiben von Norgannon.‡바위감시자와 대화하고 그가 알고 있는 고대의 지식을 배우십시오. 지식을 배운 후에는 노르간논의 원반을 가동하십시오.‡Habla con el vigía de piedra y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Habla con el vigía de piedra y descubre qué conocimiento antiguo alberga. Cuando hayas adquirido el conocimiento que te ofrece, activa los Discos de Norgannon.‡Parler au Gardien des pierres pour connaître le Savoir qu\'il défend. Une fois découvert ce qu\'ils peuvent offrir, activer les Disques de Norgannon.‡和石头守护者交谈，从他那里了解更多古代的知识。一旦你了解到了所有的内容之后就激活诺甘农圆盘。‡和石頭守護者交談，從他那裡瞭解更多古代的知識。一旦你瞭解到了所有的內容之後就啟動諾甘農圓盤。',
  }
},
[2279] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para a Liga dos Exploradores em Altaforja.‡Отнесите миниатюрную копию дисков Норганнона в Лигу исследователей в Стальгорне.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zur Forscherliga nach Eisenschmiede.‡아이언포지에 있는 탐험가 연맹에 노르간논의 소형 백금 원반을 가져가야 합니다.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Lleva la reproducción en miniatura de los Discos de Norgannon a la Liga de Expedicionarios de Forjaz.‡Apporter la version miniature des Disques de Norgannon à la Ligue des Explorateurs à Forgefer.‡把迷你版的诺甘农圆盘带到铁炉堡的探险者协会去。‡把迷你版的諾甘農圓盤帶到鐵爐堡的探險者協會去。',
  }
},
[2280] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve a versão em miniatura dos Discos de Norgannon para algum dos sábios no Penhasco do Trovão.‡Отнесите миниатюрную копию дисков Норганнона кому-то из мудрецов с Громового Утеса.‡Bringt die Miniaturausgabe der Scheiben von Norgannon zu einem der Weisen von Donnerfels.‡썬더 블러프에 있는 현자 중 하나에게 노르간논의 소형 원반을 가져가야 합니다.‡Lleva la reproducción en miniatura de los Discos de Norgannon a uno de los sabios de Cima del Trueno.‡Lleva la reproducción en miniatura de los Discos de Norgannon a alguien que esté muy interesado.‡Apporter la version miniature des Disques de Norgannon à l\'un des Sages de Thunder Bluff.‡把迷你版的诺甘农圆盘带到雷霆崖的贤者那里。‡把迷你版的諾甘農圓盤帶到雷霆崖的賢者那裡。',
  }
},
[2281] = {
  {
    'Encontro em Cristarrubra‡Встречи в Красногорье‡Rendezvous im Rotkammgebirge‡붉은마루 집결‡Cita en Crestagrana‡Cita en Crestagrana‡Le Rendez-vous des Carmines‡赤脊山的联络员‡赤脊山的聯絡員',
    nil,
    'Vá até a Vila Plácida, nas Montanhas Cristarrubra, e fale com Lucius.‡Отправляйтесь в Приозерье, что в Красногорье, и поговорите с Люцием.‡Geht nach Seenhain im Rotkammgebirge und sprecht mit Lucius.‡붉은마루 산맥의 레이크샤이어로 가서 루시우스와 대화해야 합니다.‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.|n‡Adéntrate en Villa del Lago, en las Montañas Crestagrana, y habla con Lucius.‡S\'aventurer vers Comté-du-lac dans les Carmines et parler à Lucius.‡到赤脊山的湖畔镇去和卢修斯谈一谈。‡到赤脊山的湖畔鎮去和盧修斯談話。',
  }
},
[2282] = {
  {
    'Serraria Alther‡Лесопилка Альтера‡Althers Mühle‡앨더의 제재소‡Molino de Alther‡Molino de Alther‡La scierie d\'Alther‡奥瑟尔伐木场‡奧瑟爾伐木場',
    nil,
    'Abra o Baú do Lucius, recupere o Símbolo de Ladroagem e devolva-o ao Lucius na Vila Plácida.‡Откройте сундук Люция, достаньте руну воровства и вернитесь к Люцию в Приозерье.‡Öffnet Lucius\' Schließkassette, nehmt die Marke der Diebeskunst heraus und bringt sie zu Lucius nach Seenhain.‡루시우스의 금고를 열고 도적의 징표를 회수한 다음 레이크샤이어에 있는 루시우스에게 가져가야 합니다.‡Abre el arcón de Lucius y llévale la muestra de robo a Villa del Lago.‡Abre la caja fuerte de Lucius y llévale la muestra de robo a Villa del Lago.‡Ouvrir le Coffret de Lucius, récupérer le Gage de voleur et le rapporter à Lucius à Comté-du-lac.‡打开卢修斯的箱子，拿到偷窃技能证明物，然后把它归还给湖畔镇的卢修斯。‡打開盧修斯的帶鎖箱，拿到偷竊技能證明物，然後把它歸還給湖畔鎮的盧修斯。',
  }
},
[2283] = {
  {
    'O resgate do colar‡Пропавшее ожерелье‡Wiederbeschaffung der Halskette‡목걸이 회수‡La recuperación del collar‡La recuperación del collar‡Réparer le Collier‡搜寻项链‡搜尋項鍊',
    nil,
    'Procure um colar valioso na escavação de Uldaman e leve-o para Dran Droffers em Orgrimmar. O colar pode estar danificado.‡Найдите на раскопках Ульдамана драгоценное ожерелье (возможно, поврежденное) и принесите его в Оргриммар Драну Дрофферсу.‡Sucht in der Grabungsstätte von Uldaman nach einer wertvollen Halskette und bringt sie nach Orgrimmar zu Dran Droffers. Die Halskette ist vielleicht beschädigt.‡울다만 발굴 현장에서 값진 목걸이를 찾아 오그리마에 있는 드란 드로퍼스에게 가져다주어야 합니다. 목걸이는 파손된 것이라도 괜찮습니다.‡Busca el collar en la excavación de Uldaman y llévaselo a Dran Droffers a Orgrimmar. Puede que el collar esté estropeado.‡Busca el collar en la excavación de Uldaman y llévaselo a Dran Droffers a Orgrimmar. Puede que el collar esté estropeado.‡Rechercher dans l\'excavation d\'Uldaman un Collier de prix et le rapporter à Dran Droffers à Orgrimmar. Ce Collier peut être endommagé.‡在奥达曼挖掘场中寻找一条珍贵的项链，然后将其交给奥格瑞玛的德兰·杜佛斯。项链有可能已经损坏。‡在奧達曼挖掘場中尋找一條珍貴的項鍊，然後將其交給奧格瑪的德蘭·杜佛斯。項鍊有可能已經損壞。',
  }
},
[2284] = {
  {
    'O resgate do colar 2 – A missão‡Пропавшее ожерелье, этап 2‡Wiederbeschaffung der Halskette, Teil 2‡목걸이 회수 - 2차 시도‡La recuperación del collar, 2ª parte‡La recuperación del collar, 2ª parte‡Réparer le Collier, deuxième prise‡搜寻项链，再来一次‡搜尋項鍊，再來一次',
    nil,
    'Encontre uma pista do paradeiro das gemas nas profundezas de Uldaman.‡Разыщите ключ к местонахождению самоцветов в глубинах Ульдамана.‡Sucht in den Tiefen von Uldaman nach einem Hinweis auf den Verbleib der Edelsteine.‡울다만 깊은 곳에서 보석의 행방에 대한 단서를 찾아야 합니다.‡Busca pistas sobre el paradero de las gemas en las profundidades de Uldaman.‡Busca pistas sobre el paradero de las gemas en las profundidades de Uldaman.‡Trouver, dans les profondeurs d\'Uldaman, des indices sur la localisation des Gemmes.‡在奥达曼里找寻宝石的线索。‡在奧達曼裡找尋寶石的線索。',
  }
},
[2298] = {
  {
    'Aperto régio‡Королевская облава‡Königliche Erpressung‡왕의 철저한 수색‡Una regia sacudida‡Una regia sacudida‡Kingly Shakedown‡国王的搜查‡國王的搜查',
    nil,
    'Viaje para Ventobravo e procure Renzik, "O Bicudo".‡Отправляйтесь в Штормград и найдите Рензика Ножа.‡Reist nach Sturmwind und sucht Renzik "Das Messer" auf.‡스톰윈드로 가서 칼잡이 렌직을 찾아야 합니다.‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Aller à Hurlevent et chercher Renzik "le Kriss".‡到暴风城里去找到"剃刀"雷吉克。‡到暴風城裡去找到「剃刃」雷吉克。',
  }
},
[2299] = {
  {
    'Ao Hulfdan!‡К Хальфдану!‡Auf Hulfdan!‡훌프단에게로!‡¡Ve a hablar con Hulfdan!‡¡Ve a hablar con Hulfdan!‡Cap sur Hulfdan !‡去找霍夫丹！‡去找霍夫丹!',
    nil,
    'Vá até Altaforja e fale com Hulfdan Barbanegra.‡Отправляйтесь в Стальгорн и поговорите с Хальфданом Чернобородом.‡Reist nach Eisenschmiede und sprecht mit Hulfdan Schwarzbart.‡아이언포지로 가서 훌프단 블랙비어드와 대화하십시오.‡Viaja a Forjaz y habla con Hulfdan Barbanegra.‡Viaja a Forjaz y habla con Hulfdan Barbanegra.‡Se rendre à Forgefer et parler à Hulfdan Barbe-noire.‡到铁炉堡去和霍夫丹·黑须谈一谈。‡到鐵爐堡去和霍夫丹·黑鬚談話。',
  }
},
[2300] = {
  {
    'AVIN‡ШРУ‡Der SI:7‡SI:7‡IV:7‡IV:7‡SI:7‡军情七处‡軍情七處',
    nil,
    'Viaje para Ventobravo e procure Renzik, "O Bicudo".‡Отправляйтесь в Штормград и разыщите Рензика Ножа.‡Reist nach Sturmwind und sucht Renzik "Das Messer" auf.‡스톰윈드로 가서 칼잡이 렌직을 찾아야 합니다.‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Viaja a Ventormenta y busca a Renzik "Chafarote".‡Aller à Hurlevent et chercher Renzik "le Kriss".‡到暴风城去找到"剃刀"雷吉克。‡到暴風城去找到「剃刃」雷吉克。',
  }
},
[2318] = {
  {
    'Traduzindo o diário‡Трудности перевода‡Übersetzung des Tagebuchs‡일지 번역‡La traducción del diario‡La traducción del diario‡La Traduction du Journal‡翻译日记‡',
    nil,
    'Encontre alguém que consiga traduzir o diário do paladino. O local mais próximo que pode ter alguém que o faça é Karrath, nos Ermos.‡Найдите кого-нибудь, кто сможет перевести для вас дневник паладина. Ближайший к вам такой умелец, скорее всего, найдется в Каргате, форпосте в Бесплодных Землях.‡Sucht jemanden, der das Tagebuch des Paladins übersetzen kann. Der nächstgelegene Ort, wo Ihr so jemanden finden könntet, ist Kargath im Ödland.‡성기사의 일지를 번역할 수 있는 이를 찾아야 합니다. 그런 자가 있을만한 가장 가까운 곳은 황야의 땅에 있는 카르가스입니다.‡Encuentra a alguien que pueda traducir el diario del paladín. El lugar más cercano en el que podrás encontrar a alguien es Kargath, en las Tierras Inhóspitas.‡Encuentra a alguien que pueda traducir el diario del paladín. El lugar más cercano en el que podrás encontrar a alguien es Kargath, en las Tierras Inhóspitas.‡Trouver quelqu\'un qui puisse traduire le journal du paladin. L\'endroit le plus proche est Kargath, dans les Terres ingrates.‡在荒芜之地的卡加斯哨所里寻找一个可以帮你翻译圣骑士日记的人。‡',
  }
},
[2338] = {
  {
    'Traduzindo o diário‡Трудности перевода‡Übersetzung des Tagebuchs‡일지 번역‡La traducción del diario‡La traducción del diario‡La traduction du Journal‡翻译日记‡',
    nil,
    'Empreste o colar a Jarkal. Em troca, ele vai traduzir o diário para você.‡Одолжите ожерелье Джаркалу. Взамен он переведет дневник.‡Leiht Jarkal die Halskette. Im Gegenzug wird er das Tagebuch für Euch übersetzen.‡자칼에게 목걸이를 빌려주면 그에 대한 보답으로 일지를 번역해 줄 것입니다.‡Préstale el collar a Jarkal. A cambio, te traducirá el diario.‡Préstale el collar a Jarkal. A cambio, te traducirá el diario.‡Laisser Jarkal emprunter le Collier en échange de la traduction du Journal.‡将项链借给加卡尔。作为交换，他将帮你翻译日记。‡',
  }
},
[2339] = {
  {
    'Encontre as Gemas e a Fonte de Energia‡Найти самоцветы и источник энергии‡Findet die Edelsteine und die Kraftquelle‡보석과 마력원천 찾기‡Encuentra las gemas y la fuente de alimentación‡Encuentra las gemas y la fuente de alimentación‡Trouver les Gemmes et la Source d\'énergie‡寻找宝贝‡尋找寶貝',
    nil,
    'Recupere todas as três gemas e uma fonte de energia para o colar de Uldaman e leve-as para Jarkal Limuno, em Karrath. Jarkal acredita que uma fonte de energia pode ser encontrada no constructo mais forte presente em Uldaman.nnDe acordo com o diário:n* O rubi está escondido em uma área de Umbraforja protegida por barreiras.n* O topázio está escondido numa urna em uma das áreas dos troggs, perto de alguns anões da Aliança.n* A safira foi reclamada por Grimlok, o líder dos troggs.‡Добудьте все три самоцвета и источник энергии для ожерелья из Ульдамана и принесите их Джаркалу Замшелому Клыку в Каргат. Джаркал считает, что источник энергии можно найти у самой сильной твари в Ульдамане. nnИз дневника следует... n* Рубин спрятан на огражденной завалами территории Кузни Теней. n*Топаз спрятан в урне на территорях троггов под боком у дворфов Альянса.n*Сапфир забрал Гримлок, старейшина троггов.‡Beschafft in Uldaman alle drei Edelsteine sowie eine Kraftquelle für die Halskette und bringt sie anschließend zu Jarkal Moosblut nach Kargath. Jarkal glaubt, dass sich eine Kraftquelle vielleicht im stärksten Konstrukt in Uldaman findet.nnAus dem Tagebuch, wisst Ihr...n* Der Rubin wurde in einer Bastion der Zwerge der Schattenschmiede versteckt.n* Der Topas steckt in einer Urne in einem der Trogggebiete, in der Nähe einiger Zwerge der Allianz.n* Der Saphir wurde von Grimlok, dem Anführer der Troggs, mitgenommen.‡울다만에서 목걸이에 필요한 보석 3개와 마력원천을 회수한 후 카르가스에 있는 자칼 모스멜드에게 가져다주어야 합니다. 자칼의 말에 의하면 울다만에서 가장 강한 피조물을 처치하면 마력원천을 얻을 수 있다고 합니다.nn일지의 내용을 보니 루비는 어둠괴철로단의 방어진에 숨겨져 있습니다.nn토파즈는 얼라이언스 드워프 근처에 있는 트로그 구역 중 하나에 있는 항아리에 숨겨져 있습니다.nn사파이어는 트로그의 우두머리인 그림로크가 가지고 있습니다.nn마력원천은 울다만에서 가장 강한 피조물을 처치하면 얻을 수 있습니다.‡Recupera las 3 gemas y una fuente de energía para el collar de Uldaman y llévalo todo a Jarkal Musgofusión en Kargath. Jarkal cree que es posible que la fuente de energía más poderosa se halle en un constructo de Uldaman.nnPor el diario sabes...n* Que han ocultado el rubí en una zona cerrada con barricadas en Forjatiniebla.n* Que el topacio se ha ocultado en una urna en un área trogg, cerca de los enanos de la Alianza.n* Que Grimlok, el jefe trogg, se ha quedado con el zafiro.‡Recupera las 3 gemas y una fuente de energía para el collar de Uldaman y llévalo todo a Jarkal Musgofusión en Kargath. Jarkal cree que es posible que la fuente de energía más poderosa se halle en un ensamblaje de Uldaman.|nPor el diario sabes...|n* Que han ocultado el rubí en una zona cerrada con barricadas en Forjatiniebla.|n* Que el topacio se ha ocultado en una urna en un área trogg, cerca de los enanos de la Alianza.|n* Que Grimlok, el jefe trogg, se ha quedado con el zafiro.‡Récupérer, dans Uldaman, les trois gemmes et une source d\'énergie pour le collier, puis les rapporter à Jarkal Fondemousse, à Kargath. Jarkal pense que vous pouvez trouver une source d\'énergie sur la machine la plus puissante d\'Uldaman.nnC\'est dans le journal, vous savez...n* Le rubis a été caché dans une zone barricadée des Ombreforge.n* La topaze a été dissimulée dans une urne, dans l\'une des zones trogg, pas très loin de nains de Alliance.n* Le saphir est possession du chef trogg, Grimelok.‡从奥达曼找回项链上的所有三块宝石和能量源，然后把它们交给卡加斯的加卡尔。nn红宝石被藏在暗影矮人层层设防的地区。nn黄宝石藏在石腭怪活动地区的一个瓮中。nn蓝宝石在格瑞姆洛克手中，他是石腭怪的领袖。nn能量源可能在奥达曼的某个最强生物的手中。‡從奧達曼找回項鍊上的所有三塊寶石和能量源，然後把它們交給卡加斯的加卡爾。|n紅寶石被藏在暗影矮人層層設防的地區。|n黃寶石藏在石齶怪活動地區的一個甕中。|n藍寶石在格瑞姆洛克手中，他是石齶怪的領袖。|n能量源可能在奧達曼的某個最強生物的手中。',
  }
},
[2340] = {
  {
    'Entregue as gemas‡Принести самоцветы‡Ablieferung der Edelsteine‡보석 전달‡Entregar las gemas‡Entregar las gemas‡Livrer les Gemmes‡交付宝石‡',
    nil,
    'Entregue o Colar e Gema Recuperados para Dran Droffers em Orgrimmar.‡Доставьте ожерелье и драгоценности Драну Дрофферсу в Оргриммар.‡Liefert die Halskette und die geborgenen Edelsteine bei Dran Droffers in Orgrimmar ab.‡오그리마에 있는 드란 드로퍼스에게 회수한 목걸이와 보석을 가져다주어야 합니다.‡Entrégale el collar y la gema salvaje a Dran Droffers en Orgrimmar.‡Entrégale el collar y la gema recuperados a Dran Droffers en Orgrimmar.‡Apporter Les gemmes et le collier récupérés à Dran Droffers, à Orgrimmar.‡把项链和宝石送到奥格瑞玛的德兰·杜佛斯那里。‡',
  }
},
[2341] = {
  {
    'O resgate do colar 3 – O Retorno‡Пропавшее ожерелье, этап 3‡Wiederbeschaffung der Halskette, Teil 3‡목걸이 회수 - 3차 시도‡La recuperación del collar, 3ª parte‡La recuperación del collar, 3ª parte‡Réparer le collier, troisième prise‡项链任务的终结‡項鍊任務的終結',
    nil,
    'Visite Jarkal Limuno em Karrath para ver se ele obteve sucesso.‡Навестите Джаркала Замшелого Клыка в Каргате.‡Besucht Jarkal Moosblut in Kargath, um festzustellen, ob er Erfolg gehabt hat.‡카르가스에 있는 자칼 모스멜드를 만나 그의 실험이 성공했는지 알아보십시오.‡Habla con Jarkal Musgofusión en Kargath.‡Habla con Jarkal Musgofusión en Kargath.‡Rendre visite à Jarkal Fondemousse à Kargath pour constater (ou non) son succès.‡去卡加斯看看加卡尔是否成功了。‡去卡加斯看看加卡爾是否成功了。',
  }
},
[2342] = {
  {
    'Tesouros recuperados‡Возвращенные сокровища‡Wiederbeschaffte Schätze‡보물 되찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡寻找宝物‡尋回寶物',
    nil,
    'Pegue o tesouro de Patrício Garreta no baú de sua família, que está no Saguão Sul de Uldaman, e entregue a ele na Cidade Baixa.‡Принесите Патрику Гарретту в Подгород фамильное сокровище из сундука в Южном зале Ульдамана.‡Holt Patrick Garretts Familienschatz aus der Truhe der Familie in der südlichen Bankenhalle von Uldaman und bringt diesen zu ihm nach Unterstadt.‡울다만의 남쪽 대전당에 있는 궤짝에서 가레트가의 보물을 찾아 언더시티에 있는 그에게 가져가야 합니다.‡Coge el tesoro de la familia de Patrick Garrett del cofre de su familia que se encuentra en la Sala Comunal Sur de Uldaman y llévasela a él a Entrañas.‡Coge el tesoro de la familia de Patrick Garrett del cofre de su familia que se encuentra en la Sala Comunal Sur de Uldaman y llévasela a él a Entrañas.‡Rapporter à Patrick Garrett, à Fossoyeuse, son Trésor de famille, qui se trouve dans le Coffre de famille dans les communs du sud d\'Uldaman.‡从奥达曼南部大厅的箱子中找到加勒特的家族宝藏，然后把它交给幽暗城的帕特里克·加瑞特。‡從奧達曼南部大廳的箱子中找到加勒特的家族寶藏，然後把它交給幽暗城的派翠克·加瑞特。',
  }
},
[2358] = {
  {
    'Horns of Nez\'ra‡Рога Незры‡Hörner von Nez\'ra‡네즈라의 뿔‡Cuernos de Nez\'ra‡Cuernos de Nez\'ra‡Cornes de Nez\'ra‡‡',
    nil,
    'Return the Horns of Nez\'ra to Arantir in Lakeshire.‡Верните рога Незры Арантиру в Приозерье.‡Bringt die Hörner von Nez\'ra zu Arantir nach Seenhain.‡호숫골에 있는 아란티르에게 네즈라의 뿔을 돌려줘야 합니다.‡Lleva los Cuernos de Nez\'ra a Arantir a Villa del Lago.‡Lleva los Cuernos de Nez\'ra a Arantir a Villa del Lago.‡Rapporter les Cornes de Nez\'ra à Arantir, à Comté-du-Lac.‡把奈兹拉之角还给在湖畔镇的阿兰提尔之影。‡',
  }
},
[2359] = {
  {
    'Torre do Filipe‡Башня Клейвена‡Klavens Turm‡클라벤의 탑‡La torre de Klaven‡La torre de Klaven‡La Tour de Klaven‡克拉文之塔‡克拉文之塔',
    nil,
    'Roube a chave, entre na Torre Défias e descubra o que tem dentro do Baú da Floresta do Crepúsculo. Leve todas as informações que coletar para Mathias Shaw em Ventobravo. Consulte o Diário de Marta se quiser mais detalhes sobre a torre.‡Добудьте ключ от башни Братства Справедливости, проберитесь в башню и выясните, каково содержимое сундука из Сумеречного леса. Отнесите найденные вещи Матиасу Шоу в Штормград. Почитайте дневник Кирнен, чтобы больше узнать о башне.‡Stehlt den Turmschlüssel der Defias, brecht in den Turm der Defias ein und stellt fest, was sich in der Dämmerwaldtruhe befindet. Bringt Mathias Shaw in Sturmwind dann alle Informationen über das, was Ihr herausgefunden habt. Lest Kearnens Tagebuch, um neue Erkenntnisse über den Turm zu erlangen.‡데피아즈단 탑 열쇠를 훔쳐 데피아즈단 탑으로 숨어 들어간 후, 그늘숲 궤짝에 무엇이 들어 있는지 밝혀 내야 합니다. 알아낸 모든 정보를 가지고 스톰윈드에 있는 마티아스 쇼에게 돌아가야 합니다. 켈넌의 보고서을 읽고 탑에 대한 정보를 얻으십시오.‡Roba la Llave de la Torre Defias, entra en la Torre Defias y descubre qué contiene el Cofre del Bosque del Ocaso. Lleva toda la información que encuentres a Mathias Shaw de Ventormenta. Lee el diario de Kearnen para saber cómo acceder a la torre.‡Roba la Llave de la Torre Defias, entra en la Torre Defias y descubre qué contiene el Cofre del Bosque del Ocaso. Lleva toda la información que encuentres a Mathias Shaw de Ventormenta. Lee el diario de Kearnen para saber cómo acceder a la torre.‡Voler la Clé de la Tour défias, pénétrer dans la Tour et trouver ce que contient le Coffre du bois de la Pénombre. Rapporter les informations à Mathias Shaw à Hurlevent. Lire le journal de Kearnen pour savoir ce qui se passe dans la tour.‡偷取迪菲亚塔楼钥匙，进入迪菲亚塔楼，看看暮色森林的箱子里到底有什么东西，然后向暴风城的马迪亚斯·肖尔汇报。‡偷取迪菲亞塔樓鑰匙，進入迪菲亞塔樓，看看暮色森林的箱子裡到底有什麼東西，然後向暴風城的馬迪亞斯·肖爾彙報。',
  }
},
[2360] = {
  {
    'Mathias e os Défias‡Матиас и Братство Справедливости‡Mathias und die Defias‡마티아스와 데피아즈단‡Mathias y los Defias‡Mathias y los Defias‡Mathias et les Défias‡马迪亚斯和迪菲亚潜行者‡馬迪亞斯和迪菲亞盜賊',
    nil,
    'Viaje para Cerro Oeste e encontre a Agente Marta Hari para receber instruções.‡Найдите посланницу Кеарнен в Западном Крае и поговорите с ней.‡Reist nach Westfall und sucht Agentin Kearnen. Sie wird Euch Bericht erstatten.‡서부 몰락지대로 가서 첩보원 켈넌을 찾아 보고를 받아야 합니다.‡Ve a Páramos de Poniente y encuentra a la agente Kearnen para dar parte.‡Ve a los Páramos de Poniente y encuentra a la agente Kearnen para dar parte.‡Se rendre dans la marche de l\'Ouest et trouver l\'Agent Kearnen pour un débriefing.‡去西部荒野和密探吉尔妮谈一谈。‡去西部荒野和密探吉爾妮談話。',
  }
},
[2361] = {
  {
    'Restaurando o colar‡Восстановление ожерелье‡Restaurierung der Halskette‡목걸이 복원‡Restaurar el collar‡Restaurar el collar‡Réparer le Collier‡修复项链‡修復項鍊',
    nil,
    '‡Я с великой радостью вручаю тебе это ожерелье, могучий |3-6(Жрец). Ты оказал мне неоценимую услугу, и я благодарен тебе за это. Носи же его с гордостью и не забывай при этом все время упоминать о том, кто сделал его для тебя!nnДа, если еще добавишь, что на ожерелье нет проклятия, это будет великолепно.‡Ich gebe Euch diese Halskette gern, <Klasse>. Ihr habt mir einen unschätzbaren Dienst erwiesen und dafür danke ich Euch. Tragt die Kette mit Stolz und vergesst nicht, immer wieder in der gebührenden Lautstärke zu verkünden, wer sie für Euch gemacht hat!nnUnd wenn Ihr auch beiläufig erwähnen könntet, dass die Kette nicht verflucht ist, dann wäre das wirklich wunderbar.‡이 목걸이를 기꺼이 당신에게 주겠소. 당신은 나에게 헤아릴 수 없이 귀중한 일을 해 주었소. 정말 고맙소이다. 자, 자랑스럽게 걸고 다니시오. 그리고 누가 만든 것인지 크게, 그리고 많이 말해 주시오!nn실제로 목걸이가 저주받지 않았다는 사실도 곁들여주면 더 고맙겠군.‡‡‡C\'est avec joie que je vous donne ce collier, <classe>. Vous m\'avez rendu un service inestimable. Portez-le avec fierté et n\'hésitez pas à citer fréquemment et à voix haute le nom du fabriquant ! nnEt si vous pouviez préciser au passage qu\'il n\'est pas maudit, ce serait parfait.‡我很高兴能给你这条项链，强大的<class>。你对我的帮助是无价的，我为此对你表示万分的感谢。请把它戴上吧，这是属于你的荣耀，请在别人问及的时候告诉他们，是我制作了这条项链！nn另外，如果你证明这条项链根本没有受到诅咒，那就更棒了。‡',
  }
},
[2378] = {
  {
    'Encontre a Mão Despedaçada‡Поиски Изувеченной Длани‡Suche nach der Zerschmetterten Hand‡으스러진 손의 일원을 찾아서‡Encuentra a los Mano Destrozada‡Encuentra a los Mano Destrozada‡Trouver la Main brisée‡寻找碎手氏族‡尋找破碎之手氏族',
    nil,
    'Vá até Orgrimmar e fale com Shenthul no Antro das Sombras.‡Отправляйтесь в Оргриммар и поговорите с Шентулом в Расселине Теней.‡Reist nach Orgrimmar und sprecht an der Kluft der Schatten mit Shenthul.‡오그리마로 가서 어둠의 틈에 있는 셴툴과 대화해야 합니다.‡Viaja a Orgrimmar y habla con Shenthul, que estará en el Circo de las Sombras.|n‡Viaja a Orgrimmar y habla con Shenthul, que estará en el Circo de las Sombras.‡Voyager vers Orgrimmar pour y parler à Shenthul, dans la Faille de l\'ombre.‡前往奥格瑞玛，和暗影裂口那的申苏尔谈一谈。‡前往奧格瑪，和暗影裂口那的申蘇爾談話。',
  }
},
[2379] = {
  {
    'Zando\'zan‡Зандо\'зан‡Zando\'zan‡잔도잔‡Zando\'zan‡Zando\'zan‡Zando\'zan‡赞杜沙‡贊杜沙',
    nil,
    'Fale com Zando\'zan no Antro das Sombras.‡Поговорите с Зандо\'заном в расселине Теней.‡Sprecht an der Kluft der Schatten mit Zando\'zan.‡어둠의 틈에 있는 잔도잔과 대화하십시오.‡Habla con Zando\'zan en el Circo de las Sombras.‡Habla con Zando\'zan en el Circo de las Sombras.‡Parler à Zando\'zan à la Faille de l\'ombre.‡与暗影裂口的赞杜沙谈一谈。‡與暗影裂口的贊杜沙談話。',
  }
},
[2380] = {
  {
    'Para Orgrimmar!‡В Оргриммар!‡Nach Orgrimmar!‡오그리마로!‡Ve a Orgrimmar‡Ve a Orgrimmar‡Cap sur Orgrimmar !‡向奥格瑞玛进发！‡向奧格瑪進發!',
    nil,
    'Fale com Shenthul no Antro das Sombras, em Orgrimmar.‡Поговорите с Шентулом в расселине Теней в Оргриммаре.‡Sprecht an der Kluft der Schatten in Orgrimmar mit Shenthul.‡오그리마의 어둠의 틈에 있는 셴툴과 대화하십시오.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Shenthul.‡Ve a Orgrimmar, al Circo de las Sombras, y habla con Shenthul.‡S\'adresser à Shenthul à la Faille de l\'ombre à Orgrimmar.‡在奥格瑞玛城中的暗影裂口和申苏尔谈谈。‡在奧格瑪城中的暗影裂口和申蘇爾談談。',
  }
},
[2381] = {
  {
    'Saqueando os saqueadores‡Грабь награбленное‡Das Ausplündern der Plünderer‡약탈자 약탈하기‡Saquear a los saqueadores‡Saquear a los saqueadores‡Piller les Pilleurs‡抢劫海盗‡搶劫海盜',
    nil,
    'Leve o Tesouro dos Mares do Sul para Wrenix, o Ignóbil, na Vila Catraca. Não se esqueça de pegar um B.E.C.A. e as Ferramentas de Ladrões no Aparato Mercadotrônico do Wrenix. Você precisará desses dois itens para cumprir a missão.nnCaso seja atacado por papagaios nada amigáveis, use o B.E.C.A!‡Принесите Рениксу Презренному из Кабестана сокровище Южного моря. Не забудьте взять из гизмотронного аппарата Реникса ХОЧУ и отмычки. Они понадобятся для выполнения задания.nnЕсли на вас нападут необычайно враждебные попугаи, воспользуйтесь ХОЧУ!‡Bringt den Schatz der Südmeerfreibeuter zu Wrenix dem Jämmerlichen in Ratschet. Vergesst nicht, einen R.C.V.K. und Diebeswerkzeug von Wrenix\' Elektrodingsda-Apparat zu bringen. Ihr werdet diese Dinge brauchen, um Eure Mission zu beenden.nnWenn Ihr von ungewöhnlich feindlichen Papageien angegriffen werdet, benutzt Euren R.C.V.K.!‡톱니항에 있는 비운의 레닉스에게 남쪽바다해적단 보물을 가져가야 합니다. 레닉스의 기계장치에서 E.C.A.C.와 도둑 도구를 얻는 것도 잊지 마십시오. 임무를 완수하려면 이 두 가지가 모두 필요합니다.nn유별나게 공격적인 앵무새와 맞서면 E.C.A.C.를 사용하십시오!‡Llévale el tesoro de los Mares del Sur a Desdio el Desdichado en Trinquete. No olvides conseguir una G.E.A.Q. y herramientas de ladrón del aparato Gizmotrónico de Wrenix. Necesitarás todo eso para completar tu misión.nnSi te atacaran unos loros anormalmente agresivos, ¡usa la G.E.A.Q.!‡Llévale el tesoro de los Mares del Sur a Desdio el Desdichado en Trinquete. No olvides conseguir una G.E.A.Q. y herramientas de ladrones del aparato Gizmotrónico de Wrenix. Necesitarás todo eso para completar tu misión.|nSi te atacaran unos loros anormalmente agresivos, ¡usa la G.E.A.Q.!‡Rapporter le Trésor des Mers du sud à Wrenix le Misérable à Cabestan. Ne pas oublier d\'obtenir un B.G.A.C. et des Outils de voleur de l\'Appareil bidulotronique de Wrenix. Ces deux éléments sont nécessaires pour accomplir la mission.nnEn cas d\'attaque par des perroquets particulièrement hostiles, utiliser le B.G.A.C.!‡把南海宝藏带回给棘齿城的卑鄙的维尼克斯。不要忘了从维尼克斯的机械设备中拿取一份大饼干和潜行者工具，你的任务需要使用这两件东西。nn如果你被任何奇怪的鹦鹉攻击，就对它使用大饼干！‡把南海寶藏帶回給棘齒城的卑鄙的維尼克斯。不要忘了從維尼克斯的機械設備中拿取一份大餅乾和盜賊工具，你的任務需要使用這兩件東西。|n如果你被任何奇怪的鸚鵡攻擊，就對它使用大餅乾!',
  }
},
[2382] = {
  {
    'Wrenix da Vila Catraca‡Реникс из Кабестана‡Wrenix aus Ratschet‡톱니항의 레닉스‡Desdio de Trinquete‡Desdio de Trinquete‡Wrenix de Ratchet‡棘齿城的维尼克斯‡棘齒城的維尼克斯',
    nil,
    'Viaje para a Vila Catraca e fale com Wrenix, o Ignóbil.‡Поговорите с Рениксом Презренным в Кабестане.‡Reist nach Ratschet und sprecht mit Wrenix dem Jämmerlichen.‡톱니항으로 가서 비운의 레닉스와 대화하십시오.‡Ve a Trinquete y habla con Desdio el Desdichado.‡Ve a Trinquete, en Los Baldíos, y habla con Desdio el Desdichado.‡Aller jusqu\'à Cabestan pour voir Wrenix le Misérable.‡到棘齿城去，与卑鄙的维尼克斯谈一谈。‡到棘齒城去，與卑鄙的維尼克斯談話。',
  }
},
[2383] = {
  {
    'Pergaminho simples‡Записка на пергаменте‡Einfaches Pergament‡간결한 양피지‡Papiro simple‡Papiro simple‡Parchemin simple‡简易羊皮纸‡簡易羊皮紙',
    nil,
    'Leia o Pergaminho Simples e fale com Frang no Vale das Provações.‡Прочтите пергамент и поговорите с Франгом в долине Испытаний.‡Lest das einfache Pergament und sprecht mit Frang im Tal der Prüfungen.‡간결한 양피지를 읽어보고 프랑에게 양피지를 가져가야 합니다.‡Lee el papiro simple y habla con Frang en el Valle de los Retos.‡Lee el Pergamino simple y habla con Frang en el Valle de los Retos.‡Lire le Simple parchemin, et parler à Frang, dans la Vallée des épreuves.‡阅读简易羊皮纸，然后和试炼谷的弗郎恩谈一谈。‡',
  }
},
[2398] = {
  {
    'Os anões perdidos‡Потерянные дворфы‡Die verschollenen Zwerge‡길 잃은 드워프‡Los enanos desaparecidos‡Los enanos desaparecidos‡Les nains perdus‡失踪的矮人‡失蹤的矮人',
    nil,
    'Encontre Baelog em Uldaman.‡Найдите Бейлога в Ульдамане.‡Sucht in Uldaman nach Baelog.‡울다만에서 밸로그를 찾아야 합니다.‡Encuentra a Baelog en Uldaman.‡Encuentra a Baelog en Uldaman.‡Trouver Baelog dans Uldaman.‡在奥达曼找到巴尔洛戈。‡在奧達曼找到巴爾洛戈。',
  }
},
[2399] = {
  {
    'As frondes desenvolvidas‡Росток папоротника‡Die sprießenden Wedel‡싹튼 잎‡Flora en brote‡Flora en brote‡Les racines ont poussé‡发芽的树叶‡發芽的樹葉',
    nil,
    '‡Папоротник, который Деналан посадил у себя в саду, проклюнулся и вырос. Ростки так и просят, чтобы их скорее собрали...‡Die Wedel, die Denalan in seinem Garten angepflanzt hat, sind gesprossen und gediehen. Sie zittern leicht, als wollten sie gepflückt werden...‡데날란이 정원에 심은 잎에서 싹이 트고 자랐습니다. 바르르 떠는 모습이 마치 누군가 뽑아주기를 바라고 안달하는 듯 합니다.‡Las hojas que Denalan plantó en su jardín han retoñado y crecido. Esperan con impaciencia a que alguien las coja...‡‡Les racines que Denalan a plantées dans son jardin ont poussé et grandi. Elles tremblent, désireuses d\'être choisies...‡‡',
  }
},
[2418] = {
  {
    'Pedras de energia‡Камни Силы‡Kraftsteine‡마법석‡Las piedras de energía‡Las piedras de energía‡Les pierres de puissance‡能量石‡能量石',
    nil,
    'Leve 8 Pedras de Energia de Dêntrio e 8 Pedras de Energia de An\'Alleum para Bertolezo nos Ermos.‡Принесите 8 дентриевых камней Силы и 8 энелиевых камней Силы Ригглфаззу в Бесплодные земли.‡Bringt Riggelfuzz im Ödland 8 Kraftsteine aus Dentrium und 8 Kraftsteine aus An\'Alleum.‡황야의 땅에 있는 리글퍼즈에게 덴트리움 마법석 8개와 안알레움 마법석 8개를 가져가야 합니다.‡Llévale 8 piedras de energía de dentrio y 8 piedras de energía An\'Alleum a Aparejez en las Tierras Inhóspitas.‡Llévale 8 piedras de energía de dentrio y 8 piedras de energía de An\'Alleum a Aparejez en las Tierras Inhóspitas.‡Apporter 8 Pierres de puissance Dentrium et 8 Pierres de puissance An\'Alleum à Rigglefuzz dans les Terres ingrates.‡给荒芜之地的里格弗兹带去8块德提亚姆能量石和8块安纳洛姆能量石。‡給荒蕪之地的里格弗茲帶去8塊德提亞姆能量石和8塊安納洛姆能量石。',
  }
},
[2438] = {
  {
    'O apanhador de sonhos de esmeralda‡Изумрудный ловец снов‡Der smaragdgrüne Traumfänger‡에메랄드의 꿈 흡입기‡El cazasueños esmeralda‡El atrapasueños esmeralda‡Le Capturêve d\'émeraude‡翡翠摄梦符‡翡翠攝夢符',
    nil,
    'Leve o Apanhador de Sonhos de Esmeralda para Tallonkai Radicélere em Dolanaar.‡Принесите изумрудного ловца снов Таллонкаю Гибкому Корню в Доланаар.‡Bringt den smaragdgrünen Traumfänger zu Tallonkai Flinkwurzel in Dolanaar.‡돌라나르에 있는 탈론카이 스위프트루트에게 에메랄드의 꿈 흡입기를 가져다주어야 합니다.‡Llévale el cazasueños esmeralda a Tallonkai Cruzarraíz, que está en Dolanaar.‡Consigue el atrapasueños esmeralda.‡Apporter le Capturêve d\'émeraude à Tallonkai Viveracine à Dolanaar.‡将翡翠摄梦符交给多兰纳尔的塔隆凯·捷根。‡將翡翠攝夢符交給多蘭納爾的塔隆凱·捷根。',
  }
},
[2439] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve o vale-recompensa para Dinita Itamanto no Cofre de Altaforja.‡Отнесите наградной сертификат Дините Каменной Мантии в хранилище Стальгорна.‡Bringt Euren Belohnungsgutschein zu Dinita Zasterstein im Tresor von Eisenschmiede.‡아이언포지 은행에 있는 디니타 스톤맨틀에게 사례 보증 서류를 가져가야 합니다.‡Lleva tu vale de recompensa a Dinita Mantopétreo, que está en las Arcas de Forjaz.‡Lleva tu vale de recompensa a Dinita Mantopétreo, que está en las Arcas de Forjaz.‡Apporter le Bon de récompense à Dinita Mantepierre à la Chambre forte de Forgefer.‡把你的报酬凭证交给铁炉堡银行的丁尼塔·石衣。‡把你的報酬憑證交給鐵爐堡銀行的丁尼塔·石衣。',
  }
},
[2440] = {
  {
    'Os discos de platina‡Платиновые диски‡Die Platinscheiben‡백금 원반‡Los discos de platino‡Los discos de platino‡Les Disques de platine‡白金圆盘‡白金圓盤',
    nil,
    'Leve o vale-recompensa à Bena Casco Invernal no Penhasco do Trovão.‡Отнесите наградной сертификат Бене Заиндевевшее Копыто в Громовой Утес.‡Bringt den Belohnungsgutschein zu Bena Winterhuf nach Donnerfels.‡썬더 블러프에 있는 베나 윈터후프에게 사례 보증 서류를 가져가야 합니다.‡Llévale este vale de recompensa a Bena Pezuña Invernal, que está en Cima del Trueno.‡Llévale este vale de recompensa a Bena Pezuña Invernal, que está en Cima del Trueno.‡Apporter le Bon de récompense à Bena Sabot-d\'hiver aux Pitons du Tonnerre.‡把报酬凭证交给雷霆崖的本娜·冰蹄。‡',
  }
},
[2458] = {
  {
    'Missão secreta‡Надежное прикрытие‡Undercover‡잠입‡Agente encubierto‡Agente encubierto‡Sous le couvert de la nuit‡卧底密探‡臥底密探',
    nil,
    'Vá à Torre da Empreendimentos S.A., ao norte do Charco de Lodo, e entre em contato com o agente secreto da Mão Despedaçada, o Capataz Arruela.nnQuando a torre estiver à vista, use o Sinalizador para anunciar sua chegada ao Capataz Arruela. Dispare DUAS vezes, depois aproxime-se do Capataz e faça a /continencia dos Mão Despedaçada.nnEstas ações devem ser executadas na ordem correta, já que Arruela vai atacar e eliminar qualquer pessoa que não reconheça.‡Отыщите башню Торговой компании к северу от Нефтяного болота и вступите в контакт с тайным агентом Изувеченной Длани, надсмотрщиком Физзулом.nnВозле башни выстрелите из сигнального ружья ДВА раза, потом подойдите к надсмотрщику Физзулу и продемонстрируйте приветствие Изувеченной Длани (команда /честь).nnВсе нужно делать строго по порядку – Физзул убивает всех, кто кажется ему подозрительным.‡Reist zum Turm der Venture Company nördlich des Schlickermoores und kontaktiert dort den Agenten der Zerschmetterten Hand, Zuchtmeister Fitzel.nnSobald der Turm in Sichtweite ist, verwendet die Leuchtfeuerwaffe, um Zuchtmeister Fitzel Eure Ankunft anzuzeigen. Feuert ZWEI Leuchtfeuergeschosse ab, nähert Euch dann Zuchtmeister Fitzel und zeigt den Gruß der Zerschmetterten Hand.nnEs ist wichtig, dass Ihr diese Aktionen in der richtigen Reihenfolge durchführt, da Fitzel jede Person, die er nicht erkennt, angreift und eliminiert.‡진흙늪 북쪽에 있는 투자개발회사 탑으로 가서 으스러진 손의 비밀 요원인 감독관 피줄과 접촉해야 합니다.nn탑이 보이면 섬광탄포를 사용해 감독관 피줄에게 당신이 도착했음을 알리십시오. 섬광탄은 2번 발사해야 하며, 그 후 감독관 피줄에게 다가가 으스러진 손 /경례를 해야 합니다.nn피줄은 자기가 모르는 자는 무조건 처치하려 들기 때문에 정확한 순서대로 수행해야 합니다.‡Ve a la torre de Ventura y Cía., al norte de El Fangal, y localiza al capataz Fizzule, el agente de Mano Destrozada. nnCuando veas la torre, usa la pistola de bengalas para avisar de tu llegada al capataz Fizzule. Lanza 2 bengalas y acércate al capataz para darle el /saludo de los Mano Destrozada. nnTienes que hacerlo en este orden, porque Fizzule te matará si no te reconoce.‡Ve a la torre de Ventura y Cía., al norte de El Fangal, y localiza al capataz Fizzule, el agente de Mano Destrozada.|nCuando veas la torre, usa la pistola de bengalas para avisar de tu llegada al capataz Fizzule. Lanza 2 bengalas y acércate al capataz para darle el /saludo de los Mano Destrozada.|nTienes que hacerlo en este orden, porque Fizzule te matará si no te reconoce.‡Aller à la tour de la KapitalRisk, au nord de la Videfange, et contacter l\'agent secret de la Main brisée, le sous-chef Fizzule.nnUne fois la tour en vue, utiliser le lance-fusées pour se signaler au sous-chef Fizzule. Tirer DEUX fusées, puis s\'approcher du sous-chef Fizzule et faire le Salut brisé (/salut).nnRespecter l\'ordre de ces actions, car Fizzule attaque et tue toute personne qu\'il ne peut pas identifier.‡到淤泥沼泽北边的风险投资公司塔楼去，联系碎手氏族的卧底费苏勒。nn看到塔楼之后，用信号枪发射信号，向工头费苏勒示意你已经到达。发出两个闪光信号，然后使用碎手军礼和工头费苏勒接头。nn注意，这些步骤必须依次进行，因为费苏勒会攻击并干掉任何他无法识别的人。‡到淤泥沼澤北邊的風險投資公司塔樓去，聯繫破碎之手氏族的臥底監工費蘇勒。|n看到塔樓之後，用信號槍發射信號，向監工費蘇勒示意你已經到達。發出兩個閃光信號，然後使用破碎之手軍禮和監工費蘇勒接頭。|n注意，這些步驟必須依次進行，因為費蘇勒會攻擊並幹掉任何他無法識別的人。',
  }
},
[2459] = {
  {
    'Ferócitas, o Comedor de Sonhos‡Фероситас Пожиратель Снов‡Ferocitas der Traumfresser‡꿈을 먹어치우는 페로시타스‡Ferocitas el Comesueños‡Ferocitas el Comesueños‡Ferocitas le Mangeur de rêves‡噬梦者菲罗斯塔‡『食夢者』菲羅斯塔',
    nil,
    'Tallonkai Radicélere, em Dolanaar, quer que você mate 7 Místicos Masca-pinho e encontre a Joia Roubada.‡Таллонкай Гибкий Корень из Доланаара хочет, чтобы вы убили 7 мистиков из племени Кривой Сосны и нашли пропавший самоцвет.‡Tallonkai Flinkwurzel aus Dolanaar möchte, dass Ihr 7 Mystiker der Knarzklauen tötet und das verlorene Juwel findet.‡돌라나르에 있는 탈론카이 스위프트루트가 나무옹이일족 비술사 7명을 처치하고 잃어버린 보석을 찾아달라고 부탁했습니다.‡Tallonkai Cruzarraíz de Dolanaar quiere que mates a 7 místicos Tuercepinos y encuentres la joya perdida.‡Mata a 7 místicos Tuercepinos y encuentra la joya perdida.‡Tallonkai Viveracine, de Dolanaar, vous demande de tuer 7 Mystiques Pins-tordus et retrouver le Bijou disparu.‡多兰纳尔的塔隆凯·捷根要你杀掉7个瘤背秘法师，并找到遗失的珠宝。‡多蘭納爾的塔隆凱·捷根要你殺掉7個瘤背秘法師，並找到遺失的珠寶。',
  }
},
[2460] = {
  {
    'A saudação dos Mão Despedaçada‡Приветствие Изувеченной Длани‡Der Gruß der Zerschmetterten Hand‡으스러진 손 경례‡El saludo de los Mano Destrozada‡El saludo de los Mano Destrozada‡Le Salut brisé‡碎手军礼‡碎手軍禮',
    nil,
    'Faça a Continência dos Mãos Despedaçada para Shenthul.‡Повторите приветствие Раздробленной Руки вслед за Шентулом.‡Führt Shenthul gegenüber den Gruß der Zerschmetterten Hand aus.‡셴툴에게 으스러진 손 /경례를 해 보이십시오.‡Da el saludo de los Mano Destrozada a Shenthul.‡Da el saludo de los Mano Destrozada a Shenthul.‡Faire le Salut brisé à Shenthul.‡对着申苏尔练习碎手军礼。‡對著申蘇爾練習碎手軍禮。',
  }
},
[2478] = {
  {
    'Missão: possível, mas não provável‡Миссия: выполнима, но с трудом‡Mission: möglich, aber nicht sehr wahrscheinlich‡미션 임파서블: 잘하면 가능‡Misión: posible, pero no probable‡Misión: Posible, pero no probable‡Mission : possible mais non probable‡基本不可能的任务‡基本不可能的任務',
    nil,
    'Roube a Chave da Torre do Capataz Biela e, em seguida, mate 2 Peões Mutantes da Empreendimentos S.A., 2 Patrulheiros da Empreendimentos S.A. e 2 Vigias da Empreendimentos S.A.nnArranque a cabeça do Capataz-chefe Gallywix, arrombe o cofre dele e roube o Esconderijo do Preparado Adulterado do Zanzil. Leve-o junto com a cabeça para Shenthul em Orgrimmar para receber mais instruções.‡Украдите ключ от башни у штейгера Силиксиза, убейте двух мертвяков-мутантов Торговой компании, двух патрульных Торговой компании и двух смотрителей Торговой компании.nnЛиквидируйте старшего мастера Галливикса, взломайте замок на его ящике и украдите запас измененной смеси Занзила. Отнесите запас смеси и голову Галливикса Шентулу в Оргриммар и получите следующие указания.‡Stehlt Silixiz\' Turmschlüssel von Großknecht Silixiz. Tötet dann 2 mutierte Drohnen der Venture Co., 2 Patrouillen der Venture Co. und 2 Ausgucker der Venture Co.nnEliminiert den obersten Großknecht Gallywix und nehmt seinen Kopf. Knackt dann das Schloss von Gallywix\' Schließkassette und stehlt den Behälter mit Zanzils veränderter Mixtur. Bringt den Behälter und Gallywix\' Kopf zu Shenthul nach Orgrimmar; er wird Euch weitere Anweisungen geben.‡현장감독 실릭시즈에게서 실릭시즈의 탑 열쇠를 훔쳐낸 다음, 돌연변이 투자개발회사 일꾼 2명과 투자개발회사 순찰대원 2명, 그리고 투자개발회사 망꾼 2명을 처치해야 합니다.nn총감독 갤리윅스를 암살하고 그의 머리카락을 손에 넣은 후, 갤리윅스의 금고를 열고 잔질의 변화된 혼합물을 훔쳐내야 합니다. 그 혼합물과 갤리윅스의 머리카락을 오그리마에 있는 셴툴에게 가져다주고 다음 지시를 받으십시오.‡Roba la llave de la torre del supervisor Silixiz, mata a 2 zánganos mutados de Ventura y Cía., 2 patrullas de Ventura y Cía. y 2 oteadores de Ventura y Cía.nnAsesina al Gran Supervisor Puzik Gallywix y quédate con su cabeza, fuerza la cerradura del arcón de Gallywix y roba la carretilla de mezcla de Zanzil modificada que allí está oculta. Lleva el alijo y la cabeza de Gallywix a Shenthul en Orgrimmar; él te dará más instrucciones.‡Roba la llave de la torre del supervisor Silixiz, mata a 2 zánganos mutados de Ventura y Cía., 2 patrullas de Ventura y Cía. y 2 oteadores de Ventura y Cía.|nAsesina al gran supervisor Puzik Gallywix y quédate con su cabeza, fuerza la cerradura del arcón de Gallywix y roba la mezcla de Zanzil modificada que allí está oculta. Lleva el alijo y la cabeza de Gallywix a Shenthul en Orgrimmar, él te dará más instrucciones.‡Voler la Clé de la tour de Silixiz au Contremaître Silixiz, puis tuer deux Pantins mutants de la KapitalRisk, deux Patrouilleurs de la KapitalRisk, et deux Sentinelles de la KapitalRisk.nnAssassiner le Grand contremaître Bisbiwix et prendre sa tête. Ouvrir le coffre de Bisbiwix et y voler la Mixture altérée de Zanzil. Apporter la Mixture et la tête de Bisbiwix à Shenthul à Orgrimmar, et attendre de nouvelles instructions.‡从工头希里克斯那里偷出希里克斯的塔楼钥匙，进入塔楼，然后杀掉两个变异风险投资公司工人、两个风险投资公司巡逻员、两个风险投资公司看守。nn杀掉大工头普兹克·加里维克斯，取了他的首级，然后打开加里维克斯的箱子，拿走赞吉尔的改良药剂。将药剂和加里维克斯的头颅交给奥格瑞玛的申苏尔，等候进一步的指示。‡從工頭希里克斯那裡偷出希里克斯的塔樓鑰匙，進入塔樓，然後殺掉兩個變異風險投資公司工人、兩個風險投資公司巡邏員、兩個風險投資公司看守。|n殺掉大工頭普茲克·加里維克斯，取了他的首級，然後打開加里維克斯的帶鎖箱，拿走贊吉爾的改良藥劑。將藥劑和加里維克斯的頭顱交給奧格瑪的申蘇爾，等候進一步的指示。',
  }
},
[2479] = {
  {
    'A ajuda de Hinoto‡Помощь Хинотта‡Hinotts Hilfe‡히노트의 도움‡La ayuda de Hinott‡La ayuda de Hinott‡L\'aide d\'Hinott‡希诺特的帮助‡希諾特的幫助',
    nil,
    'Vá até a Serraria Tarren, que fica no Contraforte de Eira dos Montes, e entregue a Amostra do Preparado de Zanzil a Serguei Hinoto.nnPara chegar à Serraria Tarren, pegue o Zepelim até a Cidade Baixa e siga a estrada em direção ao sul além de Pinhaprata, rumo à Eira dos Montes. É só seguir as placas!‡Отправляйтесь в Мельницу Таррен в предгорьях Хилсбрада и доставьте образчик смеси Занзила Сержу Хинотту.nnСядьте на дирижабль, идущий до Подгорода, и летите вдоль дороги на юг, через Серебряный бор в сторону Хилсбрада. Следите за знаками.‡Reist nach Tarrens Mühle im Vorgebirge des Hügellands und liefert die Probe von Zanzils Mixtur bei Serge Hinott ab.nnUm nach Tarrens Mühle zu kommen, müsst Ihr den Zeppelin nach Unterstadt nehmen und dann auf der Straße nach Süden durch den Silberwald in Richtung Hügellandhof reisen. Folgt den Schildern!‡힐스브래드 구릉지의 타렌 밀농장으로 가서 서지 히노트에게 잔질의 혼합물 견본을 전해야 합니다.nn타렌 밀농장으로 가려면 먼저 비행선을 타고 언더시티로 가야 합니다. 도착하면 남쪽 길을 따라 은빛소나무 숲을 지나 힐스브래드 쪽으로 가야 합니다. 표지판을 따라 가십시오!‡Ve a Molino Tarren, en Laderas de Trabalomas, para entregar la muestra de la mezcla de Zanzil a Serge Hinott. nnPara ir, coge el zepelín a Entrañas y sigue el camino hacia el sur por el Bosque de Argénteos. ¡Sigue las indicaciones!‡Ve a Molino Tarren, en Laderas de Trabalomas, para entregar la muestra de Zanzil a Serge Hinott.|nPara llegar a Molino Tarren, coge el zepelín a Entrañas y sigue el camino hacia el sur por el Bosque de Argénteos hacia Trabalomas. ¡Sigue las indicaciones!‡Aller à Moulin-de-Tarren dans les contreforts de Hautebrande et livrer l\'Échantillon de la mixture de Zanzil à Serge Hinott.nnPour rejoindre Moulin-de-Tarren, prenez le zeppelin à Fossoyeuse et suivez la route du sud, à travers les Pins argentés et vers Hautebrande. Suivez les panneaux !‡到希尔斯布莱德丘陵的塔伦米尔去，把赞吉尔的药剂样品交给瑟尔格·希诺特。nn要去塔伦米尔，可以搭乘飞艇到幽暗城，然后沿着大路向南穿过银松森林，直到希尔斯布莱德丘陵。跟着路标走！‡到希爾斯布萊德丘陵的塔倫米爾去，把贊吉爾的藥劑樣品交給瑟爾格·希諾特。|n要去塔倫米爾，可以搭乘飛艇到幽暗城，然後沿著大路向南穿過銀松森林，直到希爾斯布萊德丘陵。跟著路標走!',
  }
},
[2480] = {
  {
    'A ajuda de Hinoto‡Помощь Хинотта‡Hinotts Hilfe‡히노트의 도움‡La ayuda de Hinott‡La ayuda de Hinott‡L\'aide d\'Hinott‡希诺特的帮助‡希諾特的幫助',
    nil,
    'Espere Serguei Hinoto concluir a cura.‡Дождитесь, пока Серж Хинотт доделает лекарство.‡Wartet auf Serge Hinott, um das Heilmittel fertig zu stellen.‡서지 히노트가 해독제를 만드는 동안 기다려야 합니다.‡Espera a que Serge Hinott te cure.‡Espera a que Serge Hinott te cure.‡Attendre Serge Hinott pour achever le remède.‡等待瑟尔格·希诺特完成解药。‡等待瑟爾格·希諾特完成解藥。',
  }
},
[2498] = {
  {
    'Fale com Denalan‡Возвращение к Деналану‡Rückkehr zu Denalan‡데날란에게 돌아가기‡El regreso a Denalan‡Regresa junto a Denalan‡Retour vers Denalan‡向德纳兰回报‡向德納蘭回報',
    nil,
    'Rellian Spiraverde quer que você fale com Denalan, no Lago Al\'Ameth.‡Релиан Зеленый Костер хочет, чтобы вы поговорили с Деналаном у озера Аль\'Амет.‡Rellian Grünwipfel möchte, dass Ihr am Al\'Amethsee mit Denalan sprecht.‡레엘리안 그린스파이어가 알아메스 호수에 있는 데날란과 대화할 것을 부탁했습니다.‡Rellian Verdeguja quiere que hables con Denalan, que está en el Lago Al\'Ameth.‡Rellian Verdeguja quiere que hables con Denalan, que está en el Lago Al\'Ameth.‡Rellian Vertecime vous demande d\'aller parler à Denalan au lac Al\'Ameth.‡雷利亚·绿树要你和奥拉密斯湖的德纳兰谈一谈。‡雷利亞·綠樹要你和奧拉密斯湖的德納蘭談一談。',
  }
},
[2499] = {
  {
    'Carrancarvalho‡Дубохмур‡Grimmeiche‡오크나무괴물‡Roblegüello‡Roblegüello‡Froncechêne‡奥肯斯古尔‡奧肯斯古爾',
    nil,
    'Denalan, no Lago Al\'Ameth, quer que você remova o Tumor Gigantesco de Carrancarvalho.‡Деналан с озера Аль\'Амет хочет, чтобы вы сняли гигантскую опухоль с Дубохмура.‡Denalan vom Al\'Amethsee möchte, dass Ihr den riesengroßen Tumor von Grimmeiche einsammelt.‡알아메스 호수에 사는 데날란이 오크나무괴물에게서 거대한 종양을 모아 달라고 부탁했습니다.‡Denalan, que está en el Lago Al\'Ameth, quiere que cojas el tumor gigantesco que tiene Roblegüello.‡Hazte con el tumor gigantesco de Roblegüello.‡Denalan, au lac Al\'Ameth, vous demande d\'ôter la Tumeur gargantuesque de Froncechêne.‡奥拉密斯湖的德纳兰要你去拿到奥肯斯古尔身上的巨大的瘤。‡奧拉密斯湖的德納蘭要你去拿到奧肯斯古爾身上的巨大的瘤。',
  }
},
[2500] = {
  {
    'Busca pelos reagentes dos Ermos‡Пробежка по Бесплодным землям‡Reagenziensuche im Ödland‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas‡Componentes de Tierras Inhóspitas‡Les réactifs des Terres ingrates‡荒芜之地的材料‡荒蕪之地的試劑',
    nil,
    'Consiga os reagentes dos Ermos de que Ghak Toquecura precisa, então fale novamente com ele em Thelsamar.‡Добудьте в Бесплодных землях реактивы для Гхака Целителя и отнесите их ему в Телcамар.‡Beschafft die Reagenzien, die Ghak Heilsegen aus dem Ödland braucht, und bringt sie ihm nach Thelsamar.‡황야의 땅에서 필요한 재료를 구한 후 텔사마에 있는 가크 힐터치에게 돌아가야 합니다.‡Ve a las Tierras Inhóspitas a buscar los ingredientes que te ha pedido Ghak Sanadón y llévaselos a Thelsamar.‡Ve a las Tierras Inhóspitas a buscar los ingredientes que te ha pedido Ghak Sanadón y llévaselos a Thelsamar.‡Aller chercher les réactifs dont Ghak Healtouch a besoin dans les Terres ingrates, puis les lui rapporter à Thelsamar.‡从荒芜之地拿到加克所需的材料，然后回到塞尔萨玛去见他。‡從荒蕪之地拿到加克所需的材料，然後回到塞爾薩瑪去見他。',
  }
},
[2501] = {
  {
    'Busca pelos reagentes dos Ermos, parte II‡Пробежка по Бесплодным землям-2‡Reagenziensuche im Ödland II‡황야의 땅에서 재료 찾기‡Componentes de Tierras Inhóspitas II‡Componentes de Tierras Inhóspitas II‡Les réactifs des Terres ingrates II‡荒芜之地的材料 II‡荒蕪之地的試劑 II',
    nil,
    'Use os Recipientes de Taumaturgia Vazios em Dragões Guardiões Calcinados encontrados nos Ermos. Quando enchê-los, leve-os para Ghak Toquecura em Thelsamar.‡Наполните пустые волшебные сосуды кровью опаленных драконов-стражей в Бесплодных землях и принесите их Гхаку Целителю в Телcамар.‡Benutzt die leeren thaumaturgischen Gefäße bei versengten Wächtergroßdrachen im Ödland. Wenn Ihr sie gefüllt habt, bringt sie zu Ghak Heilsegen in Thelsamar.‡빈 요술 유리병을 황야의 땅에 있는 화염의 수호비룡에게 사용해야 합니다. 3개를 다 채우면 텔사마에 있는 가크 힐터치에게로 가져가야 합니다.‡Usa las vasijas de taumaturgia en los dragones guardianes agostados de las Tierras Inhóspitas. Llévaselas a Ghak Sanadón a Thelsamar.‡Usa las vasijas de taumaturgia en los dragones guardianes agostados de las Tierras Inhóspitas. Llévaselas a Ghak Sanadón a Thelsamar.‡Utiliser les Récipients thaumaturgiques vides sur des dragons gardiens des terres brûlées dans les Terres ingrates. Une fois remplis, les rapporter à Ghak Touchesoins à Thelsamar.‡在荒芜之地的守护火龙身上使用空的魔瓶。将这些容器都盛满之后，把它们交给塞尔萨玛的加克。‡在荒蕪之地的守護火龍身上使用空的魔瓶。將這些容器都盛滿之後，把它們交給塞爾薩瑪的加克。',
  }
},
[2518] = {
  {
    'Lágrima da Lua‡Слезы Луны‡Tränen des Mondes‡달의 눈물‡Las lágrimas de la Luna‡Las lágrimas de la Luna‡Les larmes de la Lune‡月神的泪水‡月神的淚水',
    nil,
    'A Sacerdotisa A\'mura no Templo da Lua, em Darnassus, quer que você lhe traga as Fiandeiras Prateadas de Lady Sathrah.‡Жрица А\'моора из дарнасского храма Луны хочет, чтобы вы принесли ей серебряные паутинные железы леди Сатры.‡Priesterin A\'moora vom Tempel des Mondes in Darnassus möchte, dass Ihr ihr Lady Sathrahs silbrige Spinndrüsen bringt.‡다르나서스의 달의 신전에 있는 여사제 아무라가 여왕거미 사스라의 은빛 돌기를 가져다 달라고 부탁했습니다.‡La sacerdotisa A\'moora del Templo de la Luna de Darnassus quiere que le lleves las espineretas de plata de Lady Sathrah.‡Recupera las hileras de plata de Lady Sathrah.‡Apporter les Filières d\'argent de dame Sathrah à la prêtresse A\'moora, au temple de la Lune, à Darnassus.‡达纳苏斯月神殿的女祭司艾茉拉让你把萨丝拉的银色丝囊交给她。‡達納蘇斯月神殿的女祭司艾茉拉讓你把薩絲拉的銀色絲囊交給她。',
  }
},
[2519] = {
  {
    'O Templo da Lua‡Храм Луны‡Der Tempel des Mondes‡달의 신전‡El templo de la Luna‡El templo de la Luna‡Le Temple de la Lune‡月神殿‡月神殿',
    nil,
    'Irmã Aquinne quer que você fale com a Sacerdotisa A\'mura no Templo da Lua.‡Сестра Аквинна хочет, чтобы вы поговорили со жрицей А\'моорой из Храма Луны.‡Schwester Aquinne möchte, dass Ihr im Tempel des Mondes mit Priesterin A\'moora sprecht.‡수녀 아퀴네가 달의 신전에 있는 여사제 아무라와 대화할 것을 부탁했습니다.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡La hermana Aquinne quiere que hables con la sacerdotisa A\'moora en el Templo de la Luna.‡Sœur Aquinne veut que vous parliez à la prêtresse A\'moora, au temple de la Lune.‡艾奎恩妮让你和月神殿的女祭司艾茉拉谈一谈。‡艾奎恩妮修女讓你和月神殿的女祭司艾茉拉談話。',
  }
},
[2520] = {
  {
    'Sacrifício de Sathrah‡Жертвоприношение Сатры‡Sathrahs Opferung‡사스라의 제물‡El Sacrificio de Sathrah‡El Sacrificio de Sathrah‡Sacrifice de Sathrah‡萨丝拉的祭品‡薩絲拉的祭品',
    nil,
    'A Sacerdotisa A\'mura quer que você coloque as fiandeiras prateadas de Lady Sathrah na fonte dentro do templo, e depois fale novamente com ela.‡Жрица А\'моора просит вас положить серебряные паутинные железы леди Сатры у фонтана в храме и затем вернуться к ней.‡Priesterin A\'moora möchte, dass Ihr Lady Sathrahs silbrige Spinndrüsen am Brunnen innerhalb des Tempels ablegt und dann zu ihr zurückkehrt.‡여사제 아무라가 달의 신전 중앙에 있는 샘에 사스라의 은빛 돌기를 제물로 바치고 돌아와 달라고 부탁했습니다.‡La sacerdotisa A\'moora quiere que coloques las espineretas de plata de Lady Sathrah en la fuente que hay en el interior del templo, y que después vayas a verla de nuevo.‡La sacerdotisa A\'moora quiere que coloques las hileras de plata de Lady Sathrah en la fuente que hay en el interior del templo, y que después vayas a verla de nuevo.‡La prêtresse A\'moora vous demande de placer les Filières d\'argent de dame Sathrah dans la fontaine à l\'intérieur du temple, puis de retourner la voir.‡女祭司艾茉拉让你将萨丝拉的银色丝囊放在大殿的喷泉处，然后回去见她。‡',
  }
},
[2521] = {
  {
    'A serviço de Kum\'isha‡Служба для Кум\'иша‡Ein Dienst für Kum\'isha‡굼이샤의 지시‡Al servicio de Kum\'isha‡Al servicio de Kum\'isha‡Au service de Kum\'isha‡为库米沙效力‡為庫米沙效力',
    nil,
    'Em suas jornadas pela Barreira do Inferno, caso encontre uma esfera de draenetista impecável, leve-a de volta para Kum\'isha, o Colecionador.nnAtenção, essa pedra é um dos cristais mais raros de toda Azeroth. Qualquer criatura nestas terras poderia ter em seu poder uma esfera de draenetista impecável.nnVocê será recompensad<o/a> por cada esfera de draenetista impecável que conseguir.‡Если в своем путешествии по Выжженным землям вы найдете безупречную сферу из дренетиста, отнесите ее Кум\'ише Коллекционеру. nnБудьте внимательны – этот камень – один из самых редких кристаллов во всем Азероте. Любое существо в этих землях может владеть безупречной сферой из дренетиста. nnВы будете вознаграждены за каждую безупречную сферу из дренетиста, которую доставите Кум-ише.‡Falls Ihr auf Euren Reisen durch die verwüsteten Lande je auf eine fehlerlose Draenethystsphäre stoßen solltet, bringt sie zu Kum\'isha dem Sammler.nnDoch seid gewarnt. Der Edelstein ist einer der rarsten Kristalle von ganz Azeroth. Jedes Wesen in diesem Land könnte eine fehlerlose Draenethystsphäre bei sich haben.nnIhr erhaltet eine Belohnung für jede fehlerlose Draenethystsphäre, die Ihr beschaffen könnt.‡저주받은 땅을 돌아다니다가 완전무결한 드레니시스트 구슬을 발견하면 수집가 굼이샤에게 가져가야 합니다.nn이 보석은 아제로스를 통틀어 가장 희귀한 수정 중 하나로써 이곳 생물들이 지니고 있을 가능성도 있습니다.nn완전무결한 드레니시스트 구슬을 수집해 갈 때마다 각각에 대해 보상을 받게 됩니다.‡En tus viajes por Las Tierras Devastadas, si te encontraras con una esfera draenetista perfecta, llévasela a Kum\'isha el Coleccionista.nnTen cuidado, esta gema es uno de los cristales más raros de todo Azeroth. Cualquier criatura de estas tierras podría tener una.nnSe te recompensará por cada esfera draenetista perfecta que consigas.‡En tus viajes por Las Tierras Devastadas, si te encontraras con una esfera draenetista perfecta, llévasela a Kum\'isha el Coleccionista.|nTen cuidado, esta gema es uno de los cristales más raros de todo Azeroth. Cualquier criatura de estas tierras podría tener una.|nSe te recompensará por cada esfera draenetista perfecta que consigas.‡Si vous trouvez une sphère de draenéthyste sans défaut au hasard des voyages dans les Terres foudroyées, apportez-la à Kum\'isha le Collecteur.nnCette gemme, l\'une des plus rares de tout Azeroth, peut être détenue par n\'importe qui dans le pays.nnUne récompense sera donnée pour chaque sphère de draenéthyste sans défaut trouvée et rapportée.‡在你探索诅咒之地的旅程中，如果碰巧发现了无暇的德莱尼水晶球，就把它交给收藏家库米沙。nn你要知道，这种宝石是整个艾泽拉斯最珍稀的水晶。诅咒之地上的任何一种生物都有可能带着一颗无暇的德莱尼水晶球。nn每找到一颗，你都会得到相应的酬劳。‡在你探索詛咒之地的旅程中，如果碰巧發現了無暇的德萊尼水晶球，就把它交給『收藏家』庫米沙。|n你要知道，這種寶石是整個艾澤拉斯最珍稀的水晶。詛咒之地上的任何一種生物都有可能帶著一顆無暇的德萊尼水晶球。|n每找到一顆，你都會得到相應的酬勞。',
  }
},
[2522] = {
  {
    'Empreitadas do Kum\'isha‡Попытки Кум\'иша‡Kum\'ishas Bemühungen‡굼이샤의 노력‡Los esfuerzos de Kum\'isha‡Los esfuerzos de Kum\'isha‡Les efforts de Kum\'isha‡库米沙的努力‡庫米沙的努力',
    nil,
    'Encontre e entregue uma Esfera de Draenetista Impecável para Kum\'isha, o Colecionador.‡Найдите безупречную сферу из дренетиста и верните ее Кум\'ише Коллекционеру.‡Findet eine fehlerlose Draenethystsphäre und bringt sie Kum\'isha dem Sammler.‡수집가 굼이샤에게 완전무결한 드레니시스트 구슬을 가져가야 합니다.‡Encuentra una esfera draenetista perfecta y llévasela a Kum\'isha el Coleccionista.‡Encuentra una esfera draenetista perfecta y llévasela a Kum\'isha el Coleccionista.‡Trouver une Sphère de draenéthyste sans défaut et l\'apporter à Kum\'isha le Collecteur.‡找到一颗无暇的德莱尼水晶球，把它交给收藏家库米沙。‡找到一顆無暇的德萊尼水晶球，把它交給『收藏家』庫米沙。',
  }
},
[2523] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[2541] = {
  {
    'O druida adormecido‡Спящий друид‡Der schlafende Druide‡잠자는 드루이드‡El druida durmiente‡El druida durmiente‡Le druide endormi‡沉睡的德鲁伊‡沉睡的德魯伊',
    nil,
    'Traga o Patuá Vodu de Xamã para Oben Patafúria na Gruta de Ban\'ethil.‡Принесите шаманский оберег вуду Обену Яростному Когтю в обитель Бен\'этиль.‡Bringt einen Voodooglücksbringer des Schamanen zu Oben Zornklaue in den Grabhügel von Ban\'ethil.‡바네실 지하굴에 있는 오벤 레이지클로에게 부두교 주술사 부적을 가져다주어야 합니다.‡Llévale un talismán de vudú chamán a Oben Garrafuria al Túmulo de Ban\'ethil.‡Llévale un talismán de vudú chamán a Oben Garrafuria al Túmulo de Ban\'ethil.‡Rapporter un Charme vaudou de chaman à Oben Grifferage dans le Refuge des saisons de Ban\'ethil.‡将一个萨满巫毒符咒交给班奈希尔兽穴的奥本·怒爪。‡將一個薩滿巫毒符咒交給班奈希爾獸穴的奧本·怒爪。',
  }
},
[2561] = {
  {
    'Druida da Garra‡Друид-медведь‡Druide der Klaue‡발톱의 드루이드‡El druida de la Zarpa‡El druida de la Zarpa‡Le druide de la Griffe‡利爪德鲁伊‡利爪德魯伊',
    nil,
    'Oben Patafúria quer que você mate seu corpo sem alma e, em seguida, use o Patuá Vodu.‡Обен Яростный Коготь просит, чтобы вы уничтожили его лишенное души тело, а затем воспользовались оберегом вуду.‡Oben Zornklaue möchte, dass Ihr seinen seelenlosen Körper tötet und dann den Voodooglücksbringer anwendet.‡오벤 레이지클로가 영혼을 잃어버린 그의 육체를 죽인 후 부두교 부적을 사용하라고 부탁했습니다.‡Oben Garrafuria quiere que mates su cuerpo desalmado y que después utilices el talismán de vudú.‡Mata el cuerpo desalmado de Oben Garrafuria y después utiliza el talismán vudú.‡Oben Grifferage vous demande de tuer son corps privé d\'âme et d\'utiliser ensuite le Charme vaudou.‡奥本·怒爪要求你去杀掉他那失去灵魂的身体，然后对其尸体使用巫毒咒符。‡奧本·怒爪要求你去殺掉他那失去靈魂的身體，然後對其屍體使用巫毒符咒。',
  }
},
[2581] = {
  {
    'Mandíbulas de rasgarrindo‡Челюсти гиены-хохотуна‡Kicherfangunterkiefer‡칼송곳니하이에나 턱‡Papadas de hiena risitas‡Papadas de hiena risitas‡Joues de Raillecroc‡弯牙土狼的颚骨‡彎牙土狼的顎骨',
    nil,
    'Traga três Mandíbulas de Rasgarrindo, dois Pulmões de Javali Destroçados e uma Tenaz de Escórpode para o Mago Sangrento Drazial.‡Принесите три челюсти гиены, два обожженных легких вепря и клешню скорпока магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Kicherfangunterkiefer, 2 feuerverbrannte Eberlungen und 1 Skorpokzange.‡혈법사 드라지알에게 칼송곳니하이에나 턱 3개, 손상된 멧돼지 허파 2개, 스콜포크 집게발 1개를 가져가야 합니다.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Apporter 3 Joues de Raillecroc, 2 Poumons de sanglier éclatés et 1 Pince de scorpok au Mage de sang Drazial.‡收集3个弯牙土狼的颚骨、2片诅咒之地的野猪肺和1个厚甲蝎螯，把它们交给血法师德拉吉亚。‡收集3個彎牙土狼的顎骨、2片詛咒之地的野豬肺和1個厚甲蠍螯，把它們交給血法師德拉吉亞。',
  }
},
[2582] = {
  {
    'Fúria das Eras‡Ярость веков‡Wut der Zeiten‡시대의 분노‡La cólera de las edades‡Ira de las Eras‡La colère des âges‡远古之怒‡遠古之怒',
    nil,
    'Leve três Mandíbulas de Rasgarrindo, dois Pulmões de Javali Destroçados e uma Tenaz de Escórpode para o Mago Sangrento Drazial.‡Принесите три челюсти гиены, два обожженных легких вепря и клешню скорпока магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Kicherfangunterkiefer, 2 feuerverbrannte Eberlungen und 1 Skorpokzange.‡혈법사 드라지알에게 칼송곳니하이에나 턱 3개, 손상된 멧돼지 허파 2개, 스콜포크 집게발 1개를 가져가야 합니다.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Llévale 3 papadas de hiena risitas, 2 pulmones de jabalí maldito y 1 pinza de scorpok al mago sangriento Drazial.‡Apporter 3 Joues de Raillecroc, 2 Poumons de sanglier éclatés et 1 Pince de scorpok au Mage de sang Drazial.‡收集3个弯牙土狼的颚骨、2片诅咒之地的野猪肺和1个厚甲蝎螯，把它们交给血法师德拉吉亚。‡收集3個彎牙土狼的顎骨、2片詛咒之地的野豬肺和1個厚甲蠍螯，把它們交給血法師德拉吉亞。',
  }
},
[2583] = {
  {
    'A vitalidade dos javalis‡Жизненная сила вепря‡Lebenskraft des Ebers‡멧돼지의 생명력‡La vitalidad del jabalí‡La vitalidad del jabalí‡La vitalité du sanglier‡野猪的活力‡野豬的活力',
    nil,
    'Leve 3 Pulmões de Javali Destroçado, 2 Tenazes de Escórpode e 1 Cérebro de Basilisco para o Mago Sangrento Drazial.‡Принесите три обожженных легких вепря, две клешни скорпока и мозг василиска магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 feuerverbrannte Eberlungen, 2 Skorpokzangen und 1 Basiliskengehirn.‡혈법사 드라지알에게 손상된 멧돼지 허파 3개, 스콜포크 집게발 2개, 바실리스크 뇌 1개를 가져다주어야 합니다.‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.‡Apporter 3 Poumons de sanglier éclatés, 2 Pinces de scorpok et 1 Cerveau de basilic au Mage de sang Drazial.‡收集3片诅咒之地的野猪肺、2个厚甲蝎螯和1颗石化蜥蜴的大脑，把它们交给血法师德拉吉亚。‡收集3片詛咒之地的野豬肺、2個厚甲蠍螯和1顆石化蜥蜴的大腦，把它們交給血法師德拉吉亞。',
  }
},
[2584] = {
  {
    'Espírito do javali‡Дух вепря‡Geist des Ebers‡멧돼지의 혼‡El espíritu del jabalí‡El espíritu del jabalí‡L\'esprit du sanglier‡野猪之魂‡野豬之靈',
    nil,
    'Leve 3 Pulmões de Javali Destroçado, 2 Tenazes de Escórpode e 1 Cérebro de Basilisco para o Mago Sangrento Drazial.‡Принесите три обожженных легких вепря, две клешни скорпока и мозг василиска магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 feuerverbrannte Eberlungen, 2 Skorpokzangen und 1 Basiliskengehirn.‡혈법사 드라지알에게 손상된 멧돼지 허파 3개, 스콜포크 집게발 2개, 바실리스크 뇌 1개를 가져가야 합니다.‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.|n‡Llévale 3 pulmones de jabalí maldito, 2 pinzas de scorpok y 1 cerebro de basilisco al mago sangriento Drazial.‡Apporter 3 Poumons de sanglier éclatés, 2 Pinces de scorpok et 1 Cerveau de basilic au Mage de sang Drazial.‡收集3片诅咒之地的野猪肺、2个厚甲蝎螯和1颗石化蜥蜴的大脑，把它们交给血法师德拉吉亚。‡收集3片詛咒之地的野豬肺、2個厚甲蠍螯和1顆石化蜥蜴的大腦，把它們交給血法師德拉吉亞。',
  }
},
[2585] = {
  {
    'Ataque decisivo‡Решительный удар‡Der Entscheidungsschlag‡민첩한 스콜포크‡El golpe decisivo‡El golpe decisivo‡Le coup décisif‡决定性的打击‡決定性的打擊',
    nil,
    'Leve 3 Tenazes de Escórpode, 2 Moelas de Abutre e 1 Pulmão de Javali Destroçado para o Mago Sangrento Drazial.‡Принесите три клешни скорпока, две порции потрохов стервятника и обожженное легкое вепря магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Skorpokzangen, 2 Geiermuskelmägen und 1 feuerverbrannte Eberlunge.‡혈법사 드라지알에게 스콜포크 집게발 3개, 독수리 모래주머니 2개, 손상된 멧돼지 허파 1개를 가져가야 합니다.‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.|n‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.‡Apporter 3 Pinces de scorpok, 2 Gésiers de vautour et 1 Poumon de sanglier éclaté au mage de sang Drazial.‡收集3个厚甲蝎螯、2个秃鹫的砂囊和1片诅咒之地的野猪肺，把它们血法师德拉吉亚。‡收集3個厚甲蠍螯、2個禿鷹的砂囊和1片詛咒之地的野豬肺，把它們血法師德拉吉亞。',
  }
},
[2586] = {
  {
    'Sal do escórpode‡Скорпоковая соль‡Salz der Skorpok‡스콜포크의 가루약‡La sal del Scorpok‡La sal del Scorpok‡Le sel de scorpok‡厚甲蝎盐‡厚甲蠍鹽',
    nil,
    'Leve três Tenazes de Escórpode, duas Moelas de Abutre e um Pulmão de Javali Destroçado para o Mago Sangrento Drazial.‡Принесите три клешни скорпока, две порции потрохов стервятника и обожженное легкое вепря магу крови Дразиалу.‡Bringt Blutmagier Drazial 3 Skorpokzangen, 2 Geiermuskelmägen und 1 feuerverbrannte Eberlunge.‡혈법사 드라지알에게 스콜포크 집게발 3개, 독수리 모래주머니 2개, 손상된 멧돼지 허파 1개를 가져가야 합니다.‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.‡Llévale 3 pinzas de scorpok, 2 mollejas de buitre y 1 pulmón de jabalí maldito al mago sangriento Drazial.‡Apporter 3 Pinces de scorpok, 2 Gésiers de vautour et 1 Poumon de sanglier éclaté au mage de sang Drazial.‡收集3个厚甲蝎螯、2个秃鹫的砂囊和1片诅咒之地的野猪肺，把它们血法师德拉吉亚。‡收集3個厚甲蠍螯、2個禿鷹的砂囊和1片詛咒之地的野豬肺，把它們血法師德拉吉亞。',
  }
},
[2601] = {
  {
    'A mordida do basilisco‡Укус василиска‡Der Biss des Basilisken‡바실리스크의 내장‡El bocado de basilisco‡El bocado de basilisco‡La morsure du basilic‡石化蜥蜴的大脑‡石化蜥蜴的大腦',
    nil,
    'Leve 10 Cérebros de Basilisco e 2 Moelas de Abutre para a Maga Sangrenta Lynnore.‡Принесите десять мозгов василиска и потроха двух стервятников волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Basiliskengehirne und 2 Geiermuskelmägen.‡혈법사 린노어에게 바실리스크 뇌 10개와 독수리 모래주머니 2개를 가져가야 합니다.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.|n‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.‡Apporter 10 Cerveaux de basilic et 2 Gésiers de vautour au Mage de sang Lynnore.‡收集10颗石化蜥蜴的大脑和2个秃鹫的砂囊，把它们交给血法师莱诺雷。‡收集10顆石化蜥蜴的大腦和2個禿鷹的砂囊，把它們交給血法師萊諾雷。',
  }
},
[2602] = {
  {
    'Mente infalível‡Непогрешимый разум‡Unfehlbare Gedanken‡흔들리지 않는 정신‡La mente infalible‡La mente infalible‡Un esprit infaillible‡清晰的思想‡清晰的思想',
    nil,
    'Leve dez Cérebros de Basilisco e duas Moelas de Abutre para Maga Sangrenta Lynnore.‡Принесите десять мозгов василиска и потроха двух стервятников волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Basiliskengehirne und 2 Geiermuskelmägen.‡혈법사 린노어에게 바실리스크 뇌 10개와 독수리 모래주머니 2개를 가져가야 합니다.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.‡Llévale 10 cerebros de basilisco y 2 mollejas de buitre a la maga sangrienta Lynnore.‡Apporter 10 Cerveaux de basilic et 2 Gésiers de vautour au Mage de sang Lynnore.‡收集10颗石化蜥蜴的大脑和2个秃鹫的砂囊，把它们交给血法师莱诺雷。‡收集10顆石化蜥蜴的大腦和2個禿鷹的砂囊，把它們交給血法師萊諾雷。',
  }
},
[2603] = {
  {
    'O vigor do abutre‡Стойкость стервятника‡Lebensenergie des Geiers‡독수리의 면역력‡El vigor del buitre‡El vigor del buitre‡La vigueur du vautour‡秃鹫的活力‡禿鷹的活力',
    nil,
    'Leve 10 Moelas de Abutre e 2 Mandíbulas de Rasgarrindo para a Maga Sangrenta Lynnore.‡Принесите потроха десяти стервятников и две челюсти гиены волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Geiermuskelmägen und 2 Kicherfangunterkiefer.‡혈법사 린노어에게 독수리 모래주머니 10개와 칼송곳니하이에나 턱 2개를 가져가야 합니다.‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.‡Apporter 10 Gésiers de vautour et 2 Joues de Raillecroc au Mage de sang Lynnore.‡收集10个秃鹫的砂囊和2块弯牙土狼的颚骨，把它们交给血法师莱诺雷。‡收集10個禿鷹的砂囊和2塊彎牙土狼的顎骨，把它們交給血法師萊諾雷。',
  }
},
[2604] = {
  {
    'Dominação espiritual‡Духовное превосходство‡Geistige Beherrschung‡영적 지배‡Dominación espiritual‡Dominación espiritual‡Domination spirituelle‡精神矍铄‡精神矍鑠',
    nil,
    'Leve 10 Moelas de Abutre e 2 Mandíbulas de Rasgarrindo para a Maga Sangrenta Lynnore.‡Принесите потроха десяти стервятников и две челюсти гиены волшебнице крови Линоре.‡Bringt Blutmagierin Lynnore 10 Geiermuskelmägen und 2 Kicherfangunterkiefer.‡혈법사 린노어에게 독수리 모래주머니 10개와 칼송곳니하이에나 턱 2개를 가져가야 합니다.‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.|n‡Llévale 10 mollejas de buitre y 2 papadas de hiena risitas a la maga sangrienta Lynnore.‡Apporter 10 Gésiers de vautour et 2 Joues de Raillecroc au Mage de sang Lynnore.‡收集10个秃鹫的砂囊和2块弯牙土狼的颚骨，把它们交给血法师莱诺雷。‡收集10個禿鷹的砂囊和2塊彎牙土狼的顎骨，把它們交給血法師萊諾雷。',
  }
},
[2605] = {
  {
    'O goblin sedento‡Жаждущий гоблин‡Der durstige Goblin‡목마른 고블린‡El goblin sediento‡El goblin sediento‡Le gobelin assoiffé‡口渴的地精‡口渴的哥布林',
    nil,
    'Colete uma Glândula de Orvalho Cheia e leve para Marin Nublacuca em Geringontzan.‡Добудьте насыщенную влагой железу и принесите ее Синю Гогельмогелю в Прибамбасск.‡Beschafft Euch eine gefüllte Taudrüse und bringt sie nach Gadgetzan zu Marin Noggenfogger.‡가득 찬 이슬샘을 모아 가젯잔에 있는 마린 노겐포저에게 가져가야 합니다.‡Consigue una glándula cargada de rocío y llévasela a Marin Tragonublo a Gadgetzan.‡Consigue una glándula cargada de rocío y llévasela a Marin Tragonublo a Gadgetzan.‡Trouver une Glande à rosée remplie et l\'apporter à Marin Brouillecaboche à Gadgetzan.‡找到1个饱满的露水腺，把它交给加基森的马林·诺格弗格。‡找到1個飽滿的露水腺，把它交給加基森的馬林·諾格弗格。',
  }
},
[2606] = {
  {
    'Gosto não se discute‡Хороший вкус‡Dem guten Geschmacke‡맛의 달인‡Un buen sabor‡Un buen sabor‡De bon goût‡好味道‡好味道',
    nil,
    'Marin Nublacuca quer que você fale com Sguisha em Geringontzan.‡Поговорите с Поливалкой в Прибамбасске по поручению Синя Гогельмогеля.‡Marin Noggenfogger möchte, dass Ihr in Gadgetzan mit Sprinkel sprecht.‡마린 노겐포저가 가젯잔에 있는 스프링클과 대화할 것을 부탁했습니다.‡Marin Tragonublo quiere que hables con Roxio en Gadgetzan.‡Marin Tragonublo quiere que hables con Roxio en Gadgetzan.‡Marin Brouillecaboche vous demande d\'aller voir Saupoudr à Gadgetzan.‡马林·诺格弗格让你与加基森的斯普琳科谈一谈。‡馬林·諾格弗格讓你與加基森的斯普琳科談話。',
  }
},
[2607] = {
  {
    'O toque de Zanzil‡Прикосновение Занзила‡Die Berührung von Zanzil‡잔질의 손길‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡贊吉爾之觸',
    nil,
    'Fale com o Doutor Mixilpixil no porão do Quartel.‡Поговорите с Доком Миксиль-Пиксилем в подвале казарм.‡Sprecht im Keller der Kaserne mit Dok Mixilpixil.‡병영 지하실에 있는 닥 믹실픽실과 대화해야 합니다.‡Habla con Doc Mixilpixil en el sótano de los Cuarteles.‡Habla con Doc Mixilpixil en el sótano de los Cuarteles.‡Aller voir le docteur Mixilpixil dans la Cave de la caserne.‡到兵营的地窖里去和道克·米希匹克斯谈一谈。‡到兵營的地窖裡去和道克·米希匹克斯談話。',
  }
},
[2608] = {
  {
    'O toque de Zanzil‡Прикосновение Занзила‡Die Berührung von Zanzil‡잔질의 손길‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡',
    nil,
    'Você precisa /deitar para ser <examinado/examinada> pelo Doutor Mixilpixil. Como é que ele vai descobrir a cura se não puder identificar a causa do problema?‡Лягте на землю (действие /lay) для осмотра Доком Миксиль-Пиксилем – он не сможет подобрать лекарство, пока не найдет причину болезни.‡Ihr solltet Euch /hinlegen, damit Dok Mixilpixil Euch untersuchen kann. Denn wie soll er ein Heilmittel finden, wenn er die Ursache nicht finden kann?‡닥 믹실픽실에게 검사를 받으려면 "/누워"야 합니다. 믹실픽실은 원인도 모르는 병의 치료법을 어떻게 찾을 수 있을까요?‡Túmbate para que te examine Doc Mixilpixil. ¿Cómo va a encontrar la cura si no encuentra la causa?|n‡Túmbate para que te examine Doc Mixilpixil. ¿Cómo va a encontrar la cura si no encuentra la causa?‡S\'allonger (/coucher) pour être <examiné/examinée> par le docteur Mixilpixil. Comment peut-il trouver le remède s\'il ne peut pas trouver la cause ?‡用/lay指令躺下，接受道克·米希匹克斯的治疗。如果他找不到病因，就找不到治疗的方法。‡',
  }
},
[2609] = {
  {
    'O toque de Zanzil‡Прикосновение Занзила‡Die Berührung von Zanzil‡잔질의 손길‡Toque de Zanzil‡Toque de Zanzil‡Le toucher de Zanzil‡赞吉尔之触‡贊吉爾之觸',
    nil,
    'Leve para o Doutor Mixilpixil um pacote de Flores Silvestres Simples, uma Ampola Chumbada, um Tubo de Bronze e uma Bobina de Seda Chartreuse Leve. "Ite" nenhuma se cura sozinha, <meu/minha> jovem.‡Принесите Доку Миксиль-Пиксилю один букетик простых полевых цветов, одну освинцованную колбу, одну бронзовую трубку и одну катушку светлого зеленовато-желтого шелка. Чтотит, знаете ли, сам собой не проходит.‡Bringt Dok Mixilpixil 1 Bündel einfache Wildblumen, 1 verbleite Phiole, 1 Bronzeröhre und 1 Rolle blassgelben Seidenfaden. So eine \'Itis\' heilt sich nicht von selbst, <junger Herr/junge Dame>.‡닥 믹실픽실에게 수수한 야생화, 가연 약병 1개, 청동관 1개, 그리고 밝은 황록색 비단 실타래 1개를 가져가야 합니다. \'그것\'은 저절로 낫지 않는 병인 것 같습니다.‡Lleva a Doc Mixilpixil un ramo de flores silvestres simples, un vial emplomado, un tubo de bronce y una bobina de hilo de seda chartreuse. La \'itis\' no se cura sola, <jovencito/jovencita>.‡Lleva a Doc Mixilpixil un ramo de flores silvestres simples, un vial emplomado, un tubo de bronce y una bobina de hilo de seda verde pistacho. La \'itis\' no se cura sola, <jovencito/jovencita>.‡Apporter au docteur Mixilpixil une Brassée de Fleurs sauvages simples, une Fiole plombée, un Tube en Bronze et une Bobine de Fil de soie chartreuse. Le itis ne guérit pas tout seul.‡给道克·米希匹克斯带去一束普通野花、一只铅瓶，一根青铜管，最后还要一卷淡绿色丝线。伊提斯综合症可不会不治而愈，年轻的<先生/小姐>。‡給道克·米希匹克斯帶去一束普通野花、一隻鉛瓶，一根青銅管，最後還要一卷淡綠色絲線。伊提斯綜合症可不會不治而愈，年輕的<先生/小姐>。',
  }
},
[2621] = {
  {
    'O desonrado‡Опозоренный‡Der Entehrte‡명예를 잃은 자‡El deshonrado‡El deshonrado‡Le déshonoré‡悔恨的战士‡悔恨的戰士',
    nil,
    'Fale com o Comandante de Expedição Ruag em Pedregal.‡Поговорите с командиром разведотряда Руагом в Каменоре.‡Sprecht in Steinard mit Zentralenkommandant Ruag.‡스토나드에 있는 파견사령관 루아그와 대화해야 합니다.‡Habla con el comandante de despachos Ruag en Rocal.‡Habla con el comandante de envíos Ruag en Rocal, en el Pantano de las Penas.‡Aller voir le commandant d\'ordonnance Ruag dans Pierrêche.‡与斯通纳德的分队指挥官鲁尔格谈一谈。‡與斯通納德的分隊指揮官盧爾格談話。',
  }
},
[2622] = {
  {
    'As ordens desaparecidas‡Пропавшие приказы‡Die fehlenden Befehle‡잃어버린 명령서‡Las órdenes perdidas‡Las órdenes perdidas‡Les ordres disparus‡丢失的命令‡遺失的命令',
    nil,
    'Fale com Bengor.‡Поговорите с Бенгором.‡Sprecht mit Bengor.‡벤고르와 대화하십시오.‡Habla con Bengor.‡Habla con Bengor en Rocal, en el Pantano de las Penas.‡Aller voir Bengor.‡与本戈尔谈一谈。‡與本戈爾談話。',
  }
},
[2623] = {
  {
    'O falastrão do pantanal‡Болотный говорун‡Der Sumpfredner‡수다쟁이 늪지멀록‡La Voz del pantano‡La voz del pantano‡Le Parleur des marécages‡沼泽空谈者‡沼澤空談者',
    nil,
    'Recupere as Ordens do Chefe Guerreiro e devolva-as ao Herói Caído da Horda.‡Заберите приказы вождя и верните их павшему герою Орды.‡Beschafft die Befehle des Kriegshäuptlings wieder und gebt sie dem gefallenen Helden der Horde zurück.‡대족장의 명령서를 회수해 호드 영웅의 넋에게 가져가야 합니다.‡Recupera las órdenes del Jefe de Guerra y vuelve junto al Héroe caído de la Horda.‡Recupera las órdenes del Jefe de Guerra y vuelve junto al héroe caído de la Horda.‡Retrouver les Ordres du Chef de guerre et les rendre au Héros de la Horde tombé au combat.‡取回酋长的命令，把它们还给部落英雄的灵魂。‡取回酋長的命令，把它們還給部落英雄的靈魂。',
  }
},
[2641] = {
  {
    'O Ingrediente Secreto de Sguisha‡Маленький секрет Поливалки‡Sprinkels Geheimzutat‡스프링클의 비밀 재료‡El ingrediente secreto de Roxio‡El ingrediente secreto de Roxio‡L\'ingrédient secret de Sprinkle‡斯普琳科的秘密佐料‡斯普琳科的秘密佐料',
    nil,
    'Sguisha, em Geringontzan, quer que você colete um Tragão Violeta e fale novamente com ela.‡Найдите фиалковый траган и вернитесь к Поливалке в Прибамбасск.‡Sprinkel in Gadgetzan möchte, dass Ihr einen violetten Tragan sucht und ihr bringt.‡가젯잔에 있는 스프링클이 제비수염버섯을 하나 구해 가지고 올 것을 부탁했습니다.‡Roxio de Gadgetzan quiere que consigas un tragano violeta y se lo lleves.‡Roxio de Gadgetzan quiere que consigas un tragano violeta y se lo lleves.‡Saupoudr, de Gadgetzan, vous demande de cueillir un Tragan violet et de le lui apporter.‡加基森的斯普琳科要你去给她找到一颗紫色水生菇。‡加基森的斯普琳科要你去給她找到一顆紫色水生菇。',
  }
},
[2661] = {
  {
    'Uma entrega para Marin‡Посылка для Синя‡Lieferung für Marin‡마린에게 배달‡Un envío para Marin‡Un envío para Marin‡Livraison pour Marin‡给马林的粉末‡給馬林的粉末',
    nil,
    'Sguisha quer que você leve o Pó Violeta para Marin Nublacuca em Geringontzan.‡Отнесите фиалковый порошок Синю Гогельмогелю в Прибамбасск.‡Sprinkel möchte, dass Ihr das violette Pulver nach Gadgetzan zu Marin Noggenfogger bringt.‡스프링클이 가젯잔에 있는 마린 노겐포저에게 제비수염 가루를 가져가라고 부탁했습니다.‡Roxio quiere que le lleves las partículas violeta a Marin Tragonublo a Gadgetzan.‡Roxio quiere que le lleves las partículas violeta a Marin Tragonublo a Gadgetzan.‡Saupoudr vous demande d\'apporter la Poudre violette à Marin Brouillecaboche à Gadgetzan.‡斯普琳科让你把紫色粉末交给加基森的马林·诺格弗格。‡斯普琳科讓你把紫色粉末交給加基森的馬林·諾格弗格。',
  }
},
[2662] = {
  {
    'O Elixir Nublacuca‡Эликсир Ноггенфоггера‡Noggenfoggers Elixier‡노겐포저의 비약‡El elixir de Tragonublo‡El elixir de Tragonublo‡Elixir Brouillecaboche‡诺格弗格药剂‡諾格弗格藥劑',
    nil,
    'Marin Nublacuca quer que você volte a falar com ele depois que ele criar o elixir.‡Синь Гогельмогель хочет поговорить с вами после завершения работы над эликсиром.‡Marin Noggenfogger möchte, dass Ihr ihn nochmals ansprecht, wenn er sein Elixier fertiggestellt hat.‡마린 노겐포저가 비약이 완성되길 잠시 기다렸다가 다시 말을 걸어 달라고 부탁했습니다.‡Marin Tragonublo quiere que hables con él cuando acabe de preparar el elixir.‡Marin Tragonublo quiere que hables con él cuando acabe de preparar el elixir.‡Retourner voir Marin Brouillecaboche une fois qu\'il aura créé son élixir.‡马林·诺格弗格让你在他制成药剂之后再去找他。‡馬林·諾格弗格讓你在他製成藥劑之後再去找他。',
  }
},
[2681] = {
  {
    'As pedras que nos unem‡Камни, что связывают нас‡Die Steine, die uns binden‡속박의 돌‡Las piedras que nos vinculan‡Las piedras que nos vinculan‡Les pierres qui nous lient‡禁锢我们的石头‡禁錮我們的石頭',
    nil,
    'Liberte nove Serviçais de Razelikh, três Serviçais de Sevine, três Serviçais de Allistarj e três Serviçais de Grol, depois fale novamente com o Herói Caído. Você precisa estar sempre próxim<O/a> das pedras ou o processo fracassará.‡Освободите девять слуг Разелиха, трех слуг Севины, трех слуг Аллистария и трех слуг Грола. Когда ваша задача будет выполнена, возвращайтесь к павшему герою. Вы должны оставаться поблизости от камней, иначе процесс не будет завершен.‡Befreit 9 Diener von Razelikh, 3 Diener von Sevine, 3 Diener von Allistarj und 3 Diener von Grol. Kehrt zum gefallenen Helden zurück, sobald Ihr die Aufgabe erfüllt habt. Ihr müsst nahe bei den Steinen bleiben, sonst habt Ihr keinen Erfolg.‡라젤리크의 하수인 9명, 세바인의 하수인 3명, 알리스타즈의 하수인 3명, 그롤의 하수인 3명을 해방시킨 후, 호드 영웅의 넋에게 돌아가야 합니다. 돌 가까이 있지 않으면 임무에 실패하게 됩니다.‡Libera a 9 sirvientes de Razelikh, 3 sirvientes de Sevine, 3 sirvientes de Allistarj y 3 sirvientes de Grol. Vuelve junto al Héroe Caído cuando hayas acabado la tarea. Debes permanecer cerca de las piedras o el proceso no funcionará.‡Libera a 9 sirvientes de Razelikh, 3 sirvientes de Sevine, 3 sirvientes de Allistarj y 3 sirvientes de Grol. Vuelve junto al Héroe Caído cuando hayas acabado la tarea. Debes permanecer cerca de las piedras o el proceso no funcionará.‡Libérer 9 Serviteurs de Razelikh, 3 Serviteurs de Sevine, 3 Serviteurs d\'Allistarj et 3 Serviteurs de Grol. Retourner voir le Héros de la Horde tombé au combat une fois la tâche terminée. Il faut rester à proximité des pierres ou le processus échouera.‡解救九个拉瑟莱克的仆从、三个瑟温妮的仆从、三个奥利斯塔的仆从和三个戈洛尔的仆从。完成任务后，回到部落英雄的灵魂这里。‡解救九個拉瑟萊克的僕從、三個瑟溫妮的僕從、三個奧利斯塔的僕從和三個戈洛爾的僕從。完成任務後，回到部落英雄的靈魂這裡。',
  }
},
[2701] = {
  {
    'Heróis de outrora‡Герои древних времен‡Helden der Vergangenheit‡과거의 영웅‡Los héroes de los antiguos‡Los héroes de los antiguos‡Les héros des Anciens‡古代英雄‡古代英雄',
    nil,
    'Abra o baú e receba a sua recompensa.‡Откройте шкатулку и возьмите награду.‡Öffnet die Truhe und nehmt Euch Eure Belohnung.‡궤짝을 열고 보상을 받으십시오.‡Abre el cofre y reclama tu recompensa.‡Abre el cofre y reclama tu recompensa.‡Ouvrir le coffre et prendre la récompense.‡打开箱子，取走你的酬劳。‡打開箱子，取走你的酬勞。',
  }
},
[2702] = {
  {
    'Heróis de outrora‡Герои древних времен‡Helden der Vergangenheit‡과거의 영웅‡Los héroes de los antiguos‡Los héroes de los antiguos‡Les héros des Anciens‡古代英雄‡古代英雄',
    nil,
    'Fale com o Cabo Thund Casco Fendido.‡Поговорите с капралом Тундом Треснувшим Копытом.‡Sprecht mit Korporal Thund Spalthuf.‡하사관 선드 스플릿후프와 대화하십시오.‡Habla con el cabo Thund Pezuña Quebrada.‡Habla con el cabo Thund Pezuña Quebrada.‡Aller voir le caporal Thund Sabot-fendu.‡和桑德·裂蹄谈一谈。‡和裂蹄下士談話。',
  }
},
[2721] = {
  {
    'Kirith‡Кирит‡Kirith‡키리스‡Kirith‡Kirith‡Kirith‡基利斯‡基利斯',
    nil,
    'Descubra que fim levou o Tenente Kirith.‡Узнайте, что стало с лейтенантом Киритом.‡Findet heraus, was aus Leutnant Kirith geworden ist.‡키리스 부관이 어떻게 되었는지 알아보십시오.‡Averigua qué le ha ocurrido al teniente Kirith.‡Averigua qué le ha ocurrido al teniente Kirith.‡Découvrir ce qui est arrivé au Lieutenant Kirith.‡找到基利斯的下落。‡找到基利斯中尉的下落。',
  }
},
[2741] = {
  {
    'O super ovomático‡Супер Яйц-О-Матик‡Der Super-Ei-O-Mat‡고성능 자동부화기‡El Superhuevomático‡El Superhuevomático‡Le Super-Oeuf-O-Matic‡超级测蛋器‡超級測蛋器',
    nil,
    'O super ovomático é a mais recente invenção de Crista Dapinote. É uma máquina realmente impressionante.nnO super ovomático tremelica loucamente quando alguém se aproxima do painel de controle.‡Супер Яйц-О-Матик – последнее изобретение Кургль Поскакушки. Очень впечатляющее устройство.nnПриближаясь к панели управления, вы слышите, как машина яростно гудит.‡Der Super-Ei-O-Mat ist die neueste Erfindung von Curgle Cranklehop. Es ist eine ziemlich beeindruckende Maschine.nnDer Super-Ei-O-Mat fängt wild an zu spucken und zu zischen, als Ihr Euch der Steuerkonsole nähert.‡고성능 자동부화기는 커글 크랭크홉의 최신 발명품으로 상당히 멋진 기계입니다.nn고성능 자동부화기의 제어판에 다가가자 거친 소리가 납니다.‡El Superhuevomático es uno de los últimos inventos de Curgle Saltamanivela. Se trata de una máquina impresionante.nnEl Superhuevomático chisporrotea cuando te acercas al panel de control.‡‡Le Super-Oeuf-O-Matic est la dernière des inventions de Curgle Cranklehop. C\'est une machinerie très impressionnante.nnLe Super-Oeuf-O-Matic bafouille quelque chose lorsque vous vous approchez du panneau de commande.‡‡',
  }
},
[2742] = {
  {
    'Rin\'ji está preso!‡Рин\'джи в ловушке‡Rin\'ji steckt in der Falle!‡갇혀 있는 린지‡¡Capturaron a Rin\'ji!‡¡Capturaron a Rin\'ji!‡Rin\'ji est pris au piège !‡林吉被困住了！‡林吉被困住了!',
    nil,
    'Escolte Rin\'ji para fora do Pavilhão Quel\'Danil, depois encontre o segredo que ele esconde nos Penhascos Panorâmicos a leste.‡Выведите Рин\'джи из Сторожки Кель\'Данил, а потом найдите то, что он спрятал в Отвесных скалах, на востоке.‡Eskortiert Rin\'ji aus der Jagdhütte von Quel\'Danil heraus und findet dann das, was er bei den Aussichtsklippen im Osten versteckt hat.‡린지를 호위해 쿠엘다닐 오두막을 빠져나간 후 그가 동쪽에 전망대 절벽에 숨겨두었다는 비밀 물건을 찾아내십시오.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Escorter Rin\'ji hors du Gîte de Quel\'Danil, puis découvrir son secret caché sur les Hauts-Surplombs, à l\'est.‡护送林吉逃出奎尔丹尼小屋，然后在望海崖找到他藏起来的东西。‡護送林吉逃出奎爾丹尼小屋，然後在望海崖找到他藏起來的東西。',
  }
},
[2743] = {
  {
    'O abrigo das trevas‡Покров Тьмы‡Der Mantel der Dunkelheit‡어둠의 엄습‡La cubierta de la Oscuridad‡La cubierta de la Oscuridad‡Le couvert de l\'obscurité‡黑暗笼罩‡黑暗籠罩',
    nil,
    'Fale novamente com o Herói Caído da Horda e conte suas descobertas.‡Вернитесь к павшему герою Орды со своими находками.‡Kehrt mit Euren neuen Erkenntnissen zum gefallenen Helden der Horde zurück.‡호드 영웅의 넋에게 돌아가서 키리스로부터 알아낸 정보를 보고해야 합니다.‡Vuelve junto al Héroe caído de la Horda con tus hallazgos.‡Vuelve junto al héroe caído de la Horda con tus hallazgos.‡Retourner voir le Héros déchu de la Horde avec ces découvertes.‡回去见部落英雄的灵魂，将你的发现告诉他。‡回去見部落英雄的靈魂，將你的發現告訴他。',
  }
},
[2744] = {
  {
    'O caçador de demônios‡Охотник на демонов‡Der Dämonenjäger‡악마사냥꾼‡El cazademonios‡El cazademonios‡Le chasseur de démons‡恶魔猎手‡惡魔獵人',
    nil,
    'Fale com Loramus Talípedes em Azshara.‡Поговорите в Азшаре с Лорамусом Многоногом.‡Sprecht mit Loramus Thalipedes in Azshara.‡아즈샤라에 있는 로라무스 탈리뻬데스와 대화하십시오.‡Habla con Loramus Thalimedes en Azshara.‡Habla con Loramus Thalimedes en Azshara.‡Aller voir Loramus Thalipedes à Azshara.‡与艾萨拉的洛拉姆斯·萨里比迪斯谈一谈。‡與艾薩拉的洛拉姆斯·薩里比迪斯談話。',
  }
},
[2745] = {
  {
    'Infiltrando-se no castelo‡Проникновение в крепость‡Eindringen ins Schloss‡성 잠입‡Infíltrate en el castillo‡Infíltrate en el castillo‡En infiltrant le Château‡潜入城堡‡潛入城堡',
    nil,
    'Fale com Tyrion no Castelo Ventobravo.‡Поговорите с Тирионом в крепости Штормграда.‡Sprecht in Schloss Sturmwind mit Tyrion.‡스톰윈드 성에 있는 티리온과 대화해야 합니다.‡Habla con Tyrion en el Castillo de Ventormenta.‡Habla con Tyrion en el Castillo de Ventormenta.‡Aller voir Tyrion au Château de Hurlevent.‡与暴风城堡的泰里恩谈一谈。‡與暴風城堡的泰里恩談話。',
  }
},
[2746] = {
  {
    'Itens de alguma consequência‡Все по порядку‡Nicht unwichtige Gegenstände‡변장에 필요한 물건‡Objetos importantes‡Objetos importantes‡Des objets d’une certaine importance‡必备物品‡必備物品',
    nil,
    'Leve 3 Sedas e 2 Maçãs Frescas da Clara para Tyrion em Ventobravo.‡Принесите Тириону в Штормград 3 отреза шелка и 2 свежих яблока Клары.‡Bringt 3 Stück Seidenstoff und 2 frische Äpfel von Clara nach Sturmwind zu Tyrion.‡스톰윈드에 있는 티리온에게 비단 옷감 3개와 클라라의 싱싱한 사과 2개를 가져가야 합니다.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Apporter 3 Etoffes de soie et 2 Pommes fraîches de Clara à Tyrion à Hurlevent.‡将3块丝绸和2只克拉拉的新鲜苹果交给暴风城的泰里恩。‡將3塊絲綢和2顆克拉拉的新鮮蘋果交給暴風城的泰里恩。',
  }
},
[2747] = {
  {
    'Um ovo extraordinário‡Необычное яйцо‡Ein außergewöhnliches Ei‡비범한 알‡Un huevo muy especial‡Un huevo muy especial‡Un œuf extraordinaire‡特别的蛋‡特別的蛋',
    nil,
    '‡Редко удается принести яйца из Фераласа в таком необыкновенном состоянии. Они очень редко встречаются...‡Ich habe bisher nur sehr wenige Eier gesehen, die in außergewöhnlich gutem Zustand aus Feralas geholt wurden. Diese Eier sind extrem selten...‡페랄라스에서 비범한 알을 구해오는 경우는 별로 보지 못했어요. 너무 희귀한 알이라서...‡‡‡J\'ai rarement vu des œufs récupérés en Feralas dans un état satisfaisant. Ces œufs comptent parmi les plus rares…‡‡',
  }
},
[2748] = {
  {
    'Um ovo fecundo‡Хорошее яйцо‡Ein gutes Ei‡좋은 알‡Un huevo de primera‡Un huevo de primera‡Un œuf de premier choix‡优良的蛋‡優良的蛋',
    nil,
    '‡Из хороших яиц при правильных условиях вылупляются гиппогрифы, не пораженные заклинаниями огров клана Гордунни.‡Ein gutes Ei ist ein Ei, aus dem idealerweise ein Jungtier schlüpft, das frei von den bösen Auswirkungen der Beschwörungen der Oger der Gordunni ist.‡좋은 알이란 이상적인 조건에서 골두니 오우거의 나쁜 마법의 영향을 받지 않고 부화할 수 있는 알이랍니다.‡‡‡Un œuf de premier choix est un œuf qui, dans des conditions idéales, va éclore libre des effets néfastes des incantations des ogres Gordunni.‡‡',
  }
},
[2749] = {
  {
    'Um ovo comum‡Обычное яйцо‡Ein gewöhnliches Ei‡평범한 알‡Un huevo normal‡Un huevo normal‡Un œuf ordinaire‡普通的蛋‡普通的蛋',
    nil,
    '‡Обычные яйца гиппогрифа вылупляются только в половине случаев. Мы будем тщательно ухаживать за ними, и при удаче кто-нибудь из них вылупится.‡Normalerweise schlüpft etwa aus jedem zweiten Hippogryphen-Ei auch ein Jungtier. Wir hegen und pflegen die Eier nach besten Kräften, und wenn wir Glück haben, dann schlüpft am Ende etwas da raus.‡평범한 히포그리프 알은 절반 정도가 부화를 하죠. 우리가 최선을 다해 뒷바라지를 하고 운이 좋으면 부화를 하게 된답니다.‡‡‡Les œufs ordinaires d\'hippogryphes éclosent une fois sur deux. Nous faisons de notre mieux pour les élever et avec une petite chance, ils écloront.‡‡',
  }
},
[2750] = {
  {
    'Um ovo gorado‡Плохое яйцо‡Ein schlechtes Ei‡상해버린 알‡Un huevo pasado‡Un huevo pasado‡Un mauvais œuf‡坏掉的蛋‡壞掉的蛋',
    nil,
    '‡Яйца вроде этого не спасти – из них никто не вылупится.‡Diese Eier können nicht gerettet werden - aus ihnen wird niemals etwas schlüpfen.‡이 알은 되살릴 수 없습니다. 그러니까 절대 부화되지 않는단 말이죠.‡Estos huevos no tienen salvación; son huevos que nunca eclosionarán.‡‡Ces œufs-là ne peuvent pas être sauvés : ils n\'écloront jamais.‡‡',
  }
},
[2751] = {
  {
    'Muralhas bárbaras‡Варварские доспехи‡Barbarische Waffenschmiedekunst‡야만전사의 갑옷‡Almenas barbáricas‡Almenas barbáricas‡Remparts barbares‡野人装甲‡野人裝甲',
    nil,
    'Leve duas Braçadeiras Decoradas de Bronze, duas Montantes de Bronze e duas Garras Afiadas para Orokk Omosh em Orgrimmar.‡Принесите 2 узорчатых бронзовых боевых браслета, 2 бронзовых больших меча и 2 острых когтя Орокку Омошу в Оргриммар.‡Bringt 2 gemusterte bronzene Armschienen, 2 bronzene Großschwerter und 2 scharfe Klauen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 무늬 팔보호구 2개, 청동 대검 2개, 날카로운 발톱 2개를 가져다주어야 합니다.‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.|n‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.‡Apporter 2 Brassards guillochés en bronze, 2 Glaives en bronze et 2 Griffes aiguisées à Orokk Omosh à Orgrimmar.‡将2副青铜花纹护腕、2把青铜巨剑和2只锋利的爪子交给奥格瑞玛的奥罗克·沃姆什。‡將2副青銅花紋護腕、2把青銅巨劍和2隻鋒利的爪子交給奧格瑪的奧羅克·沃姆什。',
  }
},
[2752] = {
  {
    'Em brafoneiras de ferro‡За железными наплечниками‡Über Eisenschulterstücke‡강철 어깨갑옷‡Espaldares de hierro‡Espaldares de hierro‡Épaulettes en fer‡铁肩铠‡',
    nil,
    'Leve quatro Machados de Batalha de Bronze e quatro Martelos de Guerra de Bronze para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 4 бронзовых боевых топора и 4 бронзовых боевых молота.‡Bringt 4 bronzene Streitäxte und 4 bronzene Kriegshämmer zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 전투도끼 4개와 청동 전투해머 4개를 가져다주어야 합니다.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Apporter 4 Haches de guerre en bronze et 4 Marteaux de guerre en bronze à Orokk Omosh à Orgrimmar.‡将4把青铜战斧和4把青铜战锤交给奥格瑞玛的奥罗克·沃姆什。‡',
  }
},
[2753] = {
  {
    'Esmagado sob os calcanhares‡Тяжелая поступь‡In den Boden getrampelt‡발 밑의 적‡¡Aplástalos!‡¡Aplástalos!‡Piétinés‡踩在脚下‡',
    nil,
    'Leve quatro Elmos Verdes de Ferro, quatro Braçadeiras Verdes de Ferro e duas Perneiras Verdes de Ferro para Orokk Omosh em Orgrimmar.‡Принесите 4 зеленых железных шлема, 4 пары зеленых железных наручей и 2 пары зеленых железных поножей Орокку Омошу в Оргриммар.‡Bringt 4 grüne Eisenhelme, 4 grüne Eisenarmschienen und 2 grüne Eisengamaschen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 녹색 철제 투구 4개, 녹색 철제 팔보호구 4개, 녹색 철제 다리보호구 2개를 가져다주어야 합니다.‡Lleva 4 yelmos de hierro verdes, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Lleva 4 yelmos de hierro verde, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Apporter 4 Heaumes en fer émeraude, 4 Brassards en fer émeraude et 2 Jambières en fer émeraude à Orokk Omosh à Orgrimmar.‡将4顶绿铁头盔、4副绿铁护腕和4副绿铁护腿交给奥格瑞玛的奥罗克·沃姆什。‡',
  }
},
[2754] = {
  {
    'Trompas de frenesi‡Рога безумия‡Hörner der Raserei‡광란의 뿔‡Cuernos de frenesí‡Cuernos de frenesí‡Les cornes de Frénésie‡疯狂之角‡',
    nil,
    'Leve dois Malhos de Ferro Maciço, duas Botas de Bronze Prateado e duas Manoplas de Bronze Prateado para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 2 прочных железных кувалды, 2 пары посеребренных бронзовых сапог и 2 пары посеребренных бронзовых рукавиц.‡Bringt 2 robuste Eisenschlägel, 2 bronzene Stiefel mit Versilberung und 2 bronzene Stulpen mit Versilberung zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 튼튼한 철제 마울 2개, 은도금한 청동 장화 2개, 그리고 은도금한 청동 장갑 2개를 가져다주어야 합니다.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Apporter 2 Solides maillets en fer, 2 Bottes en bronze argenté et 2 Gantelets en bronze argenté à Orokk Omosh à Orgrimmar.‡将2只结实的铁锤、2双镀银青铜战靴和2副镀银青铜手套交给奥格瑞玛的奥罗克·沃姆什。‡',
  }
},
[2755] = {
  {
    'Alegria dos Omosh‡Радости Омоша‡Freude der Omoshs‡오모쉬의 기쁨‡Las alegrías de los Omosh‡Las alegrías de los Omosh‡Les joies des Omosh‡沃姆什的喜悦‡',
    nil,
    'Observe e aprenda a Dancinha da Alegria dos Omosh.‡Научитесь танцу Радости Омошей.‡Seht zu und lernt den Freudentanz der Omoshs.‡오모쉬가 추는 기쁨의 춤을 보고 배워야 합니다.‡Mira la danza de la alegría de los Omosh.‡Mira la danza de la alegría de los Omosh.‡Regarder et apprendre la Danse de joie des Omosh.‡观察并学习沃姆什的喜悦之舞。‡',
  }
},
[2756] = {
  {
    'Como antigamente‡Старые обычаи‡Die alten Traditionen‡과거의 방식‡Los viejos hábitos‡Los viejos hábitos‡Les vieilles voies‡古老的技艺‡古老的技藝',
    nil,
    'Leve 4 Peitorais de Aço e 4 Elmos de Placa de Aço para Aturk, o Bigorna, em Orgrimmar.‡Принесите 4 стальные кирасы и 4 стальных латных шлема Атурку Наковальне в Оргриммар.‡Bringt 4 Stahlbrustplatten und 4 Stahlplattenhelme zu Aturk dem Amboss in Orgrimmar.‡오그리마에 있는 무쇠모루 아투르크에게 강철 흉갑 4개와 강철 판금 투구 4개를 가져다주어야 합니다.‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.|n‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.‡Apporter 4 Cuirasses en acier et 4 Heaumes en plaques d\'acier à Aturk l\'Enclume à Orgrimmar.‡将4套钢质胸甲和4顶钢质头盔交给奥格瑞玛的铁砧阿图尔克。‡將4套鋼質胸甲和4頂鋼質頭盔交給奧格瑪的『鐵砧』阿圖爾克。',
  }
},
[2757] = {
  {
    'Angra do Butim ou Mina de Mithril?‡Вперед, в Пиратскую Бухту!‡Auf nach Beutebucht!‡무법항으로!‡¡Bahía del Botín o nada!‡¡Bahía del Botín o nada!‡Baie-du-Butin ou la mort !‡藏宝海湾之旅！‡',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской бухте.‡Sprecht mit McGavan in Beutebucht.‡무법항에 있는 맥개번과 대화하십시오.‡Habla con McGavan en Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡',
  }
},
[2758] = {
  {
    'As origens da ferraria‡Происхождение кузнечного искусства‡Die Herkunft der Schmiedekunst‡대장기술의 근원‡El origen de la herrería‡El origen de la herrería‡Les origines de la forge‡锻造的本源‡鍛造的起源',
    nil,
    'Leve 6 Braçadeiras de Escama Dourada para Marcelo, o Martelo em Ventobravo.‡Принесите 6 пар золотых чешуйчатых наручей Хэнку Молоту в Штормград.‡Bringt 6 goldene Schuppenarmschienen zu Hank dem Hammer in Sturmwind.‡스톰윈드에 있는 쇠망치 행크에게 황금 미늘 팔보호구 6개를 가져가야 합니다.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Apporter 6 Brassards en écailles dorées à Hank le Marteau à Hurlevent.‡将6副金鳞护腕交给暴风城的巨锤汉克。‡將6副金鱗護腕交給暴風城的『巨錘』漢克。',
  }
},
[2759] = {
  {
    'Em busca de Galvan‡В поисках Гальвана‡Auf der Suche nach Galvan‡갈반을 찾아서‡Buscando a Galvan‡Buscando a Galvan‡À la recherche de Galvan‡寻找加尔文‡',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской бухте.‡Sprecht in Beutebucht mit McGavan.‡무법항에 있는 맥개번과 대화해야 합니다.‡Habla con McGavan en la Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡',
  }
},
[2760] = {
  {
    'A Ordem do Mithril‡Орден Мифрила‡Der Mithrilorden‡미스릴 대장조합‡La Orden del mitril‡La Orden del mitril‡L\'ordre du Mithril‡秘银会‡秘銀會',
    nil,
    'Fale com Galvan, o Antigo, na Selva do Espinhaço.‡Поговорите с Гальваном Древним в Тернистой долине.‡Sprecht mit Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반과 대화해야 합니다.‡Habla con Galvan el Antiguo en la Vega de Tuercespina.|n‡Habla con Galvan el Antiguo en la Vega de Tuercespina.‡Aller voir Galvan l\'Ancien dans la vallée de Strangleronce.‡和荆棘谷的加尔文谈一谈。‡',
  }
},
[2761] = {
  {
    'Fundido e desfundido‡Плавим, не плавим, плавим, не плавим…‡Hier verhütten, da verhütten‡대장기술과 채광‡Funde o no funde‡Funde o no funde‡Ça fond, ça ne fond pas‡铁匠必修课‡鐵匠必修課',
    nil,
    'Leve 40 Barras de Mithril e 40 Barras de Ferro para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок железных слитков Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 40 Eisenbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴와 철 주괴를 각각 40개씩 가져가야 합니다.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 40 Barres de fer à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和40块铁锭交给荆棘谷的加尔文。‡將40塊秘銀錠和40塊鐵錠交給荊棘谷的『長者』加爾文。',
  }
},
[2762] = {
  {
    'O grande embuste prateado‡Обманное серебро‡Der große silberne Betrüger‡훌륭한 가짜배기 은‡La veraplata no es verídica‡La veraplata no es verídica‡Le vif-argent n’est pas de l\'argent‡白花花的银子‡白花花的銀子',
    nil,
    'Leve 40 Barras de Mithril e 5 Barras de Veraprata para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок слитков истинного серебра Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 5 Echtsilberbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 진은 주괴 5개를 가져가야 합니다.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 5 Barres de vrai-argent à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和5块真银锭交给荆棘谷的加尔文。‡將40塊秘銀錠和5塊真銀錠交給荊棘谷的『長者』加爾文。',
  }
},
[2763] = {
  {
    'A arte de imbuir‡Могущество камней‡Die Kunst der Magieerfüllung‡보석 채취‡El arte de imbuir‡El arte de imbuir‡L\'art de l\'imprégnation‡灌魔工艺‡灌魔工藝',
    nil,
    'Leve 40 Barras de Mithril e 4 Citrinos para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и 4 цитрина Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 4 Citrine.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 황수정 4개를 가져가야 합니다.‡Lleva cuarenta barras de mitril y cuatro citrinos a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cuatro citrinos a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 4 Citrines à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和4块黄水晶交给荆棘谷的加尔文。‡將40塊秘銀錠和4塊黃水晶交給荊棘谷的『長者』加爾文。',
  }
},
[2764] = {
  {
    'O melhor pupilo de Galvan‡Лучший ученик Гальвана‡Galvans bester Schüler‡갈반의 수제자‡El mejor alumno de Galvan‡El mejor alumno de Galvan‡Le meilleur disciple de Galvan‡加尔文的得意门生‡',
    nil,
    'Fale com Trenton Lumartelo em Geringontzan.‡Поговорите с Трентоном Молотом Света из Прибамбасска.‡Sprecht in Gadgetzan mit Trenton Lichthammer.‡가젯잔에 있는 트렌튼 라이트해머와 대화해야 합니다.‡Habla con Trenton Mazaligera en Gadgetzan.‡Habla con Trenton Mazaligera en Gadgetzan, en Tanaris.‡Parler à Trenton Martelume à Gadgetzan.‡和加基森的特伦顿·轻锤谈一谈。‡',
  }
},
[2765] = {
  {
    'Ferreiro perito!‡Кузнец-умелец!‡Schmiedkunstexperte!‡고급 대장기술‡¡Experto herrero!‡¡Experto herrero!‡Maître Forgeron !‡锻造专家!‡',
    nil,
    'Pegue sua recompensa com Galvan, o Antigo!‡Получите награду у Гальвана Древнего!‡Fordert Eure Belohnung von Galvan dem Alten ein!‡전설의 대장장이 갈반에게서 보상을 받으십시오.‡Reclama tu recompensa a Galvan el Antiguo.‡Reclama tu recompensa a Galvan el Antiguo.‡Réclamez votre récompense à Galvan l\'Ancien !‡到加尔文那里拿取报酬！‡',
  }
},
[2766] = {
  {
    'Encontre o OOX-22/FE!‡Найти ККX-22/FE!‡Findet OOX-22/FE!‡OOX-22/FE 수색‡¡Encuentra a OOX-22/FE!‡¡Encuentra a OOX-22/FE!‡Trouvez OOX-22/FE !‡寻找OOX-22/FE！‡尋找OOX-22/FE!',
    nil,
    'Pegue o transmissor de emergência para o robô teleguiado de Olhatorto na caverna próxima ao Vale dos Abomináveis.‡Отнесите аварийный маяк к автономному роботу Карлса, в пещеру рядом с Долиной Свирепого Утеса.‡Bringt das Notrufsignal zu Glotz\' Leitroboter in einer Höhle in der Nähe des Wildschrammtals.‡거친흉터 골짜기에 있는 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Placer la balise de détresse dans le robot d\'Orguignard qui se trouve dans une caverne près du val des Griffes farouches.‡把定位器带到深痕谷附近山洞中的奥格索普的导航机器人旁边。‡把定位器帶到深痕谷附近山洞中的奧格索普的導航機器人旁邊。',
  }
},
[2767] = {
  {
    'Resgate o OOX-22/FE!‡Спасти ККX-22/FE!‡Die Rettung von OOX-22/FE‡OOX-22/FE 구출!‡¡Escolta a OOX-22/FE!‡¡Escolta a OOX-22/FE!‡Sauvez OOX-22/FE !‡拯救OOX-22/FE！‡拯救OOX-22/FE!',
    nil,
    'Escolte o OOX-22/FE até a doca ao longo da Costa Esquecida, depois apresente-se a Olhatorto Obnótico na Angra do Butim.‡Проводите OOX-22/FE в порт на Забытом Берегу, затем сообщите об этом Карлсу Пропеллерзу в Пиратской бухте.‡Eskortiert OOX-22/FE zum Dock an der Vergessenen Küste und meldet Euch dann bei Glotz Widrikus in Beutebucht.‡잊혀진 해안에 있는 부두까지 OOX-22/FE를 호위해 간 후 무법항에 있는 오글소프 오브노티쿠스에게 보고해야 합니다.‡Escolta a OOX-22/FE hasta el embarcadero por La Costa Olvidada y preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-22/FE para que llegue sano y salvo y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escorter OOX-22/FE au dock le long de la Côte oubliée, puis faire votre rapport à Orguignard Odipnoticus à Baie-du-Butin.‡将OOX-22/FE护送到被遗忘的海岸上的码头，然后向藏宝海湾的奥格索普-奥布诺提斯报告。‡將OOX-22/FE護送到被遺忘的海岸上的碼頭，然後向藏寶海灣的奧格索普·奧布諾提斯報告。',
  }
},
[2768] = {
  {
    'Bastão divinomático‡Изыскательский жезл‡Wünschel-mato-Rute‡자동 탐사막대‡Vara divinomática‡Vara divinomática‡Le bâtonnet divino-matic‡探水棒‡探水棒',
    nil,
    'Leve o Bastão Divinomático ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите изыскательский жезл главному инженеру Чепухастеру в Прибамбасск.‡Bringt die Wünschel-mato-Rute nach Gadgetzan zu Chefingenieur Bilgenritzel.‡가젯잔에 있는 선임기술자 빌지위즐에게 자동 탐사막대를 가져가야 합니다.‡Lleva la vara divinomática al ingeniero jefe Silvaina en Gadgetzan.‡Lleva la vara divinomática al ingeniero jefe Pasaquillas en Gadgetzan.‡Rapporter le Bâtonnet divino-matic à l\'Ingénieur en chef Vizisanie, à Gadgetzan.‡把探水棒交给加基森的首席工程师沙克斯-比格维兹。‡把探水棒交給加基森的首席工程師比格維茲。',
  }
},
[2769] = {
  {
    'Os irmãos Latafuso‡Братья Латунный Болт‡Die Brüder Kupferbolz‡브라스볼츠 형제‡Los hermanos Pernolatón‡Los hermanos Pernolatón‡Les frères Brassbolts‡铜栓兄弟‡銅栓兄弟',
    nil,
    'Fale com Capu Latafuso no Salar Cintilante.‡Поговорите с Виззлом Медноштифом на Мерцающей равнине.‡Sprecht mit Wizzel Kupferbolz in der schimmernden Ebene.‡소금 평원에 있는 위즐 브라스볼츠와 대화하십시오.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Parler à Wizzle Brassbolts dans les Salines.‡和闪光平原的维兹尔·铜栓谈一谈。‡和閃光平原的維茲爾·銅栓談話。',
  }
},
[2770] = {
  {
    'Gahz\'rilla‡Газ\'рилла‡Gahz\'rilla‡가즈릴라‡Gahz\'rilla‡Gahz\'rilla‡Gahz\'rilla‡加兹瑞拉‡加茲瑞拉',
    nil,
    'Leve a Escama Eletrificada de Gahz\'rilla para Capu Latafuso no Salar Cintilante.‡Принесите искрящую чешую Газ\'риллы Виззлу Медноштифу на Мерцающую равнину.‡Bringt Wizzel Kupferbolz in der schimmernden Ebene Gahz\'rillas elektrisierte Schuppe.‡소금 평원에 있는 위즐 브라스볼츠에게 가즈릴라의 전기 비늘을 가져가야 합니다.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Rapporter l\'Ecaille électrifiée de Gahz\'rilla à Lachnouf Zéboulon dans les Salines.‡把加兹瑞拉的鳞片交给闪光平原的维兹尔·铜栓。‡把加茲瑞拉的鱗片交給閃光平原的維茲爾·銅栓。',
  }
},
[2771] = {
  {
    'A ótima cabeça sobre os ombros‡Голова на плечах‡Ein schlauer Kopf auf den Schultern‡지혜로운 스승‡La cabeza sobre los hombros‡La cabeza sobre los hombros‡Une tête bien faite sur les épaules‡罩帽和护肩‡罩帽和護肩',
    nil,
    'Leve 2 Coifas de Mithril e 1 Ombreira Ornada de Mithril para Trenton Lumartelo.‡Принесите два мифриловых капюшона и изысканный мифриловый наплечник Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 Mithrilhelmkappen und 1 verschnörkelte Mithrilschulter.‡트렌튼 라이트해머에게 미스릴 코이프 2개와 화려한 미스릴 어깨보호구 1개를 가져가야 합니다.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux Camails en mithril et une paire d\'Epaulières ornées en mithril à Trenton Martelume.‡将2顶秘银罩帽和1副精制秘银护肩带秘银护肩交给特伦顿·轻锤。‡將2頂秘銀頭巾和1副華麗秘銀護肩帶秘銀護肩交給特倫頓·輕錘。',
  }
},
[2772] = {
  {
    'O mundo a seus pés‡Мир у твоих ног‡Die Welt zu Euren Füßen‡세상을 내 발아래‡El mundo a tus pies‡El mundo a tus pies‡Le monde à vos pieds‡世界在你脚下‡世界在你腳下',
    nil,
    'Leve 2 Botas Pesadas de Mithril e 1 Calça Ornada de Mithril para Trenton Lumartelo.‡Принесите две пары тяжелых мифриловых сапог и изысканные мифриловые штаны Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 schwere Mithrilstiefel und 1 verschnörkelte Mithrilhose.‡트렌튼 라이트해머에게 견고한 미스릴 장화 2개와 화려한 미스릴 바지 1개를 가져가야 합니다.‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.|n‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux paires de Bottes en mithril lourd et un Pantalon orné en mithril à Trenton Martelume.‡将2双秘银重靴和1条精制秘银短裤交秘银短裤交给特伦顿·轻锤。‡將2雙秘銀重靴和1條華麗秘銀便褲交給特倫頓·輕錘。',
  }
},
[2773] = {
  {
    'Kid Mithril‡Мифриловый парень‡Mithril-Kid‡미스릴 천재‡El chico de mitril‡El chico de mitril‡Le gars du mithril‡秘银小子‡秘銀小子',
    nil,
    'Leve 2 Peitorais Pesados de Mithril e 1 Luva Ornada de Mithril para Trenton Lumartelo.‡Принесите две тяжелых мифриловых кирасы и изысканные мифриловые перчатки Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 schwere Mithrilbrustplatten und 1 verschnörkelten Mithrilhandschuh.‡트렌튼 라이트해머에게 견고한 미스릴 흉갑 2개와 화려한 미스릴 장갑 1개를 가져가야 합니다.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Rapporter deux Cuirasses lourdes en mithril et une paire de Gants ornés en mithril à Trenton Martelume.‡将2件重型秘银胸甲和1副精制秘银手套带给特秘银手套交给特伦顿·轻锤。‡將2件重型秘銀胸甲和2副華麗秘銀手套交給特倫頓·輕錘。',
  }
},
[2781] = {
  {
    'PROCURA-SE: Califa Escorpicada‡Разыскивается: Калиф Жало Скорпида‡GESUCHT: Kalif Skorpidstich‡현상 수배: 칼리프 스콜피드스팅‡SE BUSCA: Escorpijón califa‡SE BUSCA: Califa Escorpijón‡ON RECHERCHE : Caliph Dard-de-scorpide‡通缉：卡利夫·斯科比斯汀‡懸賞:卡利夫·斯科比斯汀',
    nil,
    'Leve a cabeça de Califa Escorpicada ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите голову Калифа Жало Скорпида главному инженеру Чепухастеру в Прибамбасск.‡Bringt Chefingenieur Bilgenritzel in Gadgetzan den Kopf von Kalif Skorpidstich.‡칼리프 스콜피드스팅을 처치하고 그 증거로 그의 머리카락을 선임기술자 빌지위즐에게 가져다주어야 합니다.‡Llévale la cabeza de Escorpijón califa al ingeniero jefe Silvaina, que está en Gadgetzan.‡Llévale la cabeza de Califa Escorpijón al ingeniero jefe Pasaquillas, que está en Gadgetzan.‡Apporter la tête de Caliph Dard-de-scorpide à l\'Ingénieur en chef Vizisanie à Gadgetzan.‡将卡利夫·斯科比斯汀的头颅交给加基森的首席工程师沙克斯·比格维兹。‡將卡利夫·斯科比斯汀的頭顱交給加基森的首席工程師比格維茲。',
  }
},
[2782] = {
  {
    'O segredo de Rin\'ji‡Секрет Рин\'джи‡Rin\'jis Geheimnis‡린지의 비밀‡El secreto de Rin\'ji‡El secreto de Rin\'ji‡Secret de Rin\'ji‡林吉的秘密‡林吉的秘密',
    nil,
    'Urraca Convulserpe, uma acadêmica bastante reconhecida em assuntos relacionados às trolesas Cascasseca, pode ser capaz de decifrar a tabuleta. Ela mora no Distrito da Magia da Cidade Baixa.‡Отнесите табличку Оран Змеиные Кольца в Квартал Магов Подгорода. Оран – известная ученая, изучающая троллей из племени Сухокожих, и она наверняка сумеет прочесть надписи на табличке.‡Oran Schlangenfuß, eine bekannte Gelehrte auf dem Gebiet der Bleichborkentrolle, könnte die Tafel vielleicht übersetzen. Normalerweise hält sie sich im Magierviertel von Unterstadt auf.‡마른나무껍질 트롤에 관해서 누구보다 잘 알고 있는 저명한 학자인 오란 스네이크레이드라면 이 서판을 해독할 수 있을지도 모릅니다. 그녀는 언더시티의 마법 지구에 살고 있다고 합니다.‡Oran Contorpiente es una conocida erudita en los trols Secacorteza; quizá pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Snakewrithe es una conocida erudita en los trols Secacorteza; quizás pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Serpenroule, une érudite réputée pour sa connaissance des us et coutumes des trolls Fânécorces, pourrait peut-être déchiffrer la tablette. Elle habite le Quartier de la magie à Fossoyeuse.‡奥兰·斯内克威瑟是个学者，她对枯木巨魔很有研究，也许她可以帮你看看这块石板。奥兰就住在幽暗城的魔法区里。‡奧蘭·蛇繞，一個以研究枯木食人妖聞名的學者，她或許能幫你解讀這塊石板。她住在幽暗城的法師區。',
  }
},
[2783] = {
  {
    'Brigas mesquinhas‡Мелкие раздоры‡Kleinliches Gezänk‡사소한 말다툼‡Peleas mezquinas‡Peleas mezquinas‡Querelles mesquines‡争论‡爭論',
    nil,
    'Fale com o Herói Caído da Horda na fronteira entre Barreira do Inferno e o pântano.‡Поговорите с павшим героем Орды на границе Выжженных земель и болот.‡Sprecht mit dem gefallenen Helden der Horde im Grenzgebiet zwischen den verwüsteten Landen und dem Sumpf.‡저주받은 땅과 늪의 경계에 있는 호드 영웅의 넋과 대화하십시오.‡Habla con el Héroe caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Habla con el héroe caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Parler au Héros de la Horde tombé au combat à la frontière des Terres foudroyées et du marais.‡与诅咒之地和悲伤沼泽交界处的部落英雄的灵魂谈一谈。‡與詛咒之地和悲傷沼澤交界處的部落英雄的靈魂談話。',
  }
},
[2784] = {
  {
    'Caindo em desgraça‡Попавший в немилость‡In Ungnade fallen‡명예 실추‡Pérdida de honor‡Pérdida de honor‡Perte d\'honneur‡失落的荣耀‡失去的榮耀',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del Héroe caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écouter le Héros de la Horde tombé au combat raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2801] = {
  {
    'Uma história de tristeza‡Горестная повесть‡Eine Geschichte voller Leid‡슬픈 이야기‡Una historia triste‡Una historia triste‡Une histoire de chagrin‡悲伤的故事‡悲傷的故事',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del Héroe caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écouter le Héros de la Horde tombé au combat raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2821] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡최고의 품질‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡品質的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 толстых шкур йети Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 10 dicke Yetibälge.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti gruesos a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 pellejos de yeti gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Peaux de yéti épaisses à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去10张厚重的雪人皮。‡給羽月要塞的普拉特·馬克格魯比帶去10張厚重的雪人皮。',
  }
},
[2822] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡품질 표시‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡品質的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 толстых шкур йети Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 10 dicke Yetibälge.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti gruesos a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 10 pellejos de yeti gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 10 Peaux de yéti épaisses à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去十张厚重的雪人皮。‡給莫沙徹營地的杉多爾·迅蹄帶去十張厚重的雪人皮。',
  }
},
[2841] = {
  {
    'Guerra dos robôs‡Техновойны‡Maschinenkriege‡기술 전쟁‡Las guerras de la plataforma‡Las guerras de la plataforma‡Guerre des plates-formes‡设备之战‡設備之戰',
    nil,
    'Pegue a Combinação do Cofre do Termaplugue e o Projeto de Mecatraje e leve-os para Nogg em Orgrimmar.‡Добудьте в Гномрегане чертежи боевой машины и код от сейфа Термоштепселя в Гномрегане и принесите их Ноггу в Оргриммар.‡Besorgt die Maschinenblaupausen und Thermadrahts Safekombination aus Gnomeregan und bringt sie zu Nogg nach Orgrimmar.‡놈리건에서 장치 설계도와 텔마플러그의 금고 암호를 찾아서 오그리마에 있는 노그에게 가져다주어야 합니다.‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.|n‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.‡Obtenir la Combinaison du coffre de Thermojoncteur, prendre les Plans de la plate-forme et les apporter à Nogg à Orgrimmar.‡从诺莫瑞根拿到钻探设备蓝图和麦克尼尔的保险箱密码，把它们交给奥格瑞玛的诺格。‡從諾姆瑞根拿到鑽探設備藍圖和麥克尼爾的保險箱密碼，把它們交給奧格瑪的諾格。',
  }
},
[2842] = {
  {
    'Engenheiro-chefe Scooty‡Главный инженер Скути‡Chefingenieur Scooty‡선임기술자 스쿠티‡Scooty, ingeniero jefe‡Scooty, ingeniero jefe‡L\'ingénieur en chef Scooty‡主工程师斯库提‡首席工程師斯庫提',
    nil,
    'Fale com Scooty na Angra do Butim.‡Поговорите со Скути в Пиратской бухте.‡Sprecht mit Scooty in Beutebucht.‡무법항에 있는 스쿠티와 대화하십시오.‡Habla con Scooty en Bahía del Botín.‡Habla con Scooty en Bahía del Botín.‡Parler à Scooty à Baie-du-Butin.‡和藏宝海湾的斯库提谈一谈。‡和藏寶海灣的斯庫提談話。',
  }
},
[2843] = {
  {
    'E lá vamos nós!‡Поехалиии!‡Gnomer-weeeeg!‡놈리거어어어언!‡¡Gnomer-yaaaaa!‡¡Gnomer-yaaaaa!‡Gnomer-paaarti !‡出发！诺莫瑞根！‡出發!諾姆瑞根!',
    nil,
    'Esperar até Scooty calibrar o Transponder Goblínico.‡Дождитесь, пока Скути настроит гоблинский импульсный повторитель.‡Wartet, bis Scooty den Goblintransponder kalibriert hat.‡스쿠티가 고블린 응답장치를 조절하는 동안 기다려야 합니다.‡Espera a que Scooty calibre el transpondedor goblin.‡Espera a que Scooty calibre el transpondedor goblin.‡Attendre que Scooty calibre le Transpondeur gobelin.‡等斯库提调整好地精传送器。‡等斯庫提調整好哥布林傳送器。',
  }
},
[2844] = {
  {
    'O guardião gigante‡Великан-опекун‡Der Riesenwächter‡거대한 수호자‡El guardián gigante‡El guardián gigante‡Le garde géant‡大保姆‡大保姆',
    nil,
    'Encontre a elfa noturna desaparecida.‡Найдите потерявшуюся ночную эльфийку.‡Findet das verlorene Nachtelfenmädchen.‡길 잃은 나이트 엘프 소녀를 찾아야 합니다.‡Localiza a la elfa de la noche perdida.‡Localiza a la elfa de la noche perdida.‡Retrouver la jeune elfe de la nuit perdue.‡寻找走丢了的精灵小姑娘。‡尋找走丟了的精靈小姑娘。',
  }
},
[2845] = {
  {
    'Shay distraída‡Шай-бродяжница‡Streunende Shay‡방황하는 샤이‡Las andanzas de Shay‡Las andanzas de Shay‡Shay l\'égarée‡迷路的沙恩‡迷路的沙恩',
    nil,
    'Pegue o Sino de Shay do baú.nnEscolte Shay Velifrondes até o acampamento de Trinca-pedra.‡Достаньте из сундучка колокольчик Шай.nnПроводите Шай Листогон в лагерь Камнедробителя.‡Nehmt Shays Glocke aus der Truhe.nnBegleitet Shay Laubschleicher zu Felsbeißers Lager.‡궤짝에서 샤이의 종을 집어야 합니다.nn샤이 리프러너를 무쇠이빨의 야영지까지 호휘해야 합니다.‡Coge la campana de Shay del cofre.nnEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Coge la campana de Shay del cofre.|nEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Prendre la Cloche de Shay dans le coffre.nnEscorter Shay Coursefeuille au Camp de Croque-roc.‡从箱子里拿取沙恩的铃铛，然后护送沙恩·飘叶回到罗克比特的营地。‡從箱子裡拿取沙恩的鈴鐺，然後護送沙恩·飄葉回到羅克比特的營地。',
  }
},
[2846] = {
  {
    'Tiara das Profundezas‡Тиара глубин‡Tiara der Tiefen‡심연의 티아라‡Tiara de las Profundidades‡Tiara de las profundidades‡La tiare des abysses‡深渊皇冠‡深淵冠冕',
    nil,
    'Leve a Tiara das Profundezas para Tabetha no Pântano Vadeoso.‡Принесите Тиару Глубин Табете в Пыльную Трясину.‡Bringt die Tiara der Tiefen zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 심연의 티아라를 가져가야 합니다.‡Lleva la Tiara de las Profundidades a Tabetha en el Marjal Revolcafango.‡Lleva la tiara de las profundidades a Tabetha en el Marjal Revolcafango.‡Rapporter la Tiare des abysses à Tabetha au marécage d\'Âprefange.‡将深渊皇冠交给尘泥沼泽的塔贝萨。‡將深淵冠冕交給塵泥沼澤的塔貝薩。',
  }
},
[2847] = {
  {
    'Armadura de couro silvestre‡Доспехи из дикой кожи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir sauvage‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 кусков плотной кожи Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 10 Stücke dickes Leder.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Cuirs épais à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去10块厚皮。‡給羽月要塞的普拉特·馬克格魯比帶去10塊厚皮。',
  }
},
[2848] = {
  {
    'Omoplatas de couro silvestre‡Наплечники из дикой кожи‡Wildlederschultern‡야생 가죽 어깨보호구‡Sobrehombros de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir sauvage‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Pradal McGrubben, que fica no Domínio de Plumaluna.‡Принесите 6 накладок из толстой кожи и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 6 dicke Rüstungssets und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 refuerzos para armadura gruesos y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去6片厚重护甲片和1株野葡萄。‡',
  }
},
[2849] = {
  {
    'Colete de couro silvestre‡Жилет из дикой кожи‡Wildlederweste‡야생 가죽 조끼‡El Jubon de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir sauvage‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Schildkrötenschuppenbrustplatten, 2 Paar Schildkrötenschuppenhandschuhe und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡',
  }
},
[2850] = {
  {
    'Capacete de couro silvestre‡Шлем из дикой кожи‡Wildlederhelm‡야생 가죽 투구‡Casco de cuero salvaje‡Casco de cuero salvaje‡Le casque en cuir fauve‡蛮皮头盔‡蠻皮盔帽',
    nil,
    'Leve 2 Túnicas da Escapada Noturna, 2 Bandanas da Escapada Noturna e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 ночных мундира, 2 ночных головных повязки и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Tuniken des Nachtschleichers, 2 Stirnbänder des Nachtschleichers und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 튜닉 2개, 밤하늘 머리띠 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 túnicas Nochefugaz, 2 cintas Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Tuniques de la nuit, 2 Bandeaux de la nuit et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去2件夜色外套、2条夜色头巾和一株野葡萄。‡',
  }
},
[2851] = {
  {
    'Botas de couro silvestre‡Сапоги из дикой кожи‡Wildlederstiefel‡야생 가죽 장화‡Botas de cuero salvaje‡Botas de cuero salvaje‡Les bottes en cuir fauve‡蛮皮战靴‡蠻皮長靴',
    nil,
    'Leve 2 Calças da Escapada Noturna, 2 Botas da Escapada Noturna e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 пары ночных штанов, 2 пары ночных сапог и 2 диких лозы Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Hosen des Nachtschleichers, 2 Stiefel des Nachtschleichers und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 바지 2개, 밤하늘 장화 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Pantalons de la nuit, 2 paires de Bottes de la nuit et 2 Sauvageonnes à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去2条夜色裤、2双夜色靴和2株野葡萄。‡',
  }
},
[2852] = {
  {
    'Perneiras de couro silvestre‡Поножи из дикой кожи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir sauvage‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите два черепашьих чешуйчатых шлема, две пары черепашьих чешуйчатых наручей и две дикие лозы Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de escamas de tortuga, 2 brazales de escamas de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Pratt McGrubben au bastion de Feathermoon.‡给羽月要塞的普拉特·马克格鲁比带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡',
  }
},
[2853] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir fauve‡蛮皮护甲大师‡',
    nil,
    'Entregue a Carta de Pradal para Telonis, o mestre coureiro de Darnassus.‡Отдайте письмо Пратта Телонису, главному кожевнику Дарнасса.‡Gebt Telonis, dem Lederverarbeitungsmeister von Darnassus, Pratts Brief.‡다르나서스에 있는 가죽세공의 대가인 텔로니스에게 프랫의 편지를 가져가야 합니다.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Donner la Lettre de Pratt à Telonis, le Maître tanneur de Darnassus.‡将普拉特的信交给达纳苏斯的制皮大师泰龙尼斯。‡',
  }
},
[2854] = {
  {
    'Armadura de couro silvestre‡Доспехи из дикой кожи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir sauvage‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 кусков плотной кожи Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 10 Stücke dickes Leder.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 10 cueros gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 10 Cuirs épais à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去10块厚皮。‡給莫沙徹營地的杉多爾·迅蹄帶去10塊厚皮。',
  }
},
[2855] = {
  {
    'Omoplatas de couro silvestre‡Наплечники из дикой кожи‡Wildlederschultern‡야생 가죽 어깨보호구‡Sobrehombros de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir sauvage‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 6 накладок из толстой кожи и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 6 dicke Rüstungssets und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 refuerzos para armadura gruesos y 1 atriplex salvaje a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去6块厚重护甲片和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去6塊厚重護甲片和1株野葡萄。',
  }
},
[2856] = {
  {
    'Colete de couro silvestre‡Жилет из дикой кожи‡Wildlederweste‡야생 가죽 조끼‡El Jubon de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir fauve‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Schildkrötenschuppenbrustplatten, 2 Schildkrötenschuppenhandschuhe und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et une Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2件龜鱗胸甲、2副龜鱗手套和1株野葡萄。',
  }
},
[2857] = {
  {
    'Capacete de couro silvestre‡Шлем из дикой кожи‡Wildlederhelm‡야생 가죽 투구‡Casco de cuero salvaje‡Casco de cuero salvaje‡Le casque en cuir fauve‡蛮皮头盔‡蠻皮盔帽',
    nil,
    'Leve 2 Túnicas da Escapada Noturna, 2 Bandanas da Escapada Noturna e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 ночных мундира, 2 ночных головных повязки и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Tuniken des Nachtschleichers, 2 Stirnbänder des Nachtschleichers und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 밤하늘 튜닉 2개, 밤하늘 머리띠 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 túnicas Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Tuniques de la nuit, 2 Bandeaux de la nuit et 1 Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2件夜色外套、2条夜色头巾和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2件夜景外套、2條夜景頭巾和1株野葡萄。',
  }
},
[2858] = {
  {
    'Botas de couro silvestre‡Сапоги из дикой кожи‡Wildlederstiefel‡야생 가죽 장화‡Botas de cuero salvaje‡Botas de cuero salvaje‡Les bottes en cuir fauve‡蛮皮战靴‡蠻皮長靴',
    nil,
    'Leve 2 Calças da Escapada Noturna, 2 Botas da Escapada Noturna e 2 Vinhas Selvagens para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 пары ночных штанов, 2 пары ночных сапог и 2 диких лозы Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Hosen des Nachtschleichers, 2 Stiefel des Nachtschleichers und 2 Wildranken.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 밤하늘 바지 2개, 밤하늘 장화 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Pantalons de la nuit, 2 paires de Bottes de la nuit et 2 Sauvageonnes à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2条夜色短裤、2双夜色长靴和2株野葡萄。‡',
  }
},
[2859] = {
  {
    'Perneiras de couro silvestre‡Поножи из дикой кожи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir sauvage‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите два черепашьих чешуйчатых шлема, две пары черепашьих чешуйчатых наручей и две дикие лозы Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zancoveloz al Campamento Mojache.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡',
  }
},
[2860] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir sauvage‡蛮皮护甲大师‡',
    nil,
    'Entregue a Carta de Jangdor para Una, a mestre coureira do Penhasco do Trovão.‡Отдайте письмо Джангора Уне, главному кожевнику Громового Утеса.‡Gebt Una, der Lederverarbeitungsmeisterin von Donnerfels, Jangdors Schreiben.‡썬더 블러프에 있는 가죽세공의 대가인 우나에게 장도르의 편지를 가져가야 합니다.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Donner la Lettre de Jangdor à Una, le Maître tanneur des Pitons du Tonnerre.‡将杉多尔的信交给雷霆崖的制皮大师犹纳。‡',
  }
},
[2861] = {
  {
    'A tarefa de Tabetha‡Миссия Табеты‡Tabethas Aufgabe‡타베사의 임무‡La tarea de Tabetha‡La tarea de Tabetha‡La mission de Tabetha‡塔贝萨的任务‡塔貝薩的任務',
    nil,
    'Fale com Tabetha no Pântano Vadeoso.‡Поговорите с Табетой в Пылевых топях.‡Sprecht mit Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사와 대화하십시오.‡Habla con Tabetha en el Marjal Revolcafango.‡Habla con Tabetha en el Marjal Revolcafango.‡Parler à Tabetha dans le marécage d\'Âprefange.‡与尘泥沼泽的塔贝萨谈一谈。‡與塵泥沼澤的塔貝薩談話。',
  }
},
[2862] = {
  {
    'Patábua mole em guerra dura‡Война с племенем Древолапов‡Krieg gegen die Waldpfoten‡덩굴발일족과의 전투‡En guerra con los Zarpaleña‡En guerra con los Zarpaleña‡La guerre avec les Griffebois‡与豺狼人开战‡與豺狼人開戰',
    nil,
    'Leve 10 Jubas de Gnoll Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Принесите 10 грив гноллов-древолапов Хадокену Быстрому Страннику в Лагере Мохаче.‡Bringt Hadoken Flinkschreiter im Camp Mojache 10 Mähnen eines Waldpfotengnolls.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 갈기 10개를 가져가야 합니다.‡Lleva 10 cabelleras de gnolls Zarpaleña a Hadoken Zancoveloz al Campamento Mojache.‡Lleva 10 cabelleras de gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Rapporter 10 Crinières de gnolls Griffebois à Hadoken Rôdeur-agile au Camp Mojache.‡将10份木爪豺狼人的鬃毛交给莫沙彻营地的哈杜肯·迅蹄。‡將10份木爪豺狼人的鬃毛交給莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[2863] = {
  {
    'Golpe Alfa‡Истребление вожаков‡Schlag gegen die Alphas‡우두머리 공격‡Ataca a los Alfas‡Ataca a los Alfas‡Frappe sur les Alphas‡突然袭击‡突然襲擊',
    nil,
    'Mate 5 Machos Alfa Patábua e fale novamente com Hadoken Passo Veloz em uma hora.‡Убейте в течение часа 5 вожаков стаи Древолапов и вернитесь к Хадокену Быстрому Страннику.‡Tötet 5 Alphas der Waldpfoten und kehrt innerhalb einer Stunde zu Hadoken Flinkschreiter zurück.‡1시간 안에 덩굴발일족 우두머리 5마리를 처치하고 아도겐 스위프트스트라이더에게 되돌아와야 합니다.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zancoveloz en 1 hora.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zanco Veloz en 1 hora.‡Tuer 5 Alphas Griffebois et retourner voir Hadoken Rôdeur-agile en moins d\'une heure.‡在1个小时内杀死5个木爪突击队员，并向哈杜肯·迅蹄汇报。‡在1個小時內殺死5個木爪突擊隊員，並向哈杜肯·迅蹄彙報。',
  }
},
[2864] = {
  {
    'Tran\'rek‡Тран\'рек‡Tran\'rek‡트란렉‡Tran\'rek‡Tran\'rek‡Tran\'rek‡特兰雷克‡特蘭雷克',
    nil,
    'Fale com Tran\'rek em Geringontzan.‡Поговорите с Тран\'реком в Прибамбасске.‡Sprecht mit Tran\'rek in Gadgetzan.‡가젯잔에 있는 트란렉과 대화해야 합니다.‡Habla con Tran\'rek en Gadgetzan.‡Habla con Tran\'rek en Gadgetzan.‡Parler à Tran\'rek à Gadgetzan.‡与加基森的特兰雷克谈一谈。‡與加基森的特蘭雷克談話。',
  }
},
[2865] = {
  {
    'Couraças de escaravelho‡Панцири скарабеев‡Skarabäuspanzerschalen‡왕쇠똥구리 껍질‡Caparazones de escarabajo‡Caparazones de escarabajo‡Les carapaces de scarabées‡圣甲虫的壳‡聖甲蟲的殼',
    nil,
    'Leve 5 Couraças de Escaravelho Fechadas para Tran\'rek em Geringontzan.‡Принести 5 целых панцирей скарабея Тран\'реку в Прибамбасск.‡Bringt Tran\'rek in Gadgetzan 5 unbeschädigte Skarabäuspanzerschalen.‡가젯잔에 있는 트란렉에게 온전한 왕쇠똥구리 껍질 5개를 가져가야 합니다.‡Lleva 5 caparazónes de escarabajo sin rajar a Tran\'rek en Gadgetzan.‡Lleva 5 caparazones de escarabajo sin rajar a Tran\'rek en Gadgetzan.‡Rapporter 5 Carapaces de scarabée intactes à Tran\'rek à Gadgetzan.‡给加基森的特兰雷克带去5个完整的圣甲虫壳。‡帶5個完整的聖甲蟲殼給加基森的特蘭雷克。',
  }
},
[2866] = {
  {
    'As Ruínas de Solarsal‡Руины Соларсаля‡Die Ruinen von Solarsal‡솔라살 폐허‡Las Ruinas de Solarsal‡Las Ruinas de Solarsal‡Les ruines de Solarsal‡索兰萨尔废墟‡索蘭薩爾廢墟',
    nil,
    'Explore as Ruínas de Solarsal e investigue a presença das nagas.‡Обследуйте руины Соларсаля на предмет присутствия наг.‡Erforscht die Ruinen von Solarsal und findet etwas über die Anwesenheit der Naga dort heraus.‡솔라살 폐허를 탐사하고 그곳에 있는 나가의 실태를 조사해야 합니다.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explorer les ruines de Solarsal et enquêter sur la présence des nagas dans le secteur.‡探索索兰萨尔废墟，并调查纳迦在那个地区的情况。‡探索索蘭薩爾廢墟，並調查納迦在那個地區的情況。',
  }
},
[2867] = {
  {
    'Regresso ao Domínio de Plumaluna‡Возвращение в Крепость Оперенной Луны‡Kehrt zur Mondfederfeste zurück‡페더문 요새로 돌아가기‡Vuelve al Bastión Plumaluna‡Regresa al Bastión Plumaluna‡Retourner au bastion de Pennelune‡返回羽月要塞‡返回羽月要塞',
    nil,
    'Fale novamente com Shandris Plumaluna no Domínio de Plumaluna e relate suas descobertas.‡Вернитесь в Крепость Оперенной Луны к Шандрисе Оперенной Луне и доложите о находке.‡Kehrt zu Shandris Mondfeder in der Mondfederfeste zurück und berichtet von Euren Entdeckungen.‡페더문 요새에 있는 샨드리스 페더문에게 돌아가 발견한 것에 대해 보고해야 합니다.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Retourner voir Shandris Pennelune au bastion de Pennelune et lui rendre compte de vos découvertes.‡向羽月要塞的珊蒂斯·羽月汇报你的发现。‡向羽月要塞的珊蒂斯·羽月彙報你的發現。',
  }
},
[2868] = {
  {
    '‡‡‡‡‡‡‡‡<TXT> The Shriveled Heart',
    nil,
    nil,
  }
},
[2869] = {
  {
    'Cruzada contra as Cristafúrias‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡증오의갈기일족과의 전투‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrête‡憎世纳迦之战‡憎世納迦之戰',
    nil,
    'Leve 10 Escamas de Naga Cristafúria para Latrônicus Lunalança no Domínio de Plumaluna.‡Принесите 10 штук чешуи наг из клана Гребня Ненависти Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Bringt Latronicus Mondspeer in der Mondfederfeste 10 Nagaschuppen der Hasskämme.‡페더문 요새에 있는 라트로니쿠스 문스피어에게 증오의갈기 나가 비늘 10개를 가져가야 합니다.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Rapporter 10 Ecailles de naga Hainecrête à Latronicus Lancelune au bastion de Pennelune.‡收集10块憎世纳迦的鳞片，把它们交给羽月要塞的拉托尼库斯·月矛。‡收集10塊憎世納迦的鱗片，把它們交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2870] = {
  {
    'Contra o Lorde Shalzaru‡Борьба с лордом Шалзару‡Gegen Lord Shalzaru‡군주 샬자루와의 전투‡En contra del Señor Shalzaru‡En contra de Lord Shalzaru‡Contre le Seigneur Shalzaru‡击败沙尔扎鲁‡擊敗沙爾札魯領主',
    nil,
    'Elimine o Lorde Shalzaru, e depois leve a Relíquia Misteriosa que ele desencavou a Latrônicus Lunalança no Domínio de Plumaluna.‡Убейте лорда Шалзару и принесите обнаруженную им таинственную реликвию Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Vernichtet Lord Shalzaru und bringt dann Latronicus Mondspeer in der Mondfederfeste das geheimnisvolle Relikt, das er entdeckt hat.‡군주 샬자루를 처치하고 그가 찾아낸 신비한 유물을 페더문 요새에 있는 라트로니쿠스 문스피어에게 가져가야 합니다.‡Elimina a Señor Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Elimina a Lord Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Éliminer le seigneur Shalzaru et rapporter la Mystérieuse relique qu\'il a découverte à Latronicus Lancelune au bastion de Pennelune.‡消灭沙尔扎鲁，然后把神秘遗物交给羽月要塞的拉托尼库斯·月矛。‡消滅沙爾札魯領主，然後把神秘聖物交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2871] = {
  {
    'A entrega da relíquia‡Доставка реликвии‡Überbringung des Relikts‡유물 전달‡Entrega la reliquia‡Entrega la reliquia‡Livraison de la relique‡递送遗物‡遞送聖物',
    nil,
    'Entregue a Relíquia Misteriosa a Véstia Lançaluna no Domínio de Plumaluna.‡Доставьте таинственную реликвию Вестии Лунное Копье в Крепость Оперенной Луны.‡Bringt das geheimnisvolle Relikt zu Vestia Mondspeer in der Mondfederfeste.‡페더문 요새에 있는 베스티아 문스피어에게 신비한 유물을 가져가야 합니다.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Porter la Relique mystérieuse à Vestia Lancelune au bastion de Pennelune.‡将神秘遗物交给羽月要塞的维斯提亚·月矛。‡將神秘聖物交給羽月要塞的維斯提亞·月矛。',
  }
},
[2872] = {
  {
    'A dívida de Esmirno‡Долг Столи‡Stoleys Schuld‡스톨리의 빚‡La deuda de Stoley‡La deuda de Stoley‡Les dettes de Stoley‡斯杜雷的债务‡斯杜雷的債務',
    nil,
    'Fale com Esmirno no Porto de Bondebico.‡Поговорите со Столи из Порта Картеля.‡Sprecht mit Stoley beim Dampfdruckpier.‡스팀휘들 항구에 있는 스톨리와 대화해야 합니다.‡Habla con Stoley en el Puerto Bonvapor.‡Habla con Stoley en el Puerto Bonvapor.‡Parler à Stoley, à Port Gentepression.‡与热砂港的斯杜雷谈一谈。‡與熱砂港的斯杜雷談話。',
  }
},
[2873] = {
  {
    'Carregamento do Esmirno‡Посылка Столи‡Stoleys Lieferung‡스톨리의 뱃짐‡El envío de Stoley‡El envío de Stoley‡La cargaison de Stoley‡斯杜雷的货物‡斯杜雷的貨物',
    nil,
    'Leve o Carregamento do Esmirno para Esmirno no Porto de Bondebico.‡Отыщите партию товара Столи и возвратите ее хозяину в Порт Картеля.‡Bringt Stoleys Lieferung zu Stoley beim Dampfdruckpier.‡스팀휘들 항구에 있는 스톨리에게 뱃짐을 찾아다 주어야 합니다.‡Llévale el envío de Stoley a Stoley, que está en el Puerto Bonvapor.‡Llévale el envío de Stoley a Stoley, que está en el Puerto Bonvapor.‡Apportez la Cargaison de Stoley à Port Gentepression et remettez-la à Stoley.‡将斯杜雷的货物交给热砂港的斯杜雷。‡將斯杜雷的貨物交給熱砂港的斯杜雷。',
  }
},
[2874] = {
  {
    'Entrega para MacKinley‡Ром для Маккинли‡Lieferung für MacKinley‡맥킨리에게 배달‡Un envío para MacKinley‡Un envío para MacKinley‡Livraison à MacKinley‡给马克基雷的货物‡給馬克基雷的貨物',
    nil,
    'Leve uma Garrafa do Esmirno para MacKinley "Lobo do Mar" na Angra do Butim.‡Отнесите бутылку Столи "Морскому волку" МакКинли в Пиратскую Бухту.‡Bringt Stoleys Flasche zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 칼림도어산 럼주가 든 스톨리의 병을 가져가야 합니다.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, que está en Bahía del Botín.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, en Bahía del Botín.‡Porter la Bouteille de Stoley à MacKinley "Loup des mers" à Baie-du-Butin.‡将斯杜雷的瓶子交给藏宝海湾的"海狼"马克基雷。‡將斯杜雷的瓶子交給藏寶海灣的『海狼』馬克基雷。',
  }
},
[2875] = {
  {
    'PROCURA-SE: André Barbarruiva‡Разыскивается: Андре Огнебородый‡GESUCHT: Andre Feuerbart‡현상 수배: 앙드레 파이어비어드‡SE BUSCA: Andre Barbafuego‡SE BUSCA: Andre Barbafuego‡ON RECHERCHE : André Barbe-en-feu‡通缉：安德雷·费尔比德‡懸賞:安德雷·火鬍',
    nil,
    'Leve a Cabeça do André ao Chefe de Segurança Silvadágua no Porto de Bondebico.‡Принесите голову Андре Огнебородого начальнику отдела безопасности Чепухастеру в Порт Картеля.‡Bringt Sicherheitschef Bilgenritzel beim Dampfdruckpier Andres Kopf.‡앙드레를 처치하고 그 증거로 그의 머리카락을 스팀휘들 항구에 있는 보안과장 빌지위즐에게 가져가야 합니다.‡Llévale la cabeza de Andre al jefe de seguridad Silvaina, que está en el Puerto Bonvapor.‡Llévale la cabeza de Andre al jefe de seguridad Pasaquillas, que está en el Puerto Bonvapor.‡Rapporter la tête d\'André au Chef de la sécurité Vizisanie à Port Gentepression.‡将安德雷的头颅交给热砂港的安全主管吉罗姆·比格维兹。‡將安德雷的頭顱交給熱砂港的安全主管比格維茲。',
  }
},
[2876] = {
  {
    'Cronograma de Navios‡Расписание кораблей‡Schiffzeitpläne‡선적 일정표‡El registro náutico‡El registro náutico‡Horaires des bateaux‡船运时刻表‡船運時刻表',
    nil,
    'Apresente o Cronograma de Navios a uma autoridade do Porto de Bondebico.‡Сообщите о корабельном расписании руководству Порта Картеля.‡Berichtet den Behörden des Dampfdruckpiers von den Schiffzeitplänen.‡스팀휘들 항구의 관계자에게 선적 일정표에 대해 보고해야 합니다.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Présenter les Horaires des bateaux aux autorités de Port Gentepression.‡把船运时刻表交给热砂港的某个官员。‡把船運時刻表交給熱砂港的某個官員。',
  }
},
[2877] = {
  {
    'Limpeza na Rocha Oculta‡Зачистка Осклизлой скалы‡Den Lauerfels aufräumen‡굼벵이 바위굴 청소‡La limpieza de Roca Oculta‡La limpieza de Roca Oculta‡Nettoyer le rocher de l\'Affût‡清理隐匿石‡清理隱匿石',
    nil,
    'Mate 10 Lodos Verdes e 10 Gosmas Jade, depois apresente-se novamente a Explodar Mantrovejante no Ninho da Águia.‡Убейте 10 зеленых слякочей и 10 нефритовых слизнюков, после чего доложитесь Фраггару Громовой Мантии на Заоблачном Пике.‡Tötet 10 grüne Schlämme sowie 10 jadegrüne Brühschlammer und meldet Euch dann wieder bei Fraggar Donnermantel beim Nistgipfel.‡녹색 녹괴물 10마리와 비취 수액괴물 10마리를 처치한 후 맹금의 봉우리에 있는 프라가르 썬더맨틀에게 돌아와 보고해야 합니다.‡Mata 10 lodos verdes y 10 mocos de jade e informa a Fraggar Mantrueno en Pico Nidal.‡Mata 10 lodos verdes y 10 mocos de jade e informa a Fraggar Mantrueno en Pico Nidal.‡Tuer 10 Limaces vertes et 10 Limons de jade puis faire votre rapport à Fraggar Tonnemante au Nid-de-l\'Aigle.‡杀掉10个绿色淤泥怪和10个玉石软泥怪，然后回到鹰巢山向弗拉加尔报告。‡殺掉10個綠色淤泥怪和10個玉石軟泥怪，然後回到鷹巢山向弗拉加爾報告。',
  }
},
[2878] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[2879] = {
  {
    'O Báculo de Equinex‡Посох равноденствия‡Der Stock von Equinex‡에퀴넥스의 지팡이‡El Bastón de Equinex‡El báculo de Equinex‡Le Bâton d\'Equinex‡艾奎尼克斯法杖‡艾奎尼克斯法杖',
    nil,
    'Energize o Báculo de Troya e encontre o Monolito de Equinex.‡Зарядите посох Трояса и отыщите Монолит Равноденствия.‡Aktiviert Troyas Stock und findet den Monolithen von Equinex.‡트로야스의 지팡이에 힘을 불어넣고 에퀴넥스 비석탑을 찾아야 합니다.‡Energiza el bastón de Troyas y encuentra el Monolito de Equinex.‡Energiza el báculo de Troyas y encuentra el Monolito de Equinex.‡Dynamiser le Bâton de Troyas et trouver le Monolithe d\'Equinex.‡给特洛亚斯的法杖注入能量，并找到艾奎尼克斯石碑。‡給特洛亞斯的法杖注入能量，並找到艾奎尼克斯石碑。',
  }
},
[2880] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse au collier troll‡巨魔部族项链‡食人妖部族項鍊',
    nil,
    'Leve 5 Colares Tribais Troll para Explodar Mantrovejante no Ninho da Águia.‡Принесите 5 тролльих ожерелий Фраггару Громовой Мантии на Заоблачный пик.‡Bringt Fraggar Donnermantel beim Nistgipfel 5 Trollstammeshalsketten.‡맹금의 봉우리에 있는 프라가르 썬더맨틀에게 트롤 전통 목걸이 5개를 가져다주어야 합니다.‡LLeva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Lleva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Rapporter 5 Colliers tribaux trolls à Fraggar Tonnemante au Nid-de-l\'Aigle.‡给鹰巢山的弗拉加尔带去5条巨魔部族项链。‡給鷹巢山的弗拉加爾帶去5條食人妖部族項鍊。',
  }
},
[2881] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse aux colliers trolls‡巨魔部族项链‡食人妖部族項鍊',
    nil,
    '‡Вы уже выполнили мое задание, но если вы захотите принести мне еще тролльих ожерелий, то я с радостью приму их. Это поможет вам заслужить хорошее отношение Громового Молота – если вы нам помогаете, то и мы с радостью поможем вам!nnПриносите по пять ожерелий, Медведик.‡Ihr habt das zwar bereits erledigt, aber wir nehmen weiterhin alle Troll-Stammeshalsketten an, die Ihr findet und eintauschen wollt. Indem Ihr sie bei mir eintauscht, verbessert Ihr weiter Eure Stellung unter den Wildhammers. Wenn Ihr für uns kämpft, dann kämpfen wir auch für Euch!nnIch benötige 5 Troll-Stammeshalsketten, damit ich es gelten lassen kann, <Name>.‡트롤 전통 목걸이를 더 찾아서 가지고 온다면 계속해서 받아주겠네. 목걸이를 가져온다면 자네는 와일드해머에서 명성을 쌓을 수 있을 걸세. 계속해서 우리를 위해서 싸울 의지를 보여준다면 언젠가 우리도 자네를 도울 날이 있을 걸세!nn트롤 전통 목걸이는 적어도 5개씩 가져와야 하네.‡Ya has cumplido tu misión, pero aceptaremos todos los collares tribales que nos traigas; así seguirás ganando méritos ante los Martillo Salvaje.nnTrae 5 collares tribales, <nombre>.‡‡Vous l\'avez déjà fait, mais nous continuerons d\'accepter tous les Colliers tribaux que vous trouverez. En me les donnant, vous continuerez d\'accroître votre prestige parmi les Wildhammer ; si vous désirez vous battre pour nous, nous pourrons nous battre pour vous !nnJ\'ai besoin de cinq colliers tribaux trolls, <nom>.‡你已经完成了我交给你的任务，但我们会继续接受你拿来的任何巨魔部族项链。你把它们交给我，你在蛮锤部族中的地位就会继续提高；如果你愿意为我们战斗，那么我们也愿意为你战斗！nn我需要五条巨魔部族项链，<name>。‡',
  }
},
[2882] = {
  {
    'Cuergo Ouro‡Золото Куэрго‡Cuergos Gold‡쿠에르고 골드‡El oro de Cuergo‡El oro de Cuergo‡L\'or de Cuergo‡科尔戈的黄金‡科爾戈的黃金',
    nil,
    'Encontre o ouro de Cuergo!‡Найдите золото Куэрго!‡Findet Cuergos Gold!‡쿠에르고 골드를 찾으십시오.‡¡Encuentra el oro de Cuergo!‡¡Encuentra el oro de Cuergo!‡Trouvez l\'or de Cuergo !‡找到科尔戈的黄金！‡找到科爾戈的黃金!',
  }
},
[2902] = {
  {
    'Investigação Patábua‡Разведка планов Древолапов‡Waldpfotennachforschung‡덩굴발일족 조사‡Investiga a los Zarpaleña‡Investiga a los Zarpaleña‡Enquête chez les Griffebois‡调查木爪岭‡',
    nil,
    'Encontre os Planos de Batalha Gnoll no acampamento dos Gnolls ao sul da Aldeia Mojache.‡Найдите гноллские боевые планы в гноллских лагерях к югу от Лагеря Мохаче.‡Findet die Schlachtpläne der Gnolle irgendwo in den Gnoll-Lagern südlich vom Camp Mojache.‡모자케 야영지 남쪽에 있는 놀 야영지에서 덩굴발일족 전투 계획서를 찾아야 합니다.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Trouver les Plans de bataille des gnolls dans les camps gnolls du sud du Camp Mojache.‡在莫沙彻营地以南的豺狼人营地中寻找豺狼人的战斗计划。‡',
  }
},
[2903] = {
  {
    'Os planos de batalha‡Планы битвы‡Die Schlachtpläne‡전투 계획서‡Los planes de batalla de los Zarpaleña‡Los planes de batalla‡Les plans de bataille‡作战计划‡',
    nil,
    'Leve os Planos de Batalha de Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Отнесите планы битвы Древолапов Хадокену Быстрому Страннику в Лагерь Мохаче.‡Bringt die Schlachtpläne der Waldpfoten zu Hadoken Flinkschreiter ins Camp Mojache.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 전투 계획서를 가지고 가야 합니다.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zancoveloz al Campamento Mojache.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Rapporter les Plans de bataille des Griffebois à Hadoken Rôdeur-agile au Camp Mojache.‡把木爪豺狼人的作战计划交给莫沙彻营地的哈杜肯·迅蹄。‡',
  }
},
[2904] = {
  {
    'Uma bela bagunça‡Катавасия‡Eine schöne Bescherung‡곤경에 빠진 케르노비‡Un buen lío‡Un buen lío‡Une jolie pagaille‡一团混乱‡一團混亂',
    nil,
    'Escolte Kernobill até a saída do Corredor dos Mecanismos, depois apresente-se a Scooty na Angra do Butim.‡Отведите Керноби к Часовому ходу. Затем отправляйтесь с донесением к Скути в Пиратскую Бухту.‡Begleitet Kernobee zur Uhrwerkgasse und meldet Euch dann wieder bei Scooty in Beutebucht.‡태엽장치 통로 입구까지 케르노비를 호위한 후 무법항에 있는 스쿠티에게 가서 보고해야 합니다.‡Acompaña a Kernobee a La Rampa del Engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Acompaña a Kernobee a La Rampa del Engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Escorter Kernobee jusqu\'à la sortie de la Fuite du temps, puis faire un rapport à Scooty, à Baie-du-Butin.‡将克努比护送到出口，然后向藏宝海湾的斯库提汇报。‡將克努比護送到發條小徑的出口，然後向藏寶海灣的斯庫提彙報。',
  }
},
[2922] = {
  {
    'Salve o cérebro do Tecnobô!‡Промыть мозг Техботу‡Rettet Techbots Hirn!‡고장난 첨단로봇 수리‡¡Salva el cerebro de Tecnobot!‡¡Salva el cerebro de Tecnobot!‡Sauver le cerveau de Techbot !‡拯救尖端机器人！‡拯救尖端機器人!',
    nil,
    'Leve o Núcleo de Memória do Tecnobô para o Mestre-faz-tudo Superchispa em Altaforja.‡Принесите ядро памяти Техбота мехмастеру Замыкальцу в Стальгорн.‡Bringt Techbots Speicherkern zu Tüftlermeister Oberfunks nach Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크에게 첨단로봇의 기억회로를 가져가야 합니다.‡Lleva el procesador central de memoria del techrobot al maestro manitas Sobrechispa a Forjaz.‡Lleva el procesador central de memoria del Tecnobot al maestro manitas Sobrechispa a Forjaz.‡Rapporter la Mémoire principale de Techbot au maître-artisan Suprétincelle à Forgefer.‡将尖端机器人的存储器核心交给铁炉堡的工匠大师欧沃斯巴克。‡將尖端機器人的記憶體核心交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[2923] = {
  {
    'Mestre-faz-tudo Superchispa‡Мехмастер Замыкалец‡Tüftlermeister Oberfunks‡수석땜장이 오버스파크‡Maestro manitas Sobrechispa‡Maestro manitas Sobrechispa‡Maître-bricoleur Suprétincelle‡工匠大师欧沃斯巴克‡技工大師歐沃斯巴克',
    nil,
    'Fale com o Mestre-faz-tudo Superchispa em Altaforja.‡Поговорите с механомастером Большой Искрой.‡Sprecht mit Tüftlermeister Oberfunks in Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크와 대화하십시오.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Parler au maître-artisan Suprétincelle à Forgefer.‡与铁炉堡的工匠大师欧沃斯巴克谈一谈。‡與鐵爐堡的技工大師歐沃斯巴克談話。',
  }
},
[2924] = {
  {
    'Artifícios Essenciais‡Базовый элемент‡Grundlegende Artifixe‡필수 인공장치‡Esencias artificiales‡Esencias artificiales‡Les cerveaux mécaniques‡基础模组‡基礎模組',
    nil,
    'Leve 12 Artifícios Essenciais para Cronomorfus Espanafuso em Altaforja.‡Принесите 12 базовых элементов Клацморту Гайкокруту в Стальгорн.‡Bringt Klockmort Spannersplint in Eisenschmiede 12 grundlegende Artifixe.‡아이언포지에 있는 클락몰트 스패너스판에게 필수 인공장치 12개를 가져가야 합니다.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Rapporter 12 Cerveaux mécaniques à Pléthorloge Cléventail à Forgefer.‡收集12个基础模组，把它们交给铁炉堡的科劳莫特·钢尺。‡收集12個基礎模組，把它們交給鐵爐堡的科勞莫特·鋼尺。',
  }
},
[2925] = {
  {
    'Os artifícios do Cronomorfus‡Базовые элементы Клацморта‡Klockmorts Grundlagen‡클락몰트에게 꼭 필요한 것‡Klockmort Palmalicate‡Klockmort Palmalicate‡Les cerveaux mécaniques de Klockmort‡帮助科劳莫特‡幫助科勞莫特',
    nil,
    'Fale com Cronomorfus Espanafuso em Altaforja.‡Поговорите с Клацмортом Гайкокрутом в Стальгорне.‡Sprecht mit Klockmort Spannersplint in Eisenschmiede.‡아이언포지에 있는 클락몰트 스패너스판과 대화하십시오.‡Habla con Klockmort Palmalicate en Forjaz.‡Habla con Klockmort Palmalicate en Forjaz.‡Parler à Pléthorloge Cléventail à Forgefer.‡与铁炉堡的科劳莫特·钢尺谈一谈。‡與鐵爐堡的科勞莫特·鋼尺談話。',
  }
},
[2926] = {
  {
    'Gnogaína‡Новая формула‡Gnogaine‡폐기물 수집‡Gnogaine‡Gnogaine‡Gnogaine‡诺恩‡諾恩',
    nil,
    'Use o Coletor de Chumbo Vazio nos Invasores Irradiados ou nos Pilhadores Irradiados para recolher resíduos radioativos. Depois que ele ficar cheio, leve-o de volta para Ozzie Mudavolt em Kharanos.‡Соберите радиоактивный осадок, оставляемый облученными захватчиками и облученными погромщиками в пустой свинцовый фиал для образцов. Принесите полный фиал Оззи Триггервольту в Каранос.‡Sammelt mit der leeren bleiernen Sammelphiole radioaktive Ablagerungen bestrahlter Eindringlinge oder Plünderer. Sobald sie voll ist, bringt Ihr sie zu Ozzie Wechselvolt nach Kharanos zurück.‡빈 가연채집병에 오염된 침략꾼이나 오염된 약탈자에게서 얻은 방사성 폐기물을 담아야 합니다. 채집병이 가득 차면 카라노스에 있는 오지 토글볼트에게 가지고 가야 합니다.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Oci Voltiflop a Kharanos.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Ozzie Voltiflop a Kharanos.‡Utiliser la Flasque plombée vide sur les Envahisseurs ou les Pilleurs irradiés pour recueillir des retombées radioactives. Une fois pleine, rapportez-la à Ozzie Virevolt à Kharanos.‡用空铅瓶对着辐射入侵者或者辐射抢劫者，从它们身上收集放射尘。瓶子装满之后，把它交给卡拉诺斯的奥齐·电环。‡用空著的鉛之瓶對著輻射入侵者或者輻射掠取者，從它們身上收集放射塵。瓶子裝滿之後，把它交給卡拉諾斯的奧齊·電環。',
  }
},
[2927] = {
  {
    'O dia seguinte‡На другой день‡Der Tag danach‡그날 이후‡Al día siguiente‡Al día siguiente‡Le jour d\'après‡灾难之后‡災難之後',
    nil,
    'Fale com Ozzie Mudavolt em Kharanos.‡Поговорите с Оззи Триггервольтом в Караносе.‡Sprecht mit Ozzie Wechselvolt in Kharanos.‡카라노스에 있는 오지 토글볼트와 대화하십시오.‡Ve a hablar con Oci Voltiflop en Kharanos.‡Ve a hablar con Ozzie Voltiflop en Kharanos, en Dun Morogh.‡Parler à Ozzie Virevolt à Kharanos.‡与卡拉诺斯的奥齐·电环谈一谈。‡與卡拉諾斯的奧齊·電環談話。',
  }
},
[2928] = {
  {
    'Escavacionadores girobrocamáticos‡Сооружение автогиробуророек‡Gyrobohrmatische Exkavation‡회전천공식 발굴기‡Excavadoras gyroagujereamáticas‡Excavadoras gyroagujereamáticas‡Excavateurs gyrodrilmatiques‡陀螺式挖掘机‡陀螺式挖掘機',
    nil,
    'Leve 24 Tripas Mecanobóticas para Shoni em Ventobravo.‡Принесите Шони в Штормград 24 горсти механических внутренностей роботов.‡Bringt 24 robomechanische Innereien zu Shoni nach Sturmwind.‡스톰윈드에 있는 쇼니에게 기계장치 부속품 24개를 가져가야 합니다.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Rapporter 24 Entrailles mécaniques de robot à Shoni à Hurlevent.‡收集24副机械内胆，把它们交给暴风城的舒尼。‡收集24副機械內膽，把它們交給暴風城的舒尼。',
  }
},
[2929] = {
  {
    'A grande traição‡Великое предательство‡Der große Verrat‡대배반‡La gran traición‡La gran traición‡La grande trahison‡大叛徒‡大叛徒',
    nil,
    'Vá para Gnomeregan e mate o Mecangenheiro Termaplugue. Fale novamente com o Grão-faz-tudo Mekkatorque depois que tiver terminado a tarefa.‡Отправляйтесь в Гномреган и убейте Мекжинера Термоштепселя. Вернитесь к Главному Механику Меггакруту.‡Reist nach Gnomeregan und tötet Robogenieur Thermadraht. Kehrt zu Hochtüftler Mekkadrill zurück, wenn der Auftrag ausgeführt ist.‡놈리건으로 가서 멕기니어 텔마플러그를 처치해야 합니다. 임무가 끝나면 땜장이왕 멕카토크에게 돌아와야 합니다.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Aller à Gnomeregan et tuer le mekgénieur Thermojoncteur. Puis retourner voir le Grand Bricoleur Mekkanivelle.‡到诺莫瑞根去杀掉麦克尼尔·瑟玛普拉格。完成任务之后向大工匠梅卡托克报告。‡到諾姆瑞根去殺掉麥克尼爾·瑟瑪普拉格。完成任務之後向高等技工梅卡托克報告。',
  }
},
[2930] = {
  {
    'O resgate dos dados‡Спасение данных‡Datenrettung‡자료 회수‡Rescatar los datos‡Rescatar los datos‡Sauvetage de données‡抢救数据‡搶救資料',
    nil,
    'Leve o Cartão Perfurado Prismático para o Mestre Mecânico Fundecano em Altaforja.‡Принесите призматическую перфокарту главному механику Чугунотрубзу в Стальгорн.‡Bringt Mechanikermeister Gussmuff in Eisenschmiede eine Prismalochkarte.‡아이언포지에 있는 수석수리공 캐스트파이프에게 오색 천공 카드를 가져가야 합니다.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Apporter une Carte perforée prismatique au Maître mécanicien Fontuyau, à Forgefer.‡将彩色穿孔卡片交给铁炉堡的大机械师卡斯派普。‡將稜彩穿孔卡片交給鐵爐堡的大技師卡斯派普。',
  }
},
[2931] = {
  {
    'A tarefa do Fundecano‡Поручение Чугонотрубза‡Gussmuffs Auftrag‡캐스트파이프의 임무‡Trabajar para Funditubo‡Trabajar para Funditubo‡Du travail pour Castpipe‡卡斯派普的任务‡卡斯派普的任務',
    nil,
    'Fale com o Mestre Mecânico Fundecano em Altaforja.‡Поговорите с главным механиком Чугунотрубзом в Стальгорне.‡Sprecht mit Mechanikermeister Gussmuff in Eisenschmiede.‡아이언포지에 있는 수석수리공 캐스트파이프와 대화하십시오.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Parler au Maître mécanicien Fontuyau, à Forgefer.‡与铁炉堡的大机械师卡斯派普谈一谈。‡與鐵爐堡的大技師卡斯派普談話。',
  }
},
[2932] = {
  {
    'Recado sinistro‡Предупреждение‡Grausige Botschaft‡준엄한 메시지‡Un mensaje siniestro‡Un mensaje siniestro‡Sinistre message‡可怕的消息‡可怕的消息',
    nil,
    'Recolha Crânios de Cascasseca e leve o Pique de Nimboya. Finque o Pique de Nimboya Repleto em uma das Aldeias Cascasseca nas Terras Agrestes, depois fale novamente com Nimboya na Selva do Espinhaço.‡Соберите черепа троллей из клана Сухокожих и насадите их на пику Нимбойи, после чего установите пику с тролльими черепами в центре тролльей деревни и возвращайтесь к Нимбойе в Тернистую долину.‡Sammelt Schädel der Bleichborken und hängt sie an Nimboyas Pike. Platziert Nimboyas behängte Pike in einem der Bleichborkendörfer im Hinterland und kehrt dann zu Nimboya ins Schlingendorntal zurück.‡동부 내륙지에서 마른나무껍질부족 해골을 모은 후, 님보야의 창을 동부 내륙지에 있는 마른나무껍질 마을 중 한곳에 박아 놓아야 합니다. 그런 다음 가시덤불 골짜기에 있는 님보야에게 돌아가십시오.‡Recoge cráneos Secacorteza y luego clava la pica cargada de Nimboya en uno de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Recoge cráneos Secacorteza y luego clava la pica cargada de Nimboya en uno de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Collecter des Crânes de Fânécorce et les placer sur la Pique de Nimboya. Poser la Pique de Nimboya préparée dans l\'un des Villages Fânécorce, dans les Hinterlands, puis retourner voir Nimboya, à Strangleronce.‡在辛特兰收集枯木巨魔的头皮，把它们串在尼姆布亚之矛上。将尼姆布亚的长矛插在辛特兰的某个枯木巨魔村庄中，然后回到荆棘谷的尼姆布亚那里。‡在辛特蘭收集枯木食人妖的頭皮，把它們串在尼姆布亞之矛上。將尼姆布亞的長矛插在辛特蘭的某個枯木食人妖村莊中，然後回到荊棘谷的尼姆布亞那裡。',
  }
},
[2933] = {
  {
    'Garrafas de peçonha‡Бутыли с ядом‡Giftflaschen‡독병‡Botellas de veneno‡Botellas de veneno‡Bouteilles de venin‡毒液瓶‡毒液瓶',
    nil,
    'Leve uma Garrafa de Peçonha para um boticário na Serraria Tarren.‡Принесите бутылку яда аптекарю в Мельницу Таррен.‡Bringt eine Giftflasche zu einem Apotheker nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사에게 독병을 가져가야 합니다.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Apporter une Bouteille de venin à un apothicaire, au Moulin-de-Tarren.‡将毒药瓶交给塔伦米尔的某个药剂师。‡將毒藥瓶交給塔倫米爾的某個藥劑師。',
  }
},
[2934] = {
  {
    'Vesícula de peçonha intacta‡Неповрежденная ядовитая железа‡Unbeschädigter Giftbeutel‡온전한 독주머니‡Glándula de veneno intacta‡Glándula de veneno intacta‡Glande à venin intacte‡完好无损的毒囊‡完好無損的毒囊',
    nil,
    'Leve a Vesícula de Peçonha Intacta para o Boticário Lindolfo na Serraria Tarren.‡Принесите неповрежденную ядовитую железу аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle einen unbeschädigten Giftbeutel.‡타렌 밀농장에 있는 연금술사 라이던에게 온전한 독주머니를 가져가야 합니다.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Rapporter une Glande à venin intacte à l\'Apothicaire Lydon, au Moulin-de-Tarren.‡将完好无损的毒囊交给塔伦米尔的药剂师林度恩。‡將完好無損的毒囊交給塔倫米爾的藥劑師林度恩。',
  }
},
[2935] = {
  {
    'Consulte o Mestre Gadrin‡Разговор с мастером Гадрином‡Konsultiert Meister Gadrin‡가드린 장로와 상의‡Consulta al maestro Gadrin‡Consulta al maestro Gadrin‡Consulter Maître Gadrin‡请教加德林大师‡請教加德林大師',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을에 있는 가드린 장로와 대화하십시오.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談話。',
  }
},
[2936] = {
  {
    'A deusa aranha‡Паучья богиня‡Der Spinnengott‡거미 신‡Diosa araña‡Diosa araña‡Le dieu-araignée‡蜘蛛之神‡蜘蛛之神',
    nil,
    'Leia a Tabuleta de Theka para descobrir o nome da deusa aranha dos Cascasseca, depois fale novamente com o Mestre Gadrin.‡Прочитайте надписи на табличке Теки, узнайте имя паучьей богини, которой поклоняются тролли из племени Сухокожих, а потом возвращайтесь к мастеру Гадрину.‡Lest von der Schrifttafel des Theka, um den Namen des Spinnengottes der Bleichborken zu erfahren, und kehrt dann zu Meister Gadrin zurück.‡데카의 서판을 읽고 마른나무껍질부족 거미 신의 이름을 알아낸 후, 가드린 장로에게 돌아가십시오.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lire la Tablette de Theka pour connaître le véritable nom du dieu-araignée des Fânécorces, puis retourner voir Maître Gadrin.‡阅读塞卡石板，了解枯木巨魔的蜘蛛之神的名字，然后回到加德林大师那里。‡閱讀塞卡石板，瞭解枯木食人妖的蜘蛛之神的名字，然後回到加德林大師那裡。',
  }
},
[2937] = {
  {
    'Evocando Shadra‡Призыв Шадры‡Die Beschwörung von Shadra‡샤드라 소환‡Invocar a Shadra‡Invocar a Shadra‡L\'invocation de Shadra‡召唤沙德拉‡召喚沙德拉',
    nil,
    'Derrote Shadra no altar de Shadra\'Alor, depois leve o veneno para o Boticário Lindolfo na Serraria Tarren.‡Убейте Шадру у алтаря Шадра\'Алора и принесите ее яд аптекарю Лидону в Мельницу Таррен.‡Besiegt Shadra am Altar von Shadra\'Alor und bringt sein Gift zu Apotheker Lydon nach Tarrens Mühle.‡샤드라알로 제단에서 샤드라를 물리친 후, 그녀의 독을 타렌 밀농장에 있는 연금술사 라이던에게 가져가야 합니다.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Terrasser Shadra, à l\'autel de Shadra\'Alor, puis rapporter son venin à l\'Apothicaire Lydon, au Moulin-de-Tarren.‡在沙德拉洛祭坛上击败沙德拉，把它的毒液交给塔伦米尔的药剂师林度恩。‡在沙德拉洛祭壇上擊敗沙德拉，把它的毒液交給塔倫米爾的藥劑師林度恩。',
  }
},
[2938] = {
  {
    'Veneno para a Cidade Baixa‡Яд в Подгород‡Gift für Unterstadt‡언더시티로 독 가져가기‡Veneno para Entrañas‡Veneno para Entrañas‡Du venin pour Fossoyeuse‡送往幽暗城的毒药‡',
    nil,
    'Leve o Embrulho do Faranello para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите сверток мастеру-аптекарю Фаранеллу в Подгород.‡Bringt Faranells Päckchen zu Apothekermeister Faranell nach Unterstadt.‡언더시티에 있는 수석 연금술사 파라넬에게 파라넬의 소포를 가져가야 합니다.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Apporter le Colis de Faranell au maître apothicaire Faranell, à Fossoyeuse.‡将法拉尼尔的包裹交给幽暗城的大药剂师法拉尼尔。‡',
  }
},
[2939] = {
  {
    'Em busca de conhecimento‡В поисках знаний‡Auf der Suche nach Wissen‡지식을 찾아서‡La búsqueda del conocimiento‡La búsqueda del conocimiento‡En savoir plus‡寻找知识‡尋找知識',
    nil,
    'Fale com Daryn Aelumnis na Vila de Rut\'theran.‡Поговорите с Дарин Добрый Ветер в деревне Рут\'теран.‡Sprecht mit Daryn Leuchtwind im Dorf Rut\'theran.‡루테란 마을에 있는 다린 라이트윈드와 대화해야 합니다.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Parler à Daryn Calmevent, au village de Rut\'theran.‡与鲁瑟兰村的达蕾恩·轻风谈一谈。‡與魯瑟蘭村的達蕾恩·輕風談話。',
  }
},
[2940] = {
  {
    'Feralas: uma história‡"История Фераласа"‡Feralas: Ein historischer Abriss‡페랄라스의 역사‡Feralas: una historia‡Feralas: una historia‡Feralas : une histoire‡菲拉斯的历史‡菲拉斯的歷史',
    nil,
    'Peça o livro emprestado a Daryn Aelumnis.‡Попросите Дарин Добрый Ветер одолжить вам книгу.‡Fragt Daryn Leuchtwind, ob Ihr Euch ihr Buch ausleihen dürft.‡다린 라이트윈드에게 책을 빌려도 좋은지 물어봐야 합니다.‡Pide a Daryn Brisela que te preste su libro.‡Pide a Daryn Brisela que te preste su libro.‡Demander à Daryn Calmevent si vous pouvez emprunter son livre.‡如果你想借达蕾恩·轻风的书，要先得到她的允许。‡如果你想借達蕾恩·輕風的書，要先得到她的允許。',
  }
},
[2941] = {
  {
    'O empréstimo‡В обмен на книгу‡Der Borger‡사진기 대여‡El préstamo‡El préstamo‡Le prêt‡海龟照片‡海龜照片',
    nil,
    'Leve a carta para Crista Dapinote em Tanaris.‡Отнесите письмо Кургль Поскакушке в Танарис.‡Bringt den Brief zu Curgle Kurbelhüpf nach Tanaris.‡타나리스에 있는 커글 크랭크홉에게 짧은 쪽지를 가져가야 합니다.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Apporter la lettre à Gruzouille Sautelevier, à Tanaris.‡把信交给塔纳利斯的克格尔·曲藤。‡把信交給塔納利斯的克格爾·曲藤。',
  }
},
[2942] = {
  {
    'A pedra matinal‡Завтрашний камень‡Der Morgenstein‡반짝이는 돌‡La Piedra del mañana‡La Piedra del mañana‡La Pierre du matin‡晨光石‡晨光石',
    nil,
    'Traga a Pedra Rutilante e o Báculo de Equinex para Troyas Brisaluna no Domínio de Plumaluna.‡Верните искрящийся камень и посох Равноденствия Троясу Лунному Бризу в Крепость Оперенной Луны.‡Bringt den funkelnden Stein und den Stock von Equinex zu Troyas Mondhauch in die Mondfederfeste.‡페더문 요새에 있는 트로야스 문브리즈에게 반짝이는 돌과 에퀴넥스의 지팡이를 가져가야 합니다.‡Devuelve la piedra refulgente y el Bastón de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Devuelve la piedra refulgente y el báculo de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Rapporter la Pierre étincelante et le Bâton d\'Equinex à Troyas Lunebise, dans le bastion de Pennelune.‡将闪光的石头和艾奎尼克斯法杖交给羽月要塞的特洛亚斯·月风。‡將閃亮的石頭和艾奎尼克斯法杖交給羽月要塞的特洛亞斯·月風。',
  }
},
[2943] = {
  {
    'O retorno a Troyas‡Возвращение к Троясу‡Rückkehr zu Troyas‡트로야스에게 돌아가기‡Vuelva con Troyas‡Regresa junto a Troyas‡Troyas‡向特洛亚斯回复‡向特洛亞斯回覆',
    nil,
    'Leve o livro para Troyas Brisaluna no Domínio de Plumaluna.‡Доставьте книгу Троясу Лунному Бризу в Крепость Оперенной Луны.‡Liefert das Buch bei Troyas Mondhauch in der Mondfederfeste ab.‡페더문 요새에 있는 트로야스 문브리즈에게 책을 가져가야 합니다.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Apporter le livre à Troyas Lunebise, dans le bastion de Pennelune.‡把书交给羽月要塞的特洛亚斯·月风。‡把書交給羽月要塞的特洛亞斯·月風。',
  }
},
[2944] = {
  {
    'A Superinstantânea FX‡Супер-хвататель ФХ‡Der Superschnapper FX‡슈퍼 찰칵이 FX‡La Superinstantánea FX‡La Superinstantánea FX‡Le Preneur d\'images FX‡超级摄影器FX‡超級攝影器FX',
    nil,
    'Use a Superinstantânea FX para tirar uma foto da Gammerita, depois fale novamente com Daryn Aelumnis na Vila de Rut\'theran.‡Сделайте снимок Гаммериты с помощью супер-хватателя ФХ и вернитесь к Дарин Добрый Ветер в деревне Рут\'теран.‡Benutzt den Superschnapper FX, um einen Schnappschuss von Gammerita zu machen, und kehrt dann zu Daryn Leuchtwind nach Rut\'theran zurück.‡슈퍼 찰칵이 FX로 감메리타의 즉석사진을 찍은 후, 루테란 마을에 있는 다린 라이트윈드에게 돌아가야 합니다.‡Utiliza la Superinstantánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliza la Superinstantánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliser le Preneur d\'images FX pour prendre un cliché de Gammerita, puis retourner voir Daryn Calmevent à Rut\'theran.‡用超级摄影器FX给加莫里塔拍张照片，然后把它交给鲁瑟兰村的达蕾恩·轻风。‡用超級攝影器FX給加莫里塔拍張照片，然後把它交給魯瑟蘭村的達蕾恩·輕風。',
  }
},
[2945] = {
  {
    'Anel Encardido‡Кольцо, покрытое грязью‡Schmutzverkrusteter Ring‡꼬질꼬질한 반지‡Un anillo sucio‡Un anillo sucio‡Anneau sali‡脏兮兮的戒指‡髒兮兮的戒指',
    nil,
    'Descubra uma maneira de remover a crosta de sujeira do Anel Encardido.‡Придумайте, как отчистить кольцо, покрытое грязью.‡Findet einen Weg, den schmutzverkrusteten Ring zu säubern.‡꼬질꼬질한 반지에서 찌꺼기를 제거할 방법을 찾아야 합니다.‡Encuentra la manera de limpiar el anillo sucio.‡Encuentra la manera de limpiar el anillo sucio.‡Trouver un moyen de nettoyer l\'Anneau sali.‡想方法把脏兮兮的戒指弄干净。‡想方法把髒兮兮的戒指弄乾淨。',
  }
},
[2946] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверить, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Porter les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris et chercher les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷你白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯繫。',
  }
},
[2947] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Vous pouvez soit garder l\'anneau, soit retrouver la personne désignée par les lettres qui sont gravées à l\'intérieur.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡',
  }
},
[2948] = {
  {
    'Aperfeiçoamento gnômico‡Гномское усовершенствование‡Gnomenverbesserungen‡노움의 실력 향상‡Mejora gnómica‡Mejora gnómica‡Amélioration gnomique‡侏儒的手艺‡地精的手藝',
    nil,
    'Entregue o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de prata para Didiê Du Mocó, em Altaforja.‡Принесите блестящее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Талвашу де Кисселю в Стальгорн.‡Bringt Talvash del Kissel in Eisenschmiede den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡아이언포지에 있는 탈바쉬 델 키젤에게 은괴 1개, 태마노 1개와 반짝이는 금반지와 30실버를 주어야 합니다.‡Lleva tu anillo de oro, 1 lingote de plata, 1 ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Apporter l\'Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d\'argent à Talvash del Kissel, à Forgefer.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给铁炉堡的塔瓦斯德·基瑟尔。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給鐵爐堡的塔瓦斯德·基瑟爾。',
  }
},
[2949] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡歸還戒指',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Vous pouvez soit garder l\'anneau, soit retrouver la personne désignée par les lettres qui sont gravées à l\'intérieur.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡你要麼自己留著這枚戒指，要麼就按照戒指內側刻著的名字找到它的主人。',
  }
},
[2950] = {
  {
    'Recauchutagem do anel do Nogg‡Переделка кольца‡Noggs Ringerneuerung‡노그의 반지 수리‡Nogg mejora el anillo‡Nogg mejora el anillo‡Nogg améliore l\'anneau‡诺格的手艺‡諾格的手藝',
    nil,
    'Leve o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de Prata para Nogg em Orgrimmar.‡Принесите блестящее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Ноггу в Огргиммар.‡Bringt Nogg in Orgrimmar den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡오그리마에 있는 노그에게 반짝이는 금반지, 은괴 1개, 태마노 1개, 그리고 30실버를 가져다주어야 합니다.‡Lleva tu anillo de oro, 1 lingote de plata, 1 ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Apporter l\'Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d\'argent à Nogg, à Orgrimmar.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给奥格瑞玛的诺格。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給奧格瑪的諾格。',
  }
},
[2951] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Décapeur 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡삐까뻔쩍세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200, sans oublier de jeter trois pièces d\'argent dans la fente, pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[2952] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Décapeur 5200 !‡超级清洁器5200型！‡',
    nil,
    '‡С проглотив кольцо, машина несколько минут с гудением вертит его в своих недрах и наконец останавливается, звенящим звуком оповестив вас о том, что работа закончена. Окошко приемника открывается, и вы видите в нем аккуратно завернутую коробочку. Видимо, машина выдает очищенные предметы в подарочной упаковке. Ну, даже если кольцо не удалось очистить, вы получили довольно миленькую коробочку за свои деньги... nnЧто ж, посмотрим...‡Der Funkelmat 5200 stoppt so schnell, wie er losgelegt hat. Ein einfaches "Ding" ist aus der Maschine zu hören und der Aufnahmebehälter der Maschine springt auf. Im Funkelmat 5200 liegt eine kleine Schachtel, die von einem Schleifchen umschlungen ist. Offensichtlich verpackt die Maschine ein Objekt, nachdem sie die Schmutzverkrustung entfernt hat. Selbst wenn die Maschine nicht funktioniert hat, ist der Gegenstand jetzt immerhin in einer hübschen Schachtel verpackt.nnTja, es gibt nur einen Weg herauszufinden, ob sie den Gegenstand gesäubert hat oder nicht...‡삐까뻔쩍세척기 5200이 갑자기 멈추어 버립니다. "땡" 소리가 나더니 원통형 입구가 회전하면서 위로 올라와 열립니다. 그 안에는 조그만 리본 장식으로 포장된 작은 상자가 있습니다. 물건의 찌꺼기를 세척하고 난 후 포장까지 한 모양입니다. 찌꺼기가 제대로 없어졌는지는 모르지만 적어도 물건은 예쁘게 포장되어 있습니다.nn제대로 세척됐는지 알아보는 방법은 단 한 가지 뿐...‡La máquina se para tan bruscamente como había arrancado. Se oye un "ping" y se abre la boca de la máquina. Dentro del Destellamatic 5200 hay una cajita con un lazo; parece que envuelve para regalo además de limpiar.nnSolo hay una forma de saber si el objeto está bien limpio...‡‡D\'un coup le Décapeur 5200 s\'arrête net. Un petit carillon émet un "ding" clair et la trappe de l\'appareil s\'ouvre. À l\'intérieur de la machine vous découvrez une petite boîte garnie d\'un noeud. Il semble que la machine emballe les objets après les avoir nettoyés et qu\'elle se donne la peine de les empaqueter dans une jolie boîte même quand elle n\'a pas fonctionné.nnBon, il n\'y a qu\'un seul moyen de savoir si l\'objet à bel et bien été nettoyé ou non...‡‡',
  }
},
[2953] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Mehr Spaß mit dem Funkelmaten‡삐까뻔쩍세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Décapeur décape encore‡再次使用超级清洁器‡再次使用超級清潔器',
    nil,
    'A Brastematic 5200 está vazia, esperando por um objeto encardido para limpar! Além das três moedas de prata, claro!‡Приемник Чистера 5200 пуст. Чтобы машина заработала, требуется загрязненный предмет и три серебряные монетки.‡Der Funkelmat 5200 ist leer und wartet auf ein schmutzverkrustetes Objekt zum Säubern sowie auf drei Silbermünzen, um loszulegen!‡빈 삐까뻔쩍세척기 5200이 꼬질꼬질한 물건과 3실버를 기다리고 있습니다!‡El Destellamatic 5200 parece estar esperando un objeto sucio que limpiar y 3 monedas de plata para activarse.‡‡Le Décapeur 5200 est vide et attend un objet à nettoyer ainsi que trois pièces d\'argent pour démarrer.‡超级清洁器5200型等待着清理脏兮兮的东西，它需要三枚银币才能启动！‡',
  }
},
[2954] = {
  {
    'O vigia pétreo‡Каменный Страж‡Der Steinbehüter‡바위감시자‡El vigía de piedra‡El vigía de piedra‡Le Gardien des pierres‡石头卫士‡石頭衛士',
    nil,
    'Descubra qual é o propósito do Vigia Pétreo de Norgannon, depois interaja com o Pedestal de Uldum no deserto de Tanaris.‡Узнайте назначение Каменного Стража Норганнона, затем коснитесь пьедестала Ульдума в пустыне Танарис.‡Findet den Zweck des Steinbehüters von Norgannon heraus und interagiert dann mit dem Podest von Uldum in der Tanariswüste.‡타나리스 사막에 있는 노르간논의 바위감시자와 대화한 후 울둠 대좌를 건드리십시오.‡Averigua qué quiere el vigía de piedra de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Averigua qué quiere el vigía de piedra de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Apprendre le but du Gardien des pierres de Norgannon, puis interagir avec le Socle d\'Uldum, dans le désert de Tanaris.‡询问诺甘农的石头卫士，搞清楚它要让你干什么，然后再次点击它脚下的奥丹姆石座。‡詢問諾甘農的石頭衛士，搞清楚它要讓你幹什麼，然後再次點擊它腳下的奧丹姆石座。',
  }
},
[2962] = {
  {
    'A única cura é mais brilho verde‡Сильное зеленое свечение‡Das einzige Heilmittel ist mehr grünes Leuchten‡유일한 치료법‡Necesitamos más material verdoso‡Necesitamos más material verdoso‡Encore plus de Lueur verte !‡更多的辐射尘！‡更多的輻射塵!',
    nil,
    'Vá até Gnomeregan e traga o Resíduo Radioativo de Alta Potência. Tome cuidado, pois a radiação é instável e pode se esvair rapidamente.nnOzzie também vai precisar do seu Coletor de Chumbo Pesado quando tiver terminado.‡Отправляйтесь в Гномреган и принесите высокорадиоактивные образцы. Внимание: отходы нестабильны и довольно быстро разрушаются.nnВерните Оззи тяжелую освинцованную склянку для проб, когда задача будет выполнена.‡Reist nach Gnomeregan und bringt etwas von der hoch konzentrierten radioaktiven Ablagerung zurück. Seid gewarnt, die Ablagerung ist instabil und wird ziemlich schnell zerfallen.nnOzzie wird außerdem Eure schwere bleierne Phiole benötigen, nachdem die Aufgabe erledigt ist.‡놈리건으로 가서 고농축 방사성 폐기물을 가져와야 합니다. 이 폐기물은 불안정하여 성분이 금방 변할 수 있으니 주의하십시오.nn임무를 완수한 후 빈 대형 가연채집병을 오지에게 돌려줘야 합니다.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.nnOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.|nOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.‡Voyager à Gnomeregan et rapporter de la Matière radioactive à haut potentiel. Attention, la matière radioactive est instable et se désactive rapidement.nnAprès le travail, conserver la Flasque plombée lourde, pour Ozzie.‡到诺莫瑞根去收集高强度辐射尘。要多加小心，这种辐射尘非常不稳定，很快就会分解。nn奥齐要求你把沉重的铅瓶也交给他。‡到諾姆瑞根去收集高強度輻射塵。要多加小心，這種輻射塵非常不穩定，很快就會分解。|n奧齊要求你在任務完成後把沉重的鉛之瓶也交給他。',
  }
},
[2963] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com o Historiador Karnik no Salão dos Exploradores em Altaforja.‡Поговорите с историком Карником в Зале Исследователей в Стальгорне.‡Sprecht mit Historiker Karnik in der Halle der Forscher in Eisenschmiede.‡아이언포지의 탐험가의 전당에 있는 역사학자 카르닉과 대화하십시오.‡Habla con el historiador Karnik en la Sala de los Exploradores de Forjaz.‡Habla con Karnik el Historiador en la Sala de los Expedicionarios de Forjaz.‡Parler à l\'Historien Karnik dans le Hall des explorateurs, à Forgefer.‡与铁炉堡探险者大厅中的史学家卡尼克谈一谈。‡與鐵爐堡探險者大廳中的史學家卡尼克談話。',
  }
},
[2964] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Un tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡進一步的任務',
    nil,
    'Fale com o Alto-explorador Magellas em Altaforja.‡Поговорите со старшим исследователем Магелласом в Стальгорне.‡Sprecht mit Hochforscher Magellas in Eisenschmiede.‡아이언포지에 있는 선임탐험가 마겔라스와 대화하십시오.‡Habla con el alto expedicionario Magellas de Forjaz.‡Habla con el alto expedicionario Magellas de Forjaz.‡Parler au Grand Explorateur Magellas, à Forgefer.‡与铁炉堡的资深探险家麦格拉斯谈一谈。‡與鐵爐堡的資深探險家麥格拉斯談話。',
  }
},
[2965] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com Nara Juba Agreste no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой на Вершине Старейшин Громового Утеса.‡Sprecht mit Nara Wildmähne auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프의 장로의 봉우리에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Bravacrín en el Alto de los Ancestros de Cima del Trueno.‡Habla con Nara Ferocrín en el Alto de los Ancestros de Cima del Trueno.‡Aller à la Cime des Anciens, aux Pitons du Tonnerre et parler à Nara Crin-sauvage.‡与雷霆崖长者高地的纳拉·蛮鬃谈一谈。‡與雷霆崖長者高地的納拉·蠻鬃談話。',
  }
},
[2966] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверить, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los discos de platino en miniatura a las puertas de Uldum en Tanaris y busca pistas de la relación que existe entre ambos.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Porter les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris et chercher les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷你白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯繫。',
  }
},
[2967] = {
  {
    'Volte ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Rückkehr nach Donnerfels‡썬더 블러프로의 귀환‡El regreso a Cima del Trueno‡Regresa a Cima del Trueno‡Le retour à Thunder Bluff‡返回雷霆崖‡',
    nil,
    'Fale com Nara Juba Agreste no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой в Громовом Утесе.‡Sprecht mit Nara Wildmähne in Donnerfels.‡썬더 블러프에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Bravacrín en Cima del Trueno.‡Habla con Nara Ferocrín en Cima del Trueno.‡Parler à Nara Wildmane, dans Thunder Bluff.‡与雷霆崖的纳拉·蛮鬃谈一谈。‡',
  }
},
[2968] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Una tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡',
    nil,
    'Fale com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Поговорите с Ведуном Искателем Истины в Громовом Утесе.‡Sprecht mit dem Weisen Wahrspruch in Donnerfels.‡썬더 블러프에 있는 현자 트루스시커와 대화해야 합니다.‡Habla con Sabio Buscaverdad en Cima del Trueno.‡Habla con Sabio Buscador de la Verdad en Cima del Trueno.‡Parler au Sage Recherche-la-vérité, aux Pitons du Tonnerre.‡与雷霆崖的圣者图希克谈一谈。‡',
  }
},
[2969] = {
  {
    'Liberdade para todas as criaturas‡Свободу всем живым существам!‡Freiheit für alle Kreaturen‡모든 생명에 자유를‡Libertad para todas las criaturas‡Libertad para todas las criaturas‡Liberté pour toutes les créatures‡精灵龙的自由‡所有生物的自由',
    nil,
    'Com a Chave da Gaiola de Bambu, liberte os Dardejantes do cercado no acampamento dos Temível Totem. Pelo menos 6 Dardejantes e Kindal Teceluna devem sobreviver.nnVocê tem 6 minutos antes que Kindal resolva recuar e você fracasse na missão.‡Освободите летучих хамелеонов из вольера в лагере Зловещего Тотема с помощью ключа от бамбуковой клетки. Необходимо, чтобы Киндел Лунная Пряжа и как минимум 6 хамелеонов остались живы.nnУ вас в запасе 6 минут. После этого Киндел решит, что пора отступать, и задание останется невыполненным.‡Befreit mit dem Bambuskäfigschlüssel die Grimmlingflitzer aus dem Pferch im Grimmtotemlager. Kindal Mondweber sowie mindestens 6 Grimmlingflitzer müssen überleben.nnIhr habt 6 Minuten, bis Kindal beschließt, dass es Zeit zum Rückzug und Eure Aufgabe gescheitert ist.‡대나무 우리 열쇠를 사용하여 그림토템부족 야영지의 우리에 갇힌 화살요정용들을 풀어 줘야 합니다. 최소 6마리의 화살요정용과 킨달 문위버가 살아남아야 합니다.nn6분이 지나면 킨달이 후퇴할 때가 되었다고 할 것이며 임무에 실패하게 됩니다.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.nnTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.|nTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡À l\'aide de la Clé de la cage en bambou, libérer les Fées fléchetteuses de l\'enclos dans le Camp du Totem-sinistre. Au moins 6 Fées fléchetteuses et Kindal Tisselune doivent survivre.nnVous avez 6 minutes avant que Kindal décide qu\'il est temps de battre en retraite et que vous échouiez dans votre quête.‡从恐怖图腾营地的围栏里释放被俘获的小精龙。至少6个小精龙和辛达尔·月纹必须活着。nn如果6分钟之内你还没能达成这个目标，辛达尔就会决定撤退，任务也会随即失败。‡從恐怖圖騰營地的圍欄裡釋放被俘獲的小精龍。至少6個小精龍和辛達爾·月紋必須活著。|n如果6分鐘之內你還沒能達成這個目標，辛達爾就會決定撤退，任務也會隨即失敗。',
  }
},
[2970] = {
  {
    'Distribuindo a justiça‡Небольшое возмездие‡Gerechtigkeit üben‡정의의 실현‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡菲拉斯的正義',
    nil,
    'Mate 12 Naturalistas Temível Totem, 10 Saqueadores dos Temível Totem e 6 Xamãs Temível Totem antes reencontrar Jer\'kai Teceluna em Feralas.‡Убейте 12 натуралистов, 10 налетчиков из племени и 6 шаманов из племени Зловещего Тотема, а затем вернитесь к Джер\'кай Лунной Пряже в Фераласе.‡Tötet 12 Naturalisten der Grimmtotem, 10 Räuber der Grimmtotem sowie 6 Schamanen der Grimmtotem und kehrt dann zu Jer\'kai Mondweber nach Feralas zurück.‡그림토템부족 식물학자 12명, 그림토템부족 침략자 10명, 그리고 그림토템부족 주술사 6명을 처치한 후, 페랄라스에 있는 제르카이 문위버에게 돌아가야 합니다.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Tuer 12 Naturalistes du Totem-sinistre, 10 Écumeurs du Totem-sinistre et 6 Chamans du Totem-sinistre avant de retourner voir Jer\'kai Tisselune, en Féralas.‡杀掉12个恐怖图腾博学者、10个恐怖图腾袭击者和6个恐怖图腾萨满祭司，然后向菲拉斯的耶尔卡·月纹汇报。‡殺掉12個恐怖圖騰自然學家、10個恐怖圖騰劫掠者和6個恐怖圖騰薩滿，然後向菲拉斯的耶爾卡·月紋彙報。',
  }
},
[2971] = {
  {
    '‡‡‡‡‡‡‡‡<UNUSED>',
    nil,
    '‡‡‡‡‡‡‡‡[PH] Log Description',
  }
},
[2972] = {
  {
    'Distribuindo a justiça‡Небольшое возмездие‡Gerechtigkeit üben‡정의의 실현‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡菲拉斯的正義',
    nil,
    'Leve o Anel-sinete de Jer\'kai para a Alta-sacerdotisa Tyrande Murmuréolo em Darnassus.‡Отнесите перстень-печатку Джер\'кай верховной жрице Тиранде Шелест Ветра в Дарнасс.‡Bringt Jer\'kais Siegelring zu Hohepriesterin Tyrande Wisperwind nach Darnassus.‡다르나서스에 있는 대여사제 티란데 위스퍼윈드에게 제르카이의 인장 반지를 가져가야 합니다.‡Lleva el sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Lleva el sello de Jer\'kai a la suma sacerdotisa Tyrande Susurravientos a Darnassus.‡Apporter la Chevalière de Jer\'kai à la Grande prêtresse Tyrande Murmevent, à Darnassus.‡将耶尔卡的徽记之戒交给达纳苏斯的高阶女祭司泰兰德·语风。‡將耶爾卡的璽戒交給達納蘇斯的高階女祭司泰蘭妲·語風。',
  }
},
[2973] = {
  {
    'Dando um trato na capa‡Новый сверкающий плащ‡Schimmer für einen neuen Umhang‡화려한 새 망토‡Una capa nueva‡El lustre de una nueva capa‡Une nouvelle cape‡新斗篷的光辉‡新披風的光輝',
    nil,
    'Traga 10 Asas Iridescentes de Dardejantes para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 10 радужных крыльев летучих хамелеонов Кригу Головорубу в Лагерь Мохаче.‡Bringt 10 regenbogenfarbene Grimmlingflitzerflügel zu Krueg Schädelspalter nach Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 오색 화살요정용 날개 10개를 가져가야 합니다.‡Lleva 10 alas de duende dardo iridiscente a Krueg Machacacráneos al Campamento Mojache.‡Lleva 10 alas de duende dardo iridiscente a Krueg Machacacráneos al Campamento Mojache.‡Rapporter 10 Ailes iridescentes de Fées fléchetteuses à Krueg Casse-crâne au Camp Mojache.‡给莫沙彻营地的克鲁伊格·碎颅带去10个闪光的小精灵翅膀。‡給千針石林的克魯伊格·劈顱帶去10個閃光的小精靈翅膀。',
  }
},
[2974] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡',
    nil,
    'Traga 20 Chifres de Temível Totem para Krueg Rachacrânio na Aldeia Mojache.‡Принесите 20 рогов тауренов из племени Зловещего Тотема Кригу Головорубу в лагерь Мохаче.‡Bringt 20 Grimmtotemhörner zu Krueg Schädelspalter nach Camp Mojache.‡모자케 야영지에 있는 크루엑 스컬스플리터에게 그림토템일족 뿔 20개를 가져가야 합니다.‡Lleva 20 cuernos de Tótem Siniestro a Krueg Machacacráneos al Campamento Mojache.‡Lleva 20 cuernos de Tótem Siniestro a Krueg Machacacráneos en el Campamento Mojache.‡Apporter 20 Cornes de Totem-sinistre à Krueg Casse-crâne au Camp Mojache.‡收集20支恐怖图腾之角，把它们交给千针石林的克鲁伊格·碎颅。‡',
  }
},
[2975] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Féralas‡菲拉斯的食人魔‡菲拉斯的巨魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Ogros Gordunni, 10 Ogros-magos e 5 Brutamontes Gordunni.‡Убейте 10 огров из клана Гордунни, 10 огров-магов из клана Гордунни и 5 громил из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Oger der Gordunni, 10 Magier der Gordunni und 5 Schläger der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니 오우거 10명, 골두니일족 오우거 마법사 10명, 골두니일족 투사 5명을 처치해달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 magi ogro Gordunni y 5 toscos Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 ogros Gordunni, 10 magi ogro Gordunni y 5 toscos Gordunni.‡Tuer 10 Ogres Gordunni, 10 Ogre-magi Gordunni et 5 Brutes Gordunni pour Rok Orhan, du Camp Mojache.‡莫沙彻营地的洛卡-奥赫要你杀掉10个戈杜尼食人魔、10个戈杜尼食人魔法师和5个戈杜尼蛮兵。‡莫沙徹營地的洛卡·奧赫要你殺掉10個戈杜尼巨魔、10個戈杜尼巨魔法師和5個戈杜尼蠻卒。',
  }
},
[2976] = {
  {
    'Uma temível descoberta‡Зловещее открытие‡Eine grausige Entdeckung‡불길한 발견‡Un descubrimiento siniestro‡Un descubrimiento siniestro‡Une découverte sinistre‡可怕的发现‡',
    nil,
    'Leve a Caixa de Chifres Temível Totem para Belgrom Pedramalho em Orgrimmar.‡Отнесите ящик с рогами тауренов из племени Зловещего Тотема Белгрому Каменной Булаве в Оргриммар.‡Bringt die Kiste mit Grimmtotemhörnern zu Belgrom Felshammer nach Orgrimmar.‡오그리마에 있는 벨그롬 록마울에게 그림토템일족 뿔 상자를 가져가야 합니다.‡Lleva el cajón de cuernos de Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Lleva el cajón de cuernos de Tótem Siniestro a Belgrom Destrozarroca a Orgrimmar.‡Apporter la Caisse de Cornes de Totem-sinistre à Belgrom Cogneroche, Orgrimmar.‡将一箱恐怖图腾之角交给奥格瑞玛的贝尔戈洛姆·石槌。‡',
  }
},
[2977] = {
  {
    'Retorno a Altaforja‡Возвращение в Стальгорн‡Rückkehr nach Eisenschmiede‡아이언포지로의 귀환‡El regreso a Forjaz‡Regresa a Forjaz‡Retour à Forgefer‡返回铁炉堡‡返回鐵爐堡',
    nil,
    'Fale com o Historiador Karnik em Altaforja.‡Поговорите с историком Карником из Стальгорна.‡Sprecht mit Historiker Karnik in Eisenschmiede.‡아이언포지에 있는 역사학자 카르닉과 대화하십시오.‡Habla con Karnik el Historiador de Forjaz.‡Habla con Karnik el Historiador de Forjaz.‡Parler à l\'Historien Karnik, à Forgefer.‡与铁炉堡的史学家卡尼克谈一谈。‡與鐵爐堡的史學家卡尼克談話。',
  }
},
[2978] = {
  {
    'O Pergaminho Gordunni‡Свиток Гордунни‡Die Gordunnischriftrolle‡골두니 두루마리‡El pergamino Gordunni‡El pergamino Gordunni‡Le parchemin gordunni‡戈杜尼卷轴‡戈杜尼卷軸',
    nil,
    'Leve o Pergaminho Gordunni para Rok Orhan na Aldeia Mojache.‡Отнести свиток Гордунни Роке Орхан в Лагерь Мохаче.‡Bringt die Gordunnischriftrolle zu Rok Orhan ins Camp Mojache.‡모자케 야영지에 있는 로크 올한에게 골두니 두루마리를 가져가야 합니다.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Lleva el pergamino Gordunni a Rok Orhan al Campamento Mojache.‡Apporter le Parchemin gordunni à Rok Orhan, au Camp Mojache.‡将戈杜尼卷轴交给莫沙彻营地的洛克·奥汉。‡將戈杜尼卷軸交給莫沙徹營地的洛克·奧漢。',
  }
},
[2979] = {
  {
    'Cerimônia sombria‡Темный обряд‡Dunkle Zeremonie‡암흑의 의식‡Una ceremonia oscura‡Una ceremonia oscura‡Sombre cérémonie‡黑暗仪式‡',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você encontre um Orbe Gordunni.‡Добудьте сферу Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr eine Gordunnikugel findet.‡모자케 야영지에 있는 로크 올한이 골두니 수정구를 찾아 와 달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rok Orhan del Campamento Mojache quiere que encuentres 1 orbe Gordunni.‡Rok Orhan, du Camp Mojache, veut que vous trouviez un Orbe Gordunni.‡莫沙彻营地的洛卡·奥赫希望你找到一颗戈杜尼之宝珠。‡',
  }
},
[2980] = {
  {
    'Os ogros de Feralas‡Огры Фераласа‡Die Oger von Feralas‡페랄라스의 오우거‡Los ogros de Feralas‡Los ogros de Feralas‡Les ogres de Feralas‡菲拉斯的食人魔‡菲拉斯的巨魔',
    nil,
    'Rok Orhan, da Aldeia Mojache, quer que você mate 10 Xamãs Gordunni, 10 Bruxos Gordunni e 5 Espancadores Gordunni.‡Убейте 10 шаманов из клана Гордунни, 10 чернокнижников из клана Гордунни и 5 извергов из клана Гордунни по просьбе Роки Орхан из Лагеря Мохаче.‡Rok Orhan im Camp Mojache will, dass Ihr 10 Schamanen der Gordunni, 10 Hexenmeister der Gordunni und 5 Raufer der Gordunni tötet.‡모자케 야영지에 있는 로크 올한이 골두니일족 주술사 10명, 골두니일족 흑마법사 10명, 그리고 골두니일족 싸움꾼 5명을 처치해 달라고 부탁했습니다.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 aplastadores Gordunni.‡Rok Orhan del Campamento Mojache quiere que mates a 10 chamanes Gordunni, 10 brujos Gordunni y 5 aplastadores Gordunni.‡Tuer 10 Chamans Gordunni, 10 Démonistes Gordunni et 5 Marteleurs Gordunni pour Rok Orhan, à Camp Mojache.‡莫沙彻营地的洛卡·奥赫要你去杀掉十个戈杜尼萨满祭司、10个戈杜尼术士和5个戈杜尼虐待者。‡莫沙徹營地的洛卡·奧赫要你去殺掉十個戈杜尼薩滿、10個戈杜尼術士和5個戈杜尼虐待者。',
  }
},
[2981] = {
  {
    'Uma ameaça em Feralas‡Опасность в Фераласе‡Eine Bedrohung in Feralas‡페랄라스의 위협‡Una amenaza en Feralas‡Una amenaza en Feralas‡Menace sur Féralas‡菲拉斯的危机‡菲拉斯的危機',
    nil,
    'Belgrom Pedramalho quer que você fale com Rok Orhan, da Aldeia Mojache.‡Поговорите с Рокой Орхан в Лагере Мохаче.‡Belgrom Felshammer will, dass Ihr mit Rok Orhan im Camp Mojache sprecht.‡벨그롬 록마울이 모자케 야영지에 있는 로크 올한과 대화해 달라고 부탁했습니다.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Belgrom Destrozarroca quiere que hables con Rok Orhan, del Campamento Mojache.‡Comme le veut Belgrom Cogneroche, aller parler à Rok Orhan, au Camp Mojache.‡贝尔戈洛姆·石槌想让你去和莫沙彻营地的洛卡·奥赫谈一谈。‡貝爾戈洛姆·石槌想讓你去和莫沙徹營地的洛卡·奧赫談話。',
  }
},
[2982] = {
  {
    'A Selva Alta‡Высокогорные дебри‡Die obere Wildnis‡높은벌‡Las Altas Tierras Salvajes‡Las Altas Tierras Salvajes‡Les Plateaux sauvages‡高原荒野‡高原荒野',
    nil,
    'Ângela Brisaluna quer que você mate 8 Bruxos Gordunni, 8 Xamãs Gordunni e 8 Brutamontes Gordunni.‡Убейте 8 чернокнижников из клана Гордунни, 8 шаманов из клана Гордунни и 8 громил из клана Гордунни по просьбе Ангелас Лунный Бриз.‡Angelas Mondhauch will, dass Ihr 8 Hexenmeister der Gordunni, 8 Schamanen der Gordunni und 8 Schläger der Gordunni tötet.‡안젤라스 문브리즈가 골두니일족 흑마법사 8명, 골두니일족 주술사 8명, 골두니일족 투사 8명을 퇴치해 달라고 부탁했습니다.‡Angelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 toscos Gordunni.‡Angelas Brisaluna quiere que mates a 8 brujos Gordunni, 8 chamanes Gordunni y 8 toscos Gordunni.‡Tuer 8 Démonistes Gordunni, 8 Chamans Gordunni et 8 Brutes Gordunni pour Angelas Lunebise.‡安吉拉斯·月风要求你杀死8个戈杜尼术士、8个戈杜尼萨满祭司和8个戈杜尼蛮兵。‡安吉拉斯·月風要求你殺死8個戈杜尼術士、8個戈杜尼薩滿和8個戈杜尼蠻卒。',
  }
},
[2983] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2984] = {
  {
    'Clamor do Fogo‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[2985] = {
  {
    'Clamor da Água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[2986] = {
  {
    'Clamor da Água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислен Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vident\'aqua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[2987] = {
  {
    'Cobalto Gordunni‡Кобальт Гордунни‡Gordunnikobalt‡골두니 코발트‡El cobalto Gordunni‡El cobalto Gordunni‡Cobalt Gordunni‡戈杜尼钴矿石‡戈杜尼鈷礦石',
    nil,
    'Orwin Sheiduztruc, na Aldeia Mojache, quer 12 amostras de Cobalto Gordunni.‡Добудьте 12 образцов кобальта Гордунни для Орвина Гиззмика из Лагеря Мохаче.‡Orwin Gizzmick im Camp Mojache will 12 Proben Gordunnikobalt.‡모자케 야영지에 있는 올윈 기즈믹이 골두니 코발트 12개를 가져다 달라고 부탁했습니다.‡Orwin Gizzmick, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Orwin Cacharrejos, del Campamento Mojache, quiere 12 muestras de cobalto Gordunni.‡Collecter 12 échantillons de Cobalt Gordunni pour Orwin Azztuche, du Camp Mojache.‡莫沙彻营地的奥尔文·吉兹米克需要12块戈杜尼钴矿石的样本。‡莫沙徹營地的奧爾文·吉茲米克需要12塊戈杜尼鈷礦石的樣本。',
  }
},
[2988] = {
  {
    'Jaulas Cascasseca‡Тролльи клетки‡Käfige der Bleichborken‡마른나무껍질부족 우리‡Las jaulas de Secacorteza‡Las jaulas de Secacorteza‡Les cages Witherbark‡枯木巨魔的牢笼‡枯木食人妖的牢籠',
    nil,
    'Verifique as jaulas nas duas aldeias Cascasseca, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Проверьте клетки в двух деревнях Сухокожих и возвращайтесь к дрессировщику грифонов Разящему Когтю.‡Durchsucht die Käfige in den beiden Dörfern der Bleichborken und kehrt dann zu Greifenmeister Krallenaxt zurück.‡마른나무껍질 마을 두 곳에 있는 우리를 확인한 후, 그리핀 조련사 탈론액스에게 돌아가야 합니다.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Mira en las jaulas de los poblados Secacorteza y vuelve a ver al maestro de grifos Garracha.‡Inspecter les cages dans les deux villages Fânécorce, puis retourner auprès du Maître des griffons Hachegriffe.‡检查两个枯木巨魔村落里的笼子，然后向狮鹫管理员沙拉克·鹰斧回复。‡檢查兩個枯木食人妖村落裡的籠子，然後向獅鷲獸管理員沙拉克·鷹斧回覆。',
  }
},
[2989] = {
  {
    'Altar de Zul‡Алтарь Зула‡Der Altar von Zul‡줄의 제단‡El Altar de Zul‡El Altar de Zul‡L\'autel de Zul‡祖尔祭坛‡祖爾祭壇',
    nil,
    'Verifique o topo do Altar de Zul, depois fale novamente com o Mestre de Grifos Garra-de-acha.‡Осмотрите вершину Алтаря Зула и возвращайтесь к укротителю грифонов Разящему Когтю.‡Überprüft die Oberfläche des Altars von Zul und kehrt dann zu Greifenmeister Krallenaxt zurück.‡줄의 제단 위를 확인한 후, 그리핀 조련사 탈론액스에게 돌아가야 합니다.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Mira en el Altar de Zul y vuelve a ver al maestro de grifos Garracha.‡Regarder sur le dessus de l\'autel de Zul, puis retourner auprès du Maître des griffons Hachegriffe.‡检查祖尔祭坛的顶部，然后向狮鹫管理员沙拉克·鹰斧报告。‡檢查祖爾祭壇的頂部，然後向獅鷲獸管理員沙拉克·鷹斧報告。',
  }
},
[2990] = {
  {
    'Tádius Sombraustera‡Тадиус Мрачная Тень‡Thadius Grimmschatten‡샤디우스 그림셰이드‡Thadius Sombramacabra‡Thadius Sombramacabra‡Thadius Sinissombre‡萨迪斯·格希德‡薩迪斯·格希德',
    nil,
    'Leve a Pena de Bicoafiado para Tádius Sombraustera na Barreira do Inferno.‡Принесите перо Остроклюва Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Scharfschnabels Feder zu Thadius Grimmschatten in die verwüsteten Lande.‡뾰족부리의 깃털을 저주받은 땅에 있는 샤디우스 그림셰이드에게 가져가야 합니다.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva la pluma de Picoafilado a Thadius Sombramacabra a Las Tierras Devastadas.‡Apporter la Plume de Bec-tranchant à Thadius Sinissombre, dans les Terres foudroyées.‡将沙普比克的羽毛交给诅咒之地的萨迪斯·格希德。‡將沙普比克的羽毛交給詛咒之地的薩迪斯·格希德。',
  }
},
[2991] = {
  {
    'Medalhão de Nekrum‡Медальон Некрума‡Nekrums Medaillon‡네크룸의 메달‡Medallón de Nekrum‡Medallón de Nekrum‡Le médaillon de Nekrum‡耐克鲁姆的徽章‡耐克魯姆的勳章',
    nil,
    'Leve o Medalhão de Nekrum para Tádius Sombraustera na Barreira do Inferno.‡Отнесите медальон Некрума Тадиусу Мрачной Тени в Выжженные земли.‡Bringt Thadius Grimmschatten in den verwüsteten Landen Nekrums Medaillon.‡네크룸의 메달을 저주받은 땅에 있는 샤디우스 그림셰이드에게 가져가야 합니다.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Lleva el medallón de Nekrum a Thadius Sombramacabra a Las Tierras Devastadas.‡Apporter le Médaillon de Nekrum à Thadius Sinissombre, dans les Terres foudroyées.‡将耐克鲁姆的徽章交给诅咒之地的萨迪斯·格希德。‡將耐克魯姆的勳章交給詛咒之地的薩迪斯·格希德。',
  }
},
[2992] = {
  {
    'A divinação‡Прорицание‡Der Rutengang‡점치기‡El ritual de adivinación‡El ritual de adivinación‡La Divination‡占卜‡占卜',
    nil,
    'Espere até que Sombraustera termine o ritual de divinação.‡Дождитесь, пока Мрачная Тень не закончит ритуал прорицания.‡Wartet, bis Grimmschatten das Rutengangritual durchgeführt hat.‡그림셰이드가 점치기 의식을 행하는 동안 기다리십시오.‡Espera a que Sombramacabra realice el ritual de adivinación.‡Espera a que Sombramacabra realice el ritual de adivinación.‡Attendre que Grimshade ait fini de pratiquer son rituel de divination.‡等待萨迪斯完成占卜仪式。‡等待薩迪斯完成占卜儀式。',
  }
},
[2993] = {
  {
    'Retorno às Terras Agrestes‡Назад во Внутренние земли‡Rückkehr ins Hinterland‡동부 내륙지로 돌아가기‡Vuelve a las Tierras del Interior‡Regresa a las Tierras del Interior‡Retour dans les Hinterlands‡返回辛特兰‡返回辛特蘭',
    nil,
    'Fale com o Mestre de Grifos Garra-de-acha.‡Поговорите с укротителем грифонов Разящим Когтем.‡Sprecht mit Greifenmeister Krallenaxt.‡그리핀 조련사 탈론액스와 대화하십시오.‡Habla con el maestro de grifos Garracha.‡Habla con el maestro de grifos Garracha.‡Parler au Maître des gryphons Talonaxe.‡与辛特兰的狮鹫管理员沙拉克·鹰斧谈一谈。‡與辛特蘭的獅鷲獸管理員沙拉克·鷹斧談話。',
  }
},
[2994] = {
  {
    'Salvando Bicoafiado‡Спасение Остроклюва‡Scharfschnabels Rettung‡뾰족부리 구출‡Salvar a Picoafilado‡Salvar a Picoafilado‡Sauver Bec-tranchant‡拯救沙普比克‡拯救沙普比克',
    nil,
    'Lute até o topo de Jintha\'Alor, mate a Sacerdotisa Torpe Bagata para pegar a chave da jaula de Bicoafiado e salvá-lo.‡Пробейтесь в верхнюю часть Джинта\'Алора, убейте коварную жрицу Ведьмису, возьмите у нее ключ от клетки и освободите Остроклюва.‡Kämpft Euch bis zum Gipfel von Jintha\'Alor durch, tötet die üble Priesterin Hexx, um an den Schlüssel zu Scharfschnabels Käfig zu kommen, und rettet Scharfschnabel.‡진타알로의 꼭대기까지 올라가 타락한 여사제 헥스를 처치하고 뾰족부리가 갇혀 있는 우리의 열쇠를 빼앗은 다음 뾰족부리를 구출해야 합니다.‡Llega hasta la cima de Jintha\'Alor, mata a la Sacerdotisa Vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Llega hasta la cima de Jintha\'Alor, mata a la sacerdotisa vil Hexx, consigue la llave de la jaula y rescata a Picoafilado.‡Combattre jusqu\'au sommet de Jintha\'Alor, tuer la vile prêtresse Maléficia pour obtenir la clé de la cage de Bec-tranchant, et sauver Bec-tranchant.‡到辛萨罗山顶去，杀掉邪恶祭司海克斯，找到沙普比克笼子的钥匙，然后救出沙普比克。‡到辛薩羅山頂去，殺掉邪惡祭司海克斯，找到沙普比克籠子的鑰匙，然後救出沙普比克。',
  }
},
[2995] = {
  {
    'Linhas de comunicação‡Линии связи‡Nachrichtenwege‡연락망‡Líneas de comunicación‡Líneas de comunicación‡Lignes de communication‡联络中心‡溝通管道',
    nil,
    'Urraca Convulserpe, da Cidade Baixa, quer que você viaje até as Terras Agrestes e queime os Arquivos do Altovale, os Relatórios do Altovale e as Cartas do Altovale.‡Оран Змеиные Кольца из Подгорода просит вас отправиться во Внутренние земли и сжечь отчет Высокодолья, заметки Высокодолья и записи Высокодолья.‡Oran Schlangenfuß in Unterstadt will, dass Ihr ins Hinterland reist und die Hochtalaufzeichnungen, Hochtalberichte und Hochtalnotizen verbrennt.‡언더시티에 있는 오란 스네이크레이드가 동부 내륙지로 가서 깊은골짜기 기록문, 깊은골짜기 보고서, 그리고 깊은골짜기 쪽지를 태워달라고 부탁했습니다.‡Oran Cortopiente de Entrañas quiere que viajes a las Tierras del Interior y que quemes las actas de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Quema los registros de Vallealto, el informe de Vallealto y las notas de Vallealto.‡Oran Serpenroule, de Fossoyeuse, vous demande de vous rendre dans les Hinterlands et d\'y brûler les Registres du Haut-val, le Rapport du Haut-val et les Notes du Haut-val.‡幽暗城的奥兰·斯内克威瑟让你到辛特兰去烧毁高原精灵记录、高原精灵报告和高原精灵信件。‡幽暗城的奧蘭·蛇繞讓你到辛特蘭去燒毀高原精靈記錄、高原精靈報告和高原精靈信件。',
  }
},
[2996] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아서‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[2997] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[2998] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[2999] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre, à Forgefer.‡和铁炉堡的蒂萨·热炉谈一谈。‡',
  }
},
[3000] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화하십시오.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parler à Tiza Forgeguerre à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談話。',
  }
},
[3001] = {
  {
    'Procurando Strahad‡На поиски Страхада‡Die Suche nach Strahad‡스트라드를 찾아‡Buscando a Strahad‡Buscando a Strahad‡À la recherche de Strahad‡寻找斯坦哈德‡尋找斯坦哈德',
    nil,
    'Procure Strahad Farsan na Vila Catraca.‡Поговорите со Страхадом Фарсаном в Кабестане.‡Findet Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선을 찾아가야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Trouver Strahad Farsan, à Cabestan.‡在棘齿城找到斯坦哈德·法尔杉。‡在棘齒城找到斯坦哈德·法爾杉。',
  }
},
[3002] = {
  {
    'O orbe Gordunni‡Сфера Гордунни‡Die Gordunnikugel‡골두니 수정구‡El orbe Gordunni‡El orbe Gordunni‡L\'Orbe Gordunni‡戈杜尼宝珠‡',
    nil,
    'Leve o Orbe Gordunni para Uthel\'nay no Salão Agulhas Negras, em Orgrimmar.‡Отнести сферу Гордунни Утель\'наю в Пристанище Темнотерна в Оргриммаре.‡Bringt die Gordunnikugel zu Uthel\'nay in die Dunkeldornenlodge in Orgrimmar.‡오그리마의 검은장미 오두막에 있는 우텔나이에게 골두니 수정구를 가져가야 합니다.‡Lleva el orbe Gordunni a Uthel\'nay, que está en la Cabaña de Brezo de Orgrimmar.‡Lleva el orbe Gordunni a Uthel\'nay, que está en la Cabaña de Brezo de Orgrimmar.‡Apporter l\'Orbe Gordunni à Uthel\'nay, au pavillon de Buissombre, à Orgrimmar.‡将戈杜尼宝珠交给奥格瑞玛暗木小屋里的尤塞尔奈。‡',
  }
},
[3022] = {
  {
    'Manuseie com cuidado‡Не кантовать!‡Vorsichtig behandeln‡취급 주의‡Un envío frágil‡Un envío frágil‡À manipuler avec soin‡小心运送‡小心運送',
    nil,
    'Leve o Caixote Cuidadosamente Embalado para Erelas Ambarcéu, na Vila de Rut\'theran.‡Отнесите тщательно упакованный ящик Эреласу Янтарному Небу в деревню Рут\'теран.‡Bringt die sorgfältig verpackte Kiste zu Erelas Himmelsbern in das Dorf Rut\'theran.‡루테란 마을에 있는 에렐라스 앰버스카이에게 조심스럽게 포장된 상자를 가져가야 합니다.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Llévale la caja cuidadosamente empaquetada a Erelas Cieloámbar, que está en Aldea Rut\'theran.‡Apporter la Caisse soigneusement empaquetée à Erelas Ambreciel, au village de Rut\'theran.‡把仔细包装过的箱子交给鲁瑟兰村的艾瑞拉斯-琥珀。‡把仔細包裝過的木箱交給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[3042] = {
  {
    'Têmpera de troll‡Троллье месиво‡Trollaushärter‡트롤 경화제‡Temple trol‡Temple trol‡Agent durcissant troll‡巨魔调和剂‡食人妖調和劑',
    nil,
    'Leve 20 Frascos de Têmpera de Troll para Trenton Lumartelo em Geringontzan.‡Принесите 20 фиалов с Тролльим месивом.‡Bringt 20 Phiolen Trollaushärter zu Trenton Lichthammer in Gadgetzan.‡가젯잔에 있는 트렌튼 라이트해머에게 트롤 경화제 20병을 가져가야 합니다.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Lleva 20 viales de temple trol a Trenton Mazaligera en Gadgetzan.‡Apporter 20 Fioles d\'agent durcissant troll à Trenton Martelume, à Gadgetzan.‡收集20瓶巨魔调和剂，把它们交给加基森的特伦顿·轻锤。‡收集20瓶食人妖調和劑，把它們交給加基森的特倫頓·輕錘。',
  }
},
[3062] = {
  {
    'Coração sombrio‡Темное сердце‡Dunkles Herz‡검은 심장‡Corazón oscuro‡Corazón oscuro‡Cœur noir‡黑暗之心‡黑心',
    nil,
    'Talo Casco de Espinhos, da Aldeia Mojache, quer o Coração Sombrio de Edana Iragarra.‡Принесите темное сердце Эданы Коготь Ненависти Тало Терновому Копыту.‡Talo Dornhuf im Camp Mojache will das dunkle Herz von Edana Hasskralle.‡모자케 야영지에 있는 탈로 쏜후프가 에다나의 검은 심장을 가져다 달라고 부탁했습니다.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garraodio.‡Talo Pezuñahendida, del Campamento Mojache quiere el corazón oscuro de Edana Garfaodio.‡Rapporter le Coeur noir d\'Edana Serrehaine à Talo Sabot-de-ronce, au Camp Mojache.‡莫沙彻营地的塔罗·刺蹄要你给他拿去艾丹娜·邪爪的黑心。‡莫沙徹營地的塔羅·刺蹄要你給他拿去艾丹娜·邪爪的黑心。',
  }
},
[3063] = {
  {
    'Vingança em Nascente Norte‡Месть стае Студеных Ключей‡Rache an den Nordschwingen‡바람계곡일족에 대한 복수‡Vengarse de las Nortearroyo‡Venganza contra Nortearroyo‡Se venger des Ruissenord‡对鹰身人的复仇‡對鷹身人的復仇',
    nil,
    'Talo Casco de Espinhos quer que você mate 4 Harpias da Nascente Norte, 4 Plumerrantes da Nascente Norte, 4 Arautos do Vento da Nascente Norte e 4 Matadoras da Nascente Norte.‡Убейте 4 гарпий, 4 разбойниц, 4 призывательниц ветра и 4 убийц из стаи Студеных Ключей по просьбе Тало Тернового Копыта.‡Talo Dornhuf möchte, dass Ihr 4 Harpyien der Nordschwingen, 4 Wildfedern der Nordschwingen, 4 Windruferinnen der Nordschwingen und 4 Töter der Nordschwingen erschlagt.‡탈로 쏜후프가 바람계곡일족 하피 4마리, 바람계곡일족 약탈자 4마리, 바람계곡일족 바람마녀 4마리, 그리고 바람계곡일족 암살자 4마리를 처치해 달라고 부탁했습니다.‡Talo Pezuñahendida quiere que mates a 4 arpías Nortearroyo, 4 Malaplumas Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadoras Nortearroyo.‡Talo Pezuñahendida quiere que mates a 4 arpías Nortearroyo, 4 Malaplumas Nortearroyo, 4 clamavientos Nortearroyo y 4 destripadoras Nortearroyo.‡Tuer 4 Harpies Ruissenord, 4 Volplumes Ruissenord, 4 Imploratrices célestes Ruissenord et 4 Pourfendeuses Ruissenord pour Talo Sabot-de-ronce.‡塔罗·刺蹄让你杀掉4个北泉鹰身人、4个北泉游荡者、4个北泉唤风者和4个北泉杀戮者。‡塔羅·刺蹄讓你殺掉4個北泉鷹身人、4個北泉遊蕩者、4個北泉喚風者和4個北泉殺戮者。',
  }
},
[3064] = {
  {
    '‡‡‡‡‡‡‡‡<NYI> <TXT> Pirate Hats',
    nil,
    '‡‡‡‡‡‡‡‡帶20頂完整的海賊帽給尤爾巴·斯庫比格特。',
  }
},
[3065] = {
  {
    'Tabuleta Simples‡Простая табличка‡Einfache Schrifttafel‡간결한 서판‡Tablilla simple‡Tablilla simple‡Tablette simple‡普通石板‡普通石板',
    nil,
    'Leia a Tabuleta Simples e fale com Frang no Vale das Provações.‡Прочтите простую табличку и поговорите с Франгом в долине Испытаний.‡Lest die einfache Schrifttafel und sprecht mit Frang im Tal der Prüfungen.‡간결한 서판을 읽어보고 시험의 골짜기에 있는 프랑과 대화하십시오.‡Lee la Tablilla simple y habla con Frang en el Valle de los Retos.‡Lee la Tablilla simple y habla con Frang en el Valle de los Retos.‡Lire la Tablette simple, et parler à Frang, dans la Vallée des épreuves.‡阅读普通石板，然后和试炼谷的弗朗恩谈一谈。‡',
  }
},
[3082] = {
  {
    'Tabuleta cinzelada‡Каменная табличка‡Geätzte Schrifttafel‡글이 새겨진 서판‡Tablilla con grabados‡Tablilla con grabados‡Tablette gravée‡风蚀石板‡風蝕石板',
    nil,
    'Encontre Jen\'shan no Vale das Provações.‡Поговорите с Джен\'шан в долине Испытаний.‡Sprecht mit Jen\'shan im Tal der Prüfungen.‡글이 새겨진 서판을 읽어보고 시험의 골짜기에 있는 젠샨과 대화하십시오.‡Habla con Jen\'shan en el Valle de los Retos.‡Habla con Jen\'shan en el Valle de los Retos.‡Parler à Jen\'shan dans la Vallée des épreuves.‡和试炼谷的基沙谈一谈。‡',
  }
},
[3083] = {
  {
    'Tabuleta cifrada‡Табличка с письменами‡Verschlüsselte Schrifttafel‡암호화된 서판‡Tablilla encriptada‡Tablilla encriptada‡Tablette codée‡密文石板‡密文石板',
    nil,
    'Leia a Tabuleta Cifrada e fale com Rwag no Vale das Provações.‡Прочтите табличку с письменами и поговорите с Руагом в долине Испытаний.‡Lest die verschlüsselte Schrifttafel und sprecht mit Rwag im Tal der Prüfungen.‡암호화된 서판을 읽어보고 시험의 골짜기에 있는 르와그와 대화하십시오.‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lee la Tablilla encriptada y habla con Rwag en el Valle de los Retos.‡Lire la Tablette codée, et parler à Rwag, dans la Vallée des épreuves.‡阅读密文石板，然后和试炼谷的鲁瓦格谈一谈。‡',
  }
},
[3084] = {
  {
    'Tabuleta inscrita em runas‡Руническая табличка‡Mit Runen beschriftete Schrifttafel‡룬으로 새겨진 서판‡La tablilla con runas grabadas‡La tablilla con runas grabadas‡Tablette runique‡符文石板‡符文銘刻石板',
    nil,
    'Fale com Shikrik no Vale das Provações.‡Поговорите с Шикрик в долине Испытаний.‡Sprecht mit Shikrik im Tal der Prüfungen.‡룬으로 새겨진 서판을 읽어보고 시험의 골짜기에 있는 시크리크와 대화하십시오.‡Habla con Shikrik en el Valle de los Retos.‡Habla con Shikrik en el Valle de los Retos.‡Parler à Shikrik dans la Vallée des épreuves.‡和试炼谷的史克里克谈一谈。‡',
  }
},
[3085] = {
  {
    'Tabuleta consagrada‡Освященная табличка‡Geheiligte Schrifttafel‡성스러운 서판‡Tablilla sacralizada‡Tablilla sacralizada‡Tablette bénie‡神圣石板‡神聖石板',
    nil,
    'Leia a Tabuleta Consagrada e fale com Ken\'jai, do lado de fora do Covil, no Vale das Provações.‡Прочтите освященную табличку и поговорите с Кен\'джаем у Логова в долине Испытаний.‡Lest die geheiligte Schrifttafel und sprecht mit Ken\'jai außerhalb des Höhlenbaus im Tal der Prüfungen.‡성스러운 서판을 읽어보고 시험의 골짜기의 동굴 막사 밖에 있는 켄자이와 대화하십시오.‡Lee la tablilla sacralizada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lee la tablilla sacralizada y habla con Ken\'jai a las puertas de El Cubil en el Valle de los Retos.‡Lire la Tablette bénie, et parler à Ken\'jai, à l\'extérieur de l\'Antre, dans la Vallée des épreuves.‡阅读神圣石板，然后和试炼谷大兽穴外的肯杰谈一谈。‡閱讀神聖石板，然後和試煉谷大獸穴外的肯傑談話。',
  }
},
[3086] = {
  {
    'Tabuleta glífica‡Табличка с тайными знаками‡Glyphenschrifttafel‡상형 문자로 된 서판‡Tablilla glífica‡Tablilla glífica‡Tablette glyphée‡雕文石板‡雕紋石板',
    nil,
    'Leia a Tabuleta Glífica e fale com Mai\'ah perto do Covil, no Vale das Provações.‡Прочтите табличку с тайными знаками и поговорите с Май\'ах у входа в Логово в долине Испытаний.‡Lest die mit Glyphen versehene Schrifttafel und sprecht mit Mai\'ah beim Eingang zum Höhlenbau im Tal der Prüfungen.‡상형 문자로 된 서판을 읽어보고 시험의 골짜기의 동굴 막사 입구 근처에 있는 마이아와 대화하십시오.‡Lee la tablilla glífica y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lee la tablilla glífica y habla con Mai\'ah junto a la entrada a El Cubil, en el Valle de los Retos.‡Lire la Tablette glyphée, et parler à Mai\'ah, près de l\'entrée de l\'Antre, dans la Vallée des épreuves.‡阅读雕文石板，然后和试炼谷里大兽穴入口附近的迈安谈一谈。‡',
  }
},
[3087] = {
  {
    'Pergaminho cinzelado‡Пергамент с письменами‡Geätztes Pergament‡글이 새겨진 양피지‡Papiro con grabados‡Papiro con grabados‡Parchemin gravé‡风蚀羊皮纸‡風蝕羊皮紙',
    nil,
    'Leia o Pergaminho Cinzelado e fale com Jen\'shan no Vale das Provações.‡Прочтите пергамент с письменами и поговорите с Джен\'шан в долине Испытаний.‡Lest das geätzte Pergament und sprecht mit Jen\'shan im Tal der Prüfungen.‡글이 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 젠샨과 대화하십시오.‡Lee el papiro con grabados y habla con Jen\'shan en el Valle de los Retos.‡Lee el papiro con grabados y habla con Karranisha en el Valle de los Retos.‡Lire le Parchemin gravé, et parler à Jen\'shan, dans la Vallée des épreuves.‡阅读风蚀羊皮纸，然后和试炼谷的基沙谈一谈。‡',
  }
},
[3088] = {
  {
    'Pergaminho cifrado‡Исписанный пергамент‡Verschlüsseltes Pergament‡암호화된 양피지‡Papiro encriptado‡Papiro encriptado‡Parchemin codé‡密文羊皮纸‡密文羊皮紙',
    nil,
    'Leia o Pergaminho Cifrado e fale com Rwag no Vale das Provações.‡Прочтите исписанный пергамент и поговорите с Руагом в долине Испытаний.‡Lest das verschlüsselte Pergament und sprecht mit Rwag im Tal der Prüfungen.‡암호화된 양피지를 읽어보고 시험의 골짜기에 있는 르와그와 대화하십시오.‡Lee el papiro encriptado y habla con Rwag en el Valle de los Retos.‡Lee el papiro encriptado y habla con Rwag en el Valle de los Retos.‡Lire le Parchemin codé, et parler à Rwag, dans la Vallée des épreuves.‡阅读密文羊皮纸，然后和试炼谷的鲁瓦格谈一谈。‡',
  }
},
[3089] = {
  {
    'Pergaminho inscrito em runas‡Рунический пергамент‡Mit Runen beschriftetes Pergament‡룬으로 새겨진 양피지‡El papiro con runas grabadas‡El papiro con runas grabadas‡Parchemin runique‡符文羊皮纸‡符文羊皮紙',
    nil,
    'Leia o Pergaminho Inscrito em Runas e fale com Shikrik no Vale das Provações.‡Прочтите рунический пергамент и поговорите с Шикрик в долине Испытаний.‡Lest das mit Runen beschriebene Pergament und sprecht mit Shikrik im Tal der Prüfungen.‡룬으로 새겨진 양피지를 읽어보고 시험의 골짜기에 있는 시크리크와 대화하십시오.‡Lee el papiro con runas grabadas y habla con Shikrik en el Valle de los Retos.‡Lee el papiro con runas grabadas y habla con Shikrik en el Valle de los Retos.‡Lire le Parchemin runique, et parler à Shikrik, dans la Vallée des épreuves.‡阅读符文羊皮纸，然后和试炼谷的史克里克谈一谈。‡閱讀符文羊皮紙，然後和試煉谷的史克里克談話。',
  }
},
[3090] = {
  {
    'Pergaminho maculado‡Гниющий пергамент‡Besudeltes Pergament‡오래된 양피지‡Papiro corrupto‡Papiro corrupto‡Parchemin contaminé‡被污染的羊皮纸‡受污染的羊皮紙',
    nil,
    'Leia o Pergaminho Conspurcado e fale com Nartok dentro do Covil, no Vale das Provações.‡Прочтите гниющий пергамент и поговорите с Нартоком в Логове в долине Испытаний.‡Lest das besudelte Pergament und sprecht mit Nartok im Höhlenbau im Tal der Prüfungen.‡오래된 양피지를 읽어보고 시험의 골짜기의 동굴 막사에 있는 나르톡과 대화하십시오.‡Lee el papiro corrupto y habla con Nartok en El Cubil en el Valle de los Retos.‡Lee el papiro corrupto y habla con Nartok en el Valle de los Retos.‡Lire le Parchemin contaminé, et parler à Nartok, à l\'intérieur de l\'Antre, dans la Vallée des épreuves.‡阅读被污染的羊皮纸，然后到试炼谷的大兽穴里去和纳托克谈一谈。‡閱讀受污染的羊皮紙，然後到試煉谷的大獸穴裡去和納托克談話。',
  }
},
[3091] = {
  {
    'Bilhete‡Простая записка‡Einfache Notiz‡간결한 쪽지‡La nota simple‡La nota simple‡Note simple‡简易便笺‡簡易便箋',
    nil,
    'Leia o Bilhete e fale com Harutt Chifre Troante, na Aldeia Narache.‡Прочтите простую записку и поговорите с Харуттом Громовым Рогом в Лагере Нараче.‡Lest die einfache Nachricht und sprecht mit Harutt Donnerhorn im Camp Narache.‡간결한 쪽지를 읽고 나라체 야영지에 있는 하루트 썬더혼과 대화해야 합니다.‡Lee la nota simple y habla con Harutt Tronacuerno en el Campamento Narache.‡Lee la nota simple y habla con Harutt Tronacuerno en el Campamento Narache.‡Lire la Note simple, et parler à Harutt Corne-tonnerre, au Camp Narache.‡阅读简易便笺，然后与纳拉其营地的哈鲁特·雷角谈一谈。‡',
  }
},
[3092] = {
  {
    'Bilhete cinzelado‡Нацарапанная записка‡Geätzte Notiz‡글이 새겨진 쪽지‡La nota con grabados‡La nota con grabados‡Note gravée‡风化便笺‡銘刻便箋',
    nil,
    'Leia o Bilhete Cinzelado e fale com Lanka Tiro Distante na Chapada Nuvem Vermelha.‡Прочтите нацарапанную записку и поговорите с Ланко Дальнострелом на Плато Красного Облака.‡Lest die geätzte Nachricht und sprecht mit Lanka Weitschuss auf der Hochwolkenebene.‡글이 새겨진 쪽지를 읽고 붉은구름 고원에 있는 랑카 파샷과 대화해야 합니다.‡Lee la nota con grabados y habla con Lanka Tirolejano en Mesa de la Nube Roja.‡Lee la nota con grabados y habla con Lanka Tirolejano en el campamento Narache.‡Lire la Note gravée, et parler à Lanka Vise-loin, sur la Mesa de Nuage rouge.‡阅读风化便笺，然后与红云台地的兰卡·远箭谈一谈。‡',
  }
},
[3093] = {
  {
    'Bilhete inscrito em runas‡Руническая записка‡Mit Runen beschriftete Notiz‡룬으로 새겨진 쪽지‡La nota con runas grabadas‡La nota con runas grabadas‡Note runique‡符文便笺‡符文銘刻便箋',
    nil,
    'Leia o Bilhete Inscrito em Runas e fale com Meela Anda com a Aurora na Aldeia Narache.‡Прочтите руническую записку и поговорите с Милой Рассветной Странницей в Лагере Нараче.‡Lest die mit Runen beschriftete Nachricht und sprecht mit Meela Morgenwandler im Camp Narache.‡룬으로 새겨진 쪽지를 읽고 나라체 야영지에 있는 밀라 던스트라이더와 대화해야 합니다.‡Lee la nota con runas y habla con Meela Caminalba en el Campamento Narache.‡Lee la nota con runas y habla con Meela Caminalba en el Campamento Narache.‡Lire la Note runique, et parler à Meela Dawnstrider, à Camp Narache.‡阅读符文便笺，然后与纳拉其营地的米拉-晨行者谈一谈。‡',
  }
},
[3094] = {
  {
    'Bilhete verdejante‡Зеленая записка‡Tiefgrüne Notiz‡푸른 쪽지‡La nota verdeante‡La nota verdeante‡Note verdoyante‡绿色便笺‡綠色便箋',
    nil,
    'Leia o Bilhete Verdejante e fale com Gart Corre com a Névoa, na Aldeia Narache.‡Прочтите зеленую записку и поговорите с Гартом Вестником Туманов в Лагере Нараче.‡Lest die tiefgrüne Notiz und sprecht mit Gart Nebelläufer im Camp Narache.‡푸른 쪽지를 읽고 나라체 야영지에 있는 가트 미스트러너와 대화해야 합니다.‡Lee la nota verdeante y habla con Gart Correbruma en el Campamento Narache.‡Lee la nota verdeante y habla con Gart Correbruma en el Campamento Narache.‡Lire la Note verdoyante, et parler à Gart Cours-la-brume, au Camp Narache.‡阅读绿色便笺，然后与纳拉其营地的加尔特·迷雾行者谈一谈。‡',
  }
},
[3095] = {
  {
    'Pergaminho simples‡Простой свиток‡Einfache Rolle‡간결한 두루마리‡Un pergamino simple‡Un pergamino simple‡Parchemin simple‡简易卷轴‡簡易卷軸',
    nil,
    'Leia o Pergaminho Simples e fale com Dannal Stern em Plangemortis.‡Прочитайте простой свиток и поговорите с Данналом Штерном в Могильнике.‡Lest die einfache Schriftrolle und sprecht mit Dannal Stern in Todesend.‡간결한 두루마리를 읽고 데스넬에 있는 다날 스턴과 대화해야 합니다.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lee el pergamino simple, luego ve a Camposanto y habla con Dannal Stern.‡Lire le Parchemin simple, et parler à Dannal Stern, au Glas.‡阅读简易卷轴，然后和丧钟镇的丹纳尔·斯特恩谈一谈。‡',
  }
},
[3096] = {
  {
    'Pergaminho cifrado‡Зашифрованный свиток‡Verschlüsselte Rolle‡암호화된 두루마리‡Un pergamino codificado‡Un pergamino codificado‡Parchemin codé‡密文卷轴‡密文卷軸',
    nil,
    'Leia o Pergaminho Cifrado e fale com o Davi Trias em Plangemortis.‡Прочитайте зашифрованный свиток и поговорите с Давидом Триасом в Могильнике.‡Lest die verschlüsselte Schriftrolle und sprecht mit David Trias in Todesend.‡암호화된 두루마리를 읽고 데스넬에 있는 데이비드 트리아스와 대화해야 합니다.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lee el pergamino encriptado, luego ve a Camposanto y habla con David Trias.‡Lire le Parchemin codé, et parler à David Trias, au Glas.‡阅读密文卷轴，然后和丧钟镇的大卫·提亚斯谈一谈。‡閱讀密文卷軸，然後和喪鐘鎮的大衛·提亞斯談話。',
  }
},
[3097] = {
  {
    'Pergaminho consagrado‡Священный свиток‡Geheiligte Rolle‡성스러운 두루마리‡Un pergamino sacralizado‡Un pergamino sacralizado‡Parchemin béni‡神圣卷轴‡神聖卷軸',
    nil,
    'Leia o Pergaminho Consagrado e fale com o Clérigo das Trevas Duesten, na igreja em Plangemortis.‡Прочитайте священный свиток и поговорите с темным священником Дьюстеном в церкви Могильника.‡Lest die geheiligte Schriftrolle und sprecht mit dem dunklen Kleriker Duesten in der Kirche von Todesend.‡성스러운 두루마리를 읽고 데스넬의 교회에 있는 어둠의사제 듀스텐과 대화해야 합니다.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lee el pergamino sagrado, luego ve a la iglesia de Camposanto y habla con el clérigo oscuro Duesten.‡Lire le Parchemin béni, et parler au sombre clerc Duesten, dans l\'église du Glas.‡阅读神圣卷轴，然后和丧钟镇教堂的黑暗牧师杜斯滕谈一谈。‡閱讀神聖卷軸，然後和喪鐘鎮教堂的黑暗教士杜斯滕談話。',
  }
},
[3098] = {
  {
    'Pergaminho glífico‡Свиток, покрытый письменами‡Glyphenrolle‡상형 문자로 된 두루마리‡Un pergamino glífico‡Un pergamino glífico‡Parchemin glyphé‡雕文卷轴‡雕紋卷軸',
    nil,
    'Leia o Pergaminho Glífico e fale com Isabella na igreja em Plangemortis.‡Прочитайте свиток, покрытый письменами, и поговорите с Изабеллой в церкви Могильника.‡Lest die mit Glyphen versehene Schriftrolle und sprecht mit Isabella in der Kirche von Todesend.‡상형 문자로 된 두루마리를 읽고 데스넬 교회에 있는 이자벨라와 대화해야 합니다.‡Lee el pergamino glífico, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lee el pergamino glífico, luego ve a la iglesia de Camposanto y habla con Isabella.‡Lire le Parchemin glyphé, et parler à Isabella, dans l\'église du Glas.‡阅读雕文卷轴，然后和丧钟镇教堂的伊莎贝拉谈一谈。‡',
  }
},
[3099] = {
  {
    'Pergaminho conspurcado‡Нечистый свиток‡Besudelte Rolle‡오래된 두루마리‡Un pergamino corrupto‡Un pergamino corrupto‡Rouleau contaminé‡被污染的卷轴‡受污染的卷軸',
    nil,
    'Leia o Pergaminho Conspurcado e fale com Maximillion em Plangemortis.‡Прочитайте нечистый свиток и поговорите с Максимиллионом в Могильнике.‡Lest die besudelte Schriftrolle und sprecht mit Maximillion in Todesend.‡오래된 두루마리를 읽고 데스넬에 있는 맥시밀리언과 대화해야 합니다.‡Lee el pergamino corrupto, luego ve a Camposanto y habla con Maximillion.‡Lee el pergamino corrupto, luego ve a Camposanto y habla con Maximillion.‡Lire le Rouleau contaminé, et parler à Maximillion, au Glas.‡阅读被污染的卷轴，然后和丧钟镇的马克希米林谈一谈。‡',
  }
},
[3100] = {
  {
    'Carta simples‡Обычное письмо‡Einfacher Brief‡간결한 편지‡Una carta simple‡Una carta simple‡Lettre simple‡简要的信件‡簡要的信件',
    nil,
    'Leia a Carta Simples e fale com Hipólito Valentim na Abadia de Vila Norte.‡Прочитайте обычное письмо и поговорите с Лланом Бишером в Аббатстве Североземья.‡Lest den einfachen Brief und sprecht mit Llane Beshere in der Abtei von Nordhain.‡간결한 편지를 읽고 노스샤이어 수도원에 있는 레인 비셰어와 대화해야 합니다.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lee la carta simple y habla con Llane Beshere en la Abadía de Villanorte.‡Lire la Lettre simple et parler à Llane Beshere, à l\'Abbaye de Comté-du-nord.‡阅读简要的信件，然后与北郡修道院的莱尼·拜舍尔谈一谈。‡閱讀簡要的信件，然後與北郡修道院的萊尼·拜舍爾談話。',
  }
},
[3101] = {
  {
    'Carta consagrada‡Благословенное письмо‡Geweihter Brief‡신성한 편지‡Una carta consagrada‡Una carta consagrada‡Lettre consacrée‡圣洁信件‡聖化信件',
    nil,
    'Leia a Carta Consagrada e fale com o Irmão Samuel na Abadia de Vila Norte.‡Прочитайте благословенное письмо и поговорите с братом Самуэлем в Аббатстве Североземья.‡Lest den geweihten Brief und sprecht mit Bruder Sammuel in der Abtei von Nordhain.‡신성한 편지를 읽고 노스샤이어 수도원에 있는 수사 사무엘과 대화해야 합니다.‡Lee la carta consagrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lee la carta consagrada y habla con el hermano Sammuel en la Abadía de Villanorte.‡Lire la Lettre consacrée, et parler à Frère Sammuel, à l\'Abbaye de Comté-du-nord.‡阅读圣洁信件，然后和北郡修道院的萨缪尔修士谈一谈。‡',
  }
},
[3102] = {
  {
    'Carta cifrada‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡Una carta cifrada‡Una carta cifrada‡Lettre codée‡密文信件‡密文信件',
    nil,
    'Leia a Carta Cifrada e fale com Rufino Raposo no estábulo atrás da Abadia de Vila Norte.‡Прочитайте зашифрованное письмо и поговорите с Джориком Керриданом в стойлах за Аббатством Североземья.‡Lest den verschlüsselten Brief und sprecht mit Jorik Kerridan im Stall hinter der Abtei von Nordhain.‡암호화된 편지를 읽고 노스샤이어 수도원 뒤 마구간에 있는 요리크 케리던과 대화해야 합니다.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lee la carta cifrada y habla con Jorik Kerridan en el establo que hay tras la Abadía de Villanorte.‡Lire la Lettre codée, et parler à Jorik Kerridan, dans l\'écurie, derrière l\'Abbaye de Comté-du-nord.‡阅读密文信件，然后与北郡修道院的乔里克·克里丹谈一谈。‡',
  }
},
[3103] = {
  {
    'Carta santificada‡Святое письмо‡Geheiligter Brief‡성스러운 편지‡Una carta sacralizada‡Una carta sacralizada‡Lettre bénie‡神圣信件‡神聖信件',
    nil,
    'Lei a Carta Santificada e fale com a Sacerdotisa Anita na Abadia de Vila Norte.‡Прочитайте святое письмо и поговорите с жрицей Анеттой в Аббатстве Североземья.‡Lest den geheiligten Brief und sprecht mit Priesterin Anetta in der Abtei von Nordhain.‡성스러운 편지를 읽고 노스샤이어 수도원에 있는 여사제 아네타와 대화해야 합니다.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lee la carta sacralizada y habla con la sacerdotisa Anetta en la Abadía de Villanorte.‡Lire la Lettre bénie, et parler à la prêtresse Anetta, à l’abbaye de Northshire.‡阅读神圣信件，然后与北郡修道院的牧师安妮塔谈一谈。‡',
  }
},
[3104] = {
  {
    'Carta glífica‡Символьное письмо‡Glyphenbrief‡상형 문자로 된 편지‡Una carta glífica‡Una carta glífica‡Lettre glyphée‡雕文信件‡雕紋信件',
    nil,
    'Leia a Carta Glífica e fale com Gaspar Melchior dentro da Abadia de Vila Norte.‡Прочитайте символьное письмо и поговорите с Кельденом Бременом в Аббатстве Североземья.‡Lest den mit Glyphen versehenen Brief und sprecht mit Khelden Bremen in der Abtei von Nordhain.‡상형 문자로 된 편지를 읽고 노스샤이어 수도원 안에 있는 켈덴 브레멘과 대화해야 합니다.‡Lee la carta glífica y habla con Khelden Bremen en la Abadía de Villanorte.‡Lee la carta glífica y habla con Khelden Bremen en la Abadía de Villanorte.‡Lire la Lettre glyphée, et parler à Khelden Bremen, à l\'intérieur de l\'Abbaye de Comté-du-nord.‡阅读雕文信件，然后与北郡修道院的凯尔东·布雷曼谈一谈。‡',
  }
},
[3105] = {
  {
    'Carta maculada‡Тайное письмо‡Besudelter Brief‡오래된 편지‡Una carta manchada‡Una carta manchada‡Lettre contaminée‡被污染的信件‡受污染的信件',
    nil,
    'Leia a Carta Maculada e fale com Drusilla La Salle perto da Abadia de Vila Norte.‡Прочитайте тайное письмо и поговорите с Друзиллой ла Салле возле Аббатства Североземья.‡Lest den besudelten Brief und sprecht mit Drusilla La Salle nahe der Abtei von Nordhain.‡오래된 편지를 읽고 노스샤이어 수도원 옆에 있는 드루실라 라 살르와 대화해야 합니다.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lee la carta impía y habla con Drusilla La Salle junto a la Abadía de Villanorte.‡Lire la Lettre contaminée, et parler à Drusilla La Salle, à proximité de l\'Abbaye de Comté-du-nord.‡阅读被污染的信件，然后与北郡修道院旁边的杜希拉·拉萨雷谈一谈。‡',
  }
},
[3106] = {
  {
    'Runa simples‡Простая руна‡Einfache Rune‡간결한 룬‡Runa simple‡Runa simple‡Rune simple‡简易符文‡簡易符文',
    nil,
    'Leia a Runa Simples e fale com Thran Khorman no Vale Cristálgida.‡Изучите простую руну. Найдите в Холодной долине Трана Кормана и поговорите с ним.‡Lest die einfache Rune und sprecht mit Thran Khorman im Eisklammtal.‡간결한 룬을 읽어보고 눈마루 골짜기에 있는 스란 코르만과 대화하십시오.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee la runa simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Rune simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易符文，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡',
  }
},
[3107] = {
  {
    'Runa consagrada‡Священная руна‡Geweihte Rune‡신성한 룬‡Runa consagrada‡Runa consagrada‡Rune consacrée‡神圣符文‡聖化符文',
    nil,
    'Leia a Runa Consagrada e fale com Bromos Grummner no Vale Cristálgida.‡Изучите священную руну. Найдите в Холодной долине Бромоса Груммнера и поговорите с ним.‡Lest die geweihte Rune und sprecht mit Bromos Grummler im Eisklammtal.‡신성한 룬을 읽어보고 눈마루 골짜기에서 브로모스 그럼너를 찾아 대화해야 합니다.‡Lee la runa consagrada, luego ve al Valle de Crestanevada y habla con Bromos Grummner.‡Lee la runa consagrada, luego ve a Yunquemar y habla con Bromos Grummner.‡Lire la Rune consacrée, et parler à Bromos Grummneur, dans la Vallée des Frigères.‡阅读神圣符文，然后与寒脊山谷的布罗莫斯·格鲁诺尔谈一谈。‡',
  }
},
[3108] = {
  {
    'Runa cinzelada‡Гравированная руна‡Geätzte Rune‡글이 새겨진 룬‡Runa con grabados‡Runa con grabados‡Rune gravée‡风蚀符文‡風蝕符文',
    nil,
    'Leia a Runa Cinzelada e fale com Thorgas Grimson no Vale Cristálgida.‡Изучите гравированную руну. Найдите в Холодной долине Торгаса Мрачнона и поговорите с ним.‡Lest die geätzte Rune und sprecht mit Thorgas Grimson im Eisklammtal.‡글이 새겨진 룬을 읽어보고 눈마루 골짜기에 있는 토르가스 그림슨과 대화하십시오.‡Lee la runa con grabados, luego ve al Valle de Crestanevada y habla con Thorgas Grimson.‡Lee la runa con grabados, luego ve a Anvilmar y habla con Thorgas Grimson.‡Lire la Rune gravée, et parler à Thorgas Grimson, dans la Vallée des Frigères.‡阅读风蚀符文，然后与寒脊山谷的索加斯·格瑞姆森谈一谈。‡',
  }
},
[3109] = {
  {
    'Runa cifrada‡Зашифрованная руна‡Verschlüsselte Rune‡암호화된 룬‡Runa codificada‡Runa codificada‡Rune codée‡密文符文‡密文符文',
    nil,
    'Leia a Runa Cifrada e fale com Solm Hargrin no Vale Cristálgida.‡Изучите зашифрованную руну. Найдите в Холодной долине Сольма Харгрина и поговорите с ним.‡Lest die verschlüsselte Rune und sprecht mit Solm Hargrin im Eisklammtal.‡암호화된 룬을 읽어보고 눈마루 골짜기에 있는 솔름 하르그린과 대화하십시오.‡Lee la runa codificada, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lee la runa codificada, luego ve a Yunquemar y habla con Solm Hargrin.‡Lire la Rune codée, et parler à Solm Hargrin, dans la Vallée des Frigères.‡阅读密文符文，然后与寒脊山谷的索姆·哈格林谈一谈。‡',
  }
},
[3110] = {
  {
    'Runa santificada‡Благословенная руна‡Geheiligte Rune‡성스러운 룬‡Runa sacralizada‡Runa sacralizada‡Rune bénie‡神圣符文‡神聖符文',
    nil,
    'Leia a Runa Santificada e fale com Branstock Khalder em Sidermar.‡Изучите благословенную руну. Найдите в Старой Наковальне Бранстока Халдера и поговорите с ним.‡Lest die geheiligte Rune und sprecht mit Branstock Khalder in Ambossar.‡성스러운 룬을 읽어보고 앤빌마에 있는 브란스토크 칼더와 대화하십시오.‡Lee la runa sacralizada, luego ve a Yunquemar y habla con Silo Khalder.‡Lee la runa sacralizada, luego ve a Yunquemar y habla con Silo Khalder.‡Lire la Rune bénie, et parler à Branstock Khalder, à Courbenclume.‡阅读神圣符文，然后与安威玛尔的布兰斯托·卡尔德谈一谈。‡',
  }
},
[3112] = {
  {
    'Memorando simples‡Записка‡Einfaches Memorandum‡간결한 쪽지‡Memorándum simple‡Memorándum simple‡Note de service simple‡简易备忘录‡簡易備忘錄',
    nil,
    'Leia o Memorando Simples e fale com Thran Khorman no Vale Cristálgida.‡Прочитайте записку и поговорите с Траном Корманом в Старой Наковальне.‡Lest das einfache Memorandum und sprecht mit Thran Khorman im Eisklammtal.‡간결한 쪽지를 읽어보고 눈마루 골짜기에 있는 스란 코르만과 대화하십시오.‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lee el memorándum simple, luego ve al Valle de Crestanevada y habla con Thran Khorman.‡Lire la Note de service simple, et parler à Thran Khorman, dans la Vallée des Frigères.‡阅读简易备忘录，然后与寒脊山谷的斯兰·库尔曼谈一谈。‡',
  }
},
[3113] = {
  {
    'Memorando cifrado‡Зашифрованная записка‡Verschlüsseltes Memorandum‡암호화된 쪽지‡Memorándum encriptado‡Memorándum encriptado‡Note de service codée‡密文备忘录‡密文備忘錄',
    nil,
    'Leia o Memorando Cifrado e fale com Solm Hargrin no Vale Cristálgida.‡Прочтите зашифрованную записку. Найдите Сольма Харгрина в Старой Наковальне и поговорите с ним.‡Lest das verschlüsselte Memorandum und sprecht mit Solm Hargrin im Eisklammtal.‡암호화된 쪽지를 읽어보고 눈마루 골짜기에 있는 솔름 하르그린과 대화하십시오.‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lee el memorándum encriptado, luego ve al Valle de Crestanevada y habla con Solm Hargrin.‡Lire la Note de service codée, et parler à Solm Hargrin, dans la Vallée des Frigères.‡阅读密文备忘录，然后与寒脊山谷的索姆·哈格林谈一谈。‡',
  }
},
[3114] = {
  {
    'Memorando Glífico‡Таинственная записка‡Glyphenmemorandum‡상형 문자로 된 쪽지‡Memorándum glífico‡Memorándum glífico‡Note de service glyphée‡雕文备忘录‡雕紋備忘錄',
    nil,
    'Leia o Memorando Glífico e fale com Marryk Nurribit em Sidermar, no alto do Vale Cristálgida.‡Прочитайте таинственную записку. Найдите в Старой Наковальне Маррайка Нуррибита и поговорите с ним.‡Lest das mit Glyphen versehene Memorandum und sprecht mit Marryk Nurribit in Ambossar oberhalb des Eisklammtals.‡상형 문자로 된 쪽지를 읽어보고 눈마루 골짜기 위 앤빌마에 있는 마릭 너리빗과 대화하십시오.‡Lee el memorándum glífico, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lee el memorándum glífico, luego ve a hablar con Marryk Nurribit, dentro de Yunquemar, sobre el Valle de Crestanevada.‡Lire la Note de service glyphée, et parler à Marryk Nurribit, dans Courbenclume, au-dessus de la Vallée des Frigères.‡阅读雕文备忘录，然后与寒脊山谷上的安威玛尔镇里的玛瑞克·斯托纳尔谈一谈。‡',
  }
},
[3115] = {
  {
    'Memorando Maculado‡Гниющая записка‡Besudeltes Memorandum‡오래된 쪽지‡Memorándum corrupto‡Runa corrupta‡Note de service contaminée‡被污染的备忘录‡受污染的符文',
    nil,
    'Leia o Memorando Maculado e fale com Alamar Carranca em Sidermar, no alto do Vale Cristálgida.‡Прочтите гниющую записку. Найдите в Старой Наковальне Аламара Гримма и поговорите с ним.‡Lest das besudelte Memorandum und sprecht mit Alamar Grimm in Ambossar oberhalb des Eisklammtals.‡오래된 쪽지를 읽고 눈마루 골짜기 위의 앤빌마에 있는 알라마 그림과 대화하십시오.‡Lee el memorándum corrupto, luego ve a hablar con Alamar Grimm que está en Yunquemar, sobre el Valle de Crestanevada.‡Lee la runa corrupta, luego ve a hablar con Saripal Cervezardiente que está en Yunquemar, sobre el Valle de Crestanevada.‡Lire la Note de service contaminée, et parler à Alamar Grimm, dans Courbenclume, au-dessus de la Vallée des Frigères.‡阅读被污染的备忘录，然后寒脊山谷上的安威玛尔镇里的阿拉玛尔·格里姆谈一谈。‡',
  }
},
[3116] = {
  {
    'O selo simples‡Простой знак‡Einfaches Siegelzeichen‡간결한 도장‡El sigilo simple‡El sigilo simple‡Sceau simple‡简易符记‡簡易符記',
    nil,
    'Leia o Selo Simples e fale com Alyissia em Umbravale.‡Изучите простой знак и поговорите с Алайссией в Тенистой долине.‡Lest das einfache Siegelzeichen und sprecht mit Alyissia im Laubschattental.‡간결한 도장을 읽어보고 그늘 협곡에 있는 알리시아와 대화하십시오.‡Lee el sigilo simple y habla con Alyissia en Cañada Umbría.‡Habla con Alyissia dentro de Aldrassil, en Cañada Umbría.‡Lire le Sceau simple, et parler à Alyissia, à Sombrevallon.‡阅读简易符记，然后与幽影谷的奥莉希亚谈一谈。‡',
  }
},
[3117] = {
  {
    'O selo cinzelado‡Выгравированный знак‡Geätztes Siegelzeichen‡글이 새겨진 도장‡El sigilo con grabados‡El sigilo con grabados‡Sceau gravé‡风化符记‡風化符記',
    nil,
    'Leia o Selo Cinzelado e fale com Ayanna Perenanda no topo de Aldrassil, em Umbravale.‡Изучите выгравированный знак и поговорите с Аянной Вечнобродкой на верхушке Альдрассила в Тенистой долине.‡Lest das geätzte Siegelzeichen und sprecht mit Ayanna Immerlauf oben auf Aldrassil im Laubschattental.‡글이 새겨진 도장을 읽어보고 그늘 협곡 알드랏실 꼭대기에 있는 아얀나 에버스트라이드와 대화하십시오.‡Lee el sigilo con grabados y habla con Ayanna Semprerguida en Aldrassil, en Cañada Umbría.‡Habla con Ayanna Semprerguida dentro de Aldrassil, en Cañada Umbría.‡Lire le Sceau gravé, et parler à Ayanna Vassanfin, au sommet d\'Aldrassil, dans Sombrevallon.‡阅读风化符记，然后与奥达希尔里和阿亚娜·远途谈一谈。‡閱讀風化符記，然後與幽影谷內奧達希爾頂端的阿亞娜·遠途談話。',
  }
},
[3118] = {
  {
    'O selo cifrado‡Зашифрованный знак‡Verschlüsselte Siegelzeichen‡암호화된 도장‡El sigilo cifrado‡El sigilo cifrado‡Sceau codé‡密文符记‡密文符記',
    nil,
    'Leia o Selo Cifrado e fale com Frahun Umbrurmúrio em Umbravale.‡Прочтите зашифрованный знак и поговорите с Фрагуном Шепотом Тени в Тенистой долине.‡Lest das verschlüsselte Siegelzeichen und sprecht mit Frahun Schattenflüsterer im Laubschattental.‡암호화된 도장을 읽어보고 그늘 협곡에 있는 프라훈 셰이드위스퍼와 대화하십시오.‡Lee el sigilo cifrado y habla con Frahun Sombrusurro en Cañada Umbría.‡Habla con Frahun Sombrusurro dentro de Aldrassil, en Cañada Umbría.‡Lire le Sceau codé et parler à Frahun Murmombre, à Sombrevallon.‡阅读密文符记，然后与幽影谷的弗拉胡恩·影语者谈一谈。‡',
  }
},
[3119] = {
  {
    'O selo sagrado‡Благословенный знак‡Geheiligtes Siegelzeichen‡성스러운 도장‡Sigilo sacralizado‡Sigilo sacralizado‡Sceau béni‡神圣符记‡神聖符記',
    nil,
    'Leia o Selo Sagrado e fale com Shanda em Aldrassil.‡Прочтите благословенный знак и поговорите с Шандой в Альдрассиле.‡Lest das geheiligte Siegel und sprecht mit Shanda in Aldrassil.‡성스러운 도장을 읽어보고 알드랏실에 있는 샨다와 대화하십시오.‡Lee el sigilo sacralizado y habla con Shanda en Aldrassil.‡Habla con Shanda dentro de Aldrassil, en Cañada Umbría.‡Lire le Sceau béni, et parler à Shanda, à Aldrassil.‡阅读神圣符记，然后与奥达希尔的珊达谈一谈。‡',
  }
},
[3120] = {
  {
    'O selo verdejante‡Зеленый знак‡Tiefgrünes Siegelzeichen‡푸른 도장‡El sigilo verdeante‡El sigilo verdeante‡Sceau verdoyant‡绿色符记‡綠色符記',
    nil,
    'Leia o Selo Verdejante e fale com Mardant Carvalhaço na ávore Aldrassil, em Umbravale.‡Прочтите зеленый знак и поговорите с Мардантом Крепким Дубом на древе Альдрассил в Тенистой долине.‡Lest das tiefgrüne Siegel und sprecht mit Mardant Starkeiche im großen Baum Aldrassil im Laubschattental.‡푸른 도장을 읽어보고 그늘 협곡, 알드랏실에 있는 마르단트 스트롱오크와 대화하십시오.‡Lee el sigilo verdeante y habla con Mardant Fuerterroble en Aldrassil, en Cañada Umbría.‡Habla con Mardant Fuerterroble dentro de Aldrassil, en Cañada Umbría.‡Lire le Sceau verdoyant, et parler à Mardant Chênefort, dans l\'arbre Aldrassil de Sombrevallon.‡阅读绿色符记，然后与幽影谷中的奥达希尔顶端的玛丹特·硬木谈一谈。‡閱讀綠色符記，然後與幽影谷中的奧達希爾頂端的瑪丹特·硬木談話。',
  }
},
[3121] = {
  {
    'Um pedido estranho‡Странная просьба‡Eine seltsame Anforderung‡이상한 부탁‡Una extraña petición‡Una extraña petición‡Une Requête étrange‡奇怪的要求‡奇怪的要求',
    nil,
    'Leve a Cabeça Encolhida para Neeru Cortafogo em Orgrimmar.‡Отнесите сушеную голову Нииру Огненному Клинку в Оргриммар.‡Bringt den Schrumpfkopf zu Neeru Feuerklinge in Orgrimmar.‡오그리마에 있는 네루 파이어블레이드에게 구겨진 가면을 가져가야 합니다.‡Lleva la cabeza reducida a Neeru Hojafuego a Orgrimmar.‡Lleva la cabeza reducida a Xerash Hojafuego al Pabellón de Lariss en Feralas.‡Porter la Tête réduite à Neeru Lamefeu à Orgrimmar.‡将皱缩的头颅交给奥格瑞玛的尼尔鲁·火刃。‡將皺縮頭顱交給奧格瑪的尼爾魯·火刃。',
  }
},
[3122] = {
  {
    'Fale novamente com Mandingueiro Uzer\'i.‡Возвращение к знахарю Узер\'и‡Kehrt zu Hexendoktor Uzer\'i zurück‡의술사 우제리에게 돌아가기‡Vuelve con el médico brujo Uzer\'i‡Regresa junto al médico brujo Uzer\'i‡Retourner voir le sorcier-docteur Uzer\'i‡向巫医尤克里回复‡',
    nil,
    'Entregue a Bolsa de Herborismo de Neeru para Mandingueiro Uzer\'i em Feralas.‡Отнесите знахарю Узер\'и в Фералас мешочек для трав Нииру.‡Bringt Neerus Kräuterbeutel zu Hexendoktor Uzer\'i in Feralas.‡페랄라스에 있는 의술사 우제리에게 네루의 약초 주머니를 가져가야 합니다.‡Entrega la faltriquera de hierbas al médico brujo Uzer\'i en Feralas.‡Entrega la faltriquera de hierbas de Xerash al médico brujo Uzer\'i en Feralas.‡Livrer une Poche d\'herbes de Neeru au Sorcier-docteur Uzer\'i, en Féralas.‡将尼尔鲁的草药包送给菲拉斯的巫医尤克里。‡',
  }
},
[3123] = {
  {
    'O teste do recipiente‡Испытание сосуда‡Das Gefäß wird getestet‡단지 실험‡Probar la vasija‡Probar la vasija‡Test du récipient‡测试容器‡測試容器',
    nil,
    'Viaje até as Terras Agrestes e localize os Coruscantes. Mate 10 e use o Recipiente de Muisec para encolher e capturar os Coruscantes abatidos.nnLeve 10 Muisecs de Coruscante e o Recipiente de Muisec para Mandingueiro Uzer\'i em Feralas.‡Отправляйтесь во Внутренние земли, найдите диких совухов, убейте 10 особей и используйте сосуд уменьшения, чтобы уменьшить и пленить павших диких совухов.nnОтнесите 10 уменьшенных диких совухов знахарю Узер\'и в Фералас.‡Reist ins Hinterland und spürt die Wildekin auf. Schaltet 10 davon aus und benutzt dann das Muisekgefäß, um die gefallenen Wildekin zu schrumpfen und einzufangen.nnBringt anschließend 10 Einheiten Muisek von Wildekin und das Muisekgefäß zu Hexendoktor Uzer\'i in Feralas.‡동부 내륙지로 가서 올빼미야수를 찾아 10마리를 처치하고 뮤세크 단지를 사용해 죽은 올빼미야수를 갈무리해서 담아와야 합니다.nn페랄라스에 있는 의술사 우제리에게 올빼미야수 뮤세크 10개와 올빼미야수 뮤세크 단지를 가져가야 합니다.‡Viaja a las Tierras del Interior y localiza a los lechúcicos salvajes. Mata a 10 de ellos y luego utiliza la vasija de muisek para reducir y capturar a los lechúcicos salvajes caídos.nnLleva 10 lechúcicos salvajes muisek y la vasija de muisek al médico brujo Uzer\'i a Feralas.‡Mata a 10 osos Cueracero o corredores Dientelargo y usa la vasija de muisek de bestia para reducir y capturar a las bestias caídas.|nLleva 10 muestras de muisek de bestia y la vasija de muisek de bestia al médico brujo Uzer\'i en Feralas.‡Partez pour les Hinterlands et localisez les Indomptables. Tuez-en 10, puis utilisez le Récipient de muisek pour faire rétrécir et capturer les Indomptables vaincus.nnRamenez 10 Indomptables miniaturisés et le Récipient d\'Indomptables miniaturisés au sorcier-docteur Uzer\'i, en Féralas.‡到辛特兰去杀掉10头枭兽，然后使用灵魂精华容器捕获它们的灵魂。nn将灵魂精华容器和10个枭兽灵魂精华交给菲拉斯的巫医尤克里。‡到辛特蘭去殺掉10頭梟獸，然後使用靈魂精華容器捕獲那些墮落的梟獸。將10個梟獸靈魂精華和靈魂精華容器帶回給菲拉斯的巫醫尤克里。',
  }
},
[3124] = {
  {
    'Muisec de hipogrifo‡Уменьшенный гиппогриф‡Muisek von Hippogryphen‡히포그리프 뮤세크‡Muisek hipogrifo‡Muisek de hipogrifo‡Hippogryphe miniaturisé‡角鹰兽灵魂精华‡角鷹獸靈魂精華',
    nil,
    'Mate 10 Hipogrifos Esfiapluma de qualquer tipo e use o Recipiente de Muisec para encolhê-los e capturá-los.‡Убейте 10 блеклоперых гиппогрифов любого вида, затем используйте сосуд уменьшения, чтобы уменьшить и пленить их.‡Schaltet 10 Fransenfederhippogryphen eines beliebigen Typs aus und benutzt dann das Muisekgefäß, um sie zu schrumpfen und einzufangen.‡종에 상관없이 공작날개 히포그리프 10마리를 처치한 다음 뮤세크 단지를 사용해 갈무리해서 담아와야 합니다.‡ACaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Acaba con 10 hipogrifos Plumavieja de cualquier tipo y utiliza la vasija de muisek para encogerlos y capturarlos.‡Tuer 10 Hippogriffes Aigreplume de n\'importe quel type, puis utiliser le Vaisseau de muisek pour les faire rétrécir et les capturer.‡杀掉10只任意种类的乱羽角鹰兽，然后用灵魂精华容器捕获它们的灵魂。‡',
  }
},
[3125] = {
  {
    'Muisec de Dragoleta‡Уменьшенный лесной дракончик‡Muisek von Feendrachen‡요정용 뮤세크‡Dragones feéricos muisek‡Muisek de dragón feérico‡Dragon féérique miniaturisé‡精灵龙灵魂精华‡精靈龍靈魂精華',
    nil,
    'Mate 8 Dardejantes ou Dragões-íris. Use o Recipiente de Muisec para encolher e capturar as Dragoletas abatidas.‡Убейте 8 летучих хамелеонов или радужных дракончиков. Используйте сосуд уменьшения, чтобы пленить павших лесных дракончиков.‡Schaltet 8 Grimmlingflitzer oder Grimmlingdrachen aus. Benutzt das Muisekgefäß, um die gefallenen Feendrachen zu schrumpfen und einzufangen.‡화살요정용이나 요정용 8마리를 처치하여 뮤세크 단지를 사용해 죽은 요정용을 갈무리해서 담아와야 합니다.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Mata a 8 duendes dardo o duendes dragón. Utiliza la vasija de muisek para reducir y capturar a los dragones feéricos caídos.‡Tuer 8 Fées fléchetteuses ou Petits dragons féeriques. Utiliser le Vaisseau de muisek pour faire rétrécir et capturer les dragons féeriques vaincus.‡杀掉8只精龙或小精龙，然后用灵魂精华容器捕获它们的灵魂。‡',
  }
},
[3126] = {
  {
    'Muisec de Arvoroso‡Уменьшенный древень‡Muisek von Treants‡나무정령 뮤세크‡Antárboles muisek‡Muisek de antárbol‡Tréant miniaturisé‡树人灵魂精华‡樹人靈魂精華',
    nil,
    'Mate 3 Andarilhos Errantes da Floresta. Use o Recipiente de Muisec para encolher e capturar os Arvorosos abatidos.‡Убейте 3 бродячих лесных древней. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших древней.‡Schaltet 3 umherwandernde Waldgänger aus. Benutzt das Muisekgefäß, um die gefallenen Treants zu schrumpfen und einzufangen.‡떠도는 숲정령 3마리를 처치하여 뮤세크 단지를 사용해 죽은 숲정령을 갈무리해서 담아와야 합니다.‡Mata a 3 Caminabosques deambulantes. Utiliza el recipiente de miniatura antárbol para reducir y capturar a los Antárboles caídos.‡Mata a 3 caminabosques deambulantes. Utiliza la vasija de muisek de antárbol para reducir y capturar a los antárboles caídos.‡Tuer 3 Marcheurs des bois errants. Utiliser le Vaisseau de muisek pour faire rétrécir et pour capturer les tréants vaincus.‡杀掉3个森林漫游者，然后用灵魂精华容器捕获它们的灵魂。‡殺掉3個森林漫遊者，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3127] = {
  {
    'Muisec de Gigante da Montanha‡Уменьшенный горный великан‡Muisek von Bergriesen‡산악거인 뮤세크‡Muisek gigante de montaña‡Muisek de gigante montés‡Géant des montagnes miniaturisé‡山岭巨人灵魂精华‡山嶺巨人靈魂精華',
    nil,
    'Mate 7 Terrâmbulos ou Gigantes do Penhasco. Use o Recipiente de Muisec para encolher e capturar os Gigantes da Montanha abatidos.‡Убейте 7 сухопутных бродяг или скальных великанов. Используйте сосуд уменьшения, чтобы уменьшить и пленить павших скальных великанов.‡Schaltet 7 Landgänger oder Klippenriesen aus. Benutzt das Muisekgefäß, um die gefallenen Bergriesen zu schrumpfen und einzufangen.‡평지거인이나 절벽거인 7마리를 처치하여 뮤세크 단지를 이용해 죽은 산악거인을 갈무리해서 담아와야 합니다.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes de montaña caídos.‡Mata a 7 caminantes de la tierra o gigantes del risco. Utiliza la vasija de muisek para reducir y capturar a los gigantes monteses caídos.‡Tuer 7 Marcheurs des terres ou Géants des falaises. Utiliser le Récipient de muisek pour faire rétrécir et pour capturer les Géants des montagnes.‡杀掉7个大地行者或者峭壁巨人，然后用灵魂精华容器捕获它们的灵魂。‡殺掉7個大地行者或者峭壁巨人，然後用靈魂精華容器捕獲它們的靈魂。',
  }
},
[3128] = {
  {
    'Caçadores de matérias-primas perdidas‡Природные материалы‡Natürliche Materialien‡천연 재료‡Materiales naturales‡Materiales naturales‡Matériaux naturels‡天然材料‡天然材料',
    nil,
    'Leve 2 Pedaços de Lenha, 6 Minerais Incrustados, 20 pedaços de Tendão Resiliente e 40 Fragmentos Metálicos para Mandingueiro Uzer\'i na Aldeia Mojache.‡Принесите 2 расколотых бревна, 6 минералов, покрытых коркой, 20 кусков упругих сухожилий и 40 металлических фрагментов знахарю Узер\'и в Лагерь Мохаче.‡Bringt 2 abgesplitterte Baumstämme, 6 verkrustete Mineralien, 20 Stücke widerstandsfähige Sehne und 40 metallische Fragmente zu Hexendoktor Uzer\'i ins Camp Mojache.‡모자케 야영지에 있는 의술사 우제리에게 쪼개진 통나무 2개, 보석 박힌 광석 6개, 질긴 힘줄 20개, 그리고 금속 파편 40개를 가져가야 합니다.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones resistentes y 40 trozos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Lleva 2 troncos astillados, 6 minerales taraceados, 20 tendones resistentes y 40 trozos metálicos al médico brujo Uzer\'i al Campamento Mojache.‡Apporter 2 Bûches fendues, 6 Minerais incrustés, 20 Morceaux de tendons résistants et 40 Fragments métalliques au sorcier-docteur Uzer\'i au Camp Mojache.‡为莫沙彻营地的巫医尤克里收集2根断裂的原木、6颗包壳矿石、20片有弹性的肌腱和40块金属碎片。‡為莫沙徹營地的巫醫尤克里收集2根斷裂的原木、6顆包殼礦石、20片有彈性的肌腱和40塊金屬碎片。',
  }
},
[3129] = {
  {
    'Armas de espírito‡Оружие духа‡Waffen des Geistes‡영혼의 무기‡Armas del espíritu‡Armas del espíritu‡Armes de l\'Esprit‡灵魂武器‡',
    nil,
    'O Mandingueiro Uzer\'i deseja que você aguarde por um instante enquanto ele prepara as armas.‡Подождите, пока знахарь Узер\'и готовит оружие.‡Hexendoktor Uzer\'i will, dass Ihr einen Moment wartet, während er die Waffen vorbereitet.‡의술사 우제리가 무기를 준비하는 동안 잠시 기다려야 합니다.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡El médico brujo Uzer\'i quiere que esperes mientras prepara las armas.‡Le sorcier-docteur Uzer\'i veut que vous patientez pendant qu\'il prépare les armes.‡巫医尤克里希望你在他准备武器的时候稍等一会儿。‡',
  }
},
[3130] = {
  {
    'Cruzada contra as Cristafúrias‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡증오의갈기일족과의 전투‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrête‡憎世纳迦之战‡憎世納迦之戰',
    nil,
    'Apresente-se para Latrônicus Lunalança no Domínio de Plumaluna.‡Явитесь к Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Meldet Euch bei Latronicus Mondspeer in der Mondfederfeste.‡페더문 요새에 있는 라트로니쿠스 문스피어에게 보고해야 합니다.‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Preséntate ante Latronicus Lanzaluna, en el Bastión Plumaluna.‡Se présenter devant Latronicus Lancelune au bastion de Pennelune.‡到羽月要塞的拉托尼库斯·月矛那里去报到。‡到羽月要塞的拉托尼庫斯·月矛那裡去報到。',
  }
},
[3141] = {
  {
    'Loramus‡Лорамус‡Loramus‡로라무스‡Loramus‡Loramus‡Loramus‡洛拉姆斯‡洛拉姆斯',
    nil,
    'Ouça Loramus Talípedes contar sua história.‡Послушайте, как Лорамус Многоног рассказывает свою историю.‡Lasst Loramus Thalipedes seine Geschichte erzählen.‡로라무스 탈리뻬데스의 이야기를 들으십시오.‡Escucha la historia de Loramus Thalipedes.‡Escucha la historia de Loramus Thalimedes.‡Écouter l\'histoire de Loramus Thalipedes.‡听洛拉姆斯·萨里比迪斯讲述他的故事。‡聽洛拉姆斯·薩里比迪斯講述他的故事。',
  }
},
[3161] = {
  {
    'Gahz\'ridian‡Газ\'ридианские украшения‡Gahz\'ridian‡가즈리디안‡Gahz\'rilo‡Gahz\'rilo‡La gahz\'ridienne‡加兹瑞迪安‡加茲瑞迪安',
    nil,
    'Marlon Catarrebite, em Tanaris, quer que você colete 30 Ornamentos de Gahz\'ridian.‡Марвон Клепальщик из Танариса поручил собрать 30 газ\'рилловых украшений.‡Marvon Nietensucher in Tanaris möchte, dass Ihr 30 Ornamente von Gahz\'ridian sammelt.‡타나리스에 있는 마본 리벳시커가 가즈리디안 장신구 30개를 모아 달라고 부탁했습니다.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Buscarroblones de Tanaris quiere que reúnas 30 adornos de gahz\'rilo.‡Marvon Chercherivet à Tanaris veut que vous collectiez 30 Ornements en gahz\'ridienne.‡塔纳利斯的玛尔冯·瑞文斯克要你收集30件加兹瑞迪安饰物。‡塔納利斯的瑪爾馮·瑞文斯克要你收集30件加茲瑞迪安飾物。',
  }
},
[3181] = {
  {
    'O chifre da fera‡Рог чудовища‡Das Horn der Bestie‡야수의 뿔‡El cuerno de la bestia‡El cuerno de la bestia‡La corne de la bête‡玛尔戈的巨角‡巨獸瑪爾戈的角',
    nil,
    'Leve o Chifre Gigante de Margol para a Montanhista Pedrabrita.‡Отнести гигантский рог Маргола горному пехотинцу Щебеночке.‡Bringt Margols gigantisches Horn zu Gebirgsjägerin Feinkiesel.‡산악경비대 페블비티에게 마르골의 거대한 뿔을 가져가야 합니다.‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.|n‡Lleva el cuerno enorme de Margol a la montaraz Guijarro.‡Porter la Corne Gigantesque de Margol à la Montagnarde Minigravillon.‡将玛尔戈的巨角交给巡山人贝波蒂。‡將瑪爾戈的巨角交給巡山人貝波蒂。',
  }
},
[3182] = {
  {
    'Certificado de realização‡Доказательство собственности‡Beweisurkunde‡무훈의 증서‡Certificado de autenticidad‡Certificado de autenticidad‡Titre de propriété‡证明信‡證明文件',
    nil,
    'Leve o Chifre Gigante de Margol para o Curador Tórius em Altaforja.‡Отнесите гигантский рог Маргола куратору Ториусу в Стальгорн.‡Bringt Margols gigantisches Horn zu Kurator Thorius in Eisenschmiede.‡아이언포지에 있는 도서관장 소리우스에게 마르골의 거대한 뿔을 가져가야 합니다.‡Lleva el cuerno enorme de Margol al comisario Thorius a Forjaz.‡Lleva el cuerno enorme de Margol al comisario Torio a Forjaz.‡Porter la Corne gigantesque de Margol au conservateur en chef Thorius à Forgefer.‡把玛尔戈的巨角交给铁炉堡的索里奥斯馆长。‡把瑪爾戈的巨角交給鐵爐堡的索里奧斯館長。',
  }
},
[3201] = {
  {
    'Finalmente!‡Наконец-то!‡Endlich!‡이글거리는 협곡의 열쇠‡¡Al fin!‡¡Al fin!‡Enfin !‡馆长的证明！‡終於!',
    nil,
    'Leve o Certificado de Realização para a Montanhista Pedrabrita.‡Отнесите доказательство содеянного горному пехотинцу Щебеночке.‡Bringt die Beweisurkunde zurück zu Gebirgsjägerin Feinkiesel.‡산악경비대 페블비티에게 무훈의 증서를 가져가야 합니다.‡Lleva el certificado de autenticidad a la montaraz Guijarro.‡Lleva el certificado de autenticidad a la montaraz Guijarro.‡Apporter le document de preuve à la Montagnarde Minigravillon.‡把索里奥斯的证明信交给巡山人贝波蒂。‡把索里奧斯的證明信交給巡山人貝波蒂。',
  }
},
[3221] = {
  {
    'Fale com Renferrel‡Беседа с Ренферрелом‡Sprecht mit Renferrel‡렌퍼럴과 대화‡Habla con Renferrel‡Habla con Renferrel‡Parler à Renferrel‡与伦弗利尔会面‡與倫法洛會面',
    nil,
    'Fale com o Boticário Renferrel no Sepulcro.‡Поговорите с аптекарем Ренферрелом в Гробнице.‡Sprecht mit Apotheker Renferrel in dem Grabmal.‡공동묘지에 있는 연금술사 렌퍼럴과 대화해야 합니다.‡Habla con el boticario Renferrel en El Sepulcro.‡Habla con el boticario Renferrel en El Sepulcro.‡Parler à l\'apothicaire Renferrel au Sépulcre.‡与瑟伯切尔的药剂师伦弗利尔谈一谈。‡與瑟伯切爾的藥劑師倫法洛談話。',
  }
},
[3241] = {
  {
    '‡‡‡‡‡‡‡‡<NYI> <TXT><redux> Dreadmist Peak',
    nil,
    '‡‡‡‡‡‡‡‡把他們帶給圖加·符文圖騰。',
  }
},
[3261] = {
  {
    'Jorn Vidente do Céu‡Джорн Небесный Провидец‡Jorn Himmelsdeuter‡조른 스카이시어‡Jorn Videncielo‡Jorn Vidente del Cielo‡Jorn Skyseer‡乔恩·星眼‡喬恩·星眼',
    nil,
    'Fale com Jorn Vidente do Céu no Acampamento Taurajo.‡Поговорите с Джорном Заклинателем Небес в Лагере Таурахо.‡Sprecht im Camp Taurajo mit Jorn Himmelsdeuter.‡타우라조 야영지에 있는 조른 스카이시어와 대화하십시오.‡Habla con Jorn Videncielo en el Campamento Taurajo.‡Habla con Jorn Vidente del Cielo en el Campamento Taurajo.‡Parler à Jorn Oeil-des-cieux, au Camp Taurajo.‡与陶拉祖营地的乔恩·星眼谈一谈。‡與陶拉祖營地的喬恩·星眼談話。',
  }
},
[3281] = {
  {
    'Prata roubada‡Похищенное серебро‡Gestohlenes Silber‡도둑맞은 은화‡La plata robada‡La plata robada‡Argent volé‡被偷走的银币‡被偷走的銀幣',
    nil,
    'Leve a Prata Roubada para Gazrog na Encruzilhada.‡Принесите украденное серебро Газрогу в Перекресток.‡Bringt das gestohlene Silber zu Gazrog beim Wegekreuz.‡크로스로드에 있는 가즈록에게 도둑맞은 은화를 가져가야 합니다.‡Llévale la plata robada a Gazrog en El Cruce.‡Llévale la plata robada a Gazrog en El Cruce.‡Rapportez l\'Argent volé à Gazrog à la Croisée.‡把被偷走的银币交给十字路口的加兹罗格。‡把被偷走的銀幣交給十字路口的加茲羅格。',
  }
},
[3301] = {
  {
    'Mura Runa Totem‡Муура Рунический Тотем‡Mura Runentotem‡무라 룬토템‡Mura Runatótem‡Mura Runatótem‡Mura Runetotem‡茉拉·符文图腾‡茉拉·符文圖騰',
    nil,
    'Fale com Mura Runa Totem no Sepulcro.‡Поговорите с Муурой Рунический Тотем в Гробнице.‡Sprecht mit Mura Runentotem in dem Grabmal.‡공동묘지에 있는 무라 룬토템과 대화하십시오.‡Habla con Mura Runatótem en El Sepulcro.‡Habla con Mura Runatótem en El Sepulcro.‡Parler à Mura Totem-runique au Sépulcre.‡和瑟伯切尔的茉拉·符文图腾谈一谈。‡和瑟伯切爾的茉拉·符文圖騰談話。',
  }
},
[3321] = {
  {
    'Perdeu alguma coisa?‡Не ее ли ищете?‡Habt Ihr das verloren?‡잃어버린 물건‡¿Has perdido esto?‡¿Has perdido esto?‡Est-ce que ceci est à vous ?‡秘银会的认可‡',
    nil,
    'Espere até que Trenton termine o trabalho.‡Дождитесь, пока Трентон закончит работу.‡Wartet, bis Trenton seine Arbeit erledigt hat.‡트렌튼이 일을 마칠 동안 기다리십시오.‡Espera a que Trenton acabe su trabajo.‡Espera a que Trenton acabe su trabajo.‡Attendre que Trenton ait terminé son travail.‡等待特伦顿完成他的工作。‡',
  }
},
[3341] = {
  {
    'Arauto do fim‡Да сгинет Хладовей‡Das Ende bringen‡암네나르 처치‡Acaba con la amenaza‡Acaba con la amenaza‡L\'anéantissement‡寒冰之王‡寒冰之王',
    nil,
    'André Rosado quer que você mate Amnennar, o Frigífero, e volte com a cabeça dele.‡Эндрю Браунелл поручил вам убить Амненнара Хладовея и принести его череп.‡Andrew Braunell will, dass Ihr Amnennar den Kältebringer tötet und ihm dessen Schädel bringt.‡앤드류 브로넬이 혹한의 암네나르를 처치하고 혹한의 해골을 가져다 달라고 부탁했습니다.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su cráneo.‡Andrew Brownell quiere que mates a Amnennar el Gélido y que le lleves su cráneo.‡Andrew Brownell veut que vous tuiez Amnennar le Porte-froid et que vous lui rameniez son crâne.‡安德鲁·布隆奈尔要你杀了寒冰之王亚门纳尔并将其头骨带回来。‡安德魯·布隆奈爾要你殺了『寒冰使者』亞門納爾並將其頭骨帶回來。',
  }
},
[3361] = {
  {
    'Um dia na vida de um refugiado‡Беда беженца‡Dilemma eines Flüchtlings‡망명자의 곤경‡Las penurias de un refugiado‡Las penurias de un refugiado‡Les malheurs d\'un réfugié‡逃难者的困境‡逃難者的困境',
    nil,
    'Leve a Caixa do Félix, o Baú do Félix e o Balde de Parafusos do Félix para Félix Reclamofuso em Sidermar.‡Принесите в Старую Наковальню ларец Феликса, сундук Феликса и ведро с винтиками и вручите все это Феликсу.‡Bringt Felix Windenbolz in Ambossar den Kasten, die Truhe und den Bolzeneimer von Felix.‡앤빌마에 있는 펠릭스 윈들볼트에게 잃어버린 펠릭스의 상자, 펠릭스의 궤짝, 펠릭스의 나사통을 찾아줘야 합니다.‡Lleva la caja de Félix, el cofre de Félix, y el cubo de tornillos de Félix Rayaullido a Yunquemar.‡Consigue la caja de Félix, el cofre de Félix y el cubo de tornillos de Félix.‡Apporter la Boîte de Felix, le Coffre de Felix et le Seau de boulons de Felix à Felix Chouineboulon, à Courbenclume.‡把菲利克斯的盒子、菲利克斯的箱子和菲利克斯的螺钉桶交给安威玛尔的菲利克斯。‡把菲利克斯的箱子、菲利克斯的箱子和菲利克斯的螺釘桶交給安威瑪的菲利克斯。',
  }
},
[3362] = {
  {
    'Vale Moitagulhas‡Долина Кактусов‡Disteltal‡덤불나무 골짜기‡El Valle Cardizal‡El Valle Cardizal‡La vallée des Chardonniers‡灌木谷‡灌木谷',
    nil,
    'Tran\'rek, em Geringontzan, quer que você mate 8 Moitagulhas Rotos e 8 Fazraízes Moitagulhas.‡Тран\'рек из Прибамбасска просит вас убить 8 бугристых шипошкуров и 8 корнеплетов из долины Кактусов.‡Tran\'rek in Gadgetzan möchte, dass Ihr 8 knorrige Distelwandler und 8 Distelwurzelformer erledigt.‡가젯잔에 있는 트란렉이 옹이진 덤불나무괴물 8마리와 억센뿌리 덤불나무괴물 8마리를 처치해달라고 부탁했습니다.‡Tran\'rek de Gadgetzan quiere que mates a 8 Cardizales nudosos y a 8 enraizadores Cardizales.‡Tran\'rek de Gadgetzan quiere que mates a 8 Cardizales nudosos y a 8 enraizadores Cardizales.‡Tran\'rek, à Gadgetzan, voudrait que vous tuiez 8 Chardonniers noueux et 8 Chardonniers taille-racines.‡加基森的特兰雷克要你杀掉8只长瘤的灌木兽和8只灌木塑根者。‡加基森的特蘭雷克要你殺掉8隻長瘤的灌木獸和8隻灌木塑根者。',
  }
},
[3363] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Blah.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[3364] = {
  {
    'Rabo-de-galo em domicílio‡Жгучая бражка‡Lieferung des kochend heißen Morgengebräus‡뜨거운 새벽주 배달‡Entrega una infusión de albaza hirviendo‡Entrega una infusión de albaza hirviendo‡Une livraison de thé brûlant‡热酒快递‡熱酒快遞',
    nil,
    'Leve um Rabo-de-Galo Escaldante para Durnan Cortapelo em Sidermar em cinco minutos, antes que esfrie!‡Отнесите жгучую бражку в Старую Наковальню и передайте ее Дарнану Мехорезу. Это надо сделать за пять минут, пока бражка не остыла!‡Bringt ein kochend heißes Morgengebräu zu Durnan Pelznaht in Ambossar hinein, bevor es innerhalb von fünf Minuten kalt wird!‡앤빌마의 두르난 퍼커터에게 뜨거운 새벽주를 전해줘야 합니다. 새벽주는 5분이 지나면 식어버리니 그전에 가져가야 합니다.‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Lleva la infusión de albaza hirviendo a Durnan Cortapieles a Yunquemar antes de que se enfríe, ¡tienes 5 minutos!‡Apporter un Thé brûlant à Durnan Coupefourrure, dans Courbenclume, dans les cinq minutes imparties avant qu\'il ne refroidisse !‡在5分钟内把热酒交给安威玛尔的德南·弗卡特。‡在5分鐘內把熱騰騰的熱酒交給安威瑪的德南·弗卡特。',
  }
},
[3365] = {
  {
    'Devolva a caneca‡Возвращение кружки‡Den Becher zurückbringen‡빈 머그잔 가져가기‡Devuelve la jarra‡Devuelve la jarra‡Rapporter la Tasse‡归还酒杯‡歸還酒杯',
    nil,
    'Devolva a Caneca de Nóri para Nóri Fluiorgulho.‡Отнесите кружку хозяину – Нори по прозвищу Гордый Штрек.‡Bringt Nori Stolzmut den Becher zurück.‡노리 프라이드드리프트에게 노리의 머그잔을 가져가야 합니다.‡Devuelve la jarra a Nori Rumborgullo.‡Devuelve la jarra a Nori Rumborgullo, en el Valle de Crestanevada.‡Apporter la Chope de Nori à Nori Fièroblique.‡把诺里斯的杯子还给诺里斯·激流。‡把諾里的杯子還給諾里·激流。',
  }
},
[3366] = {
  {
    'A lasca faiscante‡Светящийся осколок‡Der leuchtende Splitter‡빛나는 조각‡El fragmento resplandeciente‡‡L\'Éclat luminescent‡发光的碎片‡發光的裂片',
    nil,
    'Viaje até a Vila Catraca para descobrir o que há por trás dessa Lasca de Pesadelo.‡Отправляйтесь в Кабестан и выясните, какие секреты скрывает кристалл кошмаров.‡Reist nach Ratschet, um die Bedeutung des Alptraumsplitters herauszufinden.‡톱니항으로 가서 악몽의 조각에 숨겨진 의미를 밝혀내야 합니다.‡Viaja hasta Trinquete para averiguar el significado oculto tras el Fragmento de Pesadilla.‡Viaja hasta Trinquete para averiguar el significado oculto tras el Fragmento de Pesadilla.‡Aller à Cabestan pour trouver la raison d\'être de l\'Éclat de cauchemar.‡寻找更多有关这块噩梦碎片的信息。‡到棘齒城去尋找更多有關這塊夢魘裂片的資訊。',
  }
},
[3367] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntarasteine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡桑塔拉之石',
    nil,
    'Ajude Dório a voltar a Altaforja.‡Помогите Дориусу вернуться в Стальгорн.‡Helft Dorius, zurück nach Eisenschmiede zu kommen.‡도리우스가 아이언포지로 돌아가는 것을 도와야 합니다.‡Ayuda a Dorius a volver a Forjaz.‡Ayuda a Dorius a volver a Forjaz.‡Aider Dorius à retourner à Ironforge.‡帮助杜里奥斯回到铁炉堡。‡幫助杜里奧斯回到鐵爐堡。',
  }
},
[3368] = {
  {
    'Pedras de Suntara‡Камни Сунтары‡Suntarasteine‡선타라 비석‡Piedras de Suntara‡Piedras de Suntara‡Les pierres de Suntara‡苏塔拉之石‡桑塔拉之石',
    nil,
    'Leve a Carta Chamuscada para Tórius em Altaforja. Ele fica no Salão dos Exploradores.‡Доставьте опаленное письмо Ториусу в Стальгорн. Его можно найти в Зале Исследователей.‡Bringt den angesengten Brief zu Thorius in Eisenschmiede. Er befindet sich in der Halle der Forscher.‡아이언포지의 탐험가의 전당에 있는 소리우스에게 그을린 편지를 가져가야 합니다.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Exploradores.‡Lleva la carta chamuscada a Thorius a Forjaz. Está en la Sala de los Expedicionarios.‡Apporter la Lettre roussie à Thorius à Forgefer. Il se trouve dans le Hall des Explorateurs.‡把烧焦的信件交给铁炉堡的索里奥斯，他在探险者大厅里。‡把燒焦的信件交給鐵爐堡的索里奧斯，他在探險者大廳裡。',
  }
},
[3369] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au coeur des cauchemars‡在噩梦中‡',
    nil,
    'Leve a Lasca de Pesadelo para Hamuul Runa Totem no Platô dos Anciãos.‡Принесите осколок кошмара Хамуулу Руническому Тотему на Вершине Старейшин.‡Bringt den Alptraumsplitter zu Hamuul Runentotem auf der Anhöhe der Ältesten.‡장로의 봉우리에 있는 하뮬 룬토템에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Hamuul Runatótem en el Alto de los Ancestros.‡Lleva el Fragmento de Pesadilla a Hamuul Tótem de Runa en el Alto de los Ancestros.‡Apporter l\'Éclat de cauchemar à Hamuul Totem-runique à la Cime des Anciens.‡把噩梦碎片交给长者高地的哈缪尔·符文图腾。‡',
  }
},
[3370] = {
  {
    'Em pesadelos‡Кошмары‡Alptraum‡악몽‡En las pesadillas‡En las pesadillas‡Au coeur des cauchemars‡在噩梦中‡',
    nil,
    'Leve a Lasca de Pesadelo para Mathrengyl Ursivagus em Darnassus.‡Принесите осколок кошмара Матренгилу Медвежьей Лапе в Дарнасс.‡Bringt den Alptraumsplitter zu Mathrengyl Bärenfährte in Darnassus.‡다르나서스에 있는 마스렌길 베어워커에게 악몽의 조각을 가져가야 합니다.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Lleva el Fragmento de Pesadilla a Mathrengyl Garroso de Darnassus.‡Apporter l\'Eclat de cauchemar à Mathrengyl Bearwalker à Darnassus.‡把噩梦碎片交给达纳苏斯的玛斯雷·驭熊者。‡',
  }
},
[3371] = {
  {
    'Justiça enânica‡Правосудие дворфов‡Zwergengerechtigkeit‡드워프식 정의‡La justicia de los enanos‡La justicia de los enanos‡La justice des nains‡矮人的正义‡矮人的正義',
    nil,
    'Volte para a Garganta Abrasadora e encontre a unidade de arqueologia de Dório.‡Вернитесь в Тлеющее ущелье и найдите археологов Дориуса.‡Kehrt zur sengenden Schlucht zurück und sucht Dorius\' Archäologenteam.‡이글거리는 협곡으로 돌아가서 도리우스의 발굴단 고고학자를 찾아야 합니다.‡Vuelve a La Garganta de Fuego y libera al equipo de Dorius.‡Vuelve a La Garganta de Fuego y encuentra a la unidad arqueológica de Dorius.‡Retourner à la Gorge des Vents brûlants et trouver l\'Equipe d\'archéologues de Dorius.‡回到灼热峡谷，找到杜里奥斯的考古队员。‡回去灼熱峽谷，尋找到杜里奧斯的考古隊員。',
  }
},
[3372] = {
  {
    'Liberta os outros‡Отпусти их‡Erlöst sie‡해방‡Libéralos‡Libéralos‡La libération‡释放他们‡釋放他們',
    nil,
    'Encontre o Artefato Misterioso que está protegido pelos Idólatras do Martelo do Crepúsculo no quadrante noroeste da Garganta Abrasadora e leve-o para o Altar de Suntara, no Fosso de Lava.‡Найдите таинственный артефакт, охраняемый идолослужителями Сумеречного Молота в северо-западной области Тлеющего ущелья и возложите его на алтарь Сунтары в Шлаковой Яме.‡Sucht das geheimnisvolle Artefakt, das im nordwestlichen Teil der Sengenden Schlucht von den Götzendienern des Schattenhammerklans bewacht wird, und bringt es zum Altar von Suntara in der Schlackengrube.‡이글거리는 협곡의 북서쪽에 있는 황혼의망치단 우상숭배자들이 보호하고 있는 불가사의한 유물을 찾은 후, 잿가루 채석장에 있는 선타라의 제단으로 가져가야 합니다.‡Encuentra el artefacto misterioso que protegen los idólatras de Martillo Crepuscular en el cuadrante noroeste de La Garganta de Fuego y tráelo al altar de Suntara en la Fosa de la Escoria.|n‡Encuentra el artefacto misterioso que protegen los idólatras de Martillo Crepuscular en el cuadrante noroeste de La Garganta de Fuego y tráelo al altar de Suntara en la Fosa de la Escoria.‡Trouver l\'Artefact mystérieux gardé par les Idolâtres du Marteau du crépuscule dans le quart nord-est de la Gorge des Vents brûlants et ramenez-le à l\'Autel de Suntara dans la Fosse aux scories.‡到北方去找到被暮光之锤守卫着的神秘的古器，然后把它带到熔渣之池的苏塔纳祭坛上。‡找到被暮光之錘信徒守衛著的神秘古器，就在灼熱峽谷的西北邊緣。然後把東西帶到熔渣之池的蘇塔拉祭壇。',
  }
},
[3373] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡Esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Coloque a Essência de Erânicos na Fonte de Essência encontrada neste covil do Templo Submerso.‡Поместите сущность Эраникуса в купель сущности в его логове в затонувшем храме.‡Legt die Essenz von Eranikus in den Essenzborn, der sich in dem Versunkenen Tempel in seinem Unterschlupf befindet.‡가라앉은 사원의 이 안식처에 있는 정수의 샘에 에라니쿠스의 정수를 놓아야 합니다.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Coloca la esencia de Eranikus en la fuente de esencia situada en su guarida del Templo Sumergido.‡Placer l\'Essence d\'Eranikus dans le Réceptacle d\'essence situé dans son antre dans le Temple englouti.‡把伊兰尼库斯精华放在精华之泉里，精华之泉就在沉没的神庙中，伊兰尼库斯的巢穴里。‡把伊蘭尼庫斯精華放在精華之泉裡，精華之泉就在沉沒的神廟中，伊蘭尼庫斯的巢穴裡。',
  }
},
[3374] = {
  {
    'A Essência de Erânicos‡Сущность Эраникуса‡Die Essenz des Eranikus‡에라니쿠스의 정수‡La esencia de Eranikus‡La esencia de Eranikus‡L\'Essence d\'Eranikus‡伊兰尼库斯精华‡伊蘭尼庫斯精華',
    nil,
    'Leve a Pedra do Juramento da Revoada de Ysera e a Essência Acorrentada de Erânicos para Itharius no Pântano das Mágoas. Lá, você decidirá se deseja ajudar a Revoada Dragônica de Ysera ou não.‡Принесите камень Клятвы драконьего выводка Изеры и скованную сущность Эраникуса на Болото Печали. Там вам придется сделать выбор: помогать Драконам Изеры или нет.‡Bringt den Schwurstein von Yseras Drachenschwarm sowie die gebundene Essenz des Eranikus zu Itharius in die Sümpfe des Elends. Dort werdet Ihr Eure Entscheidung treffen, ob Ihr Yseras Drachenschwarm helfen wollt oder nicht.‡슬픔의 늪에 있는 이타리우스에게 이세라 용군단의 서약의 돌과 속박된 에라니쿠스의 정수를 가져가야 합니다. 이세라의 용군단을 도울 것인지 돕지 않을 것인지는 그곳에서 결정하게 됩니다.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Llévale la piedra de juramento del Vuelo de Ysera y la esencia encadenada de Eranikus a Itharius, que está en el Pantano de las Penas. Una vez allí, deberás decidir si quieres ayudar al Vuelo de Ysera o no.‡Apporter la Pierre de voeu des dragons d\'Ysera et l\'Essence d\'Eranikus enchaînée à Itharius au marais des Chagrins. C\'est là que vous choisirez d\'aider ou non les dragons d\'Ysera.‡把伊瑟拉巨龙军团的誓言石和被禁锢的伊兰尼库斯精华交给悲伤沼泽的伊萨里奥斯。在那里你可以决定是否要帮助伊瑟拉的绿龙军团。‡把伊瑟拉巨龍軍團和被禁錮的伊蘭尼庫斯精華帶給悲傷沼澤的伊薩里奧斯。在那裡你可以決定是否要幫助伊瑟拉的綠龍軍團。',
  }
},
[3375] = {
  {
    'Frasco reserva‡Запасной фиал‡Ersatzphiole‡수정점의 유리병 다시 받기‡Otra ampolla‡Otra ampolla‡La fiole de remplacement‡占卜之瓶‡',
    nil,
    'Leve Carvão, Néctar Doce e uma Poção de Mana para Didiê Du Mocó, em Altaforja, para receber um Frasco de Vidência do Didiê.‡Принесите зелье маны, уголь и сладкий нектар Талвашу де Кисселю в Стальгорн. Получите запасной фиал виденья Талваша.‡Bringt einen Manatrank, Kohle und Süßen Nektar zu Talvash del Kissel in Eisenschmiede, um einen Ersatz für Talvashs Wahrsagephiole zu bekommen.‡아이언포지에 있는 탈바쉬 델 키젤에게 마나 물약과 석탄, 달콤한 과즙을 가져다주고 새로운 수정점의 유리병을 얻어야 합니다.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Lleva 1 poción de maná, 1 trozo de carbón y néctar dulce a Talvash del Kissel a Forjaz. Te dará una ampolla de adivinación.‡Apporter une Potion de mana, du Charbon, et du Nectar sucré à Talvash del Kissel à Forgefer pour remplacer la Fiole de divination de Talvash.‡把一瓶法力药水、一块煤和一瓶蜂蜜酒送到铁炉堡的塔瓦斯德·基瑟尔那里，用以换取塔瓦斯德的占卜之瓶。‡',
  }
},
[3376] = {
  {
    'Quebra-presadura!‡Сразить Остроклыка!‡Tötet Spitzhauer!‡족장 뾰족어금니 처치!‡La cabeza de Cornapunta‡La cabeza de Cornapunta‡La fin de Brochaigu !‡刺鬃酋长‡打斷尖牙!',
    nil,
    'Leve a cabeça do Chefe Presadura Mantospinho para a Valente Pena ao Vento na Chapada Nuvem Vermelha.‡Принесите голову вождя Остроклыка Терновой Мантии Храбрецу Перу Ветра на плато Красного Облака.‡Bringt den Kopf von Häuptling Spitzhauer Dornenmantel zu Kriegerheldin Windfeder auf der Hochwolkenebene.‡족장 뾰족어금니를 처치한 후 그 증거로 그의 머리카락을 붉은구름 고원에 있는 용사 윈드페더에게 가져가야 합니다.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Ventopluma en Mesa de la Nube Roja.‡Lleva la cabeza del Jefe Cornapunta Mantospina a la Valiente Pluma de Viento en Mesa de la Nube Roja.‡Apporter la Tête du chef Brochaigu Mantépine à Brave Plume-des-vents à la mesa de Nuage rouge.‡把刺鬃酋长的头颅交给红云台地的卫兵维萨罗·风羽。‡把尖牙刺鬃酋長的頭顱交給紅雲台地的衛兵維薩羅·風羽。',
  }
},
[3377] = {
  {
    'Oração a Eluna‡Молитва Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡El Rezo a Elune‡El rezo a Elune‡Prière à Elune‡艾露恩祷言‡伊露恩祈禱文',
    nil,
    'Ouça a história de Zamael.‡Выслушайте Зимаэля.‡Hört Zamaels Geschichte.‡잠마엘이 하는 이야기를 들으십시오.‡Escucha a Zamael.‡Escucha a Zamael.‡Écouter le récit de Zamael.‡听萨麦尔讲述他的故事。‡聽薩麥爾講述他的故事。',
  }
},
[3378] = {
  {
    'Oração a Eluna‡Молитва Элуне‡Gebet an Elune‡엘룬께 올리는 기도문‡El rezo a Elune‡El rezo a Elune‡Prière à Elune‡艾露恩祷言‡伊露恩祈禱文',
    nil,
    'Encontre a Oração a Eluna e leve-a para Astarii Mirestela em Darnassus.‡Найдите молитву Элуне и принесите ее Астарии Ловцу Звезд в Дарнасс.‡Findet das Gebet an Elune und bringt es zu Astarii Sternsucher in Darnassus.‡엘룬께 올리는 기도문을 찾아 다르나서스에 있는 아스타리 스타시커에게 가져가야 합니다.‡Lleva el rezo a Elune a Astarii Buscaestelar a Darnassus.|n‡Lleva el rezo a Elune a Astarii Buscaestelar a Darnassus.‡Trouver la Prière à Elune et l\'apporter à Astarii Cherchétoile à Darnassus.‡找到艾露恩祷言，然后将其交给达纳苏斯的阿斯塔利·逐星。‡找到伊露恩祈禱文，然後交給達納蘇斯的阿斯塔利·逐星者。',
  }
},
[3379] = {
  {
    'Tecessombras‡Мастер по тенеткани‡Schattenweber‡그림자매듭‡Las tejedoras de sombra‡Las tejedoras de sombra‡Les tisseuses d\'ombre‡暗影蛛丝‡暗影蛛絲',
    nil,
    'Mate os Larápios de Seda Sombria que rondam a Garganta Abrasadora. Nilith acredita que cinco deles precisam ser exterminados. Fale com Nilith novamente na Garganta Abrasadora quando tiver cumprido essa tarefa.‡Убейте банду похитителей тенешелка, хозяйничающую в Тлеющем ущелье. Нилит полагает, что их пятеро. Вернитесь к Нилит по выполнению задания.‡Tötet die Gruppe der Schattenseidewilderer, die in der sengenden Schlucht umherstreifen. Nilith hat Grund zu der Annahme, dass es fünf von ihnen gibt, die ausgeschaltet werden müssen.‡이글거리는 협곡을 돌아다니는 그늘거미 밀렵꾼을 처치해야 합니다. 닐리스는 다섯 명 정도는 처치해야 한다고 생각하고 있습니다. 임무를 완수하면 이글거리는 협곡에 있는 닐리스에게 돌아가십시오.‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.|n‡Mata a los furtivos Sedaumbría de La Garganta de Fuego. Nilith cree que son 5. Ve a ver a Nilith en La Garganta de Fuego cuando hayas terminado.‡Tuer le groupe de braconniers Ombresoie qui rôde dans la gorge des Vents brûlants. Nilith a de bonnes raisons de croire qu\'ils doivent être exterminés tous les cinq. Retourner voir Nilith dans la gorge des Vents brûlants lorsque vous aurez terminé.‡杀死在灼热峡谷游荡的暗影蛛丝偷猎者小队。尼莉丝认为他们共有5名成员，你的任务就是把他们全都干掉。‡殺死在灼熱峽谷遊蕩的暗影蛛絲偷獵者小隊。尼莉絲認為他們共有5名成員，你的任務就是把他們全都幹掉。',
  }
},
[3380] = {
  {
    'O Templo Submerso‡Затонувший храм‡Der Versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沉沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Nietensucher in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Chercherivet à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯找到瑪爾馮·瑞文斯克。',
  }
},
[3381] = {
  {
    'Para encontrar um mestre‡Встреча с господином‡Ein Treffen mit dem Meister‡사나스의 스승‡Un encuentro con el maestro‡‡Une rencontre avec le maître‡会见主人‡會見主人',
    nil,
    'Leve 2 Penas Intactas de Hipogrifo para Sanath Lim-yo em Azshara, se quiser falar com o mestre dele.‡Принесите 2 неповрежденных пера гиппогрифа Санату Лим-Йо в в Азшару, если хотите говорить с его господином.‡Bringt 2 unbeschädigte Hippogryphenfedern zu Sanath Lim-yo in Azshara, wenn Ihr mit seinem Meister sprechen wollt.‡사나스 림요의 주인과 대화하려면 아즈샤라에 있는 사나스 림요에게 온전한 히포그리프 깃털 2개를 가져가야 합니다.‡Llévale 2 plumas de hipogrifo intactas a Sanath Lim-yo en Azshara si deseas hablar con su maestro.‡Llévale 2 plumas de hipogrifo intactas a Sanath Lim-yo en Azshara si deseas hablar con su maestro.‡Apporter 2 Plumes d\'hippogriffe sans défaut à Sanath Lim-yo, en Azshara, si vous souhaitez parler à son maître.‡如果你想要见到萨纳斯的主人，就把2根完好无损的角鹰兽羽毛交给他。‡如果你想要見到薩納斯的主人，就把2根完好無損的角鷹獸羽毛交給他。',
  }
},
[3382] = {
  {
    'Sob fogo cerrado‡На абордаж!‡Eine Mannschaft in Bedrängnis‡위험에 처한 선원‡Un equipo bajo el fuego enemigo‡Un equipo bajo el fuego enemigo‡Doux whisky‡危难中的船长‡危難中的船長',
    nil,
    'Defenda a Capitão Vanessa Beltis, sua tripulação e os passageiros do Batedor do Horizonte do ataque das nagas. A Capitão Vanessa Beltis deve sobreviver.‡Защитите капитана Ванессу Белтис, ее команду и пассажиров "Покорителя Горизонтов" от нападения наг. Капитан Ванесса Белтис должна выжить.‡Verteidigt Kapitän Vanessa Beltis, ihre Mannschaft und die Passagiere der Herrin des Horizonts gegen den Angriff der Naga. Kapitän Vanessa Beltis muss überleben.‡선장 바네사 벨티스와 그녀의 선원들, 그리고 지평선 정찰함의 승객들을 나가의 공격으로부터 보호해야 합니다. 적어도 선장 바네사 벨티스는 반드시 살아남아야 합니다.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Defiende a la capitana Vanessa Beltis, su tripulación y los pasajeros del Explorador del horizonte frente al ataque de los nagas. La capitana Vanessa Beltis tiene que sobrevivir.‡Défendre la capitaine Vanessa Beltis, son équipage et les passagers de "l\'Horizon" contre l\'attaque des nagas. La capitaine Vanessa Beltis doit survivre.‡帮助瓦妮莎·贝蒂斯船长、她的船员和地平线轻帆号上的乘客抵御纳迦的攻击。瓦妮莎·贝蒂斯船长必须存活。‡幫助瓦妮莎·貝蒂斯船長、她的船員和地平線輕帆號上的乘客抵禦納迦的攻擊。瓦妮莎·貝蒂斯船長必須存活。',
  }
},
[3385] = {
  {
    'O Submercado‡Черный рынок‡Der Untermarkt‡암거래상단‡El Mercado Negro‡El Mercado Negro‡Le Sous-marché‡黑市交易‡黑市交易',
    nil,
    'Mate o Mestre Mercador Kovic e seu lacaio Clanque. Pegue a Algibeira do Comerciante do corpo dele e leve-a para Nilith.‡Убейте торговца Ковица и его прихвостня Лязгуна. Снимите с тела сумку и вернитесь к Нилит.‡Erschlagt Handelsmeister Kovic und seinen Diener Clunk. Nehmt den Händlerranzen von seinem Leichnam und bringt ihn zu Nilith.‡대상 코빅과 그의 부하 딸깍이를 처치하고 그 시체에서 대상의 가방을 회수하여 닐리스에게 가져가야 합니다.‡Mata al maestro de comercio Kovic y a su esbirro, Clonk. Lleva su cartera a Nilith.|n‡Mata al maestro de comercio Kovic y a su esbirro, Clonk. Lleva su cartera a Nilith.‡Tuer le Maître d\'artisanat Kovic et son agent Clonk. Récupérer sur son corps la Sacoche du marchand et l\'apporter à Nilith.‡杀了贸易首领考维克和他的同伙科朗克。从他的尸体上拿回商人的背包，把它交给尼莉丝。‡殺了貿易首領考維克和他的同夥科朗克。從他的屍體上拿回商人的背包，把它交給尼莉絲。',
  }
},
[3402] = {
  {
    'O submercado‡Черный рынок‡Der Untermarkt‡암거래상단‡El Mercado Negro‡El Mercado Negro‡Le Sous-marché‡黑市交易‡黑市交易',
    nil,
    'Fale com Linhagulha em Geringontzan.‡Поговорите с Визгликом в Прибамбасске.‡Sprecht mit Vizzklick in Gadgetzan.‡가젯잔에 있는 비즈클릭과 대화해야 합니다.‡Habla con Vizzklick en Gadgetzan.|n‡Habla con Vizzklick en Gadgetzan.‡Parler à Vizzklick à Gadgetzan.‡和加基森的维兹格里克谈一谈。‡和加基森的維茲格里克談話。',
  }
},
[3421] = {
  {
    'A viagem de volta‡Возвращение‡Rückreise‡귀환‡El viaje de vuelta‡El viaje de vuelta‡Le voyage de retour‡回程‡回程',
    nil,
    'Vou levá-lo de volta ao acampamento de Sanath agora.nnNão repare nos modos ruins dele. Ele é rude com todo mundo exceto o mestre. Talvez ele aprenda a lição algum dia.‡Теперь я отправлю тебя назад к лагерю Саната. nnНе обращай внимание на его манеры – он груб со всеми, кроме собственного господина. Возможно, однажды его заносчивость сыграет с ним злую шутку.‡Ich werde Euch jetzt zu Sanaths Lager zurückbringen.nnMacht Euch nichts aus seinen schlechten Manieren - er ist zu allen unhöflich, außer zum Meister. Vielleicht wird er seine Lektion eines Tages lernen.‡지금 사나스의 야영지로 보내 드리겠습니다.nn녀석의 버르장머리 없는 태도는 신경 쓰실 것 없습니다. 저희 주인님을 제외하고는 누구한테든 그렇게 버릇없이 구니까요. 사나스도 언젠가는 철이 들겠지요.‡Te haré volver al campamento de Sanath ahora. nnNo hagas caso de su mala educación, es así con todos a excepción del maestro. Quizás algún día le den una lección.‡‡Je vais vous renvoyer au camp de Sanath à présent.nnNe faites pas attention à ses mauvaises manières. Il est brusque envers tout le monde, sauf envers le maître. Peut-être apprendra-t-il la leçon un jour ?‡‡',
  }
},
[3441] = {
  {
    'Castigo divino‡Божественное воздаяние‡Göttliche Vergeltung‡성스러운 복수‡Castigo divino‡Castigo divino‡Châtiment divin‡神圣的惩戒‡神聖的懲戒',
    nil,
    'Ouça Kalaran Finalâmina contar a história dele.‡Выслушайте Каларана Ветрореза.‡Lasst Kalaran Windklinge seine Geschichte erzählen.‡칼라란 윈드블레이드가 하는 이야기를 들으십시오.‡Escucha a Kalaran Espada del Viento.‡Escucha a Kalaran Espada del Viento.‡Écouter le récit de Kalaran Lamevent.‡听卡拉然·温布雷讲述他的故事。‡聽卡拉然·溫布雷講述他的故事。',
  }
},
[3442] = {
  {
    'A chama perfeita‡Неугасимое пламя‡Die fehlerlose Flamme‡완전무결한 불꽃‡La llama pura‡La llama pura‡La flamme parfaite‡无瑕之焰‡無瑕之焰',
    nil,
    'Colete 4 Corações das Chamas e 4 globos de Óleo de Golem, e leve-os para Kalaran Finalâmina.‡Принести 4 сердца пламени и 4 меры масла големов Каларану Ветрорезу.‡Sammelt 4 Herzen der Flamme und 4 Kugeln Golemöl und bringt die Gegenstände zu Kalaran Windklinge.‡화염의 심장 4개와 골렘 기름 4개를 모아 칼라란 윈드블레이드에게 가져가야 합니다.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Kalaran Espada del Viento.‡Lleva 4 corazones de llama y 4 globos de aceite gólem a Kalaran Espada del Viento.‡Réunir 4 Cœurs des flammes et 4 globes d\'Huile de golem puis rapporter ces objets à Kalaran Lamevent.‡收集4份烈焰之心和4份傀儡之油，然后把这些东西交给卡拉然·温布雷。‡收集4份烈焰之心和4份魔像之油，然後把這些東西交給卡拉然·溫布雷。',
  }
},
[3443] = {
  {
    'Forjando o bastão‡Древко факела‡Das Schmieden des Schafts‡횃불 자루 만들기‡Forjar el mango‡Forjar el mango‡Forger le manche‡铸造火炬杆‡鑄造火炬桿',
    nil,
    'Leve 8 Punhais de Placas de Tório para Kalaran Finalâmina.‡Принесите 8 окованных торием кинжалов Каларану Ветрорезу.‡Bringt 8 mit Thorium beschichtete Dolche zu Kalaran Windklinge.‡칼라란 윈드블레이드에게 토륨 도금 단검 8개를 가져가야 합니다.‡Lleva 8 dagas bañadas en torio a Kalaran Espada del Viento.‡Lleva 8 dagas bañadas en torio a Kalaran Espada del Viento.‡Apporter 8 Dagues plaquées en thorium à Kalaran Lamevent.‡给卡拉然带去8把瑟银匕首。‡帶8把瑟銀匕首給卡拉然·風刃。',
  }
},
[3444] = {
  {
    'O círculo de pedra‡Круглый камень‡Der Steinreif‡돌무리‡El círculo de piedra‡El círculo de piedra‡Le Cercle de pierres‡石环‡石環',
    nil,
    'Busque o Círculo de Pedra na oficina de Marlon Catarrebite em Vila Catraca.‡Заберите круглый камень из мастерской Марвона Клепальщика в Кабестане.‡Holt den Steinreif aus Marvon Nietensuchers Werkstatt in Ratschet.‡톱니항에 있는 마본 리벳시커의 작업장에서 마본의 궤짝에 담긴 아탈라이 돌무리를 회수해야 합니다.‡Recupera el círculo de piedra del taller de Marvon Buscarroblones, en Trinquete.‡Recupera el círculo de piedra del taller de Marvon Buscarroblones, en Trinquete.‡Récupérer le Cercle de pierres à l\'Atelier de Marvon Chercherivet à Cabestan.‡到棘齿城去，从玛尔冯·瑞文斯克的车间里取回石环。‡到棘齒城去，從瑪爾馮·瑞文斯克的車間裡取回石環。',
  }
},
[3445] = {
  {
    'O Templo Submerso‡Затонувший храм‡Der Versunkene Tempel‡가라앉은 사원‡El Templo Sumergido‡El Templo Sumergido‡Le Temple englouti‡沉没的神庙‡沉沒的神廟',
    nil,
    'Encontre Marlon Catarrebite em Tanaris.‡Найдите Марвона Клепальщика в Танарисе.‡Sucht Marvon Nietensucher in Tanaris.‡타나리스에서 마본 리벳시커를 찾아야 합니다.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Encuentra a Marvon Buscarroblones en Tanaris.‡Trouver Marvon Chercherivet à Tanaris.‡到塔纳利斯找到玛尔冯·瑞文斯克。‡到塔納利斯尋找瑪爾馮·瑞文斯克。',
  }
},
[3446] = {
  {
    'Nas profundezas‡Во глубине болот‡In die Tiefen‡심연의 늪‡En las profundidades‡En las profundidades‡Dans les profondeurs‡深入神庙‡深入神廟',
    nil,
    'Encontre o Altar de Hakkar no Templo Submerso, que fica no Pântano das Mágoas.‡Найдите алтарь Хаккара в затонувшем храме на Болоте Печали.‡Sucht den Altar von Hakkar im Versunkenen Tempel in den Sümpfen des Elends.‡슬픔의 늪에 있는 가라앉은 사원에서 학카르 제단을 찾아야 합니다.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Encuentra el Altar de Hakkar en el Templo Sumergido, en el Pantano de las Penas.‡Trouver l\'Autel d\'Hakkar dans le Temple englouti du marais des Chagrins.‡在悲伤沼泽沉没的神庙中找到哈卡祭坛。‡在悲傷沼澤的沉沒神廟中找到哈卡祭壇。',
  }
},
[3447] = {
  {
    'Segredo do círculo‡Тайна камня‡Das Geheimnis des Kreises‡돌무리의 비밀‡El secreto del círculo‡El secreto del círculo‡Le secret du cercle‡雕像群的秘密‡雕像群的秘密',
    nil,
    'Entre no Templo Submerso e descubra o segredo escondido no círculo de estátuas.‡Отправляйтесь в затонувший храм и узнайте, что скрывается в круге статуй.‡Reist zum Versunkenen Tempel und enthüllt das Geheimnis, das sich in dem Kreis der Statuen verbirgt.‡가라앉은 사원으로 가서 원 모양으로 서 있는 석상들에 감춰진 비밀을 알아내야 합니다.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Ve al Templo Sumergido y descubre el secreto oculto en el círculo de estatuas.‡Voyager jusqu\'au Temple englouti et découvrir le secret du cercle de statues.‡到沉没的神庙去，揭开雕像群中隐藏的秘密。‡去沉沒的神廟，找出雕像群中隱藏的秘密。',
  }
},
[3448] = {
  {
    'Passando o fardo‡Передача поручения‡Die Bürde weitergeben‡티모르의 협조‡Encargarse de la investigación‡Encargarse de la investigación‡La transmission du fardeau‡委以重任‡委以重任',
    nil,
    'Fale com Timor em Altaforja.‡Поговорите с Тимором в Стальгорне.‡Sprecht mit Magier Tymor in Eisenschmiede.‡아이언포지에 있는 티모르와 대화하십시오.‡Habla con Tymor en Forjaz.‡Habla con Tymor en Forjaz.‡Parler au mage Tymor à Forgefer.‡跟铁炉堡的泰摩尔谈一谈。‡跟鐵爐堡的泰摩爾談話。',
  }
},
[3449] = {
  {
    'Runas arcanas‡Чародейские руны‡Arkane Runen‡비전 룬‡Runas Arcanas‡Runas Arcanas‡Les runes des arcanes‡奥术符文‡秘法符文',
    nil,
    'Usando o Kit de Desenho, faça decalques da Runa de Beth\'Amara, da Runa de Jin\'yael, da Runa de Markri e da Runa de Sael\'hai antes de ir para a pequena ilha ao largo da península meridional de Azshara e sinalizar para o Piloto Xisto Acendefase buscá-los.‡При помощи готовальни сделайте прорисовки руны Бет\'Амары, руны Джин\'йаэль, руны Маркри и руны Саэл\'Хаи. Отправляйтесь на маленький островок близ южного полуострова Азшары и дайте сигнал пилоту Хиггсу Зажигателю забрать их.‡Verwendet das Abschriftenset, um Abpausbilder von der Rune von Beth\'Amara, der Rune von Jin\'yael, der Rune von Markri und der Rune von Sael\'hai herzustellen, bevor Ihr Euch zu der kleinen Insel vor der südlichen Halbinsel von Azshara aufmacht und dem Piloten Xiggs Luntenzünder signalisiert, dass er sie abholen kann.‡탁본 도구를 사용해 베스아마라 룬, 진야엘 룬, 마크리 룬, 그리고 샤엘하이 룬의 탁본을 만든 후, 아즈샤라의 남부 반도에서 조금 떨어진 작은 섬으로 가서 신호를 보내 조종사 시그스 퓨즈라이터가 가지러 오도록 하십시오.‡Haz calcos de la Runa de Beth\'Amara, la Runa de Jin\'yael, la Runa de Markri y la Runa de Sael\'hai. Luego ve a la isla frente a la península meridional de Azshara y avisa al piloto Xiggs Luzfusil para que recoja los calcos.‡Haz calcos de la Runa de Beth\'Amara, la Runa de Jin\'yael, la Runa de Markri y la Runa de Sael\'hai. Luego ve a la isla frente a la península meridional de Azshara y avisa al piloto Xiggs Botafuego para que recoja los calcos.‡À l\'aide de la Trousse de dessin, effectuer des reproductions de la Rune de Beth\'Amara, de la Rune de Jin\'yael, de la Rune de Markri, de la Rune de Sael\'hai, puis se diriger vers la petite île près de la Péninsule méridionale d\'Azshara et signaler au Pilote Xiggs Allumèche de venir les prendre.‡使用绘图工具包获取贝萨玛拉符文、辛耶尔符文、玛科里符文和塞尔哈符文的拓片，然后前往艾萨拉南部半岛外的小岛，把它们交给驾驶员西格斯·熔光。‡在前往艾薩拉南部半島處的小島之前，使用繪圖工具獲取貝薩瑪拉符文、辛耶爾符文、瑪寇里符文和塞爾哈符文的拓片，然後通知駕駛員希格斯·熔火去拾取這些拓片。',
  }
},
[3450] = {
  {
    'Uma coleta tranquila‡Легкая доставка‡Eine einfache Ladung‡간편한 배달 방법‡Un simple envío‡Un simple envío‡Une collecte facile‡简单的接收任务‡簡單的接收任務',
    nil,
    'Fale com Xisto Acendefase em Altaforja.‡Поговорите с Хиггсом Зажигателем в Стальгорне.‡Sprecht mit Xiggs Luntenzünder in Eisenschmiede.‡아이언포지에 있는 시그스 퓨즈라이터와 대화하십시오.‡Habla con Xiggs Luzfusil en Forjaz.‡Habla con Xiggs Botafuego en Forjaz.‡Parler à Xiggs Allumèche à Forgefer.‡与铁炉堡的希格斯·熔火谈一谈。‡與鐵爐堡的希格斯·熔火談話。',
  }
},
[3451] = {
  {
    'Me chama que eu vou!‡Сигнал "Взять на борт!"‡Signal zum Abholen‡배달 신호‡Una señal para el envío‡Una señal para el envío‡Signal de la récupération‡信号发射器‡信號發射器',
    nil,
    'Fale com Xisto Acendefase e consiga uma Pistola Sinalizadora Modelo Padrão com ele em Altaforja.‡Поговорите с Хиггсом Зажигателем в Стальгорне и получите от него сигнальное ружье.‡Sprecht mit Xiggs Luntenzünder in Eisenschmiede und erhaltet von ihm eine Standardleuchtpistole.‡아이언포지에서 시그스 퓨즈라이터와 대화하고 그에게 기본지급품 신호탄을 받아야 합니다.‡Habla con Xiggs Luzfusil para que te dé una pistola de bengalas en Forjaz.‡Habla con Xiggs Botafuego para que te dé una pistola de bengalas en Forjaz.‡Parler à Xiggs Allumèche à Forgefer et en obtenir un Lance-fusée standard.‡与铁炉堡的希格斯·熔火谈一谈，从他那儿获得一支标准型闪光信号枪。‡與鐵爐堡的希格斯·熔火談話，從他那獲得一支標準型信號槍。',
  }
},
[3452] = {
  {
    'O invólucro da chama‡Защита пламени‡Die Ummantelung der Flamme‡불꽃의 테두리‡El soporte para la llama‡El soporte para la llama‡L\'enveloppe de la flamme‡烈焰之盒‡烈焰之盒',
    nil,
    'Encontre e leve um Símbolo de Ragnaros para Kalaran Finalâmina.‡Найдите знак Рагнароса и принесите его Каларану Ветрорезу.‡Bringt ein Symbol von Ragnaros zu Kalaran Windklinge.‡칼라란 윈드블레이드에게 라그나로스의 상징 1개를 찾아 가져가야 합니다.‡Lleva un Símbolo de Ragnaros a Kalaran Espada del Viento.‡Lleva un Símbolo de Ragnaros a Kalaran Espada del Viento.‡Trouver et apporter un Symbole de Ragnaros à Kalaran Lamevent.‡找到一个拉格纳罗斯符记，把它交给卡拉然·温布雷。‡找到一個拉格納羅斯符記，把它交給卡拉然·溫布雷。',
  }
},
[3453] = {
  {
    'A Tocha da Retribuição‡Факел воздаяния‡Die Fackel der Vergeltung‡응보의 횃불‡La antorcha de reprensión‡La antorcha de reprensión‡La Torche de vindicte‡惩戒火炬‡懲戒火炬',
    nil,
    'Espere enquanto Kalaran Finalâmina termina de preparar a Tocha da Retribuição.‡Подождите, пока Каларан Ветрорез закончит факел воздаяния.‡Wartet bis Kalaran Windklinge die Fackel der Vergeltung vollendet hat.‡칼라란 윈드블레이드가 응보의 횃불을 완성할 동안 기다려야 합니다.‡Espera a que Kalaran Espada del Viento termine la antorcha de reprensión.|n‡Espera a que Kalaran Espada del Viento termine la antorcha de reprensión.‡Attendre que Kalaran Lamevent termine la Torche de vindicte.‡等待卡拉然·温布雷完成惩戒火炬。‡等待卡拉然·溫布雷完成懲戒火炬。',
  }
},
[3454] = {
  {
    'A Tocha da Retribuição‡Факел воздаяния‡Die Fackel der Vergeltung‡응보의 횃불‡La antorcha de reprensión‡La antorcha de reprensión‡La Torche de vindicte‡惩戒火炬‡懲戒火炬',
    nil,
    'Pegue a Tocha da Retribuição.‡Возьмите факел воздаяния.‡Nehmt die Fackel der Vergeltung.‡응보의 횃불을 집어 드십시오.‡Coge la antorcha de reprensión.‡Coge la antorcha de reprensión.‡Prendre la Torche de vindicte.‡拿起惩戒火炬。‡拿起懲戒火炬。',
  }
},
[3461] = {
  {
    'Fale novamente com Timor‡Возвращение к Тимору‡Rückkehr zu Magier Tymor‡티모르에게 돌아가기‡Vuelve con Tymor‡Regresa junto a Tymor‡Le retour vers Tymor‡向法师泰摩尔回复‡向法師泰摩爾回覆',
    nil,
    'Devolva o Kit de Desenho de Timor a ele em Altaforja.‡Принесите Тимору его готовальню назад в Стальгорн.‡Bringt Magier Tymors Abschriftenset zu ihm zurück nach Eisenschmiede.‡아이언포지에 있는 티모르에게 탁본 도구를 돌려주어야 합니다.‡Devuelve el juego de calco a Tymor, que está en Forjaz.‡Devuelve el juego de calco a Tymor, que está en Forjaz.‡Rapporter la Trousse de dessin du mage Tymor au mage Tymor, à Forgefer.‡到铁炉堡去，将法师泰摩尔的绘图工具包还给他。‡到鐵爐堡去，將法師泰摩爾的繪圖工具包還給他。',
  }
},
[3462] = {
  {
    'Escudeiro Maltraque‡Оруженосец Малтрейк‡Knappe Malzdarr‡견습기사 몰트레이크‡Escudero Maltrake‡Escudero Maltrake‡L\'écuyer Maltrake‡侍卫玛特拉克‡侍衛瑪特拉克',
    nil,
    'Fale com o Escudeiro Maltraque.‡Поговорите с оруженосцем Малтрейком.‡Sprecht mit dem Knappen Malzdarr.‡수습기사 몰트레이크와 대화해야 합니다.‡Habla con mi enviado, el escudero Maltrake.‡Habla con mi enviado, el escudero Maltrake.‡Parler à l\'écuyer Maltrake.‡与侍卫玛特拉克谈一谈。‡與侍衛瑪特拉克談話。',
  }
},
[3463] = {
  {
    'Taca fogo neles!‡Задай им жару!‡Setzt sie in Brand!‡불 공격!‡¡Préndelas fuego!‡¡Préndeles fuego!‡Allumer le feu !‡烧掉它们！‡燒掉它們!',
    nil,
    'Incendeie as Torres de Sentinela Norte, Sul, Leste e Oeste usando a Tocha da Retribuição dentro de cada prédio.‡Подожгите северную, южную, восточную и западную сторожевые башни с помощью факела воздаяния.‡Steckt die Wachpostentürme im Norden, Süden, Osten und Westen in Brand, indem Ihr die Fackel der Vergeltung innerhalb der einzelnen Gebäude benutzt.‡북쪽, 남쪽, 동쪽과 서쪽 감시탑 내부에서 응보의 횃불을 사용해 불을 지르십시오.‡Entra en las 4 torres del centinela e incéndialas con la antorcha de reprensión.|n‡Entra en las 4 torres del centinela e incéndialas con la antorcha de reprensión.‡Mettre le feu aux Tours de garde nord, sud, est et ouest en utilisant la Torche de vindicte à l\'intérieur de chaque tour.‡使用惩戒火炬点燃北部、南部、东部和西部的哨塔。‡使用懲戒火炬點燃北部、南部、東部和西部的哨塔。',
  }
},
[3481] = {
  {
    'Berloques...‡Безделушки...‡Plunder...‡만물 상자...‡Abalorios...‡Abalorios...‡Bibelots...‡打开箱子...‡打開箱子…',
    nil,
    'Abra o baú.‡Открыть сундук.‡Öffnet die Truhe.‡궤짝을 여십시오.‡Abre el cofre.‡Abre el cofre.‡Ouvrir le coffre.‡打开箱子。‡打開箱子。',
  }
},
[3482] = {
  {
    '<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> La caja negra con agujeros‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box‡<NYI> <TXT> The Pocked Black Box',
    nil,
    'Leve essa caixa para Kravel.‡Отнесите ящик Крейвелу.‡Bringt diesen Flugschreiber zu Kravel.‡Take this box to Kravel.‡Llévale esta caja a Kravel.‡Llévale esta caja a Kravel.‡Porter la boîte à Kravel.‡[Take this box to Kravel.]‡把這個箱子交給克拉維爾。',
  }
},
[3483] = {
  {
    'Me chama que eu vou!‡Сигнал "Взять на борт!"‡Signal zum Abholen‡배달 신호‡Una señal para el envío‡Una señal para el envío‡Signal de la récupération‡信号发射器‡信號發射器',
    nil,
    'Ah, outro sinalizador, é? Isso eu sei fazer.nnE não se esqueça: na ponta sul de Azshara. É uma ilhotinha que foi transformada em plataforma de pouso. Não dá para não ver se você estiver no lugar certo.‡Еще одно сигнальное ружье, да? Это можно.nnИ не забудьте – южная оконечность Азшары. Этот крохотный островок переделан в посадочную площадку. Вы ее не пропустите, если окажетесь в нужном месте.‡Ah, noch eine Leuchtfeuerwaffe, hm? Die kann ich Euch geben.nnUnd vergesst nicht, Südspitze von Azshara. Es ist eine kleine Insel, die in eine Landungsplattform verwandelt wurde. Ihr könnt sie gar nicht verfehlen, wenn Ihr an der richtigen Stelle sucht.‡아, 신호탄을 하나 더 달라고? 물론 드릴 수 있지.nn그리고 절대 잊지 마시오. 아즈샤라 남쪽 끝에 있는, 착륙장으로 만든 작은 섬이오. 제대로만 가면 못 보고 지나치는 일은 없을 거요.‡¿Otra pistola de bengalas? Por supuesto.nnY recuerda que debes ir a la punta sur de Azshara. Es una islita reconvertida en pista de aterrizaje; seguro que la ves.‡‡Oh, un autre lance-fusées, hein ? Je peux le faire.nnN\'oubliez pas, la pointe sud d\'Azshara. C\'est une toute petite île transformée en piste d\'atterrissage. Vous ne pouvez pas la manquer si vous êtes au bon endroit.‡‡',
  }
},
[3501] = {
  {
    'Cada pedacinho conta‡Счет идет на большие числа‡Im Dutzend besser‡불완전한 드레니시스트 조각‡Todo cuenta en grandes cantidades‡Todo cuenta en grandes cantidades‡Tout se compte en grandes quantités‡多多益善‡多多益善',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha e ganhe uma recompensa por cada fragmento entregue.‡Принесите Кум-ише несовершенные фрагменты дренейского аметиста и получите награду за каждый из них.‡Bringt Kum\'isha unvollständige Draenethystfragmente und Ihr werdet für jedes, das Ihr bringt, belohnt.‡굼이샤에게 불완전한 드레니시스트 조각을 가져다주고 각 파편에 대해 보상을 받아야 합니다.‡Llévale a Kum\'isha trozos draenetistas imperfectos y te recompensará por cada fragmento entregado.|n‡Llévale a Kum\'isha trozos draenetistas imperfectos y te recompensará por cada fragmento entregado.‡Apporter des Fragments imparfaits de draenéthyste à Kum\'isha et toucher une récompense pour chaque fragment rapporté.‡将有瑕疵的德莱尼水晶碎片交给库米沙，你就可以得到相应的回报。‡將有瑕疵的德萊尼水晶碎片交給庫米沙，你就可以得到相應的回報。',
  }
},
[3502] = {
  {
    'O lixo de um draenei...‡Дренейский хлам...‡Des einen Draeneis Plunder...‡어느 드레나이의 잡동사니...‡Un trasto de Draenei...‡Un trasto de Draenei...‡Au rebut pour les draeneï‡德莱尼的垃圾...‡德萊尼的垃圾…',
    nil,
    'Leve Fragmentos Imperfeitos de Draenetista para Kum\'isha. Qualquer monstro da Barreira do Inferno pode estar carregando um fragmento desses.‡Принесите Кум-ише несовершенные фрагменты дренейского аметиста. У любого вида монстров в Выжженных землях могут быть эти фрагменты.‡Bringt Kum\'isha unvollständige Draenethystfragmente. Jede Art von Monster in den verwüsteten Landen könnte ein Fragment bei sich tragen.‡굼이샤에게 불완전한 드레니시스트 조각을 가져가십시오. 그 조각은 저주받은 땅에 있는 모든 야수가 지니고 있을 수도 있습니다.‡Llévale a Kum\'isha trozos draenetistas imperfectos. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.|n‡Llévale a Kum\'isha trozos draenetistas imperfectos. Cualquier forma de monstruo de Las Tierras Devastadas podría llevar uno de estos fragmentos.‡Apporter des Fragments imparfaits de draenéthyste à Kum\'isha. N\'importe quel monstre des Terres foudroyées peut détenir un fragment.‡将有瑕疵的德莱尼水晶碎片交给库米沙。诅咒之地的任何怪物都有可能携带着这样的碎片。‡將有瑕疵的德萊尼水晶碎片交給庫米沙。詛咒之地的任何怪物都有可能攜帶著這樣的碎片。',
  }
},
[3503] = {
  {
    'Chega de nhenhenhém!‡Встреча с господином‡Treffen mit dem Meister‡사나스의 스승‡Encuentro con el maestro‡Encuentro con el maestro‡Réunion avec le Maître‡见到主人‡見到主人',
    nil,
    'Já houve um tempo em que eu podia exigir qualquer coisa daqueles que desejavam uma audiência com meu mestre. Mas agora basta qualquer um me pedir, e eu despacho vocês até ele.nnIsso me irrita, mas eu não questiono as ordens. Minha única diversão é fazer pouco das roupas ridículas que você usa, ou da expressão patética no seu rosto. Mas mesmo isso me entedia...nnE esse nhenhenhém também! Quer encontrar meu mestre ou não?‡Да, уж не вернуть тех дней, когда я мог требовать с желающих видеть моего господина все, что заблагорассудится. Теперь-то я отправляю к нему любой сброд – только попроси! nnКак меня это бесит! Но приказы не обсуждаются. Я могу потешить себя лишь глумясь над твоей безвкусной одеждой и жалким выражением лица. Впрочем, мне и это уже наскучило! nnИ необходимость трепаться тут с тобой меня бесит! Будешь телепортироваться к господину или нет?!‡Es gab Zeiten, in denen ich alles von denen, die meinen Meister aufsuchen wollten, verlangen konnte. Heute ist es anders, Ihr müsst nur nach ihm fragen und ich schicke Euch zu ihm.nnEs ist ärgerlich für mich, aber ich stelle seine Befehle nicht in Frage. Ich kann mich lediglich an Eurer lächerlichen Aufmachung oder Eurem jämmerlichen Gesichtsausdruck erfreuen. Selbst das langweilt mich...nnSogar dieses Geschwafel langweilt mich! Möchtet Ihr meinen Meister sehen oder nicht?‡왕년에는 스승님께 안내하는 조건으로 모험가들에게 대가를 요구한 적이 있었지. 하지만 지금은 부탁만 한다면 스승님께 안내해 주겠소.nn썩 내키는 일은 아니지만 스승님의 명령이니 어쩔 수 없지. 내가 할 수 있는 일이라곤 당신의 우스꽝스러운 복장이나 비굴해 보이는 표정을 비웃는 것뿐이지. 사실 지루하기 짝이 없는 일이지만 말이야...nn슬슬 이 대화도 지루해지기 시작했어! 자, 이제 말해보시지. 내 스승님을 만날 거야 말 거야?‡Hubo un tiempo en que podía pedirles lo que fuera a los que buscaban a mi maestro. Pero ahora, solo tienes que pedirlo y te haré llegar hasta él. nnMe molesta pero no cuestiono sus órdenes. Solo puedo disfrutar de hacer bromas sobre tu ridículo atuendo o esa estúpida mirada que luces. Hasta eso me aburre... nn¡Hasta esta divagación me aburre! Bueno, ¿quieres ver a mi maestro o no?‡‡Autrefois, je pouvais demander tout ce que je voulais à ceux qui souhaitaient voir mon maître. À présent, vous n\'avez qu\'à demander et je vous enverrai à lui.nnCela me chagrine mais je ne discute pas ses ordres. Le seul plaisir qu\'il me reste est de me moquer des vêtements ridicules que vous portez et de votre mine pitoyable. Même cela m\'ennuie...nnMêmes ces bavardages m\'ennuient ! Souhaitez-vous voir mon maître ou non ?‡‡',
  }
},
[3504] = {
  {
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Entregue a Carta Lacrada para Ag\'tor a Ag\'tor Punho de Sangue, em Azshara.‡Отнесите запечатанное письмо Аг\'тору Кровопалу в Азшару.‡Bringt den versiegelten Brief zu Ag\'tor Blutfaust nach Azshara.‡아즈샤라에 있는 아그토르 블러드피스트에게 아그토르에게 보내는 봉인된 편지를 전해야 합니다.‡Entrega la carta lacrada a Ag\'tor Puñosangre en Azshara.‡Entrega la carta lacrada a Ag\'tor Puñosangre en Azshara.‡Apporter la Lettre scellée à Ag\'tor Poing-de-sang en Azshara.‡把这封给阿格图的密信交给艾萨拉的阿格图·血拳。‡把這封給阿格圖的密信交給艾薩拉的阿格圖·血拳。',
  }
},
[3505] = {
  {
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Mate 10 Recuperadores Sanguinélficos e 10 Topógrafos Sanguinélficos antes de procurar o acampamento da Maga Rimtori. Quando localizá-lo, procure algo que possa ser importante para ela e possa ser usado para forçá-la a lutar.‡Убейте 10 эльфов крови-землемеров и 10 эльфов крови-геодезистов, потом разыщите лагерь волхва Римтори. В лагере найдите что-нибудь важное для мага, из-за чего она могла бы ринуться в бой.‡Tötet 10 Blutelfeneintreiber und 10 Blutelfenfeldmesser, bevor Ihr Magus Rimtoris Lager sucht. Sobald Ihr es gefunden habt, sucht nach etwas, das für sie von Bedeutung ist und das wir nehmen können, um sie in einen Kampf zu locken.‡블러드 엘프 수색꾼 10명과 블러드 엘프 감정관 10명을 처치한 후, 학자 림토리의 야영지를 찾아내십시오. 야영지를 찾으면 그녀를 싸움으로 유인하는데 사용할 수 있을 만한 것을 찾아보십시오. 림토리가 중요하게 여기는 것이라야 합니다.‡Mata a 10 reivindicadores y 10 peritos elfos de sangre antes de buscar el campamento de Maga Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Mata a 10 reivindicadores y 10 peritos elfos de sangre antes de buscar el campamento de Maga Rimtori. Una vez allí, busca algo que sea importante para ella, algo con lo que provocar un combate.‡Tuer 10 Vengeurs elfes de sang et 10 Géomètres elfes de sang avant de rechercher le campement du magus Rimtori. Une fois le camp trouvé, chercher quelque chose d\'important pour elle et qui peut être utilisé pour l\'obliger à se battre.‡杀死10个血精灵搜寻者和10个血精灵勘测员，并找到大法师雷姆托里的营地。一旦你发现了营地，就去找到某个对她极为重要的东西，以用于激怒她，让她与你战斗。‡殺死10個血精靈搜尋者和10個血精靈探測員，然後尋找魔導師雷姆托里的營地。一旦你發現了營地，找出某個對她極為重要的東西，以用於激怒她，讓她與你戰鬥。',
  }
},
[3506] = {
  {
    'Traído‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Destrua o cristal de foco arcano preso à Maga Rimtori e mate-a. Depois, leve a Cabeça da Maga Rimtori para Ag\'tor Punho de Sangue em Azshara.‡Уничтожьте кристалл средоточия чар, связанный с волхвом Римтори, затем убейте ее. Отнесите голову Римтори Аг\'тору Кроволапу в Азшаре.‡Zerstört den arkanen Fokussierkristall, der an Magus Rimtori gebunden ist, und tötet sie danach. Bringt dann den Kopf von Magus Rimtori zu Ag\'tor Blutfaust nach Azshara.‡학자 림토리와 연결된 비전 집중의 수정을 파괴하고 그녀를 처치하십시오. 그런 다음 그 증거로 아즈샤라에 있는 아그토르 블러드피스트에게 학자 림토리의 머리카락을 가져가야 합니다.‡Destruye el cristal de enfoque arcano de Maga Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Destruye el cristal de enfoque Arcano de Maga Rimtori y entonces mátala. Lleva su cabeza a Ag\'tor Puñosangre a Azshara.‡Détruire le Cristal de focalisation des arcanes lié au magus Rimtori et l\'assassiner ensuite. Puis apporter la tête du magus Rimtori à Ag\'tor Poing-de-sang en Azshara.‡摧毁大法师雷姆托里携带的奥术聚焦水晶并杀死她。然后把她的脑袋交给艾萨拉的阿格图·血拳。‡摧毀魔導師雷姆托里身上的秘法聚焦水晶並殺死她。然後把她的腦袋交給艾薩拉的阿格圖·血拳。',
  }
},
[3507] = {
  {
    'Traição‡Предательница‡Verraten‡배신‡Traición‡Traición‡Trahison‡叛徒‡叛徒',
    nil,
    'Fale com Belgrom Pedramalho em Orgrimmar.‡Поговорите с Белгромом Каменной Буловой в Оргриммаре.‡Sprecht mit Belgrom Felshammer in Orgrimmar.‡오그리마에 있는 벨그롬 록마울과 대화하십시오.‡Habla con Belgrom Destrozarroca en Orgrimmar.‡Habla con Belgrom Destrozarroca en Orgrimmar.‡Aller voir Belgrom Cogneroche à Orgrimmar.‡与奥格瑞玛的贝尔戈洛姆·石槌谈一谈。‡與奧格瑪的貝爾戈洛姆·石槌談話。',
  }
},
[3508] = {
  {
    'Quebrando a proteção‡Минуя охрану‡Den Zauberschutz brechen‡보호막 파괴‡Romper el amuleto‡Romper el amuleto‡Briser l\'Amulette‡破坏结界‡',
    nil,
    'Espere Loramus para completar o feitiço de iluminação.‡Подождите, пока Лорамус завершит заклинание просветления.‡Wartet, bis Loramus den Erleuchtungszauber vollendet hat.‡로라무스가 깨우침의 마법을 마칠 때까지 기다려야 합니다.‡Espera que Loramus acabe el hechizo de ilustración.‡Espera que Loramus acabe el hechizo de ilustración.‡Attendre que Loramus ait achevé le rituel de Lumière.‡等待洛拉姆斯完成启迪法术。‡',
  }
},
[3509] = {
  {
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Fale com o Lorde Arkkoroc em Azshara. comece sua busca na beira da água para encontrar o Templo de Arkkoran.‡Поговорите в Азшаре с лордом Арккоросом. Начните поиски у кромки воды, чтобы найти храм Арккоран.‡Sprecht mit Lord Arkkoroc in Azshara. Beginnt Eure Suche am Rand des Wassers, um den Tempel von Arkkoran zu finden.‡아즈샤라에 있는 제왕 아크코로크와 대화해야 합니다. 아크코란의 신전을 찾으려면 물가부터 조사해 보십시오.‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Habla con Lord Arkkoroc en Azshara. Empieza tu búsqueda en la orilla para encontrar el Templo de Arkkoran.‡Aller voir le seigneur Arkkoroc en Azshara. Commencer la recherche au bord de l\'eau pour trouver le temple d\'Arkkoran.‡与艾萨拉的亚考罗克谈一谈。你应该在海边搜索亚考兰神殿。‡與艾薩拉的亞考羅克領主談一談。你應該在海邊搜索亞考蘭神殿。',
  }
},
[3510] = {
  {
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Mate Hetaera e leve a Cabeça Ensanguentada de Hetaera, a Cabeça Arrebentada de Hetaera e a Cabeça Ferida de Hetaera para o Lorde Arkkoroc.‡Убейте Хетайру и принесите окровавленную голову Хетайры, разбитую голову Хетайры и покрытую синяками голову Хетайры лорду Аккоросу.‡Erschlagt Hetaera und bringt den blutigen Kopf Hetaeras, den geschlagenen Kopf Hetaeras und den verwundeten Kopf Hetaeras zu Lord Arkkoroc.‡헤타에라를 물리치고 헤타에라의 훼손된 머리, 헤타에라의 피묻은 머리, 헤타에라의 으깨진 머리를 제왕 아크코로크에게 가지고 가야 합니다.‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Mata a Hetaera y lleva la cabeza ensangrentada, la cabeza golpeada y la cabeza amoratada a Lord Arkkoroc.‡Assassiner Hetaera et apporter la Tête ensanglantée d\'Hetaera, la Tête battue d\'Hetaera et la Tête meurtrie d\'Hetaera au seigneur Arkkoroc.‡杀掉赫塔拉，将染血的赫塔拉头颅、破碎的赫塔拉头颅和淤血的赫塔拉头颅交给亚考罗克。‡殺掉赫塔拉，將染血的赫塔拉頭顱、破碎的赫塔拉頭顱和淤血的赫塔拉頭顱交給亞考羅克領主。',
  }
},
[3511] = {
  {
    'O nome da fera‡Имя Зверя‡Der Name der Bestie‡악마의 이름‡El nombre de la bestia‡El nombre de la bestia‡Le nom de la bête‡恶魔之名‡惡魔之名',
    nil,
    'Leve a têmpera para Loramus Talípedes.‡Отнесите состав для закалки Лорамусу Многоногу.‡Bringt den Härter zurück zu Loramus Thalipedes.‡헤타에라의 피를 로라무스 탈리뻬데스에게 가져가야 합니다.‡Llévale el temple a Loramus Thalipedes.|n‡Llévale el temple a Loramus Thalimedes.‡Rapporter le durcisseur à Loramus Thalipedes.‡将调剂交给洛拉姆斯·萨里比迪斯。‡將調劑交給洛拉姆斯·薩里比迪斯。',
  }
},
[3512] = {
  {
    'Nas palavras do próprio Erânicos‡Судя по словам Эраникуса...‡Mit Eranikus\' eigenen Worten‡에라니쿠스의 말‡Como diría Eranikus...‡Como diría Eranikus...‡Par les mots d\'Eranikus‡帮助伊兰尼库斯‡幫助伊蘭尼庫斯',
    nil,
    'Viaje até o leste de Hibérnia e fale com Umbranse, o Médium.‡Отправляйтесь в восточную часть Зимних Ключей и поговорите с Умбрансом Ищущим Духов.‡Reist in den östlichen Teil von Winterquell und sprecht mit Umbranse, dem Geistsprecher.‡여명의 설원의 동쪽으로 가서 영매 엄브런스를 만나야 합니다.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Contacto Espiritual.‡Viaja a la parte este de Cuna del Invierno y habla con Umbranse el Hablaalmas.‡Se rendre dans la partie orientale du Berceau-de-l\'Hiver et aller voir Umbranse l\'implorateur d\'esprit.‡到冬泉谷的东部地区去，与灵语者阿姆布兰希谈一谈。‡到冬泉谷的東部地區去，與『靈語者』昂布蘭希談話。',
  }
},
[3513] = {
  {
    'O pergaminho rúnico‡Свиток с рунами‡Die runenverzierte Rolle‡룬문자 두루마리‡El pergamino rúnico‡El pergamino rúnico‡Le Parchemin runique‡符文卷轴‡符文卷軸',
    nil,
    'Leve o Pergaminho Rúnico até a torre de guarda norte nos Sertões.‡Отнесите свиток с рунами в северную сторожевую башню Степей.‡Bringt die runenverzierte Rolle zum nördlichen Wachturm des Brachlandes.‡불모의 땅의 북쪽 방어탑으로 룬문자 두루마리를 가지고 가야 합니다.‡Llévale el pergamino rúnico de la torre de vigilancia norte en Los Baldíos.‡Llévale el pergamino rúnico de la torre de vigilancia norte en Los Baldíos.‡Apporter le Parchemin runique à la tour de garde Nord dans les Tarides.‡将符文卷轴带到贫瘠之地的北部警戒塔去。‡將符文卷軸帶到貧瘠之地的北部警戒塔去。',
  }
},
[3514] = {
  {
    'Presença da Horda‡Мощь Орды‡Hordenpräsenz‡호드의 존재‡La presencia de la Horda‡La presencia de la Horda‡Présence de la Horde‡部落的示威‡部落的示威',
    nil,
    'Mate a líder do Retiro do Gadanho, Rynthariel, a Guardiã da Chave.‡Убейте предводительницу Пещеры Когтей, Ринтариэль Хранительницу Ключей.‡Tötet die Anführerin des Krallenbaus, Rynthariel die Schlüsselmeisterin.‡갈퀴발톱굴의 우두머리인 열쇠지기 린타리엘을 처치해야 합니다.‡Mata a la jefa de El Cubil del Espolón, Rynthariel la Maestra de llaves.‡Mata a la jefa de El Cubil del Espolón, Rynthariel la Maestra de llaves.‡Tuer le chef de l\'Antre des Serres, Rynthariel le Maître des clés.‡杀死猛禽洞穴的领袖琳萨瑞尔。‡殺死猛禽洞穴的領袖琳薩瑞爾。',
  }
},
[3517] = {
  {
    'Roubando conhecimento‡Тайненькое знаньице‡Wissen stehlen‡서판 훔치기‡El robo de conocimientos‡El robo de conocimientos‡L\'art du vol‡偷窃知识‡偷竊知識',
    nil,
    'Encontre a Tabuleta de Beth\'Amara, a Tabuleta de Jin\'yael, a Tabuleta de Markri e a Tabuleta de Sael\'hai. Depois volte a falar com Jediga, em Azshara.‡Найдите таблички Бет\'Амары, Джин\'яэль, Маркри и Саэль\'Хай и принесите их Джедиге в Азшару.‡Sucht die Schrifttafel von Beth\'Amara, die Schrifttafel von Jin\'yael, die Schrifttafel von Markri und die Schrifttafel von Sael\'hai, bevor Ihr zu Jediga in Azshara zurückkehrt.‡베스아마라 서판, 진야엘 서판, 마크리 서판, 샤엘하이 서판을 찾아 아즈샤라에 있는 제디가에게 돌아가야 합니다.‡Encuentra la tablilla de Beth\'Amara, la tablilla de Jin\'yael, la tablilla de Markri y la tablilla de Sael\'hai antes de volver junto a Jediga en Azshara.‡Encuentra la tablilla de Beth\'Amara, la tablilla de Jin\'yael, la tablilla de Markri y la tablilla de Sael\'hai antes de volver junto a Jediga en Azshara.‡Trouver la Tablette de Beth\'Amara, la Tablette de Jin\'yael, la Tablette de Markri et la Tablette de Sael\'hai puis retourner voir Jediga en Azshara.‡找到贝萨玛拉石板、辛耶尔石板、玛科里石板和塞尔哈石板，把它们交给艾萨拉的杰迪加。‡找到貝薩瑪拉石板、辛耶爾石板、瑪寇里石板和塞爾哈石板，把它們交給艾薩拉的傑迪加。',
  }
},
[3518] = {
  {
    'Entrega para Magatha‡Доставка Магате‡Lieferung an Magatha‡마가타에게 전달‡Entrega a Magatha‡Entrega a Magatha‡Livraison à Magatha‡玛加萨的石版‡瑪加薩的石版',
    nil,
    'Leve a Tabuleta de Beth\'Amara para Magatha no Penhasco do Trovão.‡Отнесите табличку Бет\'Амары Магате в Громовой Утес.‡Bringt die Schrifttafel von Beth\'Amara zu Magatha in Donnerfels.‡썬더 블러프에 있는 마가타에게 베스아마라 서판을 가져가야 합니다.‡Llévale la tablilla de Beth\'Amara a Magatha en Cima del Trueno.‡Llévale la tablilla de Beth\'Amara a Magatha en Cima del Trueno.‡Apporter la Tablette de Beth\'Amara à Magatha aux Pitons du Tonnerre.‡将贝萨玛拉石板交给雷霆崖的玛加萨·野性图腾。‡將貝薩瑪拉石板交給雷霆崖的瑪加薩·恐怖圖騰。',
  }
},
[3519] = {
  {
    'Um amigo em apuros‡Друг в беде‡Ein Freund in Not‡친구의 도움‡Un amigo en apuros‡Un amigo en apuros‡Un ami dans le besoin‡需要帮助的朋友‡需要幫助的朋友',
    nil,
    'Fale com Dirânia Pratafulge em Umbravale.‡Поговорите с Диранией Серебряным Сиянием в Тенистой долине.‡Sprecht mit Dirania Silberschein im Laubschattental.‡그늘 협곡에 있는 디라니아 실버샤인과 대화하십시오.‡Habla con Dirania Brillargente en Cañada Umbría.‡Habla con Dirania Brillargente en Cañada Umbría.‡Parler à Dirania Brillargent, à Sombrevallon.‡与幽影谷的迪兰妮亚·月光谈一谈。‡與幽影谷的迪蘭妮亞·銀光談話。',
  }
},
[3520] = {
  {
    'Espíritos guinchadores‡Духи крикунов‡Kreischergeister‡계곡천둥매의 영혼‡Los espíritus de los estridadores‡Los espíritus de los estridadores‡Esprits de Hurleurs‡尖啸者的灵魂‡尖嘯者的靈魂',
    nil,
    'Capture os espíritos de 3 guinchadores em Feralas, e depois fale novamente com Yeh\'kinya no Porto de Bondebico.‡Поймайте души трех крикунов из Фераласа и возвращайтесь к Йе\'кинье в Порт Картеля.‡Fangt die Geister von 3 Kreischern in Feralas ein und kehrt dann zu Yeh\'kinya beim Dampfdruckpier zurück.‡페랄라스에 있는 3마리의 계곡천둥매의 영혼을 모은 후 스팀휘들 항구에 있는 예킨야에게 돌아가야 합니다.‡Captura el espíritu de 3 estridadores en Feralas y después ve a ver a Yeh\'kinya al Puerto Bonvapor.‡Captura el espíritu de 3 estridadores en Feralas y después ve a ver a Yeh\'kinya al Puerto Bonvapor.‡Capturer l\'Esprit de 3 Hurleurs en Féralas, puis retourner voir Yeh\'kinya à Port Gentepression.‡在菲拉斯捕获3个尖啸者的灵魂，然后回到热砂港的叶基亚那里去。‡到菲拉斯捕獲3個尖叫者的靈魂，然後回到熱砂港的葉金亞那裡。',
  }
},
[3521] = {
  {
    'O antídoto de Iverron‡Противоядие для Иверрона‡Iverrons Gegengift‡이베론을 위한 해독제‡El antídoto de Iverron‡El antídoto de Iverron‡L\'antidote d\'Iverron‡埃沃隆的解药‡埃沃隆的解藥',
    nil,
    'Colete 7 Cogumelos Jacinto, 4 Lírios Lunapétala e 1 Linfa de Lenhateia para Dirânia Pratafulge em Umbravale.‡Соберите 7 гиацинтовых грибов, 4 лунные лилии и 1 порцию лимфы чащобного тенетника и принесите Дирании Серебряное Сияние в Тенистую долину.‡Sammelt 7 Hyazinthpilze, 4 Mondblütenlilien und 1 Waldwebersekret für Dirania Silberschein im Laubschattental.‡그늘 협곡에 있는 디라니아 실버샤인에게 히아신스 버섯 7개, 달봉우리 백합 4개, 나무그물거미 영액 1개를 가져가야 합니다.‡Reúne 7 champiñones jacinto, 4 lirios alunados y 1 icor Tejemadera para Dirania Brillargente, que está en Cañada Umbría.‡Reúne 7 champiñones jacinto, 4 lirios alunados y 1 icor Tejemadera.‡Trouver 7 Champignons jacinthe, 4 Lys pétales de lune et 1 Ichor d\'araignée Tissebois pour Dirania Brillargent dans Sombrevallon.‡在幽影谷中为迪兰妮亚·月光收集7朵紫蓝色蘑菇、4朵月牙百合花和一份树林蜘蛛的脓液。‡在幽影谷中為迪蘭妮亞·月光收集7朵紫藍色蘑菇、4朵月牙百合花和一份樹林蜘蛛的膿液。',
  }
},
[3522] = {
  {
    'O antídoto de Iverron‡Противоядие для Иверрона‡Iverrons Gegengift‡이베론을 위한 해독제‡El antídoto de Iverron‡El antídoto de Iverron‡Antidote d\'Iverron‡埃沃隆的解药‡埃沃隆的解藥',
    nil,
    'Leve o Antídoto de Iverron para Iverron antes que o tempo se esgote. Iverron está na caverna ao norte.‡Отнесите противоядие Иверрону, прежде чем оно потеряет свои целебные свойства. Иверрона можно найти около пещеры, что к северу отсюда.‡Bringt Iverrons Gegengift zu Iverron, bevor die Zeit um ist. Ihr findet Iverron bei der Höhle im Norden.‡제한 시간이 지나기 전에 이베론에게 해독제를 가져다줘야 합니다. 이베론은 북쪽에 있는 동굴 옆에서 찾을 수 있습니다.‡Llévale el antídoto de Iverron a Iverron antes de que se acabe el tiempo. Lo encontrarás junto a la cueva situada al norte.‡Llévale el antídoto de Iverron a Iverron antes de que se acabe el tiempo. Lo encontrarás junto a la cueva situada al norte.‡Apporter l\'Antidote d\'Iverron à Iverron avant que la limite de temps ne soit atteinte. Iverron se trouve près de la grotte, au nord.‡在5分钟内将埃沃隆的解药交给他。你可以北边的洞穴入口外面找到埃沃隆。‡在5分鐘內將埃沃隆的解藥交給他。你可以從在北邊的洞穴旁找到埃沃隆。',
  }
},
[3523] = {
  {
    'O Flagelo do Urzal‡Плеть в холмах‡Geißel der Niederungen‡가시덩굴 구릉의 스컬지‡La plaga de la Zahúrda‡La plaga de la Zahúrda‡Le Fléau des Souilles‡剃刀高地的亡灵天灾‡剃刀高地的天譴軍團',
    nil,
    'Se você concordar em ajudar Belnistrasz, fale novamente com ele e devolva a pedra de juramento que ele lhe deu.‡Если вы хотите помочь Белнистразу, поговорите с ним еще раз и верните ему Камень клятвы, который он дал вам.‡Wenn Ihr Belnistrasz helfen wollt, sprecht noch einmal mit ihm und übergebt ihm den Schwurstein, den er Euch gab.‡그가 당신에게 서약의 돌을 줄 것입니다. 벨리스트라즈의 계획을 돕는 것에 동의하면 다시 그와 대화하여 그에게 서약의 돌을 돌려주십시오.‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Si decides ayudar a Belnistrasz, habla con él otra vez y devuélvele la piedra de juramento.‡Pour aider Belnistrasz, lui parler de nouveau et lui rendre la Pierre de voeu qu\'il vous avait donnée.‡如果你同意帮助奔尼斯特拉兹，就再跟他谈谈，并将誓言石还给他。‡要是你願意幫助貝尼斯特拉茲，再跟他談談，並將黑曜石還給他。',
  }
},
[3524] = {
  {
    'Deixa a água me levar‡Останки на берегу‡An Land gespült‡해변으로 올라온 바다 생물‡Varado‡Varado‡Echouage‡搁浅的巨兽‡擱淺的巨獸',
    nil,
    'Obtenha Ossos de Criaturas Marinhas da criatura marinha encalhada logo ao sul Auberdine e leve para Gwennyth Bly\'Leggonde em Auberdine.‡Соберите кости морской твари, выброшенной на берег к югу от Аубердина, и принесите их Гвеннид Блай\'Леггонд в Аубердин.‡Sammelt Meereskreaturknochen von der gestrandeten Meereskreatur unmittelbar südlich von Auberdine und kehrt dann mit ihnen zu Gwennyth Bly\'Leggonde nach Auberdine zurück.‡아우버다인 바로 남쪽에 있는 떠내려온 바다 생물에게서 바다 생물 뼈를 회수한 후, 아우버다인에 있는 그웨니스 블리레곤드에게 가져가야 합니다.‡Recoge huesos de la criatura marina varada que está al sur de Auberdine y llévaselos a Gwennyth Bly\'Leggonde a Auberdine.‡Recoge huesos de la criatura marina varada que está al sur de Auberdine y llévaselos a Gwennyth Bly\'Leggonde a Auberdine.‡Récupérer des Os de créature marine sur la créature échouée, au sud d\'Auberdine, puis les apporter à Gwennyth Bly\'Leggonde, à Auberdine.‡从奥伯丁南面的海岸上收集海洋生物的骨头，然后带着骨头向奥伯丁的温尼斯·布莱葛回复。‡在奧伯丁南邊的海岸上尋找擱淺生物的駭骨，然後帶著骨頭回來找奧伯丁的溫尼斯·布萊葛。',
  }
},
[3525] = {
  {
    'O ídolo nefando‡Уничтожить идола‡Ausschalten des Götzen‡우상 진화‡Extinguir el ídolo‡Extinguir el ídolo‡L\'extinction de l\'idole‡封印神像‡封印塑像',
    nil,
    'Escolte Belnistrasz até o ídolo dos javatuscos no Urzal dos Mortos.nnProteja Belnistrasz enquanto ele realiza o ritual para desativar o ídolo.‡Сопроводите Белнистраза к идолу свинобразов на Курганах Иглошкурых. nnЗащищайте Белнистраза, пока он будет проводить ритуал, чтобы разрушить идола.‡Begleitet Belnistrasz zum Götzen der Stacheleber in den Hügeln der Klingenhauer.nnBeschützt Belnistrasz, während er das Ritual durchführt, um den Götzen auszuschalten.‡가시덩굴 구릉에 있는 가시멧돼지의 우상까지 벨리스트라즈를 호위해야 합니다.nn우상을 진화하는 의식을 수행하는 동안 벨리스트라즈를 보호해야 합니다.‡Acompaña a Belnistrasz al ídolo jabaespín en Zahúrda Rajacieno. nnProtégelo mientras realiza el ritual para inutilizar el ídolo.‡Acompaña a Belnistrasz al ídolo jabaespín en Zahúrda Rajacieno.|nProtégelo mientras realiza el ritual para inutilizar el ídolo.‡Escorter Belnistrasz jusqu\'à l\'Idole des hurans dans les Souilles de Tranchebauge.nnProtéger Belnistrasz tandis qu\'il exécute le rituel pour arrêter l\'idole.‡保护奔尼斯特拉兹来到剃刀高地的野猪人神像处。nn当他在进行仪式封印神像时保护他。‡護送貝尼斯特拉茲來到剃刀高地的野豬人塑像處。|n當他在執行儀式封印塑像時保護他。',
  }
},
[3526] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia a Nixx Molapinhão em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage dans Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想學習哥布林工程學的知識，就把工程學教材手冊交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3527] = {
  {
    'A profecia de Mosh\'aru‡Пророчество Мошару‡Die Prophezeiung von Mosh\'aru‡모쉬아루의 예언‡La profecía de Mosh\'aru‡La profecía de Mosh\'aru‡La prophétie de Mosh\'aru‡摩沙鲁的预言‡摩沙魯的預言',
    nil,
    'Leve a Primeira e a Segunda Tabuleta Mosh\'Aru para Yeh\'kinya, em Tanaris.‡Принесите первую и вторую таблички Мошару Йе\'кинье в Танарис.‡Bringt die erste und die zweite Schrifttafel von Mosh\'aru zu Yeh\'kinya nach Tanaris.‡타나리스에 있는 예킨야에게 첫번째 모쉬아루 서판과 두번째 모쉬아루 서판을 가져가야 합니다.‡Llévale la primera y segunda tablillas Mosh\'aru a Yeh\'kinya, que está en Tanaris.‡Llévale la primera y segunda tablillas Mosh\'aru a Yeh\'kinya, que está en Tanaris.‡Apporter les Première et Deuxième tablettes Mosh\'Aru à Yeh\'kinya, à Tanaris.‡将第一块和第二块摩沙鲁石板交给塔纳利斯的叶基亚。‡將第一塊和第二塊摩沙魯石板交給塔納利斯的葉基亞。',
  }
},
[3528] = {
  {
    'O deus Hakkar‡Бог Хаккар‡Der Gott Hakkar‡학카르의 화신‡El dios Hakkar‡El dios Hakkar‡Le dieu Hakkar‡神灵哈卡‡神靈哈卡',
    nil,
    'Leve o Ovo de Hakkar Cheio para Yeh\'kinya, em Tanaris.‡Отнесите заполненное яйцо Хаккара Йе\'кинье в Танарис.‡Bringt das gefüllte Ei von Hakkar zu Yeh\'kinya nach Tanaris.‡타나리스에 있는 예킨야에게 충만한 학카르의 알을 가져가야 합니다.‡Llévale el huevo de Hakkar relleno a Yeh\'kinya, que está en Tanaris.‡Llévale el huevo de Hakkar relleno a Yeh\'kinya, que está en Tanaris.‡Apporter l\'Oeuf Rempli d\'Hakkar à Yeh\'kinya dans Tanaris.‡将装满的哈卡之卵交给塔纳利斯的叶基亚。‡將裝滿的哈卡之卵交給塔納利斯的葉基亞。',
  }
},
[3541] = {
  {
    'Entrega para Sona\'rima‡Доставка Джес\'римону‡Lieferung an Jes\'rimon‡제스리몬에게 전달‡Entrega a Jes\'rimon‡Entrega a Jes\'rimon‡Livraison pour Jes\'rimon‡杰斯雷蒙的石版‡送貨給傑斯雷蒙',
    nil,
    'Leve a Tabuleta de Jin\'yael para Sona\'rima em Orgrimmar.‡Отнесите табличку Джин\'яэль Джес\'римону в Оргриммар.‡Bringt die Schrifttafel von Jin\'yael zu Jes\'rimon nach Orgrimmar.‡오그리마에 있는 제스리몬에게 진야엘 서판을 가져가야 합니다.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Envía la tablilla de Jin\'yael a Jes\'rimon en Orgrimmar.‡Apporter la Tablette de Jin\'yael à Jes\'rimon à Orgrimmar.‡将辛耶尔石板交给奥格瑞玛的杰斯雷蒙。‡將辛耶爾石板交給奧格瑪的傑斯雷蒙。',
  }
},
[3542] = {
  {
    'Entrega para Andron Gante‡Доставка Андрону Ганту‡Lieferung an Andron Gant‡안드론 건트에게 전달‡Entrega a Andron Gant‡Entrega a Andron Gant‡Livraison à Andron Gant‡安德隆·甘特的石版‡送貨給安德隆·甘特',
    nil,
    'Leve a Tabuleta de Markri para Andron Gante na Cidade Baixa.‡Отнесите табличку Маркри Андрону Ганту в Подгород.‡Bringt die Schrifttafel von Markri zu Andron Gant nach Unterstadt.‡언더시티에 있는 안드론 건트에게 마크리 서판을 가져가야 합니다.‡Llévale la tablilla de Markri a Andron Gant en Entrañas.‡Llévale la tablilla de Markri a Andron Gant en Entrañas.‡Apporter la Tablette de Markri à Andron Gant à Fossoyeuse.‡将玛科里石板交给幽暗城的安德隆·甘特。‡將瑪寇里石板交給幽暗城的安德隆·甘特。',
  }
},
[3561] = {
  {
    'Entrega para o Arquimago Tauriel‡Доставка верховному магу Ксилему‡Lieferung für Erzmagier Xylem‡대마법사 실렘에게 전달‡Entrega al archimago Xylem‡Entrega al archimago Xylem‡Livraison à l\'archimage Xylem‡大法师克希雷姆的石版‡送貨給大法師克希雷姆',
    nil,
    'Leve a Tabuleta de Sael\'hai para o Arquimago Tauriel em Azshara.‡Отнесите табличку Саэль\'Хай верховному магу Ксилему в Азшару.‡Bringt die Schrifttafel von Sael\'hai zu Erzmagier Xylem in Azshara.‡아즈샤라에 있는 대마법사 실렘에게 샤엘하이 서판을 가져가야 합니다.‡Llévale la tablilla de Sael\'hai al archimago Xylem en Azshara.‡Llévale la tablilla de Sael\'hai al archimago Xylem en Azshara.‡Apporter la Tablette de Sael\'hai à l\'archimage Xylem en Azshara.‡将塞尔哈石板交给艾萨拉的大法师克希雷姆。‡將塞爾哈石板交給艾薩拉的大法師克希雷姆。',
  }
},
[3562] = {
  {
    'O pagamento de Magatha para Jediga‡Плата Магаты Джедиге‡Magathas Bezahlung für Jediga‡제디가에 대한 마가타의 답례‡El pago de Magatha a Jediga‡El pago de Magatha a Jediga‡Le Paiement de Magatha à Jediga‡玛加萨的报酬‡瑪加薩的報酬',
    nil,
    'Entregue o Bilhete de Magatha para Jediga em Azshara.‡Отнесите записку Магаты Джедиге в Азшару.‡Bringt Magathas Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 마가타의 쪽지를 가져가야 합니다.‡Entrega la nota de Magatha a Jediga en Azshara.‡Entrega la nota de Magatha a Jediga en Azshara.‡Apporter la Note de Magatha à Jediga dans Azshara.‡将玛加萨的便笺交给艾萨拉的杰迪加。‡將瑪加薩的便箋交給艾薩拉的傑迪加。',
  }
},
[3563] = {
  {
    'O pagamento de Sona\'rima para Jediga‡Плата Джес\'римона Джедиге‡Jes\'rimons Bezahlung für Jediga‡제디가에 대한 제스리몬의 답례‡El pago de Jes\'rimon a Jediga‡El pago de Jes\'rimon a Jediga‡Le Paiement de Jes\'rimon à Jediga‡杰斯雷蒙的报酬‡傑斯雷蒙的報酬',
    nil,
    'Entregue o Bilhete de Sona\'rima para Jediga, em Azshara.‡Доставьте записку Джес\'римона Джедиге в Азшару.‡Bringt Jes\'rimons Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 제스리몬의 쪽지를 가져가야 합니다.‡Entrega la nota de Jes\'rimon a Jediga en Azshara.‡Entrega la nota de Jes\'rimon a Jediga en Azshara.‡Apporter la Note de Jes\'rimon à Jediga en Azshara.‡将杰斯雷蒙的便笺交给艾萨拉的杰迪加。‡將傑斯雷蒙的便箋交給艾薩拉的傑迪加。',
  }
},
[3564] = {
  {
    'O pagamento de Andron para Jediga‡Плата Андрона Джедиге‡Androns Bezahlung für Jediga‡제디가에 대한 안드론 건트의 보답‡El pago de Andron a Jediga‡El pago de Andron a Jediga‡Le Paiement d\'Andron à Jediga‡安德隆的报酬‡安德隆的報酬',
    nil,
    'Entregue o Bilhete de Andron para Jediga, em Azshara.‡Доставьте записку Андрона Джедиге в Азшару.‡Bringt Androns Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 안드론의 쪽지를 가져가야 합니다.‡Entrega la nota de Andron a Jediga en Azshara.‡Entrega la nota de Andron a Jediga en Azshara.‡Apporter la Note d\'Andron à Jediga en Azshara.‡将安德隆的便笺交给艾萨拉的杰迪加。‡將安德隆的字條交給艾薩拉的傑迪加。',
  }
},
[3565] = {
  {
    'O pagamento de Tauriel para Jediga‡Плата Ксилема Джедиге‡Xylems Bezahlung für Jediga‡제디가에 대한 실렘의 보답‡El pago de Xylem a Jediga‡El pago de Xylem a Jediga‡Le Paiement de Xylem à Jediga‡克希雷姆的报酬‡克希雷姆的報酬',
    nil,
    'Entregue o Bilhete de Tauriel para Jediga, em Azshara.‡Доставь записку Ксилема Джедиге в Азшару.‡Bringt Xylems Notiz zu Jediga in Azshara.‡아즈샤라에 있는 제디가에게 실렘의 쪽지를 가져가야 합니다.‡Entrega la nota de Xylem a Jediga en Azshara.‡Entrega la nota de Xylem a Jediga en Azshara.‡Apporter la Note de Xylem à Jediga en Azshara.‡将克希雷姆的便笺交给艾萨拉的杰迪加。‡將克希雷姆的便箋交給艾薩拉的傑迪加。',
  }
},
[3566] = {
  {
    'Erga-se, Obsidião!‡Восстань, Обсидион!‡Erhebt Euch, Obsidion!‡일어나라, 흑요암이여!‡¡Arriba, Obsidion!‡¡Arriba, Obsidion!‡Debout, Obsidion !‡奥比斯顿‡奧比斯頓',
    nil,
    'Mate Obsidião e Latórico, o Negro, e então fale novamente com Tórius em Altaforja com o Coração de Obsidião e a Cabeça de Latórico, o Negro.‡Убейте Латорика Черного и Обсидиона и принесите голову Латорика и сердце Обсидиона Ториусу в Стальгорн.‡Tötet Lathoric den Schwarzen und Obsidion. Kehrt zurück zu Thorius nach Eisenschmiede mit dem Kopf von Lathoric dem Schwarzen und dem Herzen von Obsidion.‡검은 라소릭과 흑요암을 쓰러뜨리고, 그 증거로 검은 라소릭의 머리카락과 흑요암 심장을 아이언포지에 있는 소리우스에게 가져가야 합니다.‡Lleva la cabeza de Lathoric el Negro y el corazón de Obsidion a Thorius a Forjaz.‡Lleva la cabeza de Lathoric el Negro y el corazón de Obsidion a Torio a Forjaz.‡Assassiner Lathoric le Noir et Obsidion, puis retourner voir Thorius, à Forgefer, avec la Tête de Lathoric le Noir et le Coeur d\'Obsidion.‡杀死黑衣拉索里克和奥比斯顿，带着黑衣拉索里克的头颅和奥比斯顿的心脏回到铁炉堡的索里奥斯那儿。‡殺死黑衣拉索里克和奧比斯頓，帶著黑衣拉索里克的頭顱和奧比斯頓的心臟回到鐵爐堡的索里奧斯那裡。',
  }
},
[3567] = {
  {
    'Até o topo‡Умный в гору не пойдет...‡An die Spitze‡높은 곳‡A la cima‡A la cima‡Au sommet‡登高‡登高',
    nil,
    '‡Хочешь посмотреть, какой вид открывается во-он оттуда, с тех Двух Колоссов? Могу тебя туда отправить, |3-6(нежить).nnТолько подумай заранее, как потом будешь спускаться. Это путешествие в один конец!‡Würdet Ihr den Ausblick von einem der Zwillingskolosse bevorzugen? Ich kann Euch dorthin schicken, <Volk>.nnAber überlegt, wie Ihr wieder herunterkommt. Ich kann Euch nur nach oben schicken.‡쌍둥이 바위산 꼭대기에서 경치 구경 좀 하시겠어요? 제가 보내 드릴 수 있답니다.nn다만 어떻게 내려올지는 잘 생각해 두세요. 올려드릴 수만 있거든요.‡¿Quieres ver la vista desde uno de los colosos gemelos? Porque puedo mandarte allí arriba, <raza>.nnPero tendrás que pensar tú en cómo harás para bajar. Yo te ofrezco solo el viaje de ida.‡‡Souhaitez-vous admirer la vue depuis le sommet de l\'un des Colosses jumeaux ? Je peux vous y envoyer, <race>.nnRéfléchissez quand même à la façon de redescendre. C\'est un voyage que l\'on ne peut faire que dans un seul sens.‡你想要站在双塔山的最高处俯瞰世界吗？我可以送你到那儿去，<class>。nn但是，你得自己想办法下来。我这是单程服务。‡',
  }
},
[3568] = {
  {
    'Corrupção líquida‡Разносчик порчи‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la Corrupción‡La filtración de la corrupción‡Corruption Suintante‡堕落之水‡墮落之水',
    nil,
    'Encha as 4 Ampolas Vazias nas poças ao longo da costa das Ruínas de Eldarath em Azshara. Em seguida, volte a falar com o Químico Arnaldo.‡Наполните все 4 пустых фиала из приливных заводей в руинах Эльдарата и возвращайтесь к химику Карабосу.‡Füllt alle 4 leeren Phiolen an den Gezeitenteichen entlang der Küste der Ruinen von Eldarath in Azshara und kehrt dann zu Chemiker Miesmut zurück.‡아즈샤라에 있는 엘다라스 폐허의 해변을 따라 가면서 4개의 빈 약병에 해일의 구덩이의 물을 모두 채운 후, 연금술사 큘리에게 돌아가야 합니다.‡Llena los 4 viales vacíos en las pozas de las mareas que se encuentran a lo largo de la costa de las Ruinas de Eldarath en Azshara y después ve a ver al químico Cuely.‡Llena los 4 viales vacíos en las pozas de las mareas que se encuentran a lo largo de la costa de las Ruinas de Eldarath en Azshara y después ve a ver al químico Cuely.‡Avant de retourner voir le Chimiste Cuely, remplir les 4 Fioles vides dans les cuvettes de marées le long de la côte des Ruines d\'Eldarath, en Azshara.‡在艾萨拉的埃达拉斯废墟旁的海潮之池中收集4瓶水，然后回到药剂师科雷那儿。‡在艾薩拉的埃達拉斯廢墟旁的海潮之池中收集4瓶水，然後回到藥劑師科雷那兒。',
  }
},
[3569] = {
  {
    'Corrupção líquida‡Разносчик порчи‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la Corrupción‡La filtración de la corrupción‡Corruption Suintante‡堕落之水‡墮落之水',
    nil,
    'Dê o Elixir do Arnaldo para Thersa Cantéolo, na Cidade Baixa.‡Дайте эликсир Карабоса Терсе Песне Ветра в Подгороде.‡Gebt Miesmuts Elixier Thersa Windweise in Unterstadt.‡언더시티에 있는 테레사 윈드송에게 큘리의 비약을 줘야 합니다.‡Dale el elixir de Cuely a Thersa Canzalvaje, que está en Entrañas.‡Dale el elixir de Cuely a Thersa Son del Viento, que está en Entrañas.‡Donner l\'élixir de Cuely à Thersa Chant-du-vent, à Fossoyeuse.‡将科雷的药剂交给幽暗城的瑟尔萨·风歌。‡將科雷的藥劑交給幽暗城的瑟爾薩·風歌。',
  }
},
[3570] = {
  {
    'Corrupção líquida‡Разносчик порчи‡Verbreitete Verderbnis‡스며드는 타락‡La filtración de la Corrupción‡La filtración de la corrupción‡Corruption Suintante‡堕落之水‡',
    nil,
    '‡Я и не думал, что эликсир сработает так быстро. Спасибо, Томпсон. Займусь-ка работой над остальными образцами. Уверен, вскоре леди Сильвана и Отрекшиеся будут их активно использовать.‡Ich hätte mir nie träumen lassen, dass das Elixier so schnell Wirkung zeigen würde. Danke, <Name>. Ich werde mich sofort an die Untersuchung der restlichen Proben machen. Bestimmt werden sie für Lady Silvanas und die Verlassenen schon bald von Nutzen sein.‡비약이 저렇게 잘 들을 줄은 꿈에도 생각하지 못했군. 고맙소이다. 나머지 견본들도 즉시 작업에 착수해야겠소. 곧 실바나스 여왕님과 포세이큰이 사용할 수 있을 거요.‡Nunca hubiera imaginado que el elixir hiciera efecto tan rápido. Gracias, <nombre>. Ahora me pondré manos a la obra con las demás muestras. Seguro que muy pronto les resultan de utilidad a Lady Sylvanas y a los Renegados.‡‡Je n\'aurais jamais rêvé que l\'élixir puisse prendre forme aussi rapidement. Merci, <nom>. Je vais travailler sur le reste de ces échantillons tout de suite. Je suis sûr qu\'ils seront bientôt utilisables par Dame Sylvanas et les Réprouvés.‡‡',
  }
},
[3601] = {
  {
    'Kam\'arawn é a mãe!‡Оскорбленный Ким\'джаель‡Kim\'jael, fürwahr!‡킴야엘‡¡Kim\'jael, claro!‡¡Kim\'jael, claro!‡Kim\'jael évidemment !‡我就是基姆加尔！‡我就是基姆加爾!',
    nil,
    'Vasculhe o Acampamento Talassiano e encontre os seguintes itens de Kam\'arawn: A Bússola, o Telescópio, o Frango Recheado e a Chinforímpola. Depois, devolva os itens para Kam\'arawn em Azsahra.‡Обыщите Талассийское поселение и найдите компас, прицел, плюшевого цыпленка и центробежный растягиватель Ким\'джаеля. Верните все это Ким\'джаелю в Азшару.‡Durchsucht den thalassischen Stützpunkt nach Kim\'jaels Kompass, Zielfernrohr, ausgestopftem Huhn und Knobelwizz und bringt ihm dann alles nach Azshara zurück.‡탈라시안 주둔지에서 킴야엘의 나침반, 망원경, 박제한 닭, 그리고 땅콩까개를 찾은 후, 아즈샤라에 있는 킴야엘에게 돌려주어야 합니다.‡Busca en el Campamento base thalassiano la brújula de Kim\'jael, la mira, el pollo relleno y el cachivache y llévaselo todo a Azshara.‡Busca en el Campamento base thalassiano la brújula de Kim\'jael, la mira, el pollo relleno y el cachivache y llévaselo todo a Azshara.‡Fouiller le Camp de base thalassien pour trouver la Boussole, la Lunette, le Poulet farci et le Wizzlegoober de Kim\'Jael, puis les lui rapporter en Azshara.‡搜索萨拉斯营地，找到基姆加尔的指南针、望远镜、烧鸡和花生，然后把它们交给艾萨拉的基姆加尔。‡搜索薩拉斯營地，尋找基姆加爾的指南針，望遠鏡，燒雞和花生，然後將它們交還給艾薩拉的基姆加爾。',
  }
},
[3602] = {
  {
    'Azsharita‡Азшарит‡Azsharit‡아즈샤리트‡Azsharita‡Azsharita‡Azsharite‡艾萨拉水晶‡艾薩拉水晶',
    nil,
    'Obtenha 20 Azsharitas Cristalizadas na região sul de Azshara. Use o Canisvil para farejar onde estão os depósitos que foram cuidadosamente escondidos.nnFale novamente com Loramus quando tiver cumprido essa tarefa.‡Найдите в южной Азшаре двадцать кристаллов азшарита. Вы можете использовать Гончих Скверны, которые помогут вам "вынюхивать" местонахождение хорошо сокрытых залежей. nnКогда задача будет завершена, возвращайтесь к Лорамусу Многоногу.‡Sammelt 20 kristallisierte Azsharite im südlichen Azshara. Ihr könnt den Teufelshund benutzen, damit er Euch beim \'Erschnüffeln\' der gut versteckten Ablagerungen behilflich ist.nnKehrt zu Loramus zurück, sobald Ihr die Aufgabe erfüllt habt.‡아즈샤라 남부 지역에서 결정화된 아즈샤리트 20개를 회수해야 합니다. 교묘하게 숨겨져 있는 아즈샤리트의 위치는 지옥사냥개에게 냄새를 맡게 해서 찾을 수 있습니다.‡Recupera 20 azsharitas cristalizadas del sur de Azshara. Puede que encuentres canes manáfagos dispuestos a ayudarte a rastrear la ubicación de los depósitos hábilmente escondidos.nnVuelve con Loramus cuando hayas completado la tarea.|n‡Recupera 20 azsharitas cristalizadas del sur de Azshara. Puede que encuentres canes manáfagos dispuestos a ayudarte a rastrear la ubicación de los depósitos hábilmente escondidos.|nVuelve con Loramus cuando hayas completado la tarea.‡Trouver 20 Azsharites cristallisées au sud d\'Azshara. Utiliser éventuellement le gangrechien pour \'renifler\' l\'emplacement où sont intelligemment cachés les dépôts.nnRetourner voir Loramus une fois votre tâche accomplie.‡在艾萨拉南部收集20块艾萨拉晶体。你可以使用地狱犬协助寻找一些隐藏的矿脉。nn任务完成之后就回到洛拉姆斯那里去。‡在艾薩拉南部收集20塊艾薩拉晶體。你可以使用惡魔犬協助尋找一些隱藏的礦脈。|n任務完成之後就回到洛拉姆斯那裡去。',
  }
},
[3621] = {
  {
    'A destruição vil‡Создание отравы Скверны‡Die Herstellung von Teufelsbann‡퇴마 무기 제작‡La formación de Felbane‡La formación de Aterravil‡La Formation de Felbane‡武器的铸造‡武器的鑄造',
    nil,
    'Leve o Carregamento para Galvan, o Antigo, na Selva do Espinhaço.‡Отнести груз Гальвану Древнему в Тернистую долину.‡Bringt die Lieferung zu Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 갈반에게 상자를 가져가야 합니다.‡Llévale el envío a Galvan el Antiguo en la Vega de Tuercespina.‡Llévale el envío a Galvan el Antiguo en la Vega de Tuercespina.‡Apporter la cargaison à Galvan l\'Ancien dans la vallée de Strangleronce.‡把货物交给荆棘谷的加尔文。‡把貨物交給荊棘谷的『長者』加爾文。',
  }
},
[3625] = {
  {
    'Armamento vil de aszharita encantada‡Зачарованное азшаритовое оружие, отравленное Скверной‡Verzauberte Azsharitteufelswaffe‡마력이 깃든 아즈샤리트 퇴마 무기‡Armas Fel en Azsharita encantada‡Armas Fel en Azsharita encantada‡Armes Fel en Azsharite enchantée‡魔化艾萨拉水晶武器‡附魔艾薩拉魔化武器',
    nil,
    'Aguarde enquanto Galvan termina de forjar o armamento.‡Подождите, пока Гальван закончит отковывать оружие.‡Wartet, bis Galvan die Waffen fertig geschmiedet hat.‡갈반이 무기를 다 만들 때까지 기다려야 합니다.‡Espera que Galvan acabe de forjar las armas.‡Espera que Galvan acabe de forjar las armas.‡Attendre que Galvan ait fini de forger les armes.‡等待加尔文为你锻造武器。‡等待加爾文為你鍛造武器。',
  }
},
[3626] = {
  {
    'Retorno à Barreira do Inferno‡Возвращение в Выжженные земли‡Rückkehr in die verwüsteten Lande‡저주받은 땅으로의 귀환‡El regreso a Las Tierras Devastadas‡Regresa a Las Tierras Devastadas‡Retour aux Terres foudroyées‡返回诅咒之地‡返回詛咒之地',
    nil,
    'Fale novamente com o Herói Caído da Horda.‡Вернитесь к павшему герою Орды.‡Kehrt zum Gefallenen Helden der Horde zurück.‡호드 영웅의 넋에게 돌아가야 합니다.‡Vuelve junto al Héroe caído de la Horda.‡Vuelve junto al héroe caído de la Horda en el Cruce Lanzarrota, en el Pantano de las Penas.‡Retourner voir le Héros de la Horde tombé au combat.‡回到部落英雄的灵魂那里。‡回到部落英雄的靈魂那裡。',
  }
},
[3627] = {
  {
    'Restaurando o amuleto estilhaçado‡Воссоединить расколотый амулет‡Das zerbrochene Amulett vereinen‡조각난 아뮬렛 재결합‡Juntar pedazos del amuleto‡Juntar pedazos del amuleto‡Réunir les morceaux de l\'Amulette brisée.‡收集破碎的护符‡收集破碎的護符',
    nil,
    'Mate Grol, o Destruidor, Lady Sevine e o Arquimago Allistarj. De seus corpos, pegue o Amuleto de Grol, o Amuleto de Sevine e o Amuleto de Allistarj.nnLembre-se de usar o Armamento Vil de Azsharita Encantada para enfraquecer a tríade, pois só assim eles podem ser derrotados... mas use-o com sabedoria.‡Убейте Грола Разрушителя, леди Севину и верховного мага Аллистария. С их трупов заберите Амулет Грола, Амулет Севины и Амулет Аллистария.nnПомните о том, что нужно использовать зачарованное азшаритовое оружие, отравленное Скверной, чтобы ослабить троицу! Их нельзя убить иначе – но используйте оружие разумно...‡Tötet Grol den Zerstörer, Lady Sevine und Erzmagier Allistarj. Nehmt das Amulett von Grol, das Amulett von Sevine und das Amulett von Allistarj von ihren Leichen.nnDenkt daran, Eure Verzauberte Azsharitteufelswaffe zu BENUTZEN, um die Triade zu schwächen. Auf eine andere Weise können sie nicht getötet werden - aber verwendet sie weise...‡파괴자 그롤, 여군주 세바인, 대마법사 알리스타즈를 해치우고 그들의 시체에서 그롤의 아뮬렛, 세바인의 아뮬렛, 알리스타즈의 아뮬렛을 회수해야 합니다.nn마력이 깃든 아즈샤리트 퇴마 무기를 사용하여 3인조의 힘을 약화시켜야 그들을 처치할 수 있다는 것을 명심하십시오. 반드시 현명하게 사용해야 합니다.‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres coge el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.nnAcuérdate de USAR tus armas Fel en Azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...‡Mata a Grol el Destructor, a Lady Sevine y al archimago Allistarj. De sus cadáveres coge el amuleto de Grol, el amuleto de Sevine y el amuleto de Allistarj.|nAcuérdate de USAR tus armas viles de azsharita encantada para debilitar a la tríade. Es la única forma de matarlos, pero úsalas con moderación...‡Assassiner Grol le Destructeur, dame Sevine et l\'archimage Allistarj. Prendre sur leurs cadavres l\'Amulette de Grol, l\'Amulette de Sevine et l\'Amulette d\'Allistarj.nnN\'oubliez pas d\'UTILISER vos armes gangrenées en azsharite enchantée pour affaiblir la triade (ils ne peuvent pas être tués autrement), mais faites-le sagement...‡杀掉毁灭者戈洛尔、瑟温妮，以及大法师奥利斯塔。从他们到尸体上拿到戈洛尔的护符、瑟温妮的护符和奥利斯塔的护符。nn记住使用你的魔化艾萨拉水晶武器来削弱他们，否则他们是无法被杀死的——你必须小心谨慎地使用你的武器......‡殺掉『毀滅者』戈洛爾、瑟溫妮女士，以及大法師奧利斯塔。從他們到屍體上拿到戈洛爾的護符、瑟溫妮的護符和奧利斯塔的護符。|n記住使用你的附魔艾薩拉魔化武器來削弱他們，否則他們是無法被殺死的─你必須小心謹慎地使用你的武器……',
  }
},
[3628] = {
  {
    'Você é Rakh\'likh, demônio‡Ты – Рах\'лих, демон!‡Ihr seid Rakh\'likh, Dämon‡악마 라크리크와의 대결‡Eres Rakh\'likh, demonio‡Eres Rakh\'likh, demonio‡Vous êtes Rakh\'likh, démon‡恶魔拉瑟莱克‡惡魔拉瑟萊克',
    nil,
    'Destrua Razelikh, o Profanador, e leve o Chifre Decepado de Profanador para o Herói Caído da Horda. Você também terá que devolver a Proteção do Profanador para que o Herói Caído a destrua, impedindo-a de cair em mãos erradas.‡Уничтожьте Разелиха Осквернителя и вернитесь к павшему герою Орды с отрубленным рогом Осквернителя. Вам также понадобится вернуть оберег Осквернителя, чтобы павший герой мог уничтожить его, дабы оберег не попал к тому, кто использует его во зло.‡Vernichtet Razelikh den Entweiher und bringt das abgetrennte Horn des Entweihers zum Gefallenen Helden der Horde. Ihr müsst außerdem den Zauberschutz des Entweihers mit zurückbringen, damit der Gefallene Held ihn zerstören und somit verhindern kann, dass er jemals in die falschen Hände fällt.‡파멸자 라젤리크를 해치우고 파멸자의 부러진 뿔을 호드 영웅의 넋에게 가져가야 합니다. 파멸자의 수호물도 호드 영웅의 넋에게 돌려주어 파괴하도록 해야 합니다. 그래야 사악한 자들의 손에 들어가는 것을 막을 수 있습니다.‡Destruye a Razelikh el Rapiñador y llévale el cuerno de Rapiñador cortado al Héroe caído de la Horda. También tendrás que devolver la Resguardo del Rapiñador para que el Héroe caído pueda destruirlo y así impedir que caiga en las manos equivocadas.|n‡Destruye a Razelikh el Rapiñador y llévale el cuerno de Rapiñador cortado al héroe caído de la Horda. También tendrás que devolver el Resguardo del Rapiñador para que el héroe caído pueda destruirlo y así impedir que caiga en las manos equivocadas.‡Détruire Razelikh le Souilleur et apporter la Corne brisée du Souilleur au Héros de la Horde tombé au combat. Rendre aussi l\'Amulette du Souilleur au Héros pour qu\'il puisse la détruire, afin de l\'empêcher de tomber dans de mauvaises mains.‡消灭污染者拉瑟莱克，将污染者之角交给部落英雄的灵魂。另外你还要把污染者防护结界交给他，这样部落英雄的灵魂就可以消灭它，以避免它落入邪恶势力之手。‡消滅『污染者』拉瑟萊克，將污染者之角交給部落英雄的靈魂。另外你還要把污染者防護結界交給他，這樣部落英雄的靈魂就可以消滅它，以避免它落入邪惡勢力之手。',
  }
},
[3629] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt das Handbuch der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Nixx Muellepiñón en Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage dans Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3630] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 배우고자 한다면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más sobre ingeniería gnoma, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3631] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca a un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan nos Sertões.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan im Brachland.‡불모의 땅에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Los Baldíos.‡Habla con Strahad Farsan en Los Baldíos.‡Parler à Strahad Farsan, dans les Tarides.‡与贫瘠之地棘齿城的斯坦哈德·法尔杉谈一谈。‡與貧瘠之地棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[3632] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 알고 싶으면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre el tema, llévale el Manual de disciplinas de ingeniería aI maestro manitas Sobrechispa a Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3633] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr etwas über die Gobliningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más cosas sobre la ingeniería de los goblins, lleva el Manual de disciplinas de ingeniería a Nixx Muellepiñón en Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan, en Tanaris.‡Pour en apprendre davantage sur l\'ingénierie gobeline, apporter le Manuel d\'Ingénierie à Nixx Elastirouage, à Gadgetzan.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3634] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser saber mais sobre a Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia até o Mestre-faz-tudo Superchispa, em Altaforja.‡Если вы хотите узнать больше о гномском инженерном деле, отнесите справочник по инженерным дисциплинам мехмастеру Замыкальцу в Стальгорн.‡Wenn Ihr etwas über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Tüftlermeister Oberfunks nach Eisenschmiede.‡노움 기계공학에 대해 더 알고 싶으면 아이언포지에 있는 수석땜장이 오버스파크에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Si quieres saber más sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería al maestro manitas Sobrechispa en Forjaz.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie au maître-artisan Suprétincelle, à Forgefer.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给铁炉堡的工匠大师欧沃斯巴克。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3635] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser aprender mais sobre Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia para Olhatorto Obnótico na Angra do Butim.‡Если вы хотите узнать побольше о гномском инженерном деле, возьмите справочник по инженерным дисциплинам и отнесите его Карлсу Пропеллерзу в Пиратскую Бухту.‡Wenn Ihr mehr über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Glotz Widrikus nach Beutebucht.‡노움 기계공학에 대해 더 알고 싶으면 무법항에 있는 오글소프 오브노티쿠스에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre ingeniería gnómica, llévale el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus de Bahía del Botín.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie à Orguignard Odipnoticus à Baie-du-Butin.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给藏宝海湾的奥格索普·奥布诺提斯。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3636] = {
  {
    'Trazer a luz‡Нести свет‡Das Licht bringen‡빛의 힘‡Trae la Luz‡Trae la Luz‡Apportez la Lumière‡与圣光同在‡與聖光同在',
    nil,
    'O Arcebispo Benedito quer que você mate Amnennar, o Frigífero, no Urzal dos Mortos.‡Убейте Амненнара Хладовея на Курганах Иглошкурых.‡Erzbischof Benedictus will, dass Ihr Amnennar den Kältebringer in den Hügeln der Klingenhauer tötet.‡대주교 베네딕투스가 가시덩굴 구릉에 있는 혹한의 암네나르를 처치해달라고 부탁했습니다.‡El Arzobispo Bendictus quiere que mates a Amnennar el Gélido en Zahúrda Rajacieno.‡El arzobispo Benedictus quiere que mates a Amnennar el Gélido en Zahúrda Rajacieno.‡Tuer Amnennar le Porte-froid, aux Souilles de Tranchebauge, pour l\'Archevêque Benedictus.‡大主教本尼迪塔斯要你去杀死剃刀高地的寒冰之王亚门纳尔。‡大主教本尼迪塔斯要你去殺死剃刀高地的『寒冰使者』亞門納爾。',
  }
},
[3637] = {
  {
    'Engenharia gnômica‡Гномское инженерное дело‡Gnomeningenieurskunst‡노움 기계공학‡Ingeniería gnómica‡Ingeniería gnómica‡Ingénierie des gnomes‡侏儒工程学‡地精工程學',
    nil,
    'Se quiser aprender mais sobre Engenharia Gnômica, leve o Manual das Disciplinas de Engenharia para Olhatorto Obnótico na Angra do Butim.‡Если вы хотите узнать побольше о гномском инженерном деле, возьмите справочник по инженерным дисциплинам и отнесите его Карлсу Пропеллерзу в Пиратскую Бухту.‡Wenn Ihr mehr über die Gnomeningenieurskunst erlernen wollt, dann bringt die Anleitung der Ingenieurskunstdisziplinen zu Glotz Widrikus nach Beutebucht.‡노움 기계공학에 대해 더 알고 싶으면 무법항에 있는 오글소프 오브노티쿠스에게 기계공학 설명서를 가져가야 합니다.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Si quieres aprender más cosas sobre ingeniería gnómica, lleva el Manual de disciplinas de ingeniería a Oglethorpe Obnoticus en Bahía del Botín.‡Pour en apprendre davantage sur l\'ingénierie gnome, apporter le Manuel d\'Ingénierie à Orguignard Odipnoticus à Baie-du-Butin.‡如果你想要对侏儒工程学有更多了解，就把工程学教材交给藏宝海湾的奥格索普·奥布诺提斯。‡如果你想要對地精工程學有更多瞭解，就把工程學教材交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3638] = {
  {
    'O pacto de sigilo‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡비밀유지서약서‡Compromiso de secreto perpetuo‡La promesa del secreto‡Le Vœu du secret‡保密协议‡保密協議',
    nil,
    'Se você concordar em se tornar <um engenheiro goblínico/uma engenheira goblínica>, clique com o botão direito no Pacto de Sigilo. Em seguida, fale novamente com Nixx Molapinhão em Geringontzan.‡Если вы согласны заниматься гоблинским инженерным делом, щелкните правой кнопкой мыши по Договору о неразглашении и еще раз обратитесь к Никсу Шепружину в Прибамбасске.‡Wenn Ihr ein Gobliningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Nixx Sprossfeder in Gadgetzan sprechen.‡고블린 기술자가 되는 데 동의하면 닉스의 비밀유지서약서를 마우스 오른쪽 단추로 클릭한 후 가젯잔에 있는 닉스 스프로켓스프링과 대화해야 합니다.‡Si quieres convertirte en <un ingeniero/una ingeniera> goblin, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Nixx Muellepiñón de Gadgetzan.‡Si decides dedicarte a la ingeniería goblin, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Nixx Muellepiñón de Gadgetzan.‡Pour devenir un Ingénieur gobelin, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore Nixx Elastirouage dans Gadgetzan.‡如果你同意成为一名地精技师，就右键点击保密协议，然后再次和加基森的尼克斯-斯普克斯宾谈一谈。‡如果你同意成為一名哥布林工程師，就右鍵點擊保密協議，然後再次和加基森的尼克斯·斯普克斯賓談話。',
  }
},
[3639] = {
  {
    'Mostrando trabalho‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tus creaciones‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Traga 20 Bombas Grandes de Ferro, 20 Dinamites Maciças e 5 Ovelhas Explosivas para Nixx Molapinhão em Geringontzan.‡Принесите 20 больших железных бомб, 20 шашек плотного динамита и 5 взрывоопасных овец Никсу Шепружину в Прибамбасск.‡Bringt 20 große Eisenbomben, 20 robuste Dynamitstangen und 5 explosive Schafe zu Nixx Sprossfeder nach Gadgetzan.‡가젯잔에 있는 닉스 스프링스프로켓에게 대형 철제 폭탄 20개, 조밀한 다이너마이트 20개, 그리고 양 폭탄 5개를 가져가야 합니다.‡Llévale 20 bombas grandes de hierro, 20 cartuchos de dinamita sólida y 5 ovejas explosivas a Nixx Muellepiñón de Gadgetzan.‡Llévale 20 bombas grandes de hierro, 20 cartuchos de dinamita sólida y 5 ovejas explosivas a Nixx Muellepiñón de Gadgetzan.‡Apporter 20 Grandes Bombes en fer, 20 Dynamites Solides et 5 Moutons Explosifs à Nixx Elastirouage dans Gadgetzan.‡将20颗重磅铁制炸弹、20颗实心炸弹和5只自爆绵羊交给加基森的尼克斯·斯普克斯宾。‡將20顆重磅鐵製爆裂物、20顆實心火藥和5隻自爆綿羊交給加基森的尼克斯·斯普克斯賓。',
  }
},
[3640] = {
  {
    'O pacto de sigilo‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡비밀유지 서약서‡La promesa del secreto‡La promesa del secreto‡Le Vœu du secret‡保密协议‡',
    nil,
    'Se concordar em se tornar <um engenheiro gnômico/uma engenheira gnômica>, clique com o botão direito no pacto de sigilo. Em seguida, fale novamente com o Mestre-faz-tudo Superchispa em Altaforja.‡Щелкните ПКМ по Договору о неразглашении и еще раз обратитесь к мехмастеру Замыкальцу в Стальгорне.‡Wenn Ihr ein Gnomeningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Tüftlermeister Oberfunks in Eisenschmiede sprechen.‡노움 기술자가 되는 데 동의하면 비밀유지서약서를 마우스 오른쪽 단추로 클릭해 서명을 한 후 아이언포지의 수석땜장이 오버스파크와 다시 한번 대화하십시오.‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho en el compromiso de secreto perpetuo y vuelve a hablar con el maestro manitas Sobrechispa en Forjaz.‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con el maestro manitas Sobrechispa en Forjaz.‡Pour devenir un Ingénieur gnome, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore le maître-artisan Suprétincelle, à Forgefer.‡如果你同意成为一名侏儒技师，就右键点击保密协议，然后再次和铁炉堡的工匠大师欧沃斯巴克谈一谈。‡',
  }
},
[3641] = {
  {
    'Mostre serviço‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tu trabajo‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Entregue 6 Tubos de Mithril, uma Mira de Precisão e 2 Bonecos-alvo Avançados para o Mestre-faz-tudo Superchispa, em Altaforja.‡Принесите 6 мифриловых трубок, точный прицел и 2 усовершенствованных манекена-мишени мехмастеру Замыкальцу в Стальгорн.‡Bringt 6 Mithrilrohre, 1 genaues Zielfernrohr und 2 hochentwickelte Zielattrappen zu Tüftlermeister Oberfunks in Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크에게 미스릴관 6개, 정밀한 조준경 1개, 그리고 고급 표적 허수아비 2개를 가져가야 합니다.‡Lleva 6 tubos de mitril, 1 escopo y 2 objetivos de prueba al maestro manitas Sobrechispa a Forjaz.‡Lleva 6 tubos de mitril, una mira de precisión y 2 muñecos-diana avanzados al maestro manitas Sobrechispa a Forjaz.‡Apporter 6 Tubes en mithril, 1 Lunette de précision et 2 Leurres perfectionnés au Maître artisan Suprétincelle à Forgefer.‡将6根秘银管、1只精确瞄准镜和2个高级假人交给铁炉堡的工匠大师欧沃斯巴克。‡將6根秘銀管、1個精確瞄準鏡和2個高級假人交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[3642] = {
  {
    'O pacto de sigilo‡Договор о неразглашении‡Der Schwur der Geheimhaltung‡비밀유지서약서‡La promesa del secreto‡La promesa del secreto‡Le Vœu du secret‡保密协议‡',
    nil,
    'Se concordar em se tornar <um Engenheiro Gnômico/uma Engenheira Gnômica>, clique com o botão direito no Pacto de Sigilo. Em seguida, fale novamente com Olhatorto Obnótico na Angra do Butim.‡Если вы согласны заниматься гномским инженерным делом, щелкните ПКМ по Договору о неразглашении и еще раз обратитесь к Карлсу Пропеллерзу в Пиратской Бухте.‡Wenn Ihr ein Gnomeningenieur werden wollt, dann müsst Ihr auf den Schwur der Geheimhaltung rechtsklicken und erneut mit Glotz Widrikus in Beutebucht sprechen.‡노움 기술자가 되는 데 동의하면 비밀유지서약서를 마우스 오른쪽 단추로 클릭한 후 무법항에 있는 오글소프 오브노티쿠스와 다시 한번 대화하십시오.‡Si quieres convertirte en <un ingeniero/una ingeniera> gnomo, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y vuelve a hablar con Oglethrope Obnoticus en la Bahía del Botín.‡Si decides dedicarte a la ingeniería gnómica, haz clic con el botón derecho del ratón en el compromiso de secreto perpetuo y habla de nuevo con Oglethrope Obnoticus en Bahía del Botín.‡Pour devenir un Ingénieur gnome, cliquer avec le bouton droit sur le Vœu de secret et retourner voir une fois encore Oglethrope Odipnoticus à Baie-du-Butin.‡如果你同意成为一名侏儒技师，就右键点击保密协议，然后再次和藏宝海湾的奥格索普-奥布诺提斯谈一谈。‡',
  }
},
[3643] = {
  {
    'Mostre serviço‡Покажи свою работу‡Zeigt Eure Arbeit‡직접 만든 물건‡Muestra tu trabajo‡Muestra tu trabajo‡Montrez votre travail‡工作成果‡工作成果',
    nil,
    'Leve 6 Tubos de Mithril, uma Mira de Precisão e 2 Bonecos-alvo Avançados a Olhatorto Obnótico, na Angra do Butim.‡Принесите 6 мифриловых трубок, точный прицел и 2 усовершенствованных манекена-мишени Карлсу Пропеллерзу в Пиратскую Бухту.‡Bringt 6 Mithrilrohre, 1 genaues Zielfernrohr und 2 hochentwickelte Zielattrappen zu Glotz Widrikus in Beutebucht.‡무법항에 있는 오글소프 오브노티쿠스에게 미스릴관 6개, 정밀한 조준경 1개, 고급 표적 허수아비 2개를 가져가야 합니다.‡Lleva 6 tubos de mitril, un escopo preciso y 2 muñecos-diana avanzados a Oglethorpe Obnoticus en la Bahía del Botín.‡Lleva 6 tubos de mitril, 1 mira de precisión y 2 muñecos-diana avanzados a Oglethorpe Obnoticus en la Bahía del Botín.‡Apporter 6 Tubes en mithril, 1 Lunette de précision et 2 Leurres perfectionnés à Orguignard Odipnoticus à Baie-du-Butin.‡将6根秘银管、1只精确瞄准镜和2个高级假人交给藏宝海湾的奥格索普·奥布诺提斯。‡將6根秘銀管、1個精確瞄準鏡和2個高級假人交給藏寶海灣的奧格索普·奧布諾提斯。',
  }
},
[3644] = {
  {
    'Renovação do cartão‡Продление членского билета‡Mitgliedskarten-Erneuerung‡회원권 갱신‡Renovación de la tarjeta de miembro‡Renovación de la tarjeta de miembro‡Le renouvellement de la Carte de membre‡会员卡续费‡會員卡續費',
    nil,
    '‡Чтобы продлить членский билет, тебе придется заплатить пошлину в размере двух золотых.‡Um Eure Mitgliedskarte zu erneuern, müsst Ihr die Erneuerungsgebühr in Höhe von zwei Goldstücken zahlen.‡회원권을 갱신하려면 갱신 비용으로 2골드를 내야 하오.‡Para renovar tu tarjeta de miembro tendrás que pagar las cuotas de renovación, que son dos piezas de oro.‡‡Pour renouveler votre carte de membre, vous devez vous acquitter du prix de renouvellement qui est de deux pièces d\'or.‡‡',
  }
},
[3645] = {
  {
    'Renovação do cartão‡Продление членского билета‡Mitgliedskarten-Erneuerung‡회원권 갱신‡Renovación de la tarjeta de miembro‡Renovación de la tarjeta de miembro‡Le renouvellement de la Carte de membre‡会员卡续费‡會員卡續費',
    nil,
    '‡Чтобы продлить членский билет, тебе придется заплатить пошлину в размере двух золотых.‡Um Eure Mitgliedskarte zu erneuern, müsst Ihr die Erneuerungsgebühr in Höhe von zwei Goldstücken zahlen.‡회원권을 갱신하려면 2골드를 갱신 비용으로 내야 합니다.‡‡‡Pour renouveler votre carte de membre, vous devez vous acquitter du prix de renouvellement qui est de deux pièces d\'or.‡‡',
  }
},
[3646] = {
  {
    'Renovação do cartão‡Продление членского билета‡Mitgliedskarten-Erneuerung‡회원권 갱신‡Renovación de la tarjeta de miembro‡Renovación de la tarjeta de miembro‡Le renouvellement de la Carte de membre‡会员卡续费‡會員卡續費',
    nil,
    '‡Чтобы продлить членский билет, тебе придется заплатить пошлину в размере двух золотых.‡Um Eure Mitgliedskarte zu erneuern, müsst Ihr die Erneuerungsgebühr in Höhe von zwei Goldstücken zahlen.‡‡‡‡Pour renouveler votre carte de membre, vous devez vous acquitter du prix de renouvellement qui est de deux pièces d\'or.‡‡',
  }
},
[3647] = {
  {
    'Renovação do cartão‡Продление членского билета‡Mitgliedskarten-Erneuerung‡회원권 갱신‡Renovación de la tarjeta de miembro‡Renovación de la tarjeta de miembro‡Le renouvellement de la Carte de membre‡会员卡续费‡會員卡續費',
    nil,
    '‡Чтобы продлить членский билет, вам придется заплатить два золотых в качестве пошлины за продление.‡Um Eure Mitgliedskarte zu erneuern, müsst Ihr die Erneuerungsgebühr in Höhe von zwei Goldstücken zahlen.‡회원권을 갱신하려면 2골드의 갱신 비용을 내야 합니다.‡In order to renew your membership card, you will need to pay the renewal fee of two gold pieces.‡‡Pour renouveler votre carte de membre, vous devez vous acquitter du prix de renouvellement qui est de deux pièces d\'or.‡‡',
  }
},
[3661] = {
  {
    'Protegidos de Eluna?‡Любимцы Элуны?‡Elunes Lieblinge?‡엘룬의 피조물‡¿Creados por Elune?‡¿Creados por Elune?‡Dans les faveurs d\'Elune ?‡月神之兽？‡月神之獸?',
    nil,
    'Pegue 15 Penas de Coruscante nas Terras Agrestes para Erelas Ambarcéu na Vila de Rut\'theran.‡Собрерите во Внутренних землях 15 перьев диких совухов и отнесите их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 15 Wildekinfedern aus dem Hinterland für Erelas Himmelsbern in Rut\'theran.‡에렐라스 앰버스카이에게 동부 내륙지에 있는 올빼미야수 깃털 15개를 가져가야 합니다.‡Recoge 15 plumas de lechúcico salvaje de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Recoge 15 plumas de lechúcico salvaje de las Tierras del Interior y llévaselas a Erelas Cieloámbar a la Aldea Rut\'theran.‡Collecter 15 Plumes d\'Indomptable dans les Hinterlands, pour Erelas Ambreciel au village de Rut\'theran.‡为鲁瑟兰村的艾瑞拉斯·琥珀收集15支枭兽羽毛。‡為魯瑟蘭村的艾瑞拉斯·琥珀收集15支梟獸羽毛。',
  }
},
[3681] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Разыщите в Штормграде Даториана Ралла и поговорите с ним.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화하십시오.‡Ve a Ventormenta y habla con Duthorian Rall.‡Ve a Ventormenta y habla con Duthorian Rall.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[3701] = {
  {
    'As fumegantes Ruínas de Thaurissan‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las humeantes Ruinas de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡索瑞森廢墟',
    nil,
    'Vá até as Ruínas de Thaurissan, nas Estepes Ardentes, e descubra informações sobre as Relíquias de Thaurissan. Fale novamente com a Historiadora Real Arquefilis quando terminar.‡Пойдите в руины Тауриссана в Пылающих степях и добудьте информацию из таурисанских реликвий. Вернитесь к королевскому историку Аркессону.‡Begebt Euch zu den Ruinen von Thaurissan in der brennenden Steppe und sammelt Informationen über die Relikte von Thaurissan. Kehrt zur königlichen Historikerin Archesonus zurück, wenn Ihr die Informationen besorgt habt.‡불타는 평원, 타우릿산의 폐허에 있는 타우릿산 유물에서 정보를 얻어야 합니다. 정보를 발견하면 왕실사학자 아케소누스에게 돌아가야 합니다.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa al historiador real Archesonus.‡Ve a las Ruinas de Thaurissan, en Las Estepas Ardientes, y recopila información sobre los tesoros de Thaurissan. Informa a la historiadora real Archesonus.‡Aller dans les ruines de Thaurissan, dans les Steppes ardentes. Récupérer des informations sur les Reliques de Thaurissan, puis retourner auprès de l\'Historienne royale Archesonus.‡到燃烧平原的索瑞森废墟中去，从索瑞森遗物上搜集信息。当你收集到足够的信息之后，就回到皇家历史学家阿克瑟努斯那里。‡到燃燒平原的索瑞森廢墟中去，從索瑞森聖物上搜集資訊。當你收集到足夠的資訊之後，就回到皇家歷史學家阿克瑟努斯那裡。',
  }
},
[3702] = {
  {
    'As fumegantes Ruínas de Thaurissan‡Дымящиеся руины Тауриссана‡Die glimmenden Ruinen von Thaurissan‡불타는 타우릿산의 폐허‡Las humeantes Ruinas de Thaurissan‡Las humeantes Ruinas de Thaurissan‡Les ruines fumantes de Thaurissan‡索瑞森废墟‡索瑞森廢墟',
    nil,
    'Escute a Historiadora Real Arquefilis recontar a história de Thaurissan.‡Узнайте от королевского историка Аркессона историю Тауриссана.‡Hört die Erzählung der königlichen Historikerin Archesonus über die Geschichte von Thaurissan.‡왕실사학자 아케소누스가 들려 주는 타우릿산의 역사를 들어야 합니다.‡Escucha al historiador real Archesonus relatar la historia de Thaurissan.‡Escucha a la historiadora real Archesonus relatar la historia de Thaurissan.‡Écouter l\'historienne royale Archesonus raconter l\'histoire de Thaurissan.‡听皇家历史学家阿克瑟努斯讲述索瑞森的历史。‡聽皇家歷史學家阿克瑟努斯講述索瑞森的歷史。',
  }
},
[3721] = {
  {
    'Um OOX para chamar de meu‡Собственный ККХ‡Ein eigener OOX‡선물로 받은 OOX‡Tu propio OOX‡Tu propio OOX‡Un OOX rien que pour vous‡你自己的OOX‡你自己的OOX',
    nil,
    '‡Тебе удалось выручить всех трех моих роботов серии ООХ! Ты сделал все, что требовалось и даже больше, поэтому я хочу особым образом отблагодарить тебя за помощь. Это миниатюрная версия того же робота, с которым ты провел так много времени и полюбил, ООХ!nnОбычно я никому не дарю такие опасные устройства, но ты оказал мне неоценимую помощь. Кроме того у этой тварюшки отключены боевые механизмы и устройство самонаведения.nnА в остальном это полноценный ООХ!‡Ihr habt drei meiner OOX-Leitroboter gefunden! Ihr habt viel mehr als das getan, worum ich Euch gebeten hatte. Daher will ich Euch etwas Besonderes für Eure Hilfe geben. Dies ist eine Miniaturversion jenes Roboters, den Ihr jetzt kennt und liebt, den OOX!nnIch würde normalerweise niemandem solch ein potenziell tödliches Gerät anvertrauen, aber Ihr wart eine wirklich große Hilfe. Außerdem wurden die Kampfmechanismen und die Leitlogik dieses Exemplars deaktiviert.nnAber abgesehen davon ist das ein echter OOX!‡당신은 내 OOX 유도 로봇 세 개를 되찾아 주었소! 기대했던 것 이상으로 수고를 해 주었으니 특별한 사례를 하겠소이다. 당신과 정이 들게 된 바로 그 닭... 아니 로봇, OOX를 소형으로 만들어 주리다!nn아무에게도 이렇게 치명적인 잠재력을 지닌 물건을 내준 적이 없지만 당신은 정말 큰 도움을 주었으니 예외로 하지. 게다가 이 축소판에는 전투 기능과 유도 기능이 해제되어 있고 말이야.nn그 외에는 모두 OOX 시리즈 로봇의 기능과 똑같소!‡¡Has recuperado tres de mis robots mensajeros OOX! Has hecho mucho más de lo que tenías que hacer, así que te daré algo especial por toda tu ayuda. Es una versión miniatura del robot que tan bien conoces, ¡el OOX!nnNormalmente, no dejaría que nadie tuviese un dispositivo tan potencialmente letal, pero tú has sido de gran ayuda. Además, el mecanismo de combate y las funciones de búsqueda de este robot están desactivados.nnPor todo lo demás, ¡es un OOX auténtico!‡‡Vous avez récupéré trois de mes robots guidés OOX ! Vous avez fait bien plus que le nécessaire, aussi vais-je vous donner quelque chose de spécial pour vous remercier. C\'est une version miniature du robot qu\'à présent vous devez connaître et aimer : l\'OOX !nnNormalement, je ne laisserais à personne un appareil aux capacités si dangereuses, mais vous m\'avez été d\'un réel secours. De plus, les mécanismes de combat et le système de guidage ont été mis hors service.nnMais il n\'en reste pas moins qu\'il s\'agit bien là d\'un OOX, bon sang !‡‡',
  }
},
[3741] = {
  {
    'Colar da Hilária‡Ожерелье Хилари‡Hilarys Halskette‡힐러리의 목걸이‡El collar de Hilary‡El collar de Hilary‡Le collier d\'Hilary‡希拉里的项链‡希拉蕊的項鍊',
    nil,
    'Encontre e devolva o Colar da Hilária na Vila Plácida.‡Найдите ожерелье Хилари и верните его Хилари в Приозерье.‡Sucht Hilarys Halskette und bringt sie Hilary in Seenhain zurück.‡힐러리의 목걸이를 찾아 레이크샤이어에 있는 힐러리에게 가져가야 합니다.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Encuentra el collar de Hilary y llévaselo a Villa del Lago.‡Trouver le Collier d\'Hilary et le rapporter à Hilary à Comté-du-Lac.‡找到希拉里的项链，将其还给湖畔镇的希拉里。‡找到希拉蕊的項鍊，將其還給湖畔鎮的希拉蕊。',
  }
},
[3761] = {
  {
    'Solo de Un\'Goro‡Почва Ун\'Горо‡Erde von Un\'Goro‡운고로 토양‡Tierra de Un\'Goro‡Tierra de Un\'Goro‡L\'humus d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras de Solo de Un\'Goro para Ghede no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Принесите 20 образцов земли из Кратера Ун\'Горо Геду на Вершину Старейшин Громового Утеса.‡Bringt 20 Erdproben von Un\'Goro zu Ghede auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프에 장로의 봉우리 있는 게드에게 운고로 토양 20개를 가져가야 합니다.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, que está en el Alto de los Ancestros de Cima del Trueno.‡Llévale 20 muestras de la tierra de Un\'Goro a Ghede, en el Alto de los Ancestros de Cima del Trueno.‡Apporter 20 Échantillons d\'humus d\'Un\'Goro à Ghede, aux Pitons du Tonnerre.‡收集20份安戈洛的泥土，把它们交给雷霆崖的格德。‡收集20份安戈洛的泥土，把它們交給雷霆崖長者高地的格德。',
  }
},
[3762] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Runatótem‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Runatótem en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Totem-runique aux Pitons du Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[3763] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡L\'aide à l\'archidruide Forteramure‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화하십시오.‡Ve a Darnassus y habla con el archidruida Fandral Corzocelada.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3764] = {
  {
    'Solo de Un\'Goro‡Почва Ун\'Горо‡Erde von Un\'Goro‡운고로 흙‡La tierra de Un\'Goro‡Tierra de Un\'Goro‡L\'humus d\'Un\'Goro‡安戈洛的泥土‡安戈洛的泥土',
    nil,
    'Leve 20 amostras do Solo de Un\'Goro para Jenal no Enclave Cenariano, que fica em Darnassus.‡Принесите 20 образцов земли из кратера Ун\'Горо Дженалю в дарнасский анклав Кенария.‡Bringt 20 Erdproben von Un\'Goro zu Jenal in der Enklave des Cenarius in Darnassus.‡다르나서스의 세나리온 자치령에 있는 제날에게 운고로 토양 20개를 가져가야 합니다.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, que está en el Enclave Cenarion de Darnassus.‡Lleva 20 muestras de tierra de Un\'Goro Soil a Jenal, en el Enclave Cenarion de Darnassus.‡Apporter 20 échantillons d\'Humus d\'Un\'Goro à Jenal dans l\'Enclave cénarienne à Darnassus.‡收集20份安戈洛的泥土，把它们交给达纳苏斯的耶纳尔。‡收集20份安戈洛的泥土，把它們交給達納蘇斯的耶納爾。',
  }
},
[3765] = {
  {
    'A corrupção estrangeira‡Проблема за морем‡Verderbnis in der Fremde‡먼 곳에 퍼진 타락‡Lejana corrupción‡Lejana corrupción‡La dépravation au loin‡遥远的旅途‡遙遠的旅途',
    nil,
    'Fale com Gershala Umbrurmúrio em Auberdine.‡Отправляйтесь в Аубердин к Гершалу Шепоту Ночи.‡Reist zu Gershala Nachtraunen in Auberdine.‡아우버다인에 있는 게르샬라 나이트위스퍼를 찾아가야 합니다.‡Ve a ver a Gershala Noctusurro en Auberdine.‡Ve a ver a Gershala Susurro Nocturno en Auberdine.‡Aller voir Gershala Murmenuit à Auberdine.‡到奥伯丁的戈沙拉·夜语那儿去。‡到奧伯丁的戈沙拉·夜語那兒去。',
  }
},
[3781] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Leve o Vale-sementes do arquidruida para Mathrengyl Ursivagus no Enclave Cenariano, que fica em Darnassus.‡Отнесите расписку верховного друида в получении семян Матренгилу Медвежьей Лапе в дарнасский анклав Кенария.‡Bringt den Samenkorngutschein des Erzdruiden zu Mathrengyl Bärenfährte in der Enklave des Cenarius des Darnassus.‡다르나서스의 세나리온 자치령에 있는 마스렌길 베어워커에게 대드루이드의 씨앗 교환권을 가져가야 합니다.‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Lleva el vale para semillas del archidruida a Mathrengyl Garroso al Enclave Cenarion de Darnassus.‡Apporter le Bon pour des graines de l\'archidruide à Mathrengyl Pasdelours dans l\'Enclave cénarienne à Darnassus.‡将大德鲁伊的草种购买券交给达纳苏斯城塞纳里奥区的玛斯雷·驭熊者。‡將大德魯伊的草種購買券交給達納蘇斯城塞納里奧區的瑪斯雷·馭熊者。',
  }
},
[3782] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡La recherche sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Leve o Vale-sementes para Bashana Runa Totem no Penhasco do Trovão.‡Отнесите расписку в получении семян Башане Рунический Тотем в Громовой Утес.‡Bringt den Samenkorngutschein zu Bashana Runentotem in Donnerfels.‡썬더 블러프에 있는 바샤나 룬토템에게 씨앗 교환권을 가져가야 합니다.‡Llévale este vale para semillas a Bashana Runatótem, que está en Cima del Trueno.‡Llévale este vale para semillas a Bashana Tótem de Runa en Cima del Trueno.‡Apporter le Bon pour des graines à Bashana Totem-runique aux Pitons du Tonnerre.‡将草种购买券交给雷霆崖的巴珊娜·符文图腾。‡將草種購買券交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[3783] = {
  {
    'Eu yeti falar uma coisa...‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡Yeti... ¿ya hemos llegado?‡Yeti... ¿ya hemos llegado?‡Yéti ? Y es-tu ?‡雪怪计划！‡雪怪計畫!',
    nil,
    'Colete 10 Peles Grossas de Yeti para Umi Zombarruga em Visteterna.‡Соберите 10 толстых кусков меха йети для Уми Смехотреп из Круговзора.‡Sammelt 10 dicke Yetifelle für Umi Rumpelkicher in der Ewigen Warte.‡두꺼운 설인 모피 10개를 모아 눈망루 마을에 있는 우미 럼플스니커에게 가져가야 합니다.‡Reúne 10 pelajes de yeti gruesos para Umi Risitas en Vista Eterna.‡Reúne 10 pelajes de yeti gruesos para Umi Risitas en Vista Eterna.‡Collecter 10 Fourrures épaisses de yéti pour Umi Sarcafroisse, à Long-guet.‡为永望镇的乌米收集10张厚雪人毛皮。‡為永望鎮的烏米收集10張厚雪人毛皮。',
  }
},
[3784] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Runatótem‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Runatótem en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Totem-runique aux Pitons du Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[3785] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.nnLeve 10 Grãos-matinais para Mathrengyl Ursivagus em Darnassus.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций земли Ун\'Горо попытайтесь прорастить рассветницу.nnПринесите 10 рассветниц Матренгилу Медвежьей Лапе в Дарнасс.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Erdproben von Un\'Goro, um Morgenkorn zu kultivieren.nnBringt 10 Einheiten Morgenkorn zu Mathrengyl Bärenfährte in Darnassus.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.nn다르나서스에 있는 마스렌길 베어워커에게 여명초 10개를 가져가야 합니다.‡Utiliza una faltriquera de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana. nnLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliza una faltriquera de siempreverde con 1 paquete de semillas de Tharlendris y 2 muestras de tierra de Un\'Goro para intentar cultivar mañagrana.|nLleva 10 plantas de mañagrana a Mathrengyl Garroso a Darnassus.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendis et deux Echantillons d\'Humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.nnApporter 10 Fibres d\'aurore à Mathrengyl Bearwalker à Darnassus.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。nn将10株晨光麦交给达纳苏斯的玛斯雷·驭熊者。‡用一個常青袋、一包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n將10株晨光麥交給達納蘇斯的瑪斯雷·馭熊者。',
  }
},
[3786] = {
  {
    'Pesquisa de grão-matinal‡Изучение рассветницы‡Morgenkornforschung‡여명초 연구‡Investigar la mañagrana‡Investigar la mañagrana‡Recherches sur la Fibre d\'aurore‡晨光麦研究‡晨光麥研究',
    nil,
    'Use o Bornal de Sempre-viva com um pacote de Sementes de Tharlendis e duas amostras de Solo de Un\'Goro para tentar cultivar mudas de grão-matinal.nnLeve 10 Grãos-matinais para Bashana Runa Totem no Penhasco do Trovão.‡При помощи сумы вечного цветения, пакетика семян Тарлендриса и двух порций земли Ун\'Горо попытайтесь прорастить рассветницу.nnПринесите 10 рассветниц Башане Рунический Тотем в Громовой Утес.‡Benutzt einen Immergrünbeutel mit einem Paket Tharlendrissamenkörner sowie zwei Erdproben von Un\'Goro, um Morgenkorn zu kultivieren.nnBringt 10 Einheiten Morgenkorn zu Bashana Runentotem in Donnerfels.‡탈렌드리스 씨앗 꾸러미와 늘푸른 주머니를 운고로 토양 2개에 사용하여 여명초 견본을 재배하십시오.nn썬더 블러프에 있는 바샤나 룬토템에게 여명초 10개를 가져가야 합니다.‡Mete en la bolsa de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.nnLlévale 10 mañagranas a Bashana Runatótem, que está en Cima del Trueno.‡Mete en la faltriquera de siempreverde un paquete de Tharlendris y dos muestras de tierra de Un\'Goro para cultivar muestras de mañagrana.|nLlévale 10 mañagranas a Bashana Tótem de Runa, que está en Cima del Trueno.‡Utiliser une Sacoche de printemps avec une pochette de graines de Tharlendis et deux Echantillons d\'Humus d\'Un\'Goro pour essayer de cultiver des Fibres d\'aurore.nnApporter 10 Fibres d\'aurore à Bashana Runetotem à Thunder Bluff.‡用一个常青袋、一包萨伦迪斯种子以及两份安戈洛的泥土来尝试种植晨光麦。nn将10株晨光麦交给雷霆崖的巴珊娜·符文图腾。‡用一個常青袋、一包薩倫迪斯種子以及兩份安戈洛的泥土來嘗試種植晨光麥。|n將10株晨光麥交給雷霆崖的巴珊娜·符文圖騰。',
  }
},
[3787] = {
  {
    'O pedido de Jonespyre‡Кинтис Пламень‡Lebenshands Bitte‡존스피레의 요청‡La petición de Jonguja‡La petición de Jonguja‡La requête de Gentecime‡奎恩提斯的请求‡奎恩提斯的請求',
    nil,
    'Fale com Quintis Jonespyre no Domínio de Plumaluna.‡Поговорите с друидом по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Sprecht mit Quintis Lebenshand in der Mondfederfeste.‡페더문 요새에 있는 쿠인티스 존스피레와 대화해야 합니다.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Gentecime dans le bastion de Pennelune.‡与羽月要塞的奎恩提斯谈一谈。‡與羽月要塞的奎恩提斯談話。',
  }
},
[3788] = {
  {
    'O pedido de Jonespyre‡Кинтис Пламень‡Lebenshands Bitte‡존스피레의 요청‡La petición de Jonguja‡La petición de Jonguja‡La requête de Gentecime‡奎恩提斯的请求‡奎恩提斯的請求',
    nil,
    'Fale com Quintis Jonespyre no Domínio de Plumaluna.‡Поговорите с друидом по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Sprecht mit Quintis Lebenshand in der Mondfederfeste.‡페더문 요새에 있는 쿠인티스 존스피레와 대화하십시오.‡Habla con Quintis Jonguja del Bastión Plumaluna.‡Habla con Quintis Jonguja en el Bastión Plumaluna.‡Parler à Quintis Gentecime dans le bastion de Pennelune.‡与羽月要塞的奎恩提斯谈一谈。‡與羽月要塞的奎恩提斯談話。',
  }
},
[3789] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Staghelm‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3790] = {
  {
    'Auxílio ao Arquidruida Guenelmo‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스테그헬름 돕기‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡Assister l\'archidruide Staghelm‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화하십시오.‡Habla con el archidruida de Darnassus, Fandral Corzocelada.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[3791] = {
  {
    'O mistério do grão-matinal‡Тайна рассветницы‡Das Geheimnis des Morgenkorns‡여명초의 비밀‡El misterio de mañagrana‡El misterio de mañagrana‡Le Mystère des Fibres d\'aurore‡晨光麦的秘密‡晨光麥的秘密',
    nil,
    'Leve 10 Grãos-matinais para Quintis Jonespyre no Domínio de Plumaluna.‡Принесите 10 рассветниц друиду по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Bringt 10 Einheiten Morgenkorn zu Quintis Lebenshand in der Mondfederfeste.‡페더문 요새에 있는 쿠인티스 존스피레에게 여명초 10개를 가져가야 합니다.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Lleva 10 plantas de mañagrana a Quintis Jonguja al Bastión Plumaluna.‡Apporter 10 Fibres d\'aurore à Quintis Jonespyre au bastion de Feathermoon.‡将10株晨光麦交给羽月要塞的奎恩提斯。‡將10株晨光麥交給羽月要塞的奎恩提斯。',
  }
},
[3792] = {
  {
    'Grãos-matinais para o Domínio de Plumaluna‡Рассветница для Крепости Оперенной Луны‡Morgenkorn für die Mondfederfeste‡페더문 요새로 여명초 가져가기‡Mañagrana a Bastión Plumaluna‡Mañagrana a Bastión Plumaluna‡De la Fibre d\'aurore au bastion de Feathermoon‡羽月要塞的晨光麦‡羽月要塞的晨光麥',
    nil,
    '‡А, здравствуйте, Серыйаскет! Мои исследования продвигаются неплохо, но, если у вас найдется еще пять рассветниц, я бы с удовольствием их у вас приобрел. Хотя, конечно, с удовольствием – это только фигура речи: чем больше я имею с нею дело, тем сильнее мне не по себе. И тем не менее я не намерен отказываться от дальнейших экспериментов!‡Abermals hallo, <Name>. Meine Forschung macht gute Fortschritte, aber wenn Ihr fünf weitere Einheiten Morgenkorn habt, würde ich Euch die sehr gern abnehmen. Na ja... \'gern\' ist nicht wirklich der richtige Ausdruck dafür; je länger ich mich in seiner Umgebung befinde, desto unwohler fühle ich mich. Aber für meine Forschungen ist es nun mal nötig, dass ich mich zusammenreiße und weiterarbeite.‡또 보는군. 내 연구는 순조롭게 진행 중이오. 하지만 여명초 5개만 더 있다면 정말 기쁠 것 같소. 뭐, 기뻐한다는 건 일종의 은유적인 표현이지. 곁에 오래 두면 둘수록 기분이 더 언짢아져서 말이오. 하지만 꾹 참고 이 연구를 끝내야만 하오.‡‡‡Je vous salue à nouveau, <nom>. Mes recherches progressent plutôt bien, mais si vous aviez cinq Fibres d\'aurore supplémentaires, je serais heureux de vous en débarrasser. Mais “heureux” n\'est qu\'une figure de style. Plus j\'en ai autour de moi, et plus je me sens mal à l\'aise. Mes recherches nécessitent cependant que je me hâte et que j\'en finisse.‡‡',
  }
},
[3801] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠단 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Fale com Franclorn Forjífice se tiver interesse em obter uma chave para a parte principal da cidade.‡Чтобы получить ключ от города, поговорите с Франклорном Искусником.‡Sprecht mit Franclorn Schmiedevater, wenn Ihr daran interessiert seid, einen Schlüssel für die Hauptstadt zu erhalten.‡도시 주요 지역으로 통하는 열쇠를 얻고 싶다면 프랑클론 포지라이트와 대화하십시오.‡Habla con Franclorn Forjador si te interesa obtener una llave de la ciudad.‡Habla con Franclorn Forjador en la Tumba de Forjador, en la Montaña Roca Negra, si te interesa obtener una llave de la ciudad.‡Parler à Franclorn Le Forgebusier si obtenir une clé de la Cité majeure vous intéresse.‡如果你想要得到进入这座城市主城区的钥匙，就去和弗兰克罗恩·铸铁谈一谈。‡如果你想要得到進入這座城市主城區的鑰匙，就去和弗蘭克羅恩·鑄鐵談話。',
  }
},
[3802] = {
  {
    'Legado dos Ferro Negro‡Наследие Черного Железа‡Dunkeleisenerbe‡검은무쇠단 유물‡El legado de los Hierro Negro‡El legado de los Hierro Negro‡Héritage Sombrefer‡黑铁的遗产‡黑鐵的遺產',
    nil,
    'Mate Fineous Forçanegra e recupere o grande martelo Ferrovil. Leve-o para o Santuário de Thaurissan e coloque-o na estátua de Franclorn Forjífice.‡Убейте Финия Темностроя и добудьте великий молот, Железный Друг. Отнесите Железного Друга в святилище Тауриссана и вложите его в руки статуи Франклорна Искусника.‡Erschlagt Fineous Dunkelader und bergt den großen Hammer Eisenhölle. Bringt Eisenhölle zum Schrein von Thaurissan und legt ihn auf die Statue von Franclorn Schmiedevater.‡파이너스 다크바이어를 처치하고 거대한 망치, 무쇠지옥을 회수해야 합니다. 무쇠지옥을 타우릿산의 제단으로 가져가서 프랑클론 포지라이트의 석상에 두어야 합니다.‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.|n‡Mata a Finoso Virunegro y recupera el gran martillo, Ferrovil. Lleva a Ferrovil al Santuario de Thaurissan y coloca el martillo en la estatua de Franclorn Forjador.‡Tuer Fineous Sombrevire et récupérer le grand marteau, Souillefer. Apporter Souillefer au sanctuaire de Thaurissan et le placer sur la statue de Franclorn Le Forgebusier.‡杀掉弗诺斯·达克维尔并拿回战锤铁胆。把铁胆之锤拿到索瑞森神殿去，将其放在弗兰克罗恩·铸铁的雕像上。‡殺掉弗諾斯·達克維爾並拿回戰錘鐵膽。把鐵膽之錘拿到索瑞森神殿去，將其放在弗蘭克羅恩·鑄鐵的雕像上。',
  }
},
[3803] = {
  {
    'Grãos-matinais para Darnassus‡Рассветница для Дарнасса‡Morgenkorn nach Darnassus‡다르나서스로 여명초 가져가기‡Mañagrana para Darnassus‡Mañagrana para Darnassus‡De la fibre d\'aurore pour Darnassus‡达纳苏斯的晨光麦‡達納蘇斯的晨光麥',
    nil,
    '‡Верховному друиду постоянно не хватает рассветницы для проведения исследований Круга Кенария. Мы принимаем ее партиями по десять пучков и в награду даем несколько полезных вещей. Когда соберешь десять пучков, сообщи мне, и я достойно награжу тебя.‡Der Erzdruide sucht ständig nach mehr Morgenkorn für die weiteren Forschungsarbeiten des Zirkels des Cenarius. Wir nehmen jeweils zehn Einheiten ab und belohnen Euch mit umfangreichen Dingen, die Ihr nützlich finden werdet. Wenn Ihr zehn Einheiten habt, lasst es mich wissen, und ich werde Euch entsprechend belohnen.‡대드루이드께서는 세나리온 의회에서 진행 중인 연구에 사용할 여명초를 항상 찾고 계십니다. 한번에 10개씩 받는데, 가져온 이에게는 유용한 물건으로 보상해 주고 있어요. 10개를 구할 때마다 내게 알려 주면 그에 맞는 보상을 해드리지요.‡‡‡L\'archidruide cherche davantage de Fibres d\'aurore pour que le Cercle cénarien puisse poursuivre ses recherches. Nous les prenons par lot de dix. Nous récompenserons votre cueillette par des objets qui pourront être utiles. Lorsque vous en aurez dix, faites-le-moi savoir et je vous récompenserai en conséquence.‡‡',
  }
},
[3804] = {
  {
    'Grãos-matinais para o Penhasco do Trovão‡Рассветница для Громового Утеса‡Morgenkorn nach Donnerfels‡썬더 블러프로 여명초 가져가기‡Mañagrana para Cima del Trueno‡Mañagrana para Cima del Trueno‡Des Fibres d\'aurore pour les Pitons du Tonnerre‡雷霆崖的晨光麦‡雷霆崖的晨光麥',
    nil,
    '‡Верховный друид постоянно ищет дополнительные источники рассветницы для исследовательского проекта Круга Кенария в Кратере Ун\'Горо. Мы берем их партиями по десять штук и в награду даем несколько полезных вещей. Когда наберешь десять штук, сообщи мне, и я достойно награжу тебя.‡Der Erzdruide sucht ständig nach mehr Morgenkorn für das Forschungsprojekt des Zirkels des Cenarius über den Un\'Goro Krater. Wir nehmen jeweils zehn Einheiten ab und belohnen Euch mit umfangreichen Dingen, die Ihr nützlich finden werdet. Wenn Ihr zehn Einheiten habt, lasst es mich wissen, und ich werde Euch entsprechend belohnen.‡대드루이드님께서는 세나리온 의회의 운고로 분화구에 대한 연구에 쓸 여명초를 항상 찾고 계세요. 한 번에 10개씩 받는데, 가져온 이에게는 유용한 물건으로 보상해 주고 있답니다. 10개를 구할 때마다 제게 알려 주면 그에 맞게 보상해 드리겠어요.‡El archidruida siempre está buscando mañagrana para el proyecto de investigación sobre el Cráter de Un’Goro que lleva a cabo el Círculo Cenarion. La recogemos en lotes de 10 y recompensamos a quien la trae con un conjunto de objetos muy útiles. Si reúnes 10 plantas de mañagrana, tráemelas y te daré tu recompensa.‡‡L\'archidruide cherche davantage de Fibre d\'aurores pour que le Cercle cénarien puisse poursuivre ses recherches sur le cratère d\'Un\'Goro. Nous récompenserons votre cueillette par des objets qui pourront être utiles. Lorsque vous en aurez dix, faites-le-moi savoir et je vous récompenserai en conséquence.‡‡',
  }
},
[3821] = {
  {
    'Rochedo Malhorrendo‡Скала Молота Ужаса‡Schreckensfels‡우레망치 바위굴‡Roca Machacamiedo‡Roca Machacamiedo‡Le Rocher des Cognepeurs‡巨槌石‡巨槌石',
    nil,
    'Explore as Estepes Ardentes e descubra o que aconteceu com Sha\'ni Altapresa.‡Отправляйтесь в Пылающие степи и выясните, что сталось с Ша\'ни Гордым Клыком.‡Begebt Euch in die brennende Steppe und findet heraus, was aus Sha\'ni Ehrenhauer geworden ist.‡불타는 평원으로 가서 샤니 프라우드터스크에게 무슨 일이 있었는지 확인해야 합니다.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmorgullo.‡Adéntrate en Las Estepas Ardientes y averigua qué le ha ocurrido a Sha\'ni Colmillo Orgulloso.‡S\'aventurer dans les Steppes ardentes et découvrir ce qu\'il est advenu de Sha\'ni Fière-défense.‡到燃烧平原去找到沙妮·长齿。‡到燃燒平原去找到沙妮·長齒。',
  }
},
[3822] = {
  {
    'Krom\'Grul‡Кром\'Грул‡Krom\'Grul‡크롬그룰‡Krom\'Grul‡Krom\'Grul‡Krom\'Grul‡克罗格鲁尔‡克羅格盧爾',
    nil,
    'Recupere a Argola Nasal de Sha\'ni de Krom\'Grul e leve-a para Thal\'trak em Karrath. Procure nas várias cavernas e minas do Rochedo Malhorrendo.‡Заберите ноздревое кольцо Ша\'ни у Кром\'Грула и верните его Тал\'траку из Каргата. Обыщите различные пещеры и рудники скалы Молота Ужаса.‡Holt Sha\'nis Nasenring von Krom\'Grul zurück und bringt ihn zu Thal\'trak in Kargath. Durchsucht die verschiedenen Höhlen und Minen im Schreckensfels.‡크롬그룰에게서 샤니의 코걸이를 찾아 카르가스에 있는 탈트라크에게 가져가야 합니다. 우레망치 바위굴에 있는 여러 광산과 동굴을 찾아봐야 합니다.‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.|n‡Recupera el aro de la nariz de Sha\'ni de Krom\'Grul y llévasela a Thal\'trak en Kargath. Busca por las diferentes cuevas y minas de la Roca Machacamiedo.‡Récupérer l\'Anneau de nez de Sha\'ni sur Krom\'Grul, et le rapporter à Thal\'trak, à Kargath. Fouiller les différentes grottes et mines du Rocher des Cognepeurs.‡从克罗格鲁尔手中拿回沙妮的鼻环，把它还给卡加斯的萨特拉克。搜寻巨槌石的每一处山洞和矿井。‡從克羅格盧爾手中拿回沙妮的鼻環，把它還給卡加斯的薩特拉克。搜尋巨槌石的每一處山洞和礦坑。',
  }
},
[3823] = {
  {
    'Extinção dos Pirobuchos‡Угасание Огненного Чрева‡Die Feuermagenoger auslöschen‡불자루일족 오우거 처치‡El exterminio de los Pirontraña‡El exterminio de los Pirontraña‡Exterminer les Brûlentrailles‡消灭火腹食人魔‡消滅火腹巨魔',
    nil,
    'Mate 15 Ogros-magos Pirobucho, 7 Ogros Pirobucho e 7 Brutamontes Ogros Pirobucho e fale novamente com Oralius quando terminar.‡Убейте 15 огров-магов, 7 огров и 7 громил из клана Огненного Чрева. По выполнении задания вернитесь к Орелиусу.‡Tötet 15 Ogermagier der Feuermägen, 7 Oger der Feuermägen sowie 7 Schläger der Feuermägen und kehrt zu Oralius zurück, wenn Ihr fertig seid.‡불자루일족 오우거마법사 15마리, 불자루일족 오우거 7마리, 불자루일족 투사 7마리를 처치한 후 랄리우스에게 돌아가야 합니다.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña y vuelve junto a Oralius cuando hayas acabado.‡Mata a 15 magos ogros Pirontraña, 7 ogros Pirontraña y 7 ogros toscos Pirontraña.‡Tuer 15 Ogres-mages Brûlentrailles, 7 Ogres Brûlentrailles et 7 Brutes Brûlentrailles, puis retourner voir Oralius.‡杀掉15个火腹食人魔法师、7个火腹食人魔和7个火腹蛮兵，完成任务之后向奥拉留斯报告。‡殺掉15個火腹巨魔法師、7個火腹巨魔和7個火腹蠻卒，完成任務之後向奧拉留斯報告。',
  }
},
[3824] = {
  {
    'Gor\'tesh, o lorde dos brutamontes‡Гор\'теш Жестокий‡Gor\'tesh der Schläger-Lord‡포악한 군주 고르테쉬‡Gor\'tesh, el Señor de los toscos‡Gor\'tesh, el Señor de los toscos‡Le seigneur-brute Gor\'tesh‡蛮王戈泰什‡蠻王戈泰什',
    nil,
    'Encontre Gor\'tesh em algum lugar a oeste do Rochedo Malhorrendo. Mate Gor\'tesh e depois leve a Cabeça Decepada do Gor\'tesh de volta a Oralius nas Estepes Ardentes.‡Найдите Гор\'теша на западе от скалы Молота Ужаса. Убейте Гор\'теша и отнесите его голову Орелиусу в Пылающие степи.‡Sucht Gor\'tesh irgendwo im Westen des Schreckensfelsens. Tötet Gor\'tesh und bringt dann seinen abgehackten Kopf zu Oralius in der brennenden Steppe zurück.‡우레망치 바위굴의 서쪽 어딘가에서 고르테쉬를 찾아 처치하고 고르테쉬의 가면을 얻어 불타는 평원에 있는 랄리우스에게 가져가야 합니다.‡Encuentra a Gor\'tesh, en el algún lugar al oeste de la Roca Machacamiedo. Mata a Gor\'tesh y llévale entonces la cabeza cortada de Gor\'tesh a Oralius en Las Estepas Ardientes.|n‡Recoge la cabeza cortada de Gor\'tesh.‡Trouver Gor\'tesh, quelque part à l\'ouest du rocher des Cognepeurs. Le tuer et rapporter la Tête coupée de Gor\'tesh à Oralius, dans les Steppes ardentes.‡找到戈泰什，他应该在巨槌石西面的某处。杀掉戈泰什并把他的头颅交给燃烧平原的奥拉留斯。‡找到戈泰什，他應該在巨槌石西面的某處。殺掉戈泰什並把他的頭顱交給燃燒平原的奧拉留斯。',
  }
},
[3825] = {
  {
    'A festa da cabeça cortada‡Голова огра на палочке = вечеринка‡Ogerkopf auf einem Pfahl = Party‡창에 꽂은 오우거 가면‡Una cabeza ogro empalada = FIESTA‡Una cabeza ogro empalada = FIESTA‡Une tête d\'ogre au bout d\'une pique = une fête‡枭首示众‡梟首示眾',
    nil,
    'Pegue a Cabeça Decepada do Gor\'Tesh e coloque no topo do Rochedo Malhorrendo. Procure um montinho de terra macia para espetar a estaca.‡Отнесите голову Гор\'теша на вершину скалы Молота Ужаса. Поищите кучу рыхлой земли и воткните в нее пику.‡Nehmt Gor\'teshs abgehackten Kopf und platziert ihn auf dem Gipfel des Schreckensfelsens. Sucht nach einem weichen Erdhügel, um den Pfahl aufzustellen.‡고르테쉬의 가면을 가지고 가서 우레망치 바위굴의 꼭대기에 꽂아야 합니다. 창을 꽂을 부드러운 흙으로 덮인 고분을 찾도록 하십시오.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Coge la cabeza cortada de Gor\'tesh y colócala en lo alto de la Roca Machacamiedo. Busca un montículo de tierra blanda para clavar la pica.‡Prendre la Tête coupée de Gor\'tesh et la placer au sommet du Rocher des Cognepeurs. Chercher un monticule de terre meuble pour planter la pique.‡把戈泰什的头颅放在巨槌石的山顶上。找一块软土堆把串着头颅的长矛插上去就可以了。‡把戈泰什的頭顱放在巨槌石的山頂上。找一塊軟土堆把串著頭顱的長矛插上去就可以了。',
  }
},
[3841] = {
  {
    'Um órfão em busca de um lar‡Бездомный сиротка‡Waise sucht Zuhause‡집을 찾고 있는 고아‡Un huérfano que busca un hogar‡Un huérfano que busca un hogar‡Un orphelin à la recherche d\'un foyer‡领养孤儿‡領養孤兒',
    nil,
    'Fale com Quentin em Mil Agulhas.‡Поговорите с Квентином в Тысяче Игл.‡Sprecht mit Quentin in Tausend Nadeln.‡버섯구름 봉우리에 있는 켄튼과 대화해야 합니다.‡Ve a Las Mil Agujas y habla con Quentin.‡Ve a Las Mil Agujas y habla con Quentin.‡Parler à Quentin aux Mille pointes.‡与千针石林的奎恩丁谈一谈。‡與千針石林的奎恩丁談話。',
  }
},
[3842] = {
  {
    'Uma incubação curta‡Инкубатор‡Kurz vor dem Schlüpfen‡짧은 부화‡Una corta incubación‡Una corta incubación‡Une courte incubation‡即将孵化‡即將孵化',
    nil,
    'Entregue 2 Elixires de Fortitude para Quentin em Mil Agulhas.‡Принесите 2 эликсира стойкости Квентину в Тысячу Игл.‡Bringt 2 Elixiere der Seelenstärke zu Quentin in Tausend Nadeln.‡버섯구름 봉우리에 있는 켄튼에게 인내의 비약 2개를 가져가야 합니다.‡Lleva 2 elixires de entereza a Quentin a Las Mil Agujas.‡Lleva 2 elixires de entereza a Quentin a Las Mil Agujas.‡Apporter 2 Elixirs de Robustesse à Quentin, aux Mille pointes.‡将2份坚韧药剂交给千针林的奎恩丁。‡將2份堅韌藥劑交給千針石林的奎恩丁。',
  }
},
[3843] = {
  {
    'O mais novo integrante da família‡Новый член семьи‡Das neueste Mitglied der Familie‡새로운 가족의 탄생‡Un nuevo miembro en la familia‡Un nuevo miembro en la familia‡Un tout nouveau membre dans la famille‡新的生命‡新生之雛',
    nil,
    'Leve o Ovo Frágil de Dardejante às Terras Agrestes e fale com Agnar Domaferas, mas corra, você só tem uma hora para encontrá-lo antes que o filhote dentro do ovo morra.‡Отнесите хрупкое яйцо летучего хамелеона во Внутренние земли и поговорите с Агнаром Зверопасом. У вас есть на это всего 1 час. В противном случае детеныш в яйце умрет.‡Bringt Euer empfindliches Grimmlingflitzerei ins Hinterland und sprecht mit Agnar Tiermeister, aber beeilt Euch. Ihr habt nur eine Stunde Zeit, ihn zu finden. Dann stirbt das Jungtier in dem Ei.‡동부 내륙지로 깨지기 쉬운 화살요정용 알을 가져가서 아그나르 비스테이머와 대화하십시오. 1시간 내에 아그나르를 찾지 못하면 알 속의 새끼가 죽게 되니 서둘러야 합니다.‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Lleva tu huevo de duende dardo frágil a las Tierras del Interior y habla con Agnar Domabestias, pero date prisa: si tardas más de 1 hora en encontrarlo, la cría que hay en el huevo morirá.‡Emmenez votre Oeuf fragile de Fée fléchetteuse dans les Hinterlands et parlez à Agnar Beastamer. Dépêchez-vous, vous n’avez qu’une heure pour le trouver avant que le petit ne meure dans l’oeuf.‡带着这枚脆弱的小精龙卵去辛特兰，与阿格纳谈一谈，但是你一定要在它还有生命力的时候赶到，在蛋里的小生命夭折之前，你只有1小时的时间。‡帶著這枚脆弱的小精龍卵去辛特蘭，與阿格納談一談，但是你一定要在它還有生命力的時候趕到，在蛋裡的小生命夭折之前，你只有1小時的時間。',
  }
},
[3844] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Olhe em volta da lagoa para descobrir uma pista sobre quem pode ser o dono do bote destruído.‡Осмотритесь и попытайтесь выяснить, кому мог бы принадлежать разбитый плот.‡Sucht in dem Tümpel nach einem Hinweis darauf, wem dieses havarierte Floß gehören könnte.‡연못을 둘러보고 이 난파된 나룻배의 주인에 대한 단서를 찾아야 합니다.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Busca alrededor del estanque alguna pista sobre a quién perteneció la balsa destrozada.‡Rechercher dans l\'étang un indice sur l\'identité du propriétaire du radeau brisé.‡在池塘附近查找与搁浅的小艇有关的线索。‡在池塘附近查找與擱淺的小艇有關的線索。',
  }
},
[3845] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Examine os itens dentro da bolsa e leve até o dono.‡Изучите найденное в сумке и верните владельцу.‡Untersucht die Gegenstände in dem Bündel und bringt sie zu ihrem Besitzer.‡가방 안에 든 물건을 조사해 그 주인에게 되돌려주어야 합니다.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examina los objetos de la talega y devuélveselos a su propietario.‡Examiner les objets du paquet et les apporter à leur propriétaire.‡查看袋子里的东西，然后将它们交给物主。‡查看袋子裡的東西，然後將它們交給物主。',
  }
},
[3861] = {
  {
    'COCORICÓ!‡Куд-кудаааа!‡GLUCK!‡꼬꼬댁!!!‡¡CLOQUEA!‡¡CLOQUEA!‡COT-COT-CODEC !‡咕咕嘎！‡咕咕嘎!',
    nil,
    'Procure a Ração Especial de Galinha e volte até sua nova amiga galinácea. Em seguida, use a expressão /incentivar diante dela e lhe dê a Ração Especial de Galinha.‡Найдите немного цыплячьего корма и вернитесь к вашей курочке-подружке. Когда найдете ее, /поклонитесь ей прежде, чем накормить ее специальным цыплячьим кормом.‡Beschafft Euch etwas Spezialhühnerfutter und kehrt zu dem Huhn zurück, das sich mit Euch angefreundet hat. Wenn Ihr es gefunden habt, dann benutzt erst /cheer, ehe Ihr dem Huhn das Spezialhühnerfutter gebt.‡특별 닭모이를 찾아 친구가 된 닭에게 돌아가야 합니다. 특별 닭모이를 주기 전에 닭을 찾으면 /환호해야 합니다.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Trouver de la Nourriture spéciale pour poulet et l\'apporter à la poule que vous voulez aider. Lorsque vous l\'aurez trouvée, encouragez-la (/acclame) avant d\'essayer de lui donner la Nourriture spéciale pour poulet.‡找一些特殊的鸡饲料，把它交给友好的小鸡。当你找到小鸡的时候，在喂食它之前对它做出高兴的表情。（使用/cheer命令）‡找一些特殊的雞飼料，把它交給友好的小雞。當你找到小雞的時候，在餵食它特殊的雞飼料之前對它做出拍動翅膀的表情。(使用/cheer 命令)',
  }
},
[3881] = {
  {
    'A salvação da expedição‡Спасение экспедиции‡Rettungsexpedition‡원정대 구조‡Expedición Salvación‡Salvar a la expedición‡Le sauvetage de l\'expédition‡抢救物资‡搶救物資',
    nil,
    'Leve um Caixote de Comestíveis e o Equipamento de Pesquisa para Williden Marshal in Cratera Un\'Goro.‡Принесите ящик с провизией и исследовательское оборудование Виллидену Маршалу в Кратер Ун\'Горо.‡Bringt eine Kiste mit Nahrungsmitteln und Forscherausrüstung zu Williden Marschall im Krater von Un\'Goro.‡운고로 분화구에 있는 윌리덴 마샬에게 식량 상자와 탐사 장비를 가져가야 합니다.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Lleva un cajón de comestibles y el equipo de investigación a Williden Marshal en el Cráter de Un\'Goro.‡Apporter une Caisse de nourriture et de l\'Equipement de recherche à Williden Marshal dans le Cratère d\'Un\'Goro.‡将食物箱和研究设备交给安戈洛环形山的威利德·马绍尔。‡將食物木箱和研究設備交給安戈洛環形山的威利德·馬紹爾。',
  }
},
[3882] = {
  {
    'Osso duro de roer‡Игра в кости‡Knochenklappern‡뼈 수집‡Choca esos huesos‡Choca esos huesos‡Faites rouler les os‡挖骨头‡挖骨頭',
    nil,
    'Leve 8 Ossos de Dinossauro para Chispa Minanilo na Cratera Un\'Goro.‡Принесите 8 костей динозавра Искру Пустокопу в Кратер Ун\'Горо.‡Bringt 8 Dinosaurierknochen zu Funks Nilminer im Krater von Un\'Goro.‡운고로 분화구에 있는 스파크 닐마이너에게 공룡 뼈 8개를 가져가야 합니다.‡Lleva 8 huesos de dinosaurio a Chispik Nilminer en el Cráter de Un\'Goro.‡Lleva 8 huesos de dinosaurio a Chispik Minamal en el Cráter de Un\'Goro.‡Apporter 8 Os de dinosaure à Etincelle Minerien, au cratère d\'Un\'Goro.‡将8根恐龙骨头交给安戈洛环形山的斯巴克·尼米尔。‡將8根恐龍骨頭交給安戈洛環形山的斯巴克·尼米爾。',
  }
},
[3883] = {
  {
    'Ecologia forânea‡Экология чужих‡Eine fremdartige Ökologie‡외래 생태계‡Ecología alienígena‡Ecología alienígena‡Écologie étrangère‡异型的生态‡異型的生態',
    nil,
    'Use a Ampola de Amostra para coletar uma Amostra de Parede de Colmeia de uma das incubadoras Gorishi na Cratera Un\'Goro. Procure as câmaras com larvas.nnLeve a Amostra de Parede de Colmeia para Hol\'anyee Marshal na Cratera Un\'Goro.‡Воспользуйтесь фиалом для образцов, чтобы взять образец материала стены улья из одного из инкубаторов Гориши в Кратере Ун\'Горо. Ищите в ульях комнаты со свисающими гроздьями личинок. nnПринесите образец материала стены улья Холании Маршал в Кратер Ун\'Горо.‡Verwendet die Kratzphiole, um damit eine Schwarmbauwandprobe von einer der Schwarmbrutstätten der Gorishi im Krater von Un\'Goro zu holen. Sucht nach den Kammern mit der hängenden Larvenbrut.nnBringt die Schwarmbauwandprobe zu Hol\'anyee Marschall im Krater von Un\'Goro.‡운고로 분화구에 있는 고리쉬 부화장에서 채집 약병을 사용해 고리쉬집 벽면 견본을 채취하십시오. 유충알이 매달려 있는 방을 찾아야 합니다.nn운고로 분화구에 있는 홀라니에 마샬에게 고리쉬집 벽면 견본을 가져가야 합니다.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.nnLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliza el vial de raspadura para recoger una Muestra de pared de colmena de uno de los criaderos Gorishi del Cráter de Un\'Goro. Busca las cámaras con los huevos de larva colgantes.|nLleva la Muestra de pared de colmena a Hol\'anyee Marshal en el Cráter de Un\'Goro.‡Utiliser la Fiole de raclement pour récolter un Échantillon de paroi de la ruche dans une des nurseries de la ruche Gorishi, à l\'intérieur du cratère d\'Un\'Goro. Chercher les chambres qui contiennent des larves suspendues.nnApporter l\'Échantillon de paroi de la ruche à Hol\'anyee Marshal dans le cratère d\'Un\'Goro.‡使用采集瓶从安戈洛环形山的某个格里什虫巢的孵化室中收集一份巢穴侧壁的样本，在有悬挂着的虫卵的房间里收集样本。nn将虫穴内壁样本交给安戈洛环形山的霍莱伊·马绍尔。‡使用採集瓶從安戈洛環形山的某個格里什蟲巢的孵化室中收集一份巢穴側壁的樣本，在有懸掛著的蟲卵的房間裡收集樣本。|n將蟲穴內壁樣本交給安戈洛環形山的霍萊伊·馬紹爾。',
  }
},
[3884] = {
  {
    'Diário de Williden‡Дневник Вилидена‡Willidens Tagebuch‡윌리덴의 일지‡Diario de Williden‡Diario de Williden‡Le journal de Williden‡威利德的日记‡威利德的日記',
    nil,
    'Devolva o diário a Williden Marshal na Cratera Un\'Goro.‡Верните дневник Виллидену Маршалу, который находится где-то в Кратере Ун\'Горо.‡Bringt das Tagebuch zu Williden Marschall zurück. Er befindet sich irgendwo im Krater von Un\'Goro.‡운고로 분화구 어딘가에 있는 윌리덴 마샬에게 일지를 돌려줘야 합니다.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Devuelve el diario a Williden Marshal en algún lugar del Cráter de Un\'Goro.‡Rapporter le Journal à Williden Marshal quelque part dans le Cratère d\'Un\'Goro.‡将日记还给安戈洛环形山中的威利德·马绍尔。‡將日記還給安戈洛環形山中的威利德·馬紹爾。',
  }
},
[3901] = {
  {
    'Desossando alguns Range-ossos‡Игрушки-погремушки‡Klappernde Skelette‡덜그럭거리는 해골 처치‡Sacudir esqueletos‡Sacudir esqueletos‡Faites cliqueter les thorax !‡断骨骷髅‡斷骨骷髏',
    nil,
    'Mate 12 Esqueletos Range-ossos e fale novamente com o Sacerdote Sombrio Sarvis em Plangemortis quando terminar.‡Убейте 12 скелетов-костетрясов, а затем вернитесь к жрецу Тьмы Сарвису в Могильник.‡Tötet 12 klappernde Skelette und kehrt zu Schattenpriester Sarvis in Todesend zurück, wenn Ihr fertig seid.‡덜그럭거리는 해골 12명을 처치한 후, 데스넬에 있는 어둠의사제 사비스에게 돌아가야 합니다.‡Mata a 12 esqueletos armadóseos y cuando lo hayas hecho, vuelve a buscar al sacerdote de las Sombras Sarvis a Camposanto.‡Mata a 8 esqueletos armadóseos.‡Tuez 12 Squelettes Cliquethorax, puis retournez voir le Prêtre des ombres Sarvis au Glas.‡杀掉12个断骨骷髅，然后回到丧钟镇的暗影牧师萨维斯那里。‡殺掉12個斷骨骷髏，然後回到喪鐘鎮的暗影牧師薩維斯那裡。',
  }
},
[3902] = {
  {
    'Vasculhando Plangemortis‡Поиски старой одежды‡Beutesuche in Todesend‡데스넬에서의 폐품 수집‡Hurgar en Camposanto‡Hurgar en Camposanto‡La chasse aux trésors‡捡破烂‡',
    nil,
    'Procure 6 peças de Material Reaproveitado nas redondezas de Plangemortis e fale novamente com o Necroguarda Saulo.‡Обыщите Могильник и его окрестности и найдите 6 ящиков с добычей и передайте их стражу смерти Салтену.‡Durchsucht Todesend und Umgebung nach 6 Stücken aufgestöberter Ware und bringt sie zu Todeswache Saltain zurück.‡데스넬과 그 주변에서 쓸만한 물건 6개를 찾아 죽음의경비병 살테인에게 돌아가야 합니다.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al Guardia de la Muerte Saltain.‡Busca 6 piezas de mercancías extraviadas por Camposanto y los alrededores y llévaselas al Guardia de la Muerte Saltain.‡Fouiller Le Glas et ses alentours pour trouver 6 caisses de Fournitures de récupération, et les ramener au Nécrogarde Saltain.‡在丧钟镇及临近地区搜寻6件破烂装备，把它们交给亡灵卫兵萨尔坦。‡',
  }
},
[3903] = {
  {
    'Madel Quintana‡Милли Осворт‡Milly Geltmark‡밀리 오스워드‡Milly Osworth‡Milly Osworth‡Milly Osworth‡米莉·奥斯沃斯‡米莉·奧斯沃斯',
    nil,
    'Fale com Madel Quintana.‡Поговорите с Милли Осворт.‡Sprecht mit Milly Geltmark.‡밀리 오스워드와 대화해야 합니다.‡Habla con Milly Osworth.‡Habla con Milly Osworth.‡Parler à Milly Osworth.‡与米莉·奥斯沃斯谈一谈。‡與米莉·奧斯沃斯談話。',
  }
},
[3904] = {
  {
    'Colheita da Madel‡Урожай Милли‡Millys Ernte‡밀리의 수확물‡La cosecha de Milly‡La cosecha de Milly‡Les vendanges de Milly‡米莉的葡萄‡米莉的葡萄',
    nil,
    'Leve 8 caixotes da Colheita da Madel para Madel Quintana na Abadia de Vila Norte.‡Принесите 8 корзин с виноградом Милли Осворт в Аббатство Североземья.‡Bringt 8 Kisten mit Millys Ernte zu Milly Geltmark in der Nähe der Abtei von Nordhain.‡노스샤이어 수도원에 있는 밀리 오스워드에게 밀리의 수확물 8 상자를 가져가야 합니다.‡Lleva 8 cajas de cosecha a Milly Osworth a la Abadía de Villanorte.‡Lleva 8 cajas de cosecha a Milly Osworth a la Abadía de Villanorte.‡Apporter 8 seaux de la récolte de Milly à Milly Osworth à l\'Abbaye de Comté-du-nord.‡收集8箱米莉的葡萄，把它们交给北郡修道院的米莉·奥斯沃斯。‡收集8箱米莉的葡萄，把它們交給北郡修道院的米莉·奧斯沃斯。',
  }
},
[3905] = {
  {
    'Manifesto da Uva‡Уведомление о поставке винограда‡Traubenliste‡포도 수확 목록‡Informe de la vendimia‡Informe de la vendimia‡Manifeste des vendanges‡葡萄出货单‡葡萄出貨單',
    nil,
    'Leve o Manifesto da Uva para o Irmão Neals na Abadia de Vila Norte.‡Отнесите уведомление о поставке винограда брату Нилзу в Аббатство Североземья.‡Bringt die Traubenliste zu Bruder Neals in der Abtei von Nordhain.‡노스샤이어 수도원에 있는 수사 닐스에게 포도 수확 목록을 가져가야 합니다.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Lleva el Informe de la vendimia al hermano Neals a la Abadía de Villanorte.‡Apporter le Manifeste des vendanges à Frère Neals dans l\'Abbaye de Comté-du-nord.‡将葡萄出货单交给北郡修道院的尼尔斯修士。‡將葡萄出貨單交給北郡修道院的尼爾斯修士。',
  }
},
[3906] = {
  {
    'Desarmonia das chamas‡Дисгармония пламени‡Disharmonie der Flamme‡화염의 부조화‡La discordia de las llamas‡La discordia de las llamas‡Discordance des flammes‡不和谐的烈焰‡不和諧的烈焰',
    nil,
    'Vá até a pedreira da Montanha Rocha Negra e mate o Mestre Supremo Piro. Fale novamente com Coração Trovejante quando tiver cumprido essa tarefa.‡Отправьтесь в карьер у Черной горы и уничтожьте Подчинителя Пирона. По выполнению вернитесь к Громосерду.‡Reist zum Steinbruch am Schwarzfels und tötet Übermeister Pyron. Kehrt zu Donnerherz zurück, sobald Ihr den Auftrag erledigt habt.‡검은바위 산에 있는 채석장으로 가서 멸망의 파이론을 처치해야 합니다. 이 임무를 완수한 후 썬더하트에게 돌아가십시오.‡Ve a la cantera de la Montaña Roca Negra y ejecuta al Maestro Supremo Pyron. Vuelve junto a Truenozón cuando hayas completado este encargo.|n‡Ve a la cantera de la Montaña Roca Negra y ejecuta al Maestro Supremo Pyron. Vuelve junto a Corazón Atronador cuando hayas completado este encargo.‡Partir pour la carrière dans le mont Rochenoire et tuer le Grand seigneur Pyron. Retourner voir Cœur-de-tonnerre une fois votre mission accomplie.‡到黑石山脉的采石场去干掉征服者派隆，然后向桑德哈特回报。‡到黑石山脈的採石場去幹掉征服者派隆，然後向桑德哈特回報。',
  }
},
[3907] = {
  {
    'Desarmonia do fogo‡Дисгармония пламени‡Disharmonie des Feuers‡불의 부조화‡La discordia de las llamas‡La discordia del fuego‡Discordance des flammes‡不和谐的火焰‡不和諧的火焰',
    nil,
    'Entre no Abismo Rocha Negra e encontre o Lorde Incendius. Mate-o e leve todas as informações que puder para o Coração Trovejante.‡Ступайте в глубины Черной горы и выследите лорда Опалителя. Убейте его и принесите Громосерду все, что может дать какую-то информацию.‡Betretet die Schwarzfelstiefen und spürt Lord Incendius auf. Tötet ihn und bringt jegliche Informationsquelle, die Ihr finden könnt, zu Donnerherz.‡검은바위 나락에 들어가 불의군주 인센디우스를 찾아, 그를 처치한 후 얻게 되는 모든 정보를 썬더하트에게 가져가야 합니다.‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Truenozón.|n‡Adéntrate en las Profundidades de Roca Negra y localiza a Lord Incendius. Mátalo y llévale toda la información que encuentres a Corazón Atronador.‡Pénétrez dans les Profondeurs de Rochenoire et traquez le Seigneur Incendius. Tuez-le puis donner tous les renseignements que vous pourrez trouver à Cœur-de-tonnerre.‡进入黑石深渊并找到伊森迪奥斯。杀掉它，然后把你找到的信息汇报给桑德哈特。‡進入黑石深淵並找到伊森迪奧斯領主。殺掉它，然後把你找到的資訊彙報給桑德哈特。',
  }
},
[3908] = {
  {
    'É segredo para todo mundo‡Тайна, покрытая мраком‡Es ist für jeden ein Geheimnis‡아무도 모르는 비밀‡Un secreto bien guardado‡Un secreto bien guardado‡C\'est un Secret pour tout le monde‡无人知晓的秘密‡無人知曉的秘密',
    nil,
    'Leve a Espada de Linken para Bruna Covaneve em Hibérnia.‡Отнесите меч Линкена Донове Снегоноре.‡Bringt Linkens Schwert zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 링쿠의 훈련용 검을 가져가야 합니다.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Lleva la Espada de Linken a Donova Cubilnevado en Cuna del Invierno.‡Apporter l\'Epée de Linken à Donova Antreneige au Berceau-de-l\'Hiver.‡把林克的剑交给冬泉谷的多诺瓦·雪山。‡把林克的劍交給冬泉谷的多諾瓦·雪山。',
  }
},
[3909] = {
  {
    'O elixir Videre‡Эликсир Видере‡Das Videre-Elixier‡앞날의 비약‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡視靈藥劑',
    nil,
    'Procure Gregan Cospechope ao norte de Feralas. Descubra com ele como obter o elixir Videre, depois fale novamente com Bruna Covaneve em Hibérnia.‡Найдите Грегана Пивоплюя на севере Фераласа. Выясните у него, как получить эликсир Видере, и вернитесь к Донове Снегоноре.‡Sucht nach Gregan Hopfenspei im nördlichen Feralas. Lasst Euch von ihm erklären, wie Ihr Euch das Videre-Elixier beschaffen könnt, und kehrt dann zu Donova Schneeweh nach Winterquell zurück.‡페랄라스 북쪽에서 그레간 브루스퓨를 찾아야 합니다. 그에게서 앞날의 비약을 얻는 방법을 배워 여명의 설원에 있는 도노바 스노우덴에게 돌아가야 합니다.‡Busca a Gregan Vomitabrebaje en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Busca a Gregan Tirabirras en el norte de Feralas. Con él, aprende cómo puedes obtener el Elixir de Videre. Cuando lo sepas, vuelve con Donova Cubilnevado en Cuna del Invierno.‡Rechercher Gregan Gerbebière au nord de Féralas. Apprendre de lui comment vous pouvez acquérir l\'élixir de Videre, puis retourner voir Donova Antreneige, au Berceau-de-l\'Hiver.‡去菲拉斯找格雷甘·山酒。从他那里问到获取视灵药剂的方法，然后向冬泉谷的多诺瓦·雪山复命。‡去菲拉斯找格雷甘·山酒。從他那裡問到獲取視靈藥劑的方法，然後向冬泉谷的多諾瓦·雪山覆命。',
  }
},
[3911] = {
  {
    'O último elemento‡Последняя Стихия‡Das letzte Element‡마지막 원소‡El último elemento‡El último elemento‡Le dernier élément‡最后的元素‡最後的元素',
    nil,
    'Vá até o Abismo Rocha Negra e obtenha 10 Essências dos Elementos. Seu primeiro impulso é procurar nos golens e criadores de golens. Você lembra que Vivian Latumba também mencionou elementais.‡Отправляйтесь в Глубины Черной горы и добудьте 10 мер сущности Стихий. Стоит начать поиски с големов и их создателей. Вивиан Лаграв также бормотала что-то про элементалей.‡Begebt Euch in die Schwarzfelstiefen und beschafft 10 Essenzen der Elemente. Euer erster Gedanke ist, die Golems und die Schöpfer der Golems zu suchen. Doch Ihr erinnert Euch, dass Vivian Lagrave auch etwas von Elementaren vor sich hin gemurmelt hat.‡검은바위 나락으로 가서 원소의 정수 10개를 회수해야 합니다. 먼저 골렘이나 골렘 제조자부터 찾아보십시오. 비비안 라그레이브가 정령에 대해 중얼거리듯 얘기한 것이 기억납니다.‡Viaja a las Profundidades de Roca Negra y recupera 10 esencias de los elementos. Tu primer impulso es buscar los golems y a los creadores de golems. Recuerdas que Vivian La tumba también murmuró entre dientes algo sobre los elementales.|n‡Viaja a las Profundidades de Roca Negra y recupera 10 esencias de los elementos. Tu primer impulso es buscar los gólems y a los creadores de gólems. Recuerdas que Vivian Lagrave también murmuró entre dientes algo sobre los elementales.|n‡Partir pour les Profondeurs de Rochenoire et trouver 10 Essences des éléments. Commencer vos recherches par les golems et par les créateurs de golems. Vivian Lagrave a aussi marmonné quelque chose à propos d\'élémentaires.‡到黑石深渊去取得10份元素精华。你应该在那些作战傀儡和傀儡制造者身上找找，另外，薇薇安·拉格雷也提到了一些有关元素生物的话题......‡到黑石深淵去取得10份元素精華。你應該在那些作戰魔像和魔像製造者身上找找，另外，薇薇安·拉格雷也提到了一些有關元素生物的話題……',
  }
},
[3912] = {
  {
    'Encontro na sepultura‡Встречаемся на кладбище‡Treffen am Grab‡무덤에서의 만남‡Encuentro en la tumba‡Encuentro en la tumba‡Rendez-vous à la tombe‡墓地相见‡墓地相見',
    nil,
    'Vá até o cemitério perto de Geringontzan e use o Elixir Videre. Siga as outras instruções de Bruna para achar Gaeriyan.‡Отправляйтесь на кладбище на окраине Прибамбасска и выпейте там эликсир Видере. Далее, следуя инструкциям Доновы, найдите Гаэриана.‡Geht zum Friedhof außerhalb von Gadgetzan und benutzt dort das Videre-Elixier. Befolgt Donovas übrige Anweisungen, um Gaeriyan zu finden.‡가젯잔 밖에 있는 무덤으로 가서 앞날의 비약을 사용하십시오. 도노바의 지시에 따라 개리얀을 찾아야 합니다.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Ve al cementerio a las afueras de Gadgetzan y utiliza el Elixir de Videre. Sigue las demás instrucciones de Donova para encontrar a Gaeriyan.‡Se rendre au cimetière au-dehors de Gadgetzan et boire l\'élixir de Videre. Suivre le reste des instructions de Donova pour trouver Gaeriyan.‡在加基森镇外的墓地中使用视灵药剂，然后按照多诺瓦的指示找到加里杨。‡在加基森鎮外的墓地中使用視靈藥劑，然後按照多諾瓦的指示找到加里楊。',
  }
},
[3913] = {
  {
    'A sepultura‡Замогильная история‡Grabesstille‡무덤의 상태‡Una situación mortal‡Una situación mortal‡Une situation grave‡寻找墓碑‡尋找墓碑',
    nil,
    'Ressuscite, depois procure a lápida que Gaeriyan disse para você encontrar.‡Воскресните, найдите могильный камень, о котором говорил Гаэриан.‡Wenn Ihr auferstanden seid, sucht nach dem Grabstein, von dem Gaeriyan Euch erzählt hat.‡부활한 후, 개리얀이 말한 묘비를 찾아야 합니다.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Resucita y busca la lápida de la que te habló Gaeriyan.‡Ressusciter, puis rechercher la pierre tombale que Gaeriyan vous a demandé de trouver.‡复活，然后寻找加里杨让你去找的那块墓碑。‡復活，然後尋找加里楊讓你去找的那塊墓碑。',
  }
},
[3914] = {
  {
    'Espada de Linken‡Меч Линкена‡Linkens Schwert‡링쿠의 검‡La Espada de Linken‡La Espada de Linken‡L\'épée de Linken‡林克的剑‡林克的劍',
    nil,
    'Leve a Espada Superior de Linken para Linken na Cratera Un\'Goro.‡Доставьте превосходный меч Линкена Линкену в Кратер Ун\'Горо.‡Liefert Linkens überragendes Schwert bei Linken im Krater von Un\'Goro ab.‡운고로 분화구에 있는 링쿠에게 링쿠의 명검을 가져가야 합니다.‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Entrega la Espada superior a Linken en el Cráter de Un\'Goro.‡Remettre l\'Epée excellente de Linken à Linken dans le cratère d\'Un\'Goro.‡把林克的强化之剑交给安戈洛尔环形山的林克。‡把林克的強化之劍交給安戈洛環形山的林克。',
  }
},
[3921] = {
  {
    'Juntatudy Jogafora‡Венаки Бенике‡Wenikee Kübelbolz‡웨니키 볼트버킷‡Wenikee Tuercasmil‡Wenikee Tuercasmil‡Wenikee Boltbucket‡维妮·布特巴克‡維妮·布特巴克',
    nil,
    'Leve a Rebimboca Quebrada para Juntatudy Jogafora.‡Отнесите сломанный самофланж Венаки Бенике.‡Bringt das zerbrochene Samophlang zu Wenikee Kübelbolz.‡웨니키 볼트버킷에게 부서진 사모플랜지를 가져가야 합니다.‡Llévale el churumbele roto a Wenikee Tuercasmil.‡Llévale el churumbele roto y maltrecho a Wenikee Tuercasmil. Habla con Brak para teletransportarte directamente hasta ella.‡Apporter le Samophlange cassé à Wenikee Bakaboulon.‡将损坏的主动式负载平衡器交给维妮·布特巴克。‡將損壞的主動式負載平衡器交給維妮·布特巴克。',
  }
},
[3922] = {
  {
    'Chumbalheiras‡Металлические заготовки‡Schraubnieten‡용접용 철괴‡Engranajes‡Engranajes‡Les Petites pièces‡高强度齿轮‡高強度齒輪',
    nil,
    'Leve 15 Chumbalheiras para Juntatudy Jogafora nos Sertões.‡Принесите 15 металлических заготовок для деталей Венаки Бенике в Степи.‡Bringt 15 Schraubnieten zu Wenikee Kübelbolz im Brachland.‡불모의 땅에 있는 웨니키 볼트버킷에게 용접용 철괴 15개를 가져가야 합니다.‡Llévale 15 engranajes a Wenikee Tuercasmil en Los Baldíos.‡Reúne 10 engranajes de los cubos que encuentres por la zona de El Fangal.‡Apporter 15 Rondelles de métal à Wenikee Bakaboulon dans les Tarides.‡把15个高强度齿轮交给贫瘠之地的维妮·布特巴克。‡把15個高強度齒輪交給貧瘠之地的維妮·布特巴克。',
  }
},
[3923] = {
  {
    'Rilli Passomal‡Рилли Грязегоб‡Rilli Schmierklump‡릴리 그리지가브‡Rilli Gapegajoso‡Rilli Gapegajoso‡Rilli Greasygob‡雷里·格里斯高布‡雷里·格里斯高布',
    nil,
    'Leve a Rebimboca Quebrada e Surrada para o Rilli Passomal em Orgrimmar.‡Отнесите разбитый и сломанный самофланж Рилли Грязегобу в Оргриммар.‡Bringt das zerbrochene und ramponierte Samophlang nach Orgrimmar zu Rilli Schmierklump.‡오그리마에 있는 릴리 그리지가브에게 부서지고 찌그러진 사모플랜지를 가져가야 합니다.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Llévale el churumbele roto y maltrecho a Rilli Gapegajoso en Orgrimmar.‡Apporter le Samophlange cassé à Rilli Grassougob à Orgrimmar.‡把破碎的主动式负载平衡器交给奥格瑞玛的雷里·格里斯高布。‡把破碎的主動式負載平衡器交給奧格瑪的雷里·格里斯高布。',
  }
},
[3924] = {
  {
    'Manual da rebimboca‡Руководство по самофланжу‡Samophlanghandbuch‡사모플랜지 설명서‡El manual del churumbele‡El manual del churumbele‡Manuel du Samophlange‡主动式负载平衡器说明书‡主動式負載平衡器說明書',
    nil,
    'Leve o Manual da Rebimboca para Rilli Passomal em Orgrimmar.‡Отнесите руководство по самофланжу Рилли Грязегобу в Оргриммар.‡Bringt das Samophlanghandbuch nach Orgrimmar zu Rilli Schmierklump.‡오그리마에 있는 릴리 그리지가브에게 사모플랜지 설명서를 가져가야 합니다.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Llévale el manual del churumbele a Rilli Gapegajoso en Orgrimmar.‡Apporter le Manuel du Samophlange à Rilli Grassougob à Orgrimmar.‡把主动式负载平衡器说明书交给奥格瑞玛的雷里·格里斯高布。‡把主動式負載平衡器說明書交給奧格瑪的雷里·格里斯高布。',
  }
},
[3941] = {
  {
    'Ajuda gnômica‡Помощь гномов‡Die Hilfe des Gnoms‡노움의 도움‡La ayuda de una gnoma‡La ayuda de una gnoma‡Un gnome dans le besoin‡侏儒的援助‡地精的援助',
    nil,
    'Encontre J.D. Neri na caverna do Refúgio do Marshal.‡Найдите Джей Ди Колли в Укрытии Маршалла.‡Sucht J.D. Collie in der Höhle in Marschalls Zuflucht auf.‡마샬의 야영지에 있는 동굴에서 J.D. 콜리를 찾아야 합니다.‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Encuentra a J.D. Collie en la cueva del Refugio de Marshal.‡Trouver J.D. Collie dans la caverne du refuge des Marshal.‡到马绍尔营地那里的山洞中去找科琳。‡到馬紹爾營地那裡的山洞中去找科琳。',
  }
},
[3942] = {
  {
    'Memória de Linken‡Память Линкена‡Linkens Andenken‡링쿠의 기억‡Recuerdos de Linken‡Recuerdos de Linken‡Les souvenirs de Linken‡林克的记忆‡林克的記憶',
    nil,
    'Encontre Eridan Brisazul no sul da Selva Maleva.‡Найдите Эридану Грусть Ветра на юге Оскверненного леса.‡Sucht Eridan Blauwind im südlichen Teil des Teufelswalds.‡악령의 숲 남부에 있는 에리단 블루윈드를 찾아가야 합니다.‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Encuentra a Eridan Vientoazul en el sur de Frondavil.‡Trouver Eridan Ventebleu dans le sud de Gangrebois.‡到费伍德森林去找艾瑞丹·蓝风。‡到費伍德森林去找艾瑞丹·藍風。',
  }
},
[3961] = {
  {
    'A aventura de Linken‡Приключения Линкена‡Linkens Abenteuer‡링쿠의 모험‡La aventura de Linken‡La aventura de Linken‡L\'aventure de Linken‡林克的冒险‡林克的冒險',
    nil,
    'Leve o Totem de Prata de Aquementas para Linken no Refúgio do Marshal.‡Отнесите серебряный тотем Аквамонтоса Линкену в Укрытие Маршалла.‡Bringt das Silbertotem von Aquementas zu Linken in Marschalls Zuflucht.‡마샬의 야영지에 있는 링쿠에게 아쿠에멘타스의 은토템을 가져가야 합니다.‡Lleva el Tótem plateado de Aquementas a Linken, en el Refugio de Marshal.‡Lleva el Tótem plateado de Aquamentas a Linken, en el Refugio de Marshal.‡Apporter le Totem d\'argent d\'Aquementas à Linken au refuge des Marshal.‡把亚奎门塔斯的银图腾交给马绍尔营地里的林克。‡把亞奎門塔斯的銀圖騰交給馬紹爾營地裡的林克。',
  }
},
[3962] = {
  {
    'É perigoso ir sozinho‡Один в поле не воин‡Allein ist es gefährlich‡혼자서 가기 무서운 곳‡Ir solo es peligroso‡Ir solo es peligroso‡C\'est dangereux d\'y aller seul‡结伴而行‡結伴而行',
    nil,
    'Vá para o Pico Penacho de Fogo, ao sul do Refúgio do Marshal.nnEncontre Agni e use o totem para remover sua aura de proteção. Uma vez que for derrotado, pegue a Chama Dourada na caverna.‡Отправляйтесь к Вулкану Огненного Венца, к югу от Укрытия Маршалла. nnНайдите Яропламеня и разрушьте его защитную ауру с помощью тотема. Когда дух будет сражен, заберите из пещеры Золотое пламя.‡Begebt Euch zum Feuersäulengrat südlich von Marschalls Zuflucht.nnSucht Sturmflamme und verwendet das Totem, um die schützende Aura, die ihn umgibt, zu entfernen. Sobald er besiegt ist, holt die Goldene Flamme aus der Höhle.‡마샬의 야영지 남쪽에 있는 불기둥 마루로 가야 합니다.nn불바람을 찾아 토템을 이용해 오라를 제거하십시오. 정령을 물리친 후, 동굴에서 황금 불길을 손에 넣어야 합니다.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.nnBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Viaja a Cresta del Penacho en Llamas, al sur del Refugio de Marshal.|nBusca a Correfuego y utiliza el Tótem para eliminar su aura protectora. Cuando le hayas derrotado, coge la Llama Dorada de la cueva.‡Partir pour la crête de la Fournaise, au sud du refuge des Marshal.nnTrouver Coursembrase et utiliser le Totem pour dissiper son aura protectrice. Une fois Coursembrase vaincu, se procurer la Flamme dorée.‡到马绍尔营地南边的火羽山去。nn找到火焰使者，并使用图腾除掉它的防护光环。在击败它之后从洞中取得金色火焰。‡到馬紹爾營地南邊的火羽山去。|n找到火焰使者，並使用圖騰除掉它的防護光環。在擊敗它之後從洞中取得金色火焰。',
  }
},
[3981] = {
  {
    'Comandante Gor\'shak‡Командир Гор\'шак‡Kommandant Gor\'shak‡사령관 고르샤크‡Comandante Gor\'shak‡Comandante Gor\'shak‡Le commandant Gor\'shak‡指挥官哥沙克‡指揮官哥沙克',
    nil,
    'Encontre o Comandante Gor\'shak no Abismo Rocha Negra.nnVocê se lembra que o tosco desenho incluía barras rabiscadas sobre o orc. Talvez você devesse procurar algum tipo de prisão.‡Найдите командира Гор\'шака в Глубинах Черной горы. nnСудя по рисунку в записке, искать следует в темнице где-то вроде того.‡Sucht Kommandant Gor\'shak in den Schwarzfelstiefen.nnIhr erinnert Euch, dass auf dem primitiv gezeichneten Bild des Orcs auch Gitter vor dem Gesicht zu sehen waren. Vielleicht solltet Ihr nach einer Art Gefängnis suchen.‡검은바위 나락에서 사령관 고르샤크를 찾아야 합니다.nn조잡하게 그려진 오크 그림에 쇠창살이 그려져 있던 것이 생각납니다. 감옥 같은 곳을 찾아봐야 할 것 같습니다.‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.nnRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Encuentra al comandante Gor\'shak en las Profundidades de Roca Negra.|nRecuerdas que en el dibujo burdo había rejas sobre el rostro del orco. Quizás deberías buscar una cárcel o algo similar.‡Trouver le commandant Gor\'shak dans les Profondeurs de Rochenoire.nnVous vous souvenez que le dessin maladroit représentait également des barreaux au-dessus du portrait. Peut-être devriez-vous rechercher un genre de prison.‡在黑石深渊里找到指挥官哥沙克。nn在那幅草图上画着的是一个铁栏后面的兽人，也许你应该到某个类似监狱的地方去找找看。‡在黑石深淵裡找到指揮官哥沙克。|n在那幅草圖上畫著的是一個鐵欄後面的獸人，也許你應該到某個類似監獄的地方去找找看。',
  }
},
[3982] = {
  {
    'O que está acontecendo?‡Что происходит?‡Was ist los?‡사태 파악‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡出了什麼事?',
    nil,
    'Defenda Gor\'shak.‡Защитите Горшака.‡Verteidigt Gor\'shak.‡고르샤크를 보호해야 합니다.‡Defiende a Gor\'shak.‡Defiende a Gor\'shak.‡Défendre Gor\'shak.‡保护哥沙克。‡保護哥沙克。',
  }
},
[4001] = {
  {
    'O que está acontecendo?‡Что происходит?‡Was ist los?‡사태 파악‡¿Qué pasa?‡¿Qué pasa?‡Que se passe-t-il ?‡出了什么事？‡出了什麼事?',
    nil,
    'Fale com Kharan Feromalho para obter informações sobre o sequestro da Princesa Moira Barbabronze. Leve as informações para Thrall em Orgrimmar.nnGor\'shak mencionou que Kharan estava preso em uma cela próxima.‡Поговорите с дворфом по имени Каран Могучий Молот и соберите информацию о похищении принцессы Мойры Бронзобород. Передайте информацию Траллу в Оргриммар.nnКарана держат в темнице напротив.‡Sprecht mit Kharan Hammermacht und sammelt Informationen über die Entführung von Prinzessin Moira Bronzebart. Bringt diese Informationen dann zu Thrall nach Orgrimmar.nnIhr erinnert Euch, dass Gor\'shak gesagt hat, Kharan werde in einer Zelle in seiner Nähe festgehalten.‡카란 마이트해머와 대화하여 공주 모이라 브론즈비어드의 납치에 대한 정보를 모은 후, 그 정보를 오그리마에 있는 스랄에게 가져가야 합니다.nn고르샤크가 카란이 근처 감방에 갇혀 있다고 말했던 것이 기억납니다.‡Habla con Kharan Martillazo y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.nnRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.|n‡Habla con Kharan Martillo Poderoso y recaba información sobre el secuestro de la princesa Moira Barbabronce. Llévale esa información a Thrall en Orgrimmar.|nRecuerdas que Gor\'shak mencionó que Kharan estaba preso en una celda cercana.‡Parler à Kharan Force-martel et obtenir autant de renseignements que possible sur l\'enlèvement de la princesse Moira Barbe-de-bronze. Apporter ces renseignements à Thrall à Orgrimmar.nnGor\'shak a dit que Kharan était détenu dans une cellule proche.‡与卡兰·巨锤谈一谈，收集关于绑架公主铁炉堡公主茉艾拉·铜须这一事件的情报。将情报反馈给奥格瑞玛城里的萨尔。nn哥沙克提到过卡兰被关在附近的某个牢房中。‡與卡蘭·巨錘談一談，收集關於綁架公主鐵爐堡公主茉艾拉·銅鬚這一事件的情報。將情報回饋給奧格瑪城裡的索爾。|n哥沙克提到過卡蘭被關在附近的某個牢房中。',
  }
},
[4002] = {
  {
    'Os Reinos do Leste‡Восточные королевства‡Das östliche Königreich‡동부 왕국‡Los Reinos del Este‡Los Reinos del Este‡Les Royaumes de l\'est‡东部王国‡東部王國',
    nil,
    'Fale com Thrall se estiver <preparado/preparada> para assumir a missão que ele planejou.‡Поговорите с Траллом.‡Sprecht mit Thrall, wenn Ihr bereit seid, die von ihm geplante Mission zu übernehmen.‡스랄이 계획한 임무를 맡을 준비가 되었으면 스랄과 다시 한번 대화해야 합니다.‡Si aceptas la misión, habla con Thrall.‡Si aceptas la misión, habla con Thrall.‡Parler à Thrall si vous êtes <prêt/prête> à vous charger de la mission qu\'il a prévue.‡如果你准备好要接受萨尔所安排的任务，就去找他谈一谈。‡如果你準備好要接受索爾所安排的任務，就去找他談話。',
  }
},
[4003] = {
  {
    'O resgate real‡Спасение принцессы‡Die königliche Rettung‡공주 구출‡El rescate real‡El rescate real‡Un sauvetage royal‡拯救公主‡拯救公主',
    nil,
    'Mate o Imperador Dagran Thaurissan e liberte a Princesa Moira Barbabronze do feitiço maligno.‡Убейте императора Даграна Тауриссана и освободите принцессу Мойру Бронзобород от его черного заклятия.‡Tötet Imperator Dagran Thaurissan und befreit Prinzessin Moira Bronzebart von seinem bösen Zauber.‡제왕 다그란 타우릿산을 처치하고 그의 사악한 마법에서 공주 모이라 브론즈비어드를 해방시켜야 합니다.‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.|n‡Mata al emperador Dagran Thaurissan para liberar a la princesa Moira Barbabronce del hechizo.‡Tuer l\'Empereur Thaurissan et libérer la Princesse Moira Barbe-de-bronze de son sort maléfique.‡杀掉达格兰·索瑞森大帝，然后将铁炉堡公主茉艾拉·铜须从他的邪恶诅咒中拯救出来。‡殺掉達格蘭·索瑞森大帝，然後將鐵爐堡公主茉艾拉·銅鬚從他的邪惡詛咒中拯救出來。',
  }
},
[4004] = {
  {
    'A princesa foi resgatada?‡Спасенная принцесса‡Ist die Prinzessin gerettet?‡구출된 공주?‡¿Princesa salvada?‡¿Princesa salvada?‡La Princesse sauvée ?‡拯救公主？‡拯救公主?',
    nil,
    'Fale novamente com Thrall!‡Вернитесь к Траллу.‡Kehrt zu Thrall zurück!‡스랄에게 돌아가야 합니다!‡¡Vuelve junto a Thrall!|n‡Vuelve junto a Thrall en el Fuerte Grommash en Orgrimmar.‡Retourner voir Thrall !‡向萨尔报告！‡向索爾報告!',
  }
},
[4005] = {
  {
    'Aquementas‡Аквамонтос‡Aquementas‡아쿠에멘타스‡Aquementas‡Aquamentas‡Aquementas‡亚奎门塔斯‡亞奎門塔斯',
    nil,
    'Leve o Livro de Aquor, as Garras Prateadas e o Coração de Ferrárbol até Tanaris.nnUse o Livro de Aquor para evocar Aquementas.nnApós ter completado o totem, leve-o para J.D. Neri no Refúgio do Marshal.‡Отнесите книгу Аквора, серебристые когти и сердце Железнолесья в Танарис. nnВоспользуйтесь книгой для призыва Аквамонтоса. nnПо получении тотема, отнести его Джей Ди Колли в Укрытие Маршалла.‡Bringt das Buch von Aquor, die silbrigen Klauen und das Eisenstammherz nach Tanaris.nnBenutzt das Buch von Aquor, um Aquementas zu beschwören.nnWenn Ihr das vollständige Totem habt, bringt es zu J.D. Collie in Marschalls Zuflucht zurück.‡아쿠오르의 책, 은백색 발톱, 그리고 강철나무 심장을 가지고 타나리스로 가십시오.nn아쿠오르의 책을 사용해 아쿠에멘타스를 소환해야 합니다.nn토템을 완성하면 마샬의 야영지에 있는 J.D. 콜리에게 가져가야 합니다.‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.nnUtiliza el Libro de Aquor para invocar Aquementas.nnCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Lleva el Libro de Aquor, las zarpas plateadas y el corazón de Troncoferro a Tanaris.|nUtiliza el Libro de Aquor para invocar Aquamentas.|nCuando tengas el tótem completo llévaselo a J.D. Collie en el Refugio de Marshal.‡Apporter le Livre d\'Aquor, les Griffes argentées et le Coeur d\'Arbrefer à Tanaris.nnUtiliser le Livre d\'Aquor pour invoquer Aquementas.nnAprès avoir terminé le totem, l\'apporter à J.D. Collie au refuge des Marshal.‡把阿奎尔之书、银爪和铁树之心带到塔纳利斯去。nn使用这本书召唤亚奎门塔斯。nn在图腾完成之后，把它交给马绍尔营地的科琳。‡把阿奎爾之書、銀爪，還有鐵樹心帶到塔納利斯。|n用這本書召喚亞奎門塔斯。|n當你完成圖騰之後，把它帶給在馬紹爾營地的科琳。',
  }
},
[4021] = {
  {
    'Contra-ataque!‡Контратака!‡Gegenangriff!‡반격!‡¡Contraataca!‡¡Contraataca!‡La contre-attaque !‡人马无双！‡人馬無雙!',
    nil,
    'Leve um Pedaço do Estandarte de Krom\'zar para Regthar Portões-da-morte, a oeste da Encruzilhada.‡Принесите кусок знамени Кром\'зара Регтару Вратам Смерти. Его можно найти на западе от Перекрестка.‡Bringt ein Teil von Krom\'zars Flagge zu Regthar Totenfurt, westlich des Wegekreuzes.‡크로스로드 서쪽에 있는 렉타르 데스게이트에게 크롬자르의 깃발 조각을 가져가야 합니다.‡Llévale una pieza del estandarte de Krom\'zar a Regthar Portamorta, al oeste de El Cruce.‡Mata centauros Kolkar hasta que aparezca Krom\'zar, después asesínalo y coge una pieza del estandarte de Krom\'zar.‡Apporter un Morceau de la bannière de Krom\'zar à Regthar Seuil-de-mort, à l\'ouest de la Croisée.‡将克罗姆扎军旗的碎片交给十字路口西边的雷戈萨·死门。‡將克羅姆札軍旗的碎片交給十字路口西邊的雷戈薩·死門。',
  }
},
[4022] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Mostre a Ciro Terepento a Muda de Pele da Revoada Negra que você recebeu de Kalaran Finalâmina.‡Покажите Цирусу Раскаивателю сброшенную кожу черного дракона, полученную от Каларана Ветрореза.‡Zeigt Cyrus Therepentous die abgestreifte Haut des schwarzen Drachenschwarms, die Ihr von Kalaran Windklinge erhalten habt.‡칼라란 윈드블레이드에게서 받은 검은용군단 허물을 키루스 테레펜터스에게 보여줘야 합니다.‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.|n‡Enséñale a Cyrus Therepentio la escama de Vuelo Negro que recibiste de Kalaran Espada del Viento.‡Montrer à Cyrus Therepentous l\'Ecaille des dragons noirs que vous avez reçue de Kalaran Windblade.‡向塞勒斯·萨雷芬图斯展示你从卡拉然·温布雷那里得到的黑龙皮。‡向塞勒斯·薩雷芬圖斯展示你從卡拉然·溫布雷那裡得到的黑龍軍團之皮。',
  }
},
[4023] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Mostre a Ciro Terepento uma prova de seu valor.nnVocê tem a impressão de que Ciro já sabe que você não é <digno/digna>.‡Покажите Цирусу Раскаивателю доказательство своих деяний.nnВозникает чувство, что Цирус заранее сомневается в ваших качествах.‡Zeigt Cyrus Therepentous einen Beweis für Eure Nützlichkeit.nnIhr habt so ein Gefühl, dass Cyrus bereits weiß, dass Ihr unwürdig seid.‡키루스 테레펜터스에게 자신의 가치를 증명해 보여야 합니다.nn키루스가 이미 당신이 가치가 없다는 사실을 알고 있는 것 같은 느낌이 듭니다.‡Demuéstrale a Cyrus Therepentio lo que vales.nnTe da la impresión de que Cyrus ya sabe que no eres digno.‡Demuéstrale a Cyrus Therepentio lo que vales.|nTe da la impresión de que Cyrus ya sabe que no eres digno.‡Montrer à Cyrus Lerepenti une preuve de votre valeur.nnVous avez le sentiment que Cyrus sait déjà que vous êtes indigne.‡向塞勒斯·萨雷芬图斯证明你的价值。nn你感觉到塞勒斯似乎对你不屑一顾。‡向塞勒斯·薩雷芬圖斯證明你的價值。|n你感覺到塞勒斯似乎對你不屑一顧。',
  }
},
[4024] = {
  {
    'O gosto das chamas‡Вкус пламени‡Eine Kostprobe der Flamme‡화염의 맛‡Un sabor a llamarada‡Un sabor a llamarada‡Un goût de flammes‡烈焰精华‡烈焰精華',
    nil,
    'Vá para o Abismo Rocha Negra e mate Bael\'gar.nnA única coisa que você sabe é que o gigante mora no Abismo Rocha Negra. Lembre-se de usar a Muda de Pele Alterada da Revoada Negra nos restos mortais de Bael\'gar para capturar a Essência Abrasadora.nnLeve a Essência Abrasadora Aprisionada para Ciro Terepento.‡Отправьтесь в глубины Черной горы и убейте Бейл\'Гара.nnИзвестно лишь то, что великан живет в глубинах. Воспользуйтесь измененной сброшенной шкурой черного дракона и возьмите из останков Бейл\'Гара его огненную сущность.nnОтнесите сущность Цирусу Раскаивателю.‡Begebt Euch in die Schwarzfelstiefen und tötet Bael\'Gar.nnIhr wisst lediglich, dass der Riese irgendwo in den Schwarzfelstiefen haust. Vergesst nicht, die veränderte Haut des schwarzen Drachenschwarms mit Bael\'Gars Überresten zu benutzen und damit die feurige Essenz einzufangen.nnBringt die eingeschlossene feurige Essenz zu Cyrus Therepentous zurück.‡검은바위 나락으로 가서 밸가르를 처치하십시오.nn이 거인이 검은바위 나락 내에 살고 있다는 것만 알고 있으며 밸가르의 시체에 변형된 검은용군단 허물을 사용해 불의 정수를 추출해야만 합니다.nn키루스 테레펜터스에게 담겨진 불의 정수를 가져가야 합니다.‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.nnSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia ígnea.nnLlévale la esencia ígnea encerrada a Cyrus Therepentio.‡Viaja hasta las Profundidades de Roca Negra y mata a Bael\'Gar.|nSolo sabes que el gigante vive en las Profundidades de Roca Negra. Acuérdate de usar la escama alterada de Vuelo Negro sobre los restos de Bael\'Gar para capturar la esencia ígnea.|nLlévale la esencia ígnea encerrada a Cyrus Therepentio.‡Partez pour les Profondeurs de Rochenoire et tuez Bael\'Gar.nnVous savez seulement que le géant demeure à l\'intérieur des Profondeurs de Rochenoire. N\'oublier pas d\'utiliser l\'Ecaille des dragons noirs altérée pour capturer l\'Essence flamboyante.nnApporter l\'Essence flamboyante enchâssée à Cyrus Lerepenti.‡到黑石深渊去杀掉贝尔加。nn你只知道这个巨型怪物住在黑石深渊的最深处。记住你要使用特殊的黑龙皮从贝尔加的尸体上采集烈焰精华。nn将你采集到的烈焰精华交给塞勒斯·萨雷芬图斯。‡到黑石深淵去殺掉貝爾加。|n你只知道這個巨型怪物住在黑石深淵的最深處。記住你要使用變化後的黑龍軍團之皮從貝爾加的屍體上採集烈焰精華。|n將你採集到的烈焰精華交給塞勒斯·薩雷芬圖斯。',
  }
},
[4041] = {
  {
    'O elixir Videre‡Эликсир Видере‡Das Videre-Elixier‡앞날의 비약‡El Elixir de Videre‡El Elixir de Videre‡L\'élixir de Videre‡视灵药剂‡視靈藥劑',
    nil,
    'Traga-me uma raiz do mal e, é claro, eu faço um Elixir Videre para ti.nnEu sei todo tipo de coisa sobre plantas e alquimia... Ora, eu vou te contar a história da vez que criei ouro a partir do queijo que ia comer no almoço... Ei, aonde tu vai?‡Эликсир Видере? Ну да, смогу, конечно, только принеси сначала мне эвокорень.nnВ травках и алхимии я разбираюсь неплохо... Вот послушай, как я однажды трансмутировал в золото сыр, которым собирался пообедать... Эй, ты куда?‡Klar, wenn Ihr mir eine Evowurzel bringt, dann kann ich Euch auch das Videre-Elixier machen.nnIch weiß alle möglichen Dinge über Kräuter und Alchimie... Ich könnte Euch Geschichten erzählen... zum Beispiel, wie ich mal Gold aus dem Käse gemacht habe, den ich eigentlich zum Mittagessen... he! Wo wollt Ihr hin?‡에보뿌리만 가져오쇼. 그럼 당장 앞날의 비약을 만들어 줄 테니까 말이야.nn약초 채집과 연금술에 대해서라면 이 몸이 또 일가견이 있거든. 못 믿겠소? 이거 원, 점심으로 먹으려던 치즈를 금으로 바꾼 이야기를 들려줘야 믿을라나... 어이, 이보라고. 어딜 가는 거요?‡Tráeme una raíz del mal y te haré ese Elixir Videre.nnSé mucho sobre hierbas y alquimia... ¡Podría contarte una de historias! Por ejemplo, un día transformé el queso que iba a desayunar en oro... ¡Eh! ¿Adónde vas?‡‡Apportez-moi de l\'Evoroot, et je vous ferai de l\'élixir de Videre sans problème.nnJe connais toutes sortes de choses à propos des herbes et de l\'alchimie… Tenez, par exemple, laissez-moi vous raconter la fois où j\'ai transformé le fromage que j\'étais sur le point de manger au déjeuner en or... Hé... Où allez-vous ?‡给我弄一支灵根草来，然后我就可以帮你制作视灵药剂。nn我知道许多关于草药和炼金术的事情……为什么我会知道呢？让我告诉你个故事吧，那次我把正准备当午餐吃掉的奶酪变成了金子……嘿……你要去哪儿？‡',
  }
},
[4061] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Vá para as Estepes Ardentes e recupere 10 Estilhaços Elementais Fraturados para a Hierofante Theodora Malvadania.nnVocê se lembra que Theodora mencionou que os golens e elementais dessa região são uma fonte desses estilhaços.‡Отправляйтесь в Пылающие степи и соберите 10 осколков элементалей для верховной жрицы Теодоры Мальвадании. nnТеодора упоминала, что осколки можно найти у элементалей и големов.‡Begebt Euch in die brennende Steppe und beschafft für Theodora Mulvadania 10 gerissene Elementarsplitter.nnEuch fällt ein, dass Theodora gesagt hat, die Golems und Elementare in der Gegend seien eine gute Quelle für solche Splitter.‡불타는 평원으로 가서 제사장 테오도라 뮬바다니아에게 가져갈 부서진 원소 파편 10개를 모아야 합니다.nn그 지역의 골렘과 정령들에게서 이 파편을 구할 수 있을 거라고 테오도라가 말했던 것이 기억납니다.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos elementales fracturados para Hierofante Theodora Mulvadania.nnRecuerdas que Theodora mencionó que los golems y elementales de esa región eran la fuente de estos fragmentos.‡Adéntrate en Las Estepas Ardientes y recupera 10 fragmentos elementales fracturados para Hierofante Theodora Mulvadania.|nRecuerdas que Theodora mencionó que los gólems y elementales de esa región eran la fuente de estos fragmentos.‡S\'aventurer dans les Steppes ardentes et récupérer 10 Fragments d\'élémentaires cassés pour la Hiérophante Theodora Mulvadania.nnTheodora vous a indiqué que les golems et les élémentaires étaient la source de ces fragments.‡到燃烧平原去为塞朵拉·穆瓦丹尼收集10块断裂的元素碎片。nn塞朵拉曾经说过，那里的机械傀儡和元素生物是这种碎片的主要来源。‡到燃燒平原去為塞朵拉·穆瓦丹尼收集10塊斷裂的元素裂片。|n塞朵拉曾經說過，那裡的機械魔像和元素生物是這種裂片的主要來源。',
  }
},
[4062] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Leve a Amostra de Estilhaço Elemental para Lotwil Viriato.nnSegundo Theodora, Lotwil estava escalado em um acampamento ao leste.‡Отнесите образец осколка элементаля Лотвилю Вериатусу. nnТеодора упоминала, что его лагерь находится на востоке.‡Bringt die Elementarsplitterprobe zu Lotwil Veriatus.nnIhr erinnert Euch, dass Theodora sagte, Lotwil sei in einem Lager im Osten stationiert.‡로트윌 베리아투스에게 원소 파편 견본을 가져가야 합니다.nn테오도라가 로트윌은 동쪽 야영지에 있다고 얘기했던 것이 기억납니다.‡Lleva el ejemplar de fragmento de Elemental a Lotwil Veriatus.nnRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.|n‡Lleva el ejemplar de fragmento elemental a Lotwil Veriatus.|nRecuerdas que Theodora dijo que Lotwil se encontraba en un campamento hacia el este.‡Apporter l\'Échantillon de fragment d\'élémentaire à Lotwil Veriatus.nnTheodora vous a dit qu\'il se trouvait dans un camp à l\'est.‡将元素碎片样本交给鲁特维尔·沃拉图斯。nn塞朵拉说鲁特维尔就在东边的一处营地里。‡將元素裂片樣本交給魯特維爾·沃拉圖斯。|n塞朵拉說魯特維爾就在東邊的一處營地裡。',
  }
},
[4063] = {
  {
    'O levante das máquinas‡Восстание машин‡Aufstieg der Maschinen‡기계들의 봉기‡La revuelta de las máquinas‡La revuelta de las máquinas‡La révolte des machines‡机器的崛起‡機器的崛起',
    nil,
    'Encontre e mate Lorde Golem Argelmach. Leve a cabeça dele para Lotwil. Você também precisará coletar 10 Núcleos de Elemental Intactos dos Golens Rasgafúria e Constructos Armipotentes que protegem Argelmach. Você sabe disso porque é paranormal.‡Найдите и убейте повелителя големов Аргелмаха. Принесите его голову Лотвилю. Также соберите 10 невредимых ядер стихий с беспощадных големов и созданий-завоевателей, охраняющих Аргелмаха. Информация передана посредством телепатии.‡Sucht und tötet Golemlord Argelmach. Bringt Lotwil seinen Kopf. Außerdem müsst Ihr 10 intakte Elementarkerne von den Wuthäschergolems und Kriegshetzerkonstrukten, die Argelmach beschützen, beschaffen. Das wisst Ihr, weil Ihr übernatürliche Fähigkeiten habt.‡골렘 군주 아젤마크를 찾아 처치하고 그 증거로 그의 머리카락을 로트윌에게 가져가야 합니다. 그리고 아젤마크를 호위하는 재앙의 피조물과 맹위의 전투골렘들에게서 온전한 원소핵 10개도 모아야 합니다.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los golems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres un adivino.‡Encuentra al Señor Gólem Argelmach y mátalo. Llévale su cabeza a Lotwil. Asimismo tendrás que reunir 10 núcleos de elemental intactos de los gólems Furiatracadores y de los ensamblajes belisario que protegen a Argelmach. Lo sabes porque eres <un adivino/una adivina>.‡Trouver et tuer le Seigneur des golems Argelmach. Rapporter sa tête à Lotwil. Collecter également 10 Noyaux d\'élémentaire intacts sur les Golems ravarage et les Assemblages porteguerre qui protègent Argelmach. Vous savez cela car vous êtes médium.‡找到并杀掉傀儡统帅阿格曼奇，将他的头交给鲁特维尔。你还需要从守卫着阿格曼奇的狂怒傀儡和战斗傀儡身上收集10块完整的元素核心。‡找到並殺掉魔像領主阿格曼奇，將他的頭交給魯特維爾。你還需要從守衛著阿格曼奇的狂怒魔像和戰鬥魔像身上收集10塊完整的元素核心。',
  }
},
[4081] = {
  {
    'SE VIR, MATE: Anões Ferro Negro‡УНИЧТОЖИТЬ НА МЕСТЕ: Дворфы Черного Железа‡SOFORT TÖTEN: Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠단 드워프‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡MATAR INMEDIATAMENTE: enanos Hierro Negro‡TUER À VUE : nains Sombrefer‡格杀勿论：黑铁矮人‡格殺勿論:黑鐵矮人',
    nil,
    'Desbrave o Abismo Rocha Negra e destrua aqueles invasores degenerados!nnO Senhor da Guerra Trincador quer que você mate 15 Guardas Furiadastra, 10 Carcereiros Furiadastra e 5 Soldados Rasos Furiadastra. Fale novamente com ele quando o trabalho estiver terminado.‡Отправляйтесь в Глубины Черной горы и уничтожьте подлых агрессоров! nnПо приказу полководца Клинозуба уничтожьте 15 охранников, 10 надсмотрщиков и 5 пехотинцев из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Schwarzfelstiefen und vernichtet die üblen Aggressoren!nnKriegsherr Bluthauer möchte, dass Ihr 15 Gardisten der Zorneshämmer, 10 Aufseher der Zorneshämmer und 5 Fußsoldaten der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!nn장군 고어투스가 성난모루단 보초 15명, 성난모루단 교도관 10명, 성난모루단 보병 5명을 처치해 달라고 부탁했습니다. 임무를 완수하면 장군 고어투스에게 돌아가십시오.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!nnEl señor de la guerra Dientegore quiere que mates a 15 custodios de Yunque Colérico, 10 alcaides de Yunque Colérico y 5 lacayos de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 15 celadores Yunque Colérico, 10 alcaides Yunque Colérico y 5 lacayos Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Pénétrez dans les Profondeurs de Rochenoire et tuez les vils agresseurs !nnLe chef de guerre Sangredent veut que vous tuiez 15 Gardes Ragenclumes, 10 Gardiens Ragenclumes et 5 Fantassins Ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！nn军官高图斯要你去杀死15个铁怒卫士、10个铁怒狱卒和5个铁怒步兵。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者!|n督軍高圖斯要你去殺死15個鐵怒衛士、10個鐵怒獄卒和5個鐵怒步兵。完成任務之後回去找他。',
  }
},
[4082] = {
  {
    'SE VIR, MATE: Oficiais Ferro Negro de Alta Patente‡УНИЧТОЖИТЬ НА МЕСТЕ: Высокопоставленные чины Черного Железа‡SOFORT TÖTEN: Hochrangige Führungskräfte der Dunkeleisenzwerge‡죽음의 본보기: 검은무쇠단 고위 관리‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡MATAR INMEDIATAMENTE: oficiales Hierro Negro de alto rango‡TUER À VUE : Officiers de haut rang Sombrefer‡格杀勿论：高阶黑铁军官‡格殺勿論:高階黑鐵軍官',
    nil,
    'Vá até o Abismo Rocha Negra e destrua aqueles invasores degenerados!nnO Senhor da Guerra Trincador quer que você mate 10 Socorristas Furiadastra, 10 Soldados Furiadastra e 10 Oficiais Furiadastra. Fale novamente com ele quando o trabalho for concluído.‡Отправляйтесь в Глубины Черной горы и уничтожьте подлых агрессоров! nnПо приказу полководца Клинозуба уничтожьте 10 медиков, 10 солдат и 10 офицеров из клана Ярости Горна. Вернитесь сразу по выполнении задания.‡Begebt Euch in die Schwarzfelstiefen und vernichtet die üblen Aggressoren!nnKriegsherr Bluthauer möchte, dass Ihr 10 Sanitäter der Zorneshämmer, 10 Soldaten der Zorneshämmer und 10 Offiziere der Zorneshämmer tötet. Kehrt zu ihm zurück, sobald Ihr die Aufgabe erfüllt habt.‡검은바위 나락으로 가서 사악한 침략자들을 쳐부수십시오!nn장군 고어투스가 성난모루단 간호병 10명, 성난모루단 병사 10명, 그리고 성난모루단 장교 10명을 처치해 달라고 부탁했습니다. 임무를 완수하면 고어투스에게 돌아가십시오.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!nnEl señor de la guerra Dientegore quiere que mates a 10 médicos de Yunque Colérico, 10 soldados de Yunque Colérico y 10 oficiales de Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Adéntrate en las Profundidades de Roca Negra ¡y destruye a esos viles agresores!|nEl señor de la guerra Dientegore quiere que mates a 10 médicos Yunque Colérico, 10 soldados Yunque Colérico y 10 oficiales Yunque Colérico. Vuelve junto a él cuando hayas acabado la tarea.‡Pénétrez dans les Profondeurs de Rochenoire et tuez les vils agresseurs !nnLe Chef de guerre Sangredent veut que vous tuiez 10 Médecins Ragenclumes, 10 Soldats Ragenclumes et 10 Officiers Ragenclumes. Retourner le voir une fois votre mission accomplie.‡到黑石深渊去消灭那些邪恶的侵略者！nn高图斯军阀要你杀死10个铁怒医师,、10个铁怒士兵和10个铁怒军官。完成任务之后回去向他复命。‡到黑石深淵去消滅那些邪惡的侵略者!|n督軍高圖斯要你殺死10個鐵怒醫師,、10個鐵怒士兵和10個鐵怒軍官。完成任務之後回去向他覆命。',
  }
},
[4083] = {
  {
    'Cálice Espectral‡Призрачный кубок‡Der spektrale Kelch‡유령의 성배‡El cáliz espectral‡El cáliz espectral‡Le Calice spectral‡鬼魂之杯‡鬼靈之杯',
    nil,
    'O cálice espectral flutua no ar, subindo e descendo lentamente... como se seguisse o bater de um coração agonizante.‡Призрачный кубок парит в воздухе, медленно поднимаясь и опускаясь... как будто следуя ритмам биения умирающего сердца.‡Der spektrale Kelch schwebt in der Luft, leicht ansteigend und dann absinkend, so, als bewege er sich im Takt eines sterbenden Herzens.‡유령의 성배가 마치 죽어가는 심장의 고동에 맞추어 춤을 추듯이 천천히 움직이면서 공중에 떠다닙니다.‡El cáliz espectral flota en el aire, ascendiendo y descendiendo lentamente… como el latido de un corazón moribundo.‡‡Le Calice spectral flotte dans les airs, descendant et remontant tout doucement… au rythme d\'un cœur agonisant.‡‡',
  }
},
[4084] = {
  {
    'Coração de prata‡Серебряное сердце‡Silberherz‡은색 심장‡Corazón de plata‡Corazón de plata‡Coeur d\'argent‡银爪铁心‡銀爪鐵心',
    nil,
    'Colete 11 Garras Prateadas e 1 Coração de Ferrárbol para Eridan Brisazul na Selva Maleva.‡Добудьте 11 серебристых когтей и 1 сердце Железнолесья для Эриданы Грусти Ветра.‡Beschafft 11 silbrige Klauen und 1 Eisenstammherz für Eridan Blauwind im Teufelswald.‡악령의 숲에 있는 에리단 블루윈드에게 은백색 발톱 11개와 강철나무 심장 1개를 가져가야 합니다.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Recoge 11 zarpas plateadas y 1 corazón de Troncoferro para Eridan Vientoazul de Frondavil.‡Trouver 11 Griffes d\'argent et 1 Cœur d\'Arbrefer pour Eridan Ventebleu à Gangrebois.‡为费伍德森林的艾瑞丹·蓝风收集11只银爪和1颗铁树之心。‡為費伍德森林的艾瑞丹·藍風收集11隻銀爪和1顆鐵樹之心。',
  }
},
[4101] = {
  {
    'Purificar Selva Maleva‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령의 숲 정화‡Limpiar Frondavil‡Limpiar Frondavil‡Purifiez Gangrebois‡净化费伍德‡淨化費伍德',
    nil,
    'Leve 15 Âmbares de Sangue para Arathandris Argencélio na Selva Maleva.‡Принесите 15 кровавых янтарей Аратандис Серебряному Небу в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Arathandris Silberwolke im Teufelswald.‡악령의 숲에 있는 아라탄드리스 실버스카이에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de ámbar de sangre a Arathandris Cielargente a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Arathandris Cielargento a Frondavil.‡Apporter 15 Ambres de sang à Arathandris Argeciel à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的阿拉珊蒂丝·银空。‡收集15顆血琥珀，把它們交給費伍德森林的阿拉珊蒂絲·銀空。',
  }
},
[4102] = {
  {
    'Purificar Selva Maleva‡Очищение Оскверненного леса‡Den Teufelswald säubern‡악령의 숲 정화‡Limpiar Frondavil‡Limpiar Frondavil‡Purifiez Gangrebois‡净化费伍德‡淨化費伍德',
    nil,
    'Leve 15 Âmbares de Sangue para Maibess Brisa do Rio em Selva Maleva.‡Принесите 15 кровавых янтарей Майбессе Речному Ветру в Оскверненный лес.‡Bringt 15 Einheiten Blutharz zu Maybess Flussbrise im Teufelswald.‡악령의 숲에 있는 메이베스 리버브리즈에게 핏빛 호박석 15개를 가져가야 합니다.‡Lleva 15 unidades de ámbar de sangre a Maybess Brisafluvial a Frondavil.‡Lleva 15 unidades de ámbar de sangre a Maybess Brisa de Río a Frondavil.‡Apporter 15 Ambres de sang à Maybess Brise-des-rivières à Gangrebois.‡收集15颗血琥珀，把它们交给费伍德森林的梅贝丝·河风。‡收集15顆血琥珀，把它們交給費伍德森林的梅貝絲·河風。',
  }
},
[4103] = {
  {
    'Bálsamo via caça‡Лекарство из охотничьих трофеев‡Salbe durch Jagd‡사냥을 통한 고약 확보‡Bálsamo por caza‡Bálsamo por caza‡Du baume en chassant‡狩猎换药膏‡狩獵換藥膏',
    nil,
    'Os lampiões cenarianos permitem que o portador enxergue estilhaços de alma corrompida nas feras que são abatidas por um bem maior. Esses estilhaços são triturados para fazer um reagente com o qual preparo o bálsamo vegetal cenariano. Usaremos esse bálsamo para devolver a saúde a plantas corrompidas.nnEm troca desses estilhaços, darei a você um pouco do bálsamo vegetal cenariano que já preparei.‡Тот, кто имеет при себе Маяк Кенария, может оскверненные осколки души затронутых порчей животных, убитых ради вящего блага. Я измельчаю эти осколки и делаю из них реактив, который идет на изготовление кенарийского бальзама исцеления растений. Мы используем это средство для исцеления пораженных порчей растений.nnЗа эти осколки я дам тебе немного уже готового кенарийского бальзама исцеления растений.‡Wer ein cenarisches Leuchtfeuer besitzt, kann mit diesem die verderbten Seelensplitter in den besudelten Bestien sehen, die zum Wohl der Allgemeinheit vernichtet werden. Ich schleife Splitter zu einem nutzbaren Reagenz, das für die Herstellung von cenarischer Pflanzensalbe verwendet wird. Wir werden diese Salbe benutzen, um verderbte Pflanzen wieder in gesunde zu verwandeln.nnIm Austausch für diese Splitter werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡세나리온 등불을 지니고 있으면 정의를 위해 처치한 타락한 짐승들에게서 오염된 영혼의 조각를 볼 수 있어요. 이 조각을 갈아서 세나리온 식물 고약을 만드는 재료로 쓰죠. 그 고약을 사용하면 오염된 식물들을 다시 건강하게 되살릴 수 있을 거예요.nn그 조각을 가져오면 제가 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡Una antorcha Cenarion te permite ver un fragmento de alma corrupto en esas bestias corruptas que deben ser sacrificadas por un bien mayor. Yo pulverizo los fragmentos y los convierto en un componente con el que se crea el bálsamo de planta de Cenarion. Y es lo que utilizaremos para sanar a las plantas corruptas.nnA cambio de esos fragmentos, te daré algunos bálsamos de planta de Cenarion que ya tengo preparados.‡‡Si vous possédez une Balise cénarienne, vous pourrez discerner un fragment d\'esprit corrompu sur les bêtes souillées que nous supprimons pour le plus grand bien de tous. Je broie ces fragments jusqu\'à obtenir un réactif dont je me sers pour confectionner le Baume végétal cénarien qui permet de rendre santé et vigueur à ces plantes corrompues.nnEn échange de ces fragments, je vous donnerai du Baume cénarien que j\'ai déjà préparé.‡只要你拿着塞纳里奥信标，你就能从那些堕落的野兽身上找到被污染的灵魂碎片，为了费伍德森林的未来，你一定要要拿到那些碎片。我会对碎片进行研磨加工，将其制成塞纳里奥植物药膏。我们可以用这种药膏拯救那些奄奄一息的堕落植物。nn如果你能给我弄些碎片来，我就可以给你几份植物药膏。‡',
  }
},
[4104] = {
  {
    'Bálsamo via mineração‡Лекарство из минералов‡Salbe durch Bergbau‡채광을 통한 고약 확보‡Bálsamo por minería‡Bálsamo por minería‡Du baume par la pioche‡采矿换药膏‡採礦換藥膏',
    nil,
    '‡Если во время поиска ископаемых в Оскверненном лесу у тебя будет с собой Маяк Кенария, ты сможешь найти порченый купорос, проникающий в жилы металлов. Я знаю, как очищать этот купорос и превращать его в реактив, который идет на изготовление кенарийского бальзама исцеления растений. Затем этим бальзамом можно исцелять пораженные растения.nnЕсли ты принесешь мне порченого купороса, я дам тебе уже готового кенарийского бальзама исцеления растений.‡Wenn Ihr im Besitz eines cenarischen Leuchtfeuers seid, während Ihr im Teufelswald Bergbau betreibt, könnt Ihr das besudelte Vitriol sehen, von dem eine Ader Rohmetall verderbt wird. Ich weiß, wie man dieses Vitriol läutert und zu einem Reagenz verarbeitet, aus dem cenarische Pflanzensalbe hergestellt wird. Diese Salbe verwendet Ihr dann an Pflanzen, die Ihr draußen in der Wildnis findet und die gerettet werden müssen.nnWenn Ihr verderbtes Vitriol gesammelt habt, werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡악령의 숲에서 채광할 때 세나리온 등불을 가지고 있으면 광맥을 오염시키는 황산을 볼 수 있어요. 제가 그 황산을 정화시켜 세나리온 식물 고약의 재료로 바꾸는 방법을 알고 있어요. 숲에서 오염된 식물들을 찾으면 이 고약을 사용하여 정화하시면 되요.nn제게 오염된 황산을 모아 주시면 그 대가로 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡Si llevas una antorcha Cenarion mientras trabajas en los yacimientos de Frondavil, podrás ver el vitriolo contaminado que corrompe una veta del metal. Yo sé cómo purificar ese vitriolo y cómo convertirlo en un componente del bálsamo de planta de Cenarion. Un bálsamo que podrás utilizar para salvar las plantas que encuentres en el bosque.nnSi me traes algo de vitriolo contaminado, te daré un bálsamo de planta de Cenarion que tengo preparado.‡‡Si vous avez une Balise cénarienne et que vous minez dans Gangrebois, peut-être trouverez-vous du Vitriol contaminé dans un filon de minerai brut. Je sais comment purifier ce vitriol et le transformer en un composant qui sert à faire du Baume végétal cénarien. Vous pourrez ensuite l\'utiliser pour libérer les plantes corrompues que vous rencontrerez.nnSi vous avez collecté du Vitriol contaminé, je vous l\'échange contre du Baume végétal cénarien que j\'ai déjà préparé.‡‡',
  }
},
[4105] = {
  {
    'Bálsamo via coleta‡Лекарство из оскверненных трав‡Salbe durch Sammlung‡약초채집을 통한 고약 확보‡Bálsamo por recolección‡Bálsamo por recolección‡Du baume contre une récolte‡采集换药膏‡採集換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному травнику замечать коварный зародыш Скверны – мерзостный результат поразившей Оскверненный лес порчи. В результате долгих моих трудов здесь мне удалось научиться превращать зародыш Скверны в очищающее вещество... которое мы используем для приготовления так называемого кенарийского бальзама исцеления растений.nnВо время сбора растений в Оскверненном лесу ты сможешь замечать зародыш Скверны, пока на тебе лежит заклятие "Маяк Кенария". За то, что ты мне принесешь, я дам тебе уже готового бальзама Кенария.‡Mit einem cenarischen Leuchtfeuer können erfahrene Kräuterkundige die heimtückische Teufelsranke erkennen, ein bösartiges Produkt der Verderbnis des Teufelswalds. Dank meiner Arbeit verfüge ich über das Wissen, die Teufelsranke zu einem Säuberungsreagenz verarbeiten zu können. Dieses verwenden wir für etwas, das wir jetzt cenarische Pflanzensalbe nennen.nnWenn Ihr im Teufelswald Kräuter sammelt, dann solltet Ihr, solange Ihr das Leuchtfeuer bei Euch habt, auf Teufelsranken stoßen. Im Austausch gegen das, was Ihr mir bringt, werde ich Euch fertige cenarische Pflanzensalbe geben.‡‡Una antorcha Cenarion permite a un herborista experimentado detectar cualquier agente máculo insidioso, un criminal producto de la corrupción de Frondavil. Trabajando aquí he aprendido a purificar el agente máculo y convertirlo en un agente purificador... uno que se usa en lo que ahora llamamos bálsamo de planta de Cenarion.nnSi llevas la antorcha contigo mientras recoges hierbas en Frondavil, deberías poder ver el agente máculo. A cambio de lo que me traigas, te daré un poco de bálsamo de planta de Cenarion que tengo ya preparado.‡‡Grâce à une balise cénarienne, les herboristes expérimentés peuvent distinguer l\'insidieuse gangrimpante, un parasite malfaisant produit par la corruption de Gangrebois. Mon travail ici m\'a appris à les purifier avec un réactif... utilisé dans ce que nous appelons le baume végétal cénarien.nnLorsque vous cueillerez des herbes à Gangrebois, vous devriez remarquer les brins de gangrimpante si vous avez la balise cénarienne. En échange je vous donnerai du baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[4106] = {
  {
    'Bálsamo via esfolamento‡Лекарство из оскверненных шкур‡Salbe durch Kürschnerei‡무두질을 통한 고약 확보‡Bálsamo por desuello‡Bálsamo por desuello‡Du baume contre des peaux‡剥皮换药膏‡剝皮換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному специалисту по снятию шкур находить куски пораженных порчей шкур среди добытого в Оскверненном лесу добра. Я перерабатываю эти вроде бы бесполезные обрывки в густую пасту, которая ускоряет действие кенарийского бальзама исцеления растений. Когда ты будешь свежевать туши убитых в Оскверненном лесу животных, позаботься, чтобы на тебе лежало заклятие Маяка Кенария!nnКогда соберешь порченые клочки, принеси их мне, и я дам тебе немного готового кенарийского бальзама исцеления растений.‡Mit einem cenarischen Leuchtfeuer können gut ausgebildete Kürschner die Flecken besudelter Haut auf den im Teufelswald erbeuteten Fellen erkennen. Ich wandle diese scheinbar nutzlosen Flecken in eine dicke Paste um, mit der die cenarische Pflanzensalbe aktiviert wird. Wenn Ihr hier im Teufelswald Eure Beute häutet, dann solltet Ihr unbedingt immer ein Leuchtfeuer bei Euch haben.nnSobald Ihr besudelte Flecken gesammelt habt, bringt sie mir. Ich gebe Euch etwas cenarische Pflanzensalbe dafür, die ich bereits hergestellt habe.‡숙련된 무두장이가 세나리온 등불을 지니고 있으면 악령의 숲에서 모은 짐승의 가죽에서 오염된 부분을 찾아낼 수 있어요. 저는 이 쓸모 없어 보이는 조각들을 두꺼운 반죽으로 만들어 세나리온 식물 고약의 촉진제로 사용하지요. 이 악령의 숲에서 사냥한 짐승들의 가죽을 벗길 때는 꼭 이 등불을 지니고 계세요!nn오염된 가죽 조각을 모으면 제게 가지고 오세요. 그러면 제가 미리 만들어둔 세나리온 식물 고약을 드리겠어요.‡‡‡Une balise cénarienne permet à un dépeceur bien entraîné de repérer des morceaux de peau contaminée dans le butin ramassé à Gangrebois. Je transforme ces morceaux apparamment inutiles en pâte épaisse qui sert d\'agent accélérateur au baume végétal cénarien. Quand vous dépecez vos prises ici à Gangrebois, assurez-vous d\'avoir toujours une balise sur vous !nnLorsque vous ramassez des morceaux de peau contaminée, apportez-les-moi et je vous donnerai des doses de baume végétal cénarien que j\'ai en réserve.‡训练有素的剥皮匠可以用塞纳里奥信标从费伍德森林里的生物身上找到被污染的毛皮，我可以把这些皮制作成塞纳里奥植物药膏。nn当你在这里采集兽皮的时候，记得带上信标。给我弄些被污染的毛皮来，我就可以给你几份药膏。‡',
  }
},
[4107] = {
  {
    'Bálsamo via desencantamento‡Лекарство из распыленных предметов‡Salbe durch Entzauberung‡마력 추출을 통한 고약 확보‡Bálsamo por desencantamiento‡Bálsamo por desencantamiento‡Du baume contre des désenchantements‡分解换药膏‡分解換藥膏',
    nil,
    '‡Сила магического предмета соответствует силе эссенций, получающихся в результате его распыления. Мной изобретен способ переработки сырой субстанции, используемой зачаровывателями, в реактив, пригодный для создания кенарийского бальзама исцеления растений. Для этого тебе не нужен Маяк Кенария. Подойдет любой предмет, с которого сняты чары, и который выделяет простую субстанцию Пустоты.nnМне нужна всего одна порция простой субстанции Пустоты, а за это я тебе дам бальзама исцеления Кенария. Эта субстанция чрезвычайно сильна – даже малого количества хватит надолго!‡Die Macht eines entzauberten magischen Gegenstandes ist in der von ihm geschaffenen Essenz spürbar. Ich habe einen Weg gefunden, um die rohe Essenz, die von Verzauberern verwendet wird, in ein geeignetes Reagenz für die cenarische Pflanzensalbe umzuwandeln. Dazu braucht Ihr kein cenarisches Leuchtfeuer; jeder angemessen entzauberte Gegenstand, der geringe Netheressenzen abgibt, ist dafür geeignet.nnIch brauche nur eine einzige geringe Netheressenz; im Austausch dafür werde ich Euch cenarische Pflanzensalben geben. Die Essenz ist hochwirksam - ganz wenig davon genügt, um viel zu erreichen.‡마력이 풀린 물건의 힘은 그 안에서 만들어지는 정수로 느낄 수 있지요. 저는 마법부여사들이 사용하는 천연 정수를 세나리온 식물 고약을 만드는 데 알맞은 시약으로 바꾸는 방법을 알아냈어요. 여기에는 세나리온 등불이 필요하지 않아요. 마력이 풀려 하급 황천의 정수가 나오는 물건이면 되죠.nn하급 황천의 정수만 있으면 정말 좋을 텐데! 그 정수는 굉장히 강력해서 조금만 구해도 큰 일을 해낼 수가 있거든요. 가져다주시면 보답으로 세나리온 식물 고약을 드리죠.‡‡‡Le pouvoir d\'un objet magique désenchanté est éprouvé par l\'essence qu\'il crée. J\'ai conçu un moyen de transformer l\'essence brute utilisée par les enchanteurs en un réactif qui permet de créer du Baume végétal cénarien. Vous n\'avez pas besoin de Balise cénarienne dans ce cas. N\'importe quel objet désenchanté qui produit des essences inférieures fera parfaitement l\'affaire.nnJe n\'ai besoin que d\'une seule essence inférieure. En échange, je vous donnerai du Baume végétal cénarien. L\'essence est très puissante. Il en faut peu pour faire beaucoup !‡‡',
  }
},
[4108] = {
  {
    'Bálsamo via caça‡Лекарство из охотничьих трофеев‡Salbe durch Jagd‡사냥을 통한 고약 확보‡Bálsamo por caza‡Bálsamo por caza‡Du baume en chassant‡狩猎换药膏‡狩獵換藥膏',
    nil,
    'Os lampiões cenarianos permitem que o portador enxergue estilhaços de alma corrompida nas feras que são abatidas por um bem maior. Esses estilhaços são triturados para fazer um reagente com o qual preparo o bálsamo vegetal cenariano. Usaremos esse bálsamo para devolver a saúde a plantas corrompidas.nnEm troca desses estilhaços, darei a você um pouco do bálsamo vegetal cenariano que já preparei.‡Обладание Маяком Кенария позволяет увидеть оскверненные осколки души затронутых порчей животных, убитых ради вящего блага. Я измельчаю эти осколки и делаю из них реактив, который идет на изготовление кенарийского бальзама исцеления растений. Мы используем это средство для исцеления пораженных порчей растений.nnЗа эти осколки я дам тебе немного уже готового кенарийского бальзама исцеления растений.‡Wer ein cenarisches Leuchtfeuer besitzt, kann mit diesem die verderbten Seelensplitter in den besudelten Bestien sehen, die zum Wohl der Allgemeinheit vernichtet werden. Ich schleife Splitter zu einem nutzbaren Reagenz, das für die Herstellung von cenarischer Pflanzensalbe verwendet wird. Wir werden diese Salbe benutzen, um verderbte Pflanzen wieder in gesunde zu verwandeln.nnIm Austausch für diese Splitter werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡세나리온 등불을 지니고 있으면 정의를 위해 처치한 타락한 짐승들에게서 오염된 영혼의 조각를 볼 수 있어요. 이 조각을 갈아서 세나리온 식물 고약을 만드는 재료로 쓰죠. 그 고약을 사용하면 오염된 식물들을 다시 건강하게 되살릴 수 있을 거예요.nn그 조각을 가져다주면 제가 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡Una antorcha Cenarion te permite ver un fragmento de alma corrupto en esas bestias corruptas que deben ser sacrificadas por un bien mayor. Yo pulverizo los fragmentos y los convierto en un componente con el que se crea el bálsamo de planta de Cenarion. Y es lo que utilizaremos para sanar a las plantas corruptas.nnA cambio de esos fragmentos, te daré algunos bálsamos de planta de Cenarion que ya tengo preparados.‡‡Si vous possédez une Balise cénarienne, vous pourrez discerner un fragment d\'esprit corrompu sur les bêtes souillées que nous supprimons pour le plus grand bien de tous. Je broie ces fragments jusqu\'à obtenir un réactif dont je me sers pour confectionner le Baume végétal cénarien qui permet de rendre santé et vigueur à ces plantes corrompues.nnEn échange de ces fragments, je vous donnerai du Baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[4109] = {
  {
    'Bálsamo via mineração‡Лекарство из минералов‡Salbe durch Bergbau‡채광을 통한 고약 확보‡Bálsamo por minería‡Bálsamo por minería‡Du baume par la pioche‡采矿换药膏‡採礦換藥膏',
    nil,
    '‡Если во время поиска ископаемых в Оскверненном лесу у тебя будет с собой Маяк Кенария, ты сможешь найти порченый купорос, проникающий в жилы металлов. Я знаю, как очищать этот купорос и превращать его в реактив, который идет на изготовление кенарийского бальзама исцеления растений. Затем этим бальзамом можно исцелять пораженные растения.nnЕсли ты принесешь мне порченого купороса, я дам тебе уже готового кенарийского бальзама исцеления растений.‡Wenn Ihr im Besitz eines cenarischen Leuchtfeuers seid, während Ihr im Teufelswald Bergbau betreibt, könnt Ihr das besudelte Vitriol sehen, von dem eine Ader Rohmetall verderbt wird. Ich weiß, wie man dieses Vitriol läutert und zu einem Reagenz verarbeitet, aus dem cenarische Pflanzensalbe hergestellt wird. Diese Salbe verwendet Ihr dann an Pflanzen, die Ihr draußen in der Wildnis findet und die gerettet werden müssen.nnWenn Ihr verderbtes Vitriol gesammelt habt, werde ich Euch etwas cenarische Pflanzensalbe geben, die ich bereits vorbereitet habe.‡악령의 숲에서 채광할 때 세나리온 등불을 가지고 있으면 광맥을 오염시키는 황산을 볼 수 있어요. 제가 그 황산을 정화시켜 세나리온 식물 고약의 재료로 바꾸는 방법을 알고 있어요. 숲에서 오염된 식물들을 찾으면 이 고약을 사용해 정화해 주세요.nn오염된 황산을 모아오면 그 대가로 제가 미리 준비해둔 세나리온 식물 고약을 드리겠어요.‡Si llevas una antorcha Cenarion mientras trabajas en los yacimientos de Frondavil, podrás ver el vitriolo contaminado que corrompe una veta de metal. Yo sé cómo purificar ese vitriolo y cómo convertirlo en un componente del bálsamo de planta de Cenarion. Un bálsamo que podrás utilizar para salvar las plantas que encuentres en el bosque.nnSi me traes algo de vitriolo contaminado, te daré un bálsamo de planta de Cenarion que tengo preparado.‡‡Si vous avez une Balise cénarienne et que vous minez dans Gangrebois, peut-être trouverez-vous du Vitriol contaminé dans un filon de minerai brut. Je sais comment purifier ce vitriol et le transformer en un composant qui sert à faire du Baume végétal cénarien. Vous pourrez ensuite l\'utiliser pour libérer les plantes corrompues que vous rencontrerez.nnSi vous avez collecté du Vitriol contaminé, je vous l\'échange contre du Baume végétal cénarien que j\'ai déjà préparé.‡‡',
  }
},
[4110] = {
  {
    'Bálsamo via coleta‡Лекарство из оскверненных трав‡Salbe durch Sammlung‡약초채집을 통한 고약 확보‡Bálsamo por recolección‡Bálsamo por recolección‡Du baume contre une récolte‡采集换药膏‡採集換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному травнику замечать коварный зародыш Скверны – мерзостный результат поразившей Оскверненный лес порчи. В результате долгих моих трудов здесь мне удалось научиться превращать зародыш Скверны в очищающее вещество... которое мы используем для приготовления так называемого кенарийского бальзама исцеления растений.nnВо время сбора растений в Оскверненном лесу ты сможешь замечать зародыш Скверны, пока на тебе лежит заклятие "Маяк Кенария". За то, что ты мне принесешь, я дам тебе уже готового кенарийского бальзама.‡Mit einem cenarischen Leuchtfeuer können erfahrene Kräuterkundige die heimtückische Teufelsranke erkennen, ein bösartiges Produkt der Verderbnis des Teufelswalds. Dank meiner Arbeit verfüge ich über das Wissen, die Teufelsranke zu einem Läuterungsreagenz verarbeiten zu können. Dieses verwenden wir für etwas, das wir jetzt cenarische Pflanzensalbe nennen.nnWenn Ihr im Teufelswald Kräuter sammelt, dann solltet Ihr, solange Ihr das Leuchtfeuer bei Euch habt, auf Teufelsranken stoßen. Im Austausch gegen das, was Ihr mir bringt, werde ich Euch fertige cenarische Pflanzensalbe geben.‡‡Una antorcha Cenarion permite a un herborista experimentado detectar cualquier agente máculo insidioso, ese criminal producto de la corrupción de Frondavil. Trabajando aquí he aprendido a purificar el agente máculo y convertirlo en un agente purificador... uno que se usa en lo que ahora llamamos bálsamo de planta de Cenarion.nnSi llevas la antorcha contigo mientras recoges hierbas en Frondavil, deberías poder ver el agente máculo. A cambio de lo que me traigas, te daré un poco de bálsamo de planta de Cenarion que tengo ya preparado.‡‡Grâce à une balise cénarienne, les herboristes expérimentés peuvent distinguer l\'insidieuse gangrimpante, un parasite malfaisant produit par la corruption de Gangrebois. Mon travail ici m\'a appris à les purifier avec un réactif... utilisé dans ce que nous appelons le baume végétal cénarien.nnLorsque vous cueillerez des herbes à Gangrebois, vous devriez remarquer les brins de gangrimpante si vous avez la balise cénarienne. En échange je vous donnerai du baume cénarien que j\'ai déjà préparé.‡‡',
  }
},
[4111] = {
  {
    'Bálsamo via esfolamento‡Лекарство из оскверненных шкур‡Salbe durch Kürschnerei‡무두질을 통한 고약 확보‡Bálsamo por desuello‡Bálsamo por desuello‡Du baume contre des peaux‡剥皮换药膏‡剝皮換藥膏',
    nil,
    '‡Маяк Кенария позволяет опытному специалисту по снятию шкур находить куски пораженной порчей шкур среди добытого в Оскверненном лесу добра. Я перерабатываю эти вроде бы бесполезные обрывки в густую пасту, которая ускоряет действие кенарийского бальзама исцеления растений. Когда ты будешь свежевать туши убитых в Оскверненном лесу животных, позаботься, чтобы на тебе лежало заклятие Маяка Кенария!nnКогда соберешь испорченные куски, принеси их мне, и я дам тебе немного готового кенарийского бальзама исцеления растений.‡Mit einem cenarischen Leuchtfeuer können gut ausgebildete Kürschner die Flecken besudelter Haut auf den im Teufelswald erbeuteten Fellen erkennen. Ich wandle diese scheinbar nutzlosen Flecken in eine dicke Paste um, mit der die cenarische Pflanzensalbe aktiviert wird. Wenn Ihr hier im Teufelswald Eure Beute häutet, dann solltet Ihr unbedingt immer ein Leuchtfeuer bei Euch haben.nnSobald Ihr besudelte Flecken gesammelt habt, bringt sie mir. Ich gebe Euch einige cenarische Pflanzensalben dafür, die ich bereits hergestellt habe.‡‡Una antorcha Cenarion permite a un desollador experto detectar parches de piel manchados en las presas cazadas en Frondavil. Yo convierto esos parches aparentemente inútiles en una pasta espesa que utilizo después como agente acelerador para el bálsamo de planta Cenarion. Cuando desuelles las presas que caces en Frondavil, asegúrate de llevar una antorcha contigo.nnSi recoges parches manchados, tráemelos y te daré unos bálsamos de planta Cenarion que tengo preparados.‡‡Une balise cénarienne permet à un dépeceur bien entraîné de repérer des morceaux de peau contaminée dans le butin ramassé à Gangrebois. Je transforme ces morceaux apparamment inutiles en pâte épaisse qui sert d\'agent accélérateur au baume végétal cénarien. Quand vous dépecez vos prises ici à Gangrebois, assurez-vous d\'avoir toujours une balise sur vous !nnLorsque vous ramassez des morceaux de peau contaminée, apportez-les-moi et je vous donnerai des doses de baume végétal cénarien que j\'ai en réserve.‡‡',
  }
},
[4112] = {
  {
    'Bálsamo via desencantamento‡Лекарство из распыленных предметов‡Salbe durch Entzauberung‡마력 추출을 통한 고약 확보‡Bálsamo por desencanto‡Bálsamo por desencantamiento‡Du baume contre des désenchantements‡分解换药膏‡分解換藥膏',
    nil,
    '‡Сила магического предмета соответствует силе эссенций, получающихся в результате его распыления. Мной изобретен способ переработки сырой субстанции, используемой зачаровывателями, в реактив, пригодный для создания кенарийского бальзама исцеления растений. Для этого тебе не нужен Маяк Кенария. Подойдет любой предмет, с которого сняты чары, и который выделяет простую субстанцию Пустоты.nnМне нужна всего одна порция простой субстанции Пустоты, а за это я тебе дам кенарийского бальзама исцеления. Эта субстанция чрезвычайно сильна – даже малого количества хватит надолго!‡Die Macht eines entzauberten magischen Gegenstandes ist in der von ihm geschaffenen Essenz spürbar. Ich habe einen Weg gefunden, um die rohe Essenz, die von Verzauberern verwendet wird, in ein geeignetes Reagenz für die cenarische Pflanzensalbe umzuwandeln. Dazu braucht Ihr kein cenarisches Leuchtfeuer; jeder angemessen entzauberte Gegenstand, der geringe Netheressenzen abgibt, ist dafür geeignet.nnIch brauche nur eine einzige geringe Netheressenz; im Austausch dafür werde ich Euch cenarische Pflanzensalben geben. Die Essenz ist hochwirksam - ganz wenig davon genügt, um viel zu erreichen.‡‡‡‡Le pouvoir d\'un objet magique désenchanté est éprouvé par l\'essence qu\'il crée. J\'ai conçu un moyen de transformer l\'essence brute utilisée par les enchanteurs en un réactif qui permet de créer du Baume végétal cénarien. Vous n\'avez pas besoin de Balise cénarienne dans ce cas. N\'importe quel objet désenchanté qui produit des essences inférieures fera parfaitement l\'affaire.nnJe n\'ai besoin que d\'une seule essence inférieure. En échange, je vous donnerai du Baume végétal cénarien. L\'essence est très puissante. Il en faut peu pour faire beaucoup !‡‡',
  }
},
[4113] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, was wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 고약한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4114] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4115] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, was wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡你找到了一株病怏怏的、被腐化了的迎风花。这株植物上面挂着的果实看上去已经腐烂，而且含有剧毒。你得想办法让它恢复到正常状态。‡',
  }
},
[4116] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4117] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, was wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una blancoria. De la planta cuelga una sustancia viscosa y las raíces visibles parecen endurecidas, como si fueran de cuero. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4118] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4119] = {
  {
    'Dragão noturno corrompido‡Оскверненный ночной дракон‡Verderbter Nachtdrache‡오염된 어둠용풀‡Dragón nocturno corrupto‡Dragón nocturno corrupto‡Dragon nocrturne corrompu‡被腐化的夜龙草‡被腐化的夜龍草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на Ночного дракона. Плоды его тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, was wie eine Nachtdrachenpflanze aussieht. Die Früchte, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una planta dragón nocturno. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert la version malade et souffreteuse d\'une plante, le dragon nocturne. Les fruits qui pendent de la plante sont pourris et empoisonnés. La plante a désespérément besoin de soins pour retrouver son état normal.‡‡',
  }
},
[4120] = {
  {
    'A força da corrupção‡Сила порчи‡Die Kraft der Verderbnis‡타락의 힘‡La fuerza de la corrupción‡La fuerza de la corrupción‡La force de la corruption‡堕落的力量‡腐化的力量',
    nil,
    'Talo Casco de Espinhos da Aldeia Mojache em Feralas quer que você mate 12 Ursos-cinzentos Garraivoso e 12 Assoladores Patavil em Selva Maleva.‡Убейте 12 гризли злобных когтей и 12 опустошителей-сквернолапов в Оскверненном лесу по просьбе Тало Тернового Копыта из лагеря Мохаче.‡Talo Dornhuf im Camp Mojache in Feralas möchte, dass Ihr 12 Wutklauengrizzlys und 12 Teufelspfotenverheerer im Teufelswald erledigt.‡페랄라스의 모자케 야영지에 있는 탈로 쏜후프가 악령의 숲에 있는 성난발톱불곰 12마리와 갈퀴발톱 악령발늑대 12마리를 처치해 달라고 부탁했습니다.‡Talo Pezuñahendida, del Campamento Mojache de Feralas, quiere que mates a 12 pardos Zarpira y 12 devastadores Zarpayel de Frondavil.‡Talo Pezuñahendida, del Campamento Mojache de Feralas, quiere que mates a 12 pardos Zarpira y 12 devastadores Zarpayel de Frondavil.‡Talo Sabot-de-ronce, du Camp Mojache en Féralas, voudrait que vous tuiez 12 Grizzlys de la griffe colérique et 12 Ravageurs Gangrepatte, à Gangrebois.‡菲拉斯莫沙彻营地的塔罗·刺蹄要你去费伍德森林杀掉12头怒爪灰熊和12头魔爪掠夺者。‡菲拉斯莫沙徹營地的塔羅·刺蹄要你去費伍德森林殺掉12頭怒爪灰熊和12頭魔爪劫毀者。',
  }
},
[4121] = {
  {
    'Situação precária‡Опасное положение‡Gefährliche Zwickmühle‡곤경‡¡Estás en un aprieto!‡¡Estás en un aprieto!‡Situation précaire‡押送囚徒‡押送囚徒',
    nil,
    'Escolte seu prisioneiro, Grark Lorkrub, pelas Estepes Ardentes, atravessando a Montanha Rocha Negra até chegar à Garganta Abrasadora.nnVocê se lembra de ter ouvido Lexlort dizer que mandaria seus homens esperar no outro lado para levar Grark sob custódia.nnVocê também vai precisar entregar os Grilhões de Tório para Lexlort.‡Отконвоируйте пленника, Грарка Лорктуба, через Пылающие степи и Черную гору к Тлеющему ущелью.nnЛекслорт что-то говорил насчет того, что по другую сторону будут ждать его ребята, которые уведут Грарка в тюрьму.nnТакже отдайте Лекслорту ториевые оковы.‡Eskortiert Euren Gefangenen, Grark Lorkrub, durch die brennende Steppe und durch den Schwarzfels in die sengende Schlucht.nnEuch fällt ein, dass Lexlort gesagt hat, seine Männer würden auf der anderen Seite warten, um Grark in Gewahrsam zu nehmen.nnIhr werdet außerdem Eure Thoriumfesseln an Lexlort übergeben müssen.‡포로인 그랄크 로크럽을 호송해 불타는 평원을 지나고 검은바위 산을 넘어 이글거리는 협곡으로 가야 합니다.nn반대편에서 렉스로트의 부하들이 기다리다가 그랄크 로크럽을 인계받도록 하겠다고 렉스로트가 말했던 것이 기억납니다.nn또한 토륨 족쇄를 렉스로트에게 전해주어야 합니다.‡Escolta al prisionero, Grark Lorkrub, a través de Las Estepas Ardientes y la Montaña Roca Negra hasta La Garganta de Fuego.nnRecuerdas que Lexlort mencionó que tendría a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.nnTambién tendrás que entregarle a Lexlort los grilletes de torio.‡Escolta al prisionero, Grark Lorkrub, a través de Las Estepas Ardientes y la Montaña Roca Negra hasta La Garganta de Fuego.|nRecuerdas que Lexlort mencionó que tendría a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.|nTambién tendrás que entregarle a Lexlort los grilletes de torio.‡Escortez votre prisonnier, Grark Lorkrub, au-delà des Steppes ardentes et du mont Rochenoire, jusqu\'à la gorge des Vents brûlants.nnRappelez-vous que Lexlort a précisé que ses hommes attendraient de l\'autre côté pour arrêter Grark.nnOn vous demandera également de remettre vos chaînes en thorium à Lexlort.‡押送你的囚犯格拉克·洛克鲁布。穿过燃烧平原和黑石山脉，一直走到灼热峡谷。nn雷克斯洛特曾经告诉过你，他会让他的人等在黑石山脉的另外一边准备接收格拉克。nn另外，你还要把瑟银镣铐一并还给雷克斯洛特。‡押送你的囚犯格拉克·洛克魯布。穿過燃燒平原和黑石山脈，一直走到灼熱峽谷。|n雷克斯洛特曾經告訴過你，他會讓他的人等在黑石山脈的另外一邊準備接收格拉克。|n另外，你還要把瑟銀鐐銬一併還給雷克斯洛特。',
  }
},
[4122] = {
  {
    'Grark Lorkrub‡Грарк Лоркруб‡Grark Lorkrub‡그랄크 로크럽‡Grark Lorkrub‡Grark Lorkrub‡Grark Lorkrub‡格拉克·洛克鲁布‡格拉克·洛克魯布',
    nil,
    'Vá para as Estepes Ardentes e encontre Grark Lorkrub. Segundo Lexlort, ele foi visto pela última vez em uma imensa fortaleza Rocha Negra.nnQuando encontrar Grark Lorkrub, use os Grilhões de Tório para prendê-lo e levá-lo de volta à Garganta Abrasadora, passando pela Montanha Rocha Negra. Os homens de Lexlort estarão esperando do outro lado para levar Grark sob sua custódia.‡Отправьтесь в Пылающие степи и найдите Грарка Лоркруба. Лекслорт упоминал, что в последний раз предателя видели в крепости Черной горы. nnПо обнаружении Грарка Лоркруба закуйте его в ториевые оковы и затем доставьте его от Черной горы к Тлеющему ущелью, Лекслорт и его подчиненные займутся допросом преступника.‡Begebt Euch in die brennende Steppe und sucht Grark Lorkrub. Ihr erinnert Euch, dass Lexlort gesagt hat, er sei zuletzt in einer großen Festung des Schwarzfelsklans gesehen worden.nnWenn Ihr Grark Lorkrub gefunden habt, verwendet die Thoriumfesseln, um ihn zu binden, und bringt ihn dann über den Schwarzfels in die sengende Schlucht zurück. Lexlorts Männer werden auf der anderen Seite warten, um Grark in Gewahrsam zu nehmen.‡불타는 평원으로 가서 그랄크 로크럽을 찾아야 합니다. 렉스로트가 그를 마지막으로 거대한 검은바위 요새에서 보았다고 말했던 것이 기억납니다.nn그랄크 로크럽을 찾으면 토륨 족쇄를 사용해 그를 포박한 뒤 다시 검은바위 산을 지나 이글거리는 협곡으로 데려가야 합니다. 렉스로트의 부하들이 반대편에서 기다리고 있다가 그랄크를 인계받을 것입니다.‡Ve a Las Estepas Ardientes y encuentra a Grark Lorkrub. Recuerdas que Lexlort mencionó que lo habían visto por última vez en una colosal fortaleza Roca Negra.nnCuando encuentres a Grark Lorkrub, usa los grilletes de torio para atarlo y condúcelo de vuelta por la Montaña Roca Negra hasta La Garganta de Fuego. Lexlort tendrá a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.‡Ve a Las Estepas Ardientes y encuentra a Grark Lorkrub. Recuerdas que Lexlort mencionó que lo habían visto por última vez en una colosal fortaleza Roca Negra.|nCuando encuentres a Grark Lorkrub, usa los grilletes de torio para atarlo y condúcelo de vuelta por la Montaña Roca Negra hasta La Garganta de Fuego. Lexlort tendrá a algunos de sus hombres esperándote al otro lado para llevarse a Grark detenido.‡Partez pour les Steppes ardentes et trouvez Grark Lorkrub. Lexlort vous a dit qu\'il a été vu pour la dernière fois dans une imposante forteresse des Rochenoires.nnUne fois que vous aurez trouvé Grark Lorkrub, enchaînez-le avec les chaînes en thorium, puis ramenez-le par le mont Rochenoire jusque dans la gorge des Vents brûlants. Des hommes de Lexlort attendront de l\'autre côté et le mettront sous bonne garde.‡到燃烧平原去找到格拉克·洛克鲁布。你回忆起雷克斯洛特曾经提起过，格拉克应该是在一座大型的黑石要塞中。nn当你找到格拉克·洛克鲁布之后，用瑟银镣铐把他铐起来，然后将其带回灼热峡谷。雷克斯洛特会让他的部下等在那里接应你。‡到燃燒平原去找到格拉克·洛克魯布。你回憶起雷克斯洛特曾經提起過，格拉克應該是在一座大型的黑石要塞中。|n當你找到格拉克·洛克魯布之後，用瑟銀鐐銬把他銬起來，然後將其帶回灼熱峽谷。雷克斯洛特會讓他的部下等在那裡接應你。',
  }
},
[4123] = {
  {
    'O Coração da Montanha‡Сердце горы‡Das Herz des Berges‡산의 정수‡El corazón de la montaña‡El corazón de la montaña‡Le Coeur de la montagne‡山脉之心‡山脈之心',
    nil,
    'Leve o Coração da Montanha para Maxwort Uberraio nas Estepes Ardentes.‡Принесите сердце горы Максворту Суперблеску в Пылающие степи.‡Bringt das \'Herz des Berges\' zu Maxwort Funkelglanz in der brennenden Steppe.‡불타는 평원에 있는 맥스워트 우버글린트에게 산의 정수를 가져가야 합니다.‡Llévale el corazón de la montaña a Maxwort Suprandor en Las Estepas Ardientes.‡Llévale el corazón de la montaña a Maxwort Suprandor en Las Estepas Ardientes.‡Apporter le Cœur de la montagne à Maxwort Uberbrille dans les Steppes ardentes.‡把山脉之心交给燃烧平原的麦克斯沃特·尤博格林。‡把山脈之心交給燃燒平原的麥克斯沃特·尤柏格林。',
  }
},
[4124] = {
  {
    'Perdido no fluxo postal‡Пропавший курьер‡Der vermisste Kurier‡실종된 안내원‡El mensajero desaparecido‡El mensajero desaparecido‡Le messager disparu‡失踪的信使‡失蹤的信差',
    nil,
    'Fale com Ginro Laracendis no Domínio de Plumaluna.‡Поговорите с Гинро Пылающим Очагом в Крепости Оперенной Луны.‡Sprecht mit Ginro Herdfeuer in der Mondfederfeste.‡페더문 요새에 있는 긴로 하트킨들과 대화해야 합니다.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Parler à Ginro Attisâtre dans le bastion de Pennelune.‡和羽月要塞的基恩诺·火花谈一谈。‡和羽月要塞的基恩諾·燃爐談話。',
  }
},
[4125] = {
  {
    'Perdido no fluxo postal‡Пропавший курьер‡Der vermisste Kurier‡실종된 안내원‡El mensajero desaparecido‡El mensajero desaparecido‡Le messager disparu‡失踪的信使‡失蹤的信差',
    nil,
    'Encontre o barco do mensageiro em algum lugar da costa de Feralas.‡Отыщите лодку курьера, которая должна находиться где-то на побережье Фераласа.‡Sucht das Boot des Kuriers irgendwo entlang der Küste von Feralas.‡페랄라스 해안에서 안내원의 배를 찾아야 합니다.‡Localiza el bote del mensajero por la costa de Feralas.‡Localiza el bote del mensajero por la costa de Feralas.‡Localiser le bateau du messager quelque part le long de la côte de Féralas.‡找到信使的小船，你应该在菲拉斯的南部海岸线上展开搜索。‡找到信差的小船，你應該在菲拉斯的南部海岸線上展開搜索。',
  }
},
[4126] = {
  {
    'Hurley Bafonegro‡Харли Чернопых‡Hurley Pestatem‡헐레이 블랙브레스‡Hurley Negrálito‡Hurley Negrálito‡Hurley Blackbreath‡霍尔雷·黑须‡霍爾雷·黑鬚',
    nil,
    'Leve a Receita Perdida de Cervaforte para Ragnar Cervaforte em Kharanos.‡Найдите украденный рецепт громоварского и верните его Рагнару Громовару в Каранос.‡Bringt Ragnar Donnerbräu in Kharanos das verlorene Donnerbräurezept.‡카라노스에 있는 라그나르 썬더브루에게 잃어버린 썬더브루 제조법을 가져가야 합니다.‡Llévale la receta de Cebatruenos perdida a Ragnar Cebatruenos en Kharanos.‡Llévale la receta de Cebatruenos perdida a Ragnar Cebatruenos en Kharanos.‡Apporter la Recette perdue de la Tonnebière à Ragnar Tonnebière à Kharanos.‡把遗失的雷酒秘方带给卡拉诺斯的拉格纳·雷酒。‡把遺失的雷酒秘方帶給卡拉諾斯的拉格納·雷酒。',
  }
},
[4127] = {
  {
    'Barco naufragado‡Разбитая лодка‡Havarie‡난파된 나룻배‡Los restos del bote‡Los restos del bote‡Débris de bateau‡船只的残骸‡船隻的殘骸',
    nil,
    'Volte ao Domínio de Plumaluna e mostre a Faca Descartada que você achou a Ginro Laracendis.‡Вернитесь в Крепость Оперенной Луны и покажите Гинро Пылающему Очагу выброшенный нож, который вы нашли.‡Kehrt zur Mondfederfeste zurück und zeigt Ginro Herdfeuer das gefundene Messer.‡페더문 요새로 돌아가 긴로 하트킨들에게 잃어버린 나이프를 보여주어야 합니다.‡Vuelve al Bastión Plumaluna y enseña a Ginro Mechogar el cuchillo perdido que encontraste.‡Vuelve al Bastión Plumaluna y enseña a Ginro Mechogar el cuchillo perdido que encontraste.‡Retourner au bastion de Pennelune et montrer à Ginro Attisâtre le Couteau perdu que vous avez découvert.‡回到羽月要塞，给基恩诺·火花看看你找到的这把被丢弃的小刀。‡回到羽月要塞，給基恩諾·燃爐看看你找到的這把被丟棄的小刀。',
  }
},
[4128] = {
  {
    'Ragnar Cervaforte‡Рагнар Громовар‡Ragnar Donnerbräu‡라그나르 썬더브루‡Ragnar Cebatruenos‡Ragnar Cebatruenos‡Ragnar Thunderbrew‡拉格纳·雷酒‡拉格納·雷酒',
    nil,
    'Fale com Ragnar Cervaforte.‡Переговорите с Рагнаром Громоваром.‡Sprecht mit Ragnar Donnerbräu.‡라그나르 썬더브루와 대화해야 합니다.‡Habla con Ragnar Cebatruenos.‡Habla con Ragnar Cebatruenos.‡Parler à Ragnar Tonnebière.‡和拉格纳·雷酒谈一谈。‡和拉格納·雷酒談談。',
  }
},
[4129] = {
  {
    'A faca revelada‡Тайна ножа‡Das wieder aufgetauchte Messer‡드러나는 칼의 비밀‡La revelación del cuchillo‡La revelación del cuchillo‡Le couteau révélé‡奎恩提斯的技艺‡奎恩提斯的技藝',
    nil,
    'Leve a Faca Descartada para Quintis Jonespyre no Domínio de Plumaluna.‡Отнесите выброшенный нож к друиду по имени Квинтис Ночной Костер в Крепости Оперенной Луны.‡Bringt Quintis Lebenshand in der Mondfederfeste das gefundene Messer.‡페더문 요새에 있는 쿠인티스 존스피레에게 잃어버린 나이프를 가져가야 합니다.‡Lleva el cuchillo perdido a Quintis Jonguja al Bastión Plumaluna.‡Lleva el cuchillo perdido a Quintis Jonguja al Bastión Plumaluna.‡Apporter le Couteau perdu à Quintis Gentecime au bastion de Pennelune.‡把被丢弃的小刀交给羽月要塞的奎恩提斯。‡把被丟棄的小刀交給羽月要塞的奎恩提斯。',
  }
},
[4130] = {
  {
    'Leitura psicométrica‡Сверхзнание‡Psychometrie-Sitzung‡심령측정‡Lectura psicométrica‡Lectura psicométrica‡La lecture psychométrique‡心灵占卜术‡心靈占卜術',
    nil,
    'Fale com Ginro Laracendis no Domínio de Plumaluna.‡Поговорите с Гинро Пылающим Очагом в Крепости Оперенной Луны.‡Sprecht mit Ginro Herdfeuer in der Mondfederfeste.‡페더문 요새에 있는 긴로 하트킨들과 대화해야 합니다.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Ve al Bastión Plumaluna y habla con Ginro Mechogar.‡Parler à Ginro Attisâtre dans le bastion de Pennelune.‡和羽月要塞的基恩诺·火花谈一谈。‡和羽月要塞的基恩諾·燃爐談話。',
  }
},
[4131] = {
  {
    'Gnolls Patábua‡Гноллы из стаи Древолапов‡Die Waldpfotengnolle‡덩굴발일족 놀‡Los gnolls Zarpaleña‡Los gnolls Zarpaleña‡Les gnolls Griffebois‡木爪豺狼人‡木爪豺狼人',
    nil,
    'Procure os acampamentos dos Gnolls Patábua ao sul de Feralas para obter pistas dos pertences do mensageiro ou dele próprio.‡Обыщите лагеря Древолапов в южном Фераласе в поисках вещей курьера либо самого курьера.‡Durchsucht die Lager der Waldpfotengnolle im Süden von Feralas nach Hinweisen auf den Verbleib des Kuriers oder seiner Habseligkeiten.‡페랄라스 남부에 있는 덩굴발일족 놀 야영지를 수색해 안내원이나 그의 소지품에 대한 증거를 찾아야 합니다.‡Busca el rastro del mensajero o sus pertenencias en los campamentos de los gnoll Zarpaleña del sur de Feralas.‡Busca el rastro del mensajero o sus pertenencias en los campamentos de los gnoll Zarpaleña del sur de Feralas.‡Fouiller les Camps des gnolls Griffebois dans la partie sud de Féralas pour trouver des indices sur les possessions du messager ou sur le messager lui-même.‡在菲拉斯南部地区的木爪豺狼人营地里寻找信使的下落或者信使的物品。‡在菲拉斯南部地區的木爪豺狼人營地裡尋找信差的下落或者信差的物品。',
  }
},
[4132] = {
  {
    'Operação: Morte ao Forjaversa‡Операция:смерть Кузне Гнева‡Operation: Tod dem Zornesschmied‡앵거포지 척살 작전‡Operación: muerte a Forjainquina‡Operación: muerte a Forjainquina‡Opération : Mort à Forgehargne‡行动：杀死安格弗将军‡行動:殺死安格弗將軍',
    nil,
    'Viaje para o Abismo Rocha Negra e mate o General Forjaversa! Fale novamente com o Senhor da Guerra Trincador quando a tarefa estiver concluída.‡Отправляйтесь в Глубины Черной горы и убейте генерала Кузню Гнева. Вернитесь к полководцу Клинозубу по выполнении задания.‡Begebt Euch zu den Schwarzfelstiefen und eliminiert General Zornesschmied! Kehrt zum Kriegsherrn Bluthauer zurück, sobald Ihr diese Aufgabe erledigt habt.‡검은바위 나락으로 가서 사령관 앵거포지를 처치한 후 장군 고어투스에게 돌아가야 합니다.‡Viaja hasta las Profundidades de Roca Negra ¡y mata al general Forjainquina! Vuelve junto al señor de la guerra Dientegore cuando hayas acabado la tarea.‡Viaja hasta las Profundidades de Roca Negra ¡y mata al general Forjainquina! Vuelve junto al señor de la guerra Dientegore cuando hayas acabado la tarea.‡Voyagez jusqu\'aux Profondeurs de Rochenoire et tuez le général Forgehargne ! Une fois votre mission accomplie, retournez voir le seigneur de guerre Sangredent.‡到黑石深渊去杀掉安格弗将军！当任务完成之后向军官高图斯复命。‡到黑石深淵去殺掉安格弗將軍!當任務完成之後向督軍高圖斯覆命。',
  }
},
[4133] = {
  {
    'Vivian Latumba‡Вивиана Лягроб‡Vivian Lagrave‡비비안 라그레이브‡Vivian Latumba‡Vivian Lagrave‡Vivian Lagrave‡薇薇安·拉格雷‡薇薇安·拉格雷',
    nil,
    'Fale com a Mestra Sombria Vivian Latumba em Karrath.‡Переговорите с тенемагом Вивиан Лаграв в Каргате.‡Sprecht mit Schattenmeisterin Vivian Lagrave in Kargath.‡카르가스에 있는 비비안 라그레이브와 대화해야 합니다.‡Habla con la taumaturgo oscuro Vivian Latumba en Kargath.‡Habla con la taumaturgo oscuro Vivian Lagrave en Kargath.‡Parler à la maîtresse des ombres Vivian Lagrave à Kargath.‡与卡加斯的暗法师薇薇安·拉格雷谈一谈。‡與卡加斯的暗影大師薇薇安·拉格雷談話。',
  }
},
[4134] = {
  {
    'Receita Perdida de Cervaforte‡Украденный рецепт громоварского‡Verlorenes Donnerbräurezept‡잃어버린 썬더브루 제조법‡La receta de Cebatruenos perdida‡La receta de Cebatruenos perdida‡La recette perdue de la Tonnebière‡遗失的雷酒秘方‡遺失的雷酒秘方',
    nil,
    'Leve a Receita Perdida de Cervaforte para Vivian Latumba em Karrath.‡Принесите рецепт громоварского светлого Вивиан Лягроб в Каргат.‡Bringt Vivian Lagrave in Kargath das verlorene Donnerbräurezept.‡카르가스에 있는 비비안 라그레이브에게 잃어버린 썬더브루 제조법을 가져가야 합니다.‡Llévale la receta de Cebatruenos perdida a Vivian Latumba en Kargath.‡Llévale la receta de Cebatruenos perdida a Vivian Lagrave en Kargath.‡Apporter la Recette perdue de la Tonnebière à Vivian Lagrave à Kargath.‡把遗失的雷酒秘方交给卡加斯的薇薇安·拉格雷。‡把遺失的雷酒秘方交給卡加斯的薇薇安·拉格雷。',
  }
},
[4135] = {
  {
    'Profundeza Atormentada‡Гудящая Бездна‡Die verwundene Tiefe‡고통의 구덩이‡Las Galerías Retorcidas‡Las Galerías Retorcidas‡Le Gouffre grouillant‡痛苦深渊‡痛苦深淵',
    nil,
    'Agora que o último paradeiro conhecido de Patiphe foi descoberto, continue sua busca por ele ou seus restos na Profundeza Atormentada. De acordo com o bilhete, ela fica ao sul dos acampamentos dos gnolls Patábua.‡Продолжайте поиски Раскала (или его останков) в Гудящей Бездне. Согласно записке, Гудящая Бездна находится к югу от лагерей стаи Древолапов.‡Da Ihr jetzt Raschals letzten bekannten Aufenthaltsort in Erfahrung gebracht habt, setzt Ihr die Suche nach ihm oder seinen sterblichen Überresten in der verwundenen Tiefe fort. Laut Notiz soll dieser Ort südlich der Lager der Waldpfotengnolle liegen.‡라스칼의 마지막 행방을 알아냈으니 고통의 구덩이에서 그를 찾아야 합니다. 그의 쪽지에 따르면 고통의 구덩이는 덩굴발일족 놀 야영지의 남쪽에 있습니다.‡Ahora que has descubierto el rastro de Raschal, adéntrate en Las Galerías Retorcidas y encuéntrale... o encuentra lo que quede de él. Según la nota, debes dirigirte al sur de los campamentos de los Zarpaleña.‡Ahora que has descubierto el rastro de Raschal, adéntrate en Las Galerías Retorcidas y encuéntrale... o encuentra lo que quede de él. Según la nota, debes dirigirte al sur de los campamentos de los Zarpaleña.‡À présent que la dernière destination connue de Raschal est découverte, continuez à le rechercher, lui ou ses restes, dans le Gouffre grouillant. D\'après le message, il se trouve au sud des camps des gnolls Griffebois.‡现在你已经知道了拉斯卡尔的去向，那么你最好到痛苦深渊去寻找他，或者至少是他的尸体。根据便笺上的信息，那个地方应该在木爪豺狼人营地的南边。‡現在你已經知道了拉斯卡爾的去向，那麼你最好到痛苦深淵去尋找他，或者至少是他的屍體。根據便箋上的資訊，那個地方應該在木爪豺狼人營地的南邊。',
  }
},
[4136] = {
  {
    'Ribas Parafuseta‡Риббли Крутипроб‡Ribbly Schraubstutz‡리블리 스크류스피곳‡Ribbly Llavenrosca‡Ribbly Llavenrosca‡Ribbly Fermevanne‡雷布里·斯库比格特‡雷布里·斯庫比格特',
    nil,
    'Leve a Cabeça do Ribas para Yuka Parafuseta nas Estepes Ardentes.‡Принесите голову Риббли Юке Крутипроб в Пылающие степи.‡Bringt Yuka Schraubstutz in der brennenden Steppe Ribblys Kopf.‡리블리를 처치하고 그 증거로 그의 머리카락을 불타는 평원에 있는 유카 스크류스피곳에게 가져가야 합니다.‡Llévale la cabeza de Ribbly a Yuka Llavenrosca en Las Estepas Ardientes.‡Llévale la cabeza de Ribbly a Yuka Llavenrosca en Las Estepas Ardientes.‡Apporter la Tête de Ribbly à Yuka Fermevanne dans les Steppes ardentes.‡把雷布里的头颅交给燃烧平原的尤卡·斯库比格特。‡把雷布里的頭顱交給燃燒平原的尤卡·斯庫比格特。',
  }
},
[4141] = {
  {
    'Melco e Lário‡Майджин и Ларион‡Muigin und Larion‡무이긴과 라리온‡Muigin y Larion‡Muigin y Larion‡Muigin et Larion‡穆尔金和拉瑞安‡莫爾金和拉里安',
    nil,
    'Colha 15 Pétalas Sangrentas e fale novamente com Melco.‡Соберите 15 кровоцветов и принесите их Майджину.‡Sammelt 15 Blutblüten und kehrt zu Muigin zurück.‡붉은꽃잎 15개를 모아 무이긴에게 돌아가야 합니다.‡Recoge 15 pétalos de sangre y ve a ver a Muigin.‡Recoge 15 pétalos de sangre y ve a ver a Muigin.‡Récolter 15 Pétales-de-sang et retourner voir Muigin.‡从安戈洛尔环形山的血瓣花猛击者和血瓣花掠夺者身上收集15个血瓣花，然后向穆尔金回复。‡收集15朵血瓣花，然後回覆給莫爾金。',
  }
},
[4142] = {
  {
    'Uma visita a Gregan‡Визит к Грегану‡Ein Besuch bei Gregan‡그레간 방문‡Visita a Gregan‡Visita a Gregan‡Visite à Gregan‡造访格雷甘‡造訪格雷甘',
    nil,
    'Leve uma Pétala Sangrenta para Gregan Cospechope em Feralas.‡Отнесите кровоцвет Грегану Пивоплюю в Фералас.‡Bringt Gregan Hopfenspei in Feralas eine Blutblüte.‡페랄라스에 있는 그레간 브루스퓨에게 붉은꽃잎을 가져가야 합니다.‡Llévale un pétalo de sangre a Gregan Vomitabrebaje de Feralas.‡Llévale un Sangrepétalo a Gregan Tirabirras de Feralas.‡Apporter une Pétale-de-sang à Gregan Gerbebière en Féralas.‡把血瓣花交给菲拉斯的格雷甘·山酒。‡把血瓣花交給菲拉斯的格雷甘·山酒。',
  }
},
[4143] = {
  {
    'Brumas do mal‡Туман зла‡Der Dunst des Bösen‡악의 아지랑이‡Bruma del mal‡Bruma del mal‡Brouillard maléfique‡邪恶之雾‡邪惡之霧',
    nil,
    'Colha 5 amostras de Bruma de Atal\'ai, depois fale novamente com Melco na Cratera Un\'Goro.‡Соберите 5 образцов тумана Аталаи и принесите их Майджину в Кратер Ун\'Горо.‡Sammelt 5 Proben Dunst der Atal\'ai und bringt sie Muigin im Krater von Un\'Goro.‡아탈라이 아지랑이 5개를 모은 후 운고로 분화구에 있는 무이긴에게 돌아가야 합니다.‡Reúne 5 muestras de calima Atal\'ai y después ve a ver de nuevo a Muigin al Cráter de Un\'Goro.‡Reúne 5 muestras de calima Atal\'ai y después ve a ver de nuevo a Muigin al Cráter de Un\'Goro.‡Récupérer 5 Échantillons de brume atal\'ai puis retourner voir Muigin dans le cratère d\'Un\'Goro.‡收集5份阿塔莱之雾的样本，然后向安戈洛环形山的穆尔金复命。‡收集5份阿塔萊之霧的樣本，然後向安戈洛環形山的莫爾金覆命。',
  }
},
[4144] = {
  {
    'Broto de Pétala Sangrenta‡Побеги кровоцвета‡Blutblütensprösslinge‡붉은꽃잎 씨앗‡Brote pétalo de sangre‡Brotes Sangrepétalo‡Les pousses de Pétales-de-sang‡血瓣花苗‡血瓣花苗',
    nil,
    '‡Слушай мой план, Драгунов: пойди и собери для меня немного побегов кровоцвета – молодых, которые еще не успели полностью развиться. А потом посмотрим, как они отреагируют на туман Аталаи. nnТы думаешь, я слишком злопамятен? Ну, в общем так и есть. nnНа самом деле, я знаю дорогу отсюда, но пока Ларион не признает мою правоту, я отсюда не уйду. nnНу, иди, принеси мне побегов, и мы славно повеселимся!‡Das ist mein Plan, <Name>: Zieht los und sammelt ein paar Blutblütensprösslinge - Ihr wisst schon, das sind Pflanzen, die noch nicht ganz ausgetrieben haben, und bringt sie mir. Dann werde ich sehen, was man mit dem Dunst der Atal\'ai anfangen kann.nnIhr haltet mich vielleicht für rachsüchtig ... Und damit liegt Ihr absolut richtig! nnDie Wahrheit ist, ich weiß, wie man hier wegkommt, aber solange Larion nicht zugibt, dass ich Recht habe, rühre ich mich nicht von der Stelle!nnUnd nun hinfort mit Euch. Sucht diese Blutblütensprösslinge, dann gönnen wir uns ein bisschen Spaß!‡계획은 이렇소. 가서 붉은꽃잎 씨앗을 채집해 오시오. 그러니까, 아직 완전히 싹트지 않은 식물 말이오. 그걸 가지고 오시오. 그러면 아탈라이 아지랑이로 뭘 할 수 있나 보겠소.nn당신은 내가 복수심에 불타고 있다고 생각하겠지만... 아니, 사실은 정말 복수하고 싶소!nn솔직히 말해 여기서 빠져나가는 길도 알고 있지만 내가 옳다는 걸 라리온이 인정하기 전까지는 여기서 나가지 않을 거요!nn자, 이제 가보시오. 붉은꽃잎 씨앗을 가지고 와서 한번 재미있게 놀아봅시다!‡‡‡Voici ce que nous allons faire, <nom>. Procurez-vous des pousses de Pétales-de-sang. De jeunes plantes, pas encore parvenues au stade adulte, vous comprenez ? Puis apportez-les ici. Alors je verrai ce dont la brume atal\'ai est capable.nnVous pourriez penser que c\'est le désir de vengeance qui me guide, mais… vous auriez raison…nnEn vérité, je connais le chemin pour nous sortir d\'ici, mais tant que Larion n\'admet pas que j\'ai raison, je ne bouge pas !nnC\'est assez : partez et trouvez des pousses de Pétales-de-sang afin que nous nous amusions un peu !‡‡',
  }
},
[4145] = {
  {
    'Lário e Melco‡Ларион и Майджин‡Larion und Muigin‡라리온과 무이긴‡Larion y Muigin‡Larion y Muigin‡Larion et Muigin‡拉瑞安和穆尔金‡拉里安和莫爾金',
    nil,
    'Cace 5 Açoitadeiras Pétala Sangrenta, 5 Látegas Pétala Sangrenta, 5 Esfoladoras Pétala Sangrenta e 5 Laçadoras Pétala Sangrenta para Lário, do Refúgio do Marshal.‡Уничтожьте 5 кровоцветов-хлестунов, 5 кровоцветов-крепкозубов, 5 кровоцветов-живодеров и 5 кровоцветов-звероловов по просьбе Лариона из Укрытия Маршалла.‡Jagt 5 Blutblütenpeitscher, 5 Blutblütendrescher, 5 Blutblütenschinder und 5 Blutblütenfallen für Larion in Marschalls Zuflucht.‡마샬의 야영지에 있는 라리온에게 채찍줄기 붉은꽃잎덩굴손 5마리, 덩이줄기 붉은꽃잎덩굴손 5마리, 칼날가시 붉은꽃잎덩굴손 5마리, 질긴뿌리 붉은꽃잎덩굴손 5마리를 사냥해야 합니다.‡Caza 5 azotadores Pétalo de Sangre, 5 trilladores Pétalo de Sangre, 5 desolladores Pétalo de Sangre y 5 tramperos Pétalo de Sangre para Larion en el Refugio de Marshal.‡Caza 5 azotadores Sangrepétalo, 5 trilladores Sangrepétalo, 5 desolladores Sangrepétalo y 5 tramperos Sangrepétalo para Larion en el Refugio de Marshal.‡Chasser 5 Flagellants Pétale-de-sang, 5 Batteurs Pétale-de-sang, 5 Ecorcheurs Pétale-de-sang et 5 Trappeurs Pétale-de-sang pour Larion au refuge des Marshal.‡为马绍尔营地里的拉瑞安杀掉5个血瓣花鞭笞者、5个血瓣花捕兽者、5个血瓣花掠夺者和5个血瓣花猛击者。‡為馬紹爾營地裡的拉里安殺掉5個血瓣花鞭笞者、5個血瓣花痛擊者、5個血瓣花撕掠者和5個血瓣花捕獸者。',
  }
},
[4146] = {
  {
    'Combustível de fulminadora‡Питание для шокера‡Schrumpftreibstoff‡구제장치 연료‡Combustible de irradior‡Combustible de irradior‡Carburant de baguette‡除草器的燃料‡除草器的燃料',
    nil,
    'Entregue a Fulminadora Descarregada e 5 amostras de Bruma de Atal\'ai a Lário, no Refúgio do Marshal.‡Доставьте незаряженный шокер и 5 образцов тумана Аталаи Лариону в Укрытие Маршалла.‡Bringt Larion in Marschalls Zuflucht den ungeladenen Schrumpfer und 5 Proben Dunst der Atal\'ai.‡마샬의 야영지에 있는 라리온에게 충전 안된 구제장치와 아탈라이 아지랑이 5개를 가져가야 합니다.‡Entrega el Controlador descargado y 5 muestras de calima Atal\'ai a Larion, en el Refugio de Marshal.‡Entrega el Controlador descargado y 5 muestras de calima Atal\'ai a Larion, en el Refugio de Marshal.‡Remettre la Baguette déchargée et 5 Échantillons de brume atal\'ai à Larion au refuge des Marshal.‡收集5份阿塔莱之雾的样本，然后将它们送到马绍尔营地的拉瑞安那里。‡收集5份阿塔萊之霧的樣本，然後將它們送到馬紹爾營地的拉里安那裡。',
  }
},
[4147] = {
  {
    'Oficina do Marlon‡Мастерская Марвона‡Marvons Werkstatt‡마본의 작업장‡El taller de Marvon‡El taller de Marvon‡Atelier de Marvon‡玛尔冯的车间‡瑪爾馮的車間',
    nil,
    'Vá até a oficina de Marlon Catarrebite na Vila Catraca.‡Отправьтесь к Марвону Клепальщику в его мастерскую в Кабестане.‡Reist zu Marvon Nietensuchers Werkstatt in Ratschet.‡톱니항에 있는 마본 리벳시커의 작업장으로 가야 합니다.‡Viaja hasta el taller de Marvon Buscarroblones en Trinquete.‡Viaja hasta el taller de Marvon Buscarroblones en Trinquete.‡Se rendre à l\'Atelier de Marvon Chercherivet à Cabestan.‡到棘齿城去，在玛尔冯·瑞文斯克的车间里找到他。‡到棘齒城去，在瑪爾馮·瑞文斯克的車間裡找到他。',
  }
},
[4148] = {
  {
    'Fulminadora de Pétala Sangrenta‡Разряд кровоцвета‡Blutblütenschrumpfer‡붉은꽃잎 구제장치‡Liquidador de pétalos de sangre‡Liquidador de Sangrepétalo‡La baguette Pétale-de-sang‡血瓣花除草器‡血瓣花除草器',
    nil,
    '‡Чтобы шокер заработал, необходим образец его цели – кровоцвета. Отправляйся в кратер и принеси мне побег кровоцвета, а я уж настрою прибор на милых маленьких дружков Майджина... nnЕсли бы он не был так упрям, мы давно уже выбрались бы из этого проклятого места... Но пока я должен показать ему, что его шуточки меня ничуть не беспокоят!‡Damit der Schrumpfer funktioniert, brauchen wir ein Exemplar der Kreaturen, für die er eingestellt werden soll. Geht zum Krater und holt einen Blutblütensprössling. Dann kann ich ihn so einstellen, dass er bei Muigins kleinen Freunden funktioniert...nnWenn der Typ nicht so stur wäre, könnten wir alle schon längst auf dem Heimweg sein. Aber jetzt muss ich ihm erst einmal beweisen, dass mir seine Faxen nicht das Geringste ausmachen!‡이 구제장치를 작동시키려면 대상 생물의 견본이 필요합니다. 분화구로 가서 붉은꽃잎 씨앗을 모아 주십시오. 그러면 이 구제장치를 측정해서 무이긴의 조그만 친구들에게 사용할 수 있을 겁니다.nn그 친구가 그렇게 고집을 부리지만 않았어도 벌써 집으로 돌아가고 있었을 텐데... 하지만 그때까지는 그의 사소한 장난이 나한테는 아무런 소용이 없다는 걸 보여줄 겁니다!‡Para poder funcionar, el controlador necesita una muestra de la criatura elegida. Ve al cráter y recoge un brote Pétalo de Sangre. Cuando lo tenga podré calibrar el controlador para que funcione con los amiguitos de Muigin...nnSi no fuera tan cabezota ya podríamos estar de camino a casa... ¡Pero hasta entonces tendré que enseñarle que su broma no me molesta del todo!‡‡Pour faire fonctionner la baguette, nous avons besoin d\'un spécimen de ses futures victimes. Rendez-vous dans le cratère et rapportez une pousse de Pétale-de-sang. Je pourrai alors régler l’appareil pour qu\'il prenne soin des petits camarades de Muigin…nnS\'il n\'était pas si obstiné, nous serions déjà sur le chemin du retour… En attendant, je ne peux que lui montrer que ses gamineries ne me perturbent aucunement…‡‡',
  }
},
[4161] = {
  {
    'Receita dos Kaldorei‡Рецепт кальдораев‡Rezept der Kaldorei‡칼도레이 조리법‡La receta de los Kaldorei‡La receta de los kaldorei‡Une recette kaldorei‡卡多雷的菜谱‡卡多雷的食譜',
    nil,
    'Colete 7 Pernas Pequenas de Aranha para Zarrin, de Dolanaar.‡Принесите 7 маленьких паучьих лапок Заррину в Доланаар.‡Sammelt 7 kleine Spinnenbeine für Zarrin in Dolanaar.‡작은 거미 다리 7개를 모아 돌라나르에 있는 자린에게 갖다주어야 합니다.‡Recoge 7 patas de araña pequeña para Zarrin, que está en Dolanaar.‡Collect 7 Small Spider Legs.‡Collecter 7 Petites pattes d\'araignée pour Zarrin, à Dolanaar.‡为多兰纳尔的扎瑞恩收集7条小蜘蛛腿。‡為多蘭納爾的札瑞恩收集7條小蜘蛛腿。',
  }
},
[4181] = {
  {
    'Engenharia goblínica‡Гоблинское инженерное дело‡Gobliningenieurskunst‡고블린 기계공학‡Ingeniería goblin‡Ingeniería goblin‡Ingénierie des gobelins‡地精工程学‡哥布林工程學',
    nil,
    'Se quiser aprender mais sobre a Engenharia Goblínica, leve o Manual das Disciplinas de Engenharia até Nixx Molapinhão, em Geringontzan.‡Если вы хотите начать обучение гоблинскому инженерному делу, отнесите cправочник по инженерным дисциплинам Никсу Шепружину в Прибамбасск.‡Wenn Ihr mehr über die Gobliningenieurskunst wissen wollt, dann bringt das Handbuch der Ingenieurskunstdisziplinen zu Nixx Sprossfeder nach Gadgetzan.‡고블린 기계공학에 대해 더 알고 싶으면 가젯잔에 있는 닉스 스프로켓스프링에게 기계공학 설명서를 가져가야 합니다.‡Si quieres saber más sobre el tema, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón a Gadgetzan.‡Si quieres saber más sobre ingeniería goblin, llévale el Manual de disciplinas de ingeniería a Nixx Muellepiñón de Gadgetzan.‡Apporter le Manuel d\'ingénierie à Nixx Elastirouage à Gadgetzan si vous souhaitez en apprendre davantage sur l\'ingénierie gobeline.‡如果你想要对地精工程学有更多了解，就把工程学教材交给加基森的尼克斯·斯普克斯宾。‡如果你想要對哥布林工程學有更多瞭解，就把工程學教材交給加基森的尼克斯·斯普克斯賓。',
  }
},
[4182] = {
  {
    'Ameaça draconiana‡Драконья угроза‡Drachkin-Bedrohung‡용혈족의 위협‡La amenaza de los dragonantes‡La amenaza de los dragonantes‡La menace des draconiens‡黑龙的威胁‡黑龍的威脅',
    nil,
    'Mate 15 Filhotes Negros, 10 Dragomorfos Negros, 4 Draconoides Negros e 1 Draco Negro. Fale novamente com Helendis Flumicórnio quando a tarefa estiver concluída.‡Убейте 15 детенышей черного дракона, 10 черных драконидов, 4 черных драконид и 1 черного дракона. По выполнении задания вернитесь к Хелендису Речному Мысу.‡Erschlagt 15 schwarze Brutlinge, 10 Exemplare der schwarzen Großdrachenbrut, 4 Schwarzwyrmkins und 1 Schwarzdrachen. Kehrt zu Helendis Flusshorn zurück, sobald die Aufgabe erledigt ist.‡검은 새끼용 15마리, 검은용혈족 10마리, 검은고룡족 4마리와 검은 비룡 1마리를 처치한 후, 헬렌디스 리버혼에게 돌아가야 합니다.‡Mata 15 estirpes negras, 10 dragauros negros, 4 vermintes negros y 1 draco negro. Vuelve junto a Helendis Rivacuerno cuando hayas acabado la tarea.‡Mata 15 estirpes negras, 10 dragauros negros, 4 vermintes negros y 1 draco negro.‡Tuer 15 Rejetons noirs, 10 Draconides noirs, 4 Wyrmides noirs et 1 Drake noir. Retrouver Helendis Ruissecorne une fois la tâche accomplie.‡杀掉15条黑色小龙、10条黑色龙人、4条火鳞龙人和1条黑色幼龙。当你完成任务之后就向赫林迪斯·河角回报。‡殺掉15隻黑色小龍、10隻黑色龍裔、4隻黑色龍人和1隻黑龍。當你完成任務之後就向赫林迪斯·河角回報。',
  }
},
[4183] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Viaje até Vila Plácida e entregue a Carta de Helendis Flumicórnio ao Magistrado Salomão.‡Отправьтесь в Приозерье и доставьте письмо Хелендиса Речного Мыса мировому судье Соломону.‡Reist nach Seenhain und händigt Magistrat Solomon Helendis Flusshorns Brief aus.‡레이크샤이어로 가서 집정관 솔로몬에게 헬렌디스 리버혼의 편지를 전달해야 합니다.‡Viaja a Villa del Lago y entrégale la carta de Helendis Rivacuerno al magistrado Solomon.‡Viaja a Villa del Lago, en las Montañas Crestagrana, y entrégale la carta de Helendis Rivacuerno al magistrado Solomon.‡Voyager jusqu\'à Comté-du-Lac et remettre la Lettre d\'Helendis Ruissecorne au Magistrat Salomon.‡把赫林迪斯·河角的信交给湖畔镇的所罗门镇长。‡把赫林迪斯·河角的信交給湖畔鎮的所羅門鎮長。',
  }
},
[4184] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Viaje para Ventobravo e entregue o Apelo de Salomão ao Grão-lorde Bolvar Fordragon.nnBolvar reside na Bastilha Ventobravo.‡Передайте обращение Соломона верховному лорду Болвару Фордрагону.nnБолвар Фордрагон пребывает в Крепости Штормграда.‡Reist nach Sturmwind und tragt Solomons Hilfegesuch dem Hochlord Bolvar Fordragon vor.nnBolvar residiert in der Burg Sturmwind.‡스톰윈드로 가서 대영주 볼바르 폴드라곤에게 볼바르에게 보내는 솔로몬의 탄원서를 전해주어야 합니다.nn볼바르는 스톰윈드 왕궁에 있습니다.‡Ve a Ventormenta para entregar la petición de ayuda de Solomon al Gran Señor Bolvar Fordragon. nnVive en el Castillo de Ventormenta.‡Ve a Ventormenta para entregar la petición de ayuda de Solomon al rey Varian Wrynn.|nVive en el Castillo de Ventormenta.‡Voyager jusqu\'à Hurlevent et remettre la Demande d\'aide de Salomon au généralissime Bolvar Fordragon.nnBolvar demeure dans le Donjon de Hurlevent.‡到暴风城去把所罗门的求援信交给伯瓦尔·弗塔根公爵。nn伯瓦尔在暴风要塞里。‡到暴風城去把所羅門的求援信交給大領主伯瓦爾·弗塔根。|n伯瓦爾在暴風要塞裡。',
  }
},
[4185] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Fale com o Grão-lorde Bolvar Fordragon depois de falar com a Lady Katrana Prestor.‡Поговорите с Верховным лордом Болваром Фордрагоном после беседы с леди Катраной Престор.‡Sprecht zuerst mit Lady Katrana Prestor, dann mit Hochlord Bolvar Fordragon.‡여군주 카트라나 프레스톨과 얘기를 나눈 후, 대영주 볼바르 폴드라곤과 대화하십시오.‡Habla con el Alto Señor Bolvar Fordragón después de hablar con Lady Katrana Prestor.‡Habla con el alto señor Bolvar Fordragón después de hablar con Lady Katrana Prestor.‡Parler au généralissime Bolvar Fordragon après avoir parlé à dame Katrana Prestor.‡与女伯爵卡特拉娜·普瑞斯托谈话，然后再与伯瓦尔·弗塔根公爵谈话。‡與卡特拉娜·普瑞斯托女士談話，然後再與大領主伯瓦爾·弗塔根談話。',
  }
},
[4186] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Leve o Decreto de Bolvar para o Magistrado Salomão, em Vila Plácida.‡Отнесите указ Болвара мировому судье Соломону в Приозерье.‡Händigt Bolvars Erlass an Magistrat Solomon in Seenhain aus.‡레이크샤이어에 있는 집정관 솔로몬에게 볼바르의 명령서를 가져가야 합니다.‡Lleva el decreto de Bolvar al magistrado Solomon en la Villa del Lago.|n‡Lleva el decreto de Wrynn al magistrado Solomon en la Villa del Lago.‡Apporter le Décret de Bolvar au Magistrat Salomon à Comté-du-Lac.‡把伯瓦尔的命令交给湖畔镇的所罗门镇长。‡把伯瓦爾的命令交給湖畔鎮的所羅門鎮長。',
  }
},
[4201] = {
  {
    'A poção do amor‡Приворотное зелье‡Der Liebestrank‡사랑의 묘약‡La poción de enamoramiento‡La poción de enamoramiento‡Le philtre d\'amour‡爱情药水‡愛情藥水',
    nil,
    'Leve 4 Sangues-de-grom, 10 Veios de Prata Gigantes e a Ampola da Nagmara Cheia para a Lady Nagmara no Abismo Rocha Negra.‡Принесите 4 листа крови Грома, 10 огромных серебряных слитков и наполненный сосуд Нагмары госпоже Нагмаре в Глубины Черной горы.‡Bringt 4 Gromsblut-Kräuter, 10 Riesensilbervenen und Nagmaras gefüllte Phiole zu Herrin Nagmara in den Schwarzfelstiefen.‡검은바위 나락에 있는 지배인 나그마라에게 그롬의 피 4개, 거대한 은 광석 10개, 가득 찬 나그마라의 약병을 가져가야 합니다.‡Llévale 4 gromsanguinas, 10 venas de plata gigantescas y el vial lleno de Nagmara a la maestra Nagmara en las Profundidades de Roca Negra.‡Llévale 4 gromsanguinas, 10 venas de plata gigantescas y el vial lleno de Nagmara a la coima Nagmara en las Profundidades de Roca Negra.‡Apporter 4 Gromsang, 10 Veines d\'argent de géant et la Fiole de Nagmara remplie à la gouvernante Nagmara dans les Profondeurs de Rochenoire.‡将4份格罗姆之血、10块巨型银矿和装满水的娜玛拉之瓶交给黑石深渊的娜玛拉小姐。‡將4份格羅姆之血、10塊巨型銀礦和裝滿水的娜瑪拉之瓶交給黑石深淵的娜瑪拉小姐。',
  }
},
[4221] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려있는 열매는 썩어서 독성을 품게 된 것 같습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4222] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려있는 열매는 썩어서 독성을 품게 된 것 같습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una flor del viento. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4223] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Fale com o Oficial Maxwell nas Estepes Ardentes.‡Поговорите с маршалом Максвеллом в Пылающих степях.‡Sprecht mit Marschall Maxwell in der brennenden Steppe.‡불타는 평원에 있는 치안대장 맥스웰과 대화하십시오.‡Habla con el mariscal Maxwell en Las Estepas Ardientes.‡Habla con el mariscal Maxwell en Las Estepas Ardientes.‡Parler au maréchal Maxwell dans les Steppes ardentes.‡和燃烧平原的麦克斯韦尔元帅谈一谈。‡和燃燒平原的麥克斯韋爾元帥談話。',
  }
},
[4224] = {
  {
    'Os verdadeiros mestres‡Подлинные хозяева‡Die wahren Meister‡진정한 지도자‡Los verdaderos maestros‡Los verdaderos maestros‡Les véritables maîtres‡真正的主人‡真正的主人',
    nil,
    'Fale com João Roto para saber o destino do Marechal Vilasboas e fale novamente com o Oficial Maxwell quando tiver completado essa tarefa.nnVocê se lembra do Oficial Maxwell lhe dizendo para procurá-lo em uma caverna ao norte.‡Поговорите с Джоном-Оборванцем и узнайте о судьбе маршала Виндзора. По выполнении задания вернитесь к маршалу Максвеллу.nnКажется, маршал Максвелл говорил, что Джона следует искать в пещере на севере.‡Sprecht mit dem struppigen John, um etwas über Marschall Windsors Schicksal zu erfahren, und kehrt dann zu Marschall Maxwell zurück, wenn Ihr diese Aufgabe erledigt habt.nnIhr erinnert Euch daran, dass Marschall Maxwell Euch geraten hat, ihn in einer Höhle im Norden zu suchen.‡털보 존을 만나 치안대장 윈저의 행방에 대해서 알아낸 다음 치안대장 맥스웰에게 돌아가 보고해야 합니다.nn치안대장 맥스웰은 북쪽에 있는 동굴에서 털보 존을 찾아보라고 했습니다.‡Habla con John Andrajoso para averiguar el destino del mariscal Windsor y vuelve junto al mariscal Maxwell cuando hayas completado la tarea.nnRecuerdas que el mariscal Maxwell comentó algo sobre buscarlo en una cueva hacia el norte.‡Habla con John Andrajoso.‡Parlez à John le Loqueteux pour apprendre ce qu\'il est advenu du maréchal Windsor puis retournez voir le maréchal Maxwell lorsque vous aurez accompli cette tâche.nnVous vous rappelez que le maréchal Maxwell vous a dit de le chercher dans une grotte au nord.‡和狼狈不堪的约翰谈谈来了解温德索尔元帅的命运，然后回到麦克斯韦尔元帅那里。nn你想起麦克斯韦尔元帅说过他在一个北面的洞穴那里。‡和狼狽不堪的約翰談談來瞭解溫德索爾元帥的命運，然後回到麥克斯韋爾元帥那裡。|n你想起麥克斯韋爾元帥說過他在一個北面的洞穴那裡。',
  }
},
[4241] = {
  {
    'Marechal Vilasboas‡Маршал Винздор‡Marschall Windsor‡치안대장 윈저‡El mariscal Windsor‡El mariscal Windsor‡Maréchal Windsor‡温德索尔元帅‡溫德索爾元帥',
    nil,
    'Viaje para a Montanha Rocha Negra, a noroeste, e entre no Abismo Rocha Negra. Descubra o que aconteceu com o Marechal Vilasboas.nnVocê se lembra de João Roto falando sobre Vilasboas ter sido arrastado para uma prisão.‡Отправляйтесь на Черную гору на северо-западе и войдите в ее глубины. Узнайте, что сталось с маршалом Виндзором.nnКажется, Джон-Оборванец говорил о том, что Виндзора утащили в темницу.‡Reist zum Schwarzfels im Nordwesten und dann weiter zu den Schwarzfelstiefen. Findet heraus, was aus Marschall Windsor geworden ist.nnIhr erinnert Euch daran, dass der struppige John sagte, man hätte Windsor in ein Gefängnis verschleppt.‡북서쪽에 있는 검은바위 산으로 가서 검은바위 나락으로 들어가십시오. 치안대장 윈저에게 무슨 일이 있었는지 알아내야 합니다.nn털보 존은 윈저가 감옥으로 끌려갔다고 했습니다.‡Viaja a la Montaña Roca Negra al noroeste y adéntrate en las Profundidades de Roca Negra. Averigua qué le ha ocurrido al mariscal Windsor.nnRecuerdas que John Andrajoso había comentado que se habían llevado a una cárcel a Windsor.‡Viaja a la Montaña Roca Negra al noroeste y adéntrate en las Profundidades de Roca Negra. Averigua qué le ha ocurrido al mariscal Windsor.|nRecuerdas que John Andrajoso había comentado que se habían llevado a una cárcel a Windsor.‡Partir pour le mont Rochenoire au nord-ouest et pénétrer dans les Profondeurs de Rochenoire. Découvrir ce qu\'il est advenu du Maréchal Windsor.nnVous vous souvenez que John le Loqueteux a dit que Windsor avait été traîné en prison.‡到西北部的黑石山脉去，在黑石深渊中找到温德索尔元帅的下落。nn狼狈不堪的约翰曾告诉你说温德索尔被关进了一个监狱。‡到西北部的黑石山脈去，在黑石深淵中找到溫德索爾元帥的下落。|n狼狽不堪的約翰曾告訴你說溫德索爾被關進了一個監獄。',
  }
},
[4242] = {
  {
    'Esperança abandonada‡Утраченная надежда‡Verlorene Hoffnung‡실망‡Esperanza perdida‡Esperanza perdida‡Espoir abandonné‡被遗弃的希望‡被遺棄的希望',
    nil,
    'Leve as más notícias ao Oficial Maxwell.‡Сообщите маршалу Максвеллу плохие новости.‡Überbringt Marschall Maxwell die schlechten Neuigkeiten.‡치안대장 맥스웰에게 나쁜 소식을 전해줘야 합니다.‡Dale las malas noticias a mariscal Maxwell.‡Dale las malas noticias al mariscal Maxwell en la Vigilia de Morgan, en las Estepas Ardientes.‡Donner les mauvaises nouvelles au maréchal Maxwell.‡把这个坏消息传达给麦克斯韦尔元帅。‡把這個壞消息傳達給麥克斯韋爾元帥。',
  }
},
[4243] = {
  {
    'Procura-se A-Me 01‡В поисках Чи-Та 3‡Chasing A-Me 01‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-mi 01‡找回A-Me 01‡找回艾米 01',
    nil,
    'Encontre A-Me 01 na Cratera Un\'Goro.‡Найдите Чи-Та 3 в Кратере Ун\'Горо.‡Sucht im Krater von Un\'Goro nach A-Me 01.‡운고로 분화구에서 에이미 01을 찾아야 합니다.‡Encuentra a Memo 01 en el Cráter de Un\'Goro.‡Encuentra a Memo 01 en el Cráter de Un\'Goro.‡Trouver A-mi 01 dans le Cratère d\'Un\'Goro.‡在安戈洛环形山找到A-Me 01。‡在安戈洛環形山找到艾米 01。',
  }
},
[4244] = {
  {
    'Procura-se A-Me 01‡В поисках Чи-Та 3‡Chasing A-Me 01‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-mi 01‡找回A-Me 01‡找回艾米 01',
    nil,
    'Encontre uma Carcaça de Mithril e leve A-Me 01 de volta para a Cratera Un\'Goro.‡Найдите мифриловую обшивку и вернитесь к Чи-Та 3 в Кратер Ун\'Горо.‡Sucht ein Mithrilgehäuse und bringt es zu A-Me 01 im Krater von Un\'Goro.‡미스릴 형틀을 찾아 운고로 분화구에 있는 에이미 01에게 돌아가야 합니다.‡Encuentra una envoltura de mitril y reúnete de nuevo con Memo 01 en el Cráter de Un\'Goro.‡Encuentra una envoltura de mitril y reúnete de nuevo con Memo 01 en el Cráter de Un\'Goro.‡Trouver une Armature en mithril et retourner auprès d\'A-mi 01 dans le Cratère d\'Un\'Goro.‡找到一个秘银外壳，然后回到安戈洛环形山的A-Me 01身边。‡找到一個秘銀外殼，然後回到安戈洛環形山的艾米 01身邊。',
  }
},
[4245] = {
  {
    'Procura-se A-Me 01‡В поисках Чи-Та 3‡Chasing A-Me 01‡에이미 01 추적‡Buscando a Memo 01‡Buscando a Memo 01‡À la poursuite d\'A-mi 01‡找回A-Me 01‡找回艾米 01',
    nil,
    'Escolte A-Me 01 de volta para Karna Trilheiro na Cratera Un\'Goro.‡Доставьте Чи-Та 3 назад Карне Сомнамбулер в Кратер Ун\'Горо.‡Begleitet A-Me 01 zu Karna Wirrbart im Krater von Un\'Goro.‡운고로 분화구에 있는 카르나 렘트래블에게로 에이미 01을 호위해 가야 합니다.‡Lleva a Memo 01 de vuelta con Karna Tripirrem al Cráter de Un\'Goro.‡Lleva a Memo 01 de vuelta con Karna Tripirrem al Cráter de Un\'Goro.‡Escorter A-mi 01 sur le chemin du retour jusqu\'à Karna Songerrance dans le Cratère d\'Un\'Goro.‡将A-Me 01交给安戈洛环形山的卡尔纳-雷塔维。‡將艾米 01交給安戈洛環形山的卡爾納·雷塔維。',
  }
},
[4261] = {
  {
    'Espírito antigo‡Древний дух‡Alter Geist‡고대의 정령‡El espíritu de un Ancestro‡El espíritu de un Ancestro‡Esprit d\'un ancien‡远古之灵‡遠古之靈',
    nil,
    'Escolte Arei para um lugar seguro, depois fale com Kainet Brisacalma em Cantilenda, que fica no lado leste do Vale Gris.‡Сопроводите Арая в безопасное место, затем поговорите с Кайнетом Штилем в Лесной Песне на востоке Ясеневого леса.‡Bringt Arei in Sicherheit und sprecht dann mit Kayneth Stillwind in Waldeslied, im Osten des Eschentals.‡아레이를 안전하게 호위해야 합니다. 그리고 잿빛 골짜기 동쪽에 위치한 숲의 노래에 살고 있는 케이네스 스틸윈드와 얘기를 해야 합니다.‡Escolta a Arei y luego habla con Kayneth Ventoleve que está en Canción del Bosque, en la parte este de Vallefresno.‡Escolta a Arei y luego habla con Kayneth Ventoleve que está en Canción del Bosque, en la parte este de Vallefresno.‡Escorter Arei jusqu\'à un lieu sûr, puis parler à Kayneth Mortebrise au Chant des forêts, dans l\'est d\'Orneval.‡护送艾雷脱离危险，然后和灰谷东部的林歌神殿中的凯尼斯·静风谈一谈。‡護送艾雷到安全處，然後和梣谷東部林歌神殿的凱尼斯·靜風談話。',
  }
},
[4262] = {
  {
    'Mestre Supremo Piro‡Подчинитель Пирон‡Übermeister Pyron‡멸망의 파이론‡Maestro supremo Pyron‡Maestro supremo Pyron‡Grand seigneur Pyron‡征服者派隆‡征服者派隆',
    nil,
    'Mate o Mestre Supremo Piro e fale novamente com Jalinda Ramo.nnVocê se lembra de Jalinda ter dito que Piro guarda a pedreira. Que tal procurar por lá?‡Убейте подчинителя Пирона и вернитесь к Джалинде Тирлипуньке.nnКажется, Джалинда говорила, что Пирон охраняет каменоломню. Может, поискать его там?‡Erschlagt Übermeister Pyron und kehrt dann zu Jalinda Sprig zurück.nnIhr erinnert Euch an Jalindas Worte, dass Pyron den Steinbruch bewachen würde. Vielleicht solltet Ihr dort nachsehen?‡멸망의 파이론을 처치한 후 잘린다 스프리그에게 돌아가야 합니다.nn잘린다가 말하기를 파이론은 채석장을 지키고 있다고 하니 그곳을 수색해야 할 것 같습니다.‡Mata al Maestro Supremo Pyron y vuelve junto a Jalinda Espiga.nnRecuerdas que Jalinda dijo que Pyron guardaba la cantera. Quizás deberías empezar a buscar allí.‡Mata al Maestro Supremo Pyron.|nRecuerdas que Jalinda dijo que Pyron guardaba la cantera. Quizás deberías empezar a buscar allí.‡Tuer le Grand seigneur Pyron et retourner voir Jalinda Brindille.nnJalinda vous a dit qu\'il gardait la carrière. Peut-être devriez-vous chercher à cet endroit ?‡杀掉征服者派隆，然后向加琳达复命。nn加琳达告诉过你，派隆守在采矿场中，也许你应该去那里找找。‡殺掉征服者派隆，然後向加琳達覆命。|n加琳達告訴過你，派隆守在採礦場中，也許你應該去那裡找找。',
  }
},
[4263] = {
  {
    'Incendius!‡Опалитель!‡Incendius!‡인센디우스!‡¡Incendius!‡¡Incendius!‡Incendius !‡伊森迪奥斯！‡伊森迪奧斯!',
    nil,
    'Encontre Lorde Incendius no Abismo Rocha Negra e destrua-o!‡Отыщите и уничтожьте лорда Опалителя в глубинах Черной горы!‡Sucht Lord Incendius in den Schwarzfelstiefen und vernichtet ihn!‡검은바위 나락에서 불의군주 인센디우스를 찾아 처치해야 합니다.‡Encuentra a Lord Incendius en las Profundidades de Roca Negra ¡y acaba con él!‡Encuentra a Lord Incendius en las Profundidades de Roca Negra ¡y acaba con él!‡Trouver le Seigneur Incendius dans les Profondeurs de Rochenoire et le détruire !‡在黑石深渊里找到伊森迪奥斯，然后把他干掉！‡在黑石深淵裡找到伊森迪奧斯領主，然後把他幹掉!',
  }
},
[4264] = {
  {
    'Bilhete amassado‡Измятая записка‡Eine zusammengeknüllte Notiz‡꼬깃꼬깃한 쪽지‡Una nota arrugada‡Una nota arrugada‡Une Note chiffonnée‡弄皱的便笺‡弄皺的便箋',
    nil,
    'Você pode ter acabado de descobrir algo que o Marechal Vilasboas estaria interessado em ver. Pode haver esperança, afinal.‡Не исключено, что ваша находка заинтересует маршала Виндзора. Может быть, все не так плохо, и надежда еще жива.‡Soeben seid Ihr auf etwas gestoßen, das Marschall Windsor mit Sicherheit sehr interessiert. Vielleicht besteht ja doch noch Hoffnung.‡방금 우연히 치안대장 윈저가 보고 싶어할 듯한 물건을 찾은 것 같습니다. 어쩌면 희망이 있을지도 모릅니다.‡Puede que acabes de toparte con algo que le interesaría ver al mariscal Windsor. Puede que haya esperanza, después de todo.‡Puede que acabes de toparte con algo que le interesaría ver al mariscal Windsor. Puede que haya esperanza, después de todo.‡Il se peut que vous ayez simplement buté sur quelque chose qui pourrait intéresser le maréchal Windsor au plus haut point. Il reste peut-être encore un peu d\'espoir, après tout...‡温德索尔元帅也许会对你手中的东西感兴趣。毕竟，希望还没有被完全扼杀。‡溫德索爾元帥也許會對你手中的東西感興趣。畢竟，希望還沒有被完全扼殺。',
  }
},
[4265] = {
  {
    'Liberto da colmeia‡Освобожденный из улья‡Flucht aus dem Schwarmbau‡고치 탈출‡Liberado de la colmena‡Liberado de la colmena‡L\'évasion de la ruche‡逃离虫巢‡逃離蟲巢',
    nil,
    'Liberte Patiphe da colmeia de Zukk\'ash.nnAvise a Ginro Laracendis no Domínio de Plumaluna que Patiphe está são e salvo.‡Освободите Раскала из улья Цуккаш.nnВернитесь к Гинро Пылающему Очагу в Крепости Оперенной Луны и сообщите ему, что Раскал жив и здоров.‡Begleitet Raschal sicher aus dem Schwarmbau der Zukk\'ash hinaus.nnKehrt zu Ginro Herdfeuer in der Mondfederfeste zurück und lasst ihn wissen, dass Raschal am Leben ist und dass es ihm gut geht.‡주크애쉬 소굴에서 라스칼을 풀어줘야 합니다.nn페더문 요새에 있는 긴로 하트킨들에게 돌아가 라스칼이 무사히 살아 있다는 소식을 전해 주십시오.‡Libera a Raschal de la vaina de los Zukk\'ash.nnVuelve al Bastión Plumaluna con Ginro Mechogar e infórmale de que Raschal está bien.‡Libera a Raschal de la vaina de los Zukk\'ash.|nVuelve al Bastión Plumaluna con Ginro Mechogar e infórmale de que Raschal está bien.‡Libérer Raschal de la ruche de Zukk\'ash.nnRevenir voir Ginro Attisâtre au bastion de Pennelune et lui dire que Raschal est sain et sauf.‡将拉斯卡尔安全护送到祖卡什虫巢外。nn回到羽月要塞的基恩诺·火花那儿，告诉他拉斯卡尔还活着，且状况良好。‡到祖卡什蟲巢拯救拉斯卡爾。|n回到羽月要塞的基恩諾·燃爐那兒，告訴他拉斯卡爾還活著，且狀況良好。',
  }
},
[4266] = {
  {
    'Uma recepção digna de heróis‡Благодарность за отвагу‡Der Empfang eines Helden‡영웅 환영‡La bienvenida de un héroe‡La bienvenida de un héroe‡Accueil d\'un héros‡羽月将军的欢迎‡羽月將軍的歡迎',
    nil,
    'Fale com Shandris Plumaluna no Domínio de Plumaluna.‡Поговорите с Шандрисой Оперенной Луной в Крепости Оперенной Луны.‡Sprecht mit Shandris Mondfeder in der Mondfederfeste.‡페더문 요새에 있는 샨드리스 페더문과 대화해야 합니다.‡Habla con Shandris Plumaluna del Bastión Plumaluna.‡Habla con Shandris Plumaluna del Bastión Plumaluna.‡Parler à Shandris Pennelune dans le bastion de Pennelune.‡与羽月要塞的珊蒂斯·羽月谈一谈。‡與羽月要塞的珊蒂斯·羽月談話。',
  }
},
[4267] = {
  {
    'A ascensão dos silitídeos‡Появление силитидов‡Aufstieg der Silithiden‡실리시드의 출현‡El alzamiento de los silítidos‡La sublevación de los silítidos‡L\'ascension des silithides‡异种蝎的崛起‡異種蠍的威脅',
    nil,
    'Leve o Relatório do Patiphe para Gracinha Forçânima em Darnassus.‡Отнесите донесение Раскала Грацине Силе Духа в Дарнассе.‡Bringt Raschals Bericht zu Gracina Glaubensmacht in Darnassus.‡다르나서스에 있는 그라시나 스피릿마이트에게 라스칼의 보고서를 가져가야 합니다.‡Lleva el informe de Raschal a Gracina Poderespíritu a Darnassus.‡Lleva el informe de Raschal a Gracina Poderespíritu a Darnassus.‡Apporter le Rapport de Raschal à Gracina Forcesprit à Darnassus.‡把拉斯卡尔的报告交给达纳苏斯的格拉希娜·灵风。‡把拉斯卡爾的報告交給達納蘇斯的格拉希娜·靈風。',
  }
},
[4281] = {
  {
    'Entrega em Thalanaar‡Посылка в Таланаар‡Thalanaar-Lieferung‡탈라나르 배달‡Una entrega en Thalanaar‡Una entrega en Thalanaar‡La livraison à Thalanaar‡萨兰纳尔的货物‡薩蘭納爾的貨物',
    nil,
    'Leve o Pacote Extraviado para Falfindel Trilhemas em Thalanaar.‡Отнесите недоставленную посылку Хранителю дорог Фалфиндеру в Таланаар.‡Bringt das nicht ausgelieferte Paket zu Falfindel Wegeshut in Thalanaar.‡탈라나르에 있는 팔핀델 웨이워더에게 배달되지 않은 꾸러미를 가져가야 합니다.‡Lleva el paquete sin entregar a Díscolo Falfindel a Thalanaar.‡Lleva el paquete sin entregar a Díscolo Falfindel a Thalanaar.‡Apporter le Vieux colis à Falfindel Gardevoie, à Thalanaar.‡将未递送的包裹交给萨兰纳尔驿站的法芬德尔。‡將未遞送的包裹交給薩蘭納爾驛站的法芬德爾。',
  }
},
[4282] = {
  {
    'Um fiapo de esperança‡Проблеск надежды‡Ein Funken Hoffnung‡잔존하는 희망‡Una esperanza hecha trizas‡Una brizna de esperanza‡Un espoir en lambeaux‡一丝希望‡一絲希望',
    nil,
    'Recupere as Informações Perdidas do Marechal Vilasboas.nnO Marechal Vilasboas acredita que as informações estão sendo mantidas pelo Lorde Golem Argelmach e pelo General Forjaversa.‡Верните маршалу Виндзору утерянную информацию.nnМаршал уверен, что информацией завладели повелитель големов Аргелмах и генерал Кузня Гнева.‡Holt Marschall Windsors verlorene Informationen zurück.nnMarschall Windsor glaubt, dass sich die Informationen in den Händen des Golemlords Argelmach und des Generals Zornesschmied befinden.‡치안대장 윈저의 잃어버린 단서를 가져 와야 합니다.nn치안대장 윈저는 골렘 군주 아젤마크와 사령관 앵거포지가 이 정보를 가지고 있을 것이라 생각합니다.‡Devuélvele al mariscal Windsor la información perdida.nnEl mariscal Windsor cree que la información está siendo retenida en manos del Señor Gólem Argelmach y del general Forjainquina.‡Devuélvele al mariscal Windsor la información perdida.|nEl mariscal Windsor cree que la información está siendo retenida en manos del Señor Gólem Argelmach y del general Forjainquina.‡Rapporter les Informations égarées du maréchal Windsor.nnLe maréchal Windsor pense qu\'ils sont détenus par le seigneur golem Argelmach et par le général Forgehargne.‡找回温德索尔元帅遗失的情报。nn温德索尔元帅确信那些情报在安格弗将军和傀儡统帅阿格曼奇的手里。‡找回溫德索爾元帥遺失的情報。|n溫德索爾元帥確信那些情報在安格弗將軍和魔像領主阿格曼奇的手裡。',
  }
},
[4283] = {
  {
    'CINQUENTA! ISSO!‡ПЯТЬДЕСЯТ! АГА!‡FÜNFZIG! Jawoll!‡50개의 메달‡¡CINCUENTA! ¡SÍ!‡¡CINCUENTA! ¡SÍ!‡CINQUANTE ! OUI !‡五十个！‡五十個!',
    nil,
    'Oralius quer 50 Medalhões Rocha Negra. Há grandes chances de esses medalhões serem encontrados com orcs nas Estepes Ardentes.‡Орелиусу нужны 50 медальонов Черной горы. Скорее всего их можно найти у орков Пылающих степях.‡Oralius will 50 Medaillons des Schwarzfelsklans haben. Die Chancen stehen gut, dass man die Medaillons bei den Orcs in der brennenden Steppe findet.‡랄리우스가 검은바위부족 메달 50개를 가져다 달라고 부탁했습니다. 불타는 평원에 있는 오크들에게서 메달을 구할 수 있는 가능성이 큽니다.‡Oralius quiere 50 medallones Roca Negra. Con toda probabilidad encontrarás estos medallones en los orcos de Las Estepas Ardientes.‡Reúne 50 medallones Roca Negra.‡Oralius veut 50 Médaillons de Rochenoire. Il y a de fortes chances de trouver ces médaillons sur les orcs des Steppes ardentes.‡奥拉留斯想要50枚黑石徽章。在燃烧平原的兽人身上应该可以找到那些徽章。‡奧拉留斯想要50枚黑石勳章。在燃燒平原的獸人身上應該可以找到那些勳章。',
  }
},
[4284] = {
  {
    'Cristais de poder‡Кристаллы Силы‡Machtkristalle‡마력의 수정‡Cristales de poder‡Cristales de poder‡Cristaux de puissance‡能量水晶‡能量水晶',
    nil,
    'Colete 7 Cristais de Poder de cada uma das seguintes cores: vermelho, azul, amarelo e verde. Leve-os para J.D. Neri no Refúgio do Marshal.‡Соберите по 7 кристаллов Силы каждого цвета: красных, синих, желтых и голубых. Принесите их Джей Ди Колли в Укрытие Маршалла.‡Sammelt 7 Machtkristalle von jeder Farbe: rot, blau, gelb und grün. Bringt sie zu J. D. Collie in Marschalls Zuflucht.‡붉은 마력의 수정, 푸른 마력의 수정, 노란 마력의 수정, 녹색 마력의 수정을 각각 7개씩 모아 마샬의 야영지에 있는 J.D. 콜리에게 가져가야 합니다.‡Recoge 7 cristales de poder de cada color: rojo, azul, amarillo y verde. Llévaselos a J.D. Collie en el Refugio de Marshal.‡Recoge 7 cristales de poder de cada color: rojo, azul, amarillo y verde. Llévaselos a J.D. Collie en el Refugio de Marshal.‡Récupérer 7 Cristaux de puissance de chaque couleur (rouge, bleu, jaune et vert). Les apporter à J.D. Collie au refuge des Marshal.‡收集红色能量水晶、蓝色能量水晶、黄色能量水晶和绿色能量水晶各7块，把它们交给马绍尔营地里的科琳。‡收集紅色能量水晶、藍色能量水晶、黃色能量水晶和綠色能量水晶各7塊，把它們交給馬紹爾營地裡的科琳。',
  }
},
[4285] = {
  {
    'A torre norte‡Северный пилон‡Der Nordpylon‡북쪽 수정탑‡La Torre de cristal del Norte‡La Torre de cristal del Norte‡Le Pylône nord‡北部水晶塔‡北部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Norte, que fica na Cratera Un\'Goro.‡Отыщите Северный хрустальный пилон в Кратере Ун\'Горо.‡Findet den Standort des nördlichen Kristallpylonen im Krater von Un\'Goro.‡운고로 분화구에 있는 북쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Norte en el Cráter de Un\'Goro.‡Descubre la localización de la Torre de Cristal del Norte en el Cráter de Un\'Goro.‡Découvrir l\'emplacement du Pylône de cristal nord dans le Cratère d\'Un\'Goro.‡在安戈洛尔环形山找到北部水晶塔。‡在安戈洛環形山找到北部水晶塔。',
  }
},
[4286] = {
  {
    'Produto de primeira‡Хороший товар‡Feine Sachen‡좋은 물건‡Buena mercancía‡Buena mercancía‡Du beau matériel‡好东西‡好東西',
    nil,
    'Viaje para o Abismo Rocha Negra e recupere 20 Pochetes Ferro Negro. Fale novamente com Oralius quando tiver completado a tarefa. Você supõe que os anões Ferro Negro de dentro do Abismo Rocha Negra carregam essa tal de "pochete".‡Отправьтесь в глубины Черной горы и принесите 20 поясных сумок дворфов Черного Железа. По выполнении задания вернуться к Орелиусу. Предположительно поясные сумки можно отобрать у дворфов Черного Железа в глубинах Черной горы.‡Reist in die Schwarzfelstiefen und holt 20 Dunkeleisengürteltaschen. Kehrt zu Oralius zurück, sobald die Aufgabe erledigt ist. Ihr nehmt an, dass die Dunkeleisenzwerge in den Schwarzfelstiefen diese \'Gürteltaschen\'-Dinger tragen.‡검은바위 나락으로 가서 검은무쇠단 벨트주머니 20개를 얻어야 합니다. 이 임무를 완수하면 랄리우스에게 돌아가십시오. 검은바위 나락 안에 사는 검은무쇠단 드워프들이 이 \'벨트주머니\'라는 물건을 지니고 다닐 것입니다.‡Viaja a las Profundidades de Roca Negra y recupera 20 riñoneras Hierro Negro. Vuelve junto a Oralius cuando hayas completado esta tarea. Se da por sentado que los enanos Hierro Negro de las Profundidades de Roca Negra llevan estos inventos de riñoneras.|n‡Recupera 20 riñoneras Hierro Negro.‡Se rendre dans les Profondeurs de Rochenoire et trouver 20 Sacoches Sombrefer. Retourner voir Oralius lorsque vous aurez accompli cette tâche. Logiquement, ces sacoches devraient être sur les nains Sombrefer des Profondeurs de Rochenoire.‡到黑石深渊去找到20个黑铁挎包。当你完成任务之后，回到奥拉留斯那里复命。你认为黑石深渊里的黑铁矮人应该会有这些黑铁挎包。‡到黑石深淵去找到20個黑鐵挎包。當你完成任務之後，回到奧拉留斯那裡覆命。你認為黑石深淵裡的黑鐵矮人應該會有這些黑鐵挎包。',
  }
},
[4287] = {
  {
    'A torre leste‡Восточный пилон‡Der Ostpylon‡동쪽 수정탑‡La Torre de cristal del Este‡La Torre de cristal del Este‡Le Pylône est‡东部水晶塔‡東部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Leste, que fica na Cratera Un\'Goro.‡Отыщите Восточный хрустальный пилон в Кратере Ун\'Горо.‡Findet den Standort des östlichen Kristallpylonen im Krater von Un\'Goro.‡운고로 분화구에 있는 동쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Este en el Cráter de Un\'Goro.‡Descubre la localización de la Torre de Cristal del Este en el Cráter de Un\'Goro.‡Trouver l\'emplacement du Pylône de cristal est dans le Cratère d\'Un\'Goro.‡在安戈洛尔环形山找到东部水晶塔。‡在安戈洛環形山找到東部水晶塔。',
  }
},
[4288] = {
  {
    'A torre oeste‡Западный пилон‡Der Westpylon‡서쪽 수정탑‡La Torre de cristal del Oeste‡La Torre de cristal del Oeste‡Le Pylône ouest‡西部水晶塔‡西部水晶塔',
    nil,
    'Descubra a localização da Torre de Cristal Oeste, que fica na Cratera Un\'Goro.‡Отыщите Западный хрустальный пилон.‡Findet den Standort des westlichen Kristallpylonen.‡운고로 분화구에 있는 서쪽 수정탑의 위치를 알아내야 합니다.‡Descubre la localización de la Torre de Cristal del Oeste.‡Descubre la localización de la Torre de Cristal del Oeste.‡Découvrir l\'emplacement du Pylône de cristal ouest.‡在安戈洛尔环形山找到西部水晶塔。‡在安戈洛環形山找到西部水晶塔。',
  }
},
[4289] = {
  {
    'Os macacos de Un\'Goro‡Обезьяны Ун\'Горо‡Die Affen von Un\'Goro‡운고로의 유인원‡Los simios de Un\'Goro‡Los simios de Un\'Goro‡Les gorilles d\'Un\'Goro‡安戈洛的猩猩‡安戈洛的猩猩',
    nil,
    'Leve 2 Pelagens de Gorila de Un\'Goro, 2 Pelagens de Pisoteador de Un\'Goro, 2 Pelagens de Trovejador de Un\'Goro para Torwa Mateiro na entrada da Cratera Un\'Goro.‡Принесите 2 шкуры Ун\'Горской гориллы, 2 шкуры Ун\'Горского топтуна и 2 шкуры Ун\'Горского рокотуна землепроходцу Торве к входу в Кратер Ун\'Горо.‡Bringt Torwa Pfadfinder am Eingang zum Krater von Un\'Goro 2 Gorillapelze von Un\'Goro, 2 Stampferpelze von Un\'Goro und 2 Donnererpelze von Un\'Goro.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 운고로 고릴라 모피 2개, 운고로 우레고릴라 모피 2개, 운고로 천둥고릴라 모피 2개를 가져가야 합니다.‡Llévale 2 pelambres de gorila de Un\'Goro, 2 pelambres de vapuleador de Un\'goro y 2 pelambres de tronador de Un\'Goro a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Llévale 2 pelambres de gorila de Un\'Goro, 2 pelambres de vapuleador de Un\'Goro y 2 pelambres de tronador de Un\'Goro a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Apporter 2 Peaux de gorille d\'Un\'Goro, 2 Peaux de marteleur d\'Un\'Goro et 2 Peaux de foudroyeur d\'Un\'Goro à Torwa le Guide à l\'entrée du cratère d\'Un\'Goro.‡将2块安戈洛猩猩的皮、2块安戈洛大猩猩的皮和2块安戈洛巨猩猩的皮交给安戈洛环形山入口处的托尔瓦·寻路者。‡將2塊安戈洛猩猩的皮、2塊安戈洛大猩猩的皮和2塊安戈洛巨猩猩的皮交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4290] = {
  {
    'A dieta de Lar\'korwi‡Добыча Лар\'корви‡Lar\'korwis Mahl‡라르코르위의 먹이‡La comida de Lar\'korwi‡La comida de Lar\'korwi‡La nourriture de Lar\'korwi‡拉克维的食物‡拉克維的食物',
    nil,
    'Encontre a carcaça mais recente de uma presa morta por Lar\'korwi e roube um Pedaço de Carcaça de Manguadonte. Depois disso, fale novamente com Torwa Mateiro na Cratera Un\'Goro.‡Найдите последнюю добычу Лар\'корви, украдите кусок трупа жесткозуба и вернитесь к землепроходцу Торве в Кратер Ун\'Горо.‡Sucht das Gerippe von Lar\'korwis letzter Jagdbeute und stehlt einen Teil eines Dreschadongerippes; kehrt dann zu Torwa Pfadfinder im Krater von Un\'Goro zurück.‡라르코르위가 막 잡은 사냥감을 찾아 트레샤돈 시체 덩이를 훔친 후 운고로 분화구에 있는 토르와 패스파인더에게 돌아가야 합니다.‡Encuentra la última presa muerta de Lar\'korwi y roba un trozo de trillanodonte muerto, y después ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Encuentra la última presa muerta de Lar\'korwi y roba un trozo de trillanodonte muerto, y después ve a ver de nuevo a Torwa Abrecaminos al Cráter de Un\'Goro.‡Trouver la dernière victime de Lar\'korwi et voler un Morceau de carcasse d\'un battrodon, puis retourner voir Torwa le Guide au Cratère d\'Un\'Goro.‡找到拉克维刚刚猎杀的动物的尸体，从尸体上偷取一块蛇颈龙肉块，然后回到安戈洛环形山的托尔瓦·寻路者那里。‡找到拉克維剛剛獵殺的動物的屍體，從屍體上偷取一塊蛇頸龍肉塊，然後回到安戈洛環形山的托爾瓦·尋路者那裡。',
  }
},
[4291] = {
  {
    'O olfato de Lar\'korwi‡Запах Лар\'корви‡Lar\'korwis Fährte‡라르코르위의 냄새‡Un aroma irresistible para Lar\'korwi‡Un aroma irresistible para Lar\'korwi‡Un parfum pour Lar\'korwi‡拉克维的气味‡拉克維的氣味',
    nil,
    'Leve 2 Glândulas de Feromônio de Ravassauro para Torwa Mateiro, que está perto da entrada da Cratera Un\'Goro.‡Принесите 2 феромонные железы равазавра землепроходцу Торве в преддверие Кратера Ун\'Горо.‡Bringt Torwa Pfadfinder in der Nähe des Eingangs zum Krater von Un\'Goro 2 Pheromondrüsen eines Ravasaurus.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 라바사우루스 페로몬샘 2개를 가져가야 합니다.‡Llévale 2 glándulas de feromonas de ravasaurio a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Llévale 2 glándulas de feromonas de ravasaurio a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Apporter 2 Glandes de phéromone de ravasaure à Torwa le Guide près de l\'entrée du Cratère d\'Un\'Goro.‡将2份暴掠龙信息素交给安戈洛尔环形山入口附近的托尔瓦·寻路者。‡將2份暴掠龍資訊素交給安戈洛環形山入口附近的托爾瓦·尋路者。',
  }
},
[4292] = {
  {
    'A isca para Lar\'korwi‡Приманка для Лар\'корви‡Ein Köder für Lar\'korwi‡라르코르위를 위한 미끼‡El cebo para Lar\'korwi‡El cebo para Lar\'korwi‡Un appât pour Lar\'korwi‡拉克维的诱饵‡拉克維的誘餌',
    nil,
    'Use o conteúdo do Bornal do Torwa para evocar Lar\'korwi e derrotá-lo. Então, leve a Cabeça do Lar\'korwi para Torwa Mateiro, que está perto da entrada da Cratera Un\'Goro.‡С помощью предметов из мешочка Торвы выманите Лар\'корви и сразите его. Принесите голову Лар\'корви землепроходцу Торве ко входу в Кратер Ун\'Горо.‡Beschwört Lar\'korwi mit dem Inhalt von Torwas Beutel und besiegt ihn. Bringt dann Lar\'korwis Kopf zu Torwa Pfadfinder in der Nähe des Eingangs zum Krater von Un\'Goro.‡토르와의 주머니에 든 물건들로 라르코르위를 불러내 물리친 후 라르코르위의 머리를 운고로 분화구 입구에 있는 토르와 패스파인더에게 가져가야 합니다.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡Utiliza el contenido de la faltriquera de Torwa para atraer la presencia de Lar\'korwi y derrótalo. Después llévale la cabeza de Lar\'korwi a Torwa Abrecaminos, que está cerca de la entrada del Cráter de Un\'Goro.‡En utilisant le contenu de la Sacoche de Torwa, appeler Lar\'korwi et le vaincre. Puis apporter la Tête de Lar\'korwi à Torwa le Guide près de l\'entrée du Cratère d\'Un\'Goro.‡使用托尔瓦的麻袋中的东西召唤拉克维并打败它。将拉克维的头颅交给安戈洛环形山入口处的托尔瓦·寻路者。‡使用托爾瓦的麻袋中的東西召喚拉克維並打敗它。將拉克維的頭顱交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4293] = {
  {
    'Uma amostra de visgo...‡Проба слизи...‡Eine Brühschleimerprobe...‡진흙괴물 견본...‡Muestras de babosa...‡Muestras de babosa...‡Un échantillon de gelée...‡软泥怪的样本...‡軟泥怪的樣本…',
    nil,
    'Colha Amostras de Visgo da Selva Maleva de qualquer visgo em Selva Maleva. Depois, usando o Equipamento de Teste ao lado do Químico Sérgio, na Cidade Baixa, veja quais das suas amostras são as mais corrompidas. Leve 5 das Amostras Corrompidas da Selva Maleva que você encontrar para o Químico Sérgio.‡Возьмите на пробу образцы слизи из Оскверненного леса. Воспользуйтесь тестовым оборудованием химика Барабоса в Катакомбах, чтобы отобрать 5 наиболее чистых образцов и отдайте их ему.‡Sammelt Teufelswaldschleimproben von den Brühschlammern im Teufelswald. Verwendet dann die Testausrüstung neben Chemiker Brenner in Unterstadt, um zu sehen, welche Eurer Proben am verderbtesten sind. Bringt 5 der verderbten Teufelswaldproben, die Ihr findet, zu Chemiker Brenner.‡악령의 숲에 있는 진흙괴물에게서 악령의숲 진흙괴물 견본을 모은 후 언더시티의 연금술사 퓰리 옆에 있는 실험 기구를 사용해 어느 견본이 가장 부패한 것들인지 알아내야 합니다. 부패한 악령의숲 견본 5개를 찾으면 연금술사 퓰리에게 가져가야 합니다.‡Recoge muestras de babosa de Frondavil de cualquiera de las babosas que encuentres en Frondavil. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras están más corruptas. Llévale 5 de las muestras de Frondavil corruptas que encuentres al químico Fuely.‡Recoge muestras de babosa de Frondavil de cualquiera de las babosas que encuentres en Frondavil. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras están más corruptas. Llévale 5 de las muestras de Frondavil corruptas que encuentres al químico Fuely.‡Ramassez des Échantillons de gelée de Gangrebois sur n\'importe quel type de gelée de Gangrebois. Puis, en utilisant le Matériel d\'expérience qui se trouve à côté du chimiste Fuely à Fossoyeuse, décelez les échantillons le plus corrompus. Apportez 5 Échantillons corrompus de Gangrebois que vous aurez obtenus au Chimiste Fuely.‡从费伍德的软泥怪身上收集费伍德软泥怪样本，然后使用幽暗城的化学家弗雷身旁的测试设备来检测你所收集的样本中哪一份被腐化的程度最深。给化学家弗雷带去5个被腐化的费伍德样本。‡從費伍德的軟泥怪身上收集費伍德軟泥怪樣本，然後使用幽暗城的化學家弗雷身旁的測試設備來檢測你所收集的樣本中哪一份被腐化的程度最深。給化學家弗雷帶去5個被腐化的費伍德樣本。',
  }
},
[4294] = {
  {
    '... E um lote de gosma‡...и образцы слизнюков‡...und eine Menge Brühschlammer‡... 그리고 한 무리의 수액괴물‡... y unos mocos‡... y unos mocos‡... et une fournée de limon‡一大堆软泥怪‡一大堆軟泥怪',
    nil,
    'Colha Amostras de Visgo de Un\'Goro de qualquer visgo na Cratera Un\'Goro. Depois, usando o Equipamento de Teste ao lado do Químico Sérgio, na Cidade Baixa, veja quais das suas amostras são as mais puras. Leve 5 das Amostras Puras de Un\'Goro que você encontrar para o Químico Sérgio.‡Возьмите на пробу образцы слизи из кратера Ун\'Горо. Воспользуйтесь тестовым оборудованием химика Барабоса в Катакомбах, чтобы отобрать 5 наиболее чистых образцов и отдайте их ему.‡Sammelt Brühschleimerprobe von Un\'Goro von jedem der Brühschleimer im Krater von Un\'Goro. Verwendet dann die Testausrüstung neben Chemiker Brenner in Unterstadt, um zu sehen, welche Eurer Proben am reinsten sind. Bringt 5 der reinen Proben von Un\'Goro, die Ihr findet, zu Chemiker Brenner.‡운고로 분화구에 있는 진흙괴물과 수액괴물에게서 운고로 진흙괴물 견본을 모은 후 언더시티의 연금술사 퓰리 옆에 있는 실험 기구를 사용해 어느 견본이 가장 순수한 것인지 알아내야 합니다. 순수한 운고로 견본 5개를 찾으면 연금술사 퓰리에게 가져가야 합니다.‡Recoge muestras de babosa de Un\'Goro de cualquiera de las babosas que encuentres en el Cráter de Un\'Goro. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras son más puras. Llévale 5 de las muestras de Un\'Goro puras que encuentres al químico Fuely.‡Recoge muestras de babosa de Un\'Goro de cualquiera de las babosas que encuentres en el Cráter de Un\'Goro. Después utiliza el equipo de estudio que el químico Fuely tiene al lado, en Entrañas, para ver qué muestras son más puras. Llévale 5 de las muestras de Un\'Goro puras que encuentres al químico Fuely.‡Ramassez des Échantillons de gelée d\'Un\'Goro sur sur n\'importe quel type de gelée du Cratère d\'Un\'Goro. Puis, en utilisant le Matériel d\'expérience qui se trouve à côté du chimiste Fuely à Fossoyeuse, décelez les échantillons les plus purs. Apporter 5 Échantillons purs d\'Un\'Goro que vous aurez obtenus au Chimiste Fuely.‡从安戈洛尔环形山那里任何泥浆怪身上收集安戈洛泥浆怪样本。使用幽暗城的化学家弗雷身旁的测试仪器来检验你所采集到的样本的纯度。把5份纯净的安戈洛样本送到化学家弗雷那里去。‡從安戈洛環形山那裡任何泥漿怪身上收集安戈洛泥漿怪樣本。使用幽暗城的化學家弗雷身旁的測試儀器來檢驗你所採集到的樣本的純度。把5份純淨的安戈洛樣本送到化學家弗雷那裡去。',
  }
},
[4295] = {
  {
    'Cerveja Pedrosa‡Эль для Каменного Узла‡Rocknots Bier‡락노트의 에일 맥주‡La cerveza de Sinrosca‡La cerveza de Sinroca‡La bière de Rocknot‡罗克诺特的麦酒‡羅克諾特的麥芽酒',
    nil,
    'Ah, cerveja! O que eu não faria por uma cervejinha Ferro Negro!! Rápido, eu estou ficando sóbrio de novo! Percebo porque sobriedade deixa minha visão embaçada... e você está começando a ficar que nem o <race> que eu matei semana passada!‡Кружечка доброго эля Черного Железа была бы сейчас очень кстати! Быстрее, а то я уже начинаю трезветь! А когда я трезвею, у меня сразу мутится зрение... и все расплывается... и ты почему-то становишься очень похожим на того |3-6(человек), которого я грохнул на прошлой неделе.‡Oh, Bier! Was würde ich nicht für etwas Dunkeleisenbier geben! Schnell, ich werde langsam nüchtern! Das weiß ich, weil mir die Nüchternheit die Sinne trübt... und weil es Euch aussehen lässt wie der <Volk>, den ich letzte Woche erschlagen habe!‡‡¡Oh, cerveza! ¡¡Mataría por algo de cerveza Hierro Negro!! ¡Rápido, que me estoy poniendo sobrio! Lo sé porque la sobriedad me nubla la vista... ¡y eso hace que te parezcas al <raza> que maté la semana pasada!‡‡Oh, de la bière ! Je tuerais pour une bonne bière de Sombrefer, <nom> ! Vite, je deviens sobre ! Je le sais car la sobriété trouble ma vision… et cela vous fait ressembler à celui que j\'ai massacré la semaine dernière !‡‡',
  }
},
[4296] = {
  {
    'Tabuletas dos Sete‡Табличка Семерых‡Schrifttafel der Sieben‡일곱 현자의 서판‡La tablilla de los Siete‡La tablilla de los Siete‡Tablette des Sept‡七贤石板‡七賢石板',
    nil,
    'Leve a Transcrição de Tabuleta para Maxwort Uberraio nas Estepes Ardentes.‡Принесите переписанный с таблички текст Максворту Суперблеску в Пылающие степи.‡Bringt Maxwort Funkelglanz in der brennenden Steppe die Abschrift der Schrifttafel.‡불타는 평원에 있는 맥스워트 우버글린트에게 서판 사본을 가져가야 합니다.‡Llévale la trascripción de tablilla a Maxwort Suprandor en Las Estepas Ardientes.‡Obtén la transcripción de tablilla.‡Apporter la Transcription de la tablette à Maxwort Uberbrille dans les Steppes ardentes.‡把石板拓文交给燃烧平原的麦克斯沃特·尤博格林。‡把石板拓文交給燃燒平原的麥克斯沃特·尤柏格林。',
  }
},
[4297] = {
  {
    'Papá pro piá‡Покормить малыша‡Essen für das Baby‡먹이 찾기‡Comida para el bebé‡Comida para el bebé‡Nourriture pour bébé‡小精龙的食物‡小精龍的食物',
    nil,
    'Leve 5 Lombos de Espreitador Jubaprata para Agnar Domaferas nas Terras Agrestes.‡Принесите 5 окороков среброгривого бродяги Агнару Зверопасу во Внутренних землях.‡Bringt Agnar Tiermeister im Hinterland 5 Silbermähnenpirscherflanken.‡동부 내륙지에 있는 아그나르 비스테이머에게 긴발톱 은빛갈기늑대 갈빗살 5개를 가져가야 합니다.‡Lleva 5 costillas de acechador melenargenta a Agnar Domabestias a las Tierras del Interior.‡Lleva 5 costillas de acechador melenargenta a Agnar Domabestias a las Tierras del Interior.‡Apporter 5 Flanchets de traqueur Crins-d\'argent à Agnar Domptebêtes dans les Hinterlands.‡将5块银鬃捕猎者的肉交给辛特兰的阿格纳。‡將5塊銀鬃捕獵者的肉交給辛特蘭的阿格納。',
  }
},
[4298] = {
  {
    'Bebê a bordo‡У вас появился малыш!‡Elternfreuden‡부모 되기‡El amor parental‡El amor parental‡L\'amour d\'un parent‡为人父母‡為人父母',
    nil,
    'Fale com Agnar Domaferas nas Terras Agrestes.‡Поговорите с Агнаром Зверопасом во Внутренних землях.‡Sprecht mit Agnar Tiermeister im Hinterland.‡동부 내륙지에 있는 아그나르 비스테이머와 대화해야 합니다.‡Habla con Agnar Domabestias en las Tierras del Interior.‡Habla con Agnar Domabestias en las Tierras del Interior.‡Parler à Agnar Domptebêtes dans les Hinterlands.‡与辛特兰的阿格纳谈一谈。‡與辛特蘭的阿格納談話。',
  }
},
[4300] = {
  {
    'Armas de gume de osso‡Костяные клинки‡Knochenklingenwaffen‡발톱으로 만든 무기‡Armas con filo de hueso‡Armas con filo de hueso‡Les armes aux lames d\'os‡骨刃武器‡骨刃武器',
    nil,
    'Leve 8 Garras Brancas de Ravassauro para Sona\'rima em Orgrimmar.‡Принесите 8 белых когтей равазавра Джес\'римону в Оргриммаре.‡Bringt Jes\'rimon in Orgrimmar 8 weiße Ravasaurusklauen.‡오그리마에 있는 제스리몬에게 라바사우루스의 흰발톱 8개를 가져가야 합니다.‡Lleva 8 garras blancas de ravasaurio a Jes\'rimon a Orgrimmar.‡Lleva 8 garras blancas de ravasaurio a Jes\'rimon a Orgrimmar.‡Apporter 8 Griffes blanches de ravasaure à Jes\'rimon à Orgrimmar.‡将8只白色暴掠龙爪交给奥格瑞玛的杰斯雷蒙。‡將8隻白色暴掠龍爪交給奧格瑪的傑斯雷蒙。',
  }
},
[4301] = {
  {
    'O poderoso U\'cha‡Могучая Уча‡Der mächtige U\'cha‡강대한 우차‡El poderoso U\'cha‡El poderoso U\'cha‡Le puissant U\'cha‡强大的尤尔查‡強大的尤爾查',
    nil,
    'Leve Pelagem de U\'cha para Torwa Mateiro na entrada da Cratera Un\'Goro.‡Принесите шкуру Учи землепроходцу Торве ко входу в Кратер Ун\'Горо.‡Bringt U\'chas Pelz zu Torwa Pfadfinder am Eingang des Kraters von Un\'Goro.‡운고로 분화구 입구에 있는 토르와 패스파인더에게 우차의 모피를 가져가야 합니다.‡Llévale la pelambre de U\'cha a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Llévale la pelambre de U\'cha a Torwa Abrecaminos, que está a la entrada del Cráter de Un\'Goro.‡Apporter la Peau d\'U\'cha à Torwa le Guide à l\'entrée du Cratère d\'Un\'Goro.‡把尤尔查的毛皮交给安戈洛环形山入口处的托尔瓦·寻路者。‡把尤爾查的毛皮交給安戈洛環形山入口處的托爾瓦·尋路者。',
  }
},
[4321] = {
  {
    'Entendendo tudo‡Давай-ка разберемся‡Die Sache verstehen‡수정탑 정보 수집‡Entender el significado‡Entender el significado‡Ceci explique cela‡分析水晶塔‡分析水晶塔',
    nil,
    'Fale com J.D. Neri em um instante.‡Поговорите с Джей Ди Колли через пару минут.‡Sprecht demnächst mit J. D. Collie.‡잠시 기다린 후, J.D. 콜리와 대화해야 합니다.‡Habla en un momento con J.D. Collie.‡Habla en un momento con J.D. Collie.‡Parler à J.D. Collie dans un moment.‡过一会再和科琳说话。‡過一會再和科琳說話。',
  }
},
[4322] = {
  {
    'Fuga da prisão!‡Побег!‡Gefängnisausbruch!‡탈옥!‡La fuga de la prisión‡La fuga de la prisión‡Evasion !‡冲破牢笼！‡衝破牢籠!',
    nil,
    'Ajude o Marechal Vilasboas a recuperar seu equipamento e libertar seus amigos. Se conseguir, fale novamente com o Oficial Maxwell.‡Помогите маршалу Виндзору забрать вещи и освободить его друзей, после чего вернитесь к маршалу Максвеллу и получите дальнейшие инструкции.‡Helft Marschall Windsor, seine Ausrüstung zurückzuholen und seine Freunde zu befreien. Kehrt zu Marschall Maxwell zurück, wenn Ihr Erfolg hattet.‡치안대장 윈저가 자신의 장비를 되찾고 갇힌 동료들을 풀어 주는 것을 도와야 합니다. 성공하면 치안대장 맥스웰에게 돌아가십시오.‡Ayuda al mariscal Windsor a recuperar su equipo y a liberar a sus amigos. Vuelve junto al mariscal Maxwell si lo consigues.‡Ayuda al mariscal Windsor a recuperar su equipo y a liberar a sus amigos. Vuelve junto al mariscal Maxwell si lo consigues.‡Aider le maréchal Windsor à récupérer son équipement et à libérer ses amis. Ensuite, retourner voir le maréchal Maxwell.‡帮助温德索尔元帅拿回他的装备并救出他的朋友。当你成功之后就回去向麦克斯韦尔元帅复命。‡幫助溫德索爾元帥拿回他的裝備並救出他的朋友。當你成功之後就回去向麥克斯韋爾元帥覆命。',
  }
},
[4324] = {
  {
    'Yuka Parafuseta‡Юка Крутипроб‡Yuka Schraubstutz‡유카 스크류스피곳‡Yuka Llavenrosca‡Yuka Llavenrosca‡Yuka Fermevanne‡尤卡·斯库比格特‡尤卡·斯庫比格特',
    nil,
    'Fale com Yuka Parafuseta nas Estepes Ardentes.‡Переговорите с Юкой Крутипроб в Пылающих степях.‡Sprecht mit Yuka Schraubstutz in der brennenden Steppe.‡불타는 평원에 있는 유카 스크류스피곳과 대화해야 합니다.‡Habla con Yuka Llavenrosca en Las Estepas Ardientes.‡Habla con Yuka Llavenrosca en Las Estepas Ardientes.‡Parler à Yuka Fermevanne dans les Steppes ardentes.‡与燃烧平原的尤卡·斯库比格特谈一谈。‡與燃燒平原的尤卡·斯庫比格特談話。',
  }
},
[4341] = {
  {
    'Kharan Feromalho‡Каран Могучий Молот‡Kharan Hammermacht‡카란 마이트해머‡Kharan Martillazo‡Kharan Martillo Poderoso‡Kharan Force-martel‡卡兰·巨锤‡卡蘭·巨錘',
    nil,
    'Viaje para Abismo Rocha Negra e encontre Kharan Feromalho.nnO Rei mencionou que Kharan estava preso lá — talvez seja bom procurar uma prisão.‡Пойдите в Глубины Черной горы и найдите Карана Могучего Молота.nnКороль упомянул, что Каран сидит там в плену – может, стоит поискать темницу.‡Begebt Euch in die Schwarzfelstiefen und findet Kharan Hammermacht.nnDer König erwähnte, dass Kharan dort gefangen sei - vielleicht solltet Ihr nach einem Gefängnis Ausschau halten.‡검은바위 나락으로 가서 카란 마이트해머를 찾아야 합니다.nn국왕은 카란이 그곳에 포로로 잡혀 있을 것이라고 말했습니다. 그곳 감옥을 찾아보는 것이 좋겠습니다.‡Ve a las Profundidades de Roca Negra y encuentra a Kharan Martillazo.nnEl rey dijo que estaba prisionero allí; busca una cárcel.‡Ve a las Profundidades de Roca Negra y encuentra a Kharan Martillo Poderoso.|nEl rey dijo que estaba prisionero allí; busca una cárcel.‡Aller dans les Profondeurs de Rochenoire et trouver Kharan Force-martel.nnLe roi a mentionné que Kharan était retenu prisonnier là-bas ; cherchez une prison.‡去黑石深渊找到卡兰-巨锤。nn国王提到卡兰在那里负责看守囚犯——也许你应该在监狱附近寻找他。‡去黑石深淵找到卡蘭·巨錘。|n國王提到卡蘭在那裡負責看守囚犯─也許你應該在監獄附近尋找他。',
  }
},
[4342] = {
  {
    'O conto de Kharan‡Рассказ Карана‡Kharans Geschichte‡카란의 이야기‡La leyenda de Kharan‡El relato de Kharan‡Légende de Kharan‡卡兰的故事‡卡蘭的故事',
    nil,
    'Ouça Kharan Feromalho contar a história dele.‡Выслушайте рассказ Карана Могучего Молота.‡Lasst Kharan Hammermacht seine Geschichte erzählen.‡카란 마이트해머가 하는 이야기를 들어야 합니다.‡Escucha la historia de Kharan Martillazo.‡Escucha la historia de Kharan Martillo Poderoso.‡Écouter Kharan Force-martel raconter son histoire.‡听卡兰·巨锤说他的故事。‡聽卡蘭·巨錘說他的故事。',
  }
},
[4343] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una flor del viento. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4361] = {
  {
    'Informante das más notícias‡Недобрые вести‡Der Überbringer schlechter Botschaften...‡나쁜 소식 전달‡Portador de malas noticias‡Portador de malas noticias‡Le porteur des mauvaises nouvelles‡糟糕的消息‡糟糕的消息',
    nil,
    'Volte a Altaforja e dê as más notícias ao Rei Magni Barbabronze.‡Вернитесь в Стальгорн и сообщите нехорошие новости королю Магни Бронзобороду.‡Kehrt nach Eisenschmiede zurück und überbringt König Magni Bronzebart die schlechten Nachrichten.‡아이언포지로 돌아가 국왕 마그니 브론즈비어드에게 이 나쁜 소식을 전해야 합니다.‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Regresa a Forjaz y dale las malas noticias al rey Magni Barbabronce.‡Retourner à Forgefer et apporter la mauvaise nouvelle au Roi Magni Barbe-de-bronze.‡回到铁炉堡，把这个坏消息带给国王麦格尼·铜须。‡回到鐵爐堡，把這個壞消息帶給國王麥格尼·銅鬚。',
  }
},
[4362] = {
  {
    'O destino do reino‡Судьба королевства‡Das Schicksal des Königreichs‡왕국의 운명‡El destino del reino‡El destino del reino‡Le destin du Royaume‡王国的命运‡王國的命運',
    nil,
    'Volte ao Abismo Rocha Negra e resgate a Princesa Moira Barbabronze das garras malignas do Imperador Dagran Thaurissan.‡Вернитесь в Глубины Черной горы и освободите принцессу Мойру Бронзобород от злобного императора Даграна Тауриссана.‡Kehrt in die Schwarzfelstiefen zurück und rettet Prinzessin Moira Bronzebart aus den Fängen des bösen Imperators Dagran Thaurissan.‡검은바위 나락으로 돌아가 제왕 다그란 타우릿산의 사악한 손아귀에서 공주 모이라 브론즈비어드를 구출해야 합니다.‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.|n‡Vuelve a las Profundidades de Roca Negra y rescata a la princesa Moira Barbabronce de las garras del emperador Dragan Thaurissan.‡Retourner dans les Profondeurs de Rochenoire et secourir la Princesse Moira Barbe-de-bronze, prisonnière de l\'Empereur Dagran Thaurissan.‡回到黑石深渊，从达格兰·索瑞森大帝的魔掌中救出铁炉堡公主茉艾拉·铜须。‡回到黑石深淵，從達格蘭·索瑞森大帝的魔掌中救出鐵爐堡公主茉艾拉·銅鬚。',
  }
},
[4363] = {
  {
    'A surpresa da Princesa‡Королевский сюрприз‡Die Überraschung der Prinzessin‡브론즈비어드 공주‡La sorpresa de la princesa‡La sorpresa de la princesa‡La surprise de la Princesse‡语出惊人的公主‡語出驚人的公主',
    nil,
    'Volte a Altaforja e fale com o Rei Magni Barbabronze.‡Вернитесь в Стальгорн и переговорите с королем Магни Бронзобородом.‡Kehrt nach Eisenschmiede zurück und sprecht mit König Magni Bronzebart.‡아이언포지로 돌아가서 국왕 마그니 브론즈비어드와 대화해야 합니다.‡Regresa a Forjaz y habla con el rey Magni Barbabronce.‡Regresa a Forjaz y habla con el rey Magni Barbabronce.‡Retourner à Forgefer et parler au roi Magni Barbe-de-bronze.‡回到铁炉堡去，与国王麦格尼·铜须谈一谈。‡回到鐵爐堡去，與國王麥格尼·銅鬚談話。',
  }
},
[4381] = {
  {
    'Restauração de cristal‡Кристалл восстановления‡Kristallflicker‡회복의 수정‡El cristal de restauración‡El cristal de restauración‡Cristal de restauration‡恢复水晶‡恢復水晶',
    nil,
    'A bancada da Torre permite que você combine cristais verdes com cristais amarelos.nnDe acordo com o manual da J.D., você pode usar essa combinação para curar a si mesmo e os seus aliados.‡Табличка пилона позволяет сочетать зеленые и желтые кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для исцеления себя или своих союзников.‡Mit Hilfe der Pylon-Tafel könnt Ihr grüne und gelbe Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination Euch oder Eure Verbündeten heilen.‡이 수정탑 도식판에서 녹색 마력의 수정과 노란 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 자신이나 동료를 치유할 수 있습니다.‡‡‡Le Pilon vous permet de combiner les cristaux de puissance verts avec les jaunes.nnSi on se réfère au manuel de J.D., cette combinaison sert à vous soigner, vous et vos alliés.‡你可以把绿色能量水晶和黄色能量水晶组合在一起。nn根据科琳给你的说明书上的记载，这种组合所制造的水晶可以治疗你和你的同伴。‡',
  }
},
[4382] = {
  {
    'Força de cristal‡Кристалл силы духа‡Kristallkraft‡정신력의 수정‡La fuerza de cristal‡La fuerza de cristal‡Cristal de concentration‡精神水晶‡精神水晶',
    nil,
    '‡Табличка пилона позволяет сочетать зеленые и синие кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для укрепления своего духа.‡Mit Hilfe der Pylon-Tafel könnt Ihr grüne und blaue Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination Euren Geist steigern.‡이 수정탑 도식판에서 녹색 마력의 수정과 푸른 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 자신의 정신력을 증가시킬 수 있습니다.‡La tabla de la torre te permite combinar cristales de poder verdes y azules.nnDe acuerdo con el manual de J.D. puedes utilizar esta combinación para aumentar tu espíritu.‡‡Le Pilon vous permet de combiner les cristaux de puissance verts avec les bleus.nnSi on se réfère au manuel de J.D., cette combinaison sert à augmenter l\'Esprit.‡‡',
  }
},
[4383] = {
  {
    'Proteção de cristal‡Кристалл-хранитель‡Kristallbarriere‡수호의 수정‡Resguardo de cristal‡Resguardo de cristal‡Cristal de protection‡防御水晶‡防禦水晶',
    nil,
    '‡Табличка пилона позволяет сочетать зеленые и красные кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для усиления защиты от физических повреждений.‡Mit Hilfe der Pylon-Tafel könnt Ihr grüne und rote Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination Euren Schutz vor körperlichem Schaden stärken.‡이 수정탑 도식판에서 녹색 마력의 수정과 붉은 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 물리적인 피해에 대한 보호를 강화할 수 있습니다.‡La tabla de la torre te permite combinar cristales de poder verdes y rojos.nnDe acuerdo con el manual de J.D. puedes utilizar esta combinación para reforzar tu protección contra daño físico.‡‡Le Pilon vous permet de combiner les cristaux de puissance verts avec les rouges.nnSi on se réfère au manuel de J.D., cette combinaison sert à augmenter la protection contre les dégâts physiques.‡‡',
  }
},
[4384] = {
  {
    'Subjugação de cristal‡Хрустальный удар‡Kristallschwächer‡굴복의 수정‡Reducción de cristal‡Reducción de cristal‡Cristal de réduction‡破甲水晶‡破甲水晶',
    nil,
    '‡Табличка пилона позволяет сочетать красные и синие кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для ослабления обороны противника.‡Mit Hilfe der Pylon-Tafel könnt Ihr rote und blaue Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination die Verteidigung eines Gegners schwächen.‡이 수정탑 도식판에서 붉은 마력의 수정과 푸른 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 적의 방어력을 약화시킬 수 있습니다.‡‡‡Le Pilon vous permet de combiner les cristaux de puissance rouges avec les bleus.nnSi on se réfère au manuel de J.D., cette combinaison sert à réduire la Défense de l\'adversaire.‡‡',
  }
},
[4385] = {
  {
    'Carga de cristal‡Хрустальный заряд‡Kristallsprengladung‡발화의 수정‡Carga de cristal‡Carga de cristal‡Cristal d\'explosion‡爆炸水晶‡爆炸水晶',
    nil,
    '‡Табличка пилона позволяет сочетать красные и желтые кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для производства мощного взрыва, наносящего серьезный ущерб силам противника.‡Mit Hilfe der Pylon-Tafel könnt Ihr rote und gelbe Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination eine starke Explosion auslösen, die Euren Feinden Schaden zufügt.‡이 수정탑 도식판에서 붉은 마력의 수정과 노란 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 거대한 폭발을 일으켜서 적에게 피해를 입힐 수 있습니다.‡La tabla de la torre te permite combinar cristales de poder rojos y amarillos.nnDe acuerdo con el manual de J.D. puedes utilizar esta combinación para crear una gran explosión que puede infligir daño a tus enemigos.‡‡Le Pilon vous permet de combiner les cristaux de puissance rouges avec les jaunes.nnSi on se réfère au manuel de J.D., cette combinaison peut être utilisée pour créer une grande explosion qui inflige des dégâts à vos ennemis.‡‡',
  }
},
[4386] = {
  {
    'Aguilhão de cristal‡Хрустальная спираль‡Kristallspitze‡돌기의 수정‡Aguja de cristal‡Aguja de cristal‡Cristal de rétribution‡尖刺水晶‡尖刺水晶',
    nil,
    'A bancada da Torre permite que você combine cristais azuis com cristais amarelos.nnDe acordo com o manual da J.D., essa combinação pode ser usada para criar um escudo que causa dano aos seus inimigos.‡Табличка пилона позволяет сочетать синие и желтые кристаллы Силы. nnСогласно книге Джей Ди, это сочетание можно использовать для создания щита, наносящего повреждения противнику.‡Mit Hilfe der Pylon-Tafel könnt Ihr blaue und gelbe Machtkristalle miteinander verbinden.nnLaut J.D.s Handbuch könnt Ihr mit dieser Kombination einen Schild erschaffen, der Euren Feinden Schaden zufügt.‡이 수정탑 도식판에서 푸른 마력의 수정과 노란 마력의 수정을 조합할 수 있습니다.nnJ.D.의 설명서에 따르면 이 둘을 조합하여 적에게 피해를 입히는 보호막을 만들어낼 수 있습니다.‡La tabla de la torre te permite combinar cristales de poder azules y amarillos.nnDe acuerdo con el manual de J.D. puedes utilizar esta combinación para crear un escudo que causará daño a tus enemigos.‡‡Le Pilon vous permet de combiner les cristaux de puissance bleus avec les jaunes.nnSi on se réfère au manuel de J.D., cette combinaison sert à créer un bouclier qui inflige des dégâts aux ennemis.‡‡',
  }
},
[4401] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨 나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4402] = {
  {
    'A surpresa de sabra do Galgar‡Кактусовый десерт Галгара‡Galgars Kaktusapfel Surprise‡갈가르의 선인장 사과 별미‡Sorpresa de manzanas de cactus de Galgar‡Sorpresa de manzanas de cactus de Galgar‡Surprise aux pommes de cactus de Galgar‡戈加尔的清凉果‡戈加爾的清涼果',
    nil,
    'Leve 10 Sabras para Galgar. Você lembra que ele disse que se encontram sabras perto dos cactos.‡Принесите Галгару 10 плодов кактуса.‡Bringt Galgar 10 Kaktusäpfel. Ihr erinnert Euch, dass er gesagt hat, man fände sie in der Nähe von Kakteen.‡갈가르에게 선인장 사과 10개를 가져가야 합니다. 선인장 근처에서 찾을 수 있다고 한 말이 기억납니다.‡Lleva a Galgar 10 manzanas de cactus. Recuerdas haberle oído decir que se encuentran junto a los cactus.‡Lleva a Galgar 6 manzanas de cactus. Recuerdas haberle oído decir que se encuentran junto a los cactus.‡Apportez à Galgar 10 Pommes de cactus. Il vous a précisé qu\'elles se trouvaient souvent à côté des cactus.‡收集10个仙人掌果，把它们交给戈加尔。你记得他说可以在仙人掌上收集到这种果子。‡收集10個仙人掌果，把它們交給戈加爾。你記得他說可以在仙人掌上收集到這種果子。',
  }
},
[4403] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려있는 열매는 썩어 있고 독성을 품고 있는 듯 합니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4421] = {
  {
    'A corrupção dos Flamejade‡Порча нефритового огня‡Die Verderbnis der Jadefeuer‡비취불꽃의 오염‡La corrupción de los Fuego de Jade‡La corrupción de los Fuego de Jade‡La corruption des Jadefeu‡碧火萨特‡碧火薩特',
    nil,
    'Mate 11 Devotos Vis Flamejade, 9 Assombrantes Flamejade, 9 Desgarrados Flamejade e Xavathras. Fale novamente com Eridan Brisazul na Selva Maleva quando a tarefa estiver completa.‡Убейте 11 скверноподданных, 9 тенеловов, 9 разбойников из племени Нефритового Пламени и Ксаватраса. Возвращайтесь к Эридане Грусти Ветра в Оскверненный лес по выполнении задания.‡Tötet Xavathras sowie 11 Jadefeuerteufelsanbeter, 9 Jadefeuerschattenpirscher und 9 Jadefeuerschurken. Kehrt zu Eridan Blauwind im Teufelswald zurück, sobald die Aufgabe erledigt ist.‡비취불꽃의 악마추종자 11명, 그림자추적자 9명, 도적 9명과 사바스라스를 처치해야 합니다. 임무를 완수하면 에리단 블루윈드에게 돌아가야 합니다.‡Mata a 11 jurapenas Fuego de Jade, 9 acechasombras Fuego de Jade, 9 pícaros Fuego de Jade y a Xavathras. Vuelve con Eridan Vientoazul a Frondavil cuando hayas completado la misión.‡Mata a 11 jurapenas Fuego de Jade, 9 acechasombras Fuego de Jade, 9 pícaros Fuego de Jade y a Xavathras. Vuelve con Eridan Vientoazul a Frondavil cuando hayas completado la misión.‡Tuer 11 Gangreliges Jadefeu, 9 Traqueurs des ombres Jadefeu, 9 Voleurs Jadefeu et Xavathras. Retourner voir Eridan Ventebleu, à Gangrebois, quand la mission est terminée.‡杀掉11个碧火魔仆、9个碧火巡影者、9个碧火潜行者和萨瓦瑟拉斯。任务完成之后回到费伍德森林的艾瑞丹·蓝风处复命。‡殺掉11個碧火魔僕、9個碧火巡影者、9個碧火盜賊和薩瓦瑟拉斯。任務完成之後回到費伍德森林的艾瑞丹·藍風處覆命。',
  }
},
[4441] = {
  {
    'Ancientes aviltados‡Дерева в узах скверны‡Gebundene Urtume‡저주받은 고대 수호자‡Los Ancestros corrompidos‡Los Ancestros corrompidos‡Anciens corrompus‡被禁锢的古树‡被禁錮的古樹',
    nil,
    'Viaje para Darnassus e use a Ampola de Eridan para coletar uma Ampola de Água Benta no Templo da Lua. Fale novamente com Eridan, levando a ampola cheia.‡Отправляйтесь в Дарнасс и наберите в фиал Эриданы благословенной воды из храма Луны. Возвращайтесь к Эридане с полным фиалом.‡Begebt Euch nach Darnassus und verwendet Eridans Phiole, um Euch im Tempel des Mondes eine Phiole mit gesegnetem Wasser zu holen. Kehrt mit der gefüllten Phiole zu Eridan zurück.‡다르나서스에 있는 달의 신전으로 가서 에리단의 유리병을 사용하여 축복받은 물을 담아 와야 합니다. 꽉 찬 물병을 에리단에게 가져와야 합니다.‡Viaja a Darnassus y utiliza el vial de Eridan para recoger agua bendita del Templo de la Luna. Vuelve a Eridan con el vial lleno.‡Viaja a Darnassus y utiliza el vial de Eridan para recoger agua bendita del Templo de la Luna. Vuelve a Eridan con el vial lleno.‡Aller à Darnassus et utiliser la Fiole d\'Eridan dans le Temple de la Lune, pour obtenir une Fiole d\'eau bénite. Retourner voir Eridan avec la Fiole pleine.‡到达纳苏斯去，用艾瑞丹的瓶子收集月神殿中的祝福之水，然后回到艾瑞丹那儿。‡到達納蘇斯去，用艾瑞丹的瓶子收集月神殿中的祝福之水，然後回到艾瑞丹那兒。',
  }
},
[4442] = {
  {
    'Purificação!‡Очищение явлено!‡Geläutert!‡정화‡¡Purificada!‡¡Purificada!‡Purifié !‡净化！‡淨化!',
    nil,
    'Fale novamente com Eridan em alguns instantes.‡Через мгновение заговорите с Эриданой.‡Sprecht Eridan gleich noch einmal an.‡잠시 후 에리단과 다시 얘기해야 합니다.‡Vuelve a hablar con Eridan dentro de un momento.‡Vuelve a hablar con Eridan dentro de un momento.‡Attendre un moment avant de reparler à Eridan.‡过一会儿再与艾瑞丹对话。‡過一會兒再與艾瑞丹對話。',
  }
},
[4443] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡채찍뿌리인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 땅 위로 드러난 뿌리는 거칠고 단단한 가죽처럼 보입니다. 식물에는 끈적끈적한 실 같은 것도 매달려 있습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una blancoria. De la planta cuelga una sustancia viscosa y las raíces visibles parecen endurecidas, como si fueran de cuero. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡你找到了一株病怏怏的、被腐化了的鞭根草。这株植物上面挂着的果实看上去已经腐烂，而且含有剧毒。你得想办法让它恢复到正常状态。‡',
  }
},
[4444] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡채찍뿌리인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 땅 위로 드러난 뿌리는 거칠고 단단한 가죽처럼 보입니다. 식물에는 끈적끈적한 실 같은 것도 매달려 있습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4445] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡채찍뿌리인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 땅 위로 드러난 뿌리는 거칠고 단단한 가죽처럼 보입니다. 식물에는 끈적끈적한 실 같은 것도 매달려 있습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una blancoria. De la planta cuelga una sustancia viscosa y las raíces visibles parecen endurecidas, como si fueran de cuero. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4446] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡채찍뿌리인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 땅 위로 드러난 뿌리는 거칠고 단단한 가죽처럼 보입니다. 식물에는 끈적끈적한 실 같은 것도 매달려 있습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una blancoria. De la planta cuelga una sustancia viscosa y las raíces visibles parecen endurecidas, como si fueran de cuero. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4447] = {
  {
    'Dragão noturno corrompido‡Оскверненный ночной дракон‡Verderbter Nachtdrache‡오염된 어둠용풀‡Dragón nocturno corrupto‡Dragón nocturno corrupto‡Dragon nocturne corrompu‡被腐化的夜龙草‡被腐化的夜龍草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на Ночного дракона. Плоды его тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Nachtdrachenpflanze aussieht. Die Früchte, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡어둠용풀인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려 있는 열매는 썩어서 독성이 있는 것 같습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una planta dragón nocturno. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert la version malade et souffreteuse d\'une plante, le dragon nocturne. Les fruits qui pendent de la plante sont pourris et empoisonnés. La plante a désespérément besoin de soins pour retrouver son état normal.‡‡',
  }
},
[4448] = {
  {
    'Dragão noturno corrompido‡Оскверненный ночной дракон‡Verderbter Nachtdrache‡오염된 어둠용풀‡Dragón nocturno corrupto‡Dragón nocturno corrupto‡Dragon nocturne corrompu‡被腐化的夜龙草‡被腐化的夜龍草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на Ночного дракона. Плоды его тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Nachtdrachenpflanze aussieht. Die Früchte, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡어둠용풀인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려 있는 열매는 썩어서 독성이 있는 것 같습니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡‡‡Vous avez découvert la version malade et souffreteuse d\'une plante, le dragon nocturne. Les fruits qui pendent de la plante sont pourris et empoisonnés. La plante a désespérément besoin de soins pour retrouver son état normal.‡‡',
  }
},
[4449] = {
  {
    'Calça arriada!‡Попался!‡Eingesperrt!‡화장실에 갇힌 사람‡Atrapado‡Atrapado‡Piégé !‡被锁起来的矮人‡被鎖起來的矮人',
    nil,
    'Mate 8 Geólogos Ferro Negro e leve 15 pedaços de Seda para a pessoa que está trancada na casinha na Garganta Abrasadora.‡Убейте 8 геологов из клана Черного Железа и принесите 15 отрезов шелка тому, кто заперт в отхожем месте в Тлеющем ущелье.‡Tötet 8 Geologen der Dunkeleisenzwerge und bringt der Person, die im Plumpsklo in der sengenden Schlucht eingesperrt ist, 15 Stücke Seidenstoff.‡검은무쇠단 지질학자 8명을 처치하고 이글거리는 협곡의 화장실에 갇힌 사람에게 비단 옷감 15개를 가져가야 합니다.‡Mata a 8 geólogos Hierro Negro y lleva 15 paños de seda a la persona encerrada en los baños de La Garganta de Fuego.‡Mata a 8 geólogos Hierro Negro y lleva 15 paños de seda a la persona encerrada en las letrinas de La Garganta de Fuego.‡Tuer 8 Géologues Sombrefer et rapporter 15 morceaux d\'Etoffe de soie à la personne enfermée dans les toilettes de la gorge des Vents brûlants.‡杀掉8个黑铁地质学家，并将15块丝绸交给灼热峡谷里那个被锁在厕所中的矮人。‡殺掉8個黑鐵地質學家，並將15塊絲綢交給灼熱峽谷裡那個被鎖在廁所中的矮人。',
  }
},
[4450] = {
  {
    'Livro-Caixa de Tanaris‡Учетная книга из Танариса‡Geschäftsbuch aus Tanaris‡타나리스의 장부‡El libro de contabilidad de Tanaris‡El libro de contabilidad de Tanaris‡Grand livre de Tanaris‡塔纳利斯的账本‡塔納利斯的帳本',
    nil,
    'Pegue a cópia do Livro-Caixa de Rugov A. Massoaço e encontre os itens listados antes de ir falar com ele em Tanaris.‡Возьмите учетную книгу Кринкеля Сталлинна и найдите все перечисленные в ней вещи. Затем отнесите их и книгу Кринкелю Сталлинну в Танарис.‡Nehmt die Abschrift von Goldstahls Geschäftsbuch und beschafft Euch dann die darin aufgeführten Gegenstände, ehe Ihr Krinkle Goldstahl in Tanaris aufsucht.‡굿스틸 장부를 가지고 거기에 적힌 물건들을 다 모은 다음 타나리스에 있는 크린클 굿스틸을 찾아가야 합니다.‡Coge el libro de contabilidad de Buenacero y busca los objetos de la lista antes de ir a verlo a Tanaris.‡Coge el libro de contabilidad de Buenacero y busca los objetos de la lista antes de ir a verlo a Tanaris.‡Prendre la copie du Livre de Bonnacier, puis collecter les objets qui y sont listés avant d\'aller voir Froisse Bonnacier, à Tanaris.‡把古德斯迪尔的账本和上面所列的物品交给塔纳利斯的克林科·古德斯迪尔。‡把古德斯迪爾的帳本和上面所列的物品交給塔納利斯的克林科·古德斯迪爾。',
  }
},
[4451] = {
  {
    'A chave para a liberdade‡Ключ к свободе‡Der Schlüssel zur Freiheit‡자유의 열쇠‡La llave de la libertad‡La llave de la libertad‡La Clé de la liberté‡自由的钥匙‡自由的鑰匙',
    nil,
    'Encontre a Garganta Abrasadora e descubra para que serve a Chave da Casinha de Pedrassuja que você encontrou.‡Найдите дверь в Тлеющем ущелье, к которой подходит ключ от дома Грязнули.‡Sucht in der sengenden Schlucht, bis Ihr etwas findet, wofür man den Schlüssel für Rußschlacks Schuppen verwenden kann, den Ihr gefunden habt.‡이글거리는 협곡을 탐색해서 검댕가루 화장실 열쇠의 용도를 알아내야 합니다.‡Busca en La Garganta de Fuego para ver cómo se usa la llave del excusado de Grimesilt.‡Busca en La Garganta de Fuego para ver cómo se usa la llave de la letrina de Limugre.‡Aller dans la gorge des Vents brûlants et trouver une utilisation à la Clé des toilettes de Crasseboue que vous avez trouvée.‡搜寻灼热峡谷并找到一个可以插入这把格里塞特厕所钥匙的锁眼。‡搜尋灼熱峽谷並找到一個可以使用這把格里塞特庫房鑰匙的地方。',
  }
},
[4461] = {
  {
    'Raiz-açoite corrompida‡Оскверненный кнутокорень‡Verderbte Peitscherwurzel‡오염된 채찍뿌리‡Blancoria corrupta‡Blancoria corrupta‡La navetille corrompue‡被腐化的鞭根草‡被腐化的鞭根草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на кнутокорень. Находящиеся на виду корни кажутся жесткими и кожистыми, и все растение покрыто какой-то липкой пленкой. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Peitscherwurzelpflanze aussieht. Die sichtbaren Wurzeln der Pflanze sehen zäh und ledrig aus und ein schleimiger Film tropft von der Pflanze. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une navetille Les ramures visibles en sont coriaces et tannées, et un voile visqueux en pend. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4462] = {
  {
    'Dragão noturno corrompido‡Оскверненный ночной дракон‡Verderbter Nachtdrache‡오염된 어둠용풀‡Dragón nocturno corrupto‡Dragón nocturno corrupto‡Dragon nocturne corrompu‡被腐化的夜龙草‡被腐化的夜龍草',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на Ночного дракона. Плоды его тоже кажутся какими-то грилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Nachtdrachenpflanze aussieht. Die Früchte, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una planta dragón nocturno. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert la version malade et souffreteuse d\'une plante, le dragon nocturne. Les fruits qui pendent de la plante sont pourris et empoisonnés. La plante a désespérément besoin de soins pour retrouver son état normal.‡‡',
  }
},
[4463] = {
  {
    'Incunábulo da Reflexão‡Манускрипт Размышления‡Buchband des Nachsinnens‡숙고의 고서‡Tratado sobre Reflexión‡Tratado sobre Reflexión‡Libram de rumination‡沉思圣典‡沉思聖契',
    nil,
    '‡Принеси все составляющие, смертный.nnКроме того, я потребую с тебя тридцать золотых за создание этой безделушки.‡Übergebt mir die Komponenten, sterbliches Geschöpf.nnDes Weiteren benötige ich Bezahlung in Gestalt von dreißig Goldstücken für diese Schöpfung.‡재료를 보여 주시오, 나약한 존재여.nn그리고 이 창조물의 대가로 골드 30개도 내놓아야 할 것이오.‡‡‡Présentez les composants, mortel.nnJ\'exige également trente pièces d\'or en paiement de cette création.‡‡',
  }
},
[4464] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨 나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4465] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    'Você encontrou uma versão doentia e corrompida do que parece ser uma flor da canção. Um pungente odor insalubre emana da planta. Ela precisa desesperadamente de cuidados para voltar ao normal.‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на песнецвет. Резкий, нездоровый запах исходит от него. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Liedblumenpflanze aussieht. Ein stechender, ungesunder Geruch geht von der Pflanze aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡노래꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에서는 지독한 냄새가 풍겨 나옵니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una melodía. De la planta emana un olor acre y malsano. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-chant. Une odeur âcre et malsaine émane de la plante. Celle-ci a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4466] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려 있는 열매는 썩어 있고 독성을 품은 듯 합니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una flor del viento. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4467] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    '‡Вы нашли чахлое, пораженное какой-то порчей растение, похожее на ветроцвет. Ягоды на нем тоже кажутся какими-то гнилыми и ядовитыми. Если вы хотите вернуть его к нормальному состоянию, то срочно необходимо им заняться.‡Ihr habt eine kränkliche, verderbte Ausgabe von etwas gefunden, das wie eine Windblütenpflanze aussieht. Die Beeren, die von der Pflanze herabhängen, sehen verfault und giftig aus. Es muss sich dringend jemand um die Pflanze kümmern, wenn sie wieder zu ihrem Normalzustand zurückkehren soll.‡바람꽃인 듯한 식물을 찾았는데 병들고 오염되어 있습니다. 식물에 달려 있는 열매는 썩어 있고 독성을 품은 듯 합니다. 이 식물을 원래대로 되돌리려면 당장에라도 어떤 조치를 취해야 합니다.‡Has encontrado una versión enfermiza y corrupta de lo que parece ser una flor del viento. Los frutos que cuelgan de la planta están podridos y envenenados. Necesita desesperadamente ser atendida para recuperar su estado normal.‡‡Vous avez découvert une version maladive et souffreteuse de ce qui s\'avère être une fleur-de-vent. Les baies qui en pendent sont pourries et empoisonnées. La plante a désespérément besoin de soins pour avoir une chance de recouvrer son état normal.‡‡',
  }
},
[4481] = {
  {
    'Incunábulo da Constituição‡Манускрипт Здоровья‡Buchband der Konstitution‡골격의 고서‡Tratado sobre constitución‡Tratado sobre Constitución‡Libram de constitution‡体质圣典‡體質聖契',
    nil,
    '‡За все в этом мире приходится платить. Цена искомого предмета – тридцать золотых.nnЕстественно, большую часть собранных тобой компонентов я оставлю себе. Но не беспокойся, свою игрушку ты получишь.‡Für jedes Ding auf dieser Welt gilt es, einen Preis zu bezahlen. Und der Preis für den speziellen Gegenstand, den Ihr wünscht, beläuft sich auf dreißig Goldstücke.nnSelbstverständlich werde ich den Großteil der Komponenten, die Ihr eingesammelt habt, für mich selbst zurückbehalten. Doch sorgt Euch nicht, Ihr sollt Euren Plunder erhalten.‡이 세계의 모든 것에는 그에 대한 대가가 있게 마련이오. 그대가 찾는 바로 그 물건의 값은 30골드요.nn물론 그대가 모은 재료의 대부분을 내가 갖게 될 것이오. 하지만 장신구는 갖게 될 테니 걱정 마시오.‡‡‡Chaque chose a son prix en ce monde. Le prix de l\'article précis que vous cherchez est de trente pièces d\'or.nnNaturellement, je garderai la majorité des composants que vous avez ramassés. Mais pas d\'inquiétude, vous aurez votre bijou.‡‡',
  }
},
[4482] = {
  {
    'Incunábulo da Tenacidade‡Манускрипт Упорства‡Buchband der Hartnäckigkeit‡불굴의 고서‡Tratado sobre Tenacidad‡Tratado sobre Tenacidad‡Libram de ténacité‡坚韧圣典‡堅毅聖契',
    nil,
    '‡‡Dreißig Goldstücke, <Volk>. Dreißig Goldstücke und die benötigten Komponenten.‡‡‡‡‡‡',
  }
},
[4483] = {
  {
    'Incunábulo da Resiliência‡Манускрипт Устойчивости‡Buchband der Abhärtung‡탄력의 고서‡Tratado sobre Recuperación‡Tratado sobre Resistencia‡Libram de résilience‡恢复圣典‡韌性聖契',
    nil,
    '‡Коль устойчивость нужна, тридцать золотых – цена.‡Wenn es Widerstandsfähigkeit ist, die Ihr wünscht, so benötige ich dreißig Goldstücke.‡원하는 게 탄력의 고서라면 30골드를 내놓아야 하오.‡‡‡Si c\'est de la résistance que vous désirez, c\'est trente pièces d\'or que je demande.‡‡',
  }
},
[4484] = {
  {
    'Incunábulo da Voracidade‡Манускрипт Ненасытности‡Buchband der Gier‡탐욕의 고서‡Tratado sobre Voracidad‡Tratado sobre Voracidad‡Libram de voracité‡贪婪圣典‡貪婪聖契',
    nil,
    '‡Не трать попусту мое время, |3-6(человек). Давай мне все, что нужно. Тридцать золотых и компоненты.‡Vergeudet meine Zeit nicht, <Volk>. Gebt mir das, was ich benötige. Dreißig Goldstücke und die Komponenten.‡내 시간을 낭비하지 말고 어서 30골드와 필요한 재료들을 가져오시오.‡No me hagas perder el tiempo, <raza>. Dame lo que necesito. 30 piezas de oro y los componentes.‡‡Ne me faites pas perdre mon temps, <nom>. Donnez-moi ce que je demande. Trente pièces d\'or et les composants.‡‡',
  }
},
[4485] = {
  {
    'O Tomo de Nobreza‡Фолиант Благородства‡Der Foliant des Adels‡고결함의 고서‡Libro de la nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Stormwind.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[4486] = {
  {
    'O Tomo de Nobreza‡Фолиант Благородства‡Der Foliant des Adels‡고결함의 고서‡Libro de la nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡',
  }
},
[4487] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca a un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4488] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca a un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4489] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca a un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화하십시오.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parler à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4490] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan, na Vila Catraca, para aprender a habilidade de evocar um Corcel Vil.‡Поговорите в Кабестане со Страхадом Фарсаном, чтобы получить способность призывать коня Скверны.‡Sprecht in Ratschet mit Strahad Farsan, um zu lernen, wie man ein Teufelsross beschwört.‡톱니항에 있는 스트라드 파선과 대화해 지옥마 소환 능력을 배워야 합니다.‡Habla con Strahad Farsan en Trinquete para aprender a invocar a un corcel vil.‡Habla con Strahad Farsan en Trinquete para aprender a invocar a un corcel vil.‡Parler à Strahad Farsan, à Cabestan pour apprendre à invoquer un Palefroi corrompu.‡与棘齿城的斯坦哈德·法尔杉谈一谈，学习召唤地狱战马的能力。‡與棘齒城的斯坦哈德·法爾杉談話，學習召喚惡魔戰馬的能力。',
  }
},
[4491] = {
  {
    'O calor tá de matar‡Дружеская помощь‡Etwas Hilfe von guten Freunden‡내 친구의 작은 도움‡Un poco de ayuda de mis amigos‡Un poco de ayuda de mis amigos‡Un peu d\'aide de mes amis‡朋友的帮助‡朋友的幫助',
    nil,
    'Leve Ringo até Espraga Froque, no Refúgio do Marshal.nnSe Ringo desmaiar, use o Cantil da Espraga para reanimá-lo.‡Отведите Ринго к Муче Кусора в Укрытие Маршалла. nnЕсли Ринго потеряет сознание, плесните на него воды из фляги Спрэггл, чтобы привести его в чувство.‡Führt Ringo zu Spraggel Frock in Marschalls Zuflucht.nnFalls Ringo ohnmächtig werden sollte, verwendet Spraggles Feldflasche, um ihn zu beleben.‡마샬의 야영지에 있는 스프래글 프록에게 링고 스타를 데려다 주어야 합니다.nn링고 스타가 기절하면 스프래글의 수통을 사용해 깨워야 합니다.‡Lleva a Ringo con Spraggle Habitus en el Refugio de Marshal.nnSi Ringo se desmaya utiliza la cantimplora de Spraggle para revivirlo.‡Lleva a Ringo con Spraggle Frock en el Refugio de Marshal.|nSi Ringo se desmaya utiliza la cantimplora de Spraggle para revivirlo.‡Conduire Ringo auprès de Spraggle Frock, au refuge des Marshal.nnSi Ringo s\'évanouit, utiliser la Gourde de Spraggle pour le réanimer.‡把林格带回马绍尔营地的斯普拉格·弗劳克身边。nn如果林格晕倒了，就用斯普拉格的水壶让他恢复。‡把林格帶回馬紹爾營地的斯普拉格·弗勞克身邊。|n如果林格暈倒了，就用斯普拉格的水壺讓他恢復。',
  }
},
[4492] = {
  {
    'Perdido!‡Потерялся!‡Verloren!‡링고 찾기‡¡Perdido!‡¡Perdido!‡Perdu !‡走丢了！‡走丟了!',
    nil,
    'Encontre Ringo no Pico Penacho de Fogo.‡Найдите Ринго на Вулкане Огненного Венца.‡Sucht Ringo am Feuersäulengrat.‡불기둥 마루에서 링고 스타를 찾아야 합니다.‡Encuentra a Ringo en la Cresta del Penacho en Llamas.‡Encuentra a Ringo en la Cresta del Penacho en Llamas.‡Trouver Ringo sur la crête de la Fournaise.‡在火羽山找到林格。‡在火羽山找到林格。',
  }
},
[4493] = {
  {
    'A marcha dos silitídeos‡Нашествие силитидов‡Der Marsch der Silithiden‡실리시드의 행진‡La marcha de los silítidos‡La marcha de los silítidos‡La marche des silithides‡异种蝎的远征‡異種蠍的遠征',
    nil,
    'Fale com o Alquimista Almofarrista em Geringontzan.‡Поговорите с алхимиком Пестычинсом в Прибамбасске.‡Sprecht in Gadgetzan mit Alchimist Stößelbruch.‡가젯잔에 있는 연금술사 페슬저그와 대화하십시오.‡Ve a Gadgetzan y habla con el alquimista Morterozugg.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Parler à l\'Alchimiste Pilonzugg à Gadgetzan.‡与加基森的炼金师匹斯特苏格谈一谈。‡與加基森的鍊金師匹斯特蘇格談話。',
  }
},
[4494] = {
  {
    'A marcha dos silitídeos‡Нашествие силитидов‡Der Marsch der Silithiden‡실리시드의 행진‡La marcha de los silítidos‡La marcha de los silítidos‡La marche des silithides‡异种蝎的远征‡異種蠍的遠征',
    nil,
    'Fale com o Alquimista Almofarrista em Geringontzan.‡Поговорите с алхимиком Пестычинсом в Прибамбасске.‡Sprecht in Gadgetzan mit Alchimist Stößelbruch.‡가젯잔에 있는 연금술사 페슬저그와 대화하십시오.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Parler à l\'Alchimiste Pilonzugg à Gadgetzan.‡与加基森的炼金师匹斯特苏格谈一谈。‡與加基森的鍊金師匹斯特蘇格談話。',
  }
},
[4495] = {
  {
    'Um bom amigo‡Добрый друг‡Ein guter Freund‡죽마고우‡Un buen amigo‡Un buen amigo‡Un bon ami‡好朋友‡好朋友',
    nil,
    'Encontre Iverron perto da caverna ao norte.‡Найдите Иверрона возле пещеры на севере.‡Sucht Iverron an der Höhle im Norden.‡북쪽의 동굴 근처에서 이베론을 찾아야 합니다.‡Encuentra a Iverron cerca de la cueva que hay al norte.‡Encuentra a Iverron cerca de la cueva que hay al norte.‡Trouver Iverron près de la grotte au nord.‡在北边的洞穴附近找到埃沃隆。‡在北邊的洞穴附近找到埃沃隆。',
  }
},
[4496] = {
  {
    'Sururu na selva‡Путаница в джунглях‡Dschungelei‡밀림 속 생물‡Que jungla tan chunga‡Que jungla tan chunga‡Fiasco dans la jungle‡擒虫先擒王‡擒蟲先擒王',
    nil,
    'Leve uma Glândula Odorífera Gorishi e 5 Amostras de Solo de Un\'Goro ao Alquimista Almofarrista em Geringontzan.‡Принесите ароматическую железу Гориши и 5 образцов почвы из Кратера Ун\'Горо алхимику Пестычинсу в Прибамбасск.‡Bringt eine Gorishiduftdrüse und 5 Erdproben von Un\'Goro zu Alchimist Stößelbruch in Gadgetzan.‡가젯잔에 있는 연금술사 페슬저그에게 고리쉬 향낭 1개와 운고로 토양 견본 5개를 가져가야 합니다.‡Llévale una glándula secretora de olor Gorishi y 5 muestras de la tierra de Un\'Goro al alquimista Morterozugg de Gadgetzan.‡Llévale una glándula secretora de olor Gorishi y 5 muestras de la tierra de Un\'Goro al alquimista Morterozugg de Gadgetzan.‡Apporter une Glande olfactive Gorishi et 5 Échantillons d\'humus d\'Un\'Goro à l\'Alchimiste Pilonzugg, à Gadgetzan.‡把一份格里什信息素和5份安戈洛的泥土样本交给加基森的炼金师匹斯特苏格。‡帶一個格里什香味腺體和5個安戈洛的泥土樣本給加基森的鍊金師匹斯特蘇格。',
  }
},
[4501] = {
  {
    'Cuidado com os pterrordaxes‡Осторожно, злой жутедактиль‡Vorsicht, Pterrordax!‡테러닥스 주의‡Cuidado con los pterrordáctilos‡Cuidado con los pterrordáctilos‡Attention aux pterreurdactyles‡当心翼手龙‡當心翼手龍',
    nil,
    'Mate 10 Pterrordaxes e 15 Pterrordaxes Frenéticos, então fale com Espraga Froque no Refúgio do Marshal.‡Убейте 10 жутедактилей и 15 бесноватых жутедактилей, затем поговорите со Мучей Кусора в Укрытии Маршалла.‡Tötet 10 Pterrordax und 15 rasende Pterrordax und sprecht dann mit Spraggel Frock in Marschalls Zuflucht.‡테러닥스 10마리와 광포한 테러닥스 15마리를 처치한 후 마샬의 야영지에 있는 스프래글 프록과 대화해야 합니다.‡Mata a 10 pterrordáctilos y a 15 pterrordáctilos demenciados. Cuando lo hayas hecho habla con Spraggle Habitus en el Refugio de Marshal.‡Mata a 10 pterrordáctilos demenciados. Cuando lo hayas hecho habla con Spraggle Frock en el Refugio de Marshal.‡Tuer 10 Pterreurdactyles et 15 Pterreurdactyles frénétiques, puis parler à Spraggle Frock, au refuge des Marshal.‡杀掉10只翼手龙和15只狂怒的翼手龙，然后向马绍尔营地的斯普拉格·弗劳克报告。‡殺掉10隻翼手龍和15隻狂怒的翼手龍，然後向馬紹爾營地的斯普拉格·弗勞克報告。',
  }
},
[4502] = {
  {
    'Atividade vulcânica‡Вулканическая активность‡Vulkanische Aktivität‡화산 활동‡Actividad volcánica‡Actividad volcánica‡Activité volcanique‡火山的活动‡火山的活動',
    nil,
    'Colete 9 amostras das Cinzas de Un\'Goro dos elementais de fogo ao redor do vulcão da Cratera Un\'Goro, e leve-as para Fanny Quito, em Vila Catraca.‡Добудьте 9 образцов пепла Ун\'Горо из элементалей огня, что водятся вокруг вулкана в Кратере Ун\'Горо, и доставьте их Лив Быстрочин в Кабестан.‡Sammelt 9 Proben der Asche von Un\'Goro von den Feuerelementaren am Vulkan im Krater von Un\'Goro ein und bringt die Proben zu Liv Ritzelflick in Ratschet.‡운고로 분화구의 화산 주위에 있는 불의 정령에게서 운고로 재 견본 9개를 모아 톱니항에 있는 리브 리즐픽스에게 가져가야 합니다.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Collecter 9 échantillons de Cendres d\'Un\'Goro sur les Élémentaires de feu autour du volcan du Cratère d\'Un\'Goro, puis les apporter à Liv Rafistolier, à Cabestan.‡到安戈洛环形山的火山中去，从那里的元素身上收集9份安戈洛灰烬，把它们交给棘齿城的莉芙·雷兹菲克斯。‡到安戈洛環形山的火山中去，從那裡的元素身上收集9份安戈洛灰燼，把它們交給棘齒城的莉芙·雷茲菲克斯。',
  }
},
[4503] = {
  {
    'O Chislo quer voar!‡Крылолет Шиззла‡Sappalots Flieger‡쉬즐의 비행선‡El aparato volador de Shizzle‡El aparato volador de Shizzle‡La machine volante de Shizzle‡希兹尔的飞行器‡希茲爾的飛行器',
    nil,
    'Colete 8 Escamas de Dimetrodonte Palmado e 8 Escamas de Pterrordax Palmado para Chislo no Refúgio do Marshal.‡Принесите 8 чешуй перепончатого деметродона 8 чешуй перепончатого жутедактиля Шиззлу в Укрытие Маршалла.‡Sammelt 8 eingesponnene Dimetrodonschuppen und 8 eingesponnene Pterrordaxschuppen für Sappalot in Marschalls Zuflucht.‡마샬의 야영지에 있는 쉬즐에게 갈퀴 달린 디메트로돈 비늘 8개와 갈퀴 달린 테러닥스 비늘 8개를 가져가야 합니다.‡Recoge 8 escamas de diemetradón palmeadas y 8 escamas de pterrordáctilo palmeadas para Shizzle, en el Refugio de Marshal.‡Recoge 8 escamas de diemetradón palmeadas y 8 escamas de pterrordáctilo palmeadas para Shizzle, en el Refugio de Marshal.‡Apporter 8 Ecailles étoilées de dimeurtrodon et 8 Ecailles étoilées de pterreurdactyles à Shizzle, au refuge des Marshal.‡为马绍尔营地的希兹尔收集8块精细的双帆龙鳞片和8块精细的翼手龙鳞片。‡替馬紹爾營地的希茲爾收集8片精細的雙帆龍鱗片和8片精細的翼手龍鱗片。',
  }
},
[4504] = {
  {
    'Supergrudento‡Суперлипучка‡Superkleber‡초강력 접착제‡Superpegajoso‡Superpegajoso‡Ultra collant‡极度粘稠的沥青‡極度粘稠的瀝青',
    nil,
    'Colete 12 amostras de Piche Supergrudento para Tran\'rek em Geringontzan.‡Отнесите 12 образцов сверхлипкой смолы Тран\'реку в Прибамбасск.‡Sammelt 12 Proben superklebrigen Teer für Tran\'rek in Gadgetzan.‡매우 끈적거리는 타르 12개를 모아 가젯잔에 있는 트란렉에게 갖다 주어야 합니다.‡Reúne 12 muestras de alquitrán muy pegajoso para Tran\'rek de Gadgetzan.‡Reúne 12 muestras de alquitrán muy pegajoso para Tran\'rek de Gadgetzan.‡Collecter 12 échantillons de Goudron ultra collant pour Tran\'rek, à Gadgetzan.‡帮加基森的特兰雷克收集12块极度粘稠的沥青。‡幫加基森的特蘭雷克收集12塊極度粘稠的瀝青。',
  }
},
[4505] = {
  {
    'Poço da Corrupção‡Источник порчи‡Brunnen der Verderbnis‡오염된 달샘‡El pozo de la corrupción‡El pozo de la corrupción‡Puits de la corruption‡腐化之井‡腐化之井',
    nil,
    'Colete uma amostra de água corrompida do poço lunar dos Sátiros Flamejade e leve-a para Winna Perícon no Posto Peçonha.‡Принесите образец оскверненной воды из лунного колодца сатиров из племени Нефритового Пламени Винне Хеззард на заставу Отравленной Крови.‡Beschafft eine Probe verderbten Wassers vom Mondbrunnen der Jadefeuersatyrn und bringt sie zu Winna Hazzard am Blutgiftposten.‡비취불꽃의 사티로스가 지키는 달샘에서 오염된 물 견본을 채취하여 피멍울 초소에 있는 위나 해저드에게 가져가야 합니다.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Riessgo al Puesto del Veneno.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Riessgo al Puesto del Veneno.‡Collecter un échantillon d\'eau corrompue dans le puits de lune des satyres Jadefeu, puis le rapporter à Winna Hazzard, au Poste de la Vénéneuse.‡从碧火萨特的月亮井中收集一份被腐化的水的样本，把它交给血毒哨所的温娜·哈萨德。‡從碧火薩特的月井中收集一份被腐化的水的樣本，把它交給血毒哨所的溫娜·哈薩德。',
  }
},
[4506] = {
  {
    'Dentes-de-sabre corrompidos‡Зараженные саблезубы‡Verderbte Säbler‡오염된 고양이‡Dientes de sable corruptos‡Dientes de sable corruptos‡Sabres corrompus‡被腐蚀的猫‡被腐敗的貓',
    nil,
    'Leve o gatinho de Winna para o poço lunar corrompido, solte-o e depois o leve de volta para Winna.nnQuando retornar, clique no gato para deixá-lo com Winna.‡Отнесите котенка Винны к оскверненному лунному колодцу, выпустите его, затем снова принесите Винне.nnКак только вернетесь к Винне, щелкните мышкой по котенку, чтобы выпустить его.‡Bringt Winnas Kätzchen zum verderbten Mondbrunnen, lasst es dort frei und bringt es dann wieder zu Winna zurück.nnSobald Ihr wieder bei Winna seid, klickt auf die Katze, um sie Winna zu übergeben.‡위나의 고양이를 오염된 달샘으로 데려가서 풀어 준 다음 위나에게 다시 데려가야 합니다.nn위나에게로 데려간 후 클릭하면 위나에게 돌아갈 것입니다.‡Lleva el gatito de Winna a la Poza de la Luna corrupta, libéralo allí y luego llévaselo a Winna.nnCuando hayas vuelto con Winna, haz clic en el felino para dárselo.‡Lleva el gatito de Winna a la Poza de la Luna corrupta, libéralo allí y luego llévaselo a Winna.|nCuando hayas vuelto con Winna, haz clic en el felino para dárselo.‡Amener le chaton de Winna au puits de lune corrompu, le relâcher, puis le rapporter à Winna.nnUne fois de retour auprès de Winna, cliquer sur le chat pour le lui rendre.‡把温娜的小猫带到堕落的月亮井旁边，把猫放出来，然后把它还给温娜。nn当你回到温娜那里之后，点击猫就可以将它还给温娜。‡把溫娜的小貓帶到墮落的月井旁邊，把貓放出來，然後把它帶回去給溫娜。|n當你回到溫娜那裡之後，點擊貓就可以將它還給溫娜。',
  }
},
[4507] = {
  {
    'O peão captura a rainha‡Пешка берет королеву‡Bauer schlägt Dame‡여왕의 뇌‡El señuelo atrapa a la reina‡El señuelo atrapa a la reina‡Le pion prend la reine‡捕捉皇后‡小兵捉蠍后',
    nil,
    'Derrote a Rainha da Colmeia Gorishi assim que ela for atraída.nnLeve o Cérebro da Rainha Gorishi para o Alquimista Almofarrista em Geringontzan.‡Призовите и сразите матку улья Гориши.nnПринесите мозг матки Гориши алхимику Пестычинсу в Прибамбасск.‡Besiegt die Schwarmkönigin der Gorishi, sobald sie erscheint.nnBringt das Gehirn der Schwarmkönigin zu Alchimist Stößelbruch nach Gadgetzan.‡여왕 고리쉬를 불러내 처치해야 합니다.nn가젯잔에 있는 연금술사 페슬저그에게 여왕 고리쉬 뇌를 가져가야 합니다.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.nnLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.|nLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Invoquer la Reine gorishi et la vaincre.nnApporter le Cerveau de reine gorishi à l\'alchimiste Pilonzugg, à Gadgetzan.‡召唤格里什皇后，然后击败她。nn把格里什皇后的大脑交给加基森的炼金师匹斯特苏格。‡當格里什蜂后被召喚之後擊敗她。|n帶格里什皇后的腦袋給加基森的鍊金師匹斯特蘇格。',
  }
},
[4508] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Relatório de Un\'Goro do Almofarrista para Gracinha Forçânima em Darnassus.‡Отнесите отчет Пестычинса о ситуации в Ун\'Горо Грацине Силе Духа в Дарнасс.‡Bringt Stößelbruchs Bericht von Un\'Goro zu Gracina Glaubensmacht in Darnassus.‡다르나서스에 있는 그라시나 스피릿마이트에게 페슬저그의 운고로 보고서를 가져가야 합니다.‡Llévale el informe de Un\'Goro de Morterozugg a Gracina Poderespíritu, que está en Darnassus.‡Llévale el informe de Un\'Goro de Morterozugg a Gracina Poderespíritu, que está en Darnassus.‡Apporter le Rapport de Pilonzugg sur Un\'Goro à Gracina Forcesprit, à Darnassus.‡把匹斯特苏格的安戈洛报告交给达纳苏斯的格拉希娜·灵风。‡把匹斯特蘇格的安戈洛報告交給達納蘇斯的格拉希娜·靈風。',
  }
},
[4509] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Relatório de Un\'Goro do Almofarrista para Zilzibin Tamborleiro em Orgrimmar.‡Отнесите отчет Пестычинса о ситуации в Ун\'Горо Зилзибину Барабанному Бою в Оргриммар.‡Bringt Stößelbruchs Bericht von Un\'Goro zu Zilzibin Tomtom in Orgrimmar.‡오그리마에 있는 질지빈 드럼로어에게 페슬저그의 운고로 보고서를 가져가야 합니다.‡Llévale el informe de Un\'Goro de Morterozugg a Zilzibin Tambor Sabio, que está en Orgrimmar.‡Llévale el informe de Un\'Goro de Morterozugg a Zilzibin Tambor Sabio, que está en Orgrimmar.‡Apporter le Rapport de Pilonzugg sur Un\'Goro à Zilzibin Kongadok, à Orgrimmar.‡把匹斯特苏格的安戈洛报告交给奥格瑞玛斯的基尔兹宾·鼓眼。‡把匹斯特蘇格的安戈洛報告交給奧格瑪的基爾茲賓·鼓眼。',
  }
},
[4510] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Comprovante Bancário a Idriana no banco de Darnassus.‡Отнесите банковскую расписку Идриане в банк Дарнасса.‡Bringt den Bankgutschein zu Idriana in der Bank von Darnassus.‡다르나서스 은행에 있는 이드리아나에게 은행 증서를 가져가야 합니다.‡Lleva el vale del banco a Idriana, al banco de Darnassus.‡Lleva el vale del banco a Idriana, al banco de Darnassus.‡Apporter le Reçu bancaire à Idriana, à la banque de Darnassus.‡把银行赠券交给达纳苏斯银行的伊迪瑞娜。‡把銀行贈券交給達納蘇斯銀行的伊迪瑞娜。',
  }
},
[4511] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Comprovante Bancário para Karus, no banco de Orgrimmar.‡Отнесите банковскую расписку Карусу в банк Оргриммара.‡Bringt den Bankgutschein zu Karus in der Bank von Orgrimmar.‡오그리마 은행에 있는 카루스에게 은행 증서를 가져가야 합니다.‡Lleva el vale a Karus al banco de Orgrimmar.‡Lleva el vale a Karus al banco de Orgrimmar.‡Apporter le Reçu bancaire à Karus, à la banque d\'Orgrimmar.‡把银行赠券交给奥格瑞玛银行的卡鲁斯。‡把銀行贈券交給奧格瑪銀行的卡魯斯。',
  }
},
[4512] = {
  {
    'Gosmologia‡Долгий путь слизнюка‡Brühschlammer auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite gelée‡远方的软泥怪‡遠方的軟泥怪',
    nil,
    'Entregue 6 Jarras de Gosma Amaldiçoada Cheias e 6 Jarras de Gosma Maculada Cheias para Laris Vagarroda em Altaforja.‡Принесите 6 банок с проклятыми слизнюками и 6 банок с нечистыми слизнюками Ларису Обалдую в Стальгорн.‡Bringt 6 gefüllte verfluchte Brühschlammergläser und 6 gefüllte besudelte Brühschlammergläser zu Laris Bummelritzel in Eisenschmiede.‡아이언포지에 있는 라리스 기어더들에게 가득 찬 저주받은 수액괴물 병 6개와 가득 찬 부패한 수액괴물 병 6개를 가져가야 합니다.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto pra Laris Cadenapartida en Forjaz.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto para Laris Mecaparra en Forjaz.‡Apporter 6 Pots de Limons maudits remplis et 6 Pots de Limons corrompus remplis à Laris Bringuefourbi, à Forgefer.‡将6瓶被诅咒的软泥怪样本和6瓶被污染的软泥怪样本交给铁炉堡的拉里斯·空轮。‡將6個被詛咒的軟泥怪樣本和6個受污染的軟泥怪樣本交給鐵爐堡的拉里斯·空輪。',
  }
},
[4513] = {
  {
    'Gosmologia‡Долгий путь слизнюка‡Brühschlammer auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite Gelée‡远方的软泥怪‡遠方的軟泥怪',
    nil,
    'Leve 10 Jarras Cheias de Amostra Pura para Laris Vagarroda em Altaforja.nnCaso você não consiga encontrar as gosmas puras, peça mais pistas para o Laris.‡Принесите 10 банок с чистыми образцами Ларису Обалдую в Стальгорн.nnЕсли будет трудно их найти, возможно, стоит попытаться добиться от Лариса подсказки.‡Bringt 10 gefüllte reine Probengläser zu Laris Bummelritzel in Eisenschmiede.nnFalls Ihr Probleme habt, fündig zu werden, dann kann Laris Euch vielleicht noch den einen oder anderen Hinweis geben.‡아이언포지에 있는 라리스 기어더들에게 가득 찬 순수한 견본 병10개를 가져가야 합니다.nn찾기 어려우면 라리스에게서 단서를 더 얻어 보십시오.‡Lleva 10 tarros de muestra pura a Laris Cadenartida a Forjaz.nnSi no los encuentras, habla con Laris.‡Lleva 10 tarros de muestra pura a Laris Mecaparra a Forjaz.|nSi no los encuentras, habla con Laris.‡Apporter 10 Pots remplis d\'échantillon pur à Laris Bringuefourbi, à Forgefer.nnSi vous éprouvez des difficultés à les trouver, allez voir Laris pour obtenir plus d\'indices.‡将10个纯净样本瓶交给铁炉堡的拉里斯·空轮。nn如果你无法找到它们的话，不妨到拉里斯那里去再打听一些线索。‡將10個裝滿的純淨樣品瓶交給鐵爐堡的拉里斯·空輪。|n如果你無法找到它們的話，試著到拉里斯那裡去再打聽一些線索。',
  }
},
[4521] = {
  {
    'Guardiões selvagens‡Одичавшие стражи‡Wilde Wächter‡사나운 수호병‡Guardianes salvajes‡Guardianes salvajes‡Gardiens sauvages‡冬泉谷的枭兽‡冬泉谷的梟獸',
    nil,
    'Trull Ruinazar em Selva Maleva quer que você mate 15 Ferujas Furiosas e 15 Ferujas Maltrapilhas.‡Убейте для Трулла Баловня Судьбы 15 бешеных совухов и 15 лохматых совухов.‡Trull Scheiterbann im Teufelswald möchte, dass Ihr 15 tobende Eulenbestien und 15 struppige Eulenbestien tötet.‡악령의 숲에 있는 트룰 페일베인이 흉포한 올빼미야수 15마리, 그리고 털북숭이 올빼미야수 15마리를 처치해달라고 부탁했습니다.‡Trull Fallarruina de Frondavil quiere que mates 15 lechubestias enfurecidas y 15 lechubestias andrajosas.‡Trull Fallarruina de Frondavil quiere que mates 15 lechubestias enfurecidas y 15 lechubestias pulgosas.‡Trull Faillemort de Gangrebois veut que vous tuiez 15 Chouettards déchaînés et 15 Chouettards éreintés.‡费伍德森林的特鲁尔·法贝恩要你去冬泉谷猎杀15头狂怒的枭兽和15头蓬毛枭兽。‡費伍德森林的特盧爾·法貝恩要你去冬泉谷獵殺15頭狂怒的梟獸和15頭蓬毛梟獸。',
  }
},
[4542] = {
  {
    'Mensagem para a Aldeia Vento Livre‡Письмо на Заставу Вольного Ветра‡Nachricht zum Freiwindposten‡높새바람 봉우리‡Mensaje para el Poblado Viento Libre‡Mensaje para el Poblado Viento Libre‡Un message pour le poste de Librevent‡给乱风岗的紧急信件‡給亂風崗的緊急信件',
    nil,
    'Leve a Mensagem Urgente ao Vigia do Rochedo Chifre Longo na Aldeia Vento Livre.‡Отнесите срочное послание дозорному утесов Долгорогу на Заставу Вольного Ветра.‡Bringt Klippenbehüter Langhorn am Freiwindposten die dringende Nachricht.‡긴급 전갈을 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 가져가야 합니다.‡Entrégale el mensaje urgente a Vigiarisco Cuernolargo en el Poblado Viento Libre.‡Entrégale el mensaje urgente al vigiarrisco Cuerno Largo en el Poblado Viento Libre.‡Apporter le Message urgent au garde-falaise Longue-corne au Poste de Librevent.‡把紧急信件交给乱风岗的峭壁卫兵图林·长角。‡把緊急信件交給亂風崗的峭壁衛兵圖林·長角。',
  }
},
[4561] = {
  {
    'Teste de impurezas - Cratera Un\'Goro‡Образцы на пробу из кратера Ан-Горо‡Test auf Unreinheiten - Krater von Un\'Goro‡불순물 실험 - 운고로 분화구‡Pruebas de impureza: Cráter de Un\'Goro‡Pruebas de impureza: Cráter de Un\'Goro‡Test pour impuretés, le Cratère d\'Un\'Goro‡杂质检测 - 安戈洛环形山‡雜質檢測 - 安戈洛環形山',
    nil,
    'Você pega uma amostra do visgo da Cratera Un\'Goro e coloca um pouco nos vários tubos e béqueres na mesa. Quando as coisas começam a ferver e a jorrar, o visgo muda de cor. Quando o processo perde a força e os líquidos assentam, você vê uma pequena placa de Petri com suas amostras de visgo de Un\'Goro purificadas, ao lado de restos do processo.‡Вы наполняете слизью, добытой в Кратере Ун\'Горо, различные колбы и мензурки, стоящие на столе. Все начинает бурлить и брызгаться, а слизь меняет цвет. Потом процесс замедляется, жидкость перестает кипеть, и вы видете маленькую чашечку Петри с пробой измененной слизи и какие-то ошметки.‡Ihr nehmt eine Brühschleimerprobe aus dem Un\'Goro Krater und gebt etwas davon in die verschiedenen Röhren und Bechergläser auf dem Tisch. Als alles Mögliche zu blubbern und zu zischen anfängt, verändert der Brühschleimer seine Farbe. Dann kommt der Prozess zum Abschluss. Die Flüssigkeiten beruhigen sich wieder und Ihr seht eine kleine Petrischale, die Eure geläuterten Un\'Goro-Brühschleimerproben sowie einige andere Rückstände enthält.‡운고로 분화구에서 진흙괴물 견본을 채취해 그 일부를 탁자 위에 놓인 갖가지 튜브와 비커에 담습니다. 내용물이 부글부글 끓기 시작하면서 진흙괴물의 색이 변합니다. 실험이 끝나고 액체가 잦아들자 작은 페트리 접시에 순화된 운고로 진흙괴물 견본과 다른 찌꺼기가 남았습니다.‡Coges una muestra de babosa del Cráter de Un\'Goro y colocas un poco en los diversos tubos y vasos de precipitados que se encuentran sobre la mesa. A medida que todo empieza a hervir, la babosa cambia de color. Cuando el proceso comienza a detenerse y los líquidos dejan de bullir, ves una placa de Petri que contiene tus muestras de babosa de Un\'Goro purificadas y algunos restos.‡‡Vous prenez un échantillon de gelée du Cratère d\'Un\'Goro et le placez dans les différents tubes et vases à bec qui sont sur la table. La gelée se met à bouillir et change de couleur. Lorsque la réaction prend fin, vous apercevez dans la petite boîte de Pétri, vos échantillons de Gelée d\'Un\'Goro purifiés et d\'autres restes.‡‡',
  }
},
[4581] = {
  {
    'Kainet Brisacalma‡Кайнет Штиль‡Kayneth Stillwind‡케이네스 스틸윈드‡Kayneth Ventoleve‡Kayneth Ventoleve‡Kayneth Mortebrise‡凯尼斯·静风‡凱尼斯·靜風',
    nil,
    'Leve o Bilhete de Shindrell para Kainet Brisacalma em Cantilenda.‡Отнесите записку Шиндрелл Кайнету Штилю в Лесную Песнь.‡Bringt Shindrells Notiz zu Kayneth Stillwind in Waldeslied.‡숲의 노래에 있는 케이네스 스틸윈드에게 신드렐의 쪽지를 가져가야 합니다.‡Llévale la nota de Shindrell a Kayneth Ventoleve en Canción del Bosque.‡Llévale la nota de Shindrell a Kayneth Ventoleve en Canción del Bosque.‡Apporter la Note de Shindrell à Kayneth Mortebrise au Chant des Forêts.‡把辛德瑞尔的便笺交给林歌神殿里的凯尼斯·静风。‡把辛德瑞爾的便箋交給林歌神殿裡的凱尼斯·靜風。',
  }
},
[4601] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡삐까뻔쩍세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200 et s\'assurer d\'avoir trois pièces d\'argent pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[4602] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡삐까뻔쩍세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener tres monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200 et s\'assurer d\'avoir trois pièces d\'argent pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[4603] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Funkelmatastisch‡삐까뻔쩍세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Brille-o-Matic décape encore‡再次使用超级清洁器‡',
    nil,
    'A Brastematic 5200 está vazia, esperando por um objeto encardido para limpar! Além das três moedas de prata, claro!‡Приемник Чистера 5200 пуст. Чтобы машина заработала, требуется загрязненный предмет и три серебряные монетки.‡Der Funkelmat 5200 ist leer und wartet auf ein schmutzverkrustetes Objekt zum Säubern sowie auf drei Silbermünzen, um loszulegen!‡빈 삐까뻔쩍세척기 5200이 꼬질꼬질한 물건과 작동에 필요한 3실버를 기다리고 있습니다!‡El Destellamatic 5200 parece estar esperando un objeto sucio que limpiar y 3 monedas de plata para activarse.‡‡Le Décapeur 5200 est vide et attend un objet à nettoyer ainsi que trois pièces d\'argent pour démarrer !‡超级清洁器5200型等待着清理脏兮兮的东西，它需要三枚银币才能启动！‡',
  }
},
[4604] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Funkelmatastisch‡삐까뻔쩍세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Décapeur décape encore‡再次使用超级清洁器‡',
    nil,
    'A Brastematic 5200 está vazia, esperando por um objeto encardido para limpar! Além das três moedas de prata, claro!‡Приемник Чистера 5200 пуст. Чтобы машина заработала, требуется загрязненный предмет и три серебряные монетки.‡Der Funkelmat 5200 ist leer und wartet auf ein schmutzverkrustetes Objekt zum Säubern sowie auf drei Silbermünzen, um loszulegen!‡빈 삐까뻔쩍세척기 5200이 꼬질꼬질한 물건과 작동에 필요한 3실버를 기다리고 있습니다!‡El Destellamatic 5200 parece estar esperando un objeto sucio que limpiar y 3 monedas de plata para activarse.‡‡Le Décapeur 5200 est vide et attend un objet à nettoyer ainsi que trois pièces d\'argent pour démarrer !‡超级清洁器5200型等待着清理脏兮兮的东西，它需要三枚银币才能启动！‡',
  }
},
[4605] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡',
    nil,
    'De repente, tão rápido quanto começou a trabalhar, a Brastematic 5200 para de funcionar. A máquina emite um simples "Ding". Então, o local onde você colocou o anel se abre. Lá dentro, você encontra uma caixinha com um laço. Parece que a máquina, além de remover a sujeira, embrulha os objetos para presente. Mesmo que a processo de limpeza não tenha funcionado, ainda assim você recebe seu objeto embrulhado numa caixa muito bonita.nnBom, só há um jeito de saber se o objeto está limpo ou não...‡С проглотив кольцо, машина несколько минут с гудением вертит его в своих недрах и наконец останавливается, звенящим звуком оповестив вас о том, что работа закончена. Окошко приемника открывается, и вы видите в нем аккуратно завернутую коробочку. Видимо, машина выдает очищенные предметы в подарочной упаковке. Ну, даже если кольцо не удалось очистить, вы получили довольно миленькую коробочку за свои деньги... nnЧто ж, посмотрим...‡Der Funkelmat 5200 stoppt so schnell, wie er losgelegt hat. Ein einfaches "Ding" ist aus der Maschine zu hören und der Aufnahmebehälter der Maschine springt auf. Im Funkelmat 5200 liegt eine kleine Schachtel, die von einem Schleifchen umschlungen ist. Offensichtlich verpackt die Maschine ein Objekt, nachdem sie die Schmutzverkrustung entfernt hat. Selbst wenn die Maschine nicht funktioniert hat, ist der Gegenstand jetzt immerhin in einer hübschen Schachtel verpackt.nnTja, es gibt nur einen Weg herauszufinden, ob sie den Gegenstand gesäubert hat oder nicht...‡삐까뻔쩍세척기 5200이 갑자기 멈추어 버립니다. "땡" 소리가 나더니 원통형 입구가 회전하면서 위로 올라와 열립니다. 그 안에는 조그만 리본 장식으로 포장된 작은 상자가 있습니다. 물건의 찌꺼기를 세척하고 난 후 포장까지 한 모양입니다. 찌꺼기가 제대로 없어졌는지는 모르지만 적어도 물건은 예쁘게 포장되어 있습니다.nn제대로 세척됐는지 알아보는 방법은 단 한 가지 뿐...‡La máquina se para tan bruscamente como había arrancado. Se oye un "ping" y se abre la boca de la máquina. Dentro del Destellamatic 5200 hay una cajita con un lazo; parece que envuelve para regalo además de limpiar.nnSolo hay una forma de saber si el objeto está bien limpio...‡‡D\'un coup le Décapeur 5200 s\'arrête net. Un petit carillon émet un "ding" clair et la trappe de l\'appareil s\'ouvre. À l\'intérieur de la machine vous découvrez une petite boîte garnie d\'un noeud. Il semble que la machine emballe les objets après les avoir nettoyés et qu\'elle se donne la peine de les empaqueter dans une jolie boîte même quand elle n\'a pas fonctionné.nnBon, il n\'y a qu\'un seul moyen de savoir si l\'objet à bel et bien été nettoyé ou non...‡‡',
  }
},
[4606] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡삐까뻔쩍세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡',
    nil,
    '‡С проглотив кольцо, машина несколько минут с гудением вертит его в своих недрах и наконец останавливается, звенящим звуком оповестив вас о том, что работа закончена. Окошко приемника открывается, и вы видите в нем аккуратно завернутую коробочку. Видимо, машина выдает очищенные предметы в подарочной упаковке. Ну, даже если кольцо не удалось очистить, вы получили довольно миленькую коробочку за свои деньги... nnЧто ж, посмотрим...‡Der Funkelmat 5200 stoppt so schnell, wie er losgelegt hat. Ein einfaches "Ding" ist aus der Maschine zu hören und der Aufnahmebehälter der Maschine springt auf. Im Funkelmat 5200 liegt eine kleine Schachtel, die von einem Schleifchen umschlungen ist. Offensichtlich verpackt die Maschine ein Objekt, nachdem sie die Schmutzverkrustung entfernt hat. Selbst wenn die Maschine nicht funktioniert hat, ist der Gegenstand jetzt immerhin in einer hübschen Schachtel verpackt.nnTja, es gibt nur einen Weg herauszufinden, ob sie den Gegenstand gesäubert hat oder nicht...‡삐까뻔쩍세척기 5200이 갑자기 멈추어 버립니다. "땡" 소리가 나더니 원통형 입구가 회전하면서 위로 올라와 열립니다. 그 안에는 조그만 리본 장식으로 포장된 작은 상자가 있습니다. 물건의 찌꺼기를 세척하고 난 후 포장까지 한 모양입니다. 찌꺼기가 제대로 없어졌는지는 모르지만 적어도 물건은 예쁘게 포장되어 있습니다.nn제대로 세척됐는지 알아보는 방법은 단 한 가지 뿐...‡La máquina se para tan bruscamente como había arrancado. Se oye un "ping" y se abre la boca de la máquina. Dentro del Destellamatic 5200 hay una cajita con un lazo; parece que envuelve para regalo además de limpiar.nnSolo hay una forma de saber si el objeto está bien limpio...‡‡D\'un coup le Décapeur 5200 s\'arrête net. Un petit carillon émet un "ding" clair et la trappe de l\'appareil s\'ouvre. À l\'intérieur de la machine vous découvrez une petite boîte garnie d\'un noeud. Il semble que la machine emballe les objets après les avoir nettoyés et qu\'elle se donne la peine de les empaqueter dans une jolie boîte même quand elle n\'a pas fonctionné.nnBon, il n\'y a qu\'un seul moyen de savoir si l\'objet à bel et bien été nettoyé ou non...‡超级清洁器5200型突然停止了运行，“叮”的一声响，机器的盖子打开了，里面放着一只扎着蝴蝶结的小盒子。似乎这机器在清除物体表面的污垢以后会把物体包装起来。即使机器没有清理过什么，至少这东西被装在了一个漂亮的盒子里。nn好吧，让我们来看看它有没有清洁你放进去的东西……‡',
  }
},
[4621] = {
  {
    'Ioho, Almirante!‡Стой, Адмирал!‡Holla, Admiral!‡붉은해적단의 제독‡¡Adelante, almirante!‡¡Adelante, almirante!‡En avant toute, amiral !‡敬礼，舰队司令！‡敬禮，艦隊司令!',
    nil,
    'Mate o Mestre de Frota Chifre do Mar e o Barão Rezingada. Em seguida, fale novamente com o Mestre de Frota Firalião a bordo do Véu Carmesim na costa da Selva do Espinhaço.‡Убейте командира флота Морского Рога и барона Ревилгаза из Пиратской Бухты, а потом возвращайтесь к командиру флота Фираллону на борту "Кровавой завесы" неподалеку от побережья Тернистой долины.‡Tötet Flottenmeister Seehorn und Baron Revilgaz aus Beutebucht und kehrt dann zu Flottenmeister Firallon zurück. Er befindet sich auf der Purpurschleier vor der Küste des Schlingendorntals.‡무법항에 있는 함장 시혼과 남작 레빌가즈를 처치한 후, 가시덤불 골짜기의 해안에 정박해 있는 크림슨 베일호의 함장 피랠론에게 돌아가야 합니다.‡Mata al maestro de flota Cuernomarino y al Barón Revilgaz de la Bahía del Botín y, a continuación, vuelve a reunirte con el maestro de flota Firallon abordo del Velo Carmesí, cerca de la costa de la Vega de Tuercespina.‡Mata al maestro de flota Cuernomarino y al Barón Revilgaz de la Bahía del Botín y, a continuación, vuelve a reunirte con el maestro de flota Firallon a bordo del Velo Carmesí, cerca de la costa de la Vega de Tuercespina.‡Tuer l\'amiral Corne-de-mer et le baron Revilgaz de Baie-du-Butin, puis retrouver l\'amiral Firallon à bord du Voile cramoisi, au large des côtes de la vallée de Strangleronce.‡杀死藏宝海湾的舰队指挥官卡拉·海角和大财主里维加兹，然后回到荆棘谷海边的红雾号上去，向舰队指挥官菲尔拉伦复命。‡',
  }
},
[4641] = {
  {
    'O seu lugar no mundo‡Твое место в мире‡Euer Platz in der Welt‡할 일 찾기‡Tu lugar en el mundo‡Tu lugar en el mundo‡Votre place en ce monde‡起点‡起點',
    nil,
    'Fale com Gornek. Kaltunk marcou o paradeiro dele no mapa e mencionou que ele morava no Covil, ao oeste.‡Поговорите с Горнеком. Вы помните, как Калтунк отметил на карте его местонахождение и упомянул, что Горнек живет в Логове, здании, расположенном на западе.‡Sprecht mit Gornek. Euch fällt ein, dass Kaltunk auf Eurer Karte markiert hat, wo er sich befindet. Außerdem erwähnte er, dass Gornek sich im Höhlenbau aufhielte, einem Gebäude im Westen.‡고르넥과 대화하십시오. 칼툰크가 지도를 가리키며 서쪽에 있는 동굴 막사에 있다고 한 것이 기억납니다.‡Habla con Gornek. Recuerda que Kaltunk marcó en tu mapa su ubicación y que te mencionó que Gornek reside en El Cubil, un edificio que está al oeste.|n|n‡Habla con Gornek. Recuerda que Kaltunk marcó en tu mapa su ubicación y que te mencionó que Gornek reside en El Cubil, un edificio que está al oeste.‡Parler à Gornek. Souvenez-vous que Kaltunk vous a indiqué où il se trouvait sur votre carte et vous a dit que Gornek résidait dans l\'Antre, un bâtiment vers l\'ouest.‡与高内克谈一谈。卡尔图克在你的地图上标出了他的位置，并告诉你高内克居住在西边的大兽穴中。‡與高內克談一談。卡爾圖克在你的地圖上標出了他的位置，並告訴你高內克居住在西邊的大獸穴中。',
  }
},
[4642] = {
  {
    'Amálgama de influências‡Слияние‡Vereinigung von Einflüssen‡반응의 결합‡Fusión de influencias‡Fusión de influencias‡Trafic d\'influences‡融合软泥怪‡融合軟泥怪',
    nil,
    'Leve uma Amostra de Gosma Amalgamada para o Químico Sérgio na Cidade Baixa.‡Принесите образец перемешанной слизи химику Барабосу в Подгород.‡Bringt eine verschmolzene Brühschlammerprobe zum Chemiker Brenner in Unterstadt.‡언더시티에 있는 연금술사 퓰리에게 합쳐진 수액괴물 견본을 가져가야 합니다.‡Llévale una muestra del moco fusionado al químico Fuely de Entrañas.‡Llévale una muestra de moco fusionado al químico Fuely de Entrañas.‡Apporter un Échantillon de Limon mélangé au Chimiste Fuely à Fossoyeuse.‡把一块融合的软泥怪样本交给幽暗城的化学家弗雷。‡把一塊融合的軟泥怪樣本交給幽暗城的化學家弗雷。',
  }
},
[4661] = {
  {
    'Teste para Corrupção - Selva Maleva‡Проба – образцы из Оскверненного леса‡Test für Verderbnis - Teufelswald‡타락 실험 - 악령의 숲‡Pruebas de Corrupción: Frondavil‡Pruebas de Corrupción: Frondavil‡Test de corruption, Gangrebois‡堕落检测 - 费伍德森林‡墮落檢測 - 費伍德森林',
    nil,
    'Você pega uma amostra do visgo da Selva Maleva e coloca um pouco nos vários tubos e béqueres na mesa. Quando as coisas começam a ferver e a jorrar, o visgo muda de cor. Quando o processo perde a força e os líquidos assentam, você vê uma pequena placa de Petri com suas amostras alteradas de visgo da Selva Maleva junto com o resto de algumas outras substâncias.‡Вы наполняете слизью, добытой в Оскверненном лесу, различные колбы и мензурки, стоящие на столе. Все начинает бурлить и брызгаться, а слизь меняет цвет. Потом процесс замедляется, жидкость перестает кипеть, и вы видете маленькую чашечку Петри с пробой измененной слизи и какие-то ошметки.‡Ihr nehmt eine Brühschlammerprobe aus dem Teufelswald und gebt etwas davon in die verschiedenen Röhren und Bechergläser auf dem Tisch. Als alles Mögliche zu blubbern und zu zischen anfängt, verändert der Schleim seine Farbe. Dann kommt der Prozess zum Abschluss. Die Flüssigkeiten beruhigen sich wieder und Ihr seht eine kleine Petrischale, die Eure veränderten Teufelswaldschleimproben und einige andere Rückstände enthält.‡악령의 숲에서 진흙괴물 견본을 채취해 그 일부를 탁자 위에 놓인 갖가지 튜브와 비커에 담습니다. 내용물이 부글부글 끓기 시작하면서 진흙괴물의 색이 변합니다. 실험이 끝나고 액체가 잦아들자 작은 페트리 접시에 변화된 악령의숲 진흙괴물 견본과 다른 찌꺼기가 남았습니다.‡Coges una muestra de babosa de Frondavil y colocas un poco en los diversos tubos y vasos de precipitados que se encuentran sobre la mesa. A medida que todo empieza a hervir, la babosa cambia de color. Cuando el proceso comienza a detenerse y los líquidos dejan de bullir, ves una placa de Petri que contiene tus muestras de babosa de Frondavil modificadas y algunos restos.‡‡Vous prenez un échantillon de gelée de Gangrebois et le placez dans les différents tubes et vases à bec qui sont sur la table. La gelée se met à bouillir et change de couleur. Lorsque la réaction prend fin, vous apercevez dans la petite boîte de pétri, vos échantillons de Gelée de Gangrebois altérés et d\'autres restes.‡‡',
  }
},
[4681] = {
  {
    'Deixa a água me levar‡Останки на берегу‡An Land gespült‡해변으로 올라온 바다 생물‡Varado‡Varado‡Échouage‡搁浅的巨兽‡擱淺的巨獸',
    nil,
    'Recupere a Carcaça de Tartaruga Marinha da Tartaruga Marinha Descarnada nas águas a oeste de Auberdine, e então fale com Gwennyth Bly\'Leggonde em Auberdine.‡Извлеките останки морской черепахи из скелета морской черепахи, лежащего в воде к западу от Аубердина, а затем поговорите с Гвеннид Блай\'Леггонд в Аубердине.‡Bergt die Meeresschildkrötenüberreste der skelettierten Meeresschildkröte in den Gewässern westlich von Auberdine und sprecht anschließend in Auberdine mit Gwennyth Bly\'Leggonde.‡아우버다인 서쪽 바다에 있는 바다거북 유해에서 바다거북 잔해를 회수한 후, 아우버다인에 있는 그웨니스 블리레곤드에게 돌아와 대화해야 합니다.‡Recoge restos de la tortuga marina esquelética de las aguas del oeste de Auberdine y vuelve a Auberdine a hablar con Gwennyth Bly\'Leggonde.‡Recoge restos de la tortuga marina esquelética de las aguas del oeste de Auberdine y vuelve a Auberdine a hablar con Gwennyth Bly\'Leggonde.‡Récupérer les Restes de tortue de mer sur le Squelette de la tortue de mer, dans les eaux à l’ouest d’Auberdine, puis parler à Gwennyth Bly\'Leggonde, à Auberdine.‡在奥伯丁西面海水中的海龟骸骨那里取回海龟残骸，然后与奥伯丁的温尼斯·布莱葛谈一谈。‡在奧伯丁西面海水中的海龜骨骸那裡取回海龜的殘骸，然後與奧伯丁的溫尼斯·布萊葛談話。',
  }
},
[4701] = {
  {
    'Acabando com ela‡Устранение опасности‡Stellt sie ab‡검은늑대 위협의 근원 파괴‡Acaba con el origen de la amenaza‡Acaba con el origen de la amenaza‡Abattez-la‡座狼之源‡座狼之源',
    nil,
    'Vá ao Pico da Rocha Negra e destrua a fonte da ameaça worg. Quando você deixou Helendis, ele gritou um nome: Halycon. É assim que os orcs se referem aos worgs.‡Отправьтесь на пик Черной горы и уничтожьте источник опасности. Хелендис кричит вам вслед одно имя: Халикон. Именно его упоминали орки в связи с воргами.‡Begebt Euch zur Schwarzfelsspitze und vernichtet die Quelle der Bedrohung durch die Worgs. Als Ihr Helendis verlasst, ruft er Euch noch einen Namen hinterher: Halycon. Darauf beziehen sich die Orcs im Zusammenhang mit den Worgs.‡검은바위 첨탑으로 가서 검은늑대 위협의 근원을 파괴해야 합니다. 헬렌디스를 떠날 때 헬렌디스가 오크들이 특정한 검은늑대를 부르는 말인 할리콘이라는 이름을 외치는 것을 들었습니다.‡Viaja hasta la Cumbre de Roca Negra y destruye el origen de la amenaza del huargo. Cuando dejaste a Helendis, gritó un nombre: Halycon. Es la palabra que los orcos usan para referirse al huargo.‡Viaja hasta la Cumbre de Roca Negra y destruye el origen de la amenaza del huargo. Cuando dejaste a Helendis, gritó un nombre: Halycon. Es la palabra que los orcos usan para referirse al huargo.‡Allez au Pic Rochenoire et anéantissez la source de la menace. Quand vous avez quitté Helendis, il a crié un nom : Halycon. C\'est ce que disent les orcs en parlant des worgs.‡到黑石塔去摧毁那里的座狼源头。当你离开的时候，赫林迪斯喊出了一个名字：哈雷肯。这个词就是兽人语中"座狼"的意思。‡到黑石塔去摧毀那裡的座狼源頭。當你離開的時候，赫林迪斯喊出了一個名字:哈雷肯。這個詞就是獸人語中「座狼」的意思。',
  }
},
[4721] = {
  {
    'Guardiões selvagens‡Одичавшие стражи‡Wilde Wächter‡사나운 수호병‡Guardianes salvajes‡Guardianes salvajes‡Les gardiens sauvages‡冬泉谷的枭兽‡冬泉谷的梟獸',
    nil,
    'Trull Ruinazar em Selva Maleva quer que você cace 10 Ferujas Berserk em Hibérnia.‡Убейте для Трулла Баловня Судьбы из Оскверненного леса 10 яростных совухов в Зимних Ключах.‡Trull Scheiterbann im Teufelswald möchte, dass Ihr in Winterquell 10 Berserkereulenbestien jagt.‡악령의 숲에 사는 트룰 페일베인이 여명의 설원에서 광포한 올빼미야수 10마리를 처치해 달라고 요청했습니다.‡Trull Fallarruina de Frondavil quiere que caces 10 lechubestias rabiosas en Cuna del Invierno.‡Trull Fallarruina de Frondavil quiere que caces 10 lechubestias rabiosas en Cuna del Invierno.‡Trull Faillemort à Gangrebois veut que vous chassiez 10 Chouettards berserk au Berceau-de-l\'Hiver.‡费伍德森林的特鲁尔·法贝恩要你去冬泉谷猎杀10头狂暴枭兽。‡費伍德森林的特盧爾·法貝恩要你去冬泉谷獵殺10頭狂暴梟獸。',
  }
},
[4722] = {
  {
    'Tartaruga Marinha Encalhada‡Останки морской черепахи‡Gestrandete Meeresschildkröte‡떠내려온 바다 생물‡Tortuga marina varada‡Tortuga marina varada‡La tortue de mer échouée‡搁浅的海龟‡擱淺的海龜',
    nil,
    'Leve a Carcaça de Tartaruga Marinha para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите останки морской черепахи Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meeresschildkrötenüberreste nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다거북 잔해를 가져가야 합니다.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Restes de tortue de mer à Gwennyth Bly\'Leggonde à Auberdine.‡把海龟的残骸交给奥伯丁的温尼斯·布莱葛。‡把海龜的殘骸交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4723] = {
  {
    'Criatura Marinha Encalhada‡Останки морской твари‡Gestrandete Meereskreatur‡떠내려온 바다 생물‡Criatura marina varada‡Criatura marina varada‡La créature marine échouée‡搁浅的海洋生物‡擱淺的海洋生物',
    nil,
    'Leve os Ossos de Criaturas Marinhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите кости морской твари Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meereskreaturknochen nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다 생물 뼈를 가져가야 합니다.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Os de créature marine à Gwennyth Bly\'Leggonde à Auberdine.‡把海洋生物的骸骨交给奥伯丁的温尼斯·布莱葛。‡把海洋生物的骸骨交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4724] = {
  {
    'Senhora do matilha‡Праматерь стаи‡Die Herrin der Meute‡검은늑대 무리의 어미‡La maestra de la manada‡La maestra de la manada‡La maîtresse de meute‡座狼的首领‡座狼的首領',
    nil,
    'Mate Halycon, senhora da matilha dos Worgs Machado Sangrento.‡Убейте Халикон, праматерь стаи воргов Кровавого Топора.‡Erschlagt Halycon, die Rudelführerin der Worgs der Blutäxte.‡도끼부대 검은늑대 무리의 어미, 할리콘을 처치해야 합니다.‡Mata a Halycon, empaqueta la Maestra del huargo Hacha de Sangre.‡Mata a Halycon, la maestra de la manada de los huargos Hacha de Sangre.‡Tuer Halycon, la maîtresse de la meute des worgs Hache-sanglante.‡杀死血斧座狼的领袖，哈雷肯。‡殺死血斧座狼的領袖，哈雷肯。',
  }
},
[4725] = {
  {
    'Tartaruga marinha encalhada‡Останки морской черепахи‡Gestrandete Meeresschildkröte‡떠내려온 바다 생물‡Tortuga marina varada‡Tortuga marina varada‡La tortue de mer échouée‡搁浅的海龟‡擱淺的海龜',
    nil,
    'Leve a Caixa com Marcações Estranhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите ящик со странными пометками Гвеннид Блай\'Леггонд в Аубердин.‡Bringt den seltsam markierten Kasten nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 이상한 표식이 된 상자를 가져가야 합니다.‡Lleva la caja con símbolos extraños a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva la caja con símbolos extraños a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter la Boîte aux marques étranges à Gwennyth Bly\'Leggonde à Auberdine.‡把有奇怪标记的箱子交给奥伯丁的温尼斯·布莱葛。‡把有奇怪標記的箱子交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4726] = {
  {
    'Essência da Reprodução‡Сущность детеныша дракона‡Brutlingessenz‡새끼용의 정수‡Esencia de cría‡Esencia de cría‡L\'essence de rejeton‡雏龙精华‡小龍精華',
    nil,
    'Leve 8 Essências da Reprodução e o Draco-incarcinatrix 900 a Vera Brequim no Monte Candente, que fica nas Estepes Ardentes.‡Принесите 8 сущностей детенышей драконов и Драко-инкарцинатор 900 Тинки Кипеллер в Пламенеющий Стяг в Пылающих степях.‡Bringt 8 Brutlingessenzen sowie den Draco-Incarcinatrix 900 zu Tinkee Kesseldampf am Flammenkamm in der brennenden Steppe.‡불타는 평원의 화염 마루에 있는 팅키 스팀보일에게 새끼용의 정수 8개와 새끼용 속박장치 900을 가져가야 합니다.‡Llévale 8 esencias de cría y el Draco-Incarcinatrix 900 a Tinkee Vaporio en el Peñasco Llamarada, en Las Estepas Ardientes.‡Llévale 8 esencias de cría y el Draco-Incarcinatrix 900 a Tinkee Vaporio en el Peñasco Llamarada, en Las Estepas Ardientes.‡Apporter 8 Essences de Rejeton et le Draco-Incarcinatrix 900 à Brikolette Toutevapeur à la Corniche des flammes dans les Steppes ardentes.‡将龙灵采集器900型和8份雏龙精华交给燃烧平原烈焰峰的丁奇-斯迪波尔。‡將龍靈採集器900型和8份小龍精華交給燃燒平原烈焰峰的丁奇·斯迪波爾。',
  }
},
[4727] = {
  {
    'Tartaruga Marinha Encalhada‡Останки морской черепахи‡Gestrandete Meeresschildkröte‡떠내려온 바다 생물‡Tortuga marina varada‡Tortuga marina varada‡La tortue de mer échouée‡搁浅的海龟‡擱淺的海龜',
    nil,
    'Leve a Carcaça de Tartaruga Marinha para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите останки морской черепахи Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meeresschildkrötenüberreste nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다거북 잔해를 가져가야 합니다.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Restes de tortue de mer à Gwennyth Bly\'Leggonde à Auberdine.‡把海龟的残骸交给奥伯丁的温尼斯·布莱葛。‡把海龜的殘骸交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4728] = {
  {
    'Criatura Marinha Encalhada‡Останки морской твари‡Gestrandete Meereskreatur‡떠내려온 바다 생물‡Criatura marina varada‡Criatura marina varada‡La créature marine échouée‡搁浅的海洋生物‡擱淺的海洋生物',
    nil,
    'Leve os Ossos de Criaturas Marinhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите кости морской твари Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meereskreaturknochen nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다 생물 뼈를 가져가야 합니다.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Os de créature marine à Gwennyth Bly\'Leggonde à Auberdine.‡把海洋生物的骸骨交给奥伯丁的温尼斯·布莱葛。‡把海洋生物的骸骨交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4729] = {
  {
    'Mascotes exóticas do Kibler‡Редкие звери Киблера‡Kiblers Exotische Tiere‡키블러의 진귀한 애완동물‡Las mascotas exóticas de Kibler‡Las mascotas exóticas de Kibler‡Les animaux exotiques de Kibler‡基布雷尔的特殊宠物‡基布雷爾的特殊寵物',
    nil,
    'Vá para o Pico da Rocha Negra e encontre Filhotes de Worg Machado Sangrento. Use a jaula para carregar essas pequenas feras. Leve um Filhote de Worg Enjaulado para Kibler.‡Отправьтесь на пик Черной горы и отыщите там щенков воргов легиона Кровавого Топора. Посадите маленьких тварей в клетку и отнесите Киблеру.‡Begebt Euch zur Schwarzfelsspitze und sucht Worgwelpen der Blutäxte. Benutzt den Käfig, um die wilden kleinen Bestien zu transportieren. Bringt einen eingesperrten Worgwelpen zu Kibler.‡검은바위 첨탑으로 가서 새끼 도끼부대 검은늑대를 찾아야 합니다. 우리를 사용하여 이 사나운 야수들을 운반하여 키블러에게 사로잡은 새끼 검은늑대를 가져가야 합니다.‡Viaja hasta la Cumbre de Roca Negra y encuentra cachorros de huargo Hacha de Sangre. Usa la jaula para transportar a esas feroces fierecillas. Llévale a Kibler 1 cachorro de huargo encerrado.‡Viaja hasta la Cumbre de Roca Negra y encuentra cachorros de huargo Hacha de Sangre. Usa la jaula para transportar a esas feroces fierecillas. Llévale a Kibler 1 cachorro de huargo enjaulado.‡Aller au Pic Rochenoire et trouver de Jeunes worgs Hache-sanglante. Utiliser la cage pour transporter ces petites bêtes féroces. Rapporter un Jeune worg en cage à Kibler.‡到黑石塔去找到血斧座狼幼崽。使用笼子来捕捉这些凶猛的小野兽，然后把笼中的座狼幼崽交给基布雷尔。‡到黑石塔去找到小血斧座狼。使用籠子來捕捉這些兇猛的小野獸，然後把籠中的小血斧座狼交給基布雷爾。',
  }
},
[4730] = {
  {
    'Criatura Marinha Encalhada‡Останки морской твари‡Gestrandete Meereskreatur‡떠내려온 바다 생물‡Criatura marina varada‡Criatura marina varada‡La créature marine échouée‡搁浅的海洋生物‡擱淺的海洋生物',
    nil,
    'Leve os Ossos de Criaturas Marinhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите кости морской твари Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meereskreaturknochen nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다 생물 뼈를 가져가야 합니다.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Os de créature marine à Gwennyth Bly\'Leggonde à Auberdine.‡把海洋生物的骸骨交给奥伯丁的温尼斯·布莱葛。‡把海洋生物的骸骨交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4731] = {
  {
    'Tartaruga Marinha Encalhada‡Останки морской черепахи‡Gestrandete Meeresschildkröte‡떠내려온 바다거북‡Tortuga marina varada‡Tortuga marina varada‡La tortue de mer échouée‡搁浅的海龟‡擱淺的海龜',
    nil,
    'Leve a Caixa com Marcações Estranhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите ящик со странными пометками Гвеннид Блай\'Леггонд в Аубердин.‡Bringt den seltsam markierten Kasten nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 이상한 표식이 된 상자를 가져가야 합니다.‡Lleva la caja con símbolos extraños a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva la caja con símbolos extraños a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter la Boîte aux marques étranges à Gwennyth Bly\'Leggonde à Auberdine.‡把有奇怪标记的箱子交给奥伯丁的温尼斯·布莱葛。‡把有奇怪標記的箱子交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4732] = {
  {
    'Tartaruga Marinha Encalhada‡Останки морской черепахи‡Gestrandete Meeresschildkröte‡떠내려온 바다거북‡Tortuga marina varada‡Tortuga marina varada‡La tortue de mer échouée‡搁浅的海龟‡擱淺的海龜',
    nil,
    'Leve a Carcaça de Tartaruga Marinha para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите останки морской черепахи Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meeresschildkrötenüberreste nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다거북 잔해를 가져가야 합니다.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los restos de la tortuga marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Restes de tortue de mer à Gwennyth Bly\'Leggonde à Auberdine.‡把海龟的残骸交给奥伯丁的温尼斯·布莱葛。‡把海龜的殘骸交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4733] = {
  {
    'Criatura Marinha Encalhada‡Останки морской твари‡Gestrandete Meereskreatur‡떠내려온 바다 생물‡Criatura marina varada‡Criatura marina varada‡La créature marine échouée‡搁浅的海洋生物‡擱淺的海洋生物',
    nil,
    'Leve os Ossos de Criaturas Marinhas para Gwennyth Bly\'Leggonde em Auberdine.‡Отнесите кости морской твари Гвеннид Блай\'Леггонд в Аубердин.‡Bringt die Meereskreaturknochen nach Auberdine zu Gwennyth Bly\'Leggonde.‡아우버다인에 있는 그웨니스 블리레곤드에게 바다 생물 뼈를 가져가야 합니다.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Lleva los huesos de la criatura marina a Gwennyth Bly\'Leggonde a Auberdine.‡Apporter les Os de créature marine à Gwennyth Bly\'Leggonde à Auberdine.‡把海洋生物的骸骨交给奥伯丁的温尼斯·布莱葛。‡把海洋生物的骸骨交給奧伯丁的溫尼斯·布萊葛。',
  }
},
[4734] = {
  {
    'Congelar os ovos‡Заморозка яйца‡Ei-Frosten‡알껍질 냉동‡Un huevo congelado‡Un huevo congelado‡Un oeuf congelé‡冷冻龙蛋‡冷凍龍蛋',
    nil,
    'Use o Protótipo de Ovosciloscópio em um ovo no Viveiro.‡Испытайте прототип яйцехладоскопа на одном из яиц в Гнездовье.‡Benutzt den Prototyp des Eiszilloskops an einem Ei im Horst.‡알껍질급속냉각기 견본을 둥지에 있는 알에 사용해야 합니다.‡Usa el prototipo de ovosciloscopio sobre un huevo de El Grajero.‡Usa el prototipo de ovosciloscopio sobre un huevo de El Grajero, en la Cumbre de Roca Negra.‡Utiliser le Prototype d\'Oeufilloscope sur un oeuf dans la Colonie.‡在孵化间对着某颗龙蛋使用龙蛋冷冻器初号机。‡在孵化間對著某顆龍蛋使用龍蛋冷凍器初號機。',
  }
},
[4735] = {
  {
    'Coleção de ovos‡Сбор яиц‡Eiersammlung‡알 수집‡La colecta de huevos‡La colecta de huevos‡La collecte d\'oeufs‡收集龙蛋‡收集龍蛋',
    nil,
    'Leve 8 Ovos de Dragão Recolhidos e o Módulo Colectrônico a Vera Brequim no Monte Candente, que fica nas Estepes Ardentes.‡Принесите 8 драконьих яиц и устройство-коллекционер Тинки Кипеллер в Пламенеющий Стяг в Пылающих степях.‡Bringt 8 eingesammelte Dracheneier sowie das kollektronische Modul zu Tinkee Kesseldampf am Flammenkamm in der brennenden Steppe.‡불타는 평원의 화염 마루에 있는 팅키 스팀보일에게 수집한 용의 알 8개를 가져가야 합니다.‡Llévale 8 huevos de dragón y el módulo colectrónico a Tinkee Vaporio en el Peñasco Llamarada, en Las Estepas Ardientes.‡Llévale 8 huevos de dragón y el módulo colectrónico a Tinkee Vaporio en el Peñasco Llamarada, en Las Estepas Ardientes.‡Apporter 8 Œufs de dragon collectés et le Module collectronique à Brikolette Toutevapeur à la Corniche des flammes dans les Steppes Ardentes.‡将电动采集模块和8颗收集到的龙蛋交给燃烧平原烈焰峰的丁奇·斯迪波尔。‡將電動採集模組和8顆收集到的龍蛋交給燃燒平原烈焰峰的丁奇·斯迪波爾。',
  }
},
[4736] = {
  {
    'Em busca de Menara Nihila‡Поиски Менары Расщепительницы Бездны‡Auf der Suche nach Menara Leerbringer‡미네라 보이드렌더를 찾아서‡Buscando a Menara Nadiz‡Buscando a Menara Nadiz‡À la recherche de Menara Voidrender‡寻找梅纳拉·沃伦德‡',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡',
  }
},
[4737] = {
  {
    'Em busca de Menara Nihila‡Поиски Менары Расщепительницы Бездны‡Auf der Suche nach Menara Leerbringer‡미네라 보이드렌더를 찾아서‡Buscando a Menara Nadiz‡Buscando a Menara Nadiz‡À la recherche de Menara Taillevide‡寻找梅纳拉·沃伦德‡尋找梅納拉·虛無撕裂者',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4738] = {
  {
    'Em busca de Menara Nihila‡Поиски Менары Расщепительницы Бездны‡Auf der Suche nach Menara Leerbringer‡미네라 보이드렌더를 찾아서‡Buscando a Menara Nadiz‡Buscando a Menara Nadiz‡À la recherche de Menara Voidrender‡寻找梅纳拉·沃伦德‡尋找梅納拉·虛無撕裂者',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht im Brachland mit Menara Leerbringer.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4739] = {
  {
    'Em busca de Menara Nihila‡Поиски Менары Расщепительницы Бездны‡Auf der Suche nach Menara Leerbringer‡미네라 보이드렌더를 찾아서‡Buscando a Menara Nadiz‡Buscando a Menara Nadiz‡À la recherche de Menara Taillevide‡寻找梅纳拉·沃伦德‡尋找梅納拉·虛無撕裂者',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4740] = {
  {
    'PROCURA-SE: Lodofundo!‡Разыскивается: Глубомрак!‡GESUCHT: Gurgelbacke!‡현상 수배: 먹구렁‡SE BUSCA: ¡Viscoso!‡SE BUSCA: ¡Viscoso!‡On recherche : Fondeboue !‡通缉：莫克迪普！‡懸賞:莫克迪普!',
    nil,
    'Encontre e mate o murloc conhecido como Lodofundo. Acredita-se que a criatura esteja defendendo as tendas dos murlocs ao sul de Auberdine, ao longo da costa.nnRelate a morte de Lodofundo à Sentinela Glynda Nal\'Shea em Auberdine.‡Найдите и убейте мурлока, известного как Глубомрак. Предполагается, что это существо охраняет и защищает хижины мурлоков в поселении к югу от Аубердина, у воды.nnО смерти Глубомрака доложите часовому Глинде Нал\'Шии в Аубердине.‡Sucht und tötet den Murloc namens Gurgelbacke. Man nimmt an, dass die Kreatur die Hütten der Murlocs am Strand südlich von Auberdine beschützt.nnInformiert Schildwache Glynda Nal\'Shea über Gurgelbackes Tod.‡먹구렁이라는 멀록을 찾아서 처치해야 합니다. 이 괴물은 아우버다인 남쪽, 해안에서 멀록 오두막을 보호하고 있는 것으로 추정됩니다.nn먹구렁을 처치하면 아우버다인에 있는 파수꾼 글린다 날셰에게 보고하십시오.‡Encuentra y mata al múrloc conocido como Viscoso. Se cree que la criatura está defendiendo el emplazamiento múrloc al sur de Auberdine, cerca del agua. nnInforma de la muerte de Viscoso a la centinela Glynda Nal\'Shea, en Auberdine.‡Encuentra y mata al múrloc conocido como Viscoso. Se cree que la criatura está defendiendo el emplazamiento múrloc al sur de Auberdine, cerca del agua.|nInforma de la muerte de Viscoso a la centinela Glynda Nal\'Shea, en Auberdine.‡Trouver et tuer le murloc connu sous le nom de Fondeboue. On pense que la créature défend les huttes des murlocs au sud d\'Auberdine près de l\'eau.nnAnnoncer la mort de Fondeboue à la Sentinelle Glynda Nal\'Shea à Auberdine.‡找到并杀死名为莫克迪普的鱼人。它守护着位于奥伯丁南部海岸的鱼人营地。nn向奥伯丁的哨兵戈琳达·纳希恩报告莫克迪普的死讯。‡找到並殺死名為莫克迪普的魚人。它守護著位於奧伯丁南部海岸的魚人營地。|n向奧伯丁的哨兵戈琳達·納希恩報告莫克迪普的死訊。',
  }
},
[4741] = {
  {
    'Guardiões selvagens‡Одичавшие стражи‡Wilde Wächter‡사나운 수호병‡Guardianes salvajes‡Guardianes salvajes‡Les gardiens sauvages‡冬泉谷的枭兽‡冬泉谷的梟獸',
    nil,
    'Trull Ruinazar em Selva Maleva quer que você cace 13 Ferujas Lunamarca.‡Убейте для Трулла Баловня Судьбы из Оскверненного леса 13 лунных совухов.‡Trull Scheiterbann im Teufelswald möchte, dass Ihr in Winterquell 13 mondbestrahlte Eulenbestien jagt.‡악령의 숲에 사는 트룰 페일베인이 달빛 깃든 올빼미야수 13마리를 처치해 달라고 요청했습니다.‡Trull Fallarruina de Frondavil quiere que caces 13 lechubestias lunadón.‡Trull Fallarruina de Frondavil quiere que caces 13 lechubestias lunadón.‡Trull Faillemort à Gangrebois veut que vous chassiez 13 Chouettards lunaires.‡费伍德森林的特鲁尔·法贝恩要你去冬泉谷猎杀13头月光枭兽。‡費伍德森林的特盧爾·法貝恩要你去冬泉谷獵殺13頭月光梟獸。',
  }
},
[4742] = {
  {
    'Selo da Ascensão‡Печать Вознесения‡Siegel des Aufstiegs‡승천의 인장‡El sello de ascensión‡El sello de ascensión‡Le Sceau d\'ascension‡晋升印章‡晉升徽印',
    nil,
    'Encontre as três gemas da autoridade: a Gema de Espinho Fúmeo, a Gema de Agulhapétrea e a Gema de Machado Sangrento. Entregue-as, junto com o Selo da Ascensão sem Adorno, a Vaelan.nnOs generais, como informado a você por Vaelan, são: Senhor da Guerra Voone dos Fumocardo, Grão-lorde Omokk dos Agulhapétrea e Lorde Supremo Wyrmthalak dos Machado Sangrento.‡Найдите самоцвет Тлеющего Терновника, самоцвет Черной Вершины и самоцвет Кровавого Топора. Верните их Ваэлану вместе с простой печатью Вознесения.nnКамни могут быть у трех генералов: у воеводы Вуна из клана Тлеющего Терновника, у вождя Омокка из клана Черной Вершины и у повелителя Змейталака из клана Кровавого Топора.‡Sucht die drei Edelsteine der Befehlsgewalt: den Edelstein der Gluthauer, den Edelstein der Felsspitzoger und den Edelstein der Blutäxte. Bringt sie zusammen mit dem unverzierten Siegel des Aufstiegs zu Vaelan zurück.nnVaelan nannte Euch auch die Namen der drei Generäle: Kriegsmeister Voone von den Gluthauern, Hochlord Omokk von den Felsspitzogern und Oberanführer Wyrmthalak von den Blutäxten.‡사령관의 세 가지 보석인 가시불꽃부족 보석, 뾰족바위일족 보석, 도끼부대 보석을 찾아, 가공하지 않은 승천의 인장과 함께 밸란에게 가져가야 합니다.nn밸란이 말한 장군들은 가시불꽃부족의 대장군 부네, 뾰족바위일족의 대군주 오모크와 도끼부대의 대군주 웜타라크입니다.‡Encuentra las 3 gemas del mando: La gema de Espina Ahumada, la gema de Cumbrerroca y la gema de Hacha de Sangre. Llévaselas, junto con el sello de ascensión sin adornar a Vaelan.nnLos generales, como te dijo Vaelan, son: el maestro de guerra Voone de los Espina Ahumada, el Alto Señor Omokk de los Cumbrerroca y el Señor Supremo Vermiothalak de los Hacha de Sangre.‡Encuentra las 3 gemas del mando: La gema de Espina Ahumada, la gema de Cumbrerroca y la gema de Hacha de Sangre. Llévaselas, junto con el sello de ascensión sin adornar a Vaelan.|nLos generales, como te dijo Vaelan, son: el maestro de guerra Voone de los Espina Ahumada, el alto señor Omokk de los Cumbrerroca y el señor supremo Vermiothalak de los Hacha de Sangre.‡Trouver les trois gemmes de commandement : la Gemme de Brûleronce, la Gemme de Pierre-du-pic et la Gemme de Hache-sanglante. Rapportez-les, ainsi que le Sceau d\'ascension non décoré, à Vaelan.nnLes généraux, comme vous l\'a dit Vaelan, sont : le maître de guerre Voone de Brûleronce ; le généralissime Omokk des Pierres-du-pic ; et le seigneur Wyrmthalak de Hache-sanglante.‡找到三块命令宝石：燃棘宝钻、尖石宝钻和血斧宝钻。把它们和原始晋升印章一起交给维埃兰。nn可能携带者三块宝石的将军是：燃棘氏族的指挥官沃恩、尖石氏族的欧莫克大王，以及血斧氏族的维姆萨拉克。‡找到三塊命令寶石:燃棘寶鑽、尖石寶鑽和血斧寶鑽。把它們和原始晉升徽印一起交給維埃蘭。|n可能攜帶者三塊寶石的將軍是:燃棘氏族的指揮官沃恩、尖石氏族的歐莫克大王，以及血斧氏族的維姆薩拉克主宰。',
  }
},
[4743] = {
  {
    'Selo da Ascensão‡Печать Вознесения‡Siegel des Aufstiegs‡승천의 인장‡El Sello de ascensión‡El sello de ascensión‡Le sceau de l\'ascension‡晋升印章‡晉升徽印',
    nil,
    'Vá para o Pântano da Serpe, que fica no Pântano Vadeoso. Encontre o draco ancião Ardeluta e ataque-o sem misericórdia até que sua vontade seja quebrada.nnÉ nesse momento que você deve colocar o Selo da Ascensão de Metal Bruto em frente a essa fera imponente. Você deve então ser <rápido/rápida> para usar o Orbe de Energia Dracônica em sua forma enfraquecida e dominar suas faculdades mentais. Controle a fera e lance as chamas da Revoada Dragônica Negra sobre o Selo da Ascensão de Metal Bruto!‡Идите в Драконьи топи в Пылевых топях. Найдите Огнебора и бейте его, не жалея, чтобы сломить его волю.nnКак только воля великого зверя ослабнет, надо немедленно положить перед ним заготовку печати Вознесения и воспользоваться сферой Энергии дракона, чтобы подчинить себе его разум и направить его пламя на заготовку.‡Reist zum Drachensumpf in den Düstermarschen. Sucht den alten Drachen Aschenschwinge auf und bekämpft ihn ohne Gnade, bis sein Wille gebrochen ist.nnIn genau diesem Moment müsst Ihr das ungeschmiedete Siegel des Aufstiegs vor der großen Bestie hinlegen. Dann müsst Ihr schnell die Kugel der drachischen Energie auf seine geschwächte Gestalt anwenden und die Kontrolle über seine geistigen Kräfte übernehmen. Kontrolliert die Bestie und zwingt die Flammen des schwarzen Drachenschwarms auf das ungeschmiedete Siegel des Aufstiegs!‡먼지진흙 습지대에 있는 용의 둥지로 가서 고대 비룡, 엠버스트라이프를 찾아 그의 의지가 꺾일 때까지 무자비하게 공격을 펼쳐야 합니다.nn바로 그때 거대한 엠버스트라이프 앞에 벼려지지 않은 승천의 인장을 가져다 놓으십시오. 그리고 약해진 엠버스트라이프에게 재빨리 용력의 보주를 사용해 그의 정신력을 조종해야 합니다. 엠버스트라이프를 조종해 검은용군단의 화염을 벼려지지 않은 승천의 인장에 뿜어야 합니다!‡Viaja a la Ciénaga de Fuego en Marjal Revolcafango. Encuentra al anciano draco Brasaliza y derrótalo sin contemplaciones hasta doblegar su voluntad.nnEste es el preciso momento en el que debes colocar el Sello de ascensión sin forjar ante la colosal bestia. Debes entonces ser rápido en usar el orbe de energía dracónica sobre su debilitada forma y reclamar el dominio sobre sus facultades mentales. ¡Controla la bestia y dirige las llamas del Vuelo Negro sobre el Sello de ascensión sin forjar!‡Viaja a la Ciénaga de Fuego en Marjal Revolcafango. Encuentra al anciano draco Brasaliza y derrótalo sin contemplaciones hasta doblegar su voluntad.|nEste es el preciso momento en el que debes colocar el Sello de ascensión sin forjar ante la colosal bestia. Debes entonces ser rápido en usar el orbe de energía dracónica sobre su debilitada forma y reclamar el dominio sobre sus facultades mentales. ¡Controla la bestia y dirige las llamas del Vuelo Negro sobre el Sello de ascensión sin forjar!‡Allez à la tourbière du Ver dans le marécage d\'Âprefange. Trouvez l\'ancien drake, Brandeguerre, et frappez-le sans merci jusqu\'à ce que sa volonté soit brisée.nnÀ cet instant précis, vous devez placer le Sceau d\'ascension brut devant l\'énorme bête. Vous devez ensuite utiliser rapidement l\'Orbe d\'énergie draconique sur sa forme affaiblie et prendre possession de ses facultés mentales. Contrôlez la bête et dirigez les flammes du Vol noir sur le Sceau d\'ascension brut !‡到尘泥沼泽中的巨龙沼泽去。找到上古老龙埃博斯塔夫，对他发起无情的攻击，直到他的意志被摧毁。nn此时，你必须尽快将未铸造的晋升印章放在这条龙面前，并使用龙力宝珠控制他的躯体，强迫他将黑龙的烈焰喷向未铸造的晋升印章！‡到塵泥泥沼中的巨龍泥沼去。找到上古之龍艾博斯塔夫，對他發起無情的攻擊，直到他的意志被摧毀。|n此時，你必須儘快將未鑄造的晉升徽印放在這條龍面前，並使用龍力寶珠控制他的軀體，強迫他將黑龍軍團的烈焰噴向未鑄造的晉升徽印!',
  }
},
[4761] = {
  {
    'Trovejius Tecevento‡Тандрис Ветропряд‡Thundris Windwirker‡툰드리스 윈드위버‡Thundris Tejevientos‡Thundris Tejevientos‡Thundris Tissevent‡桑迪斯·织风‡桑迪斯·織風',
    nil,
    'Fale com Trovejius Tecevento em Auberdine.‡Поговорите с Тандрисом Ветропрядом в Аубердине.‡Sprecht mit Thundris Windwirker in Auberdine.‡아우버다인에 있는 툰드리스 윈드위버와 대화하십시오.‡Ve a Auberdine y habla con Thundris Tejevientos.‡Ve a Auberdine y habla con Thundris Tejevientos.‡Parler à Thundris Tissevent, à Auberdine.‡与奥伯丁的桑迪斯·织风谈一谈。‡與奧伯丁的桑迪斯·織風談話。',
  }
},
[4762] = {
  {
    'Rio Fontescarpa‡Река Скалистая‡Der Klippenquell‡폭포수 강‡El Río Fonroca‡El Río Fonroca‡La Bondissante‡壁泉河‡壁泉河',
    nil,
    'Vá para o norte de Auberdine até a primeira queda d\'água ao longo do Rio Fontescarpa e consiga uma amostra do charco.nnLeve a Amostra do Rio Fontescarpa para Trovejius Tecevento em Auberdine.‡Отправляйтесь на север от Аубердина, к первому водопаду вверх по реке Скалистой, и там возьмите пробу.nnС пробой воды Скалистой реки возвращайтесь в Аубердин к Тандрису Ветропряду.‡Geht von Auberdine aus nach Norden zum ersten Wasserfall des Klippenquell und entnehmt aus dem Teich dort eine Probe.nnKehrt mit der Probe des Klippenquells zu Thundris Windwirker nach Auberdine zurück.‡아우버다인 북쪽으로 가서 폭포수 강 가장자리에 있는 첫 번째 폭포에서 물 견본을 채취해야 합니다.nn폭포수 강물 견본을 가지고 아우버다인에 있는 툰드리스 윈드위버에게 돌아가십시오.‡Viaja al norte de Auberdine hasta la primera cascada del Río Fonroca y recoge una muestra de agua. nnVuelve a Auberdine a buscar a Thundris Tejevientos con la muestra del Río Fonroca.‡Viaja al norte de Auberdine hasta la primera cascada del Río Fonroca y recoge una muestra de agua.|nVuelve a Auberdine a buscar a Thundris Tejevientos con la muestra del Río Fonroca.‡Aller au nord d\'Auberdine, à la première chute d\'eau, le long de la Bondissante et prélever un échantillon de l\'eau de l\'étang.nnRetourner voir Thundris Tissevent, à Auberdine, avec le Prélèvement de la Bondissante.‡到奥伯丁的北面去，沿着壁泉河到达第一个瀑布处，从瀑布下的水潭中取出一份水样。nn将壁泉河水样交给奥伯丁的桑迪斯·织风。‡到奧伯丁的北面去，沿著壁泉河到達第一個瀑布處，從瀑布下的水潭中取出一份水樣。|n將壁泉河水樣交給奧伯丁的桑迪斯·織風。',
  }
},
[4763] = {
  {
    'Os Bosquenero corrompidos‡Порабощенные фурболги Чернолесья‡Die verderbten Schwarzfelle‡타락한 검은나무일족‡La corrupción de los Bosque Negro‡La corrupción de los Bosque Negro‡La corruption des Noirbois‡黑木熊怪的堕落‡黑木熊怪的墮落',
    nil,
    'Encha a Bacia de Limpeza Vazia no Poço Lunar de Auberdine.nnObtenha uma amostra de fruta, noz e grão dos acampamentos dos pelursos Bosquenero ao norte.nnMisture tudo na bacia e coloque junto à fogueira próxima ao Rio Fontescarpa, no acampamento norte. E assim atraia o sátiro corruptor.nnPegue o Talismã de Corrupção e o leve para Trovejius Tecevento em Auberdine.‡Наполните пустую чашу очищения из лунного колодца Аубердина.nnСоберите образцы фруктов, орехов и зерна в расположенных на севере лагерях фурболгов.nnСмешайте все в чаше и поместите ее возле ближайшего к реке Скалистой большого костра в северном лагере, вызвав таким образом сатира.nnСнимите с него талисман порчи и принесите его Тандрису Ветропряду в Аубердин.‡Füllt die leere Säuberungsschale am Mondbrunnen in Auberdine.nnHolt jeweils eine Probe von Früchten, Nüssen und Getreide aus dem Lager der Schwarzfellfurbolgs im Norden.nnMischt alles in der Schale und stellt diese bei dem Freudenfeuer neben dem Klippenquell auf Höhe des nördlichen Lagers ab und lockt dadurch den Satyrverderber an.nnNehmt den Talisman der Verderbnis und bringt ihn zu Thundris Windwirker in Auberdine.‡아우버다인 달샘의 물로 빈 정화의 그릇을 채우십시오.nn검은나무일족 펄볼그 북부 야영지에서 검은나무일족 과일 견본, 검은나무일족 열매 견본, 검은나무일족 곡식 견본을 모으십시오.nn물과 음식을 한데 섞어 북부 야영지의 폭포수 강에서 가장 가까운 화톳불 근처에 두면 사티로스 타락자를 불러낼 수 있습니다.nn부패의 부적을 손에 넣은 후 아우버다인에 있는 툰드리스 윈드위버에게 가져가십시오.‡Llena el cuenco purificador vacío en la Poza de la Luna de Auberdine. nnRecoge una muestra de fruta, nueces y grano del campamento del norte de los fúrbolg Bosque Negro. nnMezcla todo en el cuenco, llévalo al campamento norte y colócalo cerca de la hoguera más cercana al Río Fonroca; así convocarás al sátiro corruptor. nnCoge el dije de corrupción y llévaselo a Thundris Tejevientos a Auberdine.‡Llena el cuenco purificador vacío en la Poza de la Luna de Auberdine.|nRecoge una muestra de fruta, nueces y grano del campamento del norte de los fúrbolgs Bosque Negro.|nMezcla todo en el cuenco, llévalo al campamento norte y colócalo cerca de la hoguera más cercana al Río Fonroca; así convocarás al sátiro corruptor.|nCoge el dije de corrupción y llévaselo a Thundris Tejevientos a Auberdine.‡Remplir le Bol de purification vide au Puits de lune d\'Auberdine.nnCollecter un échantillon de fruit, de noix et de céréales dans les camps nord des furbolgs Noirbois.nnMélanger les échantillons de nourriture à l\'eau du bol et le placer à proximité du feu le plus proche de la rivière Bondissante, au camp nord. Cela fera venir le satyre corrupteur.nnPrendre son Talisman de corruption et l\'apporter à Thundris Tissevent, à Auberdine.‡在空的净化碗里盛满奥伯丁月亮井的井水。nn在黑木熊怪的北部营地里收集水果、坚果和谷物各一份。nn将水和三种食物混合起来，放置在壁泉河附近的营火边，这样就会召来唤引诱熊怪堕落的萨特。nn取回堕落护符，将它交给奥伯丁的桑迪斯·织风。‡在空的淨化碗裡盛滿奧伯丁月井的井水。|n在黑木熊怪的北部營地裡收集水果、堅果和榖物各一份。|n將水和三種食物混合起來，放置在壁泉河附近的營火邊，這樣就會召來喚引誘熊怪墮落的薩特。|n取回墮落護符，將它交給奧伯丁的桑迪斯·織風。',
  }
},
[4764] = {
  {
    'Broche do Finitudo‡Пряжка Роковой оснастки‡Doomriggers Schnalle‡파멸의 기념물‡El Broche de Equipasino‡El Broche de Equipasino‡Le fermoir de Frèteruine‡末日扣环‡末日扣環',
    nil,
    'Leve o Broche do Finitudo para Mayara Asaluz nas Estepes Ardentes.‡Принесите пряжку роковой оснастки Майре Светлое Крыло в Пылающие степи.‡Bringt Mayara Wolkenglanz in der brennenden Steppe Doomriggers Schnalle.‡불타는 평원에 있는 마야라 브라이트윙에게 파멸의 기념물을 가져가야 합니다.‡Llévale el broche de Equipasino a Mayara Alasol en Las Estepas Ardientes.‡Llévale el broche de Equipasino a Mayara Alasol en Las Estepas Ardientes.‡Apporter le Fermoir de Frèteruine à Mayara Luisaile, dans les Steppes ardentes.‡将末日扣环交给燃烧平原的玛亚拉·布莱特文。‡將末日扣環交給燃燒平原的瑪亞拉·布萊特文。',
  }
},
[4765] = {
  {
    'Entrega para Espargosa‡Доставить Риджвеллу‡Lieferung an Kronenbrunn‡리지웰에게 가져가기‡Entrega a Bonacresta‡Entrega a Bonacresta‡La livraison à Bellornière‡瑞治维尔的箱子‡送貨給瑞治維爾',
    nil,
    'Leve a Caixote de Espargosa para o Conde Capistrano de Espargosa em Ventobravo.‡Отнесите ящик Риджвелла Ремингтону Риджвеллу в Штормград.‡Bringt Kronenbrunns Kiste zu Remington Kronenbrunn nach Sturmwind.‡스톰윈드에 있는 레밍턴 리지웰에게 리지웰의 상자를 가져가야 합니다.‡Llévale el cajón de Crestabuena a Remington Crestabuena en Ventormenta.‡Llévale el cajón de Bonacresta al conde Remington Bonacresta en el Castillo de Ventormenta, en Ventormenta.‡Apporter la Caisse de Bellornière à Remington Bellornière, à Hurlevent.‡将瑞治维尔的箱子交给暴风城的雷明顿·瑞治维尔。‡將瑞治維爾的木箱交給暴風城的雷明頓·瑞治維爾。',
  }
},
[4766] = {
  {
    'Mayara Asaluz‡Майра Светлое Крыло‡Mayara Wolkenglanz‡마야라 브라이트윙‡Mayara Alasol‡Mayara Alasol‡Mayara Luisaile‡玛亚拉·布莱特文‡瑪亞拉·布萊特文',
    nil,
    'Fale com Mayara Asaluz nas Estepes Ardentes.‡Поговорите с Майрой Светлое Крыло в Пылающих степях.‡Sprecht mit Mayara Wolkenglanz in der brennenden Steppe.‡불타는 평원에 있는 마야라 브라이트윙과 대화해야 합니다.‡Habla con Mayara Alasol en Las Estepas Ardientes.‡Habla con Mayara Alasol en Vigilia de Morgan en Las Estepas Ardientes.‡Parler à Mayara Luisaile, dans les Steppes Ardentes.‡与燃烧平原的玛亚拉·布莱特文谈一谈。‡與燃燒平原的瑪亞拉·布萊特文談話。',
  }
},
[4767] = {
  {
    'Mantícora‡Ветрокрыл‡Windreiter‡와이번 조련사‡Jinete del viento‡Jinete del viento‡Le coursier du vent‡驭风者‡雙足飛龍',
    nil,
    'Leve 10 Ovos de Mantícora de Alcândora para Elu, na Aldeia Vento Livre.‡Соберите в Скальном гнездовье 10 яиц виверн и отнесите их Элу на Заставу Вольного Ветра.‡Bringt Elu am Freiwindposten 10 Eier von Steilhangflügeldrachen.‡높새바람 봉우리에 있는 엘루에게 마루둥지 와이번 알 10개를 가져가야 합니다.‡Consigue 10 huevos de dracoleón Nido Alto para Elu en el Poblado Viento Libre.‡Consigue 10 huevos de dracoleón de Nido Alto para Elu en el Poblado Viento Libre.‡Apporter 10 Œufs de wyverne de Haut-perchoir à Elu au poste de Librevent.‡将10颗双足飞龙的蛋交给乱风岗的艾鲁。‡將10顆風巢雙足翼龍的蛋交給亂風崗的艾魯。',
  }
},
[4768] = {
  {
    'A tabuleta de Pedranegra‡Табличка Темнокамня‡Die Dunkelsteinschrifttafel‡다크스톤 서판‡La tablilla de Rocanegra‡La tablilla de Rocanegra‡La tablette de Sombrepierre‡黑暗石板‡黑暗石板',
    nil,
    'Leve a Tabuleta de Pedranegra à Umbramante Vivian Latumba, em Karrath.‡Принесите табличку Темного Камня тенемагу Вивиан Лаграв в Каргат.‡Bringt der Schattenmagierin Vivian Lagrave in Kargath die Dunkelsteinschrifttafel.‡카르가스에 있는 어둠마법사 비비안 라그레이브에게 다크스톤 서판을 가져가야 합니다.‡Llévale la tablilla de Rocanegra a la maga oscura Vivian Latumba en Kargath.‡Llévale la tablilla de Rocanegra a la maga oscura Vivian Lagrave en Kargath.‡Apporter la Tablette de Sombrepierre à l\'ombremage Vivian Lagrave à Kargath.‡将黑暗石板交给卡加斯的暗法师薇薇安·拉格雷。‡將黑暗石板交給卡加斯的暗影法師薇薇安·拉格雷。',
  }
},
[4769] = {
  {
    'Vivian Latumba e a Tabuleta de Pedranegra‡Вивиан Лягроб и табличка Темнокамня‡Vivian Lagrave und die Dunkelsteinschrifttafel‡비비안 라그레이브와 다크스톤 서판‡Vivian Latumba y la tablilla de Rocanegra‡Vivian Lagrave y la tablilla de Rocanegra‡Vivian Lagrave et la tablette de Sombrepierre‡薇薇安·拉格雷和黑暗石板‡薇薇安·拉格雷和黑暗石板',
    nil,
    'Fale com a Umbramante Vivian Latumba.‡Переговорите с темным магом Вивианой Лягроб.‡Sprecht mit Schattenmagierin Vivian Lagrave.‡어둠마법사 비비안 라그레이브와 대화해야 합니다.‡Habla con la maga oscura Vivian Latumba.‡Habla con la maga oscura Vivian Lagrave.‡Parler à l\'ombremage Vivian Lagrave.‡与卡加斯的暗法师薇薇安·拉格雷谈一谈。‡與卡加斯的暗影法師薇薇安·拉格雷談話。',
  }
},
[4770] = {
  {
    'Vínculo fraterno‡Путь домой‡Auf der Heimreise‡집으로‡De vuelta a casa‡De vuelta a casa‡Vers le pays natal‡回家‡返家',
    nil,
    'Escolte Pae\'ka Monte Veloz para fora de Alcândora, depois converse com Motega Barba de Fogo, no Posto Confinalvo.‡Выведите Паоку Ходячую Гору из Скального гнездовья, а потом поговорите с Мотегой Огненной Гривой на заставе Белого Плеса.‡Begleitet Pao\'ka Bergrausch aus dem Steilhang heraus und sprecht dann am Weißgipfelposten mit Motega Feuermähne.‡마루둥지에 있는 파오카 스위프트마운틴을 호위해 간 다음 백사장 야영지에 있는 모테가 파이어메인과 대화하십시오.‡Saca a Pao\'ka Velocimontés de Nido Alto y después habla con Motega Pirocabello en Campamento del Tramo Blanco.‡Saca a Pao\'ka Monte Presto de Nido Alto y después habla con Motega Pirocabello en Campamento del Tramo Blanco.‡Escorter Pao\'ka Montagne-agile à partir de Haut-perchoir, puis parler à Motega Crin-de-feu au poste de Blanc-relais.‡护送波卡·雨山走出风巢，然后和白沙岗哨的莫特加·火鬃谈一谈。‡護送波卡·捷山走出風巢，然後和白沙崗哨的莫特加·火鬃談話。',
  }
},
[4771] = {
  {
    'Aposta da Aurora‡Рассветный гамбит‡Dämmerungstrickfalle‡여명의 계략‡Gambito del Alba‡Gambito del Alba‡Le gambit de l\'aube‡黎明先锋‡黎明先鋒',
    nil,
    'Coloque a Aposta da Aurora na Sala de Exibição de Scolomântia. Derrote Vectus, depois fale novamente com Betina Bigozinco.‡Отнесите "Рассветный гамбит" в демонстрационную комнату в Некроситете. Уничтожьте Вектуса и возвращайтесь к Бетине Биггльцинк.‡Legt die Dämmerungstrickfalle in den Vorführraum von Scholomance. Besiegt Vectus und kehrt dann zu Betina Moppelzink zurück.‡스칼로맨스의 스칼로맨스 강당 문에 여명의 계략을 놓아두고 벡투스를 처치한 후 베티나 비글징크에게 돌아가야 합니다.‡Coloca el Gambito del Alba en la Sala de la Visión de Scholomance. Derrota a Vectus y ve a ver a Betina Bigglezink.‡Coloca el Gambito del Alba en la Sala de la Visión de Scholomance. Derrota a Vectus y ve a ver a Betina Bigglezink.‡Placer le Gambit de l\'aube dans la Chambre des visions de la Scholomance. Vaincre Vectus, puis retourner auprès de Betina Bigglezink.‡将黎明先锋放在通灵学院的观察室里。打败维克图斯，然后回到贝蒂娜·比格辛克那里去。‡將黎明先鋒放在通靈學院的觀察室裡。打敗維克圖斯,然後回到貝蒂娜·比格辛克那裡去。',
  }
},
[4781] = {
  {
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Leve uma Barra de Ouro para Xizk Pontobom, na Selva do Espinhaço.‡Отнесите слиток золота Зиску Ладноскрою в Тернистую долину.‡Bringt Xizk Gutstich im Schlingendorntal einen Goldbarren.‡가시덤불 골짜기에 있는 시즈크 굿스티치에게 금괴 하나를 가져가야 합니다.‡Llévale un lingote de oro a Xizk Cortefino en la Vega de Tuercespina.‡Llévale un lingote de oro a Xizk Cortefino en la Vega de Tuercespina.‡Apporter une Barre d\'or à Xizk Beaupiqué dans la vallée de Strangleronce.‡将一块金锭交给荆棘谷的希兹克·古斯提。‡將一塊金錠交給荊棘谷的希茲克·古斯提。',
  }
},
[4782] = {
  {
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Fale com Menara Nihila, nos Sertões.‡Возвращайтесь к Менаре Расщепительнице Бездны в Степи.‡Kehrt zu Menara Leerbringer im Brachland zurück.‡불모의 땅에 있는 미네라 보이드렌더에게 돌아가십시오.‡Regresa junto a Menara Nadiz en Los Baldíos.‡Regresa junto a Menara Nadiz en Los Baldíos.‡Retourner voir Menara Taillevide dans les Tarides.‡回到贫瘠之地的梅纳拉·沃伦德那里。‡回到貧瘠之地的梅納拉·虛無撕裂者那裡。',
  }
},
[4783] = {
  {
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Leve 10 Ampolas de Sangue de Furiódio e 1 Pedra Infernal Menor para Menara Nihila, nos Sertões.‡Принесите 10 фиалов крови сатира из племени Ярой Ненависти и 1 простой камень Преисподней в Степи, Менаре Менара Расщепительнице Бездны.‡Bringt Menara Leerbringer im Brachland 10 Phiolen Zornsäerblut und 1 geringen Höllenstein.‡불모의 땅에 있는 미네라 보이드렌더에게 서릿발분노의 사티로스 피 10병과 하급 지옥정령석 1개를 가져가야 합니다.‡Llévale 10 viales de sangre Odio Feroz y 1 piedra Infernal inferior a Menara Nadiz en Los Baldíos.‡Llévale 10 viales de sangre Odio Feroz y 1 piedra Infernal inferior a Menara Nadiz en Los Baldíos.‡Apporter 10 Fioles de sang de Fielfurie et 1 Pierre infernale inférieure à Menara Taillevide dans les Tarides.‡将10瓶怨怒萨特之血和1块次级地狱火石交给贫瘠之地的梅纳拉·沃伦德。‡將10瓶怨怒薩特之血和1塊次級地獄火石交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4784] = {
  {
    'Componentes para um robessangre dourado encantado‡Материалы для зачарованной золотой кроводежды‡Komponenten für die verzauberte Goldblutrobe‡흑마법사의 로브‡Los componentes para la toga de sangre dorada encantada‡Los componentes para la toga de sangre dorada encantada‡Les composants de la robe sanglante dorée enchantée‡魔化金线血袍‡附魔金線血袍',
    nil,
    'Leve Fio de Ouro de Qualidade, 2 Carvões Fumegantes e um Estilhaço de Alma para Menara Nihila, nos Sertões.‡Принесите Менаре Расщепительнице Бездны в Степи нить из чистого золота, 2 тлеющих угля и осколок души.‡Bringt Menara Leerbringer im Brachland feinen Goldfaden, 2 glimmende Kohlen und einen Seelensplitter.‡불모의 땅에 있는 미네라 보이드렌더에게 고급 금빛 실타래와 이글거리는 석탄 2개, 그리고 영혼의 조각 1개를 가져가야 합니다.‡Llévale unos hilos finos de oro, 2 trozos de ascuas humeantes y 1 fragmento de alma a Menara Nadiz en Los Baldíos.‡Llévale unos hilos finos de oro, 2 trozos de ascuas humeantes y 1 fragmento de alma a Menara Nadiz en Los Baldíos.‡Apporter du Fil d\'or fin, 2 Charbons ardents et un Fragment d\'âme à Menara Taillevide dans les Tarides.‡将一些优质金线、2块闷烧煤和一块灵魂碎片交给贫瘠之地的梅纳拉·沃伦德。‡將一些優質金線、2塊悶燒煤和一塊靈魂裂片交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4785] = {
  {
    'Fio de ouro de qualidade‡Нить из чистого золота‡Feiner Goldfaden‡고급 금빛 실타래‡Hilo de oro refinado‡Hilo de oro fino‡Fil d\'or fin‡优质金线‡優質金線',
    nil,
    '‡Вот, бери. И пожалуйста, передай от нас привет Менаре.nnМы ждем от тебя великих свершений. Быть может, когда Легион падет на колени, прозвучит твое имя и хвала твоей силе. Жду не дождусь!‡Bitte sehr, <Name>. Und bitte richtet doch Menara Grüße von uns aus.nnWir erwarten große Dinge von Euch. Wenn die Legion in die Knie gezwungen ist, wird man bestimmt Euren Namen rufen und Eure Kraft preisen. Ich kann es kaum erwarten!‡자, 받으시오, <name>. 미네라에게 우리 대신 안부나 전해 주게.nn우리 형제는 당신에게 큰 기대를 걸고 있어. 언젠가 불타는 군단이 굴복하게 되면 모두들 당신의 이름을 크게 칭송하게 될 거야. 그날이 정말 기대되는 걸!‡Aquí tienes, <nombre>. Y saluda a Menara de nuestra parte.nnTenemos grandes esperanzas contigo. Quizás cuando la Legión caiga de rodillas, se pronunciará tu nombre en voz alta y se alabará tu poder. ¡Cómo ansío ese momento!‡‡Voilà, <nom>. Et s\'il vous plaît, dites à Menara que nous la saluons.nnNous espérons beaucoup de vous. Peut-être que, lorsque la Légion sera à genoux, votre nom et votre puissance seront loués haut et fort. Je suis impatient !‡‡',
  }
},
[4786] = {
  {
    'Veste prêt-à-porter‡Завершенное одеяние‡Die fertiggestellte Robe‡완성된 로브‡Toga terminada‡Toga terminada‡La Robe terminée‡完成金线血袍‡',
    nil,
    'Espere até Menara Nihila concluir a sua veste e depois fale novamente com ela.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над вашим одеянием, и еще раз поговорите с ней.‡Wartet, bis Menara Leerbringer Eure Robe fertiggestellt hat, und sprecht dann noch einmal mit ihr.‡미레나 보이드렌드가 로브를 완성할 때까지 기다린 다음 그녀와 다시 대화하십시오.‡Espera a que Menara Nadiz complete tu túnica y vuelve entonces a hablar con ella.‡Espera a que Menara Nadiz complete tu túnica y vuelve entonces a hablar con ella.‡Attendre que Menara Taillevide ait terminé votre robe puis lui parler de nouveau.‡等待梅纳拉·沃伦德织好披风，然后跟她谈一谈。‡',
  }
},
[4787] = {
  {
    'O ovo velho‡Древнее яйцо‡Das uralte Ei‡고대의 알‡El huevo antiguo‡El huevo antiguo‡L\'œuf antique‡远古之卵‡遠古之卵',
    nil,
    'Leve o Ovo Velho para Yeh\'kinya, em Tanaris.‡Принесите древнее яйцо Йе\'кинье в Танарис.‡Bringt das uralte Ei zu Yeh\'kinya nach Tanaris.‡고대의 알을 타나리스에 있는 예킨야에게 가져다주어야 합니다.‡Llévale el huevo antiguo a Yeh\'kinya, que está en Tanaris.‡Llévale el huevo antiguo a Yeh\'kinya, que está en Tanaris.‡Apporter l\'Oeuf antique à Yeh\'kinya à Tanaris.‡将远古之卵交给塔纳利斯的叶基亚。‡將遠古之卵交給塔納利斯的葉基亞。',
  }
},
[4788] = {
  {
    'As últimas tabuletas‡Последние таблички‡Die letzten Schrifttafeln‡마지막 서판‡Las últimas tablillas‡Las últimas tablillas‡Les dernières tablettes‡最后的石板‡最後的石板',
    nil,
    'Leve a Quinta e a Sexta Tabuletas Mosh\'Aru ao Prospector Botaférrea, em Tanaris.‡Принесите пятую и шестую таблички Мошару геологу Железному Башмаку в Танарисе.‡Bringt Ausgrabungsleiter Eisenschuh in Tanaris die fünfte und sechste Schrifttafel von Mosh\'aru.‡다섯 번째와 여섯 번째 모쉬아루 서판을 타나리스에 있는 발굴조사단장 아이언부트에게 갖다주어야 합니다.‡Llévale la quinta y sexta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Llévale la quinta y sexta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Apporter la Cinquième et la Sixième tablette Mosh\'aru au Prospecteur Botte-de-fer à Tanaris.‡将第五块和第六块摩沙鲁石板交给塔纳利斯的勘查员詹斯·铁靴。‡將第五塊和第六塊摩沙魯石板交給塔納利斯的勘察員鐵靴。',
  }
},
[4801] = {
  {
    'E\'ko de sabre-de-gelo‡Э\'ко ледопардов‡E\'ko der Frostsäbler‡눈호랑이의 에코‡E\'ko de Sable de Hielo‡E\'ko de sable de hielo‡L\'E\'ko des Sabres-de-givre‡霜刃魂精‡霜刃魂精',
    nil,
    '‡В Зимних Ключах тебе биться предстоит с огромными кошками, ледопардами. Эти звери жутко быстрые и ловкие. Если хочешь обрести скорость ледопарда принеси э‘ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь э‘ко добыть.‡In Winterspring da werdeta gegen große Katzens kämpfen müssen, das sin\' de Frostsäblers. Diese Biesties sin\' unglaublich schnell un\' gerissen. Wenn Ihr auch so schnell wie \'n Frostsäbler sein wollt, dann bringt mir das E\'ko, das Ihr von ihnen kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡여명의 설원으로 가면 눈호랑이라는 거대한 고양잇과 동물과 싸우게 될 거야. 엄청나게 빠르고 영리한 짐승이지. 눈호랑이와 같은 속도를 얻고 싶다면 놈들에게서 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 몸에 지니고 있어야 한다는 사실을 명심하게.‡‡‡Au Berceau-de-l\'Hiver, vous combattrez de grands félins appelés "sabres-de-givre". Ces bêtes sont incroyablement rapides et vicieuses. Si vous voulez gagner la vitesse des sabres-de-givre, apportez-moi l\'Eko que vous trouverez sur eux.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4802] = {
  {
    'E\'ko de invernoso‡Э\'ко фурболгов племени Зимней Спячки‡E\'ko der Winterfelle‡눈사태일족의 에코‡E\'ko de los Nevada‡E\'ko Nevada‡L\'E\'ko des Tombe-hiver‡寒水魂精‡寒水魂精',
    nil,
    'Em Hibérnia, tu vai dar de cara com umas criaturas desencaminhadas chamadas de pelursos invernosos. A vontade do líder deles fez eles ganharem uma força inacreditável. Se tu quiser a força de um invernoso, traz pra mim o E\'ko deles.nnSe liga, tu precisa ter as provisões de Mau\'Ari no inventário para poder caçar E\'ko.‡В Зимних Ключах тебе придется сражаться со свихнувшимися существами – фурболгами племени Зимней Спячки. По воле своего вождя они обрели невероятную силу. Если и ты хочешь получить силу этого племени, принеси мне э‘ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь камень Э‘ко добыть.‡In Winterspring da werdeta gegen fehlgeleitete Kreaturens kämpfen, das sin\' de Winterfellfurbolgse. Weil ihr Anführer das so wollt\', ham die unglaubliche Kraft gekriegt. Wenn Ihr auch so stark wie \'n Winterfell sein wollt, dann bringt mir das E\'ko, das Ihr von ihnen kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡여명의 설원으로 가면 눈사태일족 펄볼그라는 괴상한 족속과 싸우게 될 거야. 그들은 우두머리 덕에 엄청난 힘을 갖게 되었지. 눈사태일족과 같은 힘을 얻고 싶다면 그들에게서 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 반드시 몸에 지니고 있어야 하네.‡En Cuna del Invierno combatirás con unas criaturas descarriadas conocidas como los furbolgs Nevada. Siguiendo los deseos de su líder se han hecho increíblemente fuertes. Si quieres el poder de los Nevada tráeme el E\'ko que encontrarás en ellos.nnRecuerda, debes tener el Alijo de Mau\'ari en tu inventario si quieres conseguir E\'ko.‡‡Au Berceau-de-l\'Hiver, vous combattrez des créatures perdues connues sous le nom de furbolgs Tombe-hiver. Sous l\'égide de leur maître, ils ont gagné une force incroyable. Si vous voulez acquérir la puissance des Tombe-hiver, apportez-moi l\'E\'ko que vous leur prendrez.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4803] = {
  {
    'E\'ko de Dentilhaço‡Э\'ко щербозубов‡E\'ko eines Splitterzahns‡톱니이빨곰의 에코‡E\'ko Dentoesquirla‡E\'ko Dentoesquirla‡L\'E\'ko des Crocs acérés‡碎齿魂精‡裂齒魂精',
    nil,
    'Em Hibérnia, tu vai topar com ursos imensos de couro bem grosso. São os ursos Dentilhaço, que tem uma resistência enorme às coisas. Se tu quiser ter resistência contra fogo, é só me trazer o E\'ko de um Dentilhaço.nnMas não te esquece, tu precisa ter as Provisões de Mau\'Ari no inventário para poder caçar E\'ko.‡В Зимних Ключах тебе встретятся большие медведи с очень толстой шкурой. Это медведи-щербозубы. Судя по тому, что они способны выдержать – отлично защищены. Если хочешь получить сопротивляемость огню, принеси мне э‘ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь э‘ко добыть.‡In Winterspring, da sin\' große Bärens mit extrem dicken Bälgens. Diese Splitterzahnbären kriegen davon so viel Schutz, dasse unheimlich viel Zeugs widerstehen könn\'. Wenn Ihr gegen Feuer auch so widerstandsfähig sein wollt, dann bringt mir das E\'ko, das Ihr von \'nem Splitterzahn kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡여명의 설원으로 가면 가죽이 엄청나게 두꺼운 큰 곰을 만나게 될 거야. 톱니이빨곰이라고 하는 이 짐승은 견뎌낼 수 있는 최대한의 자극을 스스로 가해서 엄청난 내성을 얻는 능력을 지니고 있지. 불에 대한 저항력을 얻고 싶다면 이 곰에게서 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 지니고 있어야 한다는 사실을 명심하게.‡En Cuna del Invierno encontrarás grandes osos con unas pieles extremadamente duras y gruesas. Los osos dentoesquirla obtienen mucha protección de lo que pueden resistir. Si quieres resistencia al Fuego, tráeme el E\'ko que encontrarás en los dentoesquirla.nnRecuerda, debes tener el Alijo de Mau\'ari en tu inventario para poder obtener E\'ko.‡‡Au Berceau-de-l\'Hiver, vous trouverez de grands ours à la peau très épaisse. Ces ours aux crocs acérés sont bien protégés et peuvent supporter beaucoup. Si vous souhaitez gagner la résistance au feu, apportez-moi l\'E\'ko que vous trouverez auprès des Crocs acérés.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4804] = {
  {
    'E\'ko de ventogelante‡Э\'ко стылодыхов‡E\'ko der Eiswindschimären‡서리바람 키메라의 에코‡E\'ko Orvallo‡E\'ko Orvallo‡L\'E\'ko de Noroît‡冰风魂精‡冰風魂精',
    nil,
    '‡В Зимних Ключах тебе предстоит биться с тварями, которые зовутся химеры-стылодыхами. Эти существа владеют мощной магией холода. Если хочешь обрести способность противостоять этой магии, принеси мне э\'ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь э‘ко добыть.‡In Winterspring, da müssta gegen große fliegende Kreaturens kämpfen, das sin\' de Eiswindschimären. Diese Biesties könn\' Frostmagie wirken. Wenn Ihr gegen Frost auch so widerstandsfähig sein wollt, dann bringt mir das E\'ko, das Ihr von \'ner Eiswindschimäre kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡여명의 설원으로 가면 서리바람 키메라라는 거대한 날짐승과 싸우게 될 거야. 서리바람 키메라는 냉기 마법 능력을 지니고 있지. 냉기에 대한 저항력을 얻고 싶다면 놈들에게서 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 지니고 있어야 한다는 사실을 명심하게.‡En Cuna del Invierno combatirás con unas criaturas voladoras llamadas quimeras. Esas bestias pueden dominar la magia de hielo. Si quieres ganar resistencia a la Escarcha tráeme el E\'ko que encontrarás en ellas.nnRecuerda, debes tener el Alijo de Mau\'ari en tu inventario para poder conseguir E\'ko.‡‡Au Berceau-de-l\'Hiver, vous combattrez de grandes créatures ailées nommées des Noroît. Ces bêtes peuvent se servir de la magie de glace. Si vous voulez devenir résistant à la glace, apportez-moi l\'E\'ko que vous leur prendrez.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4805] = {
  {
    'E\'ko de cardo de gelo‡Э\'ко йети‡E\'ko der Eisdistelyetis‡얼음엉겅퀴설인의 에코‡E\'ko de los Cardo Nevado‡E\'ko de los Cardo Nevado‡L\'E\'ko des Chardons de Glace‡冰草魂精‡冰草魂精',
    nil,
    '‡В Зимних Ключах тебе предстоит биться с тварями, которые зовутся йети с холмов Ледополоха. Они неповоротливы, но их толстая шкура выдерживает любые удары. Если хочешь обрести эту способность, принеси мне э\'ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь э\'ко добыть.‡In Winterspring, da müssta gegen große Kreaturens kämpfen, das sin\' de Eisdistelyetis. Diese Viecher bewegen sich nur langsam, aber se könn\' Dank dem dicken Fell \'ne Menge Prügel einstecken. Wenn Ihr auch so gut wie die Angriffen ausweich\'n wollt, dann bringt mir das E\'ko, das Ihr von ihnen kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡여명의 설원으로 가면 얼음엉겅퀴설인이라는 거대한 짐승과 싸우게 될 거야. 이 짐승은 몸놀림이 둔하지만 두꺼운 모피 덕분에 여러 차례의 충격에도 견딜 수 있지. 공격에 대한 방어력을 얻고 싶다면 이 짐승에게서 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 지니고 있어야 하지.‡‡‡Au Berceau-de-l\'Hiver, vous combattrez de grandes créatures nommées yétis Chardon de glace. Ces bêtes sont lentes mais capables d\'éviter de nombreux coups grace à l\'épaisseur de leur fourrure. Si vous voulez gagner le pouvoir d\'esquiver les attaques, apportez-moi l\'E\'ko que vous leur prendrez.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4806] = {
  {
    'E\'ko de Friomalho‡Э\'ко великанов‡E\'ko der Frosthagelriesen‡서리망치거인의 에코‡E\'ko de los Machacahielo‡E\'ko de los Machacahielo‡L\'E\'ko de Cognegivre‡霜槌魂精‡霜槌魂精',
    nil,
    'Em Hibérnia, tu vai dar de cara com uns gigantes de gelo chamados friomalho. Eles são uma montanha de força. Se tu quiser ser forte que nem um friomalho, traz pra mim o E\'ko deles.nnSe liga, tu precisa ter as provisões de Mau\'Ari no inventário para poder caçar E\'ko.‡В Зимних Ключах тебе предстоит биться с великанами ледяного молота. Они сильны и яростны. Если хочешь обрести их силу, принеси мне э‘ко, что найдешь у них.nnИ не забудь, что сокровище Мау\'ари с собой нужно носить, если хочешь э‘ко добыть.‡In Winterspring habta gegen de großen Eisriesens gekämpft, de Frosthagel. Die verlassen sich auf rohe Gewalt und Kraft. Wenn Ihr auch so stark wie \'n Frosthagelriese sein wollt, dann bringt mir das E\'ko, das Ihr von ihnen kriegt.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡이미 여명의 설원에서 서리망치거인이라는 얼음 거인을 상대한 적이 있지? 그들의 무기는 오직 순수한 힘뿐이네. 서리망치거인의 괴력을 갖고 싶다면 그들의 에코를 구해 오게.nn그리고 에코를 손에 넣으려면 마우아리의 부적을 지니고 있어야 한다는 사실을 명심하게.‡En Cuna del Invierno combatirás con unos enormes gigantes de hielo llamados Machacahielo. Suyos son el poder y la fuerza más puros. Si quieres ganar la fuerza del Machacahielo tráeme el E\'ko que encontrarás en ellos.nnRecuerda, debes tener el Alijo de Mau\'ari en tu inventario si quieres conseguir E\'ko.‡‡Au Berceau-de-l\'Hiver, vous affronterez des grands géants des glaces, les Cognegivre. Ils sont la force et la puissance incarnées. Si vous voulez vous imprégner de la force des Cognegivre, rapportez-moi les E\'kos que vous trouverez sur eux.nnSouvenez-vous, le charme de Mau\'ari doit être dans votre inventaire pour chasser les E\'kos.‡‡',
  }
},
[4807] = {
  {
    'E\'ko de coruscante‡Э\'ко диких совухов‡E\'ko der Wildekin‡올빼미야수의 에코‡E\'ko de lechúcico salvaje‡E\'ko de lechúcico salvaje‡L\'E\'ko des Indomptables‡枭兽魂精‡梟獸魂精',
    nil,
    '‡В Зимних Ключах тебе предстоит сражаться с существами, обладающими врожденной способностью к магии. Сильная магия у этих диких совухов, да, сильная... Если хочешь обрести их магию и использовать в своих целях, принеси мне э\'ко, что найдешь у них.nnИ не забудь, что с собой нужно носить сокровище Мау\'ари, если хочешь э‘ко добыть.‡In Winterspring, da müssta gegen Kreaturens kämpfen, die ham anscheinend angeborene magische Fertigkeitens. Diese Wildekinses könn\' echt starke Magie anwenden. Wenn Ihr Euren Intellekt erweitern wollt, dann bringt mir das E\'ko von allen denen Eulenbiesters, die Ihr dort findet.nnNich\' vergessen: Ihr müsst \'n Behälter von Mau\'ari in Eurem Inventar haben, wenn Ihr Euch E\'ko schnappen wollt.‡‡En Cuna del Invierno, combatirás con unas criaturas que parecen tener una habilidad mágica innata. Los lechúcicos pueden utilizar magia muy poderosa. Si quieres aumentar tu intelecto tráeme el E\'ko que encontrarás en las lechubestias.nnRecuerda, debes tener el Alijo de Mau\'ari en tu inventario si quieres obtener E\'ko.‡‡Au Berceau-de-l\'Hiver, vous combattrez des créatures qui semblent posséder des pouvoirs magiques innés. Ces Indomptables sont dotés de grands pouvoirs magiques. Si vous voulez voir votre intelligence augmenter, apportez-moi l\'E\'ko que vous trouverez sur l\'un de ces chouettards.nnSouvenez-vous, il vous faut la cache de Mau\'ari dans votre inventaire si vous voulez chasser l\'E\'ko.‡‡',
  }
},
[4808] = {
  {
    'Felnok Molaço‡Фелнок Сталлист‡Felnok Stahlfeder‡펠노크 스틸스프링‡Felnok Acerovera‡Felnok Acerovera‡Felnok Ressordacier‡菲诺克‡菲諾克',
    nil,
    'Leve a Carta de Vera para Felnok Molaço.‡Отнесите письмо Тинки Фелноку Сталлисту.‡Gebt Felnok Stahlfeder Tinkees Brief.‡팅키의 편지를 펠노크 윈터스프링에게 가져다주어야 합니다.‡Entrégale la carta de Tinkee a Felnok Acerovera.‡Entrégale la carta de Tinkee a Felnok Acerovera en Vista Eterna, en Cuna del Invierno.‡Donner la Lettre de Brikolette à Felnok Ressordacier.‡把丁奇的信交给菲诺克。‡把丁奇的信交給菲諾克。',
  }
},
[4809] = {
  {
    'Chifres de ventogelante‡Рога стылодыхов‡Hörner der Eiswindschimären‡서리바람 키메라의 뿔‡Cuernos de Orvallo‡Cuernos de Orvallo‡Cornes de Noroît‡冰风奇美拉角‡冰風奇美拉角',
    nil,
    'Leve 8 Chifres Inteiriços de Quimera Ventogelante para Felnok Molaço.‡Принесите 8 безупречных рогов стылодыха Фелноку Сталлисту.‡Bringt Felnok Stahlfeder 8 unbeschädigte Hörner einer Eiswindschimäre.‡펠노크 윈터스프링에게 온전한 서리바람 키메라의 뿔 8개를 가져가야 합니다.‡Llévale 8 cuernos de quimera del Orvallo intactos a Felnok Acerovera.‡Reúne 8 cuernos de quimera del Orvallo.‡Apporter 8 Cornes intactes de Noroît à Felnok Ressordacier.‡将8支完整的冰风奇美拉角交给菲诺克。‡將8支完整的冰風奇美拉角交給菲諾克。',
  }
},
[4810] = {
  {
    'Fale novamente com Vera‡Возвращение к Тинки‡Rückkehr zu Tinkee‡팅키에게 돌아가는 길‡Vuelve con Tinkee‡Regresa junto a Tinkee‡Retourner voir Brikolette‡返回丁奇身边‡返回丁奇身邊',
    nil,
    'Leve o Pacote do Felnok para Vera Brequim, nas Estepes Ardentes.‡Отнесите ящик Фелнока Тинки Кипеллер в Пылающие степи.‡Bringt Tinkee Kesseldampf in der brennenden Steppe Felnoks Paket.‡불타는 평원의 팅키 스팀보일에게 펠노크의 소포를 가져가야 합니다.‡Llévale el paquete de Felnok a Tinkee Vaporio en Las Estepas Ardientes.‡Llévale el paquete de Felnok a Tinkee Vaporio en el Peñasco Llamarada en Las Estepas Ardientes.‡Apporter le Paquet de Felnok à Brikolette Toutevapeur dans les Steppes ardentes.‡把菲诺克的包裹交给燃烧平原的丁奇·斯迪波尔。‡把菲諾克的包裹交給燃燒平原的丁奇·斯迪波爾。',
  }
},
[4811] = {
  {
    'O cristal vermelho‡Красный кристалл‡Der rote Kristall‡붉은 수정‡El cristal rojo‡El cristal rojo‡Le cristal rouge‡红色水晶‡紅色水晶',
    nil,
    'Viaje para o leste de Auberdine e procure por um grande cristal vermelho na montanha leste da Costa Negra. Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Направляйтесь на восток от Аубердина и поищите большой красный кристалл в горной гряде на востоке Темного Берега. Вернитесь с докладом к часовому Глинде Нал\'Шие в Аубердин.‡Reist von Auberdine nach Osten und sucht nach einem großen, roten Kristall entlang der östlichen Bergkette von Dunkelküste. Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡어둠의 해안의 동쪽 산맥을 따라 아우버다인 동쪽으로 가서 거대한 붉은 수정을 찾은 다음 아우버다인에 있는 파수꾼 글린다 날셰에게 보고해야 합니다.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Voyager en direction de l\'est en partant d\'Auberdine et chercher un gros cristal rouge le long de la chaîne de montagne est de Sombrivage. Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡到奥伯丁的东边去，沿着黑海岸东部边界的山脉寻找一颗巨大的红色水晶，然后向奥伯丁的哨兵戈琳达·纳希恩汇报你的发现。‡到奧伯丁的東邊去，沿著黑海岸東部邊界的山脈尋找一顆巨大的紅色水晶，然後向奧伯丁的哨兵戈琳達·納希恩彙報你的發現。',
  }
},
[4812] = {
  {
    'Como cascatas‡Пока струится вода...‡Wenn das Wasser fließt‡수정에 물이 흐르면‡Agua en cascada‡Agua en cascada‡Comme l\'eau tombe en cascade‡清洗水晶‡清洗水晶',
    nil,
    'Encha o Tubo de Água Vazio no poço lunar de Auberdine, e depois investigue o cristal vermelho na encosta da montanha leste da Costa Negra.‡Наполните пустую колбу для воды в лунном колодце Аубердина, а затем исследуйте красный кристалл, находящийся в горной гряде на востоке Темного Берега.‡Füllt die leere Wasserröhre am Mondbrunnen von Auberdine und untersucht dann den roten Kristall an der östlichen Bergkette von Dunkelküste.‡빈 시험관에 아우버다인의 달샘 물을 채운 후 어둠의해안의 동쪽 산에 있는 붉은 수정을 찾아 조사하십시오.‡Llena el tubo de agua vacío en la Poza de la Luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Llena el tubo de agua vacío en la Poza de la Luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Remplir le Tube d\'eau vide au Puits de lune d\'Auberdine, puis chercher le cristal rouge le long des falaises des montagnes à l\'est de Sombrivage.‡在奥伯丁月亮井中把空水瓶装满，然后调查黑海岸东部山脉的红水晶。‡在奧伯丁月井中把空水瓶裝滿，然後調查黑海岸東部山脈的紅水晶。',
  }
},
[4813] = {
  {
    'Fragmentos incrustados‡Скрытые фрагменты‡Die Fragmente im Inneren‡수정 안의 뼈‡Los trozos del interior‡Los trozos del interior‡Les fragments à l\'intérieur‡水晶中的碎骨‡水晶中的碎骨',
    nil,
    'Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Доложите о результатах ваших изысканий часовому Глинде Нал\'Шие в Аубердине.‡Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡아우버다인에 있는 파수꾼 글린다 날셰에게 알아 낸 사실을 보고해야 합니다.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡向奥伯丁的哨兵哨兵戈琳达·纳希恩报告你的发现。‡向奧伯丁的哨兵哨兵戈琳達·納希恩報告你的發現。',
  }
},
[4821] = {
  {
    'Ovo alienígena‡Странное яйцо‡Fremdartiges Ei‡괴상한 알‡Un huevo extraño‡Un huevo extraño‡L\'œuf étrange‡异型卵‡異型卵',
    nil,
    'Leve o Ovo Alienígena a Hagar Casco de Raio, na Aldeia Vento Livre.‡Принесите неизвестное яйцо Хагару Грозовому Копыту на Заставу Вольного Ветра.‡Bringt Hagar Blitzhuf am Freiwindposten das fremdartige Ei.‡높새바람 봉우리에 있는 하가르 라이트닝후프에게 괴상한 알을 가져가야 합니다.‡Devuélvele el huevo extraño a Hagar Tronapezuña, que está en el Poblado Viento Libre.‡Devuélvele el huevo extraño a Hagar Pezuña del Rayo, que está en el Poblado Viento Libre.‡Rapporter l\'Œuf étrange à Hagar Sabot-de-foudre au Poste de Librevent.‡把异型卵交给乱风岗的哈加尔·雷蹄。‡把異型卵交給亂風崗的哈加爾·雷蹄。',
  }
},
[4822] = {
  {
    'Olha o sorvete!‡Женщинам – цветы, детям -...‡Lecker Eis‡아이스크림, 아이스크림‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace !‡草莓冰激凌‡',
    nil,
    'Consiga um pouco de Sorvete de Morango para o órfão. Ele parece gostar de sorvete da marca Tigule e Foror.‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуле и Форора.‡Besorgt für Euren Schützling etwas Erdbeereis. Der kleine scheint die Marke \'Tigule und Forors Eiscreme\' zu bevorzugen.‡돌보고 있는 아이에게 딸기 아이스크림을 가져다줘야 합니다. 랜디스는 티굴과 폴로르의 딸기 아이스크림을 좋아하는 것 같습니다.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Allez chercher de la Glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor & Dagharn.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢“提古勒和弗洛尔”牌的草莓冰激凌。‡',
  }
},
[4841] = {
  {
    'Pacifique o Centauro‡Упокоение кентавров‡Befriedung der Zentauren‡켄타우로스 처치‡Apaciguar al centauro‡Apaciguar al centauro‡Pacifier les centaures‡清除半人马‡清除半人馬',
    nil,
    'Mate 12 Batedores Galath, 10 Cavalgantes Galath e 6 Ventilhões Galath, depois fale novamente com o Vigia do Rochedo Chifre Longo na Aldeia Vento Livre.‡Убейте 12 разведчиков, 10 пастухов и 6 ветроловок из племени Галак, после чего вернитесь к дозорному утесов Долгорогу на Заставу Вольного Ветра.‡Tötet 12 Späher der Galak, 10 Zänker der Galak sowie 6 Windjäger der Galak und kehrt dann zu Klippenbehüter Langhorn am Freiwindposten zurück.‡갈라크일족 척후병 12명, 갈라크일족 사냥꾼 10명, 갈라크일족 바람전사 6명을 처치한 후, 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 돌아가야 합니다.‡Mata a 12 exploradores Galak, 10 vaqueros Galak y 6 cazavientos Galak, y después ve a ver de nuevo a Vigiarisco Cuernolargo al Poblado Viento Libre.‡Mata a 12 exploradores Galak, 10 retadores Galak y 6 cazavientos Galak, y después ve a ver de nuevo al vigiarrisco Cuerno Largo al Poblado Viento Libre.‡Tuer 12 Eclaireurs galak, 10 Querelleurs galak, et 6 Chasse-vent galak, puis retourner auprès du garde-falaise Longue-corne au Poste de Librevent.‡杀掉12个加拉克斥候、10个加拉克争斗者和6个加拉克逐风者，然后向乱风岗的峭壁卫兵图林·长角复命。‡殺掉12個加拉克斥候、10個加拉克爭吵者和6個加拉克逐風者，然後向亂風崗的峭壁衛兵圖林·長角覆命。',
  }
},
[4842] = {
  {
    'Fontes estranhas‡Выяснение причин‡Sonderbare Quellen‡이상한 근원‡Fuentes extrañas‡Fuentes extrañas‡Sources étranges‡奇怪的源头‡奇怪的源頭',
    nil,
    'Siga as instruções de Bruna Covaneve, depois fale novamente com ela.‡Последуйте указаниям Доновы Снегоноры, а затем вернитесь к ней.‡Befolgt Donova Schneewehs Anweisungen und meldet Euch dann wieder bei ihr.‡도노바 스노우덴의 지시를 따라 탐색을 한 후 되돌아오십시오.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Suivre les instructions de Donova Antreneige, puis faire un rapport.‡根据多诺瓦·雪山的指示行动，然后回到她那里报告。‡根據多諾瓦·雪山的指示行動，然後回到她那裡報告。',
  }
},
[4861] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre o acampamento destruído e os suprimentos de Jaron Moldapedra na parte sul de Hibérnia.‡Найдите разоренный лагерь Джерона Гранильщика и его припасы на юге Зимних Ключей.‡Findet Jaron Steinschleifers ruiniertes Lager samt dessen Vorräte im südlichen Winterquell.‡여명의 설원 남부 지역에서 야론 스톤셰이퍼의 야영지를 찾아서 부서진 보급품 상자를 되찾아 와야 합니다.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiser le camp démoli et les fournitures de Jaron Sculptepierre, au sud du Berceau-de-l\'Hiver.‡在冬泉谷的南部寻找加隆·石矛的被破坏的营帐，以及他的补给物资。‡在冬泉谷的南部尋找加隆·石矛的被破壞的營帳，以及他的補給物資。',
  }
},
[4862] = {
  {
    'Nojento!‡Товар на любителя‡Be-Öh-Es-Eh‡더러운 거미알‡Bestia amaestrada‡Bestia amaestrada‡Mauvais‡蜘蛛卵‡蜘蛛卵',
    nil,
    'Vá para o Pico da Rocha Negra e colete 15 Ovos de Aranha do Pináculo para Kibler.nnPelo nome, é de se pensar que eles fiquem perto das aranhas.‡Отправьтесь на пик Черной горы и принесите Киблеру 15 яиц скального паука.nnСудя по всему, яйца надо искать недалеко от пауков.‡Reist zur Schwarzfelsspitze und sammelt 15 Spitzenspinneneier für Kibler.nnLogischerweise müsstet Ihr diese Eier in der Nähe von Spinnen finden.‡검은바위 첨탑으로 가서 키블러를 위해 첨탑 거미알 15개를 수집해야 합니다.nn들리는 소문으로는 그 알들은 거미들이 서식하는 근처에서 찾을 수 있다고 합니다.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.nnYo diría que se pueden encontrar estos huevos cerca de arañas.|n‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|nYo diría que se pueden encontrar estos huevos cerca de arañas.‡Aller au Pic Rochenoire et ramasser 15 Œufs d\'araignée du pic pour Kibler.nnCes œufs peuvent être trouvés à proximité des araignées.‡到黑石塔去为基布雷尔收集15枚尖塔蜘蛛卵。nn听说那些蜘蛛周围有许多这样的卵。‡到黑石塔去為基布雷爾收集15枚尖塔蜘蛛卵。|n聽說那些蜘蛛周圍有許多這樣的卵。',
  }
},
[4863] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre a carroça destruída de Jaron Moldapedra.‡Найдите опрокинутый фургон Джерона Гранильщика.‡Sucht Jaron Steinschleifers zerstörten Wagen.‡야론 스톤셰이퍼의 부서진 마차를 찾아야 합니다.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Trouver le chariot saccagé de Jaron Stoneshaper.‡找到加隆·石矛的马车。‡找到加隆·石矛的馬車。',
  }
},
[4864] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Pegue os Suprimentos do Jaron na neve, depois encontre o coruscante que roubou o amuleto de que Jaron falou.nnEntregue os Suprimentos do Jaron e o Amuleto de Penas Azuis para Jaron Moldapedra na cabana, em Hibérnia.‡Подберите припасы Джерона из снега, и найдите дикого совуха, похитившего амулет, о котором говорил Джерон.nnПринесите припасы и ожерелье миних перьев Джерону Гранильщику в его дом в Зимних Ключах.‡Klaubt Jarons Ladung aus dem Schnee und sucht dann die Wildekin, die das Amulett gestohlen haben, von dem Jaron gesprochen hatte.nnBringt Jaron Steinschleifer in der Lodge in Winterquell dessen Ladung und das blaugefiederte Amulett.‡눈 속에서 야론의 보급품을 회수한 다음, 야론이 찾는 아뮬렛을 훔친 올빼미야수들을 찾아야 합니다.nn여명의 설원, 별똥별 마을에 있는 야론 스톤셰이퍼에게 야론의 보급품과 푸른 깃털달린 아뮬렛을 갖다주어야 합니다.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.nnLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Ramasser les Fournitures de Jaron dans la neige, puis trouver l\'Indomptable qui a volé l\'amulette dont Jaron a parlé.nnRapporter les fournitures de Jaron et l\'Amulette de la plume bleue à Jaron Sculptepierre dans son pavillon au Berceau-de-l\'Hiver.‡从雪地中拾起加隆的补给物资，然后寻找盗取加隆所说的护符的枭兽。nn将加隆的补给物资和蓝色羽毛护符交给冬泉谷的加隆·石矛。‡從雪地中拾起加隆的補給物資，然後尋找加隆所說偷走護符的梟獸。|n將加隆的補給物資和藍色羽毛護符交給冬泉谷小屋的加隆·石矛。',
  }
},
[4865] = {
  {
    'Selva da serpente‡Змеиная дикость‡Wilde Schlange‡뱀의 복수‡Venganza‡Venganza‡Serpent sauvage‡狂热之蛇‡',
    nil,
    'Relate suas descobertas a Motega Barba de Fogo.‡Расскажите о найденном Мотеге Огненной Гриве.‡Berichtet Motega Feuermähne von Euren Entdeckungen.‡발견한 사실을 모테가 파이어메인에게 보고해야 합니다.‡Cuéntale a Motega Pirocabello lo que has descubierto.‡Cuéntale lo que has descubierto a Motega Crin de Fuego en el Campamento del Tramo Blanco, en Las Mil Agujas.‡Faire un rapport de vos trouvailles à Motega Crin-de-feu.‡向莫特加·火鬃汇报你的发现。‡',
  }
},
[4866] = {
  {
    'Leite materno‡Материнское молоко‡Muttermilch‡여왕 거미의 독‡La leche de la madre‡La leche de la madre‡Le lait matriarcal‡蛛后的乳汁‡蛛后的乳汁',
    nil,
    'No coração do Pico da Rocha Negra você vai encontrar a Mãe Queimateia. Chame a atenção dela e deixe-a envenenar você. É bem provável que você precise matá-la também. Fale novamente com João Roto depois que for envenenad<o/a> para que ele possa "ordenhar" você.‡Найдите в самом сердце пика Черной горы мать Дымную Паутину. Сражайтесь с ней, пока она не введет вам свой яд. Скорее всего ее также придется убить. Когда яд будет в вас, вернитесь к Джону-Оборванцу, чтобы он смог добыть яд.‡Ihr findet Mutter Glimmernetz im Herzen der Schwarzfelsspitze. Kämpft mit ihr und bringt sie dazu, Euch zu vergiften. Es kann gut sein, dass Ihr sie sogar töten müsst. Kehrt zum struppigen John zurück, sobald Ihr vergiftet seid, damit er Euch \'melken\' kann.‡검은바위 첨탑 중심부에서 여왕 불그물거미를 찾을 수 있습니다. 여왕 불그물거미를 공격하거나 접근하여 그 독에 중독되어야 합니다. 독에 걸릴 확률을 높이기 위해서는 거미를 죽여야 할 수도 있습니다. 중독되면 털보 존에게 돌아가서 그가 그 독을 추출하게 해야 합니다.‡En el corazón de la Cumbre de Roca Negra encontrarás a Madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡En el corazón de la Cumbre de Roca Negra encontrarás a la madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡Vous trouverez la Matriarche Couveuse au cœur du pic Rochenoire. Attaquez-la et poussez-la à vous empoisonner. Vous devrez sans doute la tuer. Une fois <empoisonné/empoisonnée>, trouvez John le Loqueteux afin qu\'il puisse prélever un échantillon.‡你可以在黑石塔的中心地带找到烟网蛛后。与她战斗，让她在你体内注入毒汁。如果你有能力的话，就杀死她吧。当你中毒之后，回到狼狈不堪的约翰那儿，他会从你的身体里抽取这些"蛛后的乳汁"。‡你可以在黑石塔的中心地帶找到煙網蛛后。與她戰鬥，讓她在你體內注入毒汁。如果你有能力的話，就殺死她吧。當你中毒之後，回到狼狽不堪的約翰那兒，他會從你的身體裡抽取這些「蛛后的乳汁」。',
  }
},
[4867] = {
  {
    'Urok Uivo-da-ruína‡Аррок Смертный Вопль‡Urok Schreckensbote‡우로크 둠하울‡Urok Aullapocalipsis‡Urok Aullasino‡Urok Hurleruine‡乌洛克‡烏洛克',
    nil,
    'Leia o Pergaminho do Warosh. Traga o Mojo do Warosh para Warosh.‡Прочитайте записку Вароша. Принесите Варошу его амулет.‡Lest Waroshs Rolle. Bringt Waroshs Mojo zu Warosh.‡와로쉬의 두루마리를 읽어야 합니다. 와로쉬에게 그의 부적을 가져가야 합니다.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lire le Parchemin de Warosh. Apporter le Mojo de Warosh à Warosh.‡阅读瓦罗什的卷轴。将瓦罗什的蟑螂交给他。‡閱讀瓦羅什的卷軸。將瓦羅什的魔精交給他。',
  }
},
[4881] = {
  {
    'Plano de assassinato‡Убийственный заговор‡Auftragsmordplan‡암살 음모‡Complot de asesinato‡Complot de asesinato‡Complot d\'assassinat‡暗杀计划‡暗殺計畫',
    nil,
    'Alerte Kanati Nuvem Cinzenta, no Posto Confinalvo, do plano para assassiná-lo.‡Предупредите Канати Серое Облако на заставе Белого Плеса, что на него готовится покушение.‡Warnt Kanati Grauwolke am Weißgipfelposten, dass man vorhat, ihn zu töten.‡백사장 야영지에 있는 카나티 그레이클라우드에게 가서 암살 음모에 대해 경고해 주어야 합니다.‡Avisa a Kanati Nubegris, que está en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Avisa a Kanati Nube Gris, en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Prévenir Kanati Nuage-gris au Poste de Blanc-relais qu\'un complot le menace.‡将暗杀计划通知给白沙岗哨的卡纳提·灰云。‡將暗殺計畫通知給白沙崗哨的卡納提·灰雲。',
  }
},
[4882] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewachen‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡守護秘密',
    nil,
    'Leve o Colar de Penas Azuis para Trull Ruinazar, no Posto Peçonha.‡Отнесите ожерелье синих перьев Труллу Баловню Судьбы на заставу Отравленной Крови.‡Bringt Trull Scheiterbann beim Blutgiftposten das blaugefiederte Amulett.‡피멍울 초소에 있는 트룰 페일베인에게 푸른 깃털달린 목걸이를 갖다주어야 합니다.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Apporter le Collier de plumes bleues à Trull Faillemort au Poste de la Vénéneuse.‡把蓝羽项链交给血毒岗哨的特鲁尔-法贝恩。‡把藍羽項鍊交給血毒崗哨的特盧爾·法貝恩。',
  }
},
[4883] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewahren‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡守護秘密',
    nil,
    'Leve o Colar de Penas Azuis para Nara Juba Agreste.‡Отнесите ожерелье синих перьев Наре Буйногривой.‡Bringt Nara Wildmähne das blaugefiederte Amulett.‡푸른 깃털달린 목걸이를 나라 와일드메인에게 갖다주어야 합니다.‡Lleva el Collar de plumas azules a Nara Bravacrín.‡Lleva el Collar de plumas azules a Nara Ferocrín.‡Apporter le Collier de plumes bleues à Nara Crin-sauvage.‡把蓝羽项链交给纳拉-蛮鬃。‡把藍羽項鍊交給納拉·蠻鬃。',
  }
},
[4901] = {
  {
    'Guardiões do altar‡Стражи алтаря‡Wächter des Altars‡제단의 수호자‡Guardianes del altar‡Guardianes del altar‡Les gardiens de l\'autel‡祭坛守护者‡祭壇守護者',
    nil,
    'Proteja Ranshalla enquanto ela tenta reativar o Altar de Eluna. Relate suas descobertas a Erelas Ambarcéu, na Vila de Rut\'theran.‡Защитите Раншаллу, пока она пытается активировать алтарь Элуны. Сообщите о ваших находках Эреласу Янтарному Небу в деревне Рут\'теран.‡Schützt Ranshalla, während sie versucht, den Altar von Elune wieder zu aktivieren. Berichtet Erelas Himmelsbern in Rut\'theran von Eurem Fund.‡엘룬의 제단을 여는 과정에서 란샬라를 보호해야 합니다. 성공하면 루테란 마을에 있는 에렐라스 앰버스카이에게 발견한 내용을 보고해야 합니다.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Erelas Cieloámbar de Aldea Rut\'theran.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Erelas Cieloámbar de Aldea Rut\'theran.‡Protéger Ranshalla pendant qu\'elle s\'efforce de réactiver l\'Autel d\'Elune. Faire un rapport de vos découvertes à Erelas Ambreciel, au village de Rut\'theran.‡在兰莎尔拉尝试激活艾露恩祭坛的过程中保护她。然后将你的发现报告给鲁瑟兰村的艾瑞拉斯·琥珀。‡在蘭莎爾拉嘗試啟動伊露恩祭壇的過程中保護她。然後將你的發現報告給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[4902] = {
  {
    'Coruscante de Eluna‡Питомцы Элуны‡Wildekin von Elune‡엘룬의 올빼미야수‡Lechúcico salvaje de Elune‡Lechúcico salvaje de Elune‡Les Indomptables d\'Elune‡艾露恩的枭兽‡伊露恩的梟獸',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada de Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure, à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[4903] = {
  {
    'O comando do Senhor da Guerra‡Приказ полководца‡Befehl des Kriegsherrn‡장군의 명령‡La orden del Señor de la Guerra‡La orden del Señor de la Guerra‡Ordre du chef de guerre‡高图斯的命令‡高圖斯的命令',
    nil,
    'Mate o Grão-lorde Omokk, o Senhor da Guerra Voone e o Lorde Supremo Wyrmthalak. Recupere Documentos Importantes dos Rocha Negra. Fale novamente com o Senhor da Guerra Trincador, em Karrath, quanto a missão tiver sido cumprida.‡Убейте вождя Омокка, воеводу Вуна и повелителя Змейталака. Найденные при них важные бумаги Черной горы доставьте полководцу Клинозубу в Каргат.‡Tötet Hochlord Omokk, Kriegsmeister Voone und Oberanführer Wyrmthalak. Findet die wichtigen Schwarzfelsdokumente. Kehrt zum Kriegsherrn Bluthauer nach Kargath zurück, sobald Ihr diese Mission erledigt habt.‡대군주 오모크와 대장군 부네, 대군주 웜타라크를 처단해야 합니다. 검은바위의 중요한 문서들을 확보해야 합니다. 임무를 완수하는 대로 카르가스의 장군 고어투스에게로 돌아가야 합니다.‡Mata al Alto señor Omokk, al maestro de guerra Voone y al Señor Supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Mata al alto señor Omokk, al maestro de guerra Voone y al señor supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Tuer le généralissime Omokk, le maître de guerre Voone et le seigneur Wyrmthalak. Récupérer les Importants documents Rochenoire. Retourner voir le chef de guerre Sangredent à Kargath une fois la mission accomplie.‡杀死欧莫克大王、指挥官沃恩和维姆萨拉克。找到重要的黑石文件，然后向卡加斯的军官高图斯汇报。‡殺死歐莫克大王、指揮官沃恩和維姆薩拉克主宰。找到重要的黑石文件，然後向卡加斯的督軍高圖斯彙報。',
  }
},
[4904] = {
  {
    'Liberdade, liberdade‡Долгожданная свобода‡Endlich frei‡마침내 자유를‡Al fin libre‡Al fin libre‡Libre, enfin !‡终获自由‡終獲自由',
    nil,
    'Escolte Lakota Cantéolo para fora do Pináculo da Nuvem Negra e depois fale com Thalia Couro Âmbar, na Aldeia Vento Livre.‡Выведите Лакоту Песню Ветра с Пика Темного Облака, а потом поговорите с Талией Янтарной Шкурой на Заставе Вольного Ветра.‡Geleitet Lakota Windweise vom Düsterwolkengipfel hinab und sprecht dann im Freiwindposten mit Thalia Bernhaut.‡라코타 윈드송을 먹구름 봉우리에서 구출한 후, 높새바람 봉우리에 있는 탈리아 앰버하이드와 대화해야 합니다.‡Saca a Lakota Murmullo de Cumbre de la Nube Negra y después habla con Thalia Pielámbar, que está en el Poblado Viento Libre.‡Saca a Lakota Son del Viento de Cumbre de la Nube Negra y después habla con Thalia Ocultaámbar, que está en el Poblado Viento Libre.‡Escorter Lakota Chant-du-vent hors de la Cime de Noir-nuage, puis parler à Thalia Peau-d\'ambre au Poste de Librevent.‡护送拉克塔·风歌离开恐怖图腾营地，然后与乱风岗的萨利亚谈一谈。‡護送拉克塔·風歌離開恐怖圖騰營地，然後與亂風崗的薩利亞談話。',
  }
},
[4905] = {
  {
    '‡‡‡‡‡‡‡‡<UNUSED>',
    nil,
    nil,
  }
},
[4906] = {
  {
    'Mais corrupção‡Снова порча!‡Weitere Verderbnis‡오염의 확산‡Más corrupción‡Más corrupción‡Plus de corruption‡更深重的堕落‡更深重的墮落',
    nil,
    'Eridan Brisazul, na Selva Maleva, quer que você mate 8 Infernarautos Flamejade, 8 Traidores Flamejade, 8 Trapaceiros Flamejade e Xavaric. Fale novamente com Eridan quando a tarefa estiver concluída.‡Эридана Грусть Ветра из Оскверненного леса просит вас убить 8 призывателей огня, 8 предателей и 8 плутов из племени Нефритового огня, а также Ксаварика. По выполнении задания возвращайтесь к Эридане.‡Eridan Blauwind im Teufelswald möchte, dass Ihr Xavaric sowie 8 Jadefeuerhöllenrufer, 8 Jadefeuerverräter und 8 Jadefeuerschwindler tötet. Kehrt zu Eridan zurück, sobald Ihr die Aufgabe erfüllt habt.‡에리단 블루윈드를 위해 비취불꽃 지옥소환사 8명과 배반자 8명, 그리고 요술사 8명과 사바릭을 처단해야 합니다. 임무가 완수되는 대로 에리단에게 돌아가십시오.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Ventebleu de Gangrebois veut que vous tuiez 8 Implorateurs de l\'enfer Jadefeu, 8 Traîtres Jadefeu, 8 Entourloupeurs Jadefeu et Xavaric. Revenez auprès d\'Eridan une fois la tâche accomplie.‡费伍德森林的艾瑞丹·蓝风要你去杀掉8个碧火唤魔者、8个碧火背叛者、8个碧火欺诈者和萨瓦里克。任务完成之后回到艾瑞丹那里复命。‡費伍德森林的艾瑞丹·藍風要你去殺掉8個碧火喚魔者、8個碧火背叛者、8個碧火欺詐者和薩瓦里克。任務完成之後回到艾瑞丹那裡覆命。',
  }
},
[4907] = {
  {
    'Vera Brequim‡Тинки Кипеллер‡Tinkee Kesseldampf‡팅키 스팀보일‡Tinkee Vaporio‡Tinkee Vaporio‡Tinkee Steamboil‡丁奇·斯迪波尔‡丁奇·斯迪波爾',
    nil,
    'Fale com Vera Brequim.‡Поговорите с Тинки Кипеллер.‡Sprecht mit Tinkee Kesseldampf.‡팅키 스팀보일과 대화해야 합니다.‡Habla con Tinkee Vaporio.‡Habla con Tinkee Vaporio en el Peñasco Llamarada, en las Estepas Ardientes.‡Parler à Brikolette Toutevapeur.‡与丁奇·斯迪波尔谈一谈。‡與丁奇·斯迪波爾談話。',
  }
},
[4921] = {
  {
    'Perdida em combate‡Пропавшая без вести‡In der Schlacht vermisst‡전쟁으로 잃은 아내‡Perdida en la batalla‡Perdida en la batalla‡Disparition au combat‡在战斗中失踪‡在戰鬥中失蹤',
    nil,
    'Encontre a Mulher de Mankrik e depois fale novamente com ele na Encruzilhada.‡Отыщите жену Манкрика и возвращайтесь к нему в Перекресток.‡Sucht Mankriks Frau und kehrt dann zu ihm in die Siedlung beim Wegekreuz zurück.‡크로스로드에 있는 만크릭을 위해 그의 아내의 흔적을 찾아 돌아가야 합니다.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Trouver la femme de Mankrik puis retourner le voir à la Croisée.‡找到曼科里克的妻子，然后回到十字路口找他。‡找到曼寇里克的妻子，然後回到十字路口找他。',
  }
},
[4941] = {
  {
    'A sabedoria de Eitrigg‡Мудрость Эйтригга‡Etriggs Weisheit‡아이트리그의 지혜‡La sabiduría de Eitrigg‡La sabiduría de Eitrigg‡Sagesse d\'Eitrigg‡伊崔格的智慧‡伊崔格的智慧',
    nil,
    'Fale com Eitrigg em Orgrimmar. Quando tiver discutido o assunto com Eitrigg, busque o conselho de Thrall.nnVocê se lembra de ter visto Eitrigg nos aposentos de Thrall.‡Поговорите с Эйтриггом в Оргриммаре. После этого обратитесь к вождю Траллу. nnВ последний раз Эйтригг был в в зале приемов Тралла.‡Sprecht mit Etrigg in Orgrimmar. Wenn Ihr die Angelegenheit mit Etrigg besprochen habt, bittet Thrall um Rat.nnIhr erinnert Euch, dass Ihr Etrigg in Thralls Gemächern gesehen habt.‡오그리마의 스랄의 요새에 있는 아이트리그와 대화해야 합니다. 아이트리그의 얘기를 듣고 난 후에는 대족장 스랄과 상의해야 합니다.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.nnRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.|nRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Parler à Eitrigg, à Orgrimmar. Après avoir discuté avec Eitrigg, demander conseil à Thrall.nnVous avez déjà vu Eitrigg dans les Appartements de Thrall.‡和奥格瑞玛的伊崔格谈一谈。讨论完毕后，咨询萨尔的意见。nn你回忆起曾在萨尔的大厅中见过伊崔格。‡和奧格瑪的伊崔格談話。討論完畢後，諮詢索爾的意見。|n你回憶起曾在索爾的大廳中見過伊崔格。',
  }
},
[4961] = {
  {
    'A purificação do Orbe de Orahil‡Очищение шара Орахила‡Die Säuberung der Kugel von Orahil‡오라힐 보주의 정화‡La purificación del orbe de Orahil‡La purificación del orbe de Orahil‡La purification de l\'Orbe d\'Orahil‡奥拉赫宝珠的净化‡',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화하십시오.‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuer le Démon de l\'Orbe, puis parler à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡',
  }
},
[4962] = {
  {
    'Estilhaço de canisvil‡Осколок гончей Скверны‡Splitter eines Teufelshundes‡지옥사냥개의 영혼‡Fragmento de can manáfago‡Fragmento de can manáfago‡Un éclat de gangrechien‡地狱犬的灵魂‡惡魔犬的靈魂',
    nil,
    'Pegue o Rubi de Felhas e use-o em um dos Canisvis encontrados em Desolação. Depois de conseguir, leve o Rubi de Felhas e o Espírito de Canisvil Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите рубин Сквернолова и поймайте в него одну из гончих скверны в Пустошах. Добившись успеха, отнесите плененный дух Гончей Скверны и рубин Сквернолова Менаре Расщепительнице Бездны из Степей.‡Nehmt den Teufelsrubin und benutzt ihn bei einem der Teufelshunde von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Leerbringer im Brachland den eingekerkerten Teufelshundgeist und den Teufelsrubin.‡지옥의 루비를 가지고 가서 잊혀진 땅에 서식하는 지옥사냥개 중 한 마리에게 사용해야 합니다. 성공하면 지옥의 루비와 사로잡은 지옥사냥개의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago capturado a Menara Nadiz en Los Baldíos.‡Coge el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago encarcelado a Menara Nadiz en Los Baldíos.‡Prendre le Rubis de Felhas et l\'utiliser sur l\'un des gangrechiens de Désolace. Quand vous aurez réussi, rapporter le Rubis de Felhas et l\'Esprit de gangrechien emprisonné à Menara Taillevide, dans les Tarides.‡带上地狱犬红宝石到凄凉之地去，用它捕获一只地狱犬的灵魂。成功之后，将地狱犬红宝石和被禁锢的地狱犬灵魂交给贫瘠之地的梅纳拉·沃伦德。‡帶上惡魔犬紅寶石到淒涼之地去，用它捕獲一隻惡魔犬的靈魂。成功之後，將惡魔犬紅寶石和被禁錮的惡魔犬靈魂交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4963] = {
  {
    'Estilhaço de infernal‡Осколок инфернала‡Splitter einer Höllenbestie‡지옥불정령의 영혼‡Fragmento de infernal‡Fragmento de infernal‡Eclat d\'Infernal‡地狱火的灵魂‡地獄火的靈魂',
    nil,
    'Pegue a Esmeralda Infusa e use-a em um dos Infernais encontrados em Desolação. Depois de conseguir, leve a Esmeralda Infusa e o Espírito de Infernal Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите Пылающий изумруд и поймайте в него одного из инферналов в Пустошах. Добившись успеха, отнесите плененный дух инфернала и пылающий изумруд Менаре Расщепительнице Бездны из Степей.‡Nehmt den Infussmaragd und benutzt ihn bei einer der Höllenbestien von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Leerbringer im Brachland den eingekerkerten Höllenbestiengeist und den Infussmaragd.‡지옥불 에메랄드를 가지고 가서 잊혀진 땅의 지옥불정령 중 하나에게 사용해 영혼을 사로 잡아야 합니다. 성공하면 지옥불 에메랄드와 사로잡은 지옥불정령의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal capturado a Menara Nadiz en Los Baldíos.‡Coge la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal encarcelado a Menara Nadiz en Los Baldíos.‡Prendre l\'Emeraude d\'Infus et l\'utiliser sur l\'un des Infernaux qui se trouvent en Désolace. Quand vous aurez réussi, rapporter l\'Emeraude d\'Infus et l\'Esprit d\'Infernal emprisonné à Menara Taillevide, dans les Tarides.‡带上地狱火绿宝石到凄凉之地去，用它捕获一个地狱火的灵魂。成功之后，将地狱火绿宝石和被禁锢的地狱火灵魂交给贫瘠之地的梅纳拉·沃伦德。‡帶上地獄火綠寶石到淒涼之地去，用它捕獲一個地獄火的靈魂。成功之後，將地獄火綠寶石和被禁錮的地獄火靈魂交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4964] = {
  {
    'Orbe de Dar\'Orathil concluído‡Завершение шара Дар\'орахила‡Die fertiggestellte Kugel von Dar\'Orahil‡완성된 다르오라힐의 보주‡El orbe completo de Dar\'Orahil‡El orbe completo de Dar\'Orahil‡L\'Orbe complet de Dar\'Orahil‡达奥拉赫宝珠‡',
    nil,
    'Espere Menara Nihila completar o Orbe de Dar\'Orathil e fale com ela novamente.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над шаром Дар\'орахила, и еще раз поговорите с ней.‡Wartet, bis Menara Leerbringer die Kugel von Dar\'Orahil fertig gestellt hat, und sprecht dann noch einmal mit ihr.‡미네라 보이드렌더가 다르오라힐의 보주를 완성시킬 때까지 기다렸다가 그녀에게 말을 걸어야 합니다.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Attendre que Menara Taillevide termine l\'Orbe de Dar\'Orahil, puis lui reparler.‡等待梅纳拉·沃伦德完成达奥拉赫宝珠，然后再与她谈一谈。‡',
  }
},
[4965] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4966] = {
  {
    'Proteja Kanati Nuvem Cinzenta‡Защитить Канати Серое Облако‡Kanati Grauwolke schützen‡카나티 그레이클라우드 보호‡Defensa de Kanati Nubegris‡Defensa de Kanati Nube Gris‡Protéger Kanati Greycloud‡保护卡纳提·灰云‡',
    nil,
    'Proteja Kanati Nuvem Cinzenta do ataque dos centauros.‡Защитите Канати Серое Облако от нападения кентавров.‡Beschützt Kanati Grauwolke vor den Angriffen der Zentauren.‡켄타우로스의 공격으로부터 카나티 그레이클라우드를 보호해야 합니다.‡Defiende a Kanati Nubegris contra el ataque de los centauros.‡Defiende a Kanati Nube Gris contra el ataque de los centauros.‡Protéger Kanati Nuage-gris contre l\'attaque centaure.‡保护卡纳提·灰云免受半人马的袭击。‡',
  }
},
[4967] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4968] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4969] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del Orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parler à Menara Taillevide dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4970] = {
  {
    'Suprimentos para os sabres-de-gelo‡Накормить ледопардов‡Frostsäblerverpflegung‡눈호랑이의 먹이‡Provisiones Sable de Hielo‡Provisiones de sable de hielo‡Provisions de sabres-de-givre‡霜刃豹的食物‡霜刃豹的糧食',
    nil,
    'Colete 5 peças de Carne de Dentilhaços e 5 peças de Carne de Ventogelantes para Ripárion Glaciares, em Hibérnia.‡Соберите 5 кусков мяса медведей-щербозубов и 5 кусков мяса стылодыхов для Риверна Холодного Ветра в Зимних Ключах.‡Sammelt 5 Splitterzahnfleischstücke und 5 Fleischstücke einer Eiswindschimäre für Rivern Frostwind in Winterquell.‡톱니이빨곰 고기 5개와 서리바람 키메라 고기 5개를 여명의 설원에 있는 리베른 프로스트윈드에게 갖다주어야 합니다.‡Recoge 5 carnes de Dentoesquirla y 5 carnes de Orvallo para Rivern Ventogélido de Cuna del Invierno.‡Recoge 5 carnes de Dentoesquirla y 5 carnes de Orvallo para Rivern Ventogélido de Cuna del Invierno.‡Collecter 5 morceaux de Viande de Croc acéré et 5 morceaux de Viande de Noroît pour Rivern Givrevent du Berceau-de-l\'Hiver.‡收集5块碎齿熊肉和5块冰风奇美拉肉，把它们交给冬泉谷的雷沃·霜翼。‡收集5塊裂齒熊肉和5塊冰風奇美拉肉交給冬泉谷的雷沃·霜風。',
  }
},
[4971] = {
  {
    'É questão de tempo‡Вопрос времени‡Eine Frage der Zeit‡시간 문제‡Una cuestión de tiempo‡Una cuestión de tiempo‡Une question de temps‡时间问题‡時間問題',
    nil,
    'Use o Deslocador Temporal perto de um dos silos de Andorhal e desencave Parasitas Temporais.nnMate 10 Parasitas Temporais e depois devolva o Deslocador Temporal para Crona na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Воспользуйтесь временным переместителем рядом с одним из амбаров Андорала и найдите временных паразитов.nnУбейте 10 временных паразитов и верните временной переместитель Хроми в Андоральскую таверну в Западных Чумных землях.‡Benutzt den Temporalversetzer in der Nähe eines der Silos von Andorhal, um die temporalen Parasiten aufzuspüren.nnTötet 10 temporale Parasiten und bringt dann den Temporalversetzer zu Chromie im Gasthaus Andorhal in den westlichen Pestländern.‡안돌할 저장고 근처에서 시간의 재배열기를 이용해 시간의 기생충들을 찾아내십시오.nn시간의 기생충 10마리를 처치한 후, 서부 역병지대의 안돌할 여관에 있는 크로미에게 시간의 재배열기를 가져가야 합니다.‡Utiliza el desplazador temporal junto a uno de los silos de Andorhal y saca a la luz los parásitos temporales.nnMata a 10 parásitos temporales y devuélvele el desplazador temporal a Cromi en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Utiliza el desplazador temporal junto a uno de los silos de Andorhal y saca a la luz los parásitos temporales.|nMata a 10 parásitos temporales y devuélvele el desplazador temporal a Cromi en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Utiliser le Déplaceur temporel à côté de l\'un des silos d\'Andorhal pour révéler des Parasites temporels.nnTuer 10 Parasites temporels et rapporter le Déplaceur temporel à Chromie, à l\'auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔的一处仓库附近使用时光置换器，使时光寄生虫现身。nn杀掉10只时光寄生虫，然后将时光置换器还给西瘟疫之地安多哈尔旅店的克罗米。‡在安多哈爾的一處倉庫附近使用時光置換器，使時光寄生蟲現身。|n殺掉10隻時光寄生蟲，然後將時光置換器還給西瘟疫之地安多哈爾旅店的克羅米。',
  }
},
[4972] = {
  {
    'Contando o tempo‡Отсчет времени‡Tempus fugit‡시간을 거슬러‡Contar el tiempo‡Contar el tiempo‡Arrêt du temps‡找回时间‡找回時間',
    nil,
    'Encontre 5 Relógios de Andorhal, que estão em cofres em meio às ruínas da cidade. Regresse com eles até Crona, que está na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Найдите 5 часов Андорала, спрятанных в сундуки среди руин. Принесите их Хроми в таверну Андорала в Западных Чумных землях.‡Sucht 5 Uhren von Andorhal, die in Schließkassetten überall im Schutt der Stadt zu finden sind. Kehrt mit ihnen zu Chromie ins Gasthaus Andorhal in den westlichen Pestländern zurück.‡안돌할 도시의 폐허에서 안돌할 시계 5개를 찾아 서부 역병지대의 안돌할 여관에 있는 크로미에게 가져가야 합니다.‡Localiza 5 relojes de Andorhal, los encontrarás en cajas fuertes entre las ruinas de la ciudad. Cuando los tengas regresa con Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Localiza 5 relojes de Andorhal, los encontrarás en cajas fuertes entre las ruinas de la ciudad. Cuando los tengas regresa con Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Trouver 5 Montres d\'Andorhal, dans des coffrets qui se trouvent parmi les décombres de la ville, et les rapporter à Chromie à l\'Auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔城中四处散落的保险箱里找到5只安多哈尔怀表，然后把它们交给西瘟疫之地安多哈尔旅店里的克罗米。‡在安多哈爾城中四處散落的帶鎖箱裡找到5個安多哈爾懷錶，然後把它們交給西瘟疫之地安多哈爾旅店裡的克羅米。',
  }
},
[4973] = {
  {
    'Contando o tempo‡Отсчет времени‡Tempus fugit‡시간을 거슬러‡Contar el tiempo‡Contar el tiempo‡Arrêt du temps‡找回时间‡找回時間',
    nil,
    'Encontre 5 Relógios de Andorhal em meio às ruínas da cidade e regresse com eles até Crona, que está na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Найдите 5 часов Андорала, спрятанных в сундуки среди руин. Принесите их Хроми в таверну Андорала в Западных Чумных землях.‡Sucht 5 Uhren von Andorhal in den Ruinen der Stadt und bringt sie Chromie im Gasthaus Andorhal in den westlichen Pestländern.‡안돌할 도시의 폐허에서 안돌할 시계 5개를 찾아 서부 역병지대의 안돌할 여관에 있는 크로미에게 가져가야 합니다.‡Localiza 5 relojes de Andorhal entre las ruinas de la ciudad y llévaselos a Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Localiza 5 relojes de Andorhal entre las ruinas de la ciudad y llévaselos a Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Trouver 5 Montres d\'Andorhal parmi les décombres de la ville et les rapporter à Chromie à l\'Auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔城的废墟里找到5只安多哈尔怀表，然后把它们交给西瘟疫之地安多哈尔旅店里的克罗米。‡在安多哈爾城的廢墟裡找到5個安多哈爾懷錶，然後把它們交給西瘟疫之地安多哈爾旅店裡的克羅米。',
  }
},
[4974] = {
  {
    'Pela Horda!‡За Орду!‡Für die Horde!‡호드를 위하여!‡¡Por la Horda!‡¡Por la Horda!‡Pour la Horde !‡为部落而战！‡為部落而戰!',
    nil,
    'Viaje para o Pico da Rocha Negra e mate o Chefe Guerreiro Laceral Mão Negra. Pegue sua cabeça e volte para Orgrimmar.‡Пойдите в Пик Черной горы и убейте вождя Ренда Чернорука. Принесите его голову в Оргриммар.‡Begebt Euch zur Schwarzfelsspitze und tötet den Kriegshäuptling Rend Schwarzfaust. Nehmt seinen Kopf und kehrt nach Orgrimmar zurück.‡검은바위 첨탑으로 가서 대족장 렌드 블랙핸드를 처치하십시오. 그 증거로 그의 머리카락을 가지고 오그리마로 돌아와야 합니다.‡Ve a Cumbre de Roca Negra para matar al Jefe de Guerra Rend Puño Negro. Lleva su cabeza a Orgrimmar.‡Ve a Cumbre de Roca Negra para matar al Jefe de Guerra Rend Puño Negro. Lleva su cabeza a Orgrimmar.‡Aller au Pic Rochenoire et tuer le Chef de guerre, Rend Main-noire. Prendre sa tête et retourner à Orgrimmar.‡去黑石塔杀死大酋长雷德·黑手，带着他的头颅返回奥格瑞玛。‡去黑石塔殺死大酋長雷德·黑手，帶著他的頭顱返回奧格瑪。',
  }
},
[4975] = {
  {
    'O Orbe de Nor\'Orahil concluído‡Завершение шара Дар\'орахила‡Die fertiggestellte Kugel von Noh\'Orahil‡완성된 노오라힐의 보주‡El orbe completo de Noh\'Orahil‡El orbe completo de Noh\'Orahil‡L\'Orbe complet de Noh\'Orahil‡诺奥拉赫宝珠‡',
    nil,
    'Espere Menara Nihila completar o Orbe de Nor\'Orahil e fale com ela novamente.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над шаром Дар\'орахила, и еще раз поговорите с ней.‡Wartet, bis Menara Leerbringer die Kugel von Noh\'Orahil fertig gestellt hat, und sprecht dann noch einmal mit ihr.‡미네라 보이드렌더가 노오라힐의 보주를 완성하길 기다렸다가 그녀에게 말을 걸어야 합니다.‡Espera a Menara Nadiz para completar el orbe de Noh\'Orahil y vuelve entonces a hablar con ella.‡Espera a Menara Nadiz para completar el orbe de Noh\'Orahil y vuelve entonces a hablar con ella.‡Attendre que Menara Taillevide ait terminé l\'Orbe de Noh\'Orahil, puis lui reparler.‡等待梅纳拉·沃伦德完成诺奥拉赫宝珠，然后再与她谈一谈。‡',
  }
},
[4976] = {
  {
    'Devolução do orbe purificado‡Возвращение к Менаре‡Ablieferung der gesäuberten Kugel‡정화의 보주 가져가기‡Devolver el orbe purificado‡Devolver el orbe purificado‡Rapporter l\'Orbe purifié‡归还净化过的宝珠‡',
    nil,
    'Leve o Orbe Infernal Purificado a Menara Nihila nos Sertões.‡Отнесите очищенную сферу инфернала Менаре Расщепительнице Бездны в Степи.‡Bringt die gesäuberte Höllenkugel zu Menara Leerbringer ins Brachland.‡정화된 지옥의 보주를 불모의 땅의 미네라에게 가져가야 합니다.‡Llévale el orbe infernal limpio a Menara Nadiz en Los Baldíos.‡Llévale el orbe infernal limpio a Menara Nadiz en Los Baldíos.‡Rapporter l\'Orbe infernal purifié à Menara Taillevide, dans les Tarides.‡将净化过的地狱火宝珠交给贫瘠之地的梅纳拉·沃伦德。‡',
  }
},
[4981] = {
  {
    'Agente Biju‡Агент Блестяшка‡Agentin Bijou‡요원 비쥬‡La espía Bijou‡La espía Bijou‡Agent Bijou‡狡猾的比修‡狡猾的比修',
    nil,
    'Vá ao Pico da Rocha Negra e descubra o que aconteceu com Biju.‡Отправьтесь к пику Черной горы и выясните, что сталось с Блестяшкой.‡Begebt Euch zur Schwarzfelsspitze und findet heraus, was aus Bijou geworden ist.‡검은바위 첨탑으로 가서 비쥬에게 무슨 일이 생겼는지 알아봐야 합니다.‡Viaja hasta la Cumbre de Roca Negra y averigua qué le ha ocurrido a Bijou.‡Viaja hasta la Cumbre de Roca Negra y averigua qué le ha ocurrido a Bijou.‡Aller au Pic Rochenoire et découvrir ce qui est arrivé à Bijou.‡到黑石塔去查明比修的下落。‡到黑石塔去查明比修的下落。',
  }
},
[4982] = {
  {
    'Pertences da Biju‡Вещи Блестяшки‡Bijous Habseligkeiten‡비쥬의 물건들‡Las pertenencias de Bijou‡Las pertenencias de Bijou‡Les affaires de Bijou‡比修的装置‡比修的裝置',
    nil,
    'Encontre os Pertences de Biju e devolva-os a ela. Ela mencionou tê-los guardado no nível mais profundo da cidade.‡Найдите вещи Блестяшки и верните их владелице. Блестяшка сказала, что она спрятала свое оборудование где-то на нижнем ярусе подземелья.‡Sucht Bijous Habseligkeiten und bringt sie ihr. Ihr erinnert Euch daran, dass sie erwähnte, ihre Sachen auf der untersten Ebene der Stadt versteckt zu haben.‡비쥬의 소지품을 찾아서 그녀에게 돌아가야 합니다. 비쥬가 도시의 바닥에 소지품을 숨겼다고 했습니다.‡Encuentra las pertenencias de Bijou y devuélveselas. Recuerdas que ella mencionó haberlas ocultado en la planta baja de la ciudad.|n‡Encuentra las pertenencias de Bijou y devuélveselas. Recuerdas que ella mencionó haberlas ocultado en la planta baja de la ciudad.‡Trouver les Affaires de Bijou et les lui rapporter. Elle vous a dit les avoir cachées dans le niveau inférieur de la ville.‡找到比修的装置并把它们还给她。你记得她说过她把装置藏在城市的最底层。‡找到比修的裝置並把它們還給她。你記得她說過她把裝置藏在城市的最底層。',
  }
},
[4983] = {
  {
    'Relatório de reconhecimento de Biju‡По данным разведки‡Bijous Aufklärungsbericht‡비쥬의 정찰 보고‡El informe de reconocimiento de Bijou‡El informe de reconocimiento de Bijou‡Rapport de reconnaissance de Bijou‡比修的侦察报告‡比修的偵察報告',
    nil,
    'Leve o Relatório de Reconhecimento de Biju para o Grão-mestre Lexlort em Karrath.‡Передайте донесение Блестяшки гроссмейстеру Лекслорту в Каргат.‡Bringt Bijous Aufklärungsbericht zu Großmeister Lexlort nach Kargath.‡비쥬의 정찰 보고서를 가지고 카르가스의 렉스로트에게 가야 합니다.‡Llévale el informe de reconocimiento de Bijou al maestro mayor Lexlort en Kargath.|n‡Llévale el informe de reconocimiento de Bijou al maestro mayor Lexlort en Kargath.‡Rapporter le Rapport de reconnaissance de Bijou au Grand-maître Lexlort, à Kargath.‡把比修的侦查报告交给卡加斯的雷克斯洛特。‡把比修的偵察報告交給卡加斯的雷克斯洛特。',
  }
},
[4984] = {
  {
    'A vida selvagem também sofre‡Страдания природы‡Die Tierwelt leidet auch‡야생 동물들의 고통‡La naturaleza también sufre‡La naturaleza también sufre‡La faune et la flore souffrent aussi‡大自然的苦楚‡大自然的苦楚',
    nil,
    'Destrua 8 Lobos Doentes e fale novamente com Mulgris Riofundo no Antro Repelente, que fica nas Terras Pestilentas Ocidentais.‡Убейте 8 больных волков и вернитесь к Мулгрису Глубокой Реке в Удел Страданий в Западных Чумных землях.‡Tötet 8 kranke Wölfe und kehrt dann zu Mulgris Tiefenfurt auf dem trostlosen Feld in den westlichen Pestländern zurück.‡역병에 걸린 늑대 8마리를 처치한 후, 서부 역병지대의 고통의 흉가에 있는 멀그리스 딥리버에게 돌아가야 합니다.‡Destruye 8 lobos malsanos y regresa con Mulgris Riohondo en El Tormento, en las Tierras de la Peste del Oeste.|n|n‡Destruye 8 lobos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.‡Détruire 8 Loups malades, puis retourner voir Mulgris Rivière-profonde, au Repaire putride dans les Maleterres de l\'ouest.‡消灭8只生病的狼，然后去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。‡消滅8隻生病的狼，然後去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。',
  }
},
[4985] = {
  {
    'A vida selvagem também sofre‡Страдания природы‡Die Tierwelt leidet auch‡야생 동물들의 고통‡La naturaleza también sufre‡La naturaleza también sufre‡La faune et la flore en souffrent aussi‡大自然的苦楚‡大自然的苦楚',
    nil,
    'Destrua 8 Ursos-cinzentos Doentes e fale novamente com Mulgris Riofundo no Antro Repelente, que fica nas Terras Pestilentas Ocidentais.‡Убейте 8 болезненных гризли и вернитесь к Мулгрису Глубокой Реке в Удел Страданий в Западных Чумных землях.‡Tötet 8 kranke Grizzlys und kehrt dann zu Mulgris Tiefenfurt auf dem trostlosen Feld in den westlichen Pestländern zurück.‡오염된 불곰 8마리를 처치한 후, 서부 역병지대의 고통의 흉가에 있는 멀그리스 딥리버에게 돌아가야 합니다.‡Destruye 8 pardos malsanos y regresa con Mulgris Riohondo en El Tormento, en las Tierras de la Peste del Oeste.‡Destruye 8 pardos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.‡Détruire 8 Grizzlys malades, puis retourner voir Mulgris Rivière-profonde au Repaire putride, dans les Maleterres de l\'ouest.‡消灭8只生病的灰熊，然后去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。‡消滅8隻生病的灰熊，然後去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。',
  }
},
[4986] = {
  {
    'Galho de carvalho com glifos‡Покрытая письменами дубовая ветвь‡Glyphenverzierter Eichenast‡문자가 새겨진 떡갈나무 가지‡Rama de roble con inscripciones‡Rama de roble con inscripciones‡La branche de chêne à glyphes‡雕文橡木枝‡雕紋橡木樹枝',
    nil,
    'Baseado na magia imbuída no galho de carvalho com glifos, sua entrega ao Círculo Cenariano em Darnassus é o próximo passo que o druida tauren buscava. Procure a ajuda de um dos druidas.‡Судя по магии, вложенной в покрытую письменами дубовую ветвь, друид-таурен желал отнести ее в Круг Кенария в Дарнассе. Попросите о помощи одного из тамошних друидов.‡Nach der Magie zu urteilen, mit der der glyphenverzierte Eichenast erfüllt ist, hatte der Taurendruide wohl gewollt, dass Ihr den Ast zum Zirkel des Cenarius nach Darnassus bringt. Bittet einen der Druiden dort um Hilfe.‡문자가 새겨진 떡갈나무 가지에 걸린 문자로 미루어볼 때 타우렌 드루이드가 이 가지를 가져가려고 한 장소는 다르나서스에 있는 세나리온 의회입니다. 그곳에서 드루이드를 한 명 찾아 도움을 요청하십시오.‡Según la magia con la que está encantada La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion en Darnassus. Pide ayuda a uno de los druidas que encontrarás allí.‡Según la magia con la que está encantada La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion en Darnassus. Pide ayuda a uno de los druidas que encontrarás allí.‡D\'après la magie contenue dans la Branche de chêne à glyphes, le druide tauren voulait qu\'elle soit apportée au Cercle cénarien, à Darnassus. Aller solliciter l\'assistance de l\'un des druides, là-bas.‡根据雕文橡木枝上面所附加的魔法，这个牛头人德鲁伊本来准备把它交给达纳苏斯的塞纳里奥议会。看来你应该到那里去找一个德鲁伊，并寻求他的帮助。‡根據這枝雕紋橡木樹枝所附加的魔法，這個牛頭人德魯伊本來準備把它交給達納蘇斯的塞納里奧議會。到那裡去尋求某個德魯伊的幫助吧。',
  }
},
[4987] = {
  {
    'Galho de carvalho com glifos‡Покрытая письменами дубовая ветвь‡Glyphenverzierter Eichenast‡문자가 새겨진 떡갈나무 가지‡Rama de roble con inscripciones‡Rama de roble con inscripciones‡La branche de chêne à glyphes‡雕文橡木枝‡雕紋橡木樹枝',
    nil,
    'Baseado na magia imbuída no galho de carvalho com glifos, sua entrega ao Círculo Cenariano no Penhasco do Trovão é o próximo passo que o druida Tauren buscava. Procure a ajuda de um dos druidas.‡Судя по магии, записанной в покрытую письменами дубовую ветвь, друид-таурен желал отнести ее в Круг Кенария в Громовом Утесе. Попросите о помощи одного из тамошних друидов.‡Nach der Magie zu urteilen, mit der der glyphenverzierte Eichenast erfüllt ist, hatte der Taurendruide wohl gewollt, dass Ihr den Ast zum Zirkel des Cenarius nach Donnerfels bringt. Bittet einen der Druiden dort um Hilfe.‡문자가 새겨진 떡갈나무 가지에 걸린 문자로 미루어볼 때 타우렌 드루이드가 이 가지를 가져가려고 한 장소는 썬더 블러프에 있는 세나리온 의회입니다. 그곳에서 드루이드를 한 명 찾아 도움을 받도록 하십시오.‡Según la magia con la que está encantada de La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion de Cima del Trueno. Pide ayuda a uno de los druidas que encontrarás allí.‡Según la magia con la que está encantada de La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion de Cima del Trueno. Pide ayuda a uno de los druidas que encontrarás allí.‡D\'après la magie contenue dans la Branche de chêne à glyphes, le druide tauren voulait qu\'elle soit apportée au Cercle cénarien, aux Pitons du Tonnerre. Aller solliciter l\'assistance de l\'un des druides, là-bas.‡根据雕文橡木枝上面所附加的魔法，这个牛头人德鲁伊本来准备把它交给雷霆崖的塞纳里奥议会。看来你应该到那里去找一个德鲁伊，并寻求他的帮助。‡根據這枝雕紋橡木樹枝所附加的魔法，這個牛頭人德魯伊本來準備把它交給雷霆崖的塞納里奧議會。到那裡去尋求某個德魯伊的幫助吧。',
  }
},
[5001] = {
  {
    'Pertences da Biju‡Вещи Блестяшки‡Bijous Habseligkeiten‡비쥬의 소지품‡Las pertenencias de Bijou‡Las pertenencias de Bijou‡Les affaires de Bijou‡比修的装置‡比修的裝置',
    nil,
    'Encontre os Pertences de Biju e devolva-os a ela. Boa sorte!‡Найдите вещи Блестяшки и верните их владелице. Удачи!‡Sucht Bijous Habseligkeiten und bringt sie ihr. Viel Glück!‡비쥬의 소지품을 찾아 그녀에게 돌려줘야 합니다!‡Encuentra las pertenencias de Bijou y devuélveselas. ¡Suerte!|n‡Encuentra las pertenencias de Bijou y devuélveselas. ¡Suerte!‡Retrouver les Affaires de Bijou et les lui rapporter. Bonne chance !‡找到比修的装置并把它们还给她。祝你好运！‡找到比修的裝置並且交還給她。祝你好運!',
  }
},
[5002] = {
  {
    'Mensagem para Maxwell‡Донесение Максвелла‡Nachricht an Maxwell‡맥스웰에게 보내는 정보‡Un mensaje para Maxwell‡Un mensaje para Maxwell‡Message à Maxwell‡给麦克斯韦尔的消息‡給麥斯威爾的訊息',
    nil,
    'Viaje para as Estepes Ardentes e dê as Informações de Biju para o Oficial Maxwell.‡Передайте маршалу Максвеллу информацию Блестяшки.‡Begebt Euch in die brennende Steppe und leitet Bijous Informationen an Marschall Maxwell weiter.‡불타는 평원에 있는 치안대장 맥스웰에게 비쥬의 정보를 전해야 합니다.‡Viaja a Las Estepas Ardientes y dale la información sobre Bijou al mariscal Maxwell.‡Viaja a Las Estepas Ardientes y dale la información sobre Bijou al mariscal Maxwell.‡Se rendre dans les Steppes ardentes et confier les Renseignements de Bijou au maréchal Maxwell.‡到燃烧平原去，把比修的情报交给麦克斯韦尔元帅。‡把比修的消息帶去給在燃燒平原的麥斯威爾元帥。',
  }
},
[5021] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'As divagações da mulher fantasmagórica indicavam que ela precisava que um pacote fosse entregue. Ela afirmou que ele estava no mesmo lugar que seu cavalo. Quanto ao local onde o cavalo está ou onde o pacote deve ser entregue, continua sendo impossível entender o fantasma.‡Судя по сбивчивым объяснениям призрачной женщины, она хочет доставить посылку. Бедняга уверяет, что посылка лежала там, где стоял ее конь. Где именно это было, женщина не сказала.‡Das wilde Gebrabbel der Geisterfrau deutete darauf hin, dass sie ein Paket ausliefern musste. Sie behauptete, dass es dort war, wo auch ihr Pferd war. Darüber, wo das Pferd jetzt ist oder wohin das Paket ausgeliefert werden muss, sagt der Geist nichts.‡유령 여인의 두서없는 말을 들으니 소포를 전달해야 했던 것 같습니다. 자신의 말이 있던 곳에 소포가 있다고 했는데, 말이 어디 있는지, 그리고 소포를 어디로 전달해야 하는지에 대해서는 이해할 수 없는 말만 늘어놓습니다.‡Entre lamentos, la mujer fantasmal recordaba tener que entregar un paquete. Según ella estaba junto a su caballo. No puedes entender dónde está el caballo o dónde había que entregar el paquete.‡Entre lamentos, la mujer fantasmal recordaba tener que entregar un paquete. Según ella estaba junto a su caballo. No puedes entender dónde está el caballo o dónde había que entregar el paquete.‡Le discours incohérent de la femme fantomatique indique qu\'elle a besoin qu\'on livre un colis pour elle. Elle a dit que le colis se trouvait là où se trouve son cheval. Le fantôme est incompréhensible lorsqu\'il s\'agit de préciser où se trouve son cheval ou l\'endroit où le paquet doit être livré.‡这个女人的幽灵告诉你她要送出一只包裹。她说那只包裹就在她的马旁边。至于马在哪里或者包裹要送到哪里去，她却根本没有说。‡這個女人的鬼魂告訴你她要送出一個包裹。她說那個包裹就在她的馬旁邊。至於馬在哪裡或者包裹要送到哪裡去，她卻根本沒有說。',
  }
},
[5022] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'Fale com os Administradores Reais de Ventobravo para saber o paradeiro da Bia Pedravil. Geralmente tem um agente do censo na Prefeitura.‡Выясните у королевских представителей Переписи Штормграда местонахождение Эммы Фелстоун. Офицера-переписчика можно найти в Ратуше.‡Wendet Euch an die königlichen Disponenten von Sturmwind, um etwas über den Aufenthaltsort von Emma Teufelsstein herauszufinden. Normalerweise findet sich ein Volkszählungsbeamter im Rathaus.‡스톰윈드의 왕실 조사원과 대화하여 엠마 펠스톤의 행방을 알아내십시오. 인구조사국 담당자는 보통 스톰윈드 시청에 있습니다.‡Consulta con los agentes reales de Ventormenta para averiguar el paradero de una tal Emma Piedra Mácula. Suele haber un oficial del censo en el Ayuntamiento.‡Consulta con los agentes reales de Ventormenta para averiguar el paradero de una tal Emma Piedra Mácula. Suele haber un oficial del censo en el Ayuntamiento.‡Rendre visite aux Facteurs royaux de Hurlevent pour apprendre l\'adresse d\'une certaine Emma Gangrepierre. En général, il y a un officier du recensement à l\'Hôtel de ville.‡与暴风城的皇家代理人巴瑟罗尔协商，查找到艾玛·费尔斯通的下落。通常在市政厅里都有一个人口普查官。‡向暴風城的皇家代理人確認艾瑪·費爾斯通的下落。通常在市政廳裡都有一個人口普查官。',
  }
},
[5023] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'Fale com os Feitores Reais da Cidade Baixa para saber o paradeiro da Jeremias Pedravil. Geralmente tem um agente do censo perto do registro de guilda e tabardo.‡Поговорите с королевскими инспекторами Подгорода и наведите справки о Иеремии Фелстоуне. Офицера-переписчика можно найти рядом с пунктом регистрации гильдий и гербовых накидок.‡Wendet Euch an die königlichen Vorarbeiter von Unterstadt, um etwas über den Aufenthaltsort von Jeremiah Teufelsstein herauszufinden. Normalerweise findet sich ein Volkszählungsbeamter in der Nähe der Gilden- und Wappenrock-Registrierung.‡언더시티의 왕실감독원과 대화하여 제레미어 펠스톤의 행방을 알아내십시오. 인구조사국 담당자는 보통 길드 사무소 근처에 있습니다.‡Consulta con los supervisores reales de Entrañas para averiguar el paradero de Jeremiah Piedra Mácula. Suele haber un oficial del censo junto a la oficina de registro de hermandades y tabardos.‡Consulta con los supervisores reales de Entrañas para averiguar el paradero de Jeremiah Piedra Mácula. Suele haber un oficial del censo junto a la oficina de registro de hermandades y tabardos.‡Se renseigner auprès des Surveillants royaux de Fossoyeuse pour apprendre l\'adresse d\'un certain Jeremiah Gangrepierre. En général, il y a un officier du recensement près du bureau d\'inscription des guildes et tabards.‡与幽暗城的皇家管理人巴哈乌斯协商，查找杰雷米亚·费尔斯通的下落。通常在公会注册处附近会有一个人口普查官。‡與幽暗城的皇家監督者打聽傑雷米亞·費爾斯通的下落。通常在公會註冊處附近會有一個人口普查官。',
  }
},
[5041] = {
  {
    'Suprimentos para a Encruzilhada‡Снабжение Перекрестка‡Vorräte für das Wegekreuz‡크로스로드의 보급품‡Suministros para El Cruce‡Suministros para El Cruce‡Ravitaillement pour la Croisée‡十字路口的补给品‡十字路口的補給物資',
    nil,
    'Encontre e devolva os Caixotes de Suprimentos da Encruzilhada a Thork, nos Sertões.‡Найдите и верните Тхорку из Степей ящики с припасами из Перекрестка.‡Findet die Vorratskisten des Wegekreuzes und bringt sie zu Thork im Brachland zurück.‡크로스로드 보급품 상자를 찾아서 불모의 땅의 톨크에게 가져가 주어야 합니다.‡Encuentra los cajones de suministros de El Cruce y devuélveselos a Thork en Los Baldíos.‡Reúne 5 cajones de suministros de El Cruce en el interior de la cueva de los Crines de Acero.‡Trouver et rapporter les Caisses de ravitaillement de la Croisée à Thork dans les Tarides.‡找到十字路口的补给箱，把它还给贫瘠之地的索克。‡找到並把十字路口的補給木箱還給貧脊之地的索克。',
  }
},
[5042] = {
  {
    'Força de Agamaggan‡Сила Агамаггана‡Agammagans Kraft‡아감마간의 힘‡La fuerza de Agamaggan‡La fuerza de Agamaggan‡La force d\'Agamaggan‡阿迦玛甘的力量‡阿迦瑪甘的力量',
    nil,
    'Eu vou precisar de 4 fragmentos de sangue se você quiser ter a força de Agamaggan, <race>.nnSeus inimigos tremerão ante sua força se você receber essa bênção.nnOs maiores guerreiros dos Crinavalha são infundidos com esse poder!‡Если ты желаешь обрести силу Агамаггана, |3-6(орк), принеси мне 4 кровавых осколка.nnВраги будут трепетать перед тобой, когда я благословлю тебя. *фыркает*nnЛишь величайшим воинам племени Иглогривых дарована такая сила!‡Ich benötige 4 Blutsplitter, wenn Ihr Agammagans Kraft wünscht, <Volk>.nnEure Feinde werden vor Eurer Kraft erzittern, wenn Ihr über diesen Segen verfügen würdet. nnDie größten Krieger der Grimmhauer sind mit solcher Stärke ausgestattet!‡아감마간의 힘을 얻으려면 4개의 혈석 파편이 필요하네, <race>. 자네를 보면 적들이 두려움에 벌벌 떨게 될 걸. nn서슬갈기일족의 용맹한 전사들은 모두 이런 힘을 가지고 있지!‡Necesitaré 4 esquirlas de sangre si quieres tener la fuerza de Agamaggan, <raza>.nnSi se te concediera esta bendición, tus enemigos se encogerán ante tu fuerza. nn¡Los más gloriosos guerreros Crines de Acero están imbuidos de tal poder!‡‡J\'aurai besoin de quatre Joyaux de sang si vous voulez la force d\'Agammagan, <nom>.nnVos ennemis s\'enfuiront devant votre pouvoir si vous avez cette bénédiction. nnLes plus grands guerriers Tranchecrin sont d\'une telle puissance !‡‡',
  }
},
[5043] = {
  {
    'Agilidade de Agamaggan‡Ловкость Агамаггана‡Agammagans Beweglichkeit‡아감마간의 민첩성‡La agilidad de Agamaggan‡La agilidad de Agamaggan‡L\'agilité d\'Agammagan‡阿迦玛甘的敏捷‡阿迦瑪甘的敏捷',
    nil,
    'Os maiores batedores da minha tribo são considerados incomparáveis em termos de precisão, e nenhum ladino <bufa> está à altura de sua rapidez em batalha.nnTraga-me 4 estilhaços de sangue e tornarei você ainda mais ágil do que qualquer javatusco que já tenha existido.‡Величайшие разведчики моего племени издавна отличались несравненной меткостью, и ни одному разбойнику *фыркает* даже и не снилась подобная стремительность в битве.nnПринеси мне 4 кровавых осколка, и превзойдешь ловкостью любого иглогрива.‡Man sagt, dass die größten Späher meines Stammes in ihrer Genauigkeit unübertroffen seien und kein Schurke <schnaubt> ihrer Schnelligkeit im Kampf standhalten könne.nnBringt mir 4 Blutsplitter und ich werde Euch noch flinker machen als jeder lebende Stacheleber.‡우리 일족 정찰병들의 화살 솜씨는 그 누구도 따를 자가 없다고 정평이 나 있지. <킁킁> 우리 도적들 또한 전장에서 내로라할 만큼 몸놀림이 빠르지.nn혈석 4개를 내게 가져오면 자네를 어떤 가시멧돼지보다 더 민첩하게 만들어주지.‡Se dice que la precisión de los mejores exploradores de mis tribus no tiene parangón y ningún granuja <gruñe> estaría a la altura de su rapidez en el combate.nnTráeme 4 esquirlas de sangre y haré que seas aún más ágil que cualquier jabaespín.‡‡Les meilleurs éclaireurs de ma tribu ont la réputation d\'être d\'une précision sans rivale, et nul ne peut égaler leur rapidité au combat.nnApportez-moi 4 Joyaux de sang et je vous rendrai plus agile que n\'importe quel huran.‡‡',
  }
},
[5044] = {
  {
    'Sabedoria de Agamaggan‡Мудрость Агамаггана‡Weisheit von Agammagan‡아감마간의 지혜‡La sabiduría de Agamaggan‡La sabiduría de Agamaggan‡La sagesse d\'Agammagan‡阿迦玛甘的智慧‡阿迦瑪甘的智慧',
    nil,
    '‡Сила Агамаггана помогает шаманам и рудознатцам иглогривов *фыркает* в бою и во время проведения ритуалов.nnЕсли ты тоже желаешь обрести благословение Агамаггана, принеси мне 4 кровавых осколка, и Кривозуб тебе поможет. *фыркает*‡Die Schamanen und Geomanten der Stacheleberstämme <schnaubt> nutzen die Kraft von Agammagan im Kampf und bei ihren Ritualen, <Volk>.nnWenn auch Ihr die zusätzliche Macht von Agammagans Segen für Eure Zauber wünscht, dann bringt mir 4 Blutsplitter, und Quetschzahn wird Euch helfen.‡우리 가시멧돼지 주술사나 풍수사들은 <킁킁> 전투에서 아감마간님의 힘을 빌린다네, <race>.nn아감마간님의 축복을 입어 마법의 위력을 높이고자 한다면 혈석 4개를 가져오게. 그러면 이 뻐드렁니가 도와 주지.‡El chamán y los geománticos de las tribus jabaespín <gruñe> recurren a la fuerza de Agamaggan para que les ayude en la batalla y en sus rituales, <raza>.nnSi quieres el poder adicional de la bendición de Agamaggan con tus hechizos, tráeme 4 esquirlas de sangre y Quebrantadientes te ayudará.‡‡Les chamans et les géomanciens des tribus huranes <grogne> invoquent la force d\'Agammagan pour les aider au combat et dans leurs rituels, <nom>.nnSi vous voulez la bénédiction d\'un surcroît de pouvoir d\'Agammagan dans vos sorts, apportez-moi 4 Joyaux de sang et Mangletooth vous aidera.‡‡',
  }
},
[5045] = {
  {
    'Espírito ascendente‡Высокий дух‡Steigerung des Geistes‡정신력 상승‡Fortaleza de espíritu‡Fortaleza de espíritu‡L\'essor de l\'esprit‡高涨的士气‡高漲的士氣',
    nil,
    '‡Высокий дух – благо для всех воинов. *фыркает* Он ведет к победе, даже когда надежды уже нет. Племя Иглогривых знает об этом. *фыркает* Мы ценим свою связь с Агамагганом больше доблести *фыркает* в бою.nnПринеси мне 4 кровавых осколка, и ты получишь благословение духа перед тем, как идти в бой. *фыркает*‡Krieger aller Art <schnaubt> benötigen einen starken Geist. Er treibt Euch zu größeren Leistungen, wenn alle Hoffnung verloren ist. Das ist den Grimmhauern nicht <schnaubt> unbekannt. Wir sind ein spiritueller Stamm... wir sind stolzer auf unsere Verbindung zu Agammagan als auf unsere Leistungsfähigkeit <schnaubt> im Kampf.nnBringt mir 4 Blutsplitter und ich werde Euch für den Kampf segnen. <schnaubt>‡‡Todos los tipos de <clase> necesitan fortaleza de espíritu. Te empuja a mayores proezas cuando se ha perdido toda esperanza. Es algo a lo que están acostumbrados los Crines de Acero. Somos una tribu espiritual, estamos más orgullosos de nuestra conexión con Agamaggan que de nuestras proezas en la batalla.nnTráeme 4 esquirlas de sangre y bendeciré tu espíritu para el combate.‡‡Tous les guerriers, quels qu\'ils soient, <grogne> ont besoin d\'un esprit fort. Il vous conduit à l\'exploit quand tout espoir est perdu. Ceci n\'est pas ignoré <grogne> des Tranchecrins. Nous sommes une tribu spirituelle - nous sommes plus fiers de notre lien à Agammagan que de nos prouesses <grogne> au combat.nnApportez-moi quatre Joyaux de sang et je bénirai votre esprit de lutte.<grogne>‡‡',
  }
},
[5046] = {
  {
    'Couro de Navalha‡Иглошкура‡Klingenhaut‡서슬가죽‡Cerropiel‡Ocultafilo‡Peau tranchante‡野猪之皮‡野豬之皮',
    nil,
    'Todos aqueles que <bufa> entram em batalha precisam de proteção. Seus ossos devem ser fortes; sua pele, dura. <bufa> Minha tribo sabe disso também e, para aumentar a proteção natural que nossos espinhos e couro nos dão, <bufa> nós sempre rogamos a Agamaggan para que nos proteja do mal antes de irmos para a guerra.nnTraga-me 4 estilhaços de sangue <bufa> e eu lhe darei a mesma proteção.‡Идущему в бой *фыркает* защита не помешает. Кости должны быть крепкими, а шкура толстой. *фыркает* Мое племя отлично знает об этом, и, помимо дарованных нам от природы игл и толстой шкуры, *фыркает* мы защищаем себя и другими способами. Перед тем как идти на войну, мы просим Агамаггана защитить нас от урона.nnПринеси мне 4 кровавых осколка, *фыркает* и я дарую тебе ту же защиту.‡Alle, die <schnaubt> in den Kampf eintreten, benötigen Schutz. Ihre Knochen müssen stark sein. Ihre Haut zäh. <schnaubt> Mein Stamm weiß das auch und um den natürlichen Schutz zu verstärken, den wir durch unsere Stacheln und unsere Haut erhalten, <schnaubt> rufen wir Agammagan an, uns vor Schaden zu schützen, bevor wir in den Krieg ziehen.nnBringt mir 4 Blutsplitter <schnaubt> und ich werde Euch den gleichen Schutz gewähren.‡전투에 임하는 모든 자들은 <킁킁> 방어력을 갖추고 있어야 하네. 적이 내리칠 도끼를 막아내려면 뼈도, 살갗도 탄탄하고 두꺼워야 하지. <킁킁> 우리 일족도 이 사실을 잘 알고 있다네. 가죽과 털 외에 다른 무언가가 더 필요하다는 것을. <킁킁> 우리는 전쟁에 나가기 전 아감마간님으로부터 보호의 축복을 받곤 해.nn4개의 혈석을 가져오면 내 자네에게도 축복을 내려주지.‡Todos los que <gruñe> entran en combate necesitan protección. Sus huesos han de ser resistentes. Su piel, curtida <Gruñe> Mi tribu sabe esto muy bien y para reforzar la protección natural de nuestras púas y piel, <gruñe> con frecuencia recurrimos a Agamaggan para que nos proteja de los daños antes de entrar en combate.nnTráeme 4 fragmentos ensangrentados <gruñe> y te otorgaré la misma protección.‡‡Tous ceux qui <grogne> se battent ont besoin de protection. Leurs os doivent être solides. Leur peau résistante.<grogne> Ma tribu le sait bien, et pour renforcer les protections naturelles de nos plumes et de nos dards <grogne> nous faisons appel à la protection d\'Agammagan avant de partir pour la guerre.nnApportez-moi 4 Joyaux de sang <grogne> et je vous obtiendrai cette même protection.‡‡',
  }
},
[5047] = {
  {
    'Jonas Tiragosto ao seu dispor!‡Айс Вентурон, к вашим услугам!‡Finkle Einhorn, zu Euren Diensten!‡핀클 에인혼, 명을 받듭니다!‡¡Finkle Unicornín, a tu servicio!‡¡Finkle Einhorn, a tu servicio!‡Finkle Einhorn, à votre service !‡芬克·恩霍尔，为您效劳！‡芬克·恩霍爾，為您效勞!',
    nil,
    'Fale com Málifus Trevamalho em Visteterna.‡Переговорите с Малифоем Черномолотом в Круговзоре.‡Sprecht mit Malyfous Düsterhammer in der Ewigen Warte.‡눈망루 마을에 있는 말리퍼스 다크해머와 대화해야 합니다.‡Habla con Malyfous Martilloscuro en Vista Eterna.‡Habla con Malyfous Martilloscuro en Vista Eterna.‡Parler à Malyfous Sombremartel à Long-guet.‡与永望镇的玛雷弗斯·暗锤谈一谈。‡與永望鎮的瑪雷弗斯·暗錘談話。',
  }
},
[5048] = {
  {
    'Bondosa Bia‡Добросердечная Эмма‡Emma die Nette‡착한 엠마‡El buen carácter de Emma‡El buen carácter de Emma‡Emma la bonne pâte‡善良的艾玛‡善良的艾瑪',
    nil,
    'Encontre a Tia Bia em Ventobravo e veja se, de fato, ela é Bia Pedravil. Se for, talvez ela possa querer o pacote que Janice Pedravil lhe mandou.‡Найдите в Штормграде старушку Эмму и узнайте, действительно ли она – Эмма Фелстоун. Если да, то, может, ей понравится та посылочка, что собрала для нее Джанис Фелстоун.‡Sucht die alte Emma in Sturmwind und findet heraus, ob sie tatsächlich Emma Teufelsstein ist. Wenn sie es ist, dann möchte sie vielleicht das Paket haben, das Janice Teufelsstein für sie gepackt hat.‡스톰윈드에서 늙은 엠마를 찾아 그녀가 엠마 펠스톤인지 확인하십시오. 그녀가 정말 엠마 펠스톤이라면 재니스 펠스톤이 보낸 소포를 원할지도 모릅니다.‡Encuentra a la Vieja Emma en Ventormenta y descubre si realmente es Emma Piedra Mácula. Si lo es, quizás quiera el paquete que Janice Piedra Mácula hizo para ella.‡Encuentra a la Vieja Emma en Ventormenta y descubre si realmente es Emma Piedra Mácula. Si lo es, quizás quiera el paquete que Janice Piedra Mácula hizo para ella.‡Trouver la vieille Emma à Stormwind, et découvrir si elle est en fait Emma Felstone. Si c’est le cas, elle appréciera peut-être le colis que Janice Felstone lui a préparé.‡找到暴风城的艾玛并弄清她是否就是艾玛·费尔斯通。如果是的话，那么她可能想要拿到詹妮丝·费尔斯通给她的包裹。‡找到暴風城的老艾瑪並弄清楚她是否就是艾瑪·菲爾斯通。如果她是,那麼她可能會想要珍妮絲·菲爾斯通為她製作的包裹.',
  }
},
[5049] = {
  {
    'O fado de Jeremias‡Грусть Иеремии‡Der Jammer des Jeremiah‡우울한 제레미어‡La depre de Jeremiah‡La depre de Jeremiah‡Le blues de Jeremiah‡杰雷米亚的忧伤‡傑雷米亞的憂傷',
    nil,
    'Encontre a Jeremias Mascotte na Cidade Baixa e veja se, de fato, ele é Jeremias Pedravil. Se for, talvez ele possa querer o pacote que Janice Pedravil lhe mandou.‡Найдите в Подгороде Иеремию Пэйсона и выясните, в самом ли деле он Иеремия Фелстоун. Если да, передайте ему посылку от Джанис Фелстоун.‡Sucht Jeremiah Lohnson in Unterstadt und findet heraus, ob er tatsächlich Jeremiah Teufelsstein ist. Wenn er es ist, dann möchte er vielleicht das Paket haben, das Janice Teufelsstein für ihn gepackt hat.‡언더시티에서 제레미어 페이슨을 찾아 그가 정말로 제레미어 펠스톤인지 확인하십시오. 그가 정말로 제레미어 펠스톤이라면 재니스 펠스톤이 보낸 소포를 원할지도 모릅니다.‡Encuentra a Jeremiah Payson en Entrañas y averigua si en realidad es Jeremiah Piedra Mácula. Si es así, quizás quiera el paquete que Janice Piedra Mácula preparó para él.‡Encuentra a Jeremiah Payson en Entrañas y averigua si en realidad es Jeremiah Piedra Mácula. Si es así, quizás quiera el paquete que Janice Piedra Mácula preparó para él.‡Trouver Jeremiah Payson à Fossoyeuse et découvrir s\'il est en fait Jeremiah Gangrepierre. Si c\'est le cas, il appréciera peut-être le colis que Janice Gangrepierre lui a préparé.‡在幽暗城找到杰雷米亚·派森并查明他是否就是你要找的杰雷米亚·费尔斯通。如果他是的话，那么他可能会想要拿到詹妮丝·费尔斯通寄给他的包裹。‡在幽暗城找到傑雷米亞·派森並查明他是否真的是傑雷米亞·費爾斯通。如果他是，那麼可能他會想要詹妮絲·費爾斯通做給他的包裹。',
  }
},
[5050] = {
  {
    'Pingente da Sorte‡Оберег удачи‡Glücksbringer‡행운의 부적‡Talismán de buena suerte‡Talismán de buena suerte‡Charme porte-bonheur‡好运护符‡好運符咒',
    nil,
    'Devolva o Meio-pingente da Sorte para Janice Pedravil nas Terras Pestilentas Ocidentais.‡Отнесите половинку талисмана Джанис Фелстоун в Западные Чумные земли.‡Bringt Janice Teufelsstein in den westlichen Pestländern die Hälfte ihres Glücksbringers zurück.‡서부 역병지대에 있는 재니스 펠스톤에게 행운의 부적 조각을 되돌려줘야 합니다.‡Devuelve a Janice Piedra Mácula en las Tierras de la Peste del Oeste su Medio talismán de buena suerte.‡Devuelve a Janice Piedra Mácula en las Tierras de la Peste del Oeste su Medio talismán de buena suerte.‡Rapporter son Demi-charme porte-bonheur à Janice Felstone dans les Maleterres de l’ouest.‡把半个好运护符还给西瘟疫之地的詹妮丝-费尔斯通。‡把半個好運符咒還給西瘟疫之地的詹妮絲·費爾斯通。',
  }
},
[5051] = {
  {
    'Um só coração‡Вторая половина‡Zwei Hälften vereint‡두 개의 조각이 하나되어‡Dos mitades hacen una‡Dos mitades hacen una‡Deux moitiés deviennent Une‡两半合一‡合二為一',
    nil,
    'Localize a outra metade do Pingente da Sorte em algum lugar da Fazenda Pedravil, nas Terras Pestilentas Ocidentais, e monte-o novamente.nnDê o Pingente da Sorte a Janice Pedravil, na Fazenda Pedravil, que fica nas Terras Pestilentas Ocidentais.‡Отыщите вторую половину оберега Удачи на ферме Фелстоун в Западных Чумных землях и соберите его.nnОтдайте оберег Удачи Джанис Фелстоун.‡Sucht auf dem Teufelssteinfeld in den westlichen Pestländern nach der anderen Hälfte des Glücksbringers und setzt ihn wieder zusammen.nnGebt den Glücksbringer Janice Teufelsstein auf dem Teufelssteinfeld in den westlichen Pestländern.‡서부 역병지대에 있는 펠스톤 농장에서 행운의 부적 목줄을 찾아 붙이십시오.nn서부 역병지대의 펠스톤 농장에 있는 재니스 펠스톤에게 행운의 부적을 가져가야 합니다.‡Localiza la otra mitad del talismán de la suerte en algún lugar de la Granja de Piedra Mácula, en las Tierras de la Peste del Oeste, y recomponlo.nnDale el talismán de la suerte a Janice Piedra Mácula en la Granja de Piedra Mácula, en las Tierras de la Peste del Oeste.‡Localiza la otra mitad del talismán de la suerte en algún lugar del Campo de Piedramácula, en las Tierras de la Peste del Oeste, y recomponlo.|nDale el talismán de la suerte a Janice Piedra Mácula en la Granja de Piedra Mácula, en las Tierras de la Peste del Oeste.‡Trouver l\'autre moitié du Charme porte-bonheur quelque part dans le périmètre de la Ferme Gangrepierre dans les Maleterres de l\'ouest et le recoller.nnDonner le Charme porte-bonheur à Janice Gangrepierre à la Ferme Gangrepierre, dans les Maleterres de l\'ouest.‡在西瘟疫之地的费尔斯通农场某地找到另外一半好运护符，并把两半护符合并。nn把好运护符交给西瘟疫之地费尔斯通农场的詹妮丝·费尔斯通。‡在西瘟疫之地的費爾斯通農場的某個地方找尋另外半個好運符並組合起來。|n把好運符交給西瘟疫之地費爾斯通農場的珍妮絲·菲爾斯通。',
  }
},
[5052] = {
  {
    'Estilhaços de Sangue de Agamaggan‡Кровавые осколки Агамаггана‡Blutsplitter von Agammagan‡아감마간의 혈석 파편‡Esquirlas de sangre de Agamaggan‡Esquirlas de sangre de Agamaggan‡Joyaux de sang d\'Agammagan‡阿迦玛甘的血岩碎片‡',
    nil,
    'Leve um Estilhaço de Sangue para Denterroto no Acampamento Taurajo, que fica nos Sertões.nnColete mais Estilhaços de Sangue se você quiser que ele <o/a> abençoe com o poder de Agamaggan.‡Принесите кровавый осколок Кривозубу в Лагерь Таурахо в Степи.nnСоберите побольше кровавых осколков, и он одарит вас силой, дарованной ему Агамагганом.‡Bringt Quetschzahn im Camp Taurajo im Brachland einen Blutsplitter.nnSammelt weitere Blutsplitter, wenn Ihr von ihm mit Agammagans Macht gesegnet werden möchtet.‡불모의 땅의 타우라조 야영지에 있는 뻐드렁니에게 혈석을 가져가야 합니다.nn아감마간의 힘을 빌린 축복을 받고 싶다면 최대한 많이 수집해야 합니다.‡Llévale una esquirla de sangre a Quebrantadientes en el Campamento Taurajo en Los Baldíos.nnReúne más esquirlas de sangre si quieres que te bendiga con el poder de Agamaggan.‡Llévale una esquirla de sangre a Quebrantadientes en el Campamento Taurajo en Los Baldíos.|nReúne más esquirlas de sangre si quieres que te bendiga con el poder de Agamaggan.‡Apporter un Joyau de sang à Mutiledent, au Camp Taurajo, dans les Tarides.nnCollectez plus de Joyaux de sang si vous souhaitez qu\'il vous gratifie de la puissance d\'Agamaggan.‡给陶拉祖营地的碎牙带去一块血岩碎片。nn如果你想要他赐予你阿迦玛甘的力量，就搜集更多的血岩碎片。‡',
  }
},
[5053] = {
  {
    '‡‡‡‡‡‡‡‡<UNUSED>',
    nil,
    '‡‡‡‡‡‡‡‡Test quest to see if mail is sent to your mailbox. Just hit complete, then go check your mail.|nHave a nice day.',
  }
},
[5054] = {
  {
    'Úrsius, o Dentilhaço‡Урсиус из щербозубов‡Ursius von den Splitterzahnbären‡톱니이빨곰 우르시우스‡Ursius de los Dentoesquirla‡Ursius de los Dentoesquirla‡Ursius des Crocs acérés‡碎齿熊尤西乌斯‡裂齒熊尤西烏斯',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Úrsius.‡По просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах убейте Урсиуса.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Ursius tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 우르시우스를 처치해달라고 요청했습니다.‡Ventisca Pezumbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous tuiez Ursius.‡永望镇的斯托姆·影蹄想要你去杀死尤西乌斯。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死尤西烏斯。',
  }
},
[5055] = {
  {
    'Brumeran dos Ventogelante‡Убить Брумеран‡Brumeran von den Eiswindschimären‡서리바람 브룸랜‡Brumerán de los Orvallo‡Brumerán de los Orvallo‡Brumeran des Noroît‡冰风奇美拉布鲁米兰‡冰風奇美拉布魯米蘭',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Brumeran.‡Убейте Брумеран по просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Brumeran tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 브룸랜을 처치해 달라고 요청했습니다.‡Ventisca Pezumbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous tuiez Brumeran.‡永望镇的斯托姆·影蹄想要你去杀死布鲁米兰。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死布魯米蘭。',
  }
},
[5056] = {
  {
    'Shy-Rotam‡Ши-Ротам‡Shy-Rotam‡샤이로탐‡Shi-Rotam‡Shi-Rotam‡Shy-Rotam‡希洛塔姆‡希洛塔姆',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você derrote Shy-Rotam.‡Убейте Ши-Ротам для Шторма Призрачное Копыто.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Shy-Rotam besiegt.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 샤이로탐을 처치해 달라고 요청했습니다.‡Ventisca Pezumbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous triomphiez de Shy-Rotam.‡永望镇的斯托姆-影蹄想要你去杀死希洛塔姆。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死希洛塔姆。',
  }
},
[5057] = {
  {
    'Feitos passados‡Прежние свершения‡Frühere Abenteuer‡과거의 업적‡Esfuerzos del pasado‡Esfuerzos del pasado‡Essais passés‡以往的努力‡過往的努力',
    nil,
    'Leve o Marcador de Ventania Casco Escuro para Melor Casco de Pedra no Penhasco do Trovão.‡Отнесите Знак Шторма Призрачное Копыто Мелору Каменное Копыто в Громовой Утес.‡Bringt Storm Schattenhufs Gutschein zu Melor Steinhuf in Donnerfels.‡썬더 블러프에 있는 멜로르 스톤후프에게 스톰 섀도후프의 문장을 가져가야 합니다.‡Lleva la Señal de Ventisca Pezumbría a Melor Pezuñapétrea de Cima del Trueno.‡Lleva la Señal de Ventisca Pezuña Umbría a Melor Pezuña Pétrea de Cima del Trueno.‡Apporter le Marqueur de Storm Sabot-d\'ombre à Melor Sabot-de-pierre aux Pitons du Tonnerre.‡把斯托姆·影蹄的徽记交给雷霆崖的梅洛·石蹄。‡把史東姆·影蹄的標記帶去給雷霆崖的梅洛·石蹄。',
  }
},
[5058] = {
  {
    'Diário da Sra. Dalson‡Дневник миссис Далсон‡Frau Dalsons Tagebuch‡달슨 부인의 일기‡El diario de la señorita Dalson‡El diario de la señora Dalson‡Journal de Mme Dalson‡达尔松夫人的日记‡達爾松夫人的日記',
    nil,
    'Um diário com páginas amareladas repousa aberto na última anotação:nn"Não sei o que vai acontecer agora que Haroldo está transformado. Dei tudo de mim para arrastá-lo ao único lugar que descobri ser possível mantê-lo preso em segurança. A chave está escondida comigo e rezo para que dê certo...nnEspero conseguir sair daqui, mas preciso de dinheiro para isso. Acho que nossos pertences estão todos no gabinete... e, por falar nisso, o Haroldo não guarda a chave consigo?nnPreciso descansar, estou morrendo de cansaço agora."‡В дневнике с пожелтевшими от времени страницами открыта последняя запись:nn"Гарольд превратился в нежить, и я не знаю, что теперь будет. Я из последних сил утащила его в единственное место, которое можно надежно запереть. Я держу ключ при себе, будем надеяться, что моя уловка сработает...nnНадеюсь, я смогу выбраться отсюда, но для этого нужны деньги. Все наши вещи в шкафу... и, кажется, Гарольд держал ключ от него при себе.nnПора мне отдохнуть, я смертельно устала."‡Ein Tagebuch mit vergilbten Seiten liegt aufgeschlagen da, sodass man den letzten Eintrag lesen kann:nn"Ich weiß nicht, was passieren wird, jetzt, wo Harold sich verwandelt hat. Es hat mich meine ganze Kraft gekostet, ihn zu dem einzigen Ort zu schleppen, den ich finden konnte, in dem er sicher eingesperrt ist und nicht herauskommen kann. Den Schlüssel habe ich bei mir und ich kann nur beten, dass es funktionieren wird ...nnIch hoffe, ich schaffe es, hier herauszukommen, aber dazu brauche ich Geld. Unsere ganzen Sachen sind alle im Schrank, glaube ich ... und jetzt, wo ich darüber nachdenke - trägt Harold den Schlüssel dazu nicht bei sich?nnIch muss darüber schlafen. Im Augenblick bin ich todmüde."‡책장이 누렇게 변해 가는 일기장의 마지막 페이지가 펼쳐진 채로 있습니다.nn"해럴드가 언데드로 변해버려 이제 무슨 일이 벌어질지 모르겠다. 안간힘을 써서 그를 가두고 문을 잠갔다. 열쇠를 감춰뒀는데, 효과가 있었으면 좋겠다...nn여기서 빠져나가고 싶지만 그러려면 돈이 든다. 우리 물건은 모두 장롱에 넣어 둔 것 같다... 그러고 보니 해럴드에게도 열쇠가 있지 않나?nn그건 일단 쉬고 나서 생각해야겠다. 너무 피곤하다."‡Un diario con páginas que comienzan a amarillear descansa abierto por la última entrada:nn"No sé lo que va a ocurrir ahora que Harold se ha transformado. Gasté todas mis fuerzas en arrastrarlo hasta el único lugar que pude encontrar y en el que pudiera quedar encerrado. Escondí en mí la llave y ruego porque funcione...nnEspero poder salir de aquí, pero necesito dinero para hacerlo. Creo que todas nuestras cosas están en el armario... y ahora que lo pienso, ¿no tiene Harold la llave con él?nnDescansaré, estoy terriblemente cansada."‡‡Un journal aux pages jaunies est ouvert à sa dernière page :nn"Je ne sais pas ce qui va se passer maintenant que Harold a changé. J\'ai dû faire de gros efforts pour le mettre dans le seul endroit où je savais qu\'il serait enfermé pour de bon. J\'ai la clé sur moi, et je prie que ça marche...nnJ\'espère pouvoir sortir d\'ici, mais j\'ai besoin d\'argent pour ça... Nos affaires sont dans le cabinet, je pense... Et maintenant que j\'y pense, Harold en a la clé sur lui ?nnJe vais me reposer, je suis morte de fatigue..."‡‡',
  }
},
[5059] = {
  {
    'Trancafiado‡Под замком‡Weggeschlossen‡잠긴 화장실‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡被鎖起來的農夫',
    nil,
    'A porta da casinha começou a se romper nas bordas, como se tivesse sido repetida e incessantemente forçada para abrir. No momento, ela está trancada pelo lado de fora.nnQuando você sacode a porta, escuta um gemido gutural vindo de dentro da casinha! O que quer que esteja lá dentro, não parece nada amigável.‡Дверь в служебное помещение потрескалась, будто кто-то долго и упорно пытался ее выломать. В настоящий момент она заперта снаружи.nnПодергав за ручку, мы слышите изнутри утробные стоны! Что бы ни скрывалось внутри, оно кажется совсем недружелюбным.‡Der von Splittern gezeichnete Türrahmen des Plumpsklos sieht aus, als ob wiederholt und unablässig versucht worden wäre, die Tür gewaltsam zu öffnen. Sie ist derzeit von außen fest verschlossen.nnAls Ihr an der Tür rüttelt, hört Ihr aus dem Inneren ein kehliges Stöhnen! Was auch immer sich im Inneren befindet, es klingt nicht freundlich.‡화장실문을 계속해서 억지로 열려고 한 듯, 가장자리가 쪼개지기 시작했습니다. 지금은 밖에서 단단히 잠겨 있습니다.nn문을 흔들어 보니 안에서 누군가 쉰 목소리로 신음하는 소리가 들립니다! 안에 있는 것이 무엇이든 간에 사나운 것 같습니다.‡La puerta de la letrina ha comenzado a astillarse en los bordes del marco, como si hubieran intentado forzarla varias veces y con insistencia. En este momento está cerrada desde fuera.nn¡Cuando mueves la puerta oyes un gemido gutural en el interior! Sea lo que sea, no parece muy amistoso.‡‡La porte des toilettes a commencé à se briser dans son pourtour comme si on avait essayé encore et encore de la forcer. Actuellement, elle est solidement verrouillée de l\'extérieur.nnQuand vous secouez la porte, vous entendez un gémissement guttural ! La créature qui est à l\'intérieur, quelle qu\'elle soit, n\'a pas l\'air amicale.‡‡',
  }
},
[5060] = {
  {
    'Trancafiado‡Под замком‡Weggeschlossen‡잠긴 장롱‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡被鎖起來的農夫',
    nil,
    'Um armário extremamente resistente se encontra na sua frente, trancado firmemente com uma fechadura embutida. A frente do armário tem marcas e arranhões profundos. Pode-se inferir disso que foram numerosas e violentas as tentativas fracassadas de revelar quaisquer segredos que o gabinete oculte.nnSe você quiser abrir este armário, precisa encontrar a chave.‡Перед вами массивный шкаф, надежно запертый на врезной замок. Дверцы шкафа сильно исцарапаны. Судя по всему, его не раз пытались взломать, чтобы посмотреть, что внутри.nnПохоже, без ключа этот шкаф не открыть.‡Vor Euch steht ein sehr stabiler Schrank, sicher verschlossen mit einem eingebauten Schloss. Die Vorderseite des Schranks ist mit tiefen Kratzern und Riefen übersät. Offensichtlich sind das die Zeichen zahlreicher und gewaltsamer fehlgeschlagener Versuche, die Geheimnisse zu enthüllen, die der Schrank derzeit verbirgt.nnWenn Ihr diesen Schrank öffnen wollt, müsst Ihr den Schlüssel finden.‡아주 튼튼해 보이는 장롱이 앞에 있습니다. 장롱에 달린 자물쇠로 단단히 잠겨 있습니다. 장롱의 앞 부분은 군데군데 찍힌 것으로 보아 누군가 안에 든 비밀을 꺼내려고 시도했던 것 같습니다.nn이 장롱을 열려면 열쇠가 있어야 합니다.‡Tienes ante ti un armario extremadamente fuerte y robusto, cerrado con un candado. La parte delantera del armario tiene marcas y arañazos muy profundos. Podría pensarse que son el resultado de numerosos y violentos intentos fallidos por desvelar los secretos que encierra el armario.nnSi quieres abrirlo tendrás que encontrar la llave.‡‡Un meuble très solide est en face de vous, hermétiquement clos par une serrure intégrée. Le devant du meuble est très rayé et abîmé. Cela pourrait venir de nombreuses et violentes tentatives pour percer les secrets que le meuble dissimule.nnSi vous voulez ouvrir ce meuble, il vous faudra trouver la clé.‡‡',
  }
},
[5061] = {
  {
    'Forma aquática‡Водный облик‡Wassergestalt‡바다표범 변신‡Forma acuática‡Forma acuática‡Forme aquatique‡水栖形态‡水棲形態 (夜精靈德魯伊)',
    nil,
    'Volte a Darnassus e mostre a Mathrengyl Ursivagus o Pingente do Leão Marinho.‡Вернитесь в Дарнасс и покажите Матренгилу Медвежьей Лапе свою подвеску Морского Льва.‡Kehrt nach Darnassus zurück und zeigt Mathrengyl Bärenfährte den Anhänger des Seelöwen.‡다르나서스로 돌아가 마스렌길 베어워커에게 바다표범의 펜던트를 보여 주어야 합니다.‡Vuelve a Darnassus y enséñale el colgante del león marino a Mathrengyl Garroso.‡Vuelve a Darnassus y enséñale el colgante del león marino a Mathrengyl Garroso.‡Retourner à Darnassus et montrer le Pendentif du lion de mer à Mathrengyl Pasdelours.‡回到达纳苏斯，让玛斯雷·驭熊者看看你的海狮坠饰。‡',
  }
},
[5062] = {
  {
    'Fogo sagrado‡Священное пламя‡Hochheiliges Feuer‡신성한 불‡El fuego Sagrado‡El fuego Sagrado‡Feu sacré‡神圣之火‡聖火',
    nil,
    'Reúna 10 punhados de Agave Incendia, depois consulte Magatha Temível Totem no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Соберите 10 листов огненной агавы и поговорите с Магатой Зловещий Тотем на Вершине Старейшин в Громовом Утесе.‡Sammelt 10 Scheffel Brandpulveragaven und beratet Euch dann mit Magatha Grimmtotem auf der Anhöhe der Ältesten in Donnerfels.‡불꽃 용설란 10포기를 모아 썬더 블러프 장로의 봉우리에 있는 마가타 그림토템을 찾아가야 합니다.‡Recoge 10 montones de pitas incendiarias y después pide consejo a Magatha Tótem Siniestro en el Alto de los Ancestros de Cima del Trueno.‡Recoge 10 pitas incendiarias y después pide consejo a Magatha Tótem Siniestro en el Alto de los Ancestros de Cima del Trueno.‡Ramasser 10 boisseaux d\'agave d\'Incendia, puis consulter Magatha Totem-sinistre sur la Cime des Anciens dans les Pitons du Tonnerre.‡收集10支火岩龙舌兰，然后去找雷霆崖长者高地的玛加萨·野性图腾。‡採集10支火岩龍舌蘭，然後去雷霆崖的長者高地尋找瑪加薩·恐怖圖騰。',
  }
},
[5063] = {
  {
    'Casquete do Sábio Escarlate‡Шапка ученого из Алого ордена‡Kappe des scharlachroten Wissenden‡붉은 학자의 모자‡Almete del Sabio Escarlata‡Almete del Sabio Escarlata‡La coiffe du savant écarlate‡血色学者之帽‡血色學者之帽',
    nil,
    'Para criar o Casquete do Sábio Escarlate, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 5 Suturas de Abominação Puídas; 8 Cristais Arcanos; 5 Fios Escarlate Encantados. nnVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления шапки ученого из Алого ордена вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 5 кусков потертого шовного материала поганища, 8 чародейских кристаллов, 5 зачарованных алых нитей. nnВы также должны будете уплатить 50 золотых монет за изготовление головного убора.‡Um die Kappe des scharlachroten Wissenden herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 5 ausgefranste Monstrositätenstickereien; 8 Arkankristalle; 5 verzauberte scharlachrote Fäden.nnIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡붉은 학자의 모자를 얻으려면 말리퍼스 다크해머에게 다음 재료를 갖다주어야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 5개, 신비한 수정 8개, 마력 깃든 붉은 실타래 5개nn제작비로 50골드도 가져가야 합니다.‡Para crear el Almete del Sabio Escarlata deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 8 cristales Arcanos; 5 hilos escarlata encantados.nnTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear el Almete del Sabio Escarlata deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 8 cristales Arcanos; 5 hilos escarlata encantados.|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour créer la Coiffe du savant écarlate, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 5 Coutures d\'Abomination effilochées ; 8 Cristaux des arcanes ; 5 Fils écarlates enchantés.nnIl faudra aussi payer 50 pièces d\'or pour le travail de fabrication.‡为了制造血色学者之帽，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，5根磨损的憎恶缝合线，8块奥术水晶，5根魔化红线。nn另外你还必须支付50金币的制作费用。‡為了製造血色學者之帽，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，5根磨損的憎惡縫合線，8塊秘法水晶，5根附魔血色絲線。|n另外你還必須支付50金幣的製作費用。',
  }
},
[5064] = {
  {
    'Espiando os Temível Totem‡Наблюдение за Зловещим Тотемом‡Grimmtotemspionage‡그림토템부족 염탐‡Espiando a los Tótem Siniestro‡Espiando a los Tótem Siniestro‡Espionner le Totem-sinistre‡恐怖图腾的密信‡偵察恐怖圖騰族',
    nil,
    'Localize e recupere os três Bilhetes Secretos no Pináculo da Nuvem Negra.‡Найдите и заберите три тайные записки на Пике Темного Облака.‡Sucht die drei geheimen Notizen im Düsterwolkengipfel und bringt sie zurück.‡먹구름 봉우리에 있는 비밀 쪽지 3개를 찾아 와야 합니다.‡Localiza y reúne las 3 notas secretas que hay en Cumbre de la Nube Negra.‡Localiza y reúne las 3 notas secretas que hay en Cumbre de la Nube Negra.‡Trouver et récupérer les trois Notes Secrètes à la Cime de Noir-nuage.‡在黑云峰拿到三封密信。‡在黑雲頂找出並拿回三封秘密訊息。',
  }
},
[5065] = {
  {
    'As tabuletas Mosh\'Aru perdidas‡Утраченные таблички Мошару‡Die verlorenen Schrifttafeln von Mosh\'aru‡모쉬아루의 잃어버린 서판‡Las tablillas perdidas Mosh\'aru‡Las tablillas perdidas Mosh\'aru‡Les tablettes perdues de Mosh\'aru‡失落的摩沙鲁石板‡失落的摩沙魯石板',
    nil,
    'Leve a Terceira e a Quarta Tabuletas Mosh\'Aru ao Prospector Botaférrea, em Tanaris.‡Принесите третью и четвертую таблички Мошару геологу Железному Башмаку в Танарис.‡Bringt Ausgrabungsleiter Eisenschuh in Tanaris die dritte und vierte Schrifttafel von Mosh\'aru.‡세 번째와 네 번째 모쉬아루 서판을 찾아 타나리스에 있는 발굴조사단장 아이언부트에게 갖다주어야 합니다.‡Llévale la tercera y cuarta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Llévale la tercera y cuarta tablillas Mosh\'aru al prospector Ferrobota, que está en Tanaris.‡Apporter la Troisième et la Quatrième tablette Mosh\'aru au Prospecteur Botte-de-fer à Tanaris.‡把第三块和第四块摩沙鲁石板交给塔纳利斯的勘查员詹斯·铁靴。‡把第三塊和第四塊摩沙魯石板交給塔納利斯的勘察員鐵靴。',
  }
},
[5066] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡사령관 아쉬람 발러피스트를 찾아야 합니다. 그의 주둔지는 알터랙 산맥 북쪽의 서리바람 야영지입니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base está situado en el Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouver le commandant Ashlam Vaillepoing. Son camp de base est situé au camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5067] = {
  {
    'Perneiras do Arcanismo‡Поножи тайны‡Gamaschen von Arcana‡아카나의 다리보호구‡Leotardos de Arcana‡Leotardos de Arcana‡Jambières d\'Arcana‡阿卡纳护腿‡阿卡納護腿',
    nil,
    'Para criar as Perneiras do Arcanismo, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 5 Suturas de Abominação Puídas; 5 Barras de Arcanita; 5 Fluidos Embalsamadores de Friomúrmuro.nnVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления поножей тайны вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 5 кусков потертого шовного материала поганища, 5 арканитовых слитков и 5 порций бальзамировочного состава Снегошепота. nnВам придется также заплатить 50 золотых за изготовление этого предмета.‡Um die Gamaschen von Arcana herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 5 ausgefranste Monstrositätenstickereien; 5 Arkanitbarren; 5 Einheiten Frostraunens Balsamierungsflüssigkeit.nnIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡아카나의 다리보호구를 얻으려면 말리퍼스 다크해머에게 다음 재료를 갖다주어야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 5개, 아케이나이트 주괴 5개, 프로스트위스퍼의 불변의 영액 5개.nn제작비로 50골드도 가져가야 합니다.‡Para crear los leotardos arcana deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 5 barras de arcanita; 5 líquidos de embalsamar de Levescarcha.nnTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear los leotardos arcana deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 5 costuras desgarradas de abominación; 5 barras de arcanita; 5 líquidos de embalsamar de Murmuhielo.|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour fabriquer les Jambières d\'Arcana, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 5 Coutures d\'Abomination effilochées ; 5 Barres d\'arcanite ; 5 Liquides d\'embaumement de Murmegivre.nnIl faudra également payer 50 pièces d\'or pour le travail de fabrication.‡为了制造阿卡纳护腿，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，5根磨损的憎恶缝合线，5块奥金锭，5份莱斯·霜语的防腐液。nn另外你还必须支付50金币的制作费用。‡為了製造阿卡納護腿，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，5根磨損的憎惡縫合線，5塊奧金錠，5份萊斯·霜語的防腐液。|n另外你還必須支付50金幣的製作費用。',
  }
},
[5068] = {
  {
    'Peitoral da Sede de Sangue‡Кираса кровавой жажды‡Brustplatte des Blutdurstes‡핏빛갈증의 흉갑‡Coraza Sed de Sangre‡Coraza Sed de Sangre‡La cuirasse carnassière‡嗜血胸甲‡血嗜胸甲',
    nil,
    'Para criar o Peitoral da Sede de Sangue, você precisa levar os seguintes itens para Málifus Trevamalho: 1 Pelego Imaculado da Fera; 10 Suturas de Abominação Puídas; 5 Barras de Arcanita; 5 Peles de Sombra.nnVocê também deverá pagar 50 ouros pela fabricação do item.‡Для изготовления кирасы кровавой жажды вам нужно принести Малифою Черномолоту 1 безупречную звериную шкуру, 10 кусков потертого шовного материала поганища, 5 арканитовых слитков и 5 шкур тени.nnВы также должны будете уплатить 50 золотых за изготовление доспеха.‡Um die Brustplatte des Blutdurstes herzustellen, müsst Ihr die folgenden Dinge zu Malyfous Düsterhammer bringen: 1 makelloser Balg der Bestie; 10 ausgefranste Monstrositätenstickereien; 5 Arkanitbarren; 5 Häute des Schattens.nnIhr müsst außerdem 50 Goldstücke für die Herstellung des Gegenstandes zahlen.‡핏빛갈증의 흉갑을 얻으려면 말리퍼스 다크해머에게 다음 재료를 갖다주어야 합니다. 온전한 괴수의 가죽 1개, 닳아해진 누더기골렘 조각 10개, 아케이나이트 주괴 5개, 어둠의 허물 5개.nn그리고 제작 비용으로 50골드도 갖고 가야 합니다.‡Para crear la coraza Sed de Sangre deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 10 costuras desgarradas de abominación; 5 barras de arcanita; 5 pieles de Sombra.nnTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Para crear la coraza Sed de Sangre deberás llevarle los siguientes objetos a Malyfous Martilloscuro: 1 pellejo de la Bestia prístino; 10 costuras desgarradas de abominación; 5 barras de arcanita; 5 pieles de Sombra.|nTambién tendrás que pagar 50 piezas de oro para la elaboración del almete.‡Pour fabriquer la Cuirasse carnassière, il faut rapporter les éléments suivants à Malyfous Sombremartel : 1 Peau de la Bête en parfait état ; 10 Coutures d\'Abomination effilochées ; 5 Barres d\'arcanite ; 5 Peaux des ombres.nnIl faudra également payer 50 pièces d\'or pour le travail de fabrication.‡为了制造嗜血胸甲，你必须将下列物品交给玛雷弗斯·暗锤：1块比斯巨兽的皮，10根磨损的憎恶缝合线，5块奥金锭，5块暗影之皮。nn另外你还必须支付50金币的制作费用。‡為了製造血嗜胸甲，你必須將下列物品交給瑪雷弗斯·暗錘:1塊比斯巨獸的皮，10根磨損的憎惡縫合線，5塊奧金錠，5塊暗影之皮。|n另外你還必須支付50金幣的製作費用。',
  }
},
[5081] = {
  {
    'A missão de Maxwell‡Миссия Максвелла‡Maxwells Mission‡맥스웰의 임무‡La misión de Maxwell‡La misión de Maxwell‡Mission de Maxwell‡麦克斯韦尔的任务‡麥克斯韋爾的任務',
    nil,
    'Vá para o Pico da Rocha Negra e mate o Senhor da Guerra Voone, o Grão-lorde Omokk e o Lorde Supremo Wyrmthalak. Fale novamente com o Oficial Maxwell quando terminar o trabalho.‡Отправляйтесь на пик Черной горы и устраните воеводу Вуна, вождя Омокка и повелителя Змейталака. По выполнении задания вернитесь к маршалу Максвеллу.‡Reist zur Schwarzfelsspitze und schaltet Kriegsmeister Voone, Hochlord Omokk und Oberanführer Wyrmthalak aus. Kehrt zu Marschall Maxwell zurück, wenn Eure Aufgabe erledigt ist.‡검은바위 첨탑으로 가서 대장군 부네와 대군주 오모크, 그리고 요새의 대군주 웜타라크를 처치해야 합니다. 임무를 완수하면 맥스웰 치안 대장에게 돌아가십시오.‡Viaja a la Cumbre de Roca Negra y destruye al maestro de guerra Voone, al alto señor Omokk y al Señor Supremo Vermiothalak. Vuelve junto al mariscal Maxwell cuando hayas acabado tu trabajo.‡Viaja a la Cumbre de Roca Negra y acaba con el maestro de guerra Voone, el alto señor Omokk y el señor supremo Vermiothalak.‡Se rendre au Pic Blackrock et tuer le maître de guerre Voone, le généralissime Omokk, et le seigneur Wyrmthalak. Retourner auprès du maréchal Maxwell quand la tâche a été accomplie.‡到黑石塔去消灭指挥官沃恩、欧莫克大王和维姆萨拉克。完成任务之后回到麦克斯韦尔元帅处复命。‡到黑石塔去消滅指揮官沃恩、歐莫克大王和維姆薩拉克主宰。完成任務之後回到麥克斯韋爾元帥處覆命。',
  }
},
[5082] = {
  {
    'A ameaça dos Invernosos‡Угроза со стороны Зимней Спячки‡Bedrohung durch die Winterfelle‡눈사태일족의 위협‡La amenaza de los Nevada‡La amenaza de los Nevada‡La menace des Tombe-hiver‡冬泉熊怪的威胁‡冬泉熊怪的威脅',
    nil,
    'Bruna Covaneve, de Hibérnia, quer que você mate 8 Desbravadores Invernosos, 8 Vigias do Covil dos Invernosos e 8 Totêmicos Invernosos.‡По просьбе Доновы Снегоноры из Зимних Ключей убейте 8 землепроходцев, 8 дозорных и 8 тотемистов из племени Зимней Спячки.‡Donova Schneeweh in Winterquell möchte, dass Ihr 8 Pfadfinder der Winterfelle, 8 Höhlenbehüter der Winterfelle und 8 Totemiker der Winterfelle erledigt.‡여명의 설원에 있는 도노바 스노우덴이 눈사태일족 길잡이 8마리, 눈사태일족 보초 8마리, 눈사태일족 토템술사 8마리를 처치해달라고 요청했습니다.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 vigías del cubil Nevada y 8 totémicos Nevada.‡Donova Cubilnevado de Cuna del Invierno quiere que mates 8 abrecaminos Nevada, 8 vigías del cubil Nevada y 8 totémicos Nevada.‡Donova Antreneige du Berceau-de-l\'Hiver veut que vous tuiez 8 Guides, 8 Protecteurs et 8 Totémiques de la tribu Tombe-hiver.‡冬泉谷的多诺瓦·雪山要你去杀死8个冬泉探路者、8个冬泉巢穴守卫和8个冬泉图腾师。‡冬泉谷的多諾瓦·雪山要你去殺死8個冬泉探路者、8個冬泉巢穴守衛和8個冬泉圖騰師。',
  }
},
[5083] = {
  {
    'Aguardente Invernosa‡Огненный эликсир Зимнего Сна‡Feuerwasser der Winterfelle‡눈사태일족 화주‡Aguardiente de los Nevada‡Aguardiente Nevada‡L\'eau de feu des Tombe-hiver‡冬泉火酒‡冬泉火水',
    nil,
    'Leve o Frasco Vazio de Aguardente para Bruna Covaneve em Hibérnia.‡Принесите Донове Снегоноре пустую флягу из-под огненной воды.‡Bringt das leere Feuerwasserfläschchen zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 빈 화주 시험관을 갖다주어야 합니다.‡Lleva el Frasco vacío de aguardiente a Donova Cubilnevado de Cuna del Invierno.‡Lleva el frasco vacío de aguardiente a Donova Cubilnevado de Cuna del Invierno.‡Apporter le Flacon d\'eau de feu vide à Donova Antreneige du Berceau-de-l\'Hiver.‡将空的火酒瓶交给冬泉谷的多诺瓦·雪山。‡將空的火水瓶交給冬泉谷的多諾瓦·雪山。',
  }
},
[5084] = {
  {
    'Cedendo à corrupção‡Поддавшиеся порче‡Der Verderbnis erliegen‡타락에 빠지다‡Sucumbir a la corrupción‡Sucumbir a la corrupción‡Corrompu‡堕落熊怪‡墮落熊怪',
    nil,
    'Investigue o acampamento dos pelursos Lenha Morta na parte norte de Selva Maleva para encontrar alguma pista.‡Исследуйте поселение фурболгов из племени Мертвого Леса в северной части Оскверненного леса в поисках ключа к разгадке.‡Durchsucht das Furbolglager der Totenwaldfelle im nördlichen Teil des Teufelswalds nach einem Hinweis.‡악령의 숲 북부에 있는 마른가지일족 펄볼그 야영지에서 단서를 찾아야 합니다.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Busca una pista en el campamento fúrbolg Muertobosque en el norte de Frondavil.‡Chercher un indice dans le camp des furbolgs Mort-bois, dans le nord de Gangrebois.‡搜寻费伍德森林北部的死木熊怪的营帐，继续寻找线索。‡搜尋費伍德森林北部的死木熊怪的營帳，繼續尋找線索。',
  }
},
[5085] = {
  {
    'Meleca misteriosa‡Таинственная слизь‡Geheimnisvoller Glibber‡신비한 액체‡Baba misteriosa‡Baba misteriosa‡Gelée mystère‡神秘的粘液‡神秘的粘液',
    nil,
    'Informe Bruna Covaneve sobre as suas descobertas.‡Вернитесь к Донове и сообщите ей о своих находках.‡Berichtet Donova Schneeweh von Euren Entdeckungen.‡발견한 사실을 도노바 스노우덴에게 알려야 합니다.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Informa sobre tus descubrimientos a Donova Cubilnevado.‡Aller faire un rapport de vos trouvailles à Donova Antreneige.‡将你的发现报告给多诺瓦·雪山。‡帶著你的發現回去找多諾瓦·雪山。',
  }
},
[5086] = {
  {
    'Horrores tóxicos‡Ядовитый Ужас‡Toxinschrecken‡맹독 정령‡Horrores tóxicos‡Horrores tóxicos‡Horreurs toxiques‡剧毒之水‡劇毒之水',
    nil,
    'Colha 3 Gotinhas de Horror Tóxico para Bruna Covaneve em Hibérnia.‡Соберите 3 капли ядовитого ужаса и принесите их Донове Снегоноре в Зимние Ключи.‡Sammelt 3 Toxinschreckentropfen für Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 맹독 정령 수액 3개를 갖다주어야 합니다.‡Recoge 3 gotitas horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Recoge 3 gotitas de horror tóxico para Donova Cubilnevado de Cuna del Invierno.‡Récolter 3 Gouttelettes d\'Horreur toxique pour Donova Antreneige au Berceau-de-l\'Hiver.‡为冬泉谷的多诺瓦·雪山收集3份剧毒水滴。‡為冬泉谷的多諾瓦·雪山收集3份劇毒水滴。',
  }
},
[5087] = {
  {
    'Mensageiros Invernosos‡Гонцы Зимней Спячки‡Läufer der Winterfelle‡눈사태일족 정찰꾼‡Corredores Nevada‡Corredores Nevada‡Les messagers des Tombe-hiver‡冬泉信使‡冬泉信差',
    nil,
    'Encontre os Mensageiros Invernosos e impeça-os de entregar o carregamento à Aldeia dos Invernosos.‡Найдите гонцов из племени Зимней Спячки и не позвольте им донести их груз до их деревни.‡Sucht die Läufer der Winterfelle und hindert sie daran, ihre Lieferung zum Lager der Winterfelle zu bringen.‡눈사태일족 정찰꾼을 찾아 눈사태일족 마을로 물건을 전달하는 것을 막아야 합니다.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Encuentra a los corredores Nevada y detenlos antes de que entreguen su cargamento en Poblado Nevada.‡Trouver les Messagers Tombe-hiver et les empêcher de livrer leur cargaison au village Tombe-hiver.‡找到冬泉信使，阻止他们向冬泉村运送物品。‡找到冬泉信差，阻止他們向冬泉村運送物品。',
  }
},
[5088] = {
  {
    'Arikara‡Арикара‡Arikara‡아리카라‡Arikara‡Arikara‡Arikara‡阿利卡拉‡[Deprecated for 4.x]阿利卡拉',
    nil,
    'Mate Arikara. Leve seus restos mortais e o pó de Incendia para Motega Barba de Fogo no Posto Confinalvo como prova do seu feito.‡Убейте Арикару и в качестве доказательства принесите ее останки вместе с воспламеняющим порошком Мотеге Огненной Гриве на заставу Белого Плеса.‡Erschlagt Arikara. Bringt ihre Überreste und das Brandpulver zu Motega Feuermähne im Weißgipfelposten als Beweis für Eure Tat.‡아리카라를 처치하고 그 증거물로 아리카라의 가죽과 불꽃 가루를 백사장 야영지에 있는 모테가 파이어메인에게 가져가야 합니다.‡Mata a Arikara. Llévale sus restos y el polvo de incendiaria a Motega Pirocabello al Campamento del Tramo Blanco como prueba de tus actos.‡Mata a Arikara. Llévale sus restos y el polvo de incendiaria a Motega Pirocabello al Campamento del Tramo Blanco como prueba de tus actos.‡Tuer Arikara. Rapporter sa dépouille et de la poudre d\'incendia à Motega Crin-de-feu au Poste de Blanc-relais comme preuve de votre acte.‡杀死阿利卡拉。把她的遗体和火岩粉交给白沙岗哨的莫特加·火鬃作为证明。‡',
  }
},
[5089] = {
  {
    'Comando do General Drakkisath‡Приказ генерала Драккисата‡General Drakkisaths Befehl‡사령관 드라키사스의 명령서‡Orden del general Drakkisath‡Orden del general Drakkisath‡Ordres du général Drakkisath‡达基萨斯将军的命令‡達基薩斯將軍的命令',
    nil,
    'Leve o Comando do General Drakkisath para o Oficial Maxwell nas Estepes Ardentes.‡Отнесите приказ генерала Драккисата маршалу Максвеллу в Пылающие степи.‡Bringt den Befehl von General Drakkisath zu Marschall Maxwell in der brennenden Steppe.‡불타는 평원에 있는 치안대장 맥스웰에게 사령관 드라키사스의 명령서를 가져가야 합니다.‡Llévale la orden del general Drakkisath al mariscal Maxwell en Las Estepas Ardientes.‡Llévale la orden del general Drakkisath al mariscal Maxwell en Las Estepas Ardientes.‡Remettre les Ordres du général Drakkisath au maréchal Maxwell dans les Steppes ardentes.‡把达基萨斯将军的命令交给燃烧平原的麦克斯韦尔元帅。‡把達基薩斯將軍的命令交給燃燒平原的麥克斯韋爾元帥。',
  }
},
[5090] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡아쉬람 발러피스트 사령관을 찾아가야 합니다. 그의 본진은 알터랙 산맥 북부 서리바람 야영지에 있습니다.‡Busca al comandante Ashlam Puñovalor; su campamento base está en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouver le commandant Ashlam Vaillepoing. Son camp de base est le Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5091] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Comandante Ashlam Punhobom. Ele montou base no Acampamento Ventogelante, ao norte das Montanhas de Alterac.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡아쉬람 발러피스트 사령관을 찾아가야 합니다. 그의 본진은 알터랙 산맥 북부 서리바람 야영지에 있습니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouver le commandant Ashlam Vaillepoing. Il s\'est établi au Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[5092] = {
  {
    'Abrindo caminho‡Зачистка территории‡Den Weg räumen‡통로 확보‡Despejando el camino‡Despejar el camino‡Nettoyer le passage‡扫清道路‡掃清道路',
    nil,
    'Mate 10 Esfoladores Descarnados e 10 Carniçais Salivantes na Colina do Pesar.nnFale novamente com o Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Убейте 10 скелетов-свежевателей и 10 слюнявых вурдалаков на холме Печали.nnВернитесь к командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Tötet 10 Skelettschinder und 10 sabbernde Ghuls in Trauerhügel.nnKehrt zu Kommandant Ashlam Ehrenschlag am Zugwindlager, westliche Pestländer, zurück.‡슬픔의 언덕에 있는 해골 타작꾼 10마리와 걸신들린 구울 10마리를 처치해야 합니다.nn그런 다음 서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 돌아가십시오.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.nnVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Mata 10 despellejadores esqueléticos y 10 necrófagos esclavizantes en la Colina de las Penas.|nVuelve con el comandante Ashlam Puñovalor en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Tuer 10 Ecorcheurs Squelettes et 10 Goules écumantes sur la Colline des chagrins.nnRetourner auprès du commandant Ashlam Vaillepoing au camp du Noroît, dans les Maleterres de l\'ouest.‡杀掉悔恨岭中的10个骷髅剥皮者和10个被奴役的食尸鬼。nn然后向西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特复命。‡殺掉悔恨嶺中的10個骷髏撕掠者和10個被奴役的食屍鬼。|n然後向西瘟疫之地冰風營地的指揮官阿胥拉姆·瓦羅菲斯特覆命。',
  }
},
[5093] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Отыщите верховного палача Деррингтона. Его базовый лагерь находится у Бастиона, к востоку от Тирисфальских лугов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 델링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高級執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5094] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Отыщите верховного палача Деррингтона. Его базовый лагерь находится у Бастиона, к востоку от Тирисфальских лугов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 델링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高級執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5095] = {
  {
    'Um chamado às armas: as Terras Pestilentas!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Procure o Alto-executor Arcabuz. A base de operações dele fica no Baluarte, a leste das Clareiras de Tirisfal e da Cidade Baixa.‡Найдите верховного палача Деррингтона. Его базовый лагерь расположен в Бастионе к востоку от Тирисфальских лесов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 델링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高級執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[5096] = {
  {
    'Distrações escarlate‡Вылазка в стан Алого ордена‡Scharlachrote Ablenkung‡붉은십자군의 주의 끌기‡Distracción Escarlata‡Distracción Escarlata‡Diversions écarlates‡误导血色十字军‡誤導血色十字軍',
    nil,
    'Vá até a base de operações da Cruzada Escarlate, que fica entre o Campo Pedravil e as Lágrimas de Dalson, e destrua a Tenda de Comando.nnPlante a bandeira do Flagelo no acampamento e fale novamente com o Alto-executor Arcabuz no Baluarte, nas Terras Pestilentas Ocidentais.‡Отправляйтесь в лагерь Алого ордена между полем Джанис и Слезами Далсона и уничтожьте командный шатер.nnРазместите в лагере знамя Плети и возвращайтесь к верховному палачу Деррингтону в Бастион, в Западные Чумные земли.‡Zieht zum Basislager des Scharlachroten Kreuzzugs zwischen dem Teufelssteinfeld und Dalsons Tränenfeld und zerstört sein Kommandozelt.nnLasst das Banner der Geißel im Lager wehen und kehrt dann zu Hochexekutor Derrington am Bollwerk in den westlichen Pestländern zurück.‡펠스톤 농장과 달슨의 눈물 사이에 있는 붉은십자군의 야영지로 가서 지휘 막사를 파괴하십시오.nn기지에 스컬지 깃발을 세운 후, 서부 역병지대의 보루에 있는 고위집행관 델링턴에게 돌아가야 합니다.‡Adéntrate en el campamento base de la Cruzada Escarlata entre el Campo de Piedramácula y el Llanto de Dalson y destruye su tienda de mando.nnColoca el estandarte de la Plaga en el campamento y vuelve con el Sumo Ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡Adéntrate en el campamento base de la Cruzada Escarlata entre el Campo de Piedramácula y el Llanto de Dalson y destruye su tienda de mando.|nColoca el estandarte de la Plaga en el campamento y vuelve con el sumo ejecutor Derrington en El Baluarte en las Tierras de la Peste del Oeste.‡Se rendre au camp de base de la Croisade écarlate situé entre le Champ de Gangrepierre et les Larmes de Dalson et détruire leur tente d\'état-major.nnPlacer la bannière du Fléau sur le camp, puis revenir auprès du Grand exécuteur Derrington à la Barricade, dans les Maleterres de l\'ouest.‡到血色十字军建在费尔斯通农场和达尔松之泪之间的营地去，摧毁他们的指挥帐篷。nn将亡灵天灾的战旗插在营地中，然后回到西瘟疫之地亡灵壁垒的高级执行官德灵顿那儿。‡到血色十字軍建在費爾斯通農場和達爾松之淚之間的營地去，摧毀他們的指揮帳篷。|n將天譴軍團戰旗插在營地中，然後回到西瘟疫之地亡靈壁壘的高級執行官德靈頓那兒。',
  }
},
[5097] = {
  {
    'Você não vê as torres?‡Сторожевые башни‡Turm um Turm‡감시탑 공격 준비‡Todas las atalayas‡Todas las atalayas‡Tout au long des tours de guet‡标记哨塔‡標記哨塔',
    nil,
    'Usando a Tocha Sinalizadora, marque cada torre em Andorhal. Você tem que ficar na entrada da torre para conseguir marcá-la.nnDepois de marcar as quatro torres, leve a Tocha Sinalizadora de volta para o Comandante Ashlam Punhobom no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отметьте все башни Андорала при помощи сигнального факела; задействовать факел следует, находясь в дверном проеме каждой из башен.nnОтметив все четыре башни, следует вернуть сигнальный факел командиру Ашламу Отважному Кулаку в лагерь Промозглого Ветра в Западных Чумных землях.‡Markiert mit der Signalfackel jeden Turm in Andorhal; Ihr müsst im Eingang jedes Turmes stehen, um ihn erfolgreich zu markieren.nnWenn alle vier Türme markiert sind, bringt Ihr die Signalfackel zu Kommandant Ashlam Ehrenschlag am Zugwindlager, westliche Pestländer, zurück.‡신호 횃불로 안돌할의 각 탑을 표시해야 합니다. 성공적으로 표시하려면 탑의 입구에 서야 합니다.nn네 개의 감시탑에 모두 표시했으면 신호 횃불을 서부 역병지대의 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 가져가십시오.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.nnCuando estén marcadas las cuatro atalayas devuelve la antorcha de aviso al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|nCuando estén marcadas las cuatro atalayas devuelve la antorcha de aviso al comandante Ashlam Puñovalor del Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡À l\'aide de la Torche-balise, marquer chaque tour à Andorhal ; il faut se tenir dans l\'embrasure de la porte de la tour pour pouvoir la marquer.nnQuand les quatre tours seront marquées, rapporter la Torche-balise au commandant Ashlam Vaillepoing au camp du Noroît, dans les Maleterres de l\'ouest.‡使用信号火炬为安多哈尔城中的四座哨塔做上标记，你必须站在哨塔门口才能成功地进行标记。nn在做完了标记之后，将信号火炬还给西瘟疫之地冰风岗的指挥官阿什拉姆·瓦罗菲斯特。‡使用信號火炬為安多哈爾城中的四座哨塔做上標記，你必須站在哨塔門口才能成功地進行標記。|n在做完了標記之後，將信號火炬還給西瘟疫之地冰風營地的指揮官阿胥拉姆·瓦羅菲斯特。',
  }
},
[5098] = {
  {
    'Você não vê as torres?‡Сторожевые башни‡Turm um Turm‡감시탑 공격 준비‡Todas las atalayas‡Todas las atalayas‡Tout au long des tours de guet‡标记哨塔‡標記哨塔',
    nil,
    'Usando a Tocha Sinalizadora, marque cada torre em Andorhal. Você tem que ficar na entrada da torre para conseguir marcá-la.nnDepois de marcar as quatro torres, leve a Tocha Sinalizadora de volta para o Alto-executor Arcabuz no Baluarte, nas Terras Pestilentas Ocidentais.‡Отметьте все башни Андорала при помощи сигнального факела; задействовать факел следует, находясь в дверном проеме каждой из башен.nnОтметив все четыре башни, следует вернуть сигнальный факел верховному палачу Деррингтону в Бастион в Западных Чумных землях.‡Markiert mit der Signalfackel jeden Turm in Andorhal; Ihr müsst im Eingang jedes Turmes stehen, um ihn erfolgreich zu markieren.nnWenn alle vier Türme markiert sind, bringt Ihr die Signalfackel zu Hochexekutor Derrington am Bollwerk, westliche Pestländer, zurück.‡신호 횃불로 안돌할의 각 탑을 표시해야 합니다. 성공적으로 표시하려면 탑의 입구에 서야 합니다.nn네 개의 감시탑에 모두 표시했으면 신호 횃불을 서부 역병지대의 보루에 있는 고위집행관 델링턴에게 가져가야 합니다.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.nnCuando estén marcadas las cuatro atalayas, devuelve la antorcha de aviso al Sumo Ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡Con la antorcha de aviso, marca las atalayas de Andorhal. Tendrás que estar en la entrada de la atalaya para poder marcarla.|nCuando estén marcadas las cuatro atalayas, devuelve la antorcha de aviso al sumo ejecutor Derrington en El Baluarte, en las Tierras de la Peste del Oeste.‡À l\'aide de la Torche-balise, marquer chaque tour à Andorhal ; il faut se tenir dans l\'embrasure de la porte de la tour pour pouvoir la marquer.nnQuand les quatre tours seront marquées, rapporter la Torche-balise au Grand exécuteur Derrington à la Barricade, dans les Maleterres de l\'ouest.‡使用信号火炬为安多哈尔城中的四座哨塔做上标记，你必须站在哨塔门口才能成功地进行标记。nn在做完了标记之后，将信号火炬还给西瘟疫之地亡灵壁垒的高级执行官德灵顿。‡使用信號火炬為安多哈爾城中的四座哨塔做上標記，你必須站在哨塔門口才能成功地進行標記。|n在做完了標記之後，將信號火炬還給西瘟疫之地亡靈壁壘的高級執行官德靈頓。',
  }
},
[5101] = {
  {
    'Lee\'s Ultimate Test Quest... of Doom!‡Великое тестовое задание... Судьбы!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Misión de prueba suprema de Lee... ¡apocalíptica!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!‡Lee\'s Ultimate Test Quest... of Doom!',
    nil,
    'Mate 6 ovelhas para o Dito e depois corra pela sua vida!nnTá... brincadeirinha... basta matar as ovelhas.‡Убейте 6 овец для Бенни и бегите со всех ног!nnnnnНасчет ног я пошутил.‡Tötet 6 Schafe für Benny... und dann nehmt die Füße in die Hand und rennt weg, was das Zeug hält!nnnnnWar nur \'n Scherz... was das Rennen angeht.‡베니에게 가져갈 양 6마리를 잡은 다음 눈썹이 휘날리게 달려가십시오!nnnnn\'휘날리게\'는 농담이고... 양을 다 잡은 다음 베니에게 가면 됩니다.‡Mata 6 ovejas para Benny ¡y corre como el demonio!nnnnnEs una broma... Lo de correr como un demonio.‡Mata 6 ovejas para Benny ¡y corre como el demonio!|n|nEs una broma... lo de correr como un demonio.‡Tuer 6 moutons pour Benny puis prendre les jambes à son cou !nnnnnNon, c\'est une blague... pour ce qui est de courir.‡[Kill 6 sheep for Benny and then run like hell!nnnnnJust kidding... about the running part.]‡幫本尼殺死六隻羊然後趕快瘋狂地跑開!|n|n|n跑開的部分是開玩笑的。',
  }
},
[5102] = {
  {
    'O fim do General Drakkisath‡Кончина генерала Драккисата‡General Drakkisaths Niedergang‡사령관 드라키사스 처치‡Muerte al general Drakkisath‡Muerte al general Drakkisath‡La reddition du général Drakkisath‡达基萨斯将军之死‡達基薩斯將軍之死',
    nil,
    'Viaje de volta ao Pico da Rocha Negra e destrua o General Drakkisath. Depois, fale novamente com o Oficial Maxwell.‡Отправьтесь на пик Черной горы и устраните генерала Драккисата. По выполнении задания вернитесь к маршалу Максвеллу.‡Begebt Euch zur Schwarzfelsspitze und schaltet General Drakkisath aus. Kehrt zu Marschall Maxwell zurück, wenn Eure Aufgabe erledigt ist.‡검은바위 첨탑으로 가서 사령관 드라키사스를 처치해야 합니다. 임무를 완수하면 치안대장 맥스웰에게 돌아가야 합니다.‡Viaja hasta la Cumbre de Roca Negra y mata al general Drakkisath. Vuelve junto al mariscal Maxwell cuando hayas acabado tu trabajo.|n‡Viaja hasta la Cumbre de Roca Negra y mata al general Drakkisath.‡Rendez-vous au Pic Rochenoire et tuez le général Drakkisath, puis retournez voir le maréchal Maxwell.‡到黑石塔去杀掉达基萨斯将军，完成任务之后就回到麦克斯韦尔元帅那里复命。‡去黑石塔殺掉達基薩斯將軍。當任務完成之後回去找麥斯威爾指揮官。',
  }
},
[5103] = {
  {
    'Morte muito ardente‡Смерть в огне‡Heißer, feuriger Tod‡뜨거운 화형‡Muerte abrasadora‡Muerte abrasadora‡Mort brûlante‡火热的死亡‡火熱的死亡',
    nil,
    'Alguém neste mundo deve saber o fazer com essas manoplas. Boa sorte!‡Наверняка в этом мире есть кто-то, кто знает, что делать с этими рукавицами.‡Jemand auf dieser Welt muss doch wissen, was mit diesen Stulpen zu tun ist. Viel Glück!‡아제로스 어딘가에 누군가가 이 건틀릿으로 뭘 해야 하는지 알고 있을 겁니다. 행운을 빕니다!‡Alguien en este mundo debe de saber qué hacer con estos guanteletes. ¡Suerte!‡Alguien en este mundo debe de saber qué hacer con estos guanteletes. ¡Suerte!‡Quelqu\'un dans ce monde doit bien savoir à quoi servent ces gantelets. Bonne chance !‡世界上一定有人知道关于这副手套的事情，祝你好运！‡世界上一定有人知道關於這副護手的事情，祝你好運!',
  }
},
[5121] = {
  {
    'Chefe Supremo Invernoso‡Верховный вождь племени Зимней Спячки‡Oberhäuptling der Winterfelle‡대족장 눈사태‡Gran Jefe Nevada‡Gran Jefe Nevada‡Le grand chef Tombe-hiver‡冬泉酋长‡冬泉酋長',
    nil,
    'Bruna Covaneve em Hibérnia quer que você derrote o Chefe Supremo Invernoso.‡По просьбе Доновы Снегоноры из Зимних Ключей убейте верховного вождя племени Зимней Спячки.‡Donova Schneeweh in Winterquell möchte, dass Ihr den Oberhäuptling der Winterfelle besiegt.‡여명의 설원에 있는 도노바 스노우덴이 대족장 눈사태를 처치해 달라고 부탁했습니다.‡Donova Cubilnevado de Cuna del Invierno quiere que derrotes al Gran Jefe Nevada.‡Donova Cubilnevado de Cuna del Invierno quiere que derrotes al Gran Jefe Nevada.‡Donova Snowden du Berceau-de-l\'Hiver veut que vous triomphiez du Grand chef Tombe-hiver.‡冬泉谷的多诺瓦·雪山要你去击败冬泉酋长。‡冬泉谷的多諾瓦·雪山要你去擊敗冬泉酋長。',
  }
},
[5122] = {
  {
    'O Medalhão da Fé‡Медальон Веры‡Das Medaillon des Glaubens‡신념의 메달‡El medallón de Fe‡El medallón de Fe‡Le médaillon de foi‡信仰奖章‡信仰勳章',
    nil,
    '‡Укрывшись в этой часовне, я могу противостоять порче, заполняющей мое существо. Но если я покину эти стены, я немедленно превращусь в нежить. Я знаю, что есть на свете медальон, именуемый медальоном веры, который может дать мне силу противостоять порче. nnПрошу тебя, Димиллион, принеси мне медальон. Его охраняет безумный фанатик Малор Ревностный, один из Алых. Ты найдешь его в недрах бастиона Алого ордена в западной части Стратхольма.‡Die Macht dieser Kapelle gibt mir die Kraft, der Verderbnis in meinem Herzen zu widerstehen. Wenn ich sie verlasse, werde ich zu einem Todesritter. Aber es gibt ein Medaillon, das Medaillon des Glaubens, das mir so viel Kraft geben wird, dass ich trotzdem gehen kann.nnBitte, <Name>, findet das Medaillon für mich. Es wird von Malor dem Eifrigen bewacht, einem wahnsinnigen Mitglied der Scharlachroten Bruderschaft. Er lebt tief in der scharlachroten Bastion im westlichen Stratholme.‡난 이 교회의 힘으로 내 가슴 속의 타락에 저항하고 있소. 내가 이곳을 떠나면 죽음의 기사로 변해 버리게 될거요. 하지만 신념의 메달만 있으면 내가 이곳을 떠날 수 있는 힘을 줄 거요.nn부탁이니 그 메달을 가져다주시오. 그 메달은 광신자 말로가 지키고 있는데, 이 미친 녀석은 스트라솔름 서쪽에 있는 붉은십자군 성채에 사는 붉은십자군의 일원이라오.‡El poder de esta capilla me da la fuerza para resistir la corrupción que habita en mi corazón. Si cedo, me convertiré en un caballero de la muerte. Pero hay un medallón, el medallón de fe, que me dará la fuerza que necesito para partir.nnPor favor, <nombre>, recupera el medallón. Está en manos de Malor el Fanático, un miembro demente de la Hermandad Escarlata, que reside en las profundidades del Bastión Escarlata en Stratholme occidental.‡‡Le pouvoir de cette chapelle me donne la force de résister à la corruption qui envahit mon coeur. Si je la quitte, je deviendrai un Chevalier de la mort. Mais il existe un médaillon de la foi qui me donnera la force dont j\'ai besoin pour partir.nnS\'il vous plaît, <nom>, trouvez le médaillon. Il est gardé par Malor le Zélé, un membre fou de la Croisade écarlate qui réside aux tréfonds du Bastion écarlate à l\'ouest de Stratholme.‡‡',
  }
},
[5123] = {
  {
    'A peça final‡Последний фрагмент мозаики‡Das letzte Stück‡마지막 단서‡La pieza final‡La pieza final‡Le dernier morceau‡最后一片‡最後一片',
    nil,
    'Leve o Registro Escrito Grosseiramente para Bruna Covaneve em Hibérnia.‡Отнесите неразборчиво исписанный журнал Донове Снегоноре в Зимние Ключи.‡Bringt das kunstlos geschriebene Logbuch zu Donova Schneeweh in Winterquell.‡여명의 설원에 있는 도노바 스노우덴에게 휘갈겨 쓴 일지를 가져다주어야 합니다.‡Lleva el Diario mal escrito a Donova Cubilnevado de Cuna del Invierno.‡Lleva el diario mal escrito a Donova Cubilnevado de Cuna del Invierno.‡Apporter le Journal mal écrit à Donova Snowden au Berceau-de-l\'Hiver.‡把潦草的日志交给冬泉谷的多诺瓦-雪山。‡把字跡潦草的日誌帶去給冬泉谷的多諾瓦·雪山。',
  }
},
[5124] = {
  {
    'Manoplas de placa abrasadoras‡Огненные латные рукавицы‡Feurige Plattenstulpen‡불꽃의 판금 건틀릿‡Guanteletes de placas ígneas‡Guanteletes de placas ígneas‡Gantelets en plaques de feu‡炽热板甲护手‡熾熱鎧甲護手',
    nil,
    'Leve 6 Barras de Tório Encantado, 2 Essências do Fogo e 4 Rubis-estrela para Málifus Trevamalho. Você também vai ter que entregar suas Manoplas de Placa Crua.‡Принесите Малифою Черномолоту 6 зачарованных ториевых слитков, 2 сущности огня и 4 звездных рубина. Вам также нужно будет расстаться с неопалимыми латными рукавицами.‡Bringt Malyfous Düsterhammer 6 verzauberte Thoriumbarren, 2 Essenzen des Feuers und 4 Sternrubine. Ihr müsst außerdem Eure ungebrannten Plattenstulpen abgeben.‡마력 깃든 토륨 주괴 6개, 불의 정수 2개, 별루비 4개를 말리퍼스 다크해머에게 갖다주어야 합니다. 불타지 않은 판금 건틀릿도 주어야 합니다.‡Lleva a Malyfous Martilloscuro 6 barras de torio encantado, 2 esencias de fuego y 4 rubíes estrellados. También tendrás que entregarle tus guanteletes de placas sin templar.‡Lleva a Malyfous Martilloscuro 6 barras de torio encantado, 2 esencias de fuego y 4 rubíes estrellados. También tendrás que entregarle tus guanteletes de placas sin templar.‡Apporter à Malyfous Sombremartel 6 Barres de thorium enchanté, 2 Essences de feu, et 4 Rubis étoilés. Lui remettre également vos Gantelets en plaques inachevés.‡将6块魔化瑟银锭、2份火焰精华和4颗红宝石交给玛雷弗斯·暗锤。另外你还得把未淬火的板甲护手也交给他。‡將6塊附魔瑟銀錠、2份火焰精華和4顆紅寶石交給瑪雷弗斯·暗錘。另外你還得把未淬火的鎧甲護手也交給他。',
  }
},
[5125] = {
  {
    'O ajuste de contas de Aurius‡Слова Аурия‡Aurius\' Abrechnung‡아우리우스의 복수‡La estimación de Aurius‡La estimación de Aurius‡L\'estimation d\'Aurius‡奥里克斯的清算‡奧里爾斯的清算',
    nil,
    '‡Я умираю, Арраон… но душа моя обрела спасение. Я так многим обязан тебе... Прошу, прими это... И продолжай биться за правое дело, храбрый |3-6(Друид)!‡<Name>, ich sterbe... aber meine Seele ist gerettet. Dafür schulde ich Euch mehr, als man mit Worten ausdrücken kann. Bitte, nehmt dies... und kämpft weiter so mutig, <Klasse>!‡‡<nombre>, me estoy muriendo... pero mi alma está salvada. Por eso, te debo más de lo que jamás podré expresar. Por favor, acepta esto, ¡y sigue luchando... valiente <clase>!‡‡<nom>, je me meurs… mais mon âme est sauve, et pour cela je vous dois plus que les mots peuvent exprimer. Je vous en prie, prenez ceci… et continuez le combat, brave <classe> !‡‡',
  }
},
[5126] = {
  {
    'O conto de Vegax‡История Лоракса‡Lorax\' Geschichte‡로락스의 이야기‡La historia de Lorax‡La historia de Lorax‡L\'histoire de Lorax‡罗拉克斯的故事‡羅拉克斯的故事',
    nil,
    'Fale com Vegax. Escute o que ele tem a dizer.‡Поговорите с Лораксом. Выслушайте то, что он вам расскажет.‡Sprecht mit Lorax. Hört, was er zu sagen hat.‡로락스와 대화를 해서 그가 하는 이야기를 들어야 합니다.‡Habla con Lorax. Escucha todo lo que tiene que decirte.|n‡Habla con Lorax. Escucha todo lo que tiene que decirte.‡Parler à Lorax. Écouter ce qu\'il a à dire.‡与罗拉克斯谈一谈，听听他要说什么。‡與羅拉克斯談話，聽聽他說了什麼。',
  }
},
[5127] = {
  {
    'A forja demoníaca‡Демонова кузня‡Die Dämonenschmiede‡악마의 룬‡La forja demoníaca‡La forja demoníaca‡La forge démoniaque‡恶魔熔炉‡惡魔熔爐',
    nil,
    'Viaje para o Pico da Rocha Negra e encontre Goraluk Rachadastra. Mate-o e use o Pique Manchado de Sangue no cadáver dele. Quando a alma dele tiver sido canalizada, o pique ficará Manchado de Almas.nnVocê também precisa encontrar o Peitoral Rúnico de Metal Bruto.nnLeve o Pique Manchado de Almas e o Peitoral Rúnico de Metal Bruto para Vegax, em Hibérnia.‡Отправляйтесь на пик Черной горы и найдите Горалука Разбитую Наковальню. Убейте его, а потом воткните в труп окровавленную пику. Таким образом пика вытянет его душу и окрасится ей.nnКроме того, вам нужно найти заготовку рунической кирасы.nnОтнесите пику и кирасу Лораксу в Зимних Ключах.‡Begebt Euch zur Schwarzfelsspitze und sucht Goraluk Hammerbruch. Erschlagt ihn und wendet dann die blutbefleckte Pike auf seine Leiche an. Nachdem seine Seele abgesaugt wurde, wird die Pike seelenbefleckt sein.nnIhr müsst außerdem die ungeschmiedete runenbedeckte Brustplatte finden.nnBringt die seelenbefleckte Pike und die ungeschmiedete runenbedeckte Brustplate zu Lorax in Winterquell.‡검은바위 첨탑으로 가서 고랄루크 앤빌크랙을 찾아 처치한 후, 핏물이 깃든 창을 그의 심장에 꽂으십시오. 창이 그의 영혼을 흡수하면 영혼이 깃든 창으로 변합니다.nn벼려지지 않은 룬문자 흉갑도 찾아야 합니다.nn영혼이 깃든 창과 벼려지지 않은 룬문자 흉갑을 여명의 설원에 있는 로락스에게 갖다주십시오.‡Viaja a la Cumbre de Roca Negra y encuentra a Goraluk Yunquegrieta. Mátale y utiliza el Pico manchado de sangre sobre su cadáver. Cuando hayas absorbido su alma, el pico estará manchado de alma.nnTambién debes encontrar la coraza cubierta de runas sin forjar.nnLleva el pico manchado de alma y la coraza cubierta de runas sin forjar a Lorax en Cuna del Invierno.‡Viaja a la Cumbre de Roca Negra y encuentra a Goraluk Yunquegrieta. Mátale y utiliza el Pica manchada de sangre sobre su cadáver. Cuando hayas absorbido su alma, la pica estará manchada de alma.|nTambién debes encontrar la coraza cubierta de runas sin forjar.|nLleva la pica manchada de alma y la coraza cubierta de runas sin forjar a Lorax en Cuna del Invierno.‡Se rendre au pic Blackrock et trouver Goraluk Anvilcrack. Le tuer puis utiliser la Pique tachée de sang sur son cadavre. Après avoir siphonné son âme, la pique sera devenue Tachée d\'âme.nnTrouver aussi la Cuirasse couverte de runes inachevée.nnRapporter la Pique tachée d\'âme et la Cuirasse couverte de runes inachevée à Lorax au Berceau-de-l\'Hiver.‡到黑石塔去找到古拉鲁克。杀死他，然后用血污长矛刺入他的尸体。当他的灵魂被吸干后，这支矛就会成为穿魂长矛。nn你还必须找到未铸造的符文覆饰胸甲。nn将穿魂长矛和未铸造的符文覆饰胸甲都交给冬泉谷的罗拉克斯。‡到黑石塔去找到古拉魯克。殺死他，然後用血污長矛刺入他的屍體。當他的靈魂被吸幹後，這支矛就會成為穿魂長矛。|n你還必須找到未鑄造的符文覆飾胸甲。|n將穿魂長矛和未鑄造的符文覆飾胸甲都交給冬泉谷的羅拉克斯。',
  }
},
[5128] = {
  {
    'Palavras do Chefe Supremo‡Слова верховного вождя‡Worte des Oberhäuptlings‡대족장의 기록‡Las palabras del Gran Jefe‡Las palabras del Gran Jefe‡Paroles du Grand Chef‡熊怪酋长的话‡熊怪酋長的話',
    nil,
    'Leve o Registro Escrito Grosseiramente para Kelek Guardacéus, na parte sul da Selva Maleva.‡Отнесите неразборчиво исписанный журнал Келеку Стражу Неба в южную часть Оскверненного леса.‡Bringt das kunstlos geschriebene Logbuch zu Kelek Himmelshüter im südlichen Teil des Teufelswalds.‡악령의 숲 남부에 있는 켈레크 스카이키퍼에게 휘갈겨 쓴 일지를 갖다주어야 합니다.‡Lleva el Diario mal escrito a Kelek Guardacielo en el sur de Frondavil.‡Lleva el registro escrito de forma rudimentaria a Kelek Guardacielo en el sur de Frondavil.‡Rapporter le Journal mal écrit à Kelek Gardeciel dans le sud de Gangrebois.‡将潦草的日志交给费伍德森林南部的科雷克-望天。‡將潦草的日誌交給費伍德森林南部的科雷克·望天。',
  }
},
[5141] = {
  {
    'Couraria Dragônica‡Кожевничество: чешуя драконов‡Drachenlederverarbeitung‡용비늘 가죽세공‡Peletería dragontina‡Peletería dragontina‡Travail du cuir d\'écailles de dragon‡龙鳞制皮‡龍鱗製皮',
    nil,
    'Leve 2 Peitorais Escorpídeos Resistentes, 2 Luvas Escorpídeas Resistentes e 10 Escamas Gastas de Dragão para Pedro Galho em Azshara.nnCompletar essa missão lhe dará acesso à arte da Couraria Dragônica.nnCompletar a missão impedirá que você aprenda Couraria Elemental e Couraria Tribal; tenha certeza de que esta é a trilha que você deseja seguir antes de fazer sua escolha.‡Принесите 2 прочные кирасы из панциря скорпида, 2 пары прочных перчаток из панциря скорпида и 10 потертых чешуек дракона Питеру Галену в Азшару. nnПо выполнении этого задания вы получите возможность обучения кожевничеству школы чешуи драконов. nnЕсли вы выполните это задание, вы не сможете изучать кожевничество школы традиций предков и школы стихий.‡Bringt 2 feste Skorpidbrustplatten, 2 feste Skorpidhandschuhe und 10 Drachenschuppen zu Peter Galen in Azshara.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Drachenlederverarbeitung erhalten.nnIhr könnt dann allerdings weder Elementarlederverarbeitung noch Stammeslederverarbeitung erlernen; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡단단한 전갈 흉갑 2개와 단단한 전갈 장갑 2개, 닳아해진 용비늘 10개를 아즈샤라에 있는 피터 갈렌에게 가져가야 합니다.nn이 임무를 완수하면 용비늘 가죽세공술을 배우지만...nn원소 가죽세공술과 전통 가죽세공술은 영영 익힐 수 없게 됩니다. 그러므로 피터가 준 임무를 수행하기 전에 정말로 이 길을 가고 싶은지 확실히 결정하십시오.‡Consigue 2 corazas resistentes de escórpido, 2 guantes resistentes de escórpido, y 10 escamas de dragón desgastadas para Peter Galen, en Azshara.nnSi completas esta misión tendrás acceso al arte de la peletería dracónica.nnSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Peter Galen, en Azshara.|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Apporter 2 Cuirasses armées du scorpide, 2 Gants armés du scorpide et 10 Ecailles de dragon usées à Peter Galen, en Azshara.nnTerminer cette quête vous donnera accès aux arts du travail du cuir en écailles de dragon.nnTerminer cette quête avec succès vous interdira l\'apprentissage du travail du cuir élémentaire et du travail du cuir tribal. Prenez le temps de réfléchir à la voie que vous souhaitez emprunter, avant de prendre une décision.‡将2套硬化蝎壳胸甲、2套硬化蝎壳手套和10片龙鳞交给艾萨拉的彼得·加林。nn完成这项任务之后，你就可以学到龙鳞制皮技术了。nn同时，你也将永远无法学习元素制皮技术和部族制皮技术，在决定之前先考虑清楚。‡將2套硬化蠍殼胸甲、2套硬化蠍殼手套和10片龍鱗交給艾薩拉的彼得·加林。|n完成這項任務之後，你就可以學到龍鱗製皮技術了。|n同時，你也將永遠無法學習元素製皮技術和部族製皮技術:在決定之前先考慮清楚。',
  }
},
[5142] = {
  {
    'A pequena Pâmela‡Малышка Памела‡Klein-Pamela‡꼬마 파멜라‡La pequeña Pamela‡La pequeña Pamela‡La petite Pamela‡小帕米拉‡小帕米拉',
    nil,
    'Encontre Pâmela Trilharrubra.‡Найдите Памелу Редпат.‡Sucht Pamela Rotpfad.‡파멜라 레드패스를 찾아야 합니다.‡Encuentra a Pamela Rutagrana.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Retrouver Pamela Senterouge.‡找到帕米拉·雷德帕斯。‡找尋帕米拉·雷德帕斯。',
  }
},
[5143] = {
  {
    'Couraria tribal‡Кожевничество: традиции предков‡Stammeslederverarbeitung‡전통 가죽세공‡Peletería tribal‡Peletería tribal‡Travail du cuir tribal‡部族制皮‡部族製皮',
    nil,
    'Leve um Colete de Couro Silvestre e um Capacete de Couro Silvestre para Caryssia Caçaluna em Feralas.nnAo completar essa missão, você terá acesso às artes de Couraria Tribal.nnA conclusão da missão irá <impedí-lo/impedí-la> de aprender Couraria Dragônica e Couraria Elemental. Certifique-se que este é o caminho que deseja seguir antes de continuar.‡Принесите жилет и шлем из дикой кожи Кариссии Лунной Охотнице из Фераласа.nnВыполнив это задание, вы станете кожевником школы традиций предков.nnТакже вы лишитесь возможности изучать кожевничество школы чешуи драконов и школы стихий; убедитесь, что избрали именно этот путь, прежде чем выполнять задание.‡Bringt eine Wildlederweste und einen Wildlederhelm zu Caryssia Jägermond in Feralas.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Stammeslederverarbeitung erhalten.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Elementarlederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡페랄라스에 있는 카리시아 문헌터에게 야생 가죽 조끼와 야생 가죽 투구를 가져가야 합니다.nn이 퀘스트를 완료하면 전통 가죽세공술을 배울 수 있지만 용비늘 가죽세공술과 원소 가죽세공술을 배울 수 없습니다.nn퀘스트를 시작하기 전에 어떤 가죽세공술을 배울지 결정하시기 바랍니다.‡Lleva 1 jubón de cuero salvaje y 1 casco de cuero salvaje a Caryssia Cazaluna a Feralas.nnSi completas esta misión, tendrás acceso a las artes de Peletería tribal.nnSi lo haces, no podrás aprender peletería dragontina ni peletería elemental; asegúrate de que este es el camino que deseas seguir antes de completar la misión.‡Lleva 1 jubón de cuero salvaje y 1 casco de cuero salvaje a Caryssia Cazaluna a Feralas.|nSi completas esta misión, tendrás acceso a las artes de Peletería tribal.|nSi lo haces, no podrás aprender peletería dragontina ni peletería elemental; asegúrate de que este es el camino que deseas seguir antes de completar la misión.‡Apporter un Gilet en cuir sauvage et un Casque en cuir sauvage à Caryssia Moonhunter en Feralas.nnL’accomplissement de cette quête donne accès aux arts du travail du cuir tribal.nnL’accomplissement de cette quête vous empêchera d’apprendre le travail du cuir de dragon et le travail du cuir élémentaire ; il faut être sûr du chemin que l’on veut suivre avant de faire ce choix.‡将1件蛮皮外衣和1件蛮皮头盔交给菲拉斯的凯雷希亚·猎月。nn完成这项任务之后，你就可以学到部族制皮技术了。nn同时，你也将永远无法学习元素制皮技术和龙鳞制皮技术，在决定之前先考虑清楚。‡將1件蠻皮外衣和1件蠻皮盔帽交給菲拉斯的凱雷希亞·獵月。|n完成這項任務之後，你就可以學到部族製皮技術了。|n同時，你也將永遠無法學習元素製皮技術和龍鱗製皮技術，在決定之前先考慮清楚。',
  }
},
[5144] = {
  {
    'Couraria Elemental‡Кожевничество: сила стихий‡Elementarlederverarbeitung‡원소 가죽세공‡Peletería elemental‡Peletería elemental‡Travail du cuir élémentaire‡元素制皮‡元素製皮',
    nil,
    'Traga 2 Corações de Fogo, 2 Globos de Água, 2 Núcleos da Terra e 2 Sopros Eólicos para Sarah Tanner na Garganta Abrasadora.nnAo cumprir esta missão, você terá acesso à arte da Couraria Elemental.nnCom isso, você não poderá aprender Couraria Dragônica e Couraria Tribal. Por isso, antes de escolher este caminho, é preciso ter certeza de que é isso que você realmente quer.‡Принесите Саре Дубильщице 2 сердца огня, 2 сферы воды, 2 ядра земли и 2 дыхания ветра. nnВыполнение этого задания позволит вам изучать кожевничество школы силы стихий. nnКроме того, вы откажетесь от изучения кожевничества школ чешуи драконов и традиций предков. Нужно быть уверенным, что выбрана верная школа, прежде чем выполнять задание.‡Bringt 2 Herzen des Feuers, 2 Kugeln des Wassers, 2 Erdenkerne und 2 Odem des Windes zu Sarah Gerber in die sengende Schlucht.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Elementarlederverarbeitung erhalten.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Stammeslederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡이글거리는 협곡에 있는 사라 터너에게 불의 심장 2개, 물의 보주 2개, 대지의 핵 2개, 바람의 숨결 2개를 가져가야 합니다.nn이 퀘스트를 완료하면 원소 가죽세공술을 배울 수 있지만 용비늘 가죽세공술과 전통 가죽세공술을 배울 수 없습니다.nn퀘스트를 시작하기 전에 어떤 가죽세공술을 배울지 결정하시기 바랍니다.‡Lleva 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Sarah Peletero a La Garganta de Fuego. nnAl completar esta tarea aprenderás peletería elemental. nnSi te dedicas a este arte, no podrás aprender peletería dragontina ni peletería tribal; piénsatelo bien antes de decidirte.‡Lleva 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Sarah Peletero a La Garganta de Fuego.|nAl completar esta tarea aprenderás peletería elemental.|nSi te dedicas a este arte, no podrás aprender peletería dragontina ni peletería tribal; piénsatelo bien antes de decidirte.‡Apporter 2 Coeurs de feu, 2 Globes d\'eau, 2 Noyaux de terre, et 2 Souffles de vent à Sarah Tanner dans la Gorge des Vents brûlants.nnL\'accomplissement de cette quête donne accès aux arts du Travail du cuir élémentaire.nnL\'accomplissement de cette quête vous empêchera d\'apprendre le Travail du cuir de dragon et le Travail du cuir tribal ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将2个火焰之心、2个纯水之球、2个大地之核和2个风之气息交给灼热峡谷的萨拉·坦尼。nn一旦你完成这项任务，就可以开始学习元素制皮技艺了。nn同时，你也就无法再学习龙鳞制皮和部落制皮了，在你决定之前要考虑清楚。‡將2個火焰之心、2個純水之球、2個大地之核和2個風之氣息交給灼熱峽谷的薩拉·坦尼。|n一旦你完成這項任務，就可以開始學習元素製皮技藝了。|n同時，你也就無法再學習龍鱗製皮和部落製皮了，在你決定之前要考慮清楚。',
  }
},
[5145] = {
  {
    'Couraria dragônica‡Кожевничество: чешуя драконов‡Drachenlederverarbeitung‡용비늘 가죽세공‡Peletería dragontina‡Peletería dragontina‡Travail du cuir de dragon‡龙鳞制皮‡龍鱗製皮',
    nil,
    'Leve 2 Peitorais Escorpídeos Resistentes, 2 Luvas Escorpídeas Resistentes e 10 Escamas Gastas de Dragão para Thorkaf Olho-de-tigre em Azshara.nnO cumprimento desta missão lhe dará acesso à arte da Couraria Dragônica.nnPor outro lado, isso também impedirá que você aprenda Couraria Elemental e Couraria Tribal. Certifique-se de que esse é o caminho que você deseja seguir antes de fazer sua escolha.‡Принесите 2 прочные кирасы из панциря скорпида, 2 пары прочных перчаток из панциря скорпида и 10 потертых чешуек дракона Торкафу Оку Дракона в Бесплодные земли. nnПо выполнении этого задания вы получите возможность обучения кожевничеству школы чешуи драконов. nnЕсли вы выполните это задание, вы не сможете изучать кожевничество школы традиций предков и школы стихий.‡Bringt 2 feste Skorpidbrustplatten, 2 feste Skorpidhandschuhe und 10 Drachenschuppen zu Thorkaf Drachenaug im Ödland.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Drachenlederverarbeitung erhalten.nnIhr könnt dann allerdings weder Elementarlederverarbeitung noch Stammeslederverarbeitung erlernen; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡단단한 전갈 흉갑 2개와 단단한 전갈 장갑 2개, 그리고 닳아해진 용비늘 10개를 황야의 땅에 있는 토르카프 드래곤아이에 가져가야 합니다.nn이 임무를 완료하면 용비늘 가죽세공술을 익히게 되지만 원소 가죽세공술과 전통 가죽세공술은 익힐 수 없게 됩니다.nn일을 시작하기 전에 어떤 가죽세공술을 배울지 결정하시기 바랍니다.‡Consigue 2 corazas resistentes de escórpido, 2 guantes resistentes de escórpido, y 10 escamas de dragón desgastadas para Thorkaf Dragonojo, en las Tierras Inhóspitas.nnSi completas esta misión tendrás acceso al arte de la peletería dracónica.nnSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Consigue 2 corazas de escórpido resistentes, 2 guantes de escórpido resistentes, y 10 dragontinas desgastadas para Thorkaf Ojo de Dragón, en las Tierras Inhóspitas.|nSi completas esta misión tendrás acceso al arte de la peletería dragontina.|nSi lo haces, también dejarás de tener acceso a la peletería elemental y tribal. Tienes que asegurarte de querer seguir este camino antes de completarla.‡Apporter 2 Cuirasses armées du scorpide, 2 Gants armés du scorpide et 10 Ecailles de dragon usées à Thorkaf Oeil-de-dragon, dans les Terres ingrates.nnTerminer cette quête vous donnera accès aux arts du travail du cuir en écailles de dragon.nnTerminer cette quête avec succès vous interdira l\'apprentissage du travail du cuir élémentaire et du travail du cuir tribal. Prenez le temps de réfléchir à la voie que vous souhaitez emprunter, avant de prendre une décision.‡将2套硬化蝎壳胸甲、2套硬化蝎壳手套和10片龙鳞交给荒芜之地的索卡夫·龙眼。nn完成这项任务之后，你就可以学到龙鳞制皮技术了。nn同时，你也将永远无法学习元素制皮技术和部族制皮技术，在决定之前先考虑清楚。‡將2套硬化蠍殼胸甲、2套硬化蠍殼手套和10片龍鱗交給荒蕪之地的索卡夫·龍眼。|n完成這項任務之後，你就可以學到龍鱗製皮技術了。|n同時，你也將永遠無法學習元素製皮技術和部族製皮技術;在決定之前先考慮清楚。',
  }
},
[5146] = {
  {
    'Couraria elemental‡Кожевничество: сила стихий‡Elementarlederverarbeitung‡원소 가죽세공‡Peletería elemental‡Peletería elemental‡Travail du cuir élémentaire‡元素制皮‡元素製皮',
    nil,
    'Leve 2 Corações de Fogo, 2 Globos de Água, 2 Núcleos da Terra e 2 Sopros Eólicos para Brum Casco Invernal em Pedre\'gor, que fica no Planalto Arathi.nnAo cumprir esta missão, você terá acesso à arte da Couraria Elemental.nnCom isso, você não poderá aprender Couraria Dragônica e Couraria Tribal. Tenha certeza de que é este o caminho que deseja seguir.‡Принесите Брумну Заиндевевшему Копыту на нагорье Арати 2 сердца огня, 2 сферы воды, 2 ядра земли и 2 дыхания ветра. nnВыполнение этого задания позволит вам изучать кожевничество школы силы стихий. nnКроме того, вы откажетесь от изучения кожевничества школ чешуи драконов и традиций предков. Нужно быть уверенным, что выбрана верная школа, прежде чем выполнять задание.‡Bringt 2 Herzen des Feuers, 2 Kugeln des Wassers, 2 Erdenkerne und 2 Odem des Windes zu Brumn Winterhuf in den Arathibergen.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Elementarlederverarbeitung erhalten.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Stammeslederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡아라시 고원에 있는 브룸 윈터후프에게 불의 심장 2개, 물의 보주 2개, 대지의 핵 2개, 바람의 숨결 2개를 가져가야 합니다.nn이 퀘스트를 완료하면 원소 가죽세공술을 배울 수 있습니다. 이 퀘스트를 완료하면 용비늘 가죽세공술과 전통 가죽세공술을 배울 수 없습니다.nn퀘스트를 시작하기 전에 어떤 가죽세공술을 배울지 결정하시기 바랍니다.‡Llévale 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Brumm Pezuña Invernal en las Tierras Altas de Arathi.nnCuando completes esta misión tendrás acceso a las artes de peletería elemental.nnSi completas esta misión, no podrás aprender peletería dragontina ni peletería tribal; asegúrate de que este es el camino que deseas seguir antes de tomarlo.‡Llévale 2 corazones de fuego, 2 globos de agua, 2 núcleos de tierra y 2 alientos de viento a Brumm Pezuña Invernal en las Tierras Altas de Arathi.|nCuando completes esta misión tendrás acceso a las artes de peletería elemental.|nSi completas esta misión, no podrás aprender peletería dragontina ni peletería tribal; asegúrate de que este es el camino que deseas seguir antes de tomarlo.‡Apporter 2 Coeurs de feu, 2 Globes d\'eau, 2 Noyaux de terre, et 2 Souffles de vent à Brumn Winterhoof dans les montagnes d’Arathi.nnL’accomplissement de cette quête donne accès aux arts du travail du cuir élémentaire.nnL’accomplissement de cette quête vous empêchera d’apprendre le travail du cuir de dragon et le travail du cuir tribal ; il faut être sûr du chemin que l’on veut suivre avant de faire ce choix.‡将2个火焰之心、2个纯水之球、2个大地之核和2个风之气息交给阿拉希山脉的布鲁姆·白蹄。nn一旦你完成这项任务，就可以开始学习元素制皮技艺了。nn同时，你也就无法再学习龙鳞制皮和部落制皮了，在你决定之前要考虑清楚。‡將2個火焰之心、2個純水之球、2個大地之核和2個風之氣息交給阿拉希山脈的布魯姆·白蹄。|n一旦你完成這項任務，就可以開始學習元素製皮技藝了。|n同時，你也就無法再學習龍鱗製皮和部落製皮了，在你決定之前要考慮清楚。',
  }
},
[5147] = {
  {
    'Procura-se: Arnak Temível Totem‡Разыскивается: Арнак Зловещий Тотем‡GESUCHT: Arnak Grimmtotem‡현상 수배 - 아르낙 그림토템‡Se busca: Arnak Tótem Siniestro‡Se busca: Arnak Tótem Siniestro‡On recherche : Arnak Totem-sinistre‡通缉：阿纳克-恐怖图腾‡通緝:阿納克·恐怖圖騰',
    nil,
    'Mate Arnak Temível Totem e leve uma prova de seu feito para o Vigia do Rochedo Chifre Longo, na Aldeia Vento Livre.‡Убейте Арнака Зловещего Тотема и принесите доказательство дозорному утесов Долгорогу на заставу Вольного Ветра.‡Erschlagt Arnak Grimmtotem und bringt den Beweis Eurer Tat zu Klippenbehüter Langhorn im Freiwindposten.‡아르낙 그림토템을 처치하고 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 그 증거물을 갖다주어야 합니다.‡Mata a Arnak Tótem Siniestro y llévale una prueba de tu hazaña a Vigiarisco Cuernolargo, que está en el Poblado Viento Libre.‡Mata a Arnak Tótem Siniestro y llévale una prueba de tu hazaña al vigiarrisco Cuerno Largo, que está en el Poblado Viento Libre.‡Tuer Arnak Totem-sinistre et apporter une preuve de votre acte au garde-falaise Longue-corne au Poste de Librevent.‡杀死阿纳克·恐怖图腾，并向乱风岗的峭壁卫兵图林·长角出示证据。‡殺死阿納克·恐怖圖騰，並向亂風崗的峭壁衛兵圖林·長角出示證據。',
  }
},
[5148] = {
  {
    'Couraria tribal‡Кожевничество: традиции предков‡Stammeslederverarbeitung‡전통 가죽세공‡Peletería tribal‡Peletería tribal‡Travail du cuir tribal‡部族制皮‡',
    nil,
    'Leve um Colete de Couro Silvestre e um Capacete de Couro Silvestre para Se\'Jib, na Selva do Espinhaço.nnAo cumprir a missão, você terá acesso às artes da Couraria Tribal.nnAo cumprir a missão, o aprendizado de Couraria Dragônica e Couraria Elemental lhe será proibido. Tenha certeza de sua escolha antes de tomar o passo que está prestes a dar.‡Принесите жилет и шлем из дикой кожи Кариссии Лунной Охотнице из Фераласа.nnВыполнив это задание, вы станете кожевником школы традиций предков.nnТакже вы лишитесь возможности изучать кожевничество школы чешуи драконов и школы стихий; убедитесь, что избрали именно этот путь, прежде чем выполнять задание.‡Bringt eine Wildlederweste und einen Wildlederhelm zu Se\'Jib im Schlingendorntal.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr Zugang zur Kunst der Stammeslederverarbeitung erhalten.nnWenn Ihr diese Aufgabe abschließt, werdet Ihr allerdings weder Drachenlederverarbeitung noch Elementarlederverarbeitung erlernen können; seid also vorher sicher, dass dies der Weg ist, dem Ihr folgen wollt.‡가시덤불 골짜기에 있는 세지브에게 야생 가죽 조끼와 야생 가죽 투구를 가져가야 합니다.nn이 퀘스트를 완료하면 전통 가죽세공술을 배울 수 있지만 용비늘 가죽세공술과 원소 가죽세공술을 배울 수 없습니다.nn퀘스트를 시작하기 전에 어떤 가죽세공술을 배울지 결정하시기 바랍니다.‡Lleva un jubón de cuero salvaje y un casco de cuero salvaje a Se\'Jib en la Vega de Tuercespina.nnCompletar esta misión te proporcionará acceso a las artes de la peletería tribal.nnCompletar esta misión evitará que aprendas peletería dragontina y peletería elemental. Asegúrate que este es el camino que quieres seguir antes de hacerlo.‡Lleva un jubón de cuero salvaje y un casco de cuero salvaje a Se\'Jib en la Vega de Tuercespina.|nCompletar esta misión te proporcionará acceso a las artes de la peletería tribal.|nCompletar esta misión evitará que aprendas peletería dragontina y peletería elemental. Asegúrate que este es el camino que quieres seguir antes de hacerlo.‡Apporter un Gilet en cuir fauve et un Casque en cuir fauve à Se\'Jib dans la vallée de Strangleronce.nnL\'accomplissement de cette quête donne accès aux arts du travail du cuir tribal.nnL\'accomplissement de cette quête vous empêchera d\'apprendre le travail du cuir de dragon et le travail du cuir élémentaire ; il faut être sûr du chemin que l\'on veut suivre avant de faire ce choix.‡将1件蛮皮外衣和1件蛮皮头盔交给荆棘谷的瑟伊布。nn完成这项任务之后，你就可以学到部族制皮技术了。nn同时，你也将永远无法学习元素制皮技术和龙鳞制皮技术，在决定之前先考虑清楚。‡',
  }
},
[5149] = {
  {
    'A boneca de Pâmela‡Кукла Памелы‡Pamelas Puppe‡파멜라의 인형‡La muñeca de Pamela‡La muñeca de Pamela‡Poupée de Pamela‡帕米拉的洋娃娃‡帕米拉的洋娃娃',
    nil,
    'Encontre a boneca de Pâmela.‡Найдите куклу Памелы.‡Sucht Pamelas Puppe.‡파멜라의 인형을 찾아야 합니다.‡Encuentra la muñeca de Pamela.‡Encuentra la muñeca de Pamela.‡Trouver la poupée de Pamela.‡找到帕米拉的洋娃娃。‡找到帕米拉的洋娃娃。',
  }
},
[5150] = {
  {
    'Dadanga está com fome!‡Даданга проголодалась!‡Dadanga ist hungrig!‡배고픈 다단가!‡¡Dadanga tiene hambre!‡¡Dadanga tiene hambre!‡Dadanga a faim !‡达丹加饿了！‡達丹加餓了!',
    nil,
    'Conforme você se aproxima de Dadanga, ela ergue o rosto para você. Parece que ela está esperando alguma coisa...nnEla deve estar com fome!nnDeve haver alguma coisa que cresce na cratera e que seria o lanchinho perfeito para uma grande herbívora. Dadanga é bem grandinha, então o que quer que traga para ela, tem que ser em grandes quantidades!‡Даданга внимательно смотрит на вас, она явно чего-то ждет... nnВидимо, она голодна! nnВ кратере должно расти что-нибудь подходящее для крупного травоядного... Даданга – крупная девочка, придется потрудиться, чтобы принести ей достаточно еды!‡Dadanga sieht zu Euch auf, während Ihr auf sie zu geht. Sie scheint auf etwas zu hoffen...nnSie hat wahrscheinlich Hunger!nnIm Krater muss irgendetwas wachsen, was die perfekte Leckerei für einen riesigen Pflanzenfresser ist. Dadanga ist ein großes Mädchen; was immer Ihr ihr bringt... es muss viel davon sein!‡다단가에게 다가가자 다단가가 당신을 올려다봅니다. 뭔가를 원하는 것 같습니다..nn아마 배가 고픈 것일 겁니다!nn거대한 초식 동물이 간식으로 먹기에 적합한 뭔가가 분화구에서 자라고 있습니다. 다단가는 덩치가 크기 때문에 뭘 가져오든지 많이 가져와야 합니다!‡Dadanga te observa mientras te acercas a ella. Parece que espera algo...nn¡Probablemente esté hambrienta!nnSeguro que en el cráter hay algo que le puede servir de aperitivo a una gran herbívora como ella. Ten en cuenta que es una chica muy grande así que, traigas lo que traigas, ¡que sea en abundancia!‡‡Dadanga vous regarde alors que vous l\'approchez. Elle semble espérer quelque chose…nnElle a probablement faim !nnIl y a certainement quelque chose qui pousse dans le cratère et qui ferait un parfait en-cas pour un herbivore de grande taille. Dadanga est une grande fille : quoi que vous lui apportiez, il faudra que ce soit en grosse quantité !‡当你走向达丹加的时候，她目不转睛地看着你。她似乎在希望你拿给她什么东西……nn她也许是饿了！nn也许在环形山里长着一些可以喂给这头大型食草动物的花花草草。达丹加的个头不小，不管你准备给她喂什么，数量肯定少不了！‡',
  }
},
[5151] = {
  {
    'Dispositivo hipercapacitador‡Механизм гипервместимости‡Hyperkondensator-Dingsda‡초전도 장치‡Hipercondensador‡Hipercondensador‡Hypercapaciteur bidulotron‡超适应齿轮‡超適應齒輪',
    nil,
    'Mate a fera e traga de volta o Dispositivo Hipercapacitador e a Chave da Jaula da Pantera para Vizlo Limpajunta.‡Убейте зверя и принестите механизм гипервместимости и ключ от клетки пантеры Визло Фингалету.‡Erschlagt die Bestie und bringt den Hyperkondensator sowie den Pantherkäfigschlüssel zu Wizlo Lagerputzer zurück.‡퓨마를 처치하고 초전도 장치와 퓨마 우리 열쇠를 위즐로 베어링샤이너에게 돌려주어야 합니다.‡Acaba con la bestia y trae de regreso el hipercapacitor y la llave de la jaula a Wizlo Rodabrillante.‡Acaba con la bestia y trae de regreso el hipercondensador y la llave de la jaula de pantera a Wizlo Rodabrillante.‡Tuer la bête et rapporter l\'Hypercapaciteur et la Clé de la cage de la panthère à Wizlo Braquecoquard.‡杀了那头野兽，把超适应齿轮和钥匙交给维兹罗。‡殺了那隻野獸並把超適應齒輪和豹籠鑰匙帶回來交給維茲羅·擦軸人。',
  }
},
[5152] = {
  {
    'Tia Marlene‡Тетушка Марлен‡Tante Marlene‡말레네 고모‡Tía Marlene‡Tía Marlene‡Tante Marlene‡玛莱恩姑妈‡瑪萊恩姑媽',
    nil,
    'Fale com Marlene, ao sul das Ruínas de Andorhal.‡Поговорите с Марлен в южной части руин Андорала.‡Sprecht mit Marlene, südlich der Ruinen von Andorhal.‡안돌할의 폐허 남쪽에서 말레네와 대화해야 합니다.‡Habla con Marlene. Está al sur de las Ruinas de Andorhal.‡Habla con Marlene. Está al sur de las Ruinas de Andorhal.‡Parler à Marlene, au sud des ruines d\'Andorhal.‡与安多哈尔废墟南边的玛莱恩谈一谈。‡與安多哈爾廢墟南邊的瑪萊恩談話。',
  }
},
[5153] = {
  {
    'Uma historiadora estranha‡Странный историк‡Ein seltsamer Historiker‡이상한 역사가‡Una extraña historiadora‡Una extraña historiadora‡Un étrange historien‡古怪的历史学家‡古怪的歷史學家',
    nil,
    'Leve o Anel de Casamento do Josefo para Crona.‡Принесите Хроми обручальное кольцо Джозефа.‡Bringt Josephs Ehering zu Chromie.‡조셉의 결혼반지를 크로미에게 가져가야 합니다.‡Lleva la alianza de Joseph a Cromi.‡Lleva la alianza de Joseph a Cromi.‡Apporter l\'Alliance de Joseph à Chromie.‡把约瑟夫的结婚戒指交给安多哈尔的克罗米。‡把約瑟夫的結婚戒指交給安多哈爾的克羅米。',
  }
},
[5154] = {
  {
    'Os Anais da Vila das Flechas‡Анналы Дарроушира‡Die Annalen von Darroheim‡다로우샤이어 연대기‡Los Anales de Villa Darrow‡Las Crónicas de Villa Darrow‡Les annales de Darrowshire‡达隆郡的历史‡達隆郡的歷史',
    nil,
    'Leve os Anais da Vila das Flechas para Crona em Andorhal.‡Принесите Анналы Дарроушира Хроми в Андорал.‡Bringt die \'Annalen von Darroheim\' zu Chromie in Andorhal.‡안돌할에 있는 다로우샤이어 연대기를 크로미에게 갖다주어야 합니다.‡Lleva el libro Anales de Villa Darrow a Cromi a Andorhal.‡Lleva el libro Crónicas de Villa Darrow a Cromi a Andorhal.‡Apporter les Annales de Comté-de-Darrow à Chromie, à Andorhal.‡把《达隆郡的历史》交给安多哈尔的克罗米。‡把《達隆郡的歷史》交給安多哈爾的克羅米。',
  }
},
[5155] = {
  {
    'Forças de Jaedenar‡Силы Джеденара‡Streitmacht von Jaedenar‡자에데나르의 힘‡Las fuerzas de Jaedenar‡Las fuerzas de Jaedenar‡Les forces de Jaedenar‡加德纳尔的势力‡加德納爾的勢力',
    nil,
    'Entre em Jaedenar e mate 4 Cães de Jaedenar, 4 Guardas de Jaedenar, 6 Adeptos de Jaedenar e 6 Sectários de Jaedenar. Depois, fale novamente com Greta Musgo no Casco, na Selva Maleva.‡Отправляйтесь в Джеденар и убейте 4 джеденарских гончих, 4 джеденарских стражей, 6 джеденарских адептов и 6 джеденарских сектантов, затем возвращайтесь к Грете Замшелое Копыто в Оскверненный лес.‡Betretet Jaedenar und erschlagt 4 Hunde von Jaedenar, 4 Gardisten von Jaedenar, 6 Adepten von Jaedenar und 6 Kultisten von Jaedenar, bevor Ihr zu Greta Mooshuf im Teufelswald zurückkehrt.‡자에데나르에 가서 자에데나르 사냥개 4마리, 자에데나르 수호병 4명, 자에데나르 숙련사제 6명, 자에데나르 이교도 6명을 처치하고 그레타 모스후프에게 돌아가야 합니다.‡Entra en Jaedenar y mata a 4 canes Jaedenar, 4 guardianes Jaedenar, 6 adeptos Jaedenar y 6 fieles Jaedenar antes de volver con Greta Pezuñamusgo a Frondavil.‡Entra en Jaedenar y mata a 4 canes Jaedenar, 4 guardianes Jaedenar, 6 adeptos Jaedenar y 6 cultores Jaedenar antes de volver con Greta Pezuñamusgo a Frondavil.‡Entrer dans Jaedenar et tuer 4 Molosses de Jaedenar, 4 Gardiens de Jaedenar, 6 Adeptes de Jaedenar, et 6 Sectateurs de Jaedenar avant de retourner auprès de Greta Sabot-de-mousse dans Gangrebois.‡到加德纳尔去杀掉4个加德纳尔恶犬、4个加德纳尔守护者、6个加德纳尔精兵和6个加德纳尔祭司，然后向费伍德森林的格雷塔·苔蹄复命。‡到加德納爾去殺掉4個加德納爾惡犬、4個加德納爾守護者、6個加德納爾精兵和6個加德納爾祭司，然後向費伍德森林的格雷塔·苔蹄覆命。',
  }
},
[5156] = {
  {
    'Verificar a corrupção‡Проверка на порчу‡Die Verderbnis überprüfen‡오염 확인‡Investigación acerca de la corrupción‡Investigación acerca de la corrupción‡Enquête sur la corruption‡验证腐蚀‡驗證腐蝕',
    nil,
    'Procure e destrua 2 Feras Entrópicas e 2 Horrores Entrópicos enquanto explora o Vale das Escaras Pungentes. Depois de ver se as crateras ainda estão cheias de água contaminada com vileza, fale novamente com Taronn Pena Vermelha, na Selva Maleva.‡Найдите и уничтожьте 2 энтропических зверей и 2 энтропических ужасов при обследовании долины Рваных Ран. После проверьте, по-прежнему ли заполнены кратеры оскверненной водой. Затем возвращайтесь к Таруну Красному Перу в Оскверненный лес.‡Sucht und zerstört 2 entropische Bestien und 2 entropische Schrecken, während Ihr den Narbengrund erforscht. Nachdem Ihr überprüft habt, ob die Krater immer noch mit verderbtem Wasser gefüllt sind, kehrt zu Taronn Rotfeder im Teufelswald zurück.‡불벼락 골짜기를 탐색하는 동안 혼돈의 불길 2마리와 혼돈의 소산물 2마리를 처치해야 합니다. 분화구를 조사해 아직도 부패한 물이 남아 있는지 확인하고 악령의 숲의 타론 레드페더에게 돌아가야 합니다.‡Busca y destruye a 2 bestias entrópicas y 2 horrores entrópicos a la vez que exploras la Cañada Gran Cicatriz. Cuando hayas comprobado si los cráteres del lugar aún contienen agua vil corrupta, vuelve con Taronn Plumarroja a Frondavil.‡Busca y destruye a 2 bestias entrópicas y 2 horrores entrópicos a la vez que exploras la Cañada Gran Cicatriz. Cuando hayas comprobado si los cráteres del lugar aún contienen agua vil corrupta, vuelve con Taronn Plumarroja a Frondavil.‡Trouver et détruire 2 Bêtes d\'entropie et 2 Horreurs d\'entropie tout en explorant le Val Grêlé. Après avoir vérifié que les cratères à cet endroit sont toujours remplis d\'eau corrompue, retourner auprès de Taronn Plume-rouge dans Gangrebois.‡杀掉2个热能野兽和2个热能恐兽，并探索碎痕谷。然后查看凹坑中是否仍然充满了堕落的恶臭之水，完成这些任务之后，向费伍德森林中的塔诺恩·红羽复命。‡殺掉2個熱能野獸和2個熱能恐獸，並探索碎痕谷。然後查看凹坑中是否仍然充滿了墮落的惡臭之水，完成這些任務之後，向費伍德森林中的塔諾恩·紅羽覆命。',
  }
},
[5157] = {
  {
    'Coletar a água corrompida‡Собрать оскверненную воду‡Verderbtes Wasser sammeln‡부패한 물 채취‡Una muestra de agua corrupta‡Una muestra de agua corrupta‡Recueillir de l\'eau souillée‡收集堕落之水‡收集墮落之水',
    nil,
    'Leve o Cantil Vazio para o Poço Lunar no meio de Jaedenar e encha-o. Depois, fale novamente com Greta Musgo no Casco na Selva Maleva.‡Возьмите пустую флягу и наполните ее водой из лунного колодца, что находится в центре Джеденара. Возвращайтесь к Грете Замшелое Копыто в Оскверненный лес.‡Bringt die leere Feldflasche zum Mondbrunnen im Zentrum von Jaedenar und füllt sie, bevor Ihr zu Greta Mooshuf im Teufelswald zurückkehrt.‡빈 수통을 자에데나르 중심부의 달샘으로 가져가서 채운 다음 악령의 숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Lleva la cantimplora vacía a la Poza de la Luna que hay en el centro de Jaedenar y llénala antes de volver con Greta Pezuñamusgo a Frondavil.‡Lleva la cantimplora vacía a la Poza de la Luna que hay en el centro de Jaedenar y llénala antes de volver con Greta Pezuñamusgo a Frondavil.‡Amener la Gourde vide au Puits de lune au centre de Jaedenar et la remplir avant de retourner voir Greta Sabot-de-mousse dans Gangrebois.‡把空壶拿到加德纳尔中心的月亮井去，装满井水之后再回到费伍德森林的格雷塔·苔蹄那里。‡把空壺拿到加德納爾中心的月井去，裝滿井水之後再回到費伍德森林的格雷塔·苔蹄那裡。',
  }
},
[5158] = {
  {
    'À procura de auxílio espiritual‡В поисках духовной помощи‡Spirituelle Hilfe suchen‡영혼의 도움을 찾아서‡Buscando ayuda espiritual‡Buscando ayuda espiritual‡À la recherche de soutien spirituel‡水之魂的帮助‡水之魂的幫助',
    nil,
    'Leve a Água Corrompida do Poço Lunar para Islen Vidente da Água, nos Sertões.‡Отнесите порченую воду из Лунного колодца Ислен Заклинателю Воды в Степи.‡Bringt das verderbte Mondbrunnenwasser in das Brachland zu Islen Wasserdeuter.‡부패한 달샘 물을 불모의 땅에 있는 이슬렌 워터시어에게 가져 가야 합니다.‡Lleva el agua de la Poza de la Luna corrupta a Islen Vident\'aqua a Los Baldíos.‡Lleva el agua de la Poza de la Luna corrupta a Islen Vidente del Agua a Los Baldíos.‡Apporter l\'Eau de Puits de lune corrompue à Islen Oeil-des-rivières dans les Tarides.‡把腐化的月亮井水交给贫瘠之地的水之先知伊斯伦。‡把腐化的月井水交給貧瘠之地的水之先知伊斯倫。',
  }
},
[5159] = {
  {
    'O retorno da água purificada à Selva Maleva‡Чистая вода возвращается в Оскверненный лес‡Gesäubertes Wasser wird zum Teufelswald gebracht‡악령의 숲으로 정화된 물 가져가기‡El agua purificada vuelve a Frondavil‡El agua purificada vuelve a Frondavil‡L\'eau purifiée retourne à Gangrebois‡净化过的水‡淨化過的水',
    nil,
    'Leve a Água Purificada do Poço Lunar para Greta Musgo no Casco, na Selva Maleva.‡Отнесите очищенную воду из лунного колодца Грете Замшелое Копыто в Оскверненный лес.‡Bringt das geläuterte Mondbrunnenwasser zu Greta Mooshuf im Teufelswald.‡정화된 달샘 물을 악령의 숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Lleva el agua de la Poza de la Luna purificada a Greta Pezuñamusgo en Frondavil.‡Lleva el agua de la Poza de la Luna purificada a Greta Pezuñamusgo en Frondavil.‡Apporter l\'Eau de Puits de lune purifiée à Greta Sabot-de-mousse dans Gangrebois.‡把净化过的月亮井水交给费伍德森林的格雷塔·苔蹄。‡把淨化過的月井水交給費伍德森林的格雷塔·苔蹄。',
  }
},
[5160] = {
  {
    'A protetorada-máter‡Матрона-защитница‡Die oberste Beschützerin‡대섭정‡El Protectorado de la matrona‡El Protectorado de la matrona‡Le Protectorat de la matrone‡监护者‡監護者',
    nil,
    'Viaje para Hibérnia e encontre Haleh. Entregue para ela a Escama do Albi.‡Дойдите до Зимних Ключей и найдите Хале. Отдайте ей пластину чешуи Ауби.‡Begebt Euch nach Winterquell und sucht Haleh. Gebt ihr Awbees Schuppe.‡여명의 설원으로 가서 헬레를 찾아 그녀에게 아우비의 비늘을 전해야 합니다.‡Viaja hasta la Cuna del Invierno y encuentra a Haleh. Dale la escama de Awbee.‡Viaja hasta la Cuna del Invierno y encuentra a Haleh. Dale la escama de Awbee.‡Aller jusqu\'au Berceau-de-l\'Hiver et trouver Haleh. Lui donner l\'Ecaille d\'Awbee.‡到冬泉谷去找到哈尔琳，把奥比的鳞片交给她。‡到冬泉谷去找到哈爾琳，把奧比的鱗片交給她。',
  }
},
[5161] = {
  {
    'Ira da Revoada Azul‡Гнев синих драконов‡Der Zorn des blauen Drachenschwarms‡푸른용군단의 분노‡La cólera del Vuelo Azul‡La cólera del Vuelo Azul‡La colère du vol bleu‡蓝龙之怒‡藍龍軍團之怒',
    nil,
    'Fale com Haleh se quiser continuar.‡Если у вас есть желание продолжить, поговорите снова с Хале.‡Sprecht mit Haleh, wenn Ihr weitermachen wollt.‡계속하려면 헬레와 대화하십시오.‡Habla con Haleh si quieres continuar.‡Habla con Haleh si quieres continuar.‡Si vous souhaitez continuer, parlez à Haleh.‡要是你想继续的话，就与哈尔琳谈一谈。‡要是你想繼續的話，就與哈爾琳談話。',
  }
},
[5162] = {
  {
    'Ira da Revoada Azul‡Гнев синих драконов‡Der Zorn des blauen Drachenschwarms‡푸른용군단의 분노‡La cólera del Vuelo Azul‡La cólera del Vuelo Azul‡La colère du vol bleu‡蓝龙之怒‡藍龍軍團之怒',
    nil,
    'Fale com Jezibá nas Terras Pestilentas. Ele mora em Andorhal.‡Поговорите с Джезибой в Чумных землях. Он обитает в Андорале.‡Sprecht mit Jeziba in den Pestländern. Er wohnt in Andorhal.‡역병지대로 가서 안돌할에 사는 제지바와 대화하십시오.‡Habla con Jeziba en las Tierras de la Peste. Vive en Andorhal.‡Habla con Jeziba en las Tierras de la Peste. Vive en Andorhal.‡Parler à Jeziba dans les Maleterres. Il vit à Andorhal.‡与瘟疫之地的耶兹巴交谈。他居住在安多哈尔。‡與瘟疫之地的耶茲巴交談。他居住在安多哈爾。',
  }
},
[5163] = {
  {
    'Eu yeti falar uma coisa...‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡Yeti... ¿ya hemos llegado?‡Yeti... ¿ya hemos llegado?‡Yéti ? Y es-tu ?‡雪怪计划！‡雪怪計畫!',
    nil,
    'Leve o Yeti Mecânico da Umi e assuste os amigos dela:nnLegacki, em Visteterna (Hibérnia),nSguisha, em Geringontzan (Tanaris) enQuixxil, no Refúgio do Marshal (Cratera Un\'Goro).nnQuando terminar, leve o Yeti Mecânico de volta para Umi.‡Возьмите механического йети Уми и напугайте им ее друзей:nnЛегакки в Круговзоре (Зимние Ключи) nполивалку в Прибамбасске (Танарис)nКвикксиля в Укрытии Маршалла (Кратер Ун\'Горо)nnКогда проделаете все это, принесите механического йети обратно Уми.‡Nehmt Umis mechanischen Yeti und erschreckt ihre Freunde damit:nnLegacki in der Ewigen Warte (Winterquell)nSprinkel in Gadgetzan (Tanaris)nQuixxil in Marschalls Zuflucht (Krater von Un\'Goro)nnWenn Ihr damit fertig seid, bringt den mechanischen Yeti zu Umi zurück.‡우미의 기계설인을 가지고 가서 아래 친구들에게 겁을 주어야 합니다.nn여명의 설원, 눈망루 마을에 있는 레각키n타나리스의 가젯잔에 있는 스프링클n운고로 분화구, 마샬의 야영지에 있는 퀵실nn모두에게 겁을 주고 나서 기계설인을 도로 우미에게 데리고 가야 합니다.‡Coge el yeti mecánico de Umi y asusta con él a sus amigos:nnLegacki en Vista Eterna (Cuna del Invierno)nnRoxio en Gadgetzan (Tanaris)nQuixxil en el Refugio de Marshal (Cráter de Un\'Goro)nnCuando hayas terminado, devuelve el yeti mecánico a Umi.‡Coge el yeti mecánico de Umi y asusta con él a sus amigos:|nLegacki en Vista Eterna (Cuna del Invierno)|nRoxio en Gadgetzan (Tanaris)|nQuixxil en el Refugio de Marshal (Cráter de Un\'Goro)|nCuando hayas terminado, devuelve el yeti mecánico a Umi.‡Prendre le yéti mécanique d\'Umi et effrayer ses amis avec :nnLegacki, à Long-guet (Berceau-de-l\'Hiver)nSaupoudr, à Gadgetzan (Tanaris)nQuixxil, au refuge des Marshal (Cratère d\'Un\'Goro)nnQuand vous aurez terminé, rapporter le yéti mécanique à Umi.‡带着乌米的机械雪人去吓唬她的朋友：nn永望镇的莱加奇（冬泉谷）、加基森的斯普琳科（塔纳利斯），还有马绍尔营地的奎克希尔（安戈洛环形山）。nn当你完成任务之后，把机械雪人还给乌米。‡帶著烏米的機械雪人去嚇唬她的朋友:|n永望鎮的萊加奇(冬泉谷)、加基森的斯普琳科(塔納利斯)，還有馬紹爾營地的奎克希爾(安戈洛環形山)。|n當你完成任務之後，把機械雪人還給烏米。',
  }
},
[5164] = {
  {
    'Catálogo do Imprevisível‡Перечень Заблудших‡Verzeichnis der Abtrünnigen‡무법의 시대 일람‡Catálogo del Díscolo‡Catálogo del Díscolo‡Guide de l\'Indocile‡游荡者目录‡遊蕩者目錄',
    nil,
    'Leia o Catálogo do Imprevisível.‡Прочитайте перечень Заблудших.‡Lest das \'Verzeichnis der Abtrünnigen\'.‡제지바의 뒤에 있는 무법의 시대 일람을 읽어야 합니다.‡Lee el Catálogo del Díscolo.|n‡Lee el Catálogo del Díscolo.‡Lire le Guide de l\'Indocile.‡阅读游荡者目录。‡閱讀遊蕩者目錄。',
  }
},
[5165] = {
  {
    'Extinguindo as chamas da proteção‡Погасить Пламя Защиты‡Übergießen der Flammen des Schutzes‡방어막 파괴‡Sofocar las llamas de protección‡Sofocar las llamas de protección‡Éteindre les flammes de protection‡熄灭火焰‡熄滅火焰',
    nil,
    'Use a Água Purificada do Poço Lunar para extinguir os quatro braseiros de proteção no interior da Fortaleza do Concílio das Sombras, em Selva Maleva, depois fale novamente com Greta Musgo no Casco, no Santuário Esmeralda.‡При помощи очищенной воды из лунного колодца загасите пламя в четырех жаровнях защиты внутри Оплота Теней в Оскверненном лесу. Затем возвращайтесь к Грете Замшелое Копыто в Изумрудное святилище.‡Übergießt die Flammen der vier Kohlenpfannen des Schutzes in der Schattenfeste im Teufelswald mit dem geläuterten Mondbrunnenwasser und kehrt danach zu Greta Mooshuf im Smaragdrefugium zurück.‡정화된 달샘 물을 써서 악령의 숲에 있는 어둠의 요새를 감싸고 있는 화로 4개를 파괴한 후 에메랄드 성소에 있는 그레타 모스후프에게 돌아가야 합니다.‡Utiliza el agua de la Poza de la Luna purificada para apagar las llamas de los cuatro Blandones de Protección de la Guarida Sombría de Frondavil y vuelve con Greta Pezuñamusgo al Santuario Esmeralda.‡Utiliza el agua de la Poza de la Luna purificada para apagar las llamas de los cuatro Blandones de Protección de la Guarida Sombría de Frondavil y vuelve con Greta Pezuñamusgo al Santuario Esmeralda.‡À l\'aide de l\'Eau de Puits de lune purifiée, éteignez les flammes des quatre braseros de protection à l\'intérieur du Fort des ombres dans Gangrebois. Retournez ensuite auprès de Greta Sabot-de-mousse au Sanctuaire d\'émeraude.‡使用净化过的月亮井水熄灭暗影堡内部的四座火盆的火焰，从而破除其保护效果，然后向翡翠圣地的格雷塔·苔蹄复命。‡使用淨化過的月井水熄滅暗影堡內部的四座火盆的火焰，從而破除其保護效果，然後向翡翠聖地的格雷塔·苔蹄覆命。',
  }
},
[5166] = {
  {
    'Peitoral da Revoada Cromática‡Кираса Всецветных драконов‡Brustplatte des chromatischen Drachenschwarms‡오색용군단 흉갑‡Coraza del Vuelo Cromático‡Coraza del Vuelo Cromático‡La cuirasse du vol chromatique‡多彩巨龙胸甲‡炫彩巨龍胸甲',
    nil,
    'Para forjar o Peitoral da Revoada Cromática, você deverá levar os seguintes itens para Jezibá, o Escultor:nn1 Carapaça Cromática.nn10 Escamas Cromáticas Brilhantes.nn10 Sangues dos Heróis.nn10 Suturas de Abominação Puídas.‡Джезиба "Скульптор" может сковать кирасу Всецветных драконов, если вы принесете ему следующее:nn1 всецветный панцирь.nn10 сверкающих всецветных чешуек.nn10 порций крови героев.nn10 мотков потертого шовного материала.‡Um die Brustplatte des chromatischen Drachenschwarms zu schmieden, müsst Ihr die folgenden Gegenstände zu Jeziba dem \'Bildhauer\' bringen:nn1 chromatischen Knochenpanzer.nn10 glänzende chromatische Schuppen.nn10 Einheiten Blut von Helden.nn10 ausgefranste Monstrositätenstickereien.‡오색용군단 흉갑을 제작하려면 다음 재료를 모아 "조각사" 제지바에게 가져가야 합니다.n오색 등껍질 1개n반짝이는 오색 비늘 10개n영웅의 피 10개n닳아 해진 누더기골렘 조각 10개‡Para forjar la coraza del Vuelo Cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:nn1 caparazón cromático.nn10 escamas cromáticas luminosas.nn10 sangres de héroes.nn10 costuras desgarradas de abominación.‡Para forjar la coraza del Vuelo Cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n1 caparazón cromático.|n10 escamas cromáticas luminosas.|n10 sangres de héroes.|n10 costuras desgarradas de abominación.‡Pour forger la Cuirasse du vol chromatique, il faut apporter les éléments suivants à Jeziba le "Sculpteur" :nn1 Carapace chromatique.nn10 Ecailles chromatiques brillantes.nn10 doses de Sang des héros.nn10 Coutures d\'Abomination effilochées.‡为了铸造多彩巨龙胸甲，你必须把以下材料交给雕刻者耶兹巴：nn1块多彩龙鳞。nn10块闪亮的彩色龙鳞。nn10份英雄之血。nn10块磨损的憎恶缝合线。‡為了鑄造炫彩巨龍胸甲，你必須把以下材料交給雕刻者耶茲巴:|n1塊炫彩龍鱗。|n10塊閃亮的炫彩龍鱗。|n10份英雄之血。|n10條磨損的憎惡縫合線。',
  }
},
[5167] = {
  {
    'Coxotes do Desafiante Cromático‡Ножные латы Всецветного воина‡Beinplatten des chromatischen Widersetzers‡오색 파멸자의 다리갑옷‡Quijotes del Desafiante cromático‡Quijotes del desafiante cromático‡Les cuissards de duelliste chromatique‡多彩挑战者腿甲‡炫彩挑戰者腿鎧',
    nil,
    'Para forjar os Coxotes do Desafiante Cromático, você deverá levar os seguintes itens para Jezibá, o Escultor:nn1 Carapaça Cromática.nn10 Escamas Cromáticas Brilhantes.nn10 Sangues de Heróis.nn5 Peles de Sombra.‡Джезиба \'Скульптор\' может сковать ножные латы Всецветного воина, если вы принесете ему следующее:nn1 всецветный панцирь.nn10 сверкающих всецветных чешуек.nn10 порций крови героев.nn5 шкур тени.‡Um die Beinplatten des chromatischen Widersetzers zu schmieden, müsst Ihr die folgenden Gegenstände zu Jeziba dem \'Bildhauer\' bringen:nn1 chromatischer Knochenpanzer.nn10 glänzende chromatische Schuppen.nn10 Einheiten Blut von Helden.nn5 Häute des Schattens.‡오색 파멸자의 다리갑옷을 제작하려면 다음 재료를 모아 "조각사" 제지바에게 가져가야 합니다.n오색 등껍질 1개n반짝이는 오색 비늘 10개n영웅의 피 10개n어둠의 허물 5개‡Para forjar los quijotes del desafiante cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:nn1 caparazón cromático.nn10 escamas cromáticas luminosas.nn10 sangres de héroes.nn5 pieles de Sombra.‡Para forjar los quijotes del desafiante cromático deberás llevarle a Jeziba el \'Escultor" los siguientes objetos:|n1 caparazón cromático.|n10 escamas cromáticas luminosas.|n10 sangres de héroes.|n5 pieles de Sombra.‡Pour forger les Cuissards de duelliste chromatique, il faut apporter les éléments suivants à Jeziba le "Sculpteur" :nn1 Carapace chromatique.nn10 Ecailles chromatiques brillantes.nn10 doses de Sang des héros.nn5 Peaux des ombres.‡为了铸造多彩挑战者腿甲，你必须把以下材料交给雕刻者耶兹巴：nn1块多彩龙鳞。nn10块闪亮的彩色龙鳞。nn10份英雄之血。nn5块暗影之皮。‡為了鑄造炫彩挑戰者腿鎧，你必須把以下材料交給雕刻者耶茲巴:|n1塊炫彩龍鱗。|n10塊閃亮的炫彩龍鱗。|n10份英雄之血。|n5塊暗影之皮。',
  }
},
[5168] = {
  {
    'Heróis da Vila das Flechas‡Герои Дарроушира‡Helden von Darroheim‡다로우샤이어의 영웅‡Los héroes de Villa Darrow‡Los héroes de Villa Darrow‡Les héros de Comté-de-Darrow‡达隆郡的英雄‡達隆郡的英雄',
    nil,
    'Leve o Incunábulo de Davil e o Escudo de Trilharrubra para Carlin Trilharrubra.‡Принесите книгу Дейвила и щит Редпата Карлину Редпату.‡Bringt Davils Buchband und Rotpfads Schild zu Carlin Rotpfad.‡카를린 레드패스에게 다빌의 성서와 레드패스의 방패를 가져가야 합니다.‡Lleva el Tratado de Davil y el Escudo de Rutagrana a Carlin Rutagrana.‡Lleva el Tratado de Davil y el Escudo de Rutagrana a Carlin Rutagrana.‡Apporter le Libram de Davil et le Bouclier de Senterouge à Carlin Senterouge.‡把达维的圣契和雷德帕斯之盾交给卡林·雷德帕斯。‡把達維的聖契和雷德帕斯之盾交給卡林·雷德帕斯。',
  }
},
[5181] = {
  {
    'Vilões da Vila das Flechas‡Негодяи Дарроушира‡Bösewichte von Darroheim‡다로우샤이어의 악당들‡Los villanos de Villa Darrow‡Los villanos de Villa Darrow‡Vilains de Darrowshire‡达隆郡的恶魔‡達隆郡的惡魔',
    nil,
    'Leve o Crânio de Horgus e a Espada Estilhaçada de Marduk para Carlin Trilharrubra na Capela Esperança da Luz.‡Принесите череп Хоргуса и сломанный меч Мардука Карлину Редпату в часовню Последней Надежды.‡Bringt den Schädel von Horgus und das zertrümmerte Schwert von Marduk zu Carlin Rotpfad in der Kapelle des hoffnungsvollen Lichts.‡희망의 빛 예배당에 있는 카를린 레드패스에게 호르구스의 해골과 부러진 마르두크의 검을 가져가야 합니다.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Carlin Rutagrana a la Capilla de la Esperanza de la Luz.‡Lleva el cráneo de Horgus y la espada destrozada de Marduk a Carlin Rutagrana a la Capilla de la Esperanza de la Luz.‡Rapporter le Crâne d\'Horgus et l\'Epée brisée de Marduk à Carlin Senterouge à la chapelle de l\'Espoir de Lumière.‡将霍古斯的颅骨和马杜克的破碎之剑交给圣光之愿礼拜堂的卡林·雷德帕斯。‡將霍古斯的顱骨和馬杜克的破碎之劍交給聖光之願禮拜堂的卡林·雷德帕斯。',
  }
},
[5201] = {
  {
    'Invasão dos Invernosos‡Вторжение племени Зимней Спячки‡Eindringlinge der Winterfelle‡눈사태일족의 침략‡Intrusión Nevada‡Intrusión Nevada‡L\'incursion des Tombe-hiver‡冬泉熊怪的侵扰‡冬泉熊怪的侵擾',
    nil,
    'Ripárion Glaciares quer que você mate 5 Xamãs Invernosos e 5 Ursinos Invernosos.‡По заданию Риверна Холодного Ветра убейте 5 шаманов и 5 ведмедей из клана Зимней Спячки.‡Rivern Frostwind möchte, dass Ihr 5 Schamanen der Winterfelle und 5 Ursa der Winterfelle erschlagt.‡리베른 프로스트윈드가 눈사태일족 주술사 5마리와 눈사태일족 펄볼그 5마리를 처치하도록 요청했습니다.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Ventogélido quiere que mates 5 chamanes Nevada y 5 ursas Nevada.‡Rivern Givrevent veut que vous tuiez 5 Chamans Tombe-hiver et 5 Ursas Tombe-hiver.‡雷沃·霜翼要你去杀死5个冬泉萨满祭司和5个冬泉巨熊怪。‡雷沃·霜風要你去殺死5個冬泉薩滿和5個冬泉巨熊怪。',
  }
},
[5202] = {
  {
    'Uma estranha chave vermelha‡Странный красный ключ‡Ein merkwürdiger roter Schlüssel‡이상한 붉은 열쇠‡Una extraña llave roja‡Una extraña llave roja‡Une étrange clé rouge‡奇怪的红钥匙‡奇怪的紅鑰匙',
    nil,
    'Procure em Jaedenar o que pode ser aberto pela Chave Vermelho Sangue.‡Обыщите Джеденар и найдите замок, который открывается странным красным ключом.‡Durchsucht Jaedenar, um herauszufinden, wofür der blutrote Schlüssel verwendet wird.‡자에데나르를 뒤져 이 붉은 열쇠의 용도를 알아내야 합니다.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Recorre Jaedenar y descubre para qué se utiliza la llave roja de sangre.‡Chercher dans Jaedenar à quoi sert la Clé rouge sang.‡搜寻加德纳尔，找出血红钥匙的用途。‡搜尋加德納爾，找出血紅鑰匙的用途。',
  }
},
[5203] = {
  {
    'Resgate de Jaedenar‡Спасение из Джеденара‡Rettung aus Jaedenar‡자에데나르 탈출‡El rescate en Jaedenar‡El rescate en Jaedenar‡Sauvetage à Jaedenar‡逃出加德纳尔‡逃出加德納爾',
    nil,
    'Escolte Arko\'narin até onde Forjaleve e o equipamento dela estão, e então a proteja enquanto escapam da Fortaleza do Concílio das Sombras. Depois, procure Jessir Lunarco em Selva Maleva para informá-la sobre o que houve com os amigos dela.‡Сопроводите Арко\'нарин туда, где лежат меч Светлая Сталь и снаряжение Арконарин, и защитите ее при побеге из Оплота Теней. Потом разыщите Джессиру Лунную Радугу в Оскверненном лесу и расскажите ей, что случилось с ее друзьями.‡Bringt Arko\'narin dorthin, wo Lichtschmied und ihre Ausrüstung aufbewahrt werden, und beschützt sie dann bei eurer Flucht aus der Schattenfeste. Sucht danach Jessir Mondsichel im Teufelswald auf und lasst sie wissen, was mit ihren Freunden geschehen ist.‡아르코나린을 그녀의 방어구와 라이트포지가 있는 곳까지 호위해 간 후, 함께 어둠의 요새에서 빠져나가야 합니다. 그런 다음, 악령의 숲에 있는 제시 문보우를 찾아가 그녀의 친구들에게 무슨 일이 있었는지 알려 주어야 합니다.‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escolta a Arko\'narin hasta el lugar en el que están Forjaluz y su equipo y protégela en la huida de la Guarida Sombría. Después, busca a Jessir Arcolunar en Frondavil para contarle lo que les ha ocurrido a sus amigos.‡Escorter Arko\'narin à l\'endroit où Sancteforge et son équipement sont détenus, puis la protéger lors de l\'évasion du Fort des ombres. Ensuite, aller trouver Jessir Arquelune dans Gangrebois pour lui apprendre ce qui est arrivé à ses amis.‡护送亚科纳琳到莱弗治和她的装备所在的地方，然后保护她逃离暗影堡。之后，在费伍德森林找杰希尔·月弓，并告诉她刚才发生的事情。‡護送亞科納琳到萊弗治和她的裝備所在的地方，然後保護她逃離暗影堡。之後，在費伍德森林找傑希爾·月弓，並告訴她剛才發生的事情。',
  }
},
[5204] = {
  {
    'Retaliação da Luz‡Воздаяние Света‡Vergeltung des Lichts‡정의의 복수‡La reprensión de la Luz‡La reprensión de la Luz‡Le châtiment de la Lumière‡光明的惩戒‡光明的懲戒',
    nil,
    'Volte a Jaedenar e mate o súcubo Rakaiah antes de encontrar os Restos Mortais de Trey Forjaleve.‡Вернитесь в Джеденар и убейте суккуба Ракайю, затем отыщите останки Трея Светогорна.‡Kehrt nach Jaedenar zurück und tötet den Sukkubus Rakaiah, bevor Ihr die Überreste von Trey Lichtschmied sucht.‡자에데나르로 돌아가 서큐버스 라카이아를 처치한 후, 트레이 라이트포지의 유해를 찾아와야 합니다.‡Vuelve a Jaedenar y mata al súcubo Rakaiah antes de encontrar los Restos de Trey Forjaluz.‡Vuelve a Jaedenar y mata al súcubo Rakaiah antes de encontrar los Restos de Trey Forjaluz.‡Revenir à Jaedenar et tuer la succube Rakaiah avant de trouver le Cadavre de Trey Sancteforge.‡回到加德纳尔杀了魅魔拉凯雅，然后找到特雷·莱弗治的残骸。‡回到加德納爾殺了魅魔拉凱雅，然後找到特雷·萊弗治的殘骸。',
  }
},
[5206] = {
  {
    'Espoliadores da Vila das Flechas‡Мародеры Дарроушира‡Marodeure von Darroheim‡다로우샤이어의 약탈자들‡Los merodeadores de Villa Darrow‡Los merodeadores de Villa Darrow‡Les maraudeurs de Comté-de-Darrow‡达隆郡的掠夺者‡達隆郡的掠奪者',
    nil,
    'Leve 5 Crânios Ressonantes e o Cristal Místico para Carlin Trilharrubra nas Terras Pestilentas Orientais.‡Принесите 5 резонирующих черепов и загадочный кристалл Карлину Редпату в Восточные Чумные земли.‡Bringt 5 widerhallende Schädel und den Mystikerkristall zu Carlin Rotpfad in den östlichen Pestländern.‡동부 역병지대에 있는 카를린 레드패스에게 텅빈 해골 5개와 불가사의한 수정을 가져가야 합니다.‡Lleva 5 calaveras resonadoras y el cristal místico a Carlin Rutagrana a las Tierras de la Peste del Este.‡Lleva 5 calaveras resonadoras y el cristal místico a Carlin Rutagrana a las Tierras de la Peste del Este.‡Apporter 5 Crânes résonants et le Cristal mystique à Carlin Senterouge, dans les Maleterres de l\'est.‡把5个共鸣颅骨和神秘水晶交给东瘟疫之地的卡林·雷德帕斯。‡把5個共鳴顱骨和神秘水晶交給東瘟疫之地的卡林·雷德帕斯。',
  }
},
[5210] = {
  {
    'Irmão Carlin‡Брат Карлин‡Bruder Carlin‡카를린 레드패스‡Carlin, el hermano de Joseph‡Carlin, el hermano de Joseph‡Frère Carlin‡卡林·雷德帕斯‡卡林弟兄',
    nil,
    'Leve os Anais Estendidos da Vila das Flechas para Carlin Trilharrubra nas Terras Pestilentas Orientais.‡Отнесите дополненные анналы Дарроушира Карлину Редпату в Восточные Чумные земли.‡Bringt die erweiterten \'Annalen von Darroheim\' zu Carlin Rotpfad in den östlichen Pestländern.‡동부 역병지대에 있는 카를린 레드패스에게 확장된 다로우샤이어 연대기를 가져가야 합니다.‡Lleva los anales ampliados de Villa Darrow a Carlin Rutagrana a las Tierras de la Peste del Este.‡Lleva las Crónicas ampliadas de Villa Darrow a Carlin Rutagrana a las Tierras de la Peste del Este.‡Apporter les Annales complètes de Comté-de-Darrow à Carlin Senterouge dans les Maleterres de l\'est.‡将《达隆镇全史》交给东瘟疫之地的卡林·雷德帕斯。‡將《達隆鎮全史》交給東瘟疫之地的卡林·雷德帕斯。',
  }
},
[5211] = {
  {
    'Defensores da Vila das Flechas‡Защитники Дарроушира‡Verteidiger von Darroheim‡다로우샤이어의 병사들‡Los defensores de Villa Darrow‡Los defensores de Villa Darrow‡Les défenseurs de Comté-de-Darrow‡达隆郡的保卫者‡達隆郡的防衛者',
    nil,
    'Liberte 15 Espíritos da Vila das Flechas e fale novamente com Carlin Trilharrubra.‡Освободите 15 дарроуширских духов и возвращайтесь к Карлину Редпату.‡Befreit 15 Geister von Darroheim und kehrt dann zu Carlin Rotpfad zurück.‡15명의 다로우샤이어 주민들의 원혼을 자유롭게 하고 카를린 레드패스에게 돌아가야 합니다.‡Libera a 15 espíritus de Villa Darrow y vuelve con Carlin Rutagrana.‡Libera a 15 espíritus de Villa Darrow y vuelve con Carlin Rutagrana.‡Libérer 15 Esprits de Comté-de-Darrow et retourner auprès de Carlin Senterouge.‡释放15个达隆郡居民的灵魂，然后返回卡林·雷德帕斯身边。‡釋放15個達隆郡居民的靈魂，然後返回卡林·雷德帕斯身邊。',
  }
},
[5212] = {
  {
    'A carne não mente‡Плоть не лжет‡Das Fleisch lügt nicht‡거짓말하지 않는 육체‡La carne no miente‡La carne no miente‡La chair ne ment pas‡血肉不会撒谎‡血肉不會撒謊',
    nil,
    'Recupere 10 Amostras de Carne Infectada de Stratholme e leve-as para Betina Bigozinco. Você desconfia que qualquer criatura em Stratholme poderia ter essa amostra de carne.‡Принесите 10 препаратов чумной плоти из Стратхольма Бетине Биггльцинк. Предположительно, любая тварь из Стратхольма сойдет за препарат.‡Sammelt 10 verseuchte Fleischproben in Stratholme und bringt sie zu Betina Moppelzink zurück. Ihr vermutet, dass Ihr besagte Fleischproben bei jeder Kreatur in Stratholme finden könnt.‡스트라솔름에서 10개의 역병 걸린 살덩어리 견본을 베티나 비글징크에게 가져다주어야 합니다. 스트라솔름의 어떤 생물에서든 살덩어리 견본을 구할 수 있을 것 같습니다.‡Recoge 10 muestras de carne apestada de Stratholme y vuelve con Betina Bigglezink. Sospechas que podrías obtener una muestra de cualquier criatura de Stratholme.‡Recoge 10 muestras de carne apestada de Stratholme y vuelve con Betina Bigglezink. Sospechas que podrías obtener una muestra de cualquier criatura de Stratholme.‡Récupérer 10 Échantillons de chair pestiférée à Stratholme puis les rapporter à Betina Bigglezink. Vous pensez que toutes les créatures de Stratholme possèdent de tels échantillons de chair.‡从斯坦索姆找回10个瘟疫肉块，并把它们交给贝蒂娜·比格辛克。你觉得斯坦索姆中的生灵都不大可能长着肉......‡從斯坦索姆找回10個瘟疫肉塊，並把它們交給貝蒂娜·比格辛克。你覺得斯坦索姆中的生物都不大可能長著肉。',
  }
},
[5213] = {
  {
    'O agente ativo‡Вирус чумы‡Der aktive Wirkstoff‡활성 역병 인자‡El agente activo‡El agente activo‡L\'agent actif‡活跃的探子‡活躍的探子',
    nil,
    'Vá para Stratholme e vasculhe os zigurates. Encontre novos Dados do Flagelo e leve-os para Betina Bigozinco.‡Отправляйтесь в Стратхольм и исследуйте зиккураты. Доставьте сведения о Плети Бетине Биггльцинк.‡Reist nach Stratholme und durchsucht die Ziggurats. Sucht neue Geißeldaten und bringt sie zu Betina Moppelzink zurück.‡스트라솔름으로 가서 지구라트를 조사해야 합니다. 스컬지 자료를 찾아 베티나 비글징크에게 돌아가야 합니다.‡Viaja a Stratholme y busca los zigurats. Encuentra información sobre la Plaga y llévasela a Betina Bigglezink.|n‡Viaja a Stratholme y busca los zigurats. Encuentra información sobre la Plaga y llévasela a Betina Bigglezink.‡Se rendre jusqu\'à Stratholme et fouiller les ziggourats. Trouver et ramener de nouvelles informations sur le Fléau à Betina Bigglezink.‡到斯坦索姆去探索那里的通灵塔。找到新的天灾军团档案，把它交给贝蒂娜·比格辛克。‡到斯坦索姆去探索那裡的通靈塔。找到新的天譴軍團檔案，把它交給貝蒂娜·比格辛克。',
  }
},
[5214] = {
  {
    'A tentação de Fras Siabi‡Великий Фрас Сиаби‡Der große Fras Siabi‡위대한 프라스 샤비‡El gran Fras Siabi‡El gran Fras Siabi‡Le grand Fras Siabi‡弗拉斯·希亚比‡弗拉斯·希亞比',
    nil,
    'Encontre a tabacaria de Fras Siabi em Stratholme e recolha uma caixa do Tabaco da Lata do Fras Siabi. Fale novamente com Leandro Leonardo depois que tiver terminado o serviço.‡Найдите табачную лавку Фраса Сиаби в Стратхольме, отыщите в ней пачку лучшего табака Сиаби и принесите ее Смоки Ля Рю.‡Sucht Fras Siabis Raucherladen in Stratholme und bergt einen Kasten von Siabis Tollem Tabak. Kehrt zu Smokey LaRue zurück, wenn Eure Aufgabe erledigt ist.‡스트라솔름에서 샤비의 최고급 담배를 회수하여 스모키 라루에게 가져가야 합니다.‡Encuentra la Tienda de humo de Fras Siabi en Stratholme y recupera una caja del tabaco de calidad de Siabi. Cuando lo hayas hecho, vuelve con Smokey LaRue.|n‡Encuentra la Tienda de humo de Fras Siabi en Stratholme y recupera una caja del tabaco de calidad de Siabi. Cuando lo hayas hecho, vuelve con Smokey LaRue.‡Trouver le magasin de tabac de Fras Siabi dans Stratholme et récupérer une boîte de Tabac de Siabi. Retourner auprès de Smokey LaRue quand le travail est fait.‡找到弗拉斯·希亚比在斯坦索姆的烟草店，并从中找回一盒希亚比的烟草，把它交给烟鬼拉鲁恩。‡找到弗拉斯·希亞比在斯坦索姆的煙草店，並從中找回一盒希亞比的煙草，把它交給煙鬼拉魯恩。',
  }
},
[5215] = {
  {
    'Os caldeirões do Flagelo‡Котлы Плети‡Die Geißelkessel‡스컬지 가마솥‡Las calderas de la Plaga‡Las calderas de la Plaga‡Les chaudrons du Fléau‡瘟疫之锅‡瘟疫之鍋',
    nil,
    'Fale com a Alta-sacerdotisa Donélia no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с верховной жрицей Макдонелл на Берегу Промозглого Ветра в Западных Чумных землях.‡Sprecht mit der Hohepriesterin MacDonnell an der Zugwindspitze, westliche Pestländer.‡서부 역병지대의 서리바람 거점에 있는 대여사제 맥도널과 대화해야 합니다.‡Habla con la suma sacerdotisa MacDonnell en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Habla con la suma sacerdotisa MacDonnell en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Parler à la grande prêtresse MacDonnell à la pointe du Noroît, dans les Maleterres de l\'ouest.‡与西瘟疫之地冰风岗的高阶牧师玛多妮尔谈一谈。‡與西瘟疫之地冰風崗的高階牧師瑪多妮爾談話。',
  }
},
[5216] = {
  {
    'Alvo: Campo Pedravil‡Цель: поле Джанис‡Ziel: Teufelssteinfeld‡목표: 펠스톤 농장‡Objetivo: Campo de Piedramácula‡Objetivo: Campo de Piedramácula‡Cible : le Champ de Gangrepierre‡目标：费尔斯通农场‡目標:費爾斯通農場',
    nil,
    'Vá ao Campo Pedravil nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá. Ele pode ter uma chave que dê acesso ao caldeirão. Você precisa estar com a Garrafa do Campo Pedravil Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на поле Джанис в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Джанис.‡Geht zum Teufelssteinfeld in den westlichen Pestländern. Sucht nach dem dortigen Kessellord und besiegt ihn. Er könnte einen Schlüssel haben, der den Zugang zu dem Kessel ermöglicht. Ihr müsst die leere Flasche: Teufelssteinfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 펠스톤 농장으로 가서 그곳에 있는 가마솥군주를 찾아 물리치십시오. 가마솥군주가 가마솥으로 통하는 열쇠를 지니고 있을 수도 있습니다. 빈 펠스톤 농장 병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Champ de Gangrepierre dans les Maleterres de l\'ouest pour trouver et vaincre le Seigneur du Chaudron qui s\'y trouve. Il aura peut-être une clé qui permet d\'accéder au chaudron. Il faut se munir de la Bouteille du Champ de Gangrepierre vide pour pouvoir prélever un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的费尔斯通农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带费尔斯通农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的費爾斯通農場去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶費爾斯通農場的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5217] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Zugwindlager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風營地',
    nil,
    'Leve a Garrafa do Campo Pedravil Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Джанис верховной жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Teufelssteinfeld zur Hohepriesterin MacDonnell am Zugwindlager, westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 펠스톤 농장 병을 가져가야 합니다.‡Lleva la Botella rellena del Campo de Piedramácula a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la Botella rellena del Campo de Piedramácula a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter une Bouteille du Champ de Gangrepierre remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l\'ouest.‡把费尔斯通农场的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把費爾斯通農場的樣本瓶交給西瘟疫之地冰風營地的高階牧師瑪多妮爾。',
  }
},
[5218] = {
  {
    'Caldeirão do Campo Pedravil‡Котел поля Джанис‡Der Kessel des Teufelssteinfelds‡펠스톤 농장 가마솥‡El caldero del Campo de Piedramácula‡La caldera del Campo de Piedramácula‡Le chaudron du champ de Gangrepierre‡费尔斯通农场的瘟疫之锅‡費爾斯通農場的瘟疫之鍋',
    nil,
    '‡Перед вами – котел Плети. Он бурлит, испуская в воздух огромное количество ядовитых испарений. У массивного основания котла находится небольшая панель доступа.nnОдолев Хранителя котла и забрав у него ключ, мы можете добавить в котел любые составляющие, чтобы превратить его в средство борьбы с чумой нежити.‡Der Seuchenkessel der Geißel steht vor Euch und speit große Mengen Toxin in die Luft. Eine kleine, unauffällige Zugangsklappe befindet sich in der großen Plattform des Kessels.nnDa Ihr den Kessellord bereits besiegt und seinen Schlüssel an Euch genommen habt, könnt Ihr die geeigneten Reagenzien in den Kessel geben, um ein Gegenmittel gegen die Seuche zu schaffen.‡앞에는 스컬지의 역병 가마솥이 공기 중에 엄청난 양의 독을 뿜어대고 있습니다. 가마솥의 거대한 단 아랫부분에는 작고 특별할 것 없어 보이는 입구가 있습니다.nn이미 가마솥군주를 처치하고 그 열쇠를 얻었으니 역병에 대한 반작용 물질을 만들기 위해 적절한 재료를 마음대로 가마솥에 넣을 수 있습니다.‡‡‡Le chaudron de la peste du Fléau est devant vous, répandant d\'énormes masses de toxine dans les airs. À la base de la vaste plate-forme du chaudron se trouve un petit panneau d\'accès anodin.nnPuisque vous avez déjà vaincu le gardien du chaudron et pris sa clé, vous pouvez ajouter les composants appropriés dans le chaudron pour fabriquer un contre-agent à la peste.‡‡',
  }
},
[5219] = {
  {
    'Alvo: Lágrimas de Dalson‡Цель: Слезы Далсона‡Ziel: Dalsons Tränenfeld‡목표: 달슨의 눈물‡Objetivo: Llanto de Dalson‡Objetivo: Llanto de Dalson‡Cible : les Larmes de Dalson‡目标：达尔松之泪‡目標:達爾松之淚',
    nil,
    'Vá a Lágrimas de Dalson nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa das Lágrimas de Dalson Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Слезы Далсона в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Слез Далсона.‡Begebt Euch zu Dalsons Tränenfeld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Dalsons Tränenfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 달슨의 눈물로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 지닌 열쇠를 사용해 가마솥에 접근하십시오. 반드시 달슨의 눈물 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre aux Larmes de Dalson dans les Maleterres de l\'ouest pour trouver et vaincre le Seigneur du Chaudron qui s\'y trouve, puis utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille des Larmes de Dalson vide pour pouvoir prendre un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的达尔松之泪去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带达尔松之泪的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的達爾松之淚去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶達爾松之淚的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5220] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Zugwindlager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風營地',
    nil,
    'Leve a Garrafa das Lágrimas de Dalson Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Слез Далсона верховной жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Dalsons Tränenfeld zur Hohepriesterin MacDonnell am Zugwindlager, westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 달슨의 눈물 혼합물을 가져가야 합니다.‡Lleva la botella del Llanto de Dalson llena a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la botella del Llanto de Dalson llena a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille des Larmes de Dalson remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l\'ouest.‡把达尔松之泪的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把達爾松之淚的樣本瓶交給西瘟疫之地冰風營地的高階牧師瑪多妮爾。',
  }
},
[5221] = {
  {
    'Caldeirão das Lágrimas de Dalson‡Котел Слез Далсона‡Der Kessel von Dalsons Tränenfeld‡달슨의 눈물 가마솥‡La caldera del Llanto de Dalson‡La caldera del Llanto de Dalson‡Le chaudron des Larmes de Dalson‡达尔松之泪的瘟疫之锅‡達爾松之淚的瘟疫之鍋',
    nil,
    '‡Перед вами – котел Плети. Он бурлит, испуская в воздух огромное количество ядовитых испарений. У массивного основания котла находится небольшая панель доступа.nnОдолев Хранителя котла и забрав у него ключ, мы можете добавить в котел любые составляющие, чтобы превратить его в средство борьбы с чумой нежити.‡Der Seuchenkessel der Geißel steht vor Euch und speit große Mengen Toxin in die Luft. Eine kleine, unauffällige Zugangsklappe befindet sich in der großen Plattform des Kessels.nnDa Ihr den Kessellord bereits besiegt und seinen Schlüssel an Euch genommen habt, könnt Ihr die geeigneten Reagenzien in den Kessel geben, um ein Gegenmittel gegen die Seuche zu schaffen.‡앞에는 스컬지의 역병 가마솥이 공기 중에 엄청난 양의 독을 뿜어대고 있습니다. 가마솥의 거대한 단 아랫부분에는 작고 특별할 것 없어 보이는 입구가 있습니다.nn이미 가마솥군주를 처치하고 그 열쇠를 얻었으니 역병에 대한 반작용 물질을 만들기 위해 적절한 재료를 마음대로 가마솥에 넣을 수 있습니다.‡‡‡Le chaudron de la peste du Fléau est devant vous, répandant d\'énormes masses de toxine dans les airs. À la base de la vaste plate-forme du chaudron se trouve un petit panneau d\'accès anodin.nnPuisque vous avez déjà vaincu le gardien du chaudron et pris sa clé, vous pouvez ajouter les composants appropriés dans le chaudron pour fabriquer un contre-agent à la peste.‡‡',
  }
},
[5222] = {
  {
    'Alvo: Antro Repelente‡Цель: Удел Страданий‡Ziel: Das trostlose Feld‡목표: 고통의 흉가‡Objetivo: El Tormento‡Objetivo: El Tormento‡Cible : le Repaire putride‡目标：嚎哭鬼屋‡目標:嚎哭鬼屋',
    nil,
    'Vá ao Antro Repelente nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa do Antro Repelente Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Удел Страданий в Западных Чумных землях. Найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с Удела Страданий.‡Begebt Euch zum trostlosen Feld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Das trostlose Feld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 고통의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 고통의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Repaire putride dans les Maleterres de l\'ouest pour trouver et vaincre le Seigneur du Chaudron qui s\'y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille du Repaire putride vide pour pouvoir récupérer un échantillon des poisons à l\'intérieur du chaudron.‡到西瘟疫之地的嚎哭鬼屋去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带嚎哭鬼屋的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的嚎哭鬼屋去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶嚎哭鬼屋的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5223] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Zugwindlager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風營地',
    nil,
    'Leve a Garrafa do Antro Repelente Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с Призрачной фермы верховной жрице Макдонелл в Лагерь Промозглого Ветра, в Западные Чумные земли.‡Bringt die gefüllte Flasche: Das trostlose Feld zur Hohepriesterin MacDonnell am Zugwindlager, westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 고통의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella llena de El Tormento a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la Botella llena de El Tormento a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille du Repaire putride remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l\'ouest.‡把嚎哭鬼屋的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把嚎哭鬼屋的樣本瓶交給西瘟疫之地冰風營地的高階牧師瑪多妮爾。',
  }
},
[5224] = {
  {
    'Caldeirão do Antro Repelente‡Котел Призрачной фермы‡Der Kessel des trostlosen Felds‡고통의 흉가 가마솥‡El caldero de El Tormento‡La caldera de El Tormento‡Le chaudron du Repaire putride‡嚎哭鬼屋的瘟疫之锅‡嚎哭鬼屋的瘟疫之鍋',
    nil,
    '‡Перед вами – котел Плети. Он бурлит, испуская в воздух огромное количество ядовитых испарений. У массивного основания котла находится небольшая панель доступа.nnОдолев Хранителя котла и забрав у него ключ, мы можете добавить в котел любые составляющие, чтобы превратить его в средство борьбы с чумой нежити.‡Der Seuchenkessel der Geißel steht vor Euch und speit große Mengen Toxin in die Luft. Eine kleine, unauffällige Zugangsklappe befindet sich in der großen Plattform des Kessels.nnDa Ihr den Kessellord bereits besiegt und seinen Schlüssel an Euch genommen habt, könnt Ihr die geeigneten Reagenzien in den Kessel geben, um ein Gegenmittel gegen die Seuche zu schaffen.‡앞에는 스컬지의 역병 가마솥이 공기 중에 엄청난 양의 독을 뿜어대고 있습니다. 가마솥의 거대한 단 아랫부분에는 작고 특별할 것 없어 보이는 입구가 있습니다.nn이미 가마솥군주를 처치하고 그 열쇠를 얻었으니 역병에 대한 반작용 물질을 만들기 위해 적절한 재료를 마음대로 가마솥에 넣을 수 있습니다.‡‡‡Le chaudron de la peste du Fléau est devant vous, répandant d\'énormes masses de toxine dans les airs. À la base de la vaste plate-forme du chaudron se trouve un petit panneau d\'accès anodin.nnPuisque vous avez déjà vaincu le gardien du chaudron et pris sa clé, vous pouvez ajouter les composants appropriés dans le chaudron pour fabriquer un contre-agent à la peste.‡‡',
  }
},
[5225] = {
  {
    'Alvo: Aridez de Garrão‡Цель: пустошь Гаррона‡Ziel: Gahrrons Trauerfeld‡목표: 가론의 흉가‡Objetivo: Gangrena de Gahrron‡Objetivo: Gangrena de Gahrron‡Cible : la Flétrissure de Gahrron‡目标：盖罗恩农场‡目標:蓋羅恩農場',
    nil,
    'Vá a Aridez de Garrão nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa da Aridez de Garrão Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на пустошь Гаррона в Западных Чумных землях, найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с путоши Гаррона.‡Begebt Euch zu Gahrrons Trauerfeld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Gahrrons Trauerfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 가론의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 가론의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre à la Flétrissure de Gahrron dans les Maleterres de l\'ouest pour trouver et vaincre le Seigneur du Chaudron qui s\'y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille de la Flétrissure de Gahrron vide pour pouvoir récupérer un échantillon des poisons à l\'intérieur du chaudron.‡到西瘟疫之地的盖罗恩农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带盖罗恩农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的蓋羅恩農場去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶蓋羅恩農場的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5226] = {
  {
    'Retorno ao Acampamento Ventogelante‡Возвращение в Лагерь Промозглого Ветра‡Rückkehr zum Zugwindlager‡서리바람 야영지로의 귀환‡El regreso al Campamento del Orvallo‡Regresa al Campamento del Orvallo‡Retour au camp du Noroît‡返回冰风岗‡返回冰風營地',
    nil,
    'Leve a Garrafa da Aridez de Garrão Cheia à Alta-sacerdotisa Donélia no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с пустоши Гаррона высшей жрице Макдонелл в Лагерь Промозглого Ветра, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Gahrrons Trauerfeld zur Hohepriesterin MacDonnell am Zugwindlager, westliche Pestländer.‡서부 역병지대의 서리바람 야영지에 있는 대여사제 맥도널에게 가득 찬 가론의 흉가 혼합물을 가져가야 합니다.‡Lleva la botella llena de la Gangrena de Gahrron a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva la botella llena de la Gangrena de Gahrron a la suma sacerdotisa MacDonnell en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille de la Flétrissure de Gahrron remplie à la grande prêtresse MacDonnell au camp du Noroît, dans les Maleterres de l\'ouest.‡把盖罗恩农场的样本瓶交给西瘟疫之地冰风岗的高阶牧师玛多妮尔。‡把蓋羅恩農場的樣本瓶交給西瘟疫之地冰風營地的高階牧師瑪多妮爾。',
  }
},
[5227] = {
  {
    'Caldeirão da Aridez de Garrão‡Котел пустоши Гаррона‡Der Kessel von Gahrrons Trauerfeld‡가론의 흉가 가마솥‡El caldero de la Gangrena de Gahrron‡La caldera de la Gangrena de Gahrron‡Le chaudron de la Flétrissure de Gahrron‡盖罗恩农场的瘟疫之锅‡蓋羅恩農場的瘟疫之鍋',
    nil,
    '‡Перед вами – котел Плети. Он бурлит, испуская в воздух огромное количество ядовитых испарений. У массивного основания котла находится небольшая панель доступа.nnОдолев Хранителя котла и забрав у него ключ, мы можете добавить в котел любые составляющие, чтобы превратить его в средство борьбы с чумой нежити.‡Der Seuchenkessel der Geißel steht vor Euch und speit große Mengen Toxin in die Luft. Eine kleine, unauffällige Zugangsklappe befindet sich in der großen Plattform des Kessels.nnDa Ihr den Kessellord bereits besiegt und seinen Schlüssel an Euch genommen habt, könnt Ihr die geeigneten Reagenzien in den Kessel geben, um ein Gegenmittel gegen die Seuche zu schaffen.‡앞에는 스컬지의 역병 가마솥이 공기 중에 엄청난 양의 독을 뿜어대고 있습니다. 가마솥의 거대한 단 아랫부분에는 작고 특별할 것 없어 보이는 입구가 있습니다.nn이미 가마솥군주를 처치하고 그 열쇠를 얻었으니 역병에 대한 반작용 물질을 만들기 위해 적절한 재료를 마음대로 가마솥에 넣을 수 있습니다.‡‡‡Le chaudron de la peste du Fléau est devant vous, répandant d\'énormes masses de toxine dans les airs. À la base de la vaste plate-forme du chaudron se trouve un petit panneau d\'accès anodin.nnPuisque vous avez déjà vaincu le gardien du chaudron et pris sa clé, vous pouvez ajouter les composants appropriés dans le chaudron pour fabriquer un contre-agent à la peste.‡‡',
  }
},
[5228] = {
  {
    'Os caldeirões do Flagelo‡Котлы Плети‡Die Geißelkessel‡스컬지 가마솥‡Los calderos de la Plaga‡Las calderas de la Plaga‡Les chaudrons du Fléau‡瘟疫之锅‡瘟疫之鍋',
    nil,
    'Fale com a Sacerdotisa Sombria Vandis, em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Поговорите со жрицей Тьмы Вандис в Бастионе, что в Западных Чумных землях.‡Sprecht mit der Schattenpriesterin Vandis am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스와 대화해야 합니다.‡Habla con la sacerdotisa de las Sombras Vandis en el Baluarte, en las Tierras de la Peste del Oeste.‡Habla con la sacerdotisa de las Sombras Vandis en el Baluarte, en las Tierras de la Peste del Oeste.‡Parler à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l\'ouest.‡与西瘟疫之地亡灵壁垒的暗影牧师范蒂丝谈一谈。‡與西瘟疫之地亡靈壁壘的暗影牧師范蒂絲談話。',
  }
},
[5229] = {
  {
    'Alvo: Campo Pedravil‡Цель: поле Джанис‡Ziel: Teufelssteinfeld‡목표: 펠스톤 농장‡Objetivo: Campo de Piedramácula‡Objetivo: Campo de Piedramácula‡Cible : le Champ de Felstone‡目标：费尔斯通农场‡目標:費爾斯通農場',
    nil,
    'Vá ao Campo Pedravil nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá. Ele pode ter uma chave que dê acesso ao caldeirão. Você precisa estar com a Garrafa do Campo Pedravil Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на поле Джанис в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Джанис.‡Geht zum Teufelssteinfeld in den westlichen Pestländern. Sucht nach dem dortigen Kessellord und besiegt ihn. Er könnte einen Schlüssel haben, der den Zugang zu dem Kessel ermöglicht. Ihr müsst die leere Flasche: Teufelssteinfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 펠스톤 농장으로 가서 그곳에 있는 가마솥군주를 찾아 물리치십시오. 가마솥군주가 가마솥으로 통하는 열쇠를 지니고 있을 수 있습니다. 반드시 빈 펠스톤 농장 병을 가지고 가서 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Campo de Piedramácula en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Seguramente tendrá una llave para acceder a la caldera. Debes llevar contigo la Botella vacía del Campo de Piedramácula para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Champ de Gangrepierre, dans les Maleterres de l\'ouest, pour trouver et vaincre le Seigneur du Chaudron qui s\'y trouve. Il aura peut-être une clé qui permet d\'accéder au chaudron. Il faut se munir de la Bouteille du Champ de Gangrepierre vide pour pouvoir prélever un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的费尔斯通农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带费尔斯通农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的費爾斯通農場去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶費爾斯通農場的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5230] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa do Campo Pedravil Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с поля Джанис жрице Тьмы Вандис в Бастион, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Teufelssteinfeld zur Schattenpriesterin Vandis am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 펠스톤 농장 병을 가져가야 합니다.‡Lleva la Botella rellena del Campo de Piedramácula a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la Botella rellena del Campo de Piedramácula a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille du Champ de Gangrepierre remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l\'ouest.‡把费尔斯通农场的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把費爾斯通農場的樣本瓶交給西瘟疫之地亡靈壁壘的暗影牧師范蒂絲。',
  }
},
[5231] = {
  {
    'Alvo: Lágrimas de Dalson‡Цель: Слезы Далсона‡Ziel: Dalsons Tränenfeld‡목표: 달슨의 눈물‡Objetivo: Llanto de Dalson‡Objetivo: Llanto de Dalson‡Cible : les Larmes de Dalson‡目标：达尔松之泪‡目標:達爾松之淚',
    nil,
    'Vá a Lágrimas de Dalson nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa das Lágrimas de Dalson Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Слезы Далсона в Западных Чумных землях, найдите и одолейте Хранителя котла, взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка c поля Слез Далсона.‡Begebt Euch zu Dalsons Tränenfeld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Dalsons Tränenfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 달슨의 눈물로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 달슨의 눈물 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve al Llanto de Dalson en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la botella vacía del Llanto de Dalson para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre aux Larmes de Dalson dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, puis utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille des larmes de Dalson vide pour pouvoir prendre un échantillon des poisons qui sont dans le chaudron.‡到西瘟疫之地的达尔松之泪去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带达尔松之泪的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的達爾松之淚去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶達爾松之淚的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5232] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa das Lágrimas de Dalson Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с поля Слез Далсона жрице Тьмы Вандис в Бастион в Западных Чумных землях.‡Bringt die gefüllte Flasche: Dalsons Tränenfeld zur Schattenpriesterin Vandis am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 달슨의 눈물 혼합물을 가져가야 합니다.‡Lleva la botella del Llanto de Dalson llena a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la botella del Llanto de Dalson llena a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille des Larmes de Dalson remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把装满的达尔松眼泪之瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把裝滿的達爾松眼淚之瓶交給西瘟疫之地亡靈壁壘的暗影牧師范蒂絲。',
  }
},
[5233] = {
  {
    'Alvo: Antro Repelente‡Цель: Удел Страданий‡Ziel: Das trostlose Feld‡목표: 고통의 흉가‡Objetivo: El Tormento‡Objetivo: El Tormento‡Cible : le Repaire putride‡目标：嚎哭鬼屋‡目標:嚎哭鬼屋',
    nil,
    'Vá ao Antro Repelente nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa do Antro Repelente Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь в Удел Страданий в Западных Чумных землях. Найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с Удела Страданий.‡Begebt Euch zum trostlosen Feld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Das trostlose Feld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 고통의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 고통의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a El Tormento en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de El Tormento para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre au Repaire putride dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide du Repaire putride pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的嚎哭鬼屋去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带嚎哭鬼屋的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的嚎哭鬼屋去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶嚎哭鬼屋的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5234] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa do Antro Repelente Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите полную бутылку с Призрачной фермы жрице Тьмы Вандис в Бастион, что в Западных Чумных землях.‡Bringt die gefüllte Flasche: Das trostlose Feld zur Schattenpriesterin Vandis am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 고통의 흉가 혼합물을 가져가야 합니다.‡Lleva la Botella llena de El Tormento a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la Botella llena de El Tormento a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Ramener la Bouteille du Repaire putride remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把嚎哭鬼屋的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把裝滿了的瓶子交給西瘟疫之地的亡靈壁壘暗影牧師范蒂絲。',
  }
},
[5235] = {
  {
    'Alvo: Aridez de Garrão‡Цель: пустошь Гаррона‡Ziel: Gahrrons Trauerfeld‡목표: 가론의 흉가‡Objetivo: Gangrena de Gahrron‡Objetivo: Gangrena de Gahrron‡Cible : la Flétrissure de Gahrron‡目标：盖罗恩农场‡目標:蓋羅恩農場',
    nil,
    'Vá a Aridez de Garrão nas Terras Pestilentas Ocidentais para localizar e derrotar o Mestre do Caldeirão de lá, e use a chave dele para ter acesso ao caldeirão. Você precisa estar com a Garrafa da Aridez de Garrão Vazia para guardar uma amostra dos venenos usados no caldeirão.‡Отправляйтесь на пустошь Гаррона в Западных Чумных землях, найдите и одолейте Хранителя котла. Взяв у него ключ, доберитесь до самого котла. Чтобы взять образец яда из котла, вам понадобится пустая бутылка с путоши Гаррона.‡Begebt Euch zu Gahrrons Trauerfeld in den westlichen Pestländern, um den dortigen Kessellord zu suchen und zu besiegen. Verwendet dann seinen Schlüssel, um Zugang zum Kessel zu erhalten. Ihr müsst die leere Flasche: Gahrrons Trauerfeld bei Euch haben, um eine Probe des Giftes zu entnehmen, das sich in dem Kessel findet.‡서부 역병지대의 가론의 흉가로 가서 그곳에 있는 가마솥군주를 찾아 물리치고, 그가 가진 열쇠를 사용해 가마솥에 접근하십시오. 반드시 가론의 흉가 빈병으로 가마솥 안에 있는 독의 견본을 확보해야 합니다.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Ve a la Gangrena de Gahrron en las Tierras de la Peste del Oeste para localizar y derrotar a su señor de la caldera. Utiliza su llave para acceder a la caldera. Debes llevar contigo la Botella vacía de la Gangrena de Gahrron para obtener una muestra de los venenos utilizados en el interior de la caldera.‡Se rendre à la Flétrissure de Gahrron dans les Maleterres de l’ouest pour trouver et vaincre le Seigneur du Chaudron qui s’y trouve, et utiliser sa clé pour accéder au chaudron. Il faut se munir de la Bouteille vide de la Flétrissure de Gahrron pour pouvoir récupérer un échantillon des poisons à l’intérieur du chaudron.‡到西瘟疫之地的盖罗恩农场去，找到并击败那里的护锅者，用它的钥匙打开瘟疫之锅。你必须随身携带盖罗恩农场的空瓶来采集瘟疫之锅中的毒药样本。‡到西瘟疫之地的蓋羅恩農場去，找到並擊敗那裡的護鍋領主，用它的鑰匙打開瘟疫之鍋。你必須隨身攜帶蓋羅恩農場的空瓶來採集瘟疫之鍋中的毒藥樣本。',
  }
},
[5236] = {
  {
    'Retorno a Baluarte‡Возвращение в Бастион‡Rückkehr zum Bollwerk‡보루로의 귀환‡El regreso a El Baluarte‡Regresa a El Baluarte‡Retour à la Barricade‡返回亡灵壁垒‡返回亡靈壁壘',
    nil,
    'Leve a Garrafa da Aridez de Garrão Cheia à Sacerdotisa Sombria Vandis em Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Отнесите полную бутылку с пустоши Гаррона жрице Тьмы Вандис в Бастион в Западных Чумных землях.‡Bringt die gefüllte Flasche: Gahrrons Trauerfeld zur Schattenpriesterin Vandis am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 어둠의여사제 반디스에게 가득 찬 가론의 흉가 혼합물을 가져가야 합니다.‡Lleva la botella llena de la Gangrena de Gahrron a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva la botella llena de la Gangrena de Gahrron a la sacerdotisa de las Sombras Vandis de El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter la Bouteille de la Flétrissure de Gahrron remplie à la prêtresse des ombres Vandis à la Barricade, dans les Maleterres de l’ouest.‡把盖罗恩农场的样本瓶交给西瘟疫之地亡灵壁垒的暗影牧师范蒂丝。‡把蓋羅恩農場的樣本瓶交給西瘟疫之地亡靈壁壘的暗影牧師范蒂絲。',
  }
},
[5237] = {
  {
    'Missão cumprida!‡Задание выполнено!‡Mission erfüllt!‡임무 완료!‡¡Misión cumplida!‡¡Misión cumplida!‡Mission accomplie !‡任务完成！‡任務完成!',
    nil,
    '<name>, sua reengenharia bem-sucedida dos caldeirões é uma tremenda vitória para nós!nnnnQue todos em minha presença possam ouvir: pelos serviços prestados ao Reino de Ventobravo e à Aliança além do mero cumprimento do dever — face a condições extremamente adversas e perigos indizíveis, devo acrescentar —, dou isto a <name>. Você tem nossa eterna gratidão como verdadeiro herói da Aliança. Parabéns!‡Успешная диверсия против всех котлов – огромная победа!nn*Командир откашливается и оглушительно орет.*nnСлушайте, слушайте все! За верную и преданную службу королевству Штормграда и Альянсу, за выполнение долга и даже более того – перед лицом невероятной опасности, отметим – я вручаю Лорегон награду и передаю ему нашу вечную благодарность. Он – истинный герой Альянса. Ура!‡<Name>, Eure erfolgreiche Umarbeitung der Kessel ist ein überwältigender Sieg für uns!nnnnAlle, die sich hier in meinem Umfeld befinden, mögen Folgendes hören: Für Dienste am Königreich Stormwind und der Allianz, die über die gebotenen Pflichten hinausgingen - trotz wenig Erfolg versprechender Chancen und im Angesicht unglaublicher Gefahren, möchte ich <Name> dies geben und ihn unserer unvergänglichen Dankbarkeit als wahren Helden der Allianz versichern. Danke, sage ich!‡‡<nombre>, your successful re-engineering of the cauldrons is a tremendous victory for us!nnnnLet all within my presence hear: for service to the Kingdom of Stormwind and to the Alliance above and beyond the call of duty - in the face of overwhelming odds and incredible danger, might I add - I give <nombre> this, and I extend upon her our undying gratitude as a true hero of the Alliance. Cheers, I say!‡‡<nom>, votre travail couronné de succès sur les chaudrons est une immense victoire pour nous !nnnnQue tout le monde le sache : pour services rendus au Royaume de Stormwind et à l\'Alliance et pour avoir fait bien plus que son devoir, face à un danger incroyable et contre tout espoir, je remets ceci à <nom> en même temps que je l\'assure de notre gratitude. Félicitations !‡‡',
  }
},
[5238] = {
  {
    'Missão cumprida!‡Задание выполнено!‡Mission erfüllt!‡임무 완료!‡¡Misión cumplida!‡¡Misión cumplida!‡Mission accomplie !‡任务完成！‡任務完成!',
    nil,
    '<name>, sua reengenharia bem-sucedida dos caldeirões é uma tremenda vitória para nós!nnnnQue todos em minha presença possam ouvir: pelos serviços prestados aos Renegados e à Horda além do mero cumprimento do dever — face a condições extremamente adversas e perigos indizíveis, devo acrescentar —, gostaria de dar isso a <name>. Você tem nossa eterna gratidão como verdadeiro herói da Horda. Viva!‡Успешная диверсия против всех котлов – огромная победа!nn*Верховный палач откашливается и оглушительно орет.*nnСлушайте, слушайте все! За верную и преданную службу Отрекшимся и Орде, за выполнение долга и даже более того – перед лицом невероятной опасности, отметим – я вручаю Томпсон награду и передаю ему нашу вечную благодарность. Он – истинный герой Орды. Ура!‡<Name>, Eure erfolgreiche Umarbeitung der Kessel ist ein überwältigender Sieg für uns!nnnnAlle, die sich hier in meinem Umfeld befinden, mögen Folgendes hören: Für Dienste an den Verlassenen und an der Horde, die weit über die erwarteten Pflichten hinausgingen - trotz wenig Erfolg versprechender Chancen und im Angesicht unglaublicher Gefahren, möchte ich <Name> dies geben und ihn unserer unvergänglichen Dankbarkeit als wahren Helden der Horde versichern. Hussah!‡자네가 가마솥 임무를 성공적으로 수행한 것은 우리에게 큰 수확이다.nn<목을 가다듬고는 큰 소리로 말하기 시작하는 고위집행관>nn이곳에 있는 모든 이들에게 고하노니, 압도적인 열세와 극한 위험 속에서도 기대했던 것 이상으로 포세이큰과 호드 모두에 충심으로 봉사한 라솔<class>에게 이 상을 수여하고, 이 호드의 진정한 이 영웅에게 우리의 영원한 감사의 뜻을 표하노라. 만세!‡¡<nombre>, tu éxito cambiando la estructura de las calderas es una enorme victoria para nosotros! nn nnQue todos los que están en mi presencia lo oigan: por los servicios prestados a los Renegados y a toda la Horda muy por encima de lo que era de esperar y, añado, por haber superado todos los pronósticos y un peligro inenarrable, concedo esto a <nombre>, y le hago llegar nuestra eterna gratitud como un auténtico héroe de la Horda. ¡Lancemos nuestros vítores!‡‡<nom>, votre travail couronné de succès sur les chaudrons est une immense victoire pour nous !nnnnQue tout le monde le sache : pour services rendus aux Réprouvés et à la Horde et pour avoir fait bien plus que son devoir, face à un danger incroyable et contre tout espoir, je remets ceci à <nom> en même temps que je l\'assure de notre gratitude. Félicitations !‡‡',
  }
},
[5241] = {
  {
    'Tio Carlin‡Дядюшка Карлин‡Onkel Carlin‡카를린 삼촌‡Tío Carlin‡Tío Carlin‡Oncle Carlin‡卡林叔叔‡卡林叔叔',
    nil,
    'Encontre Carlin Trilharrubra.‡Найдите Карлина Редпата.‡Sucht Carlin Rotpfad.‡카를린 레드패스를 찾아야 합니다.‡Encuentra a Carlin Rutagrana.‡Encuentra a Carlin Rutagrana.‡Trouver Carlin Senterouge.‡找到卡林·雷德帕斯。‡找到卡林·雷德帕斯。',
  }
},
[5242] = {
  {
    'O golpe final‡Окончательный удар‡Der endgültige Schlag‡마지막 일격‡El golpe final‡Un golpe final‡Un coup final‡最终一击‡最終一擊',
    nil,
    'Mate Moora e Salia, e leve a Cabeça do Lorde das Sombras Fel\'dan para Greta Musgo no Casco em Selva Maleva.‡Убейте Моору и Салию и принесите голову владыки теней Скверн\'дана Грете Замшелое Копыто в Оскверненный лес.‡Tötet Moora und Salia und bringt den Kopf von Schattenlord Fel\'dan zu Greta Mooshuf im Teufelswald.‡무라와 살리라, 그리고 어둠의 군주 펠단을 처치하십시오. 그리고 그 증거로 펠단의 머리카락을 악령의 숲에 있는 그레타 모스후프에게 가져가야 합니다.‡Mata a Moora y Salia y lleva la cabeza de Lord Fel\'dan de las Sombras a Greta Pezuñamusgo a Frondavil.‡Mata a Moora y Salia y lleva la cabeza de Señor de las Sombras Fel\'dan a Greta Pezuñamusgo a Frondavil.‡Tuer Moora et Salia, et rapporter la Tête du Seigneur des ténèbres Gangr\'dan à Greta Sabot-de-mousse dans Gangrebois.‡杀掉米莱恩和萨莉亚，并把暗影领主费尔丹的头颅交给费伍德森林的格雷塔·苔蹄。‡殺掉米萊恩和薩莉亞，並把暗影領主費爾丹的頭顱交給費伍德森林的格雷塔·苔蹄。',
  }
},
[5243] = {
  {
    'Casas do sagrado‡Святая вода‡Häuser der Heiligen‡성스러운 집‡Las casas de lo sagrado‡Las casas de lo sagrado‡Les demeures du Sacré‡神圣之屋‡神聖之屋',
    nil,
    'Viaje para Stratholme, ao norte. Procure os caixotes de suprimentos que cobrem a cidade e recupere 5 Águas Bentas de Stratholme. Fale novamente com Leonid Bartolomeu, o Venerado, quando coletar fluido abençoado suficiente.‡Отправляйтесь на север, в Стратхольм. Обыщите брошенные ящики с припасами и соберите 5 мер святой воды Стратхольма. Возвращайтесь к Леониду Бартоломею Чтимому, как только воды будет достаточно.‡Begebt Euch nach Stratholme im Norden. Durchsucht die Vorratskisten, die über die Stadt verstreut sind, und holt 5 Einheiten Weihwasser von Stratholme. Kehrt zu Leonidas Bartholomäus dem Geachteten zurück, wenn Ihr genug der gesegneten Flüssigkeit gesammelt habt.‡북쪽에 있는 스트라솔름으로 가서 도시 어딘가에 흩어진 보급품 상자를 찾아 스트라솔름 성수 5병을 가져와야 합니다. 성수를 충분히 모으고 나면 존경받는 리어니드 바돌로매에게 돌아가야 합니다.‡Viaja al norte, a Stratholme. Registra los cajones de provisiones que hay por toda la ciudad y recupera 5 de agua bendita de Stratholme. Vuelve junto a Leonid Barthalomew el Venerado cuando hayas reunido suficiente líquido bendecido.‡Viaja al norte, a Stratholme. Registra los cajones de provisiones que hay por toda la ciudad y recupera 5 de agua bendita de Stratholme. Vuelve junto a Leonid Barthalomew el Venerado cuando hayas reunido suficiente líquido bendecido.‡Se rendre à Stratholme, au nord. Fouiller les caisses de fournitures qui encombrent la cité et récupérer 5 Eaux sacrées de Stratholme. Retourner auprès de Leonid Barthalomew le Révéré quand vous avez récolté assez de liquide béni.‡到北方的斯坦索姆去，寻找散落在城市中的补给箱，并收集5瓶斯坦索姆圣水。当你找到足够的圣水之后就回去向莱尼德·巴萨罗梅复命。‡到北方的斯坦索姆去，尋找散落在城市中的補給木箱，並收集5瓶斯坦索姆聖水。當你找到足夠的聖水之後就回去向可敬的萊尼德·巴薩羅梅覆命。',
  }
},
[5244] = {
  {
    'Ruínas de Kel\'Theril‡Руины Кел\'Терила‡Die Ruinen von Kel\'Theril‡켈테릴의 폐허‡Las Ruinas de Kel\'Theril‡Las Ruinas de Kel\'Theril‡Les ruines de Kel\'Theril‡凯斯利尔废墟‡凱斯利爾廢墟',
    nil,
    'Fale com Jaron Moldapedra na Aldeia Chuva Estelar.‡Поговорите с Джероном Гранильщиком в деревне Звездопада.‡Sprecht mit Jaron Steinschleifer in Sternfall.‡별똥별 마을에 있는 야론 스톤셰이퍼와 대화하십시오.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Habla con Jaron Tallapiedras en Aldea Estrella Fugaz.‡Parler à Jaron Sculptepierre au village de Pluie-d\'Étoiles.‡与坠星村的加隆·石矛谈一谈。‡與墜星村的加隆·石矛談話。',
  }
},
[5245] = {
  {
    'Espíritos atormentados de Kel\'Theril‡Беспокойные духи Кел\'Терила‡Die gequälten Seelen von Kel\'Theril‡켈테릴의 고통받는 영혼‡Espíritus condenados de Kel\'Theril‡Espíritus condenados de Kel\'Theril‡Les Esprits troublés de Kel\'Theril‡凯斯利尔的怨灵‡凱斯利爾的怨靈',
    nil,
    'Use a Picareta do Jaron para encontrar os quatro Fragmentos da Relíquia dos Altaneiros. Leve-os para Aurora Clamacéus nas Terras Pestilentas Orientais.‡Используйте кирку Джерона, чтобы добыть фрагменты реликвии высокорожденных, Принесите их Авроре Зов Небес в Восточные Чумные земли.‡Benutzt Jarons Hacke, um die vier Fragmente des Hochgeborenenrelikts zu suchen. Bringt sie zu Aurora Himmelsrufer in den östlichen Pestländern.‡야론의 곡괭이를 사용해 귀족 유물 조각 4개를 찾아 동부 역병지대에 있는 아우로라 스카이콜러에 갖다주어야 합니다.‡Utiliza el pico de Jaron para encontrar los cuatro trozos de reliquia de los Altonato. Llévaselas a Aurora Llamacielo en las Tierras de la Peste del Este.‡Utiliza el pico de Gormir para encontrar los cuatro trozos de reliquia de los Altonato.‡Utiliser la Pique de Jaron pour trouver les quatre Fragments de relique des Bien-nés. Les apporter à Aurora Skycaller dans les Maleterres de l’est.‡使用加隆的镐来寻找四块上层精灵遗物的碎片，把它们交给东瘟疫之地的奥萝拉。‡使用加隆的鎬來尋找四塊精靈貴族聖物的碎片，把它們交給東瘟疫之地的奧蘿拉。',
  }
},
[5246] = {
  {
    'Fragmentos do passado‡Фрагменты прошлого‡Fragmente der Vergangenheit‡과거의 조각들‡Trozos del pasado‡Trozos del pasado‡Fragments du passé‡历史的残片‡歷史的殘片',
    nil,
    'Encontre os Escritos Sagrados dos Altaneiros no Templo de Zin-Malor, em Azshara, e leve-os para Aurora Clamacéus, perto da Torre do Passo Norte nas Terras Pestilentas Orientais.‡Найдите Священные письмена высокорожденных в Храме Зин-Малор, в Азшаре и принесите их Авроре Зов Небес к Башне Северного перевалa, в Восточных Чумных землях.‡Sucht die hochheiligen Schriften der Hochgeborenen im Tempel von Zin-Malor in Azshara und bringt sie zu Aurora Himmelsrufer beim Nordpassturm in den östlichen Pestländern.‡아즈샤라에 있는 진말로의 신전에서 귀족의 성서를 찾아야 합니다. 동부 역병지대의 북부관문 경비탑 근처에 있는 아우로라 스카이콜러에게 가져가십시오.‡Encuentra las escrituras altonatas sagradas del templo de Zin-Malor en Azshara y tráelas para Aurora Llamacielo, en la Torre del Paso Norte en las Tierras de la Peste del Este.‡Encuentra las Sagradas escrituras de los Altonato del Templo de Zin-Malor en Azshara y tráelas para Aurora Clamacielos en la Torre del Paso Norte en las Tierras de la Peste del Este.‡Trouver les Écrits sacrés des Bien-nés dans le temple de Zin-Malor en Azshara et les apporter à Aurora Mandeciel à la tour du Col du nord, dans les Maleterres de l\'est.‡在艾萨拉的辛玛洛神殿里找到神圣的上层精灵笔迹，并将它带给位于东瘟疫之地的北地哨塔附近的奥萝拉。‡在艾薩拉的辛瑪洛神殿裡，找到神聖的精靈貴族筆跡。然後交給奧蘿拉，她就靠近東瘟疫之地的北地哨塔。',
  }
},
[5247] = {
  {
    'Fragmentos do passado‡Фрагменты прошлого‡Fragmente der Vergangenheit‡과거의 조각‡Trozos del pasado‡Trozos del pasado‡Fragments du passé‡历史的残片‡歷史的殘片',
    nil,
    'Leve uma Barra de Tório Encantado, 5 Restaurações de Cristal e uma Ampola de Água Hedionda para Aurora Clamacéus perto da Torre do Passo Norte nas Terras Pestilentas Orientais.‡Принесите зачарованный слиток тория, 5 кристаллов восстановления и фиал пугающей воды Авроре Зов Небес к башне Северного Перевала, в Восточных Чумных землях.‡Bringt einen verzauberten Thoriumbarren, 5 Kristallflicker und eine Phiole mit Düsterwasser zu Aurora Himmelsrufer beim Nordpassturm in den östlichen Pestländern.‡마력 깃든 토륨 주괴 1개와 회복의 수정 5개, 그리고 혈투의 웅덩이 물병을 동부 역병지대의 북부관문 경비탑 근처에 있는 아우로라 스카이콜러에게 가져가야 합니다.‡Consigue una barra encantada de torio, 5 cristales de restauración y un vial de agua funesta para Aurora Llamacielo, en la Torre del Paso Norte, en las Tierras de la Peste del Este.‡Consigue una barra de torio encantado, 5 cristales de restauración y un vial de agua funesta para Aurora Clamacielos en la Torre del Paso Norte, en las Tierras de la Peste del Este.‡Apporter une Barre de thorium enchanté, 5 Cristaux de restauration et une Fiole d\'eau redoutable à Aurora Mandeciel à la tour du Col du nord, dans les Maleterres de l\'est.‡给东瘟疫之地的奥萝拉带去一块魔化瑟银锭、5块恢复水晶，以及一小瓶恐怖之水。‡給接近東瘟疫之地的奧蘿拉帶1塊附魔瑟銀錠、5塊恢復水晶，以及1小瓶恐怖之水。',
  }
},
[5248] = {
  {
    'Atormentada pelo passado‡Измученный воспоминаниями о прошлом‡Gequält von der Vergangenheit‡인과응보‡Atormentados por el pasado‡Atormentados por el pasado‡Tourmentée par le passé‡记忆的折磨‡記憶的折磨',
    nil,
    'Leve o Cristal de Zin-Malor ao Lago Kel\'Theril, em Hibérnia, e encontre o espírito de um altaneiro que fale com você.‡Отнесите кристалл Зин-Малора к озеру Кел\'Терил в Зимних Ключах и найдите духа высокорожденного, который согласится с вами поговорить.‡Bringt den Kristall von Zin-Malor zum Kel\'Therilsee in Winterquell und sucht einen Geist eines Hochgeborenen, der mit Euch sprechen will.‡진말로의 수정을 여명의 설원에 있는 켈테릴 호수로 갖고 가서 당신과 대화를 하고자 하는 명가의 영혼을 찾아야 합니다.‡Lleva el Cristal de Zin-Malor a Lago Kel\'Theril en Cuna del Invierno y encuentra un espíritu Altonato que hable contigo.‡Lleva el Cristal de Zin-Malor a Lago Kel\'Theril en Cuna del Invierno y encuentra un espíritu Altonato que hable contigo.‡Amener le Cristal de Zin-Malor au lac Kel\'Theril dans le Berceau-de-l\'Hiver et trouver un esprit Bien-né qui veuille bien vous parler.‡把辛玛洛水晶带回冬泉谷的凯斯利尔湖，在那里寻找一个会与你讲话的上层精灵。‡把辛瑪洛水晶帶回冬泉谷的凱斯利爾湖，在那裡尋找一個會與你講話的精靈貴族。',
  }
},
[5249] = {
  {
    'Rumo a Hibérnia!‡В Зимние Ключи!‡Nach Winterquell!‡여명의 설원으로!‡¡A la Cuna del Invierno!‡¡A la Cuna del Invierno!‡Au Berceau-de-l\'Hiver‡前往冬泉谷！‡前往冬泉谷!',
    nil,
    'Encontre a Aldeia Chuva Estelar, em Hibérnia, e fale com Eol Correnoite.‡Найдите в Зимних Ключах деревню Звездопада и поговорите там с Вундом Ночным Охотником.‡Sucht Sternfall in Winterquell und sprecht mit Wynd Nachtjagd.‡여명의 설원에 있는 별똥별 마을에서 윈드 나이트체이서와 대화하십시오.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Trouver le village de Pluie-d\'Étoiles au Berceau-de-l\'Hiver, et parler à Wynd Pistenuit.‡找到冬泉谷的坠星村，在那里与维恩德·夜风谈一谈。‡找到冬泉谷的墜星村，在那裡與威恩德·夜風談話。',
  }
},
[5250] = {
  {
    'Chuva Estelar‡Звездопад‡Sternfall‡별똥별 마을‡Estrella Fugaz‡Estrella Fugaz‡Pluie-d\'Étoiles‡坠星村‡墜星村',
    nil,
    'Encontre a Chuva Estelar, em Hibérnia, e fale com Eol Correnoite.‡Найдите в Зимних Ключах деревню Звездопада и поговорите там с Вундом Ночным Охотником.‡Sucht die Siedlung Sternfall in Winterquell und sprecht mit Wynd Nachtjagd.‡여명의 설원에서 별똥별 마을을 찾아 윈드 나이트체이서와 대화해야 합니다.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Encuentra la Aldea Estrella Fugaz en Cuna del Invierno y habla con Wynd Cazanoche.‡Trouver le village de Pluie-d\'Étoiles au Berceau-de-l\'Hiver et parler à Wynd Pistenuit.‡找到冬泉谷的坠星村，在那里与维恩德·夜风谈一谈。‡找到冬泉谷的墜星村，在那裡與威恩德·夜風談話。',
  }
},
[5251] = {
  {
    'O arquivista‡Архивариус‡Der Archivar‡기록관‡El archivista‡El archivista‡L\'archiviste‡档案管理员‡文獻管理員',
    nil,
    'Viaje até Stratholme e encontre o Arquivista Galford da Cruzada Escarlate. Destrua-o e queime o Arquivo Escarlate.‡Отправляйтесь в Стратхольм и отыщите архивариуса Галфорда из Алого ордена. Убейте его и сожгите архив Алого ордена.‡Reist nach Stratholme und sucht Archivar Galford vom Scharlachroten Kreuzzug. Vernichtet ihn und verbrennt das Scharlachrote Archiv.‡스트라솔름으로 가서 붉은십자군의 기록관, 갈포드를 찾아서 그를 처치하고 붉은십자군 기록을 불태워 버려야 합니다.‡Viaja a Stratholme y encuentra al archivista Galford de La Cruzada Escarlata. Acaba con él y quema el Archivo Escarlata.‡Viaja a Stratholme y encuentra al archivista Galford de La Cruzada Escarlata. Acaba con él y quema el Archivo Escarlata.‡Voyager jusqu\'à Stratholme et trouver l\'Archiviste Galford de la Croisade écarlate. L\'abattre et brûler les Archives écarlates.‡在斯坦索姆城中找到血色十字军的档案管理员加尔福特，杀掉他，然后烧毁血色十字军档案。‡在斯坦索姆城中找到血色十字軍的文件管理員加爾福特，殺掉他，然後燒毀血色十字軍文獻。',
  }
},
[5252] = {
  {
    'Altaneira arrependida‡Раскаявшийся высокорожденный‡Reuevolle Hochgeborene‡한 맺힌 명가의 원혼‡Altonato arrepentido‡Altonato arrepentido‡Une Bien-née pleine de remords‡悔恨的上层精灵‡悔恨的精靈貴族',
    nil,
    'Fale com Eol Correnoite na Aldeia Chuva Estelar e pergunte qual é o lugar mais apropriado para o Cristal de Zin-Malor.‡Поговорите с Вундом Ночным Охотником в деревне Звездопада и узнайте у него, куда нужно поместить кристалл Зин-Малора.‡Sprecht mit Wynd Nachtjagd in Sternfall und fragt nach dem richtigen Ort für den Kristall von Zin-Malor.‡별똥별 마을에 있는 윈드 나이트체이서와 대화해 진말로의 수정을 어디에 두어야 하는지 물어보십시오.‡Habla con Wynd Cazanoche en Aldea Estrella Fugaz y pregúntale por el lugar adecuado para el Cristal de Zin-Malor.‡Habla con Wynd Cazanoche en Aldea Estrella Fugaz y pregúntale por el lugar adecuado para el Cristal de Zin-Malor.‡Parler à Wynd Pistenuit au village de Pluie-d\'Étoiles et lui demander quel est le bon endroit pour le Cristal de Zin-Malor.‡和坠星村的维恩德-夜风谈一谈，了解到辛玛洛水晶所在的位置。‡和墜星村的威恩德·夜風談一談，瞭解到辛瑪洛水晶所在的位置。',
  }
},
[5253] = {
  {
    'O cristal de Zin-Malor‡Кристалл Зин-Малора‡Der Kristall von Zin-Malor‡진말로의 수정‡El cristal de Zin-Malor‡El cristal de Zin-Malor‡Le Cristal de Zin-Malor‡辛玛洛水晶‡辛瑪洛水晶',
    nil,
    'Leve o Cristal de Zin-Malor para o Arquidruida Fandral Guenelmo em Darnassus.‡Доставьте Кристалл Зин-Малора верховному друиду Фэндралу Оленьему Шлему в Дарнасс.‡Überbringt dem Erzdruiden Fandral Hirschhaupt in Darnassus den Kristall von Zin-Malor.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 진말로의 수정을 갖다주어야 합니다.‡Entrega el Cristal de Zin-Malor al archidruida Fandral Corzocelada de Darnassus.‡Entrega el Cristal de Zin-Malor al archidruida Fandral Corzocelada de Darnassus.‡Apporter le Cristal de Zin-Malor à l\'archidruide Fandral Forteramure à Darnassus.‡将辛玛洛水晶送到达纳苏斯的大德鲁伊范达尔-鹿盔那里。‡將辛瑪洛水晶送到達納蘇斯的大德魯伊范達爾·鹿盔那裡。',
  }
},
[5261] = {
  {
    'Enzo Peleteiro‡Иган Меховщик‡Eagan Pelzschneider‡이건 펠트스키너‡Eagan Desollapelambres‡Eagan Desollapelambres‡Eagan Tannepeau‡伊根·派特斯金纳‡伊根·派特斯金納',
    nil,
    'Fale com Enzo Peleteiro.‡Поговорите с Иганом Меховщиком.‡Sprecht mit Eagan Pelzschneider.‡이건 펠트스키너와 얘기해야 합니다.‡Habla con Eagan Desollapelambres.‡Habla con Eagan Desollapelambres.‡Parler à Eagan Tannepeau.‡与伊根·派特斯金纳谈一谈。‡與伊根·派特斯金納談話。',
  }
},
[5262] = {
  {
    'A verdade desaba sobre todos‡Ошеломляющая истина‡Die Wahrheit zeigt sich mit Macht‡밝혀지는 진실‡La verdad cae del cielo‡La verdad cae del cielo‡La vérité vient du ciel‡可怕的真相‡可怕的真相',
    nil,
    'Leve a Cabeça do Balnazzar para o Duque Nicolau Zverenhoff nas Terras Pestilentas Orientais.‡Отнесите голову Балназзара герцогу Николасу Зверенхоффу в Восточные Чумные земли.‡Bringt den Kopf von Balnazzar zu Fürst Nicholas Zverenhoff in den östlichen Pestländern.‡동부 역병지대에 있는 공작 니콜라스 즈바른호프에게 발나자르의 혼을 가져가야 합니다.‡Lleva la cabeza de Balnazzar al Duque Nicolas Zverenhoff en las Tierras de la Peste del Este.‡Lleva la cabeza de Balnazzar al duque Nicolas Zverenhoff en las Tierras de la Peste del Este.‡Apporter la Tête de Balnazzar au duc Nicholas Zverenhoff dans les Maleterres de l\'est.‡将巴纳扎尔的头颅交给东瘟疫之地的尼古拉斯·瑟伦霍夫公爵。‡將巴納札爾的頭顱交給東瘟疫之地的尼古拉斯·瑟倫霍夫公爵。',
  }
},
[5263] = {
  {
    'Acima e além‡Быстрее, выше, сильнее‡Übertroffen‡뛰어난 존재‡Por encima y más allá‡Por encima y más allá‡Au-dessus et au-delà‡超越‡超越',
    nil,
    'Desbrave Stratholme e destrua o Barão Rivendare. Corte sua cabeça e leve-a de volta para o Duque Nicolau Zverenhoff.‡Отправляйтесь в Стратхольм и убейте барона Ривендера. Принесите его голову герцогу Николасу Зверенхоффу.‡Zieht nach Stratholme und vernichtet Baron Totenschwur. Nehmt seinen Kopf und kehrt zu Fürst Nicholas Zverenhoff zurück.‡스트라솔름으로 가서 남작 리븐데어를 처치하고 그의 혼을 공작 니콜라스 즈바른호프에게 가져가야 합니다.‡Viaja a Stratholme y acaba con el barón Osahendido. Coge su cabeza y vuelve con el duque Nicolas Zverenhoff.|n‡Viaja a Stratholme y acaba con el barón Osahendido. Coge su cabeza y vuelve con el duque Nicolas Zverenhoff.‡S’aventurer dans Stratholme et tuer le baron Rivendare. Prendre sa tête et retourner auprès du duc Nicholas Zverenhoff.‡到斯坦索姆去杀掉瑞文戴尔男爵，把他的头颅交给尼古拉斯·瑟伦霍夫公爵。‡到斯坦索姆去殺掉瑞文戴爾男爵，把他的頭顱交給尼古拉斯·瑟倫霍夫公爵。',
  }
},
[5264] = {
  {
    'Lorde Maximiliano Tyrosus‡Лорд Максвелл Тиросс‡Lord Maxwell Tyrosus‡맥스웰 티로서스 경‡Lord Maxwell Neófitus‡Lord Maxwell Neófitus‡Seigneur Maxwell Tyrosus‡玛克斯韦尔·泰罗索斯男爵‡麥克斯韋爾·泰羅索斯領主',
    nil,
    'Fale com o Lorde Maximiliano Tyrosus. Ele está dentro da igreja.‡Поговорите с лордом Максвеллом Тироссом. Вы найдете его внутри храма.‡Sprecht mit Lord Maxwell Tyrosus. Er befindet sich in der Kirche.‡교회 안에 있는 맥스웰 티로서스 경과 대화해야 합니다.‡Habla con Lord Maxwell Neófitus. Está en el interior de la iglesia.‡Habla con Lord Maxwell Neófitus. Está en el interior de la iglesia.‡Parler au seigneur Maxwell Tyrosus. Il est à l\'intérieur de l\'église.‡和玛克斯韦尔·泰罗索斯男爵谈一谈。他就在教堂里面。‡和麥克斯韋爾·泰羅索斯領主談一談。他就在教堂裡面。',
  }
},
[5265] = {
  {
    'O Castelo Violeta‡Серебряный Оплот‡Der Argentumtresor‡여명회의 궤‡El Bastión Argenta‡El Bastión Argenta‡Le Coffre d\'argent‡银色黎明宝箱‡銀色黎明寶箱',
    nil,
    'Abra o Castelo Violeta e reivindique sua recompensa.‡Откройте Серебряный Оплот и получите награду.‡Öffnet den Argentumtresor und nehmt Euch Eure Belohnung.‡여명회의 궤를 열고 보상을 받아야 합니다.‡Abre el Bastión Argenta y reclama tu recompensa.‡Abre el Bastión Argenta y reclama tu recompensa.‡Ouvrez le Coffre d\'argent et prenez votre récompense.‡打开银色黎明宝箱，拿取你应得的奖励。‡打開銀色黎明寶箱，拿取你應得的獎勵。',
  }
},
[5281] = {
  {
    'As almas inquietas‡Мятущиеся души‡Die ruhelosen Seelen‡잠 못 드는 영혼‡Espíritus inquietos‡Espíritus inquietos‡Âmes tourmentées‡永不安息的灵魂‡永不安息的靈魂',
    nil,
    'Encontre Egan. Ele foi visto pela última vez nos arredores de Stratholme.‡Найдите Эгана. В последний раз его видели недалеко от Стратхольма.‡Sucht Egan. Ihr wisst nur, dass er zuletzt in der Nähe von Stratholme gesehen wurde.‡스트라솔름 주변에서 목격된다고 알려진 에간을 찾아야 합니다.‡Encuentra a Egan. Solo sabes que fue visto por última vez en los alrededores de Stratholme.‡Encuentra a Egan. Solo sabes que fue visto por última vez en los alrededores de Stratholme.‡Trouver Egan. Vous savez seulement qu\'on l\'a vu pour la dernière fois aux alentours de Stratholme.‡找到埃根。你只知道他在斯坦索姆附近。‡找到伊根。你只知道他在斯坦索姆附近。',
  }
},
[5282] = {
  {
    'As almas inquietas‡Мятущиеся души‡Die ruhelosen Seelen‡잠 못 드는 영혼‡Espíritus inquietos‡Espíritus inquietos‡Âmes tourmentées‡永不安息的灵魂‡永不安息的靈魂',
    nil,
    'Use o Canhão de Ectoplasma do Egan nos moradores fantasmagóricos e espectrais de Stratholme. Depois de livrá-los da forma de fantasma, use o canhão de novo e BLAU: liberdade!nnLiberte 15 Almas Inquietas, depois fale novamente com Egan.‡Стреляйте в фантомных и призрачных горожан на улицах Стратхольма из излучателя Эгана. Когда душа вырвется из призрачной оболочки, выстрелите в нее еще раз, и она обретет свободу.nnОсвободите 15 неупокоенных душ и возвращайтесь к Эгану.‡Wendet Egans Blaster auf die geisterhaften und spektralen Bürger von Stratholme an. Wenn die ruhelosen Geister ihre geisterhaften Hüllen sprengen, wendet den Blaster erneut an - dann sind sie endlich frei!nnBefreit 15 ruhelose Seelen und kehrt zu Egan zurück.‡스트라솔름 시민의 영혼과 원혼들에게 에간의 제령포를 사용해야 합니다. 원혼들이 그들을 가두고 있던 감옥에서 풀려나면 다시 총을 사용하여 그들에게 자유를 선사하십시오!nn15명의 잠 못드는 영혼을 자유롭게 하고 에간에게 돌아가야 합니다.‡Utiliza el libertador de Egan en los ciudadanos espectrales y fantasmas de Stratholme. Cuando las almas se liberen de sus recipientes fantasmales, vuelve a usarlo y lograrás liberarlos para siempre.nnLibera 15 almas y regresa a Egan.‡Utiliza el libertador de Egan en los ciudadanos espectrales y fantasmas de Stratholme. Cuando las almas se liberen de sus recipientes fantasmales, vuelve a usarlo y lograrás liberarlos para siempre.|nLibera 15 almas y regresa a Egan.‡Se servir de la Pétoire d\'Egan sur les citoyens fantomatiques et spectraux de Stratholme. Quand les esprits sans repos se libèrent de leur enveloppes fantomatiques, utiliser de nouveau la Pétoire - ils seront enfin libres !nnLibérer 15 Esprits sans repos puis retourner auprès d\'Egan.‡对斯坦索姆城中的鬼魂使用埃根的冲击器。当那些永不安息的灵魂挣脱他们的外壳时，再次使用埃根的冲击器——他们就可以获得自由了！nn解放15个永不安息的灵魂，然后回到埃根那里去。‡對斯坦索姆的鬼魅居民和鬼靈居民使用伊根的衝擊器。當那些永不安息的靈魂掙脫他們的幽靈軀體時，再次使用伊根的衝擊器─他們就可以獲得自由了!|n解放15個永不安息的靈魂，然後回到伊根那裡去。',
  }
},
[5283] = {
  {
    'A arte de forjar armaduras‡Искусство школы Брони‡Die Kunst des Rüstungsschmiedes‡방어구제작자의 길‡El arte del forjador de armaduras‡El arte del forjador de armaduras‡L\'art de l\'armurier‡铸造护甲的艺术‡護甲鍛造師的藝術',
    nil,
    'Para virar Ferreir<o/a> de Armaduras, tu vai ter que forjar os seguintes itens e levá-los pro Grumnus: quatro Elmos Ornados de Mithril, duas Botas Ornadas de Mithril e um Peitoral Ornado de Mithril.‡Изготовьте и отдайте Грумнусу 4 изысканных мифриловых шлема, 2 пары изысканных мифриловых сапог и 1 изысканную мифриловую кирасу.‡Um Rüstungsschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Grumnus bringen: 4 verschnörkelte Mithrilhelme, 2 verschnörkelte Mithrilstiefel, 1 verschnörkelte Mithrilbrustplatte.‡방어구제작자가 되려면 화려한 미스릴 투구 4개, 화려한 미스릴 장화 2켤레, 화려한 미스릴 흉갑 1벌을 만들어 그룸누스에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Grumnus: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Grumnus: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Pour devenir un fabricant d\'armures, il faut fabriquer les éléments suivants et les rapporter à Grumnus : 4 Heaumes ornés en mithril, 2 Bottes ornées en mithril, 1 Cuirasse ornée en mithril.‡要想成为一名护甲铸造师的话，你必须将下列物品交给格鲁努斯：4顶精制秘银头盔、2双精制秘银战靴和1副精制秘银胸甲。‡要想成為一名護甲鑄造師的話，你必須將下列物品交給格魯努斯:4頂華麗秘銀頭盔、2雙華麗秘銀戰靴和1副華麗秘銀胸甲。',
  }
},
[5284] = {
  {
    'O caminho do armeiro‡Путь оружейника‡Der Weg des Waffenschmieds...‡무기제작자의 길‡El arte del forjador de armas‡El arte del forjador de armas‡La voie du Forgeron d\'armes‡武器铸造师之道‡武器鑄造師之道',
    nil,
    'Para te tornares Armeir<o/a>, tu terás que forjar os seguintes itens e trazer para o Ironus: 4 Espadas Largas de Lunaço, 4 Machados Sólidos de Ferro, 2 Machados Pesados de Mithril e 2 Grandes Maças Pretas.‡Сделайте и отдайте Железнусу 4 палаша из лунной стали, 4 массивных железных топора, 2 тяжелых мифриловых топора и 2 большие черные палицы.‡Um Waffenschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Ironus bringen: 4 Mondstahlbreitschwerter, 4 massive Eisenäxte, 2 schwere Mithriläxte und 2 große schwarze Streitkolben.‡무기제작자가 되려면 달의 강철 브로드소드 4자루, 큰 철제 도끼 4자루, 견고한 미스릴 도끼 2자루, 검은 대형 철퇴 2자루를 만들어 이로누스에게 가져가야 합니다.‡Para convertirte en <armero/armera> tienes que fabricar lo siguiente y llevárselo a Ironus: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.|n‡Para convertirte en <armero/armera> tienes que fabricar lo siguiente y llevárselo a Ironus: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.‡Pour devenir un Fabricant d\'armes, il faut fabriquer les éléments suivants et les rapporter à Ferronus : 4 Epées d\'acier lunaire, 4 Haches massives en fer, 2 Haches en mithril lourd, et 2 Grandes masses noires.‡要想成为一名武器铸造师的话，你必须将下列物品交给埃隆努斯·冷钢：4把月钢宽剑、4把巨型铁斧、2把秘银重斧和2把巨型黑色锤。‡要想成為一名武器鑄造師的話，你必須將下列物品交給埃隆努斯·冷鋼:4把月鋼寬劍、4把巨型鐵斧、2把秘銀重斧和2把巨型黑錘。',
  }
},
[5301] = {
  {
    'A arte de forjar armaduras‡Искусство школы Брони‡Die Kunst des Rüstungsschmiedes‡방어구제작자의 길‡El arte del forjador de armaduras‡El arte del forjador de armaduras‡L\'art de l\'armurier‡铸造护甲的艺术‡護甲鍛造師的藝術',
    nil,
    'Para virar Ferreir<o/a> de Armaduras, você vai ter que forjar os seguintes itens e levá-los para Okothos: quatro Elmos Ornados de Mithril, duas Botas Ornadas de Mithril e um Peitoral Ornado de Mithril.‡Чтобы присоединиться к школе брони, изготовьте и отдайте Окотосу 4 изысканных мифриловых шлема, 2 пары изысканных мифриловых сапог и 1 изысканную мифриловую кирасу.‡Um Rüstungsschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Okothos bringen: 4 verschnörkelte Mithrilhelme, 2 verschnörkelte Mithrilstiefel, 1 verschnörkelte Mithrilbrustplatte.‡방어구제작자가 되려면 화려한 미스릴 투구 4개, 화려한 미스릴 장화 2켤레, 화려한 미스릴 흉갑 1벌을 만들어 오코토스에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Para convertirte en <forjador/forjadora> de armaduras tienes que fabricar lo siguiente y llevárselo a Okothos: 4 yelmos de mitril ornamentado, 2 pares de botas de mitril ornamentado y 1 coraza de mitril ornamentado.‡Pour devenir un fabricant d\'armures, il faut fabriquer les éléments suivants puis les apporter à Okothos : 4 Heaumes ornés en mithril, 2 Bottes ornées en mithril, 1 Cuirasse ornée en mithril.‡要想成为一名护甲铸造师的话，你必须将下列物品交给奥克索斯：4顶精制秘银头盔、2双精制秘银战靴和1副精制秘银胸甲。‡要想成為一名護甲鍛造師的話，你必須將下列物品交給奧克索斯:4頂華麗秘銀頭盔、2雙華麗秘銀戰靴和1副華麗秘銀胸甲。',
  }
},
[5302] = {
  {
    'O caminho do armeiro‡Путь оружейника‡Der Weg des Waffenschmieds...‡무기제작자의 길‡El arte del forjador de armas‡El arte del forjador de armas‡La voie du Forgeron d\'armes‡武器铸造师之道‡武器鑄造師之道',
    nil,
    'Para se tornar <um Armeiro/uma Armeira>, você precisa fazer os seguintes itens e levá-los para Borgosh: 4 Espadas Largas de Lunaço, 4 Machados Sólidos de Ferro, 2 Machados Pesados de Mithril e 2 Grandes Maças Pretas.‡Изготовьте и отдайте Боргошу 4 палаша из лунной стали, 4 массивных железных топора, 2 тяжелых мифриловых топора и 2 больших черных палицы.‡Um Waffenschmied zu werden, müsst Ihr die folgenden Gegenstände herstellen und zu Borgosh bringen: 4 Mondstahlbreitschwerter, 4 massive Eisenäxte, 2 schwere Mithriläxte und 2 große schwarze Streitkolben.‡무기제작자가 되려면 달의 강철 브로드소드 4자루, 큰 철제 도끼 4자루, 견고한 미스릴 도끼 2자루, 검은 대형 철퇴 2자루를 만들어 보르고쉬에게 가져가야 합니다.‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.|n‡Para convertirte en <forjador/forjadora> de armas tienes que fabricar lo siguiente y llevárselo a Borgosh: 4 espadas anchas de acero lunar, 4 hachas de hierro macizo, 2 hachas de mitril pesado y 2 mazas negras grandes.‡Pour devenir un Fabricant d\'armes, vous devez fabriquer les éléments suivants et les rapporter à Borgosh : 4 Epées d\'acier lunaire, 4 Haches massives en fer, 2 Haches en mithril lourd, et 2 Grandes masses noires.‡要想成为一名武器铸造师的话，你必须将下列物品交给伯古什：4把月钢宽剑、4把巨型铁斧、2把秘银重斧和2把巨型黑色锤。‡要想成為一名武器鑄造師的話，你必須將下列物品交給伯古什:4把月鋼寬劍、4把巨型鐵斧、2把秘銀重斧和2把巨型黑錘。',
  }
},
[5305] = {
  {
    'Doce serenidade‡Секрет безмятежности‡Süße Beschaulichkeit‡진홍십자군 작업복‡Dulce serenidad‡Dulce serenidad‡Douce sérénité‡甜美的平静‡甜美的平靜',
    nil,
    'Vá para Stratholme e mate o Forjador de Martelos Carmesim. Recolha o Avental do Forjador de Martelos Carmesim e leve-o para Lilith.‡Отправляйтесь в Стратхольм и убейте молотобойца из Багрового легиона. Возьмите его фартук и возвращайтесь к Лилит.‡Begebt Euch nach Stratholme und tötet den purpurroten Hammerschmied. Nehmt die Schürze des purpurroten Hammerschmiedes und kehrt zu Lilith zurück.‡스트라솔름으로 가서 진홍십자군 대장장이를 처치하고 진홍십자군 대장장이의 작업복을 가지고 릴리스에게 돌아가야 합니다.‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.|n‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.‡Aller jusqu\'à Stratholme et tuer le Forgeur de marteaux cramoisi. Récupérer son Tablier et le rapporter à Lilith.‡到斯坦索姆去杀死红衣铸锤师。将红衣铸锤师的围裙交给莉莉丝。‡到斯坦索姆去殺死紅衣鑄錘師。將紅衣鑄錘師的圍裙交給莉莉絲。',
  }
},
[5306] = {
  {
    'A litofídia da caçadora sombria‡Змеекамень Пленяющей Духов‡Schlangenstein der Schattenjägerin‡어둠사냥꾼의 뱀돌‡Piedra culebra de la cazadora de las Sombras‡Piedra culebra de la cazadora de las Sombras‡Pierre du serpent de la chasseresse des ombres‡沃什加斯的蛇石‡沃許加斯的菊石',
    nil,
    'Vá para o Pico da Rocha Negra e mate a Caçadora Sombria Vosh\'gajin. Recolha a Litofídia de Vosh\'gajin e fale novamente com Kilram.‡Отправляйтесь на Пик Черной горы, убейте Темную охотницу Вос\'гаджин. Заберите у нее змеекамень и принесите Килраму.‡Begebt Euch zur Schwarzfelsspitze und erschlagt Schattenjägerin Vosh\'gajin. Holt Vosh\'gajins Schlangenstein und kehrt zu Kilram zurück.‡검은바위 첨탑으로 가서 어둠사냥꾼 보쉬가진을 처치하고 보쉬가진의 뱀돌을 킬램에게 갖다주어야 합니다.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra culebra de Vosh\'gajin y vuelve con Kilram.‡Viaja a la Cumbre de Roca Negra y mata a la cazadora de las Sombras Vosh\'gajin. Recupera la piedra culebra de Vosh\'gajin y vuelve con Kilram.‡Aller jusqu\'au Pic Rochenoire et abattre la Chasseresse des ombres Vosh\'gajin. Récupérer la Pierre du serpent de Vosh\'gajin et la rapporter à Kilram.‡到黑石塔去杀死暗影猎手沃什加斯，将沃什加斯的蛇石交给基尔拉姆。‡到黑石塔去殺死暗影獵手沃許加斯，將沃許加斯的菊石交給基爾拉姆。',
  }
},
[5307] = {
  {
    'Corrupção‡Порча‡Verderbnis‡부패의 검‡Corrupción‡Corrupción‡Corruption‡腐蚀‡腐蝕',
    nil,
    'Encontre o Cuteleiro da Guarda Negra em Stratholme e destrua-o. Recolha a Insígnia da Guarda Negra e fale novamente com Seril Flagelicida.‡Найдите в Стартхольме оружейника Черной Стражи и уничтожьте его. Возьмите его Знак Черной Стражи и принесите Сирилу Плетебою.‡Findet den Schwertschmied der schwarzen Wache in Stratholme und vernichtet ihn. Holt die Insignien der schwarzen Wache und kehrt zu Seril Geißelbann zurück.‡스트라솔름에서 검은호위대 검제작자를 찾아 그를 처치하고 검은호위대 휘장을 회수한 후, 세릴 스컬지베인에게 갖다주어야 합니다.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de la Guardia Negra y regresa con Seril Finiquiplaga.‡Encuentra al armero Guardia Negra en Stratholme y acaba con él. Recupera la Insignia de La Guardia Negra y regresa con Seril Finiquiplaga.‡Trouver le Fabricant d\'épées de la Garde noire à Stratholme et le tuer. Récupérer l\'Insigne de la Garde noire et retourner auprès de Seril Plaie-du-Fléau.‡在斯坦索姆找到黑衣守卫铸剑师，然后杀死他。将黑色卫士徽记交给亡灵杀手瑟里尔。‡在斯坦索姆找到黑衣守衛鑄劍師，然後殺死他。將黑色衛士徽記交給亡靈殺手瑟里爾。',
  }
},
[5321] = {
  {
    'A adormecida despertou‡Спящий пробудился‡Der Schläfer ist erwacht‡잠에서 깨어난 드루이드‡El despertar‡El despertar‡Le dormeur s\'est éveillé‡昏昏欲睡‡昏昏欲睡',
    nil,
    'Escolte Kerlonian Perenumbra até Liladris Luneflúvia no Entreposto de Maestra, situado no Vale Gris.‡Сопроводите Керлониана Вечный Сумрак к Лиладрис Лунной Реке на Заставу Мейстры в Ясеневом лесу.‡Begleitet Kerlonian Schattenspiel zu Liladris Mondbach in Maestras Posten im Eschental.‡케를로니안 에버셰이드를 잿빛 골짜기의 마에스트라 주둔지에 있는 릴라드리스 문리버에게 호위해 가야 합니다.‡Escolta a Kerlonian Semprumbrío hasta Liladris Rioluna en la Atalaya de Maestra de Vallefresno.‡Escolta a Kerlonian Semprumbrío hasta Liladris Rioluna en la Atalaya de Maestra de Vallefresno.‡Escorter Kerlonian Evershade jusqu’à Liladris Moonriver au Poste de Maestra à Ashenvale.‡护送克罗尼亚·恒影到灰谷迈斯特拉岗哨的利拉迪斯·月河那里去。‡護送克羅尼亞·恒影到梣谷邁斯特拉崗哨的利拉迪斯·月河那裡去。',
  }
},
[5341] = {
  {
    'A fortuna da família Barov‡Сокровище Баровых‡Das Familienvermögen der Barovs‡바로브 가의 유산‡La fortuna de la familia Barov‡La fortuna de la familia Barov‡Fortune de la famille Barov‡巴罗夫家族的宝藏‡巴羅夫家族的寶藏',
    nil,
    'Desbrave Scolomântia e recupere a fortuna da família Barov. A fortuna é composta por quatro escrituras: A Escritura de Castro das Flechas, A Escritura de Montalvo, A Escritura da Serraria Tarren e A Escritura de Costa Sul. Fale novamente com Alexei Barov quando tiver terminado a tarefa.‡Отправляйтесь в Некроситет и добудьте сокровище семьи Баровых. Оно состоит из четырех документов: на Каэр Дарроу, на Брилл, на Мельницу Таррен и на Южнобережье. После выполнения задания вернитесь к Алексию Барову.‡Begebt Euch zur Scholomance und holt das Familienvermögen der Barovs zurück. Dieses Vermögen besteht aus vier Besitzurkunden: Es sind die Besitzurkunde für Darrowehr, die Besitzurkunde für Brill, die Besitzurkunde für Tarrens Mühle und die Besitzurkunde für Süderstade. Kehrt zu Alexi Barov zurück, sobald die Aufgabe erledigt ist.‡스칼로맨스로 가서 바로브 가의 유산을 회수해야 합니다. 이 재산은 카엘 다로우 증서, 브릴 증서, 타렌 밀농장 증서, 사우스쇼어 증서의 4개 땅문서로 이루어져 있습니다. 임무를 완수한 후 알렉시 바로브에게 돌아가야 합니다.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Alexi Barov cuando hayas terminado esta tarea.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Alexi Barov cuando hayas terminado esta tarea.‡S\'aventurer jusqu\'à la Scholomance et récupérer la fortune de la famille Barov. Cette fortune se compose de quatre titres de propriété : le titre de propriété de Caer Darrow ; le titre de propriété de Brill ; le titre de propriété de Moulin-de-Tarren ; et le titre de propriété d\'Austrivage. Revenir auprès d\'Alexi Barov quand la tâche est accomplie.‡到通灵学院中去取得巴罗夫家族的宝藏。这份宝藏包括四份地契：凯尔达隆地契、布瑞尔地契、塔伦米尔地契，还有南海镇地契。完成任务之后就回到阿莱克斯·巴罗夫那儿去。‡到通靈學院中去取得巴羅夫家族的寶藏。這份寶藏包括四份地契:凱爾達隆地契、布瑞爾地契、塔倫米爾地契，還有南海鎮地契。完成任務之後就回到阿萊克斯·巴羅夫那兒去。',
  }
},
[5342] = {
  {
    'O último Barov‡Последний из Баровых‡Der letzte Barov‡최후의 상속자‡El último de los Barov‡El último de los Barov‡Le dernier Barov‡巴罗夫的继承人‡巴羅夫的繼承人',
    nil,
    'Vá para o Acampamento Ventogelante, no território da Aliança, e assassine Weldon Barov. Recolha a cabeça dele e fale novamente com Alexei Barov.nnEsteja avisad<o/a>: Weldon provavelmente estará muito bem protegido pela escória da Aliança.‡Отправляйтесь в лагерь Промозглого Ветра – на земли Альянса – и убейте Велдона Барова. Отнесите его голову Алексию Барову.nnСоблюдайте осторожность – скорее всего, Велдона охраняет мразь из Альянса.‡Begebt Euch zum Zugwindlager - Territorium der Allianz - und ermordet Weldon Barov. Nehmt seinen Kopf und kehrt zu Alexi Barov zurück.nnSeid gewarnt, Weldon wird wahrscheinlich gut von Abschaum der Allianz geschützt.‡얼라이언스 영토인 서리바람 야영지로 가서 웰던 바로브를 암살해야 합니다. 그 증거로 그의 머리카락을 가지고 알렉시 바로브에게 돌아가십시오.nn얼라이언스 쓰레기들이 웰던을 보호하고 있을 테니 조심해야 합니다.‡Viaja al Campamento del Orvallo, territorio de la Alianza, y asesina a Weldon Barov. Coge su cabeza y regresa con Alexi Barov.nnTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Alianza.‡Viaja al Campamento del Orvallo, territorio de la Alianza, y asesina a Weldon Barov. Coge su cabeza y regresa con Alexi Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Alianza.‡Voyagez jusqu\'au Camp du Noroît, dans le territoire de l\'Alliance, et assassinez Weldon Barov. Prenez sa tête et revenez auprès d\'Alexi Barov.nnAttention : Weldon sera probablement bien protégé par la racaille de l\'Alliance.‡到冰风岗——联盟的领地——去暗杀维尔顿-巴罗夫。把他的脑袋交给阿莱克斯-巴罗夫。nn要多加小心，联盟也许对维尔顿实施了严密的保护。‡到冰風營地─聯盟的領地─去暗殺維爾頓·巴羅夫。把他的腦袋交給阿萊克斯·巴羅夫。|n要多加小心，聯盟也許對維爾頓執行了嚴密的保護。',
  }
},
[5343] = {
  {
    'A fortuna da família Barov‡Сокровище Баровых‡Das Familienvermögen der Barovs‡바로브 가의 유산‡La fortuna de la familia Barov‡La fortuna de la familia Barov‡Fortune de la famille Barov‡巴罗夫家族的宝藏‡巴羅夫家族的寶藏',
    nil,
    'Desbrave Scolomântia e recupere a fortuna da família Barov. A fortuna é composta por quatro escrituras: A Escritura de Castro das Flechas, a Escritura de Montalvo, a Escritura da Serraria Tarren e a Escritura de Costa Sul. Fale novamente com Weldon Barov quando tiver terminado a tarefa.‡Отправляйтесь в Некроситет и добудьте сокровище семьи Баровых. Оно состоит из четырех документов: на Каэр Дарроу, на Брилл, на Мельницу Таррен и на Южнобережье. После выполнения задания вернитесь к Велдону Барову.‡Begebt Euch zur Scholomance und holt das Familienvermögen der Barovs zurück. Dieses Vermögen besteht aus vier Besitzurkunden: Es sind die Besitzurkunde für Darrowehr, die Besitzurkunde für Brill, die Besitzurkunde für Tarrens Mühle und die Besitzurkunde für Süderstade. Kehrt zu Weldon Barov zurück, sobald die Aufgabe erledigt ist.‡스칼로맨스로 가서 바로브 가의 유산을 회수해야 합니다. 이 유산은 카엘 다로우 증서, 브릴 증서, 타렌 밀농장 증서, 사우스쇼어 증서의 4개 땅문서로 이루어져 있습니다. 이 임무를 완수한 후 웰던 바로브에게 돌아가야 합니다.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Weldon Barov cuando hayas terminado esta tarea.‡Aventúrate a Scholomance y recupera la fortuna familiar de los Barov. La fortuna se compone de cuatro escrituras: Las escrituras de Castel Darrow, Las escrituras de Rémol, Las escrituras de Molino Tarren y Las escrituras de Costasur. Regresa con Weldon Barov cuando hayas terminado esta tarea.‡S\'aventurer jusqu\'à la Scholomance et récupérer la fortune de la famille Barov. Cette fortune se compose de quatre titres de propriété : le titre de propriété de Caer Darrow ; le titre de propriété de Brill ; le titre de propriété de Moulin-de-Tarren ; et le titre de propriété d\'Austrivage. Revenir auprès de Weldon Barov quand la tâche est accomplie.‡到通灵学院中去取得巴罗夫家族的宝藏。这份宝藏包括四份地契：凯尔达隆地契、布瑞尔地契、塔伦米尔地契，还有南海镇地契。完成任务之后就回到维尔顿·巴罗夫那儿去。‡到通靈學院中去取得巴羅夫家族的寶藏。這份寶藏包括四份地契:凱爾達隆地契、布瑞爾地契、塔倫米爾地契，還有南海鎮地契。完成任務之後就回到維爾頓·巴羅夫那兒去。',
  }
},
[5344] = {
  {
    'O último Barov‡Последний из Баровых‡Der letzte Barov‡최후의 바로브‡El último de los Barov‡El último de los Barov‡Le dernier Barov‡巴罗夫的继承人‡巴羅夫的繼承人',
    nil,
    'Vá para o Baluarte, no território da Horda, e assassine Alexei Barov. Recolha a cabeça dele e fale novamente com Weldon Barov.nnEsteja avisad<o/a>: Alexei provavelmente estará muito bem protegido pela escória da Horda.‡Отправляйтесь в Бастион – на земли Орды – и убейте Алексия Барова. Отнесите его голову Велдону Барову.nnСоблюдайте осторожность – скорее всего, Алексия охраняет ордынская мразь.‡Begebt Euch zum Bollwerk - Territorium der Horde - und ermordet Alexi Barov. Nehmt seinen Kopf und kehrt zu Weldon Barov zurück.nnSeid gewarnt, Alexi wird wahrscheinlich gut durch Abschaum der Horde geschützt.‡호드의 영토인 보루로 가서 알렉시 바로브를 암살하십시오. 그 증거로 그의 머리카락을 가지고 웰던 바로브에게 돌아가십시오.nn더러운 호드가 알렉시를 보호하고 있을 테니 조심해야 합니다.‡Viaja a El Baluarte, territorio de la Horda, y asesina a Alexi Barov. Coge su cabeza y regresa con Weldon Barov.nnTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Horda.‡Viaja a El Baluarte, territorio de la Horda, y asesina a Alexi Barov. Coge su cabeza y regresa con Weldon Barov.|nTen cuidado, Alexi seguramente estará muy protegido por la escoria de la Horda.‡Voyager jusqu’à la Barricade - territoire de la Horde - et assassiner Alexi Barov. Prendre sa tête et revenir auprès de Weldon Barov.nnAttention : Alexi sera probablement bien protégé par les vandales de la Horde.‡去亡灵壁垒——部落的领地——去暗杀阿莱克斯-巴罗夫。把他的脑袋交给维尔顿-巴罗夫。nn要小心，部落也许对阿莱克斯实施了严密的保护。‡去亡靈壁壘─部落的領地─去暗殺阿萊克斯·巴羅夫。把他的腦袋交給維爾頓·巴羅夫。|n要小心，部落也許對阿萊克斯執行了嚴密的保護。',
  }
},
[5361] = {
  {
    'Árvore genealógica‡Семейное древо‡Stammbaum‡형제애‡Árbol genealógico‡Árbol genealógico‡Arbre familial‡兄弟‡族譜',
    nil,
    'Leve o Relatório de Vigia do Rochedo Chifre Longo para Nataoka Chifre Longo no Entreposto do Espírito que Anda, situado em Desolação.‡Доставьте отчет дозорного утесов Долгорога Натаке Длинному Рогу на Заставу Скитающихся Духов в Пустоши.‡Bringt den Bericht von Klippenbehüter Langhorn zu Nataka Langhorn am Geistwandlerposten in Desolace.‡절벽파수꾼 롱혼의 보고서를 잊혀진 땅의 침묵의 초소에 있는 나타카 롱혼에게 가져가야 합니다.‡Entrégale el informe de Vigiarisco Cuernolargo a Nataka Cuernolargo que se encuentra en el Campamento del Espíritu Errante de Desolace.‡Entrégale el informe de Vigiarisco Cuerno Largo a Nataka Cuerno Largo que se encuentra en el Campamento del Espíritu Errante de Desolace.‡Apporter le Rapport du garde-falaise Longue-corne à Nataka Longue-corne au poste de Rôdeur-fantôme en Désolace.‡将峭壁卫兵图林·长角的报告交给凄凉之地幽灵岗哨的纳塔卡·长角。‡將峭壁衛兵圖林·長角的報告交給淒涼之地鬼旅崗哨的納塔卡·長角。',
  }
},
[5381] = {
  {
    'Mão da Iruxos‡Рука Ируксоса‡Hand von Iruxos‡이룩소스의 손‡La Mano de Iruxos‡La Mano de Iruxos‡La Main d\'Iruxos‡埃鲁索斯之手‡埃盧梭斯之手',
    nil,
    'Recolha a Caixa Demoníaca na Fortaleza Machado do Trovão e leve-a, junto com a Picareta do Diabo, para Taiga Crina Sábia na Aldeia Pescassombra.‡Добудьте в крепости Громового Топора демоническую шкатулку, а затем принесите ее и кирку демонов Тайге Мудрой Гриве в деревню Ночных Охотников.‡Holt den Dämonenkasten aus der Festung Donneraxt und kehrt damit zu Taiga Klugmähne nach Schattenflucht zurück.‡천둥도끼 요새에서 악마의 상자를 찾아서 그늘수렵 마을에 있는 타이가 와이즈메인에게 가져가십시오. 악마의 곡괭이도 함께 돌려줘야 합니다.‡Extrae la caja de demonio de la Fortaleza del Hacha de Trueno y llévasela a Taiga Melenasabia a la Aldea Cazasombras junto con el pico de demonio.|n‡Extrae la caja de demonio de la Fortaleza del Hacha de Trueno y llévasela a Taiga Crin Sabia a la Aldea Cazasombras junto con el pico de demonio.‡Récupérer la Boîte démoniaque dans la forteresse de Hache-Tonnerre, puis la rapporter à Taiga Crin-sage, à Proie-de-l\'Ombre.‡在雷斧堡垒中找到恶魔之盒，把它和恶魔之锄一起交给葬影村的泰迦·慧鬃。‡在雷斧堡壘中找到惡魔之盒，把它和惡魔之鋤一起交給葬影村的泰迦·慧鬃。',
  }
},
[5382] = {
  {
    'Doutor Theolen Krastinov, o Carniceiro‡Доктор Теолен Крастинов – Мясник‡Doktor Theolen Krastinov, der Schlächter‡도살자, 테올렌 크라스티노브‡Doctor Theolen Krastinov, el Carnicero‡Doctor Theolen Krastinov, el Carnicero‡Docteur Theolen Krastinov, le boucher‡瑟尔林·卡斯迪诺夫教授‡『屠夫』瑟爾林·卡斯迪諾夫教授',
    nil,
    'Encontre o Doutor Theolen Krastinov em Scolomântia. Destrua-o, depois queime os Restos Mortais de Eva Sarkhoff e os Restos Mortais de Lucien Sarkhoff. Fale novamente com Eva Sarkhoff depois que tiver terminado a tarefa.‡Найдите в Некроситете доктора Теолена Крастинова. Убейте его, затем сожгите останки Евы и Люсьена Саркофф. Выполнив задание, возвращайтесь к Еве Саркофф.‡Sucht Doktor Theolen Krastinov in der Scholomance. Vernichtet ihn, verbrennt dann die Überreste von Eva Sarkhoff und die Überreste von Lucien Sarkhoff. Kehrt zu Eva Sarkhoff zurück, sobald Ihr die Aufgabe erfüllt habt.‡스칼로맨스 내에서 학자 테올렌 크라스티노브를 찾아 처치한 후 에바 사크호프의 유해와 루시엔 사크호프의 유해를 불태우십시오. 임무를 완수하면 에바 사크호프에게 돌아가야 합니다.‡Busca al doctor Theolen Krastinov en el interior de Scholomance. Acaba con él y quema los restos de Eva Sarkhoff y los restos de Lucien Sarkhoff. Cuando hayas terminado tu tarea regresa con Eva Sarkhoff.|n‡Busca al doctor Theolen Krastinov en el interior de Scholomance. Acaba con él y quema los restos de Eva Sarkhoff y los restos de Lucien Sarkhoff. Cuando hayas terminado tu tarea regresa con Eva Sarkhoff.‡Trouver le docteur Theolen Krastinov à l\'intérieur de la Scholomance. Le tuer, puis brûler le Cadavre d\'Eva Sarkhoff et le Cadavre de Lucien Sarkhoff. Retourner auprès d\'Eva Sarkhoff quand la tâche est accomplie.‡在通灵学院中找到瑟尔林·卡斯迪诺夫教授。杀死他，并烧毁艾瓦·萨克霍夫和卢森·萨克霍夫的遗体。任务完成后就回到艾瓦·萨克霍夫那儿。‡在通靈學院中找到瑟爾林·卡斯迪諾夫教授。殺死他，並燒毀艾瓦·薩克霍夫和盧森·薩克霍夫的遺體。任務完成後就回到艾瓦·薩克霍夫那兒。',
  }
},
[5383] = {
  {
    'Saco de Horrores de Krastinov‡Мешок ужасов Крастинова‡Krastinovs Tasche der Schrecken‡소름끼치는 크라스티노브의 가방‡Bolsa de los horrores de Krastinov‡‡Sac des horreurs de Krastinov‡卡斯迪诺夫的恐惧之袋‡卡斯迪諾夫的恐懼之袋',
    nil,
    'Leve o Saco de Horrores para Eva Sarkhoff, em Castro das Flechas.‡Отнесите мешок ужасов Еве Саркофф в Каэр Дарроу.‡Bringt die Tasche der Schrecken zu Eva Sarkhoff in Darrowehr.‡카엘 다로우에 있는 에바 사크호프에게 소름끼치는 크라스티노브의 가방을 가져가야 합니다.‡Lleva la Bolsa de los horrores a Eva Sarkhoff en Castel Darrow.‡Lleva la Bolsa de los horrores a Eva Sarkhoff en Castel Darrow.‡Apporter le Sac des horreurs à Eva Sarkhoff à Caer Darrow.‡将恐惧之袋交给凯尔达隆的艾瓦·萨克霍夫。‡將恐懼之袋交給凱爾達隆的艾瓦·薩克霍夫。',
  }
},
[5384] = {
  {
    'Kirtonos, o Arauto‡Киртонос Глашатай‡Kirtonos der Herold‡사자 키르토노스‡Kirtonos el Heraldo‡Kirtonos el Heraldo‡Kirtonos le héraut‡传令官基尔图诺斯‡傳令官基爾圖諾斯',
    nil,
    'Volte a Scolomântia com o Sangue dos Inocentes em mãos. Encontre a varanda e derrame o Sangue dos Inocentes no braseiro. Kirtonos virá na intenção de devorar sua alma.nnLute com bravura, não dê nenhuma brecha! Destrua Kirtonos e fale novamente com Eva Sarkhoff.‡Вернитесь в Некроситет с кровью невинных. Найдите балкон и вылейте кровь в жаровню. На зов явится Киртонос.nnСражайтесь как герой, не сдавайтесь! Уничтожьте Киртоноса и возвращайтесь к Еве Саркофф.‡Kehrt mit dem Blut Unschuldiger zur Scholomance zurück. Sucht die Veranda und legt das Blut der Unschuldigen in die Kohlenpfanne. Kirtonos wird kommen, um sich von Eurer Seele zu nähren.nnKämpft tapfer, gebt keinen Fußbreit nach! Vernichtet Kirtonos und kehrt zu Eva Sarkhoff zurück.‡순결한 피를 가지고 스칼로맨스로 돌아가야 합니다. 사자의 창을 찾아 사자의 화롯불에 순결한 피를 올려놓으면 키르토노스가 영혼을 차지하기 위해 나타납니다.nn용맹하게 싸우고 단 한 발짝도 물러서지 마십시오! 키르토노스를 처치한 후 에바 사크호프에게 돌아가야 합니다.‡Vuelve a Scholomance con la Sangre de los inocentes. Busca el Porche y coloca la Sangre de los inocentes en el blandón. Kirtonos acudirá a devorar tu alma.nnLucha con valentía, ¡no cedas ni una pulgada! Destruye a Kirtonos y vuelve con Eva Sarkhoff.|n‡Vuelve a Scholomance con la sangre inocente. Busca el Porche y coloca la Sangre de los inocentes en el blandón. Kirtonos acudirá a devorar tu alma.|nLucha con valentía, ¡no cedas ni una pulgada! Destruye a Kirtonos y vuelve con Eva Sarkhoff.‡Retournez à la Scholomance avec le Sang des innocents. Trouvez le porche et placez le Sang des innocents dans le brasero. Kirtonos viendra dévorer votre âme.nnCombattez vaillamment, sans perdre un pouce de terrain ! Détruisez Kirtonos et retournez auprès d\'Eva Sarkhoff.‡带着无辜者之血回到通灵学院，将它放在门廊的火盆下面，基尔图诺斯会前来吞噬你的灵魂。nn勇敢地战斗吧，不要退缩！杀死基尔图诺斯，然后回到艾瓦·萨克霍夫那儿。‡帶著無辜者之血回到通靈學院，將它放在門廊的火盆下方，基爾圖諾斯會前來吞噬你的靈魂。|n勇敢地戰鬥吧，不要退縮!殺死基爾圖諾斯，然後回到艾瓦·薩克霍夫那兒。',
  }
},
[5385] = {
  {
    'Os Restos Mortais de Trey Forjaleve‡Останки Трея Светогорна‡Die Überreste von Trey Lichtschmied‡트레이 라이트포지의 유해‡Restos de Trey Forjaluz‡Los restos de Trey Forjaluz‡Le cadavre de Trey Sancteforge‡特雷·莱弗治的残骸‡特雷·萊弗治的殘骸',
    nil,
    'Entregue os Restos Mortais de Trey Forjaleve a Jessir Lunarco, em Selva Maleva.‡Принесите останки Трея Светогорна Джессире Лунной Радуге в Оскверненный лес.‡Bringt die Überreste von Trey Lichtschmied zu Jessir Mondsichel im Teufelswald.‡트레이 라이트포지의 유해를 악령의 숲에 있는 제시 문보우에게 가져다주어야 합니다.‡Lleva los Restos de Trey Forjaluz a Jessir Arcolunar a Frondavil.‡Lleva los Restos de Trey Forjaluz a Jessir Arcolunar a Frondavil.‡Rapporter le Cadavre de Trey Sancteforge à Jessir Arquelune dans Gangrebois.‡将特雷·莱弗治的残骸交给费伍德森林的杰希尔·月弓。‡將特雷·萊弗治的殘骸交給費伍德森林的傑希爾·月弓。',
  }
},
[5386] = {
  {
    'Peixe do dia‡Дорога рыбка к обеду‡Der Fang des Tages‡낚시하는 날‡La pesca del día‡La pesca del día‡La prise du jour‡食鱼度日‡食魚度日',
    nil,
    'Converse com Jinar\'Zillen, na Aldeia Pescassombra, e depois leve 2 peixes pança-sangrenta para Nataoka Chifre Longo.‡Отправляйтесь в деревню Ночных Охотников и поговорите с Джинар\'Зилленом, а затем принесите Натаке Длинному Рогу 2 рыбы-кровобрюха.‡Sprecht mit Jinar\'Zillen in Schattenflucht und bringt Nataka Langhorn dann 2 Blutbauchfische.‡그늘수렵 마을에 있는 지나르질렌과 대화한 후 나타카 롱혼에게 붉은복어 2마리를 가져가야 합니다.‡Habla con Jinar\'Zillen, en la Aldea Cazasombras, y luego lleva 2 panzasangres a Nataka Cuernolargo.‡Habla con Jinar\'Zillen, en la Aldea Cazasombras, y luego lleva 2 panzasangres a Nataka Cuerno Largo.‡Parler à Jinar\'Zillen à Proie-de-l\'Ombre, puis apporter 2 poissons Ventre-rouge à Nataka Longue-corne.‡与葬影村的吉纳泽林谈话，然后将2条血肚鱼交给纳塔卡·长角。‡與葬影村的吉納澤林談話，然後將2條血肚魚交給納塔卡·長角。',
  }
},
[5401] = {
  {
    'Ordem da Aurora Argêntea‡Жетон Серебряного Рассвета‡Anstecknadel der Argentumdämmerung‡은빛 여명회 위임봉‡Comisión de El Alba Argenta‡Comisión de El Alba Argenta‡Brevet de l\'Aube d\'argent‡银色黎明委任徽章‡銀色黎明委任徽章',
    nil,
    'Todos os que lutam contra o mal em nome da Aurora Argêntea precisam envergar nossa comenda. Ao usá-la, você conquista o direito a reclamar as recompensas que nossos intendentes oferecem.nnSob a ordem, você conseguirá adquirir as Pedras do Flagelo de Flagelos mortos, que são as marcas de insígnia que eles costumam portar. Procure por essas insígnias e traga-as para mim. Para cada conjunto que trouxer, você receberá nossa marca de heroísmo: o Símbolo de Bravura da Aurora Argêntea.nnConquiste o seu destino, <class>, junte-se à luta hoje!‡Все, кто сражаются со злом во имя Серебряного Рассвета, должны получить наш амулет. Он даст тебе право получать награды у наших интендантов.nnПока ты носишь его на шее, ты сможешь собирать камни Плети с убитой нежити; да-да, иногда они носят такие знаки различия. Собирай их и приноси мне. За каждый набор ты получишь по знаку доблести Серебряного Рассвета – так мы благодарим наших героев.nnСтупай навстречу судьбе – вступай в битву со злом!‡Alle, die für die Argentumdämmerung das Böse bekämpfen, müssen unsere Anstecknadel tragen. Wenn Ihr eine solche tragt, erhaltet Ihr das Recht, Belohnungen in Anspruch zu nehmen, die unsere Rüstmeister anzubieten haben.nnWährend Ihr die Nadel tragt, könnt Ihr Euch Geißelsteine von erschlagenen Mitgliedern der Geißel holen; das sind Insignien, die sie manchmal besitzen. Beschafft Euch diese Insignien und bringt sie mir. Für alle, die Ihr abgebt, erhaltet Ihr unsere Marke des Heldentums - die Ehrenmarke der Argentumdämmerung.nnErfüllt Euer Schicksal, <Klasse> ... stürzt Euch noch heute in den Kampf!‡은빛 여명회를 대신해 악과 싸우는 자들은 모두 우리의 위임봉을 착용해야 합니다. 이 위임봉을 착용함으로써 병참장교들이 반드시 제공해야 하는 보상을 받을 권리가 생기는 것입니다.nn이 위임봉을 착용하고 있는 동안 스컬지를 쓰러뜨리면 스컬지석을 얻을 수 있습니다. 스컬지와 전투 중에 가끔 녀석들이 소지하고 있는 표장인 스컬지석을 얻을 수 있을 테니 그걸 찾으면 나에게 가져오십시오. 한 세트씩 가져올 때마다 영웅적인 행위를 증명하는 은빛 여명회 명예 휘장을 드리도록 하겠습니다.nn오늘 전투에 참여하여 형제님의 운명을 이루십시오!‡Todos los que combaten el mal en nombre del Alba Argenta deben vestir nuestra Comisión. Al hacerlo obtendrás el derecho de reclamar recompensas a nuestros intendentes.nnMientras estés bajo nuestra comisión podrás adquirir piedras de la Plaga de sus miembros caídos ya que esas piedras son insignias que a veces llevan consigo. Hazte con esas insignias y tráemelas. Por cada juego que traigas recibirás nuestras señales de heroísmo: las muestras de valor del Alba Argenta.nnSigue tu destino, <clase>, ¡únete hoy mismo a la lucha!‡‡Tous ceux qui combattent le mal au nom de l\'Aube d\'argent doivent recevoir un brevet et arborer notre insigne. Cela leur donne le droit de demander à nos intendants les récompenses dont ils ont la garde.nnLorsque vous aurez votre brevet, vous pourrez récupérer des pierres du Fléau sur les membres du Fléau abattus ; ce sont des insignes qu\'ils ont, parfois. Procurez-vous ces insignes et apportez-les-moi. Pour chaque insigne rapporté, vous recevrez notre marque d\'héroïsme - la marque de valeur de l\'Aube d\'argent.nnAccomplissez votre destin, <classe> - rejoignez le combat dès aujourd\'hui !‡所有以银色黎明之名与邪恶战斗的勇士都必须佩戴我们的委任徽章，这样你们就可以向我们的军需官领取奖赏。nn在受到委任之后，你就可以从天灾军团士兵的尸体上收集天灾石，那是他们身份和职位的证明。将你收集到的天灾石交给我，每套天灾石都可用来换取一枚勇气和荣耀的象征——银色黎明勇气勋章。nn实现你的价值，<class>，今天就加入与天灾军团作战的行列！‡',
  }
},
[5402] = {
  {
    'Pedra do Flagelo do Lacaio‡Камни приспешников плети‡Geißelsteine des Dieners‡앞잡이의 스컬지석‡Piedras de la Plaga del esbirro‡Piedras de la Plaga del esbirro‡Pierres du Fléau des serviteurs‡爪牙的天灾石‡爪牙的天譴石',
    nil,
    'As Pedras do Flagelo do Lacaio são a insígnia dos integrantes do Flagelo. Costumam ser encontradas com os mais fracos das tropas que ficam estacionadas nas Terras Pestilentas, embora o termo "mais fracos" não deva ser considerado fora de contexto. Onde quer que esteja, o Flagelo nunca deve ser subestimado.nnA Aurora Argêntea oferece um símbolo de bravura em troca de vinte insígnias, uma troca que faço com prazer, desde que você tenha conquistado pedras do flagelo suficientes.‡Камни Плети приспешников – знаки различия Плети. Иногда их можно найти у нежити, у более слабых бойцов, хотя слово "слабый" – относительное понятие. Не стоит недооценивать Плеть. nnОт имени Серебряного Рассвета я готов вручить тебе по знаку доблести за каждые двадцать камней, причем с радостью – чем больше ты убьешь приспешников Плети, тем лучше.‡Der Geißelstein des Dieners ist die Insignie des Fußvolkes der Geißel. Man findet sie manchmal bei den schwächeren Truppen, die in den Pestländern stationiert sind, obwohl der Begriff \'schwächere\' natürlich relativ betrachtet werden muss. Die Geißel sollte, ganz gleich wo sie sich befindet, niemals unterschätzt werden.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zwanzig dieser Insignien - ein Tausch, den ich freudig ausführe, vorausgesetzt, Ihr habt genug Geißelsteine!‡앞잡이의 스컬지석은 스컬지 사병들의 표장입니다. 이 표장은 역병지대에 배치된 부대들 중 좀 약한 무리들에게서 종종 찾을 수 있습니다. 하지만 "좀 약하다"고 해서 녀석들을 얕잡아봐서는 절대 안 됩니다. 스컬지는 어디에 있든지 결코 과소평가해서는 안 될 상대랍니다.nn현재 은빛 여명회에서는 이 표장 20개를 가져오는 이에게 명예 휘장 하나씩을 지급하고 있습니다. 스컬지석을 충분히 모아 오면 기꺼이 명예 휘장과 교환해 드리도록 하겠습니다.‡Una piedra de la Plaga del esbirro es la insignia de las filas de la Plaga. A veces pueden encontrarse en los miembros más débiles de las tropas destacadas en las Tierras de la Peste, aunque la palabra "débil" es muy relativa. La Plaga, da igual de quién se trate, nunca debe ser subestimada.nnEn este momento el Alba Argenta ofrece una muestra de valor a cambio de veinte de esas insignias... un intercambio que me encantaría hacer, ¡siempre y cuando tengas suficientes piedras de la Plaga!‡‡Une Pierre du Fléau des serviteurs est l\'insigne du rang et de la classe du Fléau. Elles se trouvent parfois sur les plus faibles de leurs troupes positionnées dans les Maleterres, bien que le terme "faible" mérite d\'être replacé dans son contexte.Les membres du Fléau, où qu\'ils soient, ne devraient jamais être sous-estimés.nnL\'Aube d\'argent offre à présent une marque de valeur pour 20 de ces insignes - un échange que je serai heureuse d\'effectuer si vous avez amassé suffisamment de pierres du Fléau.‡爪牙的天灾石是天灾军团的身份象征，通常是由那些部署在瘟疫之地的、较为弱小的士兵所携带的。我所说的“较为弱小”是个相对的概念，无论天灾军团出现在哪里，他们都是一个不可轻视的威胁。nn如果你能拿来二十个这样的天灾石，银色黎明将会给你颁发一枚勇气勋章，以此表彰你在于天灾军团的战争中做出的贡献！‡',
  }
},
[5403] = {
  {
    'Pedra do Flagelo do Invasor‡Камни захватчиков Плети‡Geißelsteine des Eindringlings‡침입자의 스컬지석‡Piedras de la Plaga del invasor‡Piedras de la Plaga del invasor‡Pierres du Fléau des envahisseurs‡侵略者的天灾石‡侵略者的天譴石',
    nil,
    'As Pedras do Flagelo do Invasor são a insígnia das tropas de elite do Flagelo. Costumam ser encontradas com os mais fortes das tropas que ficam estacionadas nas Terras Pestilentas. Matar uma criatura dessas é um grande desafio e um feito que deve ser reconhecido com uma comenda por derrotar o mal.nnA Aurora Argêntea oferece um símbolo de bravura em troca de dez insígnias dessas. Traga-as para mim que eu lhe concederei a justa recompensa.‡Камни Плети приспешников – знаки различия элитных войск Плети. Порой их можно найти у сильных бойцов в Чумных землях. Убить таких бойцов – настоящий подвиг, который должно совершать во имя борьбы со злом.nnВ настоящий момент Серебряный Рассвет предлагает по знаку доблести в обмен на десять таких камней. Принеси их мне, и непременно получишь достойную награду.‡Der Geißelstein des Eindringlings ist die Insignie der Elitetruppen der Geißel. Man findet sie manchmal bei den stärkeren Truppen, die in den Pestländern stationiert sind. Das Erschlagen einer solchen Kreatur ist wahrlich eine Herausforderung, aber eine, die jemand, der sich den Sieg über das Böse auf die Fahne geschrieben hat, mit Freude erfüllen sollte.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zehn dieser Insignien. Bringt sie mir und ich werde sicherstellen, dass Ihr Eure gerechte Belohnung erhaltet.‡침입자의 스컬지석은 스컬지의 정예 군단이 지니는 표장이죠. 역병지대에 배치된 부대들 중에서도 좀 더 강한 녀석들에게서 종종 찾을 수 있습니다. 이러한 녀석을 처치하는 것이 사실 쉽지 않지만, 악의 처단이라는 임무를 마음에 새기며 즐겨야 할 임무라고 할 수 있습니다.nn은빛 여명회에서는 현재 이 표장 10개를 가져오는 이에게 명예 휘장 하나를 주고 있습니다. 내게 그 표장들을 가져오시면 형제님께서 마땅히 받아야 할 보상을 반드시 지급하도록 하겠습니다.‡Una piedra de la Plaga del invasor es la insignia de las tropas de élite de la Plaga. A veces pueden encontrarse entre los más fuertes de las tropas destacadas en las Tierras de la Peste. Derrotar una criatura así es, sin duda, todo un reto, pero uno del que se disfruta cuando se está comprometido con la aniquilación del mal. nnEn este momento, el Alba Argenta ofrece una muestra de valor a cambio de diez de esas insignias. Tráemelas y me aseguraré de que recibas tu recompensa.‡‡Une pierre de Fléau des envahisseurs est l\'insigne des troupes d\'élite du Fléau. On les trouve parfois sur les soldats les plus aguerris stationnés dans les Maleterres. Abattre une telle créature est sans conteste un défi, mais un défi bien agréable pour ceux qui ont accepté notre brevet pour combattre le mal.nnL\'Aube d\'argent offre actuellement une marque de valeur en échange de dix de ces insignes. Apportez-les-moi, et je ferai en sorte que vous receviez votre juste récompense.‡‡',
  }
},
[5404] = {
  {
    'Pedra do Flagelo do Corruptor‡Камни осквернителей Плети‡Geißelsteine des Verderbers‡타락자의 스컬지석‡Piedras de la Plaga del corruptor‡Piedras de la Plaga del corruptor‡Pierres du Fléau des corrupteurs‡堕落者的天灾石‡墮落者的天譴石',
    nil,
    'As Pedras do Flagelo do Corruptor são a insígnia dos Lordes Supremos do Flagelo. Os seres mais poderosos, que ocupam posições de autoridade no Flagelo, vão sempre envergar uma dessas. A morte de uma dessas criaturas malignas é sempre um passo adiante para a causa da Aurora Argêntea, e de todas as boas causasnnEm nome da Aurora Argêntea, eu lhe concederei um símbolo de bravura para cada insígnia dessas que você trouxer. Tenha cuidado ao tentar conseguir a sua, <name>, não subestime criaturas tão poderosas.‡Камень Плети Осквернителя – знак различия предводителей Плети. Он есть у каждого обладающего властью в Плети. Убийство этих проклятых тварей служит благу Серебряного Рассвета... да и вообще всеобщему благу!nnОт имени Серебряного Рассвета я вручу тебе по знаку доблести за каждый из этих знаков. Только соблюдай осторожность, Вилдан – с этими тварями шутки плохи.‡Der Geißelstein des Verderbers ist die Insignie der Oberanführer der Geißel. Ein mächtiges Wesen, das eine Autoritätsposition über der Geißel innehat, wird immer einen besitzen. Eine solch bösartige Kreatur zu erschlagen, würde die Sache der Argentumdämmerung und alle guten Sachen sicherlich voranbringen!nnIm Namen der Argentumdämmerung werde ich Euch eine Ehrenmarke im Tausch für jeweils eine dieser Insignien geben. Seid vorsichtig, wenn Ihr diese Insignien holt, <Name> ... mit solch mächtigen Wesen ist nicht zu spaßen.‡타락자의 스컬지석은 스컬지 우두머리들의 표장입니다. 스컬지를 다스리는 직위를 가진 강력한 언데드라면 항상 하나씩 지니고 있지요. 그런 사악한 생물을 처치하는 것은 틀림없이 은빛 여명회의 대의와 모든 선한 대의의 실현을 앞당기게 될 겁니다!nn은빛 여명회를 대신해 형제님께 이 표장 하나를 명예 휘장 하나와 교환해 드리도록 하겠습니다. 그토록 강력한 존재들에 함부로 맞서서는 안 될 일이니 이 표장을 얻을 때는 조심하시기 바랍니다.‡Una piedra de la Plaga del corruptor es la insignia de los Señores Supremos de la Plaga. Todo ser poderoso y con autoridad sobre la Plaga posee una de esas piedras. Acabar con una criatura tan malévola sería un gran paso adelante para la causa del Alba Argenta y para todas las causas justas.nnEn nombre del Alba Argenta te daré una muestra de valor a cambio de una sola de esas insignias. Ten cuidado al obtenerlas, <nombre>... no hay que andar jugando con criaturas tan poderosas.‡‡Une Pierre du Fléau des Corrupteurs est l\'insigne des Seigneurs du Fléau. Tout être puissant occupant une position d\'autorité au sein du Fléau en possède une. Détruire l\'une de ces créatures malfaisantes ferait sans doute avancer la cause de l\'Aube d\'argent, et toutes les bonnes causes !nnAu nom de l\'Aube d\'argent, je vous remettrai une marque de valeur en échange de l\'un de ces insignes. Soyez prudent dans votre quête, <nom> - on ne plaisante pas avec des êtres d\'une telle puissance.‡‡',
  }
},
[5405] = {
  {
    'Ordem da Aurora Argêntea‡Жетон Серебряного Рассвета‡Anstecknadel der Argentumdämmerung‡은빛 여명회 위임봉‡Comisión de El Alba Argenta‡Comisión de El Alba Argenta‡Brevet de l\'Aube d\'argent‡银色黎明委任徽章‡銀色黎明委任徽章',
    nil,
    'Todos os que lutam contra o mal em nome da Aurora Argêntea precisam envergar nossa comenda. Ao usá-la, você conquista o direito a reclamar as recompensas que nossos intendentes oferecem.nnSob a ordem, você conseguirá adquirir as pedras do flagelo de Flagelos mortos, que são as marcas de insígnia que eles costumam portar. Procure por essas insígnias e traga-as para mim. Para cada conjunto que trouxer, você receberá nossa marca de heroísmo: o Símbolo de Bravura da Aurora Argêntea.nnConquiste o seu destino, <class>, junte-se à luta hoje!‡Все, кто сражаются со злом во имя Серебряного Рассвета, должны получить наш амулет. Он даст тебе право получать награды у наших интендантов.nnПока ты носишь его на шее, ты сможешь собирать камни Плети с убитой нежити; да-да, иногда они носят такие знаки различия. Собирай их и приноси мне. За каждый набор ты получишь по знаку доблести Серебряного Рассвета – так мы благодарим наших героев.nnСтупай навстречу судьбе – вступай в битву со злом!‡Alle, die für die Argentumdämmerung das Böse bekämpfen, müssen unsere Anstecknadel tragen. Wenn Ihr eine solche tragt, erhaltet Ihr das Recht, Belohnungen in Anspruch zu nehmen, die unsere Rüstmeister anzubieten haben.nnWährend Ihr die Nadel tragt, könnt Ihr Euch Geißelsteine von erschlagenen Mitgliedern der Geißel holen; das sind Insignien, die sie manchmal besitzen. Beschafft Euch diese Insignien und bringt sie mir. Für alle, die Ihr abgebt, erhaltet Ihr unsere Marke des Heldentums - die Ehrenmarke der Argentumdämmerung.nnErfüllt Euer Schicksal, <Klasse> ... stürzt Euch noch heute in den Kampf!‡은빛 여명회를 대신해 악과 싸우는 자들은 모두 우리의 위임봉을 착용해야 하네. 이 위임봉을 착용함으로써 병참장교들이 제공해야만 하는 보상을 받을 권리가 생기게 되는 것이지.nn이 위임봉을 착용하고 있는 동안 스컬지를 쓰러뜨리면 스컬지석을 얻을 수 있을 걸세. 스컬지와 전투 중에 가끔 녀석들이 소지하고 있는 표장인 스컬지석을 얻을 수 있을 테니 그걸 찾으면 나에게 가져오게나. 한 세트씩 가져올 때마다 자네의 영웅적인 행위를 증명하는 은빛 여명회 명예 휘장을 주도록 하지.nn오늘 전투에 참여하여 자네의 운명을 이루게!‡Todos los que combaten el mal en nombre de El Alba Argenta deben vestir nuestra Comisión. Al hacerlo obtendrás el derecho de reclamar recompensas a nuestros intendentes.nnMientras estés bajo nuestra comisión podrás adquirir piedras de la Plaga de sus miembros caídos ya que esas piedras son insignias que a veces llevan consigo. Hazte con esas insignias y tráemelas. Por cada juego que traigas recibirás nuestras señales de heroísmo: las muestras de valor de El Alba Argenta.nnSigue tu destino, <clase>, ¡únete hoy mismo a la lucha!‡‡Tous ceux qui combattent le mal au nom de l\'Aube d\'argent doivent recevoir un brevet et arborer notre insigne. Cela leur donne le droit de demander à nos intendants les récompenses dont ils ont la garde.nnLorsque vous aurez votre brevet, vous pourrez récupérer des pierres du Fléau sur les membres du Fléau abattus ; ce sont des insignes qu\'ils ont, parfois. Procurez-vous ces insignes et apportez-les-moi. Pour chaque insigne rapporté, vous recevrez notre marque d\'héroïsme - la marque de valeur de l\'Aube d\'argent.nnAccomplissez votre destin, <classe> - rejoignez le combat dès aujourd\'hui !‡‡',
  }
},
[5406] = {
  {
    'Pedra do Flagelo do Corruptor‡Камни осквернителей Плети‡Geißelsteine des Verderbers‡타락자의 스컬지석‡Piedras de la Plaga del corruptor‡Piedras de la Plaga del corruptor‡Pierres du Fléau des corrupteurs‡堕落者的天灾石‡墮落者的天譴石',
    nil,
    'As Pedras do Flagelo do Corruptor são a insígnia dos Lordes Supremos do Flagelo. Os seres mais poderosos, que ocupam posições de autoridade no Flagelo, vão sempre envergar uma dessas. A morte de uma dessas criaturas malignas é sempre um passo adiante para a causa da Aurora Argêntea, e de todas as boas causasnnEm nome da Aurora Argêntea, eu lhe concederei um símbolo de bravura para cada insígnia dessas que você trouxer. Tenha cuidado ao tentar conseguir a sua, <name>, não subestime criaturas tão poderosas.‡Камень Плети Осквернителя – знак различия предводителей Плети. Он есть у каждого обладающего властью в Плети. Убийство этих проклятых тварей служит благу Серебряного Рассвета... да и вообще всеобщему благу!nnОт имени Серебряного Рассвета я вручу тебе по знаку доблести за каждый из этих знаков. Только соблюдай осторожность, Херин – с этими тварями шутки плохи.‡Der Geißelstein des Verderbers ist die Insignie der Oberanführer der Geißel. Ein mächtiges Wesen, das eine Autoritätsposition über der Geißel innehat, wird immer einen besitzen. Eine solch bösartige Kreatur zu erschlagen, würde die Sache der Argentumdämmerung und alle guten Sachen sicherlich voranbringen!nnIm Namen der Argentumdämmerung werde ich Euch eine Ehrenmarke im Tausch für jeweils eine dieser Insignien geben. Seid vorsichtig, wenn Ihr diese Insignien holt, <Name> ... mit solch mächtigen Wesen ist nicht zu spaßen.‡타락자의 스컬지석은 스컬지 우두머리들의 표장이라네. 스컬지를 다스리는 직위를 가진 강력한 언데드라면 항상 하나씩 지니고 있지. 그런 사악한 생물을 처치하는 것은 틀림없이 은빛 여명회의 대의와 모든 선한 대의의 실현을 앞당기게 될 것이네!nn은빛 여명회를 대신해 자네에게 이 표장 하나를 명예 휘장 하나와 교환해 주도록 하지. 그토록 강력한 존재들에게 함부로 맞서서는 안 될 일이니까 이 표장을 얻을 때는 조심하도록 하게나.‡Una piedra de la Plaga del corruptor es la insignia de los Señores Supremos de la Plaga. Todo ser poderoso y con autoridad sobre la Plaga posee una de esas piedras. Acabar con una criatura tan malévola sería un gran paso adelante para la causa de El Alba Argenta y para todas las causas justas.nnEn nombre de El Alba Argenta te daré una muestra de valor a cambio de una sola de esas insignias. Ten cuidado al obtenerlas, <nombre>... no hay que andar jugando con criaturas tan poderosas.‡‡Une Pierre du Fléau des Corrupteurs est l\'insigne des Seigneurs du Fléau. Tout être puissant occupant une position d\'autorité au sein du Fléau en possède une. Détruire l\'une de ces créatures malfaisantes ferait sans doute avancer la cause de l\'Aube d\'argent, et toutes les bonnes causes !nnAu nom de l\'Aube d\'argent, je vous remettrai une marque de valeur en échange de l\'un de ces insignes. Soyez prudent dans votre quête, <nom> - on ne plaisante pas avec des êtres d\'une telle puissance.‡‡',
  }
},
[5407] = {
  {
    'Pedra do Flagelo do Invasor‡Камни захватчиков Плети‡Geißelsteine des Eindringlings‡침입자의 스컬지석‡Piedras de la Plaga del invasor‡Piedras de la Plaga del invasor‡Pierres du Fléau des envahisseurs‡侵略者的天灾石‡侵略者的天譴石',
    nil,
    'As Pedras do Flagelo do Invasor são a insígnia das tropas de elite do Flagelo. Costumam ser encontradas com os mais fortes das tropas que ficam estacionadas nas Terras Pestilentas. Matar uma criatura dessas é um grande desafio e um feito que deve ser reconhecido com uma comenda por derrotar o mal.nnA Aurora Argêntea oferece um símbolo de bravura em troca de dez insígnias dessas. Traga-as para mim que eu lhe concederei a justa recompensa.‡Камни Плети приспешников – знаки различия элитных войск Плети. Порой их можно найти у сильных бойцов в Чумных землях. Убить таких бойцов – настоящий подвиг, который должно совершать во имя борьбы со злом.nnВ настоящий момент Серебряный Рассвет предлагает по знаку доблести в обмен на десять таких камней. Принеси их мне, и непременно получишь достойную награду.‡Der Geißelstein des Eindringlings ist die Insignie der Elitetruppen der Geißel. Man findet sie manchmal bei den stärkeren Truppen, die in den Pestländern stationiert sind. Das Erschlagen einer solchen Kreatur ist wahrlich eine Herausforderung, aber eine, die jemand, der sich den Sieg über das Böse auf die Fahne geschrieben hat, mit Freude erfüllen sollte.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zehn dieser Insignien. Bringt sie mir und ich werde sicherstellen, dass Ihr Eure gerechte Belohnung erhaltet.‡침입자의 스컬지석은 스컬지의 정예 군단이 지니는 표장일세. 역병지대에 배치된 부대들 중에서도 보다 강한 녀석들에게서 종종 찾을 수 있지. 사실 그러한 생물을 처치하는 것이 쉽지 않지만, 악의 처단이라는 임무를 마음에 새기며 즐겁게 전투에 임해야 할 것일세.nn은빛 여명회에서는 현재 이 표장 10개를 가져오는 이에게 명예 휘장 하나를 지급하고 있네. 이곳으로 내게 그 표장들을 가져오면 자네가 마땅히 받아야 할 보상을 반드시 지급하도록 하지.‡Una piedra de la Plaga del invasor es la insignia de las tropas de élite de la Plaga. A veces pueden encontrarse entre los más fuertes de las tropas destacadas en las Tierras de la Peste. Derrotar una criatura así es, sin duda, todo un reto, pero uno del que se disfruta cuando se está comprometido con la aniquilación del mal. nnEn este momento, El Alba Argenta ofrece una muestra de valor a cambio de diez de esas insignias. Tráemelas y me aseguraré de que recibas tu recompensa.‡‡Une pierre de Fléau des envahisseurs est l\'insigne des troupes d\'élite du Fléau. On les trouve parfois sur les soldats les plus aguerris stationnés dans les Maleterres. Abattre une telle créature est sans conteste un défi, mais un défi bien agréable pour ceux qui ont accepté notre brevet pour combattre le mal.nnL\'Aube d\'argent offre actuellement une marque de valeur en échange de dix de ces insignes. Apportez-les-moi, et je ferai en sorte que vous receviez votre juste récompense.‡‡',
  }
},
[5408] = {
  {
    'Pedra do Flagelo do Lacaio‡Камни приспешников плети‡Geißelsteine des Dieners‡앞잡이의 스컬지석‡Piedras de la Plaga del esbirro‡Piedras de la Plaga del esbirro‡Pierres du Fléau des serviteurs‡爪牙的天灾石‡爪牙的天譴石',
    nil,
    'As Pedras do Flagelo do Lacaio são a insígnia dos integrantes do Flagelo. Costumam ser encontradas com os mais fracos das tropas que ficam estacionadas nas Terras Pestilentas, embora o termo "mais fracos" não deva ser considerado fora de contexto. Onde quer que esteja, o Flagelo nunca deve ser subestimado.nnA Aurora Argêntea oferece um símbolo de bravura em troca de vinte insígnias, uma troca que faço com prazer, desde que você tenha conquistado pedras do flagelo suficientes.‡Камни Плети приспешников – знаки различия Плети. Иногда их можно найти у нежити, у более слабых бойцов, хотя слово "слабый" – относительное понятие. Не стоит недооценивать Плеть. nnОт имени Серебряного Рассвета я готов вручить тебе по знаку доблести за каждые двадцать камней, причем с радостью – чем больше ты убьешь приспешников Плети, тем лучше.‡Der Geißelstein des Dieners ist die Insignie des Fußvolkes der Geißel. Man findet sie manchmal bei den schwächeren Truppen, die in den Pestländern stationiert sind, obwohl der Begriff \'schwächere\' natürlich relativ betrachtet werden muss. Die Geißel sollte, ganz gleich wo sie sich befindet, niemals unterschätzt werden.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zwanzig dieser Insignien - ein Tausch, den ich freudig ausführe, vorausgesetzt, Ihr habt genug Geißelsteine!‡앞잡이의 스컬지석은 스컬지 사병들의 표장일세. 이 표장은 역병지대에 배치된 부대들 중 좀 약한 무리들에게서 가끔 찾을 수 있지. 하지만 좀 약하다고 해서 녀석들을 얕잡아봐서는 절대 안 되네. 스컬지는 어디에 있든지 결코 과소평가해서는 안 될 상대라네.nn현재 은빛 여명회에서는 이 표장 20개를 가져오는 이에게 명예 휘장 하나를 지급하고 있네. 스컬지석을 충분히 모아 오면 기꺼이 명예 휘장과 교환해 주도록 하지.‡Una piedra de la Plaga del esbirro es la insignia de las filas de la Plaga. A veces pueden encontrarse en los miembros más débiles de las tropas destacadas en las Tierras de la Peste, aunque la palabra "débil" es muy relativa. La Plaga, da igual de quién se trate, nunca debe ser subestimada.nnEn este momento El Alba Argenta ofrece una muestra de valor a cambio de veinte de esas insignias... un intercambio que me encantaría hacer, ¡siempre y cuando tengas suficientes piedras de la Plaga!‡‡Une Pierre du Fléau des serviteurs est l\'insigne du rang et de la classe du Fléau. Elles se trouvent parfois sur les plus faibles de leurs troupes positionnées dans les Maleterres, bien que le terme "faible" mérite d\'être replacé dans son contexte.Les membres du Fléau, où qu\'ils soient, ne devraient jamais être sous-estimés.nnL\'Aube d\'argent offre à présent une marque de valeur pour 20 de ces insignes - un échange que je serai heureux d\'effectuer si vous avez amassé suffisamment de pierres du Fléau.‡‡',
  }
},
[5421] = {
  {
    'Peixe no balde‡Рыбка в ведерке‡Fisch im Eimer‡들통 속의 복어‡Pescado en un balde‡Pescado en un balde‡Poisson dans un seau‡坐享其成‡坐享其成',
    nil,
    'Eu dou recompensa pra quem deixar a minha vida mais fácil... eu gosto de fazer o menor esforço possível, cara!nnEu coloquei uma porção de armadilhas pra lagostim debaixo das docas aqui da Aldeia Pescassombra. Se tu tiver a fim de fazer o meu trabalho e pegar os lagostins lá pra mim, eu posso te dar uma coisinha que tu vai se amarrar, tá ligado? Pra cada cinco lagostins que tu me trazer, eu te dou um peixe pança-sangrenta.‡Я награжу любого, кто хоть немного облегчит мою жизнь... Чем меньше я делаю, тем мне лучше, дружище!nnЗдесь неподалеку, в Деревне Ночных Охотников, прямо за пристанью, я расставил ловушки на моллюсков. Много, много ловушек! Будь так любезен, сделай за меня мою работу: собери улов и принеси мне, а я уж тебя награжу кое-чем нужным... понимаешь мою мысль, да? За каждые пять моллюсков я дам тебе по отличной рыбе-кровобрюху!‡Ich werde jeden belohnen, der mein Leben ein bisschen einfacher macht... Ich genieße es, so wenig wie möglich zu tun, Mann!nnUnter den Docks hier in Shadowprey habe ich viele Schalentierfallen. Wenn Ihr so freundlich wärt, meine Arbeit zu tun und meine Schalentiere einzusammeln, dann werde ich Euch mit etwas belohnen, das Ihr wollt... Ihr wisst schon, was ich meine, eh? Für jeweils fünf Schalentiere, die Ihr mir bringt, gebe ich Euch einen feinen Blutbauchfisch!‡난 내 생활을 좀 더 편하게 해주는 자에게 보답을 하지. 되도록이면 움직이지 않는 게 좋거든!nn이곳 그늘수렵 마을의 부두 아래에 가면 내가 설치한 가재 통발이 많이 있네. 가재를 모아서 나에게 가져다주면 보답으로 원하는 걸 주겠네. 알아들었겠지? 가재 5마리당 붉은복어 한 마리를 주지!‡Recompensaré a cualquiera que haga mi vida un poco más fácil... ¡Mi vida se rige por la ley del mínimo esfuerzo, colega!nnBajo el embarcadero, aquí en la Aldea Cazasombras, tengo muchas trampas de marisco. Si fueras tan amable... podrías hacer mi trabajo y recoger mi marisco... Y luego yo te doy algo que quieres, ¿pillas el sistema, colega? ¡Por cada 5 mariscos que me traigas, te daré un estupendo panzasangre!‡Jinar\'Zillen quiere que recojas 5 mariscos de las trampas que hay cerca de la Aldea Cazasombras.‡Je récompense ceux qui me facilitent la vie… J\'aime en faire le moins possible, mon ami !nnSous les quais de Proie-de-l\'Ombre, j\'ai placé de nombreux casiers à crustacés. Si vous avez la gentillesse de faire mon travail à ma place et de relever les casiers, je vous récompenserai en vous donnant quelque chose que vous voulez... Voyez où je veux en venir, l\'ami ? Je vous donnerai un beau Ventre-Rouge pour 5 crustacés rapportés !‡‡',
  }
},
[5441] = {
  {
    'Peões preguiçosos‡Ленивые батраки‡Faule Peons‡게으른 일꾼들‡Peones vagos‡Peones vagos‡Les péons paresseux‡懒惰的苦工‡懶惰的苦工',
    nil,
    'Use o Cassetete do Encarregado nos Peões Preguiçosos enquanto estiverem dormindo. Acorde 5 peões, depois devolva o Cassetete do Encarregado ao Encarregado Thazz\'ril, no Vale das Provações.‡Проучите ленивых батраков дубинкой старшины. Разбудите 5 батраков, потом верните дубинку штейгеру Тазз\'рилу в долине Испытаний.‡Benutzt den Großknechttotschläger an faulen Peons, wenn sie schlafen. Weckt 5 Peons auf und bringt dann den Großknechttotschläger zu Großknecht Thazz\'ril ins Tal der Prüfungen zurück.‡작업반장의 몽둥이를 가지고 가서 자고 있는 게으른 일꾼에게 사용해야 합니다. 일꾼 5명을 깨운 다음 시험의 골짜기에 있는 작업반장 타즈릴에게 돌아가 몽둥이를 돌려줘야 합니다.‡Utiliza la Cachiporra del supervisor con los peones vagos que estén durmiendo. Despierta a 5 peones y devuélvele la cachiporra al supervisor Thazz\'ril en el Valle de los Retos.‡Utiliza la Cachiporra del supervisor con los peones vagos que estén durmiendo. Despierta a 5 peones y devuélvele la cachiporra al supervisor Thazz\'ril en el Valle de los Retos.‡Utiliser la Matraque du contremaître sur les Péons paresseux, lorsqu\'ils sont en train de dormir. Réveiller 5 Péons, puis rapporter la Matraque du contremaître au contremaître Thazz\'ril, dans la Vallée des épreuves.‡在懒惰的苦工睡觉时，用工头的木棒敲他们。敲醒5个苦工，然后把工头的木棒还给试炼谷的工头塔兹利尔。‡在懶惰的苦工睡覺時，用工頭的木棒敲他們。敲醒5個苦工，然後把工頭的木棒還給試煉谷的工頭塔茲利爾。',
  }
},
[5461] = {
  {
    'Ras Friomúrmuro, o humano‡Рас Ледяной Шепот – человек‡Der Mensch Ras Frostraunen‡라스 프로스트위스퍼‡El humano, Ras Levescarcha‡El humano, Ras Murmuhielo‡L\'humain, Ras Murmegivre‡莱斯·霜语‡萊斯·霜語',
    nil,
    'Viaje para o Planalto Arathi, até as ruínas de Stromgarde. Vasculhe Stromgarde em busca de um Livro de Recordações. Se encontrar o item, retorne com ele até o Magistrado Marduque.‡Отправляйтесь в высокогорья Арати, в руины Стромгарда. Поищите в Стромгарде книгу Воспоминаний. Если удастся ее отыскать, отнесите ее мировому судье Мардуку.‡Reist in das Arathihochland zu den Ruinen von Stromgarde. Durchsucht Stromgarde nach einem Andenken der Erinnerung. Wenn Ihr einen solchen Gegenstand findet, kehrt mit ihm zu Magistrat Marduk zurück.‡아라시 고원에 있는 스트롬가드 폐허로 가십시오. 스트롬가드에서 추억의 유품을 찾아야 합니다. 그런 물건을 찾으면 집정관 마르듀크에게 돌아가야 합니다.‡Viaja a las Tierras Altas de Arathi, a las Ruinas de Stromgarde. En Stromgarde busca un Libro de los Recuerdos. Si lo encuentras llévaselo al magistrado Marduke.‡Viaja a las Tierras Altas de Arathi, a las Ruinas de Stromgarde. En Stromgarde busca un Libro de los Recuerdos. Si lo encuentras llévaselo al magistrado Marduke.‡Voyager jusqu\'aux hautes-terres d\'Arathi, et aller aux ruines de Stromgarde. Fouiller Stromgarde pour trouver un Souvenir de la mémoire. Si une telle trouvaille est faite, rapporter l\'objet au magistrat Marduke.‡到阿拉希高地的激流堡遗迹里面寻找巫妖生前的遗物。如果你能找到这样的东西，就把它交给马杜克镇长。‡到阿拉希高地的激流堡遺跡裡面尋找巫妖生前的遺物。如果你能找到這樣的東西，就把它交給馬杜克鎮長。',
  }
},
[5462] = {
  {
    'Ras Friomúrmuro, o moribundo‡Рас Ледяной Шепот – гибель‡Der Sterbende Ras Frostraunen‡망자, 라스 프로스트위스퍼‡El moribundo, Ras Levescarcha‡El moribundo, Ras Murmuhielo‡Le moribond, Ras Murmegivre‡亡灵莱斯·霜语‡亡靈萊斯·霜語',
    nil,
    'Viaje para a Capela Esperança da Luz, nas Terras Pestilentas Orientais, e procure por Leonid Bartolomeu, o Venerado. Mostre a ele o Livro de Recordações e conte tudo o que descobriu.‡Отправляйтесь в часовню Светлых надежд в Восточных Чумных землях и найдите Леонида Бартоломея Чтимого. Покажите ему книгу Воспоминаний и расскажите обо всем, о чем удалось узнать.‡Reist zur Hoffnung des Lichts in den östlichen Pestländern und sucht Leonidas Bartholomäus den Geachteten auf. Zeigt ihm das Andenken der Erinnerung und berichtet ihm alles, was Ihr entdeckt habt.‡동부 역병지대에 있는 희망의 빛 예배당으로 가서 존경받는 리어니드 바돌로매를 찾아서 추억의 유품을 보여 주고 알아낸 사실에 대해 모두 얘기해야 합니다.‡Viaja a Esperanza de la Luz en las Tierras de la Peste del Este y busca a Leonid Barthalomew el Venerado. Enséñale el Libro de los Recuerdos y cuéntale todo lo que has descubierto.‡Viaja a Esperanza de la Luz en las Tierras de la Peste del Este y busca a Leonid Barthalomew el Venerado. Enséñale el Libro de los Recuerdos y cuéntale todo lo que has descubierto.‡Voyager jusqu\'à l\'Espoir de lumière dans les Maleterres de l\'est et trouver Leonid Barthalomew le Révéré. Lui montrer le Souvenir de la mémoire et lui dire tout ce que vous avez découvert.‡到东瘟疫之地的圣光之愿礼拜堂去找到莱尼德·巴萨罗梅，给他看看巫妖生前的遗物，并告诉他你收集到的情报。‡到東瘟疫之地的聖光之願禮拜堂去找到可敬的萊尼德·巴薩羅梅，給他看看巫妖生前的遺物，並告訴他你收集到的情報。',
  }
},
[5463] = {
  {
    'Dádiva de Menethil‡Дар Менетила‡Menethils Geschenk‡메네실의 선물‡El Obsequio de Menethil‡El Obsequio de Menethil‡Le cadeau de Menethil‡米奈希尔的礼物‡米奈希爾的禮物',
    nil,
    'Vá até Stratholme e encontre a Dádiva de Menethil. Ponha o Livro de Recordações no solo profanado.‡Отправляйтесь в Стратхольм и отыщите Дар Менетила. Положите книгу Воспоминаний на оскверненную землю.‡Begebt Euch nach Stratholme und sucht Menethils Geschenk. Platziert das Andenken der Erinnerung auf dem unheiligen Boden.‡스트라솔름으로 가서 메네실의 선물을 찾아서 그 부정한 땅 위에 추억의 유품을 두어야 합니다.‡Viaja a Stratholme y encuentra el Obsequio de Menethil. Coloca el Libro de los Recuerdos en suelo no consagrado.‡Viaja a Stratholme y encuentra el Obsequio de Menethil. Coloca el Libro de los Recuerdos en suelo no consagrado.‡Voyager jusqu\'à Stratholme et trouver le Don de Menethil. Placer le Souvenir de la mémoire sur le sol impie.‡到斯坦索姆城里去找到米奈希尔的礼物，把巫妖生前的遗物放在那块邪恶的土地上。‡到斯坦索姆城裡去找到米奈希爾的禮物，把巫妖生前的遺物放在那塊邪惡的土地上。',
  }
},
[5464] = {
  {
    'Dádiva de Menethil‡Дар Менетила‡Menethils Geschenk‡메네실의 선물‡El Obsequio de Menethil‡El Obsequio de Menethil‡Le Don de Menethil‡米奈希尔的礼物‡米奈希爾的禮物',
    nil,
    'Leve a Lembrança Vinculada para Leonid Bartolomeu, nas Terras Pestilentas Orientais.‡Отнесите Книгу Души Леониду Бартоломею в Восточные Чумные земли.‡Bringt das seelengebundene Andenken zu Leonidas Bartholomäus in den östlichen Pestländern.‡동부 역병지대에 있는 리어니드 바돌로매에게 영혼이 씐 유품을 가져가야 합니다.‡Lleva el Libro de Memorias del Alma a Leonid Barthalomew a las Tierras de la Peste del Este.‡Lleva el Libro de Memorias del Alma a Leonid Barthalomew a las Tierras de la Peste del Este.‡Apporter le Souvenir lié à Leonid Barthalomew dans les Maleterres de l\'est.‡把禁锢灵魂的遗物交给东瘟疫之地的莱尼德·巴萨罗梅。‡把禁錮靈魂的遺物交給東瘟疫之地的萊尼德·巴薩羅梅。',
  }
},
[5465] = {
  {
    'Lembrança Vinculada‡Книга Души‡Seelengebundenes Andenken‡영혼이 씐 유품‡El Libro de Memorias del Alma‡El Libro de Memorias del Alma‡Souvenir lié‡禁锢灵魂的遗物‡禁錮靈魂的遺物',
    nil,
    'Fale novamente com o Magistrado Marduque, no Castro das Flechas. Mostre-lhe a Lembrança Vinculada.‡Возвращайтесь к мировому судье Мардуку в Каэр Дарроу. Покажите ему книгу души.‡Kehrt zu Magistrat Marduk in Darrowehr zurück. Zeigt ihm das seelengebundene Andenken.‡카엘 다로우에 있는 집정관 마르듀크에게 돌아가십시오. 그에게 영혼이 씐 유품을 보여줘야 합니다.‡Vuelve con el magistrado Marduke a Castel Darrow. Muéstrale el Libro de Memorias del Alma.‡Vuelve con el magistrado Marduke a Castel Darrow. Muéstrale el Libro de Memorias del Alma.‡Retourner auprès du Magistrat Marduke à Caer Darrow. Lui montrer le Souvenir lié.‡回到凯尔达隆的马杜克镇长那里，把禁锢灵魂的遗物交给他。‡回到凱爾達隆的馬杜克鎮長那裡，把禁錮靈魂的遺物交給他。',
  }
},
[5466] = {
  {
    'Ras Friomúrmuro, o lich‡Рас Ледяной Шепот – лич‡Der Lich Ras Frostraunen‡리치, 라스 프로스트위스퍼‡El exánime, Ras Levescarcha‡El exánime, Ras Murmuhielo‡La Liche, Ras Murmegivre‡巫妖莱斯·霜语‡巫妖萊斯·霜語',
    nil,
    'Procure por Ras Friomúrmuro em Scolomântia. Quando o encontrar, use a Lembrança Vinculada em sua versão morto-vivo. Quando conseguir transformá-lo novamente em mortal, mate-o e recupere a Cabeça Humana de Ras Friomúrmuro. Leve a cabeça de volta ao Magistrado Marduque.‡Отыщите в Некроситете Раса Ледяного Шепота. Найдя его, воспользуйтесь книгой души против его посмертного облика. Если удастся превратить Раса в смертного, убейте его и заберите человеческую голову Раса Ледяного Шепота. Отнесите голову мировому судье Мардуку.‡Sucht Ras Frostraunen in der Scholomance. Wenn Ihr ihn gefunden habt, wendet das seelengebundene Andenken auf sein untotes Antlitz an. Solltet Ihr ihn erfolgreich in einen Sterblichen zurückverwandeln können, dann schlagt ihn nieder und nehmt den menschlichen Kopf von Ras Frostraunen an Euch. Bringt den Kopf zu Magistrat Marduk.‡스칼로맨스에서 라스 프로스트위스퍼를 찾아야 합니다. 영혼이 쓰인 유품을 언데드 상태인 라스의 얼굴에 사용하십시오. 그를 산 자로 되돌리는 데 성공하면 그를 쓰러뜨리고 사람이 된 라스 프로스트위스퍼의 머리카락을 가지고 집정관 마르듀크에게 가야 합니다.‡Busca a Ras Levescarcha en Scholomance. Cuando lo hayas encontrado utiliza el Libro de Memorias del Alma sobre su rostro no-muerto. Si consiguieras convertirlo en mortal, derrótale y recupera la Cabeza humana de Ras Levescarcha. Lleva la cabeza al magistrado Marduke.‡Busca a Ras Murmuhielo en Scholomance. Cuando lo hayas encontrado utiliza el Libro de Memorias del Alma sobre su rostro no-muerto. Si consiguieras convertirlo en mortal, derrótale y recupera la Cabeza humana de Ras Murmuhielo. Lleva la cabeza al magistrado Marduke.‡Trouver Ras Murmegivre dans Scholomance. Après l\'avoir trouvé, utiliser le Souvenir lié sur son visage mort-vivant. Si sa transformation en mortel réussit, l\'abattre et prendre la Tête humaine de Ras Murmegivre. Apporter la tête au Magistrat Marduke.‡在通灵学院里找到莱斯·霜语。当你找到他之后，使用禁锢灵魂的遗物破除其亡灵的外壳。如果你成功地破除了他的不死之身，就杀掉他并拿到莱斯·霜语的头颅。把那个头颅交给马杜克镇长。‡在通靈學院裡找到萊斯·霜語。當你找到他之後，使用禁錮靈魂的遺物破除其不死生物的外殼。如果你成功地破除了他的不死之身，就殺掉他並拿到萊斯·霜語的頭顱。把那個頭顱交給馬杜克鎮長。',
  }
},
[5481] = {
  {
    'Beijo do Gordo‡Задание Толстяка‡Gordos Aufgabe‡고르도의 임무‡La tarea de Gordo‡La tarea de Gordo‡La tâche de Gordo‡葛尔多的任务‡葛爾多的任務',
    nil,
    'Colha 3 Ervas-do-emo e entregue para o Boticário-júnior Hollanda, no cemitério de Montalvo.‡Соберите 3 ветки мракоцвета для младшего аптекаря Холланда на кладбище Брилла.‡Sammelt 3 Düsterkräuter und bringt sie zu Jungapotheker Holland auf den Friedhof von Brill.‡어둠풀 3개를 채집해 브릴 공동묘지에 있는 초보연금술사 홀랜드에게 가져가야 합니다.‡Recoge 3 hierbas luminiscentes y entrégaselas al boticario de segunda Holland en el cementerio de Rémol.‡Recoge 3 hierbas luminiscentes y entrégaselas al boticario auxiliar Holland en el cementerio de Rémol.‡Récolter 3 Herbes des ténèbres et les apporter à l\'Apprenti Apothicaire Holland au Cimetière de Brill.‡收集3根阴暗草，把它们交给布瑞尔墓地的初级药剂师霍兰德。‡收集3根陰暗草，把它們交給布瑞爾墓地的初級藥劑師霍蘭德。',
  }
},
[5482] = {
  {
    'Erva-do-demo‡Погибельник‡Verdammniskraut‡죽음풀‡Apocalíseas‡Apocalíseas‡Herbe maléfique‡末日草‡末日草',
    nil,
    'Colha 10 Ervas-do-demo e entregue para o Boticário-júnior Hollanda.‡Соберите 10 веток погибельника для младшего аптекаря Холланда.‡Sammelt 10 Verdammniskräuter und bringt sie zu Jungapotheker Holland.‡초보연금술사 홀랜드에게 죽음풀 10개를 모아서 가져가야 합니다.‡Recoge 10 apocalíseas y entrégaselas al boticario de segunda Holland.|n‡Recoge 10 apocalíseas y entrégaselas al boticario auxiliar Holland.‡Récolter 10 Herbes maléfiques et les apporter à l\'apprenti apothicaire Holland.‡收集10株末日草，把它们交给初级药剂师霍兰德。‡收集10株末日草，把它們交給初級藥劑師霍蘭德。',
  }
},
[5501] = {
  {
    'Ossos do ofício‡Собиратель костей‡Knochenjäger‡뼈 수집가‡Recolección de kodos‡Recolección de kodos‡Collectionneur d\'os‡集骨者‡集骨者',
    nil,
    'Entregue 10 Ossos de Kodo do Cemitério dos Kodos para Bibbly Ferrafivela no Barraco do Kormek.‡Принесите 10 костей с Кладбища кодо в хижину Кормека и отдайте Биббли Скобкофузу.‡Bringt Bibbly F\'utzbuckel bei Kormeks Hütte 10 Kodoknochen vom Kodofriedhof.‡코르메크의 오두막에 있는 비블리 푸츠버클에게 코도 무덤에서 코도 뼈 10개를 가져가야 합니다.‡Lleva 10 huesos de kodo del Cementerio de Kodos a Bibbly F\'utzhebilla a la Cabaña de Kormek.‡Lleva 10 huesos de kodo del Cementerio de Kodos a Bibbly F\'utzhebilla a la Cabaña de Kormek.‡Apporter à Bibbly F\'ibulleur à la Hutte de Kormek 10 Os de kodo provenant du Cimetière des kodos.‡从科多墓地收集10根科多兽骨，把它们交给兽人小屋的比布里·弗斯巴克。‡從科多墓地收集10根科多獸骨，把它們交給獸人小屋的比布里·弗斯巴克。',
  }
},
[5502] = {
  {
    'Um protegido da Horda‡Опекун Орды‡Tageseltern der Horde‡호드 보육원‡Alcaide de la Horda‡Alcaide de la Horda‡Un surveillant de la Horde‡部落孤儿的看护者‡',
    nil,
    'Leve a criança de volta ao orfanato de Orgrimmar e entregue o Apito de Órfão Orc à Matriarca Uivadora no Vale da Honra.‡Возвратите своего подопечного в приют Оргриммара, вернув орочий сиротский свисток попечительнице сирот Батлвейл в Аллею Чести.‡Bringt Euren Schützling in das Waisenhaus von Orgrimmar zurück, indem Ihr die Pfeife des Orcwaisenkindes an Waisenmatrone Schlachterbe im Tal der Ehre übergebt.‡당신이 돌보고 있는 아이를 명예의 골짜기에 있는 오그리마 보육원에 데려다 주어야 합니다. 보육원 원장님 배틀웨일에게 오크 고아 호루라기를 건네주면 됩니다.‡Lleva a tu pupilo de vuelta al orfanato de Orgrimmar entregándole el silbato de huérfano orco a la supervisora de huérfanos Llantobatalla en el Valle del Honor.‡Compra un expositor para espadas de gomaespuma a Blax Botemisil en La Calle Mayor de Orgrimmar. Después, habla con la supervisora de huérfanos Llantobatalla en La Calle Mayor para llevar a tu pupilo de vuelta al orfanato de Orgrimmar.‡Ramenez votre protégé à l\'orphelinat d\'Orgrimmar, en rendant le sifflet d\'orphelin orc à la directrice de l\'orphelinat, Plainteguerre, dans la Vallée de l\'Honneur.‡从奥格瑞玛暗巷区的布雷克斯·瓶装火箭那里购买泡沫塑料剑架，然后将你的孤儿送回奥格瑞玛孤儿院，同暗巷区的孤儿监护员巴特维尔交谈，送你的孤儿回家。‡',
  }
},
[5503] = {
  {
    'Ordem da Aurora Argêntea‡Жетон Серебряного Рассвета‡Anstecknadel der Argentumdämmerung‡은빛 여명회 위임봉‡Comisión de El Alba Argenta‡Comisión de El Alba Argenta‡Brevet de l\'Aube d\'argent‡银色黎明委任徽章‡銀色黎明委任徽章',
    nil,
    '‡Все, кто сражаются со злом во имя Серебряного Рассвета, должны получить наш амулет. Он даст тебе право получать награды у наших интендантов.nnПока при тебе амулет, ты можешь собирать камни Плети с убитой нежити – иногда они носят такие знаки различия. Собирай их и приноси мне. За каждый из них ты получишь по знаку доблести Серебряного Рассвета – так мы благодарим наших героев.nnСтупай на встречу судьбе – вступай в битву со злом!‡Alle, die für die Argentumdämmerung das Böse bekämpfen, müssen unsere Anstecknadel tragen. Wenn Ihr eine solche tragt, erhaltet Ihr das Recht, Belohnungen in Anspruch zu nehmen, die unsere Rüstmeister anzubieten haben.nnWährend Ihr die Nadel tragt, könnt Ihr Euch Geißelsteine von erschlagenen Mitgliedern der Geißel holen; das sind Insignien, die sie manchmal besitzen. Beschafft Euch diese Insignien und bringt sie mir. Für alle, die Ihr abgebt, erhaltet Ihr unsere Marke des Heldentums - die Ehrenmarke der Argentumdämmerung.nnErfüllt Euer Schicksal, <Klasse> ... stürzt Euch noch heute in den Kampf!‡은빛 여명회를 대신해 악과 싸우는 자들은 모두 우리의 위임봉을 착용해야 하네. 이 위임봉을 착용함으로써 병참장교들이 반드시 제공해야 하는 보상을 받을 권리가 생기는 것이지.nn이 위임봉을 착용하고 있는 동안 스컬지를 쓰러뜨리면 스컬지석을 얻을 수 있을 것이네. 스컬지와 전투 중에 가끔 녀석들이 소지하고 있는 표장인 스컬지석을 얻을 수 있을 테니 그걸 찾으면 나에게 가져오게. 한 세트씩 가져올 때마다 영웅적인 행위를 증명하는 은빛 여명회 명예 휘장을 주겠네.nn오늘 싸움에 참여하여 자네의 운명을 개척하게!‡Todos los que combaten el mal en nombre del Alba Argenta deben portar nuestra Comisión. Cuando la lleves, tendrás derecho a reclamar las recompensas que ofrezcan nuestras Intendencias.nnY también podrás adquirir piedras de la Peste de miembros de la Peste caídos. Estas piedras son insignias que poseen algunos de ellos. Hazte con esas insignias y tráemelas. Por cada insignia que me entregues, recibirás nuestro símbolo de heroísmo: la muestra de valor del Alba Argenta.nnCumple tu destino, <clase>, ¡únete hoy al combate!‡‡Tous ceux qui combattent le mal au nom de l\'Aube d\'argent doivent recevoir un brevet et arborer notre insigne. Cela leur donne le droit de demander à nos intendants les récompenses dont ils ont la garde.nnLorsque vous aurez votre brevet, vous pourrez récupérer des pierres du Fléau sur les membres du Fléau abattus ; ce sont des insignes qu\'ils ont, parfois. Procurez-vous ces insignes et apportez-les-moi. Pour chaque insigne rapporté, vous recevrez notre marque d\'héroïsme - la marque de valeur de l\'Aube d\'argent.nnAccomplissez votre destin, <classe> - rejoignez le combat dès aujourd\'hui !‡‡',
  }
},
[5504] = {
  {
    'Dragonas da Aurora‡Оплечья Рассвета‡Mäntel der Dämmerung‡여명의 장막‡Mantos del Alba‡Mantos del Alba‡Les mantelets de l\'Aube‡黎明衬肩‡黎明披肩',
    nil,
    'Leve 10 Símbolos de Bravura da Aurora Argêntea à Intendente Hasana, no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите 10 знаков доблести Серебряного Рассвета интенданту Хасане в Бастион.‡Bringt 10 Ehrenmarken der Argentumdämmerung zu Rüstmeister Hasana ins Bollwerk in den westlichen Pestländern.‡서부 역병지대의 보루에 있는 병참장교 하사나에게 은빛 여명회 명예 휘장 10개를 가져가야 합니다.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Hasana en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Hasana en El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter 10 Marques de valeur de l\'Aube d\'argent au Quartier-maître Hasana à la Barricade, dans les Maleterres de l\'ouest‡把10个银色黎明勇气勋章交给西瘟疫之地亡灵壁垒的银色黎明军需官哈萨娜。‡把10個銀色黎明勇氣勳章交給西瘟疫之地亡靈壁壘的銀色黎明軍需官哈薩娜。',
  }
},
[5505] = {
  {
    'A chave para Scolomântia‡Ключ от Некроситета‡Der Schlüssel zur Scholomance‡스칼로맨스로 가는 열쇠‡La llave de Scholomance‡La llave de Scholomance‡La clé de Scholomance‡通灵学院的钥匙‡通靈學院的鑰匙',
    nil,
    'Bem, <name>, aqui está: a chave-mestra completa. Tenho certeza absoluta de que essa chave vai permitir que você entre nos confins da Scolomântia. Mas só tem um jeito de saber se ela funciona. Meu conselho: nem perca tempo com testes.nnBoa sorte, grande herói. Que você continue a emanar luz na escuridão.‡Ну, вот, готово, Август – это ключ от Некроситета. Я не сомеваюсь, что он позволит тебе проникнуть в пределы школы. Впрочем, есть лишь один способ узнать наверняка. И не теряй времени даром.nnУдачи тебе, герой. Да рассеют твои победы мрак!‡Tja, da ist er, <Name>, der fertige Skelettschlüssel. Ich bin eigentlich absolut sicher, dass dieser Schlüssel Euch Zutritt zur Scholomance verschaffen wird. Es gibt aber nur eine Möglichkeit, um absolut sicher zu sein, dass er wirklich funktioniert. Verschwendet keine Zeit darauf, es auszuprobieren, sage ich.nnViel Glück. Möget Ihr auch weiterhin Licht in die Dunkelheit bringen!‡음, 완성된 해골 열쇠를 가지고 도착했군요. 이거라면 분명 스칼로맨서 안으로 들어갈 수 있을 거라고 확신합니다. 하지만 열쇠가 제대로 작동하는지 확인하려면 직접 해보는 수밖에 없습니다. 시간을 낭비하지 마시기 바랍니다.nn행운을 빕니다, 영웅이여. 어둠 속에서 한 줄기 빛이 되기를!‡Bien, aquí la tienes <nombre>, la Llave esqueleto. Estoy tan seguro como puedo de que con esta llave podrás adentrarte en los confines de Scholomance. Pero solo hay un modo de asegurarse por completo. No pierdas tiempo intentándolo, te lo aconsejo.nnBuena suerte, poderoso héroe. ¡Que sigas llevando la Luz a las tinieblas!‡‡Et bien voilà, <nom> - la Clé squelette terminée. Je suis aussi certain que possible que cette clé vous permettra d\'entrer dans les confins de Scholomance. Toutefois il n\'y a qu\'un moyen de vérifier son efficacité. Ne perdez pas de temps et essayez-la, c\'est ce que je dis.nnBonne chance, puissant héros. Puissiez-vous continuer à apporter la lumière dans les ténèbres !‡‡',
  }
},
[5507] = {
  {
    'Dragonas da Aurora‡Оплечья Рассвета‡Mäntel der Dämmerung‡여명의 장막‡Mantos del Alba‡Mantos del Alba‡Les mantelets de l\'aube‡黎明衬肩‡黎明披肩',
    nil,
    'Leve 10 Símbolos de Bravura da Aurora Argêntea ao Intendente Centelhuz, no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите 10 знаков доблести Серебряного Рассвета интенданту Искре Света в Лагерь Промозглого Ветра.‡Bringt 10 Ehrenmarken der Argentumdämmerung zu Rüstmeister Funkellicht im Zugwindlager in den westlichen Pestländern.‡서부 역병지대의 서리바람 야영지에 있는 병참장교 라이트스파크에게 은빛 여명회 명예 휘장 10개를 가져가야 합니다.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Destello de Luz en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Chispillo en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter 10 Marques de valeur de l\'Aube d\'argent au quartier-maître Feuzopoudre au camp du Noroît, dans les Maleterres de l\'ouest.‡把10个银色黎明勇气勋章交给西瘟疫之地冰风营地的银色黎明军需官莱斯巴克。‡把10個銀色黎明勇氣勳章交給西瘟疫之地冰風營地的銀色黎明軍需官萊斯巴克。',
  }
},
[5508] = {
  {
    'Pedra do Flagelo do Corruptor‡Камни осквернителей Плети‡Geißelsteine des Verderbers‡타락자의 스컬지석‡Piedras de la Plaga del corruptor‡Piedras de la Plaga del corruptor‡Pierres du Fléau des corrupteurs‡堕落者的天灾石‡墮落者的天譴石',
    nil,
    'As Pedras do Flagelo do Corruptor são a insígnia dos lordes supremos do Flagelo. Os seres mais poderosos, que ocupam posições de autoridade no Flagelo, vão sempre envergar uma dessas. A morte de uma dessas criaturas malignas é sempre um passo adiante para a causa da Aurora Argêntea, e de todas as boas causasnnEm nome da Aurora Argêntea, eu lhe concederei um símbolo de bravura para cada insígnia dessas que você trouxer. Tenha cuidado ao tentar conseguir a sua, <name>, não subestime criaturas tão poderosas.‡Камень Плети Осквернителей – знак различия предводителей Плети. Их всегда можно найти у наиболее могучих тварей. Конечно, для этого придется их убить, тем самым способствуя делу Серебряного Рассвета и добра вообще!nnОт имени Серебряного Рассвета я вручу тебе по знаку доблести за каждый из этих знаков. Только соблюдай осторожность, Мард – с этими тварями шутки плохи.‡Der Geißelstein des Verderbers ist die Insignie der Oberanführer der Geißel. Ein mächtiges Wesen, das eine Autoritätsposition über der Geißel innehat, wird immer einen besitzen. Eine solch bösartige Kreatur zu erschlagen, würde die Sache der Argentumdämmerung und alle guten Zwecke sicherlich voranbringen!nnIm Namen der Argentumdämmerung werde ich Euch eine Ehrenmarke im Tausch für jeweils eine dieser Insignien geben. Seid vorsichtig, wenn Ihr diese Insignien holt, <Name>... mit solch mächtigen Wesen ist nicht zu spaßen.‡타락자의 스컬지석은 스컬지 우두머리들의 표장이지. 스컬지를 다스리는 직위를 가진 강력한 언데드라면 항상 하나씩 지니고 있다네. 그런 사악한 생물을 처치하는 것은 틀림없이 은빛 여명회의 대의와 모든 선한 대의의 실현을 앞당기게 될 것이야!nn은빛 여명회를 대신해 자네에게 이 표장 중 하나를 명예 휘장 하나와 교환해 주도록 하겠네. 그토록 강력한 존재들에게 함부로 맞서는 게 쉽지는 않을 거야. 이 표장을 얻기 위해서는 더 주의를 기울여야 해.‡La Piedra de la Plaga de un corruptor es la insignia de los Señores Supremos de la Plaga. Unos seres poderosos que disfrutan de una posición de autoridad en la Plaga. Siempre llevan una. Matar a esas criaturas tan malévolas ayudaría sin duda a la causa del Alba Argenta... ¡y a todas las buenas causas del mundo!nnDe parte del Alba Argenta, te daré una muestra de valor a cambio de una sola de estas insignias. Sé prudente cuando quieras hacerte con una, <nombre>, los seres que las poseen son poderosos.‡‡Une Pierre du Fléau des Corrupteurs est l\'insigne des Seigneurs du Fléau. Tout être puissant occupant une position d\'autorité au sein du Fléau en possède une. Détruire l\'une de ces créatures malfaisantes ferait sans doute avancer la cause de l\'Aube d\'argent, et toutes les bonnes causes !nnAu nom de l\'Aube d\'argent, je vous remettrai une marque de valeur en échange de l\'un de ces insignes. Soyez prudent dans votre quête, <nom> - on ne plaisante pas avec des êtres d\'une telle puissance.‡堕落者的天灾石是天灾军团将领的标志，那些统御大量部队的将领总是会随身携带者一块这样的徽记。如果有人能杀掉如此强大可怕的敌人，这对于银色黎明和我们的正义事业来说都是非常有利的！nn如果你能拿来一块这样的天灾石，银色黎明将会给你颁发一枚勇气勋章，以表彰你在于天灾军团的战争中做出的贡献！不过你要小心，<name>——你要面对的绝非一般的敌人。‡',
  }
},
[5509] = {
  {
    'Pedra do Flagelo do Invasor‡Камни захватчиков Плети‡Geißelsteine des Eindringlings‡침입자의 스컬지석‡Piedras de la Plaga del invasor‡Piedras de la Plaga del invasor‡Pierres du Fléau des envahisseurs‡侵略者的天灾石‡侵略者的天譴石',
    nil,
    'As Pedras do Flagelo do Invasor são a insígnia das tropas de elite do Flagelo. Costumam ser encontradas com os mais fortes das tropas que ficam estacionadas nas Terras Pestilentas. Matar uma criatura dessas é um grande desafio e um feito que deve ser reconhecido com uma comenda por derrotar o mal.nnA Aurora Argêntea oferece um símbolo de bravura em troca de dez insígnias dessas. Traga-as para mim que eu lhe concederei a justa recompensa.‡Камни Плети Захватчиков – знаки различия элитных войск Плети. Порой их можно найти у сильных бойцов в Чумных землях. Убить таких бойцов – настоящий подвиг, который должно совершать во имя борьбы со злом.nnСеребряный Рассвет вручает знак доблести в обмен на десять таких камней. Принеси их мне, и непременно получишь достойную награду.‡Der Geißelstein des Eindringlings ist die Insignie der Elitetruppen der Geißel. Man findet sie manchmal bei den stärkeren Truppen, die in den Pestländern stationiert sind. Das Erschlagen einer solchen Kreatur ist wahrlich eine Herausforderung, aber eine, die jemand, der sich den Sieg über das Böse auf die Fahne geschrieben hat, mit Freude erfüllen sollte.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zehn dieser Insignien. Bringt sie mir und ich werde sicherstellen, dass Ihr Eure gerechte Belohnung erhaltet.‡침입자의 스컬지석은 스컬지의 정예 군단이 지니는 표장이네. 역병지대에 배치된 부대들 중에서도 보다 강한 녀석들에게서 종종 찾을 수 있다네. 사실 그러한 생물을 처치하는 것이 쉽지 않지만, 악의 처단이라는 임무를 마음에 새기며 즐겁게 전투에 임해야 하네.nn은빛 여명회에서는 현재 이 표장 10개를 가져오는 이에게 명예 휘장 하나를 지급하고 있지. 이곳으로 내게 그 표장들을 가져오면 자네가 마땅히 받아야 할 보상을 반드시 지급하도록 하겠네.‡La Piedra de la Plaga de un invasor es la insignia de las tropas de élite de la Plaga. A veces se encuentran en los soldados más fuertes, los que están en las Tierras de la Peste. Matar a uno de ellos es un desafío, pero es uno que se ve compensado por ser una oportunidad para derrotar al mal.nnEl Alba Argenta ofrece una muestra de valor a cambio de diez de estas insignias. Tráemelas y yo me aseguraré de que recibas tu justa recompensa.‡‡Une pierre de Fléau des envahisseurs est l\'insigne des troupes d\'élite du Fléau. On les trouve parfois sur les soldats les plus aguerris stationnés dans les Maleterres. Abattre une telle créature est sans conteste un défi, mais un défi bien agréable pour ceux qui ont accepté notre brevet pour combattre le mal.nnL\'Aube d\'argent offre actuellement une marque de valeur en échange de dix de ces insignes. Apportez-les-moi, et je ferai en sorte que vous receviez votre juste récompense.‡侵略者的天灾石是天灾军团精英部队的象征，通常是由那些部署在瘟疫之地的主力部队中的士兵携带的。斩杀这样的敌人对你来说是一个挑战，但是你也会因此得到丰厚的奖赏。nn如果你能拿来十块这样的天灾石，银色黎明就将给你颁发一枚勇气勋章。‡',
  }
},
[5510] = {
  {
    'Pedra do Flagelo do Lacaio‡Камни приспешников плети‡Geißelsteine des Dieners‡앞잡이의 스컬지석‡Piedras de la Plaga del esbirro‡Piedras de la Plaga del esbirro‡Pierres du Fléau des serviteurs‡爪牙的天灾石‡爪牙的天譴石',
    nil,
    'As pedras do Flagelo do Lacaio são a insígnia dos integrantes do Flagelo. Costumam ser encontradas com os mais fracos das tropas que ficam estacionadas nas Terras Pestilentas, embora o termo "mais fracos" não deva ser considerado fora de contexto. Onde quer que esteja, o Flagelo nunca deve ser subestimado.nnA Aurora Argêntea oferece um símbolo de bravura em troca de vinte insígnias, uma troca que faço com prazer, desde que você tenha conquistado pedras do Flagelo suficientes.‡Камень Плети Осквернителей – знак различия войск Плети. Такие знаки обычно можно найти у более слабых тварей низшего ранга. Однако характеристика "более слабый" едва ли уместна, когда речь идет о Плети. Этих тварей никогда нельзя недооценивать!nnОт имени Серебряного Рассвета я вручу тебе по знаку доблести за каждый из этих знаков – с огромным удовольствием.‡Der Geißelstein des Dieners ist die Insignie des Fußvolkes der Geißel. Man findet sie manchmal bei den schwächeren Truppen, die in den Pestländern stationiert sind, obwohl der Begriff \'schwächere\' natürlich relativ betrachtet werden muss. Die Geißel sollte, ganz gleich wo sie sich befindet, niemals unterschätzt werden.nnDie Argentumdämmerung bietet derzeit eine Ehrenmarke im Tausch für zwanzig dieser Insignien - ein Tausch, den ich freudig ausführe, vorausgesetzt, Ihr habt genug Geißelsteine!‡앞잡이의 스컬지석은 스컬지 사병들의 표장이라네. 이 표장은 역병지대에 배치된 부대들 중 좀 더 약한 무리들에게서 가끔 찾을 수 있지. 하지만 좀 약하다고 해서 녀석들을 얕잡아봐서는 절대 안 되네. 스컬지는 어디에 있든지 결코 과소평가해서는 안 될 상대라네.nn현재 은빛 여명회에서는 이 표장 20개를 가져오는 이에게 명예 휘장 하나를 지급하고 있네. 스컬지석을 충분히 모아 오면 기꺼이 명예 휘장과 교환해 주도록 하겠네.‡Una Piedra de la Plaga de un esbirro es la insignia de las tropas de la Plaga. A veces se encuentran en los más débiles de sus filas, las que están en las Tierras de la Peste... aunque el término "débiles" debe por supuesto, interpretarse en su contexto. Los miembros de la Plaga, estén donde estén, no deben ser subestimados.nnEl Alba Argenta ofrece una muestra de valor a cambio de veinte de esas insignias... Es un intercambio que me encantaría hacer, ¡siempre que tengas suficientes Piedras de la Plaga!‡‡Une Pierre du Fléau des serviteurs est l\'insigne du rang et de la classe du Fléau. Elles se trouvent parfois sur le plus faible de leurs troupes positionnées dans les Maleterres, bien que le terme "faible" mérite d\'être replacé dans son contexte.Les membres du Fléau, où qu\'ils soient, ne devraient jamais être sous-estimés.nnL\'Aube d\'argent offre à présent une marque de valeur pour 20 de ces insignes - un échange que je serai heureux d\'effectuer si vous avez amassé suffisamment de pierres du Fléau.‡爪牙的天灾石是天灾军团的身份象征，通常是由那些部署在瘟疫之地的、较为弱小的士兵所携带的。我所说的“较为弱小”是个相对的概念，无论天灾军团出现在哪里，他们都是一个不可轻视的威胁。nn如果你能拿来二十个这样的天灾石，银色黎明将会给你颁发一枚勇气勋章，以此表彰你在于天灾军团的战争中做出的贡献！‡',
  }
},
[5511] = {
  {
    'A chave para Scolomântia‡Ключ от Некроситета‡Der Schlüssel zur Scholomance‡스칼로맨스로 가는 열쇠‡La llave de Scholomance‡La llave de Scholomance‡La clé de Scholomance‡通灵学院的钥匙‡通靈學院的鑰匙',
    nil,
    '‡Ну, вот, готово, Дисскомаг – это ключ от Некроситета. Я не сомеваюсь, что он позволит тебе проникнуть в пределы школы. Впрочем, есть лишь один способ узнать наверняка. И не теряй времени даром.nnУдачи тебе, герой. Разгроми Некроситет и добейся заслуженной славы!‡Tja, da ist er, <Name>, der fertige Skelettschlüssel. Ich bin eigentlich absolut sicher, dass dieser Schlüssel Euch Zutritt zur Scholomance verschaffen wird. Es gibt aber nur eine Möglichkeit, um absolut sicher zu sein, dass er wirklich funktioniert. Verschwendet keine Zeit darauf, es auszuprobieren, sage ich.nnViel Glück. Mögen Eure Siege Euch auch weiterhin Ruhm und Macht bringen, während Ihr die Scholomance in Schutt und Asche legt!‡음, 완성된 해골 열쇠를 가지고 도착했군. 이거라면 분명 스칼로맨서 안으로 들어갈 수 있을 거라고 확신하네. 하지만 열쇠가 제대로 작동하는지 확인하려면 직접 해보는 수밖에 없으니 시간을 낭비하지 말게.nn행운을 비네, 영웅이여. 명예와 용기의 힘으로 스칼로맨스에게 응징을!‡Bien, aquí estás, <nombre>. Y has completado la llave esqueleto. No tengo dudas de que esta llave te permitirá acceder a los confines de Scholomance. Solo hay una forma de asegurarse por completo de que funcione. Yo diría que no pierdas tiempo en probarla.nnBuena suerte, poderoso héroe. ¡Que tus victorias continúen otorgándote fama y poder mientras destruyes Scholomance!‡‡Eh bien voilà, <nom> - la Clé squelette terminée. Je suis aussi certain que possible que cette clé vous permettra d\'entrer dans les confins de Scholomance. Toutefois il n\'y a qu\'un moyen de vérifier son efficacité. Ne perdez pas de temps et essayez-la, c\'est ce que je dis.nnBonne chance, puissant héros. Puissent vos victoires continuer de vous apporter gloire et pouvoir alors que vous semez la désolation à Scholomance !‡‡',
  }
},
[5513] = {
  {
    'Dragonas da Aurora‡Оплечья Рассвета‡Mäntel der Dämmerung‡여명의 장막‡Mantos del Alba‡Mantos del Alba‡Les mantelets de l\'aube‡黎明衬肩‡黎明披肩',
    nil,
    'Leve 10 Símbolos de Bravura da Aurora Argêntea à Intendente Cerraculatra, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Принесите 10 знаков доблести Серебряного Рассвета интенданту Затвор в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 10 Ehrenmarken der Argentumdämmerung zu Rüstmeister Knackschloss an der Kapelle des hoffnungsvollen Lichts, östliche Pestländer.‡동부 역병지대의 희망의 빛 예배당에 있는 병참장교 미란다 브리치락에게 은빛 여명회 명예 휘장 10개를 가져가야 합니다.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Lleva 10 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Apporter 10 Marques de valeur de l\'Aube d\'argent à l\'intendante Coinceculasse, à la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est.‡把10个银色黎明勇气勋章交给东瘟疫之地圣光之愿礼拜堂的军需官米兰达·布利洛克。‡把10個銀色黎明勇氣勳章交給東瘟疫之地聖光之願禮拜堂的軍需官米蘭達·布利洛克。',
  }
},
[5514] = {
  {
    'Um molde que vale ouro‡Форма денег стоит‡Sold reimt sich auf...‡거푸집과 뼛조각‡Molde rima con... ¿oro?‡Molde rima con... ¿oro?‡Moisissure rime avec…‡昂贵的模具‡昂貴的模具',
    nil,
    'Leve os Fragmentos de Ossos Imbuídos e 15 moedas de ouro para Rugov A. Massoaço em Geringontzan.‡Отнесите Кринкелю Сталлинну из Прибамбасска прочные фрагменты скелета и 15 золотых монет.‡Bringt die magieerfüllten Skelettfragmente sowie 15 Goldstücke zu Krinkle Goldstahl in Gadgetzan.‡가젯잔에 있는 크린클 굿스틸에게 15골드와 함께 마력 깃든 뼛조각을 가져가야 합니다.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Apporter les Fragments de squelette imprégnés et 15 pièces d\'or à Froisse Bonnacier à Gadgetzan.‡把灌魔的骸骨碎片和15枚金币交给加基森的克林科·古德斯迪尔。‡把灌魔的骷髏碎片和15枚金幣交給加基森的克林科·古德斯迪爾。',
  }
},
[5515] = {
  {
    'Saco de Horrores de Krastinov‡Мешок ужасов Крастинова‡Krastinovs Tasche der Schrecken‡소름끼치는 크라스티노브의 가방‡Bolsa de los horrores de Krastinov‡Bolsa de los horrores de Krastinov‡Sac des horreurs de Krastinov‡卡斯迪诺夫的恐惧之袋‡卡斯迪諾夫的恐懼之袋',
    nil,
    'Localize Janice Barov em Scolomântia e a destrua. Recupere o Saco de Horrores de Krastinov do cadáver dela. Entregue o saco a Eva Sarkhoff.‡Найдите в Некроситете Джандис Барову и уничтожьте ее. Заберите мешок ужасов Крастинова. Отнесите мешок Еве Саркофф.‡Sucht nach Jandice Barov in der Scholomance und vernichtet sie. Entnehmt ihrer Leiche Krastinovs Tasche der Schrecken. Bringt die Tasche zu Eva Sarkhoff.‡스칼로맨스에서 잔다이스 바로브를 찾아 처치해야 합니다. 그녀의 시체에서 소름끼치는 크라스티노브의 가방을 찾은 후 에바 사크호프에게 가져가야 합니다.‡Localiza a Jandice Barov en Scholomance y destrúyela. En su cadáver encontrarás la Bolsa de los horrores de Krastinov. Devuélvele la bolsa a Eva Sarkhoff.‡Localiza a Jandice Barov en Scholomance y destrúyela. En su cadáver encontrarás la Bolsa de los horrores de Krastinov. Devuélvele la bolsa a Eva Sarkhoff.‡Trouver Jandice Barov dans Scholomance et la tuer. Sur son cadavre, récupérer le Sac des horreurs de Krastinov. Rapporter le sac à Eva Sarkhoff.‡在通灵学院找到詹迪斯·巴罗夫并打败她。从她的尸体上找到卡斯迪诺夫的恐惧之袋，然后将其交给艾瓦·萨克霍夫。‡在通靈學院找到詹迪斯·巴羅夫並打敗她。從她的屍體上找到卡斯迪諾夫的恐懼之袋，然後將其交給艾瓦·薩克霍夫。',
  }
},
[5517] = {
  {
    'Dragonas cromáticas da Aurora‡Многоцветная драгоценность Рассвета‡Der Chromatische Mantel der Dämmerung‡여명의 오색 장막‡Manto del Alba cromático‡Manto del Alba cromático‡Le mantelet de l\'Aube chromatique‡多彩黎明衬肩‡炫彩黎明披肩',
    nil,
    'Leve 25 Símbolos de Bravura da Aurora Argêntea à Intendente Cerraculatra, na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Принесите 25 знаков доблести Серебряного Рассвета интенданту Затвор в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt 25 Ehrenmarken der Argentumdämmerung zu Rüstmeister Knackschloss an der Kapelle des hoffnungsvollen Lichts, östliche Pestländer.‡동부 역병지대의 희망의 빛 예배당에 있는 병참장교 미란다 브리치락에게 은빛 여명회 명예 휘장 25개를 가져가야 합니다.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Cerrobrecha a la Capilla de la Esperanza de la Luz de las Tierras de la Peste del Este.‡Apporter 25 Marques de valeur de l\'Aube d\'argent à l\'intendante Coinceculasse, à la chapelle de l\'Espoir de Lumière, dans les Maleterres de l\'est.‡把25个银色黎明勇气勋章交给东瘟疫之地圣光之愿礼拜堂的银色黎明军需官米兰达·布利洛克。‡把25個銀色黎明勇氣勳章交給東瘟疫之地聖光之願禮拜堂的銀色黎明軍需官米蘭達·布利洛克。',
  }
},
[5518] = {
  {
    'O traje de ogro Gordok‡Броня огров Гордока‡Der Ogeranzug der Gordok‡고르독 오우거 위장복‡El traje de ogro Gordok‡El disfraz de ogro Gordok‡La tenue d\'ogre gordok‡戈多克食人魔装‡戈多克巨魔裝',
    nil,
    'Leve 4 Peças de Runatrama, 8 Couros Rústicos, 2 Fios Rúnicos e Tanino Ôgrico para Fiapo Agulhacerta. Atualmente, ele está acorrentado dentro da ala Gordok do Gládio Cruel.‡Принесите 4 рулона рунической ткани, 8 кусков грубой кожи, 2 мотка рунической нити и огрскую дубильную кислоту Уззлу Наперстяку. Он прикован в секторе Гордока в Забытом Городе.‡Bringt 4 Runenstoffballen, 8 Stücke unverwüstliches Leder, 2 Runenfaden und etwas Ogergerbemittel zu Knot Zwingschraub. Momentan ist er im Gordokflügel von Düsterbruch angekettet.‡룬무늬 두루마리 4개, 튼튼한 가죽 8장, 룬문자 실타래 2개, 그리고 오우거 타닌을 노트 팀블잭에게 가져가야 합니다. 노트 팀블잭은 혈투의 전장에 있는 고르독일족 은신처 구석에 족쇄에 묶여 있습니다.‡Lleva 4 madejas de paño rúnico, 8 cueros bastos, 2 hilos rúnicos y tanino de ogro a Knot Llavededo. Actualmente está encadenado en el interior del ala Gordok de La Masacre.‡Lleva 4 madejas de paño rúnico, 8 cueros bastos, 2 hilos rúnicos y tanino de ogro a Knot Llavededo. Actualmente está encadenado en el interior del ala Gordok de La Masacre.‡Apportez 4 Rouleaux d\'étoffe runique, 8 Cuirs robustes, 2 Fils runiques et du Tanin ogre à Noué Dédodevie. Il est actuellement enchaîné dans l\'aile gordok de Hache-tripes.‡把4份符文布卷、8块硬甲皮、2卷符文线和一份食人魔鞣酸交给诺特·希姆加克。他现在被拴在厄运之槌的戈多克食人魔那边。‡把4份符文布卷、8塊硬甲皮、2卷符文線和一份巨魔鞣酸交給諾特·希姆加克。他現在被拴在厄運之槌的戈多克巨魔那邊。',
  }
},
[5519] = {
  {
    'O traje de ogro Gordok‡Броня огров Гордока‡Der Ogeranzug der Gordok‡고르독 오우거 위장복‡El traje de ogro Gordok‡El disfraz de ogro Gordok‡La tenue d\'ogre gordok‡戈多克食人魔装‡戈多克巨魔裝',
    nil,
    '‡Вам снова нужна личина, да? Ну, мне сейчас не к спеху – принесите мне то же, что и в прошлый раз, и я изготовлю вам еще одну огрскую личину.‡Ihr braucht einen weiteren Ogeranzug, richtig? Da ich wohl so schnell nirgendwo hingehe - bringt mir einfach die gleichen Sachen, um die ich Euch zuvor gebeten habe und ich fertige Euch einen weiteren Ogeranzug an.‡‡Necesitas otro traje, ¿verdad? Pues mira, como parece que no voy a ir a ninguna parte, tráeme las cosas que te pedí la vez anterior y te haré otro traje de ogro.‡‡Besoin d’une autre tenue, hein ? Bon, je ne vais nulle part, de toute façon. Amenez-moi les mêmes éléments que l’autre fois, et je vous en ferai une autre.‡‡',
  }
},
[5521] = {
  {
    'Dragonas cromáticas da Aurora‡Многоцветная драгоценность Рассвета‡Der Chromatische Mantel der Dämmerung‡여명의 오색 장막‡Manto del Alba cromático‡Manto del Alba cromático‡Le mantelet de l\'Aube chromatique‡多彩黎明衬肩‡炫彩黎明披肩',
    nil,
    'Leve 25 Símbolos de Bravura da Aurora Argêntea ao Intendente Centelhuz, no Acampamento Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите 25 знаков доблести Серебряного Рассвета интенданту Искре Света в Лагерь Промозглого Ветра.‡Bringt 25 Ehrenmarken der Argentumdämmerung zu Rüstmeister Funkellicht im Zugwindlager in den westlichen Pestländern.‡서부 역병지대의 서리바람 거점에 있는 병참장교 라이트스파크에게 은빛 여명회 명예 휘장 25개를 가져가야 합니다.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Destello de Luz en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Chispillo en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter 25 Marques de valeur de l\'Aube d\'argent au quartier-maître Feuzopoudre au camp du Noroît, dans les Maleterres de l\'ouest.‡把25个银色黎明勇气勋章交给西瘟疫之地冰风营地的银色黎明军需官莱斯巴克。‡把25個銀色黎明勇氣勳章交給西瘟疫之地冰風營地的銀色黎明軍需官萊斯巴克。',
  }
},
[5522] = {
  {
    'Leonid Bartolomeu‡Леонид Барталомей‡Leonidas Bartholomäus‡리어니드 바돌로매‡Leonid Barthalomew‡Leonid Barthalomew‡Leonid Barthalomew‡莱尼德·巴萨罗梅‡萊尼德·巴薩羅梅',
    nil,
    'Leve os Ovos Congelados para Leonid Bartolomeu, nas Terras Pestilentas Orientais.‡Принесите охлажденные яйца Леониду Бартоломею в Восточные Чумные земли.‡Bringt die gefrorenen Eier zu Leonidas Bartholomäus in den östlichen Pestländern.‡동부 역병지대에 있는 리어니드 바돌로매에게 얼어붙은 알을 가져가야 합니다.‡Lleva los huevos congelados a Leonid Barthalomew a las Tierras de la Peste del Este.‡Lleva los huevos congelados a Leonid Barthalomew a las Tierras de la Peste del Este.‡Apporter les Oeufs congelés à Leonid Barthalomew dans les Maleterres de l\'est.‡把冰冻的龙蛋交给东瘟疫之地的莱尼德·巴萨罗梅。‡把冰凍的龍蛋交給東瘟疫之地的萊尼德·巴薩羅梅。',
  }
},
[5524] = {
  {
    'Dragonas cromáticas da Aurora‡Многоцветная драгоценность Рассвета‡Der Chromatische Mantel der Dämmerung‡여명의 오색 장막‡Manto del Alba cromático‡Manto del Alba cromático‡Le mantelet de l\'Aube chromatique‡多彩黎明衬肩‡炫彩黎明披肩',
    nil,
    'Leve 25 Símbolos de Bravura da Aurora Argêntea à Intendente Hasana, no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите 25 знаков доблести Серебряного Рассвета интенданту Хасане в Бастион, что в Западных Чумных землях.‡Bringt 25 Ehrenmarken der Argentumdämmerung zu Rüstmeister Hasana ins Bollwerk in den westlichen Pestländern.‡서부 역병지대의 보루에 있는 병참장교 하사나에게 은빛 여명회 명예 휘장 25개를 가져가야 합니다.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Hasana en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva 25 muestras de valor de El Alba Argenta al intendente Hasana en El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter 25 Marques de valeur de l\'Aube d\'argent au Quartier-maître Hasana à la Barricade, dans les Maleterres de l\'ouest.‡把25个银色黎明勇气勋章交给西瘟疫之地亡灵壁垒的银色黎明军银色黎明军需官哈萨娜。‡把25個銀色黎明勇氣勳章交給西瘟疫之地亡靈壁壘的銀色黎明軍銀色黎明軍需官哈薩娜。',
  }
},
[5525] = {
  {
    'Liberdade ainda que tardia‡Освободите Нотта!‡Befreit Knot!‡노트 구출 대작전‡¡Libera a Knot!‡¡Libera a Knot!‡Libérez Noué !‡逃出生天！‡逃出生天!',
    nil,
    'É chamada de chave dos grilhões dos Gordok. Bom, pelo menos é esse o nome que essas coisinhas fofas usam. Acho que qualquer um dos ogros pode ter a sua, mas é mais provável que os guardas tenham um exemplar...nnPeraí, onde é que eu estou com a cabeça? Já está com você, não é mesmo? Está aqui?‡Эта вещь называется "ключ от оков Гордока" – по крайней мере, так называют его эти "остроумцы". Думаю, такой ключ может быть у любого из огров, но у кого именно – сказать не возьмусь. Есть вероятность, что такие ключи имеются у стражников…nnНо о чем я говорю? Он у вас есть, да? Он при вас?!‡Sie nennen ihn den Gordokfesselschlüssel - Naja, zumindest tun es diese "Tonnenweise Spaß auf zwei Beinen"-Oger. Ich denke einer der Oger müsste ihn haben, leider weiß ich nicht genau welcher. Möglicherweise ist die Chance größer, dass einer der Wachen ihn hat...nnWas erzähle ich da? - sicher habt Ihr ihn schon, oder? Ist es der da??!‡그건 고르독 족쇄 열쇠라고 하는 물건이지. 이 오우거 얼간이들이 그렇게 부르더군. 이곳 오우거들이라면 누구나 지니고 있을 텐데, 어떤 오우거 녀석들이 지니고 있는지는 모르겠단 말이야. 경비병들이라면 갖고 있을 확률이 더 높겠지...nn아니, 내가 지금 뭔 소리 하는 거야. 당신 벌써 그 열쇠 갖고 있지?! 그게 바로 그 열쇠야?!‡Se llama llave de los grilletes de Gordok... bueno, así es como la llaman esos graciosillos. Creo que podría tenerla cualquiera de los ogros, pero no sé cuáles en concreto. Probablemente podrían tenerla los guardias...nn¿Pero qué estoy diciendo? ¡Si tú ya la tienes! ¡¿No?! ¡¿¿No es eso que tienes ahí??!‡‡C’est la Clé des menottes gordok – en tous cas, c’est comme ça que l’appellent ces patapoufs. Je ne sais pas qui l’a. Ils le peuvent tous, j’imagine. Les gardes, sans doute…nnMais qu’est-ce que je raconte ? Vous l’avez déjà, n’est-ce pas ? Vous l’avez sur vous ?‡‡',
  }
},
[5526] = {
  {
    'Pedaços de Vinhavil‡Осколки сквернита‡Die Splitter der Teufelsranke‡악령덩굴 조각‡Fragmentos de gangrevid‡Fragmentos de gangrevid‡Fragment de la Gangrevigne‡魔藤碎片‡魔藤裂片',
    nil,
    'Encontre a Vinhavil no Gládio Cruel e obtenha uma lasca dela. É bem provável que você só consiga encontrar uma depois da derrota de Azzin, o Selvamorfo. Use o Relicário da Pureza para selar a lasca com segurança e leve-a de volta para Ravine Saturna, no Refúgio Noturno, que fica na Clareira da Lua.‡Отыщите сквернит в Забытом Городе и подберите его осколок. Есть шанс, что вам удастся его добыть, только убив Алззина Вертоградаря. Крепко заприте осколок в реликварии чистоты, затем верните его Рабину Сатурне в Ночную Гавань на Лунной поляне.‡Sucht die Teufelsranke in Düsterbruch und nehmt einen Teufelsrankensplitter mit Euch. Aller Wahrscheinlichkeit nach, werdet Ihr Alzzin den Wildformer töten müssen, um an die Teufelsranke zu gelangen. Benutzt das Requiliar der Reinheit, um darin den Splitter sicher zu versiegeln, und bringt das versiegelte Reliquiar zu Rabine Saturna in Nachthafen, Mondlichtung.‡혈투의 전장에서 악령덩굴 조각을 채취하십시오. 칼날바람 알진을 물리쳐야만 얻을 수 있을 것입니다. 정화의 성물함에 단단히 봉인한 후, 달의 숲의 나이트헤이븐에 있는 라빈 사투르나에게 돌아가야 합니다.‡Encuentra gangrevid en La Masacre y coge un fragmento. Es probable que solo puedas conseguirlo si derrotas a Alzzin el Formaferal. Usa el relicario de Pureza para guardar el fragmento y llévaselo a Rabine Saturna a Amparo de la Noche, en Claro de la Luna.‡Encuentra gangrevid en La Masacre y coge un fragmento. Es probable que solo puedas conseguirlo si derrotas a Alzzin el Formaferal. Usa el relicario de Pureza para guardar el fragmento y llévaselo a Rabine Saturna a Amparo de la Noche, en Claro de la Luna.‡Trouvez la Gangrevigne à Hache-tripes et prenez-en un fragment. Il est probable que vous ne pourrez vous en emparer qu\'après la mort d\'Alzzin le Modeleur. Servez-vous du Reliquaire de Pureté pour conserver le fragment, et retournez à Reflet-de-Lune voir Rabine Saturna au village de Havrenuit.‡在厄运之槌中找到魔藤，然后从它上面采集一块碎片。只有干掉了奥兹恩之后，你才能进行采集工作。使用净化之匣安全地封印碎片，然后将其交给月光林地永夜港的拉比恩·萨图纳。‡在厄運之槌中找到魔藤，然後從它上面採集一塊裂片。只有幹掉了奧茲恩之後，你才能進行採集工作。使用淨化之匣安全地封印裂片，然後將其交給月光林地永夜港的拉比恩·薩圖納。',
  }
},
[5527] = {
  {
    'Relicário da Pureza‡Реликварий Чистоты‡Ein Reliquiar der Reinheit‡정화의 성물함‡Un relicario de Pureza‡Un relicario de Pureza‡Un reliquaire de pureté‡净化之匣‡淨化之匣',
    nil,
    'Viaje até Silithus e procure um Relicário da Pureza dentro das ruínas da Vila do Vento Sul. Se conseguir encontrá-lo, regresse com ele até Ravine Saturna, no Refúgio Noturno, que fica na Clareira da Lua.‡Отправляйтесь в Силитус и найдите реликварий чистоты в руинах деревни Южного Ветра. Если вам удастся его найти, возвращайтесь к Рабину Сатурне в Ночную Гавань на Лунной поляне.‡Reist nach Silithus und sucht in den Ruinen des Südwindpostens nach einem Reliquiar der Reinheit. Sollte Eure Suche Erfolg haben, kehrt zu Rabine Saturna in Nachthafen auf der Mondlichtung zurück.‡실리더스로 가서 마파람 마을 부근 유적지에 있을 정화의 성물함을 찾으면, 달의 숲의 나이트헤이븐에 있는 라빈 사투르나에게 돌아가야 합니다.‡Ve a Silithus a buscar un relicario de Pureza en las ruinas de la Aldea del Viento del Sur. Llévaselo a Rabine Saturna a Amparo de la Noche, en Claro de la Luna.‡Ve a Silithus a buscar un relicario de Pureza en las ruinas de la Aldea del Viento del Sur. Llévaselo a Rabine Saturna a Amparo de la Noche, en Claro de la Luna.‡Rendez-vous en Silithus et cherchez un Reliquaire de pureté dans les ruines du village de Sudevent. Si vous parvenez à le trouver, ramenez-le à Rabine Saturna à Havrenuit, Reflet-de-Lune.‡到希利苏斯的南风村去寻找净化之匣。然后将其交给月光林地永夜港的拉比恩·萨图纳。‡到希利蘇斯的南風村去尋找淨化之匣。然後將其交給月光林地永夜港的拉比恩·薩圖納。',
  }
},
[5528] = {
  {
    'O teste de sabor dos Gordok‡Лучшее пойло Гордока‡Der Gordokgeschmackstest‡고르독 술 맛보기‡La cata de los Gordok‡La cata de los Gordok‡La dégustation gordok‡戈多克好酒‡戈多克好酒',
    nil,
    'Como você é o dono do pedaço agora, vai provar de graça as minhas melhores cervejas! Elas levantam até defunto... e vão deixar você pra lá de Terralém! Essas são papa-fina mesmo, chefia. Dá uma provadinha e diga pro Kreeg o que você acha!‡Ну, ты теперь у нас большая шишка, так попробуй задаром моего лучшего пойла! Оно и сил добавляет, и голову кружит! Пей, пей, начальник – попробуй, сам увидишь!‡Ihr jetzt de\' Big Boss hier. Also kriegen freie Kostproben meiner besseren Gebräue! Diese Tränke werden Euch verstärken UND Euch Schädel weghauen! Das ist da\' guta Zeug, Chef... Ihr versuchen und dann Kreeg glauben!‡힉... 이제 당신 우리 대빵이니까 좀 괜찮은 술 하나 맛볼 수 있다! 힉... 이 술 마시면 기운 나고 기분도 아주 좋아진다! 힉... 이게 알짜배기 술이야, 왕... 한번 마시고 크리그에게 어떤지 말해줘... 힉!‡Ahora eres el jefe, ¡así consigues muestras gratis de mis mejores bebidas! ¡Te darán un buen subidón y un potente tirón! Son las buenas, jefe. ¡Prueba y dilo a Kreeg!‡‡V’z’êtes le grand patron maintenant, alors z’avez le droit de goûter mes alcools. Ils rendent fort ET font tourner la tête ! C’est d’la bonne, chef… essayez, vous pourrez l’dire à Kreeg !‡‡',
  }
},
[5529] = {
  {
    'Filhotes Pestilentos‡Зачумленные детеныши дракона‡Verseuchte Jungtiere‡역병 걸린 작은 새끼용‡Crías de dragón apestadas‡Crías de dragón apestadas‡Portée contaminée‡瘟疫之龙‡瘟疫之龍',
    nil,
    'Mate 20 Filhotes Pestilentos, depois fale novamente com Betina Bigozinco, na Capela Esperança da Luz.‡Убейте 20 зачумленных детенышей дракона, затем возвращайтесь к Бетине Биггльцинк в Часовню Последней Надежды.‡Tötet 20 verseuchte Jungtiere und kehrt dann zu Betina Moppelzink bei der Kapelle des hoffnungsvollen Lichts zurück.‡역병 걸린 작은 새끼용 20마리를 처치한 후 희망의 빛 예배당에 있는 베티나 비글징크에게 돌아가야 합니다.‡Mata a 20 crías de dragón apestadas y ve a ver a Betina Bigglezink a la Capilla de la Esperanza de la Luz.‡Mata a 20 crías de dragón apestadas y ve a ver a Betina Bigglezink a la Capilla de la Esperanza de la Luz.‡Tuer 20 Jeunes pestiférés, puis retourner auprès de Betina Bigglezink à la Chapelle de l\'Espoir de Lumière.‡杀掉20只瘟疫龙崽，然后向圣光之愿礼拜堂的贝蒂娜·比格辛克复命。‡殺掉20隻瘟疫幼龍，然後向聖光之願禮拜堂的貝蒂娜·比格辛克復命。',
  }
},
[5531] = {
  {
    'Betina Bigozinco‡Бетина Биггльцинк‡Betina Moppelzink‡베티나 비글징크‡Betina Bigglezink‡Betina Bigglezink‡Betina Bigglezink‡贝蒂娜·比格辛克‡貝蒂娜·比格辛克',
    nil,
    'Leve os Ovos Congelados para Betina Bigozinco.‡Принесите охлажденные яйца Бетине Биггльцинк.‡Bringt die gefrorenen Eier zu Betina Moppelzink.‡베티나 비글징크에게 얼어붙은 알을 가져가야 합니다.‡Lleva los huevos congelados a Betina Bigglezink, que está fuera.‡Lleva los huevos congelados a Betina Bigglezink.‡Apporter les Œufs congelés à Betina Bigglezink.‡将冰冻的龙蛋交给贝蒂娜·比格辛克。‡將冰凍的龍蛋交給貝蒂娜·比格辛克。',
  }
},
[5533] = {
  {
    'Scolomântia‡Некроситет‡Scholomance‡스칼로맨스‡Scholomance‡Scholomance‡Scholomance‡通灵学院‡通靈學院',
    nil,
    'Fale com o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Поговорите с алхимиком Арбингтоном с вершины Холодной Скалы, что в Западных Чумных землях.‡Sprecht mit Alchimist Arbington an der Zugwindspitze, westliche Pestländer.‡서부 역병지대의 서리바람 거점에 있는 연금술사 알빙턴과 대화해야 합니다.‡Habla con el alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Habla con el alquimista Arbington en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Parler à l\'alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l\'ouest.‡和西瘟疫之地冰风岗的化学家阿尔比顿谈一谈。‡和西瘟疫之地冰風崗的鍊金師阿爾比頓談話。',
  }
},
[5534] = {
  {
    'Equipamento "Sumido" de Kam\'arawn‡"Пропавшее"оборудование Ким\'джаеля‡Kim\'jaels \'fehlende\' Ausrüstung‡킴야엘의 "잃어버린" 물건‡El equipamiento "perdido" de Kim\'jael‡El equipamiento "perdido" de Kim\'jael‡L\'équipement "manquant" de Kim\'jael‡基姆加尔"丢失"的装备‡基姆加爾「丟失」的裝備',
    nil,
    'Encontre Essa Tal Runa que está com as nagas nas Ruínas de Eldarath e traga-a para Kam\'arawn, em Azshara.‡Найдите некую руну, которую хранят наги в руинах Эльдарата и принесите ее Ким\'джаелю в Азшару.‡Sucht, in den Ruinen von Eldarath irgendeine Rune, die die Naga in ihrem Besitz haben, und bringt sie Kim\'jael in Azshara.‡엘다라스 폐허에서 나가들이 가지고 있는 어떤 룬을 찾아 아즈샤라에 있는 킴야엘에게 가져가야 합니다.‡Encuentra una runa que los nagas guardan en las Ruinas de Eldarath y llévasela a Kim\'jael en Azshara.‡Encuentra una runa que los nagas guardan en las Ruinas de Eldarath y llévasela a Kim\'jael en Azshara.‡Trouver "une rune" détenue par les nagas dans les ruines d\'Eldarath et la rapporter à Kim\'jael, en Azshara.‡寻找埃达拉斯废墟中的纳迦携带的那些符石，然后把它们交给艾萨拉的基姆加尔。‡尋找埃達拉斯廢墟中的納迦攜帶的那些符石，然後把它們交給艾薩拉的基姆加爾。',
  }
},
[5535] = {
  {
    'Perturbação espiritual‡Духовное беспокойство‡Spirituelle Unruhe‡영혼의 동요‡Agitación espiritual‡Agitación espiritual‡Agitation spirituelle‡永不安息的灵魂‡無法安息的靈魂',
    nil,
    'Destrua 6 Aparições Altaneiras e 6 Subliches Altaneiros. Depois, fale com Loh\'atu em Azshara.‡Уничтожьте по 6 теней высокорожденных обоих полов и возвращайтесь к Ло\'хату в Азшару.‡Vernichtet 6 Erscheinungen einer Hochgeborenen und 6 Lichlinge eines Hochgeborenen, bevor Ihr zu Loh\'atu in Azshara zurückkehrt.‡명가의 유령 6명과 명가의 망령 6명을 처치한 후 아즈샤라에 있는 로아투에게 돌아가십시오.‡Destruye 6 apariciones Altonato y 6 exanimatos Altonato antes de volver junto a Loh\'atu en Azshara.‡Mata a 6 aparecidas Altonato y 6 exanimatos Altonato antes de volver junto a Loh\'atu en Azshara.‡Détruire 6 Apparitions de Bien-nés et 6 Jeunes liches bien-nées avant de retourner auprès de Loh\'atu en Azshara.‡杀掉6个上层精灵的幻影和6个上层精灵鬼巫，然后向艾萨拉的罗哈图复命。‡殺掉6個精靈貴族的亡魂和6個精靈貴族鬼巫，然後向艾薩拉的羅哈圖覆命。',
  }
},
[5536] = {
  {
    'Uma terra repleta de ódio‡Земли, полные ненависти‡Ein Land voller Hass‡증오로 가득 찬 땅‡Una tierra llena de odio‡Una tierra llena de odio‡Un pays plein de haine‡充满仇恨的土地‡充滿仇恨的土地',
    nil,
    'Mate 6 Sátiros Haldarr, 2 Trapaceiros Haldarr e 2 Devotos Vil Haldarr. Depois, fale novamente com Loh\'atu na fronteira do Vale Gris.‡Уничтожьте 6 сатиров, 2 плутов Халдарра и 2 скверноподданных из племени Халдарр и возвращайтесь к Ло\'хату к границе Ясеневого леса.‡Tötet 6 Satyrn der Haldarr, 2 Schwindler der Haldarr sowie 2 Teufelsanbeter der Haldarr und kehrt dann zu Loh\'atu an der Grenze zum Eschental zurück.‡할다르 사티로스 6명, 할다르 요술사 2명, 할다르 악마추종자 2명을 처치한 후 잿빛 골짜기 경계에 있는 로아투에게 돌아가십시오.‡Mata 6 sátiros Haldarr, 2 tramposos Haldarr, 2 jurapenas Haldarr y vuelve junto a Loh\'atu en la frontera de Vallefresno.‡Mata 6 sátiros Haldarr, 2 tramposos Haldarr, 2 jurapenas Haldarr y vuelve junto a Loh\'atu en la frontera de Vallefresno.‡Tuer 6 Satyres Haldarr, 2 Entourloupeurs Haldarr, et 2 Gangreliges Haldarr puis revenir voir Loh\'atu à la frontière d\'Orneval.‡杀掉6个哈达尔萨特、2个哈达尔欺诈者和2个哈达尔魔仆，然后向灰谷与艾萨拉交界处的罗哈图复命。‡殺掉6個哈達爾薩特、2個哈達爾欺詐者和2個哈達爾魔僕，然後向梣谷與艾薩拉交界處的羅哈圖覆命。',
  }
},
[5537] = {
  {
    'Fragmentos de Ossos‡Фрагменты скелетов‡Skelettfragmente‡뼛조각‡Trozos esqueléticos‡Trozos esqueléticos‡Fragments de squelette‡骸骨碎片‡骷髏碎片',
    nil,
    'Leve 15 Fragmentos de Ossos para o Alquimista Arvignon no Morro do Ventogelante, que fica nas Terras Pestilentas Ocidentais.‡Принесите 15 фрагментов скелетов алхимику Арбингтону в Берег Промозглого Ветра в Западных Чумных землях.‡Bringt 15 Skelettfragmente zu Alchimist Arbington an der Zugwindspitze, westliche Pestländer.‡서부 역병지대에 서리바람 거점에 있는 연금술사 알빙턴에게 뼛조각 15개를 가져가야 합니다.‡Lleva 15 trozos esqueléticos al alquimista Arbington, en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Lleva 15 trozos esqueléticos al alquimista Arbington, en el Alto del Orvallo, en las Tierras de la Peste del Oeste.‡Apporter 15 Fragments de squelette à l\'alchimiste Arbington à la pointe du Noroît, dans les Maleterres de l\'ouest.‡将15块骷髅碎片交给西瘟疫之地冰风岗的化学家阿尔比顿。‡將15塊骷髏碎片交給西瘟疫之地冰風崗的鍊金師阿爾比頓。',
  }
},
[5538] = {
  {
    'Um molde que vale ouro‡Форма денег стоит‡Sold reimt sich auf...‡거푸집과 뼛조각‡Molde rima con... ¿oro?‡Molde rima con... ¿oro?‡Moisissure rime avec…‡昂贵的模具‡昂貴的模具',
    nil,
    'Leve os Fragmentos de Ossos Imbuídos e 15 moedas de ouro para Rugov A. Massoaço em Geringontzan.‡Отнесите Кринкелю Сталлинну из Прибамбасска прочные фрагменты скелета и 15 золотых монет.‡Bringt die magieerfüllten Skelettfragmente sowie 15 Goldstücke zu Krinkle Goldstahl in Gadgetzan.‡가젯잔에 있는 크린클 굿스틸에게 15골드와 마력 깃든 뼛조각을 가져가야 합니다.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Lleva los trozos esqueléticos imbuidos y 15 piezas de oro a Krinkle Buenacero en Gadgetzan.‡Apporter les Fragments de squelette imprégnés et 15 pièces d’or à Krinkle Goodsteel à Gadgetzan.‡把灌魔的骸骨碎片和15枚金币交给加基森的克林科·古德斯迪尔。‡把灌魔的骷髏碎片和15枚金幣交給加基森的克林科·古德斯迪爾。',
  }
},
[5541] = {
  {
    'Sem munição não tem negócio‡Боеприпасы для Громострела‡Munition für Schlingerschuss‡럼블샷의 탄환‡Municiones para Estruendo‡Municiones para Estruendo‡Munitions pour Grondetrait‡海格纳的弹药‡海格納的彈藥',
    nil,
    'Entregue a Munição do Estremetiro para Hegnar Estremetiro em Dun Morogh.‡Доставьте боеприпасы Хегнару Громострелу в Дун Мороге.‡Bringt Schlingerschuss\' Munition zu Hegnar Schlingerschuss in Dun Morogh.‡던 모로에 있는 헤그너 럼블샷에게 럼블샷의 탄환을 가져가야 합니다.‡Lleva la munición de Estruendo a Hegnar Estruendo a Dun Morogh.‡Lleva la munición de Estruendo a Hegnar Estruendo a Dun Morogh.‡Apporter les Munitions de Grondetrait à Hegnar Grondetrait à Dun Morogh.‡把海格纳的弹药交给丹莫罗的海格纳·重枪。‡把海格納的彈藥交給丹莫洛的海格納·重槍。',
  }
},
[5542] = {
  {
    'Cães demoníacos‡Псы-демоны‡Dämonenhunde‡지옥개‡Perros demoníacos‡Perros demoníacos‡Chiens-démons‡恶魔之犬‡惡魔之犬',
    nil,
    'Mate 20 Cães Pestilentos Miúdos, 5 Cães Pestilentos e 5 Cães Pestilentos Frenéticos. Fale novamente com Tirion Fordring quando a tarefa estiver concluída.‡Убейте 20 карликовых чумных псов, 5 чумных псов и 5 бесноватых чумных псов. По выполнении задания вернитесь к Тириону Фордрингу.‡Erschlagt 20 kleine Seuchenhunde, 5 Seuchenhunde und 5 rasende Seuchenhunde. Kehrt zu Tirion Fordring zurück, sobald Ihr die Aufgabe erfüllt habt.‡새끼 역병사냥개 20마리, 역병사냥개 5마리와 광포한 역병사냥개 5마리를 처치하십시오. 임무를 완수하면 티리온 폴드링에게 돌아가야 합니다.‡Mata 20 cachorros de can de la Peste, 5 canes de la Peste y 5 canes de la Peste demenciados. Cuando hayas terminado tu tarea regresa con Tirion Vadín.‡Mata 20 cachorros de can de peste, 5 canes de peste y 5 canes de peste demenciados. Cuando hayas terminado tu tarea regresa con Tirion Vadín.‡Tuer 20 Chiens pestiférés chétifs, 5 Chiens pestiférés et 5 Chiens pestiférés frénétiques. Retourner voir Tirion Fordring quand la mission sera terminée.‡杀掉20条瘟疫幼犬、5条瘟疫犬和5条狂怒的瘟疫犬。任务完成之后向提里奥·弗丁复命。‡殺掉20條瘟疫幼犬、5條瘟疫犬和5條狂怒的瘟疫犬。任務完成之後向提里恩·弗丁覆命。',
  }
},
[5543] = {
  {
    'Céu tingido de sangue‡Окровавленные небеса‡Blutgefärbter Himmel‡핏빛 하늘‡Cielos sangrientos‡Cielos sangrientos‡Ciel couleur de sang‡血染的天空‡血染的天空',
    nil,
    'Mate 30 Quirópragos e fale novamente com Tirion Fordring.‡Убейте 30 чумных нетопырей и вернитесь к Тириону Фордрингу.‡Erschlagt 30 Seuchenfledermäuse und kehrt zu Tirion Fordring zurück.‡역병박쥐 30마리를 처치한 후 티리온 폴드링에게 돌아가야 합니다.‡Mata 30 murcipestes y vuelve con Tirion Vadín.‡Mata 30 murcipestes y vuelve con Tirion Vadín.‡Tuer 30 Chauves-souris pestiférées, puis retourner voir Tirion Fordring.‡杀死30只瘟疫蝙蝠，然后向提里奥·弗丁复命。‡殺死30隻瘟疫蝙蝠，然後向提里恩·弗丁覆命。',
  }
},
[5544] = {
  {
    'Carne de verme carniceiro‡Мясо личинок-трупоедов‡Aassammlung‡청소부구더기‡Gusanos carroñeros‡Gusanos carroñeros‡Larve putride‡腐肉虫‡腐肉蟲',
    nil,
    'Procure os Vermes Carniceiros e os Devoradores de Carniça da região. Mate-os e tire a carne. Fale novamente com Tirion Fordring depois que tiver juntado 15 Nacos de Carne de Verme Carniceiro.‡Найдите личинок-падальщиков и падальщиков-пожирателей. Убейте побольше и наберите из мяса. Возвращайтесь к Тириону Фордрингу, когда накопите 15 кусков мяса червей-трупоедов.‡Sucht nach den Aaslarven und Aasverschlingern dieses Gebiets. Erschlagt sie und sammelt ihr Fleisch. Kehrt zu Tirion Fordring zurück, wenn Ihr 15 Scheiben Aaswurmfleisch gesammelt habt.‡부근에서 청소부구더기와 걸신들린 청소부구더기를 찾아 처치하고 청소부구더기 고기덩어리 15개를 모은 후 티리온 폴드링에게 돌아가야 합니다.‡Busca las larvas y devoradores carroñeros de la zona. Mátalos y recoge su carne. Regresa con Tirion Vadín cuando tengas 15 trozos de carne de gusano carroñero.|n‡Busca las larvas y devoradores carroñeros de la zona. Mátalos y recoge su carne. Regresa con Tirion Vadín cuando tengas 15 trozos de carne de gusano carroñero.‡Chercher les Larves putrides et les Dévoreurs de la région. Les tuer et récupérer leur viande. Retourner voir Tirion Fordring quand 15 pièces de Chair de Ver putride auront été récupérées.‡在东瘟疫之地搜索腐肉虫和腐肉吞噬者。杀了它们并收集它们的肉。当你收集到15块食腐虫肉块之后，就回到提里奥·弗丁那里。‡在東瘟疫之地搜索腐肉蟲和腐肉吞噬者。殺了它們並收集它們的肉。當你收集到15塊食腐蟲肉塊之後，就回到提里恩·弗丁那裡。',
  }
},
[5545] = {
  {
    'Um feixe de encrenca‡Тридцать три несчастья‡Ein Bündel Probleme‡골칫덩어리‡El cumplimiento del plazo‡El cumplimiento del plazo‡Un sac d\'embrouilles‡木材危机‡木材危機',
    nil,
    'Leve 8 Feixes de Madeira para Raquel na Madeireira Vale do Leste.‡Принесите 8 вязанок дров Раэлен на Лесопилку Восточной долины.‡Bringt 8 Holzbündel zu Raelen beim Holzfällerlager des Osttals.‡동부 벌목지에 있는 랠렌에게 장작 더미 8개를 가져가야 합니다.‡Lleva 8 fardos de madera a Raelen al Aserradero de la Vega del Este.‡Lleva 8 fardos de madera a Raelen al Aserradero de la Vega del Este.‡Apporter 8 fagots de bois à Raelen au Camp de bûcherons du Val d\'est.‡收集8捆木材，把它们交给东谷伐木场的管理员莱琳。‡收集8捆木材，把它們交給東谷伐木場的管理員萊琳。',
  }
},
[5561] = {
  {
    'Arrebanhamento de kodos‡Отлов кодо‡Kodozusammentrieb‡코도 길들이기‡El rodeo kodo‡El rodeo kodo‡Le rassemblement des kodos‡诱捕科多兽‡誘捕科多獸',
    nil,
    'Leve cinco Kodos Domados e o Kodoagrupandador para Smid Rabiscafuso no Acampamento do Rabiscafuso.‡Приведите пять прирученных кодо Смиду Заржавеню в Лагерь Заржавня. Не забудьте вернуть ему энергетический инкапсулятор.‡Bringt fünf gezähmte Kodos sowie den Kodokombobulator zu Smeed Schraubenbuddel bei Schraubenbuddels Lager.‡길들인 코도 5마리와 코도 유인기를 자신의 야영지에 있는 스미드 스크래블스크류에게 가져가야 합니다.‡Lleva 5 kodos domados y el kombobulador kodo a Smeed Mezclatornillos, al Campamento de los Mezclatornillos.‡Lleva 3 kodos domados y el kombobulador kodo a Smeed Mezclatornillos, al Campamento de los Mezclatornillos.‡Ramener cinq Kodos domptés et le Kombobulateur kodo à Smeed Fouillevis au camp de Fouillevis.‡将科多兽诱引器和5头被驯服的科多兽交给瑟卡布斯库的营地中的斯米德·瑟卡布斯库。‡將科多獸誘引器和5頭被馴服的科多獸交給瑟卡布斯庫的營地中的斯米德·瑟卡布斯庫。',
  }
},
[5581] = {
  {
    'Portais para a Legião‡Порталы Легиона‡Portale der Legion‡악마의 차원문‡Los portales de la Legión‡Los portales de la Legión‡Les portails de la Légion‡燃烧军团的传送门‡燃燒軍團的傳送門',
    nil,
    'Feche 6 portais nas Ruínas de Mannoroc e fale com Taiga Crina Sábia na Aldeia Pescassombra.‡Уничтожьте 6 порталов на поле Маннорок, а затем вернитесь к Тайге Мудрой Гриве в деревню Ночных Охотников.‡Verbannt 6 Portale beim Zirkel der Mannoroc und kehrt dann zu Taiga Klugmähne nach Schattenflucht zurück.‡만노로크 소굴에서 악마의 차원문 6개를 없애고 타이가 와이즈메인에게 돌아가야 합니다.‡Destruye 6 Portales en el Aquelarre Mannoroc y vuelve a la Aldea Cazasombras a hablar con Taiga Melenasabia.|n‡Destruye 6 Portales en el Aquelarre Mannoroc y vuelve al Campamento del Espíritu Errante a hablar con Felgur Doscortes.‡Bannir 6 Portails, dans le convent de Mannoroc, puis retourner voir Taiga Crin-sage, à Proie-de-l\'Ombre.‡放逐6个玛诺洛克集会所的传送门，然后回到葬影村的泰迦·慧鬃那里。‡放逐6個瑪諾洛克集會所的傳送門，然後回到葬影村的泰迦·慧鬃那裡。',
  }
},
[5582] = {
  {
    'Escama de dragão saudável‡Здоровая чешуя дракона‡Gesunde Großdrachenschuppe‡생기 있는 용비늘‡Escama de dragón sana‡Escama de dragón sana‡L\'écaille de dragon luisante‡健康的龙鳞‡健康的龍鱗',
    nil,
    'Leve a Escama de Dragão Saudável para Betina Bigozinco na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите здоровую чешую дракона Бетине Биггльцинк в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die gesunde Großdrachenschuppe zu Betina Moppelzink bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 베티나 비글징크에게 생기 있는 용비늘을 가져가야 합니다.‡Lleva la escama de dragón sana a Betina Bigglezink a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la escama de dragón sana a Betina Bigglezink a la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apporter l\'Ecaille de dragon luisante à Betina Bigglezink à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡把健康的龙鳞交给东瘟疫之地圣光之愿礼拜堂中的贝蒂娜·比格辛克。‡把健康的龍鱗交給東瘟疫之地聖光之願禮拜堂中的貝蒂娜·比格辛克。',
  }
},
[5601] = {
  {
    'Irmã Pâmela‡Сестренка Памела‡Schwester Pamela‡여동생 파멜라‡Pamela, mi hermana‡Pamela, mi hermana‡Pamela, ma sœur‡小妹妹帕米拉‡小妹妹帕米拉',
    nil,
    'Encontre Pâmela Trilharrubra na Vila das Flechas.‡Найдите Памелу Редпат в Дарроушире.‡Sucht Pamela Rotpfad in Darroheim.‡다로우샤이어에서 파멜라 레드패스를 찾아야 합니다.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Encuentra a Pamela Rutagrana en Villa Darrow.‡Trouver Pamela Senterouge à Comté-de-Darrow.‡在达隆郡里找到帕米拉·雷德帕斯。‡在達隆郡裡找到帕米拉·雷德帕斯。',
  }
},
[5621] = {
  {
    'Vestes da lua‡Облачение Луны‡Gewänder des Mondes‡달빛 로브‡Prendas de la luna‡Prendas de la luna‡Vêtements de la lune‡月光之衣‡',
    nil,
    'Encontre a Sentinela Shaya e cure suas feridas usando Cura Inferior (Grau 2). Depois disso, conceda a ela Palavra de Poder: Fortitude e fale novamente com Laurna Luzalbor em Dolanaar.‡Найдите часовую Шайю и залечите ее раны "Слабым исцелением" 2-го уровня. Затем примените к ней "Слово силы: Стойкость" и вернитесь к Лорне Утренний Свет в Доланаар.‡Sucht die Schildwache Shaya und heilt ihre Wunden mit Hilfe von \'Geringes Heilen\' (Rang 2). Belegt sie danach mit \'Machtwort: Seelenstärke\' und kehrt dann zu Laurna Morgenglanz in Dolanaar zurück.‡파수꾼 샤야를 찾아 2 레벨 하급 치유로 부상을 치유한 후, 신의 권능:인내를 부여하고 돌라나르에 있는 라우르나 모닝라이트에게 돌아가십시오.‡Encuentra a la centinela Shaya y cura sus heridas utilizando un hechizo de Curación inferior (Rango 2). A continuación, concédele la Palabra de poder: entereza, y después ve a ver de nuevo a Laurna Luzdelalba a Dolanaar.‡Encuentra a la centinela Shaya y cura sus heridas utilizando un hechizo de Sanación inferior (Rango 2). A continuación, concédele la Palabra de poder: entereza, y después ve a ver de nuevo a Laurna Luzdelalba a Dolanaar.‡Trouver la Sentinelle Shaya et la guérir de ses blessures en utilisant Soins inférieurs (Rang 2). Lui accorder ensuite le Mot de pouvoir : Robustesse, puis retourner voir Laurna Clairematin, à Dolanaar.‡找到哨兵莎恩雅并使用次级治疗术（等级 2）来治疗她。然后对她施放真言术：韧，最后向多兰纳尔的劳尔娜·晨光复命。‡',
  }
},
[5622] = {
  {
    'Em favor de Eluna‡Во имя Элуны‡Elune geneigt‡엘룬의 추종자‡Los caminos de Elune‡Los caminos de Elune‡Au service d\'Elune‡月神的恩赐‡月神的恩賜',
    nil,
    'Fale com Laurna Luzalbor em Teldrassil.‡Поговорите в Тельдрассиле с Лорной Утренний Свет.‡Sprecht mit Laurna Morgenglanz in Teldrassil.‡텔드랏실에 있는 라우르나 모닝라이트와 대화하십시오.‡Habla con Laurna Luzdelalba en Teldrassil.‡Habla con Laurna Luzdelalba en Teldrassil.‡Parler à Laurna Clairematin à Teldrassil.‡与泰达希尔的劳尔娜·晨光谈一谈。‡與泰達希爾的勞爾娜·晨光談話。',
  }
},
[5623] = {
  {
    'Em favor da Luz‡Во имя Света!‡Dem Licht geneigt‡빛의 추종자‡Al servicio de la Luz‡Al servicio de la Luz‡Au service de la Lumière‡圣光的恩赐‡',
    nil,
    'Fale com a Sacerdotisa Joselita na Floresta de Elwynn.‡Поговорите с жрицей Жозеттой в Элвиннском лесу.‡Sprecht mit der Priesterin Josetta im Wald von Elwynn.‡엘윈 숲에 있는 여사제 조세타와 대화해야 합니다.‡Ve al Bosque de Elwynn y habla con la sacerdotisa Josetta.‡Ve al Bosque de Elwynn y habla con la sacerdotisa Josetta.‡Parler à la prêtresse Josetta dans la Forêt d\'Elwynn.‡与艾尔文森林的女牧师洁塞塔谈一谈。‡',
  }
},
[5624] = {
  {
    'Vestes da Luz‡Облачение Света‡Gewänder des Lichts‡성스러운 빛의 로브‡Las prendas de la Luz‡Las prendas de la Luz‡Vêtements de la Lumière‡圣光之衣‡',
    nil,
    'Encontre a Guarda Roberts e cure suas feridas usando Cura Inferior (Grau 2). Depois disso, conceda a ele Palavra de Poder: Fortitude e fale novamente com a Sacerdotisa Joselita em Vila d\'Ouro.‡Найдите стражника Робертса и залечите его раны "Слабым исцелением" 2-го уровня. Затем примените к нему "Слово силы: Стойкость" и вернитесь к жрице Жозетте в Златоземье.‡Sucht die Wache Roberts und heilt seine Wunden mit Hilfe von \'Geringes Heilen\' (Rang 2). Belegt ihn danach mit \'Machtwort: Seelenstärke\' und kehrt dann zu Priesterin Josetta in Goldhain zurück.‡경비병 로버트를 찾아 2 레벨 하급 치유를 사용해 부상을 치유한 후, 그에게 신의 권능: 인내를 부여하고 골드샤이어에 있는 여사제 조세타에게 돌아가야 합니다.‡Encuentra al guardia Roberts y cura sus heridas usando Curación inferior (Rango 2). Después, concédele la Palabra de poder: entereza y vuelve a Villadorada a hablar con la sacerdotisa Josetta.‡Encuentra al guardia Roberts y cura sus heridas usando Sanación relámpago.‡Trouver le garde Roberts et soigner ses blessures en utilisant Soins inférieurs (Rang 2). Lui accorder ensuite le Mot de pouvoir : Robustesse, puis retourner voir la prêtresse Josetta, à Comté-de-l\'or.‡找到卫兵罗伯兹并使用次级治疗术（等级 2）来治疗他。然后对他施放真言术：韧，最后向闪金镇的女牧师洁塞塔复命。‡',
  }
},
[5625] = {
  {
    'Vestes da Luz‡Облачение Света‡Gewänder des Lichts‡성스러운 빛의 로브‡Las prendas de la Luz‡Las prendas de la Luz‡Vêtements de la Lumière‡圣光之衣‡',
    nil,
    'Encontre o Montanhista Dolf e cure suas feridas usando Cura Inferior (Grau 2). Depois disso, conceda a ele Palavra de Poder: Fortitude e fale novamente com Maxan Begurno em Kharanos.‡Надите горного пехотинца Дольфа и залечите его раны "Слабым исцелением" 2-го уровня. Затем примените к нему "Слово силы: Стойкость" и вернитесь к Максану Ковальне в Каранос.‡Sucht den Gebirgsjäger Dolf und heilt seine Wunden mit Hilfe von \'Geringes Heilen\' (Rang 2). Belegt ihn danach mit \'Machtwort: Seelenstärke\' und kehrt dann zu Maxan Anvol in Kharanos zurück.‡산악경비대 돌프를 찾아 2 레벨 하급 치유를 사용해 부상을 치유한 후, 신의 권능:인내를 부여하고 카라노스에 있는 막산 앤볼에게 돌아가십시오.‡Encuentra al montaraz Dolf y cura sus heridas usando la Curación inferior (Rango 2). Después, concédele Palabra de Poder: Entereza y vuelve a Kharanos a hablar con Maxan Anvol.‡Encuentra al montaraz Dolf y cura sus heridas usando la Sanación inferior (Rango 2). Después, concédele Palabra de Poder: Entereza y vuelve a Kharanos a hablar con Maxan Anvol.‡Trouver le Montagnard Dolf et guérir ses blessures en utilisant Soins inférieurs (Rang 2). Lui accorder ensuite le Mot de pouvoir : Robustesse, puis retourner voir Maxan Anvol, à Kharanos.‡找到巡山人多尔夫并使用次级治疗术（等级 2）来治疗他。然后对他施放真言术：韧，最后向卡拉诺斯的马克萨恩·安沃尔复命。‡',
  }
},
[5626] = {
  {
    'Em favor da Luz‡Во имя Света!‡Dem Licht geneigt‡빛의 추종자‡Al servicio de la Luz‡Al servicio de la Luz‡Au service de la Lumière‡圣光的恩赐‡',
    nil,
    'Fale com Maxan Begurno em Dun Morogh.‡Поговорите с Максаном Ковальней в Дун Мороге.‡Sprecht mit Maxan Anvol in Dun Morogh.‡던 모로에 있는 막산 앤볼과 대화하십시오.‡Ve a Dun Morogh y habla con Maxan Anvol.‡Ve a Dun Morogh y habla con Maxan Anvol.‡Parler à Maxan Anvol à Dun Morogh.‡与丹莫罗的马克萨恩·安沃尔谈一谈。‡',
  }
},
[5627] = {
  {
    'As Estrelas-de-Eluna‡Звезды Элуны‡Sterne von Elune‡엘룬이 뿌린 별조각‡Estrellas de Elune‡Estrellas de Elune‡Etoiles d\'Elune‡艾露恩之星‡伊露恩之星',
