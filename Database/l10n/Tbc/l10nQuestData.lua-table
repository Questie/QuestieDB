[8430] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à l\'un des porteguerre de la Horde, devant les champs de bataille.‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡將3枚戰歌峽谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8431] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    'A batalha na Ravina Brado Guerreiro continua, <name>. Faça a sua parte e ajude-nos a expulsar as Sentinelas da Asa de Prata de nossas terras!‡Битва в Ущелье Песни Войны идет, не прекращаясь. Внеси свой вклад в изгнание Среброкрылых Часовых из наших земель!‡Der Kampf um die Warsongschlucht geht weiter, <Name>. Tut alles, was in Eurer Macht steht, um die Schildwachen der Silverwing aus unserem Land zu vertreiben!‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡La batalla en la Garganta Grito de Guerra sigue ardiendo, <nombre>. ¡Ayuda a expulsar a las centinelas Ala de Plata de nuestras tierras!‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡La bataille continue de faire rage dans le goulet des Warsong, <nom>. Faites votre part pour chasser les sentinelles d\'Aile-argent de nos terres !‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8432] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡',
    nil,
    'A batalha na Ravina Brado Guerreiro continua, <name>. Faça a sua parte e ajude-nos a expulsar as Sentinelas da Asa de Prata de nossas terras!‡Битва в Ущелье Песни Войны идет, не прекращаясь. Внеси свой вклад в изгнание Среброкрылых Часовых из наших земель!‡Der Kampf um die Warsongschlucht geht weiter, <Name>. Tut alles, was in Eurer Macht steht, um die Schildwachen der Silverwing aus unserem Land zu vertreiben!‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡La bataille continue de faire rage dans le goulet des Warsong, <nom>. Faites votre part pour chasser les sentinelles d\'Aile-argent de nos terres !‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8433] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    '‡Битва в Ущелье Песни Войны идет, не прекращаясь. Внеси свой вклад в изгнание Среброкрылых Часовых из наших земель!‡Der Kampf um die Warsongschlucht geht weiter, <Name>. Tut alles, was in Eurer Macht steht, um die Schildwachen der Silverwing aus unserem Land zu vertreiben!‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡La bataille continue de faire rage dans le goulet des Warsong, <nom>. Faites votre part pour chasser les sentinelles d\'Aile-argent de nos terres !‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8434] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    '‡Принесите 3 почетных знака Ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Der Kampf um die Warsongschlucht geht weiter, <Name>. Tut alles, was in Eurer Macht steht, um die Schildwachen der Silverwing aus unserem Land zu vertreiben!‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡La bataille continue de faire rage dans le goulet des Warsong, <nom>. Faites votre part pour chasser les sentinelles d\'Aile-argent de nos terres !‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8435] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    'A batalha na Ravina Brado Guerreiro continua, <name>. Faça a sua parte e ajude-nos a expulsar as Sentinelas da Asa de Prata de nossas terras!‡Битва в Ущелье Песни Войны идет, не прекращаясь. Внеси свой вклад в изгнание Среброкрылых Часовых из наших земель!‡Der Kampf um die Warsongschlucht geht weiter, <Name>. Tut alles, was in Eurer Macht steht, um die Schildwachen der Silverwing aus unserem Land zu vertreiben!‡전장 밖에 있는 호드 전쟁인도자에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡La bataille continue de faire rage dans le goulet des Warsong, <nom>. Faites votre part pour chasser les sentinelles d\'Aile-argent de nos terres !‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8436] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d’honneur du bassin d’Arathi à l’un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8437] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin d\'Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8438] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin d\'Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8439] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin d\'Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8440] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡',
    nil,
    '‡Нам не выиграть войну против презренного Альянса без снабжения! Не позволим нашим складам опустеть к середине битвы. Низина Арати должна отойти к нам!‡Der Krieg gegen den Allianzabschaum frisst Unmengen an Ressourcen, <Name>! Wir können es uns nicht erlauben, dass uns unsere Vorräte auf dem Höhepunkt der Schlacht ausgehen. Stellt weiterhin sicher, dass das Arathibecken unter unserer Kontrolle bleibt.‡‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡La guerre contre la racaille de l\'Alliance exige des ressources, <nom> ! Nous ne pouvons pas nous permettre de laisser tarir nos réserves au beau milieu de la lutte. Continuez à faire en sorte que le bassin d\'Arathi reste entre nos mains !‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8441] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡',
    nil,
    '‡Нам не выиграть войну против презренного Альянса без снабжения! Не позволим нашим складам опустеть к середине сражения. Низина Арати должна отойти к нам!‡Der Krieg gegen den Allianzabschaum frisst Unmengen an Ressourcen, <Name>! Wir können es uns nicht erlauben, dass uns unsere Vorräte auf dem Höhepunkt der Schlacht ausgehen. Stellt weiterhin sicher, dass das Arathibecken unter unserer Kontrolle bleibt.‡‡¡La guerra contra la escoria de la Alianza exige recursos, <nombre>! No podemos permitir que nuestras reservas se agoten en medio de una batalla. ¡Sigue asegurándote de que la Cuenca de Arathi siga en nuestras manos!‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8442] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡',
    nil,
    '‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Der Krieg gegen den Allianzabschaum frisst Unmengen an Ressourcen, <Name>! Wir können es uns nicht erlauben, dass uns unsere Vorräte auf dem Höhepunkt der Schlacht ausgehen. Stellt weiterhin sicher, dass das Arathibecken unter unserer Kontrolle bleibt.‡‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡La guerre contre la racaille de l\'Alliance exige des ressources, <nom> ! Nous ne pouvons pas nous permettre de laisser tarir nos réserves au beau milieu de la lutte. Continuez à faire en sorte que le bassin d\'Arathi reste entre nos mains !‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8443] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라시 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin d\'Arathi‡征服阿拉希盆地‡資源競賽',
    nil,
    'A guerra contra a escória da Aliança requer recursos, <name>! Não podemos permitir que nossos estoques acabem no meio de uma batalha. Vá e faça tudo para que a Bacia Arathi continue sob nosso poder!‡Нам не выиграть войну против презренного Альянса без снабжения! Не позволим нашим складам опустеть к середине битвы. Низина Арати должна отойти к нам!‡Der Krieg gegen den Allianzabschaum frisst Unmengen an Ressourcen, <Name>! Wir können es uns nicht erlauben, dass uns unsere Vorräte auf dem Höhepunkt der Schlacht ausgehen. Stellt weiterhin sicher, dass das Arathibecken unter unserer Kontrolle bleibt.‡얼라이언스 놈들과 전쟁을 치르려면 자원이 필요하오! 전투가 한창일 때 보급품 물량이 바닥나서는 절대 안 되오. 적에게 아라시 분지가 넘어가지 않도록 만전을 기하시오!‡¡La guerra contra la escoria de la Alianza exige recursos, <nombre>! No podemos permitir que nuestras reservas se agoten en medio de una batalla. ¡Sigue asegurándote de que la Cuenca de Arathi siga en nuestras manos!‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡La guerre contre la racaille de l\'Alliance exige des ressources, <nom> ! Nous ne pouvons pas nous permettre de laisser tarir nos réserves au beau milieu de la lutte. Continuez à faire en sorte que le bassin d\'Arathi reste entre nos mains !‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8446] = {
  {
    'Mergulhado em pesadelos‡Под покровом кошмара‡Eingehüllt in Alpträume‡악몽 속의 장막‡Inundación de Pesadilla‡Inundación de Pesadilla‡Voilé par le cauchemar‡梦魇的缠绕‡夢魘的纏繞',
    nil,
    'Encontre alguém capaz de decifrar o significado do Objeto Mergulhado em Pesadelos.nnTalvez algum druida poderoso possa lhe ajudar.‡Найдите того, кто сможет осознать значение поглощенного кошмарами предмета.nnМожет быть, вам сможет помочь могущественный друид.‡Sucht nach jemandem, der die Bedeutung des in Alpträume gehüllten Gegenstands entschlüsseln kann.nnVielleicht kann Euch ein Druide von großer Macht weiterhelfen.‡악몽이 깃든 물건에 숨겨진 의미를 해석할 수 있는 이를 찾아야 합니다.nn강력한 힘을 가진 드루이드가 도움을 줄 수 있을 것입니다.‡Encuentra a alguien que pueda descifrar el significado del objeto envuelto en pesadillas.nnQuizás un druida de gran poder pueda ayudarte.‡Encuentra a alguien que pueda descifrar el significado del objeto envuelto en pesadillas.|nQuizás un druida de gran poder pueda ayudarte.‡Trouver quelqu\'un capable de comprendre la signification de l\'Objet noyé dans les cauchemars.nnPeut-être qu\'un druide de grande puissance pourra vous aider.‡寻找能解读梦魇包裹的物品中所隐藏的信息的人。nn或许拥有强大力量的德鲁伊可以帮助你。‡尋找能解讀夢魘包裹物品中所隱藏信息的人。|n或許擁有強大力量的德魯伊可以幫助你。',
  }
},
[8447] = {
  {
    'Despertar das lendas‡Пробуждение легенд‡Legenden erwachen‡깨어나는 전설‡Leyendas veraces‡Leyendas veraces‡L\'éveil des légendes‡唤醒传说‡喚醒傳說',
    nil,
    'Aguarde enquanto o Guardião Remulos, na Clareira da Lua, purifica o Objeto Mergulhado em Pesadelos.‡Дождитесь, пока хранитель Ремул с Лунной поляны очистит поглощенный кошмарами предмет.‡Wartet, bis Bewahrer Remulos bei der Mondlichtung den von Alpträumen eingehüllten Gegenstand gereinigt hat.‡달의 숲에 있는 수호자 레물로스가 악몽이 깃든 물건을 정화할 때까지 기다려야 합니다.‡Espera a que el Guardián Remulos del Claro de la Luna purifique el objeto envuelto en pesadillas.‡Espera a que el Guardián Remulos del Claro de la Luna purifique el objeto envuelto en pesadillas.‡Attendre que le gardien Remulos de Reflet-de-Lune ait purifié l\'Objet noyé dans les cauchemars.‡等待月光林地的守护者雷姆洛斯净化梦魇包裹的物品。‡等待月光林地的守護者雷姆洛斯淨化夢魘包裹的物品。',
  }
},
[8460] = {
  {
    'Aliando-se aos Presamatos‡Союзник Древобрюхов‡Verbündeter der Holzschlundfeste‡나무구렁일족‡Aliado a los Fauces de Madera‡Aliado Fauces de Madera‡Allié des Grumegueules‡木喉熊怪的盟友‡木喉熊怪的盟友',
    nil,
    'Grazle quer que você prove seu valor matando 6 Guerreiros de Lenha Morta, 6 Desbravadores de Lenha Morta e 6 Jardineiros de Lenha Morta. Quando você terminar, fale novamente com ele na parte sul da Selva Maleva, perto do Santuário Esmeralda.‡Гразл желает, чтобы вы заслужили доверие. Вам нужно убить 6 воинов, 6 землепроходцев и 6 садовников из племени Мертвого Леса. Выполнив поручение, возвращайтесь в южную часть Оскверненного леса к Изумрудному святилищу.‡Grazle möchte, dass Ihr Euch beweist, indem Ihr 6 Krieger der Totenwaldfelle, 6 Pfadfinder der Totenwaldfelle und 6 Gärtner der Totenwaldfelle besiegt. Kehrt zu ihm in den Süden des Teufelswalds nahe des Smaragdrefugiums zurück, sobald Ihr dies getan habt.‡그라즐이 자기 일족의 친구임을 입증하려면 마른가지일족 전사, 길잡이, 정원사를 각각 6마리씩 처치해달라고 부탁했습니다. 임무를 마치면 악령의 숲 남쪽, 에메랄드 성소 근처에 있는 그라즐에게 돌아가십시오.‡Grazle quiere que demuestres tu valía matando a 6 guerreros Muertobosque, 6 abrecaminos Muertobosque y 6 jardineros Muertobosque. Cuando lo hayas hecho, vuelve con él al sur de Frondavil, cerca del Santuario Esmeralda.‡Grazle quiere que demuestres tu valía matando a 6 guerreros Muertobosque, 6 abrecaminos Muertobosque y 6 jardineros Muertobosque. Cuando lo hayas hecho, vuelve con él al sur de Frondavil, cerca del Santuario Esmeralda.‡Grifleur veut que vous prouviez votre valeur en tuant 6 Guerriers Mort-bois, 6 Guides Mort-bois et 6 Jardiniers Mort-bois. Lorsque ce sera fait, retournez le voir dans le sud de Gangrebois, près du Sanctuaire d\'émeraude.‡格拉兹要你去杀死6个死木战士、6个死木探路者以及6个死木园丁。‡格拉茲要你去殺死6個死木戰士、6個死木探路者以及6個死木園丁以證明自己的立場。完成後回到翡翠聖地附近的費伍德森林南方找他。',
  }
},
[8461] = {
  {
    'Lenha Morta do Norte‡Северные фурболги Мертвого Леса‡Totenwaldfelle des Nordens‡북방의 마른가지일족‡Los Muertobosque del Norte‡Los Muertobosque del Norte‡Les Mort-bois du nord‡北方的死木熊怪‡北方的死木熊怪',
    nil,
    'Nafien quer que você mate 6 Vigias do Covil de Lenha Morta, 6 Vingadores de Lenha Morta e 6 Xamãs de Lenha Morta. Fale novamente com ele na parte norte da Selva Maleva, perto da entrada do Domínio dos Presamatos.‡Нафиэн просит вас убить 6 дозорных, 6 мстителей и 6 шаманов из племени Мертвого Леса. По выполнении возвращайтесь на север Оскверненного леса ко входу в крепость Древобрюхов.‡Nafien möchte, dass Ihr 6 Höhlenbehüter der Totenwaldfelle, 6 Rächer der Totenwaldfelle und 6 Schamanen der Totenwaldfelle besiegt. Kehrt danach zu ihm in den Norden des Teufelswalds nahe des Eingangs der Holzschlundfeste zurück.‡나피엔이 마른가지일족 보초, 복수자, 주술사를 각각 6마리씩 처치해 달라고 부탁했습니다. 일을 마치면 악령의 숲 북쪽, 나무구렁 요새 입구 근처에 있는 나피엔에게 돌아가십시오.‡Nafien quiere que mates a 6 vigías del cubil Muertobosque, 6 vengadores Muertobosque y 6 chamanes Muertobosque. Luego, vuelve a buscarlo al norte de Frondavil, cerca de la entrada del Bastión Fauces de Madera.‡Nafien quiere que mates a 6 vigías del cubil Muertobosque, 6 vengadores Muertobosque y 6 chamanes Muertobosque. Luego, vuelve a buscarlo al norte de Frondavil, cerca de la entrada del Bastión Fauces de Madera.‡Nafien veut que vous tuiez 6 Protecteurs Mort-bois, 6 Vengeurs Mort-bois et 6 Chamans Mort-bois. Ensuite, retournez le voir dans le nord de Gangrebois, près de l\'entrée du repaire des Grumegueules.‡格拉兹要你去杀死6个死木守卫、6个死木复仇者和6个死木萨满祭司。‡納菲恩要你去殺死6個死木守衛、6個死木復仇者和6個死木薩滿。再回到木喉要塞入口附近的費伍德森林北方找他。',
  }
},
[8462] = {
  {
    'Fale com Nafien‡Беседа с Нафиэном‡Sprecht mit Nafien‡나피엔과 대화하기‡Habla con Nafien‡Habla con Nafien‡Parler à Nafien‡与纳菲恩交谈‡與納菲恩交談',
    nil,
    'Viaje para o norte ao longo da estrada principal em Selva Maleva e fale com o pelurso chamado Nafien. Ele monta guarda diante da entrada do Domínio dos Presamatos.‡Отправляйтесь на север по главной дороге в Оскверненном лесу и поговорите с фурболгом по имени Нафиэн. Он стоит на страже у входа в крепость Древобрюхов.‡Reist nach Norden entlang der Hauptstraße des Teufelswalds und sprecht mit einem Furbolg namens Nafien. Er hält außerhalb des Eingangs zur Holzschlundfeste Wache.‡악령의 숲에 있는 큰 길을 따라 북쪽으로 가서 나피엔이라는 펄볼그와 대화하십시오. 나피엔은 나무구렁 요새 입구에서 보초를 서고 있습니다.‡Viaja hacia el norte por el camino principal de Frondavil y habla con el fúrbolg Nafien. Está haciendo guardia en la entrada del Bastión Fauces de Madera.‡Viaja hacia el norte por el camino principal de Frondavil y habla con el fúrbolg Nafien. Está haciendo guardia en la entrada del Bastión Fauces de Madera.‡Suivre la route principale de Gangrebois vers le nord et parler à Nafien le furbolg. Il monte la garde à côté de l\'entrée du repaire des Grumegueules.‡沿着费伍德森林的路向北走，与一个名叫纳菲恩的熊怪谈谈。他站在木喉要塞的入口处。‡沿著費伍德森林的大路往北走並和一隻叫納菲恩的熊怪交談。他就在木喉要塞的入口守衛著。',
  }
},
[8463] = {
  {
    'Cristais de mana instáveis‡Нестабильные кристаллы маны‡Instabile Manakristalle‡불안정한 마나 수정‡Cristales de maná inestables‡Cristales de maná inestables‡Les cristaux de mana instables‡不稳定的法力水晶‡不穩定法力水晶',
    nil,
    'Leve 6 Cristais de Mana Instáveis para Aledon Marcassol na Praça Asa do Falcão.‡Верните 6 нестабильных кристаллов маны Аэльдону Озаренному Солнцем на площади Соколиных Крыльев.‡Bringt Aeldon Sonnenmal auf dem Falkenplatz 6 instabile Manakristalle.‡매날개 광장에 있는 앨돈 선브랜드에게 불안정한 마나 수정 6개를 가져가야 합니다.‡Lleva 6 cristales de maná inestables a Aeldon Marcasol a la Plaza Alalcón.‡Lleva 6 cristales de maná inestables a Aeldon Marcasol a la Plaza Alalcón.‡Rapportez 6 Cristaux de mana instables à Aeldon Signesol, sur la Place de l\'épervier.‡给鹰翼广场的艾尔杜·炙痕带回6块不稳定的法力水晶。‡帶回6個不穩定法力水晶給獵鷹之翼廣場的艾爾頓·桑布蘭德。',
  }
},
[8464] = {
  {
    'Atividade Invernosa‡Боевые действия в деревне Зимней Спячки‡Aktivität der Winterfelle‡눈사태일족의 동태‡Actividad de los Nevada‡Actividad de los Nevada‡Les Tombe-hiver s\'agitent‡冬泉熊怪的活动‡冬泉熊怪的活動',
    nil,
    'Salfa quer que você mate 8 Xamãs Invernosos, 8 Vigias do Covil dos Invernosos e 8 Ursinos Invernosos. Salfa está perto da entrada do Domínio dos Presamatos, em Hibérnia.‡Убейте 8 шаманов, 8 дозорных и 8 ведмедей из племени Зимней Спячки по просьбе Сальфы. Он ждет у входа в Крепость Древобрюхов в Зимних Ключах.‡Salfa möchte, dass Ihr 8 Schamanen der Winterfelle, 8 Höhlenbehüter der Winterfelle und 8 Ursa der Winterfelle erledigt. Salfa befindet sich genau außerhalb des Eingangs zur Holzschlundfeste in Winterquell.‡살파가 눈사태일족 주술사, 보초, 펄볼그를 각각 8마리씩 처치해달라고 부탁했습니다. 살파는 여명의 설원에 있는 나무구렁 요새의 입구 바로 밖에 있습니다.‡Salfa quiere que mates 8 chamanes Nevada, 8 vigías del cubil Nevada y 8 ursas Nevada. Salfa está a las puertas del Bastión Fauces de Madera en Cuna del Invierno.|n‡Salfa quiere que mates 8 chamanes Nevada, 8 vigías del cubil Nevada y 8 ursas Nevada. Salfa está a las puertas del Bastión Fauces de Madera en Cuna del Invierno.‡Salfa voudrait que vous tuiez 8 Chamans Tombe-hiver, 8 Protecteurs Tombe-hiver et 8 Ursas Tombe-hiver. Salfa se trouve juste à l\'extérieur de l\'entrée du repaire des Grumegueules, au Berceau-de-l\'hiver.‡萨尔法要你去杀死8个冬泉萨满祭司、8个冬泉巢穴守卫和8个冬泉巨熊怪。萨尔法就站在冬泉谷的木喉要塞入口处。‡薩爾法要你去殺死8個冬泉薩滿，8個冬泉巢穴守衛和8個冬泉巨熊怪。薩爾法就在冬泉谷的木喉要塞入口外面。',
  }
},
[8465] = {
  {
    'Fale com Salfa‡Разговор с Сальфой‡Sprecht mit Salfa‡살파와 대화하기‡Habla con Salfa‡Habla con Salfa‡Parler à Salfa‡与萨尔法交谈‡與薩爾法交談',
    nil,
    'Viaje pelo Domínio dos Presamatos até chegar a Hibérnia. Fale com Salfa, que está de guarda em frente à entrada do Domínio dos Presamatos.‡Пройдите через Крепость Древобрюхов и выйдите к Зимним Ключам. Поговорите с Сальфой, который стоит на страже у входа в Крепость Древобрюхов.‡Durchquert die Holzschlundfeste und verlasst sie in Richtung Winterquell. Sprecht mit Salfa, die außerhalb des Eingangs zur Holzschlundfeste Wache steht.‡나무구렁 요새를 통과하여 여명의 설원으로 가서 나무구렁 요새 입구를 지키고 서 있는 살파와 대화하십시오.‡Viaja por el Bastión Fauces de Madera y sal a Cuna del Invierno. Habla con Salfa, que está haciendo guardia en la entrada del Bastión Fauces de Madera.‡Viaja por el Bastión Fauces de Madera y sal a Cuna del Invierno. Habla con Salfa, que está haciendo guardia en la entrada del Bastión Fauces de Madera.‡Traverser le repaire des Grumegueules et sortir au Berceau-de-l\'Hiver. Parlez à Salfa, qui monte la garde à l\'extérieur du repaire des Grumegueules.‡穿过木喉要塞去冬泉谷。和萨尔法谈谈，他就在木喉要塞另一头的出口处。‡通過木喉要塞前往冬泉谷。和薩爾法交談，他就在木喉要塞入口外守衛著。',
  }
},
[8466] = {
  {
    'Penas para Grazle‡Перья для Гразла‡Federn für Grazle‡그라즐을 위한 깃털‡Plumas para Grazle‡Plumas para Grazle‡Des plumes pour Grifleur‡给格拉兹的羽毛‡給格拉茲的羽毛',
    nil,
    'Apesar de você ter provado seu valor perante mim, ainda é preciso muito esforço para conquistar os meus desconfiados irmãos. Para tanto, vou continuar a ajudá-lo.nnAlguns dos pelursos Lenha Morta usam um ornamento na cabeça que vale como prova de que foram mortos. Traga-me uma pena de qualquer adorno de cabeça. Para cada cinco que você trouxer, sua recompensa será o reconhecimento dos Presamatos.‡Хотя я уже тебе доверяю, заслужить доверие моих подозрительных соплеменников тебе еще только предстоит. Тут я смогу тебе помочь.nnУ некоторых фурболгов Мертвого Леса есть характерные головные уборы, которые могут послужить доказательством уменьшения их числа. Приноси мне перья из всех головных уборов, какие только сможешь добыть, и с каждыми очередными пятью штуками доверие к тебе в племени Древобрюхов будет возрастать.‡Ihr habt Euch mir gegenüber mehr als bewiesen, doch um das Vertrauen meiner misstrauischen Brüder und Schwestern zu gewinnen, ist es noch ein weiter Weg. Keine Sorge, ich werde Euch dabei behilflich sein, auch diese letzte Hürde zu überwinden.nnEinige Furbolgs der Totenwaldfelle tragen einen auffälligen Kopfschmuck. Dieser wäre ein ausreichender Beweis, für Euren Kampf gegen unsere verderbten Geschwister. Bringt mir die Federn der von Euch erbeuteten Kopfschmucke. Für jeweils fünf Federn die Ihr bei mir abgebt, wird sich Euer Ruf unter den Einwohnern der Holzschlundfeste verbessern.‡나는 당신을 믿지만 의심 많은 우리 일족에게도 당신이 친구라는 것을 계속 증명해야 할 것이오. 그러려면 앞으로도 내 도움이 필요할 것이오.nn마른가지일족 펄볼그 중 일부는 독특한 깃털로 머리를 장식하고 다닌다오. 놈들의 수를 줄이고 그 증거로 그 머리장식을 가져오시오. 어떤 놈들을 처치하든지 깃털 머리장식을 구하는 대로 내게 가져다주시오. 5개를 가지고 올 때마다 나무구렁일족의 신뢰를 얻게 될 거요.‡Aunque a mí ya me has probado tu valía, tendrás que seguir trabajando si quieres ganarte a los recelosos miembros de mi tribu. Quizás yo pueda ayudarte a conseguirlo.nnReduce el número de los furbolgs Muertobosque y recoge el penacho que llevan algunos. Te servirá como prueba de tu hazaña. Tráeme una pluma de cualquiera de los penachos que consigas; por cada grupo de 5 que me traigas, ganarás reconocimiento entre los Fauces de Madera.‡‡Même si vous m’avez déjà montré votre valeur, vous devez continuer à faire vos preuves vis-à-vis des autres membres de ma tribu, qui sont plus méfiants que moi. Je pourrai peut-être vous aider dans cette tâche.nnCertains furbolgs Mort-bois portent une coiffe distinctive qui pourraient vous servir à démontrer que vous avez bien diminué leurs rangs. Apportez-moi une plume de toutes les coiffes que vous vous procurerez. Pour chaque série de cinq plumes que vous m’apporterez, vous gagnerez la reconnaissance des Grumegueules.‡‡',
  }
},
[8467] = {
  {
    'Penas para Nafien‡Перья для Нафиэна‡Federn für Nafien‡나피엔을 위한 깃털‡Plumas para Nafien‡Plumas para Nafien‡Des plumes pour Nafien‡给纳菲恩的羽毛‡給納菲恩的羽毛',
    nil,
    'Apesar de você ter provado seu valor perante mim, ainda é preciso muito esforço para conquistar os meus desconfiados irmãos. Para tanto, vou continuar a ajudá-lo.nnAlguns dos pelursos Lenha Morta usam um ornamento na cabeça que vale como prova de que foram mortos. Traga-me uma pena de qualquer adorno de cabeça. Para cada cinco que você trouxer, sua recompensa será o reconhecimento dos Presamatos.‡Хотя я уже тебе доверяю, заслужить доверие моих соплеменников тебе еще только предстоит. Тут я смогу тебе помочь.nnУ некоторых фурболгов Мертвого Леса есть характерные головные уборы, которые могут послужить доказательством уменьшения их числа. Приноси мне перья из всех головных уборов, какие только сможешь добыть, и с каждыми очередными пятью штуками доверие к тебе в племени Древобрюхов будет возрастать.‡Ihr habt Euch mir gegenüber mehr als bewiesen, doch um das Vertrauen meiner misstrauischen Brüder und Schwestern zu gewinnen, ist es noch ein weiter Weg. Keine Sorge, ich werde Euch dabei behilflich sein, auch diese letzte Hürde zu überwinden.nnEinige Furbolgs der Totenwaldfelle tragen einen auffälligen Kopfschmuck. Dieser wäre ein ausreichender Beweis, für Euren Kampf gegen unsere verderbten Geschwister. Bringt mir die Federn der von Euch erbeuteten Kopfschmucke. Für jeweils fünf Federn die Ihr bei mir abgebt, wird sich Euer Ruf unter den Einwohnern der Holzschlundfeste verbessern.‡나는 당신을 믿지만 의심 많은 우리 일족에게도 당신이 친구라는 것을 계속 증명해야 할 것이오. 그러려면 앞으로도 내 도움이 필요할 것이오.nn마른가지일족 펄볼그 중 일부는 독특한 깃털로 머리를 장식하고 다니고 있소. 놈들의 수를 줄이고 그 증거로 깃털 머리장식을 가져오시오. 어떤 놈들을 처치하든지 머리장식을 구하는 대로 내게 가져다주시오. 5개를 가지고 올 때마다 나무구렁일족의 신뢰를 얻게 될 것이오.‡Aunque a mí ya me has probado tu valía, tendrás que seguir trabajando si quieres ganarte a los recelosos miembros de mi tribu. Quizás yo pueda ayudarte a conseguirlo.nnReduce el número de los fúrbolgs Muertobosque y recoge el penacho que llevan algunos. Te servirá como prueba de tu hazaña. Tráeme una pluma de cualquiera de los penachos que consigas; por cada grupo de 5 que me traigas, ganarás reconocimiento entre los Fauces de Madera.‡‡Même si vous m’avez déjà montré votre valeur, vous devez continuer à faire vos preuves vis-à-vis des autres membres de ma tribu, qui sont plus méfiants que moi. Je pourrai peut-être vous aider dans cette tâche.nnCertains furbolgs Mort-bois portent une coiffe distinctive qui pourraient vous servir à démontrer que vous avez bien diminué leurs rangs. Apportez-moi une plume de toutes les coiffes que vous vous procurerez. Pour chaque série de cinq plumes que vous m’apporterez, vous gagnerez la reconnaissance des Grumegueules.‡虽然你已经向我证明了你的忠诚，但是你还要向我那些疑心很重的部族兄弟证明自己。然后，我才可以帮助你。nn也许减少死木熊怪的数量会是一个不错的办法，你可以通过拿到他们都有的头饰羽毛来证明这一点；你每带给我5个头饰就可以进一步改善木喉熊怪对你的态度。‡',
  }
},
[8468] = {
  {
    'Procura-se: Thaelis, o Famélico‡Разыскивается: Таэлис Ненасытный‡Gesucht: Thaelis der Manadurstige‡현상 수배: 욕망의 탤리스‡Se busca a Thaelis el Hambriento‡Se busca: Thaelis el Hambriento‡On recherche: Thaelis l\'Affameur‡通缉：饥饿者泰里斯‡懸賞:『飢餓者』泰利斯',
    nil,
    'Entregue a Cabeça do Thaelis ao Sargento Kan\'ren na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Принесите голову Таэлиса сержанту Ка\'рену на площадь Соколиных Крыльев в лесах Вечной Песни.‡Bringt Thaelis Kopf zu Unteroffizier Kan\'ren beim Falkenplatz im Immersangwald.‡영원노래 숲의 매날개 광장에 있는 경비대장 칸렌에게 탤리스를 처치한 증거를 가져가서 보고해야 합니다.‡Lleva la cabeza de Thaelis al sargento Kan\'ren a la Plaza Alalcón, en el Bosque Canción Eterna.‡Lleva la cabeza de Thaelis al sargento Kan\'ren a la Plaza Alalcón, en el Bosque Canción Eterna.‡Apportez la Tête de Thaelis au Sergent Kan\'ren sur la Place de l\'épervier, dans le Bois des chants éternels.‡将泰里斯的头颅交给永歌森林鹰翼广场的坎雷中士。‡帶著泰利斯的頭顱到永歌森林的獵鷹之翼廣場，交給士官坎倫。',
  }
},
[8469] = {
  {
    'Contas para Salfa‡Бусы для Сальфы‡Perlen für Salfa‡살파에게 정기의 구슬 가져다주기‡Cuentas para Salfa‡Cuentas para Salfa‡Des perles pour Salfa‡给萨尔法的珠串‡給薩爾法的珠串',
    nil,
    '<name>, você conquistou a minha confiança, mas não a da minha tribo. No entanto, há algo que pode fazer para mudar isso.nnOs Invernosos são conhecidos por carregar contas espirituais que os protegem de entidades impuras. Elas não funcionaram como deveriam, e agora os próprios Invernosos são agentes da corrupção. Traga-me as contas espirituais dos pelursos Invernosos que tombarem em batalha. A cada cinco contas que você me trouxer, seu reconhecimento dentre os Presamatos aumentará.‡Ты заслужил мое доверие Орканавт, теперь осталось проделать то же самое с моим крайне недоверчивым племенем. Для этого придется потрудиться.nnПлемя Зимней Спячки, как известно, носит особые бусы, чтобы защищаться от злых духов. Бусы не оправдали свое предназначение, поскольку все племя подверглось порче. Принеси мне бусы, которые носят падшие фурболги. Твой авторитет в племени будет расти с каждыми принесенными бусами.‡Ihr habt Euch mein Vertrauen hart erarbeitet, <Name>. Doch bis meine Brüder und Schwestern Euch genauso akzeptieren, wie ich es tue, ist es noch ein weiter Weg. Ihr könntet jedoch etwas für mich tun, um diesen Prozess zu beschleunigen.nnDie Furbolgs der Winterfelle sind dafür bekannt, dass sie zum Schutz vor dunklen Mächten Geisterperlen bei sich tragen. Aber auch diese mächtigen Artefakte vermochten es nicht, die Verderbnis aufzuhalten und so sind die Winterfelle dieser Macht erlegen. Bringt mir die Geisterperlen gefallener Furbolgs der Winterfelle. Für jeweils fünf Geisterperlen die Ihr bei mir abgebt, wird sich Euer Ruf unter den Einwohnern der Holzschlundfeste verbessern.‡<name>, 나는 당신을 신뢰하게 되었지만 아직 의심을 떨치지 못한 우리 일족들의 신뢰도 얻어야 하오. 그러려면 당신에게 할 일이 하나 있소이다.nn눈사태일족은 사악한 영혼으로부터 자신들을 보호하기 위해 정기의 구슬을 지니고 다닌다고 하오. 하지만 정작 눈사태일족 자신들이 타락을 퍼뜨리는 하수인이 된 것으로 보아 그 구슬은 아무런 효과도 없는 것이 분명하오. 타락한 눈사태일족 펄볼그들이 갖고 다니는 정기의 구슬을 내게 가져다주시오. 5개씩 가지고 올 때마다 나무구렁일족의 신뢰를 얻게 될 것이오.‡Has sabido ganarte mi confianza, <nombre>, pero aún tendrás que ganarte la confianza de mi tribu. Hay algo que puedes hacer para conseguirlo.nnSe sabe que los Nevada llevan consigo cuentas de espíritus para protegerse contra los espíritus infectos. Esas cuentas no han cumplido sus propósitos ya que los propios Nevada se han convertido en agentes de corrupción. Tráeme las cuentas de espíritu de los furbolgs Nevada caídos, por cada cinco que me traigas aumentará tu reconocimiento entre los Fauces de Madera.‡‡Vous avez certainement gagné ma confiance, <nom>, mais vous devez continuer à faire vos preuves devant ma tribu, fort soupçonneuse. Voici ce que vous pouvez faire pour qu’ils vous considèrent plus favorablement.nnLes Tombe-hiver sont célèbres pour les perles qu’ils portent pour se protéger des mauvais esprits. De toute évidence, elles n’ont pas joué leur rôle, car les Tombe-hiver sont eux-mêmes devenus des agents de la corruption. Apportez-moi les perles d’esprit que vous aurez prises sur les furbolgs Tombe-hiver que vous aurez vaincus. Pour chaque série de cinq perles que vous m’apporterez, vous gagnerez la reconnaissance des Grumegueules‡显然你已经赢得了我的信任，<name>，但是你还要向我那些疑心很重的部族兄弟们证明自己并赢取信任。nn冬泉熊怪会将冬泉灵魂珠串挂在魔杖上来对付邪恶的灵魂。这些冬泉灵魂珠串显然没有发挥作用，因为冬泉熊怪都已经堕落了。从冬泉熊怪那里取来冬泉灵魂珠串，把它们交给我。你每带给我五个冬泉灵魂珠串，都可以增加木喉熊怪对你的好感。‡',
  }
},
[8470] = {
  {
    'Totem ritual de Lenha Morta‡Ритуальный тотем Мертвого Леса‡Ritualtotem der Totenwaldfelle‡마른가지일족 의식의 토템‡El tótem de ritual Muertobosque‡El tótem de ritual Muertobosque‡Le totem rituel mort-bois‡木喉熊怪的盟友‡死木儀式圖騰',
    nil,
    'Leve o Totem Ritual de Lenha Morta para dentro do Domínio dos Presamatos e veja se um dos pelursos dali tem alguma utilidade para o artefato. Os Presamatos não lhe dirigirão a palavra a não ser que você tenha alcançado, no mínimo, a reputação de <tolerado/tolerada> entre eles.‡Отнесите ритуальный тотем Мертвого Леса в Крепость Древобрюхов и посмотрите, не пригодится ли этот предмет кому из тамошних фурболгов. Фурболги Крепости Древобрюхов не станут говорить с вами – разве что их отношение к вам нейтральное или лучше.‡Bringt das Ritualtotem in die Holzschlundfeste und findet heraus, ob einer der dortigen Furbolgs eine Verwendung für diesen Gegenstand hat. Die Furlbolgs der Holzschlundfeste werden solange nicht mit Euch sprechen, bis Euer Ruf bei ihnen neutral oder höher ist.‡나무구렁 요새 안으로 마른가지일족 의식의 토템을 가지고 가서 그 용도를 알아낼 수 있는 펄볼그를 찾아야 합니다. 중립적 이상의 평판을 받아야만 나무구렁일족과 대화할 수 있습니다.‡Lleva el tótem de ritual Muertobosque al interior del Bastión Fauces de Madera. A ver si alguno de los fúrbolgs que hay en él sabe dar uso al objeto. Los Fauces de Madera no hablarán contigo si no tienes un nivel de reputación neutral o superior con ellos.‡Lleva el tótem de ritual Muertobosque al interior del Bastión Fauces de Madera. A ver si alguno de los fúrbolgs que hay en él sabe dar uso al objeto. Los Fauces de Madera no hablarán contigo si no tienes un nivel de reputación neutral o superior con ellos.‡Amener le Totem rituel mort-bois à l\'intérieur du repaire des Grumegueules et voir si l\'un des furbolgs qui s\'y trouvent est capable d\'en faire quelque chose. Les Grumegueules ne vous adresseront pas la parole s\'ils ne sont pas Neutres à votre égard, au minimum.‡把死木仪祭图腾带到木喉要塞然后看看是否有熊人可以使用它。木喉要塞的熊人只有当你的声望达到中立或者更高的时候才会和你说话。‡帶著死木儀式圖騰進入木喉要塞，看看有沒有熊怪對這物品有用途的。除非你達到中立聲望值或比他們更好，否則木喉不會跟你說話。',
  }
},
[8471] = {
  {
    'Totem Ritual Invernoso‡Ритуальный тотем Зимней Спячки‡Ritualtotem der Winterfelle‡눈사태일족 의식의 토템‡Tótem de ritual Nevada‡Tótem de ritual Nevada‡Le totem rituel tombe-hiver‡木喉熊怪的盟友‡冬泉儀式圖騰',
    nil,
    'Leve o Totem Ritual Invernoso para dentro do Domínio dos Presamatos e veja se um dos pelursos dali tem alguma utilidade para o artefato. Os Presamatos não lhe dirigirão a palavra a não ser que você tenha alcançado, no mínimo, a reputação de <tolerado/tolerada> entre eles.‡Отнесите ритуальный тотем Зимней Спячки в берлогу Древобрюхов и отдайте его фурболгу, который им заинтересуется. Никто из племени Древобрюхов не заговорит с вами, пока вы не завоюете себе среди них достойную репутацию.‡Bringt das Ritualtotem in die Holzschlundfeste und findet heraus, ob einer der dortigen Furbolgs eine Verwendung für diesen Gegenstand hat. Die Furlbolgs der Holzschlundfeste werden solange nicht mit Euch sprechen, bis Euer Ruf bei ihnen neutral oder höher ist.‡나무구렁 요새 안으로 가서 눈사태일족 의식의 토템의 용도를 알아낼 수 있는 펄볼그를 찾아야 합니다. 중립적 이상의 평판을 받아야만 나무구렁일족과 대화할 수 있습니다.‡Lleva el tótem de ritual Nevada al Bastión Fauces de Madera y averigua si alguno de los fúrbolgs sabe de su utilidad. Los Fauces de Madera no hablarán contigo si tu reputación con ellos no es como mínimo de neutral.‡Lleva el tótem de ritual Nevada al Bastión Fauces de Madera y averigua si alguno de los fúrbolgs sabe de su utilidad. Los Fauces de Madera no hablarán contigo si tu reputación con ellos no es como mínimo de neutral.‡Emportez le totem rituel tombe-hiver au Repaire des Grumegueules et voyez si l\'un des furbolgs lui trouve une utilisation. Les Grumegueules ne vous parleront pas si vous n\'avez pas à leur égard une réputation Neutre au minimum.‡把冬泉仪祭图腾拿到木喉要塞去，看看是否有熊怪想要研究一下它。只有当你在木喉要塞的声望达到中立或者更高级别的时候，木喉要塞的熊怪才会和你说话。‡將冬泉儀式圖騰帶進木喉要塞，看看是否有任何熊怪會使用這個物品。如果你沒有在木喉要塞達到中立或更高的聲望值，他們將不會與你交談。',
  }
},
[8472] = {
  {
    'Defeito grave‡Серьезная неполадка‡Schwere Fehlfunktion‡치명적인 고장‡Avería grave‡Avería grave‡Un mauvais fonctionnement‡失效的傀儡‡嚴重失靈',
    nil,
    'Consiga 6 Núcleos Arcanos das Patrulhas Arcanas que perambulam pelas ruínas de Luaprata e entregue-os ao Magíster Jaronis na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Соберите 6 волшебных сердечников с волшебных часовых, которые бродят по руинам Луносвета, и принесите их магистру Джаронису на площадь Соколиных Крыльев в лесах Вечной Песни.‡Sammelt 6 Arkankerne von den Arkanpatrouillen, die in den Ruinen von Silbermond umherstreifen, und bringt sie Magister Jaronis beim Falkenplatz im Immersangwald.‡실버문의 폐허를 배회하는 비전 순찰자들에게서 비전 핵 6개를 수집하여, 영원노래 숲의 매날개 광장에 있는 마법학자 자로니스에게 가져가야 합니다.‡Coge 6 núcleos arcanos de los patrulleros Arcanos que recorren las Ruinas de Ciudad de Lunargenta y llévaselos al magister Jaronis a la Plaza Alalcón en el Bosque Canción Eterna.‡Coge 6 núcleos arcanos de los patrulleros Arcanos que recorren las Ruinas de Ciudad de Lunargenta y llévaselos al magister Jaronis a la Plaza Alalcón en el Bosque Canción Eterna.‡Récupérez 6 Noyaux arcaniques sur les Patrouilleurs des arcanes qui circulent dans les ruines de Lune-d\'argent et rapportez-les au magistère Jaronis, sur la Place de l\'épervier dans le bois des Chants éternels.‡从游荡在银月城遗迹中的奥术巡逻者身上获取6枚奥术核心，把它们交给永歌森林鹰翼广场的魔导师亚隆尼斯。‡從銀月城廢墟閒晃的秘法巡邏者身上收集6個秘法核心帶回永歌森林給獵鷹之翼廣場的博學者賈若尼斯。',
  }
},
[8473] = {
  {
    'Trabalho sujo‡Печальное задание‡Eine traurige Aufgabe‡괴로운 임무‡Una tarea dolorosa‡Una tarea dolorosa‡Une triste tâche‡痛苦的抉择‡陰鬱任務',
    nil,
    'Mate 10 Jardineiros Murchos na Mata Queimada. Em seguida apresente-se a Larianna Fluminéola na torre a noroeste da Mata Queimada, que fica na Floresta do Canto Eterno.‡Убейте 10 высохших хранителей лесов в Выжженной роще. Вернитесь к Ларанне Речной Ветер в башне к северо-западу от Выжженной рощи в лесах Вечной Песни.‡Tötet 10 siechende Waldbehüter beim versengten Hain und meldet Euch anschließend bei Larianna Flusswind, die sich im Turm nordwestlich des versengten Hains im Immersangwald aufhält.‡불타버린 숲에 시들어버린 숲지기 10마리를 처치한 후, 영원노래 숲에 불타버린 숲의 북서쪽 탑 안에 있는 라리아나 리버윈드에게 돌아가야 합니다.‡Mata a 10 jardineros marchitos en La Arboleda Agostada y ve a informar a Larianna Ríobrisa en la torre que está al noroeste de La Arboleda Agostada en el Bosque Canción Eterna.‡Mata a 10 jardineros marchitos en La Arboleda Agostada y ve a informar a Larianna Ríobrisa en la torre que está al noroeste de La Arboleda Agostada en el Bosque Canción Eterna.‡Tuez 10 Gardes verts flétris au Bosquet incendié, puis revenez voir Larianna Ruissevent à l\'intérieur de la tour, juste au nord-ouest du Bosquet Incendié dans le Bois des Chants éternels.‡在焦痕谷一带杀死10名枯萎的护卫者，然后向永歌森林焦痕谷西北方的高塔内的拉莉亚娜·河风复命。‡在烈焰邊境殺掉10個憔悴的森林守衛者，然後到永歌森林跟拉瑞安娜·河風回報。',
  }
},
[8474] = {
  {
    'Pingente do Velho Cascabranca‡Подвеска Старого Белоствола‡Weißborkes Anhänger‡늙은 흰나무껍질의 목걸이‡El colgante del viejo Cortezablanca‡El colgante del viejo Cortezablanca‡Le pendentif du vieux Blanchécorce‡怀特巴克的坠饰‡老白樹墜飾',
    nil,
    'Encontre a pessoa que talvez tenha confeccionado o Pingente do Velho Cascabranca. Ela pode ter informações sobre o item.‡Отыщите того, кто мог изготовить подвеску Старого Белоствола. Возможно, он подскажет, что это за предмет?‡Macht die Person ausfindig, die Weißborkes Anhänger angefertigt haben könnte. Ihr könntet Hinweise über den Gegenstand erfahren.‡늙은 흰나무껍질의 목걸이를 만든 이를 찾아야 합니다. 이 물건을 알아보는 이라면 그 안에 담긴 의미를 바로 이해할 수 있을 것입니다.‡Encuentra al artesano que fabricó el colgante del viejo Cortezablanca. Quizás pueda darte información sobre el objeto.‡Encuentra al artesano que fabricó el colgante del viejo Cortezablanca. Quizás pueda darte información sobre el objeto.‡Trouvez la personne qui a fabriqué le Pendentif du vieux Blanchécorce. Elle pourra peut-être vous parler de cet objet.‡寻找制造怀特巴克的坠饰的人。他们或许会提供一些关于这件物品的线索。‡去尋找可能製作老白樹墜飾的人，他們可能認得這物品。',
  }
},
[8475] = {
  {
    'A Trilha da Morte‡Тропа Мертвых‡Die Todesschneise‡죽음의 흉터‡La Cicatriz Muerta‡La Cicatriz Muerta‡La Malebrèche‡死亡之痕‡死亡之痕',
    nil,
    'Mate 8 Pilhadores Pragossos e apresente-se à Patrulheira Jaela na Trilha da Morte, que fica na Floresta do Canto Eterno.‡Убейте 8 чумных мародеров и вернитесь к следопыту Джеле на Тропе Мертвых в лесах Вечной Песни.‡Tötet 8 Seuchenknochenplünderer und kehrt anschließend zu Waldläuferin Jaela in der Todesschneise im Immersangwald zurück.‡역병해골 약탈자 8마리를 해치우고, 영원노래 숲에 죽음의 흉터 밖에 있는 순찰자 자엘라에게 보고해야 합니다.‡Mata a 8 saqueadores huesopeste e informa a la forestal Jaela en La Cicatriz Muerta, en el Bosque Canción Eterna.‡Mata a 8 saqueadores huesopeste e informa a la forestal Jaela en La Cicatriz Muerta, en el Bosque Canción Eterna.‡Tuez 8 Pilleurs Ossepeste, puis présentez-vous au forestier Jaela à la Malebrèche dans le bois des Chants éternels.‡杀死8个瘟疫骨骸，然后向永歌森林死亡之痕的游侠杰拉复命。‡殺掉8個瘟疫之骨掠取者，然後到永歌森林的內精靈之門跟遊俠潔拉回報。',
  }
},
[8476] = {
  {
    'Defendendo o terreno‡Угроза Амани‡Amaniübergriff‡아마니의 침략‡Asentamiento Amani‡Asentamiento Amani‡L\'empiètement des Amani‡阿曼尼的进犯‡侵犯阿曼尼',
    nil,
    'A Tenente Correalba, do Retiro dos Andarilhos, que fica na Floresta do Canto Eterno, quer que você mate 5 Berserkers Amani e 5 Arremessadores de Machado Amani.‡Убейте 5 аманийских берсерков и 5 аманийских метателей топоров по просьбе лейтенанта Вестницы Зари из обители Странников, что в лесах Вечной Песни.‡Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer im Immersangwald möchte, dass Ihr 5 Berserker der Amani und 5 Axtwerfer der Amani tötet.‡영원노래 숲의 원정순찰대 산장에 있는 부관 돈러너가 아마니 광전사와 아마니 도끼투척병을 각각 5마리씩 해치워 달라고 부탁했습니다.‡La teniente Correalba de El Retiro del Errante en el Bosque Canción Eterna quiere que mates a 5 rabias y 5 lanzahachas Amani.‡La teniente Correalba de El Retiro del Errante en el Bosque Canción Eterna quiere que mates a 5 rabias y 5 lanzahachas Amani.‡Le lieutenant Coursaurore de la retraite des Pérégrins du bois des Chants éternels veut que vous tuiez 5 Berserkers amani et 5 Lanceurs de haches amani.‡永歌森林远行者居所的达恩·晨行者中尉要求你杀死5名阿曼尼狂战士和5名阿曼尼掷斧者。‡永歌森林，遠行者居所的晨路中尉，要你殺掉5個阿曼尼狂戰士和5個阿曼尼擲斧者。',
  }
},
[8477] = {
  {
    'O martelo do lanceiro‡Молот копьедела‡Der Hammer des Speermachers‡창제작자의 망치‡El martillo del maestro de lanzas‡El martillo del maestro de lanzas‡Le marteau du Taille-épieux‡制矛师之锤‡製矛者之錘',
    nil,
    'Procure o Armeiro de Lanças Otembe em Tor\'Watha, a sudeste do Retiro dos Andarilhos, e pegue o Martelo de Otembe. Em seguida, entregue o Martelo para Arathel Forjassol no Retiro dos Andarilhos, que fica na Floresta do Canto Eterno.‡Найдите в Тор\'Вате к юго-востоку от обители Странников копьедела Отембе и принесите его молот Аратель Кузне Солнца в обитель Странников, что в лесах Вечной Песни.‡Sucht in Tor\'Watha, südöstlich der Zuflucht der Weltenwanderer, nach Speermacher Otembe und bringt Otembes Hammer zu Arathel Sonnenschmied bei der Zuflucht der Weltenwanderer im Immersangwald.‡원정순찰대 산장의 남동쪽에 토르와타로 가서 창제작자 오템베를 찾은 후, 영원노래 숲의 원정순찰대 산장에 있는 아라텔 선포지에게 오템베의 망치를 가져가야 합니다.‡Ve a Tor\'Watha, al sureste de El Retiro del Errante, para buscar al maestro de lanzas Otembe y lleva el martillo de Otembe a Arathel Forjasol a El Retiro del Errante en el Bosque Canción Eterna.‡Ve a Tor\'Watha, al sureste de El Retiro del Errante, para buscar al maestro de lanzas Otembe y lleva el martillo de Otembe a Arathel Forjasol a El Retiro del Errante en el Bosque Canción Eterna.‡Fouillez Tor\'Watha au sud-est de la retraite des Pérégrins à la recherche du Taille-épieux Otembe, puis apportez le Marteau d\'Otembe à Arathel Solforge, à la retraite des Pérégrins du bois des Chants éternels.‡到远行者居所东南方的托尔瓦萨去，找到制矛师奥特姆比，将奥特姆比之锤带回远行者居所去交给阿拉瑟尔。‡去遠行者居所東南邊的托爾瓦薩找製矛者歐坦畢，帶回歐坦畢之錘給永歌森林，遠行者居所的艾瑞塞爾·光鑄。',
  }
},
[8478] = {
  {
    'Choose Your Weapon‡Выбор оружия‡Wählt Eure Waffe‡‡Elige un arma‡‡Le choix des armes‡‡',
    nil,
    nil,
  }
},
[8479] = {
  {
    'Zul\'Marosh‡Зул\'Марош‡Zul\'Marosh‡줄마로쉬‡Zul\'Marosh‡‡Zul\'Marosh‡祖玛洛什‡祖瑪羅什',
    nil,
    'Ven\'jashi, o prisioneiro troll em Tor\'Watha, quer que você entregue a Cabeça do Chefe Zul\'Marosh para ele. O Chefe Zul\'Marosh está em Zeb\'Watha, do outro lado do Lago Elrendar.‡Принесите Вень\'яши, пленному троллю в Тор\'Вате, голову вождя Зул\'Мароша. Вождя можно найти в Зеб\'Вате, за озером Элрендар.‡Ven\'jashi, der gefangene Troll in Tor\'Watha möchte, dass Ihr ihm Häuptling Zul\'Maroshs Kopf bringt. Häuptling Zul\'Marosh befindet sich in Zeb\'Watha, jenseits des Elrendarsees.‡토르와타에 포로로 잡혀 있는 트롤 벤자쉬가 족장 줄마로쉬를 처치하고 그 증거를 가져다달라고 부탁했습니다. 족장 줄마로쉬는 엘렌다르 호수 건너, 제브와타에서 찾을 수 있습니다.‡Ven\'jashi, el prisionero trol de Tor\'Watha, quiere que le lleves la cabeza del jefe Zul\'Marosh, que está en Zeb\'Watha, al otro lado del Lago Elrendar.‡Ven\'jashi, el prisionero trol de Tor\'Watha, quiere que le lleves la cabeza del jefe Zul\'Marosh, que está en Zeb\'Watha, al otro lado del Lago Elrendar.‡Ven\'jashi, le prisonnier troll de Tor\'Watha, veut que vous lui remettiez la Tête du chef Zul\'Marosh. Le chef Zul\'Marosh se trouve à Zeb\'Watha, de l\'autre côté du lac Elrendar.‡被囚禁在托尔瓦萨的巨魔俘虏文亚什要求你把祖玛洛什酋长的头颅交给他。祖玛洛什酋长居住在艾伦达尔湖对岸的塞布瓦萨。‡凡加許，托爾瓦薩的食人妖囚犯，要你把祖瑪羅什酋長之顱帶給他。酋長祖瑪羅什就在拉伯瓦薩，艾蘭達之湖對面。',
  }
},
[8480] = {
  {
    'Armamentos perdidos‡Потерянное оружие‡Zurückgelassene Waffen‡잃어버린 무기 수집‡El armamento perdido‡El armamento perdido‡Les armes perdues‡失落的军备‡丟失的裝備',
    nil,
    'Entregue 8 Armamentos Sin\'dorei para Velendris Matinalba na Floresta do Canto Eterno.‡Принесите 8 комплектов оружия син\'дорай Велендрису Белому Рассвету в лесах Вечной Песни.‡Bringt 8 Waffen der Sin\'dorei zu Velendris Weißflor im Immersangwald.‡영원노래 숲에 있는 벨렌드리스 화이트몬에게 신도레이 무기 8개를 가져가야 합니다.‡Lleva 8 armas sin\'dorei a Velendris Albodía al Bosque Canción Eterna.‡Lleva 8 armas sin\'dorei a Velendris Albodía al Bosque Canción Eterna.‡Rapporter 8 Armes sin\'dorei à Velendris Blancmatin, dans le bois des Chants éternels.‡将8个辛多雷军备物品交给永歌森林的维雷迪斯·雪晨。‡帶回8個辛多雷軍備給永歌森林的微蘭德絲·白晨。',
  }
},
[8481] = {
  {
    'A raiz de todo o mal‡Корень всех зол‡Die Wurzel alles Bösen‡모든 악의 근원‡La raíz de todos los males‡La raíz de todos los males‡La racine du mal‡万恶之源‡萬惡根源',
    nil,
    'Bote a Tocha de Evocação Demoníaca na entrada da caverna do Chefe Supremo Invernoso, na aldeia dos pelursos Invernosos. Em seguida, derrote o demônio, recolha a Essência de Shandivious e entregue-a para Gorn Caolho, no Domínio dos Presamatos.‡Установите факел призыва демона у входа в пещеру верховного вождя племени Зимней Спячки в деревне фурболгов Зимней Спячки. Сразите демона и добудьте сущность Зандивиуса для Горна Одноглаза из Крепости Древобрюхов.‡Stellt die Fackel zur Dämonenbeschwörung im Eingang der Höhle des Oberhäuptlings der Winterfelle, im Lager der Winterfellfurbolgs auf. Besiegt den Dämon und erlangt die Essenz von Xandivious für Gorn Einauge in der Holzschlundfeste.‡눈사태일족 펄볼그 마을에 있는 대족장 눈사태의 동굴 입구에 악마 소환의 횃불을 꽂은 후 악마를 해치우고 나무구렁 요새에 있는 외눈 고른에게 잔디비어스의 정수를 가져가야 합니다.‡Clava la antorcha para invocar demonios en la entrada de la cueva del Gran Jefe Nevada en el Poblado Nevada de los fúrbolgs. Derrota al demonio y consigue la esencia de Xandivious para Monóculo de Gorn del Bastión Fauces de Madera.‡Clava la antorcha para invocar demonios en la entrada de la cueva de Grolnar en el Poblado Nevada de los fúrbolgs. Derrota al demonio y consigue la esencia de Xandivious para Monóculo de Gorn en el Bastión Fauces de Madera.‡Plantez la Torche d\'invocation de démon à l\'entrée de la caverne du grand chef Tombe-hiver, dans le village des furbolgs Tombe-hiver. Triomphez du démon et récupérez l\'Essence de Xandivious pour Gorn le Borgne du Repaire des Grumegueules.‡把恶魔召唤火炬放在寒水村的冬泉酋长的洞穴入口处。击败召唤出来的恶魔，然后把沙迪维尔斯精华交给木喉要塞的独眼高恩。‡將惡魔召喚火炬放置在冬泉熊怪村的冬泉酋長洞穴口。擊敗惡魔並將沙迪維爾斯精華帶給木喉要塞的獨眼高恩。',
  }
},
[8482] = {
  {
    'Documentos incriminadores‡Обличающие документы‡Belastende Dokumente‡첩보 문서‡Documentos incriminadores‡Documentos incriminadores‡Les documents compromettants‡秘密文件‡控告文件',
    nil,
    'Leve os Documentos Incriminadores para Aledon Marcassol na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Отнесите обличающие документы Аэльдону Озаренному Солнцем на площадь Соколиных Крыльев в лесах Вечной Песни.‡Bringt die belastenden Dokumente zu Aeldon Sonnenmal auf dem Falkenplatz im Immersangwald.‡영원노래 숲의 매날개 광장에 있는 앨돈 선브랜드에게 첩보 문서를 가져가야 합니다.‡Lleva los documentos incriminadores a Aeldon Marcasol a la Plaza Alalcón en el Bosque Canción Eterna.‡Lleva los documentos incriminadores a Aeldon Marcasol a la Plaza Alalcón en el Bosque Canción Eterna.‡Remettre les Documents compromettants à Aeldon Signesol sur la Place de l\'épervier, dans le bois des Chants éternels.‡将秘密文件交给永歌森林鹰翼广场的艾尔杜·炙痕。‡將控告文件交給艾爾頓·桑布蘭德，他在永歌森林的內精靈之門。',
  }
},
[8483] = {
  {
    'O espião enânico‡Дворфийский шпион‡Der zwergische Spion‡드워프 첩자‡El espía enano‡El espía enano‡L\'espion des nains‡矮人间谍‡矮人間諜',
    nil,
    'Entregue a Cabeça do Minerador Bigorneiro para Aledon Marcassol na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Принесите голову геолога Стража Наковальни Аэльдону Озаренному Солнцем на площадь Соколиных Крыльев в лесах Вечной Песни.‡Bringt den Kopf von Ausgrabungsleiter Ambossel zu Aeldon Sonnenmal beim Falkenplatz im Immersangwald.‡조사단 앤빌워드를 제거한 다음 영원노래 숲의 매날개 광장에 있는 앨돈 선브랜드에게 그 증거를 가져가야 합니다.‡Lleva la cabeza del prospector Guardayunque a Aeldon Marcasol a la Plaza Alalcón, en el Bosque Canción Eterna.‡Lleva la cabeza del prospector Guardayunque a Aeldon Marcasol a la Plaza Alalcón, en el Bosque Canción Eterna.‡Aeldon Signesol, sur la Place de l\'Épervier du Bois des Chants éternels, veut la Tête du prospecteur Garde-enclume.‡将安威瓦尔德的头颅交给永歌森林鹰翼广场的艾尔杜·炙痕。‡帶回勘察員安維瓦德之顱給艾爾頓·桑布蘭德。他在永歌森林的獵鷹之翼廣場。',
  }
},
[8484] = {
  {
    'Promovendo a paz‡Знак мира‡Das Bemühen um Frieden‡평화 협정‡Negociar la paz‡Negociar la paz‡Négocier la paix‡重铸和平‡重鑄和平',
    nil,
    'Leve a Oferenda de Paz dos Presamatos ao Rei Magni Barbabronze em Altaforja.‡Отнесите мирное приношение Древобрюхов королю Магни Бронзобороду в Стальгорн.‡Bringt das Friedensangebot der Holzschlundfeste zu König Magni Bronzebart in Eisenschmiede.‡아이언포지에 있는 국왕 마그니 브론즈비어드에게 평화의 나무구렁일족 공물을 가져가야 합니다.‡Llévale la ofrenda de paz de los Fauces de Madera al rey Magni Barbabronce de Forjaz.‡Llévale la ofrenda de paz de los Fauces de Madera al rey Magni Barbabronce de Forjaz.‡Apporter l\'Offrande de paix grumegueule au roi Magni Barbe-de-bronze, à Forgefer.‡将木喉和平契约交给铁炉堡的国王麦格尼·铜须。‡將木喉的和平契約帶給鐵爐堡的國王麥格尼·銅鬚。',
  }
},
[8485] = {
  {
    'Promovendo a paz‡Знак мира‡Das Bemühen um Frieden‡평화 협정‡Negociar la paz‡Negociar la paz‡Négocier la paix‡重铸和平‡重鑄和平',
    nil,
    'Leve a Oferenda de Paz dos Presamatos para Thrall em Orgrimmar.‡Отнесите мирное приношение Древобрюхов Траллу в Оргриммар.‡Bringt das Friedensangebot der Holzschlundfeste zu Thrall in Orgrimmar.‡오그리마의 스랄에게 평화의 나무구렁일족 공물을 가져가야 합니다.‡Llévale la ofrenda de paz de los Fauces de Madera a Thrall, que está en Orgrimmar.‡Llévale la ofrenda de paz de los Fauces de Madera a Shok Narnes a Orgrimmar.‡Apporter l\'Offrande de paix grumegueule à Thrall, à Orgrimmar.‡将木喉和平契约交给奥格瑞玛的萨尔。‡帶回木喉和平契約給奧格瑪的索爾。',
  }
},
[8486] = {
  {
    'Instabilidade arcana‡Магическая нестабильность‡Arkane Instabilität‡불안정한 성소‡Inestabilidad arcana‡Inestabilidad arcana‡L\'instabilité arcanique‡不稳定的奥术‡秘法不穩定性',
    nil,
    'A Protetora de Meridianos Velania quer que você mate 5 Espectros de Mana e 5 Espreitadores de Mana.‡Убейте 5 магических призраков и 5 волшебных охотников по просьбе хранительницы энергии Велании.‡Leybewahrerin Velania möchte, dass Ihr 5 Managespenster und 5 Manapirscher tötet.‡맥지기 벨라니아가 마나 망령과 마나 추적자를 각각 5마리씩 처치해 달라고 부탁했습니다.‡La vigilante-Ley Velania quiere que mates 5 espectros de maná y 5 acechadores de maná.‡La vigilante-Ley Velania quiere que mates 5 espectros de maná y 5 acechadores de maná.‡La telluriste Velania veut que vous tuiez 5 Âmes en peine de mana et 5 Traqueurs de mana.‡魔网监护者薇兰妮亚要求你杀死5只法力怨灵和5只法力漫步者。‡牧地看守者維蘭妮雅要你殺死5個法力怨靈和5個法力行者。',
  }
},
[8487] = {
  {
    'Solo conspurcado‡Зараженная почва‡Besudelte Erde‡오염된 땅‡Tierra corrupta‡Tierra corrupta‡Le sol contaminé‡被腐蚀的土地‡被汙染的土壤',
    nil,
    'A Aprendiz Mirveda, do Sacrário do Leste, que fica na Floresta do Canto Eterno, quer que você colete 8 Amostras de Solo Infecto.‡Соберите 8 проб зараженной земли для ученицы Мирведы в Восточном святилище, что в лесах Вечной Песни.‡Lehrling Mirveda beim Sanktum des Ostens im Immersangwald möchte, dass Ihr 8 besudelte Erdproben einsammelt.‡영원노래 숲의 동부 성소에 있는 수습생 미르베다가 오염된 토양 견본 8개를 모아 달라고 부탁했습니다.‡La aprendiza Mirveda del Sagrario del Este en el Bosque Canción Eterna quiere que le lleves 8 muestras de tierra mácula.‡La aprendiza Mirveda del Sagrario del Este en el Bosque Canción Eterna quiere que le lleves 8 muestras de tierra mácula.‡L\'apprentie Mirveda au Sanctum oriental dans le bois des Chants éternels veut que vous collectiez 8 Échantillons de terre contaminée.‡永歌森林东部圣殿的学徒米尔维达要求你收集8堆被污染的土壤样本。‡永歌森林東部聖所的學徒莫維達要你收集8份受污染的泥土樣本。',
  }
},
[8488] = {
  {
    'Resultados inesperados‡Неожиданный результат‡Ungewöhnliche Ergebnisse‡예상 밖의 결과‡Resultados inesperados‡Resultados inesperados‡Des résultats inattendus‡出人意料的结果‡意外的結果',
    nil,
    'Proteja a Aprendiz Mirveda da emboscada do Flagelo.‡Защитите ученицу Мирведу от Плети, напавшей из засады.‡Beschützt Lehrling Mirveda vor dem Angriff der Geißel.‡스컬지의 습격으로부터 수습생 미르베다를 보호해야 합니다.‡Protege a la aprendiza Mirveda de la emboscada de la Plaga.‡Protege a la aprendiza Mirveda de la emboscada de la Plaga.‡Protéger l\'apprentie Mirveda de l\'embuscade du Fléau.‡保护学徒米尔维达免遭天灾军团的伤害。‡保護學徒莫維達免於天譴軍團的伏擊。',
  }
},
[8489] = {
  {
    'An Intact Converter‡Невредимый преобразователь‡Ein intakter Wandler‡온전한 변환기‡El conversor intacto‡‡Un convertisseur intact‡DEPRECATED‡完整奧金轉換器',
    nil,
    'Bring the Intact Arcane Converter to Ley-Keeper Velania.‡Принесите хранительнице энергии Велании невредимый чародейский преобразователь.‡Bringt den intakten Arkanwandler zu Leybewahrerin Velania.‡맥지기 벨라니아에게 온전한 비전 변환기를 가져가야 합니다.‡Lleva el conversor arcano intacto a la vigilante-Ley Velania.‡Lleva el conversor arcano intacto a la vigilante-Ley Velania.‡Apporter le Convertisseur arcanique intact à la telluriste Velania.‡将Intact Arcane Converter带给Ley-Keeper Velania。‡把完整奧金轉換器帶給牧地看守者維蘭妮雅。',
  }
},
[8490] = {
  {
    'Fortalecendo as defesas!‡Усиление обороны‡Wiederaufladen der Verteidigung‡방어선에 동력 공급‡Reforzando las defensas‡Reforzando las defensas‡Renforcer nos défenses‡增强防御‡增強我們的防禦',
    nil,
    'Insira o Cristal Infuso na Pedra Rúnica do Leste e proteja-a do Flagelo por 1 minuto. Entregue o Cristal Infuso para o Guarda-runas Deryan na Floresta do Canto Eterno para receber a recompensa.‡Установите заряженный кристалл рядом с восточным руническим камнем и в течение одной минуты обороняйте его от нежити. Затем верните кристалл хранителю рун Дериану в лесах Вечной Песни и получите награду.‡Platziert den energieerfüllten Kristall beim Runenstein des Ostens und verteidigt ihn 1 Minute lang vor der Geißel. Bringt den energieerfüllten Kristall anschließend zu Runenwächter Deryan im Immersangwald, um Eure Belohnung zu erhalten.‡동부 마법석에 마력 깃든 수정을 놓은 후 스컬지의 공격으로부터 1분 동안 지켜내야 합니다. 영원노래 숲에 있는 마법석 파수꾼 데리안에게 마력 깃든 수정을 가지고 돌아가서 보상을 받으십시오.‡Pon el cristal imbuido en la Piedra rúnica del este y protégelo de la Plaga durante 1 minuto. Devuélvele el cristal al celador de las runas Deryan en el Bosque Canción Eterna y tendrás una recompensa.‡Pon el cristal imbuido en la Piedra rúnica del este y protégelo de la Plaga durante 1 minuto. Devuélvele el cristal al celador de las runas Deryan en el Bosque Canción Eterna y tendrás una recompensa.‡Placez le Cristal infusé contre la Pierre runique de l\'est et protégez-le du Fléau pendant 1 minute. Rapportez le Cristal infusé au garderune Deryan dans le bois des Chants éternels pour recevoir votre récompense.‡将魔能水晶放置在东部符石上，并确保它在1分钟之内免遭天灾军团的攻击。之后将魔能水晶交给永歌森林的符文看守者德尔雅，以换取你的奖励。‡將灌能水晶放在東符文石上並保護它不受天譴軍團破壞1分鐘。將灌能水晶交給永歌森林的符文守護者德蘭並領取獎勵。',
  }
},
[8491] = {
  {
    'Caça às peles‡Добывание шкур‡Pelzjagd‡모피 수집‡Caza de pelambres‡Caza de pelambres‡Récupérer des fourrures‡收集豹皮‡收集毛皮',
    nil,
    'Velan Roburclaro, da Vila de Brisabela, que fica na Floresta do Canto Eterno, quer que você leve 6 Pelagens de Garrataque para ele.‡Принесите 6 шкур прыголапов Велану Светлому Тополю из деревни Легкий Ветерок, что в лесах Вечной Песни.‡Velan Lichteiche in Morgenluft im Immersangwald möchte, dass Ihr ihm 6 Bachtatzenfelle bringt.‡영원노래 숲의 산들바람 마을에 있는 벨렌 브라이트오크가 갈기발 스라소니 모피 6개를 가져다 달라고 부탁했습니다.‡Velan Roblebrillante de la Aldea Brisa Pura en el Bosque Canción Eterna quiere que le lleves 6 pelambres de garragil.‡Velan Roblebrillante de la Aldea Brisa Pura en el Bosque Canción Eterna quiere que le lleves 6 pelambres de garragil.‡Velan Brillechêne à Brise-clémente dans le bois des Chants éternels veut que vous lui apportiez 6 Fourrures de Preste-patte.‡永歌森林晴风村的维兰·布雷托克要求你帮他收集6张魔泉豹皮。‡維嵐·布萊圖克要你帶回6個泉爪之皮給他。他在永歌森林的晴風村。',
  }
},
[8492] = {
  {
    'A Aliança precisa de barras de cobre!‡Альянсу не хватает медных слитков!‡Die Allianz braucht Kupferbarren!‡얼라이언스에 구리 주괴 조달!‡¡La Alianza necesita lingotes de cobre!‡¡La Alianza necesita lingotes de cobre!‡L\'Alliance a besoin de barres de cuivre !‡联盟需要铜锭！‡聯盟需要銅錠!',
    nil,
    'Leve 20 Barras de Cobre ao Sargento Pedracenho na Ala Militar de Altaforja.‡Принесите 20 медных слитков сержанту Камнелобу в Палаты войны Стальгорна.‡Bringt 20 Kupferbarren zu Unteroffizier Steinbraue im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 하사관 스톤브로우에게 구리 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de cobre al alférez Petrocejas en La Sala Militar de Forjaz.‡Llévale 20 lingotes de cobre al sargento Petrocejas en La Sala Militar de Forjaz.‡Ramener 20 barres de cuivre au sergent Front-de-pierre dans la Garde militaire de Forgefer.‡把20块铜锭交给丹莫罗飞机场的布罗恩·石眉。‡帶20個銅錠給鐵爐堡軍事區的石眉中尉。',
  }
},
[8493] = {
  {
    'A Aliança precisa de mais barras de cobre!‡Альянсу все еще не хватает медных слитков!‡Die Allianz braucht mehr Kupferbarren!‡얼라이언스에 구리 주괴 추가 조달!‡¡La Alianza necesita más lingotes de cobre!‡¡La Alianza necesita más lingotes de cobre!‡L\'Alliance a besoin de plus de barres de cuivre !‡联盟需要更多铜锭！‡',
    nil,
    'Leve 20 Barras de Cobre ao Sargento Pedracenho na base aérea de Dun Morogh.‡Принесите 20 медных слитков сержанту Каменлобу в Военный двор Стальгорна.‡Bringt 20 Kupferbarren zu Unteroffizier Steinbraue beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 하사관 스톤브로우에게 구리 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de cobre al sargento Petrocejas en la base aérea de Dun Morogh.‡Llévale 20 lingotes de cobre al sargento Petrocejas en la base aérea de Dun Morogh.‡Ramener 20 barres de cuivre au sergent Front-de-pierre à l\'aérodrome de Dun Morogh.‡把20块铜锭交给丹莫罗飞机场的布罗恩·石眉。‡',
  }
},
[8494] = {
  {
    'A Aliança precisa de barras de ferro!‡Альянсу не хватает железных слитков!‡Die Allianz braucht Eisenbarren!‡얼라이언스에 철 주괴 조달!‡¡La Alianza necesita barras de hierro!‡¡La Alianza necesita barras de hierro!‡L\'Alliance a besoin de barres de fer !‡联盟需要铁锭！‡聯盟需要鐵錠!',
    nil,
    'Leve 20 Barras de Ferro ao Cabo Carens na Ala Militar de Altaforja.‡Принесите 20 железных слитков капралу Карнсу в Палаты войны Стальгорна.‡Bringt 20 Eisenbarren zu Korporal Schwarz im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 하사관 칸스에게 철 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de hierro al cabo Carnes en La Sala Militar de Forjaz.‡Llévale 20 barras de hierro al cabo Carnes en La Sala Militar de Forjaz.‡Ramener 20 barres de fer au caporal Carnes dans la Garde militaire de Forgefer.‡把20块铁锭交给丹莫罗飞机场的卡恩斯下士。‡帶20個鐵錠給鐵爐堡軍事區的卡恩斯下士。',
  }
},
[8495] = {
  {
    'A Aliança precisa de mais barras de ferro!‡Альянсу по-прежнему не хватает железных слитков!‡Die Allianz braucht mehr Eisenbarren!‡얼라이언스에 철 주괴 추가 조달!‡¡La Alianza necesita más barras de hierro!‡¡La Alianza necesita más barras de hierro!‡L\'Alliance a besoin de plus de barres de fer !‡联盟需要更多铁锭！‡',
    nil,
    'Leve 20 Barras de Ferro ao Cabo Carens na base aérea de Dun Morogh.‡Принесите 20 железных слитков капралу Карнсу на аэродром в Дун Морог.‡Bringt 20 Eisenbarren zu Korporal Schwarz beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 하사관 칸스에게 철 주괴 20개를 가져가야 합니다.‡Llévale 20 barras de hierro al cabo Carnes en la base aérea de Dun Morogh.‡Llévale 20 barras de hierro al cabo Carnes en la base aérea de Dun Morogh.‡Ramener 20 barres de fer au caporal Carnes à l\'aérodrome de Dun Morogh.‡把20块铁锭交给丹莫罗飞机场的卡恩斯下士。‡',
  }
},
[8496] = {
  {
    'Bandagens para o campo‡Запас бинтов‡Verbände für den Feldeinsatz‡전장에 붕대 공급‡Vendas para el campo de batalla‡Vendas para el campo de batalla‡Des bandages pour la campagne‡战场上的绷带‡戰場上的繃帶',
    nil,
    'Leve 30 Bandagens Grossas de Runatrama, 30 Bandagens Grossas de Seda e 30 Bandagens Grossas de Magitrama para o Arauto do Vento Chifre Altivo, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística X para concluir esta missão.‡Принесите 30 плотных бинтов из рунической ткани, 30 плотных шелковых бинтов и 30 плотных бинтов из магической ткани призывательнице ветров Гордый Рог в крепость Кенария в Силитусе. Кроме того сдайте тыловую задачу X.‡Bringt 30 schwere Runenstoffverbände, 30 schwere Seidenverbände und 30 schwere Magiestoffverbände zu Windruferin Prachthorn auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz X, um diese Aufgabe abschließen zu können.‡실리더스 세나리온 요새에 있는 바람소환사 프라우드혼에게 두꺼운 룬매듭 붕대, 두꺼운 마법 붕대, 두꺼운 비단 붕대를 각각 30개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 X도 함께 가져가야 합니다.‡Lleva 30 vendas de paño rúnico grueso, 30 vendas de seda gruesa y 30 vendas de tejido mágico grueso a Clamavientos Cuernorgullo en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas X para poder completar la misión.‡Lleva 30 vendas de paño rúnico gruesas, 30 vendas de seda gruesas y 30 vendas de tejido mágico gruesas a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas X para poder completar la misión.‡Apportez 30 Bandages épais en étoffe runique, 30 Bandages épais en soie et 30 Bandages épais en tisse-mage à l\'imploratrice céleste Corne-fière. Vous devez aussi apporter le Briefing logistique X pour terminer cette quête.‡把30根厚符文布绷带、30根厚魔纹绷带和30根厚丝质绷带交给唤风者梅恩·长角。你还必须随身带着后勤任务简报 X才能完成这个任务。‡將30個厚符文布繃帶，30個厚絲質繃帶和30個厚魔紋繃帶到希利蘇斯給塞納里奧城堡的喚風者傲角。你還必須將後勤任務簡報 X帶去才能完成這個任務。',
  }
},
[8497] = {
  {
    'Kits de sobrevivência no deserto‡Неприкосновенный запас‡Wüstenüberlebenspaket‡사막 긴급구호 물자‡Material de supervivencia en el desierto‡Material de supervivencia en el desierto‡Survivre dans le désert‡沙漠生存包‡沙漠生存包',
    nil,
    'Leve 4 Globos d\'Água, 4 Antipeçonhas Poderosos e 4 Bolinhos Defumados do Deserto para Calandrath na estalagem do Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística I para completar esta tarefa.‡Принесите 4 сферы воды, 4 мощных противоядия и 4 копченые пустынные клецки Каландрате в таверну в крепости Кенария в Силитусе. Кроме того, сдайте тыловую задачу I.‡Bringt 4 Kugeln des Wassers, 4 mächtige Gegengifte und 4 geräucherte Wüstenknödel zu Calandrath in der Taverne von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz I, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새 여관에 있는 캘랜드라스에게 물의 보주, 강력한 해독제, 훈제 사막 경단을 각각 4개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 I도 함께 가져가야 합니다.‡Lleva 4 globos de agua, 4 contravenenos potentes y 4 albóndigas del desierto ahumadas a Calandrath en la taberna del Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas I para poder completar la misión.‡Lleva 4 globos de agua, 4 contravenenos potentes y 4 albóndigas del desierto ahumadas a Calandrath en la taberna del Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas I para poder completar la misión.‡Ramener 4 Globes d\'eau, 4 Anti-venins puissants et 4 Boulettes fumées du désert à Calandrath, à l\'auberge du Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique I pour terminer cette quête.‡把4份纯水之球、4份特效抗毒药剂和4份烤鲑鱼交给希利苏斯塞纳里奥要塞的卡兰德拉斯。你还必须随身带着后勤任务简报 I才能完成这个任务。‡帶4個純水之球，4個特強抗毒藥劑和4個沙漠肉丸子帶到希利蘇斯給塞納里奧城堡旅店的卡蘭德拉斯。你還必須將後勤任務簡報 I帶去才能完成這個任務。',
  }
},
[8498] = {
  {
    'Ordens de Batalha do Martelo do Crepúsculo‡Боевые приказы Сумеречного Молота‡Schlachtordnungen des Schattenhammerklans‡황혼의 전투명령서‡Órdenes de batalla de Crepusculares‡Órdenes de batalla Crepusculares‡Les ordres de bataille du Crépuscule‡暮光作战命令‡暮光作戰命令',
    nil,
    'Obtenha as Ordens de Batalha do Martelo do Crepúsculo e leve-as ao Comandante Mar\'alith no Forte Cenariano, que fica em Silithus. Você também precisa entregar as Instruções Táticas X para concluir a missão.‡Добудьте боевые приказы Сумеречного Молота и отнесите их командору Мар\'алиту в крепость Кенария в Силитусе. Для завершения задания понадобится тактическая задача X.‡Beschafft Euch die Schlachtordnungen des Schattenhammerklans und bringt sie zu Kommandant Mar\'alith auf Burg Cenarius in Silithus. Ihr benötigt auch den taktischen Einsatz X, um diese Aufgabe abschließen zu können.‡황혼의 전투명령서를 찾아서 실리더스의 세나리온 요새에 있는 지휘관 마랄리스에게 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 X도 함께 가져가야 합니다.‡Consigue las órdenes de batalla de Crepusculares y llévaselas al comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas tácticas X para poder completar la misión.‡Consigue las órdenes de batalla Crepusculares y llévaselas al comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas tácticas X para poder completar la misión.‡Vous procurer les Ordres de bataille du Crépuscule et les ramener au commandant Mar\'alith, au Fort cénarien de Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique X.‡拿到暮光作战命令然后带给希利苏斯塞纳里奥要塞的指挥官玛尔利斯。‡取得暮光作戰命令並將它們帶到希利蘇斯給塞納里奧城堡的指揮官瑪爾利斯。你還必須將戰術任務簡報 X帶去才能完成這個任務。',
  }
},
[8499] = {
  {
    'A Aliança precisa de barras de tório!‡Альянсу не хватает ториевых слитков!‡Die Allianz braucht Thoriumbarren!‡얼라이언스에 토륨 주괴 조달!‡¡La Alianza necesita barras de torio!‡¡La Alianza necesita barras de torio!‡L\'Alliance a besoin de barres de thorium !‡联盟需要瑟银锭！‡聯盟需要瑟銀錠!',
    nil,
    'Leve 20 Barras de Tório à Dama Duas-tranças na Ala Militar de Altaforja.‡Принесите 20 ториевых слитков госпоже Двукоссе в Палаты войны Стальгорна.‡Bringt 20 Thoriumbarren zu Dame Doppelzopf im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 남작부인 트윈브레이드에게 토륨 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de torio a Dama Trenzado en La Sala Militar de Forjaz.‡Llévale 20 barras de torio a Dama Trenzado en La Sala Militar de Forjaz.‡Ramener 20 Barres de thorium à dame Doublenattes dans la Garde militaire de Forgefer.‡把20块瑟银锭交给丹莫洛飞机场的达米。‡帶20個瑟銀錠給鐵爐堡軍事區的妲姆·雙辮。',
  }
},
[8500] = {
  {
    'A Aliança precisa de mais barras de tório!‡Альянсу по-прежнему не хватает ториевых слитков!‡Die Allianz braucht mehr Thoriumbarren!‡얼라이언스에 토륨 주괴 추가 조달!‡¡La Alianza necesita más barras de torio!‡¡La Alianza necesita más barras de torio!‡L\'Alliance a besoin de plus de barres de thorium !‡联盟需要更多瑟银锭！‡',
    nil,
    'Leve 20 Barras de Tório à Dama Duas-tranças na base aérea de Dun Morogh.‡Принесите 20 ториевых слитков госпоже Двукоссе на аэродром в Дун Морог.‡Bringt 20 Thoriumbarren zu Dame Doppelzopf beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 남작부인 트윈브레이드에게 토륨 주괴 20개를 가져가야 합니다.‡Llévale 20 barras de torio a Dama Trenzado en la base aérea de Dun Morogh.‡Llévale 20 barras de torio a Dama Trenzado en la base aérea de Dun Morogh.‡Apportez 20 Barres de thorium à Dame Doublenattes à l\'aérodrome de Dun Morogh.‡把20块瑟银锭交给丹莫洛飞机场的达米。‡',
  }
},
[8501] = {
  {
    'Alvo: aguilhantes da Colme\'Ashi‡Цель: острожалы из улья Аши‡Ziel: Stecher des Ashischwarms‡목표: 독침 하이브아쉬‡Objetivo: los aguijoneros Colmen\'Ashi‡Objetivo: los aguijoneros Colmen\'Ashi‡Objectif : les aiguillonneurs de la Ruche\'Ashi‡目标：亚什毒蝎‡目標:亞什毒蠍',
    nil,
    'Mate 30 Aguilhantes da Colme\'Ashi e fale novamente com o Comandante Mar\'alith no Forte Cenariano, que fica em Silithus. Você também precisa entregar as Instruções de Combate XII para concluir a missão.‡Убейте 30 острожалов из улья Аши и доложите о выполнении задания командору Мар\'алиту в крепости Кенария в Силитусе. Для завершения задания принесите боевую задачу XII.‡Tötet 30 Stecher des Ashischwarms und erstattet anschließend Bericht bei Kommandant Mar\'alith auf Burg Cenarius in Silithus. Ihr benötigt auch Kampfeinsatz XII, um diese Aufgabe abschließen zu können.‡독침 하이브아쉬 30마리를 처치한 후 실리더스 세나리온 요새에 있는 지휘관 마랄리스에게 보고하십시오. 이 임무를 완료하려면 전투 임무 지령 XII를 가져가야 합니다.‡Mata 30 aguijoneros Colmen\'Ashi y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate XII para poder completar la misión.|n‡Mata 30 aguijoneros Colmen\'Ashi y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate XII para poder completar la misión.‡Tuez 30 Aiguillonneurs de la Ruche\'Ashi, puis présentez-vous au rapport devant le commandant Mar\'alith au Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing de combat XII.‡击杀30只亚什毒蝎，然后向塞纳里奥要塞的指挥官玛尔利斯复命。你还必须带着作战任务简报 XII才能完成这个任务。‡殺死30隻亞什毒蠍並回到希利蘇斯向塞納里奧城堡的指揮官瑪爾利斯報告。你還必須將作戰任務簡報 XII帶去才能完成這個任務。',
  }
},
[8502] = {
  {
    'Alvo: trabalhadores da Colme\'Ashi‡Цель: рабочие из улья Аши‡Ziel: Arbeiter des Ashischwarms‡목표: 일꾼 하이브아쉬‡Objetivo: los trabajadores Colmen\'Ashi‡Objetivo: los trabajadores Colmen\'Ashi‡Objectif : les ouvrières de la Ruche\'Ashi‡目标：亚什工蝎‡目標:亞什工蠍',
    nil,
    'Mate 30 Trabalhadores da Colme\'Ashi e fale novamente com o Comandante Mar\'alith no Forte Cenariano, que fica em Silithus. Você também precisa entregar as Instruções de Combate III para concluir a missão.‡Убейте 30 рабочих из улья Аши и доложите о выполнении задания командору Мар\'алиту в крепости Кенария в Силитусе. Для завершения задания принесите боевую задачу III.‡Tötet 30 Arbeiter des Ashischwarms und erstattet Bericht bei Kommandant Mar\'alith auf Burg Cenarius in Silithus. Ihr benötigt auch Kampfeinsatz III, um diese Aufgabe abschließen zu können.‡일꾼 하이브아쉬 30마리를 처치해야 한 다음 실리더스 세나리온 요새에 있는 지휘관 마랄리스에게 보고하십시오. 또한, 이 퀘스트를 완료하려면 전투 임무 지령 III도 함께 가져가야 합니다.‡Mata 30 trabajadores Colmen\'Ashi y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate III para poder completar la misión.‡Mata 30 trabajadores Colmen\'Ashi y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate III para poder completar la misión.‡Tuez 30 Ouvrières de la Ruche\'Ashi, et revenez faire votre rapport au commandant Mar\'alith au Fort cénarien, en Silithus. Vous devez aussi apporter le Briefing de combat III pour terminer cette quête.‡击杀30只亚什工蝎，然后向塞纳里奥要塞的指挥官玛尔利斯复命。你还必须带着作战任务简报 III才能完成这个任务。‡殺死30隻亞什工蠍再回到希利蘇斯向塞納里奧城堡的指揮官瑪爾利斯回報。你還必須將作戰任務簡報III帶去才能完成這個任務。',
  }
},
[8503] = {
  {
    'A Aliança precisa de estrangulalgas!‡Альянсу не хватает удавника!‡Die Allianz braucht Würgetang!‡얼라이언스에 갈래물풀 공급!‡¡La Alianza necesita algas estranguladoras!‡¡La Alianza necesita algas estranguladoras!‡L\'Alliance a besoin d\'étouffante !‡联盟需要荆棘藻！‡聯盟需要荊棘藻!',
    nil,
    'Leve 20 Estrangulalgas à Recruta Medeixo na Ala Militar de Altaforja.‡Принесите 20 стеблей удавника рядовому Драксельмеру в Палаты войны Стальгорна.‡Bringt 20 Stück Würgetang zu dem Gefreiten Drechselknacks im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 병사 드랙슬게이지에게 갈래물풀 20개를 가져가야 합니다.‡Llévale 20 algas estranguladoras al soldado Draxlegauge en La Sala Militar de Forjaz.‡Llévale 20 algas estranguladoras al soldado Draxlegauge en La Sala Militar de Forjaz.‡Ramener 20 Etouffantes au soldat Draunessieu dans la Garde militaire de Forgefer.‡把20棵荆棘藻交给丹莫罗飞机场的列兵德拉里格。‡帶20個荊棘藻給鐵爐堡軍事區的士兵德拉裡格。',
  }
},
[8504] = {
  {
    'A Aliança precisa de mais estrangulalga!‡Альянсу по-прежнему не хватает удавника!‡Die Allianz braucht mehr Würgetang!‡얼라이언스에 갈래물풀 추가 공급!‡¡La Alianza necesita más algas estranguladoras!‡¡La Alianza necesita más algas estranguladoras!‡L\'Alliance a besoin de plus d\'étouffante !‡联盟需要更多荆棘藻！‡',
    nil,
    'Leve 20 Estrangulalgas à Recruta Medeixo na base aérea de Dun Morogh.‡Принесите 20 стеблей удавника рядовому Драксельмеру на аэродром в Дун Морог.‡Bringt 20 Stück Würgetang zu dem Gefreiten Drechselknacks beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 병사 드랙슬게이지에게 갈래물풀 20개를 가져가야 합니다.‡Llévale 20 algas estranguladoras al soldado Draxlegauge en la base aérea de Dun Morogh.‡Llévale 20 algas estranguladoras al soldado Draxlegauge en la base aérea de Dun Morogh.‡Ramener 20 étouffantes au soldat Draunessieu à l\'aérodrome de Dun Morogh.‡把20棵荆棘藻交给丹莫罗飞机场的列兵德拉里格。‡',
  }
},
[8505] = {
  {
    'A Aliança precisa de lótus roxo!‡Альянсу не хватает лилового лотоса!‡Die Allianz braucht lila Lotus!‡얼라이언스에 보라 연꽃 공급!‡¡La Alianza necesita lotos cárdenos!‡¡La Alianza necesita lotos cárdenos!‡L\'Alliance a besoin de lotus pourpre !‡联盟需要紫莲花！‡聯盟需要紫蓮花!',
    nil,
    'Leve 20 Lótus Roxos ao Mestre Noturcanto na Ala Militar de Altaforja.‡Принесите 20 цветков лилового лотоса мастеру Ночной Песне в Палаты войны Стальгорна.‡Bringt 20 lila Lotus zu Meister Nachtweise im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 수석 연금술사 나이트송에게 보라 연꽃 20개를 가져가야 합니다.‡Llévale 20 lotos cárdenos al maestro Arrullanoche en La Sala Militar de Forjaz.‡Llévale 20 lotos cárdenos al maestro Arrullanoche en La Sala Militar de Forjaz.‡Ramener 20 lotus pourpres à maître Chantenuit, dans la Garde militaire de Forgefer.‡把20朵紫莲花交给丹莫罗飞机场的艾文·夜歌。‡帶20朵紫蓮花給鐵爐堡軍事區的夜歌大師。',
  }
},
[8506] = {
  {
    'A Aliança precisa de mais lótus roxo!‡Альянсу по-прежнему не хватает лилового лотоса!‡Die Allianz braucht mehr lila Lotus!‡얼라이언스에 보라 연꽃 추가 공급!‡¡La Alianza necesita más lotos cárdenos!‡¡La Alianza necesita más lotos cárdenos!‡L\'Alliance a besoin de plus de lotus pourpre !‡联盟需要更多紫莲花！‡',
    nil,
    'Leve 20 Lótus Roxos ao Mestre Noturcanto na base aérea de Dun Morogh.‡Принесите 20 цветков лилового лотоса мастеру Ночной Песне на аэродром в Дун Морог.‡Bringt 20 lila Lotus zu Meister Nachtweise beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 수석 연금술사 나이트송에게 보라 연꽃 20개를 가져가야 합니다.‡Llévale 20 lotos cárdenos al maestro Arrullanoche en la base aérea de Dun Morogh.‡Llévale 20 lotos cárdenos al maestro Arrullanoche en la base aérea de Dun Morogh.‡Ramener 20 lotus pourpres à maître Chantenuit, à l\'aérodrome de Dun Morogh.‡把20朵紫莲花交给丹莫罗飞机场的艾文·夜歌。‡',
  }
},
[8507] = {
  {
    'Serviço em campanha‡Рутинное задание‡Felddienst‡야전 임무‡Servicio de campo‡Servicio de campo‡Votre affectation‡战地任务‡戰地任務',
    nil,
    'Apresente-se para o trabalho no posto da Brigada de Altaforja perto de Colme\'Zora. Prepare seus Papéis em Branco de Serviço em Campanha e obtenha Papéis Assinados de Serviço em Campanha com o Capitão Bigornero. Então fale novamente com o Arauto do Vento Kaldon no Forte Cenariano em Silithus.nnNota: Curar ou lançar feitiços benéficos em um membro da Brigada de Altaforja marcará você para o JxJ.‡Поступите в распоряжение дружины Стальгорна возле улья Зора. Подготовьте неподписанные бумаги о полевых обязанностях и получите подписанные бумаги о полевых обязанностях от капитана Черной Наковальни, вернитесь к призывателю ветров Калдону в крепость Кенария в Силитусе.nnВнимание: исцеление или наложение благоприятных заклинаний на бойцов дружины Стальгорна переводит в режим PvP.‡Erstattet am Posten der Eisenschmiedebrigade beim Zoraschwarmbau Bericht. Bereitet Eure nicht unterzeichneten Felddienstpapiere vor, lasst sie von Hauptmann Rußschmied unterzeichnen und kehrt zu Windrufer Kaldon auf Burg Cenarius in Silithus zurück.nnHinweis: das Heilen oder Wirken von begünstigenden Zaubern auf ein Mitglied der Eisenschmiedebrigade wird Euch für den PvP-Kampf markieren.‡하이브조라 외곽에 있는 아이언포지 여단의 주둔지로 가십시오. 서명되지 않은 야전 임무 보고서를 연대장 블랙앤빌에게 제출하고 서명된 야전 임무 보고서를 받아야 합니다. 그런 다음 실리더스 세나리온 요새에 있는 바람소환사 칼돈에게 돌아가십시오.nn주의: 아이언포지 여단의 일원을 치유하거나 이로운 마법을 걸면 전투 상태가 됩니다.‡Preséntate en el puesto de la Brigada de Forjaz cerca de Colmen\'Zora. Prepara tus papeles de servicio de campo sin firmar y consigue tus papeles de servicio de campo firmados del capitán Yunquenegro. A continuación, reúnete con Clamavientos Kaldon en el Fuerte Cenarion, en Silithus.nnNota: curar o lanzar hechizos benéficos a un miembro de la Brigada de Forjaz, te marcará como JvJ.‡Preséntate en el puesto de la Brigada de Forjaz cerca de Colmen\'Zora. Prepara tu documentación de instrucción de campo sin firmar y consigue la documentación de instrucción de campo firmada del capitán Yunquenegro. A continuación, reúnete con Clamavientos Kaldon en el Fuerte Cenarion, en Silithus.|nNota: curar o lanzar hechizos benéficos a un miembro de la Brigada de Forjaz, te marcará como JcJ.‡Présentez-vous au poste de la brigade de Forgefer devant la Ruche\'Zora. Préparez votre Ordre de mission et obtenez un Ordre de mission signé du capitaine Noirenclume. Ensuite, retournez voir l\'Implorateur céleste Kaldon au Fort cénarien, en Silithus.nnNote : lancer un sort de soin, ou tout autre sort bénéfique, sur un membre de la brigade de Forgefer vous infligera un marqueur JcJ.‡向佐拉虫巢外的铁炉堡军团报到，从布莱卡维尔上尉那里拿到签过字的战地任务文件，把它交给希利苏斯塞纳里奥要塞的唤风者卡尔东。nn注意：给铁炉堡军团的士兵治疗或者施放增益法术会打开你的PvP标志。‡前往佐拉蟲巢，到鐵爐堡軍團報到。準備好未簽字的戰地任務報告，向布萊卡維爾上尉取得簽過字的戰地任務報告再回到希利蘇斯的塞納里奧城堡找喚風者卡爾東。|n注意:對鐵爐堡軍旅的人員施放治療或幫助的法術將使你將會讓你轉為PvP模式。',
  }
},
[8508] = {
  {
    'Papéis de serviço em campanha‡Бумаги о полевых обязанностях‡Felddienstpapiere‡야전 임무 보고서‡Documentos de instrucción de campo‡Documentación de instrucción de campo‡La liste des affectations‡战地任务文件‡戰地任務報告',
    nil,
    'Presumo que você queira que os papéis sejam assinados, piá?‡Я так понимаю, мне надо подписать эти бумаги, парень?‡Ihr wollt diese Papiere also unterzeichnet bekommen, Junge?‡이 보고서에 서명을 해달라는 말인가?‡‡‡Je suppose que vous voulez que ces papiers soient signés, jeune homme ?‡‡',
  }
},
[8509] = {
  {
    'A Aliança precisa de lágrimas-de-arthas!‡Альянсу не хватает слез Артаса!‡Die Allianz braucht Arthas\' Tränen!‡얼라이언스에 아서스의 눈물 공급!‡¡La Alianza necesita lágrimas de Arthas!‡¡La Alianza necesita lágrimas de Arthas!‡L\'Alliance a besoin de larmes d\'Arthas !‡联盟需要阿尔萨斯之泪！‡聯盟需要阿薩斯之淚!',
    nil,
    'Leve 20 Lágrimas-de-arthas à Sargento-mor Germana na Ala Militar de Altaforja.‡Принесите 20 слез Артаса старшему сержанту Жермен в Палаты войны Стальгорна.‡Bringt 20 Arthas\' Tränen zu Stabsfeldwebel Germaine im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 선임하사 저메인에게 아서스의 눈물 20개를 가져가야 합니다.‡Llévale 20 lágrimas de Arthas al alférez Germaine en La Sala Militar de Forjaz.‡Llévale 20 lágrimas de Arthas al Sargento Mayor Germaine en La Sala Militar de Forjaz.‡Ramener 20 larmes d’Arthas au sergent-major Germaine dans la Garde militaire d\'Ironforge.‡把20棵阿尔萨斯之泪交给铁炉堡军事区的士官长戈麦恩。‡帶20份阿薩斯之淚給鐵爐堡軍事區的士官長戈麥恩。',
  }
},
[8510] = {
  {
    'A Aliança precisa de mais Lágrimas-de-arthas!‡Альянсу снова нужны слезы Артаса‡Die Allianz braucht mehr Arthas\' Tränen!‡얼라이언스에 아서스의 눈물 추가 공급!‡¡La Alianza necesita más lágrimas de Arthas!‡¡La Alianza necesita más lágrimas de Arthas!‡L\'Alliance a besoin de plus de larmes d\'Arthas !‡联盟需要更多阿尔萨斯之泪！‡',
    nil,
    'Leve 20 Lágrimas-de-arthas à Sargento-mor Germana na base aérea de Dun Morogh.‡Принесите 20 цветков слезы Артаса старшему сержанту Жермен на аэродром в Дун Морог.‡Bringt 20 Arthas\' Tränen zu Stabsfeldwebel Germaine beim Landeplatz in Dun Morogh.‡던 모로 비행장에 있는 선임하사 저메인에게 아서스의 눈물 20개를 가져가야 합니다.‡Llévale 20 lágrimas de Arthas al Sargento Mayor Germaine en la base aérea de Dun Morogh.‡Llévale 20 lágrimas de Arthas al Sargento Mayor Germaine en la base aérea de Dun Morogh.‡Ramener 20 larmes d\'Arthas au sergent-major Germaine à l\'aérodrome de Dun Morogh.‡把20棵阿尔萨斯之泪交给丹莫罗飞机场的士官长戈麦恩。‡',
  }
},
[8511] = {
  {
    'A Aliança precisa de couro leve!‡Альянсу не хватает легкой кожи!‡Die Allianz braucht leichtes Leder!‡얼라이언스에 얇은 가죽 공급!‡¡La Alianza necesita cuero semipesado!‡¡La Alianza necesita cuero semipesado!‡L\'Alliance a besoin de cuir léger !‡联盟需要轻皮！‡聯盟需要輕皮!',
    nil,
    'Leve 10 peças de Couro Leve para Corina Esfolapedra na Ala Militar de Altaforja.‡Принесите 10 кусков легкой кожи Бонни Шлифовальщице в Палаты войны Стальгорна.‡Bringt 10 Einheiten leichtes Leder zu Bonnie Steinschinder im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 보니 스톤플레이어에게 얇은 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero ligero a Bonnie Cazarrocas en La Sala Militar de Forjaz.‡Llévale 10 piezas de cuero ligero a Bonnie Cazarrocas en La Sala Militar de Forjaz.‡Ramenez 10 Cuirs légers à Bonnie Ecorchepierre dans la Garde militaire de Forgefer.‡把10块轻皮交给丹莫罗飞机场的波尼·碎石。‡帶10張輕皮給鐵爐堡軍事區的波尼·碎石。',
  }
},
[8512] = {
  {
    'A Aliança precisa de mais couro leve!‡Альянсу по-прежнему не хватает легкой кожи!‡Die Allianz braucht mehr leichtes Leder!‡얼라이언스에 얇은 가죽 추가 공급!‡¡La Alianza necesita más cuero semipesado!‡¡La Alianza necesita más cuero semipesado!‡L\'Alliance a besoin de plus de cuir léger !‡联盟需要更多轻皮！‡',
    nil,
    'Leve 10 peças de Couro Leve para Corina Esfolapedra na base aérea de Dun Morogh.‡Принесите 10 кусков легкой кожи Бонни Шлифовальщице на аэродром в Дун Морог.‡Bringt 10 Einheiten leichtes Leder zu Bonnie Steinschinder beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 보니 스톤플레이어에게 얇은 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero ligero a Bonnie Cazarrocas en la base aérea de Dun Morogh.‡Llévale 10 piezas de cuero ligero a Bonnie Cazarrocas en la base aérea de Dun Morogh.‡Apportez 10 Cuirs légers à Bonnie Ecorchepierre à l\'aérodrome de Dun Morogh.‡把10块轻皮交给丹莫罗飞机场的波尼·碎石。‡',
  }
},
[8513] = {
  {
    'A Aliança precisa de couro médio!‡Альянсу не хватает средней кожи!‡Die Allianz braucht mittleres Leder!‡얼라이언스에 일반 가죽 공급!‡¡La Alianza necesita cuero medio!‡¡La Alianza necesita cuero medio!‡L\'Alliance a besoin de cuir moyen !‡联盟需要中皮！‡聯盟需要中皮!',
    nil,
    'Leve 10 peças de Couro Médio ao Cabo Porter na Ala Militar de Altaforja.‡Принесите 10 кусков средней кожи рядовому Портеру в Палаты войны Стальгорна.‡Bringt 10 Einheiten mittleres Leder zu dem Gefreiten Porter im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 병사 포터에게 일반 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero fino al soldado Porter en La Sala Militar de Forjaz.‡Llévale 10 piezas de cuero medio al soldado Porter en La Sala Militar de Forjaz.‡Ramener 10 Cuirs moyens au soldat Porter dans la Garde militaire de Forgefer.‡把10块中皮交给铁炉堡军事区的下士波特。‡帶10張中皮給鐵爐堡軍事區的士兵波特。',
  }
},
[8514] = {
  {
    'A Aliança precisa de mais couro médio!‡Альянсу по-прежнему не хватает средней кожи!‡Die Allianz braucht mehr mittleres Leder!‡얼라이언스에 일반 가죽 추가 공급!‡¡La Alianza necesita más cuero medio!‡¡La Alianza necesita más cuero medio!‡L\'Alliance a besoin de plus de cuir moyen !‡联盟需要更多中皮！‡',
    nil,
    'Leve 10 peças de Couro Médio ao Cabo Porter na base aérea de Dun Morogh.‡Принесите 10 средних кож рядовому Портеру на аэродром в Дун Морог.‡Bringt 10 Einheiten mittleres Leder zu dem Gefreiten Porter beim Landeplatz in Dun Morogh.‡던 모로 비행장에 있는 병사 포터에게 일반 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero medio al soldado Porter en la base aérea de Dun Morogh.‡Llévale 10 piezas de cuero medio al soldado Porter en la base aérea de Dun Morogh.‡Ramener 10 cuirs moyens au soldat Porter, à l\'aérodrome de Dun Morogh.‡把10块中皮交给丹莫罗飞机场的下士波特。‡',
  }
},
[8515] = {
  {
    'A Aliança precisa de couro grosso!‡Альянсу не хватает плотной кожи!‡Die Allianz braucht dickes Leder!‡얼라이언스에 두꺼운 가죽 공급!‡¡La Alianza necesita cuero grueso!‡¡La Alianza necesita cuero grueso!‡L\'Alliance a besoin de cuir épais !‡联盟需要厚皮！‡聯盟需要厚皮!',
    nil,
    'Leve 10 peças de Couro Grosso à Marta Fusofino na Ala Militar de Altaforja.‡Принесите 10 кусков толстой кожи Марте Остроигл в Палаты войны Стальгорна.‡Bringt 10 Einheiten dickes Leder zu Marta Feinspindel im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 마사 파인스핀들에게 두꺼운 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero grueso a Marta Bueneje en La Sala Militar de Forjaz.‡Llévale 10 piezas de cuero grueso a Marta Bueneje en La Sala Militar de Forjaz.‡Ramener 10 Cuirs épais à Marta Finfuseau dans la Garde militaire de Forgefer.‡把10块厚皮交给铁炉堡军事区的玛塔·钢轴。‡帶10張厚皮給鐵爐堡軍事區的瑪塔·鋼軸。',
  }
},
[8516] = {
  {
    'A Aliança precisa de mais couro grosso!‡Альянсу по-прежнему не хватает плотной кожи!‡Die Allianz braucht mehr dickes Leder!‡얼라이언스에 두꺼운 가죽 추가 공급!‡¡La Alianza necesita más cuero grueso!‡¡La Alianza necesita más cuero grueso!‡L\'Alliance a besoin de plus de cuir épais !‡联盟需要更多厚皮！‡',
    nil,
    'Leve 10 peças de Couro Grosso à Marta Fusofino na base aérea de Dun Morogh.‡Принесите 10 плотных кож Марте Остроигл на аэродром Стальгорна.‡Bringt 10 Einheiten dickes Leder zu Marta Feinspindel beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 마사 파인스핀들에게 두꺼운 가죽 10개를 가져가야 합니다.‡Llévale 10 piezas de cuero grueso a Marta Bueneje en la base aérea de Dun Morogh.‡Llévale 10 piezas de cuero grueso a Marta Bueneje en la base aérea de Dun Morogh.‡Ramener 10 cuirs légers à Marta Finfuseau à l\'aérodrome de Dun Morogh.‡把10块厚皮交给丹莫罗飞机场的玛塔·钢轴。‡',
  }
},
[8517] = {
  {
    'A Aliança precisa de bandagens de linho!‡Альянсу не хватает льняных бинтов!‡Die Allianz braucht Leinenverbände!‡얼라이언스에 리넨 붕대 조달!‡¡La Alianza necesita vendas de lino!‡¡La Alianza necesita vendas de lino!‡L\'Alliance a besoin de bandages en lin !‡联盟需要亚麻绷带！‡聯盟需要亞麻繃帶!',
    nil,
    'Leve 20 Bandagens de Linho à Sentinela Argencélio na Ala Militar de Altaforja.‡Принесите 20 льняных бинтов часовому Серебринке Небес в Палаты войны Стальгорна.‡Bringt 20 Leinenverbände zu Schildwache Silberwolke im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 파수꾼 실버스카이에게 리넨 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de lino a la centinela Melenargenta en La Sala Militar de Forjaz.‡Llévale 20 vendas de lino a la Centinela Cielargento en La Sala Militar de Forjaz.‡Ramener 20 bandages en lin à la Sentinelle Argeciel, dans la Garde militaire de Forgefer.‡把20卷亚麻绷带交给铁炉堡军事区的哨兵塞尔瓦·银空。‡帶20個亞麻布繃帶給鐵爐堡軍事區的哨兵塞爾瓦·銀空。',
  }
},
[8518] = {
  {
    'A Aliança precisa de mais bandagens de linho!‡Альянсу по-прежнему не хватает льняных бинтов!‡Die Allianz braucht mehr Leinenverbände!‡얼라이언스에 리넨 붕대 추가 조달!‡¡La Alianza necesita más vendas de lino!‡¡La Alianza necesita más vendas de lino!‡L\'Alliance a besoin de plus de bandages en lin !‡联盟需要更多亚麻绷带！‡聯盟需要更多亞麻繃帶!',
    nil,
    'Leve 20 Bandagens de Linho à Sentinela Argencélio na base aérea de Dun Morogh.‡Принесите 20 льняных бинтов часовому Серебринке Небес на аэродром в Дун Морог.‡Bringt 20 Leinenverbände zu Schildwache Silberwolke beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 파수꾼 실버스카이에게 리넨 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de lino a la Centinela Cielargente en la base aérea de Dun Morogh.‡Llévale 20 vendas de lino a la Centinela Cielargento en la base aérea de Dun Morogh.‡Apportez 20 Bandages en lin à la Sentinelle Argeciel à l\'aérodrome de Dun Morogh.‡把20卷亚麻绷带交给丹莫罗飞机场的哨兵塞尔瓦·银空。‡帶20個亞麻布繃帶給丹莫洛飛機場的哨兵塞爾瓦·銀空。',
  }
},
[8519] = {
  {
    'Um peão no tabuleiro eterno‡Пешка на Доске Вечности‡Eine Spielfigur auf dem Schachbrett der Ewigkeit‡장기판 위의 졸‡Un peón en el ajedrez de la vida‡Un peón en el ajedrez de la vida‡Un pion sur l\'Echiquier éternel‡往日的回忆‡往日的回憶',
    nil,
    'Aprenda tudo que puder sobre o passado, depois fale com Anacronos nas Cavernas do Tempo, em Tanaris.‡Узнайте о прошлом все, что можно. Потом поговорите с Анахроносом в Пещерах Времени в Танарисе.‡Lernt so viel Ihr könnt über die Vergangenheit, sprecht dann mit Anachronos in den Höhlen der Zeit in Tanaris.‡잊혀진 오랜 기억에 대해 가능한 모든 것을 확인한 후 타나리스의 시간의 동굴에 있는 아나크로노스와 대화하십시오.‡Aprende todo lo que puedas del pasado y habla con Anacronos en las Cavernas del Tiempo de Tanaris.|n‡Aprende todo lo que puedas del pasado y habla con Anacronos en las Cavernas del Tiempo de Tanaris.‡Apprenez tout ce que vous pouvez au sujet du passé, puis parlez à Anachronos dans les Grottes du temps à Tanaris.‡了解所以可以的过去的事情，然后和塔纳利斯时光之穴的阿纳克洛斯谈谈。‡了解一切你能知道的過去，再到塔納利斯和時光之穴與安納克羅斯交談。',
  }
},
[8520] = {
  {
    'A Aliança precisa de bandagens de seda!‡Альянсу не хватает шелковых бинтов!‡Die Allianz braucht Seidenverbände!‡얼라이언스에 비단 붕대 조달!‡¡La Alianza necesita vendas de seda!‡¡La Alianza necesita vendas de seda!‡L\'Alliance a besoin de bandages en soie !‡联盟需要丝质绷带！‡聯盟需要絲質繃帶!',
    nil,
    'Leve 20 Bandagens de Seda à Enfermeira Campedra na Ala Militar de Altaforja.‡Принесите 20 шелковых бинтов медсестре Стоунфилд в Палаты войны Стальгорна.‡Bringt 20 Seidenverbände zu Schwester Steinfeld im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 간호사 스톤필드에게 비단 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de seda a la enfermera Campopétreo en La Sala Militar de Forjaz.‡Llévale 20 vendas de seda a la Enfermera Pedregosa en La Sala Militar de Forjaz.‡Ramener 20 bandages en soie à l\'infirmière Champierreux, dans la Garde militaire de Forgefer.‡把20卷丝质绷带交给铁炉堡军事区的女护士斯通菲尔德。‡帶20個絲質繃帶給鐵爐堡軍事區的護士斯通菲爾德。',
  }
},
[8521] = {
  {
    'A Aliança precisa de mais bandagens de seda!‡Альянсу по-прежнему не хватает шелковых бинтов!‡Die Allianz braucht mehr Seidenverbände!‡얼라이언스에 비단 붕대 추가 조달!‡¡La Alianza necesita más vendas de seda!‡¡La Alianza necesita más vendas de seda!‡L\'Alliance a besoin de plus de bandages en soie !‡联盟需要更多丝质绷带！‡',
    nil,
    'Leve 20 Bandagens de Seda à Enfermeira Campedra na base aérea de Dun Morogh.‡Принесите 20 шелковых бинтов медсестре Стоунфилд на аэродром в Дун Морог.‡Bringt 20 Seidenverbände zu Schwester Steinfeld beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 간호사 스톤필드에게 비단 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de seda a la Enfermera Pedregosa en la base aérea de Dun Morogh.‡Llévale 20 vendas de seda a la Enfermera Pedregosa en la base aérea de Dun Morogh.‡Apportez 20 Bandages en soie à l\'infirmière Champierreux à l\'aérodrome de Dun Morogh.‡把20卷丝质绷带交给丹莫罗飞机场的女护士斯通菲尔德。‡',
  }
},
[8522] = {
  {
    'A Aliança precisa de bandagens de runatrama!‡Альянсу не хватает бинтов из рунической ткани!‡Die Allianz braucht Runenstoffverbände!‡얼라이언스에 룬매듭 붕대 조달!‡¡La Alianza necesita vendas de paño rúnico!‡¡La Alianza necesita vendas de paño rúnico!‡L\'Alliance a besoin de bandages en étoffe runique !‡联盟需要符文布绷带！‡聯盟需要符文布繃帶!',
    nil,
    'Leve 20 Bandagens de Runatrama ao Guardião Sombraluna na Ala Militar de Altaforja.‡Принесите 20 бинтов из рунической ткани хранителю Лунному Сумраку в Палаты войны Стальгорна.‡Bringt 20 Runenstoffverbände zu Bewahrer Mondschatten im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 수호자 문셰이드에게 룬매듭 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de paño rúnico al vigilante Sombraluna en La Sala Militar de Forjaz.‡Llévale 20 vendas de paño rúnico al vigilante Sombra Lunar en La Sala Militar de Forjaz.‡Ramener 20 Bandages en étoffe runique au Gardien Lunombrage dans la Garde militaire de Forgefer.‡把20卷符文布绷带交给铁炉堡军事区的守护者莫沙·月影。‡帶20個符文布繃帶給鐵爐堡軍事區的守護者月影。',
  }
},
[8523] = {
  {
    'A Aliança precisa de mais bandagens de runatrama!‡Альянсу по-прежнему не хватает бинтов из рунической ткани!‡Die Allianz braucht mehr Runenstoffverbände!‡얼라이언스에 룬매듭 붕대 추가 조달!‡¡La Alianza necesita más vendas de paño rúnico!‡¡La Alianza necesita más vendas de paño rúnico!‡L\'Alliance a besoin de plus de bandages en étoffe runique !‡联盟需要更多符文布绷带！‡',
    nil,
    'Leve 20 Bandagens de Runatrama ao Guardião Sombraluna na base aérea de Dun Morogh.‡Принесите 20 бинтов из рунической ткани хранителю Лунному Сумраку на аэродром в Дун Морог.‡Bringt 20 Runenstoffverbände zu Bewahrer Mondschatten beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 수호자 문셰이드에게 룬매듭 붕대 20개를 가져가야 합니다.‡Llévale 20 vendas de paño rúnico al vigilante Sombraluna en la base aérea de Dun Morogh.‡Llévale 20 vendas de paño rúnico al vigilante Sombra Lunar en la base aérea de Dun Morogh.‡Ramener 20 bandages en étoffe runique au gardien Lunombrage à l\'aérodrome de Dun Morogh.‡把20卷符文布绷带交给丹莫罗飞机场的守护者莫沙·月影。‡',
  }
},
[8524] = {
  {
    'A Aliança precisa de albacora arco-íris!‡Альянсу не хватает радужного тунца!‡Die Allianz braucht Regenbogenflossenthunfisch!‡얼라이언스에 무지개날개다랑어 구이 공급!‡¡La Alianza necesita atún blanco arco iris!‡¡La Alianza necesita atún blanco arco iris!‡L\'Alliance a besoin de thon arc-en-ciel !‡联盟需要彩鳍鱼！‡聯盟需要彩鰭魚!',
    nil,
    'Leve 20 Albacoras Arco-íris ao Fúlvio Nelidônio na Ala Militar de Altaforja.‡Принесите 20 тушек радужного тунца Гладню Гастроному в Палаты войны Стальгорна.‡Bringt 20 Regenbogenflossenthunfische zu Gastronom Glitschko im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 슬리키 개스트로놈에게 무지개날개다랑어 구이 20마리를 가져가야 합니다.‡Llévale 20 atunes blancos arcoiris al Gastrónomo Salao en La Sala Militar de Forjaz.‡Llévale 20 atunes blancos arco iris al Gastrónomo Salao en La Sala Militar de Forjaz.‡Ramener 20 Thons arc-en-ciel à Khirry le Gastrognome dans la Garde militaire de Forgefer.‡把20条彩鳍鱼交给丹莫罗飞机场的美食家斯里克。‡帶20條彩鰭魚給鐵爐堡軍事區的美食家斯里克。',
  }
},
[8525] = {
  {
    'A Aliança precisa de mais albacora arco-íris!‡Альянсу по-прежнему не хватает радужного тунца!‡Die Allianz braucht mehr Regenbogenflossenthunfisch!‡얼라이언스에 무지개날개다랑어 구이 추가 공급!‡¡La Alianza necesita más atún blanco arco iris!‡¡La Alianza necesita más atún blanco arco iris!‡L\'Alliance a besoin de plus de thon arc-en-ciel !‡联盟需要更多彩鳍鱼！‡',
    nil,
    'Leve 20 Albacoras Arco-íris para Fúlvio Nelidônio na base aérea de Dun Morogh.‡Принесите 20 тушек радужного тунца Гладню Гастроному на аэродром в Дун Морог.‡Bringt 20 Regenbogenflossenthunfische zu Gastronom Glitschko beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 슬리키 개스트로놈에게 무지개날개다랑어 구이 20마리를 가져가야 합니다.‡Llévale 20 atunes blancos arcoiris al Gastrónomo Salao en la base aérea de Dun Morogh.‡Llévale 20 atunes blancos arco iris al Gastrónomo Salao en la base aérea de Dun Morogh.‡Ramenez 20 thons arc-en-ciel à Khirry le Gastrognome à l\'aéroport de Dun Morogh.‡把20条彩鳍鱼交给丹莫罗飞机场的美食家斯里克。‡',
  }
},
[8526] = {
  {
    'A Aliança precisa de raptor assado!‡Альянсу не хватает жареного мяса ящера!‡Die Allianz braucht geröstete Raptoren!‡얼라이언스에 랩터 숯불구이 공급!‡¡La Alianza necesita raptor asado!‡¡La Alianza necesita raptor asado!‡L\'Alliance a besoin de rôtis de raptor !‡联盟需要烤迅猛龙肉！‡聯盟需要烤迅猛龍肉!',
    nil,
    'Leve 20 Raptores Assados para Sara Apitaço na Ala Militar de Altaforja.‡Принесите 20 жареных ящеров Саре Грустносвист в Палаты войны Стальгорна.‡Bringt 20 geröstete Raptoren zu Sarah Sorgenpfeifer im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 사라 새드휘슬에게 랩터 숯불구이 20개를 가져가야 합니다.‡Llévale 20 raptores asados a Sarah Silbotriste en La Sala Militar de Forjaz.‡Llévale 20 raptores asados a Sarah Silbotriste en La Sala Militar de Forjaz.‡Ramener 20 Rôtis de raptor à Sarah Tristesifflet dans la Garde militaire de Forgefer.‡把20块烤迅猛龙肉交给铁炉堡军事区的萨拉·塞维斯。‡帶20份烤迅猛龍肉給鐵爐堡軍事區的薩拉·塞維斯。',
  }
},
[8527] = {
  {
    'A Aliança precisa de mais raptor assado!‡Альянсу по-прежнему не хватает жареного мяса ящера!‡Die Allianz braucht mehr geröstete Raptoren!‡얼라이언스에 랩터 숯불구이 추가 공급!‡¡La Alianza necesita más raptor asado!‡¡La Alianza necesita más raptor asado!‡L\'Alliance a besoin de plus de rôti de raptor !‡联盟需要更多烤迅猛龙肉！‡',
    nil,
    'Leve 20 Raptores Assados para Sara Apitaço na base aérea de Dun Morogh.‡Принесите 20 жареных ящеров Саре Грустносвист на аэродром в Дун Морог.‡Bringt 20 geröstete Raptoren zu Sarah Sorgenpfeifer beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 사라 새드휘슬에게 랩터 숯불구이 20개를 가져가야 합니다.‡Llévale 20 raptores asados a Sarah Silbotriste en la base aérea de Dun Morogh.‡Llévale 20 raptores asados a Sarah Silbotriste en la base aérea de Dun Morogh.‡Apportez 20 Rôtis de raptor à Sarah Tristesifflet à l\'aérodrome de Dun Morogh.‡把20块烤迅猛龙肉交给丹莫罗飞机场的萨拉·塞维斯。‡',
  }
},
[8528] = {
  {
    'A Aliança precisa de rabo-amarelo mosqueado!‡Альянсу не хватает пятнистого желтохвоста!‡Die Allianz braucht Tüpfelgelbschwänze!‡얼라이언스에 점박이놀래기 공급!‡¡La Alianza necesita serviolas moteadas!‡¡La Alianza necesita serviolas moteadas!‡L\'Alliance a besoin de jaune-queue tacheté !‡联盟需要斑点黄尾鱼！‡聯盟需要斑點黃尾魚!',
    nil,
    'Leve 20 Rabos-amarelos Mosqueados à Caçadora Veloflumen na Ala Militar de Altaforja.‡Принесите 20 пятнистых желтохвостов охотнице Быстрой Реке в Палаты войны Стальгорна.‡Bringt 20 Tüpfelgelbschwänze zu Jägerin Flinkbach im Militärviertel in Eisenschmiede.‡아이언포지의 군사 지구에 있는 여사냥꾼 스위프트리버에게 점박이놀래기 20마리를 가져가야 합니다.‡Llévale 20 serviolas moteadas a la cazadora Río Veloz en La Sala Militar de Forjaz.‡Llévale 20 serviolas moteadas a la Cazadora Río Veloz en La Sala Militar de Forjaz.‡Ramener 20 jaunes-queues tachetés à la chasseresse Ondevive dans la Garde militaire de Forgefer.‡把20条斑点黄尾鱼交给铁炉堡军事区的女猎手蕾尔·急流。‡帶20條斑點黃尾魚給鐵爐堡軍事區的女獵手蕾爾·急流。',
  }
},
[8529] = {
  {
    'A Aliança precisa de mais rabo-amarelo mosqueado!‡Альянсу по-прежнему не хватает пятнистого желтохвоста!‡Die Allianz braucht mehr Tüpfelgelbschwänze!‡얼라이언스에 점박이놀래기 추가 공급!‡¡La Alianza necesita más serviolas moteadas!‡¡La Alianza necesita más serviolas moteadas!‡L\'Alliance a besoin de plus de jaune-queue tacheté !‡联盟需要更多斑点黄尾鱼！‡',
    nil,
    'Leve 20 Rabos-amarelos Mosqueados à Caçadora Veloflumen na base aérea de Dun Morogh.‡Принесите 20 пятнистых желтохвостов охотнице Быстрой Реке на аэродром в Дун Морог.‡Bringt 20 Tüpfelgelbschwänze zu Jägerin Flinkbach beim Landeplatz in Dun Morogh.‡아이언포지의 군사 지구에 있는 여사냥꾼 스위프트리버에게 점박이놀래기 20마리를 가져가야 합니다.‡Llévale 20 serviolas moteadas a la cazadora Río Veloz en la base aérea de Dun Morogh.‡Llévale 20 serviolas moteadas a la Cazadora Río Veloz en la base aérea de Dun Morogh.‡Ramener 20 jaunes-queues tachetés à la chasseresse Ondevive à l\'aérodrome de Dun Morogh.‡把20条斑点黄尾鱼交给丹莫罗的女猎手蕾尔·急流。‡',
  }
},
[8530] = {
  {
    'A Aliança precisa de pedra nuclear chamuscada!‡Альянсу не хватает опаленных вулканических камней!‡Die Allianz braucht sengende Kernsteine!‡얼라이언스에 그을린 화산핵 조달!‡¡La Alianza necesita piedras nuclearias abrasadas!‡‡L\'Alliance a besoin de pierres du Magma roussies !‡联盟需要熔火之石！‡聯盟需要燒焦的核心石!',
    nil,
    'Leve 50 pedras nucleares chamuscadas para o Comandante Marroforte na base aérea de Dun Morogh.‡Принесите 50 оплавленных вулканических камней командиру Мощному Молоту на аэродром в Дун Мороге.‡Bringt 50 sengende Kernsteine zu Kommandant Hammerkraft beim Landeplatz in Dun Morogh.‡던 모로 비행장에 있는 사령관 스트롱해머에게 그을린 화산핵 50개를 가져가야 합니다.‡Llévale 50 piedras nuclearias abrasadas al comandante Martillopujante en la base aérea de Dun Morogh.‡Llévale 50 piedras nuclearias chamuscadas al comandante Martillopujante en la base aérea de Dun Morogh.‡Ramener 50 Pierres du Magma roussies au commandant Fortmartel à l\'aérodrome de Dun Morogh.‡把50块熔火之石交给丹莫罗飞机场的指挥官汉默·石锤。‡帶50個燒焦的核心石給丹莫洛飛機場的戰錘指揮官。',
  }
},
[8532] = {
  {
    'A Horda precisa de barras de cobre!‡Орде не хватает медных слитков!‡Die Horde braucht Kupferbarren!‡호드에 구리 주괴 조달!‡¡La Horda necesita lingotes de cobre!‡¡La Horda necesita lingotes de cobre!‡La Horde a besoin de barres de cuivre !‡部落需要铜锭！‡部落需要銅錠!',
    nil,
    'Leve 20 Barras de Cobre ao Minerador Caturro no Vale dos Espíritos em Orgrimmar.‡Принесите 20 медных слитков шахтеру Кромвелю в Аллею Духов Оргриммара.‡Bringt 20 Kupferbarren zu Minenarbeiter Kromwell im Tal der Geister in Orgrimmar.‡오그리마 정기의 골짜기에 있는 광부 크롬웰에게 구리 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de cobre al Minero Cromwell en el Valle de los Espíritus de Orgrimmar.‡Llévale 20 lingotes de cobre al Minero Cromwell en el Valle de los Espíritus de Orgrimmar.‡Ramener 20 barres de cuivre au mineur Cromwell dans la Vallée des esprits d\'Orgrimmar.‡把20块铜锭交给奥格瑞玛精神谷的矿工克罗威尔。‡帶20個銅錠給奧格瑪精神谷的礦工克羅威爾。',
  }
},
[8533] = {
  {
    'A Horda precisa de mais barras de cobre!‡Орде по-прежнему не хватает медных слитков!‡Die Horde braucht mehr Kupferbarren!‡호드에 구리 주괴 추가 조달!‡¡La Horda necesita más lingotes de cobre!‡¡La Horda necesita más lingotes de cobre!‡La Horde a besoin de plus de barres de cuivre !‡部落需要更多铜锭！‡',
    nil,
    'Leve 20 Barras de Cobre ao Minerador Caturro em Durotar.‡Принесите 20 медных слитков шахтеру Кромвелю в Дуротар.‡Bringt 20 Kupferbarren zu Minenarbeiter Kromwell in Durotar.‡듀로타에 있는 광부 크롬웰에게 구리 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de cobre al Minero Cromwell en Durotar.‡Llévale 20 lingotes de cobre al Minero Cromwell en Durotar.‡Apportez 20 Barres de cuivre au Mineur Cromwell à Durotar.‡把20块铜锭交给杜隆塔尔的矿工克罗威尔。‡',
  }
},
[8534] = {
  {
    'O relatório do batedor de Colme\'Zora‡Донесение разведчика из Улья Зора‡Späherbericht des Zoraschwarms‡하이브조라 정찰 보고서‡Informe de exploración de Colmen\'Zora‡Informe de exploración de Colmen\'Zora‡Rapport de reconnaissance de la Ruche\'Zora‡灰烬公爵‡佐拉蟲巢偵察報告',
    nil,
    'Contate a Batedora Cenariana Azenel no interior da Colme\'Zora e entregue o Relatório do Batedor de Colme\'Zora à Arauto do Vento Chifre Altivo no Forte Cenariano. Você também precisa entregar as Instruções Táticas VI para concluir a missão.‡Свяжитесь с кенарийской разведчицей Азенель в улье Зора и отнесите ее донесение призывательнице ветров Гордый Рог в крепость Кенария. Кроме того, принесите тактическую задачу VI.‡Setzt Euch mit der cenarischen Späherin Azenel innerhalb des Zoraschwarmbaus in Verbindung und bringt den Späherbericht des Zoraschwarms zu Windruferin Prachthorn auf Burg Cenarius. Ihr benötigt auch den taktischen Einsatz VI, um diese Aufgabe abschließen zu können.‡하이브조라 안에 있는 세나리온 정찰병 아제넬과 접선한 다음 세나리온 요새에 있는 바람소환사 프라우드혼에게 하이브조라 정찰 보고서를 가지고 돌아가십시오. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 VI를 함께 가져가야 합니다.‡Contacta con el explorador Cenarion Azenel en Colmen\'Zora y entrega el informe de exploración de Colmen\'Zora a Clamavientos Cuernorgullo en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas VI para poder completar la misión.‡Contacta con el explorador Cenarion Azenel en Colmen\'Zora y entrega el informe de exploración de Colmen\'Zora a Clamavientos Cuerno Digno en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas VI para poder completar la misión.‡Trouver l\'Eclaireur cénarien Azenel dans la Ruche\'Zora et ramener le Rapport de reconnaissance de la Ruche\'Zora à l\'Imploratrice céleste Corne-fière, au Fort cénarien. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique VI.‡设法召唤并击杀灰烬公爵，然后向塞纳里奥要塞的唤风者梅恩·长角复命。‡聯絡佐拉蟲巢的塞納里奧斥候艾澤奈爾並將佐拉蟲巢偵察報告交給塞納里奧城堡的喚風者傲角。你還必須將戰術任務簡報VI帶去才能完成這個任務。',
  }
},
[8535] = {
  {
    'Templário Gris‡Седой храмовник‡Weißgrauer Templer‡백색 기사단‡Templario vetusto‡Templario vetusto‡Le templier chenu‡深渊公爵‡蒼白聖殿騎士',
    nil,
    'Evoque e mate um Templário Gris e fale novamente com Bor Juba Agreste no Forte Cenariano. Você também precisa entregar as Instruções Táticas IV para concluir a missão.‡Призовите и убейте седого храмовника и доложите о выполнении задания Бору Буйногривому из крепости Кенария. Для завершения задания принесите тактическую задачу IV.‡Beschwört und vernichtet einen weißgrauen Templer. Erstattet anschließend Bericht bei Bor Wildmähne auf Burg Cenarius. Ihr benötigt auch den taktischen Einsatz IV, um diese Aufgabe abschließen zu können.‡백색 기사단을 소환하여 해치운 후 세나리온 요새에 있는 보르 와일드메인에게 보고하십시오. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 IV도 함께 가져가야 합니다.‡Invoca y mata a un Templario vetusto y preséntate ante Bor Bravacrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas IV para poder completar la misión.‡Invoca y mata a un Templario vetusto y preséntate ante Bor Ferocrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas IV para poder completar la misión.‡Invoquez et tuez un Templier chenu, puis allez faire votre rapport à Bor Crin-sauvage, au Fort cénarien. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique IV.‡设法召唤并击杀深渊公爵，然后向塞纳里奥要塞的唤风者梅恩·长角复命。‡想辦法召喚並殺死蒼白聖殿騎士，再向塞納里奧城堡的鮑爾·蠻鬃回報。你還必須將戰術任務簡報 IV帶去才能完成這個任務。',
  }
},
[8536] = {
  {
    'Templário Terrano‡Земляной храмовник‡Irdener Templer‡황색 기사단‡Templario de tierra‡Templario de tierra‡Le templier terrestre‡碎石公爵‡土色聖殿騎士',
    nil,
    'Evoque e mate um Templário Terrano e fale novamente com Bor Juba Agreste no Forte Cenariano. Você também precisa entregar as Instruções Táticas III para concluir a missão.‡Призовите и убейте земляного храмовника и доложите о выполнении задания Бору Буйногривому из крепости Кенария. Для завершения задания принесите тактическую задачу III.‡Beschwört und vernichtet einen irdenen Templer. Erstattet anschließend Bericht bei Bor Wildmähne auf Burg Cenarius. Ihr benötigt auch den taktischen Einsatz III, um diese Aufgabe abschließen zu können.‡황색 기사단을 소환하여 해치운 후 세나리온 요새에 있는 보르 와일드메인에게 보고하십시오. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 III도 함께 가져가야 합니다.‡Invoca y mata a un Templario de tierra y preséntate ante Bor Bravacrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas III para poder completar la misión.‡Invoca y mata a un Templario de tierra y preséntate ante Bor Ferocrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas III para poder completar la misión.‡Invoquez et tuez un Templier terrestre, puis allez faire votre rapport à Bor Crin-sauvage, au Fort cénarien. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique III.‡设法召唤并击杀碎石公爵，然后向塞纳里奥要塞的唤风者梅恩·长角复命。‡想辦法召喚並殺死土色聖殿騎士，再向塞納里奧城堡的鮑爾·蠻鬃回報。你還必須將戰術任務簡報 III帶去才能完成這個任務。',
  }
},
[8537] = {
  {
    'Templário Carmesim‡Багровый храмовник‡Purpurroter Templer‡진홍 기사단‡Templario Carmesí‡Templario Carmesí‡Le templier cramoisi‡微风公爵‡赤紅聖殿騎士',
    nil,
    'Evoque e mate um Templário Carmesim e fale novamente com Bor Juba Agreste no Forte Cenariano. Você também precisa entregar as Instruções Táticas II para concluir a missão.‡Призовите и убейте багрового храмовника и доложите о выполнении задания Бору Буйногривому из крепости Кенария. Для завершения задания принесите тактическую задачу II.‡Beschwört und vernichtet einen purpurroten Templer. Erstattet anschließend Bericht bei Bor Wildmähne auf Burg Cenarius. Ihr benötigt auch den taktischen Einsatz II, um diese Aufgabe abschließen zu können.‡진홍 기사단을 소환하여 해치운 후 세나리온 요새에 있는 보르 와일드메인에게 보고하십시오. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 II도 함께 가져가야 합니다.‡Invoca y mata a un templario Carmesí y preséntate ante Bor Bravacrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas II para poder completar la misión.‡Invoca y mata a un templario Carmesí y preséntate ante Bor Ferocrín en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas II para poder completar la misión.‡Invoquez et tuez un Templier cramoisi, puis allez faire votre rapport à Bor Crin-sauvage, au Fort cénarien. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique II.‡设法召唤并击杀微风公爵，然后向塞纳里奥要塞的唤风者梅恩·长角复命。‡想辦法召喚並殺死赤紅聖殿騎士，再向塞納里奧城堡的鮑爾·蠻鬃回報。你還必須將戰術任務簡報 II帶去才能完成這個任務。',
  }
},
[8538] = {
  {
    'Os quatro duques‡Четыре герцога‡Die vier Fürsten‡네 명의 군주‡Los cuatro Duques‡Los cuatro Duques‡Les quatre ducs‡圣殿骑士‡四個公爵',
    nil,
    'Encontre uma forma de evocar e matar o Duque das Cinzas, o Duque das Profundezas, o Duque dos Zéfiros e o Duque dos Estilhaços e apresente-se ao Comandante Mar\'alith no Forte Cenariano. Você também precisa entregar as Instruções Táticas V para concluir a missão.‡Отыщите способ вызвать и убить герцога Пепла, герцога Глубин, герцога Ветров и герцога Осколков и доложите о выполнении задания командору Мар\'алиту в крепости Кенария. Для завершения задания принесите тактическую задачу V.‡Findet einen Weg, um den Fürst der Asche, den Fürst der Tiefen, den Fürst der Stürme und den Fürst der Splitter zu beschwören und zu vernichten. Erstattet anschließend Bericht bei Kommandant Mar\'alith auf Burg Cenarius. Ihr benötigt auch den taktischen Einsatz V, um diese Aufgabe abschließen zu können.‡불꽃의 군주, 나락의 군주, 서풍의 군주, 그리고 파편의 군주를 소환할 방법을 찾아 처치한 다음 세나리온 요새에 있는 지휘관 마랄리스에게 보고하십시오. 또한, 이 퀘스트를 완료하려면 전술 임무 지령 V도 함께 가져가야 합니다.‡Invoca y mata al Duque de las Brasas, al Duque de las Profundidades, al Duque de los Céfiros y al Duque de las Esquirlas y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas V para poder completar la misión.‡Invoca y mata al duque de las Brasas, al duque de las Profundidades, al duque de los Céfiros y al duque de las Esquirlas y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion. También debes llevar el Informe de tareas tácticas V para poder completar la misión.‡Trouver un moyen d\'invoquer et de tuer les duc des Cendres, le duc des Profondeurs, le duc des Zéphyrs et le duc des Éclats, puis revenir voir le commandant Mar\'alith au Fort cénarien. Pour terminer cette quête, vous devez aussi apporter le Briefing tactique V.‡设法召唤并击杀四个深渊圣殿骑士，然后向塞纳里奥要塞的唤风者梅恩·长角复命。‡設法召喚並擊殺辛德爾公爵、深淵公爵、微風公爵和裂石公爵，然後向塞納里奧城堡的指揮官瑪爾利斯覆命。你還必須隨身帶著戰術任務簡報 V才能完成這個任務。',
  }
},
[8539] = {
  {
    'Alvo: irmãs da Colme\'Zora‡Цель: сестры-убийцы из Улья Зора‡Ziel: Schwestern des Zoraschwarms‡목표: 어미 하이브조라‡Objetivo: las hermanas de la colmena Colmen\'Zora‡Objetivo: las hermanas de la colmena de Colmen\'Zora‡Objectif : les sœurs de Ruche\'Zora‡目标：佐拉雌蝎‡目標:佐拉雌蠍',
    nil,
    'Mate 30 Irmãs da Colme\'Zora e fale novamente com o Comandante Mar\'alith no Forte Cenariano, que fica em Silithus. Você também precisa entregar as Instruções de Combate V para concluir a missão.‡Убейте 30 сестер-убийц из улья Зора и доложите о выполнении задания командору Мар\'алиту в крепости Кенария в Силитусе. Для завершения задания принесите боевую задачу V.‡Tötet 30 Schwestern des Zoraschwarms und erstattet Bericht bei Kommandant Mar\'alith auf Burg Cenarius in Silithus. Ihr benötigt auch Kampfeinsatz V, um diese Aufgabe abschließen zu können.‡어미 하이브조라 30마리를 해치운 다음 실리더스 세나리온 요새에 있는 지휘관 마랄리스에게 돌아가서 보고하십시오. 또한, 이 퀘스트를 완료하려면 전투 임무 지령 V도 함께 가져가야 합니다.‡Mata 30 hermanas de la colmena Colmen\'Zora y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate V para poder completar la misión.‡Mata 30 hermanas de la colmena de Colmen\'Zora y preséntate ante el comandante Mar\'alith en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas de combate V para poder completar la misión.‡Tuez 30 Sœurs de la Ruche\'Zora et revenez faire votre rapport au commandant Mar\'alith au Fort cénarien, en Silithus. Vous devez aussi apporter le Briefing de combat V pour terminer cette quête.‡击杀30只佐拉雌蝎，然后向塞纳里奥要塞的指挥官玛尔利斯复命。你还必须带着作战任务简报 V才能完成这个任务。‡殺死30隻佐拉雌蠍並回希利蘇斯向塞納里奧城堡的指揮官瑪爾利斯回報。你還必須將作戰任務簡報 V帶去才能完成這個任務。',
  }
},
[8540] = {
  {
    'Botas para a guarda‡Сапоги для стражей‡Stiefel für die Wache‡경비대에 장화 공급‡Botas para la guardia‡Botas para la guardia‡Des bottes pour la Garde‡卫兵的护甲片‡衛兵的靴子',
    nil,
    'Leve 3 Botas Ornadas de Mithril para Vish Kozus, Capitão da Guarda, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística II para concluir a missão.‡Принесите 3 пары изысканных мифриловых сапог Вишу Коцусу, капитану стражи крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу II.‡Bringt 3 Paar verschnörkelte Mithrilstiefel zu Vish Kozus, Hauptmann der Wache von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz II, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 경비대장 비쉬 코주스에게 화려한 미스릴 장화 3개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 II도 함께 가져가야 합니다.‡Lleva 3 botas de mitril ornamentado a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas II para poder completar la misión.‡Lleva 3 botas de mitril ornamentado a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas II para poder completar la misión.‡Remettre 3 Bottes ornées en mithril à Vish Kozus, capitaine de la garde du Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique II pour terminer cette quête.‡把3双精制秘银战靴交给希利苏斯塞纳里奥要塞的维斯·库鲁兹。你还必须随身带着后勤任务简报 II才能完成这个任务。‡將3雙華麗秘銀戰靴帶到希利蘇斯給塞納里奧城堡的守衛隊長維斯·庫魯茲。你還必須將後勤任務簡報 II帶去才能完成這個任務。',
  }
},
[8541] = {
  {
    'Pedras de amolar para a guarda‡Шлифовальные камни‡Schleifsteine für die Wache‡경비대에 연마석 공급‡Piedra de pulir para la guardia‡Piedra de pulir para la guardia‡Des silex à aiguiser pour la Garde‡卫兵的磨刀石‡衛兵的砂輪',
    nil,
    'Leve 10 Pedras de Amolar Densas, 10 Pedras de Amolar Maciças e 10 Pedras de Amolar Pesadas para Vish Kozus, Capitão da Guarda, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística III para concluir a missão.‡Принесите 10 массивных шлифовальных камней, 10 твердых шлифовальных камней и 10 тяжелых точильных камней Вишу Коцусу, капитану стражи в крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу III.‡Bringt 10 verdichtete Schleifsteine, 10 robuste Schleifsteine und 10 schwere Schleifsteine zu Vish Kozus, Hauptmann der Wache von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz III, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 경비대장 비쉬 코주스에게 강도 높은 연마석, 견고한 연마석, 단단한 연마석을 각각 10개씩 모아서 가져가야 합니다. 이 임무를 완료하려면 병참 임무 지령 III도 함께 가져가야 합니다.‡Lleva 10 piedras de pulir densas, 10 piedras de pulir sólidas y 10 piedras de pulir pesadas a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas III para poder completar la misión.‡Lleva 10 piedras de pulir densas, 10 piedras de pulir sólidas y 10 piedras de pulir pesadas a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas III para poder completar la misión.‡Apporter 10 Silex à aiguiser denses, 10 Silex à aiguiser solides et 10 Silex à aiguiser lourds à Vish Kozus, capitaine de la garde du Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique III pour terminer cette quête.‡把10块致密砂轮、10块坚固的砂轮和10块重砂轮交给希利苏斯塞纳里奥要塞的维斯·库鲁兹。你还必须随身带着后勤任务简报 III才能完成这个任务。‡將10個緻密砂輪，10個堅固的砂輪和10個重砂輪帶到希利蘇斯給塞納里奧城堡的守衛隊長維斯·庫魯茲。你還必須將後勤任務簡報 III帶去才能完成這個任務。',
  }
},
[8542] = {
  {
    'A Horda precisa de barras de estanho!‡Орде не хватает оловянных слитков!‡Die Horde braucht Zinnbarren!‡호드에 주석 주괴 조달!‡¡La Horda necesita lingotes de estaño!‡¡La Horda necesita lingotes de estaño!‡La Horde a besoin de barres d\'étain !‡部落需要锡锭！‡部落需要錫錠!',
    nil,
    'Leve 20 Barras de Estanho ao Bruto Maug no Vale dos Espíritos em Orgrimmar.‡Принесите 20 оловянных слитков рубаке Маугу в Аллею Духов Оргриммара.‡Bringt 20 Zinnbarren zu Grunzer Maug im Tal der Geister in Orgrimmar.‡오그리마, 정기의 골짜기에 있는 그런트 마우그에게 주석 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de estaño al bruto Maug en el Valle de los Espíritus de Orgrimmar.‡Llévale 20 lingotes de estaño al bruto Maug en el Valle de los Espíritus de Orgrimmar.‡Apportez 20 Barres d\'étain au grunt Maug dans la Vallée des esprits d\'Orgrimmar.‡把20块锡锭交给奥格瑞玛精神谷的步兵玛乌格。‡帶20個錫錠給奧格瑪精神谷的蠻兵瑪烏格。',
  }
},
[8543] = {
  {
    'A Horda precisa de mais barras de estanho!‡Орде все еще нужны оловянные слитки!‡Die Horde braucht mehr Zinnbarren!‡호드에 주석 주괴 추가 조달!‡¡La Horda necesita más lingotes de estaño!‡¡La Horda necesita más lingotes de estaño!‡La Horde a besoin de plus de barres d\'étain !‡部落需要更多锡锭！‡',
    nil,
    'Leve 20 Barras de Estanho ao Bruto Maug em Durotar.‡Принесите 20 оловянных слитков рубаке Маугу в Дуротар.‡Bringt 20 Zinnbarren zu Grunzer Maug in Durotar.‡듀로타에 있는 그런트 마우그에게 주석 주괴 20개를 가져가야 합니다.‡Llévale 20 lingotes de estaño al bruto Maug en Durotar.‡Llévale 20 lingotes de estaño al bruto Maug en Durotar.‡Ramener 20 barres d\'étain au grunt Maug en Durotar.‡把20块锡锭交给杜隆塔尔的步兵玛乌格。‡',
  }
},
[8544] = {
  {
    'Espaldares do Conquistador‡Наплеч Завоевателя‡Schiftung des Eroberers‡정복자의 어깨갑옷‡Las bufas de conquistador‡Las bufas de conquistador‡Les spallières de conquérant‡征服者的肩铠‡征服者的肩甲',
    nil,
    'Leve os Braceletes do Comando Qiraji, 2 Ídolos da Noite, 5 Escaravelhos de Pedra e 5 Escaravelhos de Barro para Andorgos em Ahn\'Qiraj. Também é necessário ser <Tolerado/Tolerada> pela Prole de Nozdormu para concluir a missão.‡Принесите киражские наручники Командования, 2 идола Ночи, 5 каменных и 5 глиняных скарабеев Андоргосу в Ан\'Кираж. Кроме того, необходимо заслужить как минимум равнодушное отношение рода Ноздорму.‡Bringt die Befehlsbindungen der Qiraji, 2 Götzen der Nacht, 5 Steinskarabäen und 5 Tonskarabäen zu Andorgos in Ahn\'Qiraj. Diese Aufgabe erfordert zum Abschluss auch einen neutralen Ruf bei der Brut Nozdormus.‡노즈도르무 혈족에게 중립적 평판을 얻고, 안퀴라즈에 있는 안도르고스에게 지휘의 퀴라지 팔보호구, 밤의 우상 2개, 돌 스카라베 5개, 찰흙 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 노즈도르무 혈족으로부터 중립적 이상의 평판을 얻어야 합니다.‡Llévale las ataduras de mando qiraji, 2 ídolos de la noche, 5 escarabajos de piedra y 5 escarabajos de terracota a Andorgos en Ahn\'Qiraj. También debes alcanzar la reputación neutral ante el Linaje de Nozdormu para completar esta misión.‡Llévale las ataduras de mando qiraji, 2 ídolos de la noche, 5 escarabajos de piedra y 5 escarabajos de terracota a Andorgos en Ahn\'Qiraj. También debes alcanzar la reputación neutral ante el Linaje de Nozdormu para completar esta misión.‡Ramener des Manchettes de commandement qiraji, 2 Idoles de la nuit, 5 Scarabées de pierre et 5 Scarabées d\'argile à Andorgos, à Ahn\'Qiraj. Pour terminer cette quête, la Progéniture de Nozdormu doit au moins être Neutre à votre égard.‡把其拉命令腕轮、2个夜晚塑像、5个岩石甲虫和5个陶土甲虫交给安其拉的安多葛斯。你必须首先在诺兹多姆的子嗣中达到中立声望才可以完成这个任务。‡將其拉命令束腕、2個夜晚塑像、5隻石甲蟲和5隻泥土甲蟲帶給安其拉的安多葛斯。你還必須在諾茲多姆的子嗣達到中立的聲望值才能完成這個任務。',
  }
},
[8545] = {
  {
    'A Horda precisa de barras de mithril!‡Орде не хватает мифриловых слитков!‡Die Horde braucht Mithrilbarren!‡호드에 미스릴 주괴 조달!‡¡La Horda necesita barras de mitril!‡¡La Horda necesita barras de mitril!‡La Horde a besoin de barres de mithril !‡部落需要秘银锭！‡部落需要秘銀錠!',
    nil,
    'Leve 20 Barras de Mithril à Primeiro-Sargento T\'kelah no Vale dos Espíritos em Orgrimmar.‡Принесите 20 мифриловых слитков старшему сержанту Ткелаху. Ткелах находится на аллее Духов Оргриммара.‡Bringt 20 Mithrilbarren zu Schlachtrufer T\'kelah im Tal der Geister in Orgrimmar.‡오그리마의 정기의 골짜기에 있는 정예수호병 티키라에게 미스릴 주괴 20개를 가져가야 합니다.‡Llévale 20 barras de mitril al sargento jefe T\'kelah en el Valle de los Espíritus de Orgrimmar.‡Llévale 20 barras de mitril al sargento jefe T\'kelah en el Valle de los Espíritus de Orgrimmar.‡Ramener 20 barres de mithril au sergent-chef T\'kelah dans la Vallée des esprits d\'Orgrimmar.‡把20块秘银锭交给奥格瑞玛精神谷的军士长克拉恩。‡帶20個秘銀錠給奧格瑪精神谷的資深士官克拉恩。',
  }
},
[8546] = {
  {
    'A Horda precisa de mais barras de mithril!‡Орде все еще не хватает мифриловых слитков!‡Die Horde braucht mehr Mithrilbarren!‡호드에 미스릴 주괴 추가 조달!‡¡La Horda necesita más barras de mitril!‡¡La Horda necesita más barras de mitril!‡La Horde a besoin de plus de barres de mithril !‡部落需要更多秘银锭！‡',
    nil,
    '‡Ага, приятно снова тебя видеть, дружище. Я помню, ты уже помог мне разок, а теперь снова нужна твоя помощь. Мы продолжаем собирать для войны мифриловые слитки. Из них получится отличное оружие, которым мы легко передавим всех этих киражских тараканов.nnТак что, если ты и правда нам друг, принеси еще мифриловых слитков. Пока мы не выполнили нашу квоту, я очень на тебя рассчитываю.‡Bringt 20 Mithrilbarren zu Schlachtrufer T\'kelah im Tal der Geister in Orgrimmar.‡이렇게 다시 만나 반갑습니다. 예전 일도 고맙지만 절 또 한 번 도와주셔야겠습니다. 전쟁에 쓸 미스릴 주괴가 더 필요해요. 그래야 안퀴라즈에서 해충을 박멸하는 데 사용할 갑옷이며 무기 등을 충분히 만들 수 있을 테니까요.nn당신이 우리의 진정한 친구라면 미스릴 주괴를 좀 더 가져다주세요. 목표량을 채울 때까지는 얼마든지 더 받겠어요. 그런데 지금 가지고 있는 건 없나요?‡Sí, m’alegro qu’hayas venío, colega. M’has ayudao antes y ahora vuelvo a necesitarte. Entoavía hay que traer más lingotes de mitril pa’ los preparativos de la guerra; vamos a construir un montón d’armaduras, armas y tal y tal pa\' aplastar a esos bichos d’Ahn\'Qiraj.nnSi eres un amiga de verdad, tráeme más pilas de lingotes de mitril. Me lo quedaré to\' hasta qu\'alcancemos nuestro cupo. ¿No tendrás algunos pa’ mí ahora?‡Llévale 20 barras de mitril al sargento jefe T\'kelah en el Valle de los Espíritus de Orgrimmar.‡Apportez 20 Barres de mithril au Sergent-chef T\'kelah dans la Vallée des Esprits d\'Orgrimmar.‡带20个秘银锭给奥格玛精神谷的资深士官克拉恩。‡',
  }
},
[8547] = {
  {
    'Boas-vindas!‡Привет!‡Willkommen!‡환영합니다!‡¡Bienvenido!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Entregue o Vale-brinde da Praça Asa do Falcão à Marsilla Aurestela na Praça Asa do Falcão.‡Принесите подарочный сертификат площади Соколиных Крыльев Марсилле Утренней Звезде.‡Bringt den Geschenkgutschein des Falkenplatzes zu Marsilla Morgenstern auf dem Falkenplatz.‡매날개 광장에 있는 마르실라 돈스타에게 매날개 광장 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de la Plaza Alalcón a Marsilla Estrella del Alba en la Plaza Alalcón.‡‡Apporter le bon-cadeau de la place de l\'Épervier à Marsilla Aubétoile, place de l\'Épervier.‡将鹰翼广场礼品券交给鹰翼广场的玛希尔拉·晨星。‡將獵鷹之翼廣場禮品券帶到獵鷹之翼廣場的日尖塔給瑪希拉·晨星。',
  }
},
[8548] = {
  {
    'Equipamento de batalha do voluntário‡Броня добровольца‡Schlachtrüstung des Kriegsfreiwilligen‡지원자의 전투장비‡Equipamiento de Voluntario‡Equipamiento de Voluntario‡L\'équipement de guerre des volontaires‡志愿兵的装备‡志願兵的裝備',
    nil,
    'Leve 5 Insígnias de Combate Cenarianas, 3 Insígnias Logísticas Cenarianas e 7 Insígnias Táticas Cenarianas para Vargus no Forte Cenariano, em Silithus. Também é necessário ser <Respeitado/Respeitada> pelo Círculo Cenariano para concluir a missão.‡Принесите 5 боевых, 3 тыловых и 7 тактических знаков Кенария Варгусу из крепости Кенария в Силитусе. Требуется дружелюбие со стороны Круга Кенария.‡Bringt 5 cenarische Gefechtsabzeichen, 3 cenarische Versorgungsabzeichen und 7 cenarische Strategieabzeichen zu Vargus auf Burg Cenarius in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen freundlichen Ruf beim Zirkel des Cenarius.‡실리더스의 세나리온 요새에 있는 바르구스에게 세나리온 전투 휘장 5개, 세나리온 병참 휘장 3개, 세나리온 전술 휘장 7개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 대한 약간 우호적 이상의 평판을 얻어야 합니다.‡Lleva 5 distintivos de combate Cenarion, 3 distintivos de logística Cenarion y 7 distintivos de táctica Cenarion a Vargus en el Fuerte Cenarion, en Silithus. También debes conseguir un nivel de reputación amistoso con el Círculo Cenarion para poder completar esta misión.‡Lleva 5 distintivos de combate Cenarion, 3 distintivos de logística Cenarion y 7 distintivos de táctica Cenarion a Vargus en el Fuerte Cenarion, en Silithus. También debes conseguir un nivel de reputación amistoso con el Círculo Cenarion para poder completar esta misión.‡Ramener 5 Badges cénariens de combat, 3 Badges cénariens de logistique et 7 Badges cénariens de tactique à Vargus, au Fort cénarien en Silithus. Pour terminer cette quête, il faut aussi que le Cercle cénarien soit au moins Amical à votre égard.‡把5枚作战徽章、3枚后勤徽章和7枚战术徽章交给塞纳里奥要塞的瓦古斯。你必须在塞纳里奥议会中达到友善声望才能完成这个任务。‡將5個塞納里奧作戰徽章，3個塞納里奧後勤徽章，和7個塞納里奧戰術徽章帶到希利蘇斯給塞納里奧城堡的瓦古斯。你還必須在塞納里奧議會達到友好聲望值才能完成這個任務。',
  }
},
[8549] = {
  {
    'A Horda precisa de botão-da-paz!‡Орде не хватает мироцвета!‡Die Horde braucht Friedensblumen!‡호드에 평온초 꽃잎 조달!‡¡La Horda necesita flores de paz!‡¡La Horda necesita flores de paz!‡La Horde a besoin de pacifique !‡部落需要宁神花！‡部落需要寧神花!',
    nil,
    'Leve 20 Botões-da-paz à Herborista Pena Altiva no Vale dos Espíritos em Orgrimmar.‡Принесите 20 цветков мироцвета травнице Гордый Плюмаж в Аллею Духов Оргриммара.‡Bringt 20 Friedensblumen zu der Kräuterkundigen Stolzfeder im Tal der Geister in Orgrimmar.‡오그리마의 정기의 골짜기에 있는 약초채집사 프라우드페더에게 평온초 꽃잎 20개를 가져가야 합니다.‡Llévale 20 flores de paz al herborista Plumorgullo en el Valle de los Espíritus de Orgrimmar.‡Llévale 20 flores de paz al herborista Pluma Digna en el Valle de los Espíritus de Orgrimmar.‡Ramener 20 pacifiques à l\'herboriste Plume-fière dans la Vallée des esprits d\'Orgrimmar.‡把20朵宁神花交给奥格瑞玛精神谷的草药学家波德·飞羽。‡帶20個寧神花給奧格瑪精神谷的草藥學家波德·飛羽。',
  }
},
[8550] = {
  {
    'A Horda precisa de mais botões-da-paz!‡Орде все еще не хватает мироцвета!‡Die Horde braucht mehr Friedensblumen!‡호드에 평온초 꽃잎 추가 조달!‡¡La Horda necesita más flores de paz!‡¡La Horda necesita más flores de paz!‡La Horde a besoin de plus de pacifique !‡部落需要更多宁神花！‡',
    nil,
    '‡Приветствую тебя еще раз, Дэдоутсайд. Я рада, что ты решил снова помочь нам в этом бесконечном сборе мироцвета. Подготовка к войне идет полным ходом, поэтому эликсиры и снадобья нужны в огромных количествах.nnСобери столько же мироцвета, сколько и в прошлый раз, и благодарность моя не будет знать границ. Если вдруг собранный мироцвет у тебя уже с собой, то я приму его с радостью.‡Hallo <Name>. Ich bin froh, dass Ihr noch einmal wegen unserer niemals enden wollenden Sammelaktion für Friedensblumen nachfragt. Die Kriegsvorbereitungen gehen weiter und damit auch die Herstellung von Tränken und Elixiren, die in den kommenden Kämpfen helfen sollen.nnWerdet Ihr uns wieder unterstützen, <Klasse>? Ich benötige noch einmal genauso viele Friedensblumen wie zuvor. Wenn Ihr also ein weiteres Mal diese Pflanzen sammeln und anschließend zu mir zurückbringen könntet, wäre ich Euch äußerst dankbar. Solltet Ihr bereits welche bei Euch haben, umso besser.‡오그리마의 정기의 골짜기에 있는 약초채집가 프라우드페더에게 평온초 꽃잎 20개를 가져가야 합니다.‡Llévale 20 flores de paz al herborista Pluma Digna en el Valle de los Espíritus de Orgrimmar.‡Llévale 20 flores de paz al herborista Pluma Digna en el Valle de los Espíritus de Orgrimmar.‡Apportez 20 Pacifiques à l\'Herboriste Plume-fière dans la Vallée des Esprits d\'Orgrimmar.‡把20朵宁神花交给奥格瑞玛精神谷的草药学家波德·飞羽。‡',
  }
},
[8551] = {
  {
    'O baú do capitão‡Сундук капитана‡Die Truhe des Kapitäns‡선장의 상자‡El cofre del Capitán‡El cofre del Capitán‡Le coffre du capitaine‡船长的箱子‡船長的箱子',
    nil,
    'Leve o Baú do Smotts para Hacklebury Smotts na Angra do Butim.‡Верните Гекельберри Шмотту из Пиратской бухты его сундук.‡Bringt Smotts\' Truhe zu Hecklebury Smotts nach Beutebucht.‡무법항에 있는 허클베리 스모츠에게 스모츠의 상자를 가져가야 합니다.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Apporter le coffre au capitaine Hecklebury Smotts à Baie-du-Butin.‡将斯莫特的箱子交给藏宝海湾的海克拜瑞·斯莫特。‡將斯莫特的箱子交給藏寶海灣的海克拜瑞·斯莫特。',
  }
},
[8552] = {
  {
    'A faixa com monograma‡Кушак с монограммой‡Die Schärpe mit Monogramm‡이니셜이 새겨진 머리띠‡La banda con monograma‡La banda con monograma‡L\'écharpe à monogramme‡刺着字母的腰带‡刺著字母的束帶',
    nil,
    'Devolva a Faixa com Monograma ao proprietário.‡Верните кушак с монограммой владельцу.‡Bringt die Schärpe mit Monogramm zu ihrem Besitzer zurück.‡이니셜이 새겨진 머리띠를 주인에게 돌려줘야 합니다.‡Devuelve la banda con monograma a su propietario.‡Devuelve la banda con monograma a su propietario.‡Rendre l\'Echarpe à monogramme à son propriétaire.‡将刺着字母的腰带还给他的主人。‡將刺著字母的束帶還給他的主人。',
  }
},
[8553] = {
  {
    'O alfanje do capitão‡Капитанская сабля‡Der Entersäbel des Kapitäns‡선장의 커틀라스‡El alfanje del Capitán‡El alfanje del Capitán‡Le sabre du capitaine Smott‡船长的弯刀‡船長的彎刀',
    nil,
    'Fale com Zero.‡Поговорите с Салагой.‡Sprecht mit Knirpsens.‡스프로거와 대화해야 합니다.‡Habla con Tardo.‡Habla con Tardo.‡Parler à Bizutard.‡与斯普罗格谈一谈。‡與斯普羅格談話。',
  }
},
[8554] = {
  {
    'Confrontando Negolash‡Бой с Неголашем‡Negolash entgegentreten‡네골라쉬와의 대적‡Enfréntate a Negolash‡Enfréntate a Negolash‡Face à Negolash‡挑战奈古拉什‡挑戰奈古拉什',
    nil,
    'Leve 10 Asas de Urubu Grelhadas e 5 garrafas de Vinho Selvavinha até o bote salva-vidas do Capitão Smotts.nnMate Negolash e leve o Alfanje de Smotts para o Capitão Smotts na Selva do Espinhaço.‡Отнесите 10 жареных крылышек канюка и 5 бутылок экзотического вина в спасательную шлюпку капитана Шмотта.nnУбейте Неголаша и отнесите абордажную саблю Шмотта хозяину в Тернистую долину.‡Bringt 10 gegrillte Bussardflügel und 5 Flaschen Dschungelrankenwein zu Käpt\'n Smotts Rettungsboot.nnTötet Negolash und bringt Smotts\' Entersäbel zu Kapitän Smotts ins Schlingendorntal.‡선장 스모츠의 구명정에 대머리수리 날개 구이 10개와 밀림포도나무 와인 5병을 가져가야 합니다.nn네골라쉬를 처치하고 가시덤불 골짜기에 있는 선장 스모츠에게 스모츠의 커틀라스를 가져가십시오.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.nnMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Apporter 10 Ailes de busard grillées et 5 bouteilles de Vin de Junglevine dans le Canot de sauvetage du capitaine Smotts.nnTuer Negolash, et apporter le Sabre d\'abordage de Smotts au capitaine Smotts, à Strangleronce.‡将10块烧烤秃鹰翅膀和5瓶密林葡萄酒带到斯莫特船长的救生艇上去。nn然后杀死奈古拉什，将斯莫特的弯刀交给荆棘谷的斯莫特船长。‡將10塊燒烤禿鷲翅膀和5瓶密林葡萄酒帶到斯莫特船長的救生艇上去。|n然後殺死奈古拉什，將斯莫特的彎刀交給荊棘谷的斯莫特船長。',
  }
},
[8555] = {
  {
    'O ataque das revoadas‡Создание драконов‡Der Bund der Drachenschwärme‡용군단의 임무‡Encomienda a los Vuelos‡Encomienda a los Vuelos‡Le fardeau des Vols draconiques‡守护之龙‡守護之龍',
    nil,
    '‡Эраникус, Веластрас и Азурегос... Не сомневаюсь, тебе приходилось слышать об этих драконах, смертный. И они не случайно сыграли очень важную роль как наблюдатели нашего мира.nnК сожалению (и в этом виновата отчасти моя наивность), под воздействием то ли посланников Древних Богов, то ли предательства близких людей, все они пали. Благодаря чему мое недоверие к твоим собратьям только усилилось.nnОтыщи их... И готовься к худшему, |3-6(ночной эльф).‡Eranikus, Vaelastrasz und Azuregos... zweifellos kennt Ihr diese Drachen, Sterblicher. Es ist daher auch kein Zufall, dass sie eine so wichtige Rolle als Behüter unserer Welt gespielt haben.nnUnglücklicherweise (und zum Teil ist auch meine eigene Naivität daran schuld) fiel jeder Wächter, sei es durch Beauftragte der alten Götter oder Verrat derer, die sie ihre Freunde nannten, der Tragödie zum Opfer. Das Ausmaß dessen, schürte mein Misstrauen zu Euereins noch mehr an.nnSucht nach ihnen... und <Volk>, bereitet Euch auf das Schlimmste vor.‡에라니쿠스, 밸라스트라즈, 아주어고스... 필멸의 존재여, 그대는 필시 이 용들에 대해 알고 있다. 그러니 이들이 우리 세계의 파수꾼으로서 중요한 역할을 해 왔다는 것은 결코 우연이 아니니라.nn불행히도 고대 신들의 추종자 아니면 그들을 친구라고 부르는 자들의 배신으로 인해 우리의 수호자들에게 비극이 일어났다. 물론 내 어리석음도 어느 정도 잘못이 있다는 것을 부인할 수는 없지만... 이 일로 그대의 종족에 대한 나의 불신은 그만큼 깊어졌느니라.nn그들을 찾아라... 그리고 최악의 상황에 대비하도록 하라.‡‡‡Eranikus, Vaelastrasz, et Azuregos... Vous avez certainement entendu parler de ces dragons, mortel. Ce n’est pas une simple coïncidence si chacun d’eux a joué un grand rôle comme gardien de ce monde.nnMalheureusement, et ma propre naïveté en est en partie responsable, ces gardiens ont tous succombé à de terribles tragédies, si terribles qu’elles ont alimenté ma méfiance à l’égard de votre espèce.nnCherchez-les… Et préparez-vous au pire, <race>.‡‡',
  }
},
[8556] = {
  {
    'Sinete da Força Obstinada‡Перстень Неукротимой силы‡Siegel der unnachgiebigen Stärke‡굴하지 않는 힘의 인장‡El sello de fuerza implacable‡El sello de fuerza implacable‡Chevalière de force inflexible‡坚定力量之戒‡不屈力量之戒',
    nil,
    'Leve 1 Anel Magistral Qiraji, 2 Ídolos Bruxuleantes, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para a Arauto do Vento Yessendra em Silithus. Também é necessário ser <Honrado/Honrada> pelo Círculo Cenariano para concluir a missão.‡Принесите киражское кольцо власти, 2 лучистых идола, 5 бронзовых скарабеев и 5 скарабеев из слоновой кости Зовущей Йессендре в Силитус. Кроме того, необходимо заслужить как минимум уважительное отношение Круга Кенария.‡Bringt 1 Gebieterring der Qiraji, 2 züngelnde Götzen, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Windruferin Yessendra in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf beim Zirkel des Cenarius.‡실리더스에 있는 바람소환사 예센드라에게 권위의 퀴라지 반지 1개, 미명석 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에 우호적 평판을 얻어야 합니다.‡Llévale 1 anillo de magistrado qiraji, 2 ídolos luminiscentes, 5 escarabajos de bronce y 5 escarabajos de marfil a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Llévale 1 anillo qiraji magistral, 2 ídolos luminiscentes, 5 escarabajos de bronce y 5 escarabajos de marfil a Clamavientos Yessendra en Silithus. También debes alcanzar la reputación de honorable ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Anneau de magistrat qiraji, 2 Idoles diaprées, 5 Scarabées en bronze et 5 Scarabées d\'ivoire à l\'imploratrice céleste Yessendra, en Silithus. Vous devrez aussi être <Honoré/Honorée> par le Cercle cénarien pour terminer cette quête.‡将1枚其拉将领戒指、2个柔光雕像、5个青铜甲虫和5个象牙甲虫交给唤风者耶萨德拉。‡帶1枚其拉將領戒指、2個柔光塑像、5隻青銅甲蟲和5隻象牙甲蟲給希利蘇斯的喚風者耶薩德拉。你還需要在塞納里奧議會達到尊敬聲望才能完成這個任務。',
  }
},
[8557] = {
  {
    'Clâmide da Força Obstinada‡Пелерина Неукротимой силы‡Tuch der unnachgiebigen Stärke‡굴하지 않는 힘의 망토‡El mantón de fuerza implacable‡El mantón de fuerza implacable‡Drapé de force inflexible‡坚定力量披风‡不屈力量披氅',
    nil,
    'Leve 1 Clâmide Marcial Qiraji, 2 Ídolos Ônix, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para Keyl Garralesta em Silithus. Também é necessário ser <Reverenciado/Reverenciada> pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую воинскую пелерину, 2 ониксовых идола, 5 серебряных и 5 костяных скарабеев Кейлу Стремительному Когтю в Силитус. Кроме того, необходимо заслужить как минимум почтительное отношение Круга Кенария.‡Bringt 1 Kampftuch der Qiraji, 2 Onyxgötzen, 5 Sillberskarabäen und 5 Knochenskarabäen zu Keyl Flinkklaue in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen respektvollen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 케일 스위프트클로에게 전쟁의 퀴라지 망토 1개, 마노 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 세나리온 의회에서 매우 우호적 이상의 평판도 얻어야 합니다.‡Llévale 1 mantón marcial qiraji, 2 ídolos de ónice, 5 escarabajos de plata y 5 escarabajos de hueso a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 mantón marcial qiraji, 2 ídolos de ónice, 5 escarabajos de plata y 5 escarabajos de hueso a Keyl Patacerce en Silithus. También debes alcanzar la reputación de venerado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Drapé martial qiraji, 2 Idoles d\'onyx, 5 Scarabées d\'argent et 5 Scarabées d\'os à Keyl Vivegriffe, en Silithus. Vous devrez aussi être <Révéré/Révérée> par le Cercle cénarien pour terminer cette quête.‡将1件其拉军用披风、2个玛瑙雕像、5个银质甲虫和5个白骨甲虫交给凯伊·迅爪。你必须在塞纳里奥议会中达到崇敬声望才能完成这个任务。‡帶1件其拉軍用披氅、2個瑪瑙塑像、5隻銀色甲蟲和5隻白骨甲蟲給希利蘇斯的凱伊·迅爪。你還需要在塞納里奧議會達到崇敬聲望才能完成這個任務。',
  }
},
[8558] = {
  {
    'Foice da Força Obstinada‡Серп Неукротимой силы‡Sichel der unnachgiebigen Stärke‡굴하지 않는 힘의 도끼‡La hoz de fuerza implacable‡La hoz de fuerza implacable‡La faucille de force inflexible‡坚定力量之镰‡不屈力量之鐮',
    nil,
    'Leve 1 Punho de Pontas Qiraji, 2 Ídolos de Alabastro, 5 Escaravelhos de Cristal e 5 Escaravelhos de Pedra para o Guardião Haro em Silithus. Também é necessário ser <Exaltado/Exaltada> pelo Círculo Cenariano para concluir a missão.‡Принесите киражскую шипастую рукоять, 2 алебастровых идола, 5 хрустальных и 5 каменных скарабеев Надзирателю Харо в Силитус. Кроме того, вас должны превозносить в Круге Кенария.‡Bringt 1 Stachelgriff der Qiraji, 2 Alabastergötzen, 5 Kristallskarabäen und 5 Steinskarabäen zu Aufseher Haro in Silithus. Diese Aufgabe erfordert zum Abschluss auch einen ehrfürchtigen Ruf beim Zirkel des Cenarius.‡실리더스에 있는 감시자 하로에게 못 박힌 퀴라지 자루 1개, 설화석 우상 2개, 수정 스카라베 5개, 돌 스카라베 5개를 가져가야 합니다. 또한 이 퀘스트를 완료하려면 세나리온 의회에서 확고한 동맹의 평판도 얻어야 합니다.‡Llévale 1 empuñadura con púas qiraji, 2 ídolos de porcelana, 5 escarabajos de cristal y 5 escarabajos de piedra al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Llévale 1 puño con pinchos qiraji, 2 ídolos de alabastro, 5 escarabajos de cristal y 5 escarabajos de piedra al celador Haro en Silithus. También debes alcanzar la reputación de exaltado ante el Círculo Cenarion para completar esta misión.‡Apporter 1 Manche à pointes qiraji, 2 Idoles d\'albâtre, 5 Scarabées de cristal et 5 Scarabées de pierre au Gardien Haro, en Silithus. Vous devrez aussi être <Exalté/Exaltée> par le Cercle cénarien pour terminer cette quête.‡将1件其拉尖刺刀柄、2个雪白雕像、5个水晶甲虫和5个岩石甲虫交给希利苏斯的守望者哈尔洛。你必须在塞纳里奥议会中达到崇拜声望才能完成这个任务。‡帶1把其拉尖刺刀柄、2個雪白塑像、5隻水晶甲蟲和5隻石甲蟲給希利蘇斯的守望者哈爾洛。你還必須在塞納里奧議會達到崇拜聲望值才能完成這個任務。',
  }
},
[8559] = {
  {
    'Grevas do Conquistador‡Наголенники Завоевателя‡Schienbeinschützer des Eroberers‡정복자의 경갑‡Las grebas de conquistador‡Las grebas de conquistador‡Les grèves de conquérant‡征服者的胫甲‡征服者的護脛',
    nil,
    'Leve os Braceletes do Comando Qiraji, 2 Ídolos de Guerra, 5 Escaravelhos de Marfim e 5 Escaravelhos de Ouro para Kandrostrasz em Ahn\'Qiraj. Também é necessário ser <Tolerado/Tolerada> pela Prole de Nozdormu para concluir a missão.‡Принесите киражские наручники Командования, 2 идола Войны, 5 золотых скарабеев и 5 скарабеев из слоновой кости Кандострасу в Ан\'Кираж. Кроме того, необходимо заслужить как минимум равнодушное отношение рода Ноздорму.‡Bringt die Befehlsbindungen der Qiraji, 2 Götzen des Krieges, 5 Elfenbeinskarabäen und 5 Goldskarabäen zu Kandrostrasz in Ahn\'Qiraj. Diese Aufgabe erfordert auch einen neutralen Ruf bei der Brut Nozdormus.‡안퀴라즈에 있는 칸드로스트라즈에게 지휘의 퀴라지 팔보호구, 전쟁의 우상 2개, 상아 스카라베 5개, 황금 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 노즈도르무 혈족으로부터 중립적 이상의 평판도 얻어야 합니다.‡Llévale las ataduras de mando qiraji, 2 ídolos de la guerra, 5 escarabajos de marfil y 5 escarabajos de oro a Kandrostrasz en Ahn\'Qiraj. Esta misión requiere la reputación neutral con la facción Linaje de Nozdormu.‡Llévale las ataduras de mando qiraji, 2 ídolos de la guerra, 5 escarabajos de marfil y 5 escarabajos de oro a Kandrostrasz en Ahn\'Qiraj. Esta misión requiere la reputación neutral con la facción Linaje de Nozdormu.‡Ramener des Manchettes de commandement qiraji, 2 Idoles de la guerre, 5 Scarabées d\'ivoire et 5 Scarabées d\'or à Kandrostrasz, à Ahn\'Qiraj. Il faut aussi que la Progéniture de Nozdormu soit au moins Neutre à votre égard.‡把其拉命令腕轮、2个战争塑像、5个象牙甲虫和5个黄金甲虫交给安其拉的坎多斯特拉兹。你必须首先在诺兹多姆的子嗣中达到中立声望才可以完成这个任务。‡將其拉命令束腕、2個戰爭塑像、5隻象牙甲蟲和5隻金色甲蟲帶給安其拉的坎多斯特拉茲。此任務還需要在諾茲多姆的子嗣達到中立的聲望。',
  }
},
[8560] = {
  {
    'Guarda-pernas do Conquistador‡Набедренники Завоевателя‡Beinschützer des Eroberers‡정복자의 다리갑옷‡Las musleras de conquistador‡Las musleras de conquistador‡Les garde-jambes de conquérant‡征服者的腿铠‡征服者的腿甲',
    nil,
    'Leve o Pelego Intacto de Ouroboros, 2 Ídolos da Morte, 5 Escaravelhos de Bronze e 5 Escaravelhos de Marfim para Kandrostrasz em Ahn\'Qiraj. Também é necessário ser <Respeitado/Respeitada> pela Prole de Nozdormu para concluir a missão.‡Принесите целую шкуру Оуро, 2 идола Смерти, 5 бронзовых скарабеев и 5 скарабеев из слоновой кости Кандострасу в Ан\'Кираж. Кроме того, необходимо заслужить как минимум дружественное отношение рода Ноздорму.‡Bringt Ouros intakte Haut, 2 Götzen des Todes, 5 Bronzeskarabäen und 5 Elfenbeinskarabäen zu Kandrostrasz innerhalb von Ahn\'Qiraj. Diese Aufgabe erfordert zum Abschluss auch einen freundlichen Ruf bei der Brut Nozdormus.‡안퀴라즈 안에 있는 칸드로스트라즈에게 온전한 아우로의 가죽, 죽음의 우상 2개, 청동 스카라베 5개, 상아 스카라베 5개를 가져가야 합니다. 또한, 이 임무를 완수하려면 노즈도르무 혈족으로부터 약간 우호적 이상의 평판을 얻어야 합니다.‡Llévale la piel intacta de Ouro, 2 ídolos de muerte, 5 escarabajos de bronce y 5 escarabajos de marfil a Kandrostrasz en Ahn\'Qiraj. También debes alcanzar la reputación de amistoso ante el Linaje de Nozdormu para completar esta misión.‡Llévale la piel intacta de Ouro, 2 ídolos de muerte, 5 escarabajos de bronce y 5 escarabajos de marfil a Kandrostrasz en Ahn\'Qiraj. También debes alcanzar la reputación de amistoso ante el Linaje de Nozdormu para completar esta misión.‡Ramener la Peau intacte d\'Ouro, 2 Idoles de la mort, 5 Scarabées en bronze et 5 Scarabées d\'ivoire à Kandrostrasz, à l\'intérieur d\'Ahn\'Qiraj. Pour terminer cette quête, il faut également que la Progéniture de Nozdormu soit au moins Amicale à votre égard.‡把奥罗的外皮、2个死亡塑像、5个青铜甲虫和5个象牙甲虫交给安其拉的坎多斯特拉兹。你必须首先在诺兹多姆的子嗣中达到友善声望才可以完成这个任务。‡將奧羅的外皮、2個死亡塑像、5隻青銅甲蟲和5隻象牙甲蟲帶給安其拉裡面的坎多斯特拉茲。你還必須在諾茲多姆的子嗣達到友好聲望值才能完成這個任務。',
  }
},
[8561] = {
  {
    'Coroa do Conquistador‡Корона Завоевателя‡Krone des Eroberers‡정복자의 왕관‡La corona de conquistador‡La corona de conquistador‡La couronne de conquérant‡征服者的皇冠‡征服者之冠',
    nil,
    'Leve o Diadema de Vek\'Nilash, 2 Ídolos do Sol, 5 Escaravelhos de Pedra e 5 Escaravelho de Cristal para Andorgos em Ahn\'Qiraj. Também é necessário ser <Respeitado/Respeitada> pela Prole de Nozdormu para concluir a missão.‡Принесите венец Век\'нилаша, 2 идола Солнца, 5 каменных и 5 хрустальных скарабеев Андоргосу в Ан\'Кираж. Кроме того, необходимо заслужить как минимум дружественное отношение рода Ноздорму.‡Bringt Vek\'nilashs Reif, 2 Götzen der Sonne, 5 Steinskarabäen und 5 Kristallskarabäen zu Andorgos in Ahn\'Qiraj. Diese Aufgabe erfordert zum Abschluss auch einen freundlichen Ruf bei der Brut Nozdormus.‡안퀴라즈에 있는 안도르고스에게 베크닐라쉬의 관, 태양의 우상 2개, 돌 스카라베 5개, 수정 스카라베 5개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 노즈도르무 혈족으로부터 약간 우호적 이상의 평판도 얻어야 합니다.‡Llévale el aro de Vek\'lor, 2 ídolos del sol, 5 escarabajos de piedra y 5 escarabajos de cristal a Andorgos en Ahn\'Qiraj. También debes alcanzar la reputación de amistoso ante el Linaje de Nozdormu para completar esta misión.‡Llévale el aro de Vek\'lor, 2 ídolos del sol, 5 escarabajos de piedra y 5 escarabajos de cristal a Andorgos en Ahn\'Qiraj. También debes alcanzar la reputación de amistoso ante el Linaje de Nozdormu para completar esta misión.‡Ramener le Diadème de Vek\'nilash, 2 Idoles du soleil, 5 Scarabées de pierre et 5 Scarabées de cristal à Andorgos, à Ahn\'Qiraj. Pour terminer cette quête, il faut également que la Progéniture de Nozdormu soit au moins Amicale à votre égard.‡把维克尼拉斯的头饰、2个太阳塑像、5个岩石甲虫和5个水晶甲虫交给安其拉的安多葛斯。你必须首先在诺兹多姆的子嗣中达到友善声望才可以完成这个任务。‡將維克尼拉斯的頭環、2個太陽塑像、5隻石甲蟲和5隻水晶甲蟲帶給安其拉的安多葛斯。你還必須在諾茲多姆的子嗣達到友好聲望值才能完成此任務。',
  }
},
[8562] = {
  {
    'Peitoral do Conquistador‡Кираса Завоевателя‡Brustplatte des Eroberers‡정복자의 흉갑‡La coraza de conquistador‡La coraza de conquistador‡La cuirasse de conquérant‡征服者的胸甲‡征服者的胸甲',
    nil,
    'Leve a Carapaça do Deus Antigo, 2 Ídolos de Guerra, 5 Escaravelhos de Prata e 5 Escaravelhos de Osso para Vethsera em Ahn\'Qiraj. Também é necessário ser <Honrado/Honrada> pela Prole de Nozdormu para concluir a missão.‡Принесите панцирь Древнего Бога, 2 идола Войны, 5 серебряных и 5 костяных скарабеев Ветсере в Ан\'Кираж. Кроме того, необходимо заслужить как минимум уважительное отношение рода Ноздорму.‡Bringt den Knochenpanzer des alten Gottes, 2 Götzen des Krieges, 5 Silberskarabäen und 5 Knochenskarabäen zu Vethsera innerhalb von Ahn\'Qiraj. Diese Aufgabe erfordert zum Abschluss auch einen wohlwollenden Ruf bei der Brut Nozdormus.‡안퀴라즈 안에 있는 베스세라에게 고대신의 껍질, 전쟁의 우상 2개, 은 스카라베 5개, 뼈 스카라베 5개를 가져가야 합니다. 이 퀘스트를 완료하려면 노즈도르무 혈족에게 우호적 평판을 얻어야 합니다.‡Llévale el caparazón del dios antiguo, 2 ídolos de la guerra, 5 escarabajos de plata y 5 escarabajos de hueso a Vethsera en Ahn\'Qiraj. También debes alcanzar la reputación de honorable ante el Linaje de Nozdormu para completar esta misión.‡Llévale el caparazón del dios antiguo, 2 ídolos de la guerra, 5 escarabajos de plata y 5 escarabajos de hueso a Vethsera en Ahn\'Qiraj. También debes alcanzar la reputación de honorable ante el Linaje de Nozdormu para completar esta misión.‡Ramener la Carapace du Dieu très ancien, 2 Idoles de la guerre, 5 Scarabées d\'argent et 5 Scarabées d\'os à Vethsera, à l\'intérieur d\'Ahn\'Qiraj. Pour terminer cette quête, vous devez être <Honoré/Honorée> par la Progéniture de Nozdormu.‡把上古之神的外鞘、2个战争塑像、5个银质甲虫和5个白骨甲虫交给安其拉的温瑟拉。你必须在诺兹多姆的子嗣中达到尊敬声望才能完成这个任务。‡將上古之神的甲殼、2個戰爭塑像、5隻銀色甲蟲和5隻白骨甲蟲帶給安其拉的溫瑟拉。你還必須在諾茲多姆的子嗣達到尊敬聲望值才能完成這個任務。',
  }
},
[8563] = {
  {
    'Treinamento de bruxo‡Обучение чернокнижника‡Ausbildung zum Hexenmeister‡흑마법사 훈련‡Entrenamiento de brujos‡Entrenamiento de brujos‡La formation de démoniste‡术士训练‡術士訓練',
    nil,
    'Fale com o Evocador Teli\'Larien, o instrutor de Bruxos, na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставником чернокнижников – призывателем Тели\'Лариеном в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Beschwörer Teli\'Larien - dem Hexenmeisterlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 소환사 텔리라리엔과 대화하십시오.‡Habla con el invocador Teli\'Larien, el instructor de brujos, en la Aguja del Sol en la Isla del Caminante del Sol.‡Habla con el invocador Teli\'Larien, el instructor de brujos, en la Aguja del Sol en la Isla del Caminante del Sol.‡Parlez à l\'invocateur Teli\'Larien, le maître des démonistes, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的术士训练师召唤者泰里拉伦谈一谈。‡和術士訓練師 - 召喚者泰利拉談談 - 他就在逐日者之島的日尖塔裡面。',
  }
},
[8564] = {
  {
    'Treinamento de sacerdote‡Обучение жреца‡Ausbildung zum Priester‡사제 훈련‡Entrenamiento de sacerdotes‡Instrucción de sacerdote‡La formation de prêtre‡牧师训练‡牧師訓練',
    nil,
    'Fale com a Máter Arena, a instrutora de sacerdotes, na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставницей жрецов сестрой Ариной в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Matrone Arena - der Priesterlehrerin - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 여사제 아레나와 대화하십시오.‡Habla con la matrona Arena, la instructora de sacerdotes, en la Aguja del Sol en la Isla del Caminante del Sol.‡Habla con la matrona Arena, la instructora de sacerdotes, en la Aguja del Sol en la Isla del Caminante del Sol.‡Parlez à la matrone Arène, le maître des prêtres, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的牧师训练师护士长阿蕾娜谈一谈。‡和牧師訓練師 - 梅特倫·艾瑞那談談 - 她就在逐日者之島的日尖塔裡面。',
  }
},
