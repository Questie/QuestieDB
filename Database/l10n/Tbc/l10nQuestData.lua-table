[11874] = {
  {
    'Upper Deck Promocional - Foguete de Montaria‡Upper Deck Promo – Верховая ракета‡Upper Deck Promo - Reitrakete‡카드매니아 - 로켓 탈것‡Upper Deck Promo - Rocket Mount‡‡Promo Upper Deck - Monture fusée‡Upper Deck Promo - Rocket Mount‡',
