[10733] = {
  {
    'Seguindo a trilha violeta‡Путь Аметистового Ока‡Der violette Pfad‡보랏빛 마술사의 맹세‡Por el camino Violeta‡Por el camino Violeta‡Sur la voie pourpre‡紫罗兰之路‡',
    nil,
    'Leve seu Sinete Violeta para a Arquimaga Leryda, na Trilha do Vento Morto, após obter a reputação "<Honrado/Honrada>" com o Olho Violeta.‡Принесите свой перстень Аметистового Ока верховному магу Лериде на Перевал Мертвого Ветра. Кроме того, необходимо заслужить как минимум уважительное отношение Аметистового Ока.‡Bringt Euren violetten Siegelring zu Erzmagierin Leryda in Gebirgspass der Totenwinde, nachdem Ihr einen wohlwollenden Ruf bei dem Violetten Auge erlangt habt.‡보랏빛 눈의 감시자에 대한 평판이 우호적이 된 후에 저승바람 고개에 있는 대마법사 레리다에게 보랏빛 인장을 가져가야 합니다.‡Entrega tu sello Violeta a la archimaga Leryda en el Paso de la Muerte tras obtener reputación honorable con El Ojo Violeta.‡Entrega tu sello Violeta a la archimaga Leryda en el Paso de la Muerte tras obtener reputación honorable con El Ojo Violeta.‡Apportez votre Chevalière pourpre à l’archimage Leryda au défilé de Deuillevent après être <devenu Honoré/devenue Honorée> auprès de l’Œil pourpre.‡当你在紫罗兰之眼的声望达到尊敬后，将紫罗兰徽记交给逆风小径的大法师蕾尔达。‡',
  }
},
[10734] = {
  {
    'Seguindo a trilha violeta‡Путь Аметистового Ока‡Der violette Pfad‡보랏빛 복원가의 맹세‡Por el camino Violeta‡Por el camino Violeta‡Sur la voie pourpre‡紫罗兰之路‡',
    nil,
    'Leve seu Sinete Violeta para a Arquimaga Leryda, na Trilha do Vento Morto, após obter a reputação "<Honrado/Honrada>" com o Olho Violeta.‡Принесите свой перстень Аметистового Ока верховному магу Лериде на Перевал Мертвого Ветра. Кроме того, необходимо заслужить как минимум уважительное отношение Аметистового Ока.‡Bringt Euren violetten Siegelring zu Erzmagierin Leryda in Gebirgspass der Totenwinde, nachdem Ihr einen wohlwollenden Ruf bei dem Violetten Auge erlangt habt.‡보랏빛 눈의 감시자에 대한 평판이 우호적이 된 후에 저승바람 고개에 있는 대마법사 레리다에게 보랏빛 인장을 가져가야 합니다.‡Entrega tu sello Violeta a la archimaga Leryda en el Paso de la Muerte tras obtener reputación honorable con El Ojo Violeta.‡Entrega tu sello Violeta a la archimaga Leryda en el Paso de la Muerte tras obtener reputación honorable con El Ojo Violeta.‡Apportez votre Chevalière pourpre à l’archimage Leryda au défilé de Deuillevent après être <devenu Honoré/devenue Honorée> auprès de l’Œil pourpre.‡当你在紫罗兰之眼的声望达到尊敬后，将紫罗兰徽记交给逆风小径的大法师蕾尔达。‡',
