[7926] = {
  {
    'A Feira de Negraluna‡Ярмарка Новолуния‡Der Dunkelmond-Jahrmarkt‡다크문 축제‡La Feria de la Luna Negra‡La Feria de la Luna Negra‡La foire de Sombrelune‡暗月马戏团‡暗月馬戲團',
    nil,
    'Entregue o Vale-ingresso para Gelvas Portassuja na Feira de Negraluna.‡Передайте сертификат на призовой купон Гельвасу Угольному Шлюзу в лагерь ярмарки Новолуния.‡Bringt den Gutschein zu Gelvas Rußgatter, der sich innerhalb des Dunkelmond-Jahrmarkts aufhält.‡다크문 축제가 열리고 있는 장소로 가서 겔바스 그림게이트에게 무료 상품 교환권을 제출해야 합니다.‡Entrega el vale a Gelvas Roñas, que estará justo pasada la entrada de la Feria de la Luna Negra.‡Entrega el vale de entrada gratuita a Gelvas Roñoso en la Feria de la Luna Negra.‡Donnez le Coupon pour des bons gratuits à Gelvas Crasseporte, qui se trouve dans la foire de Sombrelune.‡到暗月马戏团的场地里去，将免费券交给吉瓦斯·格里加特。‡將這張免費獎券兌換券交給暗月馬戲團中的吉瓦斯·葛萊蓋特。',
  }
},
[7927] = {
  {
    'Baralho de Portais de Negraluna‡Карты Новолуния:Порталы‡Portalkartenset des Dunkelmond-Jahrmarkts‡다크문 차원문 카드‡La baraja de Portales de la Luna Negra‡La baraja de Portales de la Luna Negra‡Suite de Portails de Sombrelune‡暗月入口套牌‡暗月傳送門套卡',
    nil,
    'Devolva o Baralho de Portais à Feira de Negraluna quando ela voltar à cidade.‡Принесите карты Порталов на ярмарку Новолуния.‡Gebt das Portalkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 차원문 카드 한벌을 돌려줘야 합니다.‡Lleva la baraja de Portales a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Portales a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Portails à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把入口套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把傳傳送門套卡交給他們。',
  }
},
[7928] = {
  {
    'Baralho de Generais de Negraluna‡Карты Новолуния: воины‡Kriegsfürstenkartenset des Dunkelmond-Jahrmarkts‡다크문 대장군 카드‡La baraja de Señores de la Guerra de la Luna Negra‡La baraja de Señores de la Guerra de la Luna Negra‡Suite de Seigneurs de guerre de Sombrelune‡暗月督军套牌‡暗月督軍套卡',
    nil,
    'Devolva o Baralho de Generais à Feira de Negraluna quando ela voltar à cidade.‡Принесите карты воинов на ярмарку Новолуния.‡Gebt das Kriegsfürstenkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 대장군 카드 한벌을 돌려줘야 합니다.‡Lleva la baraja de Señores de la Guerra a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Señores de la Guerra a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Seigneurs de guerre à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把督军套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把督軍套卡交給他們。',
  }
},
[7929] = {
  {
    'Baralho de Elementais de Negraluna‡Карты Новолуния: Элементали‡Elementarkartenset des Dunkelmond-Jahrmarkts‡다크문 정령 카드‡La baraja de Elementales de la Luna Negra‡La baraja de Elementales de la Luna Negra‡Suite d\'Elémentaires de Sombrelune‡暗月元素套牌‡暗月元素套卡',
    nil,
    'Devolva o Baralho de Elementais à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Элементалей на ярмарку Новолуния.‡Gebt das Elementarkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 정령 카드 한벌을 돌려줘야 합니다.‡Lleva la baraja de Elementales a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Elementales a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite d\'Elémentaires à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把元素套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把元素套卡交給他們。',
  }
},
[7930] = {
  {
    '5 Cupons – Flor de Negraluna‡5 купонов – цветок Новолуния‡5 Lose - Dunkelmond-Blume‡상품권 5매 - 다크문 꽃‡5 vales: flor de la Luna Negra‡5 vales: flor de la Luna Negra‡5 bons - Fleur de Sombrelune‡5张奖券 - 暗月花束‡5張獎券 - 暗月小花',
    nil,
    '‡Налетай, торопись, выбирай себе приз! У кого есть купоны на ярмарку Новолуния – подходите и обменяйте их на диковины волшебного свойства и исключительного качества! Ни орк, ни дворф не уйдет без призов!‡Kommt näher, kommt näher! Wenn ihr Lose vom Dunkelmond-Jahrmarkt habt, die ihr einlösen möchtet, dann sagt nur Bescheid! Ihr könnt Lose gegen zahlreiche, wundersame und fantastische Preise einlösen. Scheut euch nicht, probiert es aus!‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7931] = {
  {
    '5 Cupons – Prêmio Menor de Negraluna‡5 купонов – поощрительный приз Новолуния‡5 Lose - Kleiner Dunkelmond-Preis‡상품권 5매 - 다크문 축제 동상‡5 vales: Lote de la Luna Negra inferior‡5 vales: Lote menor de la Luna Negra‡5 bons - Lot de Sombrelune (mineur)‡5张奖券 - 小奖品‡5張獎券 - 三等暗月獎',
    nil,
    '‡Налетай, торопись, выбирай себе приз! У кого есть купоны ярмарки Новолуния – подходите и обменяйте их на диковины волшебного свойства и исключительного качества! Ни орк, ни дворф не уйдет без призов!‡Kommt näher, kommt näher! Wenn ihr Lose vom Dunkelmond-Jahrmarkt habt, die ihr einlösen möchtet, dann sagt nur Bescheid! Ihr könnt Lose gegen zahlreiche, wundersame und fantastische Preise einlösen. Scheut euch nicht, probiert es aus!‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7932] = {
  {
    '12 Cupons – Prêmio Inferior de Negraluna‡12 купонов – малый приз Новолуния‡12 Lose - Geringer Dunkelmond-Preis‡상품권 12매 - 다크문 축제 은상‡12 vales: lote inferior de la Luna Negra‡12 vales: lote inferior de la Luna Negra‡12 bons - Lot de Sombrelune (inférieur)‡12张奖券 - 普通奖品‡12張獎券 - 二等暗月獎',
    nil,
    '‡‡Kommt näher, kommt näher! Wenn ihr Lose vom Dunkelmond-Jahrmarkt habt, die ihr einlösen möchtet, dann sagt nur Bescheid! Ihr könnt Lose gegen zahlreiche, wundersame und fantastische Preise einlösen. Scheut euch nicht, probiert es aus!‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7933] = {
  {
    '40 Cupons – Prêmio Maior de Negraluna‡40 купонов – большой приз Новолуния‡40 Lose - Großer Dunkelmond-Preis‡상품권 40매 - 다크문 축제 금상‡40 vales: lote superior de Luna Negra‡40 vales: lote superior de la Luna Negra‡40 bons - Lot de Sombrelune (supérieur)‡40张奖券 - 高级奖品‡40張獎券 - 一等暗月獎',
    nil,
    '‡Налетай, торопись, выбирай себе приз! У кого есть купоны ярмарки Новолуния – подходите и обменяйте их на диковины волшебного свойства и исключительного качества! Ни орк, ни дворф не уйдет без призов!‡Kommt näher, kommt näher! Wenn ihr Lose vom Dunkelmond-Jahrmarkt habt, die ihr einlösen möchtet, dann sagt nur Bescheid! Ihr könnt Lose gegen zahlreiche, wundersame und fantastische Preise einlösen. Scheut euch nicht, probiert es aus!‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7934] = {
  {
    '50 Cupons – Caixote de Guardados de Negraluna‡50 купонов – ящик Новолуния‡50 Lose - Dunkelmond-Lagerbehälter‡상품권 50매 - 다크문 보관함‡50 vales: caja de almacenamiento de la Luna Negra‡50 vales: caja de almacenamiento de la Luna Negra‡50 bons - Boîte de rangement de Sombrelune‡50张奖券 - 暗月储物箱‡50張獎券 - 暗月收藏箱',
    nil,
    '‡‡‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7935] = {
  {
    '10 Cupons – Pernil de Carneiro do Mês Passado‡10 купонов – прошлогодний окорок‡10 Lose - Hammel des letzten Monats‡상품권 10매 - 한 달 묵은 양고기‡10 vales: añojo del mes pasado‡10 vales: añojo del mes pasado‡10 bons - Mouton du mois dernier‡10张奖券 - 上个月的羊肉‡10張獎券 - 上個月的羊肉',
    nil,
    '‡‡‡‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance !‡‡',
  }
},
[7936] = {
  {
    '50 Cupons – Pernil de Carneiro do Ano Passado‡50 билетов – прошлогодний окорок‡50 Lose - Hammel des letzten Jahres‡상품권 50매 - 일년 묵은 양고기‡50 vales: añojo del año pasado‡50 vales: añojo del año pasado‡50 bons - Mouton de l\'an dernier‡50张奖券 - 去年的羊肉‡50張獎券 - 去年的羊肉',
    nil,
    nil,
  }
},
[7937] = {
  {
    'Sua sorte o aguarda...‡Ты найдешь свою удачу...‡Euer Schicksal erwartet Euch...‡당신을 기다리는 행운...‡La Fortuna te espera...‡La Fortuna te espera...‡Une surprise vous attend...‡财富在等着你......‡財富等著你……',
    nil,
    'Vá para a Madeireira Vale do Leste, na Floresta de Elwynn, e procure sua sorte.‡Отыщите свою удачу на Лесопилке Восточной долины в Элвиннском лесу.‡Reist zum Holzfällerlager des Osttals im Wald von Elwynn und sucht nach Eurem Schicksal.‡엘윈 숲의 동부 벌목지로 가서 당신의 행운을 찾아야 합니다.‡Ve al Aserradero de la Vega del Este del Bosque de Elwynn y busca tu fortuna.‡Ve al Aserradero de la Vega del Este del Bosque de Elwynn y busca tu fortuna.‡Allez dans le Camp de bûcherons du Val d\'est dans la Forêt d\'Elwynn pour trouver la surprise qui vous attend.‡到艾尔文森林的东谷伐木场去寻找你的财宝吧。‡到艾爾文森林的東谷伐木場去尋找你的財寶吧。',
  }
},
[7938] = {
  {
    'Sua sorte o aguarda...‡Ты найдешь свою удачу...‡Euer Schicksal erwartet Euch...‡당신을 기다리는 행운...‡La Fortuna te espera...‡La Fortuna te espera...‡Une surprise vous attend...‡财富在等着你......‡財富等著你……',
    nil,
    'Siga para as Minas Mortas, em Cerro Oeste, e procure sua sorte.‡Отыскать свою удачу в Мертвых копях в Западном Крае.‡Reist zu den Todesminen in Westfall und sucht nach Eurem Schicksal.‡서부 몰락지대의 죽음의 폐광으로 가서 당신의 행운을 찾아야 합니다.‡Ve a Las Minas de la Muerte de los Páramos de Poniente y busca tu fortuna.‡Ve a Las Minas de la Muerte de los Páramos de Poniente y busca tu fortuna.‡Allez dans les Mortemines dans la marche de l\'Ouest pour trouver la surprise qui vous attend.‡到西部荒野的死亡矿井中去寻找你的财宝吧。‡到西部荒野的死亡礦坑中去尋找你的財寶吧。',
  }
},
[7939] = {
  {
    'Mais pedras densas de amolar‡Обмен: массивные шлифовальные камни‡Mehr verdichtete Schleifsteine‡더 많은 강도 높은 연마석‡Más piedras de pulir densas‡Más piedras de pulir densas‡Plus de silex à aiguiser denses‡更多致密砂轮‡',
    nil,
    '‡‡<Name>, ich danke Euch für all Eure Hilfe. Ich kann Euch wirklich nicht genug danken!nnIch brauche jetzt zwar nichts mehr wirklich... aber solltet Ihr mir mehr verdichtete Schleifsteine bringen, so habe ich auch noch einige Lose des Dunkelmond-Jahrmarkts für Euch.‡‡‡‡<nom>, je vous remercie de toute l’aide que vous m’avez apporté. Sincèrement, je ne vous remercierai jamais assez.nnEt même si j’en ai moins besoin maintenant, si vous me fournissez d’autres pierres à aiguiser denses, il se pourrait que je vous donne d’autres bons de la foire de Sombrelune.‡‡',
  }
},
[7940] = {
  {
    '1200 Cupons – Orbe de Negraluna‡1200 билетов – сфера Новолуния‡1200 Lose - Kugel des Dunkelmonds‡상품권 1200매 - 다크문의 보주‡1200 vales: orbe de la Luna Negra‡1200 vales: orbe de la Luna Negra‡1200 bons - Orbe de Sombrelune‡1200张奖券 - 暗月宝珠‡1200張獎券 - 暗月寶珠',
    nil,
    '‡Налетай, торопись, выбирай себе приз! У кого есть купоны ярмарки Новолуния – подходите и обменяйте их на диковины волшебного свойства и исключительного качества! Ни орк, ни дворф не уйдет без призов!‡Kommt näher, kommt näher! Wenn ihr Lose vom Dunkelmond-Jahrmarkt habt, die ihr einlösen möchtet, dann sagt nur Bescheid! Ihr könnt Lose gegen zahlreiche, wundersame und fantastische Preise einlösen. Scheut euch nicht, probiert es aus!‡어서 올라오게, 어서! 혹시 다크문 축제 상품권을 상품으로 바꾸고 싶다면 말만 하게! 상품권을 여러 종류의 멋진 상품과 교환할 수 있다고. 자, 주저하지 말고 한번 해 보게!‡‡‡Avancez, avancez ! Si vous avez des bons de la foire de Sombrelune à échanger, il suffit de le dire ! Vous pouvez échanger vos bons contre différents lots plus merveilleux et fantastiques les uns que les autres. Ne soyez pas timide, venez tenter votre chance ! !‡‡',
  }
},
[7941] = {
  {
    'Mais kits de armadura‡Обмен: комплекты грубой брони‡Mehr Rüstungssets‡더 많은 방어구 키트‡Más refuerzos para armadura‡Más refuerzos para armadura‡Plus de renforts d\'armure‡更多护甲片‡',
    nil,
    '‡Великийгром, я так тебе благодарен! Теперь твоими стараниями у меня припасов больше, чем нужно! Но если у тебя еще завалялись комплекты грубой брони – приноси, а я уж найду им применение. За комплекты брони я расплачусь купонами ярмарки Новолуния.‡<Name>, ich muss mich für all Eure Hilfe bedanken. Ich verfüge jetzt über eine Menge an Vorräten, dank Eurer Bemühungen, aber wenn Ihr mir noch mehr Rüstungssets bringen möchtet, dann werde ich sie gerne gegen ein paar Lose des Dunkelmond-Jahrmarkts eintauschen.‡‡‡‡‡‡',
  }
},
[7942] = {
  {
    'Mais trecos de tório‡Обмен: ториевые устройства‡Mehr Thoriumapparate‡더 많은 토륨 부품‡Más trastos de torio‡Más trastos de torio‡Plus de rouages en thorium‡更多瑟银零件‡',
    nil,
    '‡Колг, ты столько для меня сделал! Я бесконечно тебе благодарен.nnТориевых устройств мне теперь хватит надолго, но если у тебя завалялась еще парочка-другая – приноси. Я дам тебе за них купоны ярмарки.‡<Name>, Ihr wart so gut zu uns, indem Ihr uns ohne Unterlass Waren beschafft habt. Ich bin Euch dafür unendlich dankbar!nnAuch wenn wir einen nicht mehr so großen Bedarf an Thoriumapparaten wie zuvor haben, so könnt Ihr mir doch jederzeit weitere bringen. Ich tausche sie dann gegen Lose des Dunkelmond-Jahrmarkts ein.‡그동안 불만 없이 계속 요구한 물건을 가져다줘서 정말 고맙네. 이 은혜는 영원히 잊지 않겠네!nn이제 토륨 부품이 예전만큼 절실히 필요한 것은 아니지만 그래도 계속 가져다 주면 다크문 축제 상품권으로 기꺼이 교환해 주도록 하지.‡‡‡<nom>, vous m’avez bien rendu service en m’amenant tout cela sans jamais vous lasser. Vous avez toute ma gratitude.nnNous avons moins besoin de rouages en thorium qu’à une certaine époque, mais si vous m’en amenez d’autres, je vous les échangerai contre des bons de la foire de Sombrelune.‡‡',
  }
},
[7943] = {
  {
    'Mais olhos de morcegos‡Обмен: глаза летучих мышей‡Mehr Fledermausaugen‡더 많은 박쥐 눈‡Más ojos de murciélago vil‡Más ojos de murciélago vil‡Plus d’yeux de chauve-souris‡更多蝙蝠眼‡',
    nil,
    '‡Пластырь, мой новый аттракцион будет пострашнее гномреганской катастрофы! И я не забуду о твоем вкладе в этот проект! Спасибо тебе еще раз!nnЭтих запасов мне хватит надолго, но если ты раздобудешь глаза злобных летучих мышей из Восточных Чумных земель, я с удовольствием обменяю их на купоны ярмарки Новолуния!‡‡‡‡‡<nom>, l’attraction que je suis en train de créer sera la chose la plus effrayante qu’on ait vue depuis la chute de Gnomeregan ! Et c’est largement grâce à tout ce que vous m’avez apporté. Merci, merci mille fois !nnJe n’ai plus besoin de grand-chose mais… si vous m’apportez encore des yeux de chauve-souris maléfiques pris sur les chauve-souris des Maleterres de l’est… je pourrais avoir d’autres bons de la foire de Sombrelune pour vous.‡‡',
  }
},
[7944] = {
  {
    'Sua sorte o aguarda...‡Ты найдешь свою удачу...‡Euer Schicksal erwartet Euch...‡당신을 기다리는 행운...‡La Fortuna te espera...‡La Fortuna te espera...‡Une surprise vous attend...‡财富在等着你......‡財富等著你……',
    nil,
    'Siga para a Caverna Ululante, nos Sertões e procure sua sorte.‡Отыскать свою удачу в Пещерах Стенаний в Степях.‡Reist zu den Höhlen des Wehklagens im Brachland und sucht nach Eurem Schicksal.‡불모의 땅에 있는 통곡의 동굴로 가서 당신의 행운을 찾아야 합니다.‡Ve a las Cuevas de los Lamentos de Los Baldíos y busca tu fortuna.‡Ve a las Cuevas de los Lamentos de Los Baldíos y busca tu fortuna.‡Allez dans les Cavernes des lamentations dans les Tarides pour trouver la surprise qui vous attend.‡到贫瘠之地的哀嚎洞穴中去寻找你的财宝吧。‡到貧瘠之地的哀嚎洞穴中去尋找你的財寶吧。',
  }
},
[7945] = {
  {
    'Sua sorte o aguarda...‡Ты найдешь свою удачу...‡Euer Schicksal erwartet Euch...‡당신을 기다리는 행운...‡La Fortuna te espera...‡La Fortuna te espera...‡Une surprise vous attend...‡财富在等着你......‡財富等著你……',
    nil,
    'Viaje ao Rochedo Jubalba, em Mulgore, e procure sua sorte.‡Отыскать свою удачу возле утеса Бледногривов в Мулгоре.‡Reist zum Bleichmähnenfels in Mulgore und sucht nach Eurem Schicksal.‡멀고어의 잿빛 동굴로 가서 당신의 행운을 찾아야 합니다.‡Ve a la Roca Crines Pálidas de Mulgore y busca tu fortuna.‡Ve a la Roca Crines Pálidas de Mulgore y busca tu fortuna.‡Allez au Rocher des crins-pâles pour trouver la surprise qui vous attend.‡到莫高雷的灰月洞穴去寻找你的财宝吧。‡到莫高雷的白鬃石去尋找你的財寶吧。',
  }
},
[7946] = {
  {
    'Filhote da Jujuba‡Потомство Жабжаб‡Jubjubs Nachwuchs‡줍줍의 알‡Huevo de Jubjub‡Huevo de Jubjub‡Le rejeton de Jubjub‡加布加布‡啾啾的蛋',
    nil,
    '‡‡Ich bin so froh, dass Jubjub wieder da ist. Die Kleine liebt Dunkeleisenbier so sehr, dass sie, als mein Vorrat zuneige ging, weggerannt ist, um mehr davon zu suchen.nnJetzt, da Jubjub zurück ist, versuche ich, soviel Bier wie möglich zu kriegen! Ich möchte nicht, dass sie wieder wegläuft, wisst Ihr?nnHabt Ihr vielleicht etwas Dunkeleisenbier dabei? Wenn ja, gebe ich Euch eines von Jubjubs Froscheiern für einen Krug Dunkeleisenbier...‡줍줍이 돌아와서 다행스러워. 검은무쇠단 에일 맥주를 얼마나 좋아하는지 맥주가 다 떨어지니까 찾으러 훌쩍 떠나버렸지 뭐야!nn이제 줍줍이 돌아왔으니 가능한 한 맥주를 잔뜩 모아 둬야겠어! 줍줍이 또 도망가서는 안 될 일이니!nn혹시 검은무쇠단 에일 맥주 갖고 있는 거 없나? 갖고 있으면 한잔 당 줍줍의 개구리 알 한 개를 주기로 하지...‡‡‡Je suis si content que Jubjub ait été retrouvée. Elle aime tellement la bière Sombrefer que lorsque je n’en ai plus… elle s’enfuit pour en chercher !nnMaintenant que Jubjub est revenue, je veux stocker toute la bière que je peux trouver ! Je ne veux pas que Jubjub s’enfuie à nouveau !nnVous avez de la bière Sombrefer ? Si c’est le cas, je vous l’échange l’un des œufs de ma grenouille Jubjub contre une chope.‡‡',
  }
},
[7961] = {
  {
    'Waskily Wabbits!‡Коварные кролики!‡Es ist Hasensaison!‡지긋지긋한 토끼 떼!‡¡Condenados conejos!‡¡Estos conejos no paran!‡Gredins de lapins !‡Waskily Wabbits!‡狡猾的兔子!',
    nil,
    'Collect 10 Unlucky Wabbit Feet from the Waskily Wabbits.‡Убейте 5 кроликов и вернитесь к Джону Лекрафту на остров Дизайнера.‡Tötet 5 Hasen und kehrt zu Jon LeCraft an der Schmiede auf der Designer-Insel zurück.‡5마리의 토끼를 처치한 후, 디자이너의 섬에 모루 옆에 있는 존 리크래프트에게 돌아가야 합니다.‡Mata 5 conejos y vuelve a ver a Jon L\'Artesano, que está junto a la forja en la Isla del Diseñador.‡‡Tuer 5 lapins et revenir voir Jon LeCraft près de la forge sur l\'Ile des concepteurs.‡Kill 5 rabbits and return to Jon LeCraft by the forge on Designer Island.‡殺死5隻兔子，然後向設計者之島的喬恩·勒克夫特覆命。',
  }
},
[7962] = {
  {
    '‡‡‡‡‡‡‡‡兔皮',
    nil,
    '‡‡‡‡‡‡‡‡帶3張狡猾的兔子的皮給喬恩·勒克夫特。',
  }
},
[7981] = {
  {
    '1200 Cupons – Amuleto de Negraluna‡1200 билетов – амулет Новолуния‡1200 Lose - Amulett des Dunkelmonds‡상품권 1200 매 - 다크문의 아뮬렛‡1200 vales: amuleto de la Luna Negra‡1200 vales: amuleto de la Luna Negra‡1200 bons - Amulette de la Sombrelune‡1200张奖券 - 暗月护符‡1200張獎券 - 暗月護符',
    nil,
    '‡Налетай, торопись, выбирай себе приз! У кого есть купоны ярмарки Новолуния – подходите и обменяйте их на диковины волшебного свойства и исключительного качества! Ни орк, ни дворф не уйдет без призов!‡‡‡‡‡‡‡',
  }
},
