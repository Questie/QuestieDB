[353] = {
  {
    'Entrega para Lançatroz‡Посылка для Грозовой Вершины‡Sturmlanzes Lieferung‡스톰파이크에게 소포 배달‡Una entrega a Pico Tormenta‡Una entrega a Pico Tormenta‡Livraison pour Foudrepique‡雷矛的包裹‡雷矛的包裹',
    nil,
    'Entregue o Pacote para Lançatroz para o Montanhista Lançatroz em Loch Modan.‡Доставьте посылку горному пехотинцу Грозовой Вершине в Лок Модан.‡Bringt das Päckchen für Sturmlanze zu Gebirgsjäger Sturmlanze am Loch Modan.‡모단 호수에 있는 산악경비대 스톰파이크에게 스톰파이크의 소포를 배달해야 합니다.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Entrega el paquete Pico Tormenta al montaraz Pico Tormenta en Loch Modan.‡Livrer le Paquet au montagnard Foudrepique au Loch Modan.‡把给卡尔·雷矛的包裹交给洛克莫丹北部哨塔里的巡山人卡尔·雷矛。‡把給雷矛的包裹交給洛克莫丹北部哨塔里的巡山人雷矛。',
  }
},
[354] = {
  {
    'Mortes na família‡Смерти в семье‡Todesfälle in der Familie‡가문의 몰살‡Muertes en la familia‡Muertes en la familia‡Morts dans la Famille‡阿加曼德家族‡阿加曼德家族',
    nil,
    'Obtenha os Restos Mortais de Gregor, os Restos Mortais de Nissa, os Restos Mortais de Timóteo para Eurico Palhares em Montalvo.‡Принесите останки Грегора, останки Ниссы и останки Турмана Колману Фартингу в Брилл.‡Bringt Coleman Heller in Brill die sterblichen Überreste von Gregor, Nissa und Thurman.‡브릴에 있는 콜만 파딩에게 그레고르의 유골, 니사의 유해, 투르만의 유골을 가져가야 합니다.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Lontananza, que está en Rémol.‡Llévale los restos de Gregor, los restos de Nissa y los restos de Thurman a Coleman Farthing, que está en Rémol.‡Rapporter les cadavres de Gregor, de Nissa et de Thurman à Coleman Farthing, à Brill.‡把格里高的遗骸、妮萨的残骸和萨尔曼的遗骸交给布瑞尔的库勒曼·法席恩。‡把格里高的遺骸、妮薩的殘骸和薩爾曼的遺骸交給布瑞爾的庫勒曼·法席恩。',
  }
},
[355] = {
  {
    'Fale com Sevren‡Разговор с Севреном‡Gespräch mit Sevren‡세브렌과의 대화‡Habla con Sevren‡Habla con Sevren‡Parler à Sevren‡与塞弗伦交谈‡',
    nil,
    'Fale com o Magistrado Sevren em Montalvo.‡Поговорите с мировым судьей Севреном в Брилле.‡Sprecht mit Magistrat Sevren in Brill.‡브릴에 있는 집정관 세브렌과 대화해야 합니다.‡Habla con el magistrado Sevren de Rémol.‡Habla con el magistrado Sevren de Rémol.‡Parler au magistrat Sevren à Brill.‡与布瑞尔的执政官塞弗伦谈一谈。‡',
  }
},
[356] = {
  {
    'Patrulha da retaguarda‡Патруль в арьергарде‡Patrouille zur Rückendeckung‡후방 경비‡Patrulla de la retaguardia‡Patrulla de la retaguardia‡Patrouille d\'arrière-garde‡巡查后方‡巡查後方',
    nil,
    'Mate 8 Horrores Sangrentos e 8 Espíritos Errantes. Depois, apresente seu relatório a Linnea no acampamento.‡Убейте 8 кровоточащих ужасов и 8 странствующих духов, а потом доложите о своих успехах Линнее в ее лагере.‡Tötet 8 blutende Schrecken und 8 wandernde Geister und meldet Euch dann wieder bei Linnea in ihrem Lager.‡피투성이 좀비 8명과 떠도는 영혼 8명을 처치한 다음 초소로 돌아가 리니아에게 보고해야 합니다.‡Mata a 8 horrores sangrantes y a 8 espíritus deambulantes, y ve a informar a Linnea a su campamento.‡Mata a 8 horrores sangrantes y a 8 espíritus deambulantes.‡Tuer 8 Horreurs sanguinolentes et 8 Esprits vagabonds, puis revenez voir Linnea, à son camp.‡杀死8个可怕的血僵尸和8个游荡的幽灵，然后向亡灵卫兵林奈汇报。‡殺死8個可怕的血殭屍和8個遊蕩的幽靈，然後向亡靈衛兵林奈彙報。',
  }
},
[357] = {
  {
    'A identidade do lich‡Личность лича‡Die Identität des Lichs‡마술사의 정체‡La identidad del exánime‡La identidad del exánime‡Le Nom de la Liche‡巫妖的身份‡巫妖的身份',
    nil,
    'Leve o Grimório do Lich para Boanerges Stalactus na Cidade Baixa.‡Принесите книгу лича Бетору Ледострелу в Подгород.‡Bringt das Zauberbuch des Lichs zu Bethor Eismacht in Unterstadt.‡언더시티에 있는 베소르 아이스샤드에게 마술사의 마법책을 가져가야 합니다.‡Llévale el libro de hechizos del exánime a Bethor Duroyelo, que está en Entrañas.‡Llévale el libro de hechizos del exánime a Bethor Duroyelo en Entrañas.‡Rapporter le livre de sorts de la Liche et le donner à Bethor Glacéclat à Fossoyeuse.‡把巫妖的法术书带给幽暗城的比索·埃斯沙德。‡把巫妖的法術書帶給幽暗城的比索·埃斯沙德。',
  }
},
[358] = {
  {
    'Roubacovas‡Грабители могил‡Grabräuber‡묘지 도굴꾼‡Profanadores‡Profanadores‡Les Profanateurs‡盗墓贼‡盜墓賊',
    nil,
    'Mate Roubacovas Putricouro e Mestiços Putricouro.nnLeve 8 frascos de Linfa Embalsamadora para o Magistrado Sevren, em Montalvo.‡Убивайте грабителей могил и полукровок из стаи Гнилошкуров.nnПринесите мировому судье Севрену 8 образцов бальзамирующей лимфы.‡Tötet Grabräuber der Moderfelle und Bastarde der Moderfelle. nnBringt Magistrat Sevren in Brill 8 Einbalsamierungssekrete.‡썩은가죽일족 도굴꾼 8마리와 썩은가죽일족 싸움꾼 5마리를 처치해야 합니다.nn이들에게서 불변의 영액 8개를 모은 후 브릴에 있는 집정관 세브렌에게 가져가야 합니다.‡Mata a los asaltatumbas Putrepellejo y a los bastardos Putrepellejo. nnLlévale 8 icores embalsamantes al magistrado Sevren de Rémol.‡Mata a los asaltatumbas Putrepellejo y a los bastardos Putrepellejo.|nLlévale 8 icores embalsamantes al magistrado Sevren de Rémol.‡Tuer des Profanateurs Poils-putrides et des Bâtards Poils-putrides.nnRapporter les Ichors d\'embaumement au magistrat Sevren à Brill.‡杀死腐皮盗墓贼和混血腐皮豺狼人。nn给布瑞尔的执政官塞弗伦带回8瓶防腐剂。‡殺死腐皮盜墓賊和混血腐皮豺狼人。|n給布瑞爾的執政官塞弗倫帶回8瓶防腐劑。',
  }
},
[359] = {
  {
    'Deveres Renegados‡Обязанности Отрекшихся‡Verlassenen-Pflichten‡포세이큰의 의무‡Las obligaciones de los Renegados‡Las obligaciones de los Renegados‡Mission des Réprouvés‡亡灵卫兵的职责‡亡靈衛兵的職責',
    nil,
    'Fale com a Necroguarda Lina.‡Поговорите со стражем смерти Линнеей.‡Sprecht mit Todeswache Linnea.‡죽음의경비병 리니아와 대화해야 합니다.‡Habla con la guardia de la muerte Linnea.‡Habla con la guardia de la muerte Linnea.‡Parler à la Nécrogarde Linnea.‡与亡灵卫兵林奈谈一谈。‡與亡靈衛兵林奈談話。',
  }
},
[360] = {
  {
    'De volta ao Magistrado‡Возвращение к чиновнику‡Rückkehr zum Magistrat‡집정관에게 돌아가기‡Vuelve con el magistrado‡Regresa junto al magistrado‡Retourner voir le Magistrat‡向塞弗伦回报‡向塞弗倫回報',
    nil,
    'Fale novamente com o Magistrado Sevren em Montalvo.‡Вернитесь к мировому судье Севрену в Брилл.‡Kehrt zu Magistrat Sevren nach Brill zurück.‡브릴에 있는 집정관 세브렌에게 돌아가야 합니다.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Ve a ver de nuevo al magistrado Sevren de Rémol.‡Retourner voir le Magistrat Sevren à Brill.‡向布瑞尔的执政官塞弗伦报告。‡向布瑞爾的執政官塞弗倫報告。',
  }
},
[361] = {
  {
    'A carta que nunca chegou‡Недоставленное письмо‡Ein nie zugestellter Brief‡배달되지 않은 편지‡Una carta sin entregar‡Una carta sin entregar‡Une lettre perdue‡未寄出的信件‡未寄出的信件',
    nil,
    'Encontre Ivete Palhares e entregue a carta de Timóteo Agamand.‡Найдите Иветту Фартинг и вручите ей письмо от Турмана Агамонда.‡Findet Yvette Heller und bringt Ihr den Brief von Thurman Agamand.‡이베트 파딩을 찾아서 투르만 아가만드가 쓴 편지를 전해줘야 합니다.‡Encuentra a Yvette Lontananza y entrégale la carta de Thurman Agamand.‡Encuentra a Yvette Farthing y entrégale la carta de Thurman Agamand.‡Trouver Yvette Farthing. Lui donner la lettre de Thurman Agamand.‡找到伊维特·法席恩，将萨尔曼·阿加曼德的信交给她。‡找到伊維特·法席恩，將薩爾曼·阿加曼德的信交給她。',
  }
},
[362] = {
  {
    'Os moinhos assombrados‡Мельницы с привидениями‡Die Spukmühle‡밀농장의 유령‡Los molinos fantasma‡Los molinos fantasma‡Les moulins hantés‡闹鬼的磨坊‡鬧鬼的磨坊',
    nil,
    'Mate Delmiro Agamand e leve os Restos Mortais de Delmiro para Eurico Palhares em Montalvo.‡Убейте Девлина Агамонда и принесите его останки Колману Фартингу в Брилл.‡Tötet Devlin Agamand und bringt Devlins sterbliche Überreste zu Coleman Heller nach Brill.‡데블린을 처치한 후 그 유골을 브릴에 있는 콜만 파딩에게 가져가야 합니다.‡Acaba con Devlin Agamand y llévale los restos de Devlin a Coleman Lontananza, que está en Rémol.‡Acaba con Devlin Agamand y llévale los restos de Devlin a Coleman Farthing en Rémol.‡Tuer Devlin Agamand et rapporter son cadavre à Coleman Farthing à Brill.‡杀死代弗林·阿加曼德，然后将代弗林的遗骸交给布瑞尔的库勒曼·法席恩。‡殺死代弗林·阿加曼德，然後將代弗林的遺骸交給布瑞爾的庫勒曼·法席恩。',
  }
},
[363] = {
  {
    'Despertar bruto‡Резкое пробуждение‡Unsanftes Erwachen‡각성의 시간‡Desvelo brutal‡Desvelo brutal‡Réveil brutal‡突然醒来‡',
    nil,
    'Fale com o Sacerdote Sombrio Sarvis.‡Поговорите с жрецом Тьмы Сарвисом.‡Sprecht mit Schattenpriester Sarvis.‡어둠의사제 사비스와 대화해야 합니다.‡Habla con el sacerdote de las Sombras Sarvis.‡Habla con el sacerdote de las Sombras Sarvis.‡Parler au Prêtre des ombres Sarvis.‡和暗影牧师萨维斯谈一谈。‡',
  }
},
[364] = {
  {
    'Os desmiolados‡Безмозглые твари‡Die Hirnlosen‡넋 나간 좀비‡Los autómatas‡Los autómatas‡Les Déchus‡无脑的僵尸‡無腦的殭屍',
    nil,
    'O Sacerdote Sombrio Sarvis quer que você mate 8 Zumbis Desmiolados e 8 Zumbis Atormentados.‡Жрец Тьмы Сарвис хочет, чтобы вы убили 8 безмозглых зомби и 8 презренных зомби.‡Schattenpriester Sarvis will, dass Ihr 8 hirnlose Zombies und 8 elende Zombies tötet.‡어둠의사제 사비스가 넋 나간 좀비 8명과 흉측한 좀비 8명을 처치해 달라고 부탁했습니다.‡El sacerdote de las Sombras Sarvis quiere que mates a 8 zombis descerebrados y a 8 zombis desdichados.‡Mata a 5 zombis descerebrados y a 5 necrófagos desdichados.‡Le Prêtre des ombres Sarvis veut que vous tuiez 8 Zombies décérébrés et 8 Zombies décharnés.‡暗影牧师萨维斯让你杀掉8个无脑的僵尸和8个丑陋的僵尸。‡暗影牧師薩維斯讓你殺掉8個無腦的殭屍和8個醜陋的殭屍。',
  }
},
[365] = {
  {
    'Campos de mágoa‡Поля горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les champs du Chagrin‡悲伤之地‡悲傷之地',
    nil,
    'Roube 10 abóboras da fazenda a oeste, que fica ao norte de Plangemortis, e leve-as para o Boticário Joaquino em Montalvo.‡Украдите 10 тыкв с западной фермы, к северу от Могильника. Потом отнесите эти тыквы аптекарю Юхану в Брилл.‡Stehlt 10 Kürbisse vom Gehöft im Westen, direkt nördlich von Todesend und bringt sie zu Apotheker Johaan nach Brill.‡데스넬 북쪽에 있는 농장에서 티리스팔 호박을 10개 훔친 다음 브릴에 있는 연금술사 요한에게 가져가야 합니다.‡Roba 10 calabazas de la plantación que encontrarás en dirección oeste, justo al norte de Camposanto, y llévaselas al boticario Johaan a Rémol.‡Roba 10 calabazas de la plantación que encontrarás en dirección oeste, justo al norte de Camposanto, y llévaselas al boticario Johaan a Rémol.‡Volez 10 Potirons dans la ferme à l\'ouest, juste au nord du Glas, et apportez-les à l\'Apothicaire Johaan à Brill.‡从位于布瑞尔西边、丧钟镇北边的农场中偷10颗南瓜来，把它们交给布瑞尔的药剂师乔汉。‡從位於布瑞爾西邊、喪鐘鎮北邊的農場中偷10顆南瓜來，把它們交給布瑞爾的藥劑師喬漢。',
  }
},
[366] = {
  {
    'Devolva o livro‡Книга Гюнтера‡Rückgabe des Buches‡마법책 반납‡Devuelve el libro‡Devuelve el libro‡Ramener le livre‡归还书籍‡歸還書籍',
    nil,
    'Devolva o Grimório de Tertuliano a ele, na ilha do Refúgio de Tertuliano.‡Верните Гюнтеру книгу заклинаний. Его можно найти на острове, в приюте Гюнтера.‡Bringt Gunthers Zauberbuch zu ihm auf die "Gunthers Zufluchtsort" genannte Insel zurück.‡군터의 은거지로 가서 군터의 마법책을 돌려줘야 합니다.‡Devuélvele el libro de hechizos de Gunther a su dueño, que se encuentra en la isla del Refugio de Gunther.‡Devuélvele el libro de hechizos de Gunther a su dueño, que se encuentra en la isla del Refugio de Gunther.‡Ramener son livre de sorts à Gunther, dans sa retraite sur son île.‡到冈瑟尔居住的小岛去归还他的法术书。‡到岡瑟爾居住的小島去歸還他的法術書。',
  }
},
[367] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'O Boticário Joaquino na cidade de Montalvo quer que você colete 5 Ampolas de Sangue de Cão das Trevas.‡Принесите аптекарю Юхану 5 склянок крови псов тьмы.‡Apotheker Johaan in der Stadt Brill möchte, dass Ihr 5 Phiolen Schattenhundblut sammelt.‡브릴에 있는 연금술사 요한이 암흑사냥개 피 5병을 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol quiere que recojas 5 viales de sangre de can oscuro.‡El boticario Johaan de Rémol quiere que recojas 5 viales de sangre de can oscuro.‡Collecter 5 fioles de Sang de sombredogues pour l\'Apothicaire Johaan de la ville de Brill.‡布瑞尔镇里的药剂师乔汉要求你收集5瓶黑暗犬的血液。‡布瑞爾鎮裡的藥劑師喬漢要求你收集5瓶黑暗犬的血液。',
  }
},
[368] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡新的瘟疫',
    nil,
    'O Boticário Joaquino na cidade de Montalvo precisa de 5 Escamas de Pinavil dos Murlocs das Clareiras de Tirisfal.‡Принесите аптекарю Юхану из Брилла 5 чешуек мурлоков из племени Злобного Плавника из Тирисфальских лесов.‡Apotheker Johaan in der Stadt Brill benötigt 5 Finsterflossenschuppen von den Murlocs in Tirisfal.‡브릴에 있는 연금술사 요한이 티리스팔 숲에 있는 썩은지느러미멀록 비늘 5개를 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol necesita 5 escamas Anca Vil de los múrlocs de los Claros de Tirisfal.‡El boticario Johaan de Rémol necesita 5 escamas de Anca Vil de los múrlocs de los Claros de Tirisfal.‡L\'Apothicaire Johaan de la ville de Brill a besoin de 5 Ecailles d\'Aileron noir prises sur les murlocs des Clairières de Tirisfal.‡布瑞尔镇里的药剂师乔汉要求你收集5片提瑞斯法林地的邪鳍鱼人的鳞片。‡布瑞爾鎮裡的藥劑師喬漢要求你收集5片提里斯法林地的邪鰭魚人的鱗片。',
  }
},
[369] = {
  {
    'A nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡',
    nil,
    'O Boticário Joaquino na cidade de Montalvo quer que você leve 4 amostras de peçonha da Trevateia Malévola para ele.‡Принесите аптекарю Юхану из Брилла 4 образца яда злобного ночного кругопряда.‡Apotheker Johaan in der Stadt Brill möchte, dass Ihr ihm 4 Proben vom Gift eines heimtückischen Nachtwebers bringt.‡브릴에 있는 연금술사 요한이 흉포한 검은그물거미의 독 4개를 가져다 달라고 부탁했습니다.‡El boticario Johaan de Rémol quiere que le lleves 4 muestras de veneno de nocturácnida feroz.‡El boticario Johaan de Rémol quiere que le lleves 4 muestras de veneno de nocturácnida sañosa.‡L\'Apothicaire Johaan de la ville de Brill désire que vous lui rameniez 4 échantillons de Venin de Tisse-nuit vicieuse.‡布瑞尔镇里的药剂师乔汉要你去收集4份邪恶的夜行蜘蛛的毒液样本。‡',
  }
},
[370] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Im Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano em Montalvo quer que você mate o Capitão Perrine, 3 Zelotes Escarlates e 3 Missionários Escarlates.‡Убейте капитана Перрина, 3 ревнителей и 3 миссионеров из Алого ордена по просьбе вершителя Зуганда.‡Exekutor Zygand in Brill möchte, dass Ihr Hauptmann Perrine, 3 scharlachrote Zeloten und 3 scharlachrote Missionare tötet.‡브릴에 있는 집행관 자이건드가 대장 페린, 붉은십자군 광신도 3명, 붉은십자군 선교사 3명을 처치해 달라고 부탁했습니다.‡El ejecutor Zygand de Rémol quiere que mates al capitán Perrine, a 3 zelotes Escarlata y a 3 misioneros Escarlata.‡El ejecutor Zygand de Rémol quiere que mates al capitán Perrine, a 3 zelotes Escarlata y a 3 misioneros Escarlata.‡Tuer le capitaine Perrine ainsi que 3 Zélotes écarlates et 3 Missionnaires écarlates.‡布瑞尔的执行官塞加德要求你杀掉派瑞恩队长、3名血色狂热者和3名血色传教士。‡布瑞爾的執行官塞加德要求你殺掉派瑞恩隊長、3名血色狂熱者和3名血色傳教士。',
  }
},
[371] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡',
    nil,
    'O Executor Zigano em Montalvo ordenou que você mate o Capitão Vidálio e 5 Frades Escarlates.‡Убейте капитана Вакона и пятерых келейников из Алого ордена по заданию вершителя Зуганда.‡Exekutor Zygand in Brill hat Euch damit beauftragt, Hauptmann Vachon und 5 scharlachrote Ordensmitglieder zu erschlagen.‡브릴에 있는 집행관 자이건드가 대장 바콘과 붉은십자군 수사 5명을 처치하라고 명령했습니다.‡El ejecutor Zygand de Rémol te ha encargado que mates al capitán Vachon y a 5 frailes Escarlata.‡El ejecutor Zygand de Rémol te ha encargado que mates al capitán Vachon y a 5 frailes Escarlata.‡L\'Exécuteur Zygand de Brill vous a chargé de liquider le Capitaine Vachon et 5 Frères écarlates.‡布瑞尔的执行官塞加德要求你杀掉瓦松队长和5名血色苦行修士。‡',
  }
},
[372] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En Guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano na cidade de Montalvo quer que você mate o Capitão Metrache e seus dois seguranças.‡По просьбе палача Зуганда убейте капитана Мелраша и двух его телохранителей.‡Exekutor Zygand in der Stadt Brill möchte, dass Ihr Hauptmann Melrache und seine beiden Leibwachen ermordet.‡브릴 마을에 있는 집행관 자이건드가 대장 멜라케와 붉은십자군 경호원 2명을 처치해 달라고 부탁했습니다.‡El ejecutor Zygand de Rémol quiere que asesines al capitán Melrache y a sus dos guardaespaldas.‡El ejecutor Zygand de Rémol quiere que asesines al capitán Melrache y a sus dos guardaespaldas.‡L\'Exécuteur Zygand de la ville de Brill veut que vous alliez assassiner le Capitaine Melrache et ses deux gardes du corps.‡布瑞尔的执行官塞加德要求你刺杀麦拉其队长及他的两名保镖。‡布瑞爾的執行官塞加德要求你刺殺麥拉其隊長及他的兩名保鏢。',
  }
},
[373] = {
  {
    'Uma carta não enviada‡Неотправленное письмо‡Der nie verschickte Brief‡부치지 않은 편지‡La carta sin enviar‡La carta sin enviar‡La lettre non envoyée‡未寄出的信‡未寄出的信',
    nil,
    'Entregue a Carta para o Arquiteto da Cidade a Baros Aleixo em Ventobravo.‡Доставьте письмо городскому архитектору Баросу Алекстону в Штормград.‡Bringt den Brief nach Sturmwind zum Stadtarchitekten Baros Alexston.‡스톰윈드에 있는 도시 건축가 바로스 알렉스턴에게 편지를 전달해야 합니다.‡Entrega la carta destinada al arquitecto de la ciudad a Baros Alexston en Ventormenta.‡Entrega la carta destinada al arquitecto jefe a Baros Alexston en Ventormenta.‡Livrer la lettre pour l\'Architecte de la Cité à Baros Alexston à Stormwind.‡将艾德温·范克里夫的信交给巴隆斯·阿历克斯顿。‡將艾德溫·范克里夫的信交給巴洛斯·艾力克斯頓。',
  }
},
[374] = {
  {
    'Prova da morte‡Доказательство верности‡Beweise des Ablebens‡죽음의 증거‡Prueba de la muerte‡Prueba de defunción‡Preuves de la mort‡死亡证明‡死亡證明',
    nil,
    'Leve 10 Anéis com Insígnia Escarlates para o Necroguarda Belchior em Montalvo.‡Принесите 10 алых перстней стражу смерти Берджесу в Брилл.‡Bringt Todeswache Burgess in Brill 10 scharlachrote Insignienringe.‡브릴에 있는 죽음의경비병 버제스에게 붉은십자군 반지 10개를 가져가야 합니다.‡Llévale 10 anillos con la insignia Escarlata al Guardia de la Muerte Burgess de Rémol.‡Llévale 10 anillos con la insignia escarlata al Guardia de la Muerte Burgess de Rémol.‡Apporter 10 Anneaux de la Croisade écarlate au Nécrogarde Burgess à Brill.‡给布瑞尔的亡灵卫兵伯吉斯带回10枚血色十字军徽记之戒。‡給布瑞爾的亡靈衛兵伯吉斯帶回10枚血色十字軍徽記之戒。',
  }
},
[375] = {
  {
    'O frio da morte‡Смертельный холод‡Die Kälte des Todes‡죽음의 한기‡El frío de la muerte‡El frío de la muerte‡Le frisson de la mort‡死亡之寒‡死亡之寒',
    nil,
    'Leve 5 Pelagens de Quiropúsculo e um pouco de Fio Grosso para Gretchen Dedamar em Montalvo.‡Принесите 5 шкурок сумеречницы и грубую нить Гретхен Дедмар в Брилл.‡Bringt Gretchen Dedmar in Brill fünf Nachtsaugerpelze und etwas groben Faden.‡브릴에 있는 그레첸 데드마에게 그늘박쥐 모피 5개와 굵은 실타래 1개를 가져가야 합니다.‡Llévale 5 pelambres de Murciumbrío y un hilo burdo a Gretchen Dedmar, que está en Rémol.‡Llévale 5 pelambres de Murciumbrío y un hilo burdo a Gretchen Dedmar, que está en Rémol.‡Rapporter 5 Peaux de chauve-souris du crépuscule et une Bobine de fil grossier à Gretchen Dedmar à Brill.‡给布瑞尔的格雷森·戴德马带回5张夜行蝙蝠的毛皮和一些粗线。‡給布瑞爾的格雷森·戴德馬帶回5張夜行蝙蝠的毛皮和一些粗線。',
  }
},
[376] = {
  {
    'Os malditos‡Проклятые‡Die Verdammten‡저주받은 존재‡Los Malditos‡Los Malditos‡Les Maudits‡被诅咒者‡被詛咒者',
    nil,
    'A Noviça Elvira precisa de 6 Patas de Carniceiro e 6 Asas de Quiropúsculo.‡Ученице Элрет нужно 6 лап падальщика и 6 крыльев сумеречницы.‡Novize Elreth benötigt 6 Aasfressertatzen und 6 Nachtsaugerflügel.‡수련사제 엘레스가 승냥이 앞발 6개와 그늘박쥐 날개 6개를 구해다 달라고 부탁했습니다.‡La novicia Elreth necesita 6 garras de carroñero y 6 alas de Murciumbrío.‡Consigue 4 garras de carroñero y 4 alas de Murciumbrío.‡La Novice Elreth a besoin de 6 Pattes de charognard et de 6 Ailes de chauve-souris du crépuscule.‡新兵艾尔雷斯需要6只食腐狼的爪子和6只夜行蝙蝠翼。‡新兵艾爾雷斯需要6隻食腐狼的爪子和6隻夜行蝙蝠翼。',
  }
},
[377] = {
  {
    'Crime e castigo‡Преступление и наказание‡Verbrechen und Strafe‡죄와 벌‡Crimen y castigo‡Crimen y castigo‡Crime et Châtiments‡罪与罚‡罪與罰',
    nil,
    'O Conselheiro Millstipe da Vila Sombria quer que você leve a mão de Flávio Lúcio para ele.‡Принесите советнику Миллстайпу руку Декстрена Варда.‡Ratsherr Mühlenstein von Dunkelhain will, dass Ihr ihm die Hand von Dextren Ward bringt.‡다크샤이어의 원로 밀스타이프가 덱스트렌 워드를 처치한 후 그의 장갑을 가져다 달라고 부탁했습니다.‡El consejero Tallolino de Villa Oscura quiere que le lleves la mano de Dextren Ward.‡El consejero Tallolino de Villa Oscura quiere que le lleves la mano de Dextren Ward.‡Le conseiller Millstipe de Sombre-comté désire que vous lui rameniez la main de Dextren Ward.‡夜色镇的米尔斯迪普议员要你杀死迪克斯特·瓦德，并把他的手带回来作为证明。‡夜色鎮的米爾斯泰普議員要你殺死迪克斯特·瓦德，並把他的手帶回來作為證明。',
  }
},
[378] = {
  {
    'Fúria profunda‡Успокоить гневливого‡Tief empfundener Zorn‡격노‡La furia mora en las profundidades‡La furia mora en las profundidades‡Fureur dans les Profondeurs‡卡姆·深怒‡積怒已久',
    nil,
    'Rocio Garmason quer que você leve a cabeça de Kam Fundafúria para ele em Dun Modr.‡Принесите голову Кама Гневливого Мотли Каменщику в Дун Модр.‡Motley Garmason in Dun Modr verlangt Kam Tiefenzorns Kopf.‡딥퓨리를 처치하고 그 증거로 그의 머리카락을 던 모드르에 있는 모틀리 가마슨에게 가져가야 합니다.‡Motley Garmason quiere que le lleves la cabeza de Kam Furiahonda a Dun Modr.‡Motley Garmason quiere que le lleves la cabeza de Kam Furiahonda a Dun Modr.‡Rapportez la tête de Kam Furie-du-fond à Motley Garmaçon à Dun Modr.‡丹莫德的莫特雷·加玛森要求你把卡姆·深怒的头颅交给他。‡丹莫德的莫特雷·加瑪森要求你把卡姆·深怒的頭顱交給他。',
  }
},
[379] = {
  {
    'Mate a sede‡Утолить жажду‡Durstlöscher‡갈증 해소‡Aplacar esa sed‡Aplacar esa sed‡Etancher cette soif‡口渴的比格维兹‡口渴的比格維茲',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Engenheiro-chefe Silvadágua em Geringontzan.‡Найдите 5 бурдюков с водой Скитальцев Пустыни главному инженеру Чепухастеру в Прибамбасск.‡Bringt Chefingenieur Bilgenritzel in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 선임기술자 빌지위즐에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 faltriqueras de agua de Deambulador al ingeniero jefe Silvaina, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al ingeniero jefe Pasaquillas, en Gadgetzan.‡Rapporter 5 Outres de Bat-le-désert à l\'ingénieur en chef Vizisanie à Gadgetzan.‡给加基森的首席工程师沙克斯·比格维兹带去五只废土水袋。‡給加基森的首席工程師比格維茲帶去五只廢土水袋。',
  }
},
[380] = {
  {
    'Vale Teia da Noite‡Паучья низина‡Nachtwebergrund‡검은그물 거미굴‡Hoya Nocturácnidas‡Hoya Nocturácnidas‡Les grottes des Tisse-nuit‡夜行蜘蛛洞穴‡夜行蜘蛛洞穴',
    nil,
    'O Executor Arren quer que você mate 10 Trevateias Jovens e 8 Trevateias.‡Палач Аррен хочет, чтобы вы убили 10 молодых ночных кругопрядов и 8 ночных кругопрядов.‡Exekutor Arren will, dass Ihr 10 junge Nachtweber und 8 Nachtweber tötet.‡집행관 아렌이 새끼 검은그물거미 10마리와 검은그물거미 8마리를 처치해 달라고 부탁했습니다.‡El ejecutor Arren quiere que mates a 10 nocturácnidas jóvenes y a 8 nocturácnidas.‡El ejecutor Arren quiere que mates a 8 nocturácnidas jóvenes y a 5 nocturácnidas.‡L\'Exécuteur Arren veut que vous tuiez 10 Jeunes Tisse-nuit et 8 Araignées Tisse-nuit.‡执行官阿伦要你去杀掉10只小夜行蜘蛛和8只夜行蜘蛛。‡',
  }
},
[381] = {
  {
    'A Cruzada Escarlate‡Алый орден‡Der Scharlachrote Kreuzzug‡붉은십자군‡La Cruzada Escarlata‡La Cruzada Escarlata‡La Croisade écarlate‡血色十字军‡血色十字軍',
    nil,
    'Leve 12 Braçadeiras Escarlates de Neófitos Escarlates e Iniciados Escarlates para o Executor Arren.‡Принесите вершителю Аррену 12 алых поручей, сняв их с новообращенных и посвященных из Алого ордена.‡Bringt Exekutor Arren insgesamt 12 scharlachrote Armbinden von scharlachroten Konvertiten und scharlachroten Initianden.‡집행관 아렌에게 붉은십자군 순례자와 붉은십자군 수습마법사에게서 붉은십자군 완장 12개를 구해 와야 합니다.‡Lleva al ejecutor Arren 12 bandas Escarlata de conversos Escarlata y de iniciados Escarlata.‡Lleva al ejecutor Arren 12 bandas Escarlata de conversos Escarlata y de iniciados Escarlata.‡Apporter à l\'Exécuteur Arren 12 Bracelets écarlates, que vous trouverez sur des Convertis écarlates et des Initiés écarlates.‡从血色信徒和血色新兵身上收集12枚血色十字军臂章，把它们交给执行官阿伦。‡',
  }
},
[382] = {
  {
    'O mensageiro escarlate‡Красный гонец‡Der Rote Bote‡붉은십자군 전령‡El mensajero rojo‡El mensajero rojo‡Le messager rouge‡十字军信使‡',
    nil,
    'Mate Meven Korgal, o mensageiro, no acampamento da Cruzada, e leve as informações que encontrar para o Executor Arren.‡Убейте гонца Мевена Коргала в лагере Алого ордена, а потом передайте перехваченные известия палачу Аррену.‡Tötet Meven Korgal, den Boten, im Lager der Kreuzzügler und kehrt danach mit allen Informationen, die Ihr findet, zu Exekutor Arren zurück.‡붉은십자군 야영지에 있는 전령 메븐 코갈을 처치한 다음 입수한 정보를 집행관 아렌에게 가져가야 합니다.‡Mata a Meven Korgal, el mensajero, en el campamento de los Cruzados y vuelve a comunicar al ejecutor Arren cualquier información que encuentres.‡Mata a Meven Korgal, el mensajero, en el campamento de los Cruzados y vuelve a comunicar al ejecutor Arren cualquier información que encuentres.‡Tuer Meven Korgal, le messager, au camp de la Croisade, puis ramener toutes les informations trouvées à l\'Exécuteur Arren.‡到十字军营地去杀掉信使迈文·考加尔，将你发现的情报交给执行官阿伦。‡',
  }
},
[383] = {
  {
    'Informações cruciais‡Важные разведданные‡Entscheidende Informationen‡중요한 정보‡Información decisiva‡Información decisiva‡Informations décisives‡重要情报‡',
    nil,
    'Entregue os Documentos da Cruzada Escarlate ao Executor Zigano, em Montalvo.‡Отнесите бумаги Алого ордена вершителю Зуганду в Брилл.‡Bringt die Dokumente des Scharlachroten Kreuzzugs zu Exekutor Zygand nach Brill.‡브릴에 있는 집행관 자이건드에게 붉은십자군 문서를 전달해야 합니다.‡Ve a Rémol y entrega los documentos de la Cruzada Escarlata al ejecutor Zygand.‡Ve a Rémol y entrega los documentos de la Cruzada Escarlata al ejecutor Zygand.‡Livrer les Documents de la Croisade écarlate à l\'Exécuteur Zygand à Brill.‡把血色十字军文件交给布瑞尔的执行官塞加德。‡',
  }
},
[384] = {
  {
    'Costelinhas de javali na cerveja‡Кабаньи ребрышки в пиве‡Eberrippchen in Biersauce‡맥주로 양념한 멧돼지 갈비‡Costillas de jabalí a la cerveza‡Costillas de jabalí a la cerveza‡Côtes de sanglier à la bière‡啤酒烤猪排‡啤酒烤豬排',
    nil,
    'Ragnar Cervaforte, em Kharanos, quer que você lhe traga 6 Costeletas de Rochetusco e uma caneca de Malte Rapsódia.‡Принесите 6 ребер скального вепря и кружку "Болтливого пива" Рагнару Громовару в Караносе.‡Ragnar Donnerbräu in Kharanos benötigt 6 Klippeneberrippchen und einen Krug Rhapsodiemalz.‡카라노스에 있는 라그나르 썬더브루가 멧돼지 갈비 6개와 랩소디 몰트 한 병을 구해다 달라고 부탁했습니다.‡Ragnar Cebatruenos de Kharanos quiere 6 costillas de jabalí del risco y una jarra de malta rapsódica.‡Ragnar Cebatruenos de Kharanos quiere 4 costillas de jabalí tiernas y una jarra de malta rapsódica.‡Ragnar Tonnebière à Kharanos veut 6 Côtes de sangliers des rochers et une Chope de bière au malt Rhapsody.‡卡拉诺斯的拉格纳·雷酒需要6块峭壁野猪肋排和1杯狂想麦酒。‡卡拉諾斯的拉格納·雷酒需要6塊峭壁野豬肋排和1杯狂想麥酒。',
  }
},
[385] = {
  {
    'Crocoliscos na mira‡Охота на кроколисков‡Krokiliskenjagd‡악어 사냥‡La caza de crocoliscos‡La caza de crocoliscos‡Chasse aux crocilisques‡捕猎鳄鱼‡捕獵鱷魚',
    nil,
    'Obtenha 5 peças de Carne de Crocolisco e 6 Peles de Crocolisco para Marek Ferrocordis no Pavilhão dos Andarilhos.‡Принесите Мареку Железносерду в Приют Странников 5 кусков мяса кроколиска и 6 шкур кроколиска.‡Besorgt 5 Stücke Krokiliskenfleisch und 6 Krokiliskenhäute für Marek Eisenherz in der Jagdhütte der Weltenwanderer.‡순찰자의 오두막에 있는 마렉 아이언하트에게 악어 고기 5개와 악어 가죽 6개를 가져다주어야 합니다.‡Lleva 5 piezas de carne de crocolisco y 6 pieles de crocolisco a Marek Coracero, que está en la Cabaña del Errante.‡Lleva 5 piezas de carne de crocolisco y 6 pieles de crocolisco a Marek Coracero, en la Cabaña del Errante.‡Trouver 5 morceaux de Viande de crocilisque et 6 Peaux de crocilisque pour Marek Cœur-de-fer au pavillon des pérégrins.‡收集5块鳄鱼肉和6张鳄鱼皮，把它们交给旅行者营地里的马雷克·铁心。‡收集5塊鱷魚肉和6張鱷魚皮，把它們交給遠行者小屋裡的馬雷克·鐵心。',
  }
},
[386] = {
  {
    'Tudo que vai...‡Что происходит?‡Verbrechen lohnt sich nicht‡사필귀정‡Lo que sucede alrededor...‡Lo que sucede alrededor...‡Ce qui se passait ailleurs…‡伸张正义‡伸張正義',
    nil,
    'Leve a cabeça de Targorr, o Horror para o Guarda Berto em Vila Plácida.‡Принесите голову Таргорра Ужасного стражнику Бертону в Приозерье.‡Bringt Wache Berton in Seenhain den Kopf von Targorr dem Schrecklichen.‡흉악범 타고르를 처치한 후 그 증거로 그의 머리카락을 레이크샤이어에 있는 경비병 베르턴에게 가져가야 합니다.‡Lleva la cabeza de Targor el Pavoroso al guardia Berton a Villa del Lago.‡Lleva la cabeza de Targorr el Pavoroso al guardia Berton a Villa del Lago.‡Ramener la tête de Targorr le Terrifiant au Garde Berton à Comté-du-lac.‡把塔格尔的头颅带给湖畔镇的卫兵伯尔顿。‡把塔高爾的頭顱帶給湖畔鎮的衛兵伯爾頓。',
  }
},
[387] = {
  {
    'Sufoque a rebelião‡Подавление бунта‡Niederschlagung des Aufstandes‡폭동 진압‡Detener el motín‡Detener el motín‡Écraser la rébellion‡镇压暴动‡鎮壓暴動',
    nil,
    'O Carcereiro-chefe Thelágua de Ventobravo quer que você mate 10 Défias Prisioneiros, 8 Défias Condenados e 8 Défias Insurgentes em O Cárcere.‡Тюремщик Телвотер просит вас убить в тюрьме 10 узников, 8 каторжников и 8 мятежников из Братства Справедливости.‡Aufseher Thelwasser aus Sturmwind will, dass Ihr im Verlies 10 gefangene Defias, 8 eingekerkerte Defias und 8 Aufrührer der Defias tötet.‡스톰윈드에 있는 교도소장 델워터가 지하감옥에서 데피아즈단 복역수 10명, 데피아즈단 무기징역수 8명, 데피아즈단 반역자 8명을 처치해 달라고 부탁했습니다.‡El celador Thelagua de Ventormenta quiere que mates a 10 prisioneros Defias, 8 presidiarios Defias y 8 insurgentes Defias en las Mazmorras.‡El celador Thelagua de Ventormenta quiere que mates 10 prisioneros, 8 presidiarios, y 8 insurgentes en Las Mazmorras.‡Tuer 10 Prisonniers défias, 8 Détenus défias et 8 Insurgés défias dans la Prison pour le Gardien Thelwater de Hurlevent.‡暴风城的典狱官塞尔沃特要求你杀死监狱中的10名迪菲亚囚徒、8名迪菲亚罪犯和8名迪菲亚叛军。‡暴風城的典獄官塞爾沃特要求你殺死監獄中的10名迪菲亞囚犯、8名迪菲亞罪犯和8名迪菲亞叛軍。',
  }
},
[388] = {
  {
    'A cor do sangue‡Цвет крови‡Die Farbe von Blut‡피의 색‡El color de la sangre‡El color de la sangre‡La couleur du Sang‡鲜血的颜色‡鮮血的顏色',
    nil,
    'Nikova Raskol, de Ventobravo, quer que você colete 10 Bandanas Vermelhas de Lã.‡Принесите Никове Раскол 10 красных шерстяных бандан.‡Nikova Raskol von Sturmwind will, dass Ihr 10 rote Wollkopftücher für sie sammelt.‡스톰윈드에 있는 니코바 라스콜이 붉은 양모 복면을 10개를 모아 달라고 부탁했습니다.‡Nikova Raskol, de Ventormenta, quiere que consigas 10 pañuelos de lana roja.‡Nikova Raskol, de Ventormenta, quiere que consigas 10 pañuelos de lana roja.‡Rapporter 10 foulards en laine rouge à Nikova Raskol de Hurlevent.‡暴风城的尼科瓦·拉斯克要你取得10条红色毛纺面罩。‡暴風城的尼科瓦·拉斯克要你取得10條紅色毛紡頭巾。',
  }
},
[389] = {
  {
    'Basílio Taborda‡Базиль Тредд‡Bazil Thredd‡바질 스레드‡Bazil Thredd‡Bazil Thredd‡Bazil Thredd‡巴基尔·斯瑞德‡巴基爾·斯瑞德',
    nil,
    'Fale com o Carcereiro-chefe Thelágua no Cárcere.‡Поговорите с надзирателем Телвотером в тюрьме.‡Sprecht mit Aufseher Thelwasser im Verlies.‡감옥에 있는 교도소장 델워터와 대화해야 합니다.‡Habla con el celador Thelagua en las Mazmorras.‡Habla con el celador Thelagua en las Mazmorras.‡Parler au gardien Thelwater à la prison.‡与监狱的典狱官塞尔沃特谈一谈。‡與監獄的典獄官塞爾沃特談話。',
  }
},
[391] = {
  {
    'Rebelião no Cárcere‡Бунтовщики в тюрьме‡Aufstand im Verlies‡감옥 폭동‡El motín de Las Mazmorras‡El motín de Las Mazmorras‡Les Emeutes de la Prison‡监狱暴动‡監獄暴動',
    nil,
    'Mate Basílio Taborda e leve a cabeça dele para o Carcereiro-chefe Thelágua no Cárcere.‡Убейте Базиля Тредда и принесите его голову Телвотеру в тюрьму Штормграда.‡Tötet Bazil Thredd und bringt seinen Kopf mit zurück zu Aufseher Thelwasser im Verlies.‡바질 스레드를 처치하고 그 증거로 그의 머리카락을 감옥에 있는 교도소장 델워터에게 가져가야 합니다.‡Mata a Bazil Thredd y lleva su cabeza al celador Thelagua en las Mazmorras.‡Mata a Bazil Thredd y lleva su cabeza al celador Thelagua en las Mazmorras.‡Tuer Bazil Thredd et ramener sa tête au Gardien Thelwater à la Prison.‡杀死巴基尔·斯瑞德，把他的头带给监狱的典狱官塞尔沃特。‡殺死巴基爾·斯瑞德，把他的頭帶給監獄的典獄官塞爾沃特。',
  }
},
[392] = {
  {
    'Visitante suspeito‡Таинственный посетитель‡Der seltsame Besucher‡수상한 면회인‡Extraño visitante‡Extraño visitante‡Un curieux visiteur‡好奇的访客‡好奇的訪客',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para Baros Aleixo em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Баросу Алекстону в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Sturmwind zu Baros Alexston.‡스톰윈드에 있는 바로스 알렉스턴에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción del visitante de Thredd lacrada a Baros Alexston en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada a Baros Alexston en Ventormenta.‡Apporter la description du visiteur de Thredd à Baros Alexston à Hurlevent.‡将神秘访客的资料交给暴风城的巴隆斯·阿历克斯顿。‡將神秘訪客的資料交給暴風城的巴洛斯·艾力克斯頓。',
  }
},
[393] = {
  {
    'Sombra do passado‡Тень прошлого‡Schatten der Vergangenheit‡과거의 그림자‡Sombras del pasado‡Sombras del pasado‡Les Ombres du Passé‡往日的阴影‡往日的陰影',
    nil,
    'Leve a Descrição da Visita do Taborda Lacrada para o Mestre Mathias Shaw em Ventobravo.‡Отнесите запечатанное описание посетителя Тредда Матиасу Шоу в Штормград.‡Bringt die versiegelte Beschreibung von Thredds Besucher nach Sturmwind zu Meister Mathias Shaw.‡스톰윈드에 있는 단장 마티아스 쇼에게 스레드의 방문객에 대한 봉인된 인상서를 전해줘야 합니다.‡Lleva la descripción del visitante de Thredd lacrada al maestro Mathias Shaw en Ventormenta.‡Lleva la descripción del visitante de Thredd lacrada al maestro Mathias Shaw en Ventormenta.‡Apporter la Description scellée du visiteur de Thredd au Maître Mathias Shaw à Hurlevent.‡与旧城区的马迪亚斯·肖尔谈一谈。‡與舊城區的馬迪亞斯·肖爾談話。',
  }
},
[394] = {
  {
    'A cabeça da fera‡Голова чудовища‡Der Kopf des Ganzen‡잔인한 자의 최후‡La cabeza de la bestia‡La cabeza de la bestia‡La tête de la bête‡禽兽的首级‡禽獸的首級',
    nil,
    'Fale com Mathias Shaw em Ventobravo.‡Поговорите с Матиасом Шоу в Штормграде.‡Sprecht mit Mathias Shaw in Sturmwind.‡스톰윈드에 있는 마티아스 쇼와 대화해야 합니다.‡Habla con Mathias Shaw en Ventormenta.‡Habla con Mathias Shaw en Ventormenta.‡Parler à Mathias Shaw, à Hurlevent.‡去见暴风城旧城区的马迪亚斯·肖尔。‡與暴風城舊城區的馬迪亞斯·肖爾談話。',
  }
},
[395] = {
  {
    'Fim da irmandade‡Гибель братства‡Das Ende der Bruderschaft‡데피아즈단의 종말‡El fin de la Hermandad‡El fin de la Hermandad‡La fin de la Confrérie‡兄弟会的灭亡‡兄弟會的滅亡',
    nil,
    'Fale com Baros Aleixo em Ventobravo.‡Поговорите с Баросом Алекстоном в Штормграде.‡Sprecht mit Baros Alexston in Sturmwind.‡스톰윈드에 있는 바로스 알렉스턴과 대화하십시오.‡Habla con Baros Alexston en Ventormenta.‡Habla con Baros Alexston en Ventormenta.‡Parler à Baros Alexston à Hurlevent.‡与暴风城的巴隆斯·阿历克斯顿谈一谈。‡與暴風城的巴洛斯·艾力克斯頓談話。',
  }
},
[396] = {
  {
    'Uma audiência com o rei‡Аудиенция у короля‡Eine Audienz beim König‡국왕 알현‡Una audiencia con el Rey‡Una audiencia con el Rey‡Une audience avec le roi‡觐见国王‡覲見國王',
    nil,
    'Entregue o Relatório sobre a Irmandade Défias de Baros Aleixo ao Rei Varian Wrynn na Bastilha Ventobravo.‡Доставьте доклад Бароса Алекстона о Братстве Справедливости королю Вариану Ринну в крепость Штормграда.‡Liefert Baros Alexstons Bericht über die Bruderschaft der Defias bei König Varian Wrynn in der Burg Sturmwind ab.‡스톰윈드 왕궁으로 가서 알렉스턴의 데피아즈단에 대한 보고서를 국왕 바리안 린에게 전달해야 합니다.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Lleva el informe de Baros Alexston sobre la Hermandad Defias al rey Varian Wrynn en el Castillo de Ventormenta.‡Apporter le rapport de Baros Alexston sur la Confrérie Défias au Roi Varian Wrynn au Donjon de Stormwind.‡将有关迪菲亚兄弟会的报告送给暴风要塞里的国王瓦里安·乌瑞恩。‡將有關迪菲亞兄弟會的報告送給暴風要塞裡的國王瓦里安·烏瑞恩。',
  }
},
[397] = {
  {
    'Atendimento nota 10‡За достойную службу‡Ihr habt uns gut gedient‡수고의 대가‡Nos has hecho un gran servicio‡Nos has hecho un gran servicio‡Vous nous avez bien servi‡干得好‡幹得好',
    nil,
    'Fale com Pingo, o lacaio de Malvino da Garra Preta, para receber sua recompensa.‡Поговорите с Згги, слугой Зардета Черного Когтя, чтобы получить награду.‡Sprecht mit Zggi, dem Diener von Zardeth der Schwarzen Klaue, um Eure Belohnung zu erhalten.‡검은발톱 자데스의 하인인 즈기와 대화하여 보상을 받으십시오.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Habla con Zggi, el sirviente de Zardeth de los Zarpanegra, para pedir tu recompensa.‡Aller demander votre récompense en parlant à Zggi, le serviteur de Zardeth de Black Claw.‡去找黑爪加尔德斯的仆人兹吉谈一谈，并向他索要你的酬劳。‡去找黑爪加爾德斯的僕人茲吉談一談，並向他索要你的酬勞。',
  }
},
[398] = {
  {
    'Procura-se: Olho de Verme‡Разыскивается: Червеглаз‡GESUCHT: Madenauge‡구더기눈 현상 수배‡Se busca: Ojo de gusano‡Se busca: Ojo de cresa‡On recherche : Œil-de-ver‡悬赏：蛆眼‡懸賞:蛆眼',
    nil,
    'Mate e leve a pata de Olho de Verme para o Executor Zigano em Montalvo para receber a recompensa.‡Убейте Червеглаза и отнесите палачу Зуганду в Брилл его лапу.‡Tötet Madenauge und kehrt dann mit seiner Tatze zu Exekutor Zygand nach Brill zurück, um eine Belohnung zu erhalten.‡구더기눈을 처치한 후 브릴에 있는 집행관 자이건드에게 돌아가 구더기눈의 앞발을 증거로 제출하고 보상을 받으십시오.‡Mata a Ojo de gusano y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Mata a Ojo de cresa y llévale su garra al ejecutor Zygand de Rémol para obtener una recompensa.‡Tuer Œil-de-ver et rapporter ses griffes à l\'Exécuteur Zygand pour toucher la récompense.‡杀死蛆眼，并将他的爪子交给布瑞尔的执行官塞加德以换取酬劳。‡殺死蛆眼，並將他的爪子交給布瑞爾的執行官塞加德以換取酬勞。',
  }
},
[399] = {
  {
    'Origens humildes‡Скромные дары прошлого‡Ein bescheidener Anfang‡초라한 시작‡Principios humildes‡Principios humildes‡Débuts modestes‡童年的记忆‡童年的記憶',
    nil,
    'Vá até a casa de Baros Aleixo em Cerro Oeste e procure sua bússola, então a entregue para ele na Praça da Catedral de Ventobravo.‡Обыщите дом Бароса Алекстона в Западном Крае, найдите компас и вернитесь на Соборную площадь Штормграда.‡Begebt Euch zu Baros Alexstons Haus in Westfall und sucht nach seinem Kompass. Übergebt ihm diesen dann am Kathedralenplatz von Sturmwind.‡서부 몰락지대에 있는 바로스 알렉스턴의 집으로 가서 나침반을 찾은 다음 스톰윈드의 대성당 광장에 있는 바로스 알렉스턴에게 가져가야 합니다.‡Ve a la casa de Baros Alexston en Páramos de Poniente y busca su brújula. A continuación, llévasela a la Plaza de la Catedral, en Ventormenta.‡Ve a la casa de Baros Alexston en los Páramos de Poniente y busca su brújula. A continuación, llévasela al Distrito de la Catedral, en Ventormenta.‡Aller à la maison de Baros Alexston dans la marche de l\'Ouest pour chercher sa boussole et lui rapporter à la place de la Cathédrale de Hurlevent.‡到巴隆斯·阿历克斯顿在西部荒野的房子里去找到他的指南针，并将它带回暴风城的教堂广场交给他。‡到巴洛斯·艾力克斯頓在西部荒野的房子裡找尋他的指南針，並帶回暴風城教堂區給他。',
  }
},
[400] = {
  {
    'Ferramentas para Gradaço‡Инструменты для Сталежара‡Werkzeuge für Stahlrost‡스틸그릴이 주문한 공구‡Herramientas para Brasacerada‡Herramientas para Brasacerada‡Des outils pour Grillacier‡贝尔丁的工具‡貝爾丁的工具',
    nil,
    'Entregue as Ferramentas do Gradaço para Beldin Gradaço.‡Доставьте инструменты Белдину Сталежару.‡Liefert Beldin Stahlrost seine Werkzeuge.‡벨딘 스틸그릴에게 스틸그릴의 공구를 배달해야 합니다.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Entrega las herramientas de Brasacerada a Beldin Brasacerada.‡Rapporter les outils de Grillacier à Beldin Grillacier.‡把贝尔丁的工具交给贝尔丁·钢架。‡把貝爾丁的工具交給貝爾丁·鋼架。',
  }
},
[401] = {
  {
    'Espere Sirra terminar‡Ожидание перевода‡Wartet, bis Sirra fertig ist‡시라의 번역 기다리기‡Espera a que Sirra acabe‡Espera a que Sirra acabe‡Attendre la fin des travaux de Sirra‡等待希拉完工‡等待希拉完工',
    nil,
    'Espere um pouco e então fale novamente com Sirra Von\'Indi.‡Подождите немного и снова поговорите с Широй Фон-Инди.‡Wartet einen Moment und sprecht dann erneut mit Sirra Von\'Indi.‡잠시 기다렸다가 시라 본인디와 다시 대화해야 합니다.‡Espera un momento y luego vuelve a hablar con Sirra Von\'Indi.‡Espera un momento y luego vuelve a hablar con Sirra Von\'Indi.‡Attendre un moment puis parler de nouveau avec Sirra Von\'Indi.‡稍等片刻，然后再和希拉·沃宁迪交谈。‡稍等片刻，然後再和希拉·沃寧迪交談。',
  }
},
[402] = {
  {
    'Sirra is Busy‡Шира занят‡Sirra ist beschäftigt‡‡Sirra está ocupada‡‡Sirra est occupée‡‡',
    nil,
    'Check back with Sirra later to see if he\'s still busy.‡Зайдите к Шире и выясните, занят ли он.‡Schaut später noch einmal nach, ob Sirra immer noch beschäftigt ist.‡‡Vuelve más tarde a ver si Sirra sigue aún ocupado.‡Vuelve más tarde a ver si Sirra sigue aún ocupado.‡Vérifier plus tard si Serra est toujours occupé.‡‡',
  }
},
[403] = {
  {
    'Cuidado com o barril‡Охраняемый бочонок громопойла‡Das bewachte Fass mit Donnerbier‡썬더브루 맥주통‡El barril de Cebatruenos custodiado‡El barril de Cebatruenos custodiado‡La garde du tonneau de Thunderbrew‡戒备森严‡',
    nil,
    'Este barril de cerveja é o xodó do Jarven Cervaforte. Enquanto Jarven estiver no porão, não perturbe os barris.‡Этот бочонок эля охраняет Ярвен Громовар. Пока он в подвале, до бочек не добраться.‡Dieses Fass Bier wird von Jarven Donnerbräu bewacht. Solange er im Keller ist, kann man sich nicht an den Fässern zu schaffen machen.‡이 에일 맥주통은 야벤 썬더브루가 지키고 있습니다. 야벤이 지하실에 있는 동안에는 맥주통에 손을 댈 수도 없습니다.‡Este barril está custodiado por Jarven Cebatruenos. Mientras esté en el sótano, nadie tocará los barriles.‡‡Ce tonneau de bière est gardé par Jarven Thunderbrew. Tant qu\'il est dans les sous-sols, aucun tonneau ne peut être bougé.‡‡',
  }
},
[404] = {
  {
    'Uma tarefa podre‡Грязная работа‡Eine eitrige Aufgabe‡더러운 임무‡Una tarea pútrida‡Una tarea pútrida‡Une tâche putride‡腐烂的爪子‡腐爛的爪子',
    nil,
    'Traga 7 Garras Pútridas para o Necroguarda Dinis em Montalvo.‡Принесите 7 гнилых когтей стражу смерти Диллинжеру в Брилл.‡Bringt Todeswache Dillinger in Brill 7 eitrige Klauen.‡브릴에 있는 죽음의경비병 딜링거에게 썩은 발톱 7개를 가져가야 합니다.‡Llévale 7 garras podridas al Guardia de la Muerte Dillinger de Rémol.‡Llévale 7 garras podridas al Guardia de la Muerte Dillinger de Rémol.‡Rapporter 7 Griffes putrides au Nécrogarde Dillinger à Brill.‡给布瑞尔的亡灵卫兵迪林格尔带回7只腐烂的爪子。‡給布瑞爾的亡靈衛兵迪林格爾帶回7隻腐爛的爪子。',
  }
},
[405] = {
  {
    'O Lich pródigo‡Блудный лич‡Der abtrünnige Lich‡회개한 마술사‡El exánime pródigo‡El exánime pródigo‡La Liche prodigue‡流浪的巫妖‡流浪的巫妖',
    nil,
    'Apresente as Ordens de Sevren a Boanerges Stalactus na Cidade Baixa.‡Отнесите приказы Севрена Бетору Ледострелу в Подгород.‡Zeigt Bethor Eismacht in Unterstadt Sevrens Befehle.‡언더시티에 있는 베소르 아이스샤드에게 세브렌의 명령서를 보여 줘야 합니다.‡Comunícale las órdenes de Sevren a Bethor Duroyelo, que está en Entrañas.‡Comunícale las órdenes de Sevren a Bethor Duroyelo en Entrañas.‡Présenter les ordres de Sevren à Bethor Glacéclat à Fossoyeuse.‡将塞弗伦的命令交给幽暗城的比索·埃斯沙德。‡將塞弗倫的命令交給幽暗城的比索·埃斯沙德。',
  }
},
[407] = {
  {
    'Campos de mágoa‡Поля горя‡Felder des Kummers‡오염된 농장‡Campos de pena‡Campos de pena‡Les champs du Chagrin‡悲伤之地‡',
    nil,
    'Leve a Abóbora Inoculada para o Zelote Escarlate Capturado que esta sendo mantido no porão da Taberna Nó da Forca.‡Отнесите отравленную тыкву пленному ревнителю из Алого ордена, которого держат в погребе таверны "Петля висельника".‡Bringt den getränkten Kürbis zum gefangenen scharlachroten Zeloten, der im Keller der Taverne Zur Galgenschlinge gefangen gehalten wird.‡사로잡힌 붉은십자군 광신도에게 줄무늬 호박을 가져다주십시오. 갤로우 선술집 지하실에 갇혀 있습니다.‡Llévale la calabaza envenenada al zelote Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Llévale la calabaza envenenada al zelote Escarlata capturado que está encerrado en el sótano del Mesón La Horca.‡Donner le Potiron arrosé au Zélote écarlate capturé qui est gardé dans le cellier de la taverne des Pendus.‡将斑纹南瓜带给被关在恐惧之末旅店地下室中的血色十字军俘虏。‡',
  }
},
[408] = {
  {
    'A cripta da família‡Семейный склеп‡Die Familiengruft‡아가만드가 납골당‡La Cripta de la Familia‡La Cripta de la Familia‡La Crypte Familiale‡家族墓穴‡家族墓穴',
    nil,
    'Mate 8 Ancestrais Ululantes e 8 Ancestrais Apodrecidos.nnMate o Capitão Dargol, e leve seu crânio para o Magistrado Sevren em Montalvo.‡Убейте 8 стенающих предков и 8 гниющих предков.nnУбейте капитана Даргола и принесите его череп мировому судье Севрену в Брилл.‡Tötet 8 Klagende Vorfahren und 8 Faulende Vorfahren.nnTötet Hauptmann Dargol und bringt seinen Schädel zu Magistrat Sevren nach Brill.‡울부짖는 아가만드 망령 8마리와 썩어가는 아가만드 시체 8마리를 처치해야 합니다.nn대장 다르골을 처치하고 그의 해골을 브릴에 있는 집정관 세브렌에게 가져가야 합니다.‡Mata a 8 ancestros de los Lamentos y a 8 ancianos putrefactos.nnMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Mata a 8 ancestros gemebundos y a 8 ancestros en podredumbre.|nMata al capitán Dargol y llévale su calavera al magistrado Sevren de Rémol.‡Tuer 8 Spectres ancestraux et 8 Ancêtres pourrissants.nnTuer le capitaine Dargol et ramener son crâne au magistrat Sevren à Brill.‡杀死8个哀嚎的鬼魂和8个腐烂的古尸。nn消灭达高尔队长，并将他的颅骨交给布瑞尔的执政官塞弗伦。‡殺死8個哀嚎的鬼魂和8個腐爛的古屍。|n消滅達高爾隊長，並將他的顱骨交給布瑞爾的執政官塞弗倫。',
  }
},
[409] = {
  {
    'Prova de lealdade‡Доказательство преданности‡Treuebeweis‡동맹의 증거‡Prueba de lealtad‡Prueba de lealtad‡Prouver l\'allégeance‡证明忠诚‡',
    nil,
    'Obtenha uma Vela de Sinalização.nnEvoque e mate Lillith Nefara.nnFale novamente com Tertuliano em sua ilha.‡Возьмите манящую свечу.nnВызовите Лилит Нефару и убейте ее.nnВернитесь на остров к Гюнтеру.‡Beschafft Euch eine Kerze des Heranlockens.nnBeschwört Lillith Nefara und tötet sie.nnKehrt zu Gunther auf seiner Insel zurück.‡부름의 양초를 얻어야 합니다.nn릴리스 네파라를 소환하여 처치해야 합니다.nn그 후에 섬에 있는 군터에게 돌아가도록 하십시오.‡Coge una vela de señalización.nnDespierta a Lillith Nefara y mátala.nnVuelve a ver a Gunther a su isla.‡Coge una vela de señalización.|nDespierta a Lillith Nefala y mátala.|nVuelve a ver a Gunther a su isla.‡Obtenir une Bougie de signal.nnInvoquer Lillith Nefara et la tuer.nnRetourner voir Gunther sur son île.‡拿上一根诱灵蜡烛。nn召唤出莉莉丝·奈法拉并杀死她。nn然后向岛上的冈瑟尔回报。‡',
  }
},
[410] = {
  {
    'A sombra dormente‡Спящая тень‡Der Schlummernde Schatten‡잠든 망령‡Sombra durmiente‡Sombra durmiente‡L\'Ombre dormante‡潜伏的阴影‡',
    nil,
    'É uma antiga mesa manchada de sangue.‡Старый, побитый, окровавленный стол.‡Dies ist ein alter, abgewetzter, blutiger Tisch.‡오래되고 곳곳이 깨진 피투성이 제단입니다.‡Esta vieja mesa está hecha polvo.‡‡C\'est une vieille table ensanglantée.‡‡',
  }
},
[411] = {
  {
    'A volta do Lich pródigo‡Возвращение блудного лича‡Die Rückkehr des abtrünnigen Lichs‡회개한 마술사의 귀환‡El regreso del exánime pródigo‡El regreso del exánime pródigo‡Le Retour de la Liche Prodigue‡巫妖归顺‡',
    nil,
    'Leve a Gema Etérea para Boanerges Stalactus na Cidade Baixa.‡Отнесите самоцвет Пустоты Бетору Ледострелу в Подгород.‡Bringt den Netheredelstein zu Bethor Eismacht nach Unterstadt.‡언더시티에 있는 베소르 아이스샤드에게 지옥의 보석을 가져가야 합니다.‡Llévale la gema Abisal a Bethor Duroyelo, que está en Entrañas.‡Llévale la gema abisal a Bethor Duroyelo en Entrañas.‡Rapporter la Gemme du Néant à Bethor Glacéclat à Fossoyeuse.‡将虚空宝石交给幽暗城的比索·埃斯沙德。‡',
  }
},
[412] = {
  {
    'Operação remendão‡Операция "Перенаправление"‡Operation Rekombobulationsgerät‡작전명 유전자 재결합‡Operación Recombobulación‡Operación Recombobulación‡Opération Recombobulation‡自动净化装置‡自動淨化器',
    nil,
    'Leve 8 Rodas de Reestabilização e 8 Equipamentos Giromecânicos para Razzle Molavivaz em Kharanos.‡Принесите Раззлу Шустрецу в Караносе 8 зубцов рестабилизации и 8 гиромеханических шестерней.‡Bringt Razzle Flinkspross in Kharanos 8 Restabilisationszahnräder und 8 gyromechanische Getriebeteile.‡카라노스에 있는 라즐 스프리스프로켓에게 재고정 물림기어 8개와 자이로 기어 8개를 가져다주어야 합니다.‡Lleva a Razzle Energiodentado a Kharanos 8 levas estabilizadoras y 8 engranajes giromecánicos.‡Lleva 8 engranajes giromecánicos a Razzle Engranágil.‡Porter 8 Rouages de Rééquilibrage et 8 Engrenages gyromécaniques à Esbrouf Fulgurouage à Kharanos.‡收集8个多档齿轮和8个自适应齿轮，把它们交给卡拉诺斯的拉兹·滑链。‡收集8個多檔齒輪和8個自適應齒輪，把它們交給卡拉諾斯的拉索·滑鏈。',
  }
},
[413] = {
  {
    'Cerveja Tremeluz‡Мерцающий портер‡Schimmerstarkbier‡쉼머 스타우트 맥주‡Cerveza negra Brillante‡Cerveza negra Brillante‡La bière Shimmer‡微光酒‡微光酒',
    nil,
    'Entregue o Barril de Cerveja Tremeluz para o Montanhista Cervevada.‡Отнесите бочонок "Мерцающего портера" горному пехотинцу Ячменовару.‡Bringt das Fass mit Schimmerstarkbier zu Gebirgsjäger Gerstenbräu.‡산악경비대 발리브루에게 쉼머 스타우트 맥주통을 가져다주어야 합니다.‡Lleva la barrica de cerveza negra Brillante al montaraz Cebadiz.‡Lleva el tonel de cerveza negra Brillante al montaraz Cebadiz.‡Amener le Tonneau de Brune scintillante au Montagnard Brasselorge.‡把这一大桶微光酒交给巡山人维拉特·麦酒。‡把這一大桶微光酒交給巡山人維拉特·麥酒。',
  }
},
[414] = {
  {
    'Cerveja para Kadrell‡Портер для Кэдрелла‡Starkbier für Kadrell‡카드렐에게 맥주 배달하기‡Cerveza negra para Kadrell‡Cerveza negra para Kadrell‡Bière à Kadrell‡卡德雷尔的酒‡給卡德雷爾的酒',
    nil,
    'Entregue o Barril de Cerveja Tremeluz para o Montanhista Kadrell.‡Отнести бочонок "Мерцающего портера" горному пехотинцу Кэдреллу.‡Bringt das Fässlein mit Schimmerstarkbier zu Gebirgsjäger Kadrell.‡산악경비대 카드렐에게 쉼머 스타우트 술통을 가져다주어야 합니다.‡Lleva el tonel de cerveza negra Brillante al montaraz Kadrell.‡Lleva el tonel de cerveza negra Brillante al montaraz Kadrell.‡Portez le Tonneau de Brune scintillante au Montagnard Kadrell.‡把这桶微光酒带给巡山人卡德雷尔。‡把這桶微光酒帶給巡山人卡德雷爾。',
  }
},
[415] = {
  {
    'A nova cerveja do Rejold‡Новое пиво Регольда‡Rejolds neues Gebräu‡레욜트의 새 술‡La nueva bebida de Rejold‡La nueva bebida de Rejold‡La nouvelle cuvée de Rejold‡雷杰德的新酒‡',
    nil,
    'Fale com Rejold Cervevada.‡Поговорите с Регольдом Ячменоваром.‡Sprecht mit Rejold Gerstenbräu.‡레욜트 발리브루와 대화하십시오.‡Habla con Rejold Cebadiz.‡Habla con Rejold Cebadiz.‡Parler à Rejold Brasselorge.‡和雷杰德·麦酒谈一谈。‡',
  }
},
[416] = {
  {
    'Caça ao rato‡Ловля крыс‡Rattenfang‡코볼트 사냥‡Mata ratas‡Mata ratas‡Chasse au rat‡狗头人的耳朵‡逮捕狗頭人',
    nil,
    'Leve 12 Orelhas de Ratatúnel para o Montanhista Kadrell em Thelsamar.‡Принесите 12 ушей кобольдов-туннельщиков горному пехотинцу Кэдреллу в Телcамар.‡Bringt Gebirgsjäger Kadrell in Thelsamar 12 Tunnelrattenohren.‡텔사마에 있는 산악경비대 카드렐에게 동굴쥐일족의 귀걸이 12개를 가져다주어야 합니다.‡Lleva 12 orejas de rata de túnel al montaraz Kadrell a Thelsamar.‡Lleva 8 orejas de rata de túnel al montaraz Pico Tormenta a Thelsamar.‡Apporter 12 Oreilles de Rat des tunnels au Montagnard Kadrell à Thelsamar.‡收集12只坑道鼠的耳朵，把它们带给塞尔萨玛的巡山人卡德雷尔。‡收集12隻坑道鼠的耳朵，把它們帶給塞爾薩瑪的巡山人卡德雷爾。',
  }
},
[417] = {
  {
    'A vingança do piloto‡Месть пилота‡Pilotenrache‡조종사의 복수‡Vengar al piloto‡Vengar al piloto‡La revanche du pilote‡驾驶员的复仇‡駕駛員的復仇',
    nil,
    'Mate o Ronhagarra.nnEntregue a Pata Sarnenta do urso e o Diário de Hildelve para o Piloto Pisafundo.‡Убейте Паршивого Когтя.nnПринесите его коготь и журнал Хилдельва пилоту Большеногу.‡Tötet Marterklaue.nnBringt Pilot Hammerfuß die räudige Klaue des Bären und Hangflugs Tagebuch.‡썩은발톱을 처치해야 합니다.nn그러고 나서 놈의 발톱과 힐델브의 일지를 조종사 해머풋에게 가져다주어야 합니다.‡Mata a Sarnagarra. nnLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo.‡Mata a Sarnagarra.|nLleva su garra sarnosa y el diario de Hildelve al piloto Podomartillo en la Avanzada de la Puerta Sur.‡Tuer Griffe galeuse.nnRapporter la griffe à laquelle il doit son nom et le Journal d\'Hildelve au pilote Martèlepied.‡杀死癞爪。nn把它的肮脏的爪子和莫里·铁钻的日记交给驾驶员塞克·锤足。‡殺死癩爪。|n把牠的骯髒的爪子和莫里·鐵鑽的日記交給駕駛員塞克·錘足。',
  }
},
[418] = {
  {
    'Chouriço de Thelsamar‡Телcамарские кровяные колбаски‡Blutwurst aus Thelsamar‡텔사마 선지 소시지‡Morcillas de Thelsamar‡Morcillas de Thelsamar‡Les boudins de Thelsamar‡塞尔萨玛血肠‡塞爾薩瑪血腸',
    nil,
    'Leve 3 pedaços de Carne de Urso, 3 Tripas de Javali e 3 Linfas de Aranha para Vidra Fornalenha, de Thelsamar.‡Принесите Видре Жаркий Очаг в Телcамар 3 куска медвежатины, 3 связки кишок кабана и 3 порции паучьей лимфы.‡Bringt Vidra Ofenglut in Thelsamar 3 Stück Bärenfleisch, 3 Portionen Ebergedärme und 3 Portionen Spinnensekret.‡텔사마에 있는 비드라 하트스토브에게 곰 고기 3개, 멧돼지 창자 3개, 거미 수액 3개를 가져다주어야 합니다.‡Lleva 3 trozos de carne de oso, 3 intestinos de jabalí y 3 icores de araña a Vidra Hogartufa, en Thelsamar.‡Lleva 8 trozos de carne de oso a Vidra Hogartufa, en Thelsamar.‡Apporter 3 morceaux de Viande d\'ours, 3 Tripes de sanglier et 3 Ichors d\'araignée à Vidra Poêlâtre à Thelsamar.‡收集3块熊肉、3根猪大肠和3份蜘蛛的毒液，把它们交给塞尔萨玛的维德拉·壁炉。‡收集3塊熊肉、3根豬大腸和3份蜘蛛的毒液，把它們交給塞爾薩瑪的維德拉·壁爐。',
  }
},
[419] = {
  {
    'O piloto perdido‡Пропавший пилот‡Der vermisste Pilot‡실종된 조종사‡El piloto perdido‡El piloto perdido‡Le pilote perdu‡失踪的驾驶员‡失蹤的駕駛員',
    nil,
    'Encontre o piloto Hildelve.‡Найдите пилота Хилдельва.‡Findet Pilot Hangflug.‡조종사 힐델브를 찾아야 합니다.‡Encuentra al piloto Hildelve.‡El piloto Podomartillo, en la Avanzada de la Puerta Sur, quiere que encuentres al piloto Hildelve.‡Trouver le pilote Hildeve.‡找到驾驶员莫里·铁钻。‡找到駕駛員莫里·鐵鑽。',
  }
},
[420] = {
  {
    'Observações de Senir‡Наблюдения Сенира‡Senirs Beobachtungen‡그렐린의 보고서‡Las observaciones de Senir‡Las observaciones de Senir‡Les observations de Senir‡森内尔的观察站‡森內爾的觀察站',
    nil,
    'Entregue o relatório de Grolin para Senir Barbabranca em Kharanos.‡Доставьте донесение Грелина Сениру Белобороду в Караносе.‡Überbringt Senir Weißbart in Kharanos Grelins Bericht.‡그렐린의 보고서를 카라노스에 있는 세니르 화이트비어드에게 전달해야 합니다.‡Lleva el informe de Grelin a Senir Barbablanca a Kharanos.‡Lleva el informe de Grelin a Senir Barbablanca a Kharanos.‡Apporter le rapport de Grelin à Senir Blanchebarbe à Kharanos.‡把格瑞林的报告交给卡拉诺斯的森内尔·白须。‡把格瑞林的報告交給卡拉諾斯的森內爾·白鬚。',
  }
},
[421] = {
  {
    'Prove seu valor‡Проявить себя‡Wertbeweis‡실력 검증‡Demuestra tu valía‡Demuestra tu valía‡Prouver votre valeur‡证明你的价值‡證明你的價值',
    nil,
    'Dalar Tessalba, do Sepulcro, quer que você mate 5 Grenhalvas Lunafúria.‡Далар Ткач Рассвета в Гробнице хочет, чтобы вы убили 5 белоголовов Лунной Ярости.‡Dalar Morgenweber auf dem Grabmal will, dass Ihr 5 Weißskalps des Mondzorns tötet.‡공동묘지에 있는 달라 돈위버가 달의분노일족 백발전사 5마리를 처치해 달라고 부탁했습니다.‡Dalar Tejalba en El Sepulcro quiere que mates 5 canosos Furia Lunar.‡Dalar Tejealba en El Sepulcro quiere que mates a 5 canosos Furia Lunar.‡Tuer 5 Poils-blancs Ragelune pour Dalar Tisselaube au Sépulcre.‡瑟伯切尔的达拉尔·道恩维沃尔要求你杀死5只月怒白头狼人。‡瑟伯切爾的達拉爾·道恩維沃爾要求你殺死5隻月怒白頭狼人。',
  }
},
[422] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡阿魯高的愚行',
    nil,
    'Recupere o Remédio de Arugal para Dalar Tessalba, do Sepulcro.‡Раздобудьте книгу "Зелье Аругала" и принесите ее Далару Ткачу Рассвета в Гробницу.‡Beschafft Dalar Morgenweber auf dem Grabmal die Arznei des Arugal.‡공동묘지에 있는 달라 돈위버에게 아루갈의 치료법을 가져가야 합니다.‡Recupera el Remedio de Arugal para Dalar Tejalba, en El Sepulcro.‡Recupera el Remedio de Arugal para Dalar Tejealba, en El Sepulcro.‡Retrouver le Remède d\'Arugal pour Dalar Tisselaube au Sépulcre.‡为瑟伯切尔的达拉尔·道恩维沃尔找回《阿鲁高的拯救》。‡為瑟伯切爾的達拉爾·道恩維沃爾找回《阿魯高的拯救》。',
  }
},
[423] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡',
    nil,
    'Leve 6 Grilhões de Glutão e 3 Grilhões Almanegra para Dalar Tessalba, no Sepulcro.‡Принесите Далару Ткачу Рассвета в Гробницу 6 наручей обжор Лунной Ярости и 3 наруча темных духов Лунной Ярости.‡Bringt Dalar Morgenweber am Grabmal 6 Nimmersattfesseln und 3 Dunkelseelenfesseln.‡공동묘지에 있는 달라 돈위버에게 광신도의 족쇄 6개와 검은영혼의 족쇄 3개를 가져가야 합니다.‡Lleva 6 grilletes de glotón y 3 grilletes de almanegra a Dalar Tejalba en El Sepulcro.‡Lleva 6 grilletes de glotón y 3 grilletes de almanegra a Dalar Tejealba en El Sepulcro.‡Rapportez 6 Bracelets de Gloutons et 3 Bracelets de Ténébreux à Dalar Tisselaube au Sépulcre.‡给瑟伯切尔的达拉尔·道恩维沃尔带回6副暴食者镣铐和3副魔魂镣铐。‡',
  }
},
[424] = {
  {
    'A loucura de Arugal‡Безрассудство Аругала‡Arugals Torheit‡아루갈의 계략‡La locura de Arugal‡La locura de Arugal‡La folie d\'Arugal‡阿鲁高的愚行‡',
    nil,
    'Mate Severo, o Pálido, e leve sua cabeça para Dalar Tessalba no Sepulcro.‡Убейте Мрачнона Белесого и принесите его голову Далару Ткачу Рассвета в Гробницу.‡Tötet Grimson den Blassen und bringt seinen Kopf zu Dalar Morgenweber beim Grabmal.‡은빛갈기 그림슨을 처치하고 그의 해골을 공동묘지에 있는 달라 돈위버에게 가져가야 합니다.‡Mata a Grimson el Pálido y lleva su cabeza a Dalar Tejalba en El Sepulcro.‡Mata a Grimson el Pálido y lleva su cabeza a Dalar Tejealba en El Sepulcro.‡Tuer Grimson le Pâle et ramener sa tête à Dalar Tisselaube au Sépulcre.‡杀死白毛狼人格瑞姆森，把他的头带给瑟伯切尔的达拉尔·道恩维沃尔。‡',
  }
},
[425] = {
  {
    'Ivar, o Imundo‡Ивар Нечистый‡Ivar der Verfaulte‡포악한 이바르‡Ivar el Hediondo‡Ivar el Hediondo‡Ivar l\'Infect‡邪恶的伊瓦‡邪惡的伊瓦',
    nil,
    'Mate Ivar, o Imundo, e leve a Cabeça de Ivar para Rane Yorick, que está na Plantação do Ivar.‡Убейте Ивара Нечистого и принесите его голову Ран Йорик на делянку Ивара.‡Tötet Ivar den Verfaulten und bringt Ivars Kopf zu Rane Yorick auf dem Ivarfeld.‡포악한 이바르를 처치하고 이바르의 해골을 이바르 호박밭에 있는 레인 요릭에게 가져가야 합니다.‡Mata a Ivar el Hediondo y lleva la cabeza de Ivar a Rane Yorick en Los Dominios de Ivar.‡Mata a Ivar el Hediondo y lleva la cabeza de Ivar a Rane Yorick en Los Dominios de Ivar.‡Tuer Ivar l\'Infect et ramener sa tête à Rane Yorick au lopin d\'Ivar.‡杀死邪恶的伊瓦，并将伊瓦的头颅带给伊瓦农庄的兰妮·尤瑞克。‡殺死邪惡的伊瓦，並將伊瓦的頭顱帶給伊瓦農莊的蘭妮·尤瑞克。',
  }
},
[426] = {
  {
    'Os moinhos invadidos‡Нападение на мельницы‡Die überrannte Mühle‡밀농장 습격‡La invasión de los molinos‡La invasión de los molinos‡La chute des moulins‡磨坊告急‡磨坊告急',
    nil,
    'Colete 5 Costelas Carcomidas e 3 Crânios Enegrecidos, depois fale novamente com o Necroguarda Dinis em Montalvo.‡Соберите 5 зазубренных ребер и 3 почерневших черепа для стража смерти Диллинджера в Брилле.‡Sammelt 5 schartige Rippen sowie 3 geschwärzte Schädel und kehrt dann zu Todeswache Dillinger nach Brill zurück.‡톱니모양 늑골 5개와 저주받은 해골 3개를 모은 다음 브릴에 있는 죽음의경비병 딜링거에게 돌아가야 합니다.‡Recoge 5 costillas con cortes y 3 calaveras ennegrecidas, y después regresa ente el Guardia de la Muerte Dillinger de Rémol.‡Recoge 5 costillas con cortes y 3 calaveras ennegrecidas, y después regresa ente el Guardia de la Muerte Dillinger de Rémol.‡Rassemblez 5 Côtes ébréchées et 3 Crânes noircis et rapportez-les au Nécrogarde Dillinger à Brill.‡收集5根锯齿肋骨和3个焦黑的颅骨，然后向布瑞尔的亡灵卫兵迪林格尔回报。‡收集5根鋸齒肋骨和3個焦黑的顱骨，然後向布瑞爾的亡靈衛兵迪林格爾回報。',
  }
},
[427] = {
  {
    'Guerra à Cruzada Escarlate‡Война с Алым орденом‡Im Krieg mit dem Scharlachroten Kreuzzug‡붉은십자군과의 전쟁‡En guerra con la Cruzada Escarlata‡En guerra con la Cruzada Escarlata‡En guerre avec la Croisade écarlate‡与血色十字军的战争‡與血色十字軍的戰爭',
    nil,
    'O Executor Zigano, de Montalvo, quer que você mate 10 Guerreiros Escarlates.‡Убейте 10 воинов из Алого ордена по просьбе вершителя Зуганда.‡Exekutor Zygand von Brill verlangt, dass Ihr 10 scharlachrote Krieger tötet.‡브릴에 있는 집행관 자이건드가 붉은십자군 전사 10명을 처치해 달라고 부탁했습니다.‡El ejecutor Zygand de Rémol quiere que mates a 10 guerreros Escarlata.‡El ejecutor Zygand de Rémol quiere que mates a 10 guerreros Escarlata.‡Tuer 10 Guerriers écarlates pour l\'Exécuteur Zygand.‡布瑞尔的执行官塞加德要求你杀掉10名血色战士。‡布瑞爾的執行官塞加德要求你去殺掉10名血色十字軍戰士。',
  }
},
[428] = {
  {
    'Sicários perdidos‡Пропавшие стражи смерти‡Die verlorenen Todespirscher‡실종된 죽음의추적자‡Los Mortacechadores desaparecidos‡Los Mortacechadores desaparecidos‡Les nécrotraqueurs égarés‡失踪的亡灵哨兵‡失蹤的亡靈哨兵',
    nil,
    'Encontre os Sicários Quintino e Rane Yorick.‡Найдите стражей смерти Квинна Йорика и Ран Йорик.‡Findet die Todespirscher Quinn und Rane Yorick.‡죽음의추적자 쿠인 요릭과 레인 요릭을 찾아야 합니다.‡Encuentra a los Mortacechadores Quinn y Rane Yorick.‡Encuentra a los Mortacechadores Quinn y Rane Yorick.‡Trouver les Nécrotraqueurs Quinn et Rane Yorick.‡找到亡灵哨兵兰妮·尤瑞克和奎恩·尤瑞克。‡找到亡靈哨兵蘭妮·尤瑞克和奎恩·尤瑞克。',
  }
},
[429] = {
  {
    'Corações selvagens‡Звериные сердца‡Wilde Herzen‡늑대의 심장‡Corazones salvajes‡Corazones salvajes‡Cœurs sauvages‡荒野之心‡荒野之心',
    nil,
    'Junte 6 Corações Descoloridos de Worg e leve-os para o Boticário Renferrel no Sepulcro.‡Соберите 6 обесцвеченных сердец ворга и принесите их аптекарю Ренферрелу в Гробницу.‡Sammelt 6 verfärbte Worgherzen und bringt sie zu Apotheker Renferrel auf dem Grabmal.‡변색된 검은늑대 심장 6개를 모아 공동묘지에 있는 연금술사 렌퍼럴에게 가져가야 합니다.‡Consigue 6 corazones de huargo descoloridos y llévaselos al boticario Renferrel en El Sepulcro.‡Consigue 6 corazones de huargo descoloridos y llévaselos al boticario Renferrel en El Sepulcro.‡Recueillir six Cœurs de worg et les apporter à l\'Apothicaire Renferrel au Sépulcre.‡收集6颗变色的狼心，把它们交给瑟伯切尔的药剂师伦弗利尔。‡收集6顆變色的狼心，把它們交給瑟伯切爾的藥劑師倫弗利爾。',
  }
},
[430] = {
  {
    'Reencontrando Quintino‡Назад к Квинну‡Rückkehr zu Quinn‡쿠인에게 돌아가기‡Vuelve con Quinn‡Regresa junto a Quinn‡Retour vers Quinn‡回到奎恩身旁‡回到奎恩身旁',
    nil,
    'Leve a poção para Quintino Yorick na Plantação do Ivar, ao norte do Sepulcro.‡Отнесите зелье Квинна Квинну Йорику на делянку Ивара, к северу от Гробницы.‡Bringt Quinn Yorick auf dem Ivarfeld, nördlich des Grabmals, Quinns Trank.‡공동묘지 북쪽의 이바르 호박밭에 있는 쿠인 요릭에게 쿠인의 물약을 가져가야 합니다.‡Lleva la poción de Quinn a Quinn Yorick en Los Dominios de Ivar, al norte de El Sepulcro.‡Lleva la poción de Quinn a Quinn Yorick en Los Dominios de Ivar, al norte de El Sepulcro.‡Apporter le remède à Quinn Yorick au lopin d\'Ivar, au nord du Sépulcre.‡将奎恩的药水带给瑟伯切尔北方伊瓦农场的奎恩·尤瑞克。‡將奎恩的藥水帶給瑟伯切爾北方伊瓦農場的奎恩·尤瑞克。',
  }
},
[431] = {
  {
    'Velas de sinalização‡Манящие свечи‡Kerze des Heranlockens‡부름의 양초‡Velas de señalización‡Velas de señalización‡Bougies de signal‡诱灵蜡烛‡',
    nil,
    'Você pega uma das velas e guarda na mochila.‡Вы берете одну свечу и кладете ее в сумку.‡Ihr schnappt Euch eine der Kerzen und verstaut sie in Eurem Rucksack.‡양초를 하나 집어 가방에 넣습니다.‡Coges una de las velas y la colocas en tu talega.‡‡Vous vous emparez d\'une bougie et la mettez dans votre sac.‡‡',
  }
},
[432] = {
  {
    'Malditos troggs!‡Проклятые трогги!‡Diese verfluchten Troggs!‡저주받을 트로그‡¡Malditos troggs!‡¡Malditos troggs!‡Ces satanés troggs !‡该死的石腭怪！‡該死的石齶怪!',
    nil,
    'Mate 6 Batecrânios Pedraqueixo para o Encarregado Pedracenho na Pedreira Gol\'Bolar.‡Убейте по просьбе штейгера Камнелоба 6 головоломов из племени Каменной Челюсти в карьере Гол\'Болар.‡Tötet für Großknecht Steinbraue im Steinbruch von Gol\'Bolar 6 Schädelhauer der Felsenkiefer.‡골볼라 채석장에서 현장감독 스톤브로우를 위해 바위턱일족 망치잡이 6마리를 처치해야 합니다.‡Mata a 6 aplastacráneos Comepiedras para Supervisor Petrocejas de la Cantera de Gol\'Bolar.‡Mata a 8 aplastacráneos Comepiedras y a 8 cascahuesos Comepiedras en la Cantera de Gol\'Bolar o en la mina.‡Tuer 6 Brise-crânes Mâcheroc pour le contremaître Front-de-pierre à la carrière de Gol\'Bolar.‡在古博拉采掘场里替工头乔尼·石眉杀死6个石腭击颅者。‡在古博拉採掘場裡替工頭喬尼·石眉殺死6個石齶擊顱者。',
  }
},
[433] = {
  {
    'O funcionário público‡Слуга народа‡Im Dienste des Volkes‡공무 수행‡El servidor público‡El servidor público‡Le serviteur public‡公众之仆‡公僕',
    nil,
    'Mate 10 Quebraossos Pedraqueixo para o Senador Mehr Sacrapetra na Pedreira Gol\'Bolar.‡Убейте 10 костегрызов из племени Каменной Челюсти по просьбе сенатора Мера Каменная Реликвия из карьера Гол\'Болар.‡Tötet für Senator Mehr Steingunst im Steinbruch von Gol\'Bolar 10 Knochenknacker der Felsenkiefer.‡원로원의원 메르 스톤할로우를 위해 골볼라 채석장에서 바위턱일족 뼈다귀싸움꾼 10마리를 처치해야 합니다.‡Mata a 10 Cascahuesos Comepiedras para el senador Mehr Piedrasanta de la Cantera de Gol\'Bolar.‡Reparte 7 runas de retorno a los mineros atrapados en la Cantera de Gol\'Bolar.‡Tuer 10 Briseurs d\'os Mâcheroc pour le sénateur Mehr Sacrepierre à la carrière de Gol\'Bolar.‡在古博拉采掘场里替参议员梅尔·圣石杀死10个石腭断骨者。‡到古博拉採掘場裡替參議員梅爾·聖石殺死10個石齶斷骨者。',
  }
},
[434] = {
  {
    'O ataque!‡Нападение!‡Der Angriff!‡공격!‡El ataque‡El ataque‡L\'attaque !‡伏击！‡伏擊!',
    nil,
    'Fiquei no jardim até que Lorde Gregor Lescobar e Marzon, a Lâmina Silente conversem. Depois, mate ambos antes de falar novamente com Elling Trias em Ventobravo.‡Спрячьтесь в саду и подслушайте разговор лорда Грегора Лесковара и Марзона Бесшумного Клинка. После этого убейте обоих и возвращайтесь к Иллингу Триасу в Штормград.‡Bleibt im Garten, bis Lord Gregor Lescovar und Marzon die Stille Klinge ihr Gespräch beendet haben. Schaltet sie danach beide aus, bevor Ihr nach Sturmwind zu Elling Trias zurückkehrt.‡그레골 라스코발 경과 소리없는검객 마르존이 대화를 나눌때까지 정원에서 기다려야 합니다. 그후에 모두 처치한 후 스톰윈드에 있는 엘링 트리아스에게 돌아가야 합니다.‡Quédate en el jardín hasta que Lord Gregor Lescovar y Marzon el Filo Silencioso hayan terminado de hablar. A continuación, mátalos antes de volver a reunirte con Elling Trias en Ventormenta.‡Quédate en el jardín hasta que Lord Gregor Lescovar y Marzon el Filo Silencioso hayan terminado de hablar. A continuación, mátalos antes de volver a reunirte con Elling Trias en Ventormenta.‡Rester dans le jardin jusqu\'à ce que le seigneur Gregor Lescovar et Marzon Lame silencieuse aient eu leur conversation. Après, les tuer tous les deux puis retourner voir Elling Trias à Hurlevent.‡等待葛瑞格·莱斯科瓦公爵和沉默之刃马尔松在花园里的对话结束，杀死他们两个，之后向暴风城的提亚斯回报。‡等待葛瑞格·萊斯科瓦領主和『沉默之刃』馬爾松在花園裡的對話結束，殺死他們兩個，之後向暴風城的提亞斯回報。',
  }
},
[435] = {
  {
    'Uma escolta para Orlando‡Сопровождая Эрланда‡Eskorte für Erland‡엘런드 경호‡Escolta a Erland‡Escolta a Erland‡Une escorte pour Erland‡护送埃兰德‡護送埃蘭德',
    nil,
    'Escolte Orlando a salvo dos lobos até encontrar-se com Rane Yorick.‡Проводите Эрланда, защищая его от волков, к Ран Йорик.‡Begleitet Erland durch die Wölfe hindurch zu Rane Yorick.‡레인 요릭이 있는 곳까지 늑대들을 물리치고 엘런드를 경호해야 합니다.‡Escolta a Erland a través de los lobos, hasta llegar a Rane Yorick.‡Escolta a Erland a través de los lobos, hasta llegar a Rane Yorick.‡Escorter Erland jusqu\'à Rane Yorick.‡护送亡灵哨兵埃兰德避过群狼，直到他找到兰妮·尤瑞克。‡護送亡靈哨兵埃蘭德避過群狼，直到他找到蘭妮·尤瑞克。',
  }
},
[436] = {
  {
    'Sítio de Escavação de Bandaferro‡Раскопки Сталекрута‡Eisenbands Ausgrabungsstätte‡아이언밴드의 발굴 현장‡La Excavación de Vetaferro‡La excavación de Vetaferro‡Les fouilles de Baguefer‡铁环挖掘场‡鐵環挖掘場',
    nil,
    'Fale com o Explorador Machadeiro.‡Обратитесь к исследователю Удару Топора.‡Sprecht mit Forscher Todesstreich.‡탐험가 펠휴와 대화하십시오.‡Habla con el expedicionario Ceñimal.‡Habla con el explorador Ceñimal.‡Parler à l\'Explorateur Tombebranche.‡和麦格玛尔·落斧谈一谈。‡和麥格瑪爾·落斧談話。',
  }
},
[437] = {
  {
    'Os Campos Estéreis‡Мертвое поле‡Das Todesfeld‡죽음의 농장‡El Campo Muerto‡El Campo Muerto‡Le Champ des morts‡亡者农场‡亡者農場',
    nil,
    'Mate gnolls Putricouro nos Campos Estéreis.nnQuando Vergasta aparecer, mate-a.nnLeve a Essência de Vergasta para o Alto-executor Hadrec no Sepulcro.‡Убивайте гноллов из стаи Гнилошкуров на Мертвом поле. nnКогда появится банши Плеть Ночи, убейте ее. nnСущность банши принесите верховному палачу Хадрику в Гробницу.‡Tötet Gnolle der Moderfelle auf dem Todesfeld.nnSobald Nachtseele auftaucht, tötet sie ebenfalls.nnBringt Nachtseeles Essenz zu Hochexekutor Hadrec beim Grabmal.‡죽음의 농장에서 썩은가죽 놀들을 처치하십시오. 나이트래쉬가 나타나면 그녀를 처치하십시오.nn공동묘지에 있는 고위집행관 하드렉에게 나이트래쉬의 정수를 가져가야 합니다.‡Mata gnolls Putrepellejo en El Campo Muerto.nnCuando aparezca Latipesadilla, mátala.nnLleva la esencia de Latipesadilla al sumo ejecutor Hadrec en El Sepulcro.‡Mata gnolls Putrepellejo en El Campo Muerto.|nCuando aparezca Latipesadilla, mátala.|nLleva la esencia de Latipesadilla al sumo ejecutor Hadrec en El Sepulcro.‡Tuer des gnolls Poils-putrides au Champ des morts.nnDétruire Cinglenuit quand elle apparaît.nnRapporter son essence au Grand exécuteur Hadrec au Sépulcre.‡清剿亡者农场的腐皮豺狼人。nn当奈塔拉什出现时，把她也杀掉。nn将奈塔拉什的灵魂带给瑟伯切尔的高级执行官哈德瑞克。‡殺死亡者農場的腐皮豺狼人。|n當奈塔拉什出現時，把她也殺了。|n將奈塔拉什的靈魂交給瑟伯切爾的高級執行官哈德瑞克。',
  }
},
[438] = {
  {
    'Os Campos Apodrecidos‡Старая переправа‡Die verfallene Fähre‡오래된 나루터‡El Viejo Embarcadero‡El Viejo Embarcadero‡Le bac délabré‡破旧渡口‡',
    nil,
    'Vá aos Campos Apodrecidos.nnDescubra o motivo pelo qual o Flagelo está lá.‡Отправляйтесь к старой переправе. nnПоищите причину присутствия там сил Плети.‡Geht zur verfallenen Fähre.nnSucht nach dem Grund, warum die Geißel dort ist.‡오래된 나루터로 가서 그곳에 스컬지가 주둔한 이유를 찾아내야 합니다.‡Ve a El Viejo Embarcadero.nnEncuentra la razón por la que la Plaga está ahí.‡Ve a El Viejo Embarcadero.|nEncuentra la razón por la que la Plaga está ahí.‡Aller au bac délabré.nnChercher la raison de la présence du Fléau.‡到破旧渡口去，找到天灾军团占据那里的理由。‡',
  }
},
[439] = {
  {
    'Pistas dos Putricouro‡Необычная находка‡Auf den Spuren der Moderfelle‡썩은가죽일족의 단서‡Pistas de Putrepellejos‡Pistas de Putrepellejos‡Un indice vers les Poils-putrides‡线索‡',
    nil,
    'Leve o Anel de Deliah para o Alto-executor Hadrec no Sepulcro.‡Принесите кольцо Делии верховному палачу Хадрику в Гробницу.‡Bringt Deliahs Ring zu Hochexekutor Hadrec beim Grabmal.‡공동묘지에 있는 고위집행관 하드렉에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah al sumo ejecutor Hadrec en El Sepulcro.‡Lleva el anillo de Deliah al sumo ejecutor Hadrec en El Sepulcro.‡Rapporter la Bague de Deliah au Grand exécuteur Hadrec au Sépulcre.‡将黛丽娅的戒指带给瑟伯切尔的高级执行官哈德瑞克。‡',
  }
},
[440] = {
  {
    'O anel gravado‡Кольцо с гравировкой‡Der gravierte Ring‡문자가 새겨진 반지‡El anillo grabado‡El anillo grabado‡L\'anneau ciselé‡黛丽娅的戒指‡黛麗婭的戒指',
    nil,
    'Leve o Anel de Deliah para o Magistrado Sevren em Montalvo.‡Отнесите кольцо Делии мировому судье Севрену в Брилл.‡Bringt Deliahs Ring zu Magistrat Sevren nach Brill.‡브릴에 있는 집정관 세브렌에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah al magistrado Sevren en Rémol.‡Lleva el anillo de Deliah al magistrado Sevren en Rémol.‡Ramener la Bague de Deliah au Magistrat Sevren à Brill.‡将黛丽娅的戒指带给布瑞尔的执政官塞弗伦。‡將黛麗婭的戒指帶給布瑞爾的執政官塞弗倫。',
  }
},
[441] = {
  {
    'Olavo e a Cidade Baixa‡Роли, который живет в Подгороде‡Raleigh und Unterstadt‡랠리와 언더시티‡Raleigh y Entrañas‡Raleigh y Entrañas‡Raleigh et Undercity‡拉林夫与幽暗城‡拉林夫與幽暗城',
    nil,
    'Leve o Anel de Deliah para Olavo.‡Отнесите Роли кольцо Делии.‡Bringt Deliahs Ring zu Raleigh.‡랠리에게 델리아의 반지를 가져가야 합니다.‡Lleva el anillo de Deliah a Raleigh.‡Lleva el anillo de Deliah a Raleigh.‡Apporter la Bague de Deliah à Raleigh.‡把黛丽娅的戒指交给拉林夫。‡把黛麗婭的戒指交給拉林夫。',
  }
},
[442] = {
  {
    'Ataque à Ilha de Fenris‡Атака на остров Фенриса‡Sturm auf die Insel Fenris‡펜리스 섬 공격‡Asalto a la Isla de Fenris‡Asalto a la Isla de Fenris‡L\'attaque de l\'île de Fenris‡突袭芬里斯岛‡突襲芬里斯島',
    nil,
    'Leve a Cabeça de Thule para o Alto-executor Hadrec no Sepulcro.‡Принесите верховному палачу Хадрику в поселении Гробница голову Тула Когтя Ворона.‡Bringt Hochexekutor Hadrec auf dem Grabmal Thules Kopf.‡공동묘지에 있는 고위집행관 하드렉에게 쑤울의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Thule al sumo ejecutor Hadrec en El Sepulcro.‡Lleva la cabeza de Thule al sumo ejecutor Hadrec en El Sepulcro.‡Rapporter la Tête de Thule au Grand exécuteur Hadrec au Sépulcre.‡将图勒的头颅带回给瑟伯切尔的高级执行官哈德瑞克。‡將圖勒的頭顱帶回給瑟伯切爾的高級執行官哈德瑞克。',
  }
},
[443] = {
  {
    'Linfa de Putricouro‡Лимфа Гнилошкуров‡Moderfellsekret‡썩은가죽일족의 영액‡Icor de Putrepellejo‡Icor de Putrepellejo‡L\'ichor de Poil-putride‡腐皮豺狼人的脓液‡腐皮豺狼人的膿液',
    nil,
    'Leve 8 garrafas de Linfa de Putricouro para o Boticário Renferrel no Sepulcro.‡Принесите 8 бутылок лимфы Гнилошкуров аптекарю Ренферрелу рядом с Гробницей.‡Bringt 8 Flaschen Moderfellsekret zu Apotheker Renferrel beim Grabmal.‡공동묘지에 있는 연금술사 렌퍼럴에게 썩은가죽일족의 영액 8병을 가져가야 합니다.‡Lleva 8 botellas de icor de Putrepellejo al boticario Renferrel en El Sepulcro.‡Lleva 8 botellas de icor de Putrepellejo al boticario Renferrel en El Sepulcro.‡Rapporter 8 bouteilles d\'Ichor de Poil-putride à l\'apothicaire Renferrel.‡给瑟伯切尔的药剂师伦弗利尔带去8瓶腐皮豺狼人的脓液。‡給瑟伯切爾的藥劑師倫弗利爾帶去8瓶腐皮豺狼人的膿液。',
  }
},
[444] = {
  {
    'A origem dos Putricouro‡Происхождение Гнилошкуров‡Die Ursprünge der Moderfelle‡썩은가죽일족의 기원‡El origen de los Putrepellejos‡El origen de los Putrepellejos‡L\'origine des Poils-putrides‡腐皮豺狼人的产生‡',
    nil,
    'Leve a Amostra de Linfa para Boanerges Stalactus, na Cidade Baixa.‡Отнесите образец лимфы Бетору Ледострелу в Подгород.‡Bringt die Sekretprobe zu Bethor Eismacht nach Unterstadt.‡언더시티에 있는 베소르 아이스샤드에게 영액 견본을 가져가야 합니다.‡Lleva la muestra de icor a Bethor Duroyelo en Entrañas.‡Lleva la muestra de icor a Bethor Duroyelo en Entrañas.‡Apporter l\'Échantillon d\'ichor à Bethor Glacéclat à Fossoyeuse.‡将脓液样本交给幽暗城的比索·埃斯沙德。‡',
  }
},
[445] = {
  {
    'Entrega na Floresta de Pinhaprata‡Доставка в Серебряный бор‡Lieferung in den Silberwald‡은빛소나무 숲으로의 배달‡Entrega a Bosque de Argénteos‡Entrega a Bosque de Argénteos‡Livraison dans la forêt des Pins argentés‡给银松森林送信‡給銀松森林送信',
    nil,
    'Leve as descobertas do Boticário Joaquino ao Boticário Renferrel na Floresta de Pinhaprata.‡Отнесите находки аптекаря Юхана аптекарю Ренферрелу в Серебряном бору.‡Bringt Apotheker Johaans Erkenntnisse zu Apotheker Renferrel im Silberwald.‡은빛소나무 숲에 있는 연금술사 렌퍼럴에게 요한의 연구 결과를 전달해야 합니다.‡Llévale las conclusiones del boticario Johaan al boticario Renferrel del Bosque de Argénteos.‡Llévale los descubrimientos del boticario Holland al boticario Renferrel del Bosque de Argénteos.‡Apporter les découvertes de l\'apothicaire Johaan à l\'Apothicaire Renferrel dans la forêt des Pins argentés.‡将药剂师乔汉的研究成果带给银松森林的药剂师伦弗利尔。‡將藥劑師喬漢的研究成果帶給銀松森林的藥劑師倫弗利爾。',
  }
},
[446] = {
  {
    'Thule Corvinalle‡Тул Коготь Ворона‡Thule Rabenklaue‡까마귀발톱 쑤울‡Thule Corvozarpa‡Thule Corvozarpa‡Thule Ravenclaw‡图勒·鸦爪‡圖勒·鴉爪',
    nil,
    'Leve o Pergaminho de Boanerges para o Boticário Renferrel no Sepulcro de Pinhaprata.‡Отнесите свиток Бетора аптекарю Ренферрелу в Серебряный бор, в селение Гробница.‡Bringt Bethors Rolle zu Apotheker Renferrel beim Grabmal im Silberwald.‡은빛소나무 숲 공동묘지에 있는 연금술사 렌퍼럴에게 베소르의 두루마리를 가져가야 합니다.‡Lleva el pergamino de Bethor al boticario Renferrel en El Sepulcro de Argénteos.‡Lleva el pergamino de Bethor al boticario Renferrel en El Sepulcro de Argénteos.‡Porter le parchemin de Bethor à l\'Apothicaire Renferrel au Sépulcre des Pins argentés.‡把比索的卷轴交给银松森林中的药剂师伦弗利尔。‡',
  }
},
[447] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡致命的配方‡致命配方',
    nil,
    'Colete 6 Corações de Urso Cinzento e 6 amostras de Sangue de Pateante e leve-os para o Mestre-boticário Faranello na Cidade Baixa.‡Соберите 6 сердец медведя и 6 образцов Летящей крови и принесите их мастеру-аптекарю Фаранеллу в Подгород.‡Sammelt 6 Herzen von ergrauten Bären und 6 Proben Huschendes Blut und bringt diese zu Apothekermeister Faranell nach Unterstadt.‡불곰 심장 6개와 땅거미 점액 6개를 모아 언더시티에 있는 수석 연금술사 파라넬에게 가져가야 합니다.‡Consigue 6 corazones de oso grisáceo y 6 muestras de sangre de celearácnida, y llévaselas al maestro boticario Faranell en Entrañas.‡Consigue 6 corazones de oso grisáceo y 6 muestras de sangre de celerácnida y llévaselas al maestro boticario Faranell en Entrañas.‡Se rendre au Grouillement et y collecter 6 Cœurs de vieil ours et 6 échantillons de Sang du Grouillement, puis les apporter au maître apothicaire Faranell de la Société royale des apothicaires, à Fossoyeuse.‡收集6个灰熊的心脏和6份粘稠的血液样本，并将这些东西送给幽暗城的大药剂师法拉尼尔。‡收集6個灰熊的心臟和6份粘稠的血液樣本，並將這些東西送給幽暗城的大藥劑師法拉尼爾。',
  }
},
[448] = {
  {
    'Relatório para Hadrec‡Доложиться Хадрику‡Meldung bei Hadrec‡하드렉에게 보고‡Preséntate ante Hadrec‡Preséntate ante Hadrec‡Un rapport pour Hadrec‡给哈德瑞克的报告‡',
    nil,
    'Apresente-se ao Alto-executor Hadrec no Sepulcro.‡Доложите о себе верховному палачу Хадрику в поселении Гробница.‡Meldet Euch bei Hochexekutor Hadrec auf dem Grabmal.‡공동묘지에 있는 고위집행관 하드렉에게 보고해야 합니다.‡Preséntate ante el sumo ejecutor Hadrec en El Sepulcro.‡Preséntate ante el sumo ejecutor Hadrec en El Sepulcro.‡Faire un rapport au Grand exécuteur Hadrec au Sépulcre.‡向瑟伯切尔的高级执行官哈德瑞克复命。‡',
  }
},
[449] = {
  {
    'Relatório dos Sicários‡Отчет стражей смерти‡Der Bericht der Todespirscher‡죽음의추적자의 보고‡El informe de los Mortacechadores‡El informe de los Mortacechadores‡Le rapport des Traqueurs noirs‡亡灵哨兵的报告‡亡靈哨兵的報告',
    nil,
    'Apresente o Relatório do Sicário ao Alto-executor Hadrec no Sepulcro.‡Отнесите отчет стражей смерти верховному палачу Хадрику в Гробницу.‡Bringt den Todespirscherbericht zu Hochexekutor Hadrec beim Grabmal.‡공동묘지에 있는 고위집행관 하드렉에게 죽음의추적자 보고서를 가져가야 합니다.‡Lleva el informe de Mortacechador al sumo ejecutor Hadrec en El Sepulcro.‡Lleva el informe de los Mortacechadores al sumo ejecutor Hadrec en El Sepulcro.‡Apporter le rapport du Nécrotraqueur au Grand exécuteur Hadrec au Sépulcre.‡将亡灵哨兵的报告的报告交给瑟伯切尔的高级执行官哈德瑞克。‡將亡靈哨兵的報告的報告交給瑟伯切爾的高級執行官哈德瑞克。',
  }
},
[450] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡致命的配方‡',
    nil,
    'Recupere o Diário do Boticário Berardo em Vilarejo Lenhardente e leve-o ao Boticário Renferrel no Sepulcro.‡Найдите в деревне Погребальных Костров записи Берарда и отнесите их в Гробницу аптекарю Ренферрелу.‡Bergt Apotheker Berards Tagebuch aus Lohenscheit und bringt es zu Apotheker Renferrel beim Grabmal.‡장작나무 마을에서 베랄드의 일지를 찾아 공동묘지에 있는 연금술사 렌퍼럴에게 가져가야 합니다.‡Recupera el Diario del boticario Berard de la Aldea Piroleña y llévaselo al boticario Renferrel en El Sepulcro.‡Recupera el Diario del boticario Berard de la Aldea Piroleña y llévaselo al boticario Renferrel en El Sepulcro.‡Récupérer le Journal de Berard à l\'Auberge de Bois-du-Bûcher et le rapporter à l\'apothicaire Renferrel au Sépulcre.‡从焚木村的旅店中找到伯纳德的日记，把它交给瑟伯切尔的药剂师伦弗利尔。‡',
  }
},
[451] = {
  {
    'Receita mortal‡Рецептура смерти‡Rezept für den Tod‡죽음의 비법‡Una fórmula mortal‡Una fórmula mortal‡Une recette mortelle‡致命的配方‡',
    nil,
    'Leve 6 amostras de Musgo de Rastejante do Lago, 6 amostras de Musgo de Sorrateiro do Lago e um Tumor Endurecido para o Mestre-boticário Faranello na Cidade Baixa.‡Принесите 6 образцов мха озерного ползуна, 6 образцов мха озерного тихохода и твердую опухоль мастеру-аптекарю Фаранеллу в Подгород.‡Bringt 6 Proben Seeschleichermoos, 6 Proben Seekrabblermoos und einen verhärteten Tumor zu Apothekermeister Faranell nach Unterstadt.‡호수늪지이끼 6개, 호수덤불이끼 6개, 그리고 굳어진 종양 1개를 언더시티에 있는 수석 연금술사 파라넬에게 가져가야 합니다.‡Lleva 6 muestras de musgo de trepador del Lago, 6 muestras de musgo de vagador del Lago y un tumor endurecido al maestro boticario Faranell en Entrañas.‡Lleva 6 muestras de moho de trepador del Lago, 6 muestras de moho de vagador del Lago y un tumor endurecido al maestro boticario Faranell en Entrañas.‡Apporter 6 échantillons de Mousse de Rampant lacustre, 6 échantillons de Mousse de Furtif lacustre et une Tumeur durcie au Maître apothicaire Faranell à Fossoyeuse.‡收集6份湖岸爬行者苔藓的样本、6份湖岸潜藏者苔藓的样本和1块硬瘤，把它们交给幽暗城的大药剂师法拉尼尔。‡',
  }
},
[452] = {
  {
    'Emboscada de Lenhardente‡Засада в деревне‡Hinterhalt in Lohenscheit‡장작나무 마을 매복‡La emboscada de Aldea Piroleña‡La emboscada de Aldea Piroleña‡Embuscade à Bois-du-Bûcher‡焚木村中的伏击‡焚木村中的伏擊',
    nil,
    'Ajude a Sicária Fabiana a eliminar o Conselho de Lenhardente.‡Помогите стражу смерти Фарлии уничтожить совет деревни Погребальных Костров.‡Helft Todespirscherin Faerleia, den Rat von Lohenscheit zu töten.‡죽음의추적자 페를레이아를 도와 장작나무 마을 원로원들을 처치해야 합니다.‡Ayuda al mortacechador Faerleia a destruir al Consejo de Piroleña.‡Ayuda a la mortacechadora Faerleia a destruir al Consejo Piroleña.‡Aider le Nécrotraqueur Faerleia à tuer les membres du Conseil de Bois-du-Bûcher.‡帮助亡灵哨兵费雷亚消灭焚木村议会。‡幫助亡靈哨兵費雷亞消滅焚木村議會。',
  }
},
[453] = {
  {
    'À procura do Vulto Sombrio‡Поиски таинственного незнакомца‡Auf der Suche nach der Schattengestalt‡의문의 남자 찾기‡Encuentra a la figura‡Encuentra la figura misteriosa‡À la recherche de l\'Obscure Silhouette‡搜寻乌鸦岭‡搜尋烏鴉嶺',
    nil,
    'Encontre o Vulto Sombrio. Suas pistas:nnEle não é nativo de Vila Sombria.nnÉ uma pessoa nervosa e agitada.nnEle deixou Vila Sombria e seguiu para o oeste.‡Отыщите незнакомца. Его приметы:nnОн родом не из Темнолесья.nnОн – нервный тип.nnОн сбежал из Темнолесья и двинулся на запад.‡Findet die Schattengestalt. Eure Hinweise:nnEr stammt nicht aus Dunkelhain.nnEr ist eine nervöse, hektische Person.nnEr verließ Dunkelhain und ging nach Westen.‡의문의 남자를 찾으십시오. 지금까지 얻은 단서는 다음과 같습니다.nn다크샤이어에서 태어난 사람이 아닙니다.n신경질적이고 신경과민인 사람입니다.n다크샤이어를 떠나 서쪽으로 갔습니다.‡Encuentra a la figura misteriosa. Las pistas que tienes: nnNo es oriundo de Villa Oscura. nnEs una persona nerviosa, que se altera fácilmente. nnDejó Villa Oscura y se dirigió al oeste.‡Encuentra a la figura misteriosa. Las pistas que tienes:|nNo es oriundo de Villa Oscura.|nEs una persona nerviosa, que se altera fácilmente.|nDejó Villa Oscura y se dirigió al oeste.‡Retrouver l\'Obscure silhouette. Indices :nnIl n\'est pas né à Sombre-comté.nnC\'est un individu nerveux et craintif.nnIl a quitté Sombre-comté pour faire route vers l\'ouest.‡找到那个模糊的人影。你的线索：nn他不是夜色镇的本地人。nn他是个紧张而敏感的人。nn他离开夜色镇往西边去了。‡找到那個模糊的人影。你的線索:|n他不是夜色鎮的本地人。|n他是個緊張而敏感的人。|n他離開夜色鎮往西邊去了。',
  }
},
[454] = {
  {
    'O rescaldo da emboscada‡После засады‡Nach dem Hinterhalt‡훌다르와 미란‡Tras la emboscada‡Tras la emboscada‡Après l\'embuscade‡恶战之后‡',
    nil,
    'Fale com Miran.‡Поговорите с Мираном.‡Sprecht mit Miran.‡미란과 대화해야 합니다.‡Habla con Miran.‡Habla con Miran.‡Parler à Miran.‡和米兰谈一谈。‡',
  }
},
[455] = {
  {
    'Sufoco em Algaz‡Альгазская битва‡Der Algaz-Spießrutenlauf‡알가즈의 위기‡El asedio de Algaz‡El asedio de Algaz‡Le défi d\'Algaz‡丹奥加兹告急‡丹奧加茲告急',
    nil,
    'Atravesse Dun Algaz.nnMate 8 Batedores Presa do Dragão e 6 Brutos Presa do Dragão.nnApresente-se a Valstag Ferroqueixo no Porto de Menethil.‡Пройдите через Дун Альгаз.nnУбейте 8 разведчиков из клана Драконьей Пасти и 6 рубак из клана Драконьей Пасти.nnОб исполнении доложите Валстагу Сталезубу в Гавани Менетилов.‡Durchquert Dun Algaz.nnTötet 8 Späher des Drachenmals und 6 Grunzer des Drachenmals.nnMeldet Euch bei Valstag Eisenkiefer im Hafen von Menethil.‡던 알가즈를 가로질러 가야 합니다.nn용아귀부족 정찰병 8명과 용아귀부족 그런트 6명을 처치해야 합니다.nn메네실 항구에 있는 발스탁 아이언조에게 보고하십시오.‡Atraviesa Dun Algaz.nnMata 8 exploradores Faucedraco y 6 brutos Faucedraco.nnInforma a Valstag Quijahierro del Puerto de Menethil.‡Atraviesa Dun Algaz.|nMata 8 exploradores Faucedraco y 6 brutos Faucedraco.|nInforma a Valstag Quijahierro de Puerto de Menethil.‡Traverser Dun Algaz.nnTuer 8 Eclaireurs Gueules-de-dragon et 6 Grunts Gueules-de-dragon.nnFaites votre rapport à Valstag Gueule-de-fer au port de Menethil.‡翻越丹奥加兹。nn杀死8个龙喉斥候和6个龙喉步兵。nn向米奈希尔港的瓦斯塔格·铁腭报到。‡翻越丹奧加茲。|n殺死8個龍喉斥候和6個龍喉蠻兵。|n向米奈希爾港的瓦斯塔格·鐵顎報到。',
  }
},
[456] = {
  {
    'O equilíbrio da natureza‡Природное равновесие‡Das Gleichgewicht der Natur‡자연의 균형‡El equilibrio de la naturaleza‡El equilibrio de la naturaleza‡L\'Equilibre de la nature‡自然的平衡‡自然的平衡',
    nil,
    'Mate 7 Sabres-da-noite Jovens e 4 Javalis-espinho Jovens e fale novamente com o Conservador Ilthalaine.‡Убейте 7 молодых ночных саблезубов и 4 молодых щетинистых вепрей и вернитесь к Опекуну Илталайну.‡Tötet 7 junge Nachtsäbler sowie 4 junge Disteleber und kehrt dann zu Konservator Ilthalaine zurück.‡새끼 흑호 7마리와 새끼 엉겅퀴멧돼지 4마리를 처치한 다음 관리인 일사레인에게 돌아가십시오.‡Mata 7 sables de la noche jóvenes y 4 jóvenes jabalíes cardo, y ve a ver al conservador Ilthalaine.‡Mata a 3 sables de la noche y 3 jabalíes cardo jóvenes.‡Tuer 7 Jeunes sabres-de-nuit et 4 Jeunes sangliers des chardons, puis retournez voir le Conservateur Ilthalaine.‡杀死7只夜刃豹幼崽和4只草刺野猪幼崽，然后向管理员伊尔萨莱恩复命。‡殺死7隻小夜刃豹和4隻小草刺野豬，然後向管理員伊爾薩萊恩覆命。',
  }
},
[457] = {
  {
    'O equilíbrio da natureza‡Природное равновесие‡Das Gleichgewicht der Natur‡자연의 균형‡El equilibrio de la naturaleza‡El equilibrio de la naturaleza‡L\'Equilibre de la nature‡自然的平衡‡自然的平衡',
    nil,
    'O Conservador Ilthalaine precisa que você mate 7 Sabres-da-noite Sarnentos e 7 Javalis-espinho.‡Опекун Илталайн хочет, чтобы вы убили 7 облезлых ночных саблезубов и 7 щетинистых вепрей.‡Konservator Ilthalaine verlangt von Euch, 7 räudige Nachtsäbler und 7 Disteleber zu töten.‡관리인 일사레인이 병든 흑호 7마리와 엉겅퀴멧돼지 7마리를 처치해 달라고 부탁했습니다.‡El conservador Ilthalaine quiere que mates 7 sables de la noche sarnosos y 7 jabalíes cardo.‡El conservador Ilthalaine quiere que mates 5 sables de la noche sarnosos y 5 jabalíes cardo.‡Le Conservateur Ilthalaine voudrait que vous tuiez 7 Sabres-de-nuit galeux et 7 Sangliers des chardons.‡管理员伊尔萨莱恩要求你杀死7只癞皮夜刃豹和7只草刺野猪。‡管理員伊爾薩萊恩要求你殺死7隻癩皮夜刃豹和7隻草刺野豬。',
  }
},
[458] = {
  {
    'A protetora dos bosques‡Защитница леса‡Die Beschützerin des Waldlandes‡숲의 수호자‡La protectora de los bosques‡La protectora de los bosques‡La Protectrice sylvestre‡森林守护者‡森林保衛者',
    nil,
    'Procure a dríade conhecida como Tarindrella.‡Найдите дриаду по имени Тариндрелла.‡Sucht die Dryade, die als Tarindrella bekannt ist.‡타린드렐라라고 하는 드리아드를 찾아야 합니다.‡Busca a la dríade Tarindrella.‡Busca a la dríade Tarindrella.‡Chercher la dryade connue sous le nom de Tarindrella.‡找到树妖塔琳德拉。‡找到林精塔琳德拉。',
  }
},
[459] = {
  {
    'A protetora dos bosques‡Защитница леса‡Die Beschützerin des Waldlandes‡숲의 수호자‡La protectora de los bosques‡La protectora de los bosques‡La Protectrice sylvestre‡森林守护者‡森林保衛者',
    nil,
    'Colete 8 Limos Vis e leve-os para Tarindrella.‡Соберите 8 порций мха Скверны и принесите их Тариндрелле.‡Sammelt 8 Stücke Teufelsmoos und bringt sie zu Tarindrella.‡악마의 이끼 8개를 모아 타린드렐라에게 가져가야 합니다.‡Lleva 8 muestras de musgovil a Tarindrella.‡Lleva 8 muestras de musgovil a Tarindrella.‡Collecter 8 Gangremousses et les rapporter à Tarindrella.‡收集8块魔苔，把它们交给塔琳德拉。‡收集8塊魔苔，把它們交給塔琳德拉。',
  }
},
[460] = {
  {
    'Descanse em pedaços‡В целости и сохранности‡In Stücken begraben‡분리된 몸과 머리‡Descansar en piezas‡Descansar en piezas‡Reposer en... pièces‡支离破碎‡支離破碎',
    nil,
    'Leve a Cabeça de Alaric ao seu túmulo.‡Отнесите голову Аларика на его могилу.‡Bringt Alarics Kopf zu seinem Grab.‡알라리크의 머리를 그의 무덤으로 데려가야 합니다.‡Lleva la cabeza de Alaric a su tumba.‡Lleva la cabeza de Alaric a su tumba.‡Apporter la tête d\'Alaric jusqu\'à sa tombe.‡将奥拉瑞克的头颅带到他的坟墓旁。‡將奧拉瑞克的頭顱帶到他的墳墓旁。',
  }
},
[461] = {
  {
    'O nicho escondido‡Замаскированный тайник‡Die versteckte Nische‡비밀 벽감‡El nicho oculto‡El nicho oculto‡L\'alcôve secrète‡密室‡隱匿之處',
    nil,
    'Leve Alaric para a alcova escondida.‡Отнесите Аларика к замаскированной нише.‡Bringt Alaric zur versteckten Nische.‡알라리크를 비밀 벽감으로 데려가야 합니다.‡Lleva a Alaric al nicho oculto.‡Lleva a Alaric al nicho oculto.‡Amener Alaric à l\'alcôve secrète.‡将奥拉瑞克带到密室去。‡將奧拉瑞克帶到密室去。',
  }
},
[462] = {
