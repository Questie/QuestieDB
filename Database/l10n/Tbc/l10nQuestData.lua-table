[8397] = {
  {
    'Reivindicando a Bacia Arathi‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin d\'Arathi‡占领阿拉希盆地‡戰爭的動力',
    nil,
    '‡Принесите 3 почетных знака Низины Арати бригадному генералу Альянса рядом со входом на поля боя.‡Der Krieg gegen die Horde verbraucht zusehends unsere Vorräte, <Name>. Es ist lebenswichtig, dass wir die Kontrolle über das Arathibecken halten können, um den Ressourcennachschub für unsere Kriegsproduktion aufrechtzuerhalten! Unsere Truppen im Arathibecken können jederzeit Eure Hilfe brauchen.‡전장 밖에 있는 얼라이언스 준장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡La guerre contre la Horde diminue rapidement nos réserves, <nom>. Il est vital que nous conservions le contrôle du bassin d\'Arathi pour que les ressources continuent à nous arriver ! Êtes-vous déjà venu nous donner un coup de main en Arathi ?‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡',
  }
},
[8398] = {
  {
    'Reivindicando a Bacia Arathi‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡아라시 분지 공격‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin d\'Arathi‡占领阿拉希盆地‡戰爭的動力',
    nil,
    '‡У нас подходят к концу все припасы, Луверн. Нам не выстоять против Орды, если мы не захватим Низину Арати. Эта низина – настоящая кладовая природы. Ты уже внес свой вклад в борьбу за нее?‡Der Krieg gegen die Horde verbraucht zusehends unsere Vorräte, <Name>. Es ist lebenswichtig, dass wir die Kontrolle über das Arathibecken halten können, um den Ressourcennachschub für unsere Kriegsproduktion aufrechtzuerhalten! Unsere Truppen im Arathibecken können jederzeit Eure Hilfe brauchen.‡호드와의 오랜 전쟁으로 인해 물자가 급속도로 바닥나고 있네. 지속적인 자원 공급을 위해서는 아라시 분지를 우리 손에 넣는 것이 매우 중요하네! 얼라이언스를 위하여 아라시 분지에는 다녀온 건가?‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡La guerre contre la Horde diminue rapidement nos réserves, <nom>. Il est vital que nous conservions le contrôle du bassin d\'Arathi pour que les ressources continuent à nous arriver ! Êtes-vous déjà venu nous donner un coup de main en Arathi ?‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡',
  }
},
[8399] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Warsong‡战歌峡谷之战‡自然屏障',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de Garganta Grito de Guerra a un Brigadier general de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8400] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡战歌峡谷之战‡自然屏障',
