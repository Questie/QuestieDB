[64063] = {
  {
    'Portal Negro‡Темный портал‡Das Dunkle Portal‡‡El Portal Oscuro‡‡La Porte des ténèbres‡黑暗之门‡黑暗之門',
    nil,
    'Fale com o Senhor da Guerra Dar\'tun na Barreira do Inferno. Ele aguarda você junto ao Portal Negro.‡Поговорите с полководцем Дар\'туном в Выжженных землях. Он ждет вас у Темного портала.‡Macht Kriegsherr Dar\'toon ausfindig. Er erwartet Eure Ankunft vor dem Dunklen Portal.‡‡Busca al Señor de la Guerra Dar\'toon en Las Tierras Devastadas. Espera tu llegada frente al Portal Oscuro.‡‡Trouvez le Seigneur de guerre Dar’toon dans les terres Foudroyées. Il attend votre arrivée près de la Porte des ténèbres.‡找到诅咒之地的督军达图恩。他就在黑暗之门前等你。‡到詛咒之地向督軍達圖恩報到。他在黑暗之門前等你。',
  }
},
[64064] = {
  {
    'Terras Pestilentas Orientais‡Восточные Чумные земли‡Östliche Pestländer‡동부 역병지대‡Las Tierras de la Peste del Este‡‡Maleterres de l’Est‡东瘟疫之地‡The Dark Portal',
    nil,
    'Vá até as Terras Pestilentas Orientais e fale com Leonid Bartolomeu. Ele aguarda sua chegada na Capela Esperança da Luz.‡Отправляйтесь в Восточные Чумные земли и поговорите с лордом Барталомеем. Он ждет вас в часовне Последней Надежды.‡Reist in die Östlichen Pestländer und macht Leonidas Bartholomäus ausfindig. Er erwartet Eure Ankunft in der Kapelle des Hoffnungsvollen Lichts.‡동부 역병지대로 이동한 뒤 희망의 빛 예배당에서 당신의 도착을 기다리고 있는 리어니드 바돌로매를 찾아야 합니다.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Te está esperando en la Capilla de la Esperanza de la Luz.‡‡Rendez-vous dans les Maleterres de l’Est et trouvez Leonid Barthalomew. Il vous attend à la Chapelle de l’Espoir de Lumière.‡前往东瘟疫之地，找到莱尼德·巴萨罗梅。他在圣光之愿礼拜堂等你。‡Travel to the Blasted Lands and find Watch Warlord Dar\'toon. He awaits your arrival before the Dark Portal at the Blasted Lands.',
  }
},
[64139] = {
  {
    '‡‡‡‡‡‡‡‡莉雅德倫女士召見',
    nil,
    '‡‡‡‡‡‡‡‡在銀月城和莉雅德倫交談。',
  }
},
[64140] = {
  {
    '‡‡‡‡‡‡‡‡大師之路',
    nil,
    '‡‡‡‡‡‡‡‡再和莉雅德倫女士談談以接受她的推薦。',
  }
},
[64141] = {
  {
    '‡‡‡‡‡‡‡‡承諾的手勢',
    nil,
    '‡‡‡‡‡‡‡‡帶40塊符文布，6個奧金錠，10根太陽草，5個黑暗符文和150金幣給銀月城的莉雅德倫女士。',
  }
},
[64143] = {
  {
    '‡‡‡‡‡‡‡‡聖光真正的主人',
    nil,
    '‡‡‡‡‡‡‡‡銀月城的莉雅德倫女士要你幫她帶來提爾之手聖水。',
  }
},
[64217] = {
  {
    '‡Темный портал‡Das Dunkle Portal‡‡El Portal Oscuro‡‡‡黑暗之门‡',
    nil,
    '‡Поговорите с полководцем Дар\'туном в Выжженных землях. Он ждет вас у Темного портала.‡Macht Kriegsherr Dar\'toon ausfindig. Er erwartet Eure Ankunft vor dem Dunklen Portal.‡‡Busca al Señor de la Guerra Dar\'toon en Las Tierras Devastadas. Espera tu llegada frente al Portal Oscuro.‡‡‡找到诅咒之地的督军达图恩。他就在黑暗之门前等你。‡',
  }
}
