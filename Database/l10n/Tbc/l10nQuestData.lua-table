[463] = {
  {
    'O Verdião‡Страж Природы‡Der Sumpfhüter‡신록의수호자‡El Guardaverde‡El Guardaverde‡Le Gouverneur vert‡绿色守卫者‡綠色守衛者',
    nil,
    'Encontre o Verdião.‡Найдите Зеленого Стража.‡Findet den Sumpfhüter.‡신록의수호자를 찾아야 합니다.‡Encuentra al Guardaverde.‡Encuentra al Guardaverde.‡Trouver le Gouverneur vert.‡找到绿色守卫者。‡找到綠色守衛者。',
  }
},
[464] = {
  {
    'Estandartes de guerra‡Боевые знамена‡Kriegsflaggen‡전쟁 깃발‡Estandartes de batalla‡Estandartes de batalla‡Bannières de guerre‡龙喉战旗‡龍喉戰旗',
    nil,
    'Leve 8 Estandartes de Guerra Presa do Dragão para o Capitão Punhoforte.‡Принесите 8 боевых знамен клана Драконьей Пасти капитану Крепкому Кулаку.‡Bringt Hauptmann Starkfaust 8 Kriegsflaggen des Drachenmals.‡메네실 항구에 있는 경비대장 스타우트피스트에게 용아귀부족 전쟁 깃발 8개를 가져가야 합니다.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Lleva 8 estandartes de guerra Faucedraco al capitán Puñorrecio.‡Rapporter 8 Bannières de guerre Gueule-de-dragon au capitaine Rudepoing.‡给斯托菲队长带回8面龙喉战旗。‡給斯托菲隊長帶回8面龍喉戰旗。',
  }
},
[465] = {
  {
    'A artimanha de Nek\'rosh‡Гамбит Нек\'роша‡Nek\'roshs Schachzug‡용아귀부족 투석기‡La estrategia de Nek\'rosh‡La estrategia de Nek\'rosh‡La manœuvre de Nek\'rosh‡纳克罗什的优势‡納克羅什的優勢',
    nil,
    'Destrua as Catapultas da Presa do Dragão.‡Уничтожьте катапульты Драконьей Пасти.‡Zerstört die Katapulte des Drachenmals.‡용아귀부족 투석기를 파괴해야 합니다.‡Destruye las catapultas Faucedraco.‡Destruye las catapultas Faucedraco.‡Détruire les Catapultes Gueules-de-dragon.‡摧毁所有的龙喉投石车。‡摧毀所有的龍喉投石車。',
  }
},
[466] = {
  {
    'À procura de incendicita‡Поиски огневита‡Auf der Suche nach Pyrophor‡발연 광석을 찾아서‡Búsqueda de incendicita‡Búsqueda de incendicita‡À la recherche de l\'incendicite‡火岩矿石‡火岩礦石',
    nil,
    'Leve 6 cargas de Minério de Incendicita ao Piloto Marchapedra em Dun Morogh.‡Принесите 6 партий огневитовой руды пилоту Камнекожицу в Дун Морог.‡Bringt 6 Ladungen Pyrophorerz zu Pilot Steinsegel nach Dun Morogh.‡던 모로에 있는 조종사 스톤기어에게 발연 광석 6개를 가져가야 합니다.‡Lleva 6 piezas de mena de incendicita al piloto Roscapiedra de Dun Morogh.‡Lleva 6 piezas de mineral de incendicita al piloto Roscapiedra de Dun Morogh.‡Apporter 6 Chargements d\'Incendicite au Pilote Engrepierre à Dun Morogh.‡给丹莫罗的驾驶员迪恩·石轮带回6份火岩矿石。‡給丹莫洛的駕駛員迪恩·石輪帶回6份火岩礦石。',
  }
},
[467] = {
  {
    'A busca de Marchapedra‡Найдите Камнекожца‡Steinsegels Suche‡스톤기어의 광석‡La búsqueda de los Roscapiedra‡La búsqueda de los Roscapiedra‡La quête de Stonegear‡迪恩·石轮的梦想‡迪恩·石輪的追尋',
    nil,
    'Fale com o Piloto Marchapedra.‡Поговорите с пилотом Камнекожицем.‡Sprecht mit Pilot Steinsegel.‡조종사 스톤기어와 대화하십시오.‡Habla con el piloto Roscapiedra.‡Habla con el piloto Roscapiedra.‡Parler au Pilote Engrepierre.‡和驾驶员迪恩·石轮谈一谈。‡和駕駛員迪恩·石輪談話。',
  }
},
[468] = {
  {
    'Apresente-se ao Montanhista Rochapeixe‡Отчитайтесь перед горным пехотинцем Рокхаром.‡Meldung bei Gebirgsjäger Felsgar‡산악경비대 록가르에게 보고‡Preséntate ante el montaraz Rockgar‡Preséntate ante el montaraz Piedragar‡Un rapport pour le Montagnard Rochegar‡向巡山人罗克加报告‡向巡山人羅克加報告',
    nil,
    'Fale com o Montanhista Rochapeixe.‡Поговорите с горным пехотинцем Рокхаром.‡Sprecht mit Gebirgsjäger Felsgar.‡산악경비대 록가르와 대화해야 합니다.‡Habla con el montaraz Rockgar.‡Habla con el montaraz Piedragar.‡Parler au Montagnard Rochegar.‡与巡山人罗克加谈一谈。‡與巡山人羅克加談話。',
  }
},
[469] = {
  {
    'Entrega diária‡Ежедневная доставка‡Tägliche Lieferung‡가죽 배달‡Entrega cotidiana‡Entrega cotidiana‡Livraison quotidienne‡日常供货‡日常供貨',
    nil,
    'Entregue o Pacote de Peles de Crocolisco a Iago Halberque, o curtumeiro, no Porto de Menethil.‡Отнесите стопку кроколисковых шкур кожевнику Джеймсу Халлорану в Гавань Менетилов.‡Liefert das Bündel Krokiliskenhäute bei dem Gerber James Halloran im Hafen von Menethil ab.‡메네실 항구의 무두장이 제임스 할로란에게 악어 가죽 한 묶음을 전달해야 합니다.‡Entrega el fardo de pieles de crocolisco a James Halloran, el curtidor, en Puerto de Menethil.‡Entrega el fardo de pieles de crocolisco a James Halloran, el curtidor, en Puerto de Menethil.‡Apporter le Lot de peaux de crocilisques à James Halloran, le tanneur, au port de Menethil.‡将这捆鳄鱼皮带给米奈希尔港的皮匠詹姆斯·哈洛兰。‡將這捆鱷魚皮帶給米奈希爾港的皮匠詹姆士·哈洛倫。',
  }
},
[470] = {
  {
    'Escavando a Gosma‡Прожорливый слизнюк‡Stochern im Brühschlamm‡가방 찾기‡Abriéndose paso entre los mocos‡Abriéndose paso entre los mocos‡En creusant dans la vase‡搜寻软泥怪‡搜尋軟泥怪',
    nil,
    'A bolsa de Cida está em uma das gosmas na Tumba dos Barbaférreos. Recupere a bolsa e leve de volta para ela no Porto de Menethil.‡Отнимите сумку Сиды у неизвестного слизнюка возле гробницы Железноборода и верните ее хозяйке в Гавань Менетилов.‡Einer der Brühschlammer bei Eisenbarts Grabmal hat Sidas Tasche. Bergt sie und bringt sie ihr zurück in den Hafen von Menethil.‡아이언비어드 고분에 돌아다니는 수액괴물 중 하나가 시다의 가방을 갖고 있습니다. 그 가방을 찾아 메네실 항구의 시다에게 가져가야 합니다.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡Uno de los mocos de la Tumba de Barbaférrea tiene la Bolsa de Shida, recupérala y devuélvesela en Puerto de Menethil.‡L\'un des limons dans la Tombe de Barbe-de-fer a le sac de Sidonie. Le retrouver et le lui rapporter au port de Menethil.‡铁须之墓中的某只软泥怪身上有塞达的背包，夺回背包，把它送还给米奈希望港的塞达。‡鐵鬚之墓中的某隻軟泥怪身上有塞達的背包，奪回背包，把它送還給米奈希望港的塞達。',
  }
},
[471] = {
  {
    'Deveres de aprendiz‡Тяжкая судьба помощника‡Lehrlingspflichten‡수습생의 임무‡Deberes de aprendiz‡Deberes de aprendiz‡Les devoirs de l\'apprenti‡学徒的职责‡學徒的職責',
    nil,
    'Colete 6 Peles de Crocolisco Gigante e leve-as para Iago Halberque no Porto de Menethil.‡Принесите 6 шкур гигантских кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Sammelt 6 riesige Krokiliskenhäute und bringt sie zu James Halloran in den Hafen von Menethil.‡거대한 악어 가죽 6개를 모아 메네실 항구의 제임스 할로란에게 가져가야 합니다.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Reúne 6 pieles de crocolisco gigante y llévaselas a James Halloran en Puerto de Menethil.‡Collecter 6 Peaux de crocilisque géant, et les apporter à James Halloran, au port de Menethil.‡为米奈希尔港的詹姆斯·哈洛兰带回6张巨型鳄鱼的皮。‡為米奈希爾港的詹姆士·哈洛倫帶回6張巨型鱷魚的皮。',
  }
},
[472] = {
  {
    'Queda de Dun Modr‡Падение Дун Модра‡Der Fall von Dun Modr‡던 모드르의 함락‡La caída de Dun Modr‡La caída de Dun Modr‡La chute de Dun Modr‡丹莫德的陷落‡丹莫德的陷落',
    nil,
    'Procure Trançalonga perto da cidade de Dun Modr.‡Отыщите Грима Длинную Косу возле Дун Модра.‡Sucht nahe der Stadt von Dun Modr nach Langzopf.‡던 모드르 마을 근처에서 롱브레이드를 찾아야 합니다.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Busca a Largatrenza junto a la ciudad de Dun Modr.‡Rechercher Tresse-longue dans les parages de la ville de Dun Modr.‡在丹莫德镇附近寻找布莱德·长须的踪迹。‡在丹莫德鎮附近尋找布萊德·長鬚的蹤跡。',
  }
},
[473] = {
  {
    'Apresente-se ao Capitão Punhoforte‡Доклад капитану Крепкому Кулаку‡Meldung bei Hauptmann Starkfaust‡경비대장 스타우트피스트에게 보고‡Preséntate ante el capitán Puñorrecio‡Preséntate ante el capitán Puñorrecio‡Un rapport au capitaine Stoutfist‡向斯托菲队长报告‡向斯托菲隊長報告',
    nil,
    'Fale com o Capitão Punhoforte.‡Найдите капитана Крепкого Кулака и поговорите с ним.‡Sprecht mit Hauptmann Starkfaust.‡경비대장 스타우트피스트와 대화해야 합니다.‡Habla con el capitán Puñorrecio.‡Habla con el capitán Puñorrecio.‡Parler au capitaine Rudepoing.‡与斯托菲队长谈一谈。‡與斯托菲隊長談話。',
  }
},
[474] = {
  {
    'Derrotar Nek\'rosh‡Убить Нек\'роша‡Sieg über Nek\'rosh‡네크로쉬 처치‡Derrota a Nek\'rosh‡Derrota a Nek\'rosh‡Vaincre Nek\'rosh‡击败纳克罗什‡擊敗納克羅什',
    nil,
    'Mate o Chefe Nek\'rosh.nnLeve a Cabeça do Nek\'rosh ao Capitão Punhoforte.‡Убейте вождя Нек\'роша.nnПринесите голову Нек\'роша капитану Крепкому Кулаку.‡Tötet Häuptling Nek\'rosh.nnBringt Nek\'roshs Kopf zu Hauptmann Starkfaust.‡족장 네크로쉬를 처치해야 합니다.nn그런 다음 그 증거로 경비대장 스타우트피스트에게 네크로쉬의 머리카락을 가져가야 합니다.‡Mata al cabecilla Nek\'rosh.nnLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Mata al jefe Nek\'rosh.|nLleva la cabeza de Nek\'rosh al capitán Puñorrecio.‡Tuer le Chef Nek\'rosh.nnRapporter la tête de Nek\'rosh au capitaine Rudepoing.‡杀掉纳克罗什酋长。nn将纳克罗什的头颅交给斯托菲队长。‡殺掉納克羅什酋長。|n將納克羅什的頭顱交給斯托菲隊長。',
  }
},
[475] = {
  {
    'Uma leve brisa‡Ветер тревоги‡Ein beunruhigender Wind‡혼란의 바람‡Una brisa problemática‡Una brisa problemática‡Une brise étrange‡烦恼之风‡煩惱之風',
    nil,
    'Encontre Garyol Talvethren no Vilarejo Brisastral.‡Найдите Гароласа Талветрена в Деревне Звездного Ветра.‡Sucht Gaerolas Talvethren im Dorf Sternenhauch auf.‡별바람 마을에서 게롤라스 탈베드렌을 찾아야 합니다.‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.|n‡Busca a Gaerolas Talvethren en la Aldea Brisa Estelar.‡Chercher Gaerolas Talvethren au village de Brise-stellaire.‡在星风村找到盖洛拉斯·塔文斯伦。‡在星風村找到蓋洛拉斯·塔文斯倫。',
  }
},
[476] = {
  {
    'Corrupção Masca-pinho‡Порча Кривой Сосны‡Die Verderbnis der Knarzklauen‡나무옹이일족의 타락‡Corrupción en Tuercepinos‡Corrupción en Tuercepinos‡La corruption des Pins-tordus‡瘤背熊怪的堕落‡瘤背熊怪的墮落',
    nil,
    'Fale com Athridas Mantursino em Dolanaar.‡Вернитесь к Атридасу Медвежьей Шкуре в Доланаар.‡Kehrt zu Athridas Bärenpelz nach Dolanaar zurück.‡돌라나르에 있는 아스리다스 베어맨틀에게 돌아가십시오.‡Ve a ver a Athridas Manto de Oso a Dolanaar.‡Ve a ver a Athridas Manto de Oso a Dolanaar.‡Retourner auprès d\'Athridas Mantelours à Dolanaar.‡返回多兰纳尔去见阿斯瑞达斯·熊皮。‡返回多蘭納爾去見阿斯瑞達斯·熊皮。',
  }
},
[477] = {
  {
    'Cruzando fronteiras‡Пересечение границ‡Grenzübergänge‡마법사의 상자‡Pasa la frontera‡Pasa la frontera‡Frontières‡越境‡越境',
    nil,
    'Recupere o conteúdo de um dos caixotes dos teurgos de Dalaran. Você vai encontrar o Vilarejo Lenhardente ao sul.‡Раздобудьте содержимое одного из сундуков даларанских волшебников. Деревня Погребальных Костров находится на юге.‡Holt den Inhalt einer der Kisten von den Hexern aus Dalaran. Ihr findet Lohenscheit im Süden.‡달라란 마술사의 상자 중 하나의 내용물을 찾아 와야 합니다. 장작나무 마을은 남쪽에서 찾을 수 있습니다.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Recupera el contenido de una de las cajas de zahoríes de Dalaran. Encontrarás la Aldea Piroleña hacia el sur.‡Récupérer le contenu de l\'une des caisses des sorciers de Dalaran. Vous trouverez Bois-du-Bûcher au sud.‡从达拉然法师的木箱中拿出里面的东西。‡從達拉然巫師的木箱中拿出裡面的東西。',
  }
},
[478] = {
  {
    'Mapas e runas‡Карты и руны‡Karten und Runen‡지도와 룬문자 펜던트‡Mapas y runas‡Mapas y runas‡Des cartes et des runes‡地图与符记‡地圖與符記',
    nil,
    'Leve o estranho pingente para o Sacerdote Sombrio Allister, no Sepulcro.‡Отнесите странную подвеску жрецу Тьмы Алистеру в Гробницу.‡Bringt den seltsamen Anhänger zu Schattenpriester Allister in dem Grabmal.‡공동묘지에 있는 어둠의사제 알리스터에게 룬문자 펜던트를 가져가야 합니다.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Lleva el extraño colgante al sacerdote de las Sombras Allister en El Sepulcro.‡Apporter l\'étrange pendentif au prêtre des ombres Allister au Sépulcre.‡将这个奇怪的坠饰交给瑟伯切尔的暗影牧师奥利斯特。‡將這個奇怪的墜飾交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[479] = {
  {
    'Investigações de Lenhâmbar‡Расследование в Янтарной Мельнице‡Nachforschungen in Mühlenbern‡앰버밀 조사‡Las investigaciones de Molino Ámbar‡Las investigaciones de Molino Ámbar‡Enquête à Moulin-de-l\'Ambre‡调查安伯米尔‡調查安伯米爾',
    nil,
    'Obtenha 8 Pingentes de Dalaran para o Sacerdote Sombrio Allister, no Sepulcro.‡Добудьте 8 подвесок Даларана и отнесите жрецу Тьмы Алистеру в Гробницу.‡Beschafft 8 Anhänger aus Dalaran für Schattenpriester Allister beim Grabmal.‡공동묘지의 어둠의사제 알리스터를 위해 달라란 펜던트 8개를 모야아 합니다.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Consigue 8 colgantes de Dalaran al sacerdote de las Sombras Allister en El Sepulcro.‡Récupérer 8 Pendentifs de Dalaran pour le prêtre des ombres Allister du Sépulcre.‡为瑟伯切尔的暗影牧师奥利斯特抢到8个达拉然坠饰。‡為瑟伯切爾的暗影牧師奧利斯特搶到8個達拉然墜飾。',
  }
},
[480] = {
  {
    'O tecelão‡Ткач‡Der Wirker‡대마법사의 지팡이‡El Tejedor‡El Tejedor‡Le Tisserand‡法师的头领‡法師的頭領',
    nil,
    'Mate o arquimago de Dalaran, depois leve o cajado dele para o Sacerdote Sombrio Allister, no Sepulcro.‡Убейте даларанского верховного мага, заберите его посох и отнесите жрецу Тьмы Алистеру в Гробницу.‡Tötet den Erzmagier von Dalaran und bringt seinen Stab zu Schattenpriester Allister in dem Grabmal.‡달라란 대마법사 아테릭을 처치하고 그의 지팡이를 공동묘지에 있는 어둠의사제 알리스터에게 가져가야 합니다.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Mata al archimago Dalaran, recupera su bastón y llévaselo al sacerdote de las Sombras Allister en El Sepulcro.‡Tuer l\'archimage de Dalaran, puis récupérer son Bâton pour le prêtre des ombres Allister du Sépulcre.‡杀死达拉然大法师，并把他的法杖交给瑟伯切尔的暗影牧师奥利斯特。‡殺死達拉然大法師，並把他的法杖交給瑟伯切爾的暗影牧師奧利斯特。',
  }
},
[481] = {
  {
    'Análise de Dalar‡Анализ Далара‡Dalars Analyse‡달라의 분석‡El análisis de Dalar‡El análisis de Dalar‡L\'analyse de Dalar‡达拉尔的推理‡達拉爾的推理',
    nil,
    'Leve o pingente inscrito em runas para Dalar Tessalba, no Sepulcro.‡Отнесите подвеску рунной надписи Далару Ткачу Рассвета в Гробницу.‡Bringt den mit Runen gravierten Anhänger zu Dalar Morgenweber in dem Grabmal.‡공동묘지에 있는 달라 돈위버에게 룬문자 펜던트를 가져가야 합니다.‡Lleva el colgante con runas grabadas a Dalar Tejalba en El Sepulcro.‡Lleva el colgante con runas grabadas a Dalar Tejealba en El Sepulcro.‡Apporter le Pendentif marqué de runes à Dalar Tisselaube au Sépulcre.‡把刻有符文的坠饰交给瑟伯切尔的达拉尔-道恩维沃尔。‡把刻有符文的墜飾交給瑟伯切爾的達拉爾·道恩維沃爾。',
  }
},
[482] = {
  {
    'As intenções de Dalaran‡Планы Даларана‡Dalaran Absichten‡달라란의 의도‡Las intenciones de los Dalaran‡Las intenciones de los Dalaran‡Les intentions de Dalaran‡达拉然的意图‡達拉然的意圖',
    nil,
    'Fale com o Sacerdote Sombrio Allister, no Sepulcro.‡Поговорите с жрецом Тьмы Алистером в Гробнице.‡Sprecht mit dem Schattenpriester Allister in dem Grabmal.‡공동묘지에 있는 어둠의사제 알리스터와 대화해야 합니다.‡Habla con el sacerdote de las Sombras Allister en El Sepulcro.‡Habla con el sacerdote de las Sombras Allister en El Sepulcro.‡Parler au prêtre des ombres Allister au Sépulcre.‡与瑟伯切尔的暗影牧师奥利斯特谈一谈。‡與瑟伯切爾的暗影牧師奧利斯特談話。',
  }
},
[483] = {
  {
    'As relíquias do despertar‡Реликвии Пробуждения‡Die Relikte des Erwachens‡깨움의 의식을 위한 재료‡Las Reliquias del Despertar‡Las Reliquias del Despertar‡Les Reliques d\'éveil‡唤醒圣物‡喚醒聖物',
    nil,
    'Recupere as Relíquias do Despertar e leve para Athridas Mantursino, em Dolanaar.‡Добудьте реликвии Пробуждения и принесите их Атридасу Медвежьей Шкуре в Доланаар.‡Bringt die Relikte des Erwachens zu Athridas Bärenpelz nach Dolanaar.‡드루이드들을 깨우는 의식에 필요한 재료를 찾아 돌라나르에 있는 아스리다스 베어맨틀에게 가져가야 합니다.‡Consigue las Reliquias del Despertar y llévaselas a Athridas Manto de Oso a Dolanaar.‡Consigue las Reliquias del Despertar.‡Récupérer les Reliques d\'éveil et les rapporter à Athridas Mantelours à Dolanaar.‡找回四件唤醒圣物，把它们交给多兰纳尔的阿斯瑞达斯·熊皮。‡尋回四件喚醒聖物,把它們帶給多蘭納爾的阿斯瑞達斯·熊皮。',
  }
},
[484] = {
  {
    'Crocolisco jovem é que dá pele boa‡Шкуры молодых кроколисков‡Häute junger Krokilisken‡새끼 악어 가죽‡Piel de crocolisco joven‡Piel de crocolisco joven‡Les peaux de jeune crocilisque‡小鳄鱼皮‡小鱷魚皮',
    nil,
    'Obtenha 4 Peles de Crocolisco Jovem para Iago Halberque, no Porto de Menethil.‡Принесите 4 шкуры молодых кроколисков Джеймсу Халлорану в Гавань Менетилов.‡Besorgt Euch 4 Häute junger Krokilisken für James Halloran im Hafen von Menethil.‡메네실 항구의 제임스 할로란에게 새끼 악어 가죽 4개를 가져가야 합니다.‡Consigue 4 pieles de crocoliscos jóvenes para James Halloran de Puerto de Menethil.‡Consigue 4 pieles de crocoliscos jóvenes para James Halloran de Puerto de Menethil.‡Collecter 4 Peaux de jeune crocilisque, pour James Halloran, au port de Menethil.‡为米奈希尔港口的詹姆斯·哈洛兰带回4张小鳄鱼皮。‡為米奈希爾港口的詹姆士·哈洛倫帶回4張小鱷魚皮。',
  }
},
[485] = {
  {
    'Encontre OOX-09/HL!‡Найти КПХ-9/HL!‡Sucht OOX-09/HL!‡OOX-09/HL 수색‡¡Encuentra a OOX-09/TI!‡¡Encuentra a OOX-09/TI!‡Trouvez OOX-09/HL !‡找到OOX-09/HL！‡找到OOX-09/HL!',
    nil,
    'Leve o transmissor de emergência até o robô teleguiado de Olhatorto na cabeceira do rio, perto da Rocha Oculta, que fica nas Terras Agrestes.‡Отнесите аварийный маяк к автономному роботу Карлса. Робот находится во Внутренних землях, в устье реки близ Осклизлой скалы.‡Bringt das Notsignal zu Glotz\' Leitroboter an der Quelle des Flusses im Hinterland, in der Nähe vom Lauerfels.‡해골 바위굴 근처, 동부 내륙지의 강이 시작되는 곳에 추락한 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador al robot mensajero de Oglethorpe, que está en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Lleva el localizador al robot mensajero de Oglethorpe, en el nacimiento del río de las Tierras del Interior, cerca de Roca Oculta.‡Apporter la balise de détresse jusqu\'au robot guidé d\'Orguignard en haut de la rivière dans les Hinterlands, près du rocher de l\'Affût.‡把定位器带到奥格索普的母体机器人那里去。nn奥格索普的母体机器人位于辛特兰的河水源头，就在隐匿石的附近。‡把定位器帶到奧格索普的母體機器人那裡去。|n奧格索普的母體機器人位於辛特蘭的河水源頭，就在隱匿石的附近。',
  }
},
[486] = {
  {
    'Ursal, o Espancador‡Урсал Изверг‡Ursal der Raufer‡투사 우르살‡Ursal el Violento‡Ursal el Violento‡Ursal le Marteleur‡大槌乌萨尔‡『大槌』烏薩爾',
    nil,
    'Mate Ursal, o Espancador, e fale novamente com Athridas Mantursino, em Dolanaar.‡Убейте Урсала Изверга и возвращайтесь к Атридасу Медвежьей Шкуре в Доланаар.‡Tötet Ursal den Raufer und kehrt zu Athridas Bärenpelz nach Dolanaar zurück.‡투사 우르살을 처치한 다음 돌라나르에 있는 아스리다스 베어맨틀에게 돌아가십시오.‡Mata a Ursal el Violento y ve a ver de nuevo a Athridas Manto de Oso a Dolanaar.‡Mata a Ursal el Violento.‡Tuer Ursal le Marteleur et retourner voir Athridas Mantelours à Dolanaar.‡杀掉大槌乌萨尔，然后回到多兰纳尔的阿斯瑞达斯·熊皮那里。‡殺掉『大槌』烏薩爾，然後回到多蘭納爾的阿斯瑞達斯·熊皮那裡。',
  }
},
[487] = {
  {
    'A estrada para Darnassus‡Дорога в Дарнасс‡Die Straße nach Darnassus‡다르나서스에 이르는 길‡El camino a Darnassus‡El camino a Darnassus‡La route de Darnassus‡达纳苏斯之路‡達納蘇斯之路',
    nil,
    'Mate 6 Emboscadores Masca-pinho e fale novamente com a Sentinela Amara Noctívaga fora de Dolanaar.‡Убейте 6 душителей из племени Кривой Сосны и найдите часового Амару Ночную Странницу возле Доланаара.‡Erschlagt 6 Wegelagerer der Knarzklauen und kehrt zu Schildwache Amara Nachtschleicher außerhalb Dolanaars zurück.‡나무옹이일족 복병 6마리를 처치한 다음 돌라나르 외곽에 있는 파수꾼 아마라 나이트워커에게 돌아가십시오.‡Acaba con 6 emboscadores Tuercepinos y después ve a ver de nuevo a Amara Andanoche a las afueras de Dolanaar.‡Acaba con 8 emboscadores Tuercepinos.‡Tuer 6 Embusqués Pins-tordus et retourner voir la Sentinelle Amara Marchenuit à l\'extérieur de Dolanaar.‡杀掉6个瘤背伏击者，然后向多兰纳尔城外的哨兵阿玛拉·夜行者报告。‡殺掉6個瘤背伏擊者，然後向多蘭納爾城外的哨兵阿瑪拉·夜行者報告。',
  }
},
[488] = {
  {
    'O comando de Zenn‡Просьба Зенна‡Zenns Aufträge‡젠의 부탁‡Las apuestas de Zenn‡Las apuestas de Zenn‡Les commandements de Zenn‡赛恩的要求‡賽恩的要求',
    nil,
    'Leve para Zenn Cascovil, fora de Dolanaar, 3 Presas de Sabre-da-noite, 3 Penas Estrígidas de Coruja e 3 amostras de Seda de Aranha Lenhateia.‡Принесите Зенну Грязному Копыту, стоящему недалеко от Доланаара, 3 клыка ночного саблезуба, 3 пера островной совы и 3 мотка паутины чащобного тенетника.‡Bringt Zenn Faulhuf außerhalb von Dolanaar 3 Nachtsäblerfangzähne, 3 Strigideulenfedern und 3 Streifen Waldweberspinnenseide.‡돌라나르 외곽에 있는 젠 파울후프에게 흑호 송곳니 3개, 스트리기드 올빼미 깃털 3개, 그리고 나무그물 늑대거미의 거미줄 3개를 가져가야 합니다.‡Llévale a Zenn Nauseapezuña a las afueras de Dolanaar 3 colmillos de sable de la noche, 3 plumas de lechuza estrígida y 3 muestras de seda de araña Tejemadera.‡Consigue 2 colmillos de sable de la noche, 2 plumas de lechuza estrígida y 2 muestras de seda de araña Tejemadera.‡Rapporter 3 Crocs de sabre-de-nuit, 3 Plumes de Hibou Strigid et 3 échantillons de Soie d\'araignée Tissebois à Zenn Vilsabot à l\'extérieur de Dolanaar.‡给多兰纳尔外面的赛恩·腐蹄带去3颗夜刃豹的牙齿、3根巨翼枭的羽毛和3份树林蜘蛛丝。‡給多蘭納爾外面的賽恩·腐蹄帶去3顆夜刃豹的牙齒、3根巨翼梟的羽毛和3份樹林蜘蛛絲。',
  }
},
[489] = {
  {
    'Consiga redenção!‡Искупление вины‡Sucht Befreiung!‡신뢰의 회복‡¡Búsqueda de redención!‡¡Búsqueda de redención!‡En quête de rédemption !‡寻求救赎！‡尋求救贖!',
    nil,
    'Colete 3 Pinhas Vis e entregue-as para Zenn Cascovil, fora de Dolanaar.‡Соберите 3 скверношишки и отдайте их Зенну Грязному Копыту близ Доланаара.‡Sammelt 3 Teufelszapfen und gebt sie Zenn Faulhuf außerhalb von Dolanaar.‡악의 열매 3개를 모아 돌라나르 외곽에 있는 젠 파울후프에게 가져다주어야 합니다.‡Recoge 3 bellotas viles y dáselas a Zenn Nauseapezuña, que está a las afueras de Dolanaar.‡Recoge 3 bellotas viles.‡Collecter 3 Gangrenoix et les offrir à Zenn Vilsabot à l\'extérieur de Dolanaar.‡收集3个魔锥果，把它们给在多兰纳尔外面的赛恩·腐蹄。‡收集3個魔錐果，把它們給在多蘭納爾外面的賽恩·腐蹄。',
  }
},
[490] = {
  {
    '‡‡‡‡‡‡‡‡<UNUSED>',
    nil,
    '‡‡‡‡‡‡‡‡達納蘇斯外的莎依拉·夜風想要你帶給她20個瘤背熊怪的牙齒。',
  }
},
[491] = {
  {
    'Uma boa varinha para Boanerges‡Жезл для Бетора‡Zauberstab an Bethor‡베소르에게 전할 마법봉‡Una varita para Bethor‡Una varita para Bethor‡Une Baguette pour Bethor‡给比索的魔杖‡',
    nil,
    'Leve a Varinha Entretecida para Boanerges Stalactus, no Distrito da Magia da Cidade Baixa.‡Отнесите Сплетенный жезл Бетору Ледострелу в Квартал Магов Подгорода.‡Bringt den gewebten Zauberstab zu Bethor Eismacht in das Magieviertel von Unterstadt.‡언더시티의 마법 지구에 있는 베소르 아이스샤드에게 결합된 마법봉을 가져가야 합니다.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Lleva la varita tejida a Bethor Duroyelo en el Barrio de la Magia, en Entrañas.‡Apporter le Bâton tressé à Bethor Glacéclat dans le Quartier de la magie à Fossoyeuse.‡将狼人魔杖带给幽暗城法师区的比索·埃斯沙德。‡',
  }
},
[492] = {
  {
    'Uma nova peste‡Новая чума‡Eine neue Seuche‡새로운 역병‡Una nueva Peste‡Una nueva Peste‡Une Peste nouvelle‡新的瘟疫‡',
    nil,
    'Leve a Bebida Especial do Joaquino para o Montanhista Capturado.‡Отнесите особый напиток Юхана пленному горному пехотинцу.‡Bringt Johaans Spezialgetränk zum gefangenen Gebirgsjäger.‡산악경비대 포로에게 요한의 특별조제약을 전해줘야 합니다.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Llévale la bebida especial de Johaan al montaraz capturado.‡Apporter la Boisson spéciale de Johaan au Montagnard captif.‡将乔汉的特制饮料交给被俘虏的巡山人。‡',
  }
},
[493] = {
  {
    'Jornada ao Contraforte de Eira dos Montes‡Путешествие в предгорья Хилсбрада‡Reise in das Vorgebirge des Hügellands‡힐스브래드 구릉지로의 여정‡Viaja a Laderas de Trabalomas‡Viaja a Laderas de Trabalomas‡Voyage jusqu\'aux contreforts de Hautebrande‡前往希尔斯布莱德丘陵‡前往希爾斯布萊德丘陵',
    nil,
    'Entregue as descobertas do Boticário Renferrel ao Boticário Lindolfo na cidade de Serraria Tarren, que fica no Contraforte de Eira dos Montes.‡Отнесите находки аптекаря Ренферрела аптекарю Лидону в город Мельница Таррен в предгорьях Хилсбрада.‡Bringt die Funde von Apotheker Renferrel zu Apotheker Lydon nach Tarrens Mühle im Vorgebirge des Hügellands.‡힐스브래드 구릉지의 타렌 밀농장에 있는 연금술사 라이던에게 렐퍼럴의 연구 결과를 가져가야 합니다.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Lleva el descubrimiento del boticario Renferrel al boticario Lydon en la ciudad de Molino Tarren, en las Laderas de Trabalomas.‡Livrer les découvertes de l\'Apothicaire Renferrel à l\'Apothicaire Lydon à Moulin-de-Tarren dans les contreforts de Hautebrande.‡将伦弗利尔的研究成果交给希尔斯布莱德山脚下塔伦米尔的药剂师林度恩。‡將倫弗利爾的研究成果交給希爾斯布萊德丘陵塔倫米爾的藥劑師林度恩。',
  }
},
[494] = {
  {
    'Hora de atacar‡Время нанести удар‡Zeit zum Zuschlagen‡공격 개시‡El momento de atacar‡El momento de atacar‡Prêts à frapper‡进攻的时机‡進攻的時機',
    nil,
    'Viaje até Serraria Tarren para entregar a mensagem do Sicário Açoute para a Alta-executora Darthalia.‡Отправляйтесь в Мельницу Таррен и доставьте послание стража смерти Леш верховной вершительнице Дарталии.‡Reist nach Tarrens Mühle, um die Nachricht von Todespirscherin Lesch an Hochexekutorin Darthalia zu überbringen.‡타렌 밀농장으로 가서 고위집행관 다살리아에게 죽음의추적자 레시의 전갈을 전해야 합니다.‡Ve a Molino Tarren para llevar el mensaje del mortacechador Lesh a la suma ejecutora Darthalia.‡Ve a Molino Tarren para llevar el mensaje de la mortacechadora Lesh a la suma ejecutora Darthalia.‡Rendez-vous au Moulin-de-Tarren et délivrez le message du nécrotraqueur Lesh à la Grande exécutrice Darthalia.‡到塔伦米尔去，把亡灵哨兵莱什的口信带给高级执行官达萨利亚。‡到塔倫米爾去，把亡靈哨兵萊什的口信帶給高級執行官達薩利亞。',
  }
},
[495] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意志之冠',
    nil,
    'Apresente-se a Melissara, na Serraria Tarren, no Contraforte de Eira dos Montes.‡Поговорите с Мелизарой в Мельнице Таррен в предгорьях Хилсбрада.‡Meldet Euch bei Melisara in Tarrens Mühle im Vorgebirge des Hügellands.‡힐스브래드 구릉지의 타렌 밀농장에 있는 멜리사라에게 보고해야 합니다.‡Informa a Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Preséntate ante Melisara que está en Molino Tarren, en las Laderas de Trabalomas.‡Présentez-vous à Melisara, à Moulin-de-Tarren, dans les Contreforts de Hautebrande.‡到希尔斯布莱德丘陵去，向塔伦米尔的梅里萨拉报到。‡到希爾斯布萊德丘陵去，向塔倫米爾的梅里薩拉報到。',
  }
},
[496] = {
  {
    'Elixir do sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir de sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Boticário Lindolfo, de Serraria Tarren, quer 10 Línguas de Urso Cinzento e um pouco de Pus de Rastejante.‡Аптекарь Лидон из Мельницы Таррен попросил принести ему 10 языков серых медведей и немного лимфы паука-охотника.‡Apotheker Lydon aus Tarrens Mühle möchte 10 Graubärzungen und etwas Krabblersekret.‡타렌 밀농장에 있는 연금술사 라이던이 회색곰 혀 10개와 이끼거미 수액을 구해다 달라고 부탁했습니다.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepamusgo.‡El boticario Lydon de Molino Tarren quiere 10 lenguas de oso gris y un poco de icor de trepador.‡Apporter 10 Langues d\'ours gris et de l\'Ichor de Rampemousse à l\'Apothicaire Lydon à Moulin-de-Tarren.‡塔伦米尔的药剂师林度恩要你去收集10个灰熊的舌头和一些食苔蛛的毒液。‡塔倫米爾的藥劑師林度恩要你去收集10個灰熊的舌頭和一些食苔蛛的毒液。',
  }
},
[498] = {
  {
    'O resgate‡Спасение‡Die Rettung‡포로 구출‡El rescate‡El rescate‡Sauvetage‡拯救行动‡拯救行動',
    nil,
    'Krusk, da Serraria Tarren, precisa que você liberte Drull e Tog\'thar do Forte do Desterro.‡Освободите Друлла и Тог\'тара по поручению Круска из Мельницы Таррен.‡Krusk in Tarrens Mühle braucht Euch, um Drull und Tog\'thar aus der Burg Durnholde zu befreien.‡타렌 밀농장에 있는 크루스크가 던홀드 요새에서 드럴과 토그타르를 구출해 달라고 부탁했습니다.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Krusk de Molino Tarren quiere que liberes a Drull y a Tog\'thar en el Castillo de Durnholde.‡Selon les ordres de Krusk à Moulin-de-Tarren, libérer Drull et Tog\'thar du donjon de Fort-de-Durn.‡塔伦米尔的克鲁斯克要你把德鲁尔和托格萨从敦霍尔德城堡救出来。‡塔倫米爾的克魯斯克要你把德盧爾和托格薩從敦霍爾德城堡救出來。',
  }
},
[499] = {
  {
    'Elixir do Sofrimento‡Эликсир Страдания‡Elixier des Leidens‡괴로움의 비약‡Elixir de sufrimiento‡Elixir de sufrimiento‡L\'élixir de souffrance‡受难药剂‡受難藥劑',
    nil,
    'Dê o Elixir do Sofrimento a Umpi.‡Дайте Ампи эликсир Страдания.‡Gebt Umpi das Elixier des Leidens‡개구리 움피에게 괴로움의 비약을 먹여야 합니다.‡Dale el elixir de sufrimiento a Umpi.‡Dale el elixir de sufrimiento a Umpi.‡Donner l\'Elixir de souffrance à Umpi.‡把受难药剂交给乌比。‡',
  }
},
[500] = {
  {
    'Caça de Massacrista‡Награда Раздробленного Хребта‡Trümmergratkopfgeld‡산사태일족 현상금‡La recompensa Aplastacresta‡La recompensa Aplastacresta‡La prime Cassecrête‡破碎岭食人魔‡破碎嶺巨魔',
    nil,
    'Reúna 9 Nós dos Dedos Sujos dos Ogros Massacrista nas Montanhas de Alterac. Leve-os para o Delegado Trilharrubra, na Costa Sul.‡Соберите 9 грязных бабок у огров из клана Раздробленного Хребта в Альтеракских горах. Принесите их маршалу Редпату в Южнобережье.‡Sammelt 9 schmutzige Knöchelknochen von Trümmergratogern im Alteracgebirge. Bringt sie zu Marschall Rotpfad in Süderstade.‡알터랙 산맥에 있는 산사태 오우거에게서 더러운 손가락 뼈 9개를 모은 후 사우스쇼어에 있는 치안대장 레드패스에게 가져가야 합니다.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. LLévaselos al alguacil Rutagrana a Costasur.‡Recoge 9 nudillos sucios de ogros Aplastacresta en las Montañas de Alterac. Llévaselos al alguacil Rutagrana a Costasur.‡Collecter 9 Articulations sales d\'ogres Cassecrête dans les montagnes d\'Alterac. Les apporter au maréchal Senterouge à Austrivage.‡从奥特兰克山的破碎岭食人魔身上收集9个肮脏的指节骨，把它们带给南海镇的治安官雷德帕斯。‡從奧特蘭克山的破碎嶺巨魔身上收集9個骯髒的指節骨，把它們帶給南海鎮的治安官雷德帕斯。',
  }
},
[501] = {
  {
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir de dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Leve 10 Ampolas de Sangue de Leão da Montanha para o Boticário Lindolfo na Serraria Tarren.‡Принесите 10 сосудов крови горного льва аптекарю Лидону из Мельницы Таррен.‡Bringt 10 Phiolen mit Berglöwenblut zu Apotheker Lydon in Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 산사자 피 10병을 가져가야 합니다.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Lleva 10 viales de sangre de león de montaña al boticario Lydon de Molino Tarren.‡Apporter 10 Fioles de sang de lion des montagnes à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集10瓶山地狮的血液，把它们交给塔伦米尔的药剂师林度恩。‡收集10瓶山地獅的血液，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[502] = {
  {
    'Elixir da dor‡Эликсир боли‡Elixier der Schmerzen‡고통의 비약‡Elixir de dolor‡Elixir de dolor‡L\'élixir de douleur‡痛苦药剂‡痛苦藥劑',
    nil,
    'Alimente Fido com o Elixir da Dor.‡Напоите Стэнли эликсиром Боли.‡Füttert Stanley mit dem Elixier der Schmerzen.‡스탠리에게 고통의 비약을 먹여야 합니다.‡Dale el elixir de dolor a Stanley.‡Dale el elixir de dolor a Stanley.‡Donner l\'Elixir de douleur à Stanley.‡把痛苦药剂喂给小狗斯坦雷。‡把痛苦藥劑餵給小狗斯坦利。',
  }
},
[503] = {
  {
    'Gol\'dir‡Гол\'дир‡Gol\'dir‡골디르‡Gol\'dir‡Gol\'dir‡Gol\'dir‡高迪尔‡高迪爾',
    nil,
    'Liberte Gol\'dir e fale novamente com Krusk na Serraria Tarren.‡Освободите Гол\'дира и возвращайтесь к Круску в Мельницу Таррен.‡Befreit Gol\'dir und kehrt dann zu Krusk in Tarrens Mühle zurück.‡골디르를 구출하여 타렌 밀농장에 있는 크루스크에게 돌아가야 합니다.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libera a Gol\'dir e informa a Krusk en Molino Tarren.‡Libérer Gol\'dir et retourner voir Krusk à Moulin-de-Tarren.‡救出高迪尔，然后回到塔伦米尔去见克鲁斯克。‡救出高迪爾，然後回到塔倫米爾去見克魯斯克。',
  }
},
[504] = {
  {
    'Fomentadores da Guerra Massacrista‡Наемники клана Раздробленного Хребта‡Kriegstreiber der Trümmergratoger‡산사태일족 전사‡Belicistas Aplastacresta‡Belicistas Aplastacresta‡Les Combattants Cassecrête‡破碎岭好战者‡破碎嶺好戰者',
    nil,
    'Mate 10 Fomentadores da Guerra Massacrista, depois fale novamente com o Delegado Trilharrubra na Costa Sul.‡Убейте 10 наемников из клана Раздробленного Хребта и возвращайтесь к маршалу Редпату в Южнобережье.‡Erschlagt 10 Kriegstreiber der Trümmergratoger und kehrt dann zu Marschall Rotpfad in Süderstade zurück.‡산사태일족 전사 10마리를 처치한 다음 사우스쇼어에 있는 치안대장 레드패스에게 돌아가십시오.‡Mata a 10 belicistas Aplastacresta y vuelve a hablar con el alguacil Rutagrana en Costasur.‡Mata a 10 belicistas Aplastacresta y vuelve a hablar con el alguacil Rutagrana en Costasur.‡Tuer 15 Combattants Cassecrête, puis retourner voir le maréchal Redpath à Southshore.‡杀死10个破碎岭好战者，然后回南海镇向治安官雷德帕斯报告。‡殺死10個破碎嶺好戰者，然後回南海鎮向治安官雷德帕斯報告。',
  }
},
[505] = {
  {
    'Assassinos da Camarilha‡Убийцы из Синдиката‡Auftragsmörder des Syndikats‡비밀결사대 암살자‡Hermandad de asesinos‡Hermandad de asesinos‡Syndicat d\'assassins‡辛迪加刺客‡辛迪加刺客',
    nil,
    'Mate 12 Salteadores da Camarilha e 8 Ladrões da Camarilha, depois fale novamente com o Magistrado Henrique Maleb na Costa Sul.‡Убейте 12 преступников и 8 воров Синдиката и возвращайтесь к чиновнику Генри Малебу в Южнобережье.‡Tötet 12 Schleicher des Syndikats und 8 Diebe des Syndikats, kehrt dann zurück zu Magistrat Henry Maleb nach Süderstade.‡비밀결사대 노상강도 12명과 비밀결사대 도둑 8명을 처치한 다음 사우스쇼어에 있는 집정관 헨리 말레브에게 돌아가야 합니다.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Mata a 12 asaltantes de caminos y 8 ladrones de la Hermandad e informa al magistrado Henry Maleb en Costasur.‡Tuer 12 Détrousseurs du Syndicat et 8 Larrons du Syndicat puis retourner voir le magistrat Henry Maleb à Austrivage.‡杀死12个辛迪加劫匪和8个辛迪加潜行者，然后回到南海镇向赫尼·马雷布镇长报到。‡殺死12個辛迪加劫匪和8個辛迪加盜賊，然後回到南海鎮向赫尼·馬雷布鎮長報到。',
  }
},
[506] = {
  {
    'O legado de Pantanegro‡Наследие Блэкмура‡Schwarzmoors Vermächtnis‡블랙무어의 유산‡El legado de Lodonegro‡El legado de Lodonegro‡L\'héritage de Landenoire‡布莱克摩尔的余孽‡',
    nil,
    'Leve as informações reunidas por Gol\'dir para Krusk na Serraria Tarren.‡Отнесите собранные Гол\'диром сведения Круску в Мельницу Таррен.‡Bringt die von Gol\'dir gesammelten Informationen zu Krusk in Tarrens Mühle.‡타렌 밀농장에 있는 크루스크에게 골디르가 수집한 정보를 전해야 합니다.‡Lleva la información recopilada por Gol\'dir a Krusk a Molino Tarren.‡Lleva la información recopilada por Gol\'dir a Krusk a Molino Tarren.‡Transmettre l\'information recueillie par Gol\'dir à Krusk à Moulin-de-Tarren.‡把高迪尔收集的消息带给塔伦米尔的克鲁斯克。‡',
  }
},
[507] = {
  {
    'Lorde Aliden Perenolde‡Лорд Алиден Перенольд‡Lord Aliden Perenolde‡앨리덴 페레놀드 경‡Lord Aliden Perenolde‡Lord Aliden Perenolde‡Seigneur Aliden Perenolde‡奥里登·匹瑞诺德‡奧里登·匹瑞諾德領主',
    nil,
    'Mate Lorde Aliden Perenolde e pergunte à sua concubina, Elysa, sobre o pingente de Taretha.‡Убейте лорда Алидена Перенольда и допросите его любовницу Элизу насчет ожерелья Тареты.‡Tötet Lord Aliden Perenolde und befragt seine Geliebte Elysa nach Tarethas Anhänger.‡앨리덴 페레놀드 경을 처치하고 그의 부인 엘리사에게 타레사의 펜던트에 대해서 물어봐야 합니다.‡Mata a Lord Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Mata a Aliden Perenolde y pregunta a su querida, Elysa, por el colgante de Taretha.‡Tuer le seigneur Aliden Perenolde et interroger sa maîtresse, Elysa, au sujet du pendentif de Taretha.‡杀了奥里登·匹瑞诺德领主，并从他的情人艾丽萨身上拿回塔蕾莎的项链。‡',
  }
},
[508] = {
  {
    'O presente de Taretha‡Подарок Тареты‡Tarethas Geschenk‡타레사의 선물‡Un regalo de Taretha‡Un regalo de Taretha‡Le cadeau de Taretha‡塔蕾莎的礼物‡',
    nil,
    'Devolva o pingente de Taretha a Krusk na Serraria Tarren.‡Верните ожерелье Тареты Круску в город Мельница Таррен.‡Bringt Tarethas Anhänger zu Krusk nach Tarrens Mühle.‡타렌 밀농장에 있는 크루스크에게 타레사의 펜던트를 돌려줘야 합니다.‡Devuélvele el colgante de Taretha a Krusk Molino Tarren.‡Devuélvele el colgante de Taretha a Krusk, que está en el Molino Tarren, en las Laderas de Trabalomas.‡Rapporter le Pendentif de Taretha à Krusk à Moulin-de-Tarren.‡把塔蕾莎的项链交还给塔伦米尔的克鲁斯克。‡',
  }
},
[509] = {
  {
    'Elixir da Agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve 6 Cogumelos Fuçalama para o Boticário Lindolfo na Serraria Tarren.‡Принесите 6 цветков грязного рыла аптекарю Лидону из Мельницы Таррен.‡Bringt 6 Morastschnauzenkappen zu Apotheker Lydon in Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 진흙주둥이꽃 6개를 가져가야 합니다.‡Lleva 6 flores Morrobarro al boticario Lydon de Molino Tarren.‡Lleva 6 flores Morrobarro al boticario Lydon de Molino Tarren.‡Apporter 6 Fleurs de fangemufle à l\'Apothicaire Lydon à Moulin-de-Tarren.‡收集6朵泥头花，把它们交给塔伦米尔的药剂师林度恩。‡收集6朵泥頭花，把它們交給塔倫米爾的藥劑師林度恩。',
  }
},
[510] = {
  {
    'Planos agourentos‡Зловещие планы‡Furchteinflößende Pläne‡불길한 예감이 드는 계획서‡Documentos de planificación‡Documentos de planificación‡Documents d\'annonce d\'attaque‡预备行动计划‡預備行動計畫',
    nil,
    'Leve os Planos Agourentos ao Magistrado Maleb na Costa Sul.‡Отнесите зловещие планы чиновнику Южнобережья Малебу.‡Bringt die furchteinflößenden Pläne zu Magistrat Henry Maleb nach Süderstade.‡사우스쇼어에 있는 집정관 말레브에게 불길한 예감이 드는 계획서를 가져가야 합니다.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Lleva los documentos de planificación al magistrado Maleb a Costasur.‡Apporter les Documents d\'annonce d\'attaque au Magistrat Maleb à Austrivage.‡把预备行动计划带给南海镇的赫尼·马雷布镇长。‡把預備行動計畫帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[511] = {
  {
    'Carta cifrada‡Зашифрованное письмо‡Verschlüsselter Brief‡암호화된 편지‡Una carta cifrada‡Una carta cifrada‡Lettre codée‡密文信件‡密文信件',
    nil,
    'Leve a Carta Cifrada para o Historiador Dibbs em Costa Sul.‡Отнесите зашифрованное письмо хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Süderstade.‡사우스쇼어에 있는 현자 딥스에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta cifrada al maestro cultural Dibbs en Costasur.‡Lleva la carta cifrada al maestro cultural Dibbs en Costasur.‡Apporter la Lettre codée au Maître des traditions Dibbs, à Austrivage.‡把密码信交给南海镇的博学者迪布斯。‡把密碼信交給南海鎮的博學者迪布斯。',
  }
},
[512] = {
  {
    'Mortes nobres‡Благородные смерти‡Tod der Edlen‡지휘부 처치‡Nobles muertes‡Nobles muertes‡Nobles morts‡贵族之死‡貴族之死',
    nil,
    'Leve 7 Anéis-sinete de Alterac para o Magistrado Maleb na Costa Sul.‡Принесите 7 альтеракских перстней-печаток чиновнику Малебу в Южнобережье.‡Bringt 7 Alteracsiegelringe zu Magistrat Henry Maleb nach Süderstade.‡사우스쇼어에 있는 집정관 말레브에게 알터랙 인장 반지 7개를 가져가야 합니다.‡Lleva 7 sellos de Alterac al magistrado Maleb a Costasur.‡Lleva 7 sellos de Alterac al magistrado Maleb a Costasur.‡Apporter 7 Chevalières d\'Alterac au Magistrat Maleb à Austrivage.‡为南海镇的赫尼·马雷布镇长收集7个奥特兰克徽记之戒。‡為南海鎮的赫尼·馬雷布鎮長收集7個奧特蘭克璽戒。',
  }
},
[513] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve o Composto Fuçalama para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите состав Грязного Рыла мастеру-аптекарю Фаранеллу в Подгород.‡Bringt das Morastschnauzengemisch zu Apothekermeister Faranell in Unterstadt.‡언더시티에 있는 수석 연금술사 파라넬에게 진흙주둥이 합성물을 가져가야 합니다.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Lleva el compuesto Morrobarro al maestro boticario Faranell a Entrañas.‡Apporter la Poudre de fangemufle au maître apothicaire Faranell à Fossoyeuse.‡把泥头花药交给幽暗城的大药剂师法拉尼尔。‡把泥頭花藥交給幽暗城的大藥劑師法拉尼爾。',
  }
},
[514] = {
  {
    'Uma carta para Lançatroz‡Письмо Грозовой Вершине‡Brief an Sturmlanze‡스톰파이크에게 보내는 편지‡Una carta para Pico Tormenta‡Una carta para Pico Tormenta‡Le maître des lettres‡铁炉堡的译码者‡鐵爐堡的解碼者',
    nil,
    'Leve a Carta Habilmente Cifrada para o Prospector Lançatroz em Altaforja.‡Отнесите хитро зашифрованное письмо геологу Грозовой Вершине в Стальгорн.‡Bringt den geschickt verschlüsselten Brief zu Ausgrabungsleiter Sturmlanze nach Eisenschmiede.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 복잡하게 암호화된 편지를 가져가야 합니다.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Lleva la carta cifrada con ingenio al prospector Pico Tormenta a Forjaz.‡Apporter la Lettre ingénieusement codée au Prospecteur Foudrepique à Forgefer.‡把密码信带给铁炉堡的勘察员塔伯斯·雷矛。‡把密碼信帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[515] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve a Mistura Fuçalama, uma Poção Forte de Sangue de Troll, 5 Escamas de Espinhadaga e 5 Olhos de Rancapina para o Boticário Lindolfo, na Serraria Tarren.‡Отнесите микстуру грязного рыла, крепкое зелье тролльей крови, 5 чешуек наг из клана Пронзающего Гребня и 5 глаз мурлоков из племени Рваного Плавника аптекарю Лидону в Мельницу Таррен.‡Bringt die Morastschnauzenmixtur, einen starken Trollbluttrank, 5 Säbelflossenschuppen und 5 Fetzenflossenaugen zu Apotheker Lydon nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 진흙주둥이 혼합물, 강한 재생의 물약, 비수가시일족의 비늘 5개, 그리고 너덜지느러미일족의 눈 5개를 가져가야 합니다.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Lleva la mezcla Morrobarro, una poción de sangre de trol fuerte, 5 escamas Espinadaga y 5 ojos de aleta rasgados al boticario Lydon a Molino Tarren.‡Apporter le Brouet de fangemufle, une Potion de sang de troll forte, 5 Ecailles de Daguéchine et 5 Yeux d\'Ailerons déchirés à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把泥头花水、1瓶强力巨魔之血药水、5块刺脊纳迦的鳞片和5颗碎鳍鱼人的眼球交给塔伦米尔的药剂师林度恩。‡把泥頭花水、1瓶強力食人妖之血藥水、5塊刺脊納迦的鱗片和5顆碎鰭魚人的眼球交給塔倫米爾的藥劑師林度恩。',
  }
},
[516] = {
  {
    'Cilada de Beren‡Погибель Берена‡Berens List‡베렌의 동굴‡El Desafío de Beren‡El Desafío de Beren‡Le Péril de Beren‡博伦的巢穴‡博倫的巢穴',
    nil,
    'Encontre a Cilada de Beren, mate 6 Mourejantes Corvinalle e 6 Guardiões Corvinalle e depois fale novamente com o Sacerdote Sombrio Allister, no Sepulcro.‡Найдите Погибель Берена, убейте 6 чернорабочих Когтя Ворона и 6 стражей Когтя Ворона, а затем вернитесь в Гробницу к жрецу Тьмы Алистеру.‡Findet zuerst Berens List, tötet 6 Zwangsarbeiter von Rabenklaue sowie 6 Wächter von Rabenklaue und kehrt dann zu Schattenpriester Allister in das Grabmal zurück.‡베렌의 동굴에서 까마귀발톱 노역꾼 6명과 까마귀발톱 수호병 6명을 처치하고 공동묘지에 있는 어둠의사제 알리스터에게 돌아가야 합니다.‡Encuentra El Desafío de Beren y, a continuación, mata 6 braceros Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Encuentra El Desafío de Beren y, a continuación, mata 6 esclavos Corvozarpa y 6 guardianes Corvozarpa. Por último, vuelve a ver al sacerdote de las Sombras Allister en El Sepulcro.‡Localiser le Péril de Beren, tuer 6 Manouvriers Serres-de-corbeau et 6 Gardiens Serres-de-corbeau puis retourner voir le prêtre des ombres Allister au Sépulcre.‡找到博伦的巢穴，杀死6名鸦爪苦工和6名鸦爪守护者，然后向瑟伯切尔的暗影牧师奥利斯特汇报。‡找到博倫的巢穴，殺死6名鴉爪苦工和6名鴉爪守護者，然後向瑟伯切爾的暗影牧師奧利斯特彙報。',
  }
},
[517] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡苦楚藥劑',
    nil,
    'Leve o Barril de Stout do Festeiro para o Boticário Lindolfo na Serraria Tarren.‡Принесите бочонок "Землекопского крепкого" аптекарю Лидону из Мельницы Таррен.‡Bringt ein Fässchen mit Kniegräberstarkbier zu Apotheker Lydon nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사 라이던에게 신디거 스타우트 맥주통을 가져가야 합니다.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Lleva un barril de cerveza Machacacanillas al boticario Lydon de Molino Tarren.‡Apporter un Tonneau de Croquejarret brune à l\'Apothicaire Lydon à Moulin-de-Tarren.‡将一桶矿工烈酒交给塔伦米尔的药剂师林度恩。‡將一桶礦工烈酒交給塔倫米爾的藥劑師林度恩。',
  }
},
[518] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡Corona de Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意志之冠',
    nil,
    'Mate 10 Espancadores Massacristas para Melissara na Serraria Tarren.‡Убейте 10 извергов из клана Раздробленного Хребта по поручению Мелизары из Мельницы Таррен.‡Tötet 10 Raufer der Trümmergratoger für Melisara in Tarrens Mühle.‡타렌 밀농장에 있는 멜리사라를 위해 산사태일족 싸움꾼 10마리를 처치해야 합니다.‡Melisara de Molino Tarren quiere que mates a 10 aplastadores Aplastacresta.‡Melisara de Molino Tarren quiere que mates a 10 aplastadores Aplastacresta.‡Tuer 10 Marteleurs Cassecrête pour Melisara à Moulin-de-Tarren.‡塔伦米尔的梅里萨拉要你去杀掉10个破碎岭虐待者。‡塔倫米爾的梅里薩拉要你去殺掉10個破碎嶺虐待者。',
  }
},
[519] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de Voluntad‡Corona de Voluntad‡La couronne de volonté‡意志之冠‡意志之冠',
    nil,
    'Mate Targ, Revirestrume e Glommus e leve a cabeça deles para Melissara na Serraria Tarren.‡Убейте Тарга, Навозера и Гломмуса и принесите их головы Мелизаре из Мельницы Таррен.‡Tötet Targ, Muckrake und Glommus und bringt ihre Köpfe zu Melisara nach Tarrens Mühle.‡타르그, 무크라케, 글롬무스를 처치하고 그 증거로 그들의 머리카락을 타렌 밀농장에 있는 멜리사라에게 가져가야 합니다.‡Mata a Targ, Rastrazo y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Mata a Targ, Rastrazo y Glommus y lleva sus cabezas a Melisara a Molino Tarren.‡Tuer Targ, Fouilleboue et Glommus, puis apporter leurs têtes à Melisara, à Moulin-de-Tarren.‡干掉塔尔格、玛克拉克和戈洛姆斯，把他们的头带给塔伦米尔的梅里萨拉。‡幹掉塔爾格、瑪克拉克和戈洛姆斯，把他們的頭帶給塔倫米爾的梅里薩拉。',
  }
},
[520] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡意志之冠',
    nil,
    'Mate Mug\'Thol, e leve a cabeça dele com a Coroa da Vontade para Melissara na Serraria Tarren.‡Убейте Муг\'Тола и принесите его голову и корону воли Мелизаре в Мельницу Таррен.‡Tötet Mug\'Thol und bringt seinen Kopf mit der Krone des Willens zu Melisara nach Tarrens Mühle.‡무그톨을 처치하고 그 증거로 그의 머리카락과 의지의 왕관을 타렌 밀농장에 있는 멜리사라에게 가져가야 합니다.‡Mata a Jarra\'thol y lleva su cabeza con la Corona de Voluntad a Melisara a Molino Tarren.‡Mata a Jarra\'thol y lleva su cabeza con la Corona de Voluntad a Melisara a Molino Tarren.‡Tuer Mug\'Thol et présenter sa tête et la Couronne de volonté à Melisara, à Moulin-de-Tarren.‡杀了玛格索尔，带着他的脑袋和意志之冠去塔伦米尔见梅里萨拉。‡殺了瑪格索爾，帶著他的腦袋和意志之冠去塔倫米爾見梅里薩拉。',
  }
},
[521] = {
  {
    'A Coroa da Vontade‡Корона Воли‡Die Krone des Willens‡의지의 왕관‡La Corona de Voluntad‡Corona de Voluntad‡La Couronne de Volonté‡意志之冠‡',
    nil,
    'Entregue a Coroa da Vontade à Sharlindra na Cidade Baixa.‡Отнесите корону Воли Шарлиндре из Подгорода.‡Bringt die Krone des Willens zu Sharlindra in Unterstadt.‡언더시티에 있는 샬린드라에게 의지의 왕관을 가져가야 합니다.‡Ve a Entrañas para entregarle la Corona de la Voluntad a Sharlindra.‡Ve a Entrañas para entregarle la Corona de Voluntad a Sharlindra.‡Remettre la Couronne de volonté à Sharlindra, à Fossoyeuse.‡把意志之冠交给幽暗城的沙琳德拉。‡',
  }
},
[522] = {
  {
    'Contrato do assassino‡Контракт убийцы‡Auftragsmördervertrag‡청부업자의 계약서‡Contrato de asesino‡Contrato de asesino‡Contrat de l\'assassin‡刺客的契约‡刺客的契約',
    nil,
    'Leve o Contrato do Assassino ao Magistrado Maleb, na Costa Sul.‡Отнесите контракт убийцы чиновнику Малебу в Южнобережье.‡Bringt den Auftragsmördervertrag zu Magistrat Maleb nach Süderstade.‡사우스쇼어에 있는 집정관 말레브에게 청부업자의 계약서를 가져가야 합니다.‡Lleva el contrato de asesino al magistrado Maleb a Costasur.‡Lleva el contrato de asesinato al magistrado Maleb a Costasur.‡Apporter le Contrat de l\'assassin au Magistrat Maleb à Austrivage.‡把刺客的契约带给南海镇的赫尼·马雷布镇长。‡把刺客的契約帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[523] = {
  {
    'A morte do Barão‡Смерть барона‡Ableben des Barons‡바르두스 남작 심판‡Muerte al Barón‡Muerte al Barón‡La mort du baron Vardus‡男爵之死‡男爵之死',
    nil,
    'Leve a Cabeça do Barão Vardus ao Magistrado Maleb na Costa Sul.‡Принесите голову барона Вардуса чиновнику Малебу в Южнобережье.‡Bringt den Kopf von Baron Vardus zu Magistrat Maleb nach Süderstade.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 사우스쇼어에 있는 집정관 말레브에게 가져가야 합니다.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Lleva la cabeza del Barón Vardus al magistrado Maleb a Costasur.‡Apporter la tête du baron Vardus au Magistrat Maleb à Austrivage.‡把瓦杜斯男爵的头带给南海镇的赫尼·马雷布镇长。‡把瓦杜斯男爵的頭帶給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[524] = {
  {
    'O elixir da agonia‡Эликсир агонии‡Elixier der Pein‡죽음의 비약‡Elixir de agonía‡Elixir de agonía‡L\'élixir d\'agonie‡苦楚药剂‡',
    nil,
    'Coloque o Barril Estragado no tapete para os fazendeiros capturados.‡Поставьте гниющий бочонок на ковер для плененных фермеров.‡Stellt das besudelte Fässchen auf den Teppich für die gefangenen Bauern.‡오염된 맥주통을 사로잡힌 농부들이 있는 방의 양탄자 위에 가져다 놓아야 합니다.‡Coloca el barril contaminado en la alfombra para los granjeros.‡Coloca el barril contaminado en la alfombra para los granjeros.‡Placer le Baril infecté sur le tapis pour les fermiers détenus comme otages.‡把被污染的酒桶放在被俘农夫房间的地毯上。‡',
  }
},
[525] = {
  {
    'Outros mistérios‡Все больше тайн‡Weitere Geheimnisse‡깊어지는 의문‡Más misterios‡Más misterios‡D\'autres mystères‡更大的谜团‡更大的謎團',
    nil,
    'Entregue a Carta Decifrada para o Magistrado Maleb, em Costa Sul.‡Доставьте расшифрованное письмо чиновнику магистрата Южнобережья Малебу.‡Bringt den entschlüsselten Brief zu Magistrat Maleb nach Süderstade.‡사우스쇼어에 있는 집정관 말레브에게 해독된 편지를 가져가야 합니다.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Lleva la carta descifrada al magistrado Maleb a Costasur.‡Apporter la Lettre décodée au Magistrat Maleb, à Austrivage.‡把被破译的信件交给南海镇的赫尼·马雷布镇长。‡把被破譯的信件交給南海鎮的赫尼·馬雷布鎮長。',
  }
},
[526] = {
  {
    'Lingotes da forja de luz‡Слитки светлостали‡Lichtschmiedeblöcke‡라이트포지 주괴‡Lingotes Forjaluz‡Lingotes Forjaluz‡Les lingots de sancteforge‡光铸铁锭‡',
    nil,
    'Colete 5 Lingotes da Forja de Luz e fale novamente com Glorin Testaço no Pantanal.‡Найдите 5 слитков светлостали и вернитесь к Глорину Стальному Лбу в Болотину.‡Sammelt 5 Lichtschmiedeblöcke und kehrt dann zu Glorin Stahlbraue im Sumpfland zurück.‡라이트포지 주괴 5개를 모은 다음 저습지에 있는 글로린 스틸브로우에게 돌아가야 합니다.‡Reúne 5 lingotes Forjaluz y vuelve con Glorin Frenteacerada en Los Humedales.‡Reúne 5 lingotes de Forjaluz y vuelve junto a Glorin Frenteacerada en Los Humedales.‡Collecter 5 Lingots de sancteforge, puis retourner voir Glorin Front-d\'acier, dans les Paluns.‡收集5块光铸铁锭，把它们交给湿地的戈罗林·钢眉。‡',
  }
},
[527] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille de Hautebrande‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate 6 Lavradores de Eira dos Montes, 6 Fazendeiros de Eira dos Montes, o Fazendeiro Raí e o Fazendeiro Pegaz, depois apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 6 хилсбрадских батраков, 6 хилсбрадских фермеров, фермеров Рея и Гетца и возвращайтесь к Дарталии в Мельницу Таррен.‡Tötet 6 Landarbeiter des Hügellands 6 Bauern des Hügellands, Bauer Ray und Bauer Getz und meldet Euch dann wieder bei Darthalia in Tarrens Mühle.‡힐스브래드 농노 6명, 힐스브래드 농부 6명, 그리고 농부 레이와 농부 게츠를 처치한 다음 타렌 밀농장에 있는 다살리아에게 보고해야 합니다.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Mata a 6 mozos de labranza de Trabalomas y 6 granjeros de Trabalomas, al granjero Ray y al granjero Getz e informa a Darthalia en Molino Tarren.‡Tuer 6 Garçons de ferme, 6 Fermiers, le Fermier Ray et le Fermier Getz, puis retourner voir Darthalia à Moulin-de-Tarren.‡杀掉6个希尔斯布莱德雇农和6个希尔斯布莱德农夫，还有农夫雷恩和农夫盖兹，然后返回塔伦米尔向达萨利亚报告。‡殺掉6個希爾斯布萊德雇農和6個希爾斯布萊德農夫，還有農夫雷恩和農夫蓋茲，然後返回塔倫米爾向達薩利亞報告。',
  }
},
[528] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille de Hautebrande‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate 15 Camponeses de Eira dos Montes e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте 15 хилсбрадских крестьян и вернитесь к Дарталии в Мельницу Таррен.‡Tötet 15 Arbeiter des Hügellands und erstattet Bericht bei Darthalia in Tarrens Mühle.‡힐스브래드 소작농 15명을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata a 15 campesinos de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer 15 Paysans de Hautebrande et faire votre rapport à Darthalia à Moulin-de-Tarren.‡杀死15个希尔斯布莱德农民，然后回到塔伦米尔向达萨利亚汇报。‡殺死15個希爾斯布萊德農民，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[529] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille de Hautebrande‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Ferreiro Verrintão e 4 Ferreiros Aprendizes de Eira dos Montes.nnConfisque um carregamento de ferro e apresente-se novamente a Darthalia na Serraria Tarren.‡Убейте кузнеца Верринтана и 4 хилсбрадских учеников кузнеца.nnПринесите партию железа Дарталии в Мельницу Таррен.‡Tötet Schmied Verringtan und 4 Schmiedelehrlinge des Hügellands.nnBesorgt eine Eisenlieferung und erstattet Bericht bei Darthalia in Tarrens Mühle.‡대장장이 베링턴과 힐스브래드 수습대장장이 4명을 처치해야 합니다.nn철괴 상자를 찾은 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al herrero Verrintan y a 4 herreros aprendices de Trabalomas.nnRecupera un envío de hierro e informa a Darthalia en Molino Tarren.‡Mata al herrero Verringtan y a 4 herreros aprendices de Trabalomas.|nRecupera un envío de hierro e informa a Darthalia en Molino Tarren.‡Tuer le Forgeron Verringtan et 4 Apprentis Forgerons de Hautebrande.nnRécupérer un Chargement de fer, puis retourner voir Darthalia à Moulin-de-Tarren.‡杀掉铁匠维林坦和4个希尔斯布莱德见习铁匠，并从那里抢回一箱铁材，然后向塔伦米尔的达萨利亚汇报。‡殺掉鐵匠維林坦和4個希爾斯布萊德見習鐵匠，並從那裡搶回一箱鐵材，然後向塔倫米爾的達薩利亞彙報。',
  }
},
[530] = {
  {
    'A vingança do marido‡Месть мужа‡Rache eines Ehemanns‡랠리의 복수‡La venganza de un esposo‡La venganza de un esposo‡La vengeance d\'un mari‡丈夫的复仇‡',
    nil,
    'Mate Valfrido Moray.nnLeve as mãos dele para Olavo Nascimento na Cidade Baixa.‡Убейте Валдреда Морая.nnПринесите его руки Роли Андреану в Подгород.‡Tötet Valdred Moray.nnBringt seine Hände zu Raleigh Andrean nach Unterstadt.‡발드레드 모레이를 처치해야 합니다.nn그 증거로 언더시티에 있는 랠리 앤드리언에게 발드레드의 장갑을 가져가야 합니다.‡Mata a Valdred Moray.nnLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Mata a Valdred Moray.|nLlévale sus manos a Raleigh Andrean, que está en Entrañas.‡Tuer Valdred Moray.nnApporter ses mains à Raleigh Andrean à Fossoyeuse.‡杀掉瓦德雷·莫莱。nn把他的双手带给幽暗城的拉林夫·安迪恩。‡',
  }
},
[531] = {
  {
    'A vingança de Vyrin‡Месть Вайрины‡Vyrins Rache‡바이린의 복수‡La venganza de Vyrin‡La venganza de Vyrin‡La vengeance de Vyrin‡维林的报复‡',
    nil,
    'Entregue a Cabeça do Velho Fumaça para Vyrin Velozvento no Pavilhão dos Andarilhos.‡Принесите голову Старины Черношкура Вайрине Быстрый Ветер в Приют странников.‡Bringt alte Rußtatzes Kopf zu Vyrin Flinkwind in die Jagdhütte der Weltenwanderer.‡순찰자의 오두막에 있는 바이린 스위프트윈드에게 늙은곰 수티의 머리를 가져가야 합니다.‡Lleva la cabeza del viejo Sooty a Vyrin Vientoveloz a la Cabaña del Errante.‡Lleva la cabeza del viejo Tiznado a Vyrin Vientoveloz a la Cabaña del Errante.‡Amener la tête du vieux Noiraud à Vyrin Vent-vif au pavillon des pérégrins.‡把奥尔苏迪的头交给旅行者营地的维林·疾风。‡',
  }
},
[532] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Magistrado Ardelado e 4 Conselheiros de Eira dos Montes. Destrua a Proclamação de Eira dos Montes. Roube o Livro de Registro de Eira dos Montes. Depois fale novamente com Darthalia na Serraria Tarren.‡Убейте мирового судью Бернсайда, и 4 членов совета Хилсбрада. Уничтожьте хилсбрадское официальное объявление. Украдите регистрационную книгу Хилсбрада. Затем вернитесь к Дарталии в Мельницу Таррен.‡Tötet Magistrat Uferbach und 4 Ratsherren des Hügellands. Zerstört die Proklamation von Hügellandhof. Stehlt das Stadtverzeichnis von Hügellandhof. Meldet Euch danach bei Darthalia in Tarrens Mühle.‡집정관 번사이드와 힐스브래드 원로 4명을 처치해야 합니다. 힐스브래드 선언문을 파괴하고 힐스브래드 마을의 기록부를 빼내 와야 합니다. 그런 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고하십시오.‡Mata al magistrado Ladoquemado y a 4 consejeros de Trabalomas. Destruye la Declaración de Trabalomas. Saquea el registro de Trabalomas. Después informa a Darthalia en Molino Tarren.‡Mata al magistrado Ladoquemado y a 4 consejeros de Trabalomas. Acaba con la Declaración de Trabalomas. Saquea el registro de Trabalomas. Después informa a Darthalia en Molino Tarren.‡Tuer le Magistrat Burnside et 4 Conseillers de Hautebrande. Détruire la Proclamation de Hautebrande. Voler le Registre municipal de Hautebrande. Rendre compte à Darthalia à Moulin-de-Tarren.‡杀掉波恩塞德镇长和4个希尔斯布莱德议员，摧毁《希尔斯布莱德宣言》，偷取希尔斯布莱德城镇文档，然后回到塔伦米尔向达萨利亚汇报。‡殺掉波恩塞德鎮長和4個希爾斯布萊德議員，摧毀《希爾斯布萊德宣言》，偷取希爾斯布萊德城鎮文檔，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[533] = {
  {
    'Infiltração‡Шпионская работа‡Unterwanderung‡침투‡Infiltración‡Infiltración‡Infiltration‡秘密潜入‡秘密潛入',
    nil,
    'Obtenha informações sobre o paradeiro de Gol\'dir para Krusk na Serraria Tarren.‡Добудьте сведения о местонахождении Гол\'дира для Круска из Мельницы Таррен.‡Holt Informationen über Gol\'dirs Aufenthaltsort für Krusk in Tarrens Mühle ein.‡타렌 밀농장에 있는 크루스크를 위해 골디르가 어디에 있는지 정보를 찾아야 합니다.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Consigue información sobre el paradero de Gol\'dir\'s e informa a Krusk en Molino Tarren.‡Rapporter des informations sur la localisation de Gol\'dir pour Krusk, à Moulin-de-Tarren.‡把关于高迪尔下落的消息带回来给塔伦米尔的克鲁斯克。‡把關於高迪爾下落的消息帶回來給塔倫米爾的克魯斯克。',
  }
},
[535] = {
  {
    'Vito‡Валлик‡Valik‡발릭‡Valik‡Valik‡Valik‡仆从瓦里克‡僕從瓦里克',
    nil,
    'Leve um caneco de Stout da Costa Sul para Vito no acampamento da Camarilha.‡Принесите кружку эля из Южнобережья Вэллику в лагерь Синдиката.‡Bringt einen Becher mit Süderstader Starkbier zu Valik in das Lager des Syndikats.‡비밀결사대 야영지에 있는 발릭에게 사우스쇼어의 스타우트 맥주 한 잔을 가져가야 합니다.‡Llévale 1 jarra de cerveza Costasur a Valik en el campamento de la Hermandad.‡Llévale 1 jarra de cerveza de Costasur a Valik en el campamento de la Hermandad.‡Apporter une Chope de bière brune d\'Austrivage à Valik, au Camp du Syndicat.‡给辛迪加营地里的瓦里克带去一杯南海镇烈酒。‡給辛迪加營地裡的瓦里克帶去一杯南海鎮烈酒。',
  }
},
[536] = {
  {
    'Desceu pro mar‡На побережье‡Die Küste entlang‡해안의 위협‡Al lo largo de la costa‡Al lo largo de la costa‡Le long de la côte‡清理海岸‡清理海岸',
    nil,
    'Mate 10 Caçamarés Rancapinas e 10 Oráculos Rancapinas para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 волноловов из племени Порванного Плавника и 10 оракулов из племени Порванного Плавника по поручению лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Gezeitenjäger der Fetzenflossen und 10 Orakel der Fetzenflossen für Leutnant Farren Orinelle in Süderstade.‡사우스쇼어에 있는 부관 파렌 오리넬이 너덜지느러미멀록 바다사냥꾼 10마리와 너덜지느러미멀록 점쟁이 10마리를 처치해달라고 부탁했습니다.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Mata a 10 cazamareas y 10 oráculos Rompeanca por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasse-marées et 10 Oracles Aileron déchiré pour le lieutenant Farren Orinelle à Austrivage.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个碎鳍潮行鱼人和10个碎鳍智者。‡南海鎮的法爾林·奧里涅爾中尉要你去殺掉10個碎鰭獵潮魚人和10個碎鰭神諭者。',
  }
},
[537] = {
  {
    'Concílio sombrio‡Темный совет‡Der Dunkle Rat‡어둠의 의회‡Consejo oscuro‡Consejo oscuro‡Le conseil noir‡黑暗议会‡黑暗議會',
    nil,
    'Mate 4 Magos das Sombras Argus.nnLeve a Cabeça de Nagaz ao Magistrado na Costa Sul.‡Убейте 4 темных магов Недремлющего Аргуса.nnПринесите голову Нагаза мировому судье Южнобережья Малебу.‡Tötet 4 Schattenmagier der Arguswacht.nnBringt den Kopf von Nagaz zu Magistrat Maleb nach Süderstade.‡아르거스 재림회 어둠마법사 4명을 처치해야 합니다.nn그리고 나가즈를 처치한 증거로 그의 머리카락을 사우스쇼어에 있는 집정관 헨리 말레브에게 가야 합니다.‡Mata a 4 magos oscuros Argus.nnLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Mata a 4 magos de la Sombra Argus.|nLleva la cabeza de Nagaz al magistrado Maleb de Costasur.‡Tuer 4 Mages de l\'ombre d\'Argus.nnApporter la Tête de Nagaz au Magistrat Maleb à Austrivage.‡杀死4个暗影大法师。nn把纳伽兹的头带给南海镇的马雷布镇长。‡殺死4個阿古斯暗影法師。|n把納伽茲的頭帶給南海鎮的馬雷布鎮長。',
  }
},
[538] = {
  {
    'Costa Sul‡Южнобережье‡Süderstade‡사우스쇼어‡Costasur‡Costasur‡Southshore‡南海镇‡南海鎮',
    nil,
    'Fale com o Historiador Dibbs em Costa Sul.‡Поговорите с Хранителем мудрости Диббсом в Южнобережье.‡Sprecht mit dem Meister der Lehren Dibbs in Süderstade.‡사우스쇼어에 있는 현자 딥스와 대화해야 합니다.‡Habla con el maestro cultural Dibbs en Costasur.‡Habla con el maestro cultural Dibbs en Costasur.‡Parler à l\'Erudit Dibbs à Austrivage.‡与南海镇的博学者迪布斯交谈。‡與南海鎮的博學者迪布斯交談。',
  }
},
[539] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Mate o Encarregado Grilhões e 10 Mineradores de Eira dos Montes, depois apresente-se novamente a Darthalia em Serraria Tarren.‡Убейте штейгера Бондса и 10 хилсбрадских шахтеров и доложите о проделанной работе Дарталии в Мельнице Таррен.‡Tötet Großknecht Bonds sowie 10 Minenarbeiter des Hügellands und erstattet Bericht bei Darthalia in Tarrens Mühle.‡현장감독 본즈와 힐스브래드 광부 10명을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Mata al supervisor Bonds y 10 mineros de Trabalomas e informa a Darthalia en Molino Tarren.‡Tuer le Contremaître Bonds et 10 Mineurs de Hautebrande, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡杀死工头邦德斯和10个希尔斯布莱德矿工，然后回到塔伦米尔向达萨利亚汇报。‡殺死工頭邦德斯和10個希爾斯布萊德礦工，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[540] = {
  {
    'O conhecimento precisa ser preservado‡Сохранение знаний‡Wissen bewahren‡지식 보존‡Proteger el conocimiento‡Proteger el conocimiento‡L\'entretien des connaissances‡保全书籍‡保全書籍',
    nil,
    'Leve 5 Tomos Recuperados e o Livro de Couro Desgastado contendo o Braço de Gri\'lek para o Historiador Dibbs, em Costa Sul.‡Найдите 5 фолиантов и потертую кожаную книгу, называемую "Рука Гри\'лека", и принесите их хранителю мудрости Диббсу в Южнобережье.‡Bringt 5 geborgene Folianten und das abgenutzte Lederbuch, das \'Der Arm von Gri\'lek\' enthält, zum Meister der Lehren Dibbs nach Süderstade.‡되찾은 학술서 5권과 그리렉의 팔이 들어 있는 낡은 가죽 책을 사우스쇼어에 있는 현자 딥스에게 가져가야 합니다.‡Lleva 5 escritos recuperados y el libro de cuero gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Lleva 5 tomos y el libro de piel gastado que contiene El Arma de Gri\'lek al maestro cultural Dibbs a Costasur.‡Apporter 5 Tomes retrouvés, ainsi que le Livre de cuir usé « Le Bras de Gri\'lek » au Maître des traditions Dibbs, à Austrivage.‡把5本失而复得的书籍和包含《格里雷克之臂》的破旧的皮书带给南海镇的博学者迪布斯。‡把5本失而復得的書籍和包含《格里雷克之臂》的破舊的皮書帶給南海鎮的博學者迪布斯。',
  }
},
[541] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Viaje até Dun Garok e mate 8 Montanhistas, 4 Carabineiros, 2 Sacerdotes e o Capitão Monteferro, depois fale novamente com Darthalia na Serraria Tarren.‡Отправляйтесь в Дун Гарок и убейте 8 горных пехотинцев, 4 стрелков, 2 жрецов и капитана Железную Гору. После возвращайтесь к Дарталии в Мельницу Таррен.‡Begebt Euch nach Dun Garok, tötet 8 Gebirgsjäger, 4 Scharfschützen, 2 Priester sowie Hauptmann Eisenberg und erstattet danach Bericht bei Darthalia in Tarrens Mühle.‡던 가록으로 가서 던 가록 산악경비대 8명, 던 가록 소총병 4명, 던 가록 사제 2명과 부대장 아이언힐을 처치한 다음 타렌 밀농장에 있는 다살리아에게 돌아와 보고해야 합니다.‡Ve a Dun Garok y mata a 8 montaraces, 4 fusileros, 2 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Ve a Dun Garok y mata a 8 montaraces, 4 fusileros, 2 sacerdotes y al capitán Ferrocolina e informa a Darthalia en Molino Tarren.‡Aller à Dun Garok et tuer 8 Montagnards, 4 Fusiliers, 2 Prêtres et le Capitaine Colline-de-fer, puis rendre compte à Darthalia, à Moulin-de-Tarren.‡到丹加洛克去杀掉8个巡山人、4个火枪手、2个牧师，还有达伦·铁山上尉，然后回到塔伦米尔向达萨利亚汇报。‡到丹加洛克去殺掉8個巡山人、4個火槍手、2個牧師，還有達倫·鐵山上尉，然後回到塔倫米爾向達薩利亞彙報。',
  }
},
[542] = {
  {
    'Fale novamente com Milton‡Возвращение к Милтону‡Rückkehr zu Milton‡밀턴에게 돌아가기‡Vuelve con Milton‡Regresa junto a Milton‡Les livres de Milton‡向米尔顿回复‡向密爾頓回覆',
    nil,
    'Leve os Tomos de Alterac para Milton Resma, em Ventobravo.‡Отнесите фолианты Альтерака Милтону Снопу в Штормград.‡Bringt die Folianten von Alterac zu Milton Garbenbund nach Sturmwind.‡스톰윈드에 있는 밀턴 시프에게 알터랙의 학술서를 가져가야 합니다.‡Lleva los escritos sobre Alterac a Milton Gavilla a Ventormenta.‡Lleva los Tomos de Alterac a Milton Gavilla a Ventormenta.‡Apporter les Tomes d\'Alterac à Milton Sheaf à Hurlevent.‡把奥特兰克的书籍带给暴风城的米尔顿·西弗。‡把奧特蘭克的書籍帶給暴風城的密爾頓·西弗。',
  }
},
[543] = {
  {
    'A Tiara de Perenolde‡Тиара Перенольда‡Die Tiara von Perenolde‡페레놀드 티아라‡La Tiara Perenolde‡La Tiara Perenolde‡La tiare de Perenolde‡匹瑞诺德王冠‡匹瑞諾德冠冕',
    nil,
    'Leve a Tiara de Perenolde para o Conde Capistrano de Espargosa, em Ventobravo.‡Доставьте тиару Перенольда Ремингтону Риджвеллу в Штормград.‡Bringt die Tiara von Perenolde zu Remington Kronenbrunn nach Sturmwind.‡스톰윈드에 있는 레밍턴 리지웰에게 페레놀드 티아라를 가져가야 합니다.‡Lleva la Tiara Perenolde a Remington Crestabuena en Ventormenta.‡Recupera la Tiara Perenolde.‡Apporter la Tiare de Perenolde à Remington Bellornière, à Hurlevent.‡将匹瑞诺德王冠带给暴风城的雷明顿·瑞治维尔。‡將匹瑞諾德冠冕帶給暴風城的雷明頓·瑞治維爾。',
  }
},
[544] = {
  {
    'Invasão da prisão‡Взлом тюрьмы‡Gefängniseinbruch‡감옥 습격‡Colarse en la cárcel‡Colarse en la cárcel‡L\'invasion de la prison‡入室偷窃‡入室偷竊',
    nil,
    'Encontre os traidores e recupere os artefatos, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Найдите предателей и отберите у них артефакты, а потом возвращайтесь к волхву Сиянию Бездны в Мельницу Таррен.‡Findet diese Verräter, sammelt ihre Artefakte ein und kehrt dann zu Magus Leermacht nach Tarrens Mühle zurück.‡배반자들을 찾아내 유물을 되찾은 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Localiza a los traidores y recupera los objetos robados. Luego habla otra vez con el magus Vacuamirada en Molino Tarren.‡Trouver les traîtres et récupérer les artefacts, puis retourner voir le magus Toisevide à Moulin-de-Tarren.‡找到被遗忘者的叛徒，取回他们偷走的神器，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡找到被遺忘者的叛徒，取回他們偷走的神器，然後回到塔倫米爾去見魔導師沃迪恩·虛無之光。',
  }
},
[545] = {
  {
    'Patrulhas de Dalaran‡Даларанские патрули‡Patrouillen von Dalaran‡달라란 순찰‡Las patrullas de Dalaran‡Las patrullas de Dalaran‡Les patrouilles de Dalaran‡达拉然巡逻队‡達拉然巡邏隊',
    nil,
    'Mate 6 Evocadores de Dalaran e 12 Escravos Elementais, depois fale novamente com o Magus Olharvazio na Serraria Tarren.‡Убейте 6 даларанских призывателей и 12 порабощенных элементалей. Затем возвращайтесь к волхву Сиянию Бездны в Мельницу Таррен.‡Tötet 6 Beschwörer von Dalaran sowie 12 Elementarsklaven und kehrt dann zu Magus Leermacht nach Tarrens Mühle zurück.‡달라란 소환사 6명과 노예 바위 정령 12마리를 처치한 다음 타렌 밀농장에 있는 학자 워딘 보이드글레어에게 돌아가야 합니다.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Mata a 6 invocadores de Dalaran y 12 esclavos elementales. Luego vuelve a hablar con el magus Vacuamirada en Molino Tarren.‡Tuer 6 Invocateurs de Dalaran et 12 Élémentaires asservis, puis retourner voir le Magus Toisevide à Moulin-de-Tarren.‡杀掉6个达拉然召唤师和12个元素奴仆，然后回到塔伦米尔去见大法师沃迪恩·伍德格莱尔。‡殺掉6個達拉然召喚師和12個元素奴僕，然後回到塔倫米爾去見魔導師沃迪恩·虛無之光。',
  }
},
[546] = {
  {
    'Lembrancinhas da morte‡Сувениры смерти‡Andenken des Todes‡죽음의 전리품‡Recuerdos de muerte‡Recuerdos de muerte‡Souvenirs de morts‡死亡的纪念品‡死亡的紀念品',
    nil,
    'O Necroguarda Sandoval da Serraria Tarren quer 30 Crânios Humanos de Eira dos Montes.‡Страж смерти Самса из Мельницы Таррен попросил принести 30 человеческих черепов из Хилсбрада.‡Todeswache Samsa aus Tarrens Mühle will 30 menschliche Schädel aus dem Hügelland.‡타렌 밀농장에 있는 죽음의경비병 삼사가 힐스브래드 주민의 해골 30개를 가져다 달라고 부탁했습니다.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 cráneos humanos de Trabalomas.‡El Guardia de la Muerte Samsa de Molino Tarren quiere 30 calaveras humanas de Trabalomas.‡Le Nécrogarde Samsa du Moulin-de-Tarren veut 30 Crânes d\'humains de Hautebrande.‡塔伦米尔的亡灵卫兵沙穆萨想要30个希尔斯布莱德人类颅骨。‡塔倫米爾的亡靈衛兵沙穆薩想要30個希爾斯布萊德人類顱骨。',
  }
},
[547] = {
  {
    'Espada do Humberto‡Меч Гумберта‡Humberts Schwert‡험버트의 검‡La espada de Humbert‡La espada de Humbert‡Epée d\'Humbert‡亨伯特的长剑‡亨伯特的長劍',
    nil,
    'Recupere a espada do Necroguarda Humberto em Dun Garok e devolva-a para ele na Serraria Tarren.‡Найдите меч стража смерти Гумберта в Дун Гароке и верните его владельцу в Мельнице Таррен.‡Bringt das Schwert von Todeswache Humbert aus Dun Garok zu ihm nach Tarrens Mühle zurück.‡던 가록에서 죽음의경비병 험버트의 검을 되찾아 타렌 밀농장으로 돌아와 험버트에게 검을 돌려줘야 합니다.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Recoge la espada del Guardia de la Muerte Humbert en Dun Garok y llévasela a Molino Tarren.‡Retrouver l\'Epée du Nécrogarde Humbert et la lui retourner à Moulin-de-Tarren.‡从丹加洛克拿回亡灵卫兵亨伯特的长剑，然后回到塔伦米尔把剑还给他。‡從丹加洛克拿回亡靈衛兵亨伯特的長劍，然後回到塔倫米爾把劍還給他。',
  }
},
[548] = {
  {
    '‡‡‡‡‡‡‡‡<NYI> <TXT> Bloodstone Pendant',
    nil,
    nil,
  }
},
[549] = {
  {
    'PROCURA-SE: integrantes da Camarilha‡Разыскиваются: сторонники Синдиката‡GESUCHT: Syndikatspersonal‡비밀결사대원 현상 수배‡SE BUSCA: Personal de la Hermandad‡SE BUSCA: Personal de la Hermandad‡ON RECHERCHE : Personnel du Syndicat‡通缉：辛迪加成员‡懸賞:辛迪加成員',
    nil,
    'Mate 10 Ladinos da Camarilha e 10 Vigias da Camarilha. Fale novamente com a Alta-executora Darthalia na Serraria Tarren para receber sua recompensa.‡Убейте 10 разбойников и 10 сторожей из Синдиката и возвращайтесь за наградой к верховной вершительнице Дарталии в Мельницу Таррен.‡Tötet 10 Schurken des Syndikats und 10 Wachmänner des Syndikats. Kehrt danach zu Hochexekutorin Darthalia nach Tarrens Mühle zurück.‡비밀결사대 도적 10명과 비밀결사대 경비병 10명을 처치해야 합니다. 그런 다음 타렌 밀농장에 있는 고위집행관 다살리아에게 돌아가 보상금을 받으십시오.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Mata a 10 pícaros y 10 veladores de la Hermandad. La suma ejecutora Darthalia te dará tu recompensa en Molino Tarren.‡Tuez 10 Voleurs et 10 Gardiens du Syndicat, puis allez voir la Grande exécutrice Darthalia à Moulin-de-Tarren pour votre récompense.‡杀死10个辛迪加潜行者和10个辛迪加哨兵，然后回到塔伦米尔向高级执行官达萨利亚报告。‡殺死10個辛迪加盜賊和10個辛迪加哨兵，然後回到塔倫米爾向高級執行官達薩利亞報告。',
  }
},
[550] = {
  {
    'A batalha de Eira dos Montes‡Битва за Хилсбрад‡Kampf um das Hügelland‡힐스브래드 전투‡La batalla de Trabalomas‡La batalla de Trabalomas‡La bataille d\'Hillsbrad‡希尔斯布莱德之战‡希爾斯布萊德之戰',
    nil,
    'Leve a Comenda Lacrada de Darthalia para Varimatras, na Cidade Baixa.‡Отнесите запечатанное рекомендательное письмо Дарталии Вариматрасу в Подгород.‡Bringt Darthalias versiegelte Belobigung zu Varimathras nach Unterstadt.‡언더시티에 있는 바리마트라스에게 다살리아의 봉인된 추천서를 가져가야 합니다.‡Lleva la mención de honor lacrada de Darthalia a Varimathras, que está en Entrañas.‡Lleva la mención de honor lacrada de Darthalia a Bragor Puñosangre, que está en Entrañas.‡Apporter la Recommandation scellée à Varimathras à Fossoyeuse.‡把达萨利亚的奖状交给幽暗城的瓦里玛萨斯。‡把達薩利亞的獎狀交給幽暗城的瓦里瑪薩斯。',
  }
},
[551] = {
  {
    'Pergaminho encantado‡Заколдованный пергамент‡Das Verhexte Pergament‡마법의 양피지‡El papiro hechizado‡El papiro encantado‡Le Parchemin ensorcelé‡附有魔法的羊皮纸‡附有魔法的羊皮紙',
    nil,
    'Leve o Pergaminho Encantado para o Historiador Dibbs, em Costa Sul.‡Отнесите заколдованный пергамент Хранителю мудрости Диббсу в Южнобережье.‡Bringt den verschlüsselten Brief zum Meister der Lehren Dibbs nach Süderstade.‡사우스쇼어에 있는 현자 딥스에게 마법의 양피지를 가져가야 합니다.‡Lleva el pergamino hechizado al maestro cultural Dibbs en Costasur.‡Lleva el pergamino encantado al maestro cultural Dibbs a Costasur en las Laderas de Trabalomas.‡Apporter le Parchemin ensorcelé à l\'Erudit Dibbs à Austrivage.‡将这张附有魔法的羊皮纸带给南海镇的博学者迪布斯。‡將這張附有魔法的羊皮紙帶給南海鎮的博學者迪布斯。',
  }
},
[552] = {
  {
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Recupere o Bastão de Helcolar do Yeti e leve-o de volta para o Noviço Trevando, em Serraria Tarren.‡Отберите у йети жезл Гелькулара и отнесите его новобранцу Тайванду в Мельницу Таррен.‡Holt Helculars Rute von dem Yeti und bringt sie zu Novize Thaivand nach Tarrens Mühle zurück.‡설인에게서 헬쿨라의 마법봉을 되찾아 타렌 밀농장에 있는 수련사 사이반드에게 가져가야 합니다.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Róbale la Vara de Helcular a los yetis y llévasela al novicio Thaivand a Molino Tarren.‡Reprendre le Bâtonnet d\'Helcular aux yétis et la ramener au novice Thaivand à Moulin-de-Tarren.‡从雪怪手上拿回赫尔库拉的魔棒，把它交给塔伦米尔的学徒塞万德。‡從雪怪手上拿回赫爾庫拉的魔棒，把它交給塔倫米爾的學徒塞萬德。',
  }
},
[553] = {
  {
    'Uma vingança para Helcolar‡Месть Гелькулара‡Helculars Rache‡헬쿨라의 복수‡La venganza de Helcular‡La venganza de Helcular‡La vengeance d\'Helcular‡赫尔库拉的复仇‡赫爾庫拉的復仇',
    nil,
    'Carregue o Bastão de Helcolar com os poderes da Chama de Azel, da Chama de Veraz e da Chama de Uzel.nnColoque o bastão carregado na tumba de Helcolar, em Costa Sul.‡Зарядите Гелькуларов жезл силой пламени Азеля, пламени Вераза и пламени Узеля.nnВонзите заряженный жезл в гробницу Гелькулара в Южнобережье.‡Ladet die Rute von Helcular mit der Macht der Flamme von Azel, der Flamme von Veraz und der Flamme von Uzel auf.nnStoßt die aufgeladene Rute in Helculars Grab in Süderstade.‡헬쿨라의 마법봉에 아젤의 불꽃, 베라즈의 불꽃, 우젤의 불꽃의 마력을 불어넣어야 합니다.nn힘을 불어넣은 마법봉을 사우스쇼어에 있는 헬쿨라의 무덤으로 가져가야 합니다.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.nnLuego llévala a la tumba de Helcular en Costasur.‡Carga la Vara de Helcular con el poder de la Llama de Azel, la Llama de Veraz y la Llama de Uzel.|nLuego llévala a la tumba de Helcular en Costasur.‡Charger le Bâtonnet d\'Helcular des pouvoirs de la Flamme d\'Azel, de la Flamme de Veraz et de la Flamme d\'Uzel.nnEnfoncez le Bâtonnet chargé dans la tombe d\'Helcular à Austrivage.‡将埃希尔之焰、沃拉兹之焰和尤基尔之焰的力量注入赫尔库拉的魔棒。nn把经过仪式洗礼之后的魔棒带到南海镇的赫尔库拉墓地。‡將埃希爾之焰、沃拉茲之焰和尤基爾之焰的力量注入赫爾庫拉的魔棒。|n把經過儀式洗禮之後的魔棒帶到南海鎮的赫爾庫拉墓地。',
  }
},
[554] = {
  {
    'Decifração de Lançatroz‡Расшифровщик Грозовая Вершина‡Sturmlanzes Entschlüsselung‡스톰파이크의 판독‡La descodificación de Pico Tormenta‡La descodificación de Pico Tormenta‡Stormpike décode‡解码高手‡解碼高手',
    nil,
    'Leve o Pergaminho Encantado para o Prospector Lançatroz, em Altaforja.‡Отнесите заколдованный пергамент геологу Грозовой Вершине в Стальгорн.‡Bringt das verhexte Pergament zu Ausgrabungsleiter Sturmlanze nach Eisenschmiede.‡아이언포지에 있는 발굴조사단장 스톰파이크에게 마법의 양피지를 가져가야 합니다.‡Lleva el papiro hechizado al prospector Pico Tormenta a Forjaz.‡Lleva el papiro codificado al prospector Pico Tormenta a Forjaz.‡Apporter le Parchemin ensorcelé au Prospecteur Foudrepique à Forgefer.‡把附有魔法的羊皮纸带给铁炉堡的勘察员塔伯斯·雷矛。‡把附有魔法的羊皮紙帶給鐵爐堡的勘察員塔伯斯·雷矛。',
  }
},
[555] = {
  {
    'Caldo reconfortante de tartaruga‡Нежный черепаховый суп‡Milde Schildkrötensuppe‡독특한 거북이 비스크‡Sopa de tortuga reconfortante‡Sopa de tortuga reconfortante‡Bisque de tortue apaisante‡海龟汤‡海龜湯',
    nil,
    'Leve 10 peças de Carne de Tartaruga e alguns Temperos Reconfortantes para o Mestre-cuca Jessé, em Costa Sul.‡Принесите 10 кусков черепашьего мяса и немного смягчающих пряностей шеф-повару Джессену в Южнобережье.‡Bringt 10 Stücke Schildkrötenfleisch und einige feine Gewürze zu Küchenchef Jessen nach Süderstade.‡사우스쇼어에 있는 주방장 예센에게 거북이 고기 10개와 독특한 양념을 가져가야 합니다.‡Lleva 10 piezas de carne de tortuga y especias calmantes al chef Jessen a Costasur.‡Lleva 10 piezas de carne de tortuga y al chef Jessen a Costasur.‡Apporter 10 morceaux de Viande de tortue et des Epices apaisantes au Chef Jessen à Austrivage.‡给南海镇的厨师杰森带去10块海龟肉和一些舒心草。‡給南海鎮的廚師傑森帶去10塊海龜肉和一些舒心草。',
  }
},
[556] = {
  {
    'Fichas de pedra‡Каменные талисманы‡Steinmarken‡징표의 돌‡Muestras de piedra‡Muestras de piedra‡Les Runes gravées‡石雕‡石雕',
    nil,
    'Leve 10 Fichas de Pedra Gasta para o Guardião Bel\'varão, na Serraria Tarren.‡Отнесите 10 истертых каменных талисманов хранителю Бел\'варилу из Мельницы Таррен.‡Bringt 10 abgenutzte Steinmarken zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 닳아해진 징표의 돌 10개를 가져가야 합니다.‡Lleva 10 muestras de piedra desgastada al vigilante Bel\'varil de Molino Tarren.‡Lleva 10 muestras de piedra desgastada al vigilante Bel’varil de Molino Tarren.‡Apporter 10 Runes gravées au Gardien Bel\'varil à Moulin-de-Tarren.‡收集10个用旧的石雕，把它们带给塔伦米尔的看守者贝尔杜加。‡收集10個用舊的石雕，把它們帶給塔倫米爾的看守者貝爾杜加。',
  }
},
[557] = {
  {
    'Braçadeiras da vinculação‡Сковывающие браслеты‡Armschienen der Bindung‡결속의 팔보호구‡Brazales de vínculo‡Brazales de vínculo‡Les Bracelets de liaison‡地缚护腕‡地縛護腕',
    nil,
    'Leve 4 Braçadeiras do Vínculo à Terra para o Guardião Bel\'varão, na Serraria Tarren.‡Принесите 4 браслета земли хранителю Бел\'варилу из Мельницы Таррен.‡Bringt 4 Armschienen der Erdbindung zu Bewahrer Bel\'varil nach Tarrens Mühle.‡타렌 밀농장에 있는 관리인 벨바릴에게 대지 결속의 팔보호구 4개를 가져가야 합니다.‡Lleva 4 brazales de Vínculo de Tierra al vigilante Bel\'varil de Molino Tarren.‡Lleva 4 brazales de vínculo de Tierra al vigilante Bel’varil de Molino Tarren.‡Apporter 4 Brassards de liaison de terre au Gardien Bel\'varil à Moulin-de-Tarren.‡为塔伦米尔的看守者贝瓦里尔收集4个地缚护腕。‡為塔倫米爾的看守者貝瓦里爾收集4個地縛護腕。',
  }
},
[558] = {
  {
    'Autógrafo da Jaina‡Автограф Джайны‡Jainas Autogramm‡제이나의 사인‡El autógrafo de Jaina‡El autógrafo de Jaina‡L\'autographe de Jaina‡吉安娜的签名‡珍娜的簽名',
    nil,
    'Vá a Theramore para tentar conseguir o autógrafo da Grã-senhora Jaina Proudmore para o seu protegido.‡Отправляйтесь в Терамор и постарайтесь получить автограф Джайны Праудмур для своего подопечного.‡Reist nach Theramore und versucht für Euren Schützling ein Autogramm von Lady Jaina Prachtmeer zu ergattern.‡돌보고 있는 고아를 위해 테라모어로 가서 여군주 제이나 프라우드무어의 사인을 받아야 합니다.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Viaja a Theramore para intentar conseguir un autógrafo de Lady Jaina Valiente para tu pupilo.‡Allez à Theramore pour tenter d\'obtenir un autographe de dame Jaina Portvaillant pour votre protégé.‡到塞拉摩去，为你看护的孩子拿到一份吉安娜·普罗德摩尔的亲笔签名。‡',
  }
},
[559] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Colete 10 Cabeças de Murloc dos murlocs da Praia Ocidental para o Tenente Fárrio Orinelle, que está na Costa Sul.‡Соберите 10 голов мурлоков на Западном побережье по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Sammelt 10 Murlocköpfe von den Murlocs am Weststrand für Leutnant Farren Orinelle in Süderstade.‡사우스쇼어에 있는 부관 파렌 오리넬에게 서부 해안에서 멀록을 처치하고 멀록 머리 10개를 모아야 합니다.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Recoge 10 cabezas de múrloc en la Playa del Oeste por orden del teniente Farren Orinelle de Costasur.‡Collecter 10 Têtes de murlocs sur les murlocs du Rivage occidental pour le lieutenant Farren Orinelle à Austrivage.‡南海镇的法尔林·奥里涅尔中尉要你从西部海岸的鱼人身上收集10颗鱼人的头颅。‡南海鎮的法爾林·奧里涅爾中尉要你從西部海岸的魚人身上收集10顆魚人的頭顱。',
  }
},
[560] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Entregue o Saco com Cabeças de Murloc ao Delegado Trilharrubra na Costa Sul.‡Отнесите мешок с головами мурлоков маршалу Редпату в Южнобережье.‡Bringt den Sack mit den Murlocköpfen zu Marschall Rotpfad nach Süderstade.‡사우스쇼어에 있는 치안대장 레드패스에게 멀록 머리가 든 자루를 전달해야 합니다.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Entrega las cabezas de múrloc al alguacil Rutagrana de Costasur.‡Livrer le Sac de têtes de murlocs au maréchal Senterouge à Austrivage.‡把一袋鱼人的头颅交给南海镇的治安官雷德帕斯。‡把一袋魚人的頭顱交給南海鎮的治安官雷德帕斯。',
  }
},
[561] = {
  {
    'A prova de Fárrio‡Доказательство Фаррена‡Farrens Beweis‡파렌의 증거물‡La prueba de Farren‡La prueba de Farren‡La preuve de Farren‡法尔林的证据‡法爾林的證據',
    nil,
    'Fale com o Tenente Fárrio Orinelle na Costa Sul.‡Поговорите с лейтенантом Фарреном Оринелем из Южнобережья.‡Sprecht mit Leutnant Farren Orinelle in Süderstade.‡사우스쇼어에 있는 부관 파렌 오리넬과 대화해야 합니다.‡Habla con el teniente Farren Orinelle en Costasur.‡Habla con el teniente Farren Orinelle en Costasur.‡Parler au Lieutenant Farren Orinelle à Austrivage.‡和南海镇的法尔林·奥里涅尔中尉谈一谈。‡和南海鎮的法爾林·奧里涅爾中尉談話。',
  }
},
[562] = {
  {
    'Ventobravo, avante!‡Ха, Штормград!‡Sturmwind Ho!‡아, 스톰윈드!‡Cambio de destino‡Cambio de destino‡Stormwind me voilà‡升官之道‡升官之道',
    nil,
    'Mate 10 Caça-costas Espinhadaga e 10 Sirenas Espinhadaga para o Tenente Fárrio Orinelle na Costa Sul.‡Убейте 10 береговых охотников и 10 сирен из клана Пронзающего Гребня по просьбе лейтенанта Фаррена Оринеля из Южнобережья.‡Tötet 10 Küstenjäger der Säbelflossen und 10 Sirenen der Säbelflossen für Leutnant Farren Orinelle in Süderstade.‡사우스쇼어에 있는 부관 파렌 오리넬을 위해 비수가시일족 바다사냥꾼 10마리와 비수가시일족 세이렌 10마리를 처치해야 합니다.‡Mata a 10 cazacostas y 10 sirenas Espinadaga por orden del teniente Farren Orinelle de Costasur.‡Mata a 10 cazacostas y 10 sirenas Espinadaga por orden del teniente Farren Orinelle de Costasur.‡Tuer 10 Chasseurs du Rivage et 10 Sirènes Daguéchine pour le lieutenant Farren à Austrivage.‡南海镇的法尔林·奥里涅尔中尉要你去杀掉10个刺脊滩行者和10个刺脊海妖。‡南海鎮的法爾林·奧里涅爾中尉要你去殺掉10個刺脊灘行者和10個刺脊海妖。',
  }
},
[563] = {
  {
    'Transferência‡Новое назначение‡Versetzungen‡전출‡Nueva asignación‡Nueva asignación‡Nouvelle affectation‡人事调动‡人事調動',
    nil,
    'Entregue o Relatório de Fárrio para o Major Samuelson na Bastilha Ventobravo.‡Отнесите донесение Фаррена майору Самуэльсону в Крепость Штормграда.‡Bringt Farrens Bericht zu Major Samuelson in die Burg Sturmwind.‡스톰윈드 왕궁에 있는 상사 사무엘슨에게 파렌의 보고서를 전달해야 합니다.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Entrega el informe de Farren al mayor Samuelson en el Castillo de Ventormenta.‡Remettre le Rapport de Farren au major Samuelson au Donjon de Hurlevent.‡把法尔林的报告交给暴风要塞里的萨缪尔森少校。‡把法爾林的報告交給暴風要塞裡的山繆森少校。',
  }
},
[564] = {
  {
    'Ameaça cara‡Серьезная угроза‡Teure Bedrohung‡크나큰 위협‡Una amenaza costosa‡Una amenaza costosa‡Un problème très coûteux‡损失惨重‡損失慘重',
    nil,
    'Dario Malavista, da Costa Sul, quer que você mate 8 Leões da Montanha e 10 Leões da Montanha Imponentes.‡Убейте 8 горных львов и 10 крупных горных львов по поручению Даррена Малвея из Южнобережья.‡Darren Malve aus Süderstade will, dass Ihr 8 Berglöwen und 10 titanische Berglöwen tötet.‡사우스쇼어의 다렌 말뷰가 산사자 8마리와 덩치큰 산사자 10마리를 처치해 달라고 부탁했습니다.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malavista de Costasur quiere que mates 8 leones de montaña y 10 leones de montaña descomunales.‡Darren Malvew d\'Austrivage veut que vous tuiez 8 Lions des montagnes et 10 Lions des montagnes massifs.‡南海镇的达伦·玛尔维要你杀掉8只山地狮和10只巨型山地狮。‡南海鎮的達倫·瑪爾維要你殺掉8隻山地獅和10隻巨型山地獅。',
  }
},
[565] = {
  {
    'Manto de Pele de Yeti do Bartolo‡Плащ из меха йети‡Bartolos Yetifellumhang‡바르톨로의 설인 모피 망토‡Capa de piel de yeti de Bartolo‡Capa de piel de yeti de Bartolo‡La cape en fourrure de yéti de Bartolo‡巴图罗的雪人毛皮披风‡巴圖羅的雪人毛皮披風',
    nil,
    'Leve um Rolo de Lã, um Manto do Montanhista, Fio Delicado e 10 chumaços de Pele de Yeti para Bartolo Ginsetti na Costa Sul.‡Принесите Бартоло Джинсетти из Южнобережья рулон шерсти, плащ жителя холмов, тонкую нить и 10 клоков меха йети.‡Bringt Bartolo Ginsetti in Süderstade einen Wollstoffballen, einen Umhang des Hügelwächters, feinen Faden und 10 Haufen Yetifell.‡사우스쇼어에 있는 바르톨로 진세티에게 양모 두루마리 1개, 산악인의 망토, 가는 실타래, 그리고 설인 모피 10개를 가져가야 합니다.‡LLeva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Lleva una madeja de lana, una capa de montañero, hilo refinado y 10 trozos de piel de yeti a Bartolo Ginsetti a Costasur.‡Apporter à Bartolo Ginsetti d\'Austrivage une Pelote de laine, une Cape d\'homme des collines, du Fil raffiné et 10 Touffes de fourrure de yéti.‡给南海镇的巴图罗·吉塞提找一个毛布卷、一件山地披风、一股细线和10块雪人的毛皮。‡給南海鎮的巴圖羅·吉塞提找一個毛布卷、一件山地披風、一股細線和10塊雪人的毛皮。',
  }
},
[566] = {
  {
    'PROCURA-SE: Barão Vardus‡Разыскивается: Барон Вардус‡GESUCHT: Baron Vardus‡바르두스 남작 현상 수배‡SE BUSCA: Barón Vardus‡SE BUSCA: Barón Vardus‡ON RECHERCHE : baron Vardus‡通缉：瓦杜斯男爵‡懸賞:瓦杜斯男爵',
    nil,
    'Mate o Barão Vardus e entregue a cabeça dele para a Alta-executora Darthalia na Serraria Tarren.‡Убейте барона Вардуса и принесите его голову верховной вершительнице Дарталии в Мельницу Таррен.‡Tötet Baron Vardus und bringt seinen Kopf zu Hochexekutorin Darthalia in Tarrens Mühle.‡바르두스 남작을 처치하고 그 증거로 그의 머리카락을 타렌 밀농장에 있는 고위집행관 다살리아에게 가져가야 합니다.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Mata al Barón Vardus y entrega su cabeza a la suma ejecutora Darthalia en Molino Tarren.‡Tuer le baron Vardus et apporter sa tête à la Grande exécutrice Darthalia, au Moulin-de-Tarren.‡杀了瓦杜斯男爵，把他的头带给塔伦米尔的高级执行官达萨利亚。‡殺了瓦杜斯男爵，把他的頭帶給塔倫米爾的高級執行官達薩利亞。',
  }
},
[567] = {
  {
    'Perigo!‡Вооружены и очень опасны!‡Gefährlich!‡위험 인물 수배!‡¡Peligrosos!‡¡Peligrosos!‡Dangereux !‡危险！‡危險!',
    nil,
    'A Alta-executora Darthalia da Serraria Tarren está oferecendo uma recompensa pelas cabeças de Tabelião Horácio Brancorcel, Cidadão Urbano, Minerador Talhatudo e a Fazendeira Kalaba.‡Верховная вершительница Дарталия из Мельницы Таррен назначила награду за убийство клерка Горация Белоконя, гражданина Уилкса, шахтера Хакетта и фермерши Калабы.‡Hochexekutorin Darthalia in Tarrens Mühle hat ein Kopfgeld auf Amtmann Horatio Weißross, Bürger Wilkes, Minenarbeiter Hackett und Bäuerin Kalaba ausgesetzt.‡타렌 밀농장의 고위집행관 다살리아가 서기관 호레이스 화이트스티드, 민간인 윌키스, 광부 하켓, 농부 칼라바에 현상금을 걸었습니다.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horracio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La suma ejecutora Darthalia de Molino Tarren ofrece recompensa por el funcionario Horraceio Corzalbal, el ciudadano Wilkes, el minero Hackett y la granjera Kalaba.‡La Grande exécutrice Darthalia de Moulin-de-Tarren offre une prime pour la mort du Greffier Horrace Blancheval, du Citoyen Wilkes, du Mineur Hackett et de Kalaba la fermière.‡塔伦米尔的高级执行官达萨利亚悬赏通缉书记员赫拉斯·怀特斯蒂德、平民维尔克斯、矿工哈克特和农夫卡拉巴。‡塔倫米爾的高級執行官達薩利亞懸賞通緝書記員赫拉斯·懷特斯蒂德、居民維爾克斯、礦工哈克特和農夫卡拉巴。',
  }
},
[568] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 15 Raptores Batecauda.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 15 ящеров-кнутохвостов.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 15 Schmetterschwanzraptoren tötet.‡그롬골 주둔지의 사령관 아그로고쉬가 채찍꼬리랩터 15마리를 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 15 raptores colazote.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 15 Raptors flagellants.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死15只鞭尾迅猛龙。‡格羅姆高營地的指揮官阿格羅戈西要求你殺死15隻鞭尾迅猛龍。',
  }
},
[569] = {
  {
    'A defesa de Grom\'gol‡Защита Гром\'гола‡Die Verteidigung von Grom\'gol‡그롬골 방어‡La defensa de Grom\'gol‡La defensa de Grom\'gol‡La défense de Grom\'gol‡格罗姆高保卫战‡格羅姆高保衛戰',
    nil,
    'O Comandante Aggro\'gosh do Acampamento Grom\'gol quer que você mate 10 Brutamontes Ogros e 5 Mandingueiros Ogros.‡Командир Агро\'гош из лагеря Гром\'гол поручил вам убить 10 огров-громил и 5 огров-знахарей.‡Kommandant Aggro\'gosh vom Basislager von Grom\'gol will, dass Ihr 10 Ogerschläger und 5 Ogerhexendoktoren tötet.‡그롬골 주둔지에 있는 사령관 아그로고쉬가 모쉬오그일족 투사 10명과 모쉬오그일족 의술사 5명을 처치해 달라고 부탁했습니다.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡El comandante Aggro\'gosh del Campamento Grom\'gol, quiere que mates 10 toscos ogros y 5 médicos brujos ogros.‡Le commandant Aggro\'gosh du campement Grom\'gol veut que vous tuiez 10 Brutes et 5 Sorciers ogres.‡格罗姆高营地的指挥官阿格罗戈什要求你杀死10个食人魔蛮兵和5个食人魔巫医。‡格羅姆高營地的指揮官阿格羅戈西要求你殺死10個巨魔蠻卒和5個巨魔巫醫。',
  }
},
[570] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin do Acampamento Grom\'gol quer 8 Garras de Umbragorja e uma Presa Imaculada de Tigresa.‡Предсказатель Мок\'тардин из лагеря Гром\'гол попросил вас принести ему 8 когтей тенебрюхих пантер и безупречный тигриный клык.‡Scharfseher Mok\'thardin im Basislager von Grom\'gol will 8 Schattentatzenkrallen und einen makellosen Tigerinnenfangzahn.‡그롬골 기지에 있는 예언자 모크타르딘이 그림자퓨마 발톱 8개와 온전한 암호랑이의 송곳니를 가져다 달라고 부탁했습니다.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡El clarividente Mok\'thardin del Campamento Grom\'gol, quiere 8 garras Faucesombría y un colmillo de tigresa prístino.‡Le prophète Mok\'thardin du campement Grom\'gol veut que vous trouviez 8 Griffes de panthère Ombregueule et 1 Croc de tigresse en parfait état.‡格罗姆高营地的先知摩克萨尔丁要求你给他带回8只深喉猎豹的爪子和一颗雌虎的牙齿。‡格羅姆高營地的先知摩克薩爾丁要求你給他帶回8隻深喉獵豹的爪子和一顆雌虎的牙齒。',
  }
},
[571] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve um Tendão de Gorila Velho para o Clarividente Mok\'thardin em Grom\'gol.‡Принесите сухожилие старой гориллы предсказателю Мок\'тардину в лагерь Гром\'гола.‡Bringt die Sehne eines alten Gorillas zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골에 있는 예언자 모크타르딘에게 덩치큰 고릴라의 힘줄을 가져가야 합니다.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Lleva un tendón de gorila mayor al clarividente Mok\'thardin en Grom\'gol.‡Apporter un Tendon d\'Ancien gorille de Valbrume au Prophète Mok\'thardin à Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回1根成年大猩猩的肌腱。‡給格羅姆高營地的先知摩克薩爾丁帶回1根成年大猩猩的肌腱。',
  }
},
[572] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'Leve 10 Penas de Espreitador da Selva para o Clarividente Mok\'thardin no Acampamento Grom\'gol.‡Принесите 10 перьев тропических ловцов предсказателю Мок\'тардину в лагерь Гром\'гол.‡Bringt 10 Dschungelpirscherfedern zu Scharfseher Mok\'thardin nach Grom\'gol.‡그롬골 주둔지에 있는 예언자 모크타르딘에게 줄무늬정글랩터 깃털 10개를 가져가야 합니다.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Lleva 10 plumas de acechadores de la selva al clarividente Mok\'thardin en el Campamento Grom\'gol.‡Apporter 10 Plumes de Traqueurs de la jungle au Prophète Mok\'thardin au campement Grom\'gol.‡给格罗姆高营地的先知摩克萨尔丁带回10根丛林捕猎者的羽毛。‡給格羅姆高營地的先知摩克薩爾丁帶回10根叢林捕獵者的羽毛。',
  }
},
[573] = {
  {
    'O encantamento de Mok\'thardin‡Чары Мок\'тардина‡Mok\'Thardins Verzauberung‡모크타르딘의 마법‡El encantamiento de Mok\'thardin‡El encantamiento de Mok\'thardin‡Enchantement de Mok\'thardin‡摩克萨尔丁的魔法‡摩克薩爾丁的魔法',
    nil,
    'O Clarividente Mok\'thardin de Grom\'gol precisa de Água da Fonte Abençoada. Ele também quer que você mate 10 Exploradores Nagas.‡Предсказатель Мок\'тардин из лагеря Гром\'гол попросил вас принести ему воду из святого источника. Кроме того, он поручил вам убить 10 наг-исследователей.‡Scharfseher Mok\'thardin von Grom\'gol benötigt Wasser der Heiligen Quelle. Er will auch, dass Ihr 10 Forscher der Naga tötet.‡그롬골에 있는 예언자 모크타르딘에게 신성한 샘물을 가져가야 하며 나가 탐험가 10명을 처치해야 합니다.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡El clarividente Mok\'thardin de Grom\'gol necesita agua de manantial sagrado. También quiere que mates 10 expedicionarios naga.‡Le Prophète Mok\'thardin de Grom\'gol a besoin d\'Eau de source sacrée. Il veut que vous tuiez aussi 10 Explorateurs nagas.‡格罗姆高营地的先知摩克萨尔丁要你去取回一瓶圣泉之水，同时还要求你杀死10名纳迦探险者。‡格羅姆高營地的先知摩克薩爾丁要你去取回一瓶聖泉之水，同時還要求你殺死10名納迦探險者。',
  }
},
[574] = {
  {
    'Forças especiais‡Особые войска‡Spezialtruppe‡특수 부대‡Fuerzas especiales‡Fuerzas especiales‡Forces spéciales‡特种部队‡特種部隊',
    nil,
    'Mate 10 Tropas de Choque de Kurzen e 6 Encolhedores de Cabeças de Kurzen.nnFale com o Tenente Doren no Acampamento dos Rebeldes.‡Убейте 10 диверсантов и 6 охотников за головами Курцена.nnДоложите об этом лейтенанту Дорену в Лагере повстанцев.‡Tötet 10 von Kurzens Kommandosoldaten und 6 von Kurzens Kopfschrumpfer.nnErstattet Bericht bei Leutnant Doren im Rebellenlager.‡쿠르젠 특전사 10명과 쿠르젠 심리학자 6명을 처치해야 합니다.nn반란군 야영지에 있는 부관 도렌에게 보고하십시오.‡Mata 10 comandos Kurzen y 6 reductores de cabezas Kurzen.nnPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Mata 10 comandos de Kurzen y 6 reductores de cabezas de Kurzen.|nPreséntate ante el teniente Doren en el Asentamiento Rebelde.‡Tuez 10 Commandos et 6 Réducteurs de têtes de Kurzen.nnRendez compte au Lieutenant Doren au Camp rebelle.‡杀掉10名库尔森特种兵和6名库尔森精神医师。nn然后向反抗军营地的多伦上尉复命。‡殺掉10名庫爾森特種兵和6名庫爾森精神醫師。|n然後向反抗軍營地的多倫中尉覆命。',
  }
},
[575] = {
  {
    'Oferta e demanda‡Спрос и предложение‡Angebot und Nachfrage‡수요와 공급‡La oferta y la demanda‡La oferta y la demanda‡L\'offre et la demande‡供与求‡供與求',
    nil,
    'Leve 2 Peles de Crocolisco Grande do Rio para o Drizzlik na Angra do Butim.‡Принесите 2 шкуры большого речного кроколиска Дриззлику из Пиратской бухты.‡Bringt 2 große Flusskrokiliskenhäute zu Drizzlik nach Beutebucht.‡무법항에 있는 드리즐릭에게 큰 민물악어 가죽 2개를 가져가야 합니다.‡Lleva 2 pieles de crocoliscos fluviales grandes a Drizzlik en la Bahía del Botín.‡Lleva 2 pieles grandes de crocoliscos fluviales a Drizzlik en la Bahía del Botín.‡Apporter 2 Grandes peaux de crocilisque des rivières à Drizzlik, à Baie-du-Butin.‡收集2张淡水鳄的皮，把它们交给藏宝海湾的崔斯里克。‡收集2張淡水鱷的皮，把它們交給藏寶海灣的崔斯里克。',
  }
},
[576] = {
  {
    'Fique de olho‡Смотри в оба‡Ein Auge offen halten‡잃어버린 눈‡¡Ojo!‡¡Ojo!‡Gardez un œil dehors‡海盗的眼睛‡海盜的眼睛',
    nil,
    'Dizzy Caolho da Angra do Butim quer que você recupere seu olho com os Bucaneiros da Vela Sangrenta.‡Диззи Одноглазый из Пиратской бухты попросил вас отобрать его глаз у пиратов Кровавого Паруса.‡Torkel Einauge in Beutebucht möchte, dass Ihr sein Auge von den Blutsegelbukanieren zurückholt.‡무법항에 있는 애꾸눈 디지가 붉은해적단에게서 그의 눈을 찾아달라고 부탁했습니다.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy el Tuerto, en la Bahía del Botín, quiere que recuperes su ojo de los Bucaneros Velasangre.‡Dizzy le Borgne de Baie-du-Butin veut que vous récupériez son œil chez les boucaniers de la Voile sanglante.‡藏宝海湾的独眼迪兹要求你从血帆海盗那里找回他的眼睛。‡藏寶海灣的獨眼迪茲要求你從血帆海盜那裡找回他的眼睛。',
  }
},
[577] = {
  {
    'Algumas partes faltando‡Добыча шкур‡Etwas Zusammenbau benötigt‡무쇠턱 악어 가죽‡Hay que ensamblar‡Hay que ensamblar‡Un peu d\'assemblage est nécessaire‡收集鳄鱼皮‡收集鱷魚皮',
    nil,
    'Leve 5 Peles de Crocolisco Arapuca para Drizzlik na Angra do Butim.‡Отнесите 5 шкур кроколисков-хрустогрызов Дриззлику в Пиратскую Бухту.‡Bringt 5 Schnappkieferkrokiliskenhäute zu Drizzlik nach Beutebucht.‡무법항에 있는 드리즐릭에게 무쇠턱 악어 가죽 5개를 가져가야 합니다.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Lleva 5 pieles de crocoliscos Quijaforte a Drizzlik en la Bahía del Botín.‡Apporter 5 Peaux de Gueule d\'acier à Drizzlik, à Baie-du-Butin.‡给藏宝海湾的崔斯里克带回5张钳嘴鳄鱼的皮。‡給藏寶海灣的崔斯里克帶回5張鉗嘴鱷魚的皮。',
  }
},
[578] = {
  {
    'A Pedra das Marés‡Камень приливов‡Der Stein der Gezeiten‡해일의 돌‡La piedra de las mareas‡La piedra de las mareas‡La Pierre des marées‡海潮之石‡海潮之石',
    nil,
    'Encontre a ilha assombrada para o Barão Rezingada na Angra do Butim.‡По поручению барона Ревилгаза из Пиратской бухты найдите остров, населенный духами Воды.‡Findet die Spukinsel für Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈를 위해 유령의 섬을 찾아야 합니다.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Encuentra la isla encantada para el Barón Revilgaz en la Bahía del Botín.‡Localiser l\'Ile hantée pour le baron Revilgaz de Baie-du-Butin.‡为藏宝海湾的大财主里维加兹找到闹鬼的岛屿。‡為藏寶海灣的大財主里維加茲找到鬧鬼的島嶼。',
  }
},
[579] = {
  {
    'A Biblioteca de Ventobravo‡Библиотека Штормграда‡Bibliothek von Sturmwind‡스톰윈드 도서관‡La biblioteca de Ventormenta‡La biblioteca de Ventormenta‡La Bibliothèque de Stormwind‡暴风城图书馆‡暴風城圖書館',
    nil,
    '‡Король Андуин уделяет огромное внимание просвещению и всемерно заботится о том, чтобы с ценных книг вовремя делались списки, доступные горожанам. Все просто: принесите мне библиотечный свиток, и я выдам вам копию любой имеющейся книги.‡König Anduin betrachtet Lernen als sehr wichtig und hat daher Geld zur Verfügung gestellt, damit verschiedene Folianten und Schriften kopiert und für die Öffentlichkeit zugänglich gemacht werden können. Es ist ganz einfach. Ihr bringt mir einen Bibliotheksschein, und ich gebe Euch ein Exemplar eines der verfügbaren Bücher.‡안두인 국왕께서는 교육에 큰 비중을 두고 여러 가지 서적과 문서의 복사본을 만들어 대중에게 공개할 수 있도록 예산을 마련해 주셨지요. 이용하시는 방법은 아주 간단합니다. 도서관 증서를 가져오면 이곳에 있는 책의 복사본을 드리고 있습니다.‡‡‡Le Roi Anduin accorde une grand importance à l\'éducation, et c\'est pourquoi il a débloqué des fonds pour rendre accessible au public des copies de divers ouvrages et écrits. C\'est très simple. Vous me donnez un titre de bibliothécaire, et je puis vous fournir la copie de l\'un des livres disponibles.‡‡',
  }
},
[580] = {
  {
    'O grogue perdido do Aldo Isque‡Потерянный грог Алкача Виски‡Klein Whiskeys verlorener Grog‡위스키 슬림의 잃어버린 술병‡El grog de Whiskey el Delgado‡El grog de Whiskey el Delgado‡La bibine perdue de Whiskey Slim‡威士忌斯利姆的酒‡威士忌·狡黠所遺失的烈酒',
    nil,
    'Aldo Isque, na Angra do Butim, quer que você leve para ele as garrafas de Xerez de Pupellyverbos que ele perdeu.‡Алкач Виски из Пиратской бухты попросил вас принести ему потерянные бутылки портвейна "Пупелливербос".‡Klein Whiskey in Beutebucht möchte, dass Ihr ihm die Flaschen Pupellyverbos\' Portwein bringt, die er verloren hat.‡무법항에 있는 위스키 슬림이 잃어버린 퍼플리버보스 포트 와인을 찾아 달라고 부탁했습니다.‡Whiskey el Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey el Delgado, en la Bahía del Botín, quiere que le lleves las botellas de oporto Pupellyverbos que perdió.‡Whiskey Slim de Baie-du-Butin veut que vous lui rameniez les bouteilles de porto Pupellyverbos qu\'il a perdues.‡藏宝海湾的威士忌斯利姆想要你帮他找回弄丢的紫葡萄酒。‡藏寶海灣的威士忌·狡黠想要你幫他找回弄丟的紫葡萄酒。',
  }
},
[581] = {
  {
    'A caçada ao Yennikan‡Поиски Йеннику‡Die Suche nach Yenniku‡예니쿠 수색‡Caza para Yenniku‡Caza para Yenniku‡La chasse pour Yenniku‡耶尼库的下落‡耶尼庫的下落',
    nil,
    'Leve 9 Presas de Sanguescalpo para Nimboya no Acampamento Grom\'gol.‡Принесите 9 клыков троллей из племени Кровавого Скальпа Нимбойе в лагерь Гром\'гол.‡Bringt 9 Hauer der Blutskalpe zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 붉은머리부족의 어금니 9개를 가져가야 합니다.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Lleva 9 colmillos Sangrapellejo a Nimboya en el Campamento Grom\'gol.‡Amener 9 Défenses de Scalps-rouges à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带回9根血顶巨魔的獠牙。‡給格羅姆高營地的尼姆布亞帶回9根血頂食人妖的獠牙。',
  }
},
[582] = {
  {
    'Caçando cabeças‡Охота за головами‡Kopfjägerei‡인간사냥꾼‡Caza cabezas‡Caza cabezas‡La chasse aux têtes‡猎头行动‡獵頭行動',
    nil,
    'Leve 20 Cabeças Encolhidas para Nimboya, no Acampamento Grom\'gol.‡Принесите Нимбойе из лагеря Гром\'гол 20 сушеных голов.‡Bringt 20 Schrumpfköpfe zu Nimboya in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 님보야에게 쭈그러든 해골 20개를 가져가야 합니다.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Lleva 20 cabezas reducidas a Nimboya en el Campamento Grom\'gol.‡Apporter 20 Têtes réduites à Nimboya au campement Grom\'gol.‡给格罗姆高营地的尼姆布亚带去20个皱缩的头颅。‡給格羅姆高營地的尼姆布亞帶去20個皺縮頭顱。',
  }
},
[583] = {
  {
    'Boas-vindas à selva‡Добро пожаловать в джунгли‡Willkommen im Dschungel‡정글 탐험‡Bienvenido a la jungla‡Bienvenido a la jungla‡Bienvenue dans la jungle‡欢迎来到丛林‡歡迎來到叢林',
    nil,
    'Fale com o Rosarães Guima Jr.‡Поговорите с Хемингом Эрнестуэем-младшим.‡Sucht Hemet Nesingwary Jr auf und sprecht mit ihm.‡헤멧 네싱워리 2세와 대화해야 합니다.‡Habla con Hemet Nesingwary Jr.‡Habla con Hemet Nesingwary Jr.‡Parler à Hemet Nesingwary Jr.‡与赫米特·奈辛瓦里二世谈一谈。‡與小赫米特·奈辛瓦里談話。',
  }
},
[584] = {
  {
    'Cabeças do Clã Sanguescalpo‡Головы племени Кровавого Скальпа‡Köpfe des Blutskalpklans‡붉은머리부족의 머리카락‡Las cabezas de los Sangrapellejo‡Las cabezas de los Sangrapellejo‡Les têtes du clan Bloodscalp‡血顶之颅‡血頂之顱',
    nil,
    'Leve a Cabeça de Gan\'zulah e a Cabeça de Nezzliok para o caldeirão borbulhante no Acampamento Grom\'gol.‡Принесите головы Ган\'зулы и Неззилока и положите их в бурлящий котел в лагере Гром\'гол.‡Bringt Gan\'zulahs Kopf und Nezzlioks Kopf zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥에 간줄라와 네즐뤼크의 머리카락을 가져가야 합니다.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Lleva la cabeza de Gan\'zulah y la cabeza de Nezzliok a la caldera en ebullición en el Campamento Grom\'gol.‡Apporter la Tête de Gan\'zulah et la Tête de Nezzliok dans le Chaudron bouillonnant au campement Grom\'gol.‡将甘祖拉恩的头颅和奈兹里奥克的头颅带回格罗姆高营地，放入冒泡的大锅中。‡將甘祖拉恩的頭顱和奈茲里奧克的頭顱帶回格羅姆高營地，放入冒泡的大鍋中。',
  }
},
[585] = {
  {
    'Falando com Nezzliok‡Разговор с Неззилоком‡Mit Nezzliok sprechen‡네즐뤼크와의 대화‡Hablando con Nezzliok‡Hablando con Nezzliok‡En parlant avec Nezzliok‡奈兹里奥克‡奈茲里奧克',
    nil,
    'Leve um Troféu de Balia\'mah, um Troféu de Ziata\'jai e um Troféu Zul\'Mamwe para o Caldeirão Borbulhante no Acampamento Grom\'gol.‡Принесите в лагерь Гром\'гол трофей из Балиа\'ма, трофей из Зиата\'джаи и трофей из Зул\'Мамве и положите их в бурлящий котел.‡Bringt eine Trophäe von Balia\'mah, eine Trophäe von Ziata\'jai und eine Trophäe von Zul\'Mamwe zum blubbernden Kessel im Basislager von Grom\'gol.‡그롬골 주둔지에 있는 끓고 있는 가마솥으로 발리아마 전리품 해골과 지아타자이 전리품 해골, 줄맘웨 전리품 해골을 가져가야 합니다.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Lleva un trofeo de Balia\'mah, un trofeo de Ziata\'jai y un trofeo de Zul\'Mamwe a la caldera en ebullición del Campamento Grom\'gol.‡Apporter un Trophée de Balia\'mah, un de Ziata\'jai et un de Zul\'Mamwe dans le Chaudron bouillonnant au campement Grom\'gol.‡带回巴里亚曼战利品、赞塔加战利品和祖玛维战利品各一个，把它们放入格罗姆高营地里中的冒泡的大锅里。‡帶回巴里亞曼戰利品、贊塔加戰利品和祖瑪維戰利品各一個，把它們放入格羅姆高營地裡中的冒泡的大鍋裡。',
  }
},
[586] = {
  {
    'Falando com Gan\'zulah‡Разговор с Ган\'зулахом‡Mit Gan\'zulah sprechen‡간줄라와의 대화‡Hablando con Gan\'zulah‡Hablando con Gan\'zulah‡En parlant avec Gan\'zulah‡甘祖拉恩‡甘祖拉恩',
    nil,
    'Mate 8 Caçadores Rachacrânio, 6 Caçadores de Cabeças Rachacrânio e 4 Berserkers Rachacrânio.nnLeve a Armadura Quebrada de Ana\'thek para o Caldeirão Borbulhante, que fica no Acampamento Grom\'gol.‡Убейте 8 охотников, 6 охотников за головами и 4 берсерков из племени Дробителей Черепов.nnПринесите разбитые доспехи Ана\'тека к бурлящему котлу в лагере Гром\'гол.‡Tötet 8 Jäger der Schädelspalter, 6 Kopfjäger der Schädelspalter und 4 Berserker der Schädelspalter.nnBringt die zerbrochene Rüstung von Ana\'thek zum blubbernden Kessel in das Basislager von Grom\'gol.‡백골가루부족 사냥꾼 8명, 백골가루부족 인간사냥꾼 6명, 그리고 백골가루부족 광전사 4명을 처치해야 합니다.nn그롬골 주둔지에 있는 끓고 있는 가마솥으로 망가진 아나텍의 갑옷을 가져가야 합니다.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.nnLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Mata 8 cazadores Machacacráneos, 6 rebanacabezas Machacacráneos y 4 rabiosos Machacacráneos.|nLleva la armadura de Ana\'thek rota a la caldera en ebullición del Campamento Grom\'gol.‡Tuer 8 Chasseurs, 6 Chasseurs de têtes, et 4 Berserkers du clan Casse-crâne.nnApporter l\'Armure brisée d\'Ana\'thek au Chaudron bouillonnant au campement Grom\'gol.‡杀死8名劈颅猎人、6名劈颅猎头者和4名劈颅狂战士。nn将安纳希克的盔甲碎片放入格罗姆高营地中的冒泡的大锅里。‡殺死8名劈顱獵人、6名劈顱獵頭者和4名劈顱狂戰士。|n將安納希克的盔甲碎片放入格羅姆高營地中的冒泡的大鍋裡。',
  }
},
[587] = {
  {
    'Levaram o rapé‡Понюшка табака‡Auf dem Schnupftabak‡코담배를 찾아서‡Tabaco rapé‡Tabaco rapé‡Faire un tabac‡鼻烟‡鼻煙',
    nil,
    'O Dígui, na Angra do Butim, quer que você leve para ele 15 trouxinhas de Rapé.‡Диг из Пиратской бухты попросил принести ему 15 понюшек табаку.‡Deeg in Beutebucht möchte, dass Ihr ihm 15 Prisen Schnupftabak bringt.‡무법항에 있는 디그가 코담배 15개를 가져다 달라고 부탁했습니다.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 barriles de tabaco.‡Deeg, en la Bahía del Botín, quiere que le lleves 15 pizcas de tabaco.‡Deeg de Baie-du-Butin veut que vous lui apportiez 15 portions de Tabac à priser.‡藏宝海湾的迪格要求你带给他15份鼻烟。‡藏寶海灣的迪格要求你帶給他15份鼻煙。',
  }
},
[588] = {
  {
    'O destino de Yennikan‡Судьба Йеннику‡Yennikus Schicksal‡예니쿠의 생사 확인‡El destino de Yenniku‡El destino de Yenniku‡Le sort de Yenniku‡耶尼库的命运‡',
    nil,
    'Fale com Kin\'weelay.‡Поговорите с Кин\'вилаем.‡Sprecht mit Kin\'weelay.‡킨윌레이와 대화해야 합니다.‡Habla con Kin\'weelay.‡Habla con Kin\'weelay.‡Parler à Kin\'weelay.‡与肯维雷谈一谈。‡',
  }
},
[589] = {
  {
    'Os cristais cantantes‡Поющие кристаллы‡Die singenden Kristalle‡고동치는 푸른 수정‡Los cristales canto‡Los cristales canto‡Les cristaux chantants‡歌唱水晶‡歌唱水晶',
    nil,
    'Leve 3 Estilhaços Azuis Pulsantes para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 3 пульсирующих синих осколка Кин\'вилаю в лагерь Гром\'гол.‡Bringt 3 pulsierende blaue Splitter zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 고동치는 푸른 수정 3개를 가져가야 합니다.‡Lleva 3 fragmentos azules pulsantes a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 3 fragmentos azul pulsante a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 3 Éclats vibrants bleus à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回3块蓝色波光碎片。‡給格羅姆高營地的肯維雷帶回3塊藍色波光裂片。',
  }
},
[590] = {
  {
    'Palavra de ladino‡Выгодная сделка‡Ein Schurkenhandel‡도적의 거래‡Un trato de pícaro‡Un trato de pícaro‡Un marché de voleur‡潜行者的交易‡盜賊的交易',
    nil,
    'Derrote Calvino Murão em Plangemortis.‡Одержите победу в схватке с Кальвином Монтеччи в Могильнике.‡Besiegt Calvin Montague in Todesend.‡데스넬에 있는 캘빈 몬테그와 싸워서 이겨야 합니다.‡Derrota a Calvin Montesco en Camposanto.‡Derrota a Calvin Montesco en Camposanto.‡Battre Calvin Montague au Glas.‡打败丧钟镇的卡尔文·蒙泰古。‡打敗喪鐘鎮的卡爾文·蒙泰古。',
  }
},
[591] = {
  {
    'O Olho da Mente‡Око Разума‡Das Gedankenauge‡마음의 눈‡El Ojo de la mente‡El Ojo de la mente‡La Vue de l\'Esprit‡心灵之眼‡心靈之眼',
    nil,
    'Leve o Olho da Mente para Kin\'weelay, no Acampamento Grom\'gol.‡Отнесите око разума Кинвилаю в лагерь Гром\'гол.‡Bringt das Gedankenauge zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 마음의 눈을 가져가야 합니다.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Lleva el Ojo de la mente a Kin\'weelay en el Campamento Grom\'gol.‡Apporter la Vue de l\'Esprit à Kin\'weelay au Campement Grom\'gol.‡将心灵之眼交给格罗姆高营地里的肯维雷。‡將心靈之眼交給格羅姆高營地裡的肯維雷。',
  }
},
[592] = {
  {
    'Salvando Yennikan‡Спасение Йеннику‡Yennikus Rettung‡예니쿠 구출‡Salvar a Yenniku‡Salvar a Yenniku‡Il faut sauver Yenniku‡拯救耶尼库‡',
    nil,
    'Leve a Joia de Alma Plena para Nimboya.‡Отнесите Нимбойе наполненный самоцвет Души.‡Bringt den gefüllten Seelenedelstein zu Nimboya.‡님보야에게 충만한 영혼의 보석을 가져가야 합니다.‡Lleva la gema de alma llena a Nimboya.‡Lleva la gema de alma llena a Nimboya.‡Apporter la Gemme d\'âme remplie à Nimboya.‡将装满的灵魂宝石交给尼姆布亚。‡',
  }
},
[593] = {
  {
    'Enchendo a Gema Anímica‡Наполнение самоцвета Души‡Den Seelenedelstein füllen‡영혼의 보석 채우기‡Gema de alma‡Llenando la Gema de alma‡Une âme pour la Gemme‡灵魂宝石‡',
    nil,
    'Yennikan está atordoado diante de você, a mente em outro lugar...‡Йеннику стоит перед вами, и разум его витает далеко...‡Yenniku steht betäubt vor Euch, sein Geist an einem anderen Ort...‡예니쿠는 당신 앞에 기절해 있지만 그의 영혼은 다른 곳에 있습니다.‡Yenniku está aturdido justo delante de ti, pero sus pensamientos están muy lejos...‡‡Yenniku se tient étourdi devant vous, l\'esprit ailleurs…‡‡',
  }
},
[594] = {
  {
    'Mensagem na garrafa‡Послание в бутылке‡Flaschenpost‡쪽지가 든 병‡Mensaje en una botella‡Mensaje en una botella‡Message dans une bouteille‡瓶中信‡瓶中信',
    nil,
    'Encontre o autor da mensagem na garrafa.‡Отыщите автора послания в бутылке.‡Findet den Schreiber dieser Flaschenpost.‡쪽지가 든 병의 장본인을 찾아야 합니다.‡Encuentra al autor del mensaje en la botella.‡Encuentra al autor del mensaje en la botella.‡Trouver la main qui a écrit ce message lancé à la mer dans une bouteille.‡找到瓶中信的作者。‡找到瓶中信的作者。',
  }
},
[595] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Imediato Crazz quer que você cheque a enseada ao norte da Angra do Butim.‡Первый помощник Кразз попросил вас осмотреть залив на севере от Пиратской бухты.‡Erster Maat Krazz will, dass Ihr die Bucht nördlich von Beutebucht überprüft.‡일등항해사 크래즈가 무법항 북쪽의 작은 만을 조사해 달라고 부탁했습니다.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡El contramaestre Crazz quiere que eches un vistazo a la cala norte de la Bahía del Botín.‡Le Premier officier Crazz veut que vous contrôliez la crique au nord de Baie-du-Butin.‡大副克拉兹要求你去侦察一下藏宝海湾北边的海滩。‡大副克拉茲要求你去偵察一下藏寶海灣北邊的海灘。',
  }
},
[596] = {
  {
    'Colares de osso ensanguentado‡Ожерелье кровавых костей‡Blutige Knochenhalskette‡피묻은 뼈목걸이‡Collares de huesos sangrientos‡Collares de huesos sangrientos‡Les Colliers d\'os ensanglantés‡染血的白骨项链‡染血的白骨項鍊',
    nil,
    'Leve 25 Colares de Osso Ensanguentado para Kin\'weelay no Acampamento Grom\'gol.‡Принесите Кин\'вилаю 25 ожерелий кровавых костей в лагерь Гром\'гол.‡Bringt 25 blutige Knochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 피묻은 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de huesos sangrientos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os ensanglantés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串染血的白骨项链。‡給格羅姆高營地的肯維雷帶回25串染血的白骨項鍊。',
  }
},
[597] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate suas descobertas ao Imediato Crazz na Angra do Butim.‡Отнесите находку первому помощнику Краззу в Пиратскую Бухту.‡Berichtet dem ersten Maat Krazz in Beutebucht von Euren Funden.‡무법항에 있는 일등항해사 크래즈에게 조사 결과를 보고해야 합니다.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Informa sobre tus descubrimientos al contramaestre Crazz en la Bahía del Botín.‡Rendre compte de vos découvertes au Premier officier Crazz à Baie-du-Butin.‡将你的发现报告给藏宝海湾的大副克拉兹。‡將你的發現報告給藏寶海灣的大副克拉茲。',
  }
},
[598] = {
  {
    'Colar de Osso Partido‡Ожерелье расколотых костей‡Spaltknochenhalskette‡부서진 뼈목걸이‡Collar de hueso partido‡Collar de hueso partido‡Collier d\'os brisés‡裂骨项链‡裂骨項鍊',
    nil,
    'Leve 25 Colares de Osso Partido para Kin\'weelay no Acampamento Grom\'gol.‡Принесите 25 ожерелий расколотых костей Кин\'вилаю в лагерь Гром\'гол.‡Bringt 25 Spaltknochenhalsketten zu Kin\'weelay in das Basislager von Grom\'gol.‡그롬골 주둔지에 있는 킨윌레이에게 부서진 뼈목걸이 25개를 가져가야 합니다.‡Lleva 25 collares de hueso partido a Kin\'weelay en el Campamento Grom\'gol.‡Lleva 25 collares de hueso partidos a Kin\'weelay en el Campamento Grom\'gol.‡Apporter 25 Colliers d\'os brisés à Kin\'weelay au Campement Grom\'gol.‡给格罗姆高营地的肯维雷带回25串裂骨项链。‡給格羅姆高營地的肯維雷帶回25串裂骨項鍊。',
  }
},
[599] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'Relate ao Mestre de Frota Chifre do Mar o ataque planejado pelos Vela Sangrenta.‡Сообщите о запланированном нападении Кровавого Паруса командиру флота Морскому Рогу.‡Erstattet Flottenmeister Seehorn Bericht über den geplanten Angriff der Blutsegelbukaniere.‡함장 시혼에게 붉은해적단의 공격 계획을 보고해야 합니다.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Informa del ataque planeado de los Velasangre al maestro de flota Cuernomarino.‡Rendre compte de l\'attaque que prépare la Voile sanglante à l\'amiral Corne-de-mer.‡把血帆海盗的计划报告给舰队指挥官卡拉·海角。‡把血帆海盜的計畫報告給艦隊指揮官卡拉·海角。',
  }
},
[600] = {
  {
    'Mineração da Empreendimentos S.A.‡Рудник Торговой Компании‡Venture Company-Bergbau‡투자개발회사 채광‡La minería de Ventura y Cía.‡La minería de Ventura y Cía.‡La mauvaise mine de la KapitalRisk‡风险投资公司‡風險投資公司的採礦行為',
    nil,
    'Leve 10 Cristais Azuis Canoros para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской бухты 10 синих Поющих кристаллов.‡Bringt 10 singende blaue Kristalle zu Crank Zischelbub nach Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 노래하는 파란 수정 10개를 가져가야 합니다.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 10 cristales canto azules a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 10 Cristaux bleus chantants à Grincheux Bullévente, à Baie-du-Butin.‡给藏宝海湾的克兰克·菲兹巴布带回10块蓝色歌唱水晶。‡給藏寶海灣的克蘭克·菲茲巴布帶回10塊藍色歌唱水晶。',
  }
},
[601] = {
  {
    'Elementais da água‡Элементали воды‡Wasserelementare‡물의 정령‡Elementales de agua‡Elementales de agua‡Les élémentaires d\'eau‡水元素‡水元素',
    nil,
    'Consiga 6 Braçadeiras de Elementais da Água para o Barão Rezingada na Angra do Butim.‡Принесите барону Ревилгазу в Пиратскую Бухту 6 браслетов элементалей воды.‡Holt 6 Wasserelementararmschienen für Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈를 위해 물의정령 족쇄 6개를 가져와야 합니다.‡Consigue 6 brazales de elemental de agua para el Barón Revilgaz en la Bahía del Botín.‡Consigue 6 brazales de elementales de agua para el Barón Revilgaz en la Bahía del Botín.‡Acquérir 6 Bracelets d\'élémentaires d\'eau pour le baron Revilgaz à Baie-du-Butin.‡为藏宝海湾的大财主里维加兹收集6个水元素护腕。‡為藏寶海灣的大財主里維加茲收集6個水元素護腕。',
  }
},
[602] = {
  {
    'Análise mágica‡Магический анализ‡Magische Analyse‡마법 분석‡Análisis mágico‡Análisis mágico‡Analyse magique‡魔法分析‡魔法分析',
    nil,
    'Leve as braçadeiras de elementais da água ao Arquimago Ansirem Tecerrunas em Dalaran.‡Отнесите браслеты элементалей воды верховному магу Ансарему Руноплету в Даларан.‡Bringt die Wasserelementararmschienen nach Dalaran zu Erzmagier Ansirem Runenweber.‡달라란에 있는 마법사에게 물의정령 족쇄가 든 가방을 가져가야 합니다.‡Lleva los brazales de elemental de agua al archimago Ansirem Tejerruna en Dalaran.‡Lleva los brazales de elementales de agua al archimago Ansirem Tejerruna en el Cráter de Dalaran.‡Apporter les Bracelets d\'élémentaire d\'eau à l\'archimage Ansirem Tisserune à Dalaran.‡将水元素护腕交给达拉然的大法师安斯雷姆·鲁因维沃尔。‡將水元素護腕交給達拉然的大法師安斯雷姆·魯因維沃爾。',
  }
},
[603] = {
  {
    'Chave de Ansirem‡Ключ Ансарема‡Ansirems Schlüssel‡앤자이럼의 열쇠‡Llave de Ansirem‡Llave de Ansirem‡La Clé d\'Ansirem‡安斯雷姆的钥匙‡安斯雷姆的鑰匙',
    nil,
    'Fale com Fátia na Angra do Butim.‡Поговорите с Кателиной в Пиратской бухте.‡Sprecht mit Catelyn in Beutebucht.‡무법항에 있는 케이틀린과 대화해야 합니다.‡Habla con Catelyn en la Bahía del Botín.‡Habla con Catelyn en la Bahía del Botín.‡Parler à Catelyn à Baie-du-Butin.‡与藏宝海湾的凯特琳谈一谈。‡與藏寶海灣的凱特琳談話。',
  }
},
[604] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar na Angra do Butim quer que você mate 10 Espadachins da Vela Sangrenta e traga de volta as Cartas de Navegação da Vela Sangrenta e as Ordens da Vela Sangrenta.‡Командир флота Морской Рог попросил вас убить 10 висельников из шайки Кровавого Паруса и принести ему карты и приказы Кровавого Паруса.‡Flottenmeister Seehorn in Beutebucht will, dass Ihr 10 Schwadroneure der Blutsegelbukaniere tötet und die Blutsegelkarten sowie die Blutsegelbefehle zurückbringt.‡무법항에 있는 함장 시혼이 붉은해적단 칼잡이 10명을 처치하고 붉은해적단의 해도와 붉은해적단의 명령서를 가지고 와 달라고 부탁했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 espadachines Velasangre y le lleves las cartas de navegación y las órdenes de los Velasangre.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates 10 espadachines Velasangre y le lleves las cartas de navegación y las órdenes de los Velasangre.‡L\'amiral Corne-de-mer à Baie-du-Butin veut que vous tuiez 10 Bretteurs de la Voile sanglante et que vous rapportiez les Cartes de la Voile sanglante et les Ordres de la Voile sanglante.‡藏宝海岸的舰队指挥官卡拉·海角要求你杀死10名血帆流氓并将血帆海图和血帆计划书带回去。‡藏寶海岸的艦隊指揮官卡拉·海角要求你殺死10名血帆劍客並將血帆海圖和血帆計畫書帶回去。',
  }
},
[605] = {
  {
    'Estilhaços azuis cantantes‡Осколки Поющих кристаллов‡Singende blaue Splitter‡노래하는 수정 조각‡Fragmentos de cristales canto azules‡Fragmentos de cristales canto azules‡Les éclats bleus chantants‡歌唱水晶碎片‡藍色歌唱水晶裂片',
    nil,
    'Leve 10 Estilhaços de Cristal Cantante para Cranque Mirrabolha.‡Принесите Шиззи Пуззыриксу 10 осколков Поющих кристаллов.‡Bringt 10 singende Kristallsplitter zu Crank Zischelbub.‡크랭크 피즐버브에게 노래하는 수정 조각 10개를 가져가야 합니다.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Lleva 10 fragmentos de cristales canto a Loquillo Pinchabujas.‡Apporter 10 Éclats de cristal chantant à Grincheux Bullévente.‡为克兰克·菲兹巴布收集10块歌唱水晶碎片。‡為克蘭克·菲茲巴布收集10塊歌唱水晶裂片。',
  }
},
[606] = {
  {
    'Fazendo o Sacode tremer‡Напугать трусишку‡Zitterhand Angst einjagen‡겁쟁이‡Asusta a Trémulo‡Asusta al Trémulo‡Effrayer Philippe le Chancelant‡吓唬病鬼‡嚇唬病鬼',
    nil,
    'Leve 5 Miúdos de Gorila do Vale da Névoa para "Phillipe "Sacode" na Angra do Butim.‡Отнесите 5 потрохов горилл из Мглистой долины Филиппу "Трусишке" в Пиратскую Бухту.‡Bringt 5 Nebeltalinnereien zu "Zitterhand" Phillipe nach Beutebucht.‡무법항에 있는 겁쟁이 필립에게 안개계곡고릴라 내장 5개를 가져가야 합니다.‡Lleva 5 menudillos de Velo de Bruma al "Trémulo" Phillipe en la Bahía del Botín.‡Lleva 5 menudillos de Velo de Bruma a Phillipe el "Trémulo" en la Bahía del Botín.‡Apporter 5 Abats de Valbrume à Phillippe le Chancelant à Baie-du-Butin.‡给藏宝海湾的"病鬼"菲利普带回5块薄雾谷猩猩的内脏。‡給藏寶海灣的『病鬼』菲力浦帶回5塊迷霧谷猩猩的內臟。',
  }
},
[607] = {
  {
    'Fale novamente com MacKinley‡Возвращение к МакКинли‡Rückkehr zu MacKinley‡맥킨리에게 돌아가기‡Vuelve con MacKinley‡Regresa junto a MacKinley‡De retour chez MacKinley‡向马克基雷回报‡向馬克基雷回報',
    nil,
    'Leve o Pagamento do Sacode para o MacKinley "Lobo do Mar".‡Отнесите плату Трусишки "Морскому волку" Маккинли.‡Bringt Zitterhands Bezahlung zu "Seewolf" MacKinley.‡\'바다늑대\' 맥킨리에게 겁쟁이 필립의 빚진 돈을 가져가야 합니다.‡"Lleva el pago de Trémulo a "Lobo de Mar" MacKinley".‡Lleva el pago del Trémulo a "Lobo de Mar" MacKinley.‡Apporter le Paiement de Philippe le Chancelant à MacKinley "Loup des mers".‡将菲利浦的还款交给"海狼"马克基雷。‡將病鬼的還款交給『海狼』馬克基雷。',
  }
},
[608] = {
  {
    'Os bucaneiros da Vela Sangrenta‡Пираты Кровавого Паруса‡Die Blutsegelbukaniere‡붉은해적단‡Bucaneros Velasangre‡Bucaneros Velasangre‡Les boucaniers de la Voile sanglante‡血帆海盗‡血帆海盜',
    nil,
    'O Mestre de Frota Chifre do Mar em Angra do Butim quer que você mate o Capitão Tranquiláguas, o Capitão Querena e o Mestre de Frota Firalião.‡Командир флота Морской Рог попросил вас убить капитана Штиллеца, капитана Кильвателя и командира флота Фираллона.‡Flottenmeister Seehorn in Beutebucht will, dass Ihr Kapitän Stillwasser, Käpt\'n Kielhol und Flottenmeister Firallon tötet.‡무법항에 있는 함장 시혼이 선장 스틸워터, 선장 킬하울과 함장 피랠론을 암살해 달라고 부탁했습니다.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡El maestro de flota Cuernomarino en la Bahía del Botín quiere que mates al capitán Aguasmansas, al capitán Sinquilla y al maestro de flota Firallon.‡L\'amiral Corne-de-mer de Baie-du-Butin veut que vous tuiez le capitaine Eau-plate, le capitaine Soulaquille et l\'amiral Firallon.‡藏宝海湾的舰队指挥官卡拉-海角要求你杀死血帆海盗的斯蒂沃特船长，尼哈鲁船长和舰队指挥官菲尔拉伦。‡藏寶海灣的艦隊指揮官卡拉·海角要求你殺死血帆海盜的斯蒂沃特船長，尼哈魯船長和艦隊指揮官菲爾拉倫。',
  }
},
[609] = {
  {
    'Vodu devido‡Должники вуду‡Voodooschulden‡빚 돌려받기‡El vudú debido‡El vudú debido‡Gages vaudou‡讨债行动‡討債行動',
    nil,
    'Leve o Pé-de-clava do Maury, a Luneta Dourada de Janjão e o Anel Enorme do Chucky para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите деревянную ногу Моури, золотую подзорную трубу Джон-Джона и огромное кольцо Чаки "Морскому волку" Маккинли в Пиратскую Бухту.‡Bringt Maurys Klumpfuß, Jon-Jons goldenes Handfernrohr und Chuckys gewaltigen Ring zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 의족, 존존의 황금 망원경과 처키의 큰 반지를 가져가야 합니다.‡Lleva la pata de palo de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Lleva la pata de palo de Maury, el catalejo dorado de Jon-Jon y el anillo enorme de Chucky a "Lobo de Mar" MacKinley en la Bahía del Botín.‡Apporter le Fléau de Maury, la Longue-vue dorée de Jon-Jon, et le Grand anneau de Chucky à MacKinley "Loup des mers" à Baie-du-Butin.‡给藏宝海湾的"海狼"马克基雷带回玛雷的畸形足、乔乔的金色望远镜和苏克的巨型戒指。‡給藏寶海灣的『海狼』馬克基雷帶回瑪雷的木腳、喬喬的金色望遠鏡和蘇克的巨型戒指。',
  }
},
[610] = {
  {
    'Duncan "Bonitão"‡"Красавчик" Дункан‡Schönling Duncan‡"꽃미남" 던컨‡El Guapo" Duncan‡El Guapo" Duncan‡Duncan "le Beau garçon"‡帅小伙子邓肯‡『漂亮男孩』鄧肯',
    nil,
    'Recupere a adaga de Fátia com Duncan "Bonitão".‡Отберите меч Кателины у "Красавчика" Дункана.‡Holt Catelyns Dolch von "Schönling" Duncan.‡"꽃미남" 던컨에게서 케이틀린의 단검을 되찾아야 합니다.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Consigue la daga de Catelyn de "El Guapo" Duncan.‡Récupérer la Dague de Catelyn auprès de Duncan le "Beau garçon".‡从"帅小伙子"邓肯那里夺回凯特琳的匕首。‡從『漂亮男孩』鄧肯那裡奪回凱特琳的匕首。',
  }
},
[611] = {
  {
    'A maldição das marés‡Проклятье приливов‡Der Fluch der Gezeiten‡해일의 저주‡La maldición de las mareas‡La maldición de las mareas‡La malédiction des marées‡海潮的诅咒‡海潮的詛咒',
    nil,
    'Destrua o Altar das Marés com a Lâmina de Fátia, mate Gazban e leve a Pedra das Marés e a Lâmina de Fátia para o Barão Rezingada.‡Уничтожьте Алтарь Приливов при помощи меча Кателины, убейте Газбана и принесите Камень Приливов и меч Кателины барону Ревилгазу.‡Zerstört den Altar der Gezeiten mit Catelyns Klinge, tötet Gazban und bringt dann den Stein der Gezeiten sowie Catelyns Klinge zurück zu Baron Revilgaz.‡케이틀린의 검으로 해일의 제단을 파괴한 다음 가즈반을 처치하고 해일의 돌과 케이틀린의 검을 남작 레빌가즈에게 가져가야 합니다.‡Destruye el Altar de las Mareas con la hoja de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la hoja de Catelyn al Barón Revilgaz.‡Destruye el Altar de las Mareas con la daga de Catelyn, mata a Gazban y lleva la Piedra de las Mareas y la daga de Catelyn al Barón Revilgaz.‡Détruire l\'Autel des Marées avec la Lame de Catelyn, tuer Gazban et rapporter la Pierre des Marées et la Lame de Catelyn au baron Revilgaz.‡用凯特琳的匕首摧毁海潮祭坛，然后杀死加兹班，将海潮之石带给大财主里维加兹。‡用凱特琳之刃摧毀海潮祭壇，然後殺死加茲班，將海潮之石帶給大財主里維加茲。',
  }
},
[613] = {
  {
    'Abrindo o pé do Maury‡Вскрыть ногу Моури‡Maurys Fuß aufbrechen‡마우리의 의족 열기‡Abrir la pata de Maury‡Abrir la pata de Maury‡Le pied-bot de Maury‡玛雷的腿‡打開瑪雷的木腳',
    nil,
    'Leve a Chave de Maury para MacKinley "Lobo do Mar" na Angra do Butim.‡Принесите "Морскому Волку" Маккинли из Пиратской бухты ключ Моури.‡Bringt Maurys Schlüssel zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 마우리의 열쇠를 가져가야 합니다.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Lleva la llave de Maury a "Lobo de Mar" Mackinley en la Bahía del Botín.‡Apporter la Clé de Maury à MacKinley "Loup des mers" à Baie-du-Butin.‡把玛雷的钥匙带给藏宝海湾的"海狼"马克基雷。‡把瑪雷的鑰匙帶給藏寶海灣的『海狼』馬克基雷。',
  }
},
[614] = {
  {
    'O baú do capitão‡Сундук капитана‡Die Truhe des Kapitäns‡선장의 상자‡El cofre del Capitán‡El cofre del Capitán‡Le coffre du capitaine‡船长的箱子‡船長的箱子',
    nil,
    'Leve o Baú do Smotts para Hacklebury Smotts na Angra do Butim.‡Верните Гекельберри Шмотту из Пиратской бухты его сундук.‡Bringt Smotts\' Truhe zu Hecklebury Smotts nach Beutebucht.‡무법항에 있는 허클베리 스모츠에게 스모츠의 상자를 가져가야 합니다.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Lleva el cofre de Smotts a Hecklebury Smotts en la Bahía del Botín.‡Apporter le Coffre au capitaine Hecklebury Smotts à Baie-du-Butin.‡将斯莫特的箱子交给藏宝海湾的海克拜瑞·斯莫特。‡將斯莫特的箱子交給藏寶海灣的海克拜瑞·斯莫特。',
  }
},
[615] = {
  {
    'O alfanje do capitão‡Капитанская сабля‡Der Entersäbel des Kapitäns‡선장의 커틀라스‡El alfanje del Capitán‡El alfanje del Capitán‡Le sabre du capitaine Smott‡船长的弯刀‡',
    nil,
    'Fale com Zero.‡Поговорите с Салагой.‡Sprecht mit Knirpsens.‡스프로거와 대화해야 합니다.‡Habla con Tardo.‡Habla con Tardo.‡Parler à Bizutard.‡与斯普罗格谈一谈。‡',
  }
},
[616] = {
  {
    'A ilha assombrada‡Остров духов‡Die Spukinsel‡유령의 섬‡La isla fantasma‡La isla fantasma‡L\'île hantée‡幽灵岛‡幽靈島',
    nil,
    'Fale com o Barão Rezingada na Angra do Butim.‡Поговорите с бароном Ревилгазом в Пиратской бухте.‡Sprecht mit Baron Revilgaz in Beutebucht.‡무법항에 있는 남작 레빌가즈와 대화해야 합니다.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Habla con el Barón Revilgaz en la Bahía del Botín.‡Parler au Baron Revilgaz, à Baie-du-Butin.‡与藏宝海湾的大财主里维加兹谈一谈。‡與藏寶海灣的大財主里維加茲談話。',
  }
},
[617] = {
  {
    'Akiris aos montes‡Кипы акириса‡Bündelweise Akiris‡아키리스 묶음‡Fardo de cañas akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡一捆海蛇草',
    nil,
    'Leve 10 Feixes de Junco de Akiris para o Corsário Bloads na Angra do Butim.‡Принесите каперу Блоудсу из Пиратской бухты 10 свертков со стеблями акириса.‡Bringt 10 Stängel Akirisschilfrohr zu Freibeuter Plust nach Beutebucht.‡무법항에 있는 선원 블로즈에게 아키리스 갈대 묶음 10개를 가져가야 합니다.‡Consigue 10 fardos de cañas akiris para el corsario Bloads en Bahía del Botín.‡Consigue 10 fajos de junco akiris para el corsario Bloads en Bahía del Botín.‡Apporter 10 Roseaux akiris au Corsaire Bloads à Baie-du-Butin.‡给藏宝海湾的海盗布劳兹带回10根海蛇草。‡給藏寶海灣的私掠者布勞茲帶回10捆海蛇草。',
  }
},
[618] = {
  {
    'Confrontando Negolash‡Бой с Неголашем‡Negolash entgegentreten‡네골라쉬와의 대적‡Enfréntate a Negolash‡Enfréntate a Negolash‡Face à Negolash‡挑战奈古拉什‡挑戰奈古拉什',
    nil,
    'Leve 10 Asas de Urubu Grelhadas e 5 garrafas de Vinho Selvavinha até o bote salva-vidas do Capitão Smotts.nnMate Negolash e leve o Alfanje de Smotts para o Capitão Smotts na Selva do Espinhaço.‡Отнесите 10 жареных крылышек канюка и 5 бутылок экзотического вина в спасательную шлюпку капитана Шмотта.nnУбейте Неголаша и отнесите абордажную саблю Шмотта хозяину в Тернистую долину.‡Bringt 10 gegrillte Bussardflügel und 5 Flaschen Dschungelrankenwein zu Käpt\'n Smotts Rettungsboot.nnTötet Negolash und bringt Smotts\' Entersäbel zu Käpt\'n Smotts ins Schlingendorntal.‡선장 스모츠의 구명정에 대머리수리 날개 구이 10개와 밀림포도나무 와인 5병을 가져가야 합니다.nn네골라쉬를 처치하고 가시덤불 골짜기에 있는 선장 스모츠에게 스모츠의 커틀라스를 가져가십시오.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.nnMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Lleva 10 Alas de águila ratonera a la parrilla y 5 botellas de vino de vid de jungla al barco salvavidas del capitán Smotts.|nMata a Negolash y lleva el alfanje de Smotts al capitán Smotts en Tuercespina.‡Apporter 10 Ailes de busard grillées et 5 bouteilles de Vin de Junglevine dans le Canot de sauvetage du capitaine Smotts.nnTuer Negolash, et apporter le Sabre d\'abordage de Smotts au capitaine Smotts, à Strangleronce.‡将10块烧烤秃鹰翅膀和5瓶密林葡萄酒带到斯莫特船长的救生艇上去。nn然后杀死奈古拉什，将斯莫特的弯刀交给荆棘谷的斯莫特船长。‡將10塊燒烤禿鷲翅膀和5瓶密林葡萄酒帶到斯莫特船長的救生艇上去。|n然後殺死奈古拉什，將斯莫特的彎刀交給荊棘谷的斯莫特船長。',
  }
},
[619] = {
  {
    'A sedução de Negolash‡Приманка для Неголаша‡Negolash anlocken‡네골라쉬 유인‡La tentación de Negolash‡La tentación de Negolash‡Allécher Negolash‡引诱奈古拉什‡',
    nil,
    'É um bote salva-vidas abandonado, que traz na lateral, em pintura descascada e esmaecida, a inscrição:nn"Vingança de Smotts"‡Перед вами брошенная спасательная шлюпка. На борту у нее красуется полустертая поблекшая надпись:nn"Месть Шмотта".‡Dies ist ein verlassenes Rettungsboot. An seiner Seite stehen in zerkratzten, verblassten Buchstaben die Worte:nn"Smotts\' Revenge"‡버려진 구명정입니다. 보트 옆에는 긁히고 빛 바랜 페인트로 다음과 같이 쓰여 있습니다.nn"스모츠의 복수"‡Es un barco salvavidas abandonado. En el casco, escritas con pintura descascarillada y apagada, se pueden leer las palabras:nn"La venganza de Smotts"‡‡C\'est un canot de survie abandonné. Le long de son flanc, on peut lire des lettres pâles et délavées qui disent :nn"La Revanche de Smott"‡‡',
  }
},
[620] = {
  {
    'A Faixa com Monograma‡Кушак с монограммой‡Die Schärpe mit Monogramm‡이니셜이 새겨진 머리띠‡El fajín con monogramas‡‡L\'écharpe à monogramme‡刺着字母的腰带‡刺著字母的束帶',
    nil,
    'Devolva a Faixa com Monograma ao proprietário.‡Верните кушак с монограммой владельцу.‡Bringt die Schärpe mit Monogramm zu ihrem Besitzer zurück.‡이니셜이 새겨진 머리띠를 주인에게 돌려줘야 합니다.‡Devuelve el fajín con monograma a su propietario.‡Devuelve la banda con monograma a su propietario.‡Rendre l\'Écharpe à monogramme à son propriétaire.‡将刺着字母的腰带还给他的主人。‡將刺著字母的束帶還給他的主人。',
  }
},
[621] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Leve 12 amostras do Preparado de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской бухты 12 образцов смеси Занзила.‡Bringt 12 Proben von Zanzils Mixtur zu Crank Zischelbub nach Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 12 Échantillons de Mixture de Zanzil à Grincheux Bullévente à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[622] = {
  {
    'Fale novamente com o Cabo Kaleb‡Возвращение к капралу Калебу.‡Rückkehr zu Korporal Kaleb‡하사관 칼레브에게 돌아가기‡Vuelve con el cabo Kaleb‡Regresa junto al cabo Kaleb‡La cocotte du caporal Kaleb‡向卡雷布下士回报‡向卡雷布下士回報',
    nil,
    'Leve a Caçarola Melhorada do Krazek para o Cabo Kaleb no Acampamento dos Rebeldes.‡Отнесите целый горшок Крейвела капралу Калебу в Лагерь повстанцев.‡Bringt Krazeks reparierten Topf zu Korporal Kaleb im Rebellenlager.‡반란군 야영지에 있는 하사관 칼레브에게 크라젝의 수리된 냄비를 가져가야 합니다.‡Lleva la olla de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Apporter la Cocotte réparée de Krazek au caporal Kaleb, au Camp rebelle.‡将修理过的烹调锅交给叛军营地的卡雷布下士。‡將修理過的烹調鍋交給反抗軍營地的卡雷布下士。',
  }
},
[623] = {
  {
    'Akiris aos montes‡Кипы акириса‡Bündelweise Akiris‡아키리스 묶음‡Fardo de cañas akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡一捆海蛇草',
    nil,
    'Leve um Feixe de Junco de Akiris para o Corsário Groy, em Theramore.‡Принесите сверток со стеблями акириса каперу Грою в Терамор.‡Bringt ein Bündel Akirisschilfrohr zu Freibeuter Groy nach Theramore.‡테라모어 섬에 있는 선원 그로이에게 아키리스 갈대 한 묶음을 가져가야 합니다.‡Lleva un fardo de cañas akiris al corsario Groy, en Theramore.‡Lleva un fajo de juncos akiris al corsario Groy, en Theramore.‡Apporter un Fagot de roseaux akiris au corsaire Groy à Theramore.‡给塞拉摩的海盗格罗伊带去一束海蛇草。‡給塞拉摩的私掠者格羅伊帶去一束海蛇草。',
  }
},
[624] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
