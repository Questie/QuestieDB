    nil,
  }
},
[9287] = {
  {
    'Treinamento de paladino‡Обучение паладинов‡Ausbildung zum Paladin‡성기사 훈련‡Instrucción de paladín‡Instrucción de paladín‡La formation du paladin‡圣骑士训练‡聖騎士訓練',
    nil,
    '‡Я ряд, что ты пожелала обратиться ко мне. В прошлом я занимался обучением молодых паладинов, только что вступивших в наш орден. Я снова принял на себя эту почетную обязанность. Говорят, ты стремишься к Свету. Это честь для меня - помочь тебе сделать первые шаги на этом пути.nnВот мой первый урок...‡‡‡‡‡‡‡',
  }
},
[9288] = {
  {
    'Treinamento de caçador‡Обучение охотника‡Ausbildung zum Jäger‡사냥꾼 훈련‡Instrucción de cazador‡Instrucción de cazador‡La formation du chasseur‡猎人训练‡獵人訓練',
    nil,
    '‡‡Ich bin froh, dass Ihr zu mir gekommen seid. Ich bin schon eine ganze Weile für die Ausbildung junger <Klasse> verantwortlich, eine Aufgabe, die ich auch in dieser neuen Welt noch weiter erfüllen möchte. Ich beobachte Euch bereits seit geraumer Zeit und es wäre eine Ehre für mich, wenn ich Euch die Künste des Jägers lehren dürfte.nnSollen wir beginnen?‡‡‡‡‡‡',
  }
},
[9289] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Ausbildung zum Krieger‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡La formation du guerrier‡战士训练‡',
    nil,
    nil,
  }
},
[9290] = {
  {
    'Treinamento de mago‡Обучение мага‡Ausbildung zum Magier‡마법사 훈련‡Instrucción de mago‡Instrucción de mago‡La formation de mage‡法师训练‡法師訓練',
    nil,
    nil,
  }
},
[9291] = {
  {
    'Treinamento de sacerdote‡Обучение жреца‡Ausbildung zum Priester‡사제 훈련‡Instrucción de sacerdote‡Instrucción de sacerdote‡La formation du prêtre‡牧师训练‡牧師訓練',
    nil,
    nil,
  }
},
[9292] = {
  {
    'Cristal necrótico rachado‡Треснутый некротический кристалл‡Gesprungener nekrotischer Kristall‡부서진 죽음의 수정‡Cristal necrótico rajado‡Cristal necrótico rajado‡Cristal nécrotique fêlé‡破碎的死灵水晶‡破碎的墓地水晶',
    nil,
    'Leve o Cristal Necrótico Rachado para o Tenente Orrin em frente aos portões de Ventobravo.‡Отнесите треснутый некротический кристалл лейтенанту Оррину, находящемуся за воротами Штормграда.‡Bringt den gesprungenen nekrotischen Kristall zu Leutnant Orrin außerhalb der Tore von Sturmwind.‡스톰윈드 성문 외곽에 있는 부관 오린에게 부서진 죽음의 수정을 가져가야 합니다.‡LLeva el cristal necrótico al general Orrin, que está fuera de las puertas de Ventormenta.‡Lleva el cristal necrótico rajado al teniente Orrin, que está fuera de las puertas de Ventormenta.‡Apportez le Cristal nécrotique fêlé au lieutenant Orrin à l\'extérieur des portes de Hurlevent.‡将破碎的死灵水晶交给暴风城门外的奥林中尉。‡將破碎的墓地水晶帶給暴風城城門外的歐令中尉。',
  }
},
[9293] = {
  {
    'A resposta adequada...‡То, что должно быть сделано...‡Was getan werden muss...‡반드시 행해져야 할 것...‡Hacer lo correcto...‡Hacer lo correcto...‡Ce qui doit être fait...‡必需的措施......‡必要手段……',
    nil,
    'Colete 10 Amostras de Açoitadeira e leve-as à Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Соберите 10 образцов корней корнехлестов и отнесите их ботанику Таэрикс на место крушения в долине Аммен.‡Sammelt 10 Peitscherproben ein und bringt sie zu Botanikerin Taerix bei der Absturzstelle im Am\'mental.‡덩굴손 견본 10개를 수집한 후, 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 가져가야 합니다.‡Recolecta 10 muestras de azotador y llévaselas a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Recolecta 10 muestras de azotador y llévaselas a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Rassemblez 10 Échantillons de fouette-racines et rapportez-les à la botaniste Taerix, au point d\'impact du val d\'Ammen.‡收集10份鞭笞者样本，把它们交给埃门谷坠毁点的植物学家塔蕾克丝。‡收集10個鞭笞者樣本再回到安曼谷的失事地點找植物學家泰瑞茲。',
  }
},
[9294] = {
  {
    'A descontaminação do lago‡Исцеление озера‡Die Heilung des Sees‡호수 정화‡Sanar el lago‡Sanar el lago‡Guérir le lac‡净化湖水‡拯救湖泊',
    nil,
    'Disperse o Agente Neutralizador no Cristal de Poder Irradiado. Em seguida, fale com a Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Вылейте нейтрализующее вещество в воду рядом с радиоактивным кристаллом силы на месте крушения в долине Аммен, затем вернитесь к ботанику Таэрикс.‡Verwendet den Neutralisierungswirkstoff bei dem strahlenden Energiekristall und kehrt anschließend zu Botanikerin Taerix bei der Absturzstelle im Am\'mental zurück.‡방사능에 오염된 마력의 수정에 중화제를 뿌린 후, 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 돌아가야 합니다.‡Dispersa el agente neutralizador sobre el cristal de energía irradiada y después vuelve junto a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Dispersa el agente neutralizador sobre el cristal de energía irradiada y después vuelve junto a la botánica Taerix en el Lugar del Accidente, en el Valle Ammen.‡Répandez le Produit neutralisant près du Cristal de puissance irradié. Ensuite, retournez voir la botaniste Taerix au point d\'impact du val d\'Ammen.‡将中和媒介散布在辐射能量水晶旁，然后向埃门谷坠毁点的植物学家塔蕾克丝复命。‡對放射性能量水晶散播中和劑。然後，再回到安曼谷的失事地點找植物學家泰瑞茲。',
  }
},
[9295] = {
  {
    'Carta do front‡Письмо с фронта‡Brief von der Front‡전방에서 온 편지‡Una carta del frente‡Una carta del frente‡Une lettre du front‡被撕碎的信‡來自前線的信件',
    nil,
    'Leve a Carta Rasgada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите порванное письмо хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den zerfledderten Brief zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 찢어진 편지를 가져가야 합니다.‡Lleva la carta rota al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la carta rota al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Lettre déchirée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将被撕碎的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將撕破的信件帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9299] = {
  {
    'Bilhete do front‡Записка с фронта‡Notiz von der Front‡전방에서 온 쪽지‡Una nota del frente‡Una nota del frente‡Une note du front‡潦草的便笺‡前線的便箋',
    nil,
    'Leve o Bilhete Aflito para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите потертую записку хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die verblichene Notiz zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 근심 가득한 쪽지를 가져가야 합니다.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la nota desgastada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Note détériorée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将潦草的便笺交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將乾淨的便箋帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9300] = {
  {
    'Página do front‡Страничка с фронта‡Seite von der Front‡전방에서 온 찢어진 페이지‡Una página del frente‡Una página del frente‡Une page du front‡破旧的信‡前線的書頁',
    nil,
    'Leve a Página Desalinhada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите разорванную страницу хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt die zerfranste Seite zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 찢어진 페이지를 가져가야 합니다.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la página desgarrada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Page abîmée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将破旧的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將破爛的書頁帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9301] = {
  {
    'Envelope do front‡Конверт с фронта‡Umschlag von der Front‡전방에서 온 봉투‡Un sobre del frente‡Un sobre del frente‡Une enveloppe du front‡浸血的信封‡前線的信封',
    nil,
    'Leve o Envelope Manchado de Sangue para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите конверт, запятнанный кровью, хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt den blutbefleckten Umschlag zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 피로 물든 봉투를 가져가야 합니다.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el sobre ensangrentado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez l\'Enveloppe tachée de sang au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将浸血的信封交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將染血的信封帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9302] = {
  {
    'Missiva do front‡Послание с фронта‡Schreiben von der Front‡전방에서 온 서한‡Una misiva del frente‡Una misiva del frente‡Une missive du front‡被弄皱的信‡前線的公文',
    nil,
    'Leve a Missiva Amassada para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите смятое послание хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das zerknitterte Schreiben zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 구겨진 서한을 가져가야 합니다.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva la misiva arrugada al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez la Missive froissée au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将被弄皱的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將弄皺的公文帶到東瘟疫之地的聖光之願禮拜堂交給名冊保管者。',
  }
},
[9303] = {
  {
    'Inoculação‡Прививка‡Immunisierung‡예방 접종‡Inoculación‡Inoculación‡Inoculation‡疫苗‡注射疫苗',
    nil,
    'Use o Cristal de Inoculação em 6 Corujantes do Ninhal. Em seguida, fale com o Vindicante Aldar, no Ponto de Impacto, que fica no Vale Ammen.‡Сделайте прививку шести совунам с Совиных холмов при помощи особого кристалла. Затем вернитесь к воздаятелю Алдару на место крушения в долине Аммен.‡Wendet den Immunisierungskristall auf 6 Nisteleulkin an. Kehrt anschließend zu Verteidiger Aldar bei der Absturzstelle im Am\'mental zurück.‡다닥나무 올빼미야수 6마리에게 예방의 수정을 사용한 후 암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 돌아가야 합니다.‡Usa el cristal inoculador sobre los 6 buhícos Cubrebosque. Regresa entonces junto al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Usa el cristal inoculador sobre los 6 buhícos Cubrebosque. Regresa entonces junto al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Utilisez le Cristal d\'inoculation sur 6 Chouettides nidebois. Retournez ensuite auprès du redresseur de torts Aldar au Point d\'impact du val d\'Ammen.‡对6只木巢枭兽使用疫苗水晶，然后向埃门谷坠毁点的守备官奥达尔复命。‡在6個奈斯特灌木林梟獸身上使用注射用水晶。再回到安曼谷的失事地點找復仇者艾德。',
  }
},
[9304] = {
  {
    'Documento do front‡Документ с фронта‡Dokument von der Front‡전방에서 온 문서‡Un documento del frente‡Un documento del frente‡Un document du front‡肮脏的信‡前線的文件',
    nil,
    'Leve o Documento Borrado para o Guardião dos Pergaminhos na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.‡Отнесите испачканный документ хранителю свитков в Часовню Последней Надежды в Восточные Чумные земли.‡Bringt das verschmierte Dokument zum Bewahrer der Schriften bei der Kapelle des hoffnungsvollen Lichts in den östlichen Pestländern.‡동부 역병지대의 희망의 빛 예배당에 있는 기록 보관원에게 흐릿해진 문서를 가져가야 합니다.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Lleva el documento manchado al Guardián de los Pergaminos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este.‡Apportez le Document taché au gardien des registres à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'est.‡将肮脏的信交给东瘟疫之地圣光之愿礼拜堂的名单登记员。‡將弄髒的文件帶到東瘟疫之地的聖光禮拜堂交給名冊保管者。',
  }
},
[9305] = {
  {
    'Peças sobressalentes‡Запасные части‡Ersatzteile‡도난당한 장비‡Piezas de repuesto‡Piezas de repuesto‡Pièces de rechange‡备用零件‡備用零件',
    nil,
    'Colete 4 Peças Sobressalentes do Emissor e, em seguida, fale com a Técnica Zhanaa no Ponto de Impacto, que fica no Vale Ammen.‡Соберите 4 запчасти для передатчика и отнесите их технику Жанае на место крушения в долине Аммен.‡Beschafft 4 Emitterersatzteile und kehrt anschließend zu Technikerin Zhanaa bei der Absturzstelle im Am\'mental zurück.‡도난당한 장비 4개를 모은 후, 암멘 골짜기의 추락 지점에 있는 기술자 자나에게 돌아가야 합니다.‡Recolecta 4 piezas del emisor y llévaselas a la técnica Zhanaa en el Lugar del Accidente, en el Valle Ammen.‡Recolecta 4 piezas del emisor y llévaselas a la técnica Zhanaa en el Lugar del Accidente, en el Valle Ammen.‡Récupérez 4 Pièces de rechange pour l\'émetteur puis rapportez-les à la technicienne Zhanaa au Point d\'impact du val d\'Ammen.‡收集4份发射器备用零件，然后向埃门谷坠毁点的技师沙娜安复命。‡收集4個發射器的備用零件。然後再回到安曼谷的失事地點找技師·薩那。',
  }
},
[9308] = {
  {
    '‡‡‡‡‡‡‡‡<DEPRECATED>Blood Elf Remains?',
    nil,
    '‡‡‡‡‡‡‡‡將血精靈護身符帶到安曼谷交給失事地點的復仇者艾德。',
  }
},
[9309] = {
  {
    'O batedor desaparecido‡Пропавший разведчик‡Der vermisste Späher‡실종된 정찰병‡El explorador desaparecido‡El explorador desaparecido‡L\'éclaireur disparu‡失踪的斥候‡調查暗影山脊',
    nil,
    'Encontre e fale com Tolaan, na Serra das Sombras, que fica no Vale Ammen.‡Найдите Толаана у хребта Теней в долине Аммен и поговорите с ним.‡Sprecht mit Tolaan im Schattenkamm im Am\'mental.‡암멘 골짜기의 어둠 마루에서 톨란을 찾아서 대화해야 합니다.‡Encuentra a Tolaan en la Cresta de las Sombras, en el Valle Ammen, y habla con él.‡Encuentra a Tolaan en la Cresta de las Sombras, en el Valle Ammen, y habla con él.‡Trouvez Tolaan sur l\'Ombrecrête du val d\'Ammen et parlez-lui.‡在埃门谷中的暗影山找到图兰，并与之交谈。‡到安曼谷的暗影山脊找到托蘭並和他談談。',
  }
},
[9310] = {
  {
    'Cristal necrótico fugaz‡Тусклый некротический кристалл‡Schwacher nekrotischer Kristall‡희미한 죽음의 수정‡Cristal necrótico tenue‡Cristal necrótico tenue‡Cristal nécrotique voilé‡暗淡的死灵水晶‡黯淡的墓地水晶',
    nil,
    'Entregue o Cristal Necrótico Fugaz para o Tenente Rukag na pátio da Cidade Baixa.‡Отнесите тусклый некротический кристалл лейтенанту Рукагу во внутренний двор Подгорода.‡Bringt den schwachen nekrotischen Kristall zu Leutnant Rukag im Hof von Unterstadt.‡언더시티의 안마당에 있는 부관 루카그에게 희미한 죽음의 수정을 가져가야 합니다.‡LLeva el cristal necrótico al general Rukag, que está fuera de las puertas de Entrañas.‡Lleva el cristal necrótico al teniente Rukag, que está fuera de las puertas de Entrañas.‡Apportez le Cristal nécrotique voilé au lieutenant Rukag dans la cour de Fossoyeuse.‡将暗淡的死灵水晶交给幽暗城庭院处的卢卡中尉。‡將黯淡的墓地水晶帶給幽暗城庭院的盧卡中尉。',
  }
},
[9311] = {
  {
    'Espiã elfa sangrenta‡Шпион эльфов крови‡Blutelfenspionage‡블러드 엘프 첩자‡Espía elfo de sangre‡Espía elfo de sangre‡L\'espionne elfe de sang‡血精灵间谍‡血精靈間諜',
    nil,
    'Mate a Monteira Candressa e, em seguida, informe o Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Убейте геодезиста Кандресс и расскажите о случившемся воздаятелю Алдару на месте крушения в долине Аммен.‡Tötet Gutachterin Kandress und informiert anschließend Verteidiger Aldar bei der Absturzstelle im Am\'mental über die Ereignisse.‡감시관 캔드레스를 처치하고 암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 그곳에서 벌어진 일에 대한 소식을 전해야 합니다.‡Mata a la perita Candress y ve a informar al vindicador Aldar al Lugar del Accidente en el Valle Ammen.‡Mata a la perita Candress y ve a informar al vindicador Aldar al Lugar del Accidente en el Valle Ammen.‡Tuez la Géomètre Candress, puis allez rendre compte au redresseur de torts Aldar, au Point d\'impact du val d\'Ammen.‡杀死测量员卡蒂瑞丝，并把这个消息通知给埃门谷坠毁点的守备官奥达尔。‡殺死勘測員坎翠斯，然後把這裡發生的事告訴安曼谷失事地點的復仇者艾德。',
  }
},
[9312] = {
  {
    'O emissor‡Излучатель‡Der Emitter‡홀로그램 영사기‡El emisor‡El emisor‡L\'émetteur‡图像发射器‡發射器',
    nil,
    'Fale com a Técnica Zhanaa no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с техником Жанаей на месте крушения в долине Аммен.‡Sprecht mit Technikerin Zhanaa bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 기술자 자나와 대화해야 합니다.‡Habla con la técnica Zhanaa en el Lugar del Accidente en el Valle Ammen.‡Habla con la técnica Zhanaa en el Lugar del Accidente en el Valle Ammen.‡Parlez à la technicienne Zhanaa au point d\'impact dans le val d\'Ammen.‡与埃门谷坠毁点的技师沙娜安谈一谈。‡和安曼谷失事地點的技師·薩那談談。',
  }
},
[9313] = {
  {
    'A viagem para o Entreposto Lazúli‡На Лазурную заставу‡Reise zur Azurwacht‡하늘 감시초소로 이동‡Viaje a la Avanzada Azur‡Viaje a la Avanzada Azur‡En route pour le Guet d\'azur‡前往碧蓝岗哨‡前往藍色守望',
    nil,
    'Fale com o Técnico Dyvuun no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Поговорите с техником Дивууном на Лазурной заставе на острове Лазурной Дымки.‡Sprecht mit Techniker Dyvuun bei der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 기술자 디부운과 대화해야 합니다.‡Habla con el técnico Dyvuun en la Avanzada Azur, en la Isla Bruma Azur.‡Habla con el técnico Dyvuun en la Avanzada Azur, en la Isla Bruma Azur.‡Parlez au technicien Dyvuun au Guet d\'azur, sur l\'île de Brume-azur.‡与秘蓝岛的碧蓝岗哨中的技师戴维恩谈一谈。‡到藍謎島和藍色守望的技師戴伏恩談談。',
  }
},
[9314] = {
  {
    'Notícias do Entreposto Lazúli‡Вести с Лазурной заставы‡Nachricht von der Azurwacht‡하늘 감시초소의 요청‡Un mensaje de la Avanzada Azur‡Un mensaje de la Avanzada Azur‡Une demande du Guet d\'azur‡碧蓝岗哨的消息‡藍色守望的字條',
    nil,
    'Fale com a Hospedeira Chellan no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Поговорите с корчмарем Челланой на Лазурной заставе на острове Лазурной Дымки.‡Sprecht mit Versorgerin Chellan bei der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 간병인 첼란과 대화해야 합니다.‡Habla con la cuidadora Chellan en la Avanzada Azur, en la Isla Bruma Azur.‡Habla con la cuidadora Chellan en la Avanzada Azur, en la Isla Bruma Azur.‡Parlez à l\'hôtesse Chellan au Guet d\'azur sur l\'île de Brume-azur.‡与秘蓝岛上的碧蓝岗哨中的看护员谢尔兰谈一谈。‡去藍謎島和藍色守望的照顧者查倫談談。',
  }
},
[9315] = {
  {
    'Anok\'suten‡Анок\'сутен‡Anok\'suten‡아녹수텐‡Anok\'suten‡‡Anok\'suten‡阿诺克苏塔‡安羅科舒頓',
    nil,
    'Mate Anok\'suten e apresente-se ao Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Убейте Анок\'сутен и возвращайтесь к чародею Вандрилу в Транквиллион, что в Призрачных землях.‡Tötet Anok\'suten und kehrt anschließend zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡아녹수텐을 해치운 다음 유령의 땅, 트랜퀼리엔에 있는 비전술사 반드릴에게 돌아가십시오.‡Mata a Anok\'suten y ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Mata a Anok\'suten y ve a ver al arcanista Vandril a Tranquillien en las Tierras Fantasma.‡Tuez Anok\'suten et retournez voir l\'arcaniste Vandril, à Tranquillien dans les Terres fantômes.‡杀死阿诺克苏塔，然后向幽魂之地塔奎林的奥术师范迪瑞尔复命。‡殺死安羅科舒頓再回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9316] = {
  {
    '‡‡‡‡‡‡‡‡[TXT]哥布林掠奪者',
    nil,
    '‡‡‡‡‡‡‡‡設計者之島的布理安娜·史奈德要10顆哥布林牙齒。',
  }
},
[9317] = {
  {
    'Pedras de afiar consagradas‡Освященное точило‡Geweihte Wetzsteine‡신성한 숫돌‡Piedras de afilar consagradas‡Piedras de afilar consagradas‡Pierre à aiguiser consacrée‡神圣磨刀石‡',
    nil,
    '‡Если ты принесешь мне восемь некротических рун, отобрав их у захватчиков из Плети, я дам тебе освященное точило. Оно способно помочь тебе в борьбе против приспешников Короля-лича.‡Wenn Ihr mir acht nekrotische Runen von den Geißelinvasoren besorgt, kann ich Euch einen geweihten Wetzstein dafür geben. Er sollte Euch im Kampf gegen die Diener des Lichkönigs eine große Hilfe sein.‡스컬지 침략자들에게서 죽음의 룬을 8개를 모아 오면 신성한 숫돌 1개를 주겠소. 신성한 숫돌은 전장에서 리치 왕의 부하들을 상대하는 데 큰 도움이 될 것이오.‡‡‡Si vous m’apportez huit runes nécrotiques des envahisseurs du Fléau, je vous fournirais une pierre à aiguiser consacrée. Elle devrait vous être d’une grande utilité pour vos combats contre les serviteurs du roi-liche.‡‡',
  }
},
[9318] = {
  {
    'Óleo abençoado de teurgo‡Благословенное волшебное масло‡Gesegnetes Zauberöl‡축복받은 마술사 오일‡Aceite bendito de zahorí‡Aceite de zahorí bendito‡Huile de sorcier bénite‡神圣巫师之油‡受祝福的巫師之油',
    nil,
    '‡В обмен на некротические руны Плети Серебряный Рассвет дарует тебе один фиал благословенного волшебного масла.‡Die Argentumdämmerung wird Euch im Tausch gegen die nekrotischen Runen der Geißelinvasoren eine Phiole gesegnetes Zauberöl geben.‡스컬지 침략자들에게서 얻은 죽음의 룬을 은빛 여명회에 가져다준다면 그 대가로 축복받은 마술사 오일 1병을 주도록 하겠소.‡A cambio de las runas necróticas de la Plaga, Alba Argenta te ofrece 2 viales de aceite bendito de zahorí.‡‡En échange des runes nécrotiques des envahisseurs du Fléau, l’Aube d’argent vous donnera une fiole d’huile de sorcier bénite.‡‡',
  }
},
[9319] = {
  {
    'Uma luz na escuridão‡Свет в темных местах‡Licht im Dunkeln‡어둠을 밝히는 한 줄기 빛‡Una luz en la oscuridad‡Una luz en la oscuridad‡Une lumière au sein des ombres‡黑暗中的光明‡暗處之光',
    nil,
    'Encontre e toque as fogueiras no Pico da Rocha Negra, no Gládio Cruel, em Scolomântia e em Stratholme. Em seguida, fale novamente com o Guardachamas do Festival.‡Найдите костры, размещенные в пике Черной горы, Забытом Городе, Некроситете и Стратхольме и коснитесь их; затем поговорите с хранителем праздничного пламени.‡Findet und berührt die Freudenfeuer innerhalb der Schwarzfelsspitze, dem Düsterbruch, Scholomance und Stratholme. Kehrt dann zum Flammenbewahrer zurück.‡검은바위 첨탑, 혈투의 전장, 스칼로맨스, 스트라솔름에 있는 화톳불을 찾아서 만져 본 후, 한여름 축제 불꽃지기에게 돌아가야 합니다.‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme y ve a ver al guardián de la llama del Festival.‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme, y ve a ver al guardián de la llama del Festival.‡Trouvez et touchez les feux de joie situés au pic Rochenoire, à Hache-tripes, dans la Scholomance et à Stratholme. Puis retournez voir le gardien des flammes de la fête.‡找到并碰触在黑石塔、厄运之槌、通灵学院和斯坦索姆内的火盆，并回到节日护火者处。‡找到並觸碰位在黑石塔，厄運之槌，通靈學院，和斯坦索姆的營火。',
  }
},
[9320] = {
  {
    'Poção Elevada de Mana‡Сильнейшее зелье маны‡Erheblicher Manatrank‡일급 마나 물약‡Poción sublime de maná‡Superpoción de maná‡Potion de mana majeure‡特效法力药水‡極效法力藥水',
    nil,
    '‡Помимо других поставок, у нас есть немного сильнейших зелий маны, которые могут тебе пригодиться. Я дам тебе одну порцию зелья в обмен на пятнадцать некротических рун.‡Neben unseren anderen Vorräten verfügen wir auch über eine gewisse Zahl an erheblichen Manatränken, die für Euch von Nutzen sein könnten. Ich werde Euch einen im Tausch gegen fünfzehn nekrotische Runen geben.‡‡Además del resto de suministros, disponemos de pociones de maná superiores. Te daré una si me traes 8 runas necróticas.‡‡‡‡',
  }
},
[9321] = {
  {
    'Super Healing Potion‡Хорошее лечебное зелье‡Erheblicher Heiltrank‡일급 치유 물약‡Poción sublime de curación‡Poción de sanación sublime‡Potion de soins majeure‡特效治疗药水‡極效治療藥水',
    nil,
    nil,
  }
},
[9322] = {
  {
    'As chamas selvagens de Kalimdor‡Костры Калимдора‡Glühende Feuer in Kalimdor‡칼림도어의 거친 불꽃‡Los fuegos salvajes de Kalimdor‡Los fuegos salvajes de Kalimdor‡Feux sauvages en Kalimdor‡卡利姆多的野火‡卡林多的藍色火焰',
    nil,
    'Visite o Festival de Verão em Azshara, em Silithus, na Cratera Un\'Goro e em Hibérnia. Em seguida, fale novamente com o Guardachamas do Festival.‡Посетите лагеря праздника Огненного солнцеворота, размещенные в Азшаре, Силитусе, Кратере Ун\'Горо и Зимних Ключах, затем вернитесь к хранителю праздничного пламени.‡Sucht die Lager des Sonnenwendfests in Azshara, Silithus, dem Krater von Un\'Goro und Winterquell auf. Kehrt dann zum Flammenbewahrer zurück.‡아즈샤라, 실리더스, 운고로 분화구 및 여명의 설원에 있는 한여름 불꽃 축제 야영지를 방문하고 한여름 축제 불꽃지기에게 돌아오십시오.‡Visita los campamentos del Solsticio de Azshara, Silithus, Cráter de Un\'Goro y Cuna del Invierno y ve a ver al guardián de la llama del Festival.‡Visita los campamentos del Solsticio de Azshara, Silithus, Cráter de Un\'Goro y Cuna del Invierno y ve a ver al guardián de la llama del Festival.‡Visitez les campements du solstice d\'été en Azshara, en Silithus, au cratère d\'Un\'Goro et à Berceau-de-l\'Hiver, puis revenez voir le Gardien des flammes.‡造访艾萨拉、希利苏斯、安戈洛环行山和冬泉谷的仲夏庆典营地，然后回到节日护火者处。‡拜訪艾薩拉，希利蘇斯，安戈洛環形山，和冬泉谷的仲夏營地，再回去找節慶營火管理者。',
  }
},
[9323] = {
  {
    'As chamas selvagens dos Reinos do Leste‡Костры Восточных королевств‡Glühende Feuer in den östlichen Königreichen‡동부 왕국의 거친 불꽃‡Los fuegos salvajes de los Reinos del Este‡Los fuegos salvajes de los Reinos del Este‡Feux sauvages dans les Royaumes de l\'est‡东部王国的野火‡東部王國的藍色火焰',
    nil,
    'Visite o Festival do Fogo na Barreira do Inferno, nas Terras Pestilentas Orientais, nas Terras Agrestes e na Garganta Abrasadora. Em seguida, fale com o Guardachamas do Festival.‡Посетите лагеря Праздника Огня, размещенные в Выжженных землях, Восточных Чумных землях, во Внутренних землях и Тлеющем ущелье, затем поговорите с хранителем праздничного пламени.‡Reist zu den Lagern des Sonnenwendfests in den verwüsteten Landen, den östlichen Pestländern, dem Hinterland und der sengenden Schlucht. Kehrt dann zum Flammenbewahrer zurück.‡저주받은 땅, 동부 역병지대, 동부 내륙지, 이글거리는 협곡에 있는 불꽃 축제 야영지를 방문한 다음 한여름 축제 불꽃지기에게 돌아오십시오.‡Visita los campamentos del Festival del Solsticio de Las Tierras Devastadas, las Tierras de la Peste del Este, las Tierras del Interior y La Garganta de Fuego y ve a ver al guardián de la llama del Festival.‡Visita los campamentos del Festival del Solsticio de Las Tierras Devastadas, las Tierras de la Peste del Este, las Tierras del Interior y La Garganta de Fuego y ve a ver al guardián de la llama del Festival.‡Rendez visite aux campements de la fête du Feu situés dans les Terres foudroyées, les Maleterres de l\'est, les Hinterlands, et la gorge des Vents brûlants, puis allez parler au gardien des flammes de la fête.‡造访诅咒之地、东瘟疫之地、辛特兰和灼热峡谷的火焰节营地，然后回到节日护火者处。‡拜訪詛咒之地，東瘟疫之地，辛特蘭和灼熱峽谷的火焰節慶營地。',
  }
},
[9324] = {
  {
    'Roubando a chama de Orgrimmar‡Похищение пламени Оргриммара‡Raubt die Flamme von Orgrimmar‡오그리마 불꽃 훔치기‡Robar la llama de Orgrimmar‡Robar la llama de Orgrimmar‡Voler la flamme d\'Orgrimmar‡盗取奥格瑞玛的烈焰‡偷取奧格瑪之火',
    nil,
    'Devolva a Chama de Orgrimmar para o Historiador do Festival.‡Верните Пламя Оргриммара хранителю мудрости Праздника.‡Bringt die Flamme von Orgrimmar zum Meister der Lehren.‡한여름 축제 현자에게 오그리마 불꽃을 돌려줘야 합니다.‡Devuelve la Llama de Orgrimmar al maestro cultural del Festival.‡Devuelve la llama de Orgrimmar al maestro cultural del Festival.‡Rapportez la Flamme d\'Orgrimmar au Maître des traditions.‡将奥格瑞玛烈焰交给节日博学者。‡將奧格瑪之火交還給帶給節慶傳說大師。',
  }
},
[9325] = {
  {
    'Roubando a chama do Penhasco do Trovão‡Похищение пламени Громового Утеса‡Raubt die Flamme von Donnerfels‡썬더 블러프 불꽃 훔치기‡Robar la llama de Cima del Trueno‡Robar la llama de Cima del Trueno‡Voler la flamme de Thunder Bluff‡盗取雷霆崖的烈焰‡偷取雷霆崖之火',
    nil,
    'Entregue a chama do Penhasco do Trovão para o Historiador do Festival.‡Верните Пламя Громового Утеса хранителю мудрости Праздника.‡Bringt die Flamme von Donnerfels zum Meister der Lehren.‡한여름 축제 현자에게 썬더 블러프 불꽃을 가져가야 합니다.‡Devuelve la Llama de Cima del Trueno al maestro del Conocimiento del festival.‡Devuelve la llama de Cima del Trueno al maestro cultural del Festival.‡Rapportez la flamme des Pitons du Tonnerre au Maître des traditions.‡将雷霆崖烈焰交给节日博学者。‡將雷霆崖之火帶給節慶傳說大師。',
  }
},
[9326] = {
  {
    'Roubando as chamas da Cidade Baixa‡Похищение пламени Подгорода‡Raubt die Flamme von Unterstadt‡언더시티 불꽃 훔치기‡Robar la llama de Entrañas‡Robar la llama de Entrañas‡Voler la flamme de Fossoyeuse‡盗取幽暗城的烈焰‡偷取幽暗城之火',
    nil,
    'Entregue a chama da Cidade Baixa para o Historiador do Festival.‡Верните Пламя Подгорода хранителю мудрости Праздника.‡Bringt die Flamme von Unterstadt zum Meister der Lehren.‡한여름 축제 현자에게 언더시티 불꽃을 가져가야 합니다.‡Devuelve la llama de Entrañas al maestro cultural del Festival.‡Devuelve la llama de Entrañas al maestro cultural del Festival.‡Rapportez la flamme de Fossoyeuse au Maître des traditions.‡将幽暗城烈焰交给节日博学者。‡將幽暗城之火帶給節慶傳說大師。',
  }
},
[9327] = {
  {
    'Os Renegados‡Отрекшиеся‡Die Verlassenen‡포세이큰‡Los Renegados‡Los Renegados‡Les Réprouvés‡被遗忘者‡被遺忘者',
    nil,
    'Fale com o Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Поговорите с верховным вершителем Мавреном в Транквиллионе, что в Призрачных землях.‡Sprecht mit Hochexekutor Mavren in Tristessa in den Geisterlanden.‡유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌과 대화하십시오.‡Habla con el Sumo Ejecutor Mavren en Tranquillien, en las Tierras Fantasma.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Allez parler au Grand exécuteur Mavren à Tranquillien, dans les Terres fantômes.‡与塔奎林的高级执行官玛尔伦谈一谈。‡到鬼魂之地的安寧地和高階執行官瑪弗倫談談。',
  }
},
[9328] = {
  {
    'Herói dos Sin\'dorei‡Герой син\'дорай‡Held der Sin\'dorei‡신도레이의 영웅‡Héroe de los sin\'dorei‡Héroe de los sin\'dorei‡Un héros parmi les Sin\'dorei‡辛多雷的英雄‡辛多雷的英雄',
    nil,
    'Leve a Cabeça de Dar\'Khan para Lor\'themar Theron em Luaprata.‡Принесите голову Дар\'Хана Лор\'темару Терону в Луносвет.‡Bringt Dar\'Khans Kopf zu Lor\'themar Theron in Silbermond.‡다르칸의 머리카락을 가지고 실버문에 있는 로르테마르 테론에게 가져가야 합니다.‡Llévale la cabeza de Dar\'Khan a Lor\'themar Theron en la Ciudad de Lunargenta.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron en la Ciudad de Lunargenta.‡Apportez la Tête de Dar’Khan à Lor’themar Theron, à Lune-d’Argent.‡将达尔坎的头颅交给银月城的洛瑟玛·塞隆。‡把達克汗的頭顱帶給銀月城的洛索瑪·塞隆。',
  }
},
[9329] = {
  {
    'Os Renegados‡Отрекшиеся‡Die Verlassenen‡포세이큰‡Los Renegados‡Los Renegados‡Les Réprouvés‡被遗忘者‡被遺忘者',
    nil,
    'Fale com o Alto-executor Malta em Tranquillien, que fica na Terra Fantasma.‡Поговорите с верховным вершителем Мавреном в Транквиллионе, что в Призрачных землях.‡Sprecht mit Hochexekutor Mavren in Tristessa in den Geisterlanden.‡유령의 땅, 트랜퀼리엔에 있는 고위집행관 마브렌과 대화하십시오.‡Habla con el Sumo Ejecutor Mavren en Tranquillien, en las Tierras Fantasma.‡Habla con el sumo ejecutor Mavren en Tranquillien en las Tierras Fantasma.‡Allez parler au Grand exécuteur Mavren à Tranquillien, dans les Terres Fantômes.‡与塔奎林的高级执行官玛尔伦谈一谈。‡到鬼魂之地的安寧地和高階執行官瑪弗倫談談。',
  }
},
[9330] = {
  {
    'Roubando a chama de Ventobravo‡Похищение пламени Штормграда‡Raubt die Flamme von Sturmwind‡스톰윈드 불꽃 훔치기‡Robar la llama de Ventormenta‡Robar la llama de Ventormenta‡Voler la flamme de Stormwind‡盗取暴风城的烈焰‡',
    nil,
    'Entregue a Chama de Ventobravo para o Contador de Histórias do Festival.‡Верните Пламя Штормграда Праздничному Сказителю.‡Bringt die Flamme von Sturmwind zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 스톰윈드 불꽃을 가져가십시오.‡Devuelve la Llama de Ventormenta al Cuentacuentos del festival.‡Devuelve la llama de Ventormenta al cuentacuentos del Festival.‡Rapportez la flamme de Hurlevent au Conteur de la fête.‡将暴风城烈焰交给节日诗人。‡',
  }
},
[9331] = {
  {
    'Roubando a chama de Altaforja‡Похищение пламени Стальгорна‡Raubt die Flamme von Eisenschmiede‡아이언포지 불꽃 훔치기‡Robar la llama de Forjaz‡Robar la llama de Forjaz‡Voler la flamme d\'Ironforge‡盗取铁炉堡的烈焰‡',
    nil,
    'Entregue a Chama de Altaforja para o Contador de Histórias do Festival.‡Верните Пламя Стальгорна Праздничному Сказителю.‡Bringt die Flamme von Eisenschmiede zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 아이언포지 불꽃을 가지고 가십시오.‡Devuelve la Llama de Forjaz al Cuentacuentos del festival.‡Devuelve la llama de Forjaz al cuentacuentos del Festival.‡Rapportez la flamme de Forgefer au Conteur de la fête.‡将铁炉堡烈焰交给节日诗人。‡',
  }
},
[9332] = {
  {
    'Roubando a chama de Darnassus‡Похищение пламени Дарнасса‡Raubt die Flamme von Darnassus‡다르나서스 불꽃 훔치기‡Robar la llama de Darnassus‡Robar la llama de Darnassus‡Voler la flamme de Darnassus‡盗取达纳苏斯的烈焰‡',
    nil,
    'Entregue a Chama de Darnassus para o Contador de Histórias do Festival.‡Верните пламя Дарнасса праздничному сказителю.‡Bringt die Flamme von Darnassus zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 다르나서스 불꽃을 돌려주십시오.‡Devuelve la Llama de Darnassus al cuentacuentos del Festival.‡Devuelve la llama de Darnassus al cuentacuentos del Festival.‡Rapportez la flamme de Darnassus au Conteur de la fête.‡将达纳苏斯烈焰交给节日诗人。‡',
  }
},
[9333] = {
  {
    'Luvas da Aurora Argêntea‡Перчатки Серебряного Рассвета‡Handschuhe der Argentumdämmerung‡은빛 여명회 장갑‡Guantes del Alba Argenta‡Guantes de El Alba Argenta‡Les gants de l\'Aube d\'argent‡银色黎明手套‡',
    nil,
    '‡Если принесешь мне тридцать некротических рун, я подарю тебе защитные перчатки для рук, по твоему выбору. Они оказались очень ценными в борьбе против нежити Плети‡Bringt Ihr mir dreißig nekrotische Runen, gebe ich Euch im Gegenzug einen Handschutz Eurer Wahl dafür. Dieser sollte sich in Eurem Kampf gegen die untote Geißel als sehr nützlich erweisen.‡‡‡‡Si vous m\'apportez trente runes nécrotiques, je vous donnerai en échange une pièce d\'armure de main au choix. Vous devriez les trouver très pratiques pour vous battre contre les morts-vivants du Fléau.‡‡',
  }
},
[9334] = {
  {
    'Óleo abençoado de teurgo‡Благословенное волшебное масло‡Gesegnetes Zauberöl‡축복받은 마술사 오일‡Aceite bendito de zahorí‡Aceite de zahorí bendito‡Huile de sorcier bénite‡神圣巫师之油‡受祝福的巫師之油',
    nil,
    '‡В обмен на некротические руны Плети Серебряный Рассвет дарует тебе один фиал благословенного волшебного масла.‡Die Argentumdämmerung wird Euch im Tausch gegen die nekrotischen Runen der Geißelinvasoren eine Phiole gesegnetes Zauberöl geben.‡스컬지 침략자들의 죽음의 룬을 은빛 여명회에 가져다준다면 그 대가로 축복받은 마술사 오일을 1병을 드리겠습니다.‡‡‡En échange des runes nécrotiques des envahisseurs du Fléau, l’Aube d’argent vous donnera une fiole d’huile de sorcier bénite.‡‡',
  }
},
[9335] = {
  {
    'Pedras de afiar consagradas‡Освященное точило‡Geweihte Wetzsteine‡신성한 숫돌‡Piedras de afilar consagradas‡Piedras de afilar consagradas‡Pierre à aiguiser consacrée‡神圣磨刀石‡',
    nil,
    '‡Если ты принесешь мне восемь некротических рун, отобрав их у захватчиков из Плети, я дам тебе освященное точило. Оно способно помочь тебе в борьбе против приспешников Короля-лича.‡Wenn Ihr mir acht nekrotische Runen von den Geißelinvasoren besorgt, kann ich Euch einen geweihten Wetzstein dafür geben. Er sollte Euch im Kampf gegen die Diener des Lichkönigs eine große Hilfe sein.‡스컬지 침략자들에게서 죽음의 룬 8개를 모아 오면 신성한 숫돌을 1개 드리겠습니다. 리치 왕의 부하들에게 맞서 싸우는 데 큰 도움이 될 물건이지요.‡‡‡Si vous m’apportez huit runes nécrotiques des envahisseurs du Fléau, je vous fournirai une pierre à aiguiser consacrée. Elle devrait vous être d’une grande utilité pour vos combats contre les serviteurs du roi-liche.‡‡',
  }
},
[9336] = {
  {
    'Poção Elevada de Cura‡Хорошее лечебное зелье‡Erheblicher Heiltrank‡일급 치유 물약‡Poción sublime de curación‡Superpoción de sanación‡Potion de soins majeure‡特效治疗药水‡極效治療藥水',
    nil,
    nil,
  }
},
[9337] = {
  {
    'Poção Elevada de Mana‡Сильнейшее зелье маны‡Erheblicher Manatrank‡일급 마나 물약‡Poción sublime de maná‡Superpoción de maná‡Potion de mana majeure‡特效法力药水‡極效法力藥水',
    nil,
    '‡Помимо других поставок, у нас есть немного сильнейших зелий маны, которые могут тебе пригодиться. Я дам тебе одну порцию зелья в обмен на пятнадцать некротических рун.‡Neben unseren anderen Vorräten verfügen wir auch über eine gewisse Zahl an erheblichen Manatränken, die für Euch von Nutzen sein könnten. Ich werde Euch einen im Tausch gegen fünfzehn nekrotische Runen geben.‡다른 보급품은 물론이고 아주 유용한 일급 마나 물약도 많이 있소이다. 죽음의 룬 15개를 가져오면 이 중 하나를 드리도록 하겠소.‡‡‡En plus de nos autres fournitures, nous disposons de quelques potions de mana majeures qui pourraient vous être utiles. Je vous en donnerai une en échange de quinze runes nécrotiques.‡‡',
  }
},
[9338] = {
  {
    'Lealdade ao Círculo Cenariano‡Верность Кругу Кенария‡Treue zum Zirkel des Cenarius‡세나리온 의회에 대한 충성‡Lealtad al Círculo Cenarion‡Lealtad al Círculo Cenarion‡Allégeance au Cercle cénarien‡塞纳里奥议会的盟友‡忠於塞納里奧議會',
    nil,
    '‡‡Selbst wenn Ihr keinen Bedarf an unseren materiellen Belohungen habt, sind diese Abzeichen ein Symbol für gegenseitiges Vertrauen und Freundschaft.nnBringt sie mir. Außerordentliche Dienste von Euch werde ich sorgsam vermerken.‡물질적인 보상을 원치 않더라도 이 휘장은 우리의 상호 신뢰와 우정을 상징할 것이오.nn난 그대의 눈부신 활약이 계속될 것이라 믿어 의심치 않소. 자, 휘장을 가져오시오.‡‡‡Même si vous n\'avez pas besoin des récompenses matérielles que nous proposons, ces badges sont la marque de notre amitié et de notre confiance mutuelle.nnApportez-les-moi. Je ne manquerai pas de prendre note des services que vous nous rendrez s\'ils allaient au-delà de l\'appel du devoir.‡‡',
  }
},
[9339] = {
  {
    'A recompensa de um ladrão‡Награда вора‡Der Lohn des Diebes‡도적의 보상‡Una recompensa de ladrón‡Una recompensa de ladrón‡La récompense d\'un voleur‡盗贼的奖励‡',
    nil,
    'Entregue a Chama de Ventobravo para (NAME).‡Верните Пламя Штормграда (NAME)‡Bringt die Flamme von Stormwind zu (NAME).‡You\'ve proven yourself, today, <name>.nnWhile I have little else to give you, I do have this crown; a fitting gift for a conqueror. May it light your way.‡Devuelve la llama de Ventormenta a (NAME).‡Devuelve la llama de Ventormenta a (NAME).‡Rapportez la Flamme de Stormwind à (NOM).‡You\'ve proven yourself, today, <name>.nnWhile I have little else to give you, I do have this crown; a fitting gift for a conqueror. May it light your way.‡',
  }
},
[9340] = {
  {
    'A Grande Fenda‡Глубокий Разлом‡Die große Kluft‡거대한 균열‡La Gran Fisura‡La Gran Fisura‡La Grande fissure‡大裂隙‡大裂縫',
    nil,
    'O Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, quer que você mate 8 Filhotes Rasgálitas e 3 Rasgálitas Alfa na Grande Fenda, a leste da Vigília do Falcão.‡Ступайте на восток от Соколиного дозора, к Глубокому разлому, и убейте 8 детенышей камнеруба и 3 камнерубов-вожаков по приказу капитана следопытов Венн\'рена.‡Waldläuferhauptmann Venn\'ren in der Falkenwacht möchte, dass Ihr 8 Steinsichelwelpen und 3 Steinsichelalphas bei der großen Kluft östlich der Falkenwacht erlegt.‡매의 감시탑에 있는 순찰대장 벤렌이 매의 감시탑의 동쪽의 거대한 균열에 있는 새끼 돌낫 바위갈퀴 8마리, 덩치큰 돌낫 바위갈퀴 3마리를 처치해 달라고 부탁했습니다.‡El capitán forestal Venn\'ren, de la Avanzada del Halcón, quiere que mates 8 crías Guadaña de Piedra y 3 alfas Guadaña de Piedra en La Gran Fisura, al este de la Avanzada del Halcón.‡El capitán forestal Venn\'ren, de la Avanzada del Halcón, quiere que mates 8 crías Guadaña de Piedra y 3 alfas Guadaña de Piedra en La Gran Fisura, al este de la Avanzada del Halcón.‡Le capitaine des forestiers Venn\'ren du Guet de l\'épervier veut que vous tuiez 8 Jeunes fauchepierre et 3 Alphas fauchepierre à la Grande fissure, à l\'est du Guet de l\'épervier.‡猎鹰岗哨的游侠队长维恩雷要你前往猎鹰岗哨以东的大裂隙，杀死8个石镰幼崽和3个石镰突击者。‡在獵鷹哨站的遊俠隊長范瑞要你去獵鷹哨站東邊的大裂縫殺死8個小石鐮掠奪者和3個石鐮突擊隊員。',
  }
},
[9341] = {
  {
    'Tabardo da Aurora Argêntea‡Гербовая накидка Серебряного Рассвета‡Wappenrock der Argentumdämmerung‡은빛 여명회 휘장‡Tabardo del Alba Argenta‡Tabardo de El Alba Argenta‡Tabard de l\'Aube d\'argent‡银色黎明战袍‡銀色黎明外袍',
    nil,
    '‡Твоя помощь в нашем деле была очень ценной, Трансмастер. Если пожелаешь, я могу сделать так, что ты получишь гербовую накидку Серебряного Рассвета. Мы гордимся тем, что ты в числе наших союзников.‡Ihr habt unserer Sache sehr gedient, <Name>. Wenn ihr wollt, kann ich Euch einen Wappenrock der Argentumdämmerung zur Verfügung stellen. Wir sind stolz, Euch zu unseren Verbündeten zu zählen.‡당신은 우리에게 큰 도움이 되었소. 원한다면 은빛 여명회의 휘장을 주도록 하지. 우리 동맹의 일원이 되어 주다니 뿌듯하오이다.‡Has contribuido mucho a nuestra causa, <nombre>. Si lo deseas, te daré el tabardo de Alba Argenta. Nos enorgullece contar contigo.‡‡Vous avez grandement aidé notre cause, <nom>. Si vous le souhaitez, je peux vous procurer le tabard de l\'Aube d\'argent. Nous sommes fiers de vous compter parmi nos alliés.‡‡',
  }
},
[9342] = {
  {
    'Marauding Crust Bursters‡Хищный землерой‡Plündernde Krustenbohrer‡‡Revientacortezas merodeadores‡‡Les perceurs de croûte maraudeurs‡‡',
    nil,
    'Foreman Razelcraz at the mines near Thrallmar wants you to kill 15 Marauding Crust Bursters. The worms have a tendency to attack suddenly from their tunnels below ground.‡Убейте 15 хищных землероев по просьбе штейгера Разлкраза. Эти черви предпочитают нападать неожиданно, из-под земли.‡Großknecht Razelcraz bei den Minen in der Nähe von Thrallmar möchte, dass Ihr 15 plündernde Krustenbohrer tötet. Die Würmer haben die Angewohnheit, unplötzlich aus ihren unterirdischen Tunneln anzugreifen.‡‡El supervisor Razelcraz, de las minas que están cerca de Thrallmar, quiere que mates a quince revientacortezas merodeadores. Los gusanos tienen tendencia a atacar de repente desde sus túneles, que están bajo tierra.‡El supervisor Razelcraz, de las minas que están cerca de Thrallmar, quiere que mates a quince revientacortezas merodeadores. Los gusanos tienen tendencia a atacar de repente desde sus túneles, que están bajo tierra.‡Le contremaître Razelcraz, des mines près de Thrallmar, veut que vous tuiez 15 Perceurs de croûte maraudeurs. Les vers ont tendance à attaquer brutalement à partir de leurs tunnels souterrains.‡‡',
  }
},
[9343] = {
  {
    'Tabardo da Aurora Argêntea‡Гербовая накидка Серебряного Рассвета‡Wappenrock der Argentumdämmerung‡은빛 여명회 휘장‡Tabardo del Alba Argenta‡Tabardo de El Alba Argenta‡Tabard de l\'Aube d\'argent‡银色黎明战袍‡銀色黎明外袍',
    nil,
    '‡‡Ihr habt unserer Sache sehr gedient, <Name>. Wenn ihr wollt, kann ich Euch einen Wappenrock der Argentumdämmerung zur Verfügung stellen. Wir sind stolz, Euch zu unseren Verbündeten zu zählen.‡‡‡‡Vous avez grandement aidé notre cause, <nom>. Si vous le souhaitez, je peux vous procurer le tabard de l\'Aube d\'argent. Nous sommes fiers de vous compter parmi nos alliés.‡‡',
  }
},
[9344] = {
  {
    'A Hasty Departure‡Поспешный отъезд‡Der überstürzte Aufbruch‡‡Una salida apresurada‡‡Un départ précipité‡‡',
    nil,
    'Far Seer Regulkut wants you to track down her student Grelag.‡Разыщите Грелага, ученика провозвестницы Регулкут.‡Scharfseherin Regulkut möchte, dass Ihr ihren Schüler Grelag findet.‡‡La clarividente Regulkult quiere que encuentres el rastro de su estudiante Grelag.‡La clarividente Regulkult quiere que encuentres el rastro de su estudiante Grelag.‡La prophétesse Regulkut veut que vous retrouviez son élève Grelag.‡‡',
  }
},
[9345] = {
  {
    'Preparando o unguento‡Изготовление мази‡Herstellung der Salbe‡고약 재료 준비‡Preparar el bálsamo‡Preparar el bálsamo‡Préparation du baume‡准备药膏‡準備藥膏',
    nil,
    'Colete 12 mudas de Folhespinho do Fogo do Inferno para um unguento, e fale novamente com Grolag no Acampamento Quebra-espinha.‡Соберите 12 листьев пламенного шиполиста и возвращайтесь к Грелагу на Заставу Хребтолома.‡Grelag im Rückenbrecherposten möchte, dass Ihr ihm 12 Höllenwirbelkräuter für seine Salbe bringt.‡고약의 재료가 되는 지옥불 가시돌기 12개를 모아서 해골망치 초소의 그렐라그에게 가져가야 합니다.‡Reúne doce plantas de Espinelas de Fuego Infernal para un bálsamo y vuelve con Grelag al Avanzada Rompeloma.‡Reúne doce plantas de Espinelas de Fuego Infernal para un bálsamo y vuelve con Grelag al Avanzada Rompeloma.‡Cueillez 12 Atrics des flammes infernales pour un baume et retournez voir Grelag au Poste de Brise-échine.‡将制作药膏所需的12片地狱火刺叶交给断背岗哨的葛雷拉格。‡收集12份地獄火骨葉植物然後交給斷脊氏族崗哨的格萊克以完成他的藥膏。',
  }
},
[9346] = {
  {
    'When Helboars Fly‡Зловепрь – птица гордая‡Wenn Hölleneber fliegen‡‡Cuando los jabinfernos vuelen‡‡Quand les sangliers voleront‡‡',
    nil,
    'Watch Commander Krunk in Thrallmar wants you to bring him 10 Plump Helboar Carcasses from Starving Helboars.‡Принесите командиру стражи Кранку из Траллмара 10 раздутых трупов голодных зловепрей.‡Wachtkommandant Krunk in Thrallmar möchte, dass Ihr ihm 10 klobige Hölleneberkadaver von verhungernden Höllenebern bringt.‡‡El comandante de vigilancia Krunk de Thrallmar quiere que le lleves 10 carcasas de jabinferno cebado de los jabinfernos hambrientos.‡El comandante de vigilancia Krunk de Thrallmar quiere que le lleves 10 carcasas de jabinferno cebado de los jabinfernos hambrientos.‡Le commandant de la garde Krunk, de Thrallmar, veut 10 Carcasses dodues de sanglier infernal, prises sur les Sangliers infernaux affamés.‡‡',
  }
},
[9349] = {
  {
    'Sessão de catação‡Сбор яиц опустошителей‡Felshetzereier sammeln‡칼날발톱 알 수집‡Redada de huevos de devastador‡Redada de huevos de devastador‡Ramasser les œufs de ravageurs‡掠食者的卵‡收集劫毀者蛋',
    nil,
    'Colete 12 Ovos de Assolador para Ofélio no Zepelim Caído na Península Fogo do Inferno.‡Принесите 12 яиц опустошителей Легасси на место крушения дирижабля на полуострове Адского Пламени.‡Bringt 12 Felshetzereier zu Legassi bei der Zeppelinabsturzstelle auf der Höllenfeuerhalbinsel.‡지옥불 반도의 비행선 추락지에 있는 레가시를 위해 칼날발톱 알 12개를 가져와야 합니다.‡Consigue 12 huevos de devastador para Legassi en el Zepelín Caído, en la Península del Fuego Infernal.‡Consigue 12 huevos de devastador para Legassi en el Zepelín Caído, en la Península del Fuego Infernal.‡Récupérez 12 Œufs de ravageurs pour le compte de Legassi, de l\'épave du zeppelin dans la péninsule des Flammes infernales.‡将12枚饥饿掠食者的卵交给地狱火半岛飞艇坠毁点的雷加希。‡替地獄火半島，飛艇失事地的雷噶西取得12顆劫毀者蛋。',
  }
},
[9351] = {
  {
    'Emissários muito loucos‡Дикие демоны Бездны‡Wilde Leerwandler‡야생의 보이드워커‡Abisarios enloquecidos‡Abisarios enloquecidos‡Les marcheurs du Vide sauvages‡疯狂的虚空行者‡野放的虛無行者',
    nil,
    'Leve 10 Essências Condensadas de Emissários do Caos para Gritonho Ouvessorte, o "Berrante", no Zepelim Caído.‡Принесите 10 конденсированных сущностей демона Бездны "Крикуну" Скриду Многослову на место крушения дирижабля.‡Bringt 10 kondensierte Leerwandleressenzen zu "Schreihals" Quack Lufthans bei der Zeppelinabsturzstelle.‡비행선 추락지에 있는 "호들갑쟁이" 스크리드 럭히드에게 응축된 보이드워커 정수를 가져가야 합니다.‡Llévale 10 esencias de abisario condensado a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Llévale 10 esencias de abisario condensado a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Remettez 10 Essences de marcheur du Vide condensées à Laïus "Brailleur" Airbuse à l\'épave du zeppelin.‡将10份浓缩的虚空行者精华交给飞艇坠毁点的"尖嗓子"斯克里·拉克希德。‡將10個濃縮的虛無行者精華帶給飛艇失事地的『驚嘆』史哥利德·幸運心。',
  }
},
[9352] = {
  {
    'Intrusões darnassianas‡Вторжение из Дарнасса‡Darnassische Eindringlinge‡나이트 엘프의 침입‡Intrusiones darnasianas‡Intrusiones darnassianas‡Les intrusions darnassiennes‡达纳苏斯的侵扰‡達納蘇斯的入侵',
    nil,
    'Vá ao Sacrário do Oeste, a sudoeste da Praça Asa do Falcão, e derrote todos os intrusos que encontrar. Apresente suas descobertas à Protetora de Meridianos Velania.‡Отправляйтесь в Западное святилище, к юго-западу от площади Соколиных Крыльев, и уничтожьте всех чужаков, которых вы там встретите. Затем сообщите о результатах хранительнице энергии Велании.‡Reist zum Sanktum des Westens südwestlich vom Falkenplatz und vernichtet jegliche Eindringlinge, die Ihr dort findet. Berichtet anschließend Leybewahrerin Velania.‡매날개 광장 남서쪽에 있는 서부 성소로 가서 그곳을 침입한 수상한 자를 처치한 다음, 맥지기 벨라니아에게 가서 발견한 사실을 보고해야 합니다.‡Ve al Sagrario del Oeste, al suroeste de la Plaza Alalcón y derrota a cualquier intruso que se encuentre allí. Informa del resultado a la vigilante-Ley Velania.‡Ve al Sagrario del Oeste, al suroeste de la Plaza Alalcón y derrota a cualquier intruso que se encuentre allí. Informa del resultado a la vigilante-Ley Velania.‡Rendez-vous au Sanctum occidental, au sud-ouest de la Place de l\'Épervier, et tuez les intrus s\'il y en a. Ensuite, allez faire votre rapport à la telluriste Velania.‡前往鹰翼广场西南方的西部圣殿击败在那一带出现的入侵者，然后将你发现的情况汇报给魔网监护者薇兰妮亚。‡前往西部聖所，就在獵鷹之翼廣場的西南邊，擊敗那裡所有的入侵者。將你的發現向牧地看守者維蘭妮雅報告。',
  }
},
[9353] = {
  {
    '‡‡‡‡‡‡‡‡可口可樂禮物盒兌換券',
    nil,
    nil,
  }
},
[9354] = {
  {
    '‡‡‡‡‡‡‡‡尋找新材料',
    nil,
    '‡‡‡‡‡‡‡‡從突變的裂蹄身上收集8塊裂蹄皮和8個裂蹄腱。等你弄到了材料把它們帶給榮譽堡的休夫利。',
  }
},
[9355] = {
  {
    'Um trabalho para uma pessoa inteligente‡Работа для сообразительных‡Eine Aufgabe für einen intelligenten Helden‡영리한 자를 위한 임무‡Un trabajo para alguien inteligente‡Un trabajo para alguien inteligente‡Un boulot pour un type intelligent‡聪明人的工作‡聰明人的工作',
    nil,
    'Mate 15 Estoura-crostas Invasores e apresente-se ao Encarregado Grandepar na Fortaleza da Honra.‡Убейте 15 хищных землероев и возвращайтесь к штейгеру Большие Десны в Оплот Чести.‡Tötet 15 plündernde Krustenbohrer und kehrt dann zu Großknecht Biggums in der Ehrenfeste zurück.‡명예의 요새에 있는 현장감독 비굼스가 약탈자 바위갈이 미늘벌레 15마리를 처치해달라고 부탁했습니다.‡Mata 15 revientacortezas merodeadores y vuelve a hablar con el supervisor Biggums en el Bastión del Honor.‡Mata 15 revientacortezas merodeadores y vuelve a hablar con el supervisor Biggums en el Bastión del Honor.‡Tuer 15 Perceurs de croûte maraudeurs, puis retourner voir le contremaître Biggums au bastion de l\'Honneur.‡杀死15只游荡的硬壳穿地虫，然后向荣耀堡的工头比格姆斯复命。‡殺死15名捕食中的地殼穿刺者再回到榮譽堡的工頭比干莫斯那裡。',
  }
},
[9356] = {
  {
    'Fadinha furada‡Летать как птица‡So weich wie Butter‡버터처럼 부드러운...‡Suave como una pluma‡Suave como una pluma‡Les doigts dans le nez‡万无一失‡技術高超',
    nil,
    'Leve 12 Asas Roliças de Urubu para Ofélio no Zepelim Caído.‡Принесите 12 мясистых крыльев канюка Легасси на место крушения дирижабля.‡Bringt 12 fleischige Bussardflügel zu Legassi bei der Zeppelinabsturzstelle.‡오동통한 독수리 날개 12개를 비행선 추락지에 있는 레가시에게 가져가야 합니다.‡Llévale 12 alas de águila ratonera rellena a Legassi en el Zepelín Caído.‡Llévale 12 alas de águila ratonera rollizas a Legassi en el Zepelín Caído.‡Apportez 12 Ailes de busard dodues à Legassi à l\'épave du zeppelin.‡将12只强壮的秃鹫翅膀交给飞艇坠毁点的雷加希。‡將12個豐滿的禿鷲翅膀交給飛艇失事地的雷噶西。',
  }
},
[9357] = {
  {
    'Report to Aeldon Sunbrand‡Задание Аэльдона Озаренного Солнцем‡Meldet Euch bei Aeldon Sonnenmal‡앨돈 선브랜드에게 보고‡Informar a Aeldon Marcasol‡‡Se présenter à Aeldon Signesol‡‡向艾爾頓·桑布蘭德報告',
    nil,
    'Report to Aeldon Sunbrand at the Inner Elf Gate in Eversong Woods.‡Поговорите с Аэльдоном Озаренным Солнцем у Внутренних эльфийских ворот в Лесах Вечной Песни.‡Meldet Euch bei Aeldon Sonnenmal beim inneren Elfentor im Immersangwald.‡영원노래 숲의 내곽 엘프 관문에 있는 앨돈 선브랜드에게 보고해야 합니다.‡Preséntate ante Aeldon Marcasol en la Puerta Elfa Interior, en el Bosque Canción Eterna.‡Preséntate ante Aeldon Marcasol en la Puerta Elfa Interior, en el Bosque Canción Eterna.‡Présentez-vous à Aeldon Signesol à la porte elfique intérieure, dans le bois des Chants éternels.‡‡向永歌森林內精靈之門的艾爾頓·桑布蘭德報告。',
  }
},
[9358] = {
  {
    'A patrulheira Sareyn‡Следопыт Сарейн‡Waldläuferin Sareyn‡순찰자 사레인‡La forestal Sareyn‡La forestal Sareyn‡Le forestier Sareyn‡游侠萨蕾恩‡遊俠塞瑞',
    nil,
    'Fale com a Patrulheira Sareyn na Vila de Brisabela, que fica na Floresta do Canto Eterno.‡Поговорите со следопытом Сарейн у деревни Легкий Ветерок, что в лесах Вечной Песни.‡Meldet Euch bei Waldläuferin Sareyn außerhalb von Morgenluft im Immersangwald.‡영원노래 숲의 산들바람 마을 밖에 있는 순찰자 사레인에게 보고해야 합니다.‡Informa a la forestal Sareyn en las afueras de Aldea Brisa Pura en el Bosque Canción Eterna.‡Preséntate ante la forestal Sareyn en las afueras de Aldea Brisa Pura en el Bosque Canción Eterna.‡Présentez-vous au forestier Sareyn, à l’extérieur du village de Brise-Clémente, dans le bois des Chants éternels.‡向永歌森林晴风村外的游侠萨蕾恩报到。‡向永歌森林晴風村外的遊俠塞瑞報告。',
  }
},
[9359] = {
  {
    'O Retiro dos Andarilhos‡Обитель Странников‡Zuflucht der Weltenwanderer‡원정순찰대 산장‡El Retiro del Errante‡El Retiro del Errante‡La Retraite des pérégrins‡远行者居所‡遠行者居所',
    nil,
    'Apresente-se à Tenente Correalba no Retiro dos Andarilhos, que fica na Floresta do Canto Eterno.‡Поговорите с лейтенантом Вестницей Зари в обители Странников, что в лесах Вечной Песни.‡Meldet Euch bei Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer im Immersangwald.‡영원노래 숲의 원정순찰대 산장에 있는 부관 돈러너에게 보고해야 합니다.‡Informa a la teniente Correalba en el Retiro del Errante, en el Bosque Canción Eterna.‡Preséntate ante la teniente Correalba en el Retiro del Errante, en el Bosque Canción Eterna.‡Présentez-vous au lieutenant Coursaurore à la Retraite des Pérégrins, dans le bois des Chants éternels.‡向永歌森林远行者营地的达恩·晨行者中尉报告。‡向永歌森林遠行者營地的晨奔中尉報告。',
  }
},
[9360] = {
  {
    'Invasão Amani‡Вторжение племени Амани‡Angriff der Amani‡아마니의 침공‡La invasión Amani‡La invasión Amani‡L\'invasion des Amani‡阿曼尼的入侵‡阿曼尼入侵',
    nil,
    'Entregue os Planos de Invasão Amani à Tenente Correalba no Retiro dos Andarilhos.‡Доставьте планы вторжения племени Амани лейтенанту Вестнице Зари в обитель Странников.‡Bringt die Invasionspläne der Amani zu Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너에게 아마니 침공 계획서를 전달해야 합니다.‡Entrega los planes de la invasión Amani a la teniente Correalba en El Retiro del Errante.‡Entrega los planes de la invasión Amani a la teniente Correalba en El Retiro del Errante.‡Remettre les Plans d\'invasion amani au lieutenant Coursaurore à la Retraite des pérégrins.‡将阿曼尼入侵计划交给远行者居所的达恩·晨行者中尉。‡將阿曼尼攻擊計畫送給遠行者居所的晨奔中尉。',
  }
},
[9361] = {
  {
    'Javiltusco, a outra carne branca‡Зловепрь – тоже мясо‡Hölleneber, die etwas andere Delikatesse‡지옥멧돼지 고기 정화‡Huevos fritos con jabinferno‡Huevos fritos con jabinferno‡On se régale avec le sanglier infernal !‡地狱野猪，另一种白肉‡地獄野豬，另一種白肉',
    nil,
    'Ofélio, no Zepelim Caído, quer que você colete 8 nacos de Carne Purificada de Javiltusco. Para purificar a carne, use a Mistura de Purificação na Carne Estragada de Javiltusco que você coletar.‡Легасси требует принести ему 8 кусков мяса зловепря на место крушения дирижабля. Убейте зловепря, добудьте порченое мясо зловепря, а затем очистите его с помощью микстуры очищения.‡Legassi bei der Zeppelinabsturzstelle möchte, dass Ihr 8 Stück geläutertes Hölleneberfleisch sammelt. Um das Fleisch zu reinigen, schüttet die Läuterungsmischung über das besudelte Hölleneberfleisch, das Ihr von den Höllenebern gesammelt habt.‡비행선 추락지에 있는 레가시가 정화된 지옥멧돼지 고기 8개를 모아 달라고 부탁했습니다. 고기를 정화하려면 광기어린 지옥멧돼지에게 얻은 오염된 지옥멧돼지 고기에 정화의 혼합물을 사용해야 합니다.‡Legassi en el Zepelín Caído quiere que consigas 8 unidades de carne purificada de jabinferno. Para purificar la carne, utiliza la mezcla purificadora en la carne de jabinferno máculo que consigas encontrar.‡Legassi en el Zepelín Caído quiere que consigas 8 unidades de carne purificada de jabinferno. Para purificar la carne, utiliza la mezcla purificadora en la carne de jabinferno máculo que consigas encontrar.‡Legassi de l\'Épave du zeppelin veut que vous récupériez 8 morceaux de Viande de sanglier infernal purifiée. Pour purifier la viande, utilisez la Mixture de purification sur la Viande de sanglier infernal contaminée que vous prendrez sur des Sangliers infernaux.‡飞艇坠毁点的雷加希要你收集8块纯净的地狱野猪肉。你必须首先猎杀地狱野猪，然后利用净化药剂来净化被污染的地狱野猪肉。‡飛艇失事地的雷噶西要你去收集8個乾淨的地獄野豬肉。使用淨化藥劑來淨化你從瘋狂地獄野豬身上取的腐敗地獄野豬肉。',
  }
},
[9362] = {
  {
    'Senhor da Guerra Krellian‡Полководец Креллиан‡Kriegsherr Krellian‡크렐리안 장군‡Señor de la Guerra Krellian‡Señor de la guerra Krellian‡Le seigneur de guerre Krellian‡军阀克雷利安‡督軍克雷利安',
    nil,
    'Recupere a Concha Prismática para o Arquimago Tauriel. O Arquimago reside numa torre no topo dos penhascos de Azshara.‡Принесите радужную раковину верховному магу Ксилему в башню в утесах Азшары.‡Beschafft die prismatische Muschel für Erzmagier Xylem. Der Erzmagier befindet sich in einem Turm auf den Klippen von Azshara.‡프리즘 껍질을 되찾아 아즈샤라 절벽 위 탑에 살고 있는 대마법사 실렘에게 돌려주어야 합니다.‡Recupera la concha centelleante para el archimago Xylem. El archimago vive en una torre en lo alto del precipicio de Azshara.‡Recupera la concha centelleante para el archimago Xylem. El archimago vive en una torre en lo alto del precipicio de Azshara.‡Récupérez la Coquille prismatique pour l\'archimage Xylem. L\'archimage réside dans une tour au sommet des falaises d\'Azshara.‡为大法师克希雷姆夺回虹彩贝壳。大法师克希雷姆就居住在艾萨拉北部悬崖上的一座塔中。‡為大法師克希雷姆取得稜彩貝殼。大法師就住在艾薩拉懸崖邊上的一座哨塔裡。',
  }
},
[9363] = {
  {
    'Aviso à Vila de Brisabela‡Предупреждение деревне Легкий Ветерок‡Warnt Morgenluft‡산들바람 마을에 경고 전하기‡Aviso a la Aldea Brisa Pura‡Aviso a la Aldea Brisa Pura‡Avertir le village de Brise-clémente‡警告晴风村‡警告晴風村',
    nil,
    'Vá à Vila de Brisabela na Floresta do Canto Eterno e fale com o Patrulheiro Degolien.‡Отправляйтесь в деревню Легкий Ветерок в лесах Вечной Песни и поговорите со следопытом Деголиеном.‡Reist nach Morgenluft im Immersangwald und sprecht mit Waldläufer Degolien.‡영원노래 숲의 산들바람 마을로 가서 순찰자 데골리엔과 대화하십시오.‡Dirígete a Aldea Brisa Pura en el Bosque Canción Eterna y habla con el forestal Degolien.‡Dirígete a Aldea Brisa Pura en el Bosque Canción Eterna y habla con el forestal Degolien.‡Rendez-vous au village de Brise-clémente dans le bois des Chants éternels et parlez au forestier Degolien.‡与永歌森林晴风村的游侠戴戈利恩谈一谈。‡前往永歌森林的晴風村和遊俠迪哥里恩談談。',
  }
},
[9364] = {
  {
    'Magia fragmentada‡Частицы магии‡Gespaltene Magie‡변이 마법‡Magia fragmentada‡Magia fragmentada‡Magie morcelée‡魔法的碎片‡破碎的魔法',
    nil,
    'Polimorfe as Iraliscas de Azshara e mate os clones que aparecerem. Quando matar 50 Clones Polimorfados, volte e fale com o Arquimago Tauriel, em Azshara.‡Наложите заклинание превращения на тварей Бича Злобы в Азшаре и убейте клонов, которые появятся несколько мгновений спустя. Убейте 50 клонов и возвращайтесь к верховному магу Ксилему в Азшару.‡Verwandelt die Grollflossen von Azshara und tötet die Kopien, die einige Sekunden später auftauchen. Wenn Ihr 50 verwandelte Kopien vernichtet habt, kehrt zu Erzmagier Xylem in Azshara zurück.‡아즈샤라의 원한의꼬리일족을 변이하고 몇 초 후 나타나는 변이된 복제생물 50마리를 해치워야 합니다. 모두 처치하고 나서 아즈샤라의 대마법사 실렘에게 돌아가야 합니다.‡Aplica el hechizo polimórfico al Látigo de Ira de Azshara y mata a los clones que aparezcan pasados unos segundos. Cuando hayas matado a suficientes, vuelve junto al archimago Xylem en Azshara.‡Aplica el hechizo polimórfico a las sirenas Látigo de Ira de Azshara y mata a los clones que aparezcan pasados unos segundos. Cuando hayas matado a 50, vuelve junto al archimago Xylem en Azshara.‡Métamorphosez les Fouette-bile d\'Azshara, puis tuez les clones qui apparaissent quelques instants plus tard. Quand vous aurez tué 50 clones de métamorphose, retournez voir l\'archimage Xylem en Azshara.‡对艾萨拉的恶鞭纳迦使用变形术，然后杀死几秒钟后出现的相似体。当你杀了50个相似体后，回去向大法师克希雷姆复命。‡對艾薩拉的惡鞭者施放變形術並殺死幾秒後出現的複製物。等你殺夠了，再回去找艾薩拉的大法師克希雷姆。',
  }
},
[9365] = {
  {
    'A recompensa de um ladrão‡Награда вора‡Der Lohn des Diebes‡도적의 보상‡Una recompensa de ladrón‡Una recompensa de ladrón‡La récompense d\'un voleur‡潜行者的奖励‡',
    nil,
    'You\'ve proven yourself, today, <name>.nnWhile I have little else to give you, I do have this crown; a fitting gift for a conqueror. May it light your way.‡Верните Пламя Штормграда (NAME)‡Bringt die Flamme von Stormwind zu (NAME).‡You\'ve proven yourself, today, <name>.nnWhile I have little else to give you, I do have this crown; a fitting gift for a conqueror. May it light your way.‡Devuelve la llama de Ventormenta a (NAME).‡Devuelve la llama de Ventormenta a (NAME).‡Rapportez la Flamme de Stormwind à (NOM).‡将暴风城烈焰交给(NAME)。‡',
  }
},
[9366] = {
  {
    'Precisando de sangrevil‡Оскверненная кровь‡Die Suche nach Teufelsblut‡순수한 악마의 힘‡Se busca: sangrevil‡Se busca: Sangrevil‡Il nous faut du gangresang‡邪恶之血‡需要魔化之血',
    nil,
    'Ryathen, o Lúgubre, na Vigília do Falcão, que fica na Península Fogo do Inferno, quer que você mate os Terríferos que habitam os Poços de Aggonar e colete 6 Amostras de Sangrevil.‡Принесите 6 образцов оскверненной крови исчадий ужаса, обитающих у прудов Аггонара, Риатену Мрачному из Соколиного дозора на полуострове Адского Пламени.‡Ryathen der Düstere an der Falkenwacht auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 6 Teufelsblutproben von den Terrorbestien bringt, die bei den Teichen von Aggonar umherstreifen‡지옥불 반도의 매의 감시탑에 있는 고뇌하는 리아센이 아고나르의 웅덩이에 있는 공포의 마귀에게서 지옥피 견본 6개를 가져다 달라고 부탁했습니다.‡Ryathen el Sombrío en la Avanzada del Halcón, en la Península del Fuego Infernal, quiere que le lleves 6 muestras de sangrevil de los terroadictos que viven en las Pozas de Aggonar.‡Ryathen el Sombrío en la Avanzada del Halcón, en la Península del Fuego Infernal, quiere que le lleves 6 muestras de sangrevil de los terroadictos que viven en las Pozas de Aggonar.‡Ryathen le Sombre, du Guet de l\'épervier dans la péninsule des Flammes infernales, veut que vous lui procuriez 6 Échantillons de grangresang prélevés sur les Fiels de la terreur qui vivent aux bassins d\'Aggonar.‡猎鹰岗哨的阴沉的利亚森要你前往阿苟纳之池，从恐惧魔身上收集6份邪血样本。‡地獄火半島獵鷹哨站的『憂鬱者』瑞安登要你從住在阿葛納爾之池的恐懼惡魔身上取回6份魔化之血樣本。',
  }
},
[9367] = {
  {
    'O Festival do Fogo‡Праздник Огня‡Das Fest des Feuers‡불의 축제‡El Festival del Fuego‡El Festival del Fuego‡La fête du Feu‡火焰的节日‡火焰節慶',
    nil,
    'Verifique as fogueiras de Ventobravo, Altaforja e Darnassus. Quando terminar, fale com um Historiador do Festival em uma capital.‡Прикоснитесь к пламени праздничных костров в Штормграде, Стальгорне и Дарнассе, затем поговорите с хранителем мудрости праздника в столичных городах.‡Wärmt Euch an den Freudenfeuern in Sturmwind, Eisenschmiede und Darnassus. Sprecht anschließend mit einem Meister der Lehren innerhalb der Hauptstädte.‡스톰윈드, 아이언포지, 다르나서스에 있는 화톳불을 만져보고 대도시 안에 있는 한여름 축제 현자에게 돌아가십시오.‡Toca las hogueras de Ventormenta, Forjaz y Darnassus y habla con un maestro del Conocimiento del festival en cada capital.‡Toca las hogueras de Ventormenta, Forjaz y Darnassus y habla con un maestro cultural del Festival en cada capital.‡Touchez les feux de joie à l\'intérieur de Hurlevent, Forgefer et Darnassus, puis parlez à n\'importe quel Maître des traditions de la fête dans une des capitales.‡碰触暴风城、铁炉堡和达纳苏斯城里的篝火，然后与城市内的节日博学者交谈。‡觸摸暴風城，鐵爐堡和達納蘇斯裡的營火，再和任何一個節慶傳說大師談談。',
  }
},
[9368] = {
  {
    'O Festival do Fogo‡Праздник Огня‡Das Fest des Feuers‡한여름 불꽃축제‡El Festival del Fuego‡El Festival del Fuego‡La fête du Feu‡火焰的节日‡火焰節慶',
    nil,
    'Toque as fogueiras de Orgrimmar, do Penhasco do Trovão e da Cidade Baixa. Em seguida, fale com um Contador de Histórias do Festival em qualquer capital.‡Прикоснитесь к пламени праздничных костров в Оргриммаре, Громовом Утесе и Подгороде, затем поговорите с Праздничным сказителем в столичных городах.‡Wärmt Euch an den Freudenfeuern in Orgrimmar, Donnerfels und Unterstadt. Sprecht anschließend mit einem Geschichtenerzähler innerhalb der Hauptstädte.‡오그리마, 썬더 블러프, 언더시티에 화톳불을 만져보고 해당 대도시의 한여름 축제 현자에게 가십시오.‡Toca las hogueras de Orgrimmar, Cima del Trueno y Entrañas y habla con un Cuentacuentos en cada capital.‡Toca las hogueras de Orgrimmar, Cima del Trueno y Entrañas y habla con un cuentacuentos del Festival en cada capital.‡Touchez les feux de joie à l\'intérieur d\'Orgrimmar, des Pitons du Tonnerre et de Fossoyeuse, puis parlez à n\'importe quel Maître des traditions de la fête dans une des capitales.‡碰触奥格瑞玛、雷霆崖和幽暗城里的篝火，然后与城市内的节日诗人交谈。‡觸摸奧格瑪，雷霆崖和幽暗城裡的營火，再和任何一個節慶故事使者談談。',
  }
},
[9369] = {
  {
    'O reabastecimento dos cristais de cura‡Исцеляющие кристаллы‡Wiederaufladen der Heilkristalle‡치유의 수정 보충‡Recargar los cristales de sanación‡Recargar los cristales de sanación‡Recharger les cristaux de soin‡补充治疗水晶‡補充治療水晶',
    nil,
    'Adquira 8 Ampolas de Sangue das Mariposas do Vale. Em seguida, entregue-as a Proenitus no Ponto de Impacto, que fica no Vale Ammen.‡Добудьте 8 фиалов с кровью мотылька из долинных мотыльков и принесите их Проэнитусу на место крушения в долине Аммен.‡Beschafft Euch 8 Phiolen mit Mottenblut von den in der Nähe hausenden Talmotten und bringt sie zu Proenitus bei der Absturzstelle im Am\'mental.‡골짜기 나방에게서 나방 피가 든 유리병 8개를 모은 후, 암멘 골짜기의 추락 지점에 있는 프로에니투스에게 가져가야 합니다.‡Consigue 8 viales de sangre de polilla del valle y llévaselos a Proenitus a Lugar del Accidente en Valle Ammen.‡Consigue 6 viales de sangre de polilla del valle y dáselos a Proenitus a Lugar del Accidente en Valle Ammen.‡Extraire 8 Fioles de sang de phalène sur les Phalènes du val, puis les rapporter à Proenitus, au Point d\'impact du val d\'Ammen.‡从附近的峡谷蛾身上收集8瓶蛾血，然后向埃门谷坠毁点的普罗尼图斯复命。‡從附近的安曼谷飛蛾身上取得8瓶飛蛾血清，再回到安曼谷失事地點的波尼特斯那裡。',
  }
},
[9370] = {
  {
    'A purificação deve ser interrompida‡Остановить очищение‡Stoppt das Säuberungsritual‡정화 의식 저지‡Detengamos la purificación‡Detengamos la purificación‡Il faut arrêter la purification‡阻止净化‡阻止淨化',
    nil,
    'Coloque a Gema da Sinalização perto do Altar de Aggonar, nos Poços de Aggonar, e derrote os anacoretas draenei que aparecerem. Leve a Gema da Sinalização para Ryathen, o Lúgubre, na Vigília do Falcão, quando completar a tarefa.‡Поставьте сигнальный самоцвет на алтарь Аггонара, рядом с прудами Аггонара, и уничтожьте дренейского анахорета и всех, кто явится на сигнал. После выполнения задания заберите самоцвет и возвращайтесь к Риатену Мрачному в Соколиный дозор.‡Platziert den Signalstein bei den Teichen von Aggonar am Altar von Aggonar und besiegt alle Anachoreten der Draenei, die auf Eure Signal reagieren. Kehrt anschließend mit dem Signalstein zu Ryathen dem Düsteren bei der Falkenwacht zurück.‡아고나르의 웅덩이에 있는 아고나르의 제단에 신호의 보석을 놓은 후, 소환에 반응하는 모든 드레나이 수도자를 처치하십시오. 임무를 마친 다음 신호의 보석을 가지고 매의 감시탑에 있는 고뇌하는 리아센에게 가야 합니다.‡Coloca la gema de señalización cerca del Altar de Aggonar en las Pozas de Aggonar y derrota a los anacoretas draenei que respondan a tu invocación. Luego lleva la gema a Ryathen el Sombrío a la Avanzada del Halcón.‡Coloca la gema de señalización cerca del Altar de Aggonar en las Pozas de Aggonar y derrota a los anacoretas draenei que respondan a tu invocación. Luego lleva la gema a Ryathen el Sombrío a la Avanzada del Halcón.‡Placez la Gemme de signalisation près de l\'autel d\'Aggonar, aux bassins d\'Aggonar, et triomphez de tous les anachorètes draeneï qui répondront à vos invocations. Retournez voir Ryathen le Sombre au Guet de l\'épervier avec la Gemme de signalisation quand vous en aurez terminé.‡前往阿苟纳之池，将信号宝石放置在阿苟纳祭坛附近，击败被召唤出来的德莱尼学者。完成任务后返回猎鹰岗哨，将信号宝石交还给阴沉的利亚森。‡前往阿葛納爾之池，將德萊尼信號寶石放在阿葛納爾祭壇附近，擊敗任何回應你召喚的德萊尼隱士。完成後帶著信號寶石回到獵鷹哨站的『憂鬱者』瑞安登那裡。',
  }
},
[9371] = {
  {
    'A botânica Taerix‡Ботаник Таэрикс‡Botanikerin Taerix‡식물학자 태릭스 찾기‡La botánica Taerix‡La botánica Taerix‡La botaniste Taerix‡植物学家塔蕾克丝‡植物學家泰瑞茲',
    nil,
    'Fale com a Botânica Taerix, no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с ботаником Таэрикс на месте крушения в долине Аммен.‡Sprecht mit Botanikerin Taerix bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 식물학자 태릭스와 대화해야 합니다.‡Habla con la botánica Taerix en el Lugar del Accidente en el Valle Ammen.‡Habla con la botánica Taerix en el Lugar del Accidente en el Valle Ammen.‡Parlez à la botaniste Taerix au Point d\'impact dans le val d\'Ammen.‡与埃门谷坠毁点的植物学家塔蕾克丝谈一谈。‡和安曼谷失事地點的植物學家泰瑞茲談談。',
  }
},
[9372] = {
  {
    'Contaminação demoníaca‡Распространение демонической скверны‡Dämonische Verderbnis‡악마의 오염‡Contaminación demoníaca‡Contaminación demoníaca‡Contamination démoniaque‡恶魔的玷污‡惡魔污染',
    nil,
    'Tiá Juba Rubra, no Posto Cenariano, na Península Fogo do Inferno, quer que você colete 6 Amostras de Sangue de Javiltusco dos Javiltuscos Parrudos.‡Соберите 6 образцов крови зловепря у крупных зловепрей по просьбе Тии Рыжей Гривы с Кенарийской заставы на полуострове Адского Пламени.‡Thiah Rotmähne im Posten des Cenarius auf der Höllenfeuerhalbinsel möchte, dass Ihr 6 Blutproben eines Höllenebers von titanischen Höllenebern sammelt.‡지옥불 반도의 세나리온 초소에 있는 타이아 레드메인이 덩치큰 지옥멧돼지로부터 지옥멧돼지 혈액 견본 6개를 가져다달라고 부탁했습니다.‡Thiah Melenarroja en el Puesto Cenarion, en la Península del Fuego Infernal, te ha pedido que consigas 6 muestras de sangre de jabinfernos de los jabinfernos descomunales.‡Thiah Melenarroja en el Puesto Cenarion, en la Península del Fuego Infernal, te ha pedido que consigas 6 muestras de sangre de jabinfernos de los jabinfernos descomunales.‡Thiah Crin-rouge, du Poste cénarien dans la péninsule des Flammes infernales, vous a demandé de récupérer 6 Échantillons de sang de sanglier infernal sur des Sangliers infernaux massifs.‡地狱火半岛塞纳里奥哨站的塞安·红鬃要你从笨拙的地狱野猪身上收集6份地狱野猪血样。‡地獄火半島上塞納里奧前哨的塞伊亞·紅髮要你從笨重的地獄野豬身上收集6份地獄野豬血的樣本。',
  }
},
[9373] = {
  {
    'Sumário sumido‡Потерянное послание‡Fehlender Schriftverkehr‡사라진 공문‡Carta perdida‡Carta perdida‡La missive manquante‡遗失的信件‡丟失的公文',
    nil,
    'Entregue a Pasta de Couro Corroída para Tiá Juba Rubra, que está acampada perto das Ruínas de Sha\'naar na parte ocidental da Península Fogo do Inferno.‡Доставьте подпорченный кожаный чехол Тие Рыжей Гриве, которая стоит лагерем рядом с руинами Ша\'наара на западе полуострова Адского Пламени.‡Bringt den zerfressenen Lederkoffer zu Thiah Rotmähne in der Nähe der Ruinen von Sha\'naar im westlichen Teil der Höllenfeuerhalbinsel.‡지옥불 반도의 서쪽의 샤나르 폐허 근처에서 야영을 하고 있는 타이아 레드메인에게 부식된 가죽 용기를 가져가야 합니다.‡Llévale el estuche de cuero erosionado a Thiah Melenarroja, que está acampado cerca de las Ruinas de Sha\'naar, al oeste de la Península del Fuego Infernal.‡Llévale el estuche de cuero erosionado a Thiah Melenarroja, que está acampado cerca de las Ruinas de Sha\'naar, al oeste de la Península del Fuego Infernal.‡Remettre l\'Etui en cuir rongé à Thiah Crin-rouge, qui campe près des ruines de Sha\'naar, dans l\'ouest de la péninsule des Flammes infernales.‡前往地狱火半岛西部的沙纳尔废墟，将被腐蚀的皮箱交给驻扎在废墟附近的塞安·红鬃。‡將磨損的皮箱交給塞伊亞·紅髮，他紮營在靠近西地獄火半島的夏納廢墟。',
  }
},
[9374] = {
  {
    'O diário de Arelion‡Записи Арелиона‡Arelions Tagebuch‡아렐리온의 일지‡El diario de Arelion‡El diario de Arelion‡Le journal d\'Arelion‡埃雷利恩的日记‡阿利恩的日記',
    nil,
    'A Magistra Carinda, na Vigília do Falcão, que fica na Península Fogo do Inferno, quer que você vá até os Poços de Aggonar e resgate o Diário de Arelion.‡Отправляйтесь к прудам Аггонара и найдите записи Арелиона по просьбе магистра Каринды из Соколиного дозора на полуострове Адского Пламени.‡Magistrix Carinda bei der Falkenwacht auf der Höllenfeuerhalbinsel möchte, dass Ihr zu den Teichen von Aggonar reist und Arelions Tagebuch sucht.‡지옥불 반도의 매의 감시탑에 있는 마법학자 카린다가 아고나르의 웅덩이로 가서 아렐리온의 일지를 되찾아 달라고 부탁했습니다.‡La magistrix Carinda de la Avanzada del Halcón en la Península del Fuego Infernal quiere que vayas a las Pozas de Aggonar y recuperes el diario de Arelion.‡La magistrix Carinda de la Avanzada del Halcón en la Península del Fuego Infernal quiere que vayas a las Pozas de Aggonar y recuperes el diario de Arelion.‡La magistrice Carinda, au Guet de l\'épervier de la péninsule des Flammes infernales, veut que vous vous rendiez aux bassins d\'Aggonar pour y récupérer le Journal d\'Arelion.‡地狱火半岛猎鹰岗哨的魔导师卡尔琳达要你前往阿苟纳之池，找回埃雷利恩的日记。‡地獄火半島，獵鷹哨站的博學者卡莉達要你去阿葛納爾之池取得阿利恩的日記。',
  }
},
[9375] = {
  {
    'A estrada para a Vigília do Falcão‡Дорога к Соколиному дозору‡Der Weg zur Falkenwacht‡매의 감시탑으로 호위‡Hacia la Avanzada del Halcón‡Hacia la Avanzada del Halcón‡La route du Guet de l\'épervier‡猎鹰岗哨之路‡通往獵鷹哨站的路',
    nil,
    'Proteja a Peregrina Elfa Sangrenta Ferida em sua jornada até a Vigília do Falcão, e então apresente-se a Taleris Miralba.‡Помогите израненной эльфийке крови – пилигриму добраться до Соколиного дозора, затем поговорите с Талерисом Созерцателем Рассвета.‡Beschützt die verwundete Blutelfenpilgerin auf Ihrem Weg zur Falkenwacht und sprecht dann mit Taleris Morgenblick.‡매의 감시탑까지 부상당한 블러드 엘프 순례자를 호위한 후, 탈레리스 돈게이저와 대화해야 합니다.‡Protege a la peregrina elfa de sangre herida en su viaje a la Avanzada del Halcón, luego habla con Taleris Observalba.‡Protege a la peregrina elfa de sangre herida en su viaje a la Avanzada del Halcón, luego habla con Taleris Observalba.‡Protégez le Pèlerin elfe de sang blessé sur la route du Guet de l\'épervier, puis parlez à Taleris Mirelaube.‡护送受伤的血精灵朝圣者返回猎鹰岗哨，然后与塔雷里斯·晨光谈一谈。‡保護受傷的血精靈朝聖者前往獵鷹哨站，然後與達勒利斯·凝明交談。',
  }
},
[9376] = {
  {
    'Os apuros da peregrina‡Скарб пилигрима‡Die Pflicht eines Pilgers‡순례자의 잃어버린 짐‡Una peregrina afligida‡Una peregrina afligida‡Les souffrances du pèlerin‡朝圣者的困境‡朝聖者的困境',
    nil,
    'A Peregrina Elfa Sangrenta Ferida foi atacada por Assoladores Presicerdos ao acampar na Ravina do Pó de Espinheiro. Encontre o acampamento da peregrina e procure pela mochila perdida.‡Перозубые опустошители напали на израненную эльфийку крови – пилигрима, когда она остановилась в Лощине Пыльного Пера. Разыщите ее стоянку и потерянные вещи.‡Die verletzte Blutelfpilgerin wurde von giftigen Stachelklauenfelshetzern angegriffen, als sie die Staubstachelschlucht erkunden wollte. Findet ihr Lager und haltet nach dem vermissten Beutel Ausschau.‡부상당한 블러드 엘프 순례자가 먼지깃 협곡에서 야영할 때 깃송곳니 갈퀴발톱에게 공격받았습니다. 그녀의 야영지를 찾아서 잃어버린 짐이 있는지 수색해봐야 합니다.‡A la peregrina elfa de sangre herida la atacaron los devastadores jabacolmillo cuando deambulaba por el Barranco Pluma Polvorienta. Encuentra los devastadores y mátalos hasta que recuperes la talega desaparecida de la peregrina.‡A la peregrina elfa de sangre herida la atacaron los devastadores jabacolmillo cuando deambulaba por el Barranco Pluma Polvorienta. Encuentra los devastadores y mátalos hasta que recuperes la talega desaparecida de la peregrina.‡Le Pèlerin elfe de sang blessé a été attaqué par des Ravageurs Plumecroc alors qu\'il se trouvait dans le ravin de Plumepoussière. Trouvez son campement et fouillez-le à la recherche de son sac manquant.‡受伤的血精灵朝圣者在尘羽峡谷宿营时遭到了钢牙掠食者的袭击。前往那处营地寻找丢失的背包。‡那個受傷的血精靈朝聖者在塵羽峽谷紮營時遭到惡毒的劫毀者攻擊。找到她的營地並尋找朝聖者丟失的背包。',
  }
},
[9378] = {
  {
    'DND FLAG The Dread Citadel - Naxxramas‡DND FLAG Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡DND FLAG La ciudadela del terror: Naxxramas‡DND FLAG La ciudadela del terror: Naxxramas‡DND FLAG Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡',
    nil,
    'Archmage Angela Dosantos at Light\'s Hope Chapel in the Eastern Plaguelands will grant you Arcane Cloaking at no cost. You must be Exalted with the Argent Dawn.‡Верховный маг Анжела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова бесплатно наложить на вас заклинание чародейского покрова. Вы должны заслужить полное доверие Серебряного Рассвета.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird Euch die arkane Tarnung kostenfrei gewähren. Euer Ruf bei der Argentumdämmerung muss ehrfürchtig sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 비전 은신 마법으로 낙스라마스로 들어갈 수 있도록 해 줄 것입니다. 은빛 여명회의 평판이 확고한 동맹이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous accordera gratuitement l\'Occultation arcanique. Vous devez être <Exalté/Exaltée> auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安吉拉·杜萨图斯会免费为你施放奥术遮罩的咒语。你在银色黎明中的声望必须达到崇拜。‡',
  }
},
[9380] = {
  {
    'No mato sem cachorro‡В погоне за большим‡Die Hatz nach mehr‡박물관 전시물‡A seguir cazando canes‡‡La multiplication des molosses‡群居的猎犬‡供不應求',
    nil,
    'Pegue 6 Cadáveres Intactos de Cão Dimensional e traga tudo de volta para o Prospector Murantus na Fortaleza da Honra.‡Соберите 6 неповрежденных трупов астральных гончих и доставьте в Оплот Чести геологу Мурантусу.‡Beschafft 6 unversehrte Sphärenhundkadaver und bringt sie zu Ausgrabungsleiter Murantus in der Ehrenfeste.‡손상되지 않은 황천의 사냥개 시체 6개를 모은 후 명예의 요새에 있는 발굴조사단장 무란투스에게 가져가야 합니다.‡Reúne 6 cadáveres de can distorsionado intactos y llévaselos al prospector Murantus en el Bastión del Honor.‡Reúne 6 cadáveres de can distorsionado intactos y llévaselos al prospector Murantus en el Bastión del Honor.‡Récupérer 6 Cadavres de molosses dimensionnels intacts et les remettre au prospecteur Murantus au bastion de l\'Honneur.‡将6只完整的迁跃猎犬尸体交给荣耀堡的勘探员穆拉图斯。‡收集6個完整的地獄獵犬屍體並帶給榮譽堡的勘察員穆蘭特斯。',
  }
},
[9381] = {
  {
    'Flechas voo-certo‡Стрелы, бьющие без промаха‡Treffsichere Pfeile‡명궁의 화살‡Esas flechas sí que vuelan‡Esas flechas sí que vuelan‡Les flèches infaillibles‡箭矢之羽‡真禽之箭',
    nil,
    'Colete 8 Penas da Cauda de Limpa-ossos e leve-as para Falcoeira Drena Fluminéola na Vigília do Falcão.‡Принесите 8 хвостовых перьев стервятника-костеклюя сокольничему Дренне Речной Ветер в Соколиный дозор.‡Sammelt 8 Schwanzfedern eines Knochenhäuters von den Knochenhäutergeiern und bringt sie Falknerin Drenna Flusswind in der Falkenwacht.‡뼈갈이식인독수리로부터 뼈갈이식인독수리 꼬리 깃털 8개를 모은 후 매의 감시탑에 있는 매부리 드렌나 리버윈드에게 가져가야 합니다.‡Recolecta 8 plumas de cola de limpiahuesos de buitres limpiahuesos y llévaselos a la halconera Drenna Ríobrisa Avanzada del Halcón.‡Recolecta 8 plumas de cola de limpiahuesos de buitres limpiahuesos y llévaselos a la halconera Drenna Ríobrisa Avanzada del Halcón.‡Récupérez 8 Plumes de queue de gratte-les-os sur des vautours Gratte-les-os, et remettez-les au fauconnier Drenna Ruissevent du Guet de l\'épervier.‡从啄骨秃鹫身上收集8片啄骨秃鹰的尾羽，把它们交给猎鹰岗哨的驯鹰者德蕾娜·河风。‡從剃骨禿鷹身上收集8根剃骨尾羽，交給獵鷹哨站的獵鷹者崔娜·河風。',
  }
},
[9382] = {
  {
    'The Fate of the Clefthoof‡Жестокий рок копытня‡Das Schicksal der Grollhufe‡‡El sino de los uñagrietas‡‡Le sort des sabots-fourchus‡‡',
    nil,
    'Kill 15 Bristlehide Clefthoof and return to Amaan the Wise at the Temple of Telhamat.‡Убейте 15 щетинистых копытней и возвращайтесь к Амаану Мудрейшему в Храм Телхамата.‡Tötet 15 borstige Grollhufe und kehrt dann zu Amaan dem Weisen im Tempel von Telhamat zurück.‡‡Mata a 15 uñagrietas lomohirsutos y regresa junto a Amaan el Sabio en el Templo de Telhamat.‡Mata a 15 uñagrietas lomohirsutos y regresa junto a Amaan el Sabio en el Templo de Telhamat.‡Tuer 15 Sabots-fourchus poil-hirsute, puis retourner voir Amaan le sage au temple de Telhamat.‡‡',
  }
},
[9383] = {
  {
    'Um plano ambicioso‡Честолюбивый план‡Ein gewagter Plan‡야심찬 계획‡Un plan ambicioso‡Un plan ambicioso‡Un plan ambitieux‡艰巨的计划‡野心勃勃的計劃',
    nil,
    'Use o Cristal Santificado em um Emissário do Caos Descontrolado e apresente-se a Elsaana no Templo de Telhamat.‡Используйте освященный кристалл против раненого неконтролируемого демона Бездны, затем возвращайтесь к Элсаане в храм Телхамат.‡Wendet den geweihten Kristall auf einen verwundeten unkontrollierten Leerwandler an. Kehrt anschließend zu Elsaana beim Tempel von Telhamat zurück.‡구속이 풀린 보이드워커에게 정화의 수정을 사용한 후, 텔하마트 사원에 있는 엘사아나에게 돌아가야 합니다.‡Usa el cristal santificado contra un abisario sin control herido y ve a ver a Elsaana al Templo de Telhamat.‡Usa el cristal santificado contra un abisario sin control herido y ve a ver a Elsaana al Templo de Telhamat.‡Utilisez le Cristal sanctifié sur un marcheur du Vide incontrôlé blessé, puis retournez voir Elsaana au temple de Telhamat.‡在失控的虚空行者受伤之后对其使用净化水晶，然后返回塔哈玛特神殿向艾尔萨娜复命。‡對已受傷且無法控制的虛無行者使用神化水晶再回到特爾哈曼神廟找伊莎安娜。',
  }
},
[9385] = {
  {
    'Assoladores assaltantes‡Разъяренные Опустошители‡Tobende Felshetzer‡광포한 갈퀴발톱‡Devastadores descontrolados‡Devastadores descontrolados‡Les ravageurs déchaînés‡钢牙掠食者‡消滅劫毀者',
    nil,
    'Mate 10 Assoladores Presicerdos e fale novamente com Gremni Barbalonga na Península Fogo do Inferno.‡Убейте 10 перозубых опустошителей и возвращайтесь к Гремни Длиннобороду на полуострове Адского Пламени.‡Tötet 10 Stachelklauenfelshetzer und kehrt anschließend zu Gremni Langbart auf der Höllenfeuerhalbinsel zurück.‡깃송곳니 갈퀴발톱 10마리를 처치한 다음 지옥불 반도에 있는 그렘니 롱비어드에게 돌아가야 합니다.‡Mata 10 devastadores jabacolmillo y ve a ver a Gremni Barbalarga a la Península del Fuego Infernal.‡Mata 10 devastadores jabacolmillo y ve a ver a Gremni Barbalarga a la Península del Fuego Infernal.‡Tuez 10 Ravageurs Plumecroc et retournez voir Gremni Barbe-longue dans la péninsule des Flammes infernales.‡杀死10只钢牙掠食者，然后向地狱火半岛的格雷尼·长须复命。‡殺死10個惡毒的劫毀者後回到地獄火半島找葛明尼·長鬚。',
  }
},
[9386] = {
  {
    'Uma luz na escuridão‡Свет в темных местах‡Licht im Dunkeln‡어둠을 밝히는 한 줄기 빛‡Una luz en la oscuridad‡Una luz en la oscuridad‡Une Lumière au sein des ombres‡黑暗中的光明‡暗處之光',
    nil,
    'Encontre e toque as fogueiras no Pico da Rocha Negra, no Gládio Cruel, em Scolomântia e em Stratholme. Em seguida, fale novamente com o Guardachamas do Festival.‡Найдите костры, размещенные в пике Черной горы, Забытом Городе, Некроситете и Стратхольме и коснитесь их; затем поговорите с хранителем праздничного пламени.‡Findet und berührt die Freudenfeuer innerhalb der Schwarzfelsspitze, dem Düsterbruch, Scholomance und Stratholme. Sprecht dann mit dem Flammenbewahrer.‡검은바위 첨탑, 혈투의 전장, 스칼로맨스, 스트라솔름에 있는 화톳불을 찾아서 만져 본 후, 한여름 축제 불꽃지기에게 돌아가야 합니다.‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme y ve a ver al guardián de la llama del Festival.‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme, y ve a ver al guardián de la llama del Festival.‡Trouvez et touchez les feux de joie situés au pic Rochenoire, à Hache-tripes, dans la Scholomance et à Stratholme, puis parlez au gardien des flammes de la fête.‡找到并碰触在黑石塔、厄运之槌、通灵学院和斯坦索姆内的火盆，并回到节日护火者处。‡找到並觸碰位在黑石塔，厄運之槌，通靈學院，和斯坦索姆的營火。',
  }
},
[9387] = {
  {
    'Fonte de corrupção‡Источник порчи‡Die Quelle der Verderbtheit‡오염의 원인‡El origen de la corrupción‡El origen de la corrupción‡La source de la corruption‡堕落之源‡腐敗根源',
    nil,
    'Vá às Ruínas de Sha\'naar, na Península Fogo do Inferno, e obtenha 5 Essências Demoníacas dos Capatazes Illidari. Fale novamente com o Boticário Azevedo na Vigília do Falcão quando completar a tarefa.‡Отправляйтесь в руины Ша\'наара на полуострове Адского Пламени и добудьте из иллидари-надсмотрщиков 5 демонических сущностей. После завершения задания возвращайтесь к аптекарю Азетену в Соколиный дозор.‡Reist zu den Ruinen von Sha\'naar auf der Höllenfeuerhalbinsel und besorgt 5 dämonische Essenzen von den Zuchtmeistern der Illidari. Kehrt zu Apotheker Azethen in der Falkenwacht zurück, wenn Ihr die Aufgabe erfüllt habt.‡지옥불 반도에 있는 샤나르 폐허로 가서 일리다리 감독관이 가지고 있는 악마의 정수 5개를 획득해야 합니다. 일을 마친 후 매의 감시탑에 있는 연금술사 아제센에게 돌아가십시오.‡Viaja a las Ruinas de Sha\'naar en la Península del Fuego Infernal y consigue 5 esencias demoníacas de los capataces illidari. Vuelve a ver al boticario Azethen a la Avanzada del Halcón cuando hayas completado la tarea.‡Viaja a las Ruinas de Sha\'naar en la Península del Fuego Infernal y consigue 5 esencias demoníacas de los capataces Illidari. Vuelve a ver al boticario Azethen a la Avanzada del Halcón cuando hayas completado la tarea.‡Allez aux ruines de Sha\'naar, dans la péninsule des Flammes infernales, et obtenez 5 Essences démoniaques sur les Sous-chefs illidari. Retournez voir l\'apothicaire Azethen au Guet de l\'épervier une fois ce travail terminé.‡前往地狱火半岛的沙纳尔废墟，从伊利达雷监工身上收集5个恶魔精华。完成任务后返回猎鹰岗哨，向药剂师艾瑟森复命。‡前往地獄火半島的夏納廢墟從伊利達瑞監工身上取得5個惡魔精華。完成任務後回到獵鷹哨站找藥劑師艾斯隆。',
  }
},
[9388] = {
  {
    'As chamas tremeluzentes de Kalimdor‡Мерцающие огни Калимдора‡Lodernde Flammen in Kalimdor‡칼림도어의 희미한 불꽃‡La oscilación de las llamas de Kalimdor‡La oscilación de las llamas de Kalimdor‡Flammes vacillantes en Kalimdor‡卡利姆多的火焰‡卡林多的閃爍火焰',
    nil,
    'Visite as fogueiras no Vale Gris, nos Sertões, na Costa Negra e na Cordilheira das Torres de Pedra. Em seguida, fale com o Guardachamas do Festival.‡Посетите праздничные костры в Ясеневом лесу, Степях, на Темном Берегу и в Когтистых горах, затем поговорите с хранителем праздничного пламени.‡Sucht die Freudenfeuer im Eschental, dem Brachland, der Dunkelküste und dem Steinkrallengebirge auf. Sprecht anschließend mit dem Flammenbewahrer.‡잿빛 골짜기, 불모의 땅, 어둠의 해안, 돌발톱 산맥에 불꽃이 있는 장소를 방문한 다음 한여름 축제 불꽃지기를 찾아가 대화하십시오.‡Toca las hogueras de Vallefresno, Los Baldíos, Costa Oscura y Sierra Espolón y ve a ver al guardián de la llama del Festival.‡Toca las hogueras de Vallefresno, Los Baldíos, Costa Oscura y Sierra Espolón y ve a ver al guardián de la llama del Festival.‡Rendez-vous aux feux de joie d\'Orneval, des Tarides, de Sombrivage et des Serres-Rocheuses, puis parlez au Gardien des flammes de la fête.‡造访灰谷、贫瘠之地、黑海岸和石爪山的篝火堆，然后回来与节日护火者交谈。‡探勘梣谷，貧瘠之地，黑海岸，和石爪山脈的營火，再和節慶火焰管理者談談。',
  }
},
[9389] = {
  {
    'As chamas tremeluzentes dos Reinos do Leste‡Мерцающие огни Восточных королевств‡Lodernde Flammen in den östlichen Königreichen‡동부 왕국의 가물거리는 불꽃‡La oscilación de las llamas de los Reinos del Este‡La oscilación de las llamas de los Reinos del Este‡Flammes vacillantes dans les Royaumes de l\'est‡东部王国的火焰‡東部王國的閃爍火焰',
    nil,
    'Visite as fogueiras no Contraforte de Eira dos Montes, na Floresta de Pinhaprata, em Cerro Oeste e no Pantanal. Em seguida, fale com o Guardachamas do Festival.‡Посетите праздничные костры в предгорьях Хиллсбрада, в Серебряном бору, Западном Крае и Болотине, затем поговорите с хранителем праздничного пламени.‡Sucht die Freudenfeuer im Vorgebirge des Hügellands, im Silberwald, in Westfall und dem Sumpfland auf. Sprecht anschließend mit dem Flammenbewahrer.‡힐스브래드 구릉지와 은빛소나무 숲, 서부 몰락지대와 저습지 내에 있는 화톳불을 찾은 후, 한여름 축제 불꽃지기와 대화해야 합니다.‡Toca las hogueras de Laderas de Trabalomas, Bosque de Argénteos, Páramos de Poniente y Los Humedales y ve a ver al guardián de la llama del Festival.‡Ve a las hogueras de las Laderas de Trabalomas, el Bosque de Argénteos, los Páramos de Poniente y Los Humedales y habla con el guardián de la llama del Festival.‡Rendez-vous aux feux de joie des contreforts de Hautebrande, de la forêt des Pins argentés, de la Marche de l\'ouest et des Paluns, puis parlez au Gardien des flammes de la fête.‡造访希尔斯布莱德丘陵、银松森林、西部荒野和湿地的篝火堆，然后回来与节日护火者交谈。‡探勘希爾斯布萊德丘陵，銀松森林，西部荒野，和濕地的營火，再和節慶火焰管理者談談。',
  }
},
[9390] = {
  {
    'À procura de Sedai‡Найти Седаи‡Die Suche nach Sedai‡세다이 찾기‡En busca de Sedai‡En busca de Sedai‡À la recherche de Sedaï‡寻找瑟丹‡尋找希戴',
    nil,
    'O Anacoreta Obaden quer que você procure pelo irmão dele, Sedai, a leste daqui, na Península Fogo do Inferno.‡Разыщите Седаи, брата анахорета Обадия. Седаи может находиться где-то поблизости, на востоке, на полуострове Адского Пламени.‡Anachoret Obadei möchte, dass Ihr östlich von hier auf der Höllenfeuerhalbinsel nach seinem Bruder Sedai Ausschau haltet.‡수도사 오베다이가 지옥불 반도의 동쪽 근처 어딘가에 있는 자신의 형제 세다이를 찾아 달라고 부탁했습니다.‡El anacoreta Obadei quiere que busques a su hermano, Sedai, al este de la Península del Fuego Infernal.‡El anacoreta Obadei quiere que busques a su hermano, Sedai, al este de la Península del Fuego Infernal.‡L\'anachorète Obadeï veut que vous partiez à la recherche de son frère Sedaï dans les alentours, vers l\'est, dans la péninsule des Flammes infernales.‡学者欧巴迪要你去塔哈玛特神殿东边附近的区域寻找他的兄弟瑟丹。‡隱士歐拜德要你去尋找他的兄弟，希戴，就在地獄火半島的東邊。',
  }
},
[9391] = {
  {
    'Marcando o caminho‡Осветить путь‡Den Weg kennzeichnen‡순례자들을 위한 길‡Iluminar el camino‡Iluminar el camino‡Jalonner le chemin‡点燃灯塔‡記下路徑',
    nil,
    'O Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, quer que você vá à Grande Fenda, na Península Fogo do Inferno, e acenda os Sinalizadores Sul, Oeste e Central. Traga a tocha acesa para ele ao completar a tarefa.‡Отправляйтесь к Глубокому разлому на полуострове Адского Пламени и зажгите южный маяк, западный маяк и центральный маяк. После выполнения задания возвращайтесь к капитану следопытов Венн\'рену из Соколиного дозора вместе с зажженным факелом.‡Waldläuferhauptmann Venn\'ren an der Falkenwacht möchte, dass Ihr auf der Höllenfeuerhalbinsel die große Kluft aufsucht und dort das südliche Leuchtsignal, westliche Leuchtsignal und das zentrale Leuchtsignal entzündet. Kehrt anschließend mit der brennenden Fackel zu ihm zurück.‡매의 감시탑에 있는 순찰대장 벤렌이 지옥불 반도에 있는 거대한 균열로 가서 남쪽 봉화, 서쪽 봉화, 중앙 봉화에 불을 붙여 달라고 했습니다. 일을 마친 후 불붙인 횃불을 가지고 순찰대장 벤렌에게 가야 합니다.‡El capitán forestal Venn\'ren de la Avanzada del Halcón quiere que vayas a La Gran Fisura en la Península del Fuego Infernal y enciendas la Baliza del Sur, la Baliza Occidental y la Baliza Central. Vuelve junto a él con la antorcha encendida después de completar esta tarea.‡El capitán forestal Venn\'ren de la Avanzada del Halcón quiere que vayas a La Gran Fisura en la Península del Fuego Infernal y enciendas la Baliza del Sur, la Baliza Occidental y la Baliza Central. Vuelve junto a él con la antorcha encendida después de completar esta tarea.‡Le capitaine des forestiers Venn’ren, du Guet de l’épervier, veut que vous alliez dans la Grande fissure de la péninsule des Flammes infernales et que vous allumiez la Balise du sud, la Balise de l’ouest, et la Balise centrale. Retournez le voir avec la Torche allumée quand vous aurez accompli cette tâche.‡前往地狱火半岛的大裂隙，点燃南部灯塔、西部灯塔和中部灯塔。完成任务后返回猎鹰岗哨，将燃烧的火炬还给游侠队长维恩雷。‡獵鷹哨站的遊俠隊長范瑞要你前往地獄火半島的大裂縫點燃南方烽火臺、西方烽火臺和中央烽火臺。完成任務後帶著點燃的火炬回去找他。',
  }
},
[9392] = {
  {
    'Treinamento de ladino‡Обучение разбойника‡Ausbildung zum Schurken‡도적 훈련‡Entrenamiento de pícaros‡Entrenamiento de pícaros‡La formation de voleur‡潜行者训练‡盜賊訓練',
    nil,
    'Fale com o instrutor de ladinos Tocaiante Kariel na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставником разбойников следопытом Кариэлем в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Pfadpirscher Kariel - dem Schurkenlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 도적 추적자 카리엘과 대화해야 합니다.‡Habla con el acechacaminos Kariel, el instructor de pícaros, en la Aguja del Sol en la Isla del Caminante del Sol.‡Habla con el acechacaminos Kariel, el instructor de pícaros, en la Aguja del Sol en la Isla del Caminante del Sol.‡Parlez à l\'éclaireur Kariel, le maître des voleurs, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的寻路者卡雷尔谈一谈。‡和巡路者凱瑞爾 - 盜賊訓練師談談，他就在逐日者之島的日尖塔裡面。',
  }
},
[9393] = {
  {
    'Treinamento de caçador‡Обучение охотника‡Ausbildung zum Jäger‡사냥꾼 훈련‡Instrucción de cazador‡Instrucción de cazador‡La formation de chasseur‡猎人训练‡獵人訓練',
    nil,
    'Fale com a instrutora de caçadores Patrulheira Sallina na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с следопытом Саллиной в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Waldläuferin Sallina - der Jägerlehrerin - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 사냥꾼 순찰자 살리나와 대화해야 합니다.‡Habla con la forestal Sallina, la instructora de clase de cazadores, en La Aguja del Sol en la Isla del Caminante del Sol.‡Habla con la forestal Sallina, la instructora de clase de cazadores, en La Aguja del Sol en la Isla del Caminante del Sol.‡Parlez au forestier Sallina, le maître des chasseurs, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的猎人训练师游侠萨琳娜谈一谈。‡和遊俠薩琳娜 - 獵人訓練師談談，她就在逐日者之島的日尖塔裡面。',
  }
},
[9394] = {
  {
    'Onde está Wyllithen?‡Куда подевался Виллитен?‡Wo ist Wyllithen?‡빌리덴을 찾아라‡¿Dónde está Wyllithen?‡¿Dónde está Wyllithen?‡Où est Wyllithen ?‡维林森去哪了？‡威利坦在哪裡?',
    nil,
    'Encontre o Jardineiro Wyllithen nas Terras do Ocaso, que ficam na Floresta do Canto Eterno.‡Найдите смотрителя Виллитена в землях Блеклых Сумерек, что в лесах Вечной Песни.‡Findet Grundbewahrer Wyllithen beim Nachtschimmergrund im Immersangwald.‡영원노래 숲의 더스크위더 정원에 있는 관리인 빌리덴을 찾아야 합니다.‡Encuentra al encargado Wyllithen en las Tierras Ocaso Marchito, en el Bosque Canción Eterna.‡Encuentra al guardés Wyllithen en las Tierras Ocaso Marchito, en el Bosque Canción Eterna.‡Retrouver le paysagiste Wyllithen sur les Terres de Ternesoir dans le bois des Chants éternels.‡前往永歌森林的达斯维瑟广场寻找看守者维林森。‡到永歌森林的暗木營地尋找地面守衛者威利坦。',
  }
},
[9395] = {
  {
    'O Refúgio de Saltheril‡Вилла Салтерила‡Saltherils Hafen‡살데릴의 안식처‡El Refugio de Saltheril‡El Refugio de Saltheril‡Le havre de Saltheril‡萨瑟利尔庄园‡薩瑟里的避風港',
    nil,
    'Fale com o Lorde Saltheril no Refúgio de Saltheril, que fica na Floresta do Canto Eterno.‡Поговорите с лордом Салтерилом на вилле Салтерила в лесах Вечной Песни.‡Sprecht mit Lord Saltheril in Saltherils Hafen im Immersangwald.‡영원노래 숲의 살데릴의 안식처에 있는 살데릴 경과 대화하십시오.‡Ve a Refugio de Saltheril en el Bosque Canción Eterna y habla con Lord Saltheril.‡Ve a Refugio de Saltheril en el Bosque Canción Eterna y habla con Lord Saltheril.‡Parler au seigneur Saltheril au havre de Saltheril dans le bois des Chants éternels.‡与永歌森林萨瑟利尔庄园的萨瑟利尔男爵谈一谈。‡到永歌森林和薩瑟里的避風港的薩瑟里領主談談。',
  }
},
[9396] = {
  {
    'A magia dos arakkoas‡Магия араккоа‡Die Magie der Arakkoa‡아라코아의 마법‡La magia de los arakkoas‡La magia de los arakkoa‡La magie des arakkoa‡鸦人的魔法‡阿拉卡的魔法',
    nil,
    'Traga 4 Pergaminhos dos Haal\'eshi para o Arcanista Calesthris Aurestela, na Vigília do Falcão, que fica na Península Fogo do Inferno.‡Принесите 4 свитка племени Хаал\'эш чародею Калестрису Утренней Звезде в Соколиный дозор на полуострове Адского Пламени.‡Bringt 4 Rollen der Haal\'eshi zu Arkanist Calesthris Morgenstern bei der Falkenwacht auf der Höllenfeuerhalbinsel.‡지옥불 반도의 매의 감시탑에 있는 비전술사 케일스트리스 돈스타에게 하알레쉬 두루마리 4개를 가져가야 합니다.‡Ve a la Avanzada del Halcón, en la Península del Fuego Infernal, y llévale 4 pergaminos Haal\'eshi al arcanista Calesthris Estrella del Alba.‡Ve a la Avanzada del Halcón, en la Península del Fuego Infernal, y llévale 4 pergaminos Haal\'eshi al arcanista Calesthris Estrella del Alba.‡L\'arcaniste Calesthris Aubétoile, du Guet de l\'épervier de la péninsule des Flammes infernales, veut que vous lui rameniez 4 Parchemins haal\'eshi.‡将4个哈尔什卷轴交给地狱火半岛猎鹰岗哨的奥术师卡雷希斯·晨星。‡帶回4個海艾斯卷軸到地獄火半島給獵鷹哨站的秘法師卡拉崔斯·晨星。',
  }
},
[9397] = {
  {
    'Pássaro na mão‡Пух и перья‡Kommt ein Vogel geflogen‡유유상종‡En compañía de pájaros‡En compañía de pájaros‡Fermez, fermez la cage aux oiseaux‡捉小鸟‡稀有的鳥類',
    nil,
    'Vá ao Antro de Haal\'esh, na Península Fogo do Inferno, e encontre um Filhote de Kaliri Fêmea nos Ninhos de Kaliri. Use a Gaiola Vazia para capturá-lo e leve-o para a Falcoeira Drena Fluminéola, na Vigília do Falcão.‡Отправляйтесь в логово Хаал\'эш на полуострове Адского Пламени и найдите молодую самку калири в гнезде калири. Посадите птенца в пустую клетку и принесите сокольничему Дренне Речной Ветер в Соколиный дозор.‡Reist zum Haal\'eshbau auf der Höllenfeuerhalbinsel und durchsucht die Kalirinester nach einem jungen Kaliriweibchen. Benutzt den leeren Vogelkäfig, um es zu fangen, und kehrt anschließend zu Falknerin Drenna Flusswind in der Falkenwacht zurück.‡지옥불 반도에 있는 하알레쉬 소굴로 가서 칼리리 둥지를 뒤져 새끼 칼리리 암컷을 찾아야 합니다. 매의 감시탑에 있는 매부리 드렌나 리버윈드에게 빈 새장으로 암컷을 잡아 돌아가야 합니다.‡Ve a El Cubil de Haal\'esh en la Península del Fuego Infernal y busca en los nidos de kaliri una cría de kaliri hembra. Usa la jaula de pájaros vacía para capturarla y llévasela a la halconera Drenna Ríobrisa en la Avanzada del Halcón.‡Ve a El Cubil de Haal\'esh en la Península del Fuego Infernal y busca en los nidos de kaliri una cría de kaliri hembra. Usa la jaula de pájaros vacía para capturarla y llévasela a la halconera Drenna Ríobrisa en la Avanzada del Halcón.‡Rendez-vous à la tanière des Haal\'esh dans la péninsule des Flammes infernales et fouillez les nids de kaliris à la recherche d\'une Jeune femelle kaliri. Utilisez la Cage à oiseaux vide pour la capturer et apportez-la au fauconnier Drenna Ruissevent au Guet de l\'épervier.‡前往地狱火半岛的哈尔什巢穴，在卡利鸟巢穴中寻找雌性小卡利鸟。利用空鸟笼捕获雌性小卡利鸟，将其交给猎鹰岗哨的驯鹰者德蕾娜·河风。‡前往地獄火半島的海艾斯洞穴捕捉一隻母卡里瑞幼鳥。用這個空的鳥籠捉住她，完成這個任務後再回去找獵鷹者崔娜·河風。',
  }
},
[9398] = {
  {
    'Predadores mortais‡Смертельно опасные хищники‡Tödliche Raubtiere‡치명적인 약탈자들‡Depredadores letales‡Depredadores letales‡Prédateurs mortels‡致命的猎手‡痛恨的掠奪者',
    nil,
    'A Batedora Vanura, no Templo de Telhamat, que fica na Península Fogo do Inferno, quer que você mate 8 Filhotes Rasgálitas e 4 Rasgálitas Alfa.‡Убейте 8 детенышей камнеруба и 4 камнерубов-вожаков по просьбе разведчицы Вануры из храма Телхамат на полуострове Адского Пламени.‡Späher Vanura im Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr 8 Steinsichelwelpen und 4 Steinsichelalpha tötet.‡지옥불 반도의 텔하마트 사원에 있는 정찰병 바누라가 새끼 돌낫 바위갈퀴 8마리, 덩치큰 돌낫 바위갈퀴 4마리를 처치해 달라고 부탁했습니다.‡La exploradora Vanura del Templo de Telhamat en la Península del Fuego Infernal quiere que mates 8 crías de guadaña de piedra y 4 alfas guadaña de piedra.‡La exploradora Vanura del Templo de Telhamat en la Península del Fuego Infernal quiere que mates 8 crías de guadaña de piedra y 4 alfas guadaña de piedra.‡L\'éclaireur Vanura du temple de Telhamat dans la péninsule des Flammes infernales veut que vous tuiez 8 Jeunes fauchepierre et 4 Alphas fauchepierre.‡地狱火半岛塔哈玛特神殿的斥候瓦努拉要你杀死8只石镰幼崽和4只石镰突击者。‡地獄火半島特爾哈曼神廟的斥候范路娜要你去殺死8個小石鐮掠奪者和4個石鐮突擊隊員。',
  }
},
[9399] = {
  {
    'Capatazes cruéis‡Безжалостные десятники‡Die Grausamkeit der Zuchtmeister‡잔인한 감독관‡Capataces crueles‡Capataces crueles‡De cruels sous-chefs‡残忍的监工‡殘酷的監工',
    nil,
    'Mate 4 Capatazes Illidari nas Ruínas de Sha\'naar e fale novamente com Ikan, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Убейте 4 иллидари-надсмотрщиков на руинах Ша\'наара и возвращайтесь к Икану в храм Телхамат на полуострове Адского Пламени.‡Reist zu den Ruinen von Sha\'naar und erschlagt 4 Zuchtmeister der Illidari. Kehrt anschließend zu Ikan zum Tempel von Telhamat auf der Höllenfeuerhalbinsel zurück.‡샤나르 폐허에 있는 일리다리 감독관 4명을 처치한 후, 지옥불 반도의 텔하마트 사원에 있는 이칸에게 돌아가야 합니다.‡Mata a 4 capataces de Illidari en las Ruinas de Sha\'naar y vuelve a ver a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Mata a 4 capataces de Illidari en las Ruinas de Sha\'naar y vuelve a ver a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Tuez 4 Sous-chefs illidari aux ruines de Sha\'naar, puis retournez voir Ikan au temple de Telhamat, dans la péninsule des Flammes infernales.‡前往沙纳尔废墟，杀死4名伊利达雷监工，然后向地狱火半岛塔哈玛特神殿的伊坎复命。‡到夏納廢墟殺死4名伊利達瑞監工，再回到地獄火半島的特爾哈曼神廟找依坎。',
  }
},
[9400] = {
  {
    'O assassino‡Убийца‡Der Assassine‡암살자 처치‡El asesino‡El asesino‡L\'assassin‡刺客‡刺客',
    nil,
    'Nazgrel quer que você viaje até a estrada ao norte da Cidadela Fogo do Inferno e encontre um assassino chamado Krun Quebra-espinhas.‡Ступайте по дороге к северу от цитадели Адского Пламени и разыщите убийцу по имени Крун Хребтолом по просьбе Назгрела.‡Nazgrel möchte, dass Ihr zu der Straße nördlich der Höllenfeuerzitadelle reist und nach einem Assassinen namens Krun Rückenbrecher Ausschau haltet.‡나즈그렐이 지옥불 성채의 북쪽 길로 가서 크룬 스파인브레이커라는 이름의 암살자를 찾아봐 달라고 했습니다.‡Nazgrel quiere que vayas por la carretera al norte de la Ciudadela del Fuego Infernal en busca de un asesino llamado Krun Rompeloma.‡Nazgrel quiere que vayas por la carretera al norte de la Ciudadela del Fuego Infernal en busca de un asesino llamado Krun Rompeloma.‡Nazgrel veut que vous suiviez la route qui passe au nord de la citadelle des Flammes infernales, à la recherche d\'un assassin nommé Krun Brise-échine.‡纳兹格雷尔要求你到地狱火堡垒北方的道路附近寻找一个名叫克伦·断脊者的刺客。‡納茲格雷爾要你前往地獄火堡壘北邊的道路尋找一個叫克魯恩·斷脊氏族的刺客。',
  }
},
[9401] = {
  {
    'Uma estranha arma‡Странное оружие‡Eine seltsame Waffe‡이상한 무기‡Un arma inusual‡Un arma inusual‡Une arme étrange‡奇怪的武器‡奇怪的武器',
    nil,
    'Leve o Machado Pesado de Pedra para Nazgrel em Thrallmar, na Península Fogo do Inferno.‡Принесите тяжелый каменный топор Назгрелу в Траллмар на полуострове Адского Пламени.‡Bringt die schwere Steinaxt zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 무거운 돌도끼를 가져가야 합니다.‡Lleva el hacha de piedra pesada a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Lleva el hacha de piedra pesada a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Remettre la Hache lourde en pierre à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将重型石斧交给萨尔玛的纳兹格雷尔。‡將沉重的石斧帶到地獄火半島的索爾瑪交給納茲格雷爾。',
  }
},
[9402] = {
  {
    'Pega!‡Апорт!‡Fangt!‡가져와!‡¡Tráeme una cosita!‡¡Tráeme una cosita!‡Va chercher !‡捞瓶子‡去吧!',
    nil,
    'Mergulhe na Lagoa do Eterno Sussurro e recupere o Frasco Lazúli para o Instrutor Antheol.‡Нырните на дно пруда Тихого Шелеста и добудьте лазурный фиал для инструктора Антеола.‡Taucht auf den Grund des Stillwispertümpels und holt die Azurphiole für Instrukteur Antheol.‡잔잔한 속삭임 연못 바닥으로 잠수해서 하늘색 유리병을 찾아 스승 안시올에게 돌아가십시오.‡Bucea hasta el fondo de la Charca Plácido Susurro y recupera la ampolla azur para el instructor Antheol.‡Bucea hasta el fondo de la Charca Plácido Susurro y recupera la ampolla azur para el instructor Antheol.‡Nagez jusqu\'au fond de l\'étang des Murmures-sereins et récupérez la Fiole azur pour l\'instructeur Antheol.‡在萦语水池底部为指导者安瑟隆找到碧蓝瓶。‡',
  }
},
[9403] = {
  {
    'A água mais pura‡Чистейшая вода‡Das reinste Wasser‡가장 순수한 물‡El agua más pura‡El agua más pura‡L\'eau pure‡最纯净的水‡純淨之水',
    nil,
    'O Instrutor Antheol quer que você encha o Frasco Lazúli na Cachoeira Elrendar.‡Наполните лазурный флакон водой из водопада Элрендар для Антеола.‡Instrukteur Antheol möchte, dass Ihr die Azurphiole bei den Elrendarfällen auffüllt.‡스승 안시올이 엘렌다르 폭포수로 하늘색 유리병을 채워달라고 부탁했습니다.‡El instructor Antheol quiere que llenes la ampolla azur en las Cascadas Elrendar.‡El instructor Antheol quiere que llenes la ampolla azur en las Cascadas Elrendar.‡[Instructor Antheol wants you to fill the Azure Phial at Elrendar Falls.]‡指导者安瑟隆希望你能在碧蓝瓶中装满艾伦达尔瀑布的水。‡導師安西歐要你去艾蘭達瀑布裝滿碧藍之瓶。',
  }
},
[9404] = {
  {
    'Recém-viventes‡Живая ветка‡Noch lebendig‡생명의 가지‡Recientemente vivo‡Recientemente vivo‡Fraîchement coupée‡活动的树木‡',
    nil,
    'Mate Jardineiros de Canto Eterno até conseguir um Galho Vivo para o Instrutor Antheol.‡Убивайте хранителей лесов Вечной Песни, пока не найдете животворную ветвь для инструктора Антеола.‡Tötet die Immersangwaldbehüter bis Ihr einen lebendigen Zweig für Instrukteur Antheol findet.‡스승 안시올에게 가져갈 생명의 가지를 얻을 때까지 영원노래 숲지기들을 해치워야 합니다.‡Mata a los jardineros Canción Eterna hasta que entreguen una rama viva para el instructor Antheol.‡Mata a los jardineros Canción Eterna hasta que entreguen una rama viva para el instructor Antheol.‡Tuez les Gardes verts des Chants éternels jusqu\'à ce que vous trouviez une Branche vivante pour l\'instructeur Antheol.‡清理永歌护卫者，直至你找到指导者安瑟隆所需要的生命绿枝。‡',
  }
},
[9405] = {
  {
    'O mandamento do Chefe Guerreiro‡Поручение Вождя‡Das Anliegen des Kriegshäuptlings‡대족장의 지령‡El mandato del jefe de guerra‡El mandato del Jefe de Guerra‡Le mandat du chef de guerre‡酋长的命令‡大酋長的命令',
    nil,
    'Leve o Machado Pesado de Pedra para a Clarividente Regulkut em Thrallmar, na Península Fogo do Inferno.‡Принесите тяжелый каменный топор провозвестнице Регулкут в Траллмар на полуострове Адского Пламени.‡Bringt die schwere Steinaxt zu Scharfseherin Regulkut in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 예언자 레굴쿠트에게 무거운 돌도끼를 가져가야 합니다.‡Lleva el hacha pesada de piedra al clarividente Regulkult a Thrallmar, en la Península del Fuego Infernal.‡Lleva el hacha pesada de piedra al clarividente Regulkult a Thrallmar, en la Península del Fuego Infernal.‡Apporter la Hache lourde en pierre à la prophétesse Regulkut, à Thrallmar dans la péninsule des Flammes infernales.‡将重型石斧交给萨尔玛的先知雷古库特。‡把沉重的石斧帶給在地獄火半島索爾瑪的先知瑞卡酷。',
  }
},
[9406] = {
  {
    'Os Mag\'har‡Маг\'хары‡Die Mag\'har‡마그하르‡Los Mag\'har‡Los Mag\'har‡Les Mag\'har‡玛格汉‡瑪格哈',
    nil,
    'Entregue a Carta dos Mag\'har para Nazgrel em Thrallmar, na Península Fogo do Inferno.‡Доставьте письмо маг\'харов Назгрелу в Траллмар на полуострове Адского Пламени.‡Bringt den Brief von den Mag\'har zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 마그하르로부터 온 편지를 전해야 합니다.‡Entrega la carta de los Mag\'har a Nazgrel en Thrallmar, en la Península del Fuego Infernal.‡Entrega la carta de los Mag\'har a Nazgrel en Thrallmar, en la Península del Fuego Infernal.‡Remettez la lettre des Mag’har à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将玛格汉的来信送给萨尔玛的纳兹格雷尔。‡將來自瑪格哈的信送回地獄火半島給索爾瑪的納茲格雷爾。',
  }
},
[9407] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡불타는 성전: 어둠의 문 너머로‡A través de El Portal Oscuro‡A través de El Portal Oscuro‡À travers la Porte des ténèbres‡跨越黑暗之门‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e encontre o Tenente-general Órion. Ele espera sua chegada do outro lado, em Terralém.‡Пройдите через Темный портал и найдите генерал-лейтенанта Ориона. Он ждет вашего прибытия на другой стороне, в Запределье.‡Reist durch das Dunkle Portal und meldet Euch bei Generalleutnant Orion. Er erwartet Euch auf der anderen Seite - in der Scherbenwelt.‡어둠의 문으로 들어가서 문 반대편의 아웃랜드에서 당신의 도착을 기다리고 있는 부사령관 오리온을 찾아야 합니다.‡Ve hasta El Portal Oscuro y encuentra al teniente general Orion. Te aguarda en el otro lado, en Terrallende.|n‡Ve hasta El Portal Oscuro y encuentra al teniente general Orion. Te aguarda en el otro lado, en Terrallende.|n‡Traversez la Porte des ténèbres et allez trouver le général de division Orion. Il attend votre arrivée de l\'autre côté, en Outreterre.‡穿越黑暗之门，找到沃雷恩中将。他就在黑暗之门另一侧的外域等你。‡傳過黑暗之門找到歐萊恩中將。他在另外一邊等著你的到達，就在外域裡。',
  }
},
[9408] = {
  {
    'Heróis esquecidos‡Забытые герои‡Vergessene Helden‡잊혀진 영웅들‡Héroes olvidados‡‡Héros oubliés‡被遗忘的英雄‡被遺忘的英雄',
    nil,
    'Fale com o Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Поговорите с командиром армии Данатом Троллебоем в Оплоте Чести.‡Sprecht mit Truppenkommandant Danath Trollbann in der Ehrenfeste.‡명예의 요새에서 전투사령관 다나스 트롤베인과 대화해야 합니다.‡Habla con el Comandante en Jefe Danath Aterratrols en el Bastión del Honor.‡Habla con el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Parler au commandant Danath Trollemort au bastion de l\'Honneur.‡与荣耀堡的远征军指挥官达纳斯·托尔贝恩谈一谈。‡和榮譽堡的軍隊指揮者達納斯·托爾貝恩談談。',
  }
},
[9409] = {
  {
    'Entrega urgente!‡Срочная доставка‡Eilige Lieferung!‡긴급 배달!‡Entrega urgente‡Entrega urgente‡Livraison urgente‡紧急物资！‡緊急送件!',
    nil,
    'Entregue o Conjunto de Ampolas a Zalduun no Ponto de Impacto, que fica no Vale Ammen.‡Отнесите сверток с фиалами Залдууну на место крушения в долине Аммен.‡Bringt die Phiolensammlung zu Zalduun bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 잘둔에게 유리병이 든 가방을 가져가야 합니다.‡Entrega el juego de viales a Zalduun en el Lugar del Accidente en el Valle Ammen.‡Entrega el juego de viales a Zalduun en el Lugar del Accidente en el Valle Ammen.‡Livrer le Paquet de fioles à Zalduun au Point d\'impact du val d\'Ammen.‡将一组药水瓶交给埃门谷坠毁点的扎尔杜。‡將一捆瓶子送到安曼谷給失事地點的薩度恩。',
  }
},
[9410] = {
  {
    'Um guia espiritual‡Хранитель душ‡Spirituelle Führung‡정령 길잡이‡Un espíritu guía‡Un espíritu guía‡Un guide spirituel‡灵魂的指引‡精神指引',
    nil,
    'Use o Totem do Lobo no local em que você encontrou o corpo de Krun Quebra-espinha e siga o Lobo Espiritual Ancestral.‡Установите тотем духа волка на том месте, где вы нашли тело Круна Хребтолома. Когда появится дух древнего волка, следуйте за ним.‡Verwendet das Wolfstotem an dem Ort, wo Ihr Krun Rückenbrechers Leichnam gefunden habt und folgt dem Ahnengeistwolf.‡크룬 스파인브레이커의 시체를 발견한 장소에서 토템을 사용한 후, 고대의 늑대 정령을 따라가야 합니다.‡Usa el Tótem de lobo en el lugar donde encontraste el cuerpo de Krun Rompeloma y sigue al espíritu de lobo ancestral.‡Usa el Tótem de lobo en el lugar donde encontraste el cuerpo de Krun Rompeloma y sigue al espíritu de lobo ancestral.‡Utilisez le Totem du loup à l\'endroit où vous avez trouvé le corps de Krun Brise-échine et suivez l\'Esprit ancestral du loup.‡在你找到克伦·断脊者尸体的地方使用先祖狼魂图腾，并跟随先祖狼魂前进。‡在你到找克魯恩·斷脊氏族屍體的地點使用狼圖騰，然後跟著先祖之狼圖騰的靈魂。',
  }
},
[9415] = {
  {
    'Apresente-se ao Marechal Murazul‡Маршал Синяя Синестен‡Meldung bei Marschall Himmelswand‡치안대장 블루월에게 보고‡Preséntate ante el alguacil Murazul‡Preséntate ante el alguacil Murazul‡Se présenter au maréchal Murbleu‡向布鲁沃尔元帅报告‡向治安官藍牆報告',
    nil,
    'Fale com Marechal Murazul no acampamento da Aliança, perto da Colme\'Zora.‡Поговорите с маршалом Синестеном в лагере Альянса возле Улья Зора.‡Sprecht mit Marschall Himmelswand beim Lager der Allianz in der Nähe des Zoraschwarmbaus.‡하이브조라 근처의 얼라이언스 야영지에 있는 치안대장 블루월과 대화해야 합니다.‡Habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Parlez au maréchal Murbleu au campement de l\'Alliance, près de la Ruche\'Zora.‡与佐拉虫巢附近联盟营地的布鲁沃尔元帅谈一谈。‡到佐拉蟲巢旁的聯盟營地和治安官藍牆談談。',
  }
},
[9416] = {
  {
    'Apresente-se à General Kyríala‡Генерал Кирика‡Meldung bei General Kirika‡사령관 키리카에게 보고‡Preséntate ante el general Kirika‡Preséntate ante el general Kirika‡Se présenter au général Kirika‡向吉里卡将军报到‡向奇立卡將軍報告',
    nil,
    'Fale com a General Kyríala no acampamento da Horda, perto da Colme\'Régia.‡Поговорите с генералом Кирикой в лагере Орды рядом с Ульем Регал.‡Sprecht mit General Kirika beim Lager der Horde in der Nähe des Regalschwarmbaus.‡하이브레갈 근처의 호드 야영지에 있는 사령관 키리카와 대화해야 합니다.‡Habla con el general Kirika en el campamento de la Horda cerca de Colmen\'Regal.‡Habla con el general Kirika en el campamento de la Horda cerca de Colmen\'Regal.‡Parlez au général Kirika au campement de la Horde, près de la Ruche\'Regal.‡与雷戈虫巢附近部落营地的吉里卡将军谈一谈。‡到雷戈蟲巢旁的部落營地和奇立卡將軍談談。',
  }
},
[9417] = {
  {
    'A ameaça dos arakkoas‡Угроза Араккоа‡Die Arakkoabedrohung‡아라코아의 위협‡La amenaza arakkoa‡La amenaza arakkoa‡La menace des arakkoa‡鸦人的威胁‡阿拉卡的威脅',
    nil,
    'Gremni Barbalonga, na Península Fogo do Inferno, quer que você mate 4 Andaventos Haal\'eshi e 6 Garraguardas Haal\'eshi.‡Убейте 4 ветроступов и 6 коготарей из племени Хаал\'эш по просьбе Гремни Длинноборода с полустрова Адского Пламени.‡Gremni Langbart auf der Höllenfeuerhalbinsel möchte, dass Ihr 4 Windspäher der Haal\'eshi und 6 Krallenwachen der Haal\'eshi tötet.‡지옥불 반도에 있는 그렘니 롱비어드가 하알레쉬 바람술사 4마리, 하알레쉬 갈퀴수호병 6마리를 처치해 달라고 부탁했습니다.‡Gremni Barbalarga de la Península del Fuego Infernal quiere que mates a 4 surcadores del viento y 6 garraguardas Haal\'eshi.‡Gremni Barbalarga de la Península del Fuego Infernal quiere que mates a 4 surcadores del viento y 6 garraguardas Haal\'eshi.‡Gremni Barbe-longue veut que vous tuiez 4 Marche-vent haal\'eshi et 6 Gardes-serres haal\'eshi.‡地狱火半岛的格雷尼·长须要你杀死4名哈尔什风行者和6名哈尔什利爪卫兵。‡地獄火半島的葛明尼·長鬚要你殺死4個海艾斯風行者和6個海艾斯猛爪護衛。',
  }
},
[9418] = {
  {
    'Orbe de Avuo‡Сфера Авруу‡Avruus Kugel‡아브루의 구슬‡El orbe de Avruu‡El orbe de Avruu‡L\'orbe d\'Avruu‡亚维鲁的宝珠‡艾芙魯的寶珠',
    nil,
    'Leve o Orbe de Avuo para o Altar Haal\'eshi, a sudeste do Antro de Haal\'esh, que fica na Península Fogo do Inferno, e entregue o orbe a Aeranas quando ele se libertar.‡Отнесите сферу Авруу на алтарь племени Хаал\'эш, который находится на юго-востоке от логова Хаал\'эш на полуострове Адского Пламени. После того как Аэранас обретет свободу, отдайте ему сферу.‡Bringt Avruus Kugel zum Altar der Haal\'eshi südöstlich des Haal\'eshbaus auf der Höllenfeuerhalbinsel und gebt sie Aeranas, sobald er frei ist.‡지옥불 반도의 하알레쉬 소굴의 남동쪽에 있는 하알레쉬 제단으로 아브루의 구슬을 가지고 간 다음 아에라나스가 풀려나면 그에게 건네주어야 합니다.‡Lleva el orbe de Avruu al altar Haal\'eshi al sureste de El Cubil de Haal\'esh en la Península del Fuego Infernal y dáselo a Aeranas cuando quede libre.‡Lleva el orbe de Avruu al altar Haal\'eshi al sureste de El Cubil de Haal\'esh en la Península del Fuego Infernal y dáselo a Aeranas cuando quede libre.‡Apportez l\'Orbe d\'Avruu à l\'Autel haal\'eshi, au sud-est de la tanière des Haal\'esh, sur la péninsule des Flammes infernales. Remettez-le à Aeranas lorsqu\'il sera libre.‡前往地狱火半岛哈尔什巢穴东南方的哈尔什祭坛，将亚维鲁的宝珠交给重获自由的埃拉纳斯。‡把艾芙魯的寶珠帶回地獄火半島，到海艾斯洞穴東南方的海艾斯祭壇，一旦艾羅那斯重獲自由就把寶珠交給他。',
  }
},
[9419] = {
  {
    'Limpeza do deserto‡Истощение пустыни‡Durchkämmen der Wüste‡사막 탐색‡Peinando el desierto‡Peinando el desierto‡Passer le désert au peigne fin‡横扫沙漠‡穿過沙漠',
    nil,
    'Encontre e leve a Silitista até o Extrator de Silitista, então fale com o Marechal Murazul no acampamento da Aliança perto da Colme\'Zora.‡Найдите и принесите силитист к экстрактору силитистов и поговорите с маршалом Синестеном в лагере Альянса возле Улья Зора.‡Findet Silithyst, bringt es zum Silithystextraktor und sprecht anschließend mit Marschall Himmelswand beim Lager der Allianz in der Nähe des Zoraschwarmbaus.‡실리시스트를 찾아서 실리시스트 추출기로 가져간 후, 하이브조라 근처 얼라이언스 주둔지에 있는 치안대장 블루월과 대화해야 합니다.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el alguacil Murazul en el campamento de la Alianza cerca de Colmen\'Zora.‡Trouver de la Silithyste et la livrer à l\' Extracteur de silithyste, puis parler au maréchal Murbleu au campement de l\'Alliance près de la Ruche\'Zora.‡找到一份水晶尘，将其送到水晶尘萃取器那里，然后向佐拉虫巢外联盟营地的布鲁沃尔元帅复命。‡找到並將希利塞斯紅塵送到希利塞斯提取器那裡，再到佐拉蟲巢附近的聯盟營地和治安官藍牆談談。',
  }
},
[9420] = {
  {
    'As melhores plumas‡Прекрасное оперение‡Feinste Daunen‡질 좋은 깃털‡Las plumas más finas‡Las plumas más finas‡Les plus belles plumes‡绝世好帽‡完美的羽毛',
    nil,
    'Mirren Barbalonga, na Península Fogo do Inferno, quer que você colete 8 Penas de Kaliri dos pássaros que vivem no Antro de Haal\'esh.‡Принесите Миррену Длиннобороду на полуострове Адского Пламени 8 перьев калири от различных калири из логова Хаал\'эш.‡Mirren Langbart auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 8 Kalirifedern von den Kaliris im Haal\'eshbau bringt.‡지옥불 반도에 있는 미렌 롱비어드가 하알레쉬 소굴에 있는 여러 종의 칼리리에게서 칼리리 깃털 8개를 가져다 달라고 부탁했습니다.‡Mirren Barbalarga de la Península del Fuego Infernal quiere que le lleves 8 plumas de kaliri de El Cubil de Haal\'esh.‡Mirren Barbalarga de la Península del Fuego Infernal quiere que le lleves 8 plumas de kaliri de El Cubil de Haal\'esh.‡Mirren Barbe-longue, de la péninsule des Flammes infernales, veut que vous lui rapportiez 8 Plumes de kaliri, prises sur les kaliris de la Tanière des Haal\'esh.‡前往哈尔什巢穴，从各种卡利鸟身上收集8片卡利鸟的羽毛，将它们交给地狱火半岛的米伦·长须。‡地獄火半島的麥倫·長鬚要你從海艾斯洞穴不同種類的卡里瑞身上弄到8根卡里瑞羽毛。',
  }
},
[9421] = {
  {
    'Treinamento de xamã‡Обучение шамана‡Ausbildung zum Schamanen‡주술사 훈련‡Entrenamiento de chamán‡Entrenamiento de chamán‡La formation de chaman‡萨满祭司训练‡薩滿訓練',
    nil,
    '‡Я Фирманваар. Ты не зря пришел ко мне. Мое призвание - учить молодых шаманов, особенно тех, что лишь теперь ступают на этот путь.nnДренеи заново открывают для себя шаманизм, Шамакс. Избрание не самого накатанного пути требует особого мужества.nnЯ с радостью помогу тебе, как только ты сочтешь, что пришло время снова поучиться.‡Ich bin Firmanvaar und mich aufzusuchen war weise von Euch. Ich bin dazu berufen, Schamanen den richtigen Weg zu weisen, besonders denen, die wie Ihr noch unerfahren sind.nnDer Schamanismus wird von uns <Volk> gerade erst wiederentdeckt, <Name>. Ihr seid wahrhaft mutig, dieser Lehre zu folgen, denn unter Unseresgleichen wird sie mit Argwohn betrachtet.nnIch bin hier, solltet Ihr meine Unterweisung wünschen.‡‡Soy Firmanvaar y haces bien en buscarme. Es mi tarea instruir a los chamanes, especialmente los que están empezando.nnSolo ahora se está volviendo a aprender el chamanismos entre los <raza>, <nombre>. Eres valiente al seguir un camino que no es tan popular entre los de tu clase.nnEstaré aquí cuando creas estar lista para más instrucción.‡‡‡‡',
  }
},
[9422] = {
  {
    'Limpeza do deserto‡Истощение пустыни‡Durchkämmen der Wüste‡사막 탐색‡Peinando el desierto‡Peinando el desierto‡Passer le désert au peigne fin‡横扫沙漠‡穿過沙漠',
    nil,
    'Encontre e leve a Silitista até o Extrator de Silitista, então fale com a General Kyríala, no acampamento da Horda perto da Colme\'Régia.‡Найдите и принесите силитист к экстрактору силитистов и поговорите с генералом Кирикой в лагере Орды возле Улья Регал.‡Findet Silithyst, bringt es zum Silithystextraktor und sprecht anschließend mit General Kirika beim Lager der Horde in der Nähe des Regalschwarmbaus.‡실리시스트를 찾아서 실리시스트 추출기로 운반한 후, 하이브레갈 근처의 호드 야영지에 있는 사령관 키리카와 대화해야 합니다.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el general Kirika en el campamento de la horda cerca de Colmen\'Regal.‡Encuentra y entrega la silitista al extractor de silitista y después habla con el general Kirika en el campamento de la horda cerca de Colmen\'Regal.‡Trouver de la Silithyste et la livrer à un Extracteur de silithyste, puis parler au général Kirika au campement de la Horde près de Ruche\'Regal.‡找到一份水晶尘，将其送到水晶尘萃取器那里，然后向雷戈虫巢外部落营地的吉里卡将军复命。‡找到並將希利塞斯紅塵送到希利塞斯提取器那裡，再到雷戈蟲巢附近的部落營地和奇立卡將軍談談。',
  }
},
[9423] = {
  {
    'Fale novamente com Obaden‡Возвращение к Обадию‡Rückkehr zu Obadei‡오베다이에게 전할 소식‡Retorno a Obadei‡Regresa junto a Obadei‡Retourner voir Obadeï‡返回欧巴迪身边‡回去找歐拜德',
    nil,
    'Fale novamente com o Anacoreta Obaden, no Templo de Telhamat, na Península Fogo do Inferno, e lhe informe sobre a morte de Sedai.‡Возвращайтесь к анахорету Обадию в храм Телхамат на полуострове Адского Пламени и расскажите о смерти Седаи.‡Kehrt zu Anachoret Obadei beim Tempel von Telhamat auf der Höllenfeuerhalbinsel zurück und berichtet ihm von Sedais Tod.‡지옥불 반도의 텔하마트 사원에 있는 수도사 오베다이에게 돌아가 세다이의 죽음을 전해야 합니다.‡Informa al anacoreta Obadei del Templo de Telhamat, en la Península del Fuego Infernal, de la muerte de Sedai.‡Informa al anacoreta Obadei del Templo de Telhamat, en la Península del Fuego Infernal, de la muerte de Sedai.‡Retournez voir l\'anachorète Obadeï au temple de Telhamat dans la péninsule des Flammes infernales, et apprenez-lui la mort de Sedaï.‡返回地狱火半岛的塔哈玛特神殿向学者欧巴迪复命，告诉他瑟丹已经死了。‡回到地獄火半島的特爾哈曼神廟找隱士歐拜德，告知他希戴的死訊',
  }
},
[9424] = {
  {
    'A vingança de Makuru‡Месть Макуру‡Makurus Rache‡마쿠루의 복수‡La venganza de Makuru‡La venganza de Makuru‡La vengeance de Makuru‡玛库鲁的复仇‡瑪酷魯的復仇',
    nil,
    'Makuru, no Templo de Telhamat, na Península Fogo do Inferno, quer que você lhe traga 10 colares de Contas Ancestrais de Mag\'har.‡Принесите 10 ожерелий предков маг\'харов Макуру в храм Телхамат на полуострове Адского Пламени.‡Makuru im Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 10 Ahnenperlen der Mag\'har bringt.‡지옥불 반도의 텔하마트 사원에 있는 마쿠루가 마그하르 부족 묵주 10개를 가져다 달라고 부탁했습니다.‡Makuru del Templo de Telhamat, en la Península del Fuego Infernal, quiere que le lleves 10 cuentas ancestrales Mag\'har.‡Makuru del Templo de Telhamat, en la Península del Fuego Infernal, quiere que le lleves 10 cuentas ancestrales Mag\'har.‡Makuru, au temple de Telhamat dans la péninsule des Flammes infernales, veut que vous lui rameniez 10 Perles ancestrales Mag\'har.‡地狱火半岛塔哈玛特神殿的玛库鲁要你带回10个玛格汉先祖念珠。‡地獄火半島上特爾哈曼神廟的瑪酷魯要你帶給他10個瑪格哈先祖珠串。',
  }
},
[9425] = {
  {
    'Apresente-se a Serraria Tarren‡Возвращение в Мельницу Таррен‡Bericht an Tarrens Mühle‡타렌 밀농장으로 보고‡Informando en Molino Tarren‡Informando en Molino Tarren‡Présentez-vous au Moulin-de-Tarren‡前往塔伦米尔‡向塔倫米爾報告',
    nil,
    'Viaje até Serraria Tarren, no Contraforte de Eira dos Montes, e fale com a Conselheira Crepax.‡Отправляйтесь в Мельницу Таррен в предгорьях Хилсбрада и поговорите с советником Вечерней Зарей.‡Reist nach Tarrens Mühle im Vorgebirge des Hügellands und sprecht mit Beraterin Morgenabend.‡힐스브래드 구릉지의 타렌 밀농장으로 가서 조언자 더스킹돈과 대화하십시오.‡Ve a Molino Tarren, en las Laderas de Trabalomas, y habla con la consejera Nochealba.‡Ve a Molino Tarren, en las Laderas de Trabalomas, y habla con la consejera Nochealba.‡Rendez-vous à Moulin-de-Tarren, dans les contreforts de Hautebrande, et parlez à la conseillère Brunaurore.‡前往希尔斯布莱德丘陵的塔伦米尔，与顾问达斯多恩谈一谈。‡前往希爾斯布萊德丘陵的塔倫米爾和諫言者·幽明談談。',
  }
},
[9426] = {
  {
    'Os Poços de Aggonar‡Пруды Аггонара‡Die Teiche von Aggonar‡아고나르의 웅덩이‡Las Pozas de Aggonar‡Las Pozas de Aggonar‡Les bassins d\'Aggonar‡阿苟纳之池‡阿葛納爾之池',
    nil,
    'Amaan, o Sábio, quer que você vá até os Poços de Aggonar e mate 6 Terríferos e 6 Putrefações Virulentas.‡Отправляйтесь к прудам Аггонара и убейте 6 исчадий ужаса и 6 волдырных гнилостней по просьбе Амаана Мудрого.‡Amaan der Weise möchte, dass Ihr zu den Teichen von Aggonar geht und 6 Teufelsblutschrecken und 6 mörderische Faulschleime tötet.‡현자 아만이 아고나르의 웅덩이로 가서 공포의 마귀 6마리와 기포나는 부패물 6마리를 처치해 달라고 부탁했습니다.‡Amaan el Sabio quiere que vayas a las Pozas de Aggonar y mates 6 terroadictos y 6 putrefacciones virulentas.‡Amaan el Sabio quiere que vayas a las Pozas de Aggonar y mates 6 terroadictos y 6 putrefacciones virulentas.‡Amaan le Sage veut que vous vous rendiez aux bassins d\'Aggonar pour y tuer 6 Fiels de la terreur et 6 Pourritures caustiques.‡智者阿曼恩要你前往阿苟纳之池，杀死6个恐惧魔和6个起泡的腐泥怪。‡『智者』阿曼要你前往阿葛納爾之池，並殺掉6隻恐懼惡魔和6隻憤怒的腐泥怪。',
  }
},
[9427] = {
  {
    'Purificando as águas‡Очищение вод‡Reinigung des Wassers‡물 정화‡Limpiando las aguas‡Limpiando las aguas‡Purifier les eaux‡净化水体‡淨化水源',
    nil,
    'Amaan, o Sábio, quer que você vá até os Poços de Aggonar e use a Ampola Purificante no cadáver de Aggonar. Fale novamente com Amaan, o Sábio, quando a água estiver livre da essência de Aggonar.‡Отправляйтесь к прудам Аггонара и используйте фиал очищения над телом Аггонара по просьбе Амаана Мудрого. После того как вода будет очищена от сущности Аггонара, возвращайтесь обратно к Амаану.‡Amaan der Weise möchte, dass Ihr zu den Teichen von Aggonar reist und die Reinigungsphiole bei Aggonars Leiche benutzt. Kehrt zu ihm zurück, wenn Ihr das Wasser von Aggonars Essenz befreit habt.‡아고나르의 웅덩이로 가서 아고나르의 유해에 정화의 약병을 뿌려 아고나르의 기운을 물에서 정화한 후, 현자 아만에게 돌아가야 합니다.‡Amaan el Sabio quiere que vayas a las Pozas de Aggonar y uses el vial de limpieza en el cadáver de Aggonar. Ve a ver a Amaan cuando el agua esté limpia de la esencia de Aggonar.‡Amaan el Sabio quiere que vayas a las Pozas de Aggonar y uses el vial de limpieza en el cadáver de Aggonar. Ve a ver a Amaan cuando el agua esté limpia de la esencia de Aggonar.‡Amaan le Sage veut que vous vous rendiez aux Bassins d’Aggonar et que vous utilisiez la Fiole de purification sur le cadavre d’Aggonar. Retournez le voir lorsque l’eau aura purifié l’essence d’Aggonar.‡前往阿苟纳之池，对阿苟纳的尸体使用净化水瓶。当阿苟纳的精华被净化之后，回去向智者阿曼恩复命。‡『智者』阿曼要你前往阿葛納爾之池並對阿葛納爾的屍體使用淨化的瓶子。當阿葛納爾的本質藉由瓶子裡的水得到淨化就回去找他。',
  }
},
[9428] = {
  {
    'Apresente-se ao Posto Machadada‡На заставу Расщепленного Дерева‡Bericht an den Splitterholzposten‡토막나무 주둔지로 보고‡Misión en Puesto del Hachazo‡Misión en Puesto del Hachazo‡Présentez-vous au poste de Bois-brisé‡前往碎木岗哨‡向碎木崗哨回報',
    nil,
    'Vá até o Posto Machadada no Vale Gris e fale com o Conselheiro Jurassolar.‡Поговорите с советником Верным Солнцу на заставе Расщепленного Дерева в Ясеневом лесу.‡Reist zum Splitterholzposten im Eschental und sprecht mit Berater Sonnenschwur.‡잿빛 골짜기의 토막나무 주둔지로 가서 조언자 선스원과 대화하십시오.‡Ve al Puesto del Hachazo en Vallefresno y habla con el consejero Jurasol.‡Ve al Puesto del Hachazo en Vallefresno y habla con el consejero Jurasol.‡Rendez-vous au poste de Bois-brisé en Orneval et parlez au conseiller Ligesol.‡前往灰谷的碎木岗哨，与顾问萨苏恩·火盟谈一谈。‡前往梣谷的碎木崗哨，和諫言者·日誓談談。',
  }
},
[9429] = {
  {
    'Viajar para a Vila Sombria‡Путешествие в Темнолесье‡Reist nach Dunkelhain‡다크샤이어로의 여정‡Viaje a Villa Oscura‡Viaje a Villa Oscura‡En route pour Sombre-comté‡前往夜色镇‡前往夜色鎮',
    nil,
    'Vá até a Vila Sombria, na Floresta do Crepúsculo, e fale com o Anacoreta Delan.‡Поговорите с анахоретом Деланом в городе Темнолесье в Сумеречном лесу.‡Reist nach Dunkelhain im Dämmerwald und sprecht mit Anachoret Delan.‡그늘숲에 있는 다크샤이어로 간 후 수도사 델란과 대화해야 합니다.‡Ve a Villa Oscura en el Bosque del Ocaso y habla con el anacoreta Delan.‡Ve a Villa Oscura en el Bosque del Ocaso y habla con el anacoreta Delan.‡Rendez-vous à Sombre-comté dans le bois de la Pénombre et parlez à l\'anachorète Delan.‡前往暮色森林的夜色镇，与学者德尔兰谈一谈。‡到暮色森林的夜色鎮去找隱士·迪藍談談。',
  }
},
[9430] = {
  {
    'Relíquias de Sha\'naar‡Реликвии Ша\'наара‡Relikte von Sha\'naar‡샤나르 유물‡Las reliquias de Sha\'naar‡Las reliquias de Sha\'naar‡Les reliques de Sha\'naar‡沙纳尔圣物‡夏納聖物',
    nil,
    'Amaan, o Sábio, no Templo de Telhamat, que fica na Península Fogo do Inferno, quer que você viaje para as Ruínas de Sha\'naar e colete 10 Relíquias de Sha\'naar.‡Отправляйтесь в руины Ша\'наара и соберите 10 реликвий Ша\'наара по просьбе Амаана Мудрого из храма Телхамат на полуострове Адского Пламени.‡Amaan der Weise beim Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr zu den Ruinen von Sha\'naar reist und 10 Relikte von Sha\'naar einsammelt.‡지옥불 반도의 텔하마트 사원에 있는 현자 아만이 샤나르 폐허로 가서 샤나르 유물 10개를 찾아 달라고 부탁했습니다.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas a las Ruinas de Sha\'naar y recuperes 10 reliquias de Sha\'naar.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas a las Ruinas de Sha\'naar y recuperes 10 reliquias de Sha\'naar.‡Amaan le Sage, au Temple de Telhamat dans la Péninsule des Flammes infernales, veut que vous vous rendiez aux ruines de Sha\'naar pour y récupérer 10 Reliques de Sha\'naar.‡地狱火半岛塔哈玛特神殿的智者阿曼恩要你去沙纳尔废墟找回10个沙纳尔圣物。‡在地獄火半島，特爾哈曼神廟的『智者』阿曼要你去夏納廢墟取得10個夏納聖物。',
  }
},
[9431] = {
  {
    'A Different Approach‡Разный подход‡Eine andere Lösung‡또 다른 접근 방식‡Un enfoque diferente‡Un enfoque diferente‡Une nouvelle approche‡另一条路‡不同的方式',
    nil,
    'Pegue 2 punhados de Terra Purificadora de Penedos Trovejantes e leve tudo para Vizlo Limpajunta no Posto Confinalvo.‡Соберите 2 горсти очищающей земли с грохочущих камнедоров и отнесите Визло Фингалету на заставу Белого Плеса.‡Sammelt 2 Handvoll reinigende Erde von den donnernden Felskloppern und bringt sie zu Wizlo Lagerputzer beim Weißgipfelposten.‡우레 바위 정령을 처치하고 정화의 토양 2개를 모아서 백사장 야영지에 있는 위즐로 베어링샤이너에게 가져가야 합니다.‡Recolecta 2 puñados de tierra purificante de Rocoso tronador y llévaselos a Wizlo Rodabrillante, en el Campamento del Tramo Blanco.‡Recolecta 2 puñados de tierra purificante de Rocoso tronador y llévaselos a Wizlo Rodabrillante, en el Campamento del Tramo Blanco.‡Récupérez 2 poignées de Terre purificatrice sur les Eboulides fulminants, et remettez-les à Wizlo Braquecoquard au poste de Blanc-relais.‡从雷鸣岩石元素身上收集两份纯净之土，把它们交给白沙岗哨的维兹罗。‡從雷鳴岩石元素身上收集2把淨化泥土並將它們帶給白沙崗哨的維茲羅·擦軸人。',
  }
},
[9432] = {
  {
    'Viajar para Astranaar‡Дорога в Астранаар‡Reist nach Astranaar‡아스트라나르로의 여정‡Viaje a Astranaar‡Viaje a Astranaar‡En route pour Astranaar‡前往阿斯特兰纳‡前往阿斯特蘭納',
    nil,
    'Vá até Astranaar, no Vale Gris, e fale com a Vindicadora Palanaar.‡Отправляйтесь в Астранаар в Ясеневом лесу и поговорите с воздаятельницей Паланаарой.‡Reist nach Astranaar im Eschental und sprecht mit Verteidigerin Palanaar.‡잿빛 골짜기의 아스트라나르로 간 후 구원자 팔란나르와 대화해야 합니다.‡Ve a Astranaar en Vallefresno y habla con el vindicador Palais.‡Ve a Astranaar en Vallefresno y habla con el vindicador Palais.‡Rendez-vous à Astranaar en Orneval, et parlez au redresseur de torts Palanaar.‡到灰谷的阿斯特兰纳去，与守备官帕兰纳尔谈一谈。‡前往梣谷的阿斯特蘭納並和復仇者帕賴斯談談。',
  }
},
[9433] = {
  {
    'Um mergulho no poço lunar‡Проба из лунного колодца‡Ein Tauchgang im Mondbrunnen‡달샘 물 뜨기‡En la Poza de la Luna‡En la Poza de la Luna‡A Dip in the Moonwell‡月亮井的水‡',
    nil,
    'Use o controle do Robotron quando estiver perto do Console de Comando Escondido num pequeno amontoado de arbustos na agulha mais próxima de Thalanaar para assumir o comando do Robotron 3000. Pilote o robô até o extremo oeste das Mil Agulhas, onde fica o posto avançado da Aliança de Thalanaar. Use o robô para coletar uma amostra de água do poço lunar e leve isso para Vizlo Limpajunta no Posto Confinalvo.‡На каменной игле, ближайшей к границе с Таланааром, в кустах спрятано устройство управления Роботроном 3000. Найдите ее и включите робота при помощи устройства, которое вам дал Визло. Подведите робота к западному краю Тысячи Игл, где находится застава Альянса под названием Таланаар, и прикажите ему набрать немного воды из лунного колодца, после чего вернитесь к Визло Фингалету на заставу Белого Плеса.‡Benutzt die Bedienungseinheit für Robotron in der Nähe der versteckten Steuerungskonsole in einer kleinen Gruppe von Büschen am Rand der Nadel, die sich am dichtesten an Thalanaar befindet, und übernehmt die Steuerung des Robotron 3000. Steuert den Roboter zum westlichen Ende von tausend Nadeln zum Allianzaußenposten von Thalanaar. Benutzt den Roboter, um eine Probe Mondbrunnenwasser zu besorgen und bringt sie zu Wizlo Lagerputzer beim Weißgipfelposten.‡탈라나르에서 가장 가까운 봉우리의 가장자리에 있는 작은 덤불 속에 숨겨진 숨겨놓은 제어판 근처에서 로보트론 제어장치를 사용하여 로보트론 3000에게 명령을 내려야 합니다. 탈라나르의 얼라이언스 전초기지가 있는 버섯구름 봉우리의 서쪽 가장자리로 로봇을 조종해야 합니다. 로보트론을 사용하여 달샘 물의 표본을 모은 다음 다시 백사장 야영지에 있는 위즐로 베어링샤이너에게 돌아가십시오.‡Usa la unidad de control del Robotrón cerca de la consola de control oculta en unos arbustos en el borde de la aguja más cercana a Thalanaar para tomar control del Robotrón 3000. Conduce al robot al extremo oeste de Las Mil Agujas, donde está la avanzada de la Alianza de Thalanaar. Usa el robot para recoger una muestra de agua de la Poza de la Luna y devuélveselo a Wizlo Rodabrillante en el Campamento del Tramo Blanco.‡Usa la unidad de control del Robotrón cerca de la consola de control oculta en unos arbustos en el borde de la aguja más cercana a Thalanaar para tomar control del Robotrón 3000. Conduce al robot al extremo oeste de Las Mil Agujas, donde está la avanzada de la Alianza de Thalanaar. Usa el robot para recoger una muestra de agua de la Poza de la Luna y devuélveselo a Wizlo Rodabrillante en el Campamento del Tramo Blanco.‡Use the Robotron Control while standing near the Concealed Command Console hidden in a small cluster of bushes on the rim of the needle closest to Thalanaar to take command of a Robotron 3000. Pilot the robot to the western edge of Thousand Needles where the Alliance outpost of Thalanaar is located. Use the robot to collect a sample of the moonwell\'s water and return it to Wizlo Bearingshiner at Whitereach Post.‡在千针石林边界靠近萨兰纳尔的一处灌木从中找到隐蔽的控制台，并在那里控制机器助手3000型进入萨兰纳尔收集一份月亮井的水，然后把水交给白沙岗哨的维兹罗。‡',
  }
},
[9434] = {
  {
    'O teste do tônico‡Испытание тоника‡Das Tonikum testen‡약 시험‡Probando el tónico‡Probando el tónico‡Tester le tonique‡测试药剂‡',
    nil,
    'Entregue o Caixote de Reagentes para a Magistra Elosai na Aldeia Vento Livre.‡Доставьте ящик с реагентами магистра Элозай на Заставу Вольного Ветра.‡Bringt die Kiste mit Reagenzien zu Magistrix Elosai im Freiwindposten.‡높새바람 봉우리에 있는 마법학자 엘로세이에게 연구 재료 상자를 가져가야 합니다.‡Entrega el cajón de componentes a la magistrix Elosai en el Poblado Viento Libre.‡Entrega el cajón de componentes a la magistrix Elosai en el Poblado Viento Libre.‡Livrez la Caisse de composants à la magistrice Elosai au poste de Librevent.‡将这箱材料交给乱风岗的魔导师艾洛塞。‡',
  }
},
[9435] = {
  {
    'Desvio de cristais‡Пропавшие кристаллы‡Vermisste Kristalle‡잃어버린 수정‡Los cristales desaparecidos‡Los cristales desaparecidos‡Les cristaux manquants‡遗失的水晶‡遺失的水晶',
    nil,
    'Recupere o Carregamento de Cristais Raros dos Renegados e devolva-o para Huraan, na Costa Sul.‡Отберите у нежити посылку с редкими кристаллами и верните ее Ураану из Южнобережья.‡Besorgt die Lieferung seltener Kristalle von den Verlassenen und bringt sie zu Huraan in Süderstade zurück.‡포세이큰에게서 희귀한 수정이 든 화물 상자를 되찾은 후 사우스쇼어에 있는 후라안에게 돌아가야 합니다.‡Recupera el envío de cristales raros de los Renegados y devuélveselo a Huraan en Costasur.‡Recupera el envío de cristales raros de los Renegados y devuélveselo a Huraan en Costasur.‡Reprenez le Chargement de cristaux rares aux Réprouvés et rapportez-le à Huraan à Austrivage.‡从被遗忘者手中夺回一箱稀有的水晶，把它交给南海镇的忽尔兰。‡從被遺忘者那裡取回一箱稀有水晶並交給南海鎮的胡嵐。',
  }
},
[9436] = {
  {
    'Conhecimento dos Sanguescalpo‡Изучение Кровавого Скальпа‡Erkenntnisse über die Blutskalpe‡붉은머리부족에게 한 수 배우기‡Técnicas Sangrapellejo‡Técnicas Sangrapellejo‡Étudier les Scalps-rouges‡血顶巨魔的魔法‡洞悉血頂習性',
    nil,
    'Nemeth Olho de Falcão no Acampamento Grom\'gol quer que você adquira um Totem Sanguescalpo de um Xamã Sanguescalpo.‡Немет Остроглаз из лагеря Гром\'гол попросил вас принести ему тотем Кровавого Скальпа, добыв его у шамана из племени Кровавого Скальпа.‡Nemeth Falkenauge im Basislager von Grom\'gol möchte, dass Ihr ihm ein Totem der Blutskalpe von einem Schamanen der Blutskalpe bringt.‡그롬골 주둔지의 네메스 호크아이가 붉은머리부족 주술사를 처치하고 붉은머리부족 토템을 가져다 달라고 부탁했습니다.‡Nemeth Ojohalcón del campamento Grom\'gol quiere que le lleves el tótem de un chamán Sangrapellejo.‡Nemeth Ojohalcón del campamento Grom\'gol quiere que le lleves el tótem de un chamán Sangrapellejo.‡Nemeth Œil-de-faucon au campement Grom’gol veut que vous lui rameniez un Totem scalp-rouge pris sur un Chaman scalp-rouge.‡格罗姆高营地的纳密斯·鹰眼希望你能从某个血顶萨满祭司身上带回一个血顶图腾给他。‡格羅姆高營地的奈米斯·鷹眼要你幫他從血頂薩滿身上帶來一個血頂圖騰。',
  }
},
[9437] = {
  {
    'O crepúsculo do mensageiro da aurora‡Сумерки "Гонца Рассвета"‡Der Untergang der Morgenbö‡황혼의 새벽물살호‡El surcador del ocaso‡El surcador del ocaso‡Le crépuscule du Coureur de l\'aube‡黎明号的黄昏‡黎明行者的微光',
    nil,
    'Yalandar Estelúmen, na Aldeia Muralha Verde, quer que você reivindique a Carga do Mensageiro da Aurora e que liberte a primeira oficial Itânia das forças de Theramore na Torre Norte.‡Верните груз с "Гонца Рассвета" Балиндару Ясной Звезде в деревню Гиблотопь и спасите его первого помощника Итанию из рук тераморцев, из Северной башни.‡Balandar Sternenlicht in Brackenwall möchte, dass Ihr die Fracht der Morgenbö wiederholt und den Ersten Maat Ithania von den Streitkräften von Theramore in der Nordwacht befreit.‡담쟁이 마을에 있는 발란다르 브라이트스타가 북부 경비탑에서 테라모어 군대를 물리치고 새벽물살호 화물 상자를 되찾고 일등 항해사 이사니아를 구해달라고 부탁했습니다.‡Balandar Estrellaclara de Poblado Murohelecho quiere que rescates el carguero El surcador del ocaso y a su compañera Ithania de las tropas de Theramore en la Torre de la Punta Norte.‡Balandar Estrellaclara de Poblado Murohelecho quiere que rescates el carguero El surcador del ocaso y a su compañera Ithania de las tropas de Theramore en la Torre de la Punta Norte.‡Balandar Brillétoile, à Mur-de-Fougères, veut que vous récupériez la Cargaison du Coureur de l’aube et que vous sauviez son second, Ithania, des troupes de Theramore à la Tour de la halte nord.‡前往北点哨塔，从塞拉摩军队手中夺回黎明号的货物，搭救大副伊萨妮亚，然后返回蕨墙村向巴尔兰达·新星复命。‡蕨牆村的巴藍達·亮星要你前往北點哨塔的塞拉摩軍隊中去取回黎明行者得貨物並救出他第一個同伴伊薩妮亞。',
  }
},
[9438] = {
  {
    'Mensagem para Thrall‡Донесение Траллу‡Bote für Thrall‡Messenger to Thrall‡Mensaje para Thrall‡Mensaje para Thrall‡Messenger to Thrall‡通知萨尔‡給索爾的消息',
    nil,
    'Vá até Orgrimmar e entregue a Carta de Nazgrel para Thrall.‡Отправляйтесь в Оргриммар и доставьте Траллу письмо Назгрела.‡Reist nach Orgrimmar und übergebt Thrall Nazgrels Brief.‡Travel to Orgrimmar and give Thrall the Letter from Nazgrel.‡Ve a Orgrimmar y entrega a Thrall la carta de Nazgrel.‡Ve a Orgrimmar y entrega a Thrall la carta de Nazgrel.‡Travel to Orgrimmar and give Thrall the Letter from Nazgrel.‡前往奥格瑞玛，将纳兹格雷尔的来信交给萨尔。‡前往奧格瑪將來自納茲格雷爾的信交給索爾。',
  }
},
[9439] = {
  {
    'Achados e roubados‡Потерянный багаж‡Unabgeholtes Gepäck‡주인 없는 짐꾸러미‡Equipaje perdido‡Equipaje perdido‡Des bagages non réclamés‡被抢走的财物‡無人的行李',
    nil,
    'Recupere a Bolsa do Conselheiro e o Florete do Conselheiro no lugar onde estão escondidos na Fortaleza Angor. Depois, devolva tudo para o Conselheiro Sarophas em Karrath.‡Верните советнику Сарофасу в Каргат вещи советника и рапиру советника из Крепости Ангор.‡Holt den Beutel des Beraters und das Rapier des Beraters aus der Festung Angor und kehrt dann zu Berater Sarophas in Kargath zurück.‡고통의 요새에서 조언자의 짐꾸러미와 조언자의 레이피어를 되찾은 후 카르가스에 있는 조언자 사로파스에게 돌아가십시오.‡Recupera el paquete de consejero y el estoque de consejero en la Fortaleza de Angor y devuélveselos al consejero Sarophas en Kargath.‡Recupera el paquete de consejero y el estoque de consejero en la Fortaleza de Angor y devuélveselos al consejero Sarophas en Kargath.‡Récupérez le Sac du conseiller et la Rapière du conseiller qui se trouvent dans la forteresse d’Angor, et rendez-les au conseiller Sarophas, à Kargath.‡从苦痛堡垒中夺回顾问的背包和顾问的细剑，然后向卡加斯的顾问萨洛法斯复命。‡從黑鐵矮人在苦痛堡壘的地盤取回諫言者的包裹和諫言者的細劍再還給卡加斯的諫言者·薩羅法斯。',
  }
},
[9440] = {
  {
    'Pequenos petiscos‡Маленькие кусочки‡Kleine Häppchen‡먹이 조금만‡Bocaditos peligrosos‡Bocaditos peligrosos‡De petites bouchées‡一点食物‡一點食物',
    nil,
    'Alimente os animais capturados dos Perdido com Petiscos Maculados. Depois, devolva as sobras para Cersei Cantocaso em Pedregal, no Pântano das Mágoas.‡Накормите испорченными кусочками мяса домашний скот Заблудших. Потом верните отстатки Серсее Певице Заката в Каменор на Болото Печали.‡Verfüttert die teuflischen Häppchen an die gefangenen Tiere der Verirrten. Bringt die Überbleibsel zu Cersei Abendsänger in Steinard in den Sümpfen des Elends.‡잃어버린 드레나이가 사로잡은 동물들에게 악에 오염된 먹이를 준 다음 남은 먹이를 가지고 슬픔의 늪, 스토나드에 있는 케르사이 더스크싱어에게 돌아가십시오.‡Da la comida mácula a los animales de Los Perdidos. Llévale las sobras a Cersei Serenata a Rocal en el Pantano de las Penas.‡Da la comida mácula a los animales de Los Perdidos. Llévale las sobras a Cersei Canto Nocturno a Rocal en el Pantano de las Penas.‡Donnez des Bouchées gangrenées aux animaux capturés par les Perdus. Ramenez les restes à Cersei Chantebrune, à Pierrêche, dans le marais des Chagrins.‡将邪恶侵蚀的食物喂给被失落者捕获的猎物。然后将剩余的饲料带回去交给悲伤沼泽斯通纳德的瑟尔希-暗歌。‡將邪惡污染的食物餵給被失落者捕捉的動物。再帶著殘羹剩菜回到悲傷沼澤的斯通納德找瑟賽·幽歌者。',
  }
},
[9441] = {
  {
    'Enviado aos Mag\'har‡Посол к маг\'харам‡Entsandt zu den Mag\'har‡Envoy to the Mag\'har‡Tributo a los Mag\'har‡Tributo a los Mag\'har‡Émissaire auprès des Mag\'har‡玛格汉的信使‡瑪格哈使者',
    nil,
    'Thrall quer que você fale novamente com Gorkan Punho de Sangue no Posto Mag\'har, na Península Fogo do Inferno, e ofereça seus serviços a ele.‡Вернитесь к Горкану Кровопалу на заставу маг\'харов на полуострове Адского Пламени и предложите ему свои услуги.‡Kehrt zu Gorkan Blutfaust beim Posten der Mag\'har auf der Höllenfeuerhalbinsel zurück und bietet ihm im Namen Thralls Eure Dienste an.‡Thrall wants you to return to Gorkan Bloodfist at Mag\'har Post in Hellfire Peninsula and offer him your services.‡Thrall quiere que vayas a ofrecerle tus servicios a Gorkan Puñosangre en el Puesto Mag\'har en la Península del Fuego Infernal.‡Thrall quiere que vayas a ofrecerle tus servicios a Gorkan Puñosangre en el Puesto Mag\'har en la Península del Fuego Infernal.‡Thrall veut que vous retourniez voir Gorkan Poing-de-sang au poste Mag\'har de la péninsule des Flammes infernales, et que vous lui offriez vos services.‡萨尔希望你立刻回到地狱火半岛，向玛格汉岗哨的格尔坎·血拳报到，并为他效力。‡索爾要你回到地獄火半島的瑪格哈崗哨找葛坎·血拳並協助他。',
  }
},
[9442] = {
  {
    'Uma doença debilitante‡Изнуряющая слабость‡Eine erschöpfende Krankheit‡쇠약해지는 병‡Enfermedad debilitante‡Enfermedad debilitante‡Une maladie débilitante‡虚弱的疾病‡削弱力量的疾病',
    nil,
    'Arauto da Terra Ryga, no Posto Mag\'har, na Península Fogo do Inferno, quer que você lhe leve 1 Cogumelo Secampânulo; o cogumelo se encontra em uma caverna na Grande Fenda.‡Принесите гриб-сухошляпку заклинательнице земли Риге с заставы маг\'харов на полуострове Адского Пламени. Сухошляпки растут только в пещере внутри Глубокого разлома.‡Erdruferin Ryga beim Posten der Mag\'har auf der Höllenfeuerhalbinsel möchte, dass Ihr 1 Trockenkappe aus einer Höhle in der großen Kluft besorgt.‡지옥불 반도의 마그하르 거점에 있는 대지술사 리가가 거대한 균열의 한 동굴에서 마른고깔버섯 1개를 가져다 달라고 부탁했습니다.‡Clamor de Tierra Ryga del Puesto Mag\'har en la Península del Fuego Infernal quiere que le lleves 1 champiñón capuseca de una cueva de La Gran Fisura.‡La clamatierras Ryga del Puesto Mag\'har en la Península del Fuego Infernal quiere que le lleves 1 champiñón capuseca de una cueva de La Gran Fisura.‡L’imploratrice de la terre Ryga, au poste de Mag\'har de la péninsule des Flammes infernales, veut que vous lui rameniez 1 Champignon tête-sèche cueilli dans une caverne de la Grande fissure.‡从大裂隙的洞穴中采摘一朵枯顶蘑菇，将其交给地狱火半岛玛格汉岗哨的唤地者利迦。‡地獄火半島上瑪格哈崗哨的大地呼喚者瑞卡要你從大裂縫裡的洞穴帶1個乾頂磨菇給她。',
  }
},
[9443] = {
  {
    'A suposta marca do Arauto da Luz‡Так называемый знак Светоносного‡Das sogenannte Mal des Lichtbringers‡빛의 수호자의 징표라는 물건‡La marca del Iluminado‡La supuesta marca del Iluminado‡La pseudo-marque du Porteur de Lumière‡所谓的光明使者印记‡所謂的光明使者的印記',
    nil,
    'Consiga a Marca do Arauto da Luz e leve-a para Mehlar Aurolume no Baluarte, nas Terras Pestilentas Ocidentais.‡Добудьте знак Светоносного и принесите его Мелару Клинку Рассвета в Бастион, что в Западных Чумных землях.‡Nehmt das Mal des Lichtbringers an Euch und kehrt anschließend zu Mehlar Dämmerklinge beim Bollwerk in den westlichen Pestländern zurück.‡빛의 수호자의 징표를 찾아서 서부 역병지대의 보루에 있는 메라 돈블레이드에게 돌아가십시오.‡Consigue la marca del Iluminado y llévasela a Mehlar Hojalba a El Baluarte en las Tierras de la Peste del Oeste.‡Consigue la marca del Iluminado y llévasela a Mehlar Hojalba a El Baluarte en las Tierras de la Peste del Oeste.‡Obtenez la Marque du Porteur de Lumière et ramenez-la à Mehlar Aubelame à la Barricade dans les Maleterres de l\'ouest.‡拿到光明使者的印记，把它交给西瘟疫之地亡灵壁垒的麦拉·黎明之刃。‡取得光明使者記號再帶回西瘟疫之地的亡靈壁壘給瑪拉·曦刃。',
  }
},
[9444] = {
  {
    'Profanação de tumba‡Осквернение гробницы Утера‡Entweiht Uthers Grabmal‡우서 경의 무덤 더럽히기‡Profanar la Tumba de Uther‡Profanar la Tumba de Uther‡Profaner la tombe d\'Uther‡亵渎乌瑟尔之墓‡褻瀆烏瑟之墓',
    nil,
    'Profane a Tumba de Uther e fale novamente com Mehlar Aurolume no Baluarte, nas Terras Pestilentas Ocidentais.‡Оскверните гробницу Утера и возвращайтесь к Мелару Клинку Рассвета в Бастион, что в Западных Чумных землях.‡Entweiht Uthers Grabmal und kehrt anschließend zu Mehlar Dämmerklinge beim Bollwerk in den westlichen Pestländern zurück.‡우서 경의 무덤을 더럽힌 다음 서부 역병지대의 보루에 있는 메라 돈블레이드에게 돌아가십시오.‡Profana la Tumba de Uther y ve a ver a Mehlar Hojalba a El Baluarte en las Tierras de la Peste del Oeste.‡Profana la Tumba de Uther y ve a ver a Mehlar Hojalba a El Baluarte en las Tierras de la Peste del Oeste.‡Profaner la Tombe d’Uther puis retourner voir Mehlar Aubelame à la Barricade des Maleterres de l’Ouest.‡亵渎乌瑟尔之墓，并向西瘟疫之地亡灵壁垒的麦拉·黎明之刃复命。‡褻瀆烏瑟之墓再回到西瘟疫之地的亡靈壁壘找瑪拉·曦刃。',
  }
},
[9445] = {
  {
    '‡‡‡‡‡‡‡‡<NYI><TXT>Placeholder: A Worthy Offering',
    nil,
    '‡‡‡‡‡‡‡‡從壁爐谷入口附近的守衛哨塔頂端取得烏瑟的祝福，再帶給冰風崗的<NPC>。',
  }
},
[9446] = {
  {
    'Tumba do Arauto da Luz‡Гробница Светоносного‡Das Grab des Lichtbringers‡빛의 수호자의 무덤‡La Tumba del Iluminado‡La Tumba del Iluminado‡La tombe d\'Uther‡光明使者之墓‡光明使者之墓',
    nil,
    'Escolte o Anacoreta Truuen até a Tumba de Uther, nas Terras Pestilentas Ocidentais. Depois, fale com a Alta-sacerdotisa Donélia no Acampamento Ventogelante, nas Terras Pestilentas Ocidentais.‡Проводите анахорета Трууна к гробнице Утера в Западные Чумные земли. После поговорите с верховной жрицей Макдонелл из Лагеря Промозглого Ветра.‡Begleitet Anachoret Truuen zu Uthers Grabmal in den westlichen Pestländern. Sprecht danach mit Hohepriesterin MacDonnell im Zugwindlager in den westlichen Pestländern.‡서부 역병지대에 있는 우서 경의 무덤까지 수도사 트루엔을 호위한 후 서리바람 야영지에 있는 대여사제 맥도널과 대화해야 합니다.‡Acompaña al anacoreta Truuen a la Tumba de Uther en las Tierras de la Peste del Oeste. Después habla con la suma sacerdotisa MacDonnell en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Acompaña al anacoreta Truuen a la Tumba de Uther en las Tierras de la Peste del Oeste. Después habla con la suma sacerdotisa MacDonnell en el Campamento del Orvallo en las Tierras de la Peste del Oeste.‡Escorter l’Anachorète Truuen à la tombe d’Uther, dans les Maleterres de l’ouest. Ensuite, parler avec la grande prêtresse MacDonnell au camp du Noroît dans les Maleterres de l’Ouest.‡护送学者特卢恩前往西瘟疫之地的乌瑟尔之墓，然后与西瘟疫之地寒风营地的高阶牧师玛多妮尔谈一谈。‡護送隱士·楚恩到西瘟疫之地的烏瑟之墓。之後，再到西瘟疫之地的冰風營地和高階牧師瑪多妮爾談談。',
  }
},
[9447] = {
  {
    'Aplicando o unguento‡Применение целебной мази‡Salbe verabreichen‡그런트 치료‡El bálsamo‡El bálsamo‡Administrer le baume de guérison‡治疗疾病‡使用藥膏',
    nil,
    'Arauto da Terra Ryga quer que você aplique Unguento Curativo em 10 Brutos Mag\'har Enfraquecidos perto do Posto Mag\'har, que fica na Península Fogo do Inferno.‡Нанесите целебную мазь на 10 изнуренных маг\'харских рубак рядом с заставой маг\'харов на полуострове Адского Пламени по просьбе заклинательницы земли Риги.‡Erdruferin Ryga möchte, dass Ihr die Heilsalbe 10 entkräfteten Grunzern beim Posten der Mag\'har auf der Höllenfeuerhalbinsel verabreicht.‡대지술사 리가가 지옥불 반도의 마그하르 거점 근처에 있는 쇠약해진 마그하르 그런트 10명에게 치유의 연고로 치료해 달라고 했습니다.‡Clamor de Tierra Ryga quiere que administres el bálsamo de sanación a 10 brutos Mag\'har debilitados cerca del Puesto Mag\'har en la Península del Fuego Infernal.‡La clamatierras Ryga quiere que administres el bálsamo de sanación a 10 brutos Mag\'har debilitados cerca del Puesto Mag\'har en la Península del Fuego Infernal.‡L’Imploratrice de la terre Ryga veut que vous administriez le Baume de guérison à 10 Grunts Mag\'har affaiblis proches du poste Mag\'har, dans la péninsule des Flammes infernales.‡唤地者利迦要你对地狱火半岛玛格汉岗哨附近的那些疲惫的玛格汉步兵使用治疗药膏，医治10个疲惫的玛格汉步兵。‡大地呼喚者瑞卡要你到地獄火半島的瑪格哈崗哨，對10個疲憊不堪的瑪格哈蠻兵使用治療藥膏。',
  }
},
[9448] = {
  {
    'Misericórdia pelos amaldiçoados‡Милость к проклятым‡Mitleid mit den Verfluchten‡저주받은 잃어버린 드레나이를 위한 자비‡Piedad para los malditos‡Piedad para los malditos‡Pitié pour les maudits‡阿弗恩的怜悯‡憐憫被詛咒者',
    nil,
    'Mate 3 Perdidos Amaldiçoados e, depois, fale novamente com o Anacoreta Avuun no Refúgio do Pântano das Mágoas.‡Убейте 3 проклятых из племени Заблудших, потом вернитесь к анахорету Авууну в Убежище на Болото Печали.‡Tötet 3 Verfluchte der Verirrten und kehrt dann zu Anachoret Avuun im sicheren Hafen in den Sümpfen des Elends zurück.‡저주받은 잃어버린 드레나이 3명을 처치한 후 슬픔의 늪의 피난처에 있는 수도사 아분에게 돌아가야 합니다.‡Mata a 3 Perdidos malditos y ve a ver al anacoreta Avuun a El Puerto en el Pantano de las Penas.‡Mata a 3 Perdidos malditos y ve a ver al anacoreta Avuun a El Puerto en el Pantano de las Penas.‡Tuez 3 Perdus maudits avant de retourner voir l\'anachorète Avuun au Havre boueux, dans le marais des Chagrins.‡杀死3名被诅咒的失落者，然后向悲伤沼泽避难所的学者阿弗恩复命。‡殺死3個被詛咒的失落者再回到悲傷沼澤的避難營找隱士·艾弗恩。',
  }
},
[9449] = {
  {
    'Call of Earth‡Зов земли‡Ruf der Erde‡대지의 토템‡La llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Fale com o Espírito do Vale no Bosque Sagrado, no Vale Ammen.‡Поговорите с духом долины в Священной роще в долине Аммен.‡Sprecht mit dem Geist des Tals beim heiligen Hain im Am\'mental.‡암멘 골짜기의 신성한 숲에 있는 골짜기의 정령과 대화해야 합니다.‡Habla con el Espíritu del Valle en La Arboleda Sagrada en el Valle Ammen.‡Habla con el Espíritu del Valle en La Arboleda Sagrada en el Valle Ammen.‡Parlez à l’Esprit du val au Bosquet sacré du val d’Ammen.‡与埃门谷的元素圣谷中的峡谷之灵谈一谈。‡到安曼谷的神聖樹林和安曼谷之靈談談。',
  }
},
[9450] = {
  {
    'Call of Earth‡Зов земли‡Ruf der Erde‡대지의 토템‡La llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Mate 4 Elementos da Terra Inquietos e, em seguida, fale novamente com o Espírito do Vale no Bosque Sagrado, no Vale Ammen.‡Убейте 4 неупокоенных духов земли и возвращайтесь к духу долины в Священную рощу в долине Аммен.‡Tötet 4 ruhelose Erdgeister und kehrt zum Geist des Tals beim heiligen Hain im Am\'mental zurück.‡불안정한 대지의 정령 4마리를 처치하고 암멘 골짜기의 신성한 숲에 있는 골짜기의 정령에게 돌아가야 합니다.‡Mata a 4 elementales de Tierra inquietos y ve a ver al Espíritu del Valle a La Arboleda Sagrada en el Valle Ammen.‡Mata a 4 elementales de Tierra inquietos y ve a ver al Espíritu del Valle a La Arboleda Sagrada en el Valle Ammen.‡Tuez 4 Esprits de terre sans repos, puis retournez voir l’Esprit du val au Bosquet sacré du val d’Ammen.‡杀死4个躁动的大地之灵，然后向埃门谷的元素圣谷中的峡谷之灵复命。‡殺死4個不安的大地元素再回到安曼谷的神聖樹林找安曼谷之靈。',
  }
},
[9451] = {
  {
    'Call of Earth‡Зов земли‡Ruf der Erde‡대지의 토템‡La llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡召喚大地',
    nil,
    'Entregue o Cristal da Terra para Firmanvaar no Ponto de Impacto, que fica no Vale Ammen.‡Отнесите кристалл Земли Фирманваару на место крушения в долине Аммен.‡Bringt den Erdkristall zu Firmanvaar bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 피르만바르에게 대지의 수정을 가져가야 합니다.‡Entrega el cristal de Tierra a Firmanvaar en el Lugar del Accidente en el Valle Ammen.‡Entrega el cristal de Tierra a Firmanvaar en el Lugar del Accidente en el Valle Ammen.‡Donnez le Cristal de terre à Firmanvaar, au Point d’impact du val d’Ammen.‡将大地水晶交给埃门谷坠毁点的费曼瓦尔。‡將大地水晶送到安曼谷給失事地點的法曼瓦。',
  }
},
[9452] = {
  {
    'Hum... delicinha de pargo-vermelho!‡Деликатесный красный луциан‡Schnapper - sehr, sehr lecker!‡맛있는 붉은퉁돔‡Delicioso pargo rojo‡Delicioso pargo rojo‡Le lutjan rouge, c\'est bon !‡美味的红钳鱼‡紅鯛魚 - 非常美味!',
    nil,
    'Use a Rede de Pesca Draeneica para pescar 10 Pargos-vermelhos. Entregue os peixes e a rede para Diktynna na Ilha Névoa Lazúli após cumprir a tarefa.‡Поймайте 10 красных луцианов рыболовной сетью дренеев. Отдайте рыбу и сеть Диктинне на острове Лазурной Дымки.‡Verwendet das Fischernetz der Draenei, um 10 Schnapper zu fangen. Bringt die Fische und das Netz anschließend zu Diktynna auf der Azurmythosinsel zurück.‡드레나이 낚시 그물을 사용하여 붉은퉁돔 10마리를 잡은 후, 하늘안개 섬의 딕티나에게 잡은 붉은퉁돔과 드레나이 낚시 그물을 가져가야 합니다.‡Usa la red de pescar draenei para pescar 10 pargos rojos. Lleva la red y el pescado a Diktynna a la Isla Bruma Azur.‡Usa la red de pescar draenei para pescar 10 pargos rojos. Lleva la red y el pescado a Diktynna a la Isla Bruma Azur.‡Utilisez le Filet de pêche draeneï pour attraper 10 Lutjans rouges. Ensuite, retournez voir Diktynna sur l\'île de Brume-azur, rendez-lui le filet et donnez-lui les poissons.‡使用德莱尼渔网抓住10只红钳鱼。任务完成后把鱼和渔网交给秘蓝岛的迪泰娜。‡使用德萊尼捕魚網捕捉10隻紅鯛魚。完成任務後將魚和網子帶回藍謎島給狄克泰納。',
  }
},
[9453] = {
  {
    'Encontrar Acteon!‡Поиски Актеона‡Findet Acteon!‡붉은퉁돔 전달‡Busca a Acteon‡Busca a Acteon‡Trouvez Actéon !‡找到艾克提恩！‡找到艾克緹昂!',
    nil,
    'Entregue o Caixote de Pargos-vermelhos a Acteon no Entreposto Lazúli.‡Отнесите ящик красного луциана Актеону на Лазурную заставу.‡Bringt die Ladung Schnapper zu Acteon bei der Azurwacht.‡하늘 감시초소의 옥테온에게 붉은퉁돔 상자를 가져가야 합니다.‡Entrega la caja de pargo rojo a Acteon en la Avanzada Azur.‡Entrega la caja de pargo rojo a Acteon en la Avanzada Azur.‡Livrer la Caisse de lutjans rouges à Actéon au Guet d\'azur.‡将一箱红钳鱼交给碧蓝岗哨的艾克提恩。‡送紅鯛魚木箱給藍色守望的艾克緹昂。',
  }
},
[9454] = {
  {
    'A grande caçada de pastolunas‡Великая охота на лунных оленей‡Die große Mondweidenjagd‡달새김 사슴 사냥‡La caza de venados lunares‡La gran cacería lunar‡La grande chasse aux frôle-lune‡狩猎月痕鹿‡牧月大獵殺',
    nil,
    'Leve 6 peças de Lombo de Cervo Pastoluna para Acteon no Entreposto Lazúli.‡Принесите 6 кусков вырезки лунного оленя Актеону на Лазурную заставу.‡Acteon bei der Azurwacht möchte, dass Ihr ihm 6 Mondweidenhirschlenden bringt.‡하늘 감시초소에 있는 옥테온이 달새김 사슴 안심 6개를 가져다 달라고 부탁했습니다.‡Lleva 6 solomillos de venado lunar a Acteon a la Avanzada Azur.‡Lleva 6 solomillos de venado lunar a Acteon a la Avanzada Azur.‡Apportez 6 Filets de cerfs frôle-lune à Actéon du Guet d\'azur.‡将6份月痕鹿的嫩腰肉交给碧蓝岗哨的艾克提恩。‡帶6塊牧月成鹿嫩腰肉給藍色守望的艾克緹昂。',
  }
},
[9455] = {
  {
    'Descobertas intrigantes‡Странные находки‡Seltsame Funde‡희미하게 빛나는 수정‡Extraños hallazgos‡Extraños hallazgos‡Une étrange trouvaille‡奇怪的发现‡奇怪的發現',
    nil,
    'Entregue o Cristal Fracamente Faiscante ao Exarca Menelaus no Entreposto Lazúli.‡Отнесите слабо мерцающий кристалл экзарху Менелаусу на Лазурную заставу.‡Bringt den schwach leuchtenden Kristall zu Exarch Menelaous bei der Azurwacht.‡하늘 감시초소의 총독 메넬라우스에게 희미하게 빛나는 수정을 가져가야 합니다.‡Entrega el cristal resplandeciente al exarca Menelaous en la Avanzada Azur.‡Entrega el cristal resplandeciente al exarca Menelaous en la Avanzada Azur.‡Remettez le Cristal luisant faiblement à l\'exarque Menelaous, au Guet d\'azur.‡将微微发光的水晶交给碧蓝岗哨的大主教梅内莱厄斯。‡將微光水晶送給藍色守望的主教米奈奧斯。',
  }
},
[9456] = {
  {
    'Extermínio de espreitanoites, Ilha 2...‡Истребление ночных ловцов, остров 2...‡Nachtpirscherjagd‡병든 새끼 흑호 해치우기‡Eliminando acechadores en la isla 2‡Eliminando acechadores en la isla 2‡Nettoyage des traquenuits, île n°2‡清理夜行豹......‡下一步……清除夜間潛伏者',
    nil,
    'O Exarca Menelaus, no Entreposto Lazúli, quer que você mate 8 Espreitanoites Raquíticos Infectados.‡Уничтожьте 8 зараженных ночных ловцов – недоростков и вернитесь на Лазурную заставу.‡Exarch Menelaous bei der Azurwacht möchte, dass Ihr 8 infizierte Nachtpirscherjungen tötet.‡하늘 감시초소의 총독 메넬라우스가 병든 새끼 흑호 8마리를 해치워 달라고 부탁했습니다.‡El exarca Menelaous de la Avanzada Azur quiere que mates 8 cachorros de acechador nocturno infectado.‡El exarca Menelaous de la Avanzada Azur quiere que mates 8 cachorros de acechador nocturno infectado.‡L\'exarque Meleanous du Guet d\'azur vous a demandé de tuer 8 Traquenuits chétifs infectés.‡碧蓝岗哨的大主教梅内莱厄斯要求你杀死8只感染的夜行豹幼崽。‡藍色守望的主教米奈奧斯要你殺死8隻被感染的小型夜間潛伏者。',
  }
},
[9457] = {
  {
    'Um patrono incomum‡Необычный посетитель‡Ein ungewöhnlicher Patron‡예상치 못한 방문객‡Un patrón inusual‡Un patrón inusual‡Un protecteur inhabituel‡不寻常的发现‡',
    nil,
    'Use a Dádiva de Naias perto do Altar de Naias para evocá-lo. Depois, derrote-o e leve o seu Coração para Nemeth Olho de Falcão no Acampamento Grom\'gol.‡Воспользуйтесь даром Найаса неподалеку от алтаря Найаса и призовите этого элементаля воды. Одолейте его и принесите сердце Найаса Немету Остроглазу в лагерь Гром\'гол.‡Benutzt Naias\' Gabe in der Nähe des Altars von Naias, um den Wasserelementar Naias zu rufen. Besiegt ihn und kehrt dann zu Nemeth Falkenauge im Basislager von Grom\'gol mit dem Herz von Naias zurück.‡나이아스의 제단 근처에서 나이아스의 선물을 사용하여 물의 정령 나이아스를 소환해야 합니다. 나이아스를 물리친 후 나이아스의 심장을 가지고 그롬골 주둔지에 있는 네메스 호크아이에게 돌아가십시오.‡Usa el don de Naias cerca del Altar de Naias para invocar al elemental de agua Naias. Derrótalo y lleva su corazón a Nemeth Ojohalcón al campamento Grom\'gol.‡Usa el don de Naias cerca del Altar de Naias para invocar al elemental de agua Naias. Derrótalo y lleva su corazón a Nemeth Ojohalcón al campamento Grom\'gol.‡Servez-vous du Cadeau de Naïas près de l’Autel de Naïas pour invoquer l’élémentaire d’eau Naïas. Lorsque vous l’aurez vaincu, retournez voir Nemeth Œil-de-faucon au campement Grom’gol avec le Cœur de Naïas.‡在奈亚斯祭坛附近使用奈亚斯的礼物，召唤出水元素奈亚斯。击败它之后，将奈亚斯之心交给格罗姆高营地的纳密斯·鹰眼。‡',
  }
},
[9460] = {
  {
    'Unindo forças‡Объединенными усилиями‡Mit vereinten Kräften‡협력‡Aunando fuerzas‡Aunando fuerzas‡Associer ses forces‡窃取情报‡',
    nil,
    'Keltus Umbrafronde quer que você roube o Lenço Rendado do Líder Sentinela e traga-o de volta para ele.‡Украдите у предводительницы часовых кружевной носовой платок и принесите его Келтусу Темному Листу.‡Keltus Dunkellaub möchte, dass Ihr das spitzenverzierte Taschentuch von der Anführerin der Schildwachen stehlt und zu ihm bringt.‡켈투스 다크리프가 파수대 지휘관의 레이스 손수건을 몰래 훔쳐달라고 부탁했습니다.‡Keltus Hojaoscura quiere que le robes el pañuelo bordado al jefe de centinelas y se lo lleves.‡Keltus Hojaoscura quiere que le robes el pañuelo bordado al jefe de centinelas y se lo lleves.‡Keltus Sombrefeuille veut que vous fassiez les poches du Chef des Sentinelles, que vous y récupériez un Mouchoir en dentelle et que vous le lui remettiez.‡克尔图斯·暗叶希望你能从哨兵队长身上偷取一张花边手帕。‡',
  }
},
[9461] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Procure o Profeta Velen na Cripta das Luzes em Exodar.‡Найдите пророка Велена в Чертоге Света Экзодара.‡Geht zu Prophet Velen in der Halle des Lichts in der Exodar.‡엑소다르의 빛의 전당에 있는 예언자 벨렌을 찾아야 합니다.‡Busca al profeta Velen en El Exodar en la Isla Bruma Azur.‡Busca al profeta Velen en El Exodar en la Isla Bruma Azur.‡Allez voir le prophète Velen, à la Voûte des lumières, à bord de l\'Exodar.‡在埃索达的圣光穹顶中找到先知维伦。‡到艾克索達的聖光地窖尋找預言者費倫。',
  }
},
[9462] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Fale com Tuluun no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Поговорите с Тулууном на Лазурной заставе на острове Лазурной Дымки.‡Geht zu Tuluun in der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 툴룬과 대화해야 합니다.‡Busca a Tuluun en la Avanzada Azur en la Isla Bruma Azur.‡Busca a Tuluun en la Avanzada Azur en la Isla Bruma Azur.‡Allez voir Tuluun au Guet d\'Azur, sur l’île de Brume-azur.‡与秘蓝岛上的碧蓝岗哨中的图伦谈一谈。‡到藍謎島和藍色守望的塔奴藍談談。',
  }
},
[9463] = {
  {
    'Propriedades medicinais‡Ради науки‡Medizinische Notwendigkeit‡질긴뿌리 덩굴손 줄기 수집‡Propiedades curativas‡Propiedades curativas‡Usage médical‡医疗材料‡醫療用途',
    nil,
    'A Anacoreta Fateema, no Entreposto Lazúli, quer que você lhe leve 8 Ramos de Enrediça.‡Принесите 8 побегов корнехватов анахоретке Фатиме на Лазурную заставу.‡Anachoret Fateema bei der Azurwacht möchte, dass Ihr für sie 8 Lauerwurzranken sammelt.‡하늘 감시초소의 수도사 파티마가 질긴뿌리 덩굴손 줄기 8개를 가져다 달라고 부탁했습니다.‡La anacoreta Fateema de la Avanzada Azur quiere que le lleves 8 ramas de atraparraíces.‡La anacoreta Fateema de la Avanzada Azur quiere que le lleves 8 ramas de atraparraíces.‡L\'anachorète Fateema au Guet d\'azur veut que vous lui apportiez 8 Vrilles de piègeracine.‡碧蓝岗哨的学者法蒂玛希望你帮她收集8份根须诱捕者的枝条。‡藍色守望的隱士·法禔瑪要你幫她帶來8個根鬚捕獸者藤蔓。',
  }
},
[9464] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Fale com Temper no Campo das Cinzas, que fica na Ilha Névoa Lazúli.‡Поговорите с Пламенравом на Тлеющей поляне на острове Лазурной Дымки.‡Sprecht mit Glutos beim Glutgrund auf der Azurmythosinsel.‡하늘안개 섬의 잿불숲에 있는 열화와 대화해야 합니다.‡Habla con Templar en El Claro de Ascuas en la Isla Bruma Azur.‡Habla con Templar en El Claro de Ascuas en la Isla Bruma Azur.‡Parlez à Hargne à la clairière des braises, sur l\'île de Brume-d\'azur.‡与秘蓝岛灰烬林地中的坦普谈一谈。‡到藍謎島和餘燼林地的暴躁者談談。',
  }
},
[9465] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡의식의 횃불‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Recupere a Tocha Ritual e entregue-a para Temper no Campo das Cinzas, que fica na Ilha Névoa Lazúli.‡Верните ритуальный факел Пламенраву на Тлеющую поляну на острове Лазурной Дымки.‡Erlangt die Ritualfackel wieder und bringt sie zu Glutos beim Glutgrund auf der Azurmythosinsel.‡의식의 횃불를 되찾은 후 하늘안개 섬의 잿불숲에 있는 열화에게 돌아가야 합니다.‡Recupera la antorcha ritual y devuélvesela a Templar en El Claro de Ascuas en la Isla Bruma Azur.‡Recupera la antorcha ritual y devuélvesela a Templar en El Claro de Ascuas en la Isla Bruma Azur.‡Récupérez la Torche rituelle et rapportez-la à Hargne à la clairière des braises sur l\'île de Brume-d\'azur.‡取回仪祭火炬，把它交给秘蓝岛灰烬林地中的坦普。‡取回儀式火炬並帶回藍謎島給餘燼林地的暴躁者。',
  }
},
[9466] = {
  {
    'Procura-se: Garranegra, a Selvagem‡Разыскивается: Свирепая Черноскребка‡Gesucht: Schwarzkralle die Wilde‡현상 수배: 흉포한 검은갈퀴‡Se busca: Garranegra el Salvaje‡Se busca: Garfanegra la Indómita‡On recherche : Griffe-noire la Sauvage‡通缉：黑色利爪‡懸賞:『野蠻者』黑爪',
    nil,
    'Traga as Garras de Garranegra para o Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, que fica na Península Fogo do Inferno.‡Принесите когти Черноскребки капитану следопытов Венн\'рену в Соколиный дозор на полуострове Адского Пламени.‡Bringt Schwarzkralles Klauen zu Waldläuferhauptmann Venn\'ren bei der Falkenwacht auf der Höllenfeuerhalbinsel.‡지옥불 반도의 매의 감시탑에 있는 순찰대장 벤렌에게 검은갈퀴의 발톱을 가져가야 합니다.‡Lleva la zarpa de Garranegra al capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Lleva las garras de Garfanegra al capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Apportez les Griffes de Griffe-noire au capitaine des forestiers Venn\'ren au Guet de l\'épervier dans la péninsule des Flammes infernales.‡将黑色利爪的爪子交给地狱火半岛猎鹰岗哨的游侠队长维恩雷。‡為地獄火半島獵鷹哨站的遊俠隊長范瑞帶來黑爪之爪。',
  }
},
[9467] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Recupere as Cinzas do Arrogante e entregue-as, junto com a Tocha Ritual, para Temper no Campo das Cinzas, que fica nas Ilha Névoa Lazúli. Lembre-se de que você pode usar o Orbe do Retorno para se teletransportar de volta para Temper quando tiver as cinzas.‡Добудьте пепел Спесивца и принесите его и ритуальный факел Пламенраву на Тлеющую поляну на острове Лазурной Дымки. Вы можете воспользоваться сферой возвращения, чтобы телепортироваться к Пламенраву.‡Besorgt Euch Hauteurs Asche und bringt sie zusammen mit der Ritualfackel zu Glutos beim Glutgrund auf der Azurmythosinsel. Vergesst nicht, dass Ihr die Kugel der Rückkehr verwenden könnt, um zu Glutos zurückzukehren, sobald Ihr die Asche habt.‡하우테우르의 재를 회수한 후 의식의 횃불와 함께 귀환의 보주를 사용하여 하늘안개 섬의 잿불숲에 있는 열화에게 돌아가야 합니다.‡Recolecta las cenizas de Prepotencia y devuélveselas junto con la antorcha ritual a Templar en El Claro de Ascuas, en la Isla Bruma Azur. Recuerda que puedas utilizar el orbe de retorno para teletransportarte junto a Templar cuando tengas las cenizas.‡Recolecta las cenizas de Prepotencia y devuélveselas junto con la antorcha ritual a Templar en El Claro de Ascuas, en la Isla Bruma Azur. Recuerda que puedas utilizar el orbe de retorno para teletransportarte junto a Templar cuando tengas las cenizas.‡Récupérez les Cendres d\'Arrogance et rapportez-les avec la Torche rituelle à Hargne, à la clairière des braises sur l\'île de Brume-d\'azur. N\'oubliez pas que vous pouvez utiliser l\'Orbe de retour pour vous téléporter auprès de Hargne une fois que vous aurez les cendres.‡取得赫图尔的灰烬，把它交给秘蓝岛灰烬林地中的坦普。在你得到灰烬后，可以用背包里的回归宝珠传送回坦普身边。‡取得郝特的骨骸並將它們和儀式火炬一起帶回藍謎島給餘燼林地的暴躁者。記得你拿到骨骸後就可以使用歸返寶珠傳送回暴躁者那裡。',
  }
},
[9468] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 토템‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Entregue as Cinzas do Arrogante para Tuluun no Entreposto Lazúli, que fica na Ilha Névoa Lazúli.‡Отнесите пепел Спесивца Тулууну на Лазурную заставу на острове Лазурной Дымки.‡Bringt Hauteurs Asche zu Tuluun in der Azurwacht auf der Azurmythosinsel.‡하늘안개 섬의 하늘 감시초소에 있는 툴룬에게 하우테우르의 재를 가져가야 합니다.‡Entrega las cenizas de Prepotencia a Tuluun en la Avanzada Azur en Isla Bruma Azur.‡Entrega las cenizas de Prepotencia a Tuluun en la Avanzada Azur en Isla Bruma Azur.‡Apportez les Cendres d\'Arrogance à Tuluun, au Guet d\'azur, sur l\'île de Brume-azur.‡将赫图尔的灰烬交给秘蓝岛上的碧蓝岗哨中的图伦。‡將郝特的骨骸送到藍謎島給藍色守望的塔奴藍。',
  }
},
[9469] = {
  {
    'Apoio de Barbapena‡Встреча с Перобородом‡Federbarts Unterstützung‡페더비어드의 보증‡El apoyo de Barbapluma‡El apoyo de Barbapluma‡L\'appui de Barbe-de-plumes‡羽须的认可‡羽鬚的背書',
    nil,
    'Vá até a Casa de Barbapena e faça uma visita ao anão, se ele estiver em casa. Se não, procure indícios do paradeiro dele.‡Навестите дворфа Пероборода в его лачуге. Если его нет дома, то поищите, где он может быть.‡Geht zu Federbarts Hütte und stattet dem Zwerg dort einen Besuch ab. Solltet Ihr ihn nicht dort antreffen, so sucht nach Hinweisen auf seinen Verbleib.‡페더비어드의 오두막으로 가서 그와 만나야 합니다. 만약 그가 집에 없다면 그가 있을 만한 장소를 알려 주는 물건을 찾아야 합니다.‡Ve al Cobertizo de Barbapluma y habla con el enano si está en casa. Si no está, busca alguna pista sobre dónde puede estar.‡Ve al Cobertizo de Barbapluma y habla con el enano si está en casa. Si no está, busca alguna pista sobre dónde puede estar.‡Rendez-vous au Taudis de Barbe-de-plumes et allez voir le nain s\'il est chez lui. S\'il n\'est pas là, cherchez des indices pour savoir où vous pourriez le trouver.‡前往羽须的小屋，若他在家的话，拜访他；若他不在，那么调查一下他去了哪里。‡前往羽鬚小屋，如果矮人在家的話就拜訪他。如果他不在，就看看有沒有他的線索。',
  }
},
[9470] = {
  {
    'Um gesto de boa vontade‡Жест доброй воли‡Eine Geste des guten Willens‡친선의 표시‡Un gesto de buena fe‡Un gesto de buena fe‡Un geste de bonne volonté‡善意的表示‡展示好意',
    nil,
    'O Embaixador Rualeth, no Ninho da Águia, quer que você mate o Mandingueiro Mai\'jin e a aranha de estimação dele, Tcha\'kaz.‡Убейте знахаря Май\'джина и его питомца-паука Чаказа по поручению посла Руалета с Заоблачного пика.‡Botschafter Rualeth auf dem Nistgipfel möchte, dass Ihr Hexendoktor Mai\'jin und seine Spinne Tcha\'kaz tötet.‡맹금의 봉우리에 있는 대사 루알레스가 의술사 마이진과 그의 애완 거미 트차카즈를 처치해 달라고 부탁했습니다.‡El embajador Rualeth de Pico Nidal quiere que mates al médico brujo Mai\'jin y a su mascota araña Tcha\'kaz.‡El embajador Rualeth de Pico Nidal quiere que mates al médico brujo Mai\'jin y a su mascota araña Tcha\'kaz.‡L\'ambassadeur Rualeth au Nid-de-l\'Aigle veut que vous tuiez le Féticheur Mai\'jin et son araignée familière Tcha’kaz.‡鹰巢山的鲁雷斯大使要求你杀死巫医麦金和他的蜘蛛宠物查卡斯。‡鷹巢山的洛勒斯大使要你去殺掉巫醫·梅金以及他的蜘蛛寵物恰克斯。',
  }
},
[9471] = {
  {
    'Preying on the Predators‡Охота на хищников‡Die Raubtiere zur Beute machen‡자연의 포식자‡A la caza de los depredadores‡A la caza de los depredadores‡Faire sa proie des prédateurs‡猎杀狼群‡捕食掠奪者',
    nil,
    'O Embaixador Rualeth, no Ninho da Águia, quer que você mate 10 Jubapratas Sarnentos e 5 Lobos Jubapratas.‡Убейте 10 облезлых среброгривов и 5 среброгривых волков по поручению посла Руалета с Заоблачного пика.‡Botschafter Rualeth auf dem Nistgipfel möchte, dass Ihr 10 räudige Silbermähnen und 5 Silbermähnenwölfe tötet.‡맹금의 봉우리에 있는 대사 루알레스가 병든 은빛갈기늑대 10마리, 은빛갈기늑대 5마리를 처치해 달라고 부탁했습니다.‡El embajador Rualeth de Pico Nidal quiere que mates 10 melenargentas sarnosos y 5 lobos melenargenta.‡El embajador Rualeth de Pico Nidal quiere que mates 10 melenargentas sarnosos y 5 lobos melenargenta.‡L\'ambassadeur Rualeth au Nid-de-l\'Aigle veut que vous tuiez 10 Crins-d\'argent galeux et 5 Loups Crins-d\'argent.‡鹰巢山的鲁雷斯大使要求你杀死10只癞皮银鬃狼和5只银鬃狼。‡鷹巢山的洛勒斯大使要你殺死10隻癩皮銀鬃狼和5隻銀鬃狼。',
  }
},
[9472] = {
  {
    'A amante de Arelion‡Любовница Арелиона‡Arelions Geliebte‡아렐리온의 연인‡La amante de Arelion‡La amante de Arelion‡La maîtresse d\'Arelion‡埃雷利恩的"恋人"‡阿利恩的情婦',
    nil,
    'A Magistra Carinda, na Vigília do Falcão, quer que você atraia Viera Solsurro para longe do acampamento, e então use o Pergaminho da Retaliação de Carinda nela.‡Выманите Виеру Шепот Солнца из поселения и примените к ней свиток воздаяния Каринды по приказу магистра Каринды из Соколиного дозора.‡Magistrix Carinda bei der Falkenwacht auf der Höllenfeuerhalbinsel möchte, dass Ihr Viera Sonnenwisper aus der Siedlung herauslockt und Carindas Rolle der Vergeltung auf sie anwendet.‡매의 감시탑에 있는 마법학자 카린다가 비에라 선위스퍼를 밖으로 유인한 다음, 그녀에게 카린다의 응보의 두루마리를 사용해 달라고 부탁했습니다.‡La magistrix Carinda de la Avanzada del Halcón quiere que alejes a Viera Suspirosol del asentamiento y que uses el pergamino de Reprensión de Carinda.‡La magistrix Carinda de la Avanzada del Halcón quiere que alejes a Viera Suspirosol del asentamiento y que uses el pergamino de Reprensión de Carinda.‡La magistrice Carinda, au Guet de l\'épervier, veut que vous attiriez Viera Murmesoleil hors de la ville, puis que vous utilisiez le Parchemin de vindicte de Carinda sur elle.‡猎鹰岗哨的魔导师卡尔琳达要你诱使薇拉·火语离开岗哨，然后对她使用卡尔琳达的惩戒卷轴。‡獵鷹哨站的博學者卡莉達要你引誘薇艾拉·陽語離開居住地再對她使用卡莉達的懲罰卷軸。',
  }
},
[9473] = {
  {
    'Uma alternativa à alternativa‡Другое решение‡Eine alternative Alternative‡양자택일‡La alternativa a la alternativa‡La alternativa a la alternativa‡Une tentative alternative‡备选方案的备选方案‡替代的選擇',
    nil,
    'Daedal, no Entreposto Lazúli, quer que você leve 5 Bulbos de Boca-de-leão Lazúli para ele.‡Принесите 5 луковиц лазурного львиного зева Дедалу на Лазурную заставу.‡Daedal bei der Azurwacht möchte, dass Ihr für ihn 5 Azurlöwenmäulchen sammelt.‡하늘 감시초소의 대달이 하늘금어초 뿌리 5개를 가져다 달라고 부탁했습니다.‡Daedal de la Avanzada Azur quiere que le lleves 5 bulbos de boca de dragón azur.‡Daedal de la Avanzada Azur quiere que le lleves 5 bulbos de boca de dragón azur.‡Daedal au Guet d\'azur veut que vous lui apportiez 5 Bulbes de gueules-de-loup azurées.‡碧蓝岗哨的丹达尔希望你帮他收集5株碧蓝金鱼草。‡藍色守望的爹達歐要你幫他帶來5個藍色金魚藻球莖。',
  }
},
[9474] = {
  {
    'A Marca do Arauto da Luz‡Знак Светоносного‡Das Mal des Lichtbringers‡빛의 수호자의 징표‡La marca del Iluminado‡La marca del Iluminado‡La marque du Porteur de Lumière‡光明使者的印记‡光明使者的印記',
    nil,
    'Consiga a Marca do Arauto da Luz e entregue-a para o Anacoreta Truuen no Acampamento Ventogelante, nas Terras Pestilentas Ocidentais.‡Добудьте знак Светоносного и принесите его анахорету Трууну в Лагерь Промозглого Ветра, что Западных Чумных землях.‡Besorgt das Mal des Lichtbringers und kehrt dann zu Anachoret Truuen im Zugwindlager in den westlichen Pestländern zurück.‡빛의 수호자의 징표를 되찾은 후 서부 역병지대의 서리바람 야영지에 있는 수도사 트루엔에게 돌아가야 합니다.‡Consigue la marca del Iluminado y devuélvesela al anacoreta Truuen en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Consigue la marca del Iluminado y devuélvesela al anacoreta Truuen en el Campamento del Orvallo, en las Tierras de la Peste del Oeste.‡Récupérez la Marque du Porteur de Lumière et rapportez-la à l\'anachorète Truuen au camp du Noroît, dans les Maleterres de l\'ouest.‡取得光明使者的印记，然后把它交给西瘟疫之地寒风营地的学者特卢恩。‡取得光明使者的印記帶回西瘟疫之地交給冰風營地的隱士·楚恩。',
  }
},
[9475] = {
  {
    'Retomada dos ovos‡Похищенные яйца‡Wiedererlangen der Eier‡그리핀 알‡Reclamar los huevos‡Reclamar los huevos‡La récupération des œufs‡夺回狮鹫卵‡取回那些蛋',
    nil,
    'Colete 5 Ovos de Grifo e leve tudo para o Embaixador Rualeth no Ninho da Águia.‡Соберите 5 яиц грифона и принесите их послу Руалету на Заоблачный пик.‡Erlangt 5 Greifeneier und bringt sie zu Botschafter Rualeth beim Nistgipfel.‡그리핀 알 5개를 모은 후 맹금의 봉우리에 있는 대사 루알레스에게 돌아가야 합니다.‡Recolecta 5 huevos de grifo y regresa junto al embajador Rualeth de Pico Nidal.‡Recolecta 5 huevos de grifo y regresa junto al embajador Rualeth de Pico Nidal.‡[Gather 5 Gryphon Eggs and return them to Ambassador Rualeth at Aerie Peak.]‡收集5枚狮鹫卵，然后向鹰巢山的鲁雷斯大使复命。‡收集5顆獅鷲獸的蛋帶回去給鷹巢山的洛勒斯大使。',
  }
},
[9476] = {
  {
    'Em busca de Barbapena‡В поисках Пероборода‡Suche nach Federbart‡페더비어드 추적‡En busca de Barbapluma‡En busca de Barbapluma‡À la poursuite de Barbe-de-plumes‡追踪羽须‡追蹤羽鬚',
    nil,
    'Vá até Shadra\'Alor e procure rastros de Barbapena.‡Отправляйтесь в Шадра\'Алор и поищите следы Пероборода.‡Reist nach Shadra\'Alor und sucht nach Spuren von Federbart.‡샤드라알로로 가서 페더비어드의 흔적을 찾아야 합니다.‡Ve a Shadra\'Alor y busca huellas de Barbapluma.‡Ve a Shadra\'Alor y busca huellas de Barbapluma.‡Rendez-vous à Shadra\'Alor et cherchez-y les traces de Barbe-de-plumes.‡前往沙德拉洛一带寻找羽须的踪迹。‡前往沙德拉洛尋找羽鬚的蹤跡。',
  }
},
[9483] = {
  {
    'Os maiores prazeres da vida‡Изысканные удовольствия жизни‡Die feinen Freuden im Leben‡인생의 즐거움‡Los placeres de la vida‡Los placeres de la vida‡Les plaisirs de la vie‡生命的乐趣‡生命中更棒的樂趣',
    nil,
    'Só porque estamos em peregrinação não significa que tenhamos que desistir de todos os prazeres da vida. Faz tanto tempo que eu não sei o que é um bom vinho...nnEu literalmente mataria por uma garrafa de vinho Cenariano.nnEu sei, eu sei... que deselegante de minha parte consumir uma bebida produzida pelos elfos noturnos...‡Мы, конечно, отправились в паломничество, но это вовсе не значит, надо отказываться от всех радостей жизни. Кажется, прошло столетие с той поры, как я пробовала хорошее вино.nnДа за бутылку кенарийского настойки я и убить могу!nnЗнаю, знаю, я очень опустилась, если готова пить вино ночных эльфов.‡Nur weil wir auf dieser Pilgerfahrt sind, heißt das noch lange nicht, dass wir alle Freuden im Leben aufgeben müssen. Ich hatte schon seit Ewigkeiten keinen guten Wein mehr.nnIch könnte im wahrsten Sinne des Wortes für einen gute Flasche Cenarischer Geistertropfen töten!nnIch weiß, ich weiß, wie unpassend von mir, ein Nachtelfengebräu zu genießen.‡‡No por estar de peregrinación tenemos que renunciar a todo. Hace siglos que no me tomo un buen vino.nn¡Mataría por una botella de licor Cenarion!nnSí, ya sé que no queda bien que me guste una especialidad de los elfos de la noche.‡‡‡‡',
  }
},
[9484] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Falcodrago Enlouquecido. Depois, fale novamente com a Tenente Correalba.‡Приручите безумного дракондора с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Рассвета.‡Verwendet die Zähmerrute, um einen wahnsinnigen Drachenfalken zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 광포한 용매를 길들인 후 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un dracohalcón enloquecido y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un dracohalcón enloquecido y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser un Faucon-dragon affolé, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只疯狂的龙鹰，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服瘋狂的龍鷹，然後再回到晨奔中尉那裡。',
  }
},
[9485] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Brumorcego. Depois, fale novamente com a Tenente Correalba.‡Приручите мрачницу с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Рассвета.‡Verwendet die Zähmerrute, um eine Nebelfledermaus zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 안개박쥐를 길들인 다음 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un murciélago brumoso y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un murciélago brumoso y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser une Brumoptère, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只迷雾蝠，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服迷霧蝙蝠，然後再回到晨奔中尉那裡。',
  }
},
[9486] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Garrataque Ancião. Depois, fale novamente com a Tenente Correalba.‡Приручите взрослого прыголапа с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Рассвета.‡Verwendet die Zähmerrute, um eine alte Bachtatze zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 덩치큰 갈기발 스라소니를 길들인 다음 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un garragil mayor y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un garragil anciano y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser un Ancien Preste-patte, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只老魔泉豹，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服年長的泉爪山貓，然後再回到晨奔中尉那裡。',
  }
},
[9487] = {
  {
    'Aniquiladores arcanos‡Волшебные разорители‡Arkanhäscher‡비전 약탈자‡Atracadores Arcanos‡Atracadores Arcanos‡Les saccageurs des arcanes‡奥术掠夺者‡',
    nil,
    'O Arcanista Vandril quer que você colete 10 Fragmentos Arcanos para ele.‡Чародей Вандрил хочет, чтобы вы принесли ему 10 осколков тайной магии.‡Arkanist Vandril möchte, dass Ihr 10 Arkantrümmer für ihn sammelt.‡비전술사 반드릴이 비전 조각 10개를 모아달라고 합니다.‡El arcanista Vandril quiere que reúnas 10 fragmentos arcanos para él.‡El arcanista Vandril quiere que reúnas 10 fragmentos arcanos para él.‡L\'arcaniste Vandril veut que vous récupériez 10 Fragments arcaniques pour son compte.‡奥术师范迪瑞尔要你为他收集10块奥术残片。‡',
  }
},
[9488] = {
  {
    'Um robe simples‡Простое одеяние‡Eine einfache Robe‡간단한 로브‡Una toga sencilla‡Una toga sencilla‡Une robe simple‡简单的长袍‡',
    nil,
    'O Arcanista Vandril quer que você leve 15 Pedaços de Linho e uma Glândula de Seda de Fusaracna.‡Чародей Вандрил хочет, чтобы вы принесли ему 15 кусков льняной ткани и паутинную железу паука-прядильщика.‡Arkanist Vandril möchte, dass Ihr ihm 15 Leinenstoff und eine Seidendrüse der Spindelweber bringt.‡비전술사 반드릴이 리넨 옷감 15개, 물레그물 분비선 1개를 모아달라고 부탁했습니다.‡El arcanista Vandril quiere que le lleves 15 piezas de paño de lino y 1 glándula de seda de husaraña.‡El arcanista Vandril quiere que le lleves 15 piezas de paño de lino y 1 glándula de seda de husaraña.‡L\'arcaniste Vandril a besoin de 15 Étoffes de lin et d’une Glande à soie de filetoile.‡将15张亚麻布和1个纺丝蜘蛛的丝囊交给奥术师范迪瑞尔。‡',
  }
},
[9489] = {
  {
    'Purificando a trilha‡Поднять боевой дух‡Ordnung in der Schneise‡흉터 치유‡Limpiar La Cicatriz‡Limpiar La Cicatriz‡Purifier la Malebrèche‡清理死亡之痕‡',
    nil,
    'Lance Palavra de Poder: Fortitude em 6 Patrulheiros de Canto Eterno na Trilha da Morte.‡Примените "Слово Силы: Стойкость" к 6 следопытам из лесов Вечной Песни на Тропе Мертвых.‡Wirkt das Machtwort: Seelenstärke auf 6 Waldläufer von Immersang in der Todesschneise.‡죽음의 흉터에 있는 영원노래 순찰자 6명에게 신의 권능: 인내를 시전해야 합니다.‡Lanza Palabra de poder: entereza a 6 forestales Canción Eterna en La Cicatriz Muerta.‡Lanza Palabra de poder: entereza a 6 forestales Canción Eterna en La Cicatriz Muerta.‡Lancez Prière de Robustesse sur 6 Forestiers des Chants éternels dans la Malebrèche.‡对死亡之痕的6个永歌游侠施放真言术：韧。‡',
  }
},
[9490] = {
  {
    'A matriarca esfola-pedra‡Матриарх камнедеров‡Die Felsklauenmatriarchin‡이칸의 복수‡La matriarca despellejadora de roca‡La matriarca despellejadora de roca‡La matriarche des écorche-roc‡剥石者的女王‡岩石鐮奪怪女王',
    nil,
    'Obtenha as Garras de Garranegra, a Selvagem, na Grande Fenda, e leve-a para Ikan, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Добудьте когти Свирепой Черноскребки, которая обитает в Глубоком Разломе и принесите их Икану в храм Телхамат на полуострове Адского Пламени.‡Besorgt Schwarzkralles Klauen von Schwarzkralle der Wilden in der großen Kluft und bringt sie zu Ikan beim Tempel von Telhamat auf der Höllenfeuerhalbinsel.‡거대한 균열에 있는 흉포한 검은갈퀴의 발톱을 지니고, 지옥불 반도의 텔하마트 사원에 있는 이칸에게 가져가야 합니다.‡Consigue una garra de Garranegra la Indómita en La Gran Fisura y llévasela a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Consigue las garras de Garfanegra la Indómita en La Gran Fisura y llévasela a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Prenez les Griffes de Griffe-noire la Sauvage dans la Grande fissure et remettez-les à Ikan, au temple de Telhamat la Péninsule des flammes infernales.‡前往大裂隙杀死凶猛的黑色利爪，将黑色利爪的爪子交给地狱火半岛塔哈玛特神殿的伊坎。‡從大裂縫的『野蠻者』黑爪身上取得黑爪之爪，將它帶回地獄火半島給特爾哈曼神廟的依坎。',
  }
},
[9491] = {
  {
    'Greed‡Не откажусь‡Gier‡욕심‡Avaricia‡Avaricia‡Cupidité‡贪婪‡貪婪',
    nil,
    'Eralan, em Tranquillien, quer que você recupere o Elo Coberto de Ouro das Catacumbas Amani.‡Эраланна из Транквиллиона хочет, чтобы вы добыли исцарапанное золотое кольцо из катакомб Амани.‡Eralan in Tristessa möchte, dass Ihr ihr einen gekörnten Goldring aus den Amanikatakomben bringt.‡트랜퀼리엔에 있는 에랄란이 아마니 지하묘지에서 흠집 난 금반지를 구해오라고 부탁했습니다.‡Eralan de Tranquillien quiere que encuentres el anillo de oro marcado en las Catacumbas Amani.‡Eralan de Tranquillien quiere que encuentres el anillo de oro marcado en las Catacumbas Amani.‡Erelan, à Tranquillien, veut que vous retrouviez la Bague ébréchée en or dans les catacombes des Amani.‡前往阿曼尼墓穴取回陪葬的金戒指，然后向塔奎林的艾拉兰复命。‡安寧地的依蘭兒要你從阿曼尼地下墓穴取回缺口金指環。',
  }
},
[9492] = {
  {
    'Virando o jogo‡Новый поворот событий‡Das Schicksal wenden‡전황의 변화‡Girando las tornas‡Girando las tornas‡L\'heure du tournant‡扭转战局‡扭轉情勢',
    nil,
    'Leve o punho do Chefe Guerreiro Karrath ao Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Принесите кулак вождя Каргата боевому командиру Данату Троллебою в Оплот Чести.‡Bringt Kriegshäuptling Kargaths Faust zu Truppenkommandant Danath Trollbann in der Ehrenfeste.‡명예의 요새에 있는 전투사령관 다나스 트롤베인에게 대족장 카르가스의 주먹을 가져가야 합니다.‡Lleva el puño del jefe de guerra Kargath al Comandante en Jefe Danath Aterratrols al Bastión del Honor.‡Lleva el puño del Jefe de Guerra Kargath al comandante en jefe Danath Aterratrols al Bastión del Honor.‡Apportez le Poing du chef de guerre Kargath au commandant Danath Trollemort, au Bastion de l\'Honneur.‡将卡加斯酋长之拳交给荣耀堡的远征军指挥官达纳斯·托尔贝恩。‡把大酋長卡加斯之手帶給榮譽堡的軍隊指揮者達納斯·托爾貝恩。',
  }
},
[9493] = {
  {
    'Orgulho da Horda Vil‡Элита Орды Скверны‡Der Stolz der Höllenhorde‡타락한 호드의 자랑‡El orgullo de la Horda vil‡El orgullo de la Horda vil‡L\'orgueil de la Gangr\'horde‡邪部落的荣耀‡魔獄部落的驕傲',
    nil,
    'O Comandante de Campo Rômulo na Fortaleza da Honra quer que você mate 8 Legionários, 4 Centuriões e 4 Campeões da Mão Despedaçada.‡Убейте 8 легионеров клана Изувеченной Длани, 4 центуриона клана Изувеченной Длани и 4 воителей клана Изувеченной Длани по приказу боевого командира Ромуса из Оплота Чести.‡Feldkommandeur Romus in der Ehrenfeste möchte, dass Ihr 8 Legionäre der Zerschmetterten Hand, 4 Zenturios der Zerschmetterten Hand und 4 Champions der Zerschmetterten Hand tötet.‡명예의 요새에 있는 야전사령관 로무스가 으스러진 손의 군단병 8명, 으스러진 손의 백인대장과 용사를 각각 4명씩 처치해 달라고 부탁했습니다.‡El comandante de campo Romus del Bastión del Honor quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 campeones Mano Destrozada.‡El comandante de operaciones Romus del Bastión del Honor quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 campeones Mano Destrozada.‡Le commandant Romus du Bastion de l\'Honneur veut que vous alliez tuer 8 Légionnaires de la Main brisée, 4 Centurions de la Main brisée et 4 Champions de la Main brisée.‡荣耀堡的战地指挥官洛姆斯要求你杀死8名碎手军团士兵、4名碎手百夫长和4名碎手勇士。‡榮譽堡的戰場元帥洛摩斯要你殺死8個破碎之手軍團士兵，4個破碎之手百夫長，和4個破碎之手勇士。',
  }
},
[9494] = {
  {
    'Brasas vis‡Угли Скверны‡Teufelsglut‡지옥의 불씨‡Ascuas viles‡Ascuas viles‡Les gangrebraises‡邪能灰烬‡魔化餘燼',
    nil,
    'Magus Zabraxis na Fortaleza da Honra precisa que você leve uma Brasa Vil para ela.‡Принесите уголь Скверны волхву Забраксис из Оплота Чести.‡Magus Zabraxis in der Ehrenfeste möchte, dass Ihr ihr ein Stück Teufelsglut bringt.‡명예의 요새에 있는 대학자 자브라시스가 지옥의 불씨를 가져다 달라고 부탁했습니다.‡La magus Zabraxis del Bastión del Honor quiere que le lleves ascuas viles.‡La magus Zabraxis del Bastión del Honor quiere que le lleves ascuas viles.‡Le magus Zabraxis du Bastion de l\'Honneur veut que vous lui rapportiez une Gangrebraise.‡荣耀堡的大法师萨布兰希要求你给她带回一块邪能灰烬。‡榮譽堡的魔導師薩柏瑞希斯要你幫她帶來一份魔化餘燼。',
  }
},
[9495] = {
  {
    'A vontade do Chefe Guerreiro‡Воля Вождя‡Der Wille des Kriegshäuptlings‡The Will of the Warchief‡La voluntad del Jefe de Guerra‡La voluntad del Jefe de Guerra‡La volonté du Chef de guerre‡酋长的意志‡酋長的希望',
    nil,
    'Leve o Punho do Chefe Guerreiro Karrath para Nazgrel, em Thrallmar.‡Принесите Кулак Вождя Каргата Назгрелу в Траллмар.‡Bringt Kriegshäuptling Kargaths Faust zu Nazgrel in Thrallmar.‡Bring Warchief Kargath\'s Fist to Nazgrel in Thrallmar.‡Lleva el puño del Jefe de Guerra Kargath a Nazgrel a Thrallmar.‡Lleva el puño del Jefe de Guerra Kargath a Nazgrel a Thrallmar.‡Nazgrel à Thrallmar veut que vous lui rameniez le Poing du chef de guerre Kargath.‡将卡加斯酋长之拳交给萨尔玛的纳兹格雷尔。‡把大酋長卡加斯之手帶給索爾瑪的納茲格雷爾。',
  }
},
[9496] = {
  {
    'Orgulho da Horda Vil‡Элита Орды Скверны‡Der Stolz der Höllenhorde‡Pride of the Fel Horde‡El orgullo de la Horda vil‡El orgullo de la Horda vil‡L\'orgueil de la Gangr\'horde‡邪部落的荣耀‡魔獄部落的驕傲',
    nil,
    'O Caçador Sombrio Ty\'jin, em Thrallmar, quer que você mate 8 Legionários da Mão Despedaçada, 4 Centuriões da Mão Despedaçada e 4 Campeões da Mão Despedaçada.‡Убейте 8 легионеров клана Изувеченной Длани, 4 центуриона клана Изувеченной Длани и 4 воителей из клана Изувеченной Длани по приказу темного охотника Туджина из Траллмара.‡Schattenjäger Ty\'jin in Thrallmar möchte, dass Ihr 8 Legionäre der Zerschmetterten Hand, 4 Zenturios der Zerschmetterten Hand und 4 Champions der Zerschmetterten Hand tötet.‡Shadow Hunter Ty\'jin at Thrallmar wants you to kill 8 Shattered Hand Legionnaires, 4 Shattered Hand Centurions, and 4 Shattered Hand Champions.‡El cazador de las Sombras Ty\'jin de Thrallmar quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 Campeones Mano Destrozada.‡El cazador de las Sombras Ty\'jin de Thrallmar quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 Campeones Mano Destrozada.‡Le chasseur des ombres Ty\'jin, de Thrallmar, veut que vous tuiez 8 Légionnaires de la Main brisée, 4 Centurions de la Main brisée et 4 Champions de la Main brisée.‡萨尔玛的暗影猎手塔金要求你杀死8名碎手军团士兵、4名碎手百夫长和4名碎手勇士。‡索爾瑪的影子獵人泰巾要你殺死8個破碎之手軍團士兵，4個破碎之手百夫長，和4個破碎之手勇士。',
  }
},
[9498] = {
  {
    'Vigília do Falcão‡Соколиный дозор‡Falkenwacht‡매의 감시탑‡La Avanzada del Halcón‡La Avanzada del Halcón‡Le Guet de l\'épervier‡猎鹰岗哨‡獵鷹哨站',
    nil,
    'Apresente-se ao Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, na Península Fogo do Inferno.‡Доложитесь капитану следопытов Венн\'рену в Соколином дозоре на полуострове Адского Пламени.‡Meldet Euch bei Waldläuferhauptmann Venn\'ren bei der Falkenwacht auf der Höllenfeuerhalbinsel.‡지옥불 반도의 매의 감시탑에 있는 순찰대장 벤렌에게 보고해야 합니다.‡Preséntate ante el capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Preséntate ante el capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Présentez-vous au capitaine des forestiers Venn\'ren au Guet de l\'épervier de la péninsule des Flammes infernales.‡前往地狱火半岛的猎鹰岗哨，向游侠队长维恩雷报到。‡到地獄火半島向獵鷹哨站的遊俠隊長范瑞報告。',
  }
},
[9499] = {
  {
    'Vigília do Falcão‡Соколиный дозор‡Falkenwacht‡매의 감시탑‡La Avanzada del Halcón‡La Avanzada del Halcón‡Le Guet de l\'épervier‡猎鹰岗哨‡獵鷹哨站',
    nil,
    'Vá para a Vigília do Falcão, no sudoeste da Península Fogo do Inferno, e apresente-se ao Capitão-patrulheiro Venn\'ren.‡Отправляйтесь в Соколиный дозор, на юго-запад полуострова Адского Пламени, и поговорите с капитаном следопытов Венн\'реном.‡Reist zur Falkenwacht im Südwesten der Höllenfeuerhalbinsel und meldet Euch bei Waldläuferhauptmann Venn\'ren.‡지옥불 반도의 남서쪽에 있는 매의 감시탑으로 간 후 순찰대장 벤렌에게 보고해야 합니다.‡Ve a la Avanzada del Halcón al suroeste de la Península del Fuego Infernal y preséntate ante el capitán forestal Venn\'ren.‡Ve a la Avanzada del Halcón al suroeste de la Península del Fuego Infernal y preséntate ante el capitán forestal Venn\'ren.‡Rendez-vous au Guet de l\'épervier au sud-ouest de la péninsule des Flammes infernales et présentez-vous au capitaine des forestiers Venn\'ren.‡前往地狱火半岛西南方的猎鹰岗哨，向游侠队长维恩雷报到。‡前往地獄火半島西南方的獵鷹哨站並向遊俠隊長范瑞報告。',
  }
},
[9500] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Найдите на острове Лазурной Дымки в Кристальном зале Экзодара предсказателя Нобундо и поговорите с ним.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르의 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达内水晶大厅的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9501] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com Aquos no Recife Oculto da Ilha Névoa Rubra.‡Найдите Водяницу у Подводного Рифа возле острова Кровавой Дымки и поговорите с ней.‡Sprecht mit Aqueous im versteckten Riff bei der Blutmythosinsel.‡핏빛안개 섬의 숨은 산호초에 있는 아쿠에어스와 대화해야 합니다.‡Ve a El Arrecife Oculto, en la Isla Bruma de Sangre, y habla con Acuosa‡Ve a El Arrecife Oculto, en la Isla Bruma de Sangre, y habla con Acuosa.‡Parlez à Aqueuse, à l’intérieur du Récif caché, près de l’île de Brume-sang.‡与秘血岛藏帆暗礁的阿奎欧斯谈一谈。‡到血謎島的隱秘沙洲和阿基歐斯談談。',
  }
},
[9502] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Найдите на острове Лазурной Дымки в Кристальном зале Экзодара предсказателя Нобундо и поговорите с ним.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达内水晶大厅的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9503] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Colete 6 Essências Pútridas e leve tudo para Aquos, no Recife Oculto da Ilha Névoa Rubra.‡Принесите 6 бутылочек смрадной эссенции на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте Водянице.‡Sammelt 6 besudelte Essenzen ein und bringt sie zu Aqueous im versteckten Riff bei der Blutmythosinsel.‡부정의 정수를 6개를 모은 후 핏빛안개 섬 근처의 숨은 산호초에 있는 아쿠에어스에게 돌아가야 합니다.‡Reúne 6 viales de esencia hedionda y llévaselas a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Reúne 6 viales de esencia hedionda y llévaselas a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Récupérer 6 Essences infectes et les remettre à Aqueuse, au Récif caché, près de l’île de Brume-sang.‡收集6份邪恶精华，把它们交给秘血岛藏帆暗礁的阿奎欧斯。‡收集6份腐敗精華再帶回血謎島給隱秘沙洲的阿基歐斯。',
  }
},
[9504] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del Agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Rústico Vazio e volte até Aquos no Recife Oculto da Ilha Névoa Rubra.‡Наполните пустой бурдюк, а затем вернитесь на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте бурдюк Водянице.‡Füllt den leeren Botabeutel und kehrt anschließend zu Aqueous im versteckten Riff bei der Blutmythosinsel zurück.‡빈 물주머니를 채운 후 핏빛안개 섬 근처의 숨은 산호초에 있는 아쿠에어스에게로 돌아가야 합니다.‡Llena la bota y llévasela a Acuosa a El Arrecife Oculto en la Isla Bruma de Sangre.‡Llena la bota y llévasela a Acuosa a El Arrecife Oculto en la Isla Bruma de Sangre.‡Remplir la Gourde en peau vide et retourner voir Aqueuse, au Récif caché, près de l’île de Brume-sang.‡将水注满空的波涛之袋，然后把它交给秘血岛藏帆暗礁的阿奎欧斯。‡裝滿空皮製水袋再回到血謎島的隱秘沙洲找阿基歐斯。',
  }
},
[9505] = {
  {
    'A profecia de Velen‡Пророчество Велена‡Die Prophezeiung von Velen‡벨렌의 예언‡La profecía de Velen‡La profecía de Velen‡La prophétie de Velen‡维伦的预言‡費倫的預言',
    nil,
    'Daedal quer que você viaje para o sul e que procure as pessoas que a criatura ferida mencionou.‡Отправляйтесь на юг и отыщите народ, о котором говорило раненое существо.‡Daedal möchte, dass Ihr nach Süden reist und die Personen aufsucht, von denen das verletzte Wesen gesprochen hat.‡대달이 남쪽으로 가서 앞서 말한 부상당한 존재의 동족을 찾아달라고 부탁했습니다.‡Daedal quiere que vayas hacia el sur y busques al pueblo que mencionó la criatura herida.‡Daedal quiere que vayas hacia el sur y busques al pueblo que mencionó la criatura herida.‡Daedal veut que vous alliez au sud, à la recherche des gens mentionnés par la créature blessée.‡丹达尔希望你到南方去寻找这个受伤的生物提到的人。‡爹達歐要你前往南方找到受傷的生物提到的人們。',
  }
},
[9506] = {
  {
    'Um pequeno começo‡Начало положено‡Ein kleiner Anfang‡연합의 시작‡Un pequeño susto‡Un pequeño susto‡Il faut bien commencer quelque part‡第三类接触‡一個小開始',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, quer que você recupere a Bússola Náutica e o Mapa Náutico roubados pela Empreendimentos S.A.‡Верните адмиралу Одиссию морской компас и морскую карту, украденные Торговой компанией.‡Admiral Odesyus bei Odesyus\' Ankerplatz möchte, dass Ihr den von der Venture Co. gestohlenen nautischen Kompass und die nautische Karte wiederbeschafft.‡오디시우스의 정박지의 제독 오디시우스가 투자개발회사에 빼앗긴 항해용 나침반과 항해 지도를 되찾아 달라고 부탁했습니다.‡El almirante Odesyus del Desembarco de Odesyus quiere que recuperes la rosa náutica y el mapa náutico robados por Ventura y Cía.‡El almirante Odesyus del Desembarco de Odesyus quiere que recuperes la brújula marina y el mapa náutico robados por Ventura y Cía.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus, veut que vous récupériez le Compas de marine et la Carte nautique volés par la KapitalRisk.‡奥德修斯营地的海军上将奥德修斯希望你能夺回被风险投资公司偷走的航海罗盘和航海图。‡奧迪席斯平臺的艦隊司令·奧迪席斯要你取回被風險投資公司偷走的航海指南針和航海地圖。',
  }
},
[9508] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve a Cabeça de Tel\'athion para Aquos no Recife Oculto da Ilha Névoa Rubra.‡Принесите голову Телатиона на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте Водянице.‡Bringt Tel\'athions Kopf zu Aqueous im versteckten Riff bei der Blutmythosinsel zurück.‡핏빛안개 섬의 숨은 산호초에 있는 아쿠에어스에게 텔아시온을 죽인 증거를 가져가야 합니다.‡Lleva la cabeza de Tel\'athion a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre‡Lleva la cabeza de Tel\'athion a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Apportez la Tête de Tel\'athion à Aqueuse, du récif caché près de l\'île de Brume-sang.‡将塔希恩的头颅交给秘血岛藏帆暗礁的阿奎欧斯。‡把泰阿希恩的頭顱帶到血謎島給隱秘沙洲的阿基歐斯。',
  }
},
[9509] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve o Frasco da Mais Pura Água para o Clarividente Nobambo na Exodar, na Ilha Névoa Lazúli.‡Отнесите флакон чистейшей воды предсказателю Нобундо. Его можно найти на острове Лазурной Дымки в Экзодаре.‡Nehmt das Fläschchen mit reinstem Wasser zu Weissager Nobundo innerhalb der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 안에 있는 선견자 노분도에게 순수한 물이 든 병을 가져가야 합니다.‡Llévale el frasco del agua más pura al clarividente Nobundo en El Exodar, en la Isla Bruma Azur.‡Llévale el frasco del agua más pura al clarividente Nobundo en El Exodar, en la Isla Bruma Azur.‡Remettez la Flasque de l\'eau la plus pure au long-voyant Nobundo à l’intérieur de l’Exodar sur l’île de Brume-azur.‡将纯水之瓶交给秘蓝岛埃索达的预言者努波顿。‡把純淨水瓶帶回藍謎島給艾克索達的先知諾柏多。',
  }
},
[9510] = {
  {
    'Bristlehide Clefthoof Hides‡Шкура щетинистого копытня‡Bälge eines borstigen Grollhufs‡‡Pellejos de uñagrieta lomohirsuto‡‡Les peaux de sabots-fourchus poil-hirsute‡‡',
    nil,
    'Provisioner Braknar at Mag\'har Post in Hellfire Peninsula wants you to bring him 5 Bristlehide Clefthoof Hides.‡Добудьте 5 шкур щетинистого копытня по просьбе поставщика Бракнара с Заставы маг\'харов на Полуострове Адского Пламени.‡Versorger Braknar beim Mag\'harposten auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 5 Bälge eines borstigen Grollhufs bringt.‡‡El proveedor Braknar del Puesto Mag\'har, en la Península del Fuego Infernal, quiere que le lleves 5 pellejos de uñagrieta lomohirsuto.‡El proveedor Braknar del Puesto Mag\'har, en la Península del Fuego Infernal, quiere que le lleves 5 pellejos de uñagrieta lomohirsuto.‡L’approvisionneur Braknar au poste de Mag\'har dans la péninsule des Flammes infernales veut que vous lui rameniez 5 Peaux de sabots-fourchus poil-hirsute.‡‡',
  }
},
[9511] = {
  {
    'Kargath\'s Battle Plans‡Боевые планы Каргата‡Kargaths Schlachtpläne‡카르가스의 전투 계획서‡Los planes de guerra de Kargath‡‡Les plans de bataille de Kargath‡Kargath\'s Battle Plans‡卡加斯的戰鬥計畫書',
    nil,
    nil,
  }
},
[9512] = {
  {
    'Risoto do "Cuca"‡Крабовый супчик поваренка‡Kräckas Jumboeintopf‡쿠키의 세숫대야 스프‡El jumbo gumbo de Cocinitas‡El jumbo gumbo de Cocinitas‡Jumbo gumbo du cuistot‡曲奇的大餐‡廚師的特大燴肉',
    nil,
    '"Cuca" MacMolhofraco, no Assentamento de Odisseu, quer que você lhe traga 6 unidades de Carne de Estalatisco.‡Принесите 6 кусков мяса шустрых крабов "Поваренку" Максоусу в лагерь Одиссия.‡"Kräcka" Aschebäscha bei Odesyus\' Ankerplatz möchte, dass Ihr ihm 6 Stücke Raubkriecherfleisch bringt.‡오디시우스의 정박지의 "쿠키" 맥위크소스가 땅거미 게살 6개를 가져다 달라고 부탁했습니다.‡"Cocinitas" MacSalsafloja en Desembarco de Odesyus quiere que le lleves 6 piezas de carne de reptador sigiloso.‡"Cocinitas" MacSalsafloja en Desembarco de Odesyus quiere que le lleves 6 piezas de carne de reptador sigiloso.|n‡« Cuistot » McFadesauce, au Point d\'accostage d\'Odesyus, veut que vous lui rapportiez 6 Chairs de clampant grouillant.‡奥德修斯营地的"曲奇"米维克索斯要你给他带回6块迅捷螃蟹的肉。‡奧迪席斯平臺的『小廚』麥克威醬要你幫他帶來6塊滑膩的爬行者肉。',
  }
},
[9513] = {
  {
    'A reconquista das ruínas‡Возвращение руин‡Die Rückeroberung der Ruinen‡폐허 수복‡Recuperar las ruinas‡Recuperar las ruinas‡Reconquérir les ruines‡夺回废墟‡奪回廢墟',
    nil,
    'A Sacerdotisa Cailin Il\'dinero, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você mate 5 Mirmidões Escamódio, 5 Nagas Escamódio e 5 Sirenas Escamódio.‡Убейте 5 мирмидонов, 5 наг и 5 сирен из клана Зловещей Чешуи для жрицы Кайлин Ил\'динар.‡Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr 5 Myrmidonen der Hasspranken, 5 Naga der Hasspranken und 5 Sirenen der Hasspranken tötet.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레가 성난비늘일족 미르미돈, 성난비늘일족 나가, 성난비늘일족 세이렌을 각각 5마리씩 처치해 달라고 부탁했습니다.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que mates 5 mirmidones Escama de Cólera, 5 nagas Escama de Cólera y 5 sirenas Escama de Cólera.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que mates 5 mirmidones Escama de Cólera, 5 nagas Escama de Cólera y 5 sirenas Escama de Cólera.‡La Prêtresse Kyleen Il\'dinare, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous tuiez 5 Myrmidons Irécaille, 5 Nagas Irécaille et 5 Sirènes Irécaille.‡秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜要求你杀死5只怒鳞侍从、5只怒鳞纳迦和5只怒鳞海妖。‡藍謎島，奧迪席斯平臺的女牧師凱玲·伊丹奈爾要你殺死5個怒鱗侍從、5個怒鱗納迦和5個怒鱗海妖。',
  }
},
[9514] = {
  {
    'A tabuleta coberta de runas‡Покрытая рунами табличка‡Runenbesetzte Schrifttafel‡룬문자 휘장‡Tablilla cubierta de runas‡Tablilla cubierta de runas‡Tablette couverte de runes‡写满符文的石板‡符文雕飾石板',
    nil,
    'Leve a Tabuleta Coberta de Runas à Sacerdotisa Cailin Il\'dinero no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli.‡Отнеcите покрытую рунами табличку жрице Кайлин Ил\'динар в лагерь Одиссия на острове Лазурной Дымки.‡Bringt die runenbesetzte Schrifttafel zu Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레에게 룬문자 휘장을 가져가야 합니다.‡Llévale la tablilla cubierta de runas a la sacerdotisa Kyleen Il\'dinare a Desembarco de Odesyus en Isla Bruma Azur.|n‡Llévale la tablilla cubierta de runas a la sacerdotisa Kyleen Il\'dinare a Desembarco de Odesyus en Isla Bruma Azur.|n‡Apportez la Tablette couverte de runes à la Prêtresse Kyleen Il\'dinare au Point d\'accostage d\'Odesyus, sur l\'île de Brume-azur.‡将写满符文的石板交给秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜。‡把符文雕飾石板帶到藍謎島給奧迪席斯平臺的女牧師凱玲·伊丹奈爾。',
  }
},
[9515] = {
  {
    'O senhor da guerra Sriss\'tiz‡Полководец Шрисс\'тиз‡Kriegsherr Sriss\'tiz‡장군 스리스티즈 처치‡El Señor de la Guerra Sriss\'tiz‡Señor de la guerra Sriss\'tiz‡Le seigneur de guerre Sriss\'tiz‡督军斯雷提兹‡督軍司瑞史提斯',
    nil,
    'A Sacerdotisa Cailin Il\'dinero, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você mate o Senhor da Guerra Sriss\'tiz.‡Жрица Кайлин Ил\'динар из лагеря Одиссия попросила вас убить полководца Шрисс\'тиза.‡Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr Kriegsherr Sriss\'tiz tötet.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레가 장군 스리스티즈를 처치해 달라고 부탁했습니다.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que mates al Señor de la Guerra Sriss\'tiz.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus en la Isla Bruma Azur quiere que mates al señor de la guerra Sriss\'tiz.‡La Prêtresse Kyleen Il\'dinare, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous tuiez le chef de guerre Sriss\'tiz.‡秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜要求你杀死督军斯雷提兹。‡藍謎島，奧迪席斯平臺的女牧師凱玲·伊丹奈爾要你殺了督軍司瑞史提斯。',
  }
},
[9516] = {
  {
    'Destroy the Legion‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruye a la Legión‡Destruye a la Legión‡Détruire la Légion‡毁灭燃烧军团‡摧毀軍團',
    nil,
    'Mate 6 Açoitadeiras Mannoroth, 6 Guardas Vis e 6 Infernais Abrasadores. Depois, fale novamente com o Vindicante Vedaar na Cantilenda, que fica no Vale Gris.‡Уничтожьте 6 бичевательниц Маннорока, 6 стражей Скверны и 6 опаляющих инферналов, а затем вернитесь к воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Tötet 6 Mannorocpeitscher, 6 Teufelswachen und 6 Sengende Höllenbestien und kehrt dann zu Verteidiger Vedaar in Waldeslied im Eschental zurück.‡만노로크 채찍마녀 6명, 떠도는 지옥군단병 6명, 불타는 지옥불정령 6마리를 처치한 후, 잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 돌아가야 합니다.‡Mata 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Mata a 15 demonios en Cerro Lumbrevil, en Barranco del Demonio y en Cresta del Demonio.‡Tuez 15 démons de n’importe quel type sur la Colline Gangrefeu, dans le Canyon de la Malechute et sur la Crête de la Malechute.‡杀死6个玛诺洛克鞭笞者、6个恶魔守卫和6个灼热的地狱火，然后向灰谷林歌神殿的守备官维达尔复命。‡殺死6個瑪諾洛克鞭笞者，6個惡魔守衛，和6個灼熱的地獄火，再回到梣谷的林歌神殿找復仇者維達。',
  }
},
[9517] = {
  {
    'A Shameful Waste‡Напрасные усилия‡Eine schändliche Verschwendung‡숲의 파괴‡¡Sería una lástima desperdiciarlo!‡¡Sería una lástima desperdiciarlo!‡Un gaspillage honteux‡可耻的浪费‡可恥的浪費',
    nil,
    'Leve 15 Tábuas dos Brado Guerreiro e 5 Madeiras Vis de Satyrnaar para Nodoso em Cantilenda.‡Доставьте 15 связок древесины Песни Войны и 5 связок оскверненной древесины Сатирнаара Кривокрону в Лесную Песнь.‡Bringt 15 Stück Holz des Kriegshymnenklans und 5 Stück verdorbenes Satyrnaarholz zu Knorre in Waldeslied.‡숲의 노래에 있는 그날에게 전쟁노래부족 목재 15개, 사티르나르의 오염된 목재 5개를 가져가야 합니다.‡Llévale 15 piezas de madera Grito de Guerra y 5 piezas de madera vil de Satyrnaar a Gnarl a la Canción del Bosque.‡Reúne 5 trozos de madera vil de Satyrnaar.‡Rassemblez 5 fagots de Bois gangrené de Satyrnaar.‡将15块战歌木材和5块萨提纳尔木材交给林歌神殿的纳亚尔。‡帶15塊戰歌林材和5塊薩提納爾地獄木頭給林歌神殿的格納。',
  }
},
[9518] = {
  {
    'Agents of Destruction‡Пособники разрушения‡Agenten der Zerstörung‡파괴 요원‡Agentes de destrucción‡Agentes de destrucción‡Les agents de la destruction‡毁灭的使者‡毀滅間諜',
    nil,
    'A Sentinela Luciel Sussurrastra, em Cantilenda, quer que você mate o Feitor Gorthak, 2 Retalhadores do Brado Guerreiro, 5 Desflorestadoras da Horda e 10 Batedores da Horda.‡Часовая Люсьель Шепот Звезд из Лесной Песни хочет, чтобы вы убили надзирателя Гортака, 2 пилотов крошшеров клана Песни Войны, 5 ордынских лесозаготовителей и 10 ордынских разведчиков.‡Schildwache Luciel Sternwisper in Waldeslied möchte, dass Ihr Vorarbeiter Gorthak, 2 Schredder des Kriegshymnenklans, 5 Roder der Horde und 10 Späher der Horde tötet.‡숲의 노래에 있는 파수꾼 루시엘 스타위스퍼가 감독관 고르닥, 전쟁노래부족 벌목기 2개, 호드 벌채꾼 5명, 호드 정찰병 10명을 처치해 달라고 부탁했습니다.‡La centinela Luciel Susurrestelar de Canción del Bosque quiere que mates al sobrestante Gorthak, 2 machacadores Grito de Guerra, 5 deforestadores de la Horda y 10 exploradores de la Horda.‡Mata al sobrestante Gorthak y a otros 12 miembros de la Horda en el Aserradero Grito de Guerra.‡Tuez le Surveillant Gorthak et 12 autres membres de la Horde du Camp de bûcherons Chanteguerre.‡林歌神殿的哨兵卢希尔·星语要求你杀死监工古尔萨克、2台战歌伐木机、5名部落伐木工和10名部落斥候。‡林歌神殿的哨兵露西歐·星語要你摧毀監督者高薩克，2個戰歌伐木機，5個部落伐木工，和10個部落斥候。',
  }
},
[9519] = {
  {
    'The Lost Chalice‡Потерянная чаша‡Elunes Kelch‡엘룬의 성배‡El cáliz perdido‡El cáliz perdido‡Le calice perdu‡失落的圣杯‡丟失的酒杯',
    nil,
    'Leve o Cálice de Eluna a Kainet Brisacalma em Cantilenda, que fica no Vale Gris.‡Принесите чашу Элуны Кайнету Штилю в Лесную Песнь.‡Bringt Elunes Kelch zu Kayneth Stillwind in Waldeslied.‡숲의 노래에 있는 케이네스 스틸윈드에게 엘룬의 성배를 가져가야 합니다.‡Llévale el Cáliz de Elune a Kayneth Ventoleve en la Canción del Bosque.‡Consigue el Cáliz de Elune.‡Récupérez le Calice d’Élune.‡将艾露恩的圣杯交给林歌神殿的凯尼斯·静风。‡把伊露恩酒杯帶給林歌神殿的凱尼斯·靜風。',
  }
},
[9520] = {
  {
    'Diabolical Plans‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Les plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Entregue os Planos Diabólicos ao Vindicante Vedaar em Cantilenda, que fica no Vale Gris.‡Доставьте демонические планы воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Bringt die teuflischen Pläne zu Verteidiger Vedaar in Waldeslied im Eschental.‡잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 악마의 계획서를 가져가야 합니다.‡Entrega los planes diabólicos al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Entrega los planes diabólicos al vindicador Vedaar en el Aserradero Grito de Guerra, en Vallefresno.‡Apportez les Plans diaboliques au Redresseur de torts Vedaar au Camp de bûcherons Chanteguerre, en Orneval.‡将恶魔的计划交给灰谷林歌神殿的守备官维达尔。‡將殘忍計畫送到梣谷給林歌神殿的復仇者維達。',
  }
},
[9521] = {
  {
    'Report from the Northern Front‡Донесение с северного фронта‡Bericht von der Nordfront‡북쪽 전초기지에서의 보고서‡Informe del frente norte‡Informe del frente norte‡Un rapport du front nord‡北方前线的报告‡北方前線的報告',
    nil,
    'Entregue o relatório da Sentinela Luciel à Sentinela Cantálgures no Bosque Asa de Prata.‡Доставьте донесение часовой Люсьель часовой Дальней Песне в рощу Среброкрылых.‡Bringt Schildwache Luciels Bericht zu Schildwache Weltensang im Hain der Silberschwingen.‡은빛날개 숲에 있는 파수꾼 파송에게 파수꾼 루시엘의 보고서를 전달해야 합니다.‡Entrega el informe de la centinela Luciel a la centinela Cantolongo en el Claro Ala de Plata.‡Entrega el informe de la centinela Melyria a la centinela Cantolejano en el Claro Ala de Plata, en Vallefresno.‡Apportez le Rapport de la Sentinelle Melyria à la Sentinelle Chanteloin au Bosquet d’Aile-argent, en Orneval.‡将哨兵卢希尔的报告送给银翼树林的哨兵艾蒂亚·轻歌。‡將哨兵露西歐·星語的報告送給銀翼樹林的哨兵輕歌。',
  }
},
[9522] = {
  {
    'Never Again!‡Больше никогда!‡Nie wieder!‡있을 수 없는 일‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡休想！‡永遠沒有下一次!',
    nil,
    'Mate Gorgannon e Diathorus, o Inquisidor, depois fale novamente com o Vindicante Vedaar em Cantilenda, que fica no Vale Gris.‡Убейте Горганнона и Диатора Ищейку и вернитесь к воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Tötet Gorgannon und Diathorus den Sucher und kehrt danach zu Verteidiger Vedaar in Waldeslied im Eschental zurück.‡고르간논과 수색자 디아토루스를 처치한 다음 잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 돌아가야 합니다.‡Mata a Gorgannon y a Diathorus el Buscador, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Consigue la hoja llameante de Gorgannon y la lanza vil de buscador.‡Récupérez l’Épée de flammes de Gorgannon et la Gangrelance du Chercheur.‡杀死戈加农和搜寻者迪亚索鲁斯，然后向灰谷林歌神殿的守备官维达尔复命。‡殺了戈甘諾恩和『追尋者』迪亞索魯斯，再回到梣谷的林歌神殿找復仇者維達。',
  }
},
[9523] = {
  {
    'Relíquia é coisa para se guardar debaixo de sete chaves‡Хрупкие предметы. Не кантовать!‡Besondere Handhabung für kostbare und zerbrechliche Dinge‡고대 유물 발굴‡Material frágil y valioso, manipúlese con cuidado‡Material frágil y valioso, manipúlese con cuidado‡Fragile et précieux - à manipuler avec précaution‡贵重物品，小心轻放‡小心輕放',
    nil,
    'O Arqueólogo Adamantino Ferrocordis, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você leve 8 Relíquias Antigas para ele.‡Принесите 8 древних реликвий археологу Адаманту Железному Сердцу в лагерь Одиссия на острове Лазурной Дымки.‡Archäologe Adamant Eisenherz bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr ihm 8 uralte Relikte bringt.‡하늘안개 섬의 오디시우스의 정박지에 있는 고고학자 아다만트 아이언하트가 고대 유물 8개를 가져다 달라고 부탁했습니다.‡El arqueólogo Adamant Coracero en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 8 reliquias antiguas.‡El arqueólogo Adamant Coracero en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 8 reliquias antiguas.‡L\'archéologue Adamant Cœur-de-fer, au point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous lui rameniez 8 Reliques anciennes.‡秘蓝岛奥德修斯营地的考古学家阿达曼特·铁心要求你给他找到8块上古圣物。‡藍謎島，奧迪席斯平臺的考古學家阿達曼·鐵心要你幫他帶來8個古代聖物。',
  }
},
[9524] = {
  {
    'Aprisionado na cidadela‡Узник Цитадели‡Gefangene der Zitadelle‡성채에 수감된 자‡Encarcelados en la Ciudadela‡Encarcelados en la Ciudadela‡Prisonnière de la citadelle‡堡垒中的囚徒‡監禁堡壘',
    nil,
    'Resgate a Capitão Alina de dentro da Cidadela Fogo do Inferno antes que ela seja executada.nnEsta missão precisa ser concluída na dificuldade heroica da masmorra.‡Спасите капитана Алину в Цитадели Адского Пламени до того, как ее казнят.nnЭто задание выполняется в режиме героической сложности.‡Rettet Hauptmann Alina aus der Höllenfeuerzitadelle, bevor sie hingerichtet wird.nnUm diese Aufgabe zu beenden, müsst Ihr den Dungeon auf dem Schwierigkeitsgrad \'Heroisch\' betreten.‡지옥불 성채 안에 있는 대장 앨리나가 처형되기 전에 구출해야 합니다.nn이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Rescata a la capitana Alina del interior de la Ciudadela del Fuego Infernal antes de que la ejecuten.nnEsta misión se debe completar en dificultad de mazmorra heroica.‡Rescata a la capitana Alina del interior de la Ciudadela del Fuego Infernal antes de que la ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Sauver le capitaine Alina, à l’intérieur de la citadelle des Flammes infernales, avant son exécution.nnCette quête doit être accomplie en mode de difficulté du donjon Héroïque.‡在地狱火堡垒内的奥琳娜上尉被处决前救出她。nn该任务必须在英雄等级难度的地下城中完成。‡',
  }
},
[9525] = {
  {
    'Imprisoned in the Citadel‡Imprisoned in the Citadel‡Gefangene der Zitadelle‡Imprisoned in the Citadel‡Imprisoned in the Citadel‡Encarcelados en la Ciudadela‡Imprisoned in the Citadel‡堡垒中的囚徒‡監禁堡壘',
    nil,
    'Rescue Captain Boneshatter inside Hellfire Citadel before he is executed.nnThis quest must be completed in Heroic dungeon difficulty.‡Rescue Captain Boneshatter inside Hellfire Citadel before he is executed.nnThis quest must be completed in Heroic dungeon difficulty.‡Rettet Hauptmann Knochenbrecher aus der Höllenfeuerzitadelle, bevor er hingerichtet wird.nnUm diese Aufgabe zu beenden, müsst Ihr den Dungeon auf dem Schwierigkeitsgrad \'Heroisch\' betreten.‡Rescue Captain Boneshatter inside Hellfire Citadel before he is executed.nnThis quest must be completed in Heroic dungeon difficulty.‡Rescue Captain Boneshatter inside Hellfire Citadel before he is executed.nnThis quest must be completed in Heroic dungeon difficulty.‡Rescata al capitán Triturahuesos del interior de la Ciudadela del Fuego Infernal antes de que lo ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Rescue Captain Boneshatter inside Hellfire Citadel before he is executed.nnThis quest must be completed in Heroic dungeon difficulty.‡‡',
  }
},
[9526] = {
  {
    'Reclaiming Felfire Hill‡Возрождение Холма Демонического Огня‡Die Rückeroberung des Dämonenhügels‡악령불 언덕‡Recuperar el Cerro Lumbrevil‡Recuperar el Cerro Lumbrevil‡Reprendre la colline Gangrefeu‡夺回冥火岭‡奪回冥火嶺',
    nil,
    'Plante 8 Mudas de Árvore em Monturos de Terra Fértil e fale novamente com Nodoso em Cantilenda, no Vale Gris.‡Посадите 8 древесных саженцев в кучи плодородной земли и вернитесь к Кривокрону в Лесную Песнь в Ясеневом лесу.‡Pflanzt 8 Baumsetzlinge in die fruchtbaren Erdhaufen und kehrt dann zu Knorre in Waldeslied im Eschental zurück.‡기름진 흙더미에 나무 씨앗 8개를 심은 후 잿빛 골짜기의 숲의 노래에 있는 그날에게 돌아가야 합니다.‡in‡Planta 8 semillas de árbol en los montículos de tierra fértil.‡Planter 8 Boutures d\'arbre dans les Monticules de terre fertile, puis retourner voir Noueux au Chant des forêts, en Orneval.‡将8棵小树苗种植在肥沃的土壤中，然后向灰谷林歌神殿的纳亚尔回报。‡將8顆樹苗種在肥沃的土堆裡，再回到梣谷的林歌神殿找格納。',
  }
},
[9527] = {
  {
    'O que restou‡Все, что осталось‡Was noch bleibt‡카우렌의 부탁‡Solo quedan los restos‡Solo quedan los restos‡Tout ce qui reste‡遗体‡剩下的一切',
    nil,
    'Capúleo, na Ilha Névoa Lazúli, quer que você recupere os Restos Mortais da Família de Capúleo.‡Верните Коулену останки его семьи.‡Cowlen auf der Azurmythosinsel möchte, dass Ihr ihm die Überreste von Cowlens Familie bringt.‡하늘안개 섬에 있는 카우렌이 가족의 유해를 되찾아 달라고 부탁했습니다.‡Cowlen, de la Isla Bruma Azur, quiere que recuperes los restos de su familia.‡Cowlen, de la Isla Bruma Azur, quiere que recuperes los restos de su familia.‡Cowlen, de l\'île de Brume-azur, veut que vous retrouviez les Restes de la famille de Cowlen.‡秘蓝岛的库雷要求你回收他的家人的遗体。‡藍謎島的科倫要你找到科倫家族遺骨。',
  }
},
[9528] = {
  {
    'Um grito de socorro‡Крик о помощи‡Ein Hilferuf‡마그윈 호위‡Una llamada de socorro‡Una llamada de socorro‡Un appel à l\'aide‡乞求帮助‡求救',
    nil,
    'Escolte Marian até a casa dela.‡Проводите Магвин через остров до дома.‡Begleitet Magwin über die Insel zu ihrem Zuhause.‡섬을 지나 그녀의 집까지 마그윈을 데려가야 합니다.‡Escolta a Magwin por la isla hasta su casa.‡Escolta a Magwin por la isla hasta su casa.‡Escorter Magwin à travers l\'île, jusqu\'à chez elle.‡护送麦戈薇穿越小岛，回到家中。‡護送麥格文穿過島嶼回到她的家。',
  }
},
[9529] = {
  {
    'A pedra‡Камень‡Der Stein‡공허의 돌‡La piedra‡La piedra‡La Pierre‡虚空石‡虛無石',
    nil,
    'Pegue uma Pedra do Caos na Trilha da Morte.‡Добудьте камень Бездны с Тропы Мертвых.‡Beschafft Euch einen Leerstein von der Todesschneise.‡죽음의 흉터에서 공허의 돌을 찾아야 합니다.‡Consigue una piedra del vacío de La Cicatriz Muerta.‡Consigue una piedra del vacío de La Cicatriz Muerta.‡Trouvez une Pierre de Vide dans la Malebrèche.‡在死亡之痕找到一颗虚空石。‡從死亡之痕取得虛無石。',
  }
},
[9530] = {
  {
    'Planta infalível‡Созревший план‡Einen Plan aus Hecken‡나무와 나뭇잎 수집‡Hay un traidor‡Hay un traidor‡Un plan bourgeonne‡天才的方案！‡我要一棵樹',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você leve uma Árvore Oca e 5 Montes de Folhas para ele.‡Принесите выдолбленный ствол и 5 охапок листьев адмиралу Одиссию в лагерь Одиссия на острове Лазурной Дымки.‡Admiral Odesyus bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr ihm einen ausgehöhlten Stamm und 5 Laubhaufen bringt.‡하늘안개 섬의 오디시우스의 정박지에 있는 제독 오디시우스가 통나무 밑동 1개와 나뭇잎 더미 5개를 가져다 달라고 부탁했습니다.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 1 árbol hueco y 5 pilas de hojas.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 1 árbol hueco y 5 pilas de hojas.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous lui rameniez un Arbre creux et 5 Piles de feuilles.‡秘蓝岛奥德修斯营地的海军上将奥德修斯要求你收集一株中空的树干和5堆树叶。‡藍謎島，奧迪席斯平臺的艦隊司令·奧迪席斯要你幫他帶回中空樹和5堆樹葉。',
  }
},
[9531] = {
  {
    'Debaixo do pé de árvore‡У деревьев есть уши‡Laubangriff‡배신자의 정체‡En compañía de árboles‡En compañía de árboles‡L\'art du camouflage ne se perd pas‡间谍之树‡樹的偽裝',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você espione o encontro que se realizará entre Zé Ruela e o traidor.nnFale com ele novamente quando souber a identidade do velhaco.‡Проследите за встречей Гизла с предателем.nnРасскажите обо всем увиденном адмиралу Одиссию.‡Admiral Odesyus bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr das Treffen beobachtet, das Geezle und der Verräter gemeinsam ausgemacht haben.nnKehrt zu ihm zurück, wenn Ihr ihm die Identität des Verräters mitteilen könnt.‡하늘안개 섬의 오디시우스의 정박지에 있는 제독 오디시우스가 기즐과 배신자가 만나는 장면을 염탐해 달라고 부탁했습니다.nn배신자의 정체를 확인한 후 제독 오디시우스에게 돌아가야 합니다.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que vigiles la reunión que tendrá lugar entre Geezle y el traidor.nnRegresa junto a él cuando sepas la identidad del traidor.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que vigiles la reunión que tendrá lugar entre Geezle y el traidor.|n|nRegresa junto a él cuando sepas la identidad del traidor.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus de l\'île de Brume-azur, veut que vous observiez la rencontre entre Geezle et le traître.nnRetournez le voir lorsque vous connaîtrez l\'identité du traître.‡秘蓝岛奥德修斯营地的海军上将奥德修斯要求你监视吉兹尔与叛徒的会面与谈话。nn确认叛徒的身份之后回去向他复命。‡藍謎島，奧迪席斯平臺的艦隊司令·奧迪席斯要你去觀察吉索和背叛者的會議。|n等你知道了背叛者的身份就回去找他。',
  }
},
[9532] = {
  {
    'Encontre Keltus Umbrafronde‡Найти Келтуса Темного Листа‡Findet Keltus Dunkellaub‡켈투스 다크리프 찾기‡Encuentra a Keltus Hojaoscura‡Encuentra a Keltus Hojaoscura‡Trouver Keltus Sombrefeuille‡找到克尔图斯·暗叶‡',
    nil,
    'Localize Keltus Umbrafronde.‡Найдите Келтуса Темного Листа.‡Macht Keltus Dunkellaub ausfindig.‡켈투스 다크리프를 찾아야 합니다.‡Encuentra a Keltus Hojaoscura.‡Encuentra a Keltus Hojaoscura.‡Trouvez Keltus Sombrefeuille.‡找到克尔图斯·暗叶。‡',
  }
},
[9533] = {
  {
    'A Helping Hand‡Рука помощи‡Eine helfende Hand‡도움의 손길‡Una mano amiga‡Una mano amiga‡La main tendue‡援助之手‡伸出援手',
    nil,
    'Vá até Cantilenda e fale com o Arquiteto Nemos.‡Отправляйтесь в Лесную Песнь и поговорите с архитектором Немосом.‡Geht nach Waldeslied und sprecht mit Architekt Nemos.‡숲의 노래로 가서 건축가 네모스와 대화해야 합니다.‡Dirígete a Canción del Bosque y habla con el arquitecto Nemos.‡Habla con el arquitecto Nemos en Canción del Bosque, en Vallefresno.|n|nLa vindicadora Palanaar puede ofrecerte transporte para que llegues rápidamente.‡Rendez-vous au Chant des forêts, et parlez à l\'architecte Nemos.‡到达林歌神殿，与建筑师尼莫斯谈一谈。‡前往林歌神殿和建築師尼莫斯談談。',
  }
},
[9534] = {
  {
    'Destroy the Legion‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruir a la Legión‡Destruye a la Legión‡Destroy the Legion‡毁灭燃烧军团‡摧毀軍團',
    nil,
    'Mate 6 Açoitadeiras Mannoroth, 6 Guardas Vis e 6 Infernais Abrasadores, depois fale novamente com Valusha no Posto Machadada, que fica no Vale Gris.‡Уничтожьте 6 бичевательниц Маннорока, 6 стражей Скверны и 6 опаляющих инферналов, а затем вернитесь к Валуше на заставу Расщепленного Дерева в Ясеневом лесу.‡Tötet 6 Mannorocpeitscher, 6 Teufelswachen und 6 sengende Höllenbestien und kehrt dann zu Valusha im Splitterholzposten in Eschental zurück.‡만노로크 채찍마녀, 떠도는 지옥군단병, 불타는 지옥불정령을 6마리씩 해치운 후 잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 돌아가십시오.‡Mata a 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores y ve a ver a Valusha al Puesto del Hachazo en Vallefresno.‡Mata a 15 demonios de cualquier tipo en Cerro Lumbrevil, Barranco del Demonio o Cresta del Demonio y después vuelve con Valusha al Puesto del Hachazo en Vallefresno.‡Slay 15 of any demon type at Felfire Hill, Demon Fall Canyon, or demon Fall Ridge and then return to Valusha at Splintertree Post in Ashenvale.‡杀死6个玛诺洛克鞭笞者、6个恶魔守卫和6个灼热的地狱火，然后向灰谷碎木岗哨的瓦鲁莎复命。‡殺死6個瑪諾洛克鞭笞者，6個惡魔守衛和6個灼熱的地獄火，再回到梣谷的碎木崗哨找瓦露薩。',
  }
},
[9535] = {
  {
    'Diabolical Plans‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Les plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Deliver the Diabolical Plans to Valusha at Splintertree Post in Ashenvale.‡Доставьте демонические планы Валуше на заставу Расщепленного Дерева, что в Ясеневом лесу.‡Bringt die teuflischen Pläne zu Valusha im Splitterholzposten im Eschental.‡잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 악마의 계획서를 전달해야 합니다.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Apporter les Plans diaboliques à Valusha au poste de Bois-Brisé en Orneval.‡将恶魔的计划交给灰谷碎木岗哨的瓦鲁莎。‡將殘忍計畫送到梣谷給碎木崗哨的瓦露薩。',
  }
},
[9536] = {
  {
    'Never Again!‡Больше никогда!‡Nie wieder!‡두 번 다시 일어나서는 안 될 일!‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡休想！‡永遠沒有下一次!',
    nil,
    'Mate Gorgannon e Diathorus, o Inquisidor, depois fale novamente com Velusha no Posto Machadada, que fica no Vale Gris.‡Убейте Горганнона и Диатора Ищейку, затем вернитесь к Валуше на заставу Расщепленного Дерева в Ясеневом лесу.‡Tötet Gorgannon und Diathorus den Sucher und kehrt danach zu Velusha im Splitterholzposten im Eschental zurück.‡고르간논과 수색자 디아토루스를 해치운 다음 잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 돌아가십시오.‡Mata a Gorgannon y a Diathorus el Buscador y ve a ver a Valusha al Puesto del Hachazo en Vallefresno.‡‡Tuer Gorgannon et Diathorus le Chercheur, puis retourner voir Valusha au poste de Bois-brisé en Orneval.‡杀死戈加农和搜寻者迪亚索鲁斯，然后向灰谷碎木岗哨的瓦鲁莎复命。‡殺了戈甘諾恩和『追尋者』迪亞索魯斯，再回到梣谷的碎木崗哨找瓦露薩。',
  }
},
[9537] = {
  {
    'Gnomicídio‡Не ведая пощады‡Keine Gnade mit dem Gnom‡반역자의 교신 내용‡Justicia para el gnomo‡Justicia para el gnomo‡Le gnominé est...‡绳侏儒以法‡別對地精仁慈',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, quer que você consiga o Comunicado do Traidor com o Engenheiro "Chispa" Trincabrás.‡Добудьте для адмирала Одиссия переписку предателя у инженера "Искра" Перемолоттера‡Admiral Odesyus bei Odesyus\' Ankerplatz möchte, dass Ihr die Mitteilung des Verräters von Ingenieur "Funks" Oberschleif an Euch bringt.‡오디시우스의 정박지에 있는 제독 오디시우스가 기술자 "불똥" 오버그라인드에게서 반역자의 교신 내용을 되찾아 달라고 부탁했습니다.‡El almirante Odesyus de El Desembarco de Odesyus quiere que le saques información al traidor ingeniero "Chispik" Pasarrosca.‡El almirante Odesyus de El Desembarco de Odesyus quiere que le saques información al traidor ingeniero "Chispik" Pasarrosca.‡L\'amiral Odesyus, du point d\'accostage d\'Odesyus, veut que vous récupériez la Communication du traître sur l\'ingénieur Finemouture, dit « l\'Étincelle ».‡奥德修斯营地的海军上将奥德修斯要求你从工程师欧格林德那里取得叛徒的证据。‡奧迪席斯平臺的艦隊司令·奧迪席斯要你從工程師火花·歐爾滾那裡取回背叛者的信件。',
  }
},
[9538] = {
  {
    'O aprendizado de uma língua‡Изучение языка‡Erlernen der Sprache‡미지의 언어 습득‡Aprendizaje de lenguas‡Aprendizaje de idiomas‡Apprendre la langue‡学外语......‡學習語言',
    nil,
    'Leia a Cartilha da Língua dos Pelursos Pinhoquieto que Aurren lhe deu e interaja com o Totem de Akira no Entreposto Lazúli.‡Изучите пергамент "Язык фурболгов из племени Тихвой для начинающих", полученный от Ауррена, а затем изучите тотемом Акиды на Лазурной заставе.‡Lest die Übersetzungsfibel der Tannenruhfeste, die Aurren Euch gegeben hat. Kommuniziert anschließend mit dem Totem von Akida bei der Azurwacht.‡아울렌이 준 너울소나무 펄볼그 언어 입문서를 읽은 후, 하늘 감시초소에 있는 아키다의 토템과 교감해야 합니다.‡Lee el manual de lengua fúrbolg de Semprepino que Aurren te dio e interactúa con el Tótem de Akida en la Avanzada Azur.‡Lee el manual de idioma fúrbolg de Semprepino que Aurren te dio e interactúa con el Tótem de Akida en la Avanzada Azur.‡Lisez le Manuel de langue furbolg calmepin qui vous a été remis par Aurren, puis examinez le Totem d\'Akida au Guet d\'azur.‡阅读奥鲁恩给你的止松熊怪语言入门，以便和碧蓝岗哨的阿基达图腾交流。‡閱讀奧蘭給你的靜松熊怪語言入門書並和藍色守望的阿契達的圖騰互動。',
  }
},
[9539] = {
  {
    'O totem de Coor‡Тотем Ку‡Totem von Coo‡쿠우의 토템‡El Tótem de Coo‡El Tótem de Coo‡Le totem de Coo‡库欧图腾‡庫的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Coor.‡Найдите тотем Ку с помощью проводника.‡Findet das Totem von Coo, indem Ihr den Hinweisen folgt.‡주어진 단서로 쿠우의 토템을 찾아야 합니다.‡Encuentra el Tótem de Coo con las pistas que tienes.‡Encuentra el Tótem de Coo con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Coo.‡根据线索找到库欧图腾。‡使用提供給你的線索找到庫的圖騰。',
  }
},
[9540] = {
  {
    'O totem de Tikti‡Тотем Тикти‡Totem von Tikti‡티크티의 토템‡El Tótem de Tikti‡El Tótem de Tikti‡Le totem de Tikti‡提克提图腾‡堤克悌的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Tikti.‡Найдите тотем Тикти с помощью проводника.‡Findet das Totem von Tikti, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 티크티의 토템을 찾아야 합니다.‡Encuentra el Tótem de Tikti con las pistas que tienes.‡Encuentra el Tótem de Tikti con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Tikti.‡根据线索找到提克提图腾。‡使用提供給你的線索找到堤克悌的圖騰。',
  }
},
[9541] = {
  {
    'O totem de Yor‡Тотем Йора‡Totem von Yor‡요르의 토템‡El Tótem de Yor‡El Tótem de Yor‡Le totem de Yor‡尤尔图腾‡優兒的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Yor.‡Найдите тотем Йора с помощью проводника.‡Findet das Totem von Yor, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 요르의 토템을 찾아야 합니다.‡Encuentra el Tótem de Yor con las pistas que tienes.‡Encuentra el Tótem de Yor con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Yor.‡根据线索找到尤尔图腾。‡使用提供給你的線索找到優兒的圖騰。',
  }
},
[9542] = {
  {
    'O totem de Vark‡Тотем Варк‡Totem von Vark‡바르크의 토템‡El Tótem de Vark‡El Tótem de Vark‡Le totem de Vark‡瓦克图腾‡瓦克的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Vark.‡Найдите тотем Варк с помощью проводника.‡Findet das Totem von Vark, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 바르크의 토템을 찾아야 합니다.‡Encuentra el Tótem de Vark con las pistas que tienes.‡Encuentra el Tótem de Vark con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Vark.‡根据线索找到瓦克图腾。‡使用提供給你的線索找到瓦克的圖騰。',
  }
},
[9543] = {
  {
    'Expiação‡Искупление‡Sühne‡속죄‡Expiación‡Expiación‡Expiation‡救赎‡贖罪',
    nil,
    'Fale com Amaan, o Sábio, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Поговорите с Амааном Мудрым в храме Телхамат на полуострове Адского Пламени.‡Sprecht mit Amaan dem Weisen beim Tempel von Telhamat auf der Höllenfeuerhalbinsel.‡지옥불 반도의 텔하마트 사원에 있는 현자 아만과 대화해야 합니다.‡Habla con Amaan el Sabio en el Templo de Telhamat en la Península del Fuego Infernal.‡Habla con Amaan el Sabio en el Templo de Telhamat en la Península del Fuego Infernal.‡Parler à Amaan le Sage, au temple de Telhamat dans la péninsule des Flammes infernales.‡与地狱火半岛塔哈玛特神殿的智者阿曼恩谈一谈。‡到地獄火半島和特爾哈曼神廟的『智者』阿曼談談。',
  }
},
[9544] = {
  {
    'A profecia de Akira‡Пророчество Акиды‡Die Prophezeiung von Akida‡아키다의 예언‡La profecía de Akida‡La profecía de Akida‡La prophétie d\'Akida‡阿基达的预言‡阿契達的預言',
    nil,
    'Liberte 8 Pinhoquieto Cativos das jaulas que se encontram na Aldeia dos Ericerdos. Fale com Aruguu dos Pinhoquieto no Entreposto Lazúli quando houver cumprido a tarefa.‡Освободите 8 пленников из племени Тихвой из клеток в деревне Косолапов. Вернитесь к Аругу из племени Тихвой на Лазурную заставу.‡Befreit 8 gefangene Furbolgs der Tannenruhfeste aus den Käfigen im Dorf der Sichelklauen. Kehrt anschließend zu Arugoo der Tannenruhfeste bei der Azurwacht zurück.‡뾰족가지 마을에 있는 우리에서 너울소나무일족 포로 8명을 구출한 후, 하늘 감시초소에 있는 너울소나무일족 아루구에게 돌아가야 합니다.‡Libera a 8 cautivos Semprepino de las jaulas que se encuentran en la Aldea Brazolanudo. Vuelve junto a Arugoo de los Semprepino, en la Avanzada Azur, cuando completes esta tarea.‡Libera a 8 cautivos Semprepino de las jaulas que se encuentran en la Aldea Brazolanudo. Vuelve junto a Arugoo de los Semprepino, en la Avanzada Azur, cuando completes esta tarea.‡Libérez 8 Captifs Calmepins des cages du village des Bras-hirsutes. Retournez voir Arugoo des Calmepins au Guet d\'azur quand vous aurez accompli cette tâche.‡在刺臂村中释放8名止松俘虏。完成任务之后回到碧蓝岗哨，找止松部族的阿鲁古复命。‡釋放8個在鬚肢村裡發現的靜松俘虜。完成後回到藍色守望找靜松要塞的阿魯古。',
  }
},
[9545] = {
  {
    'A relíquia do vidente‡Реликвия ясновидца‡Das Relikt des Sehers‡현자의 유물‡La reliquia del vidente‡La reliquia del vidente‡La relique du prophète‡先知的圣物‡先知的聖物',
    nil,
    'Amaan, o Sábio, no Templo de Telhamat, na Península Fogo do Inferno, quer que você volte para o local do Cadáver de Sedai, a nordeste do Templo de Telhamat, e use a Relíquia do Vidente lá. Fale novamente com ele ao concluir a tarefa.‡Вернитесь к телу Седаи, которое находится к северо-востоку от храма Телхамат, и используйте там реликвию ясновидца по просьбе Амаана Мудрого из храма Телхамат на полуострове Адского Пламени. После выполнения задания возвращайтесь к Амаану.‡Amaan der Weise beim Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr Sedais Leichnam erneut aufsucht, um dort das Relikt des Sehers zu benutzen. Kehrt nach Abschluss der Aufgabe zu ihm zurück.‡지옥불 반도의 텔하마트 사원에 있는 현자 아만이 텔하마트 사원의 북동쪽에 있는 세다이의 시체로 돌아간 후, 그곳에서 현자의 유물을 사용하라고 부탁했습니다. 일을 마친 후 현자 아만에게 돌아가야 합니다.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas al cadáver de Sedai al noreste del Templo y uses la reliquia del vidente allí. Después vuelve a ver a Amaan.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas al cadáver de Sedai al noreste del Templo y uses la reliquia del vidente allí. Después vuelve a ver a Amaan.‡Amaan le Sage, du Temple de Telhamat dans la Péninsule des Flammes infernales, veut que vous retourniez auprès du Cadavre de Sedaï, au nord-est du Temple de Telhamat, et que vous utilisiez la Relique du prophète à cet endroit. Revenez le voir quand ce sera fait.‡地狱火半岛塔哈玛特神殿的智者阿曼恩要你回到瑟丹的尸体旁，使用先知的圣物。任务完成之后回去向他复命。‡地獄火半島的特爾哈曼神廟的『智者』阿曼要你回到特爾哈曼神廟東北方希戴的屍體那邊使用先知的聖物。任務完成後回去找他。',
  }
},
[9547] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара на острове Лазурной Дымки.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡',
  }
},
[9548] = {
  {
    'O furto dos equipamentos‡Украденное снаряжение‡Gestohlene Ausrüstung‡도둑맞은 장비‡Equipamiento robado‡Equipamiento robado‡L\'équipement chapardé‡被偷走的设备‡被偷走的裝備',
    nil,
    'Devolva o Equipamento do Xote para Xote Cabeçote, que está escondido num casco de tartaruga na praia.‡Верните Клопперу Бацбаху его оборудование. Клоппера можно найти в старом черепашьем панцире на берегу.‡Bringt Kloppers Ausrüstung zurück zu Klopper Knacksklug, der sich in einem angespülten Schildkrötenpanzer versteckt hält.‡해변으로 밀려 올라온 거북이 껍질 속에 숨어 있는 클로퍼 위즈뱅에게 클로퍼의 장비를 가져가야 합니다.‡Lleva el equipamiento de Clopper a Clopper Zumbibang, que se oculta en un caparazón de tortuga en la playa.‡Lleva el equipamiento de Clopper a Clopper Zumbibang, que se oculta en un caparazón de tortuga en la playa.‡Rapportez l\'Equipement de Clopper à Clopper Crackboum, qui se cache dans une carapace de tortue échouée.‡找回克劳伯的设备，把它交给躲在海滩龟壳中的克劳伯·维兹班。‡把克羅波的裝備帶回來給克羅波·維茲班，他藏在海邊的一個龜殼裡面。',
  }
},
[9549] = {
  {
    'Os artefatos dos Trevareia‡Артефакты племени Черного Ила‡Schwarzschlammartefakte‡검은진흙멀록의 물건 수집‡Los artefactos de los Cienonegro‡Los artefactos de los Cienonegro‡Les artéfacts des Vase noire‡黑沙神器‡黑沙的手工藝品',
    nil,
    'Entregue 3 Ídolos Murloc Rudimentares e 6 Facas Murloc Rudimentares para Xote Cabeçote, que está escondido num casco de tartaruga na praia.‡Принесите 3 варварских идола и 6 варварских ножа мурлоков Клопперу Бацбаху, который прячется в старом черепашьем панцире на берегу.‡Bringt 3 kunstlose Murlocgötzen und 6 kunstlose Murlocmesser zu Klopper Knacksklug, der sich in einem angespülten Schildkrötenpanzer versteckt hält.‡해변으로 밀려 올라온 거북이 껍질 속에 숨어 있는 클로퍼 위즈뱅에게 조잡한 멀록 우상 3개, 조잡한 멀록 손칼 6개를 가져가야 합니다.‡Lleva tres ídolos múrlocs rudimentarios y seis cuchillos múrlocs rudimentarios a Clopper Zumbibang, que se esconde en el caparazón de una tortuga de la playa.‡Lleva tres ídolos múrlocs rudimentarios y seis cuchillos múrlocs rudimentarios a Clopper Zumbibang, que se esconde en el caparazón de una tortuga de la playa.‡Apportez 3 Idoles murlocs grossières et 6 Couteaux murlocs grossiers à Clopper Crackboum, qui se cache dans une carapace de tortue échouée.‡收集3个粗糙的鱼人神像和6把粗糙的鱼人小刀，把它们交给躲藏在海滩龟壳里的克劳伯·维兹班。‡帶3個粗糙的魚人塑像和6把粗糙的魚人小刀給克羅波·維茲班，他藏在海邊的一個龜殼裡面。',
  }
},
[9550] = {
  {
    'Um mapa de onde?‡Загадочная карта‡Wohin führt die Karte?‡지도 조사‡Un mapa con destino desconocido‡Un mapa con destino desconocido‡Une carte pour où ?‡一张地图？‡模糊的地圖?',
    nil,
    'Encontre o pavilhão descrito no mapa e procure o que o autor do documento quis registrar.‡Найдите павильон, изображенный на карте, и выясните, что в нем необычного.‡Macht den auf der Karte beschriebenen Pavillon ausfindig und sucht, auf was der Verfasser der Karte hinweisen wollte.‡지도에 그려진 누각을 찾아서 지도를 그린 이가 뭘 기록하려 했는지 조사해야 합니다.‡Encuentra el pabellón descrito en el mapa y busca lo que el cartógrafo intentaba registrar.‡Encuentra el pabellón descrito en el mapa y busca lo que el cartógrafo intentaba registrar.‡Trouvez le pavillon décrit par la carte, et découvrez ce que celui qui l’a dessinée essayait de représenter.‡找出图中描述的亭子，寻找画图人所记录的信息。‡找到地圖中描繪的亭子並尋找製圖者想記錄下來的東西。',
  }
},
[9551] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара на острове Лазурной Дымки.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo, que está en la Sala de Cristal, dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9552] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Fale com Velaada no Morro Vento Selvagem, que fica na Ilha Névoa Lazúli.‡Поговорите с Велаадой на Штормовом Пике острова Лазурной Дымки.‡Sprecht mit Velaada beim Wildwindgipfel auf der Azurmythosinsel.‡하늘안개 섬의 갈기바람 봉우리에 있는 벨라아다와 대화해야 합니다.‡Habla con Velaada en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Habla con Velaada en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Parlez à Velaada au pic Vent-sauvage, sur l’île de Brume-azur.‡与秘蓝岛狂风山的维兰达谈一谈。‡到藍謎島的狂風山尖和維拉達談談。',
  }
},
[9553] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Fale com Susurrus no Morro Vento Selvagem, que fica na Ilha Névoa Lazúli.‡Поговорите с Шептателем на Штормовом Пике острова Лазурной Дымки.‡Sprecht mit Susurrus beim Wildwindgipfel auf der Azurmythosinsel.‡하늘안개 섬의 갈기바람 봉우리에 있는 수술루스와 대화해야 합니다.‡Habla con Susurrus en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Habla con Susurrus en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Parlez à Susurrus au pic Vent-sauvage, sur l’île de Brume-azur.‡与秘蓝岛狂风山的苏苏鲁斯谈一谈。‡到藍謎島的狂風山尖和蘇瑟拉斯談談。',
  }
},
[9554] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Fale novamente com o Clarividente Nobambo na Exodar, que fica na Ilha Névoa Lazúli, levando o Redemoinho de Ar.‡Отдайте Завихрение воздуха предсказателю Нобундо в Экзодаре.‡Kehrt mit dem Luftwirbel zu Weissager Nobundo bei der Exodar auf der Azurmythosinsel zurück.‡바람의 소용돌이를 가지고 하늘안개 섬의 엑소다르에 있는 선견자 노분도에게 돌아가야 합니다.‡Vuelve junto al clarividente Nobundo en El Exodar, en la Isla Bruma Azur, con la espiral de aire‡Vuelve junto al clarividente Nobundo en El Exodar, en la Isla Bruma Azur, con la espiral de aire.‡[Return to Farseer Nobundo at the Exodar on Azuremyst Isle with the Whorl of Air.]‡将空气之漩交给埃索达的预言者努波顿。‡帶著空氣漩渦回到藍謎島找艾克索達的先知諾柏多。',
  }
},
[9555] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del Fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火焰的召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar.‡엑소다르의 수정 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en El Exodar en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en El Exodar en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo dans le Hall de Cristal, à bord de l\'Exodar.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡到艾克索達和水晶大廳的先知諾柏多談談。',
  }
},
[9556] = {
  {
    'Ao vencedor...‡Вода для мага‡Dem Sieger...‡승리의 길로...‡Al victori...‡Para el vencedor...‡Au vainqueur...‡胜者为王‡給勝利者……',
    nil,
    'Colete uma garrafa de Água Benta de Stratholme dentro da cidade de Stratholme e leve-a para o Mago de Lordaeron no Distrito dos Magos de Ventobravo ou da Cidade Baixa quando seu lado for vitorioso nas Terras Pestilentas Orientais.‡Найдите бутылку святой воды Стратхольма на улицах Стратхольма и доставьте ее Лордеронскому магу в квартал магов в Штормграде или Подгороде, если вашей стороне удалось одержать верх в Восточных Чумных землях.‡Sucht nach einer Phiole mit heiligem Wasser in Stratholme und bringt sie zu dem Magier von Lordaeron im Magierviertel von Sturmwind oder in Unterstadt, falls Eure Seite in den östlichen Pestländern erfolgreich war.‡자신의 진영이 동부 역병지대에서 승리하면 스톰윈드나 언더시티 마법사 지구 내에 있는 로데론 마법사에게 스트라솔름 성수를 가져가야 합니다.‡Hazte con una botella de agua Sagrada de Stratholme en la ciudad con el mismo nombre y entrégala al mago de Lordaeron en el Barrio de los Magos de Ventormenta o Entrañas una vez consigas la victoria para tu bando en las Tierras de la Peste.‡Hazte con una botella de agua Sagrada de Stratholme en la ciudad de Stratholme y entrégasela al mago de Lordaeron, en el Barrio de los Magos de Ventormenta o Entrañas, una vez consigas la victoria para tu bando en las Tierras de la Peste del Este.‡Récupérez une bouteille d\'Eau sacrée de Stratholme à l\'intérieur de Stratholme, et remettez-la au Mage de Lordaeron, au quartier des mages de Hurlevent ou de Fossoyeuse, lorsque votre camp aura vaincu.‡从斯坦索姆城内收集到一瓶斯坦索姆圣水，在你的阵营获得东瘟疫之地的胜利之后，将圣水交给暴风城或幽暗城内法师区的洛丹伦法师。‡從斯坦索姆城裡取得一瓶斯坦索姆聖水，當你的陣營在東瘟疫之地獲得勝利，就把它交給暴風城或幽暗城法師區裡的羅德隆法師。',
  }
},
[9557] = {
  {
    'Decifrar o livro‡Расшифровка книги‡Entziffern des Buchs‡고대 일지 해독‡Descifrar el libro‡Descifrar el libro‡Déchiffrer le livre‡破译书籍‡解讀這本書',
    nil,
    'Entregue o Diário Antigo para o Anacoreta Paetheus no Entreposto Rubro.‡Отнесите древние записи на Кровавую заставу и покажите анахорету Пайтеусу.‡Bringt das alte Tagebuch zu Anachoret Paetheus bei der Blutwacht.‡핏빛 감시초소에 있는 수도사 패테우스에게 고대 일지를 가져가야 합니다.‡Llévale el diario antiguo al Anacoreta Paetheus en la Avanzada de Sangre.‡Llévale el diario antiguo al Anacoreta Paetheus en la Avanzada de Sangre.‡Apportez l\'Ancien journal de bord à l\'Anachorète Paetheus au Guet du sang.‡把这本日记交给秘血岗哨的学者菲索斯。‡把古老的日記帶給血色守望的隱士裴薩斯。',
  }
},
[9558] = {
  {
    'Os Barbalonga‡Длиннобородые‡Die Langbarts‡그렘니 롱비어드 찾기‡Los Barbalarga‡Los Barbalarga‡Les Barbe-longue‡长须兄弟‡長鬚兄弟',
    nil,
    'Encontre Gremni Barbalonga a noroeste do Antro de Haal\'esh, a oeste da Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Найдите Гремни Длинноборода на северо-западе от логова Хаал\'эш на полуострове Адского Пламени.‡Sucht nach Gremni Langbart nordwestlich des Haal\'eshbaus, weit im Westen der Ehrenfeste auf der Höllenfeuerhalbinsel.‡지옥불 반도의 명예의 요새 서쪽으로 하알레쉬 소굴의 북서쪽에서 그렘니 롱비어드를 찾아야 합니다.‡Busca a Gremni Barbalarga al noroeste de El Cubil de Haal\'esh, hacia el oeste del Bastión del Honor en la Península del Fuego Infernal.‡Busca a Gremni Barbalarga al noroeste de El Cubil de Haal\'esh, hacia el oeste del Bastión del Honor en la Península del Fuego Infernal.‡Cherchez Gremni Barbe-longue au nord-ouest de la tanière des Haal’esh, loin à l’ouest du bastion de l’Honneur de la péninsule des Flammes infernales.‡前往地狱火半岛荣耀堡以西的哈尔什巢穴，在巢穴西北方寻找格雷尼·长须的下落。‡前往海艾斯洞穴的西北邊找葛明尼·長鬚，在地獄火半島的榮譽堡西邊。',
  }
},
[9559] = {
  {
    'A aldeia de Pinhoquieto‡Логово племени Тихвой‡Tannenruhfeste‡너울소나무 요새‡El Bastión Semprepino‡El Bastión Semprepino‡Le repaire des Calmepins‡止松要塞‡靜松要塞',
    nil,
    'Fale com o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto.‡Поговорите с верховным вождем в логове племени Тихвой.‡Sprecht mit dem Oberhäuptling bei der Tannenruhfeste.‡너울소나무 요새에 있는 대족장 너울소나무와 대화해야 합니다.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Parlez au Grand chef Calmepin au repaire des Calmepins.‡与止松要塞的止松老酋长谈一谈。‡和靜松要塞的大酋長靜松談談。',
  }
},
[9560] = {
  {
    'As bestas do Apocalipse!‡Звери Судного дня!‡Biester aus der Apokalypse!‡계시의 생물들!‡¡Las bestias del apocalipsis!‡¡Las bestias del apocalipsis!‡Les bêtes de l\'Apocalypse !‡末日的野兽！‡天啟的野獸!',
    nil,
    'Moordo, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você leve 8 Pelegos de Assolador para ele.‡Принесите 8 шкур опустошителей Мурдо в логово племени Тихвой.‡Moordo bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr ihm 8 Felshetzerbälge bringt.‡하늘안개 섬의 너울소나무 요새에 있는 무르도가 칼날발톱 가죽 8개를 가져다 달라고 부탁했습니다.‡Moordo del Bastión Semprepino, en la Isla Bruma Azur, quiere que le lleves 8 pellejos de devastador.‡Moordo del Bastión Semprepino, en la Isla Bruma Azur, quiere que le lleves 8 pellejos de devastador.‡Moordo, du repaire des Calmepins de l\'île de Brume-azur, veut que vous lui rapportiez 8 Peaux de ravageurs.‡秘蓝岛止松要塞的莫多要求你给他带回8张掠食者的皮。‡藍謎島，靜松要塞的墨爾多要你幫他帶來8塊劫毀者皮。',
  }
},
[9561] = {
  {
    'As palavras de Nolkai‡Записи Нолкаи‡Nolkais Worte‡놀카이의 마지막 말‡Las palabras de Nolkai‡Las palabras de Nolkai‡Les mots de Nolkai‡诺尔凯的日记‡諾凱的話',
    nil,
    'Encontre o lugar descrito no diário e recupere os bens de Nolkai há muito enterrados.‡Найдите место, описанное в дневнике Нолкаи, и отыщите его тайник.‡Findet den in Nolkais Tagebuch beschriebenen Ort und sucht nach seinen seit langem vergrabenen Besitztümern.‡놀카이의 일지에 기록된 위치를 찾아 오래전에 묻힌 그의 소지품을 되찾아야 합니다.‡Encuentra la ubicación descrita en el diario de Nolkai y descubre sus pertenencias enterradas desde hace tiempo.‡Encuentra la ubicación descrita en el diario de Nolkai y descubre sus pertenencias enterradas desde hace tiempo.‡Trouvez l’endroit décrit dans le journal de Nolkai et découvrez les biens qu’il a enterrés il y a longtemps.‡找到诺尔凯的日记中提到的地方和他埋藏多年的财物。‡找到諾凱的日記中描述的地點及那裡埋藏已久的財產。',
  }
},
[9562] = {
  {
    'Murlocs... Por que aqui? E por que agora?‡Мурлоки... За что нам эта напасть?‡Murlocs... Warum hier? Warum jetzt?‡예상치 못한 멀록의 등장‡Múrlocs... ¿Por qué?‡Múrlocs... ¿Por qué?‡Pourquoi les murlocs ?‡鱼人......‡魚人……為何此時?為何此地?',
    nil,
    'Gurf, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você recupere 5 sacos de Grão de Pinhoquieto.‡Верните 5 мешков зерна племени Тихвой.‡Gurf bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr 5 Säcke mit Tannenruhgetreide wiedererlangt.‡하늘안개 섬의 너울소나무 요새에 있는 굴프가 너울소나무일족 곡식 5개를 되찾아 달라고 부탁했습니다.‡Gurf del Bastión Semprepino en la Isla Bruma Azur quiere que recuperes 5 sacos de grano Semprepino.‡Gurf del Bastión Semprepino en la Isla Bruma Azur quiere que recuperes 5 sacos de grano Semprepino.‡Gurf, du repaire des Calmepins sur l\'île de Brume-azur, veut que vous retrouviez 5 sacs de Céréales calmepins.‡秘蓝岛止松要塞的古尔弗要求你找回5袋止松谷物。‡藍謎島，靜松要塞的克夫要你取回5袋靜松穀物。',
  }
},
[9563] = {
  {
    'Ganhando a confiança de Mirren‡Доверие Миррена‡Mirrens Vertrauen erlangen‡미렌의 신뢰 얻기‡Ganar la confianza de Mirren‡Ganar la confianza de Mirren‡Gagner la confiance de Mirren‡米伦的信任‡贏得麥倫的信任',
    nil,
    'Mirren Barbalonga quer que você lhe traga 1 Cerveja Etergarde. Será necessário alcançar reputação de <Respeitado/Respeitada> pela Fortaleza da Honra para completar a missão.‡Принесите Миррену Длиннобороду 1 кружку горькой настойки Стражей Пустоты. Для выполнения этого задания необходимо иметь дружелюбное отношение Оплота Чести.‡Mirren Langbart auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 1 Nethergarde Bitter bringt. Diese Aufgabe erfordert zum Abschluss auch einen freundlichen Ruf bei der Ehrenfeste.‡미렌 롱비어드가 네더가드 흑맥주 한 잔을 가져다 달라고 부탁했습니다. 이 퀘스트를 완료하려면 명예의 요새로부터 약간 우호적 이상의 평판을 얻어야 합니다.‡Mirren Barbalarga quiere que le lleves 1 cerveza de Nethergarde. También debes alcanzar la reputación de amistoso ante el Bastión del Honor para completar esta misión.‡Mirren Barbalarga quiere que le lleves 1 cerveza de Nethergarde. También debes alcanzar la reputación de amistoso ante el Bastión del Honor para completar esta misión.‡Mirren Barbe-longue veut que vous lui procuriez 1 Bière amère de Rempart-du-Néant. Pour achever cette quête, les gens du bastion de l\'Honneur doivent être Amicaux envers vous.‡将一杯守望堡烈酒交给米伦·长须。完成任务后，你在荣耀堡的声望必须达到友好才能完成这个任务。‡麥倫·長鬚要你幫他帶來1杯守望苦味啤酒。同時你必須在榮譽堡達到友好聲望值才能完成這個任務。',
  }
},
[9564] = {
  {
    'A dignidade de Gurf‡Клок шерсти Гурфа‡Gurfs Würde‡굴프의 자존심‡La dignidad de Gurf‡La dignidad de Gurf‡La dignité de Gurf‡古尔弗的尊严‡克夫的尊嚴',
    nil,
    'Devolva a Dignidade de Gurf na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli.‡Верните Гурфу клок его шерсти в логово племени Тихвой на острове Лазурной Дымки.‡Bringt Gurfs Würde zu Gurf bei der Tannenruhfeste auf der Azurmythosinsel.‡하늘안개 섬의 너울소나무 요새에 있는 굴프에게 굴프의 자존심을 회복해 줘야 합니다.‡Devuélvele a Gurf su dignidad en el Bastión Semprepino en la Isla Bruma Azur.‡Devuélvele a Gurf su dignidad en el Bastión Semprepino en la Isla Bruma Azur.‡Rapportez la Dignité de Gurf à Gurf au repaire des Calmepins sur l\'île de Brume-azur.‡将古尔弗的尊严交给秘蓝岛止松要塞的古尔弗。‡將克夫的尊嚴帶到藍謎島的靜松要塞還給克夫。',
  }
},
[9565] = {
  {
    'A busca na aldeia de Pinhoquieto‡Поиски в логове племени Тихвой‡Sucht in der Tannenruhfeste‡너울소나무 요새 조사‡Registra el Bastión Semprepino‡Registra el Bastión Semprepino‡Fouillez le repaire des Calmepins‡搜索止松要塞‡搜索靜松要塞',
    nil,
    'Procure pistas nas cavernas da Aldeia de Pinhoquieto.‡Найдите в логове племени Тихвой причины предательства совухов.‡Sucht in der Tannenruhfeste nach Hinweisen.‡너울소나무 요새를 조사하여 단서를 찾아야 합니다.‡Busca pistas en el Bastión Semprepino.‡Busca pistas en el Bastión Semprepino.‡Fouillez le repaire des Calmepins à la recherche d\'indices.‡在止松要塞内寻找线索。‡搜索靜松要塞找到線索。',
  }
},
[9566] = {
  {
    'Cristais de sangue‡Кровавые кристаллы‡Blutkristalle‡핏빛 수정‡Cristales de sangre‡Cristales de sangre‡Les cristaux de sang‡血水晶‡血水晶',
    nil,
    'Fale com o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto.‡Поговорите с верховным вождем в логове племени Тихвой.‡Sprecht mit dem Oberhäuptling bei der Tannenruhfeste.‡너울소나무 요새에 있는 대족장 너울소나무와 대화해야 합니다.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Parlez au Grand chef Calmepin au repaire des Calmepins.‡与止松要塞的止松老酋长谈一谈。‡和靜松要塞的大酋長靜松談談。',
  }
},
[9567] = {
  {
    'Conhece o teu inimigo‡Лицо врага‡Kenne deinen Feind‡적에 대한 정보‡Conoce a tu enemigo‡Conoce a tu enemigo‡Connais ton ennemi‡知己知彼‡了解敵人',
    nil,
    'Encontre o Monumento a Nazzivus, em Nazzivian, e pegue um Glifo de Monumento a Nazzivus. Em seguida, fale novamente com a Vindicante Aalesia no Entreposto Rubro.‡Найдите в Наззивиане монумент Наззивуса, возьмите один из иероглифов с монумента и вернитесь к воздаятельнице Аалезии на Кровавую заставу.‡Findet das Monument der Nazzivus in Nazzivian und beschafft Euch eine Glyphe vom Monument der Nazzivus. Kehrt zu Verteidigerin Aalesia bei der Blutwacht zurück, sobald Ihr die Glyphe habt.‡나지비안에 있는 나지부스 기념비를 찾아서 나지부스 기념비 상형문자를 얻어낸 후, 핏빛 감시초소에 있는 구원자 알레시아에게 돌아가야 합니다.‡Encuentra el monumento de Nazzivus en Nazzivian y recupera un glifo de dicho monumento. Regresa junto a la vindicadora Aalesia en la Avanzada de Sangre cuando tengas uno de los glifos.‡Encuentra el monumento de Nazzivus en Nazzivian y recupera un glifo de dicho monumento. Regresa junto a la vindicadora Aalesia en la Avanzada de Sangre cuando tengas uno de los glifos.‡Trouvez le Monument de Nazzivus à Nazzivian et récupérez un Glyphe du monument de Nazzivus. Lorsque vous l\'aurez, retournez voir le redresseur de torts Aalesia au Guet du sang.‡找到纳兹维安的碑石，将得到的纳兹维安碑石雕文交给秘血岗哨的守备官艾蕾希亚。‡找到納茲維恩的納茲維斯紀念碑並取得納茲維斯紀念碑雕紋。拿到一個雕紋後回到血色守望的復仇者艾樂希雅那裡。',
  }
},
[9568] = {
  {
    'On the Offensive‡Лучшая защита‡In der Offensive‡‡A la ofensiva‡‡À l\'offensive‡‡進攻勢態',
    nil,
    'Vindicator Aalesia at Blood Watch wants you to kill 10 Nazzivus Satyr, 5 Nazzivus Rogues, and 5 Nazzivus Felsworn.‡Воздаятельница Алезия с Кровавой заставы просит убить 10 сатиров, 5 разбойников и 5 скверноподанных из племени Наззивус.‡Verteidigerin Aalesia bei der Blutwacht möchte, dass Ihr 10 Satyrn der Nazzivus, 5 Schurken der Nazzivus und 5 Teufelsanbeter der Nazzivus tötet.‡‡La vindicadora Aalesia en la Avanzada de Sangre quiere que mates a 10 sátiros Nazzivus, 5 pícaros Nazzivus y 5 jurapenas Nazzivus.‡La vindicadora Aalesia en la Avanzada de Sangre quiere que mates a 10 sátiros Nazzivus, 5 pícaros Nazzivus y 5 jurapenas Nazzivus.‡Le redresseur de torts Aalesia du Guet du sang veut que vous tuiez 10 Satyres Nazzivus, 5 Voleurs Nazzivus et 5 Gangreliges Nazzivus.‡‡血色守望的復仇者艾樂希雅要你殺死10個納茲維斯薩特，5個納茲維斯盜賊，和5個納茲維斯魔語。',
  }
},
[9569] = {
  {
    'Conter a ameaça‡Противостояние‡Die Bedrohung bekämpfen‡오염된 수정 수집‡Contener la amenaza‡Contener la amenaza‡Contenir la menace‡化解危机‡遏制威脅',
    nil,
    'Mate Zevrax, 5 Assombrantes Axxarien e 5 Arautos Infernais Axxarien. Em seguida, pegue 5 Cristais Corrompidos e fale novamente com a Vindicante Aalesia no Entreposto Rubro.‡Убейте Зевракса, 5 аксариенских тенеловов и 5 аксариенских призывателей огня, соберите 5 оскверненных кристаллов и отнесите их на Кровавую заставу воздаятельнице Аалезии.‡Tötet 5 Schattenpirscher von Axxarien, 5 Höllenrufer von Axxarien und Zevrax. Sammelt außerdem 5 verderbte Kristalle ein und kehrt zu Verteidigerin Aalesia bei der Blutwacht zurück.‡악사리엔 그림자추적자 5명, 악사리엔 지옥소환사 5명과 제브락스를 해치운 후, 오염된 수정 5개를 모아서 핏빛 감시초소에 있는 구원자 알레시아에게 돌아가야 합니다.‡Mata a 5 acechasombras Axxarien, 5 clamainfernos Axxarien y a Zevrax, recolecta entonces 5 cristales corruptos y llévaselos a la vindicadora Aalesia en la Avanzada de Sangre.‡Mata a 5 acechasombras Axxarien, 5 clamainfernos Axxarien y a Zevrax, recolecta entonces 5 cristales corruptos y llévaselos a la vindicadora Aalesia en la Avanzada de Sangre.‡Tuez 5 Traqueurs des ombres axxariens, 5 Implorateurs de l\'enfer axxariens et Zevrax, puis récupérez 5 Cristaux corrompus et retournez auprès du Redresseur de torts Aalesia au Guet du sang.‡杀掉5个阿克萨林暗影行者、5个阿克萨林唤魔者和塞弗拉克斯，然后收集5块被腐蚀的水晶，把它们交给秘血岗哨的守备官艾蕾希亚。‡殺死5個艾克薩瑞安巡影者，5個艾克薩瑞安地獄呼喚者，和澤伏瑞斯，再收集5個被汙染的水晶交給血色守望的復仇者艾樂希雅。',
  }
},
[9570] = {
  {
    'O Cárcaro do tártaro‡Куркен-жмуркен‡Kurken lauert‡쿠르켄 처치‡El Kurken acecha‡El Kurken acecha‡Le Kurken se cache dans le coin‡可怕的库肯‡潛伏的克爾肯',
    nil,
    'Korz, o Revelador, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você mate o Cárcaro e que leve o Couro do Cárcaro para ele.‡Убейте Куркена и принесите его шкуру Курцу Прорицателю в логово племени Тихвой на острове Лазурной Дымки.‡Kurz der Weise bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr Kurken tötet und dass Ihr ihm Kurkens Balg bringt.‡하늘안개 섬의 너울소나무 요새에 있는 계시자 쿠르즈가 쿠르켄을 해치운 후, 쿠르켄의 통가죽을 가져다 달라고 부탁했습니다.‡Kurz el Revelador del Bastión Semprepino en la Isla Bruma Azur quiere que mates a El Kurken y que le lleves su pellejo.‡Kurz el Revelador del Bastión Semprepino en la Isla Bruma Azur quiere que mates a El Kurken y que le lleves su pellejo.‡Kurz le Révélateur, du repaire des Calmepins de l\'île de Brume-azur, veut que vous tuiez le Kurken et que vous lui rameniez la Peau du Kurken.‡秘蓝岛止松要塞的启示者库尔兹要求你杀死库肯，并带回库肯的毛皮。‡藍謎島，靜松要塞的『啟示者』克茲要你殺死克爾肯再帶回克爾肯的皮。',
  }
},
[9571] = {
  {
    'O Couro do Cárcaro‡Шкура Куркена‡Kurkens Balg‡쿠르켄의 통가죽‡El pellejo de El Kurken‡El pellejo de El Kurken‡La peau du Kurken‡库肯的毛皮‡克爾肯的皮',
    nil,
    'Entregue o Couro do Cárcaro a Moordo na Aldeia de Pinhoquieto.‡Отнесите шкуру Куркена Мурдо в логово племени Тихвой.‡Bringt Kurkens Balg zu Moordo bei der Tannenruhfeste.‡너울소나무 요새에 있는 무르도에게 쿠르켄의 통가죽을 가져가야 합니다.‡Entrega el pellejo de El Kurken a Moordo en el Bastión Semprepino.‡Entrega el pellejo de El Kurken a Moordo en el Bastión Semprepino.‡Donnez la Peau du Kurken à Moordo, au repaire des Calmepins.‡将库肯的毛皮交给止松要塞的莫多。‡將克爾肯的皮送給靜松要塞的墨爾多。',
  }
},
[9572] = {
  {
    'Enfraquecer as defesas‡Ослабить оборону валов‡Die Bollwerke schwächen‡성루 무력화‡Debilitar la muralla‡Debilitar la muralla‡Affaiblir les remparts‡攻陷城墙‡削弱防禦',
    nil,
    'Mate o Guarda Gargulmar; Omor, o Intocado; e o draco Nazan. Traga a Mão de Gargulmar, o Casco de Omor e a Cabeça de Nazan para Caza\'rez em Thrallmar, que fica na Península Fogo do Inferno.‡Убейте начальника стражи Гарголмара, Омора Неодолимого и дракона Назана. Принесите руку Гарголмара, копыто Омора и голову Назана Каза\'ресу в Траллмар на Полуострове Адского Пламени.‡Tötet den Wachhabenden Gargolmar, Omor den Narbenlosen und Nazan, den Drachen. Bringt Gargolmars Hand, Omors Huf und Nazans Kopf zu Caza\'rez in Thrallmar auf der Höllenfeuerhalbinsel.‡감시자 가르골마르, 무적의 오모르, 비룡 나잔을 처치한 후, 지옥불 반도의 스랄마에 있는 카자레즈에게 가르골마르의 오른팔, 오모르의 발굽, 나잔의 머리를 가져가야 합니다.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Tuez le gardien des guetteurs Gargolmar, Omor l\'Intouché et le drake Nazan. Rapportez la Main de Gargolmar, le Sabot d\'Omor et la Tête de Nazan à Caza\'rez, à Thrallmar dans la péninsule des Flammes infernales.‡杀死巡视者加戈玛、无疤者奥摩尔和座龙纳杉，并将加戈玛之手、奥摩尔之蹄和纳杉之颅交给地狱火半岛上的萨尔玛内的卡萨雷兹。‡殺死看護者卡爾古瑪、無疤者歐瑪爾和納桑。將卡爾古瑪之手、歐瑪爾的蹄子和納桑之顱帶到地獄火半島的索爾瑪交給卡沙瑞斯。',
  }
},
[9573] = {
  {
    'Chefe Umuuruu‡Вождь Умуру‡Häuptling Oomooroo‡족장 우무루 처치‡El cabecilla Oomooroo‡El cabecilla Oomooroo‡Le chef Oomooroo‡欧莫鲁酋长‡歐沐魯酋長',
    nil,
    'Pinhoquieto, o Jovem, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você mate o Chefe Umuuruu e 9 Coruscantes Enlouquecidos.‡Убейте вождя Умуру и 9 безумных диких совухов.‡Der Jüngling Tannenruh bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr Häuptling Oomooroo und 9 wahnsinnige Wildekin tötet.‡하늘안개 섬의 너울소나무 요새에 있는 젊은 너울소나무가 족장 우무루, 정신나간 올빼미야수 9마리를 처치해 달라고 부탁했습니다.‡Semprepino el Menor del Bastión Semprepino en la Isla Bruma Azur quiere que mates al cabecilla Oomooroo y a 9 lechúcico salvaje enloquecido.|n‡Semprepino el Menor del Bastión Semprepino en la Isla Bruma Azur quiere que mates al cabecilla Oomooroo y a 9 lechúcico salvaje enloquecido.|n‡Calmepin le Jeune, du repaire des Calmepins de l\'île de Brume-azur, veut que vous tuiez le chef Oomooroo et 9 Indomptables affolés.‡秘蓝岛止松要塞的止松酋长要求你杀死欧莫鲁酋长和9只发狂的野枭兽。‡藍謎島，靜松要塞的靜松年少者要你殺死歐沐魯酋長和9個瘋狂的梟獸。',
  }
},
[9574] = {
  {
    'Vítimas da corrupção‡Отравленные скверной‡Opfer der Verderbnis‡오염의 희생자‡Víctimas de la corrupción‡Víctimas de la corrupción‡Victimes de la corruption‡腐蚀的牺牲品‡腐敗的受害者',
    nil,
    'Entregue 6 pedaços de Casca Cristalizada para Morae no Entreposto Rubro.‡Принесите на Кровавую заставу 6 кусков коры, покрытой кристаллами, и отдайте Морэ.‡Bringt 6 Stücke kristallisierte Rinde zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 결정화된 나무껍질 6개를 가져가야 합니다.‡Llévale 6 trozos de corteza cristalizada a Morae en la Avanzada de Sangre.‡Llévale 6 trozos de corteza cristalizada a Morae en la Avanzada de Sangre.‡Apportez 6 morceaux d’Ecorce cristallisée à Morae, au Guet du sang.‡找到6片晶化树皮，把它们交给秘血岗哨的莫莱。‡帶6塊晶化樹皮給血色守望的莫瑞伊。',
  }
},
[9575] = {
  {
    'Enfraquecer as defesas‡Ослабить оборону валов‡Die Bollwerke schwächen‡성루 무력화‡Debilitar la muralla‡Debilitar la muralla‡Affaiblir les remparts‡攻陷城墙‡削弱防禦',
    nil,
    'Mate o Guarda Gargulmar; Omor, o Intocado; e o draco Nazan. Traga a Mão de Gargulmar, o Casco de Omor e a Cabeça de Nazan para o Gunny na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Убейте начальника стражи Гарголмара, Омора Неодолимого и дракона Назана. Принесите руку Гарголмара, копыто Омора и голову Назана Пушкаренку в Оплот Чести на полуострове Адского Пламени.‡Tötet den Wachhabenden Gargolmar, Omor den Narbenlosen und Nazan, den Drachen. Bringt Gargolmars Hand, Omors Huf und Nazans Kopf zu Gunny in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡감시자 가르골마르, 무적의 오모르, 비룡 나잔을 처치한 후, 지옥불 반도의 명예의 요새에 있는 구니에게 가르골마르의 오른팔, 오모르의 발굽, 나잔의 머리를 가져가야 합니다.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Tuez le gardien des guetteurs Gargolmar, Omor l\'Intouché et le drake Nazan. Rapportez la Main de Gargolmar, le Sabot d’Omor et la Tête de Nazan à Flingot, du bastion de l\'Honneur dans la péninsule des Flammes infernales.‡杀死巡视者加戈玛、无疤者奥摩尔和座龙纳杉，并将加戈玛之手、奥摩尔之蹄和纳杉之颅交给地狱火半岛上的荣耀堡内的冈尼。‡殺死看護者卡爾古瑪、無疤者歐瑪爾和納桑。將卡爾古瑪之手、歐瑪爾的蹄子和納桑之顱帶到地獄火半島的榮譽堡給甘尼。',
  }
},
[9576] = {
  {
    'O colar de Cruelo‡Ожерелье Жестокого Плавника‡Schandflosses Anhänger‡뾰족갈퀴의 목걸이‡El colgante de Cruelfin‡El colgante de Aleta Cruel‡Le collier d\'Aileron-cruel‡克鲁芬的项链‡酷鰭的項鍊',
    nil,
    'Entregue o Pingente de Cristal Vermelho para Morae no Entreposto Rubro.‡Покажите подвеску красного кристалла Морэ на Кровавой заставе.‡Bringt den roten Kristallanhänger zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 붉은 수정 펜던트를 가져가야 합니다.‡Llévale el colgante de cristal rojo a Morae en la Avanzada de Sangre.‡Llévale el colgante de cristal rojo a Morae en la Avanzada de Sangre.‡Rapportez le Pendentif de cristal rouge à Morae au Guet du sang.‡将红色水晶坠饰交给秘血岗哨的莫莱。‡將紅色水晶綴飾帶給血色守望的莫瑞伊。',
  }
},
[9577] = {
  {
    '‡‡‡‡‡‡‡‡!REUSE ME!',
    nil,
    '‡‡‡‡‡‡‡‡Speak with <QUESTGIVER> in the <AREA>.',
  }
},
[9578] = {
  {
    'À procura de Galaen‡В поисках Галена‡Suche nach Galaen‡갈라엔의 생사 확인‡En busca de Galaen‡En busca de Galaen‡À la recherche de Galaen‡搜寻加莱恩‡尋找高拉恩',
    nil,
    'Procure Galaen, o marido de Morae.‡Найдите Галена, мужа Морэ.‡Sucht nach Moraes Mann Galaen.‡모라에의 남편 갈라엔을 찾아야 합니다.‡Busca al marido de Morae, Galaen.‡Busca al marido de Morae, Galaen.‡Retrouvez Galaen, le mari de Morae.‡寻找莫莱的丈夫加莱恩。‡尋找莫瑞伊的丈夫高拉恩。',
  }
},
[9579] = {
  {
    'O destino de Galaen‡Судьба Галена‡Galaens Schicksal‡갈라엔의 운명‡El sino de Galaen‡El sino de Galaen‡Le destin de Galaen‡加莱恩的命运‡高拉恩的命運',
    nil,
    'Entregue o Amuleto de Galaen para Morae no Entreposto Rubro.‡Принесите на Кровавую заставу амулет Галена и отдайте его Морэ.‡Bringt Galaens Amulett zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 갈라엔의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Galaen a Morae en la Avanzada de Sangre.‡Llévale el amuleto de Galaen a Morae en la Avanzada de Sangre.‡Remettez l’Amulette de Galaen à Morae au Guet du sang.‡将加莱恩的护符交给秘血岗哨的莫莱。‡將高拉恩的護符帶給血色守望的莫瑞伊。',
  }
},
[9580] = {
  {
    'Necessidades ursinas‡Вскормленные медвежатиной‡Bärdarfsgüter‡식량 수집‡Las necesidades del oso‡Las necesidades del oso‡Les premiers sec-ours‡猎熊‡熊的必需品',
    nil,
    'Entregue 8 Flancos de Urso Marrom Ancião para o Rastreador Lyceon no Entreposto Rubro.‡Принесите зверолову Лисеону на Кровавую заставу 8 кусков мяса с боков старых бурых медведей.‡Bringt 8 Flanken eines alten Braunbären zu Fährtenleser Lyceon bei der Blutwacht.‡핏빛 전초기지에 있는 추적자 리시온에게 덩치큰 불곰 갈빗살 8개를 가져가야 합니다.‡Llévale 8 costillares de oso marrón adulto al rastreador Lyceon en la Avanzada de Sangre.‡Llévale 8 costillares de oso marrón adulto al rastreador Lyceon en la Avanzada de Sangre.‡Le pisteur Lyceon, du Guet du sang, veut 8 Flanchets d\'anciens ours bruns.‡收集8块老年棕熊的肉，把它们交给秘血岗哨的追踪者兰塞恩。‡帶8塊老棕熊腰肉給血色守望的追蹤者萊希安。',
  }
},
[9581] = {
  {
    'Aprender com os cristais‡Изучение кристаллов‡Von den Kristallen lernen‡수정 견본 확보‡Las lecciones de los cristales‡Las lecciones de los cristales‡Ce qu\'apprennent les cristaux‡研究水晶‡水晶的學問',
    nil,
    'Usando a Picareta de Mineração de Cristais no Cristal do Local de Impacto, recolha uma Amostra de Cristal e entregue-a ao Emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места крушения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Kristallprobe der Absturzstelle von einem Kristall der Absturzstelle zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡충돌 지점 수정에 수정 채광용 곡괭이를 사용하여 충돌 지점 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 가져가야 합니다.‡Consigue una muestra de cristal del lugar del accidente usando el pico de minero de cristales en el cristal del lugar del accidente y llévalo al presagista Mikolaas de la Avanzada de Sangre.‡Consigue una muestra de cristal del lugar del accidente usando el pico de minero de cristales en el cristal del lugar del accidente y llévalo al presagista Mikolaas de la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal du site de l\'impact en utilisant la Pioche à cristaux sur le Cristal du site de l\'impact et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在坠毁点水晶上采集一份坠毁点水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對衝擊遺址水晶使用水晶採礦鎬以取得衝擊遺址水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9582] = {
  {
    'Prova de força‡Силой единой‡Die Stärke des Einen‡죽음의 칼날발톱‡La fuerza de uno solo‡La fuerza de uno solo‡La force de l’Un‡一人之力‡一人的力量',
    nil,
    'Abra a Jaula do Assolador e mate o Assolador Mortal. Em seguida, fale com Ruada no Entreposto Lazúli, que fica em Névoa Lazúli.‡Откройте клетку смертоносного опустошителя, убейте его и вернитесь к Руаде на Лазурную заставу на острове Лазурной Дымки.‡Öffnet den Felshetzerkäfig und tötet den darin befindlichen Todesfelshetzer. Kehrt dann zu Ruada in der Azurwacht auf der Azurmythosinsel zurück.‡칼날발톱 우리를 열고 그 안에 있는 죽음의 칼날발톱을 처치한 후, 하늘안개 섬에 하늘 감시초소에 있는 루아다에게 돌아가야 합니다.‡Abre la jaula del devastador, mata al devastador de la Muerte, y regresa junto a Ruada en la Avanzada Azur, en la Isla Bruma Azur.‡Abre la jaula del devastador, mata al devastador de la Muerte, y regresa junto a Ruada en la Avanzada Azur, en la Isla Bruma Azur.‡Ouvrez la Cage du ravageur et tuez le Ravageur de la mort qui s’y trouve, puis retournez voir Ruada au Guet d’azur, sur l’île de Brume-Azur.‡打开掠食者的牢笼，干掉死亡掠食者，然后向碧蓝岗哨的鲁安达复命。‡打開劫毀者牢籠殺死死亡劫毀者，再回藍謎島的藍色守望找羅達。',
  }
},
[9583] = {
  {
    '‡‡‡‡‡‡‡‡Omar\'s Test Quest',
    nil,
    '‡‡‡‡‡‡‡‡幫歐瑪拿衣服',
  }
},
[9584] = {
  {
    'A segunda amostra‡Второй образец‡Die zweite Probe‡두 번째 수정 견본‡La segunda muestra‡La segunda muestra‡Le deuxième échantillon‡第二份样本‡第二個樣本',
    nil,
    'Colete uma Amostra de Cristal Alterado do Cristal de Névoa Rubra Alterado usando a Picareta de Mineração de Cristais e entregue-a ao emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места столкновения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте его предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Veränderte Kristallprobe von einem veränderten Blutmythoskristall zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡변형된 핏빛안개 수정에 수정 채광용 곡괭이를 사용하여 변형된 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 돌아가야 합니다.‡Consigue una muestra de cristal alterado utilizando el pico de minero de cristal en el cristal de Bruma de Sangre modificado al presagista Mikolaas de la Avanzada de Sangre.‡Consigue una muestra de cristal alterado utilizando el pico de minero de cristal en el cristal de Bruma de Sangre modificado al presagista Mikolaas de la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal altéré en utilisant la Pioche à cristaux sur le Cristal de Brume-Sang altéré et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在变异的秘血水晶上采集一份变异水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對變質的血謎水晶使用水晶採礦鎬以取得變質的水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9585] = {
  {
    'A última amostra‡Последний образчик‡Die letzte Probe‡마지막 수정 견본‡La última muestra‡La última muestra‡Le dernier échantillon‡最终的样本‡最後的樣本',
    nil,
    'Colete uma Amostra de Cristal Axxarien do Cristal Axxarien usando a Picareta de Mineração de Cristais e entregue-a ao emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места столкновения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Axxarienkristallprobe von einem Axxarienkristall zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡악사리엔 수정에 수정 채광용 곡괭이를 사용하여 악사리엔 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 돌아가야 합니다.‡Consigue una muestra de cristal Axxarien utilizando el Pico de minero de cristales en el cristal axxarien y llévaselo al heraldo en la Avanzada de Sangre.‡Consigue una muestra de cristal Axxarien utilizando el Pico de minero de cristales en el cristal Axxarien y llévaselo al heraldo en la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal axxarien en utilisant la Pioche à cristaux sur le Cristal axxarien et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在阿克萨林水晶上采集一份阿克萨林水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對艾克薩瑞安水晶使用水晶採礦鎬以取得艾克薩瑞安水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9586] = {
  {
    'Ajude Tavera‡Помощь Таваре‡Helft Tavara‡타바라 돕기‡Ayudar a Tavara‡Ayudar a Tavara‡Aider Tavara‡帮助塔瓦拉‡幫助塔瓦拉',
    nil,
    'Guvan, no Entreposto Lazúli, quer que você encontre Tavera e cure as feridas dela.‡Найдите Тавару и исцелите ее раны.‡Guvan bei der Azurwacht möchte, dass Ihr Tavara findet und ihre Wunden heilt.‡하늘 감시초소에 있는 구반이 타바라를 찾아서 상처를 치료해 달라고 부탁했습니다.‡Guvan de la Avanzada Azur quiere que encuentres a Tavara y cures sus heridas.‡Guvan de la Avanzada Azur quiere que encuentres a Tavara y cures sus heridas.‡Guvan du Guet d’azur veut que vous trouviez Tavara et que vous guérissiez ses blessures.‡碧蓝岗哨的古安要求你找到塔瓦拉并治好她的伤势。‡藍色守望的古樊要你找到塔瓦拉並治療她的傷口。',
  }
},
[9587] = {
  {
    'Notícias sombrias‡Предвестье беды‡Düstere Neuigkeiten‡어둠의 형세‡Aciagas nuevas‡Aciagas nuevas‡De sombres nouvelles‡黑暗之潮‡黑暗的消息',
    nil,
    'Leve a Carta Agourenta para o Comandante-chefe Danath Matatroll na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Доставьте угрожающее письмо боевому командиру Данату Троллебою в Оплот Чести на полуострове Адского Пламени.‡Bringt den unheilvollen Brief zu Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡지옥불 반도의 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 불길한 편지를 가져가야 합니다.‡Ve al Bastión del Honor, en la Península del Fuego Infernal, y entrégale al Comandante en Jefe Danath Aterratrols la carta agorera.‡Ve al Bastión del Honor, en la Península del Fuego Infernal, y entrégale al comandante en jefe Danath Aterratrols la carta agorera.‡Apportez la Lettre inquiétante au commandant Danath Trollemort au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡将不祥的信件交给地狱火半岛上荣耀堡的远征军指挥官达纳斯·托尔贝恩。‡將不祥的信件帶到地獄火半島交給榮譽堡的軍隊指揮者達納斯·托爾貝恩。',
  }
},
[9588] = {
  {
    'Notícias sombrias‡Предвестье беды‡Düstere Neuigkeiten‡어둠의 형세‡Aciagas nuevas‡Aciagas nuevas‡De sombres nouvelles‡黑暗之潮‡黑暗的消息',
    nil,
    'Leve a Carta Agourenta para Nazgrel em Thrallmar, que fica na Península Fogo do Inferno.‡Доставьте угрожающее письмо Назгрелу в Траллмар на Полуострове Адского Пламени.‡Bringt den unheilvollen Brief zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 불길한 편지를 가져가야 합니다.‡Lleva la carta agorera a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Lleva la carta agorera a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Apportez la Lettre inquiétante à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将不祥的信件交给地狱火半岛上萨尔玛的纳兹格雷尔。‡將不祥的信件帶到地獄火半島交給索爾瑪的納茲格雷爾。',
  }
},
[9589] = {
  {
    'Sangue é vida‡Кровь есть жизнь‡Blut bedeutet Leben‡생명의 근원‡La sangre es vida‡La sangre es vida‡Le sang, c\'est la vie‡鲜血就是生命‡血液就是生命',
    nil,
    'Recolha 10 Frascos de Sangue de Orc Vil e entregue-os a Gunny na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Принесите 10 фиалов крови орков Скверны Пушкаренку в Оплот Чести на полуострове Адского Пламени.‡Sammelt 10 Phiolen mit Höllenorcblut und bringt sie zu Gunny in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡타락한 오크의 혈액 견본 10개를 모아서 지옥불 반도의 명예의 요새에 있는 구니에게 가져가야 합니다.‡Reúne 10 viales de sangre de orco vil y regresa junto a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Reúne 10 viales de sangre de orco vil y regresa junto a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Récupérez 10 Fioles de sang de gangr\'orc et rapportez-les à Flingot au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡收集10份邪兽人血样，把它们交给地狱火半岛上的荣耀堡内的冈尼。‡收集10個魔獄獸人血瓶後回到地獄火半島的榮譽堡找甘尼。',
  }
},
[9590] = {
  {
    'Sangue é vida‡Кровь есть жизнь‡Blut bedeutet Leben‡The Blood is Life‡La sangre es vida‡La sangre es vida‡Le sang, c\'est la vie‡鲜血就是生命‡血液就是生命',
    nil,
    'Recolha 10 Frascos de Sangue de Orc Vil e entregue-os ao Centurião Caza\'rez em Thrallmar, que fica na Península Fogo do Inferno.‡Принесите 10 фиалов крови орков Скверны центуриону Каза\'ресу в Траллмар на Полуострове Адского Пламени.‡Sammelt 10 Phiolen mit Höllenorcblut und bringt sie zu Zenturio Caza\'rez in Thrallmar auf der Höllenfeuerhalbinsel.‡Collect 10 Fel Orc Blood Vials and return them to Centurion Caza\'rez at Thrallmar in Hellfire Peninsula.‡Consigue 10 viales de sangre de orcos viles y llévaselos al centurión Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Consigue 10 viales de sangre de orcos viles y llévaselos al centurión Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Collectez 10 Fioles de sang de gangr\'orc et rapportez-les au centurion Caza\'rez à Thrallmar dans la péninsule des Flammes infernales.‡收集10份邪兽人血样，把它们交给地狱火半岛上的萨尔玛内的卡萨雷兹。‡收集10個魔獄獸人血瓶帶回地獄火半島的索爾瑪給百夫長卡沙瑞斯。',
  }
},
[9591] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡미늘가시게 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Barbatisco e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите колючего краба. Вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen Stachelkriecher zu bändigen. Kehrt nach gelungenem Unterfangen zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 미늘가시게를 길들인 후 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un reptador con púas y vuelve junto a la cazadora Kella Arconocturno cuando lo hayas conseguido.‡Usa el Tótem de doma para domesticar un reptador con púas y vuelve junto a la cazadora Kella Arconocturno cuando lo hayas conseguido.‡Utilisez le Totem de domptage pour apprivoiser un Clampant barbelé et revenez voir la chasseresse Kella Arquenuit lorsque vous aurez réussi.‡使用驯兽图腾驯化一只带刺的螃蟹，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和尖刺的爬行者做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9592] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡수풀타조 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Xilostruz Maior e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите большого лесонога, после чего вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen großen Grünschreiter zu bändigen und kehrt anschließend zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 커다란 수풀타조를 길들인 후, 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un maderazancudo superior y vuelve junto a la cazadora Kella Arconocturno.‡Usa el Tótem de doma para domesticar un maderazancudo superior y vuelve junto a la cazadora Kella Arconocturno.‡Utilisez le Totem de domptage pour apprivoiser un Trotteur des bois supérieur et retournez voir la chasseresse Kella Arquenuit.‡使用驯兽图腾驯化一只巨型林地陆行鸟，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和大林地陸行鳥做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9593] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡흑호 길들이기‡Domar a la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Espreitanoite e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите ночного ловца. Вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen Nachtpirscher zu bändigen und kehrt anschließend zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 흑호를 길들인 후 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un acechador nocturno y vuelve junto a la cazadora Kella Arconocturno.‡Usa el Tótem de doma para domesticar un acechador nocturno y vuelve junto a la cazadora Kella Arconocturno.‡Utilisez le Totem de domptage pour apprivoiser un Traquenuit et revenez voir la chasseresse Kella Arquenuit.‡使用驯兽图腾驯化一只夜行豹，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和夜間潛伏者做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9594] = {
  {
    'Os sinais da Legião‡Знаки Легиона‡Zeichen der Legion‡불타는 군단의 조짐‡Signos de la Legión‡Signos de la Legión‡Les signes de la Légion‡军团的徽记‡燃燒軍團的徵象',
    nil,
    'Mate 8 Sátiros Nazzivus e 8 Devotos Vis Nazzivus. Em seguida, entregue a Placa de Armadura do Tzerak para a Vindicante Aalesia no Entreposto Rubro.‡Убейте 8 сатиров из племени Наззивус и 8 скверноподданных из племени Наззивус, а затем отнесите латный доспех Тзерака воздаятельнице Аалезии на Кровавую заставу.‡Tötet 8 Satyrn der Nazzivus und 8 Teufelsanbeter der Nazzivus. Bringt anschließend Tzeraks Panzerplatte zu Verteidigerin Aalesia bei der Blutwacht.‡나지부스 사티로스 8명, 나지부스 악마추종자 8명을 처치한 후, 핏빛 감시초소에 있는 구원자 알레시아에게 트제라크의 판금 갑옷 조각을 가져가야 합니다.‡Mata a ocho sátiros Nazzivus y a ocho Jurapenas Nazzivus, y lleva la placa de armadura de Tzerak a la vindicadora Aalesia de la Avanzada de Sangre.‡Mata a ocho sátiros Nazzivus y a ocho Jurapenas Nazzivus, y lleva la placa de armadura de Tzerak a la vindicadora Aalesia de la Avanzada de Sangre.‡Tuez 8 Satyres Nazzivus et 8 Gangreliges Nazzivus, puis apportez la Plaque d\'armure de Tzerak au redresseur de torts Aalesia, au Guet du sang.‡除掉8个纳兹维安萨特和8个纳兹维安魔誓者，然后将瑟拉克的护甲块交给秘血岗哨的守备官艾蕾希亚。‡殺死8個納茲維斯薩特和8個納茲維斯魔語，然後帶著泰斯拉克的鎧甲到血色守望找復仇者艾樂希雅。',
  }
},
[9595] = {
  {
    'Controle‡Контроль‡Kontrolle‡마법의 노예‡Control‡‡Contrôle‡控制‡',
    nil,
    'Mate os Murlocs da Baía do Limo para evocar um Magespectro Quel\'dorei e, então, destrua-o. Em seguida, fale com Rate na Cripta das Luzes, na Exodar.‡Убивайте мурлоков с Илистого Берега до тех пор, пока не появится призрак кель\'дорайского мага, затем уничтожьте его. После этого поговорите с Бати в Чертоге Света Экзодара.‡Vernichtet die Murlocs der Schlickerküste, um einen Magiergeist der Quel\'dorei zu rufen, und vernichtet ihn. Sprecht dann mit Bati in der Halle des Lichts in der Exodar.‡개펄 해안의 멀록을 처치하여 쿠엘도레이 마법사 망령이 나타나게 한 후 그를 처치하고 엑소다르 빛의 전당에 있는 바티와 대화해야 합니다.‡Mata múrlocs de La Costa de Cieno para invocar a la ánima maga quel\'dorei. Destrúyela y ve a hablar con Bati en El Arca de las Luces de El Exodar.‡Mata múrlocs de La Costa de Cieno para invocar a la ánima maga quel\'dorei. Destrúyela y ve a hablar con Bati en El Arca de las Luces de El Exodar.‡Tuez des Murlocs sur le Rivage envasé pour invoquer une Âme en peine quel\'dorei magicienne, puis détruisez-la. Allez ensuite parler à Bati à la Voûte des lumières de l\'Exodar.‡杀死淤泥海岸附近的鱼人以召唤出奎尔多雷法师怨灵，并消灭它。完成之后与埃索达圣光穹顶的巴蒂谈一谈。‡',
  }
},
[9598] = {
  {
    'Redemption‡Искупление‡Erlösung‡구원‡Redención‡Redención‡Rédemption‡救赎‡救贖',
    nil,
    'Estude o Tomo de Divindade e fale com Jol.‡Прочтите Фолиант Божественности и поговорите с Джоль.‡Lest das Buch der Offenbarung und sprecht mit Jol.‡신앙의 고서를 공부한 후에 졸과 대화해야 합니다.‡Estudia el Libro de Divinidad y habla con Jol.‡Estudia el Libro de Divinidad y habla con Jol.‡Étudiez le Tome de divinité et parlez à Jol.‡阅读圣洁之书后和约尔谈一谈。‡研讀聖潔之書並且跟喬歐談話。',
  }
},
[9599] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡ 신앙의 고서‡<UNUSED>‡‡<UNUSED>‡<UNUSED>‡',
    nil,
    'Speak with Jol in the Exodar.‡Speak with Jol in the Exodar.‡Sprecht mit Jol in der Exodar.‡엑소다르에 있는 졸과 대화해야 합니다.‡Habla con Jol en El Exodar.‡Habla con Jol en El Exodar.‡Parlez à Jol, à l\'Exodar.‡Speak with Jol in the Exodar.‡',
  }
},
[9600] = {
  {
    'Redemption‡Искупление‡Erlösung‡구원의 길‡Redención‡Redención‡Rédemption‡救赎‡救贖',
    nil,
    'Jol quer que você ressuscite um Xamã Pelurso Jovem com o Símbolo da Vida e fale novamente com ela.‡Воскресите молодого фурболга-шамана из племени Тихвой при помощи знака Жизни, а затем вернитесь к Джоль.‡Jol möchte, dass Ihr einen jungen Schamanen der Furbolgs mit dem Symbol des Lebens wieder zum Leben erweckt und dass Ihr anschließend wieder zu ihr zurückkehrt.‡생명의 징표를 사용하여 젊은 펄볼그 주술사를 부활시킨 후, 상급 성기사인 졸에게 돌아가야 합니다.‡Jol quiere que resucites al chamán fúrbolg joven con el Símbolo de la Vida y después se lo devuelvas.‡Jol quiere que resucites al chamán fúrbolg joven con el Símbolo de la Vida y después se lo devuelvas.‡Jol veut que vous vous serviez du Symbole de vie pour ressusciter un Jeune chaman furbolg avant de revenir la voir.‡约尔希望你利用生命符记复活一个年轻的熊怪萨满祭司，然后回去向她复命。‡',
  }
},
[9601] = {
  {
    'Ao Baluarte‡В Бастион‡Zum Bollwerk‡보루를 향한 여정‡Hacia El Baluarte‡Hacia El Baluarte‡En route pour la Barricade‡前往亡灵壁垒‡前進亡靈壁壘',
    nil,
    'Fale com Mehlar Aurolume no Baluarte.‡Поговорите с Меларом Клинком Рассвета из Бастиона.‡Sprecht mit Mehlar Dämmerklinge beim Bollwerk.‡보루에 있는 메라 돈블레이드와 대화해야 합니다.‡Habla con Mehlar Hojalba en El Baluarte.‡Habla con Mehlar Hojalba en El Baluarte.‡Parlez à Mehlar Aubelame à la Barricade.‡与亡灵壁垒的麦拉·黎明之刃谈一谈。‡和在亡靈壁壘的瑪拉·曦刃談談。',
  }
},
[9602] = {
  {
    'Livrai-os de todo mal...‡Избавь их от лукавого...‡Unheilvolle Mitteilung‡반역자의 교신 내용 전달‡Líbralos del mal...‡Líbralos del mal...‡Délivrez-les du mal...‡邪恶的书信‡傳遞不幸的消息……',
    nil,
    'Entregue o Comunicado do Traidor ao Exarca Menelaus, no Entreposto Lazúli.‡Отнесите переписку предателя экзарху Менелаусу на Лазурную заставу.‡Bringt die Mitteilung des Verräters zu Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스에게 반역자의 교신 내용을 가져가야 합니다.‡Entrega la comunicación del traidor al exarca Menelaous en la Avanzada Azur.‡Entrega la comunicación del traidor al exarca Menelaous en la Avanzada Azur.‡Remettre la Communication du traître à l\'exarque Menelaous au Guet d\'azur.‡将叛徒的证据交给碧蓝岗哨的大主教梅内莱厄斯。‡將背叛者的信件帶給藍色守望的主教米奈奧斯。',
  }
},
[9603] = {
  {
    'Roupa de cama, mesa e etc‡Лежанки, лекарства и прочая ерунда‡Betten, Verbände und noch viel mehr‡토퍼의 목록 전달‡Camas, vendas y algo más‡Camas, vendas y algo más‡Des lits, des bandages, etc.‡床铺，绷带，以及更多‡床，繃帶，和很多很多',
    nil,
    'Leve a Lista do Topher a Laando, o Mestre de Hipogrifos, no Entreposto Rubro.‡Отвезите список Тофера на Кровавую заставу дрессировщику гиппогрифов Лаандо.‡Bringt Tophers Liste zu Laando, dem Hippogryphenmeister bei der Blutwacht.‡핏빛 감시초소에 있는 히포그리프 조련사 라안도에게 토퍼의 목록을 가져가야 합니다.‡Llévale la lista de Topher a Laando, el maestro de hipogrifos de la Avanzada de Sangre.‡Llévale la lista de Topher a Laando, el maestro de hipogrifos de la Avanzada Azur.‡Remettez la Liste de Topher à Laando, le maître des hippogriffes du Guet du sang.‡将托菲尔的清单交给秘血岗哨的角鹰兽管理员兰度。‡把塔伏爾的單子交給血色守望的角鷹獸管理員勒藍度。',
  }
},
[9604] = {
  {
    'Nas asas do hipogrifo‡На крыльях гиппогрифа‡Auf dem Rücken eines Hippogryphen‡히포그리프에 몸을 싣고‡En alas de un hipogrifo‡En alas de un hipogrifo‡Sur les ailes d\'un hippogriffe‡乘坐角鹰兽‡飛快的角鷹獸',
    nil,
    'Pague Laando por uma viagem de hipogrifo até a Exodar. Ao pousar, leve a Lista do Topher a Nurguni na Sede dos Naarus, que fica na Exodar.‡Возьмите у Лаандо гиппогрифа и летите в Экзодар. В Экзодаре отдайте список Тофера Нургуни. Нургуни можно найти у трона Наару в Экзодаре.‡Erwerbt bei Laando einen Hippogryphenritt zur Exodar. Bringt Tophers Liste nach der Landung zu Nurguni im Sitz der Naaru der Exodar.‡라안도에게 히포그리프를 빌려 엑소다르로 간 후, 나루의 보좌에 있는 누르구니에게 토퍼의 목록을 가져가야 합니다.‡Cómprale a Laando un viaje en hipogrifo a El Exodar. Cuando aterrices, llévale la lista de Topher a Nurguni en el Trono de los Naaru, en El Exodar.‡Cómprale a Zaldaan un viaje en hipogrifo a El Exodar. Cuando aterrices, llévale la lista de Chellan a Nurguni en el Trono de los Naaru, en El Exodar.‡Acheter à Laando un vol en hippogriffe jusqu\'à l\'Exodar. À votre arrivée, remettez la Liste de Topher à Nurguni, au Siège du naaru dans l\'Exodar.‡乘坐角鹰兽从兰度处飞往埃索达。到达后，将托菲尔的清单交给纳鲁之座的努古尼。‡向勒藍度那租借一隻角鷹獸飛往艾克索達，抵達後，將塔伏爾的單子交給那魯之座的魯古尼。',
  }
},
[9605] = {
  {
    'O mestre de hipogrifos Stephanos‡Укротитель гиппогрифов Стефанос‡Hippogryphenmeister Stephanos‡히포그리프 조련사 스테파노스‡El maestro de hipogrifos Stephanos‡El maestro de hipogrifos Stephanos‡Le maître des hippogriffes Stephanos‡斯泰法努斯‡角鷹獸管理員史丹樊那斯',
    nil,
    'Fale com Stephanos diante da Exodar e compre uma viagem de hipogrifo de volta ao Entreposto Rubro.‡Найдите Стефаноса у ворот Экзодара и наймите гиппогрифа для возвращения на Кровавую заставу.‡Geht zu Stephanos in der Exodar und erwerbt einen Hippogryphenritt zurück zur Blutwacht.‡엑소다르 외부에 스테파노스를 찾아서 히포그리프를 타고 핏빛 감시초소로 돌아가야 합니다.‡Encuentra a Stephanos en las afueras de El Exodar y compra un viaje en hipogrifo para volver a la Avanzada de Sangre.‡Encuentra a Stephanos en El Trono de los Naaru en el interior de El Exodar y compra un viaje en hipogrifo para volver a la Avanzada Azur.‡Allez trouver Stephanos à l\'extérieur de l\'Exodar et achetez-lui un vol à dos d\'hippogriffe pour rentrer au Guet du sang.‡找到埃索达外的斯泰法努斯，乘坐他的角鹰兽回到秘血岗哨。‡到艾克索達外去找史丹樊那斯，並乘坐角鷹獸回到血色守望。',
  }
},
[9606] = {
  {
    'Fale novamente com Topher Loaal‡Возвращение к Тоферу Лоаалу‡Zurück zu Topher Loaal‡토퍼 로알에게 돌아가기‡Regreso junto a Topher Loaal‡Regresa junto a la cuidadora Chellan‡Retourner voir Topher Loaal‡返回托菲尔·罗阿身边‡回到塔伏爾·羅歐那裡',
    nil,
    'Fale com Stephanos e pague uma viagem de hipogrifo de volta ao Entreposto Rubro. Quando chegar, entregue os Suprimentos de Nurguni ao Hospedeiro Topher Loaal.‡Договоритесь со Стефаносом и наймите у него гиппогрифа для путешествия на Кровавую заставу. На заставе доставьте припасы Нургуни корчмарю Тоферу Ололо.‡Sprecht mit Stephanos und erwerbt einen Hippogryphenritt zurück zur Blutwacht. Bringt Nurgunis Vorräte nach Eurer Ankunft zu Versorger Topher Loaal.‡스테파노스와 대화한 후 히포그리프를 타고 핏빛 감시초소로 돌아가 도착한 후, 간병인 토퍼 로알에게 누르구니의 보급상자를 가져가야 합니다.‡Habla con Stephanos para comprar un viaje en hipogrifo de vuelta a la Avanzada de Sangre. Cuando llegues, entrégale los suministros de Nurguni al cuidador Topher Loaal.‡Habla con Stephanos para comprar un viaje en hipogrifo de vuelta a la Avanzada Azur. Cuando llegues, entrégale los suministros de Nurguni a la cuidadora Chellan.‡Achetez à Stephanos un vol en hippogriffe pour rentrer au Guet du sang. Une fois <arrivé/arrivée>, livrez les Fournitures de Nurguni à l\'Hôte Topher Loaal.‡与斯泰法努斯谈一谈，然后租用一头角鹰兽回秘血岗哨。达到后，将努古尼的补给品交给托菲尔·罗阿。‡與史丹樊那斯租借一隻角鷹獸回到血色守望。一旦抵達後，運送魯古尼的補給品給照顧者塔伏爾·羅歐',
  }
},
[9607] = {
  {
    'Coração da ira‡В сердце ярости‡Im Herzen des Hasses‡격노의 한복판‡Corazón furioso‡Corazón de ira‡Cœur de rage‡愤怒之心‡狂怒之心',
    nil,
    'Investigue a Fornalha de Sangue por completo e então apresente-se ao Comandante-chefe Danath Matatroll na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Детально изучите Кузню Крови и доложите об увиденном командиру армии Данату Троллебою в Оплот Чести на полуострове Адского Пламени.‡Untersucht das gesamte Areal des Blutkessels und meldet Euch anschließend bei Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡피의 용광로를 샅샅이 조사한 후, 지옥불 반도의 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 보고해야 합니다.‡Investiga a fondo El Horno de Sangre y después informa al Comandante en Jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Investiga a fondo El Horno de Sangre y después informa al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Faire une enquête exhaustive sur la Fournaise du sang, puis en faire un rapport au commandant de corps Danath Trollemort, au bastion de l’Honneur dans la péninsule des Flammes infernales.‡全面调查鲜血熔炉，然后向地狱火半岛上的荣耀堡内的远征军指挥官达纳斯·托尔贝恩汇报。‡徹底調查血熔爐再到地獄火半島的榮譽堡向軍隊指揮者達納斯·托爾貝恩回報。',
  }
},
[9608] = {
  {
    'Heart of Rage‡В сердце ярости‡Im Herzen des Hasses‡격노의 한복판‡Corazón furioso‡Corazón de ira‡Cœur de rage‡愤怒之心‡狂怒之心',
    nil,
    'Fully investigate the Blood Furnace and then report to Nazgrel at Thrallmar in Hellfire Peninsula.‡Детально изучите Кузню Крови и доложите об увиденном Назгрелу в Траллмар на Полуострове Адского Пламени.‡Untersucht das gesamte Areal des Blutkessels und meldet Euch anschließend bei Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡피의 용광로를 샅샅이 조사한 후 지옥불 반도의 스랄마에 있는 나즈그렐에게 보고해야 합니다.‡Investiga a fondo El Horno de Sangre y después informa a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Investiga a fondo El Horno de Sangre y después informa a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Faire une enquête exhaustive sur la Fournaise du sang, puis en faire un rapport à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡全面调查鲜血熔炉，然后向地狱火半岛上的萨尔玛内的纳兹格雷尔汇报。‡徹底調查血熔爐再到地獄火半島的索爾瑪向納茲格雷爾回報。',
  }
},
[9609] = {
  {
    'Ajude o Vigia Biggs‡Помощь дозорному Биггсу‡Helft Behüter Biggs‡파수병 비그스 돕기‡Ayuda al vigía Biggs‡Ayuda al vigía Biggs‡Aidez le gardien Biggs‡帮助卫兵比格斯‡幫助看守者比格斯',
    nil,
    'Encontre o Vigia Biggs no Pântano das Mágoas.‡Найдите дозорного Биггса на Болоте Печали.‡Sucht Behüter Biggs in den Sümpfen des Elends.‡슬픔의 늪에 있는 파수병 비그스를 찾아야 합니다.‡Encuentra al vigía Biggs en el Pantano de las Penas.‡Encuentra al vigía Biggs en el Pantano de las Penas.‡Trouvez le gardien Biggs dans le marais des Chagrins.‡找到悲伤沼泽的卫兵比格斯。‡在悲傷沼澤裡找到看守者比格斯。',
  }
},
[9610] = {
  {
    'Poço de Lágrimas‡Озеро Слез‡Der Tränenteich‡눈물의 연못‡Charca de Lágrimas‡Charca de Lágrimas‡Le bassin des larmes‡泪水之池‡淚水之池',
    nil,
    'Obtenha 10 Artefatos Atal\'ai e entregue-os a Holaaru no Refúgio do Pântano das Mágoas.‡Добудьте 10 артефактов Атал\'ай и вернитесь с ними к Холаару в Убежище на Болото Печали.‡Besorgt 10 Artefakte der Atal\'ai und bringt sie zu Holaaru im sicheren Hafen in den Sümpfen des Elends.‡아탈라이 유물 10개를 구해서 슬픔의 늪의 피난처에 있는 홀라아루에게 돌아가야 합니다.‡Consigue 10 artefactos Atal\'ai y llévaselos a Holaaru en El Puerto del Pantano de las Penas.‡‡Procurez-vous 5 Artéfacts atal\'ai et remettez-les à Holaaru, au Havre boueux du marais des Chagrins.‡取得10个阿塔莱神器，并将它们交给悲伤沼泽避难营的霍拉鲁。‡取得10個阿塔萊神器再回到悲傷沼澤的避難營找何拉魯。',
  }
},
[9612] = {
  {
    'Agradeço de coração!‡Большое спасибо!‡Herzlichen Dank!‡생명의 은인‡¡Gracias de corazón!‡¡Gracias de corazón!‡Merci du fond du cœur !‡非常感谢！‡',
    nil,
    'Fale com o Exarca Menelaus no Entreposto Lazúli.‡Поговорите с экзархом Менелаусом на Лазурной заставе.‡Sprecht mit Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스와 대화해야 합니다.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Parlez à l\'exarque Menelaous au Guet d\'azur.‡与碧蓝岗哨的大主教梅内莱厄斯谈一谈。‡',
  }
},
[9616] = {
  {
    'Bandoleiros!‡Бандиты!‡Banditen!‡블러드 엘프 약탈자!‡¡Bandidos!‡¡Bandidos!‡Bandits !‡强盗！‡土匪!',
    nil,
    'Leve o Comunicado dos Elfos Sangrentos ao Exarca Menelaus no Entreposto Lazúli.‡Отнесите сообщение эльфов крови экзарху Менелаусу на Лазурную заставу.‡Nehmt das Blutelfendokument zu Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스에게 블러드 엘프 교신 내용을 가져가야 합니다.‡Llévale la comunicación del elfo de sangre al exarca Menelaous en la Avanzada Azur.‡Llévale la comunicación del elfo de sangre al exarca Menelaous en la Avanzada Azur.‡Remettez la Communication des elfes de sang à l\'exarque Menelaous au Guet d\'azur.‡将血精灵布告交给碧蓝岗哨的大主教梅内莱厄斯。‡將血精靈情報帶給藍色守望的主教米奈奧斯。',
  }
},
[9617] = {
  {
    'Procure os Andarilhos‡На поиски Странников‡Sucht die Weltenwanderer auf‡원정순찰대를 찾아서...‡Busca a los errantes‡Busca a los errantes‡Aller voir les pérégrins‡寻找远行者‡尋找遠行者',
    nil,
    'Fale com a Tenente Correalba no Retiro dos Andarilhos.‡Поговорите с лейтенантом Вестницей Рассвета в обители Странников.‡Sprecht mit Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너와 대화하십시오.‡Habla con la teniente Correalba en El Retiro del Errante.‡Habla con la teniente Correalba en El Retiro del Errante.‡Parlez au lieutenant Coursaurore à la retraite des Pérégrins.‡与远行者居所的达恩·晨行者中尉谈一谈。‡和遠行者居所的晨奔中尉談談。',
  }
},
[9618] = {
  {
    'Entregue os relatórios‡Возвращение с донесениями‡Überbringen der Berichte‡보고서 전달‡Devuelve los informes‡Devuelve los informes‡Remettre les rapports‡交回报告‡',
    nil,
    'Leve os Relatórios de Keltus Umbrafronde a Zelanis em Luaprata.‡Отнесите донесения Келтуса Темного Листа Зеланису в Луносвет.‡Bringt Keltus Dunkellaubs Berichte zu Zelanis in Silbermond.‡실버문에 있는 젤라니스에게 켈투스 다크리프의 보고서를 가져가야 합니다.‡Lleva los informes de Keltus Hojaoscura a Zelanis en la Ciudad de Lunargenta.‡Lleva los informes de Keltus Hojaoscura a Zelanis en la Ciudad de Lunargenta.‡Transmettez les Rapports de Keltus Sombrefeuille à Zelanis, à Lune-d\'argent.‡将克尔图斯·暗叶的报告交给银月城的瑟兰尼斯。‡',
  }
},
[9619] = {
  {
    'A Runa de Evocação‡Руна Призыва‡Beschwörungsrune‡소환의 룬‡La runa de invocación‡La runa de invocación‡La rune d\'invocation‡召唤符文‡召喚符文',
    nil,
    'Use a Pedra do Caos para evocar um Emissário do Caos na Vila de Aurinévoa, derrote-o e fale novamente com Talionia em Luaprata.‡Используйте камень Бездны, чтобы призвать демона Бездны в деревню Золотистой Дымки, одолейте демона и вернитесь к Талионии в Луносвет.‡Verwendet den Leerstein, um einen Leerwandler in Goldnebel zu beschwören. Bezwingt ihn und kehrt zu Talionia in Silbermond zurück.‡황금안개 마을에서 공허의 돌을 사용하여 보이드워커를 소환한 다음 해치워야 합니다. 그런 후 실버문에 있는 탈리오니아에게 돌아가십시오.‡Usa la piedra de vacío para invocar a un abisario en la Aldea de Bruma Dorada, derrótalo, y regresa junto a Talionia en la Ciudad de Lunargenta.‡Usa la piedra del vacío para invocar a un abisario en la Aldea Bruma Dorada, derrótalo, y regresa junto a Talionia en la Ciudad de Lunargenta.‡Servez-vous de la Pierre de Vide pour invoquer un Marcheur du Vide au village Brume-d\'or, vainquez-le puis retournez voir Talionia à Lune-d’Argent.‡在金雾村使用虚空石召唤出虚空行者，打败它，然后回到银月城的塔莱尼娅身边。‡在金霧村使用虛無石召喚出一個虛無行者，擊敗它，再回到銀月城的塔萊妮亞那裡。',
  }
},
[9620] = {
  {
    'A equipe de levantamento desaparecida‡Пропавшие картографы‡Das vermisste Vermessungsteam‡실종된 조사단‡El equipo de investigación desaparecido‡El equipo de investigación desaparecido‡Les explorateurs disparus‡失踪的测量小组‡失蹤的調查小組',
    nil,
    'O Emissário Mikolaas quer que você encontre a Equipe de Levantamento Topográfico enviada para as Ruínas de Loreth\'Aran e ajude-a no que for preciso.‡Предвестник Миколаас просит разыскать группу разведчиков, которую он послал к развалинам Лорет\'Арана, и помочь группе чем только возможно.‡Herold Mikolaas möchte, dass Ihr das Vermessungsteam findet, das er zu den Ruinen von Loreth\'Aran entsendet hatte, und dass Ihr dem Team so gut es geht zur Seite steht.‡선구자 미콜라스가 로레스아란 폐허로 보낸 조사단을 찾아서 가능한 모든 도움을 주라고 부탁했습니다.‡El presagista Mikolaas quiere que encuentres al equipo de reconocimiento que había enviado a las Ruinas de Loreth\'Aran y les ayudes en todo lo que puedas.‡El presagista Mikolaas quiere que encuentres al equipo de reconocimiento que había enviado a las Ruinas de Loreth\'Aran y les ayudes en todo lo que puedas.‡Le messager Mikolaas veut que vous retrouviez l\'équipe d\'explorateurs qu\'il a envoyé dans les ruines de Loreth\'Aran, et que vous les aidiez de votre mieux.‡先行官米库拉斯希望你找到他派去洛雷萨兰废墟的测量小组，尽力帮助他们。‡通報者米可拉斯要你找到他派去羅薩倫廢墟的調查小組並盡力幫助他們。',
  }
},
[9621] = {
  {
    'Carta para Sylvana‡Посол к Орде‡Gesandter zur Horde‡사절로서 호드에 파견되다‡Envío para la Horda‡Enviado de la Horda‡Emissaire auprès de la Horde‡部落的特使‡部落的使者',
    nil,
    'Leve a Carta de Lor\'themar Theron para a Grande Dama Sylvana Correventos na Cidade Baixa, a capital dos Renegados que fica nas Clareiras de Tirisfal.‡Отнесите письмо от Лор\'темара Терона леди Сильване Ветрокрылой в Подгород, столицу Отрекшихся в Тирисфальских лесах.‡Bringt den Brief von Lor\'themar Theron zu Fürstin Sylvanas Windläufer in Unterstadt, der Hauptstadt der Verlassenen in Tirisfal.‡티리스팔 숲에 위치한 포세이큰의 수도인 언더시티로 가서 여군주 실바나스 윈드러너에게 로르테마르 테론의 편지를 전해야 합니다.‡Llévale la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Remettez la Lettre de Lor\'themar Theron à dame Sylvanas Coursevent à Fossoyeuse, la capitale des Réprouvés dans les clairières de Tirisfal.‡到提瑞斯法林地去，将洛瑟玛·塞隆的信交给被遗忘者的首都幽暗城中的希尔瓦娜斯·风行者。‡將來自洛索瑪·塞隆的信帶到幽暗城，提里斯法林地的被遺忘者首都給希瓦娜斯·風行者。',
  }
},
[9622] = {
  {
    'Leve a mensagem ao seu povo‡Предупреди свой народ‡Warnt vor der Gefahr‡총독 메넬라우스와의 대화‡Avisar a tu pueblo‡Avisar a tu pueblo‡Avertir votre peuple‡警告你的人民‡警告你的族人',
    nil,
    'Fale com o Exarca Menelaus no Entreposto Lazúli.‡Поговорите с экзархом Менелаусом на Лазурной заставе.‡Sprecht mit Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스와 대화해야 합니다.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Parlez à l\'exarque Menelaous au Guet d\'azur.‡与碧蓝岗哨的大主教梅内莱厄斯谈一谈。‡和藍色守望的主教米奈奧斯談談。',
  }
},
[9623] = {
  {
    'A maturidade‡Время пришло‡Reiferwerden‡시대의 부름‡Madurez‡Madurez‡Il est temps de grandir‡成年‡是時候了',
    nil,
    'O Exarca Menelaus, no Entreposto Lazúli, pediu que você entregasse as Ordens do Exarca a Toralius, o Tratador, do lado de fora da Exodar.‡Передайте распоряжения экзарха Тораллиусу Пастуху. Он находится у Экзодара, недалеко от входа.‡Exarch Menelaous bei der Azurwacht hat Euch gebeten, die Befehle des Exarchen zu Torallius dem Herdentreiber, der außerhalb der Exodar steht, zu bringen.‡하늘 감시초소에 있는 총독 메넬라우스가 엑소다르 밖에 서 있는 조련사 토랄리우스에게 총독의 명령서를 전해 달라고 부탁했습니다.‡El exarca Menelaous en la Avanzada Azur ha pedido que entregues las órdenes del exarca a Torallius el Controlador de la Manada que se encuentra a las afueras de El Exodar.‡El exarca Menelaous en la Avanzada Azur ha pedido que entregues las órdenes del exarca a Torallius el Controlador de la Manada que se encuentra a las afueras de El Exodar.‡L\'exarque Menelaous, du Guet d\'azur, veut que vous remettiez les Ordres de l\'exarque à Torallius le Pâtre, qui se trouve hors de l\'Exodar.‡碧蓝岗哨的大主教梅内莱厄斯要求你将主教的命令交给埃索达门外的象群管理者妥拉留斯。‡藍色守望的主教米奈奧斯要你將主教的命令送給『獸群管理者』托拉利斯，他就在艾克索達外面。',
  }
},
[9624] = {
  {
    'Regalo de elekk‡Любимое блюдо‡Lieblingsleckerli‡맛있는 모래배‡Un caprichito goloso‡Un caprichito goloso‡La meilleure des gâteries‡美味的点心‡最愛的一道菜',
    nil,
    'Aonar, da Travessia de Kessel, quer que você lhe traga 10 Peras Orientais.‡Принесите 10 песчаных груш Аонару в лагерь Кессела.‡Aonar bei Kessels Wegelager möchte, dass Ihr ihm 10 Sandbirnen bringt.‡케셀의 길목에 있는 아오나르가 모래배 10개를 가져다 달라고 부탁했습니다.‡Aonar de la Encrucijada de Kessel quiere que le lleves 10 peras de arena.‡Aonar de la Encrucijada de Kessel quiere que le lleves 10 peras de arena.‡Aonar, à la Croisée de Kessel, veut que vous lui rameniez 10 Poires des sables.‡凯希尔路口的奥纳尔希望你能帮他找到10个沙梨。‡凱索十字路的艾昂爾要你幫他帶來10顆沙梨。',
  }
},
[9625] = {
  {
    'Elekk é negócio sério‡Элекки – это серьезно‡Elekk sind starker Tobak‡엘레크 다루기‡Con los elekks no se bromea‡Con los elekks no se bromea‡On ne plaisante pas avec les elekk‡雷象可不是好玩的！‡伊萊克是嚴肅的職責',
    nil,
    'Fala com Vorkhan, o Pastor de Elekks, na Ilha Névoa Rubra.‡Поговорите с Ворканом Пастухом Элекков на острове Кровавой Дымки.‡Sprecht mit Vorkhan dem Elekktreiber auf der Blutmythosinsel.‡핏빛안개 섬에 있는 엘레크 조련사 보르칸에게 가야 합니다.‡Habla con Vorkhan el Pastor de elekks, en la Isla Bruma de Sangre.‡Habla con Vorkhan el Pastor de elekks, en la Isla Bruma de Sangre.‡Parlez à Vorkhan le berger des elekk sur l\'île de Brume-sang.‡与秘血岛的雷象管理者沃克汉谈一谈。‡和血謎島的『伊萊克牧者』渥卡恩談談。',
  }
},
[9626] = {
  {
    'Encontro com o Chefe Guerreiro‡Встреча с вождем‡Ein Treffen mit dem Kriegshäuptling‡대족장 알현‡Encuentro con el Jefe de Guerra‡Encuentro con el Jefe de Guerra‡Rencontre avec les Orcs‡觐见酋长‡會見大酋長',
    nil,
    'A Grande Dama Sylvana Correventos quer que você leve a Carta Selada por Sylvana para Thrall em Orgrimmar, capital de Durotar.‡Отнесите письмо с печатью Леди Сильваны Ветрокрылой Траллу в Оргриммар, столицу Дуротара.‡Fürstin Sylvanas Windläufer möchte, dass Ihr den Brief mit Sylvanas\' Siegel zu Thrall nach Orgrimmar, Hauptstadt von Durotar, bringt.‡여군주 실바나스 윈드러너가 듀로타의 수도인 오그리마에 있는 스랄에게 실바나스의 인장이 찍힌 편지를 전해달라고 부탁했습니다.‡Lady Sylvanas Brisaveloz quiere que lleves la carta con su sello a Thrall en Orgrimmar, capital de Durotar.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas al Jefe de Guerra en Orgrimmar, capital de Durotar.‡Dame Sylvanas Coursevent veut que vous remettiez la Lettre scellée par Sylvanas au Haut seigneur Saurcroc, à Orgrimmar, la capitale de Durotar.‡希尔瓦娜斯·风行者要求你将她的密信交给杜隆塔尔首都奥格瑞玛的萨尔。‡希瓦娜斯·風行者要你將希瓦娜斯蓋章的信帶給杜洛塔首都，奧格瑪的索爾。',
  }
},
[9627] = {
  {
    'Aliança à Horda!‡Верность Орде‡Treue gegenüber der Horde‡호드의 일원이 되다!‡Fidelidad a la Horda‡Fidelidad a la Horda‡L\'allégeance à la Horde‡部落的盟约‡效忠部落',
    nil,
    'Volte para Luaprata e apresente-se a Lor\'themar Theron.‡Возвращайтесь в Луносвет и поговорите с Лор\'темаром Тероном.‡Kehrt nach Silbermond zurück und erstattet Lor\'themar Theron Bericht.‡실버문으로 돌아가서 로르테마르 테론에게 보고하십시오.‡Vuelve a la Ciudad de Lunargenta y habla con Lor\'themar Theron.‡Vuelve a la Ciudad de Lunargenta y habla con Lor\'themar Theron.‡Retournez à Lune-d’Argent et allez faire votre rapport à Lor’themar Theron.‡回到银月城，向洛瑟玛·塞隆复命。‡回到銀月城向洛索瑪·塞隆回報。',
  }
},
[9628] = {
  {
    'Recuperação de dados‡Цена знания – жизнь‡Bergung der Daten‡자료 회수‡Recuperar los datos‡Recuperar los datos‡Récupérer des données‡夺回数据‡搶回資料',
    nil,
    'Retome o Cristal de Dados da Expedição das nagas Escamódio próximas aos corpos dos cartógrafos e devolva-o para o emissário Mikolaas no Entreposto Rubro.‡Неподалеку от того места, где были убиты картографы, обитают наги из клана Зловещей Чешуи. Отберите у них кристалл с результатами наблюдений и доставьте его на Кровавую заставу предвестнику Миколаасу.‡Erlangt den Vermessungsdatenkristall von den Hasspranken nahe der toten Kartografen wieder und bringt ihn zu Herold Mikolaas bei der Blutwacht.‡죽은 지도제작자 근처에 성난비늘일족 나가에게서 관측 자료 수정을 찾아 핏빛 감시초소에 있는 선구자 미콜라스에게 가져가야 합니다.‡Consigue el cristal de datos de la expedición de la Escama de Cólera cerca de los cartógrafos muertos y regresa junto al presagista Mikolaas en la Avanzada de Sangre.‡Consigue el cristal de datos de la expedición de la Escama de Cólera cerca de los cartógrafos muertos y regresa junto al presagista Mikolaas en la Avanzada de Sangre.‡Récupérez le Cristal de données du relevé sur les Nagas irécailles près des cartographes morts et remettez-le au messager Mikolaas, au Guet du sang.‡从测量人员尸体附近的怒鳞纳迦手中夺回测量数据水晶，把它交给秘血岗哨的先行官米库拉斯。‡從死亡的製圖師附近的怒鱗身上取得勘察資料水晶，再帶回血色守望給通報者米可拉斯。',
  }
},
[9629] = {
  {
    'Pegar e soltar‡Поймать и отпустить‡Kurz geschnappt‡멀록 표시총‡Aquí te pillo, aquí te marco‡Aquí te pillo, aquí te marco‡Attraper... relâcher...‡研究鱼人‡標記魚人',
    nil,
    'Morae, no Entreposto Rubro, quer que você "marque" 6 Batedores Trevareia usando a Etiquetadora de Murloc.‡Морэ с Кровавой заставы просит вас "пометить" 6 разведчиков из племени Черного Ила при помощи маркировщика мурлоков.‡Morae bei der Blutwacht möchte, dass Ihr 6 Späher der Schwarzschlammküste mit einem Murlocsender \'markiert\'.‡핏빛 감시초소에 있는 모라에가 멀록 표시총을 사용하여 검은진흙멀록 정찰꾼 6마리에게 \'표시\'를 해 달라고 부탁했습니다.‡Morae, de la Avanzada de Sangre, quiere que \'marques\' a 6 exploradores Cienonegro con el hierro múrloc.‡Morae, de la Avanzada de Sangre, quiere que \'marques\' a 6 exploradores Cienonegro con el hierro múrloc.‡Morae, du Guet du sang, veut que vous « marquiez » 6 Eclaireurs Vase noir avec le Marqueur de murlocs.‡秘血岗哨的莫莱希望你用鱼人标记枪去"标记"6个黑沙斥候。‡血色守望的莫瑞伊要你使用魚人標示器「標記」6個黑沙斥候。',
  }
},
[9630] = {
  {
    'O Diário de Medivh‡Дневник Медива‡Medivhs Tagebuch‡메디브의 일지‡El diario de Medivh‡El diario de Medivh‡Le journal de Medivh‡麦迪文的日记‡麥迪文的日記',
    nil,
    'O Arquimago Alturus, na Trilha do Vento Morto, quer que você entre em Karazhan e fale com Wravien.‡По поручению верховного мага Альтура на Перевале Мертвого Ветра войдите в Каражан и поговорите с Вравьеном.‡Erzmagier Alturus am Gebirgspass der Totenwinde möchte, dass Ihr nach Karazhan geht und mit Wravien sprecht.‡저승바람 고개에 있는 대마법사 알투루스가 카라잔으로 가서 레비엔과 대화해 달라고 했습니다.‡El archimago Alturus, del Paso de la Muerte, quiere que vayas a Karazhan y hables con Wravien.‡‡L’archimage Alturus, du défilé de Deuillevent, veut que vous entriez dans Karazhan et que vous parliez à Wravien.‡逆风小径的大法师奥图鲁斯要你进入卡拉赞，与拉维恩谈一谈。‡',
  }
},
[9631] = {
  {
    'Ajuda de uma colega‡Взаимовыручка‡Hilfe unter Kollegen‡동료의 도움‡La ayuda de una compañera‡La ayuda de una compañera‡L\'aide d\'une collègue‡同事的帮助‡',
    nil,
    'Leve o Fragmento de Osso Carbonizado para Kalynna Lathred na Área 52, que fica em Eternévoa.‡Доставьте фрагмент обугленной кости Калинне Латред в Область 52 в Пустоверти.‡Bringt das verkohlte Knochenfragment zu Kalynna Lathred in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 칼린나 나스레드에게 그을린 뼈 조각을 가져가야 합니다.‡Lleva el trozo de hueso carbonizado a Kalynna Lathrojo en el Área 52 en Tormenta Abisal.‡Lleva el trozo de hueso carbonizado a Kalynna Lathrojo en el Área 52 en Tormenta Abisal.‡Remettez le Fragment d\'os carbonisé à Kalynna Rougelatte, dans la Zone 52 de Raz-de-Néant.‡将焦骨碎块交给虚空风暴52区的卡琳娜·拉瑟德。‡',
  }
},
[9632] = {
  {
    'Aliados de última hora‡Новые союзники‡Neue Verbündete‡연합의 협력‡Aliados inesperados‡Aliados inesperados‡De nouveaux alliés‡新的盟友‡新找到的盟友',
    nil,
    'Entregue a Carta de Apresentação para a Caçadora Kella Arconyx.‡Доставьте рекомендательное письмо охотнице Келле Тетиве Ночи.‡Bringt das Vorstellungsschreiben zu Jägerin Kella Nachtbogen.‡여사냥꾼 켈라 나이트보우에게 소개장을 가져가야 합니다.‡Llévale la carta de presentación a la cazadora Kella Arconocturno.‡‡Remettez la Lettre d\'introduction à la chasseresse Kella Arquenuit, à l\'Île de Brume-Azur.‡将介绍信交给女猎手凯拉·夜弓。‡將介紹信交給女獵人凱拉·夜弓。',
  }
},
[9633] = {
  {
    'O caminho de Auberdine‡Дорога к Аубердину‡Der Weg nach Auberdine‡아우버다인으로의 여정‡Camino de Auberdine‡Camino de Auberdine‡En route pour Auberdine‡前往奥伯丁‡去奧伯丁的路',
    nil,
    'Pegue o barco no cais perto da Caçadora Kella Arconyx até Auberdine. Uma vez lá, leve a Carta de Apresentação a Trovejius Tecevento.‡Сядьте на корабль, идущий в Аубердин. Пристань находится неподалеку от дома охотницы Келлы Тетивы Ночи. В Аубердине отдайте рекомендательное письмо Тандрису Ветропряду.‡Nehmt das Schiff in der Nähe von Jägerin Kella Nachtbogen nach Auberdine. Bringt das Vorstellungsschreiben zu Thundris Windwirker, sobald Ihr in Auberdine angekommen seid.‡여사냥꾼 켈라 나이트보우 근처의 부두에서 배를 타고 아우버다인에 도착한 후, 툰드리스 윈드위버에게 소개장을 가져가야 합니다.‡Lleva el barco desde el embarcadero próximo a la cazadora Kella Arconocturno hasta Auberdine. Cuando llegues a Auberdine, lleva la carta de presentación a Thundris Tejevientos.‡Lleva el barco desde el embarcadero próximo a la cazadora Kella Arconocturno hasta Auberdine. Cuando llegues a Auberdine, lleva la carta de presentación a Thundris Tejevientos.‡Prenez le bateau pour Auberdine. Il part du quai qui se trouve près de la chasseresse Kella Arquenuit. Lorsque vous serez à Auberdine, présentez votre Lettre d’introduction à Thundris Tissevent.‡在女猎手凯拉·夜弓附近的码头乘船去奥伯丁。到达奥伯丁后，将介绍信交给桑迪斯·织风。‡從靠近女獵人凱拉·夜弓的碼頭上搭船前往奧伯丁。等你到了奧伯丁，將介紹信拿給桑迪斯·織風。',
  }
},
[9634] = {
  {
    'Predadores alienígenas‡Чужие-хищники‡Raubtiere aus einer anderen Welt‡미지의 약탈자들‡Depredadores alienígenas‡Depredadores alienígenas‡Des prédateurs d\'outre-monde‡大战异型掠夺者‡外來掠奪者',
    nil,
    'Mate 10 Filhotes de Névoa Rubra e, em seguida, fale novamente com Vorkhan, o Pastor de Elekks, na Travessia de Kessel, que fica na Ilha Névoa Rubra.‡Убейте 10 детенышей опустошителя с острова Кровавой Дымки и вернитесь к Воркану Пастуху Элекков. Воркана можно найти на острове Кровавой Дымки в лагере Кессела.‡Tötet 10 junge Blutfelshetzer und kehrt danach zu Vorkhan dem Elekktreiber bei Kessels Wegelager auf der Blutmythosinsel zurück.‡새끼 핏빛안개 갈퀴발톱 10마리를 처치한 후 핏빛안개 섬의 케셀의 길목에 있는 엘레크 조련사 보르칸에게 돌아가야 합니다.‡Mata 10 proles de Bruma de Sangre y vuelve a hablar con Vorkhan el pastor de elekks en la Encrucijada de Kessel en la Isla Bruma de Sangre.‡Mata 10 proles Bruma de Sangre y vuelve a hablar con Vorkhan el pastor de elekks en la Encrucijada de Kessel en la Isla Bruma de Sangre.‡Tuez 10 Jeunes Brume-sang, puis retournez voir Vorkhan le berger des elekk à la Croisée de Kessel sur l\'île de Brume-sang.‡杀掉10个秘血幼崽，然后向秘血岛凯希尔路口的雷象管理者沃克汉复命。‡殺死10隻血謎幼蟲後回到血謎島的凱索十字路找『伊萊克牧者』渥卡恩。',
  }
},
[9635] = {
  {
    'O Extrator de Partículas Zapeacelera!‡Удаленный конденсатор выхлопов!‡Der schockdrosselnde Partikelextraktor!‡기압조절 가스 추출기‡¡El extractor de motas Zapacelerador!‡¡El extractor de motas Zapacelerador!‡L\'extracteur de granules Zappeur-Gazier !‡气阀微粒提取器！‡快速節流微粒吸取器!',
    nil,
    'Traga 15 Partes de Bomba a Vapor para o Mergulhador Mack em Zabra\'jin, no Pântano Zíngaro.‡Принесите 15 деталей парового насоса Маку Дайверу в Забра\'джин в Зангартопи.‡Bringt 15 Dampfpumpenteile zu Mack Dyver in Zabra\'jin in den Zangarmarschen.‡장가르 습지대의 자브라진에 있는 맥 다이버에게 증기 양수기 부품 15개를 가져가야 합니다.‡Llévale 15 piezas de bomba de vapor a Mack Diver en Zabra\'jin, en la Marisma de Zangar.‡Llévale 15 piezas de bomba de vapor a Mack Diver en Zabra\'jin, en la Marisma de Zangar.‡Apportez 15 Pièces détachées de la pompe à vapeur à Mack Diver, à Zabra\'jin dans le marécage de Zangar.‡将15个蒸汽泵零件交给赞加沼泽萨布拉金的马克·迪沃。‡帶15個蒸汽幫浦零件到贊格沼澤給薩布拉金的馬克·戴沃。',
  }
},
[9636] = {
  {
    'O Extrator de Partículas Zapeacelera!‡Удаленный конденсатор выхлопов!‡Der schockdrosselnde Partikelextraktor!‡기압조절 가스 추출기!‡¡El extractor de motas Zapacelerador!‡¡El extractor de motas Zapacelerador!‡L\'extracteur de granules Zappeur-Gazier !‡气阀微粒提取器！‡快速節流微粒吸取器!',
    nil,
    'Traga 15 Partes de Bomba a Vapor para K. Lee Smallfry em Telredor, no Pântano Zíngaro.‡Принесите 15 деталей парового насоса К. Ли Мелюзге в Телредор в Зангартопи.‡Bringt 15 Dampfpumpenteile zu K. Lee Kleinfrey in Telredor in den Zangarmarschen.‡장가르 습지대의 텔레도르에 있는 K. 리 스몰프라이에게 증기 양수기 부품 15개를 가져가야 합니다.‡Llévale 15 piezas de bomba de vapor a K. Lee Fritito en Telredor, en la Marisma de Zangar.‡Llévale 15 piezas de bomba de vapor a K. Lee Fritito en Telredor, en la Marisma de Zangar.‡Apportez 15 Pièces détachées de la pompe à vapeur à Manue Fretin, à Telredor dans le marécage de Zangar.‡将15个蒸汽泵零件交给赞加沼泽泰雷多尔的凯莉·弗莱。‡帶15個蒸汽幫浦零件到贊格沼澤給泰倫多爾的李小炸。',
  }
},
[9637] = {
  {
    'O pedido de Kalynna‡Требование Калинны‡Kalynnas Bitte‡칼린나의 부탁‡La petición de Kalynna‡La petición de Kalynna‡La requête de Kalynna‡卡琳娜的要求‡',
    nil,
    'Kalynna Lathred quer que você recupere o Tomo de Crepúsculo do Grão-bruxo Maléter nos Salões Despedaçados, que ficam na Cidadela Fogo do Inferno, e também o Livro dos Nomes Esquecidos do Tecetrevas Syth nos Salões dos Sethekk, que ficam em Auchindoun.nnEssa missão deve ser completada em dificuldade heroica.‡Калинна Латред требует отыскать и принести ей фолиант сумерек и книгу забытых имен. Первой владеет главный чернокнижник Пустоклят, его можно найти в Разрушенных залах цитадели Адского Пламени. Вторая принадлежит заклинателю тьмы Ситу, который находится в Сетеккских залах в Аукиндоне.nnЭто задание должно быть выполнено на героическом уровне сложности.‡Kalynna Lathred möchte, dass Ihr den Dämmerfolianten vom Großhexenmeister Nethekurse in den Zerschmetterten Hallen der Höllenfeuerzitadelle und das Buch der vergessenen Namen von Dunkelwirker Syth in den Sethekkhallen in Auchindoun besorgt.nnIhr müsst diese Quest auf dem Schwierigkeitsgrad \'Heroisch\' abschließen.‡칼린나 나스레드가 지옥불 성채의 으스러진 손의 전당에 있는 대흑마법사 네더쿠르스로부터 어둠의 고서를, 아킨둔의 세데크 전당에 있는 흑마술사 시스에게서 잊혀진 이름의 고서를 되찾아 달라고 했습니다.nn이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Kalynna Lathrojo quiere recuperar el Escrito del Ocaso del brujo supremo Malbisal en Las Salas Arrasadas de la Ciudadela del Fuego Infernal y el Libro de los Nombres Olvidados de Tejeoscuro Syth en las Salas Sethekk de Auchindoun.nnEsta misión debe ser completada en dificultad heroica.‡Kalynna Lathrojo quiere recuperar el Escrito del Ocaso del brujo supremo Malbisal en Las Salas Arrasadas de la Ciudadela del Fuego Infernal y el Libro de los Nombres Olvidados de Tejeoscuro Syth en las Salas Sethekk de Auchindoun.|n|nEsta misión debe ser completada en dificultad heroica.‡Kalynna Rougelatte veut que vous récupériez le Tome de la pénombre sur le Grand démoniste Néanathème dans la citadelle des Flammes infernales, et le Livre des noms oubliés sur le Sombre tisseur Syth dans les salles des Sethekk à Auchindoun.nnCette quête doit être accomplie en mode de difficulté Héroïque.‡从地狱火堡垒破碎大厅的高阶术士奈瑟库斯手中夺得暮色魔典，从奥金顿塞泰克大厅的黑暗编织者塞斯手中夺得忘却之名，将它们交给卡琳娜·拉瑟德。nn该任务必须在英雄难度下完成。‡',
  }
},
[9638] = {
  {
    'Em boas mãos‡В хороших руках‡In guten Händen‡그라다브와의 대화‡En buenas manos‡En buenas manos‡En de bonnes mains‡书呆子‡',
    nil,
    'Fale com Gradav na Biblioteca do Guardião, que fica em Karazhan.‡Поговорите с Градавом в Библиотеке стража в Каражане.‡Sprecht mit Gradav in der Bibliothek des Wächters in Karazhan.‡카라잔의 수호자의 도서관에 있는 그라다브와 대화해야 합니다.‡Habla con Gradav en la Biblioteca del Guardián, en Karazhan.‡Habla con Gradav en la Biblioteca del Guardián, en Karazhan.‡Parler avec Gradav dans la Bibliothèque du gardien, à Karazhan.‡与卡拉赞守护者的图书馆中的格拉达夫谈一谈。‡',
  }
},
[9639] = {
  {
    'Kamsis‡Камсис‡Kamsis‡캄시스와의 대화‡Kamsis‡‡Kamsis‡卡姆希丝‡康席斯',
    nil,
    'Fale com Kamsis na Biblioteca do Guardião, que fica em Karazhan.‡Поговорите с Камсис в Библиотеке Стража в Каражане.‡Sprecht mit Kamsis in der Bibliothek des Wächters in Karazhan.‡카라잔의 수호자의 도서관에 있는 캄시스와 대화해야 합니다.‡Habla con Kamsis en la Biblioteca del Guardián, en Karazhan.‡Habla con Kamsis en la Biblioteca del Guardián, en Karazhan.‡Parler avec Kamsis dans la Bibliothèque du gardien, à Karazhan.‡与卡拉赞守护者的图书馆中的卡姆希丝谈一谈。‡',
  }
},
[9640] = {
  {
    'O vulto de Aran‡Тень Арана‡Arans Schemen‡아란의 망령‡La sombra de Aran‡La sombra de Aran‡L\'ombre d\'Aran‡埃兰之影‡',
    nil,
    'Obtenha o Diário de Medivh e fale novamente com Kamsis na Biblioteca do Guardião, que fica em Karazhan.‡Достаньте дневник Медива и верните его Камсис в Библиотеку Стража в Каражане.‡Beschafft Medivhs Tagebuch und kehrt zu Kamsis in der Bibliothek des Wächters in Karazhan zurück.‡메디브의 일지를 얻은 후 카라잔의 수호자의 도서관에 있는 캄시스에게 가야 합니다.‡Consigue el diario de Medivh y vuelve junto a Kamsis en la Biblioteca del Guardián, en Karazhan.‡Consigue el diario de Medivh y vuelve junto a Kamsis en la Biblioteca del Guardián, en Karazhan.‡Obtenez le Journal de Medivh et retournez voir Kamsis dans la Bibliothèque du Gardien de Karazhan.‡将麦迪文的日记交给卡拉赞守护者的图书馆中的卡姆希丝。‡',
  }
},
[9641] = {
  {
    'Estilhaços de cristal irradiado‡Осколки облученного кристалла‡Bestrahlte Kristallsplitter‡오염에 노출된 수정 조각‡Fragmentos de cristal irradiado‡Fragmentos de cristal irradiado‡Les éclats de cristal irradié‡辐射水晶碎片‡受到輻射的水晶裂片',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você lhe traga 10 Estilhaços de Cristal Irradiado.‡Принесите 10 осколков облученного кристалла воздаятелю Боросу на Кровавую заставу.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr ihm 10 bestrahlte Kristallsplitter bringt.‡핏빛 감시초소에 있는 구원자 보로스가 오염에 노출된 수정 조각 10개를 가져다 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quiere que le lleves diez fragmentos de cristal radioactivo.‡El vindicador Boros de la Avanzada de Sangre quiere que le lleves diez fragmentos de cristal radioactivo.‡Le redresseur de torts Boros du Guet du sang veut que vous lui apportiez 10 Éclats de cristal irradiés.‡秘血岗哨的守备官波鲁斯希望你帮他收集10块辐射水晶碎片。‡血色守望的復仇者波羅斯要你幫他帶來10個受到輻射的水晶裂片。',
  }
},
[9642] = {
  {
    'Mais estilhaços de cristal irradiado‡И снова облученные кристаллы‡Mehr bestrahlte Kristallsplitter‡오염에 노출된 수정 조각 추가 수집‡Más fragmentos de cristal irradiado‡Más fragmentos de cristal irradiado‡Encore des éclats de cristal irradié‡更多辐射水晶碎片‡更多受到輻射的水晶裂片',
    nil,
    '‡Если у тебя есть еще облученные осколки, я с радостью обменяю их на свои кристаллы.‡Solltet Ihr noch über mehr bestrahlte Kristallsplitter verfügen, tausche ich sie gerne gegen einen weiteren meiner Kristalle ein.‡‡Si tienes más fragmentos de cristal irradiado, con mucho gusto te los cambiaré por uno de mis cristales.‡‡Si vous avez d’autres éclats de cristal irradiés, je serai ravi de les échanger contre l’un de mes cristaux.‡‡',
  }
},
[9643] = {
  {
    'Ô trepadeira danada!‡Удушающая лоза‡Würgeranken‡가시 돋친 덩굴손 줄기‡Parras constrictoras‡Parras constrictoras‡Les lianes étrangleuses‡荆棘巨藤‡蟒藤',
    nil,
    'O Rastreador Lyceon, do Entreposto Rubro, quer que você entregue 6 Trepadeiras Espinhosas Constritoras para ele.‡Принесите зверолову Лисеону 6 побегов колючей удушающей лозы.‡Fährtenleser Lyceon bei der Blutwacht möchte, dass Ihr ihm 6 dornige Würgeranken bringt.‡핏빛 감시초소에 있는 추적자 리시온이 가시 돋친 덩굴손 줄기 6개를 가져다 달라고 부탁했습니다.‡El rastreador Lyceon en la Avanzada de Sangre quiere que le lleves 6 parras constrictoras espinosas.‡El rastreador Lyceon en la Avanzada de Sangre quiere que le lleves 6 parras constrictoras espinosas.‡Le pisteur Lyceon, du Guet du sang, veut que vous lui rameniez 6 Lianes étrangleuses épineuses.‡秘血岗哨的追踪者兰塞恩希望你帮他收集6根荆棘巨藤。‡血色守望的追蹤者萊希安要你幫他帶來6個多刺的蟒藤。',
  }
},
[9644] = {
  {
    'Nocturno‡Ночная Погибель‡Schrecken der Nacht‡파멸의 어둠‡Nocturno‡Nocturno‡Plaie-de-nuit‡夜之魇‡夜禍',
    nil,
    'Vá até o Terraço do Mestre em Karazhan e toque a Urna Enegrecida para evocar Nocturno. Recupere a Essência Arcana Enfraquecida do cadáver de Nocturno e leve-a para o Arquimago Alturus.‡Ступайте на террасу Мастера в Каражане и с помощью урны Калинны призовите Ночную Погибель. Извлеките из тела Ночной Погибели слабую чародейскую сущность и доставьте ее верховному магу Альтуру.‡Geht zur Terrasse des Meisters in Karazhan und benutzt Kalynnas Urne, um den Schrecken der Nacht zu rufen. Entzieht dem Körper des Schreckens die schwache arkane Essenz und bringt sie zu Erzmagier Alturus.‡카라잔에 있는 주인의 테라스로 간 후 어둠의 단지를 만져 파멸의 어둠을 소환한 후, 파멸의 어둠의 시체에서 희미한 비전 정수를 되찾은 후 대마법사 알투루스에게 가져가야 합니다.‡Ve a El Bancal del Maestro en Karazhan y usa la urna de Kalynna para invocar a Nocturno. Recupera la esencia arcana intangible del cadáver de Nocturno y llévasela al archimago Alturus.‡‡Allez sur la Terrasse du Maître à Karazhan et utilisez l\'Urne noircie pour invoquer Plaie-de-nuit. Récupérez l\'Essence arcanique voilée sur le cadavre de Plaie-de-nuit, et rapportez-la à l\'archimage Alturus.‡进入卡拉赞的主宰的露台，碰触黑色骨灰，召唤夜之魇并杀死它，然后从夜之魇的尸体上取得暗淡的奥术精华，并将它交给大法师奥图鲁斯。‡',
  }
},
[9645] = {
  {
    'O Terraço do Mestre‡Терраса Мастера‡Die Terrasse des Meisters‡주인의 테라스‡El Bancal del Maestro‡El Bancal del Maestro‡La terrasse du Maître‡主宰的露台‡',
    nil,
    'Vá até o Terraço do Mestre em Karazhan e leia o Diário de Medivh.‡Поднимитесь на террасу Мастера в Каражане и прочитайте дневник Медива. После этого возвращайтесь вместе с дневником к верховному магу Альтуру.‡Geht zur Terrasse des Meisters in Karazhan und lest Medivhs Tagebuch. Kehrt danach mit Medivhs Tagebuch zu Erzmagier Alturus zurück.‡카라잔에 있는 주인의 테라스로 가서 메디브의 일지를 읽어야 합니다.‡Ve a El Bancal del Maestro en Karazhan y lee el diario de Medivh.‡Ve a El Bancal del Maestro en Karazhan y lee el diario de Medivh.‡Allez sur la Terrasse du Maître à Karazhan et lisez le Journal de Medivh.‡进入卡拉赞的主宰的露台，阅读麦迪文的日记。‡',
  }
},
[9646] = {
  {
    'PROCURA-SE: Garra da Morte‡РАЗЫСКИВАЕТСЯ: Коготь Смерти‡GESUCHT: Todespranke‡현상 수배: 죽음의 발톱‡SE BUSCA: Garraletal‡SE BUSCA: Garraletal‡Avis de recherche : Griffe-de-mort‡通缉：死爪‡懸賞:死亡之爪',
    nil,
    'Entregue a Pata do Garra da Morte para o Emissário Mikolaas na Ilha Névoa Rubra.‡Принесите лапу Когтя Смерти предвестнику Миколаасу на Кровавую заставу.‡Bringt Todesprankes Tatze zu Herold Mikolaas bei der Blutwacht.‡핏빛 감시초소에 있는 선구자 미콜라스에게 죽음의 발톱 앞발을 가져가야 합니다.‡Lleva la garra de Garraletal al presagista Mikolaas en la Avanzada de Sangre.‡Lleva la garra de Garraletal al presagista Mikolaas en la Avanzada de Sangre.‡Apportez la Patte de Griffe-de-mort au Messager Mikolaas au Guet du sang.‡将死爪的爪子交给秘血岗哨的先行官米库拉斯。‡將死亡之爪的爪子帶給血色守望的通報者米可拉斯。',
  }
},
[9647] = {
  {
    'Cortar as asinhas‡Ловля бражников‡Ausmerzen der Falter‡나방의 공격성‡Sacrificar a los aleteadores‡Sacrificar a los aleteadores‡Réduire les bruissements‡消灭巨蛾‡撲殺翼蛾',
    nil,
    'O Rastreador Lyceon, do Entreposto Rubro, quer que você entregue 10 Esvoaçantes-reais Azuis para ele.‡Зверолов Лисеон просит убить 10 царственных синих бражников.‡Fährtenleser Lyceon bei der Blutwacht möchte, dass Ihr 10 königliche blaue Falter tötet.‡핏빛 감시초소에 있는 추적자 리시온이 푸른날개 황제나방 10마리를 처치해 달라고 부탁했습니다.‡El rastreador Lyceon en la Avanzada de Sangre quiere que mates 10 aleteadores azul real.‡El rastreador Lyceon en la Avanzada de Sangre quiere que mates 10 aleteadores azul real.‡Le pisteur Lyceon au Guet du sang veut que vous tuiez 10 Virevolteurs bleus royaux.‡秘血岗哨的追踪者兰塞恩要你杀掉10只鲜艳的蓝翼巨蛾。‡血色守望的追蹤者萊希安要你殺死10隻皇家藍翼蛾。',
  }
},
[9648] = {
  {
    'Sem emoção, não tem graça‡Грибная похлебочка из Мак\'Ари‡Pilzsammlung von Mac\'Aree‡버섯쟁이 맥아리‡La colección de champiñones de Mac\'Aree‡La colección de champiñones de Mac\'Aree‡Ménagerie mycologique de Mac\'Aree‡玛凯雷蘑菇展‡麥克艾瑞野生蘑菇',
    nil,
    'Jessera de Mac\'Aree, do Entreposto Rubro, quer que você lhe traga 1 Cornofétido Aquático, 1 Cogumelo de Sangue, 1 Polísporo Ruinoso e 1 Fungo Conífero Vil.‡Джессера из Мак\'Ари просит принести ему на Кровавую заставу по одному экземпляру водянистого смрадорога, кровавого гриба, губительной полиспоры и скверноконуса.‡Jessera von Mac\'Aree bei der Blutwacht möchte 1 Wasserstinkmorchel, 1 Blutpilz, 1 ruinösen Birkensporling und 1 Teufelszapfenfungus.‡핏빛 감시초소에 있는 맥아리의 제세라가 고린뿔물버섯, 피버섯, 파멸의 버섯, 지옥방울버섯을 각각 1개씩 가져다 달라고 부탁했습니다.‡Jessera de Mac\'Aree en la Avanzada de Sangre quiere 1 cuernohediondo acuático, 1 champiñón sanguino, 1 poliespora ruinosa y 1 hongo de bellota vil.‡Jessera de Mac\'Aree en la Avanzada de Sangre quiere 1 cuernohediondo acuático, 1 champiñón sanguino, 1 poliespora ruinosa y 1 hongo de bellota vil.‡Jessera de Mac\'Aree au Guet du sang veut 1 Satyre puant aquatique, 1 Champignon de sang, 1 Polypore des ruines et 1 Collybie gangrenée.‡玛凯雷的耶塞拉希望你找到一个水生臭角菇、一个血蘑菇、一个致命孢子簇和一个邪锥蘑菇。‡血色守望的潔希拉·麥克艾瑞要1個水生惡菌菇，1個血色蘑菇，1個有害的孢子群，和1個魔錐果真菌。',
  }
},
[9649] = {
  {
    'Lágrimas de Ysera‡Слеза Изеры‡Yseras Tränen‡이세라의 눈물‡Las lágrimas de Ysera‡Las lágrimas de Ysera‡Les larmes d\'Ysera‡伊瑟拉之泪‡伊瑟拉之淚',
    nil,
    'Jessera de Mac\'Aree, do Entreposto Rubro, quer que você lhe traga 2 Lágrimas de Ysera.‡Джессера из Мак\'Ари просит принести ему на Кровавую заставу 2 экземпляра слезы Изеры.‡Jessera von Mac\'Aree bei der Blutwacht möchte 2 Yseras Tränen.‡핏빛 감시초소에 있는 맥아리의 제세라가 이세라의 눈물 2개를 가져다 달라고 부탁했습니다.‡Jessera de Mac\'Aree en la Avanzada de Sangre quiere 2 lágrimas de Ysera.‡Jessera de Mac\'Aree en la Avanzada de Sangre quiere 2 lágrimas de Ysera.‡Jessera de Mac\'Aree au Guet du sang veut 2 Larmes d\'Ysera.‡玛凯雷的耶塞拉希望你找到2个伊瑟拉之泪。‡血色守望的潔希拉·麥克艾瑞要2個伊瑟拉之淚。',
  }
},
[9663] = {
  {
    'A maratona de Kessel‡Дуга Кессела‡Der Korsallauf‡케셀의 부탁‡La carrera de Kessel‡La carrera de Kessel‡La tournée de Kessel‡凯希尔的信使‡幫凱索的忙',
    nil,
    'Kessel, da Travessia de Kessel, quer que você alerte o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto, o Exarca Menelaus no Entreposto Lazúli e o Almirante Odisseu no Assentamento de Odisseu sobre a iminente invasão dos elfos sangrentos. Em seguida, fale novamente com Kessel. Você tem 15 minutos para terminar a tarefa. (Mantenha o elekk fora d\'água.)‡Сообщите верховному вождю племени Тихвой, экзарху Менелаусу и адмиралу Одиссию о готовящемся вторжении эльфов крови, а затем возвратитесь к Кесселу. У вас есть 15 минут. Элекка следует держать подальше от воды.‡Kessel bei Kessels Wegelager möchte, dass Ihr den Oberhäuptling der Tannenruhfeste, Exarch Menelaous bei der Azurwacht und Admiral Odesyus bei Odesyus\' Ankerplatz vor der unmittelbar bevorstehenden Blutelfeninvasion warnt. Ihr habt 15 Minuten. Kehrt anschließend zu Kessel zurück. Denkt daran, dass Elekks wasserscheu sind!‡케셀의 길목에 있는 케셀이 너울소나무 요새에 있는 대족장 너울소나무, 하늘 전초기지에 있는 총독 메넬라우스, 오디시우스의 정박지에 있는 제독 오디시우스에게 블러드 엘프의 공격이 임박했다는 사실을 전해 달라고 부탁했습니다. 엘레크가 물에 닿지 않도록 하여 15분 안에 소식을 전달한 후 케셀에게 돌아가야 합니다.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que avises al gran jefe Semprepino del Bastión Semprepino, al exarca Menelaous de la Avanzada Azur y al almirante Odesyus del Desembarco de Odesyus sobre la inminente invasión de los elfos de sangre. Tienes 15 minutos. Regresa junto a Kessel cuando hayas completado esta tarea. (Asegúrate de que no toque el agua).‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que avises al gran jefe Semprepino del Bastión Semprepino, al exarca Menelaous de la Avanzada Azur y al almirante Odesyus del Desembarco de Odesyus sobre la inminente invasión de los elfos de sangre. Tienes 15 minutos. Regresa junto a Kessel cuando hayas completado esta tarea. (Asegúrate de que no toque el agua).‡Kessel, à la croisée de Kessel, veut que vous alliez prévenir de l\'invasion imminente des elfes de sang le Grand chef Calmepin au repaire des Calmepins, l\'Exarque Menelaous au Guet d\'azur et l\'Amiral Odesyus au Point d\'accostage d\'Odesyus. Revenez voir Kessel lorsque vous aurez terminé cette tâche. Vous avez 15 minutes. (Attention à ne pas aller dans l\'eau.)‡凯希尔路口的凯希尔要你把血精灵即将入侵的消息通知给止松要塞的止松老酋长、碧蓝岗哨的大主教梅内莱厄斯和奥德修斯营地的海军上将奥德修斯。你只有15分钟的时间。（记住让雷象远离水体。）‡凱索十字路的凱索要你去警告靜松要塞的大酋長靜松，藍色守望的主教米奈奧斯，和奧迪席斯平臺的艦隊司令·奧迪席斯關於血精靈即將發動的攻擊。完成任務後回到凱索那裡。你只有15分鐘。',
  }
},
[9664] = {
  {
    'Novos postos avançados‡Новые форпосты‡Mehr Befestigungen‡새로운 전초기지 건설‡Nuevas avanzadas‡Nuevas avanzadas‡Fonder de nouveaux avant-postes‡建立新据点‡建立新前哨',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Barbabranca, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и вернитесь к посланнику Белобороду в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Weißbart bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑, 그리고 역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 화이트비어드에게 돌아가야 합니다.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d\'est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l\'est. Revenez ensuite voir l\'émissaire Blanchebarbe à la Chapelle de l\'Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的白须大使复命。‡佔領東瘟疫之地的皇冠哨塔，東牆之塔，北地哨塔和病木林哨塔，再回到聖光之願禮拜堂的密使·白鬚那裡。',
  }
},
[9665] = {
  {
    'Reforçando nossas defesas‡Укрепим оборону‡Verstärkung der Verteidigung‡방어선 강화‡Fortalecimiento de nuestras defensas‡Fortalecimiento de nuestras defensas‡Renforcer nos défenses‡加强防御‡增強防禦',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Gormok, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и возвращайтесь к посланнику Гормоку в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Gormok bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑, 그리고 역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 고르목에게 돌아가십시오.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d\'est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l\'est. Revenez ensuite voir l\'émissaire Gormok à la Chapelle de l\'Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的高莫克大使复命。‡佔領東瘟疫之地的皇冠哨塔，東牆之塔，北地哨塔和病木林哨塔，再回到聖光之願禮拜堂的密使·戈馬克那裡。',
  }
},
[9666] = {
  {
    'Declaração de poder‡Демонстрация силы‡Demonstration der Macht‡힘의 경고‡Declaración de poder‡Declaración de poder‡Déclaration de puissance‡展示力量‡宣示力量',
    nil,
    'Kessel, da Travessia de Kessel, que fica na Ilha Névoa Rubra, quer que você mate o Lorde Xiz no Covil dos Escamódios e enfie o Estandarte Draenei no cadáver.‡Проникните в логово клана Зловещей Чешуи, убейте лорда Ксиза и пронзите его тело древком дренейского знамени.‡Kessel bei Kessels Wegelager auf der Blutmythosinsel möchte, dass Ihr Lord Xiz bei der Hassprankenzuflucht tötet und das Banner der Draenei durch seinen Körper stoßt.‡핏빛안개 섬의 케셀의 길목에 있는 케셀이 성난비늘 둥지에 있는 군주 시즈를 처치한 후, 그의 시체에 드레나이 깃발을 꽂아 달라고 부탁했습니다.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que mates a Lord Xiz, de la Guarida Escama de Cólera, y atravieses su cadáver con el estandarte draenei.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que mates a Lord Xiz, de la Guarida Escama de Cólera, y atravieses su cadáver con el estandarte draenei.‡Sur ordre de Kessel, à la Croisée de Kessel sur l\'Île de Brume-sang, allez tuer le Seigneur Xiz au Repaire des Irécailles et plantez la Bannière draeneï sur son cadavre.‡秘血岛凯希尔路口的凯希尔要你杀掉怒鳞巢穴的克希兹领主，并将德莱尼军旗插在他的尸体上。‡血謎島，凱索十字路的凱索要你殺了怒鱗巢穴的希司領主，並將德萊尼旗幟插入他的屍體。',
  }
},
[9667] = {
  {
    'O resgate da Princesa Pinhoquieto‡Спасение принцессы Тихвой‡Rettet die Prinzessin der Tannenruhfeste‡공주 너울소나무 구출‡Salvar a la princesa Semprepino‡Salvar a la princesa Semprepino‡Il faut sauver la princesse Calmepin‡拯救止松公主‡拯救靜松公主',
    nil,
    'Liberte a Princesa Pinhoquieto da jaula e, em seguida, fale com o Embaixador de Pinhoquieto Frasaboo no Entreposto Rubro.nnÉ preciso matar o Chefe Supremo Ericerdo para pegar a chave que abre a jaula.‡Выпустите принцессу Тихвой из клетки, а затем найдите на Кровавой заставе посла племени Тихвой Фрасабу и поговорите с ним.nnЧтобы раздобыть ключ от клетки, убейте верховного вождя племени Косолапов.‡Befreit die Prinzessin der Tannenruhfeste aus ihrem Käfig und sprecht anschließend mit Botschafter Frasaboo der Tannenruhfeste bei der Blutwacht.nnIhr müsst den Oberhäuptling der Sichelklauen töten, um an den Schlüssel für den Käfig zu gelangen.‡공주 너울소나무를 철장에서 구해낸 후 핏빛 감시초소에 있는 너울소나무일족 대사 프라사부와 대화해야 합니다.nn그녀를 구하려면 대족장 뾰족가지를 처치하고 열쇠를 얻어야 합니다.‡Libera a la Princesa Semprepino de su jaula y habla después con el embajador Semprepino Frasaboo, en la Avanzada de Sangre.nnTienes que matar al gran jefe Erizapúas para conseguir la llave de la jaula.‡Libera a la Princesa Semprepino de su jaula y habla después con el embajador Semprepino Frasaboo, en la Avanzada de Sangre.|n|nTienes que matar al gran jefe Erizapúas para conseguir la llave de la jaula.‡Faites sortir la Princesse Calmepin de sa cage, puis allez parler à l\'ambassadeur Calmepin Frasaboo au Guet du sang.nnVous devez tuer le Grand chef Bras-hirsute pour obtenir la clé qui ouvre la cage.‡将止松公主救出牢笼，然后与秘血岗哨的止松大使弗拉萨布谈一谈。nn你必须杀掉刺臂酋长才能拿到牢笼的钥匙。‡釋放囚禁在籠子裡的靜松公主後與血色守望的靜松大使法薩布談談。|n你得殺掉大酋長鬚肢才能得到籠子的鑰匙。',
  }
},
[9668] = {
  {
    'Apresente-se ao exarca Admetius‡Доклад экзарху Адметиусу‡Erstattet Exarch Admetius Bericht‡총독 애드미티우스에게 보고‡Informar al exarca Admetius‡Informar al exarca Admetius‡Rapport à l\'exarque Admetius‡向主教埃德门图斯报告‡向主教阿德密特斯回報',
    nil,
    'Fale com o Exarca Admetius no Entreposto Rubro.‡Поговорите с экзархом Адметиусом на Кровавой заставе.‡Sprecht mit Exarch Admetius bei der Blutwacht.‡핏빛 감시초소에 있는 총독 애드미티우스와 대화해야 합니다.‡Habla con el exarca Admetius en la Avanzada de Sangre.‡Habla con el exarca Admetius en la Avanzada de Sangre.‡Parlez à l\'Exarque Admetius au Guet du sang.‡与秘血岗哨的主教埃德门图斯谈一谈。‡和血色守望的主教阿德密特斯談談。',
  }
},
[9669] = {
  {
    'A expedição desaparecida‡Пропавшая экспедиция‡Forschungsreise in den Tod‡실종된 연구단‡La expedición desaparecida‡La expedición desaparecida‡L\'expédition disparue‡覆灭的远征队‡失蹤的遠征隊',
    nil,
    'Mate 8 Tecelãs das Brumas, 8 Sangra-brumas e a líder das aranhas, Zarakh. Fale novamente com Achelus no Entreposto Rubro quando terminar a tarefa.‡Убейте 8 пауков-ткачих, 8 паучих-кровопийц и матриарха пауков – Зарак. По завершении задания вернитесь на Кровавую заставу к Акелусу.‡Tötet 8 Mythosspinner, 8 Mythosfänger und ihre Anführerin Zarakh. Kehrt anschließend zu Achelus bei der Blutwacht zurück.‡안개 그물거미 8마리, 안개 흡혈거미 8마리 그리고 우두머리인 자라크를 처치한 후 핏빛 감시초소에 있는 아켈루스에게 돌아가야 합니다.‡Mata 8 brumahiladoras, 8 brumasanguijuela y a su líder, Zarakh. Vuelve a ver a Achelus en la Avanzada de Sangre cuando hayas completado la tarea.‡Mata 8 hiladoras de bruma, 8 parasitadoras de bruma y a su líder, Zarakh. Vuelve a ver a Achelus en la Avanzada de Sangre cuando hayas completado la tarea.‡Tuez 8 Tisseuses de brume, 8 Sangsues de brume et leur chef Zarakh. Revenez voir Achelus au Guet du sang quand votre mission sera achevée.‡杀掉8个秘网编织者、8个秘网吸血者和它们的首领萨拉肯。任务完成后向秘血岗哨的阿彻鲁斯复命。‡殺死8隻謎霧紡紗者，8隻謎霧吸血者和他們的領導者，沙拉克。任務完成後回到血色守望找阿奇拉斯。',
  }
},
[9670] = {
  {
    'Estão todos vivos! Ou não...‡Они живы! Может быть...‡Sie leben! Vielleicht...‡생존자 구출‡¡Viven! A lo mejor...‡¡Viven! A lo mejor...‡Ils sont vivants ! Peut-être...‡他们还活着！也许......‡他們還活著!或許吧……',
    nil,
    'O Pesquisador Cornelius quer que você liberte 5 Pesquisadores da Expedição.‡Освободите 5 ученых экспедиции по просьбе ученого Корнелиуса.‡Forscher Cornelius hat Euch darum gebeten, 5 Expeditionsforscher zu befreien.‡연구원 코르넬리우스가 원정대 연구원 5명을 구해 달라고 부탁했습니다.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡Le Chercheur Cornelius vous a demandé de libérer 5 Chercheurs de l’expédition.‡研究员考内留斯要你救出5个远征队研究员。‡研究員卡尼勒斯要你救出5個遠征隊研究員。',
  }
},
[9671] = {
  {
    'Entrega urgente‡Срочная доставка‡Dringende Nachricht‡긴급 배달‡Entrega urgente‡Entrega urgente‡Une livraison urgente‡紧急信件‡緊急送件',
    nil,
    '‡Ты - Вентурианец? Что ж, вовремя! Я уже и не надеялся тебя найти.nnЗагляни в почтовый ящик - там тебя ждет срочное письмо. Мне его передал один человек, адмирал с острова Лазурной Дымки. Как же его звали... Одиссей? Одессит?.. Нет, не помню: из головы вылетело. Но он сказал, что ты его непременно вспомнишь.nn<Гермесий пожимает плечами.>‡Seid Ihr <Name>? Es wurde auch Zeit! Ich war gerade dabei, die Suche nach Euch aufzugeben!nnBeim Briefkasten wartet eine dringende Nachricht auf Euch. Die Person, die sie mir übergeben hatte, war ein Admiral der Menschen von der Azurmythosinsel. Admiral Odesy-irgendwas... der Name ist mir entfallen. Er sagte, Ihr würde wissen, wer er sei.‡‡‡‡‡‡',
  }
},
[9672] = {
  {
    'O Almirante Negro‡Наследие Проклятой Крови‡Das Vermächtnis des Blutfluchs‡핏빛저주의 유산‡El legado de la Sangre Maldita‡El legado de la Sangre Maldita‡L\'héritage du sang maudit‡血咒的遗产‡血咒遺產',
    nil,
    'O Almirante Odisseu pediu para você encontrar e falar com o Capitão Cândido João.‡Адмирал Одиссий просит разыскать капитана Эдварда Хейнса и поговорить с ним.‡Admiral Odesyus hat Euch gebeten, nach Kapitän Edward Hanes zu suchen und mit ihm zu sprechen.‡제독 오디시우스가 선장 에드워드 헤인즈를 찾아서 대화해 보라고 부탁했습니다.‡El almirante Odesyus quiere que encuentres al capitán Edward Hanes.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡L’amiral Odesyus vous a demandé de trouver le Capitaine Edward Hanes et de lui parler.‡海军上将奥德修斯要你找到艾德华·汉斯船长，然后与他谈一谈。‡艦隊司令·奧迪席斯要你找到隊長艾德華·漢尼斯並和他談談。',
  }
},
[9673] = {
  {
    'Beast Training‡Дрессировка‡Wildtierausbildung‡야수 길들이기‡Doma de bestias‡Doma de bestias‡La formation de dresseur‡训练野兽‡野獸訓練',
    nil,
    'Fale com Halthenis em Luaprata.‡Поговорите с Хальтенисом в Луносвете.‡Sprecht mit Halthenis in Silbermond.‡실버문에 있는 할데니스와 대화하십시오.‡Ve a la Ciudad de Lunargenta y habla con Halthenis.‡Ve a la Ciudad de Lunargenta y habla con Halthenis.‡Parlez à Halthenis à Lune-d’Argent.‡与银月城的哈森尼斯谈一谈。‡和銀月城的海德尼斯談談。',
  }
},
[9674] = {
  {
    'As nagas Sangue Maldito‡Проклятые наги‡Die Naga des Blutfluchs‡핏빛저주에 걸린 나가‡Los nagas Sangre Maldita‡Los nagas Sangre Maldita‡Les nagas au sang maudit‡血咒纳迦‡血咒納迦',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você mate 10 Nagas Sangue Maldito.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит убить 10 наг с острова Проклятой Крови.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr 10 Naga des Blutfluchs tötet.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 핏빛저주에 걸린 나가 10마리를 처치해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que mates a 10 nagas Sangre Maldita.|n‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que mates a 10 nagas Sangre Maldita.|n‡Le capitaine Edward Hanes, sur l\'île Balafre-du-ver, veut que vous tuiez 10 Nagas du sang maudit.‡龙痕岛的艾德华·汉斯船长要你杀掉10个血咒纳迦。‡龍痕島的隊長艾德華·漢尼斯要你殺死10個血咒納迦。',
  }
},
[9675] = {
  {
    'Beast Training‡Дрессировка‡Wildtierausbildung‡가나르와의 대화‡Doma de bestias‡Doma de bestias‡La formation de dresseur‡野兽训练‡野獸訓練',
    nil,
    'Fale com Ganaar no Setor Comercial da Exodar.‡Поговорите с Ганааром в Торговом ряду Экзодара.‡Sprecht mit Ganaar bei der Händlertreppe der Exodar.‡엑소다르의 교역 지구에 있는 가나르와 대화해야 합니다.‡Habla con Ganaar en La Grada de los Mercaderes de El Exodar.‡Habla con Ganaar en La Grada de los Mercaderes de El Exodar.‡Parlez à Ganaar à l\'Étage des commerces de l\'Exodar.‡与埃索达贸易阶梯内的甘纳尔谈一谈。‡到艾克索達的貿易區和加納談談。',
  }
},
[9676] = {
  {
    'Treinamento de paladino‡Наставник паладинов‡Ausbildung zum Paladin‡성기사 훈련‡Entrenamiento de paladín‡Instrucción de paladín‡La formation du paladin‡圣骑士训练‡聖騎士訓練',
    nil,
    'Fale com o instrutor de paladinos Jesthenis Golpessol na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставником паладинов Джестенисом Солнцесветом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Jesthenis Sonnensturm - dem Paladinlehrer - im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 성기사 제스테니스 선스트라이커와 대화하십시오.‡Habla con Jesthenis Golpesol, el instructor de clase de paladines, en La Aguja del Sol en la Isla del Caminante del Sol.‡Habla con Jesthenis Golpesol, el instructor de clase de paladines, en La Aguja del Sol en la Isla del Caminante del Sol.‡Parlez à Jesthenis Heurtesoleil, le maître des paladins, à l\'intérieur de la Flèche solaire, sur l\'île de Haut-soleil.‡与逐日岛太阳之塔内的圣骑士训练师耶泰尼斯-射日者谈一谈。‡和傑斯賽尼斯·擊日者 - 聖騎士職業訓練師 - 談談，他就在逐日者之島的日尖塔裡。',
  }
},
[9677] = {
  {
    'Convocação do Grão-cavaleiro Sangueroico‡Призыв предводителя рыцарей Кровосмела‡Aufforderung des Ritterfürsten Heldenblut‡기사군주 블러드밸러의 호출‡El llamamiento del Lord caballero Sangrevalor‡El llamamiento del Lord caballero Sangrevalor‡Le chevalier-seigneur Vaillessang vous réclame‡骑士领主布拉德瓦罗的召唤‡騎士領主伯洛德瓦勒的召喚',
    nil,
    'Fale com o Grão-cavaleiro Sangueroico no Largo dos Andarilhos, que fica em Luaprata.‡Поговорите с предводителем рыцарей Кровосмелом на площади Странников в Луносвете.‡Sprecht mit Ritterfürst Heldenblut beim Platz der Weltenwanderer in Silbermond.‡실버문의 순찰대 광장에 있는 기사군주 블러드밸러와 대화하십시오.‡Habla con el Lord caballero Sangrevalor en la Plaza del Errante de la Ciudad de Lunargenta.‡Habla con el Lord caballero Sangrevalor en la Plaza del Errante de la Ciudad de Lunargenta.‡Parlez au chevalier-seigneur Vaillessang, place des Pérégrins, à Lune-d\'argent.‡与银月城远行者广场的骑士领主布拉德瓦罗谈一谈。‡到銀月城的遠行者廣場和騎士領主伯洛德瓦勒談談。',
  }
},
[9678] = {
  {
    'A primeira provação‡Первое испытание‡Die erste Prüfung‡첫 번째 시험‡La primera prueba‡La primera prueba‡La première épreuve‡第一项试炼‡第一個試煉',
    nil,
    'Vá até a ilha descrita pelo Grão-cavaleiro Sangueroico, encontre a caverna e acenda o braseiro. Depois da Primeira Provação, fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Отправляйтесь на остров, описанный предводителем рыцарей Кровосмелом, найдите пещеру и разожгите огонь в жаровне. Пройдя первое испытание, возвращайтесь к предводителю рыцарей Кровосмелу в Луносвет.‡Reist zu der Insel, die Euch Ritterfürst Heldenblut beschrieben hat, sucht die Höhle und entzündet die Kohlepfanne. Kehrt, nachdem Ihr die erste Prüfung bestanden habt, zu Ritterfürst Heldenblut in Silbermond zurück.‡기사군주 블러드밸러가 설명한 섬으로 가서 동굴을 찾은 다음 화로에 불을 붙여야 합니다. 첫 번째 시험을 통과하면 실버문에 있는 기사군주 블러드밸러에게 돌아가십시오.‡Viaja a la isla que el Lord caballero Sangrevalor describió, encuentra la caverna, y enciende el blandón. Cuando acabe la primera prueba vuelve junto al Lord caballero Sangrevalor en la Ciudad de Lunargenta.‡Viaja a la isla que el Lord caballero Sangrevalor describió, encuentra la caverna, y enciende el blandón. Cuando acabe la primera prueba vuelve junto al Lord caballero Sangrevalor en la Ciudad de Lunargenta.‡Voyagez jusqu\'à l\'île que le chevalier-seigneur a décrite, trouvez la caverne et allumez le brasero. Lorsque la Première épreuve sera terminée, retournez voir le chevalier-seigneur Vaillessang à Lune-d\'argent.‡前往骑士领主布拉德瓦罗所描述的那座小岛，找到洞穴，并点亮火盆。当第一个试炼完成之后，向银月城的骑士领主布拉德瓦罗复命。‡前往騎士領主伯洛德瓦勒所描述的島，找到洞穴，並點燃火盆。當第一個試煉結束，回到銀月城的騎士領主·伯洛德瓦勒那裡。',
  }
},
[9680] = {
  {
    'Desencavando o passado‡Тайны прошлого‡Die Vergangenheit aufwühlen‡과거의 추적‡Resucitar el pasado‡Resucitar el pasado‡Exhumer le passé‡挖掘历史‡',
    nil,
    'O Arquimago Alturus quer que você vá para as montanhas ao sul de Karazhan, na Trilha do Vento Morto, e recupere um Fragmento de Osso Carbonizado.‡Верховный маг Альтур желает, чтобы вы нашли в горах к югу от Каражана на Перевале Мертвого Ветра фрагмент обугленной кости и доставили ему.‡Erzmagier Alturus möchte, dass Ihr zu den Bergen südlich von Karazhan im Gebirgspass der Totenwinde geht und ein verkohltes Knochenfragment besorgt.‡대마법사 알투루스가 카라잔 남쪽의 저승바람 고개에 있는 산으로 가서 그을린 뼈 조각을 되찾아 달라고 했습니다.‡El archimago Alturus quiere que vayas a las montañas al sur de Karazhan en el Paso de la Muerte y consigas un trozo de hueso carbonizado.‡El archimago Alturus quiere que vayas a las montañas al sur de Karazhan en el Paso de la Muerte y consigas un trozo de hueso carbonizado.‡L\'archimage Alturus veut que vous vous rendiez dans les montagnes au sud de Karazhan dans le défilé de Deuillevent et que vous y récupériez un Fragment d\'os carbonisé.‡大法师奥图鲁斯要求你前往逆风小径，从卡拉赞以南的山脉中取回一块焦骨碎块。‡',
  }
},
[9681] = {
  {
    'Um estudo da energia‡Источник силы‡Eine Studie der Macht‡힘을 연구하다‡Un estudio sobre el poder‡Un estudio sobre el poder‡Une étude du pouvoir‡掌握力量‡學習力量',
    nil,
    'Fale com o Magíster Astalor Jurassangue na câmara oculta sob o quartel-general dos Cavaleiros Sangrentos.‡Поговорите с магистром Асталором Кровавой Клятвой в тайной зале, расположенной под штабом рыцарей Крови.‡Sprecht mit Magister Astalor Blutschwur in der Geheimen Kammer unter dem Hauptquartier der Blutelfen.‡혈기사 본부 지하에 숨겨진 방에 있는 마법학자 아스탈로르 블러드스원과 대화해야 합니다.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del cuartel general de los Caballeros de sangre.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del cuartel general de los Caballeros de sangre.‡Parlez au magistère Astalor Ligessang dans la chambre secrète sous les quartiers généraux des chevaliers de sang.‡与血骑士总部楼下密室中的魔导师阿斯塔洛·血誓谈一谈。‡到血騎士總部底下隱藏的房間裡和博學者阿斯塔樂·血誓談談。',
  }
},
[9682] = {
  {
    'Os desesperados...‡Отчаявшиеся‡Die Hoffnungslosen...‡핏빛저주의 영혼‡Los Desesperados...‡Los Desesperados...‡Les sans-espoir…‡绝望者......‡絕望者……',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você recupere 4 Almas de Sangue Amaldiçoado.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит освободить 4 души с острова Проклятой Крови.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr 4 Seelen des Blutfluchs zu ihm bringt.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 핏빛저주에 걸린 영혼 4명을 구원해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que consigas 4 almas de Sangre Maldita.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que consigas 4 almas de Sangre Maldita.‡Le capitaine Edward Hanes de l\'île Balafre-du-ver veut que vous récupériez 4 Âmes au sang maudit.‡龙痕岛的艾德华·汉斯船长要你找到4个血咒之魂。‡龍痕島的隊長艾德華·漢尼斯要你帶回4個血咒靈魂。',
  }
},
[9683] = {
  {
    'Acabando com o Sangue Maldito‡Избавление от Проклятой Крови‡Beendigung des Blutfluchs‡핏빛저주의 멸망‡El fin de la Sangre Maldita‡El fin de la Sangre Maldita‡Mettre un terme à la malédiction du sang‡血咒的终结‡終止血咒',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você destrua a Estátua da Rainha Azshara e mate Atoph, o Sangue Maldito.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит уничтожить статую королевы Азшары и убить Атофа Проклятую Кровь.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr die Statue der Königin Azshara zerstört und Atoph des Blutfluchs tötet.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 아즈샤라 여왕의 석상을 파괴하고 핏빛저주의 아토프를 처치해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que destruyas la estatua de la reina Azshara y mates a Atoph, el Sangre Maldita.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que destruyas la estatua de la reina Azshara y mates a Atoph, el Sangre Maldita.‡Le capitaine Edward Hanes de l\'île Balafre-du-ver veut que vous détruisiez la Statue de la reine Azshara et éliminiez Atoph du Sang maudit.‡龙痕岛的艾德华·汉斯船长要你毁掉艾萨拉女王的雕像，并杀掉血咒者埃托弗。‡龍痕島的隊長艾德華·漢尼斯要你摧毀艾薩拉女王雕像並殺了血咒的阿托夫。',
  }
},
[9684] = {
  {
    'Poder sobre a Luz‡Получение силы Света‡Die Beherrschung des Lichts‡빛을 추구하다‡Buscando la Luz‡Buscando la Luz‡Revendiquer la Lumière‡‡',
    nil,
    'Use o Recipiente Cintilante nos Magísteres Elfos Sangrentos para enchê-lo e fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Используйте мерцающий сосуд на эльфах крови-магистрах, чтобы наполнить его магической силой и возвращайтесь к предводителю рыцарей Кровосмелу в Луносвет.‡Wendet das schimmernde Gefäß auf die Magister der Blutelfen an, um es zu füllen und kehrt anschließend zu Ritterfürst Heldenblut in Silbermond zurück.‡희미하게 빛나는 용기 안에 블러드 엘프 마법학자의 힘을 가득 채운 다음 실버문의 기사군주 블러드밸러와 다시 대화해야 합니다.‡Llena la vasija refulgente en magistri elfos de sangre y llévasela al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Llena la vasija refulgente en magistri elfos de sangre y llévasela al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Utilisez le Calice chatoyant sur les Magistères elfes de sang pour le remplir et retournez voir le chevalier-seigneur Vaillessang à Lune-d’Argent.‡‡',
  }
},
[9685] = {
  {
    'Morreu, mas passa bem‡Воскрешение‡Die Erlösung der Toten‡죽은 자 부활시키기‡Redimir a los muertos‡Redimir a los muertos‡La rédemption des morts‡救赎死者‡',
    nil,
    'Leve o Recipiente Cintilante Cheio até a estalagem de Luaprata e use a magia contida nele para ressuscitar Sangrias Tranquilâmina.‡Отправляйтесь в таверну Луносвета и воскресите Сангриаса Безмолвного Клинка с помощью силы, заключенной в наполненном мерцающем сосуде.‡Bringt das gefüllte schimmernde Gefäß zum Gasthaus von Silbermond und verwendet seine Magie, um Sangrias Stillstreich wiederzubeleben.‡실버문의 여관에 가득 찬 희미하게 빛나는 용기를 가져가십시오. 용기 안에 담긴 마력을 이용하여 상그리아스 스틸블레이드를 부활시켜야 합니다.‡Lleva la vasija refulgente llena a la posada de la Ciudad de Lunargenta y utiliza su magia para resucitar a Sangrias Hojafirme.‡Lleva la vasija refulgente llena a la posada de la Ciudad de Lunargenta y utiliza su magia para resucitar a Sangrias Hojafirme.‡Apportez le Calice chatoyant rempli à l\'auberge de Lune-d’Argent et utilisez ses pouvoirs magiques pour ressusciter Sangrias Mortelame.‡带着装满的微光容器到银月城旅店去，使用其中的力量复活桑利亚斯·静刃。‡',
  }
},
[9686] = {
  {
    'The Second Trial‡Второе испытание‡Die zweite Prüfung‡두 번째 시험‡La segunda prueba‡La segunda prueba‡La deuxième épreuve‡第二项试炼‡第二個試煉',
    nil,
    'Conclua a segunda provação vencendo o Campeão Furiassangue, o Campeão Rasgaluz, a Campeã Lâmina Célere e o Campeão Golpessol no pavilhão próximo do Mestre Kelerun Sanguemágoa.‡Пройдите второе испытание, победив воителя Ярокрова, воителя Светореза, воительницу Быстромеч и воителя Солнцесвета в павильоне у наставника Келерана Алого Взмаха.‡Besteht die zweite Prüfung und besiegt Champion Rachblut, Champion Lichtrend, Champion Schnellklinge und Champion Sonnensturm im Pavillon in der Nähe von Meister Kelerun Blutpein.‡단장 켈레룬 블러드모운와 가까운 거리를 유지한 채 건물 안에서 용사 블러드래스, 용사 라이트렌드, 용사 스위프트블레이드, 용사 선스트라이커를 물리치고 두 번째 시험을 완료해야 합니다.‡Completa la segunda prueba derrotando a los Campeones Furiasangre, Pautaluz, Hojágil y Golpesol en el pabellón cerca del maestro Kelerun Lamento de Sangre.‡Completa la segunda prueba derrotando a los Campeones Furiasangre, Rasgaluz, Hojágil y Golpesol en el pabellón cerca del maestro Kelerun Lamento de Sangre.‡Achevez la seconde épreuve en battant le Champion Hargnessang, le Champion Brise-Lumière, le Champion Vivelame et le Champion Heurtesoleil dans le pavillon situé à côté de maître Kelerun Deuillessang.‡击败克雷伦·血伤一旁帐篷中的勇士布拉维·血怒、勇士莱伦德·光痕、勇士玛尔娅·迅刃和勇士斯塔克·射日者，完成第二项试炼。‡完成第二次的試煉，在大師克萊倫‧布勞德摩爾附近的亭子裡擊敗血怒勇士，勇士萊特蘭德，迅刃勇士，及勇士桑司瑞克。',
  }
},
[9687] = {
  {
    'Devolver o sagrado sossego‡Святотатство‡Wiederherstellung der Heiligkeit‡신성한 의무‡Recuperando huesos sacros‡Recuperando huesos sacros‡Rétablir la tranquillité‡找回尊严‡恢復聖潔',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, quer que você recupere 8 Ossos de Dragão.‡Принц Торет с острова Драконьей Скорби просит отыскать 8 костей драконов.‡Prinz Toreth auf der Insel Drachenfels möchte, dass Ihr 8 Drachenknochen wiedererlangt.‡고룡흉터 섬에 있는 왕자 토레스가 용의 뼈 8개를 되찾아 달라고 부탁했습니다.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que le lleves 8 huesos de dragón.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que le lleves 8 huesos de dragón.‡Le prince Toreth de l\'île Balafre-du-ver veut que vous rapportiez 8 Os de dragon.‡龙痕岛的托雷斯王子要你找回8根龙骨。‡龍痕島的托瑞斯王子要你取回8根龍骨。',
  }
},
[9688] = {
  {
    'Sonho impossível‡Дорога в Сон‡Im Traum‡녹색용군단의 영혼 구원‡Entrando en el Sueño‡Entrando en el Sueño‡Vers le Rêve‡进入梦境‡進入夢境',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, pediu que você matasse 5 Dragonetes Viridianos e 5 Filhotes Viridianos.‡Принц Торет с острова Драконьей Скорби просит убить 5 темно-зеленых дракончиков и 5 детенышей зеленого дракона.‡Prinz Toreth auf der Insel Drachenfels hat von Euch verlangt, dass Ihr 5 Viridianwelpen und 5 Viridianbrutlinge tötet.‡고룡흉터 섬에 있는 왕자 토레스가 작은 청록 새끼용, 청록 새끼용을 각각 5마리씩 처치해 달라고 부탁했습니다.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que mates 5 crías y 5 estirpes viridianas.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que mates a 5 crías y a 5 estirpes veridiana.‡Le prince Toreth de l\'île Balafre-du-ver vous a demandé de tuer 5 Jeunes virides et 5 Rejetons virides.‡龙痕岛的托雷斯王子要你杀掉5只绿色雏龙和5只绿色龙崽。‡龍痕島的托瑞斯王子要你殺死5隻翠綠色幼龍和5隻翠綠色小龍。',
  }
},
[9689] = {
  {
    'Rasgaqueixo‡Острозуб‡Messerrachen‡칼날아귀‡Tajobuche‡Tajobuche‡Tranchegueule‡刺喉‡瑞索默',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, pediu que você matasse o Rasgaqueixo.‡Принц Торет с острова Драконьей Скорби просит убить Острозуба.‡Prinz Toreth auf der Insel Drachenfels hat von Euch verlangt, dass Ihr Messerrachen tötet.‡고룡흉터 섬에 있는 왕자 토레스가 칼날아귀를 처치해 달라고 부탁했습니다.‡El Príncipe Toreth de la Isla Cicatriz de Vermis ha pedido que mates a Tajobuche.‡El príncipe Toreth de la Isla Cicatriz de Vermis ha pedido que mates a Tajobuche.‡Le prince Toreth de l\'île Balafre-du-ver vous a demandé de tuer Tranchegueule.‡龙痕岛的托雷斯王子要你杀掉刺喉。‡龍痕島的托瑞斯王子要你殺了瑞索默。',
  }
},
[9690] = {
  {
    'The Second Trial‡Второе испытание‡Die zweite Prüfung‡두 번째 시험‡La segunda prueba‡La segunda prueba‡La deuxième épreuve‡第二项试炼‡第二個試煉',
    nil,
    'Apresente-se ao Mestre Kelerun Sanguemágoa.‡Поговорите с наставником Келераном Алым Взмахом.‡Meldet Euch bei Meister Kelerun Blutpein.‡단장 켈레룬 블러드모운에게 보고해야 합니다.‡Preséntate ante el maestro Kelerun Lamento de Sangre.‡Preséntate ante el maestro Kelerun Lamento de Sangre.‡Présentez-vous au maître Kelerun Deuillessang.‡向克雷伦·血伤报到。‡向大師克萊倫·布勞德摩爾回報。',
  }
},
[9691] = {
  {
    'Retorno a Luaprata‡Возвращение в Луносвет‡Rückkehr nach Silbermond‡실버문으로 돌아가기‡Retorno a Lunargenta‡Regresa a Lunargenta‡Retour à Lune-d\'argent‡返回银月城‡回到銀月城',
    nil,
    'Fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Возвращайтесь к предводителю рыцарей Кровосмелу в Луносвет.‡Kehrt zu Ritterfürst Heldenblut nach Silbermond zurück.‡실버문에 있는 기사군주 블러드밸러에게 돌아가십시오.‡Ve a ver al Lord caballero Sangrevalor en Ciudad de Lunargenta.‡Ve a ver al Lord caballero Sangrevalor en Ciudad de Lunargenta.‡Retournez voir le chevalier-seigneur Vaillessang à Lune-d’Argent.‡向银月城的骑士领主布拉德瓦罗报到。‡回到銀月城的騎士領主伯洛德瓦勒那裡。',
  }
},
[9692] = {
  {
    'Caminho do adepto‡Путь адепта‡Der Pfad des Adepten‡숙련 혈기사의 길‡El camino de los adeptos‡El camino de los adeptos‡La voie de l\'adepte‡骑士之路‡高手之路',
    nil,
    'Leve uma Gema Kor Corrompida, um Caixote de Lingotes Forjados em Sangue, uma porção de Sangue do Irascível e uma Insígnia do Cavaleiro Sangrento para o Grão-cavaleiro Sangueroico em Luaprata.‡Принесите оскверненный самоцвет Кора, ящик со слитками, закаленными в крови, нужное количество крови разгневненных и знак отличия рыцаря крови предводителю рыцарей Кровосмелу в Луносвет.‡Bringt Ritterfürst Heldenblut in Silbermond einen verderbten Koredelstein, eine Kiste mit blutgeschmiedeten Blöcken, etwas Blut des Hasserfüllten und ein Insigne der Blutritter.‡실버문에 있는 기사군주 블러드밸러에게 부정한 코르석, 핏빛철로 주괴 상자, 진노의 피, 혈기사 휘장을 하나씩 가져가야 합니다.‡Lleva 1 gema kor corrupta, 1 caja de lingotes forjados con sangre, sangre del Colérico y 1 insignia de Caballero de sangre al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Lleva 1 gema kor corrupta, 1 caja de lingotes forjados con sangre, sangre del Colérico y 1 insignia de Caballero de sangre al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Apportez une Gemme de Kor corrompue, une Caisse de lingots de forge-sang, une bonne mesure de Sang du Courroucé et un Insigne de chevalier de sang au Chevalier-seigneur Vaillessang, à Lune-d’Argent.‡将一块被污染的科尔宝石、一箱血铸铁锭、一份愤怒者之血和一枚血骑士徽章交给银月城的骑士领主布拉德瓦罗。‡將一顆被污染的科爾寶石，血鑄錠木箱，大量憤怒之血，和一個血騎士徽記帶給銀月城的騎士領主伯洛德瓦勒。',
  }
},
[9693] = {
  {
    'O que Argus significa para mim‡Что для тебя Аргус?..‡Was Argus für mich bedeutet‡아르거스의 대리인으로서‡¿Qué es Argus para ti?‡¿Qué es Argus para ti?‡Ce qu\'Argus signifie pour moi‡阿古斯的意义‡阿古斯對我的意義',
    nil,
    'O Exarca Admetius, do Entreposto Rubro, quer que você fale com o Vindicante Boros.‡Экзарх Адметиус с Кровавой заставы просит поговорить с воздаятелем Боросом.‡Exarch Admetius bei der Blutwacht wies Euch an, mit Verteidiger Boros zu sprechen.‡핏빛 감시초소에 있는 총독 애드미티우스가 구원자 보로스와 대화하라고 부탁했습니다.‡El exarca Admetius de la Avanzada de Sangre quiere que hables con el vindicador Boros.‡El exarca Admetius de la Avanzada de Sangre quiere que hables con el vindicador Boros.‡L\'exarque Admetius du Guet du sang vous a demandé de parler au redresseur de torts Boros.‡秘血岗哨的主教埃德门图斯要你去跟守备官波鲁斯谈一谈。‡血色守望的主教阿德密特斯要你去和復仇者波羅斯談談。',
  }
},
[9694] = {
  {
    'O Entreposto Rubro‡Кровавая застава‡Blutwacht‡핏빛 감시초소‡Avanzada de Sangre‡Avanzada de Sangre‡Le Guet du sang‡秘血岗哨‡血色守望',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você mate 10 Espiões Falconélius.‡Убейте 10 шпионов Солнечных Ястребов и сообщите об этом на Кровавую заставу воздаятелю Боросу.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr 10 Spione der Sonnenfalken tötet.‡핏빛 감시초소에 있는 구원자 보로스가 태양매 비밀요원 10명을 처치해 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quieres que mates a 10 espías Halcón del Sol.‡El vindicador Boros de la Avanzada de Sangre quieres que mates a 10 espías Halcón del Sol.‡Le redresseur de torts Boros au Guet du sang veut que vous tuiez 10 Espions Epervier du soleil.‡杀死10个炎鹰间谍，然后向秘血岗哨的守备官波鲁斯复命。‡血色守望的復仇者波羅斯要你殺死10個太陽之鷹間諜。',
  }
},
[9695] = {
  {
    '‡‡‡‡‡‡‡‡太陽之王的命令',
    nil,
    '‡‡‡‡‡‡‡‡將太陽之王的命令帶給血色守望的復仇者波羅斯。',
  }
},
[9696] = {
  {
    'Traduttore, traditore‡Переводы...‡Übersetzungen...‡문서 번역‡Traducciones‡Traducciones‡Traductions…‡翻译......‡翻譯……',
    nil,
    'Leve a Missiva do Falconélius para a Interrogadora Elysia no Entreposto Rubro.‡Доставьте послание Солнечных Ястребов дознавательнице Элизии на Кровавую заставу.‡Bringt das Schreiben der Sonnenfalken zur Vernehmungsbeauftragten Elysia bei der Blutwacht.‡핏빛 감시초소에 있는 심문관 엘리시아에게 태양매 서한을 가져가야 합니다.‡Lleva la misiva de los halcones del Sol a la interrogadora Elysia a la Avanzada de Sangre.‡Lleva la misiva de los Halcones del Sol a la interrogadora Elysia a la Avanzada de Sangre.‡Apportez la Missive des Eperviers du soleil à l\'interrogatrice Elysia au Guet du sang.‡将炎鹰信函交给秘血岗哨的审讯者埃莉西亚。‡將太陽之鷹書信帶給血色守望的審問者伊萊希雅。',
  }
},
[9697] = {
  {
    'Vigia Leesa\'oh‡Наблюдательница Лиса\'о‡Behüterin Leesa\'oh‡관찰자 리사오‡La vigía Leesa\'oh‡La vigía Leesa\'oh‡La gardienne Leesa\'oh‡观察者莉萨奥‡看守者里薩歐',
    nil,
    'Fale com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Поговорите с наблюдательницей Лиса\'о у кенарийского караульного поста в Зангартопи.‡Sprecht mit Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen.‡장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오와 대화해야 합니다.‡Ve al Puesto de Vigilancia Cenarion de la Marisma de Zangar y habla con la vigía Leesa\'oh.‡Ve al Puesto de Vigilancia Cenarion de la Marisma de Zangar y habla con la vigía Leesa\'oh.‡Parlez à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡与赞加沼泽塞纳里奥岗哨的观察者莉萨奥谈一谈。‡到贊格沼澤的塞納里奧看守站和看守者里薩歐談談。',
  }
},
[9698] = {
  {
    'Audiência com o profeta‡Аудиенция у Пророка‡Audienz beim Propheten‡태양왕의 명령서‡Audiencia con el Profeta‡Audiencia con el Profeta‡Une audience avec le Prophète‡会见先知‡覲見預言者',
    nil,
    'Entregue a Missiva do Falconélius Traduzida para o Profeta Velen na Exodar.‡Доставьте переведенное послание Солнечных Ястребов Пророку Велену в Экзодар.‡Bringt das übersetzte Schreiben der Sonnenfalken zum Propheten Velen bei der Exodar.‡엑소다르에 있는 예언자 벨렌에게 번역된 태양매 서한을 가져가야 합니다.‡Lleva la traducción de la carta de los Halcón del Sol al profeta Velen a El Exodar.‡Lleva la traducción de la carta de los Halcón del Sol al profeta Velen a El Exodar.‡Apportez la Missive des Eperviers du soleil traduite au prophète Velen à l\'Exodar.‡将炎鹰信函的译文交给埃索达的先知维伦。‡將翻譯太陽之鷹的書信帶給艾克索達的預言者費倫。',
  }
},
[9699] = {
  {
    'Verdade ou ficção‡Правда или вымысел‡Was ist wahr?‡진실과 거짓‡Verdad o mentira‡Verdad o mentira‡Vérité ou fiction‡真相还是谎言‡是真是假',
    nil,
    'Entregue as Ordens de Velen para o Vindicante Boros no Entreposto Rubro.‡Доставьте распоряжения Велена воздаятелю Боросу на Кровавую заставу.‡Bringt Velens Anordnungen zu Verteidiger Boros bei der Blutwacht.‡핏빛 감시초소에 있는 구원자 보로스에게 벨렌의 명령서를 가져가야 합니다.‡Lleva las órdenes de Velen al vindicador Boros a la Avanzada de Sangre.‡Lleva las órdenes de Velen al vindicador Boros a la Avanzada de Sangre.‡Apportez les Ordres de Velen au redresseur de torts Boros, au Guet du sang.‡将维伦的命令交给秘血岗哨的守备官波鲁斯。‡將費倫的命令帶給血色守望的復仇者波羅斯。',
  }
},
[9700] = {
  {
    'A dimensão do caos tá TENSA‡Магия против Тьмы‡Licht ins Dunkel bringen‡어둠에 쏘아진 마법‡Disparando magia en la oscuridad‡Disparando magia en la oscuridad‡Des traits de magie dans l\'obscurité‡黑暗中的魔法‡向黑暗中發射魔法',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você encontre o local do Portal Solar e mate 5 Anomalias do Caos.‡Воздаятель Борос с Кровавой заставы просит найти солнечный портал и убить 5 аномалий Бездны.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr die Lage des Sonnenportals ausfindig macht und 5 Anomalien der Leere tötet.‡핏빛 감시초소에 있는 구원자 보로스가 태양의 차원문 흔적을 찾고 공허의 변형물 5마리를 처치해 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quiere que encuentres el portal del Sol y mates 5 anomalías del vacío.‡El vindicador Boros de la Avanzada de Sangre quiere que encuentres el portal del Sol y mates 5 anomalías del vacío.‡Le redresseur de torts Boros du Guet du sang veut que vous trouviez l\'emplacement du Portail du soleil et que vous tuiez 5 Anomalies du Vide.‡前往太阳传送站杀死5个虚空畸能，然后向秘血岗哨的守备官波鲁斯复命。‡血色守望的復仇者波羅斯要你找到太陽之門地點並殺死5個虛無反常者。',
  }
},
[9701] = {
  {
    'Observando os Sporeggar‡Наблюдение за спорлингами‡Sporlinge beobachten‡스포어링의 생태 관찰‡Observación de esporinos‡Observación de esporinos‡L\'observation des sporelins‡观察孢子人‡觀察孢子人',
    nil,
    'Investigue o Vale dos Rebentos, no Pântano Zíngaro, e volte a falar com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro, levando seus achados.‡Исследуйте Грибную поляну в Зангартопи, затем вернитесь к наблюдательнице Лиса\'о к кенарийскому караульному посту в Зангартопи и расскажите об увиденном.‡Untersucht das Pilzgeflecht in den Zangarmarschen und berichtet danach Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen von Euren Beobachtungen.‡장가르 습지대에 있는 부화의 골짜기를 조사한 후, 발견한 내용을 세나리온 감시초소에 있는 관찰자 리사오에게 보고해야 합니다.‡Investiga La Cañada Emergente en la Marisma de Zangar e informa a la vigía Leesa\'oh del Puesto de Vigilancia Cenarion en la Marisma de Zangar de tus pesquisas.‡Investiga La Cañada Emergente en la Marisma de Zangar e informa a la vigía Leesa\'oh del Puesto de Vigilancia Cenarion en la Marisma de Zangar de tus pesquisas.‡Examiner le Vallon des pontes dans le marécage de Zangar, puis rapporter vos découvertes à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡调查赞加沼泽的孢殖林，然后返回赞加沼泽的塞纳里奥岗哨，向观察者莉萨奥汇报你的发现。‡調查贊格沼澤的重生峽谷，再將你的發現帶回贊格沼澤向塞納里奧看守站的看守者里薩歐回報。',
  }
},
[9702] = {
  {
    'Um problema de gula‡Вопросы питания‡Eine Frage der Fressgier‡굶주림의 이유‡Cuestión de glotonería‡Cuestión de glotonería‡Un problème de gloutonnerie‡狼吞虎咽‡暴食的問題',
    nil,
    'Colete 10 amostras de Nutrimentos Descartados e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 10 образцов выброшенного корма и вернитесь к наблюдательнице Лиса\'о на кенарийский караульный пост в Зангартопи.‡Sammelt 10 Stück liegengelassene Nahrung und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버려진 버섯 10개를 수집한 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recoge 10 restos de alimentos y llévaselas al vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Recoge 10 restos de alimentos y llévaselos a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Récupérez 10 morceaux d’Aliments abandonnés puis revenez voir la gardienne Leesa\'oh au Poste de garde cénarien, dans le marécage de Zangar.‡将10份丢弃的食物交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集10份被丟棄的營養品再回到贊格沼澤的塞納里奧看守站找看守者里薩歐。',
  }
},
[9703] = {
  {
    'O Crio-núcleo‡Криогенный блок‡Der Kryokern‡극저온 핵‡El Crionúcleo‡El Crionúcleo‡Le cryocœur‡冷却核心‡冬眠核心',
    nil,
    'O Vindicante Kuros, do Entreposto Rubro, quer que você recupere 12 caixas de Suprimentos Médicos.‡Воздаятель Курос хочет, чтобы вы доставили на Кровавую заставу 12 коробок с медицинскими припасами.‡Verteidiger Kuros bei der Blutwacht möchte, dass Ihr 12 Kisten mit Heilvorräten sichert.‡핏빛 감시초소에 있는 구원자 쿠로스가 의약품 상자 12상자를 찾아 달라고 부탁했습니다.‡El vindicador Kuros de la Avanzada de Sangre quiere que recuperes 12 cajas de suministros médicos.‡El vindicador Kuros de la Avanzada de Sangre quiere que recuperes 12 cajas de suministros médicos.‡Le redresseur de torts Kuros au Guet du sang veut que vous récupériez 12 boîtes de Fournitures médicales.‡取回12箱医疗补给品，然后向秘血岗哨的守备官库卢斯复命。‡血色守望的復仇者庫羅斯要你取得12箱醫療補給。',
  }
},
[9704] = {
  {
    'Ceifado pelos ignóbeis!‡Смерть от рук Презренных‡Von den Getriebenen getötet‡버림받은 자들에 의해 살해된 길잡이‡Ejecutados por los desdichados‡Ejecutados por los desdichados‡Tuée par les Déshérités‡失心者的牺牲品‡鄙惡者兇手',
    nil,
    'Rume para as ruínas de Luaprata ao sul e encontre a Vanguardeira Assassinada na Alameda Alvorecente.‡Отправляйтесь на юг, в руины Луносвета, и отыщите убитого курьера на Рассветной улице.‡Geht nach Süden zu den Ruinen von Silbermond und haltet nach der getöteten Kundschafterin beim Dämmerweg Ausschau.‡남쪽 실버문의 폐허로 가서 새벽길에 있는 살해된 길잡이를 찾아야 합니다.‡Ve hacia el sur a las Ruinas de Ciudad de Lunargenta y busca a la avanzada asesinada en Calle del Alba.‡Ve hacia el sur a las Ruinas de Ciudad de Lunargenta y busca a la avanzada asesinada en Calle del Alba.‡Allez au sud dans les ruines de Lune-d’Argent et cherchez l’Estafette morte dans l\'allée du Point-du-jour.‡往南进入银月城废墟，在黎明之路附近寻找被杀死的信使。‡往南進入銀月廢墟的黎明小路尋找被殺的先驅者。',
  }
},
[9705] = {
  {
    'Recuperação do pacote‡Возвращение посылки‡Bergung des Päckchens‡소포 회수‡Recuperación de paquete‡Recuperación de paquete‡Récupérer un paquet‡找回包裹‡重獲包裹',
    nil,
    'Fale novamente com a Vanguardeira Alarion levando o Pacote da Erona.‡Вернитесь к курьеру Аларион с посылкой Эроны.‡Kehrt mit Eronas Päckchen zu Kundschafterin Alarion zurück.‡이로나의 소포를 가지고 길잡이 알라리온에게 돌아가십시오.‡Regresa junto a la avanzada Alarion con el paquete de Erona.‡Regresa junto a la avanzada Alarion con el paquete de Erona.‡Retournez voir l’estafette Alarion avec le Paquet d’Erona.‡将艾洛娜的包裹交给信使奥拉莉恩。‡將伊羅娜的包裹帶給先驅者艾拉瑞恩。',
  }
},
[9706] = {
  {
    'Diário de Galaen - O destino do vindicante Saruan‡Дневник Галена: судьба воздаятеля Саруана‡Galaens Tagebuch - Das Schicksal von Verteidiger Saruan‡구원자 사루안의 운명‡El diario de Galaen: El destino del vindicador Saruan‡El diario de Galaen: El destino del vindicador Saruan‡Le journal de Galaen - Le destin du redresseur de torts Saruan‡加莱恩的日记 - 守备官撒鲁安的命运‡高拉恩的日誌 - 復仇者薩魯安的命運',
    nil,
    'Entregue o Diário de Galaen para o Vindicante Kuros no Entreposto Rubro.‡Доберитесь до Кровавой заставы и отдайте дневник Галена воздаятелю Куросу.‡Bringt Galaens Tagebuch zu Verteidiger Kuros bei der Blutwacht.‡핏빛 감시초소에 있는 구원자 쿠로스에게 갈라엔의 일지를 가져가야 합니다.‡Lleva el diario de Galaen al vindicador Kuros a la Avanzada de Sangre.|n‡Lleva el diario de Galaen al vindicador Kuros a la Avanzada de Sangre.|n‡Apportez le Journal de Galaen au redresseur de torts Kuros au Guet du sang.‡将加莱恩的日记交给秘血岗哨的守备官库卢斯。‡將高拉恩的日誌帶給血色守望的復仇者庫羅斯。',
  }
},
[9707] = {
  {
    'A forja da arma‡Ковка оружия‡Das Schmieden der Waffe‡‡Forjando el arma‡Forjando el arma‡Forger l\'arme‡铸造武器‡',
    nil,
    'Leve o Caixote de Materiais para Bemarrin em Luaprata.‡Принесите ящик с материалами Бемаррину в Луносвет.‡Bringt die Kiste mit Rohmaterialien zu Bemarrin in Silbermond.‡‡Lleva el cajón de materiales a Bemarrin a Ciudad de Lunargenta.‡Lleva el cajón de materiales a Bemarrin a Ciudad de Lunargenta.‡Apportez la Caisse de matériaux à Bemarrin à Lune-d’Argent.‡将这箱材料交给银月城的波玛尔。‡',
  }
},
[9708] = {
  {
    'Fungos familiares‡Знакомые грибы‡Bekannter Pilz‡익숙한 버섯종‡Ese hongo me suena‡Ese hongo me suena‡Des champignons familiers‡熟悉的蘑菇‡熟悉的蘑菇',
    nil,
    'Colete 15 Amostras de Cogumelos e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 15 образцов грибов и принесите их наблюдательнице Лиса\'о на караульный пост Кенария в Зангартопи.‡Sammelt 15 Pilzproben und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버섯 견본 15개를 수집한 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recolecta 15 muestras de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Recolecta 15 muestras de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Collectez 15 Échantillons de champignon et apportez-les à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡将15份蘑菇样本交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集15個蘑菇樣本再回到贊格沼澤的塞納里奧看守站交給看守者里薩歐。',
  }
},
[9709] = {
  {
    'Ladrão que rouba ladrão...‡Ворованные грибы‡Die Pilze zurückstehlen‡버섯 도로 훔쳐오기‡Volver a robar los champiñones‡Volver a robar los champiñones‡Voler aux voleurs‡偷回蘑菇‡偷回蘑菇',
    nil,
    'Colete 10 Caixas de Cogumelos e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 10 ящиков грибов и вернитесь с ними к наблюдательнице Лиса\'о на караульный пост Кенария в Зангартопи.‡Sammelt 10 Kisten Pilze und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버섯 상자 10개를 모은 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recolecta 10 cajas de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Recolecta 10 cajas de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Récupérez 10 Boîtes de champignons et rapportez-les à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡将10箱蘑菇交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集10箱蘑菇再回到贊格沼澤的塞納里奧看守站交給看守者里薩歐。',
  }
},
[9710] = {
  {
    'O tridente temperado em sangue‡Закаленный кровью протазан‡Der blutgehärtete Ranseur‡‡La corcesca templada en sangre‡La corcesca templada en sangre‡La corsèque à la trempe de sang‡淬血长矛‡',
    nil,
    'Espere enquanto Bemarrin forja sua arma.‡Дождитесь, пока Бемаррин смастерит оружие.‡Wartet, während Bemarrin Eure Waffe schmiedet.‡‡Espera mientras Bemarrin forja tu arma.‡Espera mientras Bemarrin forja tu arma.‡Attendez pendant que Bemarrin forge votre arme.‡等待波玛尔为你锻造出你的武器。‡',
  }
},
[9711] = {
  {
    'Matis, o Cruel‡Матис Жестокий‡Matis der Grausame‡학살자 마티스‡Matis el Cruel‡Matis el Cruel‡Matis le Cruel‡残忍的玛提斯‡殘忍的馬帝斯',
    nil,
    'O Vindicante Kuros, do Entreposto Rubro, quer que você capture Matis, o Cruel.‡Воздаятель Курос с Кровавой заставы требует, чтобы Матис Жестокий был пойман.‡Verteidiger Kuros bei der Blutwacht möchte, dass Ihr Matis den Grausamen gefangen nehmt.‡핏빛 감시초소에 있는 구원자 쿠로스에게 학살자 마티스를 잡아 데려가야 합니다.‡El vindicador Kuros de Avanzada de Sangre quiere que captures a Matis el Cruel.‡El vindicador Kuros de Avanzada de Sangre quiere que captures a Matis el Cruel.‡Le redresseur de torts Kuros du Guet du sang veut que vous capturiez Matis le Cruel.‡秘血岗哨的守备官库卢斯要你俘获残忍的玛提斯。‡血色守望的復仇者庫羅斯要你抓到殘忍的馬帝斯。',
  }
},
[9712] = {
  {
    'O cavalo de guerra Thalassiano‡Талассийский боевой конь‡Das thalassische Schlachtross‡‡El caballo de guerra thalassiano‡‡Le cheval de guerre thalassien‡‡薩拉斯戰馬',
    nil,
    'Fale com o Grão-Cavaleiro Sangueroico para aprender como evocar seu Cavalo de Guerra Thalassiano.‡Поговорите с предводителем рыцарей Доблестной Кровью, чтобы научиться вызывать талассийского боевого коня.‡Sprecht mit Ritterfürst Heldenblut, um zu erfahren, wie Ihr Euer thalassisches Schlachtross beschwören könnt.‡‡Habla con el Lord caballero Sangrevalor para aprender a invocar a tu caballo de guerra thalassiano.‡Habla con el Lord caballero Sangrevalor para aprender a invocar a tu caballo de guerra thalassiano.‡Parlez au chevalier-seigneur Vaillessang pour apprendre comment invoquer votre cheval de guerre thalassien.‡‡和騎士領主伯洛德瓦勒談談，學習如何召喚你的薩拉斯戰馬。',
  }
},
[9713] = {
  {
    'Glowcap Harvesting Enabling Flag‡Включение возможности сбора огнешляпки‡Glowcap Harvesting Enabling Flag‡ 초롱버섯 수집‡Recogiendo fluochampiñones‡Recogiendo fluochampiñones‡Drapeau pour la récolte des chapeluisants‡Glowcap Harvesting Enabling Flag‡',
    nil,
    nil,
  }
},
[9714] = {
  {
    'Traga-me outro canteiro de arbusto!‡Принеси мне еще одну клумбу!‡Bringt mir ein weiteres Gebüsch!‡핏빛 불상화 추가 수집‡¡Tráeme otra mata!‡¡Tráeme otra mata!‡Rapportez-moi un autre jardinet !‡我还要红色木槿！‡再給我木槿花!',
    nil,
    '‡Кровавый гибискус, который можно найти у шаркунов, болотоходов и подболотных скатов в Нижетопи, в резервуаре Кривого Клыка, нам всегда пригодится. Приноси его мне связками по пять штук, я буду очень тебе благодарен!‡Wir können immer noch mehr Bluthibiskus von den Schlurfern, Sumpfriesen und Tiefenfledermäusen im Echsenkessel gebrauchen. Bringt sie mir in Bündeln zu je fünf, und ich werde Euch sehr dankbar sein.‡‡‡‡‡‡',
  }
},
[9715] = {
  {
    'Traga-me um canteiro de arbusto!‡Принеси мне клумбу!‡Bringt mir ein Gebüsch!‡핏빛 불상화‡¡Otra mata!‡¡Tráeme una mata!‡Rapportez-moi un jardinet !‡我要红色木槿！‡給我木槿花!',
    nil,
    'Colete 5 Hibiscos Sanguíneos e fale novamente com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Добудьте 5 растений кровавого гибискуса и отнесите их Гзхун\'тту в Спореггар в Зангартопи.‡Sammelt 5 Stück Bluthibiskus und bringt sie zu Gzhun\'tt in Sporeggar in den Zangarmarschen.‡핏빛 불상화 5개를 모은 후 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Recolecta 5 hibiscos sanguinos y llévaselos a Gzhun\'tt en Esporaggar en la Marisma de Zangar.‡Recolecta 5 hibiscos sanguinos y llévaselos a Gzhun\'tt en Esporaggar en la Marisma de Zangar.‡Récupérez 5 Hibiscus sanguins et rapportez-les à Gzhun’tt à Sporeggar dans le marécage de Zangar.‡将5朵红色木槿交给赞加沼泽孢子村的舒特。‡收集5朵血紅木槿再回到贊格沼澤的斯博格爾交給卡思汗特。',
  }
},
[9716] = {
  {
    'Transtorno no Lago Charco Sombrio‡Неприятности на озере Тенетопь‡Anomalie am Umbrafennsee‡그늘늪 호수의 장애‡Problemas en el Lago Umbropantano‡Problemas en el Lago Umbropantano‡Des ennuis au lac Umbretourbe‡暗泽湖的异常‡昂布拉凡湖的憂慮',
    nil,
    'Investigue a causa do esgotamento de água no Lago Charco Sombrio. Depois, fale novamente com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Выясните причину убывания воды в озере Тенетопь. Затем вернитесь к Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Untersucht den Grund für die sinkenden Wasserspiegel am Umbrafennsee. Kehrt dann zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡그늘늪 호수의 물이 고갈되고 있는 원인을 조사한 후, 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Investiga el origen de la pérdida de agua en Lago Umbropantano. Luego ve a ver a Ysiel Vientocantor al Refugio Cenarion, en la Marisma de Zangar.‡Investiga el origen de la pérdida de agua en Lago Umbropantano. Luego ve a ver a Ysiel Vientocantor al Refugio Cenarion, en la Marisma de Zangar.‡Déterminez la cause de la diminution de l\'eau au lac Umbretourbe. Puis retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡调查暗泽湖水位下降的原因，然后返回赞加沼泽的塞纳里奥避难所，向伊谢尔·风歌复命。‡調查昂布拉凡湖水量銳減的原因。再回到贊格沼澤的塞納里奧避難所找伊斯歐·風歌。',
  }
},
[9717] = {
  {
    'Então tá!‡Удачный ход‡Los geht\'s!‡지하포자 잎사귀 수집‡El esqueje‡El esqueje‡Oh, alors s’ils veulent la guerre…‡孢子叶‡喔，開始吧!',
    nil,
    'Pegue uma Fronde de Subesporo e leve para T\'shu em Sporeggar, que fica no Pântano Zíngaro.‡Добудьте ветку подспорника и вернитесь с ней к Т\'шу в Спореггар в Зангартопи.‡Besorgt einen Tiefensporenfarn und bringt ihn zu T\'shu in Sporeggar in den Zangarmarschen.‡지하포자 잎사귀를 모아서 장가르 습지대의 스포어가르에 있는 트슈에게 가져가야 합니다.‡Recolecta un esqueje de sotoespora y llévaselo a T\'shu a Esporaggar en la Marisma de Zangar.‡Recolecta un esqueje de sotoespora y llévaselo a T\'shu a Esporaggar en la Marisma de Zangar.‡Cueillez une Palme de sporielle et rapportez-la à T\'shu à Sporeggar dans le marécage de Zangar.‡将一片幽暗孢子叶交给赞加沼泽孢子村的塔苏。‡收集一片地孢之葉交給贊格沼澤的斯博格爾的塔蘇。',
  }
},
[9718] = {
  {
    'Quando o corvo voa‡С высоты птичьего полета‡Der Flug der Krähe‡일직선으로...‡A vuelo de pájaro‡A vuelo de pájaro‡À vol d\'oiseau‡乌鸦的飞翔‡烏鴉高飛時',
    nil,
    'Ysiel Cantavento quer que você use o Amuleto Corvo da Tormenta para explorar os grandes lagos no Pântano Zíngaro.‡Используйте амулет буревестника, чтобы исследовать основные озера Зангартопи по просьбе Исиэли Песни Ветра.‡Ysiel Windsänger möchte, dass Ihr das Sturmkrähenamulett benutzt, um die größeren Seen in den Zangarmarschen zu erkunden.‡이시엘 윈드싱어가 폭풍까마귀 아뮬렛을 사용하여 장가르 습지대의 주요 호수들을 확인해 달라고 부탁했습니다.‡Ysiel Vientocantor quiere que uses el amuleto de cuervo tormentoso para explorar los lagos principales de la Marisma de Zangar.‡Ysiel Vientocantor quiere que uses el amuleto de cuervo tormentoso para explorar los lagos principales de la Marisma de Zangar.‡Ysiel Chantelevent veut que vous vous serviez de l\'Amulette du corbeau des tempêtes pour explorer chacun des principaux lacs du Marécage de Zangar.‡伊谢尔·风歌要求你使用风暴乌鸦护符，然后调查赞加沼泽的主要湖泊。‡伊斯歐·風歌要你使用暴風烏鴉護符來探勘贊格沼澤的主要湖泊。',
  }
},
[9719] = {
  {
    'Espreite o espreitador‡Охота на Охотницу‡Tötet die Mutter‡검은 추적자 처치‡El acechador acechado‡El acechador acechado‡Traquer la traqueuse‡黑色阔步者‡追蹤獵捕者',
    nil,
    'Entregue o Cérebro da Espreitadora Negra para Khn\'nix em Sporeggar, que fica no Pântano Zíngaro.‡Принесите мозг Черной Охотницы Кхн\'иксу в Спореггар в Зангартопи.‡Bringt das Gehirn der Schattenmutter zu Khn\'nix in Sporeggar in den Zangarmarschen.‡장가르 습지대의 스포어가르에 있는 크닉스에게 검은 추적자의 머리를 가져가야 합니다.‡Lleva el cerebro de la acechadora negra a Khn\'nix en Esporaggar en la Marisma de Zangar.‡Lleva el cerebro de la Acechadora Negra a Khn\'nix en Esporaggar en la Marisma de Zangar.‡Apportez le Cerveau de la Traqueuse noire à Khn\'nix à Sporeggar dans le marécage de Zangar.‡将黑色阔步者的大脑交给赞加沼泽孢子村的肯尼克斯。‡把黑色捕獵者的大腦帶給贊格沼澤的斯博格爾的奇尼克斯。',
  }
},
[9720] = {
  {
    'É preciso preservar o equilíbrio‡Необходимо поддерживать равновесие!‡Das Gleichgewicht muss erhalten bleiben‡자연의 균형 수호‡Restaurar el equilibrio‡Restaurar el equilibrio‡L\'équilibre doit être préservé‡恢复平衡‡一定要保持平衡',
    nil,
    'Ysiel Cantavento quer que você use as Sementes de Vinaferro nos Controles da Bomba de Vapor no Lago Serpente, no Lago Charco Sombrio, no Lago Pantanoso e na Lagoa. Depois, fale novamente com ela no Refúgio Cenariano, no Pântano Zíngaro, e leve de volta quaisquer sementes que ainda estiverem com você.‡Осыпьте семенами железной лозы пульты управления паровым насосом в Змеином озере, озере Тенетопь, озере Болотных Огоньков и в Лагуне. Затем вернитесь к Исиэль Песни Ветра в Кенарийский приют в Зангартопи и отдайте ей оставшиеся семена.‡Ysiel Windsänger möchte, dass Ihr die Eisenrankensamenkörner benutzt, um die Dampfpumpensteuerungen am Schlangensee, Umbrafennsee, Sumpflichtsee und der Lagune zu zerstören. Kehrt danach mit den übrigen Samen zu ihr in die Zuflucht des Cenarius in den Zangarmarschen zurück.‡물갈퀴 호수, 그늘늪 호수, 수렁등불 호수, 바다자리 호수에 있는 증기 양수기 제어장치에 무쇠덩굴 씨앗을 사용한 후, 남은 씨앗을 가지고 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Ysiel Vientocantor quiere que utilices las semillas de Parraférrea en los controles de las bombas de vapor en el Lago Serpiente, el Lago Umbropantano, el Lago Luz Pantanosa y La Laguna. A continuación vuelve a verla al Refugio Cenarion en la Marisma de Zangar y llévale las sobras que tengas.‡Ysiel Vientocantor quiere que utilices las semillas de Parraférrea en los controles de las bombas de vapor en el Lago Serpiente, el Lago Umbropantano, el Lago Luz Pantanosa y La Laguna. A continuación vuelve a verla al Refugio Cenarion en la Marisma de Zangar y llévale las sobras que tengas.‡Ysiel Chantelevent veut que vous utilisiez les Graines de vignefer sur les Commandes de pompe à vapeur au Lac des serpents, au Lac Umbretourbe, au Lac des furoles et au Lagon. Retournez ensuite lui rendre les graines qu\'il vous reste au Refuge cénarien dans le marécage de Zangar.‡伊谢尔·风歌要你利用铁藤种子，破坏毒蛇湖、暗泽湖、沼光湖和环礁湖的蒸汽泵控制台，然后返回赞加沼泽的塞纳里奥庇护所，将剩余的铁藤种子还给她。‡伊斯歐·風歌要你在毒蛇之湖、昂布拉凡湖、沼澤光之湖和瀉湖的蒸汽泵使用鐵藤之種。再帶著未使用的種子回到贊格沼澤的塞納里奧避難所找她。',
  }
},
[9721] = {
  {
    'Convocação do Lorde Solanar‡Призыв леди Лиадрин‡Aufforderung von Lord Solanar‡‡Lord Solanar te convoca‡Lord Solanar te convoca‡Le seigneur Solanar vous réclame‡‡索拉納爾領主的召喚',
    nil,
    'Fale com o Lorde Solanar Furiassangue em Luaprata.‡Поговорите с Лордом Соланаром в Луносвете.‡Sprecht mit Lord Solanar Blutzorn in Silbermond.‡‡Habla con Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Habla con Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Parlez au seigneur Solanar Hargnessang à Lune-d’Argent.‡‡和銀月城的索拉納爾·血怒領主談談。',
  }
},
[9722] = {
  {
    'O caminho do mestre‡Путь мастера‡Der Pfad des Meisters‡‡El camino del maestro‡El camino del maestro‡La voie du maître‡‡',
    nil,
    'Fale novamente com o Lorde Solanar Furiassangue em Luaprata para aceitar a oferta de apoio dele.‡Поговорите с Лордом Соланаром еще раз и примите предложение о покровительстве.‡Sprecht nochmals mit Lord Solanar Blutzorn, um seine angebotene Unterstützung für Eure Aufnahme zu akzeptieren.‡‡Habla con Lord Solanar Sangre Colérica y acepta su ofrecimiento de patrocinio.‡Habla con Lord Solanar Sangre Colérica y acepta su ofrecimiento de patrocinio.‡Allez revoir le seigneur Solanar Hargnessang pour accepter son offre de parrainage.‡‡',
  }
},
[9723] = {
  {
    'Um gesto de comprometimento‡Жест преданности‡Eine Geste der Hingabe‡헌신의 몸짓‡Un gesto de entrega‡Un gesto de entrega‡Un geste d\'engagement‡血骑士的义务‡',
    nil,
    'Leve 40 Runatramas, 6 Barras de Arcanita, 10 Ervassóis, 5 Runas Negras e 150 de Ouro para o Lorde Solanar Furiassangue em Luaprata.‡Принесите лорду Соланару в Луносвет 40 отрезов рунической ткани, 6 арканитовых слитков, 10 солнечников, 5 темных рун и 150 золотых.‡Bringt 40 Einheiten Runenstoff, 6 Arkanitbarren, 10 Einheiten Sonnengras, 5 Dunkelrunen und 150 Goldstücke zu Lord Solanar Blutzorn in Silbermond.‡실버문에 있는 솔라나르 블러드레이스 경에게 룬무늬 옷감 40개, 아케이나이트 주괴 6개, 태양풀 10개, 암흑의 룬 5개, 그리고 150골드를 가져가야 합니다.‡Lleva 40 paños rúnicos, 6 barras de arcanita, 10 soleas, 5 runas oscuras y 150 piezas de oro a Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Lleva 40 paños rúnicos, 6 barras de arcanita, 10 soleas, 5 runas oscuras y 150 piezas de oro a Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Apporter 40 Etoffes runiques, 6 Barres d’arcanite, 10 Soleillettes, 5 Runes ténébreuses et 150 pièces d\'or au seigneur Solanar Hargnessang, à Lune-d’Argent.‡将40块符文布、6块奥金锭、10株太阳草、5个黑暗符文和150枚金币交给银月城的索拉纳·血怒。‡',
  }
},
[9724] = {
  {
    'Alerte o Círculo Cenariano‡Предупреждение Кругу Кенария‡Den Zirkel des Cenarius warnen‡세나리온 의회에 전하는 경고‡Aviso al Círculo Cenarion‡Advertir al Círculo Cenarion‡Prévenir le Cercle cénarien‡通知塞纳里奥议会‡警告塞納里奧議會',
    nil,
    'Fale com Amithiel Andanévoa no Posto Cenariano, na Península Fogo do Inferno.‡Поговорите с Амитиэль Странницей Туманов на Заставе Кенария на полуострове Адского Пламени.‡Sprecht mit Amythiel Nebelgänger beim Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 아미시엘 미스트워커와 대화해야 합니다.‡Habla con Amythel Caminaniebla en el Puesto Cenarion, en la Península del Fuego Infernal.‡Habla con Amythel Caminaniebla en el Puesto Cenarion, en la Península del Fuego Infernal.‡Parlez à Amythiel Marche-brume au Poste cénarien dans la péninsule des Flammes infernales.‡与地狱火半岛的塞纳里奥哨站中的阿米希尔·迷雾行者谈一谈。‡到地獄火半島和塞納里奧前哨的艾咪希·迷霧長者談談。',
  }
},
[9725] = {
  {
    'Demonstração de lealdade‡Доказательство лояльности‡Eine Demonstration Eurer Loyalität‡‡Una demostración de lealtad‡Una demostración de lealtad‡Une preuve de loyauté‡忠诚的表现‡',
    nil,
    'Lorde Solanar Furiassangue, de Luaprata, quer que você destrua 3 Carroças Carniceiras do Flagelo e mate 15 Engenheiros de Cerco do Flagelo.‡Лорд Соланар Кровогнев из Луносвета просит уничтожить 3 мясных фургона и убить 15 инженеров Плети.‡Lord Solanar Blutzorn in Silbermond möchte, dass Ihr 3 Fleischwagen der Geißel zerstört und 15 Belagerungsingenieure der Geißel tötet.‡‡Lord Solanar Sangre Colérica en la Ciudad de Lunargenta quiere que destruyas 3 carros de carne de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Lord Solanar Sangre Colérica en la Ciudad de Lunargenta quiere que destruyas 3 carros de despojos de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Le seigneur Solanar Hargnessang, à Lune-d’Argent, veut que vous détruisiez 3 Chariots à viande du Fléau et que vous tuiez 15 Ingénieurs de machines de siège du Fléau.‡银月城的索拉纳·血怒要求你摧毁3台天灾绞肉车，并杀死15名天灾攻城技师。‡',
  }
},
[9726] = {
  {
    'Agora que somos amigos...‡Теперь, когда мы друзья...‡Jetzt, da wir Freunde sind...‡우정의 확인‡Ahora que somos amigos...‡Ahora que somos amigos...‡Puisque nous sommes entre amis...‡既然我们是朋友......‡既然我們是朋友……',
    nil,
    'Mate 12 Feitores de Escravos Sangrescama e 6 Encantadoras Sangrescama. Em seguida, fale novamente com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Убейте 12 надсмотрщиков за рабами из клана Кровавой Чешуи, 6 чародеек из клана Кровавой Чешуи и возвращайтесь к Гзхун\'тту в Спореггар в Зангартопи.‡Tötet 12 Sklaventreiber der Blutschuppen und 6 Verzauberinnen der Blutschuppen und kehrt dann zu Gzhun\'tt in Sporeggar in den Zangarmarschen zurück.‡피비늘일족 노예감독 12마리, 피비늘일족 마법부여사 6마리를 처치한 후, 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Tuez 12 Esclavagistes écailles-sanglantes et 6 Enchanteresses écailles-sanglantes, puis retournez voir Gzhun\'tt à Sporeggar dans le marécage de Zangar.‡杀掉12个血鳞驱奴者和6个血鳞女巫，然后向赞加沼泽孢子村的舒特复命。‡殺死12個血鱗奴隸驅使者和6個血鱗女巫師，再回到贊格沼澤找斯博格爾的卡思汗特。',
  }
},
[9727] = {
  {
    'E como ainda somos amigos...‡Раз уж мы по-прежнему друзья...‡Jetzt, da wir immer noch Freunde sind...‡우정의 재확인‡Ahora que aún somos amigos...‡Ahora que aún somos amigos...‡Puisque nous sommes toujours entre amis...‡既然我们仍是朋友......‡既然我們還是朋友……',
    nil,
    'Mate 12 Feitores de Escravos Sangrescama e 6 Encantadoras Sangrescama. Em seguida, fale novamente com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Убейте 12 надсмотрщиков за рабами из клана Кровавой Чешуи, 6 чародеек из клана Кровавой Чешуи и возвращайтесь к Гзхун\'тту в Спореггар в Зангартопи.‡Tötet 12 Sklaventreiber der Blutschuppen und 6 Verzauberinnen der Blutschuppen und kehrt dann zu Gzhun\'tt in Sporeggar in den Zangarmarschen zurück.‡피비늘일족 노예감독 12마리, 피비늘일족 마법부여사 6마리를 처치한 후, 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Tuez 12 Esclavagistes écailles-sanglantes et 6 Enchanteresses écailles-sanglantes, puis retournez voir Gzhun\'tt à Sporeggar dans le marécage de Zangar.‡杀掉12个血鳞驱奴者和6个血鳞女巫，然后向赞加沼泽孢子村的舒特复命。‡殺死12個血鱗奴隸驅使者和6個血鱗女巫師，再回到贊格沼澤找斯博格爾的卡思汗特。',
  }
},
[9728] = {
  {
    'Calorosas boas-vindas‡Теплый прием‡Ein herzliches Willkommen‡격전의 증거‡Una cálida bienvenida‡Una cálida bienvenida‡Un accueil chaleureux‡热情的欢迎‡溫馨款待',
    nil,
    'O Guardião Hamoot, no Refúgio Cenariano, quer que você traga 30 Garras de Naga.‡Принесите стражу Хамуту из Кенарийского приюта 30 когтей наг.‡Bringt 30 Nagaklauen zu Aufseher Hamuht in der Zuflucht des Cenarius.‡세나리온 야영지에 있는 감시자 하무트가 나가 발톱 30개를 가져다 달라고 부탁했습니다.‡El celador Hamoot del Refugio Cenarion quiere que le lleves 30 garras de naga.‡El celador Hamoot del Refugio Cenarion quiere que le lleves 30 garras de naga.‡Le gardien Hamoot du Refuge cénarien veut que vous lui apportiez 30 Griffes de naga.‡将30个纳迦爪子交给塞纳里奥庇护所的监护者哈穆特。‡塞納里奧避難所的守望者漢姆特要你幫他帶來30個納迦之爪。',
  }
},
[9729] = {
  {
    'Fhwoor esmaga!‡Фхвур крушить!‡Fhwoor zerschmettern!‡프우르의 공격!‡¡Fhwoor da el golpe!‡¡Fhwoor da el golpe!‡Fhwoor écrabouiller !‡弗沃尔发怒了！‡',
    nil,
    'Escolte Fhwoor até a área da bomba de vapor pantanosa, para recuperar a Arca de Ssslith. Leve Fhwoor e a arca de volta a salvo e fale com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Проводите Фхвура к паровому насосу на озере Болотных Огоньков, чтобы добыть ковчег Ссслита. Потом доставьте обратно Фхвура и ковчег в целости и сохранности, и вернитесь к Гзхун\'тту в Спореггар в Зангартопи.‡Begleitet Fwoohr in das Gebiet bei der Dampfpumpe am Sumpflichtsee, um die Lade von Ssslith zu holen. Bringt Fhwoor und die Lade sicher zurück und meldet Euch bei Gzhun\'tt in Sporeggar in den Zangarmarschen.‡수렁등불 증기 양수기가 있는 지역까지 프우르를 호위하여 안전하게 쉬슬리스의 방주를 되찾은 후, 장가르 습지대의 스포어가르에 있는 그준트에게 보고해야 합니다.‡Escolta a Fhwoor hasta la zona de la bomba de vapor de la Luz Pantanosa para recuperar el Arca de Ssslith. Asegúrate de que Fhwoor y el arca vuelven sin peligro e informa a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Escolta a Fhwoor hasta la zona de la bomba de vapor de la Luz Pantanosa para recuperar el Arca de Ssslith. Asegúrate de que Fhwoor y el arca vuelven sin peligro e informa a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Escortez Fhwoor près de la pompe à vapeur des Furoles pour récupérer l’Arche de Ssslith. Ramenez Fhwoor avec l’arche jusqu’à un endroit sûr, puis allez faire votre rapport à Gzhun\'tt, à Sporeggar dans le marécage de Zangar.‡护送弗沃尔进入沼光湖水域，在蒸汽泵处找回萨斯里斯圣柜，保护弗沃尔携带圣柜安然返回，然后向赞加沼泽孢子村的舒特复命。‡',
  }
},
[9730] = {
  {
    'Líder dos Cristanegra‡Предводитель Темного Гребня‡Anführer der Dunkelkämme‡암흑갈기일족의 지도자‡El líder de los Cumbre Oscura‡El líder de los Cresta Oscura‡Le chef des Sombrecrêtes‡暗潮纳迦的首领‡暗羽領導者',
    nil,
    'Mate o Rajá Haghazed na Lagoa e fale novamente com o Guardião Hamoot na Expedição Cenariana, que fica no Pântano Zíngaro, para receber a sua recompensa.‡Убейте раджу Хагазеда в Лагуне и вернитесь к стражу Хамуту из Кенарийской экспедиции в Зангартопи, чтобы получить награду.‡Tötet Rajah Haghazed bei der Lagune und kehrt danach zu Aufseher Hamuht bei der Expedition des Cenarius in den Zangarmarschen zurück, um eine Belohnung zu erhalten.‡바다자리 호수에 있는 라자 해그헤이즈드를 처치한 후 장가르 습지대의 세나리온 원정대에 있는 감시자 하무트에게 돌아가서 보상을 받아야 합니다.‡Mata al rajá Brujobruma en La Laguna y regresa junto al celador Hamoot de la Expedición Cenarion, en la Marisma de Zangar, por tu recompensa.‡Mata al rajá Brujobruma en La Laguna y regresa junto al celador Hamoot del Refugio Cenarion, en la Marisma de Zangar, por tu recompensa.‡Tuez Rajah Haghazed au Lagon et retournez voir le gardien Hamoot de l\'Expédition cénarienne dans le marécage de Zangar pour chercher votre récompense.‡杀死环礁湖的哈格哈兹王子，然后返回赞加沼泽的塞纳里奥远征队，向监护者哈穆特领取奖赏。‡殺了瀉湖的洛迦海卡斯特並回到贊格沼澤的塞納里奧遠征隊向守望者漢姆特回報。',
  }
},
[9731] = {
  {
    'Diagrama dos esgotos‡Схема стоков‡Kanalisationspläne‡배수로 설계도‡Planos de conducto‡Planos de conducto‡Plan des canalisations‡抽水泵结构图‡排水結構圖',
    nil,
    'Procure sinais de um dreno no Lago Serpente. Informe suas descobertas a Ysiel Cantavento no Refúgio Cenariano.‡Найдите в Змеином озере признаки утечки воды. Вернитесь к Исиэль Песни Ветра в Кенарийском приюте и сообщите о своем открытии.‡Durchsucht den Grund des Schlangensees nach einem Ablauf. Kehrt mit Neuigkeiten über Eure Entdeckung zu Ysiel Windsänger in der Zuflucht des Cenarius zurück.‡물갈퀴 호수를 조사하여 배수로의 흔적을 찾은 후 발견한 내용을 세나리온 야영지에 있는 이시엘 윈드싱어에게 보고해야 합니다.‡Busca en el fondo del Lago Serpiente signos de un conducto. Regresa junto a Ysiel Vientocantor en el Refugio Cenarion con las noticias de lo que descubras.‡‡Explorez le Lac des Serpents à la recherche d\'un drain. Retournez voir Ysiel Chantelevent au Refuge cénarien pour présenter vos découvertes.‡前往毒蛇湖搜寻抽水泵的踪迹，然后向塞纳里奥庇护所的伊谢尔·风歌汇报你的发现。‡搜尋毒蛇之湖尋找排水管的徵兆。帶著你的發現回到塞納里奧避難所找伊斯歐·風歌。',
  }
},
[9732] = {
  {
    'Retorno ao pântano‡Назад в болото‡Rückkehr in die Marschen‡다시 습지대로‡Regreso a la marisma‡Regresa a la Marisma‡Retour au marécage‡返回沼泽‡回到沼澤',
    nil,
    'Fale novamente com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Вернитесь к Исиэль Песни Ветра в Кенарийском приюте в Зангартопи.‡Kehrt zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡返回赞加沼泽的塞纳里奥庇护所，向伊谢尔·风歌复命。‡回到贊格沼澤塞納里奧避難所的伊斯歐·風歌那裡。',
  }
},
[9733] = {
  {
    'Warning the Cenarion Circle‡Предупреждение Кругу Кенария‡Warnung an den Zirkel des Cenarius‡세나리온 의회에 전하는 경고‡Advertir al Círculo Cenarion‡Advertir al Círculo Cenarion‡Prévenir le Cercle cénarien‡通知塞纳里奥议会‡',
    nil,
    'Speak to Mahuram Stouthoof at Thrallmar in Hellfire Peninsula.‡Поговорите с Махурамом Крепким Копытом на Полуострове Адского Пламени, в Траллмаре.‡Sprecht mit Mahuram Starkhuf in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 마후람 스타우트후프와 대화하십시오.‡Habla con Mahuram Pezuñarrecia en Thrallmar, en la Península del Fuego Infernal.‡Habla con Mahuram Pezuña Recia en Thrallmar, en la Península del Fuego Infernal.‡Parlez à Mahuram Sabot-robuste à Thrallmar dans la péninsule des Flammes infernales.‡与地狱火半岛的萨尔玛城中的玛霍拉姆·硬蹄谈一谈。‡',
  }
},
[9734] = {
  {
    'Return to the Marsh‡Назад в болото‡Rückkehr in die Marschen‡다시 습지대로‡Retorno a la marisma‡Regresa a la Marisma‡Retour au marécage‡DEPRECATED‡回到沼澤',
    nil,
    'Return to Ysiel Windsinger at the Cenarion Refuge in Zangarmarsh.‡Вернитесь к Исиэль Песни Ветра в Кенарийском приюте в Зангартопи.‡Kehrt zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가십시오.‡Ve a ver a Ysiel Vientocantor al Refugio Cenarion en la Marisma de Zangar.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡返回向赞加沼泽塞纳里奥庇护所的Ysiel复命。‡回到贊格沼澤塞納里奧避難所的伊斯歐·風歌那裡。',
  }
},
[9735] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Lord Solanar Bloodwrath in Silvermoon City wants you to bring him a vial of Tyr\'s Hand Holy Water.‡Принесите фиал святой воды Длани Тира Лорду Соланару Кровогневу в Луносвет.‡Bringt Lord Solanar Blutzorn in Silbermond eine Phiole Weihwasser von Tyrs Hand.‡‡Lord Solanar Sangre Colérica, en la Ciudad de Lunargenta, quiere le lleves 1 vial de agua sagrada de la Mano de Tyr.‡Lord Solanar Sangre Colérica, en la Ciudad de Lunargenta, quiere le lleves 1 vial de agua sagrada de la Mano de Tyr.‡Le seigneur Solanar Hargnessang de Lune-d\'argent veut que vous lui apportiez une fiole d\'Eau bénite de la Main de Tyr.‡银月城的索拉纳·血怒要求你给他带回一瓶提尔之手圣水。‡',
  }
},
[9736] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Lord Solanar Bloodwrath in Silvermoon City wants you to bring him 1 Arcane Catalyst, 1 Crepuscular Powder, 1 Azerothian Diamond, and 1 Pristine Black Diamond.‡Принесите Лорду Соланару Кровогневу в Луносвет 1 чародейский катализатор, 1 меру сумеречного порошка, 1 азеротский алмаз и 1 безупречный черный алмаз.‡Bringt Lord Solanar Blutzorn in Silbermond 1 arkanen Katalysator, 1 Einheit krepuskulares Pulver, 1 azerothischen Diamanten und 1 makellosen schwarzen Diamanten.‡실버문에 있는 솔라나르 블러드레이스 경이 비전 촉매, 황혼의 가루, 아제로스 다이아몬드, 온전한 검은 다이아몬드를 하나씩 가져다 달라고 했습니다.‡Lord Solanar Sangre Colérica de Ciudad de Lunargenta quiere que le lleves 1 catalizador arcano, 1 partículas Crepusculares, 1 diamante de Azeroth y 1 diamante negro prístino.‡Lord Solanar Sangre Colérica de Ciudad de Lunargenta quiere que le lleves 1 catalizador arcano, 1 partículas Crepusculares, 1 diamante de Azeroth y 1 diamante negro prístino.‡Le seigneur Solanar Hargnessang de Lune-d’Argent veut que vous lui apportiez 1 Catalyseur arcanique, 1 Poudre crépusculaire, 1 Diamant d\'Azeroth et 1 Diamant noir parfait.‡银月城的索拉纳·血怒要求你给他带回一份奥术触媒、一份黄昏之尘、一颗艾泽拉斯钻石和一颗原始黑钻石。‡',
  }
},
[9737] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Use a Mistura Extintora perto da chama eterna na Capela Alonsus para remover a proteção da Luz. Prepare-se para enfrentar defensores da capela.‡Потушите неугасимое пламя часовни Алонсия с помощью огнетушительной смеси и уничтожьте всех, кто попробует защитить часовню.‡Verwendet die Löschmischung in der Nähe der ewigen Flamme in der Alonsuskapelle, um den Schutz des Lichts zu brechen. Seid bereit, jeden zu töten, der versucht, die Kapelle zu verteidigen.‡‡Utiliza la mezcla de extinción cerca de la llama eterna de la Capilla de Alonsus para eliminar la protección de la Luz. Prepárate para luchar contra cualquiera que pretenda defender la capilla.‡Utiliza la mezcla de extinción cerca de la llama eterna de la Capilla de Alonsus para eliminar la protección de la Luz. Prepárate para luchar contra cualquiera que pretenda defender la capilla.‡Utilisez la Mixture d\'extinction près de la flamme éternelle dans la chapelle d\'Alonsus pour ôter la protection de la Lumière. Vainquez quiconque tentera de défendre la chapelle.‡在阿隆索斯礼拜堂的永恒之焰上使用熄焰之水，除去圣光的保护，然后消灭所有试图保卫礼拜堂的人。‡',
  }
},
[9738] = {
  {
    'Perdidos em ação‡Пропавшие без вести‡Bei der Arbeit verschollen‡실종된 동료‡Desaparecidos en combate‡Desaparecidos en combate‡Disparus au combat‡失踪的同伴‡無法行動',
    nil,
    'Descubra o que aconteceu com o Ataterra Rayge, o Naturalista Mordida, o Mondadeiro Dedo Verde e o Arauto do Vento Garra. Em seguida, fale novamente com a Vigia Jhang no Reservatório Presacurva, que fica no Pântano Zíngaro.‡Выясните, что стало с заклинателем земли Гневвсом, натуралистом Кусом, культиватором Зеленопалом и призывателем ветров Когтем. Затем возвращайтесь к дозорному Джанг в резервуар Кривого Клыка в Зангартопь.‡Findet heraus, was mit Erdbinder Rayge, Naturalist Biss, Jäter Gründaum und Windrufer Klaue geschehen ist. Kehrt dann zu Behüterin Jhang im Echsenkessel in den Zangarmarschen zurück.‡대지의 결속자 레이지, 식물학자 바이트, 약초학자 그린썸, 바람소환사 클로에게 무슨 일이 생겼는지 알아본 후, 장가르 습지대의 갈퀴송곳니 저수지에 있는 감시자 쟝에게 돌아가야 합니다.‡Averigua qué le ha ocurrido al vinculador terrestre Rayge, al naturalista Mordisco, al desherbador Pulgarverde y al clamavientos Zarpa. Después, vuelve junto al vigía Jhang en la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Averigua qué le ha ocurrido al vinculador terrestre Rayge, al naturalista Mordisco, al desherbador Pulgarverde y al clamavientos Zarpa. Después, vuelve junto al vigía Jhang en la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Découvrez ce qui est arrivé au lieur de terre Rayge, au naturaliste Morsure, à l\'Échardonneur Vertemain et à l\'implorateur céleste Griffe. Retournez ensuite voir la guetteuse Jhang au réservoir de Glissecroc dans le marécage de Zangar.‡查明缚地者雷葛、博学者拜特、除草者格林萨姆和唤风者克劳恩的下落，然后返回赞加沼泽的盘牙水库，向观察者杰哈恩复命。‡調查大地束縛者瑞吉，自然學家拜特，威德·綠指和喚風者卡勞發生了什麼事。然後再回到贊格沼澤的盤牙蓄湖找看守者詹汗格。',
  }
},
[9739] = {
  {
    'A situação dos Sporeggar‡Проблемы спорлингов‡Die Misere der Sporlinge‡스포어링의 곤경‡La aflicción de los esporinos‡La aflicción de los esporinos‡Les malheurs des sporelins‡孢子人的困境‡孢子人的困境',
    nil,
    'Fahssn, no Vale dos Rebentos, quer que você colete 10 Esporângios Maduros.‡Соберите 10 мешочков зрелых спор по просьбе Фассна с Грибной поляны.‡Fahssn im Pilzgeflecht möchte, dass Ihr 10 reife Sporenbeutel sammelt.‡부화의 골짜기에 있는 파흐슨이 완전히 자란 포자 주머니 10개를 모아달라고 부탁했습니다.‡Fahssn, de La Cañada Emergente, quiere que reúnas 10 bolsas de esporas maduras.‡Fahssn, de La Cañada Emergente, quiere que reúnas 10 bolsas de esporas maduras.‡Fahssn au vallon des pontes veut que vous collectiez 10 Sacs de spores mûres.‡孢殖林的法恩森要你收集10个成熟的孢子囊。‡重生峽谷的法斯恩要你收集10個成熟的孢子囊。',
  }
},
[9740] = {
  {
    'O Portal Solar‡Солнечные Ворота‡Das Sonnentor‡태양의 문‡El portal solar‡El portal solar‡Le portail du soleil‡太阳之门‡太陽之門',
    nil,
    'O Vindicante Aesom, do Entreposto Rubro, quer que você destrua o Portal Solar.‡Воздаятель Эсом с Кровавой заставы хочет, чтобы солнечные врата были уничтожены.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr das Sonnentor zerstört.‡핏빛 전초기지에 있는 구원자 아에솜이 태양의 문을 파괴해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que destruyas el portal solar.‡El vindicador Aesom de la Avanzada de Sangre quiere que destruyas el portal solar.‡Le redresseur de torts Aesom du Guet du sang veut que vous détruisiez le Portail du soleil.‡秘血岗哨的守备官伊索姆要你摧毁太阳之门。‡血色守望的復仇者艾伊森要你摧毀太陽之門。',
  }
},
[9741] = {
  {
    'Criaturas do caos‡Твари из Бездны‡Geschöpfe aus der Leere‡공허의 피조물‡Alimañas del vacío‡Alimañas del vacío‡Les bestioles du vide‡虚空幼体‡虛無異常者',
    nil,
    'Mate 12 Bichos do Caos e apresente-se ao Vindicante Aesom no Entreposto Rubro.‡Убейте 12 тварей Бездны и сообщите об этом на Кровавую заставу воздаятелю Эсому.‡Tötet 12 Geschöpfe der Leere und erstattet Verteidiger Aesom bei der Blutwacht Bericht.‡공허의 피조물 12마리를 처치한 후 핏빛 감시초소에 있는 구원자 아에솜에게 보고해야 합니다.‡Mata 12 alimañas del vacío e informa luego al vindicador Aesom en la Avanzada de Sangre.|n‡Mata 12 alimañas del vacío e informa luego al vindicador Aesom en la Avanzada de Sangre.|n‡Tuez 12 Bestioles du Vide et faites votre rapport au redresseur de torts Aesom au Guet du sang.‡杀死12个虚空幼体，然后向秘血岗哨的守备官伊索姆复命。‡殺死12個虛無異常者再向血色守望的復仇者艾伊森回報。',
  }
},
[9742] = {
  {
    'Mais esporângios!‡Новые мешочки со спорами‡Noch ein paar Sporensäcke‡포자 주머니 추가 수집‡Más bolsas de esporas‡Más bolsas de esporas‡Encore des sacs de spores‡更多孢子囊‡更多孢子囊',
    nil,
    'Você resgatou mais esporângios, orc?‡Что, |3-6(дворф), тебе удалось спасти еще несколько мешочков со спорами?‡Habt Ihr noch mehr Sporensäcke gerettet, <Volk>?‡‡‡‡‡‡',
  }
},
[9743] = {
  {
    'Inimigos naturais‡Природные враги‡Natürliche Feinde‡자연의 적‡Enemigos naturales‡Enemigos naturales‡Ennemis par nature‡天敌‡自然天敵',
    nil,
    'Fahssn no Vale dos Rebentos, no Pântano Zíngaro, quer que você traga 6 Gavinhas de Senhor do Brejo.‡Принесите Фассну с Грибной поляны в Зангартопи 6 усиков болотника.‡Bringt 6 Sumpflordranken zu Fahssn im Pilzgeflecht in den Zangarmarschen.‡장가르 습지대의 부화의 골짜기에 있는 파흐슨이 수렁군주 덩굴손 6개를 가져다 달라고 부탁했습니다.‡Fahssn, de La Cañada Emergente en la Marisma de Zangar, quiere que le lleves 6 zarcillos de señor de la marisma.‡Fahssn, de La Cañada Emergente en la Marisma de Zangar, quiere que le lleves 6 zarcillos de señor de la marisma.‡Fahssn, du vallon des pontes du marécage de Zangar, veut que vous lui rameniez 6 Vrilles de seigneurs-tourbe.‡将6根沼泽领主的卷须交给赞加沼泽孢殖林的法恩森。‡贊格沼澤，重生峽谷的法斯恩要你幫他帶來6個泥沼領主藤鬚。',
  }
},
[9744] = {
  {
    'Mais gavinhas!‡Еще усиков!‡Mehr Ranken!‡덩굴손 추가 수집‡¡Más zarcillos!‡¡Más zarcillos!‡Plus de vrilles !‡更多卷须！‡更多藤鬚!',
    nil,
    '‡Тебе удалось перебить немало великанов, но немало их по-прежнему бродит по болотам. И они по-прежнему охотятся на наши мешочки со спорами!‡Ihr habt viele Riesen getötet, aber es sind immer noch viele übrig. Und sie greifen immer noch unsere Sporenbeutel an!‡‡‡‡Vous avez tué de nombreux géants, mais il en reste encore beaucoup. Et ils attaquent toujours nos sacs de spores !‡‡',
  }
},
[9746] = {
  {
    'No limite‡Границы возможного‡Grenze der Erschöpfung‡태양매 소탕‡Los límites del agotamiento‡Los límites del agotamiento‡Les limites de l\'épuisement physique‡精疲力尽‡體能極限',
    nil,
    'O Vindicante Aesom, no Entreposto Rubro, quer que você mate 10 Piromantes Falconélius e 10 Defensores Falconélius.‡Убейте 10 пиромантов и 10 защитников Солнечных Ястребов и сообщите об этом на Кровавую заставу воздаятелю Эсому.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr 10 Pyromanten der Sonnenfalken und 10 Verteidiger der Sonnenfalken tötet.‡핏빛 전초기지에 있는 구원자 아에솜이 태양매 화염술사, 태양매 파수병을 각각 10명씩 처치해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que mates a 10 pirománticos de los halcones del Sol y a 10 defensores de los halcones del Sol.|n‡El vindicador Aesom de la Avanzada de Sangre quiere que mates a 10 pirománticos de los Halcones del Sol y a 10 defensores de los Halcones del Sol.|n‡Le redresseur de torts Aesom au Guet du sang veut que vous tuiez 10 Pyromanciens Epervier du soleil et 10 Défenseurs Epervier du soleil.‡杀死10个炎鹰火法师和10个炎鹰防御者，然后向秘血岗哨的守备官伊索姆复命。‡血色守望的復仇者艾伊森要你殺死10個太陽之鷹控火者和10個太陽之鷹防衛者。',
  }
},
[9747] = {
  {
    'A tribo do Charco Sombrio‡Племя Тенетопи‡Der Umbrafennstamm‡그늘늪일족‡La tribu Umbropantano‡La tribu Umbropantano‡La tribu Umbretourbe‡暗泽部族‡昂布拉凡部族',
    nil,
    'Ikeyen, no Refúgio Cenariano, quer que você vá até a Aldeia do Charco Sombrio e mate Kataru, 8 Videntes do Charco Sombrio, 6 Mandingueiros do Charco Sombrio e 6 Oráculos do Charco Sombrio.‡Отправляйтесь в деревню Тенетопь и убейте Катару, 8 провидцев, 6 знахарей и 6 оракулов из племени Тенетопи по просьбе Икейена из Кенарийского приюта.‡Ikeyen in der Zuflucht des Cenarius möchte, dass Ihr nach Umbrafenn reist und Kataru, 8 Seher von Umbrafenn, 6 Hexendoktoren von Umbrafenn und 6 Orakel von Umbrafenn tötet.‡세나리온 야영지에 있는 이케옌이 그늘늪 마을로 가서 카타루, 그늘늪일족 점쟁이 8명, 그늘늪일족 예언자 6명, 그늘늪일족 의술사 6명을 처치해 달라고 부탁했습니다.‡Ikeyen del Refugio Cenarion quiere que vayas a la Aldea Umbropantano y mates a Kataru, 8 videntes de Umbropantano, 6 médicos brujos de Umbropantano y 6 oráculos de Umbropantano.‡Ikeyen del Refugio Cenarion quiere que vayas a la Aldea Umbropantano y mates a Kataru, 8 videntes de Umbropantano, 6 médicos brujos de Umbropantano y 6 oráculos de Umbropantano.‡Ikeyen du Refuge cénarien veut que vous vous rendiez au village Umbretourbe pour y tuer Kataru, 8 Prophètes d\'Umbretourbe, 6 Sorciers-docteurs d\'Umbretourbe et 6 Oracles d\'Umbretourbe.‡塞纳里奥庇护所的伊卡因希望你前往暗泽村，杀死卡塔鲁、8个暗泽先知、6个暗泽巫医和6个暗泽神谕者。‡塞納里奧避難所的伊奇言要你前往昂布拉凡村殺死卡塔魯，8個昂布拉凡先知，6個昂布拉凡巫醫和6個昂布拉凡神諭者。',
  }
},
[9748] = {
  {
    'Água que passarinho não bebe‡Не пей эту воду!‡Trinkt nicht das Wasser‡마실 수 없는 물‡Agua que no has de beber...‡Agua que no has de beber...‡Ne buvez pas l\'eau‡毒水‡別喝那裡的水',
    nil,
    'O Vindicante Aesom, do Entreposto Rubro, quer que você use o Frasco para Amostra de Água para pegar uma Amostra de Água de Névoa Rubra.‡Воздаятель Эсом на Кровавой заставе попросил вас принести пробу воды с острова Кровавой Дымки во флаконе, который он предоставил.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr den Wasserprobenbehälter verwendet, um eine Wasserprobe der Blutmythosinsel zu entnehmen.‡핏빛 감시초소에 있는 구원자 아에솜이 견본 물병을 사용하여 핏빛안개 물 견본을 채집해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que uses el frasco para recoger una muestra de agua de Bruma de Sangre.‡El vindicador Aesom de la Avanzada de Sangre quiere que uses el frasco para recoger una muestra de agua de Bruma de Sangre.‡Le redresseur de torts Aesom au Guet du sang veut que vous utilisiez le Flacon d\'échantillon d\'eau pour obtenir un Échantillon d\'eau de Brume-sang.‡用水样瓶取回一份秘血岛水样，然后向秘血岗哨的守备官伊索姆复命。‡血色守望的復仇者艾伊森要你使用水樣本瓶取得血謎水樣本。',
  }
},
[9749] = {
  {
    'They\'re Alive! Maybe...‡Они живы! Может быть...‡Sie leben! Vielleicht...‡‡¡Viven! A lo mejor...‡‡Ils sont vivants ! Peut-être...‡‡',
    nil,
    'Researcher Cornelius has asked that you free 5 Expedition Researchers.‡Освободите 5 ученых экспедиции по просьбе ученого Корнелиуса.‡Forscher Cornelius hat Euch darum gebeten, 5 Expeditionsforscher zu befreien.‡연구원 코르넬리우스가 원정대 연구원 5명을 구해 달라고 했습니다.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡Le Chercheur Cornelius a demandé que vous libériez 5 Chercheurs de l\'expédition.‡研究员考内留斯要你救出5个远征队研究员。‡',
  }
},
[9750] = {
  {
    'UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery',
    nil,
    nil,
  }
},
[9751] = {
  {
    'O Almirante Negro‡Наследие Проклятой Крови‡Das Vermächtnis des Blutfluchs‡핏빛저주의 유산‡El legado de la Sangre Maldita‡El legado de la Sangre Maldita‡L\'héritage du sang maudit‡血咒的遗产‡血咒遺產',
    nil,
    'O Almirante Odisseu pediu para você encontrar e falar com o Capitão Cândido João.‡Адмирал Одиссий просит разыскать капитана Эдварда Хейнса и поговорить с ним.‡Admiral Odesyus hat Euch gebeten, nach Kapitän Edward Hanes zu suchen und mit ihm zu sprechen.‡제독 오디시우스가 선장 에드워드 헤인즈를 찾아서 대화해 보라고 부탁했습니다.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡L’amiral Odesyus vous a demandé de trouver le Capitaine Edward Hanes et de lui parler.‡海军上将奥德修斯要你找到艾德华·汉斯船长，然后与他谈一谈。‡艦隊司令·奧迪席斯要你去找隊長艾德華·漢尼斯並和他談談。',
  }
},
[9752] = {
  {
    'Fuga do Charco Sombrio‡Спасение с озера Тенетопь‡Flucht aus Umbrafenn‡그늘늪 탈출‡Evasión de Umbropantano‡Evasión de Umbropantano‡L\'évadée d\'Umbretourbe‡逃离暗泽村‡逃離昂布拉凡',
    nil,
    'Escolte Kayra Jubalonga até Refúgio Cenariano, no Pântano Zíngaro. Apresente-se a Ysiel Cantavento quando completar essa tarefa.‡Проводите Кайру Длинную Гриву в Кенарийский приют в Зангартопи. Выполнив эту задачу, поговорите с Исиэль Песнью Ветра.‡Begleitet Kayra Langmähne zur Zuflucht des Cenarius in den Zangarmarschen. Gebt Ysiel Windsänger Bescheid, sobald Ihr diese Aufgabe erledigt habt.‡카이라 롱메인을 호위해서 장가르 습지대에 있는 세나리온 야영지까지 간 후 이시엘 윈드싱어에게 보고해야 합니다.‡Acompaña a Kayra Melenalarga al Refugio Cenarion en la Marisma de Zangar. Después ve a ver a Ysiel Vientocantor.‡Acompaña a Kayra Crin Larga al Refugio Cenarion en la Marisma de Zangar. Después ve a ver a Ysiel Vientocantor.‡Escortez Kayra Long-crin jusqu\'au Refuge cénarien dans le marécage de Zangar. Présentez-vous à Ysiel Chantelevent lorsque vous aurez accompli cette tâche.‡护送凯拉·长鬃返回赞加沼泽的塞纳里奥庇护所，然后向伊谢尔·风歌复命。‡護送凱拉·長鬃回到贊格沼澤的塞納里奧避難所。完成任務後向伊斯歐·風歌回報。',
  }
},
[9753] = {
  {
    'O que sabemos...‡То, что мы знаем...‡Was wir wissen...‡알아낸 정보‡Saber es poder‡Saber es poder‡Ce que nous savons...‡我们所知道的......‡我們所知道的事……',
    nil,
    'Fale com o Exarca Admetius no Entreposto Rubro.‡Поговорите с экзархом Адметиусом на Кровавой заставе.‡Sprecht mit Exarch Admetius bei der Blutwacht.‡핏빛 감시초소에 있는 총독 애드미티우스와 대화해야 합니다.‡Habla con el exarca Admetius en Avanzada de Sangre.‡Habla con el exarca Admetius en Avanzada de Sangre.‡Parlez à l\'exarque Admetius au Guet du sang.‡与秘血岗哨的主教埃德门图斯谈一谈。‡和血色守望的主教阿德密特斯談談。',
  }
},
[9756] = {
  {
    'O que não sabemos...‡То, чего мы не знаем...‡Was wir nicht wissen...‡알아야 할 정보‡Lo que no sabemos‡Lo que no sabemos‡Ce que nous ne savons pas…‡我们不知道的......‡我們不知道的事……',
    nil,
    'Fale com o Agente Falconélius Capturado no Entreposto Rubro e obtenha as Informações sobre os Falconélius. Fale novamente com o Exarca Admetius quando completar a missão.‡Поговорите с пленным агентом Солнечных Ястребов, которого держат на Кровавой заставе. Передайте полученные сведения экзарху Адметиусу.‡Sprecht mit einem gefangenen Agenten der Sonnenfalken bei der Blutwacht und eignet Euch Informationen der Sonnenfalken an. Kehrt zu Exarch Admetius zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡핏빛 감시초소에 있는 사로잡힌 태양매 첩보원과 대화하여 태양매에 대한 정보를 알아낸 후 총독 애드미티우스에게 돌아가야 합니다.‡Habla con un agente Halcón del Sol capturado en Avanzada de Sangre y consigue información. Luego ve a ver al exarca Admetius.‡Habla con un agente Halcón del Sol capturado en Avanzada de Sangre y consigue información. Luego ve a ver al exarca Admetius.‡Parlez à un agent Epervier du soleil capturé au Guet du sang et obtenez des informations secrètes des Eperviers du soleil. Retournez auprès de l\'exarque Admetius quand vous aurez terminé cette tâche.‡与秘血岗哨的被抓住的炎鹰间谍交谈，了解炎鹰的相关信息。完成任务后向主教埃德门图斯复命。‡和血色守望被俘虜的太陽之鷹密探談談並取得太陽之鷹情報。完成任務後回報主教阿德密特斯。',
  }
},
[9757] = {
  {
    'Encontre a Caçadora Kella Arconyx‡Охотница Келла Тетива Ночи‡Sucht Jägerin Kella Nachtbogen auf‡여사냥꾼과의 대화하기‡La cazadora Kella Arconocturno‡La cazadora Kella Arconocturno‡Aller trouver la chasseresse Kella Arquenuit‡寻找女猎手凯拉·夜弓‡尋找女獵人凱拉·夜弓',
    nil,
    'Fale com a Caçadora Kella Arconyx perto do Atracadouro de Valaar.‡Поговорите с охотницей Келлой Тетивой Ночи рядом с причалом Валаара.‡Sprecht mit Jägerin Kella Nachtbogen nahe Valaars Steg.‡발라르의 나루 근처에 있는 여사냥꾼 켈라 나이트보우와 대화해야 합니다.‡Habla con la cazadora Kella Arconocturno cerca del Atracadero de Valaar.‡Habla con la cazadora Kella Arconocturno cerca del Atracadero de Valaar.‡Parlez à la chasseresse Kella Arquenuit près de l\'Amarrage de Valaar.‡与瓦拉尔港口附近的女猎手凯拉·夜弓谈一谈。‡和瓦拉船台附近的女獵人凱拉·夜弓談談。',
  }
},
[9758] = {
  {
    'Fale com o arcanista Vandril‡Возвращение к чародею Вандрилу‡Rückkehr zu Arkanist Vandril‡비전술사 반드릴에게 돌아가기‡Regreso junto al arcanista Vandril‡Regresa junto al arcanista Vandril‡Retourner voir l\'arcaniste Vandril‡返回奥术师范迪瑞尔身边‡回到秘法師范德隆那裡',
    nil,
    'Fale novamente com o Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Возвращайтесь к чародею Вандрилу в Транкивиллион, что в Призрачных землях.‡Kehrt zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡유령의 땅, 트랜퀼리엔에 있는 비전술사 반드릴에게 돌아가십시오.‡Llévaselos al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Preséntate ante el arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Retournez voir l\'arcaniste Vandril à Tranquillien dans les Terres fantômes.‡返回幽魂之地的塔奎林，与奥术师范迪瑞尔谈一谈。‡回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9759] = {
  {
    'A missão suicida‡Отречемся от старого мира‡Ihre Welt enden lassen‡사선으로...‡El fin de su mundo‡El fin de su mundo‡La fin de leur monde‡终结他们的世界‡結束他們的世界',
    nil,
    'Siga e proteja o Demolidor Legoso enquanto ele tenta destruir a Espiral Vetorial e mate Sironas. Fale novamente com o Exarca Admetius no Entreposto Rubro após cumprir a missão.‡Подрывник Легосо собирается разрушить энергоблок и убить Сиронас. Попытайтесь защитить его и, если задание будет успешно выполнено, расскажите об этом экзарху Адметиусу на Кровавой заставе.‡Folgt und beschützt Demolierer Legoso, während er versucht, die Vektorspule zu zerstören und tötet Sironas. Kehrt zu Exarch Admetius bei der Blutwacht zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡폭파병 레고소가 벡터 코일을 파괴하고 시로나스를 해치우는 동안 그를 따라가서 보호하여 임무를 수행한 후, 핏빛 감시초소에 있는 총독 애드미티우스에게 돌아가야 합니다.‡Sigue y protege al demoledor Legoso mientras intenta destruir La Espiral Vectorial y matar a Sironas. Ve a ver al exarca Admetius en la Avanzada de Sangre si completas la misión.‡Sigue y protege al demoledor Legoso mientras intenta destruir La Espiral Vectorial y matar a Sironas. Ve a ver al exarca Admetius en la Avanzada de Sangre si completas la misión.‡Suivez et protégez le démolisseur Legoso pendant qu\'il essaye de détruire la Bobine vectorielle et tuer Sironas. Retournez voir l\'exarque Admetius au Guet du sang si vous réussissez cette mission.‡在爆破专家莱戈苏尝试摧毁矢量感应器的过程中保护他，并杀死希隆娜丝。完成任务后向秘血岗哨的主教埃德门图斯复命。‡在破壞者勒茍索嘗試摧毀旋繞導航器並殺死賽羅娜斯時跟著他並保護他。完成任務後回到血色守望的主教阿德密特斯那裡。',
  }
},
[9760] = {
  {
    'O Recanto do Vindicante‡Привал Защитника‡Verteidigers Ruh\'‡구원자의 안식처‡El Reposo del Vindicador‡El Reposo del Vindicador‡Le Repos du redresseur de torts‡守备官营地‡復仇者之陵',
    nil,
    'Fale com a Vindicante Corin no Recanto do Vindicante, que fica na Ilha Névoa Rubra.‡Поговорите с воздаятельницей Корин в селении Привал Защитника на острове Кровавой Дымки;.‡Sprecht mit Verteidigerin Corin bei Verteidigers Ruh\' auf der Blutmythosinsel.‡핏빛안개 섬의 구원자의 안식처에 있는 구원자 코린과 대화해야 합니다.‡Habla con el vindicador Corin en El Reposo del Vindicador en Isla Bruma de Sangre.|n‡Habla con la vindicadora Corin en El Reposo del Vindicador en Isla Bruma de Sangre.|n‡Parlez au redresseur de torts Corin au Repos du redresseur de torts sur l\'île de Brume-Sang.‡与秘血岛守备官营地的守备官考尔琳谈一谈。‡到血謎島和復仇者之陵的復仇者科林談談。',
  }
},
[9761] = {
  {
    'Abrindo caminho‡Расчистка пути‡Den Weg frei machen‡장애물 제거‡Despejando el camino‡Despejando el camino‡Ouvrir la voie‡清除路障‡清除道路',
    nil,
    'A Vindicante Corin, do Recanto do Vindicante, quer que você mate 8 Sabotadores Falconélius e 8 Agentes Falconélius.‡Убейте 8 саботажников и 8 посланников из клана Солнечных Ястребов и сообщите об этом воздаятельнице Корин в Привале Защитника.‡Verteidigerin Corin bei Verteidigers Ruh\' möchte, dass Ihr 8 Saboteure der Sonnenfalken und 8 Agenten der Sonnenfalken tötet.‡구원자의 안식처에 있는 구원자 코린이 태양매 정찰병, 태양매 첩보원을 각각 8명씩 처치해 달라고 부탁했습니다.‡El vindicador Corin de El Reposo del Vindicador quiere que mates a 8 saboteadores y 8 agentes Halcón del Sol.|n‡La vindicadora Corin de El Reposo del Vindicador quiere que mates a 8 saboteadores y 8 agentes Halcón del Sol.|n‡Le redresseur de torts Corin au Repos du redresseur de torts veut que vous tuiez 8 Saboteurs Epervier du soleil et 8 Agents Epervier du soleil.‡杀死8个炎鹰破坏者和8个炎鹰侦察兵，然后向守备官营地的守备官考尔琳复命。‡復仇者之陵的復仇者科林要你殺死8個太陽之鷹破壞者和8個太陽之鷹密探。',
  }
},
[9762] = {
  {
    'A profecia não escrita‡Неписаное пророчество‡Die ungeschriebene Prophezeiung‡두 가지 선물‡La profecía no escrita‡La profecía no escrita‡Une prophétie à écrire‡未知的命运‡未寫下的預言',
    nil,
    '‡‡Diese Inseln werden für Tausende ein Zuhause sein. Die meisten werden ihr gesamtes Leben hier verbringen. Ihr könntet das auch, aber es ist nicht, was Ihr wollt, oder <Name>?nnnnIhr werdet in Eurem Leben noch viele großartige Taten vollbringen. Ihr müsst Euer Schicksal umarmen und es willkommen heißen!nnBevor Ihr geht, möchte ich Euch noch zwei Geschenke überreichen: Dieser Wappenrock wird nur von denen getragen, die den höchsten Respekt der Hand von Argus genießen; und nur die Weisesten besitzen diesen Siegelring. Tragt beides mit Stolz, <Name>.‡‡‡‡‡‡',
  }
},
[9763] = {
  {
    'O esconderijo do senhor da guerra‡Убежище врага‡Das Versteck des Kriegsherren‡장군의 은신처‡La guarida del Señor de la Guerra‡La guarida del Señor de la Guerra‡Le repaire du seigneur de guerre‡督军的末日‡督軍的藏身之處',
    nil,
    'A Vigia Jhang quer que você encontre e mate o Senhor da Guerra Kalithresh no Reservatório Presacurva.‡Дозорный Джанг хочет, чтобы вы нашли и убили полководца Калитреша в резервуаре Кривого Клыка.‡Behüterin Jhang möchte, dass Ihr Kriegsherr Kalithresh im Echsenkessel findet und tötet.‡감시자 쟝이 갈퀴송곳니 저수지 안에 있는 장군 칼리스레쉬를 찾아서 처치해 달라고 부탁했습니다.‡El vigía Jhang quiere que encuentres y mates al Señor de la Guerra Kalithresh dentro de la Reserva Colmillo Torcido.‡La vigía Jhang quiere que encuentres y mates al señor de la guerra Kalithresh dentro de la Reserva Colmillo Torcido.‡La guetteuse Jhang veut que vous trouviez et exécutiez le seigneur de guerre Kalithresh à l\'intérieur du réservoir de Glissecroc.‡观察者杰哈恩要求你找到并杀死盘牙水库的督军卡利瑟里斯。‡看守者詹汗格要你找到並殺死盤牙蓄湖裡的督軍卡利斯瑞。',
  }
},
[9764] = {
  {
    'Ordens da Lady Vashj‡Приказы Леди Вайш‡Befehle von Lady Vashj‡여군주 바쉬의 명령서‡Órdenes de Lady Vashj‡Órdenes de Lady Vashj‡Les ordres de dame Vashj‡瓦丝琪的命令‡瓦許女士的命令',
    nil,
    'Entregue as ordens da Lady Vashj a Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Отнесите приказы леди Вайш Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Bringt die Befehle von Lady Vashj zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 여군주 바쉬의 명령서를 전달해야 합니다.‡Entrega las órdenes de Lady Vashj a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Entrega las órdenes de Lady Vashj a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Apportez les Ordres de dame Vashj à Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡将瓦丝琪女王的命令交给赞加沼泽塞纳里奥庇护所的伊谢尔·风歌。‡將瓦許女士的命令帶到贊格沼澤給塞納里奧避難所的伊斯歐·風歌。',
  }
},
[9765] = {
  {
    'Preparativos de guerra‡Готовится к войне‡Kriegsvorbereitungen‡전쟁 준비‡Preparativos de guerra‡Preparativos de guerra‡Les préparatifs de guerre‡战争准备‡準備作戰',
    nil,
    'Consiga Armamento Presacurva das nagas, no Reservatório Presacurva, e leve-o para Ysiel Cantavento no Refúgio Cenariano, que fica no Pântano Zíngaro.‡Добудьте оружие клана Кривого Клыка у наг в резервуаре Кривого Клыка и принесите его Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Besorgt die Waffen des Echsenkessels von den Naga im Echsenkessel und kehrt dann zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡갈퀴송곳니 저수지의 나가에게서 갈퀴송곳니 무기를 획득한 후 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 가져가야 합니다.‡Consigue armamentos Colmillo Torcido de los nagas en la Reserva Colmillo Torcido y llévaselos a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Consigue armamentos Colmillo Torcido de los nagas en la Reserva Colmillo Torcido y llévaselos a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Procurez-vous des Armes de Glissecroc sur les nagas du réservoir de Glissecroc et apportez-les à Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡从盘牙水库的纳迦手中夺得盘牙武器，将它们交给赞加沼泽塞纳里奥庇护所的伊谢尔·风歌。‡從盤牙蓄湖的納迦身上取得盤牙裝備並將它們帶回贊格沼澤給塞納里奧避難所的伊斯歐·風歌。',
  }
},
[9766] = {
  {
    'Armamento presacurva‡Оружие Кривого Клыка‡Waffen des Echsenkessels‡갈퀴송곳니 무기‡Armamentos de Colmillo Torcido‡Armamentos de Colmillo Torcido‡Les armes de Glissecroc‡盘牙武器‡盤牙裝備',
    nil,
    '‡Мы выкуем из стали наг оружие, и обратим его против них! Принеси мне все оружие, которое сможешь унести из резервуара Кривого Клыка.‡Wir werden den eigenen Stahl der Naga in Waffen gegen sie umschmieden. Bringt mir alle Waffen, die Ihr aus dem Echsenkessel besorgen könnt.‡‡‡‡‡‡',
  }
},
[9767] = {
  {
    'Know Your Enemy‡Врага нужно знать в лицо‡Den Feind kennen‡적에 대한 정보‡Conoce a tu enemigo‡‡Connais ton adversaire‡DEPRECATED‡了解你的敵人',
    nil,
    'Obtain a Coilfang Spellbook from the naga inside of Coilfang Reservoir and bring it to Ashyen at the Cenarion Refuge in Zangarmarsh.‡Добудьте книгу заклинаний клана Кривого Клыка у наг из резервуара Кривого Клыка и принесите ее Ашьену в Кенарийский приют в Зангартопи.‡Besorgt ein Zauberbuch des Echsenkessels von den Naga im Echsenkessel und bringt es zu Ashyen in der Zuflucht des Cenarius in den Zangarmarschen.‡갈퀴송곳니 저수지 안에 있는 나가로부터 갈퀴송곳니 마법책을 얻은 후 장가르 습지대의 세나리온 야영지에 있는 아쉬옌에게 가져가야 합니다.‡Consigue un libro de hechizos Colmillo Torcido de los nagas de la Reserva Colmillo Torcido y llévaselo a Ashyen en el Refugio Cenarion en la Marisma de Zangar.‡Consigue un libro de hechizos Colmillo Torcido de los nagas de la Reserva Colmillo Torcido y llévaselo a Ashyen en el Refugio Cenarion en la Marisma de Zangar.‡Procurez-vous un Grimoire de Glissecroc sur les nagas du réservoir de Glissecroc et apportez-le à Ashyen au Refuge cénarien dans le marécage de Zangar.‡从盘牙水库内的纳迦身上获得一本Coilfang Spellbook，将其带给赞加沼泽内塞纳里奥庇护所的Ashyen。‡從盤牙蓄湖的納迦身上取得盤牙法術書並將它帶到贊格沼澤給塞納里奧避難所的艾斯炎。',
  }
},
[9769] = {
  {
    'Que roupinha mucho louca‡Мода непредсказуема!‡Mode kann man nicht erklären‡패션을 위해서라면‡Antes muertos que sencillos‡Antes muertos que sencillos‡La mode, ça ne s\'explique pas‡时尚无罪‡流行沒有理由',
    nil,
    'Traga 8 Asas Diáfanas de qualquer espécie de vaga-lume do Pântano Zíngaro para Magasha, no Mocó do Rato Lamacento.‡Принесите 8 прозрачных крыльев любых видов светлячков, обитающих в Зангартопи, Магаше с заставы Болотной Крысы.‡Bringt 8 lichtdurchlässige Flügel von einer beliebigen Glühwürmchenart der Zangarmarschen zu Magasha im Sumpfrattenposten.‡늪쥐 감시초소에 있는 마가샤에게 장가르 습지대에 서식하는 반딧불이종 곤충을 처치하고 얻은 투명한 날개 8개를 가져가야 합니다.‡Lleva ocho alas diáfanas de cualquier especie de aguijonero de la Marisma de Zangar a Magasha, en la Avanzada Rata del Pantano.‡Lleva ocho alas diáfanas de cualquier especie de aguijonero de la Marisma de Zangar a Magasha, en la Avanzada Rata del Pantano.‡Apportez 8 Ailes diaphanes de n\'importe quelles lucioles du marécage de Zangar à Magasha au poste du Rat des marais.‡猎杀赞加沼泽的萤火虫，将8片透明的虫翼交给沼泽鼠岗哨的玛加沙。‡從螢光蛾身上弄到8個透明之翼給斯溫派特崗哨的瑪卡莎。',
  }
},
[9770] = {
  {
    'Ameaça presamangue‡Опасные болотные клыки‡Bedrohliche Marschenfänge‡늪송곳니 가오리의 위협‡Marismas amenazadoras‡La amenaza de los Colmillo de la Marisma‡Les crocs-du-marais menaçants‡沼牙的威胁‡險惡的沼牙',
    nil,
    'Reavij, no Mocó do Rato Lamacento, quer que você mate 10 Estripadores Presamangue‡Убейте 10 болотных потрошителей по просьбе Реавижа с заставы Болотной Крысы.‡Reavij im Sumpfrattenposten möchte, dass Ihr 10 Marschfangreißer tötet.‡늪쥐 감시초소에 있는 레아비즈가 톱니 늪송곳니 가오리 10마리를 해치워 달라고 부탁했습니다.‡Reavij de la Avanzada Rata del Pantano quiere que mates a 10 destripadores Colmillo de la marisma.‡Reavij de la Avanzada Rata del Pantano quiere que mates a 10 destripadores Colmillo de la Marisma.‡Reavij du Poste du rat des marais veut que vous alliez tuer 10 Eventreurs Croc-du-marais.‡沼泽鼠岗哨的里维伊要你去杀死10只沼牙撕裂者。‡斯溫派特崗哨的瑞伏基要你殺死10個沼牙撕裂者。',
  }
},
[9771] = {
  {
    'À procura do Batedor Jyoba‡Поиски разведчика Джиобы‡Auf der Suche nach Späher Jyoba‡정찰병 죠바 찾기‡En busca del explorador Jyoba‡En busca del explorador Jyoba‡À la recherche de l\'éclaireur Jyoba‡寻找斥候尤尔巴‡尋找斥候傑巴',
    nil,
    'Procure o Batedor Jyoba no Charco Fantasma, no Pântano Zíngaro.‡Ищите разведчика Джиобу.‡Sucht Späher Jyoba.‡정찰병 죠바를 찾아야 합니다.‡Busca al explorador Jyoba.‡‡Partez à la recherche de l\'éclaireur Jyoba à la Morte-bourbe, au Marécage de Zangar.‡搜寻斥候尤尔巴的下落。‡尋找斥候傑巴。',
  }
},
[9772] = {
  {
    'Relatório de Jyoba‡Донесение разведчика Джиобы‡Jyobas Bericht‡정찰병 죠바의 보고서‡El informe de Jyoba‡El informe de Jyoba‡Le rapport de Jyoba‡尤尔巴的报告‡傑巴的報告',
    nil,
    'Recupere o Relatório do Batedor Jyoba dos Gigantes Definhados e leve-o para Zurai, no Mocó do Rato Lamacento.‡Добудьте донесение разведчика Джиобы у высохших великанов и вернитесь с ним к Зураю на заставу Болотной Крысы.‡Besorgt Späher Jyobas Bericht von den siechenden Riesen und kehrt dann zu Zurai im Sumpfrattenposten zurück.‡말라 비틀어진 포자거인을 처치하고 정찰병 죠바의 보고서를 찾아서 늪쥐 감시초소에 있는 주라이에게 가져가야 합니다.‡Recupera el informe del explorador Jyoba de los gigantes marchitos y llévaselo a Zurai, en la Avanzada Rata del Pantano.‡Recupera el informe del explorador Jyoba de los gigantes marchitos y llévaselo a Zurai, en la Avanzada Rata del Pantano.‡Reprenez le Rapport de l\'éclaireur Jyoba aux Géants flétris et rapportez-le à Zurai au poste du Rat des marais.‡从枯萎的巨人手中夺回斥候尤尔巴的报告，把它交给沼泽鼠岗哨的祖莱。‡從枯萎的巨人那裡取得斥候傑巴的報告並將它交給斯溫派特崗哨的祖瑞伊。',
  }
},
[9773] = {
  {
    'Chega de cogumelos!‡Довольно грибов!‡Keine Pilze mehr!‡버섯은 질렸다고!‡¡Ya basta de champiñones!‡¡Ya basta de champiñones!‡Plus de champignons !‡别再提蘑菇了！‡不要再給我蘑菇了!',
    nil,
    'Consiga 8 Filés de Enguia das Enguias do Charco Sombrio e leve-os para Magasha, no Mocó do Rato Lamacento.‡Добудьте 8 филе угря с угрей из озера Тенетопь и принесите их Магаше на заставу Болотной Крысы.‡Bringt 8 Aalfilets von Umbrafennaalen zu Magasha im Sumpfrattenposten.‡그늘늪 뱀장어를 처치하고 뱀장어 살토막 8개를 모아서 늪쥐 감시초소에 있는 마가샤에게 가져가야 합니다.‡Recolecta 8 filetes de anguila de las anguilas Umbropantano y llévaselos a Magasha en la Avanzada Rata del Pantano.‡Recolecta 8 filetes de anguila de las anguilas Umbropantano y llévaselos a Magasha en la Avanzada Rata del Pantano.‡Prélever 8 Filets d\'anguilles sur des Anguilles d\'Umbretourbe et les apporter à Magasha, au poste du Rat des marais.‡猎杀暗泽鳗鱼，将8份电鳗鱼片交给沼泽鼠岗哨的玛加沙。‡從昂布拉凡鰻魚身上收集8份鰻魚片並帶給斯溫派特崗哨的瑪卡莎。',
  }
},
[9774] = {
  {
    'Escamas grossas de hidra‡Толстая чешуя гидры‡Dicke Hydraschuppen‡두꺼운 히드라 비늘‡Escama de hidra gruesa‡Escama de hidra gruesa‡Les écailles d\'hydre épaisses‡厚重多头蛇鳞片‡厚多頭蛇鱗片',
    nil,
    'Zurai, no Mocó do Rato Lamacento, quer que você traga 12 Escamas Grossas de Hidra.‡Принесите Зураю на заставу Болотной Крысы 12 толстых чешуек гидры.‡Bringt 12 dicke Hydraschuppen zu Zurai im Sumpfrattenposten.‡늪쥐 감시초소에 있는 주라이가 두꺼운 히드라 비늘 12개를 가져다 달라고 부탁했습니다.‡Zurai en la Avanzada Rata del Pantano quiere que le lleves 12 escamas de hidra gruesas.‡Zurai en la Avanzada Rata del Pantano quiere que le lleves 12 escamas de hidra gruesas.‡Zurai, au poste du Rat des marais, veut que vous lui apportiez 12 Écailles d\'hydre épaisses.‡将12块厚重多头蛇鳞片交给沼泽鼠岗哨的祖莱。‡斯溫派特崗哨的祖瑞伊要你幫他帶來12片厚多頭蛇鱗片。',
  }
},
[9775] = {
  {
    'Apresente-se ao caçador sombrio Denjai‡Донесение темному охотнику Денжаю‡Bericht an Schattenjäger Denjai‡어둠사냥꾼 덴자이에게 보고‡Cazador de las Sombras Denjai‡Cazador de las Sombras Denjai‡Aller voir le chasseur des ombres Denjai‡向暗影猎手德恩加报到‡向暗影獵人丹傑回報',
    nil,
    'Leve o Relatório de Zurai para o Caçador Sombrio Denjai em Zabra\'jin.‡Отнесите донесение Зурая темному охотнику Денжаю в Забра\'джин.‡Bringt Zurais Bericht zu Schattenjäger Denjai in Zabra\'jin.‡자브라진에 있는 어둠사냥꾼 덴자이에게 주라이의 보고서를 가져가야 합니다.‡Lleva el informe de Zurai al cazador de las Sombras Denjai a Zabra\'jin‡‡Apporter le Rapport de Zurai chasseur des ombres Denjai à Zabra\'jin.‡将祖莱的报告交给萨布拉金的暗影猎手德恩加。‡將祖瑞伊的報告帶給薩布拉金的暗影獵人丹傑。',
  }
},
[9776] = {
  {
    'O Porto Orebor‡Прибежище Оребор‡Die Oreborzuflucht‡오레보르 피난처‡El Puerto Orebor‡El Puerto Orebor‡Le Havre d\'Orebor‡奥雷柏尔营地‡奧雷伯爾港',
    nil,
    'Fale com Ikuti no Porto Orebor.‡Поговорите с Икути в прибежище Оребор.‡Sprecht mit Ikuti in der Oreborzuflucht.‡오레보르 피난처에 있는 이쿠티와 대화해야 합니다.‡Habla con Ikuti en el Puerto Orebor.‡‡Parlez à Ikuti au Havre d\'Orebor.‡与奥雷柏尔营地的伊库提谈一谈。‡和奧雷伯爾港的伊庫堤談談。',
  }
},
[9777] = {
  {
    'Esporos de fulgor‡Споры гриба-блескуна‡Fulgorsporen‡펄고르 버섯‡Esporas refulgentes‡Esporas refulgentes‡Les spores de fulgor‡灿烂的孢子‡明亮孢子',
    nil,
    'Traga 6 Esporos de Fulgor para Ruam, em Telredor.‡Принесите 6 спор гриба-блескуна Руаму в Телредоре.‡Bringt 6 Fulgorsporen zu Ruam in Telredor.‡텔레도르에 있는 루암에게 펄고르 버섯 6개를 가져가야 합니다.‡Lleva 6 esporas refulgentes a Ruam en Telredor.‡Lleva 6 esporas refulgentes a Ruam en Telredor.‡Apportez 6 Spores de fulgor à Ruam, à Telredor.‡将6个灿烂的孢子交给泰雷多尔的鲁埃姆。‡帶6個明亮孢子給泰倫多爾的洛安瑪。',
  }
},
[9778] = {
  {
    'Guardião Hamoot‡Страж Хамут‡Aufseher Hamuht‡감시자 하무트와 대화‡El celador Hamoot‡El celador Hamoot‡Le gardien Hamoot‡监护者哈穆特‡守望者漢姆特',
    nil,
    'Apresente-se ao Guardião Hamoot no Refúgio Cenariano, no Pântano Zíngaro.‡Поговорите со стражем Хамутом в Кенарийском приюте в Зангартопи.‡Meldet Euch bei Aufseher Hamuht in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 감시자 하무트에게 보고해야 합니다.‡Informa al celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar.‡Preséntate ante el celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar.‡Allez vous présenter au gardien Hamoot au Refuge cénarien dans le marécage de Zangar.‡向赞加沼泽塞纳里奥庇护所的监护者哈穆特报到。‡到贊格沼澤的塞納里奧避難所向守望者漢姆特報告。',
  }
},
[9779] = {
  {
    'Interceptar a mensagem‡Перехват сообщения‡Abfangen der Nachricht‡태양매 서한 탈취‡Interceptando el mensaje‡Interceptando el mensaje‡L\'interception des messages‡拦截情报‡攔截訊息',
    nil,
    'Mate elfos Falconélius até encontrar a Missiva do Falconélius. Em seguida, entregue-a para o Vindicante Boros no Entreposto Rubro.‡Найдите послание Солнечных Ястребов. Возможно, для этого придется убить нескольких из них. Послание должно быть доставлено на Кровавую заставу воздаятелю Боросу.‡Tötet die Elfen der Sonnenfalken, bis Ihr das Schreiben der Sonnenfalken findet, und bringt es zu Verteidiger Boros bei der Blutwacht.‡태양매 서한을 찾을 때까지 태양매 블러드 엘프들을 처치하여 서한을 얻은 후, 핏빛 감시초소에 있는 구원자 보로스에게 가져가야 합니다.‡Mata elfos de Halcón del Sol hasta que encuentres la misiva de Halcón del Sol. Después, vuelve a hablar con el vindicador Boros en Avanzada de Sangre.‡Mata elfos de Halcón del Sol hasta que encuentres la misiva de Halcón del Sol. Después, vuelve a hablar con el vindicador Boros en Avanzada de Sangre.‡Tuez assez d’Elfes Eperviers du soleil pour trouver la Missive des Éperviers du soleil et rapportez-la au Redresseur de torts Boros, au Guet du sang.‡不断杀死炎鹰血精灵，直到你找到炎鹰信函，然后向秘血岗哨的守备官波鲁斯复命。‡殺死太陽之鷹的血精靈們直到你取得太陽之鷹書信，然後交給血色守望的復仇者波羅斯。',
  }
},
[9780] = {
  {
    'Filés de enguia do Charco Sombrio‡Филе угрей из озера Тенетопь‡Aalfilets von Umbrafenn‡그늘늪 뱀장어‡Filetes de anguila de Umbropantano‡Filetes de anguila de Umbropantano‡Les filets d\'anguilles d\'Umbretourbe‡电鳗鱼片‡昂布拉凡鰻魚片',
    nil,
    'Noraani em Telredor quer que você traga 8 Filés de Enguia.‡Принесите Нораани из Телредора 8 филе угря.‡Bringt 8 Aalfilets zu Noraani in Telredor.‡텔레도르에 있는 노라니가 뱀장어 살토막 8개를 가져다 달라고 부탁했습니다.‡Noraani de Telredor quiere que le traigas 8 filetes de anguila.‡Noraani de Telredor quiere que le traigas 8 filetes de anguila.‡Noraani, à Telredor, veut que vous lui apportiez 8 Filets d\'anguille.‡将8份电鳗鱼片交给泰雷多尔的诺兰妮。‡泰倫多爾的諾納尼要你幫她帶來8份鰻魚片。',
  }
},
[9781] = {
  {
    'Muitas bocas para alimentar‡Слишком много ртов!‡Zu viele Mäuler zu stopfen‡식량 경쟁‡Demasiadas bocas que alimentar‡Demasiadas bocas que alimentar‡Trop de bouches à nourrir‡不堪重负‡僧多粥少',
    nil,
    'Mate 10 Hidras Lodosas e fale novamente com Haalrun, em Telredor.‡Убейте 10 болотных гидр и вернитесь к Хаалруну в Телредор.‡Tötet 10 Morasthydras und kehrt zu Haalrun in Telredor zurück.‡수렁 히드라 10마리를 처치한 후 텔레도르에 있는 하알룬에게 돌아가야 합니다.‡Mata 10 hidras de lodazal y vuelve a ver a Haalrun en Telredor.‡Mata 10 hidras de lodazal y vuelve a ver a Haalrun en Telredor.‡Tuez 10 Hydres du bourbier et retournez voir Haalrun à Telredor.‡杀死10只泥潭多头蛇，然后向泰雷多尔的海尔伦复命。‡殺死10個污泥多頭蛇再回到泰倫多爾的哈爾隆恩那裡。',
  }
},
[9782] = {
  {
    'O Charco Fantasma‡Мертвая трясина‡Das Todesmoor‡죽음의 늪‡El Lodo Muerto‡El Lodo Muerto‡La Morte-bourbe‡死亡泥潭‡死亡污泥',
    nil,
    'Traga uma Amostra de Solo do Charco Fantasma para o Vindicante Idaar em Telredor.‡Принесите пробу почвы Мертвой трясины воздаятелю Идаару в Телредоре.‡Bringt eine Erdprobe vom Todesmoor zu Verteidiger Idaar in Telredor.‡텔레도르에 있는 구원자 이다르에게 죽음의 늪 토양 견본을 가져가야 합니다.‡Lleva una muestra de tierra de El Lodo Muerto al vindicador Idaar, en Telredor.‡Lleva una muestra de tierra de El Lodo Muerto al vindicador Idaar, en Telredor.‡Apportez un Échantillon de terre de Morte-bourbe au Redresseur de torts Idaar, à Telredor.‡将一份死亡泥潭土壤样本交给泰雷多尔的守备官伊达尔。‡將死亡污泥泥土樣本帶給泰倫多爾的復仇者伊達爾。',
  }
},
[9783] = {
  {
    'Estiagem anormal‡Неестественная засуха‡Eine unnatürliche Dürre‡혹독한 가뭄‡Una sequía no natural‡Una sequía no natural‡Une sécheresse peu naturelle‡异样的干旱‡不尋常的乾旱',
    nil,
    'O Vindicante Idaar, em Telredor, quer que você mate 12 Gigantes Definhados.‡Убейте 12 иссохших великанов по просьбе воздаятеля Идаара из Телредора.‡Verteidiger Idaar in Telredor möchte, dass Ihr 12 siechende Riesen tötet.‡텔레도르에 있는 구원자 이다르가 말라 비틀어진 포자거인 12마리를 처치해 달라고 부탁했습니다.‡El vindicador Idaar en Telredor quiere que mates 12 gigantes marchitos.‡El vindicador Idaar en Telredor quiere que mates 12 gigantes marchitos.‡Le redresseur de torts Idaar, à Telredor, veut que vous tuiez 12 Géants flétris.‡泰雷多尔的守备官伊达尔要你去杀死12个枯萎的巨人。‡泰倫多爾的復仇者伊達爾要你去殺死12個枯萎的巨人。',
  }
},
[9784] = {
  {
    'Identificar fragmentos de plantas‡Определение растений‡Pflanzenteile identifizieren‡식물 기관 확인‡Identificar partes de plantas‡Identificar partes de plantas‡L\'identification des morceaux de plantes‡鉴定植物‡辨別植物組織',
    nil,
    'Eu ainda preciso de alguns fragmentos de plantas. Devido à diminuição das águas nos lagos, sinto que teremos um grande aumento no número de espécies agressivas. Entretanto, preciso de mais plantas para confirmar minha teoria.‡Новые части растений мне всегда пригодятся! Сейчас, когда уровень воды в озерах постоянно снижается, у меня возникает чувство, что на болотах растет число пришлых растений. Однако чтобы подтвердить эту теорию, мне нужны точные цифры!‡Ich könnte noch mehr Pflanzenteile brauchen. Jetzt, da die Seen ihr Wasser verlieren, befürchte ich, dass die fremden Arten zunehmen werden. Ich brauche aber mehr Beweise, um meine Theorie zu untermauern.‡‡Necesito más partes de plantas. Ahora que los lagos están perdiendo el agua, sospecho que las especies invasoras están proliferando, pero necesito más muestras para defender esta teoría.‡‡Il me faudrait encore d\'autres morceaux de plantes. Avec la baisse du niveau des eaux, j\'ai l\'impression que le nombre d\'espèces envahissantes augmente. J\'ai cependant besoin d\'un échantillon plus large pour appuyer ma théorie.‡‡',
  }
},
[9785] = {
  {
    'Bênção dos anciãos‡Благословение Древ‡Der Segen der Uralten‡고대정령의 축복‡Bendición de los ancestros‡Bendición de los ancestros‡La bénédiction des anciens‡古树的祝福‡先祖的祝福',
    nil,
    'A Arauto do Vento Casco Negro quer que você fale com os ancientes Ashyen e Keleth no Refúgio Cenariano e ganhe suas bênçãos.‡Призывательница ветров Черное Копыто просит вас поговорить с древами Ашьеном и Келетом в Кенарийском приюте и получить их благословение.‡Windruferin Schwarzhuf möchte, dass Ihr mit den Urtumen Ashyen und Keleth in der Zuflucht des Cenarius sprecht und um ihren Segen bittet.‡바람소환사 블랙후프가 세나리온 야영지에 있는 아쉬옌과 켈레스와 대화해 보고 그들의 축복을 얻으라고 말했습니다.‡Clamavientos Pezuñanegra quiere que hables con los ancianos Ashyen y Keleth en el Refugio Cenarion y que obtengas su bendición.‡Clamavientos Pezuñanegra quiere que hables con los ancianos Ashyen y Keleth en el Refugio Cenarion y que obtengas su bendición.‡L\'imploratrice céleste Sabot-noir veut que vous alliez parler aux anciens Ashyen et Keleth au Refuge cénarien, pour obtenir leur bénédiction.‡唤风者塔鲁·黑蹄要求你与塞纳里奥庇护所的埃西恩和克勒斯谈一谈，获得古树的祝福。‡喚風者黑蹄要你去和塞納里奧避難所的先祖艾斯炎及奇里斯談談並取得他們的祝福。',
  }
},
[9786] = {
  {
    'As Ruínas de Boha\'mu‡Руины Боха\'му‡Die Ruinen von Boha\'mu‡보하무 폐허‡Las Ruinas Boha\'mu‡Las Ruinas Boha\'mu‡Les ruines de Boha\'mu‡博哈姆废墟‡波哈姆廢墟',
    nil,
    'O Anacoreta Ahuurn em Telredor quer que você explore as Ruínas de Boha\'mu.‡Исследуйте руины Боха\'му по просьбе анахорета Ахуурна из Телредора.‡Anachoret Ahuurn in Telredor möchte, dass Ihr die Ruinen von Boha\'mu erforscht.‡텔레도르에 있는 수도사 아후른이 보하무 폐허를 조사해 달라고 부탁했습니다.‡El anacoreta Ahuurn de Telredor quiere que explores las Ruinas Boha\'mu.‡El anacoreta Ahuurn de Telredor quiere que explores las Ruinas Boha\'mu.‡L\'anachorète Ahuurn de Telredor veut que vous exploriez les Ruines de Boha\'mu.‡泰雷多尔的学者安霍尔要你去侦察博哈姆废墟。‡泰倫多爾的隱士阿浩恩要你去波哈姆廢墟探勘。',
  }
},
[9787] = {
  {
    'Ídolos do Charco das Feras‡Идолы Дикотопи‡Götzen des Wildfennstamms‡야생늪일족 우상‡Ídolos de Feropantano‡Ídolos de Feropantano‡Les idoles des Tourbe-farouches‡蛮沼雕像‡菲拉芬塑像',
    nil,
    'Colete 6 Ídolos de Charco das Feras e devolva-os para o Anacoreta Ahuurn, em Telredor.‡Соберите 6 идолов Дикотопи и вернитесь с ними к анахорету Ахуурну в Телредор.‡Sammelt 6 Wildfenngötzen und kehrt dann zu Anachoret Ahuurn in Telredor zurück.‡야생늪일족 우상 6개를 모은 후 텔레도르에 있는 수도사 아후른에게 가져가야 합니다.‡Recolecta 6 ídolos de Feropantano y llévaselos al anacoreta Ahuurn a Telredor.‡Recolecta 6 ídolos de Feropantano y llévaselos al anacoreta Ahuurn a Telredor.‡Récupérez 6 Idoles Tourbe-farouche et rapportez-les à l\'anachorète Ahuurn à Telredor.‡将6个蛮沼雕像交给泰雷多尔的学者安霍尔。‡收集6個菲拉芬塑像並帶回泰倫多爾給隱士阿浩恩。',
  }
},
[9788] = {
  {
    'Um lugar úmido e escuro‡Темное, сырое место‡Ein feuchter, düsterer Ort‡축축하고 어두운 곳‡Un lugar húmedo y sombrío‡Un lugar húmedo y sombrío‡Un lieu sombre et humide‡阴冷之地‡黑暗潮濕的地方',
    nil,
    'Procure pelos Pertences de Ikeyen dentro da caverna ao sul do Charco Sombrio. Devolva-os para Ikeyen no Refúgio Cenariano, no Pântano Zíngaro.‡Отыщите вещи Икейена в пещере к югу от Тенетопи. Верните их Икейену в Кенарийском приюте в Зангартопи.‡Sucht nach Ikeyens Habseligkeiten in einer Höhle südlich von Umbrafenn. Bringt sie zurück zu Ikeyen in der Zuflucht des Cenarius in den Zangarmarschen.‡그늘늪의 남쪽에 있는 동굴 안에서 이케옌의 소지품을 찾은 후, 장가르 습지대의 세나리온 야영지에 있는 이케옌에게 가져가야 합니다.‡Busca las pertenencias de Ikeyen en una cueva al sur de Umbropantano. Llévaselas de vuelta a Ikeyen en el Refugio Cenarion, en la Marisma de Zangar.‡Busca las pertenencias de Ikeyen en una cueva al sur de Umbropantano. Llévaselas de vuelta a Ikeyen en el Refugio Cenarion, en la Marisma de Zangar.‡Cherchez les affaires d\'Ikeyen à l\'intérieur d\'une caverne au sud d\'Umbretourbe. Rapportez-les à Ikeyen au Refuge cénarien dans le marécage de Zangar.‡进入暗泽村以南的一处洞穴寻找伊卡因的物品，把它们还给赞加沼泽塞纳里奥庇护所的伊卡因。‡在昂布拉凡南方的洞穴裡尋找伊奇言的物品。把它們帶回贊格沼澤還給塞納里奧避難所的伊奇言。',
  }
},
[9789] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Cace 12 Fenocerontes e fale novamente com Rosarães Guima, no Safári Rosarães, em Nagrand, para provar seu valor.‡Убейте 30 копытней и вернитесь к Хемингу Эрнестуэю в его охотничий лагерь в Награнде.‡Erlegt 30 Grollhufe und kehrt anschließend zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand zurück, um Euch zu beweisen.‡갈래발굽 30마리를 잡아서 나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 돌아가 사냥 실력을 증명해야 합니다.‡Caza 30 uñagrietas y vuelve a ver a Hemet Nesingwary en el Safari Nesingwary, en Nagrand, para demostrar tu valía.‡‡Chassez 30 Sabots-fourchus et retournez voir Hemet Nesingwary au safari de Nesingwary, en Nagrand, pour prouver votre valeur.‡杀死30头裂蹄牛，然后向纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里复命。‡獵殺30隻裂蹄後回到奈辛瓦里旅隊找赫米特·奈辛瓦里證明自己',
  }
},
[9790] = {
  {
    'Asas diáfanas‡Прозрачные крылья‡Lichtdurchlässige Flügel‡투명한 날개‡Alas diáfanas‡Alas diáfanas‡Ailes diaphanes‡透明的虫翼‡透明之翼',
    nil,
    'Haalrun, em Telredor, quer que você traga 8 Asas Diáfanas de qualquer espécie de vaga-lume do Pântano Zíngaro.‡Принесите Хаалруну из Телредора 8 прозрачных крыльев любых видов светляков, обитающих в Зангартопи.‡Bringt 8 lichtdurchlässige Flügel von einer beliebigen Glühwürmchenart der Zangarmarschen zu Haalrun in Telredor.‡텔레도르에 있는 하알룬이 장가르 습지대에 있는 어떤 반딧불이에게서든 투명한 날개 8개를 구해 가져다 달라고 부탁했습니다.‡Haalrun en Telredor quiere que le lleves 8 alas diáfanas de cualquier especie voladora de la Marisma de Zangar.‡Haalrun en Telredor quiere que le lleves 8 alas diáfanas de cualquier especie voladora de la Marisma de Zangar.‡Haalrun de Telredor veut que vous lui rameniez 8 Ailes diaphanes de n\'importe quelles lucioles du marécage de Zangar.‡猎杀赞加沼泽的萤火虫，将8片透明的虫翼交给泰雷多尔的海尔伦。‡泰倫多爾的哈爾隆恩要你幫他從贊格沼澤的任何螢火蟲身上帶回8個透明之翼。',
  }
},
[9791] = {
  {
    'Ameaça presamangue‡Опасные болотные клыки‡Bedrohliche Marschenfänge‡늪송곳니 가오리의 위협‡La amenaza de los Colmillo de la marisma‡La amenaza de los Colmillo de la Marisma‡Les crocs-du-marais menaçants‡沼牙的威胁‡險惡的沼牙',
    nil,
    'Mate 10 Estripadores Presamangue e fale novamente com Noraani, em Telredor.‡Убейте 10 болотных потрошителей и вернитесь к Нораани в Телредор.‡Tötet 10 Marschenfangreißer und kehrt dann zu Noraani in Telredor zurück.‡톱니 늪송곳니 가오리 10마리를 처치한 후 텔레도르에 있는 노라니에게 돌아가야 합니다.‡Mata 10 destripadores Colmillo de la marisma y vuelve a ver a Noraani en Telredor.‡Mata 10 destripadores Colmillo de la Marisma y vuelve a ver a Noraani en Telredor.‡Tuez 10 Eventreurs Croc-du-marais et retournez voir Noraani à Telredor.‡杀掉10个沼牙撕裂者，然后向泰雷多尔的诺兰妮复命。‡殺死10個沼牙撕裂者再回到泰倫多爾的諾納尼那裡。',
  }
},
[9792] = {
  {
    'Uma mensagem para Telaar‡Послание в Телаар‡Eine Botschaft für Telaar‡텔라아르로 전할 메시지‡Un mensaje para Telaar‡Un mensaje para Telaar‡Un message pour Telaar‡前往塔拉‡給泰拉的消息',
    nil,
    'Fale com o Protetor Moi\'bff Jill na vila de Telaar, em Nagrand.‡Поговорите с Нахуудом в Телааре в Награнде.‡Sprecht mit Nahuud in Telaar in Nagrand.‡나그란드의 텔라아르에 있는 나후우드와 대화해야 합니다.‡Habla con Nahuud en Telaar, en Nagrand.‡Habla con el celador Moi\'bff Jill en Telaar, en Nagrand.‡Parlez au Gardien Moi’bff Jill à Telaar, en Nagrand.‡前往纳格兰，与塔拉的纳霍德谈一谈。‡到納葛蘭和泰拉的納霍德談談。',
  }
},
[9793] = {
  {
    'O destino de Tuurem‡Судьба Туурема‡Das Schicksal von Tuurem‡투렘의 운명‡El destino de Tuurem‡El destino de Tuurem‡La destinée de Tuurem‡图雷姆的命运‡杜瑞的命運',
    nil,
    'Leve a Carta do Vindicante Idaar para Andarl na Fortaleza Alleriana, na Mata Terokkar.‡Отнесите письмо воздаятеля Идаара Андарлу в бастион Аллерии в лесу Тероккар.‡Bringt Verteidiger Idaars Brief zu Andarl in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 안다를에게 구원자 이다르의 편지를 전달해야 합니다.‡Lleva la carta del vindicador Idaar a Andarl en el Bastión Allerian, en el Bosque de Terokkar.‡Lleva la carta del vindicador Idaar a Andarl en el Bastión Allerian, en el Bosque de Terokkar.‡Apportez la Lettre du redresseur de torts Idaar à Andarl au Bastion allérien dans la forêt de Terokkar.‡将守备官伊达尔的信交给泰罗卡森林奥蕾莉亚要塞的安达尔。‡將復仇者伊達爾的信帶到泰洛卡森林給艾蘭里堡壘的安達爾歐。',
  }
},
[9794] = {
  {
    'Sem tempo para curiosos‡Не время для любопытства‡Keine Zeit für Neugier‡궁금해할 새도 없이...‡No hay tiempo para la curiosidad‡No hay tiempo para la curiosidad‡La curiosité est un vilain défaut‡禁止拆阅‡沒時間好奇了',
    nil,
    'Entregue a Carta de Timóteo Dinis a Kialon em Sylvanaar, nas Montanhas da Lâmina Afiada.‡Доставьте письмо Тимоти Киалону в Сильванаар в Острогорье.‡Bringt Timothys Brief zu Kialon in Sylvanaar im Schergrat.‡칼날 산맥의 실바나르에 있는 키알론에게 티모시가 보낸 편지를 전달해야 합니다.‡Lleva la carta de Timothy a Kialon en Sylvanaar, en las Montañas Filospada.‡Lleva la carta de Timothy a Kialon en Sylvanaar, en las Montañas Filospada.‡Apportez la Lettre de Timothy à Kialon à Sylvanaar dans les Tranchantes.‡将迪莫斯的信交给刀锋山希尔瓦纳的基亚隆。‡把提莫斯的信帶給位在劍刃山脈希爾瓦納的齊亞隆。',
  }
},
[9795] = {
  {
    'A ameaça dos ogros‡Угроза со стороны огров‡Die Ogerbedrohung‡오우거의 위협‡La amenaza de los ogros‡La amenaza de los ogros‡La menace ogre‡食人魔的威胁‡巨魔威脅',
    nil,
    'Viaje para a Cidadela do Senhor do Trovão, nas Montanhas da Lâmina Afiada, e fale com Nekthar.‡Отправляйтесь в оплот Громоборцев в Острогорье и поговорите с Нехтаром.‡Reist zur Donnerfeste im Schergrat und sprecht mit Nekthar.‡칼날 산맥에 있는 천둥군주 요새로 가서 네크타르와 대화하십시오.‡Ve al Bastión Señor del Trueno en las Montañas Filospada y habla con Nekthar.‡Ve al Bastión Señor del Trueno en las Montañas Filospada y habla con Nekthar.‡Rendez-vous au bastion des Sire-tonnerre dans les Tranchantes, et parlez à Nekthar.‡前往刀锋山的雷神要塞，与奈克塔尔谈一谈。‡前往劍刃山脈的雷霆王村和奈克薩爾談談。',
  }
},
[9796] = {
  {
    'Notícias do Pântano Zíngaro‡Новости из Зангартопи‡Nachricht aus den Zangarmarschen‡장가르 습지대에서 온 소식‡Noticias de la Marisma de Zangar‡Noticias de la Marisma de Zangar‡Des nouvelles du marécage de Zangar‡赞加沼泽的来客‡贊格沼澤的消息',
    nil,
    'Fale com Mokasa na Vila de Quebrapedra, na Mata Terokkar.‡Поговорите с Мокасой в форте Камнеломов в лесу Тероккар.‡Sprecht mit Mokasa in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 모카사와 대화하십시오.‡Habla con Mokasa en el Bastión Rompepedras, en el Bosque de Terokkar.‡Habla con Mokasa en el Bastión Rompepedras, en el Bosque de Terokkar.‡Parlez à Mokasa, au fort des Brise-pierres, dans la forêt de Terokkar.‡前往泰罗卡森林的裂石堡，与莫萨卡谈一谈。‡到泰洛卡森林和碎石堡的莫卡薩談談。',
  }
},
[9797] = {
  {
    'Reforços para Garadar‡Подкрепление для Гарадара‡Verstärkung für Garadar‡가라다르 지원‡Refuerzos para Garadar‡Refuerzos para Garadar‡Des renforts pour Garadar‡支援加拉达尔‡卡拉達爾的援軍',
    nil,
    'Fale com Capitão Kroghan na cidade de Garadar, em Nagrand.‡Поговорите с капитаном Кроганом в Гарадаре в Награнде.‡Sprecht mit Hauptmann Kroghan in Garadar in Nagrand.‡나그란드의 가라다르에 있는 경비대장 크로그한과 대화하십시오.‡Habla con el capitán Kroghan en Garadar, en Nagrand.‡Habla con el capitán Kroghan en Garadar, en Nagrand.‡Parlez au capitaine Kroghan à Garadar en Nagrand.‡前往纳格兰的加拉达尔，与克洛坎上尉谈一谈。‡到納葛蘭和卡拉達爾的隊長卡洛克汗談談。',
  }
},
[9798] = {
  {
    'Os planos dos elfos sangrentos‡Планы эльфов крови‡Blutelfenpläne‡블러드 엘프의 계획서‡Planes de los elfos de sangre‡Planes de los elfos de sangre‡Les plans des elfes de sang‡血精灵计划书‡血精靈計畫書',
    nil,
    'Leve os Planos dos Elfos Sangrentos ao Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Отнесите планы эльфов крови воздаятелю Алдару на место крушения в долине Аммен.‡Bringt die Blutelfenpläne zu Verteidiger Aldar bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 블러드 엘프의 계획서를 가져가야 합니다.‡Lleva los planes de los elfos de sangre al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Lleva los planes de los elfos de sangre al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Apportez les Plans des elfes de sang au redresseur de torts Aldar au point d\'impact du val d\'Ammen.‡将血精灵计划书交给埃门谷坠毁点的守备官奥达尔。‡帶著血精靈計畫書到安曼谷的失事地點找復仇者艾德。',
  }
},
[9799] = {
  {
    'Trabalho de campo: botânica‡Сбор трав‡Botanische Hilfsarbeit‡식물학적 탐문 조사‡Trabajo de campo‡Trabajo de campo‡Un travail de botanique‡跑腿采花‡植物學家的跑腿任務',
    nil,
    'Colha 3 Flores Corrompidas e leve-as para a Aprendiz Vishael no Ponto de Impacto, que fica no Vale Ammen.‡Сорвите 3 оскверненных цветка и вернитесь к ученице Вишаэль на месте крушения в долине Аммен.‡Sammelt 3 verderbte Blumen und kehrt zu Lehrling Vishael bei der Absturzstelle im Am\'mental zurück.‡오염된 꽃 3개를 모아 암멘 골짜기의 추락 지점에 있는 수습생 비쉘에게 가져가야 합니다.‡Recolecta 3 flores corruptas y llévaselas a la aprendiza Vishael a Lugar del Accidente, en Valle Ammen.‡Recolecta 3 flores corruptas y llévaselas a la aprendiza Vishael a Lugar del Accidente, en Valle Ammen.‡Cueillez 3 Fleurs corrompues et apportez-les à l\'apprentie Vishael au point d\'impact du val d\'Ammen.‡采集3朵被污染的花朵，然后向埃门谷坠毁点的学徒维莎尔复命。‡收集3朵被污染的花朵再回到安曼谷的失事地點找學徒米虛歐。',
  }
},
[9800] = {
  {
    'Grãos muito especiais‡Редкий деликатес‡Eine seltene Bohne‡귀한 콩‡Una extraña judía‡Un extraño frijol‡Une graine rare‡稀有的豆子‡稀有的豆子',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você lhe traga 8 Caracolis Digeridos.‡Принесите повелителю стихий Ло\'апу к Трону стихий в Награнде 15 семян караколлы.‡Bringt 15 verdaute Caracolibohnen zu Elementarist Lo\'ap am Thron der Elemente in Nagrand.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 반쯤 소화된 카라콜리 15개를 모아 달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que le consigas 15 anacardos digeridos.‡‡L\'Elémentalise Lo\'ap, au Trône des éléments de Nagrand, veut que vous lui apportiez 15 Caracolis digérés‡将15颗挖出来的卡拉果交给纳格兰元素王座的元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你幫他帶來15個消化過的豆子。',
  }
},
[9801] = {
  {
    'Coleta de reagentes‡Сбор реагентов‡Die Reagenzien sammeln‡물약 재료 수집‡Recogiendo componentes‡Recogiendo componentes‡Rassembler les composants‡收集材料‡尋找材料',
    nil,
    'O Anacoreta Ahuurn, em Telredor, quer que você traga 4 Olhos de Quirósporo e 4 Tentáculos de Pernalta do Charco.‡Принесите анахорету Ахууму в Телредоре 4 глаза спороската и 4 щупальца болотного долгонога.‡Anachoret Ahuurn in Telredor möchte, dass Ihr ihm 4 Sporensegleraugen und 4 Fennschreitertentakel bringt.‡텔레도르에 있는 수도사 아후른이 포자날개 눈, 성큼걸이 포자손 촉수를 각각 4개씩 가져다 달라고 부탁했습니다.‡El anacoreta Ahuurn de Telredor quiere que le lleves 4 ojos de esporiélago y 4 tentáculos de zancudo pantanoso.‡‡L’anachorète Ahuurn, de Telredor, veut que vous lui rameniez 4 Yeux de sporoptères et 4 Tentacules de trotteur des tourbières.‡将4只孢子蝠的眼睛和4根沼泽阔步者的触须交给泰雷多尔的学者安霍尔。‡泰倫多爾的隱士阿浩恩要你幫他帶來4個孢子蝙蝠眼睛和4個沼地行者觸鬚。',
  }
},
[9802] = {
  {
    'Plantas do Pântano Zíngaro‡Растения Зангартопи‡Pflanzen der Zangarmarschen‡장가르 습지대의 식물‡Plantas de Marisma de Zangar‡Plantas de Marisma de Zangar‡Les plantes du marécage de Zangar‡赞加沼泽的植物‡贊格沼澤的植物',
    nil,
    'Traga 10 Fragmentos de Plantas não Identificadas para Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Принесите 10 неопознанных частей растений Лоранне Тар\'велл в Кенарийском приюте в Зангартопи.‡Bringt 10 unbekannte Pflanzenteile zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 정체 불명의 식물 기관 10개를 가져가야 합니다.‡Lleva 10 partes de plantas sin identificar a Lauranna Thar\'well al Refugio Cenarion en Marisma de Zangar.‡Lleva 10 fragmentos de plantas sin identificar a Lauranna Thar\'well al Refugio Cenarion en Marisma de Zangar.‡Apportez 10 Morceaux de plantes non identifiées à Lauranna Thar\'well, au Refuge cénarien dans le marécage de Zangar.‡将10株未鉴定过的植物交给赞加沼泽塞纳里奥庇护所的劳兰娜·萨维尔。‡帶10個未經辨認的植物組織到贊格沼澤給塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[9803] = {
  {
    'Mensageiro para o Charco das Feras‡Посланец в Дикотопь‡Botschaft für den Wildfennstamm‡야생늪일족으로 갈 전령‡Mensajero de los Feropantanos‡Mensajero de los Feropantanos‡Un message pour Tourbe-farouche‡蛮沼的信使‡菲拉芬的信差',
    nil,
    'Beba o Elixir de Ahuurn enquanto estiver nas Ruínas de Boha\'mu. Fale com o Ancião Kuruti enquanto estiver na forma de arakkoa.‡Отправляйтесь в руины Боха\'му и выпейте эликсир Ахуурна. Приняв обличье араккоа, поговорите со старейшиной Курути.‡Trinkt Ahuurns Elixier in den Ruinen von Boha\'mu. Sprecht mit dem Ältesten Kuruti in der Form eines Arakkoas.‡보하무 폐허로 가서 아후른의 비약을 마신 후 아라코아의 모습으로 변신하여 장로 쿠루티와 대화해야 합니다.‡Bebe el elixir de Ahuurn cuando estés en las Ruinas Boha\'mu. Habla con el ancestro Kuruti cuando hayas adoptado la forma de un arakkoa.‡Bebe el elixir de Ahuurn cuando estés en las Ruinas Boha\'mu. Habla con el ancestro Kuruti cuando hayas adoptado la forma de un arakkoa.‡Une fois dans les ruines de Boha’mu, buvez l’Élixir d’Ahuurn. Lorsque vous serez sous forme d’arakkoa, allez parler à l’Ancien Kuruti.‡到达博哈姆废墟后饮下安霍尔的药剂，伪装成鸦人，然后与长者库鲁提谈一谈。‡到達波哈姆廢墟後喝下阿浩恩藥劑。在阿拉卡形態下和年長的克魯提談談。',
  }
},
[9804] = {
  {
    'Espíritos inquietos do Celicanto‡Беспокойные духи озера Небесной Песни‡Aufgebrachte Geister des Himmelsweisensees‡흥분한 하늘노래의 정령‡Espíritus agitados de Sol Celeste‡Espíritus agitados de Sol Celeste‡Esprits agités de Chanteciel‡天歌湖的元素‡天歌的焦慮精靈',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua 8 Espíritos do Lago.‡Уничтожьте 12 озерных духов по просьбе повелителя cтихий Ло\'апа, обитающего у Трона стихий.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr 12 Seegeister tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 호수 정령 12마리를 해치워 달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas 12 espíritus del lago.‡‡L\'élémentaliste Lo\'ap, du Trône des éléments en Nagrand, veut que vous détruisiez 8 Esprits du lac.‡消灭12个湖水之魂，然后向纳格兰元素王座的元素师鲁艾普复命。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀12個湖中水之靈。',
  }
},
[9805] = {
  {
    'Bênção de Incineratus‡Благословение Возжигателя‡Segen des Incineratus‡인시네라투스의 축복‡Bendición de Incineratus‡Bendición de Incineratus‡La bénédiction d\'Incineratus‡伊森拉图斯的祝福‡辛納瑞塔斯的祝福',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua a Grande Cabana, a Cabana do Oeste, a Cabana do Sul e a Cabana do Leste, todas na Aldeia Canavento.nnAo terminar a tarefa, devolva o Fogo Vivo ao Elementalista Lo\'ap.‡Спалите самый большой дом и три лачуги на западной, восточной и южной окраинах деревни Трепещущего Тростника.nnКогда выполните поручение, верните живой огонь повелителю стихий Ло\'апу.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr die große Hütte, die westliche Hütte, die südliche Hütte und die östliche Hütte in Schilftanz zerstört.nnBringt das beseelte Feuer zurück zu Elementarist Lo\'ap, wenn Ihr fertig seid.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 바람갈대 마을에 있는 대형 막사, 서부 막사, 남부 막사, 동부 막사를 파괴해 달라고 했습니다.nn임무를 마치면 정령술사 로아프에게 살아있는 불을 가져가야 합니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la Cabaña Grande, la Cabaña del Oeste, la Cabaña del Sur y la Cabaña del Este en la Aldea Junco Alabeado.nnDevuelve el fuego viviente al elementalista Lo\'ap cuando hayas completado tu tarea.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la Cabaña Grande, la Cabaña del Oeste, la Cabaña del Sur y la Cabaña del Este en la Aldea Junco Alabeado.|n|nDevuelve el fuego viviente al elementalista Lo\'ap cuando hayas completado tu tarea.‡L’Elémentaliste Lo’ap, au Trône des éléments, en Nagrand, veut que vous détruisiez la Grande hutte, la Hutte de l’ouest, la Hutte du sud et la Hutte de l’est à Ventejonc.nnRendez le Feu vivant à l’Elémentaliste Lo’ap quand vous aurez terminé votre tâche.‡纳格兰元素王座的元素师鲁艾普要你焚毁风茅村的大棚屋、西部棚屋、南部棚屋和东部棚屋。nn完成任务后将活火还给元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀風蘆村的大營房，西營房，南營房，和東營房。|n完成任務後將生命之火還給元素師羅艾柏。',
  }
},
[9806] = {
  {
    'Esporos férteis‡Прорастающие споры‡Fruchtbare Sporen‡생식 포자‡Esporas fértiles‡Esporas fértiles‡Des spores fertiles‡成熟的孢子‡豐饒孢子',
    nil,
    'Gshaff quer que você recolha 6 Esporos Férteis dos vários Morcegos Esporóforos e Pernaltas do Pântano no Pântano Zíngaro. Fale novamente com Gshaff em Sporeggar quando tiver completado a tarefa.‡Соберите 6 прорастающих спор с различных спороскатов и болотобродов. Выполнив задачу, вернитесь к Гшаффу в Спореггар.‡Sammelt 6 fruchtbare Sporen von den Sporenseglern und den Marschenläufern der Zangarmarschen und kehrt danach zu Gshaff in Sporeggar zurück.‡장가르 습지대의 다양한 포자날개와 습지대 포자손에게서 생식 포자 6개를 모은 후 스포어가르에 있는 그샤프에게 돌아가야 합니다.‡Gshaff quiere que reúnas 6 esporas fértiles entre los esporiélagos y los caminantes de marismas de la Marisma de Zangar. Vuelve a ver a Ghsaff en Esporaggar cuando hayas completado la tarea.‡Gshaff quiere que reúnas 6 esporas fértiles entre los esporiélagos y los caminantes de marismas de la Marisma de Zangar. Vuelve a ver a Ghsaff en Esporaggar cuando hayas completado la tarea.‡Gshaff veut que vous récoltiez 6 Spores fertiles sur les Sporoptères et Marcheurs des marais du marécage de Zangar. Revenez voir Gshaff à Sporeggar quand vous aurez terminé cette tâche.‡从赞加沼泽的孢子蝠和泥沼游荡者身上收集6个成熟的孢子，把它们交给孢子村的格沙弗。‡吉薩夫要你從贊格沼澤不同的孢子蝙蝠和沼澤行者身上收集6份豐饒孢子。完成任務後回到斯博格爾找吉薩夫。',
  }
},
[9807] = {
  {
    'Mais esporos férteis‡Новые прорастающие споры‡Noch mehr fruchtbare Sporen‡생식 포자 추가 수집‡Más esporas‡Más esporas‡Plus de spores fertiles‡更多成熟的孢子‡更多豐饒孢子',
    nil,
    '‡‡‡‡‡‡Nous avons toujours l’usage de spores fertiles, <race>. Les Grands-pieds sont des champignons extrêmement utiles. Pouvoir les cultiver nous permet de faire d’innombrables choses.‡‡',
  }
},
[9808] = {
  {
    'Chapéus-opalinos‡Грибы-огнешляпки‡Glühkappenpilze‡초롱버섯‡Fluochampiñones‡Fluochampiñones‡Les chapeluisants‡亮顶蘑菇‡白閃菇',
    nil,
    'Traga 10 Chapéus-opalinos para Msshi\'fn em Sporeggar, no Pântano Zíngaro.‡Принесите 10 огнешляпок Мссхи\'фну в Спореггар в Зангартопи.‡Bringt 10 Glühkappen zu Msshi\'fn in Sporeggar in den Zangarmarschen.‡장가르 습지대의 스포어가르에 있는 므쉬픈에게 초롱버섯 10개를 가져가야 합니다.‡Lleva 10 fluochampiñones a Msshi\'fn a Esporaggar en Marisma de Zangar.‡Lleva 10 fluochampiñones a Msshi\'fn a Esporaggar en Marisma de Zangar.‡Apportez 10 Chapeluisants à Msshi\'fn de Sporeggar, dans le marécage de Zangar.‡将10枚亮顶蘑菇交给赞加沼泽孢子村中的姆希菲。‡帶10個白閃菇到贊格沼澤給斯博格爾的米斯恩。',
  }
},
[9809] = {
  {
    'Mais chapéus-opalinos‡Нужно больше грибов!‡Noch mehr Glühkappen‡초롱버섯 추가 수집‡Más fluochampiñones‡Más fluochampiñones‡Plus de chapeluisants‡更多亮顶蘑菇‡更多白閃菇',
    nil,
    '‡Если у тебя есть еще огнешляпки, я бы взял. Нашей деревне они всегда пригодятся.‡Wenn Ihr noch mehr Glühkappen habt, nehme ich sie Euch gerne ab. Unser Dorf kann sie immer gut gebrauchen.‡‡‡‡Je vous prendrai tous les chapeluisants que vous pourrez trouver. Notre village en a toujours besoin.‡‡',
  }
},
[9810] = {
  {
    'Espírito poluído‡Оскверненный дух‡Der verschmutzte Geist‡오염된 영혼‡El espíritu contaminado‡El espíritu contaminado‡L\'esprit pollué‡污染的灵魂‡被污染的靈魂',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua a Essência Poluída de Watoosun e 8 Irrompedores do Lago.‡Уничтожьте загрязненную сущность Ватусана и 10 озерных волноплесков по просьбе повелителя cтихий Ло\'апа.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr Watoosuns verschmutzte Essenz und 10 Seewoger tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 와투순의 오염된 정수와 굽이치는 호수 정령 8마리를 처치해 달라고 했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la esencia contaminada de Watoosun y 10 mareas del lago.‡‡L’Elémentaliste Lo’ap, au Trône des éléments, en Nagrand, veut que vous détruisiez l’Essence polluée de Watoosun et 8 Surgisseurs du lac.‡杀死瓦图苏的污染精华和10个湖水涌动者，然后向纳格兰元素王座的元素师鲁艾普复命。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀瓦吐森的污染精華和10個湖水元素。',
  }
},
[9811] = {
  {
    'Amigo dos Sin\'dorei‡Друг син\'дорай‡Freund der Sin\'dorei‡신도레이의 친구‡Amigos de los sin\'dorei‡Amigos de los sin\'dorei‡L\'amitié des Sin\'dorei‡辛多雷的朋友‡',
    nil,
    'Leve a Cabeça de Dar\'Khan para Lor\'themar Theron em Luaprata.‡Принесите голову Дар\'Хана Лор\'темару Терону в Луносвет.‡Bringt Dar\'Khans Kopf zu Lor\'themar Theron in Silbermond.‡다르칸을 처치하고 실버문에 있는 로르테마르 테론에게 그 증거를 가져가야 합니다.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron a Ciudad de Lunargenta.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron en la Ciudad de Lunargenta.‡Apportez la Tête de Dar\'Khan à Lor\'themar Theron, à Lune-d\'argent.‡将达尔坎的头颅交给银月城的洛瑟玛·塞隆。‡',
  }
},
[9812] = {
  {
    'Carta para Sylvana‡Посол к Орде‡Gesandter zur Horde‡사절로서 호드에 파견되다‡Enviado de la Horda‡Enviado de la Horda‡Emissaire auprès de la Horde‡部落的特使‡',
    nil,
    'Leve a Carta de Lor\'themar Theron para a Grande Dama Sylvana Correventos na Cidade Baixa, a capital dos Renegados que fica nas Clareiras de Tirisfal.‡Отнесите письмо от Лор\'темара Терона леди Сильване Ветрокрылой в Подгород, столицу Отрекшихся в Тирисфальских лесах.‡Bringt den Brief von Lor\'themar Theron zu Fürstin Sylvanas Windläufer in Unterstadt, der Hauptstadt der Verlassenen in Tirisfal.‡티리스팔 숲에 위치한 포세이큰의 수도인 언더시티로 가서 여군주 실바나스 윈드러너에게 로르테마르 테론의 편지를 전해야 합니다.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Remettez la Lettre de Lor\'themar Theron à dame Sylvanas Coursevent à Fossoyeuse, la capitale des Réprouvés dans les clairières de Tirisfal.‡到提瑞斯法林地去，将洛瑟玛·塞隆的信交给被遗忘者的首都幽暗城中的希尔瓦娜斯·风行者。‡',
  }
},
[9813] = {
  {
    'Encontro com o Chefe Guerreiro‡Встреча с вождем‡Ein Treffen mit dem Kriegshäuptling‡대족장 알현‡Encuentro con el Jefe de Guerra‡Encuentro con el Jefe de Guerra‡Rencontre avec les Orcs‡觐见酋长‡',
    nil,
    'A Grande Dama Sylvana Correventos quer que você leve a Carta Selada por Sylvana para Thrall em Orgrimmar, capital de Durotar.‡Отнесите письмо с печатью Леди Сильваны Ветрокрылой Траллу в Оргриммар, столицу Дуротара.‡Fürstin Sylvanas Windläufer möchte, dass Ihr den Brief mit Sylvanas\' Siegel zu Thrall nach Orgrimmar, Hauptstadt von Durotar, bringt.‡여군주 실바나스 윈드러너가 듀로타의 수도인 오그리마에 있는 스랄에게 실바나스의 인장이 찍힌 편지를 전해 달라고 부탁했습니다.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas a Thrall en Orgrimmar, capital de Durotar.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas al Jefe de Guerra en Orgrimmar, capital de Durotar.‡Dame Sylvanas Coursevent veut que vous remettiez la Lettre scellée par Sylvanas au Haut seigneur Saurcroc, à Orgrimmar, la capitale de Durotar.‡希尔瓦娜斯·风行者要求你将她的密信交给杜隆塔尔首都奥格瑞玛的萨尔。‡',
  }
},
[9814] = {
  {
    'Cogumelos surpresa, cara!‡Грибы-пороховики, слышь?‡Berstkappenpilze, Mann!‡내게 펑갓 버섯을!‡¡Champiñones fulminantes, colega!‡¡Champiñones fulminantes, colega!‡Des têtes-tonnantes, mon pote !‡爆顶蘑菇‡破頂蘑菇，老兄!',
    nil,
    'Traga 6 Cogumelos Surpresa para o Mandingueiro Tor\'gash.‡Принесите знахарю Тор\'геш 6 грибов-пороховиков.‡Bringt Hexendoktor Tor\'gash 6 Berstkappen.‡의술사 토르가쉬에게 펑갓 버섯 6개를 가져가야 합니다.‡Lleva al médico brujo Tor\'gash 6 champiñones fulminantes.‡Lleva al médico brujo Tor\'gash 6 champiñones fulminantes.‡Le sorcier-docteur Tor\'gash veut 6 Têtes-tonnantes.‡将6枚爆顶蘑菇交给巫医托尔加什。‡幫巫醫·托卡斯帶6個破頂蘑菇來。',
  }
},
[9815] = {
  {
    'Chafurda mais um pouco‡Грязные делишки‡Schlammtauchen‡진흙으로 잠수‡Bucear en lodo‡Bucear en lodo‡Un plongeon dans la boue‡潜水‡摧毀菌體',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você recolha 5 Núcleos Lamacentos.‡Принесите повелителю стихий Ло\'апу к Трону стихий в Награнде 5 ядер порождений грязи.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr 5 schlammbesudelte Kerne besorgt.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 진흙 덮인 핵 5개를 찾아달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que consigas 5 núcleos de lodo.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que consigas 5 núcleos de lodo.‡L\'Elémentaliste Lo\'ap, au Trône des éléments, en Nagrand, veut que vous récupériez 5 Noyaux couverts de boue.‡将5个沾满淤泥的核心交给纳格兰元素王座的元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你取得5個浮泥核心。',
  }
},
[9816] = {
  {
    'Já viu um desses?‡Видали вы такое?‡Habt Ihr sowas schon mal gesehen?‡요렇게 예쁜 멀록을 본 적 있나?‡Mascotas adorables‡Mascotas adorables‡Ouvrez, ouvrez la cage aux…‡你见过鱼人吗？‡你看過他們嗎?',
    nil,
    'Leve a Gaiola de Murloc e ponha-a na pedra lisa perto da Aldeia Lamadaga.‡Отнесите клетку с мурлоками в деревню Остротопь и оставьте ее на плоском камне.‡Bringt den Murlockäfig nach Dolchfenn und stellt ihn auf den flachen Stein in der Nähe des Dorfs.‡멀록 우리를 가지고 가서 비수늪 마을의 평평한 바위 위에 놓아야 합니다.‡Coloca la jaula de múrlocs en la piedra plana cerca de la Aldea Dagapantano.‡Coloca la jaula de múrlocs en la piedra plana cerca de la Aldea Dagapantano.‡Prenez la Cage à Murlocs et posez-la sur le rocher plat, près de Tourbedague.‡将鱼人笼放在匕潭村附近的平坦的岩石上。‡帶著魚人鐵籠並將它放在匕首沼地村附近的平坦岩石上。',
  }
},
[9817] = {
  {
    'Líder dos Sangrescama‡Глава клана Кровавой Чешуи‡Anführerin der Blutschuppen‡피비늘일족의 지도자‡Líder de los Escamas de Sangre‡Líder de los Escamas de Sangre‡Le chef des Écailles-sanglantes‡血鳞纳迦的领袖‡血鱗領導者',
    nil,
    'Mate Rajis Fyashe no Lago Serpente e fale com o Guardião Hamoot no Refúgio Cenariano, no Pântano Zíngaro, para receber a recompensa.‡Убейте раджис Фьяше в Змеином озере и вернитесь к стражу Хамуту в Кенарийский приют в Зангартопи, чтобы получить награду.‡Tötet Rajis Fyashe am Schlangensee und kehrt dann zu Aufseher Hamuht in der Zuflucht des Cenarius in den Zangarmarschen zurück, um eine Belohung zu erhalten.‡물갈퀴 호수에 있는 라지스 피아쉬를 처치한 후, 장가르 습지대의 세나리온 야영지에 있는 감시자 하무트에게 돌아가서 보상을 받아야 합니다.‡Mata a Rajis Fyashe en el Lago Serpiente y ve a ver al celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar para obtener la recompensa.‡Mata a Rajis Fyashe en el Lago Serpiente y ve a ver al celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar para obtener la recompensa.‡Tuez Rajis Fyashe au Lac des Serpents et revenez voir le gardien Hamoot au refuge cénarien dans le marécage de Zangar pour recevoir votre récompense.‡杀死毒蛇湖的弗亚希王女，然后返回赞加沼泽的塞纳里奥庇护所，向监护者哈穆特领取奖赏。‡殺了毒蛇之湖的納吉斯·法亞司再回到贊格沼澤的塞納里奧避難所找守望者漢姆特領取獎勵。',
  }
},
[9818] = {
  {
    'O subterrâneo‡Из глубин‡Im Untergrund‡지하에서...‡Bajo la tierra‡Bajo la tierra‡Les entrailles de la terre‡地下的滋扰‡地底之下',
    nil,
    'Comunique-se com ele.‡Поговорите с Гордаугом.‡Kommuniziert mit Gordawg.‡고르다우그과 대화하십시오.‡Comunícate con Gordawg.‡Comunícate con Gordawg.‡Communiquer avec Gordawg.‡与戈达乌沟通。‡和葛爾道格溝通。',
  }
},
[9819] = {
  {
    'Terra atormentada‡Истерзанные духи земли‡Die gequälte Erde‡고통받는 대지‡La tierra torturada‡La tierra torturada‡La terre torturée‡被折磨的地灵‡痛苦的大地',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua 10 Espíritos Telúricos Atormentados.‡Уничтожьте 15 истерзанных духов земли.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr 15 gequälte Erdgeister tötet.‡나그란드의 정령의 옥좌에 있는 고르다우그가 고통받는 대지의 정령 15마리를 해치워 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que destruyas a 15 espíritus de tierra torturados.‡‡Gordawg, du Trône des Éléments en Nagrand, vous a demandé de détruire 10 Esprits de la terre torturés.‡纳格兰元素王座的戈达乌要你消灭15个被折磨的地灵。‡納葛蘭，元素王座的葛爾道格要你去摧毀15個痛苦的大地之靈。',
  }
},
[9820] = {
  {
    'PROCURA-SE: Chefe Grog\'ak‡РАЗЫСКИВАЕТСЯ: Главарь Грог\'ак‡GESUCHT: Boss Grog\'ak‡현상 수배: 우두머리 그록아크‡SE BUSCA: jefe Grog\'ak‡SE BUSCA: Jefe Grog\'ak‡ON RECHERCHE : Boss Grog\'ak‡通缉：格罗阿克‡懸賞:葛洛卡老大',
    nil,
    'Traga a Cabeça do Chefe Grog\'ak para o Caçador Sombrio Denjai, em Zabra\'jin.‡Принесите голову главаря Грог\'ака темному охотнику Денжаю в Забра\'джин.‡Bringt Boss Grog\'aks Kopf zu Schattenjäger Denjai in Zabra\'jin.‡자브라진에 있는 어둠사냥꾼 덴자이에게 우두머리 그록아크의 머리장식을 가져가야 합니다.‡Lleva la cabeza del jefe Grog\'ak al cazador de las Sombras Denjai en Zabra\'jin.‡Lleva la cabeza del jefe Grog\'ak al cazador de las Sombras Denjai en Zabra\'jin.‡Le chasseur des ombres Denjai, de Zabra\'jin, veut que vous lui apportiez la Tête du boss Gorg\'ak.‡将格罗阿克的头颅交给萨布拉金的暗影猎手德恩加。‡將葛洛卡老大的頭顱帶給薩布拉金的暗影獵人丹傑。',
  }
},
[9821] = {
  {
    'Comendo para a condenação‡Попробовать зло на зуб‡Verdammnis schmecken‡저주를 먹는 자‡Comiendo condenación‡Comiendo condenación‡Damnation au menu‡吞食诅咒‡吃掉精髓',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você lhe traga 10 Núcleos de Esmagador Enfurecido.‡Принесите Гордаугу к Трону стихий 15 средоточий разъяренных сокрушителей.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr ihm 15 Kerne eines wütenden Zermalmers bringt.‡나그란드의 정령의 옥좌에 있는 고르다우그가 분노한 우레정령의 핵 10개를 가져다 달라고 했습니다.‡Gordawg en El Trono de los Elementos, en Nagrand, te ha pedido que le lleves 15 núcleos de trituradores iracundos.‡‡Gordawg, au Trône des éléments, en Nagrand, vous a demandé de lui apporter 10 Noyaux d\'écraseur enragé.‡将15块被激怒的碾压者的核心交给纳格兰元素王座的戈达乌。‡納葛蘭，元素王座的葛爾道格要你幫他帶回15個暴怒的粉碎者精髓。',
  }
},
[9822] = {
  {
    'Ataque iminente‡Угроза нападения‡Drohender Angriff‡임박한 공격‡Ataque inminente‡Ataque inminente‡Une attaque imminente‡战斗迫近‡逼近的攻擊',
    nil,
    'Traga o Plano de Ataque Ango\'rosh para o Caçador Sombrio Denjai, em Zabra\'jin.‡Принесите планы нападения клана Анго\'рош темному охотнику Денжаю в Забра\'джин.‡Bringt die Angriffspläne der Ango\'rosh zu Schattenjäger Denjai in Zabra\'jin.‡자브라진에 있는 어둠사냥꾼 덴자이에게 앙고로쉬 공격 계획서를 가져가야 합니다.‡Lleva los planes de ataque de Ango\'rosh al cazador de las Sombras Denjai en Zabra\'jin.‡Lleva los planes de ataque de Ango\'rosh al cazador de las Sombras Denjai en Zabra\'jin.‡Le chasseur des ombres Denjai, de Zabra’jin, veut que vous lui apportiez les Plans d’attaque des Ango’rosh.‡将安葛洛什攻击计划交给交给萨布拉金的暗影猎手德恩加。‡將安格拉斯攻擊計畫帶回薩布拉金給暗影獵人丹傑。',
  }
},
[9823] = {
  {
    'Nós ou eles‡Мы и они‡Sie oder wir‡결전의 순간‡Nosotros o ellos‡Nosotros o ellos‡Eux ou nous‡你死我活‡不是你死就是我活',
    nil,
    'Mate o Lorde Supremo Punho de Sangue, 10 Espancadores Ango\'rosh, 10 Devoralmas Ango\'rosh e fale com o Caçador Sombrio Denjai, em Zabra\'jin.‡Убейте властителя Кровавого Кулака, 10 извергов из клана Анго\'рош и 10 пожирателей душ из клана Анго\'рош и вернитесь к темному охотнику Денжаю в Забра\'джин.‡Tötet Oberanführer Schmetterfaust, 10 Raufer der Ango\'rosh, 10 Seelenfresser der Ango\'rosh und meldet Euch dann bei Schattenjäger Denjai in Zabra\'jin zurück.‡대군주 고어피스트, 앙고로쉬일족 싸움꾼 10마리, 앙고로쉬일족 영혼착취자 10마리를 해치운 후 자브라진에 있는 어둠사냥꾼 덴자이에게 돌아가서 보고해야 합니다.‡Mata al Señor Supremo Puño Sajante, 10 aplastadores Ango\'rosh y 10 devoralmas Ango\'rosh y preséntate ante el cazador de las Sombras Denjai en Zabra\'jin.‡Mata al señor supremo Puño Sajante, 10 aplastadores Ango\'rosh y 10 devoralmas Ango\'rosh y preséntate ante el cazador de las Sombras Denjai en Zabra\'jin.‡Tuez le Suzerain Poing-sanglant, 10 Marteleurs Ango\'rosh et 10 Mangeurs-d\'âmes Ango\'rosh, et faites votre rapport au chasseur des ombres Denjai à Zabra\'jin.‡杀死戈尔费斯大王、10个安葛洛什殴斗者和10个安葛洛什食魂者，完成任务后向萨布拉金的暗影猎手德恩加复命。‡殺了血拳主宰，10個安格拉斯蠻槌兵，和10個安格拉斯噬魂者再向薩布拉金的暗影獵人丹傑回報。',
  }
},
[9824] = {
  {
    'Perturbações arcanas‡Колебания тайной магии‡Arkane Störungen‡발산되는 비전의 힘‡Alteraciones arcanas‡Alteraciones arcanas‡Troubles arcaniques‡奥术扰动‡秘法干擾',
    nil,
    'Use o Cristal Violeta da Vidência perto de fontes subterrâneas de água no Porão do Senhorio e, depois, fale novamente com o Arquimago Alturus nos arredores de Karazhan.‡Активируйте кристалл ясновидения Аметистового Ока рядом с подземными источниками вод в Хозяйском погребе и вернитесь к верховному магу Альтуру, находящемуся у входа в Каражан.‡Benutzt den violetten Aufzeichnungskristall in der Nähe von unterirdischen Wasserquellen im Keller des Meisters und kehrt zu Erzmagier Alturus außerhalb von Karazhan zurück.‡지배자의 지하실에 있는 지하 수원 근처에서 보랏빛 수정구슬을 사용한 후 카라잔 밖에 있는 대마법사 알투루스에게 돌아가야 합니다.‡Utiliza el cristal de visión violeta cerca de fuentes subterráneas de agua en El Sótano del Maestro y vuelve a ver al archimago Alturus en las afueras de Karazhan.‡Utiliza el cristal de visión violeta cerca de fuentes subterráneas de agua en El Sótano del Maestro y vuelve a ver al archimago Alturus en las afueras de Karazhan.‡Utilisez le Cristal de divination pourpre près des sources d\'eau souterraines dans la Cave du maître, puis retournez voir l\'archimage Alturus à l\'extérieur de Karazhan.‡在麦迪文的酒窖内的地下水源附近使用紫罗兰占卜水晶，然后向卡拉赞外的大法师奥图鲁斯复命。‡到大師的地窖，在靠近地下水源的地方使用紫羅蘭占卜水晶再回到卡拉贊外面的大法師艾特羅斯那裡。',
  }
},
[9825] = {
  {
    'Atividade incessante‡Неустанный труд‡Rastlose Aktivität‡끊임없는 유령의 활동‡Actividad incansable‡Actividad incansable‡L\'agitation des sans-repos‡幽灵的活动‡不安的活動',
    nil,
    'Leve 10 Essências Fantasmagóricas para o Arquimago Alturus nos arredores da torre de Karazhan.‡Принесите 10 призрачных сущностей верховному магу Альтуру, находящемуся у входа в Каражан.‡Bringt 10 geisterhafte Essenzen zu Erzmagier Alturus außerhalb von Karazhan.‡카라잔 밖에 있는 대마법사 알투루스에게 유령의 정수 10개를 가져가야 합니다.‡Lleva 10 esencias fantasmales al archimago Alturus en las afueras de Karazhan.‡Lleva 10 esencias fantasmales al archimago Alturus en las afueras de Karazhan.‡Apportez 10 Essences fantomatiques à l\'Archimage Alturus, à l\'extérieur de Karazhan.‡将10个幽灵精华交给卡拉赞外的大法师奥图鲁斯。‡帶10個鬼魅精華給卡拉贊外面的大法師艾特羅斯。',
  }
},
[9826] = {
  {
    'Contato de Dalaran‡Вести из Даларана‡Dalarankontaktpersonen‡달라란에서의 전갈‡Contacto de Dalaran‡Contacto de Dalaran‡Un envoyé de Dalaran‡联络达拉然‡達拉然的聯繫',
    nil,
    'Leve o Relatório de Alturus para o Arquimago Cedric nos arredores da Cratera de Dalaran.‡Доставьте письмо Альтура верховному магу Седрику на окраину Даларана.‡Bringt Alturus\' Bericht zu Erzmagier Cedric am Rande von Dalaran.‡달라란 구덩이 외곽에 있는 대마법사 세드릭에게 알투루스의 보고서를 가져가야 합니다.‡Lleva el informe de Alturus al archimago Cedric en la afueras de Dalaran.‡‡Apportez le Rapport d’Alturus à l’Archimage Cédric, à la périphérie du Cratère de Dalaran.‡将奥图鲁斯的报告交给达拉然外的大法师塞德瑞克。‡將艾特羅斯的報告帶給達拉然郊區的大法師賽卓克。',
  }
},
[9827] = {
  {
    'Basídio definhado‡Высохшая базидия‡Siechendes Basidium‡말라붙은 담자기‡Basidio marchito‡Basidio marchito‡Le baside racorni‡枯萎的孢芽‡枯萎的孢子臺',
    nil,
    'Leve o Basídio Definhado para Ruam em Telredor.‡Отнесите высохшую базидию Руаму в Телредор.‡Bringt das siechenden Basidium zu Ruam in Telredor.‡텔레도르에 있는 루암에게 말라붙은 담자기를 가져가야 합니다.‡Lleva el basidio marchito a Ruam en Telredor.‡‡Apportez le Baside racorni à Ruam à Telredor.‡将枯萎的孢芽交给泰雷多尔的鲁埃姆。‡將枯萎的孢子臺帶到泰倫多爾給洛安瑪。',
  }
},
[9828] = {
  {
    'Basídio definhado‡Высохшая базидия‡Siechendes Basidium‡말라붙은 담자기‡Basidio marchito‡Basidio marchito‡Le baside racorni‡枯萎的孢芽‡枯萎的孢子臺',
    nil,
    'Leve o Basídio Definhado para Reavij no Mocó do Rato Lamacento.‡Отнесите высохшую базидию Реавижу на заставу Болотной Крысы.‡Bringt das siechende Basidium zu Reavij im Sumpfrattenposten.‡늪쥐 감시초소에 있는 레아비즈에게 말라붙은 담자기를 가져가야 합니다.‡Lleva el basidio marchito a Reavij en la Avanzada Rata del Pantano.‡‡Apportez le Baside racorni à Reavij au poste du Rat des marais.‡将枯萎的孢芽交给沼泽鼠岗哨的里维伊。‡將枯萎的孢子臺帶到斯溫派特崗哨給瑞伏基。',
  }
},
[9829] = {
  {
    'Hadggar‡Кадгар‡Khadgar‡카드가‡Khadgar‡‡Khadgar‡卡德加‡卡德加',
    nil,
    'Entregue o Relatório de Alturus para Hadggar, em Shattrath, que fica na Mata Terokkar.‡Доставьте письмо Альтура Кадгару в Шаттрат - город в лесу Тероккар.‡Bringt Alturus\' Bericht zu Khadgar in Shattrath in den Wäldern von Terokkar.‡테로카르 숲의 샤트라스에 있는 카드가에게 알투루스의 보고서를 전달해야 합니다.‡Lleva el informe de Alturus a Khadgar en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Lleva el informe de Alturus a Khadgar en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Remettez le Rapport d’Alturus à Khadgar, à Shattrath, dans la forêt de Terokkar.‡将奥图鲁斯的报告交给泰罗卡森林中沙塔斯城的卡德加。‡將艾特羅斯的報告送到泰洛卡森林給撒塔斯城的卡德加。',
  }
},
[9830] = {
  {
    'Peçonha do sangrador‡Яд паразита‡Blutergift‡반딧불이 독‡Veneno letal‡Veneno letal‡Venin d\'aiguillonneur‡沼泽中的毒液‡刺針毒素',
    nil,
    'Traga 6 Peçonhas de Sangrador Pantanoso para Puluu no Porto Orebor.‡Принесите 6 порций яда болотного паразита Пулуу в прибежище Оребор.‡Bringt 6 Einheiten Sumpflichtblutergift zu Puluu in der Oreborzuflucht.‡오레보르 피난처에 있는 풀루우에게 흡혈 수렁등불 반딧불이 독 6개를 가져가야 합니다.‡Lleva 6 unidades de veneno de sangrador Luz pantanosa a Puluu en el Puerto Orebor.‡Lleva 6 unidades de veneno de sangrador Luz pantanosa a Puluu en el Puerto Orebor.‡Apportez 6 doses de Venin de suce-sang des Furoles à Puluu, au Havre d’Orebor.‡将6份沼光抽血者的毒液交给奥雷柏尔营地的普尔鲁。‡帶6份沼光流血者毒囊給奧雷伯爾港的保魯。',
  }
},
[9831] = {
  {
    'Entrando em Karazhan‡Вход в Каражан‡Nach Karazhan‡카라잔으로...‡La entrada a Karazhan‡La entrada a Karazhan‡L\'entrée de Karazhan‡卡拉赞的钥匙‡卡拉贊的入口',
    nil,
    'Hadggar quer que você entre no Labirinto Soturno em Auchindoun e recupere o Primeiro Fragmento de Chave de um Recipiente Arcano escondido lá.‡Пройдите в Темный Лабиринт в Аукиндоне, найдите там волшебный контейнер и возьмите из него первый фрагмент ключа, после чего вернитесь к Кадгару.‡Khadgar möchte, dass Ihr das Schattenlabyrinth von Auchindoun betretet und das erste Schlüsselfragment aus einem versteckten arkanen Behälter besorgt.‡카드가가 아킨둔의 어둠의 미궁으로 들어가서 그곳에 숨겨진 마법 단지에서 첫 번째 열쇠 조각을 꺼내오라고 부탁했습니다.‡Khadgar quiere que entres en el Laberinto de las Sombras en Auchindoun y recuperes el primer trozo de la llave de un contenedor arcano que está escondido allí.‡Khadgar quiere que entres en el Laberinto de las Sombras en Auchindoun y recuperes el primer trozo de la llave de un contenedor arcano que está escondido allí.‡Khadgar veut que vous entriez dans le Labyrinthe des Ombres d\'Auchindoun pour récupérer le Premier fragment de la clé, dans le Récipient arcanique qui y est caché.‡卡德加要求你进入奥金顿的暗影迷宫中，回收储藏在那里的一个奥术容器中的第一块钥匙碎片。‡卡德加要你進入奧齊頓的暗影迷宮並從藏在那裡的秘法容器取得第一塊鑰匙碎片。',
  }
},
[9832] = {
  {
    'O segundo e o terceiro fragmentos‡Второй и третий фрагменты‡Das zweite und das dritte Fragment‡두 번째와 세 번째 조각‡El segundo y tercer trozo‡El segundo y tercer trozo‡Le deuxième et le troisième fragments‡第二块和第三块‡第二和第三個碎片',
    nil,
    'Obtenha o Segundo Fragmento de Chave de um Recipiente Arcano no Reservatório Presacurva, e o Terceiro Fragmento de Chave de um Recipiente Arcano na Bastilha da Tormenta. Fale novamente com Hadggar, em Shattrath, quando completar a tarefa.‡Добудьте второй фрагмент ключа из волшебного контейнера в резервуаре Кривого Клыка, а третий фрагмент ключа – из волшебного контейнера в Крепости Бурь, после чего вернитесь к Кадгару в Шаттрат.‡Besorgt das zweite Schlüsselfragment aus einem arkanen Behälter im Echsenkessel und das dritte Schlüsselfragment aus einem arkanen Behälter in der Festung der Stürme. Kehrt dann zu Khadgar in Shattrath zurück.‡갈퀴송곳니 저수지 안의 마법 단지에서 두 번째 열쇠 조각을, 폭풍우 요새 내부의 마법 단지에서 세 번째 열쇠 조각을 찾아야 합니다. 모두 찾은 후 샤트라스에 있는 카드가에게 돌아가십시오.‡Consigue el segundo trozo de la llave, que está en un contenedor arcano en la Reserva Colmillo Torcido, y el tercer trozo de la llave, que está en otro contenedor arcano en El Castillo de la Tempestad. Vuelve a ver a Khadgar en la Ciudad de Shattrath cuando lo hayas hecho.‡Consigue el segundo trozo de la llave, que está en un contenedor arcano en la Reserva Colmillo Torcido, y el tercer trozo de la llave, que está en otro contenedor arcano en El Castillo de la Tempestad. Vuelve a ver a Khadgar en la Ciudad de Shattrath cuando lo hayas hecho.‡Trouver le Deuxième fragment de la clé dans un récipient arcanique à l’intérieur du Réservoir de Glissecroc, et le Troisième fragment de la clé dans un récipient arcanique au Donjon de la tempête. Une fois que ce sera fait, revenir auprès de Khadgar à Shattrath.‡从盘牙水库内的一个奥术容器中拿到第二块钥匙碎片，从风暴要塞内的一个奥术容器中拿到第三块钥匙碎片。任务完成之后向沙塔斯城的卡德加复命。‡在盤牙蓄湖的秘法容器裡取得第二塊鑰匙碎片，風暴要塞的秘法容器裡取得第三塊鑰匙碎片。完成任務後回到撒塔斯城的卡德加那裡。',
  }
},
[9833] = {
  {
    'Linhas de comunicação‡Линии связи‡Verbesserung der Kommunikation‡연락망‡Líneas de comunicación‡Líneas de comunicación‡Les lignes de communication‡通讯路线‡溝通管道',
    nil,
    'Puluu em Porto Orebor quer que você mate 12 Fatiadores Presamangue.‡Убейте 12 болотных терзателей по просьбе Пулуу из прибежища Оребор.‡Puluu in der Oreborzuflucht möchte, dass Ihr 12 Marschenfangschlitzer tötet.‡오레보르 피난처에 있는 풀루우가 칼날턱 늪송곳니 가오리 12마리를 처치해 달라고 부탁했습니다.‡Puluu, en el Puerto Orebor quiere que mates 12 cercenadores Colmillo de la marisma.‡Puluu, en el Puerto Orebor quiere que mates 12 cercenadores Colmillo de la Marisma.‡Puluu, du Havre d’Orebor, veut que vous tuiez 12 Trancheurs Croc-du-marais.‡奥雷柏尔营地的普尔鲁要你杀死12个沼牙切割者。‡奧雷伯爾港的保魯要你去殺死12個沼牙分割者。',
  }
},
[9834] = {
  {
    'Armadura natural‡Природная броня‡Natürliche Rüstung‡자연의 갑옷‡Armadura natural‡Armadura natural‡Une armure naturelle‡天然的护甲‡自然護甲',
    nil,
    'Traga 8 Couros de Garrocharco para Maktu no Porto Orebor.‡Принесите 8 шкур болотных твердозубов Макту в прибежище Оребор.‡Bringt 8 Fennklauenbälge zu Maktu in der Oreborzuflucht.‡오레보르 피난처에 있는 막투에게 늪발톱 히드라 가죽 8개를 가져가야 합니다.‡Lleva 8 pellejos de Zarpacieno a Maktu en el Puerto Orebor.‡Lleva 8 pellejos de Zarpacieno a Maktu en el Puerto Orebor.‡Apportez 8 Peaux de tourbegriffes à Maktu au Havre d’Orebor.‡将8张泥爪皮交给奥雷柏尔营地的玛克图。‡帶8塊沼爪皮給奧雷伯爾港的瑪克吐。',
  }
},
[9835] = {
  {
    'Transgressão Ango\'rosh‡Вторжение клана Анго\'рош‡Vordringen der Ango\'rosh‡앙고로쉬의 침략‡Invasión de los Ango\'rosh‡Invasión de los Ango\'rosh‡Les empiètements des Ango\'rosh‡安葛洛什的威胁‡安格拉斯入侵',
    nil,
    'Mate 10 Ogros Ango\'rosh e 5 Xamãs Ango\'rosh e fale novamente com Ikuti, em Porto Orebor.‡Убейте 10 огров из клана Анго\'рош и 5 шаманов из клана Анго\'рош и вернитесь к Икути в прибежище Оребор.‡Tötet 10 Oger der Ango\'rosh und 5 Schamanen der Ango\'rosh und kehrt dann zu Ikuti in der Oreborzuflucht zurück.‡앙고로쉬 오우거 10마리, 앙고로쉬일족 주술사 5마리를 처치한 후 오레보르 피난처에 있는 이쿠티에게 돌아가야 합니다.‡Mata 10 ogros Ango\'rosh y 5 chamanes Ango\'rosh. Después vuelve a ver a Ikuti en el Puerto Orebor.‡Mata 10 ogros Ango\'rosh y 5 chamanes Ango\'rosh. Después vuelve a ver a Ikuti en el Puerto Orebor.‡Tuez 10 Ogres Ango\'rosh et 5 Chamans Ango\'rosh, puis retournez voir Ikuti au Havre d\'Orebor.‡杀死10个安葛洛什食人魔和5个安葛洛什萨满祭司，然后返回奥雷柏尔营地向伊库提复命。‡殺死10個安格拉斯巨魔和5個安格拉斯薩滿再回到奧雷伯爾港的伊庫堤那裡。',
  }
},
[9836] = {
  {
    'O toque do mestre‡Разрешение учителя‡Die Berührung des Meisters‡메디브와의 만남‡El toque del maestro‡El toque del maestro‡Le toucher du maître‡麦迪文的触摸‡大師之觸',
    nil,
    'Vá até as Cavernas do Tempo e convença Medivh a habilitar a Chave Restaurada do Aprendiz.‡Отправляйтесь в Пещеры Времени и уговорите Медива дать разрешение на использование Восстановленного ключа.‡Geht in die Höhlen der Zeit und überzeugt Medivh davon, den wiederhergestellten Schlüssel des Lehrlings zu aktivieren.‡시간의 동굴 안에 들어간 후 메디브를 설득하여 복원된 수습생의 열쇠를 활성화해야 합니다.‡Ve a las Cavernas del Tiempo y convence a Medivh para que active tu llave de aprendiz restaurada.‡Ve a las Cavernas del Tiempo y convence a Medivh para que active tu llave de aprendiz restaurada.‡Rendez-vous aux Grottes du temps et persuadez Medivh d’accepter votre Clé de l’apprenti réparée.‡进入时光之穴，说服麦迪文让复原的学徒钥匙重新获得打开卡拉赞大门的能力。‡進入時光之穴說服麥迪文讓復原的初生之鑰恢復能力。',
  }
},
[9837] = {
  {
    'Retorne a Hadggar‡Возвращение к Кадгару‡Rückkehr zu Khadgar‡‡Khadgar de nuevo‡Regresa junto a Khadgar‡Retour vers Khadgar‡返回卡德加身边‡回到卡德加那裡',
    nil,
    'Fale novamente com Hadggar em Shattrath e mostre a Chave do Mestre.‡Вернитесь в Шаттрат к Кадгару и покажите ему хозяйский ключ.‡Kehrt zu Khadgar in Shattrath zurück und zeigt ihm den Schlüssel des Meisters.‡‡Vuelve a ver a Khadgar en la Ciudad de Shattrath y enséñale la llave del maestro.‡Vuelve a ver a Khadgar en la Ciudad de Shattrath y enséñale la llave del maestro.‡Retournez voir Khadgar à Shattrath, et montrez-lui à la Clé du maître.‡将麦迪文的钥匙交给沙塔斯城的卡德加。‡回到撒塔斯城的卡德加那裡並給他大師之鑰。',
  }
},
[9838] = {
  {
    'O Olho Violeta‡Аметистовое Око‡Das Violette Auge‡보랏빛 눈‡El Ojo Violeta‡El Ojo Violeta‡L’Œil pourpre‡紫罗兰之眼‡紫羅蘭之眼',
    nil,
    'Fale com o Arquimago Alturus nos arredores de Karazhan.‡Поговорите с верховным магом Альтуром, который находится снаружи Каражана.‡Sprecht mit Erzmagier Alturus außerhalb von Karazhan.‡카라잔 밖에 있는 대마법사 알투루스와 대화해야 합니다.‡Habla con el archimago Alturus fuera de Karazhan.‡Habla con el archimago Alturus fuera de Karazhan.‡Parlez à l\'archimage Alturus à l\'extérieur de Karazhan.‡与卡拉赞外的大法师奥图鲁斯谈一谈。‡和卡拉贊外的大法師艾特羅斯談談。',
  }
},
[9839] = {
  {
    'Lorde Supremo Punho de Sangue‡Властитель Кровавый Кулак‡Oberanführer Schmetterfaust‡대군주 고어피스트‡Señor Supremo Puño Sajante‡Señor supremo Puño Sajante‡Le suzerain Poing-sanglant‡戈尔费斯大王‡血拳主宰',
    nil,
    'Ikuti quer que você mate o Lorde Supremo Punho de Sangue e 10 Espancadores Ango\'rosh. Fale novamente com Ikuti no Porto Orebor, uma vez que tenha completado a tarefa.‡Убейте властителя Кровавого Кулака и 10 извергов из клана Анго\'рош по просьбе Икути. Выполнив задачу, вернитесь в прибежище Оребор.‡Ikuti möchte, dass Ihr Oberanführer Schmetterfaust und 10 Raufer der Ango\'rosh tötet. Kehrt zur Oreborzuflucht zurück, wenn Ihr die Aufgabe erfüllt habt.‡대군주 고어피스트와 앙고로쉬일족 싸움꾼 10마리를 처치한 후 오레보르 피난처에 있는 이쿠티에게 돌아가야 합니다.‡Ikuti quiere que mates al Señor Supremo Puño Sajante y a 10 aplastadores Ango\'rosh. Vuelve al Puerto Orebor cuando hayas completado la tarea.‡Ikuti quiere que mates al señor supremo Puño Sajante y a 10 aplastadores Ango\'rosh. Vuelve al Puerto Orebor cuando hayas completado la tarea.‡Ikuti veut que vous tuiez le Suzerain Poing-sanglant et 10 Marteleurs Ango’rosh. Lorsque vous aurez terminé cette quête, retournez au Havre d’Orebor.‡杀死戈尔费斯大王和10个安葛洛什殴斗者，完成任务后向奥雷柏尔营地的伊库提复命。‡伊庫堤要你去殺了血拳主宰和10個安格拉斯蠻槌兵。完成任務後回到奧雷伯爾港。',
  }
},
[9840] = {
  {
    'Avaliando a situação‡Оценка ситуации‡Einschätzung der Situation‡내부 상황 파악‡Evaluando la situación‡Evaluando la situación‡Évaluer la situation‡评估事态‡評估狀況',
    nil,
    'Encontre Koren dentro de Karazhan.‡Найдите Корена в Каражане.‡Findet Koren in Karazhan.‡카라잔 안에 있는 코렌을 찾아야 합니다.‡Encuentra a Koren en Karazhan.‡Encuentra a Koren en Karazhan.‡Trouvez Koren à l\'intérieur de Karazhan.‡进入卡拉赞寻找库雷恩。‡找到卡拉贊裡的卡爾侖。',
  }
},
[9841] = {
  {
    'Aguilhoando aguilhantes‡Поделом гнусным тварям!‡Tückische Mücken‡벌처럼 쏘라‡Aguijoneando los aguijoneros‡Aguijoneando los aguijoneros‡Aiguillonner les dards‡清除沼光抽血者‡以牙還牙',
    nil,
    'Mate 8 Sangradores Pantanosos e fale novamente com Gambarinka, em Zabra\'jin.‡Убейте 8 болотных паразитов и вернитесь к Гамбаринке в Забра\'джин.‡Tötet 8 Sumpflichtbluter und kehrt dann zu Gambarinka in Zabra\'jin zurück.‡흡혈 수렁등불 반딧불이 8마리를 해치운 후 자브라진에 있는 감바린카에게 돌아가십시오.‡Mata 8 sangradores Luz Pantanosa y vuelve a ver a Gambarinka en Zabra\'jin.‡Mata 8 sangradores Luz Pantanosa y vuelve a ver a Gambarinka en Zabra\'jin.‡Tuez 8 Suce-sang des furoles et retournez voir Gambarinka à Zabra\'jin.‡杀死8个沼光抽血者，然后向萨布拉金的加巴林卡复命。‡殺死8個沼光流血者再回薩布拉金的坎巴利卡那裡。',
  }
},
[9842] = {
  {
    'As mais afiadas lâminas‡Острейшие резцы‡Die schärfsten Klingen‡최고로 날카로운 칼날턱‡Las hojas más afiladas‡Las hojas más afiladas‡Les lames les mieux affûtées‡最锋利的刀刃‡最鋒利的劍',
    nil,
    'Traga 10 Lâminas de Corte Presamangue para Gambarinka, em Zabra\'jin.‡Принесите 10 зубов болотного терзателя Гамбаринке в Забра\'джине.‡Bringt 10 Marschenfangschlitzerklingen zu Gambarinka in Zabra\'jin.‡자브라진에 있는 감바린카에게 늪송곳니 가오리 칼날턱 10개를 가져가야 합니다.‡Lleva 10 hojas de cercenadores Colmillo de la marisma a Gambarinka en Zabra\'jin.‡Lleva 10 hojas de cercenadores Colmillo de la Marisma a Gambarinka en Zabra\'jin.‡Apportez 10 Lames de trancheurs Croc-du-marais à Gambarinka à Zabra\'jin.‡将10柄沼牙切割者之刃交给萨布拉金的加巴林卡。‡帶10把沼牙分割者之刃給薩布拉金的坎巴利卡。',
  }
},
[9843] = {
  {
    'Anotações de Keanna‡Записи Кинны‡Keannas Aufzeichnungen‡킨나의 기록‡Los apuntes de Keanna‡Los apuntes de Keanna‡Le journal de Keanna‡金娜的日记‡琪安娜的日誌',
    nil,
    'Vasculhe os Quartos de Hóspedes em Karzhan, encontre as Anotações de Keanna e leve-as para o Arquimago Alturus fora de Karazhan.‡Найдите Гостевые залы в Каражане, а в них - записи Кеанны, и доставьте их верховному магу Альтуру.‡Durchsucht die Gästezimmer in Karazhan nach Keannas Aufzeichnungen und bringt sie zu Erzmagier Alturus außerhalb von Karazhan.‡카라잔 안에 있는 객실을 뒤져서 킨나의 기록을 찾은 후 카라잔 밖에 있는 대마법사 알투루스에게 가져가야 합니다.‡Busca los apuntes de Keanna en Los Aposentos de los Invitados, en Karazhan, y llévaselos al archimago Alturus fuera de Karazhan.‡Busca los apuntes de Keanna en Los Aposentos de los Invitados, en Karazhan, y llévaselos al archimago Alturus fuera de Karazhan.‡Fouillez les Appartements des hôtes à l\'intérieur de Karazhan à la recherche du Journal de Keanna, et apportez-le à l\'archimage Alturus à l\'extérieur de Karazhan.‡在卡拉赞的会客间搜寻金娜的日记，然后将它交给卡拉赞外的大法师奥图鲁斯。‡',
  }
},
[9844] = {
  {
    'Uma presença demoníaca‡Присутствие демонов‡Eine dämonische Präsenz‡불타는 군단의 첩자‡Una presencia demoníaca‡Una presencia demoníaca‡Une présence démoniaque‡恶魔的气息‡惡魔存在',
    nil,
    'O Arquimago Alturus quer que você destrua a Presença Demoníaca no topo da torre de Karazhan.‡Верховный маг Альтур просит вас уничтожить демона на вершине башни Каражана.‡Erzmagier Alturus möchte, dass Ihr die dämonische Präsenz an der Turmspitze von Karazhan zerstört.‡대마법사 알투루스가 카라잔의 꼭대기에 있는 불타는 군단의 첩자를 처치해 달라고 했습니다.‡El archimago Alturus quiere que destruyas la presencia demoníaca de la parte superior de Karazhan.‡El archimago Alturus quiere que destruyas la presencia demoníaca de la parte superior de Karazhan.‡L\'Archimage Alturus veut que vous détruisiez la Présence démoniaque au sommet de Karazhan.‡大法师奥图鲁斯要求你消灭出现在卡拉赞顶部的恶魔。‡',
  }
},
[9845] = {
  {
    'Lançando a isca para a vitória‡Не распугивайте рыбу!‡Anglerunglück‡낚시터 수호‡Competición de pesca‡Competición de pesca‡À la pêche aux ennuis‡下钩钓鱼‡擊敗釣魚者的對手',
    nil,
    'Mate 10 Espancadores Garrocharcos e fale novamente com Zurjaya, em Zabra\'jin.‡Убейте 10 болотных твердозубов и вернитесь к Зурджайе в Забра\'джин.‡Tötet 10 Fennklauenhauer und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡무쇠꼬리 늪발톱 히드라 10마리를 해치운 후 자브라진에 있는 주르자야에게 돌아가십시오.‡Mata 10 vándalos Zarpacieno y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata 10 descarnadores Zarpacieno y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez 10 Vandales tourbegriffe, puis retournez voir Zurjaya à Zabra\'jin.‡杀死10个泥爪毁坏者，然后向萨布拉金的苏尔加亚复命。‡殺死10個沼爪痛擊者再回到薩布拉金的祖賈亞那裡。',
  }
},
[9846] = {
  {
    'Espíritos do Charco das Feras‡Духи Дикотопи‡Geister der Wildfenn‡야생늪일족의 정령‡Espíritus de los Feropantanos‡Espíritus de los Feropantanos‡Esprits des Tourbe-farouche‡蛮沼之灵‡菲拉芬靈魂',
    nil,
    'Traga 10 Totens Protetores do Charco das Feras para a Vidente Janidi, em Zabra\'jin.‡Принесите 10 тотемов-хранителей Дикотопи ясновидящей Джаниди в Забра\'джин.‡Bringt 10 Schutztotems von Wildfenn zu Seherin Janidi in Zabra\'jin.‡자브라진에 있는 현자 자니디에게 야생늪일족 가호의 토템 10개를 가져가야 합니다.‡Entrega 10 tótems de protección Feropantano al vidente Janidi en Zabra\'jin.‡Entrega 10 tótems de protección Feropantano al vidente Janidi en Zabra\'jin.‡Apportez 10 Totems de protection Tourbe-farouche au prophète Janidi à Zabra\'jin.‡将10根蛮沼保护图腾交给萨布拉金的先知亚尼迪。‡帶10個菲拉芬防護圖騰給薩布拉金的先知賈尼迪。',
  }
},
[9847] = {
  {
    'Um espírito aliado?‡Дух-союзник?‡Ein verbündeter Geist?‡영혼과 동맹을?‡¿Un espíritu aliado?‡¿Un espíritu aliado?‡Un esprit allié ?‡灵魂之盟？‡靈魂助手?',
    nil,
    'Leve o Totem do Charco das Feras até os pés das escadas das Ruínas de Boha\'mu e ponha-o no chão. Relate suas descobertas para a Vidente Janidi, em Zabra\'jin.‡Отнесите тотем Дикотопи к подножию лестницы руин Боха\'му и установите его на землю. Расскажите о том, что вы видели, ясновидящей Джаниди в Забра\'джине.‡Bringt das Wildfenntotem an den Fuß der Treppe in den Ruinen von Boha\'mu und verankert es im Boden. Berichtet Seherin Janidi in Zabra\'jin von Euren Beobachtungen.‡야생늪일족 토템을 가지고 보하무 폐허의 계단 맨 아래로 가서 토템을 설치해야 합니다. 그런 다음 자브라진의 현자 자니디에게 가서 발견한 내용을 보고하십시오.‡Lleva el Tótem Feropantano hasta el pie de las escaleras de las Ruinas Boha\'mu y colócalo en el suelo. Informa sobre tus descubrimientos al vidente Janidi en Zabra\'jin.‡Lleva el Tótem Feropantano hasta el pie de las escaleras de las Ruinas Boha\'mu y colócalo en el suelo. Informa sobre tus descubrimientos al vidente Janidi en Zabra\'jin.‡Plantez le totem Tourbe-farouche dans le sol au pied de l’escalier des ruines de Boha’mu. Ensuite, allez raconter vos découvertes à la Prophétesse Janidi, à Zabra’jin.‡前往博哈姆废墟，将蛮沼图腾插在台阶底部的地面上。然后返回萨布拉金，向先知亚尼迪汇报你的发现。‡帶著菲拉芬圖騰到波哈姆廢墟的樓梯底部並將它插在地上。將你的發現回報給薩布拉金的先知賈尼迪。',
  }
},
[9848] = {
  {
    'Segredos do povo Lamadaga‡Тайны Остротопи‡Geheimnisse des Dolchfennstamms‡비수늪의 비밀‡Secretos de los Dagapantano‡Secretos de los Dagapantano‡Les secrets des Tourbedagues‡匕潭的秘密‡匕首沼地的秘密',
    nil,
    'Traga o Manual de Venenos Lamadaga e a Ampola de Veneno lamadaga para Timóteo Dinis em Porto Orebor.‡Принесите справочник по ядам Остротопи и фиал яда Остротопи Тимоти Даниэльсу в прибежище Оребор.‡Bringt das Gifthandbuch von Dolchfenn und eine Giftphiole von Dolchfenn zu Timothy Daniels in der Oreborzuflucht.‡오레보르 피난처에 있는 티모시 다니엘에게 비수늪일족 독 조제법과 비수늪일족 독병을 가져가야 합니다.‡Lleva el manual de venenos de Dagapantano y un Vial de veneno de Dagapantano a Timothy Daniels en el Puerto Orebor.‡Lleva el manual de venenos de Dagapantano y un Vial de veneno de Dagapantano a Timothy Daniels en el Puerto Orebor.‡Timothy Daniels, du Havre d\'Orebor, veut que vous lui rameniez le Manuel de poison Tourbedague et une Fiole de poison Tourbedague.‡将匕潭毒药手册和一只匕潭毒药瓶交给奥雷柏尔营地的迪莫斯·丹尼斯。‡將匕首沼地毒藥手冊和匕首沼地毒藥瓶帶給奧雷伯爾港的提莫斯·丹尼爾。',
  }
},
[9849] = {
  {
    'Despedaçando o véu‡Сорвать личину‡Die Maskerade durchschauen‡파괴된 비밀의 장막‡Rompiendo el velo‡Rompiendo el velo‡Briser le voile‡打碎外壳‡粉碎外表',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua 30 Lacaios de Gurok.‡Убейте 30 прислужников Гурока.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr 30 Diener von Gurok tötet.‡나그란드의 정령의 옥좌에 있는 고르다우그가 구로크의 하수인 30마리를 해치워 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand te ha pedido que mates a 30 esbirros de Gurok.‡Gordawg de El Trono de los Elementos en Nagrand te ha pedido que mates a 30 esbirros de Gurok.‡Gordawg, du Trône des éléments en Nagrand, vous a demandé de tuer 30 Serviteurs de Gurok.‡纳格兰元素王座的戈达乌要你杀死30个古罗克的爪牙。‡納葛蘭，元素王座的葛爾道格要你殺死30個古羅克的爪牙。',
  }
},
[9850] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Mate 12 Fenocerontes Adultos e conte a Rosarães Guima, no Safári Rosarães, em Nagrand, sobre a sua proeza.‡Убейте 30 копытней-быков и вернитесь к Хемингу Эрнестуэю в его охотничий лагерь в Награнде.‡Tötet 30 Grollhufbullen und sprecht anschließend mit Hemet Nesingwary bei Nesingwarys Safari in Nagrand, um Euer Jagdgeschick zu beweisen.‡수컷 갈래발굽 30마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 당신의 사냥 실력을 보여줘야 합니다.‡Mata a 30 uñagrietas dominantes y ve a hablar con Hemet Nesingwary en el Safari Nesingwary, en Nagrand, sobre tu progreso.‡‡Tuez 12 Étalons sabots-fourchus, puis allez raconter vos exploits à Hemet Nesingwary, au safari de Nesingwary en Nagrand.‡杀死30头裂蹄公牛，然后向纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里复命。‡殺死30隻公裂蹄再到納葛蘭和奈辛瓦里狩獵的赫米特·奈辛瓦里談談你的本領。',
  }
},
[9851] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Pegue o Chifre de Banthar e fale novamente com Rosarães Guima, no Safári Rosarães, em Nagrand.‡Добудьте рог Бантар и отнесите его Хемингу Эрнестуэю в лагерь Эрнестуэя в Награнде.‡Erlangt das Horn von Banthar und kehrt anschließend zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand zurück.‡나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 반타르의 뿔을 가져가야 합니다.‡Consigue el cuerno de Banthar y llévaselo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Consigue el cuerno de Banthar y llévaselo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Hemet Nesingwary, du safari de Nesingwary en Nagrand, veut que vous lui rameniez la Corne de Banthar.‡将班塔尔的犄角交给纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里。‡取得班薩爾之角再回到納葛蘭找奈辛瓦里狩獵隊的赫米特·奈辛瓦里。',
  }
},
[9852] = {
  {
    'O vale-tudo de sangue‡Опасный спорт‡Die ultimative Beute‡궁극의 사냥감‡El deporte sangriento definitivo‡El deporte sangriento definitivo‡Le plus gros des gibiers‡终极挑战‡最後的浴血之戰',
    nil,
    'Entregue o Coração de Colmilhã para Rosarães Guima no Safári Rosarães, em Nagrand.‡Принесите сердце Клыкач Хемингу Эрнестуэю в его лагерь в Награнде.‡Bringt das Herz von Zahna zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand.‡나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 뿔어금니 심장을 가져가야 합니다.‡Lleva el corazón de Colmillo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Lleva el corazón de Eburnia a Hemet Nesingwary en el Safari de Nesingwary, en Nagrand.‡Apportez le Cœur de Longues-défenses à Hemet Nesingwary au safari de Nesingwary en Nagrand.‡将塔丝克之心交给纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里。‡將長牙之心帶到納葛蘭交給奈辛瓦里狩獵的赫米特·奈辛瓦里。',
  }
},
[9853] = {
  {
    'Gurok, o Usurpador‡Гурок Узурпатор‡Gurok der Thronräuber‡강탈자 구로크‡Gurok el Usurpador‡Gurok el Usurpador‡Gurok l\'Usurpateur‡侵占者古罗克‡『篡位者』古羅克',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua Gurok, o Usurpador e lhe traga a Cabeça Terrena de Gurok.‡Убейте Гурока Узурпатора и принесите его голову Гордаугу к Трону стихий.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr Gurok den Thronräuber zerstört und Guroks irdenen Kopf besorgt.‡나그란드의 정령의 옥좌에 있는 고르다우그가 강탈자 구로크를 해치우고 구로크의 바위머리를 가져다 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que destruyas a Gurok el Usurpador y le lleves la cabeza terránea de Gurok.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que destruyas a Gurok el Usurpador y le lleves la cabeza terránea de Gurok.‡Gordawg, du Trône des éléments en Nagrand, vous a demandé de détruire Gurok l’Usurpateur et de lui ramener la Tête de terre de Gurok.‡杀死侵占者古罗克，将古罗克的头颅交给纳格兰元素王座的戈达乌。‡納葛蘭，元素王座的葛爾道格要你殺了『篡位者』古羅克並將古羅克的大地頭盔帶回來。',
  }
},
[9854] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Mate 12 Rocas-dos-ventos e fale novamente com o Fio no Safári Rosarães, em Nagrand.‡Убейте 30 ветрухов и вернитесь к Фитцу в охотничий лагерь Эрнестуэя в Награнде.‡Tötet 30 Windrocs und kehrt dann zu Fitz bei Nesingwarys Safari in Nagrand zurück.‡바람올빼미 30마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 피츠에게 돌아가야 합니다.‡Mata 30 vientorrocs y después vuelve a ver a Fitz en el Safari Nesingwary de Nagrand.‡‡Tuez 30 Venterocs et retournez voir Fitz au safari de Nesingwary en Nagrand.‡杀死30只风鹏，然后向纳格兰奈辛瓦里狩猎队营地的"好儿子"沙度·远行者复命。‡殺死30隻風翼貓頭鷹再回到納葛蘭找奈辛瓦里狩獵隊的費茲。',
  }
},
[9855] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Cace 12 Rocas-dos-ventos Vorazes e fale novamente com Fio no Safári Rosarães, em Nagrand.‡Добудьте 30 прожорливых ветрухов и вернитесь к Фитцу в лагерь Эрнестуэя в Награнде.‡Tötet 30 gefräßige Windrocs und kehrt dann zu Fitz in Nesingwarys Safari in Nagrand zurück.‡굶주린 바람올빼미 30마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 피츠에게 돌아가야 합니다.‡Caza 30 vientorrocs voraces y regresa entonces junto a Fitz en el Safari Nesingwary de Nagrand.‡‡Abattez 12 Venterocs voraces, puis retournez voir Fitz au safari de Nesingwary en Nagrand.‡杀死30只饥饿的风鹏，然后向纳格兰奈辛瓦里狩猎队营地的"好儿子"沙度·远行者复命。‡獵殺30隻飢餓的風翼貓頭鷹再回到納葛蘭找奈辛瓦里狩獵隊的費茲。',
  }
},
[9856] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Traga o Olho da Rancatripa para o Fio no Safári Rosarães, em Nagrand.‡Принесите глаз Потрошительницы Фитцу в охотничий лагерь Эрнестуэя в Награнде.‡Bringt das Auge von Aaskralle zu Fitz in Nesingwarys Safari in Nagrand.‡나그란드의 네싱워리 탐험대에 있는 피츠에게 굶주린 검은갈고리의 눈을 가져가야 합니다.‡Lleva el ojo de Arrancatripas a Fitz al Safari Nesingwary en Nagrand.‡Lleva el ojo de Arrancatripas a Fitz al Safari Nesingwary en Nagrand.‡Fitz, du safari de Nesingwary en Nagrand, veut que vous lui rameniez l\'Œil d\'Arrache-tripes.‡将裂肠者的眼睛交给纳格兰奈辛瓦里狩猎队营地的"好儿子"沙度·远行者。‡將卡特瑞普之眼帶到納葛蘭給奈辛瓦里狩獵隊薩杜費茲。',
  }
},
[9857] = {
  {
    'Proficiência em talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Mate 12 Cervos Talbuque e fale novamente com Manuelzão no Safári Rosarães, em Nagrand.‡Убейте 30 талбуков-самцов и возвращайтесь к Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Tötet 30 Talbukhirsche und kehrt dann zu Harold Fährten bei Nesingwarys Safari in Nagrand zurück.‡줄무늬 탈부크 30마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 돌아가야 합니다.‡Mata 30 venados talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡‡Tuez 30 Cerfs talbuks, puis retournez voir Harold Lane, au safari de Nesingwary en Nagrand.‡杀死30头塔布雄羊，然后向纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩复命。‡殺死30隻塔巴克雄鹿再回到納葛蘭找奈辛瓦里狩獵隊的哈爾歐德·蘭恩。',
  }
},
[9858] = {
  {
    'Proficiência em talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Mate 12 Talbuques Comespinho e fale novamente com Manuelzão no Safári Rosarães, em Nagrand.‡Убейте 30 талбуков-шипоедов и возвращайтесь к Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Erlegt 30 Talbukdornzehrer und kehrt dann zu Harold Fährten bei Nesingwarys Safari in Nagrand zurück.‡가시먹이 탈부크 30마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 돌아가야 합니다.‡Caza 30 raspaespinas talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡‡Chassez 12 Talbuks Broutépine, puis retournez voir Harold Lane, au safari de Nesingwary en Nagrand.‡杀死30头塔布羊食棘者，然后向纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩复命。‡獵捕30隻塔巴克食棘者再回到納葛蘭找奈辛瓦里狩獵隊的哈爾歐德·蘭恩。',
  }
},
[9859] = {
  {
    'Mestre dos talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Consiga o Casco de Bach\'lor e entregue-o para Manuelzão, no Safári Rosarães, em Nagrand.‡Добудьте копыто Хол\'стяка и принесите его Гарольду Лейну в охотничий лагерь Эрнестуэя в Награнде.‡Besorgt den Huf von Bach\'lor und bringt ihn zu Harold Fährten bei Nesingwarys Safari in Nagrand.‡바취로의 발굽을 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 가져가야 합니다.‡Consigue la pezuña de Bach\'lor y llévasela a Harold Sendero, en el Safari Nesingwary, en Nagrand.‡Consigue la pezuña de Bach\'lor y llévasela a Harold Sendero, en el Safari Nesingwary, en Nagrand.‡Récupérez le Sabot de Bach\'lor et remettez-le à Harold Lane, au safari de Nesingwary en Nagrand.‡将巴克洛尔的蹄子交给纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩。‡取得巴奇洛爾之蹄並帶回納葛蘭交給奈辛瓦里狩獵隊的哈爾歐德·蘭恩。',
  }
},
[9860] = {
  {
    'A nova diretriz‡Новое направление‡Neue Anweisungen‡새로운 지령‡La nueva directiva‡La nueva directiva‡La nouvelle directive‡新的指示‡',
    nil,
    'Fale com o Arquimago Cedric nos arredores da Cratera de Dalaran.‡Поговорите с верховным магом Седриком на окраине Даларана.‡Sprecht mit Erzmagier Cedric am Rande von Dalaran.‡달라란 구덩이 외곽에 있는 대마법사 세드릭과 대화해야 합니다.‡Habla con el archimago Cedric en las afueras del Cráter Dalaran.‡‡Parlez à l’Archimage Cédric à la périphérie du Cratère de Dalaran.‡与达拉然巨坑外的大法师塞德瑞克谈一谈。‡',
  }
},
[9861] = {
  {
    'Ventos uivantes‡Вой-Ветер‡Der heulende Wind‡울부짖는 바람‡El viento aullador‡El viento aullador‡Le vent hurlant‡呼嚎之风‡哀嚎之風',
    nil,
    'Encontre alguém no Trono dos Elementos que fale kalimaico e mostre-lhe o Vento Uivante.‡Разыщите у Трона стихий кого-нибудь, кто знает язык калимаг, и покажите ему или ей Вой-Ветра.‡Sucht beim Thron der Elemente nach jemandem, der Kalimag sprechen kann und zeigt der Person den heulenden Wind.‡정령의 옥좌에서 칼리마그 말을 할 줄 아는 이를 찾아서 울부짖는 바람을 보여주어야 합니다.‡Ve a El Trono de los Elementos, encuentra a alguien que hable Kalimag y enséñale el viento aullador.‡Ve a El Trono de los Elementos, encuentra a alguien que hable Kalimag y enséñale el viento aullador.‡Trouvez quelqu\'un qui parle le kalimag au Trône des éléments et montrez-lui le Vent hurlant.‡返回元素王座寻找某个会讲古卡利姆多语的人，将呼嚎之风交给他。‡在元素王座找到會講卡林多語的人再讓他看看哀嚎之風。',
  }
},
[9862] = {
  {
    'Corruptores Sangue-de-lodo‡Разлагатели Темной Крови‡Bösewichte der Finsterblut‡수렁피일족 파괴자‡Corruptores Sangreoscura‡Corruptores Sangreoscura‡Les corrupteurs bourbesang‡暗血腐蚀者‡黑暗之血腐敗者',
    nil,
    'O Elementalista Morgh, do Trono dos Elementos, em Nagrand, quer que você mate 5 Putrefadores Sangue-de-lodo.‡Убейте 8 разлагателей из племени Темной Крови по просьбе повелителя стихий Морха, находящегося у Трона стихий.‡Elementarist Morgh beim Thron der Elemente in Nagrand möchte, dass Ihr 8 Läuterer der Finsterblut tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 모르그가 수렁피일족 파괴자 8명을 해치워 달라고 부탁했습니다.‡El elementalista Morgh en El Trono de los Elementos, en Nagrand, quiere que mates 8 putrefactores Sangreoscura.‡‡L’élémentaliste Morgh, du Trône des éléments en Nagrand, veut que vous tuiez 5 Putréfacteurs bourbesang.‡纳格兰元素王座的元素师莫格要你杀死8个暗血净化者。‡納葛蘭，元素王座的元素師莫夫要你去殺死8個黑暗之血腐化者。',
  }
},
[9863] = {
  {
    'Idolatria vil‡Вражеские святыни‡Abscheulicher Götzendienst‡타락한 우상 숭배‡Idolatría vil‡Idolatría vil‡Vile idolâtrie‡邪恶的信仰‡邪惡的塑像',
    nil,
    'O Clarividente Kurkush, de Garadar, em Nagrand, quer que você lhe traga 10 Ídolos Sangue-de-lodo.‡Принесите 20 идолов племени Темной Крови предсказателю Куркушу в Гарадар.‡Weissager Kurkush in Garadar in Nagrand möchte, dass Ihr ihm 20 Finsterblutgötzen bringt.‡나그란드의 가라다르에 있는 선견자 쿠르쿠쉬가 수렁피 우상 20개를 가져다 달라고 부탁했습니다.‡El clarividente Kurkush en Garadar, en Nagrand, quiere que le lleves 20 ídolos Sangreoscura.‡‡Le long-voyant Kurkush, de Garadar en Nagrand, veut que vous lui rameniez 20 Idoles bourbesang.‡将20个暗血神像交给纳格兰加拉达尔的先知古库斯。‡納葛蘭，卡拉達爾的先知可庫許要你幫他帶來20個黑暗之血塑像。',
  }
},
[9864] = {
  {
    'O destacamento perdido‡Пропавший отряд‡Der verschollene Kampftrupp‡사라진 전투 부대‡El destacamento de guerra desaparecido‡El destacamento de guerra desaparecido‡La troupe manquante‡失踪的战斗小队‡失蹤的戰友',
    nil,
    'Encontre o destacamento de Garadar.‡Отыщите пропавший гарадарский отряд.‡Sucht den verschollenen Kriegstrupp von Garadar.‡실종된 가라다르 전투 부대를 찾아야 합니다.‡Intenta encontrar el destacamento de guerra de Garadar desaparecido.‡Intenta encontrar el destacamento de guerra de Garadar desaparecido.‡Tentez de retrouver la troupe de Garadar manquante.‡找到失踪的加拉达尔战斗小队。‡試著找到失蹤的卡拉達爾戰友。',
  }
},
[9865] = {
  {
    'Seu nome era vingança‡Да, были воины в наше время...‡Chroniken eines Kriegers‡한때는 전사였지만...‡Su nombre era Venganza‡Su nombre era Venganza‡L\'âme des guerriers‡我们曾是战士‡一朝為戰士',
    nil,
    'Mate 20 Catadores Sangue-de-lodo e 10 Saqueadores Sangue-de-lodo.‡Убейте 40 падальщиков из племени Темной Крови и 20 налетчиков из племени Темной Крови.‡Tötet 40 Strauchdiebe der Finsterblut und 20 Räuber der Finsterblut.‡수렁피 청소부 20명, 수렁피 약탈자 10명을 처치해야 합니다.‡Mata a 40 carroñeros y a 20 asaltantes Sangreoscura.‡‡Tuez 20 Charognards bourbesang et 10 Écumeurs bourbesang.‡消灭40个暗血清道夫和20个暗血掠夺者。‡殺死40個黑暗之血拾荒者以及20個黑暗之血劫掠者。',
  }
},
[9866] = {
  {
    'Ele vai correr o mundo...‡Он будет странствовать по земле...‡Weiter...‡대지를 향해 나아가는 자...‡Recorrerá la tierra...‡Recorrerá la tierra...‡Et il parcourra la Terre...‡他要游历世界......‡他將走遍大地……',
    nil,
    'Relate a notícia para o Clarividente Corhuk em Garadar.‡Доставьте известие предсказателю Корхуку в Гарадар.‡Bringt die Nachricht zu Weissager Corhuk in Garadar.‡가라다르에 있는 선견자 코르후크에게 소식을 전해야 합니다.‡Da la noticia al clarividente Corhuk en Garadar.‡Da la noticia al clarividente Corhuk en Garadar.‡Apportez la nouvelle au Long-voyant Corhuk, à Garadar.‡返回加拉达尔，将消息告诉先知考尔胡克。‡將消息送給卡拉達爾的先知科霍克。',
  }
},
[9867] = {
  {
    'Chefes Sangue-de-lodo...‡Главари Темной Крови‡Anführer der Finsterblut...‡수렁피 지휘관...‡Los jefes Sangreoscura‡Los jefes Sangreoscura‡Les chefs Bourbesang...‡暗血领袖‡黑暗之血領導者……',
    nil,
    'O Clarividente Margadesh, de Garadar, em Nagrand, quer que você lhe traga a Cabeça de Ortor Sangue-de-lodo.‡Принесите предсказателю Маргадешу в Гарадар голову Ортора Темной Крови.‡Bringt Ortor von Finsterbluts Kopf zu Weissager Margadesh in Garadar in Nagrand.‡나그란드의 가라다르에 있는 선견자 마르가데쉬가 수렁피일족의 오르토르를 처치하고 그 증거를 가져오라고 부탁했습니다.‡El clarividente Margadesh de Garadar, en Nagrand, quiere que le lleves la cabeza de Ortor de Sangreoscura.‡El clarividente Margadesh de Garadar, en Nagrand, quiere que le lleves la cabeza de Ortur de Sangreoscura.‡Le long-voyant Margadesh à Garadar en Nagrand veut que vous lui rameniez la Tête d\'Ortor de Bourbesang.‡将暗血酋长奥托尔的头颅交给纳格兰加拉达尔的先知玛加迪。‡納葛蘭，卡拉達爾的先知馬卡戴斯要你幫他把黑暗之血奧拓爾的頭顱帶來。',
  }
},
[9868] = {
  {
    'O totem de Kar\'dash‡Тотем Кардаша‡Das Totem von Kar\'dash‡카르다쉬의 토템‡El tótem de Kar\'dash‡El tótem de Kar\'dash‡Le totem de Kar\'dash‡卡达什图腾‡卡達許圖騰',
    nil,
    'Escolte o Cativo Mag\'har para fora do Posto Solavera. Caso você consiga, fale com Garrosh, em Garadar.‡Помогите пленному маг\'хару бежать с заставы Солнечного Источника. Расскажите Гаррошу в Гарадаре обо всем, что вам удалось узнать.‡Begleitet den festgehaltenen Mag\'har aus dem Sonnenwindposten hinaus. Sprecht mit Garrosh in Garadar, wenn Ihr erfolgreich wart.‡태양여울 주둔지에 있는 마그하르 포로를 구출해야 합니다. 성공하면 가라다르에 있는 가로쉬와 대화하십시오.‡Ayuda al cautivo Mag\'har a salir del Puesto Primasol. Después ve a hablar con Garrosh a Garadar.‡Ayuda al cautivo Mag\'har a salir del Puesto Primasol. Después ve a hablar con Garrosh a Garadar.‡Escortez le Captif Mag\'har hors du poste de Berceau-de-l\'été. Si vous y parvenez, allez parler à Garrosh, à Garadar.‡护送玛格汉俘虏逃离日泉岗哨，完成任务后返回加拉达尔，向加尔鲁什复命。‡護送瑪格哈俘虜離開日春崗哨。如果你成功的話就和卡拉達爾的卡爾洛斯談談。',
  }
},
[9869] = {
  {
    'O Trono dos Elementos‡Трон стихий‡Der Thron der Elemente‡정령의 옥좌‡El Trono de los Elementos‡El Trono de los Elementos‡Le Trône des éléments‡元素王座‡元素王座',
    nil,
    'O Elementalista Ioki quer que você vá ao Trono dos Elementos e fale com a Elementalista Sharvak.‡Поговорите с повелительницей стихий Шарвак у Трона стихий.‡Elementarist Ioki möchte, dass Ihr zum Thron der Elemente reist und mit Elementaristin Sharvak sprecht.‡정령술사 아이오키가 정령의 옥좌로 가서 정령술사 샤르바크에게 소식을 전해달라고 부탁했습니다.‡Elementalista Ioki quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡Elementalista Ioki quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡L\'élémentaliste Ioki veut que vous vous rendiez au Trône des éléments et que vous parliez à l\'élémentaliste Sharvak.‡元素师犹基希望你前往元素王座，与元素师沙尔瓦克谈一谈。‡元素師洛奇要你前往元素王座和元素師莎爾瓦克談談。',
  }
},
[9870] = {
  {
    'O Trono dos Elementos‡Трон стихий‡Der Thron der Elemente‡정령의 옥좌‡El Trono de los Elementos‡El Trono de los Elementos‡Le Trône des éléments‡元素王座‡元素王座',
    nil,
    'O Elementalista Yal\'hah quer que você vá ao Trono dos Elementos e fale com a Elementalista Sharvak.‡Поговорите с повелительницей стихий Шарвак у Трона стихий.‡Elementarist Yal\'hah möchte, dass Ihr zum Thron der Elemente reist und mit Elementaristin Sharvak sprecht.‡정령술사 얄하가 정령의 옥좌로 가서 정령술사 샤르바크와 대화해 보라고 부탁했습니다.‡El elementalista Yal\'hah quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡El elementalista Yal\'hah quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡L\'élémentaliste Yal\'hah veut que vous vous rendiez au Trône des éléments et que vous parliez à l\'élémentaliste Sharvak.‡元素师亚尔哈希望你前往元素王座，与元素师沙尔瓦克谈一谈。‡元素師亞哈要你前往元素王座和元素師莎爾瓦克談談。',
  }
},
[9871] = {
  {
    'Invasores Sangue-de-lodo‡Захватчики из племени Темной Крови‡Eindringlinge der Finsterblut‡수렁피일족 침략자‡Invasores Sangreoscura‡Invasores Sangreoscura‡Les envahisseurs bourbesang‡暗血入侵者‡黑暗之血入侵者',
    nil,
    'Entregue os planos de invasão dos Sangue-de-lodo a Arechron, na vila de Telaar, em Nagrand.‡Передайте планы вторжения Темной Крови Арехрону.‡Bringt die Invasionspläne der Finsterblut zu Arechron.‡아레크론에게 수렁피일족 침공 계획서를 가져가야 합니다.‡Lleva los planes de invasión de los Sangreoscura a Arechron.‡‡Apportez les Plans d\'invasion bourbesang à Arechron.‡将暗血入侵计划交给阿雷克隆。‡將黑暗之血攻擊計畫帶給阿爾克隆。',
  }
},
[9872] = {
  {
    'Invasores Sangue-de-lodo‡Захватчики из племени Темной Крови‡Eindringlinge der Finsterblut‡수렁피일족 침략자‡Invasores Sangreoscura‡Invasores Sangreoscura‡Les envahisseurs bourbesang‡暗血入侵者‡黑暗之血入侵者',
    nil,
    'Entregue os planos de invasão dos Sangue-de-lodo para Garrosh.‡Передайте планы вторжения Темной Крови Гаррошу.‡Bringt die Invasionspläne der Finsterblut zu Garrosh.‡가로쉬에게 수렁피일족 침공 계획서를 가져가야 합니다.‡Lleva los planes de invasión Sangreoscura a Garrosh.‡Lleva los planes de invasión Sangreoscura a Garrosh.‡Apportez les Plans d\'invasion bourbesang à Garrosh.‡将暗血入侵计划交给加尔鲁什。‡將黑暗之血攻擊計畫帶給卡爾洛斯。',
  }
},
[9873] = {
  {
    'Ortor, meu velho amigo...‡Ортор, мой старый друг...‡Mein alter Freund Ortor...‡나의 오랜 친구 오르토르‡Mi viejo amigo Ortor‡Mi viejo amigo Ortur‡Ortor, mon vieil ami…‡奥托尔，我的老朋友......‡我的老友奧拓爾……',
    nil,
    'Arechron, da vila de Telaar, em Nagrand, quer que você mate Ortor Sangue-de-lodo.‡Арехрон из Телаара в Награнде поручил вам убить Ортора Темную Кровь.‡Arechron in Telaar in Nagrand möchte, dass Ihr Ortor von Finsterblut tötet.‡나그란드의 텔라아르에 있는 아레크론이 수렁피일족의 오르토르를 처치해 달라고 부탁했습니다.‡Arechron de Telaar, en Nagrand, quiere que mates a Ortor de Sangreoscura.‡Arechron de Telaar, en Nagrand, quiere que mates a Ortur de Sangreoscura.‡Arechron, de Telaar en Nagrand, veut que vous tuiez Ortor de Bourbesang.‡杀死暗血酋长奥托尔，然后向纳格兰塔拉的阿雷克隆复命。‡納葛蘭，泰拉的阿爾克隆要你去殺了黑暗之血奧拓爾。',
  }
},
[9874] = {
  {
    'Cessar a propagação‡Остановить заразу‡Die Ausbreitung eindämmen‡오염 확산 방지‡Deteniendo la propagación‡Deteniendo la propagación‡Arrêter la contamination‡阻止污染‡阻止蔓延',
    nil,
    'Otumbo, o Prudente, da vila de Telaar, em Nagrand, quer que você use a tocha de fogo líquido para destruir 10 cadáveres de habitantes de Solavera. Devolva a tocha de fogo líquido ao completar a tarefa.‡Сожгите 10 трупов жителей заставы Солнечного Источника с помощью факела жидкого огня. Когда исполните поручение, верните факел Отонбу Ведуну.‡Otonbu der Weise in Telaar in Nagrand möchte, dass Ihr die Fackel des flüssigen Feuers benutzt, um 10 Leichen von Bewohnern von Sonnenwind zu zerstören. Bringt die Fackel des flüssigen Feuers zurück, wenn Ihr fertig seid.‡나그란드의 텔라아르에 있는 현자 오톤부가 액화의 횃불을 사용하여 태양여울 마을 주민의 시체 10구를 태워 달라고 부탁했습니다. 일을 마치면 액화의 횃불을 돌려줘야 합니다.‡Otonbu el Sabio de Telaar, en Nagrand, quiere que uses la antorcha de fuego líquido para destruir 10 cadáveres de habitantes de Primasol. Devuélvele la antorcha de fuego líquido cuando hayas terminado.|n‡Otonbu el Sabio de Telaar, en Nagrand, quiere que uses la antorcha de fuego líquido para destruir 10 cadáveres de habitantes de Primasol. Devuélvele la antorcha de fuego líquido cuando hayas terminado.|n‡Otonbu le Sage, à Telaar en Nagrand, veut que vous utilisiez la Torche de feu liquide pour détruire 10 Cadavres de villageois du Berceau-de-l\'été. Lorsque vous aurez terminé, rendez-lui la Torche de feu liquide.‡用魔油火炬烧掉10具日泉村民的遗体，然后向纳格兰塔拉的先知欧图布复命，并归还魔油火炬。‡納葛蘭，泰拉的『賢者』歐塔布要你使用液態火炬摧毀10個日春崗哨居民屍體。完成任務後將液態火炬交回。',
  }
},
[9875] = {
  {
    'Espécie não catalogada‡Неизвестный науке вид‡Nicht katalogisierte Gattung‡미분류된 식물종 전달‡Especie sin catalogar‡Especie sin catalogar‡Une espèce non cataloguée‡未归类的植物‡未編目的品種',
    nil,
    'Leve a Espécie Não Catalogada para Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Принесите неизвестный науке вид Лоранне Тар\'велл в Кенарийский приют в Зангартопи.‡Bringt die nicht katalogisierte Gattung zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 미분류된 식물종을 가져가야 합니다.‡Lleva la especie sin catalogar a Lauranna Thar\'well en el Refugio Cenarion, en la Marisma de Zangar.‡Lleva la especie sin catalogar a Lauranna Thar\'well en el Refugio Cenarion, en la Marisma de Zangar.‡Apportez l\'Espèce non cataloguée à Lauranna Thar\'well au Refuge cénarien dans le marécage de Zangar.‡将未归类的植物交给赞加沼泽塞纳里奥庇护所的劳兰娜·萨维尔。‡將未編目的品種帶到贊格沼澤給塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[9876] = {
  {
    'Incursão fracassada‡Провалившийся рейд‡Fehlgeschlagene Operation‡실패한 조사‡Incursión fallida‡Incursión fallida‡Une incursion manquée‡失踪的先遣队‡入侵失敗',
    nil,
    'Ysiel Cantavento quer que você procure por pistas dos Druidas da Expedição Cenariana perto da entrada do Reservatório Presacurva, no Pântano Zíngaro.‡Отыщите следы друидов из Кенарийской экспедиции у входа в резервуар Кривого Клыка по просьбе Исиэль Песни Ветра.‡Ysiel Windsänger möchte, dass Ihr am Eingang des Echsenkessels nach Lebenszeichen der Druiden der Expedition des Cenarius Ausschau haltet.‡이시엘 윈드싱어가 갈퀴송곳니 저수지 입구 근처에서 세나리온 원정대 드루이드들의 흔적을 찾아 달라고 부탁했습니다.‡Ysiel Vientocantor quiere que busques pistas de los druidas de la Expedición Cenarion cerca de la entrada de la Reserva Colmillo Torcido.‡‡Ysiel Chantelevent veut que vous recherchiez des signes des druides de l\'Expédition cénarienne près de l\'entrée du réservoir de Glissecroc, au Marécage de Zangar.‡伊谢尔·风歌要你前往盘牙水库，在入口附近搜寻塞纳里奥远征队德鲁伊的下落。‡伊斯歐·風歌要你去盤牙蓄湖入口附近尋找塞納里奧遠征隊德魯伊。',
  }
},
[9877] = {
  {
    'Um trago restaurador‡Приводящее в сознание зелье‡Ein Regenerationsgebräu‡복원의 비약‡Una pócima reconstituyente‡Una pócima reconstituyente‡Un breuvage de restauration‡疗伤药膏‡恢復藥劑',
    nil,
    'Fale com o Boticário Reinaldo em Tranquillien.‡Поговорите с аптекарем Рензитеном в Транквиллионе.‡Sprecht mit Apotheker Renzithen in Tristessa.‡트랜퀼리엔에 있는 연금술사 렌지센과 대화하십시오.‡Habla con el boticario Renzithen en Tranquillien.‡Habla con el boticario Renzithen en Tranquillien.‡Parlez à l\'apothicaire Renzithen à Tranquillien.‡与塔奎林的药剂师雷兹特恩谈一谈。‡和安寧地的藥劑師倫澤紳談談。',
  }
},
[9878] = {
  {
    'Resolvendo o problema‡Решение проблемы‡Die Lösung des Problems‡문제 해결‡Resolviendo el problema‡Resolviendo el problema‡La résolution du problème‡解决问题‡解決問題',
    nil,
    'Poli\'lukluk, o Sábio, da vila de Telaar, em Nagrand, quer que você mate 10 carniceiros Sangue-de-lodo e 5 atacantes Sangue-de-lodo.‡Убейте 20 падальщиков и 10 налетчиков из племени Темной Крови.‡Poli\'lukluk der Weisere in Telaar in Nagrand möchte, dass Ihr 20 Strauchdiebe der Finsterblut und 10 Räuber der Finsterblut tötet.‡나그란드의 텔라아르에 있는 대현자 폴리루크루크가 수렁피일족 청소부 20명, 수렁피일족 약탈자 10명을 처치해 달라고 부탁했습니다.‡Poli\'lukluk el Más Sabio en Telaar, en Nagrand, quiere que mates 20 carroñeros Sangreoscura y 10 asaltantes Sangreoscura.‡‡Poli\'lukluk le Malin, de Telaar en Nagrand, veut que vous tuiez 20 Charognards bourbesang et 10 Écumeurs bourbesang.‡消灭20个暗血清道夫和10个暗血掠夺者，然后向纳格兰塔拉的智者普里鲁鲁克复命。‡納葛蘭，泰拉的『智者』寶利露克露克要你殺死20個黑暗之血食腐者和10個黑暗之血劫掠者。',
  }
},
[9879] = {
  {
    'O totem de Kar\'dash‡Тотем Кардаша‡Das Totem von Kar\'dash‡카르다쉬의 토템‡El Tótem de Kar\'dash‡El tótem de Kar\'dash‡Le totem de Kar\'dash‡卡达什图腾‡卡達許圖騰',
    nil,
    'Escolte o Kurenai Cativo para fora de Posto Sol Nascente. Caso você consiga, fale com Arechron, na vila de Telaar.‡Помогите куренайскому пленнику бежать с заставы Солнечного Источника. Расскажите Арехрону из Телаара обо всем, что вам удалось узнать.‡Begleitet den gefangenen Kurenai aus dem Sonnenwindposten. Sprecht mit Arechron in Telaar, wenn Ihr erfolgreich wart.‡태양여울 주둔지에 있는 쿠레나이 포로를 호위한 후, 텔라아르에 있는 아레크론과 대화해야 합니다.‡Escolta al cautivo Kurenai hasta salir del Puesto Primasol. Ve a hablar con Arechron en Telaar si tienes éxito.‡Escolta al cautivo Kurenai hasta salir del Puesto Primasol. Ve a hablar con Arechron en Telaar si tienes éxito.‡Escortez le Captif kurenaï hors du poste de Berceau-de-l\'été. Si vous y parvenez, allez parler à Arechron, à Telaar.‡护送库雷尼俘虏逃离日泉岗哨，完成任务后返回塔拉，向阿雷克隆复命。‡護送卡爾奈俘虜離開日春崗哨。成功後再和泰拉的阿爾克隆談談。',
  }
},
[9880] = {
  {
    '‡‡‡‡‡‡‡‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap',
    nil,
    nil,
  }
},
[9881] = {
  {
    '‡‡‡‡‡‡‡‡Hellfire Penninsula: -pn - H - ToWoW - Hellfire Turnin Cap',
    nil,
    nil,
  }
},
[9882] = {
  {
    'Roubando de ladrões‡Украсть у вора‡Von Dieben stehlen‡빠른 출발‡Robar a los ladrones‡Robar a los ladrones‡Voler les voleurs‡偷盗贼的东西......能算偷么？‡偷小偷的東西',
    nil,
    'Recolha 10 Fragmentos de Cristal de Oshu\'gun e leve-os para Gezhe, no Posto Aeris, em Nagrand.‡Раздобудьте 10 осколков кристалла Ошу\'гуна и отдайте их Гезхе в Небесном лагере в Награнде.‡Besorgt 10 Kristallfragmente von Oshu\'gun und bringt sie zu Gezhe am Aerissteg in Nagrand.‡오슈군 결정 조각 10개를 찾아서 나그란드의 에어리스 착륙지에 있는 게제에게 가져가야 합니다.‡Consigue 10 trozos de cristal de Oshu\'gun y llévaselos a Gezhe en el Desembarco Aeris, en Nagrand.‡Consigue 10 trozos de cristal de Oshu\'gun y llévaselos a Gezhe en el Desembarco Aeris, en Nagrand.‡Procurez-vous 10 Fragments de cristal d’Oshu’gun et remettez-les à Gezhe, au Point d\'ancrage Aeris en Nagrand.‡将10块沃舒古水晶碎片交给纳格兰埃瑞斯码头的杰赫。‡取得10個歐夏剛水晶碎片並帶到納葛蘭交給艾瑞斯平臺的吉札。',
  }
},
[9883] = {
  {
    'Mais fragmentos de cristal‡Снова осколки кристалла‡Noch mehr Kristallfragmente‡수정 조각 추가 수집‡Más trozos de cristal‡Más trozos de cristal‡Encore des fragments de cristal‡更多水晶碎片‡更多水晶碎片',
    nil,
    'Você conseguiu mais fragmentos de cristal? Veja bem se você não está pegando os que ainda estão presos à montanha. Não queremos criar problemas com os naarus.‡‡‡‡‡‡‡‡',
  }
},
[9884] = {
  {
    'Benefícios para associados‡Выгодное сотрудничество‡Mitgliedervorteil‡회원 특전‡Beneficios de los miembros‡Beneficios de los miembros‡Les avantages des membres‡会员的奖励‡會員福利',
    nil,
    'The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡',
  }
},
[9885] = {
  {
    'Benefícios para associados‡Выгодное сотрудничество‡Mitgliedervorteil‡회원 특전‡Beneficios de los miembros‡Beneficios de los miembros‡Les avantages des membres‡会员的奖励‡會員福利',
    nil,
    'The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡',
  }
},
[9886] = {
  {
    'Benefícios para associados‡Выгодное сотрудничество‡Mitgliedervorteil‡회원 특전‡Beneficios de los miembros‡Beneficios de los miembros‡Les avantages des membres‡会员的奖励‡會員福利',
    nil,
    'The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡Das Konsortium ist dafür bekannt, dass es sich gut um seine Freunde kümmert. Zu Beginn jeden Monats werde ich Euch ein paar Edelsteine als Bezahlung für Eure Dienste geben.nnDie Qualität der Steine hängt davon ab, wie treu ergeben Ihr uns wart. Lasst uns also hoffen, dass Ihr das Richtige tut und bei uns bleibt.‡‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡',
  }
},
[9887] = {
  {
    'Benefícios para associados‡Выгодное сотрудничество‡Mitgliedervorteil‡회원 특전‡Beneficios de los miembros‡Beneficios de los miembros‡Les avantages des membres‡会员的奖励‡會員福利',
    nil,
    'The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡The Consortium is well known for taking good care of its friends. At the beginning of each month I\'ll have some gems ready for you as payment for your services.nnThe quality of the gems you get will depend on how loyal you\'ve been to us. Here\'s to hoping you do the smart thing and stay with us.‡‡‡‡',
  }
},
[9888] = {
  {
    'O líder impotente‡Слабосильный владыка‡Der unfähige Anführer‡무능력한 지도자‡El líder impotente‡El líder impotente‡Le chef impuissant‡落魄的领袖‡無能的領導者',
    nil,
    'Jorin Olho Morto quer que você encontre e fale com Kilrath.‡Джорин Мертвый Глаз просит вас найти Килрата и поговорить с ним.‡Jorin Totauge möchte, dass Ihr Kilrath sucht und mit ihm sprecht.‡요린 데드아이가 킬라스를 찾아서 대화해 보라고 부탁했습니다.‡Jorin Mortojo te ha pedido que encuentres a Kilrath.‡Jorin Mortojo te ha pedido que encuentres a Kilrath.‡Jorin Œil-mort vous a demandé de trouver Kilrath et de lui parler.‡约林·死眼要你找到吉尔拉斯并跟他谈谈。‡喬林·亡眼要你找到科伊瑞斯並和他談談。',
  }
},
[9889] = {
  {
    'Não mate o gordo‡Толстяка не убивать‡Nicht den Fetten töten!‡뚱뚱한 놈은 죽이지 마세요!‡No mates al gordo‡No mates al gordo‡Ne tuez pas le gros‡别杀那个胖家伙！‡別殺那個胖子',
    nil,
    'Kilrath, da Mata Terokkar, quer que você mate 10 Invasores Punho de Pedra e bata em Unkor, o Desapiedado, até que ele fale.‡Убейте 10 захватчиков из клана Тяжелого Кулака, затем избейте и допросите Анкора Безжалостного.‡Kilrath in den Wäldern von Terokkar möchte, dass Ihr 10 Eindringlinge der Felsfäuste tötet und Unkor den Rücksichtslosen so lange schlagt, bis er redet.‡테로카르 숲에 있는 킬라스가 돌주먹 약탈자 10명을 처치하고 학살자 운코르가 자백할 때까지 때려달라고 했습니다.‡Kilrath en el Bosque de Terokkar te ha pedido que mates a 10 invasores Puño de Roca y golpees a Unkor el Despiadado hasta hacerle hablar.‡Kilrath en el Bosque de Terokkar te ha pedido que mates a 10 invasores Puño de Roca y golpees a Unkor el Despiadado hasta hacerle hablar.‡Kilrath, dans la forêt de Terokkar, vous a demandé de tuer 10 Envahisseurs rochepoings, et de frapper Unkor le Brutal jusqu’à ce qu’il parle.‡泰罗卡森林的吉尔拉斯要求你杀死10名石拳入侵者，并击败无情的安克尔，让他招供。‡泰洛卡森林的科伊瑞斯要你殺死10個石拳侵略者並鞭打無情的昂庫爾直到他說話為止。',
  }
},
[9890] = {
  {
    'Êxito!‡Готово!‡Erfolg!‡성공!‡¡Éxito!‡¡Éxito!‡Victoire !‡成功了！‡成功!',
    nil,
    'Leve as informações que você arrancou de Unkor para Kilrath, na Mata Terokkar.‡Передайте все сведения, которые вы выбили из Анкора, Килрату в лес Тероккар.‡Teilt Kilrath in den Wäldern von Terokkar die Informationen, die Ihr aus dem Oger geprügelt habt, mit.‡테로카르 숲에 있는 킬라스에게 학살자 운코르를 두들겨 패서 자백받은 정보를 전해야 합니다.‡Ve al Bosque de Terokkar y cuéntale a Kilrath lo que le has hecho a Unkor.‡Ve al Bosque de Terokkar y cuéntale a Kilrath lo que le has hecho a Unkor.‡Transmettez à Kilrath, dans la forêt de Terokkar, les informations arrachées à Unkor.‡返回泰罗卡森林，将安克尔供述的秘密告诉吉尔拉斯。‡帶著你從昂庫爾那裡得知的消息去找泰洛卡森林的科伊瑞斯。',
  }
},
[9891] = {
  {
    'Porque Kilrath é um covarde‡Потому что Килрат – трус‡Weil Kilrath ein Feigling ist‡겁쟁이 킬라스‡Porque Kilrath es un cobarde‡Porque Kilrath es un cobarde‡Parce que Kilrath est un lâche‡吉尔拉斯这个懦夫！‡科伊瑞斯是懦夫',
    nil,
    'Leve as informações que você arrancou de Unkor para Jorin Olho Morto na cidade de Garadar, em Nagrand.‡Передайте информацию, которую вы выбили из Анкора, Джорину Мертвому Глазу в Гарадаре.‡Erzählt Jorin Totauge in Garadar in Nagrand, was Ihr aus Unkor herausprügeln konntet.‡나그란드의 가라다르에 있는 요린 데드아이에게 당신이 운코르를 때려서 자백받은 정보를 전해야 합니다.‡Ve a Garadar, en Nagrand, y cuéntale a Jorin Mortojo que has vencido a Unkor.‡Ve a Garadar, en Nagrand, y cuéntale a Jorin Mortojo que has vencido a Unkor.‡Transmettez les informations arrachées à Unkor à Jorin Œil-mort, à Garadar en Nagrand.‡返回纳格兰的加拉达尔，将安克尔供述的秘密告诉约林·死眼。‡帶著你從昂庫爾那裡得知的消息去納葛蘭找卡拉達爾的喬林·亡眼。',
  }
},
[9892] = {
  {
    'Mais colares de guerra obsidianos‡Поиски обсидиановых боевых ожерелий‡Noch mehr Obsidiankriegsperlen‡흑요석 전투 목걸이 추가 수집‡Más abalorios de guerra de obsidiana‡Más abalorios de guerra de obsidiana‡Encore des perles de guerre en obsidienne‡更多黑曜石作战念珠‡更多黑曜石戰爭串珠',
    nil,
    '‡‡‡‡¿Has conseguido más abalorios de guerra? Encontrarás muchos ogros al norte, cerca de la frontera con la Marisma de Zangar.‡‡‡‡',
  }
},
[9893] = {
  {
    'Colar de guerra obsidiano‡Обсидиановое боевое ожерелье‡Obsidiankriegsperlen‡흑요석 전투 목걸이‡Abalorios de guerra de obsidiana‡Abalorios de guerra de obsidiana‡Les perles de guerre d\'obsidienne‡黑曜石作战念珠‡黑曜石戰爭串珠',
    nil,
    'Leve 10 Colares de Guerra Obsidianos para Gezhe, no Posto Aeris, em Nagrand.‡Принесите 10 обсидиановых боевых ожерелий Гезхе в Небесный лагерь в Награнде.‡Bringt 10 Obsidiankriegsperlen zu Gezhe beim Aerissteg in Nagrand.‡나그란드의 에어리스 착륙지에 있는 게제에게 흑요석 전투 목걸이 10개를 가져가야 합니다.‡Lleva 10 abalorios de guerra de obsidiana a Gezhe en el Desembarco Aeris, en Nagrand.‡Lleva 10 abalorios de guerra de obsidiana a Gezhe en el Desembarco Aeris, en Nagrand.‡Apportez 10 Perles de guerre d\'obsidienne à Gezhe, du Point d\'ancrage Aeris en Nagrand.‡将10串黑曜石作战念珠交给纳格兰埃瑞斯码头的杰赫。‡帶10個黑曜石戰爭串珠到納葛蘭交給艾瑞斯平臺的吉札。',
  }
},
[9894] = {
  {
    'Proteja as sentinelas‡Защита наблюдателей‡Schützt die Behüter‡감시자 보호‡Vigilando a los vigías‡Vigilando a los vigías‡Protéger les guetteurs‡保护观察者‡保護守夜人',
    nil,
    'Mate Lorde Klaq e fale novamente com a Arauto do Vento Casco Negro, no Refúgio Cenariano.‡Убейте владыку Клака и вернитесь к призывательнице ветров Черное Копыто в Кенарийский приют.‡Tötet Lord Klaq und kehrt danach zu Windruferin Schwarzhuf in der Zuflucht des Cenarius zurück.‡우두머리 클라크를 처치한 후 세나리온 야영지에 있는 바람소환사 블랙후프에게 돌아가야 합니다.‡Mata a Lord Klaq y vuelve a ver a Clamavientos Pezuñanegra en el Refugio Cenarion.‡Mata a Lord Klaq y vuelve a ver a Clamavientos Pezuña Negra en el Refugio Cenarion.‡Tuez le Seigneur Klaq et retournez voir l’Imploratrice céleste Sabot-Noir au Refuge Cénarien.‡杀死克拉其大王，然后向塞纳里奥庇护所的唤风者塔鲁·黑蹄复命。‡殺了卡拉奎領主再回到塞納里奧避難所向喚風者黑蹄回報。',
  }
},
[9895] = {
  {
    'O equilíbrio agonizante‡Гибнущее равновесие‡Aus dem Gleichgewicht geraten‡균형의 붕괴‡La balanza de la vida y la muerte‡Equilibrio en extinción‡L\'équilibre se meurt‡崩溃的平衡‡垂死的平衡',
    nil,
    'Encontre e acabe com o Pantacílio, então fale novamente com Lethyn Flameluna, no Refúgio Cenariano.‡Найдите Топехлыста и уничтожьте его, потом вернитесь к Летину Лунному Пламени в Кенарийский приют.‡Sucht und vernichtet Sumpfschläger und kehrt dann zu Lethyn Mondfeuer in der Zuflucht des Cenarius zurück.‡수렁채찍을 찾아서 처치한 후 세나리온 야영지에 있는 레신 문파이어에게 돌아가야 합니다.‡Localiza y enfréntate a Látigo de ciénaga y, a continuación, vuelve a ver a Lethyn Fuegolunar en el Refugio Cenarion.‡Localiza y enfréntate a Látigo de ciénaga y, a continuación, vuelve a ver a Lethyn Fuegolunar en el Refugio Cenarion.‡Trouvez Fouettourbe et occupez-vous de lui, puis retournez voir Lethyn Lunéclat au Refuge cénarien.‡找到沼泽之鞭并杀死它，然后向塞纳里奥庇护所的莱森·月火复命。‡找到並解決掉伯克拉斯，再回到塞納里奧避難所向萊司恩·月火回報。',
  }
},
[9896] = {
  {
    'A desgraça do Aguilhão Negro‡Проклятие черной бракониды‡Schwarzsichels Fluch‡검은쐐기의 맹독‡La pesadilla de Aguijonegro‡La pesadilla de Aguijonegro‡La mort d\'Aiguillon-noir‡黑钉之刺‡黑刺的螫針的毀滅',
    nil,
    'Traga o Ferrão do Aguilhão Negro para o Prospector Conall, em Telredor.‡Принесите жало черной бракониды геологу Коналлу в Телредор.‡Bringt Schwarzsichels Stachel zu Ausgrabungsleiter Conall in Telredor.‡텔레도르에 있는 발굴조사단장 코날에게 검은쐐기의 독침을 가져가야 합니다.‡Lleva el aguijón de Aguijonegro al prospector Conall en Telredor.‡Lleva el aguijón de Aguijonegro al prospector Conall en Telredor.‡Apportez l\'Aiguillon d\'Aiguillon-noir au prospecteur Conall à Telredor.‡将黑钉之刺交给泰雷多尔的勘探员柯纳尔。‡將黑刺的螫針交給泰倫多爾的勘察員康歐。',
  }
},
[9897] = {
  {
    'Sã e salva!‡Я спасена!‡Ich bin gerettet!‡해방!‡¡A salvo!‡¡A salvo!‡Je suis sauvée !‡我得救了！‡我得救了!',
    nil,
    'Entregue o Fardo de Peles para Manuelzão, no Safári Rosarães, em Nagrand.‡Отнесите сверток шкур Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Gebt Harold Fährten bei Nesingwarys Safari in Nagrand das Bündel mit Tierhäuten.‡나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 가죽 꾸러미를 줘야 합니다.‡Entrega el fajo de pieles a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Entrega el fajo de pieles a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Donnez le Paquet de peaux à Harold Lane, au safari de Nesingwary en Nagrand.‡将一捆皮革交给纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩。‡將大批皮革帶到納葛蘭交給奈辛瓦里狩獵隊的哈爾歐德·蘭恩。',
  }
},
[9898] = {
  {
    'Nada fala de amor como um grande aguilhante‡Лучшее доказательство любви!‡Liebe ist ein großer Stachel‡커다란 독침만큼 지독한 사랑‡Nada dice Te quiero como un gran aguijón‡Nada dice Te quiero como un gran aguijón‡Un gros dard est une belle preuve d\'amour‡求爱的礼物‡讓大刺針示愛',
    nil,
    'Traga o Ferrão do Aguilhão Negro para Reavij, no Mocó do Rato Lamacento.‡Принесите жало черной бракониды Реавижу на заставу Болотной Крысы.‡Bringt Schwarzsichels Stachel zu Reavij im Sumpfrattenposten.‡늪쥐 감시초소에 있는 레아비즈가 검은쐐기의 독침을 가져다 달라고 부탁했습니다.‡Lleva el aguijón de Aguijonegro a Reavij en la Avanzada Rata del Pantano.‡Lleva el aguijón de Aguijonegro a Reavij en la Avanzada Rata del Pantano.‡Apportez l’Aiguillon d’Aiguillon-noir à Reavij, au poste du Rat des marais.‡将黑钉之刺交给沼泽鼠岗哨的里维伊。‡將黑刺的螫針交給斯溫派特崗哨的瑞伏基。',
  }
},
[9899] = {
  {
    'Um trabalho não feito‡Несделанное дело‡Unerledigte Arbeit‡처리 대상‡Un trabajo sin terminar‡Un trabajo sin terminar‡Un boulot pas fini‡未完的职责‡未完成的工作',
    nil,
    'Magasha, no Mocó do Rato Lamacento, quer que você mate o Asesporo.‡Убейте Спорокрыла по просьбе Магаши с заставы Болотной Крысы.‡Magasha im Sumpfrattenposten möchte, dass Ihr Sporenschwinge tötet.‡늪쥐 감시초소에 있는 마가샤가 포자박쥐를 처치해 달라고 부탁했습니다.‡Magasha en la Avanzada Rata del Pantano quiere que mates a Esporala.‡Magasha en la Avanzada Rata del Pantano quiere que mates a Esporala.‡Magasha, au poste du Rat des marais, veut que vous tuiez Sporailée.‡沼泽鼠岗哨的玛加沙要你杀死孢子之翼。‡斯溫派特崗哨的瑪卡莎要你去殺了斯柏溫。',
  }
},
[9900] = {
  {
    'Gava\'xi‡Гава\'кси‡Gava\'xi‡가바시‡Gava\'xi‡‡Gava\'xi‡加瓦克希‡卡沃希',
    nil,
    'Mate Gava\'xi perto de Oshu\'gun e fale novamente com Zerid no Posto Aeris, em Nagrand.‡Убейте Гава\'кси, который скрывается близ Ошу\'гуна, и возвращайтесь к Зериду в Небесный лагерь в Награнде.‡Tötet Gava\'xi in der Nähe des Oshu\'gun und kehrt dann zu Zerid beim Aerissteg in Nagrand zurück.‡오슈군 근처에 있는 가바시를 해치운 후 나그란드의 에어리스 착륙지에 있는 제리드에게 돌아가십시오.‡Mata a Gava\'xi cerca de Oshu\'gun y vuelve a ver a Zerid en el Desembarco Aeris, en Nagrand.‡Mata a Gava\'xi cerca de Oshu\'gun y vuelve a ver a Zerid en el Desembarco Aeris, en Nagrand.‡Tuez Gava\'xi près d\'Oshu\'gun, puis retournez voir Zerid au Point d\'ancrage Aeris, en Nagrand.‡杀死沃舒古附近的加瓦克希，然后向纳格兰埃瑞斯码头的瑟利德复命。‡殺了歐夏剛附近的卡沃希再回到納葛蘭找艾瑞斯平臺的澤瑞德。',
  }
},
[9901] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnung‡아직 해결되지 않은 문제‡Un trabajo inacabado‡Negocios inconclusos‡Un travail inachevé‡遗留事务‡未完成的任務',
    nil,
    'Prospector Conall, em Telredor, quer que você mate Asesporo.‡Убейте Спорокрыла по просьбе геолога Коналла из Телредора.‡Ausgrabungsleiter Conall in Telredor möchte, dass Ihr Sporenschwinge tötet.‡텔레도르에 있는 발굴조사단장 코날이 포자박쥐를 처치해 달라고 부탁했습니다.‡El prospector Conall en Telredor quiere que mates a Esporala.‡El prospector Conall en Telredor quiere que mates a Esporala.‡Le prospecteur Conall de Telredor veut que vous tuiez Sporailée.‡泰雷多尔的勘探员柯纳尔要求你干掉孢子之翼。‡泰倫多爾的勘察員康歐要你去殺死斯柏溫。',
  }
},
[9902] = {
  {
    'O terror do Lago Pantanoso‡Ужас озера Болотных Огоньков‡Der Schrecken des Sumpflichtsees‡수렁등불 호수의 공포‡El terror del Lago Luz Pantanosa‡El terror del Lago Luz Pantanosa‡La terreur du lac des furoles‡沼光湖的恐怖‡恐怖的沼澤光之湖',
    nil,
    'Mate o Terrogarra e fale novamente com Puluu, em Porto Orebor.‡Убейте Жутеклешня и вернитесь к Пулуу в прибежище Оребор.‡Tötet Terrorklaue und kehrt dann zu Puluu in der Oreborzuflucht zurück.‡공포의 집게발을 처치한 후 오레보르 피난처에 있는 풀루우에게 돌아가야 합니다.‡Mata a Terrogarra y ve a ver a Puluu en el Puerto Orebor.‡Mata a Terrogarra y ve a ver a Puluu en el Puerto Orebor.‡Tuez Griffe de terreur et retournez voir Puluu au Havre d’Orebor.‡杀死恐爪，然后向奥雷柏尔营地的普尔鲁复命。‡殺了恐懼之爪再回到奧雷伯爾港向保魯回報。',
  }
},
[9903] = {
  {
    'O maior de todos‡Самый здоровенный‡Der Größte von allen‡덩치만 큰 퇴물‡El más grande de todos‡El más grande de todos‡Le plus gros de tous‡多头蛇之王‡最大的挑戰',
    nil,
    'Mate Mragesh e fale novamente com Zurjaya em Zabra\'jin.‡Убейте Мрагеша и вернитесь к Зурджайе в Забра\'джин.‡Tötet Mragesh und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡므라게쉬를 해치운 후 자브라진에 있는 주르자야에게 돌아가십시오.‡Mata a Mragesh y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata a Mragesh y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez Mragesh et retournez voir Zurjaya à Zabra’jin.‡杀死穆拉格什，然后向萨布拉金的苏尔加亚复命。‡殺死莫拉吉斯再回到薩布拉金向祖賈亞回報。',
  }
},
[9904] = {
  {
    'Perseguição pelo Terrogarra‡Охота на Жутеклешня‡Jagd auf Terrorklaue‡공포의 집게발 사냥‡La persecución de Terrogarra‡La persecución de Terrogarra‡À la poursuite de Griffe de terreur‡猎杀恐爪‡抓到恐懼之爪',
    nil,
    'Mate o Terrogarra e fale novamente com Zurjaya, em Zabra\'jin.‡Убейте Жутеклешня и вернитесь к Зурджайе в Забра\'джин.‡Tötet Terrorklaue und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡공포의 집게발을 해치운 후 자브라진에 있는 주르자야에게 돌아가십시오.‡Mata a Terrogarra y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata a Terrogarra y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez Griffe de terreur et retournez voir Zurjaya à Zabra’jin.‡杀死恐爪，然后向萨布拉金的苏尔加亚复命。‡殺了恐懼之爪再回到薩布拉金向祖賈亞回報。',
  }
},
[9905] = {
  {
    'A vingança de Maktu‡Месть Макту‡Maktus Rache‡막투의 복수‡La venganza de Maktu‡La venganza de Maktu‡La vengeance de Maktu‡玛克图的复仇‡瑪克吐的復仇',
    nil,
    'Encontre e mate Mragesh, então fale novamente com Maktu, em Porto Orebor.‡Найдите и убейте Мрагеша, и вернитесь к Макту в прибежище Оребор.‡Sucht und tötet Mragesh und kehrt dann zu Maktu in der Oreborzuflucht zurück.‡므라게쉬를 찾아 처치한 후 오레보르 피난처에 있는 막투에게 돌아가야 합니다.‡Encuentra y mata a Mragesh, a continuación vuelve a ver a Maktu en el Puerto Orebor.‡Encuentra y mata a Mragesh, a continuación vuelve a ver a Maktu en el Puerto Orebor.‡Trouvez et tuez Mragesh, puis retournez voir Maktu au Havre d’Orebor.‡找到穆拉格什并杀死他，然后返回奥雷柏尔营地向玛克图复命。‡找到並殺死莫拉吉斯，再回到奧雷伯爾港向瑪克吐回報。',
  }
},
[9906] = {
  {
    'Mensagem de guerra‡Клинок вместо слов‡Sag\'s mit Fäusten‡전투를 통한 전갈‡Mensaje en una batalla‡Mensaje en una batalla‡Un message dans une bataille‡粗暴的信号‡戰鬥的訊息',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você mate 8 Esmagadores Punho de Pedra e 8 Místicos Punho de Pedra.‡Джорин Мертвый Глаз из Гарадара в Награнде просит вас убить 15 сокрушителей и 15 мистиков из клана Тяжелого Кулака.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr 15 Zermalmer der Felsfäuste und 15 Mystiker der Felsfäuste tötet.‡나그란드의 가라다르에 있는 요린 데드아이가 돌주먹 비술사와 돌주먹 장사를 8명씩 해치워 달라고 했습니다.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 15 trituradores Puño de Roca y 15 místicos Puño de Roca.‡‡Jorin Œil-mort, de Garadar en Nagrand, vous a demandé de tuer 8 Écraseurs rochepoings et 8 Mystiques rochepoings.‡纳格兰加拉达尔的约林·死眼要你杀死15个石拳打击者和15个石拳秘术师。‡納葛蘭，卡拉達爾的喬林·亡眼要你殺死15個石拳粉碎者和15個石拳秘法師。',
  }
},
[9907] = {
  {
    'Uma ofensiva audaciosa‡Дерзкий набег‡Ein kühner Angriff‡대담한 전진‡Un audaz avance‡Un audaz avance‡Une avancée audacieuse‡大胆的攻势‡大膽前進',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você mate 10 Guerreiros Punho de Pedra e 10 Magos Punho de Pedra.‡Джорин Мертвый Глаз из Гарадара в Награнде просит вас убить 25 воинов и 25 магов из клана Тяжелого Кулака.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr 25 Krieger der Felsfäuste und 25 Magier der Felsfäuste tötet.‡나그란드의 가라다르에 있는 요린 데드아이가 돌주먹 전사와 돌주먹 마법사를 10명씩 해치워달라고 했습니다.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 25 guerreros Puño de Roca y 25 magos Puño de Roca.‡‡Jorin Œil-mort, de Garadar en Nagrand, vous a demandé de tuer 10 Guerriers rochepoings et 10 Mages rochepoings.‡纳格兰加拉达尔的约林·死眼要你杀死25个石拳战士和25个石拳法师。‡納葛蘭，卡拉達爾的喬林·亡眼要你殺死25個石拳戰士和25個石拳法師。',
  }
},
[9910] = {
  {
    'Práticas e padrões‡Страх и уважение‡Standarten‡깃발 훈련‡Confalones y prácticas‡Confalones y prácticas‡Étendards au vent...‡扬旗示威‡軍旗與實行',
    nil,
    'Elky\'gan, o Místico, de Garadar, em Nagrand, quer que você finque Estandartes de Batalha Mag\'har na Primeira, na Segunda e na Terceira Piras da Lâmina Ardente. Devolva a Elky\'gan os estandartes restantes quando terminar.‡Установите по одному боевому штандарту маг\'харов возле первого, второго и третьего погребальных костров клана Пылающего Клинка. Когда выполните поручение, верните Илкай\'гану Мистику оставшиеся штандарты.‡Mystiker Elkay\'gan in Garadar in Nagrand möchte, dass Ihr eine Schlachtstandarte der Mag\'har am ersten, zweiten und dritten Scheiterhaufen der Brennenden Klinge aufstellt. Bringt die übrigen Schlachtstandarten zurück, wenn Ihr fertig seid.‡나그란드의 가라다르에 있는 비술사 엘카이간이 서로 다른 3개의 불타는 칼날단 장작불에서 마그하르 전투 깃발을 사용해 달라고 했습니다. 일을 마치면 사용한 마그하르 전투 깃발을 그에게 가져가야 합니다.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que utilices un confalón de batalla Mag\'har en la primera pira ardiendo Filo Ardiente, en la segunda pira ardiendo Filo Ardiente y en la tercera pira ardiendo Filo Ardiente. Devuelve los confalones de batalla Mag\'har que no hayas utilizado cuando termines.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que utilices un confalón de batalla Mag\'har en la primera pira ardiendo Filo Ardiente, en la segunda pira ardiendo Filo Ardiente y en la tercera pira ardiendo Filo Ardiente. Devuelve los confalones de batalla Mag\'har que no hayas utilizado cuando termines.‡Elkay\'gan le Mystique, de Garadar en Nagrand, veut que vous placiez des Étendards de bataille des Mag’har au Premier, Deuxième, et Troisième bûchers de la Lame-Ardente. Lorsque vous aurez terminé, allez lui rendre les Étendards de bataille des Mag\'har restants.‡纳格兰加拉达尔的秘法师埃尔卡甘要你将玛格汉军旗分别插在第一堆火刃篝火、第二堆火刃篝火和第三堆火刃篝火附近。完成任务后将剩余的玛格汉军旗还给他。‡納葛蘭，卡拉達爾的『秘法師』伊萊克根要你在第一個燃燒之劍柴堆、第二個燃燒之劍柴堆以及第三個燃燒之劍柴堆上使用瑪格哈戰鬥戰旗。完成後將瑪格哈戰鬥戰旗還給他。',
  }
},
[9911] = {
  {
    'O conde dos pântanos‡Владыка болот‡Der Graf der Marschen‡습지대의 생물들‡El conde de las marismas‡El conde de las marismas‡Le comte des marécages‡沼泽中的伯爵‡沼澤的伯爵',
    nil,
    'Traga a Mandíbula do "Conde" Ungula para a Vigia Leesa\'oh.‡Принесите челюсть "Графа" Унгула караульному Лиса\'о.‡Bringt "Graf" Ungulas Beißwerkzeug zu Behüterin Leesa\'oh.‡관찰자 리사오에게 백작 운굴라의 아래턱을 가져가야 합니다.‡Lleva la mandíbula del "Conde" Ungula a la vigía Leesa\'oh.‡‡Remettez la Mandibule du "Comte" Ungula à la gardienne Leesa\'oh.‡将"伯爵"昂古拉的下颚骨交给观察者莉萨奥。‡將『伯爵』安古拉的上顎帶給看守者里薩歐。',
  }
},
[9912] = {
  {
    'A Expedição Cenariana‡Кенарийская экспедиция‡Die Expedition des Cenarius‡세나리온 원정대‡La Expedición Cenarion‡La Expedición Cenarion‡L\'Expédition cénarienne‡塞纳里奥远征队‡塞納里奧遠征隊',
    nil,
    'Fale com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Поговорите с Исиэль Песнью Ветра в Кенарийском приюте в Зангартопи.‡Sprecht mit Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어와 대화해야 합니다.‡Habla con Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Habla con Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Parlez à Ysiel Chantelevent, au Refuge cénarien du marécage de Zangar.‡前往赞加沼泽的塞纳里奥庇护所，与伊谢尔·风歌谈一谈。‡到贊格沼澤的塞納里奧避難所和伊斯歐·風歌談談。',
  }
},
[9913] = {
  {
    'O Consórcio precisa de você!‡Консорциум ждет вас‡Das Konsortium braucht Euch!‡무역연합이 당신을 부른다!‡¡El Consorcio te necesita!‡¡El Consorcio te necesita!‡Le Consortium a besoin de vous !‡星界财团需要你！‡聯合團需要你!',
    nil,
    'Reporte-se a Gezhe no Posto Aeris, em Nagrand.‡Обратитесь к Гезхе. Его можно найти в Небесном лагере в Награнде.‡Meldet Euch bei Gezhe beim Aerissteg in Nagrand.‡나그란드의 에어리스 착륙지에 있는 게제에게 보고해야 합니다.‡Preséntate ante Gezhe en el Desembarco Aeris, en Nagrand.‡Preséntate ante Gezhe en el Desembarco Aeris, en Nagrand.‡Présentez-vous à Gezhe au Point d\'ancrage Aeris en Nagrand.‡向纳格兰埃瑞斯码头的杰赫报到。‡到納葛蘭向艾瑞斯平臺的吉札報告。',
  }
},
[9914] = {
  {
    'Cabeça de marfim‡Кость на вес золота‡Ein ganzer Kopf voll Elfenbein‡상아 어금니‡Una cabeza llena de marfil‡Una cabeza llena de marfil‡De l\'ivoire plein la tête‡象牙生意‡象長牙',
    nil,
    'Recolha 3 Pares de Presas de Marfim e entregue-as para Shadrek, em Posto Aeris, em Nagrand.‡Добудьте 3 пары бивней элекков и принесите их Шадреку в Небесный лагерь в Награнде.‡Sammelt 3 Paar Elfenbeinstoßzähne und kehrt dann zu Shadrek beim Aerissteg in Nagrand zurück.‡3쌍의 상아 어금니를 모은 후 나그란드의 에어리스 착륙지에 있는 샤드렉에게 가져가야 합니다.‡Consigue 3 pares de colmillos de marfil y llévaselos a Shadrek en el Desembarco Aeris, en Nagrand.‡Consigue 3 pares de colmillos de marfil y llévaselos a Shadrek en el Desembarco Aeris, en Nagrand.‡Récupérez 3 Paires de défenses d\'ivoire et rapportez-les à Shadrek, au Point d\'ancrage Aeris en Nagrand.‡将3对象牙交给纳格兰埃瑞斯码头的沙德雷克。‡收集3對象長牙帶回納葛蘭交給艾瑞斯平臺的薩德瑞克。',
  }
},
[9915] = {
  {
    'Mais cabeças de marfim‡Кость на вес воздуха‡Noch mehr Elfenbein‡상아 추가 수집‡Más cabezas llenas de marfil‡Más cabezas llenas de marfil‡Encore plus d\'ivoire plein la tête‡更多象牙‡更多象長牙',
    nil,
    '‡‡Ich habe immer noch Bedarf an Elfenbeinstoßzähnen von den wilden Elekk in Nagrand. Unglücklicherweise kann ich es mir nicht mehr leisten, Euch dafür zu bezahlen. Wenn Ihr mir aber trotzdem weiter Stoßzähne bringt, werdet Ihr Euch beim Konsortium sehr beliebt machen.‡‡‡‡‡‡',
  }
},
[9916] = {
  {
    'Caixas de suprimentos dos Olhos Sangrentos‡Припасы клана Кровавой Глазницы‡Vorratskisten des Blutenden Auges‡피눈물 보급품 상자‡Cajones de suministros Foso Sangrante‡Cajones de suministros Foso Sangrante‡Les caisses de fournitures de l\'Orbite-Sanglante‡血环补给箱‡血之谷補給木箱',
    nil,
    'Elky\'gan, o Místico, da cidade de Garadar, em Nagrand, quer que você recupere 10 Caixas de Suprimentos Olhos Sangrentos.‡Найдите 20 ящиков с припасами клана Кровавой Глазницы и принесите их Илкай\'гану Мистику.‡Mystiker Elkay\'gan in Garadar in Nagrand möchte, dass Ihr 20 Vorratskisten des Blutenden Auges wiederbesorgt.‡나그란드의 가라다르에 있는 비술사 엘카이간이 피눈물 보급품 상자 10개를 되찾아 달라고 했습니다.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que recuperes 20 cajones de suministros Foso Sangrante.‡‡Elkay\'gan le Mystique, de Garadar en Nagrand, veut que vous récupériez 10 Caisses de fournitures de l\'Orbite-Sanglante.‡纳格兰加拉达尔的秘法师埃尔卡甘要你找回20个血环补给箱。‡納葛蘭，卡拉達爾的『秘法師』伊萊克根要你取得20個血之谷補給木箱。',
  }
},
[9917] = {
  {
    'É uma miragem?‡Не верь глазам своим‡Kann ich meinen Augen trauen?‡보고도 믿기 힘든 일‡¿Me engañan mis ojos?‡¿Me engañan mis ojos?‡Est-ce que je rêve...‡是我眼花了？‡我眼花了嗎',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você recupere os planos dos Punho de Pedra.‡Добудьте планы клана Тяжелого Кулака для охотницы Бинтук из Телаара.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr die Pläne der Felsfäuste besorgt.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 돌주먹일족 계획서를 찾아와 달라고 부탁했습니다.‡La cazadora Bintook en Telaar, en Nagrand, quiere que consigas los planes de los Puño de Roca.‡La cazadora Bintook en Telaar, en Nagrand, quiere que consigas los planes de los Puño de Roca.‡La chasseresse Bintook, de Telaar en Nagrand, veut que vous récupériez les Plans rochepoing.‡找回石拳计划书，然后向纳格兰塔拉的女猎手彬图克复命。‡納葛蘭，泰拉的女獵人班吐克要你取得石拳計畫。',
  }
},
[9918] = {
  {
    'Não no meu turno!‡Только не в мою смену!‡Nicht solange ich hier wache!‡당직이 아닌 날에는...‡¡No durante mi guardia!‡¡No durante mi guardia!‡Pas de ça chez moi !‡这是我的地盘！‡在我的看守下門都沒有!',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você converse com o Caroço. Fale novamente com a caçadora Bintook após reunir as informações solicitadas.‡Поговорите с Глыбом. Когда получите необходимые сведения, возвращайтесь к охотнице Бинтук.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr mit Brocken sprecht. Kehrt zu Jägerin Bintook zurück, wenn Ihr die geforderten Informationen gesammelt habt.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 룸프와 대화한 후, 그녀가 부탁한 정보를 모두 모으면 여사냥꾼 빈투크에게 돌아와 달라고 부탁했습니다.‡La cazadora Bintook en Telaar, en Nagrand, quiere que hables con Zoquete. Vuelve a ver a la cazadora Bintook cuando hayas obtenido la información que necesita.‡La cazadora Bintook en Telaar, en Nagrand, quiere que hables con Zoquete. Vuelve a ver a la cazadora Bintook cuando hayas obtenido la información que necesita.‡La chasseresse Bintook, de Telaar en Nagrand, veut que vous parliez à Gros-tas. Retournez la voir lorsque vous aurez obtenu les informations dont elle a besoin.‡与拉普交谈，获取足够的情报后向纳格兰塔拉的女猎手彬图克复命。‡納葛蘭，泰拉的女獵人班吐克要你去和浪普談談。等你收集到女獵人班吐克要的資訊再回去找她。',
  }
},
[9919] = {
  {
    'Sporeggar‡Спореггар‡Sporeggar‡스포어가르‡Esporaggar‡Esporaggar‡Sporeggar‡孢子村‡斯博格爾',
    nil,
    'Vá a Sporeggar, no Pântano Zíngaro, ao norte do Vale dos Rebentos e entregue os Esporângios Recuperados para Msshi\'fn.‡Отправляйтесь в Спореггар, к северу от Грибной поляны, и отнесите спасенные мешочки спор Мссхи\'фну.‡Geht nach Sporeggar, nördlich vom Pilzgeflecht, und bringt die geborgenen Sporensäcke zu Msshi\'fn.‡부화의 골짜기의 북쪽에 있는 스포어가르로 가서 므쉬픈에게 보존된 포자 주머니를 전해야 합니다.‡Ve a Esporaggar, al norte de La Cañada Emergente y lleva las bolsas de esporas rescatadas a Msshi\'fn.‡‡Allez à Sporeggar, au Marécage de Zangar, au nord du vallon des pontes, et apportez les Sacs de spores récupérés à Msshi\'fn.‡去孢殖林北边的孢子村，将抢救出来的孢子囊交给姆希菲。‡前往重生峽谷北邊的斯博格爾，將獲救的孢子囊送給米斯恩。',
  }
},
[9920] = {
  {
    'Mo\'mor, o Destruidor‡Мо\'мор Разрушитель‡Mo\'mor der Brecher‡파괴자 모모르‡Mo\'Mor el Rompedor‡Mo\'Mor el Rompedor‡Mo\'mor le Briseur‡击碎者姆摩尔‡『破壞者』哞哞爾',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você converse com Mo\'mor, o Destruidor.‡Охотница Бинтук из Телаара хочет, чтобы вы поговорили с Мо\'мором Разрушителем.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr mit Mo\'mor dem Brecher redet.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 파괴자 모모르와 대화해 보라고 부탁했습니다.‡La cazadora Bintook de Telaar en Nagrand quiere que hables con Mo\'mor el Rompedor.‡La cazadora Bintook de Telaar en Nagrand quiere que hables con Mo\'mor el Rompedor.‡La chasseresse Bintook, à Telaar en Nagrand, veut que vous parliez à Mo’mor le Briseur.‡纳格兰塔拉的女猎手彬图克要你去找击碎者姆摩尔谈一谈。‡納葛蘭，泰拉的女獵人班吐克要你去和『破壞者』哞哞爾談談。',
  }
},
[9921] = {
  {
    'As ruínas da Lâmina Ardente‡Руины Пылающего Клинка‡Die Ruinen der Brennenden Klinge‡불타는 칼날 폐허‡Las Ruinas Filo Ardiente‡Las Ruinas Filo Ardiente‡Les ruines de la Lame-Ardente‡火刃废墟‡燃燒之劍廢墟',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você mate 8 agressores Punho de Pedra e 8 devotos Punho de Pedra.‡Мо\'мор Разрушитель из Телаара желает, чтобы вы убили 15 мистиков и 15 сокрушителей из клана Тяжелого Кулака.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr 15 Zermalmer der Felsfäuste und 15 Mystiker der Felsfäuste tötet.‡나그란드의 텔라아르에 있는 파괴자 모모르가 돌주먹일족 장사와 돌주먹일족 비술사를 각각 15명씩 처치해 달라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 8 trituradores y 8 místicos Puño de Roca.‡‡Mo\'mor le Briseur, à Telaar en Nagrand, veut que vous tuiez 8 Écraseurs rochepoings et 8 Mystiques rochepoings.‡杀死15个石拳打击者和15个石拳秘术师，然后向纳格兰塔拉的击碎者姆摩尔复命。‡納葛蘭，泰拉的『破壞者』哞哞爾要你去殺死15個石拳粉碎者和15個石拳秘法師。',
  }
},
[9922] = {
  {
    'As furnas gêmeas de Nagrand‡Расселины Награнда‡Die Zwillingsschluchten von Nagrand‡나그란드의 쌍둥이 동굴‡Las fallas gemelas de Nagrand‡Las fallas gemelas de Nagrand‡Les failles jumelles de Nagrand‡纳格兰的峡谷‡納葛蘭的雙子斷崖',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você mate 10 guerreiros Punho de Pedra e 10 magos Punho de Pedra.‡Мо\'мор Разрушитель из Телаара желает, чтобы вы убили 25 воинов и 25 магов из клана Тяжелого Кулака.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr 25 Krieger der Felsfäuste und 25 Magier der Felsfäuste tötet.‡나그란드의 텔라아르에 있는 파괴자 모모르가 돌주먹일족 전사와 돌주먹일족 마법사를 25명씩 처치해 달라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 25 guerreros y 25 magos Puño de Roca.‡‡Mo\'mor le Briseur, à Telaar en Nagrand, veut que vous tuiez 10 Guerriers rochepoings et 10 Mages rochepoings.‡杀死25个石拳战士和25个石拳法师，然后向纳格兰塔拉的击碎者姆摩尔复命。‡納葛蘭，泰拉的『破壞者』哞哞爾要你去殺死25個石拳戰士和25個石拳法師。',
  }
},
[9923] = {
  {
    'SOCORRO!‡На помощь!‡HILFE!‡위기에 처한 코르키!‡¡AYUDA!‡¡Socorro!‡AU SECOURS !‡救命啊！‡救命!',
    nil,
    'Encontre a chave dos Punho de Pedra e liberte Corki. Caso você consiga, fale com Arechron em Telaar.‡Найдите ключ клана Тяжелого Кулака и освободите Корки. После этого отправляйтесь к Арехрону в Телаар за наградой.‡Findet den Schlüssel der Felsfäuste und befreit Corki. Sprecht mit Arechron in Telaar, wenn Ihr Erfolg hattet.‡돌주먹일족 열쇠를 찾아서 코르키를 풀어 준 후 텔라아르에 있는 아레크론과 대화해야 합니다.‡Encuentra la llave Puño de Roca y libera a Corki. Habla con Arechron en Telaar si lo consigues.|n‡Encuentra la llave Puño de Roca y libera a Corki. Habla con Arechron en Telaar si lo consigues.|n‡Trouvez la Clé rochepoing et libérez Corki. Parlez avec Arechron, à Telaar, si vous réussissez.‡找到石拳钥匙，解救考尔奇，然后向塔拉的阿雷克隆复命。‡找到石拳鑰匙並釋放柯爾奇。成功後和泰拉的阿爾克隆談談。',
  }
},
[9924] = {
  {
    'Corki sumiu de novo!‡Корки снова пропал!‡Corki wird schon wieder vermisst!‡다시 사라진 코르키!‡¡Corki ha vuelto a desaparecer!‡¡Corki ha vuelto a desaparecer!‡Corki a encore disparu !‡考尔奇又走丢了！‡柯爾奇又不見了!',
    nil,
    'Arechron, em Telaar, pediu para você encontrar e libertar Corki.‡Найдите и освободите Корки.‡Arechron in Telaar bittet Euch, Corki zu suchen und zu befreien.‡텔라아르에 있는 아레크론이 코르키를 찾아서 구해 달라고 부탁했습니다.‡Arechron en Telaar te ha pedido que encuentres y liberes a Corki.‡Arechron en Telaar te ha pedido que encuentres y liberes a Corki.‡Arechron, de Telaar, vous a demandé de retrouver et de libérer Corki.‡塔拉的阿雷克隆要你去搭救考尔奇。‡泰拉的阿爾克隆要你找到並且釋放柯爾奇。',
  }
},
[9925] = {
  {
    'Questões de segurança‡Вопросы безопасности‡Eine Frage der Sicherheit‡보안 문제‡Una cuestión de seguridad‡Una cuestión de seguridad‡Des questions de sécurité‡安全问题‡防禦之事',
    nil,
    'Zerid, do Posto Aeris, em Nagrand, quer que você mate 8 Crias do Caos nas cercanias de Oshu\'gun.‡Убейте 12 отроков Бездны поблизости от Ошу\'гуна.‡Zerid beim Aerissteg in Nagrand möchte, dass Ihr 12 Ausgeburten der Leere in der Nähe des Oshu\'gun tötet.‡나그란드의 에어리스 착륙지에 있는 제리드가 오슈군 근처에 있는 공허의 피조물 12마리를 해치워 달라고 부탁했습니다.‡Zerid, del Desembarco Aeris en Nagrand, quiere que mates 12 engendros del vacío cerca de Oshu\'gun.‡‡Zerid, du Point d\'ancrage Aeris en Nagrand, veut que vous tuiez 12 Rejetons du Vide près d\'Oshu\'gun.‡纳格兰埃瑞斯码头的瑟利德要求你杀死沃舒古附近的12个空灵爪牙。‡納葛蘭，艾瑞斯平臺的澤瑞德要你去歐夏剛附近殺死12個虛無再生者。',
  }
},
[9926] = {
  {
    'FLAG Shadow Council/Warmaul Questline‡FLAG Совет Теней/Цепочка заданий Боевой Молот‡FLAG Shadow Council/Warmaul Questline‡ 어둠의 요새/전쟁망치 일족‡FLAG Shadow Council/Warmaul Questline‡‡FLAG Shadow Council/Warmaul Questline‡FLAG Shadow Council/Warmaul Questline‡',
    nil,
    nil,
  }
},
[9927] = {
  {
    'Astúcia implacável‡Безжалостное коварство‡Erbarmungslose Gerissenheit‡무자비한 교활함‡Astucia despiadada‡Astucia despiadada‡Une ruse impitoyable‡无情的计谋‡殘忍的狡猾',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você finque 10 Estandartes dos Ogros Guerramalho em cadáveres dos membros do clã Kil\'pesar, na Fortaleza Kil\'pesar.nnDevolva os estandartes que não forem usados.‡Вонзите 20 знамен клана Боевого Молота в тела защитников бастиона Вечной Скорби.nnВерните Лантрезору Клинку оставшиеся знамена.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge in Nagrand möchte, dass Ihr 20 Ogerbanner der Totschläger in die Körper von Bewohnern von Kil\'sorge in der Festung Kil\'sorge rammt.nnBringt unbenutzte Ogerbanner der Totschläger zu ihm zurück.‡나그란드의 불타는 칼날단 폐허에 있는 칼날의 란트레서가 킬소로우 요새에 있는 병사들의 시체에 전쟁망치 오우거 깃발 10개를 꽂아달라고 했습니다.nn사용하고 남은 전쟁망치 오우거 깃발은 다시 돌려줘야 합니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que plantes 20 estandartes ogros de Mazo de Guerra en los cuerpos de miembros de Mata\'penas en la Fortaleza Mata\'penas.nnDevuélvele los estandartes que no hayas usado.‡‡Lantresor de la Lame, aux Ruines de la Lame-Ardente en Nagrand, veut que vous plantiez 10 Bannières des Ogres Cogneguerre dans le corps de soldats de Kil\'sorrau, à la forteresse Kil\'sorrau.nnRapportez les Bannières des Ogres Cogneguerre que vous n’aurez pas utilisées.‡前往基尔索罗堡垒，将20面战槌食人魔军旗插在基尔索罗成员的尸体上，然后返回纳格兰火刃废墟向兰特瑞索·火刃复命。nn将没有用完的战槌食人魔军旗还给兰特瑞索。‡納葛蘭，燃燒之劍氏族廢墟的『劍刃』蘭崔索要你將20個戰槌巨魔旗幟插在吉爾索洛堡壘的吉爾索洛成員屍體上。|n將未使用的戰槌巨魔旗幟交回。',
  }
},
[9928] = {
  {
    'Armamento de decepção em massa‡Военная хитрость‡Waffen zur Täuschung‡속임수를 위한 무기‡Armamentos para engañar‡Armamentos para engañar‡Les armes du subterfuge‡欺诈所需的军备‡欺騙的軍備',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você recolha 10 Armamentos de Kil\'pesar.‡Принесите Лантрезору Клинку в руины Пылающего Клинка 20 ящиков с оружием из бастиона Вечной Скорби.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge Nagrand möchte, dass Ihr 20 Waffen von Kil\'sorge besorgt.‡나그란드의 불타는 칼날단 폐허에 있는 칼날의 란트레서가 킬소로우 무기 10개를 모아달라고 했습니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que recojas 20 armamentos de Mata\'penas.‡‡Lantresor de la Lame, des Ruines de la Lame-Ardente en Nagrand, veut que vous récupériez 10 Armes de Kil\'sorrau.‡纳格兰火刃废墟的兰特瑞索·火刃要你收集20份基尔索罗军备。‡納葛蘭，燃燒之劍氏族廢墟的『劍刃』蘭崔索要你去收集20個吉爾索洛裝備。',
  }
},
[9929] = {
  {
    'The Missing Merchant‡Пропавший торговец‡Der vermisste Händler‡‡El mercader desaparecido‡‡Le marchand disparu‡‡',
    nil,
    'Travel northwest along the road toward Shattrath and search for evidence of what happened to Dugar.‡Отправляйтесь по дороге на северо-запад, по направлению к Шаттрату, и поищите какие-нибудь намеки на то, что могло случиться с Дугаром.‡Reist nach Nordwesten entlang der Straße nach Shattrath und sucht nach Hinweisen auf den Verbleib von Dugar.‡‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Dugar.‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Dugar.‡Suivez la route de Shattrath vers le nord-ouest et cherchez des indices concernant ce qui est arrivé à Dugar.‡‡',
  }
},
[9930] = {
  {
    'The Missing Merchant‡Пропавший торговец‡Der vermisste Händler‡‡El mercader desaparecido‡‡Le marchand disparu‡‡',
    nil,
    'Travel northwest along the road toward Shattrath and search for evidence of what happened to Deirom.‡Отправляйтесь по дороге на северо-запад, по направлению к Шаттрату, и поищите какие-нибудь намеки на то, что могло случиться с Дейромом.‡Reist nach Nordwesten entlang der Straße nach Shattrath und sucht nach Hinweisen auf den Verbleib von Deirom.‡‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Deirom.‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Deirom.‡Suivez la route de Shattrath vers le nord-ouest et cherchez des indices concernant ce qui est arrivé à Deirom.‡‡',
  }
},
[9931] = {
  {
    'Retribuir o favor‡Взаимная вежливость‡Sich für den Gefallen revanchieren‡호의에 대한 보답‡Devolver el favor‡Devolver el favor‡Un prêté pour un rendu‡以牙还牙‡回報',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você finque 10 Estandartes de Kil\'pesar nos cadáveres dos ogros Guerramalho, nas Ruínas Gargaveira.nnDevolva os estandartes que não forem usados.‡Воткните 20 знамен Вечной Скорби в трупы огров из клана Боевого Молота, обитающих в руинах Веселого Черепа.nnОставшиеся знамена верните Лантрезору.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge in Nagrand möchte, dass Ihr 20 Banner von Kil\'sorge in die Leichen der Totschlägeroger in den Ruinen des Lachenden Schädels rammt.nnBringt unbenutzte Banner von Kil\'sorge zu ihm zurück.‡나그란드의 불타는 칼날 폐허에 있는 칼날의 란트레서가 웃는 해골 폐허에 있는 전쟁망치일족 오우거들의 시체에 킬소로우 깃발 20개를 꽂아달라고 부탁했습니다.nn사용하고 남은 킬소로우 깃발은 다시 돌려줘야 합니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere plantes 20 estandartes Mata\'penas en los cuerpos de ogros de Mazo de Guerra en las Ruinas Riecráneos.nnDevuélvele los estandartes que no hayas usado.‡‡Lantresor de la Lame, aux Ruines de la Lame-Ardente en Nagrand, veut que vous plantiez 10 Bannières de Kil\'sorrau dans les cadavres d’ogres Cogneguerre, aux Ruines du clan du Crâne-Ricanant.nnRapportez-lui toutes les bannières de Kil\'sorrau que vous n’aurez pas utilisées.‡纳格兰火刃废墟的兰特瑞索·火刃要你杀入嘲颅废墟，将20面基尔索罗军旗插在战槌食人魔的尸体上。nn将没有用完的基尔索罗军旗还给兰特瑞索。‡燃燒之劍氏族廢墟的『劍刃』蘭崔索要你將20個吉爾索洛旗幟插在獰笑骷髏氏族廢墟的戰槌巨魔屍體上。|n交回未使用的吉爾索洛旗幟。',
  }
},
[9932] = {
  {
    'Corpo de delito‡Вещественное доказательство‡Beweismaterial‡증거가 되는 시체‡El cadáver del delito‡El cadáver del delito‡Le corps du délit‡尸证‡證據的屍體',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você use o Cobertor de Lã Molhado na pira ardente dos Guerramalho, no Pátio Gargaveira, para mandar sinais de fumaça para seus ogros.‡По поручению Лантрезора Клинка из руин Пылающего Клинка в Награнде найдите костер клана Боевого Молота во внутреннем дворе руин Веселого Черепа. С помощью мокрого шерстяного одеяла подайте дымовой сигнал ограм.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge in Nagrand möchte, dass Ihr die feuchte Wolldecke am lodernden Scheiterhaufen der Totschläger im Hof des Lachenden Schädels benutzt, um Signale an seine Oger zu senden.‡나그란드의 불타는 칼날단 폐허에 있는 칼날의 란트레서가 웃는 해골 광장의 타오르는 전쟁망치 장작불에서 축축한 양모 담요를 사용하여 그의 오우거 부하들에게 연기로 신호를 보내달라고 했습니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que utilices la manta de lana húmeda en la pira Mazo de Guerra llameante, en el Patio Riecráneos, para enviar señales a sus ogros.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que utilices la manta de lana húmeda en la pira Mazo de Guerra llameante, en el Patio Riecráneos, para enviar señales a sus ogros.‡Lantresor de la Lame, des ruines de la Lame-Ardente en Nagrand, veut que vous utilisiez la Couverture de laine humide sur le Bûcher ardent cogneguerre dans la Cour du Crâne-Ricanant afin d’envoyer un signal à ses Ogres.‡纳格兰火刃废墟的兰特瑞索·火刃要你前往嘲颅营地，在燃烧的战槌篝火堆处点燃潮湿的毛毯，利用烟雾向食人魔传递信号。‡納葛蘭，燃燒之劍氏族廢墟的『劍刃』蘭崔索要你去獰笑骷髏庭院，在燃燒的戰槌柴堆使用潮濕的羊毛毯來通知他的巨魔。',
  }
},
[9933] = {
  {
    'Mensagem para Telaar‡Послание в Телаар‡Nachricht für Telaar‡텔라아르에 보내는 전갈‡Mensaje para Telaar‡Mensaje para Telaar‡Un message pour Telaar‡回到塔拉‡給泰拉的訊息',
    nil,
    'Entregue a oferenda de paz da Lâmina Ardente para Arechron, na vila de Telaar, em Nagrand.‡Отнесите мирное подношение клана Пылающего Клинка Арехрону в Телаар.‡Bringt das Friedensangebot der Brennenden Klinge zu Arechron in Telaar.‡나그란드의 텔라아르에 있는 아레크론에게 평화의 불타는 칼날단 공물을 가져가야 합니다.‡Lleva la ofrenda de paz del clan Filo Ardiente a Arechron a Telaar, en Nagrand.‡‡Apporter l’Offrande de paix de la Lame-Ardente à Arechron, à Telaar, en Nagrand.‡将火刃的议和礼物交给塔拉的阿雷克隆。‡將火刃和平禮物帶給泰拉的阿爾克隆。',
  }
},
[9934] = {
  {
    'Mensagem para Garadar‡Послание в Гарадар‡Nachricht für Garadar‡가라다르로 보내는 전갈‡Mensaje para Garadar‡Mensaje para Garadar‡Un message pour Garadar‡回到加拉达尔‡給卡拉達爾的訊息',
    nil,
    'Entregue a Oferenda de Paz da Lâmina Ardente para Garrosh, em Garadar.‡Отнесите мирное подношение клана Пылающего Клинка Гаррошу в Гарадар.‡Bringt das Friedensangebot der Brennenden Klinge zu Garrosh in Garadar.‡가라다르에 있는 가로쉬에게 평화의 불타는 칼날단 공물을 가져가야 합니다.‡Lleva la ofrenda de paz del Filo Ardiente a Garrosh, en Garadar.‡Lleva la ofrenda de paz del Filo Ardiente a Garrosh, en Garadar.‡Apporter l’Offrande de paix de la Lame-Ardente à Garrosh, à Garadar.‡将火刃的议和礼物交给加拉达尔的加尔鲁什。‡將火刃和平禮物帶給卡拉達爾的卡爾洛斯。',
  }
},
[9935] = {
  {
    'PROCURA-SE: Giselda, a Encarquilhada‡Разыскивается: Гизельда Колдунья‡Gesucht: Giselda die Alte‡현상 수배: 마녀 기셀다‡Se busca: Giselda la Vieja bruja‡Se busca: Giselda la Vieja bruja‡On recherche : Giselda la Mégère‡通缉：巫婆吉塞尔达‡懸賞:『老巫婆』吉絲達',
    nil,
    'Mate Giselda, a Encarquilhada, e qualquer grupo de 10 Agentes Kil\'pesar. Caso consiga terminar a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Гизельда Колдунью и 15 любых служителей бастиона Вечной Скорби. Получите награду у стража-смотрителя Быккрока в Гарадаре.‡Tötet Giselda die Alte und 15 beliebige Bewohner von Kil\'sorge. Kehrt danach zu Aufseher Bullrok in Garadar zurück.‡마녀 기셀다와 킬소로우에 소속된 적을 15명 채워서 해치우십시오. 일을 마치면 가라다르에 있는 교도관 불로크에게 돌아가십시오.‡Mata a Giselda la Vieja bruja y a 15 agentes Mata\'penas. Vuelve a ver al celador Tororroc, en Garadar, en cuando cumplas la misión.‡‡Tuez Giselda la Mégère et n\'importe quelle combinaison de 15 Agents de Kil\'sorrau. Retournez voir le gardien Bullrok à Garadar si vous parvenez à accomplir cette tâche.‡杀死巫婆吉塞尔达以及任意15名基尔索罗成员，完成任务后向加拉达尔的监护者布罗克复命。‡殺死『老巫婆』吉絲達，及任何身份的15個吉爾索洛密探。完成任務後回到卡拉達爾找守望者波洛克。',
  }
},
[9936] = {
  {
    'PROCURA-SE: Giselda, a Encarquilhada‡Разыскивается: Гизельда Колдунья‡Gesucht: Giselda die Alte‡현상 수배: 마녀 기셀다‡Se busca: Giselda la Vieja bruja‡Se busca: Giselda la Vieja bruja‡On recherche : Giselda la Mégère‡通缉：巫婆吉塞尔达‡懸賞:『老巫婆』吉絲達',
    nil,
    'Mate Giselda, a Encarquilhada, e qualquer grupo de 10 Agentes Kil\'pesar. Caso consiga terminar a tarefa, fale novamente com o protetor Moi\'bff Jill na vila de Telaar.‡Убейте Гизельда Колдунью и 15 любых служителей бастиона Вечной Скорби. Затем вернитесь к стражу-смотрителю Мой\'прну Джиллу в Телаар.‡Tötet Giselda die Alte und 15 beliebige Bewohner von Kil\'sorge. Kehrt danach zu Aufseher Moi\'bff Jill in Telaar zurück.‡마녀 기셀다와 킬소로우의 여러 요원들을 처치한 후 텔라아르에 있는 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Giselda la Vieja bruja y a 15 agentes de Mata\'penas. Vuelve a ver al celador Moi\'bff Jill, en Telaar, en cuando cumplas la misión.‡‡Tuez Giselda la Mégère et n\'importe quelle combinaison de 15 Agents de Kil\'sorrau. Retournez voir le gardien Moi\'bff Jill à Telaar si vous parvenez à accomplir cette tâche.‡杀死巫婆吉塞尔达以及任意15名基尔索罗成员，完成任务后返回塔拉向监护者莫布吉尔复命。‡殺死『老巫婆』吉絲達，及任何身份的15個吉爾索洛密探。完成任務後回到泰拉找守望者莫布夫·吉爾。',
  }
},
[9937] = {
  {
    'PROCURA-SE: Durn, o Famélico‡Разыскивается: Дарн Ненасытный‡Gesucht: Durn der Nimmersatte‡현상 수배: 굶주린 두른‡Se busca: Durn el Hambriento‡Se busca: Durn el Hambriento‡ON RECHERCHE : Durn l’Affameur‡通缉：饥饿者杜恩‡懸賞:『飢餓者』唐恩',
    nil,
    'Mate Durn, o Famélico. Caso você consiga cumprir a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Дарна Ненасытного. Вернитесь к стражу-смотрителю Быккроку и получите награду.‡Tötet Durn den Nimmersatten. Meldet Euch bei Aufseher Bullrok, wenn Ihr diese Aufgabe erledigt habt.‡굶주린 두른을 해치워야 합니다. 임무를 마치면 교도관 불로크에게 돌아가십시오.‡Mata a Durn el Hambriento. Ve a ver al celador Tororroc si consigues completar esta tarea.‡Mata a Durn el Hambriento. Ve a ver al celador Tororroc si consigues completar esta tarea.‡Tuez Durn l\'Affameur. Retournez voir le gardien Bullrok si vous parvenez à accomplir cette tâche.‡杀死饥饿者杜恩，完成任务后向监护者布罗克复命。‡殺死『飢餓者』唐恩。完成任務後回去找守望者波洛克。',
  }
},
[9938] = {
  {
    'Procura-se: Durn, o Famélico‡Разыскивается: Дарн Ненасытный‡Gesucht: Durn der Nimmersatte‡현상 수배: 굶주린 두른‡Se busca: Durn el Hambriento‡Se busca: Durn el Hambriento‡On recherche : Durn l\'Affameur‡通缉：饥饿者杜恩‡懸賞:『飢餓者』唐恩',
    nil,
    'Mate Durn, o Famélico. Caso você consiga cumprir a tarefa, fale novamente com o Protetor Moi\'bff Jill.‡Убейте Дарна Ненасытного. Вернитесь к стражу-смотрителю Мой\'прну Джиллу и получите награду.‡Tötet Durn den Nimmersatten. Meldet Euch bei Aufseher Moi\'bff Jill, wenn Ihr diese Aufgabe erledigt habt.‡굶주린 두른을 처치한 후 일을 마치면 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Durn el Hambriento. Ve a ver al celador Moi\'bff Jill si consigues completar esta tarea.‡Mata a Durn el Hambriento. Ve a ver al celador Moi\'bff Jill si consigues completar esta tarea.‡Tuez Durn l\'Affameur. Retournez voir le gardien Moi\'bff Jill si vous parvenez à accomplir cette tâche.‡杀死饥饿者杜恩，完成任务后向塔拉的监护者莫布吉尔复命。‡殺死『飢餓者』唐恩。完成任務後回去找守望者莫布夫·吉爾。',
  }
},
[9939] = {
  {
    'PROCURA-SE: Zorbo, o Conselheiro‡Разыскивается: Зорбо Советчик‡Gesucht: Zorbo der Berater‡현상 수배: 조언자 조르보‡Se busca: Zorbo el Consejero‡Se busca: Zorbo el Consejero‡On recherche : Zorbo le Conseiller‡通缉：顾问佐尔布‡懸賞:『諫言者』索爾波',
    nil,
    'Mate Zorbo, o Conselheiro, 5 Xamãs Guerramalho e 5 Aniquiladores Guerramalho. Caso você consiga cumprir a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Зорбо Советчика, 10 шаманов и 10 разорителей из клана Боевого Молота. Получите награду у стража-смотрителя Быккрока.‡Tötet Zorbo den Berater, 10 Schamanen der Totschläger und 10 Häscher der Totschläger. Meldet Euch bei Aufseher Bullrok, wenn Ihr die Aufgabe erledigt habt.‡조언자 조르보, 전쟁망치일족 주술사 10명, 전쟁망치일족 약탈자 10명을 해치워야 합니다. 일을 마치면 교도관 불로크에게 돌아가십시오.‡Mata a Zorbo el Consejero, 10 chamanes Mazo de Guerra y 10 atracadores Mazo de Guerra. Ve a ver al celador Tororroc si consigues completar la tarea.‡‡Tuez Zorbo le Conseiller, 10 Chamans Cogneguerre et 10 Ravageurs Cogneguerre. Retournez voir le gardien Bullrok si vous parvenez à accomplir cette tâche.‡杀死顾问佐尔布、10个战槌萨满祭司和10个战槌劫掠者，完成任务后向监护者布罗克复命。‡殺死『諫言者』索爾波，10個戰槌薩滿和10個戰槌搶奪者。完成任務後去找守望者波洛克。',
  }
},
[9940] = {
  {
    'PROCURA-SE: Zorbo, o Conselheiro‡Разыскивается: Зорбо Советчик‡Gesucht: Zorbo der Berater‡현상 수배: 조언자 조르보‡Se busca: Zorbo el Consejero‡Se busca: Zorbo el Consejero‡On recherche : Zorbo le Conseiller‡通缉：顾问佐尔布‡懸賞:『諫言者』索爾波',
    nil,
    'Mate Zorbo, o Conselheiro, 5 Xamãs Guerramalho e 5 Aniquiladores Guerramalho. Caso você consiga cumprir a tarefa, fale novamente com o Protetor Moi\'bff Jill.‡Убейте Зорбо Советчика, 10 шаманов и 10 разорителей из клана Боевого Молота. Получите награду у стража-смотрителя Мой\'прна Джилла.‡Tötet Zorbo den Berater, 10 Schamanen der Totschläger und 10 Häscher der Totschläger. Meldet Euch bei Aufseher Moi\'bff Jill, wenn Ihr die Aufgabe erledigt habt.‡조언자 조르보, 전쟁망치일족 주술사 10명, 전쟁망치일족 약탈자 10명을 처치한 후 텔라아르의 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Zorbo el Consejero, 10 chamanes Mazo de Guerra y 10 atracadores Mazo de Guerra. Ve a ver al celador Moi\'bff Jill si consigues completar la tarea.‡‡Tuez Zorbo le Conseiller, 10 Chamans Cogneguerre et 10 Ravageurs Cogneguerre. Retournez voir le gardien Moi\'bff Jill si vous parvenez à accomplir cette tâche.‡杀死顾问佐尔布、10个战槌萨满祭司和10个战槌劫掠者，完成任务后向塔拉的监护者莫布吉尔复命。‡殺死『諫言者』索爾波、10個戰槌薩滿和10個戰槌搶奪者。完成任務後去找守望者莫布夫·吉爾。',
  }
},
[9941] = {
  {
    'Tracking Down the Culprits‡Выслеживание преступников‡Die Schuldigen aufspüren‡‡Rastreando a los culpables‡‡À la recherche des coupables‡‡',
    nil,
    'Continue your search for signs of Deirom in the Arakkoa settlement north of the broken cart.‡Продолжите поиски Дейрома в поселении араккоа к северу от сломанной повозки.‡Sucht weiter in der Arakkoasiedlung nördlich des kaputten Wagens nach einem Lebenszeichen von Deirom.‡‡Sigue buscando pistas sobre Deirom en el asentamiento de los arakkoa al norte del carro destruido.‡Sigue buscando pistas sobre Deirom en el asentamiento de los arakkoa al norte del carro destruido.‡Continuez à chercher des signes de la présence de Deirom dans le village arakkoa, au nord du chariot brisé.‡‡',
  }
},
[9942] = {
  {
    'Tracking Down the Culprits‡Выслеживание преступников‡Die Schuldigen aufspüren‡‡Rastreando a los culpables‡‡À la recherche des coupables‡‡',
    nil,
    'Continue your search for signs of Dugar in the Arakkoa settlement north of the broken cart.‡Продолжите поиски Дугара в поселении араккоа к северу от сломанной повозки.‡Sucht weiter in der Arakkoasiedlung nördlich des kaputten Wagens nach einem Lebenszeichen von Dugar.‡‡Sigue buscando rastros de Dugar en el asentamiento arakkoa al norte de la carreta rota.‡Sigue buscando rastros de Dugar en el asentamiento arakkoa al norte de la carreta rota.‡Continuez à chercher des signes de la présence de Dugar dans le village arakkoa, au nord du chariot brisé.‡‡',
  }
},
[9943] = {
  {
    'Return to Thander‡Обратно к Тандеру‡Rückkehr zu Thander‡‡Regresa junto a Thander‡‡Retourner voir Thander‡‡',
    nil,
    'Return to Thander at the Allerian Stronghold with news of your findings.‡Вернитесь к Тандеру в Бастион Аллерии и расскажите ему о том, что вам удалось обнаружить.‡Kehrt mit Euren neuen Erkenntnissen zu Thander in Allerias Feste zurück.‡‡Ve a ver a Thander en el Bastión Allerian e infórmale sobre tus descubrimientos.‡Ve a ver a Thander en el Bastión Allerian e infórmale sobre tus descubrimientos.‡Retournez voir Thander au Bastion allérien pour lui rapporter vos découvertes.‡‡',
  }
},
[9944] = {
  {
    'Cortejo Mag\'hari perdido‡Пропавший маг\'харский караван‡Verschollene mag\'harische Prozession‡실종된 마그하리 행렬‡La procesión Mag\'hari‡La procesión Mag\'hari‡La procession mag\'hari disparue‡失踪的玛格汉车队‡失蹤的瑪格哈利隊伍',
    nil,
    'Procure o Cortejo Mag\'hari perdido.‡Найдите пропавший маг\'харский караван.‡Sucht nach der verschollenen mag\'harischen Prozession.‡실종된 마그하리 행렬을 찾아야 합니다.‡Busca la Procesión Mag\'hari desaparecida.‡Busca la Procesión Mag\'hari desaparecida.‡Cherchez la procession mag\'hari disparue.‡寻找失踪的玛格汉车队。‡尋找失蹤的瑪格哈利隊伍。',
  }
},
[9945] = {
  {
    'Guerra aos Guerramalho‡Войной на Боевой Молот‡Krieg den Totschlägern‡전쟁망치일족 응징‡Sangre en Mazo de Guerra‡Sangre en Mazo de Guerra‡La guerre contre les Cogneguerre‡战槌之战‡戰槌之戰',
    nil,
    'O Ancião Yorley, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você mate 8 Brutamontes Guerramalho e 8 Bruxos Guerramalho.‡Старейшина Йорли из Маг\'харского Каравана в Награнде попросил вас убить 15 громил и 15 чернокнижников клана Боевого Молота.‡Ältester Yorley bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr 15 Schläger der Totschläger und 15 Hexenmeister der Totschläger tötet.‡나그란드의 마그하리 행렬에 있는 장로 요를리가 전쟁망치일족 투사와 전쟁망치일족 흑마법사를 15명씩 해치워 달라고 부탁했습니다.‡El anciano Yorley de la Procesión Mag\'hari en Nagrand quiere que mates a 15 toscos y 15 brujos Mazo de Guerra.‡‡L\'ancien Yorley de la procession Mag\'hari en Nagrand vous a demandé de tuer 8 Brutes Cogneguerre et 8 Démonistes Cogneguerre.‡纳格兰玛格汉车队的长者尤尔雷要求你杀死15个战槌蛮兵和15个战槌术士。‡納葛蘭，瑪格哈利隊伍的長老優兒利要你去殺死15個戰槌蠻卒和15個戰槌術士。',
  }
},
[9946] = {
  {
    'Cho\'war, o Espoliador‡Чо\'вар Погромщик‡Cho\'war der Plünderer‡약탈자 초와르‡Cho\'war el Saqueador‡Cho\'war el Saqueador‡Cho\'war le Pilleur‡掠夺者考瓦尔‡『掠取者』喬沃',
    nil,
    'O Ancião Yorley, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você mate Cho\'war, o Espoliador, e pegue a Cabeça de Cho\'war.‡Убейте Чо\'вара Погромщика и принесите его голову старейшине Йорли в Маг\'харский Караван.‡Ältester Yorley bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr Cho\'war den Plünderer tötet und Cho\'wars Kopf besorgt.‡나그란드의 마그하리 행렬에 있는 장로 요를리가 약탈자 초와르를 해치우고 그 증거를 가져오라고 부탁했습니다.‡El anciano Yorley de la procesión Mag\'hari en Nagrand quiere que mates a Cho\'war el Saqueador y le lleves su cabeza.‡El anciano Yorley de la procesión Mag\'hari en Nagrand quiere que mates a Cho\'war el Saqueador y le lleves su cabeza.‡L’Ancien Yorley, de la Procession mag’hari en Nagrand, vous a demandé de tuer Cho’war le Pilleur, et de récupérer la Tête de Cho\'war.‡纳格兰玛格汉车队的长者尤尔雷要求你杀死掠夺者考瓦尔，并将考瓦尔的头颅带回来复命。‡納葛蘭，瑪格哈利隊伍的長老優兒利要你去殺死『掠取者』喬沃並取得喬沃的頭顱。',
  }
},
[9947] = {
  {
    'Return to Rokag‡Обратно к Рокагу‡Rückkehr zu Rokag‡‡Regresa junto a Rokag‡‡Retourner voir Rokag‡‡',
    nil,
    'Return to Rokag at Stonebreaker Hold with news of your findings.‡Вернитесь к Рокагу в Форт Камнеломов и расскажите ему о том, что вам удалось обнаружить.‡Kehrt mit Euren neuen Erkenntnissen zu Rokag in der Steinbrecherfeste zurück.‡‡Vuelve a ver a Rokag al Bastión Rompepedras e infórmale sobre tus descubrimientos.‡Vuelve a ver a Rokag al Bastión Rompepedras e infórmale sobre tus descubrimientos.‡Retournez voir Rokag au fort des Brise-pierres pour lui rapporter vos découvertes.‡‡',
  }
},
[9948] = {
  {
    'Encontrar os sobreviventes‡Спасательная экспедиция‡Findet die Überlebenden‡생존자 수색‡Encontrando a los supervivientes‡Encontrando a los supervivientes‡À la recherche des survivants‡寻找幸存者‡找到生還者',
    nil,
    'O Ancião Ungriz, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você liberte 5 Prisioneiros Mag\'har.‡Освободите 15 пленных маг\'харов.‡Ältester Ungriz bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr 15 gefangene Mag\'har befreit.‡나그란드의 마그하리 행렬에 있는 장로 운그리즈가 마그하르 포로 15명을 구해 달라고 부탁했습니다.‡El Anciano Ungriz en la Procesión Mag\'hari, en Nagrand, te ha pedido que liberes 15 prisioneros Mag\'har.‡‡L\'ancien Ungriz, à la Procession mag\'hari en Nagrand, vous a demandé de libérer 15 Prisonniers mag\'har.‡纳格兰玛格汉车队的长者安格雷兹要求你去释放15个玛格汉俘虏。‡納葛蘭，瑪格哈利隊伍的長老昂古力斯要你釋放15名瑪格哈囚犯。',
  }
},
[9949] = {
  {
    'A Bird\'s-Eye View‡Птичьи Глаза‡Aus der Vogelperspektive‡‡A vista de pájaro‡‡À vol d\'oiseau‡‡',
    nil,
    'Bring the Eye of Veil Skith, the Eye of Veil Shienor, and the Eye of Veil Reskk to Andarl at the Allerian Stronghold.‡Принесите Око Гнездовья Скит, Око Гнездовья Шиенор и Око Гнездовья Рескк Андарлу в Бастион Аллерии.‡Bringt das Auge des Sktihverstecks, das Auge des Shienorverstecks und das Auge des Reskkverstecks zu Andarl in Allerias Feste.‡‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Andarl en el Bastión Allerian.‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Andarl en el Bastión Allerian.‡Andarl du Bastion allérien veut que vous lui rapportiez l’Œil du Voile Skith, l’Œil du Voile Shienor et l’Œil du Voile Reskk.‡‡',
  }
},
[9950] = {
  {
    'A Bird\'s-Eye View‡Птичьи Глаза‡Aus der Vogelperspektive‡‡A vista de pájaro‡‡À vol d\'oiseau‡‡',
    nil,
    'Bring the Eye of Veil Skith, the Eye of Veil Shienor, and the Eye of Veil Reskk to Kurgatok at Stonebreaker Hold.‡Принесите Око Гнездовья Скит, Око Гнездовья Шиенор и Око Гнездовья Рескк Каргатоку в Форт Камнеломов.‡Bringt das Auge des Sktihverstecks, das Auge des Shienorverstecks und das Auge des Reskkverstecks zu Krugatok in der Steinbrecherfeste.‡‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Kurgatok en el Bastión Rompepedras.‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Kurgatok en el Bastión Rompepedras.‡Apportez l’Œil du Voile Skith, l’Œil du Voile Shienor et l’Œil du Voile Reskk à Kurgatok au fort des Brise-pierres.‡‡',
  }
},
[9951] = {
  {
    'De olho em você!‡Он следит за тобой!‡Es beobachtet Euch!‡당신을 지켜보는 눈‡¡Naphthal\'ar te vigila!‡¡Naphthal\'ar te vigila!‡Il vous regarde !‡它在盯着你！‡它在看著你!',
    nil,
    'Mate Naphthal\'ar e, a seguir, fale novamente com o Guardião Arbórelos na Mata Cenariana, que fica na Mata Terokkar.‡Убейте Нафталара и вернитесь к хранителю Древлосу в перелесок Кенария в лесу Тероккар.‡Tötet Naphthal\'ar und kehrt dann zu Aufseher Baumlas im Cenariusdickicht in den Wäldern von Terokkar zurück.‡나프탈라르를 해치운 후 테로카르 숲의 세나리온 수풀에 있는 교도관 트리로스에게 돌아가야 합니다.‡Mata a Naphthal\'ar y ve a ver al celador Treelos al Matorral Cenarion en el Bosque de Terokkar.‡Mata a Naphthal\'ar y ve a ver al celador Treelos al Matorral Cenarion en el Bosque de Terokkar.‡Tuez Naphthal\'ar puis retournez auprès du gardien Arblos au Fourré cénarien dans la forêt de Terokkar.‡杀死纳弗塔拉，然后返回泰罗卡森林的塞纳里奥树林向监护者忒洛斯复命。‡殺了奈伏薩拉爾再回到泰洛卡森林找塞納里奧灌木林的守望者崔洛斯。',
  }
},
[9952] = {
  {
    'Prospector Balmoral‡Геолог Бальморал‡Ausgrabungsleiter Balmoral‡‡Prospector Balmoral‡‡Le prospecteur Balmoral‡‡',
    nil,
    'Locate and speak with Prospector Balmoral.‡Найдите геолога Бальморала и поговорите с ним.‡Findet und sprecht mit Ausgrabungsleiter Balmoral.‡‡Busca al prospector Balmoral.‡Busca al prospector Balmoral.‡Trouvez le prospecteur Balmoral et parlez-lui.‡‡',
  }
},
[9953] = {
  {
    'Lookout Nodak‡Наблюдатель Нодак‡Aufklärer Nodak‡‡Oteador Nodak‡‡Le guetteur Nodak‡‡',
    nil,
    'Locate and speak with Lookout Nodak.‡Найдите наблюдателя Нодака и поговорите с ним.‡Findet und sprecht mit Aufklärer Nodak.‡‡Busca al oteador Nodak.‡Busca al oteador Nodak.‡Trouvez le guetteur Nodak et parlez-lui.‡‡',
  }
},
[9954] = {
  {
    'O resgate de Corki‡Выкуп за Корки‡Corkis Lösegeld‡코르키의 몸값‡El rescate de Corki‡El rescate de Corki‡La rançon de Corki‡考尔奇的赎金‡柯爾奇的贖金',
    nil,
    'Arechron quer que você encontre Corki no Morro Guerramalho.‡Арехрон просит вас найти Корки на холме Боевого Молота.‡Arechron möchte, dass Ihr Corki auf dem Totschlägerhügel findet.‡아레크론이 전쟁망치 언덕에 있는 코르키를 찾아 달라고 부탁했습니다.‡Arechron quiere que encuentres a Corki en la Colina Mazo de Guerra.‡Arechron quiere que encuentres a Corki en la Colina Mazo de Guerra.‡Arechron veut que vous retrouviez Corki sur la colline des Cogneguerre.‡阿雷克隆要你前往战槌山寻找考尔奇。‡阿爾克隆要你去戰槌山丘找柯爾奇。',
  }
},
[9955] = {
  {
    'Cho\'war, o Espoliador‡Чо\'вар Погромщик‡Cho\'war der Plünderer‡약탈자 초와르‡Cho\'war el Saqueador‡Cho\'war el Saqueador‡Cho\'war le Pilleur‡掠夺者考瓦尔‡『掠取者』喬沃',
    nil,
    'Corki quer que você pegue a chave de Cho\'war e liberte-o da jaula. Caso consiga cumprir essa tarefa, fale novamente com Arechron na vila de Telaar, em Nagrand.‡Найдите Чо\'вара, отберите у него ключ и освободите Корки из клетки. После этого отправляйтесь к Арехрону в Телаар за наградой.‡Corki möchte, dass Ihr Cho\'wars Schlüssel besorgt, um ihn aus dem Käfig zu befreien. Kehrt zu Arechron in Telaar zurück, falls Ihr Erfolg haben solltet.‡초와르의 열쇠를 가져와서 코르키를 감옥에서 꺼내 준 후 텔라아르에 있는 아레크론에게 돌아가야 합니다.‡Corki quiere que consigas la llave de Cho\'war para que puedas liberarle de su jaula. Ve a ver a Arechron en Telaar si lo consigues.‡Corki quiere que consigas la llave de Cho\'war para que puedas liberarle de su jaula. Ve a ver a Arechron en Telaar si lo consigues.‡Corki veut que vous récupériez la Clé de Cho\'war pour le faire sortir de sa cage. Si vous parvenez, allez voir Arechron à Telaar.‡夺得考瓦尔的钥匙，将考尔奇从牢笼中释放出来，完成任务后返回塔拉向阿雷克隆复命。‡柯爾奇要你拿到喬沃的鑰匙，這樣你就可以將他從牢籠中釋放。等你完成了這個任務就回到泰拉找阿爾克隆。',
  }
},
[9956] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die überfallene Karawane‡습격당한 짐마차‡La Caravana Devastada‡La Caravana Devastada‡La caravane dévastée‡不幸的商队‡被破壞的貨車',
    nil,
    'A caçadora Kima, da vila de Telaar, em Nagrand, quer que você recupere 10 caixotes de suprimentos de Telaar.‡Помогите охотнице Киме вернуть 20 телаарских ящиков с припасами.‡Jägerin Kima in Telaar in Nagrand möchte, dass Ihr 20 Vorratskisten von Telaar wiederbesorgt.‡나그란드의 텔라아르에 있는 여사냥꾼 키마가 텔라아르 보급상자 20개를 되찾아 달라고 부탁했습니다.‡La cazadora Kima en Telaar, en Nagrand, quiere que recuperes 20 cajones de suministros de Telaar.‡‡La chasseresse Kima de Telaar en Nagrand, veut que vous récupériez 20 Caisses de fournitures de Telaar.‡收集20个塔拉补给箱，把它们交给塔拉的女猎手琪玛。‡納葛蘭，泰拉的女獵人奇瑪要你取得20個泰拉補給木箱。',
  }
},
[9957] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡¿Qué pasa en el Matorral Cenarion?‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit einem der Druiden beim Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화하십시오.‡Habla con uno de los druidas del Matorral Cenarion en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9958] = {
  {
    'Scouting the Defenses‡Разведка укреплений‡Die Verteidigung ausspähen‡‡Información sobre las defensas‡‡Reconnaissance des défenses‡‡',
    nil,
    'Approach Veil Shalas and observe the town\'s defenses.‡Подойдите поближе к Гнездовью Шалас и осмотрите защитные укрепления городка.‡Begebt Euch in die Nähe des Shalasverstecks und beobachtet die Verteidigungseinrichtungen des Dorfes.‡‡Acércate a Velo Shalas y observa las defensas del lugar.‡Acércate a Velo Shalas y observa las defensas del lugar.‡Approchez-vous du Voile Shalas et examinez les défenses de la ville.‡‡',
  }
},
[9959] = {
  {
    'Scouting the Defenses‡Разведка укреплений‡Die Verteidigung ausspähen‡‡Información sobre las defensas‡‡Reconnaissance des défenses‡‡',
    nil,
    'Approach Veil Shalas and learn about the magic defending the settlement.‡Подойдите поближе к Гнездовью Шалас и постарайтесь узнать, что за магия защищает это поселение.‡Begebt Euch in die Nähe des Shalasverstecks und beobachtet die Verteidigungseinrichtungen des Dorfes.‡‡Acércate a Velo Shalas y observa la magia que utilizan para defender el asentamiento.‡Acércate a Velo Shalas y observa la magia que utilizan para defender el asentamiento.‡Approchez-vous du Voile Shalas et découvrez quels sortilèges protègent la ville.‡‡',
  }
},
[9960] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡Algo pasa en el Matorral Cenarion‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit den Druiden im Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화하십시오.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9961] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡Algo pasa en el Matorral Cenarion‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit den Druiden im Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화해야 합니다.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9962] = {
  {
    'Ringue de Sangue: Carracho‡Кольцо Крови: Хромоног‡Der Ring des Blutes: Schmetterzehe‡피의 투기장: 망치발굽‡El Círculo de Sangre: Dedorroto‡El Círculo de Sangre: Dedorroto‡L\'arène de sang : Brisorteil‡鲜血竞技场：断蹄‡血色競技場:斷趾',
    nil,
    'Derrote o Carracho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Хромоногом. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Schmetterzehe. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡망치발굽을 처치하여 대전에서 승리하면, 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Dedorroto. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Dedorroto. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Triomphez de Brisorteil. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败断蹄，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗斷趾。擊敗他們之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9963] = {
  {
    'Seeking Help from the Source‡Помощь от врага‡Hilfe von der Geißel‡‡Volviendo a los orígenes‡‡Chercher de l\'aide à la source‡‡',
    nil,
    'Find Kokorek in Veil Lithic and speak with him.‡Найдите Кокорека в Гнездовье Литик и поговорите с ним.‡Sucht Kokorek im Lithicversteck und sprecht mit ihm.‡‡Habla con Kokorek en Velo Lítico.‡Habla con Kokorek en Velo Lítico.‡Trouvez Kokorek au Voile Lithic et parlez-lui.‡‡',
  }
},
[9964] = {
  {
    'Seeking Help from the Source‡Помощь от врага‡Hilfe von der Geißel‡‡Volviendo a los orígenes‡‡Chercher de l\'aide à la source‡‡',
    nil,
    'Find Kokorek in Veil Lithic and speak with him.‡Найдите Кокорека в Гнездовье Литик и поговорите с ним.‡Sucht Kokorek im Lithicversteck und sprecht mit ihm.‡‡Habla con Kokorek en Velo Lítico.‡Habla con Kokorek en Velo Lítico.‡Trouvez Kokorek au Voile Lithic et parlez-lui.‡‡',
  }
},
[9965] = {
  {
    'A Show of Good Faith‡Проявление веры‡Guten Willen zeigen‡‡Una muestra de buena fe‡‡Une preuve de bonne volonté‡‡',
    nil,
    'Bring Mug\'gok\'s Head to Kokorek in Veil Lithic.‡Принесите голову Муг\'гока Кокореку в Гнездовье Литик.‡Bringt Mug\'goks Kopf zu Kokorek im Lithicversteck.‡‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Apportez la Tête de Mug\'gok à Kokorek au Voile Lithic.‡‡',
  }
},
[9966] = {
  {
    'A Show of Good Faith‡Проявление веры‡Guten Willen zeigen‡‡Una muestra de buena fe‡‡Une preuve de bonne volonté‡‡',
    nil,
    'Bring Mug\'gok\'s Head to Kokorek in Veil Lithic.‡Принесите голову Муг\'гока Кокореку в Гнездовье Литик.‡Bringt Mug\'goks Kopf zu Kokorek im Lithicversteck.‡‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Apportez la Tête de Mug\'gok à Kokorek au Voile Lithic.‡‡',
  }
},
[9967] = {
  {
    'Ringue de Sangue: Gêmeos Cara de Pau‡Кольцо Крови: братья Блю‡Der Ring des Blutes: Die Blaumänner‡피의 투기장: 푸른 형제들‡El Círculo de Sangre: los hermanos azules‡El Círculo de Sangre: los hermanos azules‡L\'arène de sang : les Grands Bleus‡鲜血竞技场：蓝色兄弟‡血色競技場:憂鬱兄弟黨',
    nil,
    'Derrote os gêmeos Sangue-de-lodo conhecidos como Gêmeos Cara de Pau. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над близнецами из племени Темной Крови, которые называют себя "Братья Блю". После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt die Zwillinge der Finsterblut, die sich selbst die "Blaumänner" nennen. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡자칭 푸른 형제들이라는 수렁피일족 쌍둥이와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a los gemelos Sangreoscura que se hacen llamar los Hermanos azules. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a los gemelos Sangreoscura que se hacen llamar los Hermanos azules. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Battre les Jumeaux bourbesang, qui se font appeler les Grands Bleus. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败自称为蓝色兄弟的暗血双胞胎，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗自稱憂鬱兄弟的黑暗之血雙子。擊敗他們之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9968] = {
  {
    'Estranha energia‡Странная энергия‡Fremde Energien‡이상한 기운‡Extraña energía‡Extraña energía‡Énergie étrange‡奇怪的能量‡奇怪的能量',
    nil,
    'Colete 4 Amostras de Teralépidas e 4 Amostras de Teralépidas Cruéis. Depois, fale novamente com o Ataterra Tavgren. Você pode encontrá-lo perto da Mata Cenariana, que fica na Mata Terokkar.‡Соберите 4 образца пухоспинки и 4 образца агрессивной пухоспинки для заклинателя земли Тавгрена. Его можно найти возле перелеска Кенария в лесу Тероккар.‡Sammelt 4 Teromottenproben und 4 Proben einer bösartigen Teromotte. Kehrt dann zu Erdbinder Tavgren beim Cenariusdickicht in den Wäldern von Terokkar zurück.‡테로나방 견본과 흉포한 테로나방 견본을 4개씩 모아서 테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌에게 돌아가십시오.‡Consigue 4 muestras de teropolilla y 4 muestras de teropolilla sañosa. Después ve a ver al vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡‡Collectez 4 Spécimens de terophalènes et 4 Spécimens de terophalènes vicieux. Puis retournez auprès du lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡收集4份巨蛾样本和4份邪恶巨蛾样本，然后向塞纳里奥树林外的缚地者塔弗格伦复命。‡收集4個泰洛飛蛾樣本和4個兇惡的泰洛飛蛾樣本。再回到泰洛卡森林找塞納里奧灌木林外的大地束縛者塔伏格蘭。',
  }
},
[9969] = {
  {
    'The Final Reagents‡Последние реагенты‡Die letzten Reagenzien‡‡Los componentes finales‡‡Les derniers composants‡‡',
    nil,
    'Bring 5 Warp Hunter Essences and 30 Terokkar Chokeberries to Kokorek in Veil Lithic.‡Принесите 5 сущностей прыгуаны-охотника и 30 ягод тероккарской черной рябины Кокореку в Гнездовье Литик.‡Bringt 5 Sphärenpirscheressenzen und 30 Apfelbeeren von Terokkar zu Kokorek im Lithicversteck.‡‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Apportez 5 Essences de chasseur dimensionnel et 30 Airelles de Terokkar à Kokorek au Voile Lithic.‡‡',
  }
},
[9970] = {
  {
    'Ringue de Sangue: Rokdar, o Lorde Partido‡Кольцо Крови: Камнедар Выщербленный Повелитель‡Der Ring des Blutes: Rokdar der Zerklüftete‡피의 투기장: 파괴의 군주 로크다르‡El Círculo de Sangre: Rokdar el Señor Hendido‡El Círculo de Sangre: Rokdar el Señor Hendido‡L\'arène de sang : Rokdar le Seigneur scindé‡鲜血竞技场：裂石之王洛卡达尔‡血色競技場:『碎裂領主』洛克達',
    nil,
    'Derrote Rokdar, o Lorde Partido. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Победите Камнедара Выщербленного Повелителя. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Rokdar den Zerklüfteten. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡파괴의 군주 로크다르와의 대전에서 승리한 후, 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Rokdar el Lord Hendido. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Rokdar el Lord Hendido. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Battre Rokdar le Seigneur scindé. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败裂石之王洛卡达尔，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗『碎裂領主』洛克達。獲勝之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9971] = {
  {
    'Pistas na mata‡Ответы в чащобе‡Hinweise im Dickicht‡수풀 안의 단서‡Pistas en el Matorral‡Pistas en el Matorral‡Des indices au Fourré‡树林中的线索‡樹叢裡的線索',
    nil,
    'Investigue o Objeto Estranho perto do Cadáver do Degradado para determinar o que pode ter acontecido na Mata Cenariana. A seguir, fale novamente com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, que fica na Mata Terokkar.‡Осмотрите странный предмет рядом с трупом Сломленного и постарайтесь узнать, что случилось в перелеске Кенария. Затем вернитесь к заклинателю земли Тавгрену в лес Тероккар.‡Untersucht das merkwürdige Objekt neben der Leiche eines Zerschlagenen um herauszufinden, was hinter der Tragödie beim Cenariusdickicht steckt. Kehrt dann zu Erdbinder Tavgren außerhalb des Dickichts in den Wäldern von Terokkar zurück.‡세나리온 수풀에서 벌어진 비극 뒤에 숨어 있는 비밀을 밝힐 단서인 뒤틀린 드레나이 시체 옆에 있는 이상한 물체를 조사해야 합니다. 그런 다음 테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌에게 돌아가십시오.‡Investiga el objeto extraño cerca del cadáver de Tábido para intentar averiguar lo que ocurrió en el Matorral Cenarion. Vuelve a ver al vinculador terrestre Tavgren al salir del matorral en el Bosque de Terokkar.‡Investiga el objeto extraño cerca del cadáver de Tábido para intentar averiguar lo que ocurrió en el Matorral Cenarion. Vuelve a ver al vinculador terrestre Tavgren al salir del matorral en el Bosque de Terokkar.‡Examinez l\'Objet étrange à côté du Cadavre de Roué pour découvrir ce qui a pu frapper le Fourré cénarien. Puis retournez auprès du lieur de terre Tavgren juste à l\'extérieur du fourré dans la forêt de Terokkar.‡调查破碎者的尸体旁的奇怪物体，看看究竟是什么在滋扰塞纳里奥树林，然后向塞纳里奥树林外的缚地者塔弗格伦复命。‡調查破碎的屍體旁邊的奇怪的物品來判定塞納里奧灌木林發生過什麼事。再回到泰洛卡森林外找大地束縛者塔伏格蘭。',
  }
},
[9972] = {
  {
    'Ringue de Sangue: Skra\'gath‡Кольцо Крови: Скрагат‡Der Ring des Blutes: Skra\'gath‡피의 투기장: 스크라가스‡El Círculo de Sangre: Skra\'gath‡El Círculo de Sangre: Skra\'gath‡L\'arène de sang : Skra\'gath‡鲜血竞技场：瑟克拉加斯‡血色競技場:史卡拉克斯',
    nil,
    'Derrote Skra\'gath. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Скрагатом. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Skra\'gath. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡스크라가스와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Skra\'gath. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Skra\'gath. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Battre Skra\'gath. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败瑟克拉加斯，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗史卡拉克斯。獲勝之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9973] = {
  {
    'Ringue de Sangue: O Campeão Guerramalho‡Кольцо Крови: чемпион клана Боевого Молота‡Der Ring des Blutes: Champion der Totschläger‡피의 투기장: 전쟁망치일족 용사‡El Círculo de Sangre: el campeón Mazo de Guerra‡El Círculo de Sangre: el campeón Mazo de Guerra‡L\'arène de sang : le champion Cogneguerre‡鲜血竞技场：战槌勇士‡血色競技場:戰槌勇士',
    nil,
    'Derrote o Campeão Guerramalho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над чемпионом клана Боевого Молота. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt den Champion der Totschläger. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener, um Eure Belohnung zu erhalten.‡전쟁망치일족 용사와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota al campeón Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota al campeón Mazo de Guerra. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Battre le Champion Cogneguerre. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败战槌勇士，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗戰槌勇士。獲勝之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9974] = {
  {
    'The Final Reagents‡Последние реагенты‡Die letzten Reagenzien‡‡Los componentes finales‡‡Les derniers composants‡‡',
    nil,
    'Bring 5 Warp Hunter Essences and 30 Terokkar Chokeberries to Kokorek at Veil Lithic.‡Принесите 5 сущностей прыгуаны-охотника и 30 ягод тероккарской черной рябины Кокореку в Гнездовье Литик.‡Bringt 5 Sphärenpirscheressenzen und 30 Apfelbeeren von Terokkar zu Kokorek im Lithicversteck.‡‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Apportez 5 Essences de chasseur dimensionnel et 30 Airelles de Terokkar à Kokorek au Voile Lithic.‡‡',
  }
},
[9975] = {
  {
    'Primal Magic‡Изначальная магия‡Urmagie‡‡Magia primigenia‡‡Magie primordiale‡‡',
    nil,
    'Use Kokorek\'s Talisman near the totems that guard the path to Veil Shalas, then speak with Prospector Balmoral.‡Используйте талисман Кокорека возле тотемов, охраняющих завесу Шалас, после чего поговорите с геологом Бальморалом.‡Benutzt Kokoreks Talisman in der Nähe der Totems, die den Weg ins Shalasversteck bewachen, und sprecht dann mit Ausgrabungsleiter Balmoral.‡‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el prospector Balmoral.‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el prospector Balmoral.‡Utilisez le Talisman de Kokorek près des totems qui gardent la route du Voile Shalas, puis parlez au prospecteur Balmoral.‡‡',
  }
},
[9976] = {
  {
    'Primal Magic‡Изначальная магия‡Urmagie‡‡Magia primigenia‡‡Magie primordiale‡‡',
    nil,
    'Use Kokorek\'s Talisman near the totems that guard the path to Veil Shalas, then speak with Lookout Nodak.‡Используйте талисман Кокорека возле тотемов, охраняющих завесу Шалас, после чего поговорите с наблюдателем Нодаком.‡Benutzt Kokoreks Talisman in der Nähe der Totems, die den Weg ins Shalasversteck bewachen, und sprecht dann mit Aufklärer Nodak.‡‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el oteador Nodak.‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el oteador Nodak.‡Utilisez le Talisman de Kokorek près des totems qui gardent la route du Voile Shalas, puis parlez au guetteur Nodak.‡‡',
  }
},
[9977] = {
  {
    'Ringue de Sangue: o desafio final‡Кольцо Крови: последнее испытание‡Der Ring des Blutes: die letzte Herausforderung‡피의 투기장: 마지막 도전‡El Círculo de Sangre: el desafío final‡El Círculo de Sangre: el desafío final‡L\'arène de sang : l\'ultime défi‡鲜血竞技场：终极挑战‡血色競技場:最後的挑戰',
    nil,
    'Derrote Mogor, herói dos Guerramalho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Могором, героем клана Боевого Молота. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Mogor, Held der Totschläger. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡전쟁망치일족의 영웅인 모고르와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해아 합니다.‡Derrota a Mogor, héroe de los Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Mogor, héroe de los Mazo de Guerra. Si lo logras, habla con Wodin, el sirviente trol, para recibir tu recompensa.‡Battre Mogor, héros des Cogneguerre. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败战槌英雄穆戈尔，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗戰槌的英雄，莫古。獲勝之後跟食人妖僕人伍德林領取獎賞。',
  }
},
[9978] = {
  {
    'Custe o que custar‡Любыми средствами‡Mit allen Mitteln‡모든 방법을 동원하여...‡Cueste lo que cueste‡Cueste lo que cueste‡Par tous les moyens nécessaires‡不择手段‡用盡所有必須的手段',
    nil,
    'Encontre Empur na estrada entre Tuurem e Shattrath, na Mata Terokkar. Convença-o a dizer o que sabe.‡Найдите Эмпура и убедите его рассказать вам все, что ему известно.‡Findet Empoor und bringt ihn dazu, Euch zu erzählen, was Ihr wissen wollt.‡엠푸르를 찾아 알고 있는 사실을 말하도록 설득해야 합니다.‡Encuentra a Empoor y convéncele para que te diga lo que sabe.‡‡Trouvez Empoor sur la route entre Tuurem et Shattrath, dans la Forêt de Terokkar. Puis convainquez-le de vous dire ce qu\'il sait.‡找到并说服埃博尔将他所知道的一切都告诉你。‡找到並說服安普爾，使他告訴你所知道的事。',
  }
},
[9979] = {
  {
    'Lathrai, o Mercador do Vento‡Латрай Торговец Ветром‡Windhändler Lathrai‡바람의 무역상 라스라이‡Comerciante de viento Lathrai‡Comerciante de viento Lathrai‡Le marchand des vents Lathrai‡星界商人拉斯莱‡風之貿易者拉斯蕊',
    nil,
    'Fale com Lathrai, o Mercador do Vento. Você pode encontrá-lo perto da Taberna Fim do Mundo, localizada no Bairro Inferior, em Shattrath.‡Поговорите с торговцем ветром Латраем возле таверны "На краю земли" в Нижнем городе Шаттрата.‡Sprecht mit Windhändler Lathrai in der Nähe der Taverne Weltenend im unteren Viertel in Shattrath.‡샤트라스의 고난의 거리에 있는 세상의 끝 선술집 근처의 바람의 무역상 라스라이와 대화하십시오.‡Habla con el comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo en la sección del Bajo Arrabal de la Ciudad de Shattrath.‡Habla con el comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo en la sección del Bajo Arrabal de la Ciudad de Shattrath.‡Parlez au Marchand des vents Lathrai près de la Taverne de la Fin du monde dans la Ville basse à Shattrath.‡与沙塔斯城贫民窟天涯旅店附近的星界商人拉斯莱谈一谈。‡到撒塔斯的陰鬱城和世界的盡頭小酒館的拉斯蕊談談。',
  }
},
[9980] = {
  {
    'Rescue Deirom!‡Спасите Дейрома!‡Rettet Deirom!‡‡¡Rescata a Deirom!‡‡Sauvez Deirom !‡‡',
    nil,
    'Venture into Veil Shalas, kill Luanga, and free Deirom. Report to Lady Dena Kennedy at the Allerian Stronghold when you have completed your mission.‡Проберитесь в гнездовье Шалас, убейте Луангу и освободите Дейрома, после чего доложитесь Леди Дене Кеннеди в Бастионе Аллерии.‡Begebt Euch ins Shalasversteck, tötet Lunga und befreit Deirom. Meldet Euch bei Lady Dana Kennedy in Allerias Feste, wenn Ihr Euren Auftrag erledigt habt.‡‡Ve a Velo Shalas, mata a Luanga y libera a Deirom. Preséntate ante Lady Dena Kennedy en el Bastión Allerian cuando hayas completado tu misión.‡Ve a Velo Shalas, mata a Luanga y libera a Deirom. Preséntate ante Lady Dena Kennedy en el Bastión Allerian cuando hayas completado tu misión.‡Pénétrez dans le Voile Shalas, tuez Luanga et libérez Deirom. Faites votre rapport à dame Dena Kennedy au Bastion allérien lorsque vous aurez accompli votre mission.‡‡',
  }
},
[9981] = {
  {
    'Rescue Dugar!‡Спасите Дугара!‡Rettet Dugar!‡‡¡Rescata a Dugar!‡‡Sauvez Dugar !‡‡',
    nil,
    'Venture into Veil Shalas, kill Luanga, and free Dugar. Report to Rokag at Stonebreaker Hold when you have completed your mission.‡Проберитесь в завесу Шалас, убейте Луангу и освободите Дейрома, после чего доложитесь Рокагу в Форте Камнеломов.‡Begebt Euch ins Shalasversteck, tötet Lunga und befreit Dugar. Meldet Euch bei Rokag in der Steinbrecherfeste, wenn Ihr Euren Auftrag erledigt habt.‡‡Ve a Velo Shalas, mata a Luanga y libera a Dugar. Preséntate ante Rokag en el Bastión Rompepedras cuando hayas completado tu misión.‡Ve a Velo Shalas, mata a Luanga y libera a Dugar. Preséntate ante Rokag en el Bastión Rompepedras cuando hayas completado tu misión.‡Pénétrez dans le Voile Shalas, tuez Luanga et libérez Dugar. Faites votre rapport à Rokag au fort des Brise-pierres lorsque vous aurez accompli votre mission.‡‡',
  }
},
[9982] = {
  {
    'Ele se chamava Altruis...‡Его звали Алтруис...‡Er nannte sich Altruis...‡알트루이스라 부르는 사나이...‡Se hacía llamar Altruis...‡Se hacía llamar Altruis...‡Il se fait appeler Altruis...‡他叫奥图里斯......‡他自稱奧翠司……',
    nil,
    'Se você deseja lutar contra a Legião Ardente, procure Altruis, O Sofredor, no oeste de Nagrand.‡Если у вас есть желание сразиться с Пылающим Легионом, разыщите Алтруиса Страдальца в западном Награнде.‡Wenn Ihr die Brennende Legion bekämpfen wollt, sucht Altruis den Leider im Westen von Nagrand.‡불타는 군단과 싸우고자 한다면 나그란드 서부에 있는 고뇌의 알트루이스를 찾아가야 합니다.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si vous cherchez à affronter la Légion ardente, allez trouver Altruis le Souffrant dans l\'ouest de Nagrand.‡如果你想与燃烧军团作战，就到纳格兰西部去找到受难者奥图里斯。‡如果你想與燃燒軍團挑戰就到西納葛蘭去找『受難者』奧翠司。',
  }
},
[9983] = {
  {
    'Ele se chamava Altruis...‡Его звали Алтруис...‡Er nannte sich Altruis...‡고뇌의 알트루이스‡Se hacía llamar Altruis...‡Se hacía llamar Altruis...‡Il se fait appeler Altruis...‡他叫奥图里斯......‡他自稱奧翠司……',
    nil,
    'Se você deseja lutar contra a Legião Ardente, procure Altruis, O Sofredor, no oeste de Nagrand.‡Если у вас есть желание сразиться с Пылающим Легионом, разыщите Алтруиса Страдальца в западном Награнде.‡Wenn Ihr die Brennende Legion bekämpfen wollt, sucht Altruis den Leider im Westen von Nagrand.‡불타는 군단과 싸우고자 한다면 나그란드 서부에 있는 고뇌의 알트루이스를 찾아가야 합니다.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si vous cherchez à affronter la Légion ardente, allez trouver Altruis le Souffrant dans l\'ouest de Nagrand.‡如果你想与燃烧军团作战，就到纳格兰西部去找到受难者奥图里斯。‡如果你想與燃燒軍團挑戰就到西納葛蘭去找『受難者』奧翠司。',
  }
},
[9984] = {
  {
    'Anfitrião da cidade secreta‡Хозяин Сокрытого Города‡Der Herr der versteckten Stadt‡숨겨진 도시의 주인‡Anfitrión de la ciudad oculta‡‡L\'hôte de la cité cachée‡隐秘之城‡隱秘城市的主人',
    nil,
    'Leve as Ordens de Luanga para Andarl. Você pode encontrá-lo na Fortaleza Alleriana, na Mata Terokkar.‡Отнесите приказы Луанги Андарлу в бастион Аллерии, что в лесу Тероккар.‡Bringt Luangas Befehle zu Andarl in Allerias Feste in den Wäldern von Terokkar.‡알레리아 성채에 있는 안다를에게 루앙가의 명령서를 가져가야 합니다.‡Lleva las órdenes de Luanga a Andarl al Bastión Allerian, en el Bosque de Terokkar.‡‡Apportez les Ordres de Luanga à Andarl au Bastion allérien.‡将卢埃加的命令交给泰罗卡森林中奥蕾莉亚要塞的安达尔。‡將盧安卡的命令交給艾蘭里堡壘的安達爾歐。',
  }
},
[9985] = {
  {
    'Anfitrião da cidade secreta‡Хозяин Сокрытого Города‡Der Herr der versteckten Stadt‡숨겨진 도시의 주인‡Anfitrión de la ciudad oculta‡‡L\'hôte de la cité cachée‡隐秘之城‡隱秘城市的主人',
    nil,
    'Leve as Ordens de Luanga para Kurgatok na Vila de Quebrapedra, que fica na Mata Terokkar.‡Отнесите приказы Луанги Каргатоку в форт Камнеломов.‡Bringt Luangas Befehle zu Kurgatok in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 쿠르가톡에게 루앙가의 명령서를 가져가야 합니다.‡Lleva las órdenes de Luanga a Kurgatok al Bastión Rompepedras, en el Bosque de Terokkar.‡‡Apportez les Ordres de Luanga à Kurgatok au fort des Brise-pierres.‡‡將盧安卡的命令交給碎石堡的庫爾卡拓克。',
  }
},
[9986] = {
  {
    'Para atrapalhar os arakkoas‡Сдержать араккоа‡Die Arakkoa hindern‡아라코아 방해하기‡Frustrando los planes de los arakkoas‡Frustrando los planes de los arakkoa‡S\'opposer aux arakkoa‡教训鸦人‡阻礙阿拉卡',
    nil,
    'Mate Ashkaz, no Véu Reskk; Ayit, no Véu Shienor e Urdak, no Véu Skith. A seguir, fale novamente com Thander, na Fortaleza Alleriana.‡Убейте Ашказа в гнездовье Рескк, Аийта в гнездовье Шиенор и Урдака в гнездовье Скит, после чего вернитесь к Тандеру в бастион Аллерии.‡Tötet Ashkaz im Reskkversteck, Ayit im Shienorversteck und Urdak im Skithversteck und kehrt dann zu Thander in Allerias Feste zurück.‡장막의 레스크의 아쉬카즈, 장막의 쉬에노르의 아이트, 장막의 스키스의 우르닥을 처치한 후 알레리아 성채에 있는 탠더에게 돌아가야 합니다.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Thander en el Bastión Allerian.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Thander en el Bastión Allerian.‡Tuez Ashkaz au Voile Reskk, Ayit au Voile Shienor et Urdak au Voile Skith, puis retournez voir Thander au Bastion allérien.‡杀死里斯克鸦巢的阿什卡兹，西诺鸦巢的埃伊特和基斯鸦巢的乌达克，然后返回奥蕾莉亚要塞向山德复命。‡殺死迷霧瑞斯克的阿斯卡斯、迷霧辛諾的阿翼特和迷霧斯奇司的烏達克再回到艾蘭里堡壘找薩德爾。',
  }
},
[9987] = {
  {
    'Para atrapalhar os arakkoas‡Сдержать араккоа‡Die Arakkoa hindern‡아라코아 좌절시키기‡Frustrando los planes de los arakkoas‡Frustrando los planes de los arakkoa‡S\'opposer aux arakkoa‡教训鸦人‡阻礙阿拉卡',
    nil,
    'Mate Ashkaz, no Véu Reskk; Ayit, no Véu Shienor e Urdak, no Véu Skith. A seguir, fale novamente com Rokar, na Vila de Quebrapedra.‡Убейте Ашказа в гнездовье Рескк, Айита в гнездовье Шиенор и Урдака в гнездовье Скит, после чего вернитесь к Рокагу в форт Камнеломов.‡Tötet Ashkaz im Reskkversteck, Ayit im Shienorversteck und Urdak im Skithversteck und kehrt dann zu Rokag in der Steinbrecherfeste zurück.‡장막의 레스크의 아쉬카즈, 장막의 쉬에노르의 아이트, 장막의 스키스의 우르닥을 해치운 후 돌망치 요새에 있는 로카그에게 돌아가십시오.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Rokag en el Bastión Rompepedras.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Rokag en el Bastión Rompepedras.‡Tuez Ashkaz au Voile Reskk, Ayit au Voile Shienor et Urdak au Voile Skith, puis retournez voir Rokag au fort des Brise-pierres.‡杀死里斯克鸦巢的阿什卡兹，西诺鸦巢的埃伊特和基斯鸦巢的乌达克，然后返回裂石堡向罗卡格复命。‡殺死迷霧瑞斯克的阿斯卡斯，迷霧辛諾的阿翼特，和迷霧斯奇司的烏達克再回到碎石堡找瑞克格。',
  }
},
[9988] = {
  {
    'O melhor amigo do janota‡Лучший друг щеголя‡Der beste Freund eines Gecken‡멋쟁이들의 필수품‡El mejor amigo de un dandi‡‡Le meilleur ami des élégants‡公子哥的好朋友‡花花公子的知音',
    nil,
    'Traga 30 Penas de Arakkoa para Ros\'eleth, na Fortaleza Alleriana.‡Принесите 30 перьев араккоа Роз\'алете в Бастион Аллерии.‡Bringt 30 Arakkoafedern zu Ros\'eleth in Allerias Feste.‡알레리아 성채에 있는 로스엘레스에게 아라코아 깃털 30개를 가져가야 합니다.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Apportez 30 Plumes d\'arakkoa à Ros\'eleth au Bastion allérien.‡给奥蕾莉亚要塞的洛瑟蕾丝带回30片鸦人的羽毛。‡將30根阿拉卡羽毛交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[9989] = {
  {
    'Espíritos alienígenas‡Неведомые духи‡Fremde Geister‡낯선 영혼들‡Espíritus extraños‡‡Des esprits étrangers‡‡不同的靈魂',
    nil,
    'Traga 30 Penas de Arakkoa para Malkaz, na Vila de Quebrapedra.‡Принесите 30 перьев араккоа Малуказу в форт Камнеломов.‡Bringt 30 Arakkoafedern zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 아라코아 깃털 30개를 가져가야 합니다.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Apportez 30 Plumes d\'arakkoa à Malukaz au fort des Brise-pierres.‡‡將30根阿拉卡羽毛交給碎石堡的瑪魯卡茲。',
  }
},
[9990] = {
  {
    'Investigação em Tuurem‡Исследование Туурема‡Untersuchung von Tuurem‡투렘 조사‡Investigación de Tuurem‡Investigación de Tuurem‡Enquête à Tuurem‡调查图雷姆‡調查杜瑞',
    nil,
    'Encontre a Caixa Lacrada e entregue-a para o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, que fica na Mata Terokkar.‡Найдите запечатанный ларец и отнесите его заклинателю земли Тавгрену. Тавгрена можно найти около перелеска Кенария в лесу Тероккар.‡Findet den versiegelten Kasten und bringt ihn zu Erdbinder Tavgren beim Cenariusdickicht in den Wäldern von Terokkar.‡봉인된 상자를 찾아서 테로카르 숲의 세나리온 수풀 바로 바깥에 있는 대지의 결속자 타브그렌에게 전달해야 합니다.‡Encuentra la caja sellada y entrégasela al vinculador terrestre Tavgren justo fuera del Matorral Cenarion en el Bosque de Terokkar.‡Encuentra la caja sellada y entrégasela al vinculador terrestre Tavgren justo fuera del Matorral Cenarion en el Bosque de Terokkar.‡Trouvez la Boîte scellée puis apportez-la au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡找到密封的盒子，将其交给塞纳里奥树林外的缚地者塔弗格伦。‡找到密封的箱子再將它送到泰洛卡森林交給塞納里奧灌木林外的大地束縛者塔伏格蘭。',
  }
},
[9991] = {
  {
    'Sondagem das terras‡Разведка‡Inspektion des Lagers‡기지 조사‡Inspeccionar la tierra‡Inspeccionar la tierra‡Observer le terrain‡侦查大地‡調查土地',
    nil,
    'Relaxe e aproveite o passeio. Ao terminar a sondagem, fale novamente com Altruis.‡Приведите спинку кресла в вертикальное положение и пристегните ремни безопасности. Приятного полета! Когда закончите осмотр лагерей с воздуха, доложите Алтруису обо всем, что вы видели.‡Lehnt Euch zurück und genießt Euren Flug. Sprecht mit Altruis wenn die Besichtigung abgeschlossen ist.‡편히 앉아 비행을 즐기십시오. 조사가 끝나면 알트루이스와 대화하면 됩니다.‡Siéntate y disfruta del paseo. Habla con Altruis cuando hayas terminado la inspección.‡Siéntate y disfruta del paseo. Habla con Altruis cuando hayas terminado la inspección.‡Asseyez-vous et profitez du voyage. Parlez à Altruis quand vous aurez terminé l\'observation.‡好好享受这趟旅程吧。调查完毕之后跟奥图里斯谈一谈。‡坐好享受旅程。等調查完成後和奧翠司談談。',
  }
},
[9992] = {
  {
    'Sementes de olemba‡Семена олембы‡Olembasamen‡올렘바 씨앗‡Semillas de olemba‡Semillas de olemba‡Graines d\'olemba‡奥雷巴种子‡奧萊姆貝種子',
    nil,
    'Colete 30 Sementes de Olemba e entregue-as para Ros\'eleth, na Fortaleza Alleriana.‡Соберите 30 семян олембы и отнесите их Роз\'алете в бастион Аллерии.‡Sammelt 30 Olembasamenkörner und kehrt dann zu Ros\'eleth in Allerias Feste zurück.‡올렘바 씨앗 30개를 모아서 알레리아 성채에 있는 로스엘레스에게 가져가야 합니다.‡Consigue 30 semillas de olemba y llévaselas a Ros\'eleth en el Bastión Allerian.‡Consigue 30 semillas de olemba y llévaselas a Ros\'eleth en el Bastión Allerian.‡Ramassez 30 Graines d\'olemba et apportez-les à Ros\'eleth au Bastion allérien.‡收集30颗奥雷巴种子，把它们交给奥蕾莉亚要塞的洛瑟蕾丝。‡收集30顆奧萊姆貝種子交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[9993] = {
  {
    'Óleo de semente de olemba‡Масло из семян олембы‡Olembaöl‡올렘바 씨앗 기름‡Aceite de semilla de olemba‡Aceite de semilla de olemba‡Huile de graines d\'olemba‡奥雷巴油‡奧萊姆貝種子油',
    nil,
    'Traga 30 Sementes de Olemba para Rakoria, na Vila de Quebrapedra.‡Принесите 30 семян олембы Ракории в форт Камнеломов.‡Bringt 30 Olembasamenkörner zu Rakoria in der Steinbrecherfeste.‡돌망치 요새에 있는 라코리아에게 올렘바 씨앗 30개를 가져가야 합니다.‡Lleva 30 semillas de olemba a Rakoria, en el Bastión Rompepedras.‡Lleva 30 semillas de olemba a Rakoria, en el Bastión Rompepedras.‡Apportez 30 Graines d\'olemba à Rakoria au fort des Brise-pierres.‡将30颗奥雷巴种子交给裂石堡的拉克妮亚。‡將30顆奧萊貝種子交給碎石堡的瑞克利亞。',
  }
},
[9994] = {
  {
    'O que são essas coisas?‡Что это такое?‡Was ist das?‡물건의 정체‡¿Qué son estas cosas?‡¿Qué son estas cosas?‡Que sont ces choses ?‡这些东西是什么？‡這些是什麼東西?',
    nil,
    'Entregue a Caixa de Peças para Jenai Sussurrastra na Fortaleza Alleriana, que fica na Mata Terokkar.‡Доставьте ящик с деталями Дженайе Шепот Звезд в бастион Аллерии в лесу Тероккар.‡Bringt den Kasten mit Ersatzteilen zu Jenai Sternwisper in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 지나이 스타위스퍼에게 부품 상자를 전달해야 합니다.‡Lleva la caja de piezas a Jenai Susurrestelar en el Bastión Allerian, en el Bosque de Terokkar.‡Lleva la caja de piezas a Jenai Susurrestelar en el Bastión Allerian, en el Bosque de Terokkar.‡Apportez la Boîte de pièces détachées à Jenai Murmétoile au Bastion allérien dans la forêt de Terokkar.‡将这一箱零件交给泰罗卡森林奥蕾莉亚要塞的杰奈·星语。‡將一箱零件運回泰洛卡森林交給艾蘭里堡壘的珍奈·星語。',
  }
},
[9995] = {
  {
    'O que são essas coisas?‡Что это такое?‡Was ist das?‡뭐야, 이건?‡¿Qué son estas cosas?‡¿Qué son estas cosas?‡Que sont ces choses ?‡这些东西是什么？‡這些是什麼東西?',
    nil,
    'Entregue a Caixa de Peças para Tooki na Vila de Quebrapedra, que fica na Mata Terokkar.‡Доставьте ящик с деталями Туки в форт Камнеломов в лесу Тероккар.‡Bringt den Kasten mit Ersatzteilen zu Tooki in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 투키에게 부품 상자를 가져가야 합니다.‡Lleva la caja de piezas a Tooki en el Bastión Rompepedras, en el Bosque de Terokkar.‡Lleva la caja de piezas a Tooki en el Bastión Rompepedras, en el Bosque de Terokkar.‡Apportez la Boîte de pièces détachées à Tooki au fort des Brise-Pierres dans la forêt de Terokkar.‡将这一箱零件交给泰罗卡森林裂石堡的图基。‡將一箱零件運回泰洛卡森林交給碎石堡的吐奇。',
  }
},
[9996] = {
  {
    'Ataque ao Pontal Asardente‡Нападение на лагерь Огнекрылых‡Angriff auf den Posten der Feuerschwingen‡불꽃날개 거점 공격‡Ataque en el Alto Ala de Fuego‡Ataque en el Alto Ala de Fuego‡L\'attaque de la halte Aile-de-feu‡攻击火翼岗哨‡攻擊火翼崗哨',
    nil,
    'Mate 10 Defensores Asardentes, 10 Guarda-sangues Asardentes e 10 Bruxos Asardentes. A seguir, fale novamente com o Tenente Meridian no Posto Alleriano, que fica na Mata Terokkar.‡Убейте 10 защитников, 10 кровавых стражей и 10 чернокнижников из армии Огнекрылых, после чего вернитесь к лейтенанту Меридиану на заставу Аллерии в лесу Тероккар.‡Tötet 10 Verteidiger der Feuerschwingen, 10 Blutwärter der Feuerschwingen und 10 Hexenmeister der Feuerschwingen. Meldet Euch dann bei Leutnant Meridian bei Allerias Posten in den Wäldern von Terokkar zurück.‡불꽃날개 파수병 10명, 불꽃날개 붉은경비병 10명, 불꽃날개 흑마법사 10명을 처치한 후, 테로카르 숲의 알레리아 초소에 있는 부관 메르디앙에게 보고하십시오.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al teniente Meridiano en el Puesto Allerian del Bosque de Terokkar.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al teniente Meridiano en el Puesto Allerian del Bosque de Terokkar.‡Tuez 10 Défenseurs Aile-de-feu, 10 Garde-sang Aile-de-feu et 10 Démonistes Aile-de-feu. Puis retournez au Poste allérien dans la forêt de Terokkar pour faire votre rapport au lieutenant Meridian.‡杀死10个火翼防御者、10个火翼血警卫和10个火翼术士，然后向泰罗卡森林奥蕾莉亚岗哨的米利迪安中尉复命。‡殺死10個火翼防衛者，10個火翼血守衛，10個火翼術士。再回到泰洛卡森林向艾蘭里哨站的莫瑞狄恩中尉回報。',
  }
},
[9997] = {
  {
    'Ataque ao Pontal Asardente‡Нападение на лагерь Огнекрылых‡Angriff auf den Posten der Feuerschwingen‡불꽃날개 거점 공격‡Ataque en el Alto Ala de Fuego‡Ataque en el Alto Ala de Fuego‡L\'attaque de la halte Aile-de-feu‡攻击火翼岗哨‡攻擊火翼崗哨',
    nil,
    'Mate 10 Defensores Asardentes, 10 Guarda-sangues Asardentes e 10 Bruxos Asardentes. A seguir, apresente-se à Sargento Chawni no Acampamento Quebrapedra, que fica na Mata Terokkar.‡Убейте 10 защитников, 10 кровавых стражей и 10 чернокнижников из армии Огнекрылых, после чего поговорите с сержантом Чауни в лагере Камнеломов, что в лесу Тероккар.‡Tötet 10 Verteidiger der Feuerschwingen, 10 Blutwärter der Feuerschwingen und 10 Hexenmeister der Feuerschwingen. Meldet Euch dann bei Unteroffizier Chawni im Steinbrecherlager in den Wäldern von Terokkar zurück.‡불꽃날개 파수병, 불꽃날개 붉은경비병, 그리고 불꽃날개 흑마법사를 10명씩 해치워야 합니다. 그런 다음 테로카르 숲의 돌망치 야영지에 있는 하사관 차우니에게 보고하십시오.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Tuez 10 Défenseurs Aile-de-feu, 10 Garde-sang Aile-de-feu et 10 Démonistes Aile-de-feu. Puis retournez au camp des Brise-Pierres dans la forêt de Terokkar pour faire votre rapport au sergent Chawni.‡杀死10个火翼防御者、10个火翼血警卫和10个火翼术士，然后向泰罗卡森林裂石堡的卡乌尼中士复命。‡殺死10個火翼防衛者，10個火翼血守衛，10個火翼術士。再回到泰洛卡森林向碎石營地的丘尼士官回報。',
  }
},
[9998] = {
  {
    'Vizinhos rebeldes‡Беспокойные соседи‡Widerspenstige Nachbarn‡사나운 이웃‡Vecinos indisciplinados‡Vecinos indisciplinados‡Des voisins encombrants‡野蛮的邻居‡難搞的鄰居',
    nil,
    'Mate 12 Peões Deformados e, a seguir, apresente-se a Theloria Umbramanto, no Posto Alleriano.‡Убейте 12 астральных батраков и доложите об этом Телории Плащ Теней на Аллерийскую заставу.‡Tötet 12 verunstaltete Peons und meldet Euch dann bei Theloria Dämmermantel bei Allerias Posten.‡일그러진 일꾼 12명을 처치한 후 알레리아 초소에 있는 텔로리아 셰이드클록에게 보고해야 합니다.‡Mata a 12 peones distorsionados e informa a Theloria Capasombría del Puesto Allerian.‡‡Tuez 12 Péons redimensionnés puis faites votre rapport à Theloria Capedombre au Poste allérien.‡杀死12名扭曲的苦工，然后向奥蕾莉亚岗哨的塞洛莉娅·影衣报告。‡殺死12個乖戾的苦工再向艾蘭里哨站的瑟蘿莉雅·影篷回報。',
  }
},
[9999] = {
  {
    'Ganhando tempo‡Выиграть время‡Spiel auf Zeit‡시간 벌기‡Tiempo extra‡Tiempo extra‡Gagner du temps‡争取时间‡爭取時間',
    nil,
    'Altruis, o Sofredor, no oeste de Nagrand, quer que você mate 2 Guardas Vis Legionários, 3 Engenheiros Mo\'args e 8 Engenhoqueiros Gan\'args.‡Убейте 2 стражей Скверны - легионеров, 3 мо\'аргов-инжененеров и 8 ган\'аргов-ремонтников.‡Altruis der Leider im westlichen Nagrand möchte, dass Ihr 2 Legionäre der Teufelswache, 3 Ingenieure der Mo\'arg und 8 Tüftler der Gan\'arg tötet.‡나그란드 서부에 있는 고뇌의 알트루이스가 지옥군단병 2명, 모아그 기술자 3명, 간아그 땜장이 8명을 해치워달라고 부탁했습니다.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que mates a 2 legionarios guardia vil, 3 ingenieros Mo\'arg y 8 manitas Gan\'arg.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que mates a 2 legionarios guardia vil, 3 ingenieros Mo\'arg y 8 manitas Gan\'arg.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de tuer 2 Légionnaires gangregarde, 3 Ingénieurs mo\'arg et 8 Bricoleurs gan\'arg.‡纳格兰西部的受难者奥图里斯要求你除掉2个恶魔卫士军团士兵、3个莫尔葛工程师和8个甘尔葛修理工。‡西納葛蘭的『受難者』奧翠司要你去殺死2個惡魔守衛領導者，3個莫阿格工程師和8個甘納格技工。',
  }
},
[10000] = {
  {
    'Uma presença indesejável‡Нежелательное присутствие‡Unangenehme Gesellschaft‡반갑지 않은 존재‡Una presencia inoportuna‡Una presencia inoportuna‡Une présence indésirable‡不受欢迎者‡不受歡迎的存在',
    nil,
    'Mate 12 Peões Deformados e, a seguir, apresente-se ao Assombrante Kaide.‡Убейте 12 астральных батраков и доложите об этом тенелову Кайду.‡Tötet 12 verunstaltete Peons und meldet Euch dann bei Schattenpirscher Kaide.‡일그러진 일꾼 12명을 해치운 다음 그림자추적자 카이드에게 보고하십시오.‡Mata 12 peones distorsionados y después preséntate ante el acechasombras Kaide.‡Mata a 12 peones distorsionados y después preséntate ante el acechasombras Kaide.‡Tuez 12 Péons redimensionnés puis faites votre rapport au traqueur des ombres Kaide.‡杀死12名扭曲的苦工，然后向追踪者凯德报告。‡殺死12個乖戾的苦工再向巡影者凱德回報。',
  }
},
[10001] = {
  {
    'O mestre-planejador‡Главный планировщик‡Der Meisterplaner‡수석 설계사‡El maestro planificador‡El maestro planificador‡Le maître d\'œuvre‡主规划师‡規劃大師',
    nil,
    'Altruis, o Sofredor, do oeste de Nagrand, quer que você recupere o diagrama do mestre-planejador.‡Алтруис Страдалец из западного Награнда просит вас раздобыть чертежи главного планировщика.‡Altruis der Leider im westlichen Nagrand möchte, dass Ihr die Blaupausen des Meisterplaners besorgt.‡나그란드 서부에 있는 고뇌의 알트루이스가 수석 설계사의 설계도를 찾아달라고 부탁했습니다.‡Altruis el Sufridor, en la parte oeste de Nagrand te ha pedido que consigas los planos del maestro planificador.‡Altruis el Sufridor, en la parte oeste de Nagrand te ha pedido que consigas los planos del maestro planificador.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de récupérer les Plans du maître d\'œuvre.‡纳格兰西部的受难者奥图里斯要求你取回主规划师的蓝图。‡西納葛蘭的『受難者』奧翠司要你取得規劃大師的藍圖。',
  }
},
[10002] = {
  {
    'O contato de Asardente‡Посредник Огнекрылых‡Vermittler der Feuerschwingen‡불꽃날개 연락책‡El contacto Ala de Fuego‡El contacto Ala de Fuego‡La messagère d\'Aile-de-feu‡莉塞蕾·火纹‡火翼聯繫',
    nil,
    'Localize e mate Lisaile Teceflamas. A seguir, fale novamente com Theloria Umbramanto.‡Найдите и убейте Лизель Огнепрядку, после чего вернитесь к Телории Плащ Теней.‡Findet und tötet Lisaile Feuerweber und kehrt dann zu Theloria Dämmermantel zurück.‡리세일 파이어위버를 찾아서 처치한 후 텔로리아 셰이드클록에게 돌아가야 합니다.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver a Theloria Capasombría.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver a Theloria Capasombría.‡Trouvez et tuez Lisaile Tissefeu, puis retournez voir Theloria Capedombre.‡找到莉塞蕾·火纹并杀掉她，然后向塞洛莉娅·影衣复命。‡找到並殺死麗莎艾歐·織火者，再回去找瑟蘿莉雅·影篷。',
  }
},
[10003] = {
  {
    'O contato de Asardente‡Посредник Огнекрылых‡Vermittler der Feuerschwingen‡불꽃날개 거점의 연락책‡El contacto Ala de Fuego‡El contacto Ala de Fuego‡La messagère d\'Aile-de-feu‡莉塞蕾·火纹‡火翼聯繫',
    nil,
    'Localize e mate Lisaile Teceflamas. A seguir, fale novamente com o Assombrante Kaide.‡Найдите и убейте Лизель Огнепрядку, после чего вернитесь к тенелову Кайду.‡Findet und tötet Lisaile Feuerweber und kehrt dann zu Schattenpirscher Kaide zurück.‡리세일 파이어위버를 찾아서 해치운 후 그림자추적자 카이드에게 돌아가십시오.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver al acechasombras Kaide.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver al acechasombras Kaide.‡Trouvez et tuez Lisaile Tissefeu, puis retournez voir le traqueur des ombres Kaide.‡找到莉塞蕾·火纹并杀掉她，然后向追踪者凯德复命。‡找到並殺死麗莎艾歐·織火者，再回去找巡影者凱德。',
  }
},
[10004] = {
  {
    'Paciência e compreensão‡Терпение и понимание‡Geduld und Verständnis‡인내와 이해심‡Paciencia y comprensión‡Paciencia y comprensión‡Patience et compréhension‡耐心与理解‡耐心與諒解',
    nil,
    'Altruis, o Sofredor, que está na parte oeste de Nagrand, quer quer você entregue o Diagrama do Mestre-planejador para Sal\'salabim, em Shattrath, e o convença a ajudá-l<o/a>.‡Покажите чертежи главного планировщика Саль\'салабиму в Шаттрате и уговорите его помочь вам.‡Altruis der Leider im westlichen Nagrand möchte, dass Ihr die Blaupausen des Meisterplaners zu Sal\'salabim in Shattrath bringt und ihn überredet, euch zu helfen.‡나그란드 서부에 있는 고뇌의 알트루이스가 샤트라스의 살살라빔에게 수석 설계사의 설계도를 가지고 가서 설득한 후 도움을 받으라고 부탁했습니다.‡Altruis el Sufridor, en el oeste de Nagrand, quiere que lleves los planos del maestro planificador a Sal\'salabim en la Ciudad de Shattrath y convéncele para que te ayude.|n‡Altruis el Sufridor, en el oeste de Nagrand, quiere que lleves los planos del maestro planificador a Sal\'salabim en la Ciudad de Shattrath y que le convenzas para que te ayude.|n‡Altruis le Souffrant dans l\'ouest de Nagrand veut que vous apportiez les Plans du maître d\'œuvre à Sal\'salabim à Shattrath et que vous le convainquiez de vous aider.‡纳格兰西部的受难者奥图里斯要你将主规划师的蓝图交给沙塔斯城中的萨萨拉比姆，并说服他帮助你。‡西納葛蘭的『受難者』奧翠司要你帶著規劃大師的藍圖去找撒塔斯城的沙薩拉畢恩並說服他幫助你。',
  }
},
[10005] = {
  {
    'Informar Ataterra Tavgren‡Вести для землепряда Тавгрена‡Erdbinder Tavgren Bescheid sagen‡대지의 결속자 타브그렌과 대화‡Informar al vinculador terrestre Tavgren‡Informar al vinculador terrestre Tavgren‡Informer le lieur de terre Tavgren‡告知缚地者塔弗格伦‡讓大地束縛者塔伏格蘭知道',
    nil,
    'Fale com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, na Mata Terokkar.‡Поговорите с заклинателем земли Тавгреном возле перелеска Кенария в лесу Тероккар.‡Sprecht mit Erdbinder Tavgren außerhalb des Cenariusdickichts in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌과 대화해야 합니다.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林塞纳里奥树林外的缚地者塔弗格伦谈一谈。‡到泰洛卡森林去和塞納里奧灌木林外的大地束縛者塔伏格蘭談談。',
  }
},
[10006] = {
  {
    'Informar Ataterra Tavgren‡Вести для землепряда Тавгрена‡Erdbinder Tavgren Bescheid sagen‡대지의 결속자 타브그렌에게 알려주기‡Informar al vinculador terrestre Tavgren‡Informar al vinculador terrestre Tavgren‡Informer le lieur de terre Tavgren‡告知缚地者塔弗格伦‡讓大地束縛者塔伏格蘭知道',
    nil,
    'Fale com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, na Mata Terokkar.‡Поговорите с заклинателем земли Тавгреном возле перелеска Кенария в лесу Тероккар.‡Sprecht mit Erdbinder Tavgren außerhalb des Cenariusdickichts in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀 바로 바깥에 있는 대지의 결속자 타브그렌과 대화하십시오.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林塞纳里奥树林外的缚地者塔弗格伦谈一谈。‡到泰洛卡森林去和塞納里奧灌木林外的大地束縛者塔伏格蘭談談。',
  }
},
[10007] = {
  {
    'Reduzir as hostes‡Ослабление врага‡Die Reihen lichten‡군사 줄이기‡Disminuir las filas‡Disminuir las filas‡Éclaircir les rangs‡削弱邪兽人‡削弱軍隊',
    nil,
    'Mate 10 Devastadores Mascaosso e 6 Quebradorsos Mascaosso e, a seguir, fale novamente com Theloria Umbramanto.‡Убейте 10 уничтожителей и 6 спиноломов из клана Костеглодов, после чего вернитесь к Телории Плащ Теней.‡Tötet 10 Verwüster der Knochenmalmer und 6 Kreuzbrecher der Knochenmalmer und kehrt dann zu Theloria Dämmermantel zurück.‡해골이빨 약탈자 10명, 해골이빨 투사 6명을 처치한 다음 텔로리아 셰이드클록에게 돌아가야 합니다.‡Mata 10 devastadores Mascahuesos y 6 partedorsales Mascahuesos y ve a ver a Theloria Capasombría.‡Mata a 10 devastadores Mascahuesos y a 6 partedorsales Mascahuesos y ve a ver a Theloria Capasombría.‡Tuez 10 Dévastateurs Mâche-les-os et 6 Brise-dos Mâche-les-os puis retournez voir Theloria Capedombre.‡杀死10名噬骨蹂躏者和6名噬骨碎脊者，然后向塞洛莉娅·影衣复命。‡殺死10個噬骨破壞者和6個噬骨斷背者再回去找瑟蘿莉雅·影篷。',
  }
},
[10008] = {
  {
    'O que acontece em Terokkar morre em Terokkar‡Секреты Тероккара не покидают его границ‡Was in Terokkar geschieht, bleibt in Terokkar‡테로카르 숲에서 일어난 일‡Lo que pasa en Terokkar, se queda en Terokkar‡Lo que pasa en Terokkar, se queda en Terokkar‡Ce qui se passe à Terokkar reste à Terokkar‡泰罗卡的事情，在泰罗卡解决‡把泰洛卡的事留在泰洛卡',
    nil,
    'O Assombrante Kaide quer quer você mate 10 Devastadores Mascaosso e 6 Quebradorsos Mascaosso.‡Убейте 10 уничтожителей и 6 спиноломов из клана Костеглодов по просьбе тенелова Кайда.‡Schattenpirscher Kaide möchte, dass Ihr 10 Verwüster der Knochenmalmer und 6 Kreuzbrecher der Knochenmalmer tötet.‡그림자추적자 카이드가 해골이빨 약탈자 10명, 해골이빨 투사 6명을 해치워 달라고 부탁했습니다.‡El acechasombras Kaide quiere que mates a 10 arrasadores Mascahuesos y 6 partedorsales Mascahuesos.‡El acechasombras Kaide quiere que mates a 10 devastadores Mascahuesos y 6 partedorsales Mascahuesos.‡Le traqueur des ombres Kaide veut que vous alliez tuer 10 Dévastateurs Mâche-les-os et 6 Brise-dos Mâche-les-os.‡追踪者凯德要你杀死10名噬骨蹂躏者和6名噬骨碎脊者。‡巡影者凱德要你去殺死10個噬骨破壞者和6個噬骨斷背者。',
  }
},
[10009] = {
  {
    'Quebrando as cabeças‡Золото за тумаки‡Ein paar Schädel spalten‡해결사‡Aplastar unas calaveras‡Aplastar unas calaveras‡Casser des crânes‡大打出手‡解決一些傢伙',
    nil,
    'Sal\'salabim, de Shattrath, quer que você cobre a Dívida de Raliq, a Dívida de Cus\'cuz e a Dívida de Floon.‡Взыщите долги с Ралика, Куш\'куша и Флуна.‡Sal\'salabim in Shattrath möchte, dass Ihr Raliqs Schulden, Kusch\'kuschs Schulden und Floons Schulden eintreibt.‡샤트라스에 있는 살살라빔이 라리크의 빚, 쿠쉬쿠쉬의 빚, 플룬의 빚을 받아오라고 부탁했습니다.‡Sal\'salabim de la Ciudad de Shattrath quiere que recuperes la deuda de Raliq, la deuda de Coosh\'coosh y la deuda de Floon.‡Sal\'salabim de la Ciudad de Shattrath quiere que recuperes la deuda de Raliq, la deuda de Coosh\'coosh y la deuda de Floon.‡Sal\'salabim de Shattrath veut que vous récupériez la Dette de Raliq, la Dette de Coosh\'coosh et la Dette de Floon.‡沙塔斯城的萨萨拉比姆要你取回拉里克的债款、库什库什的债款和弗鲁恩的债款。‡撒塔斯城的沙薩拉畢恩要你取回拉利克的欠款，庫庫許的債款和服倫之債。',
  }
},
[10010] = {
  {
    'É fácil assim?‡Не так просто?‡So einfach ist das?‡쉽지 않은 임무‡¿Es así de fácil?‡¿Es así de fácil?‡C\'est si facile ?‡就这么简单？‡就這麼簡單嗎?',
    nil,
    'Sal\'salabim, de Shattrath, quer que você fale novamente com Altruis, o Sofredor, no oeste de Nagrand.‡Вернитесь к Алтруису Страдальцу в западный Награнд.‡Sal\'salabim in Shattrath möchte, dass Ihr zu Altruis dem Leider im westlichen Nagrand zurückkehrt.‡샤트라스에 있는 살살라빔이 나그란드 서부에 있는 고뇌의 알트루이스에게 돌아가라고 했습니다.‡Sal\'salabim en la Ciudad de Shattrath quiere que vayas a ver a Altruis el Sufridor en la parte oeste de Nagrand.‡Sal\'salabim en la Ciudad de Shattrath quiere que vayas a ver a Altruis el Sufridor en la parte oeste de Nagrand.‡Sal\'salabim de Shattrath veut que vous retourniez voir Altruis le Souffrant dans l\'ouest de Nagrand.‡沙塔斯城的萨萨拉比姆要你返回纳格兰西部向受难者奥图里斯复命。‡撒塔斯城的沙薩拉畢恩要你回到西納葛蘭找『受難者』奧翠司。',
  }
},
[10011] = {
  {
    'Campo-forja: aniquilado‡Лагеря Легиона: уничтожены‡Konstruktionslager: zerstört‡괴철로 기지 섬멸‡Campamento Forja: aniquilado‡Campamento Forja: aniquilado‡Le camp de forge : Anéanti‡扫荡铸魔营地‡煉冶場:徹底擊潰',
    nil,
    'Altruis, o Sofredor, do oeste de Nagrand, quer que você destrua o Campo-forja: Ódio e destrua o Campo-forja: Medo.‡Уничтожьте лагеря Легиона: Страх и Ненависть.‡Altruis der Leider im westlichen Nagrand möchte, dass Ihr das Konstruktionslager: Hass und das Konstruktionslager: Furcht zerstört.‡나그란드 서부에 있는 고뇌의 알트루이스가 증오의 괴철로 기지와 경악의 괴철로 기지를 파괴해 달라고 부탁했습니다.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que destruyas el Campamento Forja: Odio y el Campamento Forja: Miedo.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que destruyas el Campamento Forja: Odio y el Campamento Forja: Miedo.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de détruire le Camp de forge Haine et le Camp de forge Peur.‡纳格兰西部的受难者奥图里斯要求你摧毁铸魔营地：仇恨和铸魔营地：畏惧。‡納葛蘭西邊的『受難者』奧翠司要你去摧毀煉冶場:仇恨和煉冶場:恐懼。',
  }
},
[10012] = {
  {
    'Planos dos orcs vis‡Планы орков Скверны‡Höllenorcpläne‡타락한 오크의 계획서‡Planes de orcos viles‡Planos de orcos viles‡Les plans des Gangr’orcs‡邪兽人的计划‡魔獄獸人計畫',
    nil,
    'Leve os Planos dos Orcs Vis para Bertelm na Fortaleza Alleriana, na Mata Terokkar.‡Добудьте планы орков Скверны для Бертельма в бастионе Аллерии.‡Bringt die Höllenorcpläne zu Bertelm in Allerias Feste.‡알레리아 성채에 있는 베르텔름에게 타락한 오크의 계획서를 가져가야 합니다.‡Lleva los planes de los orcos viles a Bertelm en el Bastión Allerian.‡‡Apportez les Plans des Gangr’orcs à Bertelm au Bastion allérien, dans la Forêt de Terokkar.‡将邪兽人的计划交给奥蕾莉亚要塞的波尔泰姆。‡將魔獄獸人計畫交給艾蘭里堡壘的伯特泰歐。',
  }
},
[10013] = {
  {
    'A mão invisível‡Невидимая длань‡Eine ungesehene Hand‡보이지 않는 손‡Una mano invisible‡Una mano invisible‡Une main invisible‡幕后黑手‡看不見的手',
    nil,
    'Leve os Planos dos Orcs Vis para Rokar. Você pode encontrá-lo na Vila de Quebrapedra, que fica na Mata Terokkar.‡Добудьте планы орков Скверны для Рокага в форте Камнеломов.‡Bringt die Höllenorcpläne zu Rokag in der Steinbrecherfeste.‡돌망치 요새에 있는 로카그에게 타락한 오크의 계획서를 가져가야 합니다.‡Lleva los planes de orcos viles a Rokag en el Bastión Rompepedras.‡‡Apportez les Plans des Gangr’orcs à Rokag au Fort des Brise-Pierres, dans la Forêt de Terokkar.‡将邪兽人的计划交给裂石堡的罗卡格。‡將魔獄獸人計畫交給碎石堡的瑞克格。',
  }
},
[10014] = {
  {
    'The Firewing Point Project‡Проект Лагеря Огнекрылов‡Das Projekt des Postens der Feuerschwingen‡‡El proyecto del Alto Ala de Fuego‡‡Le projet de la halte Aile-de-feu‡火翼岗哨的项目‡火翼崗哨計畫',
    nil,
    'Steal the four Mana Bomb Code Sheets and deliver them to Lieutenant Meridian at the Allerian Post in Terokkar Forest.‡Украдите 4 листа кодирования мана-бомб и отнесите их лейтенанту Меридиану на Заставу Аллерии в лесу Тероккар.‡Stehlt die vier Codetabellen der Manabombe und bringt sie zu Meridian in Allerias Posten in den Wäldern von Terokkar.‡‡Roba cuatro hojas de código de bomba de maná y entrégaselas al teniente Meridiano en la Puesto Allerian del Bosque de Terokkar.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al teniente Meridiano en la Puesto Allerian del Bosque de Terokkar.‡Volez les quatre Feuilles de code de la bombe de mana et apportez-les au lieutenant Meridian au Poste allérien dans la forêt de Terokkar.‡偷取四张魔法炸弹密码表，把它们交给泰罗卡森林中奥蕾莉亚岗哨的米利迪安中尉。‡偷取4份法力炸彈密碼清單並將它們送到泰洛卡森林的艾蘭里哨站交給莫瑞狄恩中尉。',
  }
},
[10015] = {
  {
    'The Firewing Point Project‡Проект лагеря Огнекрылых‡Das Projekt des Postens der Feuerschwingen‡‡El proyecto del Alto Ala de Fuego‡‡Le projet de la halte Aile-de-feu‡火翼岗哨的项目‡',
    nil,
    'Steal the four Mana Bomb Code Sheets and deliver them to Sergeant Chawni at Stonebreaker Camp in Terokkar Forest.‡Украдите 4 листа кодирования мана-бомб и отнесите их сержанту Чауни в лагерь Камнеломов в лесу Тероккар.‡Stehlt die vier Codetabellen der Manabombe und bringt sie zu Unteroffizier Chawni im Steinbrecherlager in den Wäldern von Terokkar.‡‡Roba cuatro hojas de código de bomba de maná y entrégaselas al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Volez les quatre Feuilles de code de la bombe de mana et apportez-les au sergent Chawni au camp des Brise-pierres dans la forêt de Terokkar.‡‡',
  }
},
[10016] = {
  {
    'Caudas de worgs silvestres‡Хвосты лесных воргов‡Waldworgschwänze‡검은숲늑대 꼬리‡Colas de huargos grises‡Colas de huargos grises‡Les queues de worgs des bois‡森林座狼的尾巴‡灰座狼尾巴',
    nil,
    'Bertelm, na Fortaleza Alleriana, quer que você traga 12 Caudas de Worgs Silvestres para ele. As caudas podem ser encontradas tanto em worgs silvestres quando em worgs silvestres alfa.‡Принесите 12 хвостов лесных воргов Бертельму в бастион Аллерии. Хвосты можно добыть с лесных воргов или их вожаков.‡Bertelm in Allerias Feste möchte, dass Ihr ihm 12 Waldworgschwänze bringt. Die Schwänze können von Waldworgs oder Waldworgalphas stammen.‡알레리아 성채에 있는 베르텔름이 검은숲늑대 또는 우두머리 검은숲늑대에게서 검은숲늑대 꼬리 12개를 가져다 달라고 부탁했습니다.‡Bertelm del Bastión Allerian quiere que le traigas 12 colas de huargo gris. Las colas pueden ser de huargo gris o de huargo gris alfa.‡Bertelm del Bastión Allerian quiere que le traigas 12 colas de huargo gris. Las colas pueden ser de huargo gris o de huargo gris alfa.‡Bertelm du Bastion allérien veut que vous lui apportiez 12 Queues de worgs des bois. Vous pouvez prendre ces queues soit sur des worgs des bois, soit sur des worgs Alpha des bois.‡奥蕾莉亚要塞的波尔泰姆想让你收集12条森林座狼的尾巴。这些尾巴可以从森林座狼和森林座狼前锋身上获得。‡艾蘭里堡壘的伯特泰歐要你去幫他帶回來12個灰座狼尾巴。可以從灰座狼或灰座狼首領身上取得。',
  }
},
[10017] = {
  {
    'Suprimentos escassos‡Нехватка припасов‡Schwindende Vorräte‡모자라는 재고‡Cortos de suministros‡Cortos de suministros‡Des réserves durement sollicitées‡物资紧张‡物資短缺',
    nil,
    'Leve 8 Vesículas de Peçonha de Presátera para Sha\'nir em Sattrath.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Принесите 8 ядовитых желез пауков-смертеплетов Ша\'нир в Шаттрат.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt 8 Schreckensgiftbeutel zu Sha\'nir in Shattrath.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 샤니르에게 공포의 송곳니 독주머니 8개를 가져가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva 8 sacos de veneno de colminferno a Sha\'nir en la Ciudad de Shattrath.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva 8 sacos de veneno de colminferno a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez 8 Glandes à venin de croc-d\'effroi à Sha\'nir à Shattrath.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡给沙塔斯城的莎妮尔带回8个巨牙毒囊。nn为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡將8個懼牙毒囊交給撒塔斯城的薩尼爾。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10018] = {
  {
    'Vestimentas do espírito do lobo‡Одежды духа волка‡Gewänder des Wolfgeistes‡늑대 정령 예복‡Vestimentas del espíritu lobo‡Vestimentas del espíritu lobo‡Les habits de l\'esprit du loup‡狼魂之衣‡狼魂法衣',
    nil,
    'Traga 12 Pelagens de Worg Silvestre para Malkaz, na Vila de Quebrapedra.‡Принесите 12 шкур лесного ворга Малуказу в форт Камнеломов.‡Bringt 12 Waldworgpelze zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 검은숲늑대 모피 12개를 가져가야 합니다.‡Lleva 12 pelambres de huargos grises a Malukaz en el Bastión Rompepedras.‡Lleva 12 pelambres de huargos grises a Malukaz en el Bastión Rompepedras.‡Apportez 12 Fourrures de worg des bois à Malukaz au fort des Brise-pierres.‡给裂石堡的玛鲁卡兹带回12块森林座狼的毛皮交。‡將12塊灰座狼皮交給碎石堡的瑪魯卡茲。',
  }
},
[10019] = {
  {
    'Mais vesículas de peçonha‡Больше ядовитых желез‡Mehr Giftbeutel‡독주머니 추가 수집‡Más sacos de veneno‡Más sacos de veneno‡Plus de glandes à venin‡更多毒囊‡更多毒囊',
    nil,
    nil,
  }
},
[10020] = {
  {
    'Uma cura para Zahlia‡Лекарство для Залии‡Ein Heilmittel für Zahlia‡잘리아를 위한 약‡Una cura para Zahlia‡Una cura para Zahlia‡Un remède pour Zahlia‡萨恩莉亚的解药‡給札麗亞的解藥',
    nil,
    'Leve o Sangue do Petrifitante para Sha\'nir, em Shattrath.nnCumprir missões para os Aldor fará com que sua reputação com os Áugures diminua.‡Принесите Ша\'нир в Шаттрат кровь Камневзора.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt Steinstarrers Blut zu Sha\'nir in Shattrath.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 샤니르에게 돌딱부리의 피를 가져가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva la sangre de Mirada de piedra a Sha\'nir en la Ciudad de Shattrath.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva la sangre de Mirada Pétrea a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez le Sang de Regard-de-pierre à Sha\'nir à Shattrath.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将凝石者的血交给沙塔斯城的莎妮尔。nn为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡將岩石凝視者之血帶給撒塔斯城的薩尼爾。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10021] = {
  {
    'Restaurando a Luz‡Возрождение Света‡Das Licht wiederherstellen‡성스러운 빛을 복구하라‡Restaurando la Luz‡Restaurar la Luz‡Rétablir la Lumière‡重现圣光‡恢復聖光',
    nil,
    'Ishanah quer que você vá até o posto avançado Arakkoa a leste de Shattrath, e use a Ampola Abençoada para limpar o Altar do Leste, o Altar do Oeste e o Altar do Norte.‡Отправляйтесь на заставу Араккоа, что к востоку от Шаттрата, и при помощи благословленного фиала очистите восточный, западный и северный алтари, после чего вернитесь к Ишане.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Ishanah möchte, dass Ihr zum Arakkoaaußenposten östlich von Shattrath geht. Benutzt die gesegnete Phiole, um den östlichen Altar, den westlichen Altar und den nördlichen Altar zu reinigen.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡이샤나가 샤트라스 동쪽의 아라코아의 기지로 가서 축복받은 약병을 사용하여 동부 제단, 서부 제단, 북부 제단을 정화해 달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ishanah quiere que vayas a la avanzada arakkoa al este de Ciudad de Shattrath City y uses el vial bendito para purificar los altares Este, Norte y Oeste.nnCompletar misiones para los Aldor hará que tu nivel de reputación entre los Arúspices descienda.‡Ishanah quiere que vayas a la avanzada arakkoa al este de la Ciudad de Shattrath y uses el vial bendito para purificar los altares Este, Norte y Oeste.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ishanah veut que vous vous rendiez à l\'avant-poste arakkoa à l\'est de Shattrath et que vous utilisiez la Fiole bénite pour purifier l\'Autel de l\'est, l\'Autel de l\'ouest et l\'Autel du nord.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡伊沙娜希望你能前往沙塔斯城正东方的鸦人前哨站，使用神圣之瓶净化东部祭坛、西部祭坛和北部祭坛。nn为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡伊莎納要你去撒塔斯城東邊的阿拉卡前哨站使用神聖之瓶淨化東祭壇，西祭壇以及北祭壇。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10022] = {
  {
    'Ferroqueixo, o esquivo‡Неуловимый Железнозуб‡Der schwer zu fassende Eisenkiefer‡잡기 힘든 무쇠턱 늑대‡El esquivo Quijahierro‡El esquivo Quijahierro‡L\'insaisissable Gueule-de-fer‡狡猾的铁腭‡難捉摸的鐵顎',
    nil,
    'Traga a Pelagem de Ferroqueixo para Bertelm, na Fortaleza Alleriana.‡Принесите шкуру Железнозуба Бертельму в бастион Аллерии.‡Bringt Eisenkiefers Pelz zu Bertelm in Allerias Feste.‡알레리아 성채에 있는 베르텔름에게 무쇠턱 늑대 모피를 가져가야 합니다.‡Lleva la pelambre de quijahierro a Bertelm en el Bastión Allerian.‡Lleva la pelambre de Quijahierro a Bertelm en el Bastión Allerian.‡Apportez la Fourrure de Gueule-de-fer à Bertelm au Bastion allérien.‡为奥蕾莉亚要塞的波尔泰姆带回铁腭的毛皮。‡將鐵顎的生皮交給艾蘭里堡壘的伯特泰歐。',
  }
},
[10023] = {
  {
    'Patriarca Ferroqueixo‡Патриарх Железнозуб‡Patriarch Eisenkiefer‡우두머리, 무쇠턱 늑대‡Patriarca Quijahierro‡Patriarca Quijahierro‡Le patriarche Gueule-de-fer‡狼王铁腭‡鐵顎族王',
    nil,
    'Traga a Pelagem de Ferroqueixo para Malkaz, na Vila de Quebrapedra.‡Принесите шкуру Железнозуба Малуказу в форт Камнеломов.‡Bringt Eisenkiefers Pelz zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 무쇠턱 늑대 모피을 가져가야 합니다.‡Lleva la pelambre de Quijahierro a Malukaz en el Bastión Rompepedras.‡Lleva la pelambre de Quijahierro a Malukaz en el Bastión Rompepedras.‡Apportez la Fourrure de Gueule-de-fer à Malukaz au fort des Brise-Pierres.‡将铁腭的毛皮交给裂石堡的玛鲁卡兹。‡將鐵顎的生皮交給碎石堡的瑪魯卡茲。',
  }
},
[10024] = {
  {
    'As visões de Voren\'thal‡Видения Ворен\'таля‡Voren\'thals Visionen‡보렌살의 환영‡Visiones de Voren\'thal‡Visiones de Voren\'thal‡Les visions de Voren\'thal‡沃雷塔尔的预言‡沃藍索的預言',
    nil,
    'Leve 8 Olhos de Basilisco Escamáqua para a Arcanista Adyria, em Shattrath.nnCumprir missões para os Áugures fará com que sua reputação com os Aldor diminua.‡Принесите 8 глаз гладкоспинных василисков чародейке Адирии в Шаттрат.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Bringt 8 Augen eines Dunstschuppenbasilisken zu Arkanistin Adyria in Shattrath.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡샤트라스에 있는 비전술사 아디리아에게 안개비늘 바실리스크 눈 8개를 가져가야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Lleva 8 ojos de basilisco escama húmeda a la arcanista Adyria en la Ciudad de Shattrath.nnCompletar misiones para Los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Lleva 8 ojos de basilisco escama húmeda a la arcanista Adyria en la Ciudad de Shattrath.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Apportez 8 Yeux de basilic trempécaille à l\'arcaniste Adyria à Shattrath.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡将8颗湿鳞蜥蜴的眼睛交给沙塔斯城的奥术师艾蒂莉亚。nn为占星者完成任务将会使你在奥尔多阵营中的声望等级降低。‡將8個濕鱗蜥蜴眼交給撒塔斯城的秘法師艾德蕊雅。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10025] = {
  {
    'Mais olhos de basilisco‡Больше глаз василисков‡Mehr Basiliskenaugen‡바실리스크 눈 추가 수집‡Más ojos de basiliscos‡Más ojos de basiliscos‡Plus d\'yeux de basilic‡更多蜥蜴眼‡更多蜥蜴眼',
    nil,
    'São precisos muitos olhos de basilisco para preparar uma pequena dose do elixir de Voren\'thal. Se me trouxer mais, com certeza você cairá ainda mais nas graças dos Áugures.‡‡‡‡‡‡Il faut beaucoup d\'yeux de basilic pour faire ne serait-ce qu\'une petite dose d\'élixir de Voren\'thal. Si vous m\'en apportiez plus, cela vous attirerait sans nul doute la faveur des Clairvoyants.‡‡',
  }
},
[10026] = {
  {
    'Distúrbios mágicos‡Нарушение магического равновесия‡Magische Störungen‡마법 방해‡Alteraciones mágicas‡Alteraciones mágicas‡Perturbations magiques‡魔法扰动‡魔法干擾',
    nil,
    'Andarl, na Fortaleza Alleriana, quer que você mate 10 Espreitadores Dimensionais.‡Убейте 10 прыгуан по просьбе Андарла из бастиона Аллерии.‡Andarl in Allerias Feste möchte, dass Ihr 10 Sphärenjäger tötet.‡알레리아 성채에 있는 안다를이 차원의 추적자 10마리를 처치해 달라고 부탁했습니다.‡Andarl en el Bastión Allerian quiere que mates 10 acechadores de distorsión.‡Andarl en el Bastión Allerian quiere que mates a 10 acechadores de distorsión.‡Andarl du Bastion allérien veut que vous alliez tuer 10 Traqueurs dimensionnels.‡奥蕾莉亚要塞的安达尔要求你杀死10只迁跃跟踪者。‡艾蘭里堡壘的安達爾歐要你殺死10個扭曲行者。',
  }
},
[10027] = {
  {
    'Distúrbios mágicos‡Нарушение магического равновесия‡Magische Störungen‡마법 방해‡Alteraciones mágicas‡Alteraciones mágicas‡Perturbations magiques‡魔法扰动‡魔法干擾',
    nil,
    'Mate 10 Espreitadores Dimensionais e fale novamente com Kurgatok, na Vila de Quebrapedra.‡Убейте 10 прыгуан и вернитесь к Каргатоку в форт Камнеломов.‡Tötet 10 Sphärenjäger und kehrt dann zu Kurgatok in der Steinbrecherfeste zurück.‡차원의 추적자 10마리를 해치운 후 돌망치 요새에 있는 쿠르가톡에게 돌아가십시오.‡Mata 10 acechadores de distorsión y vuelve a ver a Kurgatok en el Bastión Rompepedras.‡Mata a 10 acechadores de distorsión y vuelve a ver a Kurgatok en el Bastión Rompepedras.‡Tuez 10 Traqueurs dimensionnels et retournez voir Kurgatok au fort des Brise-pierres.‡杀死10只迁跃跟踪者，然后向裂石堡的玛鲁卡兹复命。‡殺死10個扭曲行者並回到碎石堡向庫爾卡拓克回報。',
  }
},
[10028] = {
  {
    'Recipientes de poder‡Сосуды силы‡Gefäße der Macht‡마력이 담긴 용기‡Vasijas de poder‡Vasijas de poder‡Calices de puissance‡强大的容器‡能量容器',
    nil,
    'Traga 8 Recipientes Draeneis para Ros\'eleth, na Fortaleza Alleriana.‡Принесите 8 сосудов дренеев Роз\'алете в бастион Аллерии.‡Bringt 8 Draeneigefäße zu Ros\'eleth in Allerias Feste.‡알레리아 성채에 있는 로스엘레스에게 드레나이 용기 8개를 가져가야 합니다.‡Lleva 8 vasijas draenei a Ros\'eleth en el Bastión Allerian.‡Lleva 8 vasijas draenei a Ros\'eleth en el Bastión Allerian.‡Apportez 8 Calices draeneï à Ros\'eleth au Bastion allérien.‡为奥蕾莉亚要塞的洛瑟蕾丝带回8个德莱尼容器。‡將8個德萊尼容器交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[10029] = {
  {
    'The Spirits Are Calling‡Зов духов‡Die Geister rufen‡영혼의 부름‡Los espíritus llaman‡‡L\'appel des esprits‡DEPRECATED‡亡靈在召喚',
    nil,
    'Anchorite Lyteera wants you to locate her assistant, Soolaveen at the Refugee Caravan in the Bone Wastes of Terokkar Forest.nnCompleting quests for the Aldor will cause your Scryers reputation level to decrease.‡Найдите помощника анахорета Литееры по имени Соолавин в Караване беженцев на Костяных Пустошах в лесу Тероккар.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Lyteera möchte, dass Ihr ihren Gehilfen Soolaveen bei der Flüchtlingskarawane in der Knochenwüste der Wälder von Terokkar findet.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡수도자 리티라가 테로카르 숲의 해골 무덤에 있는 피난민 행렬에서 자신의 조수인 술라빈을 찾아달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La anacoreta Lyteera quiere que encuentres a su asistente, Soolaveen, en la Caravana de Refugiados de El Vertedero de Huesos en el Bosque de Terokkar.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.|n‡La anacoreta Lyteera quiere que encuentres a su asistente, Soolaveen, en la Caravana de Refugiados de El Vertedero de Huesos en el Bosque de Terokkar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.|n‡L\'anachorète Lyteera veut que vous trouviez son assistant, Soolaveen, à la Caravane des réfugiés dans le désert des Ossements de la forêt de Terokkar.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡Anchorite Lyteera想你找到她的助手，泰罗卡森林中白骨荒野Refugee Caravan的Soolaveen。nn完成奥尔多所有的任务会降低你的Scryers声望。‡隱士麗蒂娜要你去泰洛卡森林的白骨荒野，在難民商隊找到她的助理，索拉伏恩。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10030] = {
  {
    'Recuperar os ossos‡Сбор останков‡Die Knochen zurückholen‡유골 되찾기‡Recuperar los huesos‡Recuperar los huesos‡La récupération des os‡收集骸骨‡取回白骨',
    nil,
    'Colete 10 Ossos Inquietos. Entregue-os para Ramdor, o Louco, do lado oeste do Círculo da Obediência, em Auchindoun. Auchindoun se encontra no meio do Deserto de Ossos, na Mata Terokkar.‡Соберите 10 неупокоенных костей и отнесите их Рамдору Безумному на западную сторону Ритуального круга в Аукиндоне. Аукиндон находится в центре Костяных пустошей в лесу Тероккар.‡Sammelt 10 ruhelose Knochen und bringt sie zu Ramdor dem Wahnsinnigen bei der westlichen Seite des Rings der Beobachtung in Auchindoun, das sich in der Mitte der Knochenwüste in den Wäldern von Terokkar befindet.‡안식을 찾지 못한 유골 10개를 모아서 아킨둔의 규율의 광장 서쪽 측면에 있는 광기의 람도르에게 가져가야 합니다. 아킨둔은 테로카르 숲의 해골 무덤 가운데에 있습니다.‡Consigue 10 huesos de Sin Sosiego y llévaselos a Ramdor el Loco, del lado oeste del Círculo de la Observancia de Auchindoun, en medio de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Consigue 10 huesos sin sosiego y llévaselos a Ramdor el Loco, del lado oeste del Círculo de la Observancia de Auchindoun, en medio de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Récupérez 10 Ossements sans repos. Apportez-les à Ramdor le Fol, juste à côté du côté ouest du Cercle d\'observance à Auchindoun, qui se trouve au milieu du désert des Ossements de la forêt de Terokkar.‡收集10根无眠之骨，并将它们交给奥金顿仪式广场西侧的疯狂的拉姆杜尔，奥金顿就在泰罗卡森林白骨荒野的中心。‡收集10根無法安息的白骨。交給奧齊頓儀式競技場西邊的瘋狂的藍姆多，位在泰洛卡森林的白骨荒野中間。',
  }
},
[10031] = {
  {
    'Ajudar os perdidos a achar o caminho‡Возвращение заблудших душ‡Den Verirrten den Weg zeigen‡길잃은 망령 인도‡Ayudando a Los Perdidos a encontrar su camino‡Ayudar a Los Perdidos a encontrar su camino‡Aider les Perdus à trouver leur chemin‡迷失者的解脱‡幫迷失者找到方向',
    nil,
    'Destrua 10 Espíritos Perdidos e 10 Esqueletos Quebrados. A seguir, fale com Sulavin, na Caravana dos Refugiados no Deserto de Ossos, que fica na Mata Terokkar.‡Уничтожьте 10 заблудших духов и 10 скелетов Сломленных, после чего поговорите с Сулавином в караване беженцев в Костяных пустошах леса Тероккар.‡Tötet 10 verirrte Geister und 10 Skelette eines Zerschlagenen und kehrt dann zu Anachoret Soolaveen bei der Flüchtlingskarawane in der Knochenwüste in den Wäldern von Terokkar zurück.‡길잃은 망령, 뒤틀린 드레나이 해골을 10마리씩 처치한 후 테로카르 숲, 해골 무덤의 피난민 행렬에 있는 술라빈과 대화해야 합니다.‡Destruye 10 espíritus perdidos y 10 esqueletos partidos y ve a ver a Soolaveen en la Caravana de Refugiados de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Acaba con 10 espíritus perdidos y 10 esqueletos partidos y ve a ver a Soolaveen en la Caravana de Refugiados de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Détruisez 10 Esprits perdus et 10 Squelettes roués, puis parlez à Soolaveen à la Caravane de réfugiés, dans le désert des Ossements de la forêt de Terokkar.‡消灭10个失落的幽魂和10只破碎的骷髅，然后向泰罗卡森林白骨荒野难民车队的苏拉文复命。‡殺死10個迷失的靈魂和10個德萊尼骷髏，然後跟難民商隊的索拉伏恩談話，位在泰洛卡森林的白骨荒野。',
  }
},
[10033] = {
  {
    'Procura-se: açoita-ossos mortos!‡Награда за убитых костеклювов!‡Aufruf: Tötet die Knochenpeitscher!‡현상 수배: 해골채찍 독수리!‡Se busca: Atizahuesos. Muertos.‡Se busca: Atizahuesos ¡Muertos!‡On recherche : des Fouette-radius morts !‡通缉：白骨秃鹫！‡懸賞:鞭骨者的死亡!',
    nil,
    'Mate 20 Açoita-ossos. A seguir, apresente-se a Taela Perenanda na Fortaleza Alleriana, na Mata Terokkar.‡Убейте 20 костеклювов и вернитесь к Тэле Вечной Страннице в бастион Аллерии в лесу Тероккар.‡Tötet 20 Knochenpeitscher und meldet Euch dann bei Taela Immerlauf in Allerias Feste in den Wäldern von Terokkar.‡해골채찍 독수리 20마리를 처치한 후, 테로카르 숲의 알레리아 성채에 있는 타엘라 에버스트라이드에게 가져가야 합니다.‡Mata 20 Atizahuesos y después preséntate ante Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Mata a 20 Atizahuesos y después preséntate ante Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Tuez 20 Fouette-radius puis retournez voir Taela Vassanfin au Bastion allérien dans la forêt de Terokkar.‡杀死20只白骨秃鹫，然后向泰罗卡森林内奥蕾莉亚要塞的泰拉·远途复命。‡殺了20隻鞭骨者後回報給泰洛卡森林裡艾蘭里堡壘的泰伊拉·艾薇斯崔德。',
  }
},
[10034] = {
  {
    'Procura-se: açoita-ossos mortos!‡Награда за убитых костехлестов!‡Aufruf: Tötet die Knochenpeitscher!‡현상 수배: 해골채찍 독수리 처치!‡Se busca: Atizahuesos. Muertos.‡Se busca: Atizahuesos ¡Muertos!‡On recherche : des Fouette-radius morts !‡通缉：白骨秃鹫！‡懸賞:鞭骨者的死亡!',
    nil,
    'Mate 20 Açoita-ossos. A seguir, apresente-se a Mawg Tiroatroz na Vila de Quebrapedra, que fica na Mata Terokkar.‡Убейте 20 костеклювов и вернитесь к Маугу Лютострелу в форт Камнеломов в лесу Тероккар.‡Tötet 20 Knochenpeitscher und meldet Euch dann bei Mawg Grimmschlag in der Steinbrecherfeste in den Wäldern von Terokkar.‡해골채찍 독수리 20마리를 처치한 후 테로카르 숲의 돌망치 요새에 있는 마우그 그림샷에게 가져가야 합니다.‡Mata 20 Atizahuesos y, a continuación, ve a ver a Mawg Tirosiniestro en el Bastión Rompepedras, en el Bosque de Terokkar.‡Mata a 20 Atizahuesos y, a continuación, ve a ver a Mawg Tirosiniestro en el Bastión Rompepedras, en el Bosque de Terokkar.‡Tuez 20 Fouette-radius puis retournez voir Mawg Trait-sinistre au fort des Brise-pierres dans la forêt de Terokkar.‡杀死20只白骨秃鹫，然后向泰罗卡森林裂石堡的玛乌格·锐箭复命。‡殺了20隻鞭骨者後回報給泰洛卡森林裡碎石堡的矛克·邪擊。',
  }
},
[10035] = {
  {
    'Torgos!‡Торгос!‡Torgos!‡토르고스!‡¡Torgos!‡¡Torgos!‡Torgos !‡托古斯！‡托茍斯!',
    nil,
    'Atraia Torgos com a Carcaça de Trachela. Adquira uma Pena da Cauda de Torgos e entregue-a para Taela Perenanda na Fortaleza Alleriana, que fica na Mata Terokkar.‡Приманите Торгоса останками Трашелы, добудьте перо из его хвоста и отнесите его Тэле Вечной Страннице в бастион Аллерии в лесу Тероккар.‡Benutzt Trachelas Leichnam, um Torgos zu rufen. Besorgt eine Schwanzfeder von Torgos und kehrt dann zu Taela Immerlauf in Allerias Feste in den Wäldern von Terokkar zurück.‡트라첼라의 시체를 사용하여 토르고스를 내려오게 하여 토르고스의 꼬리 깃털 1개를 구한 후, 테로카르 숲의 알레리아 성채에 있는 타엘라 에버스트라이드에게 가져가야 합니다.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y llévasela a Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y llévasela a Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Faites venir Torgos à l\'aide de la Carcasse de Trachela. Procurez-vous une Plume de la queue de Torgos et rapportez-la à Taela Vassanfin au Bastion allérien dans la forêt de Terokkar.‡利用特拉克拉的残骸引出托古斯，将托古斯交给泰罗卡森林奥蕾莉亚要塞的泰拉·远途。‡利用崔奇拉的屍體引誘托苟斯出現。取得一根托茍斯的尾羽然後交給泰洛卡森林的艾蘭里堡壘的泰伊拉·艾薇斯崔德。',
  }
},
[10036] = {
  {
    'Torgos!‡Торгос!‡Torgos!‡토르고스!‡¡Torgos!‡¡Torgos!‡Torgos !‡托古斯！‡托茍斯!',
    nil,
    'Atraia Torgos com a Carcaça de Trachela. Recolha uma Pena da Cauda de Torgos e entregue-a para Mawg Tiroatroz na Vila de Quebrapedra, que fica na Mata Terokkar.‡Приманите Торгоса останками Трашелы, добудьте перо из его хвоста и отнесите его Маугу Лютострелу в форт Камнеломов в лесу Тероккар.‡Benutzt Trachelas Leichnam, um Torgos zu rufen. Besorgt eine Schwanzfeder von Torgos und kehrt dann zu Mawg Grimmschlag in der Steinbrecherfeste in den Wäldern von Terokkar zurück.‡트라첼라의 시체를 이용해 토르고스를 불러내야 합니다. 토르고스의 꼬리 깃털 1개를 구해서 테로카르 숲의 돌망치 요새에 있는 마우그 그림샷에게 가져가야 합니다.‡Invoca a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y vuelve a ver a Mawg Tirosiniestro en el Bastión Rompepedras del Bosque de Terokkar.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y vuelve a ver a Mawg Tirosiniestro en el Bastión Rompepedras del Bosque de Terokkar.‡Faites venir Torgos à l\'aide de la Carcasse de Trachela. Procurez-vous une Plume de la queue de Torgos et apportez-la à Mawg Trait-sinistre au fort des Brise-Pierres dans la forêt de Terokkar.‡利用特拉克拉的残骸引出托古斯，将托古斯交给泰罗卡森林裂石堡的玛乌格·锐箭。‡利用崔奇拉的屍體引誘托苟斯出現。取得一根托苟斯的尾羽然後回到泰洛卡森林的碎石堡找矛克·邪擊。',
  }
},
[10037] = {
  {
    'Prefiro pescar‡Без рыбалки‡Ich würd\' lieber angeln‡낚시나 해볼까요?‡Mejor pescando‡Mejor pescando‡J\'préférerais aller à la pêche‡宁可去钓鱼‡當然是釣魚',
    nil,
    'Traga 8 Enguias Brilhescama Imaculadas para Seth em Shattrath.‡Принесите 8 тушек блестящих угрей Сету в Шаттрат.‡Bringt 8 makellose Schimmerschuppenaale zu Seth in Shattrath.‡샤트라스에 있는 세스에게 온전한 은비늘 뱀장어 8마리를 가져가야 합니다.‡Lleva 8 anguilas brilloescama prístinas a Seth en Shattrath.‡‡Apportez 8 Anguilles Scintécaille en parfait état à Seth à Shattrath.‡为沙塔斯城的塞瑟带回8条新鲜的亮鳞电鳗。‡將8隻新鮮閃鱗鰻交給撒塔斯的塞斯。',
  }
},
[10038] = {
  {
    'Fale com o recruta Semanas‡Разговор с рядовым Виксом‡Sprecht mit Gefreiter Wöch‡병사 윅스와의 대화‡Habla con el soldado Semanas‡Habla con el soldado Semanas‡Parler au soldat Weeks‡援助列兵维克斯‡與士兵維克斯談話',
    nil,
    'Fale com o Recruta Semanas perto da entrada norte da Aldeia Grangol\'var, na Mata Terokkar.‡Найдите рядового Викса возле северного входа в деревню Грангол\'вар в лесу Тероккар и поговорите с ним.‡Sprecht mit Gefreiter Wöch in der Nähe des nördlichen Eingangs von Grangol\'var in den Wäldern von Terokkar.‡테로카르 숲에 위치한 그란골바르 마을의 북쪽 입구 근처에 있는 병사 윅스를 찾아서 대화해야 합니다.‡Localiza al soldado Semanas cerca de la entrada norte del Poblado Grangol\'var en el Bosque de Terokkar.‡‡Trouvez le soldat Weeks près de l\'entrée nord de Grangol\'var dans la forêt de Terokkar et parlez-lui.‡与泰罗卡森林格兰戈瓦村北方入口附近的列兵维克斯谈一谈。‡在泰洛卡森林的葛蘭戈瓦村北方入口處找到士兵維克斯並與他談話。',
  }
},
[10039] = {
  {
    'Fale com a batedora Neftis‡Разговор с разведчицей Нефтис‡Sprecht mit Späherin Neftis‡정찰병 네프티스와 대화‡Habla con la exploradora Neftis‡Habla con la exploradora Neftis‡Parler à l\'éclaireur Neftis‡援助斥候奈弗蒂丝‡與斥候奈夫提斯談話',
    nil,
    'Fale com a Batedora Neftis perto da entrada sul da Aldeia Grangol\'var, na Mata Terokkar.‡Найдите разведчицу Нефтис возле южного входа в деревню Грангол\'вар в лесу Тероккар и поговорите с ней.‡Sprecht mit Späherin Neftis in der Nähe des südlichen Eingangs von Grangol\'var in den Wäldern von Terokkar.‡테로카르 숲에 있는 그란골바르 마을의 남쪽 입구 근처에 있는 정찰병 네프티스를 찾아서 대화하십시오.‡Localiza a la exploradora Neftis cerca de la entrada sur del Poblado Grangol\'var en el Bosque de Terokkar.‡‡Trouvez l\'éclaireur Neftis près de l\'entrée sud de Grangol\'var dans la forêt de Terokkar et parlez-lui.‡与泰罗卡森林格兰戈瓦村南方入口附近的斥候奈弗蒂丝谈一谈。‡在泰洛卡森林的葛蘭戈瓦村南方入口處找到斥候奈夫提斯並與她談談。',
  }
},
[10040] = {
  {
    'Quem são eles?‡Кто они?‡Wer sind sie?‡그들의 정체‡¿Quiénes son?‡¿Quiénes son?‡Qui sont-ils ?‡他们是谁？‡他們是誰?',
    nil,
    'Usando o disfarce, fale com o Iniciado Sombrio, o Operário Sombrio e o Conselheiro Sombrio. A seguir, fale novamente com o Recruta Semanas na Aldeia Grangol\'var, que fica na Mata Terokkar.‡Замаскируйтесь и поговорите с мрачным посвященным, мрачным работником и мрачным советником, после чего вернитесь к рядовому Виксу у деревни Грангол\'вар в лесу Тероккар.‡Sprecht mit dem schattenhaften Initianden, dem schattenhaften Hilfsarbeiter und dem schattenhaften Berater. Kehrt dann zu Gefreiter Wöch in Grangol\'var in den Wäldern von Terokkar zurück.‡변장을 한 동안 어둠의 수습생, 어둠의 인부, 어둠의 조언자와 대화한 후, 테로카르 숲의 그란골바르 마을에 있는 병사 윅스에게 돌아가야 합니다.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver al soldado Semanas en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver al soldado Semanas en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Parlez avec l\'Initié ténébreux, le Travailleur ténébreux et le Conseiller ténébreux en portant le déguisement. Puis retournez voir le soldat Weeks à Grangol\'var dans la forêt de Terokkar.‡在伪装状态下，与阴暗新兵、阴暗劳工和阴暗顾问交谈，然后向泰罗卡森林格兰戈瓦村的列兵维克斯复命。‡於偽裝中與幽暗的新兵，幽暗的工人及幽暗的諫言者說話。完成後回到泰洛卡森林的葛蘭戈瓦村中找士兵維克斯回報。',
  }
},
[10041] = {
  {
    'Quem são eles?‡Кто они?‡Wer sind sie?‡그들의 정체‡¿Quiénes son?‡¿Quiénes son?‡Qui sont-ils ?‡他们是谁？‡他們是誰?',
    nil,
    'Usando o disfarce, fale com o Iniciado Sombrio, o Operário Sombrio e o Conselheiro Sombrio. A seguir, fale novamente com a Batedora Neftis na Aldeia Grangol\'var, que fica na Mata Terokkar.‡Замаскируйтесь и поговорите с Мрачным посвященным, Мрачным работником и Мрачным советником, после чего вернитесь к разведчице Нефтис в деревню Грангол\'вар в лесу Тероккар.‡Sprecht mit dem schattenhaften Initianden, dem schattenhaften Hilfsarbeiter und dem schattenhaften Berater. Kehrt dann zu Späherin Neftis in Grangol\'var in den Wäldern von Terokkar zurück.‡변장을 하고서 어둠의 수습생, 어둠의 인부, 어둠의 조언자와 대화하십시오. 그런 다음 테로카르 숲의 그란골바르 마을에 있는 정찰병 네프티스에게 돌아가십시오.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver a la exploradora Neftis en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver a la exploradora Neftis en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Parlez avec l\'Initié ténébreux, le Travailleur ténébreux et le Conseiller ténébreux en portant le déguisement. Puis retournez voir l\'éclaireur Neftis à Grangol\'var dans la forêt de Terokkar.‡在伪装状态下，与阴暗新兵、阴暗劳工和阴暗顾问交谈，然后向泰罗卡森林格兰戈瓦村的斥候奈弗蒂丝复命。‡於偽裝中與幽暗的新兵，幽暗的工人及幽暗的諫言者說話。完成後回到泰洛卡森林的葛蘭戈瓦村中找斥候奈夫提斯回報。',
  }
},
[10042] = {
  {
    'Morte ao Concílio das Sombras!‡Убить Совет Теней!‡Tötet den Schattenrat!‡어둠의 의회 제거!‡¡Acaba con el Consejo de la Sombra!‡¡Acaba con el Consejo de la Sombra!‡Tuer le Conseil des ombres !‡暗影议会必须死！‡殺光暗影議會!',
    nil,
    'Mate 10 Executores Sombrios, 10 Evocadores Sombrios e o Mestre Sombrio Angústio. A seguir, fale novamente com o Tenente Martelobrita na Fortaleza Alleriana, que fica na Mata Terokkar.‡Убейте 10 мрачных палачей, 10 мрачных призывателей и повелителя теней Скорбного, после чего вернитесь к лейтенанту Булыжному Молоту в бастион Аллерии в лесу Тероккар.‡Tötet 10 schattenhafte Henker, 10 schattenhafte Beschwörer und Schattenmeister Gram und kehrt dann zu Leutnant Kieshammer in Allerias Feste in den Wäldern von Terokkar zurück.‡어둠의 집행자 10명, 어둠의 소환사 10명과 어둠의 주인 그리브를 처치한 후, 테로카르 숲의 알레리아 성채에 있는 부관 그래블해머에게 보고해야 합니다.‡Mata 10 verdugos oscuros, 10 invocadores oscuros y al líder oscuro. A continuación, preséntate ante el teniente Gravamartillo en el Bastión Allerian, en el Bosque de Terokkar.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante el teniente Gravamartillo en el Bastión Allerian, en el Bosque de Terokkar.‡Tuez 10 Exécuteurs ténébreux, 10 Invocateurs ténébreux et le Maître d\'ombre Dolent, puis retournez auprès du lieutenant Gravillemartel au Bastion allérien dans la forêt de Terokkar.‡杀死10个阴暗刽子手、10个阴暗召唤者和暗影主宰格里弗，然后向泰罗卡森林奥蕾莉亚要塞的加维·砂锤中尉复命。‡殺掉10個幽暗的劊子手，10個幽暗的召喚者及暗影大師葛瑞弗，然後回到泰洛卡森林的艾蘭里堡壘與葛拉伏汗中尉回報。',
  }
},
[10043] = {
  {
    'Morte ao Concílio das Sombras!‡Убить Совет Теней!‡Tötet den Schattenrat!‡어둠의 의회 제거!‡¡Acaba con el Consejo de la Sombra!‡¡Acaba con el Consejo de la Sombra!‡Tuer le Conseil des ombres !‡暗影议会必须死！‡殺光暗影議會!',
    nil,
    'Mate 10 Executores Sombrios, 10 Evocadores Sombrios e o Mestre Sombrio Angústio. A seguir, fale novamente com a Conselheira Faila na Vila de Quebrapedra, que fica na Mata Terokkar.‡Убейте 10 мрачных палачей, 10 мрачных призывателей и повелителя теней Скорбного, после чего вернитесь к советнице Файле в форт Камнеломов в лесу Тероккар.‡Tötet 10 schattenhafte Henker, 10 schattenhafte Beschwörer und Schattenmeister Gram und kehrt dann zu Beraterin Faila in der Steinbrecherfeste in den Wäldern von Terokkar zurück.‡어둠의 집행자 10명, 어둠의 소환사 10명과 어둠의 주인 그리브를 해치운 후 테로카르 숲의 돌망치 요새에 있는 조언자 파일라에게 보고하십시오.‡Mata 10 verdugos oscuros, 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante la consejera Faila en el Bastión Rompepedras, en el Bosque de Terokkar.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante la consejera Faila en el Bastión Rompepedras, en el Bosque de Terokkar.‡Tuez 10 Exécuteurs ténébreux, 10 Invocateurs ténébreux et le Maître d\'ombre Dolent, puis retournez auprès de la conseillère Faila au fort des Brise-Pierres dans la forêt de Terokkar.‡杀死10个阴暗刽子手、10个阴暗召唤者和暗影主宰格里弗，然后向泰罗卡森林裂石堡的顾问菲埃拉复命。‡殺掉10個幽暗的劊子手，10個幽暗的召喚者及暗影大師葛瑞弗，然後回到泰洛卡森林的碎石堡回報諫言者菲拉。',
  }
},
[10044] = {
  {
    'Visita à Grande Mãe‡Разговор с Великой матерью‡Ein Besuch bei der Großmutter‡대모 방문‡Una visita a la Abuela‡Una visita a la Abuela‡Une visite à la grande-mère‡拜访盖亚安祖母‡與祖母的會面',
    nil,
    'Fale com a Grande Mãe Geyah e escute o que ela tem a dizer.‡Поговорите с Великой Матерью Гейей и сделайте все, о чем она вас попросит.‡Sprecht mit Großmutter Geyah und hört Euch an, was sie zu sagen hat.‡대모 게야를 만나서 그녀가 하는 말을 잘 들어야 합니다.‡Habla con la Abuela Geyah y escucha lo que tiene que decirte.|n‡Habla con la Abuela Geyah y escucha lo que tiene que decirte.|n‡Parlez à la grande-mère Geyah et écoutez ce qu\'elle a à vous dire.‡与盖亚安祖母谈谈，听她讲述故事。‡與祖母吉雅談談，並聆聽她跟你說的內容。',
  }
},
[10045] = {
  {
    'Componentes materiais‡Компоненты зелья‡Zutaten sammeln‡물약 재료‡Componentes materiales‡Componentes materiales‡Composants matériels‡必需的材料‡材料成分',
    nil,
    'A Grande Mãe Geyah, de Garadar, em Nagrand, pediu para você coletar 1 Raiz de Olemba, 1 Fruta-do-pântano, 1 Fronde de Telaari e 1 Espinodrago.‡Принесите великой матери Гейе в Гарадар 1 корень олембы, 1 кустик клюквы, 1 телаарский папоротник и 1 побег драконьего шипа.‡Großmutter Geyah in Garadar in Nagrand möchte, dass Ihr 1 Olembawurzel, 1 Marschenbeere, 1 Telaarifarn und 1 Drachenwirbel sammelt.‡나그란드의 가라다르에 있는 대모 게야가 올렘바 뿌리, 늪딸기, 텔라아리 잎사귀, 용가리통풀을 1개씩 모아달라고 했습니다.‡La Abuela Geyah en Garadar, en Nagrand, te ha pedido 1 raíz de olemba, 1 baya de la marisma, 1 fronda de Telaari y 1 espinazo de dragón.|n‡La Abuela Geyah en Garadar, en Nagrand, te ha pedido 1 raíz de olemba, 1 baya de la marisma, 1 fronda de Telaari y 1 espinazo de dragón.|n‡La grande-mère Geyah de Garadar en Nagrand vous a demandé de cueillir 1 Racine d\'Olemba, 1 Canneberge, 1 Palme telaari et 1 Épine-de-dragon.‡纳格兰加拉达尔的盖亚安祖母要你收集1根奥雷巴根须、1颗沼泽莓、1片塔拉蕨和1株龙脊草。‡納葛蘭的卡拉達爾的祖母吉雅要你收集1個奧萊姆貝根莖，1個沼澤梅，1個泰拉蕊藻葉及1個龍脊。',
  }
},
[10046] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡어둠의 문을 넘어‡A través de El Portal Oscuro‡‡À travers la Porte des ténèbres‡‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e fale com Nazgrel em Thrallmar.‡Пройдите через Темный портал и поговорите с Назгрелом в Траллмаре.‡Reist durch das Dunkle Portal und sprecht mit Nazgrel in Thrallmar.‡어둠의 문으로 들어가서 스랄마에 있는 나즈그렐과 대화하십시오.‡Viaja a través de El Portal Oscuro y habla con Nazgrel en Thrallmar.‡Viaja a través de El Portal Oscuro y habla con Nazgrel en Thrallmar.‡Traversez la Porte des ténèbres et parlez à Nazgrel à Thrallmar.‡‡通過黑暗之門，與索爾瑪的納茲格雷爾談談。',
  }
},
[10047] = {
  {
    'O Caminho da Glória‡Путь Славы‡Der Pfad des Ruhms‡영광의 길‡El Camino a la Gloria‡El Camino a la Gloria‡Le sentier de la Gloire‡荣耀之路‡光榮之路',
    nil,
    'Purifique 8 Esqueletos Pisoteados no Caminho da Glória com a Água Benta Draeneica, e então apresente-se ao Áugure Dimensional Kryv na Fortaleza da Honra.‡Окропите 8 истоптанных скелетов, лежащих на Пути Славы, святой водой дренеев, после чего возвращайтесь в Оплот Чести к провидцу бед Криву.‡Reinigt 8 zertrampelte Skelette auf dem Pfad des Ruhms mit dem Weihwasser der Draenei und kehrt dann zu Warpseher Kryv in der Ehrenfeste zurück.‡드레나이 성수로 영광의 길에 있는 짓이겨진 해골 8마리를 정화하고 명예의 요새에 있는 차원의 점술가 크리브에게 돌아가야 합니다.‡Purifica 8 esqueletos pisoteados en El Camino a la Gloria con agua sagrada draenei y vuelve a ver al arúspice de distorsión Kryv en el Bastión del Honor.‡Purifica a 8 esqueletos pisoteados en El Camino a la Gloria con agua sagrada draenei y vuelve a ver al arúspice de distorsión Kryv en el Bastión del Honor.‡Purifiez 8 Squelettes piétinés sur le Sentier de la Gloire avec de l\'Eau bénite draeneï, puis retournez voir le Scrute-dimensions Kryv au bastion de l\'Honneur.‡在荣耀之路上使用德莱尼圣水净化8个被践踏的骷髅，然后返回荣耀堡向位面占卜者克雷夫复命。‡在光榮之路上使用德萊尼聖水清洗8個被踐踏的骨骸，完成後回到榮譽堡找星移占卜師克里。',
  }
},
[10048] = {
  {
    'Um punhado de pó mágico‡Магическая пыль‡Eine Handvoll Magiestaub‡‡Un puñado de polvo mágico‡‡Une poignée de poussière magique‡‡',
    nil,
    'Colete 7 punhados de Pó Pacificador para Andarl, na Fortaleza Alleriana.‡Принесите 7 горстей пыли усмирения Андарлу в Бастион Аллерии.‡Sammelt 7 Handvoll besänftigender Staub für Andarl in Allerias Feste.‡‡Reúne 7 puñados de polvo pacificador para Andarl en el Bastión Allerian.‡Reúne 7 puñados de polvo pacificador para Andarl en el Bastión Allerian.‡Récoltez 7 poignées de Poudre pacifiante pour Andarl au Bastion allérien.‡‡',
  }
},
[10049] = {
  {
    'Um punhado de pó mágico‡Магическая пыль‡Eine Handvoll Magiestaub‡‡Un puñado de polvo mágico‡‡Une poignée de poussière magique‡‡',
    nil,
    'Colete 7 punhados de Pó Pacificador para Kurgatok, na Vila de Quebrapedra.‡Принесите 7 горстей пыли усмирения Каргатоку в Форт Камнеломов.‡Sammelt 7 Handvoll besänftigenden Staubs für Kurgatok in der Steinbrecherfeste.‡‡Reúne 7 puñados de polvo pacificador para Kurgatok en el Bastión Rompepedras.‡Reúne 7 puñados de polvo pacificador para Kurgatok en el Bastión Rompepedras.‡Récoltez 7 poignées de Poudre pacifiante pour Kurgatok au fort des Brise-pierres.‡‡',
  }
},
[10050] = {
  {
    'Almas obstinadas‡Непреклонные духи‡Unerschütterliche Seelen‡영혼의 안식‡Almas Implacables‡Almas Implacables‡Âmes Inflexibles‡阴魂不散‡不屈的靈魂',
    nil,
    'O Guarda de Honra Wesilow quer que você derrote 12 Soldados Rasos Obstinados, 10 Feiticeiros Obstinados e 5 Cavaleiros Obstinados no Arsenal da Expedição, ao sul da sua posição atual.‡Убейте 12 непреклонных пехотинцев, 10 непреклонных колдунов и 5 непреклонных рыцарей в оружейной экспедиции на юге по просьбе отважного стража Весилоу.‡Ehrenwache Wesilow möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 10 unerschütterliche Zauberhexer und 5 unerschütterliche Ritter beim Expeditionsrüstlager tötet.‡명예의 경비병 웨실로우가 남쪽에 있는 원정대 무기고에서 불굴의 보병 12명, 불굴의 마술사 10명, 불굴의 기사 5명을 처치해 달라고 부탁했습니다.‡El guardia de honor Wesilow quiere que derrotes a 12 lacayos Implacables, 10 hechiceros Implacables y 5 caballeros Implacables en la Armería de Expedición del sur.‡El guardia de honor Wesilow quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición del sur.‡Le garde d\'honneur Wesilow veut que vous vainquiez 12 Fantassins inflexibles, 10 Ensorceleurs inflexibles et 5 Chevaliers inflexibles à l\'Armurerie de l\'expédition, au sud.‡荣耀堡卫兵维斯洛要你前往南边的远征军物资库，杀死12个步兵的阴魂、10个巫师的阴魂和5个骑士的阴魂。‡榮譽守衛衛斯羅要你去南方的遠征隊軍械庫打敗12個不屈的步兵，10個不屈的魔巫士，和5個不屈的騎士。',
  }
},
[10051] = {
  {
    'Fuga do Pontal Asardente!‡Побег из лагеря Огнекрылых‡Ausbruch aus dem Posten der Feuerschwingen!‡불꽃날개 거점 탈출‡¡Huida del Alto Ala de Fuego!‡¡Huida del Alto Ala de Fuego!‡L\'évasion de la halte Aile-de-feu‡逃离火翼岗哨！‡逃出火翼崗哨!',
    nil,
    'Escolte Isla Cristelar na fuga do Pontal Asardente. A seguir, apresente-se ao Capitão Auric Buscassol na Fortaleza Alleriana, que fica na Mata Terokkar.‡Проводите Ислу Звездную Гриву в безопасное место, после чего расскажите об этом капитану Аурику Ловчему Солнца в бастионе Аллерии в лесу Тероккар.‡Geleitet Isla Sternenmähne in Sicherheit und meldet Euch dann bei Hauptmann Auric Sonnenjäger in Allerias Feste in den Wäldern von Terokkar.‡이슬라 스타메인을 안전한 곳까지 호위한 후 테로카르 숲의 알레리아 성채에 있는 대장 아우릭 선체이서에게 보고해야 합니다.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver al capitán Auric Cazasol en el Bastión Allerian en el Bosque de Terokkar.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver al capitán Auric Cazasol en el Bastión Allerian en el Bosque de Terokkar.‡Escortez Isla Tressétoile jusqu\'à un lieu sûr puis faites votre rapport au capitaine Auric Courresoleil au Bastion allérien dans la forêt de Terokkar.‡护送伊斯拉·星鬃逃离火翼岗哨，然后向泰罗卡森林奥蕾莉亚要塞的乌瑞克·猎日者上尉复命。‡護送伊斯拉·星鬃到安全的地方後回報泰洛卡森林裡艾蘭里堡壘的阿瑞克·追日者上尉。',
  }
},
[10052] = {
  {
    'Fuga do Pontal Asardente!‡Побег из лагеря Огнекрылых‡Ausbruch aus dem Posten der Feuerschwingen!‡불꽃날개 거점 탈출‡¡Huida del Alto Ala de Fuego!‡¡Huida del Alto Ala de Fuego!‡L\'évasion de la halte Aile-de-feu‡逃离火翼岗哨！‡逃出火翼崗哨!',
    nil,
    'Escolte Isla Cristelar na fuga do Pontal Asardente e, a seguir, apresente-se à Conselheira Faila na Vila de Quebrapedra, que fica na Mata Terokkar.‡Проводите Ислу Звездную Гриву в безопасное место, после чего расскажите об этом советнице Файле в форте Камнеломов в лесу Тероккар.‡Geleitet Isla Sternenmähne in Sicherheit und meldet Euch dann bei Beraterin Faila in der Steinbrecherfeste in den Wäldern von Terkkokar.‡이슬라 스타메인을 안전한 곳까지 호위한 후 테로카르 숲의 돌망치 요새에 있는 조언자 파일라에게 보고하십시오.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver a la consejera Faila en el Bastión Rompepedras en el Bosque de Terokkar.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver a la consejera Faila en el Bastión Rompepedras en el Bosque de Terokkar.‡Escortez Isla Tressétoile jusqu\'à un lieu sûr puis faites votre rapport à la conseillère Faila au fort des Brise-pierres dans la forêt de Terokkar.‡护送伊斯拉·星鬃逃离火翼岗哨，然后向泰罗卡森林裂石堡的顾问菲埃拉复命。‡護送伊斯拉星鬃到安全的地方後回報泰洛卡森林裡碎石堡的諫言者菲拉。',
  }
},
[10053] = {
  {
    'Dando cabo de Zeth\'Gor‡Расправиться с Зет\'Гором‡Zeth\'Gor bewältigen‡‡A por Zeth\'Gor‡‡S\'occuper de Zeth\'Gor‡‡',
    nil,
    'Derrote Grillok "Olho-negro" e vasculhe o covil para encontrar os Planos de Ataque do clã Olhos Sangrentos.‡Убейте Гриллока Пустого Глаза, обыщите его логово и найдите планы атаки Кровавой Глазницы.‡Tötet Grillok "Finsterauge" und durchsucht seinen Unterschlupf nach den Angriffsplänen des Blutenden Auges.‡‡Derrota a Grillok "Ojosombra" e inspecciona su guarida en busca de los planes de ataque de los Foso de Sangre.‡Derrota a Grillok "Ojosombra" e inspecciona su guarida en busca de los planes de ataque de los Foso de Sangre.‡Tuez Grillok « Sombroeil » et fouillez son repaire à la recherche des Plans d\'attaque de l\'Orbite-sanglante.‡‡',
  }
},
[10054] = {
  {
    'Ruína iminente‡Надвигающийся рок‡Drohende Verdammnis‡‡Fatalidad inminente‡‡Désastre imminent‡‡',
    nil,
    'Mate 15 Brutos dos Olhos Sangrentos, 10 Necrólitos dos Olhos Sangrentos, 5 Peões dos Olhos Sangrentos e o Senhor da Guerra Morkh, e então apresente-se à Tenente Amadi na torre ocidental da Fortaleza da Honra.‡Убейте 15 рубак, 10 некролитов, 5 батраков из клана Кровавой Глазницы и полководца Морка. О выполнении задания доложите лейтенанту Амади, которая находится в западной башне Оплота Чести.‡Tötet 15 Grunzer des Blutenden Auges, 10 Nekrolyten des Blutenden Auges, 5 Peons des Blutenden Auges und Kriegsherr Morkh. Meldet Euch danach bei Leutnant Amadi im westlichen Turm der Ehrenfeste.‡‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh, después informa a la teniente Amadi en la torre oeste del Bastión del Honor.‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh, después informa a la teniente Amadi en la torre oeste del Bastión del Honor.‡Tuez 15 Grunts de l\'Orbite-sanglante, 10 Nécrolytes de l\'Orbite-sanglante, 5 Péons de l\'Orbite-sanglante et le seigneur de guerre Morkh, puis faites votre rapport au lieutenant Amadi dans la tour ouest du bastion de l\'Honneur.‡‡',
  }
},
[10055] = {
  {
    'Sabendo usar, não vai faltar‡Ничто не пропадет даром‡Nichts verkommen lassen!‡재활용‡No desperdicies si puedes evitarlo‡No desperdicies si puedes evitarlo‡Faut pas gâcher‡回收材料‡不浪費，就不缺乏',
    nil,
    'Leve 8 pedaços de Metal Recuperado e 8 pedaços de Madeira Recuperada para Rumberto na Fortaleza da Honra.‡Принесите 8 кусков металлолома и 8 кусков древесины Болтую в Оплот Чести.‡Bringt 8 Stück gebrauchtes Metall und 8 Stück gebrauchtes Holz zu Dumphry in der Ehrenfeste.‡명예의 요새에 있는 덤프리에게 재활용 금속, 재활용 목재를 각각 8개씩 가져가야 합니다.‡Lleva 8 piezas de metal rescatado y 8 piezas de madera rescatada a Dumphry en el Bastión del Honor.‡Lleva 8 piezas de metal rescatado y 8 piezas de madera rescatada a Dumphry en el Bastión del Honor.‡Apportez 8 morceaux de Métal récupéré et 8 morceaux de Bois récupéré à Dumphry au bastion de l\'Honneur.‡给荣耀堡的达姆菲带去8块回收的金属和8块回收的木材。‡將8塊可利用的鐵及8塊可利用的木頭交給榮譽堡的戴夫利。',
  }
},
[10056] = {
  {
    'Suprimentos dos Olhos Sangrentos‡Припасы Кровавой Глазницы‡Vorräte des Blutenden Auges‡‡Suministros Foso Sangrante‡‡Les fournitures de l\'Orbite-sanglante‡‡',
    nil,
    'Destrua 6 pilhas de Suprimentos dos Olhos Sangrentos e apresente-se à Tenente Amadi na Fortaleza da Honra.‡Уничтожьте 6 складов припасов Кровавой Глазницы. О выполнении задания доложите лейтенанту Амади из Оплота Чести.‡Zerstört 6 Stapel Vorräte des Blutenden Auges und meldet Euch dann bei Leutnant Amadi in der Ehrenfeste zurück.‡‡Acaba con 6 pilas de suministros de Pozo Sangrante e informa a la teniente Amadi en el Bastión del Honor.‡Acaba con 6 pilas de suministros de Pozo Sangrante e informa a la teniente Amadi en el Bastión del Honor.‡Détruisez 6 piles de Fournitures de l\'Orbite-sanglante et faites votre rapport au lieutenant Amadi au bastion de l\'Honneur.‡‡',
  }
},
[10057] = {
  {
    'Espíritos de liderança‡Солдатская верность‡Suche nach den Anführern‡장교들의 영혼‡El liderazgo en el punto de mira‡El liderazgo en el punto de mira‡Se tourner vers les chefs‡寻找首领‡與領導者同在',
    nil,
    'Derrote os fantasmas do Arquimago Xintor e do Tenente-comandante Talvos, e fale novamente com o Guarda de Honra Wesilow na torre noroeste da Fortaleza da Honra.‡Победите духов верховного мага Ксинтора и лейтенанта-командора Талвоса и возвращайтесь к отважному стражу Весилоу в северо-западную башню Оплота Чести.‡Besiegt die Geister von Erzmagier Xintor und Feldkommandant Thalvos und kehrt dann zu Ehrenwache Wesilow im Turm nordwestlich der Ehrenfeste zurück.‡대마법사 진토르와 부사령관 탈보스의 영혼을 처치한 후 명예의 요새의 북서쪽 탑에 있는 명예의 경비병 웨실로우에게 돌아가야 합니다.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y vuelve con el guardia de honor Wesilow, a la torre noroeste del Bastión del Honor.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y vuelve con el guardia de honor Wesilow, a la torre noroeste del Bastión del Honor.‡Triomphez des fantômes de l\'archimage Xintor et du lieutenant-commandant Thalvos, puis retournez voir le garde d\'honneur Wesilow à la tour au nord-ouest du bastion de l\'Honneur.‡击败大法师辛托尔和塔沃斯少校的鬼魂，然后向荣耀堡西北部哨塔的荣耀堡卫兵维斯洛复命。‡擊敗大法師辛特和少校薩沃斯的鬼魂後回到榮譽堡西北邊的塔中找榮譽守衛衛斯羅。',
  }
},
[10058] = {
  {
    'Um velho presente‡Старый дар‡Ein altes Geschenk‡오래된 선물‡Un viejo regalo‡Un viejo regalo‡Un cadeau ancien‡古老的礼物‡一份多年的禮物',
    nil,
    'Recupere o livro Mistérios da Luz e leve-o para o Padre Malgor Devídicos na Fortaleza da Honra.‡Верните "Таинства Света" отцу Малгору Девидикусу в Оплот Чести.‡Besorgt die Geheimnisse des Lichts und bringt das Buch zu Vater Malgor Devidicus in der Ehrenfeste zurück.‡\'빛의 신비\'를 되찾아서 명예의 요새에 있는 신부 말고르 데비디쿠스에게 가져가야 합니다.‡Recupera los Misterios de la Luz y llévaselos al padre Malgor Devidicus en el Bastión del Honor.‡Recupera los Misterios de la Luz y llévaselos al padre Malgor Devidicus en el Bastión del Honor.‡Récupérez les « Mystères de la Lumière » et rapportez-le au père Malgor Devidicus au bastion de l’Honneur.‡将《圣光的秘密》交给荣耀堡的玛格尔·戴维迪库斯神父。‡取得光明的奧秘後回到榮譽堡交給神父摩葛·戴維迪克斯。',
  }
},
[10059] = {
  {
    'Dando cabo de Zeth\'Gor‡Расправиться с Зет\'Гором‡Zeth\'Gor bewältigen‡‡A por Zeth\'Gor‡‡S\'occuper de Zeth\'Gor‡‡',
    nil,
    'Mate Grillok "Olho-negro" e vasculhe seu covil para encontrar os Planos de Ataque dos Olhos Sangrentos.‡Убейте Гриллока Пустого Глаза, обыщите его логово и найдите планы атаки Кровавой Глазницы.‡Tötet Grillok "Finsterauge" und durchsucht seinen Unterschlupf nach den Angriffsplänen des Blutenden Auges.‡‡Mata a Grillok "Ojosombra" y busca en su guarida los planes de ataque de los Foso Sangrante.‡Mata a Grillok "Ojosombra" y busca en su guarida los planes de ataque de los Foso Sangrante.‡Tuez Grillok « Sombroeil » et fouillez son repaire à la recherche des Plans d\'attaque de l\'Orbite-sanglante.‡‡',
  }
},
[10060] = {
  {
    'Ruína iminente‡Надвигающийся рок‡Drohende Verdammnis‡‡Fatalidad inminente‡‡Désastre imminent‡‡',
    nil,
    'Mate 15 Brutos dos Olhos Sangrentos, 10 Necrólitos dos Olhos Sangrentos, 5 Peões dos Olhos Sangrentos e o Senhor da Guerra Morkh. Então apresente-se ao Guarda Pétreo Ambelão, no Acampamento Quebra-espinha.‡Убейте 15 рубак, 10 некролитов, 5 батраков из клана Кровавой Глазницы и полководца Морка. О выполнении задания доложите каменному стражу Амбелану на Заставу Хребтолома.‡Tötet 15 Grunzer des Blutenden Auges, 10 Nekrolyten des Blutenden Auges, 5 Peons des Blutenden Auges und Kriegsherr Morkh. Meldet Euch danach bei Steingardist Ambelan im Rückenbrechergrat.‡‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh. A continuación, preséntate ante el guardia de piedra Ambelan en la Cresta Rompeloma.‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh. A continuación, preséntate ante el guardia de piedra Ambelan en la Cresta Rompeloma.‡Tuez 15 Grunts de l\'Orbite-sanglante, 10 Nécrolytes de l\'Orbite-sanglante, 5 Péons de l\'Orbite sanglante et le seigneur de guerre Morkh. Puis faites votre rapport au garde de pierre Ambelan sur la crête Brise-épine.‡‡',
  }
},
[10061] = {
  {
    'O Obstinado‡Непреклонные‡Die Unerschütterlichen‡환영의 예언‡Los Implacables‡‡Les Inflexibles‡‡永不屈服',
    nil,
    'Grolag quer que você derrote 12 Soldados Rasos Obstinados, 10 Feiticeiros Obstinados e 5 Cavaleiros Obstinados no Arsenal da Expedição, ao sul da Fortaleza da Honra.‡Убейте 12 непреклонных пехотинцев, 10 непреклонных колдунов и 5 непреклонных рыцарей в оружейной экспедиции к югу от Оплота Чести по просьбе Грелага.‡Grelag möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 10 unerschütterliche Zauberhexer und 5 unerschütterliche Ritter am Expeditionsrüstlager südlich der Ehrenfeste tötet.‡그렐라그가 명예의 요새의 남쪽에 원정대 무기고에 있는 불굴의 보병 12명, 불굴의 마술사 10명, 불굴의 기사 5명에게 안식을 찾아달라고 부탁했습니다.‡Grelag quiere que derrotes a 12 lacayos Implacables, 10 hechiceros Implacables y 5 caballeros Implacables en la Armería de Expedición, al sur del Bastión del Honor.‡Grelag quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición, al sur del Bastión del Honor.‡Grelag veut que vous vainquiez 12 Fantassins inflexibles, 10 Ensorceleurs inflexibles et 5 Chevaliers inflexibles à l\'Armurerie de l\'expédition, au sud du bastion de l\'Honneur.‡‡格萊克要你前往榮譽堡南方的遠征軍械庫打敗12個不屈的步兵，10個不屈的魔巫士，和5個不屈的騎士。',
  }
},
[10062] = {
  {
    'Espíritos de liderança‡Солдатская верность‡Suche nach den Anführern‡‡El liderazgo en el punto de mira‡‡Tourné vers le commandement‡‡',
    nil,
    'Derrote os fantasmas do Arquimago Xintor e do Tenente-comandante Talvos, e fale novamente com Grolag no Acampamento Quebra-espinha.‡Победите духов верховного мага Ксинтора и лейтенанта-командора Талвоса и возвращайтесь к Грелагу на Заставу Хребтолома.‡Besiegt die Geister von Erzmagier Xintor und Feldkommandant Thalvos und kehrt dann zu Grelag im Rückenbrechergrat zurück.‡‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y regresa junto a Grelag en Cresta Rompeloma.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y regresa junto a Grelag en Cresta Rompeloma.‡Triomphez des fantômes de l\'archimage Xintor et du lieutenant-commandant Thalvos, puis retournez voir Grelag sur la Crête brise-échine.‡‡',
  }
},
[10063] = {
  {
    'Liga dos Exploradores: isso lá é coisa de gnomo?‡Лига исследователей: что здесь делают гномы?‡Forscherliga, für Gnome geeignet?‡탐험가 연맹 단원이 되기를 원하는 노움?‡Liga de Expedicionarios, ¿cosa de gnomos?‡Liga de Expedicionarios, ¿cosa de gnomos?‡La Ligue des explorateurs ? C\'est pas un truc de gnomes ?‡探险者协会要为侏儒服务吗？‡探險者協會，那是給地精的東西嗎?',
    nil,
    'Fale com Xote Cabeçote, que está acampado em um velho casco de tartaruga na costa a norte do Entreposto Rubro.‡Найдите Клоппера Бацбаха – он обосновался в старом черепашьем панцире на берегу к северу от Кровавой заставы.‡Zieht los und sucht nach Klopper Knacksklug, der sich in einem alten Schildkrötenpanzer an der Küste nördlich der Blutwacht eingerichtet hat.‡핏빛 감시초소의 북쪽 해안에 있는 오래된 거북껍질 속에서 야영 중인 클로퍼 위즈뱅을 찾아야 합니다.‡Encuentra a Clopper Zumbibang que está acampado en un viejo caparazón de tortuga en la costa al norte de la Avanzada de Sangre.‡Encuentra a Clopper Zumbibang que está acampado en un viejo caparazón de tortuga en la costa al norte de la Avanzada de Sangre.‡Trouvez Clopper Crackboum, qui campe dans une vieille carapace de tortue sur la côte au nord du Guet du sang.‡找到在秘血岗哨北海岸的龟壳里扎营的克劳伯·维兹班。‡在血色守望的北邊海岸上的破舊龜殼處尋找克羅波·維茲班。',
  }
},
[10064] = {
  {
    'Fala com a minha mão!‡Длань Аргуса‡Sprecht zu der Hand‡아르거스의 대리인과의 대화‡Habla con la Mano‡Habla con la Mano‡Parle à la main‡阿古斯之手‡與阿格斯之手談談',
    nil,
    'Apresente-se à Batedora Jorli no Recanto do Vindicante.‡Найдите в селении Привал Защитника разведчицу Джорли.‡Erstattet Späherin Jorli bei Verteidigers Ruh\' Bericht.‡구원자의 안식처에 있는 정찰병 요를리에게 보고해야 합니다.‡Preséntate a la exploradora Jorli en El Reposo del Vindicador.‡Preséntate a la exploradora Jorli en El Reposo del Vindicador.‡Présentez-vous à l\'éclaireur Jorli au Repos du redresseur de torts.‡向守备官营地的斥候约莉报告。‡向復仇者之陵的斥候喬爾力報到。',
  }
},
[10065] = {
  {
    'Limpa-trilhos‡Зеленая улица‡Eine Schneise schlagen‡퇴로 확보‡Abrirse paso‡Abrirse paso‡Ouvrir un chemin‡披荆斩棘‡清出一條路來',
    nil,
    'Mate 10 Assoladores Enfurecidos e fale novamente com a Batedora Jorli no Recanto do Vindicante.‡Убейте 10 разъяренных опустошителей и вернитесь на Привал Защитника к разведчице Джорли.‡Tötet 10 wütende Felshetzer und kehrt zu Späherin Jorli bei Verteidigers Ruh\' zurück.‡사나운 갈퀴발톱 10마리를 처치한 후 구원자의 안식처에 있는 정찰병 요를리에게 돌아가야 합니다.‡Mata 10 devastadores iracundos e informa a la exploradora Jorli en El Reposo del Vindicador.‡Mata a 10 devastadores iracundos e informa a la exploradora Jorli en El Reposo del Vindicador.‡Tuez 10 Ravageurs enragés puis retournez voir l\'éclaireur Jorli au Repos du redresseur de torts.‡杀掉10个被激怒的掠食者，然后向守备官营地的斥候约莉复命。‡殺了10個暴怒的劫毀者後回到復仇者之陵找斥候喬爾力。',
  }
},
[10066] = {
  {
    'Trama sórdida‡Тенета судьбы‡Alles im Griff‡돌연변이 올가미 덩굴손‡¡Vaya una maraña de telarañas!‡¡Vaya una maraña de telarañas!‡Oh, quelle toile embrouillée...‡纠结之网‡噢，他們所編織的糾纏的圈套',
    nil,
    'Mate 8 Emaranhadores Mutantes e apresente-se à Vindicante Corin no Recanto do Vindicante.‡Убейте 8 тенеплетов-мутантов и вернитесь к воздаятельнице Корин в селение Привал Защитника.‡Tötet 8 mutierte Greifer und meldet Euch bei Verteidigerin Corin bei Verteidigers Ruh\'.‡돌연변이 올가미 덩굴손 8마리를 처치한 후 구원자의 안식처에 있는 구원자 코린에게 보고해야 합니다.‡Mata 8 enmarañadores mutantes e informa al vindicador Corin en El Reposo del Vindicador.‡Mata a 8 enmarañadores mutantes e informa a la vindicadora Corin en El Reposo del Vindicador.‡Tuez 8 Noueurs mutés et faites votre rapport au redresseur de torts Corin au Repos du redresseur de torts.‡杀掉8只变异的纠结者，然后向守备官营地的守备官考尔琳复命。‡殺掉8個突變的糾纏者後向復仇者之陵的復仇者科林回報。',
  }
},
[10067] = {
  {
    'Espíritos da água corrompidos‡Смрадные водные духи‡Besudelte Wassergeister‡타락한 물의 정령‡Espíritus de agua contaminados‡Espíritus del agua contaminados‡Les élémentaires d\'eau souillée‡污秽的水之魂‡污濁的水精靈',
    nil,
    'Mate 6 Espíritos da Água Corrompidos e fale com a Vindicante Corin no Recanto do Vindicante.‡Убейте 6 смрадных водных духов и вернитесь к воздаятельнице Корин в селение Привал Защитника.‡Tötet 6 besudelte Wassergeister und kehrt zu Verteidigerin Corin bei Verteidigers Ruh\' zurück.‡타락한 물의 정령 6마리를 처치한 후 구원자의 안식처에 있는 구원자 코린에게 돌아가야 합니다.‡Mata 6 espíritus de agua contaminados corruptos y ve a ver al vindicador Corin a El Reposo del Vindicador.‡Mata a 6 espíritus del agua contaminados corruptos y ve a ver la vindicadora Corin a El Reposo del Vindicador.‡Tuez 6 Élémentaires d\'eau souillés et retournez voir le redresseur de torts Corin au Repos du redresseur de torts.‡除掉6个污秽的水之魂，然后向守备官营地的守备官考尔琳复命。‡殺掉6個污濁的水之靈後回到復仇者之陵找復仇者科林。',
  }
},
[10068] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡Nova de givre‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Atteignez le Niveau 3 pour apprendre la Nova de givre, puis cherchez un Mannequin d’entraînement près de la Flèche solaire et utilisez ce nouveau sort 2 fois.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10069] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡Le veilleur du puits Solanian‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Parlez au veilleur du puits Solanian à la Flèche solaire sur l\'île de Haut-soleil.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10070] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡Le tir assuré‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Atteignez le Niveau 3 pour apprendre le Tir assuré, puis trouvez un Mannequin d’entraînement près de la Flèche solaire et utilisez le Tir assuré contre lui à cinq reprises.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10071] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡L\'éviscération‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Atteignez le Niveau 3 pour apprendre l’Éviscération, puis trouvez un Mannequin d’entraînement près de la Flèche Solaire et utilisez l’Éviscération sur lui à trois reprises.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10072] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡Apprendre le mot‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Atteignez le niveau 3 pour apprendre Mot de l’ombre : Douleur. Utilisez-le 5 fois sur un Mannequin d’entraînement à côté.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10073] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Corrupción‡Corruption‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Aprende Corrupción en el nivel 3. Busca un muñeco de entrenamiento en el exterior de Aguja del Sol y practica Corrupción 5 veces.‡Atteignez le niveau 3 pour apprendre Corruption. Trouvez un Mannequin d’entraînement devant la Flèche solaire et utilisez 5 fois Corruption.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10074] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    'A Pesquisadora-chefe Amereldine, de Halaa, quer que você recolha 10 Amostras de Cristal em Pó de Oshu\'gun.‡Принесите старшей исследовательнице Амерельдине в Халаа 20 порций порошка кристалла Ошу\'гуна.‡Bringt 20 Kristallpulverproben von Oshu\'gun zu Forschungsleiterin Amereldine in Halaa.‡할라아에 있는 수석 연구원 아미를다인이 오슈군 결정 가루 견본 20개를 가져오라고 부탁했습니다.‡El jefe de investigación Amereldine de Halaa quiere 20 muestras de polvo de cristal de Oshu\'gun.‡‡La directrice de recherche Amereldine de Halaa veut 20 Échantillons de poudre de cristal d\'Oshu\'gun.‡将20份沃舒古水晶尘样本交给哈兰的主研究员阿米蒂恩。‡哈剌的首席調查員阿莫瑞丹需要20個歐夏剛水晶粉末樣本。',
  }
},
[10075] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    'Esta base foi a primeira instalação draeneica construída para estudar os cristais naarus.nnNossas descobertas representam uma verdadeira mina de ouro em dados de pesquisa sobre os cristais de Oshu\'gun, a "montanha-diamante". Parece que tudo nesta região contém pó residual dos cristais de Oshu\'gun. Caso você encontre pó de cristal durante suas andanças, traga tudo para mim. Eu o recompensarei com um selo que poderá ser trocado por mercadorias do intendente.‡Раньше здесь располагался исследовательский центр дренеев. Они изучали кристаллы наару.nnНам удалось обнаружить бесценное сокровище: древние записи о кристаллах из "алмазной" горы Ошу\'гун. Насколько мы поняли, на территориях, прилегающих к горе, все несет на себе остаточный след порошка кристалла Ошу\'гуна. Если ты вдруг найдешь порошок, когда окажешься в тех краях, собери его и принеси мне сюда. В знак моей безграничной признательности ты получишь награду, которую сможешь обменять на многие полезные вещи.‡‡이 기지는 나루의 수정을 연구하는 드레나이의 주요 연구 시설이었습니다.nn이곳에서 \'다이아몬드\' 산인 오슈군의 결정에 대한 귀중한 연구 기록을 발견했습니다. 이 지역의 모든 생명체가 오슈군 결정 가루를 몸에 묻히고 다니는 것 같아요. 이곳을 여행하는 동안 가루를 발견하면 제게 가져다주십시오. 감사의 표시로 병참장교에게 물건을 구입할 때 사용할 수 있는 주화를 드리겠습니다.‡‡‡Cette base était le principal centre de recherche où les draeneï étudiaient les cristaux naaru.nnNous avons découvert une véritable mine d’or sous la forme de notes consacrées aux cristaux de la « montagne de diamant », Oshu’gun. On dirait que tout, dans la région, contient une parcelle de pouvoir des cristaux d’Oshu’gun. Si vous trouvez de la poudre lorsque vous sillonnerez la région, remettez-la-moi. En échange, je vous donnerai un petit quelque chose qui vous permettra de faire des achats auprès de notre service d’intendance.‡‡',
  }
},
[10076] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    'O pesquisador-chefe Kartos, de Halaa, precisa de 10 amostras de cristal em pó de Oshu\'gun.‡Принесите 20 порций порошка кристалла Ошу\'гуна старшему исследователю Картосу в Халаа.‡Bringt 20 Kristallpulverproben von Oshu\'gun zu Forschungsleiter Kartos in Halaa.‡할라아에 있는 수석 연구원 카르토스가 오슈군 결정 가루 견본 20개를 가져다 달라고 부탁했습니다.‡El jefe de investigación Kartos de Halaa quiere 20 muestras de polvo de cristal de Oshu\'gun.‡‡Le directeur de recherche Kartos de Halaa veut 20 Échantillons de poudre de cristal d\'Oshu\'gun.‡收集20份沃舒古水晶尘样本，然后向哈兰的主研究员卡托斯复命。‡哈剌的首席調查員阿莫瑞丹需要20個歐夏剛水晶粉末樣本。',
  }
},
[10077] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘样本‡歐夏剛水晶粉末',
    nil,
    'Esta base foi a primeira instalação draeneica construída para estudar os cristais naarus.nnNossas descobertas representam uma verdadeira mina de ouro em dados de pesquisa sobre de os cristais de Oshu\'gun, a "montanha-diamante". Parece que tudo nesta reg‡Раньше здесь располагался исследовательский центр дренеев. Они изучали кристаллы наару.nnНам удалось обнаружить бесценное сокровище: древние записи о кристаллах из "алмазной" горы Ошу\'гун. Насколько мы поняли, на территориях, прилегающих к горе, все несет на себе остаточный след порошка кристалла Ошу\'гуна. Если ты вдруг найдешь порошок, когда окажешься в тех краях, собери его и принеси мне сюда. В знак моей безграничной признательности ты получишь награду, которую сможешь обменять на многие полезные вещи.‡Dieser Stützpunkt war die erste Forschungseinrichtung für die Untersuchung von Naarukristallen.nnWir haben hier eine wahre Goldgrube an Forschungsunterlagen über die Kristalle des "diamantenen" Bergs, Oshu\'gun, gefunden. Wie es scheint, ist überall in diesem Gebiet etwas von der übrig gebliebenen Macht der Kristalle von Oshu\'gun enthalten. Wenn Ihr während Euren Abenteuern in diesem Gebiet Kristallpulver finden solltet, bringt es zu mir, und ich werde Euch ein Zeichen meiner Wertschätzung geben, dass Ihr bei den Rüstmeistern eintauschen könnt.‡This base was the primary draenei research facility for the study of naaru crystals.nnWhat we have discovered is a veritable goldmine of research notes about the crystals from the "diamond" mountain, Oshu\'gun. It would seem that everything in this region carries with it some residual powder of the Oshu\'gun crystals. If you find any powder while adventuring in this region, return it to me and I shall reward you with a token of my appreciation which you may use to make purchases from the quartermaster.‡Esta base era el centro de investigación principal de los draenei para estudiar los cristales naaru.nnHemos descubierto un auténtico tesoro de notas acerca de los cristales de Oshu\'gun, conocida como la montaña de "diamante". Parece que en esta zona todo está impregnado de polvo residual de los cristales Oshu\'gun. Si encuentras muestras de polvo, tráemelas y te daré una recompensa con la que podrás ir a comprar suministros al intendente.‡‡Cette base était le principal centre de recherche où les <race> étudiaient les cristaux naaru.nnNous avons découvert une véritable mine d’or sous la forme de notes consacrées aux cristaux de la « montagne de diamant », Oshu’gun. On dirait que tout, dans la région, contient une parcelle de pouvoir des cristaux d’Oshu’gun. Si vous trouvez de la poudre lorsque vous sillonnerez la région, remettez-la-moi. En échange, je vous donnerai un petit quelque chose qui vous permettra de faire des achats auprès de notre service d’intendance.‡‡',
  }
},
[10078] = {
  {
    'Sabendo sabotar, não vão nos atacar‡Сжечь старье!‡Die Unerwünschten zerstören‡톱날 투척기 파괴‡Machacando al enemigo‡Machacando al enemigo‡Anéantir les indésirables‡烧毁掷刀车‡將剩餘的變不需要的',
    nil,
    'Use a Tocha Flamejante para incendiar as Arremessadoras de Lâminas da Horda ao longo do Caminho da Glória. Então traga a Tocha Flamejante de volta para Rumberto na Fortaleza da Honra.‡Используйте горящий факел и подожгите клинкометы Орды, стерегущие Путь Славы. После выполнения задания верните факел Болтую в Оплот Чести.‡Zündet die Klingenwerfer der Horde mit der flammenden Fackel am Pfad des Ruhms an. Kehrt dann mit der flammenden Fackel zu Dumphry in der Ehrenfeste zurück.‡영광의 길이 내려다보이는 곳에 있는 호드 톱날 투척기를 불타오르는 횃불을 사용하여 태운 후, 명예의 요새에 있는 덤프리에게 횃불을 가져가야 합니다.‡Utiliza la antorcha flameante para quemar los lanzacuchillos de la Horda que dan a El Camino a la Gloria. A continuación, lleva la antorcha flameante a Dumphry en el Bastión del Honor.‡Utiliza la antorcha llameante para quemar los lanzacuchillos de la Horda que dan a El Camino a la Gloria. A continuación, lleva la antorcha llameante a Dumphry en el Bastión del Honor.‡Utilisez la Torche enflammée pour brûler les Lance-lames de la Horde surplombant le sentier de la Gloire. Puis apportez la Torche enflammée à Dumphry au bastion de l\'Honneur.‡使用燃烧的火把烧毁分布在荣耀之路周围的部落掷刀车，然后将燃烧的火把交给荣耀堡的达姆菲。‡使用燃燒的火炬燒死光榮之路上監視的部落刀刃發射器。然後，將燃燒的火炬帶給榮譽堡的戴夫利。',
  }
},
[10079] = {
  {
    'Balança mas não cai‡Весь рудник ходуном‡Bringt diese Mine zum Beben!‡광산의 소동‡Una mina por una cerveza‡Esta mina es un caos‡Mineur, tu dors, ton wagon va trop vite‡乱糟糟的矿洞‡礦場的騷動',
    nil,
    'Mate 12 Sapadores Gan\'arg e fale novamente com o Encarregado Grandepar.‡Убейте 12 ган\'аргов-саперов и вернитесь к штейгеру Большие Десны.‡Tötet 12 Pioniere der Gan\'arg und kehrt dann zu Großknecht Biggums zurück.‡간아그 공병 12명을 처치한 후 현장감독 비굼스에게 돌아가야 합니다.‡Mata 12 zapadores Gan\'arg y vuelve a ver al supervisor Biggums.‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Biggums.‡Tuez 12 Sapeurs gan\'arg puis retournez voir le contremaître Biggums.‡杀死12个甘尔葛工兵，然后向工头比格姆斯复命。‡殺掉12個甘納格工人後回去找工頭比干莫斯。',
  }
},
[10081] = {
  {
    'Para encontrar a Mãe Kashur‡Встреча с Матерью Кашур‡Mutter Kashur treffen‡대모 카슈르와 만남‡Conocer a la Madre Kashur‡Conocer a la Madre Kashur‡Rencontrer Mère Kashur‡拜访卡舒尔宗母‡與卡修爾母親會面',
    nil,
    'A Grande Mãe Geyah quer que você converse com a Mãe Kashur.‡Поговорите с Матерью Кашур.‡Großmutter Geyah möchte, dass Ihr mit Mutter Kashur sprecht.‡대모 게야가 대모 카슈르와 대화해 달라고 했습니다.‡La Abuela Geyah quiere que hables con la Madre Kashur.‡La Abuela Geyah quiere que hables con la Madre Kashur.‡La Grande-mère Geyah veut que vous parliez avec Mère Kashur.‡盖亚安祖母要你去跟卡舒尔宗母谈一谈。‡祖母吉雅要你與卡修爾母親談談。',
  }
},
[10082] = {
  {
    'Ancestrais inquietos‡Покой предков‡Die aufgebrachten Ahnen‡불안한 영혼‡Los ancestros agitados‡Los ancestros agitados‡Les ancêtres agités‡激动的灵魂‡焦慮的先祖們',
    nil,
    'A Mãe Kashur quer que você dê fim a 8 espíritos orcs agitados.‡Уничтожьте 15 потревоженных духов орков.‡Mutter Kashur möchte, dass Ihr 15 aufgebrachte Orcgeister tötet.‡대모 카슈르가 근심어린 오크 영혼 8명에게 안식을 찾아 달라고 했습니다.‡La Madre Kashur te ha pedido que acabes con 8 espíritus de orcos perturbados.|n‡‡Mère Kashur vous a demandé de donner le repos à 8 Esprits orcs agités.‡卡舒尔宗母要求你让15个激动的兽人灵魂再次安息。‡卡修爾母親要你殺掉15個激動的獸人靈魂。',
  }
},
[10084] = {
  {
    'Assault on Mageddon‡Атака на Магеддон‡Angriff auf Mageddon‡‡Asalto a Mageddon‡‡L\'attaque de Mageddon‡‡',
    nil,
    'Kill Nightlord Malphas at Forge Base: Mageddon, and report to Force Commander Danath Trollbane at Honor Hold.‡Убейте Владыку ночи Малфаса, находящегося на Кузнечной Базе: Магеддон. О выполнении задания доложите командиру армии Данату Троллебою из Оплота Чести.‡Tötet Nachtlord Malphas im Konstruktionslager: Mageddon und meldet Euch dann bei Truppenkommandant Danath Trollbann in der Ehrenfeste.‡‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon e informa al comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon e informa al comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Tuez le Seigneur de la nuit Malphas à la Base de forge Mageddon, et retournez auprès du Commandant Danath Trollemort au Bastion de l\'Honneur.‡‡',
  }
},
[10085] = {
  {
    'Visita aos antepassados‡Навестить предков‡Ein Besuch bei den Ahnen‡선조 방문‡Una visita a los ancestros‡Una visita a los ancestros‡Une visite aux ancêtres‡拜访先祖之魂‡拜訪先祖們',
    nil,
    'A Mãe Kashur, das Terras Ancestrais, em Nagrand, quer que você vá até o Posto Solavera, as Ruínas Gargaveira, a Garadar e as Ruínas dos Olhos Sangrentos.‡Мать Кашур хочет, чтобы вы посетили заставу Солнечного Источника, руины Веселого Черепа, Гарадар и руины Кровавой Глазницы.‡Mutter Kashur im Ahnengrund in Nagrand möchte, dass Ihr den Sonnenwindposten, die Ruinen des Lachenden Schädels, Garadar und die Ruinen des Blutenden Auges besucht.‡나그란드의 선조의 터에 있는 대모 카슈르가 태양여울 주둔지, 웃는 해골 폐허, 가라다르, 피눈물 폐허를 방문하라고 했습니다.‡La Madre Kashur en las Tierras Ancestrales, en Nagrand, te ha pedido que visites el Puesto Primasol, las Ruinas Riecráneos, Garadar y las Ruinas Foso Sangrante.‡La Madre Kashur en las Tierras Ancestrales, en Nagrand, te ha pedido que visites el Puesto Primasol, las Ruinas Riecráneos, Garadar y las Ruinas Foso Sangrante.‡Mère Kashur des Terres ancestrales en Nagrand vous a demandé de visiter le Poste de Berceau-de-l’Été, les Ruines du Crâne-Ricanant, Garadar et les Ruines de l\'Orbite-Sanglante.‡纳格兰先祖之地的卡舒尔宗母要你去拜访日泉岗哨、嘲颅废墟、加拉达尔和血环废墟。‡納葛蘭上先祖之地的卡修爾母親要你去拜訪日春崗哨，獰笑骷髏廢墟，卡拉達爾以及血之谷廢墟。',
  }
},
[10086] = {
  {
    'Eu trabalho... pela Horda!‡Я служу... Орде!‡Ich arbeite... für die Horde!‡호드를 위해 일한다!‡Trabajo... ¡para la Horda!‡Trabajo... ¡para la Horda!‡Je travaille... Pour la Horde !‡我为部落工作！‡我替……部落工作!',
    nil,
    'Leve 8 pedaços de Metal Recuperado e 8 pedaços de Madeira Recuperada para Megzeg Rebbentappunho, em Thrallmar.‡Принесите 8 кусков металлолома и 8 кусков древесины Мегзегу Крутогруду в Траллмар.‡Bringt 8 Stück gebrauchtes Metall und 8 Stück gebrauchtes Holz zu Megzeg Knaxknöchel in Thrallmar.‡스랄마에 있는 메그제그 너클버스트에게 재활용 목재와 재활용 금속을 8개씩 가져가야 합니다.‡Llévale 8 piezas de metal rescatado y 8 piezas de madera rescatada a Megzeg Quetemeto, en Thrallmar.‡Llévale 8 piezas de metal rescatado y 8 piezas de madera rescatada a Megzeg Quetemeto, en Thrallmar.‡Apportez 8 morceaux de Métal récupéré et 8 morceaux de Bois récupéré à Megzeg Phalanjette à Thrallmar.‡给萨尔玛的泽格·纳克布斯带去8块回收的金属和8块回收的木材。‡將8片可利用的金屬及8塊可利用的木頭交給索爾瑪的奴克巴斯。',
  }
},
[10087] = {
  {
    'Acende aí... pela Horda!‡Сжечь! Во имя Орды!‡Zündet es an... für die Horde!‡불태우리... 호드를 위하여!‡Quémalo... ¡por la Horda!‡Quémalo... ¡por la Horda!‡Brûlez-les... Pour la Horde !‡为了部落，烧！‡為了部落……燒了它!',
    nil,
    'Use a Tocha Flamejante para incendiar o Canhão Oriental da Aliança e o Canhão Ocidental da Aliança, e então fale novamente com Megzeg Rebbentappunho, em Thrallmar.‡Используя горящий факел, подожгите восточную пушку Альянса и западную пушку Альянса. После выполнения задания возвращайтесь к Мегзегу Крутогруду в Траллмар.‡Zündet die östliche und die westliche Kanone der Allianz mit der flammenden Fackel an und kehrt danach zu Megzeg Knaxknöchel in Thrallmar zurück.‡불타오르는 횃불을 사용하여 동쪽 얼라이언스 대포와 서쪽 얼라이언스 대포를 태운 다음 스랄마에 있는 메그제그 너클버스트에게 가야 합니다.‡Usa la antorcha flameante para quemar los cañones de la Alianza del este y el oeste, y vuelve a ver a Megzeg Quetemeto en Thrallmar.‡Usa la antorcha llameante para quemar los cañones de la Alianza del este y el oeste, y vuelve a ver a Megzeg Quetemeto en Thrallmar.‡Utilisez la Torche enflammée pour brûler le Canon est de l\'Alliance et le Canon ouest de l\'Alliance, puis revenez voir Megzeg Phalanjette à Thrallmar.‡利用燃烧的火把烧毁东部联盟火炮和西部联盟火炮，然后返回萨尔玛向泽格·纳克布斯复命。‡使用燃燒的火炬燒毀東邊的聯盟火砲還有西邊的聯盟火砲，然後回報索爾瑪的米希克·奴克巴斯。',
  }
},
[10088] = {
  {
    'When This Mine\'s a-Rockin\'‡Весь рудник ходуном‡Bringt diese Mine zum Beben!‡‡Esta mina es un caos‡‡Mineur, tu dors, ton wagon va trop vite‡‡',
    nil,
    'Kill 12 Gan\'arg Sappers and return to Foreman Razelcraz.‡Убейте 12 ган\'аргов-саперов и возвращайтесь к Штейгер Разлкразу.‡Tötet 12 Pioniere der Gan\'arg und kehrt dann zu Großknecht Razelcraz zurück.‡‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Razelcraz.‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Razelcraz.‡Tuez 12 Sapeurs gan\'arg et retournez voir le contremaître Razelcraz.‡‡',
  }
},
[10089] = {
  {
    'Forge Camps of the Legion‡Лагеря Легиона‡Konstruktionslager der Legion‡‡Campamentos Forja de la Legión‡‡Camps de forge de la Légion‡‡',
    nil,
    'Kill 10 Gan\'arg Servants, 5 Forge Camp Legionnaires, and 5 Sisters of Grief, then search Forge Camp: Rage for evidence of the Legion\'s intentions.‡Убейте 10 ган\'аргов-прислужников, 5 легионеров лагеря Легиона и 5 сестер Скорби, затем обыщите лагерь Легиона: Ярость, чтобы узнать намерения Легиона.‡Tötet 10 Diener der Gan\'arg, 5 Legionäre des Konstruktionslagers und 5 Schwestern des Leids. Durchsucht danach des Konstruktionslager: Zorn nach einem Hinweis auf die Absichten der Legion.‡‡Mata a 10 sirvientes Gan\'arg, a 5 legionarios del Campamento Forja y a 5 hermanas de dolor. A continuación busca en el Campamento Forja: Ira pruebas de los planes de la Legión.‡Mata a 10 sirvientes Gan\'arg, a 5 legionarios del Campamento Forja y a 5 hermanas de dolor. A continuación busca en el Campamento Forja: Ira pruebas de los planes de la Legión.‡Tuez 10 Serviteurs gan\'arg, 5 Légionnaires du camp de forge et 5 Sœurs de la peine, puis fouillez le camp de forge Rage à la recherche d\'indices concernant les intentions de la Légion.‡‡',
  }
},
[10090] = {
  {
    'The Legion\'s Plans‡Планы Легиона‡Die Pläne der Legion‡‡Los planes de la Legión‡‡Les plans de la Légion‡‡',
    nil,
    'Retrieve the Forge Camp: Spite Plans and return them to Overlord Hun Maimfist at Reaver\'s Fall.‡Разыщите Лагерь Легиона: Планы Злобы и возвращайтесь к властителю Хану Изуверу в Погибель Сквернобота.‡Besorgt die Pläne des Konstruktionslagers: Bosheit und bringt sie zu Oberanführer Hun Stümmelfaust im Häschersturz.‡‡Recupera los planes del Campamento Forja: Maldad y llévaselos al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Recupera los planes del Campamento Forja: Maldad y llévaselos al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Récupérez les Plans du camp de forge Dépit et apportez-les au suzerain Hun Mutilepoing au Trépas du saccageur.‡‡',
  }
},
[10091] = {
  {
    'Os engenhos das almas‡Инструменты души‡Seeleninstrumente‡영혼의 장치‡Los dispositivos de almas‡Los dispositivos de almas‡Les machines à âmes‡灵魂装置‡靈魂儀器',
    nil,
    'Roube 5 engenhos das almas e entregue-os à Espiã-chefe Melisa Coroalta no Terraço da Luz em Shattrath.‡Украдите 5 инструментов души и доставьте их повелительнице шпионов Мелисе Высокий Венец в Шаттрат на Террасу Света.‡Stehlt 5 Seeleninstrumente und bringt sie zu Spionagemeisterin Mehlisah Hochkrone auf der Terrasse des Lichts in Shattrath.‡영혼의 장치 5개를 훔쳐서 샤트라스의 빛의 정원에 있는 첩보단장 멜리사 하이크라운에게 가져가야 합니다.‡Roba 5 dispositivos de alma y entrégaselos a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath.‡Roba 5 dispositivos de alma y entrégaselos a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath.‡Volez 5 Machines à âmes puis apportez-les à la maître-espionne Mehlisah Hautecouronne sur la terrasse de la Lumière à Shattrath.‡偷取5个灵魂装置，将它们交给沙塔斯城圣光广场的间谍女王梅丽萨·海克隆。‡偷取5個靈魂儀器並把它們運送給撒塔斯城裡露臺的間諜首領麥莉莎·陽冠。',
  }
},
[10092] = {
  {
    'Assault on Mageddon‡Атака на Магеддон‡Angriff auf Mageddon‡‡Asalto a Mageddon‡‡L\'attaque de Mageddon‡‡',
    nil,
    'Kill Nightlord Malphas at Forge Base: Mageddon, and return to Overlord Hun Maimfist at Reaver\'s Fall.‡Убейте Владыку Ночи Малфаса, который находится на Кузнечной базе: Магеддон и возвращайтесь к властителю Хану Изуверу в Погибель Сквернобота.‡Tötet Nachtlord Malphas im Konstruktionslager: Mageddon und meldet Euch dann bei Oberanführer Hun Stümmelfaust im Häschersturz.‡‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon y ve a ver al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon y ve a ver al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Tuez le Seigneur de la nuit Malphas à la Base de forge Mageddon, et retournez auprès du Suzerain Hun Mutilepoing au Trépas du saccageur.‡‡',
  }
},
[10093] = {
  {
    'O Templo de Telhamat‡Храм Телхамат‡Der Tempel von Telhamat‡텔하마트 사원‡El Templo de Telhamat‡El Templo de Telhamat‡Le temple de Telhamat‡塔哈玛特神殿‡特爾哈曼神廟',
    nil,
    'Fale com Amaan, o Sábio, no Templo de Telhamat, na parte ocidental da Península Fogo do Inferno.‡Поговорите с Амааном Мудрым в храме Телхамат, который находится на западе полуострова Адского Пламени.‡Sprecht mit Amaan dem Weisen beim Tempel von Telhamat im Westen der Höllenfeuerhalbinsel.‡지옥불 반도 서부의 텔하마트 사원에 있는 현자 아만과 대화해야 합니다.‡Habla con Amaan el Sabio en el Templo de Telhamat al oeste de la Península del Fuego Infernal.‡Habla con Amaan el Sabio en el Templo de Telhamat al oeste de la Península del Fuego Infernal.‡Parlez à Amaan le Sage au Temple de Telhamat dans l\'ouest de la Péninsule des Flammes infernales.‡前往地狱火半岛西部的塔哈玛特神殿，与智者阿曼恩谈一谈。‡與地獄火半島西邊特爾哈曼神廟的『智者』阿曼談談。',
  }
},
[10094] = {
  {
    'O Códice de Sangue‡Кодекс Крови‡Der Kodex des Blutes‡피의 고서‡El Códice de Sangre‡El Códice de Sangre‡Le codex de sang‡鲜血法典‡血之聖典',
    nil,
    'Leia o Códice de Sangue no Labirinto Soturno de Auchindoun.‡Прочитайте Кодекс Крови в Темном лабиринте в Аукиндоне.‡Lest den Kodex des Blutes im Schattenlabyrinth von Auchindoun.‡아킨둔의 어둠의 미궁에서 피의 고서를 읽어야 합니다.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lisez le Codex de sang dans le Labyrinthe des ombres d\'Auchindoun.‡阅读奥金顿暗影迷宫中的鲜血法典。‡閱讀奧齊頓的暗影迷宮裡的血之聖典。',
  }
},
[10095] = {
  {
    'Rumo ao coração do labirinto‡В самом сердце Лабиринта‡In das Herz des Labyrinths‡미궁의 심장부로‡En el corazón del laberinto‡En el corazón del laberinto‡Au cœur du labyrinthe‡深入迷宫‡進入迷宮的中心',
    nil,
    'Destrua Murmúrio e informe a Espiã-chefe Melisa Coroalta no Terraço da Luz em Shattrath sobre os eventos que transcorreram no Labirinto Soturno.‡Уничтожьте Бормотуна и доложите о том, что произошло внутри Темного лабиринта, повелительнице шпионов Мелисе Высокий Венец, которую можно найти на террасе Света в Шаттрате.‡Vernichtet Murmur und informiert danach Spionagemeisterin Mehlisah Hochkrone auf der Terrasse des Lichts in Shattrath über die Geschehnisse im Schattenlabyrinth.‡울림을 없앤 후 샤트라스, 빛의 정원에 있는 첩보단장 멜리사 하이크라운에게 어둠의 미궁 안에서 벌어지고 있는 사건에 대해 보고하십시오.‡Destruye a Murmur e informa a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath sobre los sucesos ocurridos en el Laberinto de las Sombras.‡Destruye a Murmullo e informa a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath sobre los sucesos ocurridos en el Laberinto de las Sombras.‡Détruisez Marmon, puis allez à la terrasse de la Lumière à Shattrath pour faire un rapport de ce qui s\'est passé dans le Labyrinthe des ombres à la maître-espionne Mehlisah Hautecouronne.‡杀死摩摩尔，然后返回沙塔斯城的圣光广场，将暗影迷宫的秘密告诉间谍女王梅丽萨·海克隆。‡殺掉莫爾墨後回到撒塔斯城的聖光露臺並且向間諜首領麥莉莎·陽冠回報暗影迷宮裡頭發生的事件。',
  }
},
[10096] = {
  {
    'Salvar os esporlotes‡Спасение спорлоков‡Rettung der Sporloks‡스포어로크 구출‡Salvemos a los esporotes‡Salvemos a los esporotes‡Sauver les Sporeloks‡拯救孢子人‡拯救斯柏路克',
    nil,
    'Mate 10 Dragadores do Pântano, 10 Tocaieiros do Pântano e fale novamente com Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Убейте 10 болотных черпальщиков и 10 болотных скрытней и вернитесь к Лоранне Тар\'велл в Кенарийский приют в Зангартопи.‡Tötet 10 Marschengräber und 10 Marschenlauerer und kehrt dann zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡갈퀴손 습지늪괴물, 수렁늪괴물을 각각 10마리씩 처치한 후 장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 돌아가야 합니다.‡Mata 10 dragadores de marisma y 10 rondadores de marisma y ve a ver a Lauranna Thar\'well al Refugio Cenarion en la Marisma de Zangar.‡Mata 10 dragadores de marisma y 10 rondadores de marisma y ve a ver a Lauranna Thar\'well al Refugio Cenarion en la Marisma de Zangar.‡Tuez 10 Drague-marais et 10 Rôdeurs des marais, puis retournez voir Lauranna Thar\'well au Refuge cénarien dans le marécage de Zangar.‡杀死10个沼泽掘泥者和10个沼泽潜伏者，然后向塞纳里奥庇护所的劳兰娜·萨维尔复命。‡殺掉10隻沼澤挖掘者及10隻沼澤潛伏者，完成後回到贊格沼澤找塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[10097] = {
  {
    'Irmão contra irmão‡Брат на брата‡Bruder gegen Bruder‡형제 간의 싸움‡Hermano contra hermano‡Hermano contra hermano‡Frère contre frère‡兄弟反目‡兄弟鬩牆',
    nil,
    'Mate o Tecetrevas Syth nos Salões dos Sethekk e liberte Lakka do cativeiro. Fale novamente com Isfar do lado de fora dos Salões dos Sethekk quando concluir o resgate.‡Проникните в Сетеккские залы и убейте Темнопрядя Сита. Освободите из плена Лакку. После этого вернитесь к Исфару, который находится неподалеку от входа в Залы Сетека.‡Tötet Dunkelwirker Syth in den Sethekkhallen und befreit Lakka. Kehrt zu Isfar außerhalb der Sethekkhallen zurück, wenn Ihr die Aufgabe abgeschlossen habt.‡세데크 전당 밖에 있는 이스파르가 세데크 전당에 있는 흑마술사 시스를 처치하고 붙잡혀 있는 라카를 구해달라고 부탁했습니다.‡Mata a Tejeoscuro Syth en las Salas Sethekk y libera a Lakka. Habla con Isfar fuera de las Salas Sethekk cuando hayas terminado la misión de rescate.‡Mata a Tejeoscuro Syth en las Salas Sethekk y libera a Lakka. Habla con Isfar fuera de las Salas Sethekk cuando hayas terminado la misión de rescate.‡Tuez le tisseur d\'ombre Syth dans les salles des Sethekk, puis libérez Lakka. Retournez voir Isfar à l\'extérieur des salles des Sethekk lorsque vous aurez réussi à la sauver.‡进入塞泰克大厅，杀死黑暗编织者塞斯，然后解救被囚禁的拉卡。完成任务后向塞泰克大厅外的伊斯法尔复命。‡殺掉塞司克大廳的暗法師希斯，之後釋放拉卡自由。完成拯救後回到塞司克大廳外找伊斯法。',
  }
},
[10098] = {
  {
    'O legado de Terokk‡Наследство Терокка‡Terokks Erbe‡테로크의 유산‡El legado de Terokk‡El legado de Terokk‡L\'héritage de Terokk‡泰罗克的传说‡泰洛克的遺產',
    nil,
    'Leve a Máscara, a Pena e a Saga de Terokk a Isfar do lado de fora dos Salões dos Sethekk.‡Принесите Маску Терокка, Перо Терокка и Сагу о Терокке Исфару, который находится неподалеку от Сетеккских залов.‡Bringt Terokks Maske, Terokks Federkiel und die Sage von Terokk zu Isfar außerhalb der Sethekkhallen.‡세데크 전당 밖에 있는 이스파르에게 테로크의 가면, 테로크의 깃창, 테로크의 전설이라는 책을 가져가야 합니다.‡Lleva la máscara y la pluma de Terokk, además de la Saga de Terokk a Isfar a las puertas de las Salas Sethekk.‡Lleva la máscara y la punta de Terokk, además de la saga de Terokk a Isfar a las puertas de las Salas Sethekk.‡Apportez le Masque de Terokk, la Rémige de Terokk et la Saga de Terokk à Isfar à l\'extérieur des salles des Sethekk.‡将泰罗克的面具、泰罗克的羽毛和泰罗克的传说交给塞泰克大厅外的伊斯法尔。‡將泰洛克面罩，泰洛克羽毛，及泰洛克的傳說交給塞司克大廳外的伊斯法。',
  }
},
[10099] = {
  {
    'O mandante‡Мозговой центр‡Das Genie‡배후의 지휘관‡El cerebro oculto‡El cerebro oculto‡Le cerveau‡主谋‡幕後的黑手',
    nil,
    'Localize e mate Z\'kral nas minas embaixo da Fortaleza da Honra, e então apresente-se ao Encarregado Grandepar.‡Найдите и убейте З\'крала в рудниках под Оплотом Чести, и доложите об этом штейгеру Большие Десны.‡Sucht und tötet Z\'kral in den Minen unter der Ehrenfeste und meldet Euch dann bei Großknecht Biggums zurück.‡명예의 요새 지하의 광산에 있는 즈크랄을 찾아서 처치한 후 현장감독 비굼스에게 보고해야 합니다.‡Encuentra y mata a Z\'kral en las minas que hay debajo de Bastión del Honor y ve a informar al supervisor Biggums.‡Encuentra y mata a Z\'kral en las minas que hay debajo de Bastión del Honor y ve a informar al supervisor Biggums.‡Trouvez et tuez Z\'kral dans les mines sous le bastion de l\'Honneur, puis faites votre rapport au contremaître Biggums.‡进入荣耀堡的地下矿洞，找到并杀死兹克拉，然后向工头比格姆斯复命。‡找出及殺掉榮譽堡底下礦坑裡的希卡洛，完成後回報給工頭比干莫斯。',
  }
},
[10100] = {
  {
    'The Mastermind‡Мозговой центр‡Das Genie‡‡El cerebro oculto‡‡Le cerveau‡‡',
    nil,
    'Locate and kill Urga\'zz within the mines beneath Thrallmar, then return to Foreman Razelcraz.‡Найдите и убейте Урга\'зза в рудниках под Траллмаром, и доложите об этом штейгеру Разлкразу.‡Sucht und tötet Urga\'zz in den Minen unter Thrallmar und kehrt dann zu Großknecht Razelcraz zurück.‡‡Encuentra y mata a Urga\'zz en las minas que hay debajo de Thrallmar y ve a informar al supervisor Razelcraz.‡Encuentra y mata a Urga\'zz en las minas que hay debajo de Thrallmar y ve a informar al supervisor Razelcraz.‡Trouvez et tuez Urga\'zz dans les mines sous Thrallmar, puis faites votre rapport au contremaître Razelcraz.‡‡',
  }
},
[10101] = {
  {
    'Quando os espíritos falam‡Когда говорят духи‡Wenn Geister sprechen‡영혼들이 말할 때‡Cuando hablan los espíritus‡Cuando hablan los espíritus‡Lorsque les esprits parlent‡灵魂之语‡當靈魂們說話時',
    nil,
    'A Mãe Kashur, das Terras Ancestrais, em Nagrand, quer que você investigue a visão que ela teve. Procure K\'ure, em Oshu\'gun.‡Разыщите К\'уре в Ошу\'гуне.‡Mutter Kashur im Ahnengrund in Nagrand bittet Euch, Eurer Vision auf den Grund zu gehen. Findet K\'ure in Oshu\'gun.‡나그란드의 선조의 터에 있는 대모 카슈르가 환영을 찾아달라고 했습니다. 오슈군에 있는 크우레를 찾아야 합니다.‡Madre Kashur, de las Tierras Ancestrales de Nagrand, te pidió que buscaras a tu visión. Busca a K\'ure en Oshu\'gun.‡Madre Kashur, de las Tierras Ancestrales de Nagrand, te pidió que buscaras a tu visión. Busca a K\'ure en Oshu\'gun.‡Mère Kashur des Terres ancestrales en Nagrand vous a demandé de partir à la recherche de la vision que vous avez eue. Trouvez K\'ure à Oshu\'gun.‡纳格兰先祖之地的卡舒尔宗母要求你前往沃舒古寻找克乌雷。‡納葛蘭的先祖之地的卡修爾母親要你去找出擁有的幻象。去找歐夏剛的庫爾。',
  }
},
[10102] = {
  {
    'Segredo revelado‡Раскрытая тайна‡Ein gelüftetes Geheimnis‡밝혀진 비밀‡Un secreto desvelado‡Un secreto desvelado‡Un secret dévoilé‡谜底揭晓‡秘密的揭露',
    nil,
    'Fale com A\'dal na cidade de Shattrath.‡Поговорите с А\'далом в Шаттрате.‡Sprecht mit A\'dal in Shattrath.‡샤트라스에 있는 아달과 대화해야 합니다.‡Habla con A\'dal en la Ciudad de Shattrath.‡Habla con A\'dal en la Ciudad de Shattrath.‡Parlez à A\'dal à Shattrath.‡与沙塔斯城的阿达尔谈一谈。‡和撒塔斯城裡的阿達歐談談。',
  }
},
[10103] = {
  {
    'Apresente-se a Zurai‡Донесение Зураю‡Bericht an Zurai‡주라이에게 보고‡A las órdenes de Zurai‡A las órdenes de Zurai‡Faire son rapport à Zurai‡向祖莱报到‡報告祖瑞伊',
    nil,
    'Apresente-se a Zurai no Mocó do Rato Lamacento, que fica no Pântano Zíngaro.‡Поговорите с Зураем на заставе Болотной Крысы в Зангартопи.‡Meldet Euch bei Zurai im Sumpfrattenposten in den Zangarmarschen.‡장가르 습지대의 늪쥐 감시초소에 있는 주라이에게 보고해야 합니다.‡Preséntate ante Zurai en Avanzada Rata del Pantano, en Marisma de Zangar.‡Preséntate ante Zurai en Avanzada Rata del Pantano, en Marisma de Zangar.‡Présentez-vous à Zurai au poste du Rat des marais dans le marécage de Zangar.‡前往赞加沼泽的沼泽鼠岗哨，向祖莱报到。‡回報贊格沼澤的伊斯溫派特崗哨裡的祖瑞伊。',
  }
},
[10104] = {
  {
    'Preocupações quanto a Tuurem‡Опасения за судьбу Туурема‡Sorgen um Tuurem‡투렘의 운명‡Preocupaciones sobre Tuurem‡Preocupaciones sobre Tuurem‡Des soucis à Tuurem‡图雷姆的事务‡與杜瑞有關',
    nil,
    'Fale com Andarl na Fortaleza Alleriana, na Mata Terokkar.‡Поговорите с Андарлом в бастионе Аллерии в Тероккаре.‡Sprecht mit Andarl in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 안다를과 대화해야 합니다.‡Habla con Andarl en el Bastión Allerian en el Bosque de Terokkar.‡Habla con Andarl en el Bastión Allerian en el Bosque de Terokkar.‡Parlez à Andarl au Bastion allérien dans la forêt de Terokkar.‡与泰罗卡森林奥蕾莉亚要塞的安达尔谈一谈。‡與泰洛卡森林裡艾蘭里堡壘的安達爾歐談談。',
  }
},
[10105] = {
  {
    'Notícias para Rakoria‡Вести для Ракории‡Nachrichten für Rakoria‡라코리아에게 전할 소식‡Noticias para Rakoria‡Noticias para Rakoria‡Des nouvelles pour Rakoria‡给拉克妮亚的消息‡給瑞克利亞的消息',
    nil,
    'Fale com Rakoria na Vila de Quebrapedra, na Mata Terokkar.‡Поговорите с Ракорией из форта Камнеломов в лесу Тероккар.‡Sprecht mit Rakoria in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 라코리아와 대화하십시오.‡Habla con Rakoria en el Bastión Rompepedras, en el Bosque de Terokkar.‡Habla con Rakoria en el Bastión Rompepedras, en el Bosque de Terokkar.‡Parlez à Rakoria, au fort des Brise-pierres dans la forêt de Terokkar.‡与泰罗卡森林裂石堡的拉克妮亚谈一谈。‡與泰洛卡森林裡碎石堡的瑞克利亞談談。',
  }
},
[10106] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 성채‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Primeiro-sargento Theresa Pardim na Península do Fogo do Inferno.‡Захватите обзорную площадку, ристалище и Изрезанный холм, и возвращайтесь к прапорщику Трейси Праудвелл в Оплот Чести на полуострове Адского Пламени.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Stabsfeldwebel Tracy Stolzbrunn in der Ehrenfeste auf der Höllenfeuerhalbinsel zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 지옥불 반도의 명예의 요새에 있는 준위 트레이시 프라우드웰에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir l\'adjudante Tracy Fièrepuits au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上荣耀堡内的委任官翠希·普罗维尔复命。‡占領望海崖，競技場和破碎之丘，完成後回到地獄火半島的榮譽堡找士官長崔西·波特威歐。',
  }
},
[10107] = {
  {
    'Medidas diplomáticas‡Дипломатическая миссия‡Diplomatische Maßnahmen‡외교적 수단‡Medidas diplomáticas‡Medidas diplomáticas‡Mesures diplomatiques‡外交手段‡外交的衡量',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você encontre e converse com Lantresor da Lâmina nas Ruínas da Lâmina Ardente.‡Джорин Мертвый Глаз из Гарадара в Награнде попросил вас поговорить с Лантрезором Клинком в руинах Пылающего Клинка.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr Lantresor von der Klinge in den Ruinen der Brennenden Klinge findet und mit ihm sprecht.‡나그란드의 가라다르에 있는 요린 데드아이가 불타는 칼날단 폐허에 있는 칼날의 란트레서를 찾아서 대화해 달라고 했습니다.‡Jorin Mortojo de Garadar en Nagrand quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Jorin Mortojo de Garadar en Nagrand quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Jorin Œil-mort de Garadar en Nagrand vous a demandé de trouver Lantresor de la Lame dans les ruines de la Lame-Ardente et de lui parler.‡加拉达尔的约林·死眼要你前往火刃废墟，找兰特瑞索·火刃谈一谈。‡納葛蘭裡卡拉達爾的喬林·亡眼要你去燃燒之劍廢墟尋找『劍刃』蘭崔索並與他談談。',
  }
},
[10108] = {
  {
    'Medidas diplomáticas‡Дипломатическая миссия‡Diplomatische Maßnahmen‡외교적 수단‡Medidas diplomáticas‡Medidas diplomáticas‡Mesures diplomatiques‡外交手段‡外交的衡量',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você converse com Lantresor da Lâmina, nas Ruínas da Lâmina Ardente.‡Мо\'мор Разрушитель из Телаара в Награнде попросил вас поговорить с Лантрезором Клинком в руинах Пылающего Клинка.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr Lantresor von der Klinge in den Ruinen der Brennenden Klinge findet und mit ihm sprecht.‡나그란드의 텔라아르에 있는 파괴자 모모르가 불타는 칼날 폐허에 있는 칼날의 란트레서를 찾아 대화해 보라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar, en Nagrand, quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Mo\'mor el Rompedor de Telaar, en Nagrand, quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Mo\'mor le Briseur, de Telaar en Nagrand, vous a demandé de trouver Lantresor de la Lame dans les ruines de la Lame-Ardente et de lui parler.‡塔拉的击碎者姆摩尔要你去跟火刃废墟的兰特瑞索·火刃谈一谈。‡納葛蘭裡泰拉的『破壞者』哞哞爾要你去燃燒之劍廢墟尋找『劍刃』蘭崔索並與他談談。',
  }
},
[10109] = {
  {
    'Eu preciso deles!‡Я их достану!‡Ich muss sie haben!‡누가 뭐래도 내꺼야!‡¡Los necesito!‡¡Los necesito!‡Il me les faut !‡我想要这些鸟蛋！‡我一定要擁有它們!',
    nil,
    'Wazat, da Vila dos Clãs, no sul de Nagrand, quer que você lhe traga 3 unidades de gás de elemental do ar.‡Принесите 3 порции пара элементалей воздуха Вазату в Южный Награнд.‡Wazdaz gegenüber der Klanwacht im Süden von Nagrand möchte, dass Ihr ihm 3 Einheiten Luftelementargas bringt.‡나그란드 남부의 부족 초소 건너편에 있는 와자트가 바람의 정령 기체 3개를 가져다 달라고 부탁했습니다.‡Wazat de Avanzada del Clan en el sur de Nagrand quiere que le lleves 3 gases de elemental de aire.‡Wazat de Avanzada del Clan en el sur de Nagrand quiere que le lleves 3 gases de elemental de aire.‡Koissa, qui se trouve en face du Guet des clans dans le sud de Nagrand, veut que vous lui apportiez 3 Gaz d\'élémentaires d\'air.‡将3份气元素实体交给纳格兰南部氏族岗哨对面的瓦萨特。‡南納葛蘭上從氏族守望來的瓦薩特要你帶給它3個空氣元素氣體。',
  }
},
[10110] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 요새‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Arauto de Batalha Olhonegro em Thrallmar.‡Захватите Обзорную площадку, Ристалище и Изрезанный холм, и возвращайтесь в Траллмар к Черноглазке Зову Войны.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Kriegsherold Blauauge in Thrallmar zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 스랄마에 있는 전투장교 블랙아이에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir le Crieur-de-guerre Coquard à Thrallmar.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上萨尔玛的传令官布莱肯·黑眼复命。‡佔領望海崖，競技場和破碎之丘，完成後回到索爾瑪找戰場咆嘯者黑眼。',
  }
},
[10111] = {
  {
    'Traga-me aquele ovo!‡Принеси мне яйцо!‡Bringt mir das Ei!‡알을 가져와!‡¡Tráeme el huevo!‡¡Tráeme el huevo!‡Rapportez-moi cet œuf !‡给我鸟蛋！‡我要蛋!',
    nil,
    'Wazat, de Nagrand, quer que você use o Pula-tron 4000 para alcançar o ninho da árvore mais próxima e roubar o Ovo Misterioso.‡С помощью Прыготрона-4000 запрыгните в гнездо на ближайшем дереве и украдите оттуда таинственное яйцо.‡Wazdaz in Nagrand möchte, das Ihr den Spring-o-Mat 4000 benutzt, um in das Nest in dem nahe gelegenen Baum zu springen und das geheimnisvolle Ei zu stehlen.‡나그란드의 와자트가 방방이 4000을 사용하여 근처 나무에 있는 둥지에 접근해서 수수께끼의 알을 훔쳐달라고 부탁했습니다.‡Wazat en Nagrand quiere que utilices el Saltatrón 4000 para llegar al nido que está en el árbol cercano y robar el huevo misterioso.‡Wazat en Nagrand quiere que utilices el Saltatrón 4000 para llegar al nido que está en el árbol cercano y robar el huevo misterioso.‡Koissa, de Nagrand, veut que vous utilisiez le Bond-o-tron 4000 pour parvenir jusqu\'au nid de l\'arbre tout proche et voler l\'Œuf mystérieux.‡纳格兰的瓦萨特要你利用超级蹦床4000型从附近树上的鸟巢中偷取神秘的鸟蛋。‡納葛蘭的瓦薩特要你用彈跳裝置4000偷取鄰近樹上的鳥巢並且取得未孵化的蛋。',
  }
},
[10112] = {
  {
    'Um favor pessoal‡Личное одолжение‡Ein persönlicher Gefallen‡사적인 부탁‡Un pequeño favor‡Un pequeño favor‡Une faveur personnelle‡私人事务‡個人的喜好',
    nil,
    'Recupere 5 Mercadorias Roubadas de Lathrai. Entregue-as para Lathrai, o Mercador do Vento. Você pode encontrá-lo perto da Taberna Fim do Mundo, localizada no Bairro Inferior, em Shattrath.‡Найдите 5 украденных товаров Латрая и верните их хозяину. Латрая можно найти возле таверны "На краю земли" в Нижнем городе Шаттрата.‡Holt 5 von Lathrais gestohlenen Waren zurück und bringt sie zu Windhändler Lathrai bei der Taverne Weltenend im unteren Viertel in Shattrath.‡도둑맞은 라스라이의 물품 5개를 찾아서 샤트라스의 고난의 거리에 있는 세상의 끝 선술집 근처의 바람의 무역상 라스라이에게 가져가야 합니다.‡Recupera 5 de los objetos robados a Lathrai. Regresa junto al comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo, en el Bajo Arrabal de la Ciudad de Shattrath.‡Recupera 5 de los objetos robados a Lathrai. Regresa junto al comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo, en el Bajo Arrabal de la Ciudad de Shattrath.‡Récupérez 5 des Marchandises volées de Lathrai. Rapportez-les au marchand des vents Lathrai près de la Taverne de la Fin du monde dans le quartier de la Ville basse de Shattrath.‡将5箱拉斯莱的货物交给沙塔斯城贫民窟天涯旅店附近的星界商人拉斯莱。‡取得5個拉斯蕊被偷的貨物。將它們送回撒塔斯城的陰鬱城，交給接近世界的盡頭小酒館的風之貿易者拉斯蕊。',
  }
},
[10113] = {
  {
    'O safári Rosarães‡Охотничий лагерь Эрнестуэя‡Nesingwarys Safari‡네싱워리 탐험대‡El Safari Nesingwary‡El Safari Nesingwary‡Le safari de Nesingwary‡奈辛瓦里狩猎队‡奈辛瓦里狩獵隊',
    nil,
    'Jonas "Escopeta" quer que você fale com Rosarães Guima no Safári Rosarães, a nordeste de Nagrand.‡Поговорите с Хемингом Эрнестуэем в охотничьем лагере Эрнестуэя на северо-восточной границе Награнда.‡"Die Flinte" Jones möchte, dass Ihr mit Hemet Nesingwary in Nesingwarys Safari am nordöstlichen Rand von Nagrand sprecht.‡"조수" 존스가 나그란드 북동부 외곽의 네싱워리 탐험대에 있는 헤멧 네싱워리와 대화해 보라고 부탁했습니다.‡Jones "Escopeta" quiere que hables con Hemet Nesingwary en el Safari Nesingwary a las afueras de Nagrand noreste.‡Jones "Escopeta" quiere que hables con Hemet Nesingwary en el Safari Nesingwary a las afueras de Nagrand noreste.‡Jones "Fusil" veut que vous parliez à Hemet Nesingwary au safari de Nesingwary, en périphérie du nord-est de Nagrand.‡"猎枪"琼斯要你前往纳格兰东北边界的奈辛瓦里狩猎队营地，找赫米特·奈辛瓦里谈一谈。‡『獵槍』瓊斯要你到納葛蘭東北方的郊區與奈辛瓦里狩獵隊的赫米特·奈辛瓦里談談。',
  }
},
[10114] = {
  {
    'O safári Rosarães‡Охотничий лагерь Эрнестуэя‡Nesingwarys Safari‡네싱워리 탐험대‡El Safari Nesingwary‡El Safari Nesingwary‡Le safari de Nesingwary‡奈辛瓦里狩猎队‡奈辛瓦里狩獵隊',
    nil,
    'Ohlorn Anda Ligeiro quer que você fale com Umbro Anda Ligeiro, o "Fio", no Safári Rosarães, em Nagrand.‡Олорм Странник просит вас поговорить со Странником Шадо "Фитцем" в охотничьем лагере Эрнестуэя в Награнде.‡Ohlorn Fernreiser möchte, dass Ihr mit Shado \'Fitz\' Fernreiser in Nesingwarys Safari in Nagrand sprecht.‡오로른 파스트라이더가 나그란드의 네싱워리 탐험대에 있는 샤도 \'피츠\' 파스트라이더와 대화해 보라고 부탁했습니다.‡Ohlorn Errante quiere que hables con Shado \'Fitz\' Errante en el Safari Nesingwary en Nagrand.‡Ohlorn Errante quiere que hables con Shado \'Fitz\' Errante en el Safari Nesingwary en Nagrand.‡Ohlorn Pérégrin veut que vous parliez à Shado "Fitz" Pérégrin au safari de Nesingwary en Nagrand.‡欧洛恩·远行者要你前往纳格兰的奈辛瓦里狩猎队营地，跟"好儿子"沙度·远行者谈一谈。‡歐洛恩·遠行者要你到納葛蘭的奈辛瓦里狩獵隊跟薩杜費茲遠行者談談。',
  }
},
[10115] = {
  {
    'A Anomalia Lamadaga‡Искажение Остротопи‡Dolchfennkrise‡비수늪일족의 일탈 행동‡La perversión Dagapantano‡La perversión Dagapantano‡La déviance des Tourbedague‡匕潭的威胁‡匕首沼地的異常',
    nil,
    'Mate 3 Assassinos Lamadaga e 15 Moralodos Lamadaga.‡Убейте 3 убийц Остротопи и 15 грязекопов Остротопи.‡Tötet 3 Auftragsmörder von Dolchfenn und 15 Matschkrabbler von Dolchfenn.‡비수늪일족 암살자 3명, 비수늪일족 땅꾼 15명을 처치해야 합니다.‡Mata a 3 asesinos Dagapantano y 15 habitabostas Dagapantano‡Mata a 3 asesinos Dagapantano y 15 habitabostas Dagapantano.‡Tuez 3 Assassins Tourbedague et 15 Marche-boue Tourbedague.‡杀死3个匕潭刺客和15个匕潭泥居者。‡殺掉3個匕首沼地刺客及15個匕首沼地污泥居者。',
  }
},
[10116] = {
  {
    'Procura-se: Chefe Mummaki‡Разыскивается: вождь Муммаки!‡Gesucht: Häuptling Mummaki‡현상 수배: 족장 뭄마키‡Se busca al cabecilla Mummaki‡Se busca: Cabecilla Mummaki‡On recherche : chef Mummaki‡通缉：穆玛基酋长‡懸賞:姆瑪奇酋長',
    nil,
    'Traga o Totem do Chefe Mummaki para Ikuti em Porto Orebor.‡Принесите тотем вождя Муммаки Икути в прибежище Оребор.‡Bringt Häuptling Mummakis Totem zu Ikuti in der Oreborzuflucht.‡오레보르 피난처에 있는 이쿠티에게 족장 뭄마키의 토템을 가져가야 합니다.‡Lleva el tótem del cabecilla Mummaki a Ikuti a Puerto Orebor.‡Lleva el tótem del cabecilla Mummaki a Ikuti a Puerto Orebor.‡Apportez le Totem du chef Mummaki à Ikuti au Havre d\'Orebor.‡将穆玛基酋长的图腾交给奥雷柏尔营地的伊库提。‡將姆瑪奇酋長圖騰交給奧雷伯爾港的伊庫堤。',
  }
},
[10117] = {
  {
    'Procura-se: Chefe Mummaki‡Разыскивается: вождь Муммаки!‡Gesucht: Häuptling Mummaki‡현상 수배: 족장 뭄마키‡Se busca: cabecilla Mummaki‡Se busca: Cabecilla Mummaki‡On recherche : chef Mummaki‡通缉：穆玛基酋长‡懸賞:姆瑪奇酋長',
    nil,
    'Traga o Totem do Chefe Mummaki para o Caçador Sombrio Denjai.‡Принесите тотем вождя Муммаки темному охотнику Денжаю.‡Bringt Häuptling Mummakis Totem zu Schattenjäger Denjai.‡어둠사냥꾼 덴자이에게 족장 뭄마키의 토템을 가져가야 합니다.‡Lleva el tótem del cabecilla Mummaki al cazador de las Sombras Denjai.‡Lleva el tótem del cabecilla Mummaki al cazador de las Sombras Denjai.‡Apportez le Totem du chef Mummaki au chasseur des ombres Denjai.‡将穆玛基酋长的图腾交给暗影猎手德恩加。‡將姆瑪奇酋長圖騰交給暗影獵人丹傑。',
  }
},
[10118] = {
  {
    'Mensagem para os Lamadaga‡Разговор с Остротопью‡Nachricht für Dolchfenn‡비수늪일족에게 보내는 메시지‡Mensaje a los Dagapantano‡Mensaje a los Dagapantano‡Un message pour les Tourbedague‡警告匕潭失落者‡給匕首沼地的訊息',
    nil,
    'Mate 3 Assassinos Lamadaga e 15 Moralodos Lamadaga. Em seguida, fale novamente com o caçador sombrio Denjai, em Zabra\'jin.‡Убейте 3 убийц и 15 грязекопов из племени Остротопи, и вернитесь к темному охотнику Денжаю в Забра\'джин.‡Tötet 3 Auftragsmörder von Dolchfenn und 15 Matschkrabbler von Dolchfenn und kehrt dann zu Schattenjäger Denjai in Zabra\'jin zurück.‡비수늪일족 암살자 3명, 비수늪일족 땅꾼을 15명을 해치운 다음 자브라진의 어둠사냥꾼 덴자이에게 보고하십시오.‡Mata 3 asesinos Dagapantano y 15 habitabostas Dagapantano y, a continuación, ve a ver al cazador de las Sombras Denjai en Zabra\'jin.‡Mata 3 asesinos Dagapantano y 15 habitabostas Dagapantano y, a continuación, ve a ver al cazador de las Sombras Denjai en Zabra\'jin.‡Tuez 3 Assassins tourbedagues et 15 Marche-boue tourbedagues, puis retournez voir le Chasseur des ombres Denjai à Zabra\'jin.‡杀死3个匕潭刺客和15个匕潭泥居者，然后返回萨布拉金向暗影猎手德恩加复命。‡殺掉3個匕首沼地刺客及15個匕首沼地污泥居者並於完成後回到薩布拉金找暗影獵人丹傑。',
  }
},
[10119] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡어둠의 문 너머로‡A través de El Portal Oscuro‡A través de El Portal Oscuro‡À travers la Porte des ténèbres‡跨越黑暗之门‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e encontre o Comandante Durão. Ele espera sua chegada do outro lado - em Terralém.‡Пройдите через Темный портал и найдите командора Дарона. Он ждет вашего прибытия на другой стороне, в Запределье.‡Reist durch das Dunkle Portal und sucht Kommandant Duron. Er wartet auf der anderen Seite auf Eure Ankunft - in der Scherbenwelt.‡어둠의 문으로 들어가서 문 반대편의 아웃랜드에서 당신의 도착을 기다리고 있는 지휘관 두론을 찾아야 합니다.‡Viaja a través de El Portal Oscuro y encuentra al comandante Duron. Te espera al otro lado... en Terrallende.|n‡Viaja a través de El Portal Oscuro y encuentra al comandante Duron. Te espera al otro lado... en Terrallende.|n‡Traversez la Porte des ténèbres et allez trouver le commandant Duron. Il attend votre arrivée de l\'autre côté - en Outreterre.‡穿越黑暗之门，找到指挥官杜隆。他就在黑暗之门另一侧的外域等你。‡通過黑暗之門找到指揮官杜朗。他在另一邊等你 - 就在外域裡。',
  }
},
[10120] = {
  {
    'Chegada em Terralém‡Прибытие в Запределье‡Ankunft in der Scherbenwelt‡아웃랜드 도착‡Llegada a Terrallende‡Llegada a Terrallende‡Arrivée en Outreterre‡抵达外域‡抵達外域',
    nil,
    'O Tenente-general Órion, no Portal Negro da Península Fogo do Inferno, quer que você leve um relatório para Vlagga Freipena.‡Доставьте донесение Ориона Влагге Легкоперой у Темного портала на полуострове Адского Пламени.‡Generalleutnant Orion beim Dunklen Portal auf der Höllenfeuerhalbinsel möchte, dass Ihr Orions Bericht zu Vlagga Freyfeder bringt.‡지옥불 반도의 어둠의 문에 있는 부사령관 오리온이 블라가 프레이페더에게 오리온의 보고서를 전해 달라고 부탁했습니다.‡El teniente general Orion de El Portal Oscuro en la Península del Fuego Infernal quiere que lleves su informe a Vlagga Plumacalma.‡El teniente general Orion de El Portal Oscuro en la Península del Fuego Infernal quiere que lleves su informe a Vlagga Plumacalma.‡Le général de division Orion à la Porte des ténèbres dans la péninsule des Flammes infernales veut que vous apportiez le Rapport d\'Orion à Vlagga Fileplume.‡地狱火半岛上黑暗之门旁的沃雷恩中将要求你将沃雷恩的报告交给维拉加·乱羽。‡地獄火半島上黑暗之門的歐萊恩中將要你將歐萊恩的報告交給法拉格·伏瑞菲德。',
  }
},
[10121] = {
  {
    'Extermine a Legião Ardente‡Истребить Пылающий Легион‡Die Brennende Legion ausrotten‡불타는 군단 박멸‡Erradicar a la Legión Ardiente‡Erradicar a la Legión Ardiente‡Éradiquer la Légion ardente‡消灭燃烧军团‡徹底消滅燃燒軍團',
    nil,
    'Fale com o Sargento Estilhaça-crânio perto da Caravana de Suprimentos do lado de fora de Thrallmar, ao leste.‡Поговорите с сержантом Лободробом, который находится при караване к востоку от Траллмара.‡Sprecht mit Unteroffizier Schädelbrecher bei der Versorgungskarawane außerhalb von Thrallmar im Osten.‡스랄마에서 동쪽으로 바로 바깥에 있는 보급 짐마차에 서 있는 하사관 쉐터스컬과 대화하십시오.‡Habla con el sargento Trizacráneo en la Caravana de Provisiones a las afueras de Thrallmar, hacia el este.‡Habla con el sargento Trizacráneo en la Caravana de Provisiones a las afueras de Thrallmar, hacia el este.‡Parlez au sergent Fracasse-crâne à la Caravane de ravitaillement, juste à l\'extérieur de Thrallmar, à l\'est.‡前往萨尔玛以东的补给车队，与斯古尔·碎颅者中士谈一谈。‡到索爾瑪城外東邊的補給營地找碎顱中士談談。',
  }
},
[10122] = {
  {
    'Ao alcance da Cidadela‡Вблизи цитадели‡Die Erstreckung der Zitadelle‡‡Espiando en la Ciudadela‡‡À portée de la citadelle‡堡垒的外围‡堡壘的聯繫',
    nil,
    'Procure pelo Soldado Imarion no acampamento mais ao norte na Muralha do Sul.‡Найдите следы рядового Имариона у самого северного лагеря орков Скверны, расположенного у Южного бастиона.‡Durchsucht das nördlichste Lager entlang des Südlichen Bollwerks nach einer Spur von Gefreiter Imarion.‡‡Busca alguna pista del soldado Imarion en el campamento situado en el extremo norte de la Muralla Sur.‡Busca alguna pista del soldado Imarion en el campamento situado en el extremo norte de la Muralla Sur.‡Fouillez le camp le plus au nord le long du Rempart du sud à la recherche de traces du soldat Imarion.‡前往南部城墙外最北侧的营地寻找列兵伊玛里恩的下落。‡到沿著南方堡壘最北方的營地找尋士兵艾瑪倫的足跡。',
  }
},
[10123] = {
  {
    'Ravina de Vil Fagulha‡Лощина Вспышки Скверны‡Teufelsfunkenklamm‡지옥불꽃 협곡‡El Barranco Burbujas Viles‡El Barranco Llama Infernal‡Le Ravin de Gangrétincelle‡魔火峡谷‡魔焰深谷',
    nil,
    'O Sargento Estilhaça-crânio, na Caravana de Suprimentos a leste de Thrallmar, na Península Fogo do Inferno, quer que você mate 4 Diabretes Ardilantes, 6 Armipotentes Infernais e 1 Clamamedo.‡Убейте 4 бесов-поджигателей, 6 инферналов-завоевателей и 1 вестника Ужаса по просьбе сержанта Лободроба, который находится при караване к востоку от Траллмара.‡Unteroffizier Schädelbrecher bei der Versorgungskarawane östlich von Thrallmar auf der Höllenfeuerhalbinsel möchte, dass Ihr 4 Flammenschürerwichtel, 6 höllische Kriegshetzer und 1 Schreckensrufer tötet.‡지옥불 반도의 스랄마 동쪽에 위치한 보급 짐마차에 서 있는 하사관 쉐터스컬이 공포의 소환사 1명과 임프 화염술사 4마리, 지옥불정령 전쟁인도자 6마리를 해치워 달라고 했습니다.‡El sargento Trizacráneo de la Caravana de Provisiones al este de Thrallmar en la Península del Fuego Infernal quiere que mates a 4 diablillos Despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡El sargento Trizacráneo de la Caravana de Provisiones al este de Thrallmar en la Península del Fuego Infernal quiere que mates a 4 diablillos Despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡Le sergent Fracasse-crâne de la Caravane de ravitaillement à l\'est de Thrallmar dans la péninsule des Flammes infernales veut que vous alliez tuer 4 Diablotins Attise-flammes, 6 Porteguerres infernaux et 1 Mande-effroi.‡萨尔玛东侧补给车队的斯古尔·碎颅者中士要求你杀死4个唤火小鬼、6个地狱火战争使者和1个恐惧召唤者。‡地獄火半島索爾瑪東邊補給商隊的碎顱中士要你殺掉4個烈焰行者小鬼，6個地獄火戰爭使者及1個恐懼呼喚者。',
  }
},
[10124] = {
  {
    'Comando Avançado: Posto dos Destroços‡Передовая застава: Останки Сквернобота‡Vorposten: Häschersturz‡전진기지: 지옥절단기 함락지‡Base de la vanguardia: Caída del Atracador Vil‡Base de la vanguardia: Caída del Atracador Vil‡Poste avancé : Trépas du saccageur‡机甲残骸‡前方據點:搶奪者荒野',
    nil,
    'Apresente-se ao Comandante To\'acha no Posto dos Destroços.‡Доложитесь командиру передовой То\'арху по прибытии к останкам Сквернобота.‡Meldet Euch bei Vorpostenkommandant To\'arch im Häschersturz.‡지옥절단기 함락지에 있는 전방사령관 토아크에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Présentez-vous au commandant des lignes avancées To\'arch au Trépas du saccageur.‡前往机甲残骸，向前线指挥官托尔克报到。‡向搶奪者荒野的前線指揮官吐阿奇報到。',
  }
},
[10125] = {
  {
    'Mission: Disrupt Communications‡Задание: разрушить связь‡Mission: Die Kommunikation unterbrechen‡‡Misión: Interrumpir las comunicaciones‡‡Mission : Brouiller les communications‡DEPRECATED‡任務:中斷聯繫',
    nil,
    'Forward Commander To\'arch at Reaver\'s Fall in Hellfire Peninsula has asked that you use To\'arch\'s Explosives and destroy Legion Antenna: Spite, Legion Antenna: Rage, Legion Antenna: Hate, Legion Antenna: Fear.‡Уничтожьте Антенну Легиона: Злоба, Антенну Легиона: Ярость, Антенну Легиона: Ненависть, Антенну Легиона: Страх с помощью взрывчатки То\'арха по приказу командира передовой То\'арха в Погибели Сквернобота на Полуострове Адского Пламени.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr To\'archs Sprengstoff benutzt, um den Sender der Legion: Bosheit, Sender der Legion: Zorn, Sender der Legion: Hass und Sender der Legion: Furcht zu zerstören.‡‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que uses los explosivos para destruir las Antenas Legión Maldad, Ira, Odio y Miedo.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que uses los explosivos para destruir las Antenas Legión Maldad, Ira, Odio y Miedo.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé d\'utiliser les Explosifs de To\'arch et de détruire l\'Antenne de la Légion : Mépris, l\'Antenne de la Légion : Haine, et l\'Antenne de la Légion : Peur.‡地狱火半岛上机甲残骸的Forward Commander To\'arch要你使用To\'arch\'s Explosives炸毁Legion Antenna: Spite、Legion Antenna: Rage、Legion Antenna: Hate和Legion Antenna: Fear。‡地獄火半島上搶奪者荒野的前線指揮官吐阿奇要你使用吐阿奇的爆裂物摧毀軍團天線:洩憤、軍團天線:狂怒、軍團天線:仇恨以及軍團天線:恐懼。',
  }
},
[10126] = {
  {
    'As ordens do Chefe-de-guerra Necrogg‡Приказы боевого командира Некрогга‡Kriegsboss Nekroggs Befehle‡‡Órdenes del mandón de guerra Nekrogg‡‡Les ordres de Nekrogg le Mène-guerre‡‡',
    nil,
    'Vá para o sul ao longo do lado oeste da Muralha do Sul, e procure sinais do Soldado Imarion no próximo acampamento.‡Проследуйте к югу вдоль западной части Южного бастиона и разыщите в одном из лагерей следы рядового Имариона.‡Reist entlang der westlichen Seite des Südlichen Bollwerks nach Süden und durchsucht das nächste Lager nach einer Spur von Gefreiter Imarion.‡‡Ve hacia el sur por el lado oeste de la Muralla Sur y busca al soldado Imarion en el siguiente campamento.‡Ve hacia el sur por el lado oeste de la Muralla Sur y busca al soldado Imarion en el siguiente campamento.‡Voyagez vers le sud le long du côté ouest du Rempart du sud et fouillez le prochain camp à la recherche de signes du soldat Imarion.‡‡',
  }
},
[10127] = {
  {
    'Mission: Sever the Tie‡Задание: Ослабить врага‡Mission: Das Band zerreißen‡‡Misión: Cortar la unión‡‡Mission : Couper le cordon‡DEPRECATED‡任務:切斷聯繫',
    nil,
    'Forward Commander To\'arch at Reaver\'s Fall in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Shi\'aziv.‡Убейте 4 укротителей Скверны, 8 гневостражей и поработительницу Ши\'азив по приказу командира передовой То\'арха у останков Сквернобота на Полуострове Адского Пламени.‡Vorpostenkommandant To\'arch am Häschersturz auf de Höllenfeuerhalbinsel möchte, dass Ihr 4 Teufelstreiber, 8 Zornwächter und Unterwerferin Shi\'aziv tötet.‡‡El comandante de vanguardia To\'arch en la Caída del Atracador Vil en la Península del Fuego Infernal, quiere que mates a 4 cuidadores viles, 8 guardias de cólera y al subyugador Shi\'aziv.‡El comandante de vanguardia To\'arch en la Caída del Atracador Vil en la Península del Fuego Infernal, quiere que mates a 4 cuidadores viles, 8 guardias de cólera y al subyugador Shi\'aziv.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé de tuer 4 Dresseurs gangrenés, 8 Garde-courroux et le Dominateur Shi\'aziv.‡地狱火半岛上机甲残骸的Forward Commander To\'arch要你去杀死4名Fel Handler，8名Wrathguards，以及Subjugator Shi\'aziv。‡地獄火半島上搶奪者荒野的前線指揮官吐阿奇要你殺掉4個惡魔處理者，8個憤怒守衛，以及征服者薛艾希。',
  }
},
[10128] = {
  {
    'O resgate do soldado Imarion‡Спасти рядового Имариона‡Der Soldat Imarion‡‡Salvar al soldado Imarion‡‡Il faut sauver le soldat Imarion‡‡',
    nil,
    'Continue indo para o sul ao longo da Muralha do Sul e procure o local em que o soldado Imarion está sendo mantido prisioneiro pelo Chefe-de-guerra Necrogg.‡Следуйте дальше к югу вдоль Южного бастиона и постарайтесь найти, где боевой командир Некрогг держит в плену рядового Имариона.‡Setzt Euren Weg entlang des Südlichen Bollwerks fort und sucht nach dem Ort, an dem Kriegsboss Nekrogg Gefreiter Imarion gefangen hält.‡‡Sigue hacia el sur por la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene cautivo al soldado Imarion.‡Sigue hacia el sur por la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene cautivo al soldado Imarion.‡Poursuivez vers le sud le long du Rempart du sud et cherchez l\'endroit où le mène-guerre Nekrogg détient le soldat Imarion.‡‡',
  }
},
[10129] = {
  {
    'Missão: Portais Murketh e Shaadraz‡Задание: Врата Муркет и Шаадраз‡Mission: Tore Murketh und Shaadraz‡임무: 멀케스 관문과 샤드라즈 관문‡Misión: Puerta Murketh y Puerta Shaadraz‡Misión: Puerta Murketh y Puerta Shaadraz‡Mission : Portes Murketh et Shaadraz‡任务：穆尔凯斯和沙德拉兹之门‡任務:墨奇斯以及夏德拉茲入口',
    nil,
    'Fale com o Comandante de Ala Brack, bombardeie o Portal Murketh e o Portal Shaadraz, e então fale novamente com o Comandante To\'acha no Posto dos Destroços.‡Поговорите с командиром звена Бракком, разбомбите Врата Муркет и Шаадраз, затем возвращайтесь к командиру передовой То\'арху к останкам Сквернобота.‡Sprecht mit Schwadronskommandant Brack, bombardiert Tor Murketh und Tor Shaadrez und kehrt dann zu Vorpostenkommandant To\'arch im Häschersturz zurück.‡편대사령관 브락크와 대화하여 멀케스 관문과 샤드라즈 관문에 폭탄을 투하한 다음 지옥절단기 함락지에 있는 전방사령관 토아크에게 가야 합니다.‡Habla con el comandante del aire Brack, bombardea Puerta Murketh y Puerta Shaadraz y después regresa junto al comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Habla con el comandante del aire Brack, bombardea Puerta Murketh y Puerta Shaadraz y después regresa junto al comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Parlez au chef d\'escadrille Brack, bombardez la Porte Murketh et la Porte Shaadraz, puis retournez voir le commandant des lignes avancées To\'arch au Trépas du saccageur.‡与空军指挥官布拉克谈谈，轰炸穆尔凯斯之门和沙德拉兹之门，然后向机甲残骸处的前线指挥官托尔克复命。‡與空軍指揮布拉克談談，炸掉墨奇斯入口以及夏德拉茲入口，完成後回到搶奪者荒野找前線指揮官吐阿奇。',
  }
},
[10130] = {
  {
    'O flanco ocidental‡Западный фланг‡Die westliche Flanke‡서쪽 측면 지역‡El flanco oeste‡‡Le flanc ouest‡西侧的威胁‡西翼的攻擊',
    nil,
    'Mate 10 Guardas da Mão Despedaçada, 10 Berserkers da Mão Despedaçada e 5 Acólitos da Mão Despedaçada, e então apresente-se à Tenente Amadi na torre de guarda oeste da Fortaleza da Honra.‡Убейте 10 стражников, 10 берсерков и 5 послушников из клана Изувеченной Длани. О выполнении задания доложите лейтенанту Амади, которая будет ждать вас в западной сторожевой башне Оплота Чести.‡Tötet 10 Wachen der Zerschmetterten Hand, 10 Berserker der Zerschmetterten Hand und 5 Akolythen der Zerschmetterten Hand und meldet Euch dann bei Leutnant Amadi im westlichen Wachturm der Ehrenfeste.‡으스러진 손의 경비병 10명, 으스러진 손의 광전사 10명, 으스러진 손의 수행사제 5명을 처치한 후, 서쪽 감시탑에 있는 부관 아마디에게 보고해야 합니다.‡Mata a 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada, e informa después a la teniente Amadi en la torre de vigilancia oeste del Bastión del Honor.‡Mata a 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada, e informa después a la teniente Amadi en la torre de vigilancia oeste del Bastión del Honor.‡Tuez 10 Gardes de la Main brisée, 10 Berserkers de la Main brisée et 5 Acolytes de la Main brisée, puis faites votre rapport au lieutenant Amadi dans la tour de garde ouest du bastion de l\'Honneur.‡杀死10名碎手卫兵、10名碎手狂战士和5名碎手侍僧，然后向荣耀堡西部哨塔的阿曼蒂中尉报到。‡殺死10個破碎之手護衛、10個破碎之手狂戰士以及5個破碎之手侍僧然後回到榮譽堡的西側防禦哨塔回報阿瑪迪中尉。',
  }
},
[10131] = {
  {
    'Planning the Escape‡План побега‡Fluchtplan‡‡Planear la huida‡‡Préparation de l\'évasion‡‡',
    nil,
    'Kill a Shattered Hand Grenadier and bring his Crude Explosives to Private Imarion at Gor\'gaz Outpost.‡Убейте гренадера клана Изувеченной Длани и принесите примитивную взрывчатку рядовому Имариону в форт Гор\'газ.‡Tötet einen Grenadier des Lachenden Schädels und bringt seine primitive Sprengladung zu Gefreiter Imarion im Außenposten von Gor\'gaz.‡‡Mata a 1 granadero Mano Destrozada y lleva sus rudimentarios explosivos al soldado Imarion en la Avanzada Gor\'gaz.‡Mata a 1 granadero Mano Destrozada y lleva sus rudimentarios explosivos al soldado Imarion en la Avanzada Gor\'gaz.‡Tuez un Grenadier de la Main brisée et apportez ses Explosifs rudimentaires au soldat Imarion à l\'avant-poste de Gor\'gaz.‡‡',
  }
},
[10132] = {
  {
    'Ameaça colossal‡Колоссальная угроза‡Eine kolossale Bedrohung‡거대괴수의 위협‡La amenaza colosal‡La amenaza colosal‡Menace colossale‡巨人的威胁‡巨大的威脅',
    nil,
    'Mate 5 Colossos Enfurecidos e fale novamente com Tola\'thion, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Убейте 5 яростных колоссов и возвращайтесь к Тола\'тиону на Кенарийскую заставу на полуострове Адского Пламени.‡Tötet 5 tobende Kolosse und kehrt dann zu Tola\'thion im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡분노한 거대괴수 5마리를 처치한 다음 지옥불 반도의 세나리온 초소에 있는 톨라시온에게 돌아가야 합니다.‡Mata a 5 colosos enfurecidos y regresa junto a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Mata a 5 colosos enfurecidos y regresa junto a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Tuez 5 Colosses déchaînés puis retournez voir Tola\'thion au Poste cénarien dans la péninsule des Flammes infernales.‡杀死5个暴怒的巨人，然后返回地狱火半岛的塞纳里奥哨站，向图拉希恩复命。‡殺掉5個狂怒的巨像，完成後回到地獄火半島的塞納里奧前哨找塔拉希恩。',
  }
},
[10133] = {
  {
    'Mission: Kill the Messenger‡Задание: убить гонца‡Mission: Tötet den Boten‡‡Misión: Matar al mensajero‡‡Mission : Tuer le messager‡‡',
    nil,
    'Forward Commander To\'arch at Reaver\'s Fall in Hellfire Peninsula has asked that you find and slay Arix\'malidash and recover the Legion Missive.‡Найдите Арикс\'малидаша, убейте его и заберите Послание Легиона по приказу командира передовой То\'арха у останков Сквернобота.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr Arix\'maladish findet und tötet und den Schriftwechsel der Legion besorgt.‡‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil, en la Península del Fuego Infernal, quiere que encuentres y mates a Arix\'malidash y recuperes la carta de la Legión.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil, en la Península del Fuego Infernal, quiere que encuentres y mates a Arix\'malidash y recuperes la carta de la Legión.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé de trouver et tuer Arix\'malidash et de récupérer la Missive de la Légion.‡‡',
  }
},
[10134] = {
  {
    'A crise do cristal carmesim‡Ключ к разгадке алого кристалла‡Hinweise des purpurnen Kristalls‡진홍색 수정의 실마리‡Pista para el cristal carmesí‡Pista para el cristal carmesí‡Un indice de cristal cramoisi‡火红水晶中的线索‡赤紅水晶線索',
    nil,
    'Leve o Estilhaço de Cristal Carmesim para Tola\'thion, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Доставьте осколок алого кристалла Тола\'тиону на Кенарийскую заставу на полуострове Адского Пламени.‡Bringt den Purpurkristallsplitter zu Tola\'thion im Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 톨라시온에게 진홍색 수정 조각을 전해 주어야 합니다.‡Entrega el fragmento de cristal carmesí a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Entrega el fragmento de cristal carmesí a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Apportez l\'Éclat de cristal cramoisi à Tola\'thion au Poste cénarien dans la péninsule des Flammes infernales.‡将火红水晶碎片交给地狱火半岛塞纳里奥哨站的图拉希恩。‡將赤紅水晶裂片送到地獄火半島的塞納里奧前哨給塔拉希恩。',
  }
},
[10135] = {
  {
    'Mission: Be the Messenger‡Задание: доставить послание‡Mission: Seid der Bote‡‡Misión: Sé el mensajero‡‡Mission : Être le messager‡‡',
    nil,
    'Take the Legion Missive to Nazgrel at Thrallmar in Hellfire Peninsula.‡Доставьте Послание Легиона Назгрелу в Траллмар на Полуострове Адского Пламени.‡Bringt den Schriftwechsel der Legion zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡‡Lleva la carta de la Legión a Nazgrel a Thrallmar, en la Península del Fuego Infernal.‡Lleva la carta de la Legión a Nazgrel a Thrallmar, en la Península del Fuego Infernal.‡Apportez la Missive de la Légion à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡‡',
  }
},
[10136] = {
  {
    'As intenções do Cruel‡Безжалостные планы‡Grausame Pläne‡가차없는 처단‡Crueles intenciones‡Crueles intenciones‡Les Liaisons cruelles‡阿拉修斯的意图‡殘忍的目的',
    nil,
    'Mate Arrázius, o Cruel, e fale novamente com Nazgrel em Thrallmar.‡Убейте Араззиуса Безжалостного и возвращайтесь к Назгрелу в Траллмар.‡Tötet Arazzius den Grausamen und kehrt danach zu Nazgrel in Thrallmar zurück.‡학살자 아라지우스를 처치하고 스랄마에 있는 나즈그렐에게 돌아가야 합니다.‡Mata a Arazzius el Cruel y vuelve con Nazgrel en Thrallmar.‡Mata a Arazzius el Cruel y vuelve con Nazgrel en Thrallmar.‡Tuez Arazzius le Cruel, puis retournez voir Nazgrel à Thrallmar.‡除掉残酷的阿拉修斯，然后返回萨尔玛向纳兹格雷尔复命。‡殺死殘忍的阿拉薩爾斯，再回索爾瑪找納茲格雷爾。',
  }
},
[10137] = {
  {
    'Provocando o Chefe-de-guerra‡Провокация‡Den Kriegsboss provozieren‡‡Provocando al mandón de guerra‡‡Provoquer le Mène-guerre‡‡',
    nil,
    'Use os Explosivos Rudimentares para criar balbúrdia e atrair o Chefe-de-guerra Necrogg para fora da torre. Mate-o, pegue a Chave de Necrogg e use-a para abrir a jaula do Soldado Imarion. Após libertar o Soldado Imarion, apresente-se à Tenente Amadi.‡Используйте примитивную взрывчатку, чтобы создать шум и выманить боевого командира Некрогга из его башни. Убейте его, заберите Ключ Некрогга и откройте клетку рядового Имариона. Об освобождении рядового Имариона доложите лейтенанту Амади.‡Benutzt die primitiven Sprengladungen um einen Tumult zu veranstalten und Kriegsboss Nekrogg aus seinem Turm zu locken. Tötet ihn, besorgt Nekroggs Schlüssel und öffnet damit Gefreiter Imarions Käfig. Wenn Ihr Gefreiter Imarion befreit habt, meldet Euch bei Leutnant Amadi.‡‡Usa los explosivos orcos para generar un disturbio que haga salir al mandón de guerra Nekrogg de la torre. Mátalo, coge la llave de Nekrogg y úsala para abrir la jaula del soldado Imarion. Después ve a informar a la teniente Amadi.‡Usa los explosivos orcos para generar un disturbio que haga salir al mandón de guerra Nekrogg de la torre. Mátalo, coge la llave de Nekrogg y úsala para abrir la jaula del soldado Imarion. Después ve a informar a la teniente Amadi.‡Utilisez les Explosifs rudimentaires pour semer le trouble et attirer le mène-guerre Nekrogg hors de sa tour. Tuez-le, prenez la clé de Nekrogg et utilisez-la pour ouvrir la cage du soldat Imarion. Une fois que vous aurez libéré Imarion, présentez-vous au lieutenant Amadi.‡‡',
  }
},
[10138] = {
  {
    'Quem mandou?‡Кто отдает приказы?‡Auf wessen Befehl hin?‡‡¿Quién manda aquí?‡‡Sous les ordres de qui ?‡‡',
    nil,
    'Mate 20 Brutos da Mão Despedaçada, 10 Bruxos da Mão Despedaçada e roube as Ordens do Instrutor Militar Zurok. Então, fale novamente com a Tenente Amadi na torre de guarda ocidental da Fortaleza da Honra.‡Убейте 20 рубак и 10 чернокнижников клана Изувеченной Длани и захватите распоряжения военного инструктора Зурока. После этого возвращайтесь к лейтенанту Амади в западную сторожевую башню Оплота Чести.‡Tötet 20 Grunzer der Zerschmetterten Hand, 10 Hexenmeister der Zerschmetterten Hand und besorgt Euch Drillmeister Zurok\'s Anweisungen. Kehrt dann zu Leutnant Amadi im westlichen Wachturm der Ehrenfeste zurück.‡‡Mata a 20 brutos y 10 brujos Mano Destrozada y captura las órdenes del maestro de maniobras Zurok. Luego ve a ver a la teniente Amadi a la torre de vigilancia oeste del Bastión del Honor.‡Mata a 20 brutos y 10 brujos Mano Destrozada y captura las órdenes del maestro de maniobras Zurok. Luego ve a ver a la teniente Amadi a la torre de vigilancia oeste del Bastión del Honor.‡Tuez 20 Grunts de la Main brisée et 10 Démonistes de la Main brisée, et emparez-vous des Ordres du maître de manœuvre Zurok. Puis retournez voir le lieutenant Amadi à la tour de garde ouest du bastion de l\'Honneur.‡‡',
  }
},
[10139] = {
  {
    'Executando o Comandante‡Разжаловать командира‡Die Beseitigung des Kommandanten‡‡Vencer al comandante‡‡Liquider le commandant‡‡',
    nil,
    'Mate o Comandante-chefe Gorax e apresente-se à Tenente Amadi na torre de guarda ocidental da Fortaleza da Honra.‡Уничтожьте командира соединения Горакса и доложите о выполнении задания лейтенанту Амади, которая находится в западной башне Оплота Чести.‡Tötet Truppenkommandant Gorax und meldet Euch dann bei Leutnant Amadi im westlichen Turm der Ehrenfeste zurück.‡‡Mata al comandante en jefe Gorax y preséntate ante la teniente Amadi en la torre oeste del Bastión del Honor.‡Mata al comandante en jefe Gorax y preséntate ante la teniente Amadi en la torre oeste del Bastión del Honor.‡Tuez le commandant de corps Gorax et faites votre rapport au lieutenant Amadi dans la tour ouest du bastion de l\'Honneur.‡‡',
  }
},
[10140] = {
  {
    'Viagem à Fortaleza da Honra‡Путешествие в Оплот Чести‡Reise zur Ehrenfeste‡명예의 요새로 가는 길‡Viaje al Bastión del Honor‡Viaje al Bastión del Honor‡En route pour le bastion de l\'Honneur‡荣耀堡之旅‡榮譽堡之行',
    nil,
    'Pegue um voo até a Fortaleza da Honra e entregue o Relatório de Durão para o Marechal Isildo‡Долетите до Оплота Чести и доставьте донесение Дурона маршалу Исилдору.‡Fliegt zur Ehrenfeste und übergebt Marschall Isildor Durons Bericht.‡명예의 요새로 날아가서 치안대장 이실도르에게 두론의 보고서를 전달해야 합니다.‡Vuela hasta el Bastión del Honor y entrega el informe de Duron al mariscal Isildor.‡Vuela hasta el Bastión del Honor y entrega el informe de Duron al mariscal Isildor.‡Volez jusqu\'au bastion de l\'Honneur et apportez le Rapport de Duron au maréchal Isildor.‡乘座狮鹫前往荣耀堡，将杜隆的报告交给伊斯多尔元帅。‡飛到榮譽堡把杜朗的報告送給治安官伊斯歐朵爾。',
  }
},
[10141] = {
  {
    'A Legião renascida‡Возрожденный Легион‡Wiedergeburt der Brennenden Legion‡다시 나타난 불타는 군단‡El renacer de la Legión‡El renacer de la Legión‡La renaissance de la Légion‡重生的军团‡燃燒軍團捲土重來',
    nil,
    'Fale com a Sargento Alana perto da Caravana de Suprimentos do lado de fora da Fortaleza da Honra, na direção leste.‡Поговорите с сержантом Альтумой, которая находится рядом с восточным караваном, к востоку от Оплота Чести.‡Sprecht mit Unteroffizier Altumus bei der östlichen Versorgungskarawane außerhalb der Ehrenfeste im Osten.‡명예의 요새 바로 바깥 동쪽의 동쪽 보급 짐마차에 있는 하사관 알투무스와 대화해야 합니다.‡Habla con la sargento Altumus en la Caravana de Provisiones del Este justo fuera del Bastión del Honor, hacia el este.‡Habla con la sargento Altumus en la Caravana de Provisiones del Este justo fuera del Bastión del Honor, hacia el este.‡Parlez au sergent Altumus à la Caravane de ravitaillement de l\'est, juste à l\'extérieur du bastion de l\'Honneur, à l\'est.‡与荣耀堡外面的东补给车队的沃图姆斯中士谈一谈。‡到東方去與榮譽堡外東部補給營地的阿圖瑪斯中士談談。',
  }
},
[10142] = {
  {
    'O Caminho da Angústia‡Путь Страданий‡Der Pfad der Pein‡고통의 길‡El Camino del Tormento‡El Camino del Tormento‡Le chemin de l\'Angoisse‡苦痛之路‡苦痛之路',
    nil,
    'A Sargento Alana, na Caravana de Suprimentos a leste da Fortaleza da Honra, na Península Fogo do Inferno, quer que você mate 4 Diabretes Ardilantes 6 Armipotentes Infernais e 1 Clamamedo.‡Убейте 4 бесов-поджигателей, 6 инферналов-завоевателей и 1 вестника ужаса по приказу сержанта Альтумы из восточного каравана, который находится на востоке от Оплота Чести на полуострове Адского Пламени.‡Unteroffizier Altumus bei der östlichen Versorgungskarawane östlich der Ehrenfeste auf der Höllenfeuerhalbinsel möchte, dass Ihr 4 Flammenschürerwichtel, 6 höllische Kriegshetzer und 1 Schreckensrufer tötet.‡지옥불 반도의 명예의 요새 동쪽에 위치한 동쪽 보급 짐마차에 있는 하사관 알투무스가 임프 화염술사 4명, 갈퀴발 지옥 마귀 6명, 지옥불정령 전투병 1명를 처치해 달라고 부탁했습니다.‡La sargento Altumus en la Caravana de Provisiones del Este del Bastión del Honor en la Península del Fuego Infernal, quiere que mates a 4 diablillos despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡La sargento Altumus en la Caravana de Provisiones del Este del Bastión del Honor en la Península del Fuego Infernal, quiere que mates a 4 diablillos despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡Le sergent Altumus de la Caravane de ravitaillement de l\'est, qui se trouve à l\'est du bastion de l\'Honneur dans la péninsule des Flammes infernales, vous a demandé de tuer 4 Diablotins attise-flammes, 6 Porteguerres infernaux et 1 Mande-effroi.‡荣耀堡外面的东补给车队的沃图姆斯中士要求你杀死4只唤火小鬼、6只地狱火战争使者和1只恐惧召唤者。‡在地獄火半島榮譽堡東方的東部補給營地的阿圖瑪斯中士要你殺死4個烈焰行者小鬼，6個地獄火戰爭使者和1個恐懼呼喚者。',
  }
},
[10143] = {
  {
    'Posto da Expedição‡Лагерь экспедиции‡Expeditionsposten‡원정대 거점‡Punta de Expedición‡Punta de Expedición‡La halte de l\'expédition‡远征军岗哨‡遠征隊哨塔',
    nil,
    'Apresente-se ao Comandante Kingston, do Comando Avançado, no Posto da Expedição.‡Доложитесь командиру передовой Кингстону в лагере экспедиции.‡Meldet euch bei Vorpostenkommandant Wa\'ppun im Expeditionsposten.‡원정대 거점에 있는 전방사령관 킹스톤에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia Kingston en la Punta de Expedición.‡Preséntate ante el comandante de vanguardia Kingston en la Punta de Expedición.‡Présentez-vous au commandant des lignes avancées Kingston à la Halte de l\'expédition.‡向远征军岗哨的前线指挥官金斯顿报到。‡向遠征隊哨塔的前線指揮官金斯頓回報。',
  }
},
[10144] = {
  {
    'Interrompa os reforços‡Лишить Легион подкрепления!‡Die Kommunikation unterbrechen‡지원군 차단‡Perturbar sus refuerzos‡Perturbar sus refuerzos‡Couper l\'ennemi de ses renforts‡阻断援军‡阻斷他們的援軍',
    nil,
    'Derrote inimigos perto do Portal Grimh e Kaalez para coletar Pedras Rúnicas Demoníacas.nnUse o detonador de Kingston dentro do Portal Grimh e do Portal Kaalez quando tiver pedras suficientes.nnLeve os explosivos que sobrarem para o Comandante Avançado Kingston.‡Уничтожьте врага вокруг порталов Грим и Каалез и соберите камни с рунами демонов.nnЗабросьте запалы Кингстона в порталы Грим и Каалез.nnПосле выполнения задания возвращайтесь к командиру передовой Кингстону вместе с оставшейся взрывчаткой.‡Besiegt die Feinde um Portal Grimh und Portal Kaalez herum, um dämonische Runensteine zu sammeln.nnBenutzt Wa\'ppuns Zünder in Portal Grimh und Portal Kaalez.nnKehrt danach mit dem Zünder zu Vorpostenkommandant Wa\'ppun zurück.‡그림 차원문과 칼레즈 차원문 주위의 적들을 처치하여 악마의 룬을 모으십시오.nn그림 차원문과 칼레즈 차원문 내에서 킹스톤의 뇌관을 사용하십시오.nn임무를 완수하면 나머지 뇌관을 가지고 전방사령관 킹스톤에게 돌아가야 합니다.‡Vence a los enemigos que hay alrededor del Portal Grimh y el Portal Kaalez para reunir piedras rúnicas demoníacas.nnUsa el cebo explosivo de Kingston dentro del Portal Grimh y del Portal Kaalez.nnVuelve con el comandante de vanguardia Kingston con los explosivos restantes.‡Vence a los enemigos que hay alrededor del Portal Grimh y el Portal Kaalez para reunir piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de Kingston dentro del Portal Grimh y del Portal Kaalez.|n|nVuelve con el comandante de vanguardia Kingston con los explosivos restantes.‡Tuez des ennemis du Portail Grimh et du Portail Kaalez pour collecter des Pierres runiques démoniaques.nnUtilisez les Amorces de Kingston à l\'intérieur du Portail Grimh et du Portail Kaalez.nnRetournez voir le commandant des lignes avancées Kingston avec les explosifs restants.‡消灭格雷姆传送门和凯勒兹传送门附近的敌人，收集它们身上的恶魔符文石。nn然后在格雷姆传送门和凯勒兹传送门内使用金斯顿的雷管。nn完成任务后，将剩余的炸药还给前线指挥官金斯顿。‡殺掉格瑞之門和卡雷茲之門附近的敵人取得惡魔符文石。|n在格瑞之門和卡雷茲之門內使用金斯頓的書冊。|n帶著剩下的爆裂物回去找前線指揮官金斯頓。',
  }
},
[10145] = {
  {
    'Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡‡Mission: Sever the Tie UNUSED‡‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED',
    nil,
    'Forward Commander Kingston at Expedition Point in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Yalqiz.‡Уничтожьте 4 укротителя Скверны, 8 гневостражей и Поработителя Ялквиза по приказу командира передовой Кингстона из лагеря экспедиции на Полуострове Адского Пламени.‡Vorpostenkommandant Wa\'ppun beim Expeditionsposten auf de Höllenfeuerhalbinsel möchte, dass Ihr 4 Teufelstreiber, 8 Zornwächter und Unterwerferin Yalqiz tötet.‡‡El comandante de vanguardia Kingston en la Punta de Expedición, en la Península del Fuego Infernal, quiere que mates 4 cuidadores viles, 8 guardias de cólera y al subyugador Yalqiz.‡El comandante de vanguardia Kingston en la Punta de Expedición, en la Península del Fuego Infernal, quiere que mates 4 cuidadores viles, 8 guardias de cólera y al subyugador Yalqiz.‡Le commandant des lignes avancées Kingston de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de tuer 4 Dresseurs gangrenés, 8 Garde-courroux et le Dominateur Yalqiz.‡Forward Commander Kingston at Expedition Point in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Yalqiz.‡地獄火半島上遠征隊哨塔的前線指揮官金斯頓要你殺死4個惡魔處理者，8個憤怒守衛，和征服者亞奎斯。',
  }
},
[10146] = {
  {
    'Missão: Os Portais Murketh e Shaadraz‡Задание: Врата Муркет и Шаадраз‡Mission: Tor Murketh und Tor Shaadraz‡임무: 멀케스 관문과 샤드라즈‡Misión: la Puerta Murketh y la Puerta Shaadraz‡Misión: La Puerta Murketh y la Puerta Shaadraz‡Mission : Portes Murketh et Shaadraz‡任务：穆尔凯斯和沙德拉兹之门‡任務:墨奇斯和夏德拉茲入口',
    nil,
    'Fale com o Comandante de Ala Dabir\'ee, bombardeie o Portal Murketh e o Portal Shaadraz, e então fale novamente com o Comandante Avançado Kingston no Posto da Expedição.‡Поговорите с командиром звена Даби\'ри, разбомбите Врата Муркет и Врата Шаадраз, затем возвращайтесь к командиру передовой Кингстону в Лагерь экспедиции.‡Sprecht mit Schwadronskommandant Dabir\'ee, bombardiert Tor Murketh und Tor Shaadraz und kehrt dann zu Vorpostenkommandant Wa\'ppun am Expeditionsposten zurück.‡편대사령관 다비리와 대화한 후 멀케스 관문과 샤드라즈 관문을 폭파시킨 다음 원정대 거점에 있는 전방사령관 킹스톤에게 돌아가야 합니다.‡Habla con el comandante del aire Dabir\'ee, bombardea la Puerta Murketh y la Puerta Shaadraz y, a continuación, vuelve a ver al comandante de vanguardia Kingston en la Punta de Expedición.‡Habla con el comandante del aire Dabir\'ee, bombardea la Puerta Murketh y la Puerta Shaadraz y, a continuación, vuelve a ver al comandante de vanguardia Kingston en la Punta de Expedición.‡Parlez au Chef d\'escadrille Dabir\'ee, bombardez la Porte Murketh et la Porte Shaadraz, puis retournez voir le Commandant des lignes avancées Kingston à la Halte de l\'expédition.‡与空军指挥官达比利谈谈，轰炸穆尔凯斯之门和沙德拉兹之门，然后向远征军岗哨的前线指挥官金斯顿复命。‡與空軍指揮戴畢瑞交談，炸掉墨奇斯入口和夏德拉茲入口，然後回到遠征隊哨塔向前線指揮官金斯頓回報。',
  }
},
[10147] = {
  {
    'Mission: Kill the Messenger‡Задание: убить гонца‡Mission: Tötet den Boten‡‡Misión: Matar al mensajero‡‡Mission : Tuer le messager‡‡',
    nil,
    'Forward Commander Kingston at Expedition Point in Hellfire Peninsula has asked that you find and slay Arix\'malidash and recover the Legion Missive.‡Отыщите Арикс\'малидаша, убейте его и заберите Послание Легиона по приказу командира передовой Кингстона из лагеря экспедиции на Полуострове Адского Пламени.‡Vorpostenkommandant Königstein im Expeditionsposten auf der Höllenfeuerhalbinsel möchte, dass Ihr Arix\'maladish findet und tötet und den Schriftwechsel der Legion besorgt.‡‡El comandante de vanguardia Kingston de la Punta de Expedición, en la Península del Fuego Infernal, ha pedido que encuentres a Arix\'malidash, lo mates y recuperes la misiva de la legión.‡El comandante de vanguardia Kingston de la Punta de Expedición, en la Península del Fuego Infernal, ha pedido que encuentres a Arix\'malidash, lo mates y recuperes la misiva de la legión.‡Le commandant des lignes avancées Kingston de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de trouver et tuer Arix\'malidash et de récupérer la Missive de la Légion.‡‡',
  }
},
[10148] = {
  {
    'Mission: Be the Messenger‡Задание: доставить послание‡Mission: Seid der Bote‡‡Misión: Sé el mensajero‡‡Mission : Être le messager‡‡',
    nil,
    'Take the Legion Missive to Force Commander Danath Trollbane at Honor Hold in Hellfire Peninsula.‡Доставьте Послание Легиона командиру армии Данату Троллебою в Оплот Чести на Полуострове Адского Пламени.‡Bringt den Schriftwechsel der Legion zu Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡‡Lleva la carta de la Legión al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Lleva la carta de la Legión al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Apportez la Missive de la Légion au commandant de corps Danath Trollemort, au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡‡',
  }
},
[10149] = {
  {
    'Mission: End All, Be All‡Задание: со щитом или на щите‡Mission: Beendet alles, seid alles‡‡Misión: Acaba con todo, sé todo‡‡Mission : Point final‡‡',
    nil,
    'Force Commander Danath Trollbane at Honor Hold in Hellfire Peninsula has asked that you slay Arazzius the Cruel.‡Убейте Араззиуса Безжалостного по приказу командира армии Даната Троллебоя из Оплота Чести на Полуострове Адского Пламени.‡Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel möchte, dass Ihr Arazzius den Grausamen tötet.‡‡El comandante en jefe Danath Aterratrols, del Bastión del Honor en la Península del Fuego Infernal, ha pedido que ejecutes a Arazzius el Cruel.|n‡El comandante en jefe Danath Aterratrols, del Bastión del Honor en la Península del Fuego Infernal, ha pedido que ejecutes a Arazzius el Cruel.|n‡Le commandant de corps Danath Trollemort au bastion de l\'Honneur dans la péninsule des Flammes infernales vous a demandé de tuer Arazzius le Cruel.‡‡',
  }
},
[10150] = {
  {
    'Ao alcance da Cidadela‡Вблизи цитадели‡Die Erstreckung der Zitadelle‡‡Espiando en la Ciudadela‡‡À portée de la citadelle‡堡垒的外围‡堡壘的聯繫',
    nil,
    'Procure pela Batedora Makha no acampamento mais ao norte na Muralha do Norte.‡Постарайтесь найти следы разведчицы Махи в одном из лагерей, расположенных вдоль Северного бастиона.‡Durchsucht das nördlichste Lager entlang des Nördlichen Bollwerks nach einer Spur von Späherin Makha.‡‡Busca alguna pista de la exploradora Makha en el campamento más al norte junto a la Muralla Norte.‡Busca alguna pista de la exploradora Makha en el campamento más al norte junto a la Muralla Norte.‡Fouillez le camp le plus au nord le long du Rempart du nord à la recherche de traces de l\'éclaireur Makha.‡‡沿著最北邊的營地到北方堡壘搜尋任何有關斥候馬克哈的線索。',
  }
},
[10151] = {
  {
    'As ordens do Chefe-de-guerra Necrogg‡Приказы боевого командира Некрогга‡Kriegsboss Nekroggs Befehle‡‡Órdenes del dirigente de guerra Nekrogg‡‡Les ordres de Nekrogg le Mène-guerre‡‡',
    nil,
    'Vá para o sul seguindo pelo lado oeste da Muralha do Norte, e procure sinais da Batedora Makha no próximo acampamento.‡Отправляйтесь к югу вдоль западной стороны Северного бастиона и постарайтесь найти следы разведчицы Махи в одном из лагерей.‡Reist entlang der westlichen Seite des Nördlichen Bollwerks nach Süden und durchsucht das nächste Lager nach einer Spur von Späherin Makha.‡‡Ve al sur siguiendo la parte oeste de la Muralla Norte y busca en el siguiente campamento a la exploradora Makha.‡Ve al sur siguiendo la parte oeste de la Muralla Norte y busca en el siguiente campamento a la exploradora Makha.‡Voyagez vers le sud le long du côté ouest du Rempart du nord et fouillez le prochain camp à la recherche de signes de l\'éclaireur Makha.‡‡',
  }
},
[10152] = {
  {
    'O flanco ocidental‡Западный фланг‡Die westliche Flanke‡서쪽 측면‡El flanco oeste‡‡Le flanc ouest‡西侧的威胁‡西翼的攻擊',
    nil,
    'Mate 10 Guardas da Mão Despedaçada, 10 Berserkers da Mão Despedaçada e 5 Acólitos da Mão Despedaçada, e então apresente-se ao Guarda Pétreo Ambelão, no Acampamento Quebra-espinha perto de Zeth\'Gor.‡Убейте 10 стражников, 10 берсерков и 5 послушников из клана Изувеченной Длани. О выполнении задания доложите каменному стражу Амбелану, который находится на заставе Раздробленного Хребта, рядом с Зет\'Гором.‡Tötet 10 Wachen der Zerschmetterten Hand, 10 Berserker der Zerschmetterten Hand und 5 Akolythen der Zerschmetterten Hand und meldet Euch dann bei Steingardist Ambelan im Rückenbrecherposten in der Nähe von Zeth\'Gor.‡으스러진 손 경비병 10명, 으스러진 손 광전사 10명, 으스러진 손 수행사제 5명을 해치운 후 제스고르 근처의 해골망치 초소에 있는 투사 암벨란에게 보고해야 합니다.‡Mata 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada. A continuación, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Mata 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada. A continuación, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Tuez 10 Gardes de la Main brisée, 10 Berserkers de la Main brisée et 5 Acolytes de la Main brisée, puis faites votre rapport au garde de pierre Ambelan au Poste de Brise-échine près de Zeth\'Gor.‡‡殺掉10個破碎之手護衛，10個破碎之手狂戰士，以及5個破碎之手侍僧，完成後回到薩斯葛爾附近的斷脊氏族崗哨找石衛士安比藍。',
  }
},
[10153] = {
  {
    'O resgate da batedora Makha‡Спасти разведчицу Маху‡Die Späherin Makha‡‡Rescate de la exploradora Makha‡‡Il faut sauver l\'éclaireur Makha‡‡',
    nil,
    'Siga para o sul ao longo do Caminho da Glória até chegar à Muralha do Sul, e procure o local em que a Batedora Makha está sendo mantida prisioneira pelo Chefe-de-guerra Necrogg.‡Следуйте дальше к югу вдоль Южного бастиона и постарайтесь найти, где боевой командир Некрогг держит в плену разведчицу Маху.‡Setzt Euren Weg über den Pfad des Ruhms fort und sucht nach dem Ort, an dem Kriegsboss Nekrogg Späherin Makha gefangen hält.‡‡Sigue hacia el sur por El Camino a la Gloria, hasta la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene prisionera a la exploradora Makha.‡Sigue hacia el sur por El Camino a la Gloria, hasta la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene prisionera a la exploradora Makha.‡Poursuivez vers le sud en traversant le sentier de la Gloire vers le Rempart du sud et cherchez l\'endroit où le mène-guerre Nekrogg détient l\'éclaireur Makha.‡‡',
  }
},
[10154] = {
  {
    'Planning the Escape‡План побега‡Fluchtplan‡‡Planear la huida‡‡Préparation de l\'évasion‡‡',
    nil,
    'Kill a Shattered Hand Grenadier and bring his Crude Explosives to Scout Makha at Gor\'gaz Outpost.‡Убейте гренадера клана Изувеченной Длани и принесите примитивную взрывчатку разведчице Махе в форт Гор\'газ.‡Tötet einen Grenadier des Lachenden Schädels und bringt seine primitive Sprengladung zu Späherin Makha im Außenposten von Gor\'gaz.‡‡Mata a un granadero Mano Destrozada y lleva sus explosivos rudimentarios a la exploradora Makha en la Avanzada Gor\'gaz.‡Mata a un granadero Mano Destrozada y lleva sus explosivos rudimentarios a la exploradora Makha en la Avanzada Gor\'gaz.‡Trouvez un Grenadier de la Main brisée et apportez ses Explosifs rudimentaires à l\'éclaireur Makha à l\'avant-poste de Gor\'gaz.‡‡',
  }
},
[10155] = {
  {
    'Provocando o Chefe-de-guerra‡Провокация‡Den Kriegsboss provozieren‡‡Provocando al mandón de guerra‡‡Provoquer le Mène-guerre‡‡',
    nil,
    'Use os Explosivos Rudimentares para criar balbúrdia e atrair o Chefe-de-guerra Necrogg para fora da torre. Mate-o, pegue a chave de Necrogg e use-a para abrir a jaula da Batedora Makha. Quando a Batedora Makha estiver livre, fale novamente com o Guarda Pétreo Ambelão, no Acampamento Quebra-espinha, perto de Zeth\'Gor.‡Используйте примитивную взрывчатку, чтобы создать шум и выманить боевого командира Некрогга из его башни. Убейте его, заберите Ключ Некрогга и откройте клетку разведчицы Махи. Об освобождении разведчицы Махи доложите каменному стражу Амбелану на Заставу Разрушенного Хребта рядом с Зет\'Гором.‡Benutzt die primitive Sprengladung um einen Tumult zu veranstalten und Kriegsboss Nekrogg aus seinem Turm zu locken. Tötet ihn, besorgt Nekroggs Schlüssel und öffnet damit Späherin Makhas Käfig. Wenn Ihr Späherin Makha befreit habt, meldet Euch bei Steingardist Ambelan im Rückenbrecherposten in der Nähe von Zeth\'Gor.‡‡Utiliza los explosivos rudimentarios para crear una distracción y conseguir sacar al mandón de guerra Nekrogg de su torre. Mátale, consigue la llave de Nekrogg y utilízala para abrir la jaula de la exploradora Makha. Cuando la hayas liberado, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Utiliza los explosivos rudimentarios para crear una distracción y conseguir sacar al mandón de guerra Nekrogg de su torre. Mátale, consigue la llave de Nekrogg y utilízala para abrir la jaula de la exploradora Makha. Cuando la hayas liberado, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Utilisez les Explosifs rudimentaires pour semer le trouble et attirer le mène-guerre Nekrogg hors de sa tour. Tuez-le, prenez la clé de Nekrogg et utilisez-la pour ouvrir la cage de l\'éclaireur Makha. Une fois que vous aurez libéré Makha, présentez-vous au garde de pierre Ambelan au Poste de Brise-échine près de Zeth\'Gor.‡‡',
  }
},
[10156] = {
  {
    'Quem mandou?‡Кто отдает приказы?‡Auf wessen Befehl hin?‡‡¿Quién manda aquí?‡‡Sous les ordres de qui ?‡‡',
    nil,
    'Mate 20 Brutos da Mão Despedaçada, 10 Bruxos da Mão Despedaçada e roube as Ordens do Instrutor Militar Zurok. Fale novamente com o Guarda Pétreo Ambelão, no Acampamento Quebra-espinha.‡Убейте 20 рубак и 10 чернокнижников клана Изувеченной Длани и захватите распоряжения военного инструктора Зурока. После этого возвращайтесь к каменному стражу Амбелану на Заставу Хребтолома.‡Tötet 20 Grunzer der Zerschmetterten Hand, 10 Hexenmeister der Zerschmetterten Hand und besorgt Euch Drillmeister Zurok\'s Anweisungen. Kehrt dann zu Steingardist Ambelan im Rückenbrechergrat zurück.‡‡Mata 20 brutos Mano Destrozada, 10 brujos Mano Destrozada y consigue las órdenes del maestro de maniobras Zurok. Después, ve a ver al guardia de piedra Ambelan en la Avanzada Rompeloma.‡Mata 20 brutos Mano Destrozada, 10 brujos Mano Destrozada y consigue las órdenes del maestro de maniobras Zurok. Después, ve a ver al guardia de piedra Ambelan en la Avanzada Rompeloma.‡Tuez 20 Grunts de la Main brisée et 10 Démonistes de la Main brisée, et emparez-vous des Ordres du maître de manœuvre Zurok. Puis retournez voir le garde de pierre Ambelan au Poste de Brise-échine.‡‡',
  }
},
[10157] = {
  {
    'Executando o Comandante‡Разжаловать командира‡Die Beseitigung des Kommandanten‡‡Vencer al comandante‡‡Liquider le commandant‡‡',
    nil,
    'Mate o Comandante-chefe Gorax e fale novamente com o Caçador Sombrio Ty\'jin, em Thrallmar.‡Уничтожьте командира соединения Горакса и доложите о выполнении задания темному охотнику Ти\'джину из Траллмара.‡Tötet Truppenkommandant Gorax und meldet Euch dann bei Schattenjäger Ty\'jin in Thrallmar zurück.‡‡Mata al comandante en jefe Gorax y preséntate ante el cazador de las Sombras Ty\'jin en Thrallmar.‡Mata al comandante en jefe Gorax y preséntate ante el cazador de las Sombras Ty\'jin en Thrallmar.‡Tuez le commandant de corps Gorax et faites votre rapport au chasseur des ombres Ty\'jin à Thrallmar.‡‡',
  }
},
[10158] = {
  {
    'Suprimentos dos Olhos Sangrentos‡Припасы Кровавой Глазницы‡Vorräte des Blutenden Auges‡‡Suministros Foso Sangrante‡‡Les fournitures de l\'Orbite-sanglante‡‡',
    nil,
    'Destrua 6 Pilhas de Suprimentos dos Olhos Sangrentos e apresente-se ao Guarda Pétreo Ambelão no Acampamento Quebra-espinha.‡Уничтожьте 6 складов припасов клана Кровавой Глазницы и доложите о выполнении задания каменному стражу Амбелану с Заставы Хребтолома.‡Zerstört 6 Stapel Vorräte des Blutenden Auges und meldet Euch dann bei Steingardist Ambelan im Rückenbrecherposten zurück.‡‡Destruye 6 pilas de suministros Foso Sangrante y preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma.‡Destruye 6 pilas de suministros Foso Sangrante y preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma.‡Détruisez 6 piles de Fournitures de l\'Orbite-sanglante et faites votre rapport au garde de pierre Ambelan au Poste de Brise-échine.‡‡',
  }
},
[10159] = {
  {
    'Mantenha o Monte Presacúleo limpo!‡Очистить холм Колючего Клыка!‡Haltet den Dornnebelhügel sauber!‡가시송곳니 언덕 사수!‡Mantener despejada la Colina Colmillespinado‡Mantener despejada la Colina Colmillespinado‡Nettoyer la colline de Roncecroc‡扫清棘牙岭！‡清光棘牙丘陵!',
    nil,
    'Mate 8 Assoladores Presacúleos e 8 Cospeçonhas Presacúleos, e então fale novamente com Mauram Casco Robusto, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Убейте 8 опустошителей Колючего Клыка и 8 ядоплюев Колючего Клыка. После выполнения задания возвращайтесь к Махураму Крепкому Копыту на Кенарийскую заставу на полуострове Адского Пламени.‡Tötet 8 Dornenfangfelshetzer und 8 Dornenfanggiftspucker und kehrt dann zu Mahuram Starkhuf im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡가시송곳니 갈퀴발톱 8마리, 맹독 가시송곳니 갈퀴발톱 8마리를 처치한 후 지옥불 반도의 세나리온 초소에 있는 마후람 스타우트후프에게 보고해야 합니다.‡Mata 8 devastadores Colmillespinados y 8 escupetósigos Colmillespinados. A continuación ve a ver a Mahuram Pezuñarrecia en el Puesto Cenarion, en la Península del Fuego Infernal.‡Mata 8 devastadores Colmillespinados y 8 escupetósigos Colmillespinados. A continuación ve a ver a Mahuram Pezuña Recia en el Puesto Cenarion, en la Península del Fuego Infernal.‡Tuez 8 Ravageurs Roncecroc et 8 Crache-venin Roncecroc, puis retournez voir Mahuram Sabot-robuste au Poste cénarien dans la péninsule des Flammes infernales.‡杀死8只棘牙掠食者和8只棘牙喷毒者，然后返回地狱火半岛的塞纳里奥哨站，向玛霍拉姆·硬蹄复命。‡殺死8隻棘牙劫毀者還有8隻棘牙吐毒者然後回到地獄火半島的塞納里奧前哨找馬琥藍·胖蹄。',
  }
},
[10160] = {
  {
    'Conheça seu inimigo‡Врага нужно знать в лицо‡Den Feind kennen‡적군 파악‡Conoce a tu enemigo‡Conoce a tu enemigo‡Connais ton adversaire‡知己知彼‡了解你的敵人',
    nil,
    'Fale com a Tenente Amadi na velha torre da guarda, logo a oeste da Fortaleza da Honra.‡Поговорите с лейтенантом Амади в старой сторожевой башне на западе Оплота Чести.‡Sprecht mit Leutnant Amadi im alten Wachturm im Westen der Ehrenfeste.‡명예의 요새 바로 서쪽의 오랜 경비탑에 있는 부관 아마디와 대화해야 합니다.‡Habla con la teniente Amadi en la vieja torre vigía justo al oeste del Bastión del Honor.‡Habla con la teniente Amadi en la vieja torre vigía justo al oeste del Bastión del Honor.‡Parlez au lieutenant Amadi à la vieille tour de garde juste à l\'ouest du bastion de l\'Honneur.‡与荣耀堡西部哨塔内的阿曼蒂中尉谈一谈。‡到榮譽堡西方的老舊守衛塔去與阿瑪迪中尉談談。',
  }
},
[10161] = {
  {
    'Em caso de emergência...‡В случае чрезвычайной ситуации...‡Im Notfall...‡긴급 상황‡En caso de emergencia...‡En caso de emergencia...‡En cas d\'urgence...‡以防万一......‡如果情況緊急……',
    nil,
    'Colete 30 peças de Escombros de Zepelim e leve-as para Gritonho Ouvessorte, o "Berrante", no Zepelim Caído.‡Соберите 30 обломков дирижабля и принесите Скриду Многослову по прозвищу "Крикун" на место крушения дирижабля.‡Sammelt 30 Zeppelintrümmer und bringt sie zu "Schreihals" Quack Lufthans bei der Zeppelinabsturzstelle.‡비행선 추락지에 있는 "호들갑쟁이" 스크리드 럭히드에게 비행선 잔해 30개를 가져가야 합니다.‡Consigue 30 restos del zepelín y llévaselas a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Consigue 30 restos del zepelín y llévaselas a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡« Retrouvez 30 Débris de zeppelin et rapportez-les à Laïus « Brailleur » Airbuse à l\'Épave du zeppelin. »‡将30块飞艇碎片交给飞艇坠毁点的"尖嗓子"斯克里·拉克希德。‡收集30個飛艇殘骸，並帶回給飛艇失事地的『驚嘆』史哥利德·幸運心。',
  }
},
[10162] = {
  {
    'Missão: A Prateleira Abissal‡Задание: Косогор Бездны‡Mission: Die Abyssische Untiefe‡임무: 심연의 절벽‡Misión: La Plataforma Abisal‡Misión: La Plataforma Abisal‡Mission : La saillie abyssale‡任务：地狱岩床‡任務:深淵沙洲',
    nil,
    'O Comandante To\'acha do Posto dos Destroços, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по приказу командира передовой То\'арха у останков Сквернобота на полуострове Адского Пламени.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen vernichtet.‡지옥불 반도의 지옥절단기 함락지에 있는 전방사령관 토아크가 간아그 일꾼 20명, 모아그 감독관 5명을 처치하고 지옥 대포 5개를 파괴해 달라고 했습니다.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛机甲残骸的前线指挥官托尔克要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上搶奪者荒野的前線指揮官吐阿奇已經要求你消滅20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10163] = {
  {
    'Missão: A Prateleira Abissal‡Задание: Косогор Бездны‡Mission: Die Abyssische Untiefe‡임무: 심연의 절벽‡Misión: La Plataforma Abisal‡Misión: La Plataforma Abisal‡Mission : La saillie abyssale‡任务：地狱岩床‡任務:深淵沙洲',
    nil,
    'O Comandante de Ala Grifongar do Posto Despedaçado, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по приказу командира звена Грифонгара с Парящей заставы на полуострове Адского Пламени.‡Schwadronskommandant Greifgar im Trümmerposten auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen vernichtet.‡지옥불 반도에 있는 징검다리 거점의 편대사령관 그리폰가르가 간아그 일꾼 20명, 모아그 감독관 5명, 5개의 지옥 대포를 파괴해 달라고 부탁했습니다.‡El comandante del aire Gryphongar del Puesto Devastación, en la Península del Fuego Infernal, ha solicitado que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante del aire Grifongar del Puesto Devastación, en la Península del Fuego Infernal, ha solicitado que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le chef d\'escadrille Griffongar de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛破碎岗哨的空军指挥官格莱芬加尔要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上破碎崗哨的空軍指揮葛萊弗卡爾要你去殺掉20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10164] = {
  {
    'Tudo vai dar pé‡Все будет в порядке‡Alles wird gut‡영혼의 자유를 위하여‡Todo irá bien‡Todo irá bien‡Tout va bien se passer‡一切都会变好的‡一切都會很好',
    nil,
    'O Grão-pai Aldrimus, na entrada das Catacumbas Auchenai de Auchindoun, pede que você entre nas Catacumbas Auchenai e destrua o Exarca Maladaar.‡Проникните в Аукенайские гробницы и уничтожьте экзарха Маладаара по просьбе Великого Отца Алдримуса, который находится снаружи Аукенайских гробниц Аукиндона.‡Großvater Aldrimus außerhalb der Auchenaikrypta von Auchindoun möchte, dass Ihr in die Auchenaikrypta geht und Exarch Maladaar vernichtet.‡아킨둔의 아키나이 납골당 바깥에 서 있는 대부 알드리머스가 아키나이 납골당에 들어가서 총독 말라다르를 해치워달라고 부탁했습니다.‡Abuelo Aldrimus, que está fuera de las Criptas Auchenai de Auchindoun, quiere que entres en las criptas y mates al exarca Maladaar.‡Abuelo Aldrimus, fuera de las Criptas Auchenai en Auchindoun, quiere que entres en las criptas y mates al exarca Maladaar.‡Grandpère Aldrimus, à l\'extérieur des Cryptes Auchenaï d\'Auchindoun, vous a demandé d\'entrer dans les Cryptes Auchenaï et de détruire l\'Exarque Maladaar.‡奥金顿奥金尼地穴外的奥德里姆斯宗父要你进入奥金尼地穴，消灭大主教玛拉达尔。‡站在奧齊頓的奧奇奈地穴外的大祖父阿爾崔瑪斯要你進入奧奇奈地穴並殺掉主教瑪拉達爾。',
  }
},
[10165] = {
  {
    'Minando a concorrência‡Жестокая вещь – конкуренция‡Die Konkurrenz untergraben‡경쟁자 처치‡Eliminar a la competencia‡Eliminar a la competencia‡Casser les prix‡扫除竞争者‡暗殺競爭對手',
    nil,
    'O Príncipe do Nexus Haramad, em frente às Tumbas de Mana, quer que você mate o Príncipe do Nexus Shaffar e lhe traga as Bandagens de Shaffar.‡Убейте принца нексуса Шаффара по просьбе принца нексуса Харамада, находящегося снаружи Гробниц маны, и принесите ему обмотки Шаффара.‡Nexusprinz Haramad außerhalb der Managruft möchte, dass Ihr Nexusprinz Shaffar tötet und ihm Shaffars Bandagen bringt.‡마나 무덤 밖에 있는 연합왕자 하라매드가 연합왕자 샤파르를 해치우고 샤파르의 붕대를 가져다달라고 부탁했습니다.‡El príncipe-nexo Haramad, que está junto a las Tumbas de Maná, quiere que mates al príncipe-nexo Shaffar y le lleves su mortaja.‡El príncipe-nexo Haramad, que está junto a las Tumbas de Maná, quiere que mates al príncipe-nexo Shaffar y le lleves su mortaja.‡Le prince-nexus Haramad, qui se trouve à l\'extérieur des Tombes-mana, veut que vous alliez tuer le prince-nexus Shaffar et que vous lui rapportiez le Cafetan de Shaffar.‡法力陵墓外的节点亲王哈拉迈德要你杀死节点亲王沙法尔，并将沙法尔的护腕带交给他。‡法力墓地外的奈薩斯王子哈拉瑪德要你去殺掉奈薩斯王子薩法爾並將薩法爾裹帶帶回來給他。',
  }
},
[10166] = {
  {
    'Memórias do Cascabranca‡Память о Белостволе‡Weißborkes Erinnerung‡흰나무껍질의 기억‡La memoria de Cortezablanca‡La memoria de Cortezablanca‡La mémoire de Blanchécorce‡怀特巴克的记忆‡白吼的記憶',
    nil,
    'Larianna Fluminéola quer que você ponha o Pingente do Velho Cascabranca ao lado da pedra rúnica na Mata Queimada.‡Заройте подвеску Старого Белоствола у рунического камня в Выжженной роще по просьбе Ларианны Речной Ветер.‡Larianna Flusswind möchte, dass Ihr Weißborkes Anhänger beim Runenstein im versengten Hain vergrabt.‡라리아나 리버윈드가 늙은 흰나무껍질의 목걸이를 불타버린 숲에 있는 마법석 옆에 놓아달라고 부탁했습니다.‡Larianna Ríobrisa quiere que entierres el colgante del viejo Cortezablanca junto a la piedra rúnica de La Arboleda Agostada.‡Larianna Ríobrisa quiere que entierres el colgante del viejo Cortezablanca junto a la piedra rúnica de La Arboleda Agostada.‡Larianna Ruissevent veut que vous placiez le Pendentif du vieux Blanchécorce près de la pierre runique au Bosquet incendié.‡拉莉亚娜·河风要你将怀特巴克的坠饰放在焦痕谷的符石上。‡拉瑞安娜·河風要你在烈焰邊境將老白樹墜飾放置在符文石旁邊。',
  }
},
[10167] = {
  {
    'Auchindoun...‡Аукиндон...‡Auchindoun...‡아킨둔...‡Auchindoun...‡‡Auchindoun...‡奥金顿......‡奧齊頓……',
    nil,
    'Vá até as Catacumbas Auchenai, no Deserto de Ossos da Mata Terokkar, e mate o Exarca Maladaar para libertar o Espírito de D\'ore.‡Отправляйтесь в Аукенайские гробницы в Костяных пустошах леса Тероккар, убейте экзарха Маладаара и освободите дух Д\'оре.‡Reist zur Auchenaikrypta in der Knochenwüste der Wälder von Terokkar und tötet Exarch Maladaar um den Geist von D\'ore zu befreien.‡테로카르 숲의 해골 무덤에 있는 아키나이 납골당으로 가서 총독 말라다르를 처치하고 도레의 영혼을 풀어줘야 합니다.‡Ve a las Criptas Auchenai, en El Vertedero de Huesos del Bosque de Terokkar, y mata al exarca Maladaar para liberar al espíritu de D\'ore.|n‡Ve a las Criptas Auchenai, en El Vertedero de Huesos del Bosque de Terokkar, y mata al exarca Maladaar para liberar al espíritu de D\'ore.|n‡Voyagez jusqu\'aux Cryptes Auchenaï dans le désert des Ossements de la forêt de Terokkar et tuez l’Exarque Maladaar pour libérer l\'esprit de D\'ore.‡前往泰罗卡森林白骨荒野的奥金尼地穴，杀死大主教玛拉达尔，解救德欧里的灵魂。‡前往泰洛卡森林的白骨荒野的奧奇奈地穴，並殺掉主教瑪拉達爾以釋放迪歐瑞的靈魂。',
  }
},
[10168] = {
  {
    'O que a alma vê‡Что видит душа‡Was die Seele sieht‡영혼이 본 것‡Reflejos del alma‡Reflejos del alma‡Par les yeux de l\'âme...‡灵魂之眼‡靈魂看見的',
    nil,
    'Encontre um dos Espelhos da Alma nas Catacumbas Auchenai e use-o para evocar um Espírito Enegrecido de Antepassados Orcs Antigos em Nagrand. Destrua 15 Espíritos Enegrecidos para que os antepassados possam descansar em paz.nnQuando completar a tarefa, retorne à Mãe Kashur, nas Terras Ancestrais, em Nagrand.‡Найдите зеркало Души в Аукенайских гробницах и используйте его, чтобы выманить темного духа из древнего орка-предка в Награнде. Уничтожьте 15 темных духов, чтобы орочьи предки могли упокоиться с миром.nnКогда исполните поручение, возвращайтесь к Матери Кашур в Земли Предков.‡Sucht einen Seelenspiegel in der Auchenaikrypta und benutzt ihn, um einen getrübten Geist eines uralten Orcahnen von Nagrand zu rufen. Zerstört 15 getrübte Geister, damit die Ahnen in Frieden ruhen können.nnKehrt zu Mutter Kashur im Ahnengrund zurück, wenn Ihr fertig seid.‡아키나이 납골당 어딘가에 있는 영혼의 거울을 찾아내십시오. 그런 다음 나그란드의 고대 오크 선조에게 사용해 어둠의 영혼을 불러내야 합니다. 이 어둠의 영혼 15명을 파괴해서 선조들이 편히 잠들게 해주십시오.nn임무를 마치면 선조의 터에 있는 대모 카슈르에게 돌아가십시오.‡Encuentra un espejo de alma en las Criptas Auchenai y úsalo para llamar a un espíritu oscurecido de los antepasados orcos ancestrales en Nagrand. Destruye 15 espíritus oscurecidos para que los antepasados puedan descansar en paz.nnDespués ve a ver a Madre Kashur a las Tierras Ancestrales.‡Encuentra un espejo de alma en las Criptas Auchenai y úsalo para llamar a un espíritu oscurecido de los antepasados orcos ancestrales en Nagrand. Destruye 15 espíritus oscurecidos para que los antepasados puedan descansar en paz.|n|nDespués ve a ver a Madre Kashur a las Tierras Ancestrales.‡Trouvez un Miroir des âmes quelque part dans les cryptes Auchenaï et utilisez-le pour invoquer un Esprit assombri issu des Ancêtres d\'anciens orcs en Nagrand. Détruisez 15 Esprits assombris afin que les ancêtres puissent reposer en paix.nnRetournez voir Mère Kashur dans les Terres ancestrales lorsque vous aurez terminé cette tâche.‡在奥金尼地穴中找到一面灵魂之镜，用它召唤纳格兰上古兽人先祖的黑暗之魂。消灭15个黑暗的灵魂，让兽人先祖得以安然长眠。nn完成任务后，向先祖之地的卡舒尔宗母复命。‡在奧奇奈地穴裡的某處找到一面靈魂之鏡，並且用它召喚來自納葛蘭的古老的獸人元祖的黯淡的靈魂前來。消滅15個黯淡的靈魂好讓那些先祖能夠安息。|n當任務完成後，回到先祖之地的卡修爾母親那裡。',
  }
},
[10169] = {
  {
    'Perdendo com elegância‡Проиграть с честью‡In Würde verlieren‡영예로운 패배‡Saber perder‡Saber perder‡Il faut savoir perdre‡镇静剂‡優雅的失敗',
    nil,
    'O Magíster Falris, em Shattrath, quer que você leve a Ampola de Soro Sedativo até o Terraço da Luz e derrame o conteúdo da ampola na Panela do Regimento de Haronem.‡Вылейте сонную сыворотку в котел Харонема на террасе Света, после чего вернитесь к магистру Фальрису.‡Magister Falris in Shattrath möchte, dass Ihr die Phiole mit Beruhigungsserum zur Terrasse des Lichts bringt und sie in den Kochtopf von Haronems Regiment schüttet.‡샤트라스에 있는 마법학자 팔리스가 진정제가 든 약병을 빛의 정원으로 가져가서 명사수 연대의 요리 냄비에 부어 달라고 했습니다.‡El magister Falris de Shattrath quiere que lleves el vial de suero sedativo a Bancal de la Luz y lo viertas en la olla del regimiento de Haronem.‡El magister Falris de Shattrath quiere que lleves el vial de suero sedativo a Bancal de la Luz y lo viertas en la olla del regimiento de Haronem.‡Le magistère Falris de Shattrath veut que vous apportiez la Fiole de sérum sédatif sur la Terrasse de la Lumière et que vous la versiez dans la Marmite du régiment d\'Haronem.‡沙塔斯城内的魔导师法尔里斯要求你将一瓶镇静剂带去圣光广场，倒入射手队的烹饪锅内。‡撒塔斯城的博學者法爾瑞斯要你帶著瓶裝鎮靜藥水到聖光露臺並且倒入哈洛尼恩的大烹飪鍋。',
  }
},
[10170] = {
  {
    'Retorno à Grande Mãe‡Возвращение к Великой Матери‡Rückkehr zur Großmutter‡대모에게 돌아가기‡Regresa junto a la Abuela‡Regresa junto a la Abuela‡Retourner voir la grande-mère‡返回盖亚安祖母身边‡',
    nil,
    'Vá novamente à Garadar e fale com a Grande Mãe Geyah.‡Возвращайтесь в Гарадар и поговорите с великой матерью Гейей.‡Kehrt nach Garadar zurück und sprecht mit Großmutter Geyah.‡가라다르로 돌아가서 대모 게야와 대화해야 합니다.‡Vuelve a Garadar y habla con la Abuela Geyah.‡Vuelve a Garadar y habla con la Abuela Geyah.‡Retournez à Garadar et parlez à la grande-mère Geyah.‡返回加拉达尔，与盖亚安祖母谈一谈。‡',
  }
},
[10171] = {
  {
    'O chefe inconsolável‡Безутешный Вождь‡Der untröstliche Häuptling‡소심한 족장‡El inconsolable jefe‡El inconsolable jefe‡Le chef inconsolable‡消沉的酋长‡',
    nil,
    'A Grande Mãe Geyah, de Garadar, quer que você fale com Garrosh.‡Поговорите с Гаррошем.‡Großmutter Geyah in Garadar möchte, dass Ihr mit Garrosh sprecht.‡가라다르에 있는 대모 게야가 가로쉬와 대화해 달라고 했습니다.‡La Abuela Geyah en Garadar te ha pedido que hables con Garrosh.‡La Abuela Geyah en Garadar te ha pedido que hables con Garrosh.‡La grande-mère Geyah à Garadar vous a demandé de parler à Garrosh.‡加拉达尔的盖亚安祖母要你去跟加尔鲁什谈一谈。‡',
  }
},
[10172] = {
  {
    'Não há esperanças‡Надежды нет‡Es gibt keine Hoffnung‡희망은 어디에도 없다‡No hay esperanza‡No hay esperanza‡Il n\'y a plus d\'espoir‡毫无希望‡',
    nil,
    'Fale novamente com a Grande Mãe Geyah e relate-lhe o que Garrosh contou para você.‡Вернитесь к Великой Матери Гейе и передайте ей слова Гарроша.‡Sprecht mit Großmutter Geyah und erzählt ihr, was Garrosh Euch gesagt hat.‡대모 게야에게 가로쉬가 한 말을 전해야 합니다.‡Habla con la Abuela Geyah y cuéntale lo que Garrosh te ha dicho.‡Habla con la Abuela Geyah y cuéntale lo que Garrosh te ha dicho.‡Parlez à la grande-mère Geyah et rapportez-lui les propos de Garrosh.‡将加尔鲁什所说的话转告给盖亚安祖母。‡',
  }
},
[10173] = {
  {
    'O cajado do arquimago‡Посох верховного мага‡Der Stab des Erzmagiers‡대마법사의 지팡이‡El bastón del archimago‡El bastón del archimago‡Le bâton de l\'archimage‡大法师的法杖‡大法師之杖',
    nil,
    'Recupere o Cajado do Arquimago Vargoth de Ekkorash, a Inquisidora e traga-o a Ravandwyr, na Área 52. Para tirar Ekkorash de seu esconderijo, espalhe o pó conjurador no braseiro no centro das ruínas.‡Отнимите посох верховного мага Варгота у Эккораш Инквизитора и принесите Равандвиру в Зону 52. Чтобы выманить Эккораш из укрытия, бросьте волшебный порошок на жаровню в центре руин.‡Besorgt Erzmagier Vargoths Stab von Ekkorash der Inquisitorin und bringt ihn zu Ravandwyr in Area 52. Um Ekkorash aus ihrem Versteck hervorzulocken, streut das Beschwörungspulver auf die Kohlenpfanne in der Mitte der Ruinen.‡에코라쉬로부터 대마법사 바르고스의 지팡이를 되찾은 다음 52번 구역에 있는 라반드위르에게 가져가야 합니다. 숨어 있는 에코라쉬를 불러내려면 폐허 중앙에 있는 화로에 창조의 가루를 뿌려야 합니다.‡Quítale el bastón del archimago Vargoth a Ekkorash la Inquisidora y llévaselo a Ravandwyr al Área 52. Para sacar a Ekkorash de su escondite, espolvorea el polvo de conjuro en el blandón que hay en el centro de las ruinas.‡Quítale el bastón del archimago Vargoth a Ekkorash la Inquisidora y llévaselo a Ravandwyr al Área 52. Para sacar a Ekkorash de su escondite, espolvorea el polvo de conjuro en el blandón que hay en el centro de las ruinas.‡Reprenez le Bâton de l\'archimage Vargoth à Ekkorash l\'Inquisitrice et apportez-le à Ravandwyr dans la Zone 52. Pour faire sortir Ekkorash de sa cachette, répandez la Poudre d\'abjuration sur le brasero au centre des ruines.‡从审讯者埃克拉斯手中夺得大法师瓦格斯的法杖，将它交给52区的拉文德维尔。要使埃克拉斯从藏身处现身，你需要向遗迹中心的火盆喷撒召唤粉尘。‡從『審判官』艾克爾拉斯那裡取回大法師瓦戈斯之杖，並且將它帶去給52區的羅樊德威。為了讓艾克爾拉斯現身，把喚魔粉末撒在在廢墟中心的火盆上。',
  }
},
[10174] = {
  {
    'A maldição da Torre Violeta‡Проклятие Аметистовой башни‡Der Fluch des violetten Turms‡보랏빛 탑의 저주‡La maldición de la Torre Violeta‡La maldición de la Torre Violeta‡La malédiction de la Tour pourpre‡紫罗兰之塔的诅咒‡紫羅蘭之塔的詛咒',
    nil,
    'Use o Cajado do Arquimago Vargoth para contatá-lo.nnSe perder o cajado, fale com Ravandwyr, na Área 52, para substituí-lo.‡Используйте посох верховного мага Варгота, чтобы связаться с верховным магом Варготом.nnЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром в Зоне 52, чтобы получить замену.‡Benutzt Erzmagier Vargoths Stab um Kontakt mit Erzmagier Vargoth aufzunehmen.nnFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡대마법사 바르고스의 지팡이를 사용하여 대마법사 바르고스와 접촉을 시도해야 합니다.nn대마법사 바르고스의 지팡이를 잃어버리면, 52번 구역에 있는 라반드위르와 대화하여 새로 얻으십시오.‡Utiliza el bastón del archimago Vargoth para contactar con él.nnSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr en el Área 52 para que te dé otro.‡Utiliza el bastón del archimago Vargoth para contactar con él.|n|nSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr en el Área 52 para que te dé otro.‡Utilisez le Bâton de l\'archimage Vargoth pour entrer en contact avec ce dernier.nnSi vous perdez le Bâton de l’archimage Vargoth, allez voir Ravandwyr dans la Zone 52 pour obtenir un double.‡利用大法师瓦格斯的法杖与他取得联系。nn如果你弄丢了大法师瓦格斯的法杖，可以向52区的拉文德维尔再要一根。‡使用大法師瓦戈斯之杖與大法師瓦戈斯連絡。|n如果你遺失了大法師瓦戈斯之杖，可以跟52區的羅樊德威談談取得一個替代品。',
  }
},
[10175] = {
  {
    'Thrall, Son of Durotan‡Тралл, сын Дуротана‡Thrall, Sohn Durotans‡‡Thrall, hijo de Durotan‡Thrall, hijo de Durotan‡Thrall, fils de Durotan‡萨尔，杜隆坦之子‡',
    nil,
    'Venture to Orgrimmar and deliver Geyah\'s message to Thrall.‡Отправляйтесь в Оргриммар и передайте Траллу сообщение от Гейи.‡Reist nach Orgrimmar und überbringt Thrall Geyahs Nachricht.‡‡Ve a Orgrimmar y entrega a Thrall el mensaje de Geyah.‡Ve a Orgrimmar y entrega a Thrall el mensaje de Geyah.‡Rendez-vous à Orgrimmar et apportez le message de Geyah à Thrall.‡前往奥格瑞玛，将盖亚安祖母的口信告诉萨尔。‡',
  }
},
[10176] = {
  {
    'Ar\'kelos, o guardião‡Страж Ар\'келос‡Ar\'kelos der Wächter‡수호자 알켈로스‡Ar\'kelos el Guardián‡Ar\'kelos el Guardián‡Ar\'kelos le Gardien‡守护者阿尔凯洛斯‡守護者阿其羅斯',
    nil,
    'Entre na Torre Violeta, no centro da Vila Kirin\'Var e derrote Ar\'kelos, em seguida fale com Arquimago Vargoth.‡Войдите в Аметистовую башню, расположенную в центре деревни Кирин\'Вар, и победите Ар\'келоса, затем поговорите с верховным магом Варготом.‡Betretet den violetten Turm in der Mitte von Kirin\'Var und besiegt Ar\'kelos. Sprecht danach mit Erzmagier Vargoth.‡키린바르 마을의 중앙에 있는 보랏빛 탑에 들어가서 알켈로스를 처치한 다음 대마법사 바르고스와 대화해야 합니다.‡Entra en la Torre Violeta en el centro del Poblado Kirin\'Var y derrota a Ar\'kelos. A continuación, habla con el archimago Vargoth.‡Entra en la Torre Violeta en el centro del Poblado Kirin\'Var y derrota a Ar\'kelos. A continuación, habla con el archimago Vargoth.‡Entrez dans la Tour pourpre au centre de Kirin\'Var et triomphez d\'Ar\'kelos, puis parlez à l\'archimage Vargoth.‡进入肯瑞瓦村中心的紫罗兰之塔，击败阿尔凯洛斯，然后与大法师瓦格斯谈一谈。‡進入肯瑞瓦村莊中心的紫蘿蘭之塔打敗阿其羅斯，完成後與大法師瓦戈斯談談。',
  }
},
[10177] = {
  {
    'Problemas em Auchindoun‡В Аукиндоне неспокойно‡Ärger in Auchindoun‡아킨둔의 문제‡Problemas en Auchindoun‡Problemas en Auchindoun‡Troubles à Auchindoun‡奥金顿的麻烦‡奧齊頓的麻煩',
    nil,
    'Apresente-se ao Comandante de Campo Mahfuun na entrada do Labirinto Soturno em Auchindoun, na Mata Terokkar.‡Доложите о своем прибытии боевому командиру Мафууну, который находится неподалеку от входа в Темный Лабиринт в Аукиндоне в Лесу Тероккар.‡Meldet Euch bei Feldkommandeur Mahfuun beim Eingang zum Schattenlabyrinth in Auchindoun in den Wäldern von Terokkar.‡테로카르 숲, 아킨둔의 어둠의 미궁 입구에 있는 총독 마수드에게 보고하십시오.‡Preséntate ante el comandante de campo Mahfuun en la entrada del Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Preséntate ante el comandante de operaciones Mahfuun en la entrada del Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Présentez-vous au commandant Mahfuun à l\'entrée du Labyrinthe des ombres à Auchindoun dans la forêt de Terokkar.‡前往泰罗卡森林的奥金顿，向暗影迷宫入口处的战地指挥官玛弗恩报到。‡向泰洛卡森林裡奧齊頓的暗影迷宮入口處的戰場元帥瑪赫范報到。',
  }
},
[10178] = {
  {
    'Encontrar o espião To\'gun‡Найти шпиона То\'гуна!‡Findet Spion To\'gun‡비밀요원 토군 찾기‡Encontrar al espía To\'gun‡Encontrar al espía To\'gun‡Trouver l\'espion To\'gun‡寻找间谍托古恩‡找尋間諜·吐剛',
    nil,
    'Encontre o Espião To\'gun no Labirinto Soturno de Auchindoun.‡Найдите шпиона То\'гуна в Темном лабиринте в Аукиндоне.‡Findet Spion To\'gun im Schattenlabyrinth von Auchindoun.‡아킨둔에 있는 어둠의 미궁에서 비밀요원 토군을 찾아야 합니다.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Trouvez l\'espion To\'gun dans le Labyrinthe des ombres d\'Auchindoun.‡进入奥金顿的暗影迷宫，寻找间谍托古恩的下落。‡在奧齊頓的暗影迷宮裡找到間諜·吐剛。',
  }
},
[10179] = {
  {
    'O zelador de Kirin\'Var‡Смотритель Кирин\'Вара‡Der Hüter von Kirin\'Var‡키린바르의 관리인‡El custodio de Kirin\'Var‡‡Le protecteur de Kirin\'Var‡肯瑞瓦村的管理者‡肯瑞瓦的管理者',
    nil,
    'Fale com o Zelador Dieworth, na Vila Kirin\'Var, em Eternévoa.‡Поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sprecht mit Hüter Dierwert in Kirin\'Var im Nethersturm.‡황천의 폭풍의 키린바르 마을에 있는 관리인 디워스와 대화해야 합니다.‡Habla con el custodio Valemuerte en el Poblado Kirin\'Var, en Tormenta Abisal.‡‡Parlez au Protecteur Valemort à Kirin\'Var.‡与虚空风暴肯瑞瓦村的管理者戴沃斯谈一谈。‡與肯瑞瓦村莊的管理者戴沃斯談談。',
  }
},
[10180] = {
  {
    'Isfar não desiste‡Неудержимый‡Kann es einfach nicht lassen‡둘도 없는 오누이‡No puedo estar lejos‡No puedo estar lejos‡Incapable de rester à l\'écart‡无法袖手旁观‡無法置身事外',
    nil,
    'Fale com Isfar, que se encontra nos Salões dos Sethekk em Auchindoun.‡Поговорите с Исфаром, которого можно найти неподалеку от входа в Сетеккские залы в Аукиндоне.‡Sprecht mit Isfar beim Eingang zu den Sethekkhallen in Auchindoun.‡아킨둔의 세데크 전당 입구 근처에서 이스파르를 찾아 대화하십시오.‡Habla con Isfar. Le encontrarás cerca de la entrada de las Salas Sethekk en Auchindoun.‡Habla con Isfar. Le encontrarás en las Salas Sethekk en Auchindoun.‡Parlez à Isfar, qui se trouve près de l\'entrée des salles des Sethekk à Auchindoun.‡与奥金顿塞泰克大厅入口附近的伊斯法尔谈一谈。‡與伊斯法談談，你可以在奧齊頓的塞斯克大廳入口附近找到他。',
  }
},
[10182] = {
  {
    'Mago de Batalha Dathric‡Боевой маг Датрик‡Kampfmagier Dathric‡전투마법사 다스릭‡Mago de batalla Dathric‡Mago de batalla Dathric‡Le mage de bataille Dathric‡战斗法师达斯利克‡戰場法師達斯立克',
    nil,
    'Encontre o alojamento do Mago de Batalha Dathric no Estreito do Teurgo e retorne-a ao cavalete de armas. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты боевого мага Датрика в переулке Волшебников и верните меч в оружейную стойку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Kampfmagier Dathric in der Zaubergasse und bringt die Klinge zurück in sein Waffenregal. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡다스릭의 검을 가지고 마법사 지구에 있는 전투마법사 다스릭의 집으로 가서 다스릭의 무기 선반에 놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias del mago de batalla Dathric y devuelve la espada al expositor. A continuación habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias del mago de batalla Dathric en el Pasaje del Zahorí y devuelve la espada al expositor. A continuación habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile du mage de bataille Dathric dans l\'Allée des sorciers et replacez sa Lame sur le râtelier d\'armes. Puis parlez au protecteur Valemort à Kirin Var.‡在巫师街内找到战斗法师达斯利克的家，将剑放回他的武器架上。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到戰場法師達斯立克的駐紮處將劍放回他的武器架。完成之後，與肯瑞瓦村莊的管理者戴沃斯談談。',
  }
},
[10183] = {
  {
    'Para a Área 52‡В Зону 52‡Auf nach Area 52‡52번 구역으로 출발‡A la Área 52‡Al Área 52‡En route pour la Zone 52‡前往52区‡前往52區',
    nil,
    'Entregue as Anotações do Eterologista ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Передайте записки пустолога ведущему ракетостроителю Фьюзеляжу, находящемуся в Зоне 52 в Пустоверти.‡Bringt die Notizen des Netheorologen zu Raketenchef Doppeldecker in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 황천전문가의 쪽지를 가져가야 합니다.‡Lleva las notas del abisólogo al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Lleva las notas del abisólogo al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Apportez les Notes du néantologue au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将虚空学家的笔记交给虚空风暴52区的火箭主管弗斯拉格。‡遞送虛空學家的手記給虛空風暴52區的火箭主管夫斯拉吉。',
  }
},
[10184] = {
  {
    'Reminiscências malévolas‡Зловещие останки‡Bösartige Überbleibsel‡원한을 가진 영혼들‡Restos malévolos‡Restos malévolos‡Vestiges malveillants‡狂暴的幽灵‡惡意的倖存者',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você derrote 20 Espíritos Cindidos na Praça da Cidade de Kirin\'Var.‡Смотритель Дайворт в деревне Кирин\'Вар просит вас победить 20 покалеченных духов на площади Кирин\'Вара.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr 20 abtrünnige Geister auf dem Ratsplatz tötet.‡키린바르 마을에 있는 관리인 디워스가 마을 광장에 있는 떠도는 원혼 20명을 처치해 달라고 했습니다.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 20 espíritus aislados en la Plaza de la Ciudad de Kirin\'Var.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 20 espíritus aislados en la Plaza de la Ciudad de Kirin\'Var.‡Le protecteur Valemort de Kirin\'Var veut que vous vainquiez 20 Esprits disjoints de la Place centrale de Kirin\'Var.‡肯瑞瓦村的管理者戴沃斯要求你去肯瑞瓦村广场消灭20个被杀死的幽魂。‡肯瑞瓦村莊的管理者戴沃斯要你去肯瑞瓦的小鎮廣場殺掉20個分離的靈魂。',
  }
},
[10185] = {
  {
    'Uma sina pior do que a morte‡Участь хуже, чем смерть‡Schlimmer als der Tod‡죽음보다 더한 운명‡Terrible destino‡Terrible destino‡Un sort pire que la mort‡悲惨的命运‡比死還糟的命運',
    nil,
    'Mate 10 Matamagos e 10 Caçadores de Mana e fale novamente com o Zelador Dieworth, na vila Kirin\'Var.‡Убейте 10 убийц магов и 10 искателей маны и вернитесь к смотрителю Дайворту в деревню Кирин\'Вар.‡Tötet 10 Magiertöter und 10 Manasucher und kehrt zu Hüter Dierwert in Kirin\'Var zurück.‡마법사 학살자 10명, 마나 추적자 10명을 처치한 다음 키린바르 마을에 있는 관리인 디워스에게 가야 합니다.‡Mata a 10 matamagos y 10 buscamanás y ve a ver al custodio Valemuerte al Poblado Kirin\'Var.‡Mata a 10 matamagos y 10 buscamanás y ve a ver al custodio Valemuerte al Poblado Kirin\'Var.‡Tuez 10 Pourfend-mage et 10 Chercheurs de mana puis retournez voir le protecteur Valemort à Kirin\'Var.‡杀死10个法师杀手和10个法力搜寻者，然后向肯瑞瓦村的管理者戴沃斯复命。‡殺掉10個法師殺手及10個法力尋找者後回到肯瑞瓦村莊找管理者戴沃斯。',
  }
},
[10186] = {
  {
    'Você foi convocado!‡Тебя наняли!‡Ihr seid eingestellt!‡B.O.O.M의 일원!‡¡Te contrato!‡¡Te contrato!‡On vous engage !‡你被雇了！‡你被雇用了!',
    nil,
    'Colete 10 Cristais da Matriz de Eterlítio e leve-os ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Соберите 10 астраллитиевых матричных кристаллов и принесите их ведущему ракетостроителю Фьюзеляжу в Зону 52 в Пустоверти.‡Sammelt 10 Astrallithiummatrixkristalle und kehrt dann zu Raketenchef Doppeldecker in Area 52 im Nethersturm zurück.‡에테리시움 맥석 수정 10개를 수집한 후에 황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 돌려주어야 합니다.‡Reúne 10 cristales de la matriz de eterlitio y vuelve a ver al jefe de cohetes Fuselaje en el Área 52 en la Tormenta Abisal.‡Reúne 10 cristales de la matriz de eterlitio y vuelve a ver al jefe de cohetes Fuselaje en el Área 52 en la Tormenta Abisal.‡Ramassez 10 Cristaux de matrice d\'etherlithium et apportez-les au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将10块以太锂矩阵水晶交给虚空风暴52区的火箭主管弗斯拉格。‡收集10個伊斯利母體水晶，然後帶回虛空風暴的52區交給火箭主管夫斯拉吉。',
  }
},
[10187] = {
  {
    'Uma mensagem para o arquimago‡Послание для верховного мага‡Eine Nachricht für den Erzmagier‡대마법사에게 전할 전갈‡Mensaje del archimago‡‡Un message pour l\'archimage‡给大法师的消息‡給大法師的訊息',
    nil,
    'Fale com o Arquimago Vargoth, no topo da Torre Violeta, em Eternévoa.‡Поговорите с Верховным магом Варготом на вершине Сиреневой башни.‡Sprecht mit Erzmagier Vargoth im Violetten Turm im Nethersturm.‡황천의 폭풍, 보랏빛 탑의 꼭대기에 있는 대마법사 바르고스와 대화해야 합니다.‡Habla con el archimago Vargoth en la cima de la Torre Violeta, en Tormenta Abisal.‡‡Parlez à l\'archimage Vargoth en haut de la Tour pourpre.‡与虚空风暴紫罗兰之塔塔顶的大法师瓦格斯谈一谈。‡到紫蘿蘭之塔的頂端與大法師瓦戈斯對話。',
  }
},
[10188] = {
  {
    'O signo de Krasus‡Печать Краса‡Das Siegel von Krasus‡크라서스의 인장‡El Sigilo de Krasus‡El sigilo de Krasus‡Le cachet de Krasus‡克拉苏斯的魔符‡卡薩斯符印',
    nil,
    'Recupere o signo de Krasus da Mesmerizadora Mariana, em Manaforja Coruu, a noroeste da Torre Violeta.‡Заберите печать Краса у заклинательницы Марианы, находящейся в манагорне Коруу, к северо-востоку от Аметистовой башни. Когда вы получите печать, используйте посох верховного мага Варгота, чтобы вызвать проекцию верховного мага Варгота и сообщить ему о том, как подвигается дело.nnЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром, находящимся в Зоне 52, чтобы получить замену.‡Holt Euch das Siegel von Krasus von Zauberbinderin Maryana in der Manaschmiede Coruu, nordwestlich vom violetten Turm. Wenn Ihr das Siegel bekommen habt, benutzt Erzmagier Vargoths Stab, um ein Bild von ihm zu rufen und ihn über Eure Fortschritte zu informieren.nnFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡보랏빛 탑의 북서쪽 코루 마나괴철로에 있는 역술사 말야나에게서 크라서스의 인장을 되찾아야 합니다.‡Quítale el sigilo de Krasus a la vinculahechizos Maryana en la Forja de Maná Coruu, al noroeste de la Torre Violeta. Cuando tengas el sigilo, usa el bastón del archimago Vargoth para proyectar una imagen del archimago Vargoth e informarle de tus progresos.nnSi pierdes el bastón del archimago, ve a ver a Ravandwyr en el Área 52 para que te dé otro.‡‡Reprenez le Cachet de Krasus à la Lieuse de sort Maryana à la Manaforge Coruu, au nord-ouest de la Tour Pourpre.‡前往紫罗兰之塔西北方的法力熔炉：库鲁恩，从缚法者玛亚纳手中夺得克拉苏斯的魔符。然后使用大法师瓦格斯的法杖投射出大法师瓦格斯的影像，告诉他目前的进展。nn如果你不小心弄丢了大法师瓦格斯的法杖，可以向52区的拉文德维尔再要一根。‡從法力熔爐寇魯的縛法者瑪莉安娜那取得卡薩斯符印，就在紫羅蘭之塔的西北方。在你拿到這個符印後，使用大法師瓦戈斯之杖投射出大法師瓦戈斯的影像，告訴他你的進度。|n如果你遺失了大法師瓦戈斯之杖，可以和52區的羅樊德威談談取得一個替代品。',
  }
},
[10189] = {
  {
    'Manaforja B\'naar‡Манагорн Б\'наар‡Manaschmiede B\'naar‡브나르 마나괴철로‡Forja de Maná B\'naar‡Forja de Maná B\'naar‡Manaforge B\'naar‡法力熔炉：布纳尔‡法力熔爐巴納爾',
    nil,
    'O Mestre Espião Thalodien, na Área 52, quer que você vá às adjacências de Manaforja B\'naar e consiga a Lista de Funcionários de B\'naar do Capitão Arathyn.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Патрон шпионов Талодиен, находящийся в Зоне 52, хочет, чтобы вы направились в окрестности манагорна Б\'наар и отобрали список персонала манагорна Б\'наар у капитана Аратина.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Spionagemeister Thalodien in Area 52 möchte, dass Ihr zum Rand der Manaschmiede B\'naar geht und die Stammrolle von B\'naar von Hauptmann Arathyn besorgt.nnDas Abschließen von Aufgaben für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 첩보단장 탈로디엔이 브나르 마나괴철로의 외곽으로 가서 대장 아라신으로부터 브나르 개인 신상 명부를 입수해 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y recuperes lista de personal de B\'naar del capitán Arathyn.nnA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y recuperes lista de personal de B\'naar del capitán Arathyn.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Le maître-espion Thalodien de la Zone 52 veut que vous vous rendiez dans les environs de la manaforge B\'naar et que vous récupériez le Tableau de service du personnel de B\'naar sur le capitaine Arathyn.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡52区的间谍大师萨罗迪恩要你从法力熔炉：布纳尔外的阿拉森上尉手中夺得布纳尔人员名册。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡52區的間諜大師薩洛迪恩要你去法力熔爐巴納爾的外圍從阿拉斯恩上尉身上取得巴納爾員工名冊。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10190] = {
  {
    'Recarregar as baterias‡Перезарядка батарей‡Batterien aufladen‡전지 충전‡Recargando las baterías‡Recargando las baterías‡Recharger les batteries‡电池充电‡補充電源',
    nil,
    'Use o disparador de recarga de bateria nos caçadores dimensionais até chegar ao nível 10 de recarga da bateria. Em seguida, leve-o à Especialista em Robôs Alley, nas Ruínas Enkaat, em Eternévoa.‡Используйте зарядное устройство для батарей применительно к достаточному количеству внепространственных охотников, чтобы довести зарядку батарей до уровня 10. Затем вернитесь к роботехнику Элли в руины Энкаата в Пустоверти.‡Benutzt den Batterieladeblaster bei genügend Phasenjägern, um den Batterieladestatus auf 10 zu bringen. Bringt die Batterie danach zu Bot-Spezialistin Alley in den Ruinen von Enkaat im Nethersturm zurück.‡차원의 마나 거머리들에게 전지 충전 광선총을 사용해서 전지 충전 레벨을 10까지 올린 후, 황천의 폭풍의 엔카트 폐허에 있는 로봇 전문가 앨리에게 돌려줘야 합니다.‡Usa la carga reponbatería en suficientes cazadores de fase para que el nivel de carga suba a 10. Regresa entonces junto a la especialista en robots Alley, en las Ruinas de Enkaat, en Tormenta Abisal.‡Usa la carga reponbatería en suficientes cazadores de fase para que el nivel de carga suba a 10. Regresa entonces junto a la especialista en robots Alley, en las Ruinas de Enkaat, en Tormenta Abisal.‡Utilisez la Pétoire charge-batterie sur assez de chasseurs phasiques pour faire monter le niveau de recharge de la batterie jusqu\'à 10. Ensuite, rapportez-la à la robotologue Alley aux ruines d\'Enkaat au Raz-de-Néant.‡对相位猎手使用电池充能器，直到电池充能等级到达10。然后将它交给虚空风暴恩卡特废墟的机器人专家艾蕾。‡將充電火槍使用在足夠的相位捕獵者身上直到電池蓄電量達到10。之後將它帶回虛空風暴的安卡特廢墟交給機器人專家艾里。',
  }
},
[10191] = {
  {
    'Mass v5.0 está vivo!‡Робот модели V жив!‡Nummer V lebt!‡막스 A. 밀리언 Mk. V 가동!‡¡Mark V está vivo!‡¡Mark V está vivo!‡Le Mod. V vit !‡麦克斯米林V型活了！‡充滿動力的馬克斯五號',
    nil,
    'Escolte Mass I. Mo v5.0 pelas Ruínas de Enkaat. Em seguida, fale com a Especialista em Robôs Alley do lado de fora das Ruínas de Enkaat, em Eternévoa.‡Сопроводите "Маккса А. Миллиона V" через руины Энкаата и обратно, обеспечив ему безопасность. Потом поговорите с роботехником Элли за пределами руин Энкаата в Пустоверти.‡Begleitet Maxx E. Million Nr. V durch die Ruinen von Enkaat und wieder in Sicherheit. Sprecht dann mit Bot-Spezialistin Alley außerhalb der Ruinen von Enkaat im Nethersturm.‡막스 A. 밀리언 Mk. V가 무사히 엔카트 폐허를 통과한 후에 일을 마치고 무사히 빠져나올 수 있도록 호위한 후, 황천의 폭풍의 폐허 바로 밖에 있는 로봇 전문가 앨리와 대화해야 합니다.‡Escolta el Maxx Y. Millón Mk. V a través de las Ruinas de Enkaat y llévalo hasta un lugar seguro. Después habla con la especialista en robots Alley, en las afueras de las Ruinas de Enkaat en Tormenta Abisal.‡Escolta el Maxx Y. Millón nº. V a través de las Ruinas de Enkaat y llévalo hasta un lugar seguro. Después habla con la especialista en robots Alley, en las afueras de las Ruinas de Enkaat en Tormenta Abisal.‡Escortez le Maxx A. Million Mod. V dans les ruines d\'Enkaat jusqu\'à son retour en sécurité. Ensuite, allez voir la robotologue Alley à la sortie des ruines d\'Enkaat au Raz-de-Néant.‡护送麦克斯米林V型穿越恩卡特废墟并返回安全地带，然后与虚空风暴恩卡特废墟外的机器人专家艾蕾谈一谈。‡護送馬克斯A型機器人五號通過安卡特廢墟並安全的回來。完成後與在虛空風暴的安卡特廢墟外的機器人專家艾里談談。',
  }
},
[10192] = {
  {
    'O compêndio de Krasus‡Компендиум Краса‡Krasus\' Kompendium‡크라서스의 개론‡El Compendio de Krasus‡El Compendio de Krasus‡Le compendium de Krasus‡克拉苏斯的魔法纲要‡卡薩斯的手冊',
    nil,
    'Reclame os capítulos 1, 2 e 3 do Compêndio de Krasus na Praça da Cidade da Vila Kirin\'Var.‡Заберите первую, вторую и третью главы компендиума Краса с главной площади деревни Кирин\'Вар. Затем используйте посох верховного мага Варгота, чтобы связаться с верховным магом.nnЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром, находящимся в Зоне 52, чтобы получить замену.‡Holt Euch Krasus\' Kompendium - Kapitel 1, Krasus\' Kompendium - Kapitel 2 und Krasus\' Kompendium - Kapitel 3 vom Ratsplatz von Kirin\'Var. Benutzt Erzmagier Vargoths Stab um den Erzmagier zu kontaktieren, wenn Ihr die Kapitel zusammen habt.nnFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡보랏빛 탑의 지하 근처의 키린바르 마을의 광장에서 크라서스의 개론 - 1장, 크라서스의 개론 - 2장, 크라서스의 개론 - 3장을 되찾아야 합니다.‡Recoge el Compendio de Krasus - Capítulo 1, el Compendio de Krasus - Capítulo 2 y el Compendio de Krasus - Capítulo 3 de la plaza del Poblado Kirin\'Var. Usa el bastón del archimago Vargoth para contactar con el archimago una vez que tengas los capítulos.nnSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr, en el Área 52, para que te dé otro.‡‡Récupérez le Compendium de Krasus - Chapitre 1, le Compendium de Krasus - Chapitre 2 et le Compendium de Krasus - Chapitre 3 sur la Place centrale de Kirin\'Var.‡前往肯瑞瓦村的城镇广场，收集克拉苏斯的魔法纲要 - 第一章，克拉苏斯的魔法纲要 - 第二章和克拉苏斯的魔法纲要 - 第三章。集齐3个章节后利用大法师瓦格斯的法杖与大法师取得联系。nn如果你不小心弄丢了大法师瓦格斯的法杖，可以向52区的拉文德维尔再要一根。‡從肯瑞瓦村莊的小鎮廣場取回卡薩斯的手冊 - 第一章，卡薩斯的手冊 - 第二章，和卡薩斯的手冊 - 第三章。拿到所有章節後使用大法師瓦戈斯之杖與大法師連絡。',
  }
},
[10193] = {
  {
    'Cabeças valiosas‡Высокие цели‡Hochrangige Ziele‡만만찮은 목표물‡Objetivos de gran valor‡Objetivos de gran valor‡Cibles majeures‡有价值的目标‡高重要性的目標',
    nil,
    'O Mestre Espião Thalodien, na Área 52, quer que você vá a Manaforja B\'naar e mate 2 Mestres Dimensionais Solfúria, 6 Engenheiros Dimensionais Solfúria e 8 Geólogos Solfúria.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Патрон шпионов Талодиен, находящийся в Зоне 52, просит вас отправиться в манагорн Б\'наар и убить 2 мастеров пространственных искривлений, 6 инженеров пространственных искривлений и 8 геологов из клана Ярости Солнца.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Spionagemeister Thalodien in Area 52 möchte, dass Ihr in die Manaschmiede B\'naar geht und 2 Warpmeister des Sonnenzorns, 6 Warpingenieure des Sonnenzorns und 8 Geologen des Sonnenzorns tötet.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 첩보단장 탈로디엔이 브나르 마나괴철로로 가서 성난태양 초공간 감독관 2명, 성난태양 초공간 기술자 6명과 성난태양 지질학자 8명을 처치해 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y mates 2 maestros de distorsión Furia del Sol, 6 ingenieros de distorsión Furia del Sol y 8 geólogos Furia del Sol.nnCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y mates 2 maestros de distorsión Furia del Sol, 6 ingenieros de distorsión Furia del Sol y 8 geólogos Furia del Sol.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Le maître-espion Thalodien de la Zone 52 veut que vous alliez à la manaforge B\'naar pour y tuer 2 Maîtres-dimensionnels solfurie, 6 Ingénieurs dimensionnels solfurie et 8 Géologues solfurie.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡52区的间谍大师萨罗迪恩要你进入法力熔炉：布纳尔，杀死2名日怒空间主宰、6名日怒迁跃技师和8名日怒地质学家。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡52區的間諜大師薩洛迪恩要你去法力熔爐巴納爾殺掉2個日怒星移管理者，6個日怒星移工程師以及8個日怒地理學家。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10194] = {
  {
    'Voo furtivo‡Незаметный полет‡Heimlicher Flug‡은밀한 비행‡Vuelo sigiloso‡Vuelo sigiloso‡Vol furtif‡隐秘飞行‡隱形飛行',
    nil,
    'Fale com Veronia do lado de fora da Área 52 e voe para Manaforja Coruu.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Поговорите с Веронией, находящейся за пределами Зоны 52, и летите к манагорну Коруу.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Sprecht mit Veronia außerhalb von Area 52 und fliegt zur Manaschmiede Coruu.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 밖에 있는 베로니아와 대화하여 코루 마나괴철로로 날아가야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Habla con Veronia fuera del Área 52 y vuela hasta Forja de Maná Coruu.nnCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Habla con Veronia fuera del Área 52 y vuela hasta Forja de Maná Coruu.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Parlez à Veronia à l\'extérieur de la Zone 52 et volez jusqu\'à la manaforge Coruu.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡与52区外的维罗妮娅谈一谈，她会安排你飞往法力熔炉：库鲁恩。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡與52區外的維納妮雅交談並飛往法力熔爐寇魯。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10195] = {
  {
    'Mercenário vê, mercenário faz‡Наемник видит, наемник делает‡Söldner sieht, Söldner handelt‡‡Sombrero veo, sombrero quiero‡‡Mercenaire voir, mercenaire faire‡‡',
    nil,
    'Traga 30 Penas de Arakkoa para Ros\'eleth na Fortaleza Alleriana.‡Принесите 30 перьев араккоа Роз\'алете в Бастион Аллерии.‡Bringt 30 Arakkoafedern zu Ros\'eleth in Allerias Feste.‡‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Apportez 30 Plumes d\'arakkoa à Ros\'eleth au Bastion allérien.‡‡',
  }
},
[10196] = {
  {
    'Mais penas de arakkoa‡Больше перьев араккоа‡Mehr Arakkoafedern‡‡Más plumas de arakkoa‡‡Plus de plumes d\'arakkoa‡‡更多的阿拉卡羽毛',
    nil,
    'Traga 30 Penas de Arakkoa para Malkaz, na Vila de Quebrapedra.‡Принесите 30 перьев араккоа Малуказу в Форт Камнеломов.‡Bringt 30 Arakkoafedern zu Malukaz in der Steinbrecherfeste.‡‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Apportez 30 Plumes d\'arakkoa à Malukaz au fort des Brise-pierres.‡‡帶30根阿拉卡羽毛給碎石堡的瑪魯卡茲。',
  }
},
[10197] = {
  {
    'Disfarce convincente‡Убедительная маскировка‡Eine überzeugende Verkleidung‡그럴싸한 변장‡Un disfraz convincente‡Un disfraz convincente‡Un déguisement convaincant‡以假乱真‡具說服力的偽裝',
    nil,
    'Obtenha o seguinte conjunto: Vestes de Arcanista Solfúria, um par de Luvas do Pesquisador Solfúria e um Medalhão do Guarda Solfúria e leve-os a Caledis Albafulgis, em Manaforja Coruu, em Eternévoa.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Добудьте комплект одеяний чародея из армии Ярости Солнца, одну пару перчаток ученого из армии Ярости Солнца и медальон охранника из армии Ярости Солнца и принесите все это Каледису Сияющему Рассвету в манагорн Коруу в Пустоверти.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Bringt ein Set Arkanistenroben des Sonnenzorns, ein Paar Forscherhandschuhe des Sonnenzorns und ein Gardistenmedaillon des Sonnenzorns zu Caledis Morgenhell bei der Manaschmiede Coruu im Nethersturm.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 연구원 장갑 한 쌍, 성난태양 보초병 목걸이 1개, 그리고 성난태양 신비술사 로브 한 벌을 입수한 후 황천의 폭풍의 코루 마나괴철로에 있는 캘디스 브라이트돈에게 가져가야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Consigue las togas de arcanista Furia del Sol, un par de guantes de investigador Furia del Sol y un medallón de custodio Furia del Sol y entrégaselos a Caledis Alba Brillante, en Forja de Maná Coruu de Tormenta Abisal.nnCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Consigue las togas de arcanista Furia del Sol, un par de guantes de investigador Furia del Sol y un medallón de custodio Furia del Sol y entrégaselos a Caledis Alba Brillante, en Forja de Maná Coruu de Tormenta Abisal.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Procurez-vous une Robe d\'arcaniste solfurie, une paire de Gants de chercheur solfurie et un Médaillon de garde solfurie et apportez-les à Caledis Brillaube à la manaforge Coruu au Raz-de-Néant.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡收集一件日怒奥术师长袍、一副日怒研究员手套和一枚日怒卫士勋章，然后返回虚空风暴的法力熔炉：库鲁恩，将它们交给卡勒迪斯·晨光。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡取得1套日怒秘法師長袍，1雙日怒調查員手套和1個日怒守衛勳章，完成後將這些帶回虛空風暴的法力熔爐寇魯給卡利迪斯·曙光。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10198] = {
  {
    'Conseguindo informações‡Сбор информации‡Informationen sammeln‡정보 수집‡Reuniendo pistas‡Recabar información‡Rassembler des informations‡收集情报‡收集資訊',
    nil,
    'Vista o Disfarce Solfúria, entre em Manaforja Coruu e escute a conversa entre o Comandante Albaforja e o Arcanista Ardonis.nnAo cumprir missões para os Áugures, sua reputação entre os Aldor será reduzida.‡Используя маскировку армии Ярости Солнца, проникните в манагорн Коруу и подслушайте разговор между командиром Кузней Солнца и чародеем Ардонисом. По завершении задачи доложите о результатах Каледису Сияющему Рассвету. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Benutzt die Sonnenzornverkleidung, geht in die Manaschmiede Coruu und belauscht das Gespräch zwischen Sonnenzornkommandant Morgenschmied und Arkanist Ardonis. Meldet Euch bei Caledis Morgenhell, wenn Ihr die Aufgabe abgeschlossen habt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 위장을 사용하여 코루 마나괴철로 안으로 들어가서 사령관 돈포지와 비전술사 아르도니스가 주고받는 대화를 들어야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Use el disfraz de Furia del Sol, ve a la Forja de Maná Coruu y escucha la conversación entre el comandante Forjalba y el arcanista Ardonis.nnA medida que completas tareas para los Arúspices disminuye tu nivel de reputación Aldor.‡‡Utilisez le déguisement de Solfurie pour vous rendre à la Manaforge Coruu et écouter la conversation entre le Commandant Forgelaube et l\'Arcaniste Ardonis.nnAccomplir des tâches pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡利用日怒伪装包进入法力熔炉：库鲁恩，偷听指挥官纳萨托·晨铸和奥术师阿尔杜尼斯的谈话。完成任务后向卡勒迪斯·晨光复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡使用日怒偽裝，進入法力熔爐寇魯聽取指揮官黎鑄與秘法師艾登尼斯的對話。完成任務後回報給卡利迪斯·曙光。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10199] = {
  {
    'Um gás extra‡Дополнительная сила‡Der kleine Extrakick‡약간의 기폭제‡Ese pequeño toque extra‡Ese pequeño toque extra‡Un petit coup de fouet‡一点添加剂‡一點額外的刺激',
    nil,
    'Obtenha cinco Aguilhões de Arraia Etérea para o Botas, na Área 52, em Eternévoa.‡Принесите 5 шипов скатов Пустоты Бутсу, находящемуся в Зоне 52 в Пустоверти.‡Besorgt 5 Netherrochenstachel und bringt sie zu Stiefels in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 부츠를 위해 황천의 가오리 독침 5개를 입수해야 합니다.‡Consigue 5 aguijones de rayas abisales para Botas en el Área 52 de Tormenta Abisal.‡Consigue 5 aguijones de rayas abisales para Botas en el Área 52 de Tormenta Abisal.‡Procurez-vous 5 Aiguillons de raie du Néant pour Bottes dans la Zone 52 du Raz-de-Néant.‡将5根虚空鳐的钉刺交给虚空风暴52区的布兹。‡替虛空風暴裡52區的布茲帶來5個虛空鰭刺。',
  }
},
[10200] = {
  {
    'Apresente-se novamente a Thalodien‡Возвращение к Талодиену‡Rückkehr zu Thalodien‡탈로디엔에게 돌아가기‡Regresa junto a Thalodien‡Regresa junto a Thalodien‡Retourner voir Thalodien‡返回萨罗迪恩身边‡回去找薩洛迪恩',
    nil,
    'Fale com o Mestre Espião Thalodien, na Área 52, em Eternévoa.‡Вернитесь к патрону шпионов Талодиену в Зону 52 в Пустоверти.‡Kehrt zu Spionagemeister Thalodien in Area 52 im Nethersturm zurück.‡황천의 폭풍에서 52번 구역에 있는 첩보단장 탈로디엔에게 가야 합니다.‡Ve a ver al maestro de espías Thalodien en el Área 52, en la Tormenta Abisal.‡Ve a ver al maestro de espías Thalodien en el Área 52, en la Tormenta Abisal.‡Retournez voir le maître-espion Thalodien dans la Zone 52 du Raz-de-Néant.‡返回虚空风暴的52区，向间谍大师萨罗迪恩复命。‡回到虛空風暴的52區找間諜大師薩洛迪恩。',
  }
},
[10201] = {
  {
    'E agora, a hora da verdade‡Момент истины‡Der Moment der Wahrheit‡마침내 찾아온 진실의 시간‡Y ahora, el momento de la verdad‡Y ahora, el momento de la verdad‡Et maintenant, l\'instant de vérité‡真相大白‡現在，真相的時刻',
    nil,
    'Ache Grek e peça para testar o lubrificante para armas. Após ele testar o óleo, informe os resultados a Rakoria.‡Найдите Грека и попросите его смазать маслом свое оружие, после чего вернитесь к Ракории.‡Geht zu Grek und bittet ihn, das Öl an seiner Waffe auszuprobieren. Bringt das Ergebnis zu Rakoria, wenn er fertig ist.‡그렉을 만나서 기름을 시험 삼아 무기에 사용해 달라고 부탁해야 합니다. 그가 기름을 시험하고 나면 그 결과를 라코리아에게 보고하십시오.‡Encuentra a Grek y pídele que pruebe el aceite en su arma. Cuando lo haya hecho, vuelve a ver a Rakoria con los resultados.‡Encuentra a Grek y pídele que pruebe el aceite en su arma. Cuando lo haya hecho, vuelve a ver a Rakoria con los resultados.‡Trouvez Grek et demandez-lui d\'essayer l\'huile sur son arme. Une fois qu\'il l\'aura testée, retournez décrire le résultat à Rakoria.‡找到葛雷克，让他用枪试试油的品质。试验完成之后，向拉克妮亚报告结果。‡找到葛利克並要他將東西試用在他的武器上。一旦他測試過這個油後，回去向瑞克利亞報告結果。',
  }
},
[10202] = {
  {
    'O desertor‡Дезертир‡Ein Abtrünniger‡배신자‡Un desertor‡Un desertor‡Un déserteur‡叛徒‡背叛者',
    nil,
    'Vá à Manaforja Ara e fale com o Magíster Theledorn.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Отправляйтесь в манагорн Ара и поговорите с магистром Теледорном. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Geht zur Manaschmiede Ara und sprecht mit Magister Theledorn.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡아라 마나괴철로로 가서 마법학자 텔레도른과 대화하십시오.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Ara y habla con el magister Theledorn.nnCompletar misiones para Los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Ve a la Forja de Maná Ara y habla con el magister Theledorn.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Allez à la manaforge Ara et parlez au magistère Theledorn.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡前往法力熔炉：艾拉，与魔导师塞雷杜恩谈一谈。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡到法力熔爐艾拉去與博學者瑟勒朵恩談談。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10203] = {
  {
    'Bugiganga fulminadora inestimável‡Захват бесценного оборудования‡Unschätzbare Ausrüstung beamen‡귀중한 자산 변환‡El ultra-desconsolidador es muy útil‡El ultra-desconsolidador es muy útil‡Zapper des atouts inestimables‡价值连城的设备‡傳送無價的資產',
    nil,
    'Use o Fulminador Ultradesconsolidador para transportar o Cava-cava Hiper-rotacional, a Garra de Sucção Servopneumática, o Analisador de Terreno Multispectro, e o vagão cheio de explosivos de volta à Área 52. Em seguida, apresente-se ao Sapador Líder Isscabum na extremidade leste da fissura que corta a Área 52, em Eternévoa.‡Используйте ультра-разуплотняющий захват, чтобы доставить гиперротационный Рой-О-Мат, сервоприводную пневматическую землечерпалку, радужный световой анализатор грунта и большой фургон с взрывчаткой обратно в Зону 52. Затем сообщите старшему саперу Бджимбуму, находящемуся на восточном конце расселины, идущей через Зону 52 в Пустоверти.‡Benutzt den ultrastarken Dekonsolidierungsstrahler, um den Hyperdreh-Grab-o-Matik, die servopneumatische Baggerklaue, den multispektralen Geländeabtaster und den großen Wagen voller Sprengstoff zurück nach Area 52 zu beamen. Meldet Euch dann beim leitenden Ingenieur Zischeldruck beim östlichen Ende des Risses in Area 52 im Nethersturm.‡초입자 해체 송신기를 사용하여 초고속회전 자동굴착기, 공기압축식 준설기, 다분광 지형 분석기, 폭약이 가득 실린 대형 짐마차를 52번 구역에 전해야 합니다. 그런 후에 황천의 폭풍의 52번 구역을 가로지르는 균열의 동쪽 끝에 있는 선임공병 블라스트피즐에게 보고하십시오.‡Utiliza el transportador ultra-desconsolidador para enviar al Área 52 la excavamática hiperrotacional, el cangilón de arrastre servoneumático, el analizador de terreno multiespectro y el vagón grande lleno de explosivos. A continuación preséntate ante el jefe de zapadores Estampido en la fisura del Área 52 en la Tormenta Abisal.‡Utiliza el transportador ultra-desconsolidador para enviar al Área 52 la excavamática hiperrotacional, el cangilón de arrastre servoneumático, el analizador de terreno multiespectro y el vagón grande lleno de explosivos. A continuación preséntate ante el jefe de zapadores Estampido en la fisura del Área 52 en la Tormenta Abisal.‡Utilisez le Zappeur d\'ultra-déconsolidation pour renvoyer le Creus-O-Matic ultra-rotatif, la Griffe de drague servopneumatique, l\'Analyseur de terrain multispectral et le Gros chariot rempli d\'explosifs dans la Zone 52 au Raz-de-Néant. Présentez-vous ensuite au Sapeur en chef Failonfeu à l\'extrémité est de la fissure qui parcourt la Zone 52 au Raz-de-Néant.‡利用超级拆解器将高转速挖掘器、机械气压挖掘爪、多光谱地形扫描仪和一大车炸药带回52区。然后向虚空风暴52区裂隙东端的首席工兵布拉斯特菲兹报到。‡使用超強化傳送搖控器將多旋轉挖掘機、伺服氣動挖泥器、多光譜地形分析器以及裝滿爆裂物的大型貨車傳送回52區。完成後向位於虛空風暴內的52區中裂縫東邊盡頭的工兵領班布拉斯特費索回報。',
  }
},
[10204] = {
  {
    'Cristais gema de sangue‡Кристаллы камня Крови‡Blutjuwelenkristalle‡혈석 수정‡Cristales de gema de sangre‡Cristales de gema de sangre‡Cristaux de gemmes de sang‡血宝石‡血寶石水晶',
    nil,
    'A Magistra Larynna quer que você vá a Manaforja B\'naar e obtenha um Estilhaço de Gema de Sangue de um Magíster Solfúria. Use o estilhaço perto de Cristais Gema de Sangue maiores e, em seguida, leve-o para Larynna, na Área 52.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Магистр Ларинна просит вас отправиться в манагорн Б\'наар и отобрать осколок камня крови у магистра из клана Ярости Солнца. Используйте этот осколок поблизости от более крупного кристалла камня крови и возвращайтесь к Ларинне в Зону 52.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Magistrix Larynna möchte, dass Ihr zur Manaschmiede B\'naar geht und einen Blutjuwelensplitter von einem Magister des Sonnenzorns besorgt. Benutzt den Splitter in der Nähe von größeren Blutjuwelenkristallen und kehrt zu ihr in Area 52 zurück.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 마법학자 라린나가 브나르 마나괴철로에 가서 성난태양 마법학자에게서 혈석 조각을 얻어 큰 혈석 수정 주변에서 사용한 후에 돌아와 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡La magistrix Larynna quiere que vayas a la Forja de Maná B\'naar y obtengas un fragmento de gema de sangre de un magister Furia del Sol. Utiliza el fragmento cerca de los cristales grandes de gema de sangre y ve a verla en el Área 52.nnCompletar misiones para los Arúspices hará que tu nivel de reputación con los Aldor disminuya.‡La magistrix Larynna quiere que vayas a la Forja de Maná B\'naar y obtengas un fragmento de gema de sangre de un magister Furia del Sol. Utiliza el fragmento cerca de los cristales grandes de gema de sangre y ve a verla en el Área 52.|n|nCompletar misiones para los Arúspices hará que tu nivel de reputación con los Aldor disminuya.‡La magistrice Larynna veut que vous alliez à la manaforge B\'naar pour vous y procurer un Éclat de gemme de sang sur un Magistère solfurie. Utilisez-le près des grands Cristaux de gemme de sang et retournez la voir dans la Zone 52.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡魔导师拉恩娜要你进入法力熔炉：布纳尔，从日怒魔导师手中夺得血宝石碎片。在较大的血宝石水晶附近使用这块碎片，然后返回52区向她复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡博學者萊莉娜要你去法力熔爐巴納爾從日怒博學者那取得一個血寶石裂片。在一個更大的血寶石水晶附近使用這個裂片，並帶回52區給她。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10205] = {
  {
    'Saqueador Dimensional Nesaad‡Астральный налетчик Несаад‡Sphärenräuber Nesaad‡초공간 약탈자 네사드‡Asaltante de distorsión Nesaad‡Asaltante de distorsión Nesaad‡L\'écumeur-dimensionnel Nesaad‡星界强盗奈萨德‡星移劫掠者尼薩德',
    nil,
    'Mate o Saqueador Dimensional Nesaad e fale novamente com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Убейте астрального налетчика Несаада, затем возвращайтесь к ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Tötet Sphärenräuber Nesaad und kehrt dann zu Netherpirscher Khay\'ji in Area 52 im Nethersturm zurück.‡초공간 약탈자 네사드를 처치한 후에 황천의 폭풍의 52번 구역에 있는 황천의 추적자 케이지에게 가야 합니다.‡Mata al asaltante de distorsión Nesaad y ve a ver al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Mata al asaltante de distorsión Nesaad y ve a ver al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Tuez l\'Écumeur-dimensionnel Nesaad, puis retournez voir le traqueur-du-Néant Khay\'ji dans la Zone 52 de Raz-de-Néant.‡杀死星界强盗奈萨德，然后返回虚空风暴52区，向虚空猎手卡尔伊复命。‡殺掉星移劫掠者尼薩德，完成後回到虛空風暴的52區找虛空行者凱澤。',
  }
},
[10206] = {
  {
    'Pega o que é teu‡В погоне за технологиями‡Wählt Eure Rolle‡부품 수집‡Tú eliges‡Tú eliges‡Prendre sa part‡偷来偷去‡挑選你的職責',
    nil,
    'Colete 10 Peças de Tecnologia Etérea e leve-as a Papai Macário, na Área 52, em Eternévoa.‡Соберите 10 астральных технологий и вернитесь с ними к Папаше Колесуну, находящемуся в Зоне 52 в Пустоверти.‡Sammelt 10 Stück Astraltechnologie und bringt sie zu Papa Mauschel in Area 52 im Nethersturm.‡에테리얼 기술 부품 10개를 수집한 후에 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 돌려주어야 합니다.‡Reúne 10 artilugios de tecnología etérea y llévaselos a Papá Ruedas en el Área 52, en la Tormenta Abisal.‡Reúne 10 artilugios de tecnología etérea y llévaselos a Papá Ruedas en el Área 52, en la Tormenta Abisal.‡Récupérez 10 modèles de Technologie éthérienne et rapportez-les à Papa Roulette, dans la Zone 52 au Raz-de-Néant.‡收集10件虚灵科技的产品碎片，将它们交给虚空风暴52区的维勒老爹。‡收集10片伊斯利技術後回到虛空風暴的52區找威勒老爹。',
  }
},
[10207] = {
  {
    'Forward Base: Reaver\'s Fall REUSE‡Forward Base: Reaver\'s Fall REUSE‡Forward Base: Reaver\'s Fall REUSE‡‡Forward Base: Reaver\'s Fall REUSE‡‡Forward Base: Reaver\'s Fall REUSE‡Forward Base: Reaver\'s Fall REUSE‡Forward Base: Reaver\'s Fall REUSE',
    nil,
    'Report to Forward Commander To\'arch at Reaver\'s Fall.‡Доложитесь командиру передовой То\'арху по прибытии к останкам Сквернобота.‡Meldet Euch bei Vorpostenkommandant To\'arch im Häschersturz.‡지옥절단기 함락지에 있는 전방사령관 토아크에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Présentez-vous au commandant des lignes avancées To\'arch au Trépas du saccageur.‡Report to Forward Commander To\'arch at Reaver\'s Fall.‡到搶奪者荒野找前線指揮官吐阿奇報到。',
  }
},
[10208] = {
  {
    'Interrompa os reforços‡Лишить Легион подкрепления!‡Die Verstärkung abschneiden‡지원군 차단‡Perturbar sus refuerzos‡Perturbar sus refuerzos‡Perturber leurs renforts‡阻断援军‡阻斷他們的援軍',
    nil,
    'Derrote os inimigos perto dos Portais Xilus e Kruul para coletar 4 Pedras Rúnicas Demoníacas para cada portal.nnUse o Detonador de To\'acha nos Portais Xilus e Kruul.nnLeve os detonadores que sobrarem de volta para To\'acha no Posto dos Destroços na Península Fogo do Inferno.‡Уничтожьте врагов вокруг портала Зилус и портала Круул, соберите камни с рунами демонов.nnИспользуйте запалы То\'арха внутри порталов Зилус и Круул.nnВозвращайтесь к То\'арху в Гибель Сквернобота на полуострове Адского Пламени вместе с оставшимися запалами.‡Besiegt die Feinde um Portal Xilus und Portal Kruul herum, um dämonische Runensteine zu sammeln.nnBenutzt To\'archs Zünder in Portal Xilus und Portal Kruul.nnKehrt danach mit To\'archs Zünder zu To\'arch im Häschersturz auf der Höllenfeuerhalbinsel zurück.‡자일러스 차원문과 크룰 차원문 주변에 있는 적들을 물리친 다음 악마의 마법석을 수집해야 합니다.nn자일러스 차원문과 크룰 차원문 안에서 토아크의 뇌관을 사용해야 합니다.nn토아크의 뇌관을 가지고 지옥불 반도의 지옥절단기 함락지에 있는 토아크에게 돌아가십시오.‡Derrota a enemigos alrededor del Portal Xilus y del Portal Kruul para recolectar piedras rúnicas demoníacas.nnUsa el cebo explosivo de To\'arch del Portal Xilus y del Portal Kruul.nnRegresa junto a To\'arch con los cebos de To\'arch en la Caída del Atracador Vil, en la Península del Fuego Infernal.‡Derrota a enemigos alrededor del Portal Xilus y del Portal Kruul para recolectar piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de To\'arch del Portal Xilus y del Portal Kruul.|n|nRegresa junto a To\'arch con los cebos de To\'arch en la Caída del Atracador Vil, en la Península del Fuego Infernal.‡Terrassez les ennemis qui se trouvent autour des portails Xilus et Kruul pour rassembler des Pierres runiques démoniaques.nnUtilisez une Amorce de To\'arch à l\'intérieur des portails Xilus et Kruul.nnRapportez les Amorces restantes à To\'arch au Trépas du saccageur dans la péninsule des Flammes infernales.‡消灭希鲁斯传送门和科卢尔传送门附近的敌人，收集它们身上的恶魔符文石。nn然后在希鲁斯传送门和科卢尔传送门内使用托尔克的雷管。nn完成任务后，将剩余的炸药还给地狱火半岛机甲残骸处的托尔克。‡打倒塞勒斯傳送門和卡魯歐傳送門附近的敵人以便收集惡魔符文石。|n在塞勒斯傳送門還有卡魯歐傳送門內使用吐阿奇的雷管。|n完成後帶著吐阿奇的雷管回到地獄火半島的搶奪者荒野找吐阿奇。',
  }
},
[10209] = {
  {
    'O prêmio do evocador Kanthin‡Трофей призывателя Кантина‡Beschwörer Kanthins Preis‡소환사 칸딘의 전리품‡El premio del invocador Kanthin‡El premio del invocador Kanthin‡Le trophée de l\'invocateur Kanthin‡召唤者坎西恩的战利品‡召喚者卡辛恩的禮物',
    nil,
    'Derrote o Evocador Kanthin na Manaforja Dúria, na ilha ao norte do Acampamento Solfúria, para recuperar a Pedra de Glacius.‡Победите призывателя Кантина, находящегося в манагорне Даро, на острове к северу от форта Ярости Солнца, и заберите у него камень Студенора. Когда заберете камень, используйте посох верховного мага Варгота, чтобы связаться с верховным магом.nnЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром, находящимся в Зоне 52, чтобы получить замену.‡Besiegt Beschwörer Kanthin in der Manaschmiede Duro auf der Insel nördlich des Sonnenzornpostens und holt den Stein von Gletscharius zurück. Wenn Ihr den Stein besorgt habt, benutzt Erzmagier Vargoths Stab, um den Erzmagier zu kontaktieren.nnFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡성난태양 주둔지의 북쪽 섬에 있는 듀로 마나괴철로에서 소환사 칸딘을 처치하고 글라시우스의 돌을 되찾아야 합니다.‡Derrota al invocador Kanthin en la Forja de Maná Duro, en la isla que está al norte del Bastión Furia del Sol y reclama la Piedra de Glacius. Cuando la tengas, utiliza el bastón del archimago Vargoth para contactar con el archimago.nnSi pierdes el bastón del archimago Vargoth, ve a ver a Ravandwyr en el Área 52 para que te dé otro.‡‡Triomphez de l\'invocateur Kanthin à la manaforge Duro, sur l\'île au nord du bastion des Solfurie, et reprenez-lui la Pierre de Glacius.‡前往位于日怒堡北部岛屿的法力熔炉：杜隆，从召唤者坎西恩手中夺回格拉修斯之石。然后使用大法师瓦格斯的法杖与大法师取得联系。nn如果你不小心弄丢了大法师瓦格斯的法杖，可向52区内的拉文德维尔再要一根。‡到日怒要塞的北方小島上，打倒法力熔爐杜羅的召喚者卡辛恩，並從他手中將葛拉希厄斯之石拿回來。當你拿到石頭後，使用大法師瓦戈斯之杖與大法師連絡。|n如果你遺失了大法師瓦戈斯之杖，可以找52區的羅樊德威拿取替代品。',
  }
},
[10210] = {
  {
    'A\'dal‡А\'дал‡A\'dal‡아달‡A\'dal‡‡A\'dal‡阿达尔‡阿達歐',
    nil,
    'Fale com A\'dal, líder dos Sha\'tar, no centro do Terraço da Luz.‡Поговорите с А\'далом, предводителем Ша\'тар, в центре террасы Света.‡Sprecht mit A\'dal, Anführer der Sha\'tar in der Mitte der Terrasse des Lichts.‡빛의 정원의 중앙에서 샤타르의 지도자인 아달과 대화하십시오.‡Habla con A\'dal, el jefe de los Sha\'tar, en el centro del Bancal de la Luz.‡Habla con A\'dal, el jefe de los Sha\'tar, en el centro del Bancal de la Luz.‡Parlez à A\'dal, le chef des Sha\'tar, au centre de la Terrasse de la Lumière.‡与沙塔尔的领袖阿达尔谈一谈，他就在圣光广场的中央。‡與聖光露臺中央的薩塔領導者，阿達歐談談。',
  }
},
[10211] = {
  {
    'Cidade da Luz‡Город Света‡Stadt des Lichts‡빛의 도시‡La Ciudad de la Luz‡Ciudad de la Luz‡Ville de Lumière‡圣光之城‡聖光之城',
    nil,
    'Siga o servo de Hadggar e escute sua história. Fale novamente com Hadggar após completar essa tarefa.‡Проследуйте за слугой Кадгара и выслушайте историю, которую он вам расскажет, после чего вернитесь к Кадгару.‡Folgt Khadgars Diener und hört Euch an, was er zu erzählen hat. Kehrt nach dieser Aufgabe zu Khadgar zurück.‡카드가의 하수인을 따라가면서 이야기를 들어야 합니다. 끝나면 카드가에게 돌아가십시오.‡Sigue al sirviente de Khadgar y escucha la historia de la ciudad. Luego ve a ver a Khadgar.‡Sigue al sirviente de Khadgar y escucha la historia de la ciudad. Luego ve a ver a Khadgar.‡Suivez le serviteur de Khadgar et écoutez son histoire. Retournez ensuite voir Khadgar.‡跟随卡德加的仆从游览城市并聆听这里的历史故事。完成任务后回去向卡德加复命。‡跟著卡德加的僕人並聽他說故事。完成任務後回去找卡德加。',
  }
},
[10212] = {
  {
    'Hero of the Mag\'har‡Герой маг\'харов‡Held der Mag\'har‡‡Héroe Mag\'har‡Héroe Mag\'har‡Héros des Mag\'har‡玛格汉的英雄‡',
    nil,
    'Return to Greatmother Geyah at Garadar in Nagrand.‡Вернитесь к великой матери Гейе в Гарадар в Награнде.‡Kehrt zu Großmutter Geyah in Garadar in Nagrand zurück.‡‡Ve a ver a Abuela Geyah a Garadar en Nagrand.|n‡Ve a ver a Abuela Geyah a Garadar en Nagrand.|n‡Retournez voir la grande-mère Geyah à Garadar en Nagrand.‡向纳格兰加拉达尔的盖亚安祖母复命。‡',
  }
},
[10213] = {
  {
    'Investigue a queda‡Найти место крушения‡Untersuchung der Absturzstelle‡추락 사건 조사‡Investigar el accidente‡Investigar el accidente‡Enquêter au sujet de l\'accident‡调查坠毁点‡調查這場空難',
    nil,
    'Busque sobreviventes da queda.‡Отыщите уцелевших в катастрофе.‡Durchsucht die Absturzstelle nach Überlebenden.‡추락 사건의 생존자들을 찾아야 합니다.‡Busca supervivientes en el lugar del accidente.‡Busca supervivientes en el lugar del accidente.‡Cherchez des survivants de l\'accident.‡寻找飞艇坠毁事故的幸存者。‡搜尋空難倖存者。',
  }
},
[10214] = {
  {
    'Balança mas não cai‡Весь рудник ходуном‡Bringt diese Mine zum beben!‡‡Esta mina es un caos‡‡Mineur, tu dors, ton wagon va trop vite‡‡礦場的騷動',
    nil,
    'Mate 15 Sapadores Gan\'args e fale novamente com o Capataz Razelcraz.‡Убейте 15 ган\'аргов-саперов и возвращайтесь к штейгеру Разлкразу.‡Tötet 15 Pioniere der Gan\'arg und kehrt dann zu Großknecht Razelcraz zurück.‡‡Mata 15 zapadores Gan\'arg y ve a ver al supervisor Razelcraz.‡Mata 15 zapadores Gan\'arg y ve a ver al supervisor Razelcraz.‡Tuez 15 Sapeurs gan\'arg et retournez voir le contremaître Razelcraz.‡‡殺掉15個甘納格工人，完成後回報工頭瑞絲坎茲。',
  }
},
[10216] = {
  {
    'Segurança acima de tudo‡Прежде всего - безопасность!‡Sicherheit geht vor‡안전 제일‡La seguridad es prioritaria‡La seguridad es prioritaria‡La sécurité avant tout‡安全第一‡安全至上',
    nil,
    'O Artífice Morfílius quer que você mate 10 Saqueadores Etéreos da Cripta, 5 Feiticeiros Etéreos, 5 Espreitadores do Nexus e 5 Mesmerizadores Etéreos.nnFeito isso, encontre o Transportador Etéreo na câmara em frente aos aposentos de Shaffar e ative-o.‡Убейте 10 эфириалов-осквернителей гробниц, 5 эфириалов-колдунов, 5 ловчих нексуса и 5 эфириалов-чароплетов по просьбе работника Морфалиуса.nnПосле этого найдите эфириальский телепорт в зале, предшествующем палате Шаффара, и активируйте его.‡Konstrukteur Morphalius möchte, dass Ihr 10 astrale Grufträuber, 5 astrale Zauberer, 5 Nexuswandler und 5 astrale Zauberbinder tötet.nnWenn Ihr damit fertig seid, sucht den astralen Transporter in der Kammer vor Shaffars Kammern und aktiviert ihn.‡기술병 몰팔리우스가 에테리얼 납골당 침입자 10명, 연합 추적자 5명, 에테리얼 마술사 5명, 에테리얼 역술사 5명을 해치워 달라고 부탁했습니다.nn일이 끝나면 샤파르의 방 앞에 있는 방에서 에테리얼 순간이동기를 찾으십시오.‡El artificiero Morphalius quiere que mates 10 asaltantes de tumbas etéreos, 5 brujas etéreas, 5 acechadores nexo y 5 vinculahechizos etéreos.nnCuando lo hayas conseguido, encuentra el transportador etéreo en la cámara que está antes de la de Shaffar y actívalo.‡El artificiero Morphalius quiere que mates 10 asaltantes de tumbas etéreos, 5 brujas etéreas, 5 acechadores nexo y 5 vinculahechizos etéreos.|n|nCuando lo hayas conseguido, encuentra el transportador etéreo en la cámara anterior a la de Shaffar y actívalo.‡L\'artificier Morphalius veut que vous alliez tuer 10 Écumeurs de crypte éthériens, 5 Ensorceleurs éthériens, 5 Traqueurs de nexus et 5 Lieurs de sort éthériens.nnLorsque ce sera fait, trouvez le Transporteur éthérien dans la salle avant celle de Shaffar et activez-le.‡工匠莫法鲁斯要你杀死10个虚灵盗墓者、5个虚灵巫师、5个节点潜行者和5个虚灵缚法者。nn全部搞定之后，激活沙法尔房间的前一个房间中的虚灵传送器。‡工匠莫法利厄司要你去殺掉10個伊斯利盜墓者，5個伊斯利巫士，5個奈薩斯捕獵者及5個伊斯利縛法者。|n一旦完成後，找到在薩法爾之前一個房間的伊斯利傳送器並啟動它。',
  }
},
[10218] = {
  {
    'O trabalho duro de outrem compensa‡Someone Else\'s Hard Work Pays Off‡Jemandes Arbeit zahlt sich aus‡고진감래‡El trabajo duro de alguien más nos beneficia‡El trabajo duro de alguien más nos beneficia‡Le dur labeur des autres‡别人的烂摊子‡解決別人的難事',
    nil,
    'Acompanhe o Crio-engenheiro Sha\'heen em segurança através das Tumbas de Mana para que ele colete o éter preso nos coletores de éter de Shaffar.nnApresente-se ao Príncipe do Nexus Haramad diante das Tumbas de Mana, no acampamento do Consórcio, se tiver sucesso.‡Проводите криоинженера Ша\'хина в Гробницы маны, чтобы он мог собрать астральную субстанцию в коллекторах Шаффара.nnВ случае успеха явитесь к принцу нексуса Харамаду в лагере Консорциума.‡Begleitet Kryoingenieur Sha\'heen sicher durch die Managruft, damit er die Astralmaterie aus Shaffars Astralsammlern entnehmen kann.nnMeldet Euch bei Nexusprinz Haramad außerhalb der Managruft beim Lager des Konsortiums, wenn Ihr erfolgreich wart.‡극저온 기술자 샤힌이 샤파르의 황천 수집 장치 속에 있는 에테르를 수집할 수 있도록 마나 무덤까지 무사히 데려다 주어야 합니다.nn임무에 성공하면 마나 무덤 바깥에 있는 무역연합 야영지의 연합왕자 하라매드에게 가서 보고하십시오.‡Escolta al crioingeniero Sha\'heen a través de las Tumbas de Maná para que pueda recoger el éter que está dentro de los recolectores de Shaffar.nnPreséntate ante el Príncipe-nexo Haramad que está fuera de las Tumbas de Maná, en el campamento del Consorcio si tienes éxito.‡Escolta al crioingeniero Sha\'heen a través de las Tumbas de Maná para que pueda recoger el éter que está dentro de los recolectores de Shaffar.|n|nPreséntate ante el príncipe-nexo Haramad en las Tumbas de Maná, en el campamento del Consorcio si tienes éxito.‡Escortez le cryo-ingénieur Sha\'heen dans les tombes-mana pour qu\'il puisse recueillir l\'éther contenu dans les collecteurs d\'éther de Shaffar.nnAllez voir le prince-nexus Haramad au campement du Consortium à l\'extérieur des tombes-mana une fois votre mission accomplie.‡护送低温工程师沙赫恩穿过法力陵墓，在他从沙法尔的灵体收集器中收集灵体能量时保护他。nn完成任务后向节点亲王哈拉迈德复命，他就在星界财团设立在法力陵墓外的营地中。‡護送工程師薩希恩安全的穿越法力墓地讓他可以拾取那些薩法爾的精華收集器內的精華。|n完成後回到法力墓地外的聯合團紮營地找奈薩斯王子哈拉瑪德回報。',
  }
},
[10219] = {
  {
    'Passeando com o cachorro‡Выгул собаки‡Gassi gehen‡‡Pasear al perro‡Pasear al perro‡Sortir le chien‡‡',
    nil,
    nil,
  }
},
[10220] = {
  {
    'Faça com que nos escutem‡Заставь их слушать‡Bringt sie zum Zuhören‡설득‡Oblígales a escuchar‡Oblígales a escuchar‡Les forcer à écouter‡聆听之魂‡讓他們聽話',
    nil,
    'Mordiba quer que você derrote 12 Soldados Rasos Obstinados, 8 Cavaleiros Obstinados e 6 Feiticeiros Obstinados no Arsenal da Expedição, a oeste do Acampamento Quebra-espinha.‡Убейте 12 непреклонных пехотинцев, 8 непреклонных рыцарей и 6 непреклонных колдунов в оружейной экспедиции к западу от заставы Хребтолома по просьбе Мордибы.‡Mordiba möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 8 unerschütterliche Krieger und 6 unerschütterliche Zauberhexer beim Expeditionsrüstlager westlich des Rückenbrecherpostens tötet.‡몰디바가 해골망치 초소의 서쪽에 있는 원정대 무기고의 불굴의 보병 12명, 불굴의 기사 8명, 불굴의 마술사 6명을 해치워 달라고 부탁했습니다.‡Mordiba quiere que derrotes a 12 lacayos Implacables, 8 caballeros Implacables y 6 hechiceros Implacables en la Armería de Expedición, al oeste de la Avanzada Rompeloma.‡Mordiba quiere que derrotes a 12 lacayos Implacables, 8 caballeros Implacables y 6 hechiceros Implacables en la Armería de Expedición, al oeste de la Avanzada Rompeloma.‡Mordiba veut que vous vainquiez 12 Fantassins inflexibles, 8 Chevaliers inflexibles et 6 Ensorceleurs inflexibles à l\'Armurerie de l\'expédition à l\'ouest du Poste de Brise-échine.‡莫迪巴要求你前往断背岗哨以西的远征军物资库，击败12个步兵的阴魂、8个骑士的阴魂和6个巫师的阴魂。‡莫爾迪巴要你去斷脊氏族崗哨西方的遠征隊軍械庫殺掉12個不屈的士兵，8個不屈的騎士，以及6個不屈的魔巫士。',
  }
},
[10221] = {
  {
    'Dr. Cabum!‡Доктор Бум!‡Dr. Bumm!‡붐 박사!‡¡Dr. Bum!‡¡Dr. Bum!‡Dr Boum !‡砰砰博士！‡布姆博士!',
    nil,
    'Mate o Dr. Cabum e leve a boa notícia para o Líder Sapador Isscabum, na Área 52, em Eternévoa.‡Убейте Доктора Бума и возвращайтесь с хорошими новостями к старшему саперу Бджимбуму в Зону 52 в Пустоверти.‡Tötet Dr. Bumm und kehrt dann mit den guten Nachrichten zu dem leitenden Ingenieur Zischeldruck in Area 52 im Nethersturm zurück.‡붐 박사를 처치한 후에 황천의 폭풍의 52번 구역에 있는 선임공병 블라스트피즐에게 승전보를 전해야 합니다.‡Mata al Dr. Bum y ve a darle la buena noticia al jefe de zapadores Estampido al Área 52 en Tormenta Abisal.‡Mata al Dr. Bum y ve a darle la buena noticia al jefe de zapadores Estampido al Área 52 en Tormenta Abisal.‡Tuez Dr Boum puis rapportez la bonne nouvelle au sapeur en chef Failonfeu dans la Zone 52 au Raz-de-Néant.‡杀死砰砰博士，然后将胜利的消息汇报给虚空风暴52区的首席工兵布拉斯特菲兹。‡殺掉布姆博士並將這個好消息帶給虛空風暴的52區給工兵領班布拉斯特費索。',
  }
},
[10222] = {
  {
    'A guarnição Solfúria‡Гарнизон Ярости Солнца‡Die Garnison des Sonnenzornpostens‡성난태양 주둔지‡El cuartel Furia del Sol‡El cuartel Furia del Sol‡La garnison Solfurie‡日怒堡‡日怒部隊',
    nil,
    'O Zelador Dieworth, na vila Kirin\'Var, quer que você mate 10 Arqueiros Solfúria.‡Смотритель Дайворт из деревни Кирин\'Вар просит вас убить 10 лучников из армии Ярости Солнца.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr 10 Bogenschützen des Sonnenzorns tötet.‡키린바르 마을에 있는 관리인 디워스가 성난태양 궁수 10명을 처치해 달라고 했습니다.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 10 arqueros Furia del Sol.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 10 arqueros Furia del Sol.‡Le Protecteur Valemort à Kirin\'Var veut que vous tuiez 10 Archers solfurie.‡肯瑞瓦村的管理者戴沃斯要你杀死10名日怒射手。‡肯瑞瓦村莊的管理者戴沃斯要你去殺了10個日怒弓箭手。',
  }
},
[10223] = {
  {
    'Abaixo o Daellis‡Покончить с Даэллисом‡Nieder mit Daellis‡댈리스 처치‡Abajo con Daellis‡Abajo con Daellis‡Mort à Daellis‡达尔利斯之死‡擊倒戴利斯',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você mate o Mestre Daellis Albatacas.‡Смотритель Дайворт из деревни Кирин\'Вар просит вас убить наставника Даэллиса Стрелка Рассвета.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr Meister Daellis Morgenschlag tötet.‡키린바르 마을에 있는 관리인 디워스가 기사대장 댈리스 돈스트라이크를 처치해 달라고 했습니다.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que mates al maestro Daellis Golpe del Amanecer.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que mates al maestro Daellis Golpe del Amanecer.‡Le protecteur Valemort de Kirin\'Var veut que vous alliez tuer le maître Daellis Heurtelaube.‡肯瑞瓦村的管理者戴沃斯要你杀死达尔利斯·晨击。‡肯瑞瓦村莊的管理者戴沃斯要你去殺掉大師戴利斯·黎擊。',
  }
},
[10224] = {
  {
    'Essência para os motores‡Эссенция для двигателей‡Essenzen für die Motoren‡엔진을 위한 정수‡Esencia para los motores‡Esencia para los motores‡De l\'essence pour les moteurs‡引擎的能源‡引擎的精華',
    nil,
    'Colete 7 Essências de Aparição de Mana e leve-as ao Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Соберите 7 единиц эссенции призрака магии и доставьте главному инженеру Трепу в Зону 52 в Пустоверти.‡Sammelt 7 Essenzen eines Managespensts und bringt sie zu Chefingenieur Trep bei Area 52 im Nethersturm.‡마나 망령의 정수 7개를 수집한 후 황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 가져가야 합니다.‡Reúne 7 esencias de ánima de maná y regresa junto al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Reúne 7 esencias de ánima de maná y regresa junto al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Collectez 7 Essences d\'âmes en peine de mana et rapportez-les à l\'ingénieur en chef Trep à la Zone 52 au Raz-de-Néant.‡将7块法力怨魂精华交给虚空风暴52区的主工程师特雷普。‡收集7個法力怨靈精華將它們帶回到虛空風暴的52區給首席工程師崔普。',
  }
},
[10225] = {
  {
    'Apresente-se à engenharia‡Рапорт главному инженеру‡Meldung beim Chefingenieur‡선임기술자에게 보고‡Informe para lngeniería‡Informe para lngeniería‡Rapport à l\'ingénierie‡向主工程师汇报‡回報工程師',
    nil,
    'Entregue os cristais da matriz de eterlítio ao Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Передайте астраллитиевые матричные кристаллы главному инженеру Трепу, находящемуся в Зоне 52 в Пустоверти.‡Bringt die Astrallithiummatrixkristalle zu Chefingenieur Trep in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 에테리시움 맥석 수정을 가져가야 합니다.‡Entrégale los cristales de la matriz de eterlitio al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Entrégale los cristales de la matriz de eterlitio al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Apportez le Cristal de matrice d\'etherlithium à l\'Ingénieur en chef Trep dans la Zone 52 au Raz-de-Néant.‡将以太锂矩阵水晶交给虚空风暴52区的主工程师特雷普。‡將這些伊斯利母體水晶送到虛空風暴的52區給首席工程師崔普。',
  }
},
[10226] = {
  {
    'Extração de poder elemental‡Извлечение силы стихии‡Elementarenergieextraktor‡정령의 마력 추출‡Extracción de energía elemental‡Extracción de energía elemental‡Extraction de puissance élémentaire‡元素能量萃取器‡元素力量粹取',
    nil,
    'Extraia 5 Poderes Elementais para o Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Извлеките 5 единиц силы стихии для главного инженера Трепа, находящегося в Зоне 52 в Пустоверти.‡Extrahiert 5 Einheiten Elementarenergie und bringt sie zu Chefingenieur Trep in Area 52 im Nethersturm.‡정령의 마력 5개를 추출해서 황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 가져가야 합니다.‡Extrae 5 unidades de energía elemental para el ingeniero jefe Trep en el Área 52, en la Tormenta Abisal.‡Extrae 5 unidades de energía elemental para el ingeniero jefe Trep en el Área 52, en la Tormenta Abisal.‡Extrayez 5 Puissances élémentaires et apportez-les à l’Ingénieur en chef Trep, dans la Zone 52 au Raz-de-Néant.‡萃取5份元素能量，将它们交给虚空风暴52区的主工程师特雷普。‡取得5個元素力量並將它們帶給虛空風暴的52區給首席工程師崔普。',
  }
},
[10227] = {
  {
    'Eu vejo draeneis mortos‡Я вижу мертвых дренеев‡Ich sehe tote Draenei‡죽은 드레나이가 보여요‡Veo draenei muertos‡Veo draenei muertos‡Je vois des draeneï morts‡我看到了死德莱尼人‡我看到了德萊尼的鬼魂',
    nil,
    'Fale com Ramdor, o Louco, em cima da pilha de ossos na entrada das Catacumbas Auchenai.‡Поговорите с Рамдором Безумным, который стоит на груде костей неподалеку от Аукенайских гробниц.‡Sprecht mit Ramdor dem Wahnsinnigen auf dem Knochenhaufen außerhalb der Auchenaikrypta.‡아키나이 납골당의 바깥에서 뼈의 산 위에 서 있는 광기의 람도르와 대화하십시오.‡Habla con Ramdor el Loco junto a la pila de huesos fuera de las Criptas Auchenai.‡Habla con Ramdor el Loco junto a la pila de huesos fuera de las Criptas Auchenai.‡Parlez à Ramdor le Fol, qui se trouve sur le tas d\'os à l\'extérieur des cryptes Auchenaï.‡与奥金尼地穴外的疯狂的拉姆杜尔谈一谈，他就站在地穴入口附近的骨堆上。‡與奧奇奈地穴外白骨堆的瘋狂的藍姆多談談。',
  }
},
[10228] = {
  {
    'Ezequiel‡Иезекииль‡Ezekiel‡에제키엘‡Ezekiel‡‡Ezekiel‡伊瑟基尔‡伊斯奇歐',
    nil,
    'Encontre e fale com Ezequiel na cidade de Shattrath.‡Найдите Иезекииля из Шаттрата в городе Шаттрат и поговорите с ним.‡Sprecht mit Ezekiel von Shattrath in Shattrath.‡샤트라스에 있는 에제키엘을 찾아 대화하십시오.‡Busca a Ezekiel de Shattrath en Ciudad de Shattrath.‡Busca a Ezekiel de Shattrath en Ciudad de Shattrath.‡Trouvez Ezekiel dans la ville de Shattrath, et parlez-lui.‡与沙塔斯城的伊瑟基尔谈一谈。‡尋找並與撒塔斯城裡撒塔斯的伊斯奇歐談談。',
  }
},
[10229] = {
  {
    'Decifre o tomo‡Секрет фолианта‡Den Folianten entziffern‡고서 판독‡Descifrar el libro‡Descifrar el escrito‡Déchiffrer le tome‡解读书卷‡解譯書籍',
    nil,
    'Leve o Tomo Misterioso para Althen, o Historiador, no Acampamento Quebra-espinha.‡Отнесите таинственный фолиант Альтену Историку на Заставу Хребтолома.‡Bringt den geheimnisvollen Folianten zu Althen dem Historiker im Rückenbrecherposten.‡해골망치 초소에 있는 역사가 알센에게 불가사의한 고서를 가져가야 합니다.‡Lleva el libro misterioso a Althen, el historiador de la Avanzada Rompeloma.‡Lleva el escrito misterioso a Althen, el historiador de la Avanzada Rompeloma.‡Apportez le Tome mystérieux à Althen l\'Historien au Poste de Brise-échine.‡将神秘的典籍交给断背岗哨的史学家奥尔森。‡拿著這本神秘的秘典給斷脊氏族崗哨的歷史家亞登。',
  }
},
[10230] = {
  {
    'A trompa de batalha‡Боевой рог‡Das Kampfhorn‡전투 뿔피리‡El cuerno de batalla‡El cuerno de batalla‡Le cor de bataille‡战斗的号角‡戰鬥號角',
    nil,
    'Pegue a trompa de batalha dos Obstinados com o Tenente-comandante Talvos e entregue-a para Althen, o Historiador, no Acampamento Quebra-espinha.‡Заберите у лейтенанта-командора Талвоса Боевой рог Непреклонных и принесите его Альтену Историку на Заставу Хребтолома.‡Besorgt Euch das Kampfhorn der Unerschütterlichen von Feldkommandant Thalvos und bringt es zu Althen dem Historiker im Rückenbrecherposten.‡부사령관 탈보스로부터 불굴의 전투 뿔피리를 빼앗아서 해골망치 초소에 있는 역사가 알센에게 가져가야 합니다.‡Toma el cuerno de batalla Implacable del comandante Thalvos y llévaselo Althen, el historiador de la Avanzada Rompeloma.‡Toma el cuerno de batalla Implacable del comandante Thalvos y llévaselo Althen, el historiador de la Avanzada Rompeloma.‡Prenez le Cor de bataille des Inflexibles au lieutenant-commandant Thalvos et apportez-le à Althen l\'Historien au Poste de Brise-échine.‡从塔沃斯少校那里拿到顽强战斗号角，把它交给断背岗哨的史学家奥尔森。‡從少校薩沃斯那把不屈戰爭號角帶給斷脊氏族崗哨的歷史家亞登。',
  }
},
[10231] = {
  {
    'Que livro? Não vejo livro nenhum‡Какая книга? Не вижу никакой книги‡Welches Buch? Ich sehe kein Buch.‡무슨 책 말이지? 책이라곤 못 봤는데...‡¿Libro? Yo no veo ninguno‡¿Libro? Yo no veo ninguno‡Quel livre ? Je ne vois pas de livre.‡什么书？我没见过什么书‡什麼書?我沒看到有什麼書啊。',
    nil,
    'Ezequiel disse que o livro foi roubado. O melhor é encontrar os rufiões e ver se eles têm informações.‡Иезекииль говорит, что книга могла быть украдена. Найдите головорезов и попытайтесь узнать что-нибудь у них.‡Ezekiel sagt, dass das Buch gestohlen wurde. Eure einzige Spur führt Euch zu den Grobianen. Schaut nach, ob sie irgendwelche Informationen haben.‡에제키엘은 그 책을 누가 훔쳐갔다고 말했습니다. 건달들을 찾아서 그들이 알고 있는 정보를 알아내는 것이 최선의 방법입니다.‡Ezekiel dijo que habían robado el libro Será mejor que encuentres a esos rufianes y veas si ellos tienen alguna información.|n‡Ezekiel dijo que habían robado el libro Será mejor que encuentres a esos rufianes y veas si ellos tienen alguna información.|n‡Ezekiel dit que le livre a été volé. Votre meilleure piste serait de trouver les ruffians et de voir s\'ils ont des informations à ce sujet.‡伊瑟基尔说亡者之书已经被偷走了。你最好去问问那些无赖，看他们是否知道些什么。‡艾澤基爾提到書已經被偷了。你最好的辦法就是去找那些惡棍並看看他們是否有什麼消息。',
  }
},
[10232] = {
  {
    'Encrenca com a Legião‡Легион – на мусор!‡Legion in Trümmern‡불타는 군단과의 전투‡Movida con la Legión‡Movida con la Legión‡Ferrailler contre la Légion‡废料场中的燃烧军团‡與軍團一戰',
    nil,
    'Mate 5 Forjadores da Ruína Mo\'args e 15 Engenheiros Gan\'args. Em seguida, fale com Papai Macário, na Área 52, em Eternévoa.‡Убейте 5 мо\'аргов-кузнецов рока и 15 ган\'аргов-инженеров. Затем возвращайтесь к Папаше Колесуну в Зону 52 в Пустоверти.‡Tötet 5 Schicksalsschmiede der Mo\'arg und 15 Ingenieure der Gan\'arg. Kehrt danach zu Papa Mauschel in Area 52 im Nethersturm zurück.‡모아그 파멸의 대장장이 5명과 간아그 기술자 15명을 처치한 후 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 가야 합니다.‡Mata 5 forjadestinos Mo\'arg y 15 ingenieros Gan\'arg. Después, vuelve a hablar con Papá Ruedas en el Área 52, en Tormenta Abisal.‡Mata 5 forjadestinos Mo\'arg y 15 ingenieros Gan\'arg. Después, vuelve a hablar con Papá Ruedas en el Área 52, en Tormenta Abisal.‡Tuez 5 Forgerons funestes mo\'arg et 15 Ingénieurs gan\'arg. Puis retournez voir Papa Roulette dans la Zone 52 du Raz-de-Néant.‡杀死5名莫尔葛铁匠和15名甘尔葛工程师，然后向虚空风暴52区的维勒老爹复命。‡殺掉5個莫阿格設計師及15個甘納格工程師。完成後回到虛空風暴的52區找威勒老爹。',
  }
},
[10233] = {
  {
    'Atear fogo no Acampamento Solfúria‡Пожар в форте Ярости Солнца‡Den Sonnenzornposten anzünden‡성난태양 주둔지 방화‡Fuego en el Bastión Furia del Sol‡Fuego en el Bastión Furia del Sol‡Incendier le bastion des Solfurie‡烧毁日怒堡‡燒毀日怒要塞',
    nil,
    'Destrua 4 Balistas Solfúria e 4 barracas Solfúria usando uma Tocha Flamejante. Volte a falar com o Tenente-Feiticeiro Morran, na Vila Kirin\'Var.‡Используя горящий факел, уничтожьте 4 баллисты и 4 шатра в форте Ярости Солнца, затем вернитесь к лейтенанту-чародею Моррану в деревню Кирин\'Вар.‡Benutzt eine flammende Fackel, zerstört 4 Sonnenzornballisten und 4 Sonnenzornzelte und kehrt dann zu Zauberhexerleutnant Morran in Kirin\'Var zurück.‡불타오르는 횃불을 사용하여 성난태양 쇠뇌 4개, 성난태양 막사 4개를 파괴하고 키린바르 마을에 있는 마술사 부관 모란에게 가야 합니다.‡Con una antorcha flameante, destruye 4 balistas Furia del Sol y 4 tiendas Furia del Sol y regresa junto al teniente hechicero Morran en el Poblado Kirin\'Var.‡Con una antorcha llameante, acaba con 4 balistas Furia del Sol y 4 tiendas Furia del Sol y regresa junto al teniente hechicero Morran en el Poblado Kirin\'Var.‡À l\'aide d\'une Torche enflammée, détruisez 4 Balistes Solfurie et 4 Tentes Solfurie, puis retournez voir le lieutenant-ensorceleur Morran à Kirin\'Var.‡使用燃烧的火把烧毁4台日怒弩车和4顶日怒帐篷，然后向肯瑞瓦村的巫师上尉莫尔兰复命。‡使用燃燒的火炬，摧毀4個日怒投石器和4個日怒帳篷後回到肯瑞瓦村莊找莫爾蘭巫士中尉。',
  }
},
[10234] = {
  {
    'Lixo infernal‡Что одному демону мусор...‡Der Müll eines Dämons‡악마의 부품‡Basura del demonio...‡Basura del demonio...‡Le malheur d\'un démon…‡恶魔的垃圾......‡惡魔的垃圾……',
    nil,
    'Colete 10 Peças de Aníquilus e fale novamente com a Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Соберите 10 деталей сквернобота и доставьте их Мамаше Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Sammelt 10 Teile eines Teufelshäschers und bringt sie zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡지옥절단기 부품 10개를 수집한 후 황천의 폭풍의 중앙 생태지구의 중앙 생태지구 주둔지에 있는 휠러 아줌마에게 가져가야 합니다.‡Consigue 10 piezas de atracador vil y llévaselas a Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Consigue 10 piezas de atracador vil y llévaselas a Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Rassemblez 10 Pièces de saccageur gangrené et apportez-les à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡收集10个魔能机甲零件，然后返回虚空风暴的中央生态圆顶，将它们交给中央圆顶哨站的维勒老妈。‡取得10個惡魔搶奪者零件後帶回虛空風暴秘境領地內的領地崗哨交給威勒媽媽。',
  }
},
[10235] = {
  {
    'Sinistragarra desgarrado‡Коготь Рока? Вырвать с мясом!‡Verdammnisklaue die Krallen stutzen‡파멸의 발톱 무력화‡Deszarpar a Zarpaletal‡Deszarpar a Zarpaletal‡Dégriffer Griffe-funeste‡厄运之爪‡殺死末日裂爪',
    nil,
    'Obtenha a Mão de Sinistragarra e leve-a a Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Заберите руку Когтя Рока и доставьте ее Мамаше Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Besorgt Euch Verdammnisklaues Hand und bringt sie zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡파멸의 발톱 갈퀴손을 입수한 후 황천의 폭풍의 중앙 생태지구 내의 중앙 생태지구 주둔지에 있는 휠러 아줌마에게 전달해야 합니다.‡Consigue la Mano de Zarpaletal y entrégasela a Mamá Ruedas en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Consigue la Mano de Zarpaletal y entrégasela a Mamá Ruedas en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Procurez-vous la Main de Griffe-funeste et apportez-la à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡取得厄运之爪的手，然后返回虚空风暴的中央生态圆顶，将它们交给中央圆顶哨站的维勒老妈。‡取得末日裂爪之手然後將它送回虛空風暴裡秘境領地內的領地崗哨給威勒媽媽。',
  }
},
[10236] = {
  {
    'Terralém fede!‡Гадость это ваше Запределье!‡Die Scherbenwelt ist doof‡지긋지긋한 아웃랜드!‡¡Terrallende es un asco!‡¡Terrallende es un asco!‡L\'Outreterre, c\'est nul  !‡外域这烂地方！‡令人討厭的外域!',
    nil,
    'Encontre 6 Peças de Retalhador e fale novamente com o Capataz Razelcraz, na mina a noroeste de Thrallmar.‡Найдите 6 частей крошшера и верните их штейгеру Разлкразу на рудник, который находится к северо-западу от Траллмара.‡Großknecht Razelcraz möchte, dass Ihr ihm 6 Schredderteile besorgt. Kehrt danach zu ihm bei der Mine nordwestlich von Thrallmar zurück.‡절단기 예비 부품 6개를 찾은 후에 스랄마의 북서쪽 광산 옆에 있는 현장감독 라젤크라즈에게 돌아가야 합니다.‡Encuentra 6 piezas de trituradora y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Encuentra 6 piezas de trituradora y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Trouvez 6 Pièces de déchiqueteur et retournez voir le contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡找到6个伐木机备用零件，然后返回萨尔玛西北方的矿洞，将它们交给工头拉泽克拉兹。‡找到六個伐木機零件然後交給索爾瑪西北方的礦坑的工頭瑞絲坎茲。',
  }
},
[10237] = {
  {
    'Avise a Área 52!‡Предупредить Зону 52!‡Warnt Area 52!‡52번 구역에 통보!‡¡Avisa al Área 52!‡¡Avisa al Área 52!‡Avertir la Zone 52 !‡通知52区！‡警告52區!',
    nil,
    'Entregue as más notícias ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Передайте плохие новости ведущему ракетостроителю Фьюзеляжу в Зоне 52 в Пустоверти.‡Überbringt Raketenchef Doppeldecker in Area 52 in Nethersturm die schlechten Nachrichten.‡황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 지옥절단기 건축 설명서와 함께 좋지 않은 소식을 전해야 합니다.‡Entrega el manual de construcción de atracadores viles y lleva las malas noticias al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Entrega el manual de construcción de atracadores viles y lleva las malas noticias al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Annoncez la mauvaise nouvelle au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将坏消息告诉虚空风暴52区的火箭主管弗斯拉格。‡傳遞這個壞消息給虛空風暴內52區的火箭主管夫斯拉吉知道。',
  }
},
[10238] = {
  {
    'Como servir goblins‡Каково работать на гоблинов‡Wie man Goblins dient‡고블린을 돕는 법‡Cómo servir a los goblins‡Cómo servir a los goblins‡Comment servir le gobelin‡如何为地精效力‡如何服務哥布林',
    nil,
    'Resgate Manni, Mô e Jakk do acampamento orc vil e fale novamente com o Capataz Razelcraz, na mina a noroeste de Thrallmar.‡Спасите Манни, Моха и Джакка из лагерей орков Скверны и доставьте их штейгеру Разлкразу на рудник, который находится к северо-западу от Траллмара.‡Rettet Manni, Moh und Jakk aus den Lagern der Höllenorcs und bringt sie zu Großknecht Razelcraz bei der Mine nordwestlich von Thrallmar zurück.‡타락한 오크 야영지에서 만니, 모흐, 자크를 구출한 후에 스랄마의 북서쪽 광산 옆에 있는 현장감독 라젤크라즈에게 돌아가야 합니다.‡Rescata a Manni, Moh y Jakk de los campamentos de los orcos viles y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Rescata a Manni, Moh y Jakk de los campamentos de los orcos viles y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Sauvez Manni, Moh et Jakk des camps des gangr\'orcs et retournez voir le contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡从邪兽人的营地中救出曼尼、莫恩和雅克，然后返回萨尔玛西北方的矿洞，向工头拉泽克拉兹复命。‡從魔獄獸人營地救回曼尼、莫歐還有杰克然後回到索爾瑪西北方的礦坑找工頭瑞絲坎茲。',
  }
},
[10239] = {
  {
    'Fonte potencial de energia‡Потенциальный источник энергии‡Mögliche Energiequelle‡잠재적인 마력의 원천‡Fuente de energía potencial‡Fuente de energía potencial‡Une source d\'énergie potentielle‡强大的能量源‡潛在的能量來源',
    nil,
    'O Tenente-Feiticeiro Morran, na Vila Kirin\'Var quer que você capture 10 Cubos de Isolamento de Energia nas operações dos elfos sangrentos, em Manaforja Coruu.‡Лейтенант-чародей Морран из деревни Кирин\'Вар просит вас захватить 10 энергетических кубов-изоляторов, используемых эльфами крови в манагорне Коруу.‡Zauberhexerleutnant Morran in Kirin\'Var möchte, dass Ihr ihm 10 Energieisolationswürfel von den Blutelfen der Manaschmiede Coruu bringt.‡키린바르 마을의 마술사 부관 모란이 코루 마나괴철로에서 일하는 블러드 엘프로부터 마력 분리 용기 10개를 입수해 달라고 했습니다.‡El teniente hechicero Morran en el Poblado Kirin\'Var quiere que captures 10 cubos de aislamiento de energía de los elfos de sangre en la Forja de Maná Coruu.‡El teniente hechicero Morran en el Poblado Kirin\'Var quiere que captures 10 cubos de aislamiento de energía de los elfos de sangre en la Forja de Maná Coruu.‡Le lieutenant-ensorceleur Morran de Kirin\'Var veut que vous vous empariez de 10 Cubes d\'isolation à énergie dans les exploitations des Elfes de sang de la manaforge Coruu.‡肯瑞瓦村的巫师上尉莫尔兰要你前往法力熔炉：库鲁恩，取回10块能量隔离器。‡肯瑞瓦村莊的莫爾蘭巫士中尉要你去從法力熔爐寇魯的血精靈行動中奪取10個能量隔離體回來。',
  }
},
[10240] = {
  {
    'Estabelecer o perímetro‡Постройка периметра‡Eine Verteidigung errichten‡새로운 보호막 만들기‡Construyendo un perímetro‡Construyendo un perímetro‡Établir un périmètre‡构筑能量壁障‡建立結界',
    nil,
    'Use o Dispositivo de Ativação Rúnica próximo da Runa Leste, da Runa Nordeste e da Runa Oeste. As runas encontram-se no perímetro dos distritos do Estreito do Teurgo e da praça da cidade da Vila Kirin\'Var. Fale novamente com o Tenente-Feiticeiro Morran assim que completar a missão.‡Используйте устройство пробуждения рун поблизости от восточной, северо-восточной и западной руны. Руны можно найти по периметру районов переулка Волшебников и главной площади деревни Кирин\'Вар. По завершении задачи вернитесь к лейтенанту-чародею Моррану.‡Benutzt das Gerät zur Aktivierung von Runen bei der östlichen Rune, der nordöstlichen Rune und der westlichen Rune. Die Runen befinden sich entlang der Verteidigung der Zaubergasse und des Ratsplatz von Kirin\'Var. Kehrt zu Zauberhexerleutnant Morran zurück, wenn Ihr die Aufgabe erfüllt habt.‡키린바르 마을의 마법사 지구와 광장 주변에서 볼 수 있는 동쪽, 북동쪽, 서쪽에 있는 키린바르 룬에 룬 활성화 장치를 사용하여 임무를 완수한 후 마술사 부관 모란에게 가야 합니다.‡Utiliza el aparato de activación de runa cerca de la runa del este, la runa del noroeste y la runa del oeste. Puedes encontrar las runas alrededor del perímetro del Pasaje del Zahorí y la Plaza de la Ciudad del Poblado Kirin\'Var. Ve a ver al teniente hechicero Morran cuando hayas completado la tarea.‡Utiliza el aparato de activación de runa cerca de la runa del este, la runa del noroeste y la runa del oeste. Puedes encontrar las runas alrededor del perímetro del Pasaje del Zahorí y la Plaza de la Ciudad del Poblado Kirin\'Var. Ve a ver al teniente hechicero Morran cuando hayas completado la tarea.‡Utilisez le Mécanisme d\'activation des runes près de la Rune est, la Rune nord-est et la Rune ouest. Ces runes se trouvent quelque part autour des quartiers de l\'Allée des sorciers et de la Place centrale de Kirin\'Var. Retournez voir le lieutenant-ensorceleur Morran une fois que vous aurez accompli cette tâche.‡对东部符文、东北部符文和西部符文使用符文激活装置。你可以在肯瑞瓦村城镇广场和巫师街周边找到这些符文。完成任务后向巫师上尉莫尔兰复命。‡在東邊符文，東北邊符文，以及西邊符文附近使用符文啟動裝置。這些符文能夠在肯瑞瓦村莊的巫士街及小鎮廣場區週邊找到。完成任務後回去找莫爾蘭巫士中尉。',
  }
},
[10241] = {
  {
    'Distrações em Manaforja B\'naar‡Отвлекающий маневр в манагорне Б\'наар‡Ablenkung in der Manaschmiede B\'naar‡브나르 마나괴철로 교란‡Distracción en la Forja de Maná B\'naar‡Distracción en la Forja de Maná B\'naar‡Diversion à la manaforge B\'naar‡削弱法力熔炉：布纳尔‡法力熔爐巴納爾的擾亂行動',
    nil,
    'Mate 8 Magísteres Solfúria e 8 Guardas de Sangue Solfúria. Em seguida, fale novamente com o Exarca Orelis, na Área 52.nnCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Убейте 8 магистров и 8 кровостражей клана Ярости Солнца, затем возвращайтесь к экзарху Орелису в Зону 52.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Tötet 8 Magister des Sonnenzorns und 8 Blutwärter des Sonnenzorns und kehrt dann zu Exarch Orelis in Area 52 zurück.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Ruf bei den Sehern.‡성난태양 마법학자 8명과 성난태양 붉은경비병 8명을 처치한 후 52번 구역에 있는 총독 오렐리스에게 가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Mata 8 magistri Furia del Sol y 8 depositarios de sangre Furia del Sol. Después vuelve a ver al exarca Orelis en el Área 52.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Mata 8 magistri Furia del Sol y 8 depositarios de sangre Furia del Sol. Después vuelve a ver al exarca Orelis en el Área 52.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Tuez 8 Magistères Solfurie et 8 Garde-sang Solfurie puis retournez voir l\'exarque Orelis dans la Zone 52.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡杀死8名日怒魔导师和8名日怒血卫士，然后向52区的大主教欧雷里斯复命。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡殺掉8個日怒博學者及8個日怒血守衛，完成後回到52區找主教歐瑞利斯。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10242] = {
  {
    'Acampamento Quebra-espinha‡Застава Хребтолома‡Der Rückenbrecherposten‡해골망치 초소‡La Avanzada Rompeloma‡La Avanzada Rompeloma‡Le poste de Brise-échine‡断背岗哨‡斷脊氏族崗哨',
    nil,
    'A Boticária Zenóbia, no Posto dos Destroços, quer que você peça ao Comandante de Ala Brack uma mantícora para voar até o Acampamento Quebra-espinha e, uma vez lá, que você entregue a Amostra de Sangue de Olhos Sangrentos ao Boticário Alberto no Acampamento Quebra-espinha.‡Доставьте образец крови орков из клана Кровавой Глазницы аптекарю Альбреку на заставу Хребтолома по просьбе аптекаря Зеланы из Погибели Сквернобота. Чтобы добраться до заставы на виверне, обратитесь к командиру звена Бракку.‡Apothekerin Zelana beim Häschersturz möchte, dass Ihr mit Schwadronskommandant Brack sprecht, um auf einem Flügeldrachen zum Rückenbrecherposten zu fliegen. Bringt die Blutprobe des Blutenden Auges zu Apotheker Albreck im Rückenbrecherposten.‡지옥절단기 함락지에 있는 연금술사 젤라나가 편대사령관 브락크와 대화해 와이번을 타고 해골망치 초소로 간 다음, 그곳에 있는 연금술사 알브렉에게 피눈물 부족 혈액 견본을 전해 달라고 했습니다.‡La boticaria Zelana en la Caída del Atracador Vil, quiere que hables con el comandante del aire Brack para coger un dracoleón hasta la Avanzada Rompeloma y llevar la muestra de sangre Foso Sangrante al boticario Albreck en la Avanzada Rompeloma.‡La boticaria Zelana en la Caída del Atracador Vil, quiere que hables con el comandante del aire Brack para coger un dracoleón hasta la Avanzada Rompeloma y llevar la muestra de sangre Foso Sangrante al boticario Albreck en la Avanzada Rompeloma.‡L\'Apothicaire Zelana du Trépas du saccageur vous a demandé de parler au Chef d\'escadrille Brack et de prendre une wyverne pour rallier le Poste de Brise-échine, puis de remettre l\'Échantillon de sang de l\'Orbite-sanglante à l\'apothicaire Albreck au Poste de Brise-échine.‡机甲残骸的药剂师塞兰娜要你与空军指挥官布拉克谈一谈，搭乘双足飞龙前往断背岗哨，并将血环血样交给断背岗哨的药剂师阿尔布雷克。‡搶奪者荒野的藥劑師席蓮娜要你和空軍指揮布拉克談談以搭乘雙足翼龍到斷脊氏族崗哨，把血之谷鮮血樣本帶給斷脊氏族崗哨的藥劑師艾柏瑞克。',
  }
},
[10243] = {
  {
    'Tecnologia naaru‡Технология наару‡Die Technologie der Naaru‡나루의 기술‡Tecnología naaru‡Tecnología naaru‡Technologie naaru‡纳鲁科技‡那魯的技術',
    nil,
    'Entre em Manaforja B\'naar e encontre o Painel de Controle de B\'naar.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Зайдите в манагорн Б\'наар и найдите панель управления манагорном.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Geht in die Manaschmiede B\'naar und sucht die Steuerkonsole von B\'naar.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡브나르 마나괴철로 안으로 들어가서 브나르 제어장치를 찾아야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Entra en la Forja de Maná B\'naar y encuentra la consola de control B\'naar.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entra en la Forja de Maná B\'naar y encuentra la consola de control B\'naar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entrez dans la manaforge B\'naar et trouvez la Console de contrôle B\'naar.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡进入法力熔炉：布纳尔，找到布纳尔控制台。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡進入法力熔爐巴納爾找到巴納爾控制臺。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10244] = {
  {
    'R.T.F.R.C.M.‡Учи матчасть!‡Liesmich‡‡R.T.F.R.C.M.‡‡R.T.F.M.C.S.‡DEPRECATED‡惡魔搶奪者製造手冊',
    nil,
    'Take the Fel Reaver Construction Manual to Mama Wheeler at the Midrealm Post inside Eco-Dome Midrealm in the Netherstorm.‡Отнесите инструкцию по созданию сквернобота Мамаше Колесун, находящейся на Заставе срединных земель в заповеднике "Срединные земли" в Пустоверти.‡Bringt die Bauanleitung für Teufelshäscher zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡‡Lleva el manual de construcción de atracadores viles a Mamá Ruedas en el Puesto de la Tierra Media, dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Lleva el manual de construcción de atracadores viles a Mamá Ruedas en el Puesto de la Tierra Media, dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Apportez le Manuel de construction du saccageur gangrené à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡将Fel Reaver Construction Manual带给虚空风暴中央生态圆顶内的Mama Wheeler。‡將惡魔搶奪者製造手冊帶到虛空風暴的秘境領地裡的領地崗哨給威勒媽媽。',
  }
},
[10245] = {
  {
    'Transcrição do painel de B\'naar‡Описание панели управления Б\'наара‡Steuerungsabschrift von B\'naar‡브나르 제어장치 필사본‡Trascripción de la consola de B\'naar‡Trascripción de la consola de B\'naar‡La transcription de la console de B\'naar‡布纳尔控制台拓文‡巴納爾控制臺謄本',
    nil,
    'Leve a Transcrição do painel de B\'naar à Anacoreta Karja, na Área 52, em Eternévoa.nnCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Передайте описание панели управления Б\'наара анахорету Карже в Зону 52 в Пустоверти.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt die Steuerungsabschrift von B\'naar zu Anachoret Karja in Area 52 im Nethersturm.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡황천의 폭풍의 52번 구역에 있는 수도자 카르자에게 브나르 제어장치 필사본을 전해야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Entrega la trascripción de consola B\'naar a la Anacoreta Karja del Área 52, en Tormenta Abisal.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entrega la trascripción de consola B\'naar a la Anacoreta Karja del Área 52, en Tormenta Abisal.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez la Transcription de la console de B\'naar à l\'anachorète Karja dans la Zone 52 au Raz-de-Néant.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将布纳尔控制台拓文交给虚空风暴52区的学者卡尔亚。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡將巴納爾控制臺謄本傳送到虛空風暴的52區給隱士卡爾加。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10246] = {
  {
    'Manaforja Coruu sob ataque‡Нападение на манагорн Коруу‡Angriff auf Manaschmiede Coruu‡코루 마나괴철로 공격‡Ataque a la Forja de Maná Coruu‡Ataque a la Forja de Maná Coruu‡Attaquer la manaforge Coruu‡攻击法力熔炉：库鲁恩‡攻擊法力熔爐寇魯',
    nil,
    'Viaje até Manaforja Coruu e mate 8 Arcanistas Solfúria e 5 Pesquisadores Solfúria. Fale novamente com o Exarca Orelis quando houver cumprido a tarefa.nnCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Отправляйтесь к манагорну Коруу и убейте 8 чародеев и 5 ученых из армии Ярости Солнца. По завершении задачи возвращайтесь к экзарху Орелису.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Coruu und tötet 8 Arkanisten des Sonnenzorns und 5 Forscher des Sonnenzorns. Kehrt zu Exarch Orelis zurück, wenn Ihr Eure Aufgabe erledigt habt.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡코루 마나괴철로로 가서 성난태양 신비술사 8명과 성난태양 연구원 5명을 처치한 후 총독 오렐리스에게 가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Coruu y mata 8 arcanistas Furia del Sol y 5 investigadores Furia del Sol. Vuelve a hablar con el exarca Orelis cuando hayas cumplido esta misión.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Coruu y mata 8 arcanistas Furia del Sol y 5 investigadores Furia del Sol. Vuelve a hablar con el exarca Orelis cuando hayas cumplido esta misión.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Partez pour la manaforge Coruu et tuez 8 Arcanistes solfurie et 5 Chercheurs solfurie. Retournez voir l\'exarque Orelis lorsque vous aurez accompli cette tâche.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：库鲁恩，杀死8名日怒奥术师和5名日怒研究员，完成任务后向大主教欧雷里斯复命。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐寇魯去殺掉8個日怒大法師及5個日怒調查員。完成後回報給主教歐瑞利斯。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10247] = {
  {
    'Doutor Vômisa, Ph.T.‡Вомиза, доктор псевдотехнических наук‡Dr. h. c. tüft. Vomisa‡공학박사 보미사‡Doctor Vomisa, Ph.T.‡‡Le docteur Vomisa, Ph.T.‡工程学博士沃米萨‡莫米沙博士',
    nil,
    'Fale com o Doutor Vômisa, Ph.T., no Campo de Testes, em Eternévoa.‡Поговорите с доктором псевдотехнических наук Вомизой на Испытательном полигоне в Пустоверти.‡Sprecht mit Dr. h. c. tüft. Vomisa in den Versuchsgründen im Nethersturm.‡황천의 폭풍의 발명품 실험장에 있는 공학박사 보미사와 대화해야 합니다.‡Entrega el manual de construcción de atracadores viles al doctor Vomisa Ph.T. en el terreno de pruebas, en la Tormenta Abisal.‡Entrega el manual de construcción de atracadores viles al doctor Vomisa Ph.T. en el terreno de pruebas, en la Tormenta Abisal.‡Allez voir le docteur Vomisa, Ph.T. au Terrain d\'essai du Raz-de-Néant.‡与虚空风暴实验场的工程学博士沃米萨谈一谈。‡去虛空風暴的試煉場裡和莫米沙博士交談。',
  }
},
[10248] = {
  {
    'Você, robô‡Ты, робот‡Du, der Roboter‡고철절단기 X6000‡Tú, Robot‡Tú, Robot‡Toi, le robot‡你，机器人‡你，機器人',
    nil,
    'Ative o Controle do Aniquilata X6000 e teste suas capacidades. Em seguida, faça um relatório para o Doutor Vômisa, Ph.T, no Campo de Testes, em Eternévoa. Cuide de todos os problemas que surgirem.‡Активируйте пульт управления "Утилизатора Х6000" и проверьте его возможности. Затем передайте результаты доктору псевдотехнических наук Вомице, находящемуся на испытательном полигоне в Пустоверти. Если возникнут проблемы, разберитесь с ними..‡Aktiviert die Steuerung für Schrotthäscher X6000 und testet seine Fähigkeiten aus. Gebt Dr. h. c. tüft. Vomisa bei den Versuchsgründen im Nethersturm danach Eure Rückmeldung.‡소지품에 있는 조종기로 고철절단기 X6000을 작동하여 성능을 시험하면서 발생하는 일을 처리한 후, 황천의 폭풍의 발명품 실험장에 있는 공학박사 보미사에게 결과를 알려줘야 합니다.‡Activa el Atracador desguazador X6000 y prueba todas sus funciones. Después informa al doctor Vomisa, Ph.T en el Terreno de Pruebas de Tormenta Abisal. Encárgate de cualquier problema que pueda surgir.‡Activa el Atracador desguazador X6000 y prueba todas sus funciones. Después informa al doctor Vomisa, Ph.T en el Terreno de Pruebas de Tormenta Abisal. Encárgate de cualquier problema que pueda surgir.‡Activez les Commandes du saccageur ferrailleur X6000 et testez-en les fonctionnalités. Puis faites part de vos impressions au docteur Vomisa, Ph.T. sur le Terrain d\'essai de Raz-de-Néant. Réglez tout problème qui se ferait jour.‡启动再造机甲X6000型控制器并测试其性能，灵活应对测试过程中的突发状况。然后向虚空风暴实验场的工程学博士沃米萨汇报实验结果。‡啟動廢料搶奪者X6000搖控器然後測試它的功能。然後將你的測試結果回報給虛空風暴的試煉場的莫米沙博士。應付所有發生的問題。',
  }
},
[10249] = {
  {
    'De volta ao Chefe!‡Обратно к командующему!‡Zurück zum Chef!‡로켓발사단장에게 돌아가기!‡¡El jefe de nuevo!‡¡El jefe de nuevo!‡On retourne voir le chef !‡去找火箭主管！‡回去找主管!',
    nil,
    'Apresente-se ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa, imediatamente!‡Немедленно явитесь к ведущему ракетостроителю Фьюзеляжу в Зону 52 в Пустоверти!‡Meldet Euch sofort bei Raketenchef Doppeldecker in Area 52 im Nethersturm!‡지금 당장 황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 보고해야 합니다!‡Preséntate inmediatamente ante el jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Preséntate inmediatamente ante el jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Retournez voir immédiatement le Chef-de-fusée Karlingue, dans la Zone 52 de Raz-de-Néant !‡立刻向虚空风暴52区的火箭主管弗斯拉格报到！‡馬上回報給在虛空風暴裡52區的火箭主管夫斯拉吉。',
  }
},
[10250] = {
  {
    'Vingança sangrenta‡Кровавая месть‡Blutige Rache‡피의 복수‡Venganza sangrienta‡Venganza sangrienta‡Vengeance sanglante‡血之复仇‡血腥的復仇',
    nil,
    'Toque a Trompa de Batalha dos Obstinados perto do Estandarte da Aliança. Mate Urtrak e então fale novamente com Althen, o Historiador, no Acampamento Quebra-espinha.‡Подуйте в боевой рог Непреклонных рядом со знаменем Альянса. Убейте Уртрака и возвращайтесь к Альтену Историку на Заставу Хребтолома.‡Stoßt am alten Belagerungsturm der Allianz in das Kampfhorn der Unerschütterlichen. Tötet Urtrak und kehrt danach zu Althen dem Historiker im Rückenbrecherposten zurück.‡얼라이언스 깃발 근처에서 불굴의 전투 뿔피리를 부십시오. 우트락을 처치한 다음 해골망치 초소에 있는 역사가 알센에게 가야 합니다.‡Haz que suene el cuerno de batalla Implacable cerca del estandarte de la Alianza. Mata a Urtrak y vuelve a hablar con Althen el historiador en la Avanzada Rompeloma.‡Haz que suene el cuerno de batalla Implacable cerca del estandarte de la Alianza. Mata a Urtrak y vuelve a hablar con Althen el historiador en la Avanzada Rompeloma.‡Sonnez le Cor de bataille des Inflexibles près de la bannière de l\'Alliance. Tuez Urtrak puis retournez voir Althen l\'Historien au Poste de Brise-échine.‡在联盟战旗附近吹响顽强战斗号角。然后杀死乌尔特拉克，并向断背岗哨的史学家奥尔森复命。‡在聯盟軍旗附近吹響不屈戰爭號角。殺掉烏崔克後回到斷脊氏族崗哨找歷史家亞登。',
  }
},
[10251] = {
  {
    'O plano magistral do amo?‡Великий замысел господина?‡Der große Plan des Meisters?‡주인님의 위대한 계획?‡¿La obra maestra del maestro?‡¿La obra maestra del maestro?‡Le Grand Dessein Du Maître ?‡主人的伟大设计？‡大師的偉大設計?',
    nil,
    'Encontre Nitrin, o Erudito na Armaria Abandonada em Nagrand.‡Найдите Нитрина Сведущего в Заброшенной оружейной в Награнде.‡Sucht Nitrin den Gelehrten im verlassenen Rüstlager in Nagrand.‡나그란드의 버려진 무기고에서 학자 니트린을 찾아야 합니다.‡Encuentra a Nitrin el Erudito en la Armería Abandonada, en Nagrand.‡Encuentra a Nitrin el Erudito en la Armería Abandonada, en Nagrand.‡Trouvez Nitrin l\'Instruit à l\'Armurerie abandonnée en Nagrand.‡前往纳格兰废弃的军械库寻找博学者尼特林的下落。‡找到在納葛蘭被遺棄的軍械庫的博學者奈崔恩。',
  }
},
[10252] = {
  {
    'Visão dos mortos‡Посмотри в глаза мертвым‡Vision der Toten‡죽은 자를 보는 눈‡Visión de los muertos‡Visión de los muertos‡Vision des morts‡亡者的视界‡死者的視界',
    nil,
    'Nitrin, no Arsenal Abandonado em Nagrand, quer que você leve até ele 1 Olho de Gronn da Montanha, 1 Bico Perfeito de Roca-dos-ventos Maior e 1 Naco de Fenoceronte Idoso.‡Принесите Нитрину из Заброшенной оружейной Награнда 1 глаз горного гронна, 1 безупречный клюв большого вертуха и 1 сальник старого копытня.‡Nitrin im verlassenen Rüstlager in Nagrand möchte, dass Ihr ihm 1 Augapfel eines Berggronns, 1 fehlerloser Schnabel eines großen Windrocs und 1 Tran eines gealterten Grollhufs bringt.‡나그란드의 버려진 무기고에 있는 니트린이 산악 그론의 눈 1개, 거대한 바람올빼미의 온전한 부리 1개, 늙은 갈래발굽의 지방덩어리 1개를 가져다 달라고 부탁했습니다.‡Nitrin, en la Armería Abandonada, en Nagrand, quiere que le lleves 1 globo ocular de gronn montés, 1 pico de vientorroc superior perfecto y 1 grasa de uñagrieta envejecido.‡Nitrin, en la Armería Abandonada, en Nagrand, quiere que le lleves 1 globo ocular de gronn montés, 1 pico de vientorroc superior perfecto y 1 grasa de uñagrieta envejecido.‡Nitrin, à l\'Armurerie abandonnée en Nagrand, veut que vous lui rameniez 1 Globe oculaire de Gronn des montagnes, 1 Bec de Venteroc supérieur sans défaut et 1 Poche de graisse de vieux sabot-fourchu.‡收集1颗山丘戈隆的眼球、1个完美的大型风鹏之喙和1份老迈裂蹄牛的脂肪，然后返回纳格兰废弃的军械库，把它们交给尼特林。‡納葛蘭裡被遺棄的軍械庫的奈崔恩要你為他帶來1個山地古羅眼珠，1個無瑕的巨型風翼貓頭鷹之啄和1份老邁的裂蹄油。',
  }
},
[10253] = {
  {
    'Levixus o evocador de almas‡Левиксус Призыватель Душ‡Levixus der Seelenrufer‡영혼의 소환사 레비주스‡Levixus el Invocador de Almas‡Levixus el Invocador de Almas‡Levixus le Mandeur d\'âme‡唤魂者利维休斯‡靈魂呼喚者勒威薩斯',
    nil,
    'Extermine Levixus e tire o Livro dos Mortos dele.nnEntregue o Livro dos Mortos a Ramdor, o Louco, na entrada das Catacumbas Auchenai, em Auchindoun.nnVocê prometeu, lembra?‡Убейте Левиксуса и заберите у него Книгу Мертвых.nnОтнесите Книгу Рамдору Безумному, который находится неподалеку от входа в Аукенайские гробницы в Аукиндоне.nnВы ведь с ним об этом договаривались, помните?‡Vernichtet Levixus und nehmt Euch das Buch der Toten aus seinem Besitz.nnBringt das Buch der Toten zu Ramdor dem Wahnsinnigen außerhalb der Auchenaikrypta am Eingang zu Auchindoun.nnIhr hattet eine Vereinbarung, erinnert Ihr Euch?‡레비주스를 해치우고 사자의 책을 빼앗아야 합니다.nn아킨둔의 아키나이 납골당 입구 바깥에 서 있는 광기의 람도르에게 그 책을 전해주어야 합니다.nn설마 약속을 잊지는 않았겠죠?‡Destruye a Levixus y coge el libro de los muertos.nnEntrega el libro de los muertos a Ramdor el Loco fuera de las Criptas Auchenai, en la entrada de Auchindoun.nnTenías un trato, ¿lo recuerdas?‡Destruye a Levixus y coge el libro de los muertos.|n|nEntrega el libro de los muertos a Ramdor el Loco fuera de las Criptas Auchenai, en la entrada de Auchindoun.|n|nTenías un trato, ¿lo recuerdas?‡Tuez Levixus et prenez-lui le Livre des morts.nnApportez le Livre des morts à Ramdor le Fol à l\'extérieur des Cryptes Auchenaï, à l\'entrée d\'Auchindoun.nnVous aviez passé un marché, vous vous souvenez ?‡杀死利维休斯，夺得亡者之书。nn将亡者之书交给疯狂的拉姆杜尔，他就站在奥金顿的奥金尼地穴入口外。nn你们之间有协议的，还记得吗？‡殺掉勒威薩斯並且取走他的亡者之書。|n將亡者之書交付給在奧齊頓的奧奇奈地穴入口外的瘋狂的藍姆多。|n你有一個交易，記得嗎?',
  }
},
[10254] = {
  {
    'Comandante-chefe Danath‡Командир армии Данат‡Truppenkommandant Danath‡전투사령관 다나스‡Comandante en Jefe Danath‡Comandante en jefe Danath‡Le commandant Danath‡指挥官达纳斯‡軍隊指揮官達納斯·托爾貝恩',
    nil,
    'O Marechal Isildor quer que você se apresente ao Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Доставьте по приказу маршала Исилдора донесение командиру армии Данату Троллебою в Оплот Чести.‡Marschall Isildor möchte, dass Ihr Euch bei Truppenkommandant Danath Trollbann in der Ehrenfeste meldet.‡치안대장 이실도르가 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 보고해 달라고 부탁했습니다.‡El mariscal Isildor quiere que te presentes ante el Comandante en Jefe Danath Aterratrols en el Bastión del Honor.‡El mariscal Isildor quiere que te presentes ante el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Le maréchal Isildor veut que vous vous présentiez au commandant de corps Danath Trollemort au bastion de l\'Honneur.‡伊斯多尔元帅要求你向荣耀堡的远征军指挥官达纳斯·托尔贝恩报到。‡治安官伊斯歐朵爾要你向榮譽堡的軍隊指揮官達納斯·托爾貝恩回報。',
  }
},
[10255] = {
  {
    'Testando o antídoto‡Проверка противоядия‡Das Gegengift testen‡치료제 시험‡Pruebas de antídoto‡Pruebas de antídoto‡Tester l\'antidote‡测试解毒剂‡測試解毒劑',
    nil,
    'Use o Antídoto Cenariano em um Javiltusco Parrudo e observe os resultados. Assim que você obtiver os resultados do experimento, fale novamente com Tiá Juba Rubra, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Введите кенарийское противоядие крупному зловепрю и пронаблюдайте за результатом. После проведения эксперимента возвращайтесь к Тие Рыжей Гриве на Кенарийскую заставу на полуострове Адского Пламени.‡Probiert das cenarische Gegengift an einem titanischen Hölleneber aus und beobachtet die Folgen. Sobald Ihr die Ergebnisse des Experiments habt, kehrt zu Thiah Rotmähne im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡덩치큰 지옥멧돼지에게 세나리온 치료제를 사용하고 효과를 지켜보고 실험의 결과를 얻어낸 후, 지옥불 반도의 세나리온 초소에 있는 타이아 레드메인에게 돌아가야 합니다.‡Usa el antídoto Cenarion sobre un jabinferno descomunal y observa sus efectos. Cuando tengas los resultados del experimento, regresa junto a Thiah Melenarroja del Puesto Cenarion, en la Península del Fuego Infernal.‡Usa el antídoto Cenarion sobre un jabinferno descomunal y observa sus efectos. Cuando tengas los resultados del experimento, regresa junto a Thiah Melenarroja del Puesto Cenarion, en la Península del Fuego Infernal.‡Administrez l\'Antidote cénarien à un Sanglier infernal massif et observez le résultat. Une fois l\'expérience terminée, retournez voir Thiah Crin-rouge au Poste cénarien dans la péninsule des Flammes infernales.‡对笨拙的地狱野猪使用塞纳里奥解毒剂，并观察解毒剂的效果。然后返回地狱火半岛的塞纳里奥哨站，向塞安·红鬃汇报实验的结果。‡將恐牙的鮮血樣本使用在地獄野豬身上並觀察結果。一旦你知道實驗的結果後，回到地獄火半島的塞納里奧前哨找塞伊亞·紅髮。',
  }
},
[10256] = {
  {
    'A senhora da chave encontrada‡Найти Хранителя Ключей‡Den Schlüsselmeister finden‡열쇠지기 찾기‡Buscando a la Maestra de llaves‡Buscando a la Maestra de llaves‡Trouver le Maître des clés‡钥匙的主人‡找到鑰匙持有者',
    nil,
    'Localize Ápice e obtenha o Cristal Focal do Ápice. Retorne à Torre Violeta e use o Cristal Focal do Ápice próximo do orbe do Arquimago Vargoth para descobrir quem possui a chave para quebrar a maldição da torre.‡Выследите Камнегора и заберите у него кристальное средоточие. Вернитесь к Сиреневой башне и используйте кристальное средоточие Камнегора поблизости от шара верховного мага Варгота для того, чтобы обнаружить, у кого хранятся ключи от проклятия башни.‡Sucht Apex und besorgt Euch Apex\' Kristallfokus. Kehrt dann zum violetten Turm zurück und benutzt Apex\' Kristallfokus in der Nähe von Erzmagier Vargoths Kugel um herauszufinden, wer den Schlüssel zum Fluch des Turms hat.‡에이펙스를 찾아서 에이펙스의 수정 초점을 입수하여 자줏빛 탑으로 돌아간 후, 바르고스의 수정구슬 근처에서 에이펙스의 수정 초점을 사용하여 탑의 저주를 풀 수 있는 열쇠를 누가 가지고 있는지 알아내야 합니다.‡Encuentra a Cumbre y quítale un foco de cristal de Cumbre. Ve a la Torre Violeta y úsalo cerca del orbe del archimago Vargoth para descubrir quién tiene la llave para romper la maldición de la torre.‡‡Trouvez Apex et procurez-vous un Focalisateur en cristal d\'Apex. Retournez à la Tour pourpre et utilisez le Focalisateur à proximité de l\'Orbe de l\'archimage Vargoth pour découvrir qui détient la clé qui permettra de lever la malédiction pesant sur la tour.‡找到阿匹克斯并夺得阿匹克斯的聚焦水晶，然后返回紫罗兰之塔，在大法师瓦格斯的宝珠旁使用阿匹克斯的聚焦水晶，查明破除塔内诅咒的钥匙在谁手中。‡找到艾派斯巨人並且從他那裡取得艾派斯巨人的水晶集中。回到紫蘿蘭之塔並且在大法師 瓦戈斯的寶珠附近使用艾派斯巨人的水晶集中，以找出誰握有打斷那些塔之詛咒的關鍵。',
  }
},
[10257] = {
  {
    'A captura da pedra-chave‡Захват краеугольного камня‡Den Schlüsselstein erobern‡쐐기돌 찾기‡La piedra angular‡La piedra angular‡S\'emparer de la Pierre cruciale‡夺回钥石‡取得拱心石',
    nil,
    'Aventure-se na estufa da Bastilha da Tormenta e consiga a chave de pedra da Comandante Sarannis. Traga-a ao Arquimago Vargoth, na Torre Violeta.‡Проникните в Ботанику в Крепости Бурь и заберите ключ у командира Сараннис. Отнесите ключ верховному магу Варготу в Аметистовую башню.‡Reist zur Botanika der Festung der Stürme und besorgt Euch den Schlüsselstein von Kommandant Sarannis. Bringt ihn danach zu Erzmagier Vargoth im violetten Turm.‡폭풍우 요새의 신록의 정원으로 가서 지휘관 새래니스에게서 쐐기돌을 되찾은 후, 보랏빛 탑에 있는 대마법사 바르고스에게 가져가야 합니다.‡Adéntrate en El Invernáculo de El Castillo de la Tempestad y recupera la piedra angular de la comandante Sarannis. Llévasela al archimago Vargoth en la Torre Violeta.‡Adéntrate en El Invernáculo de El Castillo de la Tempestad y recupera la piedra angular de la comandante Sarannis. Llévasela al archimago Vargoth en la Torre Violeta.‡Entrez dans la Botanica du donjon de la Tempête et prenez la Pierre cruciale au commandant Sarannis. Apportez-la à l\'archimage Vargoth à la Tour pourpre.‡进入风暴要塞的生态船，从指挥官萨拉妮丝手中夺得钥石，将它交给紫罗兰之塔的大法师瓦格斯。‡冒險進入風暴要塞的波塔尼卡從指揮官薩瑞尼斯身上取回拱心石。將它帶給紫蘿蘭之塔的大法師瓦戈斯。',
  }
},
[10258] = {
  {
    'Honre os caídos‡Честь Павших‡Die Gefallenen ehren‡쓰러진 병사를 기리며‡Honrar a los caídos‡Honrar a los caídos‡Honorer les morts‡逝者的荣耀‡榮耀失落者',
    nil,
    'Apresente-se ao Comandante Hogarth no Arsenal da Expedição.‡Явитесь к командиру Хогарду, который находится в оружейной экспедиции.‡Meldet Euch bei Hogarth, dem Kommandanten des Expeditionsrüstlagers.‡원정대 무기고의 지휘관 호가스를 찾아가 보고해야 합니다.‡Preséntate al comandante Hogarth en la Armería de Expedición.‡Preséntate al comandante Hogarth en la Armería de Expedición.‡Présentez-vous au commandant Hogarth à l\'Armurerie de l\'expédition.‡向远征军物资库的指挥官霍加斯报到。‡向遠征隊軍械庫的指揮官霍卡爾斯回報。',
  }
},
[10259] = {
  {
    'Into the Breach‡Битва в Проломе‡Auf in den Kampf!‡난국 타개‡Cruzando la brecha‡Abriendo brecha‡Dans la brèche‡勇往直前‡進入裂縫中',
    nil,
    'Mate 6 Guardas Vis Invasores e fale novamente com o Emissário Argênteo Bembrioso.‡Убейте 6 вторгшихся стражей Скверны и затем вернитесь к посланнику ордена Серебряного Рассвета Праудвелл.‡Tötet 6 einfallende Teufelswachen und kehrt dann zum Argentumabgesandten Stolzbrunn zurück.‡들이닥친 지옥수호병 6마리를 처치한 후 대리인 프라우드웰에게 돌아가야 합니다.‡Mata 6 guardias viles incursores e informa al emisario Argenta Pozobravo.‡Mata 6 guardias viles incursores e informa al emisario Argenta Pozobravo.‡Tuez 6 Gangregardes de l\'invasion et retournez voir l\'émissaire de l\'Aube d\'argent Fièrepuits.‡杀死6个入侵的恶魔卫士，然后向银色使者普罗维尔复命。‡殺掉6個入侵的惡魔守衛，然後回去找銀色特使波特威歐。',
  }
},
[10260] = {
  {
    'Netherologist Coppernickels‡Пустолог Медноклеппер‡Netheorologe Kupfernickel‡황천전문가 코퍼니켈스‡Abisólogo Nicuproso‡‡Pokernikus le néantologue‡DEPRECATED‡虛空學家卡伯尼寇斯',
    nil,
    'Speak with Netherologist Coppernickels at the bridge leading into the Netherstorm from Blade\'s Edge.‡Поговорите с Пустологом Медноклеппером у моста, ведущего от Пустоверти к Острогорью.‡Sprecht mit Netheorologe Kupfernickel bei der Brücke, die vom Nethersturm zum Schergrat führt.‡칼날 산맥에서 황천의 폭풍으로 통하는 다리에 있는 황천전문가 코퍼니켈스와 대화해야 합니다.‡Habla con el abisólogo Nicuproso en el puente a Tormenta Abisal desde Filospada.‡Habla con el abisólogo Nicuproso en el puente a Tormenta Abisal desde Filospada.‡Parlez au néantologue Pokernikus sur le pont qui conduit au Raz-de-Néant depuis les Tranchantes.‡前往刀锋山与虚空风暴相连接的桥边寻找Netherologist Coppernickels，并与他交谈。‡與虛空學家卡伯尼寇斯談談，他在劍刃山脈往虛空風暴的橋上。',
  }
},
[10261] = {
  {
    'Procura-se: aniquilador servomecânico!‡Разыскивается: аннигиляторный сервопривод!‡Gesucht: Vernichter Servo!‡구함: 파멸자 제어장치!‡Se busca: servoaniquilador‡Se busca: Servoaniquilador‡On recherche : servomoteur d\'annihilateur !‡悬赏：歼灭者机械臂‡懸賞:殲滅者伺服電動機!',
    nil,
    'Obtenha um Aniquilador Servomecânico e leve-o a Papai Macário, na Área 52, em Eternévoa.‡Заберите аннигиляторный сервопривод и доставьте его Папаше Колесуну в Зону 52 Пустоверти.‡Besorgt einen Vernichterservo und bringt ihn zu Papa Mauschel in Area 52 im Nethersturm.‡파멸자 제어장치를 입수한 후에 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 전해줘야 합니다.‡Consigue un servoaniquilador y entrégaselo a Papá Ruedas en el Área 52 en Tormenta Abisal.‡Consigue un servoaniquilador y entrégaselo a Papá Ruedas en el Área 52 en Tormenta Abisal.‡Procurez-vous un Servomoteur d\'annihilateur et apportez-le à Papa Roulette dans la Zone 52 au Raz-de-Néant.‡将一根歼灭者机械臂交给虚空风暴52区的维勒老爹。‡取得一部殲滅者伺服電動機，並且將它帶回虛空風暴的52區交給威勒老爹。',
  }
},
[10262] = {
  {
    'Destroços etéreos‡Груда духов Астрала‡Ein Hügel voll Astraler‡에테리얼 무리‡Un montón de etéreos‡Un montón de etéreos‡Un monceau d\'éthériens‡叛徒的徽记‡一堆伊斯利',
    nil,
    'Colete 10 Insígnias Zaxxis e leve-as ao Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Соберите 10 знаков отличия братства Заксис и принесите их ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Sammelt 10 Insignien der Zaxxis und kehrt dann zu Netherpirscher Khay\'ji in Area 52 im Nethersturm zurück.‡작시스 휘장 10개를 수집해서 황천의 폭풍 52번 구역에 있는 황천추적자 케이지에게 가져가야 합니다.‡Recoge 10 insignias de Zaxxis y llévaselas al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Recoge 10 insignias de Zaxxis y llévaselas al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Collectez 10 Insignes de Zaxxis et apportez-les au Traqueur-du-Néant Khay\'ji dans la Zone 52 de Raz-de-Néant.‡收集10枚萨克希斯徽记，将它们交给虚空风暴52区的虚空猎手卡尔伊。‡收集10枚薩希斯徽記，並且將它們帶回虛空風暴的52區交給虛空行者凱澤。',
  }
},
[10263] = {
  {
    'Auxílio ao Consórcio‡Содействие Консорциуму‡Dem Konsortium helfen‡무역연합 돕기‡Ayudar al Consorcio‡Ayudar al Consorcio‡Aider le Consortium‡协助星界财团‡協助聯合團',
    nil,
    'Fale com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Поговорите с ловчим Пустоты Кай\'джи в Зоне 52 в Пустоверти.‡Sprecht mit Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍 52번 구역에 있는 황천의 추적자 케이지와 대화해야 합니다.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Parlez au traqueur-du-Néant Khay\'ji dans la Zone 52 au Raz-de-Néant.‡到虚空风暴去，与52区的虚空猎手卡尔伊谈一谈。‡到虛空風暴的52區找虛空行者凱澤談談。',
  }
},
[10264] = {
  {
    'Auxílio ao Consórcio‡Содействие Консорциуму‡Dem Konsortium helfen‡무역연합 돕기‡Ayudar al Consorcio‡Ayudar al Consorcio‡Aider le Consortium‡协助星界财团‡協助聯合團',
    nil,
    'Fale com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Поговорите с ловчим Пустоты Кай\'джи в Зоне 52 в Пустоверти.‡Sprecht mit Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍 52번 구역에 있는 황천의 추적자 케이지와 대화해야 합니다.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Parlez au Traqueur-du-Néant Khay\'ji dans la Zone 52 au Raz-de-Néant.‡到虚空风暴去，与52区的虚空猎手卡尔伊谈一谈。‡到虛空風暴的52區找虛空行者凱澤談談。',
  }
},
[10265] = {
  {
    'Coleta de cristais para o Consórcio‡Добыча артефакта для Консорциума‡Kristallsammlung des Konsortiums‡무역연합 수정 수집‡Colección de cristales de El Consorcio‡Colección de cristales de El Consorcio‡La collection de cristaux du Consortium‡星界财团的水晶‡聯合團水晶收集',
    nil,
    'Obtenha o artefato de cristal de Arklon e leve-o ao Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Заполучите кристаллический артефакт Арклона и верните его ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Besorgt ein Kristallartefakt von Arklon und bringt es zu Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 황천추적자 케이지에게 알클론 수정 유물 1개를 가져가야 합니다.‡Consigue un artefacto de cristal de Arklon y llévaselo al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Consigue un artefacto de cristal de Arklon y llévaselo al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Procurez-vous un artéfact cristallin d\'Arklon et rapportez-le au traqueur-du-Néant Khay\'ji à la Zone 52 au Raz-de-Néant.‡将一件阿尔科隆水晶神器交给虚空风暴52区的虚空猎手卡尔伊。‡取得阿克隆水晶手工品，並且將它帶回虛空風暴的52區交給虛空行者凱澤。',
  }
},
[10266] = {
  {
    'Pedido de assistência‡Запрос о содействии‡Bitte um Unterstützung‡원조 요청‡Petición de ayuda‡Petición de ayuda‡Demande d\'assistance‡寻求帮助‡要求幫助',
    nil,
    'Procure-o e ofereça-lhe os seus serviços. Ele se encontra no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Найдите Гаруджа и предложите ему свои услуги. Он находится на заставе внутри заповедника "Срединные земли" в Пустоверти.‡Sucht Gahruj und bietet ihm Eure Hilfe an. Er befindet sich im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡가루즈를 찾아서 도와줘야 합니다. 황천의 폭풍, 중앙 생태지구 안에 있는 중앙 생태지구 주둔지로 가십시오.‡Busca a Gahruj y ofrécele tus servicios. Se encuentra en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media de Tormenta Abisal.‡Busca a Gahruj y ofrécele tus servicios. Se encuentra en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media de Tormenta Abisal.‡Trouvez Gahruj et proposez-lui vos services. Il se trouve au comptoir des Terres-médianes dans l\'Écodôme Terres-médianes au Raz-de-Néant.‡前往虚空风暴中央生态圆顶的中央圆顶哨站，找到加鲁斯并为他效力。‡尋找並提供加魯你的幫助。他就在虛空風暴的秘境領地裡的領地崗哨。',
  }
},
[10267] = {
  {
    'Retomada justa‡Изъятие по праву‡Rechtmäßiger Besitz‡정당한 회수‡Legítima recuperación‡Legítima recuperación‡Récupérer ce qui nous revient de droit‡贸易终结‡合法的回收',
    nil,
    'Colete 10 Caixas de Equipamento de Sondagem e leve-os a Gahruj, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Заберите 10 ящиков с геодезическим снаряжением и верните их Гаруджу, находящемуся на заставе внутри заповедника "Срединные земли" в Пустоверти.‡Sammelt 10 Kästen mit Vermessungsausrüstung und bringt sie zu Gahruj im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡측량 장비 상자 10개를 모아서 황천의 폭풍, 중앙 생태지구 안에서 중앙 생태지구 주둔지에 있는 가루즈에게 가져가야 합니다.‡Coge 10 cajas de equipo de análisis y llévaselas a Gahruj al Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en Tormenta Abisal.‡Coge 10 cajas de equipo de análisis y llévaselas a Gahruj al Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en Tormenta Abisal.‡Récupérez 10 Boîtes d\'équipement topographique et rapportez-les à Gahruj au comptoir des Terres-médianes dans l\'Écodôme Terres-médianes au Raz-de-Néant.‡收集10箱测量装置，然后返回虚空风暴中央生态圆顶的中央圆顶哨站，将它们交给加鲁斯。‡收集10箱勘探設備帶回虛空風暴秘境領地的領地崗哨給加魯。',
  }
},
[10268] = {
  {
    'Audiência com o príncipe‡Аудиенция у принца‡Eine Audienz beim Prinzen‡왕자 알현‡Una audiencia con el príncipe‡Una audiencia con el príncipe‡Une audience avec le prince‡与节点亲王会面‡晉見王子',
    nil,
    'Entregue o Equipamento de Sondagem à imagem do Príncipe do Nexus Haramad, no Pináculo da Tempestade, em Eternévoa.‡Доставьте геодезическое снаряжение к проекции принца нексуса Харамада в Штормовую Вершину в Пустоверти.‡Bringt die Vermessungsausrüstung zum Bild von Nexusprinz Haramad in der Sturmsäule im Nethersturm.‡황천의 폭풍, 폭풍 첨탑에 있는 연합왕자 하라매드의 영상에게 측량 장비를 가져가야 합니다.‡Entrega el equipo de análisis a la Imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Entrega el equipo de análisis a la Imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Remettez l\'Équipement topographique à l\'image du prince-nexus Haramad à la Foudreflèche au Raz-de-Néant.‡前往虚空风暴的风暴尖塔，将测量装置交给节点亲王哈拉迈德的影像。‡將勘探設備送到虛空風暴的風暴之尖交給奈薩斯王子哈拉瑪德的影像。',
  }
},
[10269] = {
  {
    'Ponto de triangulação um‡Триангуляция: точка первая‡Triangulationspunkt Eins‡첫 번째 삼각측량 지점‡Punto de triangulación uno‡Punto de triangulación uno‡Point de triangulation numéro un‡一号三角点‡三角測量點之一',
    nil,
    'Use o Dispositivo de Triangulação para indicar a direção do primeiro ponto de triangulação. Assim que o encontrar, relate sua localização ao Mercador Hazzin, na Guarita do Protetorado, na ilha de Manaforja Ultris, em Eternévoa.‡Используйте триангуляционный прибор, чтобы найти путь к первой точке триангуляции. Как только найдете точку, сообщите ее местонахождение дельцу Хаззину, находящемуся на заставе Протектората на острове манагорна Ультрис в Пустоверти.‡Benutzt das Triangulationsgerät, um den Weg zum ersten Triangulationspunkt zu bestimmen. Wenn Ihr in gefunden habt, meldet die Position an Händler Hazzin beim Wachposten des Protektorats auf der Insel der Manaschmiede Ultris im Nethersturm.‡삼각측량 장비를 사용하여 첫 번째 삼각측량 지점을 찾아야 합니다. 그런 다음 황천의 폭풍의 울트리스 마나괴철로 섬에 있는 자유연합 경비초소의 무역업자 하진에게 발견한 위치를 보고해야 합니다.‡Usa el aparato de triangulación para localizar el primer punto de triangulación. Informa de su ubicación al tratante Hazzin en la Avanzada del Protectorado en la isla de la Forja de Maná Ultris en Tormenta Abisal.‡Usa el aparato de triangulación para localizar el primer punto de triangulación. Informa de su ubicación al tratante Hazzin en la Avanzada del Protectorado en la isla de la Forja de Maná Ultris en Tormenta Abisal.‡Utilisez l\'Appareil de triangulation pour vous indiquer la direction du premier point de triangulation. Une fois que vous l\'aurez trouvé, donnez-en l\'emplacement au camelot Hazzin au poste de garde du Protectorat dans l\'île de la manaforge Ultris au Raz-de-Néant.‡利用三角测量仪找到一号三角点。找到之后，立刻前往虚空风暴法力熔炉：乌提斯的维序派哨站，向商人哈斯辛汇报三角点的位置。‡使用三角裝置指引你前往第一個三角測量點的方向。一旦你找到它，把位置報告給虛空風暴法力熔爐奧崔斯島上護國者哨站的商人海辛。',
  }
},
[10270] = {
  {
    'Uma não-tão-modesta proposição‡Нескромное предложение‡Ein nicht-so-bescheidenes Angebot‡그다지 적절하지 않은 제안‡Proposición poco decente‡Proposición poco decente‡Une proposition pas si modeste‡不太谦虚的提议‡一個不太謙虛的提議',
    nil,
    'Consiga a bateria carregada de teleportador e traga-a à plataforma de teleporte etéreo no Pico Celestial, a leste de Manaforja Ultris. Ative a plataforma e dê o Recipiente de Energia do Teleporte à imagem do Mercador do Vento Marid para que ele o instale.‡Найдите аккумулятор для телепортатора и отнесите его к площадке астрального телепорта на Небесной гряде. Активируйте площадку и отдайте аккумулятор проекции торговца ветром Марида, чтобы он мог установить его.‡Besorgt Euch die Teleporterenergiezelle und bringt sie zur Astralteleportplattform im Sternensturz östlich der Manaschmiede Ultris. Aktiviert die Plattform und bringt die Teleporterenergiezelle zum Bild von Windhändler Marid, damit er sie einbauen kann.‡순간이동기 전원공급장치를 찾아서 울트리스 마나괴철로 동쪽, 하늘 마루에 있는 에테리얼 순간이동 장치로 가져가십시오. 순간이동 장치를 작동시킨 다음 순간이동기 전원공급장치를 설치할 수 있도록 바람의 무역상 마리드의 영상에게 건네줘야 합니다.‡Recupera la célula de energía de teletransportador y llévala a la plataforma de teletransporte etérea en la Cresta Celestial, al este de la Forja de Maná Ultris. Activa la plataforma y dale la fuente de energía a la imagen del comerciante de viento Marid para que la instale.‡Recupera el envase de energía de teletransportador y llévalo a la plataforma de teletransporte etérea en la Cresta Celestial, al este de la Forja de Maná Ultris. Activa la plataforma y dale la fuente de energía a la imagen del comerciante de viento Marid para que la instale.‡Récupérez le Bloc d\'alimentation du téléporteur et apportez-le à la Plate-forme de téléportation éthérienne sur la Crête céleste à l\'est de la manaforge Ultris. Activez la plate-forme et donnez le Bloc d\'alimentation du téléporteur à l\'Image du marchand des vents Marid pour qu\'il puisse l\'installer.‡取回传送器能量包，将它带至法力熔炉：乌提斯东边苍穹之脊上的虚灵传送器。激活传送器，然后将传送器能量包交给星界商人玛里德的影像，让他进行安装。‡取得傳送力量背包並將它帶到法力熔爐奧崔斯東方的天國山脈的伊斯利傳送器去。啟動這個平臺並將傳送力量背包交給風之貿易者瑪利德的影像以便他能夠安裝它。',
  }
},
[10271] = {
  {
    'Vamos aos negócios‡Деловая активность‡Zur Sache‡사업 착수‡A trabajar‡A trabajar‡Passer aux choses sérieuses‡重要生意‡動手幹活',
    nil,
    'Carregue o Coletador de Essências usando-o em Dracos Etéreos ou Dragões Etéreos no Pico Celestial. Em seguida, retorne à área da Plataforma de Teleporte Etéreo.‡Соберите 8 единиц эссенции дракона Пустоты, затем возвращайтесь в зону площадки астрального телепорта. Эссенцию дракона Пустоты можно получить из старых или молодых драконов Пустоты.‡Sammelt 8 Einheiten Netherdrachenessenz und kehrt dann zur Gegend bei der Astralteleporterplattform zurück. Die Netherdrachenessenz könnt Ihr von Netherdrachen oder Nethergroßdrachen sammeln.‡정수 채집기를 하늘 마루에 있는 황천의 비룡이나 황천의 용에게 사용해 충전한 후, 에테리얼 순간이동 장치 지역으로 돌아가야 합니다.‡Recolecta 8 esencias de dragón abisal y vuelve a la plataforma de teletransporte etérea. Puedes obtener la esencia de dracos abisales o de dragones abisales.‡Carga el recolector de esencia usándolo con dracos abisales o con dragones abisales en la Cresta Celestial y después vuelve a la zona de la plataforma de teletransporte etérea.‡Chargez le Récolteur d’essence en l’utilisant sur des Drakes du Néant ou sur des Dragons du Néant de la Crête Céleste, puis retournez dans la zone de la Plateforme de téléportation éthérienne.‡收集8份虚空龙类精华，然后返回虚灵传送器区域。你可以从虚空幼龙或虚空之龙身上收集到虚空龙类精华。‡收集8個虛空龍精華然後回到伊斯利傳送器地區。你可以從虛空龍或者虛空龍身上取得虛空龍精華 。',
  }
},
[10272] = {
  {
    'Um início promissor‡Многообещающее начало‡Ein viel versprechender Anfang‡순조로운 출발‡Bien está lo que bien acaba‡Un buen comienzo‡Un départ prometteur‡成功的开始‡一個有希望的開始',
    nil,
    'Colete 15 Ovos de Draconiano do Éter e, em seguida, fale com Tyri e Jorad no Pico Celestial.‡Соберите 15 яиц драконидов Пустоты, затем возвращайтесь к Тири и Джораду на Небесную гряду.‡Sammelt 15 Netherdrachkineier und kehrt dann zu Tyri und Jorad im Sternensturz zurück.‡황천의 용족 알 15개를 수집한 다음 하늘 마루에 있는 타이리와 조라드에게 가야 합니다.‡Recolecta 15 huevos de dragonante abisal y llévaselos a Tyri y Jorad a la Cresta Celestial.‡Recolecta 15 huevos de dragonante abisal y llévaselos a Tyri y Jorad a la Cresta Celestial.‡Récoltez 15 Œufs de draconiens du Néant, puis retournez auprès de Tyri et Jorad sur la Crête céleste.‡收集15枚虚空龙卵，然后向苍穹之脊的泰莉和乔拉德复命。‡收集15個虛空龍族的蛋，完成後返回天國山脈的泰利和喬洛德那裡。',
  }
},
[10273] = {
  {
    'Distrações nocivas‡Пустые хлопоты‡Störende Ablenkung‡성가신 골칫거리‡Problemas a la vista‡Problemas a la vista‡Malencontreuses distractions‡棘手的目标‡討人厭的傢伙',
    nil,
    'Fale com o Mercador do Vento Marid e atraia-o para longe de seu entreposto. Acabe com ele e fale novamente com Tyri e Jorad, no Pico Celestial.‡Поговорите с торговцем Ветром Маридом и выманите его из торгового поста. Покончите с ним, затем вернитесь к Тири и Джораду на Небесную гряду.‡Sprecht mit Windhändler Marid und lockt ihn von seinem Handelsposten fort. Vernichtet ihn und kehrt dann zu Tyri und Jorad im Sternensturz zurück.‡바람의 무역상 마리드와 대화해서 그가 거래를 하고 있는 기지에서 꾀어내야 합니다. 그를 처치한 다음 하늘 마루에 있는 타이리와 조라드에게 돌아가십시오.‡Habla con el comerciante de viento Marid y aléjalo de su tienda. Ocúpate de él y ve a ver a Tyri y Jorad a la Cresta Celestial.‡Habla con el comerciante de viento Marid y aléjalo de su tienda. Ocúpate de él y ve a ver a Tyri y Jorad a la Cresta Celestial.‡Parlez au Marchand des vents Marid et attirez-le à l\'écart de son commerce. Débarrassez-vous de lui puis retournez auprès de Tyri et Jorad sur la Crête céleste.‡与星界商人玛里德谈一谈，诱使他离开商栈。杀死玛里德后向苍穹之脊的泰莉和乔拉德复命。‡跟風之貿易者瑪利德交談並且引誘他離開交易站。殺死他然後回去天國山脈找泰利還有喬洛德。',
  }
},
[10274] = {
  {
    'Defendendo o Pico Celestial‡Безопасность Небесной гряды‡Den Sternensturz sichern‡하늘 마루 수호‡Proteger la Cresta Celestial‡Proteger la Cresta Celestial‡S\'emparer de la Crête céleste‡占领苍穹之脊‡保衛天國山脈',
    nil,
    'Use o Desafio da Revoada Azul para provocar Verakan, na extremidade sul do Pico Celestial. Derrote-o e fale novamente com Tyri e Jorad, no Pico Celestial.‡Используйте вызов синих драконов, чтобы вызвать на бой Вераку, живущего на южном склоне Небесной гряды. Победите его и возвращайтесь к Тири и Джораду, ожидающим на Небесной гряде.‡Benutzt die Herausforderung des blauen Drachenschwarms um Veraku am südlichen Ende des Sternensturzes zu provozieren. Besiegt ihn und kehrt dann zu Tyri und Jorad im Sternesturz zurück.‡푸른용군단의 도전을 사용하여 하늘 마루의 남쪽 끝에 있는 베라쿠에게 도전해야 합니다. 그를 해치우고 하늘 마루에 있는 타이리와 조라드에게 돌아가십시오.‡Usa el desafío del Vuelo Azul para provocar a Veraku en el extremo sur de Cresta Celestial. Derrótalo y ve a ver a Tyri y Jorad a Cresta Celestial.‡Usa el desafío del Vuelo Azul para provocar a Veraku en el extremo sur de Cresta Celestial. Derrótalo y ve a ver a Tyri y Jorad a Cresta Celestial.‡Utilisez le Défi du Vol bleu pour provoquer Veraku en duel sur le bord sud de la Crête céleste. Triomphez de lui et retournez voir Tyri et Jorad sur la Crête céleste.‡前往苍穹之脊的南端，使用蓝龙的挑战激怒维拉库。击败他后向苍穹之脊的泰莉和乔拉德复命。‡使用藍龍軍團的挑戰在天國山脈的南方邊緣上激怒維拉庫。打敗他並且回到天國山脈的泰利和喬洛德那裡。',
  }
},
[10275] = {
  {
    'Ponto de triangulação dois‡Триангуляция: точка вторая‡Triangulationspunkt Zwei‡두 번째 삼각측량 지점‡Punto de triangulación dos‡Punto de triangulación dos‡Point de triangulation numéro deux‡二号三角点‡三角測量點之二',
    nil,
    'Use o Dispositivo de Triangulação para indicar a direção do segundo ponto de triangulação. Assim que o encontrar, relate sua localização ao Mercador do Vento Tuluman, no Acampamento do Tuluman, logo depois da ponte que leva à ilha de Manaforja Ara, em Eternévoa.‡Используйте триангуляционный прибор, чтобы найти путь ко второй точке триангуляции. Как только найдете точку, сообщите ее местонахождение торговцу ветром Тулуману, находящемуся в лагере Тулумана, по другую сторону моста, ведущего от острова манагорна Ара в Пустоверти.‡Benutzt das Triangulationsgerät, um den Weg zum zweiten Triangulationspunkt zu bestimmen. Wenn Ihr in gefunden habt, meldet die Position an Windhändler Tuluman bei Tulumans Landeplatz auf der anderen Seite der Brücke zu der Insel der Manaschmiede Ara im Nethersturm.‡삼각측량 장비를 사용하여 두 번째 삼각측량 지점을 찾아야 합니다. 그런 다음 황천의 폭풍의 아라 마나괴철로 섬으로 들어가는 다리 옆, 툴루만의 교역지에 있는 바람의 무역상 툴루만에게 발견한 위치를 보고해야 합니다.‡Usa el aparato de triangulación para localizar el segundo punto de triangulación. Informa al comerciante de viento Tuluman en Alto de Tuluman, justo al cruzar el puente de la isla de Forja de Maná Ara en Tormenta Abisal.‡Usa el aparato de triangulación para localizar el segundo punto de triangulación. Informa al comerciante de viento Tuluman en Alto de Tuluman, justo al cruzar el puente de la isla de Forja de Maná Ara en Tormenta Abisal.‡Utilisez l\'Appareil de triangulation pour vous indiquer la direction du deuxième point de triangulation. Une fois que vous l\'aurez trouvé, donnez-en l\'emplacement au marchand des vents Tuluman au Point d\'ancrage de Tuluman, juste de l\'autre côté du pont vers l\'île de la manaforge Ara au Raz-de-Néant.‡利用三角测量仪找到二号三角点。找到之后，立刻前往虚空风暴法力熔炉：艾拉对面的图鲁曼的营地，向星界商人图鲁曼汇报三角点的位置。‡使用三角裝置指引你前往第二個三角測量點的方向。一旦你找到它，將位置報告給在虛空風暴的吐魯曼平臺的風之貿易者吐魯曼，他就在從法力熔爐艾拉島出來的橋的另一邊。',
  }
},
[10276] = {
  {
    'Triângulo completo‡Полный треугольник‡Das volle Dreieck‡완전한 삼각형‡Triángulo completo‡Triángulo completo‡Le triangle est triangulé‡三角测量‡完整三角形',
    nil,
    'Recupere o Cristal Ata\'mal e leve-o à Imagem do Príncipe do Nexus Haramad, no Pináculo da Tempestade, em Eternévoa.‡Заберите кристалл Ата\'мала и передайте его проекции принца нексуса Харамада, находящейся в Штормовой Вершине в Пустоверти.‡Besorgt Euch den Kristall von Ata\'mal und bringt ihn zum Bild von Nexusprinz Haramad in der Sturmsäule im Nethersturm.‡아타말 수정을 찾아서 황천의 폭풍, 폭풍 첨탑에 있는 연합왕자 하라매드의 영상에게 가져가야 합니다.‡Recupera el cristal de Ata\'mal y dáselo a la imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Recupera el cristal de Ata\'mal y dáselo a la imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Récupérez le Cristal d\'Ata\'mal et rapportez-le à l\'image du prince-nexus Haramad à la Foudreflèche au Raz-de-Néant.‡夺得阿塔玛水晶，然后返回虚空风暴的风暴之塔，将它交给节点亲王哈拉迈德的影像。‡取回阿塔莫水晶並且將它帶到虛空風暴的風暴之尖交給奈薩斯王子哈拉瑪德的影像。',
  }
},
[10277] = {
  {
    'Cavernas do Tempo‡Пещеры Времени‡Die Höhlen der Zeit‡시간의 동굴‡Las Cavernas del Tiempo‡Las Cavernas del Tiempo‡Les Grottes du temps‡时光之穴‡時光之穴',
    nil,
    'Andormu, nas Cavernas do Tempo, lhe conferiu a tarefa de seguir a Guia do Tempo pela caverna.‡Андорму попросил вас пройти по пещерам вместе с хранительницей времени.‡Andormu in den Höhlen der Zeit möchte, dass Ihr der Bewahrerin der Zeit durch die Höhle folgt.‡시간의 동굴에 있는 안도르무가 동굴 주변에 있는 시간의 관리인을 따라가 달라고 부탁했습니다.‡Andormu de las Cavernas del Tiempo quiere que sigas a la custodia del Tiempo.‡Andormu de las Cavernas del Tiempo quiere que sigas a la custodia del Tiempo.‡Andormu vous demande de suivre la Protectrice du temps dans les Grottes du temps.‡时光之穴的安多尔姆要你跟随时光监护者游览时光之穴。‡在時光之穴的安杜姆要你跟隨洞穴附近的時間管理人。',
  }
},
[10278] = {
  {
    'As fendas dimensionais‡Астральные провалы‡Sphärenrisse‡일그러진 균열‡Las fallas de distorsión‡Las fallas de distorsión‡Les failles dimensionnelles‡迁跃裂隙‡扭曲裂縫',
    nil,
    'Use o Gerador de Fendas Dimensionais Instáveis embaixo dos Campos Dimensionais. Colete 3 amostras de Éter Dimensional de Emissários do Caos Instáveis e leve-as para Ogath, o Louco, no Acampamento Quebra-espinha.‡Используйте нестабильный генератор астральных провалов на Искривленных полях. Соберите три горсти пыли Пустоты с нестабильных демонов Бездны и возвращайтесь к Огафу Безумному на заставу Хребтолома.‡Benutzt den instabilen Sphärenrissgenerator in den Sphärenfeldern. Sammelt 3 Einheiten Sphärennether von instabilen Leerwandlern und kehrt dann zu Ogath dem Verrückten im Rückenbrecherposten zurück.‡일그러진 벌판에서 불안정한 일그러진 균열 생성기를 사용해야 합니다. 불안정한 보이드워커를 처치하고 일그러진 황천 3개를 수집해서 해골망치 초소의 미치광이 오가스에게 가져가야 합니다.‡Usa el generador de fallas de distorsión inestable en Los Campos Alabeados. Coge 3 abismos de distorsión de abisarios inestables y llévaselos a Ogath el Loco a la Avanzada Rompeloma.‡Usa el generador de fallas de distorsión inestable en Los Campos Alabeados. Coge 3 abismos de distorsión de abisarios inestables y llévaselos a Ogath el Loco a la Avanzada Rompeloma.‡Utilisez le Générateur de faille dimensionnelle instable dans les Champs de distorsion. Récupérez 3 Néants dimensionnels sur des Marcheurs du Vide instables, puis retournez voir Ogath le Fol au poste de Brise-échine.‡在迁跃平原使用不稳定的迁跃裂隙生成器。从不稳定的虚空行者身上收集3份迁跃虚空能量，把它们交给断背岗哨的疯狂的欧加斯。‡在扭曲原野使用不穩定的扭曲裂縫生成器。從不穩定的虛無行者身上收集3個扭曲虛空，帶回斷脊氏族崗哨交給瘋狂的歐卡司。',
  }
},
[10279] = {
  {
    'Para o covil do mestre‡Логово господина‡Zum Hort des Meisters‡지배자의 둥지로‡La caverna del maestro‡La caverna del maestro‡Dans le repaire du maître‡主宰之巢‡前往主人的巢穴',
    nil,
    'Fale com Andormu nas Cavernas do Tempo.‡Поговорите с Андорму в пещерах Времени.‡Sprecht mit Andormu in den Höhlen der Zeit.‡시간의 동굴에 있는 안도르무와 대화해야 합니다.‡Habla con Andormu en las Cavernas del Tiempo.‡Habla con Andormu en las Cavernas del Tiempo.‡Parlez à Andormu dans les Grottes du temps.‡与时光之穴的安多尔姆谈一谈。‡與時光之穴的安杜姆談談。',
  }
},
[10280] = {
  {
    'Entrega especial para Shattrath‡Специальный груз в город Шаттрат‡Sonderlieferung nach Shattrath‡샤트라스로 특별 배달‡Una entrega especial a la Ciudad de Shattrath‡Una entrega especial a la Ciudad de Shattrath‡Livraison spéciale à Shattrath‡送往沙塔斯的特殊货物‡給撒塔斯城的特件',
    nil,
    'Entregue o Cristal de Ata\'mal a A\'dal, no Terraço da Luz, em Shattrath.‡Передайте кристалл Ата\'мала А\'далу на террасе Света в городе Шаттрат.‡Bringt den Kristall von Ata\'mal zu A\'dal auf der Terrasse des Lichts in Shattrath.‡샤트라스의 빛의 정원에 있는 아달에게 아타말 수정을 전달해야 합니다.‡Entrega el cristal de Ata\'mal a A\'dal en el Bancal de la Luz en Ciudad de Shattrath.‡Entrega el cristal de Ata\'mal a A\'dal en el Bancal de la Luz en la Ciudad de Shattrath.‡Apportez le cristal d\'Ata\'mal à A\'dal sur la Terrasse de la Lumière à Shattrath.‡将阿塔玛水晶交给沙塔斯城圣光广场的阿达尔。‡將阿塔莫水晶送交到撒塔斯城的聖光露臺交給阿達歐。',
  }
},
[10281] = {
  {
    'Apresentações formais‡Формальное представление‡Formelle Vorstellung‡격식을 갖춘 인사‡Presentaciones formales‡Presentaciones formales‡Présentation formelle‡正式介绍‡正式自我介紹',
    nil,
    'Encontre Tyri na extremidade norte do Pico Celestial e fale com ela.‡Найдите Тири на северной оконечности Небесной гряды и поговорите с ней.‡Sucht Tyri am nördlichen Ende des Sternensturzes und sprecht mit ihr.‡하늘 마루의 북쪽 끝에서 타이리를 찾아 대화해야 합니다.‡Encuentra a Tyri en el extremo norte de Cresta Celestial.‡Encuentra a Tyri en el extremo norte de Cresta Celestial.‡Retrouvez Tyri à la pointe nord de la Crête céleste et allez lui parler.‡找到苍穹之脊北端的泰莉，与她谈一谈。‡在天國山脈的北端找到泰利並與她談談。',
  }
},
[10282] = {
  {
    'Antiga Eira dos Montes‡Старый Хилсбрад‡Das alte Hügelland‡옛 힐스브래드‡Antigua Trabalomas‡Antigua Trabalomas‡Hautebrande d\'antan‡往日的希尔斯布莱德‡舊時的希爾斯布萊德',
    nil,
    'Andormu, nas Cavernas do Tempo, lhe conferiu a tarefa de ir até a Antiga Eira dos Montes e falar com Erozion.‡Отправьтесь по тропе времени в старый Хилсбрад и поговорите с Эрозионом.‡Andormu in den Höhlen der Zeit bittet Euch, ins Alte Hügelland zu reisen und mit Erozion zu sprechen.‡시간의 동굴에 있는 안도르무가 옛 힐스브래드로 가서 에로지온과 대화해 달라고 부탁했습니다.‡Andormu de las Cavernas del Tiempo quiere que vayas a la Antigua Trabalomas para hablar con Erozion.‡Andormu de las Cavernas del Tiempo quiere que vayas a la Antigua Trabalomas para hablar con Erozion.‡Andormu des Grottes du temps vous demande de vous aventurer dans le Hautebrande d\'antan et d\'aller voir Erozion.‡时光之穴的安多尔姆要求你进入旧希尔斯布莱德丘陵，与伊洛希恩谈一谈。‡時光之穴的安杜姆要你到希爾斯布萊德丘陵去跟伊洛森談談。',
  }
},
[10283] = {
  {
    'Distração de Taretha‡План Тареты‡Tarethas Ablenkungsmanöver‡타레사의 작전‡La maniobra de Taretha‡La maniobra de Taretha‡La diversion de Taretha‡塔蕾莎的计谋‡塔蕾莎的聲東擊西',
    nil,
    'Vá ao Forte do Desterro e prepare 5 cargas incendiárias nos barris encontrados dentro dos campos de prisioneiros, usando a Carga de Bombas Incendiárias que Erozion lhe deu.nnFale com Thrall na prisão do porão do Forte do Desterro quando tiver incendiado os alojamentos.‡Проберитесь в крепость Дарнхольд и заложите пять зажигательных бомб возле бочек внутри каждого из бараков на выселках. Используйте упаковку зажигательных бомб, полученных от Эрозиона.nnПосле того как подожжете бараки, разыщите Тралла в подземной темнице.‡Reist zur Burg Durnholde und platziert mit Hilfe des Bündels mit Brandbomben, das Ihr von Erozion erhalten habt, 5 Brandsätze auf den Fässern in jeder Internierungsbaracke.nnSprecht mit Thrall im Kellergefängnis der Burg Durnholde, wenn Ihr die Internierungsbaracken angezündet habt.‡던홀드 요새로 가서 에로지온이 준 화염 폭탄 자루를 사용하여 모든 수용소의 안에 있는 맥주통에 화염 폭탄을 5개씩 설치해야 합니다.nn수용소를 다 불태웠으면 던홀드 요새의 지하 감옥에 있는 스랄과 대화하십시오.‡Ve al Castillo de Durnholde y coloca 5 cargas incendiarias del paquete de bombas incendiarias que te dio Erozion en los barriles que hay en cada pabellón de internamiento.nnDespués habla con Thrall en la prisión subterránea del castillo.‡Ve al Castillo de Durnholde y coloca 5 cargas incendiarias del paquete de bombas incendiarias que te dio Erozion en los barriles que hay en cada pabellón de internamiento.|n|nDespués habla con Thrall en la prisión subterránea del castillo.‡Rendez-vous au bastion de Fort-de-Durn et placez 5 charges incendiaires dans les tonneaux situés dans chacun des pavillons d\'internement grâce au Paquet de bombes incendiaires qui vous a été donné par Erozion.nnParlez à Thrall dans les oubliettes du bastion de Fort-de-Durn une fois les Pavillons d\'internement incendiés.‡进入敦霍尔德城堡，将伊洛希恩交给你的燃烧弹包分别放入5间收容所内的木桶，并启动定时装置。nn引爆燃烧弹后，与被关押在敦霍尔德城堡地牢中的萨尔谈一谈。‡前往敦霍爾德城堡，使用伊洛森交給你的燃燒炸彈包裹在每一個拘留守衛室裡的桶中放置5個燃燒炸藥。|n當你引爆拘留守衛室後，與敦霍爾德城堡地牢裡的索爾談談。',
  }
},
[10284] = {
  {
    'A fuga do Forte do Desterro‡Побег из Дарнхольда‡Flucht aus Durnholde‡던홀드 탈출‡Huida de Durnholde‡Huida de Durnholde‡Évasion de Fort-de-Durn‡逃离敦霍尔德‡逃離敦霍爾德',
    nil,
    'Quando estiver <pronto/pronta> para continuar, avise Thrall. Siga-o e ajude-o a libertar Taretha e a cumprir o destino dele.nnFale com Erozion na Antiga Eira dos Montes caso tenha sucesso nesta missão.‡Когда вы будете готовы идти, сообщите об этом Траллу. Помогите ему бежать из крепости Дарнхольд, освободить Тарету и исполнить свое предназначение.nnПосле этого возвращайтесь к Эрозиону в Старый Хилсбрад.‡Gebt Thrall Bescheid, wenn Ihr bereit seid. Folgt Thrall aus der Burg Durnholde und helft ihm, Taretha zu befreien und sein Schicksal zu erfüllen.nnSprecht mit Erozion im Alten Hügelland, wenn Ihr diese Aufgabe erfüllt habt.‡준비가 되면 스랄에게 알려준 후, 던홀드 요새에서 스랄을 따라나가 그가 타레사를 구출하고 운명을 실현할 수 있도록 도와야 합니다.nn이 임무를 완수하면 옛 힐스브래드에 있는 에로지온과 대화해야 합니다.‡Cuando estés <listo/lista> para proceder, díselo a Thrall. Sigue a Thrall al exterior del Castillo de Durnholde y ayúdale a liberar a Taretha y así cumplir su destino.nnHabla con Erozion en Antigua Trabalomas cuando completes esta tarea.‡Cuando estés $Glisto:lista; para proceder, díselo a Thrall. Sigue a Thrall al exterior del Castillo de Durnholde y ayúdale a liberar a Taretha y así cumplir su destino.|n|nHabla con Erozion en Antigua Trabalomas cuando completes esta tarea.‡Faites signe à Thrall lorsque vous serez <prêt/prête> à continuer. Suivez-le dans son évasion du bastion de Fort-de-Durn et aidez-le à libérer Taretha et à accomplir son destin.nnAllez parler à Erozion au Hautebrande d\'antan si vous parvenez à accomplir cette tâche.‡准备就绪后告知萨尔。保护萨尔逃离敦霍尔德城堡，并与他一起搭救塔蕾莎。nn任务完成后与旧希尔斯布莱德丘陵的伊洛希恩谈一谈。‡當你準備開始時，讓索爾知道。跟著索爾離開敦霍爾德城堡，並協助他釋放塔蕾莎以及完成他的天命。|n任務完成後到希爾斯布萊德找伊洛森談談。',
  }
},
[10285] = {
  {
    'Reencontro com Andormu‡Возвращение к Андорму‡Rückkehr zu Andormu‡안도르무에게 돌아가기‡Regreso junto a Andormu‡Regresa junto a Andormu‡Retour vers Andormu‡返回安多尔姆身边‡回去安杜姆身邊',
    nil,
    'Fale novamente com Andormu nas Cavernas do Tempo, que fica no deserto de Tanaris.‡Возвращайтесь к маленькому Андорму в Пещеры Времени.‡Kehrt zu dem jungen Andormu in den Höhlen der Zeit in Tanaris zurück.‡타나리스의 시간의 동굴에 있는 어린 안도르무에게 돌아가야 합니다.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Retournez voir le jeune dragon Andormu, aux Grottes du temps dans le désert de Tanaris.‡返回塔纳利斯沙漠的时光之穴，向幼时的安多尔姆复命。‡回去塔納利斯沙漠的時光之穴找小孩安杜姆 。',
  }
},
[10286] = {
  {
    'O segredo de Arelion‡Тайна Арелиона‡Arelions Geheimnis‡아렐리온의 비밀‡El secreto de Arelion‡El secreto de Arelion‡Le secret d\'Arelion‡埃雷利恩的秘密‡阿利恩的秘密',
    nil,
    'A Magistra Carinda quer que você interrogue o Magíster Aledis, visto pela última vez indo da Vigília do Falcão para o Pântano Zíngaro.‡Расспросите магистра Аледиса, которого в последний раз видели отправляющимся из Соколиного дозора в Зангартопь, по требованию магистра Каринды.‡Magistrix Carinda möchte, dass Ihr Magister Aledis befragt. Aledis wurde zuletzt auf einer Reise von der Falkenwacht zu den Zangarmarschen gesehen.‡마법학자 카린다가 마법학자 알레디스를 심문해 달라고 했습니다. 마지막으로 봤을 때 그는 매의 감시탑에서 장가르 습지대를 향해서 여행을 하던 중이었다고 합니다.‡La magistrix Carinda quiere que interrogues al magister Aledis, que salió de la Avanzada del Halcón en dirección a la Marisma de Zangar.‡La magistrix Carinda quiere que interrogues al magister Aledis, que salió de la Avanzada del Halcón en dirección a la Marisma de Zangar.‡La magistrice Carinda veut que vous interrogiez le magistère Aledis, qui a été vu pour la dernière fois quittant le Guet de l\'épervier pour se rendre dans le marécage de Zangar.‡魔导师卡尔琳达要你审问魔导师阿利迪斯，他已经离开猎鹰岗哨，往赞加沼泽的方向去了。‡博學者卡莉達要你詢問博學者阿勒迪斯，據說有人看到他從獵鷹哨站前往贊格沼澤。',
  }
},
[10287] = {
  {
    'A amante revelada‡Кем оказалась любовница‡Die enttarnte Geliebte‡그녀의 정체‡Amante descubierta‡Amante descubierta‡La maîtresse dévoilée‡"恋人"曝光‡情婦曝光',
    nil,
    'Fale novamente com a Magistra Carinda, na Vigília do Falcão, que fica na Península Fogo do Inferno.‡Возвращайтесь к магистру Каринде в Соколиный дозор.‡Kehrt zu Magistrix Carinda in der Falkenwacht zurück.‡지옥불 반도의 매의 감시탑에 있는 마법학자 카린다에게 가야 합니다.‡Ve a ver a la magistrix Carinda a la Avanzada del Halcón.‡‡Retournez voir la magistrice Carinda au Guet de l\'épervier, à la Péninsule des Flammes infernales.‡向猎鹰岗哨的魔导师卡尔琳达复命。‡回去找獵鷹哨站的博學者卡莉達。',
  }
},
[10288] = {
  {
    'Chegada em Terralém‡Прибытие в Запределье‡Ankunft in der Scherbenwelt‡아웃랜드 도착‡Llegada a Terrallende‡Llegada a Terrallende‡Arrivée en Outreterre‡抵达外域‡抵達外域',
    nil,
    'O Comandante Durão, no Portal Negro da Península Fogo do Inferno, quer que você leve o Relatório de Durão para Emílio Martelo Feroz.‡Доставьте донесение Дарона Амишу Громовому Молоту по приказу командира Дарона у Темного портала на полуострове Адского Пламени.‡Kommandant Duron beim Dunklen Portal auf der Höllenfeuerhalbinsel möchte, dass Ihr Durons Bericht zu Flugmeister Amish Wildhammer bringt.‡지옥불 반도의 어둠의 문에 있는 지휘관 두론이 아미쉬 와일드해머에게 두론의 보고서를 전해 달라고 부탁했습니다.‡El comandante Duron, de El Portal Oscuro en la Península del Fuego Infernal quiere que entregues su informe a Amish Martillo Salvaje.‡El comandante Duron de El Portal Oscuro en la Península del Fuego Infernal quiere que entregues su informe a Amish Martillo Salvaje.‡Le commandant Duron à la Porte des ténèbres dans la péninsule des Flammes infernales veut que vous apportiez le Rapport de Duron à Amish Marteau-hardi.‡地狱火半岛上黑暗之门的指挥官杜隆要求你将杜隆的报告交给阿米什·蛮锤。‡地獄火半島的黑暗之門的指揮官杜朗要你將杜朗的報告送到艾米思·蠻錘的手中。',
  }
},
[10289] = {
  {
    'Viagem a Thrallmar‡Путешествие в Траллмар‡Reise nach Thrallmar‡스랄마로의 여정‡Viaje a Thrallmar‡Viaje a Thrallmar‡En route pour Thrallmar‡萨尔玛之旅‡前往索爾瑪',
    nil,
    'Vá a Thrallmar usando a Mantícora de Vlagga Freipena. Leve o Relatório de Órion para o General Krakork.‡Долетите на ветрокрыле Влагги Легкоперой в Траллмар. Доставьте донесение Ориона генералу Кракорку.‡Nehmt Vlagga Freyfeders Windreiter nach Thrallmar. Bringt Orions Bericht zu General Krakork.‡블라가 프레이페더의 와이번을 타고 스랄마로 가야 합니다. 사령관 크라콜크에게 오리온의 보고서를 가져가야 합니다.‡Lleva el jinete del viento de Vlagga Plumacalma a Thrallmar. Entrega el informe de Orion al general Krakork.‡Lleva el jinete del viento de Vlagga Plumacalma a Thrallmar. Entrega el informe de Orion al general Krakork.‡Voyagez sur le coursier du vent de Vlagga Fileplume jusqu\'à Thrallmar. Apportez le Rapport d\'Orion au général Krakork.‡乘坐维拉加·乱羽的双足飞龙前往萨尔玛，并将沃雷恩的报告交给克拉库克将军。‡搭乘法拉格·伏瑞菲德的雙足飛龍到索爾瑪。將歐萊恩的報告交給克洛克爾克將軍。',
  }
},
[10290] = {
  {
    'Em busca de faralita‡В поисках фаралита‡Auf der Suche nach Farahlit‡파랄라이트를 찾아서‡Buscando faralita‡Buscando faralita‡En quête de farahlite‡寻找法兰石‡尋找法拉萊特',
    nil,
    'Colete 4 peças de Faralita Bruta e fale novamente com Zuben Elgenubi, no Pináculo da Tempestade.‡Соберите 4 куска сырого фаралита и вернитесь к Зубену Элгенуби в Штормовую Вершину.‡Sammelt 4 Stück Rohfarahlit und kehrt dann zu Zuben Elgenubi in der Sturmsäule zurück.‡천연 파랄라이트 4개를 수집한 후 폭풍 첨탑에 있는 주벤 엘게누비에게 돌아가십시오.‡Recolecta 4 piezas de faralita en bruto y llévaselas a Zuben Elgenubi a La Flecha de la Tormenta.‡Recolecta 4 piezas de faralita en bruto y llévaselas a Zuben Elgenubi a La Flecha de la Tormenta.‡Récoltez 4 morceaux de Farahlite brute et retournez voir Zuben Elgenubi à la Foudreflèche.‡收集4块天然法兰石，将它们交给风暴尖塔的伊格努比。‡收集四個天然法拉萊特然後交給風暴之尖的祖班·艾貞努比。',
  }
},
[10291] = {
  {
    'Apresente-se a Nazgrel‡Донесение Назгрелу‡Bericht an Nazgrel‡나즈그렐에게 보고‡Informar a Nazgrel‡Informar a Nazgrel‡Se présenter à Nazgrel‡向纳兹格雷尔报到‡回報納茲格雷爾',
    nil,
    'O General Krakork, em Thrallmar, quer que você fale com Nazgrel.‡Поговорите с Назгрелом по приказу генерала Кракорка из Траллмара.‡General Krakork in Thrallmar möchte, dass Ihr mit Nazgrel sprecht.‡스랄마에 있는 사령관 크라콜크가 나즈그렐과 대화하라고 부탁했습니다.‡El general Krakork en Thrallmar quiere que hables con Nazgrel.‡El general Krakork en Thrallmar quiere que hables con Nazgrel.‡Le général Krakork de Thrallmar veut que vous parliez à Nazgrel.‡萨尔玛的克拉库克将军要求你向纳兹格雷尔报到。‡索爾瑪的克洛克爾克將軍要你去跟納茲格雷爾談話。',
  }
},
[10292] = {
  {
    'More Power!‡Больше мощи!‡Mehr Energie!‡‡¡Más potencia!‡‡Plus de puissance !‡更多能量！‡更多的能源!',
    nil,
    'Zuben Elgenubi wants you to capture 8 Legion Cannon and bring them back to the Stormspire.‡Зубен Элгенуби хочет, чтобы вы захватили 8 пушек Легиона и принесли их в Штормовую Вершину.‡Zuben Elgenubi möchte, dass Ihr 8 Schusswaffen der Legion besorgt und sie zur Sturmsäule bringt.‡‡Zuben Elgenubi quiere que captures 8 cañones de la Legión y se los lleves a La Flecha de la Tormenta.‡Zuben Elgenubi quiere que captures 8 cañones de la Legión y se los lleves a La Flecha de la Tormenta.‡Zuben Elgenubi veut que vous preniez 8 Canons de la Légion et que vous les rapportiez à la Foudreflèche.‡伊格努比要你将8尊军团火炮带回风暴尖塔。‡祖班·艾貞努比要你去取得8座軍團火砲並將這些火砲帶回風暴之尖。',
  }
},
[10293] = {
  {
    'Eis o manancial‡Попасть на главную жилу‡Die Kristallader anzapfen‡크랙스카르 처치‡A por la veta‡A por la veta‡Toucher le Gros-lot‡完美的水晶‡摘下母礦',
    nil,
    'Zuben Elgenubi, no Pináculo da Tempestade, quer que você obtenha um Núcleo de Faralita.‡Зубен Элгенуби, находящийся в Штормовой Вершине, хочет, чтобы вы добыли фаралитовую сердцевину.‡Zuben Elgenubi in der Sturmsäule möchte, dass Ihr einen Farahlitkern besorgt.‡폭풍 첨탑에 있는 주벤 엘게누비가 파랄라이트 핵을 1개 입수해 달라고 했습니다.‡Zuben Elgenubi de La Flecha de la Tormenta quiere que le lleves un núcleo de faralita.‡Zuben Elgenubi de La Flecha de la Tormenta quiere que le lleves un núcleo de faralita.‡Zuben Elgenubi de la Foudreflèche veut que vous vous procuriez un Noyau de farahlite.‡风暴尖塔的伊格努比要你取回一个法兰石核心。‡風暴之尖的祖班·艾貞努比要你取得一個法拉萊特核心。',
  }
},
[10294] = {
  {
    'Escarpa do caos‡Пустынный обрыв‡Der Leerengrat‡공허의 마루‡La Cresta del Vacío‡La Cresta del Vacío‡La crête du Vide‡虚空山脉‡虛無之脊',
    nil,
    'Vá até a Escarpa do Caos e mate as criaturas que encontrar lá. Colete 40 Estilhaços de Alma na Escarpa do Caos e leve-os para Ogath, o Louco, no Acampamento Quebra-espinha.‡Отправляйтесь на Пустынный обрыв и убейте существ, которые там обитают. Соберите 40 осколков душ Пустынного обрыва и возвращайтесь к Огафу Безумному на Заставу Хребтолома.‡Geht zum Leerengrat und tötet die Kreaturen, die Ihr dort findet. Sammelt 40 Seelensplitter des Leerengrats und kehrt dann zu Ogath dem Verrückten im Rückenbrecherposten zurück.‡공허의 마루로 가서 눈에 보이는 생명체들을 처치해야 합니다. 공허의 마루 영혼의 조각 40개를 모아서 해골망치 초소에 있는 미치광이 오가스에게 가져가야 합니다.‡Ve a la Cresta del Vacío y mata las criaturas que encuentres. Recolecta 40 fragmentos de alma de la Cresta del Vacío y llévaselos a Ogath el Loco, en la Avanzada Rompeloma.‡Ve a la Cresta del Vacío y mata las criaturas que encuentres. Recolecta 40 fragmentos de alma de la Cresta del Vacío y llévaselos a Ogath el Loco, en la Avanzada Rompeloma.‡Allez sur la crête du Vide et tuez les créatures que vous y trouverez. Réunissez 40 Éclats d\'âme de la crête du Vide et apportez-les à Ogath le Fol au Poste de Brise-échine.‡前往虚空山脉杀死当地的生物。收集40块虚空山脉灵魂碎片，把它们交给断背岗哨的疯狂的欧加斯。‡去虛無山脈並且殺死你找到的生物。收集40個虛無山脈靈魂裂片，並且交給斷脊氏族崗哨的瘋狂的歐卡司。',
  }
},
[10295] = {
  {
    'Do abismo‡Сила бездны‡Aus dem Abgrund‡심연에서...‡Desde el abismo‡Desde el abismo‡Du fond des abysses‡来自深渊‡來自深淵',
    nil,
    'Mate o Barão do Caos Galaxis e colete o Estilhaço de Alma. Leve o estilhaço para Ogath, o Louco, no Acampamento Quebra-espinha.‡Убейте Барона Бездны Галаксиса и добудьте осколок его души. Принесите осколок души Огафу Безумному на Заставу Хребтолома.‡Tötet Galaxis und sammelt seinen Seelensplitter. Bringt den Splitter zu Ogath dem Verrückten im Rückenbrecherposten.‡공허의 남작 갈락시스를 처치하고 그의 영혼의 조각을 해골망치 초소에 있는 미치광이 오가스에게 가져가십시오.‡Mata al barón del vacío Galaxis y recolecta un fragmento de su alma. Llévale el fragmento a Ogath el Loco en la Avanzada Rompeloma.‡Mata al barón del vacío Galaxis y recolecta un fragmento de su alma. Llévale el fragmento a Ogath el Loco en la Avanzada Rompeloma.‡Tuez le baron du Vide Galaxis et récupérez l\'Éclat de son âme. Apportez l\'éclat à Ogath le Fol au Poste de Brise-échine.‡杀死虚空男爵加拉希斯，并得到他的灵魂碎片，把它交给断背岗哨的疯狂的欧加斯。‡殺掉虛無男爵加倫希斯並收集他的靈魂裂片，將這個裂片帶給斷脊氏族崗哨的瘋狂的歐卡司。',
  }
},
[10296] = {
  {
    'Lamaçal Negro‡Черные топи‡Der schwarze Morast‡검은늪‡La Ciénaga Negra‡La Ciénaga Negra‡Le Noir marécage‡黑色沼泽‡黑色沼澤',
    nil,
    'Viaje pelas Cavernas do Tempo até o Lamaçal Negro durante a abertura do Portal Negro e fale com Sa\'at.‡Пройдите сквозь Пещеры времени до Черных топей времен открытия Темного портала и поговорите с Са\'атом.‡Reist durch die Höhlen der Zeit in den schwarzen Morast während der Öffnung des Dunklen Portals und sprecht mit Sa\'at.‡시간의 동굴을 지나 검은늪으로 가서 어둠의 문이 열리는 동안 사트와 대화해야 합니다.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Voyagez à travers les Grottes du temps jusqu\'au Noir marécage pendant l\'ouverture de la Porte des ténèbres et parlez à Sa\'at.‡深入时光之穴，前往正在发生黑暗之门开启这一历史事件的黑色沼泽，与萨艾特谈一谈。‡在黑暗之門開啟的期間經由穿越時光之穴到達黑色沼澤，並與塞特交談。',
  }
},
[10297] = {
  {
    'A abertura do Portal Negro‡Открытие Темного портала‡Die Öffnung des Dunklen Portals‡어둠의 문 열기‡La apertura de El Portal Oscuro‡La apertura de El Portal Oscuro‡L\'ouverture de la Porte des ténèbres‡开启黑暗之门‡黑暗之門的開啟',
    nil,
    'Sa\'at, dentro do Lamaçal Negro das Cavernas do Tempo, lhe conferiu a tarefa de defender Medivh enquanto ele abre o Portal Negro.nnFale novamente com Sa\'at caso tenha sucesso nesta missão.‡Защищайте Медива, пока он не откроет Темный портал.nnКогда выполните задание, возвращайтесь к Са\'ату в Черные топи.‡Sa\'at im schwarzen Morast der Höhlen der Zeit möchte, dass Ihr Medivh verteidigt, bis er das Dunkle Portal geöffnet hat.nnKehrt zu Sa\'at zurück, wenn Ihr erfolgreich wart.‡시간의 동굴의 검은늪 내에 있는 사트가 수호자 메디브가 어둠의 문을 여는 데 성공할 때까지 메디브를 방어하라는 임무를 주었습니다.nn임무에 성공하면 사트에게 돌아가야 합니다.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.nnVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.|n|nVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at, à l\'intérieur du Noir marécage des Grottes du temps, vous a demandé de défendre Medivh jusqu\'à ce qu\'il parvienne à ouvrir la Porte des ténèbres.nnRetournez voir Sa\'at si vous parvenez à accomplir cette tâche.‡时光之穴黑色沼泽的萨艾特要求你保护麦迪文，直到他成功开启黑暗之门。nn任务完成后向萨艾特复命。‡在時光之穴的黑色沼澤裡的塞特已給予你保護麥迪文直到他成功打開黑暗之門的任務。|n任務完成後，回到塞特那裡。',
  }
},
[10298] = {
  {
    'Herói da prole‡Герой драконьего племени‡Held des Schwarms‡종족의 영웅‡Adalid del linaje‡Adalid del linaje‡Héros de la progéniture‡龙族的英雄‡世代的拯救者',
    nil,
    'Fale novamente com Andormu nas Cavernas do Tempo, que fica no deserto de Tanaris.‡Возвращайтесь к маленькому Андорму в пустыню Танарис в Пещерах Времени.‡Kehrt zum Kind, Andormu, in den Höhlen der Zeit in Tanaris zurück.‡타나리스의 시간의 동굴에 있는 어린 안도르무에게 가야 합니다.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Retournez voir l\'enfant, Andormu, aux Grottes du temps dans le désert de Tanaris.‡返回塔纳利斯沙漠的时光之穴，向幼时的安多尔姆复命。‡回去塔納利斯沙漠的時光之穴找安杜姆。',
  }
},
[10299] = {
  {
    'Desativar Manaforja B\'naar‡Отключить манагорн Б\'наар‡Manaschmiede B\'naar abschalten‡브나르 마나괴철로 차단‡El cierre de la Forja de Maná B\'naar‡El cierre de la Forja de Maná B\'naar‡Extinction de la manaforge B\'naar‡关闭法力熔炉：布纳尔‡關閉法力熔爐巴納爾',
    nil,
    'Volte a Manaforja B\'naar e obtenha o Cristal de Acesso de B\'naar do Feitor Theredis. Use-o no Painel de Controle de B\'naar para desligá-la e, em seguida, apresente-se novamente a Anacoreta Karja.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Вернитесь в манагорн Б\'наар и заберите кристалл доступа у надзирателя Тередиса. Используйте его на панели управления манагорна, чтобы выключить его, затем сообщите об этом анахорету Карже. nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Karja möchte, dass Ihr in die Manaschmiede B\'naar geht und einen Zugangskristall von Vorarbeiter Theredis besorgt. Benutzt ihn bei der Steuerkonsole von B\'naar, um sie abzuschalten und meldet Euch danach bei Anachoret Karja zurück.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡브나르 마나괴철로로 돌아가서 감독관 테레디스에게서 브나르 장치 접근 수정을 입수한 후, 수정을 사용하여 브나르 마나괴철로 제어장치를 차단하고 수도자 카르자에게 보고해야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná B\'naar para coger un cristal de acceso del sobrestante Theredis. Úsalo en la consola de la Forja de Maná B\'naar para cerrarla y ve a informar a la Anacoreta Karja.nnCompletar misiones para los Aldor hará que tu nivel de reputación entre los Arúspices descienda.‡Vuelve a la Forja de Maná B\'naar para coger un cristal de acceso del sobrestante Theredis. Úsalo en la consola de la Forja de Maná B\'naar para cerrarla y ve a informar a la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Retournez à la manaforge B\'naar et prenez le Cristal d\'accès de B\'naar au Surveillant Theredis. Utilisez-le à la console de contrôle de la manaforge B\'naar pour l\'éteindre et faites votre rapport à l\'anachorète Karja.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡返回法力熔炉：布纳尔，从工头瑟瑞狄斯手中夺得布纳尔控制水晶。使用水晶关闭法力熔炉：布纳尔控制台，然后向学者卡尔亚复命。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡回到法力熔爐巴納爾從監督者瑞爾迪斯身上取得巴納爾控制水晶。使用它來關閉法力熔爐巴納爾控制臺然後回報隱士卡爾加。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10300] = {
  {
    'A restauração do cajado‡Восстановление посоха‡Den Stab wiederherstellen‡지팡이 수리‡Reconstrucción del bastón‡Reconstrucción del bastón‡La reconstruction du bâton‡修复法杖‡重鑄法杖',
    nil,
    'Obtenha quatro Estilhaços de Cristal Impecáveis dos fantasmas das Ruínas Enkaat e fale novamente com Ravandwyr, na Área 52.‡Заберите 4 осколка безупречного кристалла у призраков в руинах Энкаата и принесите Равандвиру в Зону 52.‡Besorgt 4 fehlerlose Kristallsplitter von den Geistern in den Ruinen von Enkaat und bringt sie zu Ravandwyr in Area 52.‡엔카트 폐허에 있는 유령들로부터 완전무결한 수정 조각 4개를 구하여 52번 구역에 있는 라반드위르에게 가져가야 합니다.‡Consigue 4 fragmentos de cristal perfectos de los fantasmas de las Ruinas de Enkaat y llévaselos a Ravandwyr en el Área 52.‡Consigue 4 fragmentos de cristal perfectos de los fantasmas de las Ruinas de Enkaat y llévaselos a Ravandwyr en el Área 52.‡Obtenez 4 Éclats de cristal sans défaut sur les fantômes des ruines d\'Enkaat et rapportez-les à Ravandwyr dans la Zone 52.‡从恩卡特废墟的鬼魂身上收集4块无暇的水晶碎片，将它们交给52区的拉文德维尔。‡從安卡特廢墟的鬼魂身上取回四個無瑕水晶裂片並且交給52區的羅樊德威。',
  }
},
[10301] = {
  {
    'O compêndio destrancado‡Открыть Компендиум‡Das Kompendium öffnen‡개론의 비밀‡Abrir el Compendio‡Abrir el Compendio‡Déverrouiller le compendium‡魔法纲要的防护‡開啟手冊',
    nil,
    'Obtenha o Monóculo Heliotrópico da Enfeitiçadora Marathelle, no Acampamento Solfúria.‡Заберите халцедоновое око у разрушительницы чар Маратель, находящейся в форте Ярости Солнца. Когда достигнете цели, используйте посох верховного мага Варгота, чтобы связаться с верховным магом. nnЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром, находящимся в Зоне 52, чтобы получить замену.‡Besorgt Euch das heliotrope Oculus von Zauberhäscherin Marathelle im Sonnenzornposten. Benutzt Erzmagier Vargoths Stab, um ihn zu kontaktieren, wenn Ihr fertig seid.nnFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡성난태양 주둔지에 있는 주문강탈자 마라텔로부터 진보랏빛 단안경을 입수해야 합니다.‡Consigue el óculo de heliotropo de la atracahechizos Marathelle en el Bastión Furia del Sol. Utiliza el bastón del archimago Vargoth cuando hayas conseguido tu objetivo.nnSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr en el Área 52 para que te dé otro.‡‡Prenez l\'Oculus héliotrope à la Saccage-sort Marathelle au bastion des Solfurie.‡从日怒堡的掠法者玛拉瑟雷手中夺得紫色单片眼镜，然后使用大法师瓦格斯的法杖与大法师取得联络。nn如果你不小心遗失了大法师瓦格斯的法杖，可以向52区的拉文德维尔再要一根。‡從日怒要塞的法術搶奪者瑪拉希歐身上取得紫羅蘭眼睛。完成之後使用大法師瓦戈斯之杖與大法師連絡。|n如果你遺失了大法師瓦戈斯之杖，與52區的羅樊德威交談以取得一個替代品。',
  }
},
[10302] = {
  {
    'Mutações voláteis‡Неустойчивые мутации‡Unberechenbare Mutanten‡갑작스럽게 생겨난 돌연변이‡Mutaciones volátiles‡Mutaciones volátiles‡Mutations volatiles‡暴躁的变异体‡暴躁突變者',
    nil,
    'Mate 8 Mutações Voláteis e fale com a Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Убейте 8 неустойчивых мутаций и вернитесь к ботанику Таэрикс на месте крушения в долине Аммен.‡Tötet 8 unberechenbare Mutanten und kehrt dann zu Botanikerin Taerix bei der Absturzstelle im Am\'mental zurück.‡갑작스럽게 생겨난 돌연변이 8마리를 처치한 후 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 돌아가야 합니다.‡Mata 8 mutaciones volátiles y ve a ver a la botánica Taerix al Lugar del Accidente en el Valle Ammen.‡Mata 8 mutaciones volátiles y ve a ver a la botánica Taerix al Lugar del Accidente en el Valle Ammen.‡Tuez 8 Mutations volatiles, puis retournez voir la botaniste Taerix au Point d\'impact dans le val d\'Ammen.‡杀死8个暴躁的变异体，然后向埃门谷坠毁点的植物学家塔蕾克丝复命。‡殺死8個暴躁突變者，然後返回安曼谷的失事地點的植物學家泰瑞茲那裡。',
  }
},
[10303] = {
  {
    'Os elfos sangrentos‡Эльфы крови‡Die Blutelfen‡블러드 엘프‡Los elfos de sangre‡Los elfos de sangre‡Les elfes de sang‡血精灵‡血精靈',
    nil,
    'Mate 10 Batedores Elfos Sangrentos. Em seguida, fale com Tolaan na Serra das Sombras, que fica no Vale Ammen.‡Убейте 10 эльфов крови – разведчиков и вернитесь к Толаану на хребет Теней в долине Аммен.‡Tötet 10 Blutelfenspäher und kehrt dann zu Tolaan im Schattenkamm im Am\'mental zurück.‡블러드 엘프 정찰병 10명을 처치한 후 암멘 골짜기의 어둠 마루에 있는 톨란에게 돌아가야 합니다.‡Mata a 10 exploradores elfos de sangre y ve a ver a Tolaan a la Cresta de las Sombras en el Valle Ammen.‡Mata a 10 exploradores elfos de sangre y ve a ver a Tolaan a la Cresta de las Sombras en el Valle Ammen.‡Tuez 10 Eclaireurs elfes de sang, puis retournez voir Tolaan sur l\'Ombrecrête du val d\'Ammen.‡杀死10个血精灵斥候，然后向埃门谷暗影山的图兰复命。‡殺死10個血精靈斥候，然後返回安曼谷裡暗影山脊的托蘭那裡。',
  }
},
[10304] = {
  {
    'O vindicante Aldar‡Воздаятель Алдар‡Verteidiger Aldar‡구원자 알다르‡El vindicador Aldar‡El vindicador Aldar‡Le redresseur de torts Aldar‡守备官奥达尔‡復仇者艾德',
    nil,
    'Fale com o Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с воздаятелем Алдаром на месте крушения в долине Аммен.‡Sprecht mit Verteidiger Aldar bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 구원자 알다르와 대화해야 합니다.‡Habla con el vindicador Aldar en el Lugar del Accidente en el Valle Ammen.‡Habla con el vindicador Aldar en el Lugar del Accidente en el Valle Ammen.‡Parlez au redresseur de torts Aldar au point d\'impact au val d\'Ammen.‡与埃门谷坠毁点的守备官奥达尔谈一谈。‡',
  }
},
[10305] = {
  {
    'Abjurante Belmara‡Клятвопреступница Белмара‡Bannzauberin Belmara‡변절자 벨마라‡Abjuradora Belmara‡Abjuradora Belmara‡L\'abjuriste Belmara‡防御法师贝尔玛拉‡貝馬拉',
    nil,
    'Encontre o alojamento da Abjurante Belmara no Estreito do Teurgo e retorne o livro à sua estante. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты клятвопреступницы Белмары в переулке Волшебников и верните книгу на полку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Bannzauberin Belmara in der Zaubergasse und bringt das Buch zurück auf seinen Platz im Bücherregal. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 변절자 벨마라의 집으로 고서를 가지고 가서 책장에 놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias de la abjuradora Belmara en el Pasaje del Zahorí y devuelve el libro a la estantería. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias de la abjuradora Belmara en el Pasaje del Zahorí y devuelve el libro a la estantería. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez la maison de l\'abjuriste Belmara dans l\'Allée des sorciers et replacez le livre sur l\'Étagère de livres. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到防御法师贝尔玛拉的住所，将书放回书架上。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到貝馬拉在巫師街的所在處然後把書放回他的書櫃。完成後，與肯瑞瓦村莊的管理者戴沃斯談談。',
  }
},
[10306] = {
  {
    'Conjurador Luminrath‡Кудесник Люминрат‡Beschwörer Luminrath‡창조술사 루민라스‡Conjurador Luminrath‡Conjurador Luminrath‡L\'adjurateur Luminrath‡咒术师鲁米拉斯‡咒術師盧瑞斯',
    nil,
    'Encontre o alojamento do Conjurador Luminrath no Estreito do Teurgo e retorne o manto à sua cômoda. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты кудесника Люминрата в переулке Волшебников и верните плащ в его гардероб. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Beschwörer Luminrath in der Zaubergasse und bringt den Mantel zurück in seine Kommode. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 창조술사 루민라스의 집에 가서 그의 옷장에 망토를 돌려 넣어야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias del conjurador Luminrath, en el Pasaje del Zahorí y devuelve la capa a su vestidor. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias del conjurador Luminrath, en el Pasaje del Zahorí y devuelve la capa a su vestidor. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile de l\'adjurateur Luminrath dans l\'allée des sorciers et replacez le mantelet dans sa Commode. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到咒术师鲁米拉斯的住所，将披风放回衣柜里。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到咒術師盧瑞斯在巫師街的所在處並且把披肩放回他的衣櫃。然後，跟肯瑞瓦村莊的管理者戴沃斯談話。',
  }
},
[10307] = {
  {
    'Cohlien Tecegelo‡Кольен Повелитель Льда‡Cohlien Frostwirker‡콜린 프로스트위버‡Cohlien Tejescarcha‡Cohlien Tejescarcha‡Cohlien Tissegivre‡考利恩·霜纹‡考林·織霜者',
    nil,
    'Encontre o alojamento de Cohlien Tecegelo no Estreito do Teurgo e devolva o chapéu ao Armarinho. Depois, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты Кольена Повелителя Льда в переулке Волшебников и верните шляпу на вешалку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Cohlien Frostwirker in der Zaubergasse und bringt die Kappe zurück in seine Schließkiste. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 콜린 프로스트위버의 방으로 가서 그의 사물함에 모자를 돌려놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias de Cohlien Tejescarcha, en el Pasaje del Zahorí y devuelve el sombrero a su baúl. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias de Cohlien Tejescarcha, en el Pasaje del Zahorí y devuelve el sombrero a su baúl. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile de Cohlien Tissegivre dans l\'Allée des sorciers et replacez le chapeau dans sa Cantine. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到考利恩·霜纹的住所，将帽子放回小提箱中。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到考林·織霜者在巫師街的所在處並且把帽子放到它的小提箱裡。然後，跟肯瑞瓦村莊的管理者戴沃斯談話。',
  }
},
[10308] = {
  {
    'Mais destroços etéreos‡Еще одна группа духов Астрала‡Noch ein Hügel voller Astraler‡또 다른 에테리얼 무리‡Otro montón de etéreos‡Otro montón de etéreos‡Un autre monceau d\'éthériens‡更多叛徒的徽记‡另一支伊斯利勢力',
    nil,
    'O Consórcio está muitíssimo interessado em exterminar todos os rebeldes Zaxxis nos Destroços, ao sul.nn<class>, se quiser cair mais ainda em nossas graças, desça lá e traga mais insígnias de afiliação.‡‡Das Konsortium ist sehr daran interessiert, alle Rebellen der Zaxxis beim Hügel im Süden auszulöschen.nn<Klasse>, wenn Ihr Euch bei uns noch beliebter machen wollt, dann geht zurück und besorgt noch mehr ihrer Insignien.‡‡‡‡Il Consorzio è molto interessato all\'eliminazione di tutti i ribelli Zaxxis del Cumulo a sud.nn<classe>, se desideri entrare ulteriormente nelle nostre grazie, vai laggiù e portaci altri loro fregi.‡‡',
  }
},
[10309] = {
  {
    'É um aníquilus, mas tem coração‡Это сквернобот, но у него есть сердце!‡Teufelshäscher mit Herz‡심장이 뛰는 지옥절단기‡Es un atracador vil... pero con corazón‡Es un atracador vil... pero con corazón‡C\'est un saccageur gangrené, mais avec un cœur‡魔能机甲的心跳‡有心臟的惡魔搶奪者',
    nil,
    'Consiga o coração do Aníquilus e leve-o ao Tchunarubleize, nos Destroços, em Eternévoa.‡Заберите сердце сквернобота и отнесите Н. Д. Лагерфелту на Груду в Пустоверти.‡Besorgt das Herz des Teufelshäschers und bringt es zu N. D. Mieskamp beim Hügel im Nethersturm.‡지옥절단기 심장을 찾아서 황천의 폭풍의 고철더미에 있는 N. D. 민캠프에게 가져가야 합니다.‡Recupera el corazón del atracador vil y entrégaselo a N. D. Malcampo en La Pila, en Tormenta Abisal.‡Recupera el corazón del atracador vil y entrégaselo a N. D. Malcampo en La Pila, en Tormenta Abisal.‡Récupérez le Cœur du saccageur gangrené et apportez-le à N. D. Malacamp, au Monceau au Raz-de-Néant.‡将魔能机甲之心交给虚空风暴机甲废场的米西·米恩卡普。‡取回惡魔搶奪者之心，並且把它交付給虛空風暴的聚集之地的閔坎普。',
  }
},
[10310] = {
  {
    'Sabotar o portal!‡Саботаж в портале‡Sabotage am Warptor!‡공간이동 관문 파괴!‡¡Sabotead el portal de distorsión!‡¡Sabotead el portal de distorsión!‡Sabotez le portail dimensionnel !‡破坏迁跃门！‡破壞星移門!',
    nil,
    'Escolte Drijya até o portal do Ponto de Invasão: Destruidor e mantenha-o a salvo, enquanto ele tenta sabotar o portal. Em seguida, fale com Gahruj, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Сопроводите Дризья до точки вторжения: Разрушитель и проследите за безопасностью во время попыток саботажа. Затем поговорите с Гаруджем на заставе в заповеднике "Срединные земли" в Пустоверти.‡Begleitet Drijya zum Warptor beim Invasionspunkt: Zerstörer und sorgt für seine Sicherheit, während er das Tor sabotiert. Sprecht danach mit Gahruj im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡드리지아를 파괴자의 침공 거점의 공간이동 관문까지 호위하고 그가 관문을 파괴하는 동안 그를 안전하게 지켜준 후, 황천의 폭풍의 중앙 생태지구 안에서 중앙 생태지구 주둔지에 있는 가루즈와 대화해야 합니다.‡Escolta a Drijya hasta el portal de distorsión en el Punto de Invasión: Destructor, y cúbrelo mientras intenta sabotearlo. Después habla con Gahruj en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media en Tormenta Abisal.‡Escolta a Drijya hasta el portal de distorsión en el Punto de Invasión: Destructor, y cúbrelo mientras intenta sabotearlo. Después habla con Gahruj en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media en Tormenta Abisal.‡Escortez Drijya jusqu\'au portail dimensionnel au Site d\'invasion Destructeur, et faites en sorte qu\'il reste en sécurité pendant qu\'il tente de le saboter. Puis parlez à Gahruj au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡护送德里亚到达登陆场：破坏的迁跃门，并在他尝试破坏迁跃门的过程中保护他的安全。然后返回虚空风暴的中央生态圆顶，向中央圆顶哨站的加鲁斯复命。‡護送迪耶亞到位於侵略點:摧毀者的星移門，並注意在他破壞門的時候保護他的安全。完成後到虛空風暴上秘境領地裡的領地崗哨找加魯談談。',
  }
},
[10311] = {
  {
    'Drijya precisa de você‡Дризья нужна твоя помощь‡Drijya braucht Eure Hilfe‡도움이 필요한 드리지아‡Drijya necesita tu ayuda‡Drijya necesita tu ayuda‡Drijya a besoin de votre aide‡德里亚需要你的帮助‡迪耶亞需要你的幫助',
    nil,
    'Fale com Drijya próximo do Ponto de Invasão: Destruidor, em Eternévoa.‡Поговорите с Дризья, находящимся около Места Вторжения "Разрушитель" в Пустоверти.‡Sprecht mit Drijya in der Nähe des Invasionspunkts: Zerstörer im Nethersturm.‡황천의 폭풍의 파괴자의 침공 거점 근처에 있는 드리지아와 대화해야 합니다.‡Habla con Drijya cerca del Punto de Invasión: Destructor en Tormenta Abisal.‡Habla con Drijya cerca del Punto de Invasión: Destructor en Tormenta Abisal.‡Parlez à Drijya près du Site d\'invasion Destructeur au Raz-de-Néant.‡与虚空风暴登陆场：破坏的德里亚谈一谈。‡與虛空風暴的侵略點:摧毀者附近的迪耶亞交談。',
  }
},
[10312] = {
  {
    'Os anais de Kirin\'Var‡Анналы Кирин\'Вара‡Die Annalen von Kirin\'Var‡키린바르의 연대기‡Los Anales de Kirin\'Var‡Las Crónicas de Kirin\'Var‡Les annales de Kirin\'Var‡肯瑞瓦名册‡肯瑞瓦的記錄',
    nil,
    'Recupere os Anais de Kirin\'Var, na prefeitura da Vila Kirin\'Var, e retorne-os ao Zelador Dieworth.‡Заберите анналы Кирин\'Вара из ратуши деревни Кирин\'Вар и отнесите ее смотрителю Дайворту.‡Besorgt die Annalen von Kirin\'Var aus dem Rathaus von Kirin\'Var und bringt es zu Hüter Dierwert.‡키린바르 마을의 마을회관에서 키린바르 연대기를 되찾은 다음 관리인 디워스에게 돌려 줘야 합니다.‡Recupera los anales de Kirin\'Var en el ayuntamiento del Poblado Kirin\'Var y llévaselos al custodio Valemuerte.‡Recupera las Crónicas de Kirin\'Var en el ayuntamiento del Poblado Kirin\'Var y llévaselas al custodio Valemuerte.‡Récupérez les Annales de Kirin\'Var à l\'hôtel de ville de Kirin\'Var et rapportez-les au protecteur Valemort.‡从肯瑞瓦村的城镇大厅中取回肯瑞瓦名册，将它交给管理者戴沃斯。‡自肯瑞瓦村莊的市政廳取回肯瑞瓦的記錄，並把它歸還給監護者戴沃斯。',
  }
},
[10313] = {
  {
    'Medição de energias dimensionais‡Измерение энергии Искажения‡Warpenergien messen‡초공간 에너지 측정‡Medir energías de distorsión‡Medir energías de distorsión‡Mesurer les énergies dimensionnelles‡测量迁跃能量‡測量扭曲能量',
    nil,
    'O Exarca Orelis, na Área 52, quer que você leve o Orbe Dimensional Harmonizado a Manaforja B\'naar e que o use na extremidade dos quatro tubos.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Экзарх Орелис, находящийся в Зоне 52, просит вас отнести настроенный на энергию искривления шар к манагорну Б\'наар и использовать шар у окончания четырех трубопроводов. nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Exarch Orelis in Area 52 möchte, dass Ihr die Warpmesskugel zur Manaschmiede B\'naar bringt und sie in der Nähe der vier Rohrleitungen benutzt.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eurer Ehre bei den Sehern.‡52번 구역에 있는 총독 오렐리스가 브나르 마나괴철로에 차원의 힘 측정 구슬을 가져가서 근처에 있는 4개의 수송관로의 끝에 사용해 달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡El exarca Orelis del Área 52 quiere que te lleves el orbe armonizado con la distorsión a la Forja de Maná B\'naar y lo uses al final de sus 4 tuberías.nnA medida que completas misiones para los Aldor disminuye tu nivel de reputación con los Arúspices.‡El exarca Orelis del Área 52 quiere que te lleves el orbe armonizado con la distorsión a la Forja de Maná B\'naar y lo uses al final de sus 4 tuberías.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'exarque Orelis de la Zone 52 veut que vous emportiez l\'Orbe d\'harmonisation interdimensionnelle à la manaforge B\'naar et que vous l\'utilisiez à l\'extrémité de ses quatre pipelines.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡52区的大主教欧雷里斯要你将迁跃共鸣宝珠带往法力熔炉：布纳尔，并在法力熔炉四条管道的末端使用它。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡52區的主教歐瑞利斯要你帶著不協調寶珠到法力熔爐巴納爾去並將它使用在四條導線的尾端。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10314] = {
  {
    'Suspeita persistente‡Длительные подозрения‡Ein hartnäckiger Verdacht‡사라지지 않는 의구심‡Una sospecha latente‡Una sospecha latente‡Le doute subsiste...‡久远的痕迹‡長久的懷疑',
    nil,
    'Junte 10 Restos Repugnantes dos espíritos corrompidos no pátio da capela da Vila Kirin\'Var e leve-os ao Zelador Dieworth.‡Соберите 10 омерзительных останков искаженных духов во дворе часовни деревни Кирин\'Вар и отнесите их смотрителю Дайворту.‡Sammelt 10 abscheuliche Überreste von den wahnsinnigen Geistern auf dem Kapellenhof in Kirin\'Var und bringt sie zu Hüter Dierwert.‡키린바르 마을의 예배당 지구에 있는 뒤틀린 영혼들로부터 기분 나쁜 잔여물 10개를 수집한 후 관리인 디워스에게 가져가야 합니다.‡Consigue 10 restos repugnantes de los espíritus malignos del Patio de la Capilla del Poblado Kirin\'Var y llévaselos al custodio Valemuerte.‡Consigue 10 restos repugnantes de los espíritus malignos del Patio de la Capilla del Poblado Kirin\'Var y llévaselos al custodio Valemuerte.‡Récupérez 10 Restes répugnants sur les esprits retors de la Cour de la chapelle de Kirin\'Var et apportez-les au protecteur Valemort.‡从肯瑞瓦村礼拜堂广场中扭曲的幽灵身上收集10份令人厌恶的残留物，将它们交给管理者戴沃斯。‡從肯瑞瓦村莊的教堂庭院的扭曲的鬼魂身上收集10個憎惡殘餘並且交給管理者戴沃斯。',
  }
},
[10315] = {
  {
    'Neutralize os etermantes‡Нейтрализовать чародеев Пустоты‡Die Nethermanten neutralisieren‡황천의 추적자 무력화‡Neutralizar a los abisálicos‡Neutralizar a los abisálicos‡Neutraliser les néantomanciens‡消灭虚空法师‡消滅虛空術師',
    nil,
    'Mate 15 Etermantes Solfúria e fale novamente com o Espreitador do Nexus Oazul, no Acampamento do Tuluman, em Eternévoa.‡Убейте 15 пустомантов клана Ярости Солнца и возвращайтесь к ловчему Пустоты Оазулу в Лагерь Тулумана в Пустоверти.‡Tötet 15 Nethermanten des Sonnenzorns und kehrt dann zu Netherpirscher Oazul in Tulumans Landeplatz im Nethersturm zurück.‡성난태양 황천술사 15명을 처치한 후 황천의 폭풍의 툴루맨의 정박지에 있는 황천의 추적자 오아줄에게 돌아가야 합니다.‡Mata a 15 abisálicos Furia del Sol y ve a ver al acechador abisal Oazul al Alto de Tuluman en Tormenta Abisal.‡Mata a 15 abisálicos Furia del Sol y ve a ver al acechador abisal Oazul al Alto de Tuluman en Tormenta Abisal.‡Tuez 15 Néantomanciens solfurie puis retournez voir le traqueur-du-Néant Oazul au Point d\'ancrage de Tuluman au Raz-de-Néant.‡消灭15名日怒虚空法师，然后返回虚空风暴内的图鲁曼的营地，向虚空猎手奥尔苏复命。‡殺死15個日怒虛空術師，並返回虛空風暴之吐魯曼平臺的虛空行者歐祖爾那裡。',
  }
},
[10316] = {
  {
    'Em busca de evidências‡В поисках доказательств‡Auf der Suche nach Beweisen‡단서 찾기‡En busca de pruebas‡En busca de pruebas‡À la recherche de preuves‡寻找证据‡尋找證據',
    nil,
    'Busque pistas no Pátio da Capela da Vila Kirin\'Var para saber quem está por trás da manipulação dos espíritos.‡Поищите во дворе часовни в деревне Кирин\'Вар свидетельства того, кто именно манипулирует духами убитых.‡Durchsucht die Häuser auf dem Kapellenhof von Kirin\'Var nach Hinweisen darauf, wer sich hinter der Beeinflussung der Geister verbirgt.‡키린바르 마을의 예배당 지구에서 누가 배후에서 영혼들을 조작했는지 알아낼 수 있는 단서를 찾아야 합니다.‡Busca pistas sobre el responsable de la manipulación de los espíritus en el Patio de la Capilla del Poblado Kirin\'Var.‡Busca pistas sobre el responsable de la manipulación de los espíritus en el Patio de la Capilla del Poblado Kirin\'Var.‡Fouillez la Cour de la chapelle de Kirin\'Var à la recherche d\'indices au sujet de l\'identité de la personne responsable de la manipulation des esprits.‡在肯瑞瓦村的礼拜堂广场寻找操纵鬼魂滋扰村庄的幕后黑手的线索。‡在肯瑞瓦村莊教堂庭院搜索關於操縱那些靈魂的幕後主使者的線索。',
  }
},
[10317] = {
  {
    'Dando um jeito no encarregado‡Покончить со штейгером‡Den Großknecht erledigen‡현장감독 선다운‡Tratar con el supervisor‡Tratar con el supervisor‡S\'occuper du contremaître‡对付工头‡解決工頭',
    nil,
    'Lide com o Encarregado Ocaso, no interior da Mina Trelleum, sob Manaforja Ara, em Eternévoa.‡Покончите со штейгером Закатом Солнца, находящимся в руднике Треллеума под манагорном Ара в Пустоверти.‡Vernichtet Großknecht Sonnenend in der Trelleummine, die sich unter der Manaschmiede Ara im Nethersturm befindet.‡황천의 폭풍의 아라 마나괴철로 지하에서 트렐리움 광산 안에 있는 현장감독 선다운과 대화해야 합니다.‡Encárgate del supervisor Ocaso en la Mina Trelleum, que está bajo la Forja de Maná Ara en Tormenta Abisal.‡Encárgate del supervisor Ocaso en la Mina Trelleum, que está bajo la Forja de Maná Ara en Tormenta Abisal.‡Occupez-vous du contremaître Tombesoleil à l\'intérieur de la mine de Trelleum, qui se trouve sous la manaforge Ara au Raz-de-Néant.‡前往虚空风暴法力熔炉：艾拉地下的特雷卢姆矿井，对付工头萨杜恩·日落。‡在崔爾曼礦坑裡面解決工頭日落，崔爾曼礦坑在虛空風暴的法力熔爐艾拉下面。',
  }
},
[10318] = {
  {
    'Um mestre supremo a se lidar‡Покончить с Подчинителем‡Den Übermeister erledigen‡정복자 그라인드가르 처치‡Conversaciones con el maestro Supremo‡Conversaciones con el maestro Supremo‡S\'occuper du contremaître‡督工格林加尔‡解決征服者',
    nil,
    'Mate o Mestre Supremo Grindgarr. Em seguida, fale novamente com o Mercador do Vento Tuluman, no Acampamento do Tuluman, em Eternévoa.‡Убейте Подчинителя Гриндгарра. Затем вернитесь к торговцу Ветром Тулуману в Лагерь Тулумана в Пустоверти.‡Tötet Übermeister Grindgarr. Kehrt dann zu Windhändler Tuluman in Tulumans Landeplatz im Nethersturm.‡정복자 그라인드가르를 처치한 후 황천의 폭풍으로 가서 툴루만의 교역지에 있는 바람의 무역상 툴루만에게 가야 합니다.‡Mata al maestro supremo Yugogarr. A continuación ve a ver al comerciante de viento Tuluman en el Alto de Tuluman, en la Tormenta Abisal.‡Mata al maestro supremo Yugogarr. A continuación ve a ver al comerciante de viento Tuluman en el Alto de Tuluman, en la Tormenta Abisal.‡Tuez le Grand seigneur Grincegarr. Retournez ensuite auprès du marchand des vents Tuluman au Point d\'ancrage de Tuluman de Raz-de-Néant.‡杀死督工格林加尔，然后返回虚空风暴内图鲁曼的营地，向星界商人图鲁曼复命。‡殺死征服者古林德卡爾。然後返回虛空風暴的吐魯曼平臺的風之貿易者吐魯曼那裡。',
  }
},
[10319] = {
  {
    'A captura do filactério‡Захватить талисман‡Das Phylakterium entwenden‡성물함 입수‡Captura de la filacteria‡Captura de la filacteria‡La capture du phylactère‡纳比留斯的护符匣‡取得骨匣',
    nil,
    'Consiga o Filactério de Naberius, no distrito do Pátio da Capela da Vila Kirin\'Var, e traga-o ao Zelador Dieworth.‡Заберите филактерию Набериуса из района часовни деревни Кирин\'Вар и принесите его смотрителю Дайворту.‡Holt Naberius\' Phylakterium vom Kapellenhof in Kirin\'Var und bringt es zu Hüter Dierwert.‡키린바르 마을의 예배당 지구에서 나베리우스의 성물함을 되찾은 후 관리인 디워스에게 가져가야 합니다.‡Recupera la filacteria de Naberius en el Patio de la Capilla del Poblado Kirin\'Var y llévasela al custodio Valemuerte.‡Recupera la filacteria de Naberius en el Patio de la Capilla del Poblado Kirin\'Var y llévasela al custodio Valemuerte.‡Récupérez le Phylactère de Naberius dans le quartier de la Cour de la chapelle de Kirin\'Var et apportez-le au protecteur Valemort.‡在肯瑞瓦村的礼拜堂广场中找到纳比留斯的护符匣，将它交给管理者戴沃斯。‡在肯瑞瓦村莊教堂後院區取回納伯瑞厄斯骨匣然後帶去給管理者戴沃斯。',
  }
},
[10320] = {
  {
    'Destrua Naberius!‡Уничтожить Набериуса!‡Vernichtet Naberius!‡나베리우스 처치!‡¡Destruir a Naberius!‡¡Destruir a Naberius!‡Détruisez Naberius !‡毁灭纳比留斯！‡消滅納伯瑞厄斯!',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você confronte e derrote Naberius, no Pátio da Capela da Vila.‡Смотритель Дайворт в деревне Кирин\'Вар просит вас сразиться с Набериусом, находящимся во дворе часовни, и уничтожить его.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr Naberius auf dem Kapellenhof des Dorfes besiegt.‡키린바르 마을에 있는 관리인 디워스가 마을의 예배당 지구에 있는 나베리우스를 처치해 달라고 부탁했습니다.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que derrotes a Naberius en el Patio de la Capilla del poblado.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que derrotes a Naberius en el Patio de la Capilla del poblado.‡Le protecteur Valemort de Kirin\'Var vous demande d\'affronter Naberius et de le vaincre dans la Cour de la chapelle du village.‡肯瑞瓦村的管理者戴沃斯要你击败礼拜堂广场中的纳比留斯。‡肯瑞瓦村莊的管理者戴沃斯要你擊敗教堂庭院的納伯瑞厄斯。',
  }
},
[10321] = {
  {
    'Desativar Manaforja Coruu‡Отключить манагорн Коруу‡Manaschmiede Coruu abschalten‡코루 마나괴철로 차단‡El cierre de la Forja de Maná Coruu‡El cierre de la Forja de Maná Coruu‡Extinction de la manaforge Coruu‡关闭法力熔炉：库鲁恩‡關閉法力熔爐寇魯',
    nil,
    'Viaje até Manaforja Coruu, a leste da Área 52, e obtenha o Cristal de Acesso de Coruu da Feitora Seylanna. Use-o no Painel de Controle de Coruu para desativá-la e fale novamente com a Anacoreta Karja.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Коруу к востоку от Зоны 52 и заберите кристалл доступа Коруу у надзирательницы Сейланны. Используйте его на панели управления манагорна Коруу, чтобы отключить манагорн, затем вернитесь к анахорету Карже.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Coruu, östlich von Area 52, und besorgt den Zugangskristall von Coruu von Vorarbeiterin Seylanna. Benutzt ihn, um die Manaschmiede abzuschalten, und kehrt dann zu Anachoret Karja zurück.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡52번 구역의 동쪽에 있는 코루 마나괴철로로 간 후 감독관 세일란나에게서 코루 장치 접근 수정을 획득해야 합니다. 그런 다음 코루 제어장치에 사용해서 코루 마나괴철로를 차단한 후 수도자 카르자에게 돌아가십시오.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Coruu, al este del Área 52, y obtén el cristal de acceso de Coruu del sobrestante Seylanna. Úsalo en la consola de Forja de Maná Coruu para desactivarla y vuelve a hablar con la Anacoreta Karja.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Coruu, al este del Área 52, y obtén el cristal de acceso de Coruu del sobrestante Seylanna. Úsalo en la consola de Forja de Maná Coruu para desactivarla y vuelve a hablar con la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Voyagez jusqu\'à la manaforge Coruu, à l\'est de la Zone 52, et prenez le Cristal d\'accès de Coruu à la surveillante Seylanna. Utilisez-le à la console de la manaforge Coruu pour l\'éteindre.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往52区以东的法力熔炉：库鲁恩，从工头希兰娜手中夺得库鲁恩控制水晶。对法力熔炉：库鲁恩的控制台使用水晶关闭法力熔炉，然后向学者卡尔亚复命。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐寇魯去，就在52區的東方，並從監督者塞琳娜那拿到寇魯控制水晶。使用它關閉法力熔爐寇魯控制臺，完成後回去找隱士卡爾加。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10322] = {
  {
    'Desativar Manaforja Dúria‡Отключить манагорн Даро‡Manaschmiede Duro abschalten‡듀로 마나괴철로 차단‡El cierre de la Forja de Maná Duro‡El cierre de la Forja de Maná Duro‡Extinction de la manaforge Duro‡关闭法力熔炉：杜隆‡關閉法力熔爐杜羅',
    nil,
    'A Anacoreta Karja quer que você vá a Manaforja Dúria e que obtenha o Cristal de Acesso de Dúria do Feitor Athanel. Use-o no Painel de Controle de Dúria para desativá-la.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Анахорет Каржа просит вас отправиться в манагорн Даро и забрать кристалл доступа у надзирателя Атанеля. Используйте этот кристалл на панели управления манагорном Даро, чтобы отключить его.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Karja möchte, dass Ihr zur Manaschmiede Duro geht und den Zugangskristall von Vorarbeiter Athanel besorgt. Benutzt ihn, um die Steuerungskonsole von Duro abzuschalten.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡수도자 카르자가 듀로 마나괴철로로 가서 감독관 아사넬에게서 듀로 장치 접근 수정을 입수해 달라고 했습니다. 그런 후 듀로 마나괴철로 제어장치에 사용해서 차단해야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La Anacoreta Karja quiere que vayas a la Forja de Maná Duro y consigas el cristal de acceso del sobrestante Athanel. Utilízalo en la consola de la Forja de Maná Duro para desactivarla.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con Los Arúspices.‡La Anacoreta Karja quiere que vayas a la Forja de Maná Duro y consigas el cristal de acceso del sobrestante Athanel. Utilízalo en la consola de la Forja de Maná Duro para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'anachorète Karja vous demande de vous rendre à la manaforge Duro et de vous procurer le Cristal d\'accès de Duro porté par le surveillant Athanel. Utilisez-le sur la Console de la manaforge Duro pour déclencher l\'extinction.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡学者卡尔亚要你前往法力熔炉：杜隆，从工头安萨奈尔手中夺得杜隆控制水晶。对法力熔炉：杜隆的控制台使用水晶关闭法力熔炉。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡隱士卡爾加要你前往法力熔爐杜羅並從監督者阿森尼爾身上取得杜羅控制水晶。使用它來關閉法力熔爐杜羅控制臺。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10323] = {
  {
    'Desativar Manaforja Ara‡Отключить манагорн Ара‡Manaschmiede Ara abschalten‡아라 마나괴철로 차단‡El cierre de la Forja de Maná Ara‡El cierre de la Forja de Maná Ara‡Extinction de la manaforge Ara‡关闭法力熔炉：艾拉‡關閉法力熔爐艾拉',
    nil,
    'Viaje até Manaforja Ara e obtenha o Cristal de Acesso de Ara do Feitor Azarad. Use-o no Painel de Controle de Ara para desativá-la.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Ара и заберите кристалл доступа у надзирателя Азарада. Используйте его на панели доступа манагорна Ара, чтобы отключить его.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Ara und besorgt Euch einen Zugangskristall von Vorarbeiter Azarad. Benutzt ihn, um die Steuerungskonsole von Ara abzuschalten.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡아라 마나괴철로로 간 후 감독관 아자라드에게서 아라 장치 접근 수정을 입수해야 합니다. 그런 후 아라 제어장치에 사용하여 괴철로를 차단해야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Ara y obtén el cristal de acceso de Ara del sobrestante Azarad. Úsalo en la consola de Forja de Maná Ara para desactivarla.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Ara y obtén el cristal de acceso de Ara del sobrestante Azarad. Úsalo en la consola de Forja de Maná Ara para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Voyagez jusqu\'à la manaforge Ara et prenez le Cristal d\'accès d\'Ara sur le contremaître Azarad. Utilisez-le à la console de la manaforge Ara pour l\'éteindre.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：艾拉，从工头阿扎拉德手中夺得艾拉控制水晶。对法力熔炉：艾拉的控制台使用水晶关闭法力熔炉。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐艾拉從監督者阿薩納德那拿到艾拉控制水晶。使用它關閉法力熔爐艾拉控制臺。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10324] = {
  {
    'A grande caçada de pastolunas‡Великая охота на лунных оленей‡Die große Mondweidenjagd‡달새김 순록 사냥‡La gran cacería del ciervo lunar‡La gran cacería lunar‡La grande chasse aux frôle-lune‡狩猎月痕鹿‡牧月大獵殺',
    nil,
    'Leve 6 Pelegos de Machos Pastoluna a Acteon no Entreposto Lazúli.‡Принесите 6 шкур самцов лунного оленя Актеону с Лазурной заставы.‡Bringt 6 Bälge eines Mondweidenbocks zu Acteon in der Azurwacht.‡하늘 감시초소에 있는 옥테온에게 달새김 순록 통가죽 6개를 가져가야 합니다.‡Lleva 6 pieles de ciervos lunares a Acteon a la Avanzada Azur.‡Lleva 6 pieles de ciervos lunares a Acteon a la Avanzada Azur.‡Apportez 6 Peaux de chevreuil frôle-lune à Acteon au Guet d\'azur.‡将6张月痕鹿皮交给碧蓝岗哨的艾克提恩。‡將6個牧月雄鹿皮革帶去給藍色守望的艾克緹昂。',
  }
},
[10325] = {
  {
    'Marca de Kil\'Jaeden‡Знаки Кил\'джедена‡Male von Kil\'jaeden‡킬제덴의 징표‡Marcas de Kil\'jaeden‡Marcas de Kil\'jaeden‡Les marques de Kil\'jaeden‡基尔加丹印记‡基爾加丹印記',
    nil,
    'Leve 10 Marcas de Kil\'Jaeden para Adyen, o Guardião da Luz, em Shattrath.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Принесите 10 знаков Кил\'джедена Адуину Стражу Света в Шаттрат.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt 10 Male von Kil\'jaeden zu Adyen dem Lichtwächter in Shattrath.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 빛의 수호자 아드옌에게 킬제덴의 징표 10개를 가져가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva 10 marcas de Kil\'jaeden a Adyen el Celador de la Luz en la Ciudad de Shattrath.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con Los Arúspices.‡Lleva 10 marcas de Kil\'jaeden a Adyen el Celador de la Luz en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Remettre 10 Marques de Kil\'jaeden à Adyen le Gardelumière, à Shattrath.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将10枚基尔加丹印记交给沙塔斯城内的圣光护卫者阿德因。nn为奥尔多完成任务将会使你在占星者声望中的声望等级降低。‡將10個基爾加丹印記交給撒塔斯城的『護光者』艾德伊恩。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10326] = {
  {
    'Mais marcas de Kil\'jaeden‡Больше знаков Кил\'джедена‡Mehr Male von Kil\'jaeden‡킬제덴의 징표 추가 수집‡Más marcas de Kil\'jaeden‡Más marcas de Kil\'jaeden‡De nouvelles marques de Kil\'jaeden‡更多基尔加丹印记‡更多的基爾加丹印記',
    nil,
    'Trazes tu mais insígnias de nossos inimigos, <class>? A Legião Ardente ainda representa ameaça, e continuamos a persegui-los onde quer que os encontremos.‡Вы принесли еще знаков различия наших врагов, |3-6(Охотник)? Пылающий Легион все еще угрожает нам, и мы преследуем его повсеместно.‡Tragt Ihr noch mehr Insignien des Feindes bei Euch, <Name>? Die Brennende Legion ist auch weiterhin eine Bedrohung, und wir verfolgen sie überall, wo wir sie finden können.‡‡‡‡‡‡',
  }
},
[10327] = {
  {
    'Marca única de Kil\'Jaeden‡Знак Кил\'джедена‡Einzelne Male von Kil\'jaeden‡킬제덴의 징표 하나‡Marca única de Kil\'jaeden‡Marca de Kil\'jaeden única‡Une marque de Kil\'jaeden‡单枚基尔加丹印记‡單一基爾加丹印記',
    nil,
    'Aceitarei quaisquer marcas que ainda trouxeres contigo. Não te preocupes, tuas ações serão devidamente registradas.‡‡Ich nehme Euch alle übrigen Male, die Ihr habt, ab. Keine Sorge, Eure Taten werden nicht unbemerkt bleiben.‡‡Me quedaré con las insignias que te sobran. No te preocupes, tus acciones serán tenidas en cuenta.‡‡S’il vous reste d\'autres insignes, ils m\'intéressent. Ne vous en faites pas, vos actions seront dûment rapportées.‡‡',
  }
},
[10328] = {
  {
    'Instruções Solfúria‡Инструкции Ярости Солнца‡Anweisungen des Sonnenzorns‡성난태양 지령‡Informes Furia del Sol‡Informes Furia del Sol‡Briefing des Solfurie‡日怒简报‡日怒簡報',
    nil,
    'Vá a Manaforja Dúria e consiga as Instruções Militares dos Solfúria e as Instruções Arcanas dos Solfúria das unidades Solfúria posicionadas na manaforja. Fale novamente com o Exarca Orelis quando houver completado a tarefa.nnCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Даро и заберите военные инструкции Ярости Солнца и чародейские инструкции Ярости Солнца. По завершении задачи возвращайтесь к экзарху Орелису.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Duro und beschafft die Truppenbefehle des Sonnenzorns und die Arkanbefehle des Sonnenzorns von den Einheiten des Sonnenzorns, die dort postiert sind. Kehrt zu Exarch Orelis zurück, wenn Ihr Eure Aufgabe erledigt habt.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡듀로 마나괴철로로 가서 성난태양 군대원에게서 성난태양 군사 지령과 성난태양 비전 지령을 회수한 후, 총독 오렐리스에게 가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Duro y consigue el informe militar de Furia del Sol y el informe Arcano de Furia del Sol de las unidades Furia del Sol allí asentadas. Ve a ver al exarca Orellis cuando hayas completado la tarea.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con Los Arúspices.‡Ve a la Forja de Maná Duro y consigue el informe militar de Furia del Sol y el informe Arcano de Furia del Sol de las unidades Furia del Sol allí asentadas. Ve a ver al exarca Orellis cuando hayas completado la tarea.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Allez à la manaforge Duro et procurez-vous le Briefing militaire solfurie et le Briefing des arcanes solfurie auprès des soldats en poste. Retournez voir l\'exarque Orelis une fois cette tâche accomplie.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：杜隆，从日怒军团士兵手中夺得日怒军事简报和日怒奥术简报。完成任务后向大主教欧雷里斯复命。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡前往法力熔爐杜羅並且從駐紮的日怒守軍中取得日怒軍情簡報和日怒機密簡報。當你完成這項任務時，返回主教歐瑞利斯那裡。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10329] = {
  {
    'Desativar Manaforja B\'naar‡Отключить манагорн Б\'наар‡Manaschmiede B\'naar abschalten‡브나르 마나괴철로 차단‡El cierre de la Forja de Maná B\'naar‡El cierre de la Forja de Maná B\'naar‡Extinction de la manaforge B\'naar‡关闭法力熔炉：布纳尔‡關閉法力熔爐巴納爾',
    nil,
    'Volte à Manaforja B\'naar e obtenha o Cristal de Acesso de B\'naar do Feitor Theredis. Use-o no Painel de Controle de B\'naar para desativá-la e, em seguida, apresente-se ao Mestre Espião Thalodien.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Вернитесь в манагорн Б\'наар и заберите кристалл доступа у надзирателя Тередиса. Используйте его на панели управления манагорна Б\'наар, чтобы выключить его, затем сообщите об этом патрону шпионов Талодиену. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Geht zurück zur Manaschmiede B\'naar und besorgt Euch den Zugangskristall von Vorarbeiter Theredis. Benutzt ihn bei der Steuerkonsole von B\'naar um sie abzuschalten und meldet Euch danach bei Spionagemeister Thalodien zurück.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡브나르 마나괴철로로 돌아가서 감독관 테레디스를 처치하고 브나르 장치 접근 수정을 입수한 후, 수정을 사용하여 브나르 제어장치를 차단하고 첩보단장 탈로디엔에게 보고해야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná B\'naar y obtén el cristal de acceso de B\'naar del sobrestante Theredis. Úsalo en la consola de control B\'naar para desactivarla y vuelve a hablar con el maestro de espías Thalodien.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Vuelve a la Forja de Maná B\'naar y obtén el cristal de acceso de B\'naar del sobrestante Theredis. Úsalo en la consola de control B\'naar para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Retournez à la manaforge B\'naar et prenez le Cristal d\'accès de B\'naar au Surveillant Theredis. Utilisez-le à la console de contrôle de la manaforge B\'naar pour l\'éteindre et faites votre rapport au maître-espion Thalodien.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡返回法力熔炉：布纳尔，从工头瑟瑞狄斯手中夺得布纳尔控制水晶。对法力熔炉：布纳尔的控制台使用水晶关闭法力熔炉，然后向间谍大师萨罗迪恩复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡回去法力熔爐巴納爾並從監督者瑞爾迪斯身上取得巴納爾控制水晶。將它用來關閉巴納爾控制臺，完成後回報給間諜大師薩洛迪恩。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10330] = {
  {
    'Desativar Manaforja Coruu‡Отключить манагорн Коруу‡Manaschmiede Coruu abschalten‡코루 마나괴철로 차단‡El cierre de la Forja de Maná Coruu‡El cierre de la Forja de Maná Coruu‡Extinction de la manaforge Coruu‡关闭法力熔炉：库鲁恩‡關閉法力熔爐寇魯',
    nil,
    'Obtenha o Cristal de Acesso de Coruu da Feitora Seylanna. Use-o no Painel de Controle de Coruu para desativá-la e, em seguida, apresente-se a Caledis Albafulgis.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Заберите кристалл доступа Коруу у надзирателя Сейланны. Используйте его на панели управления Коруу, чтобы отключить манагорн, затем вернитесь к Каледису Сияющему Рассвету.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Besorgt den Zugangskristall von Coruu von Vorarbeiterin Seylanna. Benutzt ihn, um die Steuerkonsole der Manaschmiede abzuschalten und meldet Euch dann bei Caledis Morgenhell.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡감독관 세일란나로부터 코루 장치 접근 수정을 획득해야 합니다. 그런 다음 코루 제어장치에 사용해서 마나괴철로를 차단한 후 캘디스 브라이트돈에게 돌아가십시오.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Consigue el cristal de acceso de Coruu del sobrestante Seylanna. Utilízalo en la consola de control Coruu para cerrar la Forja de Maná y ve a hablar con Caledis Alba Brillante.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Consigue el cristal de acceso de Coruu del sobrestante Seylanna. Utilízalo en la consola de control Coruu para cerrar la Forja de Maná y ve a hablar con Caledis Alba Brillante..|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Procurez-vous le Cristal d\'accès de Coruu sur la surveillante Seylanna. Utilisez-le à la console de contrôle de Coruu pour éteindre la manaforge et retournez voir Caledis Brillaube.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès des Aldor.‡从工头希兰娜手中夺得库鲁恩控制水晶。对法力熔炉：库鲁恩的控制台使用水晶关闭法力熔炉，然后向卡勒迪斯·晨光复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡從監督者塞琳娜那裡取得寇魯控制水晶。在寇魯控制臺使用它關閉法力熔爐，完成後回報卡利迪斯·光明。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10331] = {
  {
    'Ferramentas indispensáveis‡Необходимые инструменты‡Unverzichtbare Werkzeuge‡없어서는 안 될 도구‡Herramienta indispensable‡Herramienta indispensable‡Des outils indispensables‡必备的工具‡必需的工具',
    nil,
    'Recupere o Martelo de Ferreiro em meio aos aprendizes de Kirin\'Var e traga-o de volta ao Aprendiz Andrethan, na Vila Kirin\'Var.‡Заберите кузнечный молот у кирин\'варских учеников и отнесите обратно ученику Андретану в деревню Кирин\'Вар.‡Besorgt den Schmiedehammer von den Lehrlingen von Kirin\'Var und bringt ihn zurück zu Lehrling Andrethan in Kirin\'Var.‡키린바르 수습생에게 무거운 대장장이 망치를 되찾은 후 키린바르 마을에 있는 수습생 안드레단에게 돌려주어야 합니다.‡Coge el martillo de herrería que tienen los aprendices de Kirin\'Var y llévaselo al aprendiz Andrethan al Poblado Kirin\'Var.‡Coge el martillo de herrería que tienen los aprendices de Kirin\'Var y llévaselo al aprendiz Andrethan al Poblado Kirin\'Var.‡Reprenez le Marteau de forge aux apprentis de Kirin\'Var et rapportez-le à l\'apprenti Andrethan à Kirin\'Var.‡从肯瑞瓦学徒手中夺回铁匠锤，将它交给肯瑞瓦村的学徒安德雷萨。‡跟肯瑞瓦學徒取回冶煉大錘然後交給肯瑞瓦村莊的學徒安崔森。',
  }
},
[10332] = {
  {
    'Mestre Ferreiro Rhonsus‡Мастер-кузнец Ронсус‡Meisterschmied Rhonsus‡대장기술의 대가 론서스‡El herrero maestro Rhonsus‡El herrero maestro Rhonsus‡Le maître forgeron Rhonsus‡铁匠大师罗恩苏斯‡鐵匠大師朗瑟士',
    nil,
    'O Aprendiz Andrethan, na Vila Kirin\'Var, quer que você mate o fantasma de Rhonsus, o mestre ferreiro da vila.‡Ученик Андретан из деревни Кирин\'Вар просит вас убить призрак Ронсуса, мастера-кузнеца поселения.‡Lehrling Andrethan in Kirin\'Var möchte, dass Ihr den Geist von Rhonsus, dem Meisterschmied des Dorfes, vernichtet.‡키린바르 마을의 수습생 안드레단이 마을의 대장기술의 대가인 론서스의 유령을 처치해 달라고 했습니다.‡El aprendiz Andrethan en el Poblado Kirin\'Var quiere que mates al fantasma de Rhonsus, el herrero maestro del poblado.‡El aprendiz Andrethan en el Poblado Kirin\'Var quiere que mates al fantasma de Rhonsus, el herrero maestro del poblado.‡L\'apprenti Andrethan de Kirin\'Var veut que vous alliez tuer le fantôme de Rhonsus, le maître forgeron de la ville.‡肯瑞瓦村的学徒安德雷萨要你消灭镇上铁匠大师罗恩苏斯的鬼魂。‡在肯瑞瓦村莊的學徒安崔森要你殺了小鎮的鐵匠大師，朗瑟士的鬼魂。',
  }
},
[10333] = {
  {
    'Ajude Mamãe Macário‡Помощь Мамаше Колесун‡Helft Mama Mauschel‡휠러 아줌마 돕기‡Ayuda a Mamá Ruedas‡Ayuda a Mamá Ruedas‡Aider Mama Roulette‡帮助维勒老妈‡協助威勒媽媽',
    nil,
    'Fale com Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Поговорите с Мамашей Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Sprecht mit Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡황천의 폭풍의 중앙 생태지구 내에 중앙 생태지구 주둔지에 있는 휠러 아줌마와 대화해야 합니다.‡Habla con Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media de Tormenta Abisal.‡Habla con Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media de Tormenta Abisal.‡Parlez à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡前往虚空风暴的中央生态圆顶，与中央圆顶哨站的维勒老妈谈一谈。‡到虛空風暴內秘境領地的領地崗哨找威勒媽媽談談。',
  }
},
[10334] = {
  {
    'Mais sinetas‡Колокольчик для коровы‡Etwas mehr Klang bitte‡베시의 종‡Necesita un cencerro‡Necesita un cencerro‡Plus de clochettes‡贝希的铃铛‡需要更多的鈴鐺',
    nil,
    'Encontre Mocha nos campos próximos do Morro da Capela na Vila Kirin\'Var, que fica em Eternévoa.‡Найдите Бесси в полях близ Часовенного холма деревни Кирин\'Вар.‡Sucht Bessy in den Feldern nordöstlich vom Kapellenhügel von Kirin\'Var.‡키린바르 마을의 예배당 지구 근처에 있는 들판에서 베시를 찾아야 합니다.‡Encuentra a Bessy en los campos cerca de la Colina de la Capilla, en el Poblado Kirin\'Var.‡‡Trouver Marguerite dans les champs près de la colline de la chapelle de Kirin\'Var.‡在肯瑞瓦村礼拜堂小丘附近的农田中找到贝希。‡在肯瑞瓦村莊的禮拜堂山丘附近找到貝絲。',
  }
},
[10335] = {
  {
    'Inspecionar as ruínas‡Исследование руин‡Die Ruinen beobachten‡폐허 측량 작업‡Inspeccionar las ruinas‡Inspeccionar las ruinas‡Cartographier les ruines‡调查废墟‡調察這些廢墟',
    nil,
    'Posicione os três Marcadores de Sondagem e fale novamente com Zefírio, no Pináculo da Tempestade, em Eternévoa.‡Разместите три геодезических знака, затем возвращайтесь к Зефириону в Штормовую Вершину в Пустоверти.‡Platziert die drei Vermessungsmarkierungen und kehrt dann zu Zephirion in der Sturmsäule im Nethersturm zurück.‡측량 지점 표지 3개를 설치한 후에 황천의 폭풍에 있는 폭풍 첨탑에 있는 제피리온에게 돌아가야 합니다.‡Coloca los tres marcadores de reconocimiento y vuelve a ver a Zephyrion en La Flecha de la Tormenta, en la Tormenta Abisal.‡Coloca los tres marcadores de reconocimiento y vuelve a ver a Zephyrion en La Flecha de la Tormenta, en la Tormenta Abisal.‡Placez les trois Repères de géomètre puis revenez voir Zéphyrion à la Foudreflèche au Raz-de-Néant.‡放置好三枚测量标记，然后返回虚空风暴的风暴尖塔里，向塞菲里恩复命。‡放置3面勘察標誌，然後回到虛空風暴的風暴之尖找塞菲爾恩。',
  }
},
[10336] = {
  {
    'Os lacaios de Culuthas‡Приспешники Кулутаса‡Diener von Culuthas‡쿨루타스의 부하들‡Los esbirros de Culuthas‡Los esbirros de Culuthas‡Les serviteurs de Culuthas‡库鲁萨斯的爪牙‡卡露薩斯的爪牙',
    nil,
    'Mate 10 Cães de Culuthas e 5 Olhos de Culuthas.‡Убейте 10 псов Кулутаса и 5 злобоглазов Кулутаса. Затем вернитесь к ловчему Пустоты Наутису, находящемуся в Штормовой Вершине в Пустоверти.‡Tötet 10 Hunde von Culuthas und 5 Augen von Culuthas. Kehrt danach zu Netherpirscher Nauthis in der Sturmsäule im Nethersturm zurück.‡쿨루타스의 사냥개 10마리와 쿨루타스의 눈 5마리를 처치한 후, 황천의 폭풍에 있는 폭풍 첨탑 내의 황천의 추적자 나우디스에게 돌아가야 합니다.‡Mata 10 canes de Culuthas y 5 ojos de Culuthas. Después ve a ver al acechador abisal Nauthis en La Flecha de la Tormenta, en la Tormenta Abisal.‡Mata a 10 canes de Culuthas y a 5 ojos de Culuthas.‡Tuez 10 Molosses de Culuthas et 5 Yeux de Culuthas, puis retournez voir le Traqueur-du-Néant Nauthis à la Foudreflèche au Raz-de-Néant.‡杀死10只库鲁萨斯的猎犬和5只库鲁萨斯之眼。然后返回虚空风暴的风暴尖塔，向虚空猎手纳乌希思复命。‡殺死10隻卡露薩斯之犬和5隻卡露薩斯之眼。完成後返回虛空風暴的風暴之尖找虛空行者那魯利斯。',
  }
},
[10337] = {
  {
    'Quando as vacas voltam para o lar‡Когда коровы возвращаются домой‡Almabtrieb‡집으로 돌아온 소‡Cuando las vacas vuelven a casa‡Cuando las vacas vuelven a casa‡Marguerite rentre au pays‡奶牛回家‡母牛返家',
    nil,
    'Escolte a Mocha sã e salva de volta a seu proprietário, Thadell.‡Благополучно сопроводите Бесси к ее владельцу, Таделлу.‡Begleitet Bessy sicher zu ihrem Besitzer Thadell zurück.‡베시가 주인인 타델에게 무사히 돌아갈 수 있도록 호위해야 합니다.‡Escolta a Bessy de vuelta con su dueño, Thadell.‡Escolta a Bessy de vuelta con su dueño, Thadell.‡Escortez Marguerite pour la ramener saine et sauve à son propriétaire, Thadell.‡护送贝希安全返回她的主人萨德尔那里。‡護送貝絲安全地回到她的主人，薩戴爾身邊。',
  }
},
[10338] = {
  {
    'Desativar a Manaforja Dúria‡Отключить манагорн Даро‡Manaschmiede Duro abschalten‡듀로 마나괴철로 차단‡El cierre de la Forja de Maná Duro‡El cierre de la Forja de Maná Duro‡Extinction de la manaforge Duro‡关闭法力熔炉：杜隆‡關閉法力熔爐杜羅',
    nil,
    'Volte à Manaforja Dúria e obtenha o Cristal de Acesso de Dúria do Feitor Athanel. Use-o no Painel de Controle de Dúria para desativá-la e, em seguida, apresente-se ao Mestre Espião Thalodien.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Вернитесь в манагорн Даро и заберите кристалл доступа у надзирателя Атанеля. Используйте его на панели управления манагорна Даро, чтобы отключить его, затем сообщите об этом патрону шпионов Талодиену. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Kehrt zur Manaschmiede Duro zurück und besorgt Euch den Zugangskristall von Vorarbeiter Athanel. Benutzt ihn, um die Steuerkonsole von Duro abzuschalten, und meldet Euch danach bei Spionagemeister Thalodien.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡듀로 마나괴철로로 돌아가서 감독관 아사넬을 처치하고 듀로 장치 접근 수정을 입수한 후, 수정을 사용하여 듀로 제어장치를 차단하고 첩보단장 탈로디엔에게 돌아가서 보고해야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná Duro y obtén el cristal de acceso de Duro del sobrestante Athanel. Úsalo en la consola de control de Duro para desactivarla y vuelve a hablar con el maestro de espías Thalodien.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Vuelve a la Forja de Maná Duro y obtén el cristal de acceso de Duro del sobrestante Athanel. Úsalo en la consola de control de Duro para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Retournez à la manaforge Duro et prenez le Cristal d\'accès de Duro au surveillant Athanel. Utilisez-le à la console de contrôle de Duro pour l\'éteindre et allez faire votre rapport au maître-espion Thalodien.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡返回法力熔炉：杜隆，从工头安萨奈尔手中夺得杜隆控制水晶。对法力熔炉：杜隆的控制台使用水晶关闭法力熔炉，然后向间谍大师萨罗迪恩复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡回到法力熔爐杜羅從監督者阿森尼爾手中取得杜羅控制水晶。在杜洛控制臺使用控制水晶關閉該裝置然後向間諜大師薩洛迪恩回報。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10339] = {
  {
    'O Etéreum‡Братство Эфириум‡Das Astraleum‡에테리움‡Los etereum‡El Etereum‡L\'Ethereum‡复仇军‡伊斯利恩',
    nil,
    'O Comandante Ameer quer que você mate 5 Assassinos Etéreum, 5 Tropas de Choque Etéreum, 2 Pesquisadores Etéreum e o Capitão Zovax e, após, quer que ative o rádio-sinalizador Zeta do Etéreum.‡Командир Амир просит вас уничтожить 5 убийц из Эфириума, 5 штормовиков из Эфириума, 2 ученых Эфириума и капитана Зовакса из Эфириума, затем включить передатчик Эфириума Зета.‡Kommandant Ameer möchte, dass Ihr 5 Auftragsmörder des Astraleums, 5 Stoßtruppsoldaten des Astraleums, 2 Forscher des Astraleums und Hauptmann Zovax tötet und dann den Transponder des Astraleums Zeta aktiviert.‡사령관 야미르가 에테리움 암살자 5명, 에테리움 돌격병 5명, 에테리움 연구원 2명, 대장 조박스를 처치한 다음 에테리움 송수신기 제타를 작동시켜 달라고 했습니다.‡El comandante Ameer quiere que mates a 5 asesinos de etereum, 5 soldados de choque de etereum, 2 investigadores de etereum y al capitán Zovax y que, a continuación, actives el transpondedor de etereum zeta.‡El comandante Ameer quiere que mates a 5 asesinos de El Etereum, 5 soldados de choque de El Etereum, 2 investigadores de El Etereum y al capitán Zovax y que, a continuación, actives el transpondedor de El Etereum Zeta.‡Le commandant Ameer veut que vous tuiez 5 Assassins de l\'Ethereum, 5 Troupiers de choc de l\'Ethereum, 2 Chercheurs de l\'Ethereum et le capitaine Zovax puis que vous activiez le Transpondeur zéta de l\'Ethereum.‡指挥官阿米尔要你杀死5名复仇军刺客、5名复仇军突击队员、2名复仇军研究员和索瓦克斯上尉，然后启动复仇军发射器 - 塞塔。‡指揮官阿密爾要你殺死5個伊斯利恩刺客、5個伊斯利恩突擊兵、2個伊斯利恩調查者還有索瓦斯上尉然後啟動伊斯利恩傳送器Ⅵ。',
  }
},
[10340] = {
  {
    'Posto Despedaçado‡Парящая застава‡Trümmerposten‡징검다리 거점‡Puesto Devastación‡Puesto Devastación‡La halte du Fracas‡破碎岗哨‡破碎崗哨',
    nil,
    'O Comandante Avançado Kingston quer que você fale com o Comandante de Ala Dabir\'ee, cavalgue um grifo até o Posto Despedaçado e então se apresente a Runatogo Martelo Feroz.‡По приказу командира передовой Кингстона поговорите с командиром звена Даби\'ри, доберитесь на грифоне до Парящей заставы и поговорите с Рунтогом Громовым Молотом.‡Vorpostenkommandant Wa\'ppun möchte, dass Ihr mit Schwadronskommandant Dabir\'ee sprecht, auf einem Greifen zum Trümmerposten fliegt und Euch bei Runetog Wildhammer meldet.‡전방사령관 킹스톤이 편대사령관 다비리와 대화한 후에, 그리핀을 타고 징검다리 거점에 도착한 다음 룬토그 와일드해머에게 보고해 달라고 부탁했습니다.‡El comandante de vanguardia Kingston quiere que hables con el comandante del aire Dabir\'ee, vayas en grifo a Puesto Devastación y te presentes ante Runetog Martillo Salvaje.‡El comandante de vanguardia Kingston quiere que hables con el comandante del aire Dabir\'ee, vayas en grifo a Puesto Devastación y te presentes ante Runetog Martillo Salvaje.‡Le commandant des lignes avancées Kingston veut que vous parliez au chef d\'escadrille Dabir\'ee, que vous preniez un griffon pour la halte du Fracas et que vous vous présentiez à Runetog Marteau-Hardi.‡前线指挥官金斯顿要求你与空军指挥官达比利交谈，搭乘狮鹫前往破碎岗哨，并向鲁恩托格·蛮锤报告。‡前線指揮官金斯頓要你去找空軍指揮戴畢瑞談談，騎乘獅鷲獸到破碎崗哨，然後找符文衣·蠻錘報到。',
  }
},
[10341] = {
  {
    'Acabe com eles enquanto estão no chão‡Лежачего не бьют – лежачего пинают‡Tretet sie, solange sie am Boden liegen‡확인 사살‡A por ellos cuando no se pueden defender‡A por ellos cuando no se pueden defender‡Cognez-les maintenant qu\'ils sont à terre‡乘胜追击‡趁他人之危',
    nil,
    'Mate 8 Conjuradores Solfúria, 6 Arqueiros Solfúria e 4 Centuriões Solfúria. Fale novamente com a Magistra Larynna, na Área 52, após concluir a tarefa.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Убейте 8 кудесников, 6 лучников и 4 центурионов клана Ярости Солнца. После завершения задачи вернитесь к магистру Ларинне, находящейся в Зоне 52.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Tötet 8 Beschwörer des Sonnenzorns, 6 Jadgschützen des Sonnenzorns und 4 Zenturios des Sonnenzorns. Kehrt zu Magistrix Larynna in Area 52 zurück, wenn Ihr die Aufgabe erledigt habt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 창조술사 8명, 성난태양 궁병 6명, 성난태양 백인대장 4명을 처치해야 합니다. 이 임무를 완수한 후에 52번 구역에 있는 마법학자 라린나에게 돌아가십시오.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Mata 8 conjuradores Furia del Sol, 6 ballesteros Furia del Sol y 4 centuriones Furia del Sol. Vuelve a ver a la magistrix Larynna en el Área 52 cuando hayas completado la tarea.nnCompletar tareas para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Mata 8 conjuradores Furia del Sol, 6 asaeteadores Furia del Sol y 4 centuriones Furia del Sol. Vuelve a ver a la magistrix Larynna en el Área 52 cuando hayas completado la tarea.|n|nCompletar tareas para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Tuez 8 Adjurateurs solfurie, 6 Franc-archers solfurie et 4 Centurions solfurie. Retournez voir la magistrice Larynna dans la Zone 52 lorsque vous aurez achevé cette tâche.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡杀死8名日怒咒术师、6名日怒弓箭手和4名日怒百夫长。完成任务后返回52区向魔导师拉恩娜复命。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡殺掉8個日怒咒術師，6個日怒射手以及4個日怒百夫長。完成任務後回到52區找博學者萊莉娜。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10342] = {
  {
    'Consiga o xisto dos xistocouro‡Добыча кожи глиношкурых‡Schieferhautschiefer‡혈암가죽 파편‡Asegurar los esquistos Piel de esquisto‡Asegurar los esquistos Piel de esquisto‡Dégoter de la lauze de peau-de-schiste‡收集岩肤油块‡獲得岩層泥岩',
    nil,
    'Colete cinco Xistos de Xistocouro e leve-os ao Botas, na Área 52, em Eternévoa.‡Соберите 5 кусков кожи глиношкурых и отдайте Бутсу в Зоне 52 в Пустоверти.‡Sammelt 5 Stück Schieferhautschiefer und bringt sie zu Stiefels in Area 52 im Nethersturm.‡혈암가죽 파편 5개를 수집한 후 황천의 폭풍의 52번 구역에 있는 부츠에게 가져가야 합니다.‡Recolecta 5 esquistos Piel de esquisto y llévaselos a Botas del Área 52, en la Tormenta Abisal.‡Recolecta 5 esquistos Piel de esquisto y llévaselos a Botas del Área 52, en la Tormenta Abisal.‡Collectez 5 Lauzes de peau-de-schiste et apportez-les à Bottes dans la Zone 52 au Raz-de-Néant.‡收集5块岩肤油块，将它们交给虚空风暴52区的布兹。‡收集5個岩層泥岩並將這些交給虛空風暴上52區的布茲。',
  }
},
[10343] = {
  {
    'Invasão infindável‡Бесконечное вторжение‡Die unendliche Invasion‡끝없는 침략‡La invasión interminable‡La invasión interminable‡L\'invasion sans fin‡无尽的入侵‡無止盡的侵略',
    nil,
    'Encontre, na área infestada de criaturas de mana da Vila Kirin\'Var, um Fragmento de Bomba de Mana e traga-o ao Tenente-Feiticeiro Morran.‡Обыщите кишащий мана-тварями район деревни Кирин\'Вар в поисках фрагмента мана-бомбы и принесите его лейтенант-колдуну Моррану.‡Sucht die von Manakreaturen heimgesuchte Gegend in Kirin\'Var nach einem Manabombenfragment ab und bringt sie zu Zauberhexerleutnant Morran.‡키린바르 마을에 들끓고 있는 마나 생물에서 마나 폭탄 파편을 찾은 후 마술사 부관 모란에게 가져가야 합니다.‡Busca en la zona del Poblado Kirin\'Var infestada de criaturas de maná un trozo de bomba de maná y llévasela al teniente hechicero Morran.‡Busca en la zona del Poblado Kirin\'Var infestada de criaturas de maná un trozo de bomba de maná y llévasela al teniente hechicero Morran.‡Fouillez la zone de Kirin\'Var infestée de créatures de mana à la recherche d\'un Fragment de bombe de mana et apportez-le au lieutenant-ensorceleur Morran.‡在肯瑞瓦村中法力生物肆虐的地区收集一块魔法炸弹碎片，将它交给巫师上尉莫尔兰。‡搜尋肯瑞瓦村莊大批法力生物出沒的地方找到法力炸彈碎片，並且把它交給莫爾蘭巫士中尉。',
  }
},
[10344] = {
  {
    'Comandante de Ala Grifongar‡Командир звена Грифонгар‡Schwadronskommandant Greifgar‡편대사령관 그리폰가르‡Comandante del aire Gryphongar‡Comandante del aire Grifongar‡Le chef d\'escadrille Griffongar‡空军指挥官格莱芬加尔‡空軍指揮葛萊弗卡爾',
    nil,
    'Fale com o Comandante de Ala Grifongar no Posto Despedaçado.‡Поговорите с командиром звена Грифонгаром на Парящей заставе.‡Sprecht mit Schwadronskommandant Greifgar im Trümmerposten.‡징검다리 거점에 있는 편대사령관 그리폰가르와 대화해야 합니다.‡Habla con el comandante del aire Gryphongar en el Puesto Devastación.‡Habla con el comandante del aire Grifongar en el Puesto Devastación.‡Parlez au Chef d\'escadrille Griffongar à la Halte du Fracas.‡与破碎岗哨的空军指挥官格莱芬加尔谈一谈。‡與破碎崗哨的空軍指揮葛萊弗卡爾談談。',
  }
},
[10345] = {
  {
    'A carne é forte...‡Усеял мертвыми костями...‡Fleisch geworden‡누워 있는 시체들‡La carne sí engaña‡La carne sí engaña‡La chair ment...‡血肉会撒谎......‡地上的屍體……',
    nil,
    'Use o incendiador do Protetorado em 12 cadáveres dessecados. Retorne o incendiador do Protetorado ao Agente Araxes, do lado de fora do poço de acesso Zeon, quando a tarefa for concluída.‡Примените поджигатель Протектората к 12 высохшим трупам. Когда задача будет завершена, верните поджигатель Протектората посланнику Араксису, находящемуся у входа в шахту Зеон.‡Benutzt den Anzünder des Protektorats um 12 siechende Leichen zu zerstören. Bringt den Anzünder des Protektorats zu Agent Araxes außerhalb des Zugangsschachts Zeon zurück, wenn Ihr erfolgreich wart.‡말라 비틀어진 시체 12구에 자유연합 점화장치를 사용한 후, 지온 작업 갱도 바깥에 있는 요원 아락세스에게 돌아가야 합니다.‡Usa el encendedor del Protectorado en 12 cadáveres marchitos y devuélveselo al agente Araxes fuera del Eje de Acceso Zeon cuando hayas acabado.|n‡Usa el encendedor del Protectorado en 12 cadáveres marchitos y devuélveselo al agente Araxes fuera del Eje de Acceso Zeon cuando hayas acabado.|n‡Utilisez le Boute-feu du Protectorat sur 12 Cadavres flétris. Lorsque vous aurez fini, rendez le Boute-feu du Protectorat à l\'agent Araxes à l\'extérieur du Puits d\'accès Zéon.‡对12具干枯的尸体使用维序派点火器。完成任务后将维序派点火器还给瑟安竖井外的代理人阿拉克塞。‡對12具腐敗的屍體使用護國者的點火器。在你的任務完成之後，將護國者的點火器還給在礦井之路通道外面的密探阿雷克斯。',
  }
},
[10346] = {
  {
    'Retorno à Prateleira Abissal‡Возвращение на Косогор Бездны‡Rückkehr zur abyssischen Untiefe‡심연의 절벽으로 돌아가기‡Regreso a La Plataforma Abisal‡Regresa a La Plataforma Abisal‡Retour à la saillie abyssale‡返回地狱岩床‡回到深淵沙洲',
    nil,
    'A Grifoneira Urravento do Posto Despedaçado, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по просьбе грифоньера Ветрорева с Парящей заставы на полуострове Адского Пламени.‡Greifnerin Heulwind im Trümmerposten auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen zerstört.‡지옥불 반도의 징검다리 거점에 있는 그리핀 관리인 윈드벨로우가 간아그 일꾼 20마리, 모아그 감독관 5마리, 지옥 대포 5개를 파괴해 달라고 부탁했습니다.‡La grifonera Bramavientos, en el Puesto Devastación, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡La grifonera Bramavientos, en el Puesto Devastación, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le griffonnier Soufflevent de la halte du Fracas dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛破碎岗哨的狮鹫骑士维比洛要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡在地獄火半島破碎崗哨的獅鷲專家風怒要你殺死20個甘納格苦工、5個莫阿格監督者還有5座惡魔火砲。',
  }
},
[10347] = {
  {
    'Retorno à Prateleira Abissal‡Возвращение на Косогор Бездны‡Rückkehr zur abyssischen Untiefe‡심연의 절벽으로 돌아가기‡Regreso a La Plataforma Abisal‡Regresa a La Plataforma Abisal‡Retour à la saillie abyssale‡返回地狱岩床‡回到深淵沙洲',
    nil,
    'O Comandante de Ala Brack, no Posto dos Destroços, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по просьбе командира звена Бракка из Гибели Сквернобота на полуострове Адского Пламени.‡Schwadronskommandant Brack im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen zerstört.‡지옥불 반도의 지옥절단기 함락지에 있는 편대사령관 브락크가 간아그 일꾼 20명과 모아그 감독관 5명을 처치하고 지옥 대포 5대를 파괴하라는 임무를 맡겼습니다.‡El comandante del aire Brack, en la Caída del Atracador Vil, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante del aire Brack, en la Caída del Atracador Vil, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le chef d\'escadrille Brack du Trépas du saccageur dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛机甲残骸的空军指挥官布拉克要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上搶奪者荒野的空軍指揮布拉克要你消滅20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10348] = {
  {
    'Novas oportunidades‡Новые возможности‡Neue Möglichkeiten‡새로운 기회‡Nuevas oportunidades‡Nuevas oportunidades‡De nouvelles opportunités‡新的机遇‡新的機會',
    nil,
    'Colete 15 Sinos de Marfim e fale novamente com Muhrdad, no Posto Terramédia.‡Соберите 15 "кремовых колокольчиков" и вернитесь к Мердаду на Заставу срединных земель.‡Sammelt 15 Elfenbeinglocken und kehrt dann zu Mehrdad im Mittelreichposten zurück.‡상아 종꽃 15개를 수집한 후 중앙 생태지구 주둔지에 있는 메르다드에게 돌아가야 합니다.‡Recupera 15 campanas de marfil y regresa junto a Mehrdad en el Puesto de la Tierra Media.‡Recupera 15 campanas de marfil y regresa junto a Mehrdad en el Puesto de la Tierra Media.‡Cueillez 15 Clochettes d\'ivoire et retournez voir Mihrdad au comptoir des Terres-médianes.‡收集15株象牙铃笼草，然后向中央圆顶哨站的玛尔达德复命。‡採集15朵象牙鈴，完成後回到領地崗哨找瑪戴德。',
  }
},
[10349] = {
  {
    'A Ataterra‡Землепряд‡Die Erdbinderin‡대지의 결속자‡La Vinculadora terrestre‡La Vinculadora terrestre‡La lieuse de terre‡缚地者‡大地束縛者',
    nil,
    'Leve o Estilhaço de Cristal Carmesim para a Ataterra Galandria Umbrísia no Posto Cenariano, que fica na Península Fogo do Inferno.‡Отнесите осколок алого хрусталя заклинательнице земли Галандрии Ночной Бриз на Кенарийскую заставу на полуострове Адского Пламени.‡Bringt den Purpurkristallsplitter zu Erdbinderin Galandria Nachtluft im Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 대지의 결속자 갈란드리아 나이트브리즈에게 진홍색 수정 조각을 가져가야 합니다.‡Lleva el fragmento de cristal carmesí a la Vinculadora terrestre Galandria Brisa Nocturna en el Puesto Cenarion en la Península del Fuego Infernal.‡Lleva el fragmento de cristal carmesí a la Vinculadora terrestre Galandria Brisa Nocturna en el Puesto Cenarion en la Península del Fuego Infernal.‡Apportez l\'Éclat de cristal cramoisi à la lieuse de terre Galandria Noctebrise au Poste cénarien dans la péninsule des Flammes infernales.‡将火红水晶碎片交给地狱火半岛塞纳里奥哨站的缚地者加兰蒂娅·夜风。‡將赤紅水晶裂片拿去地獄火半島的塞納里奧前哨交給大地束縛者卡拉崔亞·夜風。',
  }
},
[10350] = {
  {
    'Behomat‡Бехомат‡Behomat‡베호마트‡Maestro Behomat‡Maestro Behomat‡Behomat‡贝霍玛特‡畢和瑪特',
    nil,
    'Fale com Behomat no Setor Comercial, na Exodar.‡Поговорите с Бехоматом в Торговом ряду Экзодара.‡Sprecht mit Behomat bei der Händlertreppe in der Exodar.‡엑소다르의 교역 지구에 있는 베호마트와 대화해야 합니다.‡Habla con Behomat en La Grada de los Mercaderes de El Exodar.‡Habla con Behomat en La Grada de los Mercaderes de El Exodar.‡Allez parler à Behomat, à l’Étage des commerces de l’Exodar.‡与埃索达贸易阶梯的贝霍玛特谈一谈。‡與艾克索達貿易區的畢和瑪特談談。',
  }
},
[10351] = {
  {
    'Remédios naturais‡Целительная сила природы‡Natürliche Heilmittel‡자연 요법‡Remedios naturales‡Remedios naturales‡Remèdes naturels‡自然的治愈‡自然治療法',
    nil,
    'Use a Semente da Revitalização no Círculo da Ataterra para curar a terra em redor do cristal. Então, fale novamente com a Ataterra Galandria Umbrísia, no Posto Cenariano, que fica na Península Fogo do Inferno, e lhe informe o que descobrir.‡Посадите Семя Возрождения в Круге землепряда, чтобы исцелить землю вокруг кристалла. После этого возвращайтесь к землепряду Галандрии Ночной Бриз на Кенарийскую заставу и расскажите о том, что получилось.‡Benutzt den Samen der Wiederbelebung beim Zirkel des Erdbinders, um das Land um den Kristall herum zu heilen. Kehrt dann zu Erdbinderin Galandria Nachtluft im Posten des Cenarius auf der Höllenfeuerhalbinsel mit Euren Beobachtungen zurück.‡대지의 결속자의 마법진에 회복의 씨앗을 사용하여 수정 주변에 있는 땅을 치료한 후 입수한 정보를 가지고 지옥불 반도의 세나리온 초소에 있는 대지의 결속자 갈란드리아 나이트브리즈에게 돌아가야 합니다.‡Usa la semilla de revitalización en el Círculo de los Vinculadores terrestres para sanar la tierra alrededor del cristal. Después ve a informar a la Vinculadora terrestre Galandria Brisa Nocturna al Puesto Cenarion en la Península del Fuego Infernal.‡Usa la semilla de revitalización en el Círculo de los Vinculadores terrestres para sanar la tierra alrededor del cristal. Después ve a informar a la Vinculadora terrestre Galandria Brisa Nocturna al Puesto Cenarion en la Península del Fuego Infernal.‡Utilisez la Graine de revitalisation au Cercle de la lieuse de terre pour guérir la terre autour du cristal. Ensuite, retournez voir la lieuse de terre Galandria Noctebrise au Poste cénarien dans la péninsule des Flammes infernales avec toutes les informations que vous aurez.‡在缚地者法阵中使用新生之种，治愈水晶周围的土地。然后返回地狱火半岛的塞纳里奥哨站，向缚地者加兰蒂娅·夜风汇报情况。‡在大地束縛者之環使用新生之種去治癒水晶周遭的土地。然後，帶著任何你所獲得的情報返回地獄火半島的塞納里奧前哨找大地束縛者卡拉崔亞·夜風。',
  }
},
[10352] = {
  {
    'Uma doação de lã‡Пожертвование: шерсть‡Spendet Wolle‡양모 옷감 기부‡Un donativo de lana‡Un donativo de lana‡Un don de laine‡捐献毛料‡捐獻毛料',
    nil,
    '‡Мы сейчас собираем пожертвования в виде шерстяной ткани. За щедрый дар вы получите признательность Дарнасса. Наши запасы таковы, что нам нужно от вас всего лишь шестьдесят отрезов. Мы могли бы купить их и на стороне, чтобы продолжить работу.nnНо если вы имеете шестьдесят отрезов шерстяной ткани и готовы пожертвовать их в дар, я с готовностью приму их у вас прямо сейчас.‡Wir nehmen zurzeit Spenden für Wolle entgegen. Spendet Ihr 60 Stücke, so wird Euch diese großzügige Tat die volle Anerkennung von Darnassus einbringen. Unsere Vorräte würden lediglich 60 Stücke Wollstoff von Euch benötigen; mit der Unterstützung anderer sollten wir unsere Sammelaktion dann erfolgreich vervollständigen können.nnWenn Ihr die 60 Stücke Wollstoff bei Euch habt und zu deren Spende bereit seid, dann kann ich sie jetzt entgegennehmen.‡‡‡‡‡‡',
  }
},
[10353] = {
  {
    'Arconus, o Insaciável‡Арконус Ненасытный‡Arconus der Unersättliche‡탐욕의 아르코누스‡Arconus el Insaciable‡Arconus el Insaciable‡Arconus l\'Insatiable‡贪婪者阿克努斯‡貪求無厭的阿肯納斯',
    nil,
    'O Agente Yasseis, no Poço de Acesso Zeon, em Eternévoa, quer que você mate Arconus, o Insaciável, e que se apresente ao Comandante Ameer, no Posto de Guarda do Protetorado.‡Посланник Иасикс, находящийся у входа в шахту Зеон, просит вас убить Арконуса Ненасытного и вернуться к командиру Амиру на заставу стражи Протектората в Пустоверти.‡Agent Sechs-Uhr beim Zugangsschacht Zeon im Nethersturm möchte, dass Ihr Arconus den Unersättlichen tötet und dann zu Kommandant Ameer im Wachposten des Protektorats im Nethersturm zurückkehrt.‡황천의 폭풍의 지온 작업 갱도에 있는 요원 야식스가 탐욕의 아르코누스를 처치한 후 황천의 폭풍의 자유연합 경비초소에 있는 사령관 야미르에게 돌아가 달라고 부탁했습니다.‡El agente Ya-six en el Eje de Acceso Zeon, en la Tormenta Abisal, te ha pedido que mates a Arconus el Insaciable y vayas a ver al comandante Ameer en la Avanzada del Protectorado, en la Tormenta Abisal.‡El agente Ya-six en el Eje de Acceso Zeon, en la Tormenta Abisal, te ha pedido que mates a Arconus el Insaciable y vayas a ver al comandante Ameer en la Avanzada del Protectorado, en la Tormenta Abisal.‡L\'agent Ya-six du puits d\'accès Zéon du Raz-de-Néant vous a demandé de tuer Arconus l\'Insatiable puis de retourner voir le commandant Ameer au Poste de garde du Protectorat au Raz-de-Néant.‡虚空风暴瑟安竖井的代理人亚希克斯要你杀死贪婪者阿克努斯，然后向虚空风暴维序派哨站的指挥官阿米尔复命。‡位於虛空風暴上礦井之路通道的密探亞希克斯要你殺掉貪求無厭的阿肯納斯，完成後回到虛空風暴的護國者哨站找指揮官阿密爾。',
  }
},
[10354] = {
  {
    'Uma doação de seda‡Пожертвование: шелк‡Spendet Seide‡비단 옷감 기부‡Un donativo de seda‡Un donativo de seda‡Un don de soie‡捐献丝绸‡捐獻絲綢',
    nil,
    '‡Наши запасы тканей подходят к концу, и особенно нам не хватает шелка. Остается надеяться только на щедрость горожан и заезжих героев.nnЕсли ты можешь пожертвовать шестьдесят отрезов шелка, я с благодарностью приму твой дар прямо сейчас. И помни: добрые дела приносят добрую славу!‡Unsere Vorräte an Seide sind, wie fast alle anderen Stoffe auch, so knapp wie nie zuvor. Unterstützen uns noch andere, so bräuchten wir derzeit eine Spende von nicht mehr als 60 Stücken Seide von Euch, um unser Ziel umsetzen zu können.nnEine wohlwollende Gabe, sagen wir Seide, könnte Euren hiesigen Ruf in der Gemeinschaft mit Sicherheit verbessern! Wenn Ihr die 60 Stücke Seide bei Euch habt und zu deren Spende bereit seid, dann kann ich sie jetzt entgegennehmen.‡‡‡‡‡‡',
  }
},
[10355] = {
  {
    'Carne definhada‡Иссохшее тело‡Siechendes Fleisch‡말라버린 생물들‡Carne marchita‡Carne marchita‡Chair flétrie‡枯萎的血肉‡枯萎的肉體',
    nil,
    'Colete 5 Amostras de Hidra Fenecida e 5 Amostras Definhadas de Senhor do Brejo e leve-as para Ruam, em Telredor.‡Соберите 5 образцов опаленной гидры и 5 образцов ткани высохшего болотника и принесите их Руаму в Телредор.‡Sammelt 5 Proben einer verdurstenden Hydra und 5 Proben eines siechenden Sumpflords und bringt sie zu Ruam in Telredor.‡바짝 마른 히드라 견본 5개와 말라 비틀어진 수렁군주 견본 5개를 수집한 후 텔레도르에 있는 루암에게 가져가야 합니다.‡Recolecta 5 muestras de hidra sedienta y 5 muestras de señor de la marisma marchito y llévaselas a Ruam a Telredor.‡Recolecta 5 muestras de hidra sedienta y 5 muestras de señor de la marisma marchito y llévaselas a Ruam a Telredor.‡Réunissez 5 Échantillons d\'hydre desséchée et 5 Échantillons de seigneur-tourbe flétri et apportez-les à Ruam à Telredor.‡将5份干燥的多头蛇样本和5份枯萎的沼泽领主样本交给泰雷多尔的鲁埃姆。‡收集5個乾乾枯的多頭蛇樣本和5個枯萎的泥沼領主樣本，並且將它們帶回泰倫多爾交給洛安瑪。',
  }
},
[10356] = {
  {
    'Uma doação de magitrama‡Пожертвование: магическая ткань‡Spendet Magiestoff‡마법 옷감 기부‡Un donativo de tejido mágico‡Un donativo de tejido mágico‡Un don de tisse-mage‡捐献魔纹布‡捐獻魔紋布',
    nil,
    '‡Мы занимаемся сбором магической ткани. Если ты пожертвуешь нам на благие цели 60 отрезов, то заслужишь признательность всего народа.nnЕсли у тебя есть 60 отрезов, можешь сдать их нам прямо сейчас.‡‡‡‡‡‡‡',
  }
},
[10357] = {
  {
    'Uma doação de runatrama‡Пожертвование: руническая ткань‡Spendet Runenstoff‡룬무늬 옷감 기부‡Un donativo de paño rúnico‡Un donativo de paño rúnico‡Un don d\'étoffe runique‡捐献符文布‡捐獻符文布',
    nil,
    '‡Мы занимаемся сбором рунической ткани. Если ты пожертвуешь на благие цели 60 отрезов, то заслужишь признательность всего нашего народа.nnЕсли у тебя есть 60 отрезов, можешь пожертвовать их прямо сейчас.‡‡‡‡‡‡‡',
  }
},
[10358] = {
  {
    'Runatrama extra‡Больше рунической ткани‡Noch mehr Runenstoff‡룬무늬 옷감 추가 기부‡Paño rúnico adicional‡Un donativo extra de paño rúnico‡Encore de l\'étoffe runique‡更多的符文布‡更多的符文布',
    nil,
    '‡И снова здравствуй, Эльфвоинша. Если ты готова выделить нам еще двадцать отрезов рунической ткани, то, будь уверена я постараюсь, чтобы все узнали о твоей щедрости. Если у тебя есть 20 отрезов рунической ткани, я охотно ее приму.‡‡‡‡‡‡‡',
  }
},
[10359] = {
  {
    'Uma doação de lã‡Пожертвование: шерсть‡Spendet Wolle‡양모 옷감 기부‡Un donativo de lana‡Un donativo de lana‡Un don de laine‡捐献毛料‡捐獻毛料',
    nil,
    '‡Принеси 60 отрезов шерстяной ткани. Жители Луносвета будут тебе очень благодарны!nnЕсли необходимое количество ткани у тебя при себе, я с удовольствием приму дар сейчас.‡Wir nehmen zurzeit Spenden für Wolle entgegen. Spendet Ihr 60 Stücke, so wird Euch diese großzügige Tat die volle Anerkennung von Silbermond einbringen.nnWenn Ihr die 60 Stücke Wollstoff bei Euch habt und zu deren Spende bereit seid, dann kann ich sie jetzt entgegennehmen.‡‡‡‡‡‡',
  }
},
[10360] = {
  {
    'Uma doação de seda‡Пожертвование: шелк‡Spendet Seide‡비단 옷감 기부‡Un donativo de seda‡Un donativo de seda‡Un don de soie‡捐献丝绸‡捐獻絲綢',
    nil,
    '‡Принеси 60 отрезов шелка. Жители Луносвета будут тебе очень благодарны!nnЕсли необходимое количество ткани у тебя при себе, я с удовольствием приму дар сейчас.‡Unsere Vorräte an Seide sind, wie fast alle anderen Stoffe auch, so knapp wie nie zuvor. Unterstützen uns noch andere, so bräuchten wir derzeit eine Spende von nicht mehr als 60 Stücken Seide von Euch, um unser Ziel umsetzen zu können.nnEine wohlwollende Gabe, sagen wir Seide, könnte Euren hiesigen Ruf in Silbermond mit Sicherheit verbessern! Wenn Ihr die 60 Stücke Seide bei Euch habt und zu deren Spende bereit seid, dann kann ich sie jetzt entgegennehmen.‡‡‡‡‡‡',
  }
},
[10361] = {
  {
    'Uma doação de magitrama‡Пожертвование: магическая ткань‡Spendet Magiestoff‡마법 옷감 기부‡Un donativo de tejido mágico‡Un donativo de tejido mágico‡Un don de tisse-mage‡捐献魔纹布‡捐獻魔紋布',
    nil,
    '‡Принеси 60 отрезов магической ткани. Жители Луносвета будут тебе очень благодарны!nnЕсли необходимое количество ткани у тебя при себе, я с удовольствием приму дар сейчас.‡Unsere Vorräte an Magiestoff gehen zur Neige und wir könnten Eure Hilfe gebrauchen, um unsere Bestände wieder aufzufüllen! Wenn wir uns auf die Gemeinschaft im Ganzen verlassen, bräuchten wir lediglich eine Spende von 60 Stücken Magiestoff von Euch, um unser Ziel umsetzen zu können. Ich versichere Euch, dass eine derartige Großzügigkeit in Silbermond nicht unbeachtet bleiben würde!nnWenn Ihr die 60 Stücke Magiestoff bei Euch habt und zu deren Spende bereit seid, dann kann ich sie jetzt entgegennehmen.‡‡‡‡‡‡',
  }
},
[10362] = {
  {
    'Uma doação de runatrama‡Пожертвование: руническая ткань‡Spendet Runenstoff‡룬무늬 옷감 기부‡Un donativo de paño rúnico‡Un donativo de paño rúnico‡Un don d\'étoffe runique‡捐献符文布‡',
    nil,
    '‡Принеси 60 отрезов рунической ткани. Жители Луносвета будут тебе очень благодарны!nnЕсли необходимое количество ткани у тебя при себе, я с удовольствием приму дар сейчас.‡<Name>, Ihr wart eine enorme Unterstützung bei unserer Stoffsammelaktion. Da wir sehr hart am Aufstocken unserer Vorräte arbeiten, muss ich Euch wohl auch von unserem neusten und schwerwiegendsten Mangel berichten: Runenstoff. Wir brauchen ihn ganz dringend und hoffen, dass Ihr uns hierbei, wie schon zuvor, wieder unterstützen könnt.nnSolltet Ihr gewillt sein, so bringt mir bitte all den Runenstoff, den Ihr entbehren könnt. Für den Anfang wären wir mit 60 Stücken einverstanden, dann sehen wir weiter.‡‡‡‡‡‡',
  }
},
[10363] = {
  {
    'Runatrama extra‡Больше рунической ткани‡Noch mehr Runenstoff‡룬무늬 옷감 추가 기부‡Paño rúnico adicional‡Un donativo extra de paño rúnico‡Encore de l\'étoffe runique‡更多的符文布‡',
    nil,
    '‡Рунической ткани много не бывает. Принеси еще 20 отрезов – и получишь бесконечную признательность жителей Луносвета!nnПросто отдай ее мне, когда найдешь нужное количество.‡Seid gegrüßt, <Name>! Wir benötigen auch weiterhin noch Runenstoff. Zusätzliche Mittel sind daher jederzeit willkommen, solltet Ihr welche entbehren können. Liefert Ihr uns eine weitere Spende von 20 Stück Runenstoff, so werde ich dafür sorgen, dass Ihr die gebührende Anerkennung für Eure anhaltenden Bemühungen gegenüber Silbermond erhaltet.nnWann auch immer Ihr die erforderte Menge abgeben könnt, ich werde sie jederzeit entgegennehmen.‡‡‡‡For another stack of twenty runecloth, I will see to it that you are recognized for your continuing efforts on behalf of Silvermoon.nnSimply hand it to me when you\'re ready.‡‡',
  }
},
[10364] = {
  {
    'Edmos‡Кедмос‡Caedmos‡캐드모스‡Caedmos‡‡Caedmos‡凯德莫斯‡希德摩斯',
    nil,
    'Fale com Edmos na Cripta das Luzes da Exodar.‡Поговорите с Кедмосом в Чертоге Света Экзодара.‡Sprecht mit Caedmos in der Halle des Lichts der Exodar.‡엑소다르의 빛의 전당에 있는 캐드모스와 대화해야 합니다.‡Habla con Caedmos en El Arca de las Luces de El Exodar.‡Habla con Caedmos en El Arca de las Luces de El Exodar.‡Allez parler à Caedmos, à la Voûte des lumières de l’Exodar.‡与埃索达圣光穹顶的凯德莫斯谈一谈。‡',
  }
},
[10365] = {
  {
    'Desativar Manaforja Ara‡Отключить манагорн Ара‡Manaschmiede Ara abschalten‡아라 마나괴철로 차단‡El cierre de la Forja de Maná Ara‡El cierre de la Forja de Maná Ara‡Extinction de la manaforge Ara‡关闭法力熔炉：艾拉‡關閉法力熔爐艾拉',
    nil,
    'Viaje até Manaforja Ara e obtenha o Cristal de Acesso de Ara do Feitor Azarad. Use-o no Painel de Controle de Ara para desativá-la.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Отправляйтесь в манагорн Ара, заберите кристалл доступа Ара у надзирателя Азарадда. Используйте его на панели управления манагорном Ара, чтобы отключить его. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Reist zur Manaschmiede Ara und besorgt Euch einen Zugangskristall von Vorarbeiter Azarad. Benutzt ihn, um die Steuerungskonsole von Ara abzuschalten.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡아라 마나괴철로로 간 후 감독관 아자라드로부터 아라 장치 접근 수정을 입수해야 합니다. 그런 다음 아라 제어장치에 사용하여 차단해야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Ara y consigue un cristal de acceso del sobrestante Valdrin. Utilízalo en la consola de la Forja de Maná Ara para cerrarla.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con Los Aldor.‡Ve a la Forja de Maná Ara y consigue un cristal de acceso del sobrestante Valdrin. Utilízalo en la consola de la Forja de Maná Ara para cerrarla.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con Los Aldor.‡Voyagez jusqu\'à la manaforge Ara et prenez le Cristal d\'accès d\'Ara sur le contremaître Azarad. Utilisez-le à la console de la manaforge Ara pour l\'éteindre.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡前往法力熔炉：艾拉，从工头阿扎拉德手中夺得艾拉控制水晶。对法力熔炉：艾拉的控制台使用水晶关闭法力熔炉。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡到法力熔爐艾拉去從監督者阿薩納德身上取得艾拉控制水晶。將它使用來關閉星座控制臺。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10366] = {
  {
    'Jol‡Джоль‡Jol‡졸‡Jol‡‡Jol‡约尔‡喬歐',
    nil,
    'Fale com Jol no Sacrário dos Vindicantes, na Exodar.‡Поговорите с Джоль в Святилище поборников в Экзодаре.‡Sprecht mit Jol im Sanktum der Verteidiger in der Exodar.‡엑소다르의 구원자의 성소에 있는 졸과 대화해야 합니다.‡Habla con Jol en el Sagrario de los Vindicadores, en El Exodar.‡Habla con Jol en el Sagrario de los Vindicadores, en El Exodar.‡Allez parler à Jol, au Sanctum des anachorètes de l\'Exodar.‡与埃索达守备官圣殿的约尔谈一谈。‡在艾克索達的復仇者聖所與喬歐談談。',
  }
},
[10367] = {
  {
    'Um traidor entre nós‡Предатель среди нас‡Ein Verräter unter uns‡내부의 반역자‡Un traidor entre nosotros‡Un traidor entre nosotros‡Un traître parmi nous‡叛徒‡眾人的背叛者',
    nil,
    'Naladu, nas Ruínas de Sha\'naar, quer que você obtenha a Chave de Sha\'naar de uma cabana próxima.‡Добудьте ключ Ша\'наара, спрятанный в лачуге в руинах Ша\'наара неподалеку от Наладу.‡Naladu in den Ruinen von Sha\'naar möchte, dass Ihr den Schlüssel von Sha\'naar aus einer Hütte in der Nähe besorgt.‡샤나르 페허에 있는 날라두가 그 근처에 있는 오두막에서 샤나르 열쇠를 입수해 달라고 부탁했습니다.‡Naladu, en las Ruinas de Sha\'naar, quiere que le consigas la llave Sha\'naar de una choza próxima.‡Naladu, en las Ruinas de Sha\'naar, quiere que le consigas la llave Sha\'naar de una choza próxima.‡Naladu, aux ruines de Sha\'naar, veut que vous vous procuriez la Clé de Sha\'naar dans une hutte des alentours.‡沙纳尔废墟的纳拉杜要你在附近的小屋中找到沙纳尔钥匙。‡在夏納廢墟的納拉杜要你從附近一所小屋裡取回夏納鑰匙。',
  }
},
[10368] = {
  {
    'Os anciãos Capuzcória‡Старейшины Отребья‡Die Ältesten des Lumpenpacks‡넝마두건일족 장로‡Los ancianos Zarrapucha‡Los ancianos Zarrapucha‡Les Anciens crapuches‡残冠长者‡崔互德長者',
    nil,
    'Liberte Morod, o Acorda-ventos, Akoru, o Chama-fogo e Aylaan, o Conclama-águas. Fale novamente com Naladu quando cumprir a missão.‡Освободите Морода Ветродува, Акору Призывателя Огня и Айлаана Пробуждающего Водув руинах Ша\'наара. После выполнения задания возвращайтесь к Наладу.‡Befreit Morod den Windtreiber, Akoru den Feuerrufer und Aylaan den Wasserrufer aus den Ruinen von Sha\'naar. Kehrt zu Naladu zurück, wenn Ihr diese Aufgabe erledigt habt.‡샤나르 폐허에 있는 바람의 길잡이 모로드, 불꽃의 소환사 아코루, 물의 소환사 아일란을 구출한 후 날라두에게 돌아가야 합니다.‡Libera a Morod el Agitavientos, a Akoru el Pirotigma y a Aylaan el Levantaguas en las Ruinas de Sha\'naar. Regresa junto a Naladu cuando hayas completado esta tarea.‡Libera a Morod el Agitavientos, a Akoru el Clamafuegos y a Aylaan el Levantaguas en las Ruinas de Sha\'naar. Regresa junto a Naladu cuando hayas completado esta tarea.‡Libérez Morod le Touillevent, Akoru le Mandefeu et Aylaan le Troublelonde aux ruines de Sha\'naar. Retournez voir Naladu lorsque ce sera fait.‡搭救被囚禁在沙纳尔废墟的抚风者莫洛德、召火者阿库鲁和唤水者埃伊兰。完成任务后向纳拉杜复命。‡釋放夏納廢墟的『鼓風者』莫洛德，『召火者』阿庫羅及『喚水者』阿亞藍。完成後向納拉杜回報。',
  }
},
[10369] = {
  {
    'O fim de Aezeth‡Наследие Арзета‡Arzeths Untergang‡아제스에 대한 심판‡La desaparición de Arzeth‡La desaparición de Arzeth‡La fin d\'Arzeth‡阿尔泽斯之死‡阿爾塞斯的死亡',
    nil,
    'Use o Cajado dos Anciãos Capuzcória em Aezeth, o Impiedoso, e mate-o quando ele perder os poderes. Fale novamente com Naladu nas Ruínas de Sha\'naar quando cumprir esta missão.‡Используйте посох старейшин племени Отребья против Арзета Безжалостного. После того как Арзет потеряет силу, убейте его. После выполнения задания возвращайтесь к Наладу в руины Ша\'наара.‡Benutzt den Ältestenstab des Lumpenpacks gegen Arzeth den Erbarmungslosen und tötet ihn, nachdem er seine Macht verloren hat. Kehrt danach zu Naladu in den Ruinen von Sha\'naar zurück.‡무자비의 아제스에게 넝마두건일족 장로의 지팡이를 사용하여 그가 힘을 잃었을 때 처치한 후, 샤나르 폐허에 있는 날라두에게 돌아가야 합니다.‡Usa el bastón de los ancianos Zarrapucha sobre Arzeth el Despiadado y mátalo cuando haya perdido sus poderes. Regresa junto a Naladu, en las Ruinas de Sha\'naar, cuando hayas completado esta tarea.‡Usa el bastón de los ancianos Zarrapucha sobre Arzeth el Despiadado y mátalo cuando haya perdido sus poderes. Regresa junto a Naladu, en las Ruinas de Sha\'naar, cuando hayas completado esta tarea.‡Utilisez le Bâton des anciens crapuches contre Arzeth le Sans-clémence et tuez-le lorsqu\'il aura perdu ses pouvoirs. Retournez voir Naladu aux ruines de Sha\'naar lorsque ce sera fait.‡对无情的阿尔泽斯使用残冠长者法杖，趁阿尔泽斯失去力量时杀死他。完成任务后向沙纳尔废墟的纳拉杜复命。‡對無情的阿爾塞斯使用崔互德長者法杖，並且在他失去力量之後殺死他。完成這項任務之後，返回夏納廢墟找納拉杜。',
  }
},
[10370] = {
  {
    'Comando de Nazgrel <TXT>‡Приказ Назгрела <TXT>‡Nazgrels Befehl‡‡El mando de Nazgrel <TXT>‡‡Les ordres de Nazgrel <TXT>‡‡納茲格雷爾的命令<TXT>',
