[9269] = {
  {
    'Atiesh, Grande Cajado do Guardião‡Атиеш, большой посох Стража‡Atiesh, Hohestab des Wächters‡아티쉬 - 수호자의 지팡이‡Atiesh, el gran báculo del guardián‡Atiesh, el gran báculo del guardián‡Atiesh, le grand bâton du Gardien‡埃提耶什，守护者的传说之杖‡阿泰絲,守護者之杖',
    nil,
    'Anacronos, nas Cavernas do Tempo, em Tanaris, quer que você leve Atiesh, Grande Cajado do Guardião, a Stratholme para usá-lo no Solo Consagrado. Em seguida, derrote a entidade exorcizada do cajado e fale novamente com o dragão.‡Анахронос из Пещер Времени, что в Танарисе, просит вас отнести Атиеш, большой посох Стража, в Стратхольм и установить его на освященную землю. Одолейте силу, которая исторгнется из посоха, и вернитесь к Анахроносу.‡Anachronos in den Höhlen der Zeit in Tanaris möchte, dass Ihr Atiesh, den Hohestab des Wächters, nach Stratholme bringt und dort auf dem geheiligten Boden platziert. Bezwingt das Wesen, das aus dem Stab getrieben wurde, und kehrt danach wieder zu ihm zurück.‡‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anachronos, aux Grottes du temps en Tanaris, veut que vous emportiez Atiesh, le grand bâton du Gardien, à Stratholme et que vous le placiez sur la Terre consacrée. Abattez l’entité qui sera extraite du bâton et retournez le voir.‡塔纳利斯时光之穴的安纳克罗斯要你带着阿泰丝,守护者之杖前往斯坦索姆，在圣化之地上使用它。击败从法杖内被驱除的生物再回去找他。‡塔納利斯時光之穴的安納克羅斯要你帶著阿泰絲,守護者之杖前往斯坦索姆，在聖化之地上使用它。擊敗從法杖內被驅除的生物再回去找他。',
  }
},
[9270] = {
  {
    'Atiesh, Grande Cajado do Guardião‡Атиеш, большой посох Стража‡Atiesh, Hohestab des Wächters‡아티쉬, 수호자의 지팡이‡Atiesh, el gran báculo del guardián‡Atiesh, el gran báculo del guardián‡Atiesh, le grand bâton du Gardien‡埃提耶什，守护者的传说之杖‡阿泰絲,守護者之杖',
    nil,
    'Anacronos, nas Cavernas do Tempo, em Tanaris, quer que você leve Atiesh, Grande Cajado do Guardião, a Stratholme para usá-lo no Solo Consagrado. Em seguida, derrote a entidade exorcizada do cajado e fale novamente com o dragão.‡Анахронос из Пещер Времени, что в Танарисе, просит вас отнести Атиеш, большой посох Стража, в Стратхольм и установить его на освященную землю. Одолейте силу, которая исторгнется из посоха, и вернитесь к Анахроносу.‡Anachronos in den Höhlen der Zeit in Tanaris möchte, dass Ihr Atiesh, den Hohestab des Wächters, nach Stratholme bringt und dort auf dem geheiligten Boden platziert. Bezwingt das Wesen, das aus dem Stab getrieben wurde, und kehrt danach wieder zu ihm zurück.‡타나리스의 시간의 동굴에 있는 아나크로노스가 수호자의 지팡이인 아티쉬를 스트라솔름으로 가지고 간 다음, 정화된 땅에서 사용해 달라고 부탁했습니다. 지팡이에서 쫓겨 나온 존재를 해치운 후 아나크로노스에게 돌아가십시오.‡Anacronos, que está en las Cavernas del Tiempo, en Tanaris, quiere que uses Atiesh, el gran báculo del guardián, en tierra consagrada en Stratholme. Derrota al ser diabólico que ha poseído el bastón y vuelve.‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anachronos, aux Grottes du temps en Tanaris, veut que vous emportiez Atiesh, le grand bâton du Gardien, à Stratholme et que vous le placiez sur la Terre consacrée. Abattez l’entité qui sera extraite du bâton et retournez le voir.‡塔纳利斯时光之穴的阿纳克洛斯要你前往斯坦索姆，在神圣之地上使用埃提耶什，守护者的传说之杖。击败被驱赶出法杖的生物，然后回到阿纳克洛斯那里去。‡塔納利斯時光之穴的安納克羅斯要你帶著阿泰絲,守護者之杖前往斯坦索姆，在聖化之地上使用它。擊敗從法杖內被驅除的生物再回去找他。',
  }
},
[9271] = {
  {
    'Atiesh, Grande Cajado do Guardião‡Атиеш, большой посох Стража‡Atiesh, Hohestab des Wächters‡아티쉬 - 수호자의 지팡이‡Atiesh, gran báculo del Guardián‡Atiesh, el gran báculo del guardián‡Atiesh, le grand bâton du Gardien‡埃提耶什，守护者的传说之杖‡阿泰絲，守護者之杖',
    nil,
    'Anacronos, nas Cavernas do Tempo, em Tanaris, quer que você leve Atiesh, Grande Cajado do Guardião, a Stratholme para usá-lo no Solo Consagrado. Em seguida, derrote a entidade exorcizada do cajado e fale novamente com o dragão.‡Анахронос из Пещер Времени, что в Танарисе, просит вас отнести Атиеш, большой посох Стража, в Стратхольм и установить его на освященную землю. Одолейте силу, которая исторгнется из посоха, и вернитесь к Анахроносу.‡Anachronos in den Höhlen der Zeit in Tanaris möchte, dass Ihr Atiesh, den Hohestab des Wächters, nach Stratholme bringt und dort auf dem geheiligten Boden platziert. Bezwingt das Wesen, das aus dem Stab getrieben wurde, und kehrt danach wieder zu ihm zurück.‡‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, gran báculo del Guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anacronos, en las Cavernas del Tiempo en Tanaris, quiere que lleves a Atiesh, el gran báculo del guardián, a Stratholme y lo uses en la Tierra consagrada. Derrota al ser diabólico exorcizado del báculo y vuelve a ver a Anacronos.‡Anachronos, aux Grottes du temps en Tanaris, veut que vous emportiez Atiesh, le grand bâton du Gardien, à Stratholme et que vous le placiez sur la Terre consacrée. Abattez l’entité qui sera extraite du bâton et retournez le voir.‡塔纳利斯时光之穴的阿纳克洛斯要你前往斯坦索姆，在神圣之地上使用埃提耶什，守护者的传说之杖。击败被驱赶出法杖的生物，然后回到阿纳克洛斯那里去。‡',
  }
},
[9272] = {
  {
    'Vestindo a tripulação‡Костюм пирата‡Kleider machen Seebären‡해적 복장 입기‡Vístete como tal‡Vístete como tal‡L\'habit fait le boucanier‡海盗的制服‡適宜的服裝',
