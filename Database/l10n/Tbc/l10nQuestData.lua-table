[10476] = {
  {
    'Inimigos ferozes‡Лютые враги‡Grimmige Feinde‡난폭한 적‡Enemigos encarnizados‡Enemigos encarnizados‡Ennemis féroces‡强悍的敌人‡殘暴的敵人',
    nil,
    'O Responsável Moi\'bff Jill, de Telaar, quer que você pegue 10 Colares de Guerra Obsidianos de vários ogros de Nagrand.‡Принесите стражу-смотрителю Мой\'прну Джиллу 10 обсидиановых боевых ожерелий, снятых с огров из Награнда.‡Aufseher Moi\'bff Jill in Telaar möchte, dass Ihr 10 Obsidiankriegsperlen von den verschiedenen Ogern in Nagrand besorgt.‡텔라아르에 있는 교도관 모입프 질이 나그란드에 살고 있는 다양한 오우거들에게서 흑요석 전투 목걸이 10개를 가져와 달라고 부탁했습니다.‡El celador Moi\'bff Jill de Telaar quiere que consigas 10 abalorios de guerra de obsidiana de los distintos ogros que viven en Nagrand.‡El celador Moi\'bff Jill de Telaar quiere que consigas 10 abalorios de guerra de obsidiana de los distintos ogros que viven en Nagrand.‡Le gardien Moi\'bff Jill de Telaar veut que vous vous procuriez 10 Perles de guerre d\'obsidienne sur les différents ogres qui habitent Nagrand.‡塔拉的监护者莫布吉尔要你从纳格兰的食人魔身上收集10串黑曜石作战念珠。‡泰拉的守望者莫布夫·吉爾要你去從納葛蘭上各種不同的巨魔身上取得10個黑曜石戰爭串珠。',
  }
},
[10477] = {
  {
    'Mais colares de guerra‡Боевые ожерелья‡Mehr Kriegsperlen‡흑요석 전투 목걸이 추가 수집‡Más abalorios de guerra‡Más abalorios de guerra‡Plus de perles de guerre‡更多作战念珠‡更多的戰爭串珠',
    nil,
    'Trouxe outros colares de guerra obsidianos, VOSSLER?‡‡Habt Ihr noch mehr Obsidiankriegsperlen dabei, <Name>?‡‡¿Tienes más abalorios de guerra de obsidiana, <nombre>?‡‡‡‡',
  }
},
[10478] = {
  {
    'Mais colares de guerra!‡Боевые ожерелья!‡Mehr Kriegsperlen!‡흑요석 전투 목걸이 추가 수집!‡¡Más abalorios de guerra!‡¡Más abalorios de guerra!‡Plus de perles de guerre !‡更多作战念珠！‡更多的戰爭串珠!',
    nil,
    'Você pegou mais colares de guerra, <name>?‡Ты добыл еще боевых ожерелий, Солэтьюд?‡Habt Ihr noch mehr Obsidiankriegsperlen besorgt, <Name>?‡흑요석 전투 목걸이를 더 구했소이까?‡‡‡‡‡',
  }
},
[10479] = {
  {
    'Prova de força‡Покажи свою силу‡Stärke beweisen‡힘의 증명‡Demostrar tu fuerza‡Demostrar tu fuerza‡Prouver votre force‡证明你的力量‡證明你的力量',
    nil,
    'O Guarda Bullrok, de Garadar, quer que você pegue 10 Colares de Guerra Obsidianos de vários ogros de Nagrand.‡Принесите 10 обсидиановых боевых ожерелий, снятых с огров, населяющих Награнд, стражу-смотрителю Быккроку в Гарадар.‡Aufseher Bullrok in Garadar möchte, dass Ihr 10 Obsidiankriegsperlen von den verschiedenen Ogern in Nagrand besorgt.‡가라다르에 있는 교도관 불로크가 나그란드에 사는 다양한 오우거들을 처치하고 흑요석 전투 목걸이 10개를 구해달라고 부탁했습니다.‡El celador Tororroc de Garadar quiere que consigas diez abalorios de guerra de obsidiana de los diferentes ogros que habitan Nagrand.‡El celador Tororroc de Garadar quiere que consigas diez abalorios de guerra de obsidiana de los diferentes ogros que habitan Nagrand.‡Le gardien Bullrok de Garadar veut que vous vous procuriez 10 Perles de guerre d\'obsidienne sur les différents ogres qui habitent Nagrand.‡加拉达尔的监护者布罗克要你从纳格兰的食人魔身上收集10串黑曜石作战念珠。‡卡拉達爾的守望者波洛克要你去從納葛蘭上各種不同的巨魔身上收集10個黑曜石戰爭串珠。',
  }
},
[10480] = {
  {
    'Espíritos da água enfurecidos‡Разъяренные бесы воды‡Wütende Geister des Wassers‡분노한 물의 정령‡Espíritus de agua iracundos‡Espíritus de agua iracundos‡Esprits des eaux enragés‡愤怒的水灵‡暴怒的水之靈',
    nil,
    'O Reparador da Terra Torlok, no Altar da Danação do Vale da Lua Negra, quer que você use o Totem dos Espíritos para capturar 5 Almas da Água.‡Используйте тотем духов, чтобы поймать 5 бесов воды для целителя земли Торлока у Алтаря Проклятия в Долине Призрачной Луны.‡Erdheiler Torlok beim Altar der Verdammnis im Schattenmondtal möchte, dass Ihr das Totem der Geister benutzt, um 5 Wasserseelen einzufangen.‡어둠달 골짜기의 저주의 제단에 있는 대지치유사 토르록이 정령의 토템을 사용하여 분노한 물의 영혼 5명을 사로잡아 달라고 했습니다.‡El ensalmador de la tierra Torlok de El Altar de Condenación, en el Valle Sombraluna, quiere que uses el Tótem de espíritus para capturar 5 almas acuáticas.|n‡El ensalmador de la tierra Torlok de El Altar de Condenación, en el Valle Sombraluna, quiere que uses el Tótem de espíritus para capturar 5 almas acuáticas.|n‡Le soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune veut que vous utilisiez le Totem des esprits pour capturer 5 Âmes aquatiques.‡使用灵魂图腾俘获5个水之魂，然后向影月谷诅咒祭坛的大地治愈者托洛克复命。‡影月谷的詛咒祭壇的大地治癒者托爾洛克要你使用靈魂圖騰去捕獲5個水之魂。',
  }
},
[10481] = {
  {
    'Espíritos do ar enfurecidos‡Разъяренные бесы воздуха‡Wütende Geister der Luft‡분노한 바람의 정령‡Espíritus de aire iracundos‡Espíritus de aire iracundos‡Esprits des airs enragés‡愤怒的气灵‡暴怒的風之靈',
    nil,
    'O Reparador da Terra Torlok, no Altar da Danação do Vale da Lua Negra, quer que você use o Totem dos Espíritos para capturar 10 Almas do Ar.‡Поймайте с помощью тотема духов 10 бесов воздуха для целителя земли Торлока из Алтаря Проклятия.‡Erdheiler Torlok beim Altar der Verdammnis im Schattenmondtal möchte, dass Ihr das Totem der Geister benutzt, um 10 Luftseelen einzufangen.‡어둠달 골짜기의 저주의 제단에 있는 대지치유사 토르록이 정령의 토템을 사용하여 분노한 바람의 영혼 10명을 사로잡아 달라고 했습니다.‡El ensalmador de la tierra Torlok de El Altar de Condenación, en el Valle Sombraluna, quiere que uses el Tótem de espíritus para capturar 10 almas aéreas.‡El ensalmador de la tierra Torlok de El Altar de Condenación, en el Valle Sombraluna, quiere que uses el Tótem de espíritus para capturar 10 almas aéreas.‡Le soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune veut que vous utilisiez le Totem des esprits pour capturer 10 Âmes aériennes.‡使用灵魂图腾俘获10个气之魂，然后向影月谷诅咒祭坛的大地治愈者托洛克复命。‡影月谷的詛咒祭壇的大地治癒者托爾洛克要你使用靈魂圖騰去捕獲10個大氣之魂。',
  }
},
[10482] = {
  {
    'Orcs vis catadores‡Падальщики орков Скверны‡Plünderer der Höllenorcs‡타락한 오크 청소부‡Orcos viles carroñeros‡Orcos viles carroñeros‡Les charognards gangr\'orcs‡邪兽人清理者‡魔獄獸人拾荒者',
    nil,
    'Mate 20 Orcs Mascaosso e fale novamente com a Tenente Amadi na Fortaleza da Honra.‡Убейте 20 орков из клана Костеглодов и возвращайтесь к Амади в Оплот Чести.‡Tötet 20 Orcs der Knochenmalmer und kehrt danach zu Amadi in der Ehrenfeste zurück.‡해골이빨 오크 20마리를 처치한 후 명예의 요새에 있는 부관 아마디에게 돌아가야 합니다.‡Mata a 20 orcos Mascahuesos y vuelve con Amadi al Bastión del Honor.‡Mata a 20 orcos Mascahuesos y vuelve con Amadi al Bastión del Honor.‡Tuez 20 Orcs Mâche-les-os et retournez voir Amadi au Bastion de l\'honneur.‡杀死20个噬骨兽人，然后向荣耀堡的阿曼蒂复命。‡殺掉20個噬骨獸人，完成後回到榮譽堡回報阿瑪迪。',
  }
},
[10483] = {
  {
    'Presságios agourentos‡Дурные предзнаменования‡Schwarze Magie‡나쁜 징조‡Malos augurios‡Malos augurios‡De mauvais présages‡邪恶的咒语‡邪惡的預兆',
    nil,
    'A Tenente Amadi, na Fortaleza da Honra, quer que você leve 1 Talismã Amaldiçoado para o Cabo Cristaferro no Posto da Expedição.‡Принесите 1 проклятый талисман капралу Железному Хребту в лагерь экспедиции по просьбе лейтенанта Амади в Оплоте Чести.‡Leutnant Amadi in der Ehrenfeste möchte, dass Ihr einen verfluchten Talisman zu Korporal Eisengrat im Expeditionsposten bringt.‡명예의 요새에 있는 부관 아마디가 원정대 거점에 있는 하사관 아이언리지에게 저주받은 부적 1개를 가져다 달라고 부탁했습니다.‡La teniente Amadi, del Bastión del Honor, quiere que le lleves un dije maldito al cabo Crestahierro, de la Punta de Expedición.‡La teniente Amadi, del Bastión del Honor, quiere que le lleves un dije maldito al cabo Crestahierro, de la Punta de Expedición.‡Le lieutenant Amadi du bastion de l\'Honneur vous a demandé d\'apporter 1 Talisman maudit au Caporal Crêtefer, à la Halte de l\'expédition.‡荣耀堡的阿曼蒂中尉要你前往远征军岗哨，将1枚被诅咒的护符交给埃隆雷下士。‡榮譽堡的阿瑪迪中尉要你帶來1個被詛咒的護符給遠征隊哨塔的剛脊下士。',
  }
},
[10484] = {
  {
    'Talismãs amaldiçoados‡Проклятые талисманы‡Verfluchte Talismane‡저주받은 부적‡Dijes malditos‡Dijes malditos‡Talismans maudits‡被诅咒的护符‡被詛咒的護符',
    nil,
    'Leve 12 Talismãs Amaldiçoados para o Cabo Cristaferro no Posto da Expedição.‡Принесите 12 проклятых талисманов капралу Железному Хребту в Лагерь экспедиции.‡Bringt 12 verfluchte Talismane zu Korporal Eisengrat am Expeditionsposten.‡원정대 거점에 있는 하사관 아이언리지에게 저주받은 부적 12개를 가져가야 합니다.‡Lleva 12 dijes malditos al cabo Crestahierro, en la Punta de Expedición.‡Lleva 12 dijes malditos al cabo Crestahierro, en la Punta de Expedición.‡Rapportez 12 Talismans maudits au Caporal Crêtefer à la Halte de l\'expédition.‡将12枚被诅咒的护符交给远征军岗哨的埃隆雷下士。‡帶著12個被詛咒的護符回去給遠征隊哨塔的剛脊下士。',
  }
},
[10485] = {
  {
    'O senhor da guerra dos Olhos Sangrentos‡Воевода клана Кровавой Глазницы‡Kriegsherr des Blutenden Auges‡피투성이굴부족의 장군‡Señor de la Guerra del Foso Sangrante‡Señor de la guerra del Foso Sangrante‡Le seigneur de guerre de l\'Orbite-Sanglante‡血环督军‡血之谷的督軍',
    nil,
    'Leve a Armadura Rachada de Morkh para o Cabo Cristaferro no Posto da Expedição.‡Принесите разбитые доспехи воеводы Морха капралу Железному Хребту в лагерь экспедиции.‡Bringt Kriegsherr Morkhs zerschmetterte Rüstung zu Korporal Eisengrat im Expeditionsposten.‡원정대 거점에 있는 하사관 아이언리지에게 모르크의 부서진 갑옷을 가져가야 합니다.‡Lleva la armadura destrozada del Señor de la Guerra Morkh al cabo Crestahierro, en la Punta de Expedición.‡Lleva la armadura destrozada del señor de la guerra Morkh al cabo Crestahierro, en la Punta de Expedición.‡Apportez l\'Armure brisée du seigneur de guerre Morkh au Caporal Crêtefer à la Halte de l\'expédition.‡把督军摩尔肯的破碎护甲交给远征军岗哨的埃隆雷下士。‡把督軍莫克的破碎胸甲帶給遠征隊哨塔的剛脊下士。',
  }
},
[10486] = {
  {
    'A selva agressiva‡Угроза хищников‡Die nahende Wildnis‡야생동물의 침범‡La tierra salvaje usurpadora‡La naturaleza invasora‡Une nature envahissante‡荒野的危险‡失控的侵略',
    nil,
    'Mate 12 Dessangradores Laminasas.‡Гор\'дрек просит вас убить 12 острокрылых кровопускателей. Вернитесь к нему в оплот Громоборцев в Острогорье после выполнения задания.‡Gor\'drek möchte, dass Ihr 12 Messerschwingenblutvergießer tötet. Kehrt zu ihm in der Donnerfeste im Schergrat zurück, wenn Ihr Eure Aufgabe erledigt habt.‡고르드렉이 피바람 칼날날개 키메라 12마리를 해치워 달라고 부탁했습니다. 임무를 완수하면 칼날 산맥의 천둥군주 요새에 있는 그에게 돌아가십시오.‡Gor\'drek te ha pedido que mates a doce estampas de sangre de Ala de Sangre. Vuelve con él al Bastión Señor del Trueno, en las Montañas Filospada, cuando lo hayas logrado.‡‡Gor\'drek vous a demandé de tuer 12 Saigneurs Aile-rasoir. Retournez le voir au bastion des Sire-tonnerre dans les Tranchantes lorsque ce sera fait.‡高德雷克要你杀死12个刃翼放血者，完成任务后返回刀锋山的雷神要塞向他复命。‡葛德雷克要你去殺掉12個刃翼血信。完成後回到劍刃山脈的雷霆王村找他。',
  }
},
[10487] = {
  {
    'Pó dos dracos‡Пыльца волшебных драконов‡Drachenstaub‡마력의 비룡 가루‡Polvo de los dracos‡Polvo de los dracos‡La poussière des drakes‡仙龙之尘‡龍的粉末',
    nil,
    'Colete 4 Amostras de Pó de Draco Encantado.‡Гор\'дрек хочет, чтобы вы принесли пыльцу с крыльев 4 волшебных драконов. После этого вернитесь к нему в оплот Громоборцев в Острогорье.‡Gor\'drek möchte, dass Ihr 4 Einheiten Siechdrachenstaub sammelt. Kehrt danach zu ihm in der Donnerfeste im Schergrat zurück.‡고르드렉이 마력의 비룡 가루 4줌을 수집해 달라고 부탁했습니다. 모두 모으면 칼날 산맥의 천둥군주 요새에 있는 고르드렉에게 돌아가십시오.‡Gor\'drek quiere que reúnas cuatro polvos de draco hada. Tras hacerlo, vuelve con él al Bastión Señor del Trueno en las Montañas Filospada.‡‡Procurez-vous 4 Poussières des Drakes-faë.‡高德雷克要你收集4份仙龙之尘，完成任务后返回刀锋山的雷神要塞向他复命。‡葛德雷克要你去取得4份精靈龍粉末。完成後，回到劍刃山脈的雷霆王村找他。',
  }
},
[10488] = {
  {
    'A proteção dos nossos‡Защитить свой дом‡Die Eigenen schützen‡친구를 지켜라‡Proteger a los nuestros‡Proteger a los nuestros‡Pour protéger les nôtres‡自卫‡保護我們自己',
    nil,
    'Use a Pomada de Gor\'drek em 5 Lobos Hediondos Senhor do Trovão.‡Помажьте мазью Гор\'дрека 5 лютых волков клана Громоборцев, чтобы сделать их сильнее и укрепить оборону Зазубренной гряды. Затем вернитесь к Горд\'дреку в оплот Громоборцев в Острогорье.‡Wendet Gor\'dreks Salbe an 5 Terrorwölfen der Donnerfürsten an, um sie stärker zu machen und die Verteidigung des Zackengrats zu unterstützen. Kehrt danach zu Gor\'drek in der Donnerfeste im Schergrat zurück.‡고르드렉의 연고를 광포한 천둥군주 늑대 5마리에게 사용하여 뾰족 마루의 방어선을 강화해야 합니다. 그런 다음 칼날 첨탑의 천둥군주 요새에 있는 고르드렉에게 돌아가십시오.‡Usa el ungüento de Gor\'drek en 5 de los lobos temibles del Señor del Trueno para reforzarlos a ellos y la defensa de la Cresta Dentada. Después, vuelve con Gor\'drek al Bastión Señor del Trueno, en las Montañas Filospada.‡‡Utilisez la Pommade de Gor\'drek sur 5 des Loups redoutables sires-tonnerres.‡对5匹雷神恶狼使用高德雷克的药膏，强化锯齿山的防御力量。然后返回刀锋山的雷神要塞，向高德雷克复命。‡在5隻雷霆王恐狼身上使用葛德雷克的藥膏來強化它們及鋸齒山脊的防禦。完成後回到劍刃山脈的雷霆王村找葛德雷克。',
  }
},
[10489] = {
  {
    'Derrubada da árvore anciente‡Свалить ходячее древо!‡Einen uralten Baum fällen‡고대의 나무 베기‡Talar un antiguo árbol‡Talar un antiguo árbol‡Abattre un vieil arbre‡追杀战争古树‡砍伐古老之樹',
    nil,
    'Obtenha o Tronco de Ramaforte Raizfundo.‡Добудьте ствол Лесодрева Глубокорня и доставьте его Тор\'чанку Двукогтю на постоялый двор оплота Громоборцев в Острогорье.‡Besorgt Starkast Tiefenwurz\' Stumpf und bringt ihn zu Tor\'chunk Zweiklaue in der Donnerfeste im Schergrat.‡칼날 산맥의 천둥군주 요새에 있는 토르청크 투클로즈에게 무쇠줄기 깊은뿌리의 줄기를 가져가야 합니다.‡Consigue el tronco de Manofirme Raizhonda y llévaselo a Tor\'chunk Dosgarras del Bastión Señor del Trueno, en las Montañas Filospada.‡‡Procurez-vous le Tronc de Fermebranche Basseracines et apportez-le à Tor\'chunk Doublegriffes au Bastion des Sire-tonnerre dans les Tranchantes.‡将深根古树的树干交给刀锋山雷神要塞的托查克·双爪。‡取得斯卓霖普·深根的樹幹並送到劍刃山脈的雷霆王村給吐查克·雙爪。',
  }
},
[10490] = {
  {
    'Call of Water‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Найдите на острове Лазурной Дымки в Кристальном зале Экзодара предсказателя Нобундо и поговорите с ним.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达水晶大厅的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[10491] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風的召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара на острове Лазурной Дымки.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l’intérieur de l’Exodar sur l’île de Brume-azur.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[10492] = {
  {
    'An Earnest Proposition‡Серьезное предложение‡Ein aufrichtiges Angebot‡진지한 제안‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡誠摯的建議',
    nil,
    'Acquire 15 Winterspring Blood Samples and 20 gold and bring them along with a set of Bindings of Elements to Deliana in Ironforge.‡Добудьте 15 порций крови животных Зимних Ключей и 20 золотых и отдайте их вместе с наручниками Стихий Делиане в Стальгорне.‡Sammelt 15 Blutproben aus Winterquell und bringt sie zusammen mit 20 Gold und einem Paar Bindungen der Elemente zu Deliana in Eisenschmiede.‡여명의 설원 혈액 견본 15개와 20골드, 정령의 손목띠를 아이언포지에 있는 델리아나에게 가져가야 합니다.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de Ataduras de elementos a Deliana, en Forjaz.‡Lleva 15 muestras de sangre de Cuna del Invierno, 20 piezas de oro y 1 par de ataduras de elementos a Deliana, en Forjaz.‡Procurez-vous 15 Échantillons de sang du Berceau-de-l’Hiver et 20 pièces d’or, et apportez-les avec une paire de Manchettes des éléments à Deliana à Forgefer.‡将15份冬泉谷血样、20枚金币以及一副元素护腕交给铁炉堡的德莉亚娜。‡取得15滴冬泉血滴樣本，20金和1套野性之心束腕給鐵爐堡的德莉娜。',
  }
},
[10493] = {
  {
    'An Earnest Proposition‡Серьезное предложение‡Ein aufrichtiges Angebot‡An Earnest Proposition‡Una propuesta seria‡Una propuesta seria‡Une proposition sérieuse‡热心的建议‡誠摯的建議',
    nil,
    'Obtenha 15 Amostras de Peçonha de Silithus, 20 peças de ouro e um par de Braçadeiras da Forja de Luz e entregue-os para Mokvar, em Orgrimmar.‡Добудьте 15 порций яда силитида и 20 золотых и принесите их вместе с наручами из светлостали Моквару в Оргриммар.‡Sammelt 15 Giftproben aus Silithus und bringt sie zusammen mit 20 Gold und einem Paar Armschienen des Lichts zu Mokvar in Orgrimmar zurück.‡Acquire 15 Silithus Venom Samples and 20 gold and bring them along with a set of Lightforge Bracers to Mokvar in Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Forjaluz a Mokvar, en Orgrimmar.‡Lleva 15 muestras de veneno de Silithus, 20 piezas de oro y 1 par de brazales Forjaluz a Mokvar, en Orgrimmar.‡Procurez-vous 15 Echantillons de venin de Silithus et 20 pièces d\'or, et apportez-les avec une paire de Brassards de Sancteforge à Mokvar, à Orgrimmar.‡将15份希利苏斯毒液样品、20枚金币以及一副光铸护腕交给奥格瑞玛的莫克瓦尔。‡取得15滴希利蘇斯毒液樣本，20金和1套光鑄護腕，帶給奧格瑪的莫克瓦。',
  }
},
[10494] = {
  {
    'Just Compensation‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    'Bring a Cord of Elements and a set of Gauntlets of Elements to Deliana in Ironforge.‡Принесите шнурованный ремень Стихий и пару рукавиц Стихий в Стальгорн Делиане.‡Bringt Deliana in Eisenschmiede eine Kordel der Elemente und ein Paar Stulpen der Elemente.‡‡Lleva 1 cordón y 1 par de guantes de elementos a Deliana a Forjaz.‡Lleva 1 cordón y 1 par de guantes de elementos a Deliana a Forjaz.‡Apportez une Corde des éléments et une paire de Gantelets des éléments à Deliana à Forgefer.‡‡',
  }
},
[10495] = {
  {
    'Just Compensation‡Справедливое вознаграждение‡Die angemessene Entlohnung‡‡Una compensación justa‡Una compensación justa‡Une juste compensation‡公平的补偿‡',
    nil,
    'Leve um Cinto da Forja de Luz e um par de Manoplas da Forja de Luz para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс из светлостали и рукавицы из светлостали.‡Bringt Mokvar in Orgrimmar einen Gürtel des Lichts und ein Paar Stulpen des Lichts.‡‡Lleva 1 cinturón Forjaluz y 1 par de guanteletes Forjaluz a Mokvar a Orgrimmar.‡Lleva 1 cinturón Forjaluz y 1 par de guanteletes Forjaluz a Mokvar a Orgrimmar.‡Apportez une Ceinture de Sancteforge et une paire de Gantelets de Sancteforge à Mokvar à Orgrimmar.‡‡',
  }
},
[10496] = {
  {
    'Anthion\'s Parting Words‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    'Return to Deliana in Ironforge with a set of Boots of Elements, a Kilt of Elements and Pauldrons of Elements.‡Вернитесь в Стальгорн к Делиане с сапогами Стихий, килтом Стихий и наплечьем Стихий.‡Kehrt mit einem Paar Stiefel der Elemente, einem Kilt der Elemente und einem Paar Schulterstücke der Elemente zu Deliana in Eisenschmiede zurück.‡‡Lleva 1 par de botas, 1 falda y 1 par de espaldares de elementos a Deliana a Forjaz.‡Lleva 1 par de botas, 1 falda y 1 par de espaldares de elementos a Deliana a Forjaz.‡Retournez voir Deliana à Forgefer avec des Bottes des éléments, un Kilt des éléments et des Espauliers des éléments.‡‡',
  }
},
[10497] = {
  {
    'Anthion\'s Parting Words‡Прощальные слова Антиона‡Anthions Abschiedsworte‡‡La despedida de Anthion‡La despedida de Anthion‡Les adieux d\'Anthion‡安希恩的离别感言‡',
    nil,
    'Return to Mokvar in Orgimmar with a set of Lightforge Boots, Lightforge Legplates and Lightforge Spaulders.‡Отдайте Моквару в Оргриммаре сапоги из светостали, ножные латы из светостали и наплеч из светостали.‡Kehrt mit einem Paar Stiefel des Lichts, ein Paar Beinplatten des Lichts und einer Schiftung des Lichts zu Mokvar in Orgrimmar zurück.‡‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas Forjaluz a Mokvar a Orgrimmar.|n‡Lleva 1 par de botas, 1 par de quijotes y 1 par de bufas Forjaluz a Mokvar a Orgrimmar.|n‡Retournez voir Mokvar à Orgrimmar avec des Bottes de Sancteforge, des Cuissards de Sancteforge et des Spallières de Sancteforge.‡‡',
  }
},
[10498] = {
  {
    'Saving the Best for Last‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    'Give Deliana your Coif of Elements and Vest of Elements.‡Отдайте Делиане капюшон Стихий и жилет Стихий.‡Gebt Deliana Eure Helmkappe der Elemente und Eure Weste der Elemente.‡‡Dale a Deliana tu almófar de elementos y tu jubón de elementos.‡Dale a Deliana tu almófar de elementos y tu jubón de elementos.‡Donnez votre Coiffe des éléments et votre Haubergeon des éléments à Deliana.‡‡',
  }
},
[10499] = {
  {
    'Saving the Best for Last‡Сладкое – на закуску‡Das Beste gibt\'s zum Schluss‡최고의 것은 마지막을 위해 남겨 두세요.‡Guardar lo mejor para el final‡Guardar lo mejor para el final‡Garder le meilleur pour la fin‡最后的奖赏‡最後的獎賞',
    nil,
    'Give Mokvar your Lightforge Helm and Lightforge Breastplate.‡Отдайте Моквару шлем из светостали и кирасу из светостали.‡Gebt Mokvar Euren Helm des Lichts und Eure Brustplatte des Lichts.‡‡Dale a Mokvar tu yelmo y tu coraza Forjaluz.‡Dale a Mokvar tu yelmo y tu coraza Forjaluz.‡Donnez votre Casque de Sancteforge et votre Cuirasse de Sancteforge à Mokvar.‡‡',
  }
},
[10500] = {
  {
    'A Horda precisa de você!‡Орде нужна твоя помощь!‡Die Horde braucht Euch!‡호드 지원!‡¡La Horda te necesita!‡¡La Horda te necesita!‡La Horde a besoin de votre aide !‡部落需要你的帮助！‡部落需要你的幫助!',
    nil,
    'Fale com o Senhor da Guerra Gorchuk no Vale dos Espíritos em Orgrimmar.‡Поговорите с вождем Горчуком на аллее Духов Оргриммара.‡Sprecht mit Kriegsherr Gorchuk im Tal der Geister in Orgrimmar.‡오그리마, 정기의 골짜기에 있는 장군 고르척과 대화하십시오.‡Habla con el Señor de la Guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Parler au seigneur de guerre Gorchuk, dans la vallée des Esprits d\'Orgrimmar.‡和奥格瑞玛精神谷的督军格尔库克谈一谈。‡和奧格瑪精神谷的督軍格爾庫克交談。',
  }
},
[10501] = {
  {
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要你的幫助!',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится в Палатах войны Стальгорна.‡Sprecht mit Feldmarschall Schneefall im Militärviertel von Eisenschmiede.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Tombeneige dans la Garde militaire de Forgefer.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的戰場元帥斯諾·落雪交談。',
  }
},
[10502] = {
  {
    'Os ogros Malho Sangrento‡Клан Кровавого Молота‡Die Oger der Blutschläger‡피망치일족 오우거‡Los ogros Machacasangre‡Los ogros Machacasangre‡Les ogres de la Masse-sanglante‡血槌食人魔‡血槌巨魔',
    nil,
    'Mate 30 Ogros Malho Sangrento quaisquer no Posto Malho Sangrento.‡Командир Тень Небес поручает вам уничтожить 30 любых огров из клана Кровавого Молота на заставе Кровавого Молота. По выполнении этого грязного дела вернитесь к нему в Сильванаар в Острогорье.‡Kommandant Himmelsschatten möchte, dass Ihr 30 Oger der Blutschläger im Außenposten der Blutschläger vernichtet. Kehrt zu ihm in Sylvanaar im Schergrat zurück, wenn Ihr die grauenvolle Aufgabe erledigt habt.‡사령관 스카이섀도가 피망치 전초기지에서 피망치일족 오우거 30마리를 처치하라는 임무를 주었습니다. 이 소름 끼치는 임무를 완수하면 칼날 산맥의 실바나르에 있는 그에게 돌아가야 합니다.‡El comandante Cielosombra te ha pedido que destruyas 30 ogros Machacasanre en la Avanzada Machacasangre. Vuelve a verle a Sylvanaar en las Montañas Filospada cuando hayas completado la tarea.‡‡Le Commandant Ombreciel vous a donné pour tâche de détruire 30 Ogres de la Masse-sanglante à l\'Avant-poste de la Masse-sanglante. Retournez le voir à Sylvanaar dans les Tranchantes une fois votre répugnante mission accomplie.‡指挥官萨卡斯·天影要求你消灭血槌哨站的任意30个血槌食人魔。完成这个肮脏的任务之后回到刀锋山的希尔瓦纳向他复命。‡指揮官天影要你去血槌前哨站殺死30個血槌巨魔。當你完成這個可怕的任務後，回到劍刃山脈的希爾瓦納向他回報。',
  }
},
[10503] = {
  {
    'A ameaça dos Giralança‡Угроза Камнерогов‡Die Speerspießerbedrohung‡칼날첨탑의 위협‡La amenaza Aguja del Filo‡La amenaza Aguja del Filo‡La menace des Flèchelame‡刀塔的威胁‡劍刃的威脅',
    nil,
    'Mate quaisquer 30 Ogros Giralança e 10 Raptores Giralança no Bastião Giralança e nas Terras dos Giralança.‡Тор\'чанк Двукоготь поручил вам уничтожить 30 любых огров из клана Камнерогов и 10 ящеров в форте Камнерогов и на землях Камнерогов. По выполнении поручения вернитесь в оплот Громоборцев в Острогорье.‡Tor\'chunk Zweiklaue möchte, dass Ihr 30 Oger der Speerspießer und 10 Raptoren der Speerspießer in der Wehr der Speerspießer und im Grund der Speerspießer vernichtet. Kehrt zu ihm in der Donnerfeste im Schergrat zurück, wenn Ihr Eure Aufgabe erfüllt habt.‡토르청크 투클로즈가 칼날첨탑 요새와 칼날첨탑 영토에서 칼날첨탑 오우거 30마리와 칼날첨탑랩터 10마리를 처치하라는 임무를 주었습니다. 임무를 완수하면 칼날 산맥의 천둥군주 요새에 있는 그에게 돌아가십시오.‡Tor\'chunk Dosgarras te ha pedido que destruyas 30 ogros Aguja del Filo y 10 raptores Aguja del Filo en el Bastión Aguja del Filo y los Dominios Aguja del Filo. Vuelve a verle en el Bastión Señor del Trueno, en las Montañas Filospada cuando hayas completado tu tarea.‡‡Tor\'chunk Doublegriffes vous a <chargé/chargée> de détruire 30 Ogres de Flèchelame et 10 Raptors de Flèchelame au bastion de Flèchelame et dans les Terres de la Flèchelame. Retournez le voir au bastion des Sire-tonnerre dans les Tranchantes une fois votre tâche achevée.‡托查克·双爪命令你消灭刀塔要塞和刀塔平原的30个刀塔食人魔和10只刀塔迅猛龙。完成任务后返回刀锋山的雷神要塞向他复命。‡吐查克·雙爪要求你在劍刃要塞還有劍刃庭園殺死30個劍刃巨魔還有10隻劍刃迅猛龍。任務完成時回到劍刃山脈的雷霆王村向他回報。',
  }
},
[10504] = {
  {
    'Os ogros Giralança‡Огры из клана Камнерогов‡Die Oger der Speerspießer‡칼날첨탑 오우거‡Los ogros Aguja del Filo‡Los ogros Aguja del Filo‡Les Ogres de Flèchelame‡刀塔食人魔‡劍刃巨魔',
    nil,
    'Mate 30 Ogros Giralança quaisquer no Bastião Giralança e nas Terras dos Giralança.‡Командир Тень Небес просит вас убить 30 любых огров из клана Камнерогов в форте Камнерогов и на землях Камнерогов. По выполнении вернитесь к нему в Сильванаар в Острогорье.‡Kommandant Himmelsschatten bittet Euch, 30 Oger der Speerspießer in der Wehr der Speerspießer und dem Grund der Speerspießer zu töten. Kehrt danach zu ihm in Sylvanaar im Schergrat zurück.‡칼날첨탑 요새와 칼날첨탑 영토에 있는 칼날첨탑 오우거 30마리를 처치해해야 합니다.‡Destruye 30 ogros Aguja del Filo en el Bastión Aguja del Filo y en los Dominios Aguja del Filo.‡‡Tuez 30 Ogres de Flèchelame au Bastion de Flèchelame et sur les Terres de la Flèchelame.‡指挥官萨卡斯·天影要求你消灭刀塔要塞内的任意30个刀塔食人魔。完成这个肮脏的任务之后回到刀锋山的希尔瓦纳向他复命。‡指揮官天影要你在劍刃要塞還有劍刃庭園殺死30個劍刃巨魔。任務完成時回到劍刃山脈的希爾瓦納向他回報。',
  }
},
[10505] = {
  {
    'Os ogros Malho Sangrento‡Клан Кровавого Молота‡Die Oger der Blutschläger‡피망치일족 오우거‡Los ogros Machacasangre‡Los ogros Machacasangre‡Les Ogres de la Masse-Sanglante‡血槌食人魔‡血槌巨魔',
    nil,
    'Mate 30 Ogros Malho Sangrento quaisquer no Posto Malho Sangrento.‡Тор\'чанк Двукоготь просит вас убить 30 любых огров из клана Кровавого Молота на заставе Кровавого Молота. По выполнении вернитесь к нему в оплот Громоборцев в Острогорье.‡Tor\'chunk Zweiklaue bittet Euch, 30 Oger der Blutschläger beim Außenposten der Blutschläger zu töten. Kehrt zu ihm in der Donnerfeste im Schergrat zurück, wenn Ihr erfolgreich wart.‡토르청크 투클로즈가 피망치 전초기지에 있는 피망치일족 오우거 30마리를 처치해 달라고 부탁했습니다. 일을 마치면 칼날 산맥의 천둥군주 요새에 있는 그에게 돌아가십시오.‡Tor\'chunk Dosgarras te ha pedido que mates a 30 ogros Machacasangre en la Avanzada Machacasangre. Vuelve a verle al Bastión Señor del Trueno, en las Montañas Filospada cuando hayas completado la tarea.‡‡Tuez 30 Ogres de la Masse-Sanglante à l\'Avant-poste de la Masse sanglante.‡托查克·双爪命令你消灭血槌哨站内的任意30个血槌食人魔。任务完成后返回刀锋山的雷神要塞向他复命。‡吐查克·雙爪要你在血槌前哨站殺死30個血槌巨魔。任務完成時回到劍刃山脈的雷霆王村向他回報。',
  }
},
[10506] = {
  {
    'Uma situação hedionda‡Тяжелая ситуация‡Eine düstere Lage‡절박한 상황‡Una situación extrema‡Una situación extrema‡Un redoutable problème‡严峻的形势‡情況緊迫',
    nil,
    'Use o Pó de Diminuição de Rina em 5 Lobos Hediondos Malho Sangrento, que podem ser encontrados no posto Malho Sangrento e no Barranco Malho Sangrento.‡Рина Лунный Родник хочет, чтобы вы взяли ее уменьшающий порошок и посыпали им 5 лютых волков клана Кровавого Молота, которых можно найти на заставе Кровавого Молота и в лощине Кровавого Молота. После этого вернитесь к ней в Сильванаар в Острогорье.‡Rina Mondquell möchte, dass Ihr ihr Schwächungspulver auf 5 Terrorwölfe der Blutschläger im Außenposten der Blutschläger in der Blutschlägerklamm streut. Kehrt danach zu ihr in Sylvanaar im Schergrat zurück.‡피망치 전초기지와 피망치 협곡에 있는 광포한 피망치 늑대 5마리에게 리나의 약화 가루를 뿌려야 합니다.‡Rina Lunabril quiere que te lleves sus polvos de disminución y se los apliques a 5 de los lobos temibles Machacasangre, que se pueden encontrar en la Avanzada Machacasangre y en el Barranco Machacasangre.‡‡Appliquez la Poudre diminutive de Rina pour rapetisser 5 Loups redoutables de la Masse-Sanglante, à l\'Avant-poste Masse-Sanglante et dans le Ravin de Masse-Sanglante.‡莉娜·月泉要求你对血槌哨站和血槌峡谷内的5只血槌巨狼使用莉娜的缩小粉尘。完成之后回到刀锋山的希尔瓦纳向她复命。‡琳娜·月泉要你帶著她的縮小粉末並使用在5隻血槌恐狼身上，你可以在血槌前哨站及血槌深谷找到這些狼群。完成後，回到劍刃山脈的希爾瓦納找她。',
  }
},
[10507] = {
  {
    'Virada‡Поворотная точка‡Der Wendepunkt‡전세 역전‡Punto de inflexión‡Punto de inflexión‡Un moment décisif‡转折点‡轉捩點',
    nil,
    'Use a Pedra Teleportadora de Socrethar no Ponto de Invasão: Lorde supremo, ao norte da Base-forja: Oblívio para levar seu grupo ao Porto de Socrethar. Uma vez lá, use a Presença de Voren\'thal para derrotar Socrethar.nnCumprir missões para os Áugures fará com que a sua reputação entre os Aldor diminua.‡Используйте камень телепортации Сокретара в точке вторжения: Властитель к северу от базы Легиона: Забвение, чтобы перенести свой отряд в лагерь Сокретара. Оказавшись там, используйте "Присутствие Ворен\'таля", чтобы победить Сокретара. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Benutzt Socrethars Teleportationsstein beim Invasionspunkt: Oberanführer im Norden der Konstruktionsbasis: Vergessenheit, um Eure Gruppe zu Socrethars Sitz zu bringen. Wenn Ihr dort seid, benutzt Voren\'thals Präsenz, um Socrethar zu besiegen.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡대군주의 침공 거점, 망각의 괴철로 주둔지에서 소크레타르의 순간이동의 돌을 사용한 후에 북쪽에 있는 소크레타르의 옥좌로 간 후, 보렌살의 현신을 사용하여 소크레타르를 처치해야 합니다.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 평판이 떨어질 것입니다.‡Usa la piedra de teletransporte de Socrethar en el Punto de Invasión: Señor Supremo, al norte de la Base Forja: Olvido, para transportar a tu grupo hasta el Embarcadero de Socrethar. Una vez allí, utiliza la Presencia de Voren\'thal para vencer a Socrethar.nnLlevar a cabo misiones para los Arúspices hará que tu reputación Aldor disminuya.‡Usa la piedra de teletransporte de Socrethar en el Punto de Invasión: Señor Supremo, al norte de la Base Forja: Olvido, para transportar a tu grupo hasta el Embarcadero de Socrethar. Una vez allí, utiliza la Presencia de Voren\'thal para vencer a Socrethar.|n|nLlevar a cabo misiones para los Arúspices hará que tu reputación Aldor disminuya.‡Utilisez la Pierre de téléportation de Socrethar au site d\'invasion Suzerain, au nord de la Base de forge Oubli pour transporter votre groupe jusqu\'à l\'aire de Socrethar. Une fois là-bas, utilisez la Présence de Voren\'thal pour vaincre Socrethar.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡前往位于铸魔基地：湮灭以北的登陆场：霸王，使用索克雷萨的传送石将你的小队传送到索克雷萨之座。利用沃雷塔尔的宝珠击败索克雷萨。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡在熔爐基地:遺忘的北邊的侵略點:主宰者使用索奎薩爾的傳送石，傳送你的隊伍到索奎薩爾的平臺。到達之後，使用沃藍索的禮物擊敗索奎薩爾。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10508] = {
  {
    'O presente de Voren\'thal‡Дар для Ворен\'таля‡Ein Geschenk für Voren\'thal‡보렌살을 위한 선물‡Un regalo para Voren\'thal‡Un regalo para Voren\'thal‡Un cadeau pour Voren\'thal‡给沃雷塔尔的礼物‡給沃藍索的禮物',
    nil,
    'O Mestre Espião Thalodien, na Área 52, quer que você obtenha a Primeira Metade da Pedra de Socrethar do Mestre Forjador Morug, na Base-forja: Oblívio e a Segunda Metade da Pedra de Socrethar de Silroth, na Base-forja: Geena.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Патрон шпионов Талодиен, находящийся в Зоне 52, просит вас забрать первую половину камня Сокретара у начальника кузни Моруга с базы Легиона: Забвение и вторую половину камня Сокретара у Силрота с базы Легиона: Геенна. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Spionagemeister Thalodien in Area 52 möchte, dass Ihr die erste Hälfte von Socrethars Stein von Konstruktionsmeister Morug in der Konstruktionsbasis: Vergessenheit und die zweite Hälfte des Steins von Konstruktionsmeister Silroth in der Konstruktionsbasis: Gehenna besorgt.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 첩보단장 탈로디엔이 망각의 괴철로 주둔지에 있는 괴철로감독관 모루그로부터 소크레타르의 돌 첫 번째 반쪽을 입수하고 지옥의 괴철로 주둔지에 있는 실로스에게 소크레타르의 돌 두 번째 반쪽을 입수해 달라고 부탁했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판이 떨어질 것입니다.‡El maestro de espías Thalodien, del Área 52, quiere que consigas la primera mitad de la piedra de Socrethar del maestro de forja Morug, en la Base Forja: Olvido, y la segunda mitad de la piedra de Socrethar del maestro de Silroth, en la Base Forja: Gehenna.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡El maestro de espías Thalodien, del Área 52, quiere que consigas la primera mitad de la piedra de Socrethar del maestro de forja Morug, en la Base Forja: Olvido, y la segunda mitad de la piedra de Socrethar del maestro de Silroth, en la Base Forja: Gehenna.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Le maître-espion Thalodien de la Zone 52 veut que vous vous procuriez la Première moitié de la pierre de Socrethar auprès du maître-forge Morug à la base de forge Oubli, et la Seconde moitié de la pierre de Socrethar auprès de Silroth à la base de forge Géhenne.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡52区的间谍大师萨罗迪恩要你从铸魔基地：湮灭的熔炉主管莫鲁格手中夺得索克雷萨之石的上半部，并从铸魔基地：炼狱的希尔洛斯手中夺得索克雷萨之石的下半部。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡52區的間諜大師薩洛迪恩要你從熔爐基地:遺忘的鍛造大師莫爾洛克身上取得上部索奎薩爾之石，從熔爐基地:苦難的希洛斯身上取得下部索奎薩爾之石。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10509] = {
  {
    'Destinado à glória‡И все ради славы‡Für Ruhm bestimmt‡영광을 향한 질주‡Destinado a la gloria‡Destinado a la gloria‡En route pour la gloire‡无上的荣耀‡前往光榮',
    nil,
    'Leve a Pedra teleportadora de Socrethar a Voren\'thal, o Vidente, no Terraço dos Áugures, em Shattrath.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Отнесите камень телепортации Сокретара Ворен\'талю Предсказателю на ярус Провидцев в Шаттрате. nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Bringt Socrethars Teleportationsstein zu Voren\'thal dem Seher auf der Sehertreppe in Shattrath.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡샤트라스의 점술가 언덕에 있는 현자 보렌살에게 소크레타르의 순간이동의 돌을 가져가야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 당신의 평판이 떨어질 것입니다.‡Lleva la piedra de teletransporte de Socrethar a Voren\'thal el Vidente, en la Grada del Arúspice, de la Ciudad de Shattrath.nnLlevar a cabo misiones para los Arúspices hará que tu reputación Aldor disminuya.‡Lleva la piedra de teletransporte de Socrethar a Voren\'thal el Vidente, en la Grada del Arúspice, de la Ciudad de Shattrath.|n|nLlevar a cabo misiones para los Arúspices hará que tu reputación Aldor disminuya.‡Apportez la Pierre de téléportation de Socrethar à Voren\'thal le Voyant sur le Degré des Clairvoyants à Shattrath.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡将索克雷萨的传送石交给沙塔斯城占星者之台的先知沃雷塔尔。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡帶著索奎薩爾的傳送石到撒塔斯城的占卜者階梯給『先知』沃藍索。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10510] = {
  {
    'Para a Mina de Draenetista‡В дренетистовые копи‡In die Draenethystmine‡드레니시스트 광산‡En el interior de la Mina Draenetista‡En el interior de la Mina Draenetista‡Dans la mine de draenéthyste‡进入德拉诺晶矿‡進入德萊尼礦坑',
    nil,
    'Colete 5 Cristais da Mina de Draenetista.‡Бронвин Твердомолот просит вас принести 5 кристаллов из дренетистовых копей и вернуться к ней в Сильванаар в Острогорье.‡Bronwyn Starkhammer bittet Euch, 5 Kristalle der Draenethystmine zu sammeln. Kehrt danach zu ihr in Sylvanaar im Schergrat zurück.‡드레니시스트 광산 수정 5개를 수집한 후에 칼날 산맥의 실바나르에 있는 브론윈 스타우트해머에게 돌아가야 합니다.‡Bronwyn Martillotenaz te ha pedido que consigas 5 cristales de la Mina Draenetista y después se los lleves a Sylvanaar en las Montañas Filospada.‡‡Bronwyn Rudemartel vous a demandé de collecter 5 Cristaux de mine de draenéthyste puis de retourner la voir à Sylvanaar dans les Tranchantes.‡刀锋山希尔瓦纳的布隆薇·硬锤要求你帮她收集5块德拉诺矿洞水晶。‡波爾葛利姆·頑錘要你去收集5個德萊尼礦坑水晶然後回到劍刃山脈的希爾瓦納找她。',
  }
},
[10511] = {
  {
    'Banebruto é uma enorme cerveja!‡Странное пиво‡Merkwürdiges Gebräu‡이상한 맥주‡Una extraña cerveza‡Una extraña cerveza‡Une étrange bière‡奇怪的美酒‡怪酒',
    nil,
    'Colete 11 Cervejas Banebruto dos Malho Sangrento.‡Боргрим Твердомолот просит вас добыть ему 11 бочонков забористого пойла клана Кровавого Молота. По выполнении вернитесь к нему в Сильванаар в Острогорье.‡Borgrim Starkhammer möchte, dass Ihr 11 Einheiten von Blutschlägers Hauweggebräu besorgt. Wenn Ihr fertig seid, kehrt zu ihm in Sylvanaar im Schergrat zurück.‡피망치 투사잡이 특별주 11개를 조달하여 칼날 산맥의 실바나르에 있는 보르그림 스타우트해머에게 돌아가야 합니다.‡Borgrim Martillotenaz quiere que consigas 11 cervezas Machacasangre aterrabrutos para él. Cuando lo hayas hecho, regresa junto a él en Sylvanaar, en las Montañas Filospada.‡‡Borgrim Rudemartel veut que vous vous procuriez 11 Foudroyantes-des-brutes de la Masse-sanglante pour lui. Lorsque ce sera fait, retournez le voir à Sylvanaar dans les Tranchantes.‡希尔瓦纳的伯格瑞姆·硬锤要求你帮他收集11桶血槌烈酒。‡波爾葛利姆·頑槌要你拿到11瓶血槌蠻禁烈酒給他。一旦你完成後，將這個帶到劍刃山脈的希爾瓦納給他。',
  }
},
[10512] = {
  {
    'Boa noite, Giralança‡Пусть Камнероги упьются!‡Die Speerspießer abfüllen‡칼날첨탑 오우거 만취시키기‡Repostando Aguja del Filo‡Repostando Aguja del Filo‡Pinter les Flèchelame‡灌醉刀塔食人魔‡灌醉劍刃巨魔',
    nil,
    'Use o Barril de Cerveja Banebruto dos Malho Sangrento para tentar embebedar 5 Ogros Giralança.‡Возьмите бочонок забористого пойла клана Кровавого Молота и попытайтесь напоить допьяна 5 огров из клана Камнерогов. Если получится, вернитесь к Боргриму в Сильванаар в Острогорье.‡Nehmt Blutschlägers Hauweggebräu und versucht 5 Oger der Speerspießer damit betrunken zu machen. Meldet Euch bei Borgrim in Sylvanaar im Schergrat zurück, wenn Ihr erfolgreich wart.‡피망치 투사잡이 술통을 칼날첨탑 오우거 5마리에게 사용하여 그들을 만취시켜야 합니다.‡Utiliza el barril de Machacasangre aterrabrutos para intentar emborrachar a 5 ogros Aguja del Filo.‡‡Utilisez le Tonneau de foudroyante-des-brutes de la Masse-Sanglante pour tenter d\'enivrer 5 Ogres de Flèchelame.‡用血槌酒桶将5个刀塔食人魔灌醉，成功之后向刀锋山希尔瓦纳的伯格瑞姆复命。‡帶著這個血槌蠻禁烈酒並試著用來讓5個劍刃巨魔喝醉。如果你成功了，回到劍刃山脈的希爾瓦納找波爾葛利姆。',
  }
},
[10513] = {
  {
    'Oronok Coração-partido‡Оронок Горемычный‡Oronok Herzeleid‡비통의 오로노크‡Oronok Corazón Roto‡Oronok Corazón Roto‡Oronok Cœur-fendu‡欧鲁诺克-裂心‡歐朗諾克·碎心',
    nil,
    'Procure Oronok Coração-partido na Plataforma Estilhaçada, ao norte da Cisterna Serpentálios.‡Найдите Оронока Горемычного на Разрушенной Отмели, на северном берегу водохранилища Змеиных Колец.‡Sucht Oronok Herzeleid auf dem zerschlagenen Vorsprung nördlich der Zisterne der Echsennarbe.‡갈퀴흉터 저수지 북쪽에 있는 융기한 지대 위에서 비통의 오로노크를 찾아야 합니다.‡Busca a Oronok Corazón Roto en la Barrera Arrasada - al norte de la Cisterna Cicatriz Espiral.|n‡Busca a Oronok Corazón Roto en la Barrera Arrasada – al norte de la Cisterna Cicatriz Espiral.|n‡Partez à la recherche d’Oronok Cœur-fendu sur la Saillie brisée, au nord de la Citerne de Glissentaille.‡前往库斯卡水池北边的破碎岩床寻找欧鲁诺克-裂心。‡到破碎暗礁去找歐朗諾克·碎心 - 就在考斯卡水池的北方。',
  }
},
[10514] = {
  {
    'Eu fui muitas coisas...‡Кем только я не был...‡Ich war schon vieles...‡과거는 과거일 뿐...‡Yo era muchas cosas...‡Yo era muchas cosas...‡J\'ai tenu bien des rôles…‡历经沧桑......‡我經歷過很多事……',
    nil,
    'Oronok Coração-partido na Fazenda de Oronok, que fica no Vale da Lua Negra, quer que você recolha 10 Tubérculos Lua Negra no Platô Despedaçado.nnEle também quer o Apito de Javali de Oronok de volta quando você terminar.‡Принесите 10 клубней долины Призрачной Луны с Разоренных равнин Ороноку Горемычному на его ферму.nnЕму также необходимо вернуть его свисток.‡Oronok Herzeleid bei Oronoks Hof im Schattenmondtal möchte, dass Ihr 10 Schattenmondknollen aus den zerschlagenen Weiten besorgt.nnBringt Oronoks Eberpfeife zu ihm zurück, wenn Ihr fertig seid.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크가 부서진 평원에서 어둠달 덩이줄기 10개를 캐달라고 했습니다.nn또한, 일을 마치면 사용한 오로노크의 멧돼지 호루라기를 돌려달라고도 했습니다.‡Oronok Corazón Roto, de la Granja de Oronok, en el Valle Sombraluna, quiere que recuperes diez tubérculos de Sombraluna de las Llanuras Devastadas.nnTambién quiere que le devuelvas el silbato de jabalíes de Oronok cuando hayas terminado.‡Oronok Corazón Roto, de la Granja de Oronok, en el Valle Sombraluna, quiere que recuperes diez tubérculos de Sombraluna de las Llanuras Devastadas.|n|nTambién quiere que le devuelvas el silbato de jabalíes de Oronok cuando hayas terminado.‡Oronok Cœur-fendu, à la Ferme d\'Oronok dans la vallée d\'Ombrelune, veut que vous ramassiez 10 Tubercules d\'Ombrelune dans les Plaines brisées.nnIl vous demande aussi de rapporter le Sifflet à sanglier d\'Oronok lorsque vous aurez terminé.‡影月谷欧鲁诺克农场的欧鲁诺克-裂心要你在破碎平原收集10个影月块茎。nn任务完成后把欧鲁诺克的野猪哨一并归还给他。‡影月谷內歐朗諾克的農場的歐朗諾克·碎心要你去破碎平原取回10個影月塊莖。|n他也要你在完成任務後將歐朗諾克的野豬哨帶回來。',
  }
},
[10515] = {
  {
    'Dê uma lição‡Усвоенный урок‡Eine Lektion gelernt‡본때 보여주기‡Una lección aprendida‡Una lección aprendida‡Une leçon bien apprise‡严厉的教训‡學到一課',
    nil,
    'Oronok Coração-partido na Fazenda de Oronok, no Vale da Lua Negra, quer que você destrua 10 Ovos de Esfola-pedra Vorasga no Platô Despedaçado.‡Уничтожьте 10 яиц прожорливого камнедера на Разоренных равнинах для Оронока Горемычного.‡Oronok Herzeleid bei Oronoks Hof im Schattenmondtal möchte, dass Ihr 10 Eier eines gefräßigen Schinders in den zerschlagenen Weiten zerstört.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크가 부서진 평원에 있는 걸신들린 바위갈퀴 알 10개를 파괴해 달라고 했습니다.‡Oronok Corazón Roto, de la Granja de Oronok, en el Valle Sombraluna, quiere que destruyas diez huevos de despellejador voraz de las Llanuras Devastadas.‡Oronok Corazón Roto, de la Granja de Oronok, en el Valle Sombraluna, quiere que destruyas diez huevos de despellejador voraz de las Llanuras Devastadas.‡Oronok Cœur-fendu, à la Ferme d\'Oronok dans la vallée d\'Ombrelune, veut que vous détruisiez 10 Œufs d\'écorcheurs voraces dans les Plaines brisées.‡返回破碎平原，摧毁10枚贪婪剥石者的卵，然后向影月谷欧鲁诺克农场的欧鲁诺克-裂心复命。‡影月谷內歐朗諾克的農場的歐朗諾克·碎心要你去破碎平原破壞10個掠食鐮奪怪的蛋。',
  }
},
[10516] = {
  {
    'Paramentos de uma vindicante‡Вещи Поборницы‡Die Gefangenschaft der Verteidigerin‡구원자의 장비‡Las armas de un vindicador‡Las armas de un vindicador‡Les atours d\'un redresseur de torts‡守备官的困境‡復仇者的服飾',
    nil,
    'Recupere a Lâmina da Vindicante Vuuleen e o Escudo da Vindicante Vuuleen.‡Добудьте клинок и щит воздаятельницы Вуулины. Затем вернитесь к воздаятельнице Вуулине в форт Камнерогов в Острогорье.‡Holt Verteidigerin Vuuleens Klinge und Verteidigerin Vuuleens Schild zurück. Kehrt dann zu Verteidigerin Vuuleen in der Wehr der Speerspießer im Schergrat zurück.‡구원자 불린의 검과 구원자 불린의 방패를 되찾은 후 칼날 산맥의 칼날첨탑 요새에 있는 구원자 불린에게 돌려주어야 합니다.‡Recupera la espada y el escudo de la vindicadora Vuuleen. Después regresa junto a ella en el Bastión Aguja del Filo, en las Montañas Filospada.‡‡Récupérez la Lame du redresseur de torts Vuuleen et le Bouclier du redresseur de torts Vuuleen. Rapportez-les au redresseur de torts Vuuleen au bastion de Flèchelame dans les Tranchantes.‡夺回守备官乌里恩之剑和守备官乌里恩之盾，将它们交给刀塔要塞的守备官乌里恩。‡帶回復仇者瓦黎恩之刃及復仇者瓦黎恩之盾。然後將這兩項物品帶回劍刃山脈的劍刃要塞給復仇者瓦黎恩。',
  }
},
[10517] = {
  {
    'A Luz não gosta de Gorr\'dim, não!‡Горр\'Дим, твой час пробил...‡Eure Zeit ist gekommen, Gorr\'Dim...‡고르딤의 최후‡Gorr\'Lelo, ha llegado tu hora...‡Gorr\'Lelo, ha llegado tu hora...‡Gorr\'niaud, ton heure est venue...‡高尔迪姆，你完蛋了......‡哥爾迪姆，你的死期到了……',
    nil,
    'Mate Gorr\'dim, líder dos ogros do Bastião Giralança.‡Воздаятельница Вуулина просит вас убить Горр\'Дима, вождя огров из форта Камнерогов. По выполнении вернитесь к ней в форт Камнерогов в Острогорье.‡Verteidigerin Vuuleen bittet Euch, Gorr\'Dim, den Anführer der Oger bei der Wehr der Speerspießer, zu töten. Wenn Ihr fertig seid, kehrt zu Ihr in der Wehr der Speerspießer im Schergrat zurück.‡칼날첨탑 요새 오우거들의 지휘관인 고르딤을 처치해야 합니다.‡Mata a Gorr\'Lelo, líder de los ogros del Bastión Aguja del Filo.‡‡Tuez Gorr\'niaud, chef des Ogres du bastion de Flèchelame.‡守备官乌里恩要求你杀死刀塔要塞内的食人魔头目高尔迪姆。完成这个任务之后，向刀塔要塞的守备官乌里恩复命。‡復仇者瓦黎恩要你去殺掉哥爾迪姆，劍刃要塞巨魔的首領。一旦完成後，回到劍刃山脈的尖石要塞找她。',
  }
},
[10518] = {
  {
    'Bandeira da discórdia‡Водружение знамени‡Das Banner aufstellen‡칼날첨탑 깃발 꽂기‡Clavar el estandarte‡Clavar el estandarte‡Planter la bannière‡插旗子‡插上戰旗',
    nil,
    'Use o Estandarte Giralança no topo da Torre Martelo do Norte para atrair Gurn Rangalarva. Entregue o estandarte e o Elmo de Gurn Rangalarva ao Comandante Caelumbra em Sylvanaar, nas Montanhas da Lâmina Afiada.‡Водрузите знамя Камнерогов на башне Северного молота, чтобы раздразнить Гурна Обжору. Принесите знамя и шлем Гурна Обжоры командиру Тень Небес в Сильванаар в Острогорье.‡Benutzt das Banner der Speerspießer auf dem Nordschlägerturm, um Gurn Grubnosh anzulocken. Bringt das Banner und Gurn Grubnoshs Helm zu Kommandant Himmelsschatten in Sylvanaar im Schergrat.‡북녘망치 탑 꼭대기에 칼날첨탑 일족 깃발을 사용해서 구른 그룹노쉬를 유인해야 합니다. 칼날 산맥의 실바나르에 있는 사령관 스카이섀도에게 칼날첨탑 일족 깃발과 구른 그룹노쉬의 투구를 가져가야 합니다.‡Usa el estandarte de los Aguja del Filo sobre la Torre Quiebranorte para engañar a Gurn Jalazampa. Entrégale el estandarte y el yelmo de Gurn Jalazampa al comandante Cielosombra en Sylvanaar, en las Montañas Filospada.‡‡Utilisez la Bannière de Flèchelame au sommet de la Tour Nord-sanglante pour attirer Babin Graillebâfre. Récupérez la Bannière du clan Flèchelame et le Heaume de Babin Graillebâfre.‡在北槌哨塔顶上使用刀塔旗帜，引出古恩·格鲁诺什。然后将旗帜和古恩·格鲁诺什的头盔一起交给刀锋山希尔瓦纳的指挥官萨卡斯·天影。‡在北槌哨塔頂端使用劍刃旗幟來誘引葛恩·葛羅巴諾斯。將旗幟跟葛恩·葛羅巴諾斯的頭盔送到劍刃山脈的希爾瓦納給指揮官天影。',
  }
},
[10519] = {
  {
    'A Cifra da Danação: verdade e história‡Код Проклятия – правда и миф‡Die Litanei der Verdammnis - Wahrheit und Geschichte‡파멸의 암호 - 진실과 역사‡La Clave de Condenación: historia y verdad‡La Clave de Condenación: historia y verdad‡La Formule de damnation - vérité et histoire‡诅咒密码 - 真相和历史‡毀滅密碼 - 歷史與真相',
    nil,
    'Oronok Coração-partido na Fazenda de Oronok, no Vale da Lua Negra, quer que você escute a história dele. Fale com Oronok para começar a ouvir a história.‡Поговорите с Ороноком Горемычным на его ферме и выслушайте историю, которую он вам поведает.‡Oronok Herzeleid bei Oronoks Hof im Schattenmondtal möchte, dass Ihr Euch seine Geschichte anhört. Sprecht mit Oronok, um ihm zusagen, dass er mit der Geschichte beginnen kann.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크가 그의 이야기를 들어달라고 했습니다. 그에게 다시 말을 걸면 이야기를 들을 수 있습니다.‡Oronok Corazón Roto, en la Granja de Oronok del Valle Sombraluna, quiere que escuches su relato. Habla con Oronok para comenzar a escuchar su relato.‡Oronok Corazón Roto, en la Granja de Oronok del Valle Sombraluna, quiere que escuches su relato. Habla con Oronok para comenzar a escuchar su relato.‡Oronok Cœur-fendu à la ferme d\'Oronok dans la vallée d\'Ombrelune veut que vous écoutiez son histoire. Parlez à Oronok pour commencer à écouter son histoire.‡影月谷欧鲁诺克农场的欧鲁诺克-裂心要你听听他的故事。跟欧鲁诺克谈谈，听这位年老的兽人讲述他的故事。‡影月谷裡歐朗諾克的農場的歐朗諾克·碎心要你聆聽他的故事。',
  }
},
[10520] = {
  {
    'Assisting Arch Druid Staghelm‡Помощь верховному друиду Оленьему Шлему‡Erzdruide Hirschhaupt helfen‡대드루이드 스테그헬름 지원‡Ayuda al archidruida Corzocelada‡Ayuda al archidruida Corzocelada‡L\'aide à l\'archidruide Forteramure‡协助大德鲁伊‡協助大德魯伊鹿盔',
    nil,
    'Speak with Arch Druid Fandral Staghelm in Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнассе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Ve a Darnassus y habla con el archidruida Fandral Corzocelada.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[10521] = {
  {
    'Grom\'tor, filho de Oronok‡Гром\'тор, сын Оронока‡Grom\'tor, Sohn von Oronok‡오로노크의 아들 그롬토르‡Grom\'tor, hijo de Oronok‡Grom\'tor, hijo de Oronok‡Grom\'tor, fils d\'Oronok‡格洛姆托，欧鲁诺克之子‡葛洛姆特,歐朗諾克之子',
    nil,
    'Encontre Grom\'tor, filho de Oronok, no Pontal dos Serpentálios, no Vale da Lua Negra.‡Найдите Гром\'тора сына Оронока в лагере Змеиных Колец в долине Призрачной Луны.‡Sucht Grom\'tor, Sohn von Oronok in der Echsennarbe im Schattenmondtal.‡어둠달 골짜기의 갈퀴흉터 거점에서 오로노크의 아들 그롬토르를 찾아야 합니다.‡Encuentra a Grom\'tor, hijo de Oronok, en el Alto Cicatriz Espiral del Valle Sombraluna.‡Encuentra a Grom\'tor, hijo de Oronok, en el Alto Cicatriz Espiral del Valle Sombraluna.‡Trouvez Grom\'tor, fils d\'Oronok à la Halte de Glissentaille dans la vallée d\'Ombrelune.‡前往影月谷的库斯卡岗哨寻找格洛姆托，欧鲁诺克之子。‡在影月谷的考斯卡崗哨找到葛洛姆特,歐朗諾克之子。',
  }
},
[10522] = {
  {
    'A Cifra da Danação: a carga de Grom\'tor‡Код Проклятия: Вклад Гром\'тора‡Die Litanei der Verdammnis - Grom\'tors Angriff‡파멸의 암호 - 그롬토르의 임무‡La Clave de Condenación: La carga de Grom\'tor‡La Clave de Condenación: La carga de Grom\'tor‡La Formule de damnation - la charge de Grom\'tor‡诅咒密码 - 格洛姆托的命令‡毀滅密碼 - 葛洛姆特的命令',
    nil,
    'Grom\'tor, Filho de Oronok, no Pontal dos Serpentálios, no Vale da Lua Negra, quer que você recupere o Primeiro Fragmento da Cifra da Danação.‡Найдите первый фрагмент Кода Проклятия для Гром\'тора, сына Оронока из лагеря Змеиных Колец в долине Призрачной Луны.‡Grom\'tor, Sohn von Oronok, in der Echsennarbe im Schattenmondtal möchte, dass Ihr den ersten Teil der Litanei der Verdammnis besorgt.‡어둠달 골짜기의 갈퀴흉터 거점에 있는 오로노크의 아들 그롬토르가 첫 번째 파멸의 암호 조각을 가져오라고 했습니다.‡Grom\'tor, hijo de Oronok, en el Alto Cicatriz Espiral del Valle Sombraluna, quiere que recuperes el primer fragmento de la Clave de Condenación.‡Grom\'tor, hijo de Oronok, en el Alto Cicatriz Espiral del Valle Sombraluna, quiere que recuperes el primer fragmento de la Clave de Condenación.‡Grom\'tor, fils d\'Oronok, de la Halte de Glissentaille dans la vallée d\'Ombrelune, veut que vous récupériez le Premier fragment de la Formule de damnation.‡取回诅咒密码的第一块碎片，然后向影月谷库斯卡岗哨的欧鲁诺克之子格洛姆托复命。‡在影月谷考斯卡崗哨的葛洛姆特,　歐朗諾克之子要你奪回毀滅密碼第一部。',
  }
},
[10523] = {
  {
    'A Cifra da Danação: primeiro fragmento recuperado‡Код Проклятия: Первый Фрагмент‡Die Litanei der Verdammnis - Erster Teil‡파멸의 암호 - 첫 번째 조각 입수‡La Clave de Condenación - Primer trozo recuperado‡La Clave de Condenación - Primer trozo recuperado‡La Formule de damnation - Premier fragment retrouvé‡诅咒密码 - 第一块碎片‡毀滅密碼 - 取回第一部',
    nil,
    'Leve a Caixa-forte de Grom\'tor para Oronok Coração-partido na Fazenda de Oronok, no Vale da Lua Negra.‡Принесите Сейф Гром\'тора Ороноку Горемычному на ферму Оронока в Долине Призрачной Луны.‡Bringt Grom\'tors Schließkassette zu Oronok Herzeleid bei Oronoks Hof im Schattenmondtal.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크에게 그롬토르의 금고를 가져가야 합니다.‡Lleva la caja fuerte de Grom\'tor a Oronok Corazón Roto en la Granja de Oronok, en el Valle Sombraluna.‡Lleva la caja fuerte de Grom\'tor a Oronok Corazón Roto en la Granja de Oronok, en el Valle Sombraluna.‡Apportez le coffret de Grom\'tor à Oronok Cœur-fendu à la Ferme d\'Oronok dans la vallée d\'Ombrelune.‡将格洛姆托的箱子交给影月谷欧鲁诺克农场的欧鲁诺克-裂心。‡帶著葛洛姆特的帶鎖箱到影月谷的歐朗諾克的農場給歐朗諾克·碎心。',
  }
},
[10524] = {
  {
    'Artefatos do clã Senhor do Trovão‡Сокровища клана Громоборцев‡Artefakte der Donnerfürsten‡천둥군주 부족 유물‡Artefactos del clan Señor del Trueno‡Artefactos del clan Señor del Trueno‡Artefacts du clan Sire-tonnerre‡雷神氏族的神器‡雷霆王氏族手工藝品',
    nil,
    'Colete o Tambor do Clã Senhor do Trovão, a Flecha do Clã Senhor do Trovão e a Tabuleta do Clã Senhor do Trovão.‡Добудьте барабан клана Громоборцев, стрелу клана Громоборцев и табличку клана Громоборцев. Принесите их вместе с артефактом клана Громоборцев Рокге Живоглотке в оплот Громоборцев в Острогорье.‡Beschafft die Trommel der Donnerfürsten, den Pfeil der Donnerfürsten und die Schrifttafel der Donnerfürsten. Bringt sie zusammen mit dem Artefakt der Donnerfürsten zu Rokgah Blutgriff in der Donnerfeste im Schergrat.‡천둥군주 부족 북, 천둥군주 부족 화살, 천둥군주 부족 서판을 회수해야 합니다. 천둥군주 부족 유물과 함께 칼날 산맥의 천둥군주 요새에 있는 로크가 블러드그립에게 가져가십시오.‡Recupera el tambor del clan Señor Trueno, la flecha del clan del Señor Trueno, y la tablilla del clan Señor del Trueno. Devuélveselas, junto con el artefacto del clan del Señor del Trueno, a Rokgah Presasangre, en el Bastión Señor del Trueno, en las Montañas Filospada.‡‡Récupérez le Tambour du clan Sire-tonnerre, la Flèche du clan Sire-tonnerre et la Tablette du clan Sire-tonnerre. Rapportez-les avec l\'Artefact du clan Sire-tonnerre à Rokgah Poigne-sang au bastion des Sire-tonnerre dans les Tranchantes.‡找回雷神氏族战鼓、雷神氏族箭矢和雷神氏族石板。找到这些东西后，将它们和雷神氏族神器一起交给刀锋山雷神要塞的洛克加·血握。‡取回雷霆王氏族大鼓，雷霆王氏族之箭以及雷霆王氏族石板。將它們隨同雷霆王氏族手工藝品一起帶回，交給劍刃山脈雷霆王村的洛克嘎·血握。',
  }
},
[10525] = {
  {
    'Guia de visão‡Путеводный огонек‡Wegweisende Visionen‡환영의 길잡이‡Visión guía‡Visión guía‡Guide de vision‡幻像的指引‡幻象導覽',
    nil,
    'Use o Fragmento de Alma do Fogo para transformar seu espírito em um guia de visão para revelar a localização do último artefato dos Senhor do Trovão.‡При помощи фрагмента пылающей души превратите свой дух в путеводное видение. Поговорите с Рокгой Живоглоткой в оплоте Громоборцев после того. Как видение приведет вас туда, где находится последнее сокровище клана Громоборцев.‡Benutzt das feurige Seelenfragment, um Euren Geist in eine wegweisende Vision zu versetzen. Sprecht mit Rokgah Blutgriff in der Donnerfeste, nachdem Euch die Vision zum Aufenthaltsort des letzten Artefakts der Donnerfürsten geführt hat.‡불타는 영혼 조각을 사용하여 당신의 영혼을 환영의 길잡이로 바꾸어야 합니다. 환영이 마지막 천둥군주 유물의 위치를 알려주면 천둥군주 요새의 로크가 블러드그립과 대화하십시오.‡Usa el fragmento de alma ígnea para transformar tu espíritu en una visión guía. Habla con Rokgah Presasangre, del Bastión Señor del Trueno, después de que tu visión te haya guiado a la ubicación de la última reliquia del Señor del Trueno.‡‡Utilisez le Fragment d\'âme flamboyante pour transformer votre esprit en un guide de vision qui vous dévoilera la position de la dernière relique Sire-tonnerre.‡利用炽热灵魂碎块将你的灵魂转变为指引你方向的幻像。当你找到最后一个雷神圣物的位置后，与雷神要塞的洛克加·血握谈一谈。‡使用熾熱之魂碎片將你的靈魂轉化成幻象導覽模式。在你的幻象導覽帶領你找到最後一個雷霆王神器的所在地後，與雷霆王村的洛克嘎·血握談談。',
  }
},
[10526] = {
  {
    'A Lança do Trovão‡Громовая пика‡Die Donnerlanze‡천둥창‡La Punta de Trueno‡La Punta de Trueno‡La Pointe du tonnerre‡雷霆之刺‡雷霆之矛',
    nil,
    'Colete a Lança do Trovão.‡Рокга Живоглотка дала вам поручение добыть громовую пику. Принесите пику ей в оплот Громоборцев в Острогорье.‡Rokgah Blutgriff möchte, dass Ihr die Donnerlanze zurückholt. Bringt sie zu ihr in der Donnerfeste im Schergrat zurück.‡천둥창을 회수하여 칼날 산맥의 천둥군주 요새에 있는 로크가 블러드그립에게 가져가야 합니다.‡Rokgah Presasangre te ha encomendado la tarea de recuperar la Punta de Trueno. Devuélvesela en el Bastión Señor del Trueno, en las Montañas Filospada.‡‡Récupérer la Pointe du tonnerre.‡洛克加·血握命令你找回雷霆之刺。找到后返回刀锋山的雷神要塞，将东西交给她。‡洛克嘎·血握派你去取回雷霆之矛。將它帶回劍刃山脈的雷霆王村給她。',
  }
},
[10527] = {
  {
    'Ar\'tor, filho de Oronok‡Ар\'тор, сын Оронока‡Ar\'tor, Sohn von Oronok‡오로노크의 아들 알토르‡Ar\'tor, hijo de Oronok‡Ar\'tor, hijo de Oronok‡Ar\'tor, fils d\'Oronok‡阿托尔，欧鲁诺克之子‡阿爾托,歐朗諾克之子',
    nil,
    'Encontre Ar\'tor, Filho de Oronok, no Pontal Illidari no Vale da Lua Negra.‡Найдите Ар\'тора, сына Оронока, на аванпосте иллидари в долине Призрачной Луны.‡Findet Ar\'tor, Sohn von Oronok, bei der Stätte der Illidari im Schattenmondtal.‡어둠달 골짜기의 일리다리 거점에서 오로노크의 아들 알토르를 찾아야 합니다.‡Encuentra a Ar\'tor, hijo de Oronok, en el Alto Illidari del Valle Sombraluna.‡Encuentra a Ar\'tor, hijo de Oronok, en el Alto Illidari del Valle Sombraluna.‡Trouvez Ar\'tor, fils d\'Oronok à la Halte Illidari dans la vallée d\'Ombrelune.‡前往影月谷的伊利达雷岗哨寻找阿托尔，欧鲁诺克之子。‡在影月谷的伊利達瑞崗哨找到阿爾托,歐朗諾克之子。',
  }
},
[10528] = {
  {
    'Prisões demoníacas de cristal‡Тюрьма из демонических кристаллов‡Dämonische Kristallgefängnisse‡악마의 수정 감옥‡Cárceles de cristal demoníacas‡Cárceles de cristal demoníacas‡Prisons de cristal démoniaque‡恶魔的水晶牢笼‡惡魔水晶監牢',
    nil,
    'Procure e mate a Rainha da Dor Gabrissa no Pontal Illidari. Em seguida, volte até o cadáver de Ar\'tor, Filho de Oronok, com a Chave Cristalina.‡На аванпосте иллидари разыщите и убейте госпожу боли Габриссу и вернитесь к телу Ар\'тора, сына Оронока, с хрустальным ключом.‡Sucht und tötet Schmerzensmeisterin Gabrissa in der Stätte der Illidari und kehrt mit dem kristallenen Schlüssel zum Leichnam von Ar\'tor, Sohn von Oronok, zurück.‡일리다리 거점에서 고통의 여왕 가브리사를 찾아서 처치하고 수정 열쇠를 가지고 오로노크의 아들 알토르의 주검이 있는 곳으로 가야 합니다.‡Busca a la maestra del dolor Gabrissa en el Alto Illidari, mátala y vuelve junto al cadáver de Ar\'tor, hijo de Oronok, con la llave cristalina.‡Busca a la maestra del dolor Gabrissa en el Alto Illidari, mátala y vuelve junto al cadáver de Ar\'tor, hijo de Oronok, con la llave cristalina.‡Trouvez la Maîtresse de la douleur Gabrissa à la Halte Illidari et tuez-la, puis rapportez le cadavre d\'Ar\'tor, fils d\'Oronok avec la Clé cristalline.‡杀死伊利达雷岗哨的痛苦女王加布莉萨，夺得晶体钥匙，然后返回欧鲁诺克之子阿托尔的尸体旁。‡在伊利達瑞崗哨找到並殺掉痛苦魔女卡布利莎，拿著結晶鑰匙回到阿爾托,歐朗諾克之子的屍體那。',
  }
},
[10529] = {
  {
    'The Hunter\'s Path‡Путь охотника‡Der Pfad des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com a Tenente Correalba no Retiro dos Andarilhos.‡Поговорите с лейтенантом Вестницей Рассвета в обители Странников.‡Sprecht mit Leutnant Dämmerflucht in der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너와 대화하십시오.‡Habla con la teniente Correalba en El Retiro del Errante.‡Habla con la teniente Correalba en El Retiro del Errante.‡Parlez au lieutenant Coursaurore à la retraite des Pérégrins.‡与远行者居所的达恩·晨行者中尉谈一谈。‡與遠行者居所的晨奔中尉談談。',
  }
},
[10530] = {
  {
    'The Hunter\'s Path‡Путь охотника‡Der Pfad des Jägers‡사냥꾼의 길‡El camino del cazador‡El camino del cazador‡La voie du chasseur‡猎人之道‡獵人之道',
    nil,
    'Fale com a Tenente Correalba no Retiro dos Andarilhos.‡Поговорите с лейтенантом Вестницей Рассвета в обители Странников.‡Sprecht mit Leutnant Dämmerflucht in der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너와 대화하십시오.‡Habla con la teniente Correalba en El Retiro del Errante.‡Habla con la teniente Correalba en El Retiro del Errante.‡Parlez au lieutenant Coursaurore à la retraite des Pérégrins.‡与远行者居所的达恩·晨行者中尉谈一谈。‡與遠行者居所的晨奔中尉談談。',
  }
},
[10531] = {
  {
    'The Battle for Arathi Basin!‡Битва за Низину Арати‡Die Schlacht um das Arathibecken!‡아라시 분지의 전투‡La batalla por la Cuenca de Arathi‡La batalla por la Cuenca de Arathi‡La bataille pour le bassin d\'Arathi !‡阿拉希盆地之战！‡阿拉希盆地之戰!',
    nil,
    'Assault the mine, the lumber mill, the blacksmith and the farm, then return to Field Marshal Oslight in Refuge Pointe.‡Нападите на рудник, лесопилку, кузницу и ферму и возвращайтесь к фельдмаршалу Освету в Опорный пункт.‡Erobert die Mine, das Sägewerk, die Schmiede und die Farm und meldet Euch anschließend bei Feldmarschall Lichtmark in der Zuflucht.‡금광, 제재소, 대장간, 그리고 농장을 공격한 후 임시 주둔지에 있는 야전사령관 오슬라이트에게 돌아가야 합니다.‡Asalta la mina, la serrería, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Asalta la mina, el aserradero, la herrería y la granja y vuelve entonces junto al mariscal de campo Uluz en el Refugio de la Zaga.‡Attaquez la mine, la scierie, la forge et la ferme, puis revenez voir le grand maréchal Oslight au Refuge de l\'Ornière.‡进攻矿洞、伐木场、铁匠铺和农场，然后向避难谷地的奥斯莱特元帅复命。‡進攻礦坑、伐木場、鐵匠鋪和農場，然後向避難谷地的奧斯萊特元帥覆命。',
  }
},
[10532] = {
  {
    'Quebra da rota de suprimentos de Arathor‡Перекрыть линии поставок Аратора‡Zerschlagt die Versorgungslinien Arathors‡아라소르 보급선 끊기‡Córtale el suministro a la Liga de Arathor‡Córtale el suministro a la Liga de Arathor‡Couper les voies de ravitaillement d\'Arathor‡切断阿拉索补给线‡切斷阿拉索補給線',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com o Sicário Mortis na Ruína do Martelo.‡Выиграйте битву за низину Арати, добудьте ящик с ресурсами из Арати и принесите его стражу смерти Мортису в Павший Молот.‡Entscheidet die Schlacht um das Arathibecken für Euch, erbeutet eine Arathivorratskiste und bringt sie Todespirscher Mortis in Hammerfall.‡아라시 분지 전투를 승리로 이끌고 아라시 보급품 상자를 구해 해머폴에 있는 죽음의추적자 몰티스에게 가져가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela a Mortacechador Mortis en Sentencia.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au nécrotraqueur Mortis au Trépas-d\'Orgrim.‡进入阿拉希盆地，获得一箱阿拉希资源箱，然后将它交给落锤镇的亡灵哨兵莫提斯。‡進入阿拉希盆地，獲得一箱阿拉希資源木箱，然後將它交給落錘鎮的亡靈哨兵莫提斯。',
  }
},
[10533] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    nil,
  }
},
[10534] = {
  {
    'De volta pra casa‡Возвращение домой‡Rückkehr nach Hause‡집으로 돌아가기‡Regreso al hogar‡La vuelta a casa‡Retourner chez soi‡回家‡',
    nil,
    'Edmos, na Exodar, solicita a tua presença.‡Кедмос из Экзодара просит вас прийти поговорить с ним.‡Caedmos in der Exodar wünscht Euch zu sehen.‡엑소다르에 있는 캐드모스가 만나러 와 달라는 부탁을 했습니다.‡Caedmos, en El Exodar, te ha pedido que vayas a verle.‡Caedmos, en El Exodar, te ha pedido que vayas a verle.‡Caedmos de l\'Exodar vous demande de venir le voir.‡埃索达的凯德莫斯要你回去与他会面。‡',
  }
},
[10535] = {
  {
    'Recursos da Bacia Arathi!‡Ресурсы Низины Арати‡Die Ressourcen des Arathibeckens‡아라시 분지 자원!‡Los recursos de la Cuenca de Arathi‡Los recursos de la Cuenca de Arathi‡Les ressources du bassin d\'Arathi‡阿拉希盆地的资源！‡阿拉希盆地的資源!',
    nil,
    'Vença a batalha pela Bacia Arathi, consiga uma Caixa de Recursos Arathi e fale novamente com a Sargento Martina na Ponta do Refúgio.‡Выиграйте битву за низину Арати, добудьте ящик с ресурсами из Арати и принесите его сержанту Маклир в Опорный пункт.‡Gewinnt die Schlacht um das Arathibecken, raubt eine Arathivorratskiste und bringt sie Unteroffizier Maclear in der Zuflucht.‡아라시 분지의 전투를 승리로 이끌고 아라시 보급품 상자를 가지고 임시 주둔지에 있는 하사관 매클리어에게 돌아가야 합니다.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Llévate la victoria en la batalla por la Cuenca de Arathi, consigue una caja de suministros de Arathi y llévasela al sargento Maclear en el Refugio de la Zaga.‡Gagnez la bataille pour le bassin d\'Arathi, obtenez une Caisse de resssources d\'Arathi et rapportez-la au sergent Maclear au Refuge de l\'Ornière.‡获得阿拉希盆地战斗的胜利，获取一只阿拉希资源箱，然后向避难谷地的玛克里尔中士复命。‡獲得阿拉希盆地戰鬥的勝利，獲取一個阿拉希資源木箱，然後向避難谷地的瑪克里爾中士覆命。',
  }
},
[10536] = {
  {
    'Mais caixas de recursos‡Новые ящики с ресурсами‡Noch mehr Vorratskisten‡‡Más cajas de suministros‡Más cajas de suministros‡Plus de caisses de ressources‡更多的资源‡',
    nil,
    nil,
  }
},
[10537] = {
  {
    'Lohn\'goron, arco dos Coração-partido‡Лон\'горон, лук Горемычного‡Lohn\'goron, Bogen des Herzeleid‡론고른, 비통의 장궁‡Lohn\'goron, arco del corazón roto‡Lohn\'goron, arco del corazón roto‡Lohn\'goron, arc du Cœur-fendu‡洛恩戈鲁，裂心之弓‡羅恩格隆，碎心之弓',
    nil,
    'O Espírito de Ar\'tor, no Pontal Illidari do Vale da Lua Negra, quer que você recupere Lohn\'goron, Arco dos Coração-partido, com um dos demônios da área.‡Отберите у демонов Лон\'горон, лук Горемычного, и верните его духу Ар\'тора на аванпосте иллидари.‡Der Geist von Ar\'tor bei der Stätte der Illidari im Schattenmondtal möchte, dass Ihr Lohn\'goron, den Bogen des Herzeleid, von den Dämonen in der Gegend beschafft.‡어둠달 골짜기의 일리다리 거점에 있는 알토르의 영혼이 그 지역에 있는 악마들을 처치하고 론고른, 비통의 장궁을 찾아달라고 했습니다.‡El espíritu de Ar\'tor en el Alto Illidari, en el Valle Sombraluna, quiere que recuperes Lohn\'goron, arco del corazón roto. Lo tiene un demonio de la zona.‡El espíritu de Ar\'tor en el Alto Illidari, en el Valle Sombraluna, quiere que recuperes Lohn\'goron, arco del corazón roto. Lo tiene un demonio de la zona.‡L\'Esprit d\'Ar\'tor à la Halte Illidari dans la vallée d\'Ombrelune veut que vous repreniez Lohn\'goron, arc du Cœur-fendu aux démons de la région.‡影月谷伊利达雷岗哨的阿托尔的灵魂要你从驻守岗哨的恶魔手中夺得洛恩戈鲁，裂心之弓。‡影月谷內伊利達瑞崗哨的阿爾托之靈要你去從本地的惡魔手中取回羅恩格隆，碎心之弓。',
  }
},
[10538] = {
  {
    'Sangue quente‡Кипящая кровь‡Kochendes Blut‡끓인 혈액‡Sangre en ebullición‡Sangre en ebullición‡Sang bouillonnant‡沸腾之血‡沸騰的血',
    nil,
    'Use o Sangue de Olhos Sangrentos no Caldeirão Amaldiçoado para fazer Sangue Fervido. Leve 12 amostras de Sangue Fervido para o Boticário Alberto no Acampamento Quebra-espinha.‡Поместите кровь орков из клана Кровавой Глазницы в проклятый котел, чтобы получить кипящую кровь. Принесите 12 образцов кипящей крови аптекарю Альбреку на заставу Хребтолома.‡Benutzt den Verfluchten Kessel, um das Blut des Blutenden Auges in gekochtes Blut zu verwandeln. Bringt danach 12 Einheiten gekochtes Blut zu Apotheker Albreck im Rückenbrecherposten.‡피눈물 부족 혈액을 저주받은 가마솥에 넣고 끓인 혈액으로 만들어야 합니다. 해골망치 초소에 있는 연금술사 알브렉에게 끓인 혈액 12개를 가져가십시오.‡Vierte la sangre de Foso Sangrante en su caldero maldito para obtener sangre hervida. Lleva 12 muestras de sangre hervida al boticario Albreck en la Avanzada Rompeloma.‡Vierte la sangre de Foso Sangrante en su caldera maldita para obtener sangre hervida. Lleva 12 muestras de sangre hervida al boticario Albreck en la Avanzada Rompeloma.‡Utilisez le Sang de l\'Orbite-sanglante au Chaudron maudit pour fabriquer du Sang bouilli. Apportez 12 mesures de Sang bouilli à l\'Apothicaire Albreck au Poste de Brise-échine.‡将血环血样投入被诅咒的大锅中煮沸，然后将12份沸腾之血交给断背岗哨的药剂师阿尔布雷克。‡在詛咒熔爐使用血之谷鮮血來製造沸騰的血。帶12份沸騰的血給斷脊氏族崗哨的藥劑師艾柏瑞克。',
  }
},
[10539] = {
  {
    'De volta pra casa‡Возвращение домой‡Rückkehr nach Hause‡집으로 돌아가기‡Regreso al hogar‡La vuelta a casa‡Retourner chez soi‡回家‡',
    nil,
    'Edmos, na Exodar, solicita a tua presença.‡Кедмос из Экзодара просит вас прийти и поговорить с ним.‡Caedmos in der Exodar wünscht Euch zu sehen.‡엑소다르에 있는 캐드모스가 만나러 와 달라는 부탁을 했습니다.‡Caedmos, en El Exodar, te ha pedido que vayas a verle.‡Caedmos, en El Exodar, te ha pedido que vayas a verle.‡Caedmos de l’Exodar vous demande de venir le voir.‡埃索达的凯德莫斯要你回去与他会面。‡',
  }
},
[10540] = {
  {
    'A Cifra da Danação: a missão de Ar\'tor‡Код Проклятия: Вклад Ар\'тора‡Die Litanei der Verdammnis - Ar\'tors Angriff‡파멸의 암호 - 알토르의 임무‡La Clave de Condenación. La carga de Ar\'tor‡La Clave de Condenación. La carga de Ar\'tor‡La Formule de damnation - la charge d\'Ar\'tor‡诅咒密码 - 阿托尔的命令‡毀滅密碼 - 阿爾托的命令',
    nil,
    'O Espírito de Ar\'tor no Pontal Illidari, no Vale da Lua Negra, quer que você recupere o Segundo Fragmento da Cifra da Danação, que está em poder de Veneratus, o Muitos.nnCriaturas atacadas ou danificadas pelo Espírito de Caçador não fornecerão saque nem experiência.‡Заберите вторую часть Кода Проклятия у Венератуса Многого для духа Ар\'тора с аванпоста иллидари. Существа, убитые или раненые охотником на духов, не приносят вам ни добычи, ни опыта.‡Der Geist von Ar\'tor bei der Stätte der Illidari im Schattenmondtal möchte, dass Ihr den zweiten Teil der Litanei der Verdammnis von Veneratus dem Vielgesichtigen besorgt.nnKreaturen, die vom Geistjäger angegriffen werden oder Schaden erleiden, gewähren Euch keine Beute oder Erfahrung.‡어둠달 골짜기의 일리다리 거점에 있는 알토르의 영혼이 베네라투스를 처치하고 두 번째 파멸의 암호 조각을 찾아오라고 했습니다.nn단, 정령사냥꾼이 공격하여 대부분의 피해를 입힌 몬스터는 전리품이나 경험치를 주지 않습니다.‡El espíritu de Ar\'tor en el Alto Illidari, en el Valle Sombraluna, quiere que consigas el segundo trozo de la Clave de Condenación que tiene Veneratus el Múltiple.nnLas criaturas que ataque o dañe el espíritu cazador no proporcionan botín ni experiencia.‡El espíritu de Ar\'tor en el Alto Illidari, en el Valle Sombraluna, quiere que consigas el segundo fragmento de la Clave de Condenación que tiene Veneratus el Múltiple.|n|nLas criaturas que ataque o dañe el espíritu cazador no proporcionan botín ni experiencia.‡L\'Esprit d\'Ar\'tor à la Halte Illidari dans la vallée d\'Ombrelune veut que vous récupériez le Second fragment de la formule de damnation sur Veneratus le Multiple.nnLes créatures attaquées par le Chasseur d\'esprit ou qui subissent des dégâts infligés par lui ne rapportent ni butin ni expérience.‡从维内拉图斯手中夺得诅咒密码的第二块碎片，然后向影月谷伊利达雷岗哨的阿托尔的灵魂复命。nn你无法从被灵魂猎手攻击或杀死的怪物身上获得物品和经验值。‡影月谷中伊利達瑞崗哨的阿爾托之靈要你從多數的威納拉圖斯邊取回毀滅密碼第二部。|n遭受幽魂獵手攻擊或傷害的生物將無法掉落戰利品或經驗值。',
  }
},
[10541] = {
  {
    'A Cifra da Danação: segundo fragmento recuperado‡Код Проклятия – Второй фрагмент‡Die Litanei der Verdammnis - Zweiter Teil‡파멸의 암호 - 두 번째 조각 입수‡La Clave de Condenación. Segundo trozo recuperado‡La Clave de Condenación. Segundo trozo recuperado‡La Formule de damnation - Second fragment retrouvé‡诅咒密码 - 第二块碎片‡毀滅密碼 - 取回第二部',
    nil,
    'Leve a Arca de Ar\'tor para Oronok Coração-partido na Fazenda de Oronok, no Vale da Lua Negra.‡Отнесите сейф Ар\'тора Ороноку Горемычному на ферму Оронока в Долине Призрачной Луны.n.‡Bringt Ar\'tors Schließkassette zu Oronok Herzeleid bei Oronoks Hof im Schattenmondtal.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크에게 알토르의 금고를 가져가야 합니다.‡Lleva la caja fuerte de Ar\'tor a Oronok Corazón Roto en la Granja de Oronok, en el Valle Sombraluna.‡Lleva la caja fuerte de Ar\'tor a Oronok del corazón roto en la Granja de Oronok, en el Valle Sombraluna.|n‡Apportez le Coffret d\'Ar\'tor à Oronok Cœur-fendu à la Ferme d\'Oronok dans la vallée d\'Ombrelune.‡将阿托尔的箱子交给影月谷欧鲁诺克农场的欧鲁诺克-裂心。‡將阿爾托的上鎖帶鎖箱交給影月谷裡歐朗諾克的農場的歐朗諾克·碎心。',
  }
},
[10542] = {
  {
    'Meu narguilé! Minhas cervas!‡У меня сперли кальян и выпивку!‡Die ham meine Pfeife und mein Gesöff geklaut!‡놈들이 물담뱃대와 특별주를 훔쳐갔어!‡Mi pipaaa me la robaaaron...‡Mi pipaaa me la robaaaron...‡On m\'a piqué mon narguilé et mes bibines !‡他们偷走了我的水烟袋和酒！‡他們偷走我的水煙筒和酒!',
    nil,
    'Colete o Narguilé de T\'chali e 10 Cervejas Banebruto dos Malho Sangrento.‡Добудьте кальян Т\'чали и 10 кружек забористого пойла клана Кровавого Молота. Принесите все к Т\'чали Знахарю в лощину Кровавого Молота в Острогорье.‡Holt T\'chalis Wasserpfeife und 10 Einheiten von Blutschlägers Hauweggebräu zurück. Bringt sie zu T\'chali dem Hexendoktor in der Blutschlägerklamm im Schergrat.‡촬리의 물담뱃대와 피망치 투사잡이 특별주 10개를 찾아야 합니다. 모두 손에 넣으면 칼날 산맥의 피망치 협곡에 있는 의술사 촬리에게 돌려주십시오.‡Recupera la pipa de agua de T\'chali y 10 cervezas Machacasangre aterrabrutos. Llévaselo todo entonces a T\'chali el médico brujo del Barranco Machacasangre, en las Montañas Filospada.‡‡Récupérez le Narguilé de T\'chali et 10 Foudroyantes-des-brutes de la Masse-sanglante. Apportez-les à T\'chali le Sorcier-docteur au Ravin de la Masse-sanglante dans les Tranchantes.‡找回塔卡里的水烟袋和10瓶血槌烈酒，将它们交给刀锋山血槌峡谷的巫医塔卡里。‡取得提洽里的水煙筒還有10份血槌蠻禁烈酒。帶到劍刃山脈交給血槌深谷的巫醫提洽里。',
  }
},
[10543] = {
  {
    'Grimnok e Korgaah, a batata tá assando!‡Гримнок и Коргаах, я за вами!‡Grimnok und Korgaah, ich komm\' Euch holen!‡내가 왔다, 그림노크와 코르가!‡Grimnok y Korgaah, ¡voy a por vosotros!‡Grimnok y Korgaah, ¡voy por ustedes!‡Grimnok et Korgaah, je viens vous chercher !‡葛雷诺克和库尔加，你们完了！‡葛瑞諾克和柯爾卡赫，我為你們而來!',
    nil,
    'Mate Grimnok Guerranato e Korgaah.‡Т\'чали Знахарь просит, чтоб вы убили его главных обидчиков, Гримнока Дитя Войны и Коргааха. По выполнении вернитесь к нему в лощину Кровавого Молота в Острогорье.‡T\'chali der Hexendoktor hat Euch gebeten, seine Quäler, Grimnok Schlachttaufe und Korgaah, zu töten. Wenn Ihr fertig seid, kehrt zu ihm in der Blutschlägerklamm im Schergrat zurück.‡의술사 촬리가 자신을 괴롭힌 그림노크 배틀본과 코르가를 처치해 달라고 부탁했습니다. 복수를 한 후 칼날 산맥의 피망치 협곡에 있는 그에게 돌아가십시오.‡T\'chali el médico brujo te ha pedido que mates a quienes le torturaron, Grimnok Belinato y Korgaah. Cuando lo hayas hecho, vuelve a verle en el Barranco Machacasangre, en las Montañas Filospada.‡‡Tuez Grimnok Champ-d\'honneur et Korgaah.‡巫医塔卡里要你除掉折磨过他的葛雷诺克和库尔加。任务完成后，返回刀锋山的血槌峡谷向他复命。‡巫醫提洽里要你殺死最令他痛苦的人，葛瑞諾克·巴拓伯恩還有柯爾卡赫。完成後回到劍刃山脈的血槌深谷找他。',
  }
},
[10544] = {
  {
    'Uma maldição para os dois clãs!‡Чума на оба ваших клана!‡Verflucht seien Eure beiden Klans!‡두 오우거 일족에게 저주를!‡¡Una maldición para ambos clanes!‡¡Una maldición para ambos clanes!‡Malédiction sur vos deux clans !‡诅咒你们的氏族！‡詛咒你們的氏族!',
    nil,
    'Use o Fetiche Sinistramente Forte para amaldiçoar 5 prédios ou torres no Bastião Giralança e 2 no Posto Avançado Malho Sangrento.‡При помощи гибельного сильного фетиша прокляните 5 домов или башен в крепости Камнерогов и 2 на заставе Кровавого Молота. По выполнении задания вернитесь к Т\'чали Знахарю в лощину Кровавого Молота в Острогорье.‡Benutzt den heimtückischen mächtigen Fetisch, um 5 Gebäude in der Wehr der Speerspießer und 2 Gebäude im Außenposten der Blutschläger zu verfluchen. Kehrt zu T\'chali dem Hexendoktor in der Blutschlägerklamm im Schergrat zurück, wenn Ihr fertig seid.‡강력한 악의 우상을 사용하여 칼날첨탑 요새에 있는 건물이나 탑 5채와 피망치 전초기지에 있는 건물이나 탑 2채에 저주를 내려야 합니다. 그런 다음 칼날 산맥의 피망치 협곡에 있는 의술사 촬리에게 돌아가십시오.‡Utiliza el fetiche poderoso desalmado para maldecir 5 edificios en el Bastión Aguja del Filo y 2 en la Avanzada Machacasangre. Vuelve a ver a T\'chali el médico brujo en el Barranco Machacasangre, en las Montañas Filospada, cuando lo hayas hecho.‡‡Utilisez le Fétiche salement fortiche pour maudire 5 bâtiments ou tours du Bastion de Flèchelame et 2 de l\'avant-poste Masse-Sanglante.‡利用邪恶雕像诅咒刀塔要塞的5座建筑物或者哨塔，以及血槌哨站的2座建筑物或者哨塔。任务完成后向刀锋山血槌峡谷的巫医塔卡里复命。‡使用邪惡重型神像詛咒5個在劍刃要塞的建築物或者高塔以及血槌前哨站的2個建築物或者高塔。任務完成時回到劍刃山脈的血槌深谷找巫醫提洽里。',
  }
},
[10545] = {
  {
    'Barril dos Giralança‡Бочонок клана Камнерогов‡Saufgelage der Speerspießer‡술독에 빠진 칼날첨탑 오우거들‡La mezcla Aguja del Filo‡La mezcla Aguja del Filo‡Beuverie chez les Flèchelame‡血槌醉汉‡劍刃氏族的喝酒大會',
    nil,
    'Use o Barril de Cerveja Banebruto dos Malho Sangrento para embebedar 5 Ogros Giralança.‡Т\'чали просит, чтобы вы отнесли бочонок забористого пойла клана Кровавого Молота и попытались бы напоить им 5 огров из клана Камнерогов. Если все получится, вернитесь к Т\'чали Знахарю в лощину Кровавого Молота в Острогорье.‡T\'chali bittet Euch, Blutschlägers Hauweggebräu zu benutzen, um 5 Oger der Speerspießer betrunken zu machen. Wenn Ihr Erfolg hattet, kehrt zu T\'chali dem Hexendoktor in der Blutschlägerklamm im Schergrat zurück.‡촬리가 피망치 투사잡이 술통을 사용해 칼날첨탑 오우거 5마리를 만취시켜 달라고 부탁했습니다. 성공하면 칼날 산맥의 피망치 협곡에 있는 의술사 촬리에게 돌아가십시오.‡T\'chali te ha pedido que lleves la mezcla de aterrabrutos Machacasangre y la utilices para intentar emborrachar a 5 ogros Aguja del Filo. Si tienes éxito, vuelve a ver a T\'chali el médico brujo en el Barranco Machacasangre, en las Montañas Filospada.‡‡Utilisez le Tonneau de foudroyante-des-brutes de la Masse-Sanglante pour saouler 5 Ogres de Flèchelame.‡塔卡里要你尝试用血槌酒桶灌醉5个刀塔食人魔。如果成功，返回刀锋山的血槌峡谷向巫医塔卡里复命。‡提洽里要你使用血槌蠻禁烈酒讓5個劍刃巨魔喝醉。任務完成後回到劍刃山脈的血槌深谷找巫醫提洽里。',
  }
},
[10546] = {
  {
    'Borak, filho de Oronok‡Борак, сын Оронока‡Borak, Sohn von Oronok‡오로노크의 아들 보라크‡Borak, hijo de Oronok‡Borak, hijo de Oronok‡Borak, fils d\'Oronok‡伯拉克，欧鲁诺克之子‡柏爾拉克, 歐朗諾克之子',
    nil,
    'Encontre Borak, Filho de Oronok, perto da Ponta do Eclipse, no Vale da Lua Negra.‡Найдите Борака сына Оронока возле лагеря Затмения в долине Призрачной Луны.‡Sucht Borak, Sohn von Oronok, in der Nähe der Stätte der Mondfinsternis im Schattenmondtal.‡어둠달 골짜기의 해그늘 주둔지 근처에 있는 오로노크의 아들 보라크를 찾아야 합니다.‡Encuentra a Borak, hijo de Oronok, cerca de Punta Eclipse, en el Valle Sombraluna.‡Encuentra a Borak, hijo de Oronok, cerca de Punta Eclipse, en el Valle Sombraluna.‡Trouvez Borak, fils d\'Oronok près de la Halte de l\'éclipse dans la vallée d\'Ombrelune.‡前往影月谷的日蚀岗哨附近寻找伯拉克，欧鲁诺克之子。‡到影月谷的日蝕崗哨附近尋找柏爾拉克, 歐朗諾克之子。',
  }
},
[10547] = {
  {
    'De cardólatras e ovos...‡Выгодный обмен‡Von Distelköpfen und Eiern...‡엉겅퀴 중독자와 알‡Sobre cabezacardos y huevos...‡Sobre cabezacardos y huevos...‡Des chardonomanes et des œufs‡血蓟交易......‡血薊與蛋',
    nil,
    'Borak, Filho de Oronok, junto à ponte ao norte da Ponta do Eclipse, quer que você encontre um Ovo Podre de Arakkoa. O ovo deve ser entregue a Tobias, o Come-lixo, em Shattrath, localizada no noroeste da Mata Terokkar.‡Найдите тухлое яйцо араккоа и доставьте его Тобиасу Грязежору в город Шаттрат, расположенный на северо-западе леса Тероккар.‡Borak, Sohn von Oronok, bei der Brücke nördlich der Stätte der Mondfinsternis möchte, dass Ihr ein verfaultes Arakkoaei besorgt und es zu Tobias dem Faulfraß in Shattrath, nordwestlich der Wälder von Terokkar, bringt.‡해그늘 주둔지에서 북쪽 다리에 있는 오로노크의 아들 보라크가 썩은 아라코아 알 한 개를 찾아서 북서쪽 테로카르 숲에 있는 샤트라스의 쓰레기 수집가 토비아스에게 가져가 달라고 했습니다.‡Borak, hijo de Oronok en el puente al norte de Punta Eclipse, quiere que encuentres un huevo de arakkoa podrido y se lo lleves a Tobias el Comeporquería en la Ciudad de Shattrath, al noroeste del Bosque de Terokkar.‡Borak, hijo de Oronok en el puente al norte de Punta Eclipse, quiere que encuentres un huevo de arakkoa podrido y se lo lleves a Tobias el Comeporquería en la Ciudad de Shattrath, al noroeste del Bosque de Terokkar.‡Borak, fils d\'Oronok, sur le pont au nord de la Halte de l\'éclipse, veut que vous trouviez un Œuf d\'arakkoa pourri et que vous l\'apportiez à Tobias le Goinfre-crasse à Shattrath, qui se trouve au nord-ouest de la forêt de Terokkar.‡位于日蚀岗哨北面石桥旁的欧鲁诺克之子伯拉克要你将一枚腐烂的鸦人之卵交给沙塔斯城中的暴食者托比亚斯。‡在日蝕崗哨北邊橋上的柏爾拉克, 歐朗諾克之子要你找到腐爛的阿拉卡蛋然後交給泰洛卡森林西北邊撒塔斯城的『骯髒暴食者』圖比亞斯。',
  }
},
[10548] = {
  {
    'A triste verdade‡Горькая правда‡Die traurige Wahrheit‡슬픈 현실‡La triste verdad‡La triste verdad‡La triste vérité‡悲伤的事实‡悲傷的事實',
    nil,
    'Eralan, em Tranquillien, quer que você resgate a Cabeça Encolhida de Arqueólogo de um dos baús em Zeb\'Tela ou Zeb\'Nowa.‡Эраланна из Транквиллиона просит вас найти усохшую голову археолога в одном из сундуков Зеб\'Телы или Зеб\'Новы.‡Eralan in Tristessa möchte, dass Ihr den Schrumpfkopf des Archäologen aus einer der Truhen in Zeb\'Tela oder Zeb\'Nowa besorgt.‡트랜퀼리엔에 있는 에랄란이 제브텔라 또는 제브노와에 있는 상자에서 고고학자의 유해를 찾아와 달라고 부탁했습니다.‡Eralan de Tranquillien quiere que recuperes la cabeza reducido del arqueólogo de uno de los cofres de Zeb\'Tela o Zeb\'Nowa.‡Eralan de Tranquillien quiere que recuperes la cabeza reducida del arqueólogo de uno de los cofres de Zeb\'Tela o Zeb\'Nowa.‡Erelan, à Tranquillien, veut que vous retrouviez la Tête d\'archéologue réduite dans l\'un des coffres de Zeb\'Tela ou Zeb\'Nowa.‡从塞布提拉或是塞布努瓦的某个箱子中取出考古学家的头颅，然后向塔奎林的艾拉兰复命。‡安寧地的依蘭兒要你從札布泰拉還有札布諾瓦其中的一個箱子取得考古學家的皺縮頭顱。',
  }
},
[10550] = {
  {
    'O feixe de cardossangue‡Пучок кровопийки‡Ein Bündel von Blutdisteln‡피엉겅퀴 묶음‡El fardo de cardos de sangre‡El fardo de cardos de sangre‡Le fagot de chardons sanglants‡一捆血蓟‡一捆血薊',
    nil,
    'Leve o Feixe de Cardossangue a Borak, Filho de Oronok, que está na ponte perto da Ponta do Eclipse, no Vale da Lua Negra.‡Отнесите пучок кровопийки Бораку сыну Оронока на мост возле лагеря Затмения, в долине Призрачной Луны. n.‡Bringt das Blutdistelbündel zurück zu Borak, Sohn von Oronok, bei der Brücke in der Nähe der Stätte der Mondfinsternis im Schattenmondtal.‡어둠달 골짜기의 해그늘 주둔지 근처에 있는 오로노크의 아들 보라크에게 피엉겅퀴 묶음을 돌려줘야 합니다.‡Llévale el fardo de cardos de sangre a Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna.|n‡Llévale el fardo de cardos de sangre a Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna.|n‡Rapportez le Fagot de chardons sanglants à Borak, fils d\'Oronok sur le pont près de la Halte de l\'éclipse dans la vallée d\'Ombrelune.‡将一捆血蓟交给位于影月谷日蚀岗哨附近石桥处的欧鲁诺克之子伯拉克。‡將一捆血薊交給影月谷的日蝕崗哨附近橋上的柏爾拉克, 歐朗諾克之子。',
  }
},
[10551] = {
  {
    'Aliança com os Aldor‡Присяга верности Алдорам‡Loyalität gegenüber den Aldor‡알도르 사제회의 새로운 일원‡Lealtad hacia los Aldor‡Lealtad hacia los Aldor‡Allégeance aux Aldor‡为奥尔多效力‡向奧多爾效忠',
    nil,
    '‡Вы уверены в своем выборе, Тунфокс? Алдоры с радостью примут вас в ряды своих союзников, но Провидцы вряд ли смогут вам это простить.‡Seid Ihr Euch Eurer Wahl sicher, <Name>? Die Aldor heißen Euch gerne als Verbündeten willkommen, aber die Seher werden Euch Eure Entscheidung nicht so leicht vergeben.‡‡‡‡‡‡',
  }
},
[10552] = {
  {
    'Aliança com os Áugures‡Присяга верности Провидцам‡Loyalität gegenüber den Sehern‡점술가 길드의 새로운 일원‡Lealtad a los Arúspices‡Lealtad a los Arúspices‡Allégeance aux Clairvoyants‡为占星者效力‡向占卜者效忠',
    nil,
    '‡Вы уверены в своем выборе, Солэтьюд? Провидцы с радостью примут вас в ряды своих союзников, но Алдоры вряд ли смогут вам это простить.‡Seid Ihr Euch Eurer Wahl sicher, <Name>? Die Seher heißen Euch gerne als Verbündeten willkommen, aber die Aldor werden Euch Eure Entscheidung nicht so leicht vergeben.‡‡¿Tienes clara tu elección, <nombre>? Los Arúspices te darán la bienvenida como aliado, pero los Aldor no olvidarán fácilmente tu decisión.‡‡‡‡',
  }
},
[10553] = {
  {
    'Voren\'thal, o Vidente‡Ворен\'таль Предсказатель‡Voren\'thal der Seher‡현자 보렌살‡Voren\'thal el vidente‡Voren\'thal el vidente‡Voren\'thal le Voyant‡先知沃雷塔尔‡『先知』沃藍索',
    nil,
    'Fale com Voren\'thal, o Vidente, na Biblioteca dos Videntes, no Terraço dos Áugures, que fica em Shattrath.nnCumprir missões para os Áugures fará com que sua reputação com os Aldor diminua.‡Поговорите с Ворен\'талем в его библиотеке на ярусе Провидцев в Шаттрате.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Sprecht mit Voren\'thal dem Seher in der Bibliothek der Seher bei der Sehertreppe in Shattrath.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡샤트라스, 점술가 언덕의 현자의 도서관 안에 있는 현자 보렌살과 대화하십시오.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Habla con Voren\'thal el Vidente dentro de la Biblioteca del Profeta, en la Grada del Arúspice de la Ciudad de Shattrath.nnLlevar a cabo misiones para los Arúspices hará que tu nivel de reputación Aldor disminuya.‡Habla con Voren\'thal el Vidente dentro de la Biblioteca del Profeta, en la Grada del Arúspice de la Ciudad de Shattrath.|n|nLlevar a cabo misiones para los Arúspices hará que tu nivel de reputación Aldor disminuya.‡Parlez à Voren\'thal le Voyant à l\'intérieur de la Bibliothèque du Voyant sur le Degré des Clairvoyants à Shattrath.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡到沙塔斯城的占星者之台去，与先知图书馆中的先知沃雷塔尔谈一谈。nn为占星者完成任务将会使你在奥尔多阵营中的声望等级降低。‡去跟撒塔斯城占卜者區的『先知』書庫裡頭的『先知』沃藍索談話。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10554] = {
  {
    'Ishanah‡Ишана‡Ishanah‡이샤나‡Ishanah‡‡Ishanah‡伊沙娜‡伊莎納',
    nil,
    'Fale com a Alta-sacerdotisa Ishanah, no Templo da Luz Perene, que fica no Terraço dos Aldor em Shattrath.nnCumprir missões para os Aldor fará com que sua reputação com os Áugures diminua.‡Поговорите с Ишаной в святилище Вечного Света на возвышенности Алдоров в Шаттрате.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Sprecht mit Ishanah im Schrein des unendlichen Lichts auf der Aldorhöhe in Shattrath.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스, 알도르 마루의 영원한 빛의 제단 안에 있는 이샤나와 대화하십시오.nn알도르 사제회를 위한 퀘스트를 수행하면 점술가 길드에 대한 당신의 평판은 떨어질 것입니다.‡Habla con Ishanah dentro del Santuario de Luz Inagotable, en Alto Aldor, de la Ciudad de Shattrath.nnLlevar a cabo misiones para los Aldor hará que tu nivel de reputación Arúspice disminuya.‡Habla con Ishanah dentro del Santuario de Luz Inagotable, en Alto Aldor, de la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Parlez à Ishanah à l\'intérieur du Sanctuaire de la Lumière perpétuelle sur l\'Éminence de l\'Aldor à Shattrath.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡到沙塔斯城的奥尔多高地去，与永恒圣光神殿中的伊沙娜谈一谈。nn为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡跟永恆聖光神殿裡面的伊莎納談話，位在奧多爾高地的撒塔斯城。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10555] = {
  {
    'Mal-estar‡Недомогание‡Fauler Zauber‡불안감‡Malestar‡Malestar‡Malaise‡诡异的魔法‡莫名的不安',
    nil,
    'Colete 18 Plumas de Lashh\'an Arrancadas.‡Собрать 18 выдернутых перьев Лашш, затем прочесть фолиант Лашш на вершинах деревьев Гнездовья Лашш.‡Sammelt 18 ausgezupfte Federn der Lashh\'an und lest den Folianten der Lashh\'an in den Baumwipfeln des Lashhverstecks.‡뽑힌 라쉬안 깃털 18개를 수집한 후에 장막의 래쉬의 나무 꼭대기에 있는 라쉬안 마법책을 읽어야 합니다.‡Reúne 18 plumas de Lashh\'an arrancadas y luego lee el Escrito Lashh\'an en las copas de los árboles de Velo Lashh.‡‡Réunissez 18 Plumes lashh\'an arrachées, puis lisez le Tome lashh\'an dans les cimes des arbres du Voile Lashh.‡收集18片拉什鸦人的羽毛，然后阅读放置在拉什鸦巢顶部的拉什鸦巢宝典。‡收集18根掉落的拉斯汗羽毛，然後在迷霧拉斯的樹梢上閱讀拉斯汗書卷。',
  }
},
[10556] = {
  {
    'Arranhões‡Рисунки‡Gekritzel‡상처‡Arañazos‡Arañazos‡Égratignures‡潦草的字迹‡達成要求',
    nil,
    'Use o Punhado de Plumas no Círculo de Feitiço dos Lashh\'an.‡При помощи горсти перьев в кругу заклинаний Лашш наложите заклинания, затем вернитесь к Даранелле в Сильванаар прежде, чем дух калири покинет вас.‡Benutzt die Hand voll Federn im Zauberzirkel der Lashh\'an und kehrt zu Daranelle in Sylvanaar zurück, bevor der Zauber nachlässt.‡라쉬안 마법진에서 아라코아 깃털 한 다발을 사용해야 합니다.‡Usa el manojo de plumas en el círculo de hechizos de Lashh\'an.‡‡Utilisez la Poignée de plumes dans le Cercle magique lashh\'an.‡在拉什鸦巢法阵使用一把羽毛，在卡利鸟的灵魂消失前返回希尔瓦纳，向达兰妮尔复命。‡在拉斯汗的法陣使用一把羽毛，然後在卡里瑞的精神退去之前回去找希爾瓦納的達藍艾歐。',
  }
},
[10557] = {
  {
    'Voo de teste: capacitório de zefírio‡Испытательный полет: Конденсаторий зефира‡Testflug: Das Zephyriumkapazitorium‡시험 비행: 돌개바람 축전장치‡El Cefirium Capacitorium‡Vuelo de prueba: el Cefirium Capacitorium‡Vol d\'essai : le Zephyrium Capacitorium‡试飞：风动电容器‡測試飛行:ZC號',
    nil,
    'Fale com Netto Desastraz e use o Capacitório de Zefírio. Depois, fale novamente com Betto Desastraz na Estação do Tocha.‡Поговорите с Ралли Быстроцапом и испытайте Конденсанторий зефира. Вернитесь к Талли Быстроцапу на станцию Тошли.‡Sprecht mit Rally Zapschnapper und benutzt das Zephyriumkapazitorium. Kehrt danach zu Tally Zapschnapper in Toshleys Station zurück.‡랠리 잽내버와 대화한 후 돌개바람 축전장치를 시험 비행한 후, 토쉴리의 연구기지에 있는 탤리 잽내버에게 돌아가야 합니다.‡Habla con Rally Pillazas para usar el Cefirium Capacitorium. Vuelve con Tally Pillazas a la Estación de Toshley.‡‡Parlez à Rally Rossecoquin pour utiliser le Zephyrium Capacitorium. Puis retournez voir Tally Rossecoquin au Poste de Toshley.‡与拉雷·萨普纳波谈一谈，并使用风动电容器。然后返回托什雷的基地，向塔利·萨普纳波复命。‡跟瑞利·薩普納伯談話然後使用ZC號。回去托斯利基地找塔利·薩普納伯。',
  }
},
[10558] = {
  {
    'Reverenciado pela Fortaleza da Honra‡Уважительное отношение Оплота Чести‡Respektvoller Ruf in der Ehrenfeste‡명예의 요새에 대한 매우 우호적 평판‡Venerado con el Bastión del Honor‡Venerado con el Bastión del Honor‡Révéré par le bastion de l\'Honneur‡荣耀堡的崇敬‡榮譽堡的崇敬',
    nil,
    'O Comandante-chefe Danath Matatroll, na Fortaleza da Honra, que fica na Península Fogo do Inferno, quer que você se torne <reverenciado/reverenciada> pela Fortaleza da Honra, lutando com os orcs vis nos Salões Despedaçados da Cidadela Fogo do Inferno.‡Командир армии Данат Троллебой из Оплота Чести на полуострове Адского Пламени желает, чтобы вы заслужили уважительное отношение Оплота Чести, продолжив сражаться с орками Скверны в Разрушенных залах цитадели Адского Пламени.‡Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel möchte, dass Ihr Euch einen respektvollen Ruf in der Ehrenfeste verschafft, indem Ihr die Höllenorcs in den Zerschmetterten Hallen der Höllenfeuerzitadelle tötet.‡지옥불 반도 명예의 요새에 있는 전투사령관 다나스 트롤베인이 지옥불 성채의 으스러진 손의 전당 안에 있는 타락한 오크들과 싸워서 명예의 요새에 대해 매우 우호적 평판을 쌓으라고 했습니다.‡El comandante en jefe Danath Aterratrols, del Bastión del Honor, en la Península del Fuego Infernal, quiere que seas <venerado/venerada> en el Bastión del Honor luchando contra los orcos viles dentro de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡El comandante en jefe Danath Aterratrols, del Bastión del Honor, en la Península del Fuego Infernal, quiere que seas $Gvenerado:venerada; en el Bastión del Honor luchando contra los orcos viles dentro de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Le commandant de corps Danath Trollemort du bastion de l\'Honneur dans la péninsule des Flammes infernales veut que vous deveniez <Révéré/Révérée> par le bastion de l\'Honneur en combattant des Gangr\'orcs à l\'intérieur des Salles brisées de la citadelle des Flammes infernales.‡地狱火半岛荣耀堡的远征军指挥官达纳斯·托尔贝恩要求你进入地狱火堡垒的破碎大厅对抗邪兽人，直到你在荣耀堡的声望达到崇敬。‡地獄火半島的榮譽堡的軍隊指揮者達納斯·托爾貝恩要你殺死地獄火堡壘的破碎大廳的魔獄獸人以獲得榮譽堡的崇敬。',
  }
},
[10559] = {
  {
    'Reverenciado em Thrallmar‡Уважительное отношение Траллмара‡Respektvoller Ruf in Thrallmar‡‡Venerado con Thrallmar‡Venerado con Thrallmar‡Révéré par Thrallmar‡萨尔玛的崇敬‡索爾瑪的崇敬',
    nil,
    'Nazgrel, em Thrallmar, na Península Fogo do Inferno, quer que você se torne <reverenciado/reverenciada> em Thrallmar, combatendo os orcs vis dentro dos Salões Despedaçados da Cidadela Fogo do Inferno.‡Заслужите уважение Траллмара, сражаясь с орками Скверны в Разрушенных залах цитадели Адского Пламени по совету Назгрела из Траллмара на полуострове Адского Пламени.‡Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel möchte, dass Ihr Euch einen respektvollen Ruf in Thrallmar verschafft, indem Ihr die Höllenorcs in den Zerschmetterten Hallen der Höllenfeuerzitadelle tötet.‡‡Nazgrel, de Thrallmar, en la Península del Fuego Infernal, quiere que seas <venerado/venerada> en Thrallmar luchando contra los orcos viles que hay dentro de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Nazgrel, de Thrallmar, en la Península del Fuego Infernal, quiere que seas $Gvenerado:venerada; en Thrallmar luchando contra los orcos viles que hay dentro de Las Salas Arrasadas de la Ciudadela del Fuego Infernal.‡Nazgrel, à Thrallmar dans la péninsule des Flammes infernales, veut que vous deveniez <Révéré/Révérée> par Thrallmar en combattant les Gangr\'orcs à l\'intérieur des Salles brisées de la citadelle des Flammes infernales.‡地狱火半岛萨尔玛的纳兹格雷尔要求你进入地狱火堡垒的破碎大厅对抗邪兽人，直到你在萨尔玛的声望达到崇敬。‡在地獄火半島索爾瑪的納茲格雷爾要你跟地獄火堡壘的破碎大廳裡面的魔獄獸人戰鬥以獲得索爾瑪的崇敬。',
  }
},
[10560] = {
  {
    'Reverenciado pelos Sha\'tar‡Почтительное отношение Ша\'тар‡Respektvoller Ruf bei den Sha\'tar‡‡Venerado con Sha\'tar‡Venerado con Sha\'tar‡Révéré par les Sha\'tar‡沙塔尔的崇敬‡薩塔的崇敬',
    nil,
    'A\'dal, em Shattrath, quer que você se torne <reverenciado/reverenciada> com os Sha\'tar, derrotando as forças de Kael\'thas que estão na Bastilha da Tormenta.‡Заслужите почтительное отношение Ша\'тар, сразившись с силами Кель\'таса в Крепости Бурь, после чего поговорите с А\'далом в Шаттрате.‡A\'dal in Shattrath möchte, dass Ihr Euch einen respektvollen Ruf bei den Sha\'tar verschafft, indem Ihr Kael\'thas Streitkräfte in der Festung der Stürme tötet.‡‡A\'dal de la Ciudad de Shattrath quiere que seas <venerado/venerada> en Sha\'tar venciendo a las tropas de Kael\'thas dentro de El Castillo de la Tempestad.‡A\'dal de la Ciudad de Shattrath quiere que seas $Gvenerado:venerada; en Sha\'tar venciendo a las tropas de Kael\'thas dentro de El Castillo de la Tempestad.‡A\'dal, de Shattrath, veut que vous deveniez <Révéré/Révérée> par les Sha\'tar en vainquant les forces de Kael\'thas à l\'intérieur du Donjon de la Tempête.‡沙塔斯城的阿达尔希望你通过击败风暴要塞内的凯尔萨斯的军队，在沙塔尔阵营中达到崇敬声望。‡撒塔斯城的阿達歐要你擊敗風暴要塞內的凱爾薩斯部隊以獲得薩塔的崇敬。',
  }
},
[10561] = {
  {
    'Reverenciado pelos Defensores do Tempo‡Уважение Хранителей Времени‡Respektvoller Ruf bei den Hütern der Zeit‡‡Venerado con los Vigilantes del Tiempo‡Venerado con los Vigilantes del Tiempo‡Révéré par les Gardiens du temps‡时光守护者：崇敬‡時光守望者的崇敬',
    nil,
    'Andormu, dentro das Cavernas do Tempo em Tanaris, quer que você se torne <Reverenciado/Reverenciada> pelos Defensores do Tempo, protegendo os eventos da Antiga Eira dos Montes e do Lamaçal Negro dentro das Cavernas do Tempo.‡Заслужите уважение Хранителей Времени. Для этого необходимо проследить, чтобы никто не нарушил течение времени и не изменил ход прошлых событий в старом Хилсбраде и в Черных топях в пещерах Времени.‡Andormu in den Höhlen der Zeit in Tanaris möchte, dass Ihr Euch einen respektvollen Ruf bei den Hütern der Zeit verdient, indem Ihr weiterhin die Ereignisse im Alten Hügelland und dem Schwarzen Morast in den Höhlen der Zeit verteidigt.‡‡Andormu, dentro de las Cavernas del Tiempo de Tanaris, quiere que seas <venerado/venerada> entre los Vigilantes del Tiempo, al continuar defendiendo los sucesos de la Antigua Trabalomas y la Ciénaga Negra, en las Cavernas del Tiempo.‡Andormu, dentro de las Cavernas del Tiempo de Tanaris, quiere que seas $Gvenerado:venerada; entre los Vigilantes del Tiempo, al continuar defendiendo los sucesos de la Antigua Trabalomas y la Ciénaga Negra, en las Cavernas del Tiempo.‡Andormu à l\'intérieur des Grottes du temps à Tanaris veut que vous deveniez <Révéré/Révérée> par les Gardiens du temps en continuant à défendre les événements de Hautebrande d\'antan et du Noir Marécage à l\'intérieur des Grottes du temps.‡时光之穴的安多尔姆要求你继续保护时光之穴中的旧希尔斯布莱德丘陵和黑色沼泽事件，直到你在时光守护者阵营的声望达到崇敬。‡時光之穴的安杜姆要你繼續在時光之穴內守護希爾斯布萊德還有黑色沼澤的重大事件以獲得時光守望者的崇敬。',
  }
},
[10562] = {
  {
    'Cercados!‡Окружены!‡Belagert!‡공격 쇄도!‡¡Asediados!‡¡Asediados!‡Assiégés !‡兵临城下！‡圍困!',
    nil,
    'Comandante de Ala Nuainn, do lado de fora da Fortaleza Martelo Feroz, quer que você mate 10 Atacantes Infernais.‡Убейте 10 боевых инферналов для командира звена Нуаинна из цитадели Громового Молота.‡Schwadronskommandant Nuainn außerhalb der Wildhammerfeste möchte, dass Ihr 10 angreifende Höllenbestien tötet.‡와일드해머 성채 바깥에 있는 편대사령관 누아인이 지옥불정령 돌격병 10명을 처치해 달라고 부탁했습니다.‡El comandante del aire Nuainn, fuera del Bastión Martillo Salvaje, quiere que mates a diez agresores infernales.‡El comandante del aire Nuainn, fuera del Bastión Martillo Salvaje, quiere que mates a diez agresores infernales.‡Le chef d\'escadrille Nuainn, à l\'extérieur du bastion des Marteaux-hardis, vous demande de tuer 10 Attaquants infernaux.‡蛮锤要塞外的空军指挥官努埃恩要求你杀死10个地狱火攻击者。‡蠻錘要塞外面的空軍指揮官奴艾恩要你殺死10個地獄火攻擊者。',
  }
},
[10563] = {
  {
    'Contra a Cidadela da Legião‡В форт Легиона‡Zur Feste der Legion‡불타는 군단 요새로‡Al Bastión de la Legión‡Al Bastión de la Legión‡Vers le bastion de la Légion‡前往军团要塞‡前往軍團要塞',
    nil,
    'Rume para a Cidadela da Legião e encontre o Dispositivo de Comunicação da Legião. Enquanto estiver ao lado do dispositivo comunicador, use o disfarce e descubra os planos da Legião. Fale novamente com Comandante de Ala Nuainn na Fortaleza Martelo Feroz.‡Отправляйтесь в форт Легиона, найдите там переговорное устройство и, воспользовавшись маскировкой, выведайте планы Легиона. Вернитесь к командиру звена Нуаинну в цитадель Громового Молота, когда выполните задание.‡Begebt Euch zur Feste der Legion und findet das Kommunikationsgerät der Legion. Benutzt die Verkleidung, während Ihr in der Nähe des Kommunikationsgeräts steht, um mehr über die Pläne der Legion herauszufinden. Kehrt danach zu Schwadronskommandant Nuainn in der Wildhammerfeste zurück.‡불타는 군단 요새로 가서 군단 통신 장치를 찾아 그 근처에 서서 위장용 상자를 사용하여 불타는 군단의 계획을 알아낸 후, 와일드해머 성채에 있는 편대사령관 누아인에게 가야 합니다.‡Ponte en camino hacia el Bastión de la Legión y ubica el aparato de comunicación de la Legión. Cuando estés cerca del aparato, usa tu disfraz y averigua los planes de la Legión. Reúnete con el comandante del aire Nuainn en el Bastión Martillo Salvaje cuando hayas completado tu misión.‡Ponte en camino hacia el Bastión de la Legión y ubica el aparato de comunicación de la Legión. Cuando estés cerca del aparato, usa tu disfraz y averigua los planes de la Legión. Vuelve con el comandante del aire Nuainn al Bastión Martillo Salvaje cuando hayas completado tu misión.‡Rendez-vous au Bastion de la Légion et localisez le Système de communication de la Légion. Quand vous serez près de lui, utilisez votre déguisement pour apprendre les plans de la Légion. Retournez voir le chef d\'escadrille Nuainn, au bastion des Marteaux-Hardis, quand vous aurez accompli votre mission.‡前往军团要塞寻找军团通讯装置。在伪装状态下站在军团通讯装置附近，偷听燃烧军团的计划。完成任务后向蛮锤要塞的空军指挥官努埃恩复命。‡前進到軍團要塞然後找到軍團傳輸設備。當你靠近傳輸設備的時候，使用你的偽裝然後打聽燃燒軍團的計畫。任務完成時向蠻錘要塞的空軍指揮官奴艾恩回報。',
  }
},
[10564] = {
  {
    'Os infernais que se explodam!‡Перебей инферналов!‡Jagt die Höllenbestien in die Luft!‡지옥불정령 제거!‡¡Infernales por los aires!‡¡Infernales por los aires!‡Au diable les infernaux !‡炸毁地狱火！‡引爆地獄火!',
    nil,
    'Use a Bomba Vil em cima do glifo verde na Cidadela da Legião, e em seguida se apresente ao Comandante de Ala Nuainn na Fortaleza Martelo Feroz.‡Используйте бомбу Скверны, находясь в центре зеленого знака в форте Легиона, чтобы уничтожить огненных големов. Доложите о выполнении задания командиру звена Нуаинну из цитадели Громового Молота.‡Zündet die Teufelsbombe, während Ihr auf der grünen Glyphe in der Feste der Legion steht. Meldet Euch bei Schwadronskommandant Nuainn in der Wildhammerfeste zurück, wenn Ihr Euren Auftrag erledigt habt.‡불타는 군단 요새의 녹색 문자진 위에 서서 지옥 폭탄을 사용한 후, 와일드해머 성채에 있는 편대사령관 누아인에게 보고해야 합니다.‡Acciona la bomba vil cuando estés en el glifo verde, en Bastión de la Legión. Informa al comandante del aire Nuainn en Bastión Martillo Salvaje cuando hayas completado tu misión.‡Acciona la bomba vil cuando estés en el glifo verde, en Bastión de la Legión. Informa al comandante del aire Nuainn en Bastión Martillo Salvaje cuando hayas completado tu misión.‡Placez-vous sur le glyphe vert des fortifications du bastion de la Légion et utilisez la Gangrebombe. Ensuite, revenez faire votre rapport au chef d\'escadrille Nuainn, au bastion des Marteaux-Hardis.‡站在军团要塞的绿色雕文上使用魔能炸弹消灭地狱火，然后向蛮锤要塞的空军指挥官努埃恩复命。‡當你站在軍團要塞的綠紋圈中的時候引爆魔化炸彈。任務完成時，回報給蠻錘要塞的空軍指揮官奴艾恩。',
  }
},
[10565] = {
  {
    'As pedras de Vekh\'nir‡Камни Векх\'ниров‡Die Steine der Vekh\'nir‡베크니르 수정‡Las piedras de Vekh\'nir‡Las piedras de Vekh\'nir‡Les pierres de Vekh\'nir‡维克鸦巢水晶‡維克尼爾之石',
    nil,
    'Colete e use um Cristal Vekh\'nir no Círculo de Feitiço Vekh\'nir e leve o Cristal Vekh\'nir Carregado para Dertrok na Vila de Mok\'nathal.‡Добудьте кристалл век\'ниров и отнесите в круг закинаний век\'ниров. Затем принесите заряженный кристалл век\'ниров Дертроку в деревню Мок\'Натал.‡Sammelt einen Kristall der Vekh\'nir und benutzt ihn beim Zauberzirkel der Vekh\'nir. Kehrt mit dem aufgeladenen Kristall der Vekh\'nir zu Dertrok im Dorf der Mok\'Nathal zurück.‡베크니르 수정을 찾아 베크니르 마법진에서 사용해 힘을 불어넣은 후 충만한 베크니르 수정을 모크나탈 마을에 있는 데르트록에게 돌려주어야 합니다.‡Recoge y usa un cristal Vekh\'nir del círculo de hechizos de los Vekh\'nir y devuelve el cristal Vekh\'nir cargado a Dertrok, en la Aldea Mok\'Nathal.‡‡Récupérez un Cristal vekh\'nir et utilisez-le au Cercle magique vekh\'nir, puis rapportez le Cristal vekh\'nir chargé à Dertrok au village Mok\'Nathal.‡在维克鸦巢法阵使用维克鸦巢水晶，然后将充能的维克鸦巢水晶交给莫克纳萨村的德尔托克。‡收集一個維克尼爾水晶並且在維克尼爾的法力之環使用它，然後把充能維克尼爾水晶交給摩克納薩爾村的德托克。',
  }
},
[10566] = {
  {
    'Tentativa e erro‡Пробы и ошибки‡Probieren geht über Studieren‡시행착오‡Ensayo y error‡Ensayo y error‡Par tâtonnements‡测试魔杖‡錯誤的試驗',
    nil,
    'Teste cada varinha de Dertrok em um ogro escravo dos arakkoas. Cada varinha precisará de um Cristal Vekh\'nir Infuso para ser usada.‡Испытайте все жезлы Дертрока на огре-рабе араккоа, затем возвращайтесь к Дертроку. Для использования каждого жезла понадобится пылающий кристалл Вех\'ниров.‡Probiert jeden von Dertroks Zauberstäben an einem Ogersklaven der Arakkoa aus und kehrt danach zu Dertrok zurück. Ihr benötigt einen energieerfüllten Kristall der Vekh\'nir für jeden Stab, den Ihr benutzen wollt.‡아라코아들이 노예로 부리는 오우거들에게 데르트록의 마법봉을 모두 시험해 봐야 합니다. 마법봉을 시험할 때마다 마력 깃든 베크니르 수정이 하나씩 필요합니다.‡Prueba cada varita de Dertrok en un esclavo ogro arakkoa y vuelve con Dertrok. Con cada varita tendrás que usar un cristal imbuido Vekh\'nir.‡‡Essayez chacune des baguettes de Dertrok sur un Ogre esclave des arakkoa. Chaque utilisation d\'une baguette nécessite un Cristal vekh\'nir imprégné.‡利用鸦人的食人魔奴隶试验德尔托克制作的四根魔杖，然后向德尔托克复命。每根魔杖都需要一颗充能的维克鸦巢水晶才能发挥效用。‡對一個阿拉卡巨魔奴隸測試每一根德托克的魔杖。每一根魔杖都需要消耗一個灌能維克尼爾水晶。',
  }
},
[10567] = {
  {
    'Criação do pingente‡Создание подвески‡Die Herstellung des Anhängers‡선구자의 펜던트‡Crear el colgante‡Crear el colgante‡Créer le pendentif‡制造坠饰‡製造墜飾',
    nil,
    'Colete 6 Garras de Ruuan\'ok e as use no Círculo do Oráculo Ruann\'ok para evocar um Emissário do Corvo. Mate-o para coletar o Pingente do Emissário.‡Добудьте 6 когтей араккоа из гнездовья Рууан и положите их круг оракула из предвестника Ворона. Убейте его и отнесите подвеску предвестника Тимеону в чащобу Рууан.‡Sammelt 6 Klauen der Ruuan\'ok und benutzt sie bei dem Orakelkreis der Ruuan\'ok, um einen Herold des Raben herbeizurufen. Tötet ihn und bringt den Anhänger des Herolds zu Timeon im Ruuanwald.‡루안오크 발톱 6개를 찾아서 루안오크 점쟁이의 마법진 내에서 사용하여 까마귀의 선구자를 소환해야 합니다. 소환된 선구자를 처치하고 루안 숲에 있는 타이미온에게 선구자의 펜던트를 가져가야 합니다.‡Busca 6 garras de Ruuan\'ok y úsalas para invocar a un presagista del Cuervo en el Círculo del Oráculo Ruuan\'ok. Mátalo y devuelve su colgante de presagista a Timeon, en la Foresta de Ruuan.‡‡Procurez-vous 6 Griffes de Ruuan\'ok et utilisez-les au Cercle d\'oracle ruuan\'ok pour invoquer un Messager du Corbeau. Tuez-le et rapportez son Pendentif de messager à Timeon dans la Sylve Ruuan.‡收集6只卢安利爪，在卢安预言法阵中使用它们召唤一名乌鸦预言者。杀死乌鸦预言者，将预言者的坠饰交给卢安荒野的坦莫。‡在魯安歐克神諭者法陣找到6個魯安歐克之爪來召喚1個烏鴉神諭使。殺死它然後將神諭使墜飾交給魯安曠野的泰姆昂。',
  }
},
[10568] = {
  {
    'Tabuletas de Baa\'ri‡Таблички Баа\'ри‡Schrifttafeln von Baa\'ri‡바아리 서판‡Tablillas de Baa\'ri‡Las tablillas de Baa\'ri‡Les tablettes de Baa\'ri‡巴尔里石板‡巴瑞碑文',
    nil,
    'A Anacoreta Ceyla no Altar de Sha\'tar quer que você colete 12 Tabuletas Baa\'ri no chão e com os Trabalhadores Grislíngua nas Ruínas de Baa\'ri.nnCompletar missões para os Aldor reduzirá sua reputação junto aos Áugures.‡Соберите для анахоретки Сейлы 12 табличек Баа\'ри. Таблички могут быть где-то закопаны или находиться у Пеплоустов-рабочих.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Ceyla beim Altar der Sha\'tar möchte, dass Ihr 12 Schrifttafeln von Baa\'ri vom Boden und von den Arbeitern der Aschenzungen in den Ruinen von Baa\'ri sammelt.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤타르 제단에 있는 수도사 케일라가 바아리 폐허에서 바아리 서판 12개를 모아달라고 부탁했습니다. 서판은 땅에서 줍거나 폐허의 잿빛혓바닥 일꾼을 처치해서 얻을 수 있습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La anacoreta Ceyla del Altar de Sha\'tar quiere que recojas 12 tablillas Baa\'ri del suelo y de los trabajadores Lengua de ceniza en las Ruinas de Baa\'ri.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡La anacoreta Ceyla del Altar de Sha\'tar quiere que recojas 12 tablillas Baa\'ri del suelo y de los trabajadores Lengua de ceniza en las Ruinas de Baa\'ri.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'anachorète Ceyla de l\'Autel de Sha\'tar veut que vous récupériez 12 Tablettes baa\'ri sur le sol et sur les Ouvriers cendrelangues aux Ruines de Baa\'ri.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡沙塔尔祭坛的学者希拉要你收集12块巴尔里石板，它们散落在巴尔里废墟中，那里的灰舌工人身上也携带着这种石板。nn为奥尔多阵营完成任务将降低你在占星者阵营中的声望等级。‡薩塔祭壇的隱士希拉要你去巴瑞廢墟從地上或者灰舌勞工的身上收集12個巴瑞碑文。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10569] = {
  {
    'As Ruínas de Sketh\'lon‡Развалины Скет\'лона‡Das Wrack der Sketh\'lon‡스케슬론 폐허‡Las Ruinas de Sketh\'lon‡Las Ruinas de Sketh\'lon‡Les débris de Sketh\'lon‡斯克瑟隆废墟‡史凱瑟隆殘骸',
    nil,
    'Consiga as Páginas 1, 2 e 3 do Diário do Comandante de Sketh\'lon com os arakkoas do Conclave Negro nas Ruínas de Sketh\'lon e as entregue ao Cavalga-grifo Kieran.‡Добудьте у темного конклава араккоа и принесите наезднику на грифоне Киерану первую, вторую и третью страницы дневника командира Скет\'лона.‡Besorgt das Tagebuch des Kommandanten der Sketh\'lon - Seite 1, das Tagebuch des Kommandanten der Sketh\'lon - Seite 2 und das Tagebuch des Kommandanten der Sketh\'lon - Seite 3 von den Arakkoa des Dunklen Rats beim Wrack der Sketh\'lon und bringt die Seiten zu Greifenreiter Kieran.‡스케슬론 폐허에 있는 암흑 비밀결사 아라코아로부터 스케슬론 지휘관의 일지 - 1쪽, 스케슬론 지휘관의 일지 - 2쪽, 스케슬론 지휘관의 일지 - 3쪽을 되찾은 후 그리핀기수 키에란에게 가져가야 합니다.‡Recupera las páginas 1, 2 y 3 del diario del comandante Skethlon del cónclave oscuro arakkoa en las Ruinas de Sketh\'lon y entrégaselas al jinete de grifo Kieran.‡Recupera las páginas 1, 2 y 3 del diario del comandante Skethlon del cónclave oscuro arakkoa en las Ruinas de Sketh\'lon y entrégaselas al jinete de grifo Kieran.‡Récupérez le Journal du commandant de Sketh\'lon - Page 1, le Journal du commandant de Sketh\'lon - Page 2 et le Journal du commandant de Sketh\'lon - Page 3 détenues par les arakkoa du sombre Conclave aux Débris sketh\'lon, puis rapportez-les au Chevaucheur de griffons Kieran.‡从斯克瑟隆废墟黑暗教团的鸦人身上夺得斯克瑟隆指挥官的日记 - 第1页、斯克瑟隆指挥官的日记 - 第2页，以及斯克瑟隆指挥官的日记 - 第3页，将它们交给狮鹫骑士基尔兰。‡自史凱瑟隆殘骸的黑暗議會阿拉卡身上取回史凱瑟隆指揮官日誌 - 第一頁，史凱瑟隆指揮官日誌 - 第二頁，和史凱瑟隆指揮官日誌 - 第三頁交給獅鷲騎士凱蘭。',
  }
},
[10570] = {
  {
    'Um cardólatra da pesada‡Охота на Посла‡Einen Distelsüchtigen fangen‡엉겅퀴 중독자 포획‡Perder la cabeza... por unos cardos‡Perder la cabeza... por unos cardos‡Pour une poignée de chardons‡血蓟瘾君子‡血薊花的陷阱',
    nil,
    'Borak, Filho de Oronok, que está na ponte perto da Ponta do Eclipse, no Vale da Lua Negra, quer que você recupere a Missiva de Tempesfúria.‡Заберите письмо Ярости Бури на мосту возле лагеря Затмения для Борака сына Оронока.‡Borak, Sohn von Oronok, bei der Brücke in der Nähe der Stätte der Mondfinsternis im Schattenmondtal möchte, dass Ihr Sturmgrimms Schriftwechsel beschafft.‡어둠달 골짜기의 해그늘 주둔지 근처에 있는 오로노크의 아들 보라크가 스톰레이지의 서신을 입수해 달라고 했습니다.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes la misiva de Tempestira.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes la misiva de Tempestira.‡Borak, fils d\'Oronok, du pont qui se trouve près de la halte de l\'Éclipse dans la vallée d\'Ombrelune, vous demande de récupérer la Missive de Hurlorage.‡将怒风的信件交给位于影月谷日蚀岗哨附近石桥处的欧鲁诺克之子伯拉克。‡影月谷的日蝕崗哨附近橋上的柏爾拉克, 歐朗諾克之子要你取回怒風信件。',
  }
},
[10571] = {
  {
    'Oronu, o Ancião‡Старец Орону‡Oronu der Älteste‡장로 오로누‡Oronu el Anciano‡Oronu el Anciano‡Oronu l\'Ancien‡长者奥洛努‡長者奧朗奴',
    nil,
    'A Anacoreta Ceyla no Altar de Sha\'tar quer que você obtenha as Ordens de Akama que estão com Oronu, o Ancião, nas Ruínas de Baa\'ri.nnCompletar missões para os Aldor reduzirá sua reputação junto aos Áugures.‡Найдите в руинах Баа\'ри приказы Акамы, адресованные Орону Старцу, и принесите их анахоретке Сейле к алтарю Ша\'тар.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Ceyla beim Altar der Sha\'tar möchte, dass Ihr die Befehle von Akama von Oronu dem Ältesten in den Ruinen von Baa\'ri besorgt.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤타르 제단에 있는 수도자 케일라가 바아리 폐허에 있는 장로 오로누를 처치하고 아카마의 명령서를 입수해 달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡El anacoreta Ceyla del Altar de Sha\'tar quiere que consigas las órdenes de Akama de Oronu el Anciano en las Ruinas de Baa\'ri.nnA medida que completas tareas para los Aldor disminuye tu nivel de reputación con los Arúspices.‡La anacoreta Ceyla del Altar de Sha\'tar quiere que consigas las órdenes de Akama de Oronu el Anciano en las Ruinas de Baa\'ri.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'anachorète Ceyla de l\'Autel de Sha\'tar veut que vous vous procuriez les Ordres d\'Akama sur Oronu l\'Ancien aux Ruines de Baa\'ri.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡沙塔尔祭坛的学者希拉要求你从巴尔里废墟的长者奥洛努手中夺得阿卡玛的命令。nn为奥尔多阵营完成任务将降低你在占星者阵营中的声望等级。‡薩塔祭壇的隱士希拉要你取回位在巴瑞廢墟的長者奧朗奴身上的阿卡瑪的命令。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10572] = {
  {
    'Bomba la bomba‡Сборка бомбы‡Die Bombe bauen‡폭탄의 재료‡Preparación de la bomba‡Preparación de la bomba‡La préparation de la bombe‡制造炸弹‡製作炸彈',
    nil,
    'Obtenha um Núcleo de Força de Aníquilus e uma Placa de Armadura de Aníquilus, e leve-os ao Comandante de Ala Nuainn, na Fortaleza Martelo Feroz.‡Добудьте энергетический сердечник и часть обшивки сквернобота и принесите материалы командиру звена Нуаинну из цитадели Громового Молота.‡Besorgt Euch einen Teufelshäscherkraftkern und eine Teufelshäscherrüstungsplatte und bringt sie zu Schwadronskommandant Nuainn in der Wildhammerfeste.‡지옥절단기 동력핵과 지옥절단기 장갑판을 얻은 후, 와일드해머 성채에 있는 편대사령관 누아인에게 가져가야 합니다.‡Consigue 1 batería de atracador vil y 1 placa de armadura de atracador vil. Llévaselas al comandante del aire Nuainn en el Bastión Martillo Salvaje.‡Consigue 1 batería de atracador vil y 1 placa de armadura de atracador vil. Llévaselas al comandante del aire Nuainn en el Bastión Martillo Salvaje.‡Procurez-vous une Batterie de saccageur gangrené et une Plaque de blindage de saccageur gangrené. Apportez-les au Chef d\'escadrille Nuainn au Bastion des Marteaux-Hardis.‡将魔能机甲动力核心和魔能机甲护板交给蛮锤要塞的空军指挥官努埃恩。‡取得一個惡魔搶奪者能量核心，一個惡魔搶奪者能量母體，還有一個惡魔搶奪者鎧甲並將這些東西帶給蠻錘要塞的空軍指揮官奴艾恩。',
  }
},
[10573] = {
  {
    'A Forja da Morte‡Кузница Смерти‡Die Todesschmiede‡죽음의 괴철로‡La Forja Muerta‡La Forja Muerta‡La Forgemort‡死亡熔炉‡死亡熔爐',
    nil,
    'Apresente-se a Ewan Asalouca, o Arrojado, na Torre da Forja da Morte.‡Поговорите с штормером Эваном Дикокрылом в башне Кузницы Смерти.‡Meldet Euch bei Sturmrufer Ewan Wildschwinge im Turm der Todesschmiede.‡죽음의 괴철로 탑에 있는 돌격대원 에완 와일드윙에게 보고해야 합니다.‡Preséntate al agitador Ewan Alasalvaje en la Torre de La Forja Muerta.‡Preséntate al agitador Ewan Alasalvaje en la Torre de La Forja Muerta.‡Présentez-vous à Ewan Aile-sauvage le Tempétueux à la Tour de la Forgemort.‡前往死亡熔炉哨塔向伊万·蛮翼报到。‡向死亡熔爐哨塔的天鳴者艾文·野翼回報。',
  }
},
[10574] = {
  {
    'Os corruptores Grislíngua‡Осквернители из клана Пеплоустов‡Die Verderber der Aschenzungen‡잿빛혓바닥 타락자‡Los corruptores Lengua de Ceniza‡Los corruptores Lengua de Ceniza‡Les corrupteurs cendrelangues‡灰舌腐蚀者‡灰舌墮落者',
    nil,
    'Obtenha os quatro fragmentos de medalhão com Haalum, Eykenen, Lakaan e Uylaru e procure a Anacoreta Ceyla no Altar de Sha\'tar, que fica no Vale da Lua Negra.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Добудьте 4 фрагмента медальона у Хаалума, Айкенена, Уйлару, и Лакаана и вернитесь к анахоретке Сейле к алтарю Ша\'тар в долине Призрачной Луны.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Beschafft die vier Medaillonfragmente von Haalum, Eykenen, Lakaan und Uylaru und kehrt danach zu Anachoret Ceyla beim Altar der Sha\'tar im Schattenmondtal zurück.nnDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡할룸, 에이케넨, 라칸, 우일라루를 처치하고 메달 조각 4개를 입수한 후 어둠달 골짜기의 샤타르 제단에 있는 수도자 케일라에게 가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 당신의 평판은 떨어질 것입니다.‡Recupera los 4 trozos de los medallones de Haalum, Eyeknen, Lakaan y Uylaru, y regresa junto al anacoreta Ceyla del Altar de Sha\'tar, en el Valle Sombraluna.nnA medida que completas misiones para los Aldor disminuye tu nivel de reputación con los Arúspices.‡Recupera los 4 trozos de los medallones de Haalum, Eyeknen, Lakaan y Uylaru, y regresa junto a la anacoreta Ceyla del Altar de Sha\'tar, en el Valle Sombraluna.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Procurez-vous les quatre fragments du médaillon sur Haalum, Eykenen, Lakaan et Uylaru et rapportez-les à l\'anachorète Ceyla à l\'Autel de Sha\'tar dans la vallée d\'Ombrelune.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡从哈鲁姆、埃肯尼、拉坎恩和乌拉鲁手中夺得他们的勋章碎片，并把这些碎片交给影月谷沙塔尔祭坛的学者希拉。nn为奥尔多阵营完成任务将降低你在占星者阵营中的声望等级。‡從哈盧姆，伊肯尼恩，拉卡恩和烏拉魯那邊取回四個勳章碎片然後回到影月谷的薩塔祭壇找隱士希拉。|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10575] = {
  {
    'A Jaula do Carcereiro‡Клеть Стражницы‡Der Kerker des Wächters‡감시자의 수용소‡La Jaula de la Guardiana‡La Jaula de la Guardiana‡La Cage de la gardienne‡守望者的牢笼‡典獄官監牢',
    nil,
    'A Anacoreta Ceyla quer que você entre na Jaula do Carcereiro, ao sul das Ruínas de Baa\'ri e interrogue Sanoru quanto à localização de Akama.nnCompletar missões para os Aldor reduzirá sua reputação junto aos Áugures.‡Отправляйтесь в Клеть Стражницы, к югу от руин Баа\'ри и расспросите Санору о местонахождении Акамы для анахоретки Сейлы.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Ceyla möchte, dass Ihr den Kerker des Wächters südlich der Ruinen von Baa\'ri betretet und Sanoru befragt, um Akamas Aufenthaltsort herauszufinden.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Seher.‡수도자 케일라가 바아리 폐허의 남쪽에 있는 감시자의 수용소로 들어가서 사노루를 심문해 아카마의 행방을 알아봐 달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 당신의 평판은 떨어질 것입니다.‡La anacoreta Ceyla quiere que entres en la Jaula de la Guardiana, al sur de las Ruinas de Baa\'ri, e interrogues a Sanoru sobre el paradero de Akama.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡La anacoreta Ceyla quiere que entres en la Jaula de la Guardiana, al sur de las Ruinas de Baa\'ri, e interrogues a Sanoru sobre el paradero de Akama.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'anachorète Ceyla veut que vous entriez dans la Cage de la gardienne, au sud des ruines de Baa\'ri, et que vous interrogiez Sanoru pour apprendre où se trouve Akama.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡学者希拉要求你进入巴尔里废墟以南的守望者牢笼，从萨诺鲁口中审问出阿卡玛的下落。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡隱士希拉要你去典獄官監牢，它的位置在巴瑞廢墟的南邊並且逼問杉諾魯關於阿卡瑪的下落。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10576] = {
  {
    'O golpe Lua Negra‡Уловки Призрачной Луны‡Unterwürfigkeit in Schattenmond‡어둠달의 속임수‡Revuelo en Sombraluna‡Revuelo en Sombraluna‡Le bonneteau d\'Ombrelune‡影月谷的乔装者‡影月谷的潛行',
    nil,
    'Borak, Filho de Oronok, que está na ponte perto da Ponta do Eclipse, no Vale da Lua Negra, quer que você recupere 6 peças de Armadura Eclipsion.‡Принесите 6 фрагментов доспехов из лагеря Затмения Бораку, сыну Оронока, на мост возле лагеря Затмения в долине Призрачной Луны.‡Borak, Sohn von Oronok, bei der Brücke in der Nähe der Stätte der Mondfinsternis im Schattenmondtal möchte, dass Ihr 6 Teile der Rüstung der Mondfinsternis besorgt.‡어둠달 골짜기의 해그늘 주둔지 근처에 있는 오로노크의 아들 보라크가 해그늘 방어구 6벌을 구해오라고 했습니다.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes 6 piezas de armadura eclipsion.|n‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes 6 piezas de armadura eclipsion.|n‡Borak, fils d\'Oronok, du pont qui se trouve près de la halte de l\'Éclipse dans la vallée d\'Ombrelune, vous demande de récupérer 6 pièces d\'Armure éclipsion.‡将6件日蚀护甲交给位于影月谷日蚀岗哨附近石桥处的欧鲁诺克之子伯拉克。‡位在影月谷靠近日蝕崗哨一座橋上的柏爾拉克, 歐朗諾克之子要你找回6件日蝕護甲。',
  }
},
[10577] = {
  {
    'O que Illidan quer, Illidan consegue...‡Чего Иллидан хочет, Иллидан получит...‡Was Illidan will, soll Illidan bekommen...‡일리단은 원하면, 갖는다...‡Lo que Illidan quiere, lo consigue...‡Lo que Illidan quiere, lo consigue...‡Ce qu\'Illidan veut, Illidan l\'obtient…‡伊利丹的信使......‡予取予求的伊利丹……',
    nil,
    'Borak, Filho de Oronok, que está na ponte perto da Ponta do Eclipse, no Vale da Lua Negra, quer que você entregue a Mensagem de Illidan ao Grão-comandante Ruusk na Ponta do Eclipse.‡Доставьте послание Иллидана главнокомандующему Рууску в лагерь Затмения.‡Borak, Sohn von Oronok, bei der Brücke in der Nähe der Stätte der Mondfinsternis im Schattenmondtal möchte, dass Ihr Großkommandant Ruusk in der Stätte der Mondfinsternis Illidans Nachricht überbringt.‡어둠달 골짜기의 해그늘 주둔지 근처에 있는 오로노크의 아들 보라크가 해그늘 주둔지에 있는 총사령관 루스크에게 일리단의 전갈을 전해 달라고 했습니다.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que entregues el mensaje de Illidan al Gran Comandante Ruusk de Punta Eclipse.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que entregues el mensaje de Illidan al Gran Comandante Ruusk de Punta Eclipse.‡Borak, fils d\'Oronok, du pont qui se trouve près de la halte de l\'Éclipse dans la vallée d\'Ombrelune, vous demande de remettre le message d\'Illidan au grand commandant Ruusk à la halte de l\'Éclipse.‡位于影月谷日蚀岗哨附近石桥处的欧鲁诺克之子伯拉克要求你将伊利丹的口信传达给日蚀岗哨的总指挥官卢斯克。‡位在影月谷靠近日蝕崗哨的一座橋上的柏爾拉克, 歐朗諾克之子要你傳遞伊利丹的一段訊息給日蝕崗哨的大指揮官魯斯克。',
  }
},
[10578] = {
  {
    'A Cifra da Danação: a missão de Borak‡Код Проклятия – Вклад Борака‡Die Litanei der Verdammnis - Boraks Angriff‡파멸의 암호 - 보라크의 임무‡La Clave de Condenación: La carga de Borak‡La Clave de Condenación: La carga de Borak‡La Formule de damnation - la charge de Borak‡诅咒密码 - 伯拉克的命令‡毀滅密碼 - 柏爾拉克的命令',
    nil,
    'Borak, Filho de Oronok, que está na ponte perto da Ponta do Eclipse, no Vale da Lua Negra, quer que você recupere o Terceiro Fragmento da Cifra da Danação com Ruul, o Obscurecente.nnNesta missão, será melhor ir em grupo.‡Отберите для Борака, сына Оронока, третью часть Кода Проклятия у Руула Светокрада.nnДля выполнения этого задания вам потребуются помощники.‡Borak, Sohn von Oronok, bei der Brücke in der Nähe der Stätte der Mondfinsternis im Schattenmondtal möchte, dass Ihr den dritten Teil der Litanei der Verdammnis von Ruul dem Verfinsterer besorgt.nnFür diesen Auftrag werdet Ihr eine Gruppe benötigen.‡어둠달 골짜기, 해그늘 주둔지 근처의 다리에 있는 오로노크의 아들 보라크가 암흑의 인도자 루울을 처치하고 세 번째 파멸의 암호 조각을 찾아와 달라고 부탁했습니다.nn이번 임무는 반드시 동료들과 함께 수행해야 할 것입니다.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes la tercera parte de la Clave de Condenación de Ruul el Ensombrecedor.nnPara esta misión hará falta un grupo.‡Borak, hijo de Oronok, en el puente próximo a la Punta Eclipse en el Valle Sombraluna, quiere que recuperes la tercera parte de la Clave de Condenación de Ruul el Ensombrecedor.|n|nPara esta misión hará falta un grupo.‡Borak, fils d\'Oronok, du pont qui se trouve près de la halte de l\'Éclipse dans la vallée d\'Ombrelune, vous demande de prendre la Troisième partie de la formule de damnation à Ruul l\'Assombrisseur.nnCette mission nécessite un groupe.‡从亵渎者鲁尔手中夺回诅咒密码的第二块碎片，然后向位于影月谷日蚀岗哨附近石桥处的欧鲁诺克之子伯拉克复命。nn该任务最好组队完成。‡影月谷的日蝕崗哨附近橋上的柏爾拉克, 歐朗諾克之子要你從『晦暗者』魯歐身上奪回毀滅密碼第三部。|n這個任務將會需要組隊來完成。',
  }
},
[10579] = {
  {
    'A Cifra da Danação: terceiro fragmento recuperado‡Код Проклятия – Третий фрагмент‡Die Litanei der Verdammnis - Dritter Teil‡파멸의 암호 - 세 번째 조각 입수‡La Clave de Condenación: Tercer trozo recuperado‡La Clave de Condenación: Tercer trozo recuperado‡La Formule de damnation - Troisième fragment retrouvé‡诅咒密码 - 第三块碎片‡毀滅密碼 - 取回第三部',
    nil,
    'Leve o Cofre de Borak para Oronok Coração-partido na Fazenda de Oronok, no Vale da Lua Negra.‡Принесите сейф Борака Ороноку Горемычному на ферму Оронока в Долине Призрачной Луны.‡Bringt Boraks Schließkassette zu Oronok Herzeleid bei Oronoks Hof im Schattenmondtal.‡어둠달 골짜기의 오로노크의 농장에 있는 비통의 오로노크에게 보라크의 금고를 가져가야 합니다.‡Lleva la caja fuerte de Borak a Oronok Corazón Roto en la Granja de Oronok, en el Valle Sombraluna.‡Lleva la caja fuerte de Borak a Oronok Corazón Roto en la Granja de Oronok, en el Valle Sombraluna.‡Apportez le coffret de Borak à Oronok Cœur-fendu à la Ferme d\'Oronok dans la vallée d\'Ombrelune.‡将伯拉克的箱子交给影月谷欧鲁诺克农场的欧鲁诺克-裂心。‡帶著柏爾拉克的帶鎖箱到影月谷的歐朗諾克的農場交給歐朗諾克·碎心。',
  }
},
[10580] = {
  {
    'Cadê o gnomo que estava aqui?‡Куда подевались эти клятые гномы?‡Wo sind diese verdammten Gnome hin?‡토쉴리와 그의 친구들은 어디로?‡¿Dónde se han metido esos malditos gnomos?‡¿Dónde se han metido esos malditos gnomos?‡Où sont passés ces fichus Gnomes ?‡侏儒都去哪里了？‡這些該死的地精跑去哪裡了?',
    nil,
    'Investigue a área sul da Serra dos Espigões nas Montanhas da Lâmina Afiada para encontrar algum indício do paradeiro de Tocha e dos outros gnomos.‡Командир Тень Небес просит вас обыскать южные районы Зазубренной гряды Острогорья, чтобы найти, где сейчас Тошли и прочие гномы.‡Kommandant Himmelschatten möchte, dass Ihr im südlichen Teil des Zackengrats im Schergrat nach Hinweisen auf den Verbleib von Toshley und seinen Gnomenfreunden sucht.‡칼날 산맥에 있는 뾰족 마루의 남쪽 지역에서 토쉴리와 그의 친구들의 소재를 밝힐 수 있는 단서를 찾아야 합니다.‡El comandante Cielosombra ha pedido que busques hacia el sur de la Cresta Dentada, en las Montañas Filospada, alguna pista sobre el paradero de Toshley y los demás gnomos.‡‡Fouillez la zone sud de la Crête dentelée, dans les Tranchantes pour y trouver des indices quant à l\'endroit où pourraient se trouver Toshley et les autres Gnomes.‡指挥官萨卡斯·天影要求你到刀锋山地区去，在锯齿山的南侧搜索有关托什雷和其他侏儒的下落。‡指揮官天影要求你去劍刃山脈南邊的鋸齒山脊尋找托斯利還有其他地精去向的線索。',
  }
},
[10581] = {
  {
    'Siga as migalhas de pão‡Иди по крошечкам!‡Folget den Brotkrumen‡예비 부품을 따라서‡Sigue el rastro‡Sigue el rastro‡Suivre les miettes‡废话连篇‡跟著痕跡走',
    nil,
    'Siga a trilha de peças na ladeira para o Espinhaço Cortante. Fale com Tocha na Estação do Tocha, nas Montanhas da Lâmina Afiada.‡Р-3Д0 намекает вам, что если вы пойдете по следу из запчастей вверх по склону на Островерхий гребень, вы найдете гномов в месте, именуемом станция Тошли.nnЕсли найдете Тошли, поговорите с ним.‡Auf eine verquere Art hat R-3D0 Euch gesagt, dass Ihr der Spur aus Ersatzteilen den Weg hinauf zum Messergrat folgen müsst, um die Gnome an einem Ort namens Toshleys Station zu finden.nnSprecht mit Toshley, wenn Ihr ihn findet.‡예비 부품들이 널려 있는 길을 따라 칼날 마루로 올라가야 합니다. 칼날 산맥의 토쉴리의 연구기지에서 토쉴리와 대화해야 합니다.‡Sigue el rastro de piezas sueltas por la rampa que conduce a Loma Tajo. Habla con Toshley en la Estación de Toshley, en las Montañas Filospada.‡‡Suivez la piste de pièces détachées tombées le long de la rampe vers la Tranchecrête. Parlez à Toshley au poste de Toshley, dans les Tranchantes.‡伴随着无数的废话，R-3D0告诉你，如果你继续跟着这些散落在地上的零件走下去，并越过前面这道斜坡走上剃刀山的话，就可以在一处叫作"托什雷的基地"的地方找到侏儒们。nn到达那里之后与托什雷谈一谈。‡講了一圈，原來R-3D0型機器人已經告訴你跟著散落地面的零件痕跡上斜坡到剃刀山脊，你就會發現地精們在一個叫做托斯利基地的地方。|n假如你找的到托斯利的話，跟他談談吧。',
  }
},
[10582] = {
  {
    'Lacaios do Concílio das Sombras‡Приспешники Совета Теней‡Diener des Schattenrats‡어둠의 의회의 부하들‡Esbirros del Consejo de la Sombra‡Esbirros del Consejo de la Sombra‡Les séides du Conseil des ombres‡暗影议会的爪牙‡暗影議會的爪牙',
    nil,
    'Ewan Asalouca, o Arrojado, na Torre da Forja da Morte, quer que você mate 10 Guardiões da Forja da Morte e 5 Evocadores da Forja da Morte.‡Убейте 10 стражей и 5 призывателей из Кузницы Смерти для штормера Эвана Дикокрыла.‡Sturmrufer Ewan Wildschwinge beim Turm der Todesschmiede möchte, dass Ihr 10 Wächter der Todesschmiede und 5 Beschwörer der Todesschmiede tötet.‡죽음의 괴철로 탑에 있는 돌격대원 에완 와일드윙이 죽음의 괴철로 수호병 10명과 죽음의 괴철로 소환사 5명을 처치해 달라고 했습니다.‡El agitador Ewan Alasalvaje, en la Torre de La Forja Muerta, quiere que mates a 10 guardianes Forja Muerta y a 5 invocadores Forja Muerta.‡El agitador Ewan Alasalvaje, en la Torre de La Forja Muerta, quiere que mates a 10 guardianes Forja Muerta y a 5 invocadores Forja Muerta.‡Ewan Aile-sauvage le Tempétueux à la Tour de la Forgemort veut que vous tuiez 10 Gardiens de la Forgemort et 5 Invocateurs de la Forgemort.‡杀死10个死亡熔炉守护者和5个死亡熔炉召唤者，然后向死亡熔炉哨塔的伊万·蛮翼复命。‡死亡熔爐哨塔的天鳴者艾文·野翼要你去殺10個死亡熔爐守護者還有5個靈魂行者。',
  }
},
[10583] = {
  {
    'O destino de Flanis‡Судьба Фланиса‡Flanis\' Schicksal‡플라니스의 생사 확인‡El destino de Flanis‡El destino de Flanis‡Le destin de Flanis‡弗兰尼斯的命运‡弗藍尼斯的命運',
    nil,
    'Ewan Asalouca, o Arrojado, na Torre da Forja da Morte, quer que você vasculhe a Forja da Morte em busca de Flanis Celerasa e recupere a Mochila de Flanis.‡Разыщите Фланиса Быстрокрыла в Кузнице Смерти, и принесите его сумку штормеру Эвану Дикокрылу в башню Кузницы Смерти.‡Sturmrufer Ewan Wildschwinge beim Turm der Todesschmiede möchte, dass Ihr die Todesschmiede nach Flanis Flinkschwinge absucht und Flanis\' Beutel zurückholt.‡죽음의 괴철로 탑에 있는 돌격대원 에완 와일드윙이 죽음의 괴철로에서 플라니스 스위프트윙을 찾고 플라니스의 짐꾸러미를 입수해 달라고 했습니다.‡El agitador Ewan Alasalvaje, en la Torre de La Forja Muerta, quiere que busques en La Forja Muerta a Flanis Alapresta y recuperes su talega.‡El agitador Ewan Alasalvaje, en la Torre de La Forja Muerta, quiere que busques en La Forja Muerta a Flanis Alapresta y recuperes su talega.‡Ewan Aile-sauvage le Tempétueux, à la Tour de la Forgemort, veut que vous alliez fouiller la Forgemort à la recherche de Flanis Aile-vive et que vous récupériez le Sac de Flanis.‡死亡熔炉哨塔的伊万·蛮翼要你前往死亡熔炉寻找弗兰尼斯·迅翼，并找回弗兰尼斯的背包。‡死亡熔爐哨塔的天鳴者艾文·野翼要你去死亡熔爐搜索弗藍尼斯·迅翼並且找回弗藍尼斯的包包。',
  }
},
[10584] = {
  {
    'Recuperando os conversores‡Спасти преобразователи энергии!‡Ein paar Stromwandler besorgen‡마력 변환기 수집‡Recoger transformadores de energía‡Recoger transformadores de energía‡Récupérer quelques convertisseurs de puissance‡能量转换器‡收集能量轉換器',
    nil,
    'Use o Coletor de Magneto Protovoltaico para coletar 5 Eletromentais.‡Тошли просит вас взять протовольтаический магнетоколлектор и поймать 5 электроменталей. По выполнении вернуться к нему на станцию Тошли в Острогорье.‡Toshley möchte, dass Ihr den protovoltaischen Magnetsammler benutzt, um 5 Elektromentare einzufangen. Kehrt danach zu Toshleys Station im Schergrat zurück.‡광발전 자기 수집기를 사용하여 전자정신체 5개를 수집한 후 칼날 산맥의 토쉴리의 연구기지에 있는 토쉴리에게 돌아가야 합니다.‡Toshley ha pedido que te lleves el acumulador magnético protovoltaico y reúnas 5 electromentales. Vuelve junto a él en la Estación de Toshley, en las Montañas Filospada, cuando lo hayas hecho.‡‡Utilisez le Collecteur magnétique proto-voltaïque pour récupérer 5 Electromentaires.‡托什雷要你使用电磁收集器收集5个电荷元素，完成之后回到托什雷的基地向他复命。‡托斯利要你帶著原始電磁集電器去收集5個電流體。任務完成時回去劍刃山脈的托斯利基地找托斯利。',
  }
},
[10585] = {
  {
    'A câmara de evocação‡Чертог Призыва‡Die Beschwörungskammer‡소환의 방‡La cámara de invocación‡La cámara de invocación‡La chambre d\'invocation‡召唤之厅‡召喚密室',
    nil,
    'Obtenha um Deslocador Elemental com um Ferreiro da Forja da Morte ou um Engenhoqueiro da Forja da Morte. Use o dispositivo para interromper o ritual na câmara de evocação. Apresente-se a Ewan Asalouca, o Arrojado, na Torre da Forja da Morte, depois de completar a missão.‡Раздобудьте стихийный подчинитель у кузнеца или ремонтника из Кузницы Смерти и используйте его, чтобы прервать ритуал в чертоге призыва. Доложите о выполнении задания штормеру Эвану Дикокрылу из башни Кузницы Смерти.‡Besorgt Euch eine Elementarsteuerung von einem Schmied der Todesschmiede oder einem Tüftler der Todesschmiede. Benutzt sie, um das Ritual in der Beschwörungskammer zu unterbrechen. Meldet Euch danach bei Sturmrufer Ewan Wildschwinge im Turm der Todesschmiede zurück.‡죽음의 괴철로 대장장이나 죽음의 괴철로 땜장이에게서 정령 재배열기를 입수한 후에 그것을 사용하여 소환의 방 안의 의식을 중단시켜야 합니다. 임무를 달성한 후에 죽음의 괴철로 탑에 있는 돌격대원 에완 와일드윙에게 돌아가 보고하십시오.‡Consigue 1 desplazador elemental de un herrero Forja Muerta o de un manitas Forja Muerta, y úsalo para perturbar el ritual de la cámara de invocación. Preséntate al agitador Ewan Alasalvaje en la Torre de La Forja Muerta cuando hayas completado la tarea.‡Consigue 1 desplazador elemental de un herrero Forja Muerta o de un manitas Forja Muerta, y úsalo para perturbar el ritual de la cámara de invocación. Preséntate al agitador Ewan Alasalvaje en la Torre de La Forja Muerta cuando hayas completado la tarea.‡Procurez-vous un Déplaceur élémentaire sur un Forgeron de la Forgemort ou un Bricoleur de la Forgemort et utilisez-le pour interrompre le rituel dans la chambre d\'invocation. Faites votre rapport à Ewan Aile-sauvage le tempétueux à la Tour de la Forgemort lorsque vous aurez accompli cette tâche.‡从死亡熔炉铁匠或死亡熔炉杂役身上取得元素置换器，用它打断召唤大厅中的召唤仪式。完成任务后返回死亡熔炉哨塔向伊万·蛮翼复命。‡從死亡熔爐鐵匠或者死亡熔爐技工身上獲得一個元素替換器並且使用它來中斷召喚密室中的儀式。任務完成後回報給死亡熔爐哨塔的天鳴者艾文·野翼。',
  }
},
[10586] = {
  {
    'Acabe com o Armipotente!‡Смерть вестнику войны!‡Nieder mit dem Kriegshetzer!‡전쟁인도자 라주운 처치!‡¡Tumba al belisario!‡¡Tumba al belisario!‡Abattez le porteguerre !‡击败战争使者！‡擊敗戰爭使者!',
    nil,
    'Derrote o Armipotente Razuun, recolha as Ordens de Razuun, e apresente-se ao Comandante de Ala Nuainn na Fortaleza Martelo Feroz, no Vale da Lua Negra.‡Убейте Разууна Завоевателя, заберите его приказы и вернитесь к командиру звена Нуаинну в цитадель Громового Молота.‡Besiegt Kriegshetzer Razuun, beschafft Razuuns Befehle und meldet Euch bei Schwadronskommandant Nuainn in der Wildhammerfeste.‡전쟁인도자 라주운을 처치하고 라주운의 명령서를 되찾은 후, 와일드해머 성채에 있는 편대사령관 누아인에게 보고해야 합니다.‡Derrota al belisario Razuun, recupera sus órdenes y después preséntate al comandante del aire Nuainn del Bastión Martillo Salvaje.‡Derrota al belisario Razuun, recupera sus órdenes y después preséntate al comandante del aire Nuainn del Bastión Martillo Salvaje.‡Tuez le porteguerre Razuun, récupérez les Ordres de Razuun et retournez voir le chef d\'escadrille Nuainn, au bastion des Marteaux-Hardis.‡击败战争使者拉索恩，取回拉索恩的命令，然后返回蛮锤要塞向空军指挥官努埃恩复命。‡擊敗戰爭使者瑞術恩，取回瑞術恩的指令，然後回報給蠻錘要塞的空軍指揮官奴艾恩。',
  }
},
[10587] = {
  {
    'Campo de treinamento Karabor‡Тренировочная площадка Карабора‡Ausbildungsgelände von Karabor‡카라보르 훈련소‡Patio de Armas de Karabor‡Patio de Armas de Karabor‡Les terrains d\'entraînement de Karabor‡卡拉波训练场‡卡拉伯爾訓練場',
    nil,
    'A Exarca Onaala, no Altar de Sha\'tar, quer que você obtenha 8 Glaives Solfúria dos Caçadores de Demônios Suplicantes e Caçadores de Demônios Iniciados nas Ruínas de Karabor, a sudeste do Altar de Sha\'tar.nnCumprir missões para os Áugures fará com que a sua reputação entre os Aldor diminua.‡Отберите для экзарха Онаалы у соискателей и посвященных охотников на демонов, сосредоточенных в руинах Карабора, 8 глеф армии Ярости Солнца.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Exarch Onaala beim Altar der Sha\'tar möchte, dass Ihr 8 Gleven des Sonnenzorns von den Bittstellern der Dämonenjäger und den Initianden der Dämonenjäger in den Ruinen von Karabor, südöstlich des Altars der Sha\'tar, beschafft.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤타르 제단에 있는 총독 오날라가 샤타르 제단 남동쪽에 있는 카라보르 폐허에 있는 악마사냥꾼 지원자와 수습 악마사냥꾼들을 처치하고 성난태양 글레이브 8개를 입수해 달라고 부탁했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La exarca Onaala del Altar de Sha\'tar quiere que consigas 8 gujas de Furia del Sol de los suplicantes cazadores de demonios y de los iniciados cazadores de demonios que se encuentran en las Ruinas de Karabor, al sureste del Altar de Sha\'tar.nnA medida que completas misiones para los Aldor disminuye tu nivel de reputación con los Arúspices.‡La exarca Onaala del Altar de Sha\'tar quiere que consigas 8 gujas de Furia del Sol de los suplicantes cazademonios y de los iniciados cazademonios que se encuentran en las Ruinas de Karabor, al sureste del Altar de Sha\'tar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'exarque Onaala de l\'Autel de Sha\'tar veut que vous vous procuriez 8 Glaives solfurie sur les Suppliants chasseurs de démons et les Initiés chasseurs de démons aux Ruines de Karabor, au sud-est de l\'Autel de Sha\'tar.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡沙塔尔祭坛的大主教欧纳拉要你前往沙塔尔祭坛东南方的卡拉波废墟，从恶魔猎手学员和恶魔猎手新兵身上夺取8柄日怒阔剑。nn为奥尔多完成任务将会降低你在占星者阵营中的声望等级。‡薩塔祭壇的主教歐納拉要你從薩塔祭壇東南方卡拉伯爾廢墟裡，從惡魔獵人懇求者和惡魔獵人見習生的身上奪回8把日怒大刀。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10588] = {
  {
    'A Cifra da Danação‡Код Проклятия‡Die Litanei der Verdammnis‡파멸의 암호‡La Clave de Condenación‡La Clave de Condenación‡La formule de damnation‡诅咒密码‡毀滅密碼',
    nil,
    'Use a Cifra da Danação no Altar da Danação para evocar Cyrukh, o Senhor do Fogo.nnDestrua Cyrukh, o Senhor do Fogo, e então fale com o Reparador da Terra Torlok no Altar da Danação.‡Используйте Код Проклятия у Алтаря Проклятия, чтобы призвать Цируха Повелителя Огня.nnУничтожьте его и пообщайтесь с целителем земли Торлоком, которого вы найдете там же.‡Benutzt die Litanei der Verdammnis am Altar der Verdammnis um Cyrukh den Feuerlord zu rufen.nnVernichtet Cyrukh den Feuerlord und sprecht danach mit Erdheiler Torlok, der sich ebenfalls am Altar der Verdammnis befindet.‡저주의 제단에서 파멸의 암호를 사용하여 불의 군주 사이루크를 소환해야 합니다.nn불의 군주 사이루크를 파괴한 후 저주의 제단에 있는 대지치유사 토르록과 대화하십시오.‡Usa la Clave de Condenación en El Altar de Condenación para invocar a Cyrukh el señor del Fuego.nnDestruye a Cyrukh el señor del Fuego y habla con el ensalmador de la tierra Torlok, que también se encuentra en El Altar de Condenación.‡Usa la Clave de Condenación en El Altar de Condenación para invocar a Cyrukh el señor del Fuego.|n|nDestruye a Cyrukh el señor del Fuego y habla con el ensalmador de la tierra Torlok, que también se encuentra en El Altar de Condenación.‡Utilisez la Formule de damnation à l\'Autel de la damnation pour invoquer Cyrukh le seigneur du Feu.nnDétruisez Cyrukh le seigneur du Feu puis parlez au Soigneterre Torlok, qui se trouve aussi à l\'Autel de la damnation.‡在诅咒祭坛念诵诅咒密码，召唤出火焰之王森卢肯。nn杀死火焰之王森卢肯，然后与诅咒祭坛的大地治愈者托洛克谈一谈。‡在詛咒祭壇使用毀滅密碼，召喚『火焰之王』賽洛庫。|n殺死火焰之王賽洛庫然後去跟大地治癒者托爾洛克談話，你同樣可以在詛咒祭壇找到他。',
  }
},
[10589] = {
  {
    'Obtendo acesso‡Получение доступа‡Zugang erlangen‡순간이동기로 접근‡Obtener acceso‡Obtener acceso‡Obtenir un accès‡控制权‡進入的方法',
    nil,
    'Traga um Controle do Teleportador da Legião ao Comandante de Ala Nuainn na Fortaleza Martelo Feroz, no Vale da Lua Negra. Os Armeiros Mo\'args na Cidadela da Legião costumam carregar os dispositivos.‡Принесите пульт от телепорта Легиона командиру звена Нуаинну из цитадели Громового Молота. Пульты можно найти у мо\'аргов-оружейников в форте Легиона.‡Bringt eine Teleportersteuerung der Legion zu Schwadronskommandant Nuainn in der Wildhammerfeste. Bekanntlich tragen die Waffenschmiede der Mo\'arg in der Feste der Legion diese Geräte bei sich.‡와일드해머 성채에 있는 편대사령관 누아인에게 불타는 군단 요새의 모아그 무기제작자가 지니고 다니는 군단 순간이동기 제어장치를 가져가야 합니다.‡Llévale un control de teletransportador de la Legión al comandante del aire Nuainn del Bastión Martillo Salvaje. Sabemos que los forjadores de armas y los caminantes de cólera Mo\'arg del Bastión de la Legión llevan estos instrumentos.‡Llévale un control de teletransportador de la Legión al comandante del aire Nuainn del Bastión Martillo Salvaje. Sabemos que los forjadores de armas y los caminantes de cólera Mo\'arg del Bastión de la Legión llevan estos instrumentos.‡Apportez une Commande du téléporteur de la Légion au chef d\'escadrille Nuainn au bastion des Marteaux-Hardis. On sait que les Fabricants d\'armes mo\'arg du bastion de la Légion portent ces appareils.‡将军团传送控制器交给蛮锤要塞的空军指挥官努埃恩。据说军团要塞的莫尔葛武器匠身上携带着这东西。‡將軍團傳送門控制器交給蠻錘要塞的空軍指揮官奴艾恩。軍團要塞的莫阿格武器鐵匠都會攜帶這種儀器。',
  }
},
[10590] = {
  {
    'Prove seu ódio‡Доказательство ненависти‡Beweist Euren Hass!‡그대 가슴속 증오를 증명하라‡Demuestra tu odio‡Demuestra tu odio‡Sachez prouver votre haine‡仇恨的证明‡復仇的證明',
    nil,
    'Mehlar Aurolume, no Baluarte, quer que você leve 20 Pedras do Flagelo do Lacaio para ele.‡Принесите 20 камней Плети приспешников Мелару Клинку Рассвета из Бастиона.‡Mehlar Dämmerklinge beim Bollwerk möchte, dass Ihr ihm 20 Geißelsteine des Dieners bringt.‡보루에 있는 메라 돈블레이드가 앞잡이의 스컬지석 20개를 가져오라고 했습니다.‡Mehlar Hojalba en El Baluarte quiere que le lleves 20 piedras de la Plaga de los esbirros.‡Mehlar Hojalba en El Baluarte quiere que le lleves 20 piedras de la Plaga de los esbirros.‡Mehlar Aubelame, à la Barricade, veut que vous lui apportiez 20 Pierres du Fléau des serviteurs.‡亡灵壁垒的麦拉·黎明之刃要求你给他带去20枚爪牙的天灾石。‡瑪拉·曦刃要你幫他帶回20個爪牙的天譴石。',
  }
},
[10592] = {
  {
    'Sabedoria da Rainha Banshee‡Мудрость королевы банши‡Die Weisheit der Bansheekönigin‡‡La sabiduría de la reina alma en pena‡La sabiduría de la reina alma en pena‡La sagesse de la reine banshee‡女妖之王的智慧‡女妖之王的智慧',
    nil,
    'Leve os Fragmentos de Pedra do Flagelo para a Grande Dama Sylvana Correventos, na Cidade Baixa.‡Отнесите фрагменты камня Плети Леди Сильване Ветрокрылой в Подгород.‡Bringt die Geißelsteinfragmente zu Fürstin Sylvanas Windläufer in Unterstadt.‡‡Llévale los fragmentos de piedra de la Plaga a Lady Sylvanas Brisaveloz en Entrañas.‡Llévale los fragmentos de piedra de la Plaga a Lady Sylvanas Brisaveloz en Entrañas.‡Apportez les Fragments de pierre du Fléau à dame Sylvanas Coursevent à Fossoyeuse.‡前往幽暗城，将天灾石碎片交给希尔瓦娜斯女王。‡將天譴石碎片交給幽暗城的希瓦娜斯·風行者。',
  }
},
[10593] = {
  {
    'Ancient Evil‡Древнее зло‡Das uralte Böse‡고대의 악마‡Mal ancestral‡Mal ancestral‡Un mal ancien‡远古的邪恶‡古老的禍害',
    nil,
    'Desvende os segredos do Templo de Atal\'Hakkar para libertar Atal\'alarion e arrancar a Trepadeira Pútrida da carne dele. Fale com Mehlar no Baluarte depois que tiver feito isso.‡Раскройте тайны храма Атал\'Хаккар, освободите Атал\'алариона и добудьте гнилую лозу из его плоти. По выполнении задания вернитесь к Мелару в Бастион.‡Lüftet die Geheimnisse des Versunkenen Tempels und befreit Atal\'alarion. Tötet ihn und schneidet die Fäulnisranke aus seinem Fleisch. Kehrt danach zu Mehlar beim Bollwerk zurück.‡아탈학카르 신전의 비밀을 풀고 아탈알라리온을 불러내서 처치해야 합니다. 그런 다음 아탈알라리온의 시체에서 썩은 덩굴을 모아 보루에 있는 메라에게 가져가야 합니다.‡Descubre los secretos de El Templo de Atal\'Hakkar para soltar a Atal\'alarion y recuperar la vid pútrida de su carne. Vuelve a ver a Mehlar en El Baluarte cuando lo hayas hecho.‡Descubre los secretos de El Templo de Atal\'Hakkar para soltar a Atal\'alarion y recuperar la vid pútrida de su carne. Vuelve a ver a Mehlar en El Baluarte cuando lo hayas hecho.‡Percez les secrets du Temple d’Atal’Hakkar pour libérer Atal\'alarion et récupérer dans sa chair la Liane putride. Retournez voir Melhar à la Barricade quand vous aurez terminé cette tâche.‡揭开阿塔哈卡神庙的秘密，释放阿塔拉利恩并击败他，从他的尸体上取走腐烂藤蔓。完成任务之后向亡灵壁垒的麦拉·黎明之刃复命。‡解開阿塔萊神廟的秘密釋放阿塔拉利恩，並且從他的肉體取回腐爛的藤蔓。當你已經完成時，返回亡靈壁壘的米哈爾那裡。',
  }
},
[10594] = {
  {
    'Medindo a frequência de ressonância‡Калибровка резонансной частоты‡Die Klangfrequenz messen‡공명 진폭 측정‡Medir la frecuencia resonante‡Medir la frecuencia resonante‡Mesurer la fréquence de résonance‡测量振荡频率‡測量共振的頻率',
    nil,
    'Coloque os Receptores de Frequências Oscilantes de modo que você seja atingido por 5 campos de Oscilação sobrepostos quando estiver no meio deles.‡Никвинкль Метрогном хочет, чтобы вы расположили осцилляционные сканеры таким образом, чтобы стоя среди них вы оказались в точке перекрытия пяти осцилляционных полей.nnПо выполнении вернитесь к нему на станцию Тошли в Острогорье.‡Schartwinkel der Metrognom möchte, dass Ihr die oszillierenden Schwingungsmesser so anordnet, dass Ihr, wenn Ihr in ihrer Mitte steht, von fünf sich überlappenden Schwingungsfeldern berührt werdet.nnKehrt danach zu Schartwinkel bei Toshleys Station im Schergrat zurück.‡공명 지대가 5개가 되었을 때 공명 진폭 측정기를 설치해야 합니다.‡Coloca los escáneres de frecuencia oscilante de tal forma que cuando estés de pie en medio de los mismos, te alcancen 5 campos de oscilación superpuestos.‡‡Placez les Scanners à fréquence oscillante de telle sorte que, lorsque vous vous tenez en leur centre, vous vous trouvez dans le chevauchement de cinq champs d\'oscillation.‡测量者尼克维克要你将振荡频率扫描器按照一定方式摆放在地上，当你站进中央时，你必须能够同时受到5个重叠扫描场的影响。nn完成任务之后回到托什雷的基地向他复命。‡地鐵地精尼克偉恩寇要你以下列的方式來安裝震盪頻率掃瞄器。你必須在安裝完畢時同時處在五個震盪區域之中。|n完成之後，回到劍刃山脈的托斯利基地向地鐵地精尼克偉恩回報。',
  }
},
[10595] = {
  {
    'Cercados!‡Окружены!‡Belagert!‡포위 상황!‡¡Asediados!‡¡Asediados!‡Assiégés !‡兵临城下！‡圍困!',
    nil,
    'O Guarda-de-sangue Gulmok, do lado de fora da Aldeia Lua Negra, quer que você mate 10 Atacantes Infernais.‡Убейте 10 боевых инферналов для кровавого стража Галмока из деревни Призрачной Луны.‡Blutwache Gulmok außerhalb von Schattenmond möchte, dass Ihr 10 angreifende Höllenbestien tötet.‡어둠달 마을 밖에 있는 혈투사 굴모크가 지옥불정령 돌격병 10마리를 해치워 달라고 했습니다.‡El Guardia de sangre Gulmok, de las afueras de la Aldea Sombraluna, quiere que mates a 10 agresores infernales.‡El Guardia de sangre Gulmok, de las afueras de la Aldea Sombraluna, quiere que mates a 10 agresores infernales.‡Le garde de sang Gulmok, à l\'extérieur du village d\'Ombrelune, vous demande de tuer 10 Attaquants infernaux.‡影月村外的血卫士古尔穆要求你杀死10个地狱火攻击者。‡影月村外面的血衛士高莫克要你去殺10個地獄火攻擊者。',
  }
},
[10596] = {
  {
    'Contra a Cidadela da Legião‡В форт Легиона‡Zur Feste der Legion‡불타는 군단 요새로‡Al Bastión de la Legión‡Al Bastión de la Legión‡Vers le bastion de la Légion‡前往军团要塞‡前往軍團要塞',
    nil,
    'Vá até a Cidadela da Legião, encontre o Dispositivo de Comunicação da Legião, e descubra os planos da Legião enquanto estiver <disfarçado/disfarçada>. Fale novamente com o Guarda-de-Sangue Gulmok na Aldeia Lua Negra quando a missão estiver cumprida.‡Отправляйтесь в форт Легиона, найдите переговорное устройство и, замаскировавшись, выведайте планы Легиона. Вернитесь к кровавому стражу Галмоку в деревню Призрачной Луны, когда выполните задание.‡Begebt Euch zur Feste der Legion, findet ein Kommunikationsgerät der Legion und benutzt es, um mehr über die Pläne der Legion herauszufinden, während Ihr verkleidet seid. Kehrt danach zu Blutwache Gulmok in Schattenmond zurück.‡불타는 군단 요새에 잠입하여 군단 통신 장치를 찾아야 합니다. 그곳에서 변장이 유지되는 동안 불타는 군단의 계획을 알아내십시오. 일을 마치면 어둠달 마을에 있는 혈투사 굴모크에게 돌아가십시오.‡Encamínate al Bastión de la Legión, encuentra el aparato de comunicación de la Legión y averigua los planes de la Legión mientras estés <disfrazado/disfrazada>. Regresa junto al Guardia de sangre Gulmok en la Aldea Sombraluna cuando hayas completado la misión.‡Encamínate al Bastión de la Legión, encuentra el aparato de comunicación de la Legión y averigua los planes de la Legión mientras estés $Gdisfrazado:disfrazada;. Regresa junto al Guardia de sangre Gulmok en la Aldea Sombraluna cuando hayas completado la misión.‡Rendez-vous au Bastion de la Légion, localisez le Système de communication de la Légion et utilisez votre déguisement pour apprendre les plans de la Légion. Retournez voir le garde de sang Gulmok, au village d\'Ombrelune, quand vous aurez accompli votre mission.‡前往军团要塞寻找军团通讯装置。在伪装状态下站在军团通讯装置附近，偷听燃烧军团的计划。完成任务后向影月村的血卫士古尔穆克复命。‡去軍團要塞，找到軍團傳輸設備，然後在偽裝的狀態下打聽燃燒軍團的計畫。任務完成後向影月村的血衛士高莫克回報。',
  }
},
[10597] = {
  {
    'Bomba la bomba‡Сборка бомбы‡Die Bombe bauen‡폭탄의 재료‡Preparación de la bomba‡Preparación de la bomba‡La préparation de la bombe‡制造炸弹‡製作炸彈',
    nil,
    'Obtenha um Núcleo de Força de Aníquilus e uma Placa de Armadura de Aníquilus, e leve-os ao Guarda-de-Sangue Gulmok na Aldeia Lua Negra.‡Добудьте энергетический сердечник и часть обшивки сквернобота для кровавого стража Галмока из деревни Призрачной Луны.‡Besorgt Euch einen Teufelshäscherkraftkern und eine Teufelshäscherrüstungsplatte und bringt sie zu Blutwache Gulmok in Schattenmond.‡지옥절단기 동력핵, 지옥절단기 장갑판을 찾아서 어둠달 마을에 있는 혈투사 굴모크에게 가져가야 합니다.‡Consigue 1 batería de atracador vil y 1 placa de armadura de atracador vil. Llévaselos al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Consigue 1 batería de atracador vil y 1 placa de armadura de atracador vil. Llévaselos al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Procurez-vous une Batterie de saccageur gangrené et une Plaque de blindage de saccageur gangrené. Apportez-les au garde de sang Gulmok au village d\'Ombrelune.‡将魔能机甲动力核心和魔能机甲护板交给影月村的血卫士古尔穆克。‡取得惡魔搶奪者能量核心，惡魔搶奪者能量母體還有惡魔搶奪者鎧甲，把它們帶給影月村的血衛士高莫克。',
  }
},
[10598] = {
  {
    'Os infernais que se explodam!‡Перебей инферналов!‡Jagt die Höllenbestien in die Luft!‡지옥불정령 폭파!‡¡Infernales por los aires!‡¡Infernales por los aires!‡Au diable les infernaux !‡炸毁地狱火！‡引爆地獄火!',
    nil,
    'Use a Bomba Vil em cima do glifo verde na Cidadela da Legião para destruir os infernais, e em seguida apresente-se ao Guarda-de-Sangue Gulmok na Aldeia Lua Negra.‡Используйте бомбу Скверны, находясь в центре зеленого знака в форте Легиона, чтобы уничтожить инферналов. Доложите о выполнении кровавому стражу Галмоку из деревни Призрачной Луны.‡Zündet die Teufelsbombe, während Ihr auf der grünen Glyphe in der Feste der Legion steht. Meldet Euch bei Blutwache Gulmok in Schattenmond zurück, wenn Ihr Euren Auftrag erledigt habt.‡불타는 군단 요새의 녹색 마법진 위에 서서 지옥 폭탄을 사용해 지옥불정령들을 파괴한 다음 어둠달 마을에 있는 혈투사 굴모크에게 보고해야 합니다.‡Usa la bomba vil cuando estés de pie sobre el glifo verde del Bastión de la Legión. Preséntate al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Usa la bomba vil cuando estés de pie sobre el glifo verde del Bastión de la Legión. Preséntate al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Utilisez la Gangrebombe en vous tenant dans le glyphe vert dans le Bastion de la Légion afin de détruire les Infernaux, puis venez faire votre rapport au garde de sang Gulmok, au village d\'Ombrelune.‡站在军团要塞的绿色雕文上使用魔能炸弹消灭地狱火，然后向影月村的血卫士古尔穆克复命。‡當你站在軍團要塞的綠紋圈上面的時候引爆魔化炸彈。當你完成任務，回報給影月村的血衛士高莫克。',
  }
},
[10599] = {
  {
    'A Forja da Morte‡Кузница Смерти‡Die Todesschmiede‡죽음의 괴철로‡La Forja Muerta‡La Forja Muerta‡La Forgemort‡死亡熔炉‡死亡熔爐',
    nil,
    'Apresente-se ao Batedor Zagran no Mirante da Escória.‡Поговорите с разведчиком Заграном на Вышке на золе.‡Meldet Euch bei Späher Zagran in der Schlackenwacht.‡잿가루 감시초소에 있는 척후병 자그란에게 보고해야 합니다.‡Preséntate al explorador Zagran en la Vigía de la Escoria‡Preséntate al explorador Zagran en la Vigía de la Escoria.‡Présentez-vous à l\'éclaireur Zagran au Guet des scories.‡前往熔渣哨塔向斥候萨格兰报到。‡向爐熔守望的斥候薩葛蘭回報。',
  }
},
[10600] = {
  {
    'Lacaios do Concílio das Sombras‡Приспешники Совета Теней‡Diener des Schattenrats‡어둠의 의회의 부하들‡Esbirros del Consejo de la Sombra‡Esbirros del Consejo de la Sombra‡Les séides du Conseil des ombres‡暗影议会的爪牙‡暗影議會的爪牙',
    nil,
    'O Batedor Zagran no Mirante da Escória quer que você mate 10 Guardiões da Forja da Morte e 5 Evocadores da Forja da Morte.‡Убейте 10 стражей и 5 призывателей из Кузницы Смерти для разведчика Заграна с Вышки на золе.‡Späher Zagran in der Schlackenwacht möchte, dass Ihr 10 Wächter der Todesschmiede und 5 Beschwörer der Todesschmiede tötet.‡잿가루 감시초소에 있는 척후병 자그란이 죽음의 괴철로 수호병10명, 죽음의 괴철로 소환사 5명을 해치워 달라고 했습니다.‡El explorador Zagran, en la Vigía de la Escoria, quiere que mates a 10 guardianes Forja Muerta y a 5 invocadores Forja Muerta.‡El explorador Zagran, en la Vigía de la Escoria, quiere que mates a 10 guardianes Forja Muerta y a 5 invocadores Forja Muerta.‡L’Eclaireur Zagran au Guet des scories veut que vous tuiez 10 Gardiens de la Forgemort et 5 Invocateurs de la Forgemort.‡杀死10个死亡熔炉守护者和5个死亡熔炉召唤者，然后向熔渣哨塔的斥候萨格兰复命。‡爐熔守望的斥候薩葛蘭要你去殺10個死亡熔爐守護者還有5個靈魂行者。',
  }
},
[10601] = {
  {
    'O destino de Hagrosh‡Судьба Кагроша‡Kagroshs Schicksal‡카그로쉬의 생사‡El destino de Kagrosh‡El destino de Kagrosh‡Le destin de Kagrosh‡卡格罗什的命运‡凱格羅西的命運',
    nil,
    'O Batedor Zagran no Mirante da Escória quer que você vasculhe a Forja da Morte em busca de Hagrosh e recupere a Mochila de Hagrosh.‡Разыщите Кагроша в Кузнице Смерти и принесите его сумку разведчику Заграну на вышку на золе.‡Späher Zagran in der Schlackenwacht möchte, dass Ihr die Todesschmiede nach Kagrosh absucht und Kagroshs Beutel zurückholt.‡잿가루 감시초소에 있는 척후병 자그란이 죽음의 괴철로를 수색하여 카그로쉬의 짐꾸러미를 찾아달라고 했습니다.‡El explorador Zagran, en la Vigía de la Escoria, quiere que busques en La Forja Muerta a Kagrosh y recuperes su talega.‡El explorador Zagran, en la Vigía de la Escoria, quiere que busques en La Forja Muerta a Kagrosh y recuperes su paquete.‡L\'éclaireur Zagran du Guet des scories veut que vous alliez fouiller la Forgemort à la recherche de Kagrosh et que vous récupériez le Sac de Kagrosh.‡熔渣哨塔的斥候萨格兰要你前往死亡熔炉寻找卡格罗什，并找回卡格罗什的背包。‡爐熔守望的斥候薩葛蘭要你去死亡熔爐尋找凱格羅西還有凱格羅西的背包。',
  }
},
[10602] = {
  {
    'A câmara de evocação‡Чертог Призыва‡Die Beschwörungskammer‡소환의 방‡La cámara de invocación‡La cámara de invocación‡La chambre d\'invocation‡召唤之厅‡召喚密室',
    nil,
    'Obtenha um Deslocador Elemental com um Ferreiro da Forja da Morte ou um Engenhoqueiro da Forja da Morte e use o dispositivo para interromper o ritual na câmara de evocação. Apresente-se ao Batedor Zagran no Mirante da Escória quando tiver cumprindo a missão.‡Раздобудьте стихийный подчинитель у кузнеца или ремонтника из Кузницы Смерти и используйте его, чтобы прервать ритуал в чертоге призыва. Доложите о выполнении задания разведчику Заграну на Вышке на золе.‡Besorgt Euch eine Elementarsteuerung von einem Schmied der Todesschmiede oder einem Tüftler der Todesschmiede. Benutzt sie, um das Ritual in der Beschwörungskammer zu unterbrechen. Meldet Euch danach bei Späher Zagran in der Schlackenwacht zurück.‡죽음의 괴철로 대장장이나 죽음의 괴철로 땜장이를 처치하고 정령 재배열기를 찾은 다음 그것을 사용해 소환실 안에서 벌어지는 의식을 방해해야 합니다. 일을 마친 후 잿가루 감시초소에 있는 척후병 자그란에게 보고하십시오.‡Consigue 1 desplazador elemental de un herrero Forja Muerta o de un manitas Forja Muerta, y úsalo para perturbar el ritual de la cámara de invocación. Vuelve junto al explorador Zagran en la Vigía de la Escoria después de completar esta tarea.‡Consigue 1 desplazador elemental de un herrero Forja Muerta o de un manitas Forja Muerta, y úsalo para perturbar el ritual de la cámara de invocación. Vuelve junto al explorador Zagran en la Vigía de la Escoria después de completar esta tarea.‡Procurez-vous un Déplaceur élémentaire sur un Forgeron de la Forgemort ou un Bricoleur de la Forgemort et utilisez-le pour interrompre le rituel dans la chambre d\'invocation. Faites votre rapport à l\'éclaireur Zagran au Guet des scories lorsque vous aurez terminé votre mission.‡从死亡熔炉铁匠或死亡熔炉杂役身上取得元素置换器，用它打断召唤大厅中的召唤仪式。完成任务后返回熔渣哨塔向斥候萨格兰复命。‡從死亡熔爐鐵匠或者死亡熔爐技工身上取得一個元素替換器，並且使用它來中斷召喚密室中的儀式。任務完成時，回報爐熔守望的斥候薩葛蘭。',
  }
},
[10603] = {
  {
    'Acabe com o Armipotente!‡Смерть вестнику войны!‡Nieder mit dem Kriegsrufer!‡전쟁인도자 라주운을 꺾어라!‡¡Tumba al belisario!‡¡Tumba al belisario!‡Abattez le porteguerre !‡击败战争使者！‡擊敗戰爭使者!',
    nil,
    'Derrote o Armipotente Razuun, recolha as Ordens de Razuun, e apresente-se ao Guarda-de-Sangue Gulmok na Aldeia Lua Negra.‡Убейте завоевателя Разууна, добудьте у него приказы Разууна и вернитесь к кровавому стражу Галмоку в деревню Призрачной Луны.‡Besiegt Kriegshetzer Razuun, beschafft Razuuns Befehle und meldet Euch bei Blutwache Gulmok in Schattenmond.‡전쟁인도자 라주운을 처치하고 라주운의 명령서를 되찾은 후 어둠달 마을에 있는 혈투사 굴모크에게 보고해야 합니다.‡Derrota al belisario Razuun, recupera sus órdenes y después preséntate al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Derrota al belisario Razuun, recupera sus órdenes y después preséntate al Guardia de sangre Gulmok en la Aldea Sombraluna.‡Tuez le porteguerre Razuun, récupérez les Ordres de Razuun et retournez voir le garde de sang Gulmok, au village d\'Ombrelune.‡击败战争使者拉索恩，取回拉索恩的命令，然后返回影月村向血卫士古尔穆克复命。‡擊敗戰爭使者瑞術恩，奪回瑞術恩的指令，然後向影月村的血衛士高莫克回報。',
  }
},
[10604] = {
  {
    'Obtendo acesso‡Получение доступа‡Zugang erlangen‡순간이동기로 접근‡Obtener acceso‡Obtener acceso‡Obtenir un accès‡控制权‡進入的方法',
    nil,
    'Leve um Controle do Teleportador da Legião para o Guarda-de-sangue Gulmok na Aldeia Lua Negra, que fica no Vale da Lua Negra. Os Armeiros Mo\'args na Cidadela da Legião costumam carregar os dispositivos.‡Принесите пульт от телепорта Легиона кровавому стражу Галмоку в деревню Призрачной Луны. Пульты можно найти у мо\'аргов-оружейников в форте Легиона.‡Bringt eine Teleportersteuerung der Legion zu Blutwache Gulmok in Schattenmond. Bekanntlich tragen die Waffenschmiede der Mo\'arg in der Feste der Legion diese Geräte bei sich.‡어둠달 마을에 있는 혈투사 굴모크에게 군단 순간이동기 제어장치를 가져가야 합니다. 불타는 군단 요새의 모아그 무기제작자가 이 장치를 가지고 다닌다고 합니다.‡Llévale un control de teletransportador de la Legión al Guardia de sangre Gulmok de la Aldea Sombraluna. Sabemos que los forjadores de armas y los caminantes de cólera Mo\'arg del Bastión de la Legión llevan estos instrumentos.‡Llévale un control de teletransportador de la Legión al Guardia de sangre Gulmok de la Aldea Sombraluna. Sabemos que los forjadores de armas y los caminantes de cólera Mo\'arg del Bastión de la Legión llevan estos instrumentos.‡Apportez une Commande du téléporteur de la Légion au garde de sang Gulmok, au village d\'Ombrelune. On sait que les Fabricants d\'armes mo\'arg du bastion de la Légion portent ces appareils.‡将军团传送控制器交给影月村的血卫士古尔穆克。据说军团要塞的莫尔葛武器匠身上携带着这东西。‡將軍團傳送門控制器交給影月村的血衛士高莫克。在軍團要塞的莫阿格武器鐵匠都會攜帶這種儀器。',
  }
},
[10605] = {
  {
    'O chamado de Silvério‡Призыв Карендина‡Carendin ruft‡카렌딘의 소환‡Cita con Carendin‡Cita con Carendin‡L\'appel de Carendin‡凯伦丁的召唤‡凱倫丁的召喚',
    nil,
    'Fale com Silvério Hidalgo na Cidade Baixa.‡Поговорите с Карендином Халгаром в Подгороде.‡Sprecht mit Carendin Halgar in Unterstadt.‡언더시티에 있는 카렌딘 할가르와 대화하십시오.‡Habla con Carendin Halgar en Entrañas.‡Habla con Carendin Halgar en Entrañas.‡Parlez à Carendin Halgar à Fossoyeuse.‡与幽暗城的凯伦丁·哈加尔谈一谈。‡跟幽暗城的凱倫丁·哈加爾談話。',
  }
},
[10606] = {
  {
    'A Arte da Manutenção de Aníquilus‡Искусство ухода за скверноботом‡Die Kunst der Teufelshäscherwartung‡지옥절단기 정비술‡El Arte del Cuidado de los Atracadores Viles‡El Arte del Cuidado de los Atracadores Viles‡L\'art de l\'entretien des saccageurs gangrenés‡魔能机甲维修窍门大全‡惡魔搶奪者保養技術',
    nil,
    'Mate o Doutor Gutrick e obtenha a Chave do Doutor. Use a chave para abrir o Cofre do Doutor e pegar A Arte da Manutenção de Aníquilus, e entregue o livro a Pléxis no Ponto de Invasão: Cataclismo.‡Убейте доктора Потрошилло и заберите у него ключ. Откройте этим ключом сейф доктора и заберите книгу "Искусство ухода за скверноботом". Принесите ее Плекси в Точку вторжения: Катаклизм.‡Tötet Doktor Gutrick und beschafft Euch den Schlüssel des Doktors. Benutzt den Schlüssel, um die Geldkassette des Doktors zu öffnen und \'Die Kunst der Teufelshäscherwartung\' daraus zu entnehmen. Bringt das Buch zu Plexi beim Invasionspunkt: Katastrophe.‡박사 거트릭을 처치하고 박사의 열쇠를 찾아서 박사의 금고를 연 후, 지옥절단기 정비술을 찾아서 대재앙의 침공 거점에 있는 플렉시에게 가져가야 합니다.‡Mata al doctor Gutrick y consigue su llave. Usa la llave para abrir la caja fuerte del doctor para recuperar El Arte del Cuidado de los Atracadores Viles y llévale este libro a Plexi en el Punto de invasión: Cataclismo.‡Mata al doctor Gutrick y consigue su llave. Usa la llave para abrir la caja fuerte del doctor para recuperar El Arte del Cuidado de los Atracadores Viles y llévale este libro a Plexi en el Punto de invasión: Cataclismo.‡Tuez le Docteur Gutrick et procurez-vous la Clé du docteur. Utilisez la clé pour ouvrir le Coffre-fort du docteur, récupérez L\'Art de l\'entretien des saccageurs gangrenés, et apportez le livre à Plexi au Site d\'invasion Cataclysme.‡杀死加特里克博士，用博士的钥匙打开博士的保险箱，从中取出魔能机甲维修窍门大全，把它交给登陆场：灾难的普雷西。‡殺死博士嘎崔克然後取得博士的鑰匙。使用該鑰匙打開博士的保險箱取得惡魔搶奪者保養技術然後把它交給侵略點:災難的普萊克希。',
  }
},
[10607] = {
  {
    'Sussurros do deus Corvo‡Шепот Бога-ворона‡Das Flüstern des Rabengottes‡까마귀 신의 속삭임‡Susurros del Dios Cuervo‡Susurros del Dios Cuervo‡Les murmures du dieu corbeau‡乌鸦之神的低语‡烏鴉神的秘密預言',
    nil,
    'Mate os arakkoas Grishna para obter a Compreensão da Fala do Corvo por 2 minutos. Enquanto estiver sob os efeitos do feitiço, você poderá encontrar e receber a profecia dos quatro santuários.‡Убейте араккоа Гришны, чтобы на две минуты обрести Понимание речи Ворона. Находясь под действием этого заклятия, вы можете найти и получить пророчества в четырех святилищах. Вернитесь после посещения всех четырех святилищ.‡Tötet die Arakkoa der Grishna, um für 2 Minuten den Zauber \'Rabensprache verstehen\' zu erhalten. Hört Euch die Prophezeiungen aller vier Schreine an, solange der Zauber aktiv ist, und kehrt danach zurück.‡그리쉬나 아라코아를 처치하여 까마귀 언어 이해 마법을 얻은 후, 마법의 영향이 지속되는 2분 동안 4개의 제단에 있는 토템을 찾아 예언의 메시지를 얻어야 합니다.‡Mata al arakkoa Grishna para poder entender la palabra del Cuervo durante 2 minutos. Mientras estés bajo los efectos del hechizo, podrás encontrar y recibir la profecía de los cuatro santuarios. Regresa cuando hayas visitado los cuatro.‡‡Tuez un arakkoa Grishna pour obtenir la Compréhension du corvidien pendant 2 minutes. Tant que vous serez sous l’effet de ce sort, vous pourrez trouver et recevoir la prophétie des quatre sanctuaires.‡杀死格里施纳的鸦人，获得持续2分钟的理解鸦语效果。利用该法术破解四座神殿的预言，完成任务后向坦莫复命。‡殺死葛瑞納阿拉卡取得理解烏鴉語的效果2分鐘。在法術的效果之下，你可以從四個聖物之中得知四段預言。當你得知四段預言之後就回來找我。',
  }
},
[10608] = {
  {
    'Claro como cristal‡Ясно как день!‡Kristallklar‡수정 바위갈퀴 제거‡Limpieza de despellajadores‡Limpieza de despellajadores‡Clair comme le cristal‡水晶剥石者的麻烦‡清除水晶的障礙',
    nil,
    'Mate 10 Esfola-pedras de Cristal.‡Никвинкль Метрогном желает, чтобы вы убили 10 кристальных камнедеров. По выполнении вернитесь к нему на станцию Тошли в Острогорье.‡Schartwinkel der Metrognom möchte, dass Ihr 10 Kristallfelsklauen tötet. Kehrt danach zu ihm bei Toshleys Station im Schergrat zurück.‡수정 바위갈퀴 10마리를 처치한 후에 칼날 산맥의 토쉴리의 연구기지에 있는 똑딱이노움 닉윙클에게 돌아가야 합니다.‡Nicopico el Metro-gnomo quiere que mates 10 despellejadores de cristal y regreses junto a él en la Estación de Toshley, en las Montañas Filospada.‡‡Clignecoche le Métro-gnome veut que vous alliez tuer 10 Écorcheurs de cristal puis que vous retourniez le voir au Poste de Toshley dans les Tranchantes.‡测量者尼克维克要求你杀死10只水晶剥石者，完成任务之后回到托什雷的基地向他复命。‡地鐵地精尼克偉恩寇要你殺死10個水晶鐮奪怪然後回到劍刃山脈的托斯利基地向他回報。',
  }
},
[10609] = {
  {
    'Quem nasceu primeiro? O ovo ou o draco?‡Что было первым, дракон или яйцо?‡Was war zuerst da, der Drache oder das Ei?‡비룡이 먼저인가, 알이 먼저인가?‡¿Qué fue primero? ¿El draco o el huevo?‡¿Qué fue primero? ¿El draco o el huevo?‡Qui est apparu en premier, l\'œuf ou le drake ?‡先有龙还是先有蛋？‡龍生蛋，蛋生龍?',
    nil,
    'Colete 3 Essências de Protodraco Etéreo, 3 Essências de Draco Jovem e 3 Essências de Draco Adulto.‡Соберите 3 сущностей прародителя драконов Пустоты, 3 субстанции взрослого дракона и 3 субстанции зрелого дракона. Принесите их Физиту Тиктаку по прозвищу Док на станцию Тошли в Острогорье.‡Sammelt 3 Essenzen eines Protonetherdrachen, 3 Essenzen eines heranwachsenden Netherdrachen und 3 Essenzen eines ausgewachsenen Netherdrachen und bringt sie zu Fizit "Dok" Kuckuck bei Toshleys Station im Schergrat.‡원시 황천의 비룡 정수 3개, 어린 황천의 비룡 정수 3개, 다 자란 황천의 비룡 정수 3개를 수집한 후, 칼날 산맥의 토쉴리의 연구기지에 있는 "의사" 피짓 클록톡에게 가져가야 합니다.‡Reúne 3 esencias de draco protoinfernal, 3 esencias de draco adolescente y 3 esencias de draco adulto. Llévaselo todo entonces a Fito "Doc" Tictac a la Estación de Toshley, en las Montañas Filospada.‡‡Collectez 3 Essences de proto-drake du Néant, 3 Essences de jeune drake du Néant et 3 Essences de drake du Néant adulte. Rapportez-les à Fizit « Doc » Cliquetic au poste de Toshley dans les Tranchantes.‡收集3份始祖虚空幼龙的精华、3份健壮虚空幼龙的精华和3份成熟虚空幼龙的精华。然后返回刀锋山的托什雷的基地，将它们交给菲兹特-表针。‡收集3個原始虛空龍之精華、3個年輕的虛空龍之精華還有3個成熟的虛空龍之精華。交給劍刃山脈托斯利基地的費茲特「醫生」克羅克塔可。',
  }
},
[10610] = {
  {
    'Prospecting Basics‡Основы ведения разведки‡Grundlagen des Sondierens‡‡Principios básicos de posibilidad‡Principios básicos de posibilidad‡La prospection des matières premières‡‡',
    nil,
    nil,
  }
},
[10611] = {
  {
    'A Arte da Manutenção de Aníquilus‡Искусство ухода за скверноботом‡Die Kunst der Teufelshäscherwartung‡지옥절단기 정비술‡El Arte del Cuidado de los Atracadores Viles‡El Arte del Cuidado de los Atracadores Viles‡L’Art de l’entretien des saccageurs gangrenés‡魔能机甲维修窍门大全‡惡魔搶奪者保養技術',
    nil,
    'Mate o Doutor Maleficus e obtenha a Chave do Doutor. Use a chave para abrir o Cofre do Doutor e pegar A Arte da Manutenção de Aníquilus Vis, e entregue o livro a Nakansi no Ponto de Invasão: Cataclismo.‡Убейте доктора Потрошиллера и заберите у него ключ. Откройте этим ключом сейф доктора и заберите книгу "Искусство ухода за скверноботом". Принесите его Наканси в Точку вторжения: Катаклизм.‡Tötet Doktor Maleficus und beschafft Euch den Schlüssel des Doktors. Benutzt den Schlüssel, um die Geldkassette des Doktors zu öffnen und \'Die Kunst der Teufelshäscherwartung\' daraus zu entnehmen. Bringt das Buch zu Nakansi beim Invasionspunkt: Katastrophe.‡박사 말레피쿠스를 해치운 후 박사의 열쇠를 획득해야 합니다. 열쇠로 박사의 금고를 열고 지옥절단기 정비술을 찾아서 대재앙의 침공 거점에 있는 나칸시에게 가져가야 합니다.‡Mata al Doctor Maleficus y consigue la llave del doctor. Usa la llave para abrir la caja fuerte del doctor, para recuperar El Arte del Cuidado de los Atracadores Viles y entrégale el libro a Nakansi, en el Punto de invasión: Cataclismo.‡Mata al Doctor Maleficus y consigue la llave del doctor. Usa la llave para abrir la caja fuerte del doctor, para recuperar El Arte del Cuidado de los Atracadores Viles y entrégale el libro a Nakansi, en el Punto de invasión: Cataclismo.‡Tuez le Docteur Maleficus et procurez-vous la Clé du docteur. Utilisez la clé pour ouvrir le Coffre-fort du docteur, récupérez L\'Art de l\'entretien des saccageurs gangrenés, et apportez le livre à Nakansi au Site d\'invasion Cataclysme.‡杀死麦尔费苏斯博士，用博士的钥匙打开博士的保险箱，从中取出魔能机甲维修窍门大全，把它交给登陆场：灾难的纳斯坎。‡殺死博士莫歐費卡斯取得博士的鑰匙 。使用鑰匙打開博士的保險箱取得惡魔搶奪者保養技術，然後將這本書交給災難侵佔崗哨的那卡西。',
  }
},
[10612] = {
  {
    'Vil-oses e Furiosos‡Машина для убийства‡Teufelshäscherdrift‡지옥절단기와 격노‡El vil y la furia‡El vil y la furia‡La guerre des boutons‡狂暴的魔能机甲‡惡魔與狂熱',
    nil,
    'Use o Console de Controle de Aníquilus para controlar um Sentinela Aníquilus. Destrua 60 Infernais Forjados na Morte antes que o seu aníquilus pife. Quando a missão estiver completa, apresente-se a Pléxis no Ponto de Invasão: Cataclismo.‡Используйте панель управления скверноботом, чтобы захватить контроль над скверноботом-часовым. Уничтожьте 60 инферналов из Кузницы Смерти, прежде чем ваш сквернобот падет. По выполнении вернитесь к Плекси в точку вторжения: Катаклизм.‡Benutzt die Teufelshäscherfernsteuerung, um eine Schildwache der Teufelshäscher zu steuern. Zerstört 60 todesgeschmiedete Höllenbestien bevor Euer Teufelshäscher versagt. Meldet Euch danach bei Plexi am Invasionspunkt: Katastrophe.‡지옥절단기 조종장치로 지옥절단기 파수병을 조종하여 지옥절단기가 작동을 멈추기 전에 죽음으로 벼려낸 지옥불정령 60마리를 처치한 후, 대재앙의 침공 거점에 있는 플렉시에게 보고해야 합니다.‡Usa una consola de control de atracador vil para controlar un atracador vil centinela. Destruye a sesenta infernales Forja Muerta antes de que falle tu atracador vil. Cuando hayas completado tu misión, informa a Plexi en el Punto de Invasión: Cataclismo.‡Usa una consola de control de atracador vil para controlar un atracador vil centinela. Destruye a sesenta infernales Forja Muerta antes de que falle tu atracador vil. Cuando hayas completado tu misión, informa a Plexi en el Punto de Invasión: Cataclismo.‡Utilisez une Console de contrôle de saccageur gangrené pour prendre le contrôle d\'une Sentinelle saccageur gangrené. Détruisez 60 Infernaux mortforgés avant que votre saccageur gangrené ne cesse de fonctionner. Quand votre mission sera achevée, faites votre rapport à Plexi au Site d\'invasion : Cataclysme.‡使用魔能机甲控制台控制一台魔能机甲斥候，并在控制失效之前杀死60个死亡熔炉地狱火。完成任务后向登陆场：灾难的普雷西复命。‡使用惡魔搶奪者控制平台控制一個惡魔搶奪者哨兵。在你的惡魔搶奪者失效之前摧毀60個死鑄地獄火。任務完成後，向侵略點:災難的普萊克希回報。',
  }
},
[10613] = {
  {
    'Vil-oses e Furiosos‡Машина для убийства‡Teufelshäscherdrift‡지옥같이 맹렬한‡El vil y la furia‡El vil y la furia‡La guerre des boutons‡狂暴的魔能机甲‡惡魔與狂熱',
    nil,
    'Use o Console de Controle de Aníquilus para controlar uma Sentinela Aníquilus. Destrua 60 Infernais Forjados na Morte antes que o seu aníquilus pife. Quando a missão estiver completa, apresente-se a Nakansi no Ponto de Invasão: Cataclismo.‡Используйте панель управления скверноботом, чтобы захватить контроль над скверноботом-часовым. Уничтожьте 60 инферналов из Кузницы Смерти, прежде чем ваш сквернобот падет. По выполнении вернитесь к Наканси в точку вторжения: Катаклизм.‡Benutzt die Teufelshäscherfernsteuerung, um eine Schildwache der Teufelshäscher zu steuern. Zerstört 60 todesgeschmiedete Höllenbestien bevor Euer Teufelshäscher versagt. Meldet Euch danach bei Nakansi am Invasionspunkt: Katastrophe.‡지옥절단기 조종장치로 지옥절단기 파수병을 조종해야 합니다. 지옥절단기가 작동을 멈추기 전에 죽음으로 벼려낸 지옥불정령 60마리를 처치해야 합니다. 일을 마치면 대재앙의 침공 거점에 있는 나칸시에게 보고하십시오.‡Usa una consola de control de atracador vil para controlar un atracador vil centinela. Destruye a sesenta infernales Forja Muerta antes de que falle tu atracador vil. Cuando hayas completado tu misión, informa a Nakansi en el Punto de Invasión: Cataclismo.‡Usa una consola de control de atracador vil para controlar un atracador vil centinela. Destruye a sesenta infernales Forja Muerta antes de que falle tu atracador vil. Cuando hayas completado tu misión, informa a Nakansi en el Punto de Invasión: Cataclismo.‡Utilisez une Console de contrôle de saccageur gangrené pour prendre le contrôle d\'une Sentinelle saccageur gangrené. Détruisez 60 Infernaux mortforgés avant que votre saccageur gangrené ne cesse de fonctionner. Quand votre mission sera achevée, faites votre rapport à Nakansi au Site d\'invasion : Cataclysme.‡使用魔能机甲控制台控制一台魔能机甲斥候，并在控制失效之前杀死60个死亡熔炉地狱火。完成任务后向登陆场：灾难的纳坎斯复命。‡使用惡魔搶奪者控制平台控制一個惡魔搶奪者哨兵。在你的惡魔搶奪者失效之前摧毀60個死鑄地獄火。任務完成後，向侵略點:災難的那卡西回報。',
  }
},
[10614] = {
  {
    'Sussurros ao vento‡Шепот ветра‡Das Flüstern im Wind‡바람의 속삭임‡Susurros en el viento‡Susurros en el viento‡Des murmures dans le vent‡风之细语‡風中低語',
    nil,
    'Fale com Leoroxx na Vila de Mok\'nathal, que fica nas Montanhas da Lâmina Afiada.‡Найдите Леорокса в деревне Мок\'Натал в Острогорье.‡Sucht nach Leoroxx im Dorf der Mok\'Nathal im Schergrat.‡칼날 산맥의 모크나탈 마을에서 레오록스와 대화해야 합니다.‡Busca a Leoroxx en la Aldea Mok\'Nathal en las Montañas Filospada.‡‡Parlez à Leoroxx à Mok’Nathal, dans les Tranchantes.‡前往刀锋山的莫克纳萨村，寻找莱欧洛克斯。‡到劍刃山脈的摩克納薩爾村找到李歐羅克斯。',
  }
},
[10615] = {
  {
    'Bosque Ruuan‡Чащоба Рууан‡Der Ruuanwald‡루안 숲‡La Foresta de Ruuan‡La Foresta Ruuan‡La sylve Ruuan‡卢安荒野‡魯安曠野',
    nil,
    'Fale com Timeon no Arvoredo Eterno, que fica no Bosque Ruuan, nas Montanhas da Lâmina Afiada.‡Поговорите с Времионом в Вечной роще, что в чащобе Рууан в Острогорье.‡Sprecht mit Timeon im ewigen Hain im Ruuanwald des Schergrats.‡칼날 산맥의 루안 숲 속에 있는 영원의 숲에서 타이미온과 대화해야 합니다.‡Habla con Timeon en Soto Eterno, que está en la Foresta de Ruuan, en las Montañas Filospada.‡Habla con Timeon en Soto Eterno, que está en la Foresta Ruuan, en las Montañas Filospada.‡Parlez à Timeon au Bosquet éternel, dans la Sylve Ruuan des Tranchantes.‡前往刀锋山卢安荒野的常青林，与坦莫谈一谈。‡與永恆樹林的泰姆昂交談，永恆樹林在劍刃山脈的魯安曠野。',
  }
},
[10617] = {
  {
    'Casulo de sedasa‡Коконы шелкокрыла‡Seidenflügelkokons‡비단날개나방 고치‡Capullos de Alaseda‡Capullos de Alaseda‡Cocons d\'aile-de-soie‡丝翼蛾茧‡絲翼之繭',
    nil,
    'Taerek, na Vila de Mok\'nathal, quer que você recolha 8 Casulos de Sedasa de Larvas de Sedasa.nnMate a larva rapidamente, ou ela se transformará em uma sedasa e arruinará o casulo.‡Таэрек из деревни Мок\'Натал просит вас принести 8 коконов шелкокрыла с личинок шелкокрыла.nnБыстро убейте личинок, чтобы те не начали превращаться в шелкокрылов, прогрызая свои коконы.‡Taerek im Dorf der Mok\'Nathal möchte, dass Ihr 8 Seidenflügelkokons von Seidenflügellarven besorgt.nnTötet die Larven schnell, da sie sich sonst in Seidenflügel verwandeln und ihre Kokons zerstören.‡모크나탈 마을에 있는 타에레크가 비단날개나방 애벌레를 처치하고 비단날개나방 고치 8개를 수집해 달라고 부탁했습니다.nn애벌레가 비단날개나방으로 변해서 고치를 파괴하기 전에 빨리 애벌레를 처치해야 합니다.‡Taerek de la Aldea Mok\'Nathal quiere que recojas ocho capullos de Alaseda de las larvas de Alaseda.nnMata a la larva rápidamente o se convertirá en Alaseda, destruyendo el capullo.‡‡Taerek, de Mok\'Nathal, veut que vous collectiez 8 Cocons d\'aile-de-soie sur des Larves d\'aile-de-soie.nnTuez rapidement les larves, ou elles se changeront en Ailes-de-soie, ce qui détruirait leurs cocons.‡莫克纳萨村的塔耶雷克要你从丝翼幼虫身上收集8个丝翼蛾茧。nn迅速杀死幼虫，否则它们就会蜕变成丝翼巨蛾，破坏蛾茧。‡摩克納薩爾村的塔爾瑞克要你從絲翼幼蟲身上收集8個絲翼之繭。|n在幼蟲成長成絲翼之前殺掉它，不然繭就會被破壞。',
  }
},
[10618] = {
  {
    'As asas mais finas‡Нежнейшие крылья‡Die weichsten Flügel‡최고로 부드러운 날개‡Las alas más suaves‡Las alas más suaves‡Les ailes les plus douces‡最柔软的翅膀‡最柔軟的翅膀',
    nil,
    'Silmara, na Vila de Mok\'nathal, quer que você recolha 12 Asas Iridescentes.‡Силмара из деверни Мок\'Натал просит вас принести ей 12 радужных крыльев.‡Silmara im Dorf der Mok\'Nathal möchte, dass Ihr 12 schillernde Flügel sammelt.‡모크나탈 마을에 있는 실마라가 무지갯빛 날개 12개를 수집해 달라고 부탁했습니다.‡Silmara de la Aldea Mok\'Nathal quiere que recojas doce alas iridiscentes.‡‡Silmara, de Mok\'Nathal, veut que vous collectiez 12 Ailes iridescentes.‡莫克纳萨村的希尔玛拉要你收集12片虹光之翼。‡摩克納薩爾村的希歐瑪納要你收集12個彩虹之翼。',
  }
},
[10619] = {
  {
    'A tribo dos Grislíngua‡Клан Пеплоустов‡Die Aschenzungen‡잿빛혓바닥 결사단‡La tribu Lengua de Ceniza‡La tribu Lengua de Ceniza‡La tribu cendrelangue‡灰舌氏族‡灰舌部族',
    nil,
    'O Vindicante Aluumen quer que você vá até as Ruínas de Baa\'ri e mate 3 Tratadores Grislíngua, 6 Guerreiros Grislíngua e 4 Xamãs Grislíngua.nnCompletar missões para os Aldor reduzirá sua reputação junto aos Áugures.‡Убейте для воздаятеля Алуумена 3 укротителей, 4 воинов и 6 шаманов из племени Пеплоустов.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Verteidiger Aluumen möchte, dass Ihr zu den Ruinen von Baa\'ri geht und 3 Antreiber der Aschenzungen, 4 Krieger der Aschenzungen und 6 Schamanen der Aschenzungen tötet.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡구원자 알루멘이 바아리 폐허로 가서 잿빛혓바닥 조련사 3명, 잿빛혓바닥 전사 4명, 잿빛혓바닥 주술사 6명을 처치해 달라고 부탁했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡El vindicador Aluumen quiere que vayas a las Ruinas de Baa\'ri y mates a 3 cuidadores Lengua de ceniza, 4 guerreros Lengua de ceniza y 6 chamanes Lengua de ceniza.‡El vindicador Aluumen quiere que vayas a las Ruinas de Baa\'ri y mates a 3 cuidadores Lengua de ceniza, 4 guerreros Lengua de ceniza y 6 chamanes Lengua de ceniza.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Le redresseur de torts Aluumen veut que vous partiez pour les Ruines de Baa\'ri afin d\'y tuer 3 Dresseurs cendrelangues, 4 Guerriers cendrelangues et 6 Chamans cendrelangues.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation envers les Clairvoyants.‡守备官奥鲁门要你进入巴尔里废墟，杀死3名灰舌驯兽者、4名灰舌战士和6名灰舌萨满祭司。nn为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡復仇者阿魯曼要你去巴瑞廢墟殺死3個灰舌駕馭者、4個灰舌戰士還有6個灰舌薩滿。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10620] = {
  {
    'Ameaça Costasserra‡Угроза горного хребта‡Gratwirbelbedrohung‡긴다리 마루돌기거미의 위협‡La amenaza de Crestaespina‡La amenaza de Crestaespina‡La menace crêtéchine‡山脊上的危险‡山脊的威脅',
    nil,
    'Mate 10 Espreitadores Costasserra.‡Дина Головокружилка просит вас убить 10 пауков высокогорья. По выполнении вернитесь к ней на станцию Тошли в Острогорье.‡Taumel Dina möchte, dass Ihr 10 Gratwirbelpirscher tötet. Kehrt danach zu ihr in Toshleys Station im Schergrat zurück.‡긴다리 마루돌기거미 10마리를 처치해야 합니다.‡Mata a diez acechadoras Crestaespina.‡‡Tuez 10 Traqueuses crêtéchine.‡晕乎乎的迪娜要求你杀死10只山脊捕猎者。完成任务之后回到托什雷的基地向她复命。‡迪希·迪娜要你殺死10隻山脊行者。任務完成後，回到劍刃山脈的托斯利基地向她回報。',
  }
},
[10621] = {
  {
    'Estilhaço da Ruína dos Illidari‡Осколок погибели Иллидари‡Splitter des Illidaribanns‡일리다리 파멸의 파편‡El fragmento aterraillidari‡El fragmento aterraillidari‡Éclat plaie-des-Illidari‡伊利达雷斩除碎片‡伊利達瑞毀滅裂片',
    nil,
    'Leve o Estilhaço Ruína dos Illidari a Ordinn Punhostrondo na Fortaleza Martelo Feroz.‡Принесите осколок проклятия иллидари Ординну Громовому Кулаку в цитадель Громового Молота.‡Bringt den Splitter des Illidaribanns zu Ordinn Donnerfaust in der Wildhammerfeste.‡와일드해머 성채에 있는 오르딘 썬더피스트에게 일리다리 파멸의 파편을 가져가야 합니다.‡Lleva el fragmento aterraillidari a Ordinn Tronapuño en el Bastión Martillo Salvaje.‡Lleva el fragmento aterraillidari a Ordinn Tronapuño en el Bastión Martillo Salvaje.‡Apportez l\'Éclat plaie-des-Illidari à Ordinn Tonnepoing au bastion des Marteaux-hardis.‡将伊利达雷斩除碎片交给蛮锤要塞的奥丁-雷拳。‡將伊利達瑞毀滅裂片交給蠻錘要塞的歐爾汀·雷拳。',
  }
},
[10622] = {
  {
    'Prova de fidelidade‡Доказательство верности‡Ein Beweis der Treue‡충성의 증거‡Prueba de lealtad‡Prueba de lealtad‡Preuve d\'allégeance‡忠诚的证明‡表明立場',
    nil,
    'Mate Zandras na Jaula do Carcereiro, no Vale da Lua Negra, e fale novamente com Sanoru.‡Убейте Зандраса в Клети Стражницы и возвращайтесь к Санору.‡Tötet Zandras im Kerker des Wächters im Schattenmondtal und kehrt danach zu Sanoru zurück.‡어둠달 골짜기의 감시자의 수용소에 있는 잔드라스를 해치운 후 사노루에게 가야 합니다.‡Mata a Zandras en la Jaula de la Guardiana, en el Valle Sombraluna y vuelve a ver a Sanoru.‡Mata a Zandras en la Jaula de la Guardiana, en el Valle Sombraluna y vuelve a ver a Sanoru.‡Tuez Zandras à la Cage de la gardienne dans la vallée d\'Ombrelune et retournez voir Sanoru.‡杀死影月谷内守望者牢笼的杉德拉斯，然后向萨诺鲁复命。‡殺死影月谷的典獄官監牢的薩卓瑞斯然後向杉諾魯回報。',
  }
},
[10623] = {
  {
    'Estilhaço da Ruína dos Illidari‡Осколок погибели Иллидари‡Splitter des Illidaribanns‡일리다리 파멸의 파편‡Fragmento aterraillidari‡El fragmento aterraillidari‡Éclat plaie-des-Illidari‡伊利达雷斩除碎片‡伊利達瑞毀滅裂片',
    nil,
    'Leve o Estilhaço Ruína dos Illidari a Grokom Olho da Morte na Aldeia Lua Negra.‡Принесите осколок проклятия иллидари Грокому Мертвому Глазу в деревню Призрачной Луны.‡Bringt den Splitter des Illidaribanns zu Grokom Totauge in Schattenmond.‡어둠달 마을에 있는 그로콤 데스아이에게 일리다리 파멸의 파편을 가져가야 합니다.‡Lleva el fragmento aterraillidari a Grokom Ojo de la Muerte en la Aldea Sombraluna.‡Lleva el fragmento aterraillidari a Grokom Ojomuerte en la Aldea Sombraluna.‡Apportez l\'Éclat plaie-des-Illidari à Grokom Oeil-de-mort au village d\'Ombrelune.‡将伊利达雷斩除碎片交给影月村的格罗克姆-死眼。‡將伊利達瑞毀滅裂片交給影月村的葛羅空·亡眼。',
  }
},
[10624] = {
  {
    'Uma história assombrada‡История про привидений...‡Eine Spukgeschichte‡유령의 역사‡Una de fantasmas‡Una de fantasmas‡L\'histoire hantée‡阴森的历史‡鬧鬼的過去',
    nil,
    'A Boticária-chefe Hildagard da Aldeia Lua Negra, que fica no Vale da Lua Negra, quer que você traga 15 amostras de Cinzas Sempre Ardentes.‡Принесите главному аптекарю Хильдегард из деревни Призрачной Луны 15 горстей неостывающего пепла.‡Chefapothekerin Hildagard in Schattenmond im Schattenmondtal möchte, dass Ihr ihr 15 Einheiten ewig brennende Asche bringt.‡어둠달 골짜기의 어둠달 마을에 있는 수석 연금술사 힐다가드가 영원히 타오르는 재 표본 15개를 가져오라고 했습니다.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que le lleves 15 muestras de ceniza siempreardiente.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que le lleves 15 muestras de ceniza siempreardiente.‡L\'Apothicaire en chef Hildagard du Village d\'Ombrelune vous demande de lui rapporter 15 échantillons de Cendre semperardente.‡将15份永燃灰烬样本交给影月谷影月村的主药剂师希尔达迦。‡影月谷裡影月村的總藥劑師希爾達嘉要你帶給她15個永燃灰燼樣本。',
  }
},
[10625] = {
  {
    'Espectróculos‡Спектроскоп‡Geisterbrille‡영혼의 투시경‡Espectróculos‡Espectróculos‡Lunectoplasmes‡幽灵眼镜‡顯靈鏡',
    nil,
    'A Boticária-chefe Hildagard da Aldeia Lua Negra, que fica no Vale da Lua Negra, quer que você mate 12 Zelotes Lua Negra.‡Убейте для главного аптекаря Хильдегард из деревни Призрачной Луны 12 ревнителей из клана Призрачной Луны.‡Chefapothekerin Hildagard in Schattenmond im Schattenmondtal möchte, dass Ihr 12 Zeloten des Schattenmondklans tötet.‡어둠달 골짜기의 어둠달 마을에 있는 수석 연금술사 힐다가드가 어둠달 광신도 12명을 처치해 달라고 했습니다.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que mates a 12 zelotes de Sombraluna.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que mates a 12 zelotes de Sombraluna.‡L\'Apothicaire en chef Hildagard du village d\'Ombrelune dans la vallée d\'Ombrelune vous demande de tuer 12 Zélotes ombrelunes.‡影月谷影月村的主药剂师希尔达迦要你去杀死12个影月狂徒。‡影月谷的影月村的總藥劑師希爾達嘉要你殺死12個影月狂熱者。',
  }
},
[10626] = {
  {
    'Capture as armas‡Сдать оружие!‡Beschafft die Waffen‡무기 입수‡Capturar las armas‡Tomar las armas‡S\'emparer des armes‡夺取武器‡奪取武器',
    nil,
    'Ordinn Punhostrondo na Fortaleza Martelo Feroz quer que você lhe traga o Glaive de Mazakradon e o Glaive de Morgroron.‡Принесите глефу Маказрадона и глефу Моргророна Ординну Громовому Кулаку в цитадель Громового Молота.‡Ordinn Donnerfaust in der Wildhammerfeste möchte, dass Ihr ihm Makazradons Gleve und Morgrorons Gleve bringt.‡와일드해머 성채에 있는 오르딘 썬더피스트가 마카즈라돈의 대검과 모르그로론의 대검을 가져다 달라고 부탁했습니다.‡Ordinn Tronapuño en el Bastión Martillo Salvaje quiere que le lleves las gujas de Mazakradon y de Morgroron.‡Ordinn Tronapuño en el Bastión Martillo Salvaje quiere que le lleves las gujas de Mazakradon y de Morgroron.‡Ordinn Tonnepoing du bastion des Marteaux-Hardis veut que vous lui apportiez le Glaive de Makazradon et le Glaive de Morgroron.‡将玛卡扎顿之刃和莫戈洛隆之刃交给蛮锤要塞的奥丁·雷拳。‡蠻錘要塞的歐爾汀·雷拳要你幫他取得馬卡瑞登的大刀還有莫爾葛洛朗的大刀。',
  }
},
[10627] = {
  {
    'Capture as armas‡Сдать оружие!‡Beschafft die Waffen‡무기 탈취‡Tomar las armas‡Tomar las armas‡S\'emparer des armes‡夺取武器‡奪取武器',
    nil,
    'Grokom Olho da Morte, na Aldeia Lua Negra, quer que você lhe traga a Glaive de Mazakradon e a Glaive de Morgroron.‡Принесите глефу Мазакрадона и глефу Моргророна Грокому Мертвому Глазу в деревню Призрачной Луны.‡Grokom Totauge im Schattenmondtal möchte, dass Ihr ihm Makazradons Gleve und Morgrorons Gleve bringt.‡어둠달 마을에 있는 그로콤 데스아이가 마카즈라돈의 대검과 모르그로론의 대검을 탈취해 오라고 부탁했습니다.‡Grokom Ojo de la Muerte, de la Aldea Sombraluna, quiere que le lleves la guja de Mazakradon y la guja de Morgroron.‡Grokom Ojomuerte, de la Aldea Sombraluna, quiere que le lleves la guja de Mazakradon y la guja de Morgroron.‡Grokom Œil-de-mort du village d\'Ombrelune veut que vous lui apportiez le Glaive de Makazradon et le Glaive de Morgroron.‡将玛卡扎顿之刃和莫戈洛隆之刃交给影月村的格罗克姆·死眼。‡影月村的葛羅空·亡眼要你帶給他馬卡瑞登的大刀還有莫爾葛洛朗的大刀。',
  }
},
[10628] = {
  {
    'Akama‡Акама‡Akama‡아카마‡Akama‡‡Akama‡阿卡玛‡阿卡瑪',
    nil,
    'Fale com Akama dentro da câmara oculta na Jaula do Carcereiro.‡Поговорите с Акамой в тайной комнате Клети Стражницы.‡Sprecht mit Akama in der verborgenen Kammer im Kerker des Wächters.‡감시자의 수용소의 비밀 석실 안에 있는 아카마와 대화해야 합니다.‡Habla con Akama en la cámara oculta, en la Jaula de la Guardiana.‡Habla con Akama en la cámara oculta, en la Jaula de la Guardiana.‡Parler à Akama à l\'intérieur de la chambre cachée de la Cage de la gardienne.‡与守望者牢笼的密室中的阿卡玛谈一谈。‡跟典獄官監牢的密室裡的阿卡瑪談話。',
  }
},
[10629] = {
  {
    'Trabalho sujo‡Шизанутая работенка‡Drecksarbeit‡지저분한 일‡Un trabajo que te cagas‡Un trabajo que te cagas‡Un boulot de m...‡肮脏的工作‡噁心的工作',
    nil,
    'Use o Apito de Canisvil para evocar um Canisvil de Guarda. Leve o Canisvil de Guarda para um passeio e mate alguns Javiltuscos Dementes. Procure as Chaves do Retalhador nos "montinhos" que o Canisvil de Guarda deixar. Devolva as Chaves do Retalhador ao Capataz Razelcraz, na mina a noroeste de Thrallmar.‡Используйте свисток гончей Скверны, чтобы призвать гончую. Выведите ее на прогулку и убейте парочку безумных зловепрей. Поищите ключи от крошшера в помете гончей Скверны. Верните ключи штейгеру Разлкразу, который находится на руднике к северо-западу от Траллмара.‡Benutzt die Teufelshundepfeife, um einen teuflischen Wachhund zu rufen. Führt den teuflischen Wachhund Gassi und tötet ein paar Hölleneber. Durchsucht dann die Haufen des teuflischen Wachhunds nach den Schlüsseln. Wenn Ihr die Schlüssel gefunden habt, bringt sie zu Großknecht Razelcraz bei der Mine nordwestlich von Thrallmar.‡지옥사냥개 호루라기를 사용하여 길들인 지옥사냥개를 소환한 후 사냥개를 데리고 밖으로 가서 광기어린 지옥멧돼지를 잡아줘야 합니다. 길들인 지옥사냥개의 "배설물"에서 절단기 열쇠를 찾아서 스랄마 북서쪽 광산 근처에 있는 현장감독 라젤크라즈에게 가져가야 합니다.‡Usa el silbato de can manáfago para conjurar un can de guardia vil. Dale un paseo al can de guardia vil y mata varios jabinfernos trastornados. Busca las llaves de la trituradora en los "desechos" del can de guardia vil. Devuélvele las llaves de la trituradora al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Usa el silbato de can manáfago para invocar un can de guardia vil. Dale un paseo al can de guardia vil y mata varios jabinfernos trastornados. Busca las llaves de la trituradora en los "desechos" del can de guardia vil. Devuélvele las llaves de la trituradora al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡"Utilisez le Sifflet à gangrechien pour invoquer un Gangrechien. Promenez le gangrechien et tuez des Sangliers infernaux dérangés. Cherchez les Clés du déchiqueteur dans la "livraison" du gangrechien. Rapportez les Clés du déchiqueteur au contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡使用地狱犬哨召唤一只恶魔警卫犬。带恶魔警卫犬外出散步，并猎杀疯狂的地狱野猪来喂养它。在恶魔警卫犬排出的"残渣"中寻找伐木机钥匙。然后返回萨尔玛西北方的矿洞，将伐木机钥匙交给工头拉泽克拉兹。‡使用惡魔犬之哨召喚一隻惡魔犬。帶惡魔犬去散步然後殺死一些地獄野豬。在惡魔犬的「排出物」中尋找伐木機鑰匙。把伐木機鑰匙交給索爾瑪西北方礦坑裡的工頭瑞絲坎茲。',
  }
},
[10630] = {
  {
    'Embaixo de Thrallmar‡Рядом с Траллмаром‡Unter Thrallmar‡스랄마의 광산‡El subsuelo de Thrallmar‡El subsuelo de Thrallmar‡Sous Thrallmar‡萨尔玛的地下‡索爾瑪的地下礦坑',
    nil,
    'Mate Urga\'zz e fale novamente com o Capataz Razelcraz na mina a noroeste de Thrallmar.‡Убейте Урга\'зза и возвращайтесь к штейгеру Разлкразу на рудник к северо-западу от Траллмара.‡Tötet Urga\'zz und kehrt dann zu Großknecht Razelcraz in der Mine nordwestlich von Thrallmar zurück.‡우르가즈를 처치한 후 스랄마 북서쪽 광산 근처에 있는 현장감독 라젤크라즈에게 돌아가야 합니다.‡Mata a Urga\'zz y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Mata a Urga\'zz y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Tuez Urga\'zz puis retournez voir le contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡杀死乌加兹，然后返回萨尔玛西北方的矿洞，向工头拉泽克拉兹复命。‡殺死烏爾卡斯然後回報給索爾瑪西北方礦坑裡的工頭瑞絲坎茲。',
  }
},
[10632] = {
  {
    'Chega de moleza‡Точи зубы!‡Zähne zeigen‡경험 쌓기‡Cortar tus dientes‡Cortar tus dientes‡Couper quelques crocs...‡锋利的牙齿‡割下你的牙齒',
    nil,
    'Colete 5 Dentes Extra-afiados de Gorjadaga.‡Разак Сковородкер просит вас принести ему 5 острейших зубов Кинжальной Пасти. Принесите их ему на станцию Тошли в Острогорье.‡Razak Eisenflanke möchte, dass Ihr 5 besonders scharfe Dolchrachenzähne sammelt. Kehrt danach zu ihm in Toshleys Station im Schergrat zurück.‡매우 예리한 비수아귀랩터 이빨 5개를 수집해야 합니다.‡Consigue 5 dientes Faucedaga extra afilados.‡‡Récupérez 5 Dents de Crocs-lames extrêmement affûtées.‡拉沙克·铁墙要求你收集5颗非常锐利的刃喉龙牙，将这些东西带回托什雷的基地交给他。‡洛薩克·鐵面要你取回5個特級銳利匕爪牙齒。完成後回到劍刃山脈的托斯利基地交給他。',
  }
},
[10633] = {
  {
    'Teron Sanguinávido: fatos e lendas‡Терон Кровожад – Правда и Вымысел‡Teron Blutschatten - Geschichte und Mythos‡테론 고어핀드에 대한 전설‡Teron Sanguino: Tradición y Leyenda‡Teron Sanguino: Tradición y Leyenda‡Teron Fielsang - Mythes et légendes‡塔隆-血魔的传说‡泰朗·血魔-傳說與傳奇',
    nil,
    'A Boticária-chefe Hildagard da Aldeia Lua Negra, no Vale da Lua Negra, quer que você encontre o Antigo Espírito de Lua Negra.nnSe você perder o Espectróculos, Hildagard pode fazer um novo par.‡Найдите древнего духа долины Призрачной Луны для главного аптекаря Хильдегард из деревни Призрачной Луны в одноименной долине. Если вы потеряете свой спектроскоп, Хильдегард может сделать вам новый.‡Chefapothekerin Hildagard in Schattenmond im Schattenmondtal möchte, dass Ihr den uralten Schattenmondgeist findet.nnWenn Ihr Eure Geisterbrille verlieren solltet, kann Euch Hildagard ein neues Paar herstellen.‡어둠달 골짜기의 어둠달 마을에 있는 수석 연금술사 힐다가드가 고대 어둠달 영혼을 찾아달라고 했습니다.nn영혼의 투시경을 잃어버리면 수석 연금술사 힐다가드가 새로 하나 만들어줄 것입니다.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que encuentres el espíritu Sombraluna ancestral.nnSi pierdes tus espectróculos, la boticaria jefe Hildagard puede hacerte otro par.‡La boticaria jefe Hildagard de la Aldea Sombraluna, en el Valle Sombraluna, quiere que encuentres el espíritu Sombraluna ancestral.|n|nSi pierdes tus espectróculos, la boticaria jefe Hildagard puede hacerte otro par.‡L\'apothicaire en chef Hildagard du village d\'Ombrelune dans la vallée d\'Ombrelune vous demande de trouver l\'Esprit ancien d\'Ombrelune.nnSi vous perdez vos Lunectoplasmes, l\'apothicaire en chef Hildagard peut vous en faire une nouvelle paire.‡影月谷影月村的主药剂师希尔达迦要你找到上古影月之魂。nn如果你弄丢了幽灵眼镜，主药剂师希尔达迦可以再帮你做一副。‡影月谷影月村的總藥劑師希爾達嘉要你尋找古老的影月靈魂。|n假如你的顯靈鏡遺失的話，總藥劑師希爾達嘉可以幫你製作一副新的。',
  }
},
[10634] = {
  {
    'Vaticínio: a armadura do Sanguinávido‡Прорицание: Броня Кровожада‡Hellsicht: Blutschattens Rüstung‡점치기: 고어핀드의 갑옷‡Adivinación: la armadura de Sanguino‡Adivinación: la armadura de Sanguino‡Divination: l\'armure de Fielsang‡占卜：血魔的护甲‡預言:血魔的護甲',
    nil,
    'O Antigo Espírito de Lua Negra no Altar das Sombras, que fica no sudeste do Vale da Lua Negra, quer que você recupere a Armadura do Sanguinávido.‡Завладейте броней Кровожада по просьбе древнего духа Долины Призрачной Луны, что обитает у Алтаря Теней.‡Der uralte Schattenmondgeist am Altar der Schatten im südöstlichen Schattenmondtal möchte, dass Ihr Blutschattens Rüstung besorgt.‡남동쪽 어둠달 골짜기의 어둠의 제단에 있는 고대 어둠달부족 영혼이 고어핀드의 갑옷을 되찾아 달라고 부탁했습니다.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la armadura de Sanguino.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la armadura de Sanguino.‡L\'Esprit ancien d\'Ombrelune à l\'Autel des Ombres dans le sud-est de la vallée d\'Ombrelune vous demande de récupérer l\'Armure de Fielsang.‡将血魔的护甲交给影月谷东南方暗影祭坛的上古影月之魂。‡影月谷東南方暗影祭壇的古老的影月靈魂要你取得血魔的護甲。',
  }
},
[10635] = {
  {
    'Vaticínio: o manto do Sanguinávido‡Прорицание: Плащ Кровожада‡Hellsicht: Blutschattens Umhang‡점치기: 고어핀드의 망토‡Adivinación: la capa de Sanguino‡Adivinación: la capa de Sanguino‡Divination: la cape de Fielsang‡占卜：血魔的披风‡預言:血魔的披風',
    nil,
    'O Antigo Espírito de Lua Negra no Altar das Sombras, que fica no sudeste do Vale da Lua Negra, quer que você recupere o Manto do Sanguinávido.‡Завладейте плащом Кровожада по просьбе древнего духа Долины Призрачной Луны, что обитает у Алтаря Теней.‡Der uralte Schattenmondgeist am Altar der Schatten im südöstlichen Schattenmondtal möchte, dass Ihr Blutschattens Umhang besorgt.‡남동쪽 어둠달 골짜기의 어둠의 제단에 있는 고대 어둠달 영혼이 고어핀드의 망토를 찾아오라고 했습니다.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la capa de Sanguino.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la capa de Sanguino.‡L\'Esprit ancien d\'Ombrelune à l\'Autel des Ombres dans le sud-est de la vallée d\'Ombrelune vous demande de récupérer la Cape de Fielsang.‡将血魔的披风交给影月谷东南方暗影祭坛的上古影月之魂。‡影月谷東南方暗影祭壇的古老的影月靈魂要你取得血魔的披風。',
  }
},
[10636] = {
  {
    'Vaticínio: o bastão do Sanguinávido‡Прорицание: буздыхан Кровожада‡Hellsicht: Blutschattens Schlagstock‡점치기: 고어핀드의 마법봉‡Adivinación: la tranca de Sanguino‡Adivinación: la clava de Sanguino‡Divination : l\'assommoir de Fielsang‡占卜：血魔的权杖‡預言:血魔之杖',
    nil,
    'O Antigo Espírito de Lua Negra no Altar das Sombras, que fica no sudeste do Vale da Lua Negra, quer que você recupere o Bastão do Sanguinávido.‡Завладейте буздыханом Кровожада по просьбе древнего духа Долины Призрачной Луны, что обитает у Алтаря Теней.‡Der uralte Schattenmondgeist am Altar der Schatten im südöstlichen Schattenmondtal möchte, dass Ihr Blutschattens Schlagstock besorgt.‡남동쪽 어둠달 골짜기의 어둠의 제단에 있는 고대 어둠달 영혼이 고어핀드의 마법봉을 되찾아 달라고 했습니다.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la tranca de Sanguino.‡El espíritu Sombraluna ancestral en El Altar de las Sombras, al sureste del Valle Sombraluna, quiere que consigas la clava de Sanguino.‡L\'Esprit ancien d\'Ombrelune à l\'Autel des Ombres dans le sud-est de la vallée d\'Ombrelune vous demande de récupérer l\'Assommoir de Fielsang.‡将血魔的权杖交给影月谷东南方暗影祭坛的上古影月之魂。‡影月谷東南方暗影祭壇的古老的影月靈魂要你取回血魔之杖。',
  }
},
[10637] = {
  {
    'Uma distração necessária‡Необходимая уловка‡Eine notwendige Ablenkung‡교란 작전‡Una distracción necesaria‡Una distracción necesaria‡Une diversion nécessaire‡必要的混乱‡製造混亂',
    nil,
    'A Exarca Onaala quer que você volte às Ruínas de Karabor e descubra uma forma de libertar Azaloth, voltando-o contra seus captores.nnCompletar missões para os Aldor reduzirá sua reputação junto aos Áugures.‡Вернитесь в Руины Карабора и освободите для экзарха Онаалы Разрушителя Азалота.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Exarch Onaala möchte, dass Ihr zu den Ruinen von Karabor zurückkehrt und Azaloth auf seine Kerkermeister hetzt.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡총독 오날라가 카라보르 폐허로 돌아가서 아잘로스를 풀어달라고 했습니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La exarca Onaala quiere que vuelvas a las Ruinas de Karabor y encuentres una forma de liberar a Azaloth de sus captores.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡La exarca Onaala quiere que vuelvas a las Ruinas de Karabor y encuentres una forma de liberar a Azaloth de sus captores.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'exarque Onaala de l\'Autel de Sha\'tar veut que vous retourniez aux Ruines de Karabor et que vous trouviez un moyen de lâcher Azaloth sur ceux qui le tiennent enfermé.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡大主教欧纳拉要你返回卡拉波废墟，设法令阿萨洛斯摆脱放逐状态。nn为奥尔多完成任务将会降低你在占星者阵营中的声望等级。‡主教歐納拉要你返回卡拉伯爾廢墟，想辦法釋放阿薩羅斯。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10638] = {
  {
    'NOT A QUEST‡NOT A QUEST‡NOT A QUEST‡퀘스트 아님‡NOT A QUEST‡‡CECI N\'EST PAS UNE QUÊTE‡NOT A QUEST‡',
    nil,
    'Seek <NAME> in the <DISTRICT> of Silvermoon City.‡Seek <NAME> in the <DISTRICT> of Silvermoon City.‡Seek <NAME> in the <DISTRICT> of Silvermoon City.‡Seek <NAME> in the <DISTRICT> of Silvermoon City.‡Seek <NAME> in the <DISTRICT> of Silvermoon City.‡Busca a <NAME> en <DISTRICT> de la Ciudad de Lunargenta.‡Allez voir <NOM> dans le <QUARTIER> de Lune-d’Argent.‡Seek <NAME> in the <DISTRICT> of Silvermoon City.‡',
  }
},
[10639] = {
  {
    'Teron Sanguinávido eu sou...‡Терон Кровожад, то есть я...‡Ich bin Teron Blutschatten...‡테론 고어핀드의 정체‡Yo, Teron Sanguino‡Yo, Teron Sanguino‡Teron Fielsang, je suis...‡我就是塔隆·血魔......‡',
    nil,
    'O Antigo Espírito de Lua Negra usou você como um fantoche! Agora que você coletou os itens exigidos, ele revelou que é o próprio Teron Sanguinávido. Para se livrar da possessão, você terá de obedecê-lo e assassinar Karsius, o Antigo Vigia.nnSe tiver sucesso, fale com a Boticária-chefe Hildagard na Aldeia Lua Negra.‡Древний дух долины Призрачной Луны обвел вас вокруг пальца! Вы сделали все, что он просил, но оказалось, что этот дух – сам Терон Кровожад. Чтобы освободиться от его власти вы должны выполнить его распоряжение и убить Карсиуса Дозорного Древности.nnПо выполнении задания вернитесь к главному аптекарю Хильдегард в деревню Призрачной Луны.‡Der uralte Schattenmondgeist hat Euch benutzt! Nun, da Ihr alle Gegenstände, die er wollte, gesammelt habt, hat er sich als Teron Blutschatten offenbart. Um von seinem Bann loszukommen, müsst Ihr seinen Willen erfüllen und Karsius den uralten Wächter töten.nnWenn Ihr erfolgreich wart, meldet Euch bei Chefapothekerin Hildagard in Schattenmond.‡고대 어둠달 영혼이 당신을 이용했습니다! 자신이 부탁한 물건을 모두 모으자 자기가 바로 테론 고어핀드라는 사실을 밝혔습니다. 그에게서 벗어나려면 명령에 따라 고대 감시자 카르시우스를 처치해야 합니다.nn일을 마치면 어둠달 마을에 있는 수석 연금술사 힐다가드에게 돌아가십시오.‡El espíritu Sombraluna ancestral te ha utilizado como si fueras un títere. Ahora que has conseguido los objetos que necesitaba, ha revelado su verdadera identidad, Teron Sanguino. Para liberarte de su posesión, debes hacer lo que te pide y matar a Karsius el vigía anciano.nnSi tienes éxito, vuelve a ver a la boticaria jefe Hildagard en la Aldea Sombraluna.‡El espíritu Sombraluna ancestral te ha utilizado como si fueras un títere. Ahora que has conseguido los objetos que necesitaba, ha revelado su verdadera identidad, Teron Sanguino. Para liberarte de su posesión, debes hacer lo que te pide y matar a Karsius el vigía anciano.|n|nSi tienes éxito, vuelve a ver a la boticaria jefe Hildagard en la Aldea Sombraluna.‡L\'Esprit ancien d\'Ombrelune s\'est joué de vous ! Maintenant que vous avez les objets dont il avait besoin, il vous a révélé être Teron Fielsang. Pour vous libérer de sa possession, vous devez faire ce qu\'il ordonne et tuer Karsius l\'Antique Guetteur.nnSi vous y parvenez, retournez voir l\'Apothicaire en chef Hildagard au village d\'Ombrelune.‡上古影月之魂利用了你！在你集齐所有的物品后，他便露出了真面目，原来这家伙就是塔隆·血魔。想要摆脱束缚，就必须按他的吩咐杀死上古看守者卡修斯。nn杀死卡修斯之后，向影月村的主药剂师希尔达迦复命。‡',
  }
},
[10640] = {
  {
    'Altruis‡Алтруис‡Altruis‡알트루이스‡Altruis‡‡Altruis‡奥图里斯‡奧翠司',
    nil,
    'Vá até Nagrand ocidental e encontre Altruis, o Sofredor.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Отправляйтесь в западный Награнд и найдите Алтруиса Страдальца.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist in den Westen Nagrands und sucht Altruis den Leider.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡나그란드 서부로 가서 고뇌의 알트루이스를 만나야 합니다.nn알도르 사제회를 위한 퀘스트를 수행하면 점술가 길드에 대한 당신의 평판은 떨어질 것입니다.‡Dirígete al oeste de Nagrand y encuentra a Altruis el Sufridor.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Dirígete al oeste de Nagrand y encuentra a Altruis el Sufridor.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Voyagez jusqu\'au Nagrand occidental et allez trouver Altruis le souffrant.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往纳格兰西部寻找受难者奥图里斯。nn为奥尔多完成任务将会降低你在占星者阵营中的声望等级。‡去納葛蘭的西部找『受難者』奧翠司。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10641] = {
  {
    'Contra a Legião‡Против Легиона‡Gegen die Legion‡불타는 군단과의 전투‡Contra la Legión‡Contra la Legión‡Contre la Légion‡对抗军团‡對抗軍團',
    nil,
    'Altruis, o Sofredor, quer que você obtenha Sangue Recém-extraído de uma Sacerdotisa da Ira na Base-forja: Geena em Eternévoa. Derrame-o no chão e mate o Avatar de Sathal. Fale novamente com Altruis quando concluir a tarefa.‡Алтруис Страдалец просит вас добыть свежей крови зловещей жрицы на базе Легиона: Геенна в Пустоверти. Пролейте кровь на землю и убейте аватару Саталь. По выполнении задания вернитесь к Алтруису.‡Altruis der Leider möchte, dass Ihr das frisch gezapfte Blut einer Zornpriesterin der Konstruktionsbasis: Gehenna im Nethersturm besorgt. Schüttet es auf den Boden und tötet den Avatar von Sathal. Kehrt zu Altruis dem Leider zurück, wenn Ihr fertig seid.‡고뇌의 알트루이스가 황천의 폭풍에 있는 지옥의 괴철로 주둔지에서 격노의 여사제를 처치하고 신선한 피를 획득한 다음 사방에 뿌리라고 했습니다. 그런 뒤 사달의 화신이 나타나면 처치해야 합니다. 임무를 완수하면 알트루이스에게 돌아가십시오.‡Altruis el Sufridor quiere que consigas sangre recién extraída de una sacerdotisa de la cólera de la Base Forja: Gehenna en Tormenta Abisal. Derrámala en el suelo y mata al avatar de Sathal. Regresa junto a Altruis cuando hayas completado esta tarea.‡Altruis el Sufridor quiere que consigas sangre recién extraída de una sacerdotisa de la cólera de la Base Forja: Gehenna en Tormenta Abisal. Derrámala en el suelo y mata al avatar de Sathal. Regresa junto a Altruis cuando hayas completado esta tarea.‡Altruis le Souffrant veut que vous obteniez du Sang fraîchement versé d’une Prêtresse de colère à la Base de forge Géhenne, à Raz-de-Néant. Versez-le sur le sol et tuez l’Avatar de Sathal. Revenez voir Altruis quand vous aurez accompli votre mission.‡受难者奥图里斯要你前往虚空风暴的铸魔基地：炼狱，从天罚祭司身上取回一份新鲜的魔血。然后，将新鲜的魔血泼在地上，并杀死萨莎尔的化身。完成任务之后向奥图里斯复命。‡『受難者』奧翠司要你從虛空風暴的熔爐基地:苦難的憤怒女牧師身上取得一個新鮮滴落的血液。將它灑在地上然後殺死薩撒爾的化身。任務完成後回去找奧翠司。',
  }
},
[10642] = {
  {
    'Um fantasma na máquina‡Дух из машины‡Spiritus ex machina‡기계 안의 유령‡Un fantasma en la máquina‡Un fantasma en la máquina‡Le fantôme dans la machine‡要塞中的幽灵‡機械中的鬼魂',
    nil,
    'Zorus, o Judicante, na Fortaleza Martelo Feroz, no Vale da Lua Negra, quer que você lhe traga 15 amostras de Cinzas Sempre Ardentes.‡Принесите 15 горстей неостывающего пепла Зорусу Ревнителю в цитадель Громового Молота в долине Призрачной Луны.‡Zorus der Richter in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr ihm 15 Proben ewig brennende Asche bringt.‡어둠달 골짜기의 와일드해머 성채에 있는 심판관 조러스가 영원히 타오르는 재 견본 15개를 모아 달라고 부탁했습니다.‡Zorus el Justiciero en el Bastión Martillo Salvaje, en el Valle Sombraluna, quiere que le lleves 15 muestras de ceniza siempreardiente.‡Zorus el Justiciero en el Bastión Martillo Salvaje, en el Valle Sombraluna, quiere que le lleves 15 muestras de ceniza siempreardiente.‡Zorus l\'adjudicateur du bastion des Marteaux-hardis dans la vallée d\'Ombrelune veut que vous lui apportiez 15 Échantillons de cendre semperardente.‡将15份永燃灰烬样本交给影月谷蛮锤要塞的仲裁者索鲁斯。‡影月谷的蠻錘要塞的『執法官』索羅斯要你交給他15個永燃灰燼樣本。',
  }
},
[10643] = {
  {
    'Precursores de Lua Negra‡Вестники Призрачной Луны‡Herolde des Schattenmondklans‡어둠달 골짜기의 선구자‡Presagistas de Sombraluna‡Presagistas de Sombraluna‡Messagers d\'Ombrelune‡影月先驱者‡影月先驅者',
    nil,
    'Zorus, o Judicante, na Fortaleza Martelo Feroz, que fica no Vale da Lua Negra, quer que você mate 12 Precursores Lua Negra.‡Убейте 12 предвестников из клана Призрачной Луны для Зоруса Ревнителя из цитадели Громового Молота.‡Zorus der Richter in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr 12 Herolde des Schattenmondklans tötet.‡어둠달 골짜기의 와일드해머 성채에 있는 심판관 조러스가 어둠달 선구자 12명을 처치해 달라고 했습니다.‡Zorus el Justiciero en el Bastión Martillo Salvaje, en el Valle Sombraluna, quiere que mates a 12 presagistas Sombraluna.‡Zorus el Justiciero en el Bastión Martillo Salvaje, en el Valle Sombraluna, quiere que mates a 12 presagistas de Sombraluna.‡Zorus le Judicateur du bastion des Marteaux-Hardis dans la vallée d\'Ombrelune veut que vous alliez tuer 12 Messagers ombrelunes.‡影月谷蛮锤要塞的仲裁者索鲁斯要你去杀死12个影月先驱者。‡影月谷的蠻錘要塞的『執法官』索羅斯要你殺死12個影月先驅。',
  }
},
[10644] = {
  {
    'Teron Sanguinávido: fatos e lendas‡Терон Кровожад – Правда и Вымысел‡Teron Blutschatten - Geschichte und Mythos‡테론 고어핀드의 전설‡Teron Sanguino: Tradición y Leyenda‡Teron Sanguino: Tradición y Leyenda‡Teron Fielsang - Mythes et légendes‡塔隆-血魔的传说‡泰朗·血魔-傳說與傳奇',
    nil,
    'Zorus, o Judicante, na Fortaleza Martelo Feroz, no Vale da Lua Negra, quer que você encontre o Antigo Espírito de Lua Negra.nnSe você perder os Espectróculos, Zorus pode fazer um novo par.‡Найдите древнего духа долины Призрачной Луны для Зоруса Ревнителя в цитадели Громового Молота. Если вы потеряете свой спектроскоп, Зорус может сделать вам новый.‡Zorus der Richter in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr den uralten Schattenmondgeist findet.nnWenn Ihr Eure Geisterbrille verlieren solltet, kann Euch Zorus der Richter eine neue herstellen.‡어둠달 골짜기의 와일드해머 성채에 있는 심판관 조러스가 고대 어둠달 영혼을 찾아 달라고 했습니다.nn영혼의 투시경을 잃어버리면 심판관 조러스에게 찾아가서 새로 하나를 얻을 수 있습니다.‡Zorus el Justiciero en el Bastión Martillo Salvaje,en el Valle Sombraluna, quiere que encuentres al espíritu Sombraluna ancestral.nnSi pierdes los espectróculos, Zorus el Justiciero te hará un nuevo par.|n‡Zorus el Justiciero en el Bastión Martillo Salvaje,en el Valle Sombraluna, quiere que encuentres al espíritu Sombraluna ancestral.|n|nSi pierdes los espectróculos, Zorus el Justiciero te hará un nuevo par.|n‡Zorus le Judicateur du bastion des Marteaux-Hardis dans la vallée d\'Ombrelune vous demande de trouver l\'Esprit ancien d\'Ombrelune.nnSi vous perdez vos Lunectoplasmes, Zorus l\'adjudicateur peut vous en fabriquer une nouvelle paire.‡影月谷蛮锤要塞的仲裁者索鲁斯要你找到上古影月之魂。nn如果你弄丢了幽灵眼镜，仲裁者索鲁斯可以再帮你做一副。‡影月谷的蠻錘要塞的『執法官』索羅斯要你找到古老的影月靈魂。|n假如你弄丟了你的顯靈鏡，『執法官』索羅斯可以幫你做一副新的。',
  }
},
[10645] = {
  {
    'Teron Sanguinávido eu sou...‡Терон Кровожад, то есть я...‡Ich bin Teron Blutschatten...‡테론 고어핀드의 정체‡Yo, Teron Sanguino‡Yo, Teron Sanguino‡Teron Fielsang, je suis...‡我就是塔隆·血魔……‡',
    nil,
    'O Antigo Espírito de Lua Negra usou você como um fantoche! Agora que você coletou os itens exigidos, ele revelou que é o próprio Teron Sanguinávido. Para se livrar da possessão, você terá de obedecê-lo e assassinar Karsius, o Antigo Vigia.nnSe tiver sucesso, fale novamente com Zorus, o Judicante, na Fortaleza Martelo Feroz.‡Древний дух долины Призрачной Луны обвел вас вокруг пальца! Вы сделали все, что он просил, но оказалось, что этот дух – сам Терон Кровожад. Чтобы освободиться от его власти вы должны выполнить его распоряжение и убить Карсиуса Дозорного Древности.nnПо выполнении задания вернитесь к Зорусу Ревнителю в цитадель Громового Молота.‡Der uralte Schattenmondgeist hat Euch benutzt! Nun, da Ihr alle Gegenstände, die er wollte, gesammelt habt, hat er sich als Teron Blutschatten offenbart. Um von seinem Bann loszukommen, müsst Ihr seinen Willen erfüllen und Karsius den uralten Wächter töten.nnWenn Ihr erfolgreich wart, meldet Euch bei Zorus dem Richter in der Wildhammerfeste.‡고대 어둠달 영혼이 당신을 이용했습니다! 자신이 부탁한 물건을 모두 모으자 자기가 바로 테론 고어핀드라는 사실을 밝혔습니다. 그에게서 벗어나려면 명령에 따라 고대 감시자 카르시우스를 처치해야 합니다.nn일을 마치면 와일드해머 성채에 있는 심판관 조러스에게 돌아가십시오.‡El espíritu Sombraluna ancestral te ha utilizado como si fueras un títere. Ahora que has conseguido los objetos que necesitaba, ha revelado su verdadera identidad, Teron Sanguino. Para liberarte de su posesión, debes hacer lo que te pide y matar a Karsius el vigía anciano.nnSi tienes éxito, vuelve a ver a Zorus el Justiciero en el Bastión Martillo Salvaje.‡El espíritu Sombraluna ancestral te ha utilizado como si fueras un títere. Ahora que has conseguido los objetos que necesitaba, ha revelado su verdadera identidad, Teron Sanguino. Para liberarte de su posesión, debes hacer lo que te pide y matar a Karsius el vigía anciano.|n|nSi tienes éxito, vuelve a ver a Zorus el Justiciero en el Bastión Martillo Salvaje.‡L\'Esprit ancien d\'Ombrelune s\'est joué de vous ! Maintenant que vous avez les objets dont il avait besoin, il vous a révélé être Teron Fielsang. Pour vous libérer de sa possession, vous devez faire ce qu\'il ordonne et tuer Karsius l\'Antique Guetteur.nnSi vous y parvenez, retournez voir Zorus l\'adjudicateur au Bastion des Marteaux-hardis.‡上古影月之魂利用了你！在你集齐所有的物品后，他便露出了真面目，原来这家伙就是塔隆·血魔。想要摆脱束缚，就必须按他的吩咐杀死上古看守者卡修斯。nn杀死卡修斯之后，向蛮锤要塞的仲裁者索鲁斯复命。‡',
  }
},
[10646] = {
  {
    'Pupilo de Illidan‡Ученик Иллидана‡Illidans Schüler‡일리단의 제자‡El pupilo de Illidan‡El pupilo de Illidan‡Le disciple d\'Illidan‡伊利丹的学生‡伊利丹的弟子',
    nil,
    'Escute a história de Altruis.‡Выслушайте рассказ Алтруиса.‡Hört Euch Altruis\' Geschichte an.‡알트루이스의 얘기를 들어야 합니다.‡Escucha el relato de Altruis.‡Escucha el relato de Altruis.‡Écoutez l\'histoire d\'Altruis.‡听奥图里斯讲述他的故事。‡聆聽奧翠司的故事。',
  }
},
[10647] = {
  {
    'PROCURA-SE: Uvuros, Flagelo de Lua Negra‡Разыскивается: Увурос, бич долины Призрачной Луны‡Gesucht: Uvuros, Geißel von Schattenmond‡현상 수배: 어둠달의 재앙, 우부로스‡Se busca: Uvuros, plaga de Sombraluna‡Se busca: Uvuros, plaga de Sombraluna‡Avis de recherche : Uvuros, Fléau d\'Ombrelune‡通缉：乌鲁洛斯，影月谷的祸患‡懸賞:烏伏洛斯，影月谷的天譴軍團',
    nil,
    'Mate Uvuros e colete a Juba Flamejante de Uvuros. Entregue-a ao Belarauto Sardon Verocorte na Aldeia Lua Negra, que fica no Vale da Lua Negra.‡Убейте Увуроса и доставьте его пламенеющую гриву военному глашатаю Сардону Чистому Удару в деревню Призрачной Луны в одноименной долине.‡Tötet Uvuros und beschafft Uvuros\' feurige Mähne. Bringt sie zu Kriegsrufer Sardon Treuschnitt in Schattenmond im Schattenmondtal.‡우부로스를 해치우고 불타는 갈기를 구한 후 어둠달 골짜기의 어둠달 마을에 있는 전쟁인도자 사르돈 트루슬라이스에게 가져가야 합니다.‡Mata a Uvuros y recupera su crín ígnea. Vuelve junto al clamaguerras Sardon Cortecertero de la Aldea Sombraluna, en el Valle Sombraluna.‡Mata a Uvuros y recupera su crin ígnea. Vuelve junto al clamaguerras Sardon Cortecertero de la Aldea Sombraluna, en el Valle Sombraluna.‡Tuez Uvuros et récupérez la Crinière flamboyante d\'Uvuro. Rapportez-la à Sardon Frantaille le Hurleguerre au village d\'Ombrelune dans la vallée d\'Ombrelune.‡杀死乌鲁洛斯，将乌鲁洛斯的烈焰之鬃交给影月谷影月村的战争召唤者萨尔东·图斯莱。‡殺死烏伏洛斯然後取回烏伏洛斯的火鬃。交給影月谷的影月村裡頭的公告員薩爾登·崔賴斯。',
  }
},
[10648] = {
  {
    'Procura-se: Uvuros, flagelo de Lua Negra‡Разыскивается: Увурос, бич долины Призрачной Луны‡Gesucht: Uvuros, Geißel von Schattenmond‡현상 수배: 어둠달의 재앙, 우부로스‡Se busca: Uvuros, plaga de Sombraluna‡Se busca: Uvuros, plaga de Sombraluna‡Avis de recherche : Uvuros, Fléau d\'Ombrelune‡通缉：乌鲁洛斯，影月谷的祸患‡懸賞:烏伏洛斯，影月谷的天譴軍團',
    nil,
    'Mate Uvuros e colete a Juba de Fogo de Uvuros. Entregue-a ao Belarauto Napachope na Fortaleza Martelo Feroz, no Vale da Lua Negra.‡Убейте Увуроса и доставьте его пламенеющую гриву военному глашатаю Пивному Брюху в цитадель Громового Молота в долине Призрачной Луны.‡Tötet Uvuros und beschafft Uvuros\' feurige Mähne. Bringt sie zu Kriegsrufer Bierschnut in der Wildhammerfeste im Schattenmondtal.‡우부로스를 처치하고 불타는 갈기를 구한 후 어둠달 골짜기의 와일드해머 성채에 있는 전쟁인도자 비어스나웃에게 가져가야 합니다.‡Mata a Uvuros y recupera su crín ígnea. Vuelve junto al clamaguerras Birramorro del Bastión Martillo Salvaje, en el Valle Sombraluna.‡Mata a Uvuros y recupera su crin ígnea. Vuelve junto al clamaguerras Birramorro del Bastión Martillo Salvaje, en el Valle Sombraluna.‡Tuez Uvuros et récupérez la Crinière flamboyante d\'Uvuro. Rapportez-la à Musebière le Hurleguerre au Bastion des Marteaux-hardis dans la vallée d\'Ombrelune.‡杀死乌鲁洛斯，将乌鲁洛斯的烈焰之鬃交给影月谷蛮锤要塞的战争召唤者比尔斯诺特。‡殺死烏伏洛斯然後取回烏伏洛斯的火鬃。交給影月谷的蠻錘要塞裡頭的公告員畢爾斯納特。',
  }
},
[10649] = {
  {
    'O livro dos nomes abjetos‡Книга Имен Скверны‡Das Buch der teuflischen Namen‡저주받은 이름의 책‡El Libro de Nombres Viles‡El Libro de Nombres Viles‡Le Livre des noms gangrenés‡恶魔名册‡惡魔之名寶典',
    nil,
    'Penetre no Labirinto Soturno em Auchindoun e roube o Livro dos Nomes Abjetos de Nerocordius, o Incitador. Fale novamente com Altruis em Nagrand quando concluir a tarefa.‡Проберитесь в Темный лабиринт в Аукиндоне и добудьте у Черносерда Подстрекателя Книгу Имен Скверны. После этого вернитесь в Награнд к Алтруису.‡Reist in das Schattenlabyrinth von Auchindoun und besorgt das Buch der teuflischen Namen von Schwarzherz dem Hetzer. Kehrt danach zu Altruis in Nagrand zurück.‡아킨둔의 어둠의 미궁 안으로 가서 선동자 검은심장을 처치하고 저주받은 이름의 책을 획득해야 합니다. 일을 마치면 나그란드에 있는 알트루이스에게 돌아가십시오.‡Adéntrate en el Laberinto de las Sombras en Auchindoun y consigue el Libro de Nombres Viles de Negrozón el Incitador. Vuelve junto a Altruis, en Nagrand, después de completar esta tarea.‡Adéntrate en el Laberinto de las Sombras en Auchindoun y consigue el Libro de Nombres Viles de Negrozón el Incitador. Vuelve junto a Altruis, en Nagrand, después de completar esta tarea.‡Entrez dans le Labyrinthe des Ombres d\'Auchindoun et procurez-vous le Livre des noms gangrenés sur Cœur-noir le Séditieux. Retournez voir Altruis en Nagrand une fois cette tâche accomplie.‡进入奥金顿的暗影迷宫，从煽动者布莱卡特手中夺得恶魔名册。完成任务后返回纳格兰向奥图里斯复命。‡去奧齊頓的暗影迷宮從煽動者黑心身上取得惡魔之名寶典。完成任務後向納葛蘭的奧翠司回報。',
  }
},
[10650] = {
  {
    'Retorno aos Aldor‡Возвращение к Алдорам‡Rückkehr zu den Aldor‡알도르 사제회로 귀환‡Regresa junto a los Aldor‡Regresa junto a los Aldor‡Retour à l\'Aldor‡返回沙塔尔祭坛‡',
    nil,
    'Fale com a Exarca Onaala no Altar de Sha\'tar, que fica no Vale da Lua Negra.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Поговорите с экзархом Онаалой у алтаря Ша\'тар, в долине Призрачной Луны.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Sprecht mit Exarch Onaala beim Altar der Sha\'tar im Schattenmondtal.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡어둠달 골짜기의 샤타르 제단에 있는 총독 오날라와 대화해야 합니다.nn알도르 사제회를 위한 퀘스트를 수행하면 점술가 길드에 대한 당신의 평판은 떨어질 것입니다.‡Habla con la exarca Onaala del Altar de Sha\'tar, en el Valle Sombraluna.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Habla con la exarca Onaala del Altar de Sha\'tar, en el Valle Sombraluna.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Parlez à l\'exarque Onaala à l\'Autel de Sha\'tar dans la vallée d\'Ombrelune.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡与影月谷沙塔尔祭坛的大主教欧纳拉谈一谈。nn为奥尔多完成任务将会降低你在占星者阵营中的声望等级。‡',
  }
},
[10651] = {
  {
    'Varedis precisa ser detido!‡Варедиса нужно остановить!‡Varedis muss aufgehalten werden‡베레디스를 막아야 한다...‡Hay que detener a Varedis‡Hay que detener a Varedis‡Il faut arrêter Varedis‡阻止瓦雷迪斯‡',
    nil,
    'A Exarca Onaala quer que você vá até as ruínas de Karabor e mate Alandien, Theras, Netharel e Varedis. Use o Livro dos Nomes Abjetos para enfraquecer Varedis quando ele usar Metamorfose. Fale novamente com a Exarca Onaala após completar a tarefa.nnCompletar missões para os Aldor reduzirá sua reputação entre os Áugures.‡Отправляйтесь в Руины Карабора и убейте Аландиен, Тераса, Нетариеля и самого Варедиса. Используйте Книгу Имен Скверны, когда Варедис будет перевоплощаться, чтобы ослабить его. Вернитесь к экзарху Онаале с книгой Имен Скверны, по выполнении задания.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Exarch Onaala möchte, dass Ihr zu den Ruinen von Karabor geht und Alandien, Theras, Netharel und Varedis tötet. Benutzt das Buch der teuflischen Namen, während Varedis die Fähigkeit \'Metamorphose\' einsetzt, um ihn zu schwächen. Kehrt danach mit dem Buch der teuflischen Namen zu Exarch Onaala zurück.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡총독 오날라가 카라보르 폐허로 가서 알란디엔, 테라스, 네사렐, 베레디스를 해치워 달라고 했습니다. 베레디스가 탈태할 때 저주받은 이름의 책을 사용해 힘을 약화시켜야 합니다. 이 임무를 마친 후 저주받은 이름의 책을 들고 총독 오날라에게 돌아가십시오.nn알도르 사제회를 위한 퀘스트를 수행하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La exarca Onaala quiere que vayas a las Ruinas de Karabor y mates a Alandien, Theras, Netharel y Varedis. Utiliza el Libro de Nombres Viles para debilitar a Varedis cuando use la metamorfosis. Vuelve a ver al exarca Onaala con el libro cuando hayas acabado.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡La exarca Onaala quiere que vayas a las Ruinas de Karabor y mates a Alandien, Theras, Netharel y Varedis. Utiliza el Libro de Nombres Viles para debilitar a Varedis cuando use la metamorfosis. Vuelve a ver al exarca Onaala con el libro cuando hayas acabado.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L’exarque Onaala veut que vous vous rendiez aux ruines de Karabor et que vous tuiez Alandien, Theras, Netharel et Varedis. Utilisez le Livre des noms gangrenés quand Varedis utilisera sa métamorphose, pour l’affaiblir. Retournez voir l\'exarque Onaala avec le Livre des noms gangrenés lorsque vous aurez terminé cette tâche.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡大主教欧纳拉要你前往卡拉波废墟，杀死阿兰蒂恩、瑟拉斯、奈萨里尔和瓦雷迪斯。在瓦雷迪斯变身为恶魔形态时利用恶魔名册削弱他的力量。完成任务后将恶魔名册交给大主教欧纳拉。nn为奥尔多完成任务将会降低你在占星者阵营中的声望等级。‡',
  }
},
[10652] = {
  {
    'Atrás das linhas inimigas‡В тылу врага‡Hinter feindlichen Linien‡적진 후방‡Tras las líneas enemigas‡Tras las líneas enemigas‡Derrière les lignes ennemies‡深入敌后‡敵人身後',
    nil,
    'Fale com Veronia quando estiver <preparado/preparada> para partir para Manaforja Coruu. Chegando ao destino, fale com Caledis Albafulgis.nnCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Поговорите с Веронией, когда будете готовы отбыть в манагорн Коруу. Оказавшись там, поговорите с Каледисом Сияющим Рассветом.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Sprecht mit Veronia, wenn Ihr bereit seid, zur Manaschmiede Coruu aufzubrechen. Meldet Euch dort bei Caledis Morgenhell.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡코루 마나괴철로로 출발할 준비가 되면 베로니아와 대화하여 코루 마나괴철로로 가 캘디스 브라이트돈과 대화해야 합니다.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 평판이 떨어질 것입니다.‡Habla con Veronia cuando quieras ir a la Forja de Maná Coruu. Cuando llegues, habla con Caledis Alba Brillante.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Habla con Veronia cuando quieras ir a la Forja de Maná Coruu. Cuando llegues, habla con Caledis Alba Brillante.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Parlez à Veronia lorsque vous serez <prêt/prête> à partir pour la Manaforge Coruu. Une fois là-bas, parlez à Caledis Brillaube.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡当你准备启程前往法力熔炉：布纳尔时，就告知维罗妮娅。抵达法力熔炉：布纳尔后，跟卡勒迪斯·晨光谈一谈。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡當你準備好前往法力熔爐寇魯的時候跟維納妮雅交談。到達之後跟卡利迪斯·曙光談話。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10653] = {
  {
    'Marcas de Sargeras‡Знаки Саргераса‡Mal des Sargeras‡살게라스의 징표‡Marcas de Sargeras‡Marcas de Sargeras‡Les marques de Sargeras‡萨格拉斯印记‡薩格拉斯印記',
    nil,
    'Leve 10 Marcas de Sargeras para Adyen, o Guardião da Luz.nnCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Принесите 10 знаков Саргераса Адуину Стражу Света в Шаттрат.nnВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt 10 Male des Sargeras zu Adyen dem Lichtwächter in Shattrath.nnDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 빛의 수호자 아드옌에게 살게라스의 징표 10개를 가져가야 합니다.nn알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva 10 marcas de Sargeras a Adyen el Celador de la Luz en la Ciudad de Shattrath.nnCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva 10 marcas de Sargeras a Adyen el Celador de la Luz en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Remettre 10 Marques de Sargeras à Adyen le Gardelumière, à Shattrath.nnAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将10枚萨格拉斯印记交给沙塔斯城内的圣光护卫者阿德因。nn为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡將10個薩格拉斯印記交給撒塔斯城的『護光者』艾德伊恩。|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10654] = {
  {
    'Mais marcas de Sargeras‡Больше знаков Саргераса‡Mehr Male des Sargeras‡살게라스의 징표 추가 수집‡Más marcas de Sargeras‡Más marcas de Sargeras‡De nouvelles marques de Sargeras‡更多萨格拉斯印记‡更多的薩格拉斯印記',
    nil,
    'Trazes tu mais insígnias de nossos inimigos, <class>? A Legião Ardente ainda representa ameaça, e continuamos a persegui-los onde quer que os encontremos.‡Вы принесли еще знаков различия наших врагов, |3-6(Жрица)? Пылающий Легион все еще угрожает нам, и мы преследуем его повсеместно.‡Tragt Ihr noch mehr Insignien des Feindes bei Euch, <Name>? Die Brennende Legion ist auch weiterhin eine Bedrohung, und wir verfolgen sie überall, wo wir sie finden können.‡‡¿Tienes más insignias de nuestros enemigos, <clase>? La Legión Ardiente sigue siendo una amenaza y nosotros seguimos persiguiéndoles siempre que podemos.‡‡Do you bear more of our enemies\' insignias, <classe>? The Burning Legion continues to be a threat and we continue to pursue them anywhere that we find them.‡‡',
  }
},
[10655] = {
  {
    'Marca única de Sargeras‡Знак Саргераса‡Einzelne Male des Sargeras‡살게라스의 징표 하나‡Marca de Sargeras única‡Marca de Sargeras única‡Une marque de Sargeras‡单枚萨格拉斯印记‡一個薩格拉斯印記',
    nil,
    'Aceitarei quaisquer marcas que ainda trouxeres contigo. Não te preocupes, tuas ações serão devidamente registradas.‡‡Ich nehme Euch alle übrigen Male, die Ihr habt, ab. Keine Sorge, Eure Taten werden nicht unbemerkt bleiben.‡가지고 있는 징표가 더 있다면 모두 받아 드리겠습니다. 걱정하지 마십시오. 당신의 업적은 널리 알려질 겁니다.‡Me quedaré con las insignias que te sobran. No te preocupes, tus acciones serán tenidas en cuenta.‡‡S’il vous reste d\'autres insignes, ils m\'intéressent. Ne vous en faites pas, vos actions seront dûment rapportées.‡‡',
  }
},
[10656] = {
  {
    'Sinetes dos Solfúria‡Перстни Ярости Солнца‡Siegel des Sonnenzorns‡성난태양 인장‡Sellos Furia del Sol‡Sellos Furia del Sol‡Les chevalières Solfurie‡日怒徽记‡日怒徽章',
    nil,
    'A Magistra Fyalenn, em Shattrath, quer que você lhe traga 10 Sinetes dos Solfúria.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Принесите магистру Файленн 10 перстней Ярости Солнца.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Magistrix Fyalenn in Shattrath möchte, dass Ihr ihr 10 Siegel des Sonnenzorns bringt.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡샤트라스에 있는 마법학자 피알렌이 성난태양 인장 10개를 모아오라고 했습니다.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 당신의 평판은 떨어질 것입니다.‡La magistrix Fyalenn en la Ciudad de Shattrath quiere que le lleves 10 sellos Furia del Sol.nnCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡La magistrix Fyalenn en la Ciudad de Shattrath quiere que le lleves 10 sellos Furia del Sol.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡La magistrice Fyalenn de Shattrath veut que vous lui apportiez 10 Chevalières Solfurie.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de la faction Aldor.‡沙塔斯城的魔导师菲亚琳要求你给她带回10枚日怒徽记。nn为占星者完成任务将会使你在奥尔多阵营中的声望等级降低。‡撒塔斯城的博學者菲雅蘭要你帶給她10個日怒徽章。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10657] = {
  {
    'Domando o relâmpago‡Оседлать молнию‡Lasst sie abblitzen!‡벼락맞기‡A lomos del relámpago‡A lomos del relámpago‡Chevauche la foudre‡电闪雷鸣‡操控閃電',
    nil,
    'Use a Esfera de Magneto Repolarizada para absorver 25 raios das Serpentes Escamasas. Aproveite para coletar 5 Glândulas Relampejantes de Escamasa.‡Тошли хочет, чтобы вы при помощи реполяризованной магнитной сферы абсорбировали 25 ударов молний от чешуекрылых змеев. Также добудьте 5 молниевых желез чешуекрылых. Доставьте все Тошли в Острогорье.‡Toshley möchte, dass Ihr die repolarisierte Magnetsphäre benutzt, um 25 Blitzschläge von Schuppenflügelschlangen abzufangen. Des Weiteren möchte er, dass Ihr 5 Blitzschlagdrüsen eines Schuppenflügels sammelt. Kehrt danach zu Toshley in Toshleys Station im Schergrat zurück.‡분극화된 자기 구체를 사용하여 비늘날개 천둥매들에게서 25개의 벼락을 흡수하고 비늘날개 번개 분출선 5개를 수집해야 합니다.‡Usa la esfera de magneto repolarizado para absorber 25 golpes de relámpago de las serpientes Alaescama. Consigue también 5 glándulas de relámpagos de Alaescama.‡‡Utilisez la Magnéto-sphère repolarisée pour absorber 25 décharges de foudre des Serpents ailécailles. Collectez également 5 Glandes d’éclair ailécailles.‡托什雷要求你使用极化电磁球从鳞翼飞蛇身上吸收25发闪电打击，再收集5份鳞翼闪电腺体。将这些东西带回刀锋山内的托什雷的基地给他。‡托斯利要你使用再極化的磁力發電機球體從鱗翼風蛇身上吸收25個閃電之擊。同時，收集5個鱗翼閃電腺。然後回到劍刃山脈的托斯利基地交給他。',
  }
},
[10658] = {
  {
    'Mais sinetes dos Solfúria‡Больше перстней Ярости Солнца‡Mehr Siegel des Sonnenzorns‡성난태양 인장 추가 수집‡Más sellos Furia del Sol‡Más sellos Furia del Sol‡De nouvelles chevalières Solfurie‡更多日怒徽记‡更多的日怒徽章',
    nil,
    'O que você tem feito por nós ultimamente, <name>? A guerra contra Kael\'thas não vai se vencer sozinha, sabe?‡‡Was habt Ihr in letzter Zeit für uns getan, <Name>? Der Krieg gegen Kael\'thas kämpft sich nicht von alleine, verstanden?‡‡¿Qué has hecho por nosotros últimamente, <nombre>? Diría que la guerra contra Kael\'thas no va a librarse sola, ¿no te parece?‡‡‡‡',
  }
},
[10659] = {
  {
    'Sinete único dos Solfúria‡Перстень Ярости Солнца‡Einzelne Siegel des Sonnenzorns‡성난태양 인장 하나‡Sello Furia del Sol único‡Sello Furia del Sol único‡Une chevalière Solfurie‡单枚日怒徽记‡一個日怒徽章',
    nil,
    'Even the smallest contribution to our cause is noted, <name>. Our enemies are many, but we shall prevail!‡‡Sogar der kleinste Beitrag zu unserer Sache wird bemerkt, <Name>. Unsere Feinde sind stark, aber wir werden siegen!‡Even the smallest contribution to our cause is noted, <name>. Our enemies are many, but we shall prevail!‡Even the smallest contribution to our cause is noted, <nombre>. Our enemies are many, but we shall prevail!‡‡Even the smallest contribution to our cause is noted, <nom>. Our enemies are many, but we shall prevail!‡‡',
  }
},
[10660] = {
  {
    'Que criaturas estranhas...‡Что за странные создания?‡Welch merkwürdige Wesen...‡특이한 생명체‡Extrañas criaturas‡Extrañas criaturas‡Quelles étranges créatures...‡奇怪的生物......‡奇怪的生物……',
    nil,
    'O Pesquisador Tiorus na Aldeia Lua Negra, que fica no Vale da Lua Negra, quer que você traga 8 Timos de Fogovil.‡Добудьте 8 селезенок сквернопламенных деметродонов для ученого Тиоруса в деревне Призрачной Луны в одноименной долине.‡Forscher Tiorus in Schattenmond im Schattenmondtal möchte, dass Ihr 8 Teufelsfeuermilzen besorgt.‡어둠달 골짜기의 어둠달 마을에 있는 연구원 티오루스가 지옥불꽃 내장 8개를 모아오라고 했습니다.‡El investigador Tiorus de la Aldea Sombraluna, en el Valle Sombraluna, quiere que recuperes 8 bazos de fuego vil.‡El investigador Tiorus de la Aldea Sombraluna, en el Valle Sombraluna, quiere que recuperes 8 bazos de fuego vil.‡Le chercheur Tiorus du village d\'Ombrelune dans la vallée d\'Ombrelune veut que vous vous procuriez 8 Rates de gangrefeu.‡影月谷影月村的研究员提欧鲁斯要求你给他带回8个魔火脾脏。‡影月谷的影月村的研究員提歐魯斯要你取得8個惡魔烈焰脾臟。',
  }
},
[10661] = {
  {
    'Ó-timos!‡Умопотрошительно!‡Demilziös!‡최고의 내장‡Para darte un \'abazo\'‡Para darte un \'abazo\'‡Ex-rate-ordinaires !‡美味的脾脏！‡美味的脾臟!',
    nil,
    'Gnomus na Fortaleza Martelo Feroz, do Vale da Lua Negra, quer que você traga 8 Timos de Fogovil.‡Принесите 8 селезенок сквернопламенных деметродонов Гномусу в цитадель Громового Молота.‡Gnomus in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr 8 Teufelsfeuermilzen besorgt.‡어둠달 골짜기의 와일드해머 성채에 있는 노무스가 지옥불꽃 내장 8개를 가져다 달라고 부탁했습니다.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes 8 bazos de fuego vil.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes 8 bazos de fuego vil.‡Gnomus du bastion des Marteaux-hardis dans la vallée d\'Ombrelune veut que vous récupériez 8 Rates gangrefeu.‡影月谷蛮锤要塞的诺姆斯要求你给他带回8个魔火脾脏。‡影月谷的蠻錘要塞的葛諾瑪斯要你取得8個惡魔烈焰脾臟。',
  }
},
[10662] = {
  {
    'O ferreiro eremita‡Кузнец–отшельник‡Der Wanderschmied‡은둔해 있는 대장장이‡El herrero ermitaño‡El herrero ermitaño‡L\'ermite forgeron‡隐居的铁匠‡隱居的鐵匠',
    nil,
    'Leve a Caixa de Lingotes para David Wayne no Refúgio de Wayne da Mata Terokkar.‡Принесите ящик со слитками Дэвиду Уэйну в приют Уэйна, который находится в лесу Тероккар.‡Bringt den Kasten mit Barren zu David Wayne in Waynes Zuflucht in den Wäldern von Terokkar.‡테로카르 숲의 웨인의 은거처에 있는 다비드 웨인에게 주괴 상자를 가져가야 합니다.‡Lleva la caja de lingotes a David Wayne en el Refugio de Wayne, en el Bosque de Terokkar.‡Lleva la caja de lingotes a David Wayne en el Refugio de Wayne, en el Bosque de Terokkar.‡Apportez la Boîte de lingots à David Wayne au Refuge de Wayne dans la forêt de Terokkar.‡将一箱铁锭交给泰罗卡森林内韦恩的避难所的戴维·韦恩。‡將一箱鑄塊帶到泰洛卡森林的韋恩的避難所給大衛·偉恩。',
  }
},
[10663] = {
  {
    'O ferreiro eremita‡Кузнец–отшельник‡Der Wanderschmied‡은둔해 있는 대장장이‡El herrero ermitaño‡El herrero ermitaño‡L\'ermite forgeron‡隐居的铁匠‡隱居的鐵匠',
    nil,
    'Leve a Caixa de Lingotes para David Wayne, no Refúgio de Wayne, na Mata Terokkar.‡Принесите ящик со слитками Дэвиду Уэйну в приют Уэйна, который находится в лесу Тероккар.‡Bringt den Kasten mit Barren zu David Wayne in Waynes Zuflucht in den Wäldern von Terokkar.‡테로카르 숲의 웨인의 은거처에 있는 다비드 웨인에게 주괴 상자를 가져가야 합니다.‡Lleva la caja de lingotes a David Wayne en el Refugio de Wayne, en el Bosque de Terokkar.‡Lleva la caja de lingotes a David Wayne en el Refugio de Wayne, en el Bosque de Terokkar.‡Apportez la Boîte de lingots à David Wayne au Refuge de Wayne, dans la forêt de Terokkar.‡将一箱铁锭交给泰罗卡森林内韦恩的避难所的戴维·韦恩。‡將一箱鑄塊帶到泰洛卡森林的韋恩的避難所給大衛·偉恩。',
  }
},
[10664] = {
  {
    'Material adicional‡Дополнительные материалы‡Zusätzliche Materialien‡추가 재료‡Más materiales‡Más materiales‡Matériel supplémentaire‡其它的材料‡額外的材料',
    nil,
    'David Wayne, no Refúgio de Wayne, quer que você lhe traga uma Estrutura de Adamantita, 4 pedaços de Couro Nodoso Pesado e um Totem de Repelir Demônios.‡Принесите адамантитовую рамку, 4 куска толстой узловатой кожи и тотем защиты от демонов Дэвиду Уэйну в Приют Уэйна.‡David Wayne bei Waynes Zuflucht möchte, dass Ihr ihm einen Adamantitrahmen, 4 Stück schweres Knotenhautleder und ein Dämonenschutztotem bringt.‡웨인의 은거처에 있는 다비드 웨인이 아다만타이트 형틀 1개, 질긴 톱니매듭 가죽 4개, 악마 수호의 토템 1개를 가져다 달라고 했습니다.‡David Wayne del Refugio de Wayne quiere que le lleves 1 marco de adamantita, 4 piezas de cuero de pellejo nudoso grueso y 1 Tótem de amparo demoníaco.‡David Wayne del Refugio de Wayne quiere que le lleves 1 marco de adamantita, 4 piezas de cuero de pellejo nudoso grueso y 1 Tótem de amparo demoníaco.‡David Wayne du Refuge de Wayne veut que vous lui apportiez une Structure en adamantite, 4 Cuirs granuleux lourds et un Totem de sauvegarde contre les démons.‡将一个精金框架、4张重结缔皮和一个恶魔防护结界图腾交给韦恩的避难所的戴维·韦恩。‡韋恩的避難所的大衛·偉恩要你帶給她一個堅鋼骨架、4張厚重境外皮革還有一個惡魔守護圖騰。',
  }
},
[10665] = {
  {
    'Fresquinho dos Mecanar‡Новинка из Механара‡Frisch von der Mechanar‡메카나르의 마나저장소‡Recién hechas en El Mechanar‡Recién hechas en El Mechanar‡Tout frais du Méchanar‡能源舰的热源‡麥克納爾的容器',
    nil,
    'David Wayne, no Refúgio de Wayne, quer que você lhe traga uma Manacélula Sobrecarregada.‡Принесите избыточно заряженный аккумулятор маны Дэвиду Уэйну в Приют Уэйна.‡David Wayne bei Waynes Zuflucht möchte, dass Ihr ihm eine überladene Manazelle bringt.‡웨인의 은거처에 있는 다비드 웨인이 과충전된 마나저장소를 가져다 달라고 했습니다.‡David Wayne del Refugio de Wayne quiere que le lleves una célula de maná sobrecargada.‡David Wayne del Refugio de Wayne quiere que le lleves una célula de maná sobrecargada.‡David Wayne du Refuge de Wayne veut que vous lui apportiez une Cellule de mana surchargée.‡将超载的魔法晶格交给韦恩的避难所的戴维·韦恩。‡韋恩的避難所的大衛·偉恩要你交給他一個滿溢的法力容器。',
  }
},
[10666] = {
  {
    'O Lexicon Demonica‡Лексикон демоника‡Encyclopaedia Daemonica‡악마어 사전‡El Lexicón demoníaco‡El Lexicón demoníaco‡Le Lexicon Demonica‡魔语辞典‡惡魔詞典',
    nil,
    'Obtenha o Lexicon Demonica com o Grão-mestre Vorpil e o traga para David Wayne no Refúgio de Wayne.‡Добудьте книгу "Лексикон демоника" у великого мастера Ворпила и принесите его Дэвиду Уэйну в Приют Уэйна.‡Beschafft die Encyclopaedia Daemonica von Großmeister Vorpil und bringt sie zu David Wayne in Waynes Zuflucht.‡단장 보르필에게서 악마어 사전을 회수해 웨인의 은거처에 있는 다비드 웨인에게 가져가야 합니다.‡Consigue el Lexicón demoníaco del maestro mayor Vorpil y llévaselo a David Wayne en el Refugio de Wayne.‡Consigue el Lexicón demoníaco del maestro mayor Vorpil y llévaselo a David Wayne en el Refugio de Wayne.‡Procurez-vous le Lexicon Demonica sur le Grand Maître Vorpil et apportez-le à David Wayne au Refuge de Wayne.‡从沃匹尔大师手中夺得魔语辞典，将它交给韦恩的避难所的戴维·韦恩。‡從領導者瓦皮歐身上取得惡魔詞典然後交給韋恩的避難所的大衛·偉恩。',
  }
},
[10667] = {
  {
    'Greda do submundo‡Суглинок из Нижнего мира‡Unterweltlehm‡지하저수지의 흙‡Marga del submundo‡Marga del submundo‡De la terre du monde souterrain‡地下的土壤‡地獄土壤',
    nil,
    'Obtenha um Frasco de Greda do Submundo com a Hidromante Thespia e o traga para David Wayne no Refúgio de Wayne.‡Достаньте фиал с суглинком Нижнего мира у гидромантки Теспии и принесите его Дэвиду Уэйну в приют Уэйна.‡Beschafft Euch ein Gefäß mit Unterweltlehm von Wasserbeschwörerin Thespia und bringt es zu David Wayne in Waynes Zuflucht.‡풍수사 세스피아에게 지하저수지의 흙이 담긴 병을 얻은 후 웨인의 은거처에 있는 다비드 웨인에게 가져가야 합니다.‡Consigue 1 vial de marga del submundo de la hidromántica Thespia y llévaselo a David Wayne en el Refugio de Wayne.‡Consigue 1 vial de marga del submundo de la hidromántica Thespia y llévaselo a David Wayne en el Refugio de Wayne.‡Obtenez une Fiole de terre du monde souterrain de l\'hydromancienne Thespia et apportez-la à David Wayne au Refuge de Wayne.‡从水术师瑟丝比娅手中夺得水下洞穴的沃土，将它交给韦恩的避难所的戴维·韦恩。‡從海法師希斯比亞的身上取得一個瓶裝地獄土壤交給韋恩的避難所的大衛·偉恩。',
  }
},
[10668] = {
  {
    'Contra os Illidari‡Против иллидари‡Gegen die Illidari‡일리다리 공격‡Contra los Illidari‡Contra los Illidari‡Contre les Illidari‡对抗伊利丹‡對抗伊利達瑞',
    nil,
    'Altruis, o Sofredor, quer que você assassine Lothros no Pontal Illidari, no Vale da Lua Negra.‡Алтруис Страдалец просит вас убить Лотроса на аванпосте иллидари в долине Призрачной Луны.‡Altruis der Leider möchte, dass Ihr Lothros in der Stätte der Illidari im Schattenmondtal tötet.‡고뇌의 알트루이스가 어둠달 골짜기의 일리다리 거점에 있는 로드로스를 처치해 달라고 했습니다.‡Altruis el Sufridor quiere que mates a Lothros del Alto Illidari en el Valle Sombraluna.‡Altruis el Sufridor quiere que mates a Lothros del Alto Illidari en el Valle Sombraluna.‡Altruis le Souffrant veut que vous alliez tuer Lothros à la Halte Illidari dans la vallée d\'Ombrelune.‡受难者奥图里斯要你前往影月谷的伊利达雷岗哨杀死洛瑟鲁斯。‡『受難者』奧翠司要你去殺影月谷的伊利達瑞崗哨的洛斯羅司。',
  }
},
[10669] = {
  {
    'Contra todas as chances‡Вопреки всему‡Gegen jede Chance‡모든 악마의 적‡Contra todo pronóstico‡Contra todo pronóstico‡Contre toute attente‡扫除余孽‡挑戰不可能',
    nil,
    'Altruis, o Sofredor, quer que você leve a Lança de Prata Imbuída e a use na Clareira do Portal perto do Lago Pantanoso, que fica no Pântano Zíngaro, para acordar Xeleth. Fale novamente com Altruis depois que você tiver assassinado o demônio.‡Алтруис Страдалец хочет, чтобы вы взяли прочное серебряное копье и вонзили его на прогалине с порталом близ озера Болотных Огоньков, чтобы пробудить Кселета. Когда убьете демона, вернитесь к Алтруису.‡Altruis der Leider möchte, dass Ihr den magieerfüllten Silberspeer bei der Portalsicherung in der Nähe des Sumpflichtsees in den Zangarmarschen verwendet, um Xeleth zu wecken. Kehrt zu Altruis zurück, wenn Ihr den Dämon erlegt habt.‡고뇌의 알트루이스가 장가르 습지대의 수렁등불 호수 근처에 있는 차원문 폐허에서 마력 깃든 은빛창을 사용해 젤레스를 깨우라고 했습니다. 악마를 처치한 후 알트루이스에게 가야 합니다.‡Altruis el Sufridor quiere que lleves la lanza de plata imbuida y la uses en el Portal del Claro del Lago Luz Pantanosa, en la Marisma de Zangar, para despertar a Xeleth. Regresa junto a Altruis cuando hayas matado al demonio.‡Altruis el Sufridor quiere que lleves la lanza de plata imbuida y la uses en el Portal del Claro del Lago Luz Pantanosa, en la Marisma de Zangar, para despertar a Xeleth. Regresa junto a Altruis cuando hayas matado al demonio.‡Altruis le Souffrant veut que vous preniez la Lance en argent imprégné et que vous l\'utilisiez dans la Clairière du portail près du Lac des furoles du marécage de Zangar pour réveiller Xeleth. Retournez voir Altruis lorsque vous aurez tué le démon.‡受难者奥图里斯要你前往赞加沼泽，在沼光湖附近的荒弃传送门使用银色魔枪以唤醒克瑟勒斯。杀死这个恶魔之后，向奥图里斯复命。‡『受難者』奧翠司要你在贊格沼澤的沼澤光之湖的傳送門使用灌魔銀矛以喚醒希樂斯。殺死他之後回去找奧翠司。',
  }
},
[10670] = {
  {
    'Lágrima da Mãe-terra‡Слеза Матери-Земли‡Träne der Erdenmutter‡대지모신의 눈물‡La lágrima de la Madre Tierra‡La lágrima de la Madre Tierra‡La Larme de la Terre-Mère‡大地之母的眼泪‡大地之母的眼淚',
    nil,
    'Tome a Lágrima da Mãe-terra do Armipotente O\'mrogg e leve-a a David Wayne no Refúgio de Wayne.‡Добудьте слезу Матери-Земли у О\'мрогга Завоевателя и принесите ее Дэвиду Уэйну в приют Уэйна.‡Besorgt die Träne der Erdenmutter von Kriegshetzer O\'mrogg und bringt sie zu David Wayne in Waynes Zuflucht.‡전쟁인도자 오므로그에게서 대지모신의 눈물을 찾아서 웨인의 은거처에 있는 다비드 웨인에게 가져가야 합니다.‡Recupera la lágrima de la Madre Tierra del belisario O\'mrogg y llévasela a David Wayne en el Refugio de Wayne.‡Recupera la lágrima de la Madre Tierra del belisario O\'mrogg y llévasela a David Wayne en el Refugio de Wayne.‡Reprenez la Larme de la Terre-Mère au Porteguerre O’mrogg et apportez-la à David Wayne au Refuge de Wayne.‡从战争使者沃姆罗格手中夺得大地之母的眼泪，将它交给韦恩的避难所的戴维·韦恩。‡從戰爭使者歐姆拉格身上取回大地之母的眼淚然後交給韋恩的避難所的大衛·偉恩。',
  }
},
[10671] = {
  {
    'Mais que uma navalha na carne‡Не только фунт мяса‡Ein Pfund Geschnetzeltes‡단순한 살덩이 그 이상...‡Medio kilo de carne de primera‡Medio kilo de carne de primera‡Plus d\'une livre de chair‡不仅仅是一磅肉‡一磅多的肉',
    nil,
    'Colete 5 pedaços de Carne Energizada com Éte‡Дина Головокружилка просит вас добыть 5 кусков мяса, напитанного энергией Астрала. По выполнении вернитесь к ней на станцию Тошли в Острогорье.‡Taumel Dina möchte, dass Ihr 5 Einheiten astralisiertes Fleisch besorgt und zu ihr in Toshleys Station im Schergrat bringt.‡에테르 에너지가 깃든 살덩이 5개를 수집해야 합니다.‡Consigue 5 trozos de carne con energía de éter.‡‡Collectez 5 morceaux de Chair éthernergisée.‡晕乎乎的迪娜要求你收集5份以太能量肉块，并把它们带回托什雷的基地交给她。‡迪希·迪娜要你取得5個蒼穹能量肉體然後回到劍刃山脈的托斯利基地交給她。',
  }
},
[10672] = {
  {
    'Francamente, não faz sentido...‡Честно говоря, это – бред!‡Das ergibt echt keinen Sinn...‡솔직히 말해서 말도 안 되는 임무‡Francamente, no tiene ningún sentido...‡Francamente, no tiene ningún sentido...‡Franchement, ça n\'a aucun sens…‡没理由啊......‡老實說，這樣不合理',
    nil,
    'O Pesquisador Tiorus na Aldeia Lua Negra, que fica no Vale da Lua Negra, quer que você vá até a torrente de lava próxima às Ruínas de Baa\'ri e use a Unidade de Controle Arcano para comandar um Arcanescórpide. Vá nadar na lava controlando o Arcanescórpide e marque 8 Dimetrodontes Fogovil Maiores.‡Отправляйтесь к потокам лавы возле руин Баа\'ри и используйте пульт управления чарами, чтобы контролировать волшебного скорпиона. Переправьтесь на нем через лаву и пометьте 8 больших сквернопламенных деметродонов для ученого Тиоруса.‡Forscher Tiorus in Schattenmond im Schattenmondtal möchte, dass Ihr zu dem Lavastrom in der Nähe der Ruinen von Baa\'ri reist und die Arkanosteuereinheit benutzt, um einen Arkanoskorp zu steuern. Schwimmt mit dem Arkanoskorp durch die Lava und markiert 8 große Teufelsfeuerdimetrodons.‡어둠달 골짜기의 어둠달 마을에 있는 연구원 티오루스가 바아리 폐허 근처의 용암 호수로 가서 비전 조종기를 찾으라고 했습니다. 비전 전갈을 조종해 용암 속에서 헤엄을 치면서 거대한 지옥불꽃 디메트로돈 8마리에게 표시를 해야 합니다.‡El investigador Tiorus en la Aldea Sombraluna, en el Valle Sombraluna, quiere que viajes hasta el río de lava cerca de las Ruinas de Baa\'ri y utilices la unidad de control Arcano para controlar un arcano escórpido, nadar en la lava con el arcano escórpido y marcar 8 diemetradones de fuego vil superiores.‡El investigador Tiorus en la Aldea Sombraluna, en el Valle Sombraluna, quiere que viajes hasta el río de lava cerca de las Ruinas de Baa\'ri y utilices la unidad de control Arcano para controlar un arcano escórpido, nadar en la lava con el arcano escórpido y marcar 8 diemetradones de fuego vil superiores.‡Le chercheur Tiorus du village d\'Ombrelune dans la vallée d\'Ombrelune vous demande de voyager jusqu\'aux coulées de lave près des ruines de Baa\'ri, d\'utiliser l\'Unité d\'arcano-contrôle pour prendre le contrôle d\'un Arcano-Scorp, de nager dans la lave à l\'aide de l\'Arcano-Scorp et de marquer 8 Grands Dimeurtrodons de gangrefeu.‡影月谷影月村的研究员提欧鲁斯要求你前往巴尔里废墟附近的熔岩流，使用魔蝎控制器控制一只魔蝎，并用它标记8只大型魔火双帆龙。‡影月谷的影月村的研究員提歐魯斯要你去巴瑞廢墟的熔岩流附近然後使用秘法控制裝置控制一隻秘法蠍子，操控它潛入熔岩流中標示8隻大型惡魔烈焰雙帆龍。',
  }
},
[10673] = {
  {
    'Espinhavil, o Grande‡Хребтоскверн Старший‡Teufelsbuckel der Große‡거대한 지옥돌기‡Lomovil el Grande‡Lomovil el Grande‡Gangréchine la Très-Grande‡魔脊龙‡偉大的魔脊',
    nil,
    'O Pesquisador Tiorus na Aldeia Lua Negra, que fica no Vale da Lua Negra, quer que você mate Espinhavil, o Grande, e lhe traga o Couro de Espinhavil.‡Убейте Хребтоскверна Старшего и принесите его шкуру ученому Тиорусу в деревню Призрачной Луны в одноименной долине.‡Forscher Tiorus in Schattenmond im Schattenmondtal möchte, dass Ihr Teufelsbuckel den Großen tötet und Teufelsbuckels Balg beschafft.‡어둠달 골짜기의 어둠달 마을에 있는 연구원 티오루스가 거대한 지옥돌기를 처치한 후 지옥돌기 가죽을 가져다 달라고 했습니다.‡El investigador Tiorus en la Aldea Sombraluna, en el Valle Sombraluna, quiere que mates a Lomovil el Grande y consigas su pellejo.|n‡El investigador Tiorus en la Aldea Sombraluna, en el Valle Sombraluna, quiere que mates a Lomovil el Grande y consigas su pellejo.|n‡Le chercheur Tiorus du village d\'Ombrelune dans la vallée d\'Ombrelune vous demande de tuer Gangréchine la Très-Grande et de récupérer la Peau de Gangréchine.‡杀死魔脊龙，将魔脊龙之皮交给影月谷影月村的研究员提欧鲁斯。‡影月谷的影月村的研究員提歐魯斯要你殺死偉大的魔脊並且取回魔脊之皮。',
  }
},
[10674] = {
  {
    'Aprisione a luz fantástica‡Ловля фантастического света‡Das Licht der Phantasie einfangen‡라자니 빛구슬 수집‡Atrapar la luz fantástica‡Atrapar la Luz fantástica‡Et la lumière fut... piégée‡捕捉光球‡捕捉神奇的光球',
    nil,
    'Use a Armadilha de Luz para coletar 15 Orbes de Luz Razaani.‡Тошли желает, чтобы вы при помощи световой ловушки поймали 15 световых сфер братства Разаани. По выполнении задания вернитесь к нему на станцию Тошли в Острогорье.‡Toshley möchte, dass Ihr die Lichtfalle benutzt, um 15 Lichtkugeln der Razaani zu fangen. Kehrt danach zu Toshley in Toshleys Station im Schergrat zurück.‡다분광 함정을 사용하여 라자니 빛구슬 15개를 모아야 합니다.‡Utiliza la trampa de luz para atrapar 15 orbes de luz Razaani.‡‡Utilisez le Piège à lumière pour attraper 15 Orbes de lumière razaani.‡托什雷要求你使用多光谱光能陷阱捕获15颗拉扎安光球，完成之后回托什雷的基地向他复命。‡托斯利要你使用聖光陷阱捕捉15個雷森光球。任務完成後回到劍刃山脈的托斯利基地向他回報。',
  }
},
[10675] = {
  {
    'Tamanho não é documento‡Попомните гномскую доброту!‡Ein Gnom kennt kein Erbarmen!‡노움의 자비로움!‡¡Gnomas piedad!‡¡Gnomas piedad!‡Dégnomez-les tous !‡侏儒之怒！‡給他們地精式的解脫!',
    nil,
    'Recolha a Coleção de Almas.‡Тошли хочет, чтобы вы добыли для него коллекцию душ и вернулись к нему на стнацию Тошли в Острогорье.‡Toshley möchte, dass Ihr die Seelensammlung beschafft. Kehrt danach zu Toshley in Toshleys Station im Schergrat zurück.‡영혼의 전리품을 입수해야 합니다.‡Recupera la colección de almas.‡‡Récupérez la Collection d’âmes.‡托什雷要求你取回灵魂之盒，并把它带回刀锋山内的托什雷的基地交给他。‡托斯利要你取得靈魂收集品然後回到劍刃山脈的托斯利基地交給他。',
  }
},
[10676] = {
  {
    'Ruína dos Illidari‡Проклятие иллидари‡Bann der Illidari‡일리다리의 독‡El terror de los Illidari‡El terror de los Illidari‡La plaie des Illidari‡伊利达雷的斩除者‡',
    nil,
    'Espere que David Wayne termine de forjar a espada para você.‡Подождите, пока Дэвид Уэйн откует для вас клинок.‡Wartet, bis David Wayne das Schwert für Euch fertig geschmiedet hat.‡다비드 웨인이 당신에게 줄 검을 완성할 때까지 기다려야 합니다.‡Espera a que David Wayne te forje una espada.‡Espera a que David Wayne te forje una espada.‡Attendez que David Wayne ait terminé de forger une épée pour vous.‡等待戴维·韦恩为你铸剑。‡',
  }
},
[10677] = {
  {
    'O segundo prato...‡Второе блюдо...‡Der zweite Gang...‡다음 메뉴는...‡De segundo...‡De segundo...‡Le deuxième service...‡第二道菜......‡第二道菜……',
    nil,
    'Gnomus na Fortaleza Martelo Feroz, no Vale da Lua Negra, quer que você lhe traga 1 Moela Hipertrofiada de Fogovil.‡Добудьте для Гномуса из цитадели Громового Молота в долине Призрачной Луны потроха крупного деметродона.‡Gnomus in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr einen überentwickelten Teufelsfeuermuskelmagen besorgt.‡어둠달 골짜기의 와일드해머 성채에 있는 노무스가 지나치게 발달한 지옥불꽃 내장 1개를 가져다 달라고 했습니다.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes 1 molleja de fuego vil hipertrofiada.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes 1 molleja de fuego vil hipertrofiada.‡Gnomus du bastion des Marteaux-Hardis dans la vallée d\'Ombrelune veut que vous récupériez 1 Gésier de gangrefeu surdéveloppé.‡影月谷蛮锤要塞的诺姆斯要求你给他带回一个巨大的魔火胃囊。‡影月谷蠻錘要塞的葛諾瑪斯要你取回一個過大的惡魔烈焰內臟。',
  }
},
[10678] = {
  {
    'O prato principal!‡Гвоздь программы‡Das Hauptgericht!‡주요리!‡¡El plato fuerte!‡¡El plato fuerte!‡Le plat principal !‡主菜！‡主菜上場!',
    nil,
    'Gnomus na Fortaleza Martelo Feroz, no Vale da Lua Negra, quer que você lhe traga o Couro de Espinhavil.‡Принесите шкуру Хребтоскверна Гномусу в цитадель Громового Молота в долине Призрачной Луны.‡Gnomus in der Wildhammerfeste im Schattenmondtal möchte, dass Ihr Teufelsbuckels Balg besorgt.‡어둠달 골짜기의 와일드해머 성채에 있는 노무스가 지옥돌기 가죽을 가져다 달라고 했습니다.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes el pellejo de Lomovil.‡Gnomus, del Bastión Martillo Salvaje en el Valle Sombraluna, quiere que recuperes el pellejo de Lomovil.‡Gnomus du bastion des Marteaux-Hardis dans la vallée d\'Ombrelune veut que vous récupériez la Peau de Gangréchine.‡将魔脊龙之皮交给影月谷蛮锤要塞的诺姆斯。‡影月谷蠻錘要塞的葛諾瑪斯要你帶回魔脊之皮。',
  }
},
[10679] = {
  {
    'Temperando a lâmina‡Закалка Меча‡Die Waffe härten‡검 담금질‡Templar la espada‡Templar la espada‡Tremper la lame‡淬火‡',
    nil,
    'Vá até os Lagos Escaldantes, localizados perto do topo da A Mão de Gul\'dan, e use a Lâmina da Ruína dos Illidari Forjada para temperá-la nos poços de lava. Uma vez que a lâmina esteja temperada, fale de novo com David Wayne no Refúgio de Wayne.‡Отправляйтесь к Жгучим прудам возле подножия Руки Гул\'дана, и закалите кованый меч погибели иллидари в озерах лавы. После этого возвращайтесь к Дэвиду Уэйну в приют Уэйна.‡Reist zu den siedenden Teichen in der Nähe des Gipfels der Hand von Gul\'dan und härtet die geschmiedete Klinge des Illidaribanns in den Lavabecken. Kehrt dann mit der gehärteten Klinge des Illidaribanns zu David Wayne in Waynes Zuflucht zurück.‡굴단의 손아귀의 꼭대기 근처에 있는 끓어오르는 웅덩이에 가서 용암 속에 벼려낸 일리다리 파멸검을 넣고 담금질한 후, 담금질된 일리다리 파멸검을 얻은 후 웨인의 은거처에 있는 다비드 웨인에게 가야 합니다.‡Viaja hasta Las Pozas Escaldantes próximas a la cumbre de La Mano de Gul\'dan y usa la hoja de pesadilla Illidari forjada para enfriarla en las pozas de lava. Cuando tengas la hoja de pesadilla Illidari templada, regresa junto a David Wayne en el Refugio de Wayne.‡Viaja hasta Las Pozas Escaldantes próximas a la cumbre de La Mano de Gul\'dan y usa la hoja de pesadilla Illidari forjada para enfriarla en las pozas de lava. Cuando tengas la hoja de pesadilla Illidari templada, regresa junto a David Wayne en el Refugio de Wayne.‡Voyagez jusqu\'aux Bassins Brûlants situés près du sommet de la Main de Gul’dan et utilisez la Lame plaie-des-Illidari forgée pour la tremper dans les bassins de lave. Une fois que vous aurez la Lame plaie-des-Illidari trempée, retournez auprès de David Wayne au Refuge de Wayne.‡前往古尔丹之手顶部寻找滚烫熔池，将铸成的伊利达雷斩除之刃放入熔岩池中淬火。然后将淬火的伊利达雷斩除之刃交给韦恩的避难所的戴维·韦恩。‡',
  }
},
[10680] = {
  {
    'A Mão de Gul\'dan‡Рука Гул\'дана‡Die Hand von Gul\'dan‡굴단의 손아귀‡La Mano de Gul\'dan‡La Mano de Gul\'dan‡La main de Gul\'dan‡古尔丹之手‡古爾丹火山',
    nil,
    'Fale com o Reparador da Terra Torlok no Altar da Danação, que fica no Vale da Lua Negra.‡Поговорите с целителем земли Торлоком у Алтаря Проклятия в Долине Призрачной Луны.‡Sprecht mit Erdheiler Torlok am Altar der Verdammnis im Schattenmondtal.‡어둠달 골짜기의 저주의 제단에 있는 대지의 치유사 토르록과 대화해야 합니다.‡Habla con el ensalmador de la tierra Torlok en El Altar de Condenación del Valle Sombraluna.‡Habla con el ensalmador de la tierra Torlok en El Altar de Condenación del Valle Sombraluna.‡Parlez au soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune.‡与影月谷诅咒祭坛的大地治愈者托洛克谈一谈。‡跟影月谷詛咒祭壇的大地治癒者托爾洛克交談。',
  }
},
[10681] = {
  {
    'A Mão de Gul\'dan‡Рука Гул\'дана‡Die Hand von Gul\'dan‡굴단의 손아귀‡La Mano de Gul\'dan‡La Mano de Gul\'dan‡La main de Gul\'dan‡古尔丹之手‡古爾丹火山',
    nil,
    'Fale com o Reparador da Terra Torlok no Altar da Danação, que fica no Vale da Lua Negra.‡Поговорите с целителем земли Торлоком у Алтаря Проклятия в Долине Призрачной Луны.‡Sprecht mit Erdheiler Torlok am Altar der Verdammnis im Schattenmondtal.‡어둠달 골짜기의 저주의 제단에 있는 대지치유사 토르록과 대화해야 합니다.‡Habla con el ensalmador de la tierra Torlok en El Altar de Condenación del Valle Sombraluna.‡Habla con el ensalmador de la tierra Torlok en El Altar de Condenación del Valle Sombraluna.‡Parlez au soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune.‡与影月谷诅咒祭坛的大地治愈者托洛克谈一谈。‡跟影月谷詛咒祭壇的大地治癒者托爾洛克交談。',
  }
},
[10682] = {
  {
    'Hora de negociar...‡Время для переговоров...‡Zeit zu verhandeln...‡협상의 시간...‡Tiempos de negociación...‡Tiempos de negociación...‡Un temps pour la négociation...‡该谈判了......‡協商時間……',
    nil,
    'Negocie com o Supervisor Nuaar.‡Хранитель деревьев Чаун просит вас переговорить с надзирателем Нуааром. После вернитесь к хранителю деревьев в Вечную рощу в Острогорье.‡Baumhüter Chawn möchte, dass Ihr mit Aufseher Nuaar verhandelt. Kehrt danach zu dem Baumhüter im ewigen Hain im Schergrat zurück.‡감독관 누아르와 협상한 후, 칼날 산맥의 영원의 숲에 있는 나무지기 숀에게 돌아가야 합니다.‡El depositario de árboles Chawn ha pedido que negocies con el sobrestante Nuaar. Después regresa junto al depositario de árboles a Soto Eterno en las Montañas Filospada.‡‡Le Gardien des arbres Chawn vous a demandé de négocier avec le Surveillant Nuaar. Ensuite, retournez voir le gardien des arbres au Bosquet éternel dans les Tranchantes.‡护树者查恩要求你去与工头努埃尔谈判。完成之后向刀锋山内常青林的护树者查恩复命。‡林木守衛蕭恩要你去與監督者奴阿爾協商。完成後回到劍刃山脈的永恆樹林找林木守衛。',
  }
},
[10683] = {
  {
    'Tabuletas de Baa\'ri‡Таблички Баа\'ри‡Schrifttafeln von Baa\'ri‡바아리 서판‡Las tablillas de Baa\'ri‡Las tablillas de Baa\'ri‡Tablettes de Baa\'ri‡巴尔里石板‡巴瑞碑文',
    nil,
    'O Arcanista Thelis, no Sacrário Estelar, quer que você recolha 12 Tabuletas Baa\'ri no chão e com os Trabalhadores Grislíngua, nas Ruínas de Baa\'ri.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Соберите для чародея Тэлиса из святилища Звезд 12 табличек Баа\'ри. Таблички могут быть где-то закопаны или находиться у Пеплоустов-рабочих.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Arkanist Thelis beim Sanktum der Sterne möchte, dass Ihr 12 Schrifttafeln von Baa\'ri vom Boden und von den Arbeitern der Aschenzungen in den Ruinen von Baa\'ri sammelt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡별의 성소에 있는 비전술사 텔리스가 바아리 폐허에서 바아리 서판 12개를 모아달라고 했습니다. 서판은 땅에서 줍거나 바아리 폐허의 잿빛혓바닥 일꾼을 처치해서 얻을 수 있습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El arcanista Thelis del Sagrario de las Estrellas quiere que consigas 12 tablillas Baa\'ri en las Ruinas de Baa\'ri.nnA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡El arcanista Thelis del Sagrario de las Estrellas quiere que consigas 12 tablillas Baa\'ri en las Ruinas de Baa\'ri.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡L\'arcaniste Thelis du Sanctum des Étoiles veut que vous collectiez 12 Tablettes baa\'ri aux Ruines de Baa\'ri.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡群星圣殿的奥术师塞里斯要你收集12块巴尔里石板。它们散落在巴尔里废墟中，那里的灰舌工人身上也携带着这种石板。nn为占星者阵营完成任务将降低你在奥尔多阵营中的声望等级。‡星光聖所的秘法師賽利斯要你去巴瑞廢墟從地上及灰舌勞工身上收集12個巴瑞碑文。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10684] = {
  {
    'Oronu, o Ancião‡Старец Орону‡Oronu der Älteste‡장로 오로누‡Oronu el Anciano‡Oronu el Anciano‡Oronu l\'Ancien‡长者奥洛努‡長者奧朗奴',
    nil,
    'O Arcanista Thelis no Sacrário Estelar quer que você obtenha as Ordens de Akama com Oronu, o Ancião, nas Ruínas de Baa\'ri.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Найдите в руинах Баа\'ри приказы Акамы, адресованные старцу Орону, и принесите их чародею Телису.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Arkanist Thelis beim Sanktum der Sterne möchte, dass Ihr die Befehle von Akama von Oronu dem Ältesten in den Ruinen von Baa\'ri besorgt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡별의 성소에 있는 비전술사 텔리스가 바아리 폐허에 있는 장로 오로누를 처치하고 아카마의 명령서를 입수해 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El arcanista Thelis del Sagrario de las Estrellas quiere que consigas las órdenes de Akama de Oronu el Anciano en las Ruinas de Baa\'ri.nnA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡El arcanista Thelis del Sagrario de las Estrellas quiere que consigas las órdenes de Akama de Oronu el Anciano en las Ruinas de Baa\'ri.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡L\'arcaniste Thelis du Sanctum des Étoiles veut que vous preniez les Ordres d\'Akama à Oronu l\'Ancien aux Ruines de Baa\'ri.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡群星圣殿的奥术师塞里斯要求你从巴尔里废墟的长者奥洛努手中夺得阿卡玛的命令。nn为占星者阵营完成任务将降低你在奥尔多阵营中的声望等级。‡星光聖所的秘法師賽利斯要你去巴瑞廢墟取回長者奧朗奴身上的阿卡瑪的命令。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10685] = {
  {
    'Os corruptores Grislíngua‡Осквернители из клана Пеплоустов‡Die Verderber der Aschenzungen‡잿빛혓바닥 타락자‡Los corruptores Lengua de Ceniza‡Los corruptores Lengua de Ceniza‡Les corrupteurs cendrelangues‡灰舌腐蚀者‡灰舌墮落者',
    nil,
    'Obtenha os quatro fragmentos de medalhão com Haalum, Eykenen, Lakaan e Uylaru e procure o Arcanista Thelis no Sacrário Estelar, que fica no Vale da Lua Negra.nnCompletar missões para os Áugures reduzirá sua reputação entre os Aldor.‡Соберите 4 фрагмента медальона у Хаалума, Айкенена, Уйлару, и Лакаана и вернитесь к чародею Тэлису в святилище Звезд.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Beschafft die vier Medaillonfragmente von Haalum, Eykenen, Lakaan und Uylaru und kehrt danach zu Arkanist Thelis beim Sanktum der Sterne im Schattenmondtal zurück.nnDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡할룸, 에이케넨, 라칸, 우일라루를 처치하고 메달 조각 4개를 입수한 후 어둠달 골짜기의 별의 성소에 있는 비전술사 텔리스에게 가야 합니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Recupera los 4 trozos de los medallones de Haalum, Eykenen, Lakaan y Uylaru, regresa junto al arcanista Thelis del Sagrario de las Estrellas, en el Valle Sombraluna.nnA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Recupera los 4 trozos de los medallones de Haalum, Eyeknen, Lakaan y Uylaru, regresa junto al arcanista Thelis del Sagrario de las Estrellas, en el Valle Sombraluna.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Procurez-vous les quatre fragments du médaillon sur Haalum, Eykenen, Lakaan et Uylaru et rapportez-les à l\'arcaniste Thelis au Sanctum des Étoiles dans la vallée d\'Ombrelune.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡从哈鲁姆、埃肯尼、拉坎恩和乌拉鲁手中夺得他们的勋章碎片，并把这些碎片交给影月谷群星圣殿的奥术师塞里斯。nn为占星者阵营完成任务将降低你在奥尔多阵营中的声望等级。‡從哈盧姆，伊肯尼恩，拉卡恩和烏拉魯那邊取回四個勳章碎片然後回到影月谷的星光聖所找秘法師賽利斯。|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10686] = {
  {
    'A Jaula do Carcereiro‡Клеть Стражницы‡Der Kerker des Wächters‡감시자의 수용소‡La Jaula de la Guardiana‡La Jaula de la Guardiana‡La Cage de la gardienne‡守望者的牢笼‡典獄官監牢',
    nil,
    'O Arcanista Thelis quer que você entre na Jaula do Carcereiro, ao sul das Ruínas de Baa\'ri e interrogue Sanoru quanto à localização de Akama.nnCompletar missões para os Áugures reduzirá sua reputação entre os Aldor.‡Отправляйтесь в Клеть Стражницы, к югу от руин Баа\'ри и расспросите Санору о местонахождении Акамы для чародея Телиса.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Arkanist Thelis möchte, dass Ihr den Kerker des Wächters südlich der Ruinen von Baa\'ri betretet und Sanoru über Akamas Aufenthaltsort befragt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡비전술사 텔리스가 바아리 폐허의 남쪽에 있는 감시자의 수용소로 들어가서 사노루를 심문해 아카마의 행방을 알아봐 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El arcanista Thelis quiere que entres en la Jaula de la Guardiana, al sur de las Ruinas de Baa\'ri e interrogues a Sanoru sobre el paradero de Akama.nnCompletar misiones para los Arúspices hará que tu nivel de reputación entre los Aldor descienda.‡El arcanista Thelis quiere que entres en la Jaula de la Guardiana, al sur de las Ruinas de Baa\'ri e interrogues a Sanoru sobre el paradero de Akama.|n|nCompletar misiones para los Arúspices hará que tu nivel de reputación entre los Aldor descienda.‡L\'arcaniste Thelis veut que vous entriez dans la Cage de la gardienne, au sud des ruines de Baa\'ri, et que vous interrogiez Sanoru pour apprendre où se trouve Akama.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡奥术师塞里斯要求你进入巴尔里废墟以南的守望者牢笼，从萨诺鲁口中审问出阿卡玛的下落。nn为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡秘法師賽利斯要你前往位在巴瑞廢墟南邊的典獄官監牢。拷問杉諾魯關於阿卡瑪的下落。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10687] = {
  {
    'Campo de treinamento Karabor‡Тренировочная площадка Карабора‡Ausbildungsgelände von Karabor‡카라보르 훈련소‡Patio de Armas de Karabor‡Patio de Armas de Karabor‡Les terrains d\'entraînement de Karabor‡卡拉波训练场‡卡拉伯爾訓練場',
    nil,
    'Larissa Golpessol, no Sacrário Estelar, quer que você obtenha 8 Glaives Solfúria dos Caçadores de Demônios Suplicantes e Caçadores de Demônios Iniciados nas Ruínas de Karabor, a nordeste do Sacrário Estelar.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Отберите у соискателей и посвященных охотников на демонов, сосредоточенных в руинах Карабора, 8 глеф армии Ярости Солнца. Принесите их Лариссе Солнцесвет в святилище Звезд.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Larissa Sonnenhieb beim Sanktum der Sterne möchte, dass Ihr 8 Gleven des Sonnenzorns von den Bittstellern der Dämonenjäger und den Initianden der Dämonenjäger in den Ruinen von Karabor, nordöstlich des Sanktums der Sterne, beschafft.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡별의 성소에 있는 라리사 선스트라이크가 별의 성소 북동쪽의 카라보르 폐허에 있는 악마사냥꾼 지원자와 수습 악마사냥꾼들을 처치하고 성난태양 글레이브 8개를 입수해 달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Larissa Golpe de Sol en el Sagrario de las Estrellas quiere que consigas 8 gujas de Furia del Sol de suplicantes cazadores de demonios e iniciados cazadores de demonios en las Ruinas de Karabor, al noreste del Sagrario de las Estrellas.nnA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Golpe Solar en el Sagrario de las Estrellas quiere que consigas 8 gujas de Furia del Sol de suplicantes cazademonios y de iniciados cazademonios en las Ruinas de Karabor, al noreste del Sagrario de las Estrellas.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Heurtesoleil au Sanctum des Étoiles veut que vous vous procuriez 8 Vouges solfurie sur les Suppliants solfurie et les Initiés solfurie aux Ruines de Karabor, au nord-est du Sanctum des étoiles.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡群星圣殿的拉瑞萨·射日者要你前往群星圣殿东北方的卡拉波废墟，从恶魔猎手学员和恶魔猎手新兵身上夺取8柄日怒阔剑。nn为占星者完成任务将会降低你在奥尔多阵营中的声望等级。‡星光聖所的拉瑞莎·擊日者要你從星光聖所東北方，卡拉伯爾廢墟的惡魔獵人懇求者還有惡魔獵人見習生身上奪回8個日怒大刀。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10688] = {
  {
    'Uma distração necessária‡Необходимая уловка‡Eine notwendige Ablenkung‡교란 작전‡Una distracción necesaria‡Una distracción necesaria‡Une diversion nécessaire‡必要的混乱‡製造混亂',
    nil,
    'Larissa Golpessol quer que você volte às Ruínas de Karabor e descubra uma forma de libertar Azaloth, voltando-o contra seus captores.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Вернитесь в Руины Карабора и освободите Азалота для Лариссы Солнцесвет.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Larissa Sonnenhieb möchte, dass Ihr zu den Ruinen von Karabor zurückkehrt und Azaloth auf seine Kerkermeister hetzt.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡라리사 선스트라이크가 카라보르 폐허로 돌아가서 아잘로스를 풀어달라고 했습니다.nn점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Larissa Golpe Solar quiere que vuelvas a las Ruinas de Karabor y encuentres una forma de liberar a Azaloth de sus captores.nnA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Golpe Solar quiere que vuelvas a las Ruinas de Karabor y encuentres una forma de liberar a Azaloth de sus captores.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Heurtesoleil veut que vous retourniez aux Ruines de Karabor et que vous trouviez un moyen de lâcher Azaloth sur ses geôliers.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡拉瑞萨·射日者要你返回卡拉波废墟，设法令阿萨洛斯摆脱放逐状态。nn为占星者完成任务将会降低你在奥尔多阵营中的声望等级。‡拉瑞莎·擊日者要你回到卡拉伯爾廢墟，並且找出方法釋放阿薩羅斯。B|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10689] = {
  {
    'Altruis‡Алтруис‡Altruis‡알트루이스‡Altruis‡‡Altruis‡奥图里斯‡奧翠司',
    nil,
    'Vá até o oeste de Nagrand e encontre Altruis, o Sofredor.nnCompletar missões para os Áugures reduzirá sua reputação junto aos Aldor.‡Отправляйтесь в западный Награнд и найдите Алтруиса Страдальца.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Reist in den Westen Nagrands und sucht Altruis den Leider.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡나그란드 서부로 가서 고뇌의 알트루이스를 만나야 합니다.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Dirígete al oeste de Nagrand y encuentra a Altruis el Sufridor.nnA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Dirígete al oeste de Nagrand y encuentra a Altruis el Sufridor.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Voyagez jusqu\'au Nagrand occidental et allez trouver Altruis le Souffrant.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡前往纳格兰西部寻找受难者奥图里斯。nn为占星者完成任务将会降低你在奥尔多阵营中的声望等级。‡前往西方的納葛蘭並且找到『受難者』奧翠司。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10690] = {
  {
    'A matriarca do covil‡Мать логова‡Die Höhlenmutter‡우두머리 레마‡La madre del cubil‡La madre del cubil‡La Mère de la tanière‡兽穴之母‡獸穴之后',
    nil,
    'Mate Rema.‡Убейте Рему и сообщите об этом командиру Тень Небес в Сильванаар в Острогорье.‡Tötet Rema und meldet Euch dann bei Kommandant Himmelsschatten in Sylvanaar im Schergrat.‡레마를 처치한 다음 칼날 산맥의 실바나르에 있는 사령관 스카이섀도에게 알려 주어야 합니다.‡Mata a Rema e informa al comandante Cielosombra de Sylvanaar, en las Montañas Filospada.‡‡Tuez Rema puis informez-en le commandant Ombreciel à Sylvanaar dans les Tranchantes.‡杀死雷玛，并通知刀锋山希尔瓦纳的指挥官萨卡斯·天影。‡殺死瑞瑪然後通知在劍刃山脈之希爾瓦納的指揮官天影。',
  }
},
[10691] = {
  {
    'Retorno aos Áugures‡Возвращение к Провидцам‡Rückkehr zu den Sehern‡점술가 길드로 귀환‡Regresa junto a los Arúspices‡Regresa junto a los Arúspices‡Retour chez les Clairvoyants‡返回群星圣殿‡回到先知者身邊',
    nil,
    'Fale com Larissa Golpessol no Sacrário Estelar, que fica no Vale da Lua Negra.nnCompletar missões para os Áugures reduzirá sua reputação com os Aldor.‡Поговорите с Лариссой Солнцесвет в святилище Звезд в долине Призрачной Луны.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Sprecht mit Larissa Sonnenhieb beim Sanktum der Sterne im Schattenmondtal.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡어둠달 골짜기의 별의 성소에 있는 라리사 선스트라이크와 대화해야 합니다.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 평판이 떨어질 것입니다.‡Habla con Golpe Solar del Sagrario de las Estrellas, en el Valle Sombraluna.nnA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Habla con Golpe Solar del Sagrario de las Estrellas, en el Valle Sombraluna.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Parlez à Larissa Heurtesoleil au Sanctum des Étoiles dans la vallée d’Ombrelune.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡与影月谷群星圣殿的拉瑞萨·射日者谈一谈。nn为占星者完成任务将会降低你在奥尔多阵营中的声望等级。‡與影月谷裡星光聖所的拉瑞莎·擊日者談談。|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10692] = {
  {
    'Varedis precisa ser detido!‡Варедиса нужно остановить!‡Varedis muss aufgehalten werden‡베레디스를 막아야 한다...‡Hay que detener a Varedis‡Hay que detener a Varedis‡Il faut arrêter Varedis‡阻止瓦雷迪斯‡阻止瓦瑞迪斯',
    nil,
    'Larissa Golpessol quer que você vá até as ruínas de Karabor e mate Alandien, Theras, Netharel e Varedis. Use o Livro dos Nomes Abjetos para enfraquecer Varedis quando ele usar Metamorfose. Fale novamente com Larissa Golpessol após completar a tarefa.nnCompletar missões para os Áugures reduzirá sua reputação junto aos Aldor.‡Отправляйтесь в Руины Карабора и убейте Аландиен, Тераса, Нетариеля и самого Варедиса. Используйте Книгу Имен Скверны, когда Варедис будет перевоплощаться, чтобы ослабить его. Вернитесь к Лариссе Солнцесвет с Книгой Имен Скверны по выполнении задания.nnВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Larissa Sonnenhieb möchte, dass Ihr zu den Ruinen von Karabor geht und Alandien, Theras, Netharel und Varedis tötet. Benutzt das Buch der teuflischen Namen, während Varedis die Fähigkeit \'Metamorphose\' einsetzt, um ihn zu schwächen. Kehrt danach mit dem Buch der teuflischen Namen zu Larissa Sonnenhieb zurück.nnDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡라리사 선스트라이크가 카라보르 폐허로 가서 알란디엔, 테라스, 네사렐, 베레디스를 해치워 달라고 했습니다. 베레디스가 탈태할 때 저주받은 이름의 책을 사용해서 힘을 약화시켜야 합니다. 이 임무를 마친 후 저주받은 이름의 책을 들고 라리사 선스트라이크에게 돌아가십시오.nn점술가 길드를 위한 퀘스트를 수행하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Larissa Golpe Solar quiere que vayas a las Ruinas de Karabor y mates a Alandien, Theras, Netharel y Varedis. Utiliza el Libro de Nombres Viles para debilitar a Varedis cuando use la metamorfosis. Vuelve a verla con el libro cuando hayas acabado.nnA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Golpe Solar quiere que vayas a las Ruinas de Karabor y mates a Alandien, Theras, Netharel y Varedis. Utiliza el Libro de Nombres Viles para debilitar a Varedis cuando use la metamorfosis. Vuelve a verla con el libro cuando hayas acabado.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Larissa Heurtesoleil veut que vous vous rendiez aux ruines de Karabor et que vous tuiez Alandien, Theras, Netharel et Varedis. Utilisez le Livre des noms gangrenés quand Varedis utilisera sa métamorphose, pour l’affaiblir. Retournez voir Larissa Heurtesoleil avec le Livre des noms gangrenés lorsque vous aurez terminé cette tâche.nnAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l’Aldor.‡拉瑞萨·射日者要你前往卡拉波废墟，杀死阿兰蒂恩、瑟拉斯、奈萨里尔和瓦雷迪斯。在瓦雷迪斯变身为恶魔形态时利用恶魔名册削弱他的力量。完成任务后将恶魔名册交给拉瑞萨·射日者。nn为占星者完成任务将会降低你在奥尔多阵营中的声望等级。‡拉瑞莎·擊日者要你到卡拉伯爾廢墟殺掉艾倫狄恩、賽拉斯、奈斯瑞歐以及瓦瑞迪斯。在瓦瑞迪斯使用變形符文時用惡魔之名寶典來削弱他的力量。任務完成後帶著惡魔之名寶典回報拉瑞莎·擊日者|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
