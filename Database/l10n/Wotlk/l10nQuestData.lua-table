[10379] = {
  {
    'Toque de Fraqueza‡Прикосновение слабости‡Berührung der Schwäche‡무력의 손길‡Un toque de debilidad‡Toque de debilidad‡Toucher de faiblesse‡虚弱之触‡虛弱之觸',
