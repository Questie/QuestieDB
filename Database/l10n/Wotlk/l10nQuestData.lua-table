[1794] = {
  {
    'Tomo da Bravura‡Фолиант Отваги‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
