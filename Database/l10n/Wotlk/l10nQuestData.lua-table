[620] = {
  {
    'A Faixa com Monograma‡Кушак с монограммой‡Die Schärpe mit Monogramm‡이니셜이 새겨진 머리띠‡El fajín con monogramas‡La banda con monograma‡L\'écharpe à monogramme‡刺着字母的腰带‡刺著字母的束帶',
    nil,
    'Devolva a Faixa com Monograma ao proprietário.‡Верните кушак с монограммой владельцу.‡Bringt die Schärpe mit Monogramm zu ihrem Besitzer zurück.‡이니셜이 새겨진 머리띠를 주인에게 돌려줘야 합니다.‡Devuelve el fajín con monograma a su propietario.‡Devuelve la banda con monograma a su propietario.‡Rendre l\'Écharpe à monogramme à son propriétaire.‡将刺着字母的腰带还给他的主人。‡將刺著字母的束帶還給他的主人。',
  }
},
[621] = {
  {
    'O segredo de Zanzil‡Тайна Занзила‡Zanzils Geheimnis‡잔질의 비법‡El secreto de Zanzil‡El secreto de Zanzil‡Le secret de Zanzil‡赞吉尔的秘密‡贊吉爾的秘密',
    nil,
    'Leve 12 amostras do Preparado de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите Шиззи Пуззыриксу из Пиратской Бухты 12 образцов смеси Занзила.‡Bringt 12 Proben von Zanzils Mixtur zu Crank Zischelbub nach Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Lleva 12 muestras de la mezcla de Zanzil a Loquillo Pinchabujas en la Bahía del Botín.‡Apporter 12 Échantillons de Mixture de Zanzil à Grincheux Bullévente à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[622] = {
  {
    'Fale novamente com o Cabo Kaleb‡Возвращение к капралу Калебу‡Rückkehr zu Korporal Kaleb‡하사관 칼레브에게 돌아가기‡Regresa junto al cabo Kaleb‡Regresa junto al cabo Kaleb‡La cocotte du caporal Kaleb‡向卡雷布下士回报‡向卡雷布下士回報',
    nil,
    'Leve a Caçarola Melhorada do Krazek para o Cabo Kaleb no Acampamento dos Rebeldes.‡Отнесите целый горшок Крейвела капралу Калебу в Лагерь повстанцев.‡Bringt Krazeks reparierten Topf zu Korporal Kaleb im Rebellenlager.‡반란군 야영지에 있는 하사관 칼레브에게 크라젝의 수리된 냄비를 가져가야 합니다.‡Lleva la olla de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Lleva la olla mecánica de Krazek arreglada al cabo Kaleb en el Asentamiento Rebelde.‡Apporter la Cocotte réparée de Krazek au caporal Kaleb, au Camp rebelle.‡将修理过的烹调锅交给叛军营地的卡雷布下士。‡將修理過的烹調鍋交給反抗軍營地的卡雷布下士。',
  }
},
[623] = {
  {
    'Akiris aos montes‡Вязанка акириса‡Bündelweise Akiris‡아키리스 묶음‡Fardo de cañas akiris‡Tallos de juncos akiris‡De derrière les fagots‡一捆海蛇草‡一捆海蛇草',
    nil,
    'Leve um Feixe de Junco de Akiris para o Corsário Groy, em Theramore.‡Принесите сверток со стеблями акириса каперу Грою в Терамор.‡Bringt ein Bündel Akirisschilfrohr zu Freibeuter Groy nach Theramore.‡테라모어 섬에 있는 선원 그로이에게 아키리스 갈대 한 묶음을 가져가야 합니다.‡Lleva un fardo de cañas akiris al corsario Groy, en Theramore.‡Lleva un fajo de juncos akiris al corsario Groy, en Theramore.‡Apporter un Fagot de roseaux akiris au corsaire Groy à Theramore.‡给塞拉摩的海盗格罗伊带去一束海蛇草。‡給塞拉摩的私掠者格羅伊帶去一束海蛇草。',
  }
},
[624] = {
  {
    'Charada do Cortello‡Загадка Кортелло‡Cortellos Rätsel‡코르텔로의 수수께끼‡El enigma de Cortello‡El enigma de Cortello‡Devinette de Cortello‡科泰罗的谜题‡科泰羅的謎題',
    nil,
    'Resolva a charada.‡Разгадай загадку!‡Löst das Rätsel!‡수수께끼를 풀어야 합니다.‡¡Resuelve el enigma!‡¡Resuelve el enigma!‡Résoudre l\'énigme.‡解开这道迷题！‡解開這道謎題!',
