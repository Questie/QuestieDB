},
[10455] = {
  {
    'A selva agressiva‡Угроза хищников‡Die nahende Wildnis‡야생동물의 침범‡La naturaleza cercenada‡La naturaleza invasora‡Une nature envahissante‡危险的荒野‡失控的侵略',
    nil,
    'Mate 12 Linces Espreita-mata.‡Убейте 12 лесных рысей.‡Erlegt 12 Hainpirscherluchse.‡긴발톱 숲스라소니 12마리를 처치해야 합니다.‡Mata 12 linces acecharboleda.‡Mata 12 linces acecharboleda.‡Tuez 12 Lynx traquebosquet.‡杀死12只林地山猫。‡殺掉12隻森林山貓。',
  }
},
[10456] = {
  {
    'Lobos saqueadores‡Волчья напасть‡Marodierende Wölfe‡늑대의 습격‡Lobos merodeadores‡Lobos merodeadores‡Les loups en maraude‡徘徊的恶狼‡巡邏的狼群',
    nil,
    'Colete 4 Caudas de Lobo Hediondo Senhor do Trovão.‡Соберите 4 хвоста лютого волка клана Громоборцев.‡Beschafft Euch 4 Schwänze eines Terrorwolfs der Donnerfürsten.‡광포한 천둥군주 늑대 꼬리 4개를 모아야 합니다.‡Consigue 4 colas de lobos temibles Señor del Trueno.‡Consigue 4 colas de lobos temibles Señor del Trueno.‡Rapportez 4 Queues de loup redoutable sire-tonnerre.‡收集4条雷神恶狼的尾巴。‡收集4條雷霆王恐狼尾。',
  }
},
[10457] = {
  {
    'A proteção dos nossos‡Защитить свой дом‡Die Eigenen schützen‡생명의 숲 수호‡Proteger a los nuestros‡Proteger a los nuestros‡Pour protéger les nôtres‡自我保护‡保護我們自己',
    nil,
    'Use o Ramo de Rina em 5 das Mudas do Bosque para evocar defesas para o Bosque Vicejante.‡Взмахните ветвью Рины над 5 саженцами рощи, чтобы призвать на защиту Живой рощи силы природы.‡Benutzt Rinas Zweig bei 5 Hainsetzlingen, um Verteidigung für den lebenden Hain herbeizurufen.‡숲의 묘목 5개에 리나의 나뭇가지를 사용하여 생명의 숲에 수호정령을 불러내야 합니다.‡Utiliza la rama de Rina en 5 semillas de la arboleda para invocar defensas para La Arboleda Viviente.‡Utiliza la rama de Rina en 5 semillas de la arboleda para invocar defensas para La Arboleda Viviente.‡Utilisez le Rameau de Rina sur 5 Boutures du Bosquet pour faire apparaître des défenseurs du Bosquet vivant.‡在5处活木林树苗上使用莉娜的树枝，召唤生物保卫活木林。‡在5株果樹幼苗身上使用琳娜的樹枝以召喚今後生命之林的防護者。',
  }
},
[10458] = {
  {
    'Espíritos do fogo e da terra enfurecidos‡Разъяренные бесы пламени и земли‡Wütende Geister des Feuers und der Erde‡분노한 불과 대지의 정령들‡Espíritus de fuego y tierra iracundos‡Espíritus de fuego y tierra iracundos‡Esprits de feu et de terre enragés‡愤怒的火灵和地灵‡火與大地的暴怒之靈',
    nil,
    'O Reparador da Terra Torlok, no Altar da Danação do Vale da Lua Negra, quer que você use o Totem dos Espíritos para capturar 8 Almas da Terra e 8 Almas do Fogo.‡Поймайте с помощью тотема духов 8 бесов земли и 8 бесов пламени для целителя земли Торлока из Алтаря Проклятия.‡Erdheiler Torlok beim Altar der Verdammnis im Schattenmondtal möchte, dass Ihr das Totem der Geister benutzt, um 8 Erdenseelen und 8 Feuerseelen einzufangen.‡어둠달 골짜기 저주의 제단에 있는 대지의 치유사 토르록이 정기의 토템을 사용해 분노한 대지의 영혼 8명과 분노한 불의 영혼 8명을 사로잡아 달라고 부탁했습니다.‡El ensalmador de la tierra Torlok en El Altar de Condenación, en el Valle Sombraluna, quiere que utilices el Tótem de espíritus para capturar 8 almas de terráneos y 8 almas de ígneos.‡El ensalmador de la tierra Torlok en El Altar de Condenación, en el Valle Sombraluna, quiere que utilices el Tótem de espíritus para capturar 8 almas de terráneos y 8 almas de ígneos.‡Le soigneterre Torlok à l\'Autel de la damnation dans la vallée d\'Ombrelune veut que vous utilisiez le Totem des esprits pour capturer 8 Âmes terrestres et 8 Âmes flamboyantes.‡使用灵魂图腾俘获8个土之魂和8个火之魂，然后向影月谷诅咒祭坛的大地治愈者托洛克复命。‡影月谷裡詛咒祭壇的大地治癒者托爾洛克要你使用靈魂圖騰捕捉8個土靈之魂及8個熾熱之魂。',
  }
},
[10459] = {
  {
    'Reverenciado na Expedição Cenariana‡Почтительное отношение Кенарийской экспедиции‡Von der Expedition des Cenarius verehrt‡세나리온 원정대의 매우 우호적 평판‡Venerado por la Expedición Cenarion‡Venerado por la Expedición Cenarion‡Révéré par l\'Expédition cénarienne‡塞纳里奥远征队的崇敬‡得到塞納里奧遠征隊的尊敬',
    nil,
    'Ysiel Cantavento, no Refúgio Cenariano, quer que você se torne reverenciado na Expedição Cenariana.‡Исиэль Песнь Ветра из Кенарийского приюта хочет, чтобы вы добились почтительного отношения Кенарийской экспедиции.‡Ysiel Windsänger bei der Zuflucht des Cenarius möchte, dass Euch einen respektvollen Ruf bei der Expedition des Cenarius verdient.‡이시엘 윈드싱어가 세나리온 원정대에 대한 매우 우호적 평판을 얻어야 한다고 부탁했습니다.‡Ysiel Vientocantor del Refugio Cenarion quiere que logres que los miembros de la expedición de Cenarius te veneren.‡Ysiel Vientocantor del Refugio Cenarion quiere que logres que los miembros de la expedición de Cenarius te veneren.‡Ysiel Chantelevent du Refuge cénarien veut que vous deveniez Révéré par l\'Expédition cénarienne.‡塞纳里奥庇护所的伊谢尔·风歌要求你在塞纳里奥远征队中达到崇敬声望。‡塞納里奧避難所的伊斯歐·風詠要你贏得塞納里奧遠征隊的尊敬。',
  }
},
[10460] = {
  {
    'Jura do defensor‡Посвящение в защитники‡Das Versprechen des Verteidigers‡수호자의 약속‡El juramento de defensor‡El juramento de defensor‡Le serment du défenseur‡防御者的契约‡防衛者的誓言',
