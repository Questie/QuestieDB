[64063] = {
  {
    'Portal Negro‡Темный портал‡Das Dunkle Portal‡어둠의 문‡El Portal Oscuro‡El Portal Oscuro‡La Porte des ténèbres‡黑暗之门‡黑暗之門',
    nil,
    'Fale com o Senhor da Guerra Dar\'tun na Barreira do Inferno. Ele aguarda você junto ao Portal Negro.‡Поговорите с полководцем Дар\'туном в Выжженных землях. Он ждет вас у Темного портала.‡Macht Kriegsherr Dar\'toon ausfindig. Er erwartet Eure Ankunft vor dem Dunklen Portal.‡저주받은 땅으로 이동한 뒤 어둠의 문 앞에서 당신의 도착을 기다리고 있는 장군 다르툰을 찾아야 합니다.‡Busca al Señor de la Guerra Dar\'toon en Las Tierras Devastadas. Espera tu llegada frente al Portal Oscuro.‡Busca al señor de la guerra Dar\'toon en las Tierras Devastadas. Espera tu llegada ante el Portal Oscuro.‡Trouvez le Seigneur de guerre Dar’toon dans les terres Foudroyées. Il attend votre arrivée près de la Porte des ténèbres.‡找到诅咒之地的督军达图恩。他就在黑暗之门前等你。‡到詛咒之地向督軍達圖恩報到。他在黑暗之門前等你。',
  }
},
[64064] = {
  {
    'Terras Pestilentas Orientais‡Восточные Чумные земли‡Östliche Pestländer‡동부 역병지대‡Las Tierras de la Peste del Este‡Tierras de la Peste del Este‡Maleterres de l’Est‡东瘟疫之地‡東瘟疫之地',
    nil,
    'Vá até as Terras Pestilentas Orientais e fale com Leonid Bartolomeu. Ele aguarda sua chegada na Capela Esperança da Luz.‡Отправляйтесь в Восточные Чумные земли и поговорите с лордом Барталомеем. Он ждет вас в часовне Последней Надежды.‡Reist in die Östlichen Pestländer und macht Leonidas Bartholomäus ausfindig. Er erwartet Eure Ankunft in der Kapelle des Hoffnungsvollen Lichts.‡동부 역병지대로 이동한 뒤 희망의 빛 예배당에서 당신의 도착을 기다리고 있는 리어니드 바돌로매를 찾아야 합니다.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Te está esperando en la Capilla de la Esperanza de la Luz.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Espera tu llegada en la Capilla de la Esperanza de la Luz.‡Rendez-vous dans les Maleterres de l’Est et trouvez Leonid Barthalomew. Il vous attend à la Chapelle de l’Espoir de Lumière.‡前往东瘟疫之地，找到莱尼德·巴萨罗梅。他在圣光之愿礼拜堂等你。‡前往東瘟疫之地找到萊尼德·巴薩羅梅。他在聖光之願禮拜堂等候你的到來。',
  }
},
[64128] = {
  {
    'Terras Pestilentas Orientais‡Восточные Чумные земли‡Östliche Pestländer‡동부 역병지대‡Las Tierras de la Peste del Este‡Tierras de la Peste del Este‡Maleterres de l\'est‡东瘟疫之地‡東瘟疫之地',
    nil,
    'Vá até as Terras Pestilentas Orientais e fale com Leonid Bartolomeu. Ele aguarda sua chegada na Capela Esperança da Luz.‡Отправляйтесь в Восточные Чумные земли и поговорите с лордом Барталомеем. Он ждет вас в часовне Последней Надежды.‡Reist in die Östlichen Pestländer und macht Leonidas Bartholomäus ausfindig. Er wartet in der Kapelle des Hoffnungsvollen Lichts.‡동부 역병지대로 이동한 뒤 희망의 빛 예배당에서 당신의 도착을 기다리고 있는 리어니드 바돌로매를 찾아야 합니다.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Te está esperando en la Capilla de la Esperanza de la Luz.‡Viaja a las Tierras de la Peste del Este y busca a Leonid Barthalomew. Espera tu llegada en la Capilla de la Esperanza de la Luz.‡Rendez-vous dans les Maleterres de l’Est et trouvez Leonid Barthalomew. Il vous attend à la Chapelle de l’Espoir de Lumière.‡前往东瘟疫之地，找到莱尼德·巴萨罗梅。他在圣光之愿礼拜堂等你。‡前往東瘟疫之地找到萊尼德·巴薩羅梅。他在聖光之願禮拜堂等候你的到來。',
  }
},
[64142] = {
  {
    'Demonstração de lealdade‡Доказательство лояльности‡Eine Demonstration Eurer Loyalität‡충성심의 증거‡Una demostración de lealtad‡Una demostración de lealtad‡Une preuve de loyauté‡忠诚的表现‡展現忠誠',
    nil,
    'Lady Liadrin, de Luaprata, quer que você destrua 3 Carroças Carniceiras do Flagelo e mate 15 Engenheiros de Cerco do Flagelo.‡Леди Лиадрин из Луносвета просит уничтожить 3 мясных фургона и убить 15 инженеров Плети.‡Lady Liadrin in Silbermond möchte, dass Ihr 3 Fleischwagen der Geißel zerstört und 15 Belagerungsingenieure der Geißel tötet.‡실버문에 있는 여군주 리아드린이 스컬지 시체마차 3대를 파괴하고 스컬지 공성 기술병 15명을 처치해 달라고 부탁했습니다.‡Lady Liadrin en la Ciudad de Lunargenta quiere que destruyas 3 carros de carne de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Lady Liadrin en la Ciudad de Lunargenta quiere que destruyas 3 carros de despojos de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Dame Liadrin, à Lune-d\'argent, veut que vous détruisiez 3 Chariots à viande du Fléau et que vous tuiez 15 Ingénieurs de machines de siège du Fléau.‡银月城的女伯爵莉亚德琳要求你摧毁3台天灾绞肉车，并杀死15名天灾攻城技师。‡銀月城的莉雅德倫女士要你摧毀3台天譴軍團肉類貨車並殺死15個天譴攻城技師。',
  }
},
[64217] = {
  {
    'Portal Negro‡Темный портал‡Das Dunkle Portal‡어둠의 문‡El Portal Oscuro‡El Portal Oscuro‡La Porte des ténèbres‡黑暗之门‡黑暗之門',
    nil,
    'Fale com o Senhor da Guerra Dar\'tun na Barreira do Inferno. Ele aguarda você junto ao Portal Negro.‡Поговорите с полководцем Дар\'туном в Выжженных землях. Он ждет вас у Темного портала.‡Macht Kriegsherr Dar\'toon ausfindig. Er erwartet Eure Ankunft vor dem Dunklen Portal.‡저주받은 땅으로 이동한 뒤 어둠의 문 앞에서 당신의 도착을 기다리고 있는 장군 다르툰을 찾아야 합니다.‡Busca al Señor de la Guerra Dar\'toon en Las Tierras Devastadas. Espera tu llegada frente al Portal Oscuro.‡Busca al señor de la guerra Dar\'toon en las Tierras Devastadas. Espera tu llegada ante el Portal Oscuro.‡Trouvez le Seigneur de guerre Dar’toon dans les terres Foudroyées. Il attend votre arrivée près de la Porte des ténèbres.‡找到诅咒之地的督军达图恩。他就在黑暗之门前等你。‡到詛咒之地向督軍達圖恩報到。他在黑暗之門前等你。',
  }
},
[64319] = {
  {
    'Um estudo da energia‡Источник силы‡Eine Studie der Macht‡힘을 연구하다‡Un estudio sobre el poder‡Un estudio sobre el poder‡Une étude du pouvoir‡掌握力量‡學習力量',
    nil,
    'Fale com o Magíster Astalor Jurassangue na câmara oculta sob o quartel-general dos Cavaleiros Sangrentos.‡Поговорите с магистром Асталором Кровавой Клятвой в тайной зале, расположенной под штабом рыцарей крови.‡Sprecht mit Magister Astalor Blutschwur in der Geheimen Kammer unter dem Hauptquartier der Blutelfen.‡혈기사 본부 지하에 숨겨진 방에 있는 마법학자 아스탈로르 블러드스원과 대화해야 합니다.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del cuartel general de los Caballeros de sangre.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del puesto de mando de los Caballeros de sangre‡Parlez au magistère Astalor Ligessang dans la chambre secrète sous les quartiers généraux des chevaliers de sang.‡与血骑士总部楼下密室中的魔导师阿斯塔洛·血誓谈一谈。‡到血騎士總部底下隱藏的房間裡和博學者阿斯塔樂·血誓談談。',
  }
},
[64845] = {
  {
    'Esforços de guerra da Aliança‡Военная кампания Альянса‡Kriegsvorbereitungen der Allianz‡얼라이언스 전쟁 지원단‡Esfuerzos de guerra de la Alianza‡Campaña de guerra de la Alianza‡L’effort de guerre de l’Alliance‡联盟战事‡聯盟戰備',
    nil,
    'Vença uma partida no campo de batalha e fale novamente com um General de Brigada da Aliança em qualquer capital da Aliança ou em Shattrath.‡Победите в игре на поле боя и вернитесь к бригадному генералу сил Альянса в любую из столиц Альянса или в Шаттрат.‡Gewinnt eine Schlacht und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte oder in Shattrath.‡전장에서 승리를 거둔 후 샤트라스나 얼라이언스 대도시에 있는 얼라이언스 준장을 만나보십시오.‡Gana una partida en el campo de batalla y vuelve junto a un Brigadier general de la Alianza en cualquier capital de la Alianza o en Shattrath.‡Gana una partida en un campo de batalla y ve a hablar con un general de brigada de la Alianza de cualquier capital de la Alianza o Shattrath.‡Remportez la victoire sur un Champ de bataille et retournez auprès d’un Général de brigade de l’Alliance dans n’importe quelle capitale de l’Alliance ou à Shattrath.‡在战场上获得一场胜利，然后向任意联盟主城或沙塔斯城中的联盟准将复命。‡在戰場中獲勝，然後向任何一座首都或撒塔斯的聯盟准將回報。',
  }
},
[65224] = {
  {
    'Comprar 1 Frasco Instável da Fera por 10 Estilhaços Apexis‡Создать 1 нестабильный настой Зверя из 10 апекситовых осколков.‡1 instabiles Fläschchen der Bestie für 10 Apexissplitter erwerben‡10개의 에펙시스 결정을 사용하여 1개의 불안정한 야수의 영약을 얻습니다.‡Compra un frasco inestable de la bestia por 10 fragmentos de ápices.‡Compra un frasco inestable de la bestia por 10 fragmentos de ápices.‡Achetez 1 flacon instable de la bête pour un coût de 10 éclats apogides.‡用10块埃匹希斯碎片购买1瓶不稳定的野兽合剂‡購買1瓶野獸的不穩定精煉藥劑需要10個頂尖裂片。',
    nil,
    nil,
  }
},
[65561] = {
  {
    'Tabardo das Chamas‡Гербовая накидка Пламени‡Wappenrock der Flamme‡화염의 휘장‡Tabardo de las llamas‡Tabardo de las llamas‡Tabard de flammes‡烈焰徽章‡烈焰外袍',
