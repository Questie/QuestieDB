[4606] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡빤질빤질세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
