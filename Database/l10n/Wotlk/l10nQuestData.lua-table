[6844] = {
  {
    'Umbero, o arquivista‡Умбер, архивариус‡Umber, Archivar‡기록관 움버‡Umber, el archivista‡Umber, el archivista‡Umber, Archiviste‡档案管理员阿姆伯尔‡檔案管理員阿姆伯爾',
    nil,
    'Leve o Objeto Silitídeo Incrustado para Umbero, arquivista do Círculo Cenariano, na vila de Refúgio Noturno, na Clareira da Lua.‡Отнесите покрытый коркой предмет Умберу – архивариусу Круга Кенария – в деревню Ночная Гавань, что на Лунной поляне.‡Bringt das verkrustete Silithidenobjekt zu Umber, dem Archivar des Zirkels des Cenarius, ins Dorf Nachthafen auf der Mondlichtung.‡달의 숲의 나이트헤이븐 마을에 있는 세나리온 의회의 기록관, 움버에게 딱딱한 실리시드 조각을 가져가야 합니다.‡Lleva el objeto silítido taraceado a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Lleva el objeto silítido taraceado a Umber, el archivista del Círculo Cenarion, en la aldea de Amparo de la Noche, en el Claro de la Luna.‡Apporter l\'Objet silithide incrusté à Umber, l\'archiviste du Cercle cénarien, au village de Havrenuit, à Reflet-de-Lune.‡将异种蝎粘液包裹的物体交给月光林地永夜港的阿姆伯尔，他是塞纳里奥议会的档案管理员。‡將異種蠍粘液包裹的物體交給月光林地永夜港的阿姆伯爾，他是塞納里奧議會的檔案管理員。',
  }
},
[6845] = {
  {
    'Desvendando segredos do passado‡Раскрытие древних секретов‡Enthüllung von Geheimnissen der Vergangenheit‡과거의 비밀 밝히기‡El descubrimiento de los secretos del pasado‡Desvelar los secretos del pasado‡Les secrets du passé‡发现过去的秘密‡發現過去的秘密',
    nil,
    'Fale com Ravine Saturna no vilarejo de Refúgio Noturno, na Clareira da Lua.‡Поговорите с Рабином Сатурной в деревне Ночная Гавань на Лунной поляне.‡Sprecht mit Rabine Saturna im Dorf Nachthafen auf der Mondlichtung.‡달의 숲의 나이트헤이븐에 있는 라빈 사투르나와 대화해야 합니다.‡Habla con Rabine Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Habla con Rabine Saturna en el poblado Amparo de la Noche, en Claro de la Luna.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。‡與月光林地永夜港的拉比恩·薩圖納談話。',
  }
},
[6846] = {
  {
    'Que comece o ataque!‡В атаку!‡Der Angriff soll beginnen!‡공격 개시!‡¡Al ataque!‡¡Al ataque!‡Que l\'attaque commence !‡展开攻击！‡展開攻擊!',
    nil,
    nil,
  }
},
[6847] = {
  {
    'Olho-que-tudo-vê do Mestre Rúben‡Всевидящее око мастера Рисона‡Meister Rysons Allsehendes Auge‡비밀결사대장 라이슨의 천리안‡El ojo que todo lo ve del maestro Ryson‡El ojo que todo lo ve del maestro Ryson‡L\'Œil-qui-voit-tout de maître Ryson‡雷尔松的全视之眼‡雷松的全視之眼',
    nil,
    'Recupere o Olho-que-tudo-vê do Mestre Rúben nas cavernas dos Invernacha e leve-o para o Mestre Rúben.|n|nEsteja avisado, há rumores de que o Olho-que-tudo-vê do Mestre Rúben carrega uma terrível maldição!‡Заберите всевидящее око мастера Рисона из пещер Ледяной Секиры и возвращайтесь к мастеру Рисону.|n|nБудьте осторожны: говорят, что на всевидящее око мастера Рисона наложено ужасное проклятие!‡Holt das allsehende Auge von Meister Ryson aus den Höhlen der Winterax und kehrt damit zu Meister Ryson zurück.|n|nSeid gewarnt, man sagt, dass das allsehende Auge von Meister Ryson einen schrecklicken Fluch mit sich brächte!‡겨울도끼 동굴에서 천리안을 회수한 후, 비밀결사대장 라이슨에게 가져가야 합니다.|n|n비밀결사대장 라이슨의 천리안은 끔찍한 저주를 불러들인다고 전해지니 조심해야 합니다!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Récupérer l\'Oeil-qui-voit-tout de Maître Ryson dans les Grottes Hache-d\'hiver, puis le rapporter à Maître Ryson.|n|nSachez que l\'on dit de l\'Oeil-qui-voit-tout de Maître Ryson qu\'il contient une terrible malédiction !‡从冰斧巨魔洞穴中找到雷尔松的全视之眼，然后回到指挥官雷尔松那里。|n|n要当心，据说雷尔松的全视之眼带有可怕的诅咒！‡從冰斧食人妖洞穴中找到雷松的全視之眼，然後回到指揮官雷松那裡。|n|n要當心，據說雷松的全視之眼帶有可怕的詛咒!',
  }
},
[6848] = {
  {
    'Olho-que-tudo-vê do Mestre Rúben‡Всевидящее око мастера Рисона‡Meister Rysons Allsehendes Auge‡비밀결사대장 라이슨의 천리안‡El ojo que todo lo ve del maestro Ryson‡El ojo que todo lo ve del maestro Ryson‡L\'Œil-qui-voit-tout de maître Ryson‡雷尔松的全视之眼‡雷松的全視之眼',
    nil,
    'Recupere o Olho-que-tudo-vê do Mestre Rúben nas cavernas dos Invernacha e leve-o para o Mestre Rúben.|n|nEsteja avisado, há rumores de que o Olho-que-tudo-vê do Mestre Rúben carrega uma terrível maldição!‡Заберите всевидящее око мастера Рисона из пещер Ледяной Секиры и возвращайтесь к мастеру Рисону.|n|nБудьте осторожны: говорят, что на всевидящее око мастера Рисона наложено ужасное проклятие!‡Holt das allsehende Auge von Meister Ryson aus den Höhlen der Winterax und kehrt damit zu Meister Ryson zurück.|n|nSeid gewarnt, man sagt, dass das allsehende Auge von Meister Ryson einen schrecklicken Fluch mit sich brächte!‡겨울도끼 동굴에서 천리안을 회수한 후, 비밀결사대장 라이슨에게 가져가야 합니다.|n|n비밀결사대장 라이슨의 천리안은 끔찍한 저주를 불러들인다고 전해지니 조심해야 합니다!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Recupera el Ojo que todo lo ve del maestro Ryson en las cuevas de los Hacha Invernal y devuélveselo.|n|nPero ándate con cuidado, al parecer el Ojo que todo lo ve del maestro Ryson ¡está maldito!‡Récupérez l\'Oeil-qui-voit-tout de Maître Ryson dans les Grottes Hache-d\'hiver, puis rapportez-le à Maître Ryson.|n|nSachez que l\'on dit de l\'Oeil-qui-voit-tout de Maître Ryson qu\'il contient une terrible malédiction !‡从冰斧巨魔洞穴中找到雷尔松的全视之眼，然后回到指挥官雷尔松那里。|n|n要当心，据说雷尔松的全视之眼带有可怕的诅咒！‡從冰斧食人妖洞穴中找到雷松的全視之眼，然後回到指揮官雷松那裡。|n|n要當心，據說雷松的全視之眼帶有可怕的詛咒!',
  }
},
[6861] = {
  {
    'Unidade retalhadora portátil do Borogodó‡Портативный крошшер Зинфиззлекса‡Zinnzischelix\'s tragbare Schreddereinheit‡진피즐렉스의 휴대용 벌목기 장치‡La unidad trituradora portátil de Zinfizzlex‡La unidad trituradora portátil de Zinfizzlex‡Le Déchiqueteur portatif de Zinfoirux‡斯菲莱克斯的便携式伐木机‡斯菲萊克斯的可攜式伐木機',
    nil,
    'O Mestre Engenheiro Borogodó pediu o seguinte material:|n|n*30 Barras de Tório.|n|n*50 Barras de Mithril.|n|n*75 Barras de Ferro.|n|n*1 Serra a Vapor.‡Принесите мастеру-инженеру Спустипару|n|n30 ториевых слитков|n|n50 мифриловых слитков|n|n75 железных слитков|n|n1 паровую пилу.‡Meisteringenieur Zinnzischelix möchte, dass Ihr ihm Folgendes bringt:|n|n*30 Thoriumbarren.|n|n*50 Mithrilbarren.|n|n*75 Eisenbarren.|n|n*1 Dampfsäge.‡수석기술자 진피즐렉스가 다음의 물건을 가져다 달라고 부탁했습니다.|n|n*토륨 주괴 30개|n|n*미스릴 주괴 50개|n|n*철 주괴 75개|n|n*증기톱 1개‡El maestro ingeniero Zinfizzlex quiere que le lleves lo siguiente:|n|n*30 barras de torio.|n|n*50 barras de mitril.|n|n*75 barras de hierro.|n|n*1 sierra de vapor.|n‡El maestro ingeniero Zinfizzlex quiere que le lleves lo siguiente:|n|n*30 barras de torio.|n|n*50 barras de mitril.|n|n*75 barras de hierro.|n|n*1 sierra de vapor.|n‡Le Maître Ingénieur Zinfoirux veut que vous lui apportiez les matériaux suivants :|n|n*30 Barres de thorium.|n|n*50 Barres de Mithril.|n|n*75 Barres de fer.|n|n*1 Scie à vapeur.‡首席技师斯菲莱克斯要你给他拿去下列物品：|n|n30块瑟银锭。|n|n50块秘银锭。|n|n75块铁锭。|n|n1个蒸汽锯。‡工程大師斯菲萊克斯要你給他拿去下列物品:|n|n*30塊瑟銀錠。|n|n*50塊秘銀錠。|n|n*75塊鐵錠。|n|n*1個蒸汽鋸。',
  }
},
[6862] = {
  {
    'Unidade retalhadora portátil do Borogodó‡Портативный крошшер Зинфиззлекса‡Zinnzischelix\'s tragbare Schreddereinheit‡진피즐렉스의 휴대용 벌목기 장치‡La unidad trituradora portátil de Zinfizzlex‡La unidad trituradora portátil de Zinfizzlex‡Le Déchiqueteur portatif de Zinfoirux‡斯菲莱克斯的便携式伐木机‡斯菲萊克斯的可攜式伐木機',
    nil,
    'O Mestre Engenheiro Borogodó pediu o seguinte material:|n|n*30 Barras de Tório.|n|n*50 Barras de Mithril.|n|n*75 Barras de Ferro.|n|n*1 Serra a Vapor.‡Принесите мастеру-инженеру Спустипару|n|n30 ториевых слитков|n|n50 мифриловых слитков|n|n75 железных слитков|n|n1 паровую пилу.‡Meisteringenieur Zinnzischelix möchte, dass Ihr ihm Folgendes bringt:|n|n*30 Thoriumbarren.|n|n*50 Mithrilbarren.|n|n*75 Eisenbarren.|n|n*1 Dampfsäge.‡수석기술자 진피즐렉스가 다음의 물건을 가져다 달라고 부탁했습니다.|n|n*토륨 주괴 30개|n|n*미스릴 주괴 50개|n|n*철 주괴 75개|n|n*증기톱 1개‡El maestro ingeniero Zinfizzlex quiere que le lleves lo siguiente:|n|n*30 barras de torio.|n|n*50 barras de mitril.|n|n*75 barras de hierro.|n|n*1 sierra de vapor.|n‡El maestro ingeniero Zinfizzlex quiere que le lleves lo siguiente:|n|n*30 barras de torio.|n|n*50 barras de mitril.|n|n*75 barras de hierro.|n|n*1 sierra de vapor.|n‡Le Maître Ingénieur Zinfoirux veut que vous lui apportiez les matériaux suivants :|n|n*30 Barres de thorium.|n|n*50 Barres de Mithril.|n|n*75 Barres de fer.|n|n*1 Scie à vapeur.‡首席技师斯菲莱克斯要你给他拿去下列物品：|n|n30块瑟银锭。|n|n50块秘银锭。|n|n75块铁锭。|n|n1个蒸汽锯。‡工程大師斯菲萊克斯要你給他拿去下列物品:|n|n*30塊瑟銀錠。|n|n*50塊秘銀錠。|n|n*75塊鐵錠。|n|n*1個蒸汽鋸。',
  }
},
[6881] = {
  {
    'Ivus, o Senhor da Floresta‡Ивус Лесной Властелин‡Ivus der Waldfürst‡숲군주 이부스‡Ivus, el Señor del Bosque‡Ivus, el Señor del Bosque‡Ivus le Seigneur des forêts‡森林之王伊弗斯‡『森林之王』伊弗斯',
