},
[8317] = {
  {
    'Assistência culinária‡Помощь по кухне‡Küchengehilfe‡주방 보조‡Echar una mano en la cocina‡Echar una mano en la cocina‡Un coup de main à la cuisine‡下厨‡廚房助手',
    nil,
    'Calandrath, no Forte Cenariano, precisa de uma porção de 10 Bolinhos Defumados do Deserto.‡Каландрате из крепости Кенария нужны 10 копченых пустынных клецок.‡Calandrath von der Burg Cenarius braucht 10 geräucherte Wüstenknödel.‡세나리온 요새의 캘랜드라스가 훈제 사막 경단 10개를 부탁했습니다.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 albóndigas del desierto ahumadas.‡Calandrath, en el Fuerte Cenarion, necesita una entrega de 10 albóndigas del desierto ahumadas.‡Calandrath, du Fort cénarien, a besoin d\'une fournée de 10 Boulettes fumées du désert.‡塞纳里奥要塞的卡兰德拉斯需要制作10只沙漠肉丸子。‡塞納里奧城堡的卡蘭德拉斯需要製作10個沙漠肉丸子的麵團。',
  }
},
[8318] = {
  {
    'Comunicação secreta‡Тайные послания‡Geheime Nachrichten‡비밀 교신‡Mensajes secretos‡Mensajes secretos‡Communications secrètes‡秘密交流‡秘密通訊',
    nil,
    'Traga 10 Textos Cifrados do Crepúsculo para Bor Juba Agreste no Forte Cenariano.‡Принесите 10 зашифрованных сумеречных текстов Бору Буйногривому в крепость Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius 10 verschlüsselte Schattenhammertexte.‡세나리온 요새에 있는 보르 와일드메인에게 암호화된 황혼의 문서 10개를 가져가야 합니다.‡Lleva 10 textos Crepusculares codificados a Bor Ferocrín en el Fuerte Cenarion.‡Lleva 10 textos Crepusculares codificados a Bor Ferocrín en el Fuerte Cenarion.‡Apporter 10 Textes du crépuscule cryptés à Bor Crin-sauvage au Fort cénarien.‡把10片暮光密文信交给塞纳里奥要塞的鲍尔·蛮鬃。‡帶10張暮光文本給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8319] = {
  {
    'Textos codificados do Crepúsculo‡Зашифрованные Сумеречные тексты‡Verschlüsselte Schattenhammertexte‡암호화된 황혼의 문서‡Textos Crepusculares codificados‡Textos Crepusculares codificados‡Les textes du crépuscule cryptés‡暮光密文信‡暮光加密文件',
    nil,
    nil,
  }
},
[8320] = {
  {
    'Geolordes do Crepúsculo‡Геолорды из культа Сумеречного Молота‡Geolords des Schattenhammers‡황혼의 대지술사‡Geoseñores Crepusculares‡Geoseñores Crepusculares‡Les géoseigneurs du crépuscule‡暮光地王‡暮光地領主',
    nil,
    'Mate 10 Geolordes do Crepúsculo, então fale novamente com Huum Juba Agreste no Forte Cenariano.‡Убейте 10 геолордов из культа Сумеречного Молота и вернитесь к Хууму Буйногривому в крепость Кенария.‡Tötet 10 Zwielichtgeolords und kehrt anschließend zu Huum Wildmähne auf Burg Cenarius zurück.‡황혼의 대지술사 10명을 처치하고 세나리온 요새에 있는 후움 와일드메인에게 돌아가야 합니다.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Ferocrín en el Fuerte Cenarion.‡Mata 10 geoseñores Crepusculares y, a continuación, ve a ver a Huum Ferocrín en el Fuerte Cenarion.‡Tuer 10 Géoseigneurs du crépuscule, puis retourner voir Huum Crin-sauvage au Fort cénarien.‡杀死10个暮光地王，然后向塞纳里奥要塞的霍姆·蛮鬃复命。‡殺死10個暮光地領主, 然後向塞納里奧城堡的胡姆·蠻鬃回報。',
  }
},
[8321] = {
  {
    'Viral, o Vil‡Вайрал Подлый‡Vyral der Üble‡타락의 바이랄‡Vyral el Vil‡Vyral el Vil‡Vyral le Vil‡邪恶的维拉尔‡卑鄙的維拉爾',
    nil,
    'Leve o Anel-sinete do Viral para Huum Juba Agreste no Forte Cenariano.‡Принесите перстень-печатку Вайрала Хууму Буйногривому в крепость Кенария.‡Bringt Vyrals Siegelring zu Huum Wildmähne auf Burg Cenarius.‡세나리온 요새에 있는 후움 와일드메인에게 바이랄의 인장 반지를 가져다 주어야 합니다.‡Lleva el sello de Vyral a Huum Ferocrín en el Fuerte Cenarion.‡Llévale el sello de Vyral a Huum Ferocrín en el Fuerte Cenarion.‡Remettez la Chevalière de Vyral à Huum Crin-sauvage au Fort cénarien.‡把维拉尔的徽记之戒交给塞纳里奥要塞的霍姆·蛮鬃。‡把維拉爾的璽戒帶給塞納里奧城堡的胡姆·蠻鬃。',
  }
},
[8322] = {
  {
    'Ovos podres‡Тухлые яйца‡Faule Eier‡썩은 달걀‡Huevos podridos‡Huevos podridos‡Les œufs pourris‡腐烂的鸡蛋‡惡臭雞蛋',
    nil,
    'Coloque os Ovos Podres no barril de cerveja principal dentro da Estalagem da Costa Sul.‡Бросьте тухлые яйца в главную бочку с пивом в таверне Южнобережья.‡Werft die faulen Eier in die großen Braufässchen im Gasthaus von Süderstade.‡사우스쇼어 여관 안에 있는 맥주통에 썩은 달걀을 집어넣어야 합니다.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Introduce los huevos podridos en el barril principal que se encuentra en la Taberna Costasur.‡Placez les Œufs pourris dans le tonneau de bière principal de l\'auberge d\'Austrivage.‡将腐烂的鸡蛋放在南海镇旅店的主酿酒桶里。‡將惡臭雞蛋放到南海鎮旅店主要的釀酒桶子裡。',
  }
},
[8323] = {
  {
    'Crentes Fiéis‡Истинно верующие‡Wahrer Glauben‡진정한 신봉자‡El creyente verdadero‡El creyente verdadero‡Les vrais croyants‡真正的信徒‡真實信仰者',
    nil,
    'O Eremita Ortell quer que você traga 10 Textos Codificados do Crepúsculo‡Принесите 10 зашифрованных Сумеречных текстов отшельнику Ортеллу.‡Ortell der Einsiedler möchte, dass Ihr ihm 10 verschlüsselte Schattenhammertexte beschafft.‡은둔자 오르텔이 암호화된 황혼의 문서 10개를 가져다 달라고 부탁했습니다.‡Ermitaño Ortell quiere que le lleves 10 textos Crepusculares codificados.‡Ermitaño Ortell quiere que le lleves 10 textos Crepusculares codificados.‡L\'ermite Ortell veut que vous lui apportiez 10 Textes du crépuscule cryptés.‡隐士奥泰尔要你带回10张暮光密文信。‡隱士奧泰爾希望你能帶給他10份加密的暮光文件。',
  }
},
[8324] = {
  {
    'Crendo fielmente‡Не теряя веры‡Fester Glauben‡문서 수집‡Seguir creyendo‡Seguir creyendo‡Je crois encore...‡更多的读物‡更多的讀物',
    nil,
    nil,
  }
},
[8325] = {
  {
    'Retomada da Ilha Andassol‡Очищение острова Солнечного Скитальца‡Rückeroberung der Insel der Sonnenwanderer‡선스트라이더 섬 재건‡Recuperar la Isla del Caminante del Sol‡Recuperar la Isla del Caminante del Sol‡La reconquête de l\'île de Haut-soleil‡夺回逐日岛‡奪回逐日者之島',
    nil,
    'Mate 8 Moreias de Mana. Elas ficam perto dos Cristais Ardentes, junto à torre e ao mirante.‡Убейте 8 маназмеев – они находятся у пламенеющих кристаллов, недалеко от башни и беседки Солнечного Шпиля.‡Tötet 8 Manawyrm; sie halten sich rund um die brennenden Kristalle auf, die man nahe des Turms und des Vorbaus findet.‡태양 첨탑과 별채 부근의 불타는 수정 가까이에 있는 마나 지룡 8마리를 처치해야 합니다.‡Mata 8 vermis de maná; están cerca de los cristales ardientes que hay junto a la torre y la glorieta.‡Mata 8 vermis de maná; están cerca de los cristales ardientes que hay junto a la torre y la glorieta.‡Tuez 8 Wyrms de mana. Ils se trouvent près des Cristaux ardents, non loin de la tour et du belvédère.‡杀死8只法力浮龙。它们位于法师塔和阳台附近的燃烧水晶周围。‡殺死8隻法力龍鰻;他們就在哨塔與瞭望台旁的燃燒水晶那裡。',
  }
},
[8326] = {
  {
    'Medidas drásticas‡Вынужденные меры‡Bedauerliche Maßnahmen‡유감스러운 조치‡Medidas extremas‡Medidas extremas‡Des mesures regrettables‡令人遗憾的措施‡不幸的手段',
    nil,
    'Recolha 8 Coleiras de Linces Garrataque e de Filhotes de Garrataque. Fale novamente com a Magistra Erona na Ilha Andassol quando terminar.‡Соберите 8 ошейников с убитых рысей-прыголапов и детенышей прыголапов и возвращайтесь к магистру Эроне на острове Солнечного Скитальца.‡Sammelt 8 Luchshalsbänder von erlegten Bachtatzenluchsen und Bachtatzenjungen ein. Kehrt zu Magistrix Erona auf der Insel der Sonnenwanderer zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡갈기발 스라소니와 새끼 갈기발 스라소니를 처치하고 스라소니 목줄 8개를 모으십시오. 다 모으면 선스트라이더 섬에 있는 마법학자 이로나에게 돌아가야 합니다.‡Coge 8 colleras de lince de los linces y cachorros garragil muertos. Luego vuelve a ver a la magistrix Erona a Isla del Caminante del Sol.‡Coge 8 colleras de lince de los linces y cachorros garragil muertos. Luego vuelve a ver a la magistrix Erona a Isla del Caminante del Sol.‡Collectez 8 Colliers de lynx sur des Lynx Preste-pattes et des Jeunes Preste-pattes. Lorsque vous aurez terminé, retournez voir la magistrice Erona sur l\'île de Haut-soleil.‡杀死一些魔泉山猫和魔泉山猫幼崽，并从它们身上收集8个山猫的项圈。完成之后向逐日岛的魔导师艾洛娜复命。‡殺死泉爪山貓和幼年泉爪山貓收集8個山貓項圈。完成後去找逐日者之島的博學者伊羅娜。',
  }
},
[8327] = {
  {
    'Apresente-se a Lanthan Perilon‡Визит к Лантану Перилону‡Berichterstattung an Lanthan Perilon‡란단 페릴론에게 보고‡Informar a Lanthan Perilon‡Informar a Lanthan Perilon‡Se présenter à Lanthan Perilon‡向兰萨恩·派雷隆报到‡向蘭深·佩瑞隆回報',
    nil,
    'Fale com Lanthan Perilon na Ilha Andassol; ele encontra-se perto do caminho para oeste além da Torre do Sol.‡Поговорите с Лантаном Перилоном на острове Солнечного Скитальца – он стоит рядом с дорогой, отходящей на запад от Солнечного Шпиля.‡Sprecht mit Lanthan Perilon auf der Insel der Sonnenwanderer. Er steht in der Nähe des Pfads, der vom Sonnenturm Richtung Westen verläuft.‡선스트라이더 섬에 있는 란단 페릴론과 대화하십시오. 그는 태양 첨탑에서 서쪽으로 가는 길가에 서 있습니다.‡Habla con Lanthan Perilon en la Isla del Caminante del Sol. Está cerca del sendero que se aleja de La Aguja del Sol hacia el oeste.‡Habla con Lanthan Perilon en la Isla del Caminante del Sol. Está cerca del sendero que se aleja de La Aguja del Sol hacia el oeste.‡Parlez à Lanthan Perilon sur l\'île de Haut-soleil. Il se tient près du sentier qui part de la Flèche solaire, vers l\'ouest.‡与逐日岛的兰萨恩·派雷隆谈一谈，他就站在向西去的小路旁。‡和逐日者之島的蘭深·佩瑞隆談談;他就在日尖塔往西邊的路上。',
  }
},
[8328] = {
  {
    'Treinamento de mago‡Обучение мага‡Ausbildung zum Magier‡마법사 훈련‡Instrucción de mago‡Instrucción de mago‡Le maître des mages‡法师训练‡法師訓練',
    nil,
    'Fale com Julia Golpessol, a instrutora de Magos, na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставницей магов Джулией Солнцесвет в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Julia Sonnensturm - der Magielehrerin - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 마법사 줄리아 선스트라이커와 대화해야 합니다.‡Habla con Julia Golpesol, la instructora de magos, en la Aguja del Sol en Isla del Caminante del Sol.‡Habla con Julia Golpesol, la instructora de magos, en la Aguja del Sol en Isla del Caminante del Sol.‡Parlez à Julia Heurtesoleil, le maître des mages, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的法师训练师朱莉亚-射日者谈一谈。‡和茱莉亞·擊日者 - 法師訓練師談談，她就在逐日者之島的日尖塔裡面。',
  }
},
[8329] = {
  {
    '‡Наставник воинов‡Ausbildung zum Krieger‡‡Instrucción de guerrero‡Instrucción de guerrero‡La formation de guerrier‡战士训练‡戰士訓練',
    nil,
    '‡Поговорите с Джестенисом Солнцесветом – наставником воинов – в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Delios - dem Kriegerlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡‡Habla con Delios, el instructor de guerreros, en la Aguja del Sol en Isla del Caminante del Sol.‡Habla con Delios, el instructor de guerreros, en la Aguja del Sol en Isla del Caminante del Sol.‡Parlez à Delios, le maître des guerriers, à la Flèche solaire sur l\'Île de Haut-Soleil.‡‡',
  }
},
[8330] = {
  {
    'Os pertences de Solanian‡Вещи Соланиана‡Solanians Habe‡솔라니안의 물건‡Las posesiones de Solanian‡Las posesiones de Solanian‡Les possessions de Solanian‡索兰尼亚的物品‡索蘭尼亞的東西',
    nil,
    'Recolha o Orbe de Vidência de Solanian, o Pergaminho de Magia do Flagelo e o Diário. Eles estão na Ilha Andassol ao lado do poço, da fonte e de um dos Cristais Flamejantes. Leve-os ao Vigia da Nascente na Torre do Sol, que fica na Ilha Andassol, quando estiver de posse de todos eles.‡Верните Соланиану его гадальный шар, дневник и свиток магии Плети. Их можно найти на острове Солнечного Скитальца у пруда, у одного из пламенеющих кристаллов и у фонтана. Вернитесь с вещами к хранителю Колодца в Солнечный шпиль на острове Солнечного Скитальца.‡Sammelt Brunnenbehüter Solanians Seherkugel, seine Rolle der Geißelmagie und sein Tagebuch ein. Ihr findet die Gegenstände auf der Insel der Sonnenwanderer bei dem Tümpel, dem Brunnen und bei einem der brennenden Kristalle. Bringt sie zu dem Brunnenbehüter oben im Sonnenturm auf der Insel der Sonnenwanderer, sobald Ihr alle gefunden habt.‡태양샘지기 솔라니안을 위해 솔라니안의 수정구, 스컬지 마법 두루마리, 솔라니안의 일지를 찾아야 합니다. 각각 선스트라이더 섬의 연못, 분수대 그리고 불타는 수정 중 한 곳에 있습니다. 다 모으면 선스트라이더 섬의 태양 첨탑에 있는 태양샘지기에게 돌아가십시오.‡Recoge el orbe de visión, el pergamino de magia de la Plaga y el diario del vigía del pozo Solanian. Están en Isla del Caminante del Sol cerca de la charca, la fuente y de uno de los cristales ardientes. Llévaselo todo a La Aguja del Sol en la Isla del Caminante del Sol.‡Recoge el orbe de visión, el pergamino de magia de la Plaga y el diario del vigía del pozo Solanian. Están en Isla del Caminante del Sol cerca de la charca, la fuente y de uno de los cristales ardientes. Llévaselo todo a La Aguja del Sol en la Isla del Caminante del Sol.‡Récupérez l\'Orbe de divination de Solanian, son Parchemin de magie du Fléau et son Journal. Ils se trouvent sur l\'île de Haut-soleil, non loin de l\'étang, de la fontaine et de l\'un des cristaux ardents. Lorsque vous les aurez tous, restituez-les au Veilleur du puits à la Flèche solaire de l\'île de Haut-soleil.‡收集护井者索兰尼亚的占卜宝珠、天灾魔法卷轴和日记。它们分别位于逐日岛上的池塘边、喷泉附近以及一块燃烧水晶旁。找到所有物品后，将它们归还给太阳之塔上的护井者索兰尼亚。‡收集看井者索蘭尼亞的占卜寶珠，他的天譴軍團的魔法卷軸和他的日記。你可以在逐日者之島的池塘邊，噴水池邊和某個燃燒水晶那裡找到這些東西。當你收集好了之後，將它們帶到逐日者之島給日尖塔上的看井者。',
  }
},
[8331] = {
  {
    'Aurel Folháurea‡Аурель Золотой Лист‡Aurel Goldblatt‡오렐 골드리프‡Aurel Hojaurea‡Aurel Hojaurea‡Aurel Feuilledor‡奥蕾尔·金叶‡奧莉爾·金葉',
    nil,
    'Fale com Aurel Folháurea no Forte Cenariano.‡Поговорите с Аурель Золотой Лист в крепости Кенария.‡Sprecht mit Aurel Goldblatt auf Burg Cenarius.‡세나리온 요새에 있는 오렐 골드리프와 얘기해야 합니다.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥要塞的奥蕾尔·金叶谈一谈。‡與塞納里奧城堡的奧莉爾·金葉談話。',
  }
},
[8332] = {
  {
    'Duques do Conselho‡Герцоги Совета‡Fürsten des Rates‡심연의 군주‡Los Duques del Consejo‡Los Duques del Consejo‡Les ducs du Conseil‡议会的公爵‡議會公爵',
    nil,
    'Leve 1 Estilhaço Brilhante Grande e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 1 большой сверкающий осколок и 3 талисмана бездны.‡Bringt Aurel Goldblatt auf Burg Cenarius 1 großen glänzenden Splitter und 3 Abyssische Wappen.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 1개, 심연의 문장 3개를 가져다 주어야 합니다.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 1 fragmento luminoso grande y 3 blasones Abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 1 Grand éclat brillant et 3 Blasons abyssaux à Aurel Feuilledor, au Fort cénarien.‡把1个大块魔光碎片和3顶深渊纹章交给塞纳利奥要塞的奥蕾尔·金叶。‡帶1大塊魔光裂片和3個深淵紋章給塞納里奧城堡的奧莉爾·金葉。',
  }
},
[8333] = {
  {
    'O medalhão de posto‡Статусный медальон‡Das Standesmedaillon‡황혼의 신도 계급장‡Medallón de estatus‡Medallón de estatus‡Le médaillon de statut‡身份勋章‡身份勳章',
    nil,
    nil,
  }
},
[8334] = {
  {
    'Agressão‡Агрессия‡Aggressivität‡공격성‡Agresividad‡Agresividad‡Agression‡攻势‡侵略',
    nil,
    'Mate 7 Conservadores e 7 Arvorosos Ferozes e fale novamente com Lanthan Perilon na Ilha Andassol.‡Убейте 7 древунов и 7 одичавших древунов, затем вернитесь к Лантану Перилону на острове Солнечного Скитальца.‡Tötet 7 Borklinge und 7 wilde Borklinge. Kehrt dann zu Lanthan Perilon auf der Insel der Sonnenwanderer zurück.‡뜰지기와 사나운 뜰지기를 각각 7마리씩 해치운 후, 선스트라이더 섬에 있는 란단 페릴론에게 돌아가야 합니다.‡Mata 7 tiernos y 7 tiernos ferales y ve a ver a Lanthan Perilon en la Isla del Caminante del Sol.‡Mata 7 tiernos y 7 tiernos ferales y ve a ver a Lanthan Perilon en la Isla del Caminante del Sol.‡Tuez 7 Sylveniers et 7 Sylveniers farouches, puis retournez voir Lanthan Perilon sur l\'île de Haut-soleil.‡杀死7只树人嫩苗和7只凶猛的树人嫩苗，然后向逐日岛的兰萨恩·派雷隆复命。‡殺死7個看管者和7個野生看管者，再回到逐日者之島的蘭深·佩瑞隆那裡。',
  }
},
[8335] = {
  {
    'Felendren, o Banido‡Фелендрен Изгой‡Felendren der Verbannte‡추방자 펠렌드렌‡Felendren el Desterrado‡Felendren el Desterrado‡Felendren le Banni‡放逐者菲伦德雷‡被流放的法蘭德倫',
    nil,
    'Mate 8 Aparições Arcanas e 2 Aparições Arcanas Maculadas, bem como Felendren, o Banido; eles encontram-se na Academia Falthrien. Leve a Cabeça de Felendren para Lanthan Perilon na Ilha Andassol.‡Убейте 8 чародейских призраков, 2 нечистых чародейских призрака и Фелендрена Изгоя в академии Фалтриена. Принесите голову Фелендрена Лантану Перилону на остров Солнечного Скитальца.‡Tötet 8 Arkangespenster, 2 besudelte Arkangespenster und Felendren den Verbannten. Ihr findet sie in der Akademie von Falthrien. Bringt Felendrens Kopf zu Lanthan Perilon auf der Insel der Sonnenwanderer.‡팔스리엔 마법학회에 있는 추방자 펠렌드렌, 비전 망령 8마리와 오염된 비전 망령 2마리를 처치한 후, 선스트라이더 섬에 있는 란단 페릴론에게 추방자가 쓰러졌다는 증거가 될만한 물건을 가져가야 합니다.‡Mata 8 ánimas arcanas, 2 ánimas arcanas máculas y a Felendren el Desterrado en Academia Falthrien. Lleva la cabeza de Felendren a Lanthan Perilon a la Isla del Caminante del Sol.‡Mata 8 ánimas arcanas, 2 ánimas arcanas máculas y a Felendren el Desterrado en Academia Falthrien. Lleva la cabeza de Felendren a Lanthan Perilon a la Isla del Caminante del Sol.‡Tuez 8 Âmes en peine arcaniques et 2 Âmes en peine arcaniques contaminées, ainsi que Felendren le Banni. Ils se trouvent à l\'académie de Falthrien. Ramenez la Tête de Felendren à Lanthan Perilon sur l\'île de Haut-soleil.‡杀死8只奥术怨灵和2只被污染的奥术怨灵，以及放逐者菲伦德雷，他们位于法瑟林学院。将菲伦德雷的徽记交给逐日岛的兰萨恩·派雷隆。‡殺死8個秘法怨靈、2個腐敗的秘法怨靈和被流放的法蘭德倫;他們就在法薩瑞安學院裡面。將法蘭德倫的頭顱帶給逐日者之島的蘭深·佩瑞隆。',
  }
},
[8336] = {
  {
    'Um punhado de lascas‡Пригоршня осколков‡Für eine Handvoll Fragmente‡신비의 조각 한 줌‡Por un puñado de esquirlas‡Por un puñado de esquirlas‡Pour une poignée d\'esquilles‡奥术薄片‡一把稜片',
    nil,
    'Consiga 6 Lascas Arcanas com qualquer criatura da ilha que use mana e fale novamente com o Arcanista Ithanas na Ilha Andassol.‡Соберите 6 магических осколков, убивая любых существ, обладающих магическими способностями, а затем вернитесь к чародею Итанасу.‡Sammelt 6 Arkanspäne und bringt sie zu Arkanist Ithanas auf der Insel der Sonnenwanderer. Derartige Fragmente findet man bei allen Mana benutzenden Kreaturen auf der Insel.‡섬에 있는 생명체 중 마나를 사용하는 생명체를 처치하고 신비의 조각 6개를 모아서 선스트라이더 섬의 비전술사 이타나스에게 돌아가야 합니다.‡Coge 6 esquirlas arcanas de cualquier criatura de la isla que use maná y llévaselas al arcanista Ithanas a la Isla del Caminante del Sol.‡Coge 6 esquirlas arcanas de cualquier criatura de la isla que use maná y llévaselas al arcanista Ithanas a la Isla del Caminante del Sol.‡Récupérer 6 Esquilles arcaniques sur n\'importe quelle créature qui utilise du mana, puis retourner voir l\'arcaniste Ithanas sur l\'île de Haut-soleil.‡从逐日岛上的任意使用魔法的生物身上收集6块奥术薄片，把它们交给奥术师伊塔纳斯。‡從島上任何使用法力的生物身上收集6個秘法稜片，再回到逐日者之島的秘法師艾薩納斯那裡。',
  }
},
[8338] = {
  {
    'Lasca Arcana Maculada‡Оскверненный магический осколок‡Besudelter Arkanspan‡오염된 신비의 조각‡Esquirla arcana mácula‡Esquirla arcana mácula‡L\'esquille arcanique contaminée‡被污染的奥术薄片‡腐敗的秘法稜片',
    nil,
    'Leve a Lasca Arcana Maculada ao Arcanista Helion no mirante da Torre do Sol, que fica na Ilha Andassol.‡Принесите оскверненный магический осколок чародею Хелиону, который стоит возле беседки у Солнечного Шпиля на острове Солнечного Скитальца.‡Bringt den besudelten Arkanspan zu Arkanist Helion beim Vorbau des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 별채에 있는 비전술사 헬리온에게 오염된 신비의 조각을 가져가야 합니다.‡Lleva la esquirla arcana mácula al arcanista Helion a la glorieta de la Aguja del Sol en la Isla del Caminante del Sol.‡Lleva la esquirla arcana mácula al arcanista Helion a la glorieta de la Aguja del Sol en la Isla del Caminante del Sol.‡Remettre l\'Esquille arcanique contaminée à l\'arcaniste Helion, au belvédère de la Flèche solaire, sur l\'île de Haut-soleil.‡将被污染的奥术薄片交给逐日岛的太阳之塔露台上的奥术师赫里恩。‡將腐敗的秘法稜片帶到逐日者之島給日尖塔瞭望台的秘法師海利恩。',
  }
},
[8339] = {
  {
    'Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED‡Royalty of the Council <NYI> <TXT> UNUSED',
    nil,
    'Bring the items to Aurel Goldleaf in Cenarion Hold.‡Принесите предметы Аурель Золотой Лист в крепость Кенария.‡Bringt die Gegenstände zu Aurel Goldblatt in der Burg Cenarius.‡세나리온 요새에 오렐 골드리프에게 물건을 가져가야 합니다.‡Lleva los objetos a Aurel Hojaurea en Goldleaf a Fuerte Cenarion.‡Lleva los objetos a Aurel Hojaurea en Goldleaf a Fuerte Cenarion.‡Ramenez les trucs à Aurel Feuilledor au Fort cénarien.‡Bring the items to Aurel Goldleaf in Cenarion Hold.‡把物品帶給塞納里奧城堡的奧莉爾·金葉。',
  }
},
[8340] = {
  {
    '‡Сумеречный перстень-печатка‡Siegelring des Schattenhammers‡‡Twilight Signet Ring <NYI> <TXT>‡Twilight Signet Ring <NYI> <TXT>‡La chevalière du Crépuscule<NYI><TXT>‡暮光徽记之戒 ‡暮光徽記之戒',
    nil,
    nil,
  }
},
[8341] = {
  {
    'Lordes do Conselho‡Лорды Совета‡Lords des Rates‡심연의 군주 속이기‡Señores del Consejo‡Señores del Consejo‡Les seigneurs du conseil‡议会的领主‡議會領主',
    nil,
    'Leve 5 Estilhaços Brilhantes Grandes e 3 Escudos Abissais para Aurel Folháurea no Forte Cenariano.‡Принесите Аурель Золотой Лист в крепость Кенария 5 больших сияющих осколков и 3 перстня бездны.‡Bringt Aurel Goldblatt auf Burg Cenarius 5 große glänzende Splitter und 3 abyssische Siegel.‡세나리온 요새에 있는 오렐 골드리프에게 눈부신 큰 결정 5개, 심연의 인장 3개를 가져다 주어야 합니다.‡Lleva 5 fragmentos luminosos grandes y 3 sellos abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Lleva 5 fragmentos luminosos grandes y 3 sellos abisales a Aurel Hojaurea en el Fuerte Cenarion.‡Apportez 5 Grands éclats brillants et 3 Chevalières abyssales à Aurel Feuilledor, au Fort cénarien.‡把5个大块魔光碎片和3个深渊徽记交给塞纳里奥要塞的奥蕾尔·金叶。‡帶5塊大塊魔光裂片和3個深淵徽記給塞納里奧城堡的奧莉爾·金葉。',
  }
},
[8342] = {
  {
    'Anel de Suserania do Crepúsculo‡Кольцо Власти служителя культа Сумеречного Молота‡Herrschaftsring des Schattenhammerklans‡황혼의 신도 지휘관 반지‡Anillo de nobleza Crepuscular‡Anillo de nobleza Crepuscular‡L\'anneau d\'autorité du crépuscule‡暮光徽记之戒‡暮光徽記之戒',
