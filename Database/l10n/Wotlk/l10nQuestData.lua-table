[8940] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡公平的補償',
    nil,
    'Leve um Cinto do Devoto e um par de Luvas do Devoto para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс преданности и перчатки преданности.‡Bringt Mokvar in Orgrimmar einen Gürtel des Gläubigen und ein Paar Handschuhe des Gläubigen.‡오그리마에 있는 모크바르에게 기원의 허리띠와 기원의 장갑을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de guantes de devoto a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes de devoto a Mokvar a Orgrimmar.‡Apportez une Ceinture de dévot et une paire de Gants de dévot à Mokvar à Orgrimmar.‡将一条虔诚腰带和一副虔诚手套交给奥格瑞玛的莫克瓦尔。‡將虔誠腰帶和1套虔誠手套帶給奧格瑪的莫克瓦。',
  }
},
[8941] = {
  {
    'Recompensa justa‡Справедливое вознаграждение‡Die angemessene Entlohnung‡정당한 보상‡Una compensación justa‡Una compensación justa‡Une juste compensation‡小小的补偿‡公平的補償',
    nil,
    'Leve um Cinto da Arte Sombria e um par de Luvas da Arte Sombria para Mokvar em Orgrimmar.‡Принесите Моквару в Оргриммар пояс Незаметности и перчатки Незаметности.‡Bringt Mokvar in Orgrimmar einen Gürtel der Schattenkunst und ein Paar Handschuhe der Schattenkunst.‡오그리마에 있는 모크바르에게 어둠추적자 허리띠와 어둠추적자 장갑을 가져가야 합니다.‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Mokvar a Orgrimmar.‡Lleva 1 cinturón y 1 par de guantes arte sombrío a Mokvar a Orgrimmar.‡Apportez une Ceinture Sombreruse et une paire de Gants Sombreruse à Mokvar à Orgrimmar.‡将一条迅影腰带和一副迅影手套交给奥格瑞玛的莫克瓦尔。‡將迅影腰帶和1套迅影手套帶給奧格瑪的莫克瓦。',
