[7677] = {
  {
    '‡Белый жеребец‡Austausch Eures Schimmels‡‡Intercambio de semental blanco‡Intercambio de semental blanco‡Echange d\'étalon blanc‡更换白马‡',
    nil,
    '‡‡Tauscht Euren Schimmel gegen eines der Pferde, die an Rüstung gewöhnt sind.‡‡‡‡‡如果你把你的白马给我带来，那么我可以让你从新的马中选择一匹。|n|n它们和你原来的马拥有同样的速度，但是其外观将会有所不同。看看这里的马就知道它们大概是什么样子了。‡',
  }
},
