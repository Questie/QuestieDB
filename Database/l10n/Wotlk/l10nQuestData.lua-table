[1534] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Azul Vazio nas Ruínas de Poeira Estelar, que fica no Vale Gris, e devolva-o para Salma nos Sertões.‡Наполните пустой синий бурдюк для воды в руинах Звездной Пыли и отнесите воду Брин из Степей.‡Füllt den leeren blauen Wasserschlauch bei den Sternenstaubruinen im Eschental und kehrt zu Brine im Brachland zurück.‡잿빛 골짜기에 있는 별가루의 폐허에서 빈 파란색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua azul vacío en Las Ruinas del Polvo Estelar en Vallefresno y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre bleue vide aux Ruines de Chimétoile à Orneval et la rapporter à Brine dans les Tarides.‡到灰谷的星尘废墟去，将空的蓝色水囊盛满泉水，然后把它交给贫瘠之地的布瑞恩。‡到梣谷的星辰廢墟去，將空的藍色水囊盛滿泉水，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1535] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Marrom Vazio no laguinho abaixo da cabana de Salma e leve para ela nos Sertões.‡Наполните пустой коричневый бурдюк для воды в источнике ниже хижины Брин и отнесите ей воду.‡Füllt den leeren braunen Wasserschlauch im Wasserloch unterhalb von Brines Hütte und kehrt damit zu Brine im Brachland zurück.‡브린의 거처 아래에 있는 물 구멍으로 가서 빈 갈색 물주머니에 물을 채운 다음, 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Llena el odre de agua marrón vacío en el abrevadero que está debajo de la cabaña de Salmuera y llévaselo a Los Baldíos.‡Remplir l\'Outre marron vide au trou d\'eau, derrière la hutte de Brine, puis rapportez-lui la, dans les Tarides.‡到野猪人的水池去，用井中的水装满空的棕色水囊，然后把水囊交给贫瘠之地的布瑞恩。‡到野豬人的水池去，用井中的水裝滿空的棕色水囊，然後把水囊交給貧瘠之地的布瑞恩。',
  }
},
[1536] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Vermelho Vazio no poço da Serraria Tarren e entregue-o para Salma nos Sertões.‡Наполните пустой красный бурдюк для воды в Мельнице Таррен и отнесите воду Брин в Степи.‡Füllt den leeren roten Wasserschlauch am Brunnen in Tarrens Mühle und kehrt zu Brine im Brachland zurück.‡타렌 밀농장에 있는 우물에서 빈 빨간색 물주머니를 채워 불모의 땅에 있는 브린에게 가져가야 합니다.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Llena el odre de agua rojo vacío en el pozo de Molino Tarren y llévasela a Salmuera en Los Baldíos.‡Remplir l\'Outre rouge vide au puits de Moulin-de-Tarren et retourner voir Brine dans les Tarides.‡用塔伦米尔的井水装满空的红色水囊，然后把它交给贫瘠之地的布瑞恩。‡用塔倫米爾的井水裝滿空的紅色水囊，然後把它交給貧瘠之地的布瑞恩。',
  }
},
[1558] = {
  {
    'O Dique Lapidado‡Каменная плотина‡Der Steinwerkdamm‡돌다지 댐‡Presa de las Tres Cabezas‡Presa de las Tres Cabezas‡Le barrage de Formepierre‡巨石水坝‡巨石水壩',
    nil,
    'Leve o órfão ao Dique Lapidado em Loch Modan. Vá com ele até o meio do dique para que ele possa ver por cima da cachoeira.‡Отведите сироту к Каменной плотине у озера Лок Модан. Пусть постоит в центре дамбы и полюбуется огромным водопадом.‡Begleitet Euren Schützling zum Steinwerkdamm in Loch Modan. Geht mit ihm zur Mitte des Damms, damit er auf den riesigen Wasserfall heruntersehen kann.‡랜디스를 모단 호수에 있는 돌다지 댐에 데려다 줘야 합니다. 거대한 폭포를 볼 수 있도록 댐 중간까지 데려다 주십시오.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Lleva al huérfano a la Presa de las Tres Cabezas en Loch Modan. Deberías llevarle al centro de la presa para que pueda mirar por encima de la gigantesca cascada.‡Conduire l\'orphelin au barrage de Formepierre au Loch Modan. Vous devez le conduire au milieu du barrage pour qu\'il puisse voir par-dessus l\'immense chute d\'eau.‡带着你看护的孤儿去洛克莫丹的巨石水坝。你应该带他去水坝的中间，然后让他俯瞰巨大的瀑布。‡帶著你看護的孤兒去洛克莫丹的巨石水壩。你應該帶他去水壩的中間，然後讓他俯瞰巨大的瀑布。',
  }
},
[1559] = {
  {
    'Receita de bomba de clarão‡Секрет изготовления световой бомбы‡Blitzstrahlbombenanleitung‡섬광탄 제조법‡Receta de bomba cegadora‡Receta de bomba cegadora‡La recette de la bombe éclairante‡闪光弹的制法‡閃光彈的製法',
    nil,
    nil,
  }
},
[1560] = {
  {
    'A missão de Tuga‡Задание Туги‡Toogas Bitte‡길 잃은 투가‡La misión de Tooga‡La misión de Tooga‡La quête de Tooga‡图加的任务‡圖加的任務',
    nil,
    'Leve Tuga até a mulher dele, Tarta.‡Сопроводите Тугу к его жене, Торте.‡Zeigt Tooga den Weg zurück zu seiner Frau Torta.‡투가를 아내 토르타에게 데려다 주어야 합니다.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Muéstrale a Tooga el camino de vuelta con su esposa, Thorta.‡Montrer à Tooga le chemin du retour vers sa femme, Torta.‡把图加带回到他的妻子托尔塔身边。‡把圖加帶回到他的妻子托爾塔身邊。',
  }
},
[1578] = {
  {
    'Suprimentos para o front‡Помощь фронту‡Nachschub für die Front‡전방 보급품 조달‡Abastecer al frente‡Abastecer al frente‡Rééquiper le front‡前线的补给‡前線的補給',
    nil,
    'Entregue 6 Machados de Cobre e 6 Cintos Encadeados de Cobre para Thorvald, na torre de vigia sul de Loch Modan.‡Отнесите 6 медных топоров и 6 медных плетеных поясов Торвальду в южную сторожевую башню озера Лок Модан.‡Bringt 6 Kupferäxte und 6 kupferne Kettengürtel zu Thorvald im südlichen Wachturm des Loch Modan.‡모단 호수 남쪽 방어탑에 있는 토르발트에게 구리 도끼 6개와 구리 사슬 허리띠 6개를 주어야 합니다.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Lleva 6 hachas y 6 cinturones de anillas de cobre a Thorvald a la torre de vigilancia sur de Loch Modan.‡Apporter 6 Haches en cuivre et 6 Ceintures en anneaux de cuivre à Thorvald dans la Tour de garde méridionale du Loch Modan.‡给洛克莫丹南部警戒塔的索瓦尔德带去6把铜斧和6条铜质链甲腰带。‡給洛克莫丹南部警戒塔的索瓦爾德帶去6把銅斧和6條銅質鍊甲腰帶。',
  }
},
[1579] = {
  {
    'Deschanfradores‡Суперразъемы‡Klemmmuffen‡개퍼 잭‡Mecanismos eléctricos‡Mecanismos eléctricos‡Rouages électriques‡小齿轮‡小齒輪',
    nil,
    'Entregue 8 Deschanfradores para Xafetim Manigiro em Auberdine.‡Принесите Бацбаху Кривошипу в Аубердин 8 суперразъемов.‡Bringt 8 Klemmmuffen zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 개퍼 잭 8개를 가져가야 합니다.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Lleva 8 mecanismos eléctricos a Maniveo Zumbang a Auberdine.‡Apporter 8 Rouages électriques à Crackboum Tournelevier à Auberdine.‡收集8个小齿轮，把它们交给奥伯丁的维兹班恩·曲针。‡收集8個小齒輪，把它們交給奧伯丁的維茲班恩·曲針。',
  }
},
[1580] = {
  {
    'Eletromolas‡Электропеллеры‡Elektropeller‡전력추진기‡Los electromuelles‡Los electromuelles‡Pêche aux Electropellers‡导电器‡導電器',
    nil,
    'Entregue 12 Eletromolas para o Xafetim Manigiro em Auberdine.‡Принесите 12 электропеллеров Бацбаху Кривошипу в Аубердин.‡Bringt 12 Elektropeller zu Hexknall Kurbeldreh in Auberdine.‡아우버다인에 있는 위즈뱅 크랭크토글에게 전력추진기 12개를 가져가야 합니다.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Lleva 12 electromuelles a Maniveo Zumbang a Auberdine.‡Apporter 12 Electropellers à Crackboum Tournelevier à Auberdine.‡收集12个导电器，把它们交给奥伯丁的维兹班恩·曲针。‡收集12個導電器，把它們交給奧伯丁的維茲班恩·曲針。',
  }
},
[1581] = {
  {
    'Elixires para os Folhâminas‡Эликсиры для клана Режущего Листа‡Elixiere für die Messerblatts‡블레이드리프를 위한 비약‡Elixires para Filohoja‡Elixires para Filohoja‡Les élixirs pour les Feuillelame‡刃叶的药剂‡刃葉的藥劑',
    nil,
    'Traga 6 Elixires de Força de Leão e 2 Elixires de Defesa Menor para Syral Folhâmina, em Dolanaar.‡Доставьте 6 эликсиров львиной силы и 2 слабых эликсира защиты Сирел Остролист в Доланаар.‡Bringt 6 Elixiere der Löwenstärke und 2 Elixiere der schwachen Verteidigung zu Syral Messerblatt in Dolanaar.‡돌라나르에 있는 시랄 블레이드리프에게 사자의 힘 비약 6개와 최하급 방어의 비약 2개를 가져가야 합니다.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Llévale 6 elixires de fuerza de león y 2 elixires de defensa menor a Syral Filohoja, que está en Dolanaar.‡Apporter 6 Elixirs de force du lion et 2 Elixirs de défense mineure à Syral Feuillelame à Dolanaar.‡给在多兰纳尔的塞拉尔·刃叶带去6瓶狮王之力药剂和2瓶初级防御药剂。‡給在多蘭納爾的塞拉爾·刃葉帶去6瓶獅王之力藥劑和2瓶初級防禦藥劑。',
  }
},
[1582] = {
  {
    'O colete brilho da lua‡Жилет лунного сияния‡Mondscheinweste‡달빛 조끼‡El jubón resplandor lunar‡El jubón resplandor lunar‡Le gilet Lueur-de-lune‡月光外衣‡月光外衣',
    nil,
    'Leve 1 par de Luvas de Couro com Relevo, 5 pares de Botas de Couro com Relevo e 5 Mantos de Couro com Relevo para Lotherias, em Darnassus.‡Принесите 1 пару тисненых кожаных перчаток, 5 пар тисненых кожаных сапог и 5 тисненых кожаных плащей Лотериас в Дарнас.‡Bringt 1 geprägten Lederhandschuh, 5 geprägte Lederstiefel und 5 geprägte Lederumhänge zu Lotherias in Darnassus.‡다르나서스에 있는 로서리아스에게 새김무늬 가죽 장갑 1개, 새김무늬 가죽 장화 5개, 새김무늬 가죽 망토 5개를 가져가야 합니다.‡Trae 1 par de guantes de cuero estampado, 5 botas de cuero estampado y 5 capas de cuero estampado para Lotherias en Darnassus.‡Trae 1 par de guantes de cuero estampados, 5 botas de cuero estampadas y 5 capas de cuero estampadas para Lotherias en Darnassus.‡Apporter 1 paire de Gants en cuir estampé, 5 paires de Bottes en cuir estampé et 5 Capes en cuir estampé à Lotherias à Darnassus.‡把1双雕花皮手套、5双雕花皮靴和5件雕花皮质披风交给达纳苏斯的洛瑟里亚斯。‡把1雙雕花皮甲手套、5雙雕花皮甲長靴和5件雕花皮甲披風交給達納蘇斯的洛瑟里亞斯。',
  }
},
[1598] = {
  {
    'Ladrão que rouba ladrão...‡Украденная книга‡Der gestohlene Foliant‡도난 당한 책‡El libro robado‡El libro robado‡Le Tome dérobé‡失窃的典籍‡失竊的典籍',
    nil,
    'Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.‡Retrieve the Powers of the Void for Drusilla La Salle.',
  }
},
[1599] = {
  {
    '‡В начале славных дел‡Anfänge‡‡Novato‡Novato‡Les débuts‡开端‡',
    nil,
    '‡Добудьте 3 оберега из перьев и отнесите их Аламару Мрачнну в Старую Наковальню.‡Bringt 3 Federglücksbringer zu Alamar Grimm in Ambossar.‡‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Lleva 3 talismanes de plumas a Alamar Grimm a Yunquemar.‡Apporter 3 Charmes de plume à Alamar Grimm à Courbenclume.‡给安威玛尔的阿拉玛尔·格里姆带回3个羽毛咒符。‡',
  }
},
[1618] = {
  {
    'Armamentos para Cristarrubra‡Экипирование Красногорья‡Die Aufrüstung im Rotkammgebirge‡붉은마루산맥 무기 조달‡Equipar Crestagrana‡Equipar Crestagrana‡Le rééquipement des Carmines‡赤脊山的补给‡支援赤脊山',
    nil,
    'Tormus Baixaforja quer que você dê 4 Cintos Rúnicos de Cobre e 4 Malhos Pesados de Cobre para Vervo Obom, em Cristarrubra.‡По просьбе Тормуса Подземной Кузни отнесите 4 рунных медных пояса и 4 тяжелых медных кувалды Вернеру Осгуду в Красногорье.‡Tormus Tiefenschmied möchte, dass Ihr 4 runenverzierte Kupfergürtel und 4 schwere Kupferschlägel zu Verner Gutmark ins Rotkammgebirge bringt.‡토르무스 딥포지가 붉은마루 산맥에 있는 베르너 오스구드에게 구리 룬문자 허리띠 4개와 무거운 구리 마울 4개를 가져다 달라고 부탁했습니다.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 mazas grandes de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forjahonda quiere que le lleves 4 cinturones rúnicos de cobre y 4 mazas grandes de cobre pesadas a Verner Osbien a Crestagrana.‡Tormus Forge-profonde veut que vous apportiez 4 Ceintures runiques en cuivre et 4 Maillets lourds en cuivre à Verner Bongoulot, dans les Carmines.‡托姆斯·深炉要你给赤脊山的弗纳·奥斯古带去4条铜质符文腰带和4把铜质大锤。‡托姆斯·深爐要你帶4條銅質符文腰帶和4把重銅大槌給赤脊山的弗納·奧斯古。',
  }
},
[1638] = {
  {
    'Treinamento de guerreiro‡Обучение воина‡Die Ausbildung eines Kriegers‡전사 훈련‡Instrucción de guerrero‡Instrucción de guerrero‡L\'entraînement du guerrier‡战士的训练‡戰士的訓練',
    nil,
    'Speak with Harry Burlguard in Stormwind.‡Поговорите с Гарри Берлгардом в Штормграде.‡Sprecht mit Harry Burlwacht in Sturmwind.‡스톰윈드에 있는 해리 벌가드와 대화해야 합니다.‡Habla con Harry Burlguard en Ventormenta.‡Habla con Harry Burlguard en Ventormenta.‡Parler à Harry Burlguard à Hurlevent.‡和暴风城的哈里·伯加德谈一谈。‡到暴風城找哈里·伯加德談話。',
  }
},
[1639] = {
  {
    'Bartolino, o bebum‡Бартлби Пьянь‡Bartleby der Trunkenbold‡주정뱅이 바틀비‡Bartleby, el borracho‡Bartleby, el borracho‡Bartleby le poivrot‡醉鬼巴特莱比‡醉鬼巴托比',
    nil,
    'Fale com Bartolino.‡Поговорите с Бартлби.‡Sprecht mit Bartleby.‡바틀비와 대화해야 합니다.‡Habla con Bartleby.‡Habla con Bartleby.‡Parler à Bartleby.‡和巴特莱比谈一谈。‡和巴托比談話。',
  }
},
[1640] = {
  {
    'Que surra, Bartolino!‡Побить Бартлби‡Besiegt Bartleby‡바틀비와의 대결‡Vence a Bartleby‡Vence a Bartleby‡Battre Bartleby‡击败巴特莱比‡擊敗巴托比',
    nil,
    'Vença o Bartolino e converse com ele.‡Побейте Бартлби и снова поговорите с ним.‡Besiegt Bartleby und redet dann mit ihm.‡바틀비와 싸워 이긴 후 그와 대화해야 합니다.‡Derrota a Bartleby y habla con él.‡Golpea a Bartleby y habla con él.‡Battre Bartleby, puis lui parler.‡打败巴特莱比，然后再和他谈一谈。‡打敗巴托比，然後再和他談話。',
  }
},
[1641] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    nil,
  }
},
[1642] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1643] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Procure Stephanie Turner no Distrito Comercial de Ventobravo.‡Обыщите Торговый квартал и найдите Стефани Тернер.‡Sucht im Handelsdistrikt von Sturmwind nach Stephanie Turner.‡스톰윈드의 상업 지구에서 스테파니 터너를 찾아야 합니다.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Busca a Stephanie Turner en el Distrito de Mercaderes de Ventormenta.‡Chercher Stephanie Turner dans le Quartier commerçant de Hurlevent.‡在暴风城的贸易区找到斯蒂芬妮·特纳。‡到暴風城的貿易區找尋斯蒂芬妮·特納。',
  }
},
[1644] = {
  {
    'Tomo de Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve 10 pedaços de Linho para Stephanie Turner em Ventobravo.‡Принесите 10 отрезов льна в Штормград и отдайте Стефани Тернер.‡Bringt 10 Stück Leinenstoff zu Stephanie Turner in Sturmwind.‡스톰윈드에 있는 스테파니 터너에게 리넨 옷감 10개를 가져가야 합니다.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Lleva 10 retales de paño de lino a Stephanie Turner a Ventormenta.‡Apporter 10 morceaux d\'étoffe de lin à Stephanie Turner à Hurlevent.‡给暴风城的斯蒂芬妮·特纳收集10块亚麻布。‡給暴風城的斯蒂芬妮·特納收集10塊亞麻布。',
  }
},
[1645] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    nil,
  }
},
[1646] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Fale com Tiza Beloforja em Altaforja.‡Поговорите с Тизой Кузнебой в Стальгорне.‡Sprecht mit Tiza Kriegshammer in Eisenschmiede.‡아이언포지에 있는 타이자 배틀포지와 대화해야 합니다.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Ve a Forjaz y habla con Tiza Forjabatalla.‡Parlez à Tiza Forgeguerre, à Forgefer.‡与铁炉堡的蒂萨·热炉谈一谈。‡與鐵爐堡的蒂薩·熱爐談話。',
  }
},
[1647] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Vasculhe o anel externo de Altaforja para João Turner.‡Найдите во внешнем кольце Стальгорна Джона Тернера.‡Sucht im äußeren Ring von Eisenschmiede nach John Turner.‡아이언포지의 외곽 지역에 있는 존 터너를 찾아야 합니다.‡Busca a John Turner en el anillo exterior de Forjaz.‡Busca a John Turner en el anillo exterior de Forjaz.‡Chercher John Turner à la périphérie de Forgefer.‡在铁炉堡的外环区域找到约翰·特纳。‡在鐵爐堡的外環區域找到約翰·特納。',
  }
},
[1648] = {
  {
    'Tomo da Divindade‡Фолиант Божественности‡Der Foliant der Offenbarung‡신앙의 고서‡Escrito sobre divinidad‡Escrito sobre divinidad‡Le Tome de divinité‡圣洁之书‡聖潔之書',
    nil,
    'Leve 10 peças de Linho para João Turner em Altaforja.‡Принесите 10 отрезов льняной ткани Джону Тернеру в Стальгорн.‡Bringt 10 Stück Leinenstoff zu John Turner in Eisenschmiede.‡아이언포지에 있는 존 터너에게 리넨 옷감 10개를 가져가 기부해야 합니다.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Lleva 10 retales de paño de lino a John Turner a Forjaz.‡Apporter 10 morceaux d\'étoffe de lin à John Turner à Forgefer.‡收集10块亚麻布，把它们交给铁炉堡的约翰·特纳。‡收集10塊亞麻布，把它們交給鐵爐堡的約翰·特納。',
  }
},
[1649] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1650] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Encontre Dafne Calmafonte no Cerro Oeste.‡Найдите Дафну Стилвелл в Западном Крае.‡Sucht Daphne Stillbrunn in Westfall.‡서부 몰락지대에 있는 대프니 스틸웰을 찾아야 합니다.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Encuentra a Daphne Fontana en los Páramos de Poniente.‡Trouver Daphne Morpuits dans la marche de l\'Ouest.‡在西部荒野找到达芙妮·斯迪威尔。‡在西部荒野找到達芙妮·斯迪威爾。',
  }
},
[1651] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Proteja Dafne Calmafonte do ataque dos Défias.|n|nPara obter êxito, seus espíritos não podem ser despidos do lodo mortal.|n|nQuando você conseguir, fale novamente com Dafne Calmafonte.‡Защитите Дафну Стилвелл от нападения Братства Справедливости. Проследите, чтобы ни ее, ни ваша душа в случае смерти не покинули свои тела, иначе испытание не будет засчитано.|n|nПосле победы поговорите с Дафной Стилвелл.‡Verteidigt Daphne Stillbrunn vor dem Angriff der Defias.|n|nKeiner Eurer Geister darf aus seinen irdischen Fesseln befreit werden, wenn Ihr erfolgreich sein wollt.|n|nSprecht erneut mit Daphne Stillbrunn, wenn Ihr erfolgreich wart.‡데피아즈단의 공격으로부터 대프니 스틸웰을 보호하십시오.|n|n둘 중 하나라도 죽으면 실패하게 됩니다.|n|n성공한 후에 대프니 스틸웰과 다시 대화해야 합니다.‡Defiende a Daphne Fontana del ataque de los Defias.|n|nSi quieres tener éxito, vuestros espíritus no pueden salir de sus espirales mortales.|n|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Defiende a Daphne Fontana del ataque de los Defias.|n|nSi quieres tener éxito, sus espíritus no pueden salir de sus espirales mortales.|n|nCuando lo hayas conseguido, vuelve a hablar con Daphne Fontana.‡Défendez Daphne Morpuits contre les attaques des Défias.|n|nAucun de vous deux ne doit mourir, si vous voulez réussir la quête.|n|nQuand vous aurez réussi, reparlez à Daphne Morpuits.‡在迪菲亚兄弟会进攻时保护达芙妮·斯迪威尔的安全。|n|n如果你想成功的话，你和达芙妮都不能死在他们的剑下。‡在迪菲亞兄弟會進攻時保護達芙妮·斯迪威爾的安全。|n|n如果你想成功的話，你和達芙妮都不能死在他們的劍下。',
  }
},
[1652] = {
  {
    'Tomo da Bravura‡Фолиант Доблести‡Der Foliant der Ehre‡용맹의 고서‡Escrito sobre valor‡Escrito sobre valor‡Le Tome de la bravoure‡勇气之书‡勇氣之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[1653] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Fale com Jardel Calmafonte em Altaforja.‡Поговорите с Джорданом Стилвеллом в Стальгорне.‡Sprecht mit Jordan Stillbrunn in Eisenschmiede.‡아이언포지에 있는 조던 스틸웰과 대화해야 합니다.‡Habla con Jordan Fontana en Forjaz.‡Habla con Jordan Fontana en Forjaz.‡Parler à Jordan Morpuits à Forgefer.‡去和铁炉堡的乔丹·斯迪威尔谈一谈。‡去和鐵爐堡的喬丹·斯迪威爾談話。',
  }
},
[1654] = {
  {
    'A prova da retidão‡Испытание доблести‡Die Prüfung der Rechtschaffenheit‡정의의 시험‡La prueba de rectitud‡La prueba de rectitud‡Le test de droiture‡正义试炼‡正義試煉',
    nil,
    'Usando as Anotações do Jardel sobre Armas, encontre Madeira de Carvalho de Pedralva, o Carregamento de Minério Refinado do Bailor, o Martelo de Ferreiro de Jardel e uma Gema Kor. Depois, entregue tudo a Jardel Calmafonte em Altaforja.‡Возьмите список Джордана, добудьте немного древесины белокаменного дуба, партию очищенной руды Бэйлора, кузнечный молот Джордана и самоцвет Кора и отдайте их Джордану Стилвеллу в Стальгорне.‡Sucht mit Jordans Waffennotizen etwas Weißsteineichenholz, Bailors aufbereitete Erzlieferung, Jordans Schmiedehammer und einen Koredelstein und bringt alles zusammen zu Jordan Stillbrunn in Eisenschmiede.‡조던의 쪽지를 참고해 흰돌참나무 재목, 조던의 제련된 광석 상자, 조던의 대장장이 망치, 그리고 코르석을 찾아 아이언포지에 있는 조던 스틸웰에게 가져가야 합니다.‡Consulta los apuntes sobre armas y llévale a Jordan Fontana de Forjaz lo siquiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrería de Jordan y una gema Kor.‡Consulta la lista y llévale a Jordan Fontana de Forjaz lo siguiente: madera de roble de Piedrablanca, envío de oro refinado de Bailor, el martillo de herrero de Jordan y una gema Kor.‡Utiliser les Notes sur les armes de Jordan, trouver du Bois de chêne de blanchepierre, la Cargaison de Minerai raffiné de Bailor, le Marteau de forge de Jordan et une Gemme de Kor, puis revenir voir Jordan Morpuits à Forgefer.‡按照乔丹的武器材料单上的说明去寻找一些白石橡木、精炼矿石、乔丹的铁锤和一块科尔宝石，然后回到铁炉堡去见乔丹·斯迪威尔。‡按照喬丹的武器材料單上的說明去尋找一些白石橡木、精煉礦石、喬丹的鐵錘和一塊科爾寶石，然後回到鐵爐堡去見喬丹·斯迪威爾。',
  }
},
[1655] = {
  {
    'Carregamento de minério do Bailor‡Партия руды Балора‡Bailors Erzlieferung‡조던의 광석 상자‡Envío de mena de Bailor‡Envío de mena de Bailor‡Cargaison de minerai de Bailor‡白洛尔的矿石‡白洛爾的礦石',
    nil,
    'Leve o Carregamento de Minério do Jardel até Bailor Manopedra, em Loch Modan.‡Доставьте партию руды для Джордана Балору Крепкоруку к озеру Лок Модан.‡Bringt Jordans Erzlieferung zu Bailor Steinhand in Loch Modan.‡모단 호수에 있는 베일러 스톤핸드에게 조던의 광석 상자를 가져가야 합니다.‡Lleva el envío de mena de Jordan a Bailor Petramano a Loch Modan.‡Lleva el envío de Jordan a Bailor Petramano a Loch Modan.‡Apporter la Cargaison de minerai de Jordan à Bailor Main-de-pierre au Loch Modan.‡把乔丹的矿石带给洛克莫丹的白洛尔·石手。‡把喬丹的礦石帶給洛克莫丹的白洛爾·石手。',
  }
},
[1656] = {
  {
    'Serviço pela metade‡Незаконченное задание‡Eine unvollendete Aufgabe‡완수하지 못한 임무‡Una tarea por terminar‡Una tarea por terminar‡Une tâche inachevée‡未完的任务‡未完的任務',
    nil,
    'Leve a Trouxa de Peles para o Estalajadeiro Kauth na Aldeia Casco Sangrento.‡Отнесите сверток мехов хозяину таверны Кауту в деревню Кровавого Копыта.‡Bringt das Bündel Felle zu Gastwirt Kauth ins Dorf der Bluthufe.‡블러드후프 마을에 있는 여관주인 카우스에게 모피 묶음을 가져가야 합니다.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Lleva el fardo de pelajes al tabernero Kauth al Poblado Pezuña de Sangre.‡Livrez le Ballot de fourrures à l\'aubergiste Kauth à Sabot-de-sang.‡将一捆毛皮带给血蹄村的旅店老板考乌斯。‡將一捆毛皮帶給血蹄村的旅店老闆考烏斯。',
  }
},
[1657] = {
  {
    'Fedor na Costa Sul‡Чем пахнет в Южнобережье‡Die Verpestung von Süderstade‡사우스쇼어에 구린내 폭탄 투하‡Apesta Costasur‡Apesta Costasur‡Empuantir Austrivage‡臭气熏天的南海镇‡薰死南海鎮',
    nil,
    'Atire três Bombas Fedidas dos Renegados no coração da Costa Sul, em Eira dos Montes, e fale novamente com a Invoca-trevas Yanka no Festival do Homem de Palha, nas Clareiras de Tirisfal.‡Бросьте три бомбы-вонючки Отрекшихся в центр Южнобережья в Хилсбраде и вернитесь к призывательнице тьмы Янке на фестиваль Плетеного человека в Тирисфальских лесах.‡Werft drei Stinkbomben der Verlassenen ins Herz von Süderstade im Hügelland und kehrt zu Ruferin der Dunkelheit Yanka beim Fest des Weidenmanns in Tirisfal zurück.‡힐스브래드에 있는 사우스쇼어 한가운데에 3개의 포세이큰 구린내 폭탄을 던진 후, 티리스팔 숲의 밀짚인형 축제가 열리는 곳에 있는 암흑의 소환사 얀카에게 돌아가야 합니다.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a Clamasombra Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lanza 3 bombas fétidas de los Renegados en el corazón de Costasur en Trabalomas, y después ve a ver a la clamasombras Yanka, que está en el Festival del Hombre de Mimbre en los Claros de Tirisfal.‡Lancer trois Boules puantes des Réprouvés au milieu d\'Austrivage en Hautebrande, puis revenez voir la sombre imploratrice Yanka à la Fête de l\'homme d\'osier, aux Clairières de Tirisfal.‡将三颗亡灵臭气弹放置在希尔斯布莱德丘陵的南海镇中心，完成任务之后回到提瑞斯法林地的黑暗召唤者雅恩卡那里。‡在希爾斯布萊德的南海鎮中心投擲三顆被遺忘者臭彈，然後回去找在提里斯法林地的稻草人節的黑暗召喚者雅恩卡。',
  }
},
[1658] = {
  {
    'Penetra no Festival do Homem de Palha‡Сорвать праздник Плетеного человека‡Bespitzelt das Fest des Weidenmanns‡밀짚인형 축제 정탐‡Arruinar el Festival del Hombre de Mimbre‡Arruinar el Festival del Hombre de Mimbre‡Un intrus à la Fête de l\'homme d\'osier‡稻草人的节日‡破壞稻草人節',
    nil,
    'Localize o Festival do Homem de Palha nas Clareiras de Tirisfal. Depois, fale novamente com o Sargento Hartman na Costa Sul.‡Отыщите место проведения фестиваля Плетеного человека в Тирисфальских лугах и возвращайтесь в Южнобережье к сержанту Хартману.‡Macht das Fest des Weidenmanns der Verlassenen in Tirisfal ausfindig. Kehrt zu Unteroffizier Hartman in Süderstade zurück, sobald Ihr Eure Mission erfüllt habt.‡티리스팔 숲에서 포세이큰의 밀짚인형 축제가 열리고 있는 곳을 찾아 정탐한 후 사우스쇼어에 있는 하사관 허트만에게 돌아가야 합니다.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Localiza el Festival del Hombre de Mimbre de los Renegados en Claros de Tirisfal. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Allez voir la Fête de l\'homme d\'osier des Réprouvés dans les clairières de Tirisfal. Revenez voir le Sergent Hartman à Austrivage quand ce sera fait.‡在提瑞斯法林地找到被遗忘者的稻草人节日举办地点。任务完成之后回到南海镇的哈特曼中士那里。‡找出提里斯法林地的被遺忘者的稻草人節所在地。完成後回去向南海鎮的哈特曼中士覆命。',
  }
},
[1659] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
