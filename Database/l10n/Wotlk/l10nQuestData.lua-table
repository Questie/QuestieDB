[2750] = {
  {
    'Um ovo gorado‡Плохое яйцо‡Ein schlechtes Ei‡상해버린 알‡Un huevo pasado‡Un huevo pasado‡Un mauvais œuf‡坏掉的蛋‡壞掉的蛋',
