[4485] = {
  {
    'O Tomo de Nobreza‡Фолиант благородства‡Der Foliant des Adels‡고결함의 고서‡Escrito sobre nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡高貴之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[4486] = {
  {
    'O Tomo de Nobreza‡Фолиант благородства‡Der Foliant des Adels‡고결함의 고서‡Escrito sobre nobleza‡Escrito sobre nobleza‡Le Tome de noblesse‡高贵之书‡高貴之書',
    nil,
    'Fale com Benedito Brião em Ventobravo.‡Поговорите с Даторианом Раллом в Штормграде.‡Sprecht mit Duthorian Rall in Sturmwind.‡스톰윈드에 있는 두소리안 랄과 대화해야 합니다.‡Habla con Duthorian Rall en Ventormenta.‡Habla con Duthorian Rall en Ventormenta.‡Parler à Duthorian Rall, à Hurlevent.‡与暴风城的达索瑞恩·拉尔谈一谈。‡與暴風城的達索瑞恩·拉爾談話。',
  }
},
[4487] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parlez à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4488] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parlez à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4489] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan na Vila Catraca.‡Поговорите в Кабестане со Страхадом Фарсаном.‡Sprecht mit Strahad Farsan in Ratschet.‡톱니항에 있는 스트라드 파선과 대화해야 합니다.‡Habla con Strahad Farsan en Trinquete.‡Habla con Strahad Farsan en Trinquete.‡Parlez à Strahad Farsan, à Cabestan.‡与棘齿城的斯坦哈德·法尔杉谈一谈。‡與棘齒城的斯坦哈德·法爾杉談話。',
  }
},
[4490] = {
  {
    'Evocar Corcel Vil‡Призывание коня Скверны‡Teufelsross beschwören‡지옥마 소환‡Invoca un corcel vil‡Invoca un corcel vil‡Invocation d\'un palefroi corrompu‡召唤地狱战马‡召喚惡魔戰馬',
    nil,
    'Fale com Strahad Farsan, na Vila Catraca, para aprender a habilidade de evocar um Corcel Vil.‡Поговорите в Кабестане со Страхадом Фарсаном, чтобы получить способность призывать коня Скверны.‡Sprecht in Ratschet mit Strahad Farsan, um zu lernen, wie man ein Teufelsross beschwört.‡톱니항에 있는 스트라드 파선과 대화해 지옥마 소환 능력을 배워야 합니다.‡Habla con Strahad Farsan en Trinquete para aprender a invocar a un corcel vil.‡Habla con Strahad Farsan en Trinquete para aprender a invocar a un corcel vil.‡Parlez à Strahad Farsan, à Cabestan pour apprendre à invoquer un Palefroi corrompu.‡与棘齿城的斯坦哈德·法尔杉谈一谈，学习召唤地狱战马的能力。‡與棘齒城的斯坦哈德·法爾杉談話，學習召喚惡魔戰馬的能力。',
  }
},
[4491] = {
  {
    'O calor tá de matar‡Дружеская помощь‡Etwas Hilfe von guten Freunden‡내 친구의 작은 도움‡Un poco de ayuda de mis amigos‡Un poco de ayuda de mis amigos‡Un peu d\'aide de mes amis‡朋友的帮助‡朋友的幫助',
    nil,
    'Leve Ringo até Espraga Froque, no Refúgio do Marshal.|n|nSe Ringo desmaiar, use o Cantil da Espraga para reanimá-lo.‡Отведите Ринго к Муче Кусора в Укрытие Маршалла. |n|nЕсли Ринго потеряет сознание, плесните на него воды из фляги Спрэггл, чтобы привести его в чувство.‡Führt Ringo zu Spraggel Frock in Marschalls Zuflucht.|n|nFalls Ringo ohnmächtig werden sollte, verwendet Spraggles Feldflasche, um ihn zu beleben.‡마샬의 야영지에 있는 스프래글 프록에게 링고 스타를 데려다 주어야 합니다.|n|n링고 스타가 기절하면 스프래글의 수통을 사용해 깨워야 합니다.‡Lleva a Ringo con Spraggle Frock en el Refugio de Marshal.|n|nSi Ringo se desmaya utiliza la cantimplora de Spraggle para revivirlo.‡Lleva a Ringo con Spraggle Frock en el Refugio de Marshal.|n|nSi Ringo se desmaya utiliza la cantimplora de Spraggle para revivirlo.‡Conduire Ringo auprès de Spraggle Frock, au refuge des Marshal.|n|nSi Ringo s\'évanouit, utiliser la Gourde de Spraggle pour le réanimer.‡把林格带回马绍尔营地的斯普拉格·弗劳克身边。|n|n如果林格晕倒了，就用斯普拉格的水壶让他恢复。‡把林格帶回馬紹爾營地的斯普拉格·弗勞克身邊。|n|n如果林格暈倒了，就用斯普拉格的水壺讓他恢復。',
  }
},
[4492] = {
  {
    'Perdido!‡Потерялся!‡Verloren!‡링고 찾기‡¡Perdido!‡¡Perdido!‡Perdu !‡走丢了！‡走丟了!',
    nil,
    'Encontre Ringo no Pico Penacho de Fogo.‡Найдите Ринго на Вулкане Огненного Венца.‡Sucht Ringo am Feuersäulengrat.‡불기둥 마루에서 링고 스타를 찾아야 합니다.‡Encuentra a Ringo en la Cresta del Penacho en Llamas.‡Encuentra a Ringo en la Cresta del Penacho en Llamas.‡Trouver Ringo sur la crête de la Fournaise.‡在火羽山找到林格。‡在火羽山找到林格。',
  }
},
[4493] = {
  {
    'A marcha dos silitídeos‡Нашествие силитидов‡Der Marsch der Silithiden‡실리시드의 행진‡La marcha de los silítidos‡La marcha de los silítidos‡La marche des silithides‡异种蝎的远征‡異種蠍的遠征',
    nil,
    'Fale com o Alquimista Almofarrista em Geringontzan.‡Поговорите с алхимиком Пестычинсом в Прибамбасске.‡Sprecht in Gadgetzan mit Alchemist Stößelbruch.‡가젯잔에 있는 연금술사 페슬저그와 대화해야 합니다.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Parler à l\'Alchimiste Pilonzugg à Gadgetzan.‡与加基森的炼金师匹斯特苏格谈一谈。‡與加基森的鍊金師匹斯特蘇格談話。',
  }
},
[4494] = {
  {
    'A marcha dos silitídeos‡Нашествие силитидов‡Der Marsch der Silithiden‡실리시드의 행진‡La marcha de los silítidos‡La marcha de los silítidos‡La marche des silithides‡异种蝎的远征‡異種蠍的遠征',
    nil,
    'Fale com o Alquimista Almofarrista em Geringontzan.‡Поговорите с алхимиком Пестычинсом в Прибамбасске.‡Sprecht in Gadgetzan mit Alchemist Stößelbruch.‡가젯잔에 있는 연금술사 페슬저그와 대화해야 합니다.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Habla con el alquimista Morterozugg en Gadgetzan.‡Parler à l\'Alchimiste Pilonzugg à Gadgetzan.‡与加基森的炼金师匹斯特苏格谈一谈。‡與加基森的鍊金師匹斯特蘇格談話。',
  }
},
[4495] = {
  {
    'Um bom amigo‡Добрый друг‡Ein guter Freund‡죽마고우‡Un buen amigo‡Un buen amigo‡Un bon ami‡好朋友‡好朋友',
    nil,
    'Encontre Iverron perto da caverna ao norte.‡Найдите Иверрона возле пещеры на севере.‡Sucht Iverron an der Höhle im Norden.‡북쪽의 동굴 근처에서 이베론을 찾아야 합니다.‡Encuentra a Iverron cerca de la cueva que hay al norte.‡Encuentra a Iverron cerca de la cueva que hay al norte.‡Trouver Iverron près de la grotte au nord.‡在北边的洞穴附近找到埃沃隆。‡在北邊的洞穴附近找到埃沃隆。',
  }
},
[4496] = {
  {
    'Sururu na selva‡Путаница в джунглях‡Dschungelei‡밀림 속 생물‡Que jungla tan chunga‡Que jungla tan chunga‡Fiasco dans la jungle‡擒虫先擒王‡擒蟲先擒王',
    nil,
    'Leve uma Glândula Odorífera Gorishi e 5 Amostras de Solo de Un\'Goro ao Alquimista Almofarrista em Geringontzan.‡Принесите ароматическую железу Гориши и 5 образцов почвы из Кратера Ун\'Горо алхимику Пестычинсу в Прибамбасск.‡Bringt eine Gorishiduftdrüse und 5 Erdproben von Un\'Goro zu Alchemist Stößelbruch in Gadgetzan.‡가젯잔에 있는 연금술사 페슬저그에게 고리쉬 향낭 1개와 운고로 토양 견본 5개를 가져가야 합니다.‡Llévale una glándula secretora de olor Gorishi y 5 muestras de la tierra de Un\'Goro al alquimista Morterozugg de Gadgetzan.‡Llévale una glándula secretora de olor Gorishi y 5 muestras de la tierra de Un\'Goro al alquimista Morterozugg de Gadgetzan.‡Apporter une Glande olfactive Gorishi et 5 Échantillons d\'humus d\'Un\'Goro à l\'Alchimiste Pilonzugg, à Gadgetzan.‡把一份格里什信息素和5份安戈洛的泥土样本交给加基森的炼金师匹斯特苏格。‡帶一個格里什香味腺體和5個安戈洛的泥土樣本給加基森的鍊金師匹斯特蘇格。',
  }
},
[4501] = {
  {
    'Cuidado com os pterrordaxes‡Осторожно, злой терродактиль‡Vorsicht, Pterrordax!‡테러닥스 주의‡Cuidado con los pterrordáctilos‡Cuidado con los pterrordáctilos‡Attention aux pterreurdactyles‡当心翼手龙‡當心翼手龍',
    nil,
    'Kill 10 Frenzied Pterrordax, then speak to Spraggle Frock at Marshal\'s Refuge.‡Убейте 10 терродактилей, затем поговорите со Мучей Кусора в Укрытии Маршалла.‡Tötet 10 rasende Pterrordax und sprecht dann mit Spraggel Frock in Marschalls Zuflucht.‡광포한 테러닥스 10마리를 처치한 후 마샬의 야영지에 있는 스프래글 프록과 대화해야 합니다.‡Mata a 10 pterrordáctilos demenciados. Cuando lo hayas hecho habla con Spraggle Frock en el Refugio de Marshal.‡Mata a 10 pterrordáctilos demenciados. Cuando lo hayas hecho habla con Spraggle Frock en el Refugio de Marshal.‡Tuer 10 Pterreurdactyles frénétiques, puis parler à Spraggle Frock, au refuge des Marshal.‡杀掉10只狂怒的翼手龙，然后向马绍尔营地的斯普拉格·弗劳克报告。‡殺掉10隻狂怒的翼手龍，然後向馬紹爾營地的斯普拉格·弗勞克報告。',
  }
},
[4502] = {
  {
    'Atividade vulcânica‡Вулканическая активность‡Vulkanische Aktivität‡화산 활동‡Actividad volcánica‡Actividad volcánica‡Activité volcanique‡火山的活动‡火山的活動',
    nil,
    'Colete 9 amostras das Cinzas de Un\'Goro dos elementais de fogo ao redor do vulcão da Cratera Un\'Goro, e leve-as para Fanny Quito, em Vila Catraca.‡Добудьте 9 образцов пепла Ун\'Горо из элементалей огня, что водятся вокруг вулкана в Кратере Ун\'Горо, и доставьте их Лив Быстрочин в Кабестан.‡Sammelt 9 Proben der Asche von Un\'Goro von den Feuerelementaren am Vulkan im Krater von Un\'Goro ein und bringt die Proben zu Liv Ritzelflick in Ratschet.‡운고로 분화구의 화산 주위에 있는 불의 정령에게서 운고로 재 견본 9개를 모아 톱니항에 있는 리브 리즐픽스에게 가져가야 합니다.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Lleva 9 muestras de ceniza de los elementales de fuego del Cráter de Un\'Goro a Liv Rizzlefix a Trinquete.‡Collecter 9 échantillons de Cendres d\'Un\'Goro sur les Élémentaires de feu autour du volcan du Cratère d\'Un\'Goro, puis les apporter à Liv Rafistolier, à Cabestan.‡到安戈洛环形山的火山中去，从那里的元素身上收集9份安戈洛灰烬，把它们交给棘齿城的莉芙·雷兹菲克斯。‡到安戈洛環形山的火山中去，從那裡的元素身上收集9份安戈洛灰燼，把它們交給棘齒城的莉芙·雷茲菲克斯。',
  }
},
[4503] = {
  {
    'O Chislo quer voar!‡Крылолет Шиззла‡Sappalots Flieger‡쉬즐의 비행선‡El aparato volador de Shizzle‡El aparato volador de Shizzle‡La machine volante de Shizzle‡希兹尔的飞行器‡希茲爾的飛行器',
    nil,
    'Colete 8 Escamas de Dimetrodonte Palmado e 8 Escamas de Pterrordax Palmado para Chislo no Refúgio do Marshal.‡Принесите 8 чешуй перепончатого деметродона и 8 чешуй перепончатого терродактиля Шиззлу в Укрытие Маршалла.‡Sammelt 8 eingesponnene Dimetrodonschuppen und 8 eingesponnene Pterrordaxschuppen für Sappalot in Marschalls Zuflucht.‡마샬의 야영지에 있는 쉬즐에게 갈퀴 달린 디메트로돈 비늘 8개와 갈퀴 달린 테러닥스 비늘 8개를 가져가야 합니다.‡Recoge 8 escamas de diemetradón palmeadas y 8 escamas de pterrordáctilo palmeadas para Shizzle, en el Refugio de Marshal.‡Recoge 8 escamas de diemetradón palmeadas y 8 escamas de pterrordáctilo palmeadas para Shizzle, en el Refugio de Marshal.‡Apporter 8 Écailles étoilées de dimeurtrodon et 8 Écailles étoilées de pterreurdactyles à Shizzle, au refuge des Marshal.‡为马绍尔营地的希兹尔收集8块精细的双帆龙鳞片和8块精细的翼手龙鳞片。‡替馬紹爾營地的希茲爾收集8片精細的雙帆龍鱗片和8片精細的翼手龍鱗片。',
  }
},
[4504] = {
  {
    'Supergrudento‡Суперлипучка‡Superkleber‡초강력 접착제‡Superpegajoso‡Superpegajoso‡Ultra collant‡极度粘稠的沥青‡極度粘稠的瀝青',
    nil,
    'Colete 12 amostras de Piche Supergrudento para Tran\'rek em Geringontzan.‡Отнесите 12 образцов сверхлипкой смолы Тран\'реку в Прибамбасск.‡Sammelt 12 Proben superklebrigen Teer für Tran\'rek in Gadgetzan.‡매우 끈적거리는 타르 12개를 모아 가젯잔에 있는 트란렉에게 갖다 주어야 합니다.‡Reúne 12 muestras de alquitrán muy pegajoso para Tran\'rek de Gadgetzan.‡Reúne 12 muestras de alquitrán muy pegajoso para Tran\'rek de Gadgetzan.‡Collecter 12 échantillons de Goudron ultra collant pour Tran\'rek, à Gadgetzan.‡帮加基森的特兰雷克收集12块极度粘稠的沥青。‡幫加基森的特蘭雷克收集12塊極度粘稠的瀝青。',
  }
},
[4505] = {
  {
    'Poço da Corrupção‡Источник порчи‡Brunnen der Verderbnis‡오염된 달샘‡El pozo de la corrupción‡Pozo de corrupción‡Puits de la corruption‡腐化之井‡腐化之井',
    nil,
    'Colete uma amostra de água corrompida do poço lunar dos Sátiros Flamejade e leve-a para Winna Perícon no Posto Peçonha.‡Принесите образец оскверненной воды из лунного колодца сатиров из племени Нефритового Пламени Винне Хеззард на заставу Отравленной Крови.‡Beschafft eine Probe verderbten Wassers vom Mondbrunnen der Jadefeuersatyrn und bringt sie zu Winna Hazzard am Blutgiftposten.‡비취불꽃 사티로스가 지키는 달샘에서 오염된 물 견본을 채취하여 피멍울 초소에 있는 위나 해저드에게 가져가야 합니다.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Riessgo al Puesto del Veneno.‡Recoge una muestra de agua corrupta de la Poza de la Luna de los sátiros Fuego de Jade y llévasela a Winna Riessgo al Puesto del Veneno.‡Collecter un échantillon d\'eau corrompue dans le puits de lune des satyres Jadefeu, puis le rapporter à Winna Hazzard, au Poste de la Vénéneuse.‡从碧火萨特的月亮井中收集一份被腐化的水的样本，把它交给血毒哨所的温娜·哈萨德。‡從碧火薩特的月井中收集一份被腐化的水的樣本，把它交給血毒哨所的溫娜·哈薩德。',
  }
},
[4506] = {
  {
    'Dentes-de-sabre corrompidos‡Зараженные саблезубы‡Verderbte Säbler‡오염된 고양이‡Dientes de sable corruptos‡Sables corruptos‡Sabres corrompus‡被腐蚀的猫‡腐化的貓',
    nil,
    'Leve o gatinho de Winna para o poço lunar corrompido, solte-o e depois o leve de volta para Winna.|n|nQuando retornar, clique no gato para deixá-lo com Winna.‡Отнесите котенка Винны к оскверненному лунному колодцу, выпустите его, затем снова принесите Винне.|n|nКак только вернетесь к Винне, щелкните мышкой по котенку, чтобы выпустить его.‡Bringt Winnas Kätzchen zum verderbten Mondbrunnen, lasst es dort frei und bringt es dann wieder zu Winna zurück.|n|nSobald Ihr wieder bei Winna seid, klickt auf die Katze, um sie Winna zu übergeben.‡위나의 고양이를 오염된 달샘으로 데려가서 풀어 준 다음 위나에게 다시 데려가야 합니다.|n|n위나에게로 데려간 후 클릭하면 위나에게 돌아갈 것입니다.‡Lleva el gatito de Winna a la Poza de la Luna corrupta, libéralo allí y luego llévaselo a Winna.|n|nCuando hayas vuelto con Winna, haz clic en el felino para dárselo.‡Lleva el gatito de Winna a la Poza de la Luna corrupta, libéralo allí y luego llévaselo a Winna.|n|nCuando hayas vuelto con Winna, haz clic en el felino para dárselo.‡Apportez le chaton de Winna au puits de lune corrompu, relâchez-le, puis rapportez-le à Winna.|n|nUne fois de retour auprès de Winna, cliquez sur le chat pour le lui rendre.‡把温娜的小猫带到堕落的月亮井旁边，把猫放出来，然后把它还给温娜。|n|n当你回到温娜那里之后，点击猫就可以将它还给温娜。‡把溫娜的小貓帶到墮落的月井旁邊，把貓放出來，然後把它帶回去給溫娜。|n|n當你回到溫娜那裡之後，點擊貓就可以將它還給溫娜。',
  }
},
[4507] = {
  {
    'O peão captura a rainha‡Пешка берет королеву‡Bauer schlägt Dame‡여왕의 뇌‡El señuelo atrapa a la reina‡El señuelo atrapa a la reina‡Le pion prend la reine‡捕捉皇后‡小兵捉蠍后',
    nil,
    'Derrote a Rainha da Colmeia Gorishi assim que ela for atraída.|n|nLeve o Cérebro da Rainha Gorishi para o Alquimista Almofarrista em Geringontzan.‡Призовите и сразите матку улья Гориши.|n|nПринесите мозг матки Гориши алхимику Пестычинсу в Прибамбасск.‡Besiegt die Schwarmkönigin der Gorishi, sobald sie erscheint.|n|nBringt das Gehirn der Schwarmkönigin zu Alchemist Stößelbruch nach Gadgetzan.‡여왕 고리쉬를 불러내 처치해야 합니다.|n|n가젯잔에 있는 연금술사 페슬저그에게 여왕 고리쉬 뇌를 가져가야 합니다.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.|n|nLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Derrota a la reina de la colmena Gorishi cuando hayas conseguido que salga al exterior.|n|nLlévale el cerebro de la reina Gorishi al alquimista Morterozugg de Gadgetzan.‡Invoquer la Reine gorishi et la vaincre.|n|nApporter le Cerveau de reine gorishi à l\'alchimiste Pilonzugg, à Gadgetzan.‡召唤格里什皇后，然后击败她。|n|n把格里什皇后的大脑交给加基森的炼金师匹斯特苏格。‡當格里什蜂后被召喚之後擊敗她。|n|n帶格里什皇后的腦袋給加基森的鍊金師匹斯特蘇格。',
  }
},
[4508] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Relatório de Un\'Goro do Almofarrista para Gracinha Forçânima em Darnassus.‡Отнесите отчет Пестычинса о ситуации в Ун\'Горо Грацине Силе Духа в Дарнас.‡Bringt Stößelbruchs Bericht von Un\'Goro zu Gracina Glaubensmacht in Darnassus.‡다르나서스에 있는 그라시나 스피릿마이트에게 페슬저그의 운고로 보고서를 가져가야 합니다.‡Llévale el informe de Un\'Goro de Morterozugg a Gracina Poderespíritu, que está en Darnassus.‡Llévale el informe de Un\'Goro de Morterozugg a Gracina Poderespíritu, que está en Darnassus.‡Apporter le Rapport de Pilonzugg sur Un\'Goro à Gracina Forcesprit, à Darnassus.‡把匹斯特苏格的安戈洛报告交给达纳苏斯的格拉希娜·灵风。‡把匹斯特蘇格的安戈洛報告交給達納蘇斯的格拉希娜·靈風。',
  }
},
[4509] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Relatório de Un\'Goro do Almofarrista para Zilzibin Tamborleiro em Orgrimmar.‡Отнесите отчет Пестычинса о ситуации в Ун\'Горо Зилзибину Барабанному Бою в Оргриммар.‡Bringt Stößelbruchs Bericht von Un\'Goro zu Zilzibin Tomtom in Orgrimmar.‡오그리마에 있는 질지빈 드럼로어에게 페슬저그의 운고로 보고서를 가져가야 합니다.‡Llévale el informe de Un\'Goro de Morterozugg a Zilzibin Tambor Sabio, que está en Orgrimmar.‡Llévale el informe de Un\'Goro de Morterozugg a Zilzibin Tambor Sabio, que está en Orgrimmar.‡Apporter le Rapport de Pilonzugg sur Un\'Goro à Zilzibin Kongadok, à Orgrimmar.‡把匹斯特苏格的安戈洛报告交给奥格瑞玛斯的基尔兹宾·鼓眼。‡把匹斯特蘇格的安戈洛報告交給奧格瑪的基爾茲賓·鼓眼。',
  }
},
[4510] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Comprovante Bancário a Idriana no banco de Darnassus.‡Отнесите банковскую расписку Идриане в банк Дарнаса.‡Bringt den Bankgutschein zu Idriana in der Bank von Darnassus.‡다르나서스 은행에 있는 이드리아나에게 은행 증서를 가져가야 합니다.‡Lleva el vale del banco a Idriana, al banco de Darnassus.‡Lleva el vale del banco a Idriana, al banco de Darnassus.‡Apportez le Reçu bancaire à Idriana, à la banque de Darnassus.‡把银行赠券交给达纳苏斯银行的伊迪瑞娜。‡把銀行贈券交給達納蘇斯銀行的伊迪瑞娜。',
  }
},
[4511] = {
  {
    'A calmaria que precede a tempestade‡Затишье перед бурей‡Die Ruhe vor dem Sturm‡폭풍전야‡La calma que precede a la tormenta‡La calma que precede a la tormenta‡Le calme avant la tempête‡临危不惧‡暴風雨前的寧靜',
    nil,
    'Leve o Comprovante Bancário para Karus, no banco de Orgrimmar.‡Отнесите банковскую расписку Карусу в банк Оргриммара.‡Bringt den Bankgutschein zu Karus in der Bank von Orgrimmar.‡오그리마 은행에 있는 카루스에게 은행 증서를 가져가야 합니다.‡Lleva el vale a Karus al banco de Orgrimmar.‡Lleva el vale a Karus al banco de Orgrimmar.‡Apportez le Reçu bancaire à Karus, à la banque d\'Orgrimmar.‡把银行赠券交给奥格瑞玛银行的卡鲁斯。‡把銀行贈券交給奧格瑪銀行的卡魯斯。',
  }
},
[4512] = {
  {
    'Gosmologia‡Долгий путь слизнюка‡Schlamm auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite gelée‡远方的软泥怪‡遠方的泥漿怪',
    nil,
    'Entregue 6 Jarras de Gosma Amaldiçoada Cheias e 6 Jarras de Gosma Maculada Cheias para Laris Vagarroda em Altaforja.‡Принесите 6 флаконов с образцами нечистых слизнюков и 6 флаконов с образцами проклятых слизнюков Ларису Обалдую в Стальгорн.‡Bringt 6 mit verfluchtem Schlamm gefüllte Gläser und 6 mit besudeltem Schlamm gefüllte Gläser zu Laris Bummelritzel in Eisenschmiede.‡아이언포지에 있는 라리스 기어더들에게 가득 찬 저주받은 수액괴물 병 6개와 가득 찬 부패한 수액괴물 병 6개를 가져가야 합니다.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto pra Laris Cadenapartida en Forjaz.‡Consigue 6 jarros llenos de moco maldito y 6 jarros llenos de moco corrupto para Laris Mecaparra en Forjaz.‡Apporter 6 Pots de Limons maudits remplis et 6 Pots de Limons corrompus remplis à Laris Bringuefourbi, à Forgefer.‡将6瓶被诅咒的软泥怪样本和6瓶被污染的软泥怪样本交给铁炉堡的拉里斯·空轮。‡將6個被詛咒的軟泥怪樣本和6個受污染的軟泥怪樣本交給鐵爐堡的拉里斯·空輪。',
  }
},
[4513] = {
  {
    'Gosmologia‡Долгий путь слизнюка‡Schlamm auf Abwegen‡수액괴물 견본 수집‡Un largo camino para unas babosas‡Un largo camino para unas babosas‡Un grand périple pour une petite Gelée‡远方的软泥怪‡遠方的泥漿怪',
    nil,
    'Leve 10 Jarras Cheias de Amostra Pura para Laris Vagarroda em Altaforja.|n|nCaso você não consiga encontrar as gosmas puras, peça mais pistas para o Laris.‡Принесите 10 флаконов c образцами чистых слизнюков Ларису Обалдую в Стальгорн.|n|nЕсли будет трудно их найти, возможно, стоит попытаться добиться от Лариса подсказки.‡Bringt 10 gefüllte reine Probengläser zu Laris Bummelritzel in Eisenschmiede.|n|nFalls Ihr Probleme habt, fündig zu werden, dann kann Laris Euch vielleicht noch den einen oder anderen Hinweis geben.‡아이언포지에 있는 라리스 기어더들에게 가득 찬 순수한 견본 병10개를 가져가야 합니다.|n|n찾기 어려우면 라리스에게서 단서를 더 얻어 보십시오.‡Lleva 10 tarros de muestra pura a Laris Mecaparra a Forjaz.|n|nSi no los encuentras, habla con Laris.‡Lleva 10 tarros de muestra pura a Laris Mecaparra a Forjaz.|n|nSi no los encuentras, habla con Laris.‡Apporter 10 Pots remplis d\'échantillon pur à Laris Bringuefourbi, à Forgefer.|n|nSi vous éprouvez des difficultés à les trouver, allez voir Laris pour obtenir plus d\'indices.‡将10个纯净样本瓶交给铁炉堡的拉里斯·空轮。|n|n如果你无法找到它们的话，不妨到拉里斯那里去再打听一些线索。‡將10個裝滿的純淨樣品瓶交給鐵爐堡的拉里斯·空輪。|n|n如果你無法找到它們的話，試著到拉里斯那裡去再打聽一些線索。',
  }
},
[4521] = {
  {
    'Guardiões selvagens‡Одичавшие стражи‡Wilde Wächter‡사나운 수호병‡Guardianes salvajes‡Guardianes salvajes‡Gardiens sauvages‡冬泉谷的枭兽‡冬泉谷的梟獸',
    nil,
    'Trull Ruinazar em Selva Maleva quer que você mate 15 Ferujas Furiosas e 15 Ferujas Maltrapilhas.‡Убейте для Трулла Баловня Судьбы 15 бешеных совухов и 15 лохматых совухов.‡Trull Scheiterbann im Teufelswald möchte, dass Ihr 15 tobende Eulenbestien und 15 struppige Eulenbestien tötet.‡악령의 숲에 있는 트룰 페일베인이 흉포한 올빼미야수 15마리, 털북숭이 올빼미야수 15마리를 처치해달라고 부탁했습니다.‡Trull Fallarruina de Frondavil quiere que mates 15 lechubestias enfurecidas y 15 lechubestias andrajosas.‡Trull Fallarruina de Frondavil quiere que mates 15 lechubestias enfurecidas y 15 lechubestias pulgosas.‡Trull Faillemort de Gangrebois veut que vous tuiez 15 Chouettards déchaînés et 15 Chouettards éreintés.‡费伍德森林的特鲁尔·法贝恩要你去冬泉谷猎杀15头狂怒的枭兽和15头蓬毛枭兽。‡費伍德森林的特盧爾·法貝恩要你去冬泉谷獵殺15頭狂怒的梟獸和15頭蓬毛梟獸。',
  }
},
[4542] = {
  {
    'Mensagem para a Aldeia Vento Livre‡Письмо на Заставу Вольного Ветра‡Nachricht zum Freiwindposten‡높새바람 봉우리‡Mensaje para el Poblado Viento Libre‡Mensaje para el Poblado Viento Libre‡Un message pour le poste de Librevent‡给乱风岗的紧急信件‡給亂風崗的緊急信件',
    nil,
    'Leve a Mensagem Urgente ao Vigia do Rochedo Chifre Longo na Aldeia Vento Livre.‡Отнесите срочное послание дозорному утесов Долгорогу на Заставу Вольного Ветра.‡Bringt Klippenbehüter Langhorn am Freiwindposten die dringende Nachricht.‡긴급 전갈을 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 가져가야 합니다.‡Entrégale el mensaje urgente a Vigiarisco Cuerno Largo en el Poblado Viento Libre.‡Entrégale el mensaje urgente al vigiarrisco Cuerno Largo en el Poblado Viento Libre.‡Apportez le Message urgent au garde-falaise Longue-corne au Poste de Librevent.‡把紧急信件交给乱风岗的峭壁卫兵图林·长角。‡把緊急信件交給亂風崗的峭壁看守者長角。',
  }
},
[4561] = {
  {
    'Teste de impurezas - Cratera Un\'Goro‡Образцы на пробу из кратера Ун\'Горо‡Test auf Unreinheiten - Krater von Un\'Goro‡불순물 실험 - 운고로 분화구‡Pruebas de impureza: Cráter de Un\'Goro‡Pruebas de impureza: Cráter de Un\'Goro‡Test pour impuretés, le Cratère d\'Un\'Goro‡杂质检测 - 安戈洛环形山‡雜質檢測 - 安戈洛環形山',
    nil,
    nil,
  }
},
[4581] = {
  {
    'Kainet Brisacalma‡Кайнет Штиль‡Kayneth Stillwind‡케이네스 스틸윈드‡Kayneth Ventoleve‡Kayneth Ventoleve‡Kayneth Mortebrise‡凯尼斯·静风‡凱尼斯·靜風',
    nil,
    'Leve o Bilhete de Shindrell para Kainet Brisacalma em Cantilenda.‡Отнесите записку Шиндрелл Кайнету Штилю в Лесную Песнь.‡Bringt Shindrells Notiz zu Kayneth Stillwind in Waldeslied.‡숲의 노래에 있는 케이네스 스틸윈드에게 신드렐의 쪽지를 가져가야 합니다.‡Llévale la nota de Shindrell a Kayneth Ventoleve en Canción del Bosque.‡Llévale la nota de Shindrell a Kayneth Ventoleve en Canción del Bosque.‡Apporter la Note de Shindrell à Kayneth Mortebrise au Chant des Forêts.‡把辛德瑞尔的便笺交给林歌神殿里的凯尼斯·静风。‡把辛德瑞爾的便箋交給林歌神殿裡的凱尼斯·靜風。',
  }
},
[4601] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡빤질빤질세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡빤질빤질세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200 et s\'assurer d\'avoir trois pièces d\'argent pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[4602] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡빤질빤질세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡빤질빤질세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto sucio en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener tres monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200 et s\'assurer d\'avoir trois pièces d\'argent pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[4603] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Funkelmatastisch‡빤질빤질세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Brille-o-Matic décape encore‡再次使用超级清洁器‡再次使用超級清潔器',
