  }
},
[9342] = {
  {
    '‡Хищный землерой‡Plündernde Krustenbohrer‡‡Revientacortezas merodeadores‡Revientacortezas merodeadores‡Les perceurs de croûte maraudeurs‡潜行的地壳穿刺者‡',
    nil,
    '‡Убейте 15 хищных землероев по просьбе штейгера Разлкраза. Эти черви предпочитают нападать неожиданно, из-под земли.‡Großknecht Razelcraz bei den Minen in der Nähe von Thrallmar möchte, dass Ihr 15 plündernde Krustenbohrer tötet. Die Würmer haben die Angewohnheit, unplötzlich aus ihren unterirdischen Tunneln anzugreifen.‡‡El supervisor Razelcraz, de las minas que están cerca de Thrallmar, quiere que mates a quince revientacortezas merodeadores. Los gusanos tienen tendencia a atacar de repente desde sus túneles, que están bajo tierra.‡El supervisor Razelcraz, de las minas que están cerca de Thrallmar, quiere que mates a quince revientacortezas merodeadores. Los gusanos tienen tendencia a atacar de repente desde sus túneles, que están bajo tierra.‡Le contremaître Razelcraz, des mines près de Thrallmar, veut que vous tuiez 15 Perceurs de croûte maraudeurs. Les vers ont tendance à attaquer brutalement à partir de leurs tunnels souterrains.‡‡',
  }
},
[9343] = {
  {
    '‡Гербовая накидка Серебряного Рассвета‡Wappenrock der Argentumdämmerung‡은빛 여명회 휘장‡Tabardo de El Alba Argenta‡Tabardo de El Alba Argenta‡Tabard de l\'Aube d\'argent‡银色黎明战袍‡銀色黎明外袍',
    nil,
    nil,
  }
},
[9344] = {
  {
    '‡Поспешный отъезд‡Der überstürzte Aufbruch‡‡Una salida apresurada‡Una salida apresurada‡Un départ précipité‡仓促的离开‡',
    nil,
    '‡Разыщите Грелага, ученика провозвестницы Регулкут.‡Scharfseherin Regulkut möchte, dass Ihr ihren Schüler Grelag findet.‡‡La clarividente Regulkult quiere que encuentres el rastro de su estudiante Grelag.‡La clarividente Regulkult quiere que encuentres el rastro de su estudiante Grelag.‡La prophétesse Regulkut veut que vous retrouviez son élève Grelag.‡‡',
  }
},
[9345] = {
  {
    'Preparando o unguento‡Изготовление мази‡Herstellung der Salbe‡고약 재료 준비‡Preparar el bálsamo‡Preparar el bálsamo‡Préparation du baume‡准备药膏‡準備藥膏',
    nil,
    'Colete 12 mudas de Folhespinho do Fogo do Inferno para um unguento, e fale novamente com Grolag no Acampamento Quebra-espinha.‡Соберите 12 листьев пламенного шиполиста и возвращайтесь к Грелагу на Заставу Хребтолома.‡Grelag im Rückenbrecherposten möchte, dass Ihr ihm 12 Höllenwirbelkräuter für seine Salbe bringt.‡고약의 재료가 되는 지옥불 가시돌기 12개를 모아서 해골망치 초소의 그렐라그에게 가져가야 합니다.‡Reúne doce plantas de Espinelas de Fuego Infernal para un bálsamo y vuelve con Grelag al Avanzada Rompeloma.‡Reúne doce plantas de Espinelas de Fuego Infernal para un bálsamo y vuelve con Grelag al Avanzada Rompeloma.‡Cueillez 12 Atrics des flammes infernales pour un baume et retournez voir Grelag au Poste de Brise-échine.‡将制作药膏所需的12片地狱火刺叶交给断背岗哨的葛雷拉格。‡收集12份地獄火骨葉植物然後交給斷脊氏族崗哨的格萊克以完成他的藥膏。',
  }
},
[9346] = {
  {
    '‡Зловепрь – птица гордая‡Wenn Hölleneber fliegen‡‡Cuando los jabinfernos vuelen‡Cuando los jabinfernos vuelen‡Quand les sangliers voleront‡地狱野猪飞起来‡',
    nil,
    '‡Принесите командиру стражи Кранку из Траллмара 10 раздутых трупов голодных зловепрей.‡Wachtkommandant Krunk in Thrallmar möchte, dass Ihr ihm 10 klobige Hölleneberkadaver von verhungernden Höllenebern bringt.‡‡El comandante de vigilancia Krunk de Thrallmar quiere que le lleves 10 carcasas de jabinferno cebado de los jabinfernos hambrientos.‡El comandante de vigilancia Krunk de Thrallmar quiere que le lleves 10 carcasas de jabinferno cebado de los jabinfernos hambrientos.‡Le commandant de la garde Krunk, de Thrallmar, veut 10 Carcasses dodues de sanglier infernal, prises sur les Sangliers infernaux affamés.‡‡',
  }
},
[9349] = {
  {
    'Sessão de catação‡Сбор яиц опустошителей‡Felshetzereier sammeln‡칼날발톱 알 수집‡Redada de huevos de devastador‡Redada de huevos de devastador‡Ramasser les œufs de ravageurs‡掠食者的卵‡收集劫毀者蛋',
    nil,
    'Colete 12 Ovos de Assolador para Ofélio no Zepelim Caído na Península Fogo do Inferno.‡Принесите 12 яиц опустошителей Легасси на место крушения дирижабля на полуострове Адского Пламени.‡Bringt 12 Felshetzereier zu Legassi bei der Zeppelinabsturzstelle auf der Höllenfeuerhalbinsel.‡지옥불 반도의 비행선 추락지에 있는 레가시를 위해 칼날발톱 알 12개를 가져와야 합니다.‡Consigue 12 huevos de devastador para Legassi en el Zepelín Caído, en la Península del Fuego Infernal.‡Consigue 12 huevos de devastador para Legassi en el Zepelín Caído, en la Península del Fuego Infernal.‡Récupérez 12 Œufs de ravageurs pour le compte de Legassi, de l\'épave du zeppelin dans la péninsule des Flammes infernales.‡将12枚饥饿掠食者的卵交给地狱火半岛飞艇坠毁点的雷加希。‡替地獄火半島，飛艇失事地的雷噶西取得12顆劫毀者蛋。',
  }
},
[9350] = {
  {
    'O trabalho de um peão nunca termina‡Работай, солнце еще высоко‡Die Arbeit eines Peons ist nie zu Ende‡일꾼들의 끝나지 않는 임무‡El trabajo de un peón nunca acaba‡El trabajo de un peón nunca acaba‡Les péons travaillent sans cesse‡永不休息的苦工‡苦工的苦工',
    nil,
    'Recolha 8 Pelegos de Fenoceronte e 8 conjuntos de Ossos de Fenoceronte dos Fenocerontes Enfurecidos. Fale novamente com o Comandante da Guarda Krunk em Thrallmar quando tiver todo o material.‡Отправляйтесь на охоту на свирепых копытней и добудьте 8 шкур копытня и 8 комплектов костей копытня. Собрав материалы, возвращайтесь к командиру стражи Кранку в Траллмар.‡Sammelt 8 Grollhufbälge und 8 Grollhufknochen von tobenden Grollhufen. Kehrt zu Wachkommandant Krunk in Thrallmar zurück, wenn Ihr alle Materialien beisammen habt.‡흉포한 갈래발굽을 처치하고 갈래발굽 통가죽 8개, 갈래발굽 뼈 8개를 모아야 합니다. 재료를 모두 모으면 스랄마에 있는 경비대 사령관 크룬크에게 돌아가십시오.‡Recolecta 8 pellejos de uñagrieta y 8 conjuntos de huesos de uñagrieta de los uñagrietas enfurecidos. Vuelve junto al comandante de vigilancia Krunk de Thrallmar cuando lo tengas todo.‡Recolecta 8 pellejos de uñagrieta y 8 conjuntos de huesos de uñagrieta de los uñagrietas enfurecidos. Vuelve junto al comandante de vigilancia Krunk de Thrallmar cuando lo tengas todo.‡Récupérez 8 Peaux de sabots-fourchus et 8 tas d\'Os de sabots-fourchus sur les Sabots-fourchus déchaînés. Lorsque vous aurez ces matériaux, retournez voir le commandant de la garde Krunk à Thrallmar.‡杀死暴怒的裂蹄牛，收集8张裂蹄牛的皮和8根裂蹄牛的骨头，将它们交给萨尔玛的前线指挥官卡伦克。‡從突變的裂蹄身上收集8張裂蹄皮和8組裂蹄骨頭。等你收集到所有的材料再交給索爾瑪的警備隊長克朗克。',
  }
},
[9351] = {
  {
    'Emissários muito loucos‡Дикие демоны Бездны‡Wilde Leerwandler‡야생의 보이드워커‡Abisarios enloquecidos‡Abisarios enloquecidos‡Les marcheurs du Vide sauvages‡疯狂的虚空行者‡野放的虛無行者',
    nil,
    'Leve 10 Essências Condensadas de Emissários do Caos para Gritonho Ouvessorte, o "Berrante", no Zepelim Caído.‡Принесите 10 конденсированных сущностей демона Бездны "Крикуну" Скриду Многослову на место крушения дирижабля.‡Bringt 10 kondensierte Leerwandleressenzen zu "Schreihals" Quack Lufthans bei der Zeppelinabsturzstelle.‡비행선 추락지에 있는 "호들갑쟁이" 스크리드 럭히드에게 응축된 보이드워커 정수를 가져가야 합니다.‡Llévale 10 esencias de abisario condensado a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Llévale 10 esencias de abisario condensado a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Remettez 10 Essences de marcheur du Vide condensées à Laïus "Brailleur" Airbuse à l\'épave du zeppelin.‡将10份浓缩的虚空行者精华交给飞艇坠毁点的"尖嗓子"斯克里·拉克希德。‡將10個濃縮的虛無行者精華帶給飛艇失事地的『驚嘆』史哥利德·幸運心。',
  }
},
[9352] = {
  {
    'Intrusões darnassianas‡Вторжение из Дарнаса‡Darnassische Eindringlinge‡나이트 엘프의 침입‡Intrusiones darnassianas‡Intrusiones darnassianas‡Les intrusions darnassiennes‡达纳苏斯的侵扰‡達納蘇斯的入侵',
    nil,
    'Vá ao Sacrário do Oeste, a sudoeste da Praça Asa do Falcão, e derrote todos os intrusos que encontrar. Apresente suas descobertas à Protetora de Meridianos Velania.‡Отправляйтесь в Западное святилище, к юго-западу от площади Соколиных Крыльев, и уничтожьте всех чужаков, которых вы там встретите. Затем сообщите о результатах хранительнице энергии Велании.‡Reist zum Sanktum des Westens südwestlich vom Falkenplatz und vernichtet jegliche Eindringlinge, die Ihr dort findet. Berichtet anschließend Leybewahrerin Velania.‡매날개 광장 남서쪽에 있는 서부 성소로 가서 그곳을 침입한 수상한 자를 처치한 다음, 맥지기 벨라니아에게 가서 발견한 사실을 보고해야 합니다.‡Ve al Sagrario del Oeste, al suroeste de la Plaza Alalcón y derrota a cualquier intruso que se encuentre allí. Informa del resultado a la vigilante-Ley Velania.‡Ve al Sagrario del Oeste, al suroeste de la Plaza Alalcón y derrota a cualquier intruso que se encuentre allí. Informa del resultado a la vigilante-Ley Velania.‡Rendez-vous au Sanctum occidental, au sud-ouest de la Place de l\'Épervier, et tuez les intrus s\'il y en a. Ensuite, allez faire votre rapport à la telluriste Velania.‡前往鹰翼广场西南方的西部圣殿击败在那一带出现的入侵者，然后将你发现的情况汇报给魔网监护者薇兰妮亚。‡前往西部聖所，就在獵鷹之翼廣場的西南邊，擊敗那裡所有的入侵者。將你的發現向牧地看守者維蘭妮雅報告。',
  }
},
[9353] = {
  {
    'Trocar o Vale-brinde de Caixa de Presente iCoca‡Подарочный купон АйКока‡iCoke-Geschenkgutschein einlösen‡Redeem iCoke Gift Box Voucher‡Canjear el vale de regalo de iCoke‡Canjear vale de caja de regalos iCoke‡Echanger les bon-cadeaux de boîte iCoke‡兑换夏日礼包兑换券‡可口可樂禮物盒兌換券',
    nil,
    nil,
  }
},
[9354] = {
  {
    'Em busca de material novo‡Поиск новых материалов‡Auf der Suche nach neuen Materialien‡‡Materias primas alternativas‡Materias primas alternativas‡À la recherche de nouveaux matériaux‡寻找新材料‡尋找新材料',
    nil,
    'Recolha 8 Pelegos de Fenoceronte e 8 Tendões de Fenoceronte dos Fenocerontes Enfurecidos. Quando tiver o material, leve-o para Humberto, na Fortaleza da Honra.‡Добудьте 8 шкур и 8 сухожилий свирепого копытня и принесите Шалтую в Оплот Чести.‡Sammelt 8 Grollhufbälge und 8 Grollhufsehnen von den tobenden Grollhufen. Wenn Ihr die Materialien habt, bringt sie zu Humphry in der Ehrenfeste.‡‡Recolecta 8 pellejos y 8 tendones de uñagrieta enfurecido y llévaselos a Humphry a Bastión del Honor.‡Recolecta 8 pellejos y 8 tendones de uñagrieta enfurecido y llévaselos a Humphry a Bastión del Honor.‡Récupérez 8 Peaux de sabots-fourchus et 8 Tendons de sabots-fourchus sur les Sabots-fourchus déchaînés. Lorsque vous les aurez, remettez-les à Humphry, au bastion de l\'Honneur.‡杀死一些暴怒的裂蹄牛，收集8张裂蹄牛的皮和8根裂蹄牛的肌腱，将它们交给荣耀堡的哈姆菲。‡從突變的裂蹄身上收集8塊裂蹄皮和8個裂蹄腱。等你弄到了材料把它們帶給榮譽堡的休夫利。',
  }
},
[9355] = {
  {
    'Um trabalho para uma pessoa inteligente‡Работа для сообразительных‡Eine Aufgabe für einen intelligenten Helden‡영리한 자를 위한 임무‡Un trabajo para alguien inteligente‡Un trabajo para alguien inteligente‡Un boulot pour un type intelligent‡聪明人的工作‡聰明人的工作',
    nil,
    'Mate 15 Estoura-crostas Invasores e apresente-se ao Encarregado Grandepar na Fortaleza da Honra.‡Убейте 15 хищных землероев и возвращайтесь к штейгеру Большие Десны в Оплот Чести.‡Tötet 15 plündernde Krustenbohrer und kehrt dann zu Großknecht Biggums in der Ehrenfeste zurück.‡명예의 요새에 있는 현장감독 비굼스가 약탈자 바위갈이 미늘벌레 15마리를 처치해달라고 부탁했습니다.‡Mata 15 revientacortezas merodeadores y vuelve a hablar con el supervisor Biggums en el Bastión del Honor.‡Mata 15 revientacortezas merodeadores y vuelve a hablar con el supervisor Biggums en el Bastión del Honor.‡Tuer 15 Perceurs de croûte maraudeurs, puis retourner voir le contremaître Biggums au bastion de l\'Honneur.‡杀死15只游荡的硬壳穿地虫，然后向荣耀堡的工头比格姆斯复命。‡殺死15名捕食中的地殼穿刺者再回到榮譽堡的工頭比干莫斯那裡。',
  }
},
[9356] = {
  {
    'Fadinha furada‡Летать как птица‡So weich wie Butter‡버터처럼 부드러운...‡Suave como una pluma‡Suave como una pluma‡Les doigts dans le nez‡万无一失‡技術高超',
    nil,
    'Leve 12 Asas Roliças de Urubu para Ofélio no Zepelim Caído.‡Принесите 12 мясистых крыльев канюка Легасси на место крушения дирижабля.‡Bringt 12 fleischige Bussardflügel zu Legassi bei der Zeppelinabsturzstelle.‡오동통한 독수리 날개 12개를 비행선 추락지에 있는 레가시에게 가져가야 합니다.‡Llévale 12 alas de águila ratonera rellena a Legassi en el Zepelín Caído.‡Llévale 12 alas de águila ratonera rollizas a Legassi en el Zepelín Caído.‡Apportez 12 Ailes de busard dodues à Legassi à l\'épave du zeppelin.‡将12只强壮的秃鹫翅膀交给飞艇坠毁点的雷加希。‡將12個豐滿的禿鷲翅膀交給飛艇失事地的雷噶西。',
  }
},
[9357] = {
  {
    'Report to Aeldon Sunbrand‡Задание Аэльдона Озаренного Солнцем‡Meldet Euch bei Aeldon Sonnenmal‡앨돈 선브랜드에게 보고‡Informar a Aeldon Marcasol‡Informar a Aeldon Marcasol‡Se présenter à Aeldon Signesol‡DEPRECATED‡向艾爾頓·桑布蘭德報告',
    nil,
    'Report to Aeldon Sunbrand at the Inner Elf Gate in Eversong Woods.‡Поговорите с Аэльдоном Озаренным Солнцем у Внутренних эльфийских ворот в Лесах Вечной Песни.‡Meldet Euch bei Aeldon Sonnenmal beim inneren Elfentor im Immersangwald.‡영원노래 숲의 내곽 엘프 관문에 있는 앨돈 선브랜드에게 보고해야 합니다.‡Preséntate ante Aeldon Marcasol en la Puerta Elfa Interior, en el Bosque Canción Eterna.‡Preséntate ante Aeldon Marcasol en la Puerta Elfa Interior, en el Bosque Canción Eterna.‡Présentez-vous à Aeldon Signesol à la porte elfique intérieure, dans le bois des Chants éternels.‡向永歌森林Inner Elf Gate的Aeldon Sunbrand报告。‡向永歌森林內精靈之門的艾爾頓·桑布蘭德報告。',
  }
},
[9358] = {
  {
    'A patrulheira Sareyn‡Следопыт Сарейн‡Waldläuferin Sareyn‡순찰자 사레인‡La forestal Sareyn‡La forestal Sareyn‡Le forestier Sareyn‡游侠萨蕾恩‡遊俠塞瑞',
    nil,
    'Fale com a Patrulheira Sareyn na Vila de Brisabela, que fica na Floresta do Canto Eterno.‡Поговорите со следопытом Сарейн у деревни Легкий Ветерок, что в лесах Вечной Песни.‡Meldet Euch bei Waldläuferin Sareyn außerhalb von Morgenluft im Immersangwald.‡영원노래 숲의 산들바람 마을 밖에 있는 순찰자 사레인에게 보고해야 합니다.‡Preséntate ante la forestal Sareyn en las afueras de Aldea Brisa Pura en el Bosque Canción Eterna.‡Preséntate ante la forestal Sareyn en las afueras de Aldea Brisa Pura en el Bosque Canción Eterna.‡Présentez-vous au forestier Sareyn, à l\'extérieur du village de Brise-clémente, dans le bois des Chants éternels.‡向永歌森林晴风村外的游侠萨蕾恩报到。‡向永歌森林晴風村外的遊俠塞瑞報告。',
  }
},
[9359] = {
  {
    'O Retiro dos Andarilhos‡Обитель Странников‡Zuflucht der Weltenwanderer‡원정순찰대 산장‡El Retiro del Errante‡El Retiro del Errante‡La Retraite des pérégrins‡远行者居所‡遠行者居所',
    nil,
    'Apresente-se à Tenente Correalba no Retiro dos Andarilhos, que fica na Floresta do Canto Eterno.‡Поговорите с лейтенантом Вестницей Зари в обители Странников, что в лесах Вечной Песни.‡Meldet Euch bei Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer im Immersangwald.‡영원노래 숲의 원정순찰대 산장에 있는 부관 돈러너에게 보고해야 합니다.‡Preséntate ante la teniente Correalba en el Retiro del Errante, en el Bosque Canción Eterna.‡Preséntate ante la teniente Correalba en el Retiro del Errante, en el Bosque Canción Eterna.‡Présentez-vous au lieutenant Coursaurore à la Retraite des Pérégrins, dans le bois des Chants éternels.‡向永歌森林远行者营地的达恩·晨行者中尉报告。‡向永歌森林遠行者營地的曦奔中尉報告。',
  }
},
[9360] = {
  {
    'Invasão Amani‡Вторжение племени Амани‡Angriff der Amani‡아마니의 침공‡La invasión Amani‡La invasión Amani‡L\'invasion des Amani‡阿曼尼的入侵‡阿曼尼入侵',
    nil,
    'Entregue os Planos de Invasão Amani à Tenente Correalba no Retiro dos Andarilhos.‡Доставьте планы вторжения племени Амани лейтенанту Вестнице Зари в обитель Странников.‡Bringt die Invasionspläne der Amani zu Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너에게 아마니 침공 계획서를 전달해야 합니다.‡Entrega los planes de la invasión Amani a la teniente Correalba en El Retiro del Errante.‡Entrega los planes de la invasión Amani a la teniente Correalba en El Retiro del Errante.‡Remettre les Plans d\'invasion amani au lieutenant Coursaurore à la Retraite des pérégrins.‡将阿曼尼入侵计划交给远行者居所的达恩·晨行者中尉。‡將阿曼尼攻擊計畫送給遠行者居所的曦奔中尉。',
  }
},
[9361] = {
  {
    'Javiltusco, a outra carne branca‡Зловепрь – тоже мясо‡Hölleneber, die etwas andere Delikatesse‡지옥멧돼지 고기 정화‡Huevos fritos con jabinferno‡Huevos fritos con jabinferno‡On se régale avec le sanglier infernal !‡地狱野猪，另一种白肉‡地獄野豬，另一種白肉',
    nil,
    'Ofélio, no Zepelim Caído, quer que você colete 8 nacos de Carne Purificada de Javiltusco. Para purificar a carne, use a Mistura de Purificação na Carne Estragada de Javiltusco que você coletar.‡Легасси требует принести ему 8 кусков мяса зловепря на место крушения дирижабля. Убейте зловепря, добудьте порченое мясо зловепря, а затем очистите его с помощью микстуры очищения.‡Legassi bei der Zeppelinabsturzstelle möchte, dass Ihr 8 Stück geläutertes Hölleneberfleisch sammelt. Um das Fleisch zu reinigen, schüttet die Läuterungsmischung über das besudelte Hölleneberfleisch, das Ihr von den Höllenebern gesammelt habt.‡비행선 추락지에 있는 레가시가 정화된 지옥멧돼지 고기 8개를 모아 달라고 부탁했습니다. 고기를 정화하려면 광기어린 지옥멧돼지에게 얻은 오염된 지옥멧돼지 고기에 정화의 혼합물을 사용해야 합니다.‡Legassi en el Zepelín Caído quiere que consigas 8 unidades de carne purificada de jabinferno. Para purificar la carne, utiliza la mezcla purificadora en la carne de jabinferno máculo que consigas encontrar.‡Legassi en el Zepelín Caído quiere que consigas 8 unidades de carne purificada de jabinferno. Para purificar la carne, utiliza la mezcla purificadora en la carne de jabinferno máculo que consigas encontrar.‡Legassi de l\'Épave du zeppelin veut que vous récupériez 8 morceaux de Viande de sanglier infernal purifiée. Pour purifier la viande, utilisez la Mixture de purification sur la Viande de sanglier infernal contaminée que vous prendrez sur des Sangliers infernaux.‡飞艇坠毁点的雷加希要你收集8块纯净的地狱野猪肉。你必须首先猎杀地狱野猪，然后利用净化药剂来净化被污染的地狱野猪肉。‡飛艇失事地的雷噶西要你去收集8個乾淨的地獄野豬肉。使用淨化藥劑來淨化你從瘋狂地獄野豬身上取的腐敗地獄野豬肉。',
  }
},
[9362] = {
  {
    'Senhor da Guerra Krellian‡Полководец Креллиан‡Kriegsherr Krellian‡크렐리안 장군‡Señor de la guerra Krellian‡Señor de la guerra Krellian‡Le seigneur de guerre Krellian‡军阀克雷利安‡督軍克雷利安',
    nil,
    'Recupere a Concha Prismática para o Arquimago Tauriel. O Arquimago reside numa torre no topo dos penhascos de Azshara.‡Принесите радужную раковину верховному магу Ксилему в башню в утесах Азшары.‡Beschafft die prismatische Muschel für Erzmagier Xylem. Der Erzmagier befindet sich in einem Turm auf den Klippen von Azshara.‡프리즘 껍질을 되찾아 아즈샤라 절벽 위 탑에 살고 있는 대마법사 실렘에게 돌려주어야 합니다.‡Recupera la concha centelleante para el archimago Xylem. El archimago vive en una torre en lo alto del precipicio de Azshara.‡Recupera la concha centelleante para el archimago Xylem. El archimago vive en una torre en lo alto del precipicio de Azshara.‡Récupérez la Coquille prismatique pour l\'archimage Xylem. L\'archimage réside dans une tour au sommet des falaises d\'Azshara.‡为大法师克希雷姆夺回虹彩贝壳。大法师克希雷姆就居住在艾萨拉北部悬崖上的一座塔中。‡為大法師克希雷姆取得稜彩貝殼。大法師就住在艾薩拉懸崖邊上的一座哨塔裡。',
  }
},
[9363] = {
  {
    'Aviso à Vila de Brisabela‡Предупреждение деревне Легкий Ветерок‡Warnt Morgenluft‡산들바람 마을에 경고 전하기‡Aviso a la Aldea Brisa Pura‡Aviso a la Aldea Brisa Pura‡Avertir le village de Brise-clémente‡警告晴风村‡警告晴風村',
    nil,
    'Vá à Vila de Brisabela na Floresta do Canto Eterno e fale com o Patrulheiro Degolien.‡Отправляйтесь в деревню Легкий Ветерок в лесах Вечной Песни и поговорите со следопытом Деголиеном.‡Reist nach Morgenluft im Immersangwald und sprecht mit Waldläufer Degolien.‡영원노래 숲의 산들바람 마을로 가서 순찰자 데골리엔과 대화해야 합니다.‡Dirígete a Aldea Brisa Pura en el Bosque Canción Eterna y habla con el forestal Degolien.‡Dirígete a Aldea Brisa Pura en el Bosque Canción Eterna y habla con el forestal Degolien.‡Rendez-vous au village de Brise-clémente dans le bois des Chants éternels et parlez au forestier Degolien.‡与永歌森林晴风村的游侠戴戈利恩谈一谈。‡前往永歌森林的晴風村和遊俠迪哥里恩談談。',
  }
},
[9364] = {
  {
    'Magia fragmentada‡Частицы магии‡Gespaltene Magie‡변이 마법‡Magia fragmentada‡Magia fragmentada‡Magie morcelée‡魔法的碎片‡破碎的魔法',
    nil,
    'Polimorfe as Iraliscas de Azshara e mate os clones que aparecerem. Quando matar 50 Clones Polimorfados, volte e fale com o Arquimago Tauriel, em Azshara.‡Наложите заклинание превращения на тварей Бича Злобы в Азшаре и убейте клонов, которые появятся несколько мгновений спустя. Убейте 50 клонов и возвращайтесь к верховному магу Ксилему в Азшару.‡Verwandelt die Grollflossen von Azshara und tötet die Kopien, die einige Sekunden später auftauchen. Wenn Ihr 50 verwandelte Kopien vernichtet habt, kehrt zu Erzmagier Xylem in Azshara zurück.‡아즈샤라의 원한의꼬리일족을 변이하고 몇 초 후 나타나는 변이된 복제생물 50마리를 해치워야 합니다. 모두 처치하고 나서 아즈샤라의 대마법사 실렘에게 돌아가야 합니다.‡Aplica el hechizo polimórfico al Látigo de Ira de Azshara y mata a los clones que aparezcan pasados unos segundos. Cuando hayas matado a 50, vuelve junto al archimago Xylem en Azshara.‡Aplica el hechizo polimórfico a las sirenas Látigo de Ira de Azshara y mata a los clones que aparezcan pasados unos segundos. Cuando hayas matado a 50, vuelve junto al archimago Xylem en Azshara.‡Métamorphosez les Fouette-bile d\'Azshara, puis tuez les clones qui apparaissent quelques instants plus tard. Quand vous aurez tué 50 clones de métamorphose, retournez voir l\'archimage Xylem en Azshara.‡对艾萨拉的恶鞭纳迦使用变形术，然后杀死几秒钟后出现的相似体。当你杀了50个相似体后，回去向大法师克希雷姆复命。‡對艾薩拉的惡鞭者施放變形術並殺死幾秒後出現的複製物。等你殺夠了，再回去找艾薩拉的大法師克希雷姆。',
  }
},
[9365] = {
  {
    '‡Награда вора‡Der Lohn des Diebes‡도적의 보상‡Una recompensa de ladrón‡Una recompensa de ladrón‡La récompense d\'un voleur‡盗贼的奖励‡小偷的獎勵',
    nil,
    '‡‡Bringt die Flamme von Sturmwind zu $N.‡‡‡‡‡‡',
  }
},
[9366] = {
  {
    'Precisando de sangrevil‡Оскверненная кровь‡Die Suche nach Teufelsblut‡순수한 악마의 힘‡Se busca: Sangrevil‡Se busca: Sangrevil‡Il nous faut du gangresang‡邪恶之血‡需要魔化之血',
    nil,
    'Ryathen, o Lúgubre, na Vigília do Falcão, que fica na Península Fogo do Inferno, quer que você mate os Terríferos que habitam os Poços de Aggonar e colete 6 Amostras de Sangrevil.‡Принесите 6 образцов оскверненной крови исчадий ужаса, обитающих у прудов Аггонара, Риатену Мрачному из Соколиного дозора на полуострове Адского Пламени.‡Ryathen der Düstere an der Falkenwacht auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 6 Teufelsblutproben von den Terrorbestien bringt, die bei den Teichen von Aggonar umherstreifen.‡지옥불 반도의 매의 감시탑에 있는 고뇌하는 리아센이 아고나르의 웅덩이에 있는 공포의 마귀에게서 지옥피 견본 6개를 가져다 달라고 부탁했습니다.‡Ryathen el Sombrío en la Avanzada del Halcón, en la Península del Fuego Infernal, quiere que le lleves 6 muestras de sangrevil de los terroadictos que viven en las Pozas de Aggonar.‡Ryathen el Sombrío en la Avanzada del Halcón, en la Península del Fuego Infernal, quiere que le lleves 6 muestras de sangrevil de los terroadictos que viven en las Pozas de Aggonar.‡Ryathen le Sombre, du Guet de l\'épervier dans la péninsule des Flammes infernales, veut que vous lui procuriez 6 Échantillons de grangresang prélevés sur les Fiels de la terreur qui vivent aux bassins d\'Aggonar.‡猎鹰岗哨的阴沉的利亚森要你前往阿苟纳之池，从恐惧魔身上收集6份邪血样本。‡地獄火半島獵鷹哨站的『憂鬱者』瑞安登要你從住在阿葛納爾之池的恐懼惡魔身上取回6份魔化之血樣本。',
  }
},
[9367] = {
  {
    'O Festival do Fogo‡Праздник Огня‡Das Fest des Feuers‡불의 축제‡El Festival del Fuego‡El Festival del Fuego‡La fête du Feu‡火焰的节日‡火焰節慶',
    nil,
    'Verifique as fogueiras de Ventobravo, Altaforja e Darnassus. Quando terminar, fale com um Historiador do Festival em uma capital.‡Прикоснитесь к пламени праздничных костров в Штормграде, Стальгорне и Дарнасе, затем поговорите с хранителем мудрости праздника в столичных городах.‡Wärmt Euch an den Freudenfeuern in Sturmwind, Eisenschmiede und Darnassus. Sprecht anschließend mit einem Meister der Lehren innerhalb der Hauptstädte.‡스톰윈드, 아이언포지, 다르나서스에 있는 화톳불을 만져보고 대도시 안에 있는 한여름 축제 현자에게 돌아가십시오.‡Toca las hogueras de Ventormenta, Forjaz y Darnassus y habla con un maestro del Conocimiento del festival en cada capital.‡Toca las hogueras de Ventormenta, Forjaz y Darnassus y habla con un maestro cultural del Festival en cada capital.‡Touchez les feux de joie à l\'intérieur de Hurlevent, Forgefer et Darnassus, puis parlez à n\'importe quel Maître des traditions de la fête dans une des capitales.‡碰触暴风城、铁炉堡和达纳苏斯城里的篝火，然后与城市内的节日博学者交谈。‡觸摸暴風城、鐵爐堡和達納蘇斯裡的營火，再和任何一個節慶博學大師談談。',
  }
},
[9368] = {
  {
    'O Festival do Fogo‡Праздник Огня‡Das Fest des Feuers‡한여름 불꽃축제‡El Festival del Fuego‡El Festival del Fuego‡La fête du Feu‡火焰的节日‡火焰節慶',
    nil,
    'Toque as fogueiras de Orgrimmar, do Penhasco do Trovão e da Cidade Baixa. Em seguida, fale com um Contador de Histórias do Festival em qualquer capital.‡Прикоснитесь к пламени праздничных костров в Оргриммаре, Громовом Утесе и Подгороде, затем поговорите с Праздничным сказителем в столичных городах.‡Wärmt Euch an den Freudenfeuern in Orgrimmar, Donnerfels und Unterstadt. Sprecht anschließend mit einem Geschichtenerzähler innerhalb der Hauptstädte.‡오그리마, 썬더 블러프, 언더시티에 화톳불을 만져보고 해당 대도시의 한여름 축제 현자에게 가십시오.‡Toca las hogueras de Orgrimmar, Cima del Trueno y Entrañas y habla con un Cuentacuentos en cada capital.‡Toca las hogueras de Orgrimmar, Cima del Trueno y Entrañas y habla con un cuentacuentos del Festival en cada capital.‡Touchez les feux de joie à l\'intérieur d\'Orgrimmar, des Pitons du Tonnerre et de Fossoyeuse, puis parlez à n\'importe quel Maître des traditions de la fête dans une des capitales.‡碰触奥格瑞玛、雷霆崖和幽暗城里的篝火，然后与城市内的节日诗人交谈。‡觸摸奧格瑪、雷霆崖和幽暗城裡的營火，再和任何一個節慶故事使者談談。',
  }
},
[9369] = {
  {
    'O reabastecimento dos cristais de cura‡Исцеляющие кристаллы‡Wiederaufladen der Heilkristalle‡치유의 수정 보충‡Recargar los cristales de sanación‡Recargar los cristales de sanación‡Recharger les cristaux de soin‡补充治疗水晶‡補充治療水晶',
    nil,
    'Adquira 8 Ampolas de Sangue das Mariposas do Vale. Em seguida, entregue-as a Proenitus no Ponto de Impacto, que fica no Vale Ammen.‡Добудьте 8 фиалов с кровью мотылька из долинных мотыльков и принесите их Проэнитусу на место крушения в долине Аммен.‡Beschafft Euch 8 Phiolen mit Mottenblut von den in der Nähe hausenden Talmotten und bringt sie zu Proenitus bei der Absturzstelle im Am\'mental.‡골짜기 나방에게서 나방 피가 든 유리병 8개를 모은 후, 암멘 골짜기의 추락 지점에 있는 프로에니투스에게 가져가야 합니다.‡Consigue 8 viales de sangre de polilla del valle y llévaselos a Proenitus a Lugar del Accidente en Valle Ammen.‡Consigue 8 viales de sangre de polilla del valle y llévaselos a Proenitus a Lugar del Accidente en Valle Ammen.‡Extraire 8 Fioles de sang de phalène sur les Phalènes du val, puis les rapporter à Proenitus, au Point d\'impact du val d\'Ammen.‡从附近的峡谷蛾身上收集8瓶蛾血，然后向埃门谷坠毁点的普罗尼图斯复命。‡從附近的安曼谷飛蛾身上取得8瓶飛蛾血清，再回到安曼谷失事地點的波尼特斯那裡。',
  }
},
[9370] = {
  {
    'A purificação deve ser interrompida‡Остановить очищение‡Stoppt das Säuberungsritual‡정화 의식 저지‡Detengamos la purificación‡Detengamos la purificación‡Il faut arrêter la purification‡阻止净化‡阻止淨化',
    nil,
    'Coloque a Gema da Sinalização perto do Altar de Aggonar, nos Poços de Aggonar, e derrote os anacoretas draenei que aparecerem. Leve a Gema da Sinalização para Ryathen, o Lúgubre, na Vigília do Falcão, quando completar a tarefa.‡Поставьте сигнальный самоцвет на алтарь Аггонара, рядом с прудами Аггонара, и уничтожьте дренейского анахорета и всех, кто явится на сигнал. После выполнения задания заберите самоцвет и возвращайтесь к Риатену Мрачному в Соколиный дозор.‡Platziert den Signalstein bei den Teichen von Aggonar am Altar von Aggonar und besiegt alle Anachoreten der Draenei, die auf Eure Signal reagieren. Kehrt anschließend mit dem Signalstein zu Ryathen dem Düsteren bei der Falkenwacht zurück.‡아고나르의 웅덩이에 있는 아고나르의 제단에 신호의 보석을 놓은 후, 소환에 반응하는 모든 드레나이 수도사를 처치하십시오. 임무를 마친 다음 신호의 보석을 가지고 매의 감시탑에 있는 고뇌하는 리아센에게 돌아가야 합니다.‡Coloca la gema de señalización cerca del Altar de Aggonar en las Pozas de Aggonar y derrota a los anacoretas draenei que respondan a tu invocación. Luego lleva la gema a Ryathen el Sombrío a la Avanzada del Halcón.‡Coloca la gema de señalización cerca del Altar de Aggonar en las Pozas de Aggonar y derrota a los anacoretas draenei que respondan a tu invocación. Luego lleva la gema a Ryathen el Sombrío a la Avanzada del Halcón.‡Placez la Gemme de signalisation près de l\'autel d\'Aggonar, aux bassins d\'Aggonar, et triomphez de tous les anachorètes draeneï qui répondront à vos invocations. Retournez voir Ryathen le Sombre au Guet de l\'épervier avec la Gemme de signalisation quand vous en aurez terminé.‡前往阿苟纳之池，将信号宝石放置在阿苟纳祭坛附近，击败被召唤出来的德莱尼学者。完成任务后返回猎鹰岗哨，将信号宝石交还给阴沉的利亚森。‡前往阿葛納爾之池，將德萊尼信號寶石放在阿葛納爾祭壇附近，擊敗任何回應你召喚的德萊尼隱士。完成後帶著信號寶石回到獵鷹哨站的『憂鬱者』瑞安登那裡。',
  }
},
[9371] = {
  {
    'A botânica Taerix‡Ботаник Таэрикс‡Botanikerin Taerix‡식물학자 태릭스 찾기‡La botánica Taerix‡La botánica Taerix‡La botaniste Taerix‡植物学家塔蕾克丝‡植物學家泰瑞茲',
    nil,
    'Fale com a Botânica Taerix, no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с ботаником Таэрикс на месте крушения в долине Аммен.‡Sprecht mit Botanikerin Taerix bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 식물학자 태릭스와 대화해야 합니다.‡Habla con la botánica Taerix en el Lugar del Accidente en el Valle Ammen.‡Habla con la botánica Taerix en el Lugar del Accidente en el Valle Ammen.‡Parlez à la botaniste Taerix au Point d\'impact dans le val d\'Ammen.‡与埃门谷坠毁点的植物学家塔蕾克丝谈一谈。‡和安曼谷失事地點的植物學家泰瑞茲談談。',
  }
},
[9372] = {
  {
    'Contaminação demoníaca‡Распространение демонической скверны‡Dämonische Verderbnis‡악마의 오염‡Contaminación demoníaca‡Contaminación demoníaca‡Contamination démoniaque‡恶魔的玷污‡惡魔污染',
    nil,
    'Tiá Juba Rubra, no Posto Cenariano, na Península Fogo do Inferno, quer que você colete 6 Amostras de Sangue de Javiltusco dos Javiltuscos Parrudos.‡Соберите 6 образцов крови зловепря у крупных зловепрей по просьбе Тии Рыжей Гривы с Кенарийской заставы на полуострове Адского Пламени.‡Thiah Rotmähne im Posten des Cenarius auf der Höllenfeuerhalbinsel möchte, dass Ihr 6 Blutproben eines Höllenebers von bulligen Höllenebern sammelt.‡지옥불 반도의 세나리온 초소에 있는 타이아 레드메인이 덩치 큰 지옥멧돼지로부터 지옥멧돼지 혈액 견본 6개를 가져다달라고 부탁했습니다.‡Thiah Melenarroja en el Puesto Cenarion, en la Península del Fuego Infernal, te ha pedido que consigas 6 muestras de sangre de jabinfernos de los jabinfernos descomunales.‡Thiah Melenarroja en el Puesto Cenarion, en la Península del Fuego Infernal, te ha pedido que consigas 6 muestras de sangre de jabinfernos de los jabinfernos descomunales.‡Thiah Crin-rouge, du Poste cénarien dans la péninsule des Flammes infernales, vous a demandé de récupérer 6 Échantillons de sang de sanglier infernal sur des Sangliers infernaux massifs.‡地狱火半岛塞纳里奥哨站的塞安·红鬃要你从笨拙的地狱野猪身上收集6份地狱野猪血样。‡地獄火半島上塞納里奧前哨的塞伊亞·紅髮要你從笨重的地獄野豬身上收集6份地獄野豬血的樣本。',
  }
},
[9373] = {
  {
    'Sumário sumido‡Потерянное послание‡Fehlender Schriftverkehr‡사라진 공문‡Carta perdida‡Carta perdida‡La missive manquante‡遗失的信件‡丟失的公文',
    nil,
    'Entregue a Pasta de Couro Corroída para Tiá Juba Rubra, que está acampada perto das Ruínas de Sha\'naar na parte ocidental da Península Fogo do Inferno.‡Доставьте подпорченный кожаный чехол Тие Рыжей Гриве, которая стоит лагерем рядом с руинами Ша\'наара на западе полуострова Адского Пламени.‡Bringt den zerfressenen Lederkoffer zu Thiah Rotmähne in der Nähe der Ruinen von Sha\'naar im westlichen Teil der Höllenfeuerhalbinsel.‡지옥불 반도의 서쪽의 샤나르 폐허 근처에서 야영을 하고 있는 타이아 레드메인에게 부식된 가죽 용기를 가져가야 합니다.‡Llévale el estuche de cuero erosionado a Thiah Melenarroja, que está acampado cerca de las Ruinas de Sha\'naar, al oeste de la Península del Fuego Infernal.‡Llévale el estuche de cuero erosionado a Thiah Melenarroja, que está acampado cerca de las Ruinas de Sha\'naar, al oeste de la Península del Fuego Infernal.‡Remettre l\'Etui en cuir rongé à Thiah Crin-rouge, qui campe près des ruines de Sha\'naar, dans l\'ouest de la péninsule des Flammes infernales.‡前往地狱火半岛西部的沙纳尔废墟，将被腐蚀的皮箱交给驻扎在废墟附近的塞安·红鬃。‡將磨損的皮箱交給塞伊亞·紅髮，他紮營在靠近西地獄火半島的夏納廢墟。',
  }
},
[9374] = {
  {
    'O diário de Arelion‡Записи Арелиона‡Arelions Tagebuch‡아렐리온의 일지‡El diario de Arelion‡El diario de Arelion‡Le journal d\'Arelion‡埃雷利恩的日记‡阿利恩的日記',
    nil,
    'A Magistra Carinda, na Vigília do Falcão, que fica na Península Fogo do Inferno, quer que você vá até os Poços de Aggonar e resgate o Diário de Arelion.‡Отправляйтесь к прудам Аггонара и найдите записи Арелиона по просьбе магистра Каринды из Соколиного дозора на полуострове Адского Пламени.‡Magistrix Carinda bei der Falkenwacht auf der Höllenfeuerhalbinsel möchte, dass Ihr zu den Teichen von Aggonar reist und Arelions Tagebuch sucht.‡지옥불 반도의 매의 감시탑에 있는 마법학자 카린다가 아고나르의 웅덩이로 가서 아렐리온의 일지를 되찾아 달라고 부탁했습니다.‡La magistrix Carinda de la Avanzada del Halcón en la Península del Fuego Infernal quiere que vayas a las Pozas de Aggonar y recuperes el diario de Arelion.‡La magistrix Carinda de la Avanzada del Halcón en la Península del Fuego Infernal quiere que vayas a las Pozas de Aggonar y recuperes el diario de Arelion.‡La magistrice Carinda, au Guet de l\'épervier de la péninsule des Flammes infernales, veut que vous vous rendiez aux bassins d\'Aggonar pour y récupérer le Journal d\'Arelion.‡地狱火半岛猎鹰岗哨的魔导师卡尔琳达要你前往阿苟纳之池，找回埃雷利恩的日记。‡地獄火半島，獵鷹哨站的博學者卡莉達要你去阿葛納爾之池取得阿利恩的日記。',
  }
},
[9375] = {
  {
    'A estrada para a Vigília do Falcão‡Дорога к Соколиному дозору‡Der Weg zur Falkenwacht‡매의 감시탑으로 호위‡Hacia la Avanzada del Halcón‡Hacia la Avanzada del Halcón‡La route du Guet de l\'épervier‡猎鹰岗哨之路‡通往獵鷹哨站的路',
    nil,
    'Proteja a Peregrina Elfa Sangrenta Ferida em sua jornada até a Vigília do Falcão, e então apresente-se a Taleris Miralba.‡Помогите израненной эльфийке крови – пилигриму добраться до Соколиного дозора, затем поговорите с Талерисом Созерцателем Рассвета.‡Beschützt die verwundete Blutelfenpilgerin auf Ihrem Weg zur Falkenwacht und sprecht dann mit Taleris Morgenblick.‡매의 감시탑까지 부상당한 블러드 엘프 순례자를 호위한 후, 탈레리스 돈게이저와 대화해야 합니다.‡Protege a la peregrina elfa de sangre herida en su viaje a la Avanzada del Halcón, luego habla con Taleris Observalba.‡Protege a la peregrina elfa de sangre herida en su viaje a la Avanzada del Halcón, luego habla con Taleris Observalba.‡Protégez le Pèlerin elfe de sang blessé sur la route du Guet de l\'épervier, puis parlez à Taleris Mirelaube.‡护送受伤的血精灵朝圣者返回猎鹰岗哨，然后与塔雷里斯·晨光谈一谈。‡保護受傷的血精靈朝聖者前往獵鷹哨站，然後與達勒利斯·曦凝交談。',
  }
},
[9376] = {
  {
    'Os apuros da peregrina‡Скарб пилигрима‡Die Pflicht eines Pilgers‡순례자의 잃어버린 짐‡Una peregrina afligida‡Una peregrina afligida‡Les souffrances du pèlerin‡朝圣者的困境‡朝聖者的困境',
    nil,
    'A Peregrina Elfa Sangrenta Ferida foi atacada por Assoladores Presicerdos ao acampar na Ravina do Pó de Espinheiro. Encontre o acampamento da peregrina e procure pela mochila perdida.‡Перозубые опустошители напали на израненную эльфийку крови – пилигрима, когда она остановилась в Лощине Пыльного Пера. Разыщите ее стоянку и потерянные вещи.‡Die verletzte Blutelfpilgerin wurde von giftigen Stachelklauenfelshetzern angegriffen, als sie die Staubstachelschlucht erkunden wollte. Findet ihr Lager und haltet nach dem vermissten Beutel Ausschau.‡부상당한 블러드 엘프 순례자가 먼지깃 협곡에서 야영할 때 깃송곳니 갈퀴발톱에게 공격받았습니다. 그녀의 야영지를 찾아서 잃어버린 짐이 있는지 수색해봐야 합니다.‡A la peregrina elfa de sangre herida la atacaron los devastadores jabacolmillo cuando deambulaba por el Barranco Pluma Polvorienta. Encuentra los devastadores y mátalos hasta que recuperes la talega desaparecida de la peregrina.‡A la peregrina elfa de sangre herida la atacaron los devastadores jabacolmillo cuando deambulaba por el Barranco Pluma Polvorienta. Encuentra los devastadores y mátalos hasta que recuperes la talega desaparecida de la peregrina.‡Le Pèlerin elfe de sang blessé a été attaqué par des Ravageurs Plumecroc alors qu\'il se trouvait dans le ravin de Plumepoussière. Trouvez son campement et fouillez-le à la recherche de son sac manquant.‡受伤的血精灵朝圣者在尘羽峡谷宿营时遭到了钢牙掠食者的袭击。前往那处营地寻找丢失的背包。‡那個受傷的血精靈朝聖者在塵羽峽谷紮營時遭到惡毒的劫毀者攻擊。找到她的營地並尋找朝聖者丟失的背包。',
  }
},
[9377] = {
  {
    'Sede de poder‡Жажда магической силы‡Hunger nach Macht‡마력에 대한 갈증‡Sed de poder‡Sed de poder‡Assoiffés de puissance‡渴望力量‡渴望力量',
    nil,
    'Colete uma Essência Potente de Emissário do Caos de um Emissário do Caos Vingativo e leve-a para Taleris Miralba, na Vigília do Falcão.‡Извлеките мощную сущность демона Бездны из мстительных демонов Бездны и возвращайтесь к Талерису Созерцателю Рассвета в Соколиный дозор.‡Beschafft eine potente Leerwandleressenz von den unkontrollierten Leerwandlern und kehrt anschließend zu Taleris Morgenblick in der Falkenwacht zurück.‡복수심에 불타는 보이드워커로부터 강력한 보이드워커 정수를 구한 후에 매의 감시탑에 있는 탈레리스 돈게이저에게 돌아가야 합니다.‡Recupera 1 esencia potente de abisario de los abisarios vengativos y ve a ver a Taleris Observalba a la Avanzada del Halcón.‡Recupera 1 esencia potente de abisario de los abisarios vengativos y ve a ver a Taleris Observalba a la Avanzada del Halcón.‡Récupérez une Essence de marcheur du Vide puissante sur l\'un des Marcheurs du vide vengeurs, puis retournez voir Taleris Mirelaube au Guet de l\'épervier.‡从虚空行者身上收集1份强大的虚空行者精华，将其交给猎鹰岗哨的塔雷里斯·晨光。‡復仇心重的虛無行者身上取得一份高效虛無行者精華再回到獵鷹哨站找達勒利斯·曦凝。',
  }
},
[9378] = {
  {
    '‡DND FLAG Цитадель ужаса – Наксрамас‡Die Zitadelle des Schreckens - Naxxramas‡공포의 요새 낙스라마스‡DND FLAG La ciudadela del terror: Naxxramas‡DND FLAG La ciudadela del terror: Naxxramas‡DND FLAG Naxxramas, la citadelle de l\'effroi‡恐怖之城，纳克萨玛斯‡驚懼城塞 - 納克薩瑪斯',
    nil,
    '‡Верховный маг Анджела Досантос из Часовни Последней Надежды, что в Восточных Чумных землях, готова бесплатно наложить на вас заклинание чародейского покрова. Сначала добейтесь того, чтобы вас превозносили в Серебряном Рассвете.‡Erzmagierin Angela Dosantos bei der Kapelle des Hoffnungsvollen Lichts in den Östlichen Pestländern wird Euch die arkane Tarnung kostenfrei gewähren. Euer Ruf bei der Argentumdämmerung muss ehrfürchtig sein.‡동부 역병지대의 희망의 빛 예배당에 있는 대마법사 안젤라 도산토스가 비전 은신 마법으로 낙스라마스로 들어갈 수 있도록 해 줄 것입니다. 은빛 여명회의 평판이 확고한 동맹이어야 합니다.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡La archimaga Angela Dosantos de la Capilla de la Esperanza de la Luz, en las Tierras de la Peste del Este, se ofrece a costear tu velo Arcano. Debes ser Exaltado con El Alba Argenta.‡L\'archimage Angela Dosantos à la chapelle de l\'Espoir de Lumière dans les Maleterres de l\'Est vous accordera gratuitement l\'Occultation arcanique. Vous devez être $GExalté:Exaltée; auprès de l\'Aube d\'argent.‡东瘟疫之地圣光之愿礼拜堂的大法师安琪拉·多桑杜将免费给你秘法掩护。你一定要在银色黎明达到崇拜声望。‡',
  }
},
[9379] = {
  {
    'Fortificando o caçador vil‡Укрепить охотника Скверны‡Stärkt den Teufelsjäger‡지옥사냥개의 활력 강화‡Fortalecer al manáfago‡Fortalecer al manáfago‡Renforcer le chasseur corrompu‡地狱猎犬的补品‡強化惡魔獵犬',
    nil,
    'Colete 6 Sangues de Cão de Dimensional e leve tudo para Ângela Francelho, "a Garra", em Thrallmar.‡Соберите 6 образцов крови астральной гончей и принесите их Анджеле "Коготь" Кестрел в Траллмар.‡Sammelt 6 Einheiten Sphärenhundblut und bringt sie zu Angela "Die Klaue" Kestrel in Thrallmar.‡황천의 사냥개 피 6병을 모은 후 스랄마에 있는 "갈퀴발톱" 안젤라 케스트렐에게 가져가야 합니다.‡Recolecta 6 unidades de sangre de can de distorsión y llévaselas a Angela "La Garra" Kestrel en Thrallmar.‡Recolecta 6 unidades de sangre de can de distorsión y llévaselas a Angela "La Garra" Kestrel en Thrallmar.‡Récupérez 6 doses de Sang de molosse dimensionnel et remettez-les à Angela "la Griffe" Kestrel à Thrallmar.‡将6份迁跃猎犬之血交给萨尔玛的"利爪"安吉拉·凯斯提尔。‡收集6份地獄獵犬血給索爾瑪的『大爪』安琪拉·凱斯卓。',
  }
},
[9380] = {
  {
    'No mato sem cachorro‡В погоне за большим‡Die Hatz nach mehr‡박물관 전시물‡A seguir cazando canes‡A seguir cazando canes‡La multiplication des molosses‡群居的猎犬‡供不應求',
    nil,
    'Pegue 6 Cadáveres Intactos de Cão Dimensional e traga tudo de volta para o Prospector Murantus na Fortaleza da Honra.‡Соберите 6 неповрежденных трупов астральных гончих и доставьте в Оплот Чести геологу Мурантусу.‡Beschafft 6 unversehrte Sphärenhundkadaver und bringt sie zu Ausgrabungsleiter Murantus in der Ehrenfeste.‡손상되지 않은 황천의 사냥개 시체 6개를 모은 후 명예의 요새에 있는 발굴조사단장 무란투스에게 가져가야 합니다.‡Reúne 6 cadáveres de can distorsionado intactos y llévaselos al prospector Murantus en el Bastión del Honor.‡Reúne 6 cadáveres de can distorsionado intactos y llévaselos al prospector Murantus en el Bastión del Honor.‡Récupérer 6 Cadavres de molosses dimensionnels intacts et les remettre au prospecteur Murantus au bastion de l\'Honneur.‡将6只完整的迁跃猎犬尸体交给荣耀堡的勘探员穆拉图斯。‡收集6個完整的地獄獵犬屍體並帶給榮譽堡的勘察員穆蘭特斯。',
  }
},
[9381] = {
  {
    'Flechas voo-certo‡Стрелы, бьющие без промаха‡Treffsichere Pfeile‡명궁의 화살‡Esas flechas sí que vuelan‡Esas flechas sí que vuelan‡Les flèches infaillibles‡箭矢之羽‡真禽之箭',
    nil,
    'Colete 8 Penas da Cauda de Limpa-ossos e leve-as para Falcoeira Drena Fluminéola na Vigília do Falcão.‡Принесите 8 хвостовых перьев стервятника-костеклюя сокольничему Дренне Речной Ветер в Соколиный дозор.‡Sammelt 8 Schwanzfedern eines Knochenhäuters von den Knochenhäutergeiern und bringt sie Falknerin Drenna Flusswind in der Falkenwacht.‡뼈갈이식인독수리로부터 뼈갈이식인독수리 꼬리 깃털 8개를 모은 후 매의 감시탑에 있는 매부리 드렌나 리버윈드에게 가져가야 합니다.‡Recolecta 8 plumas de cola de limpiahuesos de buitres limpiahuesos y llévaselos a la halconera Drenna Ríobrisa Avanzada del Halcón.‡Recolecta 8 plumas de cola de limpiahuesos de buitres limpiahuesos y llévaselos a la halconera Drenna Ríobrisa Avanzada del Halcón.‡Récupérez 8 Plumes de queue de gratte-les-os sur des vautours Gratte-les-os, et remettez-les au fauconnier Drenna Ruissevent du Guet de l\'épervier.‡从啄骨秃鹫身上收集8片啄骨秃鹰的尾羽，把它们交给猎鹰岗哨的驯鹰者德蕾娜·河风。‡從剃骨禿鷹身上收集8根剃骨尾羽，交給獵鷹哨站的鷹獵者崔娜·河風。',
  }
},
[9382] = {
  {
    '‡Жестокий рок копытня‡Das Schicksal der Grollhufe‡‡El sino de los uñagrietas‡El sino de los uñagrietas‡Le sort des sabots-fourchus‡裂蹄的命运‡',
    nil,
    '‡Убейте 15 щетинистых копытней и возвращайтесь к Амаану Мудрейшему в Храм Телхамата.‡Tötet 15 borstige Grollhufe und kehrt dann zu Amaan dem Weisen im Tempel von Telhamat zurück.‡‡Mata a 15 uñagrietas lomohirsutos y regresa junto a Amaan el Sabio en el Templo de Telhamat.‡Mata a 15 uñagrietas lomohirsutos y regresa junto a Amaan el Sabio en el Templo de Telhamat.‡Tuer 15 Sabots-fourchus poil-hirsute, puis retourner voir Amaan le sage au temple de Telhamat.‡‡',
  }
},
[9383] = {
  {
    'Um plano ambicioso‡Честолюбивый план‡Ein gewagter Plan‡야심찬 계획‡Un plan ambicioso‡Un plan ambicioso‡Un plan ambitieux‡艰巨的计划‡野心勃勃的計畫',
    nil,
    'Use o Cristal Santificado em um Emissário do Caos Descontrolado e apresente-se a Elsaana no Templo de Telhamat.‡Используйте освященный кристалл против раненого неконтролируемого демона Бездны, затем возвращайтесь к Элсаане в храм Телхамат.‡Wendet den geweihten Kristall auf einen verwundeten unkontrollierten Leerwandler an. Kehrt anschließend zu Elsaana beim Tempel von Telhamat zurück.‡구속이 풀린 보이드워커에게 정화의 수정을 사용한 후, 텔하마트 사원에 있는 엘사아나에게 돌아가야 합니다.‡Usa el cristal santificado contra un abisario sin control herido y ve a ver a Elsaana al Templo de Telhamat.‡Usa el cristal santificado contra un abisario sin control herido y ve a ver a Elsaana al Templo de Telhamat.‡Utilisez le Cristal sanctifié sur un marcheur du Vide incontrôlé blessé, puis retournez voir Elsaana au temple de Telhamat.‡在失控的虚空行者受伤之后对其使用净化水晶，然后返回塔哈玛特神殿向艾尔萨娜复命。‡對已受傷且無法控制的虛無行者使用沐聖水晶再回到特爾哈曼神廟找伊莎安娜。',
  }
},
[9384] = {
  {
    '<NYI>Harnessing the Light‡<NYI>Harnessing the Light‡<NYI>Harnessing the Light‡‡<NYI>Harnessing the Light‡<NYI>Harnessing the Light‡<NYI>Harnessing the Light‡<NYI>Harnessing the Light‡<NYI>Harnessing the Light',
    nil,
    'Take the Glowing Sanctified Crystal to Rumatu at the Temple of Sha\'naar, who will invoke the Light to smite the demon within.‡Отнесите сияющий освященный кристалл Румату в храм Шанаара, чтобы он вознес молитвы Свету и уничтожил демона.‡Bringt den leuchtenden geweihten Kristall zu Rumatu beim Tempel von Sha\'naar, damit er den darin eingeschlossenen Dämon mit den Kräften des Lichts zerschlagen kann.‡‡Llévale el cristal santificado resplandeciente a Rumatu al Templo de Sha\'naar. Rumatu invocará a la Luz para destruir a los demonios que hay dentro del cristal.‡Llévale el cristal santificado resplandeciente a Rumatu al Templo de Sha\'naar. Rumatu invocará a la Luz para destruir a los demonios que hay dentro del cristal.‡Apportez le Cristal sanctifié luminescent à Rumatu, au temple de Sha\'naar, qui invoquera la Lumière pour détruire le démon qui se trouve à l\'intérieur.‡将闪光的净化水晶交给沙纳尔神殿的鲁玛图，他会利用圣光的力量来摧毁水晶中的虚空行者。‡把發光的沐聖水晶帶給莎納神殿的魯瑪圖，他會召喚聖光讓裡面的惡魔毀滅。',
  }
},
[9385] = {
  {
    'Assoladores assaltantes‡Разъяренные Опустошители‡Tobende Felshetzer‡광포한 갈퀴발톱‡Devastadores descontrolados‡Devastadores descontrolados‡Les ravageurs déchaînés‡钢牙掠食者‡消滅劫毀者',
    nil,
    'Mate 10 Assoladores Presicerdos e fale novamente com Gremni Barbalonga na Península Fogo do Inferno.‡Убейте 10 перозубых опустошителей и возвращайтесь к Гремни Длиннобороду на полуострове Адского Пламени.‡Tötet 10 Stachelklauenfelshetzer und kehrt anschließend zu Gremni Langbart auf der Höllenfeuerhalbinsel zurück.‡깃송곳니 갈퀴발톱 10마리를 처치한 다음 지옥불 반도에 있는 그렘니 롱비어드에게 돌아가야 합니다.‡Mata 10 devastadores jabacolmillo y ve a ver a Gremni Barbalarga a la Península del Fuego Infernal.‡Mata 10 devastadores jabacolmillo y ve a ver a Gremni Barbalarga a la Península del Fuego Infernal.‡Tuez 10 Ravageurs Plumecroc et retournez voir Gremni Barbe-longue dans la péninsule des Flammes infernales.‡杀死10只钢牙掠食者，然后向地狱火半岛的格雷尼·长须复命。‡殺死10個惡毒的劫毀者後回到地獄火半島找葛明尼·長鬚。',
  }
},
[9386] = {
  {
    '‡Свет в темных местах‡Licht im Dunkeln‡어둠을 밝히는 한 줄기 빛‡Una luz en la oscuridad‡Una luz en la oscuridad‡Une Lumière au sein des ombres‡黑暗中的光明‡黑暗中的光明',
    nil,
    '‡Найдите костры, размещенные в Пике Черной горы, Забытом Городе, Некроситете и Стратхольме и коснитесь их; затем поговорите с хранителем праздничного пламени.‡Findet und berührt die Freudenfeuer innerhalb der Schwarzfelsspitze, dem Düsterbruch, Scholomance und Stratholme. Sprecht dann mit dem Flammenbewahrer.‡‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme, y ve a ver al guardián de la llama del Festival.‡Toca las hogueras de Cumbre de Roca Negra, La Masacre, Scholomance y Stratholme, y ve a ver al guardián de la llama del Festival.‡Trouvez et touchez les feux de joie situés au pic Rochenoire, à Hache-Tripes, dans la Scholomance et à Stratholme, puis parlez au gardien des flammes de la fête.‡找到并碰触在黑石塔、厄运之槌、通灵学院和斯坦索姆内的火盆，并回到节日护火者处。‡',
  }
},
[9387] = {
  {
    'Fonte de corrupção‡Источник порчи‡Die Quelle der Verderbtheit‡오염의 원인‡El origen de la corrupción‡El origen de la corrupción‡La source de la corruption‡堕落之源‡腐敗根源',
    nil,
    'Vá às Ruínas de Sha\'naar, na Península Fogo do Inferno, e obtenha 5 Essências Demoníacas dos Capatazes Illidari. Fale novamente com o Boticário Azevedo na Vigília do Falcão quando completar a tarefa.‡Отправляйтесь в руины Ша\'наара на полуострове Адского Пламени и добудьте из иллидари-надсмотрщиков 5 демонических сущностей. После завершения задания возвращайтесь к аптекарю Азетену в Соколиный дозор.‡Reist zu den Ruinen von Sha\'naar auf der Höllenfeuerhalbinsel und besorgt 5 dämonische Essenzen von den Zuchtmeistern der Illidari. Kehrt zu Apotheker Azethen in der Falkenwacht zurück, wenn Ihr die Aufgabe erfüllt habt.‡지옥불 반도에 있는 샤나르 폐허로 가서 일리다리 감독관이 가지고 있는 악마의 정수 5개를 획득해야 합니다. 일을 마친 후 매의 감시탑에 있는 연금술사 아제센에게 돌아가십시오.‡Viaja a las Ruinas de Sha\'naar en la Península del Fuego Infernal y consigue 5 esencias demoníacas de los capataces Illidari. Vuelve a ver al boticario Azethen a la Avanzada del Halcón cuando hayas completado la tarea.‡Viaja a las Ruinas de Sha\'naar en la Península del Fuego Infernal y consigue 5 esencias demoníacas de los capataces Illidari. Vuelve a ver al boticario Azethen a la Avanzada del Halcón cuando hayas completado la tarea.‡Allez aux ruines de Sha\'naar, dans la péninsule des Flammes infernales, et obtenez 5 Essences démoniaques sur les Sous-chefs illidari. Retournez voir l\'apothicaire Azethen au Guet de l\'épervier une fois ce travail terminé.‡前往地狱火半岛的沙纳尔废墟，从伊利达雷监工身上收集5个恶魔精华。完成任务后返回猎鹰岗哨，向药剂师艾瑟森复命。‡前往地獄火半島的夏納廢墟從伊利達瑞監工身上取得5個惡魔精華。完成任務後回到獵鷹哨站找藥劑師艾斯隆。',
  }
},
[9388] = {
  {
    'As chamas tremeluzentes de Kalimdor‡Мерцающие огни Калимдора‡Lodernde Flammen in Kalimdor‡칼림도어의 희미한 불꽃‡La oscilación de las llamas de Kalimdor‡La oscilación de las llamas de Kalimdor‡Flammes vacillantes en Kalimdor‡卡利姆多的火焰‡卡林多的閃爍火焰',
    nil,
    'Visite as fogueiras no Vale Gris, nos Sertões, na Costa Negra e na Cordilheira das Torres de Pedra. Em seguida, fale com o Guardachamas do Festival.‡Посетите праздничные костры в Ясеневом лесу, Степях, на Темных берегах и в Когтистых горах, затем поговорите с хранителем праздничного пламени.‡Sucht die Freudenfeuer im Eschental, dem Brachland, der Dunkelküste und dem Steinkrallengebirge auf. Sprecht anschließend mit dem Flammenbewahrer.‡잿빛 골짜기, 불모의 땅, 어둠의 해안, 돌발톱 산맥에 불꽃이 있는 장소를 방문한 다음 한여름 축제 불꽃지기를 찾아가 대화하십시오.‡Toca las hogueras de Vallefresno, Los Baldíos, Costa Oscura y Sierra Espolón y ve a ver al guardián de la llama del Festival.‡Toca las hogueras de Vallefresno, Los Baldíos, Costa Oscura y Sierra Espolón y ve a ver al guardián de la llama del Festival.‡Rendez-vous aux feux de joie d\'Orneval, des Tarides, de Sombrivage et des Serres-Rocheuses, puis parlez au Gardien des flammes de la fête.‡造访灰谷、贫瘠之地、黑海岸和石爪山的篝火堆，然后回来与节日护火者交谈。‡探勘梣谷，貧瘠之地，黑海岸，和石爪山脈的營火，再和節慶火焰管理者談談。',
  }
},
[9389] = {
  {
    'As chamas tremeluzentes dos Reinos do Leste‡Мерцающие огни Восточных королевств‡Lodernde Flammen in den östlichen Königreichen‡동부 왕국의 가물거리는 불꽃‡La oscilación de las llamas de los Reinos del Este‡La oscilación de las llamas de los Reinos del Este‡Flammes vacillantes dans les Royaumes de l\'est‡东部王国的火焰‡東部王國的閃爍火焰',
    nil,
    'Visite as fogueiras no Contraforte de Eira dos Montes, na Floresta de Pinhaprata, em Cerro Oeste e no Pantanal. Em seguida, fale com o Guardachamas do Festival.‡Посетите праздничные костры в предгорьях Хилсбрада, в Серебряном бору, Западном Крае и Болотине, затем поговорите с хранителем праздничного пламени.‡Sucht die Freudenfeuer im Vorgebirge des Hügellands, im Silberwald, in Westfall und dem Sumpfland auf. Sprecht anschließend mit dem Flammenbewahrer.‡힐스브래드 구릉지와 은빛소나무 숲, 서부 몰락지대와 저습지 내에 있는 화톳불을 찾은 후, 한여름 축제 불꽃지기와 대화해야 합니다.‡Ve a las hogueras de las Laderas de Trabalomas, el Bosque de Argénteos, los Páramos de Poniente y Los Humedales y habla con el guardián de la llama del Festival.‡Ve a las hogueras de las Laderas de Trabalomas, el Bosque de Argénteos, los Páramos de Poniente y Los Humedales y habla con el guardián de la llama del Festival.‡Rendez-vous aux feux de joie des contreforts de Hautebrande, de la forêt des Pins argentés, de la Marche de l\'ouest et des Paluns, puis parlez au Gardien des flammes de la fête.‡造访希尔斯布莱德丘陵、银松森林、西部荒野和湿地的篝火堆，然后回来与节日护火者交谈。‡探勘希爾斯布萊德丘陵，銀松森林，西部荒野，和濕地的營火，再和節慶火焰管理者談談。',
  }
},
[9390] = {
  {
    'À procura de Sedai‡Найти Седаи‡Die Suche nach Sedai‡세다이 찾기‡En busca de Sedai‡En busca de Sedai‡À la recherche de Sedaï‡寻找瑟丹‡尋找希戴',
    nil,
    'O Anacoreta Obaden quer que você procure pelo irmão dele, Sedai, a leste daqui, na Península Fogo do Inferno.‡Разыщите Седаи, брата анахорета Обадия. Седаи может находиться где-то поблизости, на востоке, на полуострове Адского Пламени.‡Anachoret Obadei möchte, dass Ihr östlich von hier auf der Höllenfeuerhalbinsel nach seinem Bruder Sedai Ausschau haltet.‡수도사 오베다이가 지옥불 반도의 동쪽 근처 어딘가에 있는 자신의 형제 세다이를 찾아 달라고 부탁했습니다.‡El anacoreta Obadei quiere que busques a su hermano, Sedai, al este de la Península del Fuego Infernal.‡El anacoreta Obadei quiere que busques a su hermano, Sedai, al este de la Península del Fuego Infernal.‡L\'anachorète Obadeï veut que vous partiez à la recherche de son frère Sedaï dans les alentours, vers l\'est, dans la péninsule des Flammes infernales.‡学者欧巴迪要你去塔哈玛特神殿东边附近的区域寻找他的兄弟瑟丹。‡隱士歐拜德要你去尋找他的兄弟，希戴，就在地獄火半島的東邊。',
  }
},
[9391] = {
  {
    'Marcando o caminho‡Осветить путь‡Den Weg kennzeichnen‡순례자들을 위한 길‡Iluminar el camino‡Iluminar el camino‡Jalonner le chemin‡点燃灯塔‡記下路徑',
    nil,
    'O Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, quer que você vá à Grande Fenda, na Península Fogo do Inferno, e acenda os Sinalizadores Sul, Oeste e Central. Traga a tocha acesa para ele ao completar a tarefa.‡Отправляйтесь к Глубокому разлому на полуострове Адского Пламени и зажгите южный маяк, западный маяк и центральный маяк. После выполнения задания возвращайтесь к капитану следопытов Венн\'рену из Соколиного дозора вместе с зажженным факелом.‡Waldläuferhauptmann Venn\'ren an der Falkenwacht möchte, dass Ihr auf der Höllenfeuerhalbinsel die große Kluft aufsucht und dort das südliche Leuchtsignal, westliche Leuchtsignal und das zentrale Leuchtsignal entzündet. Kehrt anschließend mit der brennenden Fackel zu ihm zurück.‡매의 감시탑에 있는 순찰대장 벤렌이 지옥불 반도에 있는 거대한 균열로 가서 남쪽 봉화, 서쪽 봉화, 중앙 봉화에 불을 붙여 달라고 부탁했습니다. 일을 마친 후 빛나는 횃불을 가지고 순찰대장 벤렌에게 돌아가야 합니다.‡El capitán forestal Venn\'ren de la Avanzada del Halcón quiere que vayas a La Gran Fisura en la Península del Fuego Infernal y enciendas la Baliza del Sur, la Baliza Occidental y la Baliza Central. Vuelve junto a él con la antorcha encendida después de completar esta tarea.‡El capitán forestal Venn\'ren de la Avanzada del Halcón quiere que vayas a La Gran Fisura en la Península del Fuego Infernal y enciendas la Baliza del Sur, la Baliza Occidental y la Baliza Central. Vuelve junto a él con la antorcha encendida después de completar esta tarea.‡Le capitaine des forestiers Venn\'ren, du Guet de l\'épervier, veut que vous alliez dans la Grande fissure de la péninsule des Flammes infernales et que vous allumiez la Balise du sud, la Balise de l\'ouest, et la Balise centrale. Retournez le voir avec la Torche allumée quand vous aurez accompli cette tâche.‡前往地狱火半岛的大裂隙，点燃南部灯塔、西部灯塔和中部灯塔。完成任务后返回猎鹰岗哨，将燃烧的火炬还给游侠队长维恩雷。‡獵鷹哨站的遊俠隊長范瑞要你前往地獄火半島的大裂縫點燃南方烽火臺、西方烽火臺和中央烽火臺。完成任務後帶著點燃的火炬回去找他。',
  }
},
[9392] = {
  {
    'Treinamento de ladino‡Обучение разбойника‡Ausbildung zum Schurken‡도적 훈련‡Entrenamiento de pícaros‡Entrenamiento de pícaros‡La formation de voleur‡潜行者训练‡盜賊訓練',
    nil,
    'Fale com o instrutor de ladinos Tocaiante Avokor na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставником разбойников налетчиком Авокором в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Pfadpirscher Avokor - dem Schurkenlehrer - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 도적 추적자 아보코르와 대화해야 합니다.‡Habla con el acechacaminos Avokor, el instructor de pícaros, en la Aguja del Sol en la Isla del Caminante del Sol.‡Habla con el acechacaminos Avokor, el instructor de pícaros, en la Aguja del Sol en la Isla del Caminante del Sol.‡Parler à l’éclaireur Avokor, le maître des voleurs, à l’intérieur de la Flèche solaire de l’île de Haut-soleil.‡与逐日岛太阳之塔内的寻路者阿沃科尔谈一谈。‡和巡路者阿沃寇 - 盜賊訓練師談談，他就在逐日者之島的日尖塔裡面。',
  }
},
[9393] = {
  {
    'Treinamento de caçador‡Обучение охотника‡Ausbildung zum Jäger‡사냥꾼 훈련‡Instrucción de cazador‡Instrucción de cazador‡La formation de chasseur‡猎人训练‡獵人訓練',
    nil,
    'Fale com a instrutora de caçadores Patrulheira Sallina na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с следопытом Саллиной в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Waldläuferin Sallina - der Jägerlehrerin - innerhalb des Sonnenturms auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 사냥꾼 순찰자 살리나와 대화해야 합니다.‡Habla con la forestal Sallina, la instructora de clase de cazadores, en La Aguja del Sol en la Isla del Caminante del Sol.‡Habla con la forestal Sallina, la instructora de clase de cazadores, en La Aguja del Sol en la Isla del Caminante del Sol.‡Parlez au forestier Sallina, le maître des chasseurs, à l\'intérieur de la Flèche solaire de l\'île de Haut-soleil.‡与逐日岛太阳之塔内的猎人训练师游侠萨琳娜谈一谈。‡和遊俠薩琳娜 - 獵人訓練師談談，她就在逐日者之島的日尖塔裡面。',
  }
},
[9394] = {
  {
    'Onde está Wyllithen?‡Куда подевался Виллитен?‡Wo ist Wyllithen?‡빌리덴을 찾아라‡¿Dónde está Wyllithen?‡¿Dónde está Wyllithen?‡Où est Wyllithen ?‡维林森去哪了？‡威利坦在哪裡?',
    nil,
    'Encontre o Jardineiro Wyllithen nas Terras do Ocaso, que ficam na Floresta do Canto Eterno.‡Найдите смотрителя Виллитена в землях Блеклых Сумерек, что в лесах Вечной Песни.‡Findet Grundbewahrer Wyllithen beim Nachtschimmergrund im Immersangwald.‡영원노래 숲의 더스크위더 정원에 있는 관리인 빌리덴을 찾아야 합니다.‡Encuentra al encargado Wyllithen en las Tierras Ocaso Marchito, en el Bosque Canción Eterna.‡Encuentra al encargado Wyllithen en las Tierras Ocaso Marchito, en el Bosque Canción Eterna.‡Retrouver le paysagiste Wyllithen sur les Terres de Ternesoir dans le bois des Chants éternels.‡前往永歌森林的达斯维瑟广场寻找看守者维林森。‡到永歌森林的暮萎營地尋找地面守衛者威利坦。',
  }
},
[9395] = {
  {
    'O Refúgio de Saltheril‡Вилла Салтерила‡Saltherils Hafen‡살데릴의 안식처‡El Refugio de Saltheril‡El Refugio de Saltheril‡Le havre de Saltheril‡萨瑟利尔庄园‡薩瑟里的避風港',
    nil,
    'Fale com o Lorde Saltheril no Refúgio de Saltheril, que fica na Floresta do Canto Eterno.‡Поговорите с лордом Салтерилом на вилле Салтерила в лесах Вечной Песни.‡Sprecht mit Lord Saltheril in Saltherils Hafen im Immersangwald.‡영원노래 숲의 살데릴의 안식처에 있는 살데릴 경과 대화해야 합니다.‡Ve a Refugio de Saltheril en el Bosque Canción Eterna y habla con Lord Saltheril.‡Ve a Refugio de Saltheril en el Bosque Canción Eterna y habla con Lord Saltheril.‡Parler au seigneur Saltheril au havre de Saltheril dans le bois des Chants éternels.‡与永歌森林萨瑟利尔庄园的萨瑟利尔男爵谈一谈。‡到永歌森林和薩瑟里的避風港的薩瑟里領主談談。',
  }
},
[9396] = {
  {
    'A magia dos arakkoas‡Магия араккоа‡Die Magie der Arakkoa‡아라코아의 마법‡La magia de los arakkoa‡La magia de los arakkoa‡La magie des arakkoa‡鸦人的魔法‡阿拉卡的魔法',
    nil,
    'Traga 4 Pergaminhos dos Haal\'eshi para o Arcanista Calesthris Aurestela, na Vigília do Falcão, que fica na Península Fogo do Inferno.‡Принесите 4 свитка племени Хаал\'эш чародею Калестрису Утренней Звезде в Соколиный дозор на полуострове Адского Пламени.‡Bringt 4 Rollen der Haal\'eshi zu Arkanist Calesthris Morgenstern bei der Falkenwacht auf der Höllenfeuerhalbinsel.‡지옥불 반도의 매의 감시탑에 있는 비전술사 케일스트리스 돈스타에게 하알에쉬 두루마리 4개를 가져가야 합니다.‡Ve a la Avanzada del Halcón, en la Península del Fuego Infernal, y llévale 4 pergaminos Haal\'eshi al arcanista Calesthris Estrella del Alba.‡Ve a la Avanzada del Halcón, en la Península del Fuego Infernal, y llévale 4 pergaminos Haal\'eshi al arcanista Calesthris Estrella del Alba.‡L\'arcaniste Calesthris Aubétoile, du Guet de l\'épervier de la péninsule des Flammes infernales, veut que vous lui rameniez 4 Parchemins haal\'eshi.‡将4个哈尔什卷轴交给地狱火半岛猎鹰岗哨的奥术师卡雷希斯·晨星。‡帶回4個海艾斯卷軸到地獄火半島給獵鷹哨站的秘法師卡拉崔斯·晨星。',
  }
},
[9397] = {
  {
    'Pássaro na mão‡Пух и перья‡Kommt ein Vogel geflogen‡유유상종‡En compañía de pájaros‡En compañía de pájaros‡Fermez, fermez la cage aux oiseaux‡捉小鸟‡稀有的鳥類',
    nil,
    'Vá ao Antro de Haal\'esh, na Península Fogo do Inferno, e encontre um Filhote de Kaliri Fêmea nos Ninhos de Kaliri. Use a Gaiola Vazia para capturá-lo e leve-o para a Falcoeira Drena Fluminéola, na Vigília do Falcão.‡Отправляйтесь в логово Хаал\'эш на полуострове Адского Пламени и найдите молодую самку калири в гнезде калири. Посадите птенца в пустую клетку и принесите сокольничему Дренне Речной Ветер в Соколиный дозор.‡Reist zum Haal\'eshbau auf der Höllenfeuerhalbinsel und durchsucht die Kalirinester nach einem jungen Kaliriweibchen. Benutzt den leeren Vogelkäfig, um es zu fangen, und kehrt anschließend zu Falknerin Drenna Flusswind in der Falkenwacht zurück.‡지옥불 반도에 있는 하알에쉬 소굴로 가서 칼리리 둥지를 뒤져 새끼 칼리리 암컷을 찾아야 합니다. 매의 감시탑에 있는 매부리 드렌나 리버윈드에게 빈 새장으로 암컷을 잡아 돌아가야 합니다.‡Ve a El Cubil de Haal\'esh en la Península del Fuego Infernal y busca en los nidos de kaliri una cría de kaliri hembra. Usa la jaula de pájaros vacía para capturarla y llévasela a la halconera Drenna Ríobrisa en la Avanzada del Halcón.‡Ve a El Cubil de Haal\'esh en la Península del Fuego Infernal y busca en los nidos de kaliri una cría de kaliri hembra. Usa la jaula de pájaros vacía para capturarla y llévasela a la halconera Drenna Ríobrisa en la Avanzada del Halcón.‡Rendez-vous à la tanière des Haal\'esh dans la péninsule des Flammes infernales et fouillez les nids de kaliris à la recherche d\'une Jeune femelle kaliri. Utilisez la Cage à oiseaux vide pour la capturer et apportez-la au fauconnier Drenna Ruissevent au Guet de l\'épervier.‡前往地狱火半岛的哈尔什巢穴，在卡利鸟巢穴中寻找雌性小卡利鸟。利用空鸟笼捕获雌性小卡利鸟，将其交给猎鹰岗哨的驯鹰者德蕾娜·河风。‡前往地獄火半島的海艾斯洞穴捕捉一隻母卡里瑞幼鳥。用這個空的鳥籠捉住她，完成這個任務後再回去找鷹獵者崔娜·河風。',
  }
},
[9398] = {
  {
    'Predadores mortais‡Смертельно опасные хищники‡Tödliche Raubtiere‡치명적인 약탈자들‡Depredadores letales‡Depredadores letales‡Prédateurs mortels‡致命的猎手‡痛恨的掠奪者',
    nil,
    'A Batedora Vanura, no Templo de Telhamat, que fica na Península Fogo do Inferno, quer que você mate 8 Filhotes Rasgálitas e 4 Rasgálitas Alfa.‡Убейте 8 детенышей камнеруба и 4 камнерубов-вожаков по просьбе разведчицы Вануры из храма Телхамат на полуострове Адского Пламени.‡Späher Vanura im Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr 8 Steinsichelwelpen und 4 Steinsichelalpha tötet.‡지옥불 반도의 텔하마트 사원에 있는 정찰병 바누라가 새끼 돌낫 바위갈퀴 8마리, 덩치 큰 돌낫 바위갈퀴 4마리를 처치해 달라고 부탁했습니다.‡La exploradora Vanura del Templo de Telhamat en la Península del Fuego Infernal quiere que mates 8 crías de guadaña de piedra y 4 alfas guadaña de piedra.‡La exploradora Vanura del Templo de Telhamat en la Península del Fuego Infernal quiere que mates 8 crías de guadaña de piedra y 4 alfas guadaña de piedra.‡L\'éclaireur Vanura du temple de Telhamat dans la péninsule des Flammes infernales veut que vous tuiez 8 Jeunes fauchepierre et 4 Alphas fauchepierre.‡地狱火半岛塔哈玛特神殿的斥候瓦努拉要你杀死8只石镰幼崽和4只石镰突击者。‡地獄火半島特爾哈曼神廟的斥候范路娜要你去殺死8個小石鐮掠奪者和4個石鐮突擊隊員。',
  }
},
[9399] = {
  {
    'Capatazes cruéis‡Безжалостные десятники‡Die Grausamkeit der Zuchtmeister‡잔인한 감독관‡Capataces crueles‡Capataces crueles‡De cruels sous-chefs‡残忍的监工‡殘酷的監工',
    nil,
    'Mate 4 Capatazes Illidari nas Ruínas de Sha\'naar e fale novamente com Ikan, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Убейте 4 иллидари-надсмотрщиков на руинах Ша\'наара и возвращайтесь к Икану в храм Телхамат на полуострове Адского Пламени.‡Reist zu den Ruinen von Sha\'naar und erschlagt 4 Zuchtmeister der Illidari. Kehrt anschließend zu Ikan zum Tempel von Telhamat auf der Höllenfeuerhalbinsel zurück.‡샤나르 폐허에 있는 일리다리 감독관 4명을 처치한 후, 지옥불 반도의 텔하마트 사원에 있는 이칸에게 돌아가야 합니다.‡Mata a 4 capataces de Illidari en las Ruinas de Sha\'naar y vuelve a ver a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Mata a 4 capataces de Illidari en las Ruinas de Sha\'naar y vuelve a ver a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Tuez 4 Sous-chefs illidari aux ruines de Sha\'naar, puis retournez voir Ikan au temple de Telhamat, dans la péninsule des Flammes infernales.‡前往沙纳尔废墟，杀死4名伊利达雷监工，然后向地狱火半岛塔哈玛特神殿的伊坎复命。‡到夏納廢墟殺死4名伊利達瑞監工，再回到地獄火半島的特爾哈曼神廟找依坎。',
  }
},
[9400] = {
  {
    'O assassino‡Убийца‡Der Assassine‡암살자 처치‡El asesino‡El asesino‡L\'assassin‡刺客‡刺客',
    nil,
    'Nazgrel quer que você viaje até a estrada ao norte da Cidadela Fogo do Inferno e encontre um assassino chamado Krun Quebra-espinhas.‡Ступайте по дороге к северу от цитадели Адского Пламени и разыщите убийцу по имени Крун Хребтолом по просьбе Назгрела.‡Nazgrel möchte, dass Ihr zu der Straße nördlich der Höllenfeuerzitadelle reist und nach einem Assassinen namens Krun Rückenbrecher Ausschau haltet.‡나즈그렐이 지옥불 성채의 북쪽 길로 가서 크룬 스파인브레이커라는 이름의 암살자를 찾아봐 달라고 부탁했습니다.‡Nazgrel quiere que vayas por la carretera al norte de la Ciudadela del Fuego Infernal en busca de un asesino llamado Krun Rompeloma.‡Nazgrel quiere que vayas por la carretera al norte de la Ciudadela del Fuego Infernal en busca de un asesino llamado Krun Rompeloma.‡Nazgrel veut que vous suiviez la route qui passe au nord de la citadelle des Flammes infernales, à la recherche d\'un assassin nommé Krun Brise-échine.‡纳兹格雷尔要求你到地狱火堡垒北方的道路附近寻找一个名叫克伦·断脊者的刺客。‡納茲格雷爾要你前往地獄火堡壘北邊的道路尋找一個叫克魯恩·斷脊氏族的刺客。',
  }
},
[9401] = {
  {
    'Uma estranha arma‡Странное оружие‡Eine seltsame Waffe‡이상한 무기‡Un arma inusual‡Un arma inusual‡Une arme étrange‡奇怪的武器‡奇怪的武器',
    nil,
    'Leve o Machado Pesado de Pedra para Nazgrel em Thrallmar, na Península Fogo do Inferno.‡Принесите тяжелый каменный топор Назгрелу в Траллмар на полуострове Адского Пламени.‡Bringt die schwere Steinaxt zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 무거운 돌도끼를 가져가야 합니다.‡Lleva el hacha de piedra pesada a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Lleva el hacha de piedra pesada a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Apportez la Hache lourde en pierre à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将重型石斧交给萨尔玛的纳兹格雷尔。‡將沉重的石斧帶到地獄火半島的索爾瑪交給納茲格雷爾。',
  }
},
[9402] = {
  {
    'Pega!‡Апорт!‡Fangt!‡가져와!‡¡Tráeme una cosita!‡¡Tráeme una cosita!‡Va chercher !‡捞瓶子‡去吧!',
    nil,
    'Mergulhe na Lagoa do Eterno Sussurro e recupere o Frasco Lazúli para o Instrutor Antheol.‡Нырните на дно пруда Тихого Шелеста и добудьте лазурный фиал для инструктора Антеола.‡Taucht auf den Grund des Stillwispertümpels und holt die Azurphiole für Instrukteur Antheol.‡잔잔한 속삭임 연못 바닥으로 잠수해서 하늘색 유리병을 찾아 스승 안시올에게 돌아가십시오.‡Bucea hasta el fondo de la Charca Plácido Susurro y recupera la ampolla azur para el instructor Antheol.‡Bucea hasta el fondo de la Charca Plácido Susurro y recupera la ampolla azur para el instructor Antheol.‡Nagez jusqu\'au fond de l\'étang des Murmures-sereins et récupérez la Fiole azur pour l\'instructeur Antheol.‡在萦语水池底部为指导者安瑟隆找到碧蓝瓶。‡潛入靜語池底為導師安西歐取得蒼藍之瓶。',
  }
},
[9403] = {
  {
    'A água mais pura‡Чистейшая вода‡Das reinste Wasser‡가장 순수한 물‡El agua más pura‡El agua más pura‡L\'eau pure‡最纯净的水‡純淨之水',
    nil,
    'O Instrutor Antheol quer que você encha o Frasco Lazúli na Cachoeira Elrendar.‡Наполните лазурный флакон водой из водопада Элрендар для Антеола.‡Instrukteur Antheol möchte, dass Ihr die Azurphiole bei den Elrendarfällen auffüllt.‡스승 안시올이 엘렌다르 폭포수로 하늘색 유리병을 채워달라고 부탁했습니다.‡El instructor Antheol quiere que llenes la ampolla azur en las Cascadas Elrendar.‡El instructor Antheol quiere que llenes la ampolla azur en las Cascadas Elrendar.‡L\'instructeur Antheol veut que vous remplissiez la Fiole azur aux chutes de l\'Elrendar.‡指导者安瑟隆希望你能在碧蓝瓶中装满艾伦达尔瀑布的水。‡導師安西歐要你去艾蘭達瀑布裝滿蒼藍之瓶。',
  }
},
[9404] = {
  {
    'Recém-viventes‡Живая ветка‡Noch lebendig‡생명의 가지‡Recientemente vivo‡Recientemente vivo‡Fraîchement coupée‡活动的树木‡適者生存',
    nil,
    'Mate Jardineiros de Canto Eterno até conseguir um Galho Vivo para o Instrutor Antheol.‡Убивайте хранителей лесов Вечной Песни, пока не найдете животворную ветвь для инструктора Антеола.‡Tötet die Immersangwaldbehüter bis Ihr einen lebendigen Zweig für Instrukteur Antheol findet.‡스승 안시올에게 가져갈 생명의 가지를 얻을 때까지 영원노래 숲지기들을 해치워야 합니다.‡Mata a los jardineros Canción Eterna hasta que entreguen una rama viva para el instructor Antheol.‡Mata a los jardineros Canción Eterna hasta que entreguen una rama viva para el instructor Antheol.‡Tuez les Gardes verts des Chants éternels jusqu\'à ce que vous trouviez une Branche vivante pour l\'instructeur Antheol.‡清理永歌护卫者，直至你找到指导者安瑟隆所需要的生命绿枝。‡殺死永歌森林守衛者直到找到完美的樹枝給導師安西歐。',
  }
},
[9405] = {
  {
    'O mandamento do Chefe Guerreiro‡Поручение Вождя‡Das Anliegen des Kriegshäuptlings‡대족장의 지령‡El mandato del Jefe de Guerra‡El mandato del Jefe de Guerra‡Le mandat du chef de guerre‡酋长的命令‡大酋長的命令',
    nil,
    'Leve o Machado Pesado de Pedra para a Clarividente Regulkut em Thrallmar, na Península Fogo do Inferno.‡Принесите тяжелый каменный топор провозвестнице Регулкут в Траллмар на полуострове Адского Пламени.‡Bringt die schwere Steinaxt zu Scharfseherin Regulkut in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 예언자 레굴쿠트에게 무거운 돌도끼를 가져가야 합니다.‡Lleva el hacha pesada de piedra al clarividente Regulkult a Thrallmar, en la Península del Fuego Infernal.‡Lleva el hacha pesada de piedra al clarividente Regulkult a Thrallmar, en la Península del Fuego Infernal.‡Apportez la Hache lourde en pierre à la prophétesse Regulkut, à Thrallmar dans la péninsule des Flammes infernales.‡将重型石斧交给萨尔玛的先知雷古库特。‡把沉重的石斧帶給在地獄火半島索爾瑪的先知瑞卡酷。',
  }
},
[9406] = {
  {
    'Os Mag\'har‡Маг\'хары‡Die Mag\'har‡마그하르‡Los Mag\'har‡Los Mag\'har‡Les Mag\'har‡玛格汉‡瑪格哈',
    nil,
    'Entregue a Carta dos Mag\'har para Nazgrel em Thrallmar, na Península Fogo do Inferno.‡Доставьте письмо маг\'харов Назгрелу в Траллмар на полуострове Адского Пламени.‡Bringt den Brief von den Mag\'har zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 마그하르로부터 온 편지를 전해야 합니다.‡Entrega la carta de los Mag\'har a Nazgrel en Thrallmar, en la Península del Fuego Infernal.‡Entrega la carta de los Mag\'har a Nazgrel en Thrallmar, en la Península del Fuego Infernal.‡Remettez la lettre des Mag\'har à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将玛格汉的来信送给萨尔玛的纳兹格雷尔。‡將來自瑪格哈的信送回地獄火半島給索爾瑪的納茲格雷爾。',
  }
},
[9407] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡어둠의 문 너머로‡A través de El Portal Oscuro‡A través de El Portal Oscuro‡À travers la Porte des ténèbres‡跨越黑暗之门‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e encontre o Tenente-general Órion. Ele espera sua chegada do outro lado, em Terralém.‡Пройдите через Темный портал и найдите генерал-лейтенанта Ориона. Он ждет вашего прибытия на другой стороне, в Запределье.‡Reist durch das Dunkle Portal und meldet Euch bei Generalleutnant Orion. Er erwartet Euch auf der anderen Seite - in der Scherbenwelt.‡어둠의 문으로 들어가서 문 반대편의 아웃랜드에서 당신의 도착을 기다리고 있는 부사령관 오리온을 찾아야 합니다.‡Ve hasta El Portal Oscuro y encuentra al teniente general Orion. Te aguarda en el otro lado, en Terrallende.|n‡Ve hasta El Portal Oscuro y encuentra al teniente general Orion. Te aguarda en el otro lado, en Terrallende.|n‡Traversez la Porte des ténèbres et allez trouver le général de division Orion. Il attend votre arrivée de l\'autre côté, en Outreterre.‡穿越黑暗之门，找到沃雷恩中将。他就在黑暗之门另一侧的外域等你。‡傳過黑暗之門找到歐萊恩中將。他在另外一邊等著你的到達，就在外域裡。',
  }
},
[9408] = {
  {
    'Heróis esquecidos‡Забытые герои‡Vergessene Helden‡잊혀진 영웅들‡Héroes olvidados‡Héroes olvidados‡Héros oubliés‡被遗忘的英雄‡被遺忘的英雄',
    nil,
    'Fale com o Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Поговорите с командиром армии Данатом Троллебоем в Оплоте Чести.‡Sprecht mit Truppenkommandant Danath Trollbann in der Ehrenfeste.‡명예의 요새에서 전투사령관 다나스 트롤베인과 대화해야 합니다.‡Habla con el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Habla con el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Parler au commandant Danath Trollemort au bastion de l\'Honneur.‡与荣耀堡的远征军指挥官达纳斯·托尔贝恩谈一谈。‡和榮譽堡的軍隊指揮者達納斯·托爾貝恩談談。',
  }
},
[9409] = {
  {
    'Entrega urgente!‡Срочная доставка‡Eilige Lieferung!‡긴급 배달!‡Entrega urgente‡Entrega urgente‡Livraison urgente‡紧急物资！‡緊急送件!',
    nil,
    'Entregue o Conjunto de Ampolas a Zalduun no Ponto de Impacto, que fica no Vale Ammen.‡Отнесите сверток с фиалами Залдууну на место крушения в долине Аммен.‡Bringt die Phiolensammlung zu Zalduun bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 잘둔에게 유리병이 든 가방을 가져가야 합니다.‡Entrega el juego de viales a Zalduun en el Lugar del Accidente en el Valle Ammen.‡Entrega el juego de viales a Zalduun en el Lugar del Accidente en el Valle Ammen.‡Livrer le Paquet de fioles à Zalduun au Point d\'impact du val d\'Ammen.‡将一组药水瓶交给埃门谷坠毁点的扎尔杜。‡將一捆瓶子送到安曼谷給失事地點的薩度恩。',
  }
},
[9410] = {
  {
    'Um guia espiritual‡Хранитель душ‡Spirituelle Führung‡정령 길잡이‡Un espíritu guía‡Un espíritu guía‡Un guide spirituel‡灵魂的指引‡精神指引',
    nil,
    'Use o Totem do Lobo no local em que você encontrou o corpo de Krun Quebra-espinha e siga o Lobo Espiritual Ancestral.‡Установите тотем духа волка на том месте, где вы нашли тело Круна Хребтолома. Когда появится дух древнего волка, следуйте за ним.‡Verwendet das Wolfstotem an dem Ort, wo Ihr Krun Rückenbrechers Leichnam gefunden habt und folgt dem Ahnengeistwolf.‡크룬 스파인브레이커의 시체를 발견한 장소에서 토템을 사용한 후, 고대의 늑대 정령을 따라가야 합니다.‡Usa el Tótem de lobo en el lugar donde encontraste el cuerpo de Krun Rompeloma y sigue al espíritu de lobo ancestral.‡Usa el Tótem de lobo en el lugar donde encontraste el cuerpo de Krun Rompeloma y sigue al espíritu de lobo ancestral.‡Utilisez le Totem du loup à l\'endroit où vous avez trouvé le corps de Krun Brise-échine et suivez l\'Esprit ancestral du loup.‡在你找到克伦·断脊者尸体的地方使用先祖狼魂图腾，并跟随先祖狼魂前进。‡在你到找克魯恩·斷脊氏族屍體的地點使用狼圖騰，然後跟著先祖之狼圖騰的靈魂。',
  }
},
[9411] = {
  {
    '<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages‡<UNUSED>Infused Bandages',
    nil,
    nil,
  }
},
[9412] = {
  {
    '<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge‡<UNUSED>Crystal Flake Throat Lozenge',
    nil,
    nil,
  }
},
[9413] = {
