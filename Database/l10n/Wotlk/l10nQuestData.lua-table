[12948] = {
  {
    'O campeão da Angústia‡Чемпион Амфитеатра Страданий‡Der Champion der Agonie‡고뇌의 용사 탄생‡El campeón de Angustia‡El campeón de angustia‡Le Champion de l\'Angoisse‡痛苦斗兽场的冠军‡苦痛勇士',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Vladof, o Carniceiro! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Владофа Мясника! Потом возвращайтесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Vladof den Metzger! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 도살자 블라도프와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Vladof el Carnicero! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Vladof el Carnicero! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez de Vladof le Boucher ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败屠夫乌拉多弗！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗『屠夫』伏雷多弗!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12949] = {
  {
    'Em busca da chave‡Ключ от кандалов‡Besorgt den Schlüssel‡열쇠를 찾아‡Consigue la llave‡Consigue la llave‡Récupérer la clé‡夺取钥匙‡取得鑰匙',
    nil,
    'Vaelen, o Esfolado, no Salão de Ufrang, pediu que você recupere a Chave das Correntes de Vaelen.‡Добудьте ключ от цепей Вэлена и отдайте его Вэлену Разоблаченному в Зале Уфранга.‡Vaelen der Geschundene in Ufranggs Halle hat Euch gebeten, den Schlüssel zu Vaelens Ketten zu besorgen.‡우프랑의 전당에 있는 고문당한 밸렌이 밸렌의 족쇄 열쇠를 구해달라고 부탁했습니다.‡Vaelen el Despellejado en la Sala de Ufrang te ha pedido que recuperes la llave de las cadenas de Vaelen.‡Vaelen el Despellejado en la Sala de Ufrang te ha pedido que recuperes la llave de las cadenas de Vaelen.‡Vaelen l\'Écorché dans la Salle d\'Ufrang vous a demandé de récupérer la Clé des chaînes de Vaelen.‡乌弗朗之厅里面的被折磨的维林要求你去夺取维林的锁链钥匙。‡烏弗蘭大廳裡被搶劫的維倫要你取得維倫鎖鍊的鑰匙。',
  }
},
[12950] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12951] = {
  {
    'Deixa o barão saber disso...‡Известия для барона‡Gebt dem Baron Bescheid‡남작에게 보고‡Que el Barón lo sepa‡Que el Barón lo sepa‡Informer le baron‡通知男爵‡通知男爵',
    nil,
    'Fale com o Barão Laska na Abóbada das Sombras.‡Поговорите с бароном Раздором в Мрачном Своде.‡Sprecht mit Baron Splitter im Schattengewölbe.‡어둠의 무기고에서 남작 슬리버와 대화해야 합니다.‡Habla con el Barón Tajada en La Cámara de las Sombras.‡Habla con el Barón Tajada en La Cámara de las Sombras.‡Parlez au Baron Lesquille au Caveau des Ombres.‡与暗影拱顶的斯利文男爵谈一谈。‡與暗影穹殿的史力弗男爵交談。',
  }
},
[12952] = {
  {
    'Gema Perfeita‡Огранка камней‡Edelsteine perfektionieren‡보석의 완벽함‡Gemas perfectas‡Gemas perfectas‡La perfection des gemmes‡完美宝石‡寶石完美工法',
    nil,
    'Leve dois Citrinos Grandes, dois Jades-escuros e dois Cristais Sombras para Horácio Stern, em Porto Vendeta.‡Принесите два огромных цитрина, два темных нефрита и два сумрачных кристалла Картеру Тиффенсу в Лагерь Возмездия.‡Ihr befindet Euch auf dieser Quest.‡복수의 상륙지에 있는 카터 티펜스에게 거대 황수정 2개, 암색 비취 2개, 암흑 수정 2개를 가져가야 합니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[12953] = {
  {
    'Queimem Valkyrion‡Гори, Валькирион, гори‡Valkyrion muss brennen‡발키리온은 불타야 한다‡Valkyrion debe arder‡Valkyrion debe arder‡Brûle, Valkyrion, brûle !‡燃烧吧，瓦基里安‡燒吧，華爾基倫，燒吧',
    nil,
    'Use os Lança-arpões Valkyrion para queimar 6 Montes de Feno Seco.‡С помощью валькирионских гарпунных пушек подожгите 6 валькирионских стогов сена.‡Benutzt die Harpunenkanone von Valkyrion, um 6 trockene Heuhaufen anzuzünden.‡발키리온 작살포를 사용해 마른 건초더미 6개에 불을 붙여야 합니다.‡Usa los cañones de arpones de Valkyrion para incendiar 6 fardos de heno secos.‡Usa los cañones de arpones de Valkyrion para incendiar 6 fardos de heno secos.‡Utilisez les Lance-harpons de Valkyrion pour brûler 6 Meules de foin sèches.‡用瓦基里安鱼叉炮点燃6堆干草垛。‡使用華爾基倫魚叉獵槍燒毀6個乾草堆',
  }
},
[12954] = {
  {
    'Anfiteatro da Angústia: Yggdras!‡Амфитеатр Страданий: Иггдрас!‡Das Amphitheater der Agonie: Yggdras!‡고뇌의 투기장: 이그드라스!‡El Anfiteatro de la Angustia: ¡Yggdras!‡El Anfiteatro de la Angustia: ¡Yggdras!‡L\'Amphithéâtre de l\'Angoisse : Yggdras !‡痛苦斗兽场：伊戈达斯！‡苦痛露天競技場:伊格卓斯!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Yggdras! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Иггдраса! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Yggdras! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 이그드라스와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Yggdras! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Yggdras! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez d’Yggdras ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败伊戈达斯！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗伊格卓斯!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12955] = {
  {
    'Eliminando a concorrência‡Унижение соперников‡Eliminiert die Konkurrenz‡경쟁자 처치‡Eliminar a la competencia‡Eliminar a la competencia‡Éliminez la concurrence‡消灭竞争者‡消滅競爭者',
    nil,
    'O Saltador, na Abóbada das Sombras, quer que você desafie e derrote Sigrid Gelonata; Efrem, o Fiel; Onu\'zun e Tinqui Apitocurto.‡Вызовите на дуэль и победите Сигрид Дитя Льда, Ефрема Верного, Ону\'Зуна и Тинки Свистопляс по поручению Прыгуна из Мрачного Свода.‡Der Springer beim Schattengewölbe möchte, dass Ihr Duelle austragt und Sigrid Eiskind, Efrem den Treuen, Onu\'zun und Tinky Dochtpfiff besiegt.‡어둠의 무기고에 있는 껑충이가 시그리드 아이스본, 성기사 에프렘, 오누준, 팅키 윅휘슬에게 도전한 다음 승리를 거두라고 했습니다.‡El Saltador en La Cámara de las Sombras quiere que desafíes a duelo y derrotes a Sigrid Hielonato, Efrem el Leal, Ono\'zun y a Mañosa Silbatín.‡El Saltador en La Cámara de las Sombras quiere que desafíes a duelo y derrotes a Sigrid Hielonato, Efrem el Leal, Ono\'zun y a Mañosa Silbatín.‡Le Bondisseur, au Caveau des Ombres, vous demande d\'affronter en duel et de vaincre Sigrid Née-de-glace, Efrem le Fidèle, Onu\'zun et Bricole Sifflemèche.‡暗影拱顶的跳跃者要求你与齐格莉德·冰魂、虔诚者埃弗雷姆、奥努森和丁奇·火哨决斗，并击败他们。‡暗影穹殿的跳躍者要你去單挑並擊敗席格芮·冰誕，忠誠的埃弗睿，奧努祖，以及汀基·芯哨。',
  }
},
[12956] = {
  {
    'Uma centelha de esperança‡Лучик надежды‡Ein Funken Hoffnung‡희망의 불꽃‡Una chispa de esperanza‡Una chispa de esperanza‡Une faible lueur d\'espoir‡希望的火花‡希望的火花',
    nil,
    'Leve o Minério Rebrilhante Refinado para Thorim no Templo das Tempestades.‡Отнесите очищенный светящийся металл Ториму в Храм Штормов.‡Ihr sollt das veredelte glänzende Erz zu Thorim in den Tempel des Sturms bringen.‡제련되어 빛나는 금속을 폭풍의 신전에 있는 토림에게 가져가야 합니다.‡Tienes que llevar la mena reluciente refinada a Thorim en el Templo de las Tormentas.‡Tienes que llevar la mena reluciente refinada a Thorim en el Templo de las Tormentas.‡Vous devez apporter le Minerai resplendissant raffiné à Thorim au Temple des tempêtes.‡将精炼闪光矿石交给风暴神殿的托里姆。‡你要把精煉微光礦石帶去給風暴神殿的索林姆。',
  }
},
[12957] = {
  {
    'Escravos dos forjados em tempestade‡Рабы Закаленных Бурей‡Sklaven der Sturmgeschmiedeten‡무쇠 드워프의 노예‡Esclavos de los Tronaforjado‡Esclavos de los Tronaforjado‡Les esclaves des Forge-foudre‡雷铸铁矮人的奴隶‡風暴冶煉奴隸',
    nil,
    'Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo, quer que você liberte 6 Gnomecânicos Cativos e mate 3 Capatazes Forjados em Tempestade.‡По заданию Глыбоскала Камнетеса из Приюта Глыбоскала освободите 6 пленных мехагномов и убейте 3 надсмотрщиков из клана Закаленных Бурей.‡Bergfels der Steinformer in Bergfels\' Zuflucht möchte, dass Ihr 6 gefangene Mechagnome befreit und 3 sturmgeschmiedete Zuchtmeister tötet.‡사로잡힌 기계노움 6마리를 구출하고 폭풍으로 벼려낸 감독관 3명을 처치한 후, 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Pedruscón el Creador de rocas en el Refugio de Pedruscón quiere que liberes a 6 mecagnomos cautivos y que mates a 3 capataces Tronaforjado.‡Pedruscón el Creador de rocas en el Refugio de Pedruscón quiere que liberes a 6 mecagnomos cautivos y que mates a 3 capataces Tronaforjado.‡Rochecombe le Sculpteroc au Refuge de Rochecombe veut que vous libériez 6 Mécagnomes captifs et que vous tuiez 3 Sous-chefs forge-foudre.‡布德克拉格庇护所的塑石者布德克拉格希望你去解救6名机械侏儒俘虏，并杀死3名雷铸工头。‡石崖避難所的『塑岩者』石崖要你釋放6個被俘虜的機械地精，並殺死3個風暴冶煉監工。',
  }
},
[12958] = {
  {
    'Remessa: amuleto de jade sangrento‡Заказ от торговой компании: амулет из кровавого нефрита‡Lieferung: Blutrotes Nephritamulett‡배달: 핏빛 비취 아뮬렛‡Envío: amuleto de jade de sangre‡Envío: amuleto de jade de sangre‡Livraison : Amulette en jade de sang‡货单：血玉护符‡貨品:血玉護符',
    nil,
    'Faça um Amuleto de Jade Sangrento a partir de um Amuleto Vraikal, um Jade-escuro e uma Pedra-sangrenta e entregue-o para Falcão Joiado em Dalaran.|n|nVocê pode retirar Amuletos Vraikalen de qualquer Vraikal de Nortúndria.‡Создайте амулет из кровавого нефрита, объединив амулет врайкулов, темный нефрит и кровавый камень, после чего принесите его Тимоти Джонсу в Даларан. Амулет врайкулов можно добыть с любого врайкула в Нордсколе.‡Kombiniert ein Vrykulamulett mit einem Nephrit und einem Blutstein, um ein blutrotes Nephritamulet herzustellen und es dann zu Jonas Timotheus in Dalaran zu bringen.|n|nVrykulamulette könnt Ihr von jedem Vrykul in Nordend erhalten.‡브리쿨 아뮬렛, 암색 비취, 혈석을 합쳐 핏빛 비취 아뮬렛을 만든 다음, 달라란에 있는 티모시 존스에게 가져가야 합니다.|n|n노스렌드에 있는 브리쿨에게서 브리쿨 아뮬렛을 얻을 수 있습니다.‡Reúne un amuleto vrykul, un jade oscuro y una sangrita para hacer un amuleto de jade de sangre, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar amuletos vrykul en cualquier vrykul de Rasganorte.‡Reúne un amuleto vrykul, un jade oscuro y una sangrita para hacer un amuleto de jade de sangre, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar amuletos vrykul en cualquier vrykul de Rasganorte.‡Combinez une Amulette vrykule, un Jade sombre et une Pierre de sang pour créer une Amulette en jade de sang et l\'apporter ensuite à Timothy Jones à Dalaran.|n|nVous trouverez une Amulette vrykule sur n\'importe quel vrykul du Norfendre.‡使用1枚维库护身符、1颗黑玉和1颗血石制造出一件血玉护符，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意维库人身上找到维库护身符。‡將一個維酷護符、一個暗玉以及一個血石合併，以製成一個血玉護符，將其交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一個維酷人身上找到維酷護符。',
  }
},
[12959] = {
  {
    'Remessa: estatueta de mármore faiscante‡Заказ от торговой компании: блестящая статуэтка из бивня‡Lieferung: leuchtende Elfenbeinfigur‡배달: 빛나는 상아 조각상‡Envío: figurilla de marfil resplandeciente‡Envío: figurilla de marfil resplandeciente‡Livraison : Figurine luminescente en ivoire‡货单：炽热鹿牙雕像‡貨品:發光象牙刻像',
    nil,
    'Faça uma Estatueta de Mármore Faiscante a partir de um Marfim do Norte, uma Calcedônia e um Cristal Sombrio e entregue-a para Falcão Joiado, em Dalaran.|n|nVocê pode retirar Marfim do Norte de qualquer Cavacorne ou Mamute de Nortúndria.‡Создайте блестящую статуэтку из бивня черпорога, объединив кальцедоний, сумрачный кристалл и бивень черпорога, и принесите ее Тимоти Джонсу в Даларан. Для того чтобы раздобыть бивень черпорога, вам нужно будет убить черпорога или мамонта в Нордсколе.‡Kombiniert Elfenbein aus Nordend mit einem Chalzedon und einem Schattenkristall, um eine leuchtende Elfenbeinfigur herzustellen und diese dann zu Jonas Timotheus in Dalaran zu bringen.|n|nElfenbein aus Nordend könnt Ihr von jedem Schaufelhauer oder Mammut in Nordend erhalten.‡북지 상아, 옥수, 암흑 수정을 합쳐 빛나는 상아 조각상을 만든 다음, 달라란에 있는 티모시 존스에게 가져가야 합니다.|n|n노스렌드에 서식하는 뾰족엄니나 매머드에게서 북지 상아를 얻을 수 있습니다.‡Reúne un trozo de marfil de Rasganorte, una calcedonia y un cristal de Sombras para crear una figurilla de marfil resplandeciente, y llévasela a Timothy Jones en Dalaran.|n|nPodrás encontrar marfil de Rasganorte en cualquier colmipala o mamut de Rasganorte.‡Reúne un trozo de marfil de Rasganorte, una calcedonia y un cristal de Sombras para crear una figurilla de marfil resplandeciente, y llévasela a Timothy Jones en Dalaran.|n|nPodrás encontrar marfil de Rasganorte en cualquier colmipala o mamut de Rasganorte.‡Combinez de l’Ivoire nordique, une Calcédoine et un Cristal ombreux pour créer une Figurine luminescente en ivoire et apportez-la à Timothy Jones à Dalaran. Vous trouverez de l’Ivoire nordique sur n\'importe quel Brochepelle ou Mammouth du Norfendre.‡使用1根诺森德鹿牙、1颗玉髓石和1颗暗影水晶制造出一件炽热鹿牙雕像，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意种类的铲齿鹿或猛犸身上找到这种东西。‡將一個北地象牙、一個玉髓以及一個暗影水晶組合成發光象牙刻像，然後交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一個鍬牙或長毛象身上找到北地象牙。',
  }
},
[12960] = {
  {
    'Remessa: broche solar perverso‡Заказ от торговой компании: брошь Беспощадного солнца‡Lieferung: tückische Sonnenbrosche‡배달: 악의의 태양 브로치‡Envío: broche de sol maligno‡Envío: broche de sol maligno‡Livraison : Broche du soleil pernicieux‡货单：邪恶太阳胸针‡貨品:邪惡烈日胸針',
    nil,
    'Faça um Broche Solar Perverso a partir de um Broche do Anão de Ferro, um Citrino Grande e um Cristal do Sol e entregue-o para Falcão Joiado em Dalaran.|n|nVocê pode retirar Broches do Anão de Ferro de qualquer Anão de Ferro de Nortúndria.‡Создайте брошь Беспощадного солнца из броши железных дворфов, огромного цитрина и солнечного хрусталя и принесите ее Тимоти Джонсу в Даларан.|n|nБрошь железных дворфов можно добыть у любого железного дворфа в Нордсколе.‡Kombiniert eine eisenzwergische Brosche mit einem Riesencitrin und einem Sonnenkristall, um eine tückische Sonnenbrosche herzustellen und diese dann zu Jonas Timotheus in Dalaran zu bringen.|n|nEisenzwergische Broschen könnt Ihr von jedem Eisenzwerg in Nordend erhalten.‡무쇠 드워프 브로치, 거대 황수정, 태양 수정을 합쳐 악의의 태양 브로치를 만든 다음, 달라란에 있는 티모시 존스에게 가져가야 합니다.|n|n노스렌드에 있는 무쇠 드워프에게서 무쇠 드워프 브로치를 얻을 수 있습니다.‡Reúne un broche de enano de hierro, un citrino enorme y un cristal de sol para hacer un broche de sol maligno, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar broches de enano de hierro en cualquier enano férreo de Rasganorte.‡Reúne un broche de enano de hierro, un citrino enorme y un cristal de sol para hacer un broche de sol maligno, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar broches de enano de hierro en cualquier enano férreo de Rasganorte.‡Combinez une Broche des nains de fer, une Énorme citrine et un Cristal soleil pour créer une Broche du soleil pernicieux et apportez-la ensuite à Timothy Jones à Dalaran.|n|nVous trouverez une Broche des nains de fer sur n\'importe quel Nain de fer du Norfendre.‡使用1枚铁矮人胸针、1颗茶晶石和1颗太阳水晶制造出一件邪恶太阳胸针，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意铁矮人身上找到铁矮人胸针。‡把一個鐵矮人胸針、一個巨黃晶以及一個烈日水晶組合成邪惡烈日胸針，交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一個鐵矮人身上找到鐵矮人胸針。',
  }
},
[12961] = {
  {
    'Remessa: estatueta de osso intrincada‡Заказ от торговой компании: изысканная костяная статуэтка‡Lieferung: aufwändige Knochenfigur‡배달: 엉클어진 뼈 조각상‡Envío: figurilla de hueso intrincada‡Envío: figurilla de hueso intrincada‡Livraison : Figurine complexe en os‡货单：精致龙骨雕像‡貨品:錯綜龍骨刻像',
    nil,
    'Faça uma Estatueta de Osso Intrincada a partir de um Osso de Protodragão, um Cristal do Sol e um Jade-escuro e entregue-a para Falcão Joiado, em Dalaran.|n|nVocê pode retirar o Osso de Protodragão de qualquer Protodragão de Nortúndria.‡Создайте изысканную костяную статуэтку из кости протодракона, солнечного хрусталя и темного нефрита и принесите ее Тимоти Джонсу в Даларан. Кость протодракона можно добыть с любого протодракона в Нордсколе.‡Kombiniert einen Protodrachenknochen mit einem Sonnenkristall und einem Nephrit, um eine aufwändige Knochenfigur herzustellen und diese dann zu Jonas Timotheus in Dalaran zu bringen.|n|nProtodrachenknochen könnt Ihr von jedem Protodrachen in Nordend erhalten.‡원시용 뼈, 태양 수정, 암색 비취를 합쳐 엉클어진 뼈 조각상을 가져가야 합니다.|n|n노스렌드에 있는 원시용에게서 원시용 뼈를 얻을 수 있습니다.‡Reúne un hueso de protodraco, un cristal de sol y un jade oscuro para hacer una figurilla de hueso intrincada, y llévasela a Timothy Jones en Dalaran.|n|nPodrás conseguir huesos de protodraco de cualquier protodraco de Rasganorte.‡Reúne un hueso de protodraco, un cristal de sol y un jade oscuro para hacer una figurilla de hueso intrincada, y llévasela a Timothy Jones en Dalaran.|n|nPodrás conseguir huesos de protodraco de cualquier protodraco de Rasganorte.‡Combinez un Os de proto-dragon, un Cristal soleil et un Jade sombre pour créer une Figurine complexe en os et l\'apporter à Timothy Jones à Dalaran.|n|nVous trouverez un Os de proto-dragon sur n\'importe quel Proto-dragon du Norfendre.‡使用1根始祖龙骨、1颗太阳水晶和1颗黑玉制造出一件精致龙骨雕像，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意始祖龙身上找到始祖龙骨。‡把一個元龍骨、一個烈日水晶以及一個暗玉組合成錯綜龍骨刻像，並交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一頭元龍身上取得元龍骨。',
  }
},
[12962] = {
  {
    'Remessa: relíquia de armadura brilhante‡Заказ от торговой компании: Реликвия из сияющей брони‡Lieferung: helles Rüstungsrelikt‡배달: 광휘의 갑옷 유물‡Envío: reliquia de armadura brillante‡Envío: reliquia de armadura brillante‡Livraison : Relique de l\'armure éclatante‡货单：光芒护甲圣物‡貨品:光亮護甲聖物',
    nil,
    'Faça uma Relíquia de Armadura Brilhante a partir de um Pedaço de Armadura Elemental, uma Pedra-sangrenta e um Citrino Grande e entregue-a para Falcão Joiado, em Dalaran.|n|nVocê pode retirar um Pedaço de Armadura Elemental de qualquer Elemental Vingativo de Nortúndria.‡Создайте реликвию Сияющей брони из осколка элементальной брони, кровавого камня и огромного цитрина и принесите ее Тимоти Джонсу в Даларан. Осколок элементальной брони можно добыть у любого элементаля-загробника в Нордсколе.‡Kombiniert den Rest einer Elementarrüstung mit einem Blutstein und einem Riesencitrin, um ein helles Rüstungsrelikt herzustellen und es dann zu Jonas Timotheus in Dalaran zu bringen.|n|nDie Reste einer Elementarrüstung könnt Ihr von jedem Klagegeist in Nordend erhalten.‡정령 갑옷 조각, 혈석, 거대 황수정을 합쳐 광휘의 갑옷 유물을 만든 다음, 달라란에 있는 티모시 존스에게 가져가야 합니다.|n|n노스렌드에 있는 망령에게서 정령 갑옷 조각을 얻을 수 있습니다.‡Reúne un fragmento de armadura elemental, una sangrita y un citrino enorme para hacer una reliquia de armadura brillante, y llévasela a Timothy Jones en Dalaran.|n|nPodrás encontrar fragmentos de armadura elemental en cualquier aparecido de Rasganorte.‡Reúne un fragmento de armadura elemental, una sangrita y un citrino enorme para hacer una reliquia de armadura brillante, y llévasela a Timothy Jones en Dalaran.|n|nPodrás encontrar fragmentos de armadura elemental en cualquier aparecido de Rasganorte.‡Combinez un Morceau d\'armure des éléments, une Pierre de sang et une Enorme citrine pour créer une Relique de l\'armure éclatante et l\'apporter à Timothy Jones à Dalaran.|n|nVous trouverez un Morceau d\'armure des éléments sur n\'importe quel Revenant du Norfendre.‡使用1块元素护甲片、1颗血石和1颗茶晶石制造出一件光芒护甲圣物，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意亡魂身上找到元素护甲片。‡把一個元素護甲碎塊、一個血石以及一個巨黃晶組合成光亮護甲聖物，並交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一個亡魄身上取得元素護甲碎塊。',
  }
},
[12963] = {
  {
    'Remessa: antiguidade solar cambiante‡Заказ от торговой компании: реликвия Восходящего Солнца‡Lieferung: unbeständige Sonnenkuriosität‡배달: 변화하는 태양 골동품‡Envío: bibelot de sol cambiante‡Envío: bibelot de sol cambiante‡Livraison : Bibelot du soleil changeant‡货单：迅捷烈日古器‡貨品:移形烈日珍品',
    nil,
    'Faça uma Antiguidade Solar Cambiante a partir de uma Raridade do Flagelo, um Cristal do Sol e um Cristal Sombrio e entregue-a para Falcão Joiado, em Dalaran.|n|nVocê pode retirar uma Raridade do Flagelo de qualquer membro do Flagelo em Nortúndria.‡Создайте реликвию Восходящего Солнца из реликвии Плети, солнечного хрусталя и сумрачного кристалла и принесите ее Тимоти Джонсу в Даларан. Реликвию Плети можно добыть у любого последователя Плети в Нордсколе.‡Kombiniert eine Geißelkuriosität mit einem Sonnenkristall und einem Schattenkristall, um eine unbeständige Sonnenkuriosität herzustellen und diese dann zu Jonas Timotheus in Dalaran zu bringen.|n|nGeißelkuriositäten könnt Ihr von jedem Diener der Geißel in Nordend erhalten.‡스컬지 골동품, 태양 수정, 암흑 수정을 합쳐 변화하는 태양 골동품을 만든 다음 달라란에 있는 티모시 존스에게 가져가야 합니다.|n|n노스렌드에 있는 스컬지에게서 스컬지 골동품을 얻을 수 있습니다.‡Reúne un bibelot de la Plaga, un cristal de sol y un cristal de Sombras para hacer un bibelot de sol cambiante, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar bibelots de la Plaga en cualquier Plaga de Rasganorte.‡Reúne un bibelot de la Plaga, un cristal de sol y un cristal de Sombras para hacer un bibelot de sol cambiante, y llévaselo a Timothy Jones en Dalaran.|n|nPodrás encontrar bibelots de la Plaga en cualquier Plaga de Rasganorte.‡Combinez un Bibelot du Fléau, un Cristal soleil et un Cristal ombreux pour créer un Bibelot du soleil changeant et l\'apporter à Timothy Jones à Dalaran.|n|nVous trouverez un Bibelot du Fléau sur n\'importe quel créature du Fléau en Norfendre.‡使用1件天灾古物、1颗太阳水晶和1颗暗影水晶制造出一件迅捷烈日古器，把它交给达拉然的提莫斯·琼斯。|n|n你可以在诺森德的任意天灾成员身上找到天灾古物。‡把一個天譴珍品、一個烈日水晶以及一個暗影水晶組合成移形烈日珍品，並交給達拉然的提摩西·瓊斯。|n|n你可以從北裂境的任何一個天譴軍身上取得天譴珍品。',
  }
},
[12964] = {
  {
    'Minério negro‡Темная руда‡Das dunkle Erz‡검은 광석‡La mena oscura‡La mena oscura‡Le minerai sombre‡黑暗的矿石‡黑暗礦石',
    nil,
    'Leve 5 Amostras de Minério para Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Принесите 5 образцов руды Глыбоскалу Камнетесу в Приют Глыбоскала.‡Bringt 5 Erzproben zu Bergfels dem Steinformer in Bergfels\' Zuflucht.‡바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 검은 광석 견본 5개를 가져가야 합니다.‡Llévale 5 muestras de mena a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Llévale 5 muestras de mena a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Apportez 5 Echantillons de minerai à Rochecombe le Sculpteroc au Refuge de Rochecombe.‡为布德克拉格庇护所的塑石者布德克拉格带回5份黑暗的矿石样本。‡把5個黑暗礦石樣本帶去給石崖避難所的『塑岩者』石崖。',
  }
},
[12965] = {
  {
    'As dádivas de Loken‡Дары Локена‡Lokens Gaben‡로켄의 선물‡Los obsequios de Loken‡Los obsequios de Loken‡Les cadeaux de Loken‡洛肯的礼物‡洛肯的賜禮',
    nil,
    'Destrua a Fúria de Loken, o Poder de Loken e a Proteção de Loken e fale novamente com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Уничтожьте Неистовство Локена, Мощь Локена и Благосклонность Локена, а затем вернитесь к Глыбоскалу Камнетесу в Приют Глыбоскала.‡Zerstört Lokens Wut, Lokens Kraft und Lokens Gunst und kehrt dann zu Bergfels dem Steinformer nach Bergfels\' Zuflucht zurück.‡로켄의 분노, 로켄의 힘, 로켄의 특권을 파괴하고 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Destruye la Furia de Loken, el Poder de Loken y el Favor de Loken. Después regresa junto a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Destruye la Furia de Loken, el Poder de Loken y el Favor de Loken. Después regresa junto a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Détruisez la Fureur de Loken, le Pouvoir de Loken et la Faveur de Loken, puis retournez voir Rochecombe le Sculpteroc au Refuge de Rochecombe.‡摧毁洛肯之怒、洛肯之力和洛肯之赐，然后返回布德克拉格庇护所，向塑石者布德克拉格复命。‡破壞洛肯之怒、洛肯之力與洛肯之恩賜，然後返回石崖避難所向『塑岩者』石崖回報。',
  }
},
[12966] = {
  {
    'Não tem como errar‡Мимо него не пройдешь‡Ihr könnt ihn nicht verpassen‡놓쳐서는 안 된다‡No tiene pérdida‡No tiene pérdida‡Vous ne pourrez pas le rater‡你不会找不到他‡你不會看漏的',
    nil,
    'O Rei Iokkum em Dun Niffelem quer que você encontre Njormeld na Bigorna de Fjorn.‡По поручению короля Йоккума из Дун Ниффелема разыщите Ньормельда у Наковальни Фьорна.‡König Jokkum in Dun Niffelem möchte, dass Ihr zu Fjorns Amboss geht und Njormeld sucht.‡던 니펠렘에 있는 제왕 요쿰이 피요른의 모루에 있는 요르멜드를 찾아보라고 했습니다.‡El rey Jokkum en Dun Niffelem quiere que busques a Njormeld en el Yunque de Fjorn.‡El rey Jokkum en Dun Niffelem quiere que busques a Njormeld en el Yunque de Fjorn.‡Le Roi Jokkum, à Dun Niffelem, veut que vous rejoigniez Njormeld à l\'Enclume de Fjorn.‡丹尼芬雷的约库姆国王要你前往弗约恩之砧，找到找亚米尔德。‡丹尼弗蘭的裘庫姆國王要你去斐雍之砧找尼約梅爾德。',
  }
},
[12967] = {
  {
    'Enfrentando os elementos‡Сражение со стихиями‡Kampf gegen die Elemente‡정령과 한판 승부‡Luchar contra los elementales‡Luchar contra los elementales‡Affronter les éléments‡元素之战‡與元素作戰',
    nil,
    'Njormeld quer que você acompanhe Snorri até a bigorna de Fjorn e ajude-o a matar 10 Elementais Vingativos Exasperados.‡По поручению Ньормельда отправляйтесь к наковальне Фьорна вместе с Храппи и помогите ему убить 10 пылающих загробников.‡Njormeld wünscht, dass Ihr Snorri zu Fjorns Amboss begleitet und ihm dabei helft, 10 wutentbrannte Klagegeister zu töten.‡요르멜드가 스노리와 함께 피요른의 모루로 가서 소용돌이치는 망령 10마리를 처치하라고 했습니다.‡Njormeld quiere que acompañes a Snorri al Yunque de Fjorn y que lo ayudes a matar a 10 aparecidos hirvientes.‡Njormeld quiere que acompañes a Snorri al Yunque de Fjorn y que lo ayudes a matar a 10 aparecidos hirvientes.‡Njormeld veut que vous accompagniez Snorri à l\'Enclume de Fjorn et que vous l\'aidiez à tuer 10 Revenants vengeurs.‡亚米尔德要求你陪伴斯诺雷前往弗约恩之砧，并帮助他杀死10个火热的亡魂。‡尼約梅爾德要你陪伴思諾利到斐雍之砧去，並幫助他殺死10個沸騰亡魄。',
  }
},
[12968] = {
  {
    'O desatino de Yulda‡Безрассудство Юльды‡Yuldas Torheit‡율다의 계략‡La insensatez de Yulda‡La insensatez de Yulda‡La folie de Yulda‡伊尔达的愚行‡優爾達的愚行',
    nil,
    'Iva, a Vingativa, na Aldeia Brunnhildar, quer que você mate Yulda, a Voz da Tempestade, em Valkyrion.‡По заданию Ивы Мстительной из деревни Бруннхильдар убейте Юльду Опустошительницу в Валькирионе.‡Iva die Rachsüchtige aus Brunnhildar möchte, das Ihr Yulda die Sturmwirkerin in Valkyrion tötet.‡브룬힐다르 마을의 복수심에 불타는 이바를 위해 발키리온에 있는 폭풍술사 율다를 처치해야 합니다.‡Iva la Vengativa en el poblado Brunnhildar quiere que mates a Yulda la Hablatormentas en Valkyrion.‡Iva la Vengativa en el Poblado Brunnhildar quiere que mates a Yulda la Hablatormentas en Valkyrion.‡Iva la Vengeresse à Brunnhildar vous a demandé de tuer Yulda la Parlorage à Valkyrion.‡布伦希尔达村的复仇者伊芬要你进入瓦基里安，杀死风暴语者伊尔达。‡布倫希爾達村的『復仇』伊娃要你去華爾基倫殺死『颶語者』優爾達。',
  }
},
[12969] = {
  {
    'É aquele Goblin ali?‡Это твой гоблин?‡Ist das Euer Goblin?‡네가 찾는 그 고블린인가?‡¿Es ese tu goblin?‡¿Es ese tu goblin?‡Il est à vous, ce gobelin ?‡这是你的地精吗？‡那是你的哥布林嗎?',
    nil,
    'Desafie Agnetta Tyrsdottar para salvar Zeev Saifaísca. Fale novamente com Lok\'lira, a Velha, na Aldeia Brunnhildar, após sua vitória.‡Бросьте вызов Агнете Тирсдоттар, чтобы спасти Зива Искрошипа. Добившись успеха, возвращайтесь к Лок\'лире Карге из деревни Бруннхильдар.‡Fordert Agnetta Tyrsdottar heraus, um Zeev Zischelfunken zu retten. Kehrt ins Dorf Brunnhildar zu Lok\'lira der Greisin zurück, wenn Ihr erfolgreich wart.‡지브 피즐스파크를 구하려면 아그네타 티르스도타르를 상대해야 합니다. 성공한 후 브룬힐다르 마을에 있는 마녀 로크리라에게 돌아가십시오.‡Desafía a Agnetta Tyrsdottar para salvar a Zeev Chispeante. Cuando lo hayas conseguido, regresa junto a Lok\'lira la Vieja Bruja en el poblado Brunnhildar.‡Desafía a Agnetta Tyrsdottar para salvar a Zeev Chispeante. Cuando lo hayas conseguido, regresa junto a Lok\'lira la Vieja Bruja en el Poblado Brunnhildar.‡Défiez Agnetta Tyrsdottar afin de sauver Zeev Pfutincelle. Retournez auprès de Lok\'lira la Mégère à Brunnhildar une fois la tâche accomplie.‡向安格妮塔·泰斯多达尔发起挑战，救出西弗·菲兹巴克。成功之后，向布伦希尔达村的女巫洛莉拉复命。‡挑戰艾格奈塔·泰斯多達以拯救奇夫·嘶炫。成功之後回去找布倫希爾達村的『巫婆』洛莉拉。',
  }
},
[12970] = {
  {
    'O Tornehylde‡Круг хильд‡Das Hildarthing‡힐드스미트‡El Encuentro Hyldnir‡El Encuentro Hyldnir‡Le Hyldsmeet‡海德比武会‡海茲競技',
    nil,
    'Ouça a proposta de Lok\'lira, a Velha.‡Выслушайте предложение Лок\'лиры Карги.‡Hört Euch den Vorschlag von Lok\'lira der Greisin an.‡로크리라의 제안을 들어봐야 합니다.‡Escucha la propuesta de Lok\'lira la Vieja Bruja.‡Escucha la propuesta de Lok\'lira la Vieja Bruja.‡Écoutez la proposition de Lok\'lira la Mégère.‡听取女巫洛莉拉的提议。‡聆聽『巫婆』洛莉拉的計畫。',
  }
},
[12971] = {
  {
    'Encarando todas as desafiantes‡Вызов принят‡Sich allen Herausforderern stellen‡상대해야 할 도전자들‡Enfrentarse a todos los retos‡Enfrentarse a todos los retos‡Accepter tous les défis‡迎接挑战者‡接受所有挑戰',
    nil,
    'Lok\'lira, a Velha, na Aldeia Brunnhildar, quer que você derrote 6 Desafiantes Vitoriosas.‡Сразите 6 дуэлянтов-победителей по заданию Лок\'лиры Карги из деревни Бруннхильдар.‡Lok\'lira die Greisin in Brunnhildar wünscht, dass Ihr 6 siegreiche Herausforderinnen besiegt.‡브룬힐다르 마을에 있는 마녀 로크리라가 승리한 도전자 6명과 싸워 이기라고 부탁했습니다.‡Lok\'lira la Vieja Bruja en el poblado Brunnhildar quiere que derrotes a 6 contendientes victoriosas.‡Lok\'lira la Vieja Bruja en el Poblado Brunnhildar quiere que derrotes a 6 contendientes victoriosas.‡Lok\'lira la Mégère à Brunnhildar vous a demandé de vaincre 6 Prétendantes victorieuses.‡布伦希尔达村的女巫洛莉拉要你去打败6名获胜的挑战者。‡布倫希爾達村的『巫婆』洛莉拉，要求你擊敗6個挑戰者。',
  }
},
[12972] = {
  {
    'Você vai precisar de um urso‡Тебе понадобится медведь‡Ihr werdet einen Bären brauchen‡곰이 필요한 일‡Necesitarás un oso‡Necesitarás un oso‡Vous aurez besoin d\'un ours‡你需要一头熊‡你需要一頭熊',
    nil,
    'Fale com Brijana na entrada da Aldeia Brunnhildar.‡Поговорите с Бриджаной неподалеку от деревни Бруннхильдар.‡Sprecht mit Brijana, die sich außerhalb von Brunnhildar aufhält.‡브룬힐다르 마을 밖에 있는 브리야나와 대화해야 합니다.‡Habla con Brijana a las afueras del poblado Brunnhildar.‡Habla con Brijana a las afueras del Poblado Brunnhildar.‡Parlez à Brijana à l\'extérieur de Brunnhildar.‡与布伦希尔达村外的布莉亚娜谈一谈。‡與布倫希爾達村外的布瑞嘉娜對話。',
  }
},
[12973] = {
  {
    'Os irmãos Barbabronze‡Братья Бронзобороды‡Die Gebrüder Bronzebart‡브론즈비어드 형제들‡Los hermanos Barbabronce‡Los hermanos Barbabronce‡Les frères Barbe-de-bronze‡铜须兄弟‡銅鬚兄弟',
    nil,
    'Siga na máquina voadora com Brann Barbabronze até a Fortaleza Gelada.‡Прикрывайте Бранна и ветролет, пока не доберетесь до Ледяной крепости.‡Begleitet Brann Bronzebart und seine Flugmaschine zur Eisfestung.‡브란 브론즈비어드와 함께 그의 비행기를 타고 서리요새로 돌아가야 합니다.‡Acompaña a Brann Barbabronce y a su máquina voladora hasta Fuerte Escarcha.‡Acompaña a Brann Barbabronce y a su máquina voladora hasta Fuerte Escarcha.‡Accompagnez Brann Barbe-de-bronze et sa Machine volante au Fort du Givre.‡与布莱恩·铜须及其飞行器一起返回冰霜堡。‡陪同布萊恩·銅鬚，搭乘其飛行器前往霜堡。',
  }
},
[12974] = {
  {
    'O chamado dos campeões!‡Призыв бойцовского клуба‡Ruf des Champions!‡용사를 부른다!‡¡La llamada del campeón!‡¡La llamada del campeón!‡L\'appel du champion !‡勇士的召唤！‡勇士的呼喚!',
    nil,
    'Procure Gurgthock no Anfiteatro da Angústia, em Zul\'Drak.‡Разыщите Гаргтокa в Амфитеатре Страданий в Зул\'Драке.‡Ihr befindet Euch auf dieser Quest.‡줄드락의 고뇌의 투기장에서 굴그토크를 찾아봐야 합니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[12975] = {
  {
    'In memoriam‡Мемориал‡In Gedenken an‡평화의 기념비‡En memoria‡En memoria‡In Memoriam‡回首往事‡紀念',
    nil,
    'O Rei Iokkum em Dun Niffelem quer que você reúna 8 Fragmentos de Trompa em Tormentério.‡По заданию короля Йоккума из Дун Ниффелема соберите 8 фрагментов рога в Громовержье.‡König Jokkum in Dun Niffelem wünscht, dass Ihr nach Donnerfall geht und 8 Hornfragmente einsammelt.‡천둥 골짜기에서 뿔피리 조각 8개를 찾아 던 니펠렘에 있는 제왕 요쿰에게 가져가야 합니다.‡El rey Jokkum en Dun Niffelem quiere que recojas 8 fragmentos de cuerno en Truenotoño.‡El rey Jokkum en Dun Niffelem quiere que recojas 8 fragmentos de cuerno en Truenotoño.‡Le Roi Jokkum à Dun Niffelem veut que vous récupériez 8 Fragments de cor à Chute-tonnerre.‡丹尼芬雷的约库姆国王要求你前往落雷谷，收集8块号角碎片。‡丹尼弗蘭的裘庫姆王要求你，去雷殞之地收集8個號角碎片。',
  }
},
[12976] = {
  {
    'Um monumento aos que tombaram‡Памятник павшим‡Ein Monument für die Gefallenen‡쓰러진 자들을 위한 기념비‡Un monumento a los caídos‡Un monumento a los caídos‡Un monument à ceux qui sont tombés‡亡者的纪念碑‡給逝者的紀念碑',
    nil,
    'O Rei Iokkum quer que você leve os Fragmentos da Trompa de Hodir a Njormeld, em Dun Niffelem.‡По поручению короля Йоккума отнесите фрагменты рога Ходира Ньормельду в Дун Ниффелем.‡König Jokkum wünscht, dass Ihr Hodirs Hornfragmente zu Njormeld in Dun Niffelem bringt.‡제왕 요쿰이 던 니펠렘에 있는 요르멜드에게 호디르의 뿔피리 조각을 가져가 달라고 부탁했습니다.‡El rey Jokkum quiere que le lleves los fragmentos del cuerno de Hodir a Njormeld, en Dun Niffelem.‡El rey Jokkum quiere que le lleves los fragmentos del cuerno de Hodir a Njormeld, en Dun Niffelem.‡Le Roi Jokkum veut que vous apportiez les Fragments du Cor de Hodir à Njormeld à Dun Niffelem.‡约库姆国王要求你将号角碎片交给丹尼芬雷的亚米尔德。‡裘庫姆王要你把霍迪爾號角碎片送去給丹尼弗蘭的尼約梅爾德。',
  }
},
[12977] = {
  {
    'Chamado de Hodir‡Зов Ходира‡Hodirs Ruf‡호디르의 부름‡La llamada de Hodir‡Llamado de Hodir‡L’appel de Hodir‡霍迪尔的呼唤‡霍迪爾的呼喚',
    nil,
    'Derrote 5 Antepassados Niffelems e 5 Gelonatos Inquietos em Tormentério. Sopre a Trompa de Hodir sobre os corpos e volte à Trompa de Hodir em Dun Niffelem.‡Убейте 5 ниффелемских прародителей и 5 неупокоенных дворфов из клана Зиморожденных в Громовержье. Протрубите над их телами в рог, затем вернитесь к рогу Ходира в Дун Ниффелем.‡Ihr müsst am Donnerfall 5 Vorfahren von Niffelem und 5 ruhelose Frosterben besiegen. Lasst dann über ihren Leichen stehend Hodirs Horn ertönen und geht anschließend zurück zu Hodirs Horn in Dun Niffelem.‡천둥 골짜기에 있는 니펠렘 선조 5마리와 잠 못 드는 서릿결부족원 5마리를 처치한 후 그들의 시체에 호디르의 뿔피리를 불어야 합니다. 일을 마치면 던 니펠렘으로 호디르의 뿔피리를 가져가야 합니다.‡Debes vencer a 5 antepasados de Niffelem y a 5 Natoescarchas inquietos en Truenotoño. Después, utiliza el cuerno de Hodir sobre sus cadáveres y vuelve al cuerno de Hodir en Dun Niffelem.‡Debes vencer a 5 antepasados de Niffelem y a 5 Natoescarchas inquietos en Truenotoño. Después, utiliza el cuerno de Hodir sobre sus cadáveres y vuelve al cuerno de Hodir en Dun Niffelem.‡Vous devez vaincre 5 Ancêtres niffelem et 5 Givre-nés sans repos à Chute-tonnerre. Vous devez ensuite souffler dans le Cor de Hodir au-dessus de leurs cadavres, puis rapportez le Cor de Hodir à Dun Niffelem.‡前往落雷谷，击败5名尼芬雷先祖和5名永不疲倦的霜脉矮人，并对他们的尸体吹响霍迪尔的号角。然后将霍迪尔的号角带回丹尼芬雷。‡你要去雷殞之地擊敗5個尼弗蘭祖先與5個不安的霜誕鬼魂。在他們的屍體上吹響霍迪爾號角，然後帶著號角回到丹尼弗蘭。',
  }
},
[12978] = {
  {
    'Enfrentando a tempestade‡Навстречу буре‡Im Angesicht des Sturms‡폭풍과 맞서는 일‡Enfrentarse a la tormenta‡Enfrentarse a la tormenta‡Face à la tempête‡进攻尼达维里尔‡面對風暴',
    nil,
    'Bruor Ferruína no Refúgio do Petrenedo quer que você mate 10 Forjados em Tempestade de Nidavelir. Você pode matar Campeões Forjados em Tempestade, Magos Forjados em Tempestade ou Golens de Guerra Forjados em Tempestade.‡По заданию Брюора Железоруба в Приюте Глыбоскала убейте 10 Закаленных Бурей из Нидавелира. Вы можете убивать воителей клана Закаленных Бурей, волхвов клана Закаленных Бурей или боевых големов клана Закаленных Бурей.‡Bruor Eisenbann in Bergfels\' Zuflucht bittet Euch, 10 Sturmgeschmiedete in Nidavelir zu töten. Tötet Sturmgeschmiedete Champions, Sturmgeschmiedete Magier oder Sturmgeschmiedete Kriegsgolems.‡바울더크랙의 은거처에 있는 브루오르 아이언베인이 니다벨리르에 있는 폭풍으로 벼려낸 자 10명을 처치해 달라고 부탁했습니다. 폭풍으로 벼려낸 용사, 폭풍으로 벼려낸 학자, 폭풍으로 벼려낸 전쟁 골렘을 처치하면 됩니다.‡Bruor Temeferro en el Refugio de Pedruscón quiere que mates a 10 Tronaforjado de Nidavelir. Puedes matar campeones Tronaforjado, magi Tronaforjado o gólems de guerra Tronaforjado.‡Bruor Temeferro en el Refugio de Pedruscón quiere que mates a 10 Tronaforjado de Nidavelir. Puedes matar campeones Tronaforjado, magi Tronaforjado o gólems de guerra Tronaforjado.‡Bruor Plaie-du-fer au Refuge de Rochecombe veut que vous assassiniez 10 Forge-foudre nidavelirs. Vous pouvez tuer des Champions forge-foudre, des Magi forge-foudre, ou des Golems de guerre forge-foudre.‡布德克拉格庇护所的布鲁沃·斩铁要你前往尼达维里尔，杀死10个雷铸铁矮人的士兵。雷铸勇士、雷铸大法师或雷铸作战魔像都可以。‡石崖避難所的布魯爾·鐵禍要你殺死10個尼達維里爾的風暴冶煉者。你可以殺死風暴冶煉勇士、風暴冶煉魔導師或是風暴冶煉戰爭魔像。',
  }
},
[12979] = {
  {
    'A armadura das trevas‡Доспехи тьмы‡Rüstung der Dunkelheit‡암흑 갑옷‡Armadura de oscuridad‡Armadura de oscuridad‡L\'armure des ténèbres‡黑暗的护甲板‡黑暗護甲',
    nil,
    'Leve 4 Amostras de Armadura das Trevas para Bruor Ferruína no Refúgio do Petrenedo.‡Принесите 4 образца темной пластины для доспехов Брюору Железорубу в Приют Глыбоскала.‡Bringt 4 Dunkle Rüstungen zu Bruor Eisenbann in Bergfels\' Zuflucht.‡바울더크랙의 은거처에 있는 브루오르 아이언베인에게 암흑 갑옷 견본 4개를 가져가야 합니다.‡Llévale 4 muestras de armadura oscura a Bruor Temeferro en el Refugio de Pedruscón.‡Llévale 4 muestras de armadura oscura a Bruor Temeferro en el Refugio de Pedruscón.‡Apportez 4 Echantillons d\'armure sombre à Bruor Plaie-du-fer au Refuge de Rochecombe.‡将4份黑暗护甲板样品交给布德克拉格庇护所的布鲁沃·斩铁。‡把4塊黑暗護甲樣本帶去給石崖避難所的布魯爾·鐵禍。',
  }
},
[12980] = {
  {
    'O segredo da armadura‡Секрет доспехов‡Die Geheimnisse der Rüstung‡갑옷의 비밀‡Los secretos de la armadura‡Los secretos de la armadura‡Les secrets de l\'armure‡护甲板的秘密‡護甲的秘密',
    nil,
    'Leve a Placa de Armadura das Trevas à Oficina do Mimir e peça ao Assistente Tock para examiná-la. Quando terminar, fale novamente com Bruor Ferruína no Refúgio do Petrenedo.‡Отнесите темную пластину для доспехов в Мастерскую Мимира и попросите рабочего Тока осмотреть ее. Потом возвращайтесь к Брюору Железорубу в Приют Глыбоскала.‡Bringt die dunkle Plattenrüstung zu Mimirs Werkstatt und bittet Tock den Knecht, sie sich näher anzusehen. Kehrt zu Bruor Eisenbann in Bergfels\' Zuflucht zurück, wenn Ihr fertig seid.‡암흑 갑옷 조각을 미미르의 작업장으로 가져가서 수행원 토크에게 조사해 봐달라고 한 후, 일을 마치면 바울더크랙의 은거처에 있는 브루오르 아이언베인에게 돌아가야 합니다.‡Lleva la placa de armadura oscura al Taller de Mimir y pídele al auxiliar Tock que lo examine. Cuando esto esté hecho, vuelve junto a Bruor Temeferro al Refugio de Pedruscón.‡Lleva la placa de armadura oscura al Taller de Mimir y pídele al auxiliar Tock que lo examine. Cuando esto esté hecho, vuelve junto a Bruor Temeferro al Refugio de Pedruscón.‡Emportez la Plaque d\'armure sombre à l\'Atelier de Mimir et demandez au Domestique Tock de l\'examiner. Quand ce sera fait, retournez auprès de Bruor Plaie-du-fer au Refuge de Rochecombe.‡把黑暗护甲板带到米米尔的车间去，让随从托克检查它。完成任务后，向布德克拉格庇护所的布鲁沃·斩铁复命。‡將黑暗護甲片帶去彌米爾工坊，要求侍者托克檢驗它。當你完成了以後，回到石崖避難所找布魯爾·鐵禍。',
  }
},
[12981] = {
  {
    'Quente e frio‡Жар и холод‡Heiß und kalt‡냉기와 열기‡Caliente y frío‡Caliente y frío‡Chaud et froid‡热与冷‡熱與冷',
    nil,
    'Vá ao Lago Congelado e mate Elementais Vingativos Quebradiços para obter Essências de Gelo. Depois vá até a antiga localização da Bigorna de Fjorn, mate Elementais Vingativos Exasperados para obter sobras de metal e combine-as com as essências geladas. Em seguida, reúna 6 das Sobras de Ferro Congelado obtidas no processo e volte à nova localização da Bigorna de Fjorn em Dun Niffelem.‡Идите к Промерзшему озеру, убейте хрупких загробников, обитающих в тех краях, и с помощью субстанции Льда остудите дымящиеся осколки у наковальни Фьорна. Потом соберите 6 кусков застывшего железа и вернитесь к наковальне Фьорна в Дун Ниффелем.‡Ihr sollt zum Frostfeldsee gehen, die zerbrechlichen Klagegeister dort vernichten und die Essenz des Eises auf den qualmenden Schrott bei Fjorns Amboss anwenden. Anschließend sollt Ihr 6 Trümmer gefrorenen Eisenschrotts sammeln und zu Fjorns Amboss in Dun Niffelem zurückkehren.‡서리평원 호수로 가서 빛바랜 망령을 처치하고 피요른의 모루에서 이글거리는 조각에 얼음의 정수를 사용해야 합니다. 이렇게 해서 얼어붙은 무쇠 조각 6개를 모은 다음 던 니펠렘에 있는 피요른의 모루로 돌아와야 합니다.‡Ve al Lago Campo de Escarcha, mata a los aparecidos frágiles que hay allí y utiliza la Esencia de Hielo en la chatarra ardiente en el Yunque de Fjorn. Después deberás recoger 6 de los fragmentos de hierro congelado y volver junto al Yunque de Fjorn en Dun Niffelem.‡Ve al Lago Campo de Escarcha, mata a los aparecidos frágiles que hay allí y utiliza la Esencia de Hielo en la chatarra ardiente en el Yunque de Fjorn. Después deberás recoger 6 de los fragmentos de hierro congelado y volver junto al Yunque de Fjorn en Dun Niffelem.‡Vous devez vous rendre au Lac du Champ-gelé pour y tuer les Revenants vermoulus et utiliser ensuite l\'Essence de glace sur les Ferrailles fumantes à l\'Enclume de Fjorn. Vous devrez alors récupérer 6 Morceaux de fer gelé et retourner à l\'Enclume de Fjorn à Dun Niffelem.‡前往霜原湖，消灭脆弱的亡魂，并对冒烟的碎片使用冰之精华。收集6块冻铁碎片，将它们带回丹尼芬雷的弗约恩之砧。‡你要前往霜域湖，殺死易怒的亡魄，然後在斐雍之砧對著悶燒的廢金屬使用寒冰精華。接著，你必須收集6個冰凍碎鐵塊並回到丹尼弗蘭的斐雍之砧。',
  }
},
[12982] = {
  {
    'Prisioneiros da Lâmina de Ébano‡Пленники из ордена Черного Клинка‡Gefangene der Schwarzen Klinge‡칠흑의 기사단 포로‡Prisioneros de la Espada de Ébano‡Prisioneros de la Espada de Ébano‡Les prisonniers de la Lame d\'ébène‡黑锋囚犯‡黯刃囚犯',
    nil,
    'Vaelen, o Esfolado, na Abóbada das Sombras, quer que você liberte 8 Prisioneiros da Lâmina de Ébano das jaulas em Jotunheim e arredores.‡Освободите 8 пленных рыцарей Черного Клинка по просьбе Вэлена Разоблаченного из Мрачного Свода. Пленников держат в клетках в районе Йотунхейма.‡Vaelen der Geschundene im Schattengewölbe bittet Euch, 8 Gefangene der Schwarzen Klinge zu befreien. Ihr findet sie in den Käfigen in der weiteren Umgebung von Jotunheim.‡어둠의 무기고에 있는 고문당한 밸렌이 광범위 요툰하임 지역에 있는 우리를 찾아 그 안에 갇힌 칠흑의 기사단 포로 8명을 자유롭게 해달라고 부탁했습니다.‡Vaelen el Despellejado en La Cámara de las Sombras quiere que liberes a 8 prisioneros de la Espada de Ébano. Los podrás encontrar en las jaulas en la región de Jotunheim.‡Vaelen el Despellejado en La Cámara de las Sombras quiere que liberes a 8 prisioneros de la Espada de Ébano. Los podrás encontrar en las jaulas en la región de Jotunheim.‡Vaelen l\'Écorché, au Caveau des Ombres, vous a demandé de libérer 8 Prisonniers de la Lame d\'ébène. Ils se trouvent dans des cages partout dans la région de Jotunheim.‡暗影拱顶的被折磨的维林要求你去解救8位黑锋囚犯。你可以在尤顿海姆地区的各个牢笼里找到他们。‡暗影穹殿裡被搶劫的維倫，要你釋放8名黯刃囚犯。你可以在整個卓頓海姆區域找到關著囚犯的籠子。',
  }
},
[12983] = {
  {
    'A última da espécie‡Последняя из рода‡Die Letzte ihrer Art‡동족의 마지막 존재‡La última de su raza‡La última de su raza‡La dernière de son espèce‡最后的母熊‡最後一頭',
    nil,
    'Astrid Bjornrittar na Aldeia Brunnhildar quer que você resgate uma Matriarca Rosnagelo na Caverna Hibérnia.‡Спасите медведицу-матриарха в пещере зимней спячки по просьбе Астрид Бьорнриттар из деревни Бруннхильдар.‡Astrid Björnrittar in Brunnhildar wünscht, dass Ihr eine Eisschlundmatriarchin aus der Überwinterungshöhle rettet.‡브룬힐다르 마을에 있는 아스트리드 비요른리타가 겨울 동굴에서 얼음아귀 우두머리를 구출해 달라고 부탁했습니다.‡Astrid Bjornrittar en el poblado Brunnhildar quiere que rescates una matriarca faucehielo en la Caverna Hibernal.‡Astrid Bjornrittar en el Poblado Brunnhildar quiere que rescates una matriarca Faucehielo en la Caverna Hibernal.‡Astrid Bjornrittar à Brunnhildar vous a demandé de sauver une Matriarche glacegueule à la Caverne de l\'Hibernation.‡布伦希尔达村的艾丝崔·约利塔尔要你去冬眠洞穴解救一头冰喉母熊。‡布倫希爾達村的艾絲翠德·畢優利塔，要你拯救一頭凜冬洞窟的冰喉族母。',
  }
},
[12984] = {
  {
    'Valduran, o Filho da Tempestade‡Валдуран Дитя Бури‡Valduran der Sturmgeborene‡폭풍의 후예 발두란‡Valduran el Natormento‡Valduran el Natormento‡Valduran Issu-des-tempêtes‡风暴之子瓦杜兰‡『風暴降生』瓦杜然',
    nil,
    'Use a Trompa de Guerra de Petrenedo quando encontrar Valduran, o Filho da Tempestade. Derrote Valduran, o Filho da Tempestade, e fale novamente com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Протрубите в боевой рог Глыбоскала, когда разыщете Валдурана Дитя Бури. Одержите победу над ним и вернитесь к Глыбоскалу Камнетесу в Приют Глыбоскала.‡Benutzt Bergfels\' Kriegshorn, sobald Ihr Valduran den Sturmgeborenen gefunden habt. Besiegt ihn und kehrt anschließend zu Bergfels dem Steinformer in Bergfels\' Zuflucht zurück.‡발두란을 찾으면 바울더크랙의 전쟁 뿔피리를 사용해야 합니다. 폭풍의 후예 발두란을 처치한 후 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Usa el cuerno de Guerra de Pedruscón cuando hayas encontrado a Valduran el Natormento. Vence a Valduran el Natormento y vuelve junto a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Usa el cuerno de Guerra de Pedruscón cuando hayas encontrado a Valduran el Natormento. Vence a Valduran el Natormento y vuelve junto a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Utilisez le Cor de guerre de Rochecombe quand vous aurez trouvé Valduran Issu-des-tempêtes. Battez Valduran Issu-des-tempêtes et retournez voir Rochecombe le Sculpteroc au Refuge de Rochecombe.‡当你发现风暴之子瓦杜兰时，使用布德克拉格的作战号角。击败风暴之子瓦杜兰，然后回到布德克拉格庇护所，向塑石者布德克拉格复命。‡找到『風暴降生』瓦杜然後，使用石崖的戰爭號角。擊敗『風暴降生』瓦杜然，然後返回石崖避難所向『塑岩者』石崖報告。',
  }
},
[12985] = {
  {
    'Fazendo a cabeça‡Ковка шлема‡Einen Kopf schmieden‡투구 제작‡Forjar una cabeza‡Forjar una cabeza‡Forger une tête‡雷铸徽记‡鑄造頭部',
    nil,
    'Njormeld, em Dun Niffelem, precisa que você use a Picareta com Ponta de Diamante nos Gigantes de Ferro Mortos, no Lago Congelado, e fale novamente com ele quando tiver coletado 8 Olhos Forjados em Tempestade.‡По заданию Ньормельда в Дун Ниффелеме возьмите кирку с алмазным наконечником, вырвите с ее помощью глаза у мертвых железных великанов у Промерзшего озера и принесите ему 8 глаз Закаленных Бурей.‡Njormeld in Dun Niffelem möchte, dass Ihr mithilfe der Hacke mit Diamantspitze 8 Sturmgeschmiedete Augen von den toten Eisenriesen auf dem Frostfeldsee beschafft und dann anschließend zu ihm zurückkehrt.‡던 니펠렘에 있는 요르멜드가 서리평원 호수에 있는 무쇠 거인 망자에게 다이아몬드날 곡괭이를 사용하여 폭풍으로 벼려낸 눈 8개를 가져와 달라고 부탁했습니다.‡Njormeld en Dun Niffelem necesita que uses el pico con punta de diamante en los gigantes de hierro muertos en el lago Campo de Escarcha y vuelvas cuando tengas 8 ojos de Tronaforjado.‡Njormeld en Dun Niffelem necesita que uses el pico con punta de diamante en los gigantes de hierro muertos en el lago Campo de Escarcha y vuelvas cuando tengas 8 ojos de Tronaforjado.‡Njormeld à Dun Niffelem a besoin de vous pour utiliser la Pioche à pointe de diamant sur les Géants de fer morts au lac du Champ-gelé, puis retournez le voir quand vous aurez récupéré 8 Yeux de Forge-foudre.‡丹尼芬雷的亚米尔德要求你前往霜原湖，对那一带的死亡的铁巨人使用钻石尖锄，收集8枚雷铸徽记，然后回去向他复命。‡丹尼弗蘭的尼約梅爾德要你去霜域湖，在死亡的鐵巨人身上使用鑽石尖端之鎬，收集8個風暴冶煉之眼之後帶回去給他。',
  }
},
[12986] = {
  {
    'O destino dos titãs‡Судьба титанов‡Das Schicksal der Titanen‡티탄의 운명‡El destino de los titanes‡El destino de los titanes‡Le destin des titans‡泰坦的命运‡泰坦的命運',
    nil,
    'Creteus nas Estepes do Sopé pediu para você ir ao Templo da Invenção, ao Templo do Inverno, ao Templo da Vida e ao Templo da Ordem e utilizar o banco de dados para vasculhar cada área.‡По заданию Кретея из Подножия посетите Храм Изобретений, Храм Зимы, Храм Жизни и Храм Порядка. Используйте банк данных для изучения каждого из них.‡Creteus in den Fußmarschen möchte, dass Ihr zum Tempel des Erfindungsreichtums, Tempel des Winters, Tempel des Lebens und zum Tempel der Ordnung reist und mithilfe der Datenbank jeden Bereich untersucht.‡눈봉우리 분지에 있는 크레테우스가 발명의 신전, 겨울의 신전, 생명의 신전, 질서의 신전으로 가서 정보 저장고를 활용하여 각 신전을 조사해 달라고 부탁했습니다.‡Creteus en Las Estepas Inferiores te ha pedido que viajes al Templo de la Invención, el Templo del Invierno, el Templo de la Vida y el Templo del Orden para utilizar el banco de datos y examinar cada zona.‡Creteus en Las Estepas Inferiores te ha pedido que viajes al Templo de la Invención, el Templo del Invierno, el Templo de la Vida y el Templo del Orden para utilizar el banco de datos y examinar cada zona.‡Creteus dans le Pied-mont vous a demandé de vous rendre au Temple de l\'Innovation, au Temple de l\'Hiver, au Temple de la Vie et au Temple de l\'Ordre, et d\'utiliser la Banque de données pour examiner chaque zone.‡山底平原的克莱特乌斯要求你前往创世神殿、寒冬神殿、生命神殿和秩序神殿，并使用数据库探查这些区域。‡足跡冷原的克里圖斯要你前往發明神殿、凜冬神殿、生命神殿以及秩序神殿，使用資料庫來檢驗每個區域。',
  }
},
[12987] = {
  {
    'No devido lugar‡Шлем Ходира‡Hodirs Helm platzieren‡호디르의 투구 놓기‡Colocar el yelmo de Hodir‡La presentación del yelmo de Hodir‡Placer le heaume de Hodir‡放置霍迪尔之盔‡放置霍迪爾之盔',
    nil,
    'Njormeld quer que você voe até o topo no aguilhão de gelo norte em Dun Niffelem e use as Tabuletas do Pronunciamento.‡Летите к острию ледяного шипа в северной части Дун Ниффелема и прочитайте народу Ньормельда текст со скрижалей Утверждения.‡Njormeld möchte, dass Ihr zur Spitze der nördlich gelegenen Eisspitze in Dun Niffelem fliegt und die Worte auf den Tafeln der Verkündung rezitiert.‡요르멜드가 던 니펠렘에 있는 북쪽 얼음창의 끝으로 날아가서 성명의 서판을 사용해 달라고 부탁했습니다.‡Njormeld quiere vueles a la cumbre de la Punta de Hielo del Norte de Dun Niffelem y uses las tablillas de Dictamen.‡Njormeld quiere vueles a la cumbre de la Punta de Hielo del Norte de Dun Niffelem y uses las tablillas de Dictamen.‡Njormeld vous demande de voler vers le sommet des Pointes de glace du Nord à Dun Niffelem et d\'utiliser les Tablettes de déclaration.‡亚米尔德要求你飞到丹尼芬雷北边的冰柱顶端，并在那里使用宣告石板。‡尼約梅爾德要你飛到丹尼弗蘭北邊冰柱的頂端，並使用宣言石板。',
  }
},
[12988] = {
  {
    'Destrua as forjas!‡Штормовые кузни‡Sabotiert die Schmieden!‡가열로 파괴!‡¡Destruye las forjas!‡¡Destruye las forjas!‡Détruisez les forges !‡摧毁熔炉！‡摧毀熔爐!',
    nil,
    'Destrua a Forja Norte do Relâmpago, a Forja Central do Relâmpago e a Forja Sul do Relâmpago com as Bombas de Petrenedo e fale novamente com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Разрушьте северную штормовую кузню, центральную штормовую кузню и южную штормовую кузню с помощью бомб Глыбоскала. Потом возвращайтесь к Глыбоскалу Камнетесу в Приют Глыбоскала.‡Sabotiert die Nordblitzschmiede, die Zentralblitzschmiede und die Südblitzschmiede mit Bergfels\' Bomben. Kehrt dann zu Bergfels dem Steinformer in Bergfels\' Zuflucht zurück.‡바울더크랙의 폭탄을 사용하여 북쪽 번개 가열로, 중앙 번개 가열로, 남쪽 번개 가열로를 파괴한 후, 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Destruye la forja de relámpagos norte, la forja de relámpagos central y la forja de relámpagos sur con las bombas de Pedruscón y después vuelve junto a Pedruscón el Creador de rocas al refugio de Pedruscón.‡Destruye la forja de relámpagos norte, la forja de relámpagos central y la forja de relámpagos sur con las bombas de Pedruscón y después vuelve junto a Pedruscón el Creador de rocas al refugio de Pedruscón.‡Détruisez la Forge de foudre du nord, la Forge de foudre centrale et la Forge de foudre du sud avec les Bombes de Rochecombe, puis retournez voir Rochecombe le Sculpteroc au Refuge de Rochecombe.‡使用布德克拉格的炸弹摧毁北部闪电熔炉、中部闪电熔炉和南部闪电熔炉，然后回到布德克拉格庇护所，向塑石者布德克拉格复命。‡用石崖的炸彈摧毀北方電光熔爐、中央電光熔爐以及南方電光熔爐，然後回到石崖避難所向『塑岩者』石崖回報。',
  }
},
[12989] = {
  {
    'A escuridão serpenteante‡Нашествие тьмы‡Die schleimige Dunkelheit‡드리워진 그늘‡La oscuridad reptadora‡La oscuridad reptadora‡Les ténèbres rampantes‡黑暗的冰虫‡滑溜的黑暗',
    nil,
    'Astrid Bjornrittar quer que você mate 8 Yormungares Vorazes na Caverna Hibérnia a leste da Aldeia Brunnhildar.‡По заданию Астрид Бьорнриттар убейте 8 прожорливых йормунгаров в пещере зимней спячки на востоке от деревни Бруннхильдар.‡Astrid Björnrittar wünscht, dass Ihr 8 gefräßige Jormungar in der Überwinterungshöhle östlich des Dorfes Brunnhildar tötet.‡아스트리드 비요른리타가 브룬힐다르 마을 동쪽에 있는 겨울 동굴에서 포악한 요르문가르 8마리를 처치하라고 부탁했습니다.‡Astrid Bjornrittar quiere que mates a 8 jormungar voraces en la Caverna Hibernal al este del poblado Brunnhildar.‡Astrid Bjornrittar quiere que mates a 8 jormungar voraces en la Caverna Hibernal al este del Poblado Brunnhildar.‡Astrid Bjornrittar vous a demandé de tuer 8 Jormungars voraces à la Caverne de l\'Hibernation à l\'est de Brunnhildar.‡艾丝崔·约利塔尔要你到布伦希尔达村东边的冬眠洞穴去，杀死8条饥饿的冰虫。‡艾絲翠德·畢優利塔要你到布倫希爾達村東邊的凜冬洞窟殺死8隻極餓的蟄猛巨蟲。',
  }
},
[12990] = {
  {
    'O Buraco de Minhoca‡Червоточина‡Das Wurmloch‡벌레 구멍‡El agujero de gusano‡El agujero de gusano‡Le tunnel spatiotemporel‡虫洞‡蟲洞',
    nil,
    'Traga os materiais que Jon LeCraft procura na tentativa de evitar uma morte rápida e aprenda um novo feitiço bacana.‡Принесите Джону Лекрафту нужные ему материалы – и вы не только останетесь в живых, но и узнаете новое заклинание.‡Bringt Jonathan LeCraft die gesuchten Materialien, um einen schnellen Tod zu vermeiden, und erhaltet einen coolen neuen Zauberspruch.‡조나단 리크래프트에게 그가 고통 없는 죽음을 피하기 위해 찾는 물건을 가져간 후, 새로운 주문을 배우십시오.‡Llévale a Jon LeCraft los materiales que necesita para evitar una muerte rápida y para aprender un nuevo hechizo muy chulo.‡Llévale a Jon LeCraft los materiales que necesita para evitar una muerte rápida y para aprender un nuevo hechizo muy chulo.‡Apportez à Jon LeCraft les matériaux qu\'il recherche pour éviter une mort rapide et obtenir un nouveau sort génial.‡为Jon LeCraft带一些材料来，防止他迅速死亡，然后学会一个很棒的新法术。‡把約恩·樂卡夫特要的材料帶給他，避免一死，並且學會一個很酷的新法術。',
  }
},
[12991] = {
  {
    'Atinja o ponto fraco‡Удар по больному месту‡Sie treffen, wo es wehtut‡아픈 곳 쑤시기‡Dales donde más duele‡Dales donde más duele‡Tapez là où ça fait mal‡正中要害‡打擊他們的弱點',
    nil,
    'Mate 10 Artífices Forjados em Tempestade e fale novamente com Bruor Ferruína no Refúgio do Petrenedo.‡Убейте 10 изобретателей из клана Закаленных Бурей и возвращайтесь к Брюору Железорубу в Приют Глыбоскала.‡Tötet 10 Sturmgeschmiedete Konstrukteure und kehrt zu Bruor Eisenbann in Bergfels\' Zuflucht zurück.‡폭풍으로 벼려낸 기술병 10명을 처치한 후 바울더크랙의 은거처에 있는 브루오르 아이언베인에게 돌아가야 합니다.‡Mata a 10 artificieros Tronaforjado y vuelve junto a Bruor Temeferro al Refugio de Pedruscón.‡Mata a 10 artificieros Tronaforjado y vuelve junto a Bruor Temeferro al Refugio de Pedruscón.‡Tuez 10 Artificiers forge-foudre, puis retournez voir Bruor Plaie-du-fer au Refuge de Rochecombe.‡杀死10名雷铸技师，然后返回布德克拉格庇护所，向布鲁沃·斩铁复命。‡殺死10個風暴冶煉設計者，然後返回石崖避難所找布魯爾·鐵禍。',
  }
},
[12992] = {
  {
    'Esmagar Vraikalen!‡Истребление врайкулов‡Tötet die Vrykul!‡브리쿨을 박살내라!‡¡Aplastar a los vrykuls!‡¡Aplastar a los vrykuls!‡Écrasez les vrykuls !‡干掉那些维库人！‡打死那些該死的維酷人!',
    nil,
    'O Torpe, na Abóbada das Sombras, quer que você mate 15 vraikalen em Jotunheim e arredores.‡Убейте 15 врайкулов в районе Йотунхейма по заданию Злоба из Мрачного Свода.‡Ekel im Schattengewölbe möchte, dass Ihr 15 beliebige Vrykul in der weiteren Umgebung von Jotunheim tötet.‡어둠의 무기고에 있는 썩은내가 광범위 요툰하임 지역에서 브리쿨 15마리를 처치해달라고 부탁했습니다.‡Vil en La Cámara de las Sombras quiere que mates a 15 vrykuls cualesquiera en la región de Jotunheim.‡Vil en La Cámara de las Sombras quiere que mates a 15 vrykuls cualesquiera en la región de Jotunheim.‡Vil, au Caveau des Ombres, veut que vous assassiniez 15 Vrykuls dans la région de Jotunheim.‡暗影拱顶的劣尸维尔希望你在尤顿海姆地区消灭15个维库人。‡暗影穹殿的暗邪要你在卓頓海姆區域殺死15個維酷人。',
  }
},
[12993] = {
  {
    'Uma ameaça colossal‡Колоссальная опасность‡Eine kolossale Bedrohung‡거대괴수의 위협‡Una amenaza colosal‡Una amenaza colosal‡Une menace colossale‡巨像的威胁‡巨大的威脅',
    nil,
    'Reúna as Especificações de Ataque e de Defesa do Colosso e leve-as para Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Разыщите документы с наступательными и оборонительными характеристиками колосса и принесите их Глыбоскалу Камнетесу в Приют Глыбоскала.‡Gelangt an die Informationen über die Angriffs- und Verteidigungsfähigkeiten des Kolosses und bringt sie zu Bergfels dem Steinformer in Bergfels\' Zuflucht.‡거대괴수 전투 명세서와 거대괴수 수비 명세서를 회수하여 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 가져가야 합니다.‡Recupera el plan de ataque de coloso y el plan de defensa de coloso y llévaselos a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Recupera el plan de ataque de coloso y el plan de defensa de coloso y llévaselos a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Récupérez le Plan des caractéristiques offensives du colosse et le Plan des caractéristiques défensives du colosse, puis rapportez-les à Rochecombe le Sculpteroc au Refuge de Rochecombe.‡找到巨像攻击规格说明书和巨像防御规格说明书，并把它们交给布德克拉格庇护所的塑石者布德克拉格。‡取得巨像攻擊設計說明書與巨像防禦設計說明書，然後帶去給石崖避難所的『塑岩者』石崖。',
  }
},
[12994] = {
  {
    'Caçador de espiões‡Контрразведчик‡Jagd auf Spione‡첩보원 사냥꾼‡Cazador de espías‡Cazador de espías‡À la chasse aux espions‡猎杀间谍‡間諜獵人',
    nil,
    'Derrote 3 Espiões Forjados em Tempestade no Vale dos Antigos Invernos.|n|nUse o Canino do Worg Etéreo no Cadáver do Worg Caído para evocar um Geloworg Etéreo, que expõe inimigos ocultos. Volte à Grande Mãe Geloworg, em Dun Niffelem, quando o vale estiver livre de espiões.‡Убейте 3 Секретных агентов клана Закаленных Бурей в долине Древних Зим.|n|nС помощью клыка астрального ворга призовите призрачного ледяного ворга, который поможет вам обнаружить скрывающихся врагов. По выполнении задания вернитесь к повелительнице логова ледяных воргов в Дун Ниффелем.‡Ihr müsst 3 Sturmgeschmiedete Spitzel im uralten Wintertal besiegen.|n|nVerwendet den Fangzahn eines astralen Worgs bei der Leiche des gefallenen Worgs und beschwört damit einen astralen Frostworg, mit dessen Hilfe Ihr versteckte Feinde entlarven könnt. Wenn das Tal von den Spionen befreit wurde, sollt Ihr zur Frostworghöhlenmutter in Dun Niffelem zurückkehren.‡고대의 겨울 계곡에 있는 폭풍으로 벼려낸 첩보원 3명을 처치해야 합니다.|n|n실체없는 서리 검은늑대를 소환하려면 쓰러진 검은늑대의 시체에 실체없는 서리 검은늑대의 송곳니를 사용해야 합니다. 송곳니를 사용하면 숨어 있는 적이 드러납니다. 첩보원을 처치한 후, 던 니펠렘에 있는 우두머리 서리 검은늑대에게 돌아가야 합니다.‡Debes derrotar a 3 espías Tronaforjado en el Valle de los Viejos Inviernos.|n|nUsa el colmillo de huargo etéreo sobre el cadáver de huargo caído para invocar a un huargo de escarcha etéreo que descubrirá a los enemigos ocultos. Debes volver junto a la madre del cubil huargo de escarcha en Dun Niffelem cuando hayas acabado con los espías del valle.‡Debes derrotar a 3 espías Tronaforjado en el Valle de los Viejos Inviernos.|n|nUsa el colmillo de huargo etéreo sobre el cadáver de huargo caído para invocar a un huargo de escarcha etéreo que descubrirá a los enemigos ocultos. Debes volver junto a la madre del cubil huargo de escarcha en Dun Niffelem cuando hayas acabado con los espías del valle.‡Vous devez vaincre 3 Espions forge-foudre dans la Vallée des Anciens hivers.|n|nUtilisez le Croc de worg éthérien sur place pour invoquer un Chasseur éthérien qui débusquera les ennemis cachés. Vous devez retourner auprès de la Mère de la tanière worg de givre à Dun Niffelem une fois la vallée nettoyée de ces espions.‡击败上古寒冬山谷中的3名雷铸间谍。|n|n对座狼的尸体使用灵体座狼之牙，召唤出一只灵体冰霜座狼，帮助你找出隐藏的敌人。完成任务之后向丹尼芬雷的冰霜座狼母兽复命。‡你必須到遠古寒冬山谷擊敗3個風暴冶煉間諜。|n|n在死去座狼的屍體旁使用以太座狼之牙可以召喚一頭以太霜座狼使隱藏的敵人暴露行蹤。當你除去了山谷中的間諜以後，回到丹尼弗蘭找冰霜座狼獸母。',
  }
},
[12995] = {
  {
    'Deixando nossa marca‡Наша метка‡Setzt ein Zeichen‡흔적을 남겨라‡Dejar nuestra huella‡Dejar nuestra huella‡Laisser notre marque‡彰显军威‡留下我們的記號',
    nil,
    'O Barão Laska, na Abóbada das Sombras, quer que você coloque 15 Estandartes da Lâmina de Ébano perto dos cadáveres dos vraikalen encontrados em Jotunheim e arredores.‡По заданию барона Раздора из Мрачного Свода воткните 15 знамен Черного Клинка рядом с телами мертвых врайкулов в районе Йотунхейма.‡Baron Splitter im Schattengewölbe wünscht, dass Ihr 15 Banner der Schwarzen Klinge in die Nähe der Vrykulleichen steckt, die Ihr in der weiteren Umgebung von Jotunheim findet.‡어둠의 무기고에 있는 남작 슬리버가 광범위 요툰하임 지역에서 발견하는 브리쿨 시체 근처에 칠흑의 기사단 깃발 15개를 꽂아달라고 했습니다.‡El Barón Tajada en La Cámara de las Sombras quiere que coloques 15 estandartes de la Espada de Ébano sobre los cadáveres de los vrykuls que encuentres en la región de Jotunheim.‡El Barón Tajada en La Cámara de las Sombras quiere que coloques 15 estandartes de la Espada de Ébano sobre los cadáveres de los vrykuls que encuentres en la región de Jotunheim.‡Le Baron Lesquille, au Caveau des Ombres, veut que vous plantiez 15 Bannières de la Lame d\'ébène près des cadavres de Vrykuls trouvés dans la région de Jotunheim.‡暗影拱顶的斯利文男爵希望你前往尤顿海姆地区，将黑锋旗帜插在15具维库人的尸体附近。‡暗影穹殿的史力弗男爵，要你將15枝黯刃旌旗插在卓頓海姆區域找到的維酷人屍體身上。',
  }
},
[12996] = {
  {
    'O aquecimento‡Тренировочный заезд‡Das Aufwärmen‡사전 연습‡El calentamiento‡El calentamiento‡Tour de chauffe‡热身赛‡熱身',
    nil,
    'Astrid Bjornrittar na Aldeia Brunnhildar quer que você use as Rédeas da Matriarca Ursa de Guerra para derrotar Kirgaraak.‡Воспользуйтесь поводьями матриарха ледочревов, чтобы сразиться с Киргарааком, как вам велела Астрид Бьорнриттар из деревни Бруннхильдар.‡Astrid Björnrittar aus Brunnhildar möchte, dass Ihr die Zügel der Kriegsbärenmatriarchin nutzt, um Kirgaraak zu besiegen.‡브룬힐다르 마을에 있는 아스트리드 비요른리타가 우두머리 전투곰 고삐를 사용하여 키르가라아크를 무찔러 달라고 부탁했습니다.‡Astrid Bjornrittar del poblado Brunnhildar quiere que uses las riendas de matriarca Osoguerra para derrotar a Kirgaraak.‡Astrid Bjornrittar del Poblado Brunnhildar quiere que uses las riendas de matriarca oso de guerra para derrotar a Kirgaraak.‡Astrid Bjornrittar à Brunnhildar veut que vous utilisiez les Rênes de matriarche ours de guerre pour vaincre Kirgaraak.‡布伦希尔达村的艾丝崔·约利塔尔要你使用冰喉母熊的缰绳打败基加拉格。‡布倫希爾達村的艾絲翠德·畢優利塔要你用戰熊族母韁繩來擊敗齊爾加瑞克。',
  }
},
[12997] = {
  {
    'Para o fosso‡В Яму!‡In die Grube‡구덩이 속으로‡Al foso‡Al foso‡Dans la fosse‡进入利齿之坑‡進入深淵',
    nil,
    'Astrid Bjornrittar na Aldeia Brunnhildar quer que você use as Rédeas da Matriarca Ursa de Guerra no Fosso da Presa e derrote 6 Ursos de Guerra do Tornehylde.‡Отправляйтесь в Яму Клыка, воспользуйтесь поводьями матриарха ледочревов и победите 6 боевых медведей Круга хильд по заданию Астрид Бьорнриттар из деревни Бруннхильдар.‡Astrid Björnrittar aus Brunnhildar möchte, dass Ihr in die Reißzahngrube geht und mit den Zügeln der Kriegsbärenmatriarchin 6 Kriegsbären des Hildarthings besiegt.‡브룬힐다르 마을에 있는 아스트리드 비요른리타가 송곳니 구덩이 안에서 우두머리 전투곰 고삐를 사용하여 6마리의 힐드스미트 전투곰을 처치해 달라고 부탁했습니다.‡Astrid Bjornrittar del poblado Brunnhildar quiere que uses las riendas de matriarca Osoguerra dentro del Foso del Colmillo y derrotes a 6 osos de guerra de El Encuentro Hyldnir.‡Astrid Bjornrittar del Poblado Brunnhildar quiere que uses las riendas de matriarca oso de guerra dentro del Foso del Colmillo y derrotes a 6 osos de guerra de El Encuentro Hyldnir.‡Astrid Bjornrittar à Brunnhildar veut que vous utilisiez les Rênes de matriarche ours de guerre dans la Fosse du croc et que vous battiez 6 Ours de guerre du Hyldsmeet.‡布伦希尔达村的艾丝崔·约利塔尔要你在利齿之坑里使用冰喉母熊的缰绳，并打败6头海德比武会战熊。‡布倫希爾達村的艾絲翠德·畢優利塔要求你，在尖牙之淵裡使用戰熊族母韁繩，擊敗6頭海茲競技戰熊。',
  }
},
[12998] = {
  {
    'O coração da tempestade‡Сердце бури‡Das Herz des Sturms‡폭풍의 심장‡El Corazón de la Tormenta‡El Corazón de la Tormenta‡Le Cœur de la tempête‡风暴之心‡風暴之芯',
    nil,
    'Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo, quer que você vá a Uldis e tente impedir que o Feitor Narvir consiga o Coração da Tempestade.‡По поручению Глыбоскала Камнетеса из Приюта Глыбоскала отправляйтесь в Ульдис и сделайте все возможное, чтобы надзиратель Нарвир не сумел заполучить Сердце бури.‡Bergfels der Steinformer in Bergfels\' Zuflucht möchte, dass Ihr nach Uldis reist und versucht, Aufseher Narvir daran zu hindern, an das Herz des Sturms zu gelangen.‡바울더크랙의 은거처에 있는 돌조각장이 바울더크랙이 울디스로 가서 감시자 나르비르가 폭풍의 심장을 손에 넣지 못하도록 해 달라고 부탁했습니다.‡Pedruscón el Creador de rocas en el Refugio de Pedruscón quiere que viajes a Uldis e intentes evitar que el Sobrestante Narvir consiga el Corazón de la Tormenta.‡Pedruscón el Creador de rocas en el Refugio de Pedruscón quiere que viajes a Uldis e intentes evitar que el Sobrestante Narvir consiga el Corazón de la Tormenta.‡Rochecombe le Sculpteroc au Refuge de Rochecombe veut que vous alliez à Uldis pour essayer d\'empêcher que le Surveillant Narvir n\'obtienne le Cœur de la tempête.‡布德克拉格庇护所的塑石者布德克拉格希望你前往奥迪斯，尝试阻止纳维尔获取风暴之心。‡石崖避難所的『塑岩者』石崖要你前往奧迪斯，阻止監督者那維爾取得風暴之芯。',
  }
},
[12999] = {
  {
    'A Bruxa dos Ossos‡Костяная ведьма‡Die Knochenhexe‡해골 마녀‡La Bruja Osaria‡La Bruja Osaria‡La sorcière des ossements‡白骨女巫‡骸骨女巫',
    nil,
    'Fale com a Bruxa dos Ossos dentro da caverna na Vila Njorndar.‡Поговорите с костяной ведьмой в пещере в деревне Ньорндар.‡Sprecht mit der Knochenhexe in der Höhle des Dorfes Njorndar.‡요른다르 마을에 있는 동굴에서 해골 마녀와 대화해야 합니다.‡Habla con la Bruja Osaria en la cueva del poblado Njorndar.‡Habla con la Bruja Osaria en la cueva del poblado Njorndar.‡Parlez à la Sorcière des ossements dans la caverne, à Njorndar.‡前往约尔达村附近的洞穴，与白骨女巫谈一谈。‡與尼約達村洞穴中的骸骨女巫交談。',
  }
},
[13000] = {
  {
    'Medidas de emergência‡Чрезвычайные меры‡Notfallmaßnahmen‡응급 조치‡Medidas de emergencia‡Medidas de emergencia‡Mesures d\'urgence‡紧急措施‡緊急措施',
    nil,
    'A Guarda-de-Sangue Lorga quer que você vá ao Covil de Gimorak a leste e consiga 6 Peles de Worg.‡Отправляйтесь в Логово Гиморака на востоке и добудьте 6 шкур воргов по просьбе кровостража Лорги.‡Ihr befindet Euch auf dieser Quest.‡혈투사 로르가가 동쪽에 있는 기모라크의 동굴로 가서 늑대 모피 6장을 얻어오라고 부탁했습니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[13001] = {
  {
    'Forja da lança de Hodir‡Копье Ходира‡Hodirs Speer schmieden‡호디르의 창 벼리기‡Forjar la lanza de Hodir‡La forja de la lanza de Hodir‡Forger la lance de Hodir‡打造霍迪尔之矛‡打造霍迪爾之矛',
    nil,
    'O Erudito Randvir em Dun Niffelem quer que você colete 3 Estilhaços de Gelo Eterno das profundezas da Caverna Hibérnia e 3 Peles de Mamute Estoico no Vale dos Antigos Invernos.‡Добудьте 3 осколка Вечного льда в пещере зимней спячки и 3 шкуры спокойных мамонтов в долине Древних Зим и отнесите все сказителю Рандвиру в Дун Ниффелем.‡Hüter des Wissens Randvir aus Dun Niffelem möchte, dass Ihr 3 Immerfrostsplitter aus den Tiefen der Überwinterungshöhle sowie 3 Bälge ruhiger Mammuts aus dem uralten Wintertal holt.‡던 니펠렘에 있는 현자 란드비르에게 겨울 동굴 깊숙한 곳에서 얻은 영원의 서리 조각 3개와 고대의 겨울 계곡에 있는 강인한 매머드에게서 강인한 매머드 가죽 3장을 가져가야 합니다.‡El Tradicionalista Randvir en Dun Niffelem quiere que recojas 3 fragmentos de siempreescarcha en las profundidades de la Caverna Hibernal y 3 pieles de mamut estoico de los mamuts estoicos del Valle de los Viejos Inviernos.‡El Tradicionalista Randvir en Dun Niffelem quiere que recojas 3 fragmentos de siempreescarcha en las profundidades de la Caverna Hibernal y 3 pieles de mamut estoico de los mamuts estoicos del Valle de los Viejos Inviernos.‡Le Gardien du savoir Randvir à Dun Niffelem vous a demandé de récupérer 3 Éclats permagivre des profondeurs de la Caverne de l\'hibernation et 3 Peaux de mammouth stoïque dans la Vallée des Anciens hivers.‡丹尼芬雷的博学者兰德维尔要求你前往冬眠洞穴收集3块永冻碎片，并从上古寒冬山谷的坚韧猛犸象身上收集3块坚韧猛犸象的毛皮。‡丹尼弗蘭的博學者蘭德維爾要你從凜冬洞窟的深處收集3個永霜裂片，以及從遠古寒冬山谷的堅忍的長毛象身上取得3個堅忍的長毛象皮革。',
  }
},
[13002] = {
  {
    'Gema Perfeita‡Огранка камней‡Edelsteine perfektionieren‡보석의 완벽함‡Gemas perfectas‡Gemas perfectas‡La perfection des gemmes‡完美宝石‡寶石完美工法',
    nil,
    'Traga dois Citrinos Grandes, dois Jades-escuros e dois Cristais Sombrios para Geba\'li na Fortaleza Brado Guerreiro.‡Принесите два огромных цитрина, два темных нефрита и два сумрачных кристалла Геба\'ли в Крепость Песни Войны.‡Bringt zwei Riesencitrin, zwei Nephrite und zwei Schattenkristalle zu Geba\'li in der Kriegshymnenfeste.‡전쟁노래부족 요새에 있는 게바리에게 거대 황수정 2개, 암색 비취 2개, 암흑 수정 2개를 가져가야 합니다.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de Sombras a Geba\'li en el Bastión Grito de Guerra.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de Sombras a Geba\'li en el Bastión Grito de Guerra.‡Geba\'li, du Bastion Chanteguerre, a besoin de deux Enormes citrines, de deux Jades sombres et de deux Cristaux ombreux.‡将茶晶石、黑玉和暗影水晶各两颗交给战歌要塞的格巴里。‡將兩顆巨黃晶、兩顆暗玉和兩顆暗影水晶交給戰歌堡的賈巴利。',
  }
},
[13003] = {
  {
    'Como matar seu dragão‡Как убить дракона‡Drachentöten leicht gemacht‡고룡을 처치하는 법‡Cómo matar a tu dragón‡Cómo matar a tu dragón‡L’art de bien tuer son dragon‡屠龙记‡屠龍高手',
    nil,
    'Use a Lança de Hodir para desafiar a Serpe Selvagem no Vale dos Antigos Invernos. Uma vez iniciado o combate, vocês lutarão até a morte.‡С помощью копья Ходира загарпуньте дикого змея в долине Древних Зим и сразитесь с ним не на жизнь, а на смерть.‡Ihr sollt mit Hodirs Speer einen Wildwyrm im uralten Wintertal herausfordern. Wenn Ihr ihn getroffen habt, muss es zu einem Kampf auf Leben und Tod kommen.‡호디르의 창을 사용하여 고대의 겨울 계곡에 있는 야생 고룡에게 도전해야 합니다. 창을 쥐면 죽을 때까지 싸워야 합니다.‡Debes usar la lanza de Hodir para retar a una vermis salvaje en el Valle de los Viejos Inviernos. Cuando estés entre sus garras, lucha contra ella hasta la muerte.‡Debes usar la lanza de Hodir para retar a una vermis salvaje en el Valle de los Viejos Inviernos. Cuando estés entre sus garras, lucha contra ella hasta la muerte.‡Vous devez utiliser la Lance de Hodir pour défier un Wyrm sauvage dans la Vallée des Anciens hivers. Une fois que c\'est fait, vous devez vous battre à mort.‡使用霍迪尔之矛挑衅上古寒冬山谷的野生巨龙，然后与它决一死战。‡你要用霍迪爾之矛在遠古寒冬山谷挑戰一頭野生巨龍。一旦與牠接觸，你就得與之奮戰，至死方休。',
  }
},
[13004] = {
  {
    'Gema Perfeita‡Огранка камней‡Edelsteine perfektionieren‡보석의 완벽함‡Gemas perfectas‡Gemas perfectas‡La perfection des gemmes‡完美宝石‡寶石完美工法',
    nil,
    'Traga dois Citrinos Grandes, dois Jades-escuros e dois Cristais Sombrios para Alestros na Bastilha Valentia.‡Принесите два огромных цитрина, два темных нефрита и два сумрачных кристалла Алестосу в Крепость Отваги.‡Bringt zwei Riesencitrin, zwei Nephrite und zwei Schattenkristalle zu Alestros in der Valianzfeste.‡용맹의 성채에 있는 알레스토스에게 거대 황수정 2개, 암색 비취 2개, 암흑 수정 2개를 가져가야 합니다.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de Sombras a Alestros en la Fortaleza Denuedo.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de Sombras a Alestros en la Fortaleza Denuedo.‡Alestros, du Donjon de la Bravoure, a besoin de deux Énormes citrines, de deux Jades sombres et de deux Cristaux ombreux.‡将茶晶石、黑玉和暗影水晶各两颗交给无畏要塞的奥雷斯托斯。‡將兩顆巨黃晶、兩顆暗玉與兩顆暗影水晶交給驍勇要塞的亞雷史托斯。',
  }
},
[13005] = {
  {
    'Juramento Terrano‡Клятва детей земли‡Der Eid der Irdenen‡토석인의 서약‡El juramento terráneo‡El juramento terráneo‡Le serment des Terrestres‡土灵的誓言‡土靈誓約',
    nil,
    'Thorim, no Terraço dos Criadores, quer que você use a Trompa dos Picos e convoque os Terranos para derrotar 20 Anões de Ferro e 7 Sentinelas de Ferro.‡Используйте рог Вершин, чтобы призвать земельников на битву с железными дворфами и убить 20 железных дворфов и 7 железных часовых по просьбе Торима с Террасы Творцов.‡Thorim, auf der Terrasse der Schöpfer, wünscht, dass Ihr in das Horn der Sturmgipfel blast und die Irdenen ruft, damit sie 20 Eisenzwerge und 7 Eisenschildwachen besiegen.‡창조주의 거처에 있는 토림이 봉우리의 뿔피리를 울려 토석인들을 불러모아 20명의 무쇠 드워프 습격자와 7명의 무쇠 파수꾼을 처치해 달라고 부탁했습니다.‡Thorim, en el Bancal de los Creadores, quiere que uses el cuerno de Las Cumbres para llamar a los terráneos y derrotar a 20 enanos férreos y a 7 centinelas de hierro.‡Thorim, en el Bancal de los Creadores, quiere que uses el cuerno de Las Cumbres para llamar a los terráneos y derrotar a 20 enanos férreos y a 7 centinelas de hierro.‡Thorim, à la Terrasse des Faiseurs, vous demande d\'utiliser le Cor des pics pour appeler les Terrestres, et vaincre 20 Nains de fer et 7 Sentinelles de fer.‡造物者圣台的托里姆要求你使用峭壁号角召集土灵，并打败20个铁矮人和7个铁哨兵。‡造物者殿堂的索林姆要你用群山號角召來土靈，擊敗20個鐵矮人與7個鐵哨兵。',
  }
},
[13006] = {
  {
    'Limpeza viscosa‡Полировка кислотой‡Eine schmierige Säuberung‡끈적이는 윤내기‡Una limpieza viscosa‡Una limpieza viscosa‡Nettoyage à suc‡粘滞清洁‡油光煥發',
    nil,
    'Entre na Caverna Hibérnia a oeste de Dun Niffelem e colete 5 unidades de Óleo Viscoso ali.|n|nVolte em seguida para Dun Niffelem e aplique o óleo no Elmo de Hodir.‡Идите в пещеру зимней спячки и соберите 5 сгустков вязкого масла злобных масленышей. Потом возвращайтесь в Дун Ниффелем и натрите маслом шлем Ходира.‡Ihr müsst Euch in die Überwinterungshöhle westlich von Dun Niffelem begeben und 5 Einheiten viskoses Öl vom Rohöl dort besorgen.|n|nKehrt dann nach Dun Niffelem zurück und tragt das Öl auf Hodirs Helm auf.‡던 니펠렘의 서쪽에 있는 겨울 동굴로 들어가 그곳에 있는 점성 기름덩어리에서 점성 기름 5개를 얻은 후, 던 니펠렘으로 돌아가 호디르의 투구에 원유를 부어야 합니다.‡Debes entrar en la Caverna Hibernal al oeste de Dun Niffelem y recoger 5 unidades de aceite viscoso de los aceites viscosos que hay allí.|n|nDespués debes volver a Dun Niffelem y aplicar el aceite sobre el yelmo de Hodir.‡Debes entrar en la Caverna Hibernal al oeste de Dun Niffelem y recoger 5 unidades de aceite viscoso de los aceites viscosos que hay allí.|n|nDespués debes volver a Dun Niffelem y aplicar el aceite sobre el yelmo de Hodir.‡Vous devez aller à la Caverne de l\'hibernation à l\'ouest de Dun Niffelem pour récupérer 5 unités d\'Huile visqueuse sur les créatures du même nom sur place.|n|nVous devez ensuite retourner à Dun Niffelem pour appliquer l\'huile sur le Heaume de Hodir.‡进入丹尼芬雷以西的冬眠洞穴，从粘性油污身上收集5份粘性油。|n|n然后返回丹尼芬雷，将油涂在霍迪尔的头盔上。‡你要進入丹尼弗蘭西方的凜冬洞窟，並收集5份黏性油。然後回到丹尼弗蘭將油使用在霍迪爾之盔上。',
  }
},
[13007] = {
  {
    'O colosso de ferro‡Железный колосс‡Der Eisenkoloss‡무쇠 거대괴수‡El coloso de hierro‡El coloso de hierro‡Le colosse de fer‡钢铁巨像‡鐵巨像',
    nil,
    'Use um Yormungar Domado para derrotar o Colosso de Ferro e fale novamente com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Уничтожьте железного колосса с помощью прирученного йормунгара, а потом возвращайтесь к Глыбоскалу Камнетесу в Приют Глыбоскала.‡Nutzt einen gezähmten Jormungar, um den Eisenkoloss zu besiegen, und kehrt dann zu Bergfels dem Steinformer in Bergfels\' Zuflucht zurück.‡길들인 요르문가르를 사용하여 무쇠 거대괴수를 쓰러트리고 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Usa a un jormungar domado para derrotar al coloso de hierro y volver con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Usa a un jormungar domado para derrotar al coloso de hierro y volver con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Utilisez un Jormungar apprivoisé pour vaincre le Colosse de fer, puis retournez voir Rochecombe le Sculpteroc au Refuge de Rochecombe.‡使用被驯服的冰虫击败钢铁巨像，然后回到布德克拉格庇护所，向塑石者布德克拉格复命。‡用被馴服的蟄猛巨蟲擊敗鐵巨像，然後返回石崖避難所向『塑岩者』石崖回報。',
  }
},
[13008] = {
  {
    'Táticas do Flagelo‡Тактика Плети‡Die Taktik der Geißel‡스컬지 작전‡Tácticas de la Plaga‡Tácticas de la Plaga‡Les tactiques du Fléau‡天灾的战术‡天譴戰術',
    nil,
    'O Comandante Cruzado Entari, na Vanguarda Argêntea, que fica na Coroa de Gelo, quer que você liberte 8 Cruzados Enredados.‡Освободите 8 опутанных рыцарей по заданию командира рыцарей Энтари из Оплота Серебряного Авангарда в Ледяной Короне.‡Kreuzzugskommandant Entari in der Argentumvorhut von Eiskrone bittet Euch, 8 eingesponnene Kreuzfahrer zu befreien.‡얼음왕관의 은빛십자군 선봉기지에 있는 십자군 사령관 엔타리가 거미줄에 감긴 성전사 8명을 자유롭게 해달라고 부탁했습니다.‡El Comandante de Cruzada Entari en La Vanguardia Argenta en Corona de Hielo te ha pedido que liberes a 8 cruzados enredados.‡El Comandante de Cruzada Entari en La Vanguardia Argenta en Corona de Hielo te ha pedido que liberes a 8 cruzados enredados.‡Le Commandant de la croisade Entari, à l\'Avant-garde d\'Argent dans la Couronne de glace, vous a demandé de libérer 8 Croisés entoilés.‡冰冠冰川银色前线基地的北伐军指挥官恩塔里要求你去解救8名被网住的北伐军士兵。‡銀白先鋒駐地的十字軍指揮官恩塔利要你解救8位被網住的十字軍。',
  }
},
[13009] = {
  {
    'Um novo começo‡Новое начало‡Ein Neuanfang‡새로운 시작‡Un nuevo comienzo‡Un nuevo comienzo‡Un nouveau départ‡新的开始‡新的開始',
    nil,
    'Njormeld quer que você leve a armadura Reforjada para Thorim no Templo das Tempestades.‡Отнесите перекованные доспехи Торима в Храм Штормов по просьбе Ньормельда.‡Njormeld wünscht, dass Ihr die neugeschmiedete Rüstung zu Thorim im Tempel der Stürme bringt.‡요르멜드가 폭풍의 신전에 있는 토림에게 재련된 폭풍군주의 갑옷을 가져가 달라고 부탁했습니다.‡Njormeld quiere que le lleves la armadura reforjada a Thorim en el Templo de las Tormentas.‡Njormeld quiere que le lleves la armadura reforjada a Thorim en el Templo de las Tormentas.‡Njormeld veut que vous apportiez l\'Armure reforgée à Thorim au Temple des tempêtes.‡亚米尔德要求你将重铸的风暴之王铠甲交给风暴神殿的托里姆。‡尼約梅爾德要你把重鑄護甲帶去風暴神殿給索林姆。',
  }
},
[13010] = {
  {
    'Krolmir, o Martelo das Tempestades‡Кролмир, Молот Бурь‡Krolmir, Hammer der Stürme‡폭풍의 망치, 크롤미르‡Krolmir, el Martillo de las Tormentas‡Krolmir, el Martillo de las Tormentas‡Krolmir, le marteau des tempêtes‡科洛米尔，风暴之锤‡克洛米爾，風暴之錘',
    nil,
    'Thorim quer que você fale com o Rei Iokkum em Dun Niffelem e descubra o que ele sabe sobre Krolmir.‡Поговорите с королем Йоккумом в Дун Ниффелеме и попробуйте выяснить, что ему известно о Кролмире, принадлежавшем Ториму.‡Thorim möchte, dass Ihr mit König Jokkum in Dun Niffelem sprecht und in Erfahrung bringt, was er über Krolmir weiß.‡토림이 던 니펠렘에 있는 제왕 요쿰과 대화하여 크롤미르에 대해서 알고 있는 사실을 확인해 달라고 부탁했습니다.‡Thorim quiere que hables con el rey Jokkum en Dun Niffelem y que descubras lo que sabe sobre Krolmir.‡Thorim quiere que hables con el rey Jokkum en Dun Niffelem y que descubras lo que sabe sobre Krolmir.‡Thorim vous demande d\'aller parler au Roi Jokkum à Dun Niffelem et de découvrir ce qu\'il sait à propos de Krolmir.‡托里姆要你与丹尼芬雷的约库姆国王谈一谈，向他打听科洛米尔的消息。‡索林姆要你與丹尼弗蘭的裘庫姆王談話，並瞭解他對克洛米爾知道多少。',
  }
},
[13011] = {
  {
    'Abate do Yorcuttar‡Усмирение Йормуттар‡Jorkuttar töten‡요르쿠타르 잡기‡Jorcuttar debe morir‡La última cena de Jorcuttar‡Éliminer Jorcuttar‡斩除尤卡塔尔‡解決喬克塔',
    nil,
    'O Rei Iokkum, de Dun Niffelem, quer que você mate Yorcuttar na Caverna Hibérnia.‡По приказу короля Йоккума из Дун Ниффелема убейте Йоркуттар в пещере зимней спячки.‡König Jokkum in Dun Niffelem möchte, dass Ihr in die Überwinterungshöhle geht und Jorkuttar niederstreckt.‡던 니펠렘에 있는 제왕 요쿰이 겨울 동굴에 있는 요르쿠타르를 처치해 달라고 했습니다.‡El rey Jokkum en Dun Niffelem quiere que mates a Jorcuttar en la Caverna Hibernal.‡El rey Jokkum en Dun Niffelem quiere que mates a Jorcuttar en la Caverna Hibernal.‡Le Roi Jokkum à Dun Niffelem vous demande de tuer Jorcuttar à la Caverne de l’hibernation.‡丹尼芬雷的约库姆国王要求你前往冬眠洞穴，杀死尤卡塔尔。‡丹尼弗蘭的裘庫姆王要你去凜冬洞窟殺死喬克塔。',
  }
},
