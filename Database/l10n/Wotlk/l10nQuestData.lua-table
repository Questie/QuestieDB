[7810] = {
  {
    'Mestre da Arena‡Повелитель арены‡Meister der Arena‡검투사‡El maestro de la arena‡El maestro de la arena‡Le maître de l\'arène‡竞技场高手‡競技場大師',
    nil,
    'Fale com João Tampinha Mithril na Arena da Selva do Espinhaço.‡Поговорите с Коротышкой Джоном Мифрилом на арене Тернистой долины.‡Begebt Euch in die Arena des Schlingendorntals und sprecht mit Störtebrecher.‡가시덤불 골짜기에 원형투기장에 있는 땅딸보 존 미스릴과 대화해야 합니다.‡Habla con Corto John Mitril en la Arena de la Vega de Tuercespina.‡Habla con Corto John Mitril en la Arena de la Vega de Tuercespina.‡Parler à Court John Mithril dans l\'arène de Strangleronce.‡与荆棘竞技场的小个子约翰·米斯瑞尔谈一谈。‡與荊棘競技場的小個子約翰·米斯瑞爾談話。',
  }
},
