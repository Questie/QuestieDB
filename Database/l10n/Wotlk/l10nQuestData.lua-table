[8383] = {
  {
    'Lembrem-se do Vale Alterac!‡Помни Альтеракскую долину!‡Vergesst das Alteractal nicht!‡잊지 말자, 알터랙 계곡!‡¡Recuerda el Valle de Alterac!‡¡Recuerda el Valle de Alterac!‡Souvenez-vous de la vallée d\'Alterac !‡铭记奥特兰克！‡銘記奧特蘭克!',
    nil,
    '‡Принесите 3 почетных знака Альтеракской долины бригадному генералу Альянса рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à un général de brigade de l\'Alliance, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章交给战场外的联盟准将。‡',
  }
},
[8384] = {
  {
    '‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡아라시 분지 공격‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin Arathi‡占领阿拉希盆地‡戰爭的動力',
    nil,
    '‡Принесите 3 почетных знака Низины Арати бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du Bassin Arathi à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡',
  }
},
[8385] = {
  {
    'Esforços combinados‡В едином порыве‡Gemeinsames Bestreben‡공동의 노력‡Esfuerzos concertados‡Esfuerzos concertados‡Des efforts concertés‡共同的努力‡共同的努力',
    nil,
    '‡Принесите почетные знаки каждого поля боя ордынскому вестнику войны в любую столицу Орды или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Kriegshetzer der Horde in einer der Hauptstädte oder in Shattrath.‡‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Apportez 1 Marque d\'honneur de chaque champ de bataille à un Porteguerre de la Horde, dans n\'importe quelle capitale de la Horde ou à Shattrath.‡把1枚奥特兰克山谷荣誉奖章，1枚阿拉希盆地荣誉奖章，1枚战歌峡谷荣誉奖章和1枚暴风之眼荣誉奖章交给任何一座部落主城或撒塔斯的部落战争使者。‡',
  }
},
[8386] = {
  {
    '‡Битва за Ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡战歌峡谷之战‡自然屏障',
    nil,
    '‡Принесите 3 почетных знака Ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡',
  }
},
[8387] = {
  {
    'Invasores do Vale Alterac‡Вторжение в Альтеракскую долину‡Die Invasoren des Alteractals‡알터랙 계곡의 침략자‡Invasores del Valle de Alterac‡Invasores del Valle de Alterac‡Les envahisseurs de la vallée d\'Alterac‡奥特兰克的入侵者‡奧特蘭克的入侵者',
    nil,
    '‡Принесите 3 почетных знака Альтеракской долины ордынскому вестнику войны рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 전쟁인도자에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à l\'un des porteguerres de la Horde, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章交给战场外的部落战争使者。‡',
  }
},
[8388] = {
  {
    'Por grande honra‡Великая честь‡Große Ehre‡커다란 영광을 위하여‡Cuestión de honor‡Cuestión de honor‡Pour le plus grand des honneurs‡无上的荣耀‡無上的榮耀',
    nil,
    '‡Принесите почетные знаки каждого поля боя ордынскому вестнику войны в любую столицу Орды или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Kriegshetzer der Horde in einer der Hauptstädte oder in Shattrath.‡‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Apportez 1 Marque d\'honneur de chaque champ de bataille à un Porteguerre de la Horde, dans n\'importe quelle capitale de la Horde ou à Shattrath.‡把1枚奥特兰克山谷荣誉奖章，1枚阿拉希盆地荣誉奖章，1枚战歌峡谷荣誉奖章和1枚暴风之眼荣誉奖章交给任何一座部落主城或撒塔斯的部落战争使者。‡',
  }
},
[8389] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
