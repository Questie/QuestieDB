[25181] = {
  {
    'Tabuletas de Fogo‡Скрижали огня‡Tafeln des Feuers‡불의 서판‡Tablillas de fuego‡Tablillas de fuego‡Les tablettes du Feu‡火之石板‡火焰石板',
    nil,
    'Leve as Tabuletas de Fogo para a Vidente Bahura em Orgrimmar.‡Принесите скрижали огня провидице Бахуре в Оргриммар.‡Bringt die Tafeln des Feuers zu Seherin Bahura in Orgrimmar.‡오그리마에 있는 현자 바후라에게 불의 서판을 가져가야 합니다.‡Llévale las tablillas de fuego al vidente Bahura en Orgrimmar.‡Llévale las tablillas de fuego al vidente Bahura en Orgrimmar.‡Apportez les Tablettes du Feu à la Voyante Bahura à Orgrimmar.‡将火之石板带给奥格瑞玛的先知芭胡拉。‡將火焰石板交給奧格瑪的先知巴胡拉。',
  }
},
[25199] = {
  {
    '‡Начальная подготовка‡Grundbefehle‡기초 훈련‡Órdenes básicas‡Órdenes básicas‡Des ordres simples‡基本命令‡基礎命令',
    nil,
    '‡Следуйте командам сержанта-инструктора Парогона, после чего вернитесь к капитану Ступу Искражу.‡Folgt Ausbildungsoffizier Dampfkurbels Befehlen und meldet Euch dann bei Hauptmann Tret Funkdüse zurück.‡훈련교관 스팀크랭크가 보여주는 신호를 따라 한 후 대장 트레드 스파크노즐에게 보고해야 합니다.‡Sigue las indicaciones del sargento de maniobras Mecavapor y luego vuelve a informar al capitán Tread Chispaboquilla.‡Sigue las indicaciones del sargento de maniobras Mecavapor y luego vuelve a informar al capitán Tread Chispaboquilla.‡Suivez les instructions du Sergent instructeur Nébulevier, puis faites votre rapport au Capitaine Chape Étincetuyère.‡完成教官汽轴的命令，然后回去向崔德·火钻队长报告。‡',
  }
},
[25212] = {
  {
    '‡Разведать обстановку‡Am Rande der Schächte‡‡Horizonte de conductos‡Horizonte de conductos‡Radiations à l\'horizon‡通风口测量‡通風地平線',
    nil,
    '‡Воспользуйтесь летательным аппаратом пилота Винтоуха, чтобы сбросить радиометрозиметры в вентиляционные шахты Гномрегана.‡Benutzt Pilot Sprossmündungs Flugmaschine, um Radiageigatrons auf die Luftschächte um Gnomeregan herum zu werfen.‡‡Utiliza la máquina voladora del piloto Engranahocico para lanzar Radiageigatrones a los conductos de ventilación que rodean Gnomeregan.‡Utiliza la máquina voladora del piloto Engranahocico para lanzar Radiageigatrones a los conductos de ventilación que rodean Gnomeregan.‡Servez-vous de la machine volante du Pilote Muserouage pour jeter des Radiageigatrons dans les sorties de la ventilation de Gnomeregan.‡使用飞行员杰夫·玛兹斯波克的飞行工具，将辐射计量仪投放到诺莫瑞根周围的通风口去。‡',
  }
},
[25229] = {
  {
    '‡Несколько хороших гномов‡Eine Frage der Gnomenehre‡신병 노움 모집‡Algunos gnomos buenos‡Algunos gnomos buenos‡Motivés, motivés, il faut les motiver…‡好侏儒寥寥‡',
    nil,
    '‡Завербуйте несколько гномов-горожан из Города Механиков с помощью Мотиват-о-трона, после чего отведите их в Поселок Сталежара к капитану Ступу Искражу.‡Werbt mit Hilfe des Motivieratron Gnome aus Tüftlerstadt an und führt sie zu Hauptmann Tret Funkdüse bei Stahlrosts Depot.‡땜장이 마을에서 동기부여장치를 사용해 신병 노움 5명을 모집한 뒤 스틸그릴의 정비소에 있는 대장 트레드 스파크노즐에게 데려가야 합니다.‡Recluta ciudadanos gnomos de la Ciudad Manitas haciendo uso del Motivatrón y dirígelos al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Recluta ciudadanos gnomos de la Ciudad Manitas haciendo uso del Motivatrón y dirígelos al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡À l\'aide du Motiva-tron, recrutez des Citoyens gnomes de Brikabrok, et conduisez-les au Capitaine Chape Étincetuyère au dépôt de Grillacier.‡使用激励仪，在侏儒区征募侏儒，并率领他们返回钢架补给站，去见崔德·火钻队长。‡',
  }
},
[25238] = {
  {
    '‡Strength Ring Flag‡Stärkering Kennzeichnung‡힘 반지‡Anillo de fuerza‡Anillo de fuerza‡Balise anneau de force‡力量戒指旗帜‡',
    nil,
    nil,
  }
},
