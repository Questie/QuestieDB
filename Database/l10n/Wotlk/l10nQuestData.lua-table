},
[10371] = {
  {
    'Yorus Barleybrew‡Йорус Ячменовар‡Yorus Gerstenbräu‡요루스 발리브루‡Yorus Cebadiz‡Yorus Cebadiz‡Yorus Brasselorge‡犹鲁斯·麦酒‡猶魯斯·麥酒',
    nil,
    'Speak with Yorus Barleybrew at the Lakeshire Inn in Redridge Mountains.‡Поговорите с Йорусом Ячменоваром в таверне Приозерья , что в Красногорье.‡Sprecht mit Yorus Gerstenbräu im Gasthaus Seenhain im Rotkammgebirge.‡붉은마루 산맥의 레이크샤이어에 있는 요루스 발리브루와 대화해야 합니다.‡Habla con Yorus Cebadiz en la posada de Villa del Lago en las Montañas Crestagrana.‡Habla con Yorus Cebadiz en la posada de Villa del Lago en las Montañas Crestagrana.‡Parler à Yorus Brasselorge à l\'Auberge de Comté-du-lac, dans les Carmines.‡与赤脊山湖畔镇的犹鲁斯·麦酒谈一谈。‡在赤脊山的湖畔鎮與猶魯斯·麥酒談話。',
  }
},
[10372] = {
  {
    'Uma pergunta discreta‡Деликатная просьба‡Eine diskrete Anfrage‡조심스러운 요청‡Una investigación discreta‡Una investigación discreta‡Une demande discrète‡谨慎的询问‡謹慎的要求',
    nil,
    'Fale com Eralan em Tranquillien.‡Поговорите с Эраланной в Транквиллионе.‡Sprecht mit Eralan in Tristessa.‡트랜퀼리엔에 있는 에랄란과 대화하십시오.‡Habla con Eralan en Tranquillien.‡Habla con Eralan en Tranquillien.‡Parlez à Eralan à Tranquillien.‡与塔奎林的艾拉兰谈一谈。‡與安寧地的依蘭兒談談。',
  }
},
[10373] = {
  {
    'A Call to Arms: The Plaguelands!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Seek out Commander Ashlam Valorfist. His base camp is located at Chillwind Camp, north of the Alterac Mountains.‡Найдите командира Ашлама Отважного Кулака в лагере Промозглого Ветра на севере Альтеракских гор.‡Sucht Kommandant Ashlam Ehrenschlag auf. Sein Stützpunkt befindet sich am Zugwindlager, nördlich des Alteracgebirges.‡알터랙 산맥 북쪽 서리바람 야영지에 본진을 두고 있는 아쉬람 발러피스트 사령관을 찾아가야 합니다.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Busca al comandante Ashlam Puñovalor. Su campamento base se encuentra en Campamento del Orvallo, al norte de las Montañas de Alterac.‡Trouvez le commandant Ashlam Vaillepoing. Il s\'est installé au Camp du Noroît, au nord des montagnes d\'Alterac.‡找到指挥官阿什拉姆·瓦罗菲斯特。他的大本营位于奥特兰克山脉以北的冰风岗。‡找到指揮官阿胥拉姆·瓦羅菲斯特。他的大本營位於奧特蘭克山脈以北的冰風營地。',
  }
},
[10374] = {
  {
    'A Call to Arms: The Plaguelands!‡Призыв к оружию: Чумные земли!‡Der Ruf zu den Waffen: Die Pestländer!‡역병지대 징집령!‡Un llamamiento a las armas: las Tierras de la Peste‡Un llamamiento a las armas: las Tierras de la Peste‡Un appel aux armes : les Maleterres‡战斗的号角：瘟疫之地！‡戰鬥的號角:瘟疫之地!',
    nil,
    'Seek out High Executor Derrington. His base camp is located at the Bulwark, east of Tirisfal Glade and the Undercity.‡Отыщите верховного палача Деррингтона. Его базовый лагерь находится у Бастиона, к востоку от Тирисфальских лугов и Подгорода.‡Sucht Hochexekutor Derrington auf. Sein Stützpunk befindet sich am Bollwerk, östlich von Tirisfal und Unterstadt.‡고위집행관 델링턴을 찾아가야 합니다. 그의 주둔지는 티리스팔 숲과 언더시티의 동쪽에 있는 보루에 있습니다.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Busca al sumo ejecutor Derrington; su campamento base está en El Baluarte, al este de Claros de Tirisfal y Entrañas.‡Partir à la recherche du Grand exécuteur Derrington. Son camp de base se trouve à la Barricade, à l\'est des Clairières de Tirisfal et de Fossoyeuse.‡找到高级执行官德灵顿。他将自己的大本营建在提瑞斯法林地和幽暗城以东的亡灵壁垒。‡找到高階執行官德靈頓。他將自己的大本營建在提里斯法林地和幽暗城以東的亡靈壁壘。',
  }
},
[10375] = {
  {
    'Colar de guerra obsidiano‡Обсидиановое боевое ожерелье‡Obsidiankriegsperlen‡흑요석 전투 목걸이‡Abalorios de guerra de obsidiana‡Abalorios de guerra de obsidiana‡Les perles de guerre d\'obsidienne‡黑曜石作战念珠‡黑曜石戰爭串珠',
