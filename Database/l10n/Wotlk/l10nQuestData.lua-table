[1462] = {
  {
    '‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    '‡Попросите у провидицы Воронье Перо еще одну сапту земли.‡Sprecht mit Seherin Rabenfeder wegen eines weiteren Erdsaptas.‡‡Pide otra sapta de tierra a la vidente Pluma de Cuervo.‡Pide otra sapta de tierra a la vidente Pluma de Cuervo.‡Parler à la Prophétesse Plume-de-corbeau pour obtenir un autre Sapta de terre.‡向鸦羽先知要另一瓶大地灵契。‡',
  }
},
[1463] = {
  {
    '‡Сапта земли‡Erdsapta‡대지의 정기‡Sapta de tierra‡Sapta de tierra‡Le sapta de terre‡大地灵契‡大地靈契',
    nil,
    '‡Поговорите с Канагой заклинателем земли, чтобы получить еще один сапту земли.‡Sprecht mit Canaga Erdenrufer wegen eines weiteren Erdsaptas.‡‡Pide a Canaga Clamatierras otra sapta de tierra.‡Pide a Canaga Clamatierras otra sapta de tierra.‡Parler à Canaga Hucheterre pour obtenir un autre Sapta de terre.‡向坎纳甘·地鸣要另一个大地灵契。‡',
  }
},
[1464] = {
  {
    'Sapta do Fogo‡Сапта огня‡Feuersapta‡불의 정기‡Sapta de fuego‡La sapta de fuego‡Sapta de feu‡火焰灵契‡火焰靈契',
    nil,
    'Fale com Telf Joolam para obter outra Sapta do Fogo.‡Поговорите с Телфом Джоламом, чтобы получить еще одну сапту огня.‡Sprecht mit Telf Joolam wegen eines weiteren Feuersaptas.‡‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Habla con Telf Joolam para conseguir otra sapta de fuego.‡Parlez à Telf Joolam pour obtenir un autre Sapta de feu.‡向泰尔夫·祖拉姆再要一个 火焰灵契。‡',
  }
},
[1465] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Entregue o Pingente de Malem a Vahlarriel Matademônios no Posto do Nijel, que fica em Desolação.‡Принесите подвеску Малемов Валарриелю Истребителю Демонов на Высоте Найджела в Пустошах.‡Kehrt mit Malems Anhänger zu Vahlarriel Dämonenjäger nach Nijelspitze in Desolace zurück.‡잊혀진 땅의 나이젤의 야영지에 있는 발라리엘 데몬슬레이어에게 말렘 펜던트를 가져가야 합니다.‡Lleva el colgante Malem a Vahlarriel Destripademonios a la Punta de Nijel, en Desolace.‡Lleva el colgante Malem a Vahlarriel Destripademonios a la Punta de Nijel, en Desolace.‡Rapporter le Pendentif de Malem à Vahlarriel Tueur-de-démons à la Combe de Nijel, en Désolace.‡向凄凉之地尼耶尔前哨站的瓦拉里尔·屠魔者回复。‡到淒涼之地的耶爾前哨站，將瑪雷姆墜子拿給瓦拉里爾·屠魔者。',
  }
},
[1466] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour Récupérateurs SA‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 10 Cérebros de Canisvil, 10 Asas Etéreas e 10 ampolas de Sangue do Guardião da Ruína para Kreldig Ungor na Desolação.‡Принесите 10 мозгов гончих Скверны, 10 крыльев Пустоты и 10 фиалов крови тюремщика судеб в Пустоши Крелдигу Унгору.‡Bringt 10 Teufelshundgehirne, 10 Netherflügel und 10 Phiolen Verdammniswächterblut zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 지옥사냥개 뇌 10개, 황천의 날개 10개, 파멸의경비대 혈액 10병을 가져가야 합니다.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de Guardiavil a Kreldig Ungor a Desolace.‡Lleva 10 cerebros de can manáfago, 10 alas abisales y 10 viales de sangre de guardiavil a Kreldig Ungor a Desolace.‡Apporter 10 Cervelles de gangrechiens, 10 Ailes du Néant et 10 Fioles de Sang de garde funeste à Kreldig Ungor, en Désolace.‡收集10个地狱犬的脑子、10对魔女之翼和10瓶末日看守之血，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10個虛空犬的腦子、10對魔女之翼和10瓶末日守衛之血，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1467] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG.‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour Récupérateurs SA‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve a Encomenda de Sinismago para Putren Rochamalho em Altaforja.‡Доставьте коробку Скрытного Кудесника в Стальгорн Ройттену Камнемолоту.‡Bringt Leftwitchs Päckchen zu Roetten Steinhammer in Eisenschmiede zurück.‡아이언포지에 있는 로이튼 스톤해머에게 레프트위치의 소포를 가져가야 합니다.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Lleva el paquete de Zurdibrujo a Roetten Rocamartillo a Forjaz.‡Rapporter la Caisse de Leftwitch à Roetten Martel-de-pierre à Forgefer.‡把莱弗维奇的包裹交给铁炉堡的罗顿·石锤。‡把萊弗維奇的包裹交給鐵爐堡的羅頓·石錘。',
  }
},
[1468] = {
  {
    'A Semana das Crianças‡Детская неделя‡Die Kinderwoche‡어린이 주간‡Semana de los Niños‡Semana de los Niños‡La Semaine des enfants‡儿童周‡兒童週',
    nil,
    'Use o Apito de Órfão Humano para conversar com a criança de quem você vai cuidar durante a Semana da Criança.‡Продудите в детскую свистульку. Присматривайте за сиротой в течение всей Детской недели.‡Benutzt die Pfeife des Menschenwaisenkindes um während der Kinderwoche mit Eurem Schützling zu sprechen.‡인간 고아 호루라기를 사용해 어린이 주간 동안 돌보게 될 아이와 대화해야 합니다.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Usa el silbato de huérfano humano para hablar con el niño al que cuidarás durante la Semana de los Niños.‡Utilisez le Sifflet d\'orphelin humain pour parler à l\'enfant que vous protégerez pendant la Semaine des enfants.‡使用人类孤儿哨与你即将在儿童周期间照顾的孩子进行对话。‡使用人類孤兒哨來和你在兒童週期間要照顧的孩子進行對話。',
  }
},
[1469] = {
  {
    'O caso do Rapsódico‡Рапсодия о болоте‡Rhapsodies Geschichte‡랩소디의 이야기‡El relato de Rapsodio‡El relato de Rapsodio‡L\'histoire de Rhapsody‡拉普索迪的故事‡拉普索迪的故事',
    nil,
    'Leve o Fragmento de Tabuleta Atal\'ai para Brohann Barrilga em Ventobravo.‡Отнесите фрагмент таблички Атал\'ай Брохану Бочкопузу в Штормград.‡Bringt das Schrifttafelfragment der Atal\'ai zu Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 조각을 가져가야 합니다.‡Lleva el trozo de tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Lleva el fragmento de la tablilla Atal\'ai a Brohann Barriliga, en Ventormenta.‡Apportez le Fragment de tablette atal\'ai à Brohann Ventrabière à Hurlevent.‡将阿塔莱石板碎片交给暴风城的布罗哈恩·铁桶。‡將阿塔萊石板碎片交給暴風城的布羅哈恩·鐵桶。',
  }
},
[1470] = {
  {
    '‡Приоткрывая завесу‡Der zerrissene Schleier‡저 너머의 세계‡Descubrir el misterio‡Descubrir el misterio‡Lever le voile‡控制小鬼‡',
    nil,
    '‡Принесите Вении Мартанд 3 черепа гремучих скелетов.‡Bringt Venya Marthand 3 Schädel eines klappernden Skeletts.‡벤야 말선드에게 덜그럭거리는 해골 3개를 가져가야 합니다.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Lleva 3 calaveras de armadóseos a Venya Marthand.‡Apportez 3 Crânes de Cliquethorax à Venya Marthand.‡收集3个断骨骷髅的颅骨，把它们交给温雅·玛山德。‡',
  }
},
[1471] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando as Runas de Evocação, evoque e subjugue um Emissário do Caos. Depois, devolva os Glifos de Evocação para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи рун призыва вызовите и подчините себе демона Бездны, а потом верните руны призыва Карендину Халгару в Квартале магов Подгорода.‡Beschwört mit Hilfe der Runen der Beschwörung einen Leerwandler, unterwerft ihn und bringt die Runen der Beschwörung dann zu Carendin Halgar im Magieviertel von Unterstadt zurück.‡소환의 룬을 사용하여 보이드워커를 소환하여 제압한 다음 언더시티의 마법 지구에 있는 카렌딘 할가르에게 소환의 룬을 가지고 돌아가야 합니다.‡Utilizando las Runas de Invocación, invoca y domina a un abisario, y después devuélvele las Runas de Invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando las Runas de invocación, invoca y domina a un abisario, y después devuélvele las Runas de invocación a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Runes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Runes d\'invocation à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只虚空行者，然后将召唤符文还给诅咒神庙中的凯伦丁·哈加尔。‡召喚並征服一隻虛無行者，然後將召喚符文還給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1472] = {
  {
    'Devoradora de almas‡Пожиратель Душ‡Verschlinger der Seelen‡영혼을 삼키는 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Godofredo Fasano no Templo dos Malditos.‡Поговорите с Годриком Фарсаном в Храме Проклятых.‡Sprecht mit Godrick Farsan im Tempel der Verdammten.‡저주의 사원에 있는 고드릭 파선과 대화해야 합니다.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Habla con Godrick Farsan en el Templo de los Condenados.‡Parler à Godrick Farsan au Temple des damnés.‡与诅咒神殿中的高德瑞克·法杉谈一谈。‡與詛咒神殿中的高德瑞克·法杉談話。',
  }
},
[1473] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 피조물‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere o Grimório de Egalin e leve-o para Silvério Hidalgo no Templo dos Malditos.‡Найдите гримуар Эгалина и отнесите его Карендину Халгару в Храм Проклятых.‡Beschafft Egalins Zauberfolianten und bringt ihn zu Carendin Halgar in den Tempel der Verdammten.‡에갈린의 흑마법서를 되찾아 저주의 사원에 있는 카렌딘 할가르에게 가져가야 합니다.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Recupera el grimorio de Egalin y dáselo a Carendin Halgar, que está en el Templo de los Condenados.‡Retrouver le Grimoire d\'Egalin et l\'apporter à Carendin Halgar au Temple des damnés.‡夺回埃加林的魔典，把它交给诅咒神庙中的凯伦丁·哈加尔。‡奪回埃加林的魔典，把它交給詛咒神廟中的凱倫丁·哈加爾。',
  }
},
[1474] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Corações Puros, evoque e subjugue uma súcubo. Depois, devolva os Corações Puros para Silvério Hidalgo no Distrito da Magia na Cidade Baixa.‡При помощи чистых сердец призовите и подчините суккуба, а потом верните чистые сердца Карендину Халгару в Квартале магов Подгорода.‡Beschwört mit Hilfe der reinen Herzen einen Sukkubus, unterwerft ihn und bringt die reinen Herzen dann zu Carendin Halgar im Magieviertel von Unterstadt zurück.‡순수한 심장을 사용하여 서큐버스를 소환하여 제압한 다음, 언더시티에 있는 마법 지구에 있는 카렌딘 할가르에게 순수한 심장을 가져가야 합니다.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utilizando los corazones puros, invoca y domina a un súcubo, y después devuélvele los corazones puros a Carendin Halgar, que está en el Barrio de la Magia de Entrañas.‡Utiliser les Cœurs purs pour invoquer et soumettre une succube, puis rapporter les Cœurs purs à Carendin Halgar, au Temple des Damnés.‡召唤并征服一只魅魔，然后将纯洁的精华还给诅咒神庙里的凯伦丁·哈加尔。‡召喚並征服一隻魅魔，然後將純潔的心還給詛咒神廟裡的凱倫丁·哈加爾。',
  }
},
[1475] = {
  {
    'No templo de Atal\'Hakkar‡В храм Атал\'Хаккар‡Im Tempel von Atal\'Hakkar‡아탈학카르 신전으로‡En El Templo de Atal\'Hakkar‡En El Templo de Atal\'Hakkar‡Dans le temple d\'Atal\'Hakkar‡进入阿塔哈卡神庙‡進入阿塔哈卡神廟',
    nil,
    'Leve 10 Tabuletas Atal\'ai para Brohann Barrilga em Ventobravo.‡Соберите 10 табличек Атал\'ай для Брохана Бочкопуза из Штормграда.‡Sammelt 10 Schrifttafeln der Atal\'ai für Brohann Fassbauch in Sturmwind.‡스톰윈드에 있는 브로한 캐스크벨리에게 아탈라이 서판 10개를 가져가야 합니다.‡Consigue 10 tablillas Atal\'ai para Brohann Barriliga, en Ventormenta.‡Consigue 10 tablillas de Atal\'ai para Brohann Barriliga, en Ventormenta.‡Rassembler 10 Tablettes atal\'ai pour Brohann Ventrabière à Hurlevent.‡为暴风城的布罗哈恩·铁桶收集10块阿塔莱石板。‡為暴風城的布羅哈恩·鐵桶收集10塊阿塔萊石板。',
  }
},
[1476] = {
  {
    'Corações dos Puros‡Чистые сердца‡Herzen der Reinen‡선한 자의 유품‡Corazones puros‡Corazones puros‡Des cœurs purs‡纯洁者精华‡純潔者之心',
    nil,
    'Leve os corações de Dalin Forjífice e Corma Vilardo para Silvério Hidalgo no Templo dos Malditos.‡Принесите сердца Далина Искусника и Кормы Виллард Карендину Халгару в Храм Проклятых.‡Bringt die Herzen von Dalin Schmiedevater und Corma Villard zu Carendin Halgar im Tempel der Verdammten.‡저주의 사원에 있는 카렌딘 할가르에게 달린의 유품과 코마의 유품을 가져가야 합니다.‡Llévale los corazones de Dalin Forjador y Corma Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Llévale los corazones de Dalin Forjador y Corma Villardo a Carendin Halgar, que está en el Templo de los Condenados.‡Apportez les Cœurs de Dalin Forgebusier et de Corma Villard à Carendin Halgar dans le Temple des Damnés.‡将达林和科玛的徽记交给诅咒神殿里的凯伦丁·哈加尔。‡將達林·弗治維特和珂瑪·韋拉德的心臟交給詛咒神殿裡的凱倫丁·哈加爾。',
  }
},
[1477] = {
  {
    'Suprimentos Vitais‡Важные поставки‡Überaus wichtige Vorräte‡중요한 보급품‡Suministros de vital importancia‡Suministros de vital importancia‡Fournitures vitales‡重要的补给‡重要的補給',
    nil,
    'Speak with Watchmaster Sorigal at Darkshire in Duskwood.‡Поговорите с начальником стражи Соригелом в Темнолесье, что в Сумеречном лесу.‡Sprecht mit Wachhauptmann Sorigal in Dunkelhain im Dämmerwald.‡그늘숲의 다크샤이어에 있는 순찰대장 소리갈과 대화해야 합니다.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Habla con el maestro de vigilantes Sorigal en Villa Oscura, en el Bosque del Ocaso.‡Parler au Maître de guet Sorigal à Sombre-comté, dans le Bois de la Pénombre.‡和暮色森林中夜色镇的守卫队长索里加尔谈一谈。‡到暮色森林的夜色鎮，和守衛隊長索里加爾談話。',
  }
},
[1478] = {
  {
    'Convocação de Hidalgo‡Призыв Халгара‡Halgars Beschwörung‡할가르의 부름‡Las invocaciones de Halgar‡Las invocaciones de Halgar‡Les invocations de Halgar‡哈加尔的召唤‡哈加爾的召喚',
    nil,
    'Fale com Silvério Hidalgo na Cidade Baixa.‡Поговорите с Карендином Халгаром в Подгороде.‡Sprecht mit Carendin Halgar in Unterstadt.‡언더시티에 있는 카렌딘 할가르와 대화해야 합니다.‡Habla con Carendin Halgar en Entrañas.‡Habla con Carendin Halgar en Entrañas.‡Parler à Carendin Halgar à Fossoyeuse.‡与幽暗城的凯伦丁·哈加尔谈一谈。‡與幽暗城的凱倫丁·哈加爾談話。',
  }
},
[1479] = {
  {
    '‡Ветвь Вечности‡Der Baum der Ewigen‡‡La Rama de los Eternos‡La Rama de los Eternos‡Le Rameau des Éternels‡永恒之树‡',
    nil,
    '‡Отведите сироту к банку Дарнаса. Банк находится в дупле дерева, которое называется Купина Вечности.‡Begleitet Euren Schützling zur Bank in Darnassus. Die dortige Bank ist in einen Baum gebaut, welcher als der Baum der Ewigen bekannt ist.‡‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Lleva al huérfano al banco de Darnassus. El banco está dentro de un árbol conocido como la Rama de los Eternos.‡Conduire l\'orphelin à la banque de Darnassus. La banque est creusée dans le tronc d\'un arbre connu sous le nom du Rameau des Éternels.‡带着你看护的孤儿去达纳苏斯的银行。银行就坐落在一棵中空的树里，它被称为永恒之树。‡',
  }
},
[1480] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve a Pele de Demônio Esfolada a Maurin Rachaosso na Desolação.‡Отнесите рваную шкуру демона Морину Костолому в Пустоши.‡Bringt die geschundene Dämonenhaut nach Desolace zu Maurin Knochenspalter.‡잊혀진 땅에 있는 마우린 본스플리터에게 악마의 가죽을 가져다주십시오.‡Lleva la piel de demonio despellejada a Maurin Partehuesos a Desolace.‡Lleva la piel de demonio a Maurin Partehuesos a Desolace.‡Apportez une Peau de démon écorché à Maurin Craquossement en Désolace.‡把恶魔之皮拿给凄凉之地的玛乌林·碎骨看看。‡把這塊惡魔之皮拿給淒涼之地的莫林·碎骨看看。',
  }
},
[1481] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Escalpo de Assombrante para Maurin Rachaosso na Desolação.‡Принесите скальп тенелова Морину Костолому в Пустошах.‡Bringt Maurin Knochenspalter in Desolace einen Schattenpirscherskalp.‡잊혀진 땅에 있는 마우린 본스플리터에게 그림자추적자 머릿가죽을 가져가야 합니다.‡Lleva 1 cabellera Acechasombras a Maurin Partehuesos a Desolace.‡Lleva 1 cabellera de acechasombras a Maurin Partehuesos a Desolace.‡Apporter un Scalp de traqueur des ombres à Maurin Craquossement en Désolace.‡给凄凉之地的玛乌林·碎骨带回一张巡影者的头皮。‡帶一張巡影者的頭皮回來給淒涼之地的莫林·碎骨者。',
  }
},
[1482] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Leve um Cristal de Oráculo para Maurin Rachaosso em Desolação.‡Принесите кристалл оракула Морину Костолому в Пустоши.‡Bringt Maurin Knochenspalter in Desolace einen Orakelkristall.‡잊혀진 땅에 있는 마우린 본스플리터에게 예언의 수정구를 가져가야 합니다.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Lleva 1 cristal del oráculo a Maurin Partehuesos a Desolace.‡Apporter un Cristal d\'oracle à Maurin Craquossement, en Désolace.‡给凄凉之地的玛乌林·碎骨带回一块神谕水晶。‡帶一塊神諭水晶回來給淒涼之地的莫林·碎骨者。',
  }
},
[1483] = {
  {
    'Zé Fízzica‡Зиз Физзикс‡Ziz Fizziks‡지즈 피직스‡Ziz Fizziks‡Ziz Fizziks‡Ziz Fizzik‡菲兹克斯‡菲茲克斯',
    nil,
    'Fale com Zé Fízzica no Rochedo Cortavento, que fica na Cordilheira das Torres de Pedra.‡Поговорите с Зизом Физзиксом на Утесе Ветрорезов, что в Когтистых горах.‡Sprecht mit Ziz Fizziks bei der Scherwindklippe im Steinkrallengebirge.‡돌발톱 산맥의 칼바람 바위산에 있는 지즈 피직스와 대화해야 합니다.‡Habla con Ziz Fizziks en Risco Cortaviento, en Sierra Espolón.‡Habla con Ziz Fizziks en Risco Cortaviento, en Sierra Espolón.‡Parler à Ziz Fizzik dans la Combe des Cisailles, aux Serres-Rocheuses.‡和石爪山脉中狂风峭壁的菲兹克斯谈一谈。‡到石爪山脈的狂風峭壁找菲茲克斯談話。',
  }
},
[1484] = {
  {
    'O Corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Stahlklinge in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화해야 합니다.‡Habla con Takata Hoja de Acero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parlez à Takata Lamacier en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡與淒涼之地的塔卡塔·鋼刃談話。',
  }
},
[1485] = {
  {
    '‡Злобные фамилиары‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡',
    nil,
    '‡Принесите Рузану 6 голов злобных фамильяров.‡Bringt 6 Köpfe schändlicher Familiare zu Ruzan.‡‡Lleva 6 cabezas de familiar vil a Ruzan.‡Lleva 6 cabezas de familiar vil a Ruzan.‡Apporter 6 Têtes de vils quasits à Ruzan.‡给鲁赞带回6颗邪灵劣魔的头颅。‡',
  }
},
[1486] = {
  {
    'Pelegos anormais‡Шкуры загадочных существ‡Deviatbälge‡돌연변이 통가죽‡Pellejo de los descarriados‡Pellejos descarriados‡Les peaux de déviants‡变异皮革‡變異皮革',
    nil,
    'Nalpak na Caverna Ululante quer 20 Pelegos Anormais.‡Принесите 20 искаженных шкур Налпаку в Пещерах Стенаний.‡Nalpak in den Höhlen des Wehklagens möchte 20 Deviatbälge.‡통곡의 동굴에 있는 날팍이 돌연변이 통가죽 20개를 가져다 달라고 부탁했습니다.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos de los descarriados.‡Nalpak de las Cuevas de los Lamentos quiere 20 pellejos descarriados.‡Nalpak, dans les Cavernes des lamentations, veut 20 Peaux de déviants.‡哀嚎洞穴的纳尔帕克想要20张变异皮革。‡哀嚎洞穴的納爾派克想要20張變異皮革。',
  }
},
[1487] = {
  {
    'Erradicação de Anormais‡Искоренение Скверны‡Ausrottung der Deviat‡돌연변이 짐승 섬멸‡Erradicación de descarriados‡Erradicación de descarriados‡L\'éradication des déviants‡清除变异者‡根絕變異者',
    nil,
    'Ebru, na Caverna Ululante, quer que você mate 7 Assoladores Anormais, 7 Víboras Anormais, 7 Trôpegos Anormais e 7 Presáteras Anormais.‡Убейте для Эбру 7 загадочных опустошителей, 7 загадочных гадюк, 7 загадочных шаркунов и 7 загадочных страхозубов.‡Ebru in den Höhlen des Wehklagens möchte, dass Ihr 7 Deviatverheerer, 7 Deviatvipern, 7 Deviatschlurfer und 7 Deviatschreckensfange tötet.‡통곡의 동굴에 있는 에브루가 돌연변이 약탈자랩터 7마리, 돌연변이 독사 7마리, 돌연변이 늪괴물 7마리, 돌연변이 송곳니천둥매 7마리를 처치해 달라고 부탁했습니다.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrados descarriados y 7 colminfernos descarriados.‡Ebru de las Cuevas de los Lamentos quiere que mates 7 devastadores descarriados, 7 víboras descarriadas, 7 arrastrapiés descarriados y 7 colminfernos descarriados.‡Ebru, dans les Cavernes des lamentations, veut que vous tuiez 7 Ravageurs déviants, 7 Vipères déviantes, 7 Traînards déviants et 7 Crocs-d\'effroi déviants.‡哀嚎洞穴的厄布鲁要求你杀掉7只变异破坏者、7只剧毒飞蛇、7只变异蹒跚者和7只变异尖牙风蛇。‡哀嚎洞穴的厄布魯要求你殺掉7隻變異劫毀者、7隻劇毒飛蛇、7隻變異跛行者和7只變異尖牙風蛇。',
  }
},
[1488] = {
  {
    'O corruptor‡Осквернитель душ‡Der Verderber‡타락자‡El corruptor‡El corruptor‡Le corrupteur‡堕落者‡墮落者',
    nil,
    'Mate Lorde Azrethoc e Jugkar Grim\'rod e fale novamente com Takta Laminaço em Desolação.‡Убейте лорда Азретока и Джуккара Грим\'рода и вернитесь к Такате Стальному Клинку в Пустоши.‡Besiegt Lord Azrethoc und Jugkar Grimm\'rod. Kehrt dann zu Takata Stahlklinge in Desolace zurück.‡제왕 아즈레토크와 죽카르 그림로드를 처치하고 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가야 합니다.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Mata a Lord Azrethoc y a Jugkar Lug\'vara y ve a ver a Takata Hoja de Acero a Desolace.‡Tuer le seigneur Azrethoc et Jugkar Grim\'rod puis retourner voir Takata Lamacier en Désolace.‡杀掉魔王阿兹雷索克和祖格卡，然后向凄凉之地的塔卡塔·钢刃复命。‡殺掉阿茲雷索克領主和祖格卡，然後向淒涼之地的塔卡塔·鋼刃覆命。',
  }
},
[1489] = {
  {
    'Hamuul Runa Totem‡Хамуул Рунический Тотем‡Hamuul Runentotem‡하뮬 룬토템‡Hamuul Tótem de Runa‡Hamuul Tótem de Runa‡Hamuul Totem-runique‡哈缪尔·符文图腾‡哈繆爾·符文圖騰',
    nil,
    'Fale com Hamuul Runa Totem.‡Поговорите с Хамуулом Руническим Тотемом.‡Sprecht mit Hamuul Runentotem.‡하뮬 룬토템과 대화해야 합니다.‡Habla con Hamuul Tótem de Runa.‡Habla con Hamuul Tótem de Runa.‡Parler à Hamuul Totem-runique.‡和哈缪尔·符文图腾谈一谈。‡和哈繆爾·符文圖騰談話。',
  }
},
[1490] = {
  {
    'Nara Juba Agreste‡Нара Буйногривая‡Nara Wildmähne‡나라 와일드메인‡Nara Ferocrín‡Nara Ferocrín‡Nara Crin-sauvage‡纳拉·蛮鬃‡納拉·蠻鬃',
    nil,
    'Fale com Nara Juba Agreste.‡Поговорите с Нарой Буйногривой.‡Sprecht mit Nara Wildmähne.‡나라 와일드메인과 대화해야 합니다.‡Habla con Nara Ferocrín.‡Habla con Nara Ferocrín.‡Parler à Nara Crin-sauvage.‡和纳拉·蛮鬃谈一谈。‡和納拉·蠻鬃談話。',
  }
},
[1491] = {
  {
    'Bebidas inteligentes‡Умный напиток‡Klugheitstränke‡영리해지는 음료‡Bebidas de inteligencia‡Bebidas de inteligencia‡Les potions d\'intelligence‡智慧饮料‡智慧飲料',
    nil,
    'Leve 6 porções de Essência Ululante para Cáliper Porcatraca na Vila Catraca.‡Принесите 6 порций воющей субстанции Мебоку Миззриксу в Кабестан.‡Bringt 6 Portionen Klageessenz zu Mebok Mizzyrix in Ratschet.‡톱니항에 있는 메보크 미지릭스에게 통곡의 정수 6병을 가져가야 합니다.‡Llévale 6 unidades de esencia de lamentos a Mebok Mizzyrix en Trinquete‡Llévale 6 porciones de esencia de lamentos a Mebok Mizzyrix en Trinquete.‡Apporter 6 doses d\'Essence de lamentation à Mebok Mizzyrix, à Cabestan.‡收集6份哀嚎香精，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集6份哀嚎香精，把它們交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1492] = {
  {
    'Mestre Portuário Caruncho‡Управляющий пристанью Головокружилкинс‡Werftmeister Flunkerblick‡부두주임 디지위그‡Maestro de muelles Vertipeluca‡Maestro de muelles Vertipeluca‡Maître des quais Tournoupette‡码头管理员迪兹维格‡碼頭管理員迪茲維格',
    nil,
    'Leve o Caixote Fechado para o Mestre Portuário Caruncho na Vila Catraca.‡Отнесите надежный ящик управляющему пристанью Головокружилкинcу в Кабестан.‡Bringt die gesicherte Kiste zu Werftmeister Flunkerblick in Ratschet.‡톱니항에 있는 부두주임 디지위그에게 단단히 잠긴 상자를 가져가야 합니다.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Llévale el cajón seguro al maestro de muelles Vertipeluca, en Trinquete.‡Apportez la Caisse sûre au Maître des quais Tournoupette à Cabestan.‡把保险箱交给棘齿城的码头管理员迪兹维格。‡把保險箱交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1498] = {
  {
    'Caminho da defesa‡Путь защиты‡Weg der Verteidigung‡수호자의 길‡Camino de defensa‡Camino de defensa‡La voie de la défense‡防御之道‡防禦之道',
    nil,
    'Leve 5 Escamas Chamuscadas para Uzzek no Posto Remoto, nos Sertões.‡Принесите 5 оплавленных чешуек Уззеку на Дальнюю заставу в Степях.‡Bringt 5 versengte Schuppen zu Uzzek bei der Fernwacht im Brachland.‡불모의 땅의 전초 기지에 있는 우제크에게 그슬린 비늘 5개를 가져가야 합니다.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Lleva 5 escamas chamuscadas a Uzzek en Avanzada del Puente en Los Baldíos.‡Apporter 5 Ecailles roussies à Uzzek au Poste de garde extérieur dans les Tarides.‡给贫瘠之地前沿哨所的犹塞克带回5块烧焦的鳞片。‡帶5塊燒焦的鱗片回來給貧瘠之地前沿哨所的猶塞克。',
  }
},
[1499] = {
  {
    'Familiares torpes‡Злобные фамильяры‡Üble Familiare‡악마의 하수인‡Familiares viles‡Familiares viles‡Les vils quasits‡邪灵劣魔‡邪靈劣魔',
    nil,
    'Fale com Zureta Vista-longa.‡Поговорите с Зуритой Востроглазой.‡Sprecht mit Zureetha Fernblick.‡주리타 파게이즈와 대화해야 합니다.‡Habla con Zureetha Vistalonga.‡Habla con Zureetha Vistalonga.‡Parler à Zureetha Mireloin.‡与祖雷萨谈一谈。‡與祖雷薩·遠凝談話。',
  }
},
[1500] = {
  {
    'Despertando Naralex‡Пробуждение Наралекса‡Die Erweckung von Naralex‡깨어나는 나랄렉스‡Naralex ambulante‡Naralex ambulante‡Le réveil de Naralex‡唤醒纳拉雷克斯‡喚醒納拉雷克斯',
    nil,
    nil,
  }
},
[1501] = {
  {
    'Criatura do caos‡Создание Бездны‡Kreatur der Leere‡공허의 존재‡Criatura Abisal‡Criatura Abisal‡La créature du Vide‡虚空中的生物‡虛無中的生物',
    nil,
    'Recupere a Tabuleta de Verga para Gan\'rul Olho de Sangue em Orgrimmar.‡Добудьте табличку Верги для Ган\'рула Кровавого Глаза в Оргриммаре.‡Holt die Schrifttafel der Verga für Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이가 베르가의 서판을 되찾아 오라고 부탁했습니다.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Lleva la tablilla de Vergua a Gan\'rul Ojosangre a Orgrimmar.‡Récupérer la Tablette de Verga pour Gan\'rul Oeil-sanglant à Orgrimmar.‡为奥格瑞玛的甘鲁尔·血眼找回维尔加石板。‡為奧格瑪的甘盧爾·血眼找回維爾加石板。',
  }
},
[1502] = {
  {
    'Thun\'grim Olhafogo‡Тун\'грим Огневзор‡Thun\'grim Brandblick‡툰그림 파이어게이즈‡Thun\'grim Vistafuego‡Thun\'grim Vistafuego‡Thun\'grim Mirefeu‡索恩格瑞姆·火眼‡索恩格瑞姆·火眼',
    nil,
    'Fale com Thun\'grim Olhafogo nos Sertões.‡Поговорите с Тун\'гримом Огневзором из Степей.‡Sprecht mit Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈와 대화해야 합니다.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Habla con Thun\'grim Vistafuego en Los Baldíos.‡Parler à Thun\'grim Mirefeu dans les Tarides.‡与贫瘠之地的索恩格瑞姆·火眼谈一谈。‡與貧瘠之地的索恩格瑞姆·火眼談話。',
  }
},
[1503] = {
  {
    'Aço forjado‡Стальные слитки‡Geschmiedeter Stahl‡단조된 강철‡Acero fundido‡Acero fundido‡Acier forgé‡锻造好的钢锭‡鍛造好的鋼錠',
    nil,
    'Leve as Barras de Aço Forjado para Thun\'grim Olhafogo nos Sertões.‡Принесите стальные слитки Тун\'гриму Огневзору из Степей.‡Bringt die Schmiedestahlbarren zu Thun\'grim Brandblick im Brachland.‡불모의 땅에 있는 툰그림 파이어게이즈에게 단조된 강철 주괴를 가져가야 합니다.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Lleva los lingotes de acero fundido a Thun\'grim Vistafuego en Los Baldíos.‡Apportez les Barres d\'Acier forgé à Thun\'grim Mirefeu dans les Tarides.‡把锻造好的钢锭带给贫瘠之地的索恩格瑞姆·火眼。‡把鍛造好的鋼錠帶給貧瘠之地的索恩格瑞姆·火眼。',
  }
},
[1504] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando os Glifos de Evocação, evoque e subjugue um Emissário do Caos; depois, devolva os Glifos de Evocação para Gan\'rul Olho de Sangue em Orgrimmar.‡Используя знаки призыва, призовите и подчините своей воле демона Бездны. Верните знаки призыва Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mithilfe der Glyphen der Beschwörung einen Leerwandler, unterwerft ihn und bringt dann die Glyphen der Beschwörung zu Gan\'rul Blutauge in Orgrimmar zurück.‡소환의 문양을 사용해 보이드워커를 소환하여 굴복시킨 다음 오그리마에 있는 간룰 블러드아이에게 사용한 소환의 문양을 가지고 돌아가야 합니다.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Usa los glifos de invocación para invocar y dominar a un abisario y lleva los glifos a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser les Glyphes d\'invocation pour invoquer et soumettre un marcheur du Vide, puis rapporter les Glyphes d\'invocation à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只虚空行者，然后带着召唤铭文向奥格瑞玛的甘鲁尔·血眼回报。‡召喚並征服一隻虛無行者，然後帶著召喚雕紋向奧格瑪的甘盧爾·血眼回報。',
  }
},
[1505] = {
  {
    'Veterano Uzzek‡Ветеран Уззек‡Veteran Uzzek‡노련한 우제크‡Uzzek, el veterano‡Uzzek, el veterano‡Le vétéran Uzzek‡老兵犹塞克‡老兵猶塞克',
    nil,
    'Fale com Uzzek no Posto Remoto, que fica nos Sertões.‡Поговорите с Уззеком в Форпосте в Степях.‡Sprecht mit Uzzek bei der Fernwacht im Brachland.‡불모의 땅의 전초 기지에 있는 우제크과 대화해야 합니다.‡Habla con Uzzek en Avanzada del Puente, en Los Baldíos.‡Habla con Uzzek en Avanzada del Puente, en Los Baldíos.‡Parler à Uzzek au Poste de garde extérieur, dans les Tarides.‡和贫瘠之地前沿哨所的犹塞克谈一谈。‡到貧瘠之地的前沿哨所與猶塞克談話。',
  }
},
[1506] = {
  {
    'Convocação de Gan\'rul‡Призыв от Ган\'рула‡Gan\'ruls Beschwörung‡간룰의 소환‡Las invocaciones de Gan\'rul‡Las invocaciones de Gan\'rul‡Les invocations de Gan\'rul‡甘鲁尔的召唤‡甘盧爾的召喚',
    nil,
    'Fale com Gan\'rul Olho de Sangue em Orgrimmar.‡Найдите Ган\'рула Кровавого Глаза в Оргриммаре и поговорите с ним.‡Sprecht mit Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이와 대화해야 합니다.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Habla con Gan\'rul Ojosangre en Orgrimmar.‡Parler à Gan\'rul Oeil-sanglant à Orgrimmar.‡去奥格瑞玛和甘鲁尔·血眼谈一谈。‡去奧格瑪和甘盧爾·血眼談話。',
  }
},
[1507] = {
  {
    'Devoradora de almas‡Пожиратель Душ‡Verschlinger der Seelen‡영혼을 삼키는 자‡Devoradora de almas‡Devoradora de almas‡La dévoreuse d\'âmes‡噬魂者‡噬魂者',
    nil,
    'Fale com Cazul no Antro das Sombras.‡Поговорите с Казулом в расселине Теней.‡Sprecht mit Cazul in der Kluft der Schatten.‡어둠의 틈에 있는 카줄과 대화해야 합니다.‡Habla con Cazul en el Circo de las Sombras.‡Habla con Cazul en el Circo de las Sombras.‡Parlez à Cazul à la Faille de l\'Ombre.‡和暗影裂口的卡祖尔谈一谈。‡和暗影裂口的卡祖爾談話。',
  }
},
[1508] = {
  {
    'Cazul cego‡Слепой Казул‡Der blinde Cazul‡눈 먼 카줄‡Cazul, el ciego‡Cazul, el ciego‡Cazul l\'aveugle‡盲眼卡祖尔‡盲眼卡祖爾',
    nil,
    'Fale com Zankaja em Orgrimmar.‡Поговорите с Занкайей в Оргриммаре.‡Sprecht mit Zankaja in Orgrimmar.‡오그리마에 있는 잔카자와 대화해야 합니다.‡Habla con Zankaja en Orgrimmar.‡Habla con Zankaja en Orgrimmar.‡Parler à Zankaja à Orgrimmar.‡和奥格瑞玛的赞卡沙谈一谈。‡和奧格瑪的贊卡沙談話。',
  }
},
[1509] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Gazrog na Encruzilhada.‡Поговорите с Газрогом в Перекрестке.‡Sprecht mit Gazrog beim Wegekreuz.‡크로스로드에 있는 가즈록과 대화해야 합니다.‡Habla con Gazrog en El Cruce.‡Habla con Gazrog en El Cruce.‡Parler à Gazrog à la Croisée.‡找到十字路口的加兹罗格并和他谈一谈。‡找到十字路口的加茲羅格並和他談話。',
  }
},
[1510] = {
  {
    'Notícias de Dogran‡Вести о Догране‡Neuigkeiten von Dogran‡도그란의 소식‡Noticias de Dogran‡Noticias de Dogran‡Des nouvelles de Dogran‡多格兰的消息‡多格蘭的消息',
    nil,
    'Fale com Ken\'zigla em Malaka\'jin.‡Поговорите с Кен\'зиглой в Малака\'джине.‡Sprecht mit Ken\'zigla am Malaka\'jin.‡말라카진에 있는 켄지글라와 대화해야 합니다.‡Habla con Ken\'zigla en Malaka\'jin.‡Habla con Ken\'zigla en Malaka\'jin.‡Parler à Ken\'zigla, au village de Malaka\'jin.‡找到玛拉卡金的肯兹格拉并和他谈一谈。‡找到瑪拉卡金的肯茲格拉並和他談話。',
  }
},
[1511] = {
  {
    'Trago do Ken\'zigla‡Зелье Кен\'зиглы‡Ken\'ziglas Trunk‡켄지글라의 술‡Jarabe de Ken\'zigla‡Jarabe de Ken\'zigla‡Breuvage de Ken\'zigla‡肯兹格拉的伤药‡肯茲格拉的傷藥',
    nil,
    'Leve o Trago do Ken\'zigla para o Bruto Logmar no Acampamento Taurajo.‡Отнесите зелье Кен\'зиглы рубаке Логмару в Лагерь Таурахо.‡Bringt Ken\'ziglas Trunk zu Grunzer Logmar im Camp Taurajo.‡타우라조 야영지에 있는 그런트 로그마르에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Lleva el jarabe de Ken\'zigla al bruto Logmar al Campamento Taurajo.‡Apporter le Breuvage de Ken\'zigla au grunt Logmar, au Camp Taurajo.‡将肯兹格拉的伤药交给陶拉祖营地的步兵劳格玛。‡將肯茲格拉的傷藥交給陶拉祖營地的蠻兵勞格瑪。',
  }
},
[1512] = {
  {
    'Presente do amor‡Дар любви‡Die Liebesgabe‡사랑의 선물‡Un regalo de amor‡Un regalo de amor‡Le cadeau de l\'amour‡爱的礼物‡愛的禮物',
    nil,
    'Leve o Pingente Coberto de Terra para Gan\'rul Olho de Sangue em Orgrimmar.‡Отнесите подвеску, испачканную грязью, Ган\'рулу Кровавому Глазу в Оргриммар.‡Bringt den schmutzverkrusteten Anhänger zu Gan\'rul Blutauge in Orgrimmar.‡오그리마에 있는 간룰 블러드아이에게 진흙투성이 목걸이를 가져가야 합니다.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Lleva el colgante cubierto de tierra a Gan\'rul Ojosangre a Orgrimmar.‡Apportez le Pendentif de poussière à Gan\'rul Oeil-sanglant à Orgrimmar.‡把沾满泥土的坠饰带给奥格瑞玛的甘鲁尔-血眼。‡把沾滿泥土的墜飾帶給奧格瑪的甘盧爾·血眼。',
  }
},
[1513] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Com o Pingente de Dogran, evoque e subjugue uma Súcubo; depois, devolva o Pingente de Dogran a Gan\'rul Olho de Sangue, em Orgrimmar.‡Призовите и подчините суккуба с помощью подвески Дограна. Верните подвеску Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mithilfe von Dograns Anhänger einen Sukkubus, unterwerft ihn und bringt dann Dograns Anhänger zu Gan\'rul Blutauge in Orgrimmar zurück.‡도그란의 목걸이를 사용해 서큐버스를 소환하여 처치한 다음 오그리마에 있는 간룰 블러드아이에게 도그란의 목걸이를 가지고 돌아가야 합니다.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Usa el colgante de Dogran para invocar y dominar a un súcubo y lleva el colgante a Gan\'rul Ojosangre a Orgrimmar.‡Utiliser le Pendentif de Dogran pour invoquer et soumettre une succube, puis rapporter le Pendentif de Dogran à Gan\'rul Oeil-sanglant, à Orgrimmar.‡召唤并征服一只魅魔，然后将多格兰的坠饰还给奥格瑞玛的甘鲁尔·血眼。‡召喚並征服一隻魅魔，然後將多格蘭的墜飾還給奧格瑪的甘盧爾·血眼。',
  }
},
[1514] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    nil,
  }
},
[1515] = {
  {
    'O cativeiro de Dogran‡Догран в плену‡Dograns Gefangenschaft‡포로가 된 도그란‡El cautiverio de Dogran‡El cautiverio de Dogran‡La captivité de Dogran‡多格兰之囚‡多格蘭之囚',
    nil,
    'Leve o Trago do Ken\'zigla para Dogran nos Sertões.‡Отнесите зелье Кен\'зиглы Дограну в Степях.‡Bringt Ken\'ziglas Trunk zu Dogran im Brachland.‡불모의 땅에 있는 도그란에게 켄지글라의 술을 가져가야 합니다.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Lleva el jarabe de Ken\'zigla a Dogran a Los Baldíos.‡Apporter le Breuvage de Ken\'zigla à Dogran dans les Tarides.‡把肯兹格拉的伤药带给贫瘠之地的多格兰。‡把肯茲格拉的傷藥帶給貧瘠之地的多格蘭。',
  }
},
[1516] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Leve 2 Cascos de Espreitador Vil para Ranago Arauto da Terra no Vale das Provações.‡Принесите Канаге заклинателю земли 2 копыта ловцов Скверны.‡Bringt 2 Teufelspirscherhufe zu Canaga Erdenrufer im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 하급 지옥사냥개 발굽 2개를 가져가야 합니다.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierra en el Valle de los Retos.‡Lleva 2 pezuñas de acechador vil a Canaga Clamatierras en el Valle de los Retos.‡Apporter 2 Sabots de traqueur gangrené à Canaga Hucheterre dans la Vallée des épreuves.‡给试炼谷的坎纳甘·地鸣带去2只地狱捕猎者的蹄子。‡帶2隻惡魔潛獵者的蹄子給試煉谷的坎納甘·地鳴。',
  }
},
[1517] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Encontre a Rocha dos Espíritos e beba o Sapta da Terra.‡Найдите Священный Камень и выпейте рядом с ним сапту Земли.‡Sucht den Geisterfelsen und trinkt das Erdsapta.‡정기 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Encuentra la Roca de los Espíritus y bebe la Sapta de tierra.‡Trouver le Rocher des esprits et boire le Sapta de terre.‡找到灵魂石地，在那里喝下大地灵契。‡找到靈魂石地，在那裡喝下大地靈契。',
  }
},
[1518] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Leve o Quartzo Grosseiro para Ranago Arauto da Terra no Vale das Provações.‡Отнесите необработанный кварц Канаге заклинателю земли в долину Испытаний.‡Bringt den Rohquarz zu Canaga Erdenrufer im Tal der Prüfungen.‡시험의 골짜기에 있는 카나가 어스콜러에게 천연 석영을 가져가야 합니다.‡Lleva el Cuarzo en bruto a Canaga Clamatierra en el Valle de los Retos.‡Lleva el cuarzo en bruto a Canaga Clamatierras en el Valle de los Retos.‡Apportez le Quartz brut à Canaga Hucheterre dans la Vallée des épreuves.‡把粗石英交给试炼谷的坎纳甘·地鸣。‡把劣質石英交給試煉谷的坎納甘·地鳴。',
  }
},
[1519] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Leve 2 aplicações de Unguento de Ritual à Vidente Pena do Corvo na Aldeia Narache.‡Принесите 2 порции ритуальной мази провидице Воронье Перо в Лагерь Нараче.‡Bringt 2 Dosen Ritualsalbe zu Seherin Rabenfeder im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 의식의 물약 2개를 가져가야 합니다.‡Lleva 2 dosis de ungüento de ritual a la vidente Plumacuervo al Campamento Narache.‡Lleva 2 dosis de bálsamo ritual a la vidente Pluma de Cuervo al Campamento Narache.‡Apporter 2 Applications de Baume rituel à la Prophétesse Plume-de-corbeau au Camp Narache.‡给纳拉其营地的鸦羽先知带回2份仪式药膏。‡給納拉其營地的鴉羽先知帶回2份儀式藥膏。',
  }
},
[1520] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Encontre a Rocha dos Kodos e beba o Sapta da Terra.‡Найдите Дольмен Кодо и выпейте сапту земли.‡Sucht den Kodofels und trinkt das Erdsapta.‡코도 바위를 찾아 대지의 정기를 마셔야 합니다.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Encuentra la Roca de los Kodos y bebe la sapta de tierra.‡Trouver le Rocher des kodos et boire le Sapta de terre.‡找到科多石并喝下大地灵契。‡找到科多石並喝下大地靈契。',
  }
},
[1521] = {
  {
    'Clamor da Terra‡Зов Земли‡Ruf der Erde‡대지의 부름‡Llamada de la Tierra‡La llamada de la tierra‡L\'appel de la terre‡大地的召唤‡地之召喚',
    nil,
    'Leve o Quartzo Grosseiro à Vidente Pena do Corvo na Aldeia Narache.‡Отнесите грубый кварц провидице Воронье Перо в Лагерь Нараче.‡Bringt den Rohquarz zu Seherin Rabenfeder im Camp Narache.‡나라체 야영지에 있는 예언자 레이븐페더에게 천연 석영을 가져가야 합니다.‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Lleva el cuarzo en bruto a la vidente Pluma de Cuervo al Campamento Narache.‡Apportez le Quartz brut à la prophétesse Plume-de-corbeau au Camp Narache.‡将粗石英带给纳拉其营地的鸦羽先知。‡將劣質石英帶給納拉其營地的鴉羽先知。',
  }
},
[1522] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1523] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Encontre Kranal Fiss nos Sertões.‡Найдите в Степях Кранала Фисса.‡Sucht Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스를 찾아야 합니다.‡Busca a Kranal Fiss en Los Baldíos.‡Busca a Kranal Fiss en Los Baldíos.‡Trouver Kranal Fiss dans les Tarides.‡去贫瘠之地找到卡纳尔·菲斯。‡去貧瘠之地找到卡納爾·菲斯。',
  }
},
[1524] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Leve a Tocha da Chama Latente para Telf Joolam em Durotar.‡Отнесите факел Дремлющего Пламени Телфу Джуламу в Дуротаре.‡Bringt die Fackel der schlafenden Flamme zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 희미한 불씨의 횃불을 가져가야 합니다.‡Lleva la antorcha de la Llama durmiente a Telf Joolam a Durotar.‡Lleva la antorcha de la Llama Latente a Telf Joolam a Durotar.‡Apportez la Torche de la flamme dormante à Telf Joolam en Durotar.‡把眠炎火炬带给杜隆塔尔的泰尔夫·祖拉姆。‡把眠焰火炬帶給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1525] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Traga 1 Piche Ígneo e 1 Bornal de Reagentes para Telf Joolam em Durotar.‡Принесите 1 порцию огненной смолы и 1 мешочек с реагентами Телфу Джуламу в Дуротаре.‡Bringt 1 Feuerteerstück und 1 Reagenzienbeutel zu Telf Joolam in Durotar.‡듀로타에 있는 텔프 줄람에게 불붙인 타르 1개와 시약 주머니 1개를 가져가야 합니다.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Lleva 1 alquitrán y 1 faltriquera de componentes a Telf Joolam a Durotar.‡Apporter 1 Goudron de feu et 1 Bourse de réactifs à Telf Joolam en Durotar.‡找到1个火焰焦油和1个试剂袋，把它们交给杜隆塔尔的泰尔夫·祖拉姆。‡找到1個火焰焦油和1個試劑袋，把它們交給杜洛塔的泰爾夫·祖拉姆。',
  }
},
[1526] = {
  {
    'Clamor do fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Derrote a Manifestação Menor do Fogo e coloque a Brasa Faiscante no braseiro do Altar da Chama Eterna.‡Сразитесь с низшим воплощением огня и поместите светящийся уголек в жаровню в святилище Неугасимого Пламени.‡Besiegt die schwache Feuermanifestation und legt Glut in die Kohlenpfanne auf dem Schrein der ewigen Flamme.‡하급 불의 현신을 물리친 다음 희미한 불꽃의 화로에 타오르는 불꽃을 넣어야 합니다.‡Derrota a la Manifestación de fuego menor y coloca las ascuas resplandecientes sobre el altar de la llama eterna.‡Derrota a la Manifestación de fuego menor y coloca las ascuas ardientes sobre el altar de la llama eterna.‡Vaincre la Manifestation de feu mineure, et placer sa Braise rougeoyante dans le brasero, en haut de l\'Autel de la flamme éternelle.‡击败火焰之魂，将余烬放在恒焰圣殿屋顶的火盆里。‡擊敗火焰之靈體，將餘燼放在恒焰聖殿屋頂的火盆裡。',
  }
},
[1527] = {
  {
    'Clamor do Fogo‡Зов Огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Leve a Tocha da Chama Eterna a Kranal Fiss nos Sertões.‡Принесите факел Неугасимого Пламени Краналу Фиссу в Степи.‡Bringt die Fackel der ewigen Flamme zu Kranal Fiss im Brachland.‡불모의 땅에 있는 크라날 피스에게 영원한 불꽃의 횃불을 가져가야 합니다.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Lleva la antorcha de la llama eterna a Kranal Fiss a Los Baldíos.‡Apportez la Torche de la flamme éternelle à Kranal Fiss dans les Tarides.‡将恒焰火炬交给贫瘠之地的卡纳尔·菲斯。‡將恆焰火炬交給貧瘠之地的卡納爾·菲斯。',
  }
},
[1528] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1529] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encontre Islen Vidente da Água nos Sertões.‡Отыщите в Степях Ислену Заклинательницу Воды.‡Sucht Islen Wasserdeuter im Brachland.‡불모의 땅에서 이슬렌 워터시어를 찾아야 합니다.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Encuentra a Islen Vidente del Agua en Los Baldíos.‡Trouver Islen Oeil-des-rivières dans les Tarides.‡找到贫瘠之地的水之先知伊斯伦。‡找到貧瘠之地的水之先知伊斯倫。',
  }
},
[1530] = {
  {
    'O clamor da água‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Find Brine at Blackthorn Ridge in Southern Barrens.‡Отыщите Брин на Хребте Черных Шипов в Южных степях.‡Sucht Brine beim Schwarzdorngrat im südlichen Brachland.‡불모의 땅 남부, 검은가시 마루에 있는 브린을 찾아야 합니다.‡Encuentra a Salmuera en la Loma Espina Negra, en los Baldíos del Sur.‡Encuentra a Salmuera en la Loma Espina Negra, en Los Baldíos del Sur.‡Trouver Brine à la Crête de Noirépine, dans les Tarides du sud.‡到南贫瘠之地的黑棘山去找到布瑞恩。‡到南貧瘠之地的黑棘山去找布瑞恩。',
  }
},
[1531] = {
  {
    'Clamor do ar‡Зов Воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·雲眼。',
  }
},
[1532] = {
  {
    'Clamor do ar‡Зов Воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Encontre Pradosa Fita Nuvens em Mil Agulhas.‡Найдите Пратту Заклинательницу Туч в Тысяче Игл.‡Sucht Prate Wolkendeuter in Tausend Nadeln.‡버섯구름 봉우리에서 프레이트 클라우드시어를 찾아야 합니다.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Encuentra a Prate Vidente de las Nubes en Las Mil Agujas.‡Trouver Prate Oeil-des-nuages aux Mille pointes.‡到千针石林去找普拉特·白云。‡到千針石林去找普拉特·雲眼。',
  }
},
[1533] = {
  {
    '<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air‡<NYI> Call of Air',
