[804] = {
  {
    'Sarkoth‡Саркот‡Sarkoth‡사르코스‡Sarkoth‡Sarkoth‡Sarkoth‡萨科斯‡薩科斯',
    nil,
    'Leve as notícias sobre os apuros de Hana\'zua a Gornek, no Covil.‡Расскажите Горнеку о том, что Хана\'зуа в беде.‡Informiert Gornek beim Höhlenbau über Hana\'zuas Notlage.‡동굴 막사에 있는 고르넥에게 하나주아의 현재 상황을 전해야 합니다.‡Informa de la situación de Hana\'zua a Gornek en El Cubil.‡Informa de la situación de Hana\'zua a Gornek en El Cubil.‡Informer Gornek, à l\'Antre, de la situation critique dans laquelle se trouve Hana\'zua.‡将哈纳祖目前的状况告诉大兽穴内的高内克。‡將哈納祖目前的狀況告訴大獸穴內的高內克。',
  }
},
[805] = {
  {
    'Apresente-se na Aldeia Sen\'jin‡Деревня Сен\'джин‡Bericht erstatten in Sen\'jin‡센진 마을에 보고‡Preséntate en el Poblado Sen\'jin‡Preséntate en el Poblado Sen\'jin‡Faire un rapport au Village de Sen\'jin‡去森金村报到‡去森金村報到',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을에 있는 가드린 장로와 대화해야 합니다.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談話。',
  }
},
[806] = {
  {
    'Tempestades sombrias‡Сгущаются черные тучи‡Dunkle Stürme‡다크스톰‡Oscuras tormentas‡Oscuras tormentas‡De sombres orages‡黑暗风暴‡黑暗風暴',
    nil,
    'Leve a Garra do Bulho para Orgnil Chaganalma no Monte Navalha.‡Принесите коготь Пшикса Оргнилу Душегрызу из Колючего Холма.‡Bringt Zischels Klaue zu Orgnil Narbenseele in Klingenhügel.‡칼바위 언덕에 있는 오르그닐 소울스카에게 피즐의 발톱을 가져가야 합니다.‡Lleva la garra de Fizzle a Orgnil Escaralma a Cerrotajo.‡Lleva la zarpa de Fizzle a Orgnil Escaralma a Cerrotajo.‡Apporter la Griffe de Féplouf à Orgnil Marque-l\'âme à Tranchecolline.‡把费索的爪子带给剃刀岭的奥戈尼尔·魂痕。‡把費索的爪子帶給剃刀嶺的奧戈尼爾·魂痕。',
  }
},
[808] = {
  {
    'O crânio de Minshina‡Череп Миншины‡Minshinas Schädel‡민시나의 해골‡La calavera de Minshina‡La calavera de Minshina‡Le crâne de Minshina‡明希纳的徽记‡明希納的顱骨',
    nil,
    'Recupere o Crânio de Minshina do círculo do poder nas Ilhas do Eco.|n|nLeve-o para o Mestre Gadrin na Aldeia Sen\'jin.‡Украдите череп Миншины из магического круга на островах Эха.|n|nПринесите его мастеру Гадрину в деревне Сен\'джин.‡Holt Minshinas Schädel aus dem Kreis der Macht auf den Echoinseln.|n|nBringt ihn Meister Gadrin in Sen\'jin.‡메아리 섬에 있는 힘의 마법진에서 민시나의 해골을 찾아와야 합니다.|n|n센진 마을에 있는 장로 가드린에게 민시나의 해골을 가져가야 합니다.‡Recupera la calavera de Minshina del círculo de poder de las Islas del Eco. |n|nLlévasela al maestro Gadrin al Poblado Sen\'jin.‡Recupera la calavera de Minshina del círculo de poder de las Islas del Eco.|n|nLlévasela al maestro Gadrin al Poblado Sen\'jin.‡Récupérer le Crâne de Minshina dans le Cercle de puissance, sur les îles de l\'Écho.|n|nLe rapporter à Maître Gadrin, au village de Sen\'jin.‡到回音群岛上去，将岛上法阵中的明希纳的徽记带回来，交给森金村的加德林大师。‡到回音群島上去，將島上法陣中的明希納的顱骨帶回來，交給森金村的加德林大師。',
  }
},
[809] = {
  {
    'Ak\'Zeloth‡Ак\'Зелот‡Ak\'Zeloth‡아크젤로스‡Ak\'Zeloth‡Ak\'Zeloth‡Ak\'Zeloth‡雅克塞罗斯‡雅克塞羅斯',
    nil,
    'Fale com Ak\'Zeloth nos Sertões.‡Поговорите с Ак\'Зелотом в Степях.‡Sprecht im Brachland mit Ak\'Zeloth.‡불모의 땅에 있는 아크젤로스와 대화해야 합니다.‡Habla con Ak\'Zeloth en Los Baldíos.‡Habla con Ak\'Zeloth en Los Baldíos.‡Parlez à Ak\'Zeloth, dans les Tarides.‡到贫瘠之地去和雅克塞罗斯谈一谈。‡到貧瘠之地去和雅克塞羅斯談話。',
  }
},
[810] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Принесите 6 малых скорпидских панцирей Кор\'гхану в деревню Сен\'джин.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡Bring 6 Small Scorpid Carapaces to Kor\'ghan in Sen\'jin Village.‡找6個小型蠍殼帶給森金村的考格漢。',
  }
},
[812] = {
  {
    'Busca da cura‡Нужда в исцелении‡Heilmittel benötigt‡해독약 구하기‡Se necesita un remedio‡Se necesita un remedio‡Besoin d\'un remède‡救命如救火‡救命如救火',
    nil,
    'Encontre Kor\'ghan em Orgrimmar e pegue o Antídoto para Caudaçonha. Então leve o antídoto para Rhinag perto da fronteira noroeste de Durotar.‡Найдите в Оргриммаре Кор\'гхана и добудьте сыворотку от яда ядохвоста. Принесите сыворотку Ринагу на северо-западной границе Дуротара.‡Sucht Kor\'ghan in Orgrimmar und besorgt das Siechstachelgegengift. Bringt das Gegengift dann zu Rhinag an der nordwestlichen Grenze von Durotar.‡오그리마에서 코간을 찾아서 해독약을 받은 다음, 불모의 땅과 인접한 듀로타 변두리에 있는 리나그에게 맹독전갈 해독약을 가져가야 합니다.‡Encuentra a Kor\'ghan en Orgrimmar y consigue el antídoto para Venocola. Luego lleva el antídoto a Rhinag. Está cerca del límite noroeste de Durotar.‡Encuentra a Kor\'ghan en Orgrimmar y consigue el antídoto para venocola. Luego lleva el antídoto a Rhinag. Está cerca del límite noroeste de Durotar.‡Trouver Kor\'ghan à Orgrimmar et obtenir l\'Antidote du Queue-venin. L\'apporter ensuite à Rhinag près de la frontière nord-ouest de Durotar.‡找到毒尾蝎的解毒剂，把它交给杜隆塔尔西北边境的林纳格。‡找到毒尾蠍的解毒劑，把它交給杜洛塔西北邊境的林納格。',
  }
},
[813] = {
  {
    'Em busca do antídoto‡Поиски противоядия‡Suche nach dem Gegengift‡해독약 구하기‡En busca del antídoto‡En busca del antídoto‡La recherche de l\'antidote‡寻找解毒剂‡尋找解毒劑',
    nil,
    'Leve 4 Vesículas de Veneno de Caudaçonha para Kor\'ghan em Orgrimmar.‡Принесите 4 ядовитых железы ядохвоста Кор\'гхану в Оргриммаре.‡Bringt Kor\'ghan in Orgrimmar 4 Giftbeutel eines Siechstachelskorpiden.‡오그리마에 있는 코간에게 맹독전갈 독주머니 4개를 가져가야 합니다.‡Lleva 4 glándulas de veneno de Venocola a Kor\'ghan a Orgrimmar.‡Lleva 4 glándulas de veneno de venocola a Kor\'ghan a Orgrimmar.‡Apporter 4 Glandes à venin de Queue-venin à Kor\'ghan à Orgrimmar.‡收集4个毒尾蝎的毒囊，把它们交给奥格瑞玛的考格汉。‡收集4個毒尾蠍的毒囊，把它們交給奧格瑪的考格漢。',
  }
},
[814] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.‡Bring 10 Chunks of Boar Meat to Cook Torka in Razor Hill.',
  }
},
[815] = {
  {
    'Quebrar alguns ovos‡Хорошенький омлет‡Zerbrecht ein paar Eier‡알 요리‡Romper huevos‡Romper huevos‡Des œufs pour l\'omelette‡恐龙蛋大餐‡恐龍蛋大餐',
    nil,
    'Leve 3 Ovos de Açoitacauda para o Cozinheiro Torka no Monte Navalha.‡Принесите 3 яйца кнутохвостов повару Торке в Колючий Холм.‡Bringt dem Koch Torka in Klingenhügel 3 Schwanzpeitschereier.‡칼바위 언덕에 있는 요리사 토르카에게 붉은발톱랩터 알 3개를 가져가야 합니다.‡Lleva 3 huevos de colazote al cocinero Torka de Cerrotajo.‡Lleva 3 huevos de colazote al cocinero Torka de Cerrotajo.‡Rapporter 3 Œufs de fouette-queue au cuisinier Torka, à Tranchecolline.‡收集3个鞭尾龙的蛋，并把它们带给剃刀岭的厨师托尔卡。‡收集3個鞭尾龍的蛋，並把它們帶給剃刀嶺的廚師托爾卡。',
  }
},
[816] = {
  {
    'Em memória‡Пропавший, но не забытый‡Verloren, aber nicht vergessen‡크론의 흔적‡Perdido, pero no olvidado‡Perdido, pero no olvidado‡L\'égaré‡丢失的孩子‡丟失的孩子',
    nil,
    'Leve uma prova do destino de Kron para Misha Tor\'kren na fazenda a noroeste do Monte Navalha.‡Принесите известие о судьбе, постигшей Крона, Майше Тор\'крен в усадьбу к северо-западу от Колючего Холма.‡Bringt Misha Tor\'kren auf dem Bauernhof nordwestlich von Klingenhügel einen Hinweis auf Krons Schicksal.‡칼바위 언덕의 북서쪽 농장에 있는 미샤 토크렌에게 크론의 흔적을 가져가야 합니다.‡Lleva un indicio del destino de Kron a Misha Tor\'kren, a la granja que hay al noroeste de Cerrotajo.‡Lleva un indicio del destino de Kron a Misha Tor\'kren, a la granja que hay al noroeste de Cerrotajo.‡Trouver un indice du sort de Kron et en informer Misha Tor\'kren, à la ferme, au nord-ouest de Tranchecolline.‡把关于克鲁恩的消息告诉剃刀岭西北部农场中的米莎·托克伦。‡把關於克魯恩的消息告訴剃刀嶺西北部農場中的米莎·托克雷。',
  }
},
[817] = {
  {
    'Presa prática‡Полезная добыча‡Praktische Beute‡유용한 사냥감‡Presa práctica‡Presa práctica‡Proie nécessaire‡生活所需的虎皮‡生活所需的虎皮',
    nil,
    'Leve 4 Peles de Tigre de Durotar para Vel\'rin Presa na Aldeia Sen\'jin.‡Принесите 4 шкуры дуротарских тигров Вель\'рину Клыку в деревне Сен\'джин.‡Bringt Vel\'rin Fang in Sen\'jin 4 Durotartigerfelle.‡센진 마을에 있는 벨린 팡에게 듀로타 호랑이 가죽 4필을 가져가야 합니다.‡Lleva 4 pelajes de tigres de Durotar a Vel\'rin Colmillo al Poblado Sen\'jin.‡Lleva 4 pelajes de tigres de Durotar a Vel\'rin Colmillo al Poblado Sen\'jin.‡Apporter 4 Peaux de tigres de Durotar à Vel\'rin Croc, au village de Sen\'jin.‡收集四张杜隆塔尔虎皮，并把它们交给森金村的维尔林·长牙。‡收集四張杜洛塔虎皮，並把它們交給森金村的維爾林·長牙。',
  }
},
[818] = {
  {
    'Um espírito solvente‡Растворитель‡Ein geistvolles Getränk‡나약한 정신‡Un espíritu responsable‡Un espíritu responsable‡Un esprit parfaitement éduqué‡沃纳尔大师‡沃納爾大師',
    nil,
    'Leve 4 Olhos de Makrura Intactos e 8 ampolas de Muco de Rastejante para Mestre Vornal na Aldeia Sen\'jin.‡Принесите 4 невредимых глаза макрур и 8 фиалов со слизью крабов мастеру Ворналу в деревне Сен\'джин.‡Bringt Meister Vornal in Sen\'jin 4 intakte Makruraaugen und 8 Phiolen Kriechersekret.‡센진 마을에 있는 장로 보르날에게 온전한 마크루라의 눈 4개와 붉은톱니게 점액 8병을 가져가야 합니다.‡Lleva 4 ojos de makrura intactos y 8 viales de mucosidad de reptador al maestro Vornal al Poblado Sen\'jin.‡Lleva 4 ojos de makrura intactos y 8 viales de moco de reptador al maestro Vornal al Poblado Sen\'jin.‡Apporter 4 Yeux de makrura intacts et 8 Fioles de mucus de clampant à maître Vornal, au village de Sen\'jin.‡把4个龙虾人的眼睛和8小瓶蟹胶带到森金村，交给沃纳尔大师。‡把4個龍蝦人的眼睛和8小瓶蟹膠帶到森金村，交給沃納爾大師。',
  }
},
[819] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Encontre alguém que saiba sobre o Barril Vazio do Chen.‡Отыщите кого-нибудь, кто знает о пустом бочонке Чэня.‡Sucht jemanden, der etwas über Chens leeres Fässchen weiß.‡첸의 빈 술통에 대해 아는 이를 찾아야 합니다.‡Encuentra a alguien que sepa algo sobre el barril vacío de Chen.‡Encuentra a alguien que sepa algo sobre el barril vacío de Chen.‡Trouver quelqu\'un qui en sache davantage au sujet du Tonneau vide de Chen.‡找到对老陈的空酒桶有所了解的人。‡找到對老陳的空酒桶有所瞭解的人。',
  }
},
[821] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Leve 5 Presas de Leão da Savana, 5 Rins de Pinote e 1 Chifre de Lagarto Trovejante para o Cervejeiro Drohn, em Vila Catraca.‡Принесите 5 клыков равнинного льва, 5 почек долгонога и 1 рог рокочущей ящерицы пивовару Дрону в Кабестан.‡Bringt Braumeister Drohn in Ratschet 5 Savannenlöwenhauer, 5 Ebenenschreiternieren und 1 Donnerechsenhorn.‡톱니항에 있는 양조업자 드론에게 사바나 사자 엄니 5개, 초원타조 신장 5개와 천둥도마뱀의 뿔 1개를 가져가야 합니다.‡Llévale 5 colmillos de león de la sabana, 5 riñones de zancudo de llanura y 1 cuerno de truenagarto al maestro cervecero Drohn en Trinquete.‡Llévale 5 colmillos de león de la sabana, 5 riñones de zancudo de llanura y 1 cuerno de truenagarto al maestro cervecero Drohn en Trinquete.‡Apporter 5 Canines de lion des savanes, 5 Rognons de trotteur des plaines, et 1 Corne de lézard-tonnerre au brasseur Drohn à Cabestan.‡收集5颗草原狮的獠牙、5个平原陆行鸟的肾脏和1根雷霆蜥蜴的角，把它们交给棘齿城的酿酒师德罗恩。‡收集5顆草原獅的獠牙、5個平原陸行鳥的腎臟和1根雷霆蜥蜴的角，把它們交給棘齒城的釀酒師德羅恩。',
  }
},
[822] = {
  {
    'Barril Vazio do Chen‡Пустой бочонок Чэня‡Chens leeres Fässchen‡첸의 빈 술통‡El barril vacío de Chen‡El barril vacío de Chen‡Tonneau vide de Chen‡老陈的空酒桶‡老陳的空酒桶',
    nil,
    'Leve 5 Glândulas Relampejantes, 1 Glândula Salivar de Falcotrom e 1 Fígado de Kodo para o Cervejeiro Drohn, em Vila Catraca.‡Принесите 5 грозовых желез, 1 слюнную железу грозового змея и 1 печень кодо пивовару Дрону в Кабестан.‡Bringt Braumeister Drohn in Ratschet 5 Blitzschlagdrüsen, 1 Donnerfalkenspeicheldrüse und 1 Kodoleber.‡톱니항에 있는 양조업자 드론에게 번개 분출선 5개, 천둥매 타액 분비선 1개, 코도 간 1개를 가져가야 합니다.‡Llévale 5 glándulas relampagueantes, 1 glándula salivaria de halcón trueno y 1 hígado de kodo al maestro cervecero Drohn en Trinquete.‡Llévale 5 glándulas relampagueantes, 1 glándula salivaria de halcón trueno y 1 hígado de kodo al maestro cervecero Drohn en Trinquete.‡Apporter 5 Glandes d\'éclair, 1 Glande salivaire de faucon-tonnerre et 1 Foie de kodo au brasseur Drohn à Cabestan.‡收集5个闪电腺、1个雷鹰的唾液腺和1个科多兽的肝脏，把它们交给棘齿城里的酿酒师德罗恩。‡收集5個閃電腺、1個雷鷹的唾液腺和1個科多獸的肝臟，把它們交給棘齒城裡的釀酒師德羅恩。',
  }
},
[823] = {
  {
    'Apresente-se a Orgnil‡Явиться к Оргнилу‡Bericht an Orgnil‡오르그닐에게 보고‡Informa a Orgnil‡Informa a Orgnil‡Un rapport à Orgnil‡向奥戈尼尔报告‡向奧戈尼爾報告',
    nil,
    'Fale com Orgnil Chaganalma no Monte Navalha.‡Поговорите с Оргнилом Душегрызом на Колючем Холме.‡Sprecht mit Orgnil Narbenseele in Klingenhügel.‡칼바위 언덕에 있는 오르그닐 소울스카와 대화해야 합니다.‡Habla con Orgnil Escaralma de Cerrotajo.‡Habla con Orgnil Escaralma de Cerrotajo.‡Parler à Orgnil Marque-l\'âme à Tranchecolline.‡和剃刀岭的奥戈尼尔·魂痕谈一谈。‡和剃刀嶺的奧戈尼爾·魂痕談話。',
  }
},
[824] = {
  {
    'Je\'neu da Harmonia Telúrica‡Дже\'неу из Служителей Земли‡Je\'neu vom Irdenen Ring‡속세의 고리회 제네우‡Je\'neu del Anillo de la Tierra‡Je\'neu del Anillo de la Tierra‡Je\'neu du Cercle terrestre‡大地之环的耶努萨克雷‡陶土議會的耶努薩克雷',
    nil,
    'Leve o Globo d\'Água Conspurcado para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Отнесите оскверненную водяную сферу Дже\'неу Санкри в форт Зорам\'гар в Ясеневом лесу.‡Bringt die beschmutzte Wasserkugel zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 더럽혀진 물구슬을 가져가야 합니다.‡Llévale el globo de agua contaminada a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el globo de agua contaminada a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Globe d\'eau souillée à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, dans Orneval.‡将被污染的水球交给灰谷佐拉姆加前哨站的耶努萨克雷。‡將被污染的水球交給梣谷佐拉姆加前哨站的耶努薩克雷。',
  }
},
[825] = {
  {
    'Dos destroços...‡Обломки кораблекрушения‡Aus den Wrackteilen geborgen...‡난파선‡Los restos del naufragio...‡Los restos del naufragio...‡Des épaves‡海底沉船‡海底沉船',
    nil,
    'Gar\'Thok, do Monte Navalha, quer que você recupere 3 Ferramentas Gnômicas dos destroços junto à costa.‡Га\'Ток с Колючего Холма просит вас принести ему 3 комплекта инструментов гномов, найти которые можно в обломках кораблей у побережья.‡Gar\'Thok von Klingenhügel möchte, dass Ihr 3 Gnomenwerkzeuge aus den Wrackteilen vor der Küste holt.‡칼바위 언덕의 가르톡이 해안에 있는 난파선에서 노움 공구 3개를 찾아 달라고 지시했습니다.‡Gar\'Thok de Cerrotajo quiere que recuperes 3 herramientas gnómicas de los restos de naufragio de la costa.‡Gar\'Thok de Cerrotajo quiere que recuperes 3 herramientas gnómicas de los restos de naufragio de la costa.‡Gar\'Thok de Tranchecolline veut que vous retrouviez 3 Outils gnomes parmi les épaves près de la côte.‡剃刀岭的加索克要你从海岸边的舰队残骸中打捞出3件侏儒的工具。‡剃刀嶺的加索克要你從海岸邊的艦隊殘骸中打撈出3件地精的工具。',
  }
},
[826] = {
  {
    'Zalazane‡Залазан‡Zalazane‡잘라제인‡Zalazane‡Zalazane‡Zalazane‡扎拉赞恩‡札拉贊恩',
    nil,
    'Derrote Zalazane.|n|nMate 8 Trolls Vodu e 8 Trolls Bagateados.|n|nLeve a Cabeça do Zalazane para Gadrin.‡Убейте Залазана, убейте 8 троллей-вудуистов и 8 проклятых троллей.|n|nПринесите голову Залазана Гадрину.‡Besiegt Zalazane.|n|nTötet 8 Voodootrolle und 8 verhexte Trolle.|n|nBringt Gadrin Zalazanes Kopf.‡잘라제인을 처치해야 합니다.|n|n부두교 트롤 8명과 주술에 걸린 트롤 8명을 처치해야 합니다.|n|n가드린에게 잘라제인의 머리카락을 가져가야 합니다.‡Derrota a Zalazane. |n|nMata a 8 trols de vudú y 8 trols embrujados. |n|nLleva la cabeza de Zalazane a Gadrin.‡Derrota a Zalazane.|n|nMata a 8 trols vudú y 8 trols maléficos.|n|nLleva la cabeza de Zalazane a Gadrin.‡Battre Zalazane.|n|nTuer 8 Trolls vaudou et 8 Trolls maléficiés.|n|nApporter la Tête de Zalazane à Gadrin.‡打败扎拉赞恩。|n|n杀死8个巫毒巨魔和8个妖术巨魔。|n|n把扎拉赞恩的徽记带给加德林大师。‡打敗札拉贊恩。|n|n殺死8個巫毒食人妖和8個被施妖術的食人妖。|n|n把札拉贊恩的頭顱帶給加德林大師。',
  }
},
[827] = {
  {
    'A Rocha da Caveira‡Скала Черепа‡Die Knochenhöhle‡해골 바위굴‡Roca del Cráneo‡Roca del Cráneo‡Le rocher du crâne‡骷髅石‡骷髏石',
    nil,
    'Junte Colares Calcinantes dos sectários na Rocha da Caveira.|n|nLeve-os para Margoz no acampamento dele.‡Отберите у фанатиков из Скалы Черепа обжигающие ошейники.|n|nПринесите их в лагерь Маргозу.‡Besorgt von den Kultisten an der Knochenhöhle ein paar Senghalsbänder.|n|nBringt sie Margoz in seinem Lager.‡해골 바위굴에 있는 숭배자들을 처치하고 이글거리는 목걸이를 모아야 합니다.|n|n야영지에 있는 마르고즈에게 수집한 목걸이를 가져가야 합니다.‡Recoge los collares abrasadores de los cultores de Roca del Cráneo. |n|nLlévaselos a Margoz a su campamento.‡Recoge los collares abrasadores de los cultores de Roca del Cráneo. |n|nLlévaselos a Margoz a su campamento.‡Prendre les Colliers brûlants des sectateurs au Rocher du crâne.|n|nLes apporter à Margoz à son camp.‡在骷髅石中的火刃祭司身上收集灼热项圈，|n|n然后交给玛高兹。‡在骷髏石中的火刃祭司身上收集灼熱項圈，|n|n然後交給瑪高茲。',
  }
},
[828] = {
  {
    'Margoz‡Маргоз‡Margoz‡마르고즈‡Margoz‡Margoz‡Margoz‡玛高兹‡瑪高茲',
    nil,
    'Fale com Margoz.‡Поговорите с Маргозом.‡Sprecht mit Margoz.‡마르고즈와 대화해야 합니다.‡Habla con Margoz.‡Habla con Margoz.‡Parler à Margoz.‡和玛高兹谈一谈。‡和瑪高茲談話。',
  }
},
[829] = {
  {
    'Neeru Cortafogo‡Ниру Огненный Клинок‡Neeru Feuerklinge‡네루 파이어블레이드‡Neeru Hojafuego‡Neeru Hojafuego‡Neeru Lamefeu‡尼尔鲁·火刃‡尼爾魯·火刃',
    nil,
    'Leve um Colar de Amostra para Neeru Cortafogo em Orgrimmar.‡Отнесите один обжигающий ошейник Нииру Огненному Клинку в Оргриммаре.‡Bringt Neeru Feuerklinge in Orgrimmar ein Senghalsband-Muster.‡오그리마에 있는 네루 파이어블레이드에게 목걸이 견본을 가져가야 합니다.‡Lleva un collar de muestra a Neeru Hojafuego a Orgrimmar.‡Lleva un collar de muestra a Neeru Hojafuego a Orgrimmar.‡Apporter un Spécimen de collier à Neeru Lamefeu à Orgrimmar.‡给奥格瑞玛的尼尔鲁·火刃带去一个项圈样本。‡給奧格瑪的尼爾魯·火刃帶去一個項圈樣本。',
  }
},
[830] = {
  {
    'As ordens do almirante‡Приказы адмирала‡Die Befehle des Admirals‡제독의 명령서‡Las órdenes del almirante‡Las órdenes del almirante‡Les ordres de l\'amiral‡将军的命令‡上將的命令',
    nil,
    'Leve as Ordens do Almirante Proudmore para Gar\'Thok no Monte Navalha.‡Отнесите приказы адмирала Праудмура Га\'току на Колючий Холм.‡Bringt Gar\'Thok in Klingenhügel Admiral Prachtmeers Befehle.‡칼바위 언덕에 있는 가르톡에게 제독 프라우드무어의 명령서를 가져가야 합니다.‡Lleva las órdenes del almirante Valiente a Gar\'Thok a Cerrotajo.‡Lleva las órdenes del almirante Valiente a Gar\'Thok a Cerrotajo.‡Apporter les Ordres de l\'amiral Portvaillant à Gar\'Thok de Tranchecolline.‡把普罗德摩尔将军的命令带给剃刀岭的加索克。‡把普勞德摩爾上將的命令帶給剃刀嶺的加索克。',
  }
},
[831] = {
  {
    'As ordens do almirante‡Приказы адмирала‡Die Befehle des Admirals‡제독의 명령서‡Las órdenes del almirante‡Las órdenes del almirante‡Les ordres de l\'amiral‡将军的命令‡上將的命令',
    nil,
    'Entregue as Ordens do Almirante Proudmore a Vol\'jin nos aposentos de Thrall, em Orgrimmar.‡Доставьте приказы адмирала Праудмура Вол\'джину в зал приемов Тралла в Оргриммаре.‡Bringt Vol\'jin in Thralls Kammer in Orgrimmar Admiral Prachtmeers Befehle.‡오그리마에 있는 스랄의 요새로 가서 제독 프라우드무어의 명령서를 볼진에게 전달해야 합니다.‡Entrega las órdenes del almirante Valiente a Vol\'jin a la cámara de Thrall en Orgrimmar.‡Entrega las órdenes del almirante Valiente a Vol\'jin a la cámara de Thrall en Orgrimmar.‡Porter les Ordres de l\'amiral Portvaillant à Vol\'jin, dans les appartements de Thrall à Orgrimmar.‡把普罗德摩尔将军的命令交给奥格瑞玛城中的沃金，他就在萨尔的大厅里。‡把普勞德摩爾上將的命令交給奧格瑪城中的沃金，他就在索爾的大廳裡。',
  }
},
[832] = {
  {
    'Sombras incandescentes‡Пылающие тени‡Brennende Schatten‡이글거리는 그림자‡Sombras Ardientes‡Sombras Ardientes‡Ombres ardentes‡燃影之眼‡燃影之眼',
    nil,
    'Take this eye to Neeru Fireblade in Orgrimmar.‡Отнесите этот амулет Ниру Огненному Клинку в Оргриммар.‡Bringt Neeru Feuerklinge in Orgrimmar dieses Auge.‡이 눈을 오그리마에 있는 네루 파이어블레이드에게 가져가야 합니다.‡Lleva este ojo a Neeru Hojafuego que está en Orgrimmar.‡Lleva este ojo a Neeru Hojafuego que está en Orgrimmar.‡Apporter cet Oeil à Neeru Lamefeu à Orgrimmar.‡把这颗燃影之眼带给奥格瑞玛的尼尔鲁·火刃。‡把這顆燃影之眼帶給奧格瑪的尼爾魯·火刃。',
  }
},
[833] = {
  {
    'Sepultamento sagrado‡Священное погребение‡Eine heilige Bestattung‡신성한 묘지‡Cementerio sagrado‡Cementerio sagrado‡Le cimetière sacré‡神圣的墓地‡神聖的墓地',
    nil,
    'O Erudito Totem da Chuva quer que você mate 8 Traiçoeiros Costagulha no Rochedo Vermelho.‡Сказитель Тотем Дождя попросил вас убить 8 злоумышленников из племени Дыбогривов в Красных cкалах.‡Der Hüter des Wissens Regentotem möchte, dass Ihr bei den Teufelsfelsen 8 Eindringlinge der Borstennacken tötet.‡현자 레인토템이 붉은 바위 언덕에 있는 뾰족털일족 약탈자 8명을 처치해 달라고 부탁했습니다.‡El Tradicionalista Tótem de Lluvia quiere que mates a 8 intrusos Erizapúas en Roca Roja.‡El tradicionalista Tótem de Lluvia quiere que mates 8 intrusos erizapúas en Roca Roja.‡Le Gardien du savoir Totem-de-pluie veut que vous tuiez 8 Intrus Dos-hirsute aux Rochers rouges.‡博学者诺拉·暴雨图腾要你在赤色石杀掉8个刺背干涉者。‡博學者諾拉·暴雨圖騰要你在赤色石殺掉8個刺背干涉者。',
  }
},
[834] = {
  {
    'Ventos do deserto‡Ветра пустыни‡Wind in der Wüste‡사막의 바람‡Las arpías Viento Seco‡Las arpías Viento Seco‡Des vents dans le désert‡沙漠之风‡沙漠之風',
    nil,
    'Recupere 5 Sacos de Suprimentos e entregue-os a Rezlak perto de Orgrimmar.‡Добудьте 5 мешков припасов и верните их Резлаку близ Оргриммара.‡Holt 5 Säcke Vorräte und bringt sie Rezlak in der Nähe von Orgrimmar.‡보급품 부대 5개를 찾은 다음 오그리마 근처에 있는 레즐락에게 돌아가야 합니다.‡Recupera 5 sacos de suministros y llévaselos a Rezlak que está cerca de Orgrimmar.‡Consigue 5 sacos de suministros y regresa con Rezlak cerca de Orgrimmar.‡Retrouver 5 Sacs de marchandises et les rendre à Rezlak près d\'Orgrimmar.‡为奥格瑞玛城外的雷兹拉克取回5个装满货物的袋子。‡為奧格瑪城外的雷茲拉克取回5個裝滿貨物的袋子。',
  }
},
[835] = {
  {
    'Faça o que eu digo...‡Обеспечение безопасного сообщения‡Sicherung der Linien‡보급로 확보‡Asegurar las rutas‡Asegurar las rutas‡Des lignes sécurisées‡保卫商路‡保衛商路',
    nil,
    'Mate 12 Selvagens Sopravento e 8 Bruxas da Tempestade Sopravento para Rezlak perto do Barranco da Ravina Seca.‡Убейте 12 дикарок из стаи Пыльного Ветра и 8 грозовых ведьм из стаи Пыльного Ветра, обитающих возле Сухой лощины, по просьбе Резлака.‡Tötet für Rezlak in der Nähe der Staubwindklamm 12 Wilde der Staubschwingen und 8 Sturmhexen der Staubschwingen.‡레즐락을 위해 모래바람 협곡 근처에 있는 먼지바람일족 여전사 12명과 먼지바람일족 폭풍마녀 8명을 처치해야 합니다.‡Mata a 12 salvajes Viento Seco y 8 brujas de la Tormenta Viento Seco para Rezlak, que está cerca del Barranco Árido.‡Mata a 12 Salvajes Viento Seco y 8 Brujas de la Tormenta Viento Seco para Rezlak, cerca de Barranco Árido.‡Tuer 12 Terrevent sauvages et 8 Sorcières des tempêtes Terrevent pour Rezlak près du Ravin asséché.‡为奥格瑞玛附近的雷兹拉克杀掉12个尘风暴徒和8个尘风雷巫。‡為奧格瑪附近的雷茲拉克殺掉12個塵風暴徒和8個塵風雷巫。',
  }
},
[836] = {
  {
    'Resgate OOX-09/HL!‡Спасти КПХ-9/HL!‡Rettet OOX-09/HL!‡OOX-09/HL 구출 작전‡¡Rescata a OOX-09/TI!‡¡Rescata a OOX-09/TI!‡À la rescousse de OOX-09/HL !‡拯救OOX-09/HL！‡拯救OOX-09/HL!',
    nil,
    'Escolte o OOX-09/HL em segurança e apresente-se ao Olhatorto Obnótico na Angra do Butim.‡Сопроводите OOX-09/HL в безопасное место, а потом доложитесь Карлсу Пропеллерзу в Пиратской Бухте.‡Bringt OOX-09/HL in Sicherheit und meldet Euch dann bei Glotz Widrikus in Beutebucht.‡OOX-09/HL을 안전하게 호위하여 무법항에 있는 오글소프 오브노티쿠스에게 가서 보고해야 합니다.‡Escolta a OOX-09/TI para que llegue sano y salvo e informa a Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-09/TI para que llegue sano y salvo e informa a Oglethorpe Obnoticus en Bahía del Botín.‡Escortez OOX-09/HL jusqu\'à ce qu\'il soit en sécurité, puis rendez compte à Orguignard Odipnoticus, à Baie-du-Butin.‡安全护送OOX-09/HL到达目的地，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡護送OOX-09/HL到安全地點，然後向藏寶海灣的奧格索普·奧布諾提斯回報。',
  }
},
[837] = {
  {
    'Invasão‡Вторжение‡Übergriff‡영토 침범‡Invasión‡Invasión‡Empiètement‡野猪人的进犯‡野豬人的進犯',
    nil,
    'Mate 4 Javatuscos Crinavalha, 4 Batedores Crinavalha, 4 Levanta-poeira Crinavalha e 4 Guardas de Batalha Crinavalha para Gar\'Thok no Monte Navalha.‡Убейте 4 свинобразов из племени Иглогривых, 4 разведчиков из племени Иглогривых, 4 пылемутов из племени Иглогривых и 4 боевых стражей из племени Иглогривых по просьбе Га\'Тока из Колючего Холма.‡Tötet für Gar\'Thok in Klingenhügel 4 Stacheleber der Klingenmähnen, 4 Späher der Klingenmähnen, 4 Staubläufer der Klingenmähnen und 4 Schlachtwachen der Klingenmähnen.‡칼바위 언덕의 가르톡을 위해 서슬갈기 가시멧돼지 4 마리와 서슬갈기일족 정찰병 4 마리, 서슬갈기일족 사막길잡이 4 마리, 서슬갈기일족 전투호위병 4 마리를 처치해야 합니다.‡Mata a 4 jabaespines Crines de Acero, 4 exploradores Crines de Acero, 4 correpolvos Crines de Acero y 4 guardias de batalla Crines de Acero para Gar\'Thok, de Cerrotajo.‡Mata a 4 jabaespines Crines de Acero, 4 exploradores Crines de Acero, 4 polvorosos Crines de Acero y 4 guardias de batalla Crines de Acero para Gar\'Thok, de Cerrotajo.‡Tuer 4 hurans Tranchecrin, 4 Eclaireurs Tranchecrin, 4 Lève-poussière Tranchecrin et 4 Gardes de guerre Tranchecrin pour Gar\'Thok de Tranchecolline.‡为剃刀岭的加索克杀掉4个钢鬃野猪人，4个钢鬃斥候，4个钢鬃传令兵和4个钢鬃卫兵。‡替剃刀嶺的加索克殺掉4個鋼鬃野豬人，4個鋼鬃斥候，4個鋼鬃傳令兵和4個鋼鬃戰地衛士。',
  }
},
[838] = {
  {
    'Scolomântia‡Некроситет‡Scholomance‡스칼로맨스‡Scholomance‡Scholomance‡Scholomance‡通灵学院‡通靈學院',
    nil,
    'Fale com o Boticário Trépido no Baluarte das Terras Pestilentas Ocidentais.‡Поговорите с аптекарем Дитерсом из Бастиона, что в Западных Чумных землях.‡Sprecht mit Apotheker Zitters am Bollwerk, westliche Pestländer.‡서부 역병지대의 보루에 있는 연금술사 디더스와 대화해야 합니다.‡Habla con el boticario Dithers en el Baluarte, en las Tierras de la Peste del Oeste.‡Habla con el boticario Dithers en el Baluarte, en las Tierras de la Peste del Oeste.‡Parler à l\'Apothicaire Dithers à la Barricade, dans les Maleterres de l\'ouest.‡和西瘟疫之地亡灵壁垒的药剂师迪瑟斯谈一谈。‡和西瘟疫之地亡靈壁壘的藥劑師迪瑟斯談話。',
  }
},
[839] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
