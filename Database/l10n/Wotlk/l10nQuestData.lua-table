[1301] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆士·海爾',
    nil,
    'Fale com Vincent Hyal no Porto de Menethil.‡Поговорите с Винсентом Хьялом в Гавани Менетилов.‡Sprecht mit Vincent Hyal im Hafen von Menethil.‡메네실 항구에 있는 빈센트 하이얄과 대화해야 합니다.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Ve al Puerto de Menethil y habla con Vincent Hyal.‡Discuter avec Vincent Hyal au port de Menethil.‡和米奈希尔港的文森特·海厄尔谈一谈。‡和米奈希爾港的文森·海爾談話。',
  }
},
[1302] = {
  {
    'James Hyal‡Джеймс Хьяль‡James Hyal‡제임스 하이얄‡James Hyal‡James Hyal‡James Hyal‡詹姆斯·海厄尔‡詹姆士·海爾',
    nil,
    'Fale com o Tabelião Lendry na Cidadela do Esteio, que fica em Theramore.‡Поговорите с клерком Лендри в Цитадели в Тераморе.‡Sprecht mit Amtmann Lendry bei der Wehrzitadelle in Theramore.‡테라모어 거점 요새에 있는 서기관 렌드리와 대화해야 합니다.‡Habla con el secretario Lendry, que está en la Ciudadela Garrida en Theramore.‡Habla con el secretario Lendry, que está en la Ciudadela Garrida en Theramore.‡Parler au greffier Lendry à la citadelle de Theramore.‡与塞拉摩城堡中的书记员伦德瑞谈一谈。‡和塞拉摩要塞的書記員倫德瑞談話。',
  }
},
[1318] = {
  {
    'Negócios pendentes‡Неоконченное дело Гордоков‡Die offene Rechnung der Gordok‡고르독 일 마무리‡Asunto Gordok sin finiquitar‡Asunto Gordok sin finiquitar‡Affaires inachevées chez les Gordok‡戈多克食人魔的事务‡戈多克巨魔的事務',
    nil,
    'Encontre as Manoplas do Poder de Gordok e devolva-as para o Capitão Kebrapaw no Gládio Cruel.|n|nDe acordo com Kebrapaw, a "história de ancião diz que Tortheldrin — um elfo "medonho" que se diz príncipe — roubou as manoplas de um dos reis Gordok.‡Добудьте латную рукавицу Мощи Гордока и вернитесь с ней к капитану Давигрому в Забытом Городе.|n|nПо словам Давигрома, в "старых байках" говорится, что Тортелдрин – "страшный эльф", называющий себя принцем, – похитил эту рукавицу у одного из королей Гордоков.‡Findet die Stulpen der Gordokmacht und bringt sie zu Hauptmann Krombruch in Düsterbruch.|n|nKrombruch zufolge sagen die "Alte Zeit Geschichten", dass Tortheldrin - ein "gruseliger" Elf, der sich selbst als Prinz bezeichnet- sie einem der Gordokkönige gestohlen hat.‡권력의 고르독 건틀릿을 찾아 혈투의 전장에 있는 대장 크롬크러쉬에게 가져가야 합니다.|n|n크롬크러쉬의 "옛날 얘기"에 따르면 자칭 왕자라는 토르텔드린이라는 이름의 "기분 나쁜" 엘프가 고르독 왕에게서 빼앗아갔다고 합니다.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre. |n|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Encuentra el guante del Poderío de Gordok y llévaselo al capitán Kromcrush a La Masacre. |n|nSegún Kromcrush, una "historia muy, muy vieja" dice que Tortheldrin, un elfo "asqueroso" que se llamaba a sí mismo príncipe, robó el guantelete a uno de los reyes de Gordok.‡Trouvez le Gantelet de puissance gordok et rendez-le au Capitaine Kromcrush à Hache-tripes.|n|nSelon Kromcrush, les histoires des « vieux » racontent que Tortheldrin - un « vilain » elfe qui se fait appeler prince - l\'a volé à l\'un des rois gordok.‡找到戈多克力量护手，并将它交给厄运之槌的克罗卡斯。|n|n根据克罗卡斯所说的，"传说"自称是王子的精灵托塞德林从一名戈多克食人魔手中偷走了那件神器。‡找到戈多克力量護手，並將它交給厄運之槌的克羅卡斯。|n|n根據克羅卡斯所說的，「傳說」自稱是王子的精靈托塞德林從一名戈多克巨魔手中偷走了那件神器。',
  }
},
[1319] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Caz Doismancal em Theramore.‡Покажите потемневший железный Щит Казу Дваждыдвацу из Терамора.‡Zeigt den geschwärzten Eisenschild Caz Doppelspross in Theramore.‡테라모어에 있는 카즈 투스프로켓에게 검은 철제 방패를 보여줘야 합니다.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Ve a Theramore y enseña el escudo de hierro ennegrecido a Caz Dosdientes.‡Montrer le Bouclier en fer noirci à Caz Bi-douille à Theramore.‡把被熏黑的铁盾牌拿给塞拉摩的卡兹·双链看一看。‡把被燻黑的鐵盾牌拿給塞拉摩的卡茲·雙鏈看一看。',
  }
},
[1320] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com o Capitão Garrido Valente em Theramore.‡Поговорите с капитаном Гарраном Ваймсом в Тераморе.‡Sprecht mit Hauptmann Garran Mumm in Theramore.‡테라모어에 있는 사령관 개런 바임스와 대화해야 합니다.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Ve a Theramore y habla con el capitán Garran Vimes.‡Discuter avec le capitaine Garran Vimaire à Theramore.‡与塞拉摩的盖兰·维米斯队长谈一谈。‡與塞拉摩的蓋蘭·維米斯隊長談話。',
  }
},
[1321] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Mostre o Escudo de Ferro Enegrecido para Do\'gol na Aldeia Muralha Verde.‡Покажите потемневший железный щит До\'голу из Деревни Гиблотопь.‡Zeigt den geschwärzten Eisenschild Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골에게 검은 철제 방패를 보여줘야 합니다.‡Muestra el escudo de hierro ennegrecido a Do\'gol del Poblado Murohelecho.‡Muestra el escudo de hierro ennegrecido a Do\'gol en el Poblado Murohelecho.‡Montrer le Bouclier en fer noirci à Do\'gol au village de Mur-de-Fougères.‡把被熏黑的铁盾牌拿给蕨墙村的杜高尔看一看。‡把被燻黑的鐵盾牌拿給蕨牆村的杜高爾看一看。',
  }
},
[1322] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Obtenha 5 Vesículas de Peçonha Ácida para Do\'gol na Aldeia Muralha Verde.‡Добудьте 5 ядовитых желез Паука Черного Тумана для До\'гола из Деревни Гиблотопь.‡Bringt 5 säurehaltige Giftbeutel zu Do\'gol in Brackenwall.‡담쟁이 마을에 있는 도골을 위해 산성 독주머니 5개를 구해야 합니다.‡Consigue 5 glándulas de veneno ácido para Do\'gol del Poblado Murohelecho.‡Consigue 5 glándulas de veneno ácido para Do\'gol del Poblado Murohelecho.‡Trouver 5 Sacs de Venin acide pour Do\'gol de Mur-de-Fougères.‡为蕨墙村的杜高尔收集5个酸性毒囊。‡為蕨牆村的杜高爾收集5個酸性毒囊。',
  }
},
[1323] = {
  {
    'O escudo negro‡Черный щит‡Der Schwarze Schild‡검은 방패‡El escudo negro‡El escudo negro‡Le Bouclier noir‡黑色盾牌‡黑色盾牌',
    nil,
    'Fale com Krog na Aldeia Muralha Verde.‡Поговорите с Крогом в Деревне Гиблотопь.‡Sprecht mit Krog in Brackenwall.‡담쟁이 마을에 있는 크로그와 대화해야 합니다.‡Ve al Poblado Murohelecho y habla con Krog.‡Ve al Poblado Murohelecho y habla con Krog.‡Parler à Krog au village de Mur-de-Fougères.‡和蕨墙村的克罗格谈一谈。‡和蕨牆村的克羅格談話。',
  }
},
[1324] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrota o Recruta Remos in Pântano Vadeoso.‡Победите рядового Хендела в Пылевых топях.‡Besiegt den Gefreiten Hendel in den Düstermarschen.‡먼지진흙 습지대에 있는 병사 헨델과 싸워서 이겨야 합니다.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Derrota al soldado Hendel en el Marjal Revolcafango.‡Battre le soldat Hendel dans le marécage d\'Âprefange.‡击败尘泥沼泽的亨德尔下士。‡擊敗塵泥沼澤的士兵亨德爾。',
  }
},
[1338] = {
  {
    'Ordens dos Lançatroz‡Заказ Грозовой Вершины‡Sturmlanzes Bestellung‡스톰파이크의 주문서‡Un pedido de Pico Tormenta‡Un pedido de Pico Tormenta‡La mission de Foudrepique‡卡尔·雷矛的订单‡雷矛的訂單',
    nil,
    'Entregue o Pedido de Lançatroz para Furen Barbalonga em Ventobravo.‡Отнесите заказ Грозовой Вершины Фьюрену Длиннобороду в Штормград.‡Bringt Sturmlanzes Anforderung zu Furen Langbart in Sturmwind.‡스톰윈드에 있는 푸렌 롱비어드에게 스톰파이크의 주문서를 가져가야 합니다.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Lleva el pedido de Pico Tormenta a Furen Barbalarga a Ventormenta.‡Portez la commande de Foudrepique à Furen Barbe-longue à Hurlevent.‡把卡尔·雷矛的订单交给暴风城的弗伦·长须。‡把雷矛的訂單交給暴風城的弗倫·長鬚。',
  }
},
[1339] = {
  {
    'Uma tarefa do Montanhista Lançatroz‡Задание Грозовой Вершины‡Gebirgsjäger Sturmlanzes Aufgabe‡산악경비대 스톰파이크의 임무‡La tarea del montaraz Pico Tormenta‡La tarea del montaraz Pico Tormenta‡La mission du Montagnard Foudrepique‡巡山人卡尔·雷矛的任务‡巡山人雷矛的任務',
    nil,
    'Fale com o Montanhista Lançatroz.‡Поговорите с горным пехотинцем Грозовой Вершиной.‡Sprecht mit Gebirgsjäger Sturmlanze.‡산악경비대 스톰파이크와 대화해야 합니다.‡Habla con el montaraz Pico Tormenta.‡Habla con el montaraz Pico Tormenta.‡Parler au Montagnard Foudrepique.‡和巡山人卡尔·雷矛谈一谈。‡和巡山人雷矛談話。',
  }
},
[1358] = {
  {
    'Uma amostra para Hermógenes‡Образец для Хелбрима‡Probe für Helbrim‡헬브림에게 가져갈 견본‡Muestra para Helbrim‡Muestra para Helbrim‡Un échantillon pour Helbrim‡给赫布瑞姆的样本‡給赫布瑞姆的樣本',
    nil,
    'Leve a Amostra de Coração de Lobo para Boticário Hermógenes nos Sertões.‡Принесите образец сердца волка аптекарю Хелбриму в Степи.‡Bringt die Wolfherzprobe zu Apotheker Helbrim ins Brachland.‡불모의 땅에 있는 연금술사 헬브림에게 늑대 심장 견본을 가져가야 합니다.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Lleva la muestra de corazón de lobo al boticario Helbrim en Los Baldíos.‡Apportez l\'échantillon de cœur de loup à l\'Apothicaire Helbrim dans les Tarides.‡把一箱蜘蛛毒带给贫瘠之地的药剂师赫布瑞姆。‡把狼心樣本交給貧瘠之地的藥劑師赫布瑞姆。',
  }
},
[1359] = {
  {
    'Entrega para Zilda‡Посылка для Зинг‡Zinges Lieferung‡진게의 소포‡Una entrega de Zinge‡Una entrega de Zinge‡Une livraison pour Zinge‡给金格的货物‡給金格的貨物',
    nil,
    'Leve a Amostras de Coração de Lobo para Boticária Zilda na Cidade Baixa.‡Отнесите образцы сердца волка аптекарю Зинг в Подгород.‡Bringt die Wolfherzproben zu Apothekerin Zinge nach Unterstadt.‡언더시티에 있는 연금술사 진게에게 늑대 심장 견본을 가져가야 합니다.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Lleva las muestras de corazón de lobo a la boticaria Zinge en Entrañas.‡Apportez les Échantillons de cœurs de loups à l\'Apothicaire Zinge à Fossoyeuse.‡将狼心样本交给幽暗城的药剂师金格。‡將狼心樣品交給幽暗城的藥劑師金格。',
  }
},
[1360] = {
  {
    'Tesouros recuperados‡Возвращенные сокровища‡Wiederbeschaffte Schätze‡보물 찾기‡Los tesoros reclamados‡Los tesoros reclamados‡Des Trésors à recouvrer‡失而复得‡尋回寶物',
    nil,
    'Pegue a posse querida de Krom Braçoforte em seu baú no Saguão Norte de Uldaman e leve-a para ele na Altaforja.‡Достаньте сокровище Крома Крепкорука из сундука в северном зале Ульдамана и принесите ему в Стальгорн.‡Holt Krom Starkarms wertvollen Besitz aus seiner Truhe in der nördlichen Bankenhalle von Uldaman und bringt den Schatz zu ihm nach Eisenschmiede.‡울다만의 북쪽 대전당에 있는 궤짝에서 크롬 스타우트암의 보물을 찾아서 아이언포지에 있는 크롬 스타우트암에게 가져다주어야 합니다.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Recoge la posesión más preciada de Krom Brazorrecio de su cofre, que está en la Sala Comunal Norte de Uldaman, y llévasela a Forjaz.‡Récupérer les biens de Krom Rudebras dans son coffre dans le hall commun nord d\'Uldaman et les lui rapporter à Forgefer.‡到奥达曼的北部大厅去找到克罗姆·粗臂的箱子，从里面拿出他的宝贵财产，然后回到铁炉堡把东西交给他。‡到奧達曼的北部大廳去找到克羅姆·粗臂的箱子，從裡面拿出他的寶貴財產，然後回到鐵爐堡把東西交給他。',
  }
},
[1361] = {
  {
    'Regthar Portões-da-morte‡Регтар Врата Смерти‡Regthar Totenfurt‡렉타르 데스게이트‡Regthar Portamorta‡Regthar Portamorta‡Regthar Seuil-de-mort‡雷戈萨·死门‡雷戈薩·死門',
    nil,
    'Fale com Regthar Portões-da-morte nos Sertões.‡Поговорите с Регтаром Врата Смерти в Степях.‡Sprecht mit Regthar Totenfurt im Brachland.‡불모의 땅에 있는 렉타르 데스게이트와 대화해야 합니다.‡Habla con Regthar Portamorta en Los Baldíos.‡Habla con Regthar Portamorta en Los Baldíos.‡Discuter avec Regthar Seuil-de-mort dans les Tarides.‡和贫瘠之地的雷戈萨·死门谈一谈。‡到貧瘠之地和雷戈薩·死門談話。',
  }
},
[1362] = {
  {
    'Os Kolkar de Desolação‡Кентавры Пустошей‡Die Kolkar von Desolace‡잊혀진 땅의 콜카르‡Los Kolkar de Desolace‡Los Kolkar de Desolace‡Les Kolkar de Désolace‡凄凉之地的科卡尔部族‡淒涼之地的科卡爾部族',
    nil,
    'Fale com o Felgur Doiscortes no Entreposto do Espírito que Anda, em Desolação.‡Найдите на Заставе Скитающихся Духов в Пустошах Фелгура Бью-Двоих и поговорите с ним.‡Sprecht mit Felgur Zweischneid beim Geistwandlerposten in Desolace.‡잊혀진 땅의 침묵의 초소에 있는 펠굴 투커츠와 대화해야 합니다.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Habla con Felgur Doscortes. Está en el Campamento del Espíritu Errante, en Desolace.‡Discuter avec Felgur Doublecoupe au poste de Rôdeur-fantôme en Désolace.‡和凄凉之地幽灵岗哨的费古尔·双刃谈一谈。‡和淒涼之地鬼旅崗哨的費古爾·雙刃談話。',
  }
},
[1363] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Fale com o Acólito Dellis em Ventobravo.‡Поговорите с послушником Деллисом в Штормграде.‡Sprecht mit Akolyth Dellis in Sturmwind.‡스톰윈드에 있는 수행사제 델리스와 대화해야 합니다.‡Habla con el acólito Dellis en Ventormenta.‡Habla con el acólito Dellis en Ventormenta.‡Parler à l\'acolyte Dellis à Hurlevent.‡与暴风城里的助手迪利斯谈一谈。‡與暴風城裡的侍僧迪利斯談話。',
  }
},
[1364] = {
  {
    'A mando de Mazen‡Задание Мазена‡Mazens Befehl‡마젠의 부탁‡La orden de Mazen‡La orden de Mazen‡Les ordres de Mazen‡马森的请求‡馬森的請求',
    nil,
    'Recupere os Ensaios de Hadggar sobre Convergência Dimensional e entregue-os para Vigia Mahar Ba, na Bastilha de Etergarde.‡Верните "Рассуждения Кадгара о пространственной сходимости" и доставьте сочинение дозорному Махару Ба в Крепость Стражей Пустоты.‡Rettet Khadgars \'Abhandlungen über dimensionale Konvergenz\' und bringt sie zu Behüter Mahar Ba in der Burg Nethergarde.‡차원의 집합점에 대한 카드가의 평론을 찾아 네더가드 요새에 있는 감시자 마할 바에게 전해야 합니다.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Recupera los ensayos de Khadgar sobre convergencia dimensional y entrégaselos al vigilante Mahar Ba en el Castillo de Nethergarde.‡Retrouver les Essais de Khadgar sur la convergence dimensionnelle et les porter au Gardien Mahar Ba au Rempart-du-Néant.‡夺回《卡德加的空间收敛研究笔记》，将它送给守望堡的看守者马哈尔巴。‡奪回《卡德加的空間收斂研究筆記》，將它送給守望堡的看守者馬哈爾巴。',
  }
},
[1365] = {
  {
    'Khan Dez\'hepah‡Вождь Дез\'хеп‡Khan Dez\'hepah‡칸 데즈헤파‡Khan Dez\'hepah‡Khan Dez\'hepah‡Khan Dez\'hepah‡戴兹帕可汗‡戴茲帕可汗',
    nil,
    'Leve a Cabeça de Khan Dez\'hepah para Felgur Doiscortes na Desolação.‡Принесите Фелгуру Бью-Двоих голову вождя Дез\'хепа.‡Bringt Khan Dez\'hepahs Kopf zu Felgur Zweischneid in Desolace.‡칸 데즈헤파를 처치하고 그 증거로 그의 머리카락을 잊혀진 땅에 있는 펠굴 투커츠에게 가져가야 합니다.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Lleva la cabeza del khan Dez\'hepah a Felgur Doscortes a Desolace.‡Rapporter la Tête du khan Dez\'hepah à Felgur Doublecoupe en Désolace.‡把戴兹帕可汗的徽记交给凄凉之地的费古尔·双刃。‡把戴茲帕可汗的頭顱交給淒涼之地的費古爾·雙刃。',
  }
},
[1366] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Felgur Doiscortes em Desolação.‡Принесите в Пустоши 15 ушей кентавров и отдайте Фелгуру Бью-Двоих.‡Bringt 15 Zentaurenohren zu Felgur Zweischneid in Desolace.‡잊혀진 땅의 펠굴 투커츠에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Lleva 15 orejas de centauro a Felgur Doscortes a Desolace.‡Apporter 15 Oreilles de centaure à Felgur Doublecoupe, en Désolace.‡收集15只半人马的耳朵，把它们交给凄凉之地的费古尔·双刃。‡收集15個半人馬的耳朵，把它們交給淒涼之地的費古爾·雙刃。',
  }
},
[1367] = {
  {
    'Aliança com os Magram‡Союз с племенем Маграм‡Allianz mit den Magram‡마그람 동맹‡La alianza con los Magram‡La alianza con los Magram‡L\'alliance avec les Magram‡玛格拉姆部族‡瑪格拉姆族的聯盟',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux envers vous, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆族建立良好的關係，然後和瓦魯格談話。',
  }
},
[1368] = {
  {
    'Aliança com os Gelkis‡Союз с племенем Гелкис‡Allianz mit den Gelkis‡겔키스 동맹‡La alianza con los Gelkis‡La alianza con los Gelkis‡L\'alliance avec les Gelkis‡吉尔吉斯部族‡吉爾吉斯族的聯盟',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut Euch einen Ruf als freundliche Person bei den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Faire en sorte que les Gelkis deviennent Amicaux envers vous, puis aller parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯族建立良好的關係，然後和『智者』烏泰克談話。',
  }
},
[1369] = {
  {
    'Lágrimas partidas‡Россыпи Слез‡Zerbrochene Tränen‡눈물의 파편‡Lágrimas rotas‡Lágrimas rotas‡Larmes brisées‡破碎之泪‡破碎之淚',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Lágrimas Partidas para Warug na Aldeia Magram.‡Для поддержания отношений с племенем Маграм принесите 3 кристалла Россыпи Слез Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt 3 zerbrochene Tränen zu Warug im Dorf Magram.‡마그람에게 우호적인 평판을 유지하면서 마그람 마을에 있는 와루그에게 눈물의 파편 3개를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Mantén tu reputación con los Magram y lleva 3 lágrimas rotas a Warug al Poblado Magram.‡Maintenir votre réputation auprès des Magram et ramener 3 Larmes brisées à Warug au village des Magram.‡继续和玛格拉姆部族保持良好的关系，把3块破碎之泪交给玛格拉姆村庄的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關係，把3塊破碎之淚交給瑪格拉姆村莊的瓦魯格。',
  }
},
[1370] = {
  {
    'Assalto à dispensa‡Похищение припасов‡Diebstahl von Vorräten‡보급품 훔치기‡¡A robar provisiones!‡¡A robar provisiones!‡Voleur de viande‡偷取物资‡偷取物資',
    nil,
    'Entregue 6 sacos de Carne Mal Desidratada para Uthek, a Sábia, na Aldeia Gelkis.‡Принесите 6 мешков недосушенного мяса в деревню Гелкис и отдайте Уте Мудрой.‡Bringt 6 Taschen primitiv getrocknetes Fleisch zu Uthek der Weisen im Dorf Gelkis.‡겔키스 마을에 있는 현자 우텍에게 말린 고기 6개를 가져가야 합니다.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Lleva 6 bolsas de carne secada de forma rudimentaria a Uthek la Sabia al Poblado Gelkis.‡Rapporter 6 Sacs de viande grossièrement séchée à Uthek la Sage au village des Gelkis.‡把6包粗制干肉交给吉尔吉斯村的智者乌泰克。‡把6包粗製肉乾交給吉爾吉斯村的『智者』烏泰克。',
  }
},
[1371] = {
  {
    'Engenhoca para Warug‡Игрушка для Варуга‡Gizmo für Warug‡와루그의 물건‡Un cacharro para Warug‡Un cacharro para Warug‡Un bidule pour Warug‡瓦鲁格的玩具‡瓦魯格的玩具',
    nil,
    'Mantenha sua reputação alta junto aos Magram e entregue 3 Bonecos-alvo Avançado para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите усовершенствованный манекен-мишень Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt eine hochentwickelte Zielattrappe zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 고급 표적 허수아비를 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva 1 muñeco-diana avanzado a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram et rapporter un Leurre perfectionné à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，给玛格拉姆村的瓦鲁格找到一个高级假人。‡繼續和瑪格拉姆部族保持良好的關係，給瑪格拉姆村的瓦魯格找到一個高級假人。',
  }
},
[1372] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Fale com Boticário Faustino no Refúgio dos Mendigos.‡Поговорите с аптекарем Фаустином в Приюте Бродяги.‡Sprecht mit Apotheker Faustin im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 연금술사 파우스틴과 대화해야 합니다.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Ve al Refugio de los Mendigos y habla con el boticario Faustin.‡Parler à l\'Apothicaire Faustin, au Repaire des mendiants.‡到乞丐鬼屋去和药剂师法奥斯丁谈一谈。‡到乞丐鬼屋去和藥劑師法奧斯丁談話。',
  }
},
[1373] = {
  {
    'Ongekan‡Онгеку‡Ongeku‡온게쿠‡Ongeku‡Ongeku‡Ongeku‡盎格库尔‡盎格庫',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue um Estilhaço de Draenetista para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите осколок дренетиста Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt einen Draenethystsplitter zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 드레니시스트 파편 하나를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 1 fragmento de draenetista a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis et rapporter un Éclat de draenéthyste à Uthek la Sage au village des Gelkis, en Désolace.‡继续和吉尔吉斯部族保持良好的关系，并把德莱尼水晶碎片交给凄凉之地吉尔吉斯村的智者乌泰克。‡維持你在吉爾吉斯族中的名聲，並把德萊尼水晶裂片交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1374] = {
  {
    'Khan Jehn‡Вождь Джен‡Khan Jehn‡칸 젠‡Khan Jehn‡Khan Jehn‡Khan Jehn‡杰恩可汗‡傑恩可汗',
    nil,
    'Entregue a Cabeça de Khan Jehn para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Принесите голову вождя Джена Уте Мудрой в деревню Гелкис.‡Bringt Khan Jehns Kopf zu Uthek der Weisen im Dorf Gelkis in Desolace.‡칸 젠을 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 가져가야 합니다.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Lleva la cabeza del khan Jehn a Uthek la Sabia al Poblado Gelkis de Desolace.‡Apportez la Tête du khan Jehn à Uthek la Sage au village des Gelkis, en Désolace.‡把杰恩可汗的徽记交给凄凉之地吉尔吉斯村的智者乌泰克。‡把傑恩可汗的頭顱交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1375] = {
  {
    'Khan Shaka‡Вождь Шак‡Khan Shaka‡칸 샤카‡Khan Shaka‡Khan Shaka‡Khan Shaka‡沙卡可汗‡沙卡可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue a Cabeça de Khan Shaka para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите голову вождя Шака Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt den Kopf von Khan Shaka zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 칸 샤카를 처치하고 그 증거로 그의 머리띠를 잊혀진 땅의 마그람 마을에 있는 와루그에게 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva la cabeza de Khan Shaka a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva la cabeza de Khan Shaka a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation parmi les Magram et rapporter la Tête du khan Shaka à Warug au village des Magram en Désolace.‡继续和玛格拉姆部族保持良好的关系，把沙卡可汗的徽记交给凄凉之地玛格拉姆村的瓦鲁格。‡繼續和瑪格拉姆部族保持良好的關係，把沙卡可汗的頭顱交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1380] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫蘭薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue o Fragmento de Chave dos Maraudinos para Uthek, a Sábia, na Aldeia Gelkis.‡Для поддержания отношений с племенем Гелкис принесите фрагмент Ключа Мародина Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt das Schlüsselfragment der Maraudine zu Uthek der Weisen im Dorf Gelkis.‡겔키스에게 우호적인 평판을 유지하면서 겔키스 마을에 있는 현자 우텍에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva el trozo de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Mantén tu reputación con los Gelkis y lleva el trozo de llave Maraudine a Uthek la Sabia al Poblado Gelkis.‡Maintenir votre réputation auprès des Gelkis, et apporter le Fragment de clé des Maraudine à Uthek la Sage au village des Gelkis.‡继续和吉尔吉斯部族保持良好的关系，把玛洛迪钥匙碎片交给吉尔吉斯村的智者乌泰克。‡繼續和吉爾吉斯部族保持良好的關係，把瑪洛迪鑰匙碎片交給吉爾吉斯村的『智者』烏泰克。',
  }
},
[1381] = {
  {
    'Khan Hratha‡Вождь Храта‡Khan Hratha‡칸 흐라사‡Khan Hratha‡Khan Hratha‡Khan Hratha‡赫鲁萨可汗‡赫蘭薩可汗',
    nil,
    'Mantenha alta sua reputação junto aos Magram e entregue o Fragmento de Chave dos Maraudinos para Warug na Aldeia Magram, em Desolação.‡Для поддержания отношений с племенем Маграм принесите фрагмент Ключа Мародина Варугу в деревню Маграм.‡Wahrt Euren Ruf bei den Magram und bringt das Schlüsselfragment der Maraudine zu Warug im Dorf Magram in Desolace.‡마그람에게 우호적인 평판을 유지하면서 잊혀진 땅의 마그람 마을에 있는 와루그에게 마라우돈 열쇠 파편을 가져가야 합니다.‡Mantén tu reputación con los Magram y lleva el trozo de llave Maraudine a Warug al Poblado Magram de Desolace.‡Mantén tu reputación con los Magram y lleva el trozo de llave Maraudine a Warug al Poblado Magram de Desolace.‡Maintenir votre réputation auprès des Magram, et apporter le Fragment de clé des Maraudine à Warug au village des Magram en Désolace.‡和玛格拉姆保持良好的关系，把玛洛迪钥匙碎片交给凄凉之地玛格拉姆村的瓦鲁格。‡維持你在瑪格拉姆族的名聲，並把瑪洛迪鑰匙碎片交給淒涼之地瑪格拉姆村的瓦魯格。',
  }
},
[1382] = {
  {
    'Aliança inusitada‡Странный союз‡Seltsame Allianz‡이상한 동맹‡Extraña alianza‡Extraña alianza‡Une étrange alliance‡奇怪的联盟‡奇怪的聯盟',
    nil,
    'Ganhe a reputação de Respeitado pelos Gelkis e depois fale com Uthek, a Sábia.‡Заслужите дружественное отношение племени Гелкис, а затем поговорите с Утой Мудрой.‡Baut eine freundliche Beziehung zu den Gelkis auf und sprecht dann mit Uthek der Weisen.‡겔키스에게 우호적인 평판을 얻은 다음 현자 우텍과 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Gana un nivel de reputación de amistoso con los Gelkis y luego habla con Uthek la Sabia.‡Obtenir que les Gelkis se montrent Amicaux, puis parler à Uthek la Sage.‡和吉尔吉斯部族建立良好的关系，然后和智者乌泰克谈一谈。‡和吉爾吉斯部族建立良好的關係，然後和『智者』烏泰克談話。',
  }
},
[1383] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'O Boticário Faustino, no Refúgio dos Mendigos, precisa de 5 Corações de Pantera das Sombras, de Fungo do Senhor do Brejo e de Sangue de Dragonete Verde.‡Принесите аптекарю Фаустину в Приют Бродяги 5 сердец пантер тени, мох хозяина болота и немного крови зеленого дракончика.‡Apotheker Faustin im Bettlerschlupfwinkel braucht 5 Schattenpantherherzen, Morastlordfungus und etwas Blut eines grünen Welpen.‡부랑자 소굴에 있는 연금술사 파우스틴에게 그림자표범 심장 5개, 우두머리 늪괴물 곰팡이, 그리고 새끼 녹색용 피를 조금 가져가야 합니다.‡El boticario Faustin del Refugio de los Mendigos necesita 5 corazones de pantera sombría, hongos de Señor del Lodo y sangre de cría verde.‡El boticario Faustin del Refugio de los Mendigos necesita 5 corazones de pantera sombría, hongos de Señor del Lodo y sangre de cría verde.‡L\'apothicaire Faustin, du repaire des mendiants, a besoin de 5 Cœurs de panthère des ombres, d\'un Champignon de Boueux et de Sang de dragonnet vert.‡乞丐鬼屋的药剂师法奥斯丁需要5颗暗影黑豹的心脏、1颗泥沼之王的蘑菇和一些绿色雏龙之血。‡乞丐鬼屋的藥劑師法奧斯丁需要5顆暗影黑豹的心臟，一顆泥沼之王的蘑菇和一些綠色幼龍之血。',
  }
},
[1384] = {
  {
    'Onde os fracos não têm vez‡Набег на племя Колкар‡Überfall auf die Kolkar‡콜카르 습격‡Asalta a los Kolkar‡Asalta a los Kolkar‡Raid sur les Kolkar‡突袭科卡尔‡突襲科卡爾',
    nil,
    'Mantenha alta sua reputação junto aos Gelkis e entregue 10 Patuás Grosseiros para Uthek, a Sábia, na Aldeia Gelkis, em Desolação.‡Для поддержания отношений с племенем Гелкис принесите 10 грубых оберегов Уте Мудрой в деревню Гелкис.‡Wahrt Euren Ruf bei den Gelkis und bringt 10 kunstlose Glücksbringer zu Uthek der Weisen im Dorf Gelkis in Desolace.‡겔키스에게 우호적인 평판을 유지하면서 잊혀진 땅의 겔키스 마을에 있는 현자 우텍에게 조잡한 부적 10개를 가져가야 합니다.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Mantén tu reputación con los Gelkis y lleva 10 talismanes rudimentarios a Uthek la Sabia al Poblado Gelkis de Desolace.‡Maintenir votre réputation auprès des Gelkis, et apporter 10 Charmes bruts à Uthek la Sage dans le village des Gelkis, en Désolace.‡和吉尔吉斯部族保持良好的关系，把10个粗制咒符交给凄凉之地吉尔吉斯村的智者乌泰克。‡和吉爾吉斯部族保持良好的關係，把10個粗製符咒交給淒涼之地吉爾吉斯村的『智者』烏泰克。',
  }
},
[1385] = {
  {
    'Política feroz‡Политика силы‡Brutale Politik‡야비한 정책‡Políticas brutales‡Políticas brutales‡Une violente politique‡野蛮外交‡野蠻外交',
    nil,
    'Ganhe reputação de Respeitado pelos Magram e depois fale com Warug.‡Заслужите дружественное отношение племени Маграм, а затем поговорите с Варугом.‡Baut Euch einen freundlichen Ruf bei den Magram auf und sprecht dann mit Warug.‡마그람에게 우호적인 평판을 얻은 다음 와루그와 대화해야 합니다.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Gana un nivel de reputación de amistoso con los Magram y luego habla con Warug.‡Faire en sorte que les Magram soient Amicaux à votre égard, puis aller parler à Warug.‡和玛格拉姆部族建立良好的关系，然后和瓦鲁格谈一谈。‡和瑪格拉姆部族建立良好的關係，然後和瓦魯格談話。',
  }
},
[1386] = {
  {
    'Ataque aos Kolkar!‡Нападение на племя Колкар‡Angriff auf die Kolkar‡콜카르 공격‡Ataca a los Kolkar‡Ataca a los Kolkar‡Assaut sur les Kolkar‡突袭科卡尔部族‡突襲科卡爾部族',
    nil,
    'Mantenha alta sua reputação junto aos Magram. Mate 12 Centauros Kolkar, 12 Batedores Kolkar e 6 Espancadores Kolkar. Em seguida, fale novamente com Warug, na Vila Magram, em Desolação.‡Для поддержания отношений с племенем Маграм вы должны убить 12 кентавров из племени Колкар, 12 разведчиков из племени Колкар и 6 извергов из племени Колкар, а затем вернуться к Варугу в деревню Маграм.‡Haltet Euren Ruf bei den Magram aufrecht. Tötet 12 Zentauren der Kolkar, 12 Späher der Kolkar sowie 6 Raufer der Kolkar und kehrt dann zu Warug ins Magramdorf in Desolace zurück.‡마그람에게 우호적인 평판을 유지하면서 콜카르 켄타우로스 12명, 콜카르일족 척후병 12명, 콜카르일족 투사 6명을 처치한 다음 잊혀진 땅의 마그람 마을에 있는 와루그에게 돌아가야 합니다.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 exploradores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Mantén tu reputación con los Magram. Mata a 12 centauros Kolkar, 12 exploradores Kolkar y 6 destructores Kolkar y luego busca a Warug en el Poblado Magram en Desolace.‡Maintenir votre réputation auprès des Magram, tuer 12 Centaures kolkar, 12 Eclaireurs kolkar, 6 Marteleurs kolkar, puis retourner voir Warug, dans le village des Magram, en Désolace.‡继续保持和玛格拉姆部族的良好关系，杀掉12个科卡尔半人马，12个科卡尔斥候和6个科卡尔虐待者，然后回到凄凉之地向玛格拉姆部族的瓦鲁格报告。‡繼續保持和瑪格拉姆部族的良好關係，殺掉12個科卡爾半人馬，12個科卡爾斥候和6個科卡爾虐待者，然後回到淒涼之地向瑪格拉姆部族的瓦魯格報告。',
  }
},
[1387] = {
  {
    'Suvenir de centauro‡Награда за кентавров‡Zentaurenkopfgeld‡켄타우로스 현상금‡Colección de orejas‡Colección de orejas‡La prime aux centaures‡悬赏半人马‡懸賞半人馬',
    nil,
    'Entregue 15 Orelhas de Centauro para Cabo Melquias no Posto do Nijel em Desolação.‡Принесите в город Высота Найджела 15 ушей кентавров и отдайте их капралу Мелкису.‡Bringt 15 Zentaurenohren zu Korporal Melkins bei der Nijelspitze in Desolace.‡잊혀진 땅의 나이젤의 야영지에 있는 하사관 멜킨스에게 켄타우로스의 귀걸이 15개를 가져가야 합니다.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Lleva 15 orejas de centauro al cabo Melkins que está en Punta de Nijel, en Desolace.‡Apporter 15 Oreilles de centaures au caporal Melkins, à la combe de Nijel, en Désolace.‡收集15个半人马耳朵，把它们交给尼耶尔前哨站的麦尔金斯下士。‡收集15個半人馬耳朵給尼耶爾前哨站的麥爾金斯下士。',
  }
},
[1388] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Entregue o Soro da Verdade do Faustino para Sicário Zaqueu no Refúgio dos Mendigos.‡Отдайте сыворотку правды Фаустина стражу смерти Зредусу в Приюте Бродяги.‡Gebt Faustins Wahrheitsserum dem Todespirscher Zraedus im Bettlerschlupfwinkel.‡부랑자 소굴에 있는 죽음의추적자 즈레더스에게 파우스틴의 진실의 물약을 가져가야 합니다.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Dale el suero de la verdad de Faustin al mortacechador Zraedus en el Refugio de los Mendigos.‡Remettre le Sérum de vérité de Faustin au Nécrotraqueur Zraedus au Repaire des mendiants.‡把法奥斯丁的真言药水交给乞丐鬼屋的亡灵哨兵莱度斯。‡把法奧斯丁的真言藥水交給乞丐鬼屋的亡靈哨兵萊度斯。',
  }
},
[1389] = {
  {
    'Cristais de draenetista‡Кристаллы дренетиста‡Draenethystkristalle‡드레니시스트 수정‡Cristales draenetistas‡Cristales draenetistas‡Les cristaux de draenéthyste‡德莱尼水晶‡德萊尼水晶',
    nil,
    'Leve 6 Cristais de Draenetista para Magtoor no Pântano das Mágoas.‡Принесите 6 кристаллов дренетиста Магтуру в Убежище в Болоте Печали.‡Bringt 6 Draenethystkristalle zu Magtoor im sicheren Hafen in den Sümpfen des Elends.‡슬픔의 늪의 피난처에 있는 막투르에게 드레니시스트 수정 6개를 가져가야 합니다.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Llévale 6 cristales draenetistas a Magtoor que está en El Puerto del Pantano de las Penas.‡Apporter 6 Cristaux de draenéthyste à Magtoor au Havre boueux du marais des Chagrins.‡给悲伤沼泽避难营地里的玛格图尔带去6块德莱尼水晶。‡給悲傷沼澤避難營地裡的瑪格圖爾帶去6塊德萊尼水晶。',
  }
},
[1390] = {
  {
    '‡<nyi> Упал на нож и так семь раз.‡<nyi> Upps, wir haben sie schon wieder ins Jenseits geschickt.‡‡<nyi> Ups, les hemos matado de otra vez‡<nyi> Ups, les hemos matado de otra vez‡<nyi> Oups, on les a encore tués !‡‡',
    nil,
    nil,
  }
},
[1391] = {
  {
    'A mais pura verdade‡Правда и только правда‡Nichts als die Wahrheit‡진실의 물약‡El suero de la verdad‡El suero de la verdad‡La vérité, rien que la vérité‡真言药水‡真言藥水',
    nil,
    'Leve a Cerveja de Zaerdus para Infiltrador Marksen no Pedregal.‡Отнесите бражку Зредуса секретному агенту Марксену в Каменор.‡Bringt Zraedus\' Bräu zu Spitzel Marksen in Steinard.‡스토나드에 있는 첩보원 마크슨에게 즈레더스의 맥주를 가져가야 합니다.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Lleva el brebaje de Zraedus al infiltrado Marksen a Rocal.‡Apporter la Bière de Zraedus à l\'Infiltrateur Marksen à Pierrêche.‡把莱度斯的酒带给斯通纳德的间谍玛克森。‡把萊度斯的酒交給斯通納德的間諜馬克森。',
  }
},
[1392] = {
  {
    'Noboru, a Borduna‡Нобору Дубина‡Noboru der Knüppler‡곤봉잡이 노보루‡Noboru el Garrote‡Noboru el Garrote‡Noboru le Gourdin‡木棒诺博鲁‡『鬥棍』諾博魯',
    nil,
    'Leve a Clava de Noboru ao líder do Refúgio no Pântano das Mágoas.‡Принесите дубину Нобору главе Убежища на Болото Печали.‡Bringt Noborus Knüppel zum Anführer des sicheren Hafens in den Sümpfen des Elends.‡슬픔의 늪에 있는 피난처의 우두머리에게 노보루의 곤봉을 가져가야 합니다.‡Llévale la cayada de Noboru al líder de El Puerto del Pantano de las Penas.‡Llévale el garrote de Noboru al líder de El Puerto del Pantano de las Penas.‡Apporter le Casse-tête de Noboru au Chef du Havre boueux dans le marais des Chagrins.‡把诺博鲁的木棒交到悲伤沼泽中的避难营领导人手中。‡把諾博魯的鬥棍交給悲傷沼澤中的避難營領導人。',
  }
},
[1393] = {
  {
    'A fuga de Galen‡Побег Галена‡Galens Flucht‡갈렌 구출‡La huida de Galen‡La huida de Galen‡L\'évasion de Galen‡加林的逃亡‡加林的逃亡',
    nil,
    'Escolte Galen até a segurança para, então, encontrar seu acampamento no Pântano das Mágoas e abrir seu cofre.‡Выведите Галена из опасного места, затем найдите его лагерь на Болоте Печали и откройте его сейф.‡Eskortiert Galen, bis er außer Gefahr ist, sucht dann sein Lager in den Sümpfen des Elends und öffnet seine Geldkassette.‡갈렌이 위험에서 벗어나도록 호위한 다음 슬픔의 늪에 있는 그의 야영지를 찾아 갈렌의 금고를 열어야 합니다.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Pon a salvo a Galen, y después encuentra su campamento en el Pantano de las Penas y abre su caja fuerte.‡Escorter Galen jusqu\'à ce qu\'il soit hors de danger, puis trouver son camp dans le marais des Chagrins et ouvrir son coffre.‡护送加林逃出困境，然后打开他放在悲伤沼泽营地里的保险箱。‡護送加林逃出困境，然後去開啟他放在傷心沼澤營地裡的保險箱。',
  }
},
[1394] = {
  {
    'Passagem final‡Финальное испытание‡Letzte Überfahrt‡최후의 시험‡La recta final‡La recta final‡Le dernier voyage‡通过试炼‡最後的旅程',
    nil,
    'Fale com Dorn Espreitaprados em Mil Agulhas.‡Поговорите с Дорном Вольным Ловчим в Тысяче Игл.‡Sprecht mit Dorn Ebenenpirscher in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커와 대화해야 합니다.‡Habla con Dorn Acechallanos en Las Mil Agujas.‡Habla con Dorn Acechallanos en Las Mil Agujas.‡Parler à Dorn Traqueur-des-plaines aux Mille pointes.‡和千针石林的多恩·平原行者谈一谈。‡和千針石林的多恩·平原巡者談話。',
  }
},
[1395] = {
  {
    'Suprimentos para Etergarde‡Поставки для Стражей Пустоты‡Vorräte für Nethergarde‡네더가드 요새 보급품‡Suministros para Nethergarde‡Suministros para Nethergarde‡Fournitures pour Rempart-du-Néant‡守望堡的物资‡守望堡的補給物資',
    nil,
    'Leve o Caixote de Pedras de Poder para Intendente Lungertz antes que expirem.‡Отнесите ящик камней силы интенданту Лунгерцу, прежде чем камни утратят силу.‡Bringt die Kiste mit den Kraftsteinen zu Rüstmeister Lungertz, bevor die Kraft verbraucht ist.‡마법석의 힘이 다하기 전에 병참장교 룬겔츠에게 마법석 상자를 가져가야 합니다.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Llévale caja de piedras de potencia al intendente Lungertz antes de que caduquen.‡Apportez la Caisse de Pierres de puissance à l\'Intendant Lungertz, avant que le pouvoir des pierres n\'expire.‡在能量石的魔法效果消失以前，将它们交给守望堡的军需官朗格尔斯。‡在能量石的效力消失以前，把它們交給守望堡的軍需官朗格茲。',
  }
},
[1396] = {
  {
    'Invasão da vida selvagem‡Атака тварей‡Lauernde Tierwelt‡야생 짐승의 공격‡Contra la fauna feroz‡Naturaleza invasora‡Des créatures sauvages rôdent‡逼近的野兽‡逼近的野獸',
    nil,
    'Mate 8 Crocoliscos Dentesserras Jovens, 10 Tece-mágoas e 10 Jaguares do Pântano, então fale novamente com Vigia Biggs no Pântano das Mágoas.‡Убейте 8 молодых острозубых кроколисков, 10 ткачей скорби и 10 болотных ягуаров и потом вернитесь к дозорному Биггсу на Болоте Печали.‡Tötet 8 junge Sägezahnkrokilisken, 10 Trauerspinner sowie 10 Sumpfjaguare und kehrt dann zu Behüter Biggs in den Sümpfen des Elends zurück.‡새끼 톱니악어 8마리, 늪그물거미 10마리, 늪지재규어 10마리를 처치한 다음 슬픔의 늪에 있는 파수병 비그스에게 돌아가야 합니다.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 girapenas y 10 jaguares del pantano, y después ve a ver al vigía Biggs al Pantano de las Penas.‡Mata a 8 crocoliscos Denteserra jóvenes, 10 hilapenas y 10 jaguares del pantano, y después ve a ver al vigía Biggs al Pantano de las Penas.‡Tuer 8 Jeunes crocilisques Dents-de-scie, 10 Tisseuses des pleurs et 10 Jaguars du marécage, puis retourner voir le Gardien Biggs, dans le marais des Chagrins.‡杀死8只小盐齿鳄鱼、10只沼泽纺丝蛛和10只沼泽虎，然后向悲伤沼泽的卫兵比格斯报告。‡殺死8隻小尖齒鱷魚、10隻沼澤紡絲蛛和10隻沼澤虎，然後向悲傷沼澤的衛兵比格斯報告。',
  }
},
[1398] = {
  {
    'Madeira Flutuante‡Плавник‡Treibholz‡유목‡Madera a la deriva‡Madera a la deriva‡Bois flotté‡晒干的流木‡曬乾的流木',
    nil,
    'Leve 8 peças de Madeira Flutuante Seca ao Sol para Vigia Biggs no Pântano das Mágoas.‡Принести 8 кусков сухого плавника дозорному Биггсу на Болоте Печали.‡Bringt 8 Stücke sonnengetrocknetes Treibholz zu Behüter Biggs in den Sümpfen des Elends.‡슬픔의 늪에 있는 파수병 비그스에게 볕에 말린 유목 8개를 가져가야 합니다.‡Llévale 8 piezas de madera a la deriva desecada al vigía Biggs en el Pantano de las Penas.‡Llévale 8 piezas de madera a la deriva desecada al vigilante Biggs en el Pantano de las Penas.‡Apporter 8 Morceaux de Bois flotté séché au soleil au Gardien Biggs dans le marais des Chagrins.‡给悲伤沼泽的卫兵比格斯带回8块晒干的流木。‡給悲傷沼澤的衛兵比格斯帶回8塊曬乾的流木。',
  }
},
[1418] = {
  {
    'Nika Cicatriz-de-sangue‡Ника Алый Шрам‡Neeka Blutnarbe‡니카 블러드스카‡Neeka Marca de Sangre‡Neeka Marca de Sangre‡Neeka Balafre-sanglante‡尼卡·血痕‡尼卡·血痕',
    nil,
    'Fale com Nika Cicatriz-de-sangue.‡Поговорите с Никой Алый Шрам.‡Sprecht mit Neeka Blutnarbe.‡니카 블러드스카와 대화해야 합니다.‡Habla con Neeka Marca de Sangre.‡Habla con Neeka Marca de Sangre.‡Parler à Neeka Balafre-sanglante.‡和尼卡·血痕谈一谈。‡和尼卡·血痕談話。',
  }
},
[1419] = {
  {
    'Coiotes ladrões‡Койоты-воры‡Kojoten-Diebe‡도둑 코요테‡Ladrones coyote‡Ladrones coyote‡Les coyotes voleurs‡捕猎山狗‡捕獵山狗',
    nil,
    'Leve 30 Mandíbulas de Coiote para Nika Cicatriz-de-sangue em Karrath.‡Принесите 30 челюстей койотов Нике Алый Шрам в Каргат.‡Bringt 30 Kojotenkieferknochen zu Neeka Blutnarbe in Kargath.‡카르가스에 있는 니카 블러드스카에게 코요테 턱뼈 30개를 가져가야 합니다.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Llévale 30 mandíbulas de coyote a Neeka Marca de Sangre, que está en Kargath.‡Apporter 30 Mâchoires de coyotes à Neeka Balafre-sanglante à Kargath.‡带30块山狗的颚骨去见卡加斯的尼卡·血痕。‡帶30塊山狗的顎骨去見卡加斯的尼卡·血痕。',
  }
},
[1420] = {
  {
    'Relatório para Helgrum‡Донесение Хелгруму‡Bericht für Helgrum‡헬그럼에게 보고‡Un informe para Helgrum‡Un informe para Helgrum‡Le rapport à Helgrum‡向赫格拉姆报到‡向赫格拉姆報到',
    nil,
    'Leve o Relatório de Nika para Helgrum, o Ligeiro em Pedregal.‡Отнесите донесение Ники Хелгруму Быстроногому в Каменор.‡Bringt Neekas Bericht zu Helgrum dem Hurtigen in Steinard.‡스토나드에 있는 날쌘돌이 헬그럼에게 니카의 보고서를 가져가야 합니다.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Llévale el informe de Neeka a Helgrum el Veloz, que está en Rocal.‡Apporter le Rapport de Neeka à Helgrum l\'Agile à Pierrêche.‡把尼卡的报告交给斯通纳德的赫格拉姆。‡把尼卡的報告帶去給斯通納德的迅捷的赫格拉姆。',
  }
},
[1421] = {
  {
    'A caravana perdida‡Пропавший караван‡Die verlorene Karawane‡사라진 짐마차‡La caravana perdida‡La caravana perdida‡Le chariot perdu‡丢失的货物‡走失的商隊',
    nil,
    'Encontre o Baú da Caravana no Retiro Alqueivado, obtenha os Reagentes do Teurgo e leve-os para Vigia Biggs.‡Найдите похищенный из каравана сундук в Болотном пристанище, добудьте реагенты магов и принесите их дозорному Биггсу.‡Sucht die Karawanentruhe in der Zuflucht der Verirrten, beschafft Euch die Reagenzien der Hexer und bringt sie zu Behüter Biggs.‡드레노어 성역에서 마법사들의 재료가 들어 있는 짐마차 상자를 찾아 파수병 비그스에게 가져가야 합니다.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigía Biggs.‡Encuentra el cofre de la caravana en Retiro Fangoso, consigue los componentes de zahorí y llévaselos al vigía Biggs.‡Trouver le Coffre de la Caravane, dans le Sanctuaire des friches, obtenir les Composants pour les sorciers, et les apporter au Gardien Biggs.‡在农田避难所中找到商队的货物，并拿到巫师的材料，把它交给卫兵比格斯。‡找到商隊被劫去巨魔村落的箱子，把原料帶回來給衛兵比格斯。',
  }
},
[1422] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Fale com Katar no Pântano das Mágoas.‡Поговорите с Катором на Болоте Печали.‡Sprecht mit Katar in den Sümpfen des Elends.‡슬픔의 늪에 있는 카타르와 대화해야 합니다.‡Habla con Katar en el Pantano de las Penas.‡Habla con Katar en el Pantano de las Penas.‡Parler à Katar, dans le marais des Chagrins.‡与悲伤沼泽的卡塔尔谈一谈。‡與悲傷沼澤的卡塔爾談話。',
  }
},
[1423] = {
  {
    'Os suprimentos perdidos‡Потерянные припасы‡Die verlorenen Vorräte‡잃어버린 보급품‡Los suministros perdidos‡Los suministros perdidos‡Les marchandises perdues‡遗失的补给品‡遺失的補給物資',
    nil,
    'Leve os Suprimentos Perdidos para Intendente Lungertz.‡Принесите потерянные припасы интенданту Лунгерцу.‡Bringt die verlorenen Vorräte zu Rüstmeister Lungertz.‡병참장교 룬겔츠에게 잃어버린 보급품을 가져가야 합니다.‡Llévale las provisiones extraviadas al intendente Lungertz.‡Llévale los suministros perdidos al intendente Lungertz.‡Apportez les Marchandises perdues à l\'Intendant Lungertz.‡把遗失的货物交给军需官朗格尔斯。‡把遺失的補給物資交給軍需官朗格茲。',
  }
},
[1424] = {
  {
    'Poço de Lágrimas‡Озеро Слез‡Tränenteich‡눈물의 연못‡Charca de Lágrimas‡Charca de Lágrimas‡Le bassin des larmes‡泪水之池‡淚水之池',
    nil,
    'Fel\'zerul in Stonard wants you to gather 5 Atal\'ai Artifacts.‡Соберите 5 артефактов Атал\'ай для Фелзерула из Каменора.‡Fel\'Zerul in Steinard möchte, dass Ihr 5 Artefakte der Atal\'ai sammelt.‡스토나드에 있는 펠제룰이 아탈라이 유물 5개를 모아 달라고 부탁했습니다.‡Fel\'zerul, en Rocal, quiere que consigas 5 artefactos Atal\'ai.‡Fel\'zerul, en Rocal, quiere que consigas 5 artefactos Atal\'ai.‡Fel’zerul à Pierrêche veut que vous rassembliez 5 Artéfacts atal\'ai.‡斯通纳德的费泽鲁尔要求你收集5件阿塔莱神器。‡斯通納德的費澤盧爾要求你收集5件阿塔萊神器。',
  }
},
[1425] = {
  {
    'Entregue a remessa‡Доставка груза‡Überbringen der Lieferung‡보급품 전달‡Envío de suministros‡Entrega el cargamento‡La remise du chargement‡运送货物‡運送貨物',
    nil,
    'Leve a Remessa para Etergarde ao Intendente Lungertz na Bastilha de Etergarde.‡Доставьте груз в Крепость Стражей Пустоты интенданту Лунгерцу.‡Bringt die Lieferung nach Nethergarde zu Rüstmeister Lungertz in der Burg Nethergarde.‡네더가드 요새에 있는 병참장교 룬겔츠에게 네더가드 뱃짐을 가져가야 합니다.‡Entrégale el envío a Nethergarde al intendente Lungertz del Castillo de Nethergarde.‡Entrégale los suministros al intendente Lungertz del Castillo de Nethergarde.‡Apportez la Cargaison pour Rempart-du-Néant à l\'Intendant Lungertz au Rempart-du-Néant.‡把货物交给守望堡的军需官朗格尔斯。‡把貨物帶給守望堡的軍需官朗格爾斯。',
  }
},
[1426] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Mate 10 Murlocs do Pântano, 10 Jogatintas do Pântano e 10 Comecarnes do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных мурлоков, 10 болотных чернильщиков и 10 болотных трупоедов, затем вернитесь к Котору в Болото Печали.‡Tötet 10 Marschenmurlocs, 10 Marschentintenspucker und 10 Marschenfleischfresser und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 10마리, 늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가야 합니다.‡Mata a 10 múrlocs de marisma, 10 vomitatintas de marisma y 10 comecarnes de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 múrlocs de marisma, 10 vomitatintas de marisma y 10 comecarnes de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Murlocs des marais, 10 Cracheurs des marais, 10 Dévoreurs des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10个沼泽鱼人、10个沼泽喷墨鱼人和10个沼泽食腐鱼人，然后向悲伤沼泽的卡塔尔回报。‡殺掉10個沼澤魚人、10個沼澤噴墨魚人和10個沼澤食腐魚人，然後向悲傷沼澤的卡塔爾回報。',
  }
},
[1427] = {
  {
    'Ameaça do mar‡Угроза с моря‡Gefahr aus dem Meer‡바다의 위협‡La amenaza marítima‡La amenaza marítima‡Le danger venu des flots‡海中的威胁‡海中的威脅',
    nil,
    'Fale com Tok\'Kar no Pântano das Mágoas.‡Поговорите с Ток\'Каром в Болоте Печали.‡Sprecht mit Tok\'Kar in den Sümpfen des Elends.‡슬픔의 늪에 있는 톡카르와 대화해야 합니다.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Habla con Tok\'Kar en el Pantano de las Penas.‡Parler à Tok\'Kar dans le marais des Chagrins.‡与悲伤沼泽的托克卡尔谈一谈。‡與悲傷沼澤的托克卡爾談話。',
  }
},
[1428] = {
  {
    'Ameaça contínua‡Продолжающаяся угроза‡Fortwährende Gefahr‡계속되는 위협‡La amenaza continua‡Amenaza constante‡Le danger permanent‡海中的威胁‡持續的威脅',
    nil,
    'Mate 10 Jogatintas do Pântano, 10 Comecarnes do Pântano e 10 Oráculos do Pântano. Depois, fale novamente com Katar, no Pântano das Mágoas.‡Убейте 10 болотных чернильщиков, 10 болотных трупоедов и 10 болотных оракулов, затем вернитесь к Котору в Болоте Печали.‡Tötet 10 Marschentintenspucker, 10 Marschenfleischfresser und 10 Marschenorakel und kehrt dann zu Katar in den Sümpfen des Elends zurück.‡늪지멀록 먹물쟁이 10마리, 늪지멀록 청소부 10마리, 늪지멀록 점쟁이 10마리를 처치한 다음 슬픔의 늪에 있는 카타르에게 돌아가야 합니다.‡Mata a 10 vomitatintas de marisma, 10 comecarnes de marisma y 10 oráculos de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Mata a 10 vomitatintas de marisma, 10 comecarnes de marisma y 10 oráculos de marisma, y después ve a ver a Katar al Pantano de las Penas.‡Tuer 10 Cracheurs des marais, 10 Dévoreurs des marais, 10 Oracles des marais, puis retourner voir Katar dans le marais des Chagrins.‡杀掉10名沼泽喷墨鱼人、10名沼泽食腐鱼人和10名沼泽鱼人智者，然后向悲伤沼泽的卡塔尔回报。‡殺掉10名沼澤噴墨魚人、10名沼澤食腐魚人和10名沼澤魚人神諭者，然後向悲傷沼澤的卡塔爾回報。',
  }
},
[1429] = {
  {
    'O exilado Atal\'ai‡Изгнанник Атал\'ай‡Der Verbannte der Atal\'ai‡추방된 아탈라이 트롤‡El exiliado Atal\'ai‡El exilio de los Atal\'ai‡L\'Exilé atal\'ai‡阿塔莱流放者‡阿塔萊流放者',
    nil,
    'Leve o Saco de Artefatos Atal\'ai para o Exilado Atal\'ai nas Terras Agrestes.‡Принесите сверток с артефактами Атал\'ай к изгнаннику Атал\'ай во Внутренние земли.‡Bringt das Artefaktbündel der Atal\'ai zu dem Verbannten der Atal\'ai ins Hinterland.‡동부 내륙지에 있는 추방된 아탈라이트롤에게 아탈라이 유물 자루를 가져가야 합니다.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Lleva los artefactos Atal\'ai al exiliado Atal\'ai en las Tierras del Interior.‡Apportez les Artéfacts atal\'ai à l\'Exilé atal\'ai dans les Hinterlands.‡将一捆阿塔莱神器交给辛特兰的阿塔莱流放者。‡將一包阿塔萊神器交給辛特蘭的阿塔萊流放者。',
  }
},
[1430] = {
  {
    'Carne fresca‡Свежее мясо‡Frischfleisch‡싱싱한 고기‡Carne fresca‡Carne fresca‡Viande fraîche‡新鲜的螃蟹腿‡新鮮的螃蟹腿',
    nil,
    'Leve 10 Pernas de Rastejante Monstruoso para Dar no Pântano das Mágoas.‡ Принесите 10 ног чудовищного краба Дару на Болото Печали.‡Bringt 10 monströse Kriecherbeine zu Dar in den Sümpfen des Elends.‡슬픔의 늪에 있는 다르에게 괴물게 집게발 10개를 가져가야 합니다.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Lleva 10 patas de reptadores monstruosos a Dar en el Pantano de las Penas.‡Apporter 10 Pattes de clampants monstrueux à Dar dans le marais des Chagrins.‡给悲伤沼泽的达尔带去10条巨大的螃蟹腿。‡給悲傷沼澤的達爾帶去10條巨大的螃蟹腿。',
  }
},
[1431] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдрином в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화해야 합니다.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡與奧格瑪的科爾丹談話。',
  }
},
[1432] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Takta Laminaço em Desolação.‡Поговорите с Такатой Стальным Клинком в Пустошах.‡Sprecht mit Takata Stahlklinge in Desolace.‡잊혀진 땅에 있는 타카타 스틸블레이드와 대화해야 합니다.‡Habla con Takata Hoja de Acero en Desolace.‡Habla con Takata Hoja de Acero en Desolace.‡Parlez à Takata Lamacier en Désolace.‡与凄凉之地的塔卡塔·钢刃谈一谈。‡與淒涼之地的塔卡塔·鋼刃談話。',
  }
},
[1433] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Maurin Rachaosso em Desolação.‡Поговорите с Морином Костоломом в Пустошах.‡Sprecht mit Maurin Knochenspalter in Desolace.‡잊혀진 땅에 있는 마우린 본스플리터와 대화해야 합니다.‡Habla con Maurin Partehuesos en Desolace.‡Habla con Maurin Partehuesos en Desolace.‡Parler à Maurin Craquossement en Désolace.‡去找凄凉之地的玛乌林·碎骨谈一谈。‡去找淒涼之地的莫林·碎骨者談話。',
  }
},
[1434] = {
  {
    'Mácula dos sátiros‡Опоганенные сатиры‡Beschmutzt durch Satyrn‡사티로스의 출몰‡La contaminación del sátiro‡La contaminación del sátiro‡Souillé par les satyres‡萨特的威胁‡薩特的威脅',
    nil,
    'Mate 7 Errantes Furiódios, 7 Devotos Vis Furiódios, 7 Traidores Furiódios e 7 Arautos Infernais Furiódios. Depois fale com Takta Laminaço em Desolação.‡Убейте 7 разбойников из племени Ярой Ненависти, 7 скверноподданных племени Ярой Ненависти, 7 предателей из племени Ярой Ненависти и 7 адских сатиров из племени Ярой Ненависти и вернитесь к Такате Стальному Клинку в Пустоши.‡Besiegt 7 Schurken der Zornsäer, 7 Teufelsanbeter der Zornsäer, 7 Verräter der Zornsäer sowie 7 Höllenrufer der Zornsäer und kehrt zu Takata Stahlklinge in Desolace zurück.‡서릿발분노의 암살자 7명, 서릿발분노의 악마추종자 7명, 서릿발분노의 배반자 7명, 그리고 서릿발분노의 지옥소환사 7명을 처치한 후 잊혀진 땅에 있는 타카타 스틸블레이드에게 돌아가야 합니다.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hoja de Acero a Desolace.‡Mata a 7 pícaros, 7 jurapenas, 7 traidores y 7 clamainfernos Odio Feroz y ve a ver a Takata Hoja de Acero a Desolace.‡Massacrer 7 Voleurs Fielfurie, 7 Gangreliges Fielfurie, 7 Traîtres Fielfurie et 7 Implorateurs de l\'enfer Fielfurie, puis retourner voir Takata Lamacier en Désolace.‡杀死7只怨怒潜行者、7只怨怒魔仆、7只怨怒背叛者和7只怨怒唤魔者，然后向凄凉之地的塔卡塔·钢刃复命。‡殺死7隻怨怒盜賊、7隻怨怒魔僕、7隻怨怒背叛者和7隻怨怒喚魔者，然後向淒涼之地的塔卡塔·鋼刃覆命。',
  }
},
[1435] = {
  {
    'A queima dos espíritos‡Сжигание душ‡Brennender Geist‡불타는 영혼‡Los espíritus ardientes‡Los espíritus ardientes‡Esprits consumés‡灵魂的燃烧‡靈魂的燃燒',
    nil,
    'Devolva a Gema Ardente e leve 15 Gemas Ardentes Infusas para Maurin Rachaosso na Desolação.‡Верните пылающий самоцвет и 15 усиленных пылающих самоцветов Морину Костолому в Пустошах.‡Bringt den brennenden Edelstein und 15 erfüllte brennende Edelsteine nach Desolace zu Maurin Knochenspalter.‡잊혀진 땅에 있는 마우린 본스플리터에게 빌린 불타는 보석 하나와 영혼이 깃든 불타는 보석 15개를 가져가야 합니다.‡Lleva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Lleva la gema ardiente y 15 gemas ardientes imbuidas a Maurin Partehuesos a Desolace.‡Apporter une Gemme ardente et 15 Gemmes ardentes infusées à Maurin Craquossement en Désolace.‡将15块燃烧宝石转变为灌入灵魂的燃烧宝石，然后把它们交给凄凉之地的玛乌林·碎骨。‡將燃燒寶石和15顆靈魂灌注的燃燒寶石交給淒涼之地的莫林·碎骨者。',
  }
},
[1436] = {
  {
    'Relações da Aliança‡Отношения с Альянсом‡Allianzbeziehungen‡동맹 관계‡Las relaciones de la Alianza‡Las relaciones de la Alianza‡Les relations de l\'Alliance‡联盟关系‡聯盟關係',
    nil,
    'Fale com Keldran em Orgrimmar.‡Поговорите с Кельдрином в Оргриммаре.‡Sprecht mit Keldran in Orgrimmar.‡오그리마에 있는 켈드란과 대화해야 합니다.‡Habla con Keldran en Orgrimmar.‡Habla con Keldran en Orgrimmar.‡Parler à Keldran à Orgrimmar.‡与奥格瑞玛的科尔丹谈一谈。‡與奧格瑪的科爾丹談話。',
  }
},
[1437] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Procure a carroça de Tyranis e Dalinda Malem na Desolação.‡Отправляйтесь в Пустоши и попытайтесь отыскать повозку Тираниса и Далинды Малем.‡Sucht und findet den Wagen von Tyranis und Dalinda Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘과 달린다 말렘의 마차를 찾아 조사해야 합니다.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Busca y registra el carro de Tyranis y Dalinda Malem en Desolace.‡Rechercher le chariot de Tyranis et de Dalinda Malem en Désolace.‡去凄凉之地寻找泰拉尼斯·玛雷姆和黛琳达·玛雷姆的马车。‡去淒涼之地尋找泰拉尼斯·瑪雷姆和黛琳達·瑪雷姆的馬車。',
  }
},
[1438] = {
  {
    'A busca de Vahlarriel‡Расследование Валарриэля‡Vahlarriels Suche‡발라리엘의 수색‡Buscando para Vahlarriel‡Buscando para Vahlarriel‡La recherche de Vahlarriel‡瓦拉里尔的搜寻‡瓦拉里爾的搜尋',
    nil,
    'Encontre Dalinda Malem na Desolação.‡Найдите в Пустошах Далинду Малем.‡Sucht Dalinda Malem in Desolace.‡잊혀진 땅에서 달린다 말렘을 찾아야 합니다.‡Encuentra a Dalinda Malem en Desolace.‡Encuentra a Dalinda Malem en Desolace.‡Trouver Dalinda Malem en Désolace.‡去凄凉之地找到黛琳达·玛雷姆。‡去淒涼之地找到黛琳達·瑪雷姆。',
  }
},
[1439] = {
  {
    'A busca por Tyranis‡Поиски Тираниса‡Suche nach Tyranis‡티라니스 수색‡Buscando a Tyranis‡Buscando a Tyranis‡À la recherche de Tyranis‡寻找泰拉尼斯‡尋找泰拉尼斯',
    nil,
    'Encontre Tyranis Malem na Desolação.‡Разыщите в Пустоши Тираниса Малема.‡Sucht Tyranis Malem in Desolace.‡잊혀진 땅에서 티라니스 말렘을 찾아야 합니다.‡Encuentra a Tyranis Malem en Desolace.‡Encuentra a Tyranis Malem en Desolace.‡Trouver Tyranis Malem en Désolace.‡去凄凉之地找到泰拉尼斯·玛雷姆。‡去淒涼之地找到泰拉尼斯·瑪雷姆。',
  }
},
[1440] = {
  {
    'O retorno a Vahlarriel‡Возвращение к Валарриэлю‡Rückkehr zu Vahlarriel‡발라리엘에게 돌아가기‡Regresa junto a Vahlarriel‡Regresa junto a Vahlarriel‡Le retour vers Vahlarriel‡回复瓦拉里尔‡回覆瓦拉里爾',
    nil,
    'Escolte Dalinda Malem a partir da Fortaleza Machado do Trovão e fale novamente com Vahlarriel Matademônios na Desolação.‡Выведите Далинду Малем из Крепости Громового Топора, а затем вернитесь в Пустоши к Валлариелю Истребителю Демонов.‡Begleitet Dalinda Malem aus der Festung Donneraxt und kehrt zu Vahlarriel Dämonenjäger nach Desolace zurück.‡천둥도끼 요새에서 달린다 말렘을 호위해 잊혀진 땅에 있는 발라리엘 데몬슬레이어에게 돌아가야 합니다.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escolta a Dalinda Malem fuera de la Fortaleza del Hacha de Trueno y vuelve a Desolace a hablar con Vahlarriel Destripademonios.‡Escorter Dalinda Malem depuis la forteresse de Hache-Tonnerre et retourner voir Vahlarriel Tueur-de-démons, en Désolace.‡护送黛琳达·玛雷姆离开雷斧堡垒，然后回到凄凉之地的瓦拉里尔·屠魔者那里。‡護送黛琳達·瑪雷姆離開雷斧堡壘，然後回到淒涼之地的瓦拉里爾·屠魔者那裡。',
  }
},
[1441] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[1442] = {
  {
    'Em busca da Gema Kor‡Поиск самоцвета Кора‡Suche nach dem Koredelstein‡코르석을 찾아서‡La búsqueda de la gema Kor‡La búsqueda de la gema Kor‡À la recherche de la gemme de Kor‡寻找科尔宝石‡尋找科爾寶石',
    nil,
    'Leve a Gema Kor para Trovejius Tecevento, na Costa Negra.‡Принесите самоцвет Кора Тандрису Ветропряду на Темных берегах.‡Bringt einen Koredelstein zu Thundris Windwirker in Dunkelküste.‡어둠의 해안에 있는 툰드리스 윈드위버에게 코르석을 하나 가져가야 합니다.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Lleva una gema Kor a Thundris Tejevientos a Costa Oscura.‡Apporter une Gemme de Kor à Thundris Tissevent à Sombrivage.‡给黑海岸的桑迪斯·织风带去一块科尔宝石。‡帶一塊科爾寶石給黑海岸的桑迪斯·織風。',
  }
},
[1444] = {
  {
    'Retorno a Vil\'zerul‡Возвращение к Фел\'зерулу‡Rückkehr zu Fel\'Zerul‡펠제룰에게 돌아가기‡Regresa junto a Fel\'Zerul‡Regresa junto a Fel\'Zerul‡De retour vers Fel\'Zerul‡向费泽鲁尔复命‡向費澤盧爾覆命',
    nil,
    'Fale novamente com Vil\'Zerul em Pedregal.‡Вернитесь в Каменор к Фел\'зерулу.‡Kehrt zu Fel\'Zerul in Steinard zurück.‡스토나드에 있는 펠제룰에게 돌아가야 합니다.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Vuelve a ver a Fel\'Zerul en Rocal.‡Retourner voir Fel\'Zerul à Pierrêche.‡向斯通纳德的费泽鲁尔回报。‡向斯通納德的費澤盧爾回報。',
  }
},
[1445] = {
  {
    'O templo de Atal\'Hakkar‡Храм Атал\'Хаккар‡Der Tempel von Atal\'Hakkar‡아탈학카르 신전‡El Templo de Atal\'Hakkar‡El Templo de Atal\'Hakkar‡Le temple d\'Atal\'Hakkar‡阿塔哈卡神庙‡阿塔哈卡神廟',
    nil,
    'Obtenha 20 Fetiches de Hakkar e leve-os para Vil\'Zerul em Pedregal.‡Соберите 20 фетишей Хаккара и принесите их Фел\'зерулу в Каменор.‡Sammelt 20 Fetische von Hakkar und bringt sie zu Fel\'Zerul in Steinard.‡스토나드에 있는 펠제룰에게 학카르의 우상 20개를 가져가야 합니다.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Reúne 20 fetiches de Hakkar y llévaselos a Fel\'Zerul en Rocal.‡Rassembler 20 Fétiches d\'Hakkar et les apporter à Fel\'Zerul à Pierrêche.‡收集20个哈卡神像，把它们带给斯通纳德的费泽鲁尔。‡收集20個哈卡神像，並把它們交給斯通納德的費澤盧爾。',
  }
},
[1446] = {
  {
    'Jammal\'an, o Profeta‡Джаммал\'ан Пророк‡Jammal\'an der Prophet‡예언자 잠말란‡Jammal\'an el Profeta‡Jammal\'an el Profeta‡Jammal\'an le Prophète‡预言者迦玛兰‡『預言者』迦瑪蘭',
    nil,
    'O Exilado Atal\'ai nas Terras Agrestes quer a Cabeça de Jammal\'an.‡Принесите изгнаннику Атал\'ай из Внутренних земель голову Джаммал\'ана.‡Der Verbannte der Atal\'ai im Hinterland möchte den Kopf von Jammal\'an.‡잠말란을 처치하고 그 증거로 그의 머리카락을 동부 내륙지에 있는 추방된 아탈라이트롤에게 가져가야 합니다.‡El exiliado Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡El exiliado Atal\'ai, en las Tierras del Interior, quiere la cabeza de Jammal\'an.‡L\'Exilé atal\'ai des Hinterlands veut la Tête de Jammal\'an.‡辛特兰的阿塔莱流放者要你给他带回迦玛兰的徽记。‡辛特蘭的阿塔萊流放者想要迦瑪蘭的頭。',
  }
},
[1447] = {
  {
    'O diplomata desaparecido‡Пропавший дипломат‡Der vermisste Diplomat‡실종된 사신‡El diplomático desaparecido‡El diplomático desaparecido‡Un diplomate a disparu‡失踪的使节‡失蹤的使節',
    nil,
    'Derrote Dashel Punhopétreo em Ventobravo.‡Победите Дашеля Каменного Кулака в Штормграде.‡Besiegt Dashel Steinfaust in Sturmwind.‡스톰윈드에 있는 다셸 스톤피스트와 싸워 이겨야 합니다.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Derrota a Dashel Puñopiedra en Ventormenta.‡Battre Dashel Poing-de-pierre à Hurlevent.‡击败暴风城的达舍尔·石拳。‡擊敗暴風城的達舍爾·石拳。',
  }
},
[1448] = {
  {
    'Em busca do templo‡В поисках Храма‡Auf der Suche nach dem Tempel‡신전을 찾아서‡En búsqueda del templo‡En búsqueda del templo‡À la recherche du temple‡调查神庙‡調查神廟',
    nil,
    'Brohann Barrilga, em Ventobravo, quer que você saia à procura do Templo de Atal\'Hakkar.‡Найдите храм Атал\'Хаккар и сообщите о его местонахождении Брохану Бочкопузу из Штормграда.‡Brohann Fassbauch in Sturmwind möchte, dass Ihr den Tempel von Atal\'Hakkar sucht.‡스톰윈드에 있는 브로한 캐스크벨리가 아탈학카르 신전을 찾아 달라고 부탁했습니다.‡Brohann Barriliga, en Ventormenta, quiere que busques el Templo de Atal\'Hakkar.‡Brohann Barriliga, en Ventormenta, quiere que busques El Templo de Atal\'Hakkar.‡Brohann Ventrabière à Hurlevent veut que vous recherchiez le temple d\'Atal\'Hakkar.‡暴风城的布罗哈恩·铁桶要求你去找到阿塔哈卡神庙。‡暴風城的布羅哈恩·鐵桶要求你去找到阿塔哈卡神廟。',
  }
},
[1449] = {
  {
    'Rumo às Terras Agrestes‡Во Внутренние земли‡Ins Hinterland‡동부 내륙지로‡A las Tierras del Interior‡A las Tierras del Interior‡Vers les Hinterlands‡去辛特兰的旅程‡前往辛特蘭',
    nil,
    'Fale com o Alto Thane Falstad Martelo Feroz no Ninho da Águia nas Terras Agrestes.‡Поговорите с верховным таном Фалстадом Громовым Молотом в Заоблачном Пике, что во Внутренних землях.‡Sprecht mit dem obersten Than, Falstad Wildhammer, am Nistgipfel im Hinterland.‡동부 내륙지 맹금의 봉우리에 있는 대영주 폴스타트 와일드해머와 대화해야 합니다.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Habla con el Gran señor feudal Falstad Martillo Salvaje en el Pico Nidal, en las Tierras del Interior.‡Parler au haut-thane Falstad Marteau-hardi, au Nid-de-l\'Aigle des Hinterlands.‡找到辛特兰的弗斯塔德·蛮锤。‡到辛特蘭的鷹巢山找大族長弗斯塔德·蠻錘。',
  }
},
[1450] = {
  {
    'Mestre de Grifos Garra-de-acha‡Укротитель грифонов Разящий Коготь‡Greifenmeister Krallenaxt‡그리핀 조련사 탈론액스‡Maestro de grifos Garracha‡Maestro de grifos Garracha‡Le maître des griffons Hachegriffe‡狮鹫管理员‡獅鷲獸管理員沙拉克·鷹斧',
    nil,
    'Fale com o Mestre de Grifos Garra-de-acha no Aviário do Ninho da Águia.‡Поговорите с укротителем грифонов Разящим Когтем в питомнике на Заоблачном пике.‡Sprecht mit Greifenmeister Krallenaxt im Horst beim Nistgipfel.‡맹금의 봉우리 출격장 안에 있는 그리핀 조련사 탈론액스와 대화해야 합니다.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Habla con el maestro de grifos Garracha dentro de la pajarera del Pico Nidal.‡Parlez au Maître des griffons Hachegriffe dans la Volière de Nid-de-l\'Aigle.‡与辛特兰的鹰巢山狮鹫饲养场里的狮鹫管理员沙拉克·鹰斧谈一谈。‡與辛特蘭的鷹巢山獅鷲獸飼養場裡的獅鷲獸管理員沙拉克·鷹斧談話。',
  }
},
[1451] = {
  {
    'Rapsódico Festanjeiro‡Рапсод Землекоп‡Rhapsodie Kniegräber‡랩소디 신디거‡Rapsodio Machacacanillas‡Rapsodio Machacacanillas‡Rhapsody Croquejarret‡拉普索迪·铁铲‡拉普索迪·鐵鏟',
    nil,
    'Procure Rapsódico Festanjeiro nas Terras Agrestes.‡Найдите Рапсода Землекопа во Внутренних землях.‡Sucht Rhapsodie Kniegräber im Hinterland.‡동부 내륙지에서 랩소디 신디거를 찾아야 합니다.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Busca a Rapsodio Machacacanillas en las Tierras del Interior.‡Chercher Rhapsody Croquejarret dans les Hinterlands.‡去辛特兰找到拉普索迪·铁铲。‡去辛特蘭找到拉普索迪·鐵鏟。',
  }
},
[1452] = {
  {
    'O Coquetel de Kalimdor do Rapsódico‡Калимдорский коктейль‡Rhapsodies Kalimdor-Cocktail‡랩소디의 칼림도어 칵테일‡El cubata de Kalimdor de Rapsodio‡El cubata de Kalimdor de Rapsodio‡Le Kocktail Kalimdor de Rhapsody‡拉普索迪的卡利姆多鸡尾酒‡拉普索迪的卡林多雞尾酒',
    nil,
    'Rapsódico Festanjeiro, nas Terras Agrestes, quer que você consiga 3 Moelas de Roca, 3 Fígados de Groddoc e 3 Fígados de Veloférreo.‡Принесите Рапсоду Землекопу 3 куска потрохов руха, 3 печени гроддока и 3 печени сталемеха.‡Rhapsodie Kniegräber im Hinterland möchte, dass Ihr ihm 3 Muskelmägen eines Roc, 3 Groddoclebern und 3 Eisenfelllebern bringt.‡동부 내륙지에 있는 랩소디 신디거가 로크 모래주머니 3개, 그로독 고릴라 간 3개, 무쇠곰 간 3개를 가져다 달라고 부탁했습니다.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de Roc, 3 hígados de Groddoc y 3 hígados de Cueracero.‡Rapsodio Machacacanillas, en las Tierras del Interior, quiere que le lleves 3 mollejas de roc, 3 hígados de Groddoc y 3 hígados de Cueracero.‡Rhapsody Croquejarret dans les Hinterlands veut que vous lui rameniez 3 Gésiers de roc, 3 Foies de Groddoc et 3 Foies de Ferpoil.‡辛特兰的拉普索迪·铁铲要求你带给他3块大鹏的砂囊、3块格罗多克猩猩的肝脏和3块铁鬃熊的肝脏。‡辛特蘭的拉普索迪·鐵鏟要求你帶給他3塊大鵬的砂囊、3塊格羅多克猩猩的肝臟和3塊鐵鬃熊的肝臟。',
  }
},
[1453] = {
  {
    'Trago qualquer coisa em três dias‡Дела Поисковой корпорации в Пустошах‡Die Geschäfte der Wiederholer in Desolace‡잊혀진 땅에서의 회수 임무‡Los negocios de los Recuperadores en Desolace‡Los negocios de los Recuperadores en Desolace‡Les affaires de Récupérateurs en Désolace‡寻物公司的业务‡尋物公司的業務',
    nil,
    'Fale com Kreldig Ungor no Posto do Nijel, que fica em Desolação.‡Поговорите с Крелдигом Унгором на Высоте Найджела в Пустошах.‡Sprecht mit Kreldig Ungor in Nijelspitze in Desolace.‡잊혀진 땅의 나이젤의 야영지에 있는 크렐디그 운고르와 대화해야 합니다.‡Habla con Kreldig Ungor en la Punta de Nijel, en Desolace.‡Habla con Kreldig Ungor en la Punta de Nijel, en Desolace.‡Parler à Kreldig Ungor à la Combe de Nijel, en Désolace.‡和凄凉之地尼耶尔前哨站的克雷迪格·安戈尔谈一谈。‡到淒涼之地的尼耶爾前哨站找克雷迪格·安戈爾談話。',
  }
},
[1454] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre o Baú de Karnitol em Desolação.‡Найдите в Пустошах сундук Карнитола.‡Sucht Karnitols Truhe in Desolace.‡잊혀진 땅에서 카니톨의 궤짝을 찾아야 합니다.‡Encuentra el cofre de Karnitol en Desolace.‡Encuentra el cofre de Karnitol en Desolace.‡Retrouver le Coffre de Karnitol en Désolace.‡在凄凉之地找到卡尼托的箱子。‡在淒涼之地找到卡尼托的箱子。',
  }
},
[1455] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Fale novamente com Kreldig Ungor no Posto do Nijel, que fica em Desolação.‡Поговорите с Крелдигом Унгором на Высоте Найджела в Пустошах.‡Kehrt zu Kreldig Ungor nach Nijelspitze in Desolace zurück.‡잊혀진 땅의 나이젤의 야영지에 있는 크렐디그 운고르에게 돌아가야 합니다.‡Vuelve a la Punta de Nijel, en Desolace, a hablar con Kreldig Ungor.‡Vuelve a la Punta de Nijel, en Desolace, a hablar con Kreldig Ungor.‡Retourner voir Kreldig Ungor à la Combe de Nijel, en Désolace.‡回到凄凉之地尼耶尔前哨站的克雷迪格·安戈尔那里。‡到淒涼之地的尼耶爾前哨站找克雷迪格·安戈爾。',
  }
},
[1456] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的海难‡卡尼托的海難',
    nil,
    'Encontre a Algibeira de Karnitol e leve-a de volta para Kreldig Ungor em Desolação.‡Найдите сумку для книг, принадлежащую Карнитолу, и отнесите ее в Пустоши Крелдигу Унгору.‡Sucht Karnitols Ranzen und bringt ihn zu Kreldig Ungor in Desolace zurück.‡카니톨의 가방을 찾아 잊혀진 땅에 있는 크렐디그 운고르에게 가져가야 합니다.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Encuentra la cartera de Karnitol y devuélvesela a Kreldig Ungor, que está en Desolace.‡Retrouver la Sacoche de Karnitol et la rapporter à Kreldig Ungor en Désolace.‡找到卡尼托的背包，把它交给凄凉之地的克雷迪格·安戈尔。‡找到卡尼托的背袋，把它交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1457] = {
  {
    'O naufrágio de Karnitol‡Пожитки Карнитола‡Karnitols Schiffbruch‡카니톨 난파선‡El naufragio de Karnitol‡El naufragio de Karnitol‡L\'épave de Karnitol‡卡尼托的背包‡卡尼托的海難',
    nil,
    'Leve a Algibeira de Karnitol para Putren Rochamalho em Altaforja.‡Отнесите сумку для книг, принадлежащую Карнитолу, в Стальгорн, и отдайте ее Ройттену Камнемолоту.‡Bringt Karnitols Ranzen zu Roetten Steinhammer in Eisenschmiede.‡아이언포지에 있는 로이튼 스톤해머에게 카니톨의 가방을 가져가야 합니다.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Lleva la cartera de Karnitol a Roetten Rocamartillo a Forjaz.‡Apporter la Sacoche de Karnitol à Roetten Martel-de-pierre à Forgefer.‡把卡尼托的背包交给铁炉堡的罗顿·石锤。‡把卡尼托的背袋交給鐵爐堡的羅頓·石錘。',
  }
},
[1458] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 10 Garras Furiódio e 10 Chifres Furiódio para Kreldig Ungor na Desolação.‡Принесите 10 когтей и 10 рогов сатиров племени Ярой Ненависти в Пустоши Крелдигу Унгору.‡Bringt 10 Zornsäerklauen und 10 Zornsäerhörner zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 서릿발분노의 사티로스 발톱 10개와 서릿발분노의 사티로스 뿔 10개를 가져가야 합니다.‡Lleva 10 garras de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Lleva 10 zarpas de Odio Feroz y 10 cuernos de Odio Feroz a Kreldig Ungor a Desolace.‡Apporter 10 Griffes de Fielfurie et 10 Cornes de Fielfurie à Kreldig Ungor en Désolace.‡收集10只怨怒萨特的爪子和10根怨怒萨特的角，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集10隻怨怒薩特的爪子和10根怨怒薩特的角，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
[1459] = {
  {
    'Reagentes para Recuperação Ilimitada (Ltda)‡Реагенты для Поисковой корпорации‡Reagenzien für die Wiederholer AG‡회수전문회사를 위한 재료‡Componentes para Recuperadores S.A.‡Componentes para Recuperadores S.A.‡Des réactifs pour les Récupérateurs‡寻物公司的委托‡尋物公司的委託',
    nil,
    'Leve 7 ampolas de Peçonha de Scorpachi e 3 Pelegos Envelhecidos de Kodo para Kreldig Ungor na Desolação.‡Принесите 7 фиалов скорпионьего яда и 3 шкуры старого кодо в Пустоши Крелдигу Унгору.‡Bringt 7 Phiolen Skorpashigift und 3 Bälge von gealterten Kodos zu Kreldig Ungor in Desolace.‡잊혀진 땅에 있는 크렐디그 운고르에게 스콜파시 독 7병과 늙은 코도 통가죽 3개를 가져가야 합니다.‡Lleva 7 viales de veneno Scorpashi y 3 pellejos de kodo envejecido a Kreldig Ungor a Desolace.‡Lleva 7 viales de veneno de Scorpashi y 3 pellejos de kodo envejecido a Kreldig Ungor a Desolace.‡Apporter 7 Fioles de venin scorpashi et 3 Peaux de vieux kodo à Kreldig Ungor, en Désolace.‡收集7瓶鞭尾蝎的毒液和3块老迈科多兽的毛皮，把它们交给凄凉之地的克雷迪格·安戈尔。‡收集7瓶鞭尾蠍的毒液和3塊老邁科多獸的毛皮，把它們交給淒涼之地的克雷迪格·安戈爾。',
  }
},
