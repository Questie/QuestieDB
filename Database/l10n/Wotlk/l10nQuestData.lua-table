[1133] = {
  {
    'Jornada para Astranaar‡Путешествие в Астранаар‡Reise nach Astranaar‡아스트라나르로의 여정‡Viaje a Astranaar‡Viaje a Astranaar‡Le voyage vers Astranaar‡通往阿斯特兰纳的旅途‡通往阿斯特蘭納的旅途',
    nil,
    'Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.‡Speak with Shindrell Swiftfire in Astranaar.',
  }
},
[1134] = {
  {
    'Os asaltivas das Torres de Pedra‡Величавые виверны Каменного Когтя‡Prachtschwingen des Steinkrallengebirges‡돌발톱 산맥의 사자날개‡Alaorgullo del Espolón‡Alaorgullo del Espolón‡Les Ailes-fières des Serres-Rocheuses‡石爪山的双足飞龙‡石爪山的雙足翼龍',
    nil,
    'Leve 12 Vesículas de Peçonha de Asaltiva para Shindrell Fogofugaz em Astranaar.‡Принесите 12 ядовитых желез славнокрыла Шиндрелл Огненный Всполох в Астранаар.‡Bringt 12 Prachtschwingengiftbeutel zu Shindrell Feuerflink in Astranaar.‡아스트라나르에 있는 신드렐 스위프트파이어에게 사자날개 와이번 독주머니 12개를 가져가야 합니다.‡Lleva 12 glándulas de veneno de Alaorgullo a Shindrell Fuegoveloz en Astranaar.‡Lleva 12 sacos de veneno de alaorgullo a Shindrell Fuegoveloz en Astranaar.‡Apporter 12 Glandes de venin d\'Aile-fière à Shindrell Prestefeu à Astranaar.‡收集12个巨翼双足飞龙的毒囊，并把它们交给阿斯特兰纳的辛德瑞尔·速火。‡收集12個巨翼雙足翼龍的毒囊，並把它們交給阿斯特蘭納的辛德瑞爾·速火。',
  }
},
[1135] = {
  {
    'Veneno de Alcândora‡Яд из Скального гнездовья‡Steilhanggift‡마루둥지 와이번의 독‡Glándulas de veneno de Nido Alto‡Glándulas de veneno de Nido Alto‡Le venin de Haut-perchoir‡风巢双足飞龙的毒囊‡風巢雙足飛龍的毒囊',
    nil,
    'Leve 10 Vesículas de Peçonha de Alcândora para Fiora Longorelhas em Theramore.‡Принесите из Скального гнездовья 10 ядовитых желез для Фиоры Длинноушки в Терамор.‡Bringt 10 Steilhanggiftbeutel zu Fiora Langohr in Theramore.‡테라모어에 있는 피오라 롱이어즈에게 마루둥지 와이번 독주머니 10개를 가져가야 합니다.‡Llévale 10 glándulas de veneno de Nido Alto a Fiora Orejona, que está en Theramore.‡Llévale 10 glándulas de veneno de Nido Alto a Fiora Orejona, que está en Theramore.‡Apporter 10 Glandes à venin de Haut-perchoir à Fiora Grandes-oreilles à Theramore.‡收集10个风巢双足飞龙的毒囊，把它们带给塞拉摩的菲欧拉·长耳。‡收集10個風巢雙足飛龍的毒囊，把它們帶給塞拉摩的菲歐拉·長耳。',
  }
},
[1136] = {
  {
    'Bocarragelo‡Ледочрев‡Frostrachen‡서리갈기 설인‡Faucehielo‡Faucehielo‡Gueule-glacée‡霜喉雪人‡霜喉雪人',
    nil,
    'Leve a Juba de Bocarragelo para Melor Casco de Pedra no Penhasco do Trovão.‡Принесите гриву Ледочрева Мелору Каменному Копыту в Громовой Утес.‡Bringt Frostrachens Mähne zu Melor Steinhuf in Donnerfels.‡썬더 블러프에 있는 멜로르 스톤후프에게 서리갈기 설인의 갈기를 가져가야 합니다.‡Lleva la crin de Faucehielo a Melor Pezuña Pétrea en Cima del Trueno.‡Lleva la crin de Faucehielo a Melor Pezuña Pétrea en Cima del Trueno.‡Rapporter la Crinière de Gueule-glacée à Melor Sabot-de-pierre aux Pitons du Tonnerre.‡把霜喉雪人的鬃毛带给雷霆崖的梅洛·石蹄。‡把霜喉雪人的鬃毛帶給雷霆崖的梅洛·石蹄。',
  }
},
[1137] = {
  {
    'Um bizu para o xabu‡Новости для Пшикса‡Neuigkeiten für Fizzel‡피즐에게 전할 소식‡Noticias para Fizzle‡Noticias para Fizzle‡Des nouvelles pour Féplouf‡回复菲兹尔‡回覆菲茲爾',
    nil,
    'Speak with Fizzle Brassbolts on the Shimmering Flats in Thousand Needles.‡Поговорите с Пшиксом Медноштифтом на Мерцающей равнине, что в Тысяче Игл.‡Sprecht mit Fizzel Kupferbolz in der schimmernden Ebene in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 피즐 브라스볼츠와 대화해야 합니다.‡Habla con Fizzle Pernolatón en El Desierto de Sal, en Las Mil Agujas.‡Habla con Fizzle Pernolatón en El Desierto de Sal, en Las Mil Agujas.‡Parler à Féplouf Zéboulon dans les Salines, aux Milles pointes.‡和千针石林中闪光平原的菲兹尔·铜栓谈一谈。‡到千針石林的閃光平原找菲茲爾·銅栓談話。',
  }
},
[1138] = {
  {
    'Frutos do mar‡Дары моря‡Meeresfrüchte‡바다의 열매‡Rico marisco‡Rico marisco‡Fruit de la mer‡海中的水果‡海中的水果',
    nil,
    'Recolha 6 Pedaços Delicados de Caranguejo para Gubber Blump em Auberdine.‡Соберите 6 кусочков отличного крабьего мяса для Груббера Блумпа в Аубердине.‡Sammelt 6 feine Krebsbrocken für Gubber Blump in Auberdine.‡맛좋은 게살 6개를 모아서 아우버다인에 있는 구버 블럼프에게 가져가야 합니다.‡Reúne 6 trozos de cangrejo de gran calidad para Gubber Blump de Auberdine.‡Reúne 6 trozos de cangrejo de gran calidad para Gubber Blump de Auberdine.‡Collecter 6 morceaux de Chair de crabe raffinée pour Gubber Blump, à Auberdine.‡收集6块优质蟹肉，把它们交给奥伯丁的古博·布拉普。‡收集6塊優質蟹肉，把它們交給奧伯丁的古博·布拉普。',
  }
},
[1139] = {
  {
    'As tabuletas perdidas da vontade‡Утерянные таблички Воли‡Die verlorene Tafel des Willens‡잃어버린 결의의 서판‡Las tablillas perdidas de Voluntad‡Las tablillas perdidas de Voluntad‡La tablette de volonté‡意志石板‡意志石板',
    nil,
    'Encontre a Tabuleta da Vontade e leve-a para o Conselheiro Belgrum em Altaforja.‡Найдите табличку воли и принесите ее советнику Белграму в Стальгорн.‡Sucht die Schrifttafel des Willens und bringt sie zu Berater Belgrum in Eisenschmiede.‡결의의 서판을 찾아 아이언포지에 있는 조언자 벨그룸에게 가져가야 합니다.‡Encuentra la tablilla de Voluntad y llévasela al consejero Belgrum en Forjaz.‡Encuentra la tablilla de Voluntad y llévasela al consejero Belgrum en Forjaz.‡Trouver la Tablette de Volonté et la rapporter au Conseiller Belgrum à Forgefer.‡找到意志石板，把它们交给铁炉堡的顾问贝尔格拉姆。‡找到意志石板，把它們交給鐵爐堡的顧問貝爾格拉姆。',
  }
},
[1140] = {
  {
    'A torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Liberte a alma dos Altaneiros na Trilha da Noite e em Satyrnaar, depois fale novamente com Dinis, o Purificador, no Entreposto de Maestra.‡Освободите заточенные души высокорожденных на Ночной поляне и Сатирнааре, затем вернитесь к Делгрену Очистителю на заставу Мейстры.‡Befreit die Hochgeborenenseelen in der Nachtflucht und Satyrnaar und kehrt zu Delgren dem Läuterer in Maestras Posten zurück.‡어둠의 터와 사티르나르에 갇혀 있는 명가의 영혼들을 구출하고 마에스트라 주둔지에 있는 수호자 델그렌에게 돌아가야 합니다.‡Libera las almas de los Altonato atrapadas en la Senda de la Noche y en Satyrnaar y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Libera las almas de los Altonato atrapadas en la Senda de la Noche y en Satyrnaar y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Libérer les Âmes de Bien-nés captives au défilé de la Nuit et à Satyrnaar, puis retourner voir Delgren le Purificateur au poste de Maestra.‡在夜道谷和萨提纳尔找到被禁锢的上层精灵的灵魂，释放它们，然后回到迈斯特拉岗哨的净化者德尔格伦那里。‡在夜道谷和薩提納爾找到被禁錮的精靈貴族的靈魂，釋放他們，然後回到邁斯特拉崗哨的『淨化者』德爾葛蘭那裡。',
  }
},
[1141] = {
  {
    'Vara de canoeiro, prefere pescar‡Семья и рыболовная удочка‡Die Familie und die Angelrute‡블럼프가의 낚싯대‡La familia y la caña de pescar‡La familia y la caña de pescar‡La famille à la canne à pêche‡钓鱼世家‡釣魚世家',
    nil,
    'Pesque 6 Garoupas da Costa Negra para Gubber Blump em Auberdine.‡Поймайте 6 морских окуней с Темных берегов для Груббера Блумпа в Аубердине.‡Fangt 6 Dunkelküstenbarsche für Gubber Blump in Auberdine.‡어둠의해안 농어 6마리를 잡아서 아우버다인에 있는 구버 블럼프에게 가져가야 합니다.‡Pesca 6 meros de Costa Oscura para Gubber Blump de Auberdine.‡Pesca 6 meros de Costa Oscura para Gubber Blump de Auberdine.‡Attraper 6 Mérous de Sombrivage pour Gubber Blump, à Auberdine.‡为奥伯丁的古博·布拉普抓6条黑海岸石斑鱼。‡為奧伯丁的古博·布拉普抓6條黑海岸石斑魚。',
  }
},
[1142] = {
  {
    'A mortalidade se esvanece‡Последнее желание‡Die Sterblichkeit schwindet‡꺼져가는 생명의 불씨‡Decaída mortal‡Decaída mortal‡Le déclin et la mort‡临终遗言‡臨終遺言',
    nil,
    'Encontre e devolva o Pingente de Treshala para Treshala Corregofulvo em Darnassus.‡Найдите подвеску Трешалы и верните ее Трешале Бурый Ручей в Дарнас.‡Sucht und bringt Treshalas Anhänger zu Treshala Bachquell in Darnassus.‡트레샬라의 펜던트를 찾아 다르나서스에 있는 트레샬라 팰로우브룩에게 돌려주어야 합니다.‡Encuentra el colgante de Treshala Arroyobarbecho y llévaselo a Darnassus.‡Encuentra el colgante de Treshala Arroyobarbecho y llévaselo a Darnassus.‡Trouver et rapporter le Pendentif de Treshala à Treshala Ruissefriche à Darnassus.‡将塔莎拉的坠饰带给达纳苏斯的塔莎拉·静水。‡將塔莎拉的墜飾帶給達納蘇斯的塔莎拉·靜水。',
  }
},
[1143] = {
  {
    'A torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Mate Athrikus Narassin e leve a cabeça dele para Balthule Umbrataque perto da Torre de Althalaxx.‡Убейте Атрикуса Нарассина и принесите его голову Балтулу Удару Тени у башни Алталакса.‡Tötet Athrikus Narassin und bringt seinen Kopf zu Balthule Schattenhieb nahe des Turms von Althalaxx.‡애스리쿠스 나라신을 처치한 다음, 그 증거로 그의 머리 장식을 알살락스의 탑 근처에 있는 발툴 섀도스트라이크에게 가져가야 합니다.‡Mata a Athrikus Narassin y lleva su cabeza a Balthule Tenebroso, que está cerca de la Torre de Althalaxx.‡Mata a Athrikus Narassin y lleva su cabeza a Balthule Golpesombra que está cerca de La torre de Althalaxx.‡Tuer Athrikus Narassin et apporter sa Tête à Balthule Frappelombre près de la Tour d\'Althalaxx.‡杀掉埃瑟里克斯·纳拉辛，把他的徽记交给奥萨拉克斯之塔附近的巴苏尔·影击。‡殺掉埃瑟里克斯·納拉辛，把他的項上人頭交給奧薩拉克斯之塔附近的巴蘇爾·影擊。',
  }
},
[1144] = {
  {
    'Importador Willix‡Импортер Вилликс‡Willix der Importeur‡수입업자 윌릭스‡Willix el Importador‡Willix el Importador‡Willix l\'Importateur‡进口商威利克斯‡進口商威利克斯',
    nil,
    'Escort Willix the Importer to the exit of Razorfen Kraul.‡Проводите импортера Вилликса до выхода из Лабиринтов Иглошкурых.‡Führt Willix den Importeur aus dem Kral der Klingenhauer hinaus.‡수입업자 윌릭스를 호위해 가시덩굴 우리에서 나가야 합니다.‡Escolta a Willix el Importador hasta la salida de Horado Rajacieno.‡Escolta a Willix el Importador hasta la salida de Horado Rajacieno.‡Escorter Willix l\'Importateur jusqu\'à la sortie du Kraal de Tranchebauge.‡护送进口商威利克斯到达剃刀沼泽的出口。‡將進口商威利克斯護送至剃刀沼澤的門口。',
  }
},
[1145] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Korran para Belgrom Pedramalho em Orgrimmar.‡Отнесите запечатанную записку Коррана Белгрому Каменной Булаве в Оргриммар.‡Stellt Korrans versiegelte Notiz Belgrom Felshammer in Orgrimmar zu.‡오그리마에 있는 벨그롬 록마울에게 코란의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota lacrada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Entrégale la nota lacrada de Korran a Belgrom Destrozarroca en Orgrimmar.‡Remettre la Note scellée de Korran à Belgrom Cogneroche à Orgrimmar.‡把科兰的密信交给奥格瑞玛的贝尔戈洛姆·石槌。‡把科蘭的密信交給奧格瑪的貝爾戈洛姆·石槌。',
  }
},
[1146] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Leve o Bilhete Selado de Belgrom para Moktar Krin em Mil Agulhas.‡Доставьте запечатанное письмо Белгрома Моктару Крину в Тысячу Игл.‡Stellt Belgroms versiegelte Notiz Moktar Krin in Tausend Nadeln zu.‡버섯구름 봉우리에 있는 목타르 크린에게 벨그롬의 봉인된 쪽지를 전해야 합니다.‡Entrégale la nota lacrada de Belgrom a Moktar Krin en Las Mil Agujas.‡Entrégale la nota lacrada de Belgrom a Moktar Krin en Las Mil Agujas.‡Apporter la Note scellée de Belgrom à Moktar Krin aux Mille pointes.‡把贝尔戈洛姆的密信交给千针石林的摩克塔·克林。‡把貝爾戈洛姆的密信交給千針石林的摩克塔·克林。',
  }
},
[1147] = {
  {
    'O enxame se adensa‡Рой растет‡Der Schwarm wächst‡곤충 떼의 위협‡El enjambre crece‡El enjambre crece‡L\'essaim s\'agrandit‡疯狂的虫群‡瘋狂的蟲群',
    nil,
    'Mate 5 Farejadores Silitídeos, 5 Zangões Silitídeos da Colmeia e 5 Invasores Silitídeos, depois fale novamente com Moktar Krin em Mil Agulhas.‡Убейте 5 силитидов-искателей, 5 силитидов-трутней и 5 силитидов-захватчиков, а потом вернитесь к Моктару Крину в Тысячу Игл.‡Tötet 5 Silithidsucher, 5 Silithidschwarmdrohnen sowie 5 Silithideindringlinge und kehrt zu Moktar Krin in Tausend Nadeln zurück.‡탐색꾼 실리시드 5마리, 일꾼 실리시드 5마리, 병정 실리시드 5마리를 처치하고 버섯구름 봉우리에 있는 목타르 크린에게 돌아가야 합니다.‡Mata a 5 buscadores silítidos, 5 zánganos de la Colmena silítida y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Mata a 5 buscadores silítidos, 5 zánganos de colmena silítidos y 5 invasores silítidos, y después ve a ver de nuevo a Moktar Krin a Las Mil Agujas.‡Tuer 5 Chercheurs silithides, 5 Bourdons silithides et 5 Envahisseurs silithides, puis retourner voir Moktar Krin aux Mille pointes.‡杀掉5只异种搜寻者、5只异种筑巢蝎和5只异种侵略者，然后向千针石林的摩克塔·克林复命。‡殺掉5隻異種搜尋者、5隻異種築巢蠍和5隻異種侵略者，然後向千針石林的摩克塔·克林覆命。',
  }
},
[1148] = {
  {
    'Pedaços do enxame‡Части роя‡Teile des Schwarms‡실리시드 등껍질‡Pedazos del enjambre‡Pedazos del enjambre‡Des parties de l\'essaim‡虫群的样本‡蟲群的樣本',
    nil,
    'Leve 1 Coração de Silitídeo, 5 Garras de Silitídeo e 3 Carapaças Intactas de Silitídeo para Korran na Encruzilhada.‡Добудьте 1 сердце, 5 шпор и 3 целых силитидских панциря для Коррана из Перекрестка.‡Bringt 1 Silithidenherz, 5 Silithidenkrallen und 3 intakte Silithidenknochenpanzer zu Korran beim Wegekreuz.‡크로스로드에 있는 코란에게 실리시드의 심장 1개, 실리시드의 갈퀴발톱 5개, 온전한 실리시드의 등껍질 3개를 가져가야 합니다.‡Llévale 1 corazón de silítido, 5 garfas de silítido y 3 caparazones de silítido intactos a Korran, que está en El Cruce.‡Llévale 1 corazón de silítido, 5 garfas de silítido y 3 caparazones de silítido intactos a Korran, que está en El Cruce.‡Apporter 1 Cœur de silithide, 5 Serres de silithide et 3 Carapaces de silithide intactes à Korran, à la Croisée.‡收集1颗异种蝎的心脏、5只异种蝎的爪子和3个完整的异种蝎壳，把它们和你手中的这个破碎的异种蝎壳一起交给十字路口的科兰。‡收集1顆異種蠍的心臟、5隻異種蠍的爪子和3個完整的異種蠍殼，把它們和你手中的這個破碎的異種蠍殼一起交給十字路口的科蘭。',
  }
},
[1149] = {
  {
    'Teste da Fé‡Испытание веры‡Test des Glaubens‡믿음의 시험‡Prueba de fe‡Prueba de fe‡L\'épreuve de la Foi‡信仰的试炼‡信仰試煉',
    nil,
    'Se tiver fé, pule lá de cima das tábuas, no topo de Mil Agulhas.‡Если ваша вера сильна, прыгните с досок над Тысячью Игл.‡Wenn Ihr festen Glaubens seid, dann springt von den Planken über Tausend Nadeln.‡믿음이 있다면 버섯구름 봉우리가 내려다보이는 높은 곳에서 판자 아래로 뛰어내리십시오.‡Si tienes fe, salta desde las tablas que dominan Las Mil Agujas.‡Si tienes fe, salta desde las tablas que dominan Las Mil Agujas.‡Si vous avez la Foi, sautez des planches qui dominent les Mille pointes.‡如果你有坚定的信仰，就从那个可以俯瞰千针石林的木板跳下去。‡如果你有堅定的信仰，就從那個可以俯瞰千針石林的木板跳下去。',
  }
},
[1150] = {
  {
    'Teste de resistência‡Испытание выносливости‡Test der Belastbarkeit‡인내의 시험‡Prueba de resistencia‡Prueba de resistencia‡L\'épreuve de l\'Endurance‡耐力的试炼‡耐力試煉',
    nil,
    'Leve a Garra da Grenka para Dorn Espreitaprados em Mil Agulhas.‡Принесите коготь Гренки Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Grenkas Klaue zu Dorn Ebenenpirscher in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 그렌카의 발톱을 가져가야 합니다.‡Llévale la garra de Grenka a Dorn Acechallanos, que está en Las Mil Agujas.‡Llévale la garra de Grenka a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter la Griffe de Grenka à Dorn Traqueur-des-plaines, aux Mille pointes.‡把格林卡的爪子交给千针石林的多恩·平原行者。‡把格林卡的爪子交給千針石林的多恩·平原巡者。',
  }
},
[1151] = {
  {
    'Teste de força‡Испытание силы‡Test der Kraft‡용기의 시험‡Prueba de fuerza‡Prueba de fuerza‡L\'épreuve de la Force‡力量的试炼‡力量試煉',
    nil,
    'Leve os Fragmentos de Rok\'Alim para Dorn Espreitaprados em Mil Agulhas.‡Принесите фрагменты Рок\'Алима Дорну Вольному Ловчему в Тысячу Игл.‡Bringt Fragmente von Rok\'Alim zu Dorn Ebenenpirscher in Tausend Nadeln.‡버섯구름 봉우리에 있는 도른 플레인스토커에게 로크알림의 파편을 가져가야 합니다.‡Llévale fragmentos de Rok\'Alim a Dorn Acechallanos, que está en Las Mil Agujas.‡Llévale fragmentos de Rok\'Alim a Dorn Acechallanos, que está en Las Mil Agujas.‡Apporter des Fragments de Rok\'Alim à Dorn Traqueur-des-plaines dans les Mille pointes.‡把罗卡里姆的碎片交给千针石林的多恩·平原行者。‡把羅卡里姆的碎片交給千針石林的多恩·平原巡者。',
  }
},
[1152] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Encontre Braug Espírito Turvo perto da entrada do Túnel Garracava, na Cordilheira das Torres de Pedra.‡Найдите Брауга Тусклый Дух возле входа в Туннель Когтя в Когтистых горах.‡Sucht Braug Dämmergeist in der Nähe des Eingangs zum Steinkrallenpfad im Steinkrallengebirge.‡돌발톱 산맥에 있는 돌발톱 토굴길 입구 근처에서 브라우그 딤스피릿을 찾아야 합니다.‡Encuentra a Braug Espíritu Tenue cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Encuentra a Braug Espíritu Tenue cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Trouver Braug Esprit-troublé près de l\'entrée de la Perce des Serres dans les Serres-Rocheuses.‡找到连接石爪山和灰谷的石爪小径里的布劳格·幽魂。‡找到連接石爪山和梣谷的深爪小徑裡的布勞格·幽魂。',
  }
},
[1153] = {
  {
    'Uma nova amostra de minério‡Образец новой руды‡Eine neue Erzprobe‡새로운 광석 견본‡Una nueva muestra de mineral‡Una nueva muestra de mineral‡Un nouveau minerai‡新的矿石样本‡新的礦石樣本',
    nil,
    'Obtenha uma Amostra Não Refinada de Minério de um Escavador Britanapa ou de um Topógrafo e leve para Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Отберите неочищенный образец руды у землекопа или геодезиста из племени Камнерылов и принесите его Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Sucht eine unbearbeitete Erzprobe bei einem Buddler oder Feldmesser der Bruchschnauzen und bringt sie zu Tatternack Stahlformer im Camp Taurajo im Brachland.‡자갈주둥이일족 채굴꾼이나 흙점쟁이가 가지고 있는 정제하지 않은 광석 견본을 찾아 불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 가져가야 합니다.‡Arrebátale una muestra bruta de mena a un cavador o a un cavador Gravamorro y llévasela a Jironack Forjacero al Campamento Taurajo de Los Baldíos.‡Arrebátale una muestra bruta de mena a un cavador o a un perito Gravamorro y llévasela a Jironack Forjacero al Campamento Taurajo de Los Baldíos.‡Trouver un échantillon de minerai brut sur un Mineur ou un Géomètre Mufle-de-gravier et l\'apporter à Tatternack Forgacier, au Camp Taurajo dans les Tarides.‡从砂齿掘地工或砂齿勘探员那里找一块未精炼的矿石样本，把它交给陶拉祖营地的塔特纳克·钢炉。‡從砂齒掘地工或砂齒勘探員那裡找一塊未精煉的礦石樣本，把它交給陶拉祖營地的塔特納克·鋼爐。',
  }
},
[1154] = {
  {
    'Teste de saber‡Испытание знаний‡Test der Lehre‡지혜의 시험‡Prueba de conocimiento‡Prueba de conocimiento‡L\'épreuve de la Connaissance‡知识试炼‡知識試煉',
    nil,
    'Encontre o Legado dos Aspectos e leve-o para Braug Espírito Turvo perto da entrada do Túnel Garracava, na Cordilheira das Torres de Pedra.‡Найдите книгу "Наследие Аспектов" и вернитесь к Браугу Тусклому Духу ко входу в Туннель Когтя.‡Sucht das \'Vermächtnis der Aspekte\' und bringt es zu Braug Dämmergeist in der Nähe des Eingangs zum Steinkrallenpfad im Steinkrallengebirge zurück.‡고대의 유산을 찾아 돌발톱 산맥에 있는 돌발톱 토굴길 입구 근처에서 브라우그 딤스피릿에게 가져가야 합니다.‡Encuentra el Legado de los Aspectos y devuélveselo a Braug Espíritu Tenue que se encuentra cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Encuentra el Legado de los Aspectos y devuélveselo a Braug Espíritu Tenue que se encuentra cerca de la entrada de El Paso del Espolón en Sierra Espolón.‡Trouver l\'Héritage des Aspects et l\'apporter à Braug Esprit-troublé, à côté de l\'entrée de la Perce des Serres, dans les Serres-Rocheuses.‡找到《巨龙的遗产》，把它还给位于灰谷和石爪山之间的石爪小径里的布劳格·幽魂。‡找到《守護巨龍的遺產》，把它還給位於梣谷和石爪山之間的深爪小徑裡的布勞格·幽魂。',
  }
},
