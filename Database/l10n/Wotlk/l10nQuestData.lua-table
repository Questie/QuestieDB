[7427] = {
  {
    '‡Разыскивается: БОЛЬШЕ ДВОРФОВ!‡GESUCHT: MEHR ZWERGE‡‡Se buscan: ¡MÁS ENANOS!‡Se buscan: ¡MÁS ENANOS!‡On recherche: PLUS DE NAINS!‡通缉：更多矮人！‡',
