    nil,
  }
},
[8744] = {
  {
    'Um presente cuidadosamente embrulhado‡Тщательно завернутый подарок‡Ein sorgfältig verpacktes Geschenk‡정성스럽게 포장된 선물꾸러미‡Un presente envuelto con cuidado‡Un presente envuelto con cuidado‡Un cadeau soigneusement emballé‡精心包裹的礼物‡仔細包裝的禮物',
