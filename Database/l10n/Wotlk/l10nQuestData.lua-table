[13501] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[13502] = {
  {
    'A cesta de Jardinova‡Что вам надо? Шоколада!‡Einen Korb bekommen!‡소쿠리, 광주리, 귀족의 정원 바구니‡¿Qué llevas en la cestita?‡¿Qué llevas en la cestita?‡Mettez tous vos œufs dans ce panier‡巧克力甜又甜，全都装进彩蛋篮‡滴搭滴，貴族花園籃',
    nil,
    'O Comerciante de Jardinova quer que você colete 10 Chocolates de Jardinova e os entregue junto com a Cesta de Ovos.‡Соберите 10 праздничных шоколадных яиц и отдайте их продавцу Сада чудес вместе с корзиной для яиц.‡Der Nobelgartenverkäufer möchte, dass Ihr 10 Nobelgartenschokoladen sammelt und ihm zusammen mit dem Eierkorb zurückbringt.‡귀족의 정원 초콜릿 10개를 알 바구니와 함께 귀족의 정원 상인에게 가져가야 합니다.‡El vendedor del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves con la cesta de huevos.‡El vendedor del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves con la cesta de huevos.‡Le Vendeur du Jardin des nobles vous demande de ramasser 10 Chocolats du Jardin des nobles et de les lui rapporter, ainsi que le Panier à œufs.‡复活节小贩要你收集10块复活节巧克力，将它们和彩蛋篮一起带回来。‡貴族花園商販要你收集10個貴族花園巧克力，並帶著蛋籃回去找他。',
  }
},
[13503] = {
  {
    'A cesta de Jardinova‡Что вам надо? Шоколада!‡Einen Korb bekommen!‡소쿠리, 광주리, 귀족의 정원 바구니‡¿Qué llevas en la cestita?‡¿Qué llevas en la cestita?‡Mettez tous vos œufs dans ce panier‡巧克力甜又甜，全都装进彩蛋篮‡滴搭滴，貴族花園籃',
    nil,
    'O Mercador de Jardinova quer que você colete 10 Chocolates de Jardinova e os entregue junto com a Cesta de Ovos.‡Соберите 10 праздничных шоколадных яиц и отдайте их торговцу Сада чудес вместе с корзиной для яиц.‡Der Nobelgartenhändler möchte, dass Ihr 10 Nobelgartenschokoladen sammelt und ihm zusammen mit dem Eierkorb zurückbringt.‡귀족의 정원 초콜릿 10개를 알 바구니와 함께 귀족의 정원 판매원에게 가져가야 합니다.‡El mercader del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves con la cesta de huevos.‡El mercader del Jardín Noble quiere que reúnas 10 chocolates del Jardín Noble y que se los lleves con la cesta de huevos.‡Le Marchand du Jardin des nobles vous demande de ramasser 10 Chocolats du Jardin des nobles et de les lui rapporter, ainsi que le Panier à œufs.‡复活节商人要你收集10块复活节巧克力，将它们和彩蛋篮一起带回来。‡貴族花園商人要你收集10個貴族花園巧克力，並帶著蛋籃回去找他。',
  }
},
[13524] = {
  {
    'Escape from Silverbrook‡Побег из Среброречья‡Flucht aus Silberwasser‡은빛시내 마을 탈출‡Huye de Arroyoplata‡Huye de Arroyoplata‡L\'évasion de Ruissargent‡逃离银溪镇‡逃離銀溪鎮',
    nil,
    'Open the Wooden Cage and help the Freed Alliance Scout escape from Silverbrook. Report to Lieutenant Dumont when you reach Amberpine Lodge.‡Откройте деревянную клетку и помогите освобожденному разведчику Альянса сбежать из Среброречья. Доложитесь лейтенанту Думонту по прибытии в Приют Янтарной Сосны.‡Öffnet den hölzernen Käfig und helft dem befreiten Späher der Allianz, aus Silberwasser zu entkommen. Meldet Euch bei Leutnant Dumont, sobald Ihr die Ammertannhütte erreicht habt.‡나무 우리를 연 다음, 풀려난 얼라이언스 정찰병이 은빛시내 마을에서 탈출할 수 있도록 도와야 합니다. 호박빛소나무 오두막에 도착하면 부관 듀몬트에게 보고하십시오.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Ouvrez la Cage en bois et aidez l\'Éclaireur de l\'Alliance libéré à s\'échapper de Ruissargent. Présentez-vous au Lieutenant Dumont quand vous aurez atteint le Gîte Ambrepin.‡打开木笼，帮助联盟斥候逃出银溪镇。抵达琥珀松木营地后向杜蒙特中尉汇报情况。‡打開木籠，然後幫助獲釋的聯盟斥候逃離銀溪鎮。當你抵達琥珀松小屋之後，向都蒙特中尉報告。',
  }
},
[13538] = {
  {
    'Sabotagem ao sul‡Южный саботаж‡Sabotage aus dem Süden‡남쪽의 방해 공작‡Sabotaje al sur‡Sabotaje al sur‡Sabotage au sud‡南部的塔楼‡南方破壞工作',
    nil,
    'Destrua o Mirante Negro, a Torre da Guarda Ígnea ou a Torre da Borda Invernal e fale novamente com o Oficial Tático Ahbramis em Invérnia.‡Уничтожьте башню Темного Взора, башню Огненного Дозора или башню Клинка Зимы, а затем вернитесь к офицеру-стратегу Абрамису на Озере Ледяных Оков.‡Zerstört den Schattenblickturm, den Flammenaugenturm oder den Wintersturzturm und kehrt zu Taktikoffizier Ahbramis in Tausendwinter zurück.‡그늘눈 경비탑이나 불꽃감시 경비탑 또는 겨울 칼날 경비탑을 파괴한 후 겨울손아귀에 있는 전술장교 아브라미스에게 돌아가야 합니다.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Ahbramis en Conquista del Invierno.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Ahbramis en Conquista del Invierno.‡Détruisez la Tour d\'Ombrevue, la Tour Guetteflamme ou la Tour Bornehiver, puis retournez voir l\'Officier tactique Ahbramis à Joug-d\'hiver.‡摧毁影目塔楼、火光塔楼或冬缘塔楼，然后向冬拥湖的参谋官安布拉米斯复命。‡摧毀影景哨塔、焰望哨塔或冬際哨塔，然後向冬握湖的戰術軍官阿布拉米斯回報。',
  }
},
[13539] = {
  {
    'A derrubada das torres‡Свержение башен‡Einstürzende Turmbauten‡경비탑 무너뜨리기‡Derribar las torres‡Derribar las torres‡Abattre les tours‡摧毁塔楼‡推倒哨塔',
    nil,
    'Destrua o Mirante Negro, a Torre da Guarda Ígnea ou a Torre da Borda Invernal e fale novamente com o Oficial Tático Kilrath em Invérnia.‡Уничтожьте башню Темного Взора, башню Огненного Дозора или башню Клинка Зимы, затем вернитесь к офицеру-стратегу Килрату.‡Zerstört den Schattenblickturm, den Flammenaugenturm oder den Wintersturzturm und kehrt zu Taktikoffizier Kilrath in Tausendwinter zurück.‡그늘눈 경비탑이나 불꽃감시 경비탑 또는 겨울 칼날 경비탑을 파괴한 후 겨울손아귀에 있는 전술장교 킬라스에게 돌아가야 합니다.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno.‡Destruye la Torre de la Vista de las Sombras, la Torre de la Guardia en Llamas o la Torre Filoinvierno y vuelve a ver al oficial de táctica Kilrath en Conquista del Invierno.‡Détruisez la Tour d\'Ombrevue, la Tour Guetteflamme ou la Tour Bornehiver, puis retournez voir l\'Officier tactique Kilrath à Joug-d\'hiver.‡摧毁影目塔楼、火光塔楼或冬缘塔楼，然后向冬拥湖的参谋官基尔拉斯复命。‡摧毀影景哨塔、焰望哨塔或冬際哨塔，然後向冬握湖的戰術軍官科伊瑞斯回報。',
  }
},
[13548] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[13549] = {
  {
    'Caudas para cima!‡Хвост трубой‡Männchen oder Weibchen?‡꼬리를 들춰라‡Arriba la cola‡Arriba la cola‡Haut les queues !‡拎尾巴‡驗明正身',
    nil,
    'O Cronista To\'kini, em Zim\'Torga, quer que você use a Zarabatana de To\'kini nos Leopardos Glaciais e nos Ursos Pata de Gelo. Retorne com 3 fêmeas de cada.‡По просьбе летописца То\'кини из Зим\'Торги усыпляйте из воздушного ружья То\'кини северных леопардов и ледолапых медведей. Возвращайтесь к нему, поймав по три самки каждого вида.‡Chronist To\'kini in Zim\'Torga möchte, dass Ihr mit To\'kinis Blasrohr Frostleoparden und Eispfotenbären einschläfert. Kehrt mit jeweils 3 Weibchen zu ihm zurück.‡짐토르가에 있는 기록가 토키니가 서리 표범과 얼음발 곰에게 토키니의 바람총을 사용해 암컷을 3마리씩 구해 돌아와 달라고 부탁했습니다.‡El cronista To\'kini en Zim\'Torga quiere que utilices la cerbatana de To\'kini sobre leopardos de escarcha y osos Patahielo. Vuelve con tres hembras de cada especie.‡El cronista To\'kini en Zim\'Torga quiere que utilices la cerbatana de To\'kini sobre leopardos de escarcha y osos Patahielo. Vuelve con tres hembras de cada especie.‡Le Chroniqueur To\'kini, à Zim\'Torga, vous demande d\'utiliser la Sarbacane de To\'kini sur des Léopards de givre et des Ours Patteglace. Retournez le voir quand vous aurez 3 Femelles de chaque.‡希姆托加的记载者图基尼希望你对冰霜豹和冰爪熊使用麻醉飞镖，并给他带回三头雌性冰霜豹和三头雌性冰爪熊。‡辛托加的撰史者托基尼要你對霜豹和冰掌熊使用托基尼的吹箭。把兩種雌獸各3隻帶回來給他。',
  }
},
[13556] = {
  {
    'Ovos para Dubra\'Jin‡Яйца для Дубра\'джина‡Eier für Dubra\'Jin‡두브라진은 알을 좋아해‡Huevos para Dubra\'Jin‡Huevos para Dubra\'Jin‡Des œufs pour Dubra\'Jin‡杜布拉金需要迅猛龙卵‡杜布拉金的蛋',
    nil,
    'Ha\'wana, em Dubra\'Jin, precisa que você colete 12 Ovos de Raptor de Gundrak.‡Соберите 12 яиц ящера Гундрака по заданию Га\'ваны из Дубра\'джина.‡Ha\'wana in Dubra\'Jin möchte, dass Ihr 12 Raptoreier von Gundrak sammelt.‡두브라진에 있는 하와나가 군드락 랩터 알 12개를 모아 달라고 부탁했습니다.‡Ha\'wana en Dubra\'Jin necesita que recojas 12 huevos de raptor de Gundrak.‡Ha\'wana en Dubra\'Jin necesita que recojas 12 huevos de raptor de Gundrak.‡Ha\'wana, à Dubra\'Jin, vous demande de trouver 12 Œufs de raptor de Gundrak.‡杜布拉金的哈瓦纳希望你去收集12枚古达克迅猛龙卵。‡杜布拉金的哈瓦那要你收集12個剛德拉克迅猛龍蛋。',
  }
},
[13559] = {
  {
    'Tributo a Hodir‡Подношение Ходиру‡Hodirs Tribut‡호디르께 공물을‡El tributo de Hodir‡El tributo de Hodir‡Un tribut à Hodir‡霍迪尔的供品‡霍迪爾的祭禮',
    nil,
    nil,
  }
},
[13571] = {
  {
    'A marvada‡Бюро находок Флетчера‡Fletchers Fundbüro‡주정뱅이 유실물 보관소‡Objetos perdidos de Flechero‡Objetos perdidos de Flechero‡Aux objets trouvés de Fletcher‡失而复得‡伏萊齊的失物招領',
    nil,
    nil,
  }
},
[13592] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию сэра Маркуса Барлоу из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Sir Marcus Barlow beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 마커스 발로 경이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Sir Marcus Barlowe en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sir Marcus Barlowe en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sire Marcus Barlowe, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的马库斯·巴洛爵士要你消灭10名被转化的英雄。‡',
  }
},
[13593] = {
  {
    '‡Искатель славы из Штормграда‡Recke von Sturmwind‡‡Valeroso de Ventormenta‡Valeroso de Ventormenta‡Vaillant de Hurlevent‡暴风城的勇士‡暴風城驍士',
    nil,
    '‡Если вы хотите стать искателем славы Штормграда, поговорите еще раз с маршалом Якобом Алерием в Павильоне Серебряного союза.‡Sprecht wieder mit Marschall Jacob Alerius, falls Ihr ein Recke von Sturmwind werden wollt.‡‡Habla con el mariscal Jacob Alerius de nuevo si quieres convertirte en $Gun Valeroso:una Valerosa; de Ventormenta.‡Habla con el mariscal Jacob Alerius de nuevo si quieres convertirte en $Gun Valeroso:una Valerosa; de Ventormenta.‡Parlez à nouveau au Maréchal Jacob Alerius si vous voulez devenir $Gun vaillant:une vaillante; de Hurlevent.‡‡',
  }
},
[13600] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара маршалу Якобу Алерию в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Marschall Jacob Alerius beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的雅克布·奥勒留斯元帅。‡',
  }
},
[13603] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его маршалу Якобу Алерию в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Marschall Jacob Alerius beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al mariscal Jacob Alerius en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的雅克布·奥勒留斯元帅。‡',
  }
},
[13604] = {
  {
    'Disco de Dados do Archivum‡Диск доступа к Архиву‡Datenscheibe des Archivums‡고대 기록관 자료 원반‡Disco de datos de El Archivum‡Disco de datos de El Archivum‡Le disque de données de l\'Archivum‡档案馆数据圆盘‡大資料庫資料圓盤',
    nil,
    'Leve o Disco de Dados do Archivum ao Console do Archivum em Ulduar.‡Отнесите диск доступа к Архиву к панели управления Архивом в Ульдуаре.‡Bringt die Datenscheibe des Archivums zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 고대 기록관 자료 원반을 가져가야 합니다.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Apportez le Disque de données de l\'Archivum à la Console de l\'Archivum dans Ulduar.‡将档案馆数据圆盘带到奥杜尔的档案馆控制台前。‡將大資料資料取圓盤帶到奧杜亞的大資料庫控制臺。',
  }
},
[13606] = {
  {
    '‡Печать Фрейи‡Freyas Siegel‡프레이야의 인장‡El sigilo de Freya‡El sigilo de Freya‡Le cachet de Freya‡弗蕾亚的徽记‡芙蕾雅的符印',
    nil,
    '‡Добудьте печать Фрейи по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Freyas Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Freyas Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 프레이야의 인장을 가져와 달라고 했습니다.|n|n프레이야의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Freya.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将弗蕾亚的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得弗蕾亚的徽记。‡',
  }
},
[13607] = {
  {
    '‡Священный планетарий‡Das Himmlische Planetarium‡별자리 투영관‡El Planetario Celestial‡El Planetario Celestial‡Le planétarium céleste‡天文台‡星穹渾天儀',
    nil,
    '‡Найдите Священный планетарий по заданию геолога Дорена из Архива в Ульдуаре.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr den Eingang zum Himmlischen Planetarium findet.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 별자리 투영관의 입구를 찾아 달라고 했습니다.‡El prospector Doren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡El prospector Doren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé de trouver l\'entrée du Planétarium céleste.‡奥杜尔档案馆中的勘探员多尔伦要你找到天文台的入口。‡',
  }
},
[13609] = {
  {
    '‡Печать Ходира‡Hodirs Siegel‡호디르의 인장‡El sigilo de Hodir‡El sigilo de Hodir‡Le cachet de Hodir‡霍迪尔的徽记‡霍迪爾的符印',
    nil,
    '‡Добудьте печать Ходира по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Hodirs Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Hodirs Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 호디르의 인장을 가져와 달라고 했습니다.|n|n호디르의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Hodir.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将霍迪尔的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得霍迪尔的徽记。‡',
  }
},
[13610] = {
  {
    '‡Печать Торима‡Thorims Siegel‡토림의 인장‡El sigilo de Thorim‡El sigilo de Thorim‡Le cachet de Thorim‡托里姆的徽记‡索林姆的符印',
    nil,
    '‡Добудьте печать Торима по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Thorims Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Thorims Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 토림의 인장을 가져와 달라고 했습니다.|n|n토림의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Thorim.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将托里姆的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得托里姆的徽记。‡',
  }
},
[13611] = {
  {
    '‡Печать Мимирона‡Mimirons Siegel‡미미론의 인장‡El sigilo de Mimiron‡El sigilo de Mimiron‡Le cachet de Mimiron‡米米尔隆的徽记‡彌米倫的符印',
    nil,
    '‡Добудьте печать Мимирона по заданию геолога Дорена.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Mimirons Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Mimirons Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 도렌이 미미론의 인장을 가져와 달라고 했습니다.|n|n미미론의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Doren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡Le Prospecteur Doren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Mimiron.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将米米尔隆的徽记交给奥杜尔档案馆中的勘探员多尔伦。|n|n你可以向档案馆控制台查询如何获得米米尔隆的徽记。‡',
  }
},
[13614] = {
  {
    '‡Алгалон‡Algalon‡알갈론‡Algalon‡Algalon‡Algalon‡奥尔加隆‡艾爾加隆',
    nil,
    '‡Принесите печати хранителей к панели управления Архивом в Ульдуаре.‡Bringt die Siegel der Wächter zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 감시자의 인장 묶음을 가져가야 합니다.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Apportez les Cachets des guetteurs à la Console de l\'Archivum d\'Ulduar.‡‡',
  }
},
[13616] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Маршал Якоб Алерий из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Marschall Jacob Alerius beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스가 겨울 칼날을 가져다 달라고 했습니다.‡El mariscal Jacob Alerius en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El mariscal Jacob Alerius en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Le Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的雅克布·奥勒留斯元帅。‡',
  }
},
[13622] = {
  {
    'História antiga‡Древняя история‡Uralte Geschichten‡고대사‡Historia antigua‡Historia antigua‡De l\'histoire ancienne‡远古的历史‡上古史',
    nil,
    'Leve os Fragmentos Estilhaçados de Val\'anyr ao Console do Archivum em Ulduar.‡Принесите расколотый Вал\'анир к панели управления в Архив Ульдуара.‡Bringt die zerschmetterten Fragmente von Val\'anyr zur Archivumkonsole im Archivum in Ulduar.‡울두아르의 고대 기록관 조작대에 부서진 발아니르 조각을 가져가야 합니다.‡Lleva los fragmentos rotos de Val\'anyr a la consola de El Archivum en El Archivum de Ulduar.‡Lleva los fragmentos rotos de Val\'anyr a la consola de El Archivum en El Archivum de Ulduar.‡Apportez les Fragments brisés de Val\'anyr à la Console de l\'Archivum, à l\'Archivum, dans Ulduar.‡将瓦兰奈尔的碎片拿到奥杜尔的档案馆控制台那里去。‡將破裂的瓦蘭尼珥碎片帶給奧杜亞大資料庫的大資料庫控制臺。',
  }
},
[13625] = {
  {
    '‡Большая тренировка‡Reitgrundlagen‡고삐 다루는 법 익히기‡Aprende a llevar las riendas‡Aprende a llevar las riendas‡Sachez tenir vos rênes‡学习骑战‡學習駕馭',
    nil,
    '‡Отработайте прием "Выпад" 5 раз на манекене для ближнего боя, прием "Удар по щиту" 2 раза на мишени для дальнего боя и прием "Рывок" 2 раза на манекене для стремительной атаки, затем вернитесь к разведчице Шалиндрии на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Trefft ein Nahkampfziel fünfmal mit der Fähigkeit "Zustoßen" und wendet die Fähigkeit "Schildbrecher" auf 2 ungeschützte Distanzziele sowie die Fähigkeit "Sturmangriff" auf 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Späherin Shalyndria beim Argentumturnierplatz zurück.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡근접 표적에 찌르기를 5번 사용하고, 약해진 원거리 표적 2개에 방패 부수기를 사용하고, 약해진 돌진 표적 2개에 돌진을 사용한 후 은빛십자군 마상시합 광장의 정찰병 샬린드리아에게 가야 합니다.|n|n창을 잃어버리면 마구간 근처의 아무 창 선반이나 은빛 서약단 막사에서 다른 창을 얻을 수 있습니다.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Frappez 5 fois une Cible de mêlée avec un Coup de lance, utilisez 2 fois un Brise-bouclier sur des Cibles à distance vulnérables, utilisez 2 fois la Charge sur des Cibles de charge vulnérables, puis retournez voir l\'Eclaireur Shalyndria dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡使用刺击技能攻击一个近战目标5次，使用碎盾技能攻击2个脆弱的远程目标，使用冲锋技能攻击2个脆弱的冲锋目标，然后回到银色比武场，向斥候沙琳蒂亚复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13627] = {
  {
    '‡Откуда дровишки?‡Wie die Axt im Walde‡불법 벌채‡Agénciame unos maderos‡Agénciame unos maderos‡Allez bûcher un peu…‡砍木头‡幫我盜伐一些木材',
    nil,
    '‡Принесите 12 грубо обтесанных досок Беззлу Рвизасову на Ристалище Серебряного турнира.‡Bringt 12 grob gehauene Bauhölzer zu Stumpi Sprengbolz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장의 베즐 블라스트볼트에게 거칠게 잘라낸 나무판자 12개를 가져가야 합니다.‡Llévale 12 tablones sin rematar a Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Llévale 12 tablones sin rematar a Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Apportez 12 Planches grossièrement taillées à Gaspi Boumboulon dans l\'Enceinte du tournoi d\'Argent.‡把12块做工粗糙的木板交给银色比武场的贝兹尔·布拉斯波。‡',
  }
},
[13629] = {
  {
    '‡Вал\'анир, молот древних королей‡Val\'anyr, Hammer der Uralten Könige‡발아니르 - 고대 왕의 망치‡Val\'anyr, Martillo de los antiguos reyes‡Val\'anyr, Martillo de los antiguos reyes‡Val\'anyr, le marteau des anciens rois‡瓦兰奈尔，远古王者之锤‡瓦蘭尼珥，遠古諸王之錘',
    nil,
    '‡Бросьте расколотый Вал\'анир в пасть Йогг-Сарона во время "Оглушающего рева" и победите его, чтобы получить перекованный молот древних королей.|n|nЭто задание можно пройти только в героическом режиме и только в том случае, если хотя бы один из хранителей Ульдуара не помогает вам.‡Werft die zerschmetterten Teile von Val\'anyr in Yogg-Sarons Schlund, während er den Zauber \'Ohrenbetäubendes Gebrüll\' wirkt, und vernichtet ihn, um den neugeschmiedeten Hammer der Uralten Könige zu erhalten.|n|nDies kann nur auf dem Schwierigkeitsgrad "Heroisch" beendet werden und nur dann, wenn Ihr von maximal drei Wächtern von Ulduar unterstützt werdet.‡귀청이 터질듯한 포효를 시전하는 요그사론의 입속에 부서진 발아니르 조각을 던져넣고 그를 쓰러뜨려, 고대 왕의 재련된 망치를 회수해야 합니다.|n|n영웅 난이도에서 울두아르 감시자 셋 이하에게만 도움을 받아야 이 퀘스트를 완료할 수 있습니다.‡Lanza los fragmentos rotos de Val\'anyr a las fauces de Yogg-Saron mientras lanza Rugido ensordecedor y derrota a Yogg-Saron para recuperar el Martillo reforjado de los antiguos reyes.|n|nEsto solo puede hacerse en modo Heroico y solo si al menos un vigía de Ulduar no te está ayudando.‡Lanza los fragmentos rotos de Val\'anyr a las fauces de Yogg-Saron mientras lanza Rugido ensordecedor y derrota a Yogg-Saron para recuperar el Martillo reforjado de los antiguos reyes.|n|nEsto solo puede hacerse en modo Heroico y solo si al menos un vigía de Ulduar no te está ayudando.‡Lancez les Fragments brisés de Val\'anyr dans la gueule de Yogg-Saron pendant qu\'il lance un Rugissement assourdissant et triomphez de lui pour récupérer le Marteau des anciens rois reforgé.|n|nCette quête ne peut être accomplie qu\'en mode héroïque, et seulement si au moins l\'un des Gardiens d\'Ulduar ne vous aide pas.‡在尤格-萨隆发出震耳咆哮时，将瓦兰奈尔的碎片投入尤格-萨隆张开的嘴中，然后击败尤格-萨隆，获得重铸的远古王者之锤。|n|n只能在英雄模式下完成，且至少需要有一位奥杜尔的守护者没有协助你。‡',
  }
},
[13631] = {
  {
    'Tudo está bem quando termina bem‡Все хорошо, что хорошо кончается‡Ende gut, alles gut‡끝이 좋으면 다 좋다‡Bien está lo que bien acaba‡Bien está lo que bien acaba‡Tout est bien qui finit bien‡结果好，一切都好‡情況良好，完美收場',
    nil,
    'Leve o Código de Resposta Alfa para Rhonin em Dalaran.‡Доставьте код отклика "Альфа" Ронину в Даларан.‡Überbringt Rhonin in Dalaran den Antwortcode Alpha.‡응답 코드 알파를 달라란에 있는 로닌에게 가져가야 합니다.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Apportez le Code-réponse Alpha à Rhonin, à Dalaran.‡将回复代码阿尔法交给达拉然的罗宁。‡將回覆代碼Α帶給達拉然的羅甯。',
  }
},
[13633] = {
  {
    '‡Черный рыцарь из Западного Края?‡Der schwarze Ritter von Westfall?‡서부 몰락지대의 흑기사?‡¿El Caballero Negro de los Páramos de Poniente?‡¿El Caballero Negro de los Páramos de Poniente?‡Le Chevalier noir de la marche de l\'Ouest?‡西部荒野的黑骑士？‡西部荒野的黑騎士？',
    nil,
    '‡Узнайте правду о Черном рыцаре и поделитесь информацией с рыцарем Райдаллой на ристалище Серебряного турнира.‡Überprüft die Angaben des Schwarzen Ritters und kehrt mit den Informationen zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz zurück.‡흑기사의 주장이 사실인지 조사하고 나서, 은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 결과를 알려야 합니다.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Menez une enquête sur les déclarations du Chevalier noir, puis rapportez vos découvertes à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡调查黑骑士的身世是否属实，然后回到银色比武场，向北伐军战士莱达拉汇报你的发现。‡',
  }
},
[13634] = {
  {
    '‡Черный рыцарь из Серебряного бора?‡Der schwarze Ritter von Silberwald?‡은빛소나무 숲의 흑기사?‡¿El Caballero Negro del Bosque de Argénteos?‡¿El Caballero Negro del Bosque de Argénteos?‡Le Chevalier noir des Pins-Argentés?‡银松森林的黑骑士？‡銀松的黑騎士？',
    nil,
    '‡Узнайте правду о Черном рыцаре и поделитесь информацией с рыцарем Райдаллой на ристалище Серебряного турнира.‡Überprüft die Angaben des Schwarzen Ritters und kehrt mit den Informationen zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz zurück.‡흑기사의 주장이 사실인지 조사하고 나서, 은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 결과를 알려야 합니다.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Investiga la afirmación del Caballero Negro y vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta con lo que hayas descubierto.‡Menez une enquête sur les déclarations du Chevalier noir, puis rapportez vos découvertes à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡调查黑骑士的身世是否属实，然后回到银色比武场，向北伐军战士莱达拉汇报你的发现。‡',
  }
},
[13641] = {
  {
    '‡Кристалл провидца‡Der Seherkristall‡예언자의 수정‡El cristal de vidente‡El cristal de vidente‡Le cristal de voyant‡先知的水晶‡先知水晶',
    nil,
    '‡Принесите кристалл провидца рыцарю Райдалле в Серебряный павильон на Ристалище Серебряного турнира.‡Bringt einen Seherkristall zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 예언자의 수정을 가져가야 합니다.‡Llévale un cristal de vidente a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Llévale un cristal de vidente a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Apportez un Cristal de voyant à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡将一块先知的水晶交给银色比武场的北伐军战士莱达拉。‡',
  }
},
[13643] = {
  {
    '‡История погибших‡Die Geschichten toter Männer‡죽은 자의 이야기‡Historias que cuentan los muertos‡Historias que cuentan los muertos‡Ce dont les morts peuvent parler‡死者讲述的故事‡死者的故事',
    nil,
    '‡Воспользуйтесь кристаллом провидца перед могилами сэра Венделла Балфура, Лориена Блеска Солнца и Коналла Железной Хватки, узнайте причину их гибели и доложите рыцарю Райдалле из Серебряного павильона.‡Benutzt den Seherkristall an den Gräbern von Sir Wendell Balfour, Lorien Sonnenfeuer und Conall Eisengriff, um herauszufinden, wie sie gestorben sind, und kehrt anschließend zu Kreuzfahrerin Rhydalla zurück.‡웬델 발포어 경, 로리엔 선블레이즈, 코날 아이언그립의 무덤에서 예언자의 수정을 사용해 그들이 어떻게 죽었는지 알아보고 나서, 성전사 라이달라에게 가야 합니다.‡Usa el cristal de vidente en las tumbas de Sir Wendell Balfour, Lorien Resplandor y Conall Empuñadura de Hierro para determinar la causa de su muerte, luego vuelve a ver a la cruzada Rhydalla.‡Usa el cristal de vidente en las tumbas de Sir Wendell Balfour, Lorien Resplandor y Conall Empuñadura de Hierro para determinar la causa de su muerte, luego vuelve a ver a la cruzada Rhydalla.‡Utilisez le Cristal de voyant devant les Tombes de Sire Wendell Balfour, Lorien Solembrase et Connall Poigne-de-fer afin de comprendre comment ils sont morts, puis retournez voir la Croisée Rhydalla.‡在温德尔·巴尔弗爵士、洛林·阳焰和康纳尔·铁拳的坟墓前使用先知的水晶，查出他们死亡的真相，然后将结果报告给北伐军战士莱达拉。‡',
  }
},
[13649] = {
  {
    'Justin\'s Fun Test‡Веселая проверка Джастина‡Justins spaßiger Test‡저스틴의 즐거운 테스트‡La prueba de la diversión de Justin‡Justin\'s Fun Test‡Le test marrant de Justin‡Justin\'s Fun Test‡賈斯汀的趣味測試',
    nil,
    'Use the Complimentary Brewfest Sampler to hit S.T.O.U.T. 5 times, then talk to Boxey Boltspinner.‡Попадите кружкой с бесплатным пивом в С.С.М. 5 раз, затем поговорите с Бокси Болтокрутом.‡Benutzt den Freibierkrug, um A.L.K. fünfmal zu treffen, und sprecht dann mit Boxey Bolzdreher.‡시음용 가을 축제 맥주를 사용하여 주.정.뱅.이.를 5번 맞힌 후 복시 볼트스피너와 대화해야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utilisez le Taste-bière cadeau pour toucher la C.E.R.V.O.I.S.E. 5 fois, puis revenez parler à Boxey Tournécrou.‡Use the Complimentary Brewfest Sampler to hit S.T.O.U.T. 5 times, then talk to Boxey Boltspinner.‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和博克西·栓旋者談談。',
  }
},
[13654] = {
  {
    '‡Странный оруженосец‡Etwas ist mit dem Knappen‡흑기사의 종자에겐 뭔가 특별한 것이 있다‡Algo pasa con el escudero‡Algo pasa con el escudero‡Le manège de l\'écuyer‡怪异的侍从‡',
    nil,
    '‡Добудьте большую бедренную кость дровосека-скелета и оглушите Малорика. Обыщите его и доложите обо всем рыцарю Райдалле из Серебряного павильона на Ристалище Серебряного турнира.‡Beschafft einen großen Oberschenkelknochen eines skelettierten Holzfällers und setzt damit Maloric außer Gefecht. Durchsucht ihn nach Beweisen und meldet Euch anschließend bei Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡해골 벌목꾼에게서 큰 다리뼈를 획득해 말로릭에게 사용해야 합니다. 말로릭을 조사해 증거를 찾아낸 후, 은빛십자군 마상시합 광장의 성전사 라이달라에게 보고해야 합니다.‡Consigue un fémur grande de un cortador de leña esquelético y úsalo para incapacitar a Maloric. Registra a Maloric en busca de pruebas, luego preséntate ante la cruzada Rhydalla en los Campos del Torneo Argenta.‡Consigue un fémur grande de un cortador de leña esquelético y úsalo para incapacitar a Maloric. Registra a Maloric en busca de pruebas, luego preséntate ante la cruzada Rhydalla en los Campos del Torneo Argenta.‡Procurez-vous un Grand fémur sur un Bûcheron squelettique, et utilisez-le pour assommer Maloric. Fouillez Maloric pour trouver des preuves, puis retournez faire votre rapport à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡从一个骷髅伐木工身上取下一根大腿骨，用它打昏玛洛里克。在玛洛里克身上搜查一番，找到证据后向银色比武场的北伐军战士莱达拉报告。‡',
  }
},
[13662] = {
  {
    'Conquistando a confiança‡Завоевать благосклонность‡Anerkennung erlangen‡인정받기‡Conseguir aceptación‡Conseguir aceptación‡Se faire accepter‡获得信任‡贏得認同',
    nil,
    nil,
  }
},
[13663] = {
  {
    '‡Приказы для Черного рыцаря‡Die Befehle des Schwarzen Ritters‡흑기사의 명령서‡Las órdenes del Caballero Negro‡Las órdenes del Caballero Negro‡Les ordres du Chevalier noir‡黑骑士的命令‡黑騎士的命令',
    nil,
    '‡Воспользуйтесь волшебной уздечкой, чтобы подчинить грифона Черного рыцаря и попасть к дому его хозяина. Как только вы попадете на место, найдите украденное приглашение на турнир и приказы для Черного рыцаря, после чего отнесите их рыцарю Райдалле в Серебряный павильон на Ристалище Серебряного Турнира.‡Erhaltet mithilfe des verzauberten Zaumzeugs Kontrolle über den Greifen des Schwarzen Ritters und reitet auf seinem Rücken zum Zielort. Beschafft Euch die gestohlene Einladung zum Turnier und die Befehle des Schwarzen Ritters, sobald Ihr dort angekommen seid, und bringt sie zurück zu Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡마력 깃든 고삐를 이용해 흑기사의 그리핀을 제압한 후, 목적지까지 타고 가십시오. 도착하면 도둑맞은 마상시합 초대장과 흑기사의 명령서를 입수해 은빛십자군 마상시합 광장의 성전사 라이달라에게 가져가야 합니다.‡Usa la brida encantada para controlar al grifo del Caballero Negro y que te lleve a su destino. Cuando llegues, coge la invitación para el torneo robada y las órdenes del Caballero Negro y llévaselas a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Usa la brida encantada para controlar al grifo del Caballero Negro y que te lleve a su destino. Cuando llegues, coge la invitación para el torneo robada y las órdenes del Caballero Negro y llévaselas a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Utilisez la Bride enchantée pour prendre le contrôle du Griffon du Chevalier noir et chevauchez-le vers sa destination. Une fois que vous y serez, récupérez l\'Invitation au tournoi volée et les Ordres du Chevalier noir, puis apportez-les à la Croisée Rhydalla dans l\'Enceinte du tournoi d\'Argent.‡使用魔法缰绳控制黑骑士的狮鹫，骑着它飞到目的地，然后找到被偷走的锦标赛邀请函和黑骑士的命令，并把它们带回银色比武场，交给北伐军战士莱达拉。‡',
  }
},
[13664] = {
  {
    '‡Падение Черного рыцаря‡Der Sturz des Schwarzen Ritters‡흑기사의 최후‡La caída del Caballero Negro‡La caída del Caballero Negro‡La chute du Chevalier noir‡黑骑士之死‡黑騎士之死',
    nil,
    '‡Одержите победу над Черным рыцарем, после чего поговорите с рыцарем Райдаллой в Серебряном павильоне на Ристалище Серебряного турнира.‡Besiegt den Schwarzen Ritter und sprecht anschließend mit Kreuzfahrerin Rhydalla beim Argentumturnierplatz.‡흑기사를 쓰러뜨린 후 은빛십자군 마상시합 광장에 있는 성전사 라이달라와 대화해야 합니다.‡Derrota al Caballero Negro y luego habla con la cruzada Rhydalla en los Campos del Torneo Argenta.‡Derrota al Caballero Negro y luego habla con la cruzada Rhydalla en los Campos del Torneo Argenta.‡Battez le Chevalier noir puis allez parler à la Croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent.‡击败黑骑士，然后向银色比武场的北伐军战士莱达拉复命。‡',
  }
},
[13665] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы капитану Джозефу Холли в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Hauptmann Joseph Holley beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 대장 조셉 홀리에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso al capitán Joseph Holley en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso al capitán Joseph Holley en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant au Capitaine Joseph Holley, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的约瑟夫·霍雷上尉。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13666] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его чародею Таэлису в шатер Альянса на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Arkanist Taelis beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al arcanista Taelis en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al arcanista Taelis en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的奥术师泰利斯。‡',
  }
},
[13667] = {
  {
    '‡Серебряный Турнир‡Das Argentumturnier‡은빛십자군 마상시합‡El Torneo Argenta‡El Torneo Argenta‡Le tournoi d\'Argent‡银色锦标赛‡銀白聯賽',
    nil,
    '‡Чтобы принять участие в турнире, поговорите с чародеем Таэлисом в шатре Альянса на Ристалище Серебряного турнира, он внесет ваше имя в списки.‡Sprecht mit Arkanist Taelis beim Argentumturnierplatz, um Euch für das Turnier anzumelden.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스와 대화하여 마상시합에 참여해야 합니다.‡Habla con el arcanista Taelis en los Campos del Torneo Argenta para inscribirte en el torneo.‡Habla con el arcanista Taelis en los Campos del Torneo Argenta para inscribirte en el torneo.‡Parlez à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, pour vous inscrire au tournoi.‡与银色比武场的奥术师泰利斯谈一谈，报名参加锦标赛。‡',
  }
},
[13668] = {
  {
    '‡Серебряный Турнир‡Das Argentumturnier‡은빛십자군 마상시합‡El Torneo Argenta‡El Torneo Argenta‡Le tournoi d\'Argent‡银色锦标赛‡銀白聯賽',
    nil,
    '‡Чтобы принять участие в турнире, поговорите с магистром Эдиеном Солнечной Низиной в шатре Орды на Ристалище Серебряного турнира, он внесет ваше имя в списки.‡Sprecht mit Magister Edien Sonnental beim Argentumturnierplatz, um Euch für das Turnier anzumelden.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우와 대화하고 마상시합에 참여해야 합니다.‡Habla con el magister Edien Vacuosol en los Campos del Torneo Argenta para inscribirte en el torneo.‡Habla con el magister Edien Vacuosol en los Campos del Torneo Argenta para inscribirte en el torneo.‡Parlez au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, pour vous inscrire au tournoi.‡与银色比武场的魔导师埃迪恩·炎谷谈一谈，报名参加锦标赛。‡',
  }
},
[13669] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара чародею Таэлису в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt die Klinge von Drak\'Mar zu Arkanist Taelis beim Argentumturnierplatz.‡드락마의 검을 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가져가야 합니다.‡Llévale la hoja de Drak\'Mar al arcanista Taelis en los Campos del Torneo Argenta.‡Llévale la hoja de Drak\'Mar al arcanista Taelis en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的的奥术师泰利斯。‡',
  }
},
[13670] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Чародей Таэлис из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Arkanist Taelis beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 신비술사 탤리스가 겨울 칼날을 가져다 달라고 했습니다.‡El arcanista Taelis en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El arcanista Taelis en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡L\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的奥术师泰利斯。‡',
  }
},
[13671] = {
  {
    '‡Тренировка на поле боя‡Feldübung‡전장에서 단련하기‡Instrucción en el campo‡Instrucción en el campo‡Entraînement sur le terrain‡实战训练‡實地訓練',
    nil,
    '‡Убейте 8 воинов Плети в Ледяной Короне по заданию Аварета Молниеносного Удара из Павильона Серебряного союза на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны, за исключением зоны бомбардировки.‡Avareth Flinkstoß beim Argentumturnierplatz möchte, dass Ihr 8 Diener der Geißel von Eiskrone tötet. Dazu zählen alle Diener der Geißel im Bereich von Eiskrone, abgesehen vom Bombardement.‡은빛십자군 마상시합 광장에 있는 아바레스 스위프트스트라이크가 얼음왕관 스컬지 8마리를 처치해 달라고 했습니다. 폭격지를 제외한 얼음왕관 전 지역에서 아무 스컬지나 처치하면 됩니다.‡Avareth Golpeveloz en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Avareth Golpeveloz en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Avareth Frappe-rapide, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 8 membres du Fléau de la Couronne de glace. Vous pouvez tuer des membres du Fléau partout dans la Couronne de glace, sauf au Bombardement.‡银色比武场的阿瓦雷斯·迅击要你在冰冠冰川地区消灭8名天灾军团士兵。除了轰炸场之外，在冰冠冰川的任何地方遇到的天灾都可以。‡',
  }
},
[13672] = {
  {
    '‡Подготовка к испытанию‡Der Herausforderung gewachsen‡도전에 맞서라‡A la altura del desafío‡A la altura del desafío‡Prêt pour le défi‡迎接挑战‡準備挑戰',
    nil,
    '‡Чтобы продемонстрировать свою готовность пройти испытание претендентов, покажите 15 печатей претендента чародею Таэлису из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Überreicht Arkanist Taelis beim Argentumturnierplatz 15 Siegel des Streiters, um zu zeigen, dass Ihr bereit seid, Euch der Herausforderung des Streiter zu unterziehen.‡지원자의 도전에 응할 준비가 되었음을 증명하기 위해, 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 지원자의 문장 15개를 가져가야 합니다.‡Entrégale al arcanista Taelis en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Entrégale al arcanista Taelis en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Apportez à l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent, 15 Sceaux d\'aspirant pour indiquer que vous souhaitez participer au Défi de l\'aspirant.‡将15枚候选者的徽记交给银色比武场的奥术师泰利斯，证明你已经准备好迎接候选者的挑战了。‡',
  }
},
[13673] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Magister Edien Sonnental beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 잿빛나무 검을 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的魔导师埃迪恩·炎谷。‡',
  }
},
[13674] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt die Klinge von Drak\'Mar zu Magister Edien Sonnental beim Argentumturnierplatz.‡드락마의 검을 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가져가야 합니다.‡Llévale la hoja de Drak\'Mar al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Llévale la hoja de Drak\'Mar al magister Edien Vacuosol en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的魔导师埃迪恩·炎谷。‡',
  }
},
[13675] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Магистр Эдиен Солнечная Низина из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Magister Edien Sonnental beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 겨울 칼날을 가져가야 합니다.‡El magister Edien Vacuosol en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡El magister Edien Vacuosol en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Le Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的魔导师埃迪恩·炎谷。‡',
  }
},
[13676] = {
  {
    '‡Тренировка на поле боя‡Feldübung‡전장에서 단련하기‡Instrucción en el campo‡Instrucción en el campo‡Entraînement sur le terrain‡实战训练‡實地訓練',
    nil,
    '‡Убейте 8 воинов Плети в Ледяной Короне по заданию Амариэля Верного Солнцу из Павильона Похитителей Солнца на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны, за исключением зоны бомбардировки.‡Amariel Sonnenschwur beim Argentumturnierplatz möchte, dass Ihr 8 Diener der Geißel von Eiskrone tötet. Dazu zählen alle Diener der Geißel im Bereich von Eiskrone, abgesehen vom Bombardement.‡은빛십자군 마상시합 광장에 있는 아마리엘 선스원이 얼음왕관 스컬지 8마리를 처치해 달라고 했습니다. 폭격지를 제외한 얼음왕관 전 지역에서 아무 스컬지나 처치하면 됩니다.‡Amariel Jurasol en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Amariel Jurasol en los Campos del Torneo Argenta quiere que mates a 8 miembros de la Plaga de Corona de Hielo. Puedes matar a los miembros de la Plaga en cualquier parte de Corona de Hielo excepto en El Bombardeo.‡Amariel Ligesol, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 8 membres du Fléau de la Couronne de glace. Vous pouvez tuer des membres du Fléau partout dans la Couronne de glace, sauf au Bombardement.‡银色比武场的阿玛里尔·火盟要你在冰冠冰川地区消灭8名天灾军团士兵。除了轰炸场之外，在冰冠冰川的任何地方遇到的天灾都可以。‡',
  }
},
[13677] = {
  {
    '‡Большая тренировка‡Reitgrundlagen‡고삐 다루는 법 익히기‡Aprende a llevar las riendas‡Aprende a llevar las riendas‡Sachez tenir vos rênes‡学习骑战‡學習駕馭',
    nil,
    '‡Отработайте прием "Выпад" 5 раз на манекене для ближнего боя, прием "Удар по щиту" 2 раза на мишени для дальнего боя и прием "Рывок" 2 раза на манекене для стремительной атаки, затем вернитесь к Галатии Сияющий Рассвет в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Trefft ein Nahkampfziel fünfmal mit der Fähigkeit \'Zustoßen\' und wendet die Fähigkeit \'Schildbrecher\' auf 2 ungeschützte Distanzziele sowie die Fähigkeit \'Sturmangriff\' auf 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Galathia Morgenglanz beim Argentumturnierplatz zurück.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡근접 표적에 찌르기를 5번 사용하고, 약해진 원거리 표적 2개에 방패 부수기를 사용하고, 약해진 돌진 표적 2개에 돌진을 사용한 후 은빛십자군 마상시합 광장의 갈라시아 브라이트돈에게 가야 합니다.|n|n창을 잃어버리면 마구간 근처의 아무 창 선반이나 선리버 막사에서 다른 창을 얻을 수 있습니다.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Golpea a un objetivo cuerpo a cuerpo con Estocada 5 veces, usa Romper escudo sobre 2 objetivos a distancia vulnerables, usa Cargar sobre 2 objetivos de carga vulnerables y luego vuelve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Frappez 5 fois une Cible de mêlée avec un Coup de lance, utilisez 2 fois un Brise-bouclier sur des Cibles à distance vulnérables, utilisez 2 fois la Charge sur des Cibles de charge vulnérables, puis retournez voir Galathia Brillaube dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡使用刺击技能攻击一个近战目标5次，使用碎盾技能攻击2个脆弱的远程目标，使用冲锋技能攻击2个脆弱的冲锋目标，然后回到银色比武场，向加拉希亚·晨光复命。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13678] = {
  {
    '‡Подготовка к испытанию‡Der Herausforderung gewachsen‡도전에 맞서라‡A la altura del desafío‡A la altura del desafío‡Prêt pour le défi‡迎接挑战‡準備挑戰',
    nil,
    '‡Чтобы продемонстрировать свою готовность пройти испытание претендентов, отдайте 15 печатей претендента магистру Эдиену Солнечной Низине из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Überreicht Magister Edien Sonnental beim Argentumturnierplatz 15 Siegel des Streiters, um zu zeigen, dass Ihr bereit seid, Euch der Herausforderung des Streiters zu unterziehen.‡지원자의 도전에 응할 준비가 되었음을 증명하기 위해, 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 지원자의 문장 15개를 가져가야 합니다.‡Entrégale al magister Edien Vacuosol en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Entrégale al magister Edien Vacuosol en el Torneo Argenta 15 sellos de aspirante para indicarle que estás a punto para aceptar el desafío del aspirante.‡Apportez au Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent, 15 Sceaux d\'aspirant pour indiquer que vous souhaitez participer au Défi de l\'aspirant.‡将15枚候选者的徽记交给银色比武场的魔导师埃迪恩·炎谷，证明你已经准备好迎接候选者的挑战了。‡',
  }
},
[13679] = {
  {
    '‡Испытание претендента‡Die Herausforderung des Streiters‡지원자의 도전‡El desafío del aspirante‡El desafío del aspirante‡Le défi de l\'aspirant‡候选者的挑战‡志士的挑戰',
    nil,
    '‡Поговорите с оруженосцем Давидом, чтобы вызвать на поединок вашего противника. Как только вы победите искателя славы Серебряного Авангарда, вернитесь к чародею Таэлису в шатер Альянса на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe David und ruft Euren Widersacher herbei. Kehrt zu Arkanist Taelist beim Argentumturnierplatz zurück, sobald Ihr den Argentumrecken besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 데이비드와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용맹전사를 물리친 다음 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Habla con el escudero David para llamar a tu oponente. Cuando hayas derrotado al Valeroso Argenta, regresa con el arcanista Taelis en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero David para llamar a tu oponente. Cuando hayas derrotado al Valeroso Argenta, regresa con el arcanista Taelis en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer David pour invoquer votre adversaire. Une fois le Vaillant d\'argent vaincu, retournez voir l\'Arcaniste Taelis, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡和侍从大卫谈一谈，召唤你的对手。击败银色勇士之后回到银色比武场，向奥术师泰利斯复命。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13680] = {
  {
    '‡Испытание претендента‡Die Herausforderung des Streiters‡지원자의 도전‡El desafío del aspirante‡El desafío del aspirante‡Le défi de l\'aspirant‡候选者的挑战‡志士的挑戰',
    nil,
    '‡Поговорите с оруженосцем Давидом, чтобы вызвать на поединок вашего противника. Как только вы победите искателя славы Серебряного Авангарда, вернитесь к магистру Эдиену Солнечной Низине в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Sprecht mit Knappe David und ruft Euren Widersacher herbei. Kehrt zu Magister Edien Sonnental beim Argentumturnierplatz zurück, sobald Ihr den Argentumrecken besiegt habt.‡종자 데이비드와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용맹전사를 물리친 다음 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가야 합니다.‡Habla con el escudero David para invocar a tu oponente. Cuando hayas derrotado al valeroso Argenta, vuelve a hablar con el magister Edien Vacuosol en los Campos del Torneo Argenta.‡Habla con el escudero David para invocar a tu oponente. Cuando hayas derrotado al valeroso Argenta, vuelve a hablar con el magister Edien Vacuosol en los Campos del Torneo Argenta.‡Parlez à l\'Écuyer David pour invoquer votre adversaire. Une fois le Vaillant d\'argent vaincu, retournez voir le Magistère Edien Solcreuse, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13681] = {
  {
    '‡Обломки стен Ульдуара‡Wie der Block so der Splitter‡이 돌덩어리는 어디에서 왔을까‡Un trozo del bloque de Ulduar‡Un trozo del bloque de Ulduar‡Un fragment du bloc d\'Ulduar‡奥杜尔的石块‡奧杜亞石塊的碎片',
    nil,
    '‡Принесите 15 небольших камней Боззлу Рвизасову на Ристалище Серебряного турнира.‡Bringt 15 kleine Steinblöcke zu Stümpi Sprengbolz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 보즐 블라스트볼트에게 작은 돌덩어리 15개를 가져가야 합니다.‡Llévale 15 bloques de piedra pequeños a Bozzle Cargarrayo en los Campos del Torneo Argenta.‡Llévale 15 bloques de piedra pequeños a Bozzle Cargarrayo en los Campos del Torneo Argenta.‡Apportez 15 Petits blocs de pierre à Gaspu Boumboulon, dans l\'Enceinte du tournoi d\'Argent.‡将15块小石块交给银色比武场的波兹尔·布拉斯波。‡',
  }
},
[13682] = {
  {
    '‡Атака с воздуха‡Bedrohung von oben‡하늘의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    '‡Эдрик Чистый из Серебряного павильона на Ристалище Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов – сектантов.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡‡',
  }
},
[13684] = {
  {
    '‡Искатель славы из Штормграда‡Ein Recke von Sturmwind‡‡Un Valeroso de Ventormenta‡Un Valeroso de Ventormenta‡Un vaillant de Hurlevent‡暴风城的勇士‡暴風城驍士',
    nil,
    '‡Если вы хотите стать искателем славы Штормграда, поговорите с маршалом Якобом Алерием в Павильоне Серебряного Союза на Ристалище Серебряного турнира.‡Sprecht mit Marschall Jacob Alerius beim Argentumturnierplatz, um ein Recke von Sturmwind zu werden.‡‡Habla con el mariscal Jacob Alerius en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Ventormenta.‡Habla con el mariscal Jacob Alerius en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Ventormenta.‡Parlez au Maréchal Jacob Alerius, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Hurlevent.‡‡',
  }
},
[13685] = {
  {
    '‡Искатель славы из Стальгорна‡Ein Recke von Eisenschmiede‡‡Un Valeroso de Forjaz‡Un Valeroso de Forjaz‡Un vaillant de Forgefer‡铁炉堡的勇士‡鐵爐堡驍士',
    nil,
    '‡Если вы хотите стать искателем славы Стальгорна, поговорите с Ланой Твердомолот в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Lana Starkhammer beim Argentumturnierplatz, um ein Recke von Eisenschmiede zu werden.‡‡Habla con Lana Martillotenaz en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Forjaz.‡Habla con Lana Martillotenaz en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Forjaz.‡Parlez à Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Forgefer.‡‡',
  }
},
[13686] = {
  {
    '‡Alliance Tournament Eligibility Marker‡Markierung für Allianzturniersqualifikation‡얼라이언스 마상시합 참가자격 표지‡Marcador de elegibilidad del torneo de la Alianza‡Marcador de elegibilidad del torneo de la Alianza‡Marqueur d\'éligibilité au tournoi de l\'Alliance‡联盟联赛认可标记‡聯盟聯賽認可標記',
    nil,
    nil,
  }
},
[13687] = {
  {
    '‡Horde Tournament Eligibility Marker‡Markierung für Hordeturniersqualifikation‡호드 마상시합 참가자격 표지‡Marcador de elegibilidad del torneo de la Horda‡Marcador de elegibilidad del torneo de la Horda‡Marqueur d\'éligibilité au tournoi de la Horde‡部落联赛认可标记‡部落聯賽認可標記',
    nil,
    nil,
  }
},
[13688] = {
  {
    '‡Искатель славы из Гномрегана‡Ein Recke von Gnomeregan‡‡Un Valeroso de Gnomeregan‡Un Valeroso de Gnomeregan‡Un vaillant de Gnomeregan‡诺莫瑞根的勇士‡諾姆瑞根驍士',
    nil,
    '‡Если вы хотите стать искателем славы Гномрегана, поговорите с Амброзом Искрокрутом в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Ambrose Bolzenfunk beim Argentumturnierplatz, um ein Recke von Gnomeregan zu werden.‡‡Habla con Ambrose Chisparrayo en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Gnomeregan.‡Habla con Ambrose Chisparrayo en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Gnomeregan.‡Parlez à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Gnomeregan.‡‡',
  }
},
[13689] = {
  {
    '‡Искатель славы из Дарнаса‡Ein Recke von Darnassus‡다르나서스 용맹전사‡Un Valeroso de Darnassus‡Un Valeroso de Darnassus‡Un vaillant de Darnassus‡达纳苏斯的勇士‡達納蘇斯驍士',
    nil,
    '‡Чтобы стать искателем славы Дарнаса, поговорите с Джейлин Закатной Песней в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Jaelyne Abendlied beim Argentumturnierplatz, um ein Recke von Darnassus zu werden.‡다르나서스 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 제일린 이븐송과 대화해야 합니다.‡Habla con Jaelyne Unicanto en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Darnassus.‡Habla con Jaelyne Unicanto en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Darnassus.‡Parlez à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Darnassus.‡‡',
  }
},
[13690] = {
  {
    '‡Искатель славы из Экзодара‡Ein Recke der Exodar‡‡Un Valeroso de El Exodar‡Un Valeroso de El Exodar‡Un vaillant de l\'Exodar‡埃索达的勇士‡艾克索達驍士',
    nil,
    '‡Если вы хотите стать искателем славы Экзодара, поговорите с Колосусом в в шатре Альянса на Ристалище Серебряного турнира.‡Sprecht mit Kolosos beim Argentumturnierplatz, um ein Recke der Exodar zu werden.‡‡Habla con Colosos en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de El Exodar.‡Habla con Colosos en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de El Exodar.‡Parlez à Colossos, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de l\'Exodar.‡‡',
  }
},
[13691] = {
  {
    '‡Искатель славы из Оргриммара‡Ein Recke von Orgrimmar‡‡Un Valeroso de Orgrimmar‡Un Valeroso de Orgrimmar‡Un vaillant d\'Orgrimmar‡奥格瑞玛的勇士‡奧格瑪驍士',
    nil,
    '‡Если вы хотите стать искателем славы Оргриммара, поговорите с Мокрой Дробителем Черепов в Павильоне Похитителей Солнца на Ристалище Серебряного турнира.‡Sprecht mit Mokra dem Schädelberster beim Argentumturnierplatz, um ein Recke von Orgrimmar zu werden.‡‡Habla con Mokra el Trituracráneos en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Orgrimmar.‡Habla con Mokra el Trituracráneos en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Orgrimmar.‡Parlez à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; d\'Orgrimmar.‡‡',
  }
},
[13692] = {
  {
    'Espada ao mar‡Меч из моря‡Das Schwert und die See‡검과 바다‡La espada y el mar‡La espada y el mar‡L\'épée et la mer‡剑与海‡劍與海',
    nil,
    'O Velho Barlo, na Floresta do Canto Cristalino, quer que você lhe traga a Espada de Cavaleiro.‡Старина Барло из Леса Хрустальной Песни просит вас принести ему Меч Рыцарства.‡Der alte Barlo im Kristallsangwald möchte, dass Ihr ihm das Schwert der Ritterwürde bringt.‡수정노래 숲에 있는 노인 발로가 기사도의 검을 가져다 달라고 했습니다.‡El viejo Barlo en el Bosque Canto de Cristal quiere que le lleves la espada de caballería.‡El viejo Barlo en el Bosque Canto de Cristal quiere que le lleves la espada de caballería.‡Le Vieux Barlo, dans la Forêt du Chant de cristal, vous demande de lui apporter l\'Epée de chevalerie.‡晶歌森林的老渔夫巴尔洛要你把骑士之剑交给他。‡水晶之歌森林的老人巴洛要你幫他找回騎士位階之劍。',
  }
},
[13693] = {
  {
    '‡Искатель славы из Сен\'джина‡Ein Recke von Sen\'jin‡‡Un Valeroso de Sen\'jin‡Un Valeroso de Sen\'jin‡Un vaillant de Sen\'jin‡森金的勇士‡森金驍士',
    nil,
    '‡Если вы хотите стать искателем славы Сен\'джина, поговорите с Зул\'тором в Павильоне Похитителей Солнца на Ристалище Серебряного Турнира.‡Sprecht mit Zul\'tore beim Argentumturnierplatz, um ein Recke von Sen\'jin zu werden.‡‡Habla con Zul\'tore en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Sen\'jin.‡Habla con Zul\'tore en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Sen\'jin.‡Parlez à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Sen\'jin.‡‡',
  }
},
[13694] = {
  {
    '‡Искатель славы из Громового Утеса‡Ein Recke von Donnerfels‡‡Un Valeroso de Cima del Trueno‡Un Valeroso de Cima del Trueno‡Un vaillant des Pitons-du-Tonnerre‡雷霆崖的勇士‡雷霆崖驍士',
    nil,
    '‡Если вы хотите стать искателем славы Громового Утеса, поговорите с Руноком Буйногривым в Павильоне Похитителей Солнца на Ристалище Серебряного турнира.‡Sprecht mit Runok Wildmähne beim Argentumturnierplatz, um ein Recke von Donnerfels zu werden.‡‡Habla con Runok Ferocrín en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Cima del Trueno.‡Habla con Runok Ferocrín en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Cima del Trueno.‡Parlez à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; des Pitons-du-Tonnerre.‡‡',
  }
},
[13695] = {
  {
    '‡Искатель славы из Подгорода‡Ein Recke von Unterstadt‡‡Un Valeroso de Entrañas‡Un Valeroso de Entrañas‡Un vaillant de Fossoyeuse‡幽暗城的勇士‡幽暗城驍士',
    nil,
    '‡Если вы хотите стать искателем славы Подгорода, поговорите со стражем смерти Визери в Павильоне Похитителей Солнца на Ристалище Серебряного турнира.‡Sprecht mit Todespirscher Visceri beim Argentumturnierplatz, um ein Recke von Unterstadt zu werden.‡‡Habla con el mortacechador Visceri en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Entrañas.‡Habla con el mortacechador Visceri en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Entrañas.‡Parlez au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Fossoyeuse.‡‡',
  }
},
[13696] = {
  {
    '‡Искатель славы из Луносвета‡Ein Recke von Silbermond‡실버문 용맹전사‡Un Valeroso de Lunargenta‡Un Valeroso de Lunargenta‡Un vaillant de Lune-d’Argent‡银月城的勇士‡銀月城驍士',
    nil,
    '‡Если вы хотите стать искателем славы Луносвета, поговорите с Эрессеей Певицей Рассвета в Павильоне Похитителей Солнца на Ристалище Серебряного турнира.‡Sprecht mit Eressea Morgensänger beim Argentumturnierplatz, um ein Recke von Silbermond zu werden.‡실버문 용맹전사가 되려면 은빛십자군 마상시합 광장에 있는 에레시아 돈싱어와 대화해야 합니다.‡Habla con Eressea Cantoalba en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Lunargenta.‡Habla con Eressea Cantoalba en los Campos del Torneo Argenta para convertirte en $Gun Valeroso:una Valerosa; de Lunargenta.‡Parlez à Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent, pour devenir $Gun vaillant:une vaillante; de Lune-d\'Argent.‡‡',
  }
},
[13697] = {
  {
    '‡Путь искателя славы‡Das Wappen des Recken‡용맹전사의 돌진‡La carga del Valeroso‡La carga del Valeroso‡Les devoirs du vaillant‡勇士之战‡驍士的任務',
    nil,
    '‡Принесите 25 печатей искателя славы Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного Турнира.‡Bringt 25 Siegel des Recken zu Mokra dem Schädelberster beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 용맹전사의 인장 25개를 가져가야 합니다.‡Lleva 25 sellos de Valeroso a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Lleva 25 sellos de Valeroso a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Apportez 25 Sceaux de vaillant à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡将25枚勇士的徽记交给银色比武场的碎颅者莫克拉。‡',
  }
},
[13699] = {
  {
    '‡Испытание искателя славы‡Die Herausforderung des Recken‡용맹전사의 도전‡El desafío del Valeroso‡El desafío del Valeroso‡Le défi du vaillant‡勇士的挑战‡驍士的挑戰',
    nil,
    '‡Поговорите с оруженосцем Дэнни, чтобы вызвать на поединок вашего противника. Как только вы победите чемпиона Серебряного Авангарда, вернитесь к маршалу Якобу Алерию на Ристалище Серебряного Турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Sprecht mit Knappe Danny, um Euren Gegner herbeizurufen. Kehrt zu Marschall Jacob Alerius beim Argentumturnierplatz zurück, sobald Ihr den Argentumchampion besiegt habt.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡종자 대니와 대화하여 도전 상대를 소환해야 합니다. 은빛십자군 용사를 물리친 다음, 은빛십자군 마상시합 광장에 있는 작전사령관 제이콥 알레리우스에게 가야 합니다.|n|n창을 잃어버리면, 마구간 근처나 은빛 서약단 막사에 있는 창 선반 어디에서나 다른 창을 얻을 수 있습니다.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mariscal Jacob Alerius en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Habla con el escudero Danny para llamar a tu oponente. Cuando hayas derrotado al Campeón Argenta, regresa con el mariscal Jacob Alerius en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Parlez à l\'Écuyer Danny pour invoquer votre adversaire. Quand vous aurez vaincu le Champion d\'argent, retournez voir le Maréchal Jacob Alerius dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡‡',
  }
},
[13700] = {
  {
    '‡Alliance Champion Marker‡Markierung für Champion der Allianz‡얼라이언스 용사 표지‡Marcador de Campeón de la Alianza‡Marcador de Campeón de la Alianza‡Marqueur de champion de l\'Alliance‡联盟勇士标记‡聯盟勇士標記',
    nil,
    nil,
  }
},
[13701] = {
  {
    '‡Horde Champion Marker‡Markierung für Champion der Horde‡호드의 용사 표지‡Marcador de Campeón de la Horda‡Marcador de Campeón de la Horda‡Marqueur de champion de la Horde‡部落勇士标记‡部落勇士標記',
    nil,
    nil,
  }
},
[13702] = {
  {
    '‡Рождение героя‡Aufstieg eines Champions‡용사 등극‡Se alza un Campeón‡Se alza un Campeón‡La naissance d\'un champion‡冠军诞生‡一位勇士的出現',
    nil,
    '‡Поговорите с вершительницей правосудия Мариэль Чистосердечной на Ристалище Серебряного турнира.‡Sprecht mit Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트와 대화해야 합니다.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Parlez à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13703] = {
  {
    '‡Искатель славы из Стальгорна‡Recke von Eisenschmiede‡아이언포지 용맹전사‡Valeroso de Forjaz‡Valeroso de Forjaz‡Vaillant de Forgefer‡铁炉堡的勇士‡鐵爐堡驍士',
    nil,
    '‡Если вы хотите стать искателем славы Стальгорна, поговорите еще раз с Ланой Твердомолот в Павильоне Серебряного Союза.‡Sprecht wieder mit Lana Starkhammer, falls Ihr ein Recke von Eisenschmiede werden wollt.‡라나 스타우트해머와 다시 대화하면 아이언포지 용맹전사가 될 수 있습니다.‡Habla de nuevo con Lana Martillotenaz si quieres convertirte en $GValeroso:Valerosa; de Forjaz.‡Habla de nuevo con Lana Martillotenaz si quieres convertirte en $GValeroso:Valerosa; de Forjaz.‡Parlez à nouveau à Lana Rudemartel si vous voulez devenir $Gun vaillant:une vaillante; de Forgefer.‡‡',
  }
},
[13704] = {
  {
    '‡Искатель славы из Гномрегана‡Recke von Gnomeregan‡놈리건 용맹전사‡Valeroso de Gnomeregan‡Valeroso de Gnomeregan‡Vaillant de Gnomeregan‡诺莫瑞根的勇士‡諾姆瑞根驍士',
    nil,
    '‡Если вы хотите стать искателем славы Гномрегана, поговорите еще раз с Амброзом Искрокрутом в Павильоне Серебряного Союза.‡Sprecht wieder mit Ambrose Bolzenfunk, falls Ihr ein Recke von Gnomeregan werden wollt.‡암브로스 볼트스파크와 다시 대화하면 놈리건 용맹전사가 될 수 있습니다.‡Habla de nuevo con Ambrose Chisparrayo si quieres convertirte en $GValeroso:Valerosa; de Gnomeregan.‡Habla de nuevo con Ambrose Chisparrayo si quieres convertirte en $GValeroso:Valerosa; de Gnomeregan.‡Parlez à nouveau à Ambrose Étinceboulon si vous voulez devenir $Gun vaillant:une vaillante; de Gnomeregan.‡‡',
  }
},
[13705] = {
