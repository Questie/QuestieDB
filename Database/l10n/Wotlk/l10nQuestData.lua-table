[5054] = {
  {
    'Úrsius, o Dentilhaço‡Урсиус из щербозубов‡Ursius von den Splitterzahnbären‡톱니이빨곰 우르시우스‡Ursius de los Dentoesquirla‡Ursius de los Dentoesquirla‡Ursius des Crocs acérés‡碎齿熊尤西乌斯‡裂齒熊尤西烏斯',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Úrsius.‡По просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах убейте Урсиуса.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Ursius tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 우르시우스를 처치해달라고 요청했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Ursius.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous tuiez Ursius.‡永望镇的斯托姆·影蹄想要你去杀死尤西乌斯。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死尤西烏斯。',
  }
},
[5055] = {
  {
    'Brumeran dos Ventogelante‡Хладнокрылая Брумеран‡Brumeran von den Eiswindschimären‡서리바람 브룸랜‡Brumerán de los Orvallo‡Brumerán de los Orvallo‡Brumeran des Noroît‡冰风奇美拉布鲁米兰‡冰風奇美拉布魯米蘭',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você mate Brumeran.‡Убейте Брумеран по просьбе Шторма Призрачное Копыто в Круговзоре в Зимних Ключах.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Brumeran tötet.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 브룸랜을 처치해 달라고 요청했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que mates a Brumerán.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous tuiez Brumeran.‡永望镇的斯托姆·影蹄想要你去杀死布鲁米兰。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死布魯米蘭。',
  }
},
[5056] = {
  {
    'Shy-Rotam‡Ши-Ротам‡Shy-Rotam‡샤이로탐‡Shi-Rotam‡Shi-Rotam‡Shy-Rotam‡希洛塔姆‡希洛塔姆',
    nil,
    'Ventania Casco Escuro, de Visteterna, Hibérnia, quer que você derrote Shy-Rotam.‡Убейте Ши-Ротам для Шторма Призрачное Копыто.‡Storm Schattenhuf in der Ewigen Warte in Winterquell möchte, dass Ihr Shy-Rotam besiegt.‡여명의 설원 눈망루 마을에 있는 스톰 섀도후프가 샤이로탐을 처치해 달라고 요청했습니다.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Ventisca Pezuña Umbría de Vista Eterna, en Cuna del Invierno, quiere que acabes con Shi-Rotam.‡Storm Sabot-d\'ombre, à Long-guet au Berceau-de-l\'Hiver, veut que vous triomphiez de Shy-Rotam.‡永望镇的斯托姆-影蹄想要你去杀死希洛塔姆。‡冬泉谷永望鎮的斯托姆·影蹄想要你去殺死希洛塔姆。',
  }
},
[5057] = {
  {
    'Feitos passados‡Прежние свершения‡Frühere Abenteuer‡과거의 업적‡Esfuerzos del pasado‡Esfuerzos del pasado‡Essais passés‡以往的努力‡過往的努力',
    nil,
    'Leve o Marcador de Ventania Casco Escuro para Melor Casco de Pedra no Penhasco do Trovão.‡Отнесите Знак Шторма Призрачное Копыто Мелору Каменное Копыто в Громовой Утес.‡Bringt Storm Schattenhufs Gutschein zu Melor Steinhuf in Donnerfels.‡썬더 블러프에 있는 멜로르 스톤후프에게 스톰 섀도후프의 문장을 가져가야 합니다.‡Lleva la Señal de Ventisca Pezuña Umbría a Melor Pezuña Pétrea de Cima del Trueno.‡Lleva la Señal de Ventisca Pezuña Umbría a Melor Pezuña Pétrea de Cima del Trueno.‡Apportez le Marqueur de Storm Sabot-d\'ombre à Melor Sabot-de-pierre aux Pitons du Tonnerre.‡把斯托姆·影蹄的徽记交给雷霆崖的梅洛·石蹄。‡把史東姆·影蹄的標記帶去給雷霆崖的梅洛·石蹄。',
  }
},
[5058] = {
  {
    'Diário da Sra. Dalson‡Дневник миссис Далсон‡Frau Dalsons Tagebuch‡달슨 부인의 일기‡El diario de la señorita Dalson‡El diario de la señorita Dalson‡Journal de Mme Dalson‡达尔松夫人的日记‡達爾松夫人的日記',
    nil,
    nil,
  }
},
[5059] = {
  {
    'Trancafiado‡Под замком‡Weggeschlossen‡잠긴 화장실‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡被鎖起來的農夫',
    nil,
    nil,
  }
},
[5060] = {
  {
    'Trancafiado‡Под замком‡Weggeschlossen‡잠긴 장롱‡Encierro‡Encierro‡Enfermé‡被锁起来的农夫‡被鎖起來的農夫',
