  }
},
[11554] = {
  {
    'Lealdade no fronte‡Солдатская дружба‡Ein Freund an der Front‡최전선에 선 전우‡Un amigo en primera línea‡Un amigo en primera línea‡Un ami sur le front‡前线的伙伴‡在前線的朋友',
    nil,
    nil,
  }
},
[11555] = {
  {
    'Honrado pelos aliados‡Уважение союзников‡Eure Verbündeten wollen Euer Wohl‡동맹에게 받는 존경‡Honrado por tus aliados‡Honrado por tus aliados‡Honoré par vos alliés‡盟友的尊敬‡被盟友所尊敬',
    nil,
    nil,
  }
},
[11556] = {
  {
    'Reverenciado no campo de batalha‡Почтение боевых друзей‡Auf dem Schlachtfeld zollt man Euch Respekt‡전장에서 얻은 영예‡Venerado en el campo de batalla‡Venerado en el campo de batalla‡Révéré sur le champ de bataille‡战友的景仰‡戰場上的崇敬',
    nil,
    nil,
  }
},
[11557] = {
  {
    'O melhor em combate‡Восхищение всего войска‡Alle Kämpfer begegnen Euch mit Ehrfurcht‡가장 고귀한 투사‡Exaltado entre todos los combatientes‡Exaltado entre todos los combatientes‡Exalté parmi tous les combattants‡勇冠三军‡所有戰士的崇拜',
    nil,
    nil,
  }
},
[11558] = {
  {
    'Paixonite aguda‡Опасная любовь‡Gefährliche Liebschaft‡사랑이라는 위험한 병‡Amor peligroso‡Amor peligroso‡Les périls de l\'amour‡危险的爱情‡危險的愛',
    nil,
    'Pegue um Cartão Mofado do Guardião e entregue-o para Félix Amado na Cidade Baixa.‡Возьмите заплесневелую открытку стража и отнесите ее Фенстаду Аргайлу в Подгороде.‡Besorgt eine modrige Karte des Wächters und bringt sie zu Fenstad Argyle in Unterstadt.‡언더시티 수호병의 곰팡이 슨 카드를 구해서 언더시티의 펜스타드 아가일에게 가져가야 합니다.‡Lleva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Lleva una tarjeta mohosa de guardián a Fenstad Argyle a Entrañas.‡Obtenez une Carte de garde moisie et rapportez-la à Fenstad Argyle, à Fossoyeuse.‡弄到一张发臭的卡片，并把它交给幽暗城的芬斯塔·艾吉勒。‡取得一張守衛發霉的卡片並帶給幽暗城的芬斯塔德·阿吉歐。',
  }
},
[11559] = {
  {
    'Fazemos qualquer negócio‡Торговля с Зимними Плавниками‡Winterflossenhandel‡겨울지느러미일족과 거래 트기‡Comercio Aleta Invernal‡Comercio Aleta Invernal‡Commercer avec les Ailerons-d\'hiver‡冬鳞鱼人的贸易‡冬鰭交易',
    nil,
    'Junte 5 Mariscos da Falésia Invernal e entregue-os a Ahlurglgr, no Retiro da Falésia Invernal.‡Соберите 5 моллюсков Зимних Плавников и отдайте их Ахлурглгру в Приюте Зимних Плавников.‡Sammelt 5 Winterflossenmuscheln und liefert sie bei Ahlurglgr ab. Dieser befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 조개 5개를 모아 겨울지느러미 은신처에 있는 아흐루르글그르에게 가져가야 합니다.‡Reúne 5 almejas Aleta Invernal y llévaselas a Ahlurglgr en el Refugio Aleta Invernal.‡Reúne 5 almejas Aleta Invernal y llévaselas a Ahlurglgr en el Refugio Aleta Invernal.‡Ramassez 5 Palourdes aileron-d\'hiver et apportez-les à Ahlurglgr à la Retraite des Ailerons-d\'hiver.‡收集5只冬鳞蚌壳，将它们交给冬鳞避难所的呀噜咕噜。‡收集5個冬鰭蚌，然後把它們交給冬鰭避居地的阿魯咕嚕咕爾。',
  }
},
[11560] = {
  {
    'Essa não! Os girinos!‡О нет, наши бедные малыши!‡Oh neeiin, die Kaulquappen!‡어린 멀록 구출 작전!‡¡Oh no! ¡Los renacuajos!‡¡Oh no! ¡Los renacuajos!‡Jamais sans mes têtards‡救救蝌蚪！‡喔不，蝌蚪!',
    nil,
    'O Rei Mrgl-Mrgl lhe pediu para resgatar 20 Girinos Falésia Invernal. Fale novamente com ele no Retiro da Falésia Invernal assim que tenha cumprido esta missão.‡По поручению короля Мргла-Мргла спасите 20 головастиков Зимних Плавников. Вернитесь к королю в Приют Зимних Плавников, когда выполните задание.‡König Mrgl-Mrgl möchte, dass Ihr 20 Kaulquappen der Winterflossen befreit und anschließend zu ihm zurückkehrt. Er befindet sich in der Zuflucht der Winterflossen.‡멀록왕 므르글므르글이 어린 겨울지느러미 멀록 20마리를 구해달라고 부탁했습니다. 임무를 마치면 겨울지느러미 은신처에 있는 그에게 돌아가야 합니다.‡El rey Mrgl-Mrgl te ha pedido que rescates a 20 renacuajos Aleta Invernal. Vuelve a verlo al Refugio Aleta Invernal cuando hayas terminado.‡El rey Mrgl-Mrgl te ha pedido que rescates a 20 renacuajos Aleta Invernal. Vuelve a verlo al Refugio Aleta Invernal cuando hayas terminado.‡Le Roi Mrgl-Mrgl vous a demandé de sauver 20 Têtards aileron-d\'hiver. Retournez le voir à la Retraite des Ailerons-d\'hiver quand ce sera fait.‡国王姆嘎姆嘎要你解救20只冬鳞蝌蚪。完成任务后返回冬鳞避难所向他复命。‡莫戈莫戈大王要你去解救20個冬鰭蝌蚪。完成任務後回到冬鰭避居地找他。',
  }
},
[11561] = {
  {
    'Foram eles!‡Они!‡Die da!‡건너편에 원수가!‡¡Ellos!‡¡Ellos!‡Eux !‡就是他们！‡他們!',
    nil,
    'Brglmurgl, no Retiro da Falésia Invernal, pediu-lhe para matar 15 Murlocs da Falésia Invernal. Qualquer combinação de guerreiros, oráculos e costacantes serve.‡По просьбе Брглмургла в Приюте Зимних Плавников убейте воинов, оракулов и гарпунеров Зимних Плавников – всего 15 мурлоков.‡Brglmurgl in der Zuflucht der Winterflossen möchte, dass Ihr insgesamt 15 Murlocs der Winterflossen tötet, egal ob Krieger, Orakel oder Küstenschläger.‡브르글무르글이 전사, 점쟁이, 작살 사수를 가리지 않고 겨울지느러미일족 멀록 15마리를 처치해달라고 부탁했습니다.‡Brglmurgl en el Refugio Aleta Invernal te ha pedido que mates a 15 múrlocs Aleta Invernal. Cualquier combinación de guerreros, oráculos y rompeolas servirá.‡Brglmurgl en el Refugio Aleta Invernal te ha pedido que mates a 15 múrlocs Aleta Invernal. Cualquier combinación de guerreros, oráculos y rompeolas servirá.‡Brglmurgl, de la Retraite des Ailerons-d\'hiver, vous a demandé de tuer 15 Murlocs aileron-d\'hiver. N\'importe quelle combinaison de guerriers, oracles et guerriers des rivages fera l\'affaire.‡冬鳞避难所的吧咕姆咕要你杀死15名冬鳞鱼人，战士、智者或是巡滩者都行。‡冬鰭避居地的布爾格墨葛要你殺死15個冬鰭魚人。任何戰士、神諭者、濱擊者的組合都可以。',
  }
},
[11562] = {
  {
    'Meu faxineiro está me chantageando‡Меня хотят очернить!‡Mein Putzmurloc erpresst mich‡청소부의 협박‡Mi limpiador me está chantajeando‡Mi limpiador me está chantajeando‡Mon teinturier est un maître-chanteur‡我被敲竹杠了！‡我被我的清潔工勒索',
    nil,
    'O Rei Mrgl-Mrgl lhe pediu que você converse com Mrmrglmr na parte noroeste do Retiro da Falésia Invernal.‡По просьбе короля Мргла-Мргла поговорите с Мрмрглмром на северо-западной стороне Приюта Зимних Плавников.‡König Mrgl-Mrgl möchte, dass Ihr mit Mrmrglmr sprecht. Er befindet sich im nordwestlichen Teil der Zuflucht der Winterflossen.‡멀록왕 므르글므르글이 겨울지느러미 은신처 북서쪽 끝에 있는 므름르글므르와 이야기하라고 부탁했습니다.‡El rey Mrgl-Mrgl te ha pedido que hables con Mrmrglmr al extremo noroeste del Refugio Aleta Invernal.‡El rey Mrgl-Mrgl te ha pedido que hables con Mrmrglmr al extremo noroeste del Refugio Aleta Invernal.‡Le Roi Mrgl-Mrgl vous a demandé de parler à Mrmrglmr à l\'extrémité nord-ouest de la Retraite des Ailerons-d\'hiver.‡国王姆嘎姆嘎要你与冬鳞避难所西北角的姆姆咕咕谈一谈。‡莫戈莫戈大王要你前往北風凍原的冬鰭避居地西北盡頭與姆姆戈莫談談。',
  }
},
[11563] = {
  {
    'Grmmurggll Mrllggrl Glrggl!!!‡Грммурглл Мрллглл Глрггл!‡Grmmurggll Mrllggrl Glrggl!!!‡그름무르그글 므를르그그르를 글르글!!!‡¡¡¡Grmmurggll Mrllggrl Glrggl!!!‡¡¡¡Grmmurggll Mrllggrl Glrggl!!!‡Grmmurggll Mrllggrl Glrggl !!!‡咕噜咕噜呜啦哇啦！‡戈墨爾吉珥 墨勒吉爾 吉爾戈!!!',
    nil,
    'Mrmrglmr quer que você lhe traga a Cabeça de Glrggl.‡Принесите Мрмрглмру в Приюте Зимних Плавников голову Глрггла.‡Mrmrglmr will, dass Ihr mit Glrggls Kopf zu ihm zurückkehrt. Er befindet sich in der Zuflucht der Winterflossen.‡겨울지느러미 은신처에 있는 므름르글므르가 글르글의 머리를 가져와 달라고 부탁했습니다.‡Mrmrglmr quiere que regreses al Refugio Aleta Invernal con la cabeza de Glrggl.‡Mrmrglmr quiere que regreses al Refugio Aleta Invernal con la cabeza de Glrggl.‡Mrmrglmr vous demande de revenir le voir à la Retraite des Ailerons-d\'hiver avec la Tête de Glrggl.‡冬鳞避难所的姆姆咕咕要你将咕拉咕拉的徽记带回来给他。‡姆姆戈莫要你帶著吉爾戈的頭顱回到冬鰭避居地給他。',
  }
},
[11564] = {
  {
    'Ensopado Suculento de Orca‡Сочное жаркое из косатки‡Saftiger Orcaeintopf‡육즙이 많은 범고래 스튜‡Suculento estofado de orca‡Suculento estofado de orca‡Un ragoût d\'épaulard succulent‡美味炖鲸肉‡多汁的虎鯨燉肉',
    nil,
    'O Cuteleiro Bmurglbrm lhe incumbiu de adquirir 7 Gorduras Suculentas de Orca. Leve-as para ele no Retiro da Falésia Invernal.‡По поручению Колуна Бмурглбрма добудьте и принесите 7 кусков мясистого сальника косатки. С мясом возвращайтесь к нему в Приют Зимних Плавников.‡Hackebeil Bmurglbrm hat Euch damit beauftragt, 7 Einheiten saftigen Orcatran zu beschaffen. Bringt sie anschließend zu ihm in die Zuflucht der Winterflossen.‡학살자 브무르글브름이 육즙이 많은 범고래 지방덩어리 7개를 구해달라고 부탁했습니다. 다 모으면 겨울지느러미 은신처에 있는 그에게 돌아가야 합니다.‡El acuchillador Bmurglbrm te ha encargado 7 piezas de grasa de orca suculenta. Llévaselas al Refugio Aleta Invernal.‡El acuchillador Bmurglbrm te ha encargado 7 piezas de grasa de orca suculenta. Llévaselas al Refugio Aleta Invernal.‡Le Fendeur Bmurglbrm vous a demandé de récupérer 7 Succulentes graisses d\'épaulard. Retournez ensuite le voir à la Retraite des Ailerons-d\'hiver.‡北风苔原冬鳞避难所的屠夫布咕布噜要你去收集7块肥美的逆戟鲸脂肪。‡斬擊者布墨格伯姆要你收集7個多汁虎鯨脂。回到北風凍原的冬鰭避居地向他回報。',
  }
},
[11565] = {
  {
    'O outro traje‡Запасной комплект‡Das Ersatzkostüm‡여벌 위장복‡El traje de muda‡El traje de muda‡Le costume de rechange‡备用的鱼人服‡備用服裝',
    nil,
    'Leve o Outro Traje do Rei Mrgl-Mrgl para ele, no Retiro da Falésia Invernal.‡Верните запасной костюм короля Мргла-Мргла королю Мрглу-Мрглу в Приют Зимних Плавников.‡Bringt König Mrgl-Mrgls Ersatzkostüm zu ihm zurück. Er befindet sich in der Zuflucht der Winterflossen.‡멀록왕 므르글므르글의 여벌 위장복을 겨울지느러미 은신처에 있는 멀록왕 므르글므르글에게 돌려줘야 합니다.‡Devuélvele al rey Mrgl-Mrgl su traje de muda. Lo encontrarás en el Refugio Aleta Invernal.‡Devuélvele al rey Mrgl-Mrgl su traje de muda. Lo encontrarás en el Refugio Aleta Invernal.‡Rapportez son Costume de rechange au Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡返回冬鳞避难所，将国王姆嘎姆嘎的备用鱼人服交给他。‡把莫戈莫戈大王的備用服裝帶到冬鰭避居地給他。',
  }
},
[11566] = {
  {
    'Render-se... Jamais!‡Сдаться? Ни за что!‡Ergebt Euch... nicht!‡항복... 은 없다!‡¡De rendirse... nada!‡¡De rendirse... nada!‡Reddition... ou pas !‡决不投降！‡永不……屈服!',
    nil,
    'O Rei Mrgl-Mrgl, no Retiro da Falésia Invernal, pediu que você lhe traga a Garra de Claximus.‡Принесите коготь Клаксимуса королю Мргл-Мргл в Приюте Зимних Плавников.‡König Mrgl-Mrgl in der Zuflucht der Winterflossen möchte, dass Ihr ihm die Klaue von Claximus bringt.‡겨울지느러미 은신처에 있는 멀록왕 므르글므르글이 클랙시무스의 집게발을 가져와 달라고 부탁했습니다.‡El rey Mrgl-Mrgl en el Refugio Aleta Invernal te ha pedido que le traigas una garra de Claximus.‡El rey Mrgl-Mrgl en el Refugio Aleta Invernal te ha pedido que le traigas una garra de Claximus.‡Le Roi Mrgl-Mrgl, de la Retraite des Ailerons-d’hiver, vous a demandé de lui rapporter une Pince de Claximus.‡冬鳞避难所的国王姆嘎姆嘎要你将克拉西姆斯的钳子带回来给他。‡冬鰭避居地的莫戈莫戈大王要你帶一個克拉希穆司之爪給他。',
  }
},
[11567] = {
  {
    'A antiga armadura dos kvaldir‡Древняя броня Квалдира‡Die uralte Rüstung der Kvaldir‡크발디르의 고대 갑옷‡La antigua armadura de los Kvaldir‡La antigua armadura de los Kvaldir‡L\'antique armure des kvaldirs‡克瓦迪尔上古甲胄‡科瓦迪爾的上古盔甲',
    nil,
    'Recupere a Antiga Armadura dos Kvaldir e entregue-a para Orfus de Kamagua, no Fiorde Uivante.‡Найдите древнюю броню Квалдира и отнесите ее Орфусу Камагуанскому в Ревущий фьорд.‡Bergt die uralte Rüstung der Kvaldir und bringt sie zu Orfus von Kamagua im heulenden Fjord.‡크발디르의 고대 갑옷을 되찾은 다음 울부짖는 협만의 방패 언덕에 있는 카마구아의 오르푸스에게 전달해야 합니다.‡Recupera la antigua armadura de los Kvaldir y entrégasela a Orfus de Komawa en el Fiordo Aquilonal.‡Recupera la antigua armadura de los Kvaldir y entrégasela a Orfus de Komawa en el Fiordo Aquilonal.‡Récupérez l\'Antique armure des kvaldirs et apportez-la à Orfus de Kamagua dans le Fjord Hurlant.‡找回克瓦迪尔上古甲胄，把它交给嚎风峡湾卡玛古的奥弗斯。‡找到科瓦迪爾的上古盔甲，然後把它交給凜風峽灣的卡瑪廓的歐弗斯。',
  }
},
[11568] = {
  {
    'De volta ao repouso eterno‡Возвращение святынь‡Wieder zur Ruhe kommen lassen‡다시 안식으로‡Volver a descansar en paz‡Volver a descansar en paz‡Le retour à la terre‡安息‡歸於平靜',
    nil,
    'Use o Bornal de Artefatos Vraikalen nos túmulos saqueados do Monte Égide para devolver o Coração Congelado de Isuldof, o Escudo dos Aesiritas, o Cajado da Fúria da Tempestade e a Antiga Armadura dos Kvaldir.|n|nFale novamente com Orfus de Kamagua, no Elevador Ancestral, que fica no Fiorde Uivante, caso você obtenha sucesso.‡Используйте мешок с врайкульскими артефактами на разграбленных курганах Заградительного холма и верните на место Ледяное сердце Исулдофа, Щит Эсиритса, Посох Неистовства Бури и Древнюю броню Квалдира. Когда поручение будет выполнено, вернитесь к Орфусу Камагуанскому на Древний подъемник.‡Verwendet das Bündel mit Vrykulartefakten bei den geplünderten Grabhügeln des Schildhügels und legt das gefrorene Herz Isuldofs, den Schild der Aesiriten, den Stab des Sturmfurors und die uralte Rüstung der Kvaldir wieder zurück.|n|nKehrt zu Orfus von Kamagua am Uralten Aufzug zurück, falls Ihr erfolgreich sein solltet.‡방패 언덕의 파헤쳐진 무덤에서 브리쿨 유물 보따리를 사용해 이술도프의 얼어붙은 심장, 애시리테스의 방패, 폭풍 강타 지팡이와 크발디르의 고대 갑옷을 되돌려놔야 합니다.|n|n임무를 마치면 고대 승강장에 있는 카마구아의 오르푸스에게 돌아가십시오.‡Usa el fardo de artefactos vrykul en los túmulos funerarios de Colina Escudo para devolver el corazón congelado de Isuldof, el escudo de los Aesirites, el bastón de la Furia de la Tormenta y la antigua armadura de los Kvaldir.|n|nVuelve con Orfus de Komawa en El Antiguo Elevador si lo consigues.‡Usa el fardo de artefactos vrykul en los túmulos funerarios de Colina Escudo para devolver el corazón congelado de Isuldof, el escudo de los Aesirites, el bastón de la Furia de la Tormenta y la antigua armadura de los Kvaldir.|n|nVuelve con Orfus de Komawa en El Antiguo Elevador si lo consigues.‡Utilisez le Paquet d\'artéfacts vrykuls aux tertres funéraires mis à sac de la Colline du Bouclier pour restituer le Cœur gelé d\'Isuldof, le Bouclier des Asirites, le Bâton de la fureur de l\'orage et l\'Antique armure des kvaldirs.|n|nRetournez voir Orfus de Kamagua à l\'Antique élévateur, si vous réussissez.‡在盾牌岭那些被掠夺过的墓穴处使用维库圣物，将伊斯多弗的冰冷之心、古神之盾、风暴愤怒法杖和克瓦迪尔上古甲胄放回它们原本的位置。|n|n完成任务之后回到上古升降梯，向卡玛古的奥弗斯复命。‡在盾丘被洗劫的墓塚使用一包維酷神器，歸還伊蘇鐸夫的冰凍心臟、阿薩瑞特之盾、風暴之怒法杖和科瓦迪爾的上古盔甲。|n|n完成後回到遠古升降梯找卡瑪廓的歐弗斯。',
  }
},
[11569] = {
  {
    'Guardião da chave Urmgrgl‡Хранитель ключей Ургргрл‡Schlüsselmeister Urmgrgl‡열쇠지기 우름그르글‡El maestro de llaves Urmgrgl‡El maestro de llaves Urmgrgl‡Le maître des clés Urmgrgl‡钥匙管理者呜啦咕噜‡鑰匙大師俄姆戈苟',
    nil,
    'Glrglrglr, dentro da Caverna Falésia Invernal, pediu para que você recupere a Chave do Urmgrgl.‡По просьбе Глрглрглра в пещерах Зимних Плавников раздобудьте ключ Ургргрла.‡Glrglrglr in den Höhlen der Winterflossen möchte, dass Ihr Urmgrgls Schlüssel beschafft.‡겨울지느러미 동굴에 있는 글르글르글르가 우름그르글의 열쇠를 찾아와 달라고 부탁했습니다.‡Glrglrglr en el interior de las Cavernas Aleta Invernal te ha pedido que consigas la llave de Urmgrgl.‡Glrglrglr en el interior de las Cavernas Aleta Invernal te ha pedido que consigas la llave de Urmgrgl.‡Glrglrglr vous a demandé de récupérer la Clé d’Urmgrgl. Lorsque ce sera fait, retournez le voir dans les Cavernes des Ailerons-d’hiver.‡冬鳞洞穴的咕啦咕啦要你夺回呜啦咕噜的钥匙。‡冬鰭洞窟的葛勒格勒格勒要你拿到俄姆戈苟之鑰。',
  }
},
[11570] = {
  {
    'Fuga da caverna Falésia Invernal‡Бегство из пещер Зимних Плавников‡Flucht aus den Höhlen der Winterflossen‡겨울지느러미 동굴에서 탈출‡Escapa de las Cavernas Aleta Invernal‡Escapa de las Cavernas Aleta Invernal‡L\'évasion des cavernes des Ailerons-d\'hiver‡逃离冬鳞洞穴‡逃離冬鰭洞窟',
    nil,
    'Escolte Lurgglbr e conte as boas novas ao Rei Mrgl-Mrgl no Retiro da Falésia Invernal.‡Проводите Лургглбра в безопасное место и вернитесь к королю Мргл-Мрглу в Приют Зимних Плавников, чтобы сообщить ему хорошую новость.‡Eskortiert Lurgglbr, bis er in Sicherheit ist, und überbringt anschließend König Mrgl-Mrgl in der Zuflucht der Winterflossen die guten Neuigkeiten.‡루르글브르를 안전한 곳까지 호위한 다음 겨울지느러미 은신처에 있는 멀록왕 므르글므르글에게 그 소식을 알려줘야 합니다.‡Escolta a Lurgglbr hasta un lugar seguro y después dale la buena noticia al rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Escolta a Lurgglbr hasta un lugar seguro y después dale la buena noticia al rey Mrgl-Mrgl en el Refugio Aleta Invernal.‡Escorter Lurgglbr jusqu’à ce qu\'il soit en sécurité, puis aller annoncer la bonne nouvelle au Roi Mrgl-Mrgl à la Retraite des Ailerons-d\'hiver.‡护送噜呱吧呱抵达安全区域，然后返回冬鳞避难所，向国王姆嘎姆嘎汇报这一好消息。‡平安地將魯格伯護送回去，然後向冬鰭避居地的莫戈莫戈大王回報這個好消息。',
  }
},
[11571] = {
  {
    'Aprendendo a se comunicar‡Обучение коммуникации‡Lernen, wie man kommuniziert‡의사소통법 익히기‡Aprendiendo a comunicarse‡Aprendiendo a comunicarse‡Apprendre à communiquer‡学习沟通‡學習溝通',
    nil,
    'O Rei Mrgl-Mrgl lhe deu uma concha para usar nos restos de Escaldora. Leve A Concha Cheia do Rei para ele no Retiro da Falésia Invernal.‡Наполните ракушку, которую дал вам король Мргл-Мргл, над останками Скольдер. Верните наполненную ракушку короля Мрглу-Мрглу в Приют Зимних Плавников.‡König Mrgl-Mrgl hat Euch eine Muschel gegeben, die Ihr bei Verbrühers Überresten benutzen sollt. Kehrt mit der gefüllten Muschel des Königs zu ihm zurück. Er befindet sich in der Zuflucht der Winterflossen.‡스칼더의 시체에 빈 조가비를 사용하여 왕의 가득 찬 조가비로 만든 다음, 겨울지느러미 은신처에 있는 멀록왕 므르글므르글에게 가져다주어야 합니다.‡El rey Mrgl-Mrgl te ha dado una caracola para que la uses sobre los restos de Escaldadora. Devuélvele la caracola del Rey llena en el Refugio Aleta Invernal.‡El rey Mrgl-Mrgl te ha dado una caracola para que la uses sobre los restos de Escaldadora. Devuélvele la caracola del Rey llena en el Refugio Aleta Invernal.‡Le Roi Mrgl-Mrgl vous a donné une conque à utiliser sur les restes de Brûle-gueule. Rapportez-lui la Conque du roi remplie à la Retraite des Ailerons-d\'hiver.‡冬鳞避难所的国王姆嘎姆嘎要你对斯卡德尔的尸体使用空贝壳，然后将国王的充盈贝壳交给他。‡莫戈莫戈大王給你一個海螺要你對史卡德的屍體使用。之後回到冬鰭避居地把國王的盛滿海螺交給他。',
  }
},
[11572] = {
  {
    'Volte a Atuik‡Возвращение к Атуику‡Rückkehr zu Atuik‡아투이크에게 돌아가기‡Regresa junto a Atuik‡Regresa junto a Atuik‡Retourner voir Atuik‡返回阿图伊克身边‡回去找阿推克',
    nil,
    'Conte as más notícias para o Ancião Atuik em Kamagua.‡Доставьте тревожные известия старейшине Атуику в Камагуа.‡Überbringt Urahn Atuik in Kamagua die schlechten Nachrichten.‡나쁜 소식을 카마구아의 장로 아투이크에게 전해야 합니다.‡Dale las malas noticias al ancestro Atuik en Komawa.‡Dale las malas noticias al ancestro Atuik en Komawa.‡Transmettez les mauvaises nouvelles à l’Ancien Atuik à Kamagua.‡将坏消息传达给卡玛古的长者阿图伊克。‡把壞消息告訴在卡瑪廓的長者阿推克。',
  }
},
[11573] = {
  {
    'Orfus de Kamagua‡Орфус Камагуанский‡Orfus der Kamagua‡카마구아의 오르푸스‡Orfus de Komawa‡Orfus de Komawa‡Orfus de Kamagua‡卡玛古的奥弗斯‡卡瑪廓的歐弗斯',
    nil,
    'Encontre Orfus de Kamagua no Elevador Ancestral, no Fiorde Uivante.‡Найдите Орфуса Камагуанского на Древнем подъемнике в Ревущем фьорде.‡Sucht am Uralten Aufzug im heulenden Fjord nach Orfus von Kamagua.‡울부짖는 협만에 있는 고대 승강장에서 카마구아의 오르푸스를 찾아야 합니다.‡Encuentra a Orfus de Komawa en El Antiguo Elevador de Fiordo Aquilonal.‡Encuentra a Orfus de Komawa en El Antiguo Elevador de Fiordo Aquilonal.‡Trouvez Orfus de Kamagua à l\'Antique élévateur dans le Fjord Hurlant.‡前往嚎风峡湾的上古升降梯，寻找卡玛古的奥弗斯。‡去凜風峽灣的遠古升降梯尋找卡瑪廓的歐弗斯。',
  }
},
[11574] = {
  {
    'Intimidade é uma...‡Переживания на грани‡Zu knapp für meinen Geschmack‡가까이 있기엔 너무 불편한‡Por los pelos‡Por los pelos‡Un peu trop près à mon goût…‡危在旦夕‡千鈞一髮',
    nil,
    'Endorah quer que você vá ao Promontório Âmbar, a norte da Fortaleza Brado Guerreiro, e agradeça aos que a resgataram.‡По просьбе Эндоры отправляйтесь на Янтарную Гряду к северу от крепости Песни Войны и поблагодарите тамошних обитателей за ее спасение.‡Endorah möchte, dass Ihr Euch auf das Bernsteinflöz nördlich der Kriegshymnenfeste begebt und ihren Rettern ihren Dank aussprecht.‡엔도라가 전쟁노래부족 요새의 북쪽에 있는 호박석 절벽으로 가서 그곳에 있는 사람들에게 구조해줘서 고맙다는 말을 전해달라고 부탁했습니다.‡Endorah quiere que vayas a El Saliente Ámbar al noroeste del Bastión Grito de Guerra y les des las gracias a los magos por haberla rescatado.‡Endorah quiere que vayas a El Saliente Ámbar al noroeste del Bastión Grito de Guerra y les des las gracias a los magos por haberla rescatado.‡Endorah veut que vous alliez à l’Escarpement d’Ambre au nord du Bastion Chanteguerre, et que vous remerciiez ceux qui l’ont sauvée.‡恩多拉要你到战歌要塞北方的琥珀崖去找到她的救命恩人，并转达她的谢意。‡伊朵菈要你去戰歌堡北邊的琥珀岩臺，感謝那些拯救她的人。',
  }
},
[11575] = {
  {
    'Na hora H‡Своевременное спасение‡Gerade noch rechtzeitig‡위기 일발‡Justo a tiempo‡Justo a tiempo‡Juste à temps‡千钧一发‡關鍵時刻',
    nil,
    'Ana, na Bastilha Valentia, quer que você vá para o Promontório Âmbar, ao norte, e agradeça aos que a salvaram.‡По просьбе Мушки из крепости Отваги отправляйтесь на Янтарную гряду к северу и поблагодарите тамошних обитателей за ее спасение.‡Mücke in der Valianzfeste möchte, dass Ihr Euch auf das Bernsteinflöz im Norden begebt und ihren Rettern ihren Dank aussprecht.‡용맹의 성채에 있는 미지가 북쪽의 호박석 절벽으로 가서 거기 사람들에게 구조에 대한 감사의 말을 전해달라고 부탁했습니다.‡Menudencia de la Fortaleza Denuedo quiere que vayas hasta El Saliente Ámbar al norte y des las gracias a quienes la rescataron.‡Menudencia de la Fortaleza Denuedo quiere que vayas hasta El Saliente Ámbar al norte y des las gracias a quienes la rescataron.‡Moucheronne, au Donjon de la Bravoure, veut que vous alliez à l’Escarpement d’Ambre au nord, et que vous remerciiez ceux qui l’ont sauvée.‡无畏要塞的米吉要你到北方的琥珀崖去找到她的救命恩人，并转达她的谢意。‡驍勇要塞的米吉要你前往北方的琥珀岩臺感謝那些拯救她的人。',
  }
},
[11576] = {
  {
    'Monitoramento da fissura: anomalia no Rochedo Rachado‡Наблюдения за расселиной: обнаружена аномалия‡Die Klamm beobachten: Spaltkliffanomalie‡균열 조사: 벼랑 변형 지형‡Observar la falla: anomalía del Acantilado Agrietado‡Observar la falla: anomalía del Acantilado Agrietado‡Surveiller la faille : l\'anomalie de la falaise fendue‡监视裂谷：悬崖异常‡監控裂口:異常裂壁',
    nil,
    'Garren, no Promontório Âmbar, quer que você use o Arcanômetro na Anomalia do Rochedo Rachado.‡По просьбе Гаррена с Янтарной гряды воспользуйтесь тайнометром у аномалии утеса Западной расселины.‡Garren vom Bernsteinflöz möchte, dass Ihr das Arkanometer bei der Spaltkliffanomalie benutzt.‡호박석 절벽의 가렌이 벼랑 변형 지형에서 비전력 측정기를 사용해 달라고 부탁했습니다.‡Garren de El Saliente Ámbar quiere que utilices el arcanómetro en la anomalía del Acantilado Agrietado.‡Garren de El Saliente Ámbar quiere que utilices el arcanómetro en la anomalía del Acantilado Agrietado.‡Garren, de l\'Escarpement d\'Ambre, vous demande d\'utiliser l\'Arcanomètre à l\'Anomalie de la falaise fendue.‡琥珀崖的盖伦要你在悬崖异常处使用奥术测量器。‡琥珀岩臺的加倫要你在異常裂壁使用奧能檢測儀。',
  }
},
[11577] = {
  {
    '‡Коллекционное издание WoW: – DEM – E – FLAG‡WoW Collector\'s Edition: - DEM - E - FLAG‡소장판‡Coleccionista de WoW Edition: - DEM - E - BANDERA‡WoW Collector\'s Edition: - DEM - E - FLAG‡WoW Collector\'s Edition: - DEM - E - FLAG‡WoW Collector\'s Edition: - DEM - E - FLAG‡',
    nil,
    nil,
  }
},
[11578] = {
  {
    'The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY‡Die "Fress"-Quest (123)aa‡The "Chow" Quest (123)aa COPY‡La misión "Chow" (123)aa COPIA‡La misión "Chow" (123)aa COPIA‡La quête « Chow » (123)aa‡The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY',
    nil,
    'Kill Kobold Vermin, 2 of em.‡Убей пару кобольдов-вредителей.‡Tötet Koboldgezücht - und zwar 2 davon.‡Kill Kobold Vermin, 2 of em.‡Matar alimaña kóbold, dos.‡Matar alimaña kóbold, dos.‡Tuer la vermine kobold, au moins 2.‡Kill Kobold Vermin, 2 of em.‡殺死兩個狗頭人惡黨。',
  }
},
[11579] = {
  {
    'The "Chow" Quest (123)aa COPY‡The "Chow" Quest (123)aa COPY‡Die "Fress"-Quest (123)aa‡The "Chow" Quest (123)‡La misión "Chow" (123)aa COPIA‡La misión "Chow" (123)aa COPIA‡La quête « Chow » (123)aa COPIE‡The "Chow" Quest (123)aa COPY‡「狗頭人」任務(123)aa COPY',
    nil,
    'Kill Kobold Vermin, 2 of em.‡Убей пару кобольдов-вредителей.‡Tötet Koboldgezücht, und zwar 2 davon.‡Kill Kobold Vermin, 2 of em.‡Matar alimaña kóbold, dos.‡Matar alimaña kóbold, dos.‡Tuer la vermine kobold, au moins 2.‡杀死两个狗头人歹徒。‡殺死兩個狗頭人惡黨。',
  }
},
[11580] = {
  {
    'Profane o fogo!‡Осквернение огня‡Entweiht dieses Feuer!‡화톳불 모독!‡¡Profana este fuego!‡¡Profana este fuego!‡Désacralisez ce feu !‡亵渎这团火焰！‡褻瀆這些火焰!',
