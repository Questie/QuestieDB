},
[8343] = {
  {
    'A descoberta de Folháurea‡Открытие Золотого Листа‡Goldblatts Entdeckung‡골드리프의 발견‡El descubrimiento de Hojaurea‡El descubrimiento de Hojaurea‡La découverte de Feuilledor‡金叶的发现‡金葉的發現',
    nil,
    'Fale com Aurel Folháurea no Forte Cenariano.‡Поговорите с Аурель Золотой Лист в крепости Кенария.‡Sprecht mit Aurel Goldblatt auf Burg Cenarius.‡세나리온 요새에 있는 오렐 골드리프와 얘기해야 합니다.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Habla con Aurel Hojaurea en el Fuerte Cenarion.‡Parlez à Aurel Feuilledor au Fort cénarien.‡与塞纳里奥要塞的奥蕾尔·金叶谈一谈。‡與塞納里奧城堡的奧莉爾·金葉談話。',
  }
},
[8344] = {
  {
    '‡Постижение основ‡Schlüssel zur Macht‡‡Ventanas al origen‡Ventanas al origen‡Des fenêtres vers la source‡力量之源‡力量之源',
    nil,
    '‡Принесите 4 призрачные сущности и 1 оскверненную призрачную сущность призывателю Тель\'Лариену в Солнечный Шпиль на остров Солнечного Скитальца.‡Bring 4 Essenzen eines Gespenstes und 1 Essenz eines besudelten Gespenstes zu Beschwörer Teli\'Larien beim Sonnenturm auf der Insel der Sonnenwanderer.‡‡Lleva 4 esencias de ánimas arcanas y 1 esencia de ánima arcana mácula al invocador Teli\'Larien a la Aguja del Sol a la Isla del Caminante del Sol.‡Lleva 4 esencias de ánimas arcanas y 1 esencia de ánima arcana mácula al invocador Teli\'Larien a la Aguja del Sol a la Isla del Caminante del Sol.‡Remettez 4 Essences d\'âmes en peine et 1 Essence d\'âme en peine contaminée à l\'invocateur Teli\'Larien, à la Flèche solaire de l\'île de Haut-Soleil.‡‡',
  }
},
[8345] = {
  {
    'O Altar de Dath\'Remar‡Святилище Дат\'Ремара‡Der Schrein von Dath\'Remar‡다트리마의 제단‡Santuario de Dath\'Remar‡Santuario de Dath\'Remar‡Le sanctuaire de Dath\'Remar‡达斯雷玛的神龛‡達斯雷瑪神殿',
    nil,
    'Leia a placa no Altar de Dath\'Remar e fale novamente com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Прочтите надпись на святилище Дат\'Ремара и вернитесь к хранителю Колодца Соланиану в Солнечный шпиль на острове Солнечного Скитальца.‡Lest die Tafel am Schrein von Dath\'Remar und kehrt anschließend zu Brunnenbehüter Solanian beim Sonnenturm auf der Insel der Sonnenwanderer zurück.‡다트리마의 제단을 찾아서 비문을 읽은 다음 선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안에게 보고하십시오.‡Lee la placa del Santuario de Dath\'Remar y ve a ver al vigía del pozo Solanian a la Aguja del Sol en la Isla del Caminante del Sol.‡Lee la placa del Santuario de Dath\'Remar y ve a ver al vigía del pozo Solanian a la Aguja del Sol en la Isla del Caminante del Sol.‡Lisez la plaque au Sanctuaire de Dath\'Remar puis retournez auprès du veilleur du puits Solanian, à la Flèche solaire de l\'île de Haut-soleil.‡阅读达斯雷玛的神龛上的铭文之后，向逐日岛太阳之塔上的护井者索兰尼亚复命。‡閱讀達斯雷瑪神殿上的銘文再回到逐日者之島找日尖塔的看井者索蘭尼亞。',
  }
},
[8346] = {
  {
    'Sede eterna‡Неутолимая жажда‡Unstillbarer Durst‡끝없는 욕망‡Sed insaciable‡Sed insaciable‡L\'insatiable soif‡无尽的渴求‡止不了的渴',
    nil,
    'Use a habilidade Torrente Arcana, inerente à sua raça, em uma Moreia de Mana e fale novamente com o Arcanista Helion.‡Используйте вашу расовую способность "Волшебный поток" против маназмея, затем вернитесь к чародею Хелиону.‡Verwendet die Fähigkeit \'Arkaner Strom\' auf einen Manawyrm und kehrt anschließend zu Arkanist Helion zurück.‡마나 지룡에게 종족 특성인 비전 격류를 사용한 후, 비전술사 헬리온에게 돌아가야 합니다.‡Usa tu habilidad racial Torrente Arcano sobre una vermis de maná y luego vuelve junto al arcanista Helion.‡Usa tu habilidad racial Torrente Arcano sobre una vermis de maná y luego vuelve junto al arcanista Helion.‡Servez-vous de votre compétence raciale Torrent arcanique sur un wyrm de mana, puis revenez voir l’arcaniste Helion.‡对一条法力浮龙使用种族特长技能“奥术洪流”，然后向奥术师赫里恩复命。‡對法力龍鰻使用你的奧流之術種族特長，再回到秘法師海利恩那裡。',
  }
},
[8347] = {
  {
    'O auxílio aos vanguardeiros‡Помощь курьерам‡Unterstützung für die Kundschafter‡길잡이 돕기‡Ayudando a los avanzados‡Ayudando a los avanzados‡Aider les estafettes‡帮助信使‡幫助先驅者',
    nil,
    'Fale com a Vanguardeira Alarion perto da ponte que leva ao sul da Ilha Andassol.‡Поговорите с курьером Аларион у моста к югу от острова Солнечного Скитальца.‡Sprecht mit Kundschafterin Alarion nahe der Brücke, die in den Süden der Insel der Sonnenwanderer führt.‡선스트라이더 섬의 남쪽으로 이어진 다리 근처에 있는 길잡이 알라리온과 대화해야 합니다.‡Habla con la avanzada Alarion cerca del puente que va al sur de la Isla del Caminante del Sol.‡Habla con la avanzada Alarion cerca del puente que va al sur de la Isla del Caminante del Sol.‡Parler à l\'estafette Alarion, près du pont qui mène au sud de l\'île de Haut-soleil.‡与逐日岛南部桥梁旁的信使奥拉莉恩谈一谈。‡和先驅者艾拉瑞恩談談，她就在往南方逐日者之島的橋附近。',
  }
},
[8348] = {
  {
    'O sinete dos duques‡Перстень герцогов‡Siegel der Fürsten‡군주의 인장‡Sellos de los Duques‡Sellos de los Duques‡La chevalière des ducs‡公爵的徽记‡公爵的徽記',
    nil,
    'Leve o Sinete Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите перстень бездны Бору Буйногривому из крепости Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius das abyssische Siegel.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 인장을 가져다 주어야 합니다.‡Lleva el sello abisal a Bor Ferocrín en el Fuerte Cenarion.‡Lleva el sello abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez la Chevalière abyssale à Bor Crin-sauvage, au Fort cénarien.‡将深渊徽记交给塞纳里奥要塞的霍姆·蛮鬃。‡把深淵徽記帶給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8349] = {
  {
    'Bor Juba Agreste‡Бор Буйная Грива‡Bor Wildmähne‡보르 와일드메인‡Bor Ferocrín‡Bor Ferocrín‡Bor Crin-sauvage‡鲍尔·蛮鬃‡鮑爾·蠻鬃',
    nil,
    'Fale com Bor Juba Agreste no Forte Cenariano.‡Поговорите с Бором Буйногривым из крепости Кенария.‡Sprecht mit Bor Wildmähne auf Burg Cenarius.‡세나리온 요새에 있는 보르 와일드메인과 얘기해야 합니다.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡與在塞納里奧城堡的鮑爾·蠻鬃談話。',
  }
},
[8350] = {
  {
    'Concluindo a entrega‡Доставка посылки‡Erfolgreiche Lieferung‡소포 배달‡El encargo‡El encargo‡Achever la livraison‡送信‡完成遞送',
    nil,
    'Entregue o Pacote da Erona à Estalajadeira Delaniel na estalagem na Praça Asa do Falcão, que fica na Floresta do Canto Eterno.‡Доставьте посылку Эроны хозяйке таверны Деланиель на площадь Соколиных Крыльев в лесах Вечной Песни.‡Bringt Eronas Päckchen zu Gastwirtin Delaniel im Gasthaus beim Falkenplatz im Immersangwald.‡영원노래 숲의 매날개 광장의 여관에 있는 여관주인 델라니엘에게 이로나의 소포를 전달해야 합니다.‡Entrega el paquete de Erona a la tabernera Delaniel en la Plaza Alalcón en el Bosque Canción Eterna.‡Entrega el paquete de Erona a la tabernera Delaniel en la Plaza Alalcón en el Bosque Canción Eterna.‡Remettez le Paquet d\'Erona à l\'aubergiste Delaniel, à l\'auberge située sur la place de l\'épervier dans le bois des Chants éternels.‡将艾洛娜的包裹交给永歌森林鹰翼广场旅店中的旅店老板德兰妮尔。‡將伊羅娜的包裹送到永歌森林給獵鷹之翼廣場的旅店主人德拉尼歐。',
  }
},
[8351] = {
  {
    'Bor quer lhe falar‡Разговор с Бором‡Bor möchte Euch sprechen‡보르와의 대화‡Bor quiere hablar contigo‡Bor quiere hablar contigo‡Bor souhaite vous parler‡与鲍尔谈话‡伯爾想說話',
    nil,
    'Fale com Bor Juba Agreste no Forte Cenariano.‡Поговорите с Бором Буйногривым из крепости Кенария.‡Sprecht mit Bor Wildmähne auf Burg Cenarius.‡세나리온 요새에 있는 보르 와일드메인과 얘기해야 합니다.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Habla con Bor Ferocrín en el Fuerte Cenarion.‡Parlez à Bor Crin-sauvage au Fort cénarien.‡与塞纳里奥要塞的鲍尔·蛮鬃谈一谈。‡與在塞納里奧城堡的鮑爾·蠻鬃談話。',
  }
},
[8352] = {
  {
    'Cetro do conselho‡Скипетр Совета‡Szepter des Rates‡심연의 홀‡Cetro del Consejo‡Cetro del Consejo‡Le sceptre du Conseil‡议会的节杖‡議會權杖',
    nil,
    'Leve um Cetro Abissal para Bor Juba Agreste no Forte Cenariano.‡Принесите скипетр бездны Бору Буйногривому из крепости Кенария.‡Bringt Bor Wildmähne auf Burg Cenarius ein abyssisches Szepter.‡세나리온 요새에 있는 보르 와일드메인에게 심연의 홀을 가져다 주어야 합니다.‡Lleva un cetro abisal a Bor Ferocrín en el Fuerte Cenarion.‡Lleva un cetro abisal a Bor Ferocrín en el Fuerte Cenarion.‡Apportez un Sceptre abyssal à Bor Crin-sauvage, au Fort cénarien.‡将一柄深渊节杖交给塞纳里奥要塞的鲍尔·蛮鬃。‡帶一支深淵權杖給塞納里奧城堡的鮑爾·蠻鬃。',
  }
},
[8353] = {
  {
    'Imito uma galinha por uma balinha‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    'Use a expressão /galinha diante do Estalajadeiro Aguardente e, em troca, ele lhe dará uma Balinha de Altaforja!‡Изобразите курицу для хозяина таверны Огневара.‡Spielt Gastwirt Feuerbräu ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Eisenschmiede geben!‡여관주인 파이어브루를 위해 닭 흉내를 내야 합니다. 그러면 아이언포지 박하사탕을 받을 수 있습니다!‡Haz el pollo para el posadero Vientofuego y te dará una menta de Forjaz.‡¡Cacarea como un pollo para el tabernero Brebefuego y te dará una menta de Forjaz!‡Utilisez l\'emote /poulet devant l\'aubergiste Brassefeu, et vous recevrez en échange un bonbon à la menthe de Forgefer !‡为旅店老板洛雷·火酒模仿小鸡的动作，作为交换，你将得到一颗铁炉堡薄荷糖！‡對旅店老闆火酒模仿小雞的動作並得到一顆鐵爐堡薄荷糖!',
  }
},
[8354] = {
  {
    'Imito uma galinha por uma balinha‡Курочка с мятой‡Hühnchengegacker für ein Pfefferminzbonbon‡닭 흉내 내고 박하사탕 얻기‡Una menta por cacarear como un pollo‡Una menta por cacarear como un pollo‡Caqueter pour un bonbon à la menthe‡学小鸡，换糖果‡學小雞，換糖果',
    nil,
    'Use a expressão /galinha diante do Estalajadeiro Ronan e, em troca, ele lhe dará uma Balinha da Cidade Baixa!‡Изобразите курицу для хозяина таверны Нормана и получите за это конфету Подгорода!‡Spielt Gastwirt Norman ein Huhn vor, er wird Euch dafür ein Pfefferminzbonbon aus Unterstadt geben!‡여관주인 노먼을 위해 닭 흉내를 내면 언더시티 박하사탕을 받을 수 있습니다!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡¡Cacarea como un pollo para el tabernero Norman y a cambio recibirás una menta de Entrañas!‡Utilisez l\'emote /poulet devant l\'aubergiste Norman, et vous recevrez en échange un bonbon à la menthe de Fossoyeuse !‡为旅店老板诺曼模仿小鸡的动作，作为交换，你将得到一颗幽暗城薄荷糖！‡對旅店老闆諾曼模仿小雞的動作並得到一顆幽暗城薄荷糖!',
  }
},
[8355] = {
  {
    'Café com pão, café com pão‡Плата за леденец‡Kaugummikugelexpress‡젤리를 주세요‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡學火車，換糖果',
    nil,
    'Use a expressão /trem ao falar com Didiê Du Mocó para ganhar uma Jujuba de Gnomeregan!‡Изобразите паровозик для Талваша дель Кисселя.‡Ahmt für Talvash del Kissel einen Zug nach und er wird Euch dafür eine Kaugummikugel aus Gnomeregan geben!‡탈바쉬 델 키젤을 위해 기차 소리를 내야 합니다. 그러면 놈리건 젤리를 받을 수 있습니다!‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Haz el tren para Talvash del Kissel y te dará una gominola de Gnomeregan.‡Utilisez l\'emote /tchou devant Talvash del Kissel, et vous recevrez en échange une boule de gomme de Gnomeregan !‡为塔瓦斯德·基瑟尔模仿火车的声音，作为交换，你将得到一颗诺莫瑞根橡皮糖！‡對塔瓦斯德·基瑟爾做出火車的聲音，並交換你應得的諾姆瑞根橡皮軟糖!',
  }
},
[8356] = {
  {
    'Mamãe, sou forte!‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    'Use a expressão /muque na frente da estalajadeira Cristine para ganhar um Nougat de Ventobravo!‡Поиграйте мышцами для хозяйки таверны Аллисон и получите от нее за это нугу из Штормграда.‡Ihr müsst vor Gastwirtin Allison angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Sturmwind gibt!‡여관주인 앨리슨에게 힘자랑을 해야 합니다. 그러면 스톰윈드 초코바를 받을 수 있습니다!‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.‡Saca músculos para la tabernera Allison y, a cambio, recibirás un almendrado de Ventormenta.|n‡Utilisez l\'emote /frime devant l\'aubergiste Allison, et vous recevrez en échange du nougat de Hurlevent !‡向旅店老板奥里森炫耀自己强壮的肌肉，作为交换，你将得到一颗暴风城杏仁糖！‡對旅店老闆奧里森作展示肌肉的動作，並交換你應得的暴風城奶油杏仁花生糖!',
  }
},
[8357] = {
  {
    'Tudo por um marzipã‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Bailando por mazapanes‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡跳跳舞，換糖果',
    nil,
    'Dance para a Estalajadeira Saliennte e, em troca, ela lhe dará Marzipã de Darnassus!‡Потанцуйте для хозяйки таверны Салиенны, и за это вы получите дарнасский марципан!‡Tanzt für Gastwirtin Saelienne und Ihr werdet im Gegenzug etwas von dem Marzipan aus Darnassus bekommen!‡여관주인 셀리에네를 위해 춤을 추어야 합니다. 그러면 다르나서스 양갱을 받을 수 있습니다!‡Baila para la tabernera Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Baila para la tabernera Saelienne, y, a cambio, recibirás mazapán de Darnassus.‡Utilisez l\'emote /danser devant l\'aubergiste Saelienne, et vous recevrez en échange du massepain de Darnassus !‡为旅店老板塞琳尼模仿跳舞动作，作为交换，你将得到一颗达纳苏斯水果糖！‡對旅店老闆塞琳尼跳舞，並交換你應得的達納蘇斯杏仁糖!',
  }
},
[8358] = {
  {
    '‡Плата за леденцы‡Kaugummikugelexpress‡젤리를 주세요‡¡Truco o trato!‡¡Truco o trato!‡Boule de gomme en approche‡学火车，换糖果‡學火車，換糖果',
    nil,
    '‡Изобразите паровозик перед Кали Ремик и получите в награду леденец троллей Черного Копья!‡Ahmt für Kali Remik einen Zug nach und sie wird Euch dafür eine Kaugummikugel der Dunkelspeere geben!‡칼리 레믹을 위해 기차소리를 내면 검은창 젤리를 받을 수 있습니다!‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.|n‡Haz el tren para Kali Remik y a cambio recibirás una gominola Lanza Negra.|n‡Utilisez l\'emote /tchou devant Kali Remik, et vous recevrez en échange une Boule de gomme sombrelance !‡为卡利·雷米克模仿火车的声音，作为交换，你将得到一颗暗矛橡皮糖！‡',
  }
},
[8359] = {
  {
    '‡Поиграй мускулами!‡Muskelspiel für Nugat‡힘자랑하고 초코바 얻기‡Saca músculo a cambio de almendrados‡Saca músculo a cambio de almendrados‡Montrer ses muscles pour du nougat‡显肌肉，换糖果‡顯肌肉，換糖果',
    nil,
    '‡Поиграйте мускулами перед хозяйкой таверны Гришкой и получите от нее за это нугу из Оргриммара.‡Ihr müsst vor Gastwirtin Gryshka angeben, damit sie Euch im Gegenzug etwas vom Nugat aus Orgrimmar gibt!‡여관주인 그리쉬카를 위해 힘자랑을 하면 오그리마 초코바를 받을 수 있습니다!‡Saca músculo para la tabernera Gryshka y te dará unos almendrados de Orgrimmar.‡Saca músculo para la tabernera Gryshka y te dará unos almendrados de Orgrimmar.‡Utilisez l\'emote /frime devant l\'aubergiste Gryshka, et vous recevrez en échange du nougat d\'Orgrimmar !‡向旅店老板格雷什卡炫耀自己强壮的肌肉，作为交换，你将得到一颗奥格瑞玛软糖！‡',
  }
},
[8360] = {
  {
    '‡Танец за марципан‡Tanzen für Marzipan‡춤추고 양갱 얻기‡Bailando por mazapanes‡Bailando por mazapanes‡Danser pour du massepain‡跳跳舞，换糖果‡跳跳舞，換糖果',
    nil,
    '‡Потанцуйте для хозяйки таверны Палы, и за это вы получите марципан Громового Утеса!‡Tanzt für Gastwirtin Pala und Ihr werdet im Gegenzug etwas von dem Marzipan aus Donnerfels bekommen!‡여관주인 팔라를 위해 춤을 추면 썬더 블러프 양갱을 받을 수 있습니다!‡Baila para la tabernera Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Baila para la tabernera Pala y, a cambio, recibirás mazapán de Cima del Trueno.‡Utilisez l\'emote /danser devant l\'aubergiste Pala, et vous recevrez en échange du massepain des Pitons-du-Tonnerre !‡为旅店老板帕拉曼模仿跳舞动作，作为交换，你将得到一颗雷霆崖奶糖！‡',
  }
},
[8361] = {
  {
    'Contatos abissais‡Связь с Бездной‡Abyssische Kontakte‡심연의 의회와의 교신‡Contactos Abisales‡Contactos Abisales‡Des contacts abyssaux‡深渊联络‡深淵聯絡',
    nil,
    'Bor Juba Agreste no Forte Cenariano, em Silithus, quer que você acabe com um Templário Abissal e leve um Escudo Abissal para ele como prova.‡Убейте храмовника бездны по поручению Бора Буйногривого из крепости Кенария, что в Силитусе, и принесите в доказательство талисман бездны.‡Bor Wildmähne auf Burg Cenarius in Silithus möchte, dass Ihr einen abyssischen Templer vernichtet und ihm dessen abyssisches Wappen als Beweis für Eure Tat bringt.‡실리더스의 세나리온 요새에 있는 보르 와일드메인이 심연의 기사단을 처치하고 그 증거로 심연의 인장을 가져다 달라고 부탁했습니다.‡Bor Ferocrín, del Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un blasón Abisal como prueba de tu logro.‡Bor Ferocrín, del Fuerte Cenarion, en Silithus, quiere que destruyas a un Templario Abisal y le lleves un blasón Abisal como prueba de tu logro.‡Bor Crin-sauvage, du Fort cénarien en Silithus, veut que vous détruisiez un Templier abyssal et que vous lui rameniez un Blason abyssal comme preuve de votre exploit.‡希利苏斯塞纳里奥要塞的鲍尔·蛮鬃要求你击败一名深渊圣殿骑士，并将一个深渊纹章带回来作为证明。‡在希利蘇斯塞納里奧城堡的鮑爾·蠻鬃希望你能摧毀深淵聖殿騎士並且將深淵紋章作為行動證明帶回去給他。',
  }
},
[8362] = {
  {
    'Escudos abissais‡Талисманы Бездны‡Abyssische Wappen‡심연의 문장‡Blasones Abisales‡Blasones Abisales‡Les blasons abyssaux‡深渊纹章‡深淵紋章',
    nil,
    nil,
  }
},
[8363] = {
  {
    'Sinetes abissais‡Перстни Бездны‡Abyssische Siegel‡심연의 인장‡Sellos abisales‡Sellos abisales‡Les chevalières abyssales‡深渊徽记‡深淵徽記',
    nil,
    nil,
  }
},
[8364] = {
  {
    'Cetros abissais‡Скипетры Бездны‡Abyssische Szepter‡심연의 홀‡Cetros Abisales‡Cetros Abisales‡Les sceptres abyssaux‡深渊节杖‡深淵權杖',
    nil,
    nil,
  }
},
[8365] = {
  {
    'Chapéus de pirata, io-hô!‡Пиратские шляпы‡Piratenhüte Ahoy!‡최신 유행 해적 모자‡¡Sombreros de pirata a babor!‡¡Sombreros de pirata a babor!‡Ohé, des chapeaux de pirate !‡海盗的帽子！‡海賊的帽子!',
    nil,
    'Sissi Ashando quer que você colete 20 Chapéus de Pirata dos Mares do Sul e leve-os para ela no Porto de Bondebico, em Tanaris.‡Добудьте 20 шляп пиратов Южных Морей и отнесите их Отти Кутюри в Порт Картеля в Танарисе.‡Sammelt 20 Südmeerpiratenhüte und bringt sie zurück zur eingebildeten Modeschöpferin beim Dampfdruckpier in Tanaris.‡타나리스의 스팀휘들 항구에 있는 거만한 의류상의 부탁으로 남쪽바다 해적 모자 20개를 모아서 가져가야 합니다.‡La modista Jactancia quiere que reúnas 20 sombreros de pirata de los Mares del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡La modista Jactancia quiere que reúnas 20 sombreros de pirata de los Mares del Sur y que se los lleves al Puerto Bonvapor de Tanaris.‡Hautaine Lamodiste veut que vous lui rapportiez 20 Chapeaux de pirate des mers du Sud à Port Gentepression, en Tanaris.‡塔纳利斯热砂港的傲慢的店主要你去帮他收集20顶南海海盗帽。‡塔納利斯熱砂港的傲慢的店主要你去幫他收集20頂南海海賊帽。',
  }
},
[8366] = {
  {
    'Recadinho dos Mares do Sul‡Покажи этим пиратам‡Gaunerei und Erpressung im Südmeer‡남쪽바다해적단 처리반‡Mamporros en los Mares del Sur‡Mamporros en los Mares del Sur‡Le racket des mers du Sud‡南海复仇‡南海復仇',
    nil,
    'O Chefe de Segurança Silvadágua do Porto de Bondebico, em Tanaris, quer que você mate 10 Piratas dos Mares do Sul, 10 Flibusteiros dos Mares do Sul, 10 Estivadores dos Mares do Sul e 10 Espadachins dos Mares do Sul.‡Начальник отдела безопасности Чепухастер из Порта Картеля в Танарисе просит убить 10 пиратов, 10 флибустьеров, 10 рабочих и 10 сорвиголов Южных морей.‡Sicherheitschef Bilgenritzel beim Dampfdruckpier in Tanaris beauftragt Euch, 10 Piraten der Südmeerfreibeuter, 10 Seeräuber der Südmeerfreibeuter, 10 Dockarbeiter der Südmeerfreibeuter und 10 Schwadroneure der Südseefreibeuter zu töten.‡타나리스의 스팀휘들 항구에 있는 보안과장 빌지위즐이 남쪽바다해적단 무법자, 약탈자, 부두일꾼, 칼잡이를 각각 10명씩 처치해 달라고 부탁했습니다.‡El jefe de seguridad Pasaquillas del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas de los Mares del Sur, 10 filibusteros de los Mares del Sur, 10 portuarios de los Mares del Sur y 10 espadachines de los Mares del Sur.‡El jefe de seguridad Pasaquillas del Puerto Bonvapor de Tanaris quiere que mates a 10 piratas de los Mares del Sur, 10 filibusteros de los Mares del Sur, 10 portuarios de los Mares del Sur y 10 espadachines de los Mares del Sur.‡Le chef de la sécurité Vizisanie du port Gentepression, en Tanaris, veut que vous tuiez 10 Pirates des mers du Sud, 10 Flibustiers des mers du Sud, 10 Portefaix des mers du Sud et 10 Bretteurs des mers du Sud.‡塔纳利斯热砂港的安全主管吉罗姆·比格维兹要你去干掉10个南海海盗、10个南海劫掠者、10个南海码头工人和10个南海流氓。‡塔納利斯熱砂港的安全主管膨嘯要你去幹掉10個南海海賊、10個南海掠劫者、10個南海碼頭工人和10個南海劍客。',
  }
},
[8367] = {
  {
    'Por grande honra‡Великая честь‡Große Ehre‡커다란 영광을 위하여‡Cuestión de honor‡Cuestión de honor‡Pour le plus grand des honneurs‡无上的荣耀‡無上的榮耀',
    nil,
    'Leve uma Marca de Honra de cada campo de batalha a um Armipotente da Horda em Shattrath ou em qualquer capital da Horda.‡Принесите почетные знаки каждого поля боя ордынскому вестнику войны в любую столицу Орды или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Kriegshetzer der Horde in einer der Hauptstädte oder in Shattrath.‡호드 대도시나 샤트라스에 있는 호드 돌격대장에게 각 전장에서 명예 훈장을 하나씩 가져가야 합니다.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un belisario de la Horda en cualquiera de las capitales de la Horda o en Shattrath.‡Apportez 1 Marque d’honneur de chaque champ de bataille à un Porteguerre de la Horde, dans n\'importe quelle capitale de la Horde ou à Shattrath.‡在每个战场上都取得1枚荣誉奖章，并将它们交给任意部落主城或沙塔斯城中的部落战争使者。‡把每座戰場的榮譽獎章各一枚交給任何一座部落主城或撒塔斯的部落戰爭使者。',
  }
},
[8368] = {
  {
    'Batalha da Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Schlacht der Kriegshymnenschlucht‡전쟁노래 협곡 전투‡La batalla por Garganta Grito de Guerra‡La batalla por Garganta Grito de Guerra‡La bataille du goulet des Chanteguerres‡峡谷中的战斗‡峽谷之戰',
    nil,
    'Leve 3 Marcas de Honra do Brado Guerreiro a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Kriegshymnenklans zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur Chanteguerre à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚战歌荣誉奖章交给战场外的部落战争使者。‡將3枚戰歌榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8369] = {
  {
    'Invasores do Vale Alterac‡Вторжение в Альтеракскую долину‡Die Invasoren des Alteractals‡알터랙 계곡의 침략자‡Invasores del Valle de Alterac‡Invasores del Valle de Alterac‡Les envahisseurs de la vallée d\'Alterac‡奥特兰克的入侵者‡奧特蘭克的入侵者',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины ордынскому вестнику войны рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à l\'un des porteguerres de la Horde, devant les champs de bataille.‡把1枚奥特兰克山谷荣誉奖章交给战场外的部落战争使者。‡把3枚奧特蘭克山谷榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8370] = {
  {
    'Conquistando a Bacia Arathi‡Завоевание Низины Арати‡Eroberung des Arathibeckens‡아라지 분지 정복‡La conquista de la Cuenca de Arathi‡La conquista de la Cuenca de Arathi‡La conquête du bassin Arathi‡资源竞赛‡資源競賽',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um Armipotente da Horda do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати ордынскому вестнику войны рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem Kriegshetzer der Horde, außerhalb der Schlachtfelder.‡전장 밖에 있는 호드 돌격대장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un Belisario de la Horda fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à l\'un des porteguerres de la Horde, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的部落战争使者。‡將3枚阿拉希盆地榮譽獎章交給戰場外的部落戰爭使者。',
  }
},
[8371] = {
  {
    'Esforços combinados‡В едином порыве‡Gemeinsames Bestreben‡공동의 노력‡Esfuerzos concertados‡Esfuerzos concertados‡Des efforts concertés‡共同的努力‡共同的努力',
    nil,
    'Leve uma Marca de Honra de cada campo de batalha a um General de Brigada da Aliança em Dalaran, Shattrath ou qualquer capital da Aliança.‡Принесите почетные знаки каждого поля боя бригадному генералу Альянса в любую столицу Альянса или в Шаттрат.‡Bringt ein Ehrenabzeichen jedes Schlachtfelds zu einem Brigadegeneral der Allianz in einer der Hauptstädte, Dalaran oder Shattrath.‡얼라이언스 대도시나 달라란, 샤트라스에 있는 얼라이언스 준장에게 각 전장 명예 훈장을 하나씩 가져가야 합니다.‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Dalaran o Shattrath.‡Entrega 1 marca de Honor de cada campo de batalla a un general de brigada de la Alianza en cualquiera de las capitales de la Alianza, Dalaran o Shattrath.‡Apportez 1 Marque d’honneur de chaque champ de bataille à un Général de brigade de l\'Alliance, dans n\'importe quelle capitale de l\'Alliance, à Dalaran ou à Shattrath.‡在每个战场上都取得1枚荣誉奖章，并将它们交给任意联盟主城、达拉然或沙塔斯城中的联盟准将。‡把每座戰場的榮譽獎章各一枚交給交給任何一座聯盟主城、達拉然或撒塔斯的聯盟准將。',
  }
},
[8372] = {
  {
    'Luta pela Ravina Brado Guerreiro‡Битва за ущелье Песни Войны‡Kampf um die Kriegshymnenschlucht‡전쟁노래 협곡 전투‡Lucha por Garganta Grito de Guerra‡Lucha por Garganta Grito de Guerra‡La lutte pour le goulet des Chanteguerres‡自然屏障‡自然屏障',
    nil,
    'Leve 3 Marcas de Honra da Ravina Brado Guerreiro a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака ущелья Песни Войны бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen der Kriegshymnenschlucht zu einem Brigadegeneral der Allianz, außerhalb der Schlachtfelder.‡전장 밖에 있는 얼라이언스 준장에게 전쟁노래 협곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Garganta Grito de Guerra a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du goulet des Chanteguerres à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚战歌峡谷荣誉奖章交给战场外的联盟准将。‡將3枚戰歌峽谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8373] = {
  {
    'O poder do pinho‡Сила сосен‡Die Kraft der Pinie‡소나무의 힘‡El poder del pino‡El poder del pino‡La puissance du pin‡松木的力量‡松木的力量',
    nil,
    'Use o Limpador de Bomba Fedida para remover qualquer Bomba Fedida dos Renegados atirada na Costa Sul. Fale novamente com o Sargento Hartman, na Costa Sul, quando você tiver terminado.‡Уберите любую бомбу-вонючку Отрекшихся, брошенную в Южнобережье, при помощи очистителя бомб-вонючек. По выполнении задания возвращайтесь к сержанту Хартману.‡Verwendet einen Stinkbombenreiniger, um alle Stinkbomben der Verlassenen zu vernichten, die hier in Süderstade losgelassen wurden. Kehrt zu Unteroffizier Hartman in Süderstade zurück, wenn Ihr fertig seid.‡구린내 폭탄 탈취제를 사용하여 사우스쇼어에 떨어진 포세이큰 구린내 폭탄을 제거한 후 하사관 허트만에게 돌아가야 합니다.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Usa un limpiador de bombas fétidas para borrar los restos de las que los Renegados hayan lanzado en Costasur. Cuando acabes, ve a ver al sargento Hartman a Costasur.‡Utilisez le Nettoyeur de boules puantes pour retirer les Boules puantes que les Réprouvés ont lancées sur Austrivage. Retournez voir le sergent Hartman à Austrivage quand vous aurez terminé.‡使用臭气弹清洁器来把散落在南海镇的亡灵臭气弹处理掉。当任务完成之后，回到南海镇的哈特曼中士那里。‡使用臭彈清潔器來把散落在南海鎮的被遺忘者臭彈處理掉。當任務完成之後，回到南海鎮的哈特曼中士那裏。',
  }
},
[8374] = {
  {
    'Reivindicando a Bacia Arathi‡Завоевание Низины Арати‡Inbesitznahme des Arathibeckens‡아라시 분지 공격‡Reclamo por la Cuenca de Arathi‡Reclamo por la Cuenca de Arathi‡La revendication du bassin Arathi‡战争的动力‡戰爭的動力',
    nil,
    'Leve 3 Marcas de Honra da Bacia Arathi a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Низины Арати бригадному генералу Альянса рядом со входом на поля боя.‡Bringt 3 Ehrenabzeichen des Arathibeckens zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 아라시 분지 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor de la Cuenca de Arathi a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur du bassin Arathi à un général de brigade de l\'Alliance, devant les champs de bataille.‡将3枚阿拉希盆地荣誉奖章交给战场外的联盟准将。‡將3枚阿拉希盆地榮譽獎章交給戰場外的聯盟准將。',
  }
},
[8375] = {
  {
    'Lembrem-se do Vale Alterac!‡Помни Альтеракскую долину!‡Vergesst das Alteractal nicht!‡잊지 말자, 알터랙 계곡!‡¡Recuerda el Valle de Alterac!‡¡Recuerda el Valle de Alterac!‡Souvenez-vous de la vallée d\'Alterac !‡铭记奥特兰克！‡銘記奧特蘭克!',
    nil,
    'Leve 3 Marcas de Honra do Vale Alterac a um General de Brigada da Aliança do lado de fora do campo de batalha.‡Принесите 3 почетных знака Альтеракской долины бригадному генералу Альянса рядом со входом на поле боя.‡Bringt 3 Ehrenabzeichen des Alteractals zu einem der Brigadegeneräle der Allianz, die außerhalb der Schlachtfelder stehen.‡전장 밖에 있는 얼라이언스 준장에게 알터랙 계곡 명예 훈장 3개를 가져가야 합니다.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Entrega 3 marcas de honor del Valle de Alterac a un general de brigada de la Alianza fuera de los campos de batalla.‡Apportez 3 Marques d\'honneur de la vallée d\'Alterac à un général de brigade de l\'Alliance, devant les champs de bataille.‡把3枚奥特兰克山谷荣誉奖章交给战场外的联盟准将。‡把3枚奧特蘭克山谷榮譽獎章交給戰場外的聯盟准將。',
  }
},
