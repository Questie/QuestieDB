[8145] = {
  {
    'A gavinha-da-voragem‡Нить Водоворота‡Die Mahlstromranke‡혼돈의 소용돌이 덩굴손‡Zarcillo de La Vorágine‡Zarcillo de La Vorágine‡Les Vrilles du maelström‡漩涡之藤‡漩渦之藤',
