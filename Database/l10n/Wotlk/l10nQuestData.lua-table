    nil,
  }
},
[2742] = {
  {
    'Rin\'ji está preso!‡Рин\'джи в ловушке‡Rin\'ji steckt in der Falle!‡갇혀 있는 린지‡¡Capturaron a Rin\'ji!‡¡Capturaron a Rin\'ji!‡Rin\'ji est pris au piège !‡林吉被困住了！‡林吉被困住了!',
    nil,
    'Escolte Rin\'ji para fora do Pavilhão Quel\'Danil, depois encontre o segredo que ele esconde nos Penhascos Panorâmicos a leste.‡Выведите Рин\'джи из Сторожки Кель\'Данил, а потом найдите то, что он спрятал в Отвесных скалах, на востоке.‡Eskortiert Rin\'ji aus der Jagdhütte von Quel\'Danil heraus und findet dann das, was er bei den Aussichtsklippen im Osten versteckt hat.‡린지를 호위해 쿠엘다닐 오두막을 빠져나간 후 그가 동쪽 전망대 절벽에 숨겨두었다는 비밀 물건을 찾아야 합니다.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Ayuda a Rin\'ji a salir de la Avanzada Quel\'Danil y encuentra su secreto oculto en los Acantilados Dominantes.‡Escorter Rin\'ji hors du Gîte de Quel\'Danil, puis découvrir son secret caché sur les Hauts-Surplombs, à l\'est.‡护送林吉逃出奎尔丹尼小屋，然后在望海崖找到他藏起来的东西。‡護送林吉逃出奎爾丹尼小屋，然後在望海崖找到他藏起來的東西。',
  }
},
[2743] = {
  {
    'O abrigo das trevas‡Покров Тьмы‡Der Mantel der Dunkelheit‡어둠의 엄습‡La cubierta de la Oscuridad‡La cubierta de la Oscuridad‡Le couvert de l\'obscurité‡黑暗笼罩‡黑暗籠罩',
    nil,
    'Fale novamente com o Herói Caído da Horda e conte suas descobertas.‡Вернитесь к павшему герою Орды со своими находками.‡Kehrt mit Euren neuen Erkenntnissen zum gefallenen Helden der Horde zurück.‡호드 영웅의 넋에게 돌아가서 키리스로부터 알아낸 정보를 보고해야 합니다.‡Vuelve junto al héroe caído de la Horda con tus hallazgos.‡Vuelve junto al héroe caído de la Horda con tus hallazgos.‡Retourner voir le Héros de la Horde tombé au combat avec ces découvertes.‡回去见部落英雄的灵魂，将你的发现告诉他。‡回去見部落英雄的靈魂，將你的發現告訴他。',
  }
},
[2744] = {
  {
    'O caçador de demônios‡Охотник на демонов‡Der Dämonenjäger‡악마사냥꾼‡El cazademonios‡El cazademonios‡Le chasseur de démons‡恶魔猎手‡惡魔獵人',
    nil,
    'Fale com Loramus Talípedes em Azshara.‡Поговорите в Азшаре с Лорамусом Многоногом.‡Sprecht mit Loramus Thalipedes in Azshara.‡아즈샤라에 있는 로라무스 탈리뻬데스와 대화해야 합니다.‡Habla con Loramus Thalimedes en Azshara.‡Habla con Loramus Thalimedes en Azshara.‡Aller voir Loramus Thalipedes en Azshara.‡与艾萨拉的洛拉姆斯·萨里比迪斯谈一谈。‡與艾薩拉的洛拉姆斯·薩里比迪斯談話。',
  }
},
[2745] = {
  {
    'Infiltrando-se no castelo‡Проникновение в крепость‡Eindringen ins Schloss‡성 잠입‡Infíltrate en el castillo‡Infíltrate en el castillo‡En infiltrant le château‡潜入城堡‡潛入城堡',
    nil,
    'Fale com Tyrion no Castelo Ventobravo.‡Поговорите с Тирионом в крепости Штормграда.‡Sprecht in Schloss Sturmwind mit Tyrion.‡스톰윈드 성에 있는 티리온과 대화해야 합니다.‡Habla con Tyrion en el Castillo de Ventormenta.‡Habla con Tyrion en el Castillo de Ventormenta.‡Allez voir Tyrion au Château de Hurlevent.‡与暴风城堡的泰里恩谈一谈。‡與暴風城堡的泰里恩談話。',
  }
},
[2746] = {
  {
    'Itens de alguma consequência‡Все по порядку‡Nicht unwichtige Gegenstände‡변장에 필요한 물건‡Objetos importantes‡Objetos importantes‡Des objets d\'une certaine importance‡必备物品‡必備物品',
    nil,
    'Leve 3 Sedas e 2 Maçãs Frescas da Clara para Tyrion em Ventobravo.‡Принесите Тириону в Штормград 3 отреза шелка и 2 свежих яблока Клары.‡Bringt 3 Stück Seidenstoff und 2 frische Äpfel von Clara nach Sturmwind zu Tyrion.‡스톰윈드에 있는 티리온에게 비단 옷감 3개와 클라라의 싱싱한 사과 2개를 가져가야 합니다.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Lleva 3 paños de seda y 2 manzanas frescas de Clara a Tyrion en Ventormenta.‡Apporter 3 Etoffes de soie et 2 Pommes fraîches de Clara à Tyrion à Hurlevent.‡将3块丝绸和2只克拉拉的新鲜苹果交给暴风城的泰里恩。‡將3塊絲綢和2顆克拉拉的新鮮蘋果交給暴風城的泰里恩。',
  }
},
[2747] = {
  {
    'Um ovo extraordinário‡Необычное яйцо‡Ein außergewöhnliches Ei‡비범한 알‡Un huevo muy especial‡Un huevo muy especial‡Un œuf extraordinaire‡特别的蛋‡特別的蛋',
