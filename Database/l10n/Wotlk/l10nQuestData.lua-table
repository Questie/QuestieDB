[9888] = {
  {
    'O líder impotente‡Слабосильный владыка‡Der unfähige Anführer‡무능력한 지도자‡El líder impotente‡El líder impotente‡Le chef impuissant‡落魄的领袖‡無能的領導者',
    nil,
    'Jorin Olho Morto quer que você encontre e fale com Kilrath.‡Джорин Мертвый Глаз просит вас найти Килрата и поговорить с ним.‡Jorin Totauge möchte, dass Ihr Kilrath sucht und mit ihm sprecht.‡요린 데드아이가 킬라스를 찾아서 대화해 보라고 부탁했습니다.‡Jorin Mortojo te ha pedido que encuentres a Kilrath.‡Jorin Mortojo te ha pedido que encuentres a Kilrath.‡Jorin Œil-mort vous a demandé de trouver Kilrath et de lui parler.‡约林·死眼要你找到吉尔拉斯并跟他谈谈。‡喬林·亡眼要你找到科伊瑞斯並和他談談。',
  }
},
[9889] = {
  {
    'Não mate o gordo‡Толстяка не убивать‡Nicht den Fetten töten!‡뚱뚱한 놈은 죽이지 마세요!‡No mates al gordo‡No mates al gordo‡Ne tuez pas le gros‡别杀那个胖家伙！‡別殺那個胖子',
    nil,
    'Kilrath, da Mata Terokkar, quer que você mate 10 Invasores Punho de Pedra e bata em Unkor, o Desapiedado, até que ele fale.‡Убейте 10 захватчиков из клана Тяжелого Кулака, затем избейте и допросите Анкора Безжалостного.‡Kilrath in den Wäldern von Terokkar möchte, dass Ihr 10 Eindringlinge der Felsfäuste tötet und Unkor den Rücksichtslosen so lange schlagt, bis er redet.‡테로카르 숲에 있는 킬라스가 돌주먹일족 약탈자 10명을 해치우고 학살자 운코르가 자백할 때까지 때려달라고 부탁했습니다.‡Kilrath en el Bosque de Terokkar te ha pedido que mates a 10 invasores Puño de Roca y golpees a Unkor el Despiadado hasta hacerle hablar.‡Kilrath en el Bosque de Terokkar te ha pedido que mates a 10 invasores Puño de Roca y golpees a Unkor el Despiadado hasta hacerle hablar.‡Kilrath, dans la forêt de Terokkar, vous a demandé de tuer 10 Envahisseurs Rochepoing, et de frapper Unkor le Brutal jusqu\'à ce qu\'il parle.‡泰罗卡森林的吉尔拉斯要求你杀死10名石拳入侵者，并击败无情的安克尔，让他招供。‡泰洛卡森林的科伊瑞斯要你殺死10個石拳侵略者並鞭打無情的昂庫爾直到他說話為止。',
  }
},
[9890] = {
  {
    'Êxito!‡Готово!‡Erfolg!‡성공!‡¡Éxito!‡¡Éxito!‡Victoire !‡成功了！‡成功!',
    nil,
    'Leve as informações que você arrancou de Unkor para Kilrath, na Mata Terokkar.‡Передайте все сведения, которые вы выбили из Анкора, Килрату в лес Тероккар.‡Teilt Kilrath in den Wäldern von Terokkar die Informationen, die Ihr aus dem Oger geprügelt habt, mit.‡테로카르 숲에 있는 킬라스에게 학살자 운코르를 두들겨 패서 자백받은 정보를 전해야 합니다.‡Ve al Bosque de Terokkar y cuéntale a Kilrath lo que le has hecho a Unkor.‡Ve al Bosque de Terokkar y cuéntale a Kilrath lo que le has hecho a Unkor.‡Transmettez à Kilrath, dans la forêt de Terokkar, les informations arrachées à Unkor.‡返回泰罗卡森林，将安克尔供述的秘密告诉吉尔拉斯。‡帶著你從昂庫爾那裡得知的消息去找泰洛卡森林的科伊瑞斯。',
  }
},
[9891] = {
  {
    'Porque Kilrath é um covarde‡Потому что Килрат – трус‡Weil Kilrath ein Feigling ist‡겁쟁이 킬라스‡Porque Kilrath es un cobarde‡Porque Kilrath es un cobarde‡Parce que Kilrath est un lâche‡吉尔拉斯这个懦夫！‡科伊瑞斯是懦夫',
    nil,
    'Leve as informações que você arrancou de Unkor para Jorin Olho Morto na cidade de Garadar, em Nagrand.‡Передайте информацию, которую вы выбили из Анкора, Джорину Мертвому Глазу в Гарадаре.‡Erzählt Jorin Totauge in Garadar in Nagrand, was Ihr aus Unkor herausprügeln konntet.‡나그란드의 가라다르에 있는 요린 데드아이에게 당신이 운코르를 때려서 자백받은 정보를 전해야 합니다.‡Ve a Garadar, en Nagrand, y cuéntale a Jorin Mortojo que has vencido a Unkor.‡Ve a Garadar, en Nagrand, y cuéntale a Jorin Mortojo que has vencido a Unkor.‡Transmettez les informations arrachées à Unkor à Jorin Œil-mort, à Garadar en Nagrand.‡返回纳格兰的加拉达尔，将安克尔供述的秘密告诉约林·死眼。‡帶著你從昂庫爾那裡得知的消息去納葛蘭找卡拉達爾的喬林·亡眼。',
  }
},
[9892] = {
  {
    'Mais colares de guerra obsidianos‡Поиски обсидиановых боевых ожерелий‡Noch mehr Obsidiankriegsperlen‡흑요석 전투 목걸이 추가 수집‡Más abalorios de guerra de obsidiana‡Más abalorios de guerra de obsidiana‡Encore des perles de guerre d\'obsidienne‡更多黑曜石作战念珠‡更多黑曜石戰爭串珠',
    nil,
    nil,
  }
},
[9893] = {
  {
    'Colar de guerra obsidiano‡Обсидиановое боевое ожерелье‡Obsidiankriegsperlen‡흑요석 전투 목걸이‡Abalorios de guerra de obsidiana‡Abalorios de guerra de obsidiana‡Les perles de guerre d\'obsidienne‡黑曜石作战念珠‡黑曜石戰爭串珠',
    nil,
    'Leve 10 Colares de Guerra Obsidianos para Gezhe, no Posto Aeris, em Nagrand.‡Принесите 10 обсидиановых боевых ожерелий Гезхе в Небесный лагерь в Награнде.‡Bringt 10 Obsidiankriegsperlen zu Gezhe beim Aerissteg in Nagrand.‡나그란드의 에어리스 착륙지에 있는 게제에게 흑요석 전투 목걸이 10개를 가져가야 합니다.‡Lleva 10 abalorios de guerra de obsidiana a Gezhe en el Desembarco Aeris, en Nagrand.‡Lleva 10 abalorios de guerra de obsidiana a Gezhe en el Desembarco Aeris, en Nagrand.‡Apportez 10 Perles de guerre d\'obsidienne à Gezhe, du Point d\'ancrage Aeris en Nagrand.‡将10串黑曜石作战念珠交给纳格兰埃瑞斯码头的杰赫。‡帶10個黑曜石戰爭串珠到納葛蘭交給艾瑞斯平臺的吉札。',
  }
},
[9894] = {
  {
    'Proteja as sentinelas‡Защита наблюдателей‡Schützt die Behüter‡감시자 보호‡Vigilando a los vigías‡Vigilando a los vigías‡Protéger les guetteurs‡保护观察者‡保護守夜人',
    nil,
    'Mate Lorde Klaq e fale novamente com a Arauto do Vento Casco Negro, no Refúgio Cenariano.‡Убейте владыку Клака и вернитесь к призывательнице ветров Черное Копыто в Кенарийский приют.‡Tötet Lord Klaq und kehrt danach zu Windruferin Schwarzhuf in der Zuflucht des Cenarius zurück.‡우두머리 클라크를 처치한 후 세나리온 야영지에 있는 바람소환사 블랙후프에게 돌아가야 합니다.‡Mata a Lord Klaq y vuelve a ver a Clamavientos Pezuña Negra en el Refugio Cenarion.‡Mata a Lord Klaq y vuelve a ver a Clamavientos Pezuña Negra en el Refugio Cenarion.‡Tuez le seigneur Klaq et retournez voir l\'imploratrice céleste Sabot-noir au Refuge cénarien.‡杀死克拉其大王，然后向塞纳里奥庇护所的唤风者塔鲁·黑蹄复命。‡殺了卡拉奎領主再回到塞納里奧避難所向喚風者黑蹄回報。',
  }
},
[9895] = {
  {
    'O equilíbrio agonizante‡Гибнущее равновесие‡Aus dem Gleichgewicht geraten‡균형의 붕괴‡La balanza de la vida y la muerte‡Equilibrio en extinción‡L\'équilibre se meurt‡崩溃的平衡‡垂死的平衡',
    nil,
    'Encontre e acabe com o Pantacílio, então fale novamente com Lethyn Flameluna, no Refúgio Cenariano.‡Найдите Топехлыста и уничтожьте его, потом вернитесь к Летину Лунному Пламени в Кенарийский приют.‡Sucht und vernichtet Sumpfschläger und kehrt dann zu Lethyn Mondfeuer in der Zuflucht des Cenarius zurück.‡수렁채찍을 찾아서 처치한 후 세나리온 야영지에 있는 레신 문파이어에게 돌아가야 합니다.‡Localiza y enfréntate a Látigo de ciénaga y, a continuación, vuelve a ver a Lethyn Fuegolunar en el Refugio Cenarion.‡Localiza y enfréntate a Látigo de ciénaga y, a continuación, vuelve a ver a Lethyn Fuegolunar en el Refugio Cenarion.‡Trouvez Fouettourbe et occupez-vous de lui, puis retournez voir Lethyn Lunéclat au Refuge cénarien.‡找到沼泽之鞭并杀死它，然后向塞纳里奥庇护所的莱森·月火复命。‡找到並解決掉伯克拉斯，再回到塞納里奧避難所向萊司恩·月火回報。',
  }
},
[9896] = {
  {
    'A desgraça do Aguilhão Negro‡Проклятие черной бракониды‡Schwarzsichels Fluch‡검은쐐기의 맹독‡La pesadilla de Aguijonegro‡La pesadilla de Aguijonegro‡La mort d\'Aiguillon-noir‡黑钉之刺‡黑刺的螫針的毀滅',
    nil,
    'Traga o Ferrão do Aguilhão Negro para o Prospector Conall, em Telredor.‡Принесите жало черной бракониды геологу Коналлу в Телредор.‡Bringt Schwarzsichels Stachel zu Ausgrabungsleiter Conall in Telredor.‡텔레도르에 있는 발굴조사단장 코날에게 검은쐐기의 독침을 가져가야 합니다.‡Lleva el aguijón de Aguijonegro al prospector Conall en Telredor.‡Lleva el aguijón de Aguijonegro al prospector Conall en Telredor.‡Apportez l\'Aiguillon d\'Aiguillon-noir au prospecteur Conall à Telredor.‡将黑钉之刺交给泰雷多尔的勘探员柯纳尔。‡將黑刺的螫針交給泰倫多爾的勘察員康歐。',
  }
},
[9897] = {
  {
    'Sã e salva!‡Я спасена!‡Ich bin gerettet!‡해방!‡¡A salvo!‡¡A salvo!‡Je suis sauvée !‡我得救了！‡我得救了!',
    nil,
    'Entregue o Fardo de Peles para Manuelzão, no Safári Rosarães, em Nagrand.‡Отнесите сверток шкур Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Gebt Harold Fährten bei Nesingwarys Safari in Nagrand das Bündel mit Tierhäuten.‡나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 가죽 꾸러미를 줘야 합니다.‡Entrega el fajo de pieles a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Entrega el fajo de pieles a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Donnez le Paquet de peaux à Harold Lane, au safari de Nesingwary en Nagrand.‡将一捆皮革交给纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩。‡將大批皮革帶到納葛蘭交給奈辛瓦里狩獵隊的哈洛德·蘭恩。',
  }
},
[9898] = {
  {
    'Respeito ao próximo‡Уважение к ближнему‡Respekt erlangen‡타인의 인정‡El respeto ajeno‡Una proeza digna de respeto‡Le prix du respect‡对方的尊重‡展示敬意',
    nil,
    'Traga o Ferrão do Aguilhão Negro para Reavij, no Mocó do Rato Lamacento.‡Принесите жало черной бракониды Реавижу на заставу Болотной Крысы.‡Bringt Schwarzsichels Stachel zu Reavij im Sumpfrattenposten.‡늪쥐 감시초소에 있는 레아비즈가 검은쐐기의 독침을 가져다 달라고 부탁했습니다.‡Lleva el aguijón de Aguijonegro a Reavij en la Avanzada Rata del Pantano.‡Lleva el aguijón de Aguijonegro a Reavij en la Avanzada Rata del Pantano.‡Apportez l\'Aiguillon d\'Aiguillon-noir à Reavij, au poste du Rat des marais.‡将黑钉之刺交给沼泽鼠岗哨的里维伊。‡將黑刺的螫針交給斯溫派特崗哨的瑞伏基。',
  }
},
[9899] = {
  {
    'Um trabalho não feito‡Несделанное дело‡Unerledigte Arbeit‡처리 대상‡Un trabajo sin terminar‡Un trabajo sin terminar‡Un boulot pas fini‡未完的职责‡未完成的工作',
    nil,
    'Magasha, no Mocó do Rato Lamacento, quer que você mate o Asesporo.‡Убейте Спорокрыла по просьбе Магаши с заставы Болотной Крысы.‡Magasha im Sumpfrattenposten möchte, dass Ihr Sporenschwinge tötet.‡늪쥐 감시초소에 있는 마가샤가 포자박쥐를 처치해 달라고 부탁했습니다.‡Magasha en la Avanzada Rata del Pantano quiere que mates a Esporala.‡Magasha en la Avanzada Rata del Pantano quiere que mates a Esporala.‡Magasha, au poste du Rat des marais, veut que vous tuiez Sporailée.‡沼泽鼠岗哨的玛加沙要你杀死孢子之翼。‡斯溫派特崗哨的瑪卡莎要你去殺了斯柏溫。',
  }
},
[9900] = {
  {
    'Gava\'xi‡Гава\'кси‡Gava\'xi‡가바시‡Gava\'xi‡Gava\'xi‡Gava\'xi‡加瓦克希‡卡沃希',
    nil,
    'Mate Gava\'xi perto de Oshu\'gun e fale novamente com Zerid no Posto Aeris, em Nagrand.‡Убейте Гава\'кси, который скрывается близ Ошу\'гуна, и возвращайтесь к Зериду в Небесный лагерь в Награнде.‡Tötet Gava\'xi in der Nähe des Oshu\'gun und kehrt dann zu Zerid beim Aerissteg in Nagrand zurück.‡오슈군 근처에 있는 가바시를 해치운 후 나그란드의 에어리스 착륙지에 있는 제리드에게 돌아가십시오.‡Mata a Gava\'xi cerca de Oshu\'gun y vuelve a ver a Zerid en el Desembarco Aeris, en Nagrand.‡Mata a Gava\'xi cerca de Oshu\'gun y vuelve a ver a Zerid en el Desembarco Aeris, en Nagrand.‡Tuez Gava\'xi près d\'Oshu\'gun, puis retournez voir Zerid au Point d\'ancrage Aeris, en Nagrand.‡杀死沃舒古附近的加瓦克希，然后向纳格兰埃瑞斯码头的瑟利德复命。‡殺了歐夏剛附近的卡沃希再回到納葛蘭找艾瑞斯平臺的澤瑞德。',
  }
},
[9901] = {
  {
    'Negócios inacabados‡Неоконченное дело‡Offene Rechnung‡아직 해결되지 않은 문제‡Negocios inconclusos‡Negocios inconclusos‡Un travail inachevé‡遗留事务‡未完成的任務',
    nil,
    'Prospector Conall, em Telredor, quer que você mate Asesporo.‡Убейте Спорокрыла по просьбе геолога Коналла из Телредора.‡Ausgrabungsleiter Conall in Telredor möchte, dass Ihr Sporenschwinge tötet.‡텔레도르에 있는 발굴조사단장 코날이 포자박쥐를 처치해 달라고 부탁했습니다.‡El prospector Conall en Telredor quiere que mates a Esporala.‡El prospector Conall en Telredor quiere que mates a Esporala.‡Le prospecteur Conall de Telredor veut que vous tuiez Sporailée.‡泰雷多尔的勘探员柯纳尔要求你干掉孢子之翼。‡泰倫多爾的勘察員康歐要你去殺死斯柏溫。',
  }
},
[9902] = {
  {
    'O terror do Lago Pantanoso‡Ужас озера Болотных Огоньков‡Der Schrecken des Sumpflichtsees‡수렁등불 호수의 공포‡El terror del Lago Luz Pantanosa‡El terror del Lago Luz Pantanosa‡La terreur du lac des furoles‡沼光湖的恐怖‡恐怖的沼澤光之湖',
    nil,
    'Mate o Terrogarra e fale novamente com Puluu, em Porto Orebor.‡Убейте Жутеклешня и вернитесь к Пулуу в прибежище Оребор.‡Tötet Terrorklaue und kehrt dann zu Puluu in der Oreborzuflucht zurück.‡공포의 집게발을 처치한 후 오레보르 피난처에 있는 풀루우에게 돌아가야 합니다.‡Mata a Terrogarra y ve a ver a Puluu en el Puerto Orebor.‡Mata a Terrogarra y ve a ver a Puluu en el Puerto Orebor.‡Tuez Griffe de terreur et retournez voir Puluu au Havre d\'Orebor.‡杀死恐爪，然后向奥雷柏尔营地的普尔鲁复命。‡殺了恐懼之爪再回到奧雷伯爾港向保魯回報。',
  }
},
[9903] = {
  {
    'O maior de todos‡Самый здоровенный‡Der Größte von allen‡덩치만 큰 퇴물‡El más grande de todos‡El más grande de todos‡Le plus gros de tous‡多头蛇之王‡最大的挑戰',
    nil,
    'Mate Mragesh e fale novamente com Zurjaya em Zabra\'jin.‡Убейте Мрагеша и вернитесь к Зурджайе в Забра\'джин.‡Tötet Mragesh und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡므라게쉬를 해치운 후 자브라진에 있는 주르자야에게 돌아가십시오.‡Mata a Mragesh y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata a Mragesh y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez Mragesh et retournez voir Zurjaya à Zabra\'jin.‡杀死穆拉格什，然后向萨布拉金的苏尔加亚复命。‡殺死莫拉吉斯再回到薩布拉金向祖賈亞回報。',
  }
},
[9904] = {
  {
    'Perseguição pelo Terrogarra‡Охота на Жутеклешня‡Jagd auf Terrorklaue‡공포의 집게발 사냥‡La persecución de Terrogarra‡La persecución de Terrogarra‡À la poursuite de Griffe de terreur‡猎杀恐爪‡抓到恐懼之爪',
    nil,
    'Mate o Terrogarra e fale novamente com Zurjaya, em Zabra\'jin.‡Убейте Жутеклешня и вернитесь к Зурджайе в Забра\'джин.‡Tötet Terrorklaue und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡공포의 집게발을 해치운 후 자브라진에 있는 주르자야에게 돌아가야 합니다.‡Mata a Terrogarra y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata a Terrogarra y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez Griffe de terreur et retournez voir Zurjaya à Zabra\'jin.‡杀死恐爪，然后向萨布拉金的苏尔加亚复命。‡殺了恐懼之爪再回到薩布拉金向祖賈亞回報。',
  }
},
[9905] = {
  {
    'A vingança de Maktu‡Месть Макту‡Maktus Rache‡막투의 복수‡La venganza de Maktu‡La venganza de Maktu‡La vengeance de Maktu‡玛克图的复仇‡瑪克吐的復仇',
    nil,
    'Encontre e mate Mragesh, então fale novamente com Maktu, em Porto Orebor.‡Найдите и убейте Мрагеша, и вернитесь к Макту в прибежище Оребор.‡Sucht und tötet Mragesh und kehrt dann zu Maktu in der Oreborzuflucht zurück.‡므라게쉬를 찾아 처치한 후 오레보르 피난처에 있는 막투에게 돌아가야 합니다.‡Encuentra y mata a Mragesh, a continuación vuelve a ver a Maktu en el Puerto Orebor.‡Encuentra y mata a Mragesh, a continuación vuelve a ver a Maktu en el Puerto Orebor.‡Trouvez et tuez Mragesh, puis retournez voir Maktu au Havre d\'Orebor.‡找到穆拉格什并杀死他，然后返回奥雷柏尔营地向玛克图复命。‡找到並殺死莫拉吉斯，再回到奧雷伯爾港向瑪克吐回報。',
  }
},
[9906] = {
  {
    'Mensagem de guerra‡Клинок вместо слов‡Sag\'s mit Fäusten‡전투를 통한 전갈‡Mensaje en una batalla‡Mensaje en una batalla‡Un message dans une bataille‡粗暴的信号‡戰鬥的訊息',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você mate 8 Esmagadores Punho de Pedra e 8 Místicos Punho de Pedra.‡Джорин Мертвый Глаз из Гарадара в Награнде просит вас убить 8 сокрушителей и 8 мистиков из клана Тяжелого Кулака.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr 8 Zermalmer der Felsfäuste und 8 Mystiker der Felsfäuste tötet.‡나그란드의 가라다르에 있는 요린 데드아이가 돌주먹일족 비술사와 돌주먹일족 장사를 8명씩 해치워 달라고 부탁했습니다.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 8 trituradores Puño de Roca y 8 místicos Puño de Roca.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 8 trituradores Puño de Roca y 8 místicos Puño de Roca.‡Jorin Œil-mort, de Garadar en Nagrand, vous a demandé de tuer 8 Écraseurs Rochepoing et 8 Mystiques Rochepoing.‡纳格兰加拉达尔的约林·死眼要你杀死8个石拳打击者和8个石拳秘术师。‡納葛蘭，卡拉達爾的喬林·亡眼要你殺死8個石拳粉碎者和8個石拳秘法師。',
  }
},
[9907] = {
  {
    'Uma ofensiva audaciosa‡Дерзкий набег‡Ein kühner Angriff‡대담한 전진‡Un audaz avance‡Un audaz avance‡Une avancée audacieuse‡大胆的攻势‡大膽前進',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você mate 10 Guerreiros Punho de Pedra e 10 Magos Punho de Pedra.‡Джорин Мертвый Глаз из Гарадара в Награнде просит вас убить 10 воинов и 10 магов из клана Тяжелого Кулака.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr 10 Krieger der Felsfäuste und 10 Magier der Felsfäuste tötet.‡나그란드의 가라다르에 있는 요린 데드아이가 돌주먹일족 전사와 돌주먹일족 마법사를 10명씩 해치워달라고 부탁했습니다.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 10 guerreros Puño de Roca y 10 magos Puño de Roca.‡Jorin Mortojo en Garadar, en Nagrand, te ha pedido que mates 10 guerreros Puño de Roca y 10 magos Puño de Roca.‡Jorin Œil-mort, de Garadar en Nagrand, vous a demandé de tuer 10 Guerriers Rochepoing et 10 Mages Rochepoing.‡纳格兰加拉达尔的约林·死眼要你杀死10个石拳战士和10个石拳法师。‡納葛蘭，卡拉達爾的喬林·亡眼要你殺死10個石拳戰士和10個石拳法師。',
  }
},
[9910] = {
  {
    'Práticas e padrões‡Страх и уважение‡Standarten‡깃발 훈련‡Confalones y prácticas‡Confalones y prácticas‡Étendards au vent...‡扬旗示威‡軍旗與實行',
    nil,
    'Elky\'gan, o Místico, de Garadar, em Nagrand, quer que você finque Estandartes de Batalha Mag\'har na Primeira, na Segunda e na Terceira Piras da Lâmina Ardente. Devolva a Elky\'gan os estandartes restantes quando terminar.‡Установите по одному боевому штандарту маг\'харов возле первого, второго и третьего погребальных костров клана Пылающего Клинка. Когда выполните поручение, верните Илкай\'гану Мистику оставшиеся штандарты.‡Mystiker Elkay\'gan in Garadar in Nagrand möchte, dass Ihr eine Schlachtstandarte der Mag\'har am ersten, zweiten und dritten Scheiterhaufen der Brennenden Klinge aufstellt. Bringt die übrigen Schlachtstandarten zurück, wenn Ihr fertig seid.‡나그란드의 가라다르에 있는 비술사 엘카이간이 서로 다른 3개의 불타는 칼날단 장작불에서 마그하르 전투 깃발을 사용해 달라고 부탁했습니다. 일을 마치면 사용한 마그하르 전투 깃발을 그에게 가져가야 합니다.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que utilices un confalón de batalla Mag\'har en la primera pira ardiendo Filo Ardiente, en la segunda pira ardiendo Filo Ardiente y en la tercera pira ardiendo Filo Ardiente. Devuelve los confalones de batalla Mag\'har que no hayas utilizado cuando termines.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que utilices un confalón de batalla Mag\'har en la primera pira ardiendo Filo Ardiente, en la segunda pira ardiendo Filo Ardiente y en la tercera pira ardiendo Filo Ardiente. Devuelve los confalones de batalla Mag\'har que no hayas utilizado cuando termines.‡Elkay\'gan le Mystique, de Garadar en Nagrand, veut que vous placiez des Étendards de bataille des Mag\'har au Premier, Deuxième, et Troisième bûchers de la Lame ardente. Lorsque vous aurez terminé, allez lui rendre les Étendards de bataille des Mag\'har restants.‡纳格兰加拉达尔的秘法师埃尔卡甘要你将玛格汉军旗分别插在第一堆火刃篝火、第二堆火刃篝火和第三堆火刃篝火附近。完成任务后将剩余的玛格汉军旗还给他。‡納葛蘭，卡拉達爾的『秘法師』伊萊克根要你在第一個燃刃柴堆、第二個燃刃柴堆以及第三個燃刃柴堆上使用瑪格哈戰鬥戰旗。完成後將瑪格哈戰鬥戰旗還給他。',
  }
},
[9911] = {
  {
    'O conde dos pântanos‡Владыка болот‡Der Graf der Marschen‡습지대의 생물들‡El conde de las marismas‡El conde de las marismas‡Le comte des marécages‡沼泽中的伯爵‡沼澤的伯爵',
    nil,
    'Traga a Mandíbula do "Conde" Ungula para a Vigia Leesa\'oh no Posto Avançado Cenariano, no Pântano Zíngaro.‡Принесите челюсть "Графа" Унгула наблюдательнице Лиса\'о на Кенарийский караульный пост, что в Зангартопи.‡Bringt "Graf" Ungulas Beißwerkzeug zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 초소에 있는 관찰자 리사오에게 백작 운굴라의 아래턱을 가져가야 합니다.‡Lleva la mandíbula del "Conde" Ungula a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Lleva la mandíbula del "Conde" Ungula a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Remettez la Mandibule du « Comte » Ungula à la gardienne Leesa’oh à l\'Avant-poste cénarien, au Marécage de Zangar.‡将“伯爵”昂古拉的下颚骨交给赞加沼泽中塞纳里奥哨站的观察者莉萨奥。‡到贊格沼澤的塞納里奧看守站，將『伯爵』安古拉的上顎帶給看守者里薩歐。',
  }
},
[9912] = {
  {
    'A Expedição Cenariana‡Кенарийская экспедиция‡Die Expedition des Cenarius‡세나리온 원정대‡La Expedición Cenarion‡La Expedición Cenarion‡L\'Expédition cénarienne‡塞纳里奥远征队‡塞納里奧遠征隊',
    nil,
    'Fale com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Поговорите с Исиэль Песнью Ветра в Кенарийском приюте в Зангартопи.‡Sprecht mit Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어와 대화해야 합니다.‡Habla con Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Habla con Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Parlez à Ysiel Chantelevent, au Refuge cénarien du marécage de Zangar.‡前往赞加沼泽的塞纳里奥庇护所，与伊谢尔·风歌谈一谈。‡到贊格沼澤的塞納里奧避難所和伊斯歐·風詠談談。',
  }
},
[9913] = {
  {
    'O Consórcio precisa de você!‡Консорциум ждет вас‡Das Konsortium braucht Euch!‡무역연합이 당신을 부른다!‡¡El Consorcio te necesita!‡¡El Consorcio te necesita!‡Le Consortium a besoin de vous !‡星界财团需要你！‡聯合團需要你!',
    nil,
    'Reporte-se a Gezhe no Posto Aeris, em Nagrand.‡Обратитесь к Гезхе. Его можно найти в Небесном лагере в Награнде.‡Meldet Euch bei Gezhe beim Aerissteg in Nagrand.‡나그란드의 에어리스 착륙지에 있는 게제에게 보고해야 합니다.‡Preséntate ante Gezhe en el Desembarco Aeris, en Nagrand.‡Preséntate ante Gezhe en el Desembarco Aeris, en Nagrand.‡Présentez-vous à Gezhe au Point d\'ancrage Aeris en Nagrand.‡向纳格兰埃瑞斯码头的杰赫报到。‡到納葛蘭向艾瑞斯平臺的吉札報告。',
  }
},
[9914] = {
  {
    'Cabeça de marfim‡Кость на вес золота‡Ein ganzer Kopf voll Elfenbein‡상아 수집‡Una cabeza llena de marfil‡Una cabeza llena de marfil‡De l\'ivoire plein la tête‡象牙生意‡象長牙',
    nil,
    'Recolha 3 Pares de Presas de Marfim e entregue-as para Shadrek, em Posto Aeris, em Nagrand.‡Добудьте 3 пары бивней элекков и принесите их Шадреку в Небесный лагерь в Награнде.‡Sammelt 3 Paar Elfenbeinstoßzähne und kehrt dann zu Shadrek beim Aerissteg in Nagrand zurück.‡3쌍의 상아를 모은 후 나그란드의 에어리스 착륙지에 있는 샤드렉에게 가져가야 합니다.‡Consigue 3 pares de colmillos de marfil y llévaselos a Shadrek en el Desembarco Aeris, en Nagrand.‡Consigue 3 pares de colmillos de marfil y llévaselos a Shadrek en el Desembarco Aeris, en Nagrand.‡Récupérez 3 Paires de défenses d\'ivoire et rapportez-les à Shadrek, au Point d\'ancrage Aeris en Nagrand.‡将3对象牙交给纳格兰埃瑞斯码头的沙德雷克。‡收集3對象長牙帶回納葛蘭交給艾瑞斯平臺的薩德瑞克。',
  }
},
[9915] = {
  {
    'Mais cabeças de marfim‡Кость на вес воздуха‡Noch mehr Elfenbein‡상아 추가 수집‡Más cabezas llenas de marfil‡Más cabezas llenas de marfil‡Encore plus d\'ivoire plein la tête‡更多象牙‡更多象長牙',
    nil,
    nil,
  }
},
[9916] = {
  {
    'Caixas de suprimentos dos Olhos Sangrentos‡Припасы клана Кровавой Глазницы‡Vorratskisten des Blutenden Auges‡피투성이굴부족 보급상자‡Cajones de suministros Foso Sangrante‡Cajones de suministros Foso Sangrante‡Les caisses de fournitures de l\'Orbite-sanglante‡血环补给箱‡血之谷補給木箱',
    nil,
    'Elky\'gan, o Místico, da cidade de Garadar, em Nagrand, quer que você recupere 10 Caixas de Suprimentos Olhos Sangrentos.‡Найдите 10 ящиков с припасами клана Кровавой Глазницы и принесите их Илкай\'гану Мистику.‡Mystiker Elkay\'gan in Garadar in Nagrand möchte, dass Ihr 10 Vorratskisten des Blutenden Auges wiederbesorgt.‡나그란드의 가라다르에 있는 비술사 엘카이간이 피투성이굴부족 보급상자 10개를 되찾아 달라고 부탁했습니다.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que recuperes 10 cajones de suministros Foso Sangrante.‡Elkay\'gan el Místico en Garadar, en Nagrand, quiere que recuperes 10 cajones de suministros Foso Sangrante.‡Elkay\'gan le Mystique, de Garadar en Nagrand, veut que vous récupériez 10 Caisses de fournitures de l\'Orbite-sanglante.‡纳格兰加拉达尔的秘法师埃尔卡甘要你找回10个血环补给箱。‡納葛蘭，卡拉達爾的『秘法師』伊萊克根要你取得10個血之谷補給木箱。',
  }
},
[9917] = {
  {
    'É uma miragem?‡Не верь глазам своим‡Kann ich meinen Augen trauen?‡보고도 믿기 힘든 일‡¿Me engañan mis ojos?‡¿Me engañan mis ojos?‡Est-ce que je rêve...‡是我眼花了？‡我眼花了嗎',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você recupere os planos dos Punho de Pedra.‡Добудьте планы клана Тяжелого Кулака для охотницы Бинтук из Телаара.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr die Pläne der Felsfäuste besorgt.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 돌주먹일족 계획서를 찾아와 달라고 부탁했습니다.‡La cazadora Bintook en Telaar, en Nagrand, quiere que consigas los planes de los Puño de Roca.‡La cazadora Bintook en Telaar, en Nagrand, quiere que consigas los planes de los Puño de Roca.‡La chasseresse Bintook, de Telaar en Nagrand, veut que vous récupériez les Plans rochepoing.‡找回石拳计划书，然后向纳格兰塔拉的女猎手彬图克复命。‡納葛蘭，泰拉的女獵人班吐克要你取得石拳計畫。',
  }
},
[9918] = {
  {
    'Não no meu turno!‡Только не в мою смену!‡Nicht solange ich hier wache!‡당직이 아닌 날에는...‡¡No en mi turno!‡¡No durante mi guardia!‡Pas de ça chez moi !‡这是我的地盘！‡在我的看守下門都沒有!',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você converse com o Caroço. Fale novamente com a caçadora Bintook após reunir as informações solicitadas.‡Поговорите с Глыбом. Когда получите необходимые сведения, возвращайтесь к охотнице Бинтук.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr mit Brocken sprecht. Kehrt zu Jägerin Bintook zurück, wenn Ihr die geforderten Informationen gesammelt habt.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 룸프와 대화한 후, 그녀가 부탁한 정보를 모두 모으면 여사냥꾼 빈투크에게 돌아와 달라고 부탁했습니다.‡La cazadora Bintook en Telaar, en Nagrand, quiere que hables con Zoquete. Vuelve a ver a la cazadora Bintook cuando hayas obtenido la información que necesita.‡La cazadora Bintook en Telaar, en Nagrand, quiere que hables con Zoquete. Vuelve a ver a la cazadora Bintook cuando hayas obtenido la información que necesita.‡La chasseresse Bintook, de Telaar en Nagrand, veut que vous parliez à Gros-tas. Retournez la voir lorsque vous aurez obtenu les informations dont elle a besoin.‡与拉普交谈，获取足够的情报后向纳格兰塔拉的女猎手彬图克复命。‡納葛蘭，泰拉的女獵人班吐克要你去和浪普談談。等你收集到女獵人班吐克要的資訊再回去找她。',
  }
},
[9919] = {
  {
    'Sporeggar‡Спореггар‡Sporeggar‡스포어가르‡Esporaggar‡Esporaggar‡Sporeggar‡孢子村‡斯博格爾',
    nil,
    'Vá a Sporeggar, no Pântano Zíngaro, ao norte do Vale dos Rebentos e entregue os Esporângios Recuperados para Msshi\'fn.‡Отправляйтесь в Спореггар, что в Зангартопи, к северу от Грибной поляны, и отнесите спасенные мешочки спор Мссхи\'фну.‡Geht nach Sporeggar, nördlich vom Pilzgeflecht in den Zangarmarschen, und bringt die geborgenen Sporensäcke zu Msshi\'fn.‡장가스 습지대의 부화의 골짜기의 북쪽에 있는 스포어가르로 가서 므쉬픈에게 보존된 포자 주머니를 전해야 합니다.‡Ve a Esporaggar en La Marisma de Zangar, al norte de La Cañada Emergente, y lleva las bolsas de esporas rescatadas a Msshi\'fn.‡Ve a Esporaggar en La Marisma de Zangar, al norte de La Cañada Emergente, y lleva las bolsas de esporas rescatadas a Msshi\'fn.‡Allez à Sporeggar, au Marécage de Zangar, au nord du vallon des pontes, et apportez les Sacs de spores récupérés à Msshi\'fn.‡去赞加沼泽孢殖林北边的孢子村，将抢救出来的孢子囊交给姆希菲。‡前往贊格沼澤的斯博格爾，其位於重生峽谷北邊，然後把獲救的孢子囊交給米斯恩。',
  }
},
[9920] = {
  {
    'Mo\'mor, o Destruidor‡Мо\'мор Разрушитель‡Mo\'mor der Brecher‡파괴자 모모르‡Mo\'Mor el Rompedor‡Mo\'Mor el Rompedor‡Mo\'mor le Briseur‡击碎者姆摩尔‡『破壞者』哞哞爾',
    nil,
    'A caçadora Bintook, da vila de Telaar, em Nagrand, quer que você converse com Mo\'mor, o Destruidor.‡Охотница Бинтук из Телаара хочет, чтобы вы поговорили с Мо\'мором Разрушителем.‡Jägerin Bintook in Telaar in Nagrand möchte, dass Ihr mit Mo\'mor dem Brecher redet.‡나그란드의 텔라아르에 있는 여사냥꾼 빈투크가 파괴자 모모르와 대화해 보라고 부탁했습니다.‡La cazadora Bintook de Telaar en Nagrand quiere que hables con Mo\'mor el Rompedor.‡La cazadora Bintook de Telaar en Nagrand quiere que hables con Mo\'mor el Rompedor.‡La chasseresse Bintook, à Telaar en Nagrand, veut que vous parliez à Mo\'mor le Briseur.‡纳格兰塔拉的女猎手彬图克要你去找击碎者姆摩尔谈一谈。‡納葛蘭，泰拉的女獵人班吐克要你去和『破壞者』哞哞爾談談。',
  }
},
[9921] = {
  {
    'As ruínas da Lâmina Ardente‡Руины Пылающего Клинка‡Die Ruinen der Brennenden Klinge‡불타는 칼날 폐허‡Las Ruinas Filo Ardiente‡Las Ruinas Filo Ardiente‡Les ruines de la Lame ardente‡火刃废墟‡燃刃廢墟',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você mate 8 agressores Punho de Pedra e 8 devotos Punho de Pedra.‡Мо\'мор Разрушитель из Телаара желает, чтобы вы убили 8 мистиков и 8 сокрушителей из клана Тяжелого Кулака.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr 8 Zermalmer der Felsfäuste und 8 Mystiker der Felsfäuste tötet.‡나그란드의 텔라아르에 있는 파괴자 모모르가 돌주먹일족 장사와 돌주먹일족 비술사를 각각 8명씩 처치해 달라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 8 trituradores y 8 místicos Puño de Roca.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 8 trituradores y 8 místicos Puño de Roca.‡Mo\'mor le Briseur, à Telaar en Nagrand, veut que vous tuiez 8 Écraseurs Rochepoing et 8 Mystiques Rochepoing.‡杀死8个石拳打击者和8个石拳秘术师，然后向纳格兰塔拉的击碎者姆摩尔复命。‡納葛蘭，泰拉的『破壞者』哞哞爾要你去殺死8個石拳粉碎者和8個石拳秘法師。',
  }
},
[9922] = {
  {
    'As furnas gêmeas de Nagrand‡Расселины Награнда‡Die Zwillingsschluchten von Nagrand‡나그란드의 쌍둥이 동굴‡Las fallas gemelas de Nagrand‡Las fallas gemelas de Nagrand‡Les failles jumelles de Nagrand‡纳格兰的峡谷‡納葛蘭的雙子斷崖',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você mate 10 guerreiros Punho de Pedra e 10 magos Punho de Pedra.‡Мо\'мор Разрушитель из Телаара желает, чтобы вы убили 10 воинов и 10 магов клана Тяжелого Кулака.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr 10 Krieger der Felsfäuste und 10 Magier der Felsfäuste tötet.‡나그란드의 텔라아르에 있는 파괴자 모모르가 돌주먹일족 전사와 돌주먹일족 마법사를 10명씩 처치해 달라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 10 guerreros y 10 magos Puño de Roca.‡Mo\'mor el Rompedor de Telaar en Nagrand quiere que mates a 10 guerreros y 10 magos Puño de Roca.‡Mo\'mor le Briseur, à Telaar en Nagrand, veut que vous tuiez 10 Guerriers Rochepoing et 10 Mages Rochepoing.‡杀死10个石拳战士和10个石拳法师，然后向纳格兰塔拉的击碎者姆摩尔复命。‡納葛蘭，泰拉的『破壞者』哞哞爾要你去殺死10個石拳戰士和10個石拳法師。',
  }
},
[9923] = {
  {
    'SOCORRO!‡На помощь!‡HILFE!‡위기에 처한 코르키!‡¡AYUDA!‡¡AYUDA!‡AU SECOURS !‡救命啊！‡救命!',
    nil,
    'Encontre a chave dos Punho de Pedra e liberte Corki. Caso você consiga, fale com Arechron em Telaar.‡Найдите ключ клана Тяжелого Кулака и освободите Корки. После этого отправляйтесь к Арехрону в Телаар за наградой.‡Findet den Schlüssel der Felsfäuste und befreit Corki. Sprecht mit Arechron in Telaar, wenn Ihr Erfolg hattet.‡돌주먹일족 열쇠를 찾아서 코르키를 풀어 준 후 텔라아르에 있는 아레크론과 대화해야 합니다.‡Encuentra la llave Puño de Roca y libera a Corki. Habla con Arechron en Telaar si lo consigues.|n‡Encuentra la llave Puño de Roca y libera a Corki. Habla con Arechron en Telaar si lo consigues.|n‡Trouvez la Clé rochepoing et libérez Corki. Parlez avec Arechron, à Telaar, si vous réussissez.‡找到石拳钥匙，解救考尔奇，然后向塔拉的阿雷克隆复命。‡找到石拳鑰匙並釋放柯爾奇。成功後和泰拉的阿爾克隆談談。',
  }
},
[9924] = {
  {
    'Corki sumiu de novo!‡Корки снова пропал!‡Corki wird schon wieder vermisst!‡다시 사라진 코르키!‡¡Corki ha vuelto a desaparecer!‡¡Corki ha vuelto a desaparecer!‡Corki a encore disparu !‡考尔奇又走丢了！‡柯爾奇又不見了!',
    nil,
    'Arechron, em Telaar, pediu para você encontrar e libertar Corki.‡Найдите и освободите Корки.‡Arechron in Telaar bittet Euch, Corki zu suchen und zu befreien.‡텔라아르에 있는 아레크론이 코르키를 찾아서 구해 달라고 부탁했습니다.‡Arechron en Telaar te ha pedido que encuentres y liberes a Corki.‡Arechron en Telaar te ha pedido que encuentres y liberes a Corki.‡Arechron, de Telaar, vous a demandé de retrouver et de libérer Corki.‡塔拉的阿雷克隆要你去搭救考尔奇。‡泰拉的阿爾克隆要你找到並且釋放柯爾奇。',
  }
},
[9925] = {
  {
    'Questões de segurança‡Вопросы безопасности‡Eine Frage der Sicherheit‡보안 문제‡Una cuestión de seguridad‡Una cuestión de seguridad‡Des questions de sécurité‡安全问题‡防禦之事',
    nil,
    'Zerid, do Posto Aeris, em Nagrand, quer que você mate 8 Crias do Caos nas cercanias de Oshu\'gun.‡Убейте 8 отроков Бездны поблизости от Ошу\'гуна по просьбе Зерида из Небесного лагеря.‡Zerid beim Aerissteg in Nagrand möchte, dass Ihr 8 Ausgeburten der Leere in der Nähe des Oshu\'gun tötet.‡나그란드의 에어리스 착륙지에 있는 제리드가 오슈군 근처에 있는 공허의 피조물 8마리를 해치워 달라고 부탁했습니다.‡Zerid, del Desembarco Aeris en Nagrand, quiere que mates 8 engendros del vacío cerca de Oshu\'gun.‡Zerid, del Desembarco Aeris en Nagrand, quiere que mates 8 engendros del vacío cerca de Oshu\'gun.‡Zerid, du Point d\'ancrage Aeris en Nagrand, veut que vous tuiez 8 Rejetons du Vide près d\'Oshu\'gun.‡纳格兰埃瑞斯码头的瑟利德要求你杀死沃舒古附近的8个空灵爪牙。‡納葛蘭，艾瑞斯平臺的澤瑞德要你去歐夏剛附近殺死8個虛無再生者。',
  }
},
[9926] = {
  {
    '‡FLAG Совет Теней/Цепочка заданий Боевой Молот‡FLAG Shadow Council/Warmaul Questline‡[미완성] 어둠의 요새/전쟁망치 일족‡FLAG Shadow Council/Warmaul Questline‡FLAG Shadow Council/Warmaul Questline‡FLAG Shadow Council/Warmaul Questline‡标志暗影议会/战槌任务支线‡',
    nil,
    nil,
  }
},
[9927] = {
  {
    'Astúcia implacável‡Безжалостное коварство‡Erbarmungslose Gerissenheit‡무자비한 교활함‡Astucia despiadada‡Astucia despiadada‡Une ruse impitoyable‡无情的计谋‡殘忍的狡猾',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você finque 10 Estandartes dos Ogros Guerramalho em cadáveres dos membros do clã Kil\'pesar, na Fortaleza Kil\'pesar.|n|nDevolva os estandartes que não forem usados.‡По поручению Лантрезора Клинка из Руин Пылающего Клинка в Награнде вонзите 10 знамен клана Боевого Молота в тела защитников бастиона Вечной Скорби.|n|nВерните Лантрезору Клинку оставшиеся знамена.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge möchte, dass Ihr 10 Ogerbanner der Totschläger in die Körper von Bewohnern von Kil\'sorge in der Festung Kil\'sorge rammt.|n|nBringt unbenutzte Ogerbanner der Totschläger zu ihm zurück.‡나그란드의 불타는 칼날 폐허에 있는 칼날의 란트레서가 킬소로우 요새에 있는 병사들의 시체에 전쟁망치 오우거 깃발 10개를 꽂아달라고 부탁했습니다.|n|n사용하고 남은 전쟁망치 오우거 깃발은 다시 돌려줘야 합니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que plantes 10 estandartes ogros de Mazo de Guerra en los cuerpos de miembros de Mata\'penas en la Fortaleza Mata\'penas.|n|nDevuélvele los estandartes que no hayas usado.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que plantes 10 estandartes ogros de Mazo de Guerra en los cuerpos de miembros de Mata\'penas en la Fortaleza Mata\'penas.|n|nDevuélvele los estandartes que no hayas usado.‡Lantresor de la Lame, aux Ruines de la Lame ardente en Nagrand, veut que vous plantiez 10 Bannières des ogres Cogneguerre dans le corps de soldats de Kil\'sorrau, à la forteresse Kil\'sorrau.|n|nRapportez les Bannières des ogres Cogneguerre que vous n’aurez pas utilisées.‡前往基尔索罗堡垒，将10面战槌食人魔军旗插在基尔索罗成员的尸体上，然后返回纳格兰火刃废墟向兰特瑞索·火刃复命。|n|n将没有用完的战槌食人魔军旗还给兰特瑞索。‡納葛蘭，燃刃氏族廢墟的『劍刃』蘭崔索要你將10個戰槌巨魔旌旗插在吉爾索洛堡壘的吉爾索洛成員屍體上。|n|n將未使用的戰槌巨魔旌旗交回。',
  }
},
[9928] = {
  {
    'Armamento de decepção em massa‡Военная хитрость‡Waffen zur Täuschung‡속임수를 위한 무기‡Armamentos para engañar‡Armamentos para engañar‡Les armes du subterfuge‡欺诈所需的军备‡欺騙的軍備',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você recolha 10 Armamentos de Kil\'pesar.‡Принесите Лантрезору Клинку в руины Пылающего Клинка 10 ящиков с оружием бастиона Вечной Скорби.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge Nagrand möchte, dass Ihr 10 Waffen von Kil\'sorge besorgt.‡나그란드의 불타는 칼날 폐허에 있는 칼날의 란트레서가 킬소로우 무기 10개를 모아달라고 부탁했습니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que recojas 10 armamentos de Mata\'penas.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que recojas 10 armamentos de Mata\'penas.‡Lantresor de la Lame, des Ruines de la Lame ardente en Nagrand, veut que vous récupériez 10 Armes de Kil\'sorrau.‡纳格兰火刃废墟的兰特瑞索·火刃要你收集10份基尔索罗军备。‡納葛蘭，燃刃氏族廢墟的『劍刃』蘭崔索要你去收集10個吉爾索洛裝備。',
  }
},
[9929] = {
  {
    '‡Пропавший торговец‡Der vermisste Händler‡‡El mercader desaparecido‡El mercader desaparecido‡Le marchand disparu‡失踪的商人‡',
    nil,
    '‡Отправляйтесь по дороге на северо-запад, по направлению к Шаттрату, и поищите какие-нибудь намеки на то, что могло случиться с Дугаром.‡Reist nach Nordwesten entlang der Straße nach Shattrath und sucht nach Hinweisen auf den Verbleib von Dugar.‡‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Dugar.‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Dugar.‡Suivez la route de Shattrath vers le nord-ouest et cherchez des indices concernant ce qui est arrivé à Dugar.‡‡',
  }
},
[9930] = {
  {
    '‡Пропавший торговец‡Der vermisste Händler‡‡El mercader desaparecido‡El mercader desaparecido‡Le marchand disparu‡失踪的商人‡',
    nil,
    '‡Отправляйтесь по дороге на северо-запад, по направлению к Шаттрату, и поищите какие-нибудь намеки на то, что могло случиться с Дейромом.‡Reist nach Nordwesten entlang der Straße nach Shattrath und sucht nach Hinweisen auf den Verbleib von Deirom.‡‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Deirom.‡Viaja en dirección noroeste por el camino que va hacia Shattrath y busca pruebas de lo que le ha ocurrido a Deirom.‡Suivez la route de Shattrath vers le nord-ouest et cherchez des indices concernant ce qui est arrivé à Deirom.‡‡',
  }
},
[9931] = {
  {
    'Retribuir o favor‡Взаимная вежливость‡Sich für den Gefallen revanchieren‡호의에 대한 보답‡Devolver el favor‡Devolver el favor‡Un prêté pour un rendu‡以牙还牙‡回報',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você finque 10 Estandartes de Kil\'pesar nos cadáveres dos ogros Guerramalho, nas Ruínas Gargaveira.|n|nDevolva os estandartes que não forem usados.‡По поручению Лантрезора Клинка из Руин Пылающего Клинка в Награнде воткните 10 знамен Вечной Скорби в трупы огров клана Боевого Молота, обитающих в руинах Веселого Черепа.|n|nОставшиеся знамена верните Лантрезору.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge in Nagrand möchte, dass Ihr 10 Banner von Kil\'sorge in die Leichen der Totschlägeroger in den Ruinen des Lachenden Schädels rammt.|n|nBringt unbenutzte Banner von Kil\'sorge zu ihm zurück.‡나그란드의 불타는 칼날 폐허에 있는 칼날의 란트레서가 웃는 해골 폐허에 있는 전쟁망치일족 오우거들의 시체에 킬소로우 깃발 10개를 꽂아달라고 부탁했습니다.|n|n사용하고 남은 킬소로우 깃발은 다시 돌려줘야 합니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere plantes 10 estandartes Mata\'penas en los cuerpos de ogros de Mazo de Guerra en las Ruinas Riecráneos.|n|nDevuélvele los estandartes que no hayas usado.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere plantes 10 estandartes Mata\'penas en los cuerpos de ogros de Mazo de Guerra en las Ruinas Riecráneos.|n|nDevuélvele los estandartes que no hayas usado.‡Lantresor de la Lame, aux Ruines de la Lame ardente en Nagrand, veut que vous plantiez 10 Bannières de Kil\'sorrau dans les cadavres d’ogres Cogneguerre, aux Ruines du clan du Crâne ricanant.|n|nRapportez-lui toutes les bannières de Kil\'sorrau que vous n’aurez pas utilisées.‡纳格兰火刃废墟的兰特瑞索·火刃要你杀入嘲颅废墟，将10面基尔索罗军旗插在战槌食人魔的尸体上。|n|n将没有用完的基尔索罗军旗还给兰特瑞索。‡燃刃氏族廢墟的『劍刃』蘭崔索要你將10個吉爾索洛旌旗插在獰笑骷髏氏族廢墟的戰槌巨魔屍體上。|n|n交回未使用的吉爾索洛旌旗。',
  }
},
[9932] = {
  {
    'Corpo de delito‡Вещественное доказательство‡Beweismaterial‡증거가 되는 시체‡El cadáver del delito‡El cadáver del delito‡Le corps du délit‡尸证‡證據的屍體',
    nil,
    'Lantresor da Lâmina, das Ruínas da Lâmina Ardente, em Nagrand, quer que você use o Cobertor de Lã Molhado na pira ardente dos Guerramalho, no Pátio Gargaveira, para mandar sinais de fumaça para seus ogros.‡По поручению Лантрезора Клинка из руин Пылающего Клинка в Награнде найдите костер клана Боевого Молота во внутреннем дворе руин Веселого Черепа. С помощью мокрого шерстяного одеяла подайте дымовой сигнал ограм.‡Lantresor von der Klinge in den Ruinen der Brennenden Klinge in Nagrand möchte, dass Ihr die feuchte Wolldecke am lodernden Scheiterhaufen der Totschläger im Hof des Lachenden Schädels benutzt, um Signale an seine Oger zu senden.‡나그란드의 불타는 칼날 폐허에 있는 칼날의 란트레서가 웃는 해골 광장의 타오르는 전쟁망치 장작불에서 축축한 양모 담요를 사용하여 그의 오우거 부하들에게 연기로 신호를 보내달라고 부탁했습니다.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que utilices la manta de lana húmeda en la pira Mazo de Guerra llameante, en el Patio Riecráneos, para enviar señales a sus ogros.‡Lantresor del Filo, en las Ruinas Filo Ardiente, en Nagrand, quiere que utilices la manta de lana húmeda en la pira Mazo de Guerra llameante, en el Patio Riecráneos, para enviar señales a sus ogros.‡Lantresor de la Lame, des ruines de la Lame ardente en Nagrand, veut que vous utilisiez la Couverture de laine humide sur le Bûcher ardent cogneguerre dans la Cour du Crâne ricanant afin d\'envoyer un signal à ses ogres.‡纳格兰火刃废墟的兰特瑞索·火刃要你前往嘲颅营地，在燃烧的战槌篝火堆处点燃潮湿的毛毯，利用烟雾向食人魔传递信号。‡納葛蘭，燃刃氏族廢墟的『劍刃』蘭崔索要你去獰笑骷髏庭院，在燃燒的戰槌柴堆使用潮濕的羊毛毯來通知他的巨魔。',
  }
},
[9933] = {
  {
    'Mensagem para Telaar‡Послание в Телаар‡Nachricht für Telaar‡텔라아르에 보내는 전갈‡Mensaje para Telaar‡Mensaje para Telaar‡Un message pour Telaar‡回到塔拉‡給泰拉的訊息',
    nil,
    'Entregue a oferenda de paz da Lâmina Ardente para Arechron, na vila de Telaar, em Nagrand.‡Отнесите мирное подношение Пылающего Клинка Арехрону в Телаар, что в Награнде.‡Bringt das Friedensangebot der Brennenden Klinge zu Arechron nach Telaar in Nagrand.‡나그란드의 텔라아르에 있는 아레크론에게 평화의 불타는 칼날단 공물을 가져가야 합니다.‡Lleva la ofrenda de paz Filo Ardiente a Arechron a Telaar, en Nagrand.‡Lleva la ofrenda de paz Filo Ardiente a Arechron a Telaar, en Nagrand.‡Apporter l’Offrande de paix de la Lame ardente à Arechron, à Telaar, en Nagrand.‡将火刃的议和礼物交给纳格兰的塔拉的阿雷克隆。‡到納葛蘭的泰拉，將燃刃和平禮物帶給阿爾克隆。',
  }
},
[9934] = {
  {
    'Mensagem para Garadar‡Послание в Гарадар‡Nachricht für Garadar‡가라다르로 보내는 전갈‡Mensaje para Garadar‡Mensaje para Garadar‡Un message pour Garadar‡回到加拉达尔‡給卡拉達爾的訊息',
    nil,
    'Entregue a Oferenda de Paz da Lâmina Ardente para Garrosh, em Garadar.‡Отнесите мирное подношение клана Пылающего Клинка Гаррошу в Гарадар.‡Bringt das Friedensangebot der Brennenden Klinge zu Garrosh in Garadar.‡가라다르에 있는 가로쉬에게 평화의 불타는 칼날단 공물을 가져가야 합니다.‡Lleva la ofrenda de paz del Filo Ardiente a Garrosh, en Garadar.‡Lleva la ofrenda de paz del Filo Ardiente a Garrosh, en Garadar.‡Apporter l\'Offrande de paix de la Lame ardente à Garrosh, à Garadar.‡将火刃的议和礼物交给加拉达尔的加尔鲁什。‡將燃刃和平禮物帶給卡拉達爾的卡爾洛斯。',
  }
},
[9935] = {
  {
    'Procura-se: Giselda, a Encarquilhada‡Разыскивается: Гизельда Колдунья‡Gesucht: Giselda die Alte‡현상 수배: 마녀 기셀다‡Se busca: Giselda la Vieja bruja‡Se busca: Giselda la Vieja bruja‡On recherche : Giselda la Mégère‡通缉：巫婆吉塞尔达‡懸賞:『老巫婆』吉絲達',
    nil,
    'Mate Giselda, a Encarquilhada, e qualquer grupo de 10 Agentes Kil\'pesar. Caso consiga terminar a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Гизельду Колдунью и 10 любых служителей бастиона Вечной Скорби. Получите награду у стража-смотрителя Быккрока в Гарадаре.‡Tötet Giselda die Alte und 10 beliebige Agenten von Kil\'sorge. Kehrt danach zu Aufseher Bullrok in Garadar zurück.‡마녀 기셀다와 킬소로우에 소속된 적을 10명 채워서 해치우십시오. 일을 마치면 가라다르에 있는 교도관 불로크에게 돌아가십시오.‡Mata a Giselda la Vieja bruja y a 10 agentes Mata\'penas. Vuelve a ver al celador Tororroc, en Garadar, en cuando cumplas la misión.‡Mata a Giselda la Vieja bruja y a 10 agentes Mata\'penas. Vuelve a ver al celador Tororroc, en Garadar, en cuando cumplas la misión.‡Tuez Giselda la Mégère et n\'importe quelle combinaison de 10 Agents de Kil\'sorrau. Retournez voir le gardien Bullrok à Garadar si vous parvenez à accomplir cette tâche.‡杀死巫婆吉塞尔达以及任意10名基尔索罗成员，完成任务后向加拉达尔的监护者布罗克复命。‡殺死『老巫婆』吉絲達，及任何身份的10個吉爾索洛密探。完成任務後回到卡拉達爾找守望者波洛克。',
  }
},
[9936] = {
  {
    'Procura-se: Giselda, a Encarquilhada‡Разыскивается: Гизельда Колдунья‡Gesucht: Giselda die Alte‡현상 수배: 마녀 기셀다‡Se busca: Giselda la Vieja bruja‡Se busca: Giselda la Vieja bruja‡On recherche : Giselda la Mégère‡通缉：巫婆吉塞尔达‡懸賞:『老巫婆』吉絲達',
    nil,
    'Mate Giselda, a Encarquilhada, e qualquer grupo de 10 Agentes Kil\'pesar. Caso consiga terminar a tarefa, fale novamente com o protetor Moi\'bff Jill na vila de Telaar.‡Убейте Гизельда Колдунью и 10 любых служителей бастиона Вечной Скорби. Получите награду у стража-смотрителя Мой\'прна Джилла в Телааре.‡Tötet Giselda die Alte und 10 beliebige Agenten von Kil\'sorge. Kehrt danach zu Aufseher Moi\'bff Jill in Telaar zurück.‡마녀 기셀다와 킬소로우 요원 10명을 처치한 후 텔라아르에 있는 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Giselda la Vieja bruja y a 10 agentes de Mata\'penas. Vuelve a ver al celador Moi\'bff Jill, en Telaar, en cuando cumplas la misión.‡Mata a Giselda la Vieja bruja y a 10 agentes de Mata\'penas. Vuelve a ver al celador Moi\'bff Jill, en Telaar, en cuando cumplas la misión.‡Tuez Giselda la Mégère et n\'importe quelle combinaison de 10 Agents de Kil\'sorrau. Retournez voir le gardien Moi\'bff Jill à Telaar si vous parvenez à accomplir cette tâche.‡杀死巫婆吉塞尔达以及任意10名基尔索罗成员，完成任务后返回塔拉向监护者莫布吉尔复命。‡殺死『老巫婆』吉絲達，及任何身份的10個吉爾索洛密探。完成任務後回到泰拉找守望者莫布夫·吉爾。',
  }
},
[9937] = {
  {
    'Procura-se: Durn, o Famélico‡Разыскивается: Дарн Ненасытный‡Gesucht: Durn der Nimmersatte‡현상 수배: 굶주린 두른‡Se busca: Durn el Hambriento‡Se busca: Durn el Hambriento‡On recherche : Durn l\'Affameur‡通缉：饥饿者杜恩‡懸賞:『飢餓者』唐恩',
    nil,
    'Mate Durn, o Famélico. Caso você consiga cumprir a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Дарна Ненасытного. Вернитесь к стражу-смотрителю Быккроку и получите награду.‡Tötet Durn den Nimmersatten. Meldet Euch bei Aufseher Bullrok, wenn Ihr diese Aufgabe erledigt habt.‡굶주린 두른을 해치워야 합니다. 임무를 마치면 교도관 불로크에게 돌아가십시오.‡Mata a Durn el Hambriento. Ve a ver al celador Tororroc si consigues completar esta tarea.‡Mata a Durn el Hambriento. Ve a ver al celador Tororroc si consigues completar esta tarea.‡Tuez Durn l\'Affameur. Retournez voir le gardien Bullrok si vous parvenez à accomplir cette tâche.‡杀死饥饿者杜恩，完成任务后向监护者布罗克复命。‡殺死『飢餓者』唐恩。完成任務後回去找守望者波洛克。',
  }
},
[9938] = {
  {
    'Procura-se: Durn, o Famélico‡Разыскивается: Дарн Ненасытный‡Gesucht: Durn der Nimmersatte‡현상 수배: 굶주린 두른‡Se busca: Durn el Hambriento‡Se busca: Durn el Hambriento‡On recherche : Durn l\'Affameur‡通缉：饥饿者杜恩‡懸賞:『飢餓者』唐恩',
    nil,
    'Mate Durn, o Famélico. Caso você consiga cumprir a tarefa, fale novamente com o Protetor Moi\'bff Jill.‡Убейте Дарна Ненасытного. Вернитесь к стражу-смотрителю Мой\'прну Джиллу и получите награду.‡Tötet Durn den Nimmersatten. Meldet Euch bei Aufseher Moi\'bff Jill, wenn Ihr diese Aufgabe erledigt habt.‡굶주린 두른을 처치한 후 일을 마치면 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Durn el Hambriento. Ve a ver al celador Moi\'bff Jill si consigues completar esta tarea.‡Mata a Durn el Hambriento. Ve a ver al celador Moi\'bff Jill si consigues completar esta tarea.‡Tuez Durn l\'Affameur. Retournez voir le gardien Moi\'bff Jill si vous parvenez à accomplir cette tâche.‡杀死饥饿者杜恩，完成任务后向塔拉的监护者莫布吉尔复命。‡殺死『飢餓者』唐恩。完成任務後回去找守望者莫布夫·吉爾。',
  }
},
[9939] = {
  {
    'Procura-se: Zorbo, o Conselheiro‡Разыскивается: Зорбо Советчик‡Gesucht: Zorbo der Berater‡현상 수배: 조언자 조르보‡Se busca: Zorbo el Consejero‡Se busca: Zorbo el Consejero‡On recherche : Zorbo le Conseiller‡通缉：顾问佐尔布‡懸賞:『諫言者』索爾波',
    nil,
    'Mate Zorbo, o Conselheiro, 5 Xamãs Guerramalho e 5 Aniquiladores Guerramalho. Caso você consiga cumprir a tarefa, fale novamente com o Guarda Bullrok.‡Убейте Зорбо Советчика, 5 шаманов и 5 разорителей из клана Боевого Молота. Получите награду у стража-смотрителя Быккрока.‡Tötet Zorbo den Berater, 5 Schamanen der Totschläger und 5 Häscher der Totschläger. Meldet Euch bei Aufseher Bullrok, wenn Ihr die Aufgabe erledigt habt.‡조언자 조르보, 전쟁망치일족 주술사 5명, 전쟁망치일족 약탈자 5명을 해치워야 합니다. 일을 마치면 교도관 불로크에게 돌아가십시오.‡Mata a Zorbo el Consejero, 5 chamanes Mazo de Guerra y 5 atracadores Mazo de Guerra. Ve a ver al celador Tororroc si consigues completar la tarea.‡Mata a Zorbo el Consejero, 5 chamanes Mazo de Guerra y 5 atracadores Mazo de Guerra. Ve a ver al celador Tororroc si consigues completar la tarea.‡Tuez Zorbo le Conseiller, 5 Chamans Cogneguerre et 5 Ravageurs Cogneguerre. Retournez voir le gardien Bullrok si vous parvenez à accomplir cette tâche.‡杀死顾问佐尔布、5个战槌萨满祭司和5个战槌劫掠者，完成任务后向监护者布罗克复命。‡殺死『諫言者』索爾波，5個戰槌薩滿和5個戰槌劫奪者。完成任務後去找守望者波洛克。',
  }
},
[9940] = {
  {
    'Procura-se: Zorbo, o Conselheiro‡Разыскивается: Зорбо Советчик‡Gesucht: Zorbo der Berater‡현상 수배: 조언자 조르보‡Se busca: Zorbo el Consejero‡Se busca: Zorbo el Consejero‡On recherche : Zorbo le Conseiller‡通缉：顾问佐尔布‡懸賞:『諫言者』索爾波',
    nil,
    'Mate Zorbo, o Conselheiro, 5 Xamãs Guerramalho e 5 Aniquiladores Guerramalho. Caso você consiga cumprir a tarefa, fale novamente com o Protetor Moi\'bff Jill.‡Убейте Зорбо Советчика, 5 шаманов и 5 разорителей из клана Боевого Молота. Получите награду у стража-смотрителя Мой\'прна Джилла.‡Tötet Zorbo den Berater, 5 Schamanen der Totschläger und 5 Häscher der Totschläger. Meldet Euch bei Aufseher Moi\'bff Jill, wenn Ihr die Aufgabe erledigt habt.‡조언자 조르보, 전쟁망치일족 주술사 5명, 전쟁망치일족 약탈자 5명을 처치한 후 텔라아르의 교도관 모입프 질에게 돌아가야 합니다.‡Mata a Zorbo el Consejero, 5 chamanes Mazo de Guerra y 5 atracadores Mazo de Guerra. Ve a ver al celador Moi\'bff Jill si consigues completar la tarea.‡Mata a Zorbo el Consejero, 5 chamanes Mazo de Guerra y 5 atracadores Mazo de Guerra. Ve a ver al celador Moi\'bff Jill si consigues completar la tarea.‡Tuez Zorbo le Conseiller, 5 Chamans Cogneguerre et 5 Ravageurs Cogneguerre. Retournez voir le gardien Moi\'bff Jill si vous parvenez à accomplir cette tâche.‡杀死顾问佐尔布、5个战槌萨满祭司和5个战槌劫掠者，完成任务后向塔拉的监护者莫布吉尔复命。‡殺死『諫言者』索爾波、5個戰槌薩滿和5個戰槌劫奪者。完成任務後去找守望者莫布夫·吉爾。',
  }
},
[9941] = {
  {
    '‡Выслеживание преступников‡Die Schuldigen aufspüren‡‡Rastreando a los culpables‡Rastreando a los culpables‡À la recherche des coupables‡追踪罪犯‡',
    nil,
    '‡Продолжите поиски Дейрома в поселении араккоа к северу от сломанной повозки.‡Sucht weiter in der Arakkoasiedlung nördlich des kaputten Wagens nach einem Lebenszeichen von Deirom.‡‡Sigue buscando pistas sobre Deirom en el asentamiento de los arakkoa al norte del carro destruido.‡Sigue buscando pistas sobre Deirom en el asentamiento de los arakkoa al norte del carro destruido.‡Continuez à chercher des signes de la présence de Deirom dans le village arakkoa, au nord du chariot brisé.‡‡',
  }
},
[9942] = {
  {
    '‡Выслеживание преступников‡Die Schuldigen aufspüren‡‡Rastreando a los culpables‡Rastreando a los culpables‡À la recherche des coupables‡追踪罪犯‡',
    nil,
    '‡Продолжите поиски Дугара в поселении араккоа к северу от сломанной повозки.‡Sucht weiter in der Arakkoasiedlung nördlich des kaputten Wagens nach einem Lebenszeichen von Dugar.‡‡Sigue buscando rastros de Dugar en el asentamiento arakkoa al norte de la carreta rota.‡Sigue buscando rastros de Dugar en el asentamiento arakkoa al norte de la carreta rota.‡Continuez à chercher des signes de la présence de Dugar dans le village arakkoa, au nord du chariot brisé.‡‡',
  }
},
[9943] = {
  {
    '‡Обратно к Тандеру‡Rückkehr zu Thander‡‡Regresa junto a Thander‡Regresa junto a Thander‡Retourner voir Thander‡回到萨德尔那里‡',
    nil,
    '‡Вернитесь к Тандеру в Бастион Аллериии расскажите ему о том, что вам удалось обнаружить.‡Kehrt mit Euren neuen Erkenntnissen zu Thander in Allerias Feste zurück.‡‡Ve a ver a Thander en el Bastión Allerian e infórmale sobre tus descubrimientos.‡Ve a ver a Thander en el Bastión Allerian e infórmale sobre tus descubrimientos.‡Retournez voir Thander au Bastion allérien pour lui rapporter vos découvertes.‡‡',
  }
},
[9944] = {
  {
    'Cortejo Mag\'hari perdido‡Пропавший маг\'харский караван‡Verschollene mag\'harische Prozession‡실종된 마그하리 행렬‡La procesión Mag\'hari‡La procesión Mag\'hari‡La procession mag\'hari disparue‡失踪的玛格汉车队‡失蹤的瑪格哈利隊伍',
    nil,
    'Procure o Cortejo Mag\'hari perdido.‡Найдите пропавший маг\'харский караван.‡Sucht nach der verschollenen mag\'harischen Prozession.‡실종된 마그하리 행렬을 찾아야 합니다.‡Busca la Procesión Mag\'hari desaparecida.‡Busca la Procesión Mag\'hari desaparecida.‡Cherchez la procession mag\'hari disparue.‡寻找失踪的玛格汉车队。‡尋找失蹤的瑪格哈利隊伍。',
  }
},
[9945] = {
  {
    'Guerra aos Guerramalho‡Войной на Боевой Молот‡Krieg den Totschlägern‡전쟁망치일족 응징‡Sangre en Mazo de Guerra‡Sangre en Mazo de Guerra‡La guerre contre les Cogneguerre‡战槌之战‡戰槌之戰',
    nil,
    'O Ancião Yorley, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você mate 8 Brutamontes Guerramalho e 8 Bruxos Guerramalho.‡Старейшина Йорли из Маг\'харского Каравана в Награнде попросил вас убить 8 громил и 8 чернокнижников клана Боевого Молота.‡Ältester Yorley bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr 8 Schläger der Totschläger und 8 Hexenmeister der Totschläger tötet.‡나그란드의 마그하리 행렬에 있는 장로 요를리가 전쟁망치일족 투사와 전쟁망치일족 흑마법사를 8명씩 해치워 달라고 부탁했습니다.‡El anciano Yorley de la Procesión Mag\'hari en Nagrand quiere que mates a 8 toscos y 8 brujos Mazo de Guerra.‡El anciano Yorley de la Procesión Mag\'hari en Nagrand quiere que mates a 8 toscos y 8 brujos Mazo de Guerra.‡L\'ancien Yorley de la procession Mag\'hari en Nagrand vous a demandé de tuer 8 Brutes Cogneguerre et 8 Démonistes Cogneguerre.‡纳格兰玛格汉车队的长者尤尔雷要求你杀死8个战槌蛮兵和8个战槌术士。‡納葛蘭，瑪格哈利隊伍的長老優兒利要你去殺死8個戰槌蠻卒和8個戰槌術士。',
  }
},
[9946] = {
  {
    'Cho\'war, o Espoliador‡Чо\'вар Погромщик‡Cho\'war der Plünderer‡약탈자 초와르‡Cho\'war el Saqueador‡Cho\'war el Saqueador‡Cho\'war le Pilleur‡掠夺者考瓦尔‡『掠取者』喬沃',
    nil,
    'O Ancião Yorley, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você mate Cho\'war, o Espoliador, e pegue a Cabeça de Cho\'war.‡Убейте Чо\'вара Погромщика и принесите его голову старейшине Йорли в Маг\'харский Караван.‡Ältester Yorley bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr Cho\'war den Plünderer tötet und Cho\'wars Kopf besorgt.‡나그란드의 마그하리 행렬에 있는 장로 요를리가 약탈자 초와르를 해치우고 그 증거를 가져오라고 부탁했습니다.‡El anciano Yorley de la procesión Mag\'hari en Nagrand quiere que mates a Cho\'war el Saqueador y le lleves su cabeza.‡El anciano Yorley de la procesión Mag\'hari en Nagrand quiere que mates a Cho\'war el Saqueador y le lleves su cabeza.‡L\'Ancien Yorley, de la Procession mag\'hari en Nagrand, vous a demandé de tuer Cho\'war le Pilleur, et de récupérer la Tête de Cho\'war.‡纳格兰玛格汉车队的长者尤尔雷要求你杀死掠夺者考瓦尔，并将考瓦尔的徽记带回来复命。‡納葛蘭，瑪格哈利隊伍的長老優兒利要你去殺死『掠取者』喬沃並取得喬沃的頭顱。',
  }
},
[9947] = {
  {
    '‡Обратно к Рокагу‡Rückkehr zu Rokag‡‡Regresa junto a Rokag‡Regresa junto a Rokag‡Retourner voir Rokag‡回到瑞克格那里拉‡',
    nil,
    '‡Вернитесь к Рокагу в Форт Камнеломов и расскажите ему о том, что вам удалось обнаружить.‡Kehrt mit Euren neuen Erkenntnissen zu Rokag in der Steinbrecherfeste zurück.‡‡Vuelve a ver a Rokag al Bastión Rompepedras e infórmale sobre tus descubrimientos.‡Vuelve a ver a Rokag al Bastión Rompepedras e infórmale sobre tus descubrimientos.‡Retournez voir Rokag au fort des Brise-pierres pour lui rapporter vos découvertes.‡‡',
  }
},
[9948] = {
  {
    'Encontrar os sobreviventes‡Спасательная экспедиция‡Findet die Überlebenden‡생존자 수색‡Encontrando a los supervivientes‡Encontrando a los supervivientes‡À la recherche des survivants‡寻找幸存者‡找到生還者',
    nil,
    'O Ancião Ungriz, do Cortejo Fúnebre Mag\'hari, em Nagrand, quer que você liberte 5 Prisioneiros Mag\'har.‡Освободите 5 пленных маг\'харов по просьбе старейшины Унгриза из маг\'харского каравана в Награнде.‡Ältester Ungriz bei der mag\'harischen Prozession in Nagrand möchte, dass Ihr 5 gefangene Mag\'har befreit.‡나그란드의 마그하리 행렬에 있는 장로 운그리즈가 마그하르 포로 5명을 구해 달라고 부탁했습니다.‡El Anciano Ungriz en la Procesión Mag\'hari, en Nagrand, te ha pedido que liberes 5 prisioneros Mag\'har.‡El Anciano Ungriz en la Procesión Mag\'hari, en Nagrand, te ha pedido que liberes 5 prisioneros Mag\'har.‡L\'ancien Ungriz, à la Procession mag\'hari en Nagrand, vous a demandé de libérer 5 Prisonniers mag\'har.‡纳格兰玛格汉车队的长者安格雷兹要求你去释放5个玛格汉俘虏。‡納葛蘭，瑪格哈利隊伍的長老昂古力斯要你釋放5名瑪格哈囚犯。',
  }
},
[9949] = {
  {
    '‡Птичьи Глаза‡Aus der Vogelperspektive‡‡A vista de pájaro‡A vista de pájaro‡À vol d\'oiseau‡鸟眼视线‡',
    nil,
    '‡Принесите Око Гнездовья Скит, Око Гнездовья Шиенор и Око Гнездовья Рескк Андарлу в Бастион Аллерии.‡Bringt das Auge des Sktihverstecks, das Auge des Shienorverstecks und das Auge des Reskkverstecks zu Andarl in Allerias Feste.‡‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Andarl en el Bastión Allerian.‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Andarl en el Bastión Allerian.‡Andarl du Bastion allérien veut que vous lui rapportiez l\'Œil du Voile Skith, l\'Œil du Voile Shienor et l\'Œil du Voile Reskk.‡‡',
  }
},
[9950] = {
  {
    '‡Птичьи Глаза‡Aus der Vogelperspektive‡‡A vista de pájaro‡A vista de pájaro‡À vol d\'oiseau‡鸟眼视线‡',
    nil,
    '‡Принесите Око Гнездовья Скит, Око Гнездовья Шиенор и Око Гнездовья Рескк Каргатоку в Форт Камнеломов.‡Bringt das Auge des Sktihverstecks, das Auge des Shienorverstecks und das Auge des Reskkverstecks zu Krugatok in der Steinbrecherfeste.‡‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Kurgatok en el Bastión Rompepedras.‡Lleva el ojo de Velo Skith, ojo de Velo Shienor y el ojo de Velo Reskk a Kurgatok en el Bastión Rompepedras.‡Apportez l\'Œil du Voile Skith, l\'Œil du Voile Shienor et l\'Œil du Voile Reskk à Kurgatok au fort des Brise-pierres.‡‡',
  }
},
[9951] = {
  {
    'De olho em você!‡Он следит за тобой!‡Es beobachtet Euch!‡당신을 지켜보는 눈‡¡Naphthal\'ar te vigila!‡¡Naphthal\'ar te vigila!‡Il vous regarde !‡它在盯着你！‡它在看著你!',
    nil,
    'Mate Naphthal\'ar e, a seguir, fale novamente com o Guardião Arbórelos na Mata Cenariana, que fica na Mata Terokkar.‡Убейте Нафталара и вернитесь к хранителю Древлосу в перелесок Кенария в лесу Тероккар.‡Tötet Naphthal\'ar und kehrt dann zu Aufseher Baumlas im Cenariusdickicht in den Wäldern von Terokkar zurück.‡나프탈라르를 해치운 후 테로카르 숲의 세나리온 수풀에 있는 교도관 트리로스에게 돌아가야 합니다.‡Mata a Naphthal\'ar y ve a ver al celador Treelos al Matorral Cenarion en el Bosque de Terokkar.‡Mata a Naphthal\'ar y ve a ver al celador Treelos al Matorral Cenarion en el Bosque de Terokkar.‡Tuez Naphthal\'ar puis retournez auprès du gardien Arblos au Fourré cénarien dans la forêt de Terokkar.‡杀死纳弗塔拉，然后返回泰罗卡森林的塞纳里奥树林向监护者忒洛斯复命。‡殺了奈伏薩拉爾再回到泰洛卡森林找塞納里奧灌木林的守望者崔洛斯。',
  }
},
[9952] = {
  {
    '‡Геолог Бальморал‡Ausgrabungsleiter Balmoral‡발굴조사단장 발모랄‡Prospector Balmoral‡Prospector Balmoral‡Le prospecteur Balmoral‡勘察员波莫罗‡勘察員波莫羅',
    nil,
    '‡Найдите геолога Бальморала и поговорите с ним.‡Findet und sprecht mit Ausgrabungsleiter Balmoral.‡‡Busca al prospector Balmoral.‡Busca al prospector Balmoral.‡Trouvez le prospecteur Balmoral et parlez-lui.‡‡',
  }
},
[9953] = {
  {
    '‡Наблюдатель Нодак‡Aufklärer Nodak‡망꾼 노닥‡Oteador Nodak‡Oteador Nodak‡Le guetteur Nodak‡监视者诺达克‡監視者諾達克',
    nil,
    '‡Найдите наблюдателя Нодака и поговорите с ним.‡Findet und sprecht mit Aufklärer Nodak.‡‡Busca al oteador Nodak.‡Busca al oteador Nodak.‡Trouvez le guetteur Nodak et parlez-lui.‡‡',
  }
},
[9954] = {
  {
    'O resgate de Corki‡Выкуп за Корки‡Corkis Lösegeld‡코르키의 몸값‡El rescate de Corki‡El rescate de Corki‡La rançon de Corki‡考尔奇的赎金‡柯爾奇的贖金',
    nil,
    'Arechron quer que você encontre Corki no Morro Guerramalho.‡Арехрон просит вас найти Корки на холме Боевого Молота.‡Arechron möchte, dass Ihr Corki auf dem Totschlägerhügel findet.‡아레크론이 전쟁망치 언덕에 있는 코르키를 찾아 달라고 부탁했습니다.‡Arechron quiere que encuentres a Corki en la Colina Mazo de Guerra.‡Arechron quiere que encuentres a Corki en la Colina Mazo de Guerra.‡Arechron veut que vous retrouviez Corki sur la colline des Cogneguerre.‡阿雷克隆要你前往战槌山寻找考尔奇。‡阿爾克隆要你去戰槌山丘找柯爾奇。',
  }
},
[9955] = {
  {
    'Cho\'war, o Espoliador‡Чо\'вар Погромщик‡Cho\'war der Plünderer‡약탈자 초와르‡Cho\'war el Saqueador‡Cho\'war el Saqueador‡Cho\'war le Pilleur‡掠夺者考瓦尔‡『掠取者』喬沃',
    nil,
    'Corki quer que você pegue a chave de Cho\'war e liberte-o da jaula. Caso consiga cumprir essa tarefa, fale novamente com Arechron na vila de Telaar, em Nagrand.‡Найдите Чо\'вара, отберите у него ключ и освободите Корки из клетки. После этого отправляйтесь к Арехрону в Телаар за наградой.‡Corki möchte, dass Ihr Cho\'wars Schlüssel besorgt, um ihn aus dem Käfig zu befreien. Kehrt zu Arechron in Telaar zurück, falls Ihr Erfolg haben solltet.‡초와르의 열쇠를 가져와서 코르키를 감옥에서 꺼내 준 후 텔라아르에 있는 아레크론에게 돌아가야 합니다.‡Corki quiere que consigas la llave de Cho\'war para que puedas liberarle de su jaula. Ve a ver a Arechron en Telaar si lo consigues.‡Corki quiere que consigas la llave de Cho\'war para que puedas liberarle de su jaula. Ve a ver a Arechron en Telaar si lo consigues.‡Corki veut que vous récupériez la Clé de Cho\'war pour le faire sortir de sa cage. Si vous parvenez, allez voir Arechron à Telaar.‡夺得考瓦尔的钥匙，将考尔奇从牢笼中释放出来，完成任务后返回塔拉向阿雷克隆复命。‡柯爾奇要你拿到喬沃的鑰匙，這樣你就可以將他從牢籠中釋放。等你完成了這個任務就回到泰拉找阿爾克隆。',
  }
},
[9956] = {
  {
    'A caravana devastada‡Разграбленный караван‡Die überfallene Karawane‡습격당한 짐마차‡La Caravana Devastada‡La Caravana Devastada‡La caravane dévastée‡不幸的商队‡被破壞的貨車',
    nil,
    'A caçadora Kima, da vila de Telaar, em Nagrand, quer que você recupere 10 caixotes de suprimentos de Telaar.‡Помогите охотнице Киме вернуть 10 телаарских ящиков с припасами.‡Jägerin Kima in Telaar in Nagrand möchte, dass Ihr 10 Vorratskisten von Telaar wiederbesorgt.‡나그란드의 텔라아르에 있는 여사냥꾼 키마가 텔라아르 보급상자 10개를 되찾아 달라고 부탁했습니다.‡La cazadora Kima en Telaar, en Nagrand, quiere que recuperes 10 cajones de suministros de Telaar.‡La cazadora Kima en Telaar, en Nagrand, quiere que recuperes 10 cajones de suministros de Telaar.‡La Chasseresse Kima, de Telaar en Nagrand, veut que vous récupériez 10 Caisses de fournitures de Telaar.‡收集10个塔拉补给箱，把它们交给塔拉的女猎手琪玛。‡納葛蘭，泰拉的女獵人奇瑪要你取得10個泰拉補給木箱。',
  }
},
[9957] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡Algo pasa en el Matorral Cenarion‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit einem der Druiden beim Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화하십시오.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9958] = {
  {
    '‡Разведка укреплений‡Die Verteidigung ausspähen‡‡Información sobre las defensas‡Información sobre las defensas‡Reconnaissance des défenses‡侦察防御‡',
    nil,
    '‡Подойдите поближе к Гнездовью Шалас и осмотрите защитные укрепления городка.‡Begebt Euch in die Nähe des Shalasverstecks und beobachtet die Verteidigungseinrichtungen des Dorfes.‡‡Acércate a Velo Shalas y observa las defensas del lugar.‡Acércate a Velo Shalas y observa las defensas del lugar.‡Approchez-vous du Voile Shalas et examinez les défenses de la ville.‡‡',
  }
},
[9959] = {
  {
    '‡Разведка укреплений‡Die Verteidigung ausspähen‡‡Información sobre las defensas‡Información sobre las defensas‡Reconnaissance des défenses‡侦察防御‡',
    nil,
    '‡Подойдите поближе к Гнездовью Шалас и постарайтесь узнать, что за магия защищает это поселение.‡Begebt Euch in die Nähe des Shalasverstecks und beobachtet die Verteidigungseinrichtungen des Dorfes.‡‡Acércate a Velo Shalas y observa la magia que utilizan para defender el asentamiento.‡Acércate a Velo Shalas y observa la magia que utilizan para defender el asentamiento.‡Approchez-vous du Voile Shalas et découvrez quels sortilèges protègent la ville.‡‡',
  }
},
[9960] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡Algo pasa en el Matorral Cenarion‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit den Druiden im Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화하십시오.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9961] = {
  {
    'O que há de errado na Mata Cenariana?‡Что случилось в перелеске Кенария?‡Was ist los mit dem Cenariusdickicht?‡세나리온 수풀에 무슨 일이?‡Algo pasa en el Matorral Cenarion‡Algo pasa en el Matorral Cenarion‡Que se passe-t-il au Fourré cénarien ?‡塞纳里奥树林出事了？‡塞納里奧灌木林發生了什麼事?',
    nil,
    'Fale com um dos druidas na Mata Cenariana, que fica na Mata Terokkar.‡Поговорите с одним из друидов в перелеске Кенария в лесу Тероккар.‡Sprecht mit den Druiden im Cenariusdickicht in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀에 있는 드루이드 중 한 명과 대화해야 합니다.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con uno de los druidas del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez à l\'un des druides du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林地区的塞纳里奥树林中的某位德鲁伊谈一谈。‡到泰洛卡森林去和塞納里奧灌木林的一個德魯伊談談。',
  }
},
[9962] = {
  {
    'Ringue de Sangue: Carracho‡Кольцо Крови: Хромоног‡Der Ring des Blutes: Schmetterzehe‡피의 투기장: 망치발굽‡El Círculo de Sangre: Dedorroto‡El Círculo de Sangre: Dedorroto‡L\'arène de sang : Brisorteil‡鲜血竞技场：断蹄‡血色競技場:斷趾',
    nil,
    'Derrote o Carracho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Хромоногом. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Schmetterzehe. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡망치발굽을 처치하여 대전에서 승리하면, 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Dedorroto. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Dedorroto. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Triomphez de Brisorteil. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败断蹄，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗斷趾。擊敗他們之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9963] = {
  {
    '‡Помощь от врага‡Hilfe von der Geißel‡‡Volviendo a los orígenes‡Volviendo a los orígenes‡Chercher de l\'aide à la source‡向源头寻找帮助‡',
    nil,
    '‡Найдите Кокорека в Гнездовье Литик и поговорите с ним.‡Sucht Kokorek im Lithicversteck und sprecht mit ihm.‡‡Habla con Kokorek en Velo Lítico.‡Habla con Kokorek en Velo Lítico.‡Trouvez Kokorek au Voile Lithic et parlez-lui.‡‡',
  }
},
[9964] = {
  {
    '‡Помощь от врага‡Hilfe von der Geißel‡‡Volviendo a los orígenes‡Volviendo a los orígenes‡Chercher de l\'aide à la source‡向源头寻找帮助‡',
    nil,
    '‡Найдите Кокорека в Гнездовье Литик и поговорите с ним.‡Sucht Kokorek im Lithicversteck und sprecht mit ihm.‡‡Habla con Kokorek en Velo Lítico.‡Habla con Kokorek en Velo Lítico.‡Trouvez Kokorek au Voile Lithic et parlez-lui.‡‡',
  }
},
[9965] = {
  {
    '‡Проявление веры‡Guten Willen zeigen‡‡Una muestra de buena fe‡Una muestra de buena fe‡Une preuve de bonne volonté‡良心的约定‡',
    nil,
    '‡Принесите голову Муг\'гока Кокореку в Гнездовье Литик.‡Bringt Mug\'goks Kopf zu Kokorek im Lithicversteck.‡‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Apportez la Tête de Mug\'gok à Kokorek au Voile Lithic.‡‡',
  }
},
[9966] = {
  {
    '‡Проявление веры‡Guten Willen zeigen‡‡Una muestra de buena fe‡Una muestra de buena fe‡Une preuve de bonne volonté‡良心的约定‡',
    nil,
    '‡Принесите голову Муг\'гока Кокореку в Гнездовье Литик.‡Bringt Mug\'goks Kopf zu Kokorek im Lithicversteck.‡‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Lleva la cabeza de Mug\'gok a Kokorek en Velo Lítico.‡Apportez la Tête de Mug\'gok à Kokorek au Voile Lithic.‡‡',
  }
},
[9967] = {
  {
    'Ringue de Sangue: Gêmeos Cara de Pau‡Кольцо Крови: братья Блю‡Der Ring des Blutes: Die Blaumänner‡피의 투기장: 푸른 형제들‡El Círculo de Sangre: los hermanos azules‡El Círculo de Sangre: los hermanos azules‡L\'arène de sang : les Grands Bleus‡鲜血竞技场：蓝色兄弟‡血色競技場:憂鬱兄弟黨',
    nil,
    'Derrote os gêmeos Sangue-de-lodo conhecidos como Gêmeos Cara de Pau. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над близнецами из племени Темной Крови, которые называют себя "Братья Блю". После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt die Zwillinge der Finsterblut, die sich selbst die "Blaumänner" nennen. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡자칭 푸른 형제들이라는 수렁피일족 쌍둥이와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a los gemelos Sangreoscura que se hacen llamar los Hermanos azules. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a los gemelos Sangreoscura que se hacen llamar los Hermanos azules. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Battre les Jumeaux bourbesang, qui se font appeler les Grands Bleus. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败自称为蓝色兄弟的暗血双胞胎，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗自稱憂鬱兄弟的黑暗之血雙子。擊敗他們之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9968] = {
  {
    'Estranha energia‡Странная энергия‡Fremde Energien‡이상한 기운‡Extraña energía‡Extraña energía‡Énergie étrange‡奇怪的能量‡奇怪的能量',
    nil,
    'Colete 4 Amostras de Teralépidas e 4 Amostras de Teralépidas Cruéis. A seguir, fale novamente com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, que fica na Mata Terokkar.‡Соберите 4 образца пухоспинки и 4 образца агрессивной пухоспинки для землепряда Тавгрена. Его можно найти возле Перелеска Кенария в лесу Тероккар.‡Sammelt 4 Teromottenproben und 4 Proben einer bösartigen Teromotte. Kehrt dann zu Erdbinder Tavgren beim Cenariusdickicht in den Wäldern von Terokkar zurück.‡테로나방 견본과 흉포한 테로나방 견본을 4개씩 모아서 테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌에게 돌아가야 합니다.‡Consigue 4 muestras de teropolilla y 4 muestras de teropolilla sañosa. Después ve a ver al vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Consigue 4 muestras de teropolilla y 4 muestras de teropolilla sañosa. Después ve a ver al vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Collectez 4 Spécimens de terophalènes et 4 Spécimens de terophalènes vicieux. Puis retournez auprès du Lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡收集4份巨蛾样本和4份邪恶巨蛾样本，然后向泰罗卡森林中塞纳里奥树林外的缚地者塔弗格伦复命。‡收集4個泰洛飛蛾樣本和4個兇惡的泰洛飛蛾樣本。再回到泰洛卡森林找塞納里奧灌木林外的縛地者塔伏格蘭。',
  }
},
[9969] = {
  {
    '‡Последние реагенты‡Die letzten Reagenzien‡‡Los componentes finales‡Los componentes finales‡Les derniers composants‡最后的试剂‡',
    nil,
    '‡Принесите 5 сущностей прыгуаны-охотника и 30 ягод тероккарской черной рябины Кокореку в Гнездовье Литик.‡Bringt 5 Sphärenpirscheressenzen und 30 Apfelbeeren von Terokkar zu Kokorek im Lithicversteck.‡‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Apportez 5 Essences de chasseur dimensionnel et 30 Airelles de Terokkar à Kokorek au Voile Lithic.‡‡',
  }
},
[9970] = {
  {
    'Ringue de Sangue: Rokdar, o Lorde Partido‡Кольцо Крови: Камнедар Выщербленный Повелитель‡Der Ring des Blutes: Rokdar der Zerklüftete‡피의 투기장: 파괴의 군주 로크다르‡El Círculo de Sangre: Rokdar el Señor Hendido‡El Círculo de Sangre: Rokdar el Señor Hendido‡L\'arène de sang : Rokdar le Seigneur scindé‡鲜血竞技场：裂石之王洛卡达尔‡血色競技場:『碎裂領主』洛克達',
    nil,
    'Derrote Rokdar, o Lorde Partido. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Победите Камнедара Выщербленного Повелителя. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Rokdar den Zerklüfteten. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡파괴의 군주 로크다르와의 대전에서 승리한 후, 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Rokdar el Lord Hendido. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Rokdar el Lord Hendido. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Battre Rokdar le Seigneur scindé. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败裂石之王洛卡达尔，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗『碎裂領主』洛克達。獲勝之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9971] = {
  {
    'Pistas na mata‡Ответы в чащобе‡Hinweise im Dickicht‡수풀 안의 단서‡Pistas en el Matorral‡Pistas en el Matorral‡Des indices au Fourré‡树林中的线索‡樹叢裡的線索',
    nil,
    'Investigue o Objeto Estranho perto do Cadáver do Degradado para determinar o que pode ter acontecido na Mata Cenariana. A seguir, fale novamente com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, que fica na Mata Terokkar.‡Осмотрите странный предмет рядом с трупом Сломленного и постарайтесь узнать, что случилось в перелеске Кенария. Затем вернитесь к заклинателю земли Тавгрену в лес Тероккар.‡Untersucht das merkwürdige Objekt neben der Leiche eines Zerschlagenen um herauszufinden, was hinter der Tragödie beim Cenariusdickicht steckt. Kehrt dann zu Erdbinder Tavgren außerhalb des Dickichts in den Wäldern von Terokkar zurück.‡세나리온 수풀에서 벌어진 비극 뒤에 숨어 있는 비밀을 밝힐 단서인 뒤틀린 드레나이 시체 옆에 있는 이상한 물체를 조사해야 합니다. 그런 다음 테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌에게 돌아가십시오.‡Investiga el objeto extraño cerca del cadáver de Tábido para intentar averiguar lo que ocurrió en el Matorral Cenarion. Vuelve a ver al vinculador terrestre Tavgren al salir del matorral en el Bosque de Terokkar.‡Investiga el objeto extraño cerca del cadáver de Tábido para intentar averiguar lo que ocurrió en el Matorral Cenarion. Vuelve a ver al vinculador terrestre Tavgren al salir del matorral en el Bosque de Terokkar.‡Examinez l\'Objet étrange à côté du Cadavre de Roué pour découvrir ce qui a pu frapper le Fourré cénarien. Puis retournez auprès du lieur de terre Tavgren juste à l\'extérieur du fourré dans la forêt de Terokkar.‡调查破碎者的尸体旁的奇怪物体，看看究竟是什么在滋扰塞纳里奥树林，然后向塞纳里奥树林外的缚地者塔弗格伦复命。‡調查破碎的屍體旁邊的奇怪的物品來判定塞納里奧灌木林發生過什麼事。再回到泰洛卡森林外找縛地者塔伏格蘭。',
  }
},
[9972] = {
  {
    'Ringue de Sangue: Skra\'gath‡Кольцо Крови: Скрагат‡Der Ring des Blutes: Skra\'gath‡피의 투기장: 스크라가스‡El Círculo de Sangre: Skra\'gath‡El Círculo de Sangre: Skra\'gath‡L\'arène de sang : Skra\'gath‡鲜血竞技场：瑟克拉加斯‡血色競技場:史卡拉克斯',
    nil,
    'Derrote Skra\'gath. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Скрагатом. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Skra\'gath. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡스크라가스와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota a Skra\'gath. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Skra\'gath. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Battre Skra\'gath. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败瑟克拉加斯，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗史卡拉克斯。獲勝之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9973] = {
  {
    'Ringue de Sangue: O Campeão Guerramalho‡Кольцо Крови: чемпион клана Боевого Молота‡Der Ring des Blutes: Champion der Totschläger‡피의 투기장: 전쟁망치일족 용사‡El Círculo de Sangre: el campeón Mazo de Guerra‡El Círculo de Sangre: el campeón Mazo de Guerra‡L\'arène de sang : le champion Cogneguerre‡鲜血竞技场：战槌勇士‡血色競技場:戰槌勇士',
    nil,
    'Derrote o Campeão Guerramalho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над чемпионом клана Боевого Молота. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt den Champion der Totschläger. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener, um Eure Belohnung zu erhalten.‡전쟁망치일족 용사와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해야 합니다.‡Derrota al campeón Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota al campeón Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Battre le Champion Cogneguerre. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败战槌勇士，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗戰槌勇士。獲勝之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9974] = {
  {
    '‡Последние реагенты‡Die letzten Reagenzien‡‡Los componentes finales‡Los componentes finales‡Les derniers composants‡最后的试剂‡',
    nil,
    '‡Принесите 5 сущностей прыгуаны-охотника и 30 ягод тероккарской черной рябины Кокореку в Гнездовье Литик.‡Bringt 5 Sphärenpirscheressenzen und 30 Apfelbeeren von Terokkar zu Kokorek im Lithicversteck.‡‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Lleva 5 esencias de cazador distorsionado y 30 bayas cebadoras de Terokkar a Kokorek en Velo Lítico.‡Apportez 5 Essences de chasseur dimensionnel et 30 Airelles de Terokkar à Kokorek au Voile Lithic.‡‡',
  }
},
[9975] = {
  {
    '‡Изначальная магия‡Urmagie‡‡Magia primigenia‡Magia primigenia‡Magie primordiale‡原始魔法‡',
    nil,
    '‡Используйте талисман Кокорека возле тотемов, охраняющих завесу Шалас, после чего поговорите с геологом Бальморалом.‡Benutzt Kokoreks Talisman in der Nähe der Totems, die den Weg ins Shalasversteck bewachen, und sprecht dann mit Ausgrabungsleiter Balmoral.‡‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el prospector Balmoral.‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el prospector Balmoral.‡Utilisez le Talisman de Kokorek près des totems qui gardent la route du Voile Shalas, puis parlez au prospecteur Balmoral.‡‡',
  }
},
[9976] = {
  {
    '‡Изначальная магия‡Urmagie‡‡Magia primigenia‡Magia primigenia‡Magie primordiale‡原始魔法‡',
    nil,
    '‡Используйте талисман Кокорека возле тотемов, охраняющих завесу Шалас, после чего поговорите с наблюдателем Нодаком.‡Benutzt Kokoreks Talisman in der Nähe der Totems, die den Weg ins Shalasversteck bewachen, und sprecht dann mit Aufklärer Nodak.‡‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el oteador Nodak.‡Utiliza el talismán de Kokorek cerca de los tótems que protegen el camino a Velo Shalas, a continuación habla con el oteador Nodak.‡Utilisez le Talisman de Kokorek près des totems qui gardent la route du Voile Shalas, puis parlez au guetteur Nodak.‡‡',
  }
},
[9977] = {
  {
    'Ringue de Sangue: o desafio final‡Кольцо Крови: последнее испытание‡Der Ring des Blutes: die letzte Herausforderung‡피의 투기장: 마지막 도전‡El Círculo de Sangre: el desafío final‡El Círculo de Sangre: el desafío final‡L\'arène de sang : l\'ultime défi‡鲜血竞技场：终极挑战‡血色競技場:最後的挑戰',
    nil,
    'Derrote Mogor, herói dos Guerramalho. Se você vencer, fale com Wodin, o Serviçal Troll, para receber a recompensa.‡Одержите победу над Могором, героем клана Боевого Молота. После битвы обратитесь к троллю-прислужнику Водину и получите свою награду.‡Besiegt Mogor, Held der Totschläger. Wenn Ihr gewinnen solltet, sprecht mit Wodin dem Trolldiener um Eure Belohnung zu erhalten.‡전쟁망치일족의 영웅인 모고르와의 대전에서 승리하면 보상을 얻기 위해 하수인 우딘과 대화해아 합니다.‡Derrota a Mogor, héroe de los Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Derrota a Mogor, héroe de los Mazo de Guerra. Si lo logras, habla con Wodin el sirviente trol para recibir tu recompensa.‡Battre Mogor, héros des Cogneguerre. Si vous l\'emportez, allez parler à Wodin le Serviteur-troll pour chercher votre récompense.‡击败战槌英雄穆戈尔，获胜之后找巨魔仆从伍迪领取奖励。‡擊敗戰槌的英雄，莫古。獲勝之後跟『食人妖僕從』烏丁領取獎賞。',
  }
},
[9978] = {
  {
    'Custe o que custar‡Любыми средствами‡Mit allen Mitteln‡모든 방법을 동원하여...‡Cueste lo que cueste‡Cueste lo que cueste‡Par tous les moyens nécessaires‡不择手段‡用盡所有必須的手段',
    nil,
    'Encontre Empur na estrada entre Tuurem e Shattrath, na Mata Terokkar. Convença-o a dizer o que sabe.‡Найдите Эмпура на дороге между и Тууремом и Шаттратом в лесу Тероккар. Убедите его рассказать вам все, что ему известно.‡Findet Empoor. Er hält sich auf der Straße zwischen Tuurem und Shattrath in den Wäldern von Terokkar auf. Bringt ihn dazu, Euch zu erzählen, was Ihr wissen wollt.‡테로카르 숲의 샤트라스와 투렘 사이에 있는 길가에서 엠푸르를 찾아야 합니다. 그가 알고 있는 사실을 말하도록 설득해야 합니다.‡Busca a Empoor en la carretera entre Tuurem y Shattrath, en el Bosque de Terokkar. Convéncele para que te cuente lo que sabe.‡Busca a Empoor en la carretera entre Tuurem y Shattrath, en el Bosque de Terokkar. Convéncele para que te cuente lo que sabe.‡Trouvez Empoor sur la route entre Tuurem et Shattrah, dans la Forêt de Terokkar. Puis convainquez-le de vous dire ce qu\'il sait.‡在泰罗卡森林中，图雷姆和沙塔斯城之间的大路上找到并说服埃博尔将他所知道的一切都告诉你。‡在泰洛卡森林的撒塔斯城往杜瑞的路上，找到安普爾並且說服他，使他告訴你所知道的事。',
  }
},
[9979] = {
  {
    'Lathrai, o Mercador do Vento‡Латрай Торговец Ветром‡Windhändler Lathrai‡바람의 무역상 라스라이‡Comerciante de viento Lathrai‡Comerciante de viento Lathrai‡Le marchand des vents Lathrai‡星界商人拉斯莱‡風之貿易者拉斯蕊',
    nil,
    'Fale com Lathrai, o Mercador do Vento. Você pode encontrá-lo perto da Taberna Fim do Mundo, localizada no Bairro Inferior, em Shattrath.‡Поговорите с торговцем ветром Латраем возле таверны "На краю земли" в Нижнем городе Шаттрата.‡Sprecht mit Windhändler Lathrai in der Nähe der Taverne Weltenend im unteren Viertel in Shattrath.‡샤트라스의 고난의 거리에 있는 세상의 끝 선술집 근처의 바람의 무역상 라스라이와 대화하십시오.‡Habla con el comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo en la sección del Bajo Arrabal de la Ciudad de Shattrath.‡Habla con el comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo en la sección del Bajo Arrabal de la Ciudad de Shattrath.‡Parlez au marchand des vents Lathrai près de la Taverne de la Fin du monde dans la ville basse à Shattrath.‡与沙塔斯城贫民窟天涯旅店附近的星界商人拉斯莱谈一谈。‡到撒塔斯的陰鬱城和世界的盡頭小酒館的拉斯蕊談談。',
  }
},
[9980] = {
  {
    '‡Спасите Дейрома!‡Rettet Deirom!‡‡¡Rescata a Deirom!‡¡Rescata a Deirom!‡Sauvez Deirom!‡拯救迪罗姆！‡',
    nil,
    '‡Проберитесь в гнездовье Шалас, убейте Луангу и освободите Дейрома, после чего доложитесь Леди Дене Кеннеди в Бастионе Аллерии.‡Begebt Euch ins Shalasversteck, tötet Lunga und befreit Deirom. Meldet Euch bei Lady Dana Kennedy in Allerias Feste, wenn Ihr Euren Auftrag erledigt habt.‡‡Ve a Velo Shalas, mata a Luanga y libera a Deirom. Preséntate ante Lady Dena Kennedy en el Bastión Allerian cuando hayas completado tu misión.‡Ve a Velo Shalas, mata a Luanga y libera a Deirom. Preséntate ante Lady Dena Kennedy en el Bastión Allerian cuando hayas completado tu misión.‡Pénétrez dans le Voile Shalas, tuez Luanga et libérez Deirom. Faites votre rapport à dame Dena Kennedy au Bastion allérien lorsque vous aurez accompli votre mission.‡‡',
  }
},
[9981] = {
  {
    '‡Спасите Дугара!‡Rettet Dugar!‡‡¡Rescata a Dugar!‡¡Rescata a Dugar!‡Sauvez Dugar!‡拯救杜葛尔！‡',
    nil,
    '‡Проберитесь в завесу Шалас, убейте Луангу и освободите Дейрома, после чего доложитесь Рокагу в Форте Камнеломов.‡Begebt Euch ins Shalasversteck, tötet Lunga und befreit Dugar. Meldet Euch bei Rokag in der Steinbrecherfeste, wenn Ihr Euren Auftrag erledigt habt.‡‡Ve a Velo Shalas, mata a Luanga y libera a Dugar. Preséntate ante Rokag en el Bastión Rompepedras cuando hayas completado tu misión.‡Ve a Velo Shalas, mata a Luanga y libera a Dugar. Preséntate ante Rokag en el Bastión Rompepedras cuando hayas completado tu misión.‡Pénétrez dans le Voile Shalas, tuez Luanga et libérez Dugar. Faites votre rapport à Rokag au fort des Brise-pierres lorsque vous aurez accompli votre mission.‡‡',
  }
},
[9982] = {
  {
    'Ele se chamava Altruis...‡Его звали Алтруис...‡Er nannte sich Altruis...‡알트루이스라 부르는 사나이...‡Se hacía llamar Altruis...‡Se hacía llamar Altruis...‡Il se fait appeler Altruis...‡他叫奥图里斯......‡他自稱奧翠司……',
    nil,
    'Se você deseja lutar contra a Legião Ardente, procure Altruis, O Sofredor, no oeste de Nagrand.‡Если у вас есть желание сразиться с Пылающим Легионом, разыщите Алтруиса Страдальца в западном Награнде.‡Wenn Ihr die Brennende Legion bekämpfen wollt, sucht Altruis den Leider im Westen von Nagrand.‡불타는 군단과 싸우고자 한다면 나그란드 서부에 있는 고뇌의 알트루이스를 찾아가야 합니다.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si vous cherchez à affronter la Légion ardente, allez trouver Altruis le Souffrant dans l\'ouest de Nagrand.‡如果你想与燃烧军团作战，就到纳格兰西部去找到受难者奥图里斯。‡如果你想與燃燒軍團挑戰就到西納葛蘭去找『受難者』奧翠司。',
  }
},
[9983] = {
  {
    'Ele se chamava Altruis...‡Его звали Алтруис...‡Er nannte sich Altruis...‡고뇌의 알트루이스‡Se hacía llamar Altruis...‡Se hacía llamar Altruis...‡Il se fait appeler Altruis...‡他叫奥图里斯......‡他自稱奧翠司……',
    nil,
    'Se você deseja lutar contra a Legião Ardente, procure Altruis, O Sofredor, no oeste de Nagrand.‡Если у вас есть желание сразиться с Пылающим Легионом, разыщите Алтруиса Страдальца в западном Награнде.‡Wenn Ihr die Brennende Legion bekämpfen wollt, sucht Altruis den Leider im Westen von Nagrand.‡불타는 군단과 싸우고 싶으면 나그란드 서부에 있는 고뇌의 알트루이스를 찾아가야 합니다.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si quieres luchar contra la Legión Ardiente, encuentra a Altruis el Sufridor en la parte oeste de Nagrand.‡Si vous cherchez à affronter la Légion ardente, allez trouver Altruis le Souffrant dans l\'ouest de Nagrand.‡如果你想与燃烧军团作战，就到纳格兰西部去找到受难者奥图里斯。‡如果你想與燃燒軍團挑戰就到西納葛蘭去找『受難者』奧翠司。',
  }
},
[9984] = {
  {
    'Anfitrião da cidade secreta‡Хозяин Сокрытого Города‡Der Herr der versteckten Stadt‡숨겨진 도시의 주인‡Anfitrión de la ciudad oculta‡Anfitrión de la ciudad oculta‡L\'hôte de la cité cachée‡隐秘之城‡隱秘城市的主人',
    nil,
    'Leve as Ordens de Luanga para Andarl. Você pode encontrá-lo na Fortaleza Alleriana, na Mata Terokkar.‡Отнесите приказы Луанги Андарлу в Бастион Аллерии, что в лесу Тероккар.‡Bringt Luangas Befehle zu Andarl in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 안다를에게 루앙가의 명령서를 가져가야 합니다.‡Lleva las órdenes de Luanga a Andarl al Bastión Allerian, en el Bosque de Terokkar.‡Lleva las órdenes de Luanga a Andarl al Bastión Allerian, en el Bosque de Terokkar.‡Apportez les Ordres de Luanga à Andarl au Bastion allérien, dans la Forêt de Terokkar.‡将卢埃加的命令交给泰罗卡森林中奥蕾莉亚要塞的安达尔。‡到泰洛卡森林的艾蘭里堡壘，將盧安卡的命令交給安達爾歐。',
  }
},
[9985] = {
  {
    'Anfitrião da cidade secreta‡Хозяин Сокрытого Города‡Der Herr der versteckten Stadt‡숨겨진 도시의 주인‡Anfitrión de la ciudad oculta‡Anfitrión de la ciudad oculta‡L\'hôte de la cité cachée‡隐秘之城‡隱秘城市的主人',
    nil,
    'Leve as Ordens de Luanga para Kurgatok na Vila de Quebrapedra, que fica na Mata Terokkar.‡Отнесите приказы Луанги Каргатоку в Форт Камнеломов, что в лесу Тероккар.‡Bringt Luangas Befehle zu Kurgatok in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 쿠르가톡에게 루앙가의 명령서를 가져가야 합니다.‡Lleva las órdenes de Luanga a Kurgatok al Bastión Rompepedras, en el Bosque de Terokkar.‡Lleva las órdenes de Luanga a Kurgatok al Bastión Rompepedras, en el Bosque de Terokkar.‡Apportez les Ordres de Luanga à Kurgatok au Fort des Brise-pierres, dans la Forêt de Terokkar.‡将卢埃加的命令交给泰罗卡森林中裂石堡的库加托克。‡到泰洛卡森林的碎石堡，將盧安卡的命令交給庫爾卡拓克。',
  }
},
[9986] = {
  {
    'Para atrapalhar os arakkoas‡Сдержать араккоа‡Die Arakkoa hindern‡아라코아 방해하기‡Frustrando los planes de los arakkoa‡Frustrando los planes de los arakkoa‡S\'opposer aux arakkoa‡教训鸦人‡阻礙阿拉卡',
    nil,
    'Mate Ashkaz, no Véu Reskk; Ayit, no Véu Shienor e Urdak, no Véu Skith. A seguir, fale novamente com Thander, na Fortaleza Alleriana.‡Убейте Ашказа в гнездовье Рескк, Аийта в гнездовье Шиенор и Урдака в гнездовье Скит, после чего вернитесь к Тандеру в бастион Аллерии.‡Tötet Ashkaz im Reskkversteck, Ayit im Shienorversteck und Urdak im Skithversteck und kehrt dann zu Thander in Allerias Feste zurück.‡장막의 레스크의 아쉬카즈, 장막의 쉬에노르의 아이트, 장막의 스키스의 우르닥을 처치한 후 알레리아 성채에 있는 탠더에게 돌아가야 합니다.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Thander en el Bastión Allerian.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Thander en el Bastión Allerian.‡Tuez Ashkaz au Voile Reskk, Ayit au Voile Shienor et Urdak au Voile Skith, puis retournez voir Thander au Bastion allérien.‡杀死里斯克鸦巢的阿什卡兹，西诺鸦巢的埃伊特和基斯鸦巢的乌达克，然后返回奥蕾莉亚要塞向山德复命。‡殺死迷霧瑞斯克的阿斯卡斯、迷霧辛諾的阿翼特和迷霧斯奇司的烏達克再回到艾蘭里堡壘找薩德爾。',
  }
},
[9987] = {
  {
    'Para atrapalhar os arakkoas‡Сдержать араккоа‡Die Arakkoa hindern‡아라코아 좌절시키기‡Frustrando los planes de los arakkoa‡Frustrando los planes de los arakkoa‡S\'opposer aux arakkoa‡教训鸦人‡阻礙阿拉卡',
    nil,
    'Mate Ashkaz, no Véu Reskk; Ayit, no Véu Shienor e Urdak, no Véu Skith. A seguir, fale novamente com Rokar, na Vila de Quebrapedra.‡Убейте Ашказа в гнездовье Рескк, Айита в гнездовье Шиенор и Урдака в гнездовье Скит, после чего вернитесь к Рокагу в форт Камнеломов.‡Tötet Ashkaz im Reskkversteck, Ayit im Shienorversteck und Urdak im Skithversteck und kehrt dann zu Rokag in der Steinbrecherfeste zurück.‡장막의 레스크의 아쉬카즈, 장막의 쉬에노르의 아이트, 장막의 스키스의 우르닥을 해치운 후 돌망치 요새에 있는 로카그에게 돌아가십시오.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Rokag en el Bastión Rompepedras.‡Mata a Ashkaz en Velo Reskk, a Ayit en Velo Shienor y a Urdak en Velo Skith. A continuación ve a ver a Rokag en el Bastión Rompepedras.‡Tuez Ashkaz au Voile Reskk, Ayit au Voile Shienor et Urdak au Voile Skith, puis retournez voir Rokag au fort des Brise-pierres.‡杀死里斯克鸦巢的阿什卡兹，西诺鸦巢的埃伊特和基斯鸦巢的乌达克，然后返回裂石堡向罗卡格复命。‡殺死迷霧瑞斯克的阿斯卡斯，迷霧辛諾的阿翼特，和迷霧斯奇司的烏達克再回到碎石堡找瑞克格。',
  }
},
[9988] = {
  {
    'O melhor amigo do janota‡Лучший друг щеголя‡Der beste Freund eines Gecken‡멋쟁이들의 필수품‡El mejor amigo de un dandi‡El mejor amigo de un dandi‡Le meilleur ami des élégants‡公子哥的好朋友‡花花公子的知音',
    nil,
    'Traga 30 Penas de Arakkoa para Ros\'eleth, na Fortaleza Alleriana.‡Принесите 30 перьев араккоа Роз\'алете в бастион Аллерии.‡Bringt 30 Arakkoafedern zu Ros\'eleth in Allerias Feste.‡알레리아 성채에 있는 로스엘레스에게 아라코아 깃털 30개를 가져가야 합니다.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Apportez 30 Plumes d\'arakkoa à Ros\'eleth au Bastion allérien.‡给奥蕾莉亚要塞的洛瑟蕾丝带回30片鸦人的羽毛。‡將30根阿拉卡羽毛交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[9989] = {
  {
    'Espíritos alienígenas‡Неведомые духи‡Fremde Geister‡낯선 영혼들‡Espíritus extraños‡Espíritus extraños‡Des esprits étrangers‡异类的灵魂‡不同的靈魂',
    nil,
    'Traga 30 Penas de Arakkoa para Malkaz, na Vila de Quebrapedra.‡Принесите 30 перьев араккоа Малуказу в форт Камнеломов.‡Bringt 30 Arakkoafedern zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 아라코아 깃털 30개를 가져가야 합니다.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Apportez 30 Plumes d\'arakkoa à Malukaz au fort des Brise-pierres.‡将30片鸦人的羽毛交给裂石堡的玛鲁卡兹。‡將30根阿拉卡羽毛交給碎石堡的瑪魯卡茲。',
  }
},
[9990] = {
  {
    'Investigação em Tuurem‡Исследование Туурема‡Untersuchung von Tuurem‡투렘 조사‡Investigación de Tuurem‡Investigación de Tuurem‡Enquête à Tuurem‡调查图雷姆‡調查杜瑞',
    nil,
    'Encontre a Caixa Lacrada e entregue-a para o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, que fica na Mata Terokkar.‡Найдите запечатанный ларец и отнесите его заклинателю земли Тавгрену. Тавгрена можно найти около перелеска Кенария в лесу Тероккар.‡Findet den versiegelten Kasten und bringt ihn zu Erdbinder Tavgren beim Cenariusdickicht in den Wäldern von Terokkar.‡봉인된 상자를 찾아서 테로카르 숲의 세나리온 수풀 바로 바깥에 있는 대지의 결속자 타브그렌에게 전달해야 합니다.‡Encuentra la caja sellada y entrégasela al vinculador terrestre Tavgren justo fuera del Matorral Cenarion en el Bosque de Terokkar.‡Encuentra la caja sellada y entrégasela al vinculador terrestre Tavgren justo fuera del Matorral Cenarion en el Bosque de Terokkar.‡Trouvez la Boîte scellée puis apportez-la au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡找到密封的盒子，将其交给塞纳里奥树林外的缚地者塔弗格伦。‡找到密封的箱子再將它送到泰洛卡森林交給塞納里奧灌木林外的縛地者塔伏格蘭。',
  }
},
[9991] = {
  {
    'Sondagem das terras‡Разведка‡Inspektion des Lagers‡기지 조사‡Inspeccionar la tierra‡Inspeccionar la tierra‡Observer le terrain‡侦查大地‡調查土地',
    nil,
    'Relaxe e aproveite o passeio. Ao terminar a sondagem, fale novamente com Altruis.‡Приведите спинку кресла в вертикальное положение и пристегните ремни безопасности. Приятного полета! Когда закончите осмотр лагерей с воздуха, доложите Алтруису обо всем, что вы видели.‡Lehnt Euch zurück und genießt Euren Flug. Sprecht mit Altruis wenn die Besichtigung abgeschlossen ist.‡편히 앉아 비행을 즐기십시오. 조사가 끝나면 알트루이스와 대화하면 됩니다.‡Siéntate y disfruta del paseo. Habla con Altruis cuando hayas terminado la inspección.‡Siéntate y disfruta del paseo. Habla con Altruis cuando hayas terminado la inspección.‡Asseyez-vous et profitez du voyage. Parlez à Altruis quand vous aurez terminé l\'observation.‡好好享受这趟旅程吧。调查完毕之后跟奥图里斯谈一谈。‡坐好享受旅程。等調查完成後和奧翠司談談。',
  }
},
[9992] = {
  {
    'Sementes de olemba‡Семена олембы‡Olembasamen‡올렘바 씨앗‡Semillas de olemba‡Semillas de olemba‡Graines d\'olemba‡奥雷巴种子‡奧萊姆貝種子',
    nil,
    'Colete 30 Sementes de Olemba e entregue-as para Ros\'eleth, na Fortaleza Alleriana.‡Соберите 30 семян олембы и отнесите их Роз\'алете в бастион Аллерии.‡Sammelt 30 Olembasamenkörner und kehrt dann zu Ros\'eleth in Allerias Feste zurück.‡올렘바 씨앗 30개를 모아서 알레리아 성채에 있는 로스엘레스에게 가져가야 합니다.‡Consigue 30 semillas de olemba y llévaselas a Ros\'eleth en el Bastión Allerian.‡Consigue 30 semillas de olemba y llévaselas a Ros\'eleth en el Bastión Allerian.‡Ramassez 30 Graines d\'olemba et apportez-les à Ros\'eleth au Bastion allérien.‡收集30颗奥雷巴种子，把它们交给奥蕾莉亚要塞的洛瑟蕾丝。‡收集30顆奧萊姆貝種子交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[9993] = {
  {
    'Óleo de semente de olemba‡Масло из семян олембы‡Olembaöl‡올렘바 씨앗 기름‡Aceite de semilla de olemba‡Aceite de semilla de olemba‡Huile de graines d\'olemba‡奥雷巴油‡奧萊姆貝種子油',
    nil,
    'Traga 30 Sementes de Olemba para Rakoria, na Vila de Quebrapedra.‡Принесите 30 семян олембы Ракории в форт Камнеломов.‡Bringt 30 Olembasamenkörner zu Rakoria in der Steinbrecherfeste.‡돌망치 요새에 있는 라코리아에게 올렘바 씨앗 30개를 가져가야 합니다.‡Lleva 30 semillas de olemba a Rakoria, en el Bastión Rompepedras.‡Lleva 30 semillas de olemba a Rakoria, en el Bastión Rompepedras.‡Apportez 30 Graines d\'olemba à Rakoria au fort des Brise-pierres.‡将30颗奥雷巴种子交给裂石堡的拉克妮亚。‡將30顆奧萊貝種子交給碎石堡的瑞蔻莉雅。',
  }
},
[9994] = {
  {
    'O que são essas coisas?‡Что это такое?‡Was ist das?‡물건의 정체‡¿Qué son estas cosas?‡¿Qué son estas cosas?‡Que sont ces choses ?‡这些东西是什么？‡這些是什麼東西?',
    nil,
    'Entregue a Caixa de Peças para Jenai Sussurrastra na Fortaleza Alleriana, que fica na Mata Terokkar.‡Доставьте ящик с деталями Дженайе Шепот Звезд в бастион Аллерии в лесу Тероккар.‡Bringt den Kasten mit Ersatzteilen zu Jenai Sternwisper in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 지나이 스타위스퍼에게 부품 상자를 전달해야 합니다.‡Lleva la caja de piezas a Jenai Susurrestelar en el Bastión Allerian, en el Bosque de Terokkar.‡Lleva la caja de piezas a Jenai Susurrestelar en el Bastión Allerian, en el Bosque de Terokkar.‡Apportez la Boîte de pièces détachées à Jenai Murmétoile au Bastion allérien dans la forêt de Terokkar.‡将这一箱零件交给泰罗卡森林奥蕾莉亚要塞的杰奈·星语。‡將一箱零件運回泰洛卡森林交給艾蘭里堡壘的珍奈·星語。',
  }
},
[9995] = {
  {
    'O que são essas coisas?‡Что это такое?‡Was ist das?‡뭐야, 이건?‡¿Qué son estas cosas?‡¿Qué son estas cosas?‡Que sont ces choses ?‡这些东西是什么？‡這些是什麼東西?',
    nil,
    'Entregue a Caixa de Peças para Tooki na Vila de Quebrapedra, que fica na Mata Terokkar.‡Доставьте ящик с деталями Туки в форт Камнеломов в лесу Тероккар.‡Bringt den Kasten mit Ersatzteilen zu Tooki in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 투키에게 부품 상자를 가져가야 합니다.‡Lleva la caja de piezas a Tooki en el Bastión Rompepedras, en el Bosque de Terokkar.‡Lleva la caja de piezas a Tooki en el Bastión Rompepedras, en el Bosque de Terokkar.‡Apportez la Boîte de pièces détachées à Tooki au fort des Brise-pierres dans la forêt de Terokkar.‡将这一箱零件交给泰罗卡森林裂石堡的图基。‡將一箱零件運回泰洛卡森林交給碎石堡的吐奇。',
  }
},
[9996] = {
  {
    'Ataque ao Pontal Asardente‡Нападение на лагерь Огнекрылых‡Angriff auf den Posten der Feuerschwingen‡불꽃날개 거점 공격‡Ataque en el Alto Ala de Fuego‡Ataque en el Alto Ala de Fuego‡L\'attaque de la halte Aile-de-feu‡攻击火翼岗哨‡攻擊火翼崗哨',
    nil,
    'Mate 10 Defensores Asardentes, 10 Guarda-sangues Asardentes e 10 Bruxos Asardentes. A seguir, fale novamente com o Tenente Meridian no Posto Alleriano, que fica na Mata Terokkar.‡Убейте 10 защитников, 10 кровавых стражей и 10 чернокнижников из армии Огнекрылых, после чего вернитесь к лейтенанту Меридиану на заставу Аллерии в лесу Тероккар.‡Tötet 10 Verteidiger der Feuerschwingen, 10 Blutwärter der Feuerschwingen und 10 Hexenmeister der Feuerschwingen. Meldet Euch dann bei Leutnant Meridian bei Allerias Posten in den Wäldern von Terokkar zurück.‡불꽃날개 파수병 10명, 불꽃날개 붉은경비병 10명, 불꽃날개 흑마법사 10명을 처치한 후, 테로카르 숲의 알레리아 초소에 있는 부관 메르디앙에게 보고하십시오.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al teniente Meridiano en el Puesto Allerian del Bosque de Terokkar.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al teniente Meridiano en el Puesto Allerian del Bosque de Terokkar.‡Tuez 10 Défenseurs Aile-de-feu, 10 Garde-sang Aile-de-feu et 10 Démonistes Aile-de-feu. Puis retournez au Poste allérien dans la forêt de Terokkar pour faire votre rapport au lieutenant Meridian.‡杀死10个火翼防御者、10个火翼血警卫和10个火翼术士，然后向泰罗卡森林奥蕾莉亚岗哨的米利迪安中尉复命。‡殺死10個火翼防衛者，10個火翼血守衛，10個火翼術士。再回到泰洛卡森林向艾蘭里哨站的莫瑞狄恩中尉回報。',
  }
},
[9997] = {
  {
    'Ataque ao Pontal Asardente‡Нападение на лагерь Огнекрылых‡Angriff auf den Posten der Feuerschwingen‡불꽃날개 거점 공격‡Ataque en el Alto Ala de Fuego‡Ataque en el Alto Ala de Fuego‡L\'attaque de la halte Aile-de-feu‡攻击火翼岗哨‡攻擊火翼崗哨',
    nil,
    'Mate 10 Defensores Asardentes, 10 Guarda-sangues Asardentes e 10 Bruxos Asardentes. A seguir, apresente-se à Sargento Chawni no Acampamento Quebrapedra, que fica na Mata Terokkar.‡Убейте 10 защитников, 10 кровавых стражей и 10 чернокнижников из армии Огнекрылых, после чего поговорите с сержантом Чауни в лагере Камнеломов, что в лесу Тероккар.‡Tötet 10 Verteidiger der Feuerschwingen, 10 Blutwärter der Feuerschwingen und 10 Hexenmeister der Feuerschwingen. Meldet Euch dann bei Unteroffizier Chawni im Steinbrecherlager in den Wäldern von Terokkar zurück.‡불꽃날개 파수병, 불꽃날개 붉은경비병, 그리고 불꽃날개 흑마법사를 10명씩 해치워야 합니다. 그런 다음 테로카르 숲의 돌망치 야영지에 있는 하사관 차우니에게 보고하십시오.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Mata a 10 defensores Ala de Fuego, 10 depositarios de sangre Ala de Fuego y 10 brujos Ala de Fuego. Después, informa al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Tuez 10 Défenseurs Aile-de-feu, 10 Garde-sang Aile-de-feu et 10 Démonistes Aile-de-feu. Puis retournez au camp des Brise-pierres dans la forêt de Terokkar pour faire votre rapport au sergent Chawni.‡杀死10个火翼防御者、10个火翼血警卫和10个火翼术士，然后向泰罗卡森林裂石堡的卡乌尼中士复命。‡殺死10個火翼防衛者，10個火翼血守衛，10個火翼術士。再回到泰洛卡森林向碎石營地的丘尼士官回報。',
  }
},
[9998] = {
  {
    'Vizinhos rebeldes‡Беспокойные соседи‡Widerspenstige Nachbarn‡사나운 이웃‡Vecinos indisciplinados‡Vecinos indisciplinados‡Des voisins encombrants‡野蛮的邻居‡難搞的鄰居',
    nil,
    'Mate 12 Peões Deformados e, a seguir, apresente-se a Theloria Umbramanto, no Posto Alleriano.‡Убейте 12 астральных батраков и доложите об этом Телории Плащ Теней на заставу Аллерии.‡Tötet 12 verunstaltete Peons und meldet Euch dann bei Theloria Dämmermantel bei Allerias Posten.‡일그러진 일꾼 12명을 처치한 후 알레리아 초소에 있는 텔로리아 셰이드클록에게 보고해야 합니다.‡Mata a 12 peones distorsionados e informa a Theloria Capasombría del Puesto Allerian.‡Mata a 12 peones distorsionados e informa a Theloria Capasombría del Puesto Allerian.‡Tuez 12 Péons redimensionnés puis faites votre rapport à Theloria Capedombre au Poste allérien.‡杀死12名扭曲的苦工，然后向奥蕾莉亚岗哨的塞洛莉娅·影衣报告。‡殺死12個乖戾的苦工再向艾蘭里哨站的瑟蘿莉雅·影篷回報。',
  }
},
[9999] = {
  {
    'Ganhando tempo‡Выиграть время‡Spiel auf Zeit‡시간 벌기‡Tiempo extra‡Tiempo extra‡Gagner du temps‡争取时间‡爭取時間',
    nil,
    'Altruis, o Sofredor, no oeste de Nagrand, quer que você mate 2 Guardas Vis Legionários, 3 Engenheiros Mo\'args e 8 Engenhoqueiros Gan\'args.‡Убейте 2 стражей Скверны - легионеров, 3 мо\'аргов-инжененеров и 8 ган\'аргов-ремонтников.‡Altruis der Leidende im westlichen Nagrand möchte, dass Ihr 2 Legionäre der Teufelswache, 3 Ingenieure der Mo\'arg und 8 Tüftler der Gan\'arg tötet.‡나그란드 서부에 있는 고뇌의 알트루이스가 지옥군단병 2명, 모아그 기술자 3명, 간아그 땜장이 8명을 해치워달라고 부탁했습니다.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que mates a 2 legionarios guardia vil, 3 ingenieros Mo\'arg y 8 manitas Gan\'arg.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que mates a 2 legionarios guardia vil, 3 ingenieros Mo\'arg y 8 manitas Gan\'arg.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de tuer 2 Légionnaires gangregarde, 3 Ingénieurs mo\'arg et 8 Bricoleurs gan\'arg.‡纳格兰西部的受难者奥图里斯要求你除掉2个恶魔卫士军团士兵、3个莫尔葛工程师和8个甘尔葛修理工。‡西納葛蘭的『受難者』奧翠司要你去殺死2個惡魔守衛領導者，3個莫阿格工程師和8個甘納格技工。',
  }
},
[10000] = {
  {
    'Uma presença indesejável‡Нежелательное присутствие‡Unangenehme Gesellschaft‡반갑지 않은 존재‡Una presencia inoportuna‡Una presencia inoportuna‡Une présence indésirable‡不受欢迎者‡不受歡迎的存在',
    nil,
    'Mate 12 Peões Deformados e, a seguir, apresente-se ao Assombrante Kaide.‡Убейте 12 астральных батраков и доложите об этом тенелову Кайду.‡Tötet 12 verunstaltete Peons und meldet Euch dann bei Schattenpirscher Kaide.‡일그러진 일꾼 12명을 해치운 다음 그림자추적자 카이드에게 보고하십시오.‡Mata a 12 peones distorsionados y después preséntate ante el acechasombras Kaide.‡Mata a 12 peones distorsionados y después preséntate ante el acechasombras Kaide.‡Tuez 12 Péons redimensionnés puis faites votre rapport au traqueur des ombres Kaide.‡杀死12名扭曲的苦工，然后向追踪者凯德报告。‡殺死12個乖戾的苦工再向巡影者凱德回報。',
  }
},
[10001] = {
  {
    'O mestre-planejador‡Главный планировщик‡Der Meisterplaner‡수석 설계사‡El maestro planificador‡El maestro planificador‡Le maître d\'œuvre‡主规划师‡規劃大師',
    nil,
    'Altruis, o Sofredor, do oeste de Nagrand, quer que você recupere o diagrama do mestre-planejador.‡Алтруис Страдалец из западного Награнда просит вас раздобыть чертежи главного планировщика.‡Altruis der Leidende im westlichen Nagrand möchte, dass Ihr die Blaupausen des Meisterplaners besorgt.‡나그란드 서부에 있는 고뇌의 알트루이스가 수석 설계사의 설계도를 찾아달라고 부탁했습니다.‡Altruis el Sufridor, en la parte oeste de Nagrand te ha pedido que consigas los planos del maestro planificador.‡Altruis el Sufridor, en la parte oeste de Nagrand te ha pedido que consigas los planos del maestro planificador.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de récupérer les Plans du maître d\'œuvre.‡纳格兰西部的受难者奥图里斯要求你取回主规划师的蓝图。‡西納葛蘭的『受難者』奧翠司要你取得規劃大師的藍圖。',
  }
},
[10002] = {
  {
    'O contato de Asardente‡Посредник Огнекрылых‡Vermittler der Feuerschwingen‡불꽃날개 연락책‡El contacto Ala de Fuego‡El contacto Ala de Fuego‡La messagère d\'Aile-de-feu‡莉塞蕾·火纹‡火翼聯繫',
    nil,
    'Localize e mate Lisaile Teceflamas. A seguir, fale novamente com Theloria Umbramanto.‡Найдите и убейте Лизель Огнепрядку, после чего вернитесь к Телории Плащ Теней.‡Findet und tötet Lisaile Feuerweber und kehrt dann zu Theloria Dämmermantel zurück.‡리세일 파이어위버를 찾아서 처치한 후 텔로리아 셰이드클록에게 돌아가야 합니다.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver a Theloria Capasombría.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver a Theloria Capasombría.‡Trouvez et tuez Lisaile Tissefeu, puis retournez voir Theloria Capedombre.‡找到莉塞蕾·火纹并杀掉她，然后向塞洛莉娅·影衣复命。‡找到並殺死麗莎艾歐·織火者，再回去找瑟蘿莉雅·影篷。',
  }
},
[10003] = {
  {
    'O contato de Asardente‡Посредник Огнекрылых‡Vermittler der Feuerschwingen‡불꽃날개 거점의 연락책‡El contacto Ala de Fuego‡El contacto Ala de Fuego‡La messagère d\'Aile-de-feu‡莉塞蕾·火纹‡火翼聯繫',
    nil,
    'Localize e mate Lisaile Teceflamas. A seguir, fale novamente com o Assombrante Kaide.‡Найдите и убейте Лизель Огнепрядку, после чего вернитесь к тенелову Кайду.‡Findet und tötet Lisaile Feuerweber und kehrt dann zu Schattenpirscher Kaide zurück.‡리세일 파이어위버를 찾아서 해치운 후 그림자추적자 카이드에게 돌아가십시오.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver al acechasombras Kaide.‡Localiza y mata a Lisaile Tejefuego y, a continuación, vuelve a ver al acechasombras Kaide.‡Trouvez et tuez Lisaile Tissefeu, puis retournez voir le traqueur des ombres Kaide.‡找到莉塞蕾·火纹并杀掉她，然后向追踪者凯德复命。‡找到並殺死麗莎艾歐·織火者，再回去找巡影者凱德。',
  }
},
[10004] = {
  {
    'Paciência e compreensão‡Терпение и понимание‡Geduld und Verständnis‡인내와 이해심‡Paciencia y comprensión‡Paciencia y comprensión‡Patience et compréhension‡耐心与理解‡耐心與諒解',
    nil,
    'Altruis, o Sofredor, que está na parte oeste de Nagrand, quer quer você entregue o Diagrama do Mestre-planejador para Sal\'salabim, em Shattrath, e o convença a ajudá-lo.‡Покажите чертежи главного планировщика Саль\'салабиму в Шаттрате и уговорите его помочь вам.‡Altruis der Leidende im westlichen Nagrand möchte, dass Ihr die Blaupausen des Meisterplaners zu Sal\'salabim in Shattrath bringt und ihn überredet, euch zu helfen.‡나그란드 서부에 있는 고뇌의 알트루이스가 샤트라스의 살살라빔에게 수석 설계사의 설계도를 가지고 가서 설득한 후 도움을 받으라고 부탁했습니다.‡Altruis el Sufridor, en el oeste de Nagrand, quiere que lleves los planos del maestro planificador a Sal\'salabim en la Ciudad de Shattrath y que le convenzas para que te ayude.|n‡Altruis el Sufridor, en el oeste de Nagrand, quiere que lleves los planos del maestro planificador a Sal\'salabim en la Ciudad de Shattrath y que le convenzas para que te ayude.|n‡Altruis le Souffrant dans l\'ouest de Nagrand veut que vous apportiez les Plans du maître d\'œuvre à Sal\'salabim à Shattrath et que vous le convainquiez de vous aider.‡纳格兰西部的受难者奥图里斯要你将主规划师的蓝图交给沙塔斯城中的萨萨拉比姆，并说服他帮助你。‡西納葛蘭的『受難者』奧翠司要你帶著規劃大師的藍圖去找撒塔斯城的沙薩拉畢恩並說服他幫助你。',
  }
},
[10005] = {
  {
    'Informar Ataterra Tavgren‡Вести для землепряда Тавгрена‡Erdbinder Tavgren Bescheid sagen‡대지의 결속자 타브그렌과 대화‡Informar al vinculador terrestre Tavgren‡Informar al vinculador terrestre Tavgren‡Informer le lieur de terre Tavgren‡告知缚地者塔弗格伦‡讓縛地者塔伏格蘭知道',
    nil,
    'Fale com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, na Mata Terokkar.‡Поговорите с заклинателем земли Тавгреном возле перелеска Кенария в лесу Тероккар.‡Sprecht mit Erdbinder Tavgren außerhalb des Cenariusdickichts in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀 바로 밖에 있는 대지의 결속자 타브그렌과 대화해야 합니다.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林塞纳里奥树林外的缚地者塔弗格伦谈一谈。‡到泰洛卡森林去和塞納里奧灌木林外的縛地者塔伏格蘭談談。',
  }
},
[10006] = {
  {
    'Informar Ataterra Tavgren‡Вести для землепряда Тавгрена‡Erdbinder Tavgren Bescheid sagen‡대지의 결속자 타브그렌에게 알려주기‡Informar al vinculador terrestre Tavgren‡Informar al vinculador terrestre Tavgren‡Informer le lieur de terre Tavgren‡告知缚地者塔弗格伦‡讓縛地者塔伏格蘭知道',
    nil,
    'Fale com o Ataterra Tavgren. Você pode encontrá-lo do lado de fora da Mata Cenariana, na Mata Terokkar.‡Поговорите с заклинателем земли Тавгреном возле перелеска Кенария в лесу Тероккар.‡Sprecht mit Erdbinder Tavgren außerhalb des Cenariusdickichts in den Wäldern von Terokkar.‡테로카르 숲의 세나리온 수풀 바로 바깥에 있는 대지의 결속자 타브그렌과 대화하십시오.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Habla con el vinculador terrestre Tavgren justo fuera del Matorral Cenarion, en el Bosque de Terokkar.‡Parlez au lieur de terre Tavgren juste à l\'extérieur du Fourré cénarien dans la forêt de Terokkar.‡与泰罗卡森林塞纳里奥树林外的缚地者塔弗格伦谈一谈。‡到泰洛卡森林去和塞納里奧灌木林外的縛地者塔伏格蘭談談。',
  }
},
[10007] = {
  {
    'Reduzir as hostes‡Ослабление врага‡Die Reihen lichten‡군사 줄이기‡Disminuir las filas‡Disminuir las filas‡Éclaircir les rangs‡削弱邪兽人‡削弱敵軍',
    nil,
    'Mate 10 Devastadores Mascaosso e 6 Quebradorsos Mascaosso e, a seguir, fale novamente com Theloria Umbramanto.‡Убейте 10 уничтожителей и 6 спиноломов из клана Костеглодов, после чего вернитесь к Телории Плащ Теней.‡Tötet 10 Verwüster der Knochenmalmer und 6 Kreuzbrecher der Knochenmalmer und kehrt dann zu Theloria Dämmermantel zurück.‡해골이빨 약탈자 10명, 해골이빨 투사 6명을 처치한 다음 텔로리아 셰이드클록에게 돌아가야 합니다.‡Mata a 10 devastadores Mascahuesos y a 6 partedorsales Mascahuesos y ve a ver a Theloria Capasombría.‡Mata a 10 devastadores Mascahuesos y a 6 partedorsales Mascahuesos y ve a ver a Theloria Capasombría.‡Tuez 10 Dévastateurs Mâche-les-os et 6 Brise-dos Mâche-les-os puis retournez voir Theloria Capedombre.‡杀死10名噬骨蹂躏者和6名噬骨碎脊者，然后向塞洛莉娅·影衣复命。‡殺死10個噬骨破壞者和6個噬骨斷背者再回去找瑟蘿莉雅·影篷。',
  }
},
[10008] = {
  {
    'O que acontece em Terokkar morre em Terokkar‡Секреты Тероккара не покидают его границ‡Was in Terokkar geschieht, bleibt in Terokkar‡테로카르 숲에서 일어난 일‡Lo que pasa en Terokkar, se queda en Terokkar‡Lo que pasa en Terokkar, se queda en Terokkar‡Ce qui se passe à Terokkar reste à Terokkar‡泰罗卡的事情，在泰罗卡解决‡把泰洛卡的事留在泰洛卡',
    nil,
    'O Assombrante Kaide quer quer você mate 10 Devastadores Mascaosso e 6 Quebradorsos Mascaosso.‡Убейте 10 уничтожителей и 6 спиноломов из клана Костеглодов по просьбе тенелова Кайда.‡Schattenpirscher Kaide möchte, dass Ihr 10 Verwüster der Knochenmalmer und 6 Kreuzbrecher der Knochenmalmer tötet.‡그림자추적자 카이드가 해골이빨 약탈자 10명, 해골이빨 투사 6명을 해치워 달라고 부탁했습니다.‡El acechasombras Kaide quiere que mates a 10 devastadores Mascahuesos y 6 partedorsales Mascahuesos.‡El acechasombras Kaide quiere que mates a 10 devastadores Mascahuesos y 6 partedorsales Mascahuesos.‡Le traqueur des ombres Kaide veut que vous alliez tuer 10 Dévastateurs Mâche-les-os et 6 Brise-dos Mâche-les-os.‡追踪者凯德要你杀死10名噬骨蹂躏者和6名噬骨碎脊者。‡巡影者凱德要你去殺死10個噬骨破壞者和6個噬骨斷背者。',
  }
},
[10009] = {
  {
    'Quebrando as cabeças‡Золото за тумаки‡Ein paar Schädel spalten‡해결사‡Aplastar unas calaveras‡Aplastar unas calaveras‡Casser des crânes‡大打出手‡解決一些傢伙',
    nil,
    'Sal\'salabim, de Shattrath, quer que você cobre a Dívida de Raliq, a Dívida de Cus\'cuz e a Dívida de Floon.‡Взыщите долги с Ралика, Куш\'куша и Флуна.‡Sal\'salabim in Shattrath möchte, dass Ihr Raliqs Schulden, Kusch\'kuschs Schulden und Floons Schulden eintreibt.‡샤트라스에 있는 살살라빔이 라리크의 빚, 쿠쉬쿠쉬의 빚, 플룬의 빚을 받아오라고 부탁했습니다.‡Sal\'salabim de la Ciudad de Shattrath quiere que recuperes la deuda de Raliq, la deuda de Coosh\'coosh y la deuda de Floon.‡Sal\'salabim de la Ciudad de Shattrath quiere que recuperes la deuda de Raliq, la deuda de Coosh\'coosh y la deuda de Floon.‡Sal\'salabim de Shattrath veut que vous récupériez la Dette de Raliq, la Dette de Coosh\'coosh et la Dette de Floon.‡沙塔斯城的萨萨拉比姆要你取回拉里克的债款、库什库什的债款和弗鲁恩的债款。‡撒塔斯城的沙薩拉畢恩要你取回拉利克的欠款，庫庫許的欠款和服倫的欠款。',
  }
},
[10010] = {
  {
    'É fácil assim?‡Не так просто?‡So einfach ist das?‡쉽지 않은 임무‡¿Es así de fácil?‡¿Es así de fácil?‡C\'est si facile ?‡就这么简单？‡就這麼簡單嗎?',
    nil,
    'Sal\'salabim, de Shattrath, quer que você fale novamente com Altruis, o Sofredor, no oeste de Nagrand.‡Вернитесь к Алтруису Страдальцу в западный Награнд.‡Sal\'salabim in Shattrath möchte, dass Ihr zu Altruis dem Leider im westlichen Nagrand zurückkehrt.‡샤트라스에 있는 살살라빔이 나그란드 서부에 있는 고뇌의 알트루이스에게 돌아가라고 부탁했습니다.‡Sal\'salabim en la Ciudad de Shattrath quiere que vayas a ver a Altruis el Sufridor en la parte oeste de Nagrand.‡Sal\'salabim en la Ciudad de Shattrath quiere que vayas a ver a Altruis el Sufridor en la parte oeste de Nagrand.‡Sal\'salabim de Shattrath veut que vous retourniez voir Altruis le Souffrant dans l\'ouest de Nagrand.‡沙塔斯城的萨萨拉比姆要你返回纳格兰西部向受难者奥图里斯复命。‡撒塔斯城的沙薩拉畢恩要你回到西納葛蘭找『受難者』奧翠司。',
  }
},
[10011] = {
  {
    'Campo-forja: aniquilado‡Лагеря Легиона: уничтожены‡Konstruktionslager: zerstört‡괴철로 기지 섬멸‡Campamento Forja: aniquilado‡Campamento Forja: aniquilado‡Le camp de forge Anéanti‡扫荡铸魔营地‡煉冶場:徹底擊潰',
    nil,
    'Altruis, o Sofredor, do oeste de Nagrand, quer que você destrua o Campo-forja: Ódio e destrua o Campo-forja: Medo.‡Уничтожьте лагеря Легиона: Страх и Ненависть.‡Altruis der Leidende im westlichen Nagrand möchte, dass Ihr das Konstruktionslager: Hass und das Konstruktionslager: Furcht zerstört.‡나그란드 서부에 있는 고뇌의 알트루이스가 증오의 괴철로 기지와 경악의 괴철로 기지를 파괴해 달라고 부탁했습니다.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que destruyas el Campamento Forja: Odio y el Campamento Forja: Miedo.‡Altruis el Sufridor, al oeste de Nagrand, te ha pedido que destruyas el Campamento Forja: Odio y el Campamento Forja: Miedo.‡Altruis le Souffrant dans l\'ouest de Nagrand vous a demandé de détruire le Camp de forge Haine et le Camp de forge Peur.‡纳格兰西部的受难者奥图里斯要求你摧毁铸魔营地：仇恨和铸魔营地：畏惧。‡納葛蘭西邊的『受難者』奧翠司要你去摧毀煉冶場:仇恨和煉冶場:恐懼。',
  }
},
[10012] = {
  {
    'Planos dos orcs vis‡Планы орков Скверны‡Höllenorcpläne‡타락한 오크의 계획서‡Planos de orcos viles‡Planos de orcos viles‡Les plans des gangr\'orcs‡邪兽人的计划‡魔獄獸人計畫',
    nil,
    'Leve os Planos dos Orcs Vis para Bertelm na Fortaleza Alleriana, na Mata Terokkar.‡Добудьте планы орков Скверны для Бертельма в Бастионе Аллерии, что в лесу Тероккар.‡Bringt die Höllenorcpläne zu Bertelm in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 베르텔름에게 타락한 오크의 계획서를 가져가야 합니다.‡Lleva los planos de orcos viles a Bertelm en el Bastión Allerian, en el Bosque de Terokkar.‡Lleva los planos de orcos viles a Bertelm en el Bastión Allerian, en el Bosque de Terokkar.‡Apportez les Plans des gangr\'orcs à Bertelm au Bastion allérien, dans la Forêt de Terokkar.‡将邪兽人的计划交给泰罗卡森林中奥蕾莉亚要塞的波尔泰姆。‡到泰洛卡森林的艾蘭里堡壘，將魔獄獸人計畫交給伯特泰歐。',
  }
},
[10013] = {
  {
    'A mão invisível‡Невидимая длань‡Eine ungesehene Hand‡보이지 않는 손‡Una mano invisible‡Una mano invisible‡Une main invisible‡幕后黑手‡看不見的手',
    nil,
    'Leve os Planos dos Orcs Vis para Rokar. Você pode encontrá-lo na Vila de Quebrapedra, que fica na Mata Terokkar.‡Добудьте планы орков Скверны для Рокага. Его можно найти в Форте Камнеломов, что в лесу Тероккар.‡Bringt die Höllenorcpläne zu Rokag in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 로카그에게 타락한 오크의 계획서를 가져가야 합니다.‡Lleva los planos de orcos viles a Rokag al Bastión Rompepedras, en el Bosque de Terokkar.‡Lleva los planos de orcos viles a Rokag al Bastión Rompepedras, en el Bosque de Terokkar.‡Apportez les Plans des gangr\'orcs à Rokag au Fort des Brise-pierres, dans la Forêt de Terokkar.‡将邪兽人的计划交给泰罗卡森林中裂石堡的罗卡格。‡到泰洛卡森林的碎石堡，將魔獄獸人計畫交給瑞克格。',
  }
},
[10014] = {
  {
    'The Firewing Point Project‡Проект лагеря Огнекрылых‡Das Projekt des Postens der Feuerschwingen‡불꽃날개 거점 계획‡El proyecto del Alto Ala de Fuego‡El proyecto del Alto Ala de Fuego‡Le projet de la halte Aile-de-feu‡火翼岗哨的项目‡火翼崗哨計畫',
    nil,
    'Steal the four Mana Bomb Code Sheets and deliver them to Lieutenant Meridian at the Allerian Post in Terokkar Forest.‡Украдите 4 листа кодирования мана-бомб и отнесите их лейтенанту Меридиану на заставу Аллерии в лесу Тероккар.‡Stehlt die vier Codetabellen der Manabombe und bringt sie zu Meridian in Allerias Posten in den Wäldern von Terokkar.‡마나 폭탄 접근암호표 4쪽을 훔쳐서 테로카르 숲의 알레리아 초소에 있는 부관 메르디앙에게 가져가야 합니다.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al teniente Meridiano en la Puesto Allerian del Bosque de Terokkar.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al teniente Meridiano en la Puesto Allerian del Bosque de Terokkar.‡Volez les quatre Feuilles de code de la bombe de mana et apportez-les au lieutenant Meridian au Poste allérien dans la forêt de Terokkar.‡偷取四张魔法炸弹密码表，把它们交给泰罗卡森林中奥蕾莉亚岗哨的米利迪安中尉。‡偷取4份法力炸彈密碼清單並將它們送到泰洛卡森林的艾蘭里哨站交給莫瑞狄恩中尉。',
  }
},
[10015] = {
  {
    'The Firewing Point Project‡Проект лагеря Огнекрылых‡Das Projekt des Postens der Feuerschwingen‡불꽃날개 거점 계획‡El proyecto del Alto Ala de Fuego‡El proyecto del Alto Ala de Fuego‡Le projet de la halte Aile-de-feu‡火翼岗哨的项目‡火翼崗哨計畫',
    nil,
    'Steal the four Mana Bomb Code Sheets and deliver them to Sergeant Chawni at Stonebreaker Camp in Terokkar Forest.‡Украдите 4 листа кодирования мана-бомб и отнесите их сержанту Чауни в лагерь Камнеломов в лесу Тероккар.‡Stehlt die vier Codetabellen der Manabombe und bringt sie zu Unteroffizier Chawni im Steinbrecherlager in den Wäldern von Terokkar.‡마나 폭탄 접근암호표 4개를 훔쳐서 테로카르 숲의 돌망치 야영지에 있는 하사관 차우니에게 가져가야 합니다.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Roba cuatro hojas de código de bomba de maná y entrégaselas al sargento Chawni en el Campamento Rompepedras del Bosque de Terokkar.‡Volez les quatre Feuilles de code de la bombe de mana et apportez-les au sergent Chawni au camp des Brise-pierres dans la forêt de Terokkar.‡偷取四张魔法炸弹密码表，把它们交给泰罗卡森林中裂石营地的卡乌尼中士。‡偷取4份法力炸彈密碼清單並將它們送到泰洛卡森林的碎石營地給丘尼士官。',
  }
},
[10016] = {
  {
    'Caudas de worgs silvestres‡Хвосты лесных воргов‡Waldworgschwänze‡검은숲늑대 꼬리‡Colas de huargos grises‡Colas de huargos grises‡Les queues de worgs des bois‡森林座狼的尾巴‡灰座狼尾巴',
    nil,
    'Bertelm, na Fortaleza Alleriana, quer que você traga 12 Caudas de Worgs Silvestres para ele. As caudas podem ser encontradas tanto em worgs silvestres quando em worgs silvestres alfa.‡Принесите 12 хвостов лесных воргов Бертельму в бастион Аллерии. Хвосты можно добыть с лесных воргов или их вожаков.‡Bertelm in Allerias Feste möchte, dass Ihr ihm 12 Waldworgschwänze bringt. Die Schwänze können von Waldworgs oder Waldworgalphas stammen.‡알레리아 성채에 있는 베르텔름이 검은숲늑대 또는 우두머리 검은숲늑대에게서 검은숲늑대 꼬리 12개를 가져다 달라고 부탁했습니다.‡Bertelm del Bastión Allerian quiere que le traigas 12 colas de huargo gris. Las colas pueden ser de huargo gris o de huargo gris alfa.‡Bertelm del Bastión Allerian quiere que le traigas 12 colas de huargo gris. Las colas pueden ser de huargo gris o de huargo gris alfa.‡Bertelm du Bastion allérien veut que vous lui apportiez 12 Queues de worgs des bois. Vous pouvez prendre ces queues soit sur des worgs des bois, soit sur des worgs Alpha des bois.‡奥蕾莉亚要塞的波尔泰姆想让你收集12条森林座狼的尾巴。这些尾巴可以从森林座狼和森林座狼前锋身上获得。‡艾蘭里堡壘的伯特泰歐要你去幫他帶回來12個灰座狼尾巴。可以從灰座狼或灰座狼首領身上取得。',
  }
},
[10017] = {
  {
    'Suprimentos escassos‡Нехватка припасов‡Schwindende Vorräte‡모자라는 재고‡Cortos de suministros‡Cortos de suministros‡Des réserves durement sollicitées‡物资紧张‡物資短缺',
    nil,
    'Leve 8 Vesículas de Peçonha de Presátera para Sha\'nir em Sattrath.|n|nCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Принесите 8 ядовитых желез пауков-смертеплетов Ша\'нир в Шаттрат.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt 8 Schreckensgiftbeutel zu Sha\'nir in Shattrath.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 샤니르에게 공포의 송곳니 독주머니 8개를 가져가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva 8 sacos de veneno de colminferno a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva 8 sacos de veneno de colminferno a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez 8 Glandes à venin de croc-d\'effroi à Sha\'nir à Shattrath.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡给沙塔斯城的莎妮尔带回8个巨牙毒囊。|n|n为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡將8個懼牙毒囊交給撒塔斯城的薩尼爾。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10018] = {
  {
    'Vestimentas do espírito do lobo‡Одежды духа волка‡Gewänder des Wolfgeistes‡늑대 정령 예복‡Vestimentas del espíritu lobo‡Vestimentas del espíritu lobo‡Les habits de l\'esprit du loup‡狼魂之衣‡狼魂法衣',
    nil,
    'Traga 12 Pelagens de Worg Silvestre para Malkaz, na Vila de Quebrapedra.‡Принесите 12 шкур лесного ворга Малуказу в форт Камнеломов.‡Bringt 12 Waldworgpelze zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 검은숲늑대 모피 12개를 가져가야 합니다.‡Lleva 12 pelambres de huargos grises a Malukaz en el Bastión Rompepedras.‡Lleva 12 pelambres de huargos grises a Malukaz en el Bastión Rompepedras.‡Apportez 12 Fourrures de worg des bois à Malukaz au fort des Brise-pierres.‡给裂石堡的玛鲁卡兹带回12块森林座狼的毛皮交。‡將12塊灰座狼皮交給碎石堡的瑪魯卡茲。',
  }
},
[10019] = {
  {
    'Mais vesículas de peçonha‡Больше ядовитых желез‡Mehr Giftbeutel‡독주머니 추가 수집‡Más sacos de veneno‡Más sacos de veneno‡Plus de glandes à venin‡更多毒囊‡更多毒囊',
    nil,
    nil,
  }
},
[10020] = {
  {
    'Uma cura para Zahlia‡Лекарство для Залии‡Ein Heilmittel für Zahlia‡잘리아를 위한 약‡Una cura para Zahlia‡Una cura para Zahlia‡Un remède pour Zahlia‡萨恩莉亚的解药‡給札麗亞的解藥',
    nil,
    'Leve o Sangue do Petrifitante para Sha\'nir, em Shattrath.|n|nCumprir missões para os Aldor fará com que sua reputação com os Áugures diminua.‡Принесите Ша\'нир в Шаттрат кровь Камневзора.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt Steinstarrers Blut zu Sha\'nir in Shattrath.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 샤니르에게 돌딱부리의 피를 가져가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva la sangre de Mirada Pétrea a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva la sangre de Mirada Pétrea a Sha\'nir en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez le Sang de Regard-de-pierre à Sha\'nir à Shattrath.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将凝石者的血交给沙塔斯城的莎妮尔。|n|n为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡將岩石凝視者之血帶給撒塔斯城的薩尼爾。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10021] = {
  {
    'Restaurando a Luz‡Возрождение Света‡Das Licht wiederherstellen‡성스러운 빛을 복구하라‡Restaurar la Luz‡Restaurar la Luz‡Rétablir la Lumière‡重现圣光‡恢復聖光',
    nil,
    'Ishanah quer que você vá até o posto avançado Arakkoa a leste de Shattrath, e use a Ampola Abençoada para limpar o Altar do Leste, o Altar do Oeste e o Altar do Norte.‡Отправляйтесь на заставу Араккоа, что к востоку от Шаттрата, и при помощи благословленного фиала очистите восточный, западный и северный алтари, после чего вернитесь к Ишане.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Ishanah möchte, dass Ihr zum Arakkoaaußenposten östlich von Shattrath geht. Benutzt die gesegnete Phiole, um den östlichen Altar, den westlichen Altar und den nördlichen Altar zu reinigen.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡이샤나가 샤트라스 동쪽의 아라코아의 기지로 가서 축복받은 약병을 사용하여 동부 제단, 서부 제단, 북부 제단을 정화해 달라고 했습니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ishanah quiere que vayas a la avanzada arakkoa al este de la Ciudad de Shattrath y uses el vial bendito para purificar los altares Este, Norte y Oeste.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ishanah quiere que vayas a la avanzada arakkoa al este de la Ciudad de Shattrath y uses el vial bendito para purificar los altares Este, Norte y Oeste.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ishanah veut que vous vous rendiez à l\'avant-poste arakkoa à l\'est de Shattrath et que vous utilisiez la Fiole bénite pour purifier l\'Autel de l\'est, l\'Autel de l\'ouest et l\'Autel du nord.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡伊沙娜希望你能前往沙塔斯城正东方的鸦人前哨站，使用神圣之瓶净化东部祭坛、西部祭坛和北部祭坛。|n|n为奥尔多完成任务将会使你在占星者阵营中的声望等级降低。‡伊莎納要你去撒塔斯城東邊的阿拉卡前哨站使用神聖之瓶淨化東祭壇，西祭壇以及北祭壇。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10022] = {
  {
    'Ferroqueixo, o esquivo‡Неуловимый Железнозуб‡Der schwer zu fassende Eisenkiefer‡잡기 힘든 무쇠턱 늑대‡El esquivo Quijahierro‡El esquivo Quijahierro‡L\'insaisissable Gueule-de-fer‡狡猾的铁腭‡難捉摸的鐵顎',
    nil,
    'Traga a Pelagem de Ferroqueixo para Bertelm, na Fortaleza Alleriana.‡Принесите шкуру Железнозуба Бертельму в бастион Аллерии.‡Bringt Eisenkiefers Pelz zu Bertelm in Allerias Feste.‡알레리아 성채에 있는 베르텔름에게 무쇠턱 늑대 모피를 가져가야 합니다.‡Lleva la pelambre de quijahierro a Bertelm en el Bastión Allerian.‡Lleva la pelambre de Quijahierro a Bertelm en el Bastión Allerian.‡Apportez la Fourrure de Gueule-de-fer à Bertelm au Bastion allérien.‡为奥蕾莉亚要塞的波尔泰姆带回铁腭的毛皮。‡將鐵顎的生皮交給艾蘭里堡壘的伯特泰歐。',
  }
},
[10023] = {
  {
    'Patriarca Ferroqueixo‡Патриарх Железнозуб‡Patriarch Eisenkiefer‡우두머리, 무쇠턱 늑대‡Patriarca Quijahierro‡Patriarca Quijahierro‡Le patriarche Gueule-de-fer‡狼王铁腭‡鐵顎族王',
    nil,
    'Traga a Pelagem de Ferroqueixo para Malkaz, na Vila de Quebrapedra.‡Принесите шкуру Железнозуба Малуказу в форт Камнеломов.‡Bringt Eisenkiefers Pelz zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 무쇠턱 늑대 모피을 가져가야 합니다.‡Lleva la pelambre de Quijahierro a Malukaz en el Bastión Rompepedras.‡Lleva la pelambre de Quijahierro a Malukaz en el Bastión Rompepedras.‡Apportez la Fourrure de Gueule-de-fer à Malukaz au fort des Brise-pierres.‡将铁腭的毛皮交给裂石堡的玛鲁卡兹。‡將鐵顎的生皮交給碎石堡的瑪魯卡茲。',
  }
},
[10024] = {
  {
    'As visões de Voren\'thal‡Видения Ворен\'таля‡Voren\'thals Visionen‡보렌살의 환영‡Visiones de Voren\'thal‡Visiones de Voren\'thal‡Les visions de Voren\'thal‡沃雷塔尔的预言‡沃藍索的預言',
    nil,
    'Leve 8 Olhos de Basilisco Escamáqua para a Arcanista Adyria, em Shattrath.|n|nCumprir missões para os Áugures fará com que sua reputação com os Aldor diminua.‡Принесите 8 глаз гладкоспинных василисков чародейке Адирии в Шаттрат.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Bringt 8 Augen eines Dunstschuppenbasilisken zu Arkanistin Adyria in Shattrath.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡샤트라스에 있는 비전술사 아디리아에게 안개비늘 바실리스크 눈 8개를 가져가야 합니다.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Lleva 8 ojos de basilisco escama húmeda a la arcanista Adyria en la Ciudad de Shattrath.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Lleva 8 ojos de basilisco escama húmeda a la arcanista Adyria en la Ciudad de Shattrath.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Apportez 8 Yeux de basilic trempécaille à l\'arcaniste Adyria à Shattrath.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡将8颗湿鳞蜥蜴的眼睛交给沙塔斯城的奥术师艾蒂莉亚。|n|n为占星者完成任务将会使你在奥尔多阵营中的声望等级降低。‡將8個濕鱗蜥蜴眼交給撒塔斯城的秘法師艾德蕊雅。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10025] = {
  {
    'Mais olhos de basilisco‡Больше глаз василисков‡Mehr Basiliskenaugen‡바실리스크 눈 추가 수집‡Más ojos de basiliscos‡Más ojos de basiliscos‡Plus d\'yeux de basilic‡更多蜥蜴眼‡更多蜥蜴眼',
    nil,
    nil,
  }
},
[10026] = {
  {
    'Distúrbios mágicos‡Нарушение магического равновесия‡Magische Störungen‡마법 방해‡Alteraciones mágicas‡Alteraciones mágicas‡Perturbations magiques‡魔法扰动‡魔法干擾',
    nil,
    'Andarl, na Fortaleza Alleriana, quer que você mate 10 Espreitadores Dimensionais.‡Убейте 10 прыгуан по просьбе Андарла из бастиона Аллерии.‡Andarl in Allerias Feste möchte, dass Ihr 10 Sphärenjäger tötet.‡알레리아 성채에 있는 안다를이 차원의 추적자 10마리를 처치해 달라고 부탁했습니다.‡Andarl en el Bastión Allerian quiere que mates a 10 acechadores de distorsión.‡Andarl en el Bastión Allerian quiere que mates a 10 acechadores de distorsión.‡Andarl du Bastion allérien veut que vous alliez tuer 10 Traqueurs dimensionnels.‡奥蕾莉亚要塞的安达尔要求你杀死10只迁跃跟踪者。‡艾蘭里堡壘的安達爾歐要你殺死10個扭曲巡者。',
  }
},
[10027] = {
  {
    'Distúrbios mágicos‡Нарушение магического равновесия‡Magische Störungen‡마법 방해‡Alteraciones mágicas‡Alteraciones mágicas‡Perturbations magiques‡魔法扰动‡魔法干擾',
    nil,
    'Mate 10 Espreitadores Dimensionais e fale novamente com Kurgatok, na Vila de Quebrapedra.‡Убейте 10 прыгуан и вернитесь к Каргатоку в форт Камнеломов.‡Tötet 10 Sphärenjäger und kehrt dann zu Kurgatok in der Steinbrecherfeste zurück.‡차원의 추적자 10마리를 해치운 후 돌망치 요새에 있는 쿠르가톡에게 돌아가십시오.‡Mata a 10 acechadores de distorsión y vuelve a ver a Kurgatok en el Bastión Rompepedras.‡Mata a 10 acechadores de distorsión y vuelve a ver a Kurgatok en el Bastión Rompepedras.‡Tuez 10 Traqueurs dimensionnels et retournez voir Kurgatok au fort des Brise-pierres.‡杀死10只迁跃跟踪者，然后向裂石堡的库加托克复命。‡殺死10個扭曲巡者並回到碎石堡向庫爾卡拓克回報。',
  }
},
[10028] = {
  {
    'Recipientes de poder‡Сосуды силы‡Gefäße der Macht‡마력이 담긴 용기‡Vasijas de poder‡Vasijas de poder‡Calices de puissance‡强大的容器‡能量容器',
    nil,
    'Traga 8 Recipientes Draeneis para Ros\'eleth, na Fortaleza Alleriana.‡Принесите 8 сосудов дренеев Роз\'алете в бастион Аллерии.‡Bringt 8 Draeneigefäße zu Ros\'eleth in Allerias Feste.‡알레리아 성채에 있는 로스엘레스에게 드레나이 용기 8개를 가져가야 합니다.‡Lleva 8 vasijas draenei a Ros\'eleth en el Bastión Allerian.‡Lleva 8 vasijas draenei a Ros\'eleth en el Bastión Allerian.‡Apportez 8 Calices draeneï à Ros\'eleth au Bastion allérien.‡为奥蕾莉亚要塞的洛瑟蕾丝带回8个德莱尼容器。‡將8個德萊尼容器交給艾蘭里堡壘的羅斯勒斯。',
  }
},
[10029] = {
  {
    'The Spirits Are Calling‡Зов духов‡Die Geister rufen‡영혼의 부름‡Los espíritus llaman‡Los espíritus llaman‡L\'appel des esprits‡DEPRECATED‡亡靈在召喚',
    nil,
    'Anchorite Lyteera wants you to locate her assistant, Soolaveen at the Refugee Caravan in the Bone Wastes of Terokkar Forest.|n|nCompleting quests for the Aldor will cause your Scryers reputation level to decrease.‡Найдите помощника анахоретки Литиры по имени Сулавин в караване беженцев на Костяных пустошах в лесу Тероккар.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Lyteera möchte, dass Ihr ihren Gehilfen Soolaveen bei der Flüchtlingskarawane in der Knochenwüste der Wälder von Terokkar findet.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡수도사 리티라가 테로카르 숲의 해골 무덤에 있는 피난민 행렬에서 자신의 조수인 술라빈을 찾아달라고 부탁했습니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La anacoreta Lyteera quiere que encuentres a su asistente, Soolaveen, en la Caravana de Refugiados de El Vertedero de Huesos en el Bosque de Terokkar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.|n‡La anacoreta Lyteera quiere que encuentres a su asistente, Soolaveen, en la Caravana de Refugiados de El Vertedero de Huesos en el Bosque de Terokkar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.|n‡L\'anachorète Lyteera veut que vous trouviez son assistant, Soolaveen, à la Caravane des réfugiés dans le désert des Ossements de la forêt de Terokkar.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡Anchorite Lyteera想你找到她的助手，泰罗卡森林中白骨荒野Refugee Caravan的Soolaveen。|n|n完成奥尔多所有的任务会降低你的Scryers声望。‡隱士麗蒂娜要你去泰洛卡森林的白骨荒野，在難民商隊找到她的助理，索拉伏恩。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10030] = {
  {
    'Recuperar os ossos‡Сбор останков‡Die Knochen zurückholen‡유골 되찾기‡Recuperar los huesos‡Recuperar los huesos‡La récupération des os‡收集骸骨‡取回白骨',
    nil,
    'Colete 10 Ossos Inquietos. Entregue-os para Ramdor, o Louco, do lado oeste do Círculo da Obediência, em Auchindoun. Auchindoun se encontra no meio do Deserto de Ossos, na Mata Terokkar.‡Соберите 10 неупокоенных костей и отнесите их Рамдору Безумному на западную сторону Ритуального круга в Аукиндоне. Аукиндон находится в центре Костяных пустошей в лесу Тероккар.‡Sammelt 10 ruhelose Knochen und bringt sie zu Ramdor dem Wahnsinnigen bei der westlichen Seite des Rings der Beobachtung in Auchindoun, das sich in der Mitte der Knochenwüste in den Wäldern von Terokkar befindet.‡안식을 찾지 못한 유골 10개를 모아서 아킨둔의 규율의 광장 서쪽 측면에 있는 광기의 람도르에게 가져가야 합니다. 아킨둔은 테로카르 숲의 해골 무덤 가운데에 있습니다.‡Consigue 10 huesos sin sosiego y llévaselos a Ramdor el Loco, del lado oeste del Círculo de la Observancia de Auchindoun, en medio de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Consigue 10 huesos sin sosiego y llévaselos a Ramdor el Loco, del lado oeste del Círculo de la Observancia de Auchindoun, en medio de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Récupérez 10 Ossements sans repos. Apportez-les à Ramdor le Fol, juste à côté du côté ouest du Cercle d\'observance à Auchindoun, qui se trouve au milieu du désert des Ossements de la forêt de Terokkar.‡收集10根无眠之骨，并将它们交给奥金顿仪式广场西侧的疯狂的拉姆杜尔，奥金顿就在泰罗卡森林白骨荒野的中心。‡收集10根無法安息的白骨。交給奧齊頓儀式競技場西邊的瘋狂的藍姆多，位在泰洛卡森林的白骨荒野中間。',
  }
},
[10031] = {
  {
    'Ajudar os perdidos a achar o caminho‡Возвращение заблудших душ‡Den Verirrten den Weg zeigen‡길잃은 망령 인도‡Ayudar a Los Perdidos a encontrar su camino‡Ayudar a Los Perdidos a encontrar su camino‡Aider les Perdus à trouver leur chemin‡迷失者的解脱‡幫迷失者找到方向',
    nil,
    'Destrua 10 Espíritos Perdidos e 10 Esqueletos Quebrados. A seguir, fale com Sulavin, na Caravana dos Refugiados no Deserto de Ossos, que fica na Mata Terokkar.‡Уничтожьте 10 заблудших духов и 10 скелетов Сломленных, после чего поговорите с Сулавином в караване беженцев в Костяных пустошах леса Тероккар.‡Tötet 10 verirrte Geister und 10 Skelette eines Zerschlagenen und kehrt dann zu Anachoret Soolaveen bei der Flüchtlingskarawane in der Knochenwüste in den Wäldern von Terokkar zurück.‡길잃은 망령, 뒤틀린 드레나이 해골을 10마리씩 처치한 후 테로카르 숲, 해골 무덤의 피난민 행렬에 있는 술라빈과 대화해야 합니다.‡Acaba con 10 espíritus perdidos y 10 esqueletos partidos y ve a ver a Soolaveen en la Caravana de Refugiados de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Acaba con 10 espíritus perdidos y 10 esqueletos partidos y ve a ver a Soolaveen en la Caravana de Refugiados de El Vertedero de Huesos, en el Bosque de Terokkar.|n‡Détruisez 10 Esprits perdus et 10 Squelettes roués, puis parlez à Soolaveen à la Caravane de réfugiés, dans le désert des Ossements de la forêt de Terokkar.‡消灭10个失落的幽魂和10只破碎的骷髅，然后向泰罗卡森林白骨荒野难民车队的苏拉文复命。‡殺死10個迷失的靈魂和10個德萊尼骷髏，然後跟難民商隊的索拉伏恩談話，位在泰洛卡森林的白骨荒野。',
  }
},
[10032] = {
  {
    'Artefatos de Tuurem‡Артефакты из Туурема‡Artefakte von Tuurem‡투렘의 유물‡Artefactos de Tuurem‡Artefactos de Tuurem‡Artéfacts de Tuurem‡图雷姆的神器‡從杜瑞來的古器',
    nil,
    'Colete 6 Artefatos de Tuurem dos Catadores e Caçadores de Tuurem, e traga-os para Rakoria, na Vila de Quebrapedra.‡Заберите 6 артефактов у тууремских падальщиков и охотников и отнесите их Ракории в форт Камнеломов.‡Sammelt 6 Artefakte von Tuurem von den Strauchdieben von Tuurem und den Jägern von Tuurem und bringt sie zu Rakoria in der Steinbrecherfeste.‡투렘 청소부와 투렘 사냥꾼으로부터 투렘 유물 6개를 모아서 돌망치 요새에 있는 라코리아에게 가져가야 합니다.‡Consigue 6 artefactos Tuurem de los carroñeros Tuurem y los cazadores Tuurem y llévaselos a Rakoria en el Bastión Rompepedras.‡Consigue 6 artefactos Tuurem de los carroñeros Tuurem y los cazadores Tuurem y llévaselos a Rakoria en el Bastión Rompepedras.‡Récupérez 6 Artéfacts tuurem sur les Charognards tuurem et les Chasseurs tuurem et apportez-les à Rakoria au fort des Brise-pierres.‡从图雷姆清道夫和图雷姆猎人身上收集6个图雷姆神器，把它们交给裂石堡的拉克妮亚。‡從杜瑞拾荒者及杜瑞獵人身上收集6個杜瑞古器，交給碎石堡的瑞蔻莉雅。',
  }
},
[10033] = {
  {
    'Procura-se: açoita-ossos mortos!‡Награда за убитых костеклювов!‡Aufruf: Tötet die Knochenpeitscher!‡현상 수배: 해골채찍 독수리!‡Se busca: Atizahuesos ¡Muertos!‡Se busca: Atizahuesos ¡Muertos!‡On recherche : des Fouette-radius morts !‡通缉：白骨秃鹫！‡懸賞:鞭骨者的死亡!',
    nil,
    'Mate 20 Açoita-ossos. A seguir, apresente-se a Taela Perenanda na Fortaleza Alleriana, na Mata Terokkar.‡Убейте 20 костеклювов и вернитесь к Тэле Вечной Страннице в бастион Аллерии в лесу Тероккар.‡Tötet 20 Knochenpeitscher und meldet Euch dann bei Taela Immerlauf in Allerias Feste in den Wäldern von Terokkar.‡해골채찍 독수리 20마리를 처치한 후, 테로카르 숲의 알레리아 성채에 있는 타엘라 에버스트라이드에게 가져가야 합니다.‡Mata a 20 Atizahuesos y después preséntate ante Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Mata a 20 Atizahuesos y después preséntate ante Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Tuez 20 Fouette-radius puis retournez voir Taela Vassanfin au Bastion allérien dans la forêt de Terokkar.‡杀死20只白骨秃鹫，然后向泰罗卡森林内奥蕾莉亚要塞的泰拉·远途复命。‡殺了20隻鞭骨者後回報給泰洛卡森林裡艾蘭里堡壘的泰伊拉·艾薇斯崔德。',
  }
},
[10034] = {
  {
    'Procura-se: açoita-ossos mortos!‡Награда за убитых костеклювов!‡Aufruf: Tötet die Knochenpeitscher!‡현상 수배: 해골채찍 독수리 처치!‡Se busca: Atizahuesos ¡Muertos!‡Se busca: Atizahuesos ¡Muertos!‡On recherche : des Fouette-radius morts !‡通缉：白骨秃鹫！‡懸賞:鞭骨者的死亡!',
    nil,
    'Mate 20 Açoita-ossos. A seguir, apresente-se a Mawg Tiroatroz na Vila de Quebrapedra, que fica na Mata Terokkar.‡Убейте 20 костеклювов и вернитесь к Маугу Лютострелу в форт Камнеломов в лесу Тероккар.‡Tötet 20 Knochenpeitscher und meldet Euch dann bei Mawg Grimmschlag in der Steinbrecherfeste in den Wäldern von Terokkar.‡해골채찍 독수리 20마리를 처치한 후 테로카르 숲의 돌망치 요새에 있는 마우그 그림샷에게 가져가야 합니다.‡Mata a 20 Atizahuesos y, a continuación, ve a ver a Mawg Tirosiniestro en el Bastión Rompepedras, en el Bosque de Terokkar.‡Mata a 20 Atizahuesos y, a continuación, ve a ver a Mawg Tirosiniestro en el Bastión Rompepedras, en el Bosque de Terokkar.‡Tuez 20 Fouette-radius puis retournez voir Mawg Trait-sinistre au fort des Brise-pierres dans la forêt de Terokkar.‡杀死20只白骨秃鹫，然后向泰罗卡森林裂石堡的玛乌格·锐箭复命。‡殺了20隻鞭骨者後回報給泰洛卡森林裡碎石堡的矛克·邪擊。',
  }
},
[10035] = {
  {
    'Torgos!‡Торгос!‡Torgos!‡토르고스!‡¡Torgos!‡¡Torgos!‡Torgos !‡托古斯！‡托茍斯!',
    nil,
    'Atraia Torgos com a Carcaça de Trachela. Adquira uma Pena da Cauda de Torgos e entregue-a para Taela Perenanda na Fortaleza Alleriana, que fica na Mata Terokkar.‡Приманите Торгоса останками Трашелы, добудьте перо из его хвоста и отнесите его Тэле Вечной Страннице в бастион Аллерии в лесу Тероккар.‡Benutzt Trachelas Leichnam, um Torgos zu rufen. Besorgt eine Schwanzfeder von Torgos und kehrt dann zu Taela Immerlauf in Allerias Feste in den Wäldern von Terokkar zurück.‡트라첼라의 시체를 사용하여 토르고스를 내려오게 하여 토르고스의 꼬리 깃털 1개를 구한 후, 테로카르 숲의 알레리아 성채에 있는 타엘라 에버스트라이드에게 가져가야 합니다.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y llévasela a Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y llévasela a Taela Semprerguida en el Bastión Allerian, en el Bosque de Terokkar.‡Faites venir Torgos à l\'aide de la Carcasse de Trachela. Procurez-vous une Plume de la queue de Torgos et rapportez-la à Taela Vassanfin au Bastion allérien dans la forêt de Terokkar.‡利用特拉克拉的残骸引出托古斯，将托古斯交给泰罗卡森林奥蕾莉亚要塞的泰拉·远途。‡利用崔奇拉的屍體引誘托苟斯出現。取得一根托茍斯的尾羽然後交給泰洛卡森林的艾蘭里堡壘的泰伊拉·艾薇斯崔德。',
  }
},
[10036] = {
  {
    'Torgos!‡Торгос!‡Torgos!‡토르고스!‡¡Torgos!‡¡Torgos!‡Torgos !‡托古斯！‡托茍斯!',
    nil,
    'Atraia Torgos com a Carcaça de Trachela. Recolha uma Pena da Cauda de Torgos e entregue-a para Mawg Tiroatroz na Vila de Quebrapedra, que fica na Mata Terokkar.‡Приманите Торгоса останками Трашелы, добудьте перо из его хвоста и отнесите его Маугу Лютострелу в форт Камнеломов в лесу Тероккар.‡Benutzt Trachelas Leichnam, um Torgos zu rufen. Besorgt eine Schwanzfeder von Torgos und kehrt dann zu Mawg Grimmschlag in der Steinbrecherfeste in den Wäldern von Terokkar zurück.‡트라첼라의 시체를 이용해 토르고스를 불러내야 합니다. 토르고스의 꼬리 깃털 1개를 구해서 테로카르 숲의 돌망치 요새에 있는 마우그 그림샷에게 가져가야 합니다.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y vuelve a ver a Mawg Tirosiniestro en el Bastión Rompepedras del Bosque de Terokkar.‡Llama a Torgos con el cadáver de Trachela. Consigue una pluma de la cola de Torgos y vuelve a ver a Mawg Tirosiniestro en el Bastión Rompepedras del Bosque de Terokkar.‡Faites venir Torgos à l\'aide de la Carcasse de Trachela. Procurez-vous une Plume de la queue de Torgos et apportez-la à Mawg Trait-sinistre au fort des Brise-pierres dans la forêt de Terokkar.‡利用特拉克拉的残骸引出托古斯，将托古斯交给泰罗卡森林裂石堡的玛乌格·锐箭。‡利用崔奇拉的屍體引誘托苟斯出現。取得一根托苟斯的尾羽然後回到泰洛卡森林的碎石堡找矛克·邪擊。',
  }
},
[10037] = {
  {
    'Prefiro pescar‡Без рыбалки‡Ich würd\' lieber angeln‡낚시나 해볼까요?‡Mejor pescando‡Mejor pescando‡J\'préférerais aller à la pêche‡宁可去钓鱼‡當然是釣魚',
    nil,
    'Traga 8 Enguias Brilhescama Imaculadas para Seth na cidade de Shattrath.‡Принесите 8 тушек блестящих угрей Сету в Шаттрат.‡Bringt 8 makellose Schimmerschuppenaale zu Seth in Shattrath.‡샤트라스에 있는 세스에게 온전한 은비늘 뱀장어 8마리를 가져가야 합니다.‡Lleva 8 anguilas brilloescama prístinas a Seth a Shattrath.‡Lleva 8 anguilas Brilloescama prístinas a Seth a Shattrath.‡Apportez 8 Anguilles Scintécaille en parfait état à Seth à Shattrath.‡为沙塔斯城的塞瑟带回8条新鲜的亮鳞电鳗。‡將8隻新鮮閃鱗鰻交給撒塔斯城的塞斯。',
  }
},
[10038] = {
  {
    'Fale com o recruta Semanas‡Разговор с рядовым Виксом‡Sprecht mit Gefreiter Wöch‡병사 윅스와의 대화‡Habla con el soldado Semanas‡Habla con el soldado Semanas‡Parler au soldat Weeks‡援助列兵维克斯‡與士兵維克斯談話',
    nil,
    'Fale com o Recruta Semanas. Você pode encontrá-lo perto da entrada norte da Aldeia Grangol\'var, na Mata Terokkar.‡Найдите рядового Викса возле северного входа в деревню Грангол\'вар в лесу Тероккар и поговорите с ним.‡Sprecht mit Gefreiter Wöch in der Nähe des nördlichen Eingangs von Grangol\'var in den Wäldern von Terokkar.‡테로카르 숲의 그란골바르 마을의 북쪽 입구 근처에 있는 병사 윅스를 찾아서 대화해야 합니다.‡Habla con el soldado Semanas cerca de la entrada norte del Poblado Grangol\'var en el Bosque de Terokkar.‡Habla con el soldado Semanas cerca de la entrada norte del Poblado Grangol\'var en el Bosque de Terokkar.‡Parlez au Soldat Weeks près de l\'entrée nord de Grangol\'var, dans la forêt de Terokkar.‡与泰罗卡森林格兰戈瓦村北方入口附近的列兵维克斯谈一谈。‡在泰洛卡森林的葛蘭戈瓦村北方入口處找到士兵維克斯並與他談話。',
  }
},
[10039] = {
  {
    'Fale com a batedora Neftis‡Разговор с разведчицей Нефтис‡Sprecht mit Späherin Neftis‡정찰병 네프티스와 대화‡Habla con la exploradora Neftis‡Habla con la exploradora Neftis‡Parler à l\'éclaireur Neftis‡援助斥候奈弗蒂丝‡與斥候奈夫提斯談話',
    nil,
    'Fale com a Batedora Neftis perto da entrada sul da Aldeia Grangol\'var, na Mata Terokkar.‡Найдите разведчицу Нефтис возле южного входа в деревню Грангол\'вар в лесу Тероккар и поговорите с ней.‡Sprecht mit Späherin Neftis in der Nähe des südlichen Eingangs von Grangol\'var in den Wäldern von Terokkar.‡테로카르 숲의 그란골바르 마을의 남쪽 입구 근처에 있는 정찰병 네프티스를 찾아서 대화해야 합니다.‡Habla con la exploradora Neftis cerca de la entrada sur del Poblado Grangol\'var en el Bosque de Terokkar.‡Habla con la exploradora Neftis cerca de la entrada sur del Poblado Grangol\'var en el Bosque de Terokkar.‡Parlez à l\'éclaireur Neftis près de l\'entrée sud de Grangol\'var, dans la forêt de Terokkar.‡与泰罗卡森林格兰戈瓦村南方入口附近的斥候奈弗蒂丝谈一谈。‡在泰洛卡森林的葛蘭戈瓦村南方入口處找到斥候奈夫提斯並與她談談。',
  }
},
[10040] = {
  {
    'Quem são eles?‡Кто они?‡Wer sind sie?‡그들의 정체‡¿Quiénes son?‡¿Quiénes son?‡Qui sont-ils ?‡他们是谁？‡他們是誰?',
    nil,
    'Usando o disfarce, fale com o Iniciado Sombrio, o Operário Sombrio e o Conselheiro Sombrio. A seguir, fale novamente com o Recruta Semanas na Aldeia Grangol\'var, que fica na Mata Terokkar.‡Замаскируйтесь и поговорите с мрачным посвященным, мрачным работником и мрачным советником, после чего вернитесь к рядовому Виксу у деревни Грангол\'вар в лесу Тероккар.‡Sprecht mit dem schattenhaften Initianden, dem schattenhaften Hilfsarbeiter und dem schattenhaften Berater. Kehrt dann zu Gefreiter Wöch in Grangol\'var in den Wäldern von Terokkar zurück.‡변장을 한 동안 어둠의 수습생, 어둠의 인부, 어둠의 조언자와 대화한 후, 테로카르 숲의 그란골바르 마을에 있는 병사 윅스에게 돌아가야 합니다.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver al soldado Semanas en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver al soldado Semanas en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Parlez avec l\'Initié ténébreux, le Travailleur ténébreux et le Conseiller ténébreux en portant le déguisement. Puis retournez voir le soldat Weeks à Grangol\'var dans la forêt de Terokkar.‡在伪装状态下，与阴暗新兵、阴暗劳工和阴暗顾问交谈，然后向泰罗卡森林格兰戈瓦村的列兵维克斯复命。‡於偽裝中與幽暗的新兵，幽暗的苦力及幽暗的諫言者說話。完成後回到泰洛卡森林的葛蘭戈瓦村中找士兵維克斯回報。',
  }
},
[10041] = {
  {
    'Quem são eles?‡Кто они?‡Wer sind sie?‡그들의 정체‡¿Quiénes son?‡¿Quiénes son?‡Qui sont-ils ?‡他们是谁？‡他們是誰?',
    nil,
    'Usando o disfarce, fale com o Iniciado Sombrio, o Operário Sombrio e o Conselheiro Sombrio. A seguir, fale novamente com a Batedora Neftis na Aldeia Grangol\'var, que fica na Mata Terokkar.‡Замаскируйтесь и поговорите с Мрачным посвященным, Мрачным работником и Мрачным советником, после чего вернитесь к разведчице Нефтис в деревню Грангол\'вар в лесу Тероккар.‡Sprecht mit dem schattenhaften Initianden, dem schattenhaften Hilfsarbeiter und dem schattenhaften Berater. Kehrt dann zu Späherin Neftis in Grangol\'var in den Wäldern von Terokkar zurück.‡변장을 하고서 어둠의 수습생, 어둠의 인부, 어둠의 조언자와 대화하십시오. 그런 다음 테로카르 숲의 그란골바르 마을에 있는 정찰병 네프티스에게 돌아가십시오.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver a la exploradora Neftis en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Cuando tengas el disfraz puesto, habla con el iniciado oscuro, el obrero oscuro y el consejero oscuro. Después ve a ver a la exploradora Neftis en el Poblado Grangol\'var, en el Bosque de Terokkar.‡Parlez avec l\'Initié ténébreux, le Travailleur ténébreux et le Conseiller ténébreux en portant le déguisement. Puis retournez voir l\'éclaireur Neftis à Grangol\'var dans la forêt de Terokkar.‡在伪装状态下，与阴暗新兵、阴暗劳工和阴暗顾问交谈，然后向泰罗卡森林格兰戈瓦村的斥候奈弗蒂丝复命。‡於偽裝中與幽暗的新兵，幽暗的苦力及幽暗的諫言者說話。完成後回到泰洛卡森林的葛蘭戈瓦村中找斥候奈夫提斯回報。',
  }
},
[10042] = {
  {
    'Morte ao Concílio das Sombras!‡Убить Совет Теней!‡Tötet den Schattenrat!‡어둠의 의회 제거!‡¡Acaba con el Consejo de la Sombra!‡¡Acaba con el Consejo de la Sombra!‡Tuer le Conseil des ombres !‡暗影议会必须死！‡殺光暗影議會!',
    nil,
    'Mate 10 Executores Sombrios, 10 Evocadores Sombrios e o Mestre Sombrio Angústio. A seguir, fale novamente com o Tenente Martelobrita na Fortaleza Alleriana, que fica na Mata Terokkar.‡Убейте 10 мрачных палачей, 10 мрачных призывателей и повелителя теней Скорбного, после чего вернитесь к лейтенанту Булыжному Молоту в бастион Аллерии в лесу Тероккар.‡Tötet 10 schattenhafte Henker, 10 schattenhafte Beschwörer und Schattenmeister Gram und kehrt dann zu Leutnant Kieshammer in Allerias Feste in den Wäldern von Terokkar zurück.‡어둠의 집행자 10명, 어둠의 소환사 10명과 어둠의 주인 그리브를 처치한 후, 테로카르 숲의 알레리아 성채에 있는 부관 그래블해머에게 보고해야 합니다.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante el teniente Gravamartillo en el Bastión Allerian, en el Bosque de Terokkar.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante el teniente Gravamartillo en el Bastión Allerian, en el Bosque de Terokkar.‡Tuez 10 Exécuteurs ténébreux, 10 Invocateurs ténébreux et le Maître d\'ombre Dolent, puis retournez auprès du lieutenant Gravillemartel au Bastion allérien dans la forêt de Terokkar.‡杀死10个阴暗刽子手、10个阴暗召唤者和暗影主宰格里弗，然后向泰罗卡森林奥蕾莉亚要塞的加维·砂锤中尉复命。‡殺掉10個幽暗的劊子手，10個幽暗的召喚者及暗影大師葛瑞弗，然後回到泰洛卡森林的艾蘭里堡壘與葛拉伏汗中尉回報。',
  }
},
[10043] = {
  {
    'Morte ao Concílio das Sombras!‡Убить Совет Теней!‡Tötet den Schattenrat!‡어둠의 의회 제거!‡¡Acaba con el Consejo de la Sombra!‡¡Acaba con el Consejo de la Sombra!‡Tuer le Conseil des ombres !‡暗影议会必须死！‡殺光暗影議會!',
    nil,
    'Mate 10 Executores Sombrios, 10 Evocadores Sombrios e o Mestre Sombrio Angústio. A seguir, fale novamente com a Conselheira Faila na Vila de Quebrapedra, que fica na Mata Terokkar.‡Убейте 10 мрачных палачей, 10 мрачных призывателей и повелителя теней Скорбного, после чего вернитесь к советнице Файле в форт Камнеломов в лесу Тероккар.‡Tötet 10 schattenhafte Henker, 10 schattenhafte Beschwörer und Schattenmeister Gram und kehrt dann zu Beraterin Faila in der Steinbrecherfeste in den Wäldern von Terokkar zurück.‡어둠의 집행자 10명, 어둠의 소환사 10명과 어둠의 주인 그리브를 해치운 후 테로카르 숲의 돌망치 요새에 있는 조언자 파일라에게 보고하십시오.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante la consejera Faila en el Bastión Rompepedras, en el Bosque de Terokkar.‡Mata a 10 verdugos oscuros, a 10 invocadores oscuros y al maestro de las Sombras Pena. A continuación, preséntate ante la consejera Faila en el Bastión Rompepedras, en el Bosque de Terokkar.‡Tuez 10 Exécuteurs ténébreux, 10 Invocateurs ténébreux et le Maître d\'ombre Dolent, puis retournez auprès de la conseillère Faila au fort des Brise-pierres dans la forêt de Terokkar.‡杀死10个阴暗刽子手、10个阴暗召唤者和暗影主宰格里弗，然后向泰罗卡森林裂石堡的顾问菲埃拉复命。‡殺掉10個幽暗的劊子手，10個幽暗的召喚者及暗影大師葛瑞弗，然後回到泰洛卡森林的碎石堡回報諫言者菲拉。',
  }
},
[10044] = {
  {
    'Visita à Grande Mãe‡Разговор с Великой матерью‡Ein Besuch bei der Großmutter‡대모 방문‡Una visita a la Abuela‡Una visita a la Abuela‡Une visite à la grande-mère‡拜访盖亚安祖母‡與主母的會面',
    nil,
    'Fale com a Grande Mãe Geyah e escute o que ela tem a dizer.‡Поговорите с Великой Матерью Гейей и сделайте все, о чем она вас попросит.‡Sprecht mit Großmutter Geyah und hört Euch an, was sie zu sagen hat.‡대모 게야를 만나서 그녀가 하는 말을 잘 들어야 합니다.‡Habla con la Abuela Geyah y escucha lo que tiene que decirte.|n‡Habla con la Abuela Geyah y escucha lo que tiene que decirte.|n‡Parlez à la grande-mère Geyah et écoutez ce qu\'elle a à vous dire.‡与盖亚安祖母谈谈，听她讲述故事。‡與主母吉雅談談，並聆聽她跟你說的內容。',
  }
},
[10045] = {
  {
    'Componentes materiais‡Компоненты зелья‡Zutaten sammeln‡물약 재료‡Componentes materiales‡Componentes materiales‡Composants matériels‡必需的材料‡材料成分',
    nil,
    'A Grande Mãe Geyah, de Garadar, em Nagrand, pediu para você coletar 1 Raiz de Olemba, 1 Fruta-do-pântano, 1 Fronde de Telaari e 1 Espinodrago.‡Принесите великой матери Гейе в Гарадар 1 корень олембы, 1 кустик клюквы, 1 телаарский папоротник и 1 побег драконьего шипа.‡Großmutter Geyah in Garadar in Nagrand möchte, dass Ihr 1 Olembawurzel, 1 Marschenbeere, 1 Telaarifarn und 1 Drachenwirbel sammelt.‡나그란드의 가라다르에 있는 대모 게야가 올렘바 뿌리, 늪딸기, 텔라아리 잎사귀, 용가리통풀을 1개씩 모아달라고 부탁했습니다.‡La Abuela Geyah en Garadar, en Nagrand, te ha pedido 1 raíz de olemba, 1 baya de la marisma, 1 fronda de Telaari y 1 espinazo de dragón.|n‡La Abuela Geyah en Garadar, en Nagrand, te ha pedido 1 raíz de olemba, 1 baya de la marisma, 1 fronda de Telaari y 1 espinazo de dragón.|n‡La grande-mère Geyah de Garadar en Nagrand vous a demandé de cueillir 1 Racine d\'Olemba, 1 Canneberge, 1 Palme telaari et 1 Épine-de-dragon.‡纳格兰加拉达尔的盖亚安祖母要你收集1根奥雷巴根须、1颗沼泽莓、1片塔拉蕨和1株龙脊草。‡納葛蘭的卡拉達爾的主母吉雅要你收集1個奧萊姆貝根莖，1個沼澤梅，1個泰拉蕊藻葉及1個龍脊。',
  }
},
[10046] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡어둠의 문을 넘어‡A través de El Portal Oscuro‡A través de El Portal Oscuro‡À travers la Porte des ténèbres‡跨越黑暗之门‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e fale com Nazgrel em Thrallmar.‡Пройдите через Темный портал и поговорите с Назгрелом в Траллмаре.‡Reist durch das Dunkle Portal und sprecht mit Nazgrel in Thrallmar.‡어둠의 문으로 들어가서 스랄마에 있는 나즈그렐과 대화하십시오.‡Viaja a través de El Portal Oscuro y habla con Nazgrel en Thrallmar.‡Viaja a través de El Portal Oscuro y habla con Nazgrel en Thrallmar.‡Traversez la Porte des ténèbres et parlez à Nazgrel à Thrallmar.‡跨越黑暗之门，跟萨尔玛的纳兹格雷尔谈一谈。‡通過黑暗之門，與索爾瑪的納茲格雷爾談談。',
  }
},
[10047] = {
  {
    'O Caminho da Glória‡Путь Славы‡Der Pfad des Ruhms‡영광의 길‡El Camino a la Gloria‡El Camino a la Gloria‡Le sentier de la Gloire‡荣耀之路‡光榮之路',
    nil,
    'Purifique 8 Esqueletos Pisoteados no Caminho da Glória com a Água Benta Draeneica, e então apresente-se ao Áugure Dimensional Kryv na Fortaleza da Honra.‡Окропите 8 истоптанных скелетов, лежащих на Пути Славы, святой водой дренеев, после чего возвращайтесь в Оплот Чести к провидцу бед Криву.‡Reinigt 8 zertrampelte Skelette auf dem Pfad des Ruhms mit dem Weihwasser der Draenei und kehrt dann zu Warpseher Kryv in der Ehrenfeste zurück.‡드레나이 성수로 영광의 길에 있는 짓이겨진 해골 8마리를 정화하고 명예의 요새에 있는 차원의 점술가 크리브에게 돌아가야 합니다.‡Purifica a 8 esqueletos pisoteados en El Camino a la Gloria con agua sagrada draenei y vuelve a ver al arúspice de distorsión Kryv en el Bastión del Honor.‡Purifica a 8 esqueletos pisoteados en El Camino a la Gloria con agua sagrada draenei y vuelve a ver al arúspice de distorsión Kryv en el Bastión del Honor.‡Purifiez 8 Squelettes piétinés sur le Sentier de la Gloire avec de l\'Eau bénite draeneï, puis retournez voir le Scrute-dimensions Kryv au bastion de l\'Honneur.‡在荣耀之路上使用德莱尼圣水净化8个被践踏的骷髅，然后返回荣耀堡向位面占卜者克雷夫复命。‡在光榮之路上使用德萊尼聖水清洗8個被踐踏的骨骸，完成後回到榮譽堡找星移占卜師克里。',
  }
},
[10048] = {
  {
    '‡Магическая пыль‡Eine Handvoll Magiestaub‡‡Un puñado de polvo mágico‡Un puñado de polvo mágico‡Une poignée de poussière magique‡魔法粉尘‡',
    nil,
    '‡Принесите 7 горстей пыли Умиротворения Андарлу в Бастион Аллерии.‡Sammelt 7 Handvoll besänftigender Staub für Andarl in Allerias Feste.‡‡Reúne 7 puñados de polvo pacificador para Andarl en el Bastión Allerian.‡Reúne 7 puñados de polvo pacificador para Andarl en el Bastión Allerian.‡Récoltez 7 poignées de Poudre pacifiante pour Andarl au Bastion allérien.‡‡',
  }
},
[10049] = {
  {
    '‡Магическая пыль‡Eine Handvoll Magiestaub‡‡Un puñado de polvo mágico‡Un puñado de polvo mágico‡Une poignée de poussière magique‡魔法粉尘‡',
    nil,
    '‡Принесите 7 горстей пыли Умиротворения Каргатоку в Форт Камнеломов.‡Sammelt 7 Handvoll besänftigenden Staubs für Kurgatok in der Steinbrecherfeste.‡‡Reúne 7 puñados de polvo pacificador para Kurgatok en el Bastión Rompepedras.‡Reúne 7 puñados de polvo pacificador para Kurgatok en el Bastión Rompepedras.‡Récoltez 7 poignées de Poudre pacifiante pour Kurgatok au fort des Brise-pierres.‡‡',
  }
},
[10050] = {
  {
    'Almas obstinadas‡Непреклонные духи‡Unerschütterliche Seelen‡영혼의 안식‡Almas Implacables‡Almas Implacables‡Âmes Inflexibles‡阴魂不散‡不屈的靈魂',
    nil,
    'O Guarda de Honra Wesilow quer que você derrote 12 Soldados Rasos Obstinados, 10 Feiticeiros Obstinados e 5 Cavaleiros Obstinados no Arsenal da Expedição, ao sul da sua posição atual.‡Убейте 12 непреклонных пехотинцев, 10 непреклонных колдунов и 5 непреклонных рыцарей в оружейной экспедиции на юге по просьбе отважного стража Весилоу.‡Ehrenwache Wesilow möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 10 unerschütterliche Zauberer und 5 unerschütterliche Ritter beim Expeditionsrüstlager tötet.‡명예의 경비병 웨실로우가 남쪽에 있는 원정대 무기고에서 불굴의 보병 12명, 불굴의 마술사 10명, 불굴의 기사 5명을 처치해 달라고 부탁했습니다.‡El guardia de honor Wesilow quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición del sur.‡El guardia de honor Wesilow quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición del sur.‡Le garde d\'honneur Wesilow veut que vous vainquiez 12 Fantassins inflexibles, 10 Ensorceleurs inflexibles et 5 Chevaliers inflexibles à l\'Armurerie de l\'expédition, au sud.‡荣耀堡卫兵维斯洛要你前往南边的远征军物资库，杀死12个步兵的阴魂、10个巫师的阴魂和5个骑士的阴魂。‡榮譽守衛衛斯羅要你去南方的遠征隊軍械庫打敗12個不屈的步兵，10個不屈的魔巫士，和5個不屈的騎士。',
  }
},
[10051] = {
  {
    'Fuga do Pontal Asardente!‡Побег из лагеря Огнекрылых‡Ausbruch aus dem Posten der Feuerschwingen!‡불꽃날개 거점 탈출‡¡Huida del Alto Ala de Fuego!‡¡Huida del Alto Ala de Fuego!‡L\'évasion de la halte Aile-de-feu‡逃离火翼岗哨！‡逃出火翼崗哨!',
    nil,
    'Escolte Isla Cristelar na fuga do Pontal Asardente. A seguir, apresente-se ao Capitão Auric Buscassol na Fortaleza Alleriana, que fica na Mata Terokkar.‡Проводите Ислу Звездную Гриву в безопасное место, после чего расскажите об этом капитану Аурику Ловчему Солнца в бастионе Аллерии в лесу Тероккар.‡Geleitet Isla Sternenmähne in Sicherheit und meldet Euch dann bei Hauptmann Auric Sonnenjäger in Allerias Feste in den Wäldern von Terokkar.‡이슬라 스타메인을 안전한 곳까지 호위한 후 테로카르 숲의 알레리아 성채에 있는 대장 아우릭 선체이서에게 보고해야 합니다.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver al capitán Auric Cazasol en el Bastión Allerian en el Bosque de Terokkar.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver al capitán Auric Cazasol en el Bastión Allerian en el Bosque de Terokkar.‡Escortez Isla Tressétoile jusqu\'à un lieu sûr puis faites votre rapport au capitaine Auric Courresoleil au Bastion allérien dans la forêt de Terokkar.‡护送伊斯拉·星鬃逃离火翼岗哨，然后向泰罗卡森林奥蕾莉亚要塞的乌瑞克·猎日者上尉复命。‡護送伊斯拉·星鬃到安全的地方後回報泰洛卡森林裡艾蘭里堡壘的阿瑞克·追日者上尉。',
  }
},
[10052] = {
  {
    'Fuga do Pontal Asardente!‡Побег из лагеря Огнекрылых‡Ausbruch aus dem Posten der Feuerschwingen!‡불꽃날개 거점 탈출‡¡Huida del Alto Ala de Fuego!‡¡Huida del Alto Ala de Fuego!‡L\'évasion de la halte Aile-de-feu‡逃离火翼岗哨！‡逃出火翼崗哨!',
    nil,
    'Escolte Isla Cristelar na fuga do Pontal Asardente e, a seguir, apresente-se à Conselheira Faila na Vila de Quebrapedra, que fica na Mata Terokkar.‡Проводите Ислу Звездную Гриву в безопасное место, после чего расскажите об этом советнице Файле в форте Камнеломов в лесу Тероккар.‡Geleitet Isla Sternenmähne in Sicherheit und meldet Euch dann bei Beraterin Faila in der Steinbrecherfeste in den Wäldern von Terkkokar.‡이슬라 스타메인을 안전한 곳까지 호위한 후 테로카르 숲의 돌망치 요새에 있는 조언자 파일라에게 보고하십시오.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver a la consejera Faila en el Bastión Rompepedras en el Bosque de Terokkar.‡Escolta a Isla Peloestrella hasta un lugar seguro y ve a ver a la consejera Faila en el Bastión Rompepedras en el Bosque de Terokkar.‡Escortez Isla Tressétoile jusqu\'à un lieu sûr puis faites votre rapport à la conseillère Faila au fort des Brise-pierres dans la forêt de Terokkar.‡护送伊斯拉·星鬃逃离火翼岗哨，然后向泰罗卡森林裂石堡的顾问菲埃拉复命。‡護送伊斯拉星鬃到安全的地方後回報泰洛卡森林裡碎石堡的諫言者菲拉。',
  }
},
[10053] = {
  {
    '‡Расправиться с Зет\'Гором‡Zeth\'Gor bewältigen‡‡A por Zeth\'Gor‡A por Zeth\'Gor‡S\'occuper de Zeth\'Gor‡进攻塞斯高‡',
    nil,
    '‡Убейте Гриллока Пустого Глаза, обыщите его логово и найдите планы атаки Кровавой Глазницы.‡Tötet Grillok "Finsterauge" und durchsucht seinen Unterschlupf nach den Angriffsplänen des Blutenden Auges.‡‡Derrota a Grillok "Ojosombra" e inspecciona su guarida en busca de los planes de ataque de los Foso de Sangre.‡Derrota a Grillok "Ojosombra" e inspecciona su guarida en busca de los planes de ataque de los Foso de Sangre.‡Tuez Grillok « Sombroeil » et fouillez son repaire à la recherche des Plans d\'attaque de l\'Orbite-sanglante.‡‡',
  }
},
[10054] = {
  {
    '‡Надвигающийся рок‡Drohende Verdammnis‡‡Fatalidad inminente‡Fatalidad inminente‡Désastre imminent‡迫近的厄运‡',
    nil,
    '‡Убейте 15 рубак, 10 некролитов, 5 батраков из клана Кровавой Глазницы и полководца Морка. О выполнении задания доложите лейтенанту Амади, которая находится в западной башне Оплота Чести.‡Tötet 15 Grunzer des Blutenden Auges, 10 Nekrolyten des Blutenden Auges, 5 Peons des Blutenden Auges und Kriegsherr Morkh. Meldet Euch danach bei Leutnant Amadi im westlichen Turm der Ehrenfeste.‡‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh, después informa a la teniente Amadi en la torre oeste del Bastión del Honor.‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh, después informa a la teniente Amadi en la torre oeste del Bastión del Honor.‡Tuez 15 Grunts de l\'Orbite-sanglante, 10 Nécrolytes de l\'Orbite-sanglante, 5 Péons de l\'Orbite-sanglante et le seigneur de guerre Morkh, puis faites votre rapport au lieutenant Amadi dans la tour ouest du bastion de l\'Honneur.‡‡',
  }
},
[10055] = {
  {
    'Sabendo usar, não vai faltar‡Ничто не пропадет даром‡Nichts verkommen lassen!‡재활용‡No desperdicies si puedes evitarlo‡No desperdicies si puedes evitarlo‡Faut pas gâcher‡回收材料‡不浪費，就不缺乏',
    nil,
    'Leve 8 pedaços de Metal Recuperado e 8 pedaços de Madeira Recuperada para Rumberto na Fortaleza da Honra.‡Принесите 8 кусков металлолома и 8 кусков древесины Болтую в Оплот Чести.‡Bringt 8 Stück gebrauchtes Metall und 8 Stück gebrauchtes Holz zu Dumphry in der Ehrenfeste.‡명예의 요새에 있는 덤프리에게 재활용 금속, 재활용 목재를 각각 8개씩 가져가야 합니다.‡Lleva 8 piezas de metal rescatado y 8 piezas de madera rescatada a Dumphry en el Bastión del Honor.‡Lleva 8 piezas de metal rescatado y 8 piezas de madera rescatada a Dumphry en el Bastión del Honor.‡Apportez 8 morceaux de Métal récupéré et 8 morceaux de Bois récupéré à Dumphry au bastion de l\'Honneur.‡给荣耀堡的达姆菲带去8块回收的金属和8块回收的木材。‡將8塊可利用的鐵及8塊可利用的木頭交給榮譽堡的戴夫利。',
  }
},
[10056] = {
  {
    '‡Припасы Кровавой Глазницы‡Vorräte des Blutenden Auges‡피눈물 보급품‡Suministros Foso Sangrante‡Suministros Foso Sangrante‡Les fournitures de l\'Orbite-sanglante‡血环补给品‡血之谷補給品',
    nil,
    '‡Уничтожьте 6 складов припасов Кровавой Глазницы. О выполнении задания доложите лейтенанту Амади из Оплота Чести.‡Zerstört 6 Stapel Vorräte des Blutenden Auges und meldet Euch dann bei Leutnant Amadi in der Ehrenfeste zurück.‡‡Acaba con 6 pilas de suministros de Pozo Sangrante e informa a la teniente Amadi en el Bastión del Honor.‡Acaba con 6 pilas de suministros de Pozo Sangrante e informa a la teniente Amadi en el Bastión del Honor.‡Détruisez 6 piles de Fournitures de l\'Orbite-sanglante et faites votre rapport au lieutenant Amadi au bastion de l\'Honneur.‡‡',
  }
},
[10057] = {
  {
    'Espíritos de liderança‡Солдатская верность‡Suche nach den Anführern‡장교들의 영혼‡El liderazgo en el punto de mira‡El liderazgo en el punto de mira‡Se tourner vers les chefs‡寻找首领‡與領導者同在',
    nil,
    'Derrote os fantasmas do Arquimago Xintor e do Tenente-comandante Talvos, e fale novamente com o Guarda de Honra Wesilow na torre noroeste da Fortaleza da Honra.‡Победите духов верховного мага Ксинтора и лейтенанта-командора Талвоса и возвращайтесь к отважному стражу Весилоу в северо-западную башню Оплота Чести.‡Besiegt die Geister von Erzmagier Xintor und Feldkommandant Thalvos und kehrt dann zu Ehrenwache Wesilow im Turm nordwestlich der Ehrenfeste zurück.‡대마법사 진토르와 부사령관 탈보스의 영혼을 처치한 후 명예의 요새의 북서쪽 탑에 있는 명예의 경비병 웨실로우에게 돌아가야 합니다.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y vuelve con el guardia de honor Wesilow, a la torre noroeste del Bastión del Honor.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y vuelve con el guardia de honor Wesilow, a la torre noroeste del Bastión del Honor.‡Triomphez des fantômes de l\'archimage Xintor et du lieutenant-commandant Thalvos, puis retournez voir le garde d\'honneur Wesilow à la tour au nord-ouest du bastion de l\'Honneur.‡击败大法师辛托尔和塔沃斯少校的鬼魂，然后向荣耀堡西北部哨塔的荣耀堡卫兵维斯洛复命。‡擊敗大法師辛托和少校薩沃斯的鬼魂後回到榮譽堡西北邊的塔中找榮譽守衛衛斯羅。',
  }
},
[10058] = {
  {
    'Um velho presente‡Старый дар‡Ein altes Geschenk‡오래된 선물‡Un viejo regalo‡Un viejo regalo‡Un cadeau ancien‡古老的礼物‡一份多年的禮物',
    nil,
    'Recupere o livro Mistérios da Luz e leve-o para o Padre Malgor Devídicos na Fortaleza da Honra.‡Верните "Таинства Света" отцу Малгору Девидикусу в Оплот Чести.‡Besorgt die Geheimnisse des Lichts und bringt das Buch zu Vater Malgor Devidicus in der Ehrenfeste zurück.‡\'빛의 신비\'를 되찾아서 명예의 요새에 있는 신부 말고르 데비디쿠스에게 가져가야 합니다.‡Recupera los Misterios de la Luz y llévaselos al padre Malgor Devidicus en el Bastión del Honor.‡Recupera los Misterios de la Luz y llévaselos al padre Malgor Devidicus en el Bastión del Honor.‡Récupérez les "Mystères de la Lumière" et rapportez-le au père Malgor Devidicus au bastion de l\'Honneur.‡将《圣光的秘密》交给荣耀堡的玛格尔·戴维迪库斯神父。‡取得光明的奧秘後回到榮譽堡交給神父摩葛·戴維迪克斯。',
  }
},
[10059] = {
  {
    '‡Расправиться с Зет\'Гором‡Zeth\'Gor bewältigen‡‡A por Zeth\'Gor‡A por Zeth\'Gor‡S\'occuper de Zeth\'Gor‡塞斯高的首领‡',
    nil,
    '‡Убейте Гриллока Пустого Глаза, обыщите его логово и найдите планы атаки Кровавой Глазницы.‡Tötet Grillok "Finsterauge" und durchsucht seinen Unterschlupf nach den Angriffsplänen des Blutenden Auges.‡‡Mata a Grillok "Ojosombra" y busca en su guarida los planes de ataque de los Foso Sangrante.‡Mata a Grillok "Ojosombra" y busca en su guarida los planes de ataque de los Foso Sangrante.‡Tuez Grillok « Sombroeil » et fouillez son repaire à la recherche des Plans d\'attaque de l\'Orbite-sanglante.‡‡',
  }
},
[10060] = {
  {
    '‡Надвигающийся рок‡Drohende Verdammnis‡‡Fatalidad inminente‡Fatalidad inminente‡Désastre imminent‡迫近的末日‡',
    nil,
    '‡Убейте 15 рубак, 10 некролитов, 5 батраков из клана Кровавой Глазницы и полководца Морка. О выполнении задания доложите каменному стражу Амбелану на Заставу Хребтолома.‡Tötet 15 Grunzer des Blutenden Auges, 10 Nekrolyten des Blutenden Auges, 5 Peons des Blutenden Auges und Kriegsherr Morkh. Meldet Euch danach bei Steingardist Ambelan im Rückenbrechergrat.‡‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh. A continuación, preséntate ante el guardia de piedra Ambelan en la Cresta Rompeloma.‡Mata a 15 brutos Foso Sangrante, a 10 necrólitos Foso Sangrante, a 5 peones Foso Sangrante y al señor de la guerra Morkh. A continuación, preséntate ante el guardia de piedra Ambelan en la Cresta Rompeloma.‡Tuez 15 Grunts de l\'Orbite-sanglante, 10 Nécrolytes de l\'Orbite-sanglante, 5 Péons de l\'Orbite sanglante et le seigneur de guerre Morkh. Puis faites votre rapport au garde de pierre Ambelan sur la crête Brise-épine.‡‡',
  }
},
[10061] = {
  {
    'O Obstinado‡Непреклонные‡Die Unerschütterlichen‡환영의 예언‡Los Implacables‡Los Implacables‡Les Inflexibles‡阴魂不散‡永不屈服',
    nil,
    'Grolag quer que você derrote 12 Soldados Rasos Obstinados, 10 Feiticeiros Obstinados e 5 Cavaleiros Obstinados no Arsenal da Expedição, ao sul da Fortaleza da Honra.‡Убейте 12 непреклонных пехотинцев, 10 непреклонных колдунов и 5 непреклонных рыцарей в оружейной экспедиции к югу от Оплота Чести по просьбе Грелага.‡Grelag möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 10 unerschütterliche Zauberhexer und 5 unerschütterliche Ritter am Expeditionsrüstlager südlich der Ehrenfeste tötet.‡그렐라그가 명예의 요새의 남쪽에 원정대 무기고에 있는 불굴의 보병 12명, 불굴의 마술사 10명, 불굴의 기사 5명에게 안식을 찾아달라고 부탁했습니다.‡Grelag quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición, al sur del Bastión del Honor.‡Grelag quiere que derrotes a 12 lacayos Implacables, a 10 hechiceros Implacables y a 5 caballeros Implacables en la Armería de Expedición, al sur del Bastión del Honor.‡Grelag veut que vous vainquiez 12 Fantassins inflexibles, 10 Ensorceleurs inflexibles et 5 Chevaliers inflexibles à l\'Armurerie de l\'expédition, au sud du bastion de l\'Honneur.‡葛雷拉格要你前往荣耀堡以南的远征军物资库，杀死12个步兵的阴魂、10个巫师的阴魂和5个骑士的阴魂。‡格萊克要你前往榮譽堡南方的遠征軍械庫打敗12個不屈的步兵，10個不屈的魔巫士，和5個不屈的騎士。',
  }
},
[10062] = {
  {
    '‡Солдатская верность‡Suche nach den Anführern‡장교들의 영혼‡El liderazgo en el punto de mira‡El liderazgo en el punto de mira‡Tourné vers le commandement‡寻找领袖‡',
    nil,
    '‡Победите духов верховного мага Ксинтора и лейтенанта-командора Талвоса и возвращайтесь к Грелагу на Заставу Хребтолома.‡Besiegt die Geister von Erzmagier Xintor und Feldkommandant Thalvos und kehrt dann zu Grelag im Rückenbrechergrat zurück.‡‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y regresa junto a Grelag en Cresta Rompeloma.‡Vence a los fantasmas del archimago Xintor y del teniente coronel Thalvos y regresa junto a Grelag en Cresta Rompeloma.‡Triomphez des fantômes de l\'archimage Xintor et du lieutenant-commandant Thalvos, puis retournez voir Grelag sur la Crête brise-échine.‡‡',
  }
},
[10063] = {
  {
    'Liga dos Exploradores: isso lá é coisa de gnomo?‡Лига исследователей: что здесь делают гномы?‡Forscherliga, für Gnome geeignet?‡탐험가 연맹 단원이 되기를 원하는 노움?‡Liga de Expedicionarios, ¿cosa de gnomos?‡Liga de Expedicionarios, ¿cosa de gnomos?‡La Ligue des explorateurs ? C\'est pas un truc de gnomes ?‡探险者协会要为侏儒服务吗？‡探險者協會，那是給地精的東西嗎?',
    nil,
    'Fale com Xote Cabeçote, que está acampado em um velho casco de tartaruga na costa a norte do Entreposto Rubro.‡Найдите Клоппера Бацбаха – он обосновался в старом черепашьем панцире на берегу к северу от Кровавой заставы.‡Zieht los und sucht nach Klopper Knacksklug, der sich in einem alten Schildkrötenpanzer an der Küste nördlich der Blutwacht eingerichtet hat.‡핏빛 감시초소의 북쪽 해안에 있는 오래된 거북껍질 속에서 야영 중인 클로퍼 위즈뱅을 찾아야 합니다.‡Encuentra a Clopper Zumbibang que está acampado en un viejo caparazón de tortuga en la costa al norte de la Avanzada de Sangre.‡Encuentra a Clopper Zumbibang que está acampado en un viejo caparazón de tortuga en la costa al norte de la Avanzada de Sangre.‡Trouvez Clopper Crackboum, qui campe dans une vieille carapace de tortue sur la côte au nord du Guet du sang.‡找到在秘血岗哨北海岸的龟壳里扎营的克劳伯·维兹班。‡在血色守望的北邊海岸上的破舊龜殼處尋找克羅波·維茲班。',
  }
},
[10064] = {
  {
    'Fala com a minha mão!‡Длань Аргуса‡Sprecht zu der Hand‡아르거스의 대리인과의 대화‡Habla con la Mano‡Habla con la Mano‡Parle à la main‡阿古斯之手‡與阿格斯之手談談',
    nil,
    'Apresente-se à Batedora Jorli no Recanto do Vindicante.‡Найдите в селении Привал Защитника разведчицу Джорли.‡Erstattet Späherin Jorli bei Verteidigers Ruh\' Bericht.‡구원자의 안식처에 있는 정찰병 요를리에게 보고해야 합니다.‡Preséntate a la exploradora Jorli en El Reposo del Vindicador.‡Preséntate a la exploradora Jorli en El Reposo del Vindicador.‡Présentez-vous à l\'éclaireur Jorli au Repos du redresseur de torts.‡向守备官营地的斥候约莉报告。‡向復仇者之陵的斥候喬爾力報到。',
  }
},
[10065] = {
  {
    'Limpa-trilhos‡Зеленая улица‡Eine Schneise schlagen‡퇴로 확보‡Abrirse paso‡Abrirse paso‡Ouvrir un chemin‡披荆斩棘‡清出一條路來',
    nil,
    'Mate 10 Assoladores Enfurecidos e fale novamente com a Batedora Jorli no Recanto do Vindicante.‡Убейте 10 разъяренных опустошителей и вернитесь на Привал Защитника к разведчице Джорли.‡Tötet 10 wütende Felshetzer und kehrt zu Späherin Jorli bei Verteidigers Ruh\' zurück.‡사나운 갈퀴발톱 10마리를 처치한 후 구원자의 안식처에 있는 정찰병 요를리에게 돌아가야 합니다.‡Mata a 10 devastadores iracundos e informa a la exploradora Jorli en El Reposo del Vindicador.‡Mata a 10 devastadores iracundos e informa a la exploradora Jorli en El Reposo del Vindicador.‡Tuez 10 Ravageurs enragés puis retournez voir l\'éclaireur Jorli au Repos du redresseur de torts.‡杀掉10个被激怒的掠食者，然后向守备官营地的斥候约莉复命。‡殺了10個暴怒的劫毀者後回到復仇者之陵找斥候喬爾力。',
  }
},
[10066] = {
  {
    'Trama sórdida‡Тенета судьбы‡Alles im Griff‡돌연변이 올가미 덩굴손‡¡Vaya una maraña de telarañas!‡¡Vaya una maraña de telarañas!‡Oh, quelle toile embrouillée...‡纠结之网‡噢，他們所編織的陷阱',
    nil,
    'Mate 8 Emaranhadores Mutantes e apresente-se à Vindicante Corin no Recanto do Vindicante.‡Убейте 8 тенеплетов-мутантов и вернитесь к воздаятельнице Корин в селение Привал Защитника.‡Tötet 8 mutierte Greifer und meldet Euch bei Verteidigerin Corin bei Verteidigers Ruh\'.‡돌연변이 올가미 덩굴손 8마리를 처치한 후 구원자의 안식처에 있는 구원자 코린에게 보고해야 합니다.‡Mata a 8 enmarañadores mutantes e informa al vindicador Corin en El Reposo del Vindicador.‡Mata a 8 enmarañadores mutantes e informa al vindicador Corin en El Reposo del Vindicador.‡Tuez 8 Noueurs mutés et faites votre rapport au redresseur de torts Corin au Repos du redresseur de torts.‡杀掉8只变异的纠结者，然后向守备官营地的守备官考尔琳复命。‡殺掉8個突變的糾纏者後向復仇者之陵的復仇者科林回報。',
  }
},
[10067] = {
  {
    'Espíritos da água corrompidos‡Смрадные водные духи‡Besudelte Wassergeister‡타락한 물의 정령‡Espíritus de agua contaminados‡Espíritus del agua contaminados‡Les élémentaires d\'eau souillée‡污秽的水之魂‡污濁的水精靈',
    nil,
    'Mate 6 Espíritos da Água Corrompidos e fale com a Vindicante Corin no Recanto do Vindicante.‡Убейте 6 смрадных водных духов и вернитесь к воздаятельнице Корин в селение Привал Защитника.‡Tötet 6 besudelte Wassergeister und kehrt zu Verteidigerin Corin bei Verteidigers Ruh\' zurück.‡타락한 물의 정령 6마리를 처치한 후 구원자의 안식처에 있는 구원자 코린에게 돌아가야 합니다.‡Mata a 6 espíritus de agua contaminados corruptos y ve a ver al vindicador Corin a El Reposo del Vindicador.‡Mata a 6 espíritus del agua contaminados corruptos y ve a ver al vindicador Corin a El Reposo del Vindicador.‡Tuez 6 Élémentaires d\'eau souillés et retournez voir le redresseur de torts Corin au Repos du redresseur de torts.‡除掉6个污秽的水之魂，然后向守备官营地的守备官考尔琳复命。‡殺掉6個污濁的水之靈後回到復仇者之陵找復仇者科林。',
  }
},
[10068] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Vigía del pozo Solanian‡Le veilleur du puits Solanian‡护井者索兰尼亚‡看井者索蘭尼亞',
    nil,
    'Fale com o Vigia da Nascente Solanian na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с хранителем Колодца Соланианом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Brunnenbehüter Solanian im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑에 있는 태양샘지기 솔라니안과 대화하십시오.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Habla con el vigía del pozo Solanian en La Aguja del Sol, en la Isla del Caminante del Sol.‡Parlez au veilleur du puits Solanian à la Flèche solaire sur l\'île de Haut-soleil.‡与逐日岛的太阳之塔上的护井者索兰尼亚谈一谈。‡與逐日者之島上日尖塔的看井者索蘭尼亞談談。',
  }
},
[10069] = {
  {
    'Vigia da Nascente Solanian‡Хранитель Колодца Соланиан‡Brunnenbehüter Solanian‡태양샘지기 솔라니안‡Vigía del pozo Solanian‡Vigía del pozo Solanian‡Le veilleur du puits Solanian‡护井者索兰尼亚‡看井者索蘭尼亞',
