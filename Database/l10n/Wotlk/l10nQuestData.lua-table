[2751] = {
  {
    'Muralhas bárbaras‡Варварские доспехи‡Barbarische Waffenschmiedekunst‡야만전사의 갑옷‡Almenas barbáricas‡Almenas barbáricas‡Remparts barbares‡野人装甲‡野人裝甲',
    nil,
    'Leve duas Braçadeiras Decoradas de Bronze, duas Montantes de Bronze e duas Garras Afiadas para Orokk Omosh em Orgrimmar.‡Принесите 2 украшенных узором бронзовых наруча, 2 бронзовых длинных меча и 2 острых когтя Орокку Омошу в Оргриммар.‡Bringt 2 gemusterte bronzene Armschienen, 2 bronzene Großschwerter und 2 scharfe Klauen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 무늬 팔보호구 2개, 청동 대검 2개, 날카로운 발톱 2개를 가져다주어야 합니다.‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.|n‡Lleva 2 brazales de bronce estampados, 2 espadas magnas de bronce y 2 garras afiladas a Orokk Omosh a Orgrimmar.|n‡Apportez 2 Brassards guillochés en bronze, 2 Glaives en bronze et 2 Griffes aiguisées à Orokk Omosh à Orgrimmar.‡将2副青铜花纹护腕、2把青铜巨剑和2只锋利的爪子交给奥格瑞玛的奥罗克·沃姆什。‡將2副青銅花紋護腕、2把青銅巨劍和2隻鋒利的爪子交給奧格瑪的奧羅克·沃姆什。',
  }
},
[2752] = {
  {
    'Em brafoneiras de ferro‡За железными наплечниками‡Über Eisenschulterstücke‡강철 어깨갑옷‡Espaldares de hierro‡Espaldares de hierro‡Épaulettes en fer‡铁肩铠‡鐵肩鎧',
    nil,
    'Leve quatro Machados de Batalha de Bronze e quatro Martelos de Guerra de Bronze para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 4 бронзовых боевых топора и 4 бронзовых боевых молота.‡Bringt 4 bronzene Streitäxte und 4 bronzene Kriegshämmer zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 청동 전투도끼 4개와 청동 전투해머 4개를 가져다주어야 합니다.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Lleva 4 hachas de batalla de bronce y 4 martillos de guerra de bronce a Orokk Omosh a Orgrimmar.‡Apporter 4 Haches de guerre en bronze et 4 Marteaux de guerre en bronze à Orokk Omosh à Orgrimmar.‡将4把青铜战斧和4把青铜战锤交给奥格瑞玛的奥罗克·沃姆什。‡將4把青銅戰鬥斧和4把青銅戰錘交給奧格瑪的奧羅克·沃姆什。',
  }
},
[2753] = {
  {
    'Esmagado sob os calcanhares‡Тяжелая поступь‡In den Boden getrampelt‡발 밑의 적‡¡Aplástalos!‡¡Aplástalos!‡Piétinés‡踩在脚下‡踩在腳底下',
    nil,
    'Leve quatro Elmos Verdes de Ferro, quatro Braçadeiras Verdes de Ferro e duas Perneiras Verdes de Ferro para Orokk Omosh em Orgrimmar.‡Принесите 4 зеленых железных шлема, 4 пары зеленых железных наручей и 2 пары зеленых железных поножей Орокку Омошу в Оргриммар.‡Bringt 4 grüne Eisenhelme, 4 grüne Eisenarmschienen und 2 grüne Eisengamaschen zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 녹색 철제 투구 4개, 녹색 철제 팔보호구 4개, 녹색 철제 다리보호구 2개를 가져다주어야 합니다.‡Lleva 4 yelmos de hierro verdes, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Lleva 4 yelmos de hierro verde, 4 brazales de hierro verdes y 2 pares de leotardos de hierro verdes a Orokk Omosh a Orgrimmar.‡Apporter 4 Heaumes en fer émeraude, 4 Brassards en fer émeraude et 2 Jambières en fer émeraude à Orokk Omosh à Orgrimmar.‡将4顶绿铁头盔、4副绿铁护腕和4副绿铁护腿交给奥格瑞玛的奥罗克·沃姆什。‡將4頂綠鐵頭盔、4副綠鐵護腕和4副綠鐵護腿交給奧格瑪的奧羅克·沃姆什。',
  }
},
[2754] = {
  {
    'Trompas de frenesi‡Рога безумия‡Hörner der Raserei‡광란의 뿔‡Cuernos de frenesí‡Cuernos de frenesí‡Les cornes de Frénésie‡疯狂之角‡瘋狂之角',
    nil,
    'Leve dois Malhos de Ferro Maciço, duas Botas de Bronze Prateado e duas Manoplas de Bronze Prateado para Orokk Omosh em Orgrimmar.‡Принесите Орокку Омошу в Оргриммар 2 прочных железных кувалды, 2 пары посеребренных бронзовых сапог и 2 пары посеребренных бронзовых рукавиц.‡Bringt 2 robuste Eisenschlägel, 2 bronzene Stiefel mit Versilberung und 2 bronzene Stulpen mit Versilberung zu Orokk Omosh in Orgrimmar.‡오그리마에 있는 오로크 오모쉬에게 튼튼한 철제 마울 2개, 은도금한 청동 장화 2개, 그리고 은도금한 청동 장갑 2개를 가져다주어야 합니다.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Lleva 2 grandes mazas de hierro sólido, 2 botas de bronce bañadas en plata y 2 guanteletes de bronce bañados en plata a Orokk Omosh en Orgrimmar.‡Apportez 2 Maillets en fer massif, 2 Bottes en bronze argenté et 2 Gantelets en bronze argenté à Orokk Omosh à Orgrimmar.‡将2只结实的铁锤、2双镀银青铜战靴和2副镀银青铜手套交给奥格瑞玛的奥罗克·沃姆什。‡將2隻堅固的鐵槌、2雙鍍銀青銅戰靴和2副鍍銀青銅護手交給奧格瑪的奧羅克·沃姆什。',
  }
},
[2755] = {
  {
    'Alegria dos Omosh‡Радости Омоша‡Freude der Omoshs‡오모쉬의 기쁨‡Las alegrías de los Omosh‡Las alegrías de los Omosh‡Les joies des Omosh‡沃姆什的喜悦‡沃姆什的喜悅',
    nil,
    'Observe e aprenda a Dancinha da Alegria dos Omosh.‡Научитесь танцу Радости Омошей.‡Seht zu und lernt den Freudentanz der Omoshs.‡오모쉬가 추는 기쁨의 춤을 보고 배워야 합니다.‡Mira la danza de la alegría de los Omosh.‡Mira la danza de la alegría de los Omosh.‡Regarder et apprendre la Danse de joie des Omosh.‡观察并学习沃姆什的喜悦之舞。‡觀察並學習沃姆什的喜悅之舞。',
  }
},
[2756] = {
  {
    'Como antigamente‡Старые обычаи‡Die alten Traditionen‡과거의 방식‡Los viejos hábitos‡Los viejos hábitos‡Les vieilles voies‡古老的技艺‡古老的技藝',
    nil,
    'Leve 4 Peitorais de Aço e 4 Elmos de Placa de Aço para Aturk, o Bigorna, em Orgrimmar.|n‡Принесите 4 стальные кирасы и 4 стальных латных шлема Атурку Наковальне в Оргриммар.‡Bringt 4 Stahlbrustplatten und 4 Stahlplattenhelme zu Aturk dem Amboss in Orgrimmar.‡오그리마에 있는 무쇠모루 아투르크에게 강철 흉갑 4개와 강철 판금 투구 4개를 가져다주어야 합니다.‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.|n‡Lleva 4 corazas de acero y 4 yelmos de placas de acero a Aturk el Yunque a Orgrimmar.|n‡Apporter 4 Cuirasses en acier et 4 Heaumes en plaques d\'acier à Aturk l\'Enclume à Orgrimmar.‡将4套钢质胸甲和4顶钢质头盔交给奥格瑞玛的铁砧阿图尔克。‡將4套鋼質胸甲和4頂鋼質頭盔交給奧格瑪的『鐵鉆』阿圖爾克。',
  }
},
[2757] = {
  {
    'Angra do Butim ou Mina de Mithril?‡Вперед, в Пиратскую Бухту!‡Auf nach Beutebucht!‡무법항으로!‡¡Bahía del Botín o nada!‡¡Bahía del Botín o nada!‡Baie-du-Butin ou la mort !‡藏宝海湾之旅！‡藏寶海灣之旅!',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской Бухте.‡Sprecht mit McGavan in Beutebucht.‡무법항에 있는 맥개번과 대화해야 합니다.‡Habla con McGavan en Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡與藏寶海灣的馬克迦文談話。',
  }
},
[2758] = {
  {
    'As origens da ferraria‡Происхождение кузнечного искусства‡Die Herkunft der Schmiedekunst‡대장기술의 근원‡El origen de la herrería‡El origen de la herrería‡Les origines de la forge‡锻造的本源‡鍛造的起源',
    nil,
    'Leve 6 Braçadeiras de Escama Dourada para Marcelo, o Martelo em Ventobravo.‡Принесите 6 пар золотых чешуйчатых наручей Хэнку Молоту в Штормград.‡Bringt 6 goldene Schuppenarmschienen zu Hank dem Hammer in Sturmwind.‡스톰윈드에 있는 쇠망치 행크에게 황금 미늘 팔보호구 6개를 가져가야 합니다.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Lleva seis brazales de escamas doradas a Hank el Martillo en Ventormenta.‡Apportez 6 Brassards en écailles dorées à Hank le Marteau à Hurlevent.‡将6副金鳞护腕交给暴风城的巨锤汉克。‡將6副金鱗護腕交給暴風城的『巨錘』漢克。',
  }
},
[2759] = {
  {
    'Em busca de Galvan‡В поисках Гальвана‡Auf der Suche nach Galvan‡갈반을 찾아서‡Buscando a Galvan‡Buscando a Galvan‡À la recherche de Galvan‡寻找加尔文‡尋找加爾文',
    nil,
    'Fale com McGavan na Angra do Butim.‡Поговорите с Макгеваном в Пиратской Бухте.‡Sprecht in Beutebucht mit McGavan.‡무법항에 있는 맥개번과 대화해야 합니다.‡Habla con McGavan en Bahía del Botín.‡Habla con McGavan en Bahía del Botín.‡Aller voir McGavan à Baie-du-Butin.‡与藏宝海湾的马克迦文谈一谈。‡與藏寶海灣的馬克迦文談話。',
  }
},
[2760] = {
  {
    'A Ordem do Mithril‡Орден Мифрила‡Der Mithrilorden‡미스릴 대장조합‡La Orden del mitril‡La Orden del mitril‡L\'ordre du Mithril‡秘银会‡秘銀會',
    nil,
    'Fale com Galvan, o Antigo, na Selva do Espinhaço.|n‡Поговорите с Гальваном Древним в Тернистой долине.‡Sprecht mit Galvan dem Alten im Schlingendorntal.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반과 대화해야 합니다.‡Habla con Galvan el Antiguo en la Vega de Tuercespina.|n‡Habla con Galvan el Antiguo en la Vega de Tuercespina.|n‡Aller voir Galvan l\'Ancien dans la vallée de Strangleronce.‡和荆棘谷的加尔文谈一谈。‡和荊棘谷的『長者』加爾文談話。',
  }
},
[2761] = {
  {
    'Fundido e desfundido‡Плавим, не плавим, плавим, не плавим…‡Hier verhütten, da verhütten‡대장기술과 채광‡Funde o no funde‡Funde o no funde‡Ça fond, ça ne fond pas‡铁匠必修课‡鐵匠必修課',
    nil,
    'Leve 40 Barras de Mithril e 40 Barras de Ferro para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и сорок железных слитков Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 40 Eisenbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴와 철 주괴를 각각 40개씩 가져가야 합니다.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cuarenta barras de hierro a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 40 Barres de fer à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和40块铁锭交给荆棘谷的加尔文。‡將40塊秘銀錠和40塊鐵錠交給荊棘谷的『長者』加爾文。',
  }
},
[2762] = {
  {
    'O grande embuste prateado‡Обманное серебро‡Der große silberne Betrüger‡훌륭한 가짜배기 은‡La veraplata no es verídica‡La veraplata no es verídica‡Le vif-argent n\'est pas de l\'argent‡白花花的银子‡白花花的銀子',
    nil,
    'Leve 40 Barras de Mithril e 5 Barras de Veraprata para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и пять слитков истинного серебра Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 5 Echtsilberbarren.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 진은 주괴 5개를 가져가야 합니다.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cinco barras de veraplata a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 5 Barres de vrai-argent à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和5块真银锭交给荆棘谷的加尔文。‡將40塊秘銀錠和5塊真銀錠交給荊棘谷的『長者』加爾文。',
  }
},
[2763] = {
  {
    'A arte de imbuir‡Могущество камней‡Die Kunst der Magieerfüllung‡보석 채취‡El arte de imbuir‡El arte de imbuir‡L\'art de l\'imprégnation‡灌魔工艺‡灌魔工藝',
    nil,
    'Leve 40 Barras de Mithril e 4 Citrinos para Galvan, o Antigo na Selva do Espinhaço.‡Принесите сорок мифриловых слитков и 4 цитрина Гальвану Древнему из Тернистой долины.‡Bringt Galvan dem Alten im Schlingendorntal 40 Mithrilbarren und 4 Citrine.‡가시덤불 골짜기에 있는 전설의 대장장이 갈반에게 미스릴 주괴 40개와 황수정 4개를 가져가야 합니다.‡Lleva cuarenta barras de mitril y cuatro citrinos a Galvan el Antiguo en Tuercespina.‡Lleva cuarenta barras de mitril y cuatro citrinos a Galvan el Antiguo en Tuercespina.‡Apporter 40 Barres de mithril et 4 Citrines à Galvan l\'Ancien à Strangleronce.‡将40块秘银锭和4块黄水晶交给荆棘谷的加尔文。‡將40塊秘銀錠和4塊黃水晶交給荊棘谷的『長者』加爾文。',
  }
},
[2764] = {
  {
    'O melhor pupilo de Galvan‡Лучший ученик Гальвана‡Galvans bester Schüler‡갈반의 수제자‡El mejor alumno de Galvan‡El mejor alumno de Galvan‡Le meilleur disciple de Galvan‡加尔文的得意门生‡加爾文的得意門生',
    nil,
    'Fale com Trenton Lumartelo em Geringontzan, que fica em Tanaris.‡Поговорите с Трентоном Молотом Света. Его можно найти в Прибамбасске, что в Танарисе.‡Sprecht mit Trenton Lichthammer. Zu finden ist er in Gadgetzan in Tanaris.‡타나리스의 가젯잔에 있는 트렌튼 라이트해머와 대화해야 합니다.‡Habla con Trenton Mazaligera en Gadgetzan, en Tanaris.‡Habla con Trenton Mazaligera en Gadgetzan, en Tanaris.‡Parler à Trenton Martelume à Gadgetzan, en Tanaris.‡和塔纳利斯的加基森的特伦顿·轻锤谈一谈。‡到塔納利斯到的加基森找特倫頓·輕錘談話。',
  }
},
[2765] = {
  {
    'Ferreiro perito!‡Кузнец-умелец!‡Schmiedkunstexperte!‡고급 대장기술‡¡Experto herrero!‡¡Experto herrero!‡Maître Forgeron !‡锻造专家!‡鍛造專家!',
    nil,
    'Pegue sua recompensa com Galvan, o Antigo!‡Получите награду у Гальвана Древнего!‡Fordert Eure Belohnung von Galvan dem Alten ein!‡전설의 대장장이 갈반에게서 보상을 받아야 합니다.‡Reclama tu recompensa a Galvan el Antiguo.‡Reclama tu recompensa a Galvan el Antiguo.‡Réclamez votre récompense à Galvan l\'Ancien !‡到加尔文那里拿取报酬！‡到『長者』加爾文那裡拿取報酬!',
  }
},
[2766] = {
  {
    'Encontre o OOX-22/FE!‡Найти ККX-22/FE!‡Findet OOX-22/FE!‡OOX-22/FE 수색‡¡Encuentra a OOX-22/FE!‡¡Encuentra a OOX-22/FE!‡Trouvez OOX-22/FE !‡寻找OOX-22/FE！‡尋找OOX-22/FE!',
    nil,
    'Pegue o transmissor de emergência para o robô teleguiado de Olhatorto na caverna próxima ao Vale dos Abomináveis.‡Отнесите аварийный маяк к автономному роботу Карлса, в пещеру рядом с Долиной Свирепого Утеса.‡Bringt das Notrufsignal zu Glotz\' Leitroboter in einer Höhle in der Nähe des Wildschrammtals.‡거친흉터 골짜기에 있는 오글소프의 유도 로봇에게 조난 탐지기를 가져가야 합니다.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Lleva el localizador de emergencia al robot mensajero de Oglethorpe a una cueva que hay cerca de Vega Cicatriz Feral.‡Placez la balise de détresse dans le robot d\'Orguignard qui se trouve dans une caverne près du val des Griffes farouches.‡把定位器带到深痕谷附近山洞中的奥格索普的导航机器人旁边。‡把定位器帶到深痕谷附近山洞中的奧格索普的導航機器人旁邊。',
  }
},
[2767] = {
  {
    'Resgate o OOX-22/FE!‡Спасти ККX-22/FE!‡Die Rettung von OOX-22/FE‡OOX-22/FE 구출!‡¡Escolta a OOX-22/FE!‡¡Escolta a OOX-22/FE!‡À la rescousse de OOX-22/FE !‡拯救OOX-22/FE！‡拯救OOX-22/FE!',
    nil,
    'Escort OOX-22/FE to safety, then report to Oglethorpe Obnoticus in Booty Bay.‡Проводите ККX-22/FE в безопасное место, затем сообщите об этом Карлсу Пропеллерзу в Пиратской Бухте.‡Bringt OOX-22/FE in Sicherheit und meldet Euch dann bei Glotz Widrikus in Beutebucht.‡OOX-22/FE를 안전하게 호위하여 무법항에 있는 오글소프 오브노티쿠스에게 가서 보고해야 합니다.‡Escolta a OOX-22/FE para que llegue sano y salvo y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escolta a OOX-22/FE para que llegue sano y salvo y después preséntate ante Oglethorpe Obnoticus en Bahía del Botín.‡Escortez OOX-22/FE jusqu\'à ce qu\'il soit en sécurité, puis rendez compte à Orguignard Odipnoticus à Baie-du-Butin.‡安全护送OOX-22/FE到达目的地，然后向藏宝海湾的奥格索普·奥布诺提斯报告。‡護送OOX-22/FE到安全地點，然後向藏寶海灣的奧格索普·奧布諾提斯回報。',
  }
},
[2768] = {
  {
    'Bastão divinomático‡Изыскательский жезл‡Wünschel-mato-Rute‡자동 탐사막대‡Vara divinomática‡Vara divinomática‡Le bâtonnet divino-matic‡探水棒‡探水棒',
    nil,
    'Leve o Bastão Divinomático ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите изыскательский жезл главному инженеру Чепухастеру в Прибамбасск.‡Bringt die Wünschel-mato-Rute nach Gadgetzan zu Chefingenieur Bilgenritzel.‡가젯잔에 있는 선임기술자 빌지위즐에게 자동 탐사막대를 가져가야 합니다.‡Lleva la vara divinomática al ingeniero jefe Pasaquillas en Gadgetzan.‡Lleva la vara divinomática al ingeniero jefe Pasaquillas en Gadgetzan.‡Apportez le Bâtonnet divino-matic à l\'Ingénieur en chef Vizisanie, à Gadgetzan.‡把探水棒交给加基森的首席工程师沙克斯-比格维兹。‡把探水棒交給加基森的首席工程師膨嘯。',
  }
},
[2769] = {
  {
    'Os irmãos Latafuso‡Братья Медноштиф‡Die Brüder Kupferbolz‡브라스볼츠 형제‡Los hermanos Pernolatón‡Los hermanos Pernolatón‡Les frères Zéboulon‡铜栓兄弟‡銅栓兄弟',
    nil,
    'Fale com Capu Latafuso no Salar Cintilante.‡Поговорите с Виззлом Медноштифом на Мерцающей равнине.‡Sprecht mit Wizzel Kupferbolz in der schimmernden Ebene.‡소금 평원에 있는 위즐 브라스볼츠와 대화해야 합니다.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Habla con Wizzle Pernolatón en El Desierto de Sal.‡Parler à Lachnouf Zéboulon dans les Salines.‡和闪光平原的维兹尔·铜栓谈一谈。‡和閃光平原的維茲爾·銅栓談話。',
  }
},
[2770] = {
  {
    'Gahz\'rilla‡Газ\'рилла‡Gahz\'rilla‡가즈릴라‡Gahz\'rilla‡Gahz\'rilla‡Gahz\'rilla‡加兹瑞拉‡加茲瑞拉',
    nil,
    'Leve a Escama Eletrificada de Gahz\'rilla para Capu Latafuso no Salar Cintilante.‡Принесите искрящую чешую Газ\'риллы Виззлу Медноштифу на Мерцающую равнину.‡Bringt Wizzel Kupferbolz in der schimmernden Ebene Gahz\'rillas elektrisierte Schuppe.‡소금 평원에 있는 위즐 브라스볼츠에게 가즈릴라의 전기 비늘을 가져가야 합니다.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale la escama electrificada de Gahz\'rilla a Wizzle Pernolatón, que está en El Desierto de Sal.‡Rapporter l\'Ecaille électrifiée de Gahz\'rilla à Lachnouf Zéboulon dans les Salines.‡把加兹瑞拉的鳞片交给闪光平原的维兹尔·铜栓。‡把加茲瑞拉的鱗片交給閃光平原的維茲爾·銅栓。',
  }
},
[2771] = {
  {
    'A ótima cabeça sobre os ombros‡Голова на плечах‡Ein schlauer Kopf auf den Schultern‡지혜로운 스승‡La cabeza sobre los hombros‡La cabeza sobre los hombros‡Une tête bien faite sur les épaules‡罩帽和护肩‡罩帽和護肩',
    nil,
    'Leve 2 Coifas de Mithril e 1 Ombreira Ornada de Mithril para Trenton Lumartelo.‡Принесите два мифриловых капюшона и изысканный мифриловый наплечник Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 Mithrilhelmkappen und 1 verschnörkelte Mithrilschulter.‡트렌튼 라이트해머에게 미스릴 코이프 2개와 화려한 미스릴 어깨보호구 1개를 가져가야 합니다.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de almófares de mitril y unos sobrehombros de mitril ornamentado a Trenton Mazaligera.‡Apportez deux Camails en mithril et une paire d\'Epaulières ornées en mithril à Trenton Martelume.‡将2顶秘银罩帽和1副精制秘银护肩带秘银护肩交给特伦顿·轻锤。‡將2頂秘銀頭巾和1副華麗秘銀護肩帶秘銀護肩交給特倫頓·輕錘。',
  }
},
[2772] = {
  {
    'O mundo a seus pés‡Мир у твоих ног‡Die Welt zu Euren Füßen‡세상을 내 발아래‡El mundo a tus pies‡El mundo a tus pies‡Le monde à vos pieds‡世界在你脚下‡世界在你腳下',
    nil,
    'Leve 2 Botas Pesadas de Mithril e 1 Calça Ornada de Mithril para Trenton Lumartelo.|n‡Принесите две пары тяжелых мифриловых сапог и изысканные мифриловые штаны Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 schwere Mithrilstiefel und 1 verschnörkelte Mithrilhose.‡트렌튼 라이트해머에게 견고한 미스릴 장화 2개와 화려한 미스릴 바지 1개를 가져가야 합니다.‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.|n‡Llévale un par de botas de mitril pesado y unos pantalones de mitril ornamentado a Trenton Mazaligera.|n‡Apportez deux paires de Bottes en mithril lourd et un Pantalon orné en mithril à Trenton Martelume.‡将2双秘银重靴和1条精制秘银短裤交秘银短裤交给特伦顿·轻锤。‡將2雙秘銀重靴和1條華麗秘銀束褲交給特倫頓·輕錘。',
  }
},
[2773] = {
  {
    'Kid Mithril‡Мифриловый парень‡Mithril-Kid‡미스릴 천재‡El chico de mitril‡El chico de mitril‡Le gars du mithril‡秘银小子‡秘銀小子',
    nil,
    'Leve 2 Peitorais Pesados de Mithril e 1 Luva Ornada de Mithril para Trenton Lumartelo.‡Принесите две тяжелых мифриловых кирасы и изысканные мифриловые перчатки Трентону Молоту Света.‡Bringt Trenton Lichthammer 2 schwere Mithrilbrustplatten und 1 verschnörkelten Mithrilhandschuh.‡트렌튼 라이트해머에게 견고한 미스릴 흉갑 2개와 화려한 미스릴 장갑 1개를 가져가야 합니다.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Llévale un par de corazas de mitril pesado y unos guantes de mitril ornamentado a Trenton Mazaligera.‡Apportez deux Cuirasses lourdes en mithril et une paire de Gants ornés en mithril à Trenton Martelume.‡将2件重型秘银胸甲和1副精制秘银手套带给特秘银手套交给特伦顿·轻锤。‡將2件重型秘銀胸甲和2副華麗秘銀手套交給特倫頓·輕錘。',
  }
},
[2781] = {
  {
    'PROCURA-SE: Califa Escorpicada‡Разыскивается: Калиф Жало Скорпида‡GESUCHT: Kalif Skorpidstich‡현상 수배: 칼리프 스콜피드스팅‡SE BUSCA: Califa Escorpijón‡SE BUSCA: Califa Escorpijón‡ON RECHERCHE : Caliph Dard-de-scorpide‡通缉：卡利夫·斯科比斯汀‡懸賞:卡利夫·斯科比斯汀',
    nil,
    'Leve a cabeça de Califa Escorpicada ao Engenheiro-chefe Silvadágua em Geringontzan.‡Принесите голову Калифа Жало Скорпида главному инженеру Чепухастеру в Прибамбасск.‡Bringt Chefingenieur Bilgenritzel in Gadgetzan den Kopf von Kalif Skorpidstich.‡칼리프 스콜피드스팅을 처치하고 그 증거로 그의 머리카락을 가젯잔에 있는 선임기술자 빌지위즐에게 가져다주어야 합니다.‡Llévale la cabeza de Califa Escorpijón al ingeniero jefe Pasaquillas, que está en Gadgetzan.‡Llévale la cabeza de Califa Escorpijón al ingeniero jefe Pasaquillas, que está en Gadgetzan.‡Apportez la tête de Caliph Dard-de-scorpide à l\'Ingénieur en chef Vizisanie à Gadgetzan.‡将卡利夫·斯科比斯汀的徽记交给加基森的首席工程师沙克斯·比格维兹。‡將卡利夫·斯科比斯汀的頭顱交給加基森的首席工程師膨嘯。',
  }
},
[2782] = {
  {
    'O segredo de Rin\'ji‡Секрет Рин\'джи‡Rin\'jis Geheimnis‡린지의 비밀‡El secreto de Rin\'ji‡El secreto de Rin\'ji‡Secret de Rin\'ji‡林吉的秘密‡林吉的秘密',
    nil,
    'Urraca Convulserpe, uma acadêmica bastante reconhecida em assuntos relacionados às trolesas Cascasseca, pode ser capaz de decifrar a tabuleta. Ela mora no Distrito da Magia da Cidade Baixa.‡Отнесите табличку Оран Змеиные Кольца в Квартал Магов Подгорода. Оран – известная ученая, изучающая троллей из племени Сухокожих, и она наверняка сумеет прочесть надписи на табличке.‡Oran Schlangenfuß, eine bekannte Gelehrte auf dem Gebiet der Bleichborkentrolle, könnte die Tafel vielleicht übersetzen. Normalerweise hält sie sich im Magierviertel von Unterstadt auf.‡마른나무껍질 트롤에 관해서 누구보다 잘 알고 있는 저명한 학자인 오란 스네이크레이드라면 이 서판을 해독할 수 있을지도 모릅니다. 그녀는 언더시티의 마법 지구에 살고 있다고 합니다.‡Oran Snakewrithe es una conocida erudita en los trols Secacorteza; quizá pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Snakewrithe es una conocida erudita en los trols Secacorteza; quizás pueda descifrar la tablilla. Vive en el Barrio de la Magia de Entrañas.‡Oran Serpenroule, une érudite réputée pour sa connaissance des us et coutumes des trolls Fânécorces, pourrait peut-être déchiffrer la tablette. Elle habite le Quartier de la magie à Fossoyeuse.‡奥兰·斯内克威瑟是个学者，她对枯木巨魔很有研究，也许她可以帮你看看这块石板。奥兰就住在幽暗城的魔法区里。‡奧蘭·蛇繞，一個以研究枯木食人妖聞名的學者，她或許能幫你解讀這塊石板。她住在幽暗城的法師區。',
  }
},
[2783] = {
  {
    'Brigas mesquinhas‡Незначительные разногласия‡Kleinliches Gezänk‡사소한 말다툼‡Peleas mezquinas‡Peleas mezquinas‡Querelles mesquines‡争论‡爭論',
    nil,
    'Fale com o Herói Caído da Horda na fronteira entre Barreira do Inferno e o pântano.‡Поговорите с павшим героем Орды на границе Выжженных земель и болот.‡Sprecht mit dem gefallenen Helden der Horde im Grenzgebiet zwischen den verwüsteten Landen und dem Sumpf.‡저주받은 땅과 늪의 경계에 있는 호드 영웅의 넋과 대화해야 합니다.‡Habla con el héroe caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Habla con el héroe caído de la Horda donde Las Tierras Devastadas lindan con El pantano.‡Parler au Héros de la Horde tombé au combat à la frontière des Terres foudroyées et du marais.‡与诅咒之地和悲伤沼泽交界处的部落英雄的灵魂谈一谈。‡與詛咒之地和悲傷沼澤交界處的部落英雄的靈魂談話。',
  }
},
[2784] = {
  {
    'Caindo em desgraça‡Попавший в немилость‡In Ungnade fallen‡명예 실추‡Pérdida de honor‡Pérdida de honor‡Perte d\'honneur‡失落的荣耀‡失去的榮耀',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del héroe caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écouter le Héros de la Horde tombé au combat raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2801] = {
  {
    'Uma história de tristeza‡Печальная история‡Eine Geschichte voller Leid‡슬픈 이야기‡Una historia triste‡Una historia triste‡Une histoire de chagrin‡悲伤的故事‡悲傷的故事',
    nil,
    'Ouça o Herói Caído da Horda contando a história dele.‡Послушайте, как павший герой Орды рассказывает свою историю.‡Lauscht der Geschichte des gefallenen Helden der Horde.‡호드 영웅의 넋이 하는 이야기를 들어야 합니다.‡Escucha la historia del héroe caído de la Horda.‡Escucha la historia del héroe caído de la Horda.‡Écoutez le Héros de la Horde tombé au combat raconter son histoire.‡聆听部落英雄的灵魂讲述他的故事。‡聆聽部落英雄的靈魂講述他的故事。',
  }
},
[2821] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡최고의 품질‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡品質的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 толстых шкур йети Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 10 dicke Yetibälge.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti gruesos a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 pellejos de yeti gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Peaux de yéti épaisses à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去10张厚重的雪人皮。‡給羽月要塞的普拉特·馬克格魯比帶去10張厚重的雪人毛皮。',
  }
},
[2822] = {
  {
    'Marca de qualidade‡Знак качества‡Das Zeichen der Qualität‡품질 표시‡La marca de la calidad‡La marca de la calidad‡La marque de la qualité‡质量的保证‡品質的保證',
    nil,
    'Leve 10 peças de Pelego Grosso de Yeti para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 толстых шкур йети Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 10 dicke Yetibälge.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 설인 가죽 10개를 가져가야 합니다.‡Lleva 10 pellejos de yeti gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 10 pellejos de yeti gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 10 Peaux de yéti épaisses à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去十张厚重的雪人皮。‡給莫沙徹營地的杉多爾·迅蹄帶去十張厚重的雪人毛皮。',
  }
},
[2841] = {
  {
    'Guerra dos robôs‡Техновойны‡Maschinenkriege‡기술 전쟁‡Las guerras de la plataforma‡Las guerras de la plataforma‡Guerre des plates-formes‡设备之战‡設備之戰',
    nil,
    'Pegue a Combinação do Cofre do Termaplugue e o Projeto de Mecatraje e leve-os para Nogg em Orgrimmar.|n‡Добудьте в Гномрегане чертежи боевой машины и код от сейфа Термоштепселя в Гномрегане и принесите их Ноггу в Оргриммар.‡Besorgt die Maschinenblaupausen und Thermadrahts Safekombination aus Gnomeregan und bringt sie zu Nogg nach Orgrimmar.‡놈리건에서 장치 설계도와 텔마플러그의 금고 암호를 찾아서 오그리마에 있는 노그에게 가져다주어야 합니다.‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.|n‡Consigue la combinación de la caja fuerte de Termochufe en Gnomeregan y lleva los planos de la plataforma a Nogg a Orgrimmar.|n‡Obtenez la Combinaison du coffre de Thermojoncteur, prenez les Plans de la plate-forme à Gnomeregan et apportez-les à Nogg, à Orgrimmar.‡从诺莫瑞根拿到钻探设备蓝图和麦克尼尔的保险箱密码，把它们交给奥格瑞玛的诺格。‡從諾姆瑞根拿到鑽探設備藍圖和麥克尼爾的保險箱密碼，把它們交給奧格瑪的諾格。',
  }
},
[2842] = {
  {
    'Engenheiro-chefe Scooty‡Главный инженер Скути‡Chefingenieur Scooty‡선임기술자 스쿠티‡Scooty, ingeniero jefe‡Scooty, ingeniero jefe‡L\'ingénieur en chef Scooty‡主工程师斯库提‡首席工程師斯庫提',
    nil,
    'Fale com Scooty na Angra do Butim.‡Поговорите со Скути в Пиратской Бухте.‡Sprecht mit Scooty in Beutebucht.‡무법항에 있는 스쿠티와 대화해야 합니다.‡Habla con Scooty en Bahía del Botín.‡Habla con Scooty en Bahía del Botín.‡Parler à Scooty à Baie-du-Butin.‡和藏宝海湾的斯库提谈一谈。‡和藏寶海灣的斯庫提談話。',
  }
},
[2843] = {
  {
    'E lá vamos nós!‡Поехалиии!‡Gnomer-weeeeg!‡놈리거어어어언!‡¡Gnomer-yaaaaa!‡¡Gnomer-yaaaaa!‡Gnomer-paaarti !‡出发！诺莫瑞根！‡出發!諾姆瑞根!',
    nil,
    'Esperar até Scooty calibrar o Transponder Goblínico.‡Дождитесь, пока Скути настроит гоблинский импульсный повторитель.‡Wartet, bis Scooty den Goblintransponder kalibriert hat.‡스쿠티가 고블린 응답장치를 조절하는 동안 기다려야 합니다.‡Espera a que Scooty calibre el transpondedor goblin.‡Espera a que Scooty calibre el transpondedor goblin.‡Attendre que Scooty calibre le Transpondeur gobelin.‡等斯库提调整好地精传送器。‡等斯庫提調整好哥布林傳送器。',
  }
},
[2844] = {
  {
    'O guardião gigante‡Великан-опекун‡Der Riesenwächter‡거대한 수호자‡El guardián gigante‡El guardián gigante‡Le garde géant‡大保姆‡大保姆',
    nil,
    'Encontre a elfa noturna desaparecida.‡Найдите потерявшуюся ночную эльфийку.‡Findet das verlorene Nachtelfenmädchen.‡길 잃은 나이트 엘프 소녀를 찾아야 합니다.‡Localiza a la elfa de la noche perdida.‡Localiza a la elfa de la noche perdida.‡Retrouver la jeune elfe de la nuit perdue.‡寻找走丢了的精灵小姑娘。‡尋找走丟了的精靈小姑娘。',
  }
},
[2845] = {
  {
    'Shay distraída‡Шая-бродяжница‡Streunende Shay‡방황하는 샤이‡Las andanzas de Shay‡Las andanzas de Shay‡Shay l\'égarée‡迷路的沙恩‡迷路的沙恩',
    nil,
    'Pegue o Sino de Shay do baú.|n|nEscolte Shay Velifrondes até o acampamento de Trinca-pedra.‡Достаньте из сундучка колокольчик Шаи.|n|nПроводите Шаю Листогон в лагерь Камнедробителя.‡Nehmt Shays Glocke aus der Truhe.|n|nBegleitet Shay Laubschleicher zu Felsbeißers Lager.‡궤짝에서 샤이의 종을 집어야 합니다.|n|n샤이 리프러너를 무쇠이빨의 야영지까지 호휘해야 합니다.‡Coge la campana de Shay del cofre.|n|nEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Saca la campana de Shay del cofre.|n|nEscolta a Shay Correhoja al campamento de Muerdepiedras.‡Prendre la Cloche de Shay dans le coffre.|n|nEscorter Shay Coursefeuille au Camp de Croque-roc.‡从箱子里拿取沙恩的铃铛，然后护送沙恩·飘叶回到罗克比特的营地。‡從箱子裡拿取沙恩的鈴鐺，然後護送沙恩·飄葉回到羅克比特的營地。',
  }
},
[2846] = {
  {
    'Tiara das Profundezas‡Тиара Глубин‡Tiara der Tiefen‡심연의 티아라‡Tiara de las Profundidades‡Tiara de las profundidades‡La tiare des abysses‡深渊皇冠‡深淵冠冕',
    nil,
    'Leve a Tiara das Profundezas para Tabetha no Pântano Vadeoso.‡Принесите Тиару Глубин Табете в Пылевых топях.‡Bringt die Tiara der Tiefen zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 심연의 티아라를 가져가야 합니다.‡Lleva la Tiara de las Profundidades a Tabetha en el Marjal Revolcafango.‡Lleva la tiara de las profundidades a Tabetha en el Marjal Revolcafango.‡Apportez la Tiare des abysses à Tabetha au marécage d\'Âprefange.‡将深渊皇冠交给尘泥沼泽的塔贝萨。‡將深淵冠冕交給塵泥沼澤的塔貝薩。',
  }
},
[2847] = {
  {
    'Armadura de couro silvestre‡Доспехи из дикой кожи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir fauve‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 10 кусков плотной кожи Пратту Макгруббену в Крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 10 Stücke dickes Leder.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Lleva 10 cueros gruesos a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 10 Cuirs épais à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去10块厚皮。‡給羽月要塞的普拉特·馬克格魯比帶去10塊厚皮。',
  }
},
[2848] = {
  {
    'Omoplatas de couro silvestre‡Наплечники из дикой кожи‡Wildlederschultern‡야생 가죽 어깨보호구‡Sobrehombros de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir fauve‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Pradal McGrubben, que fica no Domínio de Plumaluna.‡Принесите 6 накладок из толстой кожи и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 6 dicke Rüstungssets und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 refuerzos para armadura gruesos y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去6片厚重护甲片和1株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去6片厚重護甲片和1株野葡萄。',
  }
},
[2849] = {
  {
    'Colete de couro silvestre‡Жилет из дикой кожи‡Wildlederweste‡야생 가죽 조끼‡El Jubon de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir fauve‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Schildkrötenschuppenbrustplatten, 2 Paar Schildkrötenschuppenhandschuhe und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去2件龜鱗胸甲、2副龜鱗手套和1株野葡萄。',
  }
},
[2850] = {
  {
    'Capacete de couro silvestre‡Шлем из дикой кожи‡Wildlederhelm‡야생 가죽 투구‡Casco de cuero salvaje‡Casco de cuero salvaje‡Le casque en cuir fauve‡蛮皮头盔‡蠻皮盔帽',
    nil,
    'Leve 2 Túnicas da Escapada Noturna, 2 Bandanas da Escapada Noturna e uma Vinha Selvagem para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 ночных мундира, 2 ночных головных повязки и дикую лозу Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Tuniken des Nachtschleichers, 2 Stirnbänder des Nachtschleichers und eine Wildranke.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 튜닉 2개, 밤하늘 머리띠 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 túnicas Nochefugaz, 2 cintas Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Tuniques de la nuit, 2 Bandeaux de la nuit et 1 Sauvageonne à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去2件夜色外套、2条夜色头巾和一株野葡萄。‡給羽月要塞的普拉特·馬克格魯比帶去2件夜景外套、2條夜景頭巾和一株野葡萄。',
  }
},
[2851] = {
  {
    'Botas de couro silvestre‡Сапоги из дикой кожи‡Wildlederstiefel‡야생 가죽 장화‡Botas de cuero salvaje‡Botas de cuero salvaje‡Les bottes en cuir fauve‡蛮皮战靴‡蠻皮戰靴',
    nil,
    'Leve 2 Calças da Escapada Noturna, 2 Botas da Escapada Noturna e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите 2 пары ночных штанов, 2 пары ночных сапог и 2 диких лозы Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Hosen des Nachtschleichers, 2 Stiefel des Nachtschleichers und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 밤하늘 바지 2개, 밤하늘 장화 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Pantalons de la nuit, 2 paires de Bottes de la nuit et 2 Sauvageonnes à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁带去2条夜色裤、2双夜色靴和2株野葡萄。‡給羽月要塞的普拉特·馬克格魯帶去2條夜景褲、2雙夜景靴和2株野葡萄。',
  }
},
[2852] = {
  {
    'Perneiras de couro silvestre‡Поножи из дикой кожи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir fauve‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Pradal McGrubben no Domínio de Plumaluna.‡Принесите два черепашьих чешуйчатых шлема, две пары черепашьих чешуйчатых наручей и две дикие лозы Пратту Макгруббену в крепость Оперенной Луны.‡Bringt Pratt McGrubben in der Mondfederfeste 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡페더문 요새에 있는 프랫 맥그루벤에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de escamas de tortuga, 2 brazales de escamas de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Pratt McGrubben al Bastión Plumaluna.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Pratt McGrubben au bastion de Pennelune.‡给羽月要塞的普拉特·马克格鲁比带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡給羽月要塞的普拉特·馬克格魯比帶去2頂龜鱗頭盔、2副龜鱗護腕和2株野葡萄。',
  }
},
[2853] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir fauve‡蛮皮护甲大师‡蠻皮護甲大師',
    nil,
    'Entregue a Carta de Pradal para Telonis, o mestre coureiro de Darnassus.‡Отдайте письмо Пратта Телонису, главному кожевнику Дарнаса.‡Gebt Telonis, dem Lederverarbeitungsmeister von Darnassus, Pratts Brief.‡다르나서스에 있는 가죽세공의 대가인 텔로니스에게 프랫의 편지를 가져가야 합니다.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Entrega la carta de Pratt a Telonis, el maestro curtidor de Darnassus.‡Donner la Lettre de Pratt à Telonis, le Maître tanneur de Darnassus.‡将普拉特的信交给达纳苏斯的制皮大师泰龙尼斯。‡將普拉特的信交給達納蘇斯的製皮大師泰龍尼斯。',
  }
},
[2854] = {
  {
    'Armadura de couro silvestre‡Доспехи из дикой кожи‡Wildlederrüstung‡야생 가죽 방어구‡Armadura de cuero salvaje‡Armadura de cuero salvaje‡L\'armure en cuir fauve‡蛮皮护甲‡蠻皮護甲',
    nil,
    'Leve 10 peças de Couro Grosso para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 10 кусков плотной кожи Джангору Быстрому Страннику в Лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 10 Stücke dickes Leder.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 가죽 10개를 가져가야 합니다.‡Lleva 10 cueros gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 10 cueros gruesos a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 10 Cuirs épais à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去10块厚皮。‡給莫沙徹營地的杉多爾·迅蹄帶去10塊厚皮。',
  }
},
[2855] = {
  {
    'Omoplatas de couro silvestre‡Наплечники из дикой кожи‡Wildlederschultern‡야생 가죽 어깨보호구‡Sobrehombros de cuero salvaje‡Sobrehombros de cuero salvaje‡Les épaulières en cuir fauve‡蛮皮护肩‡蠻皮護肩',
    nil,
    'Leve 6 Kits de Armadura Grossa e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 6 накладок из толстой кожи и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 6 dicke Rüstungssets und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 두꺼운 방어구 키트 6개와 야생덩굴 1개를 가져가야 합니다.‡Lleva 6 refuerzos para armadura gruesos y 1 atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 6 refuerzos para armadura gruesos y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Apporter 6 Renforts d\'armure épais et 1 Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去6块厚重护甲片和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去6塊厚重護甲片和1株野葡萄。',
  }
},
[2856] = {
  {
    'Colete de couro silvestre‡Жилет из дикой кожи‡Wildlederweste‡야생 가죽 조끼‡El Jubón de cuero salvaje‡El Jubón de cuero salvaje‡Le gilet en cuir fauve‡蛮皮外衣‡蠻皮外衣',
    nil,
    'Leve 2 Peitorais de Escama de Tartaruga, 2 Luvas de Escama de Tartaruga e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 черепашьих чешуйчатых кирасы, 2 пары черепашьих чешуйчатых перчаток и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Schildkrötenschuppenbrustplatten, 2 Schildkrötenschuppenhandschuhe und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 흉갑 2개, 거북 껍질 장갑 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y 1 atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 2 corazas de caparazón de tortuga, 2 guantes de caparazón de tortuga y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Cuirasses en écailles de tortue, 2 paires de Gants en écailles de tortue et une Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2件龟鳞胸甲、2副龟鳞手套和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2件龜鱗胸甲、2副龜鱗手套和1株野葡萄。',
  }
},
[2857] = {
  {
    'Capacete de couro silvestre‡Шлем из дикой кожи‡Wildlederhelm‡야생 가죽 투구‡Casco de cuero salvaje‡Casco de cuero salvaje‡Le casque en cuir fauve‡蛮皮头盔‡蠻皮盔帽',
    nil,
    'Leve 2 Túnicas da Escapada Noturna, 2 Bandanas da Escapada Noturna e uma Vinha Selvagem para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 ночных мундира, 2 ночных головных повязки и дикую лозу Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Tuniken des Nachtschleichers, 2 Stirnbänder des Nachtschleichers und eine Wildranke.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 밤하늘 튜닉 2개, 밤하늘 머리띠 2개, 야생덩굴 1개를 가져가야 합니다.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y 1 atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 2 guerreras Nochefugaz, 2 cintas de pelo Nochefugaz y una atriplex salvaje a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Tuniques de la nuit, 2 Bandeaux de la nuit et 1 Sauvageonne à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2件夜色外套、2条夜色头巾和1株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2件夜景外套、2條夜景頭巾和1株野葡萄。',
  }
},
[2858] = {
  {
    'Botas de couro silvestre‡Сапоги из дикой кожи‡Wildlederstiefel‡야생 가죽 장화‡Botas de cuero salvaje‡Botas de cuero salvaje‡Les bottes en cuir fauve‡蛮皮战靴‡蠻皮戰靴',
    nil,
    'Leve 2 Calças da Escapada Noturna, 2 Botas da Escapada Noturna e 2 Vinhas Selvagens para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите 2 пары ночных штанов, 2 пары ночных сапог и 2 диких лозы Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Hosen des Nachtschleichers, 2 Stiefel des Nachtschleichers und 2 Wildranken.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 밤하늘 바지 2개, 밤하늘 장화 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 2 pantalones Nochefugaz, 2 botas Nochefugaz y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Pantalons de la nuit, 2 paires de Bottes de la nuit et 2 Sauvageonnes à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2条夜色短裤、2双夜色长靴和2株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2條夜景束褲、2雙夜景長靴和2株野葡萄。',
  }
},
[2859] = {
  {
    'Perneiras de couro silvestre‡Поножи из дикой кожи‡Wildledergamaschen‡야생 가죽 다리보호구‡Leotardos de cuero salvaje‡Leotardos de cuero salvaje‡Les jambières en cuir fauve‡蛮皮护腿‡蠻皮護腿',
    nil,
    'Leve 2 Elmos de Escama de Tartaruga, 2 Braçadeiras de Escama de Tartaruga e 2 Vinhas Selvagens para Jangdor Passo Veloz na Aldeia Mojache.‡Принесите два черепашьих чешуйчатых шлема, две пары черепашьих чешуйчатых наручей и две дикие лозы Джангору Быстрому Страннику в лагерь Мохаче.‡Bringt Jangdor Flinkschreiter im Camp Mojache 2 Schildkrötenschuppenhelme, 2 Schildkrötenschuppenarmschienen und 2 Wildranken.‡모자케 야영지에 있는 장도르 스위프트스트라이더에게 거북 껍질 투구 2개, 거북 껍질 팔보호구 2개, 야생덩굴 2개를 가져가야 합니다.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Lleva 2 yelmos de caparazón de tortuga, 2 brazales de caparazón de tortuga y 2 atriplex salvajes a Jangdor Zanco Veloz al Campamento Mojache.‡Rapporter 2 Casques en écailles de tortue, 2 Brassards en écailles de tortue et 2 Sauvageonnes à Jangdor Rôdeur-agile au Camp Mojache.‡给莫沙彻营地的杉多尔·迅蹄带去2顶龟鳞头盔、2副龟鳞护腕和2株野葡萄。‡給莫沙徹營地的杉多爾·迅蹄帶去2頂龜鱗頭盔、2副龜鱗護腕和2株野葡萄。',
  }
},
[2860] = {
  {
    'Mestre do couro silvestre‡Мастер школы Дикаря‡Meister des Wildleders‡야생 가죽세공의 대가‡Maestro de cuero salvaje‡Maestro de cuero salvaje‡Maître du cuir fauve‡蛮皮护甲大师‡蠻皮護甲大師',
    nil,
    'Entregue a Carta de Jangdor para Una, a mestre coureira do Penhasco do Trovão.‡Отдайте письмо Джангора Уне, главному кожевнику Громового Утеса.‡Gebt Una, der Lederverarbeitungsmeisterin von Donnerfels, Jangdors Schreiben.‡썬더 블러프에 있는 가죽세공의 대가인 우나에게 장도르의 편지를 가져가야 합니다.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Entrega la carta de Jangdor a Una, el maestro curtidor de Cima del Trueno.‡Donner la Lettre de Jangdor à Una, le Maître tanneur des Pitons du Tonnerre.‡将杉多尔的信交给雷霆崖的制皮大师犹纳。‡將杉多爾的信交給雷霆崖的製皮大師猶納。',
  }
},
[2861] = {
  {
    'A tarefa de Tabetha‡Миссия Табеты‡Tabethas Aufgabe‡타베사의 임무‡La tarea de Tabetha‡La tarea de Tabetha‡La mission de Tabetha‡塔贝萨的任务‡塔貝薩的任務',
    nil,
    'Fale com Tabetha no Pântano Vadeoso.‡Поговорите с Табетой в Пылевых топях.‡Sprecht mit Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사와 대화해야 합니다.‡Habla con Tabetha en el Marjal Revolcafango.‡Habla con Tabetha en el Marjal Revolcafango.‡Parler à Tabetha dans le marécage d\'Âprefange.‡与尘泥沼泽的塔贝萨谈一谈。‡與塵泥沼澤的塔貝薩談話。',
  }
},
[2862] = {
  {
    'Patábua mole em guerra dura‡Война с племенем Древолапов‡Krieg gegen die Waldpfoten‡덩굴발일족과의 전투‡En guerra con los Zarpaleña‡En guerra con los Zarpaleña‡La guerre avec les Griffebois‡与豺狼人开战‡與豺狼人開戰',
    nil,
    'Leve 10 Jubas de Gnoll Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Принесите 10 грив гноллов-древолапов Хадокену Быстрому Страннику в Лагере Мохаче.‡Bringt Hadoken Flinkschreiter im Camp Mojache 10 Mähnen eines Waldpfotengnolls.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 갈기 10개를 가져가야 합니다.‡Lleva 10 cabelleras de gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Lleva 10 cabelleras de gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Rapportez 10 Crinières de gnolls Griffebois à Hadoken Rôdeur-agile, au Camp Mojache.‡将10份木爪豺狼人的鬃毛交给莫沙彻营地的哈杜肯·迅蹄。‡將10份木爪豺狼人的鬃毛交給莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[2863] = {
  {
    'Golpe Alfa‡Истребление вожаков‡Schlag gegen die Alphas‡우두머리 공격‡Ataca a los Alfas‡Ataca a los Alfas‡Frappe sur les Alphas‡突然袭击‡突然襲擊',
    nil,
    'Mate 5 Machos Alfa Patábua e fale novamente com Hadoken Passo Veloz em uma hora.‡Убейте в течение часа 5 вожаков стаи Древолапов и вернитесь к Хадокену Быстрому Страннику.‡Tötet 5 Alphas der Waldpfoten und kehrt innerhalb einer Stunde zu Hadoken Flinkschreiter zurück.‡1시간 안에 덩굴발일족 우두머리 5마리를 처치하고 아도겐 스위프트스트라이더에게 되돌아와야 합니다.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zanco Veloz en 1 hora.‡Mata a 5 Alfas Zarpaleña y vuelve con Hadoken Zanco Veloz en 1 hora.‡Tuer 5 Alphas Griffebois et retourner voir Hadoken Rôdeur-agile en moins d\'une heure.‡在1个小时内杀死5个木爪突击队员，并向哈杜肯·迅蹄汇报。‡在1個小時內殺死5個木爪突擊隊員，並向哈杜肯·迅蹄彙報。',
  }
},
[2864] = {
  {
    'Tran\'rek‡Тран\'рек‡Tran\'rek‡트란렉‡Tran\'rek‡Tran\'rek‡Tran\'rek‡特兰雷克‡特蘭雷克',
    nil,
    'Fale com Tran\'rek em Geringontzan.‡Поговорите с Тран\'реком в Прибамбасске.‡Sprecht mit Tran\'rek in Gadgetzan.‡가젯잔에 있는 트란렉과 대화해야 합니다.‡Habla con Tran\'rek en Gadgetzan.‡Habla con Tran\'rek en Gadgetzan.‡Parler à Tran\'rek à Gadgetzan.‡与加基森的特兰雷克谈一谈。‡與加基森的特蘭雷克談話。',
  }
},
[2865] = {
  {
    'Couraças de escaravelho‡Панцири скарабеев‡Skarabäuspanzerschalen‡왕쇠똥구리 껍질‡Caparazones de escarabajo‡Caparazones de escarabajo‡Les carapaces de scarabées‡圣甲虫的壳‡聖甲蟲的殼',
    nil,
    'Leve 5 Couraças de Escaravelho Fechadas para Tran\'rek em Geringontzan.‡Принести 5 целых панцирей скарабея Тран\'реку в Прибамбасск.‡Bringt Tran\'rek in Gadgetzan 5 unbeschädigte Skarabäuspanzerschalen.‡가젯잔에 있는 트란렉에게 온전한 왕쇠똥구리 껍질 5개를 가져가야 합니다.‡Lleva 5 caparazones de escarabajo sin rajar a Tran\'rek en Gadgetzan.‡Lleva 5 caparazones de escarabajo sin rajar a Tran\'rek en Gadgetzan.‡Rapporter 5 Carapaces de scarabée intactes à Tran\'rek à Gadgetzan.‡给加基森的特兰雷克带去5个完整的圣甲虫壳。‡帶5個完整的聖甲蟲殼給加基森的特蘭雷克。',
  }
},
[2866] = {
  {
    'As Ruínas de Solarsal‡Руины Соларсаля‡Die Ruinen von Solarsal‡솔라살 폐허‡Las Ruinas de Solarsal‡Las Ruinas de Solarsal‡Les ruines de Solarsal‡索兰萨尔废墟‡索蘭薩爾廢墟',
    nil,
    'Explore as Ruínas de Solarsal e investigue a presença das nagas.‡Обследуйте руины Соларсаля на предмет присутствия наг.‡Erforscht die Ruinen von Solarsal und findet etwas über die Anwesenheit der Naga dort heraus.‡솔라살 폐허를 탐사하고 그곳에 있는 나가의 실태를 조사해야 합니다.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explora las Ruinas de Solarsal e investiga la presencia de los nagas allí.‡Explorer les ruines de Solarsal et enquêter sur la présence des nagas dans le secteur.‡探索索兰萨尔废墟，并调查纳迦在那个地区的情况。‡探索索蘭薩爾廢墟，並調查納迦在那個地區的情況。',
  }
},
[2867] = {
  {
    'Regresso ao Domínio de Plumaluna‡Возвращение в Крепость Оперенной Луны‡Kehrt zur Mondfederfeste zurück‡페더문 요새로 돌아가기‡Regresa al Bastión Plumaluna‡Regresa al Bastión Plumaluna‡Retourner au bastion de Pennelune‡返回羽月要塞‡返回羽月要塞',
    nil,
    'Fale novamente com Shandris Plumaluna no Domínio de Plumaluna e relate suas descobertas.‡Вернитесь в Крепость Оперенной Луны к Шандрисе Оперенной Луне и доложите о находке.‡Kehrt zu Shandris Mondfeder in der Mondfederfeste zurück und berichtet von Euren Entdeckungen.‡페더문 요새에 있는 샨드리스 페더문에게 돌아가 발견한 것에 대해 보고해야 합니다.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Vuelve al Bastión Plumaluna e informa a Shandris Plumaluna del resultado de tu exploración.‡Retourner voir Shandris Pennelune au bastion de Pennelune et lui rendre compte de vos découvertes.‡向羽月要塞的珊蒂斯·羽月汇报你的发现。‡向羽月要塞的珊蒂斯·羽月彙報你的發現。',
  }
},
[2868] = {
  {
    '<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart‡<TXT> The Shriveled Heart',
    nil,
    nil,
  }
},
[2869] = {
  {
    'Cruzada contra as Cristafúrias‡Борьба с Гребнем Ненависти‡Gegen die Hasskämme‡증오의갈기일족과의 전투‡En contra de los Crestafuria‡En contra de los Crestafuria‡Contre les Hainecrête‡憎世纳迦之战‡憎世納迦之戰',
    nil,
    'Leve 10 Escamas de Naga Cristafúria para Latrônicus Lunalança no Domínio de Plumaluna.‡Принесите 10 штук чешуи наг из клана Гребня Ненависти Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Bringt Latronicus Mondspeer in der Mondfederfeste 10 Nagaschuppen der Hasskämme.‡페더문 요새에 있는 라트로니쿠스 문스피어에게 증오의갈기 나가 비늘 10개를 가져가야 합니다.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Consigue 10 escamas de naga Crestafuria para Latronicus Lanzaluna en el Bastión Plumaluna.‡Rapporter 10 Ecailles de naga Hainecrête à Latronicus Lancelune au bastion de Pennelune.‡收集10块憎世纳迦的鳞片，把它们交给羽月要塞的拉托尼库斯·月矛。‡收集10塊憎世納迦的鱗片，把它們交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2870] = {
  {
    'Contra o Lorde Shalzaru‡Борьба с лордом Шалзару‡Gegen Lord Shalzaru‡군주 샬자루와의 전투‡En contra de Lord Shalzaru‡En contra de Lord Shalzaru‡Contre le seigneur Shalzaru‡击败沙尔扎鲁‡擊敗沙爾札魯領主',
    nil,
    'Elimine o Lorde Shalzaru, e depois leve a Relíquia Misteriosa que ele desencavou a Latrônicus Lunalança no Domínio de Plumaluna.‡Убейте лорда Шалзару и принесите обнаруженную им таинственную реликвию Латроникусу Лунному Копью в Крепость Оперенной Луны.‡Vernichtet Lord Shalzaru und bringt dann Latronicus Mondspeer in der Mondfederfeste das geheimnisvolle Relikt, das er entdeckt hat.‡군주 샬자루를 처치하고 그가 찾아낸 신비한 유물을 페더문 요새에 있는 라트로니쿠스 문스피어에게 가져가야 합니다.‡Elimina a Lord Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Elimina a Lord Shalzaru y luego lleva la reliquia misteriosa que desenterró a Latronicus Lanzaluna al Bastión Plumaluna.‡Éliminer le seigneur Shalzaru et rapporter la Mystérieuse relique qu\'il a découverte à Latronicus Lancelune au bastion de Pennelune.‡消灭沙尔扎鲁，然后把神秘遗物交给羽月要塞的拉托尼库斯·月矛。‡消滅沙爾札魯領主，然後把神秘聖物交給羽月要塞的拉托尼庫斯·月矛。',
  }
},
[2871] = {
  {
    'A entrega da relíquia‡Доставка реликвии‡Überbringung des Relikts‡유물 전달‡Entrega la reliquia‡Entrega la reliquia‡Livraison de la relique‡递送遗物‡遞送聖物',
    nil,
    'Entregue a Relíquia Misteriosa a Véstia Lançaluna no Domínio de Plumaluna.‡Доставьте таинственную реликвию Вестии Лунное Копье в Крепость Оперенной Луны.‡Bringt das geheimnisvolle Relikt zu Vestia Mondspeer in der Mondfederfeste.‡페더문 요새에 있는 베스티아 문스피어에게 신비한 유물을 가져가야 합니다.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Entrega la reliquia misteriosa a Vestia Lanzaluna que está en el Bastión Plumaluna.‡Porter la Relique mystérieuse à Vestia Lancelune au bastion de Pennelune.‡将神秘遗物交给羽月要塞的维斯提亚·月矛。‡將神秘聖物交給羽月要塞的維斯提亞·月矛。',
  }
},
[2872] = {
  {
    'A dívida de Esmirno‡Долг Столи‡Stoleys Schuld‡스톨리의 빚‡La deuda de Stoley‡La deuda de Stoley‡Les dettes de Stoley‡斯杜雷的债务‡斯杜雷的債務',
    nil,
    'Fale com Esmirno no Porto de Bondebico.‡Поговорите со Столи из Порта Картеля.‡Sprecht mit Stoley beim Dampfdruckpier.‡스팀휘들 항구에 있는 스톨리와 대화해야 합니다.‡Habla con Stoley en el Puerto Bonvapor.‡Habla con Stoley en el Puerto Bonvapor.‡Parler à Stoley, à Port Gentepression.‡与热砂港的斯杜雷谈一谈。‡與熱砂港的斯杜雷談話。',
  }
},
[2873] = {
  {
    'Carregamento do Esmirno‡Посылка Столи‡Stoleys Lieferung‡스톨리의 뱃짐‡El envío de Stoley‡El envío de Stoley‡La cargaison de Stoley‡斯杜雷的货物‡斯杜雷的貨物',
    nil,
    'Leve o Carregamento do Esmirno para Esmirno no Porto de Bondebico.‡Отыщите партию товара Столи и возвратите ее хозяину в Порт Картеля.‡Bringt Stoleys Lieferung zu Stoley beim Dampfdruckpier.‡스팀휘들 항구에 있는 스톨리에게 뱃짐을 찾아다 주어야 합니다.‡Llévale el envío de Stoley a Stoley, que está en el Puerto Bonvapor.‡Llévale el envío de Stoley a Stoley, que está en el Puerto Bonvapor.‡Apportez la Cargaison de Stoley à Port Gentepression et remettez-la à Stoley.‡将斯杜雷的货物交给热砂港的斯杜雷。‡將斯杜雷的貨物交給熱砂港的斯杜雷。',
  }
},
[2874] = {
  {
    'Entrega para MacKinley‡Ром для Маккинли‡Lieferung für MacKinley‡맥킨리에게 배달‡Un envío para MacKinley‡Un envío para MacKinley‡Livraison à MacKinley‡给马克基雷的货物‡給麥克基雷的貨物',
    nil,
    'Leve uma Garrafa do Esmirno para MacKinley "Lobo do Mar" na Angra do Butim.‡Отнесите бутылку Столи "Морскому волку" МакКинли в Пиратскую Бухту.‡Bringt Stoleys Flasche zu "Seewolf" MacKinley in Beutebucht.‡무법항에 있는 "바다늑대" 맥킨리에게 칼림도어산 럼주가 든 스톨리의 병을 가져가야 합니다.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, en Bahía del Botín.‡Llévale la botella de Stoley a "Lobo de Mar" MacKinley, en Bahía del Botín.‡Porter la Bouteille de Stoley à MacKinley "Loup des mers" à Baie-du-Butin.‡将斯杜雷的瓶子交给藏宝海湾的"海狼"马克基雷。‡將斯杜雷的瓶子交給藏寶海灣的『海狼』麥克基雷。',
  }
},
[2875] = {
  {
    'PROCURA-SE: André Barbarruiva‡Разыскивается: Андре Огнебородый‡GESUCHT: Andre Feuerbart‡현상 수배: 앙드레 파이어비어드‡SE BUSCA: Andre Barbafuego‡SE BUSCA: Andre Barbafuego‡ON RECHERCHE : André Barbe-en-feu‡通缉：安德雷·费尔比德‡懸賞:安德雷·火鬍',
    nil,
    'Leve a Cabeça do André ao Chefe de Segurança Silvadágua no Porto de Bondebico.‡Принесите голову Андре Огнебородого начальнику отдела безопасности Чепухастеру в Порт Картеля.‡Bringt Sicherheitschef Bilgenritzel beim Dampfdruckpier Andres Kopf.‡앙드레를 처치하고 그 증거로 그의 머리카락을 스팀휘들 항구에 있는 보안과장 빌지위즐에게 가져가야 합니다.‡Llévale la cabeza de Andre al jefe de seguridad Pasaquillas, que está en el Puerto Bonvapor.‡Llévale la cabeza de Andre al jefe de seguridad Pasaquillas, que está en el Puerto Bonvapor.‡Rapportez la tête d\'André au Chef de la sécurité Vizisanie, à Port Gentepression.‡将安德雷的徽记交给热砂港的安全主管吉罗姆·比格维兹。‡將安德雷的頭顱交給熱砂港的安全主管膨嘯。',
  }
},
[2876] = {
  {
    'Cronograma de Navios‡Расписание кораблей‡Schiffzeitpläne‡선적 일정표‡El registro náutico‡El registro náutico‡Horaires des bateaux‡船运时刻表‡船運時刻表',
    nil,
    'Apresente o Cronograma de Navios a uma autoridade do Porto de Bondebico.‡Сообщите о корабельном расписании руководству Порта Картеля.‡Berichtet den Behörden des Dampfdruckpiers von den Schiffzeitplänen.‡스팀휘들 항구의 관계자에게 선적 일정표에 대해 보고해야 합니다.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Informa del registro de envíos a alguna autoridad del Puerto Bonvapor.‡Présenter les Horaires des bateaux aux autorités de Port Gentepression.‡把船运时刻表交给热砂港的某个官员。‡把船運時刻表交給熱砂港的某個官員。',
  }
},
[2877] = {
  {
    'Limpeza na Rocha Oculta‡Зачистка Осклизлой скалы‡Den Lauerfels aufräumen‡굼벵이 바위굴 청소‡La limpieza de Roca Oculta‡La limpieza de Roca Oculta‡Nettoyer le rocher de l\'Affût‡清理隐匿石‡清理隱匿石',
    nil,
    'Mate 10 Lodos Verdes e 10 Gosmas Jade, depois apresente-se novamente a Explodar Mantrovejante no Ninho da Águia.‡Убейте 10 зеленых слякочей и 10 нефритовых слизнюков, после чего доложитесь Фраггару Громовой Мантии, который ждет вас на Заоблачном пике.‡Tötet 10 grüne Schlicke sowie 10 jadegrüne Schlamme und meldet Euch dann wieder bei Fraggar Donnermantel beim Nistgipfel.‡녹색 녹괴물 10마리와 비취 수액괴물 10마리를 처치한 후 맹금의 봉우리에 있는 프라가르 썬더맨틀에게 돌아와 보고해야 합니다.‡Mata 10 lodos verdes y 10 mocos de jade e informa a Fraggar Mantrueno en Pico Nidal.‡Mata 10 lodos verdes y 10 mocos de jade e informa a Fraggar Mantrueno en Pico Nidal.‡Tuer 10 Limaces vertes et 10 Limons de jade puis faire votre rapport à Fraggar Tonnemante au Nid-de-l\'Aigle.‡杀掉10个绿色淤泥怪和10个玉石软泥怪，然后回到鹰巢山向弗拉加尔报告。‡殺掉10個綠色軟泥怪和10個玉石軟泥怪，然後回到鷹巢山向弗拉加爾報告。',
  }
},
[2878] = {
  {
    'Flor da Canção corrompida‡Оскверненный песнецвет‡Verderbte Liedblume‡오염된 노래꽃‡Melodía corrupta‡Melodía corrupta‡La fleur-de-chant corrompue‡被腐化的轻歌花‡被腐化的輕歌花',
    nil,
    nil,
  }
},
[2879] = {
  {
    'O Báculo de Equinex‡Посох равноденствия‡Der Stock von Equinex‡에퀴넥스의 지팡이‡El báculo de Equinex‡El báculo de Equinex‡Le Bâton d\'Equinex‡艾奎尼克斯法杖‡艾奎尼克斯法杖',
    nil,
    'Energize o Báculo de Troya e encontre o Monolito de Equinex.‡Зарядите посох Трояса и отыщите Монолит Равноденствия.‡Aktiviert Troyas Stock und findet den Monolithen von Equinex.‡트로야스의 지팡이에 힘을 불어넣고 에퀴넥스 비석탑을 찾아야 합니다.‡Energiza el báculo de Troyas y encuentra el Monolito de Equinex.‡Energiza el báculo de Troyas y encuentra el Monolito de Equinex.‡Dynamiser le Bâton de Troyas et trouver le Monolithe d\'Equinex.‡给特洛亚斯的法杖注入能量，并找到艾奎尼克斯石碑。‡給特洛亞斯的法杖注入能量，並找到艾奎尼克斯石碑。',
  }
},
[2880] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse au collier troll‡巨魔部族项链‡食人妖部族項鍊',
    nil,
    'Leve 5 Colares Tribais Troll para Explodar Mantrovejante no Ninho da Águia.‡Принесите 5 тролльих ожерелий Фраггару Громовой Мантии на Заоблачный пик.‡Bringt Fraggar Donnermantel beim Nistgipfel 5 Trollstammeshalsketten.‡맹금의 봉우리에 있는 프라가르 썬더맨틀에게 트롤 전통 목걸이 5개를 가져다주어야 합니다.‡Lleva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Lleva 5 collares tribales trol a Fraggar Mantrueno a Pico Nidal.‡Rapporter 5 Colliers tribaux trolls à Fraggar Tonnemante au Nid-de-l\'Aigle.‡给鹰巢山的弗拉加尔带去5条巨魔部族项链。‡給鷹巢山的弗拉加爾帶去5條食人妖部族項鍊。',
  }
},
[2881] = {
  {
    'Recompensa dos colares trólicos‡Ожерелья троллей‡Kopfgeld für Trollhalsketten‡트롤 목걸이 현상금‡Los collares de trols‡Los collares de trols‡Chasse aux colliers trolls‡巨魔部族项链‡食人妖部族項鍊',
    nil,
    nil,
  }
},
[2882] = {
  {
    'Cuergo Ouro‡Золото Куэрго‡Cuergos Gold‡쿠에르고 골드‡El oro de Cuergo‡El oro de Cuergo‡L\'or de Cuergo‡科尔戈的黄金‡科爾戈的黃金',
    nil,
    'Encontre o ouro de Cuergo!‡Найдите золото Куэрго!‡Findet Cuergos Gold!‡쿠에르고 골드를 찾아야 합니다.‡¡Encuentra el oro de Cuergo!‡¡Encuentra el oro de Cuergo!‡Trouvez l\'or de Cuergo !‡找到科尔戈的黄金！‡找到科爾戈的黃金!',
  }
},
[2902] = {
  {
    'Investigação Patábua‡Разведка планов Древолапов‡Waldpfotennachforschung‡덩굴발일족 조사‡Investiga a los Zarpaleña‡Investiga a los Zarpaleña‡Enquête chez les Griffebois‡调查木爪岭‡調查木爪嶺',
    nil,
    'Encontre os Planos de Batalha Gnoll no acampamento dos Gnolls ao sul da Aldeia Mojache.‡Найдите гноллские боевые планы в гноллских лагерях к югу от Лагеря Мохаче.‡Findet die Schlachtpläne der Gnolle irgendwo in den Gnoll-Lagern südlich vom Camp Mojache.‡모자케 야영지 남쪽에 있는 놀 야영지에서 덩굴발일족 전투 계획서를 찾아야 합니다.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Encuentra los planes de batalla de los gnolls por los campamentos que hay al sur del Campamento Mojache.‡Trouver les Plans de bataille des gnolls dans les camps gnolls du sud du Camp Mojache.‡在莫沙彻营地以南的豺狼人营地中寻找豺狼人的战斗计划。‡在莫沙徹營地以南的豺狼人營地中尋找豺狼人的戰鬥計畫。',
  }
},
[2903] = {
  {
    'Os planos de batalha‡Планы битвы‡Die Schlachtpläne‡전투 계획서‡Los planes de batalla de los Zarpaleña‡Los planes de batalla‡Les plans de bataille‡作战计划‡作戰計畫',
    nil,
    'Leve os Planos de Batalha de Patábua para Hadoken Passo Veloz na Aldeia Mojache.‡Отнесите планы битвы Древолапов Хадокену Быстрому Страннику в Лагерь Мохаче.‡Bringt die Schlachtpläne der Waldpfoten zu Hadoken Flinkschreiter ins Camp Mojache.‡모자케 야영지에 있는 아도겐 스위프트스트라이더에게 덩굴발일족 전투 계획서를 가지고 가야 합니다.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Lleva los planes de batalla de los gnolls Zarpaleña a Hadoken Zanco Veloz al Campamento Mojache.‡Apportez les Plans de bataille des Griffebois à Hadoken Rôdeur-agile au Camp Mojache.‡把木爪豺狼人的作战计划交给莫沙彻营地的哈杜肯·迅蹄。‡把木爪豺狼人的作戰計畫交給莫沙徹營地的哈杜肯·迅蹄。',
  }
},
[2904] = {
  {
    'Uma bela bagunça‡Катавасия‡Eine schöne Bescherung‡곤경에 빠진 케르노비‡Un buen lío‡Un buen lío‡Une jolie pagaille‡一团混乱‡一團混亂',
    nil,
    'Escolte Kernobill até a saída do Corredor dos Mecanismos, depois apresente-se a Scooty na Angra do Butim.‡Отведите Керноби к Часовому ходу. Затем отправляйтесь с донесением к Скути в Пиратскую Бухту.‡Begleitet Kernobee zur Uhrwerkgasse und meldet Euch dann wieder bei Scooty in Beutebucht.‡태엽장치 통로 입구까지 케르노비를 호위한 후 무법항에 있는 스쿠티에게 가서 보고해야 합니다.‡Acompaña a Kernobee a La Rampa del Engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Acompaña a Kernobee a La Rampa del Engranaje y luego ve a ver a Scooty a Bahía del Botín.‡Escorter Kernobee jusqu\'à la sortie de la Fuite du temps, puis faire un rapport à Scooty, à Baie-du-Butin.‡将克努比护送到出口，然后向藏宝海湾的斯库提汇报。‡將克努比護送到發條小徑的出口，然後向藏寶海灣的斯庫提彙報。',
  }
},
[2922] = {
  {
    'Salve o cérebro do Tecnobô!‡Промыть мозг Техботу‡Rettet Techbots Hirn!‡고장난 첨단로봇 수리‡¡Salva el cerebro de Tecnobot!‡¡Salva el cerebro de Tecnobot!‡Sauver le cerveau de Techbot !‡拯救尖端机器人！‡拯救尖端機器人!',
    nil,
    'Leve o Núcleo de Memória do Tecnobô para o Mestre-faz-tudo Superchispa em Altaforja.‡Принесите ядро памяти Техбота мехмастеру Замыкальцу в Стальгорн.‡Bringt Techbots Speicherkern zu Tüftlermeister Oberfunks nach Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크에게 첨단로봇의 기억회로를 가져가야 합니다.‡Lleva el procesador central de memoria del techrobot al maestro manitas Sobrechispa a Forjaz.‡Lleva el procesador central de memoria del Tecnobot al maestro manitas Sobrechispa a Forjaz.‡Rapportez la Mémoire principale de Techbot au maître-artisan Suprétincelle à Forgefer.‡将尖端机器人的存储器核心交给铁炉堡的工匠大师欧沃斯巴克。‡將尖端機器人的記憶體核心交給鐵爐堡的技工大師歐沃斯巴克。',
  }
},
[2923] = {
  {
    'Mestre-faz-tudo Superchispa‡Мехмастер Замыкалец‡Tüftlermeister Oberfunks‡수석땜장이 오버스파크‡Maestro manitas Sobrechispa‡Maestro manitas Sobrechispa‡Maître-bricoleur Suprétincelle‡工匠大师欧沃斯巴克‡技工大師歐沃斯巴克',
    nil,
    'Fale com o Mestre-faz-tudo Superchispa em Altaforja.‡Поговорите с механомастером Большой Искрой.‡Sprecht mit Tüftlermeister Oberfunks in Eisenschmiede.‡아이언포지에 있는 수석땜장이 오버스파크와 대화해야 합니다.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Habla con el maestro manitas Sobrechispa en Forjaz.‡Parler au maître-artisan Suprétincelle à Forgefer.‡与铁炉堡的工匠大师欧沃斯巴克谈一谈。‡與鐵爐堡的技工大師歐沃斯巴克談話。',
  }
},
[2924] = {
  {
    'Artifícios Essenciais‡Базовый элемент‡Grundlegende Artifixe‡필수 인공장치‡Esencias artificiales‡Esencias artificiales‡Les cerveaux mécaniques‡基础模组‡基礎模組',
    nil,
    'Leve 12 Artifícios Essenciais para Cronomorfus Espanafuso em Altaforja.‡Принесите 12 базовых элементов Клацморту Гайкокруту в Стальгорн.‡Bringt Klockmort Spannersplint in Eisenschmiede 12 grundlegende Artifixe.‡아이언포지에 있는 클락몰트 스패너스판에게 필수 인공장치 12개를 가져가야 합니다.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Lleva 12 esencias artificiales a Klockmort Palmalicate a Forjaz.‡Rapporter 12 Cerveaux mécaniques à Pléthorloge Cléventail à Forgefer.‡收集12个基础模组，把它们交给铁炉堡的科劳莫特·钢尺。‡收集12個基礎模組，把它們交給鐵爐堡的科勞莫特·鋼尺。',
  }
},
[2925] = {
  {
    'Os artifícios do Cronomorfus‡Базовые элементы Клацморта‡Klockmorts Grundlagen‡클락몰트에게 꼭 필요한 것‡Klockmort Palmalicate‡Klockmort Palmalicate‡Les cerveaux mécaniques de Pléthorloge‡帮助科劳莫特‡幫助科勞莫特',
    nil,
    'Fale com Cronomorfus Espanafuso em Altaforja.‡Поговорите с Клацмортом Гайкокрутом в Стальгорне.‡Sprecht mit Klockmort Spannersplint in Eisenschmiede.‡아이언포지에 있는 클락몰트 스패너스판과 대화해야 합니다.‡Habla con Klockmort Palmalicate en Forjaz.‡Habla con Klockmort Palmalicate en Forjaz.‡Parler à Pléthorloge Cléventail à Forgefer.‡与铁炉堡的科劳莫特·钢尺谈一谈。‡與鐵爐堡的科勞莫特·鋼尺談話。',
  }
},
[2926] = {
  {
    'Gnogaína‡Новая формула‡Gnogaine‡폐기물 수집‡Gnogaine‡Gnogaine‡Gnogaine‡诺恩‡諾恩',
    nil,
    'Use o Coletor de Chumbo Vazio nos Invasores Irradiados ou nos Pilhadores Irradiados para recolher resíduos radioativos. Depois que ele ficar cheio, leve-o de volta para Ozzie Mudavolt em Kharanos.‡Соберите радиоактивный осадок, оставляемый облученными захватчиками и облученными погромщиками в пустую освинцованную склянку для проб. Принесите наполненную склянку Оззи Триггервольту в Каранос.‡Sammelt mit der leeren bleiernen Sammelphiole radioaktive Ablagerungen bestrahlter Eindringlinge oder Plünderer. Sobald sie voll ist, bringt Ihr sie zu Ozzie Wechselvolt nach Kharanos zurück.‡빈 가연채집병에 오염된 침략꾼이나 오염된 약탈자에게서 얻은 방사성 폐기물을 담아야 합니다. 채집병이 가득 차면 카라노스에 있는 오지 토글볼트에게 가지고 가야 합니다.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Ozzie Voltiflop a Kharanos.‡Usa la ampolla de plomo con invasores o saqueadores radiactivos para recoger restos radiactivos. Cuando esté llena, llévasela a Ozzie Voltiflop a Kharanos.‡Utiliser la Flasque plombée vide sur les Envahisseurs ou les Pilleurs irradiés pour recueillir des retombées radioactives. Une fois pleine, rapportez-la à Ozzie Virevolt à Kharanos.‡用空铅瓶对着辐射入侵者或者辐射抢劫者，从它们身上收集放射尘。瓶子装满之后，把它交给卡拉诺斯的奥齐·电环。‡用空著的鉛之瓶對著輻射入侵者或者輻射掠取者，從它們身上收集放射塵。瓶子裝滿之後，把它交給卡拉諾斯的奧齊·電環。',
  }
},
[2927] = {
  {
    'O dia seguinte‡На другой день‡Der Tag danach‡그날 이후‡Al día siguiente‡Al día siguiente‡Le jour d\'après‡灾难之后‡災難之後',
    nil,
    'Speak with Ozzie Togglevolt at Kharanos in Dun Morogh.‡Поговорите с Оззи Триггервольтом в Караносе, что в Дун Мороге.‡Sprecht mit Ozzie Wechselvolt in Kharanos in Dun Morogh.‡던 모로의 카라노스에 있는 오지 토글볼트와 대화해야 합니다.‡Ve a hablar con Ozzie Voltiflop en Kharanos, en Dun Morogh.‡Ve a hablar con Ozzie Voltiflop en Kharanos, en Dun Morogh.‡Parler à Ozzie Virevolt à Kharanos, en Dun Morogh.‡与丹莫罗中卡拉诺斯的奥齐·电环谈一谈。‡前往丹莫洛的卡拉諾斯與奧齊·電環談話。',
  }
},
[2928] = {
  {
    'Escavacionadores girobrocamáticos‡Сооружение автогиробуророек‡Gyrobohrmatische Exkavation‡회전천공식 발굴기‡Excavadoras gyroagujereamáticas‡Excavadoras gyroagujereamáticas‡Excavateurs gyrodrilmatiques‡陀螺式挖掘机‡陀螺式挖掘機',
    nil,
    'Leve 24 Tripas Mecanobóticas para Shoni em Ventobravo.‡Принесите Шони в Штормград 24 горсти механических внутренностей роботов.‡Bringt 24 robomechanische Innereien zu Shoni nach Sturmwind.‡스톰윈드에 있는 쇼니에게 기계장치 부속품 24개를 가져가야 합니다.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Lleva veinticuatro entrañas robomecánicas a Shoni en Ventormenta.‡Apportez 24 Entrailles mécaniques de robot à Shoni, à Hurlevent.‡收集24副机械内胆，把它们交给暴风城的舒尼。‡收集24副機械內膽，把它們交給暴風城的舒尼。',
  }
},
[2929] = {
  {
    'A grande traição‡Великое предательство‡Der große Verrat‡대배반‡La gran traición‡La gran traición‡La grande trahison‡大叛徒‡大叛徒',
    nil,
    'Vá para Gnomeregan e mate o Mecangenheiro Termaplugue. Fale novamente com o Grão-faz-tudo Mekkatorque depois que tiver terminado a tarefa.‡Отправляйтесь в Гномреган и убейте Анжинера Термоштепселя. Вернитесь к главному механику Меггакруту.‡Reist nach Gnomeregan und tötet Robogenieur Thermadraht. Kehrt zu Hochtüftler Mekkadrill zurück, wenn der Auftrag ausgeführt ist.‡놈리건으로 가서 기계박사 텔마플러그를 처치해야 합니다. 임무가 끝나면 땜장이왕 멕카토크에게 돌아와야 합니다.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Ve a Gnomeregan y mata al mekigeniero Termochufe. Ve a ver al Manitas Mayor Mekkatorque cuando hayas terminado.‡Aller à Gnomeregan et tuer le mekgénieur Thermojoncteur. Puis retourner voir le Grand Bricoleur Mekkanivelle.‡到诺莫瑞根去杀掉麦克尼尔·瑟玛普拉格。完成任务之后向大工匠梅卡托克报告。‡到諾姆瑞根去殺掉機電師瑟瑪普拉格。完成任務之後向大工匠梅卡托克報告。',
  }
},
[2930] = {
  {
    'O resgate dos dados‡Спасение данных‡Datenrettung‡자료 회수‡Rescatar los datos‡Rescatar los datos‡Sauvetage de données‡抢救数据‡搶救資料',
    nil,
    'Leve o Cartão Perfurado Prismático para o Mestre Mecânico Fundecano em Altaforja.‡Принесите радужную перфокарту главному механику Чугунотрубзу в Стальгорн.‡Bringt Mechanikermeister Gussmuff in Eisenschmiede eine Prismalochkarte.‡아이언포지에 있는 수석수리공 캐스트파이프에게 오색 천공 카드를 가져가야 합니다.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Lleva una tarjeta perforada prismática al maestro mecánico Funditubo a Forjaz.‡Apporter une Carte perforée prismatique au Maître mécanicien Fontuyau, à Forgefer.‡将彩色穿孔卡片交给铁炉堡的大机械师卡斯派普。‡將稜彩穿孔卡片交給鐵爐堡的大技師卡斯派普。',
  }
},
[2931] = {
  {
    'A tarefa do Fundecano‡Поручение Чугонотрубза‡Gussmuffs Auftrag‡캐스트파이프의 임무‡Trabajar para Funditubo‡Trabajar para Funditubo‡Du travail pour Fontuyau‡卡斯派普的任务‡卡斯派普的任務',
    nil,
    'Fale com o Mestre Mecânico Fundecano em Altaforja.‡Поговорите с главным механиком Чугунотрубзом в Стальгорне.‡Sprecht mit Mechanikermeister Gussmuff in Eisenschmiede.‡아이언포지에 있는 수석수리공 캐스트파이프와 대화해야 합니다.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Habla con el maestro mecánico Funditubo en Forjaz.‡Parler au Maître mécanicien Fontuyau, à Forgefer.‡与铁炉堡的大机械师卡斯派普谈一谈。‡與鐵爐堡的大技師卡斯派普談話。',
  }
},
[2932] = {
  {
    'Recado sinistro‡Предупреждение‡Grausige Botschaft‡준엄한 메시지‡Un mensaje siniestro‡Un mensaje siniestro‡Sinistre message‡可怕的消息‡可怕的消息',
    nil,
    'Recolha Crânios de Cascasseca e leve o Pique de Nimboya. Finque o Pique de Nimboya Repleto em uma das Aldeias Cascasseca nas Terras Agrestes, depois fale novamente com Nimboya na Selva do Espinhaço.‡Соберите черепа троллей из племени Сухокожих и насадите их на пику Нимбойи, после чего установите пику с тролльими черепами в центре одной из их деревень во Внутренних землях и возвращайтесь к Нимбойе в Тернистую долину.‡Sammelt Schädel der Bleichborken und hängt sie an Nimboyas Pike. Platziert Nimboyas behängte Pike in einem der Bleichborkendörfer im Hinterland und kehrt dann zu Nimboya ins Schlingendorntal zurück.‡동부 내륙지에서 마른나무껍질부족 해골을 모은 후, 님보야의 창을 동부 내륙지에 있는 마른나무껍질 마을 중 한곳에 박아 놓아야 합니다. 그런 다음 가시덤불 골짜기에 있는 님보야에게 돌아가십시오.‡Recoge cráneos Secacorteza y luego clava la pica cargada de Nimboya en uno de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Recoge cráneos Secacorteza y luego clava la pica cargada de Nimboya en uno de los poblados Secacorteza, en las Tierras del Interior. Luego ve a ver a Nimboya a Tuercespina.‡Collecter des Crânes de Fânécorce et les placer sur la Pique de Nimboya. Poser la Pique de Nimboya préparée dans l\'un des Villages Fânécorce, dans les Hinterlands, puis retourner voir Nimboya, à Strangleronce.‡在辛特兰收集枯木巨魔的头皮，把它们串在尼姆布亚之矛上。将尼姆布亚的长矛插在辛特兰的某个枯木巨魔村庄中，然后回到荆棘谷的尼姆布亚那里。‡在辛特蘭收集枯木食人妖的頭皮，把它們串在尼姆布亞之矛上。將尼姆布亞的長矛插在辛特蘭的某個枯木食人妖村莊中，然後回到荊棘谷的尼姆布亞那裡。',
  }
},
[2933] = {
  {
    'Garrafas de peçonha‡Бутыли с ядом‡Giftflaschen‡독병‡Botellas de veneno‡Botellas de veneno‡Bouteilles de venin‡毒液瓶‡毒液瓶',
    nil,
    'Leve uma Garrafa de Peçonha para um boticário na Serraria Tarren.‡Принесите бутылку яда аптекарю в Мельницу Таррен.‡Bringt eine Giftflasche zu einem Apotheker nach Tarrens Mühle.‡타렌 밀농장에 있는 연금술사에게 독병을 가져가야 합니다.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Lleva una botella de veneno a algún boticario de Molino Tarren.‡Apporter une Bouteille de venin à un apothicaire, à Moulin-de-Tarren.‡将毒药瓶交给塔伦米尔的某个药剂师。‡將毒藥瓶交給塔倫米爾的某個藥劑師。',
  }
},
[2934] = {
  {
    'Vesícula de peçonha intacta‡Неповрежденная ядовитая железа‡Unbeschädigter Giftbeutel‡온전한 독주머니‡Glándula de veneno intacta‡Glándula de veneno intacta‡Glande à venin intacte‡完好无损的毒囊‡完好無損的毒囊',
    nil,
    'Leve a Vesícula de Peçonha Intacta para o Boticário Lindolfo na Serraria Tarren.‡Принесите неповрежденную ядовитую железу аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle einen unbeschädigten Giftbeutel.‡타렌 밀농장에 있는 연금술사 라이던에게 온전한 독주머니를 가져가야 합니다.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Lleva una glándula de veneno intacta al boticario Lydon de Molino Tarren.‡Rapporter une Glande à venin intacte à l\'Apothicaire Lydon, à Moulin-de-Tarren.‡将完好无损的毒囊交给塔伦米尔的药剂师林度恩。‡將完好無損的毒囊交給塔倫米爾的藥劑師林度恩。',
  }
},
[2935] = {
  {
    'Consulte o Mestre Gadrin‡Разговор с мастером Гадрином‡Konsultiert Meister Gadrin‡가드린 장로와 상의‡Consulta al maestro Gadrin‡Consulta al maestro Gadrin‡Consulter Maître Gadrin‡请教加德林大师‡請教加德林大師',
    nil,
    'Fale com o Mestre Gadrin na Aldeia Sen\'jin.‡Поговорите с мастером Гадрином в деревне Сен\'джин.‡Sprecht mit Meister Gadrin in Sen\'jin.‡센진 마을에 있는 가드린 장로와 대화해야 합니다.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Habla con el maestro Gadrin en el Poblado Sen\'jin.‡Parler à Maître Gadrin au village de Sen\'jin.‡与森金村的加德林大师谈一谈。‡與森金村的加德林大師談話。',
  }
},
[2936] = {
  {
    'A deusa aranha‡Паучья богиня‡Der Spinnengott‡거미 신‡Diosa araña‡Diosa araña‡Le dieu-araignée‡蜘蛛之神‡蜘蛛之神',
    nil,
    'Leia a Tabuleta de Theka para descobrir o nome da deusa aranha dos Cascasseca, depois fale novamente com o Mestre Gadrin.‡Прочитайте надписи на табличке Теки, узнайте имя паучьей богини, которой поклоняются тролли из племени Сухокожих, а потом возвращайтесь к мастеру Гадрину.‡Lest von der Schrifttafel des Theka, um den Namen des Spinnengottes der Bleichborken zu erfahren, und kehrt dann zu Meister Gadrin zurück.‡데카의 서판을 읽고 마른나무껍질부족 거미 신의 이름을 알아낸 다음, 가드린 장로에게 돌아가십시오.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lee el nombre de la diosa araña de los Secacorteza en la tablilla de Theka y vuelve a ver al maestro Gadrin.‡Lire la Tablette de Theka pour connaître le véritable nom du dieu-araignée des Fânécorces, puis retourner voir Maître Gadrin.‡阅读塞卡石板，了解枯木巨魔的蜘蛛之神的名字，然后回到加德林大师那里。‡閱讀塞卡石板，瞭解枯木食人妖的蜘蛛之神的名字，然後回到加德林大師那裡。',
  }
},
[2937] = {
  {
    'Evocando Shadra‡Призыв Шадры‡Die Beschwörung von Shadra‡샤드라 소환‡Invocar a Shadra‡Invocar a Shadra‡L\'invocation de Shadra‡召唤沙德拉‡召喚沙德拉',
    nil,
    'Derrote Shadra no altar de Shadra\'Alor, depois leve o veneno para o Boticário Lindolfo na Serraria Tarren.‡Убейте Шадру у алтаря Шадра\'Алора и принесите ее яд аптекарю Лидону в Мельницу Таррен.‡Besiegt Shadra am Altar von Shadra\'Alor und bringt sein Gift zu Apotheker Lydon nach Tarrens Mühle.‡샤드라알로 제단에서 샤드라를 물리친 후, 그녀의 독을 타렌 밀농장에 있는 연금술사 라이던에게 가져가야 합니다.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Derrota a Shadra en el altar de Shadra\'Alor y lleva su veneno al boticario Lydon de Molino Tarren.‡Terrasser Shadra, à l\'autel de Shadra\'Alor, puis rapporter son venin à l\'Apothicaire Lydon, à Moulin-de-Tarren.‡在沙德拉洛祭坛上击败沙德拉，把它的毒液交给塔伦米尔的药剂师林度恩。‡在沙德拉洛祭壇上擊敗沙德拉，把它的毒液交給塔倫米爾的藥劑師林度恩。',
  }
},
[2938] = {
  {
    'Veneno para a Cidade Baixa‡Яд в Подгород‡Gift für Unterstadt‡언더시티로 독 가져가기‡Veneno para Entrañas‡Veneno para Entrañas‡Du venin pour Fossoyeuse‡送往幽暗城的毒药‡送往幽暗城的毒藥',
    nil,
    'Leve o Embrulho do Faranello para o Mestre-boticário Faranello na Cidade Baixa.‡Отнесите сверток опытному аптекарю Фаранеллу в Подгород.‡Bringt Faranells Päckchen zu Apothekermeister Faranell nach Unterstadt.‡언더시티에 있는 수석 연금술사 파라넬에게 파라넬의 소포를 가져가야 합니다.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Lleva el paquete al maestro boticario Faranell a Entrañas.‡Apporter le Colis de Faranell au maître apothicaire Faranell, à Fossoyeuse.‡将法拉尼尔的包裹交给幽暗城的大药剂师法拉尼尔。‡將法拉尼爾的包裹交給幽暗城的藥劑大師法拉尼爾。',
  }
},
[2939] = {
  {
    'Em busca de conhecimento‡В поисках знаний‡Auf der Suche nach Wissen‡지식을 찾아서‡La búsqueda del conocimiento‡La búsqueda del conocimiento‡En savoir plus‡寻找知识‡尋找知識',
    nil,
    'Fale com Daryn Aelumnis na Vila de Rut\'theran.‡Поговорите с Дарин Добрый Ветер в деревне Рут\'теран.‡Sprecht mit Daryn Leuchtwind im Dorf Rut\'theran.‡루테란 마을에 있는 다린 라이트윈드와 대화해야 합니다.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Habla con Daryn Brisela de la Aldea Rut\'theran.‡Parler à Daryn Calmevent, au village de Rut\'theran.‡与鲁瑟兰村的达蕾恩·轻风谈一谈。‡與魯瑟蘭村的達蕾恩·輕風談話。',
  }
},
[2940] = {
  {
    'Feralas: uma história‡"Фералас: История"‡Feralas: Ein historischer Abriss‡페랄라스의 역사‡Feralas: una historia‡Feralas: una historia‡Féralas : une histoire‡菲拉斯的历史‡菲拉斯的歷史',
    nil,
    'Peça o livro emprestado a Daryn Aelumnis.‡Попросите Дарин Добрый Ветер одолжить вам книгу.‡Fragt Daryn Leuchtwind, ob Ihr Euch ihr Buch ausleihen dürft.‡다린 라이트윈드에게 책을 빌려도 좋은지 물어봐야 합니다.‡Pide a Daryn Brisela que te preste su libro.‡Pide a Daryn Brisela que te preste su libro.‡Demander à Daryn Calmevent si vous pouvez emprunter son livre.‡如果你想借达蕾恩·轻风的书，要先得到她的允许。‡如果你想借達蕾恩·輕風的書，要先得到她的允許。',
  }
},
[2941] = {
  {
    'O empréstimo‡В обмен на книгу‡Der Borger‡사진기 대여‡El préstamo‡El préstamo‡Le prêt‡海龟照片‡海龜照片',
    nil,
    'Leve a carta para Crista Dapinote em Tanaris.‡Отнесите письмо Кургль Поскакушке в Танарис.‡Bringt den Brief zu Curgle Kurbelhüpf nach Tanaris.‡타나리스에 있는 커글 크랭크홉에게 짧은 쪽지를 가져가야 합니다.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Lleva esta carta a Curgle Saltamanivela a Tanaris.‡Apporter la lettre à Gruzouille Sautelevier, à Tanaris.‡把信交给塔纳利斯的克格尔·曲藤。‡把信交給塔納利斯的克格爾·曲藤。',
  }
},
[2942] = {
  {
    'A pedra matinal‡Завтрашний камень‡Der Morgenstein‡반짝이는 돌‡La Piedra del mañana‡La Piedra del mañana‡La Pierre du matin‡晨光石‡晨光石',
    nil,
    'Traga a Pedra Rutilante e o Báculo de Equinex para Troyas Brisaluna no Domínio de Plumaluna. ‡Верните искрящийся камень и посох Равноденствия Троясу Лунному Бризу в Крепость Оперенной Луны.‡Bringt den funkelnden Stein und den Stock von Equinex zu Troyas Mondhauch in die Mondfederfeste.‡페더문 요새에 있는 트로야스 문브리즈에게 반짝이는 돌과 에퀴넥스의 지팡이를 가져가야 합니다.‡Devuelve la piedra refulgente y el báculo de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Devuelve la piedra refulgente y el báculo de Equinex a Troyas Brisaluna que está en el Bastión Plumaluna.‡Rapporter la Pierre étincelante et le Bâton d\'Equinex à Troyas Lunebise, dans le bastion de Pennelune.‡将闪光的石头和艾奎尼克斯法杖交给羽月要塞的特洛亚斯·月风。‡將閃亮的石頭和艾奎尼克斯法杖交給羽月要塞的特洛亞斯·月風。',
  }
},
[2943] = {
  {
    'O retorno a Troyas‡Возвращение к Троясу‡Rückkehr zu Troyas‡트로야스에게 돌아가기‡Regresa junto a Troyas‡Regresa junto a Troyas‡Retourner voir Troyas‡向特洛亚斯回复‡向特洛亞斯回覆',
    nil,
    'Leve o livro para Troyas Brisaluna no Domínio de Plumaluna.‡Доставьте книгу Троясу Лунному Бризу в Крепость Оперенной Луны.‡Liefert das Buch bei Troyas Mondhauch in der Mondfederfeste ab.‡페더문 요새에 있는 트로야스 문브리즈에게 책을 가져가야 합니다.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Entrega el libro a Troyas Brisaluna en el Bastión Plumaluna.‡Apporter le livre à Troyas Lunebise, dans le bastion de Pennelune.‡把书交给羽月要塞的特洛亚斯·月风。‡把書交給羽月要塞的特洛亞斯·月風。',
  }
},
[2944] = {
  {
    'A Superinstantânea FX‡Супер-щёлк FX‡Der Superschnapper FX‡슈퍼 찰칵이 FX‡La Superinstantánea FX‡La Superinstantánea FX‡Le Preneur d\'images FX‡超级摄影器FX‡超級攝影器FX',
    nil,
    'Use a Superinstantânea FX para tirar uma foto da Gammerita, depois fale novamente com Daryn Aelumnis na Vila de Rut\'theran.‡Сделайте снимок Гаммериты с помощью "Супер-щёлк FX" и вернитесь к Дарин Добрый Ветер в деревне Рут\'теран.‡Benutzt den Superschnapper FX, um einen Schnappschuss von Gammerita zu machen, und kehrt dann zu Daryn Leuchtwind nach Rut\'theran zurück.‡슈퍼 찰칵이 FX로 감메리타의 즉석사진을 찍은 후, 루테란 마을에 있는 다린 라이트윈드에게 돌아가야 합니다.‡Utiliza la Superinstantánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliza la Superinstantánea FX para sacar una instantánea de Gammerita y luego vuelve a la Aldea Rut\'theran con Daryn Brisela.‡Utiliser le Preneur d\'images FX pour prendre un cliché de Gammerita, puis retourner voir Daryn Calmevent à Rut\'theran.‡用超级摄影器FX给加莫里塔拍张照片，然后把它交给鲁瑟兰村的达蕾恩·轻风。‡用超級攝影器FX給加莫里塔拍張照片，然後把它交給魯瑟蘭村的達蕾恩·輕風。',
  }
},
[2945] = {
  {
    'Anel Encardido‡Кольцо, покрытое грязью‡Schmutzverkrusteter Ring‡꼬질꼬질한 반지‡Un anillo sucio‡Un anillo sucio‡Anneau sali‡脏兮兮的戒指‡髒兮兮的戒指',
    nil,
    'Descubra uma maneira de remover a crosta de sujeira do Anel Encardido.‡Придумайте, как отчистить кольцо, покрытое грязью.‡Findet einen Weg, den schmutzverkrusteten Ring zu säubern.‡꼬질꼬질한 반지에서 찌꺼기를 제거할 방법을 찾아야 합니다.‡Encuentra la manera de limpiar el anillo sucio.‡Encuentra la manera de limpiar el anillo sucio.‡Trouver un moyen de nettoyer l\'Anneau sali.‡想方法把脏兮兮的戒指弄干净。‡想方法把髒兮兮的戒指弄乾淨。',
  }
},
[2946] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверить, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Apportez les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris, et cherchez les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷你白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯繫。',
  }
},
[2947] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡歸還戒指',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Vous pouvez soit garder l\'anneau, soit retrouver la personne désignée par les lettres qui sont gravées à l\'intérieur.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡你可以自己留著這枚戒指，或者按照戒指內側刻著的名字找到它的主人。',
  }
},
[2948] = {
  {
    'Aperfeiçoamento gnômico‡Гномское усовершенствование‡Gnomenverbesserungen‡노움의 실력 향상‡Mejora gnómica‡Mejora gnómica‡Amélioration gnomique‡侏儒的手艺‡地精的手藝',
    nil,
    'Entregue o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de prata para Didiê Du Mocó, em Altaforja.‡Принесите сверкающее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Талвашу дель Кисселю в Стальгорн.‡Bringt Talvash del Kissel in Eisenschmiede den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡아이언포지에 있는 탈바쉬 델 키젤에게 은괴 1개, 태마노 1개와 반짝이는 금반지와 30실버를 주어야 합니다.‡Lleva tu anillo de oro luminoso, 1 barra de plata, 1 ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Talvash del Kissel a Forjaz.‡Apporter l\'Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d\'argent à Talvash del Kissel, à Forgefer.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给铁炉堡的塔瓦斯德·基瑟尔。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給鐵爐堡的塔瓦斯德·基瑟爾。',
  }
},
[2949] = {
  {
    'Ficar ou não ficar... eis a questão!‡Возвращение кольца‡Die Rückkehr des Rings‡반지의 귀환‡La devolución del anillo‡La devolución del anillo‡Le retour de l\'anneau‡戒指归来‡歸還戒指',
    nil,
    'Você pode ficar com o anel ou achar a pessoa que faz a gravação no interior dele.‡Вы можеть оставить кольцо себе, а можете попытаться найти того, чьи инициалы выгравированы на внутренней стороне кольца.‡Ihr könnt den Ring entweder behalten oder die Person finden, die für die Prägung und Gravuren auf der Innenseite des Rings verantwortlich ist.‡반지를 그냥 가지거나, 반지 안쪽 부분에 새겨진 인장 자국의 주인을 찾아야 합니다.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Puedes quedarte el anillo o buscar a quien realizó los grabados de la parte interior.‡Vous pouvez soit garder l\'anneau, soit retrouver la personne désignée par les lettres qui sont gravées à l\'intérieur.‡你要么自己留着这枚戒指，要么就按照戒指内侧刻着的名字找到它的主人。‡你要麼自己留著這枚戒指，要麼就按照戒指內側刻著的名字找到它的主人。',
  }
},
[2950] = {
  {
    'Recauchutagem do anel do Nogg‡Переделка кольца‡Noggs Ringerneuerung‡노그의 반지 수리‡Nogg mejora el anillo‡Nogg mejora el anillo‡Nogg améliore l\'anneau‡诺格的手艺‡諾格的手藝',
    nil,
    'Leve o Anel de Ouro Brilhante, uma Barra de Prata, uma Ágata Musgosa e 30 moedas de Prata para Nogg em Orgrimmar.‡Принесите сверкающее золотое кольцо, слиток серебра, моховой агат и 30 серебряных монет Ноггу в Огргиммар.‡Bringt Nogg in Orgrimmar den glänzenden Goldring, einen Silberbarren, einen Moosachat und 30 Silbermünzen.‡오그리마에 있는 노그에게 반짝이는 금반지, 은괴 1개, 태마노 1개, 30실버를 가져다주어야 합니다.‡Lleva tu anillo de oro luminoso, 1 barra de plata, 1 ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Lleva tu anillo de oro luminoso, una barra de plata, una ágata musgosa y 30 monedas de plata a Nogg a Orgrimmar.‡Apporter l\'Anneau d\'or brillant, une Barre d\'argent, une Agate mousse et 30 pièces d\'argent à Nogg, à Orgrimmar.‡将闪亮的金戒指、1块银锭、1块绿玛瑙和30个银币交给奥格瑞玛的诺格。‡將閃亮的金戒指、1塊銀錠、1塊綠瑪瑙和30個銀幣交給奧格瑪的諾格。',
  }
},
[2951] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡빤질빤질세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    'Coloque um Objeto Encardido e três moedas de prata na Brastematic 5200 para iniciar o processo de limpeza.‡Опустите покрытый грязью предмет и три серебряные монеты в Чистер 5200.‡Gebt einen schmutzverkrusteten Gegenstand in den Funkelmat 5200 und stellt sicher, dass Ihr drei Silbermünzen habt, um die Maschine zu aktivieren.‡빤질빤질세척기 5200에 꼬질꼬질한 물건을 넣으십시오. 3실버를 투입하면 작동할 것입니다.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Inserta un objeto con mugre incrustada en el Destellamatic 5200 y asegúrate de tener 3 monedas de plata a mano.‡Insérer un Objet sali dans le Brille-o-Matic 5200, sans oublier de jeter trois pièces d\'argent dans la fente, pour démarrer la machine.‡将脏兮兮的东西放入超级清洁器5200型，记得要用三枚银币来启动机器。‡將髒兮兮的東西放入超級清潔器5200型，記得要用三枚銀幣來啟動機器。',
  }
},
[2952] = {
  {
    'A Brastematic 5200!‡Чистер 5200!‡Der Funkelmat 5200!‡빤질빤질세척기 5200!‡¡El Destellamatic 5200!‡¡El Destellamatic 5200!‡Le Brille-o-Matic 5200 !‡超级清洁器5200型！‡超級清潔器5200型!',
    nil,
    nil,
  }
},
[2953] = {
  {
    'Brastematic FTW!‡Работа для Чистера‡Mehr Spaß mit dem Funkelmaten‡빤질빤질세척기 재사용‡El Destellamatic en acción‡El Destellamatic en acción‡Le Brille-o-Matic décape encore‡再次使用超级清洁器‡再次使用超級清潔器',
    nil,
    nil,
  }
},
[2954] = {
  {
    'O vigia pétreo‡Каменный Страж‡Der Steinbehüter‡바위감시자‡El vigía de piedra‡El vigía de piedra‡Le Gardien des pierres‡石头卫士‡石之看守者',
    nil,
    'Descubra qual é o propósito do Vigia Pétreo de Norgannon, depois interaja com o Pedestal de Uldum no deserto de Tanaris.‡Узнайте назначение Каменного Стража Норганнона, затем коснитесь пьедестала Ульдума в пустыне Танарис.‡Findet den Zweck des Steinbehüters von Norgannon heraus und interagiert dann mit dem Podest von Uldum in der Tanariswüste.‡타나리스 사막에 있는 노르간논의 바위감시자와 대화한 후 울둠 대좌를 건드려야 합니다.‡Averigua qué quiere el vigía de piedra de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Averigua qué quiere el vigía de piedra de Norgannon y después interactúa con el pedestal de Uldum en el Desierto de Tanaris.‡Apprendre le but du Gardien des pierres de Norgannon, puis interagir avec le Piédestal d\'Uldum, dans le désert de Tanaris.‡询问诺甘农的石头卫士，搞清楚它要让你干什么，然后再次点击它脚下的奥丹姆石座。‡詢問諾甘農的石之看守者，搞清楚它要讓你幹什麼，然後再次點擊它腳下的奧丹姆石座。',
  }
},
[2962] = {
  {
    'A única cura é mais brilho verde‡Сильное зеленое свечение‡Das einzige Heilmittel ist mehr grünes Leuchten‡유일한 치료법‡Necesitamos más material verdoso‡Necesitamos más material verdoso‡Encore plus de Lueur verte !‡更多的辐射尘！‡更多的輻射塵!',
    nil,
    'Vá até Gnomeregan e traga o Resíduo Radioativo de Alta Potência. Tome cuidado, pois a radiação é instável e pode se esvair rapidamente.|n|nOzzie também vai precisar do seu Coletor de Chumbo Pesado quando tiver terminado.|n‡Отправляйтесь в Гномреган и принесите высокорадиоактивные образцы. Внимание: отходы нестабильны и довольно быстро разрушаются.|n|nВерните Оззи тяжелую освинцованную склянку для проб, когда задача будет выполнена.‡Reist nach Gnomeregan und bringt etwas von der hoch konzentrierten radioaktiven Ablagerung zurück. Seid gewarnt, die Ablagerung ist instabil und wird ziemlich schnell zerfallen.|n|nOzzie wird außerdem Eure schwere bleierne Phiole benötigen, nachdem die Aufgabe erledigt ist.‡놈리건으로 가서 고농축 방사성 폐기물을 가져와야 합니다. 이 폐기물은 불안정하여 성분이 금방 변할 수 있으니 주의하십시오.|n|n임무를 완수한 후 빈 대형 가연채집병을 오지에게 돌려줘야 합니다.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.|n|nOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.‡Viaja hasta Gnomeregan y recupera los restos radiactivos de gran potencia. Pero ten cuidado, ya que es inestable y podría explotar en cualquier momento.|n|nOzzie también quiere que traigas la ampolla pesada de plomo una vez que hayas terminado el trabajo.|n‡Voyager à Gnomeregan et rapporter de la Matière radioactive à haut potentiel. Attention, la matière radioactive est instable et se désactive rapidement.|n|nUne fois la tâche achevée, conserver la Flasque plombée lourde, pour Ozzie.‡到诺莫瑞根去收集高强度辐射尘。要多加小心，这种辐射尘非常不稳定，很快就会分解。|n|n奥齐要求你把沉重的铅瓶也交给他。‡到諾姆瑞根去收集高強度輻射塵。要多加小心，這種輻射塵非常不穩定，很快就會分解。|n|n奧齊要求你在任務完成後把沉重的鉛之瓶也交給他。',
  }
},
[2963] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com o Historiador Karnik no Salão dos Exploradores em Altaforja.‡Поговорите с историком Карником в Зале Исследователей в Стальгорне.‡Sprecht mit Historiker Karnik in der Halle der Forscher in Eisenschmiede.‡아이언포지의 탐험가의 전당에 있는 역사학자 카르닉과 대화해야 합니다.‡Habla con el historiador Karnik en la Sala de los Exploradores de Forjaz.‡Habla con Karnik el Historiador en la Sala de los Expedicionarios de Forjaz.‡Parler à l\'Historien Karnik dans le Hall des explorateurs, à Forgefer.‡与铁炉堡探险者大厅中的史学家卡尼克谈一谈。‡與鐵爐堡探險者大廳中的史學家卡尼克談話。',
  }
},
[2964] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Una tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡進一步的任務',
    nil,
    'Fale com o Alto-explorador Magellas em Altaforja.‡Поговорите со старшим исследователем Магелласом в Стальгорне.‡Sprecht mit Hochforscher Magellas in Eisenschmiede.‡아이언포지에 있는 선임탐험가 마겔라스와 대화해야 합니다.‡Habla con el alto expedicionario Magellas de Forjaz.‡Habla con el alto expedicionario Magellas de Forjaz.‡Parler au Grand Explorateur Magellas, à Forgefer.‡与铁炉堡的资深探险家麦格拉斯谈一谈。‡與鐵爐堡的資深探險家麥格拉斯談話。',
  }
},
[2965] = {
  {
    'Os portentos de Uldum‡Ульдумские чудеса‡Omen von Uldum‡울둠의 전조‡Presagios de Uldum‡Presagios de Uldum‡Prodiges d\'Uldum‡奥丹姆的线索‡奧丹姆的線索',
    nil,
    'Fale com Nara Juba Agreste no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой на Вершине Старейшин Громового Утеса.‡Sprecht mit Nara Wildmähne auf der Anhöhe der Ältesten in Donnerfels.‡썬더 블러프의 장로의 봉우리에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Ferocrín en el Alto de los Ancestros de Cima del Trueno.‡Habla con Nara Ferocrín en el Alto de los Ancestros de Cima del Trueno.‡Aller à la Cime des Anciens, aux Pitons du Tonnerre et parler à Nara Crin-sauvage.‡与雷霆崖长者高地的纳拉·蛮鬃谈一谈。‡與雷霆崖長者高地的納拉·蠻鬃談話。',
  }
},
[2966] = {
  {
    'Ver o que acontece‡Посмотрим, что будет дальше‡Mal sehen, was passiert...‡위험한 시도‡A ver qué pasa‡A ver qué pasa‡Questions sans réponses‡拭目以待‡拭目以待',
    nil,
    'Leve os discos de platina em miniatura até os portões de Uldum, em Tanaris, e procure descobrir qual é a conexão entre essas duas coisas.‡Принесите миниатюрные платиновые диски к воротам Ульдума в Танарисе и проверьте, имеют ли диски отношение к воротам.‡Bringt die Miniaturplatinscheiben zu den Toren von Uldum in Tanaris und sucht nach Hinweisen auf die Verbindung zwischen beidem.‡소형 백금 원반을 타나리스에 있는 울둠의 문으로 가져가서 이 둘 사이의 연관성에 대한 단서를 찾아야 합니다.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Lleva los discos de platino en miniatura a las puertas de Uldum, en Tanaris. Busca pistas sobre la conexión entre discos y puertas.‡Apportez les Disques de platine miniatures aux Portes d\'Uldum, à Tanaris, et cherchez les indices de la connexion qui existe entre eux.‡将迷你白金圆盘拿到塔纳利斯的奥丹姆大门去，找出两者之间的联系。‡將迷你白金圓盤拿到塔納利斯的奧丹姆大門去，找出兩者之間的聯繫。',
  }
},
[2967] = {
  {
    'Volte ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Rückkehr nach Donnerfels‡썬더 블러프로의 귀환‡Regresa a Cima del Trueno‡Regresa a Cima del Trueno‡Le retour aux Pitons du Tonnerre‡返回雷霆崖‡返回雷霆崖',
    nil,
    'Fale com Nara Juba Agreste no Penhasco do Trovão.‡Поговорите с Нарой Буйногривой в Громовом Утесе.‡Sprecht mit Nara Wildmähne in Donnerfels.‡썬더 블러프에 있는 나라 와일드메인과 대화해야 합니다.‡Habla con Nara Ferocrín en Cima del Trueno.‡Habla con Nara Ferocrín en Cima del Trueno.‡Parler à Nara Crin-sauvage, aux Pitons du Tonnerre.‡与雷霆崖的纳拉·蛮鬃谈一谈。‡與雷霆崖的納拉·蠻鬃談話。',
  }
},
[2968] = {
  {
    'Uma tarefa futura‡Новое задание‡Eine zukünftige Aufgabe‡미래의 임무‡Una tarea futura‡Una tarea futura‡Travail imminent‡进一步的任务‡進一步的任務',
    nil,
    'Fale com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Поговорите с Ведуном Искателем Истины в Громовом Утесе.‡Sprecht mit dem Weisen Wahrspruch in Donnerfels.‡썬더 블러프에 있는 현자 트루스시커와 대화해야 합니다.‡Habla con Sabio Buscador de la Verdad en Cima del Trueno.‡Habla con Sabio Buscador de la Verdad en Cima del Trueno.‡Parler au Sage Recherche-la-vérité, aux Pitons du Tonnerre.‡与雷霆崖的圣者图希克谈一谈。‡與雷霆崖的賢者圖希克談話。',
  }
},
[2969] = {
  {
    'Liberdade para todas as criaturas‡Свободу всем живым существам!‡Freiheit für alle Kreaturen‡모든 생명에 자유를‡Libertad para todas las criaturas‡Libertad para todas las criaturas‡Liberté pour toutes les créatures‡精灵龙的自由‡所有生物的自由',
    nil,
    'Com a Chave da Gaiola de Bambu, liberte os Dardejantes do cercado no acampamento dos Temível Totem. Pelo menos 6 Dardejantes e Kindal Teceluna devem sobreviver.|n|nVocê tem 6 minutos antes que Kindal resolva recuar e você fracasse na missão.‡Освободите летучих хамелеонов из вольера в лагере Зловещего Тотема с помощью ключа от бамбуковой клетки. Необходимо, чтобы Киндел Лунная Пряжа и как минимум 6 хамелеонов остались живы.|n|nУ вас в запасе 6 минут. После этого Киндел решит, что пора отступать, и задание останется невыполненным.‡Befreit mit dem Bambuskäfigschlüssel die Grimmlingflitzer aus dem Pferch im Grimmtotemlager. Kindal Mondweber sowie mindestens 6 Grimmlingflitzer müssen überleben.|n|nIhr habt 6 Minuten, bis Kindal beschließt, dass es Zeit zum Rückzug und Eure Aufgabe gescheitert ist.‡대나무 우리 열쇠를 사용하여 그림토템부족 야영지의 우리에 갇힌 화살요정용들을 풀어 줘야 합니다. 최소 6마리의 화살요정용과 킨달 문위버가 살아남아야 합니다.|n|n6분이 지나면 킨달이 후퇴할 때가 되었다고 할 것이며 임무에 실패하게 됩니다.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.|n|nTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡Utiliza la llave de jaula de bambú para liberar a los duendes dardo del campamento Tótem Siniestro. Deben sobrevivir al menos 6 duendes dardo y Kindal Tejeluna.|n|nTienes 6 minutos antes de que Kindal decida que es hora de retirarse, entonces tu misión fracasará.‡À l\'aide de la Clé de la cage en bambou, libérer les Fées fléchetteuses de l\'enclos dans le Camp du Totem-sinistre. Au moins 6 Fées fléchetteuses et Kindal Tisselune doivent survivre.|n|nVous avez 6 minutes avant que Kindal décide qu\'il est temps de battre en retraite et que vous échouiez dans votre quête.‡从恐怖图腾营地的围栏里释放被俘获的小精龙。至少6个小精龙和辛达尔·月纹必须活着。|n|n如果6分钟之内你还没能达成这个目标，辛达尔就会决定撤退，任务也会随即失败。‡從恐怖圖騰營地的圍欄裡釋放被俘獲的小精龍。至少6個小精龍和辛達爾·月紋必須活著。|n|n如果6分鐘之內你還沒能達成這個目標，辛達爾就會決定撤退，任務也會隨即失敗。',
  }
},
[2970] = {
  {
    'Distribuindo a justiça‡Небольшое возмездие‡Gerechtigkeit üben‡정의의 실현‡La justicia del castigo‡La justicia del castigo‡Justice de châtiment‡菲拉斯的正义‡菲拉斯的正義',
    nil,
    'Mate 12 Naturalistas Temível Totem, 10 Saqueadores dos Temível Totem e 6 Xamãs Temível Totem antes reencontrar Jer\'kai Teceluna em Feralas.‡Убейте 12 натуралистов, 10 налетчиков из племени и 6 шаманов из племени Зловещего Тотема, а затем вернитесь к Джер\'кай Лунной Пряже в Фераласе.‡Tötet 12 Naturalisten der Grimmtotem, 10 Räuber der Grimmtotem sowie 6 Schamanen der Grimmtotem und kehrt dann zu Jer\'kai Mondweber nach Feralas zurück.‡그림토템부족 식물학자 12명, 그림토템부족 침략자 10명, 그리고 그림토템부족 주술사 6명을 처치한 후, 페랄라스에 있는 제르카이 문위버에게 돌아가야 합니다.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Mata a 12 naturalistas Tótem Siniestro, 10 asaltantes Tótem Siniestro y 6 chamanes Tótem Siniestro antes de volver con Jer\'kai Tejeluna a Feralas.‡Tuer 12 Naturalistes du Totem-sinistre, 10 Écumeurs du Totem-sinistre et 6 Chamans du Totem-sinistre avant de retourner voir Jer\'kai Tisselune, en Féralas.‡杀掉12个恐怖图腾博学者、10个恐怖图腾袭击者和6个恐怖图腾萨满祭司，然后向菲拉斯的耶尔卡·月纹汇报。‡殺掉12個恐怖圖騰自然學家、10個恐怖圖騰劫掠者和6個恐怖圖騰薩滿，然後向菲拉斯的耶爾卡·月紋彙報。',
  }
},
[2971] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    '[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description‡[PH] Log Description',
