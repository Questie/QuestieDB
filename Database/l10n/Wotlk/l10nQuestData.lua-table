    nil,
  }
},
[24510] = {
  {
    '‡В ледяную цитадель‡In der eisigen Zitadelle‡얼어붙은 성채 안으로‡Dentro de la Ciudadela helada‡Dentro de la Ciudadela helada‡À l\'intérieur de la citadelle gelée‡进入寒冰堡垒‡進入冰凍城塞',
    nil,
    '‡Войдите в Кузню Душ со стороны Цитадели Ледяной Короны и найдите леди Джайну Праудмур.‡Betretet die Seelenschmiede von der Seite der Eiskronenzitadelle und findet Lady Jaina Prachtmeer.‡얼음왕관 성채의 옆쪽에서 영혼의 제련소로 들어간 다음 여군주 제이나 프라우드무어를 찾아야 합니다.‡Entra en la Forja de Almas por el lado de la Ciudadela de la Corona de Hielo y encuentra a Lady Jaina Valiente.‡Entra en la Forja de Almas por el lado de la Ciudadela de la Corona de Hielo y encuentra a Lady Jaina Valiente.‡Pénétrez dans la Forge des Âmes depuis le côté de la Citadelle de la Couronne de glace et trouvez Dame Jaina Portvaillant.‡从冰冠堡垒一侧进入到灵魂洪炉，在那里找到吉安娜·普罗德摩尔女士。‡',
  }
},
[24511] = {
  {
    '‡Тени замученных душ‡Echos gequälter Seelen‡괴로워하는 영혼의 메아리‡Ecos de almas torturadas‡Ecos de almas torturadas‡Les échos des âmes torturées‡痛苦灵魂的回声‡受苦靈魂的回聲',
    nil,
    '‡Чтобы обеспечить безопасный проход в Яму Сарона, убейте Броньяма и Пожирателя Душ.‡Tötet Bronjahm und den Verschlinger der Seelen, um den Zugang zur Grube von Saron zu sichern.‡브론잠과 영혼의 포식자를 처치하고 사론의 구덩이로 가는 길을 확보해야 합니다.‡Mata a Bronjahm y al Devoraalmas para asegurar el acceso al Foso de Saron.‡Mata a Bronjahm y al Devoraalmas para asegurar el acceso al Foso de Saron.‡Tuez Bronjahm et le Dévoreur d\'âmes pour sécuriser l\'accès à la Fosse de Saron.‡消灭布隆亚姆和噬魂者，夺取萨隆矿坑的入口。‡',
  }
},
[24522] = {
  {
    '‡Путешествие к Солнечному Колодцу‡Reise zum Sonnenbrunnen‡태양샘으로 떠나는 여행‡Viaje a La Fuente del Sol‡Viaje a La Fuente del Sol‡Un voyage au Puits de soleil‡太阳之井之旅‡',
    nil,
    '‡Поговорите с Халдароном Светлым Крылом у входа на плато Солнечного Колодца на острове Кель\'Данас.‡Sprecht mit Halduron Wolkenglanz am Eingang des Sonnenbrunnenplateaus auf der Insel von Quel\'Danas.‡쿠엘다나스 섬의 태양샘 고원 입구에서 할두런 브라이트윙과 대화해야 합니다.‡Habla con Halduron Alasol en la entrada de la Meseta de La Fuente del Sol en la Isla de Quel\'Danas.‡Habla con Halduron Alasol en la entrada de la Meseta de La Fuente del Sol en la Isla de Quel\'Danas.‡Parlez à Halduron Luisaile à l\'entrée du Plateau du Puits de soleil, sur l\'Île de Quel\'Danas.‡在奎尔丹纳斯岛，太阳之井高地入口处同哈杜伦·明翼交谈。‡',
  }
},
[24535] = {
  {
    '‡Талориен Искатель Рассвета‡Thalorien Morgensucher‡탈로리엔 돈시커‡Thalorien Buscalba‡Thalorien Buscalba‡Thalorien Cherchelaube‡萨洛瑞安·寻晨者‡薩洛瑞安·曦尋者',
    nil,
    '‡Наведайтесь к останкам Талориена Искателя Рассвета и получите его благословение на владение Кель\'Деларом.‡Besucht die sterblichen Überreste Thalorien Morgensuchers und erhaltet seinen Segen für den Gebrauch Quel\'Delars.‡탈로리엔 돈시커의 유해를 찾아서 쿠엘델라를 쓸 수 있도록 그의 축복을 받아야 합니다.‡Visita los restos de Thalorien Buscalba y obtén su bendición para blandir Quel\'Delar.‡Visita los restos de Thalorien Buscalba y obtén su bendición para blandir Quel\'Delar.‡Rendez-vous auprès des Restes de Thalorien Cherchelaube et obtenez sa bénédiction pour utiliser Quel\'Delar.‡访问萨洛瑞安·寻晨者的遗体，获得他的祝福，以使用奎尔德拉。‡',
  }
},
[24536] = {
  {
    'Alguma coisa fede‡Дышать нечем!‡Irgendwas stinkt hier‡이게 무슨 냄새야?‡Algo apesta‡Algo apesta‡Il y a quelque chose de pourri…‡恶臭的东西‡事有蹊蹺',
    nil,
    'Use o Analisador de Ar do Garrafuso para testar o ar ao redor de 6 guardas bastante perfumados e fale novamente com o Detetive Estalo Garrafuso em Orgrimmar.‡С помощью анализатора воздуха Гвоздезуба изучите состав воздуха вокруг шести надушенных стражников, а затем вернитесь к детективу с результатами.‡Verwendet Schnappbolzens Luftanalysegerät, um die Luft zu untersuchen, die 6 stark parfümierte Wachen umgibt, und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡스내글볼트의 공기 분석기를 사용해 향수 범벅이 된 경비병 6명 주위의 공기를 분석하고, 오그리마에 있는 명탐정 스냅 스내글볼트에게 돌아가야 합니다.‡Usa el analizador de aire de Tuerceganzúas para analizar el aire alrededor de 6 guardias altamente perfumados. Luego vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Usa el analizador de aire de Tuerceganzúas para analizar el aire alrededor de 6 guardias altamente perfumados. Luego vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Utilisez l\'Analyseur d\'air de Tordboulon pour tester l\'air autour de 6 Gardes lourdement parfumés, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡使用滑栓的空气分析器测试6位带有浓郁香气的卫兵周围的空气，然后返回奥格瑞玛，去见侦探斯奈普·滑栓。‡使用『凸栓的空氣分析器』來測試6名香味濃郁的守衛四周的氣味，然後回奧格瑪找警探史內卜·凸栓。',
  }
},
[24541] = {
  {
    '‡Позаимствовать духи‡Parfümdiebstahl‡향수 슬쩍하기‡Afanar el aroma‡Afanar el aroma‡Dérober du parfum‡香水行动‡竊取香水',
    nil,
    '‡Замаскировавшись под посыльного, отправляйтесь к воротам Оргриммара, возле которых находятся товары Королевской химической компании. Добудьте ящик Королевской компании и вернитесь к детективу Крямсу Гвоздезубу в Оргриммар.‡Begebt Euch, während Ihr als Lieferbursche verkleidet seid, zum Vorratslager der Chemiemanufaktur Krone vor den Toren Orgrimmars, kehrt dann mit dem Paket, das sie Euch zuwerfen, zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡택배 배달원으로 변장한 상태에서 오그리마 문 바깥에 왕관화학회사의 짐이 쌓인 곳으로 간 다음, 던져 주는 상자를 오그리마에 있는 명탐정 스냅 스내글볼트에게 가져가야 합니다.‡Mientras estés $Gdisfrazado:disfrazada; de mensajero, ve al montón de cajones de Químicos La Corona, S.L. fuera de las puertas de Orgrimmar y vuelve con el paquete que te lancen a ver al detective Snap Tuerceganzúas en Orgrimmar.‡Mientras estés $Gdisfrazado:disfrazada; de mensajero, ve al montón de cajones de Químicos La Corona, S.L. fuera de las puertas de Orgrimmar y vuelve con el paquete que te lancen a ver al detective Snap Tuerceganzúas en Orgrimmar.‡Mettez le Déguisement de coursier, rendez-vous à la Réserve de la Compagnie de Chimie La Royale à l\'extérieur des portes d\'Orgrimmar, puis rapportez le paquet qu\'on vous aura jeté à l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡被伪装成一个送包裹的人之后，前往奥格瑞玛大门外皇冠药剂公司的物资存放处，然后将他们给你的包裹交给奥格瑞玛的侦探斯奈普·滑栓。‡',
  }
},
[24545] = {
  {
    '‡Святость и скверна‡Die Heiligen und die Verderbten‡신성한 자와 타락한 자‡Lo sagrado y lo corrupto‡Lo sagrado y lo corrupto‡Le sacré et le corrompu‡神圣的和堕落的‡聖潔與墮落',
    nil,
    '‡Поместите Отмщение Света, 25 кусков древнейшего саронита, разъедающую кровь Гниломорда и разъедающую кровь Тухлопуза в кузню рун Верховного лорда Могрейна в Цитадели Ледяной Короны.|n|nРазъедающую кровь Гниломорда и Тухлопуза можно получить в рейде для 25 игроков в Цитадели Ледяной Короны.‡Platziert Lichträcher, 25 Einheiten urtümliches Saronit sowie Modermienes und Fauldarms ätzendes Blut in Hochlord Mograines Runenschmiede in der Eiskronenzitadelle.|n|nModermienes ätzendes Blut und Fauldarms ätzendes Blut sind nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle erhältlich.‡빛의 복수와 태고의 사로나이트 25개, 썩은얼굴의 산성 피, 구린속의 산성 피를 얼음왕관 성채에 있는 대영주 모그레인의 룬가열로에 넣어야 합니다.|n|n썩은얼굴의 산성 피와 구린속의 산성 피는 얼음왕관 성채 25인 난이도로 진행해야 얻을 수 있습니다.‡Coloca la Venganza de la Luz, 25 saronitas primordiales, sangre ácida de Carapútrea y sangre ácida de Panzachancro en la forja de runas del Alto señor Mograine en la Ciudadela de la Corona de Hielo.|n|nLa sangre ácida de Carapútrea y la sangre ácida de Panzachancro solo se pueden obtener en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Coloca la Venganza de la Luz, 25 saronitas primordiales, sangre ácida de Carapútrea y sangre ácida de Panzachancro en la forja de runas del Alto señor Mograine en la Ciudadela de la Corona de Hielo.|n|nLa sangre ácida de Carapútrea y la sangre ácida de Panzachancro solo se pueden obtener en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Placez Vengeance de la Lumière, 25 Saronites primordiales, le Sang acide de Trognepus et le Sang acide de Pulentraille sur la Forgerune du Généralissime Mograine, à la Citadelle de la Couronne de glace.|n|nLe Sang acide de Trognepus et le Sang acide de Pulentraille peuvent uniquement être obtenus en mode 25 joueurs à la Citadelle de la Couronne de glace.‡将圣光的复仇、25块源生萨隆邪铁、腐面的酸性血液和烂肠的酸性血液放进冰冠堡垒大领主莫格莱尼的符文熔炉中。|n|n腐面的酸性血液和烂肠的酸性血液只能在25人模式的冰冠堡垒中获得。‡',
  }
},
[24547] = {
  {
    '‡Пиршество душ‡Ein Seelenschmaus‡영혼의 잔치‡Un festín de almas‡Un festín de almas‡Un festin d\'âmes‡灵魂盛宴‡眾魂宴',
    nil,
    '‡Верховный лорд Могрейн поручил вам убить 1000 слуг Короля-лича в Цитадели Ледяной Короны с помощью Грани Тьмы. Души будут засчитаны в рейде на 10 или 25 игроков.‡Hochlord Darion Mograine möchte, dass Ihr mit Schattenschneide 50 Diener des Lichkönigs in der Eiskronenzitadelle tötet. Die Seelen sind in den Schwierigkeitsgraden für 10 oder 25 Mann erhältlich.‡‡El alto señor Darion Mograine quiere que utilices el Filo de las Sombras para matar a 50 esbirros del Rey Exánime en la Ciudadela de la Corona de Hielo. Las almas se pueden obtener en el modo de 10 ó 25 jugadores.‡El alto señor Darion Mograine quiere que utilices el Filo de las Sombras para matar a 50 esbirros del Rey Exánime en la Ciudadela de la Corona de Hielo. Las almas se pueden obtener en el modo de 10 ó 25 jugadores.‡Le Généralissime Darion Mograine veut que vous utilisiez Tranchant de l\'ombre pour tuer 50 séides du roi-liche à la Citadelle de la Couronne de glace. Les âmes peuvent être obtenues en mode 10 ou 25 joueurs.‡‡',
  }
},
[24548] = {
  {
    '‡Расколотый трон‡Der zersplitterte Thron‡조각난 왕좌‡El trono astillado‡El trono astillado‡Le trône brisé‡碎裂的王座‡破碎的王座',
    nil,
    '‡Верховный лорд Могрейн поручил вам собрать 50 осколков Льда Тьмы.|n|nОсколки Льда Тьмы можно получить только в рейде 25 игроков.‡Hochlord Darion Mograine möchte, dass Ihr 50 Schattenfrostsplitter sammelt.|n|nSchattenfrostsplitter sind nur im Schwierigkeitsgrad für 25 Mann erhältlich.‡대영주 다리온 모그레인이 어둠서리 조각 50개를 모아 달라고 했습니다.|n|n어둠서리 조각은 25인 난이도에서만 얻을 수 있습니다.‡El Alto señor Darion Mograine quiere que obtengas 50 fragmentos de escarcha de las Sombras.|n|nLos fragmentos de escarcha de las Sombras solo se pueden obtener en el modo de dificultad de 25 jugadores.‡El Alto señor Darion Mograine quiere que obtengas 50 fragmentos de escarcha de las Sombras.|n|nLos fragmentos de escarcha de las Sombras solo se pueden obtener en el modo de dificultad de 25 jugadores.‡Le Généralissime Darion Mograine veut que vous trouviez 50 Eclats ombregivres.|n|nLes Eclats ombregivres peuvent uniquement être obtenus en mode 25 joueurs.‡大领主达里安·莫格莱尼要你收集50块影霜碎片。|n|n影霜碎片只能在25人模式下获得。‡',
  }
},
[24549] = {
  {
    '‡Темная Скорбь...‡Schattengram...‡어둠한...‡Agonía de Sombras...‡Agonía de Sombras...‡Deuillelombre…‡影之哀伤……‡影之哀傷...',
    nil,
    '‡Верховный лорд Могрейн просит вас принести ему Грань Тьмы.‡Hochlord Darion Mograine möchte, dass Ihr ihm Schattenschneide bringt.‡대영주 다리온 모그레인에게 어둠의 칼날도끼를 가져가야 합니다.‡El Alto señor Darion Mograine quiere que le lleves el Filo de las Sombras.‡El Alto señor Darion Mograine quiere que le lleves el Filo de las Sombras.‡Le Généralissime Darion Mograine veut que vous lui rapportiez Tranchant de l\'ombre.‡大领主达里安·莫格莱尼想要你将影锋带给他。‡',
  }
},
[24553] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer getempertes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡달궈진 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar trempée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡将淬火的奎尔德拉浸入到太阳之井中。准备好进入太阳之井高地后，就同太阳之井守卫交谈。‡',
  }
},
[24554] = {
  {
    'O Punho Danificado‡Потертая рукоять‡Der ramponierte Schwertgriff‡마모된 칼자루‡La empuñadura maltrecha‡La empuñadura maltrecha‡La poignée endommagée‡残破的剑柄‡破損的劍柄',
    nil,
    'Leve o Punho Danificado para Myralion Ardessol no Repouso de Quel\'Delar, ao sul dos Campos do Torneio Argênteo.‡Принесите потертую рукоять Миралию Блеску Солнца в Покой Кель\'Делара, что к югу от ристалища Серебряного Турнира.‡Bringt den ramponierten Schwertgriff zu Myralion Sonnenfeuer in Quel\'Delars Ruh südlich des Argentumturnierplatzes.‡마모된 칼자루를 은빛십자군 마상시합 광장의 남쪽, 쿠엘델라의 쉼터에 있는 미랄리온 선블레이즈에게 가져다주어야 합니다.‡Lleva la empuñadura maltrecha a Myralion Resplandor al Reposo de Quel\'Delar, al sur de los Campos del Torneo Argenta.‡Lleva la empuñadura maltrecha a Myralion Resplandor al Reposo de Quel\'Delar, al sur de los Campos del Torneo Argenta.‡Apporter la Poignée endommagée à Myralion Solembrase au Repos de Quel\'Delar, au sud de l\'Enceinte du tournoi d\'Argent.‡将残破的剑柄交给奎尔德拉之冢的麦雷昂·阳炎。他就在银色比武场的南边。‡到銀白聯賽場地南邊的奎爾德拉之眠，把破損的劍柄帶給米拉連恩·日炎。',
  }
},
[24555] = {
  {
    '‡То, что знают драконы‡Das Wissen der Drachen‡용이 아는 것‡Lo que saben los dragones‡Lo que saben los dragones‡Ce que savent les dragons‡巨龙所知道的‡龍族的知識',
    nil,
    '‡Поговорите с Красом на вершине Храма Драконьего Покоя.‡Sprecht mit Krasus in der Spitze des Wyrmruhtempels.‡고룡쉼터 사원 꼭대기에 있는 크라서스와 대화해야 합니다.‡Habla con Krasus en lo alto del Templo del Reposo del Dragón.‡Habla con Krasus en lo alto del Templo del Reposo del Dragón.‡Parlez à Krasus, au sommet du Temple du Repos du ver.‡同龙眠神殿顶端的克拉苏斯交谈。‡',
  }
},
[24556] = {
  {
    '‡Подходящая маскировка‡Eine passende Verkleidung‡꼭 맞는 변장‡Un disfraz apropiado‡Un disfraz apropiado‡Nettoyage à secte‡适当的伪装‡適當的偽裝',
    nil,
    '‡Позаимствуйте у Шанди Шикблеска гербовую накидку.‡Besorgt Euch von Shandy Lackglanz einen geliehenen Wappenrock.‡섄디 글로스글림으로부터 대여 휘장을 얻어야 합니다.‡Consigue un tabardo prestado de Shandy Lustre Brillo.‡Consigue un tabardo prestado de Shandy Lustre Brillo.‡Procurez-vous un Tabard emprunté auprès de Shandy Cireluisante.‡从山迪·格罗斯那里取得“借来的战袍”。‡',
  }
},
[24557] = {
  {
    '‡Планы Серебряного союза‡Der Plan des Silberbunds‡은빛 서약단의 계략‡El plan de El Pacto de Plata‡El plan de El Pacto de Plata‡Le plan du Concordat argenté‡银色盟约的计谋‡白銀誓盟計畫',
    nil,
    '‡Перехватите приказы Серебряного союза.‡Besorgt die Befehle des Silberbunds.‡은빛 서약단 명령서를 획득해야 합니다.‡Consigue las órdenes de El Pacto de Plata.‡Consigue las órdenes de El Pacto de Plata.‡Emparez-vous des Ordres du Concordat argenté.‡‡',
  }
},
[24558] = {
  {
    '‡Возвращение к Миралию Блеску Солнца‡Rückkehr zu Myralion Sonnenfeuer‡미랄리온 선블레이즈에게 돌아가기‡Vuelve con Myralion Resplandor‡Vuelve con Myralion Resplandor‡Retourner voir Myralion Solembrase‡去见麦雷昂·阳炎‡回報米拉連恩‧日炎',
    nil,
    '‡Принесите книгу "Древние клинки драконьей ковки" Миралию Блеску Солнца в Покой Кель\'Делара.‡Bringt den Folianten "Uralte drachengeschmiedete Klingen" zu Myralion Sonnenfeuer in Quel\'Delars Ruh.‡\'고대의 용이 벼려낸 검\' 책을 쿠엘델라의 쉼터에 있는 미랄리온 선블레이즈에게 가져가야 합니다.‡Lleva Hojas antiguas forjadas por los dragones a Myralion Resplandor al Reposo de Quel\'Delar.‡Lleva Hojas antiguas forjadas por los dragones a Myralion Resplandor al Reposo de Quel\'Delar.‡Rapportez les Lames anciennes forgées par les dragons à Myralion Solembrase, au Repos de quel\'Delar.‡‡',
  }
},
[24559] = {
  {
    '‡Перековать меч‡Das Schwert neu schmieden‡검 재련하기‡Reforjar la espada‡Reforjar la espada‡Reforger l\'épée‡利剑的重铸‡重鑄劍刃',
    nil,
    '‡Возьмите 5 слитков зараженного саронита и молот начальника кузни, чтобы соединить фрагменты Кель\'Делара и создать перекованный Кель\'Делар.‡Besorgt 5 energieerfüllte Saronitbarren sowie den Hammer des Schmiedemeisters und verbindet sie mit den Überresten Quel\'Delars, um das Schwert wiederherzustellen.‡마력 깃든 사로나이트 주괴 5개와 제련장인의 망치를 모아, 쿠엘델라 파편과 합쳐 재련된 쿠엘델라를 만들어야 합니다.‡Obtén 5 barras de saronita imbuida y el martillo del maestro de forja, después combínalos con los restos de Quel\'Delar para crear la Quel\'Delar reforjada.‡Obtén 5 barras de saronita imbuida y el martillo del maestro de forja, después combínalos con los restos de Quel\'Delar para crear la Quel\'Delar reforjada.‡Obtenez 5 Barres de saronite infusée et le Marteau du maître-forge et combinez-les avec les Fragments de Quel\'Delar pour créer la Quel\'Delar reforgée.‡‡',
  }
},
[24560] = {
  {
    '‡Закалить клинок‡Die Klinge tempern‡검 달구기‡Templar la hoja‡Templar la hoja‡Retremper la lame‡锻造利剑‡淬鍊劍刃',
    nil,
    '‡Закалите перекованный Кель\'Делар в горниле душ.‡Tempert das neugeschmiedete Quel\'Delar im Schmelztiegel der Seelen.‡영혼의 도가니에서 재련된 쿠엘델라를 달구어야 합니다.‡Templa la Quel\'Delar reforjada en el Crisol de Almas.‡Templa la Quel\'Delar reforjada en el Crisol de Almas.‡Retremper Quel\'Delar reforgée dans le Creuset des âmes.‡‡',
  }
},
[24561] = {
  {
    '‡Залы Отражений‡Die Hallen der Reflexion‡투영의 전당‡Las Cámaras de Reflexión‡Las Cámaras de Reflexión‡Les salles des Reflets‡映像大厅‡倒影大廳',
    nil,
    '‡Отнесите Кель\'Делар в Покои Клинка, что в Залах Отражений.‡Bringt Quel\'Delar nach Schwertruh in den Hallen der Reflexion.‡쿠엘델라를 투영의 전당 안에 있는 검의 안식처로 가져가야 합니다.‡Lleva a Quel\'Delar al Reposo de la Espada en las Cámaras de Reflexión.‡Lleva a Quel\'Delar al Reposo de la Espada en las Cámaras de Reflexión.‡Apporter Quel\'Delar au Repos de l\'épée dans les Salles des Reflets.‡将淬火的奎尔德拉带到映像大厅里面的剑冢去。‡',
  }
},
[24562] = {
  {
    '‡Путешествие к Солнечному Колодцу‡Reise zum Sonnenbrunnen‡태양샘으로 떠나는 여행‡Viaje a La Fuente del Sol‡Viaje a La Fuente del Sol‡Un voyage au Puits de soleil‡太阳之井之旅‡前往太陽之井',
    nil,
    '‡Поговорите с Халдароном Светлым Крылом у входа на плато Солнечного Колодца на острове Кель\'Данас.‡Sprecht mit Halduron Wolkenglanz am Eingang des Sonnenbrunnenplateaus auf der Insel von Quel\'Danas.‡쿠엘다나스 섬의 태양샘 고원 입구에서 할두런 브라이트윙과 대화해야 합니다.‡Habla con Halduron Alasol en la entrada de la Meseta de La Fuente del Sol en la Isla de Quel\'Danas.‡Habla con Halduron Alasol en la entrada de la Meseta de La Fuente del Sol en la Isla de Quel\'Danas.‡Parlez à Halduron Luisaile à l\'entrée du Plateau du Puits de soleil, sur l\'Île de Quel\'Danas.‡在奎尔丹纳斯岛，太阳之井高地入口处同哈杜伦·明翼交谈。‡',
  }
},
[24563] = {
  {
    '‡Талориен Искатель Рассвета‡Thalorien Morgensucher‡탈로리엔 돈시커‡Thalorien Buscalba‡Thalorien Buscalba‡Thalorien Cherchelaube‡萨洛瑞安·寻晨者‡薩洛瑞安‧曦尋者',
    nil,
    '‡Наведайтесь к останкам Талориена Искателя Рассвета и получите его благословение на владение Кель\'Деларом.‡Besucht die sterblichen Überreste Thalorien Morgensuchers und erhaltet seinen Segen für den Gebrauch Quel\'Delars.‡탈로리엔 돈시커의 유해를 찾아서 쿠엘델라를 쓸 수 있도록 그의 축복을 받아야 합니다.‡Visita los restos de Thalorien Buscalba y obtén su bendición para blandir Quel\'Delar.‡Visita los restos de Thalorien Buscalba y obtén su bendición para blandir Quel\'Delar.‡Rendez-vous auprès des Restes de Thalorien Cherchelaube et obtenez sa bénédiction pour utiliser Quel\'Delar.‡访问萨洛瑞安·寻晨者的遗体，获得他的祝福，以使用奎尔德拉。‡',
  }
},
[24564] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer getempertes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡달궈진 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar trempée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡将淬火的奎尔德拉浸入到太阳之井中。准备好进入太阳之井高地后，就同太阳之井守卫交谈。‡',
  }
},
[24576] = {
  {
    '‡Разговор по душам...‡Eine nette Unterhaltung...‡우호적인 대화...‡Una charla amistosa...‡Una charla amistosa...‡On va juste discuter gentiment…‡友善地交谈……‡善意的溝通...',
    nil,
    '‡Отправляйтесь к башне дирижаблей, что на востоке от врат Оргриммара, и допросите Снивела Ржавстера. Постарайтесь получить хоть какие-нибудь доказательства.‡Begebt Euch zum Zeppelinturm auf dem zentralen Hügel in Orgrimmar und befragt Flenni Rostrakete zu den Vorräten. Kehrt mit den erhaltenen Informationen zurück.‡‡Ve a la torre de zepelín, en la meseta central de Orgrimmar, e interroga a Quejica Misilóxido sobre los suministros. Vuelve con cualquier prueba que te aporte.‡Ve a la torre de zepelín, en la meseta central de Orgrimmar, e interroga a Quejica Misilóxido sobre los suministros. Vuelve con cualquier prueba que te aporte.‡Rendez-vous à la Tour des zeppelins au centre d\'Orgrimmar et questionnez Chignard Rouillefusée à propos des fournitures. Revenez avec les preuves qu\'il vous aura données.‡‡',
  }
},
[24579] = {
  {
    '‡Сартарион должен умереть!‡Sartharion muss sterben!‡살타리온을 없애라!‡¡Sartharion debe morir!‡¡Sartharion debe morir!‡Sartharion doit mourir!‡消灭萨塔里奥！‡撒爾薩里安必須死!',
    nil,
    '‡Убейте Сартариона.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Sartharion.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡살타리온을 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Sartharion.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Sartharion.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Sartharion.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭萨塔里奥。|n|n这个任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24580] = {
  {
    '‡Ануб\'Рекан должен умереть!‡Anub\'Rekhan muss sterben!‡아눕레칸을 없애라!‡¡Anub\'Rekhan debe morir!‡¡Anub\'Rekhan debe morir!‡Anub\'Rekhan doit mourir!‡阿努布雷坎必须死‡阿努比瑞克漢必須死!',
    nil,
    '‡Убейте Ануб\'Рекана.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Anub\'Rhekan.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡아눕레칸을 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Anub\'Rekhan.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Anub\'Rekhan.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Anub\'Rekhan.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭阿努布雷坎。|n|n这个任务可以在任何难度或者任何规模的团队副本中完成。‡',
  }
},
[24581] = {
  {
    '‡Нот Чумной должен умереть!‡Noth der Seuchenfürst muss sterben!‡역병술사 노스를 없애라!‡¡Noth el Pesteador debe morir!‡¡Noth el Pesteador debe morir!‡Noth le Porte-peste doit mourir!‡消灭药剂师诺斯！‡『瘟疫使者』諾斯必須死!',
    nil,
    '‡Убейте Нота Чумного.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Noth den Seuchenfürst.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡역병술사 노스를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Noth el Pesteador.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Noth el Pesteador.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Noth le Porte-peste.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭药剂师诺斯。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24582] = {
  {
    '‡Инструктор Разувий должен умереть!‡Instrukteur Razuvious muss sterben!‡훈련교관 라주비어스를 없애라!‡¡El instructor Razuvious debe morir!‡¡El instructor Razuvious debe morir!‡L\'instructeur Razuvious doit mourir!‡消灭教官拉苏维奥斯！‡講師拉祖維斯必須死!',
    nil,
    '‡Убейте Инструктора Разувия.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Instrukteur Razuvious.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡훈련교관 라주비어스를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata al instructor Razuvious.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata al instructor Razuvious.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez l\'Instructeur Razuvious.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭教官拉苏维奥斯。|n|n这个任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24583] = {
  {
    '‡Лоскутик должен умереть!‡Flickwerk muss sterben!‡패치워크를 없애라!‡¡Remendejo debe morir!‡¡Remendejo debe morir!‡Le Recousu doit mourir!‡消灭帕奇维克！‡縫補者必須死!',
    nil,
    '‡Убейте Лоскутика.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Flickwerk.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡패치워크를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Remendejo.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Remendejo.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez le Recousu.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭帕奇维克。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24584] = {
  {
    '‡Малигос должен умереть!‡Malygos muss sterben!‡말리고스를 없애라!‡¡Malygos debe morir!‡¡Malygos debe morir!‡Malygos doit mourir!‡消灭玛里苟斯‡瑪里苟斯必須死!',
    nil,
    '‡Убейте Малигоса.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Malygos.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡말리고스를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Malygos.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Malygos.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Malygos.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭玛里苟斯。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24585] = {
  {
    '‡Огненный Левиафан должен умереть!‡Der Flammenleviathan muss sterben!‡거대 화염전차를 파괴하라!‡¡El Leviatán de llamas debe morir!‡¡El Leviatán de llamas debe morir!‡Le Léviathan des flammes doit mourir!‡烈焰巨兽必须死！‡烈焰戰輪必須死!',
    nil,
    '‡Убейте Огненного Левиафана.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet den Flammenleviathan.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡거대 화염전차를 파괴해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata al Leviatán de llamas.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata al Leviatán de llamas.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez le Léviathan des flammes.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭烈焰巨兽。|n|n这个任务可以在任何难度或规模的团队副本中完成。‡',
  }
},
[24586] = {
  {
    '‡Острокрылая должна умереть!‡Klingenschuppe muss sterben!‡칼날비늘을 없애라!‡¡Tajoescama debe morir!‡¡Tajoescama debe morir!‡Tranchécaille doit mourir!‡消灭锋鳞‡銳鱗必須死!',
    nil,
    '‡Убейте Острокрылую.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Klingenschuppe.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡칼날비늘을 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Tajoescama.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Tajoescama.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Tranchécaille.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭锋鳞。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24587] = {
  {
    '‡Повелитель горнов Игнис должен умереть!‡Ignis, Meister des Eisenwerks, muss sterben!‡용광로 군주 이그니스를 없애라!‡¡Ignis el Maestro de la Caldera debe morir!‡¡Ignis el Maestro de la Caldera debe morir!‡Ignis le maître de la Fournaise doit mourir!‡消灭掌炉者伊格尼斯！‡『火爐之主』伊格尼司必須死!',
    nil,
    '‡Убейте Повелителя горнов Игниса.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Ignis, Meister des Eisenwerks.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡용광로 군주 이그니스를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Ignis el Maestro de la Caldera.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Ignis el Maestro de la Caldera.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez Ignis le maître de la Fournaise.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭掌炉者伊格尼斯。|n|n这个任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24588] = {
  {
    '‡Разрушитель XT-002 должен умереть!‡XT-002 Dekonstruktor muss sterben!‡XT-002 해체자를 파괴하라!‡¡El Desarmador XA-002 debe morir!‡¡El Desarmador XA-002 debe morir!‡Le Déconstructeur XT-002 doit mourir!‡消灭XT-002拆解者！‡XT-002拆解者必須死!',
    nil,
    '‡Убейте Разрушителя XT-002.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet den XT-002 Dekonstruktor.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡XT-002 해체자를 파괴해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata al Desarmador XA-002.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata al Desarmador XA-002.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez le Déconstructeur XT-002.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭XT-002拆解者。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24589] = {
  {
    '‡Лорд Джараксус должен умереть!‡Lord Jaraxxus muss sterben!‡군주 자락서스를 없애라!‡¡Lord Jaraxxus debe morir!‡¡Lord Jaraxxus debe morir!‡Le seigneur Jaraxxus doit mourir!‡消灭加拉克苏斯大王！‡賈拉克瑟斯領主必須死!',
    nil,
    '‡Убейте лорда Джараксуса.|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Lord Jaraxxus.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡군주 자락서스를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Lord Jaraxxus.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Lord Jaraxxus.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez le Seigneur Jaraxxus.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭加拉克苏斯大王。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24590] = {
  {
    '‡Лорд Ребрад должен умереть!‡Lord Mark\'gar muss sterben!‡군주 매로우가르를 없애라!‡¡Lord Tuétano debe morir!‡¡Lord Tuétano debe morir!‡Le seigneur Gargamoelle doit mourir!‡消灭玛洛加尔领主！‡瑪洛嘉領主必須死!',
    nil,
    '‡Убейте Лорда Ребрада .|n|nЭто задание можно выполнить на любом уровне сложности и любым составом рейда.‡Tötet Lord Mark\'gar.|n|nDiese Quest kann von einem Schlachtzug jeglicher Schwierigkeitsstufe oder Größe abgeschlossen werden.‡군주 매로우가르를 처치해야 합니다.|n|n이 퀘스트는 난이도와 공격대 규모에 관계없이 완료할 수 있습니다.‡Mata a Lord Tuétano.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Mata a Lord Tuétano.|n|nEsta misión se puede completar con cualquier tamaño de banda en cualquier modo de dificultad.‡Tuez le Seigneur Gargamoelle.|n|nCette quête peut être achevée dans n\'importe quels mode et difficulté de raid.‡消灭玛洛加尔领主。|n|n这一任务可以在任何难度和规模的团队副本中完成。‡',
  }
},
[24594] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer besudeltes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡오염된 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar souillée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡‡',
  }
},
[24595] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer besudeltes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡오염된 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar souillée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡‡',
  }
},
[24596] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer besudeltes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡오염된 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar corrupta en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar souillée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡‡',
  }
},
[24597] = {
  {
    'Um presente para o rei de Ventobravo‡Дар королю Штормграда‡Ein Geschenk für den König von Sturmwind‡스톰윈드 국왕에게 선물을‡Un regalo para el Rey de Ventormenta‡Un regalo para el Rey de Ventormenta‡Un cadeau pour le roi de Hurlevent‡为暴风城之王准备的礼物‡給暴風城國王的禮物',
    nil,
    'Presenteie o Rei Varian Wrynn, em Ventobravo, com uma Pulseira de Patuás Adoráveis.‡Подарите чудесный браслет-оберег королю Штормграда Вариану Ринну.‡Schenkt König Varian Wrynn von Sturmwind einen hübschen Glücksbringerarmreif.‡스톰윈드에 있는 국왕 바리안 린에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos al rey Varian Wrynn.‡Regálale una pulsera de talismanes preciosos al rey Varian Wrynn.‡Offrez un Bracelet de breloques ravissantes au Roi Varian Wrynn, à Hurlevent.‡向暴风城的瓦里安·乌瑞恩国王献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給暴風城的瓦里安·烏瑞恩國王。',
  }
},
[24598] = {
  {
    '‡Очищение Кель\'Делара‡Die Reinigung Quel\'Delars‡쿠엘델라 정화‡La purificación de Quel\'Delar‡La purificación de Quel\'Delar‡La purification de Quel\'Delar‡奎尔德拉的净化‡淨化奎爾德拉',
    nil,
    '‡Окуните закаленный Кель\'Делар в Солнечный Колодец. Когда вы будете готовы войти на плато Солнечного Колодца, обратитесь к хранителю Солнечного Колодца.‡Taucht Euer getempertes Quel\'Delar in den Sonnenbrunnen. Sprecht mit einem der Wärter des Sonnenbrunnens, wenn Ihr bereit seid, das Sonnenbrunnenplateau zu betreten.‡달궈진 쿠엘델라를 태양샘에 담가야 합니다. 태양샘 고원에 들어갈 준비가 되면 태양샘 감시자와 대화하십시오.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Sumerge la Quel\'Delar templada en La Fuente del Sol. Habla con un celador de La Fuente del Sol cuando estés $Glisto:lista; para entrar en la Meseta de La Fuente del Sol.‡Plongez votre Quel\'Delar trempée dans le Puits de soleil. Parlez à un Gardien du Puits de soleil quand vous serez $Gprêt:prête; à aller sur le Plateau du Puits de soleil.‡将淬火的奎尔德拉浸入到太阳之井中。准备好进入太阳之井高地后，就同太阳之井守卫交谈。‡',
  }
},
[24609] = {
  {
    'Um presente para o Senhor de Altaforja‡Дар повелителю Стальгорна‡Ein Geschenk für den Lord von Eisenschmiede‡아이언포지 국왕에게 선물을‡Un regalo para el Señor de Forjaz‡Un regalo para el Señor de Forjaz‡Un cadeau pour le seigneur de Forgefer‡为铁炉堡国王准备的礼物‡給鐵爐堡國王的禮物',
    nil,
    'Presenteie o Rei Magni Barbabronze com uma Pulseira de Patuás Adoráveis em Altaforja.‡Подарите чудесный браслет-оберег королю Стальгорна Магни Бронзобороду.‡Schenkt König Magni Bronzebart in Eisenschmiede einen hübschen Glücksbringerarmreif.‡아이언포지에 있는 마그니 브론즈비어드에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos al rey Magni Barbabronce.‡Regálale una pulsera de talismanes preciosos al rey Magni Barbabronce.‡Offrez un Bracelet de breloques ravissantes au Roi Magni Barbe-de-bronze, à Forgefer.‡向铁炉堡的国王麦格尼·铜须献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給鐵爐堡的麥格尼·銅鬚國王。',
  }
},
[24610] = {
  {
    'Um presente para a alta-sacerdotisa de Eluna‡Дар Верховной жрице Элуны‡Ein Geschenk für die Hohepriesterin von Elune‡엘룬의 대여사제에게 선물을‡Un regalo para la Suma sacerdotisa de Elune‡Un regalo para la Suma sacerdotisa de Elune‡Un cadeau pour la grande prêtresse d\'Elune‡为艾露恩的高阶祭司准备的礼物‡給伊露恩的高階女祭司的禮物',
    nil,
    'Presenteie Tyrande Murmuréolo, em Darnassus, com uma Pulseira de Patuás Adoráveis.‡Подарите чудесный браслет-оберег Тиранде Шелест Ветра из Дарнаса.‡Schenkt Tyrande Wisperwind in Darnassus einen hübschen Glücksbringerarmreif.‡다르나서스에 있는 티란데 위스퍼윈드에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos a Tyrande Susurravientos en Darnassus.‡Regálale una pulsera de talismanes preciosos a Tyrande Susurravientos en Darnassus.‡Offrez un Bracelet de breloques ravissantes à Tyrande Murmevent, à Darnassus.‡向达纳苏斯的泰兰德·语风献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給達納蘇斯的泰蘭妲·語風。',
  }
},
[24611] = {
  {
    'Um presente para o Profeta‡Дар пророку Экзодара‡Ein Geschenk für den Propheten‡예언자에게 선물을‡Un regalo para el Profeta‡Un regalo para el Profeta‡Un cadeau pour le prophète‡为先知准备的礼物‡給預言者的禮物',
    nil,
    'Presenteie o Profeta Velen, em Exodar, com uma Pulseira de Patuás Adoráveis.‡Подарите чудесный браслет-оберег пророку Велену из Экзодара.‡Schenkt Prophet Velen in der Exodar einen hübschen Glücksbringerarmreif.‡엑소다르에 있는 예언자 벨렌에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos al profeta Velen en El Exodar.‡Regálale una pulsera de talismanes preciosos al profeta Velen en El Exodar.‡Offrez un Bracelet de breloques ravissantes au Prophète Velen, à l\'Exodar.‡向埃索达的先知维伦献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給艾克索達的預言者費倫。',
  }
},
[24612] = {
  {
    'Um presente para o Chefe Guerreiro‡Дар Вождю‡Ein Geschenk für den Kriegshäuptling‡대족장에게 선물을‡Un regalo para el Jefe de Guerra‡Un regalo para el Jefe de Guerra‡Un cadeau pour le chef de guerre‡为酋长准备的礼物‡給大酋長的禮物',
    nil,
    'Presenteie Thrall com uma Pulseira de Patuás Adoráveis em Orgrimmar.‡Подарите чудесный браслет-оберег Траллу из Оргриммара.‡Schenkt Thrall in Orgrimmar einen hübschen Glücksbringerarmreif.‡오그리마에 있는 스랄에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos a Thrall en Orgrimmar.‡Regálale una pulsera de talismanes preciosos a Thrall en Orgrimmar.‡Offrez un Bracelet de breloques ravissantes à Thrall, à Orgrimmar.‡向奥格瑞玛的萨尔献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給奧格瑪的索爾。',
  }
},
[24613] = {
  {
    'Um presente para a Rainha Banshee‡Дар королеве банши‡Ein Geschenk für die Bansheekönigin‡밴시 여왕에게 선물을‡Un regalo para la Reina alma en pena‡Un regalo para la Reina alma en pena‡Un cadeau pour la reine banshee‡为黑暗女王准备的礼物‡給女妖之王的禮物',
    nil,
    'Presenteie a Grande Dama Sylvana Correventos, na Cidade Baixa, com uma pulseira de patuás adoráveis.‡Подарите чудесный браслет-оберег леди Сильване Ветрокрылой из Подгорода.‡Schenkt Fürstin Sylvanas Windläufer in Unterstadt einen hübschen Glücksbringerarmreif.‡언더시티에 있는 여군주 실바나스 윈드러너에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos a Lady Sylvanas Brisaveloz en Entrañas.‡Regálale una pulsera de talismanes preciosos a Lady Sylvanas Brisaveloz en Entrañas.‡Offrez un Bracelet de breloques ravissantes à Dame Sylvanas Coursevent, à Fossoyeuse.‡向幽暗城中的希尔瓦娜斯·风行者女王献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給幽暗城的希瓦娜斯·風行者女士。',
  }
},
[24614] = {
  {
    'Um presente para o Grande Chefe‡Дар Верховному вождю‡Ein Geschenk für den Oberhäuptling‡대부족장에게 선물을‡Un regalo para el Gran jefe‡Un regalo para el Gran jefe‡Un cadeau pour le grand chef‡为大酋长准备的礼物‡給大酋長的禮物',
    nil,
    'Presenteie Caerne Casco Sangrento com uma Pulseira de Patuás Adoráveis no Penhasco do Trovão.‡Подарите чудесный браслет-оберег Кэрну Кровавому Копыту из Громового Утеса.‡Schenkt Cairne Bluthuf in Donnerfels einen hübschen Glücksbringerarmreif.‡썬더 블러프에 있는 케른 블러드후프에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos a Cairne Pezuña de Sangre en Cima del Trueno.‡Regálale una pulsera de talismanes preciosos a Cairne Pezuña de Sangre en Cima del Trueno.‡Offrez un Bracelet de breloques ravissantes à Cairne Sabot-de-sang, aux Pitons du Tonnerre.‡向雷霆崖的凯恩·血蹄酋长献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給雷霆崖的凱恩·血蹄。',
  }
},
[24615] = {
  {
    'Um presente para o lorde-regente de Quel\'Thalas‡Дар Правящему лорду Кель\'Таласа‡Ein Geschenk für den Lordregenten von Quel\'Thalas‡섭정 로르테마르 테론에게 선물을‡Un regalo para el Señor Regente de Quel\'Thalas‡Un regalo para el Señor regente de Quel\'Thalas‡Un cadeau pour le seigneur régent de Quel\'Thalas‡为奎尔萨拉斯的摄政王准备的礼物‡給奎爾薩拉斯攝政王的禮物',
    nil,
    'Presenteie Lor\'themar Theron, em Luaprata, com uma pulseira de patuás adoráveis.‡Подарите чудесный браслет-оберег Лор\'темару Терону из Луносвета.‡Schenkt Lor\'themar Theron in Silbermond einen hübschen Glücksbringerarmreif.‡실버문에 있는 로르테마르 테론에게 아름다운 장식 팔찌를 선물해야 합니다.‡Regálale una pulsera de talismanes preciosos a Lor\'themar Theron en Lunargenta.‡Regálale una pulsera de talismanes preciosos a Lor\'themar Theron en Lunargenta.‡Offrez un Bracelet de breloques ravissantes à Lor\'themar Theron, à Lune-d\'argent.‡向银月城的洛瑟玛·塞隆献上一件可爱的情人符手镯。‡將可愛符咒手鐲獻給銀月城的洛索瑪·塞隆。',
  }
},
[24629] = {
  {
    'Perfume de dinheiro‡Легкий аромат духов‡Ein perfekter Hauch von Parfüm‡매혹적인 향기의 향수‡El punto perfecto de perfume‡El punto perfecto de perfume‡Une parfaite petite pointe de parfum‡完美的香水‡完美香氛',
    nil,
    'Use o Vaporizador de Perfume Coroa em 10 pessoas.‡Опрыскайте десять прохожих из флакончика духов королевской компании с распылителем.‡Besprüht 10 Leute mit dem Parfümzerstäuber der Manufaktur Krone.‡왕관표 매혹적인 향수 분사기로 10명에게 향수를 뿌려야 합니다.‡Rocía a 10 personas con el vaporizador de colonia La Corona.‡Rocía a 10 personas con el vaporizador de colonia La Corona.‡Arrosez 10 personnes avec le Vaporisteur de parfum La Royale.‡用皇冠古龙水瓶向10个人喷洒古龙水。‡對著10個人使用王冠香水罐。',
  }
},
[24635] = {
  {
    'Lança-perfume‡Легкий аромат одеколона‡Ein feines Duftwasserwölkchen‡은은한 향기의 향수‡Cúmulo de colonia clásica‡Cúmulo de colonia clásica‡Un nuage de Cologne classieuse‡一滴优雅的古龙水‡典雅古龍',
    nil,
    'Use o Vaporizador de Colônia Coroa em 10 pessoas.‡Опрыскайте десять прохожих из флакончика одеколона королевской компании с распылителем.‡Besprüht 10 Leute mit dem Duftwasserzerstäuber der Manufaktur Krone.‡왕관표 은은한 향수 분사기로 10명에게 향수를 뿌려야 합니다.‡Rocía a 10 personas con el vaporizador de colonia La Corona.‡Rocía a 10 personas con el vaporizador de colonia La Corona.‡Aspergez 10 personnes avec le Vaporisateur d\'eau de Cologne La Royale.‡用皇冠古龙水瓶向10个人喷洒古龙水。‡對著10個人使用王冠古龍水罐。',
  }
},
[24636] = {
  {
    'Amor em pedaços‡Вкус конфет‡Bonbonangriff‡달콤한 홍보 전략‡Bombardeo de bombones‡Bombardeo de bombones‡Bombardement de bonbons‡糖果闪电战‡甜食總動員',
    nil,
    'Arremesse as Amostras de Chocolate Coroa para 10 pessoas.‡Раздайте десяти прохожим кусочки королевского шоколада.‡Bewerft 10 Leute mit Schokoladenproben der Manufaktur Krone.‡10명에게 시식용 왕관표 초콜릿을 던져야 합니다.‡Lanza muestras de chocolate de La Corona a 10 personas.‡Lanza muestras de chocolate de La Corona a 10 personas.‡Jetez à 10 personnes des échantillons de Goûte-chocolat La Royale.‡将皇冠巧克力样品抛掷给10个人。‡從王冠巧克力取樣器裡分送試吃品給10個人。',
  }
},
[24638] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡',
    nil,
    '‡Убейте 5 служащих химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к западу от врат Оргриммара в Дуротаре. После этого вернитесь к детективу Крямсу Гвоздезубу в Оргриммар.‡Tötet 5 Lakaien der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport gleich westlich der Tore Orgrimmars in Durotar zu beschädigen und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡듀로타의 오그리마 문밖 서쪽에 있는 왕관 하수인 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나에 피해를 입힌 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 lacayos de La Corona y utiliza la bomba de korio de Tuerceganzúas para dañar un vagón químico al oeste de las puertas de Orgrimmar, en Durotar, y después vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 lacayos de La Corona y utiliza la bomba de korio de Tuerceganzúas para dañar un vagón químico al oeste de las puertas de Orgrimmar, en Durotar, y después vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Laquais de la Compagnie Royale de Chimie et utilisez la Bombe en khorium de Tordboulon pour endommager un Chariot de produits chimiques à l\'ouest des portes d\'Orgrimmar, en Durotar, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24645] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 головорезов химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами за вратами Янтарной мельницы, в Серебряном бору. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Rohlinge der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport außerhalb Mühlenberns im Silberwald zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡은빛소나무 숲의 호박색 농장 밖에 있는 왕관 폭력배 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 matones de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Molino Ámbar en el Bosque de Argénteos. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 matones de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Molino Ámbar en el Bosque de Argénteos. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Nervis de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à Moulin-de-l\'Ambre, dans la Forêt des Pins-Argentés, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24647] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 уборщиков химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами за пределами Хиллсбрада, в предгорьях. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Gauner der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport außerhalb des Hügellandhofs im Vorgebirge des Hügellands zu zerstören und kehrt zu Snap Schnappbolz in Orgrimmar zurück.‡언덕마루 구릉지의 언덕마루 마을 밖에 있는 왕관 용역직원 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 desempolvadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de la ciudad de Trabalomas en Laderas de Trabalomas, y después vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 desempolvadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de la ciudad de Trabalomas en Laderas de Trabalomas, y después vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Epousseteurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'extérieur de Hautebrande, aux Contreforts de Hautebrande, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24648] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡',
    nil,
    '‡Убейте 5 забияк химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами возле Сторожевого поста за пределами Терамора в Пылевых топях. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Gangster der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport außerhalb von Theramore in den Düstermarschen zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡먼지진흙 습지대의 테라모어 밖에 있는 왕관 폭도 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 macarras de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Theramore en Marjal Revolcafango. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 macarras de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Theramore en Marjal Revolcafango. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Truands de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'extérieur de Theramore, au Marécage d\'Âprefange, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24649] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡',
    nil,
    '‡Убейте 5 агентов химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к западу от Заоблачного пика, во Внутренних землях. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Agenten der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich des Nistgipfels im Hinterland zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡‡Mata a 5 agentes de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Pico Nidal en las Tierras del Interior. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 agentes de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Pico Nidal en las Tierras del Interior. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Agents de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Nid-del\'Aigle, dans les Hinterlands, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24650] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 окропителей химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами в Зимних ключах, к востоку от Круговзора. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Besprenkler der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich der Ewigen Warte in Winterquell zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡‡Mata a 5 rociadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en Cuna del Invierno, al este de Vista Eterna. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 rociadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en Cuna del Invierno, al este de Vista Eterna. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Arroseurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Long-Guet, à Berceau-de-l\'Hiver, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24651] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 стажеров химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к востоку от Шаттрата, в лесу Тероккар. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Untergebene der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich von Shattrath in den Wäldern von Terokkar zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡샤트라스 동쪽의 테로카르 숲에 있는 왕관 청부업자 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 subordinados de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Shattrath, en el Bosque de Terokkar. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 subordinados de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Shattrath, en el Bosque de Terokkar. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Sous-fifres de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Shattrath, dans la Forêt de Terokkar, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24652] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 распылителей химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами в Опустевших лесах Хрустальной Песни, что к северо-западу от Зеркала Сумерек. После этого вернитесь к детективу в Оргриммар.‡Tötet 5 Sprüher der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport in den Trostlosen Wäldern des Kristallsangwalds zu zerstören und kehrt zu Detektiv Snap Schnappbolz in Orgrimmar zurück.‡수정노래 숲의 쓸쓸한 숲에 있는 왕관 화학병 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 오그리마에 있는 명탐정 스냅 스내글볼트에게 가야 합니다.‡Mata a 5 pulverizadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en El Bosque Desolado en el Bosque Canto de Cristal. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Mata a 5 pulverizadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en El Bosque Desolado en el Bosque Canto de Cristal. Después, vuelve con el detective Snap Tuerceganzúas en Orgrimmar.‡Tuez 5 Diffuseurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques au Bois Lugubre, dans la Forêt du Chant de cristal, puis retournez voir l\'Inspecteur Lapince Tordboulon à Orgrimmar.‡‡',
  }
},
[24655] = {
  {
    'Alguma coisa fede‡Дышать нечем!‡Irgendwas stinkt hier‡이게 무슨 냄새야?‡Algo apesta‡Algo apesta‡Il y a quelque chose de pourri…‡恶臭的东西‡事有蹊蹺',
    nil,
    'Use o Analisador de Ar do Garrafuso para testar o ar ao redor de 6 guardas bastante perfumados e, então, fale novamente com o Inspetor Estrilo Garrafuso em Ventobravo.‡Изучите состав воздуха вокруг шести надушенных стражников при помощи анализатора воздуха Гвоздезуба, а затем вернитесь к детективу с результатами.‡Verwendet Schnappbolzens Luftanalysegerät, um die Luft zu untersuchen, die 6 stark parfümierte Wachen umgibt, und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡스내글볼트의 공기 분석기를 사용해 향수 범벅이 된 경비병 6명 주위의 공기를 분석하고, 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 돌아가야 합니다.‡Usa el analizador de aire de Tuerceganzúas para analizar el aire alrededor de 6 guardias altamente perfumados. Luego vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Usa el analizador de aire de Tuerceganzúas para analizar el aire alrededor de 6 guardias altamente perfumados. Luego vuelve con el inspector Snip Tuerceganzúas en Orgrimmar.‡Utilisez l\'Analyseur d\'air de Tordboulon pour tester l\'air autour de 6 Gardes lourdement parfumés, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡使用滑栓的空气分析器测试6位带有浓郁香气的卫兵周围的空气，然后返回暴风城，去见探员斯尼普·滑栓。‡使用『凸栓的空氣分析器』來測試6名香味濃郁的守衛四周的氣味，然後回暴風城找巡官史尼卜·凸栓。',
  }
},
[24656] = {
  {
    '‡Позаимствовать духи‡Parfümdiebstahl‡향수 슬쩍하기‡Afanar el aroma‡Afanar el aroma‡Dérober du parfum‡香水行动‡竊取香水',
    nil,
    '‡Замаскировавшись под посыльного, отправляйтесь к воротам Штормграда, возле которых находятся товары Королевской химической компании. Добудьте ящик Королевской компании и вернитесь к инспектору Кромсу Гвоздезубу в Штормград.‡Begebt Euch, während Ihr als Lieferbursche verkleidet seid, zum Vorratslager der Chemiemanufaktur Krone vor den Toren Sturmwinds, kehrt dann mit dem Paket, das sie Euch zuwerfen, zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡택배 배달원으로 변장한 상태에서 스톰윈드 문 바깥에 왕관화학회사의 짐이 쌓인 곳으로 간 다음, 던져 주는 상자를 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가져가야 합니다.‡Mientras estés $Gdisfrazado:disfrazada; de mensajero, ve al montón de cajones de Químicos La Corona, S.L. fuera de las puertas de Ventormenta y vuelve con el paquete que te lancen a ver al inspector Snip Tuerceganzúas en Ventormenta.‡Mientras estés $Gdisfrazado:disfrazada; de mensajero, ve al montón de cajones de Químicos La Corona, S.L. fuera de las puertas de Ventormenta y vuelve con el paquete que te lancen a ver al inspector Snip Tuerceganzúas en Ventormenta.‡Mettez le Déguisement de coursier, rendez-vous à la Réserve de la Compagnie de Chimie La Royale à l\'extérieur des portes de Hurlevent, puis rapportez le paquet qu\'on vous aura jeté à l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡被伪装成一个送包裹的人之后，前往暴风城大门外皇冠药剂公司的物资存放处，然后将他们给你的包裹交给暴风城的探员斯尼普·滑栓。‡',
  }
},
[24657] = {
  {
    '‡Разговор по душам...‡Eine nette Unterhaltung...‡우호적인 대화...‡Una charla amistosa...‡Una charla amistosa...‡On va juste discuter gentiment…‡友善地交谈……‡善意的溝通...',
    nil,
    '‡Отправляйтесь в Порт Штормграда и допросите Снивела Ржавстера. Постарайтесь получить хоть какие-нибудь доказательства.‡Begebt Euch zum Hafen von Sturmwind und befragt Flenni Rostrakete zu den Vorräten. Kehrt mit den erhaltenen Informationen zurück.‡스톰윈드 항구로 가서 스니블 러스트로켓에게 물품에 대해 물은 후, 단서를 얻어 돌아와야 합니다.‡Ve al Puerto de Ventormenta e interroga a Quejica Misilóxido sobre los suministros. Vuelve con cualquier prueba que te aporte.‡Ve al Puerto de Ventormenta e interroga a Quejica Misilóxido sobre los suministros. Vuelve con cualquier prueba que te aporte.‡Rendez-vous au Port de Hurlevent et questionnez Rouillefusée à propos des fournitures. Revenez avec les preuves qu\'il vous aura données.‡前往暴风城港口，向斯内维尔·拉斯罗凯特询问关于供给物资的事情。然后带着他给你的证据回去。‡',
  }
},
[24658] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡',
    nil,
    '‡Убейте 5 служащих химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к северо-востоку от Гарнизона у Западного ручья, что за пределами Элвинна. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Lakaien der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport nordöstlich der Weststromgarnison im Wald von Elwynn zu beschädigen und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡‡Mata a 5 lacayos de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al noreste del Cuartel de Arroyoeste, en el Bosque de Elwynn. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 lacayos de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al noreste del Cuartel de Arroyoeste, en el Bosque de Elwynn. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Laquais de La Royale et utilisez la Bombe en khorium de Tordboulon pour endommager un Chariot de produits chimiques au nord-est de la Garnison du ruisseau de l\'Ouest, à la Forêt d\'Elwynn, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24659] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 головорезов химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к югу от Рощи Древних, на Темных берегах. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Rohlinge der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport südlich des Hains der Uralten an der Dunkelküste zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡어둠해안에 있는 고대정령의 숲 남쪽의 왕관 폭력배 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가야 합니다.‡Mata a 5 matones de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al sur del Páramo de los Ancianos en Costa Oscura. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 matones de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al sur del Páramo de los Ancianos en Costa Oscura. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Nervis de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques au sud du Bosquet des Anciens, à Sombrivage, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24660] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 уборщиков химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами за пределами Хиллсбрада, в предгорьях. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Gauner der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport auf dem verlassenen Bauernhof südöstlich von Dunkelhain im Dämmerwald zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡‡Mata a 5 desempolvadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en la granja abandonada al sureste de Villa Oscura, en el Bosque del Ocaso, y después vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 desempolvadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en la granja abandonada al sureste de Villa Oscura, en el Bosque del Ocaso, y después vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Épousseteurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques près de la ferme abandonnée au sud-est de Sombre-Comté, dans le Bois de la Pénombre, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24662] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 забияк химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами возле Сторожевого поста за пределами Терамора в Пылевых топях. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Gangster der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport außerhalb Theramores in den Düstermarschen zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡먼지진흙 습지대의 테라모어 밖에 있는 왕관 폭도 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 돌아가야 합니다‡Mata a 5 macarras de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Theramore en Marjal Revolcafango. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 macarras de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico a las afueras de Theramore en Marjal Revolcafango. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Truands de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'extérieur de Theramore, au Marécage d\'Âprefange, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24663] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡',
    nil,
    '‡Убейте 5 агентов химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к западу от Заоблачного пика, во Внутренних землях. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Agenten der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich des Nistgipfels im Hinterland zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡동부 내륙지의 맹금의 봉우리 동쪽에 있는 왕관 요원 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가야 합니다.‡Mata a 5 agentes de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Pico Nidal en las Tierras del Interior. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 agentes de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Pico Nidal en las Tierras del Interior. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Agents de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Nid-del\'Aigle, dans les Hinterlands, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24664] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 окропителей химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами в Зимних ключах, к востоку от Круговзора. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Besprenkler der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich der Ewigen Warte in Winterquell zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡여명의 설원에 있는 눈망루 마을의 왕관 조직원 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 돌아가야 합니다.‡Mata a 5 rociadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Vista Eterna, en Cuna del Invierno. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 rociadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Vista Eterna, en Cuna del Invierno. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Arroseurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Long-Guet, à Berceau-de-l\'Hiver, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24665] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 стажеров химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами к востоку от Шаттрата, в лесу Тероккар. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Untergebene der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport östlich von Shattrath in den Wäldern von Terokkar zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡테로카르 숲에 있는 샤트라스 동쪽의 왕관 청부업자 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가야 합니다.‡Mata a 5 subordinados de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Shattrath, en el Bosque de Terokkar. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 subordinados de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico al este de Shattrath, en el Bosque de Terokkar. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Sous-fifres de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques à l\'est de Shattrath, dans la Forêt de Terokkar, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24666] = {
  {
    '‡Конец Королевской компании‡Die Krone zerschmettern‡왕관사 무너뜨리기‡Aplasta La Corona‡Aplasta La Corona‡Détrôner la Royale‡粉碎皇冠药剂公司‡摧毀化學製藥公司',
    nil,
    '‡Убейте 5 распылителей химической компании и воспользуйтесь кориевой бомбой Гвоздезуба, чтобы уничтожить повозку с химикатами в Опустевших лесах Хрустальной Песни, что к северо-западу от Зеркала Сумерек. После этого вернитесь к инспектору в Штормград.‡Tötet 5 Sprüher der Manufaktur Krone, verwendet Schnappbolzens Khoriumbombe, um einen Chemietransport in den Trostlosen Wäldern des Kristallsangwalds zu zerstören und kehrt zu Inspektor Snip Schnappbolz in Sturmwind zurück.‡수정노래 숲의 쓸쓸한 숲에 있는 왕관 화학병 5명을 처치하고 스내글볼트의 코륨 폭탄으로 화학약품 수레 하나를 파괴한 후 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가야 합니다.‡Mata a 5 pulverizadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en El Bosque Desolado en el Bosque Canto de Cristal. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Mata a 5 pulverizadores de La Corona y utiliza la bomba de korio de Tuerceganzúas para destruir un vagón químico en El Bosque Desolado en el Bosque Canto de Cristal. Después, vuelve con el inspector Snip Tuerceganzúas en Ventormenta.‡Tuez 5 Diffuseurs de La Royale et utilisez la Bombe en khorium de Tordboulon pour détruire un Chariot de produits chimiques au Bois Lugubre, dans la Forêt du Chant de cristal, puis retournez voir l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡‡',
  }
},
[24682] = {
  {
    '‡Яма Сарона‡Die Grube von Saron‡사론의 구덩이‡El Foso de Saron‡El Foso de Saron‡La fosse de Saron‡萨隆矿坑‡薩倫之淵',
    nil,
    '‡Встретьтесь с леди Сильваной Ветрокрылой на входе в Яму Сарона.‡Trefft Fürstin Sylvanas Windläufer am Eingang zur Grube von Saron.‡‡Reúnete con Lady Sylvanas Brisaveloz dentro de la entrada del Foso de Saron.‡Reúnete con Lady Sylvanas Brisaveloz dentro de la entrada del Foso de Saron.‡Retrouvez Dame Sylvanas Coursevent dans l\'entrée de la Fosse de Saron.‡‡',
  }
},
[24683] = {
  {
    '‡Яма Сарона‡Die Grube von Saron‡사론의 구덩이‡El Foso de Saron‡El Foso de Saron‡La fosse de Saron‡萨隆矿坑‡薩倫之淵',
    nil,
    '‡Встретьтесь с леди Джайной Праудмур в Яме Сарона.‡Trefft Lady Jaina Prachtmeer in der Grube von Saron.‡사론의 구덩이의 안쪽에서 여군주 제이나 프라우드무어를 만나야 합니다.‡Reúnete con Lady Jaina Valiente nada más entrar en el Foso de Saron.‡Reúnete con Lady Jaina Valiente al entrar en el Foso de Saron.‡Retrouvez Dame Jaina Portvaillant juste à l\'entrée de la Fosse de Saron.‡在萨隆矿坑和吉安娜·普罗德摩尔见面。‡',
  }
},
[24710] = {
  {
    '‡Зачистка Ямы‡Befreiung aus der Grube‡구덩이로부터의 해방‡Liberación del Foso‡Liberación del Foso‡Libérés de la fosse‡深渊的裁决‡逃離深淵',
    nil,
    '‡Убейте Повелителя Плети Тирания.‡Tötet Geißelfürst Tyrannus.‡스컬지군주 티라누스를 처치해야 합니다.‡Mata al Señor de la Plaga Tyrannus.‡Mata al Señor de la Plaga Tyrannus.‡Tuez le Seigneur du Fléau Tyrannus.‡杀死天灾领主泰兰努斯。‡',
  }
},
[24711] = {
  {
    '‡Ледяная Скорбь‡Frostgram‡서리한‡La Agonía de Escarcha‡La Agonía de Escarcha‡Deuillegivre‡霜之哀伤‡霜之哀傷',
    nil,
    '‡Встретьтесь с леди Джайной Праудмур у входа в Залы Отражений.‡Trefft Lady Jaina Prachtmeer am Eingang zu den Hallen der Reflexion.‡투영의 전당 입구에서 여군주 제이나 프라우드무어를 만나야 합니다.‡Reúnete con Lady Jaina Valiente a la entrada de Las Cámaras de Reflexión.‡Reúnete con Lady Jaina Valiente a la entrada de Las Cámaras de Reflexión.‡Retrouvez Dame Jaina Portvaillant à l\'entrée des Salles des Reflets.‡在映像大厅的入口与吉安娜女士汇合。‡',
  }
},
[24712] = {
  {
    '‡Зачистка Ямы‡Befreiung aus der Grube‡구덩이로부터의 해방‡Liberación del Foso‡Liberación del Foso‡Libérés de la fosse‡深渊的裁决‡逃離深淵',
    nil,
    '‡Убейте Повелителя Плети Тирания.‡Tötet Geißelfürst Tyrannus.‡스컬지군주 티라누스를 처치해야 합니다.‡Mata al Señor de la Plaga Tyrannus.‡Mata al Señor de la Plaga Tyrannus.‡Tuez le Seigneur du Fléau Tyrannus.‡杀死天灾领主泰兰努斯。‡',
  }
},
[24713] = {
  {
    '‡Ледяная Скорбь‡Frostgram‡서리한‡La Agonía de Escarcha‡La Agonía de Escarcha‡Deuillegivre‡霜之哀伤‡霜之哀傷',
    nil,
    '‡Встретьтесь с леди Сильваной Ветрокрылой на входе в Залы Отражений.‡Trefft Fürstin Sylvanas Windläufer am Eingang zu den Hallen der Reflexion.‡투영의 전당 입구 안쪽에 있는 여군주 실바나스 윈드러너를 만나야 합니다.‡Reúnete con Lady Sylvanas Brisaveloz dentro de la entrada de Las Cámaras de Reflexión.‡Reúnete con Lady Sylvanas Brisaveloz dentro de la entrada de Las Cámaras de Reflexión.‡Retrouvez Dame Sylvanas Coursevent à l\'entrée des Salles des Reflets.‡在映像大厅的入口与希尔瓦娜斯汇合。‡',
  }
},
[24743] = {
  {
    '‡Грань Тьмы‡Schattenschneide‡어둠의 칼날도끼‡El Filo de las Sombras‡El Filo de las Sombras‡Tranchant de l\'ombre‡影锋‡暗影之鋒',
    nil,
    nil,
  }
},
[24745] = {
  {
    'Algo está no ar (e não é o amor)‡Не любовь витает в воздухе (а что-то иное!)‡Irgendwas liegt in der Luft (und Liebe ist es nicht)‡사랑은 아니지만, 무언가 특별한 분위기에 휩싸여‡Hay algo en el aire (y no es amor)‡Hay algo en el aire (y no es amor)‡Il y a quelque chose dans l\'air (et ce n\'est pas de l\'amour)‡微妙的气氛（肯定不是爱）‡微妙的氣氛(肯定不是愛)',
    nil,
    'Entregue o Adorável Cartão Esmaecido para o Inspetor Estrilo Garrafuso em Ventobravo.‡Принесите выцветшую открытку ко дню всех влюбленных инспектору Кромсу Гвоздезубу в Штормград.‡Bringt die vergilbte schöne Grußkarte zu Inspektor Snip Schnappbolz in Sturmwind.‡빛 바랜 아름다운 카드를 스톰윈드에 있는 수사반장 스닙 스내글볼트에게 가져가야 합니다.‡Llévale la tarjeta preciosa descolorida al inspector Snap Tuerceganzúas en Ventormenta.‡Llévale la tarjeta preciosa descolorida al inspector Snap Tuerceganzúas en Ventormenta.‡Rapportez la Ravissante carte de vœux décolorée à l\'Inspecteur Latenaille Tordboulon à Hurlevent.‡将褪色的情人节卡片交给暴风城的探员斯尼普·滑栓。‡把褪色的可愛邀請卡拿給暴風城的巡官史尼卜·凸栓。',
  }
},
[24746] = {
  {
    'REUSE‡REUSE‡NEU VERWENDEN‡재사용‡REUSE‡REUSE‡RÉUTILISER‡REUSE‡重複利用',
    nil,
    nil,
  }
},
[24748] = {
  {
    '‡Последняя битва Короля-лича‡Das letzte Gefecht des Lichkönigs‡리치 왕, 그 최후의 저항‡La última batalla del Rey Exánime‡La última batalla del Rey Exánime‡Le dernier rempart du roi-liche‡巫妖王最后的阵地‡巫妖王的末日',
    nil,
    '‡Верховный лорд Дарион Могрейн приказал вам убить Короля-лича.‡Hochlord Darion Mograine in der Eiskronenzitadelle will, dass Ihr den Lichkönig tötet.‡얼음왕관 성채에 있는 대영주 다리온 모그레인이 리치 왕을 처치하라고 했습니다.‡El Alto señor Darion Mograine, en la Ciudadela de la Corona de Hielo, quiere que mates al Rey Exánime.‡El Alto señor Darion Mograine, en la Ciudadela de la Corona de Hielo, quiere que mates al Rey Exánime.‡Le Généralissime Darion Mograine, à la Citadelle de la Couronne de glace, vous a demandé de tuer le Roi-liche.‡冰冠堡垒中的大领主达里安·莫格莱尼希望你去消灭巫妖王。‡',
  }
},
[24749] = {
  {
    '‡Сила нечестивости‡Erfüllt mit unheiliger Macht‡부정 주입‡Infusión profana‡Infusión profana‡Infusion d\'impie‡注入邪恶‡穢邪之能',
    nil,
    '‡Верховный лорд Дарион Могрейн приказал вам наполнить Грань Тьмы силой нечестивости и убить профессора Мерзоцида.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine möchte, dass Ihr Schattenschneide mit unheiliger Macht erfüllt und Professor Seuchenmord tötet.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼에 부정의 힘을 주입하고 교수 퓨트리사이드를 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El Alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con poder profano y mates al profesor Putricidio.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores en la Ciudadela de la Corona de Hielo.‡El Alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con poder profano y mates al profesor Putricidio.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores en la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine veut que vous infusiez Tranchant de l\'ombre avec de la puissance Impie et que vous abattiez le Professeur Putricide.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼要你用邪恶能量灌注影锋，并杀死普崔塞德教授。|n|n该任务只能在冰冠堡垒25人模式下完成。‡',
  }
},
[24756] = {
  {
    '‡Сила крови‡Erfüllt mit der Macht des Blutes‡혈기 주입‡Infusión de sangre‡Infusión de sangre‡Infusion de sang‡鲜血灌注‡血魄之能',
    nil,
    '‡Верховный лорд Дарион Могрейн приказал вам наполнить Грань Тьмы силой крови и убить королеву Лана\'тель.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine möchte, dass Ihr Schattenschneide mit der Macht des Blutes erfüllt und Blutkönigin Lana\'thel besiegt.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼에 혈기를 주입하고 여왕 라나텔을 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con sangre y que acabes con la reina Lana\'thel.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡El alto señor Darion Mograine quiere que imbuyas el Filo de las Sombras con sangre y que acabes con la reina Lana\'thel.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine veut que vous infusiez Tranchant de l\'ombre avec du sang et que vous battiez la Reine Lana\'thel.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼要你使用鲜血灌注影锋，并击败鲜血女王兰娜瑟尔。|n|n该任务只能在25人难度的冰冠堡垒中完成。‡',
  }
},
[24757] = {
  {
    '‡Сила льда‡Erfüllt mit der Macht des Frostes‡냉기 주입‡Infusión de Escarcha‡Infusión de Escarcha‡Infusion de givre‡冰霜灌注‡冰霜之能',
    nil,
    '‡Верховный лорд Дарион Могрейн приказал вам четыре раза попасть под действие ледяного дыхания Синдрагосы, держа при себе Грань Тьмы, после чего убить дракона.|n|nЭто задание можно выполнить только в рейде для 25 игроков в Цитадели Ледяной Короны.‡Hochlord Darion Mograine hat Euch den Auftrag erteilt, Sindragosa zu töten, nachdem Ihr 4-mal ihren Atemattacken ausgesetzt wart, während Ihr Schattenschneide führt.|n|nDiese Quest kann nur im Schwierigkeitsgrad für 25 Mann der Eiskronenzitadelle abgeschlossen werden.‡대영주 다리온 모그레인이 어둠의 칼날도끼를 사용하면서 신드라고사의 숨결 공격을 4번 견딘 다음 처치하라고 했습니다.|n|n이 퀘스트는 얼음왕관 성채 25인 난이도에서만 완료할 수 있습니다.‡El Alto señor Darion Mograine te ha ordenado que mates a Sindragosa tras sobrevivir a 4 de sus ataques de aliento mientras blandes el Filo de las Sombras.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡El Alto señor Darion Mograine te ha ordenado que mates a Sindragosa tras sobrevivir a 4 de sus ataques de aliento mientras blandes el Filo de las Sombras.|n|nEsta misión solo se puede completar en el modo de dificultad de 25 jugadores de la Ciudadela de la Corona de Hielo.‡Le Généralissime Darion Mograine vous a donné l\'ordre de tuer Sindragosa après avoir subi vous-même 4 de ses attaques de souffle tout en utilisant Tranchant de l\'ombre.|n|nCette quête peut uniquement être effectuée en mode 25 joueurs de la Citadelle de la Couronne de glace.‡大领主达里安·莫格莱尼对你做出了指示，他要你在使用影锋与辛达苟萨战斗时，经受住辛达苟萨的四次气息攻击，然后再杀死她。|n|n该任务只能在25人难度的冰冠堡垒中完成。‡',
  }
},
