    nil,
  }
},
[8866] = {
  {
    'Barbabronze, o Ancião‡Предок Бронзобород‡Urahne Bronzebart‡장로 브론즈비어드‡Barbabronce el Ancestro‡Barbabronce el Ancestro‡L\'Ancien Barbe-de-bronze‡铜须长者‡銅鬚長者',
    nil,
    nil,
  }
},
[8867] = {
  {
    'Fogos de artifício da Lua‡Лунный фейерверк‡Mondfeuerwerk‡달의 축제 불꽃놀이‡Fuegos artificiales lunares‡Fuegos artificiales lunares‡Le feu d\'artifice lunaire‡春节烟花‡新年煙火',
    nil,
    'Lance 8 Fogos de Artifício da Lua, 2 Salvas de Fogos de Artifício e fale novamente com a Anfitriã do Festival da Lua em qualquer cidade capital.‡Запустите 8 лунных фейерверков и 2 ракеты. Вернитесь к предвестнице Лунного фестиваля в любую столицу.‡Zündet 8 Raketen und 2 Raketenbündel und kehrt dann zu einer Botin des Mondfests in irgendeiner Hauptstadt zurück.‡축제 폭죽 8개, 연발탄 폭죽 2개를 발사한 후 수도에 있는 달의 축제 사절에게 돌아가야 합니다.‡Dispara 8 fuegos artificiales lunares y 2 cohetes y acude a una presagista del Festival Lunar de cualquier capital.‡Dispara 8 fuegos artificiales lunares y 2 cohetes y acude a una presagista del Festival Lunar de cualquier capital.‡Lancez 8 Feux d\'artifice lunaires et 2 Chapelets de feux d\'artifice lunaires et retournez voir une Messagère de la Fête lunaire dans l\'une des capitales.‡点燃8枚春节烟花和2组春节烟花束，然后回到任何一座主城的春节预告者身边。‡點燃8枚新年煙花和2組新年煙花束，然後回到任何一座主城的新年預告者身邊。',
  }
},
[8868] = {
  {
    'Bênção de Eluna‡Благословение Элуны‡Elunes Segen‡엘룬의 축복‡La bendición de Elune‡La bendición de Elune‡La bénédiction d\'Elune‡艾露恩的祝福‡伊露恩的祝福',
    nil,
    'Evoque Agouro, derrote-o e ganhe a Bênção de Eluna. Fale com Valadar Stelacanto no Refúgio Noturno.‡Призовите Омена, победите его и получите благословение Элуны. Вернитесь к Валадару Звездной Песне в Ночную Гавань.‡Beschwört Omen, besiegt ihn und erlangt Elunes Segen. Kehrt anschließend zu Valadar Sternensang in Nachthafen zurück.‡오멘을 소환한 후 그를 처치하여 엘룬의 축복을 얻고 나이트헤이븐에 있는 발라다르 스타송에게 돌아가야 합니다.‡Invoca a Augurio y derrótalo para ganar la bendición de Elune. Ve a ver a Valadar Cantoestelar a Amparo de la Noche.‡Invoca a Augurio y derrótalo para ganar la bendición de Elune. Ve a ver a Valadar Cantoestelar a Amparo de la Noche.‡Invoquez Présage, et vainquez-le pour gagner la Bénédiction d\'Elune. Puis retournez voir Valadar Chantétoile à Havrenuit.‡召唤年兽，击败它，并获得艾露恩的祝福。完成任务之后回到永夜港的瓦拉达尔·星歌那里。‡召喚年獸，擊敗他並獲得伊露恩的祝福。再回到永夜港找瓦拉達爾·星歌。',
  }
},
[8869] = {
  {
    'Doce serenidade‡Секрет безмятежности‡Süße Beschaulichkeit‡진홍십자군 작업복‡Dulce serenidad‡Dulce serenidad‡Douce sérénité‡甜美的平静‡甜美的平靜',
    nil,
    'Vá para Stratholme e mate o Forjador de Martelos Carmesim. Recolha o Avental do Forjador de Martelos Carmesim e leve-o para Lilith.|n‡Отправляйтесь в Стратхольм и убейте молотобойца из Багрового легиона. Возьмите его фартук и возвращайтесь к Лилит.‡Begebt Euch nach Stratholme und tötet den purpurroten Hammerschmied. Nehmt die Schürze des purpurroten Hammerschmiedes und kehrt zu Lilith zurück.‡스트라솔름으로 가서 진홍십자군 대장장이를 처치하고 진홍십자군 대장장이의 작업복을 가지고 릴리스에게 돌아가야 합니다.‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.|n‡Viaja a Stratholme y mata al forjamartillos Carmesí. Consigue el delantal del forjamartillos Carmesí y regresa con Lilith.|n‡Aller jusqu\'à Stratholme et tuer le Forgeur de marteaux cramoisi. Récupérer son Tablier et le ramener à Lilith.‡到斯坦索姆去杀死红衣铸锤师。将红衣铸锤师的围裙交给莉莉丝。‡到斯坦索姆去殺死紅衣錘類鍛造師。將紅衣錘類鍛造師的圍裙交給莉莉絲。',
  }
},
[8870] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua na Ala Mística de Altaforja. Você também pode falar com Anfitriãs do Festival da Lua em outras capitais.‡Поговорите с предвестницей Лунного фестиваля в Палатах Магии Стальгорна. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests im Mystikerviertel von Eisenschmiede. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡아이언포지의 마법 지구에 있는 달의 축제 사절과 대화해야 합니다. 또한 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con la presagista del Festival Lunar en la Sala Mística de Forjaz. También puedes hablar con la presagista del Festival Lunar en otras capitales.‡Habla con la presagista del Festival Lunar en la Sala Mística de Forjaz. También puedes hablar con la presagista del Festival Lunar en otras capitales.‡Parler à la Messagère de la Fête lunaire à la Garde mystique de Forgefer. Vous pouvez aussi parler aux messagères de la Fête lunaire des autres capitales.‡与铁炉堡秘法区的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡與鐵爐堡秘法區的新年預告者談話，你也可以在其他主要城市跟新年預告者談話。',
  }
},
[8871] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua no Distrito do Parque de Ventobravo. Você também pode falar com outros Anfitriões do Festival da Lua em outras capitais.‡Поговорите с предвестницей Лунного фестиваля в парке Штормграда. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests im Parkviertel von Sturmwind. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡스톰윈드의 공원에 있는 달의 축제 사절과 대화해야 합니다. 또한 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con el presagista del Festival Lunar en el Distrito del Parque, en Ventormenta. También puedes hablar con otras presagistas del Festival Lunar de otras capitales.‡Habla con la presagista del Festival Lunar en el distrito del parque de Ventormenta. También puedes hablar con presagistas del Festival Lunar en otras capitales.‡Parler à la Messagère de la Fête lunaire au Parc de Hurlevent. Vous pouvez aussi parler aux messagères de la Fête lunaire des autres capitales.‡与暴风城花园区的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡與暴風城花園區的新年預告者談話，你也可以在其他主要城市跟新年預告者說話。',
  }
},
[8872] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua no Enclave Cenariano, em Darnassus. Há, nas outras capitais, outras Anfitriãs do Festival da Lua com quem se pode falar.‡Поговорите с предвестницей Лунного фестиваля в дарнасском анклаве Кенария. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests in der Enklave des Cenarius in Darnassus. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡다르나서스의 세나리온 자치령에 있는 달의 축제 사절과 대화해야 합니다. 또한 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con la presagista del Festival Lunar en el Enclave Cenarion de Darnassus. También puedes hablar con los presagistas del Festival Lunar en otras capitales.‡Habla con la presagista del Festival Lunar en el Enclave Cenarion de Darnassus. También puedes hablar con los presagistas del Festival Lunar en otras capitales.‡Parler à la Messagère de la Fête lunaire à l\'Enclave cénarienne de Darnassus. Vous pouvez aussi parler aux messagères de la Fête lunaire des autres capitales.‡与达纳苏斯塞纳里奥区的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡到達納蘇斯，與在塞納里奧區的新年預告者談話，你也可以在其他主要城市跟新年預告者談話。',
  }
},
[8873] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua no Vale da Sabedoria em Orgrimmar. Você também pode falar com Anfitriãs do Festival da Lua em outras capitais.‡Поговорите с предвестницей Лунного фестиваля в Аллее Мудрости в Оргриммаре. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests im Tal der Weisheit in Orgrimmar. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡오그리마의 지혜의 골짜기에 있는 달의 축제 사절과 대화해야 합니다. 또한 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con la presagista del Festival Lunar en el Valle de la Sabiduría, en Orgrimmar. También puedes hablar con la presagista del Festival Lunar en otras capitales.‡Habla con la presagista del Festival Lunar en el Valle de la Sabiduría, en Orgrimmar. También puedes hablar con la presagista del Festival Lunar en otras capitales.‡Parler à la Messagère de la Fête lunaire dans la Vallée de la sagesse à Orgrimmar. Vous pouvez aussi parler aux messagères de la Fête lunaire des autres capitales.‡与奥格瑞玛智慧谷的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡與奧格瑪智慧谷的新年預告者談話，你也可以在其他主要城市跟新年預告者談話。',
  }
},
[8874] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua na entrada da Cidade Baixa. Você também pode falar com outros Anfitriões do Festival da Lua em outras capitais.‡Поговорите с предвестницей Лунного фестиваля у входа в Подгород. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests am Eingang zur Unterstadt. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡언더시티의 입구에 있는 달의 축제 사절과 대화해야 합니다. 또한 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con la presagista del Festival Lunar en la entrada de Entrañas. También puedes hablar con otras presagistas del Festival Lunar de otras capitales.‡Habla con la presagista del Festival Lunar en la entrada de Entrañas. También puedes hablar con otras presagistas del Festival Lunar de otras capitales.‡Parler à la Messagère de la Fête lunaire à l\'entrée de Fossoyeuse. Vous pouvez aussi parler aux messagères de la Fête lunaire des autres capitales.‡与幽暗城入口处的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡與幽暗城入口的新年預告者談話，你也可以在其他主要城市跟新年預告者談話。',
  }
},
[8875] = {
  {
    'O Festival da Lua‡Лунный фестиваль‡Das Mondfest‡달의 축제‡El Festival Lunar‡El Festival Lunar‡La fête lunaire‡春节将至！‡新年慶典',
    nil,
    'Fale com a Anfitriã do Festival da Lua no Platô dos Anciãos, que fica no Penhasco do Trovão. Você também pode falar com outros Anfitriões do Festival da Lua em outras capitais.‡Поговорите с предвестницей Лунного фестиваля на вершине Старейшин Громового Утеса. Вы можете также поговорить с предвестницами Лунного фестиваля в других столичных городах.‡Sprecht mit der Botin des Mondfests auf der Anhöhe der Ältesten in Donnerfels. Die Boten in den anderen Hauptstädten können Euch ebenfalls weiterhelfen.‡썬더 블러프 장로의 봉우리에 있는 달의 축제 사절과 대화해야 합니다. 또한, 다른 대도시에 있는 달의 축제 사절과 대화해도 무방합니다.‡Habla con la presagista del Festival Lunar en el Alto de los Ancestros de Cima del Trueno. También puedes hablar con otras presagistas del Festival Lunar de otras capitales.‡Habla con la presagista del Festival Lunar en el Alto de los Ancestros de Cima del Trueno. También puedes hablar con otras presagistas del Festival Lunar de otras capitales.‡Parler à la Messagère de la Fête lunaire à la Cime des Anciens des Pitons du Tonnerre. Vous pouvez aussi parler aux messagers de la Fête lunaire des autres capitales.‡与雷霆崖长者高地的春节预告者交谈。当然，你也可以到其他主城中去寻找当地的新年预报者。‡到雷霆崖，與長者高地的新年預告者談話，你也可以在其他主要城市跟新年預告者談話。',
  }
},
[8876] = {
