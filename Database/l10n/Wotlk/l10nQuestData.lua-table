[3402] = {
  {
    'O submercado‡Черный рынок‡Der Untermarkt‡암거래상단‡El Mercado Negro‡El Mercado Negro‡Le Sous-marché‡黑市交易‡暗黑拍賣會',
    nil,
    'Fale com Linhagulha em Geringontzan.|n‡Поговорите с Визгликом в Прибамбасске.‡Sprecht mit Vizzklick in Gadgetzan.‡가젯잔에 있는 비즈클릭과 대화해야 합니다.‡Habla con Vizzklick en Gadgetzan.|n‡Habla con Vizzklick en Gadgetzan.|n‡Parler à Vizzklick à Gadgetzan.‡和加基森的维兹格里克谈一谈。‡和加基森的維茲格里克談話。',
  }
},
