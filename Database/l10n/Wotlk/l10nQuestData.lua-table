},
[1707] = {
  {
    'Bolsas de água pra refrescar‡Награда за воду‡Wasserbeutelkopfgeld‡물주머니 현상금‡Cazador de faltriqueras de agua‡Cazador de faltriqueras de agua‡Une prime pour les outres‡收集水袋‡收集水袋',
    nil,
    'Leve 5 Bolsas de Água do Errante para o Operador de Torneira Rastamala em Geringontzan.‡Принесите 5 бурдюков Скитальцев Пустыни оператору крана Тормозиллеру в Прибамбасск.‡Bringt Leitungshahnmaschinist Lochbeutel in Gadgetzan 5 Wasserbeutel eines Wüstenläufers.‡가젯잔에 있는 양수기기사 루글룬켓에게 사막유랑단 물주머니 5개를 가져가야 합니다.‡Llévale 5 faltriqueras de agua de Deambulador al grifoperador Llantalunket, que está en Gadgetzan.‡Llévale 5 faltriqueras de agua de Vagayermos al grifoperador Llantalunket, que está en Gadgetzan.‡Apporter 5 Outres de Bat-le-désert à l\'Opérateur du robinet Trimballot à Gadgetzan.‡收集5只废土水袋，把它们交给加基森的鲁格伦克。‡收集5個廢土水袋，把它們交給加基森的魯葛蘭克。',
  }
},
[1708] = {
  {
    'Coral de Ferro‡Железный коралл‡Eisenkoralle‡철산호‡Coral férreo‡Coral férreo‡Le corail de fer‡铁珊瑚‡鐵珊瑚',
    nil,
    'Leve 20 peças de Coral Causticante para Cronomorfus Espanafuso em Altaforja.‡Принесите 20 партий выжженного коралла Клацморту Гайкокруту в Стальгорн.‡Bringt 20 Ladungen Sengkoralle zu Klockmort Spannersplint in Eisenschmiede.‡아이언포지에 있는 클락몰트 스패너스판에게 철산호 20개를 가져가야 합니다.‡Lleva 20 piezas de coral abrasador a Klockmort Palmalicate en Forjaz.‡Lleva 20 piezas de coral férreo a Klockmort Palmalicate en Forjaz.‡Apportez 20 Coraux torrides à Pléthorloge Cléventail, à Forgefer.‡收集20块灼热珊瑚，把它们交给铁炉堡的科罗莫特·钢尺。‡收集20塊灼熱珊瑚，把它們交給鐵爐堡的科羅莫特·鋼尺。',
  }
},
[1709] = {
  {
    'Criação do Cronomorfus‡Творение Клацморта‡Klockmorts Kreation‡클락몰트의 창작품‡La creación de Klockmort‡La creación de Klockmort‡La création de Pléthorloge‡科罗莫特的成果‡科羅莫特的成果',
