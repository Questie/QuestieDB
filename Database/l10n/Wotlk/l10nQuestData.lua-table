},
[10074] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    'A Pesquisadora-chefe Amereldine, de Halaa, quer que você recolha 10 Amostras de Cristal em Pó de Oshu\'gun.‡Принесите старшему ученому Амерельдине в Халаа 10 порций порошка кристалла Ошу\'гуна.‡Bringt 10 Kristallpulverproben von Oshu\'gun zu Forschungsleiterin Amereldine in Halaa.‡할라아에 있는 수석 연구원 아미를다인이 오슈군 결정 가루 견본 10개를 가져오라고 부탁했습니다.‡La jefa de investigación Amereldine de Halaa quiere 10 muestras de polvo de cristal de Oshu\'gun.‡La jefa de investigación Amereldine de Halaa quiere 10 muestras de polvo de cristal de Oshu\'gun.‡La Directrice de recherche Amereldine de Halaa veut 10 Échantillons de poudre de cristal d\'Oshu\'gun.‡将10份沃舒古水晶尘样本交给哈兰的主研究员阿米蒂恩。‡哈剌的首席調查員阿莫瑞丹需要10個歐夏剛水晶粉末樣本。',
  }
},
[10075] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    nil,
  }
},
[10076] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘‡歐夏剛水晶粉末',
    nil,
    'O pesquisador-chefe Kartos, de Halaa, precisa de 10 amostras de cristal em pó de Oshu\'gun.‡Принесите 10 порций порошка кристалла Ошу\'гуна старшему ученому Картосу в Халаа.‡Bringt 10 Kristallpulverproben von Oshu\'gun zu Forschungsleiter Kartos in Halaa.‡할라아에 있는 수석 연구원 카르토스가 오슈군 결정 가루 견본 10개를 가져다 달라고 부탁했습니다.‡El jefe de investigación Kartos de Halaa quiere 10 muestras de polvo de cristal de Oshu\'gun.‡El jefe de investigación Kartos de Halaa quiere 10 muestras de polvo de cristal de Oshu\'gun.‡Le Directeur de recherche Kartos de Halaa veut 10 Échantillons de poudre de cristal d\'Oshu\'gun.‡将10份沃舒古水晶尘样本交给哈兰的主研究员卡托斯。‡哈剌的首席調查員阿莫瑞丹需要10個歐夏剛水晶粉末樣本。',
  }
},
[10077] = {
  {
    'Cristal em pó de Oshu\'gun‡Порошок кристалла Ошу\'гуна‡Kristallpulver von Oshu\'gun‡오슈군 결정 가루‡Polvo de cristal de Oshu\'gun‡Polvo de cristal de Oshu\'gun‡La poudre de cristal d\'Oshu\'gun‡沃舒古水晶尘样本‡歐夏剛水晶粉末',
    nil,
    nil,
  }
},
[10078] = {
  {
    'Sabendo sabotar, não vão nos atacar‡Сжечь старье!‡Die Unerwünschten zerstören‡톱날 투척기 파괴‡Machacando al enemigo‡Machacando al enemigo‡Anéantir les indésirables‡烧毁掷刀车‡將剩餘的變不需要的',
    nil,
    'Use a Tocha Flamejante para incendiar as Arremessadoras de Lâminas da Horda ao longo do Caminho da Glória. Então traga a Tocha Flamejante de volta para Rumberto na Fortaleza da Honra.‡Используйте горящий факел и подожгите клинкометы Орды, стерегущие Путь Славы. После выполнения задания верните факел Болтую в Оплот Чести.‡Zündet die Klingenwerfer der Horde mit der flammenden Fackel am Pfad des Ruhms an. Kehrt dann mit der flammenden Fackel zu Dumphry in der Ehrenfeste zurück.‡영광의 길이 내려다보이는 곳에 있는 호드 톱날 투척기를 불타오르는 횃불을 사용하여 태운 후, 명예의 요새에 있는 덤프리에게 횃불을 가져가야 합니다.‡Utiliza la antorcha llameante para quemar los lanzacuchillos de la Horda que dan a El Camino a la Gloria. A continuación, lleva la antorcha llameante a Dumphry en el Bastión del Honor.‡Utiliza la antorcha llameante para quemar los lanzacuchillos de la Horda que dan a El Camino a la Gloria. A continuación, lleva la antorcha llameante a Dumphry en el Bastión del Honor.‡Utilisez la Torche enflammée pour brûler les Lance-lames de la Horde surplombant le sentier de la Gloire. Puis apportez la Torche enflammée à Dumphry au bastion de l\'Honneur.‡使用燃烧的火把烧毁分布在荣耀之路周围的部落掷刀车，然后将燃烧的火把交给荣耀堡的达姆菲。‡使用燃焰火炬燒毀光榮之路上監視的部落刀刃發射器。然後，將燃焰火炬帶給榮譽堡的戴夫利。',
  }
},
[10079] = {
  {
    'Balança mas não cai‡Весь рудник ходуном‡Bringt diese Mine zum Beben!‡광산의 소동‡Esta mina es un caos‡Esta mina es un caos‡Mineur, tu dors, ton wagon va trop vite‡乱糟糟的矿洞‡礦場的騷動',
    nil,
    'Mate 12 Sapadores Gan\'arg e fale novamente com o Encarregado Grandepar.‡Убейте 12 ган\'аргов-саперов и вернитесь к штейгеру Большие Десны.‡Tötet 12 Pioniere der Gan\'arg und kehrt dann zu Großknecht Biggums zurück.‡간아그 공병 12명을 처치한 후 현장감독 비굼스에게 돌아가야 합니다.‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Biggums.‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Biggums.‡Tuez 12 Sapeurs gan\'arg puis retournez voir le contremaître Biggums.‡杀死12个甘尔葛工兵，然后向工头比格姆斯复命。‡殺掉12個甘納格工人後回去找工頭比干莫斯。',
  }
},
[10081] = {
  {
    'Para encontrar a Mãe Kashur‡Встреча с Матерью Кашур‡Mutter Kashur treffen‡대모 카슈르와 만남‡Conocer a la Madre Kashur‡Conocer a la Madre Kashur‡Rencontrer Mère Kashur‡拜访卡舒尔宗母‡與族母卡修爾會面',
    nil,
    'A Grande Mãe Geyah quer que você converse com a Mãe Kashur.‡Поговорите с Матерью Кашур.‡Großmutter Geyah möchte, dass Ihr mit Mutter Kashur sprecht.‡대모 게야가 대모 카슈르와 대화해 보라고 부탁했습니다.‡La Abuela Geyah quiere que hables con la Madre Kashur.‡La Abuela Geyah quiere que hables con la Madre Kashur.‡La Grande-mère Geyah veut que vous parliez avec Mère Kashur.‡盖亚安祖母要你去跟卡舒尔宗母谈一谈。‡主母吉雅要你與族母卡修爾談談。',
  }
},
[10082] = {
  {
    'Ancestrais inquietos‡Покой предков‡Die aufgebrachten Ahnen‡불안한 영혼‡Los ancestros agitados‡Los ancestros agitados‡Les ancêtres agités‡激动的灵魂‡焦慮的先祖們',
    nil,
    'A Mãe Kashur quer que você dê fim a 8 espíritos orcs agitados.‡Уничтожьте 8 потревоженных духов орков по просьбе Матери Кашур.‡Mutter Kashur möchte, dass Ihr 8 aufgebrachte Orcgeister tötet.‡대모 카슈르가 근심어린 오크 영혼 8명에게 안식을 찾아 달라고 부탁했습니다.‡La Madre Kashur te ha pedido que acabes con 8 espíritus de orcos perturbados.|n‡La Madre Kashur te ha pedido que acabes con 8 espíritus de orcos perturbados.|n‡Mère Kashur vous a demandé de donner le repos à 8 Esprits orcs agités.‡卡舒尔宗母要求你让8个激动的兽人灵魂再次安息。‡族母卡修爾要你殺掉8個激動的獸人靈魂。',
  }
},
[10084] = {
  {
    '‡Атака на Магеддон‡Angriff auf Mageddon‡‡Asalto a Mageddon‡Asalto a Mageddon‡L\'attaque de Mageddon‡袭击黑色祭坛‡',
    nil,
    '‡Убейте Владыку ночи Малфаса, находящегося на Кузнечной Базе: Магеддон. О выполнении задания доложите командиру армии Данату Троллебою из Оплота Чести.‡Tötet Nachtlord Malphas im Konstruktionslager: Mageddon und meldet Euch dann bei Truppenkommandant Danath Trollbann in der Ehrenfeste.‡‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon e informa al comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon e informa al comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Tuez le Seigneur de la nuit Malphas à la Base de forge Mageddon, et retournez auprès du Commandant Danath Trollemort au Bastion de l\'Honneur.‡‡',
  }
},
[10085] = {
  {
    'Visita aos antepassados‡Навестить предков‡Ein Besuch bei den Ahnen‡선조 방문‡Una visita a los ancestros‡Una visita a los ancestros‡Une visite aux ancêtres‡拜访先祖之魂‡拜訪先祖們',
    nil,
    'A Mãe Kashur, das Terras Ancestrais, em Nagrand, quer que você vá até o Posto Solavera, as Ruínas Gargaveira, a Garadar e as Ruínas dos Olhos Sangrentos.‡Мать Кашур хочет, чтобы вы посетили заставу Солнечного Источника, руины Веселого Черепа, Гарадар и руины Кровавой Глазницы.‡Mutter Kashur im Ahnengrund in Nagrand möchte, dass Ihr den Sonnenwindposten, die Ruinen des Lachenden Schädels, Garadar und die Ruinen des Blutenden Auges besucht.‡나그란드의 선조의 터에 있는 대모 카슈르가 태양여울 주둔지, 웃는 해골 폐허, 가라다르, 피투성이굴 폐허를 방문하라고 부탁했습니다.‡La Madre Kashur en las Tierras Ancestrales, en Nagrand, te ha pedido que visites el Puesto Primasol, las Ruinas Riecráneos, Garadar y las Ruinas Foso Sangrante.‡La Madre Kashur en las Tierras Ancestrales, en Nagrand, te ha pedido que visites el Puesto Primasol, las Ruinas Riecráneos, Garadar y las Ruinas Foso Sangrante.‡Mère Kashur des Terres ancestrales en Nagrand vous a demandé de visiter le Poste de Berceau-de-l\'été, les Ruines du Crâne ricanant, Garadar et les Ruines de l\'Orbite-sanglante.‡纳格兰先祖之地的卡舒尔宗母要你去拜访日泉岗哨、嘲颅废墟、加拉达尔和血环废墟。‡納葛蘭上先祖之地的族母卡修爾要你去拜訪日春崗哨，獰笑骷髏廢墟，卡拉達爾以及血之谷廢墟。',
  }
},
[10086] = {
  {
    'Eu trabalho... pela Horda!‡Я служу... Орде!‡Ich arbeite... für die Horde!‡호드를 위해 일한다!‡Trabajo... ¡para la Horda!‡Trabajo... ¡para la Horda!‡Je travaille... Pour la Horde !‡我为部落工作！‡我替……部落工作!',
    nil,
    'Leve 8 pedaços de Metal Recuperado e 8 pedaços de Madeira Recuperada para Megzeg Rebbentappunho, em Thrallmar.‡Принесите 8 кусков металлолома и 8 кусков древесины Мегзегу Крутогруду в Траллмар.‡Bringt 8 Stück gebrauchtes Metall und 8 Stück gebrauchtes Holz zu Megzeg Knaxknöchel in Thrallmar.‡스랄마에 있는 메그제그 너클버스트에게 재활용 목재와 재활용 금속을 8개씩 가져가야 합니다.‡Llévale 8 piezas de metal rescatado y 8 piezas de madera rescatada a Megzeg Quetemeto, en Thrallmar.‡Llévale 8 piezas de metal rescatado y 8 piezas de madera rescatada a Megzeg Quetemeto, en Thrallmar.‡Apportez 8 morceaux de Métal récupéré et 8 morceaux de Bois récupéré à Megzeg Phalanjette à Thrallmar.‡给萨尔玛的泽格·纳克布斯带去8块回收的金属和8块回收的木材。‡將8片可利用的金屬及8塊可利用的木頭交給索爾瑪的奴克巴斯。',
  }
},
[10087] = {
  {
    'Acende aí... pela Horda!‡Сжечь! Во имя Орды!‡Zündet es an... für die Horde!‡불태우리... 호드를 위하여!‡Quémalo... ¡por la Horda!‡Quémalo... ¡por la Horda!‡Brûlez-les... Pour la Horde !‡为了部落，烧！‡為了部落……燒了它!',
    nil,
    'Use a Tocha Flamejante para incendiar o Canhão Oriental da Aliança e o Canhão Ocidental da Aliança, e então fale novamente com Megzeg Rebbentappunho, em Thrallmar.‡Используя горящий факел, подожгите восточную пушку Альянса и западную пушку Альянса. После выполнения задания возвращайтесь к Мегзегу Крутогруду в Траллмар.‡Zündet die östliche und die westliche Kanone der Allianz mit der flammenden Fackel an und kehrt danach zu Megzeg Knaxknöchel in Thrallmar zurück.‡불타오르는 횃불을 사용하여 동쪽 얼라이언스 대포와 서쪽 얼라이언스 대포를 태운 다음 스랄마에 있는 메그제그 너클버스트에게 돌아가야 합니다.‡Usa la antorcha llameante para quemar los cañones de la Alianza del este y el oeste, y vuelve a ver a Megzeg Quetemeto en Thrallmar.‡Usa la antorcha llameante para quemar los cañones de la Alianza del este y el oeste, y vuelve a ver a Megzeg Quetemeto en Thrallmar.‡Utilisez la Torche enflammée pour brûler le Canon est de l\'Alliance et le Canon ouest de l\'Alliance, puis revenez voir Megzeg Phalanjette à Thrallmar.‡利用燃烧的火把烧毁东部联盟火炮和西部联盟火炮，然后返回萨尔玛向泽格·纳克布斯复命。‡使用燃焰火炬燒毀東邊的聯盟火砲還有西邊的聯盟火砲，然後回報索爾瑪的米希克·奴克巴斯。',
  }
},
[10088] = {
  {
    '‡Весь рудник ходуном‡Bringt diese Mine zum Beben!‡광산의 소동‡Esta mina es un caos‡Esta mina es un caos‡Mineur, tu dors, ton wagon va trop vite‡矿场的骚动‡',
    nil,
    '‡Убейте 12 ган\'аргов-саперов и возвращайтесь к Штейгер Разлкразу.‡Tötet 12 Pioniere der Gan\'arg und kehrt dann zu Großknecht Razelcraz zurück.‡‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Razelcraz.‡Mata a 12 zapadores Gan\'arg y vuelve a ver al supervisor Razelcraz.‡Tuez 12 Sapeurs gan\'arg et retournez voir le contremaître Razelcraz.‡‡',
  }
},
[10089] = {
  {
    '‡Лагеря Легиона‡Konstruktionslager der Legion‡‡Campamentos Forja de la Legión‡Campamentos Forja de la Legión‡Les camps de forge de la Légion‡军团的炼冶场‡',
    nil,
    '‡Убейте 10 ган\'аргов-прислужников, 5 легионеров лагеря Легиона и 5 сестер Скорби, затем обыщите лагерь Легиона: Ярость, чтобы узнать намерения Легиона.‡Tötet 10 Diener der Gan\'arg, 5 Legionäre des Konstruktionslagers und 5 Schwestern des Leids. Durchsucht danach des Konstruktionslager: Zorn nach einem Hinweis auf die Absichten der Legion.‡‡Mata a 10 sirvientes Gan\'arg, a 5 legionarios del Campamento Forja y a 5 hermanas de dolor. A continuación busca en el Campamento Forja: Ira pruebas de los planes de la Legión.‡Mata a 10 sirvientes Gan\'arg, a 5 legionarios del Campamento Forja y a 5 hermanas de dolor. A continuación busca en el Campamento Forja: Ira pruebas de los planes de la Legión.‡Tuez 10 Serviteurs gan\'arg, 5 Légionnaires du camp de forge et 5 Sœurs de la peine, puis fouillez le camp de forge Rage à la recherche d\'indices concernant les intentions de la Légion.‡‡',
  }
},
[10090] = {
  {
    '‡Планы Легиона‡Die Pläne der Legion‡‡Los planes de la Legión‡Los planes de la Legión‡Les plans de la Légion‡军团的计划‡',
    nil,
    '‡Разыщите Лагерь Легиона: Планы Злобы и возвращайтесь к властителю Хану Изуверу в Погибель Сквернобота.‡Besorgt die Pläne des Konstruktionslagers: Bosheit und bringt sie zu Oberanführer Hun Stümmelfaust im Häschersturz.‡‡Recupera los planes del Campamento Forja: Maldad y llévaselos al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Recupera los planes del Campamento Forja: Maldad y llévaselos al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Récupérez les Plans du camp de forge Dépit et apportez-les au suzerain Hun Mutilepoing au Trépas du saccageur.‡‡',
  }
},
[10091] = {
  {
    'Os engenhos das almas‡Инструменты души‡Seeleninstrumente‡영혼의 장치‡Los dispositivos de almas‡Los dispositivos de almas‡Les machines à âmes‡灵魂装置‡靈魂儀器',
    nil,
    'Roube 5 Dispositivos da Alma e os entregue à Espiã-chefe Melisa Coroalta, que fica no Terraço da Luz em Shattrath.‡Украдите 5 инструментов души и доставьте их повелительнице шпионов Мелисе Высокий Венец в Шаттрат на Террасу Света.‡Stehlt 5 Seeleninstrumente und bringt sie zu Spionagemeisterin Mehlisah Hochkrone auf der Terrasse des Lichts in Shattrath.‡영혼의 장치 5개를 훔쳐서 샤트라스의 빛의 정원에 있는 첩보단장 멜리사 하이크라운에게 가져가야 합니다.‡Roba 5 dispositivos de alma y entrégaselos a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath.‡Roba 5 dispositivos de alma y entrégaselos a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath.‡Volez 5 Machines à âmes puis apportez-les à la maître-espionne Mehlisah Hautecouronne sur la terrasse de la Lumière à Shattrath.‡偷取5个灵魂装置，将它们交给沙塔斯城圣光广场的间谍女王梅丽萨·海克隆。‡偷取5個靈魂儀器並把它們運送給撒塔斯城裡露臺的間諜首領麥莉莎·陽冠。',
  }
},
[10092] = {
  {
    '‡Атака на Магеддон‡Angriff auf Mageddon‡‡Asalto a Mageddon‡Asalto a Mageddon‡L\'attaque de Mageddon‡袭击黑色祭坛‡',
    nil,
    '‡Убейте Владыку Ночи Малфаса, который находится на Кузнечной базе: Магеддон и возвращайтесь к властителю Хану Изуверу в Погибель Сквернобота.‡Tötet Nachtlord Malphas im Konstruktionslager: Mageddon und meldet Euch dann bei Oberanführer Hun Stümmelfaust im Häschersturz.‡‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon y ve a ver al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Mata al Señor de la Noche Malphas en el Campamento Forja: Mageddon y ve a ver al señor supremo Hun Puñolisiado en la Caída del Atracador Vil.‡Tuez le Seigneur de la nuit Malphas à la Base de forge Mageddon, et retournez auprès du Suzerain Hun Mutilepoing au Trépas du saccageur.‡‡',
  }
},
[10093] = {
  {
    'O Templo de Telhamat‡Храм Телхамат‡Der Tempel von Telhamat‡텔하마트 사원‡El Templo de Telhamat‡El Templo de Telhamat‡Le temple de Telhamat‡塔哈玛特神殿‡特爾哈曼神廟',
    nil,
    'Fale com Amaan, o Sábio, no Templo de Telhamat, na parte ocidental da Península Fogo do Inferno.‡Поговорите с Амааном Мудрым в храме Телхамат, который находится на западе полуострова Адского Пламени.‡Sprecht mit Amaan dem Weisen beim Tempel von Telhamat im Westen der Höllenfeuerhalbinsel.‡지옥불 반도 서부의 텔하마트 사원에 있는 현자 아만과 대화해야 합니다.‡Habla con Amaan el Sabio en el Templo de Telhamat al oeste de la Península del Fuego Infernal.‡Habla con Amaan el Sabio en el Templo de Telhamat al oeste de la Península del Fuego Infernal.‡Parlez à Amaan le Sage au temple de Telhamat dans l\'ouest de la péninsule des Flammes infernales.‡前往地狱火半岛西部的塔哈玛特神殿，与智者阿曼恩谈一谈。‡與地獄火半島西邊特爾哈曼神廟的『智者』阿曼談談。',
  }
},
[10094] = {
  {
    'O Códice de Sangue‡Кодекс Крови‡Der Kodex des Blutes‡피의 고서‡El Códice de Sangre‡El Códice de Sangre‡Le codex de sang‡鲜血法典‡血之聖典',
    nil,
    'Leia o Códice de Sangue no Labirinto Soturno de Auchindoun.‡Прочитайте Кодекс Крови в Темном лабиринте в Аукиндоне.‡Lest den Kodex des Blutes im Schattenlabyrinth von Auchindoun.‡아킨둔의 어둠의 미궁에서 피의 고서를 읽어야 합니다.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lee el Códice de Sangre en el Laberinto de las Sombras en Auchindoun.‡Lisez le Codex de sang dans le Labyrinthe des ombres d\'Auchindoun.‡阅读奥金顿暗影迷宫中的鲜血法典。‡閱讀奧齊頓的暗影迷宮裡的血之聖典。',
  }
},
[10095] = {
  {
    'Rumo ao coração do labirinto‡В самом сердце Лабиринта‡In das Herz des Labyrinths‡미궁의 심장부로‡En el corazón del laberinto‡En el corazón del laberinto‡Au cœur du labyrinthe‡深入迷宫‡進入迷宮的中心',
    nil,
    'Destrua Murmúrio e informe à Espiã-chefe Melisa Coroalta, no Terraço da Luz em Shattrath, sobre os eventos ocorridos dentro do Labirinto Soturno.‡Уничтожьте Бормотуна и доложите о том, что произошло внутри Темного лабиринта, повелительнице шпионов Мелисе Высокий Венец, которую можно найти на террасе Света в Шаттрате.‡Vernichtet Murmur und informiert danach Spionagemeisterin Mehlisah Hochkrone auf der Terrasse des Lichts in Shattrath über die Geschehnisse im Schattenlabyrinth.‡울림을 없앤 후 샤트라스, 빛의 정원에 있는 첩보단장 멜리사 하이크라운에게 어둠의 미궁 안에서 벌어지고 있는 사건에 대해 보고하십시오.‡Destruye a Murmullo e informa a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath sobre los sucesos ocurridos en el Laberinto de las Sombras.‡Destruye a Murmullo e informa a la maestra de espías Mehlisah Solcorona en el Bancal de la Luz en la Ciudad de Shattrath sobre los sucesos ocurridos en el Laberinto de las Sombras.‡Détruisez Marmon, puis allez à la terrasse de la Lumière à Shattrath pour faire un rapport de ce qui s\'est passé dans le Labyrinthe des ombres à la maître-espionne Mehlisah Hautecouronne.‡杀死摩摩尔，然后返回沙塔斯城的圣光广场，将暗影迷宫的秘密告诉间谍女王梅丽萨·海克隆。‡殺掉莫爾墨後回到撒塔斯城的聖光露臺並且向間諜首領麥莉莎·陽冠回報暗影迷宮裡頭發生的事件。',
  }
},
[10096] = {
  {
    'Salvar os esporlotes‡Спасение спорлоков‡Rettung der Sporloks‡스포어로크 구출‡Salvemos a los esporotes‡Salvemos a los esporotes‡Sauver les sporeloks‡拯救孢子人‡拯救斯柏路克',
    nil,
    'Mate 10 Dragadores do Pântano, 10 Tocaieiros do Pântano e fale novamente com Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Убейте 10 болотных черпальщиков и 10 болотных скрытней и вернитесь к Лоранне Тар\'велл в Кенарийский приют в Зангартопи.‡Tötet 10 Marschengräber und 10 Marschenlauerer und kehrt dann zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡갈퀴손 습지늪괴물, 수렁늪괴물을 각각 10마리씩 처치한 후 장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 돌아가야 합니다.‡Mata 10 dragadores de marisma y 10 rondadores de marisma y ve a ver a Lauranna Thar\'well al Refugio Cenarion en la Marisma de Zangar.‡Mata 10 dragadores de marisma y 10 rondadores de marisma y ve a ver a Lauranna Thar\'well al Refugio Cenarion en la Marisma de Zangar.‡Tuez 10 Drague-marais et 10 Rôdeurs des marais, puis retournez voir Lauranna Thar\'well au Refuge cénarien dans le marécage de Zangar.‡杀死10个沼泽掘泥者和10个沼泽潜伏者，然后向塞纳里奥庇护所的劳兰娜·萨维尔复命。‡殺掉10隻沼澤挖掘者及10隻沼澤潛伏者，完成後回到贊格沼澤找塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[10097] = {
  {
    'Irmão contra irmão‡Брат на брата‡Bruder gegen Bruder‡형제 간의 싸움‡Hermano contra hermano‡Hermano contra hermano‡Frère contre frère‡兄弟反目‡兄弟鬩牆',
    nil,
    'Mate o Tecetrevas Syth nos Salões dos Sethekk, depois liberte Lakka do cativeiro. Fale novamente com Isfar fora dos Salões dos Sethekk quando concluir o resgate.‡Проникните в Сетеккские залы и убейте Темнопряда Сита. Освободите из плена Лакку. После этого вернитесь к Исфару, который находится неподалеку от входа в Сетеккские залы.‡Tötet Dunkelwirker Syth in den Sethekkhallen und befreit Lakka. Kehrt zu Isfar außerhalb der Sethekkhallen zurück, wenn Ihr die Aufgabe abgeschlossen habt.‡세데크 전당 밖에 있는 이스파르가 세데크 전당에 있는 흑마술사 시스를 처치하고 붙잡혀 있는 라카를 구해달라고 부탁했습니다.‡Mata a Tejeoscuro Syth en las Salas Sethekk y libera a Lakka. Habla con Isfar fuera de las Salas Sethekk cuando hayas terminado la misión de rescate.‡Mata a Tejeoscuro Syth en las Salas Sethekk y libera a Lakka. Habla con Isfar fuera de las Salas Sethekk cuando hayas terminado la misión de rescate.‡Tuez le tisseur d\'ombre Syth dans les salles des Sethekk, puis libérez Lakka. Retournez voir Isfar à l\'extérieur des salles des Sethekk lorsque vous aurez réussi à la sauver.‡进入塞泰克大厅，杀死黑暗编织者塞斯，然后解救被囚禁的拉卡。完成任务后向塞泰克大厅外的伊斯法尔复命。‡殺掉塞司克大廳的暗法師希斯，之後釋放拉卡自由。完成拯救後回到塞司克大廳外找伊斯法。',
  }
},
[10098] = {
  {
    'O legado de Terokk‡Наследство Терокка‡Terokks Erbe‡테로크의 유산‡El legado de Terokk‡El legado de Terokk‡L\'héritage de Terokk‡泰罗克的传说‡泰洛克的遺產',
    nil,
    'Entregue a Máscara de Terokk, o Cálamo de Terokk e a Saga de Terokk a Isfar, diante dos Salões dos Sethekk.‡Принесите Маску Терокка, Перо Терокка и Сагу о Терокке Исфару, который находится неподалеку от Сетеккских залов.‡Bringt Terokks Maske, Terokks Federkiel und die Sage von Terokk zu Isfar außerhalb der Sethekkhallen.‡세데크 전당 밖에 있는 이스파르에게 테로크의 가면, 테로크의 깃창, 테로크의 전설이라는 책을 가져가야 합니다.‡Lleva la máscara y la punta de Terokk, además de la saga de Terokk a Isfar a las puertas de las Salas Sethekk.‡Lleva la máscara y la punta de Terokk, además de la saga de Terokk a Isfar a las puertas de las Salas Sethekk.‡Apportez le Masque de Terokk, la Rémige de Terokk et la Saga de Terokk à Isfar à l\'extérieur des salles des Sethekk.‡将泰罗克的面具、泰罗克的羽毛和泰罗克的传说交给塞泰克大厅外的伊斯法尔。‡將泰洛克面罩，泰洛克羽毛，及泰洛克的傳說交給塞司克大廳外的伊斯法。',
  }
},
[10099] = {
  {
    'O mandante‡Мозговой центр‡Das Genie‡배후의 지휘관‡El cerebro oculto‡El cerebro oculto‡Le cerveau‡主谋‡幕後的黑手',
    nil,
    'Localize e mate Z\'kral nas minas embaixo da Fortaleza da Honra, e então apresente-se ao Encarregado Grandepar.‡Найдите и убейте З\'крала в рудниках под Оплотом Чести, и доложите об этом штейгеру Большие Десны.‡Sucht und tötet Z\'kral in den Minen unter der Ehrenfeste und meldet Euch dann bei Großknecht Biggums zurück.‡명예의 요새 지하의 광산에 있는 즈크랄을 찾아서 처치한 후 현장감독 비굼스에게 보고해야 합니다.‡Encuentra y mata a Z\'kral en las minas que hay debajo de Bastión del Honor y ve a informar al supervisor Biggums.‡Encuentra y mata a Z\'kral en las minas que hay debajo de Bastión del Honor y ve a informar al supervisor Biggums.‡Trouvez et tuez Z\'kral dans les mines sous le bastion de l\'Honneur, puis faites votre rapport au contremaître Biggums.‡进入荣耀堡的地下矿洞，找到并杀死兹克拉，然后向工头比格姆斯复命。‡找出及殺掉榮譽堡底下礦坑裡的希卡洛，完成後回報給工頭比干莫斯。',
  }
},
[10100] = {
  {
    '‡Мозговой центр‡Das Genie‡배후의 지휘관‡El cerebro oculto‡El cerebro oculto‡Le cerveau‡幕后的黑手‡',
    nil,
    '‡Найдите и убейте Урга\'зза в рудниках под Траллмаром, и доложите об этом штейгеру Разлкразу.‡Sucht und tötet Urga\'zz in den Minen unter Thrallmar und kehrt dann zu Großknecht Razelcraz zurück.‡‡Encuentra y mata a Urga\'zz en las minas que hay debajo de Thrallmar y ve a informar al supervisor Razelcraz.‡Encuentra y mata a Urga\'zz en las minas que hay debajo de Thrallmar y ve a informar al supervisor Razelcraz.‡Trouvez et tuez Urga\'zz dans les mines sous Thrallmar, puis faites votre rapport au contremaître Razelcraz.‡‡',
  }
},
[10101] = {
  {
    'Quando os espíritos falam‡Когда говорят духи‡Wenn Geister sprechen‡영혼들이 말할 때‡Cuando hablan los espíritus‡Cuando hablan los espíritus‡Lorsque les esprits parlent‡灵魂之语‡當靈魂們說話時',
    nil,
    'A Mãe Kashur, das Terras Ancestrais, em Nagrand, quer que você investigue a visão que ela teve. Procure K\'ure, em Oshu\'gun.‡Разыщите К\'уре в Ошу\'гуне.‡Mutter Kashur im Ahnengrund in Nagrand bittet Euch, Eurer Vision auf den Grund zu gehen. Findet K\'ure in Oshu\'gun.‡나그란드의 선조의 터에 있는 대모 카슈르가 환영을 찾아달라고 부탁했습니다. 오슈군에 있는 크우레를 찾아야 합니다.‡Madre Kashur, de las Tierras Ancestrales de Nagrand, te pidió que buscaras a tu visión. Busca a K\'ure en Oshu\'gun.‡Madre Kashur, de las Tierras Ancestrales de Nagrand, te pidió que buscaras a tu visión. Busca a K\'ure en Oshu\'gun.‡Mère Kashur des Terres ancestrales en Nagrand vous a demandé de partir à la recherche de la vision que vous avez eue. Trouvez K\'ure à Oshu\'gun.‡纳格兰先祖之地的卡舒尔宗母要求你前往沃舒古寻找克乌雷。‡納葛蘭的先祖之地的族母卡修爾要你去找出擁有的幻象。去找歐夏剛的庫爾。',
  }
},
[10102] = {
  {
    'Segredo revelado‡Раскрытая тайна‡Ein gelüftetes Geheimnis‡밝혀진 비밀‡Un secreto desvelado‡Un secreto desvelado‡Un secret dévoilé‡谜底揭晓‡秘密的揭露',
    nil,
    'Fale com A\'dal na cidade de Shattrath.‡Поговорите с А\'далом в Шаттрате.‡Sprecht mit A\'dal in Shattrath.‡샤트라스에 있는 아달과 대화하십시오.‡Habla con A\'dal en la Ciudad de Shattrath.‡Habla con A\'dal en la Ciudad de Shattrath.‡Parlez à A\'dal à Shattrath.‡与沙塔斯城的阿达尔谈一谈。‡和撒塔斯城裡的阿達歐談談。',
  }
},
[10103] = {
  {
    'Apresente-se a Zurai‡Донесение Зураю‡Bericht an Zurai‡주라이에게 보고‡A las órdenes de Zurai‡A las órdenes de Zurai‡Faire son rapport à Zurai‡向祖莱报到‡報告祖瑞伊',
    nil,
    'Apresente-se a Zurai no Mocó do Rato Lamacento, que fica no Pântano Zíngaro.‡Поговорите с Зураем на заставе Болотной Крысы в Зангартопи.‡Meldet Euch bei Zurai im Sumpfrattenposten in den Zangarmarschen.‡장가르 습지대의 늪쥐 감시초소에 있는 주라이에게 보고해야 합니다.‡Preséntate ante Zurai en Avanzada Rata del Pantano, en Marisma de Zangar.‡Preséntate ante Zurai en Avanzada Rata del Pantano, en Marisma de Zangar.‡Présentez-vous à Zurai au poste du Rat des marais dans le marécage de Zangar.‡前往赞加沼泽的沼泽鼠岗哨，向祖莱报到。‡回報贊格沼澤的伊斯溫派特崗哨裡的祖瑞伊。',
  }
},
[10104] = {
  {
    'Preocupações quanto a Tuurem‡Опасения за судьбу Туурема‡Sorgen um Tuurem‡투렘의 운명‡Preocupaciones sobre Tuurem‡Preocupaciones sobre Tuurem‡Des soucis à Tuurem‡图雷姆的事务‡與杜瑞有關',
    nil,
    'Fale com Andarl na Fortaleza Alleriana, na Mata Terokkar.‡Поговорите с Андарлом в бастионе Аллерии в Тероккаре.‡Sprecht mit Andarl in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 안다를과 대화해야 합니다.‡Habla con Andarl en el Bastión Allerian en el Bosque de Terokkar.‡Habla con Andarl en el Bastión Allerian en el Bosque de Terokkar.‡Parlez à Andarl au Bastion allérien dans la forêt de Terokkar.‡与泰罗卡森林奥蕾莉亚要塞的安达尔谈一谈。‡與泰洛卡森林裡艾蘭里堡壘的安達爾歐談談。',
  }
},
[10105] = {
  {
    'Notícias para Rakoria‡Вести для Ракории‡Nachrichten für Rakoria‡라코리아에게 전할 소식‡Noticias para Rakoria‡Noticias para Rakoria‡Des nouvelles pour Rakoria‡给拉克妮亚的消息‡給瑞蔻莉雅的消息',
    nil,
    'Fale com Rakoria na Vila de Quebrapedra, na Mata Terokkar.‡Поговорите с Ракорией из форта Камнеломов в лесу Тероккар.‡Sprecht mit Rakoria in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 라코리아와 대화하십시오.‡Habla con Rakoria en el Bastión Rompepedras, en el Bosque de Terokkar.‡Habla con Rakoria en el Bastión Rompepedras, en el Bosque de Terokkar.‡Parlez à Rakoria, au fort des Brise-pierres, dans la forêt de Terokkar.‡与泰罗卡森林裂石堡的拉克妮亚谈一谈。‡與泰洛卡森林裡碎石堡的瑞蔻莉雅談談。',
  }
},
[10106] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 성채‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Primeiro-sargento Theresa Pardim na Península do Fogo do Inferno.‡Захватите обзорную площадку, ристалище и Изрезанный холм, и возвращайтесь к прапорщику Трейси Праудвелл в Оплот Чести на полуострове Адского Пламени.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Stabsfeldwebel Tracy Stolzbrunn in der Ehrenfeste auf der Höllenfeuerhalbinsel zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 지옥불 반도의 명예의 요새에 있는 준위 트레이시 프라우드웰에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir l\'adjudante Tracy Fièrepuits au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上荣耀堡内的委任官翠希·普罗维尔复命。‡占領望海崖，競技場和破碎之丘，完成後回到地獄火半島的榮譽堡找士官長崔西·波特威歐。',
  }
},
[10107] = {
  {
    'Medidas diplomáticas‡Дипломатическая миссия‡Diplomatische Maßnahmen‡외교적 수단‡Medidas diplomáticas‡Medidas diplomáticas‡Mesures diplomatiques‡外交手段‡外交的衡量',
    nil,
    'Jorin Olho Morto, de Garadar, em Nagrand, quer que você encontre e converse com Lantresor da Lâmina nas Ruínas da Lâmina Ardente.‡Джорин Мертвый Глаз из Гарадара в Награнде попросил вас поговорить с Лантрезором Клинком в руинах Пылающего Клинка.‡Jorin Totauge in Garadar in Nagrand möchte, dass Ihr Lantresor von der Klinge in den Ruinen der Brennenden Klinge findet und mit ihm sprecht.‡나그란드의 가라다르에 있는 요린 데드아이가 불타는 칼날 폐허에 있는 칼날의 란트레서를 찾아서 대화해 보라고 부탁했습니다.‡Jorin Mortojo de Garadar en Nagrand quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Jorin Mortojo de Garadar en Nagrand quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Jorin Œil-mort de Garadar en Nagrand vous a demandé de trouver Lantresor de la Lame dans les ruines de la Lame ardente et de lui parler.‡加拉达尔的约林·死眼要你前往火刃废墟，找兰特瑞索·火刃谈一谈。‡納葛蘭裡卡拉達爾的喬林·亡眼要你去燃刃廢墟尋找『劍刃』蘭崔索並與他談談。',
  }
},
[10108] = {
  {
    'Medidas diplomáticas‡Дипломатическая миссия‡Diplomatische Maßnahmen‡외교적 수단‡Medidas diplomáticas‡Medidas diplomáticas‡Mesures diplomatiques‡外交手段‡外交的衡量',
    nil,
    'Mo\'mor, o Destruidor, da vila de Telaar, em Nagrand, quer que você converse com Lantresor da Lâmina, nas Ruínas da Lâmina Ardente.‡Мо\'мор Разрушитель из Телаара в Награнде попросил вас поговорить с Лантрезором Клинком в руинах Пылающего Клинка.‡Mo\'mor der Brecher in Telaar in Nagrand möchte, dass Ihr Lantresor von der Klinge in den Ruinen der Brennenden Klinge findet und mit ihm sprecht.‡나그란드의 텔라아르에 있는 파괴자 모모르가 불타는 칼날 폐허에 있는 칼날의 란트레서를 찾아 대화해 보라고 부탁했습니다.‡Mo\'mor el Rompedor de Telaar, en Nagrand, quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Mo\'mor el Rompedor de Telaar, en Nagrand, quiere que hables con Lantresor del Filo en las Ruinas Filo Ardiente.‡Mo\'mor le Briseur, de Telaar en Nagrand, vous a demandé de trouver Lantresor de la Lame dans les ruines de la Lame ardente et de lui parler.‡塔拉的击碎者姆摩尔要你去跟火刃废墟的兰特瑞索·火刃谈一谈。‡納葛蘭裡泰拉的『破壞者』哞哞爾要你去燃刃廢墟尋找『劍刃』蘭崔索並與他談談。',
  }
},
[10109] = {
  {
    'Eu preciso deles!‡Я их достану!‡Ich muss sie haben!‡누가 뭐래도 내꺼야!‡¡Los necesito!‡¡Los necesito!‡Il me les faut !‡我想要这些鸟蛋！‡我一定要擁有它們!',
    nil,
    'Wazat, da Vila dos Clãs, no sul de Nagrand, quer que você lhe traga 3 unidades de gás de elemental do ar.‡Принесите 3 порции пара элементалей воздуха Вазату в Южный Награнд.‡Wazdaz gegenüber der Klanwacht im Süden von Nagrand möchte, dass Ihr ihm 3 Einheiten Luftelementargas bringt.‡나그란드 남부의 부족 초소 건너편에 있는 와자트가 바람의 정령 기체 3개를 가져다 달라고 부탁했습니다.‡Wazat de Avanzada del Clan en el sur de Nagrand quiere que le lleves 3 gases de elemental de aire.‡Wazat de Avanzada del Clan en el sur de Nagrand quiere que le lleves 3 gases de elemental de aire.‡Koissa, qui se trouve en face du Guet des clans dans le sud de Nagrand, veut que vous lui apportiez 3 Gaz d\'élémentaires d\'air.‡将3份气元素实体交给纳格兰南部氏族岗哨对面的瓦萨特。‡南納葛蘭上從氏族守望來的瓦薩特要你帶給它3個風元素氣體。',
  }
},
[10110] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 요새‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Arauto de Batalha Olhonegro em Thrallmar.‡Захватите Обзорную площадку, Ристалище и Изрезанный холм, и возвращайтесь в Траллмар к Черноглазке Зову Войны.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Kriegsherold Blauauge in Thrallmar zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 스랄마에 있는 전투장교 블랙아이에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir le Crieur-de-guerre Coquard à Thrallmar.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上萨尔玛的传令官布莱肯·黑眼复命。‡佔領望海崖，競技場和破碎之丘，完成後回到索爾瑪找戰場咆嘯者黑眼。',
  }
},
[10111] = {
  {
    'Traga-me aquele ovo!‡Принеси мне яйцо!‡Bringt mir das Ei!‡알을 가져와!‡¡Tráeme el huevo!‡¡Tráeme el huevo!‡Rapportez-moi cet œuf !‡给我鸟蛋！‡我要蛋!',
    nil,
    'Wazat, de Nagrand, quer que você use o Pula-tron 4000 para alcançar o ninho da árvore mais próxima e roubar o Ovo Misterioso.‡С помощью Прыготрона-4000 запрыгните в гнездо на ближайшем дереве и украдите оттуда таинственное яйцо.‡Wazdaz in Nagrand möchte, das Ihr den Spring-o-Mat 4000 benutzt, um in das Nest in dem nahe gelegenen Baum zu springen und das geheimnisvolle Ei zu stehlen.‡나그란드의 와자트가 방방이 4000을 사용하여 근처 나무에 있는 둥지에 접근해서 수수께끼의 알을 훔쳐달라고 부탁했습니다.‡Wazat en Nagrand quiere que utilices el Saltatrón 4000 para llegar al nido que está en el árbol cercano y robar el huevo misterioso.‡Wazat en Nagrand quiere que utilices el Saltatrón 4000 para llegar al nido que está en el árbol cercano y robar el huevo misterioso.‡Koissa, de Nagrand, veut que vous utilisiez le Bond-o-tron 4000 pour parvenir jusqu\'au nid de l\'arbre tout proche et voler l\'Œuf mystérieux.‡纳格兰的瓦萨特要你利用超级蹦床4000型从附近树上的鸟巢中偷取神秘的鸟蛋。‡納葛蘭的瓦薩特要你用彈跳裝置4000偷取鄰近樹上的鳥巢並且取得未孵化的蛋。',
  }
},
[10112] = {
  {
    'Um favor pessoal‡Личное одолжение‡Ein persönlicher Gefallen‡사적인 부탁‡Un pequeño favor‡Un pequeño favor‡Une faveur personnelle‡私人事务‡個人的喜好',
    nil,
    'Recupere 5 Mercadorias Roubadas de Lathrai. Entregue-as para Lathrai, o Mercador do Vento. Você pode encontrá-lo perto da Taberna Fim do Mundo, localizada no Bairro Inferior, em Shattrath.‡Найдите 5 украденных товаров Латрая и верните их хозяину. Латрая можно найти возле таверны "На краю земли" в Нижнем городе Шаттрата.‡Holt 5 von Lathrais gestohlenen Waren zurück und bringt sie zu Windhändler Lathrai bei der Taverne Weltenend im unteren Viertel in Shattrath.‡도둑맞은 라스라이의 물품 5개를 찾아서 샤트라스의 고난의 거리에 있는 세상의 끝 선술집 근처의 바람의 무역상 라스라이에게 가져가야 합니다.‡Recupera 5 de los objetos robados a Lathrai. Regresa junto al comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo, en el Bajo Arrabal de la Ciudad de Shattrath.‡Recupera 5 de los objetos robados a Lathrai. Regresa junto al comerciante de viento Lathrai cerca de la Taberna del Fin del Mundo, en el Bajo Arrabal de la Ciudad de Shattrath.‡Récupérez 5 des Marchandises volées de Lathrai. Rapportez-les au marchand des vents Lathrai près de la Taverne de la Fin du monde dans le quartier de la Ville basse de Shattrath.‡将5箱拉斯莱的货物交给沙塔斯城贫民窟天涯旅店附近的星界商人拉斯莱。‡取得5個拉斯蕊被偷的貨物。將它們送回撒塔斯城的陰鬱城，交給接近世界的盡頭小酒館的風之貿易者拉斯蕊。',
  }
},
[10113] = {
  {
    'O safári Rosarães‡Охотничий лагерь Эрнестуэя‡Nesingwarys Safari‡네싱워리 탐험대‡El Safari Nesingwary‡El Safari Nesingwary‡Le safari de Nesingwary‡奈辛瓦里狩猎队‡奈辛瓦里狩獵隊',
    nil,
    'Jonas "Escopeta" quer que você fale com Rosarães Guima no Safári Rosarães, a nordeste de Nagrand.‡Поговорите с Хемингом Эрнестуэем в охотничьем лагере Эрнестуэя на северо-восточной границе Награнда.‡"Die Flinte" Jones möchte, dass Ihr mit Hemet Nesingwary in Nesingwarys Safari am nordöstlichen Rand von Nagrand sprecht.‡"조수" 존스가 나그란드 북동부 외곽의 네싱워리 탐험대에 있는 헤멧 네싱워리와 대화해 보라고 부탁했습니다.‡Jones "Escopeta" quiere que hables con Hemet Nesingwary en el Safari Nesingwary a las afueras de Nagrand noreste.‡Jones "Escopeta" quiere que hables con Hemet Nesingwary en el Safari Nesingwary a las afueras de Nagrand noreste.‡Jones « Fusil » veut que vous parliez à Hemet Nesingwary au safari de Nesingwary, en périphérie du nord-est de Nagrand.‡"猎枪"琼斯要你前往纳格兰东北边界的奈辛瓦里狩猎队营地，找赫米特·奈辛瓦里谈一谈。‡『獵槍』瓊斯要你到納葛蘭東北方的郊區與奈辛瓦里狩獵隊的赫米特·奈辛瓦里談談。',
  }
},
[10114] = {
  {
    'O safári Rosarães‡Охотничий лагерь Эрнестуэя‡Nesingwarys Safari‡네싱워리 탐험대‡El Safari Nesingwary‡El Safari Nesingwary‡Le safari de Nesingwary‡奈辛瓦里狩猎队‡奈辛瓦里狩獵隊',
    nil,
    'Ohlorn Anda Ligeiro quer que você fale com Umbro Anda Ligeiro, o "Fio", no Safári Rosarães, em Nagrand.‡Олорм Странник просит вас поговорить со Странником Шадо "Фитцем" в охотничьем лагере Эрнестуэя в Награнде.‡Ohlorn Fernreiser möchte, dass Ihr mit Shado \'Fitz\' Fernreiser in Nesingwarys Safari in Nagrand sprecht.‡오로른 파스트라이더가 나그란드의 네싱워리 탐험대에 있는 샤도 \'피츠\' 파스트라이더와 대화해 보라고 부탁했습니다.‡Ohlorn Errante quiere que hables con Shado \'Fitz\' Errante en el Safari Nesingwary en Nagrand.‡Ohlorn Errante quiere que hables con Shado \'Fitz\' Errante en el Safari Nesingwary en Nagrand.‡Ohlorn Pérégrin veut que vous parliez à Shado « Fitz » Pérégrin au safari de Nesingwary en Nagrand.‡欧洛恩·远行者要你前往纳格兰的奈辛瓦里狩猎队营地，跟"好儿子"沙度·远行者谈一谈。‡歐洛恩·遠行者要你到納葛蘭的奈辛瓦里狩獵隊跟薩杜費茲遠行者談談。',
  }
},
[10115] = {
  {
    'A Anomalia Lamadaga‡Искажение Остротопи‡Dolchfennkrise‡비수늪일족의 일탈 행동‡La perversión Dagapantano‡La perversión Dagapantano‡La déviance des Tourbedague‡匕潭的威胁‡匕首沼地的異常',
    nil,
    'Mate 3 Assassinos Lamadaga e 15 Moralodos Lamadaga.‡Убейте 3 убийц Остротопи и 15 грязекопов Остротопи.‡Tötet 3 Auftragsmörder von Dolchfenn und 15 Matschkrabbler von Dolchfenn.‡비수늪일족 암살자 3명, 비수늪일족 땅꾼 15명을 처치해야 합니다.‡Mata a 3 asesinos Dagapantano y 15 habitabostas Dagapantano‡Mata a 3 asesinos Dagapantano y 15 habitabostas Dagapantano.‡Tuez 3 Assassins Tourbedague et 15 Marche-boue Tourbedague.‡杀死3个匕潭刺客和15个匕潭泥居者。‡殺掉3個匕首沼地刺客及15個匕首沼地污泥居者。',
  }
},
[10116] = {
  {
    'Procura-se: Chefe Mummaki‡Разыскивается: вождь Муммаки!‡Gesucht: Häuptling Mummaki‡현상 수배: 족장 뭄마키‡Se busca: Cabecilla Mummaki‡Se busca: Cabecilla Mummaki‡On recherche : chef Mummaki‡通缉：穆玛基酋长‡懸賞:姆瑪奇酋長',
    nil,
    'Traga o Totem do Chefe Mummaki para Ikuti em Porto Orebor.‡Принесите тотем вождя Муммаки Икути в прибежище Оребор.‡Bringt Häuptling Mummakis Totem zu Ikuti in der Oreborzuflucht.‡오레보르 피난처에 있는 이쿠티에게 족장 뭄마키의 토템을 가져가야 합니다.‡Lleva el tótem del cabecilla Mummaki a Ikuti a Puerto Orebor.‡Lleva el tótem del cabecilla Mummaki a Ikuti a Puerto Orebor.‡Apportez le Totem du chef Mummaki à Ikuti au Havre d\'Orebor.‡将穆玛基酋长的图腾交给奥雷柏尔营地的伊库提。‡將姆瑪奇酋長圖騰交給奧雷伯爾港的伊庫堤。',
  }
},
[10117] = {
  {
    'Procura-se: Chefe Mummaki‡Разыскивается: вождь Муммаки!‡Gesucht: Häuptling Mummaki‡현상 수배: 족장 뭄마키‡Se busca: Cabecilla Mummaki‡Se busca: Cabecilla Mummaki‡On recherche : chef Mummaki‡通缉：穆玛基酋长‡懸賞:姆瑪奇酋長',
    nil,
    'Traga o Totem do Chefe Mummaki para o Caçador Sombrio Denjai.‡Принесите тотем вождя Муммаки темному охотнику Денжаю.‡Bringt Häuptling Mummakis Totem zu Schattenjäger Denjai.‡어둠사냥꾼 덴자이에게 족장 뭄마키의 토템을 가져가야 합니다.‡Lleva el tótem del cabecilla Mummaki al cazador de las Sombras Denjai.‡Lleva el tótem del cabecilla Mummaki al cazador de las Sombras Denjai.‡Apportez le Totem du chef Mummaki au chasseur des ombres Denjai.‡将穆玛基酋长的图腾交给暗影猎手德恩加。‡將姆瑪奇酋長圖騰交給暗影獵人丹傑。',
  }
},
[10118] = {
  {
    'Mensagem para os Lamadaga‡Разговор с Остротопью‡Nachricht für Dolchfenn‡비수늪일족에게 보내는 메시지‡Mensaje a los Dagapantano‡Mensaje a los Dagapantano‡Un message pour les Tourbedague‡警告匕潭失落者‡給匕首沼地的訊息',
    nil,
    'Mate 3 Assassinos Lamadaga e 15 Moralodos Lamadaga. Em seguida, fale novamente com o caçador sombrio Denjai, em Zabra\'jin.‡Убейте 3 убийц и 15 грязекопов из племени Остротопи, и вернитесь к темному охотнику Денжаю в Забра\'джин.‡Tötet 3 Auftragsmörder von Dolchfenn und 15 Matschkrabbler von Dolchfenn und kehrt dann zu Schattenjäger Denjai in Zabra\'jin zurück.‡비수늪일족 암살자 3명, 비수늪일족 땅꾼을 15명을 해치운 다음 자브라진의 어둠사냥꾼 덴자이에게 보고하십시오.‡Mata 3 asesinos Dagapantano y 15 habitabostas Dagapantano y, a continuación, ve a ver al cazador de las Sombras Denjai en Zabra\'jin.‡Mata 3 asesinos Dagapantano y 15 habitabostas Dagapantano y, a continuación, ve a ver al cazador de las Sombras Denjai en Zabra\'jin.‡Tuez 3 Assassins Tourbedague et 15 Marche-boue Tourbedague, puis retournez voir le chasseur des ombres Denjai à Zabra\'jin.‡杀死3个匕潭刺客和15个匕潭泥居者，然后返回萨布拉金向暗影猎手德恩加复命。‡殺掉3個匕首沼地刺客及15個匕首沼地污泥居者並於完成後回到薩布拉金找暗影獵人丹傑。',
  }
},
[10119] = {
  {
    'Através do Portal Negro‡Через Темный портал‡Durch das Dunkle Portal‡어둠의 문 너머로‡A través de El Portal Oscuro‡A través de El Portal Oscuro‡À travers la Porte des ténèbres‡跨越黑暗之门‡通過黑暗之門',
    nil,
    'Atravesse o Portal Negro e encontre o Comandante Durão. Ele espera sua chegada do outro lado - em Terralém.‡Пройдите через Темный портал и найдите командора Дарона. Он ждет вашего прибытия на другой стороне, в Запределье.‡Reist durch das Dunkle Portal und sucht Kommandant Duron. Er wartet auf der anderen Seite auf Eure Ankunft - in der Scherbenwelt.‡어둠의 문으로 들어가서 문 반대편의 아웃랜드에서 당신의 도착을 기다리고 있는 지휘관 두론을 찾아야 합니다.‡Viaja a través de El Portal Oscuro y encuentra al comandante Duron. Te espera al otro lado... en Terrallende.|n‡Viaja a través de El Portal Oscuro y encuentra al comandante Duron. Te espera al otro lado... en Terrallende.|n‡Traversez la Porte des ténèbres et allez trouver le commandant Duron. Il attend votre arrivée de l\'autre côté - en Outreterre.‡穿越黑暗之门，找到指挥官杜隆。他就在黑暗之门另一侧的外域等你。‡通過黑暗之門找到指揮官杜朗。他在另一邊等你 - 就在外域裡。',
  }
},
[10120] = {
  {
    'Chegada em Terralém‡Прибытие в Запределье‡Ankunft in der Scherbenwelt‡아웃랜드 도착‡Llegada a Terrallende‡Llegada a Terrallende‡Arrivée en Outreterre‡抵达外域‡抵達外域',
    nil,
    'O Tenente-general Órion, no Portal Negro da Península Fogo do Inferno, quer que você leve um relatório para Vlagga Freipena.‡Доставьте донесение Ориона Влагге Легкоперой у Темного портала на полуострове Адского Пламени.‡Generalleutnant Orion beim Dunklen Portal auf der Höllenfeuerhalbinsel möchte, dass Ihr Orions Bericht zu Vlagga Freyfeder bringt.‡지옥불 반도의 어둠의 문에 있는 부사령관 오리온이 블라가 프레이페더에게 오리온의 보고서를 전해 달라고 부탁했습니다.‡El teniente general Orion de El Portal Oscuro en la Península del Fuego Infernal quiere que lleves su informe a Vlagga Plumacalma.‡El teniente general Orion de El Portal Oscuro en la Península del Fuego Infernal quiere que lleves su informe a Vlagga Plumacalma.‡Le général de division Orion à la Porte des ténèbres dans la péninsule des Flammes infernales veut que vous apportiez le Rapport d\'Orion à Vlagga Fileplume.‡地狱火半岛上黑暗之门旁的沃雷恩中将要求你将沃雷恩的报告交给维拉加·乱羽。‡地獄火半島上黑暗之門的歐萊恩中將要你將歐萊恩的報告交給法拉格·伏瑞菲德。',
  }
},
[10121] = {
  {
    'Extermine a Legião Ardente‡Истребить Пылающий Легион‡Die Brennende Legion ausrotten‡불타는 군단 박멸‡Erradicar a la Legión Ardiente‡Erradicar a la Legión Ardiente‡Éradiquer la Légion ardente‡消灭燃烧军团‡徹底消滅燃燒軍團',
    nil,
    'Fale com o Sargento Estilhaça-crânio perto da Caravana de Suprimentos do lado de fora de Thrallmar, ao leste.‡Поговорите с сержантом Лободробом, который находится при караване к востоку от Траллмара.‡Sprecht mit Unteroffizier Schädelbrecher bei der Versorgungskarawane außerhalb von Thrallmar im Osten.‡스랄마에서 동쪽으로 바로 바깥에 있는 보급 짐마차에 서 있는 하사관 쉐터스컬과 대화해야 합니다.‡Habla con el sargento Trizacráneo en la Caravana de Provisiones a las afueras de Thrallmar, hacia el este.‡Habla con el sargento Trizacráneo en la Caravana de Provisiones a las afueras de Thrallmar, hacia el este.‡Parlez au sergent Fracasse-crâne à la Caravane de ravitaillement, juste à l\'extérieur de Thrallmar, à l\'est.‡前往萨尔玛以东的补给车队，与斯古尔·碎颅者中士谈一谈。‡到索爾瑪城外東邊的補給營地找碎顱中士談談。',
  }
},
[10122] = {
  {
    'Ao alcance da Cidadela‡Вблизи цитадели‡Die Erstreckung der Zitadelle‡성채의 범위‡Espiando en la Ciudadela‡Espiando en la Ciudadela‡À portée de la citadelle‡堡垒的外围‡堡壘的聯繫',
    nil,
    'Procure pelo Soldado Imarion no acampamento mais ao norte na Muralha do Sul.‡Найдите следы рядового Имариона у самого северного лагеря орков Скверны, расположенного у Южного бастиона.‡Durchsucht das nördlichste Lager entlang des südlichen Bollwerks nach einer Spur von Gefreiter Imarion.‡남쪽 성루를 따라 최북단 야영지를 수색해서 병사 이마리온의 행방을 찾아야 합니다.‡Busca alguna pista del soldado Imarion en el campamento situado en el extremo norte de la Muralla Sur.‡Busca alguna pista del soldado Imarion en el campamento situado en el extremo norte de la Muralla Sur.‡Fouillez le camp le plus au nord le long du Rempart du sud à la recherche de traces du soldat Imarion.‡前往南部城墙外最北侧的营地寻找列兵伊玛里恩的下落。‡到沿著南方堡壘最北方的營地找尋士兵艾瑪倫的足跡。',
  }
},
[10123] = {
  {
    'Ravina de Vil Fagulha‡Лощина Вспышки Скверны‡Teufelsfunkenklamm‡지옥불꽃 협곡‡El Barranco Burbujas Viles‡El Barranco Llama Infernal‡Le Ravin de Gangrétincelle‡魔火峡谷‡魔焰深谷',
    nil,
    'O Sargento Estilhaça-crânio, na Caravana de Suprimentos a leste de Thrallmar, na Península Fogo do Inferno, quer que você mate 4 Diabretes Ardilantes, 6 Armipotentes Infernais e 1 Clamamedo.‡Убейте 4 бесов-поджигателей, 6 инферналов-завоевателей и 1 вестника Ужаса по просьбе сержанта Лободроба, который находится при караване к востоку от Траллмара.‡Unteroffizier Schädelbrecher bei der Versorgungskarawane östlich von Thrallmar auf der Höllenfeuerhalbinsel möchte, dass Ihr 4 Flammenschürerwichtel, 6 höllische Kriegshetzer und 1 Schreckensrufer tötet.‡지옥불 반도의 스랄마 동쪽에 위치한 보급 짐마차에 서 있는 하사관 쉐터스컬이 공포의 소환사 1명과 임프 화염술사 4마리, 지옥불정령 전투병 6마리를 해치워 달라고 부탁했습니다.‡El sargento Trizacráneo de la Caravana de Provisiones al este de Thrallmar en la Península del Fuego Infernal quiere que mates a 4 diablillos Despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡El sargento Trizacráneo de la Caravana de Provisiones al este de Thrallmar en la Península del Fuego Infernal quiere que mates a 4 diablillos Despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡Le sergent Fracasse-crâne de la Caravane de ravitaillement à l\'est de Thrallmar dans la péninsule des Flammes infernales veut que vous alliez tuer 4 Diablotins Attise-flammes, 6 Porteguerres infernaux et 1 Mande-effroi.‡萨尔玛东侧补给车队的斯古尔·碎颅者中士要求你杀死4个唤火小鬼、6个地狱火战争使者和1个恐惧召唤者。‡地獄火半島索爾瑪東邊補給商隊的碎顱中士要你殺掉4個烈焰行者小鬼，6個煉獄火戰爭使者及1個恐懼呼喚者。',
  }
},
[10124] = {
  {
    'Comando Avançado: Posto dos Destroços‡Передовая застава: Останки Сквернобота‡Vorposten: Häschersturz‡전진기지: 지옥절단기 함락지‡Base de la vanguardia: Caída del Atracador Vil‡Base de la vanguardia: Caída del Atracador Vil‡Poste avancé : Trépas du saccageur‡机甲残骸‡前方據點:劫奪者荒野',
    nil,
    'Apresente-se ao Comandante To\'acha no Posto dos Destroços.‡Доложитесь командиру передовой То\'арху по прибытии к останкам Сквернобота.‡Meldet Euch bei Vorpostenkommandant To\'arch im Häschersturz.‡지옥절단기 함락지에 있는 전방사령관 토아크에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Présentez-vous au commandant des lignes avancées To\'arch au Trépas du saccageur.‡前往机甲残骸，向前线指挥官托尔克报到。‡向劫奪者荒野的前線指揮官吐阿奇報到。',
  }
},
[10125] = {
  {
    'Mission: Disrupt Communications‡Задание: разрушить связь‡Mission: Die Kommunikation unterbrechen‡임무: 통신 방해‡Misión: Interrumpir las comunicaciones‡Misión: Interrumpir las comunicaciones‡Mission : Brouiller les communications‡DEPRECATED‡任務:中斷聯繫',
    nil,
    'Forward Commander To\'arch at Reaver\'s Fall in Hellfire Peninsula has asked that you use To\'arch\'s Explosives and destroy Legion Antenna: Spite, Legion Antenna: Rage, Legion Antenna: Hate, Legion Antenna: Fear.‡Уничтожьте Антенну Легиона: Злоба, Антенну Легиона: Ярость, Антенну Легиона: Ненависть, Антенну Легиона: Страх с помощью взрывчатки То\'арха по приказу командира передовой То\'арха в Погибели Сквернобота на Полуострове Адского Пламени.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr To\'archs Sprengstoff benutzt, um den Sender der Legion: Bosheit, Sender der Legion: Zorn, Sender der Legion: Hass und Sender der Legion: Furcht zu zerstören.‡지옥불 반도의 지옥절단기 함락지에 있는 전방사령관 토아크가 토아크의 폭탄을 사용하여 악의의 군단 송수신기, 분노의 군단 송수신기, 증오의 군단 송수신기, 경악의 군단 송수신기를 파괴해 달라고 부탁했습니다.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que uses los explosivos para destruir las Antenas Legión Maldad, Ira, Odio y Miedo.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que uses los explosivos para destruir las Antenas Legión Maldad, Ira, Odio y Miedo.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé d\'utiliser les Explosifs de To\'arch et de détruire l\'Antenne de la Légion : Mépris, l\'Antenne de la Légion : Haine, et l\'Antenne de la Légion : Peur.‡地狱火半岛上机甲残骸的Forward Commander To\'arch要你使用To\'arch\'s Explosives炸毁Legion Antenna: Spite、Legion Antenna: Rage、Legion Antenna: Hate和Legion Antenna: Fear。‡地獄火半島上劫奪者荒野的前線指揮官吐阿奇要你使用吐阿奇的爆裂物摧毀軍團天線:洩憤、軍團天線:狂怒、軍團天線:仇恨以及軍團天線:恐懼。',
  }
},
[10126] = {
  {
    '‡Приказы боевого командира Некрогга‡Kriegsboss Nekroggs Befehle‡전투대장 네크로그의 명령서‡Órdenes del mandón de guerra Nekrogg‡Órdenes del mandón de guerra Nekrogg‡Les ordres de Nekrogg le Mène-guerre‡指挥官奈克罗格的命令‡戰王奈克羅格的命令',
    nil,
    '‡Проследуйте к югу вдоль западной части Южного бастиона и разыщите в одном из лагерей следы рядового Имариона.‡Reist entlang der westlichen Seite des Südlichen Bollwerks nach Süden und durchsucht das nächste Lager nach einer Spur von Gefreiter Imarion.‡‡Ve hacia el sur por el lado oeste de la Muralla Sur y busca al soldado Imarion en el siguiente campamento.‡Ve hacia el sur por el lado oeste de la Muralla Sur y busca al soldado Imarion en el siguiente campamento.‡Voyagez vers le sud le long du côté ouest du Rempart du sud et fouillez le prochain camp à la recherche de signes du soldat Imarion.‡‡',
  }
},
[10127] = {
  {
    'Mission: Sever the Tie‡Задание: Ослабить врага‡Mission: Das Band zerreißen‡임무: 연결 고리 제거‡Misión: Cortar la unión‡Misión: Cortar la unión‡Mission : Couper le cordon‡DEPRECATED‡任務:切斷聯繫',
    nil,
    'Forward Commander To\'arch at Reaver\'s Fall in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Shi\'aziv.‡Убейте 4 укротителей Скверны, 8 гневостражей и поработительницу Ши\'азив по приказу командира передовой То\'арха у останков Сквернобота на Полуострове Адского Пламени.‡Vorpostenkommandant To\'arch am Häschersturz auf de Höllenfeuerhalbinsel möchte, dass Ihr 4 Teufelstreiber, 8 Zornwächter und Unterwerferin Shi\'aziv tötet.‡지옥불 반도의 지옥절단기 함락지에 있는 전방사령관 토아크가 지옥의 조련사 4명, 격노의 수호병 8명, 정복자 쉬아비즈를 해치우라고 부탁했습니다.‡El comandante de vanguardia To\'arch en la Caída del Atracador Vil en la Península del Fuego Infernal, quiere que mates a 4 cuidadores viles, 8 guardias de cólera y al subyugador Shi\'aziv.‡El comandante de vanguardia To\'arch en la Caída del Atracador Vil en la Península del Fuego Infernal, quiere que mates a 4 cuidadores viles, 8 guardias de cólera y al subyugador Shi\'aziv.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé de tuer 4 Dresseurs gangrenés, 8 Garde-courroux et le Dominateur Shi\'aziv.‡地狱火半岛上机甲残骸的Forward Commander To\'arch要你去杀死4名Fel Handler，8名Wrathguards，以及Subjugator Shi\'aziv。‡地獄火半島上劫奪者荒野的前線指揮官吐阿奇要你殺掉4個惡魔處理者，8個憤怒守衛，以及征服者薛艾希。',
  }
},
[10128] = {
  {
    '‡Спасти рядового Имариона‡Der Soldat Imarion‡‡Salvar al soldado Imarion‡Salvar al soldado Imarion‡Il faut sauver le soldat Imarion‡拯救大兵伊玛里恩‡',
    nil,
    '‡Следуйте дальше к югу вдоль Южного бастиона и постарайтесь найти, где боевой командир Некрогг держит в плену рядового Имариона.‡Setzt Euren Weg entlang des Südlichen Bollwerks fort und sucht nach dem Ort, an dem Kriegsboss Nekrogg Gefreiter Imarion gefangen hält.‡‡Sigue hacia el sur por la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene cautivo al soldado Imarion.‡Sigue hacia el sur por la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene cautivo al soldado Imarion.‡Poursuivez vers le sud le long du Rempart du sud et cherchez l\'endroit où le mène-guerre Nekrogg détient le soldat Imarion.‡‡',
  }
},
[10129] = {
  {
    'Missão: Portais Murketh e Shaadraz‡Задание: Врата Муркет и Шаадраз‡Mission: Tore Murketh und Shaadraz‡임무: 멀케스 관문과 샤드라즈 관문‡Misión: Puerta Murketh y Puerta Shaadraz‡Misión: Puerta Murketh y Puerta Shaadraz‡Mission : Portes Murketh et Shaadraz‡任务：穆尔凯斯和沙德拉兹之门‡任務:墨奇斯以及夏德拉茲入口',
    nil,
    'Fale com o Comandante de Ala Brack, bombardeie o Portal Murketh e o Portal Shaadraz, e então fale novamente com o Comandante To\'acha no Posto dos Destroços.‡Поговорите с командиром звена Бракком, разбомбите Врата Муркет и Шаадраз, затем возвращайтесь к командиру передовой То\'арху к останкам Сквернобота.‡Sprecht mit Schwadronskommandant Brack, bombardiert Tor Murketh und Tor Shaadrez und kehrt dann zu Vorpostenkommandant To\'arch im Häschersturz zurück.‡편대사령관 브락크와 대화하여 멀케스 관문과 샤드라즈 관문에 폭탄을 투하한 다음 지옥절단기 함락지에 있는 전방사령관 토아크에게 돌아가십시오.‡Habla con el comandante del aire Brack, bombardea Puerta Murketh y Puerta Shaadraz y después regresa junto al comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Habla con el comandante del aire Brack, bombardea Puerta Murketh y Puerta Shaadraz y después regresa junto al comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Parlez au chef d\'escadrille Brack, bombardez la Porte Murketh et la Porte Shaadraz, puis retournez voir le commandant des lignes avancées To\'arch au Trépas du saccageur.‡与空军指挥官布拉克谈谈，轰炸穆尔凯斯之门和沙德拉兹之门，然后向机甲残骸处的前线指挥官托尔克复命。‡與空軍指揮布拉克談談，炸掉墨奇斯入口以及夏德拉茲入口，完成後回到劫奪者荒野找前線指揮官吐阿奇。',
  }
},
[10130] = {
  {
    'O flanco ocidental‡Западный фланг‡Die westliche Flanke‡서쪽 측면 지역‡El flanco oeste‡El flanco oeste‡Le flanc ouest‡西侧的威胁‡西翼的攻擊',
    nil,
    'Mate 10 Guardas da Mão Despedaçada, 10 Berserkers da Mão Despedaçada e 5 Acólitos da Mão Despedaçada, e então apresente-se à Tenente Amadi na torre de guarda oeste da Fortaleza da Honra.‡Убейте 10 стражников, 10 берсерков и 5 послушников из клана Изувеченной Длани. О выполнении задания доложите лейтенанту Амади, которая будет ждать вас в западной сторожевой башне Оплота Чести.‡Tötet 10 Wachen der Zerschmetterten Hand, 10 Berserker der Zerschmetterten Hand und 5 Akolythen der Zerschmetterten Hand und meldet Euch dann bei Leutnant Amadi im westlichen Wachturm der Ehrenfeste.‡으스러진 손의 경비병 10명, 으스러진 손의 광전사 10명, 으스러진 손의 수행사제 5명을 처치한 후, 서쪽 감시탑에 있는 부관 아마디에게 보고해야 합니다.‡Mata a 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada, e informa después a la teniente Amadi en la torre de vigilancia oeste del Bastión del Honor.‡Mata a 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada, e informa después a la teniente Amadi en la torre de vigilancia oeste del Bastión del Honor.‡Tuez 10 Gardes de la Main brisée, 10 Berserkers de la Main brisée et 5 Acolytes de la Main brisée, puis faites votre rapport au lieutenant Amadi dans la tour de garde ouest du bastion de l\'Honneur.‡杀死10名碎手卫兵、10名碎手狂战士和5名碎手侍僧，然后向荣耀堡西部哨塔的阿曼蒂中尉报到。‡殺死10個破碎之手護衛、10個破碎之手狂戰士以及5個破碎之手侍僧然後回到榮譽堡的西側防禦哨塔回報阿瑪迪中尉。',
  }
},
[10131] = {
  {
    '‡План побега‡Fluchtplan‡‡Planear la huida‡Planear la huida‡Préparation de l\'évasion‡逃脱计划‡',
    nil,
    '‡Убейте гренадера клана Изувеченной Длани и принесите примитивную взрывчатку рядовому Имариону в форт Гор\'газ.‡Tötet einen Grenadier des Lachenden Schädels und bringt seine primitive Sprengladung zu Gefreiter Imarion im Außenposten von Gor\'gaz.‡‡Mata a 1 granadero Mano Destrozada y lleva sus rudimentarios explosivos al soldado Imarion en la Avanzada Gor\'gaz.‡Mata a 1 granadero Mano Destrozada y lleva sus rudimentarios explosivos al soldado Imarion en la Avanzada Gor\'gaz.‡Tuez un Grenadier de la Main brisée et apportez ses Explosifs rudimentaires au soldat Imarion à l\'avant-poste de Gor\'gaz.‡‡',
  }
},
[10132] = {
  {
    'Ameaça colossal‡Колоссальная угроза‡Eine kolossale Bedrohung‡거대괴수의 위협‡La amenaza colosal‡La amenaza colosal‡Menace colossale‡巨人的威胁‡巨大威脅',
    nil,
    'Mate 5 Colossos Enfurecidos e fale novamente com Tola\'thion, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Убейте 5 яростных колоссов и возвращайтесь к Тола\'тиону на Кенарийскую заставу на полуострове Адского Пламени.‡Tötet 5 tobende Kolosse und kehrt dann zu Tola\'thion im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡분노한 거대괴수 5마리를 처치한 다음 지옥불 반도의 세나리온 초소에 있는 톨라시온에게 돌아가야 합니다.‡Mata a 5 colosos enfurecidos y regresa junto a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Mata a 5 colosos enfurecidos y regresa junto a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Tuez 5 Colosses déchaînés puis retournez voir Tola\'thion au Poste cénarien dans la péninsule des Flammes infernales.‡杀死5个暴怒的巨人，然后返回地狱火半岛的塞纳里奥哨站，向图拉希恩复命。‡殺掉5個狂怒的巨像，完成後回到地獄火半島的塞納里奧前哨找塔拉希恩。',
  }
},
[10133] = {
  {
    '‡Задание: убить гонца‡Mission: Tötet den Boten‡‡Misión: Matar al mensajero‡Misión: Matar al mensajero‡Mission: Tuer le messager‡任务:杀死信差‡',
    nil,
    '‡Найдите Арикс\'малидаша, убейте его и заберите Послание Легиона по приказу командира передовой То\'арха у останков Сквернобота.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr Arix\'maladish findet und tötet und den Schriftwechsel der Legion besorgt.‡‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil, en la Península del Fuego Infernal, quiere que encuentres y mates a Arix\'malidash y recuperes la carta de la Legión.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil, en la Península del Fuego Infernal, quiere que encuentres y mates a Arix\'malidash y recuperes la carta de la Legión.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous a demandé de trouver et tuer Arix\'malidash et de récupérer la Missive de la Légion.‡‡',
  }
},
[10134] = {
  {
    'A crise do cristal carmesim‡Ключ к разгадке алого кристалла‡Hinweise des purpurnen Kristalls‡진홍색 수정의 실마리‡Pista para el cristal carmesí‡Pista para el cristal carmesí‡Un indice de cristal cramoisi‡火红水晶中的线索‡赤紅水晶線索',
    nil,
    'Leve o Estilhaço de Cristal Carmesim para Tola\'thion, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Доставьте осколок алого кристалла Тола\'тиону на Кенарийскую заставу на полуострове Адского Пламени.‡Bringt den Purpurkristallsplitter zu Tola\'thion im Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 톨라시온에게 진홍색 수정 조각을 전해 주어야 합니다.‡Entrega el fragmento de cristal carmesí a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Entrega el fragmento de cristal carmesí a Tola\'thion en el Puesto Cenarion, en la Península del Fuego Infernal.‡Apportez l\'Éclat de cristal cramoisi à Tola\'thion au Poste cénarien dans la péninsule des Flammes infernales.‡将火红水晶碎片交给地狱火半岛塞纳里奥哨站的图拉希恩。‡將赤紅水晶裂片送到地獄火半島的塞納里奧前哨給塔拉希恩。',
  }
},
[10135] = {
  {
    '‡Задание: доставить послание‡Mission: Seid der Bote‡‡Misión: Sé el mensajero‡Misión: Sé el mensajero‡Mission: Être le messager‡任务:充当信差‡',
    nil,
    '‡Доставьте Послание Легиона Назгрелу в Траллмар на Полуострове Адского Пламени.‡Bringt den Schriftwechsel der Legion zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡‡Lleva la carta de la Legión a Nazgrel a Thrallmar, en la Península del Fuego Infernal.‡Lleva la carta de la Legión a Nazgrel a Thrallmar, en la Península del Fuego Infernal.‡Apportez la Missive de la Légion à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡‡',
  }
},
[10136] = {
  {
    'As intenções do Cruel‡Безжалостные планы‡Grausame Pläne‡가차없는 처단‡Crueles intenciones‡Crueles intenciones‡Les Liaisons cruelles‡阿拉修斯的意图‡殘忍的目的',
    nil,
    'Mate Arrázius, o Cruel, e fale novamente com Nazgrel em Thrallmar.‡Убейте Араззиуса Безжалостного и возвращайтесь к Назгрелу в Траллмар.‡Tötet Arazzius den Grausamen und kehrt danach zu Nazgrel in Thrallmar zurück.‡학살자 아라지우스를 처치하고 스랄마에 있는 나즈그렐에게 돌아가야 합니다.‡Mata a Arazzius el Cruel y vuelve con Nazgrel en Thrallmar.‡Mata a Arazzius el Cruel y vuelve con Nazgrel en Thrallmar.‡Tuez Arazzius le Cruel, puis retournez voir Nazgrel à Thrallmar.‡除掉残酷的阿拉修斯，然后返回萨尔玛向纳兹格雷尔复命。‡殺死殘忍的阿拉薩爾斯，再回索爾瑪找納茲格雷爾。',
  }
},
[10137] = {
  {
    '‡Провокация‡Den Kriegsboss provozieren‡‡Provocando al mandón de guerra‡Provocando al mandón de guerra‡Provoquer le Mène-guerre‡挑衅指挥官‡',
    nil,
    '‡Используйте примитивную взрывчатку, чтобы создать шум и выманить боевого командира Некрогга из его башни. Убейте его, заберите Ключ Некрогга и откройте клетку рядового Имариона. Об освобождении рядового Имариона доложите лейтенанту Амади.‡Benutzt die primitiven Sprengladungen um einen Tumult zu veranstalten und Kriegsboss Nekrogg aus seinem Turm zu locken. Tötet ihn, besorgt Nekroggs Schlüssel und öffnet damit Gefreiter Imarions Käfig. Wenn Ihr Gefreiter Imarion befreit habt, meldet Euch bei Leutnant Amadi.‡‡Usa los explosivos orcos para generar un disturbio que haga salir al mandón de guerra Nekrogg de la torre. Mátalo, coge la llave de Nekrogg y úsala para abrir la jaula del soldado Imarion. Después ve a informar a la teniente Amadi.‡Usa los explosivos orcos para generar un disturbio que haga salir al mandón de guerra Nekrogg de la torre. Mátalo, coge la llave de Nekrogg y úsala para abrir la jaula del soldado Imarion. Después ve a informar a la teniente Amadi.‡Utilisez les Explosifs rudimentaires pour semer le trouble et attirer le mène-guerre Nekrogg hors de sa tour. Tuez-le, prenez la clé de Nekrogg et utilisez-la pour ouvrir la cage du soldat Imarion. Une fois que vous aurez libéré Imarion, présentez-vous au lieutenant Amadi.‡‡',
  }
},
[10138] = {
  {
    '‡Кто отдает приказы?‡Auf wessen Befehl hin?‡‡¿Quién manda aquí?‡¿Quién manda aquí?‡Sous les ordres de qui?‡谁的命令？‡',
    nil,
    '‡Убейте 20 рубак и 10 чернокнижников клана Изувеченной Длани и захватите распоряжения военного инструктора Зурока. После этого возвращайтесь к лейтенанту Амади в западную сторожевую башню Оплота Чести.‡Tötet 20 Grunzer der Zerschmetterten Hand, 10 Hexenmeister der Zerschmetterten Hand und besorgt Euch Drillmeister Zurok\'s Anweisungen. Kehrt dann zu Leutnant Amadi im westlichen Wachturm der Ehrenfeste zurück.‡‡Mata a 20 brutos y 10 brujos Mano Destrozada y captura las órdenes del maestro de maniobras Zurok. Luego ve a ver a la teniente Amadi a la torre de vigilancia oeste del Bastión del Honor.‡Mata a 20 brutos y 10 brujos Mano Destrozada y captura las órdenes del maestro de maniobras Zurok. Luego ve a ver a la teniente Amadi a la torre de vigilancia oeste del Bastión del Honor.‡Tuez 20 Grunts de la Main brisée et 10 Démonistes de la Main brisée, et emparez-vous des Ordres du maître de manœuvre Zurok. Puis retournez voir le lieutenant Amadi à la tour de garde ouest du bastion de l\'Honneur.‡‡',
  }
},
[10139] = {
  {
    '‡Разжаловать командира‡Die Beseitigung des Kommandanten‡‡Vencer al comandante‡Vencer al comandante‡Liquider le commandant‡刺杀指挥官‡',
    nil,
    '‡Уничтожьте командира соединения Горакса и доложите о выполнении задания лейтенанту Амади, которая находится в западной башне Оплота Чести.‡Tötet Truppenkommandant Gorax und meldet Euch dann bei Leutnant Amadi im westlichen Turm der Ehrenfeste zurück.‡‡Mata al comandante en jefe Gorax y preséntate ante la teniente Amadi en la torre oeste del Bastión del Honor.‡Mata al comandante en jefe Gorax y preséntate ante la teniente Amadi en la torre oeste del Bastión del Honor.‡Tuez le commandant de corps Gorax et faites votre rapport au lieutenant Amadi dans la tour ouest du bastion de l\'Honneur.‡‡',
  }
},
[10140] = {
  {
    'Viagem à Fortaleza da Honra‡Путешествие в Оплот Чести‡Reise zur Ehrenfeste‡명예의 요새로 가는 길‡Viaje al Bastión del Honor‡Viaje al Bastión del Honor‡En route pour le bastion de l\'Honneur‡荣耀堡之旅‡榮譽堡之行',
    nil,
    'Pegue um voo até a Fortaleza da Honra e entregue o Relatório de Durão para o Marechal Isildor‡Долетите до Оплота Чести и доставьте донесение Дурона маршалу Исилдору.‡Fliegt zur Ehrenfeste und übergebt Marschall Isildor Durons Bericht.‡명예의 요새로 날아가서 치안대장 이실도르에게 두론의 보고서를 전달해야 합니다.‡Vuela hasta el Bastión del Honor y entrega el informe de Duron al mariscal Isildor.‡Vuela hasta el Bastión del Honor y entrega el informe de Duron al mariscal Isildor.‡Volez jusqu\'au bastion de l\'Honneur et apportez le Rapport de Duron au maréchal Isildor.‡乘座狮鹫前往荣耀堡，将杜隆的报告交给伊斯多尔元帅。‡飛到榮譽堡把杜朗的報告送給治安官伊斯歐朵爾。',
  }
},
[10141] = {
  {
    'A Legião renascida‡Возрожденный Легион‡Wiedergeburt der Brennenden Legion‡다시 나타난 불타는 군단‡El renacer de la Legión‡El renacer de la Legión‡La renaissance de la Légion‡重生的军团‡燃燒軍團捲土重來',
    nil,
    'Fale com a Sargento Alana perto da Caravana de Suprimentos do lado de fora da Fortaleza da Honra, na direção leste.‡Поговорите с сержантом Альтумой, которая находится рядом с восточным караваном, к востоку от Оплота Чести.‡Sprecht mit Unteroffizier Altumus bei der östlichen Versorgungskarawane außerhalb der Ehrenfeste im Osten.‡명예의 요새 바로 바깥 동쪽의 동쪽 보급 짐마차에 있는 하사관 알투무스와 대화해야 합니다.‡Habla con la sargento Altumus en la Caravana de Provisiones del Este justo fuera del Bastión del Honor, hacia el este.‡Habla con la sargento Altumus en la Caravana de Provisiones del Este justo fuera del Bastión del Honor, hacia el este.‡Parlez au sergent Altumus à la Caravane de ravitaillement de l\'est, juste à l\'extérieur du bastion de l\'Honneur, à l\'est.‡与荣耀堡外面的东补给车队的沃图姆斯中士谈一谈。‡到東方去與榮譽堡外東部補給營地的阿圖瑪斯中士談談。',
  }
},
[10142] = {
  {
    'O Caminho da Angústia‡Путь Страданий‡Der Pfad der Pein‡고통의 길‡El Camino del Tormento‡El Camino del Tormento‡Le chemin de l\'Angoisse‡苦痛之路‡苦痛之路',
    nil,
    'A Sargento Alana, na Caravana de Suprimentos a leste da Fortaleza da Honra, na Península Fogo do Inferno, quer que você mate 4 Diabretes Ardilantes 6 Armipotentes Infernais e 1 Clamamedo.‡Убейте 4 бесов-поджигателей, 6 инферналов-завоевателей и 1 вестника ужаса по приказу сержанта Альтумы из восточного каравана, который находится на востоке от Оплота Чести на полуострове Адского Пламени.‡Unteroffizier Altumus bei der östlichen Versorgungskarawane östlich der Ehrenfeste auf der Höllenfeuerhalbinsel möchte, dass Ihr 4 Flammenschürerwichtel, 6 höllische Kriegshetzer und 1 Schreckensrufer tötet.‡지옥불 반도의 명예의 요새 동쪽에 위치한 동쪽 보급 짐마차에 있는 하사관 알투무스가 임프 화염술사 4명, 갈퀴발 지옥 마귀 6명, 지옥불정령 전투병 1명를 처치해 달라고 부탁했습니다.‡La sargento Altumus en la Caravana de Provisiones del Este del Bastión del Honor en la Península del Fuego Infernal, quiere que mates a 4 diablillos despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡La sargento Altumus en la Caravana de Provisiones del Este del Bastión del Honor en la Península del Fuego Infernal, quiere que mates a 4 diablillos despiertallamas, 6 belisarios infernales y 1 invocamiedo.‡Le sergent Altumus de la Caravane de ravitaillement de l\'est, qui se trouve à l\'est du bastion de l\'Honneur dans la péninsule des Flammes infernales, vous a demandé de tuer 4 Diablotins Attise-flammes, 6 Porteguerres infernaux et 1 Mande-effroi.‡荣耀堡外面的东补给车队的沃图姆斯中士要求你杀死4只唤火小鬼、6只地狱火战争使者和1只恐惧召唤者。‡在地獄火半島榮譽堡東方的東部補給營地的阿圖瑪斯中士要你殺死4個烈焰行者小鬼，6個煉獄火戰爭使者和1個恐懼呼喚者。',
  }
},
[10143] = {
  {
    'Posto da Expedição‡Лагерь экспедиции‡Expeditionsposten‡원정대 거점‡Punta de Expedición‡Punta de Expedición‡La halte de l\'expédition‡远征军岗哨‡遠征隊哨塔',
    nil,
    'Apresente-se ao Comandante Kingston, do Comando Avançado, no Posto da Expedição.‡Доложитесь командиру передовой Кингстону в лагере экспедиции.‡Meldet euch bei Vorpostenkommandant Königstein im Expeditionsposten.‡원정대 거점에 있는 전방사령관 킹스톤에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia Kingston en la Punta de Expedición.‡Preséntate ante el comandante de vanguardia Kingston en la Punta de Expedición.‡Présentez-vous au commandant des lignes avancées Kingston à la Halte de l\'expédition.‡向远征军岗哨的前线指挥官金斯顿报到。‡向遠征隊哨塔的前線指揮官金斯頓回報。',
  }
},
[10144] = {
  {
    'Interrompa os reforços‡Лишить Легион подкрепления!‡Die Kommunikation unterbrechen‡지원군 차단‡Perturbar sus refuerzos‡Perturbar sus refuerzos‡Couper l\'ennemi de ses renforts‡阻断援军‡阻斷他們的援軍',
    nil,
    'Derrote inimigos perto do Portal Grimh e Kaalez para coletar Pedras Rúnicas Demoníacas.|n|nUse o detonador de Kingston dentro do Portal Grimh e do Portal Kaalez quando tiver pedras suficientes.|n|nLeve os explosivos que sobrarem para o Comandante Avançado Kingston.‡Уничтожьте врага вокруг порталов Грим и Каалез и соберите камни с рунами демонов.|n|nЗабросьте запалы Кингстона в порталы Грим и Каалез.|n|nПосле выполнения задания возвращайтесь к командиру передовой Кингстону вместе с оставшейся взрывчаткой.‡Besiegt die Feinde um Portal Grimh und Portal Kaalez herum, um dämonische Runensteine zu sammeln.|n|nBenutzt Königsteins Zünder in Portal Grimh und Portal Kaalez.|n|nKehrt danach mit dem Zünder zu Vorpostenkommandant Königstein zurück.‡그림 차원문과 칼레즈 차원문 주위의 적들을 처치하여 악마의 룬을 모으십시오.|n|n그림 차원문과 칼레즈 차원문 내에서 킹스톤의 뇌관을 사용하십시오.|n|n임무를 완수하면 나머지 뇌관을 가지고 전방사령관 킹스톤에게 돌아가야 합니다.‡Vence a los enemigos que hay alrededor del Portal Grimh y el Portal Kaalez para reunir piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de Kingston dentro del Portal Grimh y del Portal Kaalez.|n|nVuelve con el comandante de vanguardia Kingston con los explosivos restantes.‡Vence a los enemigos que hay alrededor del Portal Grimh y el Portal Kaalez para reunir piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de Kingston dentro del Portal Grimh y del Portal Kaalez.|n|nVuelve con el comandante de vanguardia Kingston con los explosivos restantes.‡Tuez des ennemis du Portail Grimh et du Portail Kaalez pour collecter des Pierres runiques démoniaques.|n|nUtilisez les Amorces de Kingston à l\'intérieur du Portail Grimh et du Portail Kaalez.|n|nRetournez voir le commandant des lignes avancées Kingston avec les explosifs restants.‡消灭格雷姆传送门和凯勒兹传送门附近的敌人，收集它们身上的恶魔符文石。|n|n然后在格雷姆传送门和凯勒兹传送门内使用金斯顿的雷管。|n|n完成任务后，将剩余的炸药还给前线指挥官金斯顿。‡殺掉格瑞之門和卡雷茲之門附近的敵人取得惡魔符文石。|n|n在格瑞之門和卡雷茲之門內使用金斯頓的書冊。|n|n帶著剩下的爆裂物回去找前線指揮官金斯頓。',
  }
},
[10145] = {
  {
    'Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED‡Mission: Sever the Tie UNUSED',
    nil,
    'Forward Commander Kingston at Expedition Point in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Yalqiz.‡Уничтожьте 4 укротителя Скверны, 8 гневостражей и Поработителя Ялквиза по приказу командира передовой Кингстона из лагеря экспедиции на Полуострове Адского Пламени.‡Vorpostenkommandant Wa\'ppun beim Expeditionsposten auf de Höllenfeuerhalbinsel möchte, dass Ihr 4 Teufelstreiber, 8 Zornwächter und Unterwerferin Yalqiz tötet.‡지옥불 반도의 원정대 거점에 있는 전방사령관 킹스톤이 지옥의 조련사 4명, 격노의 수호병 8명, 정복자 얄퀴즈를 처치해 달라고 부탁했습니다.‡El comandante de vanguardia Kingston en la Punta de Expedición, en la Península del Fuego Infernal, quiere que mates 4 cuidadores viles, 8 guardias de cólera y al subyugador Yalqiz.‡El comandante de vanguardia Kingston en la Punta de Expedición, en la Península del Fuego Infernal, quiere que mates 4 cuidadores viles, 8 guardias de cólera y al subyugador Yalqiz.‡Le commandant des lignes avancées Kingston de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de tuer 4 Dresseurs gangrenés, 8 Garde-courroux et le Dominateur Yalqiz.‡Forward Commander Kingston at Expedition Point in Hellfire Peninsula wants you to kill 4 Fel Handlers, 8 Wrathguards, and Subjugator Yalqiz.‡地獄火半島上遠征隊哨塔的前線指揮官金斯頓要你殺死4個惡魔處理者，8個憤怒守衛，和征服者亞奎斯。',
  }
},
[10146] = {
  {
    'Missão: Os Portais Murketh e Shaadraz‡Задание: Врата Муркет и Шаадраз‡Mission: Tor Murketh und Tor Shaadraz‡임무: 멀케스 관문과 샤드라즈‡Misión: La Puerta Murketh y la Puerta Shaadraz‡Misión: La Puerta Murketh y la Puerta Shaadraz‡Mission : Portes Murketh et Shaadraz‡任务：穆尔凯斯和沙德拉兹之门‡任務:墨奇斯和夏德拉茲入口',
    nil,
    'Fale com o Comandante de Ala Dabir\'ee, bombardeie o Portal Murketh e o Portal Shaadraz, e então fale novamente com o Comandante Avançado Kingston no Posto da Expedição.‡Поговорите с командиром звена Даби\'ри, разбомбите Врата Муркет и Врата Шаадраз, затем возвращайтесь к командиру передовой Кингстону в Лагерь экспедиции.‡Sprecht mit Schwadronskommandant Dabir\'ee, bombardiert Tor Murketh und Tor Shaadraz und kehrt dann zu Vorpostenkommandant Wa\'ppun am Expeditionsposten zurück.‡편대사령관 다비리와 대화한 후 멀케스 관문과 샤드라즈 관문을 폭파시킨 다음 원정대 거점에 있는 전방사령관 킹스톤에게 돌아가야 합니다.‡Habla con el comandante del aire Dabir\'ee, bombardea la Puerta Murketh y la Puerta Shaadraz y, a continuación, vuelve a ver al comandante de vanguardia Kingston en la Punta de Expedición.‡Habla con el comandante del aire Dabir\'ee, bombardea la Puerta Murketh y la Puerta Shaadraz y, a continuación, vuelve a ver al comandante de vanguardia Kingston en la Punta de Expedición.‡Parlez au chef d\'escadrille Dabir\'ee, bombardez la Porte Murketh et la Porte Shaadraz, puis retournez voir le commandant des lignes avancées Kingston à la Halte de l\'expédition.‡与空军指挥官达比利谈谈，轰炸穆尔凯斯之门和沙德拉兹之门，然后向远征军岗哨的前线指挥官金斯顿复命。‡與空軍指揮戴畢瑞交談，炸掉墨奇斯入口和夏德拉茲入口，然後回到遠征隊哨塔向前線指揮官金斯頓回報。',
  }
},
[10147] = {
  {
    '‡Задание: убить гонца‡Mission: Tötet den Boten‡‡Misión: Matar al mensajero‡Misión: Matar al mensajero‡Mission: Tuer le messager‡任务:杀死信差‡',
    nil,
    '‡Отыщите Арикс\'малидаша, убейте его и заберите Послание Легиона по приказу командира передовой Кингстона из лагеря экспедиции на Полуострове Адского Пламени.‡Vorpostenkommandant Königstein im Expeditionsposten auf der Höllenfeuerhalbinsel möchte, dass Ihr Arix\'maladish findet und tötet und den Schriftwechsel der Legion besorgt.‡‡El comandante de vanguardia Kingston de la Punta de Expedición, en la Península del Fuego Infernal, ha pedido que encuentres a Arix\'malidash, lo mates y recuperes la misiva de la legión.‡El comandante de vanguardia Kingston de la Punta de Expedición, en la Península del Fuego Infernal, ha pedido que encuentres a Arix\'malidash, lo mates y recuperes la misiva de la legión.‡Le commandant des lignes avancées Kingston de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de trouver et tuer Arix\'malidash et de récupérer la Missive de la Légion.‡‡',
  }
},
[10148] = {
  {
    '‡Задание: доставить послание‡Mission: Seid der Bote‡‡Misión: Sé el mensajero‡Misión: Sé el mensajero‡Mission: Être le messager‡任务:充当信差‡',
    nil,
    '‡Доставьте Послание Легиона командиру армии Данату Троллебою в Оплот Чести на Полуострове Адского Пламени.‡Bringt den Schriftwechsel der Legion zu Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡‡Lleva la carta de la Legión al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Lleva la carta de la Legión al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Apportez la Missive de la Légion au commandant de corps Danath Trollemort, au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡‡',
  }
},
[10149] = {
  {
    '‡Задание: со щитом или на щите‡Mission: Beendet alles, seid alles‡‡Misión: Acaba con todo, sé todo‡Misión: Acaba con todo, sé todo‡Mission: Point final‡任务:终结所有，战胜所有‡',
    nil,
    '‡Убейте Араззиуса Безжалостного по приказу командира армии Даната Троллебоя из Оплота Чести на Полуострове Адского Пламени.‡Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel möchte, dass Ihr Arazzius den Grausamen tötet.‡‡El comandante en jefe Danath Aterratrols, del Bastión del Honor en la Península del Fuego Infernal, ha pedido que ejecutes a Arazzius el Cruel.|n‡El comandante en jefe Danath Aterratrols, del Bastión del Honor en la Península del Fuego Infernal, ha pedido que ejecutes a Arazzius el Cruel.|n‡Le commandant de corps Danath Trollemort au bastion de l\'Honneur dans la péninsule des Flammes infernales vous a demandé de tuer Arazzius le Cruel.‡‡',
  }
},
[10150] = {
  {
    'Ao alcance da Cidadela‡Вблизи цитадели‡Die Erstreckung der Zitadelle‡성채 앞에서‡Espiando en la Ciudadela‡Espiando en la Ciudadela‡À portée de la citadelle‡堡垒的外围‡堡壘的聯繫',
    nil,
    'Procure pela Batedora Makha no acampamento mais ao norte na Muralha do Norte.‡Постарайтесь найти следы разведчицы Махи в одном из лагерей, расположенных вдоль Северного бастиона.‡Durchsucht das nördlichste Lager entlang des nördlichen Bollwerks nach einer Spur von Späherin Makha.‡북쪽 성루를 따라 줄지어 있는 최북단 야영지를 수색해서 정찰병 마카의 행방을 찾아야 합니다.‡Busca alguna pista de la exploradora Makha en el campamento más al norte junto a la Muralla Norte.‡Busca alguna pista de la exploradora Makha en el campamento más al norte junto a la Muralla Norte.‡Fouillez le camp le plus au nord le long du Rempart du nord à la recherche de traces de l\'éclaireur Makha.‡前往北部城墙最北端的营地寻找斥候玛克哈的下落。‡沿著最北邊的營地到北方堡壘搜尋任何有關斥候馬克哈的線索。',
  }
},
[10151] = {
  {
    '‡Приказы боевого командира Некрогга‡Kriegsboss Nekroggs Befehle‡전투대장 네크로그의 명령서‡Órdenes del dirigente de guerra Nekrogg‡Órdenes del dirigente de guerra Nekrogg‡Les ordres de Nekrogg le Mène-guerre‡指挥官奈克罗格的命令‡戰王奈克羅格的命令',
    nil,
    '‡Отправляйтесь к югу вдоль западной стороны Северного бастиона и постарайтесь найти следы разведчицы Махи в одном из лагерей.‡Reist entlang der westlichen Seite des Nördlichen Bollwerks nach Süden und durchsucht das nächste Lager nach einer Spur von Späherin Makha.‡‡Ve al sur siguiendo la parte oeste de la Muralla Norte y busca en el siguiente campamento a la exploradora Makha.‡Ve al sur siguiendo la parte oeste de la Muralla Norte y busca en el siguiente campamento a la exploradora Makha.‡Voyagez vers le sud le long du côté ouest du Rempart du nord et fouillez le prochain camp à la recherche de signes de l\'éclaireur Makha.‡‡',
  }
},
[10152] = {
  {
    'O flanco ocidental‡Западный фланг‡Die westliche Flanke‡서쪽 측면‡El flanco oeste‡El flanco oeste‡Le flanc ouest‡西侧的威胁‡西翼的攻擊',
    nil,
    'Mate 10 Guardas da Mão Despedaçada, 10 Berserkers da Mão Despedaçada e 5 Acólitos da Mão Despedaçada, e então apresente-se ao Guarda Pétreo Ambelão, no Acampamento Quebra-espinha perto de Zeth\'Gor.‡Убейте 10 стражников, 10 берсерков и 5 послушников из клана Изувеченной Длани. О выполнении задания доложите каменному стражу Амбелану, который находится на заставе Раздробленного Хребта, рядом с Зет\'Гором.‡Tötet 10 Wachen der Zerschmetterten Hand, 10 Berserker der Zerschmetterten Hand und 5 Akolythen der Zerschmetterten Hand und meldet Euch dann bei Steingardist Ambelan im Rückenbrecherposten in der Nähe von Zeth\'Gor.‡으스러진 손의 경비병 10명, 으스러진 손의 광전사 10명, 으스러진 손의 수행사제 5명을 해치운 후 제스고르 근처의 해골망치 초소에 있는 투사 암벨란에게 보고하십시오.‡Mata 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada. A continuación, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Mata 10 guardias Mano Destrozada, 10 rabiosos Mano Destrozada y 5 acólitos Mano Destrozada. A continuación, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Tuez 10 Gardes de la Main brisée, 10 Berserkers de la Main brisée et 5 Acolytes de la Main brisée, puis faites votre rapport au garde de pierre Ambelan au Poste de Brise-échine près de Zeth\'Gor.‡杀死10名碎手卫兵、10名碎手狂战士和5名碎手侍僧，然后向塞斯高附近断背岗哨的石头守卫安比兰报到。‡殺掉10個破碎之手護衛，10個破碎之手狂戰士，以及5個破碎之手侍僧，完成後回到薩斯葛爾附近的斷脊氏族崗哨找石衛士安比藍。',
  }
},
[10153] = {
  {
    '‡Спасти разведчицу Маху‡Die Späherin Makha‡‡Rescate de la exploradora Makha‡Rescate de la exploradora Makha‡Il faut sauver l\'éclaireur Makha‡拯救斥候玛克哈‡',
    nil,
    '‡Следуйте дальше к югу вдоль Южного бастиона и постарайтесь найти, где боевой командир Некрогг держит в плену разведчицу Маху.‡Setzt Euren Weg über den Pfad des Ruhms fort und sucht nach dem Ort, an dem Kriegsboss Nekrogg Späherin Makha gefangen hält.‡‡Sigue hacia el sur por El Camino a la Gloria, hasta la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene prisionera a la exploradora Makha.‡Sigue hacia el sur por El Camino a la Gloria, hasta la Muralla Sur y busca el lugar donde el mandón de guerra Nekrogg tiene prisionera a la exploradora Makha.‡Poursuivez vers le sud en traversant le sentier de la Gloire vers le Rempart du sud et cherchez l\'endroit où le mène-guerre Nekrogg détient l\'éclaireur Makha.‡‡',
  }
},
[10154] = {
  {
    '‡План побега‡Fluchtplan‡‡Planear la huida‡Planear la huida‡Préparation de l\'évasion‡逃脱计划‡',
    nil,
    '‡Убейте гренадера клана Изувеченной Длани и принесите примитивную взрывчатку разведчице Махе в форт Гор\'газ.‡Tötet einen Grenadier des Lachenden Schädels und bringt seine primitive Sprengladung zu Späherin Makha im Außenposten von Gor\'gaz.‡‡Mata a un granadero Mano Destrozada y lleva sus explosivos rudimentarios a la exploradora Makha en la Avanzada Gor\'gaz.‡Mata a un granadero Mano Destrozada y lleva sus explosivos rudimentarios a la exploradora Makha en la Avanzada Gor\'gaz.‡Trouvez un Grenadier de la Main brisée et apportez ses Explosifs rudimentaires à l\'éclaireur Makha à l\'avant-poste de Gor\'gaz.‡‡',
  }
},
[10155] = {
  {
    '‡Провокация‡Den Kriegsboss provozieren‡‡Provocando al mandón de guerra‡Provocando al mandón de guerra‡Provoquer le Mène-guerre‡挑衅指挥官‡',
    nil,
    '‡Используйте примитивную взрывчатку, чтобы создать шум и выманить боевого командира Некрогга из его башни. Убейте его, заберите Ключ Некрогга и откройте клетку разведчицы Махи. Об освобождении разведчицы Махи доложите каменному стражу Амбелану на Заставу Разрушенного Хребта рядом с Зет\'Гором.‡Benutzt die primitive Sprengladung um einen Tumult zu veranstalten und Kriegsboss Nekrogg aus seinem Turm zu locken. Tötet ihn, besorgt Nekroggs Schlüssel und öffnet damit Späherin Makhas Käfig. Wenn Ihr Späherin Makha befreit habt, meldet Euch bei Steingardist Ambelan im Rückenbrecherposten in der Nähe von Zeth\'Gor.‡‡Utiliza los explosivos rudimentarios para crear una distracción y conseguir sacar al mandón de guerra Nekrogg de su torre. Mátale, consigue la llave de Nekrogg y utilízala para abrir la jaula de la exploradora Makha. Cuando la hayas liberado, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Utiliza los explosivos rudimentarios para crear una distracción y conseguir sacar al mandón de guerra Nekrogg de su torre. Mátale, consigue la llave de Nekrogg y utilízala para abrir la jaula de la exploradora Makha. Cuando la hayas liberado, preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma, cerca de Zeth\'Gor.‡Utilisez les Explosifs rudimentaires pour semer le trouble et attirer le mène-guerre Nekrogg hors de sa tour. Tuez-le, prenez la clé de Nekrogg et utilisez-la pour ouvrir la cage de l\'éclaireur Makha. Une fois que vous aurez libéré Makha, présentez-vous au garde de pierre Ambelan au Poste de Brise-échine près de Zeth\'Gor.‡‡',
  }
},
[10156] = {
  {
    '‡Кто отдает приказы?‡Auf wessen Befehl hin?‡‡¿Quién manda aquí?‡¿Quién manda aquí?‡Sous les ordres de qui?‡谁的命令？‡',
    nil,
    '‡Убейте 20 рубак и 10 чернокнижников клана Изувеченной Длани и захватите распоряжения военного инструктора Зурока. После этого возвращайтесь к каменному стражу Амбелану на Заставу Хребтолома.‡Tötet 20 Grunzer der Zerschmetterten Hand, 10 Hexenmeister der Zerschmetterten Hand und besorgt Euch Drillmeister Zurok\'s Anweisungen. Kehrt dann zu Steingardist Ambelan im Rückenbrechergrat zurück.‡‡Mata 20 brutos Mano Destrozada, 10 brujos Mano Destrozada y consigue las órdenes del maestro de maniobras Zurok. Después, ve a ver al guardia de piedra Ambelan en la Avanzada Rompeloma.‡Mata 20 brutos Mano Destrozada, 10 brujos Mano Destrozada y consigue las órdenes del maestro de maniobras Zurok. Después, ve a ver al guardia de piedra Ambelan en la Avanzada Rompeloma.‡Tuez 20 Grunts de la Main brisée et 10 Démonistes de la Main brisée, et emparez-vous des Ordres du maître de manœuvre Zurok. Puis retournez voir le garde de pierre Ambelan au Poste de Brise-échine.‡‡',
  }
},
[10157] = {
  {
    '‡Разжаловать командира‡Die Beseitigung des Kommandanten‡‡Vencer al comandante‡Vencer al comandante‡Liquider le commandant‡刺杀指挥官‡',
    nil,
    '‡Уничтожьте командира соединения Горакса и доложите о выполнении задания темному охотнику Ти\'джину из Траллмара.‡Tötet Truppenkommandant Gorax und meldet Euch dann bei Schattenjäger Ty\'jin in Thrallmar zurück.‡‡Mata al comandante en jefe Gorax y preséntate ante el cazador de las Sombras Ty\'jin en Thrallmar.‡Mata al comandante en jefe Gorax y preséntate ante el cazador de las Sombras Ty\'jin en Thrallmar.‡Tuez le commandant de corps Gorax et faites votre rapport au chasseur des ombres Ty\'jin à Thrallmar.‡‡',
  }
},
[10158] = {
  {
    '‡Припасы Кровавой Глазницы‡Vorräte des Blutenden Auges‡피눈물 보급품‡Suministros Foso Sangrante‡Suministros Foso Sangrante‡Les fournitures de l\'Orbite-sanglante‡血环补给品‡血之谷補給品',
    nil,
    '‡Уничтожьте 6 складов припасов клана Кровавой Глазницы и доложите о выполнении задания каменному стражу Амбелану с Заставы Хребтолома.‡Zerstört 6 Stapel Vorräte des Blutenden Auges und meldet Euch dann bei Steingardist Ambelan im Rückenbrecherposten zurück.‡‡Destruye 6 pilas de suministros Foso Sangrante y preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma.‡Destruye 6 pilas de suministros Foso Sangrante y preséntate ante el guardia de piedra Ambelan en la Avanzada Rompeloma.‡Détruisez 6 piles de Fournitures de l\'Orbite-sanglante et faites votre rapport au garde de pierre Ambelan au Poste de Brise-échine.‡‡',
  }
},
[10159] = {
  {
    'Mantenha o Monte Presacúleo limpo!‡Очистить холм Колючего Клыка!‡Haltet den Dornnebelhügel sauber!‡가시송곳니 언덕 사수!‡Mantener despejada la Colina Colmillespinado‡Mantener despejada la Colina Colmillespinado‡Nettoyer la colline de Roncecroc‡扫清棘牙岭！‡清光棘牙丘陵!',
    nil,
    'Mate 8 Assoladores Presacúleos e 8 Cospeçonhas Presacúleos, e então fale novamente com Mauram Casco Robusto, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Убейте 8 опустошителей Колючего Клыка и 8 ядоплюев Колючего Клыка. После выполнения задания возвращайтесь к Махураму Крепкому Копыту на Кенарийскую заставу на полуострове Адского Пламени.‡Tötet 8 Dornenfangfelshetzer und 8 Dornenfanggiftspucker und kehrt dann zu Mahuram Starkhuf im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡가시송곳니 갈퀴발톱 8마리, 맹독 가시송곳니 갈퀴발톱 8마리를 처치한 후 지옥불 반도의 세나리온 초소에 있는 마후람 스타우트후프에게 보고해야 합니다.‡Mata 8 devastadores Colmillespinados y 8 escupetósigos Colmillespinados. A continuación ve a ver a Mahuram Pezuña Recia en el Puesto Cenarion, en la Península del Fuego Infernal.‡Mata 8 devastadores Colmillespinados y 8 escupetósigos Colmillespinados. A continuación ve a ver a Mahuram Pezuña Recia en el Puesto Cenarion, en la Península del Fuego Infernal.‡Tuez 8 Ravageurs Roncecroc et 8 Crache-venin Roncecroc, puis retournez voir Mahuram Sabot-robuste au Poste cénarien dans la péninsule des Flammes infernales.‡杀死8只棘牙掠食者和8只棘牙喷毒者，然后返回地狱火半岛的塞纳里奥哨站，向玛霍拉姆·硬蹄复命。‡殺死8隻棘牙劫毀者還有8隻棘牙吐毒者然後回到地獄火半島的塞納里奧前哨找馬琥藍·胖蹄。',
  }
},
[10160] = {
  {
    'Conheça seu inimigo‡Врага нужно знать в лицо‡Den Feind kennen‡적군 파악‡Conoce a tu enemigo‡Conoce a tu enemigo‡Connais ton adversaire‡知己知彼‡了解你的敵人',
    nil,
    'Fale com a Tenente Amadi na velha torre da guarda, logo a oeste da Fortaleza da Honra.‡Поговорите с лейтенантом Амади в старой сторожевой башне на западе Оплота Чести.‡Sprecht mit Leutnant Amadi im alten Wachturm im Westen der Ehrenfeste.‡명예의 요새 바로 서쪽의 오랜 경비탑에 있는 부관 아마디와 대화해야 합니다.‡Habla con la teniente Amadi en la vieja torre vigía justo al oeste del Bastión del Honor.‡Habla con la teniente Amadi en la vieja torre vigía justo al oeste del Bastión del Honor.‡Parlez au lieutenant Amadi à la vieille tour de garde juste à l\'ouest du bastion de l\'Honneur.‡与荣耀堡西部哨塔内的阿曼蒂中尉谈一谈。‡到榮譽堡西方的老舊守衛塔去與阿瑪迪中尉談談。',
  }
},
[10161] = {
  {
    'Em caso de emergência...‡В случае чрезвычайной ситуации...‡Im Notfall...‡긴급 상황‡En caso de emergencia...‡En caso de emergencia...‡En cas d\'urgence...‡以防万一......‡如果情況緊急……',
    nil,
    'Colete 30 peças de Escombros de Zepelim e leve-as para Gritonho Ouvessorte, o "Berrante", no Zepelim Caído.‡Соберите 30 обломков дирижабля и принесите Скриду Многослову по прозвищу "Крикун" на место крушения дирижабля.‡Sammelt 30 Zeppelintrümmer und bringt sie zu "Schreihals" Quack Lufthans bei der Zeppelinabsturzstelle.‡비행선 추락지에 있는 "호들갑쟁이" 스크리드 럭히드에게 비행선 잔해 30개를 가져가야 합니다.‡Consigue 30 restos del zepelín y llévaselas a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Consigue 30 restos del zepelín y llévaselas a "Alaridos" Screed Sinsuerte en el Zepelín Caído.‡Récupérez 30 Débris de zeppelin et rapportez-les à Laïus « Brailleur » Airbuse à l\'Épave du zeppelin.‡将30块飞艇碎片交给飞艇坠毁点的"尖嗓子"斯克里·拉克希德。‡收集30個飛艇殘骸，並帶回給飛艇失事地的『驚嘆』史哥利德·幸運心。',
  }
},
[10162] = {
  {
    'Missão: A Prateleira Abissal‡Задание: Косогор Бездны‡Mission: Die Abyssische Untiefe‡임무: 심연의 절벽‡Misión: La Plataforma Abisal‡Misión: La Plataforma Abisal‡Mission : La saillie abyssale‡任务：地狱岩床‡任務:深淵沙洲',
    nil,
    'O Comandante To\'acha do Posto dos Destroços, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по приказу командира передовой То\'арха у останков Сквернобота на полуострове Адского Пламени.‡Vorpostenkommandant To\'arch im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen vernichtet.‡지옥불 반도의 지옥절단기 함락지에 있는 전방사령관 토아크가 간아그 일꾼 20명, 모아그 감독관 5명을 처치하고 지옥 대포 5개를 파괴해 달라고 부탁했습니다.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante de vanguardia To\'arch de la Caída del Atracador Vil en la Península del Fuego Infernal quiere que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le commandant des lignes avancées To\'arch du Trépas du saccageur dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛机甲残骸的前线指挥官托尔克要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上劫奪者荒野的前線指揮官吐阿奇已經要求你消滅20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10163] = {
  {
    'Missão: A Prateleira Abissal‡Задание: Косогор Бездны‡Mission: Die Abyssische Untiefe‡임무: 심연의 절벽‡Misión: La Plataforma Abisal‡Misión: La Plataforma Abisal‡Mission : La saillie abyssale‡任务：地狱岩床‡任務:深淵沙洲',
    nil,
    'O Comandante de Ala Grifongar do Posto Despedaçado, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по приказу командира звена Грифонгара с Парящей заставы на полуострове Адского Пламени.‡Schwadronskommandant Greifgar im Trümmerposten auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen vernichtet.‡지옥불 반도에 있는 징검다리 거점의 편대사령관 그리폰가르가 간아그 일꾼 20명, 모아그 감독관 5명, 5개의 지옥 대포를 파괴해 달라고 부탁했습니다.‡El comandante del aire Grifongar del Puesto Devastación, en la Península del Fuego Infernal, ha solicitado que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante del aire Grifongar del Puesto Devastación, en la Península del Fuego Infernal, ha solicitado que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le chef d\'escadrille Griffongar de la Halte de l\'expédition dans la péninsule des Flammes infernales vous a demandé de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛破碎岗哨的空军指挥官格莱芬加尔要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上破碎崗哨的空軍指揮葛萊弗卡爾要你去殺掉20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10164] = {
  {
    'Tudo vai dar pé‡Все будет в порядке‡Alles wird gut‡영혼의 자유를 위하여‡Todo irá bien‡Todo irá bien‡Tout va bien se passer‡一切都会变好的‡一切都會很好',
    nil,
    'O Grão-pai Aldrimus, na entrada das Catacumbas Auchenai de Auchindoun, quer que você entre nas Catacumbas Auchenai e mate o Exarca Maladaar.‡Проникните в Аукенайские гробницы и уничтожьте экзарха Маладаара по просьбе Великого Отца Алдримуса, который находится снаружи Аукенайских гробниц Аукиндона.‡Großvater Aldrimus außerhalb der Auchenaikrypta von Auchindoun möchte, dass Ihr in die Auchenaikrypta geht und Exarch Maladaar vernichtet.‡아킨둔의 아키나이 납골당 바깥에 서 있는 대부 알드리머스가 아키나이 납골당에 들어가서 총독 말라다르를 해치워달라고 부탁했습니다.‡Abuelo Aldrimus, fuera de las Criptas Auchenai en Auchindoun, quiere que entres en las criptas y mates al exarca Maladaar.‡Abuelo Aldrimus, fuera de las Criptas Auchenai en Auchindoun, quiere que entres en las criptas y mates al exarca Maladaar.‡Grandpère Aldrimus, à l\'extérieur des cryptes Auchenaï d\'Auchindoun, vous a demandé d\'entrer dans les cryptes Auchenaï et de détruire l\'exarque Maladaar.‡奥金顿奥金尼地穴外的奥德里姆斯宗父要你进入奥金尼地穴，消灭大主教玛拉达尔。‡站在奧齊頓的奧奇奈地穴外的大祖父阿爾崔瑪斯要你進入奧奇奈地穴並殺掉主教瑪拉達爾。',
  }
},
[10165] = {
  {
    'Minando a concorrência‡Жестокая вещь – конкуренция‡Die Konkurrenz untergraben‡경쟁자 처치‡Eliminar a la competencia‡Eliminar a la competencia‡Casser les prix‡扫除竞争者‡暗殺競爭對手',
    nil,
    'O Príncipe do Nexus Haramad, localizado junto à entrada das Tumbas de Mana, quer que você mate o Príncipe do Nexus Shaffar e lhe traga as Bandagens de Shaffar.‡Убейте принца нексуса Шаффара по просьбе принца нексуса Харамада, находящегося снаружи Гробниц маны, и принесите ему обмотки Шаффара.‡Nexusprinz Haramad außerhalb der Managruft möchte, dass Ihr Nexusprinz Shaffar tötet und ihm Shaffars Bandagen bringt.‡마나 무덤 밖에 있는 연합왕자 하라매드가 연합왕자 샤파르를 해치우고 샤파르의 붕대를 가져다달라고 부탁했습니다.‡El príncipe-nexo Haramad, que está junto a las Tumbas de Maná, quiere que mates al príncipe-nexo Shaffar y le lleves su mortaja.‡El príncipe-nexo Haramad, que está junto a las Tumbas de Maná, quiere que mates al príncipe-nexo Shaffar y le lleves su mortaja.‡Le prince-nexus Haramad, qui se trouve à l\'extérieur des Tombes-mana, veut que vous alliez tuer le prince-nexus Shaffar et que vous lui rapportiez le Cafetan de Shaffar.‡法力陵墓外的节点亲王哈拉迈德要你杀死节点亲王沙法尔，并将沙法尔的护腕带交给他。‡法力墓地外的奈薩斯王子哈拉瑪德要你去殺掉奈薩斯王子薩法爾並將薩法爾裹帶帶回來給他。',
  }
},
[10166] = {
  {
    'Memórias do Cascabranca‡Память о Белостволе‡Weißborkes Erinnerung‡흰나무껍질의 기억‡La memoria de Cortezablanca‡La memoria de Cortezablanca‡La mémoire de Blanchécorce‡怀特巴克的记忆‡白吼的記憶',
    nil,
    'Larianna Fluminéola quer que você ponha o Pingente do Velho Cascabranca ao lado da pedra rúnica na Mata Queimada.‡Заройте подвеску Старого Белоствола у рунического камня в Выжженной роще по просьбе Ларианны Речной Ветер.‡Larianna Flusswind möchte, dass Ihr Weißborkes Anhänger beim Runenstein im versengten Hain vergrabt.‡라리아나 리버윈드가 늙은 흰나무껍질의 목걸이를 불타버린 숲에 있는 마법석 옆에 놓아달라고 부탁했습니다.‡Larianna Ríobrisa quiere que entierres el colgante del viejo Cortezablanca junto a la piedra rúnica de La Arboleda Agostada.‡Larianna Ríobrisa quiere que entierres el colgante del viejo Cortezablanca junto a la piedra rúnica de La Arboleda Agostada.‡Larianna Ruissevent veut que vous placiez le Pendentif du vieux Blanchécorce près de la pierre runique au Bosquet incendié.‡拉莉亚娜·河风要你将怀特巴克的坠饰放在焦痕谷的符石上。‡拉瑞安娜·河風要你在烈焰邊境將老白樹墜飾放置在符文石旁邊。',
  }
},
[10167] = {
  {
    'Auchindoun...‡Аукиндон...‡Auchindoun...‡아킨둔...‡Auchindoun...‡Auchindoun...‡Auchindoun...‡奥金顿......‡奧齊頓……',
    nil,
    'Vá até as Catacumbas Auchenai, no Deserto de Ossos da Mata Terokkar, e mate o Exarca Maladaar para libertar o Espírito de D\'ore.‡Отправляйтесь в Аукенайские гробницы в Костяных пустошах леса Тероккар, убейте экзарха Маладаара и освободите дух Д\'оре.‡Reist zur Auchenaikrypta in der Knochenwüste der Wälder von Terokkar und tötet Exarch Maladaar um den Geist von D\'ore zu befreien.‡테로카르 숲의 해골 무덤에 있는 아키나이 납골당으로 가서 총독 말라다르를 처치하고 도레의 영혼을 풀어주어야 합니다.‡Ve a las Criptas Auchenai, en El Vertedero de Huesos del Bosque de Terokkar, y mata al exarca Maladaar para liberar al espíritu de D\'ore.|n‡Ve a las Criptas Auchenai, en El Vertedero de Huesos del Bosque de Terokkar, y mata al exarca Maladaar para liberar al espíritu de D\'ore.|n‡Voyagez jusqu\'aux cryptes Auchenaï dans le désert des Ossements de la forêt de Terokkar et tuez l\'exarque Maladaar pour libérer l\'esprit de D\'ore.‡前往泰罗卡森林白骨荒野的奥金尼地穴，杀死大主教玛拉达尔，解救德欧里的灵魂。‡前往泰洛卡森林的白骨荒野的奧奇奈地穴，並殺掉主教瑪拉達爾以釋放迪歐瑞的靈魂。',
  }
},
[10168] = {
  {
    'O que a alma vê‡Что видит душа‡Was die Seele sieht‡영혼이 본 것‡Reflejos del alma‡Reflejos del alma‡Par les yeux de l\'âme...‡灵魂之眼‡靈魂看見的',
    nil,
    'Encontre um dos Espelhos da Alma nas Catacumbas Auchenai e use-o para evocar um Espírito Enegrecido de Antepassados Orcs Antigos em Nagrand. Destrua 15 Espíritos Enegrecidos para que os antepassados possam descansar em paz.|n|nQuando completar a tarefa, retorne à Mãe Kashur, nas Terras Ancestrais, em Nagrand.‡Найдите зеркало Души в Аукенайских гробницах и используйте его, чтобы выманить темного духа из древнего орка-предка в Награнде. Уничтожьте 15 темных духов, чтобы орочьи предки могли упокоиться с миром.|n|nКогда исполните поручение, возвращайтесь к Матери Кашур в Земли Предков.‡Sucht einen Seelenspiegel in der Auchenaikrypta und benutzt ihn, um einen getrübten Geist eines uralten Orcahnen von Nagrand zu rufen. Zerstört 15 getrübte Geister, damit die Ahnen in Frieden ruhen können.|n|nKehrt zu Mutter Kashur im Ahnengrund zurück, wenn Ihr fertig seid.‡아키나이 납골당 어딘가에 있는 영혼의 거울을 찾아내십시오. 그런 다음 나그란드의 고대 오크 선조에게 사용해 어둠의 영혼을 불러내야 합니다. 이 어둠의 영혼 15명을 파괴해서 선조들이 편히 잠들게 해주십시오.|n|n임무를 마치면 선조의 터에 있는 대모 카슈르에게 돌아가십시오.‡Encuentra un espejo de alma en las Criptas Auchenai y úsalo para llamar a un espíritu oscurecido de los antepasados orcos ancestrales en Nagrand. Destruye 15 espíritus oscurecidos para que los antepasados puedan descansar en paz.|n|nDespués ve a ver a Madre Kashur a las Tierras Ancestrales.‡Encuentra un espejo de alma en las Criptas Auchenai y úsalo para llamar a un espíritu oscurecido de los antepasados orcos ancestrales en Nagrand. Destruye 15 espíritus oscurecidos para que los antepasados puedan descansar en paz.|n|nDespués ve a ver a Madre Kashur a las Tierras Ancestrales.‡Trouvez un Miroir des âmes quelque part dans les cryptes Auchenaï et utilisez-le pour invoquer un Esprit assombri issu des Ancêtres d\'anciens orcs en Nagrand. Détruisez 15 Esprits assombris afin que les ancêtres puissent reposer en paix.|n|nRetournez voir Mère Kashur dans les Terres ancestrales lorsque vous aurez terminé cette tâche.‡在奥金尼地穴中找到一面灵魂之镜，用它召唤纳格兰上古兽人先祖的黑暗之魂。消灭15个黑暗的灵魂，让兽人先祖得以安然长眠。|n|n完成任务后，向先祖之地的卡舒尔宗母复命。‡在奧奇奈地穴裡的某處找到一面靈魂之鏡，並且用它召喚來自納葛蘭的古老的獸人元祖的晦暗的靈魂前來。消滅15個晦暗的靈魂好讓那些先祖能夠安息。|n|n當任務完成後，回到先祖之地的族母卡修爾那裡。',
  }
},
[10169] = {
  {
    'Perdendo com elegância‡Проиграть с честью‡In Würde verlieren‡영예로운 패배‡Saber perder‡Saber perder‡Il faut savoir perdre‡镇静剂‡優雅的失敗',
    nil,
    'O Magíster Falris, em Shattrath, quer que você leve a Ampola de Soro Sedativo até o Terraço da Luz e derrame o conteúdo da ampola na Panela do Regimento de Haronem.‡Вылейте сонную сыворотку в котел Харонема на террасе Света, после чего вернитесь к магистру Фальрису.‡Magister Falris in Shattrath möchte, dass Ihr die Phiole mit Beruhigungsserum zur Terrasse des Lichts bringt und sie in den Kochtopf von Haronems Regiment schüttet.‡샤트라스에 있는 마법학자 팔리스가 진정제가 든 약병을 빛의 정원으로 가져가서 명사수 연대의 요리 냄비에 부어 달라고 부탁했습니다.‡El magister Falris de Shattrath quiere que lleves el vial de suero sedativo a Bancal de la Luz y lo viertas en la olla del regimiento de Haronem.‡El magister Falris de Shattrath quiere que lleves el vial de suero sedativo a Bancal de la Luz y lo viertas en la olla del regimiento de Haronem.‡Le magistère Falris de Shattrath veut que vous apportiez la Fiole de sérum sédatif sur la Terrasse de la Lumière et que vous la versiez dans la Marmite du régiment d\'Haronem.‡沙塔斯城内的魔导师法尔里斯要求你将一瓶镇静剂带去圣光广场，倒入射手队的烹饪锅内。‡撒塔斯城的博學者法爾瑞斯要你帶著瓶裝鎮靜藥水到聖光露臺並且倒入哈洛尼恩的大烹飪鍋。',
  }
},
[10170] = {
  {
    'Retorno à Grande Mãe‡Возвращение к Великой Матери‡Rückkehr zur Großmutter‡대모에게 돌아가기‡Regresa junto a la Abuela‡Regresa junto a la Abuela‡Retourner voir la grande-mère‡返回盖亚安祖母身边‡回到主母身邊',
    nil,
    'Vá novamente à Garadar e fale com a Grande Mãe Geyah.‡Возвращайтесь в Гарадар и поговорите с великой матерью Гейей.‡Kehrt nach Garadar zurück und sprecht mit Großmutter Geyah.‡가라다르로 돌아가서 대모 게야와 대화하십시오.‡Vuelve a Garadar y habla con la Abuela Geyah.‡Vuelve a Garadar y habla con la Abuela Geyah.‡Retournez à Garadar et parlez à la grande-mère Geyah.‡返回加拉达尔，与盖亚安祖母谈一谈。‡回到卡拉達爾找主母吉雅談談。',
  }
},
[10171] = {
  {
    'O chefe inconsolável‡Безутешный Вождь‡Der untröstliche Häuptling‡소심한 족장‡El inconsolable jefe‡El inconsolable jefe‡Le chef inconsolable‡消沉的酋长‡極為傷心的酋長',
    nil,
    'A Grande Mãe Geyah, de Garadar, quer que você fale com Garrosh.‡Поговорите с Гаррошем.‡Großmutter Geyah in Garadar möchte, dass Ihr mit Garrosh sprecht.‡가라다르에 있는 대모 게야가 가로쉬와 대화해 보라고 부탁했습니다.‡La Abuela Geyah en Garadar te ha pedido que hables con Garrosh.‡La Abuela Geyah en Garadar te ha pedido que hables con Garrosh.‡La grande-mère Geyah à Garadar vous a demandé de parler à Garrosh.‡加拉达尔的盖亚安祖母要你去跟加尔鲁什谈一谈。‡卡拉達爾的主母吉雅要你去與卡爾洛斯談談。',
  }
},
[10172] = {
  {
    'Não há esperanças‡Надежды нет‡Es gibt keine Hoffnung‡희망은 어디에도 없다‡No hay esperanza‡No hay esperanza‡Il n\'y a plus d\'espoir‡毫无希望‡沒有希望了',
    nil,
    'Fale novamente com a Grande Mãe Geyah e relate-lhe o que Garrosh contou para você.‡Вернитесь к Великой Матери Гейе и передайте ей слова Гарроша.‡Sprecht mit Großmutter Geyah und erzählt ihr, was Garrosh Euch gesagt hat.‡대모 게야에게 가로쉬가 한 말을 전해야 합니다.‡Habla con la Abuela Geyah y cuéntale lo que Garrosh te ha dicho.‡Habla con la Abuela Geyah y cuéntale lo que Garrosh te ha dicho.‡Parlez à la grande-mère Geyah et rapportez-lui les propos de Garrosh.‡将加尔鲁什所说的话转告给盖亚安祖母。‡去與主母吉雅談談並告訴她卡爾洛斯跟你說了什麼。',
  }
},
[10173] = {
  {
    'O cajado do arquimago‡Посох верховного мага‡Der Stab des Erzmagiers‡대마법사의 지팡이‡El bastón del archimago‡El bastón del archimago‡Le bâton de l\'archimage‡大法师的法杖‡大法師之杖',
    nil,
    'Recupere o Cajado do Arquimago Vargoth de Ekkorash, a Inquisidora e traga-o a Ravandwyr, na Área 52. Para tirar Ekkorash de seu esconderijo, espalhe o pó conjurador no braseiro no centro das ruínas.‡Отнимите посох верховного мага Варгота у Эккораш Инквизитора и принесите Равандвиру в Зону 52. Чтобы выманить Эккораш из укрытия, бросьте волшебный порошок на жаровню в центре руин.‡Besorgt Erzmagier Vargoths Stab von Ekkorash der Inquisitorin und bringt ihn zu Ravandwyr in Area 52. Um Ekkorash aus ihrem Versteck hervorzulocken, streut das Beschwörungspulver auf die Kohlenpfanne in der Mitte der Ruinen.‡에코라쉬로부터 대마법사 바르고스의 지팡이를 되찾은 다음 52번 구역에 있는 라반드위르에게 가져가야 합니다. 숨어 있는 에코라쉬를 불러내려면 폐허 중앙에 있는 화로에 창조의 가루를 뿌려야 합니다.‡Quítale el bastón del archimago Vargoth a Ekkorash la Inquisidora y llévaselo a Ravandwyr al Área 52. Para sacar a Ekkorash de su escondite, espolvorea el polvo de conjuro en el blandón que hay en el centro de las ruinas.‡Quítale el bastón del archimago Vargoth a Ekkorash la Inquisidora y llévaselo a Ravandwyr al Área 52. Para sacar a Ekkorash de su escondite, espolvorea el polvo de conjuro en el blandón que hay en el centro de las ruinas.‡Reprenez le Bâton de l\'archimage Vargoth à Ekkorash l\'Inquisitrice et apportez-le à Ravandwyr dans la Zone 52. Pour faire sortir Ekkorash de sa cachette, répandez la Poudre d\'abjuration sur le brasero au centre des ruines.‡从审讯者埃克拉斯手中夺得大法师瓦格斯的法杖，将它交给52区的拉文德维尔。要使埃克拉斯从藏身处现身，你需要向遗迹中心的火盆喷撒召唤粉尘。‡從『審判官』艾克爾拉斯那裡取回大法師瓦戈斯之杖，並且將它帶去給52區的羅樊德威。為了讓艾克爾拉斯現身，把喚魔粉末撒在廢墟中心的火盆上。',
  }
},
[10174] = {
  {
    'A maldição da Torre Violeta‡Проклятие Аметистовой башни‡Der Fluch des Violetten Turms‡보랏빛 탑의 저주‡La maldición de la Torre Violeta‡La maldición de la Torre Violeta‡La malédiction de la Tour pourpre‡紫罗兰之塔的诅咒‡紫羅蘭之塔的詛咒',
    nil,
    'Use o Cajado do Arquimago Vargoth para contatá-lo.|n|nSe perder o cajado, fale com Ravandwyr, na Área 52, para substituí-lo.‡Используйте посох верховного мага Варгота, чтобы связаться с верховным магом Варготом.|n|nЕсли вы утратили посох верховного мага Варгота, поговорите с Равандвиром в Зоне 52, чтобы получить замену.‡Benutzt Erzmagier Vargoths Stab um Kontakt mit Erzmagier Vargoth aufzunehmen.|n|nFalls Ihr Erzmagier Vargoths Stab verlieren solltet, bittet Ravandwyr in Area 52 um Ersatz.‡대마법사 바르고스의 지팡이를 사용하여 대마법사 바르고스와 접촉을 시도해야 합니다.|n|n대마법사 바르고스의 지팡이를 잃어버리면, 52번 구역에 있는 라반드위르와 대화하여 새로 얻으십시오.‡Utiliza el bastón del archimago Vargoth para contactar con él.|n|nSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr en el Área 52 para que te dé otro.‡Utiliza el bastón del archimago Vargoth para contactar con él.|n|nSi pierdes el bastón del archimago Vargoth, habla con Ravandwyr en el Área 52 para que te dé otro.‡Utilisez le Bâton de l\'archimage Vargoth pour entrer en contact avec ce dernier.|n|nSi vous perdez le Bâton de l\'archimage Vargoth, allez voir Ravandwyr dans la Zone 52 pour obtenir un double.‡利用大法师瓦格斯的法杖与他取得联系。|n|n如果你弄丢了大法师瓦格斯的法杖，可以向52区的拉文德维尔再要一根。‡使用大法師瓦戈斯之杖與大法師瓦戈斯連絡。|n|n如果你遺失了大法師瓦戈斯之杖，可以跟52區的羅樊德威談談取得一個替代品。',
  }
},
[10175] = {
  {
    'Thrall, Son of Durotan‡Тралл, сын Дуротана‡Thrall, Sohn Durotans‡듀로탄의 아들, 스랄‡Thrall, hijo de Durotan‡Thrall, hijo de Durotan‡Thrall, fils de Durotan‡萨尔，杜隆坦之子‡索爾，杜洛坦之子',
    nil,
    'Vá até Orgrimmar e entregue a mensagem de Geyah a Thrall.‡Отправляйтесь в Оргриммар и передайте Траллу сообщение от Гейи.‡Reist nach Orgrimmar und überbringt Thrall Geyahs Nachricht.‡오그리마로 가서 스랄에게 게야의 소식을 전해야 합니다.‡Ve a Orgrimmar y entrega a Thrall el mensaje de Geyah.‡Ve a Orgrimmar y entrega a Thrall el mensaje de Geyah.‡Rendez-vous à Orgrimmar et apportez le message de Geyah à Thrall.‡前往奥格瑞玛，将盖亚安祖母的口信告诉萨尔。‡到奧格瑪去將吉雅的訊息傳達給索爾。',
  }
},
[10176] = {
  {
    'Ar\'kelos, o guardião‡Страж Ар\'келос‡Ar\'kelos der Wächter‡수호자 알켈로스‡Ar\'kelos el Guardián‡Ar\'kelos el Guardián‡Ar\'kelos le Gardien‡守护者阿尔凯洛斯‡守護者阿其羅斯',
    nil,
    'Entre na Torre Violeta, no centro da Vila Kirin\'Var e derrote Ar\'kelos, em seguida fale com Arquimago Vargoth.‡Войдите в Аметистовую башню, расположенную в центре деревни Кирин\'Вар, и победите Ар\'келоса, затем поговорите с верховным магом Варготом.‡Betretet den Violetten Turm in der Mitte von Kirin\'Var und besiegt Ar\'kelos. Sprecht danach mit Erzmagier Vargoth.‡키린바르 마을의 중앙에 있는 보랏빛 탑에 들어가서 알켈로스를 처치한 다음 대마법사 바르고스와 대화해야 합니다.‡Entra en la Torre Violeta en el centro del Poblado Kirin\'Var y derrota a Ar\'kelos. A continuación, habla con el archimago Vargoth.‡Entra en la Torre Violeta en el centro del Poblado Kirin\'Var y derrota a Ar\'kelos. A continuación, habla con el archimago Vargoth.‡Entrez dans la Tour pourpre au centre de Kirin\'Var et triomphez d\'Ar\'kelos, puis parlez à l\'archimage Vargoth.‡进入肯瑞瓦村中心的紫罗兰之塔，击败阿尔凯洛斯，然后与大法师瓦格斯谈一谈。‡進入肯瑞瓦村莊中心的紫羅蘭之塔打敗阿其羅斯，完成後與大法師瓦戈斯談談。',
  }
},
[10177] = {
  {
    'Problemas em Auchindoun‡В Аукиндоне неспокойно‡Ärger in Auchindoun‡아킨둔의 문제‡Problemas en Auchindoun‡Problemas en Auchindoun‡Troubles à Auchindoun‡奥金顿的麻烦‡奧齊頓的麻煩',
    nil,
    'Apresente-se ao Comandante de Campo Mahfuun na entrada do Labirinto Soturno, em Auchindoun, que fica na Mata Terokkar.‡Доложите о своем прибытии боевому командиру Мафууну, который находится неподалеку от входа в Темный лабиринт в Аукиндоне в Лесу Тероккар.‡Meldet Euch bei Feldkommandeur Mahfuun beim Eingang zum Schattenlabyrinth in Auchindoun in den Wäldern von Terokkar.‡테로카르 숲, 아킨둔의 어둠의 미궁 입구에 있는 야전사령관 마푼에게 보고하십시오.‡Preséntate ante el comandante de campo Mahfuun en la entrada del Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Preséntate ante el comandante de operaciones Mahfuun en la entrada del Laberinto de las Sombras en Auchindoun, en el Bosque de Terokkar.‡Présentez-vous au commandant Mahfuun à l\'entrée du Labyrinthe des ombres à Auchindoun dans la forêt de Terokkar.‡前往泰罗卡森林的奥金顿，向暗影迷宫入口处的战地指挥官玛弗恩报到。‡向泰洛卡森林裡奧齊頓的暗影迷宮入口處的戰場元帥瑪赫范報到。',
  }
},
[10178] = {
  {
    'Encontrar o espião To\'gun‡Найти шпиона То\'гуна!‡Findet Spion To\'gun‡비밀요원 토군 찾기‡Encontrar al espía To\'gun‡Encontrar al espía To\'gun‡Trouver l\'espion To\'gun‡寻找间谍托古恩‡找尋間諜·吐剛',
    nil,
    'Encontre o Espião To\'gun no Labirinto Soturno de Auchindoun.‡Найдите шпиона То\'гуна в Темном лабиринте в Аукиндоне.‡Findet Spion To\'gun im Schattenlabyrinth von Auchindoun.‡아킨둔에 있는 어둠의 미궁에서 비밀요원 토군을 찾아야 합니다.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Localiza al espía To\'gun en el Laberinto de las Sombras, en Auchindoun.‡Trouvez l\'espion To\'gun dans le Labyrinthe des ombres d\'Auchindoun.‡进入奥金顿的暗影迷宫，寻找间谍托古恩的下落。‡在奧齊頓的暗影迷宮裡找到間諜·吐剛。',
  }
},
[10179] = {
  {
    'O zelador de Kirin\'Var‡Смотритель Кирин\'Вара‡Der Hüter von Kirin\'Var‡키린바르의 관리인‡El custodio de Kirin\'Var‡El custodio de Kirin\'Var‡Le protecteur de Kirin\'Var‡肯瑞瓦村的管理者‡肯瑞瓦的管理者',
    nil,
    'Fale com o Zelador Dieworth, na Vila Kirin\'Var, em Eternévoa.‡Поговорите с блюстителем Ценой Смерти в деревне Кирин\'Вар в Пустоверти.‡Sprecht mit Hüter Dierwert in Kirin\'Var im Nethersturm.‡황천의 폭풍의 키린바르 마을에 있는 관리인 디워스와 대화해야 합니다.‡Habla con el custodio Valemuerte en el Poblado Kirin\'Var, en Tormenta Abisal.‡Habla con el custodio Valemuerte en el Poblado Kirin\'Var, en Tormenta Abisal.‡Parlez au Protecteur Valemort à Kirin\'Var, au Raz-de-Néant.‡与虚空风暴肯瑞瓦村的管理者戴沃斯谈一谈。‡到虛空風暴的肯瑞瓦村莊找管理者戴沃斯談談。',
  }
},
[10180] = {
  {
    'Isfar não desiste‡Неудержимый‡Kann es einfach nicht lassen‡둘도 없는 오누이‡No puedo estar lejos‡No puedo estar lejos‡Incapable de rester à l\'écart‡无法袖手旁观‡無法置身事外',
    nil,
    'Fale com Isfar, que se encontra perto da entrada dos Salões dos Sethekk em Auchindoun.‡Поговорите с Исфаром, которого можно найти неподалеку от входа в Сетеккские залы в Аукиндоне.‡Sprecht mit Isfar beim Eingang zu den Sethekkhallen in Auchindoun.‡아킨둔의 세데크 전당 입구 근처에서 이스파르를 찾아 대화하십시오.‡Habla con Isfar. Le encontrarás cerca de la entrada de las Salas Sethekk en Auchindoun.‡Habla con Isfar. Le encontrarás cerca de la entrada de las Salas Sethekk en Auchindoun.‡Parlez à Isfar, qui se trouve près de l\'entrée des salles des Sethekk à Auchindoun.‡与奥金顿塞泰克大厅入口附近的伊斯法尔谈一谈。‡與伊斯法談談，你可以在奧齊頓的塞斯克大廳入口附近找到他。',
  }
},
[10182] = {
  {
    'Mago de Batalha Dathric‡Боевой маг Датрик‡Kampfmagier Dathric‡전투마법사 다스릭‡Mago de batalla Dathric‡Mago de batalla Dathric‡Le mage de bataille Dathric‡战斗法师达斯利克‡戰鬥法師達斯立克',
    nil,
    'Encontre o alojamento do Mago de Batalha Dathric no Estreito do Teurgo e retorne-a ao armeiro. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты боевого мага Датрика в переулке Волшебников и верните меч в оружейную стойку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Kampfmagier Dathric in der Zaubergasse und bringt die Klinge zurück in sein Waffenregal. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡다스릭의 검을 가지고 마법사 지구에 있는 전투마법사 다스릭의 집으로 가서 다스릭의 무기 선반에 놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias del mago de batalla Dathric en el Pasaje del Zahorí y devuelve la espada al expositor. A continuación habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias del mago de batalla Dathric en el Pasaje del Zahorí y devuelve la espada al expositor. A continuación habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile du mage de bataille Dathric dans l\'Allée des sorciers et replacez sa Lame sur le râtelier d\'armes. Puis parlez au protecteur Valemort à Kirin’Var.‡在巫师街内找到战斗法师达斯利克的家，将剑放回他的武器架上。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到戰鬥法師達斯立克的駐紮處將劍放回他的武器架。完成之後，與肯瑞瓦村莊的管理者戴沃斯談談。',
  }
},
[10183] = {
  {
    'Para a Área 52‡В Зону 52‡Auf nach Area 52‡52번 구역으로 출발‡Al Área 52‡Al Área 52‡En route pour la Zone 52‡前往52区‡前往52區',
    nil,
    'Entregue as Anotações do Eterologista ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Передайте записки пустолога ведущему ракетостроителю Фьюзеляжу, находящемуся в Зоне 52 в Пустоверти.‡Bringt die Notizen des Netheorologen zu Raketenchef Doppeldecker in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 황천전문가의 쪽지를 가져가야 합니다.‡Lleva las notas del abisólogo al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Lleva las notas del abisólogo al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Apportez les Notes du néantologue au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将虚空学家的笔记交给虚空风暴52区的火箭主管弗斯拉格。‡遞送虛空學家的手記給虛空風暴52區的火箭主管夫斯拉吉。',
  }
},
[10184] = {
  {
    'Reminiscências malévolas‡Зловещие останки‡Bösartige Überbleibsel‡원한을 가진 영혼들‡Restos malévolos‡Restos malévolos‡Vestiges malveillants‡狂暴的幽灵‡惡意的倖存者',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você derrote 20 Espíritos Cindidos na Praça da Cidade de Kirin\'Var.‡Смотритель Дайворт в деревне Кирин\'Вар просит вас победить 20 покалеченных духов на площади Кирин\'Вара.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr 20 abtrünnige Geister auf dem Ratsplatz tötet.‡키린바르 마을에 있는 관리인 디워스가 마을 광장에 있는 떠도는 원혼 20명을 처치해 달라고 부탁했습니다.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 20 espíritus aislados en la Plaza de la Ciudad de Kirin\'Var.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 20 espíritus aislados en la Plaza de la Ciudad de Kirin\'Var.‡Le protecteur Valemort de Kirin\'Var veut que vous vainquiez 20 Esprits disjoints de la Place centrale de Kirin\'Var.‡肯瑞瓦村的管理者戴沃斯要求你去肯瑞瓦村广场消灭20个被杀死的幽魂。‡肯瑞瓦村莊的管理者戴沃斯要你去肯瑞瓦的小鎮廣場殺掉20個分離的靈魂。',
  }
},
[10185] = {
  {
    'Uma sina pior do que a morte‡Участь хуже, чем смерть‡Schlimmer als der Tod‡죽음보다 더한 운명‡Terrible destino‡Terrible destino‡Un sort pire que la mort‡悲惨的命运‡比死還糟的命運',
    nil,
    'Mate 10 Matamagos e 10 Caçadores de Mana e fale novamente com o Zelador Dieworth, na vila Kirin\'Var.‡Убейте 10 убийц магов и 10 искателей маны и вернитесь к смотрителю Дайворту в деревню Кирин\'Вар.‡Tötet 10 Magiertöter und 10 Manasucher und kehrt zu Hüter Dierwert in Kirin\'Var zurück.‡마법사 학살자 10명, 마나 추적자 10명을 처치한 다음 키린바르 마을에 있는 관리인 디워스에게 돌아가야 합니다.‡Mata a 10 matamagos y 10 buscamanás y ve a ver al custodio Valemuerte al Poblado Kirin\'Var.‡Mata a 10 matamagos y 10 buscamanás y ve a ver al custodio Valemuerte al Poblado Kirin\'Var.‡Tuez 10 Pourfend-mage et 10 Chercheurs de mana puis retournez voir le protecteur Valemort à Kirin\'Var.‡杀死10个法师杀手和10个法力搜寻者，然后向肯瑞瓦村的管理者戴沃斯复命。‡殺掉10個法師殺手及10個法力尋找者後回到肯瑞瓦村莊找管理者戴沃斯。',
  }
},
[10186] = {
  {
    'Você foi convocado!‡Тебя наняли!‡Ihr seid eingestellt!‡B.O.O.M의 일원!‡¡Te contrato!‡¡Te contrato!‡On vous engage !‡你被雇了！‡你被雇用了!',
    nil,
    'Colete 10 Cristais da Matriz de Eterlítio e leve-os ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Соберите 10 астраллитиевых матричных кристаллов и принесите их ведущему ракетостроителю Фьюзеляжу в Зону 52 в Пустоверти.‡Sammelt 10 Astrallithiummatrixkristalle und kehrt dann zu Raketenchef Doppeldecker in Area 52 im Nethersturm zurück.‡에테리시움 맥석 수정 10개를 수집한 후에 황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 돌려주어야 합니다.‡Reúne 10 cristales de la matriz de eterlitio y vuelve a ver al jefe de cohetes Fuselaje en el Área 52 en la Tormenta Abisal.‡Reúne 10 cristales de la matriz de eterlitio y vuelve a ver al jefe de cohetes Fuselaje en el Área 52 en la Tormenta Abisal.‡Récupérez 10 Cristaux de matrice d\'etherlithium et apportez-les au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将10块以太锂矩阵水晶交给虚空风暴52区的火箭主管弗斯拉格。‡收集10個伊斯利母體水晶，然後帶回虛空風暴的52區交給火箭主管夫斯拉吉。',
  }
},
[10187] = {
  {
    'Uma mensagem para o arquimago‡Послание для верховного мага‡Eine Nachricht für den Erzmagier‡대마법사에게 전할 전갈‡Mensaje del archimago‡Mensaje del archimago‡Un message pour l\'archimage‡给大法师的消息‡給大法師的訊息',
    nil,
    'Fale com o Arquimago Vargoth, no topo da Torre Violeta, em Eternévoa.‡Поговорите с Верховным магом Варготом на вершине Сиреневой башни в Пустоверти.‡Sprecht mit Erzmagier Vargoth im Violetten Turm im Nethersturm.‡황천의 폭풍, 보랏빛 탑의 꼭대기에 있는 대마법사 바르고스와 대화해야 합니다.‡Habla con el archimago Vargoth en la cima de la Torre Violeta, en Tormenta Abisal.‡Habla con el archimago Vargoth en la cima de la Torre Violeta, en Tormenta Abisal.‡Parlez à l\'archimage Vargoth en haut de la Tour pourpre, au Raz-de-Néant.‡与虚空风暴紫罗兰之塔塔顶的大法师瓦格斯谈一谈。‡到虛空風暴的紫羅蘭之塔頂端與大法師瓦戈斯對話。',
  }
},
[10188] = {
  {
    'O signo de Krasus‡Печать Краса‡Das Siegel von Krasus‡크라서스의 인장‡El sigilo de Krasus‡El sigilo de Krasus‡Le cachet de Krasus‡克拉苏斯的魔符‡卡薩斯符印',
    nil,
    'Recupere o signo de Krasus da Mesmerizadora Mariana, em Manaforja Coruu, a noroeste da Torre Violeta.‡Заберите Печать Краса у чароплета Марианы, находящейся в Манагорне Коруу, к северо-западу от Аметистовой башни.‡Holt Euch das Siegel von Krasus von Zauberbinderin Maryana in der Manaschmiede Coruu, nordwestlich vom Violetten Turm.‡보랏빛 탑의 북서쪽 코루 마나괴철로에 있는 역술사 말야나에게서 크라서스의 인장을 되찾아야 합니다.‡Quítale el sigilo de Krasus a la vinculahechizos Maryana en la Forja de Maná Coruu, al noroeste de la Torre Violeta.‡Quítale el sigilo de Krasus a la vinculahechizos Maryana en la Forja de Maná Coruu, al noroeste de la Torre Violeta.‡Reprenez le Cachet de Krasus à la Lieuse de sort Maryana à la Manaforge Coruu, au nord-ouest de la Tour Pourpre.‡前往紫罗兰之塔西北方的法力熔炉：库鲁恩，从缚法者玛亚纳手中夺得克拉苏斯的魔符。‡從法力熔爐寇魯的縛法者瑪莉安娜那取得卡薩斯符印，就在紫羅蘭之塔的西北方。',
  }
},
[10189] = {
  {
    'Manaforja B\'naar‡Манагорн Б\'наар‡Manaschmiede B\'naar‡브나르 마나괴철로‡Forja de Maná B\'naar‡Forja de Maná B\'naar‡Manaforge B\'naar‡法力熔炉：布纳尔‡法力熔爐巴納爾',
    nil,
    'O Mestre Espião Thalodien, na Área 52, quer que você vá às adjacências de Manaforja B\'naar e consiga a Lista de Funcionários de B\'naar do Capitão Arathyn.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Патрон шпионов Талодиен, находящийся в Зоне 52, хочет, чтобы вы направились в окрестности манагорна Б\'наар и отобрали список персонала манагорна Б\'наар у капитана Аратина.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Spionagemeister Thalodien in Area 52 möchte, dass Ihr zum Rand der Manaschmiede B\'naar geht und die Stammrolle von B\'naar von Hauptmann Arathyn besorgt.|n|nDas Abschließen von Aufgaben für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 첩보단장 탈로디엔이 브나르 마나괴철로의 외곽으로 가서 대장 아라신으로부터 브나르 개인 신상 명부를 입수해 달라고 부탁했습니다.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y recuperes lista de personal de B\'naar del capitán Arathyn.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y recuperes lista de personal de B\'naar del capitán Arathyn.|n|nA medida que completas misiones para los Arúspices disminuye tu nivel de reputación con los Aldor.‡Le maître-espion Thalodien de la Zone 52 veut que vous vous rendiez dans les environs de la manaforge B\'naar et que vous récupériez le Tableau de service du personnel de B\'naar sur le capitaine Arathyn.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡52区的间谍大师萨罗迪恩要你从法力熔炉：布纳尔外的阿拉森上尉手中夺得布纳尔人员名册。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡52區的間諜大師薩洛迪恩要你去法力熔爐巴納爾的外圍從阿拉斯恩上尉身上取得巴納爾員工名冊。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10190] = {
  {
    'Recarregar as baterias‡Перезарядка батарей‡Batterien aufladen‡전지 충전‡Recargando las baterías‡Recargando las baterías‡Recharger les batteries‡电池充电‡補充電源',
    nil,
    'Use o disparador de recarga de bateria nos caçadores dimensionais até chegar ao nível 10 de recarga da bateria. Em seguida, leve-o à Especialista em Robôs Alley, nas Ruínas Enkaat, em Eternévoa.‡Используйте зарядное устройство для батарей применительно к достаточному количеству внепространственных охотников, чтобы довести зарядку батарей до уровня 10. Затем вернитесь к роботехнику Элли в руины Энкаата в Пустоверти.‡Benutzt den Batterieladeblaster bei genügend Phasenjägern, um den Batterieladestatus auf 10 zu bringen. Bringt die Batterie danach zu Bot-Spezialistin Alley in den Ruinen von Enkaat im Nethersturm zurück.‡차원의 마나 거머리들에게 전지 충전 광선총을 사용해서 전지 충전 레벨을 10까지 올린 후, 황천의 폭풍의 엔카트 폐허에 있는 로봇 전문가 앨리에게 돌려줘야 합니다.‡Usa la carga reponbatería en suficientes cazadores de fase para que el nivel de carga suba a 10. Regresa entonces junto a la especialista en robots Alley, en las Ruinas de Enkaat, en Tormenta Abisal.‡Usa la carga reponbatería en suficientes cazadores de fase para que el nivel de carga suba a 10. Regresa entonces junto a la especialista en robots Alley, en las Ruinas de Enkaat, en Tormenta Abisal.‡Utilisez la Pétoire charge-batterie sur assez de chasseurs phasiques pour faire monter le niveau de recharge de la batterie jusqu\'à 10. Ensuite, rapportez-la à la robotologue Alley aux ruines d\'Enkaat au Raz-de-Néant.‡对相位猎手使用电池充能器，直到电池充能等级到达10。然后将它交给虚空风暴恩卡特废墟的机器人专家艾蕾。‡將充電火槍使用在足夠的相位捕獵者身上直到電池蓄電量達到10。之後將它帶回虛空風暴的安卡特廢墟交給機器人專家艾里。',
  }
},
[10191] = {
  {
    'Mass v5.0 está vivo!‡Робот модели V жив!‡Nummer V lebt!‡막스 A. 밀리언 Mk. V 가동!‡¡Mark V está vivo!‡¡Mark V está vivo!‡Le Mod. V vit !‡麦克斯米林V型活了！‡充滿動力的馬克斯五號',
    nil,
    'Escolte Mass I. Mo v5.0 pelas Ruínas de Enkaat. Em seguida, fale com a Especialista em Robôs Alley do lado de fora das Ruínas de Enkaat, em Eternévoa.‡Сопроводите "Маккса А. Миллиона V" через руины Энкаата и обратно, обеспечив ему безопасность. Потом поговорите с роботехником Элли за пределами руин Энкаата в Пустоверти.‡Begleitet Maxx E. Million Nr. V durch die Ruinen von Enkaat und wieder in Sicherheit. Sprecht dann mit Bot-Spezialistin Alley außerhalb der Ruinen von Enkaat im Nethersturm.‡막스 A. 밀리언 Mk. V가 무사히 엔카트 폐허를 통과한 후에 일을 마치고 무사히 빠져나올 수 있도록 호위한 후, 황천의 폭풍의 폐허 바로 밖에 있는 로봇 전문가 앨리와 대화해야 합니다.‡Escolta el Maxx Y. Millón nº. V a través de las Ruinas de Enkaat y llévalo hasta un lugar seguro. Después habla con la especialista en robots Alley, en las afueras de las Ruinas de Enkaat en Tormenta Abisal.‡Escolta el Maxx Y. Millón nº. V a través de las Ruinas de Enkaat y llévalo hasta un lugar seguro. Después habla con la especialista en robots Alley, en las afueras de las Ruinas de Enkaat en Tormenta Abisal.‡Escortez le Maxx A. Million Mod. V dans les ruines d\'Enkaat jusqu\'à son retour en sécurité. Ensuite, allez voir la robotologue Alley à la sortie des ruines d\'Enkaat au Raz-de-Néant.‡护送麦克斯米林V型穿越恩卡特废墟并返回安全地带，然后与虚空风暴恩卡特废墟外的机器人专家艾蕾谈一谈。‡護送馬克斯A型機器人五號通過安卡特廢墟並安全的回來。完成後與在虛空風暴的安卡特廢墟外的機器人專家艾里談談。',
  }
},
[10192] = {
  {
    'O compêndio de Krasus‡Компендиум Краса‡Krasus\' Kompendium‡크라서스의 개론‡El Compendio de Krasus‡El Compendio de Krasus‡Le compendium de Krasus‡克拉苏斯的魔法纲要‡卡薩斯的手冊',
    nil,
    'Reclame os capítulos 1, 2 e 3 do Compêndio de Krasus na Praça da Cidade da Vila Kirin\'Var.‡Заберите компендиум Краса – глава 1, компендиум Краса – глава 2 и компендиум Краса – глава 3 из района Городской площади деревни Кирин\'Вар.‡Holt Euch Krasus\' Kompendium - Kapitel 1, Krasus\' Kompendium - Kapitel 2 und Krasus\' Kompendium - Kapitel 3 vom Ratsplatz von Kirin\'Var.‡보랏빛 탑의 지하 근처의 키린바르 마을의 광장에서 크라서스의 개론 - 1장, 크라서스의 개론 - 2장, 크라서스의 개론 - 3장을 되찾아야 합니다.‡Recoge el Compendio de Krasus - Capítulo 1, el Compendio de Krasus - Capítulo 2 y el Compendio de Krasus - Capítulo 3 de la plaza del Poblado Kirin\'Var.‡Recoge el Compendio de Krasus - Capítulo 1, el Compendio de Krasus - Capítulo 2 y el Compendio de Krasus - Capítulo 3 de la plaza del Poblado Kirin\'Var.‡Récupérez le Compendium de Krasus - Chapitre 1, le Compendium de Krasus - Chapitre 2 et le Compendium de Krasus - Chapitre 3 sur la Place centrale de Kirin\'Var.‡前往肯瑞瓦村的城镇广场，收集克拉苏斯的魔法纲要 - 第一章，克拉苏斯的魔法纲要 - 第二章和克拉苏斯的魔法纲要 - 第三章。‡從肯瑞瓦村莊的小鎮廣場取回卡薩斯的手冊 - 第一章，卡薩斯的手冊 - 第二章，和卡薩斯的手冊 - 第三章。',
  }
},
[10193] = {
  {
    'Cabeças valiosas‡Высокие цели‡Hochrangige Ziele‡만만찮은 목표물‡Objetivos de gran valor‡Objetivos de gran valor‡Cibles majeures‡有价值的目标‡高重要性的目標',
    nil,
    'O Mestre Espião Thalodien, na Área 52, quer que você vá a Manaforja B\'naar e mate 2 Mestres Dimensionais Solfúria, 6 Engenheiros Dimensionais Solfúria e 8 Geólogos Solfúria.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Патрон шпионов Талодиен, находящийся в Зоне 52, просит вас отправиться в манагорн Б\'наар и убить 2 мастеров пространственных искривлений, 6 инженеров пространственных искривлений и 8 геологов из клана Ярости Солнца.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Spionagemeister Thalodien in Area 52 möchte, dass Ihr in die Manaschmiede B\'naar geht und 2 Warpmeister des Sonnenzorns, 6 Warpingenieure des Sonnenzorns und 8 Geologen des Sonnenzorns tötet.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 첩보단장 탈로디엔이 브나르 마나괴철로로 가서 성난태양 초공간 감독관 2명, 성난태양 초공간 기술자 6명과 성난태양 지질학자 8명을 처치해 달라고 부탁했습니다.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y mates 2 maestros de distorsión Furia del Sol, 6 ingenieros de distorsión Furia del Sol y 8 geólogos Furia del Sol.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡El maestro de espías Thalodien del Área 52 quiere que te dirijas a las afueras de la Forja de Maná B\'naar y mates 2 maestros de distorsión Furia del Sol, 6 ingenieros de distorsión Furia del Sol y 8 geólogos Furia del Sol.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Le maître-espion Thalodien de la Zone 52 veut que vous alliez à la manaforge B\'naar pour y tuer 2 Maîtres-dimensionnels solfurie, 6 Ingénieurs dimensionnels solfurie et 8 Géologues solfurie.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡52区的间谍大师萨罗迪恩要你进入法力熔炉：布纳尔，杀死2名日怒空间主宰、6名日怒迁跃技师和8名日怒地质学家。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡52區的間諜大師薩洛迪恩要你去法力熔爐巴納爾殺掉2個日怒星移管理者，6個日怒星移工程師以及8個日怒地理學家。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10194] = {
  {
    'Voo furtivo‡Незаметный полет‡Heimlicher Flug‡은밀한 비행‡Vuelo sigiloso‡Vuelo sigiloso‡Vol furtif‡隐秘飞行‡隱形飛行',
    nil,
    'Fale com Veronia do lado de fora da Área 52 e voe para Manaforja Coruu.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Поговорите с Веронией, находящейся за пределами Зоны 52, и летите к манагорну Коруу.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Sprecht mit Veronia außerhalb von Area 52 und fliegt zur Manaschmiede Coruu.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 밖에 있는 베로니아와 대화하여 코루 마나괴철로로 날아가십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Habla con Veronia fuera del Área 52 y vuela hasta Forja de Maná Coruu.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Habla con Veronia fuera del Área 52 y vuela hasta Forja de Maná Coruu.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Parlez à Veronia à l\'extérieur de la Zone 52 et volez jusqu\'à la manaforge Coruu.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡与52区外的维罗妮娅谈一谈，她会安排你飞往法力熔炉：库鲁恩。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡與52區外的維納妮雅交談並飛往法力熔爐寇魯。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10195] = {
  {
    '‡Наемник видит, наемник делает‡Söldner sieht, Söldner handelt‡‡Sombrero veo, sombrero quiero‡Sombrero veo, sombrero quiero‡Mercenaire voir, mercenaire faire‡流行时尚‡',
    nil,
    '‡Принесите 30 перьев араккоа Роз\'алете в Бастион Аллерии.‡Bringt 30 Arakkoafedern zu Ros\'eleth in Allerias Feste.‡‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Lleva 30 plumas de arakkoa a Ros\'eleth a Bastión Allerian.‡Apportez 30 Plumes d\'arakkoa à Ros\'eleth au Bastion allérien.‡‡',
  }
},
[10196] = {
  {
    'Mais penas de arakkoa‡Больше перьев араккоа‡Mehr Arakkoafedern‡아라코아 깃털 추가 수집‡Más plumas de arakkoa‡Más plumas de arakkoa‡Plus de plumes d\'arakkoa‡更多鸦人羽毛‡更多的阿拉卡羽毛',
    nil,
    'Traga 30 Penas de Arakkoa para Malkaz, na Vila de Quebrapedra.‡Принесите 30 перьев араккоа Малуказу в форт Камнеломов.‡Bringt 30 Arakkoafedern zu Malukaz in der Steinbrecherfeste.‡돌망치 요새에 있는 말루카즈에게 아라코아 깃털 30개를 가져가야 합니다.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Lleva 30 plumas de arakkoa a Malukaz en el Bastión Rompepedras.‡Apportez 30 Plumes d\'arakkoa à Malukaz au fort des Brise-pierres.‡将30片鸦人的羽毛交给裂石堡的玛鲁卡兹。‡帶30根阿拉卡羽毛給碎石堡的瑪魯卡茲。',
  }
},
[10197] = {
  {
    'Disfarce convincente‡Убедительная маскировка‡Eine überzeugende Verkleidung‡그럴싸한 변장‡Un disfraz convincente‡Un disfraz convincente‡Un déguisement convainquant‡以假乱真‡具說服力的偽裝',
    nil,
    'Obtenha o seguinte conjunto: Vestes de Arcanista Solfúria, um par de Luvas do Pesquisador Solfúria e um Medalhão do Guarda Solfúria e leve-os a Caledis Albafulgis, em Manaforja Coruu, em Eternévoa.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Добудьте комплект одеяний чародея из армии Ярости Солнца, одну пару перчаток ученого из армии Ярости Солнца и медальон охранника из армии Ярости Солнца и принесите все это Каледису Сияющему Рассвету в манагорн Коруу в Пустоверти.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Bringt ein Set Arkanistenroben des Sonnenzorns, ein Paar Forscherhandschuhe des Sonnenzorns und ein Gardistenmedaillon des Sonnenzorns zu Caledis Morgenhell bei der Manaschmiede Coruu im Nethersturm.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 연구원 장갑 한 쌍, 성난태양 보초병 목걸이 1개, 그리고 성난태양 비전술사 로브 한 벌을 입수한 후 황천의 폭풍의 코루 마나괴철로에 있는 캘디스 브라이트돈에게 가져가야 합니다.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Consigue las togas de arcanista Furia del Sol, un par de guantes de investigador Furia del Sol y un medallón de custodio Furia del Sol y entrégaselos a Caledis Alba Brillante, en Forja de Maná Coruu de Tormenta Abisal.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Consigue las togas de arcanista Furia del Sol, un par de guantes de investigador Furia del Sol y un medallón de custodio Furia del Sol y entrégaselos a Caledis Alba Brillante, en Forja de Maná Coruu de Tormenta Abisal.|n|nCompletar misiones para los Arúspices hará que disminuya tu reputación con los Aldor.‡Procurez-vous une Robe d\'arcaniste solfurie, une paire de Gants de chercheur solfurie et un Médaillon de garde solfurie et apportez-les à Caledis Brillaube à la manaforge Coruu au Raz-de-Néant.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡收集一件日怒奥术师长袍、一副日怒研究员手套和一枚日怒卫士勋章，然后返回虚空风暴的法力熔炉：库鲁恩，将它们交给卡勒迪斯·晨光。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡取得1套日怒秘法師長袍，1雙日怒調查員手套和1個日怒守衛勳章，完成後將這些帶回虛空風暴的法力熔爐寇魯給卡利迪斯·明曦。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10198] = {
  {
    'Conseguindo informações‡Сбор информации‡Informationen sammeln‡정보 수집‡Reuniendo pistas‡Reuniendo pistas‡Rassembler des informations‡收集情报‡收集資訊',
    nil,
    'Vista o Disfarce Solfúria, entre na Manaforja Coruu e escute a conversa entre o Comandante Albaforja e o Arcanista Ardonis, e então relate a Caledis Albafulgis na Manaforja Coruu depois de concluir a tarefa.|n|nAo cumprir missões para os Áugures, sua reputação entre os Aldor será reduzida.‡Используя маскировку клана Ярости Солнца, проникните в Манагорн Коруу и подслушайте разговор между командиром Кузней Солнца и чародеем Ардонисом. По завершении задачи доложите о результатах Каледису Сияющему Рассвету. |n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Benutzt die Sonnenzornverkleidung, geht in die Manaschmiede Coruu und belauscht das Gespräch zwischen Sonnenzornkommandant Morgenschmied und Arkanist Ardonis. Meldet Euch bei Caledis Morgenhell in der Manaschmiede Coruu, wenn Ihr die Aufgabe abgeschlossen habt.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 위장을 사용하여 코루 마나괴철로 안으로 들어가서 사령관 돈포지와 비전술사 아르도니스가 주고받는 대화를 들어야 합니다. 임무를 완수한 후 코루 마나괴철로에 있는 캘디스 브라이트돈에게 돌아가서 보고하십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Use el disfraz de Furia del Sol, ve a la Forja de Maná Coruu y escucha la conversación entre el comandante Forjalba y el arcanista Ardonis. Informa de todo a Caledis Alba Brillante en la Forja de Maná Coruu después de completar esta tarea.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación Aldor.‡Use el disfraz de Furia del Sol, ve a la Forja de Maná Coruu y escucha la conversación entre el comandante Forjalba y el arcanista Ardonis. Informa de todo a Caledis Alba Brillante en la Forja de Maná Coruu después de completar esta tarea.|n|nA medida que completas tareas para los Arúspices disminuye tu nivel de reputación Aldor.‡Utilisez le déguisement de Solfurie pour vous rendre à la Manaforge Coruu et écouter la conversation entre le Commandant Forgelaube et l\'Arcaniste Ardonis. Faites votre rapport à Caledis Brillaube à la Manaforge Coruu lorsque vous aurez accompli cette tâche.|n|nAccomplir des tâches pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡利用日怒伪装包进入法力熔炉：库鲁恩，偷听指挥官纳萨托·晨铸和奥术师阿尔杜尼斯的谈话。完成任务后向法力熔炉：库鲁恩的卡勒迪斯·晨光复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡使用日怒偽裝，進入法力熔爐寇魯聽取指揮官曦鑄與秘法師艾登尼斯的對話。完成任務後回報給法力熔爐寇魯外頭的卡利迪斯·明曦。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10199] = {
  {
    'Um gás extra‡Дополнительная сила‡Der kleine Extrakick‡약간의 기폭제‡Ese pequeño toque extra‡Ese pequeño toque extra‡Un petit coup de fouet‡一点添加剂‡一點額外的刺激',
    nil,
    'Obtenha cinco Aguilhões de Arraia Etérea para o Botas, na Área 52, em Eternévoa.‡Принесите 5 шипов скатов Пустоты Бутсу, находящемуся в Зоне 52 в Пустоверти.‡Besorgt 5 Netherrochenstachel und bringt sie zu Stiefels in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 부츠를 위해 황천의 가오리 독침 5개를 입수해야 합니다.‡Consigue 5 aguijones de rayas abisales para Botas en el Área 52 de Tormenta Abisal.‡Consigue 5 aguijones de rayas abisales para Botas en el Área 52 de Tormenta Abisal.‡Procurez-vous 5 Aiguillons de raie du Néant pour Bottes dans la Zone 52 du Raz-de-Néant.‡将5根虚空鳐的钉刺交给虚空风暴52区的布兹。‡替虛空風暴裡52區的布茲帶來5個虛空鰭刺。',
  }
},
[10200] = {
  {
    'Apresente-se novamente a Thalodien‡Возвращение к Талодиену‡Rückkehr zu Thalodien‡탈로디엔에게 돌아가기‡Regresa junto a Thalodien‡Regresa junto a Thalodien‡Retourner voir Thalodien‡返回萨罗迪恩身边‡回去找薩洛迪恩',
    nil,
    'Fale com o Mestre Espião Thalodien, na Área 52, em Eternévoa.‡Вернитесь к патрону шпионов Талодиену в Зону 52 в Пустоверти.‡Kehrt zu Spionagemeister Thalodien in Area 52 im Nethersturm zurück.‡황천의 폭풍에서 52번 구역에 있는 첩보단장 탈로디엔에게 돌아가십시오.‡Ve a ver al maestro de espías Thalodien en el Área 52, en la Tormenta Abisal.‡Ve a ver al maestro de espías Thalodien en el Área 52, en la Tormenta Abisal.‡Retournez voir le maître-espion Thalodien dans la Zone 52 du Raz-de-Néant.‡返回虚空风暴的52区，向间谍大师萨罗迪恩复命。‡到虛空風暴的52區找間諜大師薩洛迪恩。',
  }
},
[10201] = {
  {
    'E agora, a hora da verdade‡Момент истины‡Der Moment der Wahrheit‡마침내 찾아온 진실의 시간‡Y ahora, el momento de la verdad‡Y ahora, el momento de la verdad‡Et maintenant, l\'instant de vérité‡真相大白‡現在，真相的時刻',
    nil,
    'Ache Grek e peça para testar o lubrificante para armas. Após ele testar o óleo, informe os resultados a Rakoria.‡Найдите Грека и попросите его смазать маслом свое оружие, после чего вернитесь к Ракории.‡Geht zu Grek und bittet ihn, das Öl an seiner Waffe auszuprobieren. Bringt das Ergebnis zu Rakoria, wenn er fertig ist.‡그렉을 만나서 기름을 시험 삼아 무기에 사용해 달라고 부탁해야 합니다. 그가 기름을 시험하고 나면 그 결과를 라코리아에게 보고하십시오.‡Encuentra a Grek y pídele que pruebe el aceite en su arma. Cuando lo haya hecho, vuelve a ver a Rakoria con los resultados.‡Encuentra a Grek y pídele que pruebe el aceite en su arma. Cuando lo haya hecho, vuelve a ver a Rakoria con los resultados.‡Trouvez Grek et demandez-lui d\'essayer l\'huile sur son arme. Une fois qu\'il l\'aura testée, retournez décrire le résultat à Rakoria.‡找到葛雷克，让他用枪试试油的品质。试验完成之后，向拉克妮亚报告结果。‡找到葛利克並要他將東西試用在他的武器上。一旦他測試過這個油後，回去向瑞蔻莉雅報告結果。',
  }
},
[10202] = {
  {
    'O desertor‡Дезертир‡Ein Abtrünniger‡배신자‡Un desertor‡Un desertor‡Un déserteur‡叛徒‡背叛者',
    nil,
    'Vá à Manaforja Ara e fale com o Magíster Theledorn.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Отправляйтесь в манагорн Ара и поговорите с магистром Теледорном. |n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Geht zur Manaschmiede Ara und sprecht mit Magister Theledorn.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡아라 마나괴철로로 가서 마법학자 텔레도른과 대화하십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Ara y habla con el magister Theledorn.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Ve a la Forja de Maná Ara y habla con el magister Theledorn.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Allez à la manaforge Ara et parlez au magistère Theledorn.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡前往法力熔炉：艾拉，与魔导师塞雷杜恩谈一谈。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡到法力熔爐艾拉去與博學者瑟勒朵恩談談。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10203] = {
  {
    'Bugiganga fulminadora inestimável‡Захват бесценного оборудования‡Unschätzbare Ausrüstung beamen‡귀중한 자산 변환‡El ultra-desconsolidador es muy útil‡El ultra-desconsolidador es muy útil‡Zapper des atouts inestimables‡价值连城的设备‡傳送無價的資產',
    nil,
    'Use o Fulminador Ultradesconsolidador para transportar o Cava-cava Hiper-rotacional, a Garra de Sucção Servopneumática, o Analisador de Terreno Multispectro, e o vagão cheio de explosivos de volta à Área 52. Em seguida, apresente-se ao Sapador Líder Isscabum na extremidade leste da fissura que corta a Área 52, em Eternévoa.‡Используйте ультра-разуплотняющий захват, чтобы доставить гиперротационный Рой-О-Мат, сервоприводную пневматическую землечерпалку, радужный световой анализатор грунта и большой фургон с взрывчаткой обратно в Зону 52. Затем сообщите старшему саперу Бджимбуму, находящемуся на восточном конце расселины, идущей через Зону 52 в Пустоверти.‡Benutzt den ultrastarken Dekonsolidierungsstrahler, um den Hyperdreh-Grab-o-Matik, die servopneumatische Baggerklaue, den multispektralen Geländeabtaster und den großen Wagen voller Sprengstoff zurück nach Area 52 zu beamen. Meldet Euch dann beim leitenden Ingenieur Zischeldruck beim östlichen Ende des Risses in Area 52 im Nethersturm.‡초입자 해체 송신기를 사용하여 초고속회전 자동굴착기, 공기압축식 준설기, 다분광 지형 분석기, 폭약이 가득 실린 대형 짐마차를 52번 구역에 전해 주어야 합니다. 그런 후에 황천의 폭풍의 52번 구역을 가로지르는 균열의 동쪽 끝에 있는 선임공병 블라스트피즐에게 보고하십시오.‡Utiliza el transportador ultra-desconsolidador para enviar al Área 52 la excavamática hiperrotacional, el cangilón de arrastre servoneumático, el analizador de terreno multiespectro y el vagón grande lleno de explosivos. A continuación preséntate ante el jefe de zapadores Estampido en la fisura del Área 52 en la Tormenta Abisal.‡Utiliza el transportador ultra-desconsolidador para enviar al Área 52 la excavamática hiperrotacional, el cangilón de arrastre servoneumático, el analizador de terreno multiespectro y el vagón grande lleno de explosivos. A continuación preséntate ante el jefe de zapadores Estampido en la fisura del Área 52 en la Tormenta Abisal.‡Utilisez le Zappeur d\'ultra-déconsolidation pour renvoyer le Creus-O-Matic ultra-rotatif, la Griffe de drague servopneumatique, l\'Analyseur de terrain multispectral et le Gros chariot rempli d\'explosifs dans la Zone 52 au Raz-de-Néant. Présentez-vous ensuite au Sapeur en chef Failonfeu à l\'extrémité est de la fissure qui parcourt la Zone 52 au Raz-de-Néant.‡利用超级拆解器将高转速挖掘器、机械气压挖掘爪、多光谱地形扫描仪和一大车炸药带回52区。然后向虚空风暴52区裂隙东端的首席工兵布拉斯特菲兹报到。‡使用超強化傳送搖控器將多旋轉挖掘機、伺服氣動挖泥器、多光譜地形分析器以及裝滿爆裂物的大型貨車傳送回52區。完成後向位於虛空風暴內的52區中裂縫東邊盡頭的工兵領班布拉斯特費索回報。',
  }
},
[10204] = {
  {
    'Cristais gema de sangue‡Кристаллы камня Крови‡Blutjuwelenkristalle‡혈석 수정‡Cristales de gema de sangre‡Cristales de gema de sangre‡Cristaux de gemmes de sang‡血宝石‡血寶石水晶',
    nil,
    'A Magistra Larynna quer que você vá a Manaforja B\'naar e obtenha um Estilhaço de Gema de Sangue de um Magíster Solfúria. Use o estilhaço perto de Cristais Gema de Sangue maiores e, em seguida, leve-o para Larynna, na Área 52.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Магистр Ларинна просит вас отправиться в манагорн Б\'наар и отобрать осколок камня крови у магистра из клана Ярости Солнца. Используйте этот осколок поблизости от более крупного кристалла камня крови и возвращайтесь к Ларинне в Зону 52.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Magistrix Larynna möchte, dass Ihr zur Manaschmiede B\'naar geht und einen Blutjuwelensplitter von einem Magister des Sonnenzorns besorgt. Benutzt den Splitter in der Nähe von größeren Blutjuwelenkristallen und kehrt zu ihr in Area 52 zurück.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡52번 구역에 있는 마법학자 라린나가 브나르 마나괴철로에 가서 성난태양 마법학자에게서 혈석 조각을 얻어 큰 혈석 수정 주변에서 사용한 후에 돌아와 달라고 부탁했습니다.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡La magistrix Larynna quiere que vayas a la Forja de Maná B\'naar y obtengas un fragmento de gema de sangre de un magister Furia del Sol. Utiliza el fragmento cerca de los cristales grandes de gema de sangre y ve a verla en el Área 52.|n|nCompletar misiones para los Arúspices hará que tu nivel de reputación con los Aldor disminuya.‡La magistrix Larynna quiere que vayas a la Forja de Maná B\'naar y obtengas un fragmento de gema de sangre de un magister Furia del Sol. Utiliza el fragmento cerca de los cristales grandes de gema de sangre y ve a verla en el Área 52.|n|nCompletar misiones para los Arúspices hará que tu nivel de reputación con los Aldor disminuya.‡La magistrice Larynna veut que vous alliez à la manaforge B\'naar pour vous y procurer un Éclat de gemme de sang sur un Magistère solfurie. Utilisez-le près des grands Cristaux de gemme de sang et retournez la voir dans la Zone 52.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡魔导师拉恩娜要你进入法力熔炉：布纳尔，从日怒魔导师手中夺得血宝石碎片。在较大的血宝石水晶附近使用这块碎片，然后返回52区向她复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡博學者萊莉娜要你去法力熔爐巴納爾從日怒博學者那取得一個血寶石裂片。在一個更大的血寶石水晶附近使用這個裂片，並帶回52區給她。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10205] = {
  {
    'Saqueador Dimensional Nesaad‡Астральный налетчик Несаад‡Sphärenräuber Nesaad‡초공간 약탈자 네사드‡Asaltante de distorsión Nesaad‡Asaltante de distorsión Nesaad‡L\'écumeur-dimensionnel Nesaad‡星界强盗奈萨德‡星移劫掠者尼薩德',
    nil,
    'Mate o Saqueador Dimensional Nesaad e fale novamente com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Убейте астрального налетчика Несаада, затем возвращайтесь к ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Tötet Sphärenräuber Nesaad und kehrt dann zu Netherpirscher Khay\'ji in Area 52 im Nethersturm zurück.‡초공간 약탈자 네사드를 처치한 후에 황천의 폭풍의 52번 구역에 있는 황천추적자 케이지에게 돌아가야 합니다.‡Mata al asaltante de distorsión Nesaad y ve a ver al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Mata al asaltante de distorsión Nesaad y ve a ver al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Tuez l\'Écumeur-dimensionnel Nesaad, puis retournez voir le traqueur-du-Néant Khay\'ji dans la Zone 52 de Raz-de-Néant.‡杀死星界强盗奈萨德，然后返回虚空风暴52区，向虚空猎手卡尔伊复命。‡殺掉星移劫掠者尼薩德，完成後回到虛空風暴的52區找虛空巡者凱澤。',
  }
},
[10206] = {
  {
    'Pega o que é teu‡В погоне за технологиями‡Wählt Eure Rolle‡부품 수집‡Tú eliges‡Tú eliges‡Prendre sa part‡偷来偷去‡挑選你的職責',
    nil,
    'Colete 10 Peças de Tecnologia Etérea e leve-as a Papai Macário, na Área 52, em Eternévoa.‡Соберите 10 астральных технологий и вернитесь с ними к Папаше Колесуну, находящемуся в Зоне 52 в Пустоверти.‡Sammelt 10 Stück Astraltechnologie und bringt sie zu Papa Mauschel in Area 52 im Nethersturm.‡에테리얼 기술 부품 10개를 수집한 후에 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 돌려주어야 합니다.‡Reúne 10 artilugios de tecnología etérea y llévaselos a Papá Ruedas en el Área 52, en la Tormenta Abisal.‡Reúne 10 artilugios de tecnología etérea y llévaselos a Papá Ruedas en el Área 52, en la Tormenta Abisal.‡Récupérez 10 modèles de Technologie éthérienne et rapportez-les à Papa Roulette, dans la Zone 52 au Raz-de-Néant.‡收集10件虚灵科技的产品碎片，将它们交给虚空风暴52区的维勒老爹。‡收集10片以太族技術後回到虛空風暴的52區找威勒老爹。',
  }
},
[10207] = {
  {
    '‡Передовая застава: Гибель Сквернобота REUSE‡Vorposten: Häschersturz‡‡Forward Base: Reaver\'s Fall REUSE‡Forward Base: Reaver\'s Fall REUSE‡Poste avancé: Trépas du saccageur - REUSE‡前线基地:劫夺者荒野 重新启用‡',
    nil,
    '‡Доложитесь командиру передовой То\'арху в Погибели Сквернобота.‡Meldet Euch bei Vorpostenkommandant To\'arch im Häschersturz.‡지옥절단기 함락지에 있는 전방사령관 토아크에게 보고해야 합니다.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Preséntate ante el comandante de vanguardia To\'arch en la Caída del Atracador Vil.‡Présentez-vous au commandant des lignes avancées To\'arch au Trépas du saccageur.‡前往机甲残骸，向前线指挥官托尔克报到。‡',
  }
},
[10208] = {
  {
    'Interrompa os reforços‡Лишить Легион подкрепления!‡Die Verstärkung abschneiden‡지원 병력 차단‡Perturbar sus refuerzos‡Perturbar sus refuerzos‡Perturber leurs renforts‡阻断援军‡阻斷他們的援軍',
    nil,
    'Derrote os inimigos perto dos Portais Xilus e Kruul para coletar 4 Pedras Rúnicas Demoníacas para cada portal.|n|nUse o Detonador de To\'acha nos Portais Xilus e Kruul.|n|nLeve os detonadores que sobrarem de volta para To\'acha no Posto dos Destroços na Península Fogo do Inferno.‡Уничтожьте врагов вокруг портала Зилус и портала Круул, соберите камни с рунами демонов.|n|nИспользуйте запалы То\'арха внутри порталов Зилус и Круул.|n|nВозвращайтесь к То\'арху в Гибель Сквернобота на полуострове Адского Пламени вместе с оставшимися запалами.‡Besiegt die Feinde um Portal Xilus und Portal Kruul herum, um dämonische Runensteine zu sammeln.|n|nBenutzt To\'archs Zünder in Portal Xilus und Portal Kruul.|n|nKehrt danach mit To\'archs Zünder zu To\'arch im Häschersturz auf der Höllenfeuerhalbinsel zurück.‡자일러스 차원문과 크룰 차원문 주변에 있는 적들을 물리친 다음 악마의 룬을 수집해야 합니다.|n|n자일러스 차원문과 크룰 차원문 안에서 토아크의 뇌관을 사용해야 합니다.|n|n토아크의 뇌관을 가지고 지옥불 반도의 지옥절단기 함락지에 있는 토아크에게 돌아가십시오.‡Derrota a enemigos alrededor del Portal Xilus y del Portal Kruul para recolectar piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de To\'arch del Portal Xilus y del Portal Kruul.|n|nRegresa junto a To\'arch con los cebos de To\'arch en la Caída del Atracador Vil, en la Península del Fuego Infernal.‡Derrota a enemigos alrededor del Portal Xilus y del Portal Kruul para recolectar piedras rúnicas demoníacas.|n|nUsa el cebo explosivo de To\'arch del Portal Xilus y del Portal Kruul.|n|nRegresa junto a To\'arch con los cebos de To\'arch en la Caída del Atracador Vil, en la Península del Fuego Infernal.‡Terrassez les ennemis qui se trouvent autour des portails Xilus et Kruul pour rassembler des Pierres runiques démoniaques.|n|nUtilisez une Amorce de To\'arch à l\'intérieur des portails Xilus et Kruul.|n|nRapportez les Amorces restantes à To\'arch au Trépas du saccageur dans la péninsule des Flammes infernales.‡消灭希鲁斯传送门和科卢尔传送门附近的敌人，收集它们身上的恶魔符文石。|n|n然后在希鲁斯传送门和科卢尔传送门内使用托尔克的雷管。|n|n完成任务后，将剩余的炸药还给地狱火半岛机甲残骸处的托尔克。‡打倒塞勒斯傳送門和卡魯歐傳送門附近的敵人以便收集惡魔符文石。|n|n在塞勒斯傳送門還有卡魯歐傳送門內使用吐阿奇的雷管。|n|n完成後帶著吐阿奇的雷管回到地獄火半島的劫奪者荒野找吐阿奇。',
  }
},
[10209] = {
  {
    'O prêmio do evocador Kanthin‡Трофей призывателя Кантина‡Beschwörer Kanthins Preis‡소환사 칸딘의 전리품‡El premio del invocador Kanthin‡El premio del invocador Kanthin‡Le trophée de l\'invocateur Kanthin‡召唤者坎西恩的战利品‡召喚者坎辛的禮物',
    nil,
    'Derrote o Evocador Kanthin na Manaforja Dúria, na ilha ao norte do Acampamento Solfúria, para recuperar a Pedra de Glacius.‡Победите призывателя Кантина, находящегося в Манагорне Даро, на острове к северу от Форта Ярости Солнца, и заберите у него камень Студенора.‡Besiegt Beschwörer Kanthin in der Manaschmiede Duro auf der Insel nördlich des Sonnenzornpostens und holt den Stein des Gletscharius zurück.‡성난태양 주둔지의 북쪽 섬에 있는 듀로 마나괴철로에서 소환사 칸딘을 처치하고 글라시우스의 돌을 되찾아야 합니다.‡Derrota al invocador Kanthin en la Forja de Maná Duro, en la isla que está al norte del Bastión Furia del Sol y reclama la Piedra de Glacius.‡Derrota al invocador Kanthin en la Forja de Maná Duro, en la isla que está al norte del Bastión Furia del Sol y reclama la Piedra de Glacius.‡Triomphez de l\'invocateur Kanthin à la manaforge Duro, sur l\'île au nord du bastion des Solfurie, et reprenez-lui la Pierre de Glacius.‡前往位于日怒堡北部岛屿的法力熔炉：杜隆，从召唤者坎西恩手中夺回格拉修斯之石。‡到日怒要塞的北方小島上，打倒法力熔爐杜羅的召喚者坎辛，並從他手中將葛拉希厄斯之石拿回來。',
  }
},
[10210] = {
  {
    'A\'dal‡А\'дал‡A\'dal‡아달‡A\'dal‡A\'dal‡A\'dal‡阿达尔‡阿達歐',
    nil,
    'Fale com A\'dal, líder dos Sha\'tar, no centro do Terraço da Luz.‡Поговорите с А\'далом, предводителем Ша\'тар, в центре террасы Света.‡Sprecht mit A\'dal, Anführer der Sha\'tar in der Mitte der Terrasse des Lichts.‡빛의 정원의 중앙에서 샤타르의 지도자인 아달과 대화하십시오.‡Habla con A\'dal, el jefe de los Sha\'tar, en el centro del Bancal de la Luz.‡Habla con A\'dal, el jefe de los Sha\'tar, en el centro del Bancal de la Luz.‡Parlez à A\'dal, le chef des Sha\'tar, au centre de la Terrasse de la Lumière.‡与沙塔尔的领袖阿达尔谈一谈，他就在圣光广场的中央。‡與聖光露臺中央的薩塔領導者，阿達歐談談。',
  }
},
[10211] = {
  {
    'Cidade da Luz‡Город Света‡Stadt des Lichts‡빛의 도시‡La Ciudad de la Luz‡La Ciudad de la Luz‡Ville de Lumière‡圣光之城‡聖光之城',
    nil,
    'Siga o servo de Hadggar e escute sua história. Fale novamente com Hadggar após completar essa tarefa.‡Проследуйте за слугой Кадгара и выслушайте историю, которую он вам расскажет, после чего вернитесь к Кадгару.‡Folgt Khadgars Diener und hört Euch an, was er zu erzählen hat. Kehrt nach dieser Aufgabe zu Khadgar zurück.‡카드가의 하수인을 따라가면서 이야기를 들어야 합니다. 끝나면 카드가에게 돌아가십시오.‡Sigue al sirviente de Khadgar y escucha la historia de la ciudad. Luego ve a ver a Khadgar.‡Sigue al sirviente de Khadgar y escucha la historia de la ciudad. Luego ve a ver a Khadgar.‡Suivez le serviteur de Khadgar et écoutez son histoire. Retournez ensuite voir Khadgar.‡跟随卡德加的仆从游览城市并聆听这里的历史故事。完成任务后回去向卡德加复命。‡跟著卡德加的僕人並聽他說故事。完成任務後回去找卡德加。',
  }
},
[10212] = {
  {
    'Hero of the Mag\'har‡Герой маг\'харов‡Held der Mag\'har‡마그하르의 영웅‡Héroe Mag\'har‡Héroe Mag\'har‡Héros des Mag\'har‡玛格汉的英雄‡瑪格哈的英雄',
    nil,
    'Fale novamente com a Grande Mãe Geyah na cidade de Garadar, em Nagrand.|n‡Вернитесь к великой матери Гейе в Гарадар в Награнде.‡Kehrt zu Großmutter Geyah in Garadar in Nagrand zurück.‡나그란드에 있는 대모 게야에게 돌아가십시오.‡Ve a ver a Abuela Geyah a Garadar en Nagrand.|n‡Ve a ver a Abuela Geyah a Garadar en Nagrand.|n‡Retournez voir la grande-mère Geyah à Garadar en Nagrand.‡向纳格兰加拉达尔的盖亚安祖母复命。‡回到納葛蘭的卡拉達爾找主母吉雅。',
  }
},
[10213] = {
  {
    'Investigue a queda‡Найти место крушения‡Untersuchung der Absturzstelle‡추락 사건 조사‡Investigar el accidente‡Investigar el accidente‡Enquêter au sujet de l\'accident‡调查坠毁点‡調查這場空難',
    nil,
    'Busque sobreviventes da queda.‡Отыщите уцелевших в катастрофе.‡Durchsucht die Absturzstelle nach Überlebenden.‡추락 사건의 생존자들을 찾아야 합니다.‡Busca supervivientes en el lugar del accidente.‡Busca supervivientes en el lugar del accidente.‡Cherchez des survivants de l\'accident.‡寻找飞艇坠毁事故的幸存者。‡搜尋空難倖存者。',
  }
},
[10214] = {
  {
    'Balança mas não cai‡Весь рудник ходуном‡Bringt diese Mine zum beben!‡광산의 소동‡Esta mina es un caos‡Esta mina es un caos‡Mineur, tu dors, ton wagon va trop vite‡乱糟糟的矿洞‡礦場的騷動',
    nil,
    'Mate 15 Sapadores Gan\'args e fale novamente com o Capataz Razelcraz.‡Убейте 15 ган\'аргов-саперов и возвращайтесь к штейгеру Разлкразу.‡Tötet 15 Pioniere der Gan\'arg und kehrt dann zu Großknecht Razelcraz zurück.‡간아그 공병 15명을 처치한 다음 현장감독 라젤크라즈에게 돌아가야 합니다.‡Mata 15 zapadores Gan\'arg y ve a ver al supervisor Razelcraz.‡Mata 15 zapadores Gan\'arg y ve a ver al supervisor Razelcraz.‡Tuez 15 Sapeurs gan\'arg et retournez voir le contremaître Razelcraz.‡杀死15个甘尔葛工兵，然后向工头拉泽克拉兹复命。‡殺掉15個甘納格工人，完成後回報工頭瑞絲坎茲。',
  }
},
[10216] = {
  {
    'Segurança acima de tudo‡Прежде всего - безопасность!‡Sicherheit geht vor‡안전 제일‡La seguridad es prioritaria‡La seguridad es prioritaria‡La sécurité avant tout‡安全第一‡安全至上',
    nil,
    'O Artífice Morfílius quer que você mate 10 Saqueadores Etéreos da Cripta, 5 Feiticeiros Etéreos, 5 Espreitadores do Nexus e 5 Mesmerizadores Etéreos.|n|nFeito isso, encontre e ative o Transportador Etéreo na câmara antes dos aposentos de Shaffar.‡Убейте 10 эфириалов – осквернителей гробниц, 5 эфириалов-колдунов, 5 ловчих нексуса и 5 эфириалов-чароплетов по просьбе работника Морфалиуса.|n|nПосле этого найдите эфириальский телепорт в зале, предшествующем палате Шаффара, и активируйте его.‡Konstrukteur Morphalius möchte, dass Ihr 10 astrale Grufträuber, 5 astrale Zauberer, 5 Nexuswandler und 5 astrale Zauberbinder tötet.|n|nWenn Ihr damit fertig seid, sucht den astralen Transporter in der Kammer vor Shaffars Kammern und aktiviert ihn.‡기술병 몰팔리우스가 에테리얼 납골당 침입자 10명, 연합 추적자 5명, 에테리얼 마술사 5명, 에테리얼 역술사 5명을 해치워 달라고 부탁했습니다.|n|n일이 끝나면 샤파르의 방 앞에 있는 방에서 에테리얼 순간이동기를 찾으십시오.‡El artificiero Morphalius quiere que mates 10 asaltantes de tumbas etéreos, 5 brujas etéreas, 5 acechadores nexo y 5 vinculahechizos etéreos.|n|nCuando lo hayas conseguido, encuentra el transportador etéreo en la cámara anterior a la de Shaffar y actívalo.‡El artificiero Morphalius quiere que mates 10 asaltantes de tumbas etéreos, 5 brujas etéreas, 5 acechadores nexo y 5 vinculahechizos etéreos.|n|nCuando lo hayas conseguido, encuentra el transportador etéreo en la cámara anterior a la de Shaffar y actívalo.‡L\'artificier Morphalius veut que vous alliez tuer 10 Écumeurs de crypte éthériens, 5 Ensorceleurs éthériens, 5 Traqueurs de nexus et 5 Lieurs de sort éthériens.|n|nLorsque ce sera fait, trouvez le Transporteur éthérien dans la salle avant celle de Shaffar et activez-le.‡工匠莫法鲁斯要你杀死10个虚灵盗墓者、5个虚灵巫师、5个节点潜行者和5个虚灵缚法者。|n|n全部搞定之后，激活沙法尔房间的前一个房间中的虚灵传送器。‡工匠莫法利厄司要你去殺掉10個以太盜墓者，5個以太巫士，5個奈薩斯潛獵者及5個以太縛法者。|n|n一旦完成後，找到在薩法爾之前一個房間的以太傳送器並啟動它。',
  }
},
[10218] = {
  {
    'O trabalho duro de outrem compensa‡Someone Else\'s Hard Work Pays Off‡Jemandes Arbeit zahlt sich aus‡고진감래‡El trabajo duro de alguien más nos beneficia‡El trabajo duro de alguien más nos beneficia‡Le dur labeur des autres‡别人的烂摊子‡解決別人的難事',
    nil,
    'Escolte o Crio-engenheiro Sha\'heen em segurança pelas Tumbas de Mana para que ele possa extrair o éter contido nos coletores de éter de Shaffar.|n|nApresente-se ao Príncipe do Nexus Haramad, do lado de fora das Tumbas de Mana no acampamento do Consórcio caso você tenha sucesso.‡Проводите криоинженера Ша\'хина в Гробницы маны, чтобы он мог собрать астральную субстанцию в коллекторах Шаффара.|n|nВ случае успеха явитесь к принцу нексуса Харамаду в лагере Консорциума.‡Begleitet Kryoingenieur Sha\'heen sicher durch die Managruft, damit er die Astralmaterie aus Shaffars Astralsammlern entnehmen kann.|n|nMeldet Euch bei Nexusprinz Haramad außerhalb der Managruft beim Lager des Konsortiums, wenn Ihr erfolgreich wart.‡극저온 기술자 샤힌이 샤파르의 황천 수집 장치 속에 있는 에테르를 수집할 수 있도록 마나 무덤까지 무사히 데려다 주어야 합니다.|n|n임무에 성공하면 마나 무덤 바깥에 있는 무역연합 야영지의 연합왕자 하라매드에게 가서 보고하십시오.‡Escolta al crioingeniero Sha\'heen a través de las Tumbas de Maná para que pueda recoger el éter que está dentro de los recolectores de Shaffar.|n|nPreséntate ante el príncipe-nexo Haramad en las Tumbas de Maná, en el campamento del Consorcio si tienes éxito.‡Escolta al crioingeniero Sha\'heen a través de las Tumbas de Maná para que pueda recoger el éter que está dentro de los recolectores de Shaffar.|n|nPreséntate ante el príncipe-nexo Haramad en las Tumbas de Maná, en el campamento del Consorcio si tienes éxito.‡Escortez le cryo-ingénieur Sha\'heen dans les tombes-mana pour qu\'il puisse recueillir l\'éther contenu dans les collecteurs d\'éther de Shaffar.|n|nAllez voir le prince-nexus Haramad au campement du Consortium à l\'extérieur des tombes-mana une fois votre mission accomplie.‡护送低温工程师沙赫恩穿过法力陵墓，在他从沙法尔的灵体收集器中收集灵体能量时保护他。|n|n完成任务后向节点亲王哈拉迈德复命，他就在星界财团设立在法力陵墓外的营地中。‡護送工程師薩希恩安全的穿越法力墓地讓他可以拾取那些薩法爾的精華收集器內的精華。|n|n完成後回到法力墓地外的聯合團紮營地找奈薩斯王子哈拉瑪德回報。',
  }
},
[10219] = {
  {
    '‡Выгул собаки‡Gassi gehen‡‡Pasear al perro‡Pasear al perro‡Sortir le chien‡遛狗‡',
    nil,
    nil,
  }
},
[10220] = {
  {
    'Faça com que nos escutem‡Заставь их слушать‡Bringt sie zum Zuhören‡설득‡Oblígales a escuchar‡Oblígales a escuchar‡Les forcer à écouter‡聆听之魂‡讓他們聽話',
    nil,
    'Mordiba quer que você derrote 12 Soldados Rasos Obstinados, 8 Cavaleiros Obstinados e 6 Feiticeiros Obstinados no Arsenal da Expedição, a oeste do Acampamento Quebra-espinha.‡Убейте 12 непреклонных пехотинцев, 8 непреклонных рыцарей и 6 непреклонных колдунов в оружейной экспедиции к западу от заставы Хребтолома по просьбе Мордибы.‡Mordiba möchte, dass Ihr 12 unerschütterliche Fußsoldaten, 8 unerschütterliche Krieger und 6 unerschütterliche Zauberhexer beim Expeditionsrüstlager westlich des Rückenbrecherpostens tötet.‡몰디바가 해골망치 초소의 서쪽에 있는 원정대 무기고의 불굴의 보병 12명, 불굴의 기사 8명, 불굴의 마술사 6명을 해치워 달라고 부탁했습니다.‡Mordiba quiere que derrotes a 12 lacayos Implacables, 8 caballeros Implacables y 6 hechiceros Implacables en la Armería de Expedición, al oeste de la Avanzada Rompeloma.‡Mordiba quiere que derrotes a 12 lacayos Implacables, 8 caballeros Implacables y 6 hechiceros Implacables en la Armería de Expedición, al oeste de la Avanzada Rompeloma.‡Mordiba veut que vous vainquiez 12 Fantassins inflexibles, 8 Chevaliers inflexibles et 6 Ensorceleurs inflexibles à l\'Armurerie de l\'expédition à l\'ouest du Poste de Brise-échine.‡莫迪巴要求你前往断背岗哨以西的远征军物资库，击败12个步兵的阴魂、8个骑士的阴魂和6个巫师的阴魂。‡莫爾迪巴要你去斷脊氏族崗哨西方的遠征隊軍械庫殺掉12個不屈的士兵，8個不屈的騎士，以及6個不屈的魔巫士。',
  }
},
[10221] = {
  {
    'Dr. Cabum!‡Доктор Бум!‡Dr. Bumm!‡붐 박사!‡¡Dr. Bum!‡¡Dr. Bum!‡Dr Boum !‡砰砰博士！‡布姆博士!',
    nil,
    'Mate o Dr. Cabum e leve a boa notícia para o Líder Sapador Isscabum, na Área 52, em Eternévoa.‡Убейте Доктора Бума и возвращайтесь с хорошими новостями к старшему саперу Бджимбуму в Зону 52 в Пустоверти.‡Tötet Dr. Bumm und kehrt dann mit den guten Nachrichten zu dem leitenden Ingenieur Zischeldruck in Area 52 im Nethersturm zurück.‡붐 박사를 처치한 후에 좋은 소식을 가지고 황천의 폭풍의 52번 구역에 있는 선임공병 블라스트피즐에게 돌아가야 합니다.‡Mata al Dr. Bum y ve a darle la buena noticia al jefe de zapadores Estampido al Área 52 en Tormenta Abisal.‡Mata al Dr. Bum y ve a darle la buena noticia al jefe de zapadores Estampido al Área 52 en Tormenta Abisal.‡Tuez Dr Boum puis rapportez la bonne nouvelle au sapeur en chef Failonfeu dans la Zone 52 au Raz-de-Néant.‡杀死砰砰博士，然后将胜利的消息汇报给虚空风暴52区的首席工兵布拉斯特菲兹。‡殺掉布姆博士並將這個好消息帶給虛空風暴的52區給工兵領班布拉斯特費索。',
  }
},
[10222] = {
  {
    'A guarnição Solfúria‡Гарнизон Ярости Солнца‡Die Garnison des Sonnenzornpostens‡성난태양 주둔지‡El cuartel Furia del Sol‡El cuartel Furia del Sol‡La garnison Solfurie‡日怒堡‡日怒部隊',
    nil,
    'O Zelador Dieworth, na vila Kirin\'Var, quer que você mate 10 Arqueiros Solfúria.‡Смотритель Дайворт из деревни Кирин\'Вар просит вас убить 10 лучников из армии Ярости Солнца.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr 10 Bogenschützen des Sonnenzorns tötet.‡키린바르 마을에 있는 관리인 디워스가 성난태양 궁수 10명을 처치해 달라고 부탁했습니다.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 10 arqueros Furia del Sol.‡El custodio Valemuerte en el Poblado Kirin\'Var quiere que mates 10 arqueros Furia del Sol.‡Le Protecteur Valemort à Kirin\'Var veut que vous tuiez 10 Archers solfurie.‡肯瑞瓦村的管理者戴沃斯要你杀死10名日怒射手。‡肯瑞瓦村莊的管理者戴沃斯要你去殺了10個日怒弓箭手。',
  }
},
[10223] = {
  {
    'Abaixo o Daellis‡Покончить с Даэллисом‡Nieder mit Daellis‡댈리스 처치‡Abajo con Daellis‡Abajo con Daellis‡Mort à Daellis‡达尔利斯之死‡擊倒戴利斯',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você mate o Mestre Daellis Albatacas.‡Смотритель Дайворт из деревни Кирин\'Вар просит вас убить наставника Даэллиса Стрелка Рассвета.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr Meister Daellis Morgenschlag tötet.‡키린바르 마을에 있는 관리인 디워스가 기사대장 댈리스 돈스트라이크를 처치해 달라고 부탁했습니다.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que mates al maestro Daellis Golpe del Amanecer.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que mates al maestro Daellis Golpe del Amanecer.‡Le protecteur Valemort de Kirin\'Var veut que vous alliez tuer le maître Daellis Heurtelaube.‡肯瑞瓦村的管理者戴沃斯要你杀死达尔利斯·晨击。‡肯瑞瓦村莊的管理者戴沃斯要你去殺掉大師戴利斯·曦擊。',
  }
},
[10224] = {
  {
    'Essência para os motores‡Эссенция для двигателей‡Essenzen für die Motoren‡엔진을 위한 정수‡Esencia para los motores‡Esencia para los motores‡De l\'essence pour les moteurs‡引擎的能源‡引擎的精華',
    nil,
    'Colete 7 Essências de Aparição de Mana e leve-as ao Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Соберите 7 единиц эссенции призрака магии и доставьте главному инженеру Трепу в Зону 52 в Пустоверти.‡Sammelt 7 Essenzen eines Managespensts und bringt sie zu Chefingenieur Trep bei Area 52 im Nethersturm.‡마나 망령의 정수 7개를 수집한 후 황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 가져가야 합니다.‡Reúne 7 esencias de ánima de maná y regresa junto al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Reúne 7 esencias de ánima de maná y regresa junto al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Collectez 7 Essences d\'âmes en peine de mana et rapportez-les à l\'ingénieur en chef Trep à la Zone 52 au Raz-de-Néant.‡将7块法力怨魂精华交给虚空风暴52区的主工程师特雷普。‡收集7個法力怨靈精華將它們帶回到虛空風暴的52區給首席工程師崔普。',
  }
},
[10225] = {
  {
    'Apresente-se à engenharia‡Рапорт главному инженеру‡Meldung beim Chefingenieur‡선임기술자에게 보고‡Informe para lngeniería‡Informe para lngeniería‡Rapport à l\'ingénierie‡向主工程师汇报‡回報工程師',
    nil,
    'Entregue os cristais da matriz de eterlítio ao Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Передайте астраллитиевые матричные кристаллы главному инженеру Трепу, находящемуся в Зоне 52 в Пустоверти.‡Bringt die Astrallithiummatrixkristalle zu Chefingenieur Trep in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 에테리시움 맥석 수정을 가져가야 합니다.‡Entrégale los cristales de la matriz de eterlitio al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Entrégale los cristales de la matriz de eterlitio al ingeniero jefe Trep en el Área 52, en Tormenta Abisal.‡Apportez le Cristal de matrice d\'etherlithium à l\'Ingénieur en chef Trep dans la Zone 52 au Raz-du-Néant.‡将以太锂矩阵水晶交给虚空风暴52区的主工程师特雷普。‡將這些伊斯利母體水晶送到虛空風暴的52區給首席工程師崔普。',
  }
},
[10226] = {
  {
    'Extração de poder elemental‡Извлечение силы стихии‡Elementarenergieextraktor‡정령의 마력 추출‡Extracción de energía elemental‡Extracción de energía elemental‡Extraction de puissance élémentaire‡元素能量萃取器‡元素力量粹取',
    nil,
    'Extraia 5 Poderes Elementais para o Engenheiro-chefe Trep, na Área 52, em Eternévoa.‡Извлеките 5 единиц силы стихии для главного инженера Трепа, находящегося в Зоне 52 в Пустоверти.‡Extrahiert 5 Einheiten Elementarenergie und bringt sie zu Chefingenieur Trep in Area 52 im Nethersturm.‡정령의 마력 5개를 추출해서 황천의 폭풍의 52번 구역에 있는 선임기술자 트렙에게 가져다주어야 합니다.‡Extrae 5 unidades de energía elemental para el ingeniero jefe Trep en el Área 52, en la Tormenta Abisal.‡Extrae 5 unidades de energía elemental para el ingeniero jefe Trep en el Área 52, en la Tormenta Abisal.‡Extrayez 5 Puissances élémentaires et apportez-les à l\'Ingénieur en chef Trep, dans la Zone 52 au Raz-de-Néant.‡萃取5份元素能量，将它们交给虚空风暴52区的主工程师特雷普。‡取得5個元素力量並將它們帶給虛空風暴的52區給首席工程師崔普。',
  }
},
[10227] = {
  {
    'Eu vejo draeneis mortos‡Я вижу мертвых дренеев‡Ich sehe tote Draenei‡죽은 드레나이가 보여요‡Veo draenei muertos‡Veo draenei muertos‡Je vois des draeneï morts‡我看到了死德莱尼人‡我看到了德萊尼的鬼魂',
    nil,
    'Fale com Ramdor, o Louco, em cima da pilha de ossos na entrada das Catacumbas Auchenai.‡Поговорите с Рамдором Безумным, который стоит на груде костей неподалеку от Аукенайских гробниц.‡Sprecht mit Ramdor dem Wahnsinnigen auf dem Knochenhaufen außerhalb der Auchenaikrypta.‡아키나이 납골당의 바깥에서 뼈의 산 위에 서 있는 광기의 람도르와 대화하십시오.‡Habla con Ramdor el Loco junto a la pila de huesos fuera de las Criptas Auchenai.‡Habla con Ramdor el Loco junto a la pila de huesos fuera de las Criptas Auchenai.‡Parlez à Ramdor le Fol, qui se trouve sur le tas d\'os à l\'extérieur des cryptes Auchenaï.‡与奥金尼地穴外的疯狂的拉姆杜尔谈一谈，他就站在地穴入口附近的骨堆上。‡與奧奇奈地穴外白骨堆的瘋狂的藍姆多談談。',
  }
},
[10228] = {
  {
    'Ezequiel‡Иезекииль‡Ezekiel‡에제키엘‡Ezekiel‡Ezekiel‡Ezekiel‡伊瑟基尔‡伊斯奇歐',
    nil,
    'Encontre e fale com Ezequiel na cidade de Shattrath.‡Найдите Иезекииля из Шаттрата в городе Шаттрат и поговорите с ним.‡Sprecht mit Ezekiel von Shattrath in Shattrath.‡샤트라스에 있는 에제키엘을 찾아 대화하십시오.‡Busca a Ezekiel de Shattrath en Ciudad de Shattrath.‡Busca a Ezekiel de Shattrath en Ciudad de Shattrath.‡Trouvez Ezekiel dans la ville de Shattrath, et parlez-lui.‡与沙塔斯城的伊瑟基尔谈一谈。‡尋找並與撒塔斯城裡撒塔斯的伊斯奇歐談談。',
  }
},
[10229] = {
  {
    'Decifre o tomo‡Секрет фолианта‡Den Folianten entziffern‡고서 판독‡Descifrar el escrito‡Descifrar el escrito‡Déchiffrer le tome‡解读书卷‡解譯書籍',
    nil,
    'Leve o Tomo Misterioso para Althen, o Historiador, no Acampamento Quebra-espinha.‡Отнесите таинственный фолиант Альтену Историку на Заставу Хребтолома.‡Bringt den geheimnisvollen Folianten zu Althen dem Historiker im Rückenbrecherposten.‡해골망치 초소에 있는 역사가 알센에게 불가사의한 고서를 가져가야 합니다.‡Lleva el escrito misterioso a Althen, el historiador de la Avanzada Rompeloma.‡Lleva el escrito misterioso a Althen, el historiador de la Avanzada Rompeloma.‡Apportez le Tome mystérieux à Althen l\'Historien au Poste de Brise-échine.‡将神秘的典籍交给断背岗哨的史学家奥尔森。‡拿著這本神秘的秘典給斷脊氏族崗哨的歷史學家亞登。',
  }
},
[10230] = {
  {
    'A trompa de batalha‡Боевой рог‡Das Kampfhorn‡전투 뿔피리‡El cuerno de batalla‡El cuerno de batalla‡Le cor de bataille‡战斗的号角‡戰鬥號角',
    nil,
    'Pegue a trompa de batalha dos Obstinados com o Tenente-comandante Talvos e entregue-a para Althen, o Historiador, no Acampamento Quebra-espinha.‡Заберите у лейтенанта-командора Талвоса Боевой рог Непреклонных и принесите его Альтену Историку на Заставу Хребтолома.‡Besorgt Euch das Kampfhorn der Unerschütterlichen von Feldkommandant Thalvos und bringt es zu Althen dem Historiker im Rückenbrecherposten.‡부사령관 탈보스로부터 불굴의 전투 뿔피리를 빼앗아서 해골망치 초소에 있는 역사가 알센에게 가져가야 합니다.‡Toma el cuerno de batalla Implacable del comandante Thalvos y llévaselo Althen, el historiador de la Avanzada Rompeloma.‡Toma el cuerno de batalla Implacable del comandante Thalvos y llévaselo Althen, el historiador de la Avanzada Rompeloma.‡Prenez le Cor de bataille des Inflexibles au lieutenant-commandant Thalvos et apportez-le à Althen l\'Historien au Poste de Brise-échine.‡从塔沃斯少校那里拿到顽强战斗号角，把它交给断背岗哨的史学家奥尔森。‡從少校薩沃斯那把不屈戰爭號角帶給斷脊氏族崗哨的歷史家亞登。',
  }
},
[10231] = {
  {
    'Que livro? Não vejo livro nenhum‡Какая книга? Не вижу никакой книги‡Welches Buch? Ich sehe kein Buch.‡무슨 책 말이지? 책이라곤 못 봤는데...‡¿Libro? Yo no veo ninguno‡¿Libro? Yo no veo ninguno‡Quel livre ? Je ne vois pas de livre.‡什么书？我没见过什么书‡什麼書?我沒看到有什麼書啊。',
    nil,
    'Ezequiel disse que o livro foi roubado. O melhor é encontrar os rufiões e ver se eles têm informações.‡Иезекииль говорит, что книга могла быть украдена. Найдите головорезов и попытайтесь узнать что-нибудь у них.‡Ezekiel sagt, dass das Buch gestohlen wurde. Eure einzige Spur führt Euch zu den Grobianen. Schaut nach, ob sie irgendwelche Informationen haben.‡에제키엘은 그 책을 누가 훔쳐갔다고 말했습니다. 건달들을 찾아서 그들이 알고 있는 정보를 알아내는 것이 최선의 방법입니다.‡Ezekiel dijo que habían robado el libro Será mejor que encuentres a esos rufianes y veas si ellos tienen alguna información.|n‡Ezekiel dijo que habían robado el libro Será mejor que encuentres a esos rufianes y veas si ellos tienen alguna información.|n‡Ezekiel dit que le livre a été volé. Votre meilleure piste serait de trouver les ruffians et de voir s\'ils ont des informations à ce sujet.‡伊瑟基尔说亡者之书已经被偷走了。你最好去问问那些无赖，看他们是否知道些什么。‡艾澤基爾提到書已經被偷了。你最好的辦法就是去找那些惡棍並看看他們是否有什麼消息。',
  }
},
[10232] = {
  {
    'Encrenca com a Legião‡Легион – на мусор!‡Legion in Trümmern‡불타는 군단과의 전투‡Movida con la Legión‡Movida con la Legión‡Ferrailler contre la Légion‡废料场中的燃烧军团‡與軍團一戰',
    nil,
    'Mate 5 Forjadores da Ruína Mo\'args e 15 Engenheiros Gan\'args. Em seguida, fale com Papai Macário, na Área 52, em Eternévoa.‡Убейте 5 мо\'аргов-кузнецов рока и 15 ган\'аргов-инженеров. Затем возвращайтесь к Папаше Колесуну в Зону 52 в Пустоверти.‡Tötet 5 Schicksalsschmiede der Mo\'arg und 15 Ingenieure der Gan\'arg. Kehrt danach zu Papa Mauschel in Area 52 im Nethersturm zurück.‡모아그 파멸의 대장장이 5명과 간아그 기술자 15명을 처치한 후 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 돌아가야 합니다.‡Mata 5 forjadestinos Mo\'arg y 15 ingenieros Gan\'arg. Después, vuelve a hablar con Papá Ruedas en el Área 52, en Tormenta Abisal.‡Mata 5 forjadestinos Mo\'arg y 15 ingenieros Gan\'arg. Después, vuelve a hablar con Papá Ruedas en el Área 52, en Tormenta Abisal.‡Tuez 5 Forgerons funestes mo\'arg et 15 Ingénieurs gan\'arg. Puis retournez voir Papa Roulette dans la Zone 52 du Raz-de-Néant.‡杀死5名莫尔葛铁匠和15名甘尔葛工程师，然后向虚空风暴52区的维勒老爹复命。‡殺掉5個莫阿格設計師及15個甘納格工程師。完成後回到虛空風暴的52區找威勒老爹。',
  }
},
[10233] = {
  {
    'Atear fogo no Acampamento Solfúria‡Пожар в форте Ярости Солнца‡Den Sonnenzornposten anzünden‡성난태양 주둔지 방화‡Fuego en el Bastión Furia del Sol‡Fuego en el Bastión Furia del Sol‡Incendier le bastion des Solfurie‡烧毁日怒堡‡燒毀日怒要塞',
    nil,
    'Destrua 4 Balistas Solfúria e 4 barracas Solfúria usando uma Tocha Flamejante. Volte a falar com o Tenente-Feiticeiro Morran, na Vila Kirin\'Var.‡Используя горящий факел, уничтожьте 4 баллисты и 4 шатра в форте Ярости Солнца, затем вернитесь к лейтенанту-чародею Моррану в деревню Кирин\'Вар.‡Benutzt eine flammende Fackel, zerstört 4 Sonnenzornballisten und 4 Sonnenzornzelte und kehrt dann zu Zaubererleutnant Morran in Kirin\'Var zurück.‡불타오르는 횃불을 사용하여 성난태양 쇠뇌 4개, 성난태양 막사 4개를 파괴하고 키린바르 마을에 있는 마술사 부관 모란에게 돌아가야 합니다.‡Con una antorcha llameante, acaba con 4 balistas Furia del Sol y 4 tiendas Furia del Sol y regresa junto al teniente hechicero Morran en el Poblado Kirin\'Var.‡Con una antorcha llameante, acaba con 4 balistas Furia del Sol y 4 tiendas Furia del Sol y regresa junto al teniente hechicero Morran en el Poblado Kirin\'Var.‡À l\'aide d\'une Torche enflammée, détruisez 4 Balistes Solfurie et 4 Tentes Solfurie, puis retournez voir le lieutenant-ensorceleur Morran à Kirin\'Var.‡使用燃烧的火把烧毁4台日怒弩车和4顶日怒帐篷，然后向肯瑞瓦村的巫师上尉莫尔兰复命。‡使用燃焰火炬，摧毀4個日怒弩砲和4個日怒帳篷後回到肯瑞瓦村莊找莫爾蘭巫士中尉。',
  }
},
[10234] = {
  {
    'Lixo infernal‡Что одному демону мусор...‡Der Müll eines Dämons‡악마의 부품‡Basura del demonio...‡Basura del demonio...‡Le malheur d\'un démon...‡恶魔的垃圾......‡惡魔的垃圾……',
    nil,
    'Colete 10 Peças de Aníquilus e fale novamente com a Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Соберите 10 деталей сквернобота и доставьте их Мамаше Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Sammelt 10 Teile eines Teufelshäschers und bringt sie zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡지옥절단기 부품 10개를 수집한 후 황천의 폭풍의 중앙 생태지구의 중앙 생태지구 주둔지에 있는 휠러 아줌마에게 가져가야 합니다.‡Consigue 10 piezas de atracador vil y llévaselas a Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Consigue 10 piezas de atracador vil y llévaselas a Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Rassemblez 10 Pièces de saccageur gangrené et apportez-les à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡收集10个魔能机甲零件，然后返回虚空风暴的中央生态圆顶，将它们交给中央圆顶哨站的维勒老妈。‡取得10個惡魔劫奪者零件後帶回虛空風暴秘境領地內的領地崗哨交給威勒媽媽。',
  }
},
[10235] = {
  {
    'Sinistragarra desgarrado‡Коготь Рока? Вырвать с мясом!‡Verdammnisklaue die Krallen stutzen‡파멸의 발톱 무력화‡Deszarpar a Zarpaletal‡Deszarpar a Zarpaletal‡Dégriffer Griffe-funeste‡厄运之爪‡殺死末日裂爪',
    nil,
    'Obtenha a Mão de Sinistragarra e leve-a a Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Заберите руку Когтя Рока и доставьте ее Мамаше Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Besorgt Euch Verdammnisklaues Hand und bringt sie zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡파멸의 발톱 갈퀴손을 입수한 후 황천의 폭풍의 중앙 생태지구 내의 중앙 생태지구 주둔지에 있는 휠러 아줌마에게 가져가야 합니다.‡Consigue la Mano de Zarpaletal y entrégasela a Mamá Ruedas en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Consigue la Mano de Zarpaletal y entrégasela a Mamá Ruedas en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Procurez-vous la Main de Griffe-funeste et apportez-la à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡取得厄运之爪的手，然后返回虚空风暴的中央生态圆顶，将它们交给中央圆顶哨站的维勒老妈。‡取得末日裂爪之手然後將它送回虛空風暴裡秘境領地內的領地崗哨給威勒媽媽。',
  }
},
[10236] = {
  {
    'Terralém fede!‡Гадость это ваше Запределье!‡Die Scherbenwelt ist doof!‡지긋지긋한 아웃랜드!‡¡Terrallende es un asco!‡¡Terrallende es un asco!‡L\'Outreterre, c\'est nul !‡外域这烂地方！‡令人討厭的外域!',
    nil,
    'Encontre 6 Peças de Retalhador e fale novamente com o Capataz Razelcraz, na mina a noroeste de Thrallmar.‡Найдите 6 частей крошшера и верните их штейгеру Разлкразу на рудник, который находится к северо-западу от Траллмара.‡Großknecht Razelcraz möchte, dass Ihr ihm 6 Schredderteile besorgt. Kehrt danach zu ihm bei der Mine nordwestlich von Thrallmar zurück.‡절단기 예비 부품 6개를 찾은 후에 스랄마의 북서쪽 광산 옆에 있는 현장감독 라젤크라즈에게 돌아가야 합니다.‡Encuentra 6 piezas de trituradora y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Encuentra 6 piezas de trituradora y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Trouvez 6 Pièces de déchiqueteur et retournez voir le contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡找到6个伐木机备用零件，然后返回萨尔玛西北方的矿洞，将它们交给工头拉泽克拉兹。‡找到六個伐木機零件然後交給索爾瑪西北方的礦坑的工頭瑞絲坎茲。',
  }
},
[10237] = {
  {
    'Avise a Área 52!‡Предупредить Зону 52!‡Warnt Area 52!‡52번 구역에 통보!‡¡Avisa al Área 52!‡¡Avisa al Área 52!‡Avertir la Zone 52 !‡通知52区！‡警告52區!',
    nil,
    'Entregue as más notícias ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa.‡Передайте плохие новости ведущему ракетостроителю Фьюзеляжу в Зоне 52 в Пустоверти.‡Überbringt Raketenchef Doppeldecker in Area 52 in Nethersturm die schlechten Nachrichten.‡황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 지옥절단기 건축 설명서와 함께 좋지 않은 소식을 전해줘야 합니다.‡Entrega el manual de construcción de atracadores viles y lleva las malas noticias al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Entrega el manual de construcción de atracadores viles y lleva las malas noticias al jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Annoncez la mauvaise nouvelle au chef-de-fusée Karlingue dans la Zone 52 au Raz-de-Néant.‡将坏消息告诉虚空风暴52区的火箭主管弗斯拉格。‡傳遞這個壞消息給虛空風暴內52區的火箭主管夫斯拉吉知道。',
  }
},
[10238] = {
  {
    'Como servir goblins‡Каково работать на гоблинов‡Wie man Goblins zubereitet‡고블린을 돕는 법‡Cómo servir a los goblins‡Cómo servir a los goblins‡Comment servir le gobelin‡如何为地精效力‡如何服務哥布林',
    nil,
    'Resgate Manni, Mô e Jakk do acampamento orc vil e fale novamente com o Capataz Razelcraz, na mina a noroeste de Thrallmar.‡Спасите Манни, Моха и Джакка из лагерей орков Скверны и доставьте их штейгеру Разлкразу на рудник, который находится к северо-западу от Траллмара.‡Rettet Manni, Moh und Jakk aus den Lagern der Höllenorcs und bringt sie zu Großknecht Razelcraz bei der Mine nordwestlich von Thrallmar zurück.‡타락한 오크 야영지에서 만니, 모흐, 자크를 구출한 후에 스랄마의 북서쪽 광산 옆에 있는 현장감독 라젤크라즈에게 돌아가야 합니다.‡Rescata a Manni, Moh y Jakk de los campamentos de los orcos viles y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Rescata a Manni, Moh y Jakk de los campamentos de los orcos viles y regresa junto al supervisor Razelcraz en la mina al noroeste de Thrallmar.‡Sauvez Manni, Moh et Jakk des camps des gangr\'orcs et retournez voir le contremaître Razelcraz près de la mine au nord-ouest de Thrallmar.‡从邪兽人的营地中救出曼尼、莫恩和雅克，然后返回萨尔玛西北方的矿洞，向工头拉泽克拉兹复命。‡從魔獄獸人營地救回曼尼、莫歐還有杰克然後回到索爾瑪西北方的礦坑找工頭瑞絲坎茲。',
  }
},
[10239] = {
  {
    'Fonte potencial de energia‡Потенциальный источник энергии‡Mögliche Energiequelle‡잠재적인 마력의 원천‡Fuente de energía potencial‡Fuente de energía potencial‡Une source d\'énergie potentielle‡强大的能量源‡潛在的能量來源',
    nil,
    'O Tenente-Feiticeiro Morran, na Vila Kirin\'Var quer que você capture 10 Cubos de Isolamento de Energia nas operações dos elfos sangrentos, em Manaforja Coruu.‡Лейтенант-чародей Морран из деревни Кирин\'Вар просит вас захватить 10 энергетических кубов-изоляторов, используемых эльфами крови в манагорне Коруу.‡Zaubererleutnant Morran in Kirin\'Var möchte, dass Ihr ihm 10 Energieisolationswürfel von den Blutelfen der Manaschmiede Coruu bringt.‡키린바르 마을의 마술사 부관 모란이 코루 마나괴철로에서 일하는 블러드 엘프로부터 마력 분리 용기 10개를 입수해 달라고 부탁했습니다.‡El teniente hechicero Morran en el Poblado Kirin\'Var quiere que captures 10 cubos de aislamiento de energía de los elfos de sangre en la Forja de Maná Coruu.‡El teniente hechicero Morran en el Poblado Kirin\'Var quiere que captures 10 cubos de aislamiento de energía de los elfos de sangre en la Forja de Maná Coruu.‡Le lieutenant-ensorceleur Morran de Kirin\'Var veut que vous vous empariez de 10 Cubes d\'isolation à énergie dans les exploitations des elfes de sang de la manaforge Coruu.‡肯瑞瓦村的巫师上尉莫尔兰要你前往法力熔炉：库鲁恩，取回10块能量隔离器。‡肯瑞瓦村莊的莫爾蘭巫士中尉要你去從法力熔爐寇魯的血精靈行動中奪取10個能量隔離體回來。',
  }
},
[10240] = {
  {
    'Estabelecer o perímetro‡Постройка периметра‡Eine Verteidigung errichten‡새로운 보호막 만들기‡Construyendo un perímetro‡Construyendo un perímetro‡Établir un périmètre‡构筑能量壁障‡建立結界',
    nil,
    'Use o Dispositivo de Ativação Rúnica próximo da Runa Leste, da Runa Nordeste e da Runa Oeste. As runas encontram-se no perímetro dos distritos do Estreito do Teurgo e da praça da cidade da Vila Kirin\'Var. Fale novamente com o Tenente-Feiticeiro Morran assim que completar a missão.‡Используйте устройство пробуждения рун поблизости от восточной, северо-восточной и западной руны. Руны можно найти по периметру районов переулка Волшебников и главной площади деревни Кирин\'Вар. По завершении задачи вернитесь к лейтенанту-чародею Моррану.‡Benutzt das Gerät zur Aktivierung von Runen bei der östlichen Rune, der nordöstlichen Rune und der westlichen Rune. Die Runen befinden sich entlang der Verteidigung der Zaubergasse und des Ratsplatz von Kirin\'Var. Kehrt zu Zaubererleutnant Morran zurück, wenn Ihr die Aufgabe erfüllt habt.‡키린바르 마을의 마법사 지구와 광장 주변에서 볼 수 있는 동쪽, 북동쪽, 서쪽에 있는 키린바르 룬에 룬 활성화 장치를 사용하여 임무를 완수한 후 마술사 부관 모란에게 돌아가야 합니다.‡Utiliza el aparato de activación de runa cerca de la runa del este, la runa del noroeste y la runa del oeste. Puedes encontrar las runas alrededor del perímetro del Pasaje del Zahorí y la Plaza de la Ciudad del Poblado Kirin\'Var. Ve a ver al teniente hechicero Morran cuando hayas completado la tarea.‡Utiliza el aparato de activación de runa cerca de la runa del este, la runa del noroeste y la runa del oeste. Puedes encontrar las runas alrededor del perímetro del Pasaje del Zahorí y la Plaza de la Ciudad del Poblado Kirin\'Var. Ve a ver al teniente hechicero Morran cuando hayas completado la tarea.‡Utilisez le Mécanisme d\'activation des runes près de la Rune est, la Rune nord-est et la Rune ouest. Ces runes se trouvent quelque part autour des quartiers de l\'Allée des sorciers et de la Place centrale de Kirin\'Var. Retournez voir le lieutenant-ensorceleur Morran une fois que vous aurez accompli cette tâche.‡对东部符文、东北部符文和西部符文使用符文激活装置。你可以在肯瑞瓦村城镇广场和巫师街周边找到这些符文。完成任务后向巫师上尉莫尔兰复命。‡在東邊符文，東北邊符文，以及西邊符文附近使用符文啟動裝置。這些符文能夠在肯瑞瓦村莊的巫士街及小鎮廣場區週邊找到。完成任務後回去找莫爾蘭巫士中尉。',
  }
},
[10241] = {
  {
    'Distrações em Manaforja B\'naar‡Отвлекающий маневр в манагорне Б\'наар‡Ablenkung in der Manaschmiede B\'naar‡브나르 마나괴철로 교란‡Distracción en la Forja de Maná B\'naar‡Distracción en la Forja de Maná B\'naar‡Diversion à la manaforge B\'naar‡削弱法力熔炉：布纳尔‡法力熔爐巴納爾的擾亂行動',
    nil,
    'Mate 8 Magísteres Solfúria e 8 Guardas de Sangue Solfúria. Em seguida, fale novamente com o Exarca Orelis, na Área 52.|n|nCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Убейте 8 магистров и 8 кровостражей клана Ярости Солнца, затем возвращайтесь к экзарху Орелису в Зону 52.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Tötet 8 Magister des Sonnenzorns und 8 Blutwärter des Sonnenzorns und kehrt dann zu Exarch Orelis in Area 52 zurück.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Ruf bei den Sehern.‡성난태양 마법학자 8명과 성난태양 붉은경비병 8명을 처치한 후 52번 구역에 있는 총독 오렐리스에게 돌아가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Mata 8 magistri Furia del Sol y 8 depositarios de sangre Furia del Sol. Después vuelve a ver al exarca Orelis en el Área 52.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Mata 8 magistri Furia del Sol y 8 depositarios de sangre Furia del Sol. Después vuelve a ver al exarca Orelis en el Área 52.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Tuez 8 Magistères Solfurie et 8 Garde-sang Solfurie puis retournez voir l\'exarque Orelis dans la Zone 52.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡杀死8名日怒魔导师和8名日怒血卫士，然后向52区的大主教欧雷里斯复命。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡殺掉8個日怒博學者及8個日怒血守衛，完成後回到52區找主教歐瑞利斯。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10242] = {
  {
    'Acampamento Quebra-espinha‡Застава Хребтолома‡Der Rückenbrecherposten‡해골망치 초소‡La Avanzada Rompeloma‡La Avanzada Rompeloma‡Le poste de Brise-échine‡断背岗哨‡斷脊氏族崗哨',
    nil,
    'A Boticária Zenóbia, no Posto dos Destroços, quer que você peça ao Comandante de Ala Brack uma mantícora para voar até o Acampamento Quebra-espinha e, uma vez lá, que você entregue a Amostra de Sangue de Olhos Sangrentos ao Boticário Alberto no Acampamento Quebra-espinha.‡Доставьте образец крови орков из клана Кровавой Глазницы аптекарю Альбреку на заставу Хребтолома по просьбе аптекаря Зеланы из Погибели Сквернобота. Чтобы добраться до заставы на виверне, обратитесь к командиру звена Бракку.‡Apothekerin Zelana beim Häschersturz möchte, dass Ihr mit Schwadronskommandant Brack sprecht, um auf einem Flügeldrachen zum Rückenbrecherposten zu fliegen. Bringt die Blutprobe des Blutenden Auges zu Apotheker Albreck im Rückenbrecherposten.‡지옥절단기 함락지에 있는 연금술사 젤라나가 편대사령관 브락크와 대화해 와이번을 타고 해골망치 초소로 간 다음, 그곳에 있는 연금술사 알브렉에게 피투성이굴부족 혈액 견본을 전해 달라고 부탁했습니다.‡La boticaria Zelana en la Caída del Atracador Vil, quiere que hables con el comandante del aire Brack para coger un dracoleón hasta la Avanzada Rompeloma y llevar la muestra de sangre Foso Sangrante al boticario Albreck en la Avanzada Rompeloma.‡La boticaria Zelana en la Caída del Atracador Vil, quiere que hables con el comandante del aire Brack para tomar un dracoleón hasta la Avanzada Rompeloma y llevar la muestra de sangre Foso Sangrante al boticario Albreck en la Avanzada Rompeloma.‡L\'Apothicaire Zelana du Trépas du saccageur vous a demandé de parler au Chef d\'escadrille Brack et de prendre une wyverne pour rallier le Poste de Brise-échine, puis de remettre l\'Échantillon de sang de l\'Orbite-sanglante à l\'apothicaire Albreck au Poste de Brise-échine.‡机甲残骸的药剂师塞兰娜要你与空军指挥官布拉克谈一谈，搭乘双足飞龙前往断背岗哨，并将血环血样交给断背岗哨的药剂师阿尔布雷克。‡劫奪者荒野的藥劑師席蓮娜要你和空軍指揮布拉克談談以搭乘雙足翼龍到斷脊氏族崗哨，把血之谷鮮血樣本帶給斷脊氏族崗哨的藥劑師艾柏瑞克。',
  }
},
[10243] = {
  {
    'Tecnologia naaru‡Технология наару‡Die Technologie der Naaru‡나루의 기술‡Tecnología naaru‡Tecnología naaru‡Technologie naaru‡纳鲁科技‡那魯的技術',
    nil,
    'Entre em Manaforja B\'naar e encontre o Painel de Controle de B\'naar.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Зайдите в манагорн Б\'наар и найдите панель управления манагорном.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Geht in die Manaschmiede B\'naar und sucht die Steuerkonsole von B\'naar.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡브나르 마나괴철로 안으로 들어가서 브나르 제어장치를 찾아야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Entra en la Forja de Maná B\'naar y encuentra la consola de control B\'naar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entra en la Forja de Maná B\'naar y encuentra la consola de control B\'naar.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entrez dans la manaforge B\'naar et trouvez la Console de contrôle B\'naar.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡进入法力熔炉：布纳尔，找到布纳尔控制台。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡進入法力熔爐巴納爾找到巴納爾控制臺。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10244] = {
  {
    'R.T.F.R.C.M.‡Учи матчасть!‡Liesmich‡지옥절단기 건축 설명서‡R.T.F.R.C.M.‡R.T.F.R.C.M.‡R.T.F.M.C.S.‡DEPRECATED‡惡魔搶奪者製造手冊',
    nil,
    'Take the Fel Reaver Construction Manual to Mama Wheeler at the Midrealm Post inside Eco-Dome Midrealm in the Netherstorm.‡Отнесите инструкцию по созданию сквернобота Мамаше Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Bringt die Bauanleitung für Teufelshäscher zu Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡황천의 폭풍의 중앙 생태지구 내부 중앙 생태지구 주둔지에 있는 휠러 아줌마에게 지옥절단기 건축 설명서을 가져가야 합니다.‡Lleva el manual de construcción de atracadores viles a Mamá Ruedas en el Puesto de la Tierra Media, dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Lleva el manual de construcción de atracadores viles a Mamá Ruedas en el Puesto de la Tierra Media, dentro del Ecodomo de la Tierra Media, en la Tormenta Abisal.‡Apportez le Manuel de construction du saccageur gangrené à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡将Fel Reaver Construction Manual带给虚空风暴中央生态圆顶内的Mama Wheeler。‡將惡魔劫奪者製造手冊帶到虛空風暴的秘境領地裡的領地崗哨給威勒媽媽。',
  }
},
[10245] = {
  {
    'Transcrição do painel de B\'naar‡Описание панели управления Б\'наара‡Steuerungsabschrift von B\'naar‡브나르 제어장치 필사본‡Trascripción de la consola de B\'naar‡Trascripción de la consola de B\'naar‡La transcription de la console de B\'naar‡布纳尔控制台拓文‡巴納爾控制臺謄本',
    nil,
    'Leve a Transcrição do painel de B\'naar à Anacoreta Karja, na Área 52, em Eternévoa.|n|nCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Передайте описание панели управления Б\'наара анахорету Карже в Зону 52 в Пустоверти.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt die Steuerungsabschrift von B\'naar zu Anachoret Karja in Area 52 im Nethersturm.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡황천의 폭풍의 52번 구역에 있는 수도사 카르자에게 브나르 제어장치 필사본을 전해 주어야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Entrega la trascripción de consola B\'naar a la Anacoreta Karja del Área 52, en Tormenta Abisal.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Entrega la trascripción de consola B\'naar a la Anacoreta Karja del Área 52, en Tormenta Abisal.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Apportez la Transcription de la console de B\'naar à l\'anachorète Karja dans la Zone 52 au Raz-de-Néant.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将布纳尔控制台拓文交给虚空风暴52区的学者卡尔亚。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡將巴納爾控制臺謄本傳送至虛空風暴的52區給隱士卡爾加。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10246] = {
  {
    'Manaforja Coruu sob ataque‡Нападение на манагорн Коруу‡Angriff auf Manaschmiede Coruu‡코루 마나괴철로 공격‡Ataque a la Forja de Maná Coruu‡Ataque a la Forja de Maná Coruu‡Attaquer la manaforge Coruu‡攻击法力熔炉：库鲁恩‡攻擊法力熔爐寇魯',
    nil,
    'Viaje até Manaforja Coruu e mate 8 Arcanistas Solfúria e 5 Pesquisadores Solfúria. Fale novamente com o Exarca Orelis quando houver cumprido a tarefa.|n|nCumprir missões para os Aldor fará com que a sua reputação entre os Áugures diminua.‡Отправляйтесь к манагорну Коруу и убейте 8 чародеев и 5 ученых из армии Ярости Солнца. По завершении задачи возвращайтесь к экзарху Орелису.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Coruu und tötet 8 Arkanisten des Sonnenzorns und 5 Forscher des Sonnenzorns. Kehrt zu Exarch Orelis zurück, wenn Ihr Eure Aufgabe erledigt habt.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡코루 마나괴철로로 가서 성난태양 신비술사 8명과 성난태양 연구원 5명을 처치한 후 총독 오렐리스에게 돌아가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Coruu y mata 8 arcanistas Furia del Sol y 5 investigadores Furia del Sol. Vuelve a hablar con el exarca Orelis cuando hayas cumplido esta misión.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Coruu y mata 8 arcanistas Furia del Sol y 5 investigadores Furia del Sol. Vuelve a hablar con el exarca Orelis cuando hayas cumplido esta misión.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Partez pour la manaforge Coruu et tuez 8 Arcanistes solfurie et 5 Chercheurs solfurie. Retournez voir l\'exarque Orelis lorsque vous aurez accompli cette tâche.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：库鲁恩，杀死8名日怒奥术师和5名日怒研究员，完成任务后向大主教欧雷里斯复命。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐寇魯去殺掉8個日怒大法師及5個日怒調查員。完成後回報給主教歐瑞利斯。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10247] = {
  {
    'Doutor Vômisa, Ph.T.‡Вомиза, доктор псевдотехнических наук‡Dr. h. c. tüft. Vomisa‡공학박사 보미사‡Doctor Vomisa, Ph.T.‡Doctor Vomisa, Ph.T.‡Le docteur Vomisa, Ph.T.‡工程学博士沃米萨‡莫米沙博士',
    nil,
    'Fale com o Doutor Vômisa, Ph.T., no Campo de Testes, em Eternévoa.‡Поговорите с доктором псевдотехнических наук Вомизой на Испытательном полигоне в Пустоверти.‡Sprecht mit Dr. h. c. tüft. Vomisa in den Versuchsgründen im Nethersturm.‡황천의 폭풍의 발명품 실험장에 있는 공학박사 보미사와 대화해야 합니다.‡Entrega el manual de construcción de atracadores viles al doctor Vomisa Ph.T. en el terreno de pruebas, en la Tormenta Abisal.‡Entrega el manual de construcción de atracadores viles al doctor Vomisa Ph.T. en el terreno de pruebas, en la Tormenta Abisal.‡Allez parler au docteur Vomisa, Ph.T. au Terrain d\'essai du Raz-de-Néant.‡与虚空风暴实验场的工程学博士沃米萨谈一谈。‡去虛空風暴的試煉場裡和莫米沙博士交談。',
  }
},
[10248] = {
  {
    'Você, robô‡Ты, робот‡Du, der Roboter‡고철절단기 X6000‡Tú, Robot‡Tú, Robot‡Toi, le robot‡你，机器人‡你，機器人',
    nil,
    'Ative o Controle do Aniquilata X6000 e teste suas capacidades. Em seguida, faça um relatório para o Doutor Vômisa, Ph.T, no Campo de Testes, em Eternévoa. Cuide de todos os problemas que surgirem.‡Активируйте пульт управления "Утилизатора Х6000" и проверьте его возможности. Затем передайте результаты доктору псевдотехнических наук Вомице, находящемуся на испытательном полигоне в Пустоверти. Если возникнут проблемы, разберитесь с ними..‡Aktiviert die Steuerung für Schrotthäscher X6000 und testet seine Fähigkeiten aus. Gebt Dr. h. c. tüft. Vomisa bei den Versuchsgründen im Nethersturm danach Eure Rückmeldung.‡소지품에 있는 조종기로 고철절단기 X6000을 작동하여 성능을 시험하면서 발생하는 일을 처리한 후, 황천의 폭풍의 발명품 실험장에 있는 공학박사 보미사에게 결과를 알려줘야 합니다.‡Activa el Atracador desguazador X6000 y prueba todas sus funciones. Después informa al doctor Vomisa, Ph.T en el Terreno de Pruebas de Tormenta Abisal. Encárgate de cualquier problema que pueda surgir.‡Activa el Atracador desguazador X6000 y prueba todas sus funciones. Después informa al doctor Vomisa, Ph.T en el Terreno de Pruebas de Tormenta Abisal. Encárgate de cualquier problema que pueda surgir.‡Activez les Commandes du saccageur ferrailleur X6000 et testez-en les fonctionnalités. Puis faites part de vos impressions au docteur Vomisa, Ph.T. sur le Terrain d\'essai de Raz-de-Néant. Réglez tout problème qui se ferait jour.‡启动再造机甲X6000型控制器并测试其性能，灵活应对测试过程中的突发状况。然后向虚空风暴实验场的工程学博士沃米萨汇报实验结果。‡啟動廢料劫奪者X6000搖控器然後測試它的功能。然後將你的測試結果回報給虛空風暴的試煉場的莫米沙博士。應付所有發生的問題。',
  }
},
[10249] = {
  {
    'De volta ao Chefe!‡Обратно к командующему!‡Zurück zum Chef!‡로켓발사단장에게 돌아가기!‡¡El jefe de nuevo!‡¡El jefe de nuevo!‡On retourne voir le chef !‡去找火箭主管！‡回去找主管!',
    nil,
    'Apresente-se ao Mestre-fogueteiro Fuselagem, na Área 52, em Eternévoa, imediatamente!‡Немедленно явитесь к ведущему ракетостроителю Фьюзеляжу в Зону 52 в Пустоверти!‡Meldet Euch sofort bei Raketenchef Doppeldecker in Area 52 im Nethersturm!‡지금 당장 황천의 폭풍의 52번 구역에 있는 로켓발사단장 퓨즐라지에게 보고해야 합니다!‡Preséntate inmediatamente ante el jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Preséntate inmediatamente ante el jefe de cohetes Fuselaje en el Área 52, en la Tormenta Abisal.‡Retournez voir immédiatement le Chef-de-fusée Karlingue, dans la Zone 52 de Raz-de-Néant !‡立刻向虚空风暴52区的火箭主管弗斯拉格报到！‡馬上回報給在虛空風暴裡52區的火箭主管夫斯拉吉。',
  }
},
[10250] = {
  {
    'Vingança sangrenta‡Кровавая месть‡Blutige Rache‡피의 복수‡Venganza sangrienta‡Venganza sangrienta‡Vengeance sanglante‡血之复仇‡血腥的復仇',
    nil,
    'Toque a Trompa de Batalha dos Obstinados perto do Estandarte da Aliança. Mate Urtrak e então fale novamente com Althen, o Historiador, no Acampamento Quebra-espinha.‡Подуйте в боевой рог Непреклонных рядом со знаменем Альянса. Убейте Уртрака и возвращайтесь к Альтену Историку на Заставу Хребтолома.‡Stoßt am alten Belagerungsturm der Allianz in das Kampfhorn der Unerschütterlichen. Tötet Urtrak und kehrt danach zu Althen dem Historiker im Rückenbrecherposten zurück.‡얼라이언스 깃발 근처에서 불굴의 전투 뿔피리를 부십시오. 우트락을 처치한 다음 해골망치 초소에 있는 역사가 알센에게 돌아가야 합니다.‡Haz que suene el cuerno de batalla Implacable cerca del estandarte de la Alianza. Mata a Urtrak y vuelve a hablar con Althen el historiador en la Avanzada Rompeloma.‡Haz que suene el cuerno de batalla Implacable cerca del estandarte de la Alianza. Mata a Urtrak y vuelve a hablar con Althen el historiador en la Avanzada Rompeloma.‡Sonnez le Cor de bataille des Inflexibles près de la bannière de l\'Alliance. Tuez Urtrak puis retournez voir Althen l\'Historien au Poste de Brise-échine.‡在联盟战旗附近吹响顽强战斗号角。然后杀死乌尔特拉克，并向断背岗哨的史学家奥尔森复命。‡在聯盟旌旗附近吹響不屈戰爭號角。殺掉烏崔克後回到斷脊氏族崗哨找歷史家亞登。',
  }
},
[10251] = {
  {
    'O plano magistral do amo?‡Великий замысел господина?‡Der große Plan des Meisters?‡주인님의 위대한 계획?‡¿La obra maestra del maestro?‡¿La obra maestra del maestro?‡Le Grand Dessein Du Maître ?‡主人的伟大设计？‡大師的偉大設計?',
    nil,
    'Encontre Nitrin, o Erudito na Armaria Abandonada em Nagrand.‡Найдите Нитрина Сведущего в Заброшенной оружейной в Награнде.‡Sucht Nitrin den Gelehrten im verlassenen Rüstlager in Nagrand.‡나그란드의 버려진 무기고에서 학자 니트린을 찾아야 합니다.‡Encuentra a Nitrin el Erudito en la Armería Abandonada, en Nagrand.‡Encuentra a Nitrin el Erudito en la Armería Abandonada, en Nagrand.‡Trouvez Nitrin l\'Instruit à l\'Armurerie abandonnée en Nagrand.‡前往纳格兰废弃的军械库寻找博学者尼特林的下落。‡找到在納葛蘭被遺棄的軍械庫的博學者奈崔恩。',
  }
},
[10252] = {
  {
    'Visão dos mortos‡Посмотри в глаза мертвым‡Vision der Toten‡죽은 자를 보는 눈‡Visión de los muertos‡Visión de los muertos‡Vision des morts‡亡者的视界‡死者的視界',
    nil,
    'Nitrin, no Arsenal Abandonado em Nagrand, quer que você leve até ele 1 Olho de Gronn da Montanha, 1 Bico Perfeito de Roca-dos-ventos Maior e 1 Naco de Fenoceronte Idoso.‡Принесите Нитрину из Заброшенной оружейной Награнда 1 глаз горного гронна, 1 безупречный клюв большого вертуха и 1 сальник старого копытня.‡Nitrin im verlassenen Rüstlager in Nagrand möchte, dass Ihr ihm 1 Augapfel eines Berggronns, 1 fehlerloser Schnabel eines großen Windrocs und 1 Tran eines gealterten Grollhufs bringt.‡나그란드의 버려진 무기고에 있는 니트린이 산악 그론의 눈 1개, 거대한 바람올빼미의 온전한 부리 1개, 늙은 갈래발굽의 지방덩어리 1개를 가져다 달라고 부탁했습니다.‡Nitrin, en la Armería Abandonada, en Nagrand, quiere que le lleves 1 globo ocular de gronn montés, 1 pico de vientorroc superior perfecto y 1 grasa de uñagrieta envejecido.‡Nitrin, en la Armería Abandonada, en Nagrand, quiere que le lleves 1 globo ocular de gronn montés, 1 pico de vientorroc superior perfecto y 1 grasa de uñagrieta envejecido.‡Nitrin, à l\'Armurerie abandonnée en Nagrand, veut que vous lui rameniez 1 Globe oculaire de Gronn des montagnes, 1 Bec de Venteroc supérieur sans défaut et 1 Poche de graisse de vieux sabot-fourchu.‡收集1颗山丘戈隆的眼球、1个完美的大型风鹏之喙和1份老迈裂蹄牛的脂肪，然后返回纳格兰废弃的军械库，把它们交给尼特林。‡納葛蘭裡被遺棄的軍械庫的奈崔恩要你為他帶來1個山地古羅眼珠，1個無瑕的巨型風翼貓頭鷹之啄和1份老邁的裂蹄油。',
  }
},
[10253] = {
  {
    'Levixus o evocador de almas‡Левиксус Призыватель Душ‡Levixus der Seelenrufer‡영혼의 소환사 레비주스‡Levixus el Invocador de Almas‡Levixus el Invocador de Almas‡Levixus le Mandeur d\'âme‡唤魂者利维休斯‡靈魂呼喚者勒威薩斯',
    nil,
    'Extermine Levixus e tire o Livro dos Mortos dele.|n|nEntregue o Livro dos Mortos a Ramdor, o Louco, na entrada das Catacumbas Auchenai, em Auchindoun.|n|nVocê prometeu, lembra?‡Убейте Левиксуса и заберите у него Книгу Мертвых.|n|nОтнесите Книгу Рамдору Безумному, который находится неподалеку от входа в Аукенайские гробницы в Аукиндоне.|n|nВы ведь с ним об этом договаривались, помните?‡Vernichtet Levixus und nehmt Euch das Buch der Toten aus seinem Besitz.|n|nBringt das Buch der Toten zu Ramdor dem Wahnsinnigen außerhalb der Auchenaikrypta am Eingang zu Auchindoun.|n|nIhr hattet eine Vereinbarung, erinnert Ihr Euch?‡레비주스를 해치우고 사자의 책을 빼앗아야 합니다.|n|n아킨둔의 아키나이 납골당 입구 바깥에 서 있는 광기의 람도르에게 그 책을 전해주어야 합니다.|n|n설마 약속을 잊지는 않았겠죠?‡Destruye a Levixus y coge el libro de los muertos.|n|nEntrega el libro de los muertos a Ramdor el Loco fuera de las Criptas Auchenai, en la entrada de Auchindoun.|n|nTenías un trato, ¿lo recuerdas?‡Destruye a Levixus y toma el libro de los muertos.|n|nEntrega el libro de los muertos a Ramdor el Loco fuera de las Criptas Auchenai, en la entrada de Auchindoun.|n|nTenías un trato, ¿lo recuerdas?‡Tuez Levixus et prenez-lui le Livre des morts.|n|nApportez le Livre des morts à Ramdor le Fol à l\'extérieur des Cryptes Auchenaï, à l\'entrée d\'Auchindoun.|n|nVous aviez passé un marché, vous vous souvenez ?‡杀死利维休斯，夺得亡者之书。|n|n将亡者之书交给疯狂的拉姆杜尔，他就站在奥金顿的奥金尼地穴入口外。|n|n你们之间有协议的，还记得吗？‡殺掉勒威薩斯並且取走他的亡者之書。|n|n將亡者之書交付給在奧齊頓的奧奇奈地穴入口外的瘋狂的藍姆多。|n|n你有一個交易，記得嗎?',
  }
},
[10254] = {
  {
    'Comandante-chefe Danath‡Командир армии Данат‡Truppenkommandant Danath‡전투사령관 다나스‡Comandante en jefe Danath‡Comandante en jefe Danath‡Le commandant Danath‡指挥官达纳斯‡軍隊指揮官達納斯·托爾貝恩',
    nil,
    'O Marechal Isildor quer que você se apresente ao Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Доставьте по приказу маршала Исилдора донесение командиру армии Данату Троллебою в Оплот Чести.‡Marschall Isildor möchte, dass Ihr Euch bei Truppenkommandant Danath Trollbann in der Ehrenfeste meldet.‡치안대장 이실도르가 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 보고해 달라고 부탁했습니다.‡El mariscal Isildor quiere que te presentes ante el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡El mariscal Isildor quiere que te presentes ante el comandante en jefe Danath Aterratrols en el Bastión del Honor.‡Le maréchal Isildor veut que vous vous présentiez au commandant de corps Danath Trollemort au bastion de l\'Honneur.‡伊斯多尔元帅要求你向荣耀堡的远征军指挥官达纳斯·托尔贝恩报到。‡治安官伊斯歐朵爾要你向榮譽堡的軍隊指揮官達納斯·托爾貝恩回報。',
  }
},
[10255] = {
  {
    'Testando o antídoto‡Проверка противоядия‡Das Gegengift testen‡치료제 시험‡Pruebas de antídoto‡Pruebas de antídoto‡Tester l\'antidote‡测试解毒剂‡測試解毒劑',
    nil,
    'Use o Antídoto Cenariano em um Javiltusco Parrudo e observe os resultados. Assim que você obtiver os resultados do experimento, fale novamente com Tiá Juba Rubra, no Posto Cenariano, que fica na Península Fogo do Inferno.‡Введите кенарийское противоядие крупному зловепрю и пронаблюдайте за результатом. После проведения эксперимента возвращайтесь к Тие Рыжей Гриве на Кенарийскую заставу на полуострове Адского Пламени.‡Probiert das cenarische Gegengift an einem bulligen Hölleneber aus und beobachtet die Folgen. Sobald Ihr die Ergebnisse des Experiments habt, kehrt zu Thiah Rotmähne im Posten des Cenarius auf der Höllenfeuerhalbinsel zurück.‡덩치 큰 지옥멧돼지에게 세나리온 치료제를 사용하고 효과를 지켜보고 실험의 결과를 얻어낸 후, 지옥불 반도의 세나리온 초소에 있는 타이아 레드메인에게 돌아가야 합니다.‡Usa el antídoto Cenarion sobre un jabinferno descomunal y observa sus efectos. Cuando tengas los resultados del experimento, regresa junto a Thiah Melenarroja del Puesto Cenarion, en la Península del Fuego Infernal.‡Usa el antídoto Cenarion sobre un jabinferno descomunal y observa sus efectos. Cuando tengas los resultados del experimento, regresa junto a Thiah Melenarroja del Puesto Cenarion, en la Península del Fuego Infernal.‡Administrez l\'Antidote cénarien à un Sanglier infernal massif et observez le résultat. Une fois l\'expérience terminée, retournez voir Thiah Crin-rouge au Poste cénarien dans la péninsule des Flammes infernales.‡对笨拙的地狱野猪使用塞纳里奥解毒剂，并观察解毒剂的效果。然后返回地狱火半岛的塞纳里奥哨站，向塞安·红鬃汇报实验的结果。‡將恐牙的鮮血樣本使用在地獄野豬身上並觀察結果。一旦你知道實驗的結果後，回到地獄火半島的塞納里奧前哨找塞伊亞·紅髮。',
  }
},
[10256] = {
  {
    'A senhora da chave encontrada‡Найти Хранителя Ключей‡Den Schlüsselmeister finden‡열쇠지기 찾기‡Buscando a la Maestra de llaves‡Buscando a la Maestra de llaves‡Trouver le Maître des clés‡钥匙的主人‡找到鑰匙持有者',
    nil,
    'Localize Ápice e obtenha o Cristal Focal do Ápice. Retorne à Torre Violeta e use o Cristal Focal do Ápice próximo do orbe do Arquimago Vargoth para descobrir quem possui a chave para quebrar a maldição da torre.‡Выследите Камнегора и заберите у него кристальное средоточие. Вернитесь к Аметистовой башне и используйте кристальное средоточие Камнегора поблизости от шара верховного мага Варгота для того, чтобы обнаружить, у кого хранятся ключи от проклятия башни.‡Sucht Apex und besorgt Euch Apex\' Kristallfokus. Kehrt dann zum Violetten Turm zurück und benutzt Apex\' Kristallfokus in der Nähe von Erzmagier Vargoths Kugel um herauszufinden, wer den Schlüssel zum Fluch des Turms hat.‡에이펙스를 찾아서 에이펙스의 수정 초점을 입수하여 보랏빛 탑으로 돌아간 후, 바르고스의 수정구슬 근처에서 에이펙스의 수정 초점을 사용하여 탑의 저주를 풀 수 있는 열쇠를 누가 가지고 있는지 알아내야 합니다.‡Encuentra a Cumbre y quítale un foco de cristal de Cumbre. Ve a la Torre Violeta y úsalo cerca del orbe del archimago Vargoth para descubrir quién tiene la llave para romper la maldición de la torre.‡Encuentra a Cumbre y quítale un foco de cristal de Cumbre. Ve a la Torre Violeta y úsalo cerca del orbe del archimago Vargoth para descubrir quién tiene la llave para romper la maldición de la torre.‡Trouvez Apex et procurez-vous un Focalisateur en cristal d\'Apex. Retournez à la Tour pourpre et utilisez le Focalisateur à proximité de l\'Orbe de l\'archimage Vargoth pour découvrir qui détient la clé qui permettra de lever la malédiction pesant sur la tour.‡找到阿匹克斯并夺得阿匹克斯的聚焦水晶，然后返回紫罗兰之塔，在大法师瓦格斯的宝珠旁使用阿匹克斯的聚焦水晶，查明破除塔内诅咒的钥匙在谁手中。‡找到艾派斯巨人並且從他那裡取得艾派斯巨人的水晶集中。回到紫羅蘭之塔並且在大法師 瓦戈斯的寶珠附近使用艾派斯巨人的水晶集中，以找出誰握有打斷那些塔之詛咒的關鍵。',
  }
},
[10257] = {
  {
    'A captura da pedra-chave‡Захват краеугольного камня‡Den Schlüsselstein erobern‡쐐기돌 찾기‡La piedra angular‡La piedra angular‡S\'emparer de la Pierre cruciale‡夺回钥石‡取得拱心石',
    nil,
    'Aventure-se na estufa da Bastilha da Tormenta e consiga a chave de pedra da Comandante Sarannis. Traga-a ao Arquimago Vargoth, na Torre Violeta.‡Проникните в Ботанику в Крепости Бурь и заберите ключ у командира Сараннис. Отнесите ключ верховному магу Варготу в Аметистовую башню.‡Reist zur Botanika der Festung der Stürme und besorgt Euch den Schlüsselstein von Kommandant Sarannis. Bringt ihn danach zu Erzmagier Vargoth im Violetten Turm.‡폭풍우 요새의 신록의 정원으로 가서 지휘관 새래니스에게서 쐐기돌을 되찾은 후, 보랏빛 탑에 있는 대마법사 바르고스에게 가져가야 합니다.‡Adéntrate en El Invernáculo de El Castillo de la Tempestad y recupera la piedra angular de la comandante Sarannis. Llévasela al archimago Vargoth en la Torre Violeta.‡Adéntrate en El Invernáculo de El Castillo de la Tempestad y recupera la piedra angular de la comandante Sarannis. Llévasela al archimago Vargoth en la Torre Violeta.‡Entrez dans la Botanica du donjon de la Tempête et prenez la Pierre cruciale au commandant Sarannis. Apportez-la à l\'archimage Vargoth à la Tour pourpre.‡进入风暴要塞的生态船，从指挥官萨拉妮丝手中夺得钥石，将它交给紫罗兰之塔的大法师瓦格斯。‡冒險進入風暴要塞的波塔尼卡從指揮官薩瑞尼斯身上取回拱心石。將它帶給紫羅蘭之塔的大法師瓦戈斯。',
  }
},
[10258] = {
  {
    'Honre os caídos‡Честь Павших‡Die Gefallenen ehren‡쓰러진 병사를 기리며‡Honrar a los caídos‡Honrar a los caídos‡Honorer les morts‡逝者的荣耀‡榮耀失落者',
    nil,
    'Apresente-se ao Comandante Hogarth no Arsenal da Expedição.‡Явитесь к командиру Хогарду, который находится в оружейной экспедиции.‡Meldet Euch bei Hogarth, dem Kommandanten des Expeditionsrüstlagers.‡원정대 무기고의 지휘관 호가스를 찾아가 보고하십시오.‡Preséntate al comandante Hogarth en la Armería de Expedición.‡Preséntate al comandante Hogarth en la Armería de Expedición.‡Présentez-vous au commandant Hogarth à l\'Armurerie de l\'expédition.‡向远征军物资库的指挥官霍加斯报到。‡向遠征隊軍械庫的指揮官霍卡爾斯回報。',
  }
},
[10259] = {
  {
    'Into the Breach‡Битва в Проломе‡Auf in den Kampf!‡난국 타개‡Cruzando la brecha‡Abriendo brecha‡Dans la brèche‡勇往直前‡進入裂縫中',
    nil,
    'Mate 6 Guardas Vis Invasores e fale novamente com o Emissário Argênteo Bembrioso.‡Убейте 6 вторгшихся стражей Скверны и затем вернитесь к посланнику ордена Серебряного Рассвета Праудвелл.‡Tötet 6 einfallende Teufelswachen und kehrt dann zum Argentumabgesandten Stolzbrunn zurück.‡들이닥친 지옥수호병 6마리를 처치한 후 대리인 프라우드웰에게 돌아가야 합니다.‡Mata 6 guardias viles incursores e informa al emisario Argenta Pozobravo.‡Mata 6 guardias viles incursores e informa al emisario Argenta Pozobravo.‡Tuez 6 Gangregardes de l\'invasion et retournez voir l\'émissaire de l\'Aube d\'argent Fièrepuits.‡杀死6个入侵的恶魔卫士，然后向银色使者普罗维尔复命。‡殺掉6個入侵的惡魔守衛，然後回去找銀色特使波特威歐。',
  }
},
[10260] = {
  {
    'Netherologist Coppernickels‡Пустолог Медноклеппер‡Netheorologe Kupfernickel‡황천전문가 코퍼니켈스‡Abisólogo Nicuproso‡Abisólogo Nicuproso‡Pokernikus le néantologue‡DEPRECATED‡虛空學家卡伯尼寇斯',
    nil,
    'Speak with Netherologist Coppernickels at the bridge leading into the Netherstorm from Blade\'s Edge.‡Поговорите с Пустологом Медноклеппером у моста, ведущего от Пустоверти к Острогорью.‡Sprecht mit Netheorologe Kupfernickel bei der Brücke, die vom Nethersturm zum Schergrat führt.‡칼날 산맥에서 황천의 폭풍으로 통하는 다리에 있는 황천전문가 코퍼니켈스와 대화해야 합니다.‡Habla con el abisólogo Nicuproso en el puente a Tormenta Abisal desde Filospada.‡Habla con el abisólogo Nicuproso en el puente a Tormenta Abisal desde Filospada.‡Parlez au néantologue Pokernikus sur le pont qui conduit au Raz-de-Néant depuis les Tranchantes.‡前往刀锋山与虚空风暴相连接的桥边寻找Netherologist Coppernickels，并与他交谈。‡與虛空學家卡伯尼寇斯談談，他在劍刃山脈往虛空風暴的橋上。',
  }
},
[10261] = {
  {
    'Procura-se: aniquilador servomecânico!‡Разыскивается: аннигиляторный сервопривод!‡Gesucht: Vernichterservo!‡구함: 파멸자 제어장치!‡Se busca: Servoaniquilador‡Se busca: Servoaniquilador‡On recherche : servomoteur d\'annihilateur !‡悬赏：歼灭者机械臂‡懸賞:殲滅者伺服電動機!',
    nil,
    'Obtenha um Aniquilador Servomecânico e leve-o a Papai Macário, na Área 52, em Eternévoa.‡Заберите аннигиляторный сервопривод и доставьте его Папаше Колесуну в Зону 52 Пустоверти.‡Besorgt einen Vernichterservo und bringt ihn zu Papa Mauschel in Area 52 im Nethersturm.‡파멸자 제어장치를 입수한 후에 황천의 폭풍의 52번 구역에 있는 휠러 아저씨에게 전해줘야 합니다.‡Consigue un servoaniquilador y entrégaselo a Papá Ruedas en el Área 52 en Tormenta Abisal.‡Consigue un servoaniquilador y entrégaselo a Papá Ruedas en el Área 52 en Tormenta Abisal.‡Procurez-vous un Servomoteur d\'annihilateur et apportez-le à Papa Roulette dans la Zone 52 au Raz-de-Néant.‡将一根歼灭者机械臂交给虚空风暴52区的维勒老爹。‡取得一部殲滅者伺服電動機，並且將它帶回虛空風暴的52區交給威勒老爹。',
  }
},
[10262] = {
  {
    'Destroços etéreos‡Груда духов Астрала‡Ein Hügel voll Astraler‡에테리얼 무리‡Un montón de etéreos‡Un montón de etéreos‡Un monceau d\'éthériens‡叛徒的徽记‡一堆以太族',
    nil,
    'Colete 10 Insígnias Zaxxis e leve-as ao Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Соберите 10 знаков отличия братства Заксис и принесите их ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Sammelt 10 Insignien der Zaxxis und kehrt dann zu Netherpirscher Khay\'ji in Area 52 im Nethersturm zurück.‡작시스 휘장 10개를 수집해서 황천의 폭풍 52번 구역에 있는 황천추적자 케이지에게 가져가야 합니다.‡Recoge 10 insignias de Zaxxis y llévaselas al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Recoge 10 insignias de Zaxxis y llévaselas al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Collectez 10 Insignes de Zaxxis et apportez-les au Traqueur-du-Néant Khay\'ji dans la Zone 52 de Raz-de-Néant.‡收集10枚萨克希斯徽记，将它们交给虚空风暴52区的虚空猎手卡尔伊。‡收集10枚薩希斯徽記，並且將它們帶回虛空風暴的52區交給虛空巡者凱澤。',
  }
},
[10263] = {
  {
    'Auxílio ao Consórcio‡Содействие Консорциуму‡Dem Konsortium helfen‡무역연합 돕기‡Ayudar al Consorcio‡Ayudar al Consorcio‡Aider le Consortium‡协助星界财团‡協助聯合團',
    nil,
    'Fale com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Поговорите с ловчим Пустоты Кай\'джи в Зоне 52 в Пустоверти.‡Sprecht mit Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍 52번 구역에 있는 황천추적자 케이지와 대화하십시오.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Parlez au traqueur-du-Néant Khay\'ji dans la Zone 52 au Raz-de-Néant.‡到虚空风暴去，与52区的虚空猎手卡尔伊谈一谈。‡到虛空風暴的52區找虛空巡者凱澤談談。',
  }
},
[10264] = {
  {
    'Auxílio ao Consórcio‡Содействие Консорциуму‡Dem Konsortium helfen‡무역연합 돕기‡Ayudar al Consorcio‡Ayudar al Consorcio‡Aider le Consortium‡协助星界财团‡協助聯合團',
    nil,
    'Fale com o Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Поговорите с ловчим Пустоты Кай\'джи в Зоне 52 в Пустоверти.‡Sprecht mit Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍 52번 구역에 있는 황천추적자 케이지와 대화하십시오.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Habla con el acechador abisal Khay\'ji del Área 52, en la Tormenta Abisal.‡Parlez au Traqueur-du-Néant Khay\'ji dans la Zone 52 au Raz-de-Néant.‡到虚空风暴去，与52区的虚空猎手卡尔伊谈一谈。‡到虛空風暴的52區找虛空巡者凱澤談談。',
  }
},
[10265] = {
  {
    'Coleta de cristais para o Consórcio‡Добыча артефакта для Консорциума‡Kristallsammlung des Konsortiums‡무역연합 수정 수집‡Colección de cristales de El Consorcio‡Colección de cristales de El Consorcio‡La collection de cristaux du Consortium‡星界财团的水晶‡聯合團水晶收集',
    nil,
    'Obtenha o artefato de cristal de Arklon e leve-o ao Espreitador Etéreo Khay\'ji, na Área 52, em Eternévoa.‡Заполучите кристаллический артефакт Арклона и верните его ловчему Пустоты Кай\'джи, находящемуся в Зоне 52 в Пустоверти.‡Besorgt ein Kristallartefakt von Arklon und bringt es zu Netherpirscher Khay\'ji in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 황천추적자 케이지에게 알클론 수정 유물 1개를 가져가야 합니다.‡Consigue un artefacto de cristal de Arklon y llévaselo al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Consigue un artefacto de cristal de Arklon y llévaselo al acechador abisal Khay\'ji al Área 52 en Tormenta Abisal.‡Procurez-vous un artéfact cristallin d\'Arklon et rapportez-le au traqueur-du-Néant Khay\'ji à la Zone 52 au Raz-de-Néant.‡将一件阿尔科隆水晶神器交给虚空风暴52区的虚空猎手卡尔伊。‡取得阿克隆水晶手工品，並且將它帶回虛空風暴的52區交給虛空巡者凱澤。',
  }
},
[10266] = {
  {
    'Pedido de assistência‡Запрос о содействии‡Bitte um Unterstützung‡원조 요청‡Petición de ayuda‡Petición de ayuda‡Demande d\'assistance‡寻求帮助‡要求幫助',
    nil,
    'Procure-o e ofereça-lhe os seus serviços. Ele se encontra no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Найдите Гаруджа и предложите ему свои услуги. Он находится на заставе внутри заповедника "Срединные земли" в Пустоверти.‡Sucht Gahruj und bietet ihm Eure Hilfe an. Er befindet sich im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡가루즈를 찾아서 도와주어야 합니다. 황천의 폭풍, 중앙 생태지구 안에 있는 중앙 생태지구 주둔지로 가십시오.‡Busca a Gahruj y ofrécele tus servicios. Se encuentra en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media de Tormenta Abisal.‡Busca a Gahruj y ofrécele tus servicios. Se encuentra en el Puesto de la Tierra Media, en el Ecodomo de la Tierra Media de Tormenta Abisal.‡Trouvez Gahruj et proposez-lui vos services. Il se trouve au comptoir des Terres-médianes dans l\'Écodôme Terres-médianes au Raz-de-Néant.‡前往虚空风暴中央生态圆顶的中央圆顶哨站，找到加鲁斯并为他效力。‡尋找並提供加魯你的幫助。他就在虛空風暴的秘境領地裡的領地崗哨。',
  }
},
[10267] = {
  {
    'Retomada justa‡Изъятие по праву‡Rechtmäßiger Besitz‡정당한 회수‡Legítima recuperación‡Legítima recuperación‡Récupérer ce qui nous revient de droit‡贸易终结‡合法的回收',
    nil,
    'Colete 10 Caixas de Equipamento de Sondagem e leve-os a Gahruj, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Заберите 10 ящиков с геодезическим снаряжением и верните их Гаруджу, находящемуся на заставе внутри заповедника "Срединные земли" в Пустоверти.‡Sammelt 10 Kästen mit Vermessungsausrüstung und bringt sie zu Gahruj im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡측량 장비 상자 10개를 모아서 황천의 폭풍, 중앙 생태지구 안에서 중앙 생태지구 주둔지에 있는 가루즈에게 돌려주어야 합니다.‡Coge 10 cajas de equipo de análisis y llévaselas a Gahruj al Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en Tormenta Abisal.‡Recoge 10 cajas de equipo de análisis y llévaselas a Gahruj al Puesto de la Tierra Media, en el Ecodomo de la Tierra Media, en Tormenta Abisal.‡Récupérez 10 Boîtes d\'équipement topographique et rapportez-les à Gahruj au comptoir des Terres-médianes dans l\'Écodôme Terres-médianes au Raz-de-Néant.‡收集10箱测量装置，然后返回虚空风暴中央生态圆顶的中央圆顶哨站，将它们交给加鲁斯。‡收集10箱勘探設備帶回虛空風暴秘境領地的領地崗哨給加魯。',
  }
},
[10268] = {
  {
    'Audiência com o príncipe‡Аудиенция у принца‡Eine Audienz beim Prinzen‡왕자 알현‡Una audiencia con el príncipe‡Una audiencia con el príncipe‡Une audience avec le prince‡与节点亲王会面‡晉見王子',
    nil,
    'Entregue o Equipamento de Sondagem à imagem do Príncipe do Nexus Haramad, no Pináculo da Tempestade, em Eternévoa.‡Доставьте геодезическое снаряжение к проекции принца нексуса Харамада в Штормовую Вершину в Пустоверти.‡Bringt die Vermessungsausrüstung zum Bild von Nexusprinz Haramad in der Sturmsäule im Nethersturm.‡황천의 폭풍, 폭풍 첨탑에 있는 연합왕자 하라매드의 영상에게 측량 장비를 가져가야 합니다.‡Entrega el equipo de análisis a la Imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Entrega el equipo de análisis a la Imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Remettez l\'Équipement topographique à l\'image du prince-nexus Haramad à la Foudreflèche au Raz-de-Néant.‡前往虚空风暴的风暴尖塔，将测量装置交给节点亲王哈拉迈德的影像。‡將勘探設備送到虛空風暴的風暴之尖交給奈薩斯王子哈拉瑪德的影像。',
  }
},
[10269] = {
  {
    'Ponto de triangulação um‡Триангуляция: точка первая‡Triangulationspunkt Eins‡첫 번째 삼각측량 지점‡Punto de triangulación uno‡Punto de triangulación uno‡Point de triangulation numéro un‡一号三角点‡三角測量點之一',
    nil,
    'Use o Dispositivo de Triangulação para indicar a direção do primeiro ponto de triangulação. Assim que o encontrar, relate sua localização ao Mercador Hazzin, na Guarita do Protetorado, na ilha de Manaforja Ultris, em Eternévoa.‡Используйте триангуляционный прибор, чтобы найти путь к первой точке триангуляции. Как только найдете точку, сообщите ее местонахождение дельцу Хаззину, находящемуся на заставе Протектората на острове манагорна Ультрис в Пустоверти.‡Benutzt das Triangulationsgerät, um den Weg zum ersten Triangulationspunkt zu bestimmen. Wenn Ihr ihn gefunden habt, meldet die Position an Händler Hazzin beim Wachposten des Protektorats auf der Insel der Manaschmiede Ultris im Nethersturm.‡삼각측량 장비를 사용하여 첫 번째 삼각측량 지점을 찾아가십시오. 발견한 후에는 황천의 폭풍의 울트리스 마나괴철로 섬에 있는 자유연합 경비초소의 무역업자 하진에게 가서 위치를 보고하십시오.‡Usa el aparato de triangulación para localizar el primer punto de triangulación. Informa de su ubicación al tratante Hazzin en la Avanzada del Protectorado en la isla de la Forja de Maná Ultris en Tormenta Abisal.‡Usa el aparato de triangulación para localizar el primer punto de triangulación. Informa de su ubicación al tratante Hazzin en la Avanzada del Protectorado en la isla de la Forja de Maná Ultris en Tormenta Abisal.‡Utilisez l\'Appareil de triangulation pour vous indiquer la direction du premier point de triangulation. Une fois que vous l\'aurez trouvé, donnez-en l\'emplacement au camelot Hazzin au poste de garde du Protectorat dans l\'île de la manaforge Ultris au Raz-de-Néant.‡利用三角测量仪找到一号三角点。找到之后，立刻前往虚空风暴法力熔炉：乌提斯的维序派哨站，向商人哈斯辛汇报三角点的位置。‡使用三角裝置指引你前往第一個三角測量點的方向。一旦你找到它，把位置報告給虛空風暴法力熔爐奧崔斯島上護國者哨站的商人海辛。',
  }
},
[10270] = {
  {
    'Uma não-tão-modesta proposição‡Нескромное предложение‡Ein nicht-so-bescheidenes Angebot‡그다지 적절하지 않은 제안‡Proposición poco decente‡Proposición poco decente‡Une proposition pas si modeste‡不太谦虚的提议‡一個不太謙虛的提議',
    nil,
    'Consiga a bateria carregada de teleportador e traga-a à plataforma de teleporte etéreo no Pico Celestial, a leste de Manaforja Ultris. Ative a plataforma e dê o Recipiente de Energia do Teleporte à imagem do Mercador do Vento Marid para que ele o instale.‡Найдите аккумулятор для телепортатора и отнесите его к площадке астрального телепорта на Небесной гряде. Активируйте площадку и отдайте аккумулятор проекции торговца ветром Марида, чтобы он мог установить его.‡Besorgt Euch die Teleporterenergiezelle und bringt sie zur Astralteleportplattform im Sternensturz östlich der Manaschmiede Ultris. Aktiviert die Plattform und bringt die Teleporterenergiezelle zum Bild von Windhändler Marid, damit er sie einbauen kann.‡순간이동기 전원공급장치를 찾아서 울트리스 마나괴철로 동쪽, 하늘 마루에 있는 에테리얼 순간이동 장치로 가져가십시오. 순간이동 장치를 작동시킨 다음 순간이동기 전원공급장치를 설치할 수 있도록 바람의 무역상 마리드의 영상에게 건네줘야 합니다.‡Recupera el envase de energía de teletransportador y llévalo a la plataforma de teletransporte etérea en la Cresta Celestial, al este de la Forja de Maná Ultris. Activa la plataforma y dale la fuente de energía a la imagen del comerciante de viento Marid para que la instale.‡Recupera el envase de energía de teletransportador y llévalo a la plataforma de teletransporte etérea en la Cresta Celestial, al este de la Forja de Maná Ultris. Activa la plataforma y dale la fuente de energía a la imagen del comerciante de viento Marid para que la instale.‡Récupérez le Bloc d\'alimentation du téléporteur et apportez-le à la Plate-forme de téléportation éthérienne sur la Crête céleste à l\'est de la manaforge Ultris. Activez la plate-forme et donnez le Bloc d\'alimentation du téléporteur à l\'Image du marchand des vents Marid pour qu\'il puisse l\'installer.‡取回传送器能量包，将它带至法力熔炉：乌提斯东边苍穹之脊上的虚灵传送器。激活传送器，然后将传送器能量包交给星界商人玛里德的影像，让他进行安装。‡取得傳送力量背包並將它帶到法力熔爐奧崔斯東方的天國山脈的以太傳送器去。啟動這個平臺並將傳送力量背包交給風之貿易者瑪利德的影像以便他能夠安裝它。',
  }
},
[10271] = {
  {
    'Vamos aos negócios‡Деловая активность‡Zur Sache‡사업 착수‡A trabajar‡A trabajar‡Passer aux choses sérieuses‡重要生意‡動手幹活',
    nil,
    'Colete 8 Essências de Dragão Etéreo, depois volte à Plataforma de Teleporte Etéreo. Essências de Dragão Etéreo podem ser obtidas de Dracos Etéreos e Dragões Etéreos.‡Соберите 8 единиц эссенции дракона Пустоты, затем возвращайтесь в зону площадки астрального телепорта. Эссенцию дракона Пустоты можно получить из старых или молодых драконов Пустоты.‡Sammelt 8 Einheiten Netherdrachenessenz und kehrt dann zur Gegend bei der Astralteleporterplattform zurück. Die Netherdrachenessenz könnt Ihr von Netherdrachen oder Nethergroßdrachen sammeln.‡황천의 용 정수 8개를 수집한 다음 에테리얼 순간이동 장치 지역으로 돌아가십시오. 황천의 용 정수는 황천의 비룡이나 황천의 용으로부터 얻을 수 있습니다.‡Recolecta 8 esencias de dragón abisal y vuelve a la plataforma de teletransporte etérea. Puedes obtener la esencia de dracos abisales o de dragones abisales.‡Recolecta 8 esencias de dragón abisal y vuelve a la plataforma de teletransporte etérea. Puedes obtener la esencia de dracos abisales o de dragones abisales.‡Récoltez 8 Essences de dragon du Néant puis retournez à la Plate-forme de téléportation éthérienne. Ces essences se ramassent sur les drakes du Néant ou les dragons du Néant.‡收集8份虚空龙类精华，然后返回虚灵传送器区域。你可以从虚空幼龙或虚空之龙身上收集到虚空龙类精华。‡收集8個虛空龍精華然後回到以太傳送器地區。你可以從虛空龍或者虛空龍身上取得虛空龍精華 。',
  }
},
[10272] = {
  {
    'Um início promissor‡Многообещающее начало‡Ein viel versprechender Anfang‡순조로운 출발‡Un buen comienzo‡Un buen comienzo‡Un départ prometteur‡成功的开始‡一個有希望的開始',
    nil,
    'Colete 15 Ovos de Draconiano do Éter e, em seguida, fale com Tyri e Jorad no Pico Celestial.‡Соберите 15 яиц драконидов Пустоты, затем возвращайтесь к Тири и Джораду на Небесную гряду.‡Sammelt 15 Netherdrachkineier und kehrt dann zu Tyri und Jorad im Sternensturz zurück.‡황천의 용족 알 15개를 수집한 다음 하늘 마루에 있는 타이리와 조라드에게 돌아가십시오.‡Recolecta 15 huevos de dragonante abisal y llévaselos a Tyri y Jorad a la Cresta Celestial.‡Recolecta 15 huevos de dragonante abisal y llévaselos a Tyri y Jorad a la Cresta Celestial.‡Récoltez 15 Oeufs de draconiens du Néant, puis retournez auprès de Tyri et Jorad sur la Crête céleste.‡收集15枚虚空龙卵，然后向苍穹之脊的泰莉和乔拉德复命。‡收集15個虛空龍族的蛋，完成後返回天國山脈的泰利和喬洛德那裡。',
  }
},
[10273] = {
  {
    'Distrações nocivas‡Пустые хлопоты‡Störende Ablenkung‡성가신 골칫거리‡Problemas a la vista‡Problemas a la vista‡Malencontreuses distractions‡棘手的目标‡討人厭的傢伙',
    nil,
    'Fale com o Mercador do Vento Marid e atraia-o para longe de seu entreposto. Acabe com ele e fale novamente com Tyri e Jorad, no Pico Celestial.‡Поговорите с торговцем Ветром Маридом и выманите его из торгового поста. Покончите с ним, затем вернитесь к Тири и Джораду на Небесную гряду.‡Sprecht mit Windhändler Marid und lockt ihn von seinem Handelsposten fort. Vernichtet ihn und kehrt dann zu Tyri und Jorad im Sternensturz zurück.‡바람의 무역상 마리드와 대화해서 그가 거래를 하고 있는 기지에서 꾀어내야 합니다. 그를 처치한 다음 하늘 마루에 있는 타이리와 조라드에게 돌아가십시오.‡Habla con el comerciante de viento Marid y aléjalo de su tienda. Ocúpate de él y ve a ver a Tyri y Jorad a la Cresta Celestial.‡Habla con el comerciante de viento Marid y aléjalo de su tienda. Ocúpate de él y ve a ver a Tyri y Jorad a la Cresta Celestial.‡Parlez avec le marchand des vents Marid et attirez-le à l\'écart de son commerce. Débarrassez-vous de lui puis retournez auprès de Tyri et Jorad sur la Crête céleste.‡与星界商人玛里德谈一谈，诱使他离开商栈。杀死玛里德后向苍穹之脊的泰莉和乔拉德复命。‡跟風之貿易者瑪利德交談並且引誘他離開交易站。殺死他然後回去天國山脈找泰利還有喬洛德。',
  }
},
[10274] = {
  {
    'Defendendo o Pico Celestial‡Безопасность Небесной гряды‡Den Sternensturz sichern‡하늘 마루 수호‡Proteger la Cresta Celestial‡Proteger la Cresta Celestial‡S\'emparer de la Crête céleste‡占领苍穹之脊‡保衛天國山脈',
    nil,
    'Use o Desafio da Revoada Azul para provocar Verakan, na extremidade sul do Pico Celestial. Derrote-o e fale novamente com Tyri e Jorad, no Pico Celestial.‡Используйте вызов синих драконов, чтобы вызвать на бой Вераку, живущего на южном склоне Небесной гряды. Победите его и возвращайтесь к Тири и Джораду, ожидающим на Небесной гряде.‡Benutzt die Herausforderung des blauen Drachenschwarms um Veraku am südlichen Ende des Sternensturzes zu provozieren. Besiegt ihn und kehrt dann zu Tyri und Jorad im Sternensturz zurück.‡푸른용군단의 도전을 사용하여 하늘 마루의 남쪽 끝에 있는 베라쿠에게 도전해야 합니다. 그를 해치우고 하늘 마루에 있는 타이리와 조라드에게 돌아가십시오.‡Usa el desafío del Vuelo Azul para provocar a Veraku en el extremo sur de Cresta Celestial. Derrótalo y ve a ver a Tyri y Jorad a Cresta Celestial.‡Usa el desafío del Vuelo Azul para provocar a Veraku en el extremo sur de Cresta Celestial. Derrótalo y ve a ver a Tyri y Jorad a Cresta Celestial.‡Utilisez le Défi du Vol bleu pour provoquer Veraku en duel sur le bord sud de la Crête céleste. Triomphez de lui et retournez voir Tyri et Jorad sur la Crête céleste.‡前往苍穹之脊的南端，使用蓝龙的挑战激怒维拉库。击败他后向苍穹之脊的泰莉和乔拉德复命。‡使用藍龍軍團的挑戰在天國山脈的南方邊緣上激怒維拉庫。打敗他並且回到天國山脈的泰利和喬洛德那裡。',
  }
},
[10275] = {
  {
    'Ponto de triangulação dois‡Триангуляция: точка вторая‡Triangulationspunkt Zwei‡두 번째 삼각측량 지점‡Punto de triangulación dos‡Punto de triangulación dos‡Point de triangulation numéro deux‡二号三角点‡三角測量點之二',
    nil,
    'Use o Dispositivo de Triangulação para indicar a direção do segundo ponto de triangulação. Assim que o encontrar, relate sua localização ao Mercador do Vento Tuluman, no Acampamento do Tuluman, logo depois da ponte que leva à ilha de Manaforja Ara, em Eternévoa.‡Используйте триангуляционный прибор, чтобы найти путь ко второй точке триангуляции. Как только найдете точку, сообщите ее местонахождение торговцу ветром Тулуману, находящемуся в лагере Тулумана, по другую сторону моста, ведущего от острова манагорна Ара в Пустоверти.‡Benutzt das Triangulationsgerät, um den Weg zum zweiten Triangulationspunkt zu bestimmen. Wenn Ihr ihn gefunden habt, meldet die Position an Windhändler Tuluman auf Tulumans Landeplatz auf der anderen Seite der Brücke zu der Insel der Manaschmiede Ara im Nethersturm.‡삼각측량 장비를 사용하여 두 번째 삼각측량 지점을 찾으십시오. 발견하면 황천의 폭풍의 아라 마나괴철로 섬으로 들어가는 다리 옆, 툴루만의 교역지에 있는 바람의 무역상 툴루만에게 가서 그 위치를 보고하십시오.‡Usa el aparato de triangulación para localizar el segundo punto de triangulación. Informa al comerciante de viento Tuluman en Alto de Tuluman, justo al cruzar el puente de la isla de Forja de Maná Ara en Tormenta Abisal.‡Usa el aparato de triangulación para localizar el segundo punto de triangulación. Informa al comerciante de viento Tuluman en Alto de Tuluman, justo al cruzar el puente de la isla de Forja de Maná Ara en Tormenta Abisal.‡Utilisez l\'Appareil de triangulation pour vous indiquer la direction du deuxième point de triangulation. Une fois que vous l\'aurez trouvé, donnez-en l\'emplacement au marchand des vents Tuluman au Point d\'ancrage de Tuluman, juste de l\'autre côté du pont vers l\'île de la manaforge Ara au Raz-de-Néant.‡利用三角测量仪找到二号三角点。找到之后，立刻前往虚空风暴法力熔炉：艾拉对面的图鲁曼的营地，向星界商人图鲁曼汇报三角点的位置。‡使用三角裝置指引你前往第二個三角測量點的方向。一旦你找到它，將位置報告給在虛空風暴的吐魯曼平臺的風之貿易者吐魯曼，他就在從法力熔爐艾拉島出來的橋的另一邊。',
  }
},
[10276] = {
  {
    'Triângulo completo‡Полный треугольник‡Das volle Dreieck‡완전한 삼각형‡Triángulo completo‡Triángulo completo‡Le triangle est triangulé‡三角测量‡完整三角形',
    nil,
    'Recupere o Cristal Ata\'mal e leve-o à Imagem do Príncipe do Nexus Haramad, no Pináculo da Tempestade, em Eternévoa.‡Заберите кристалл Ата\'мала и передайте его проекции принца нексуса Харамада, находящейся в Штормовой Вершине в Пустоверти.‡Besorgt Euch den Kristall von Ata\'mal und bringt ihn zum Bild von Nexusprinz Haramad in der Sturmsäule im Nethersturm.‡아타말 수정을 찾아서 황천의 폭풍, 폭풍 첨탑에 있는 연합왕자 하라매드의 영상에게 가져가야 합니다.‡Recupera el cristal de Ata\'mal y dáselo a la imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Recupera el cristal de Ata\'mal y dáselo a la imagen del príncipe-nexo Haramad en La Flecha de la Tormenta, en Tormenta Abisal.‡Récupérez le Cristal d\'Ata\'mal et rapportez-le à l\'image du prince-nexus Haramad à la Foudreflèche au Raz-de-Néant.‡夺得阿塔玛水晶，然后返回虚空风暴的风暴之塔，将它交给节点亲王哈拉迈德的影像。‡取回阿塔莫水晶並且將它帶到虛空風暴的風暴之尖交給奈薩斯王子哈拉瑪德的影像。',
  }
},
[10277] = {
  {
    'Cavernas do Tempo‡Пещеры Времени‡Die Höhlen der Zeit‡시간의 동굴‡Las Cavernas del Tiempo‡Las Cavernas del Tiempo‡Les Grottes du temps‡时光之穴‡時光之穴',
    nil,
    'Andormu, nas Cavernas do Tempo, lhe conferiu a tarefa de seguir a Guia do Tempo pela caverna.‡Андорму попросил вас пройти по пещерам вместе с хранительницей времени.‡Andormu in den Höhlen der Zeit möchte, dass Ihr der Bewahrerin der Zeit durch die Höhle folgt.‡시간의 동굴에 있는 안도르무가 동굴 주변에 있는 시간의 관리인을 따라가 달라고 부탁했습니다.‡Andormu de las Cavernas del Tiempo quiere que sigas a la custodia del Tiempo.‡Andormu de las Cavernas del Tiempo quiere que sigas a la custodia del Tiempo.‡Andormu vous demande de suivre la Protectrice du temps dans les Grottes du temps.‡时光之穴的安多尔姆要你跟随时光监护者游览时光之穴。‡在時光之穴的安杜姆要你跟隨洞穴附近的時間管理人。',
  }
},
[10278] = {
  {
    'As fendas dimensionais‡Астральные провалы‡Sphärenrisse‡일그러진 균열‡Las fallas de distorsión‡Las fallas de distorsión‡Les failles dimensionnelles‡迁跃裂隙‡扭曲裂隙',
    nil,
    'Use o Gerador de Fendas Dimensionais Instáveis embaixo dos Campos Dimensionais. Colete 3 amostras de Éter Dimensional de Emissários do Caos Instáveis e leve-as para Ogath, o Louco, no Acampamento Quebra-espinha.‡Используйте нестабильный генератор астральных провалов на Искривленных полях. Соберите три горсти пыли Пустоты с нестабильных демонов Бездны и возвращайтесь к Огафу Безумному на заставу Хребтолома.‡Benutzt den instabilen Sphärenrissgenerator in den Sphärenfeldern. Sammelt 3 Einheiten Sphärennether von instabilen Leerwandlern und kehrt dann zu Ogath dem Verrückten im Rückenbrecherposten zurück.‡일그러진 벌판에서 불안정한 일그러진 균열 생성기를 사용해야 합니다. 불안정한 보이드워커를 처치하고 일그러진 황천 3개를 수집해서 해골망치 초소의 미치광이 오가스에게 가져가야 합니다.‡Usa el generador de fallas de distorsión inestable en Los Campos Alabeados. Coge 3 abismos de distorsión de abisarios inestables y llévaselos a Ogath el Loco a la Avanzada Rompeloma.‡Usa el generador de fallas de distorsión inestable en Los Campos Alabeados. Recoge 3 abismos de distorsión de abisarios inestables y llévaselos a Ogath el Loco a la Avanzada Rompeloma.‡Utilisez le Générateur de faille dimensionnelle instable dans les Champs de distorsion. Récupérez 3 Néants dimensionnels sur des Marcheurs du Vide instables, puis retournez voir Ogath le Fol au poste de Brise-échine.‡在迁跃平原使用不稳定的迁跃裂隙生成器。从不稳定的虚空行者身上收集3份迁跃虚空能量，把它们交给断背岗哨的疯狂的欧加斯。‡在扭曲原野使用不穩定的扭曲裂隙生成器。從不穩定的虛無行者身上收集3個扭曲虛空，帶回斷脊氏族崗哨交給瘋狂的歐卡司。',
  }
},
[10279] = {
  {
    'Para o covil do mestre‡Логово господина‡Zum Hort des Meisters‡지배자의 둥지로‡La caverna del maestro‡La caverna del maestro‡Dans le repaire du maître‡主宰之巢‡前往主人的巢穴',
    nil,
    'Fale com Andormu nas Cavernas do Tempo.‡Поговорите с Андорму в пещерах Времени.‡Sprecht mit Andormu in den Höhlen der Zeit.‡시간의 동굴에 있는 안도르무와 대화해야 합니다.‡Habla con Andormu en las Cavernas del Tiempo.‡Habla con Andormu en las Cavernas del Tiempo.‡Parlez à Andormu dans les Grottes du temps.‡与时光之穴的安多尔姆谈一谈。‡與時光之穴的安杜姆談談。',
  }
},
[10280] = {
  {
    'Entrega especial para Shattrath‡Специальный груз в город Шаттрат‡Sonderlieferung nach Shattrath‡샤트라스로 특별 배달‡Una entrega especial a la Ciudad de Shattrath‡Una entrega especial a la Ciudad de Shattrath‡Livraison spéciale à Shattrath‡送往沙塔斯的特殊货物‡給撒塔斯城的特件',
    nil,
    'Entregue o Cristal de Ata\'mal a A\'dal, no Terraço da Luz, em Shattrath.‡Передайте кристалл Ата\'мала А\'далу на террасе Света в городе Шаттрат.‡Bringt den Kristall von Ata\'mal zu A\'dal auf der Terrasse des Lichts in Shattrath.‡샤트라스의 빛의 정원에 있는 아달에게 아타말 수정을 배달해야 합니다.‡Entrega el cristal de Ata\'mal a A\'dal en el Bancal de la Luz en la Ciudad de Shattrath.‡Entrega el cristal de Ata\'mal a A\'dal en el Bancal de la Luz en la Ciudad de Shattrath.‡Apportez le cristal d\'Ata\'mal à A\'dal sur la Terrasse de la Lumière à Shattrath.‡将阿塔玛水晶交给沙塔斯城圣光广场的阿达尔。‡將阿塔莫水晶送交到撒塔斯城的聖光露臺交給阿達歐。',
  }
},
[10281] = {
  {
    'Apresentações formais‡Формальное представление‡Formelle Vorstellung‡격식을 갖춘 인사‡Presentaciones formales‡Presentaciones formales‡Présentation formelle‡正式介绍‡正式自我介紹',
    nil,
    'Encontre Tyri na extremidade norte do Pico Celestial e fale com ela.‡Найдите Тири на северной оконечности Небесной гряды и поговорите с ней.‡Sucht Tyri am nördlichen Ende des Sternensturzes und sprecht mit ihr.‡하늘 마루의 북쪽 끝에서 타이리를 찾아 대화하십시오.‡Encuentra a Tyri en el extremo norte de Cresta Celestial.‡Encuentra a Tyri en el extremo norte de Cresta Celestial.‡Retrouvez Tyri à la pointe nord de la Crête céleste et allez lui parler.‡找到苍穹之脊北端的泰莉，与她谈一谈。‡在天國山脈的北端找到泰利並與她談談。',
  }
},
[10282] = {
  {
    'Antiga Eira dos Montes‡Старый Хилсбрад‡Das alte Hügelland‡옛 힐스브래드‡Antigua Trabalomas‡Antigua Trabalomas‡Hautebrande d\'antan‡往日的希尔斯布莱德‡舊時的希爾斯布萊德',
    nil,
    'Andormu, nas Cavernas do Tempo, lhe conferiu a tarefa de ir até a Antiga Eira dos Montes e falar com Erozion.‡Отправьтесь по тропе времени в старый Хилсбрад и поговорите с Эрозионом.‡Andormu in den Höhlen der Zeit bittet Euch, ins Alte Hügelland zu reisen und mit Erozion zu sprechen.‡시간의 동굴에 있는 안도르무가 옛 힐스브래드로 가서 에로지온과 대화해 달라고 부탁했습니다.‡Andormu de las Cavernas del Tiempo quiere que vayas a la Antigua Trabalomas para hablar con Erozion.‡Andormu de las Cavernas del Tiempo quiere que vayas a la Antigua Trabalomas para hablar con Erozion.‡Andormu des Grottes du temps vous demande de vous aventurer dans le Hautebrande d\'antan et d\'aller voir Erozion.‡时光之穴的安多尔姆要求你进入旧希尔斯布莱德丘陵，与伊洛希恩谈一谈。‡時光之穴的安杜姆要你到希爾斯布萊德丘陵去跟伊洛森談談。',
  }
},
[10283] = {
  {
    'Distração de Taretha‡План Тареты‡Tarethas Ablenkungsmanöver‡타레사의 작전‡La maniobra de Taretha‡La maniobra de Taretha‡La diversion de Taretha‡塔蕾莎的计谋‡塔蕾莎的聲東擊西',
    nil,
    'Vá ao Forte do Desterro e prepare 5 cargas incendiárias nos barris encontrados dentro dos campos de prisioneiros, usando a Carga de Bombas Incendiárias que Erozion lhe deu.|n|nFale com Thrall na prisão do porão do Forte do Desterro quando tiver incendiado os alojamentos.‡Проберитесь в крепость Дарнхольд и заложите пять зажигательных бомб возле бочек внутри каждого из бараков на выселках. Используйте упаковку зажигательных бомб, полученных от Эрозиона.|n|nПосле того как подожжете бараки, разыщите Тралла в подземной темнице.‡Reist zur Burg Durnholde und platziert mithilfe des Bündels mit Brandbomben, das Ihr von Erozion erhalten habt, 5 Brandsätze auf den Fässern in jeder Internierungsbaracke.|n|nSprecht mit Thrall im Kellergefängnis der Burg Durnholde, wenn Ihr die Internierungsbaracken angezündet habt.‡던홀드 요새로 가서 에로지온이 준 화염 폭탄 자루를 사용하여 모든 수용소의 안에 있는 맥주통에 화염 폭탄을 5개씩 설치해야 합니다.|n|n수용소를 다 불태웠으면 던홀드 요새의 지하 감옥에 있는 스랄과 대화하십시오.‡Ve al Castillo de Durnholde y coloca 5 cargas incendiarias del paquete de bombas incendiarias que te dio Erozion en los barriles que hay en cada pabellón de internamiento.|n|nDespués habla con Thrall en la prisión subterránea del castillo.‡Ve al Castillo de Durnholde y coloca 5 cargas incendiarias del paquete de bombas incendiarias que te dio Erozion en los barriles que hay en cada pabellón de internamiento.|n|nDespués habla con Thrall en la prisión subterránea del castillo.‡Rendez-vous au bastion de Fort-de-Durn et placez 5 charges incendiaires dans les tonneaux situés dans chacun des pavillons d\'internement grâce au Paquet de bombes incendiaires qui vous a été donné par Erozion.|n|nParlez à Thrall dans les oubliettes du bastion de Fort-de-Durn une fois les Pavillons d\'internement incendiés.‡进入敦霍尔德城堡，将伊洛希恩交给你的燃烧弹包分别放入5间收容所内的木桶，并启动定时装置。|n|n引爆燃烧弹后，与被关押在敦霍尔德城堡地牢中的萨尔谈一谈。‡前往敦霍爾德城堡，使用伊洛森交給你的燃燒炸彈包裹在每一個拘留守衛室裡的桶中放置5個燃燒炸藥。|n|n當你引爆拘留守衛室後，與敦霍爾德城堡地牢裡的索爾談談。',
  }
},
[10284] = {
  {
    'A fuga do Forte do Desterro‡Побег из Дарнхольда‡Flucht aus Durnholde‡던홀드 탈출‡Huida de Durnholde‡Huida de Durnholde‡Évasion de Fort-de-Durn‡逃离敦霍尔德‡逃離敦霍爾德',
    nil,
    'Quando estiver pronto para continuar, avise Thrall. Siga-o e ajude-o a libertar Taretha e a cumprir o destino dele.|n|nFale com Erozion na Antiga Eira dos Montes caso tenha sucesso nesta missão.‡Когда вы будете готовы идти, сообщите об этом Траллу. Помогите ему бежать из крепости Дарнхольд, освободить Тарету и исполнить свое предназначение.|n|nПосле этого возвращайтесь к Эрозиону в Старый Хилсбрад.‡Gebt Thrall Bescheid, wenn Ihr bereit seid. Folgt Thrall aus der Burg Durnholde und helft ihm, Taretha zu befreien und sein Schicksal zu erfüllen.|n|nSprecht mit Erozion im Alten Hügelland, wenn Ihr diese Aufgabe erfüllt habt.‡준비가 되면 스랄에게 알려준 후, 던홀드 요새에서 스랄을 따라나가 그가 타레사를 구출하고 운명을 실현할 수 있도록 도와야 합니다.|n|n이 임무를 완수하면 옛 힐스브래드에 있는 에로지온과 대화해야 합니다.‡Cuando estés listo para proceder, díselo a Thrall. Sigue a Thrall al exterior del Castillo de Durnholde y ayúdale a liberar a Taretha y así cumplir su destino.|n|nHabla con Erozion en Antigua Trabalomas cuando completes esta tarea.‡Cuando estés listo para proceder, díselo a Thrall. Sigue a Thrall al exterior del Castillo de Durnholde y ayúdale a liberar a Taretha y así cumplir su destino.|n|nHabla con Erozion en Antigua Trabalomas cuando completes esta tarea.‡Faites signe à Thrall lorsque vous serez prêt à continuer. Suivez-le dans son évasion du bastion de Fort-de-Durn et aidez-le à libérer Taretha et à accomplir son destin.|n|nAllez parler à Erozion au Hautebrande d\'antan si vous parvenez à accomplir cette tâche.‡准备就绪后告知萨尔。保护萨尔逃离敦霍尔德城堡，并与他一起搭救塔蕾莎。|n|n任务完成后与旧希尔斯布莱德丘陵的伊洛希恩谈一谈。‡當你準備開始時，讓索爾知道。跟著索爾離開敦霍爾德城堡，並協助他釋放塔蕾莎以及完成他的天命。|n|n任務完成後到希爾斯布萊德找伊洛森談談。',
  }
},
[10285] = {
  {
    'Reencontro com Andormu‡Возвращение к Андорму‡Rückkehr zu Andormu‡안도르무에게 돌아가기‡Regresa junto a Andormu‡Regresa junto a Andormu‡Retour vers Andormu‡返回安多尔姆身边‡回去安杜姆身邊',
    nil,
    'Fale novamente com a criança Andormu nas Cavernas do Tempo, que ficam no deserto de Tanaris.‡Возвращайтесь к маленькому Андорму в Пещеры Времени.‡Kehrt zu dem jungen Andormu in den Höhlen der Zeit in Tanaris zurück.‡타나리스의 시간의 동굴에 있는 어린 안도르무에게 돌아가야 합니다.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Retournez voir le jeune dragon, Andormu, aux Grottes du temps dans le désert de Tanaris.‡返回塔纳利斯沙漠的时光之穴，向幼时的安多尔姆复命。‡回去塔納利斯沙漠的時光之穴找小孩安杜姆 。',
  }
},
[10286] = {
  {
    'O segredo de Arelion‡Тайна Арелиона‡Arelions Geheimnis‡아렐리온의 비밀‡El secreto de Arelion‡El secreto de Arelion‡Le secret d\'Arelion‡埃雷利恩的秘密‡阿利恩的秘密',
    nil,
    'A Magistra Carinda quer que você interrogue o Magíster Aledis, visto pela última vez indo da Vigília do Falcão para o Pântano Zíngaro.‡Расспросите магистра Аледиса, которого в последний раз видели отправляющимся из Соколиного дозора в Зангартопь, по требованию магистра Каринды.‡Magistrix Carinda möchte, dass Ihr Magister Aledis befragt. Aledis wurde zuletzt auf einer Reise von der Falkenwacht zu den Zangarmarschen gesehen.‡마법학자 카린다가 마법학자 알레디스를 심문해 달라고 부탁했습니다. 마지막으로 봤을 때 그는 매의 감시탑에서 장가르 습지대를 향해서 여행을 하던 중이었다고 합니다.‡La magistrix Carinda quiere que interrogues al magister Aledis, que salió de la Avanzada del Halcón en dirección a la Marisma de Zangar.‡La magistrix Carinda quiere que interrogues al magister Aledis, que salió de la Avanzada del Halcón en dirección a la Marisma de Zangar.‡La magistrice Carinda veut que vous interrogiez le magistère Aledis, qui a été vu pour la dernière fois quittant le Guet de l\'épervier pour se rendre dans le marécage de Zangar.‡魔导师卡尔琳达要你审问魔导师阿利迪斯，他已经离开猎鹰岗哨，往赞加沼泽的方向去了。‡博學者卡莉達要你詢問博學者阿勒迪斯，據說有人看到他從獵鷹哨站前往贊格沼澤。',
  }
},
[10287] = {
  {
    'A amante revelada‡Кем оказалась любовница‡Die enttarnte Geliebte‡그녀의 정체‡Amante descubierta‡Amante descubierta‡La maîtresse dévoilée‡"恋人"曝光‡情婦曝光',
    nil,
    'Fale novamente com a Magistra Carinda, na Vigília do Falcão, que fica na Península Fogo do Inferno.‡Возвращайтесь к магистру Каринде в Соколиный Дозор, что на Полуострове Адского Пламени.‡Kehrt zu Magistrix Carinda in die Falkenwacht auf der Höllenfeuerhalbinsel zurück.‡지옥불 반도의 매의 감시탑에 있는 마법학자 카린다에게 돌아가야 합니다.‡Ve a ver a la magistrix Carinda a la Avanzada del Halcón en la Península del Fuego Infernal.‡Ve a ver a la magistrix Carinda a la Avanzada del Halcón en la Península del Fuego Infernal.‡Retournez voir la magistrice Carinda au Guet de l\'épervier, à la Péninsule des Flammes infernales.‡向地狱火半岛猎鹰岗哨的魔导师卡尔琳达复命。‡到地獄火半島的獵鷹哨站找博學者卡莉達。',
  }
},
[10288] = {
  {
    'Chegada em Terralém‡Прибытие в Запределье‡Ankunft in der Scherbenwelt‡아웃랜드 도착‡Llegada a Terrallende‡Llegada a Terrallende‡Arrivée en Outreterre‡抵达外域‡抵達外域',
    nil,
    'O Comandante Durão, no Portal Negro da Península Fogo do Inferno, quer que você leve o Relatório de Durão para Emílio Martelo Feroz.‡Доставьте донесение Дарона Амишу Громовому Молоту по приказу командира Дарона у Темного портала на полуострове Адского Пламени.‡Kommandant Duron beim Dunklen Portal auf der Höllenfeuerhalbinsel möchte, dass Ihr Durons Bericht zu Flugmeister Amish Wildhammer bringt.‡지옥불 반도의 어둠의 문에 있는 지휘관 두론이 아미쉬 와일드해머에게 두론의 보고서를 전해 달라고 부탁했습니다.‡El comandante Duron de El Portal Oscuro en la Península del Fuego Infernal quiere que entregues su informe a Amish Martillo Salvaje.‡El comandante Duron de El Portal Oscuro en la Península del Fuego Infernal quiere que entregues su informe a Amish Martillo Salvaje.‡Le commandant Duron à la Porte des ténèbres dans la péninsule des Flammes infernales veut que vous apportiez le Rapport de Duron à Amish Marteau-hardi.‡地狱火半岛上黑暗之门的指挥官杜隆要求你将杜隆的报告交给阿米什·蛮锤。‡地獄火半島的黑暗之門的指揮官杜朗要你將杜朗的報告送到艾米思·蠻錘的手中。',
  }
},
[10289] = {
  {
    'Viagem a Thrallmar‡Путешествие в Траллмар‡Reise nach Thrallmar‡스랄마로의 여정‡Viaje a Thrallmar‡Viaje a Thrallmar‡En route pour Thrallmar‡萨尔玛之旅‡前往索爾瑪',
    nil,
    'Vá a Thrallmar usando a Mantícora de Vlagga Freipena. Leve o Relatório de Órion para o General Krakork.‡Долетите на ветрокрыле Влагги Легкоперой в Траллмар. Доставьте донесение Ориона генералу Кракорку.‡Nehmt Vlagga Freyfeders Windreiter nach Thrallmar. Bringt Orions Bericht zu General Krakork.‡블라가 프레이페더의 와이번을 타고 스랄마로 가야 합니다. 사령관 크라콜크에게 오리온의 보고서를 가져가십시오.‡Lleva el jinete del viento de Vlagga Plumacalma a Thrallmar. Entrega el informe de Orion al general Krakork.‡Lleva el jinete del viento de Vlagga Plumacalma a Thrallmar. Entrega el informe de Orion al general Krakork.‡Voyagez sur le coursier du vent de Vlagga Fileplume jusqu\'à Thrallmar. Apportez le Rapport d\'Orion au général Krakork.‡乘坐维拉加·乱羽的双足飞龙前往萨尔玛，并将沃雷恩的报告交给克拉库克将军。‡搭乘法拉格·伏瑞菲德的雙足飛龍到索爾瑪。將歐萊恩的報告交給克洛克爾克將軍。',
  }
},
[10290] = {
  {
    'Em busca de faralita‡В поисках фаралита‡Auf der Suche nach Farahlit‡파랄라이트를 찾아서‡Buscando faralita‡Buscando faralita‡En quête de farahlite‡寻找法兰石‡尋找法拉萊特',
    nil,
    'Colete 4 peças de Faralita Bruta e fale novamente com Zuben Elgenubi, no Pináculo da Tempestade.‡Соберите 4 куска сырого фаралита и вернитесь к Зубену Элгенуби в Штормовую Вершину.‡Sammelt 4 Stück Rohfarahlit und kehrt dann zu Zuben Elgenubi in der Sturmsäule zurück.‡천연 파랄라이트 4개를 수집한 후 폭풍 첨탑에 있는 주벤 엘게누비에게 돌아가십시오.‡Recolecta 4 piezas de faralita en bruto y llévaselas a Zuben Elgenubi a La Flecha de la Tormenta.‡Recolecta 4 piezas de faralita en bruto y llévaselas a Zuben Elgenubi a La Flecha de la Tormenta.‡Récoltez 4 morceaux de Farahlite brute et retournez voir Zuben Elgenubi à la Foudreflèche.‡收集4块天然法兰石，将它们交给风暴尖塔的伊格努比。‡收集四個天然法拉萊特然後交給風暴之尖的祖班·艾貞努比。',
  }
},
[10291] = {
  {
    'Apresente-se a Nazgrel‡Донесение Назгрелу‡Bericht an Nazgrel‡나즈그렐에게 보고‡Informar a Nazgrel‡Informar a Nazgrel‡Se présenter à Nazgrel‡向纳兹格雷尔报到‡回報納茲格雷爾',
    nil,
    'O General Krakork, em Thrallmar, quer que você fale com Nazgrel.‡Поговорите с Назгрелом по приказу генерала Кракорка из Траллмара.‡General Krakork in Thrallmar möchte, dass Ihr mit Nazgrel sprecht.‡스랄마에 있는 사령관 크라콜크가 나즈그렐과 대화하라고 부탁했습니다.‡El general Krakork en Thrallmar quiere que hables con Nazgrel.‡El general Krakork en Thrallmar quiere que hables con Nazgrel.‡Le général Krakork de Thrallmar veut que vous parliez à Nazgrel.‡萨尔玛的克拉库克将军要求你向纳兹格雷尔报到。‡索爾瑪的克洛克爾克將軍要你去跟納茲格雷爾談話。',
  }
},
[10292] = {
  {
    'More Power!‡Больше энергии!‡Mehr Energie!‡더욱 강력한 힘!‡¡Más potencia!‡¡Más potencia!‡Plus de puissance !‡更多能量！‡更多的能源!',
    nil,
    'Zuben Elgenubi wants you to capture 8 Legion Cannon and bring them back to the Stormspire.‡Зубен Элгенуби хочет, чтобы вы захватили 8 пушек Легиона и принесли их в Штормовую Вершину.‡Zuben Elgenubi möchte, dass Ihr 8 Schusswaffen der Legion besorgt und sie zur Sturmsäule bringt.‡주벤 엘게누비가 불타는 군단 대포 8개를 입수해서 폭풍 첩탑으로 가져다 달라고 부탁했습니다.‡Zuben Elgenubi quiere que captures 8 cañones de la Legión y se los lleves a La Flecha de la Tormenta.‡Zuben Elgenubi quiere que captures 8 cañones de la Legión y se los lleves a La Flecha de la Tormenta.‡Zuben Elgenubi veut que vous preniez 8 Canons de la Légion et que vous les rapportiez à la Foudreflèche.‡伊格努比要你将8尊军团火炮带回风暴尖塔。‡祖班·艾貞努比要你去取得8座軍團火砲並將這些火砲帶回風暴之尖。',
  }
},
[10293] = {
  {
    'Eis o manancial‡Попасть на главную жилу‡Die Kristallader anzapfen‡크랙스카르 처치‡A por la veta‡A por la veta‡Toucher le Gros-lot‡完美的水晶‡摘下母礦',
    nil,
    'Zuben Elgenubi, no Pináculo da Tempestade, quer que você obtenha um Núcleo de Faralita.‡Зубен Элгенуби, находящийся в Штормовой Вершине, хочет, чтобы вы добыли фаралитовую сердцевину.‡Zuben Elgenubi in der Sturmsäule möchte, dass Ihr einen Farahlitkern besorgt.‡폭풍 첨탑에 있는 주벤 엘게누비가 파랄라이트 핵을 1개 입수해 달라고 부탁했습니다.‡Zuben Elgenubi de La Flecha de la Tormenta quiere que le lleves un núcleo de faralita.‡Zuben Elgenubi de La Flecha de la Tormenta quiere que le lleves un núcleo de faralita.‡Zuben Elgenubi de la Foudreflèche veut que vous vous procuriez un Noyau de farahlite.‡风暴尖塔的伊格努比要你取回一个法兰石核心。‡風暴之尖的祖班·艾貞努比要你取得一個法拉萊特核心。',
  }
},
[10294] = {
  {
    'Escarpa do caos‡Пустынный обрыв‡Der Leerengrat‡공허의 마루‡La Cresta del Vacío‡La Cresta del Vacío‡La crête du Vide‡虚空山脉‡虛無之脊',
    nil,
    'Vá até a Escarpa do Caos e mate as criaturas que encontrar lá. Colete 40 Estilhaços de Alma na Escarpa do Caos e leve-os para Ogath, o Louco, no Acampamento Quebra-espinha.‡Отправляйтесь на Пустынный обрыв и убейте существ, которые там обитают. Соберите 40 осколков душ Пустынного обрыва и возвращайтесь к Огафу Безумному на Заставу Хребтолома.‡Geht zum Leerengrat und tötet die Kreaturen, die Ihr dort findet. Sammelt 40 Seelensplitter des Leerengrats und kehrt dann zu Ogath dem Verrückten im Rückenbrecherposten zurück.‡공허의 마루로 가서 눈에 보이는 생명체들을 처치해야 합니다. 공허의 마루 영혼의 조각 40개를 모아서 해골망치 초소에 있는 미치광이 오가스에게 가져가야 합니다.‡Ve a la Cresta del Vacío y mata las criaturas que encuentres. Recolecta 40 fragmentos de alma de la Cresta del Vacío y llévaselos a Ogath el Loco, en la Avanzada Rompeloma.‡Ve a la Cresta del Vacío y mata las criaturas que encuentres. Recolecta 40 fragmentos de alma de la Cresta del Vacío y llévaselos a Ogath el Loco, en la Avanzada Rompeloma.‡Allez sur la crête du Vide et tuez les créatures que vous y trouverez. Réunissez 40 Éclats d\'âme de la crête du Vide et apportez-les à Ogath le Fol au Poste de Brise-échine.‡前往虚空山脉杀死当地的生物。收集40块虚空山脉灵魂碎片，把它们交给断背岗哨的疯狂的欧加斯。‡去虛無山脈並且殺死你找到的生物。收集40個虛無山脈靈魂裂片，並且交給斷脊氏族崗哨的瘋狂的歐卡司。',
  }
},
[10295] = {
  {
    'Do abismo‡Сила бездны‡Aus dem Abgrund‡심연에서...‡Desde el abismo‡Desde el abismo‡Du fond des abysses‡来自深渊‡來自深淵',
    nil,
    'Mate o Barão do Caos Galaxis e colete o Estilhaço de Alma. Leve o estilhaço para Ogath, o Louco, no Acampamento Quebra-espinha.‡Убейте Барона Бездны Галаксиса и добудьте осколок его души. Принесите осколок души Огафу Безумному на Заставу Хребтолома.‡Tötet Galaxis und sammelt seinen Seelensplitter. Bringt den Splitter zu Ogath dem Verrückten im Rückenbrecherposten.‡공허의 남작 갈락시스를 처치하고 그의 영혼의 조각을 해골망치 초소에 있는 미치광이 오가스에게 가져가십시오.‡Mata al barón del vacío Galaxis y recolecta un fragmento de su alma. Llévale el fragmento a Ogath el Loco en la Avanzada Rompeloma.‡Mata al barón del vacío Galaxis y recolecta un fragmento de su alma. Llévale el fragmento a Ogath el Loco en la Avanzada Rompeloma.‡Tuez le baron du Vide Galaxis et récupérez l\'Éclat de son âme. Apportez l\'éclat à Ogath le Fol au Poste de Brise-échine.‡杀死虚空男爵加拉希斯，并得到他的灵魂碎片，把它交给断背岗哨的疯狂的欧加斯。‡殺掉虛無男爵加倫希斯並收集他的靈魂裂片，將這個裂片帶給斷脊氏族崗哨的瘋狂的歐卡司。',
  }
},
[10296] = {
  {
    'Lamaçal Negro‡Черные топи‡Der schwarze Morast‡검은늪‡La Ciénaga Negra‡La Ciénaga Negra‡Le Noir Marécage‡黑色沼泽‡黑色沼澤',
    nil,
    'Viaje pelas Cavernas do Tempo até o Lamaçal Negro durante a abertura do Portal Negro e fale com Sa\'at.‡Пройдите сквозь Пещеры времени до Черных топей времен открытия Темного портала и поговорите с Са\'атом.‡Reist durch die Höhlen der Zeit in den schwarzen Morast während der Öffnung des Dunklen Portals und sprecht mit Sa\'at.‡시간의 동굴을 지나 검은늪으로 가서 어둠의 문이 열리는 동안 사트와 대화해야 합니다.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Viaja por las Cavernas del Tiempo hasta la Ciénaga Negra mientras esté abierto El Portal Oscuro y habla con Sa\'at.‡Voyagez à travers les Grottes du temps jusqu\'au Noir Marécage pendant l\'ouverture de la Porte des ténèbres et parlez à Sa\'at.‡深入时光之穴，前往正在发生黑暗之门开启这一历史事件的黑色沼泽，与萨艾特谈一谈。‡在黑暗之門開啟的期間經由穿越時光之穴到達黑色沼澤，並與塞特交談。',
  }
},
[10297] = {
  {
    'A abertura do Portal Negro‡Открытие Темного портала‡Die Öffnung des Dunklen Portals‡어둠의 문 열기‡La apertura de El Portal Oscuro‡La apertura de El Portal Oscuro‡L\'ouverture de la Porte des ténèbres‡开启黑暗之门‡黑暗之門的開啟',
    nil,
    'Sa\'at, dentro do Lamaçal Negro das Cavernas do Tempo, lhe conferiu a tarefa de defender Medivh enquanto ele abre o Portal Negro.|n|nFale novamente com Sa\'at caso tenha sucesso nesta missão.‡Защищайте Медива, пока он не откроет Темный портал.|n|nКогда выполните задание, возвращайтесь к Са\'ату в Черные топи.‡Sa\'at im schwarzen Morast der Höhlen der Zeit möchte, dass Ihr Medivh verteidigt, bis er das Dunkle Portal geöffnet hat.|n|nKehrt zu Sa\'at zurück, wenn Ihr erfolgreich wart.‡시간의 동굴의 검은늪 내에 있는 사트가 수호자 메디브가 어둠의 문을 여는 데 성공할 때까지 메디브를 방어하라는 임무를 주었습니다.|n|n임무에 성공하면 사트에게 돌아가야 합니다.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.|n|nVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at en la Ciénaga Negra de las Cavernas del Tiempo te ha encargado que defiendas a Medivh hasta que consiga abrir El Portal Oscuro.|n|nVuelve junto a Sa\'at si consigues completar esta tarea.‡Sa\'at, à l\'intérieur du Noir Marécage des Grottes du temps, vous a demandé de défendre Medivh jusqu\'à ce qu\'il parvienne à ouvrir la Porte des ténèbres.|n|nRetournez voir Sa\'at si vous parvenez à accomplir cette tâche.‡时光之穴黑色沼泽的萨艾特要求你保护麦迪文，直到他成功开启黑暗之门。|n|n任务完成后向萨艾特复命。‡在時光之穴的黑色沼澤裡的塞特已給予你保護麥迪文直到他成功打開黑暗之門的任務。|n|n任務完成後，回到塞特那裡。',
  }
},
[10298] = {
  {
    'Herói da prole‡Герой драконьего племени‡Held des Schwarms‡종족의 영웅‡Adalid del linaje‡Adalid del linaje‡Héros de la progéniture‡龙族的英雄‡世代的拯救者',
    nil,
    'Fale novamente com a criança, Andormu, nas Cavernas do Tempo no deserto de Tanaris.‡Возвращайтесь к маленькому Андорму в пустыню Танарис в Пещерах Времени.‡Kehrt zum Kind, Andormu, in den Höhlen der Zeit in Tanaris zurück.‡타나리스의 시간의 동굴에 있는 어린 안도르무에게 돌아가야 합니다.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Regresa junto al niño, Andormu, en las Cavernas del Tiempo, en el Desierto de Tanaris.‡Retournez voir l\'enfant, Andormu, aux Grottes du temps dans le désert de Tanaris.‡返回塔纳利斯沙漠的时光之穴，向幼时的安多尔姆复命。‡回去塔納利斯沙漠的時光之穴找安杜姆。',
  }
},
[10299] = {
  {
    'Desativar Manaforja B\'naar‡Отключить манагорн Б\'наар‡Manaschmiede B\'naar abschalten‡브나르 마나 괴철로 차단‡El cierre de la Forja de Maná B\'naar‡El cierre de la Forja de Maná B\'naar‡Extinction de la manaforge B\'naar‡关闭法力熔炉：布纳尔‡關閉法力熔爐巴納爾',
    nil,
    'Volte a Manaforja B\'naar e obtenha o Cristal de Acesso de B\'naar do Feitor Theredis. Use-o no Painel de Controle de B\'naar para desligá-la e, em seguida, apresente-se novamente a Anacoreta Karja.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Вернитесь в манагорн Б\'наар и заберите кристалл доступа у надзирателя Тередиса. Используйте его на панели управления манагорна, чтобы выключить его, затем сообщите об этом анахорету Карже. |n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Karja möchte, dass Ihr in die Manaschmiede B\'naar geht und einen Zugangskristall von Vorarbeiter Theredis besorgt. Benutzt ihn bei der Steuerkonsole von B\'naar, um sie abzuschalten und meldet Euch danach bei Anachoret Karja zurück.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡브나르 마나괴철로로 돌아가서 감독관 테레디스에게서 브나르 장치 접근 수정을 입수한 후, 수정을 사용하여 브나르 마나괴철로 제어장치를 차단하고 수도사 카르자에게 돌아가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná B\'naar para coger un cristal de acceso del sobrestante Theredis. Úsalo en la consola de la Forja de Maná B\'naar para cerrarla y ve a informar a la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Vuelve a la Forja de Maná B\'naar para obtener un cristal de acceso del sobrestante Theredis. Úsalo en la consola de la Forja de Maná B\'naar para cerrarla y ve a informar a la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Retournez à la manaforge B\'naar et prenez le Cristal d\'accès de B\'naar au Surveillant Theredis. Utilisez-le à la console de contrôle de la manaforge B\'naar pour l\'éteindre et faites votre rapport à l\'anachorète Karja.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡返回法力熔炉：布纳尔，从工头瑟瑞狄斯手中夺得布纳尔控制水晶。使用水晶关闭法力熔炉：布纳尔控制台，然后向学者卡尔亚复命。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡回到法力熔爐巴納爾從監督者瑞爾迪斯身上取得巴納爾控制水晶。使用它來關閉法力熔爐巴納爾控制臺然後回報隱士卡爾加。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10300] = {
  {
    'A restauração do cajado‡Восстановление посоха‡Den Stab wiederherstellen‡지팡이 수리‡Reconstrucción del bastón‡Reconstrucción del bastón‡La reconstruction du bâton‡修复法杖‡重鑄法杖',
    nil,
    'Obtenha quatro Estilhaços de Cristal Impecáveis dos fantasmas das Ruínas Enkaat e fale novamente com Ravandwyr, na Área 52.‡Заберите 4 осколка безупречного кристалла у призраков в руинах Энкаата и принесите Равандвиру в Зону 52.‡Besorgt 4 fehlerlose Kristallsplitter von den Geistern in den Ruinen von Enkaat und bringt sie zu Ravandwyr in Area 52.‡엔카트 폐허에 있는 유령들로부터 완전무결한 수정 조각 4개를 구하여 52번 구역에 있는 라반드위르에게 돌아가야 합니다.‡Consigue 4 fragmentos de cristal perfectos de los fantasmas de las Ruinas de Enkaat y llévaselos a Ravandwyr en el Área 52.‡Consigue 4 fragmentos de cristal perfectos de los fantasmas de las Ruinas de Enkaat y llévaselos a Ravandwyr en el Área 52.‡Obtenez 4 Éclats de cristal sans défaut sur les fantômes des ruines d\'Enkaat et rapportez-les à Ravandwyr dans la Zone 52.‡从恩卡特废墟的鬼魂身上收集4块无瑕的水晶碎片，将它们交给52区的拉文德维尔。‡從安卡特廢墟的鬼魂身上取回4個無瑕水晶裂片並且交給52區的羅樊德威。',
  }
},
[10301] = {
  {
    'O compêndio destrancado‡Открыть Компендиум‡Das Kompendium öffnen‡개론의 비밀‡Abrir el Compendio‡Abrir el Compendio‡Déverrouiller le compendium‡魔法纲要的防护‡開啟手冊',
    nil,
    'Obtenha o Monóculo Heliotrópico da Enfeitiçadora Marathelle, no Acampamento Solfúria.‡Заберите Халцедоновое око у Рушительницы Чар Маратиль, находящейся в Форте Ярости Солнца.‡Besorgt Euch das heliotrope Oculus von Zauberhäscherin Marathelle im Sonnenzornposten.‡성난태양 주둔지에 있는 주문강탈자 마라텔로부터 진보랏빛 단안경을 입수해야 합니다.‡Consigue el óculo de heliotropo de la atracahechizos Marathelle en el Bastión Furia del Sol.‡Consigue el óculo de heliotropo de la atracahechizos Marathelle en el Bastión Furia del Sol.‡Prenez l\'Oculus héliotrope à la Saccage-sort Marathelle au bastion des Solfurie.‡从日怒堡的掠法者玛拉瑟雷手中夺得紫色单片眼镜。‡從日怒要塞的法術劫奪者瑪拉希歐身上取得紫羅蘭之目。',
  }
},
[10302] = {
  {
    'Mutações voláteis‡Неустойчивые мутации‡Unberechenbare Mutanten‡갑작스럽게 생겨난 돌연변이‡Mutaciones volátiles‡Mutaciones volátiles‡Mutations volatiles‡暴躁的变异体‡暴躁突變者',
    nil,
    'Mate 8 Mutações Voláteis e fale com a Botânica Taerix no Ponto de Impacto, que fica no Vale Ammen.‡Убейте 8 неустойчивых мутаций и вернитесь к ботанику Таэрикс на месте крушения в долине Аммен.‡Tötet 8 unberechenbare Mutanten und kehrt dann zu Botanikerin Taerix bei der Absturzstelle im Am\'mental zurück.‡갑작스럽게 생겨난 돌연변이 8마리를 처치한 후 암멘 골짜기의 추락 지점에 있는 식물학자 태릭스에게 돌아가야 합니다.‡Mata 8 mutaciones volátiles y ve a ver a la botánica Taerix al Lugar del Accidente en el Valle Ammen.‡Mata 8 mutaciones volátiles y ve a ver a la botánica Taerix al Lugar del Accidente en el Valle Ammen.‡Tuez 8 Mutations volatiles, puis retournez voir la botaniste Taerix au Point d\'impact dans le val d\'Ammen.‡杀死8个暴躁的变异体，然后向埃门谷坠毁点的植物学家塔蕾克丝复命。‡殺死8個暴躁突變者，然後返回安曼谷的失事地點的植物學家泰瑞茲那裡。',
  }
},
[10303] = {
  {
    'Os elfos sangrentos‡Эльфы крови‡Die Blutelfen‡블러드 엘프‡Los elfos de sangre‡Los elfos de sangre‡Les elfes de sang‡血精灵‡血精靈',
    nil,
    'Mate 10 Batedores Elfos Sangrentos. Em seguida, fale com Tolaan na Serra das Sombras, que fica no Vale Ammen.‡Убейте 10 эльфов крови – разведчиков и вернитесь к Толаану на хребет Теней в долине Аммен.‡Tötet 10 Blutelfenspäher und kehrt dann zu Tolaan im Schattenkamm im Am\'mental zurück.‡블러드 엘프 정찰병 10명을 처치한 후 암멘 골짜기의 어둠 마루에 있는 톨란에게 돌아가야 합니다.‡Mata a 10 exploradores elfos de sangre y ve a ver a Tolaan a la Cresta de las Sombras en el Valle Ammen.‡Mata a 10 exploradores elfos de sangre y ve a ver a Tolaan a la Cresta de las Sombras en el Valle Ammen.‡Tuez 10 Eclaireurs elfes de sang, puis retournez voir Tolaan sur l\'Ombrecrête du val d\'Ammen.‡杀死10个血精灵斥候，然后向埃门谷暗影山的图兰复命。‡殺死10個血精靈斥候，然後返回安曼谷裡暗影山脊的托蘭那裡。',
  }
},
[10304] = {
  {
    'O vindicante Aldar‡Воздаятель Алдар‡Verteidiger Aldar‡구원자 알다르‡El vindicador Aldar‡El vindicador Aldar‡Le redresseur de torts Aldar‡守备官奥达尔‡復仇者艾德',
    nil,
    'Fale com o Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Поговорите с воздаятелем Алдаром на месте крушения в долине Аммен.‡Sprecht mit Verteidiger Aldar bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 구원자 알다르와 대화해야 합니다.‡Habla con el vindicador Aldar en el Lugar del Accidente en el Valle Ammen.‡Habla con el vindicador Aldar en el Lugar del Accidente en el Valle Ammen.‡Parlez au redresseur de torts Aldar au point d\'impact au val d\'Ammen.‡与埃门谷坠毁点的守备官奥达尔谈一谈。‡與安曼谷裡失事地點的復仇者艾德談談。',
  }
},
[10305] = {
  {
    'Abjurante Belmara‡Клятвопреступница Белмара‡Bannzauberin Belmara‡변절자 벨마라‡Abjuradora Belmara‡Abjuradora Belmara‡L\'abjuriste Belmara‡防御法师贝尔玛拉‡棄絕者貝馬拉',
    nil,
    'Encontre o alojamento da Abjurante Belmara no Estreito do Teurgo e retorne o livro à sua estante. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты клятвопреступницы Белмары в переулке Волшебников и верните книгу на полку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Bannzauberin Belmara in der Zaubergasse und bringt das Buch zurück auf seinen Platz im Bücherregal. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 변절자 벨마라의 집으로 고서를 가지고 가서 책장에 놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias de la abjuradora Belmara en el Pasaje del Zahorí y devuelve el libro a la estantería. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias de la abjuradora Belmara en el Pasaje del Zahorí y devuelve el libro a la estantería. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez la maison de l\'abjuriste Belmara dans l\'Allée des sorciers et replacez le livre sur l\'Étagère de livres. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到防御法师贝尔玛拉的住所，将书放回书架上。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到棄絕者貝馬拉在巫師街的所在處然後把書放回他的書櫃。完成後，與肯瑞瓦村莊的管理者戴沃斯談談。',
  }
},
[10306] = {
  {
    'Conjurador Luminrath‡Кудесник Люминрат‡Beschwörer Luminrath‡창조술사 루민라스‡Conjurador Luminrath‡Conjurador Luminrath‡L\'adjurateur Luminrath‡咒术师鲁米拉斯‡咒術師盧瑞斯',
    nil,
    'Encontre o alojamento do Conjurador Luminrath no Estreito do Teurgo e retorne o manto à sua cômoda. Após, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты кудесника Люминрата в переулке Волшебников и верните плащ в его гардероб. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Beschwörer Luminrath in der Zaubergasse und bringt den Mantel zurück in seine Kommode. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 창조술사 루민라스의 집에 가서 그의 옷장에 망토를 돌려 넣어야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias del conjurador Luminrath, en el Pasaje del Zahorí y devuelve la capa a su vestidor. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias del conjurador Luminrath, en el Pasaje del Zahorí y devuelve la capa a su vestidor. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile de l\'adjurateur Luminrath dans l\'allée des sorciers et replacez le mantelet dans sa Commode. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到咒术师鲁米拉斯的住所，将披风放回衣柜里。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到咒術師盧瑞斯在巫師街的所在處並且把披肩放回他的衣櫃。然後，跟肯瑞瓦村莊的管理者戴沃斯談話。',
  }
},
[10307] = {
  {
    'Cohlien Tecegelo‡Кольен Повелитель Льда‡Cohlien Frostwirker‡콜린 프로스트위버‡Cohlien Tejescarcha‡Cohlien Tejescarcha‡Cohlien Tissegivre‡考利恩·霜纹‡考林·織霜者',
    nil,
    'Encontre o alojamento de Cohlien Tecegelo no Estreito do Teurgo e devolva o chapéu ao Armarinho. Depois, fale com o Zelador Dieworth, na Vila Kirin\'Var.‡Найдите апартаменты Кольена Повелителя Льда в переулке Волшебников и верните шляпу на вешалку. Затем поговорите со смотрителем Дайвортом в деревне Кирин\'Вар.‡Sucht die Wohnung von Cohlien Frostwirker in der Zaubergasse und bringt die Kappe zurück in seine Schließkiste. Sprecht danach mit Hüter Dierwert in Kirin\'Var.‡마법사 지구에 있는 콜린 프로스트위버의 방으로 가서 그의 사물함에 모자를 돌려놓아야 합니다. 그런 다음 키린바르 마을에 있는 관리인 디워스와 대화하십시오.‡Encuentra las dependencias de Cohlien Tejescarcha, en el Pasaje del Zahorí y devuelve el sombrero a su baúl. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Encuentra las dependencias de Cohlien Tejescarcha, en el Pasaje del Zahorí y devuelve el sombrero a su baúl. A continuación, habla con el custodio Valemuerte en el Poblado Kirin\'Var.‡Trouvez le domicile de Cohlien Tissegivre dans l\'Allée des sorciers et replacez le chapeau dans sa Cantine. Puis parlez au protecteur Valemort à Kirin\'Var.‡在巫师街内找到考利恩·霜纹的住所，将帽子放回小提箱中。然后与肯瑞瓦村的管理者戴沃斯谈一谈。‡找到考林·織霜者在巫師街的所在處並且把帽子放到它的置物箱裡。然後，跟肯瑞瓦村莊的管理者戴沃斯談話。',
  }
},
[10308] = {
  {
    'Mais destroços etéreos‡Еще одна группа духов Астрала‡Noch ein Hügel voller Astraler‡또 다른 에테리얼 무리‡Otro montón de etéreos‡Otro montón de etéreos‡Un autre monceau d\'éthériens‡更多叛徒的徽记‡另一支以太族勢力',
    nil,
    nil,
  }
},
[10309] = {
  {
    'É um aníquilus, mas tem coração‡Это сквернобот, но у него есть сердце!‡Teufelshäscher mit Herz‡심장이 뛰는 지옥절단기‡Es un atracador vil... pero con corazón‡Es un atracador vil... pero con corazón‡C\'est un saccageur gangrené, mais avec un cœur‡魔能机甲的心跳‡有心臟的惡魔劫奪者',
    nil,
    'Consiga o coração do Aníquilus e leve-o ao Tchunarubleize, nos Destroços, em Eternévoa.‡Заберите сердце сквернобота и отнесите Н. Д. Лагерфелту на Груду в Пустоверти.‡Besorgt das Herz des Teufelshäschers und bringt es zu N. D. Mieskamp beim Hügel im Nethersturm.‡지옥절단기 심장을 찾아서 황천의 폭풍의 고철더미에 있는 N. D. 민캠프에게 가져가야 합니다.‡Recupera el corazón del atracador vil y entrégaselo a N. D. Malcampo en La Pila, en Tormenta Abisal.‡Recupera el corazón del atracador vil y entrégaselo a N. D. Malcampo en La Pila, en Tormenta Abisal.‡Récupérez le Cœur du saccageur gangrené et apportez-le à N. D. Malacamp, au Monceau au Raz-de-Néant.‡将魔能机甲之心交给虚空风暴机甲废场的米西·米恩卡普。‡取回惡魔劫奪者之心，並且把它交付給虛空風暴的聚集之地的閔坎普。',
  }
},
[10310] = {
  {
    'Sabotar o portal!‡Саботаж в портале‡Sabotage am Warptor!‡공간이동 관문 파괴!‡¡Sabotead el portal de distorsión!‡¡Sabotead el portal de distorsión!‡Sabotez le portail dimensionnel !‡破坏迁跃门！‡破壞星移門!',
    nil,
    'Escolte Drijya até o portal do Ponto de Invasão: Destruidor e mantenha-o a salvo, enquanto ele tenta sabotar o portal. Em seguida, fale com Gahruj, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Сопроводите Дризья до точки вторжения: Разрушитель и проследите за безопасностью во время попыток саботажа. Затем поговорите с Гаруджем на заставе в заповеднике "Срединные земли" в Пустоверти.‡Begleitet Drijya zum Warptor beim Invasionspunkt: Zerstörer und sorgt für seine Sicherheit, während er das Tor sabotiert. Sprecht danach mit Gahruj im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡드리지아를 파괴자의 침공 거점의 공간이동 관문까지 호위하고 그가 관문을 파괴하는 동안 그를 안전하게 지켜준 후, 황천의 폭풍의 중앙 생태지구 안에서 중앙 생태지구 주둔지에 있는 가루즈와 대화해야 합니다.‡Escolta a Drijya hasta el portal de distorsión en el Punto de Invasión: Destructor, y cúbrelo mientras intenta sabotearlo. Después habla con Gahruj en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media en Tormenta Abisal.‡Escolta a Drijya hasta el portal de distorsión en el Punto de Invasión: Destructor, y cúbrelo mientras intenta sabotearlo. Después habla con Gahruj en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media en Tormenta Abisal.‡Escortez Drijya jusqu\'au portail dimensionnel au Site d\'invasion Destructeur, et faites en sorte qu\'il reste en sécurité pendant qu\'il tente de le saboter. Puis parlez à Gahruj au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡护送德里亚到达登陆场：破坏的迁跃门，并在他尝试破坏迁跃门的过程中保护他的安全。然后返回虚空风暴的中央生态圆顶，向中央圆顶哨站的加鲁斯复命。‡護送迪耶亞到位於侵略點:摧毀者的星移門，並注意在他破壞門的時候保護他的安全。完成後到虛空風暴上秘境領地裡的領地崗哨找加魯談談。',
  }
},
[10311] = {
  {
    'Drijya precisa de você‡Дризья нужна твоя помощь‡Drijya braucht Eure Hilfe‡도움이 필요한 드리지아‡Drijya necesita tu ayuda‡Drijya necesita tu ayuda‡Drijya a besoin de votre aide‡德里亚需要你的帮助‡迪耶亞需要你的幫助',
    nil,
    'Fale com Drijya próximo do Ponto de Invasão: Destruidor, em Eternévoa.‡Поговорите с Дризья, находящимся около Места Вторжения "Разрушитель" в Пустоверти.‡Sprecht mit Drijya in der Nähe des Invasionspunkts: Zerstörer im Nethersturm.‡황천의 폭풍의 파괴자의 침공 거점 근처에 있는 드리지아와 대화해야 합니다.‡Habla con Drijya cerca del Punto de Invasión: Destructor en Tormenta Abisal.‡Habla con Drijya cerca del Punto de Invasión: Destructor en Tormenta Abisal.‡Parlez à Drijya près du Site d\'invasion Destructeur au Raz-de-Néant.‡与虚空风暴登陆场：破坏的德里亚谈一谈。‡與虛空風暴的侵略點:摧毀者附近的迪耶亞交談。',
  }
},
[10312] = {
  {
    'Os anais de Kirin\'Var‡Анналы Кирин\'Вара‡Die Annalen von Kirin\'Var‡키린바르의 연대기‡Las Crónicas de Kirin\'Var‡Las Crónicas de Kirin\'Var‡Les annales de Kirin\'Var‡肯瑞瓦名册‡肯瑞瓦的記錄',
    nil,
    'Recupere os Anais de Kirin\'Var, na prefeitura da Vila Kirin\'Var, e retorne-os ao Zelador Dieworth.‡Заберите анналы Кирин\'Вара из ратуши деревни Кирин\'Вар и отнесите ее смотрителю Дайворту.‡Besorgt die Annalen von Kirin\'Var aus dem Rathaus von Kirin\'Var und bringt es zu Hüter Dierwert.‡키린바르 마을의 마을회관에서 키린바르 연대기를 되찾은 다음 관리인 디워스에게 돌려 주어야 합니다.‡Recupera las Crónicas de Kirin\'Var en el ayuntamiento del Poblado Kirin\'Var y llévaselas al custodio Valemuerte.‡Recupera las Crónicas de Kirin\'Var en el ayuntamiento del Poblado Kirin\'Var y llévaselas al custodio Valemuerte.‡Récupérez les Annales de Kirin\'Var à l\'hôtel de ville de Kirin\'Var et rapportez-les au protecteur Valemort.‡从肯瑞瓦村的城镇大厅中取回肯瑞瓦名册，将它交给管理者戴沃斯。‡自肯瑞瓦村莊的市政廳取回肯瑞瓦的記錄，並把它歸還給監護者戴沃斯。',
  }
},
[10313] = {
  {
    'Medição de energias dimensionais‡Измерение энергии Искажения‡Warpenergien messen‡초공간 에너지 측정‡Medir energías de distorsión‡Medir energías de distorsión‡Mesurer les énergies dimensionnelles‡测量迁跃能量‡測量扭曲能量',
    nil,
    'O Exarca Orelis, na Área 52, quer que você leve o Orbe Dimensional Harmonizado a Manaforja B\'naar e que o use na extremidade dos quatro tubos.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Экзарх Орелис, находящийся в Зоне 52, просит вас отнести настроенный на энергию искривления шар к манагорну Б\'наар и использовать шар у окончания четырех трубопроводов. |n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Exarch Orelis in Area 52 möchte, dass Ihr die Warpmesskugel zur Manaschmiede B\'naar bringt und sie in der Nähe der vier Rohrleitungen benutzt.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eurer Ehre bei den Sehern.‡52번 구역에 있는 총독 오렐리스가 브나르 마나괴철로에 차원의 힘 측정 구슬을 가져가서 근처에 있는 4개의 수송관로의 끝에 사용해 달라고 부탁했습니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡El exarca Orelis del Área 52 quiere que te lleves el orbe armonizado con la distorsión a la Forja de Maná B\'naar y lo uses al final de sus 4 tuberías.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡El exarca Orelis del Área 52 quiere que te lleves el orbe armonizado con la distorsión a la Forja de Maná B\'naar y lo uses al final de sus 4 tuberías.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'exarque Orelis de la Zone 52 veut que vous emportiez l\'Orbe d\'harmonisation interdimensionnelle à la manaforge B\'naar et que vous l\'utilisiez à l\'extrémité de ses quatre pipelines.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡52区的大主教欧雷里斯要你将迁跃共鸣宝珠带往法力熔炉：布纳尔，并在法力熔炉四条管道的末端使用它。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡52區的主教歐瑞利斯要你帶著不協調寶珠到法力熔爐巴納爾去並將它使用在四條導線的尾端。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10314] = {
  {
    'Suspeita persistente‡Длительные подозрения‡Ein hartnäckiger Verdacht‡사라지지 않는 의구심‡Una sospecha latente‡Una sospecha latente‡Le doute subsiste...‡久远的痕迹‡長久的懷疑',
    nil,
    'Junte 10 Restos Repugnantes dos espíritos corrompidos no pátio da capela da Vila Kirin\'Var e leve-os ao Zelador Dieworth.‡Соберите 10 омерзительных останков искаженных духов во дворе часовни деревни Кирин\'Вар и отнесите их смотрителю Дайворту.‡Sammelt 10 abscheuliche Überreste von den wahnsinnigen Geistern auf dem Kapellenhof in Kirin\'Var und bringt sie zu Hüter Dierwert.‡키린바르 마을의 예배당 지구에 있는 뒤틀린 영혼들로부터 기분 나쁜 잔여물 10개를 수집한 후 관리인 디워스에게 가져가야 합니다.‡Consigue 10 restos repugnantes de los espíritus malignos del Patio de la Capilla del Poblado Kirin\'Var y llévaselos al custodio Valemuerte.‡Consigue 10 restos repugnantes de los espíritus malignos del Patio de la Capilla del Poblado Kirin\'Var y llévaselos al custodio Valemuerte.‡Récupérez 10 Restes répugnants sur les esprits retors de la Cour de la chapelle de Kirin\'Var et apportez-les au protecteur Valemort.‡从肯瑞瓦村礼拜堂广场中扭曲的幽灵身上收集10份令人厌恶的残留物，将它们交给管理者戴沃斯。‡從肯瑞瓦村莊的教堂庭院的扭曲的鬼魂身上收集10個憎惡殘餘並且交給管理者戴沃斯。',
  }
},
[10315] = {
  {
    'Neutralize os etermantes‡Нейтрализовать чародеев Пустоты‡Die Nethermanten neutralisieren‡황천의 추적자 무력화‡Neutralizar a los abisálicos‡Neutralizar a los abisálicos‡Neutraliser les néantomanciens‡消灭虚空法师‡消滅虛空術師',
    nil,
    'Mate 15 Etermantes Solfúria e fale novamente com o Espreitador do Nexus Oazul, no Acampamento do Tuluman, em Eternévoa.‡Убейте 15 пустомантов клана Ярости Солнца и возвращайтесь к ловчему Пустоты Оазулу в Лагерь Тулумана в Пустоверти.‡Tötet 15 Nethermanten des Sonnenzorns und kehrt dann zu Netherpirscher Oazul auf Tulumans Landeplatz im Nethersturm zurück.‡성난태양 황천술사 15명을 처치한 후 황천의 폭풍의 툴루만의 교역지에 있는 황천의 추적자 오아줄에게 돌아가야 합니다.‡Mata a 15 abisálicos Furia del Sol y ve a ver al acechador abisal Oazul al Alto de Tuluman en Tormenta Abisal.‡Mata a 15 abisálicos Furia del Sol y ve a ver al acechador abisal Oazul al Alto de Tuluman en Tormenta Abisal.‡Tuez 15 Néantomanciens solfurie puis retournez voir le traqueur-du-Néant Oazul au Point d\'ancrage de Tuluman au Raz-de-Néant.‡消灭15名日怒虚空法师，然后返回虚空风暴内的图鲁曼的营地，向虚空猎手奥尔苏复命。‡殺死15個日怒虛空術師，並返回虛空風暴之吐魯曼平臺的虛空巡者歐祖爾那裡。',
  }
},
[10316] = {
  {
    'Em busca de evidências‡В поисках доказательств‡Auf der Suche nach Beweisen‡단서 찾기‡En busca de pruebas‡En busca de pruebas‡À la recherche de preuves‡寻找证据‡尋找證據',
    nil,
    'Busque pistas no Pátio da Capela da Vila Kirin\'Var para saber quem está por trás da manipulação dos espíritos.‡Поищите во дворе часовни в деревне Кирин\'Вар свидетельства того, кто именно манипулирует духами убитых.‡Durchsucht die Häuser auf dem Kapellenhof von Kirin\'Var nach Hinweisen darauf, wer sich hinter der Beeinflussung der Geister verbirgt.‡키린바르 마을의 예배당 지구에서 누가 배후에서 영혼들을 조작했는지 알아낼 수 있는 단서를 찾아야 합니다.‡Busca pistas sobre el responsable de la manipulación de los espíritus en el Patio de la Capilla del Poblado Kirin\'Var.‡Busca pistas sobre el responsable de la manipulación de los espíritus en el Patio de la Capilla del Poblado Kirin\'Var.‡Fouillez la Cour de la chapelle de Kirin\'Var à la recherche d\'indices au sujet de l\'identité de la personne responsable de la manipulation des esprits.‡在肯瑞瓦村的礼拜堂广场寻找操纵鬼魂滋扰村庄的幕后黑手的线索。‡在肯瑞瓦村莊教堂庭院搜索關於操縱那些靈魂的幕後主使者的線索。',
  }
},
[10317] = {
  {
    'Dando um jeito no encarregado‡Покончить со штейгером‡Den Großknecht erledigen‡현장감독 선다운‡Tratar con el supervisor‡Tratar con el supervisor‡S\'occuper du contremaître‡对付工头‡解決工頭',
    nil,
    'Lide com o Encarregado Ocaso, no interior da Mina Trelleum, sob Manaforja Ara, em Eternévoa.‡Покончите со штейгером Закатом Солнца, находящимся в руднике Треллеума под манагорном Ара в Пустоверти.‡Vernichtet Großknecht Sonnenend in der Trelleummine, die sich unter der Manaschmiede Ara im Nethersturm befindet.‡황천의 폭풍의 아라 마나괴철로 지하에서 트렐리움 광산 안에 있는 현장감독 선다운과 대화해야 합니다.‡Encárgate del supervisor Ocaso en la Mina Trelleum, que está bajo la Forja de Maná Ara en Tormenta Abisal.‡Encárgate del supervisor Ocaso en la Mina Trelleum, que está bajo la Forja de Maná Ara en Tormenta Abisal.‡Occupez-vous du contremaître Tombesoleil à l\'intérieur de la mine de Trelleum, qui se trouve sous la manaforge Ara au Raz-de-Néant.‡前往虚空风暴法力熔炉：艾拉地下的特雷卢姆矿井，对付工头萨杜恩·日落。‡在崔爾曼礦坑裡面解決工頭日落，崔爾曼礦坑在虛空風暴的法力熔爐艾拉下面。',
  }
},
[10318] = {
  {
    'Um mestre supremo a se lidar‡Покончить с Подчинителем‡Den Übermeister erledigen‡정복자 그라인드가르 처치‡Conversaciones con el maestro Supremo‡Conversaciones con el maestro Supremo‡S\'occuper du contremaître‡督工格林加尔‡解決征服者',
    nil,
    'Mate o Mestre Supremo Grindgarr. Em seguida, fale novamente com o Mercador do Vento Tuluman, no Acampamento do Tuluman, em Eternévoa.‡Убейте Подчинителя Гриндгарра. Затем вернитесь к торговцу Ветром Тулуману в Лагерь Тулумана в Пустоверти.‡Tötet Übermeister Grindgarr. Kehrt dann zu Windhändler Tuluman auf Tulumans Landeplatz im Nethersturm.‡정복자 그라인드가르를 처치한 후 황천의 폭풍으로 가서 툴루만의 교역지에 있는 바람의 무역상 툴루만에게 돌아가야 합니다.‡Mata al maestro supremo Yugogarr. A continuación ve a ver al comerciante de viento Tuluman en el Alto de Tuluman, en la Tormenta Abisal.‡Mata al maestro supremo Yugogarr. A continuación ve a ver al comerciante de viento Tuluman en el Alto de Tuluman, en la Tormenta Abisal.‡Tuez le Grand seigneur Grincegarr. Retournez ensuite auprès du marchand des vents Tuluman au Point d\'ancrage de Tuluman de Raz-de-Néant.‡杀死督工格林加尔，然后返回虚空风暴内图鲁曼的营地，向星界商人图鲁曼复命。‡殺死征服者古林德卡爾。然後返回虛空風暴的吐魯曼平臺的風之貿易者吐魯曼那裡。',
  }
},
[10319] = {
  {
    'A captura do filactério‡Захватить талисман‡Das Phylakterium entwenden‡성물함 입수‡Captura de la filacteria‡Captura de la filacteria‡La capture du phylactère‡纳比留斯的护符匣‡取得骨匣',
    nil,
    'Consiga o Filactério de Naberius, no distrito do Pátio da Capela da Vila Kirin\'Var, e traga-o ao Zelador Dieworth.‡Заберите филактерию Набериуса из района часовни деревни Кирин\'Вар и принесите его смотрителю Дайворту.‡Holt Naberius\' Phylakterium vom Kapellenhof in Kirin\'Var und bringt es zu Hüter Dierwert.‡키린바르 마을의 예배당 지구에서 나베리우스의 성물함을 되찾은 후 관리인 디워스에게 가져가야 합니다.‡Recupera la filacteria de Naberius en el Patio de la Capilla del Poblado Kirin\'Var y llévasela al custodio Valemuerte.‡Recupera la filacteria de Naberius en el Patio de la Capilla del Poblado Kirin\'Var y llévasela al custodio Valemuerte.‡Récupérez le Phylactère de Naberius dans le quartier de la Cour de la chapelle de Kirin\'Var et apportez-le au protecteur Valemort.‡在肯瑞瓦村的礼拜堂广场中找到纳比留斯的护符匣，将它交给管理者戴沃斯。‡在肯瑞瓦村莊教堂後院區取回納伯瑞厄斯骨匣然後帶去給管理者戴沃斯。',
  }
},
[10320] = {
  {
    'Destrua Naberius!‡Уничтожить Набериуса!‡Vernichtet Naberius!‡나베리우스 처치!‡¡Destruir a Naberius!‡¡Destruir a Naberius!‡Détruisez Naberius !‡毁灭纳比留斯！‡消滅納伯瑞厄斯!',
    nil,
    'O Zelador Dieworth, na Vila Kirin\'Var, quer que você confronte e derrote Naberius, no Pátio da Capela da Vila.‡Смотритель Дайворт в деревне Кирин\'Вар просит вас сразиться с Набериусом, находящимся во дворе часовни, и уничтожить его.‡Hüter Dierwert in Kirin\'Var möchte, dass Ihr Naberius auf dem Kapellenhof des Dorfes besiegt.‡키린바르 마을에 있는 관리인 디워스가 마을의 예배당 지구에 있는 나베리우스를 처치해 달라고 부탁했습니다.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que derrotes a Naberius en el Patio de la Capilla del poblado.‡El custodio Valemuerte, en el Poblado Kirin\'Var quiere que derrotes a Naberius en el Patio de la Capilla del poblado.‡Le protecteur Valemort de Kirin\'Var vous demande d\'affronter Naberius et de le vaincre dans la Cour de la chapelle du village.‡肯瑞瓦村的管理者戴沃斯要你击败礼拜堂广场中的纳比留斯。‡肯瑞瓦村莊的管理者戴沃斯要你擊敗教堂庭院的納伯瑞厄斯。',
  }
},
[10321] = {
  {
    'Desativar Manaforja Coruu‡Отключить манагорн Коруу‡Manaschmiede Coruu abschalten‡코루 마나괴철로 차단‡El cierre de la Forja de Maná Coruu‡El cierre de la Forja de Maná Coruu‡Extinction de la manaforge Coruu‡关闭法力熔炉：库鲁恩‡關閉法力熔爐寇魯',
    nil,
    'Viaje até Manaforja Coruu, a leste da Área 52, e obtenha o Cristal de Acesso de Coruu da Feitora Seylanna. Use-o no Painel de Controle de Coruu para desativá-la e fale novamente com a Anacoreta Karja.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Коруу к востоку от Зоны 52 и заберите кристалл доступа Коруу у надзирательницы Сейланны. Используйте его на панели управления манагорна Коруу, чтобы отключить манагорн, затем вернитесь к анахорету Карже.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Coruu, östlich von Area 52, und besorgt den Zugangskristall von Coruu von Vorarbeiterin Seylanna. Benutzt ihn, um die Manaschmiede abzuschalten, und kehrt dann zu Anachoret Karja zurück.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡52번 구역의 동쪽에 있는 코루 마나괴철로로 간 후 감독관 세일란나에게서 코루 장치 접근 수정을 입수해야 합니다. 그런 다음 코루 제어장치에 사용해서 코루 마나괴철로를 차단한 후 수도사 카르자에게 돌아가십시오.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Coruu, al este del Área 52, y obtén el cristal de acceso de Coruu del sobrestante Seylanna. Úsalo en la consola de Forja de Maná Coruu para desactivarla y vuelve a hablar con la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Coruu, al este del Área 52, y obtén el cristal de acceso de Coruu del sobrestante Seylanna. Úsalo en la consola de Forja de Maná Coruu para desactivarla y vuelve a hablar con la Anacoreta Karja.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Voyagez jusqu\'à la manaforge Coruu, à l\'est de la Zone 52, et prenez le Cristal d\'accès de Coruu à la surveillante Seylanna. Utilisez-le à la console de la manaforge Coruu pour l\'éteindre.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往52区以东的法力熔炉：库鲁恩，从工头希兰娜手中夺得库鲁恩控制水晶。对法力熔炉：库鲁恩的控制台使用水晶关闭法力熔炉，然后向学者卡尔亚复命。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐寇魯去，就在52區的東方，並從監督者塞琳娜那拿到寇魯控制水晶。使用它關閉法力熔爐寇魯控制臺，完成後回去找隱士卡爾加。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10322] = {
  {
    'Desativar Manaforja Dúria‡Отключить манагорн Даро‡Manaschmiede Duro abschalten‡듀로 마나괴철로 차단‡El cierre de la Forja de Maná Duro‡El cierre de la Forja de Maná Duro‡Extinction de la manaforge Duro‡关闭法力熔炉：杜隆‡關閉法力熔爐杜羅',
    nil,
    'A Anacoreta Karja quer que você vá a Manaforja Dúria e que obtenha o Cristal de Acesso de Dúria do Feitor Athanel. Use-o no Painel de Controle de Dúria para desativá-la.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Анахорет Каржа просит вас отправиться в манагорн Даро и забрать кристалл доступа у надзирателя Атанеля. Используйте этот кристалл на панели управления манагорном Даро, чтобы отключить его.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Anachoret Karja möchte, dass Ihr zur Manaschmiede Duro geht und den Zugangskristall von Vorarbeiter Athanel besorgt. Benutzt ihn, um die Steuerungskonsole von Duro abzuschalten.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡수도사 카르자가 듀로 마나괴철로로 가서 감독관 아사넬에게서 듀로 장치 접근 수정을 입수해 달라고 부탁했습니다. 그런 후 듀로 마나괴철로 제어장치에 사용해서 차단해야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡La Anacoreta Karja quiere que vayas a la Forja de Maná Duro y consigas el cristal de acceso del sobrestante Athanel. Utilízalo en la consola de la Forja de Maná Duro para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡La Anacoreta Karja quiere que vayas a la Forja de Maná Duro y consigas el cristal de acceso del sobrestante Athanel. Utilízalo en la consola de la Forja de Maná Duro para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡L\'anachorète Karja vous demande de vous rendre à la manaforge Duro et de vous procurer le Cristal d\'accès de Duro porté par le surveillant Athanel. Utilisez-le sur la Console de la manaforge Duro pour déclencher l\'extinction.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡学者卡尔亚要你前往法力熔炉：杜隆，从工头安萨奈尔手中夺得杜隆控制水晶。对法力熔炉：杜隆的控制台使用水晶关闭法力熔炉。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡隱士卡爾加要你前往法力熔爐杜羅並從監督者阿森尼爾身上取得杜羅控制水晶。使用它來關閉法力熔爐杜羅控制臺。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10323] = {
  {
    'Desativar Manaforja Ara‡Отключить манагорн Ара‡Manaschmiede Ara abschalten‡아라 마나괴철로 차단‡El cierre de la Forja de Maná Ara‡El cierre de la Forja de Maná Ara‡Extinction de la manaforge Ara‡关闭法力熔炉：艾拉‡關閉法力熔爐艾拉',
    nil,
    'Viaje até Manaforja Ara e obtenha o Cristal de Acesso de Ara do Feitor Azarad. Use-o no Painel de Controle de Ara para desativá-la.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Ара и заберите кристалл доступа у надзирателя Азарада. Используйте его на панели доступа манагорна Ара, чтобы отключить его.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Ara und besorgt Euch einen Zugangskristall von Vorarbeiter Azarad. Benutzt ihn, um die Steuerungskonsole von Ara abzuschalten.|n|nDas Ausführen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡아라 마나괴철로로 간 후 감독관 아자라드에게서 아라 장치 접근 수정을 입수해야 합니다. 그런 후 아라 제어장치에 사용하여 괴철로를 차단해야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Ara y obtén el cristal de acceso de Ara del sobrestante Azarad. Úsalo en la consola de Forja de Maná Ara para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Ara y obtén el cristal de acceso de Ara del sobrestante Azarad. Úsalo en la consola de Forja de Maná Ara para desactivarla.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Voyagez jusqu\'à la manaforge Ara et prenez le Cristal d\'accès d\'Ara sur le contremaître Azarad. Utilisez-le à la console de la manaforge Ara pour l\'éteindre.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：艾拉，从工头阿扎拉德手中夺得艾拉控制水晶。对法力熔炉：艾拉的控制台使用水晶关闭法力熔炉。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡到法力熔爐艾拉從監督者阿薩納德那拿到艾拉控制水晶。使用它關閉法力熔爐艾拉控制臺。|n|n為奧多爾完成任務會使你的占卜者聲望降低。',
  }
},
[10324] = {
  {
    'A grande caçada de pastolunas‡Великая охота на лунных оленей‡Die große Mondweidenjagd‡달새김 순록 사냥‡La gran cacería de ciervos lunares‡La gran cacería lunar‡La grande chasse aux frôle-lune‡狩猎月痕鹿‡牧月大獵殺',
    nil,
    'Leve 6 Pelegos de Machos Pastoluna a Acteon no Entreposto Lazúli.‡Принесите 6 шкур самцов лунного оленя Актеону с Лазурной заставы.‡Bringt 6 Bälge eines Mondweidenbocks zu Acteon in der Azurwacht.‡하늘 감시초소에 있는 옥테온에게 달새김 순록 통가죽 6개를 가져가야 합니다.‡Lleva 6 pieles de ciervos lunares a Acteon a la Avanzada Azur.‡Lleva 6 pieles de ciervos lunares a Acteon a la Avanzada Azur.‡Apportez 6 Peaux de chevreuil frôle-lune à Acteon au Guet d\'azur.‡将6张月痕鹿皮交给碧蓝岗哨的艾克提恩。‡將6個牧月雄鹿皮革帶去給藍色守望的艾克緹昂。',
  }
},
[10325] = {
  {
    'Marca de Kil\'Jaeden‡Знаки Кил\'джедена‡Male von Kil\'jaeden‡킬제덴의 징표‡Marcas de Kil\'jaeden‡Marcas de Kil\'jaeden‡Les marques de Kil\'jaeden‡基尔加丹印记‡基爾加丹印記',
    nil,
    'Leve 10 Marcas de Kil\'Jaeden para Adyen, o Guardião da Luz, em Shattrath.|n|nCompletar missões para os Aldor reduzirá sua reputação com os Áugures.‡Принесите 10 знаков Кил\'джедена Адуину Стражу Света в Шаттрат.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Bringt 10 Male von Kil\'jaeden zu Adyen dem Lichtwächter in Shattrath.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡샤트라스에 있는 빛의 수호자 아드옌에게 킬제덴의 징표 10개를 가져가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Lleva 10 marcas de Kil\'jaeden a Adyen el Celador de la Luz en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Lleva 10 marcas de Kil\'jaeden a Adyen el Celador de la Luz en la Ciudad de Shattrath.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Remettre 10 Marques de Kil\'jaeden à Adyen le Gardelumière, à Shattrath.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡将10枚基尔加丹印记交给沙塔斯城内的圣光护卫者阿德因。|n|n为奥尔多完成任务将会使你在占星者声望中的声望等级降低。‡將10個基爾加丹印記交給撒塔斯城的『護光者』艾德伊恩。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10326] = {
  {
    'Mais marcas de Kil\'jaeden‡Больше знаков Кил\'джедена‡Mehr Male von Kil\'jaeden‡킬제덴의 징표 추가 수집‡Más marcas de Kil\'jaeden‡Más marcas de Kil\'jaeden‡De nouvelles marques de Kil\'jaeden‡更多基尔加丹印记‡更多的基爾加丹印記',
    nil,
    nil,
  }
},
[10327] = {
  {
    'Marca única de Kil\'Jaeden‡Знак Кил\'джедена‡Einzelne Male von Kil\'jaeden‡킬제덴의 징표 하나‡Marca de Kil\'jaeden única‡Marca de Kil\'jaeden única‡Une marque de Kil\'jaeden‡单枚基尔加丹印记‡單一基爾加丹印記',
    nil,
    nil,
  }
},
[10328] = {
  {
    'Instruções Solfúria‡Инструкции Ярости Солнца‡Anweisungen des Sonnenzorns‡성난태양 지령‡Informes Furia del Sol‡Informes Furia del Sol‡Briefing des Solfurie‡日怒简报‡日怒簡報',
    nil,
    'Vá a Manaforja Dúria e consiga as Instruções Militares dos Solfúria e as Instruções Arcanas dos Solfúria das unidades Solfúria posicionadas na manaforja. Fale novamente com o Exarca Orelis quando houver completado a tarefa.|n|nCumprir missões para os Aldor fará com que sua reputação entre os Áugures diminua.‡Отправляйтесь в манагорн Даро и заберите военные инструкции Ярости Солнца и чародейские инструкции Ярости Солнца. По завершении задачи возвращайтесь к экзарху Орелису.|n|nВыполнение заданий Алдоров отрицательно скажется на вашей репутации среди Провидцев.‡Reist zur Manaschmiede Duro und beschafft die Truppenbefehle des Sonnenzorns und die Arkanbefehle des Sonnenzorns von den Einheiten des Sonnenzorns, die dort postiert sind. Kehrt zu Exarch Orelis zurück, wenn Ihr Eure Aufgabe erledigt habt.|n|nDas Abschließen von Quests für die Aldor führt zu einer Verringerung Eures Rufs bei den Sehern.‡듀로 마나괴철로로 가서 성난태양 군대원에게서 성난태양 군사 지령과 성난태양 비전 지령을 회수한 후, 총독 오렐리스에게 돌아가야 합니다.|n|n알도르 사제회를 위한 퀘스트를 완료하면 점술가 길드에 대한 평판은 떨어질 것입니다.‡Ve a la Forja de Maná Duro y consigue el informe militar de Furia del Sol y el informe Arcano de Furia del Sol de las unidades Furia del Sol allí asentadas. Ve a ver al exarca Orellis cuando hayas completado la tarea.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Ve a la Forja de Maná Duro y consigue el informe militar de Furia del Sol y el informe Arcano de Furia del Sol de las unidades Furia del Sol allí asentadas. Ve a ver al exarca Orellis cuando hayas completado la tarea.|n|nCompletar misiones para los Aldor hará que disminuya tu nivel de reputación con los Arúspices.‡Allez à la manaforge Duro et procurez-vous le Briefing militaire solfurie et le Briefing des arcanes solfurie auprès des soldats en poste. Retournez voir l\'exarque Orelis une fois cette tâche accomplie.|n|nAccomplir des quêtes pour l\'Aldor fera baisser votre réputation auprès des Clairvoyants.‡前往法力熔炉：杜隆，从日怒军团士兵手中夺得日怒军事简报和日怒奥术简报。完成任务后向大主教欧雷里斯复命。|n|n为奥尔多完成任务将降低你在占星者阵营中的声望等级。‡前往法力熔爐杜羅並且從駐紮的日怒守軍中取得日怒軍情簡報和日怒機密簡報。當你完成這項任務時，返回主教歐瑞利斯那裡。|n|n為奧多爾完成任務會讓你的占卜者聲望降低。',
  }
},
[10329] = {
  {
    'Desativar Manaforja B\'naar‡Отключить манагорн Б\'наар‡Manaschmiede B\'naar abschalten‡브나르 마나괴철로 차단‡El cierre de la Forja de Maná B\'naar‡El cierre de la Forja de Maná B\'naar‡Extinction de la manaforge B\'naar‡关闭法力熔炉：布纳尔‡關閉法力熔爐巴納爾',
    nil,
    'Volte à Manaforja B\'naar e obtenha o Cristal de Acesso de B\'naar do Feitor Theredis. Use-o no Painel de Controle de B\'naar para desativá-la e, em seguida, apresente-se ao Mestre Espião Thalodien.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Вернитесь в манагорн Б\'наар и заберите кристалл доступа у надзирателя Тередиса. Используйте его на панели управления манагорна Б\'наар, чтобы выключить его, затем сообщите об этом патрону шпионов Талодиену. |n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Geht zurück zur Manaschmiede B\'naar und besorgt Euch den Zugangskristall von Vorarbeiter Theredis. Benutzt ihn bei der Steuerkonsole von B\'naar um sie abzuschalten und meldet Euch danach bei Spionagemeister Thalodien zurück.|n|nDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡브나르 마나괴철로로 돌아가서 감독관 테레디스를 처치하고 브나르 장치 접근 수정을 입수해야 합니다. 그런 다음 브나르 제어장치에 사용하여 브나르 마나괴철로를 차단한 후 첩보단장 탈로디엔에게 돌아가서 보고하십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná B\'naar y obtén el cristal de acceso de B\'naar del sobrestante Theredis. Úsalo en la consola de control B\'naar para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Vuelve a la Forja de Maná B\'naar y obtén el cristal de acceso de B\'naar del sobrestante Theredis. Úsalo en la consola de control B\'naar para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Retournez à la manaforge B\'naar et prenez le Cristal d\'accès de B\'naar au Surveillant Theredis. Utilisez-le à la console de contrôle de la manaforge B\'naar pour l\'éteindre et faites votre rapport au maître-espion Thalodien.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡返回法力熔炉：布纳尔，从工头瑟瑞狄斯手中夺得布纳尔控制水晶。对法力熔炉：布纳尔的控制台使用水晶关闭法力熔炉，然后向间谍大师萨罗迪恩复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡回去法力熔爐巴納爾並從監督者瑞爾迪斯身上取得巴納爾控制水晶。將它用來關閉巴納爾控制臺，完成後回報給間諜大師薩洛迪恩。|n|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10330] = {
  {
    'Desativar Manaforja Coruu‡Отключить манагорн Коруу‡Manaschmiede Coruu abschalten‡코루 마나괴철로 차단‡El cierre de la Forja de Maná Coruu‡El cierre de la Forja de Maná Coruu‡Extinction de la manaforge Coruu‡关闭法力熔炉：库鲁恩‡關閉法力熔爐寇魯',
    nil,
    'Obtenha o Cristal de Acesso de Coruu da Feitora Seylanna. Use-o no Painel de Controle de Coruu para desativá-la e, em seguida, apresente-se a Caledis Albafulgis.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Заберите кристалл доступа Коруу у надзирателя Сейланны. Используйте его на панели управления Коруу, чтобы отключить манагорн, затем вернитесь к Каледису Сияющему Рассвету.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Besorgt den Zugangskristall von Coruu von Vorarbeiterin Seylanna. Benutzt ihn, um die Steuerkonsole der Manaschmiede abzuschalten und meldet Euch dann bei Caledis Morgenhell.|n|nDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡감독관 세일란나로부터 코루 장치 접근 수정을 입수해야 합니다. 그런 다음 코루 제어장치에 사용해서 마나괴철로를 차단한 후 캘디스 브라이트돈에게 돌아가십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Consigue el cristal de acceso de Coruu del sobrestante Seylanna. Utilízalo en la consola de control Coruu para cerrar la Forja de Maná y ve a hablar con Caledis Alba Brillante..|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Consigue el cristal de acceso de Coruu del sobrestante Seylanna. Utilízalo en la consola de control Coruu para cerrar la Forja de Maná y ve a hablar con Caledis Alba Brillante..|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Procurez-vous le Cristal d\'accès de Coruu sur la surveillante Seylanna. Utilisez-le à la console de contrôle de Coruu pour éteindre la manaforge et retournez voir Caledis Brillaube.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès des Aldor.‡从工头希兰娜手中夺得库鲁恩控制水晶。对法力熔炉：库鲁恩的控制台使用水晶关闭法力熔炉，然后向卡勒迪斯·晨光复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡從監督者塞琳娜那裡取得寇魯控制水晶。在寇魯控制臺使用它關閉法力熔爐，完成後回報卡利迪斯·光明。|n|n為占卜者完成任務會使你的奧多爾聲望降低。',
  }
},
[10331] = {
  {
    'Ferramentas indispensáveis‡Необходимые инструменты‡Unverzichtbare Werkzeuge‡없어서는 안 될 도구‡Herramienta indispensable‡Herramienta indispensable‡Des outils indispensables‡必备的工具‡必需的工具',
    nil,
    'Recupere o Martelo de Ferreiro em meio aos aprendizes de Kirin\'Var e traga-o de volta ao Aprendiz Andrethan, na Vila Kirin\'Var.‡Заберите кузнечный молот у кирин\'варских учеников и отнесите обратно ученику Андретану в деревню Кирин\'Вар.‡Besorgt den Schmiedehammer von den Lehrlingen von Kirin\'Var und bringt ihn zurück zu Lehrling Andrethan in Kirin\'Var.‡키린바르 수습생에게 무거운 대장장이 망치를 되찾은 후 키린바르 마을에 있는 수습생 안드레단에게 돌려주어야 합니다.‡Coge el martillo de herrería que tienen los aprendices de Kirin\'Var y llévaselo al aprendiz Andrethan al Poblado Kirin\'Var.‡Busca el martillo de herrería que tienen los aprendices de Kirin\'Var y llévaselo al aprendiz Andrethan al Poblado Kirin\'Var.‡Reprenez le Marteau de forge aux apprentis de Kirin\'Var et rapportez-le à l\'apprenti Andrethan à Kirin\'Var.‡从肯瑞瓦学徒手中夺回铁匠锤，将它交给肯瑞瓦村的学徒安德雷萨。‡跟肯瑞瓦學徒取回冶煉大錘然後交給肯瑞瓦村莊的學徒安崔森。',
  }
},
[10332] = {
  {
    'Mestre Ferreiro Rhonsus‡Мастер-кузнец Ронсус‡Meisterschmied Rhonsus‡대장기술의 대가 론서스‡El herrero maestro Rhonsus‡El herrero maestro Rhonsus‡Le maître forgeron Rhonsus‡铁匠大师罗恩苏斯‡鐵匠大師朗瑟士',
    nil,
    'O Aprendiz Andrethan, na Vila Kirin\'Var, quer que você mate o fantasma de Rhonsus, o mestre ferreiro da vila.‡Ученик Андретан из деревни Кирин\'Вар просит вас убить призрак Ронсуса, мастера-кузнеца поселения.‡Lehrling Andrethan in Kirin\'Var möchte, dass Ihr den Geist von Rhonsus, dem Meisterschmied des Dorfes, vernichtet.‡키린바르 마을의 수습생 안드레단이 마을의 대장기술의 대가인 론서스의 유령을 처치해 달라고 부탁했습니다.‡El aprendiz Andrethan en el Poblado Kirin\'Var quiere que mates al fantasma de Rhonsus, el herrero maestro del poblado.‡El aprendiz Andrethan en el Poblado Kirin\'Var quiere que mates al fantasma de Rhonsus, el herrero maestro del poblado.‡L\'apprenti Andrethan de Kirin\'Var veut que vous alliez tuer le fantôme de Rhonsus, le maître forgeron de la ville.‡肯瑞瓦村的学徒安德雷萨要你消灭镇上铁匠大师罗恩苏斯的鬼魂。‡在肯瑞瓦村莊的學徒安崔森要你殺了小鎮的鐵匠大師，朗瑟士的鬼魂。',
  }
},
[10333] = {
  {
    'Ajude Mamãe Macário‡Помощь Мамаше Колесун‡Helft Mama Mauschel‡휠러 아줌마 돕기‡Ayuda a Mamá Ruedas‡Ayuda a Mamá Ruedas‡Aider Mama Roulette‡帮助维勒老妈‡協助威勒媽媽',
    nil,
    'Fale com Mamãe Macário, no Posto Terramédia, dentro do Eco-domo Terramédia, em Eternévoa.‡Поговорите с Мамашей Колесун, находящейся на заставе в заповеднике "Срединные земли" в Пустоверти.‡Sprecht mit Mama Mauschel im Mittelreichposten in der Biokuppel Mittelreich im Nethersturm.‡황천의 폭풍의 중앙 생태지구 내에 중앙 생태지구 주둔지에 있는 휠러 아줌마와 대화해야 합니다.‡Habla con Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media de Tormenta Abisal.‡Habla con Mamá Ruedas en el Puesto de la Tierra Media dentro del Ecodomo de la Tierra Media de Tormenta Abisal.‡Parlez à Mama Roulette au comptoir des Terres-médianes à l\'intérieur de l\'écodôme Terres-médianes au Raz-de-Néant.‡前往虚空风暴的中央生态圆顶，与中央圆顶哨站的维勒老妈谈一谈。‡到虛空風暴內秘境領地的領地崗哨找威勒媽媽談談。',
  }
},
[10334] = {
  {
    'Mais sinetas‡Колокольчик для коровы‡Braucht mehr Kuhglocke‡베시의 종‡Necesita un cencerro‡Necesita un cencerro‡Plus de clochettes‡贝希的铃铛‡需要更多的鈴鐺',
    nil,
    'Encontre Mocha nos campos próximos do Morro da Capela na Vila Kirin\'Var, que fica em Eternévoa.‡Найдите Бесси в полях близ Часовенного холма деревни Кирин\'Вар в Пустоверти.‡Sucht Bessy in den Feldern nordöstlich des Kapellenhügels von Kirin\'Var im Nethersturm.‡황천의 폭풍의 키린바르 마을의 예배당 지구 근처에 있는 들판에서 베시를 찾아야 합니다.‡Encuentra a Bessy en los campos cerca de la Colina de la Capilla del Poblado Kirin\'Var en Tormenta Abisal.‡Encuentra a Bessy en los campos cerca de la Colina de la Capilla del Poblado Kirin\'Var en Tormenta Abisal.‡Trouver Marguerite dans les champs près de la colline de la chapelle de Kirin\'Var, au Raz-de-Néant.‡在虚空风暴肯瑞瓦村礼拜堂小丘附近的农田中找到贝希。‡在肯瑞瓦村莊的禮拜堂山丘附近找到貝絲。',
  }
},
[10335] = {
  {
    'Inspecionar as ruínas‡Исследование руин‡Die Ruinen beobachten‡폐허 측량 작업‡Inspeccionar las ruinas‡Inspeccionar las ruinas‡Cartographier les ruines‡调查废墟‡調察這些廢墟',
    nil,
    'Posicione os três Marcadores de Sondagem e fale novamente com Zephyrion, no Pináculo da Tempestade, em Eternévoa.‡Разместите три геодезических знака, затем возвращайтесь к Зефириону в Штормовую Вершину в Пустоверти.‡Platziert die drei Vermessungsmarkierungen und kehrt dann zu Zephirion in der Sturmsäule im Nethersturm zurück.‡측량 지점 표지 3개를 설치한 후에 황천의 폭풍에 있는 폭풍 첨탑에 있는 제피리온에게 돌아가야 합니다.‡Coloca los tres marcadores de reconocimiento y vuelve a ver a Zephyrion en La Flecha de la Tormenta, en la Tormenta Abisal.‡Coloca los tres marcadores de reconocimiento y vuelve a ver a Zephyrion en La Flecha de la Tormenta, en la Tormenta Abisal.‡Placez les trois Repères de géomètre puis revenez voir Zéphyrion à la Foudreflèche au Raz-de-Néant.‡放置好三枚测量标记，然后返回虚空风暴的风暴尖塔里，向塞菲里恩复命。‡放置3面勘察標誌，然後回到虛空風暴的風暴之尖找塞菲爾恩。',
  }
},
[10336] = {
  {
    'Os lacaios de Coluthas‡Приспешники Кулутаса‡Diener von Culuthas‡쿨루타스의 부하들‡Los esbirros de Culuthas‡Los esbirros de Culuthas‡Les serviteurs de Culuthas‡库鲁萨斯的爪牙‡卡露薩斯的爪牙',
    nil,
    'Mate 10 Cães de Coluthas e 5 Olhos de Coluthas. Depois, fale novamente com o Espreitador Etéreo Nauthis no Pináculo da Tempestade, em Eternévoa.‡Убейте 10 псов Кулутаса и 5 злобоглазов Кулутаса. Затем вернитесь к ловчему Пустоты Наутису, находящемуся в Штормовой Вершине в Пустоверти.‡Tötet 10 Hunde von Culuthas und 5 Augen von Culuthas. Kehrt danach zu Netherpirscher Nauthis in der Sturmsäule im Nethersturm zurück.‡쿨루타스의 사냥개 10마리와 쿨루타스의 눈 5마리를 처치한 후, 황천의 폭풍에 있는 폭풍 첨탑 내의 황천의 추적자 나우디스에게 돌아가야 합니다.‡Mata 10 canes de Culuthas y 5 ojos de Culuthas. Después ve a ver al acechador abisal Nauthis en La Flecha de la Tormenta, en la Tormenta Abisal.‡Mata 10 canes de Culuthas y 5 ojos de Culuthas. Después ve a ver al acechador abisal Nauthis en La Flecha de la Tormenta, en la Tormenta Abisal.‡Tuez 10 Molosses de Culuthas et 5 Yeux de Culuthas, puis retournez voir le Traqueur-du-Néant Nauthis à la Foudreflèche au Raz-de-Néant.‡杀死10只库鲁萨斯的猎犬和5只库鲁萨斯之眼。然后返回虚空风暴的风暴尖塔，向虚空猎手纳乌希思复命。‡殺死10隻卡露薩斯之犬和5隻卡露薩斯之眼。完成後返回虛空風暴的風暴之尖找虛空巡者那魯利斯。',
  }
},
[10337] = {
  {
    'Quando as vacas voltam para o lar‡Когда коровы возвращаются домой‡Almabtrieb‡집으로 돌아온 소‡Cuando las vacas vuelven a casa‡Cuando las vacas vuelven a casa‡Marguerite rentre au pays‡奶牛回家‡母牛返家',
    nil,
    'Escolte a Mocha sã e salva de volta a seu proprietário, Thadell.‡Благополучно сопроводите Бесси к ее владельцу, Таделлу.‡Begleitet Bessy sicher zu ihrem Besitzer Thadell zurück.‡베시가 주인인 타델에게 무사히 돌아갈 수 있도록 호위해야 합니다.‡Escolta a Bessy de vuelta con su dueño, Thadell.‡Escolta a Bessy de vuelta con su dueño, Thadell.‡Escortez Marguerite pour la ramener saine et sauve à son propriétaire, Thadell.‡护送贝希安全返回她的主人萨德尔那里。‡護送貝絲安全地回到她的主人，薩戴爾身邊。',
  }
},
[10338] = {
  {
    'Desativar a Manaforja Dúria‡Отключить манагорн Даро‡Manaschmiede Duro abschalten‡듀로 마나괴철로 차단‡El cierre de la Forja de Maná Duro‡El cierre de la Forja de Maná Duro‡Extinction de la manaforge Duro‡关闭法力熔炉：杜隆‡關閉法力熔爐杜羅',
    nil,
    'Volte à Manaforja Dúria e obtenha o Cristal de Acesso de Dúria do Feitor Athanel. Use-o no Painel de Controle de Dúria para desativá-la e, em seguida, apresente-se ao Mestre Espião Thalodien.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Вернитесь в манагорн Даро и заберите кристалл доступа у надзирателя Атанеля. Используйте его на панели управления манагорна Даро, чтобы отключить его, затем сообщите об этом патрону шпионов Талодиену. |n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Kehrt zur Manaschmiede Duro zurück und besorgt Euch den Zugangskristall von Vorarbeiter Athanel. Benutzt ihn, um die Steuerkonsole von Duro abzuschalten, und meldet Euch danach bei Spionagemeister Thalodien.|n|nDas Ausführen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡듀로 마나괴철로로 돌아가서 감독관 아사넬을 처치하고 듀로 장치 접근 수정을 손에 넣어야 합니다. 그런 다음 듀로 제어장치에 사용하여 듀로 마나괴철로를 차단한 후 첩보단장 탈로디엔에게 돌아가서 보고하십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Vuelve a la Forja de Maná Duro y obtén el cristal de acceso de Duro del sobrestante Athanel. Úsalo en la consola de control de Duro para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Vuelve a la Forja de Maná Duro y obtén el cristal de acceso de Duro del sobrestante Athanel. Úsalo en la consola de control de Duro para desactivarla y vuelve a hablar con el maestro de espías Thalodien.|n|nCompletar misiones para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Retournez à la manaforge Duro et prenez le Cristal d\'accès de Duro au surveillant Athanel. Utilisez-le à la console de contrôle de Duro pour l\'éteindre et allez faire votre rapport au maître-espion Thalodien.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡返回法力熔炉：杜隆，从工头安萨奈尔手中夺得杜隆控制水晶。对法力熔炉：杜隆的控制台使用水晶关闭法力熔炉，然后向间谍大师萨罗迪恩复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡回到法力熔爐杜羅從監督者阿森尼爾手中取得杜羅控制水晶。在杜洛控制臺使用控制水晶關閉該裝置然後向間諜大師薩洛迪恩回報。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10339] = {
  {
    'O Etéreum‡Братство Эфириум‡Das Astraleum‡에테리움‡El Etereum‡El Etereum‡L\'Ethereum‡复仇军‡以太皇族',
    nil,
    'O Comandante Ameer quer que você mate 5 Assassinos Etéreum, 5 Tropas de Choque Etéreum, 2 Pesquisadores Etéreum e o Capitão Zovax e, após, quer que ative o rádio-sinalizador Zeta do Etéreum.‡Командир Амир просит вас уничтожить 5 убийц из Эфириума, 5 штормовиков из Эфириума, 2 ученых Эфириума и капитана Зовакса из Эфириума, затем включить передатчик Эфириума Зета.‡Kommandant Ameer möchte, dass Ihr 5 Auftragsmörder des Astraleums, 5 Stoßtruppsoldaten des Astraleums, 2 Forscher des Astraleums und Hauptmann Zovax tötet und dann den Transponder des Astraleums Zeta aktiviert.‡사령관 야미르가 에테리움 암살자 5명, 에테리움 돌격병 5명, 에테리움 연구원 2명, 대장 조박스를 처치한 다음 에테리움 송수신기 제타를 작동하라는 임무를 주었습니다.‡El comandante Ameer quiere que mates a 5 asesinos de El Etereum, 5 soldados de choque de El Etereum, 2 investigadores de El Etereum y al capitán Zovax y que, a continuación, actives el transpondedor de El Etereum Zeta.‡El comandante Ameer quiere que mates a 5 asesinos de El Etereum, 5 soldados de choque de El Etereum, 2 investigadores de El Etereum y al capitán Zovax y que, a continuación, actives el transpondedor de El Etereum Zeta.‡Le commandant Ameer veut que vous tuiez 5 Assassins de l\'Ethereum, 5 Troupiers de choc de l\'Ethereum, 2 Chercheurs de l\'Ethereum et le capitaine Zovax puis que vous activiez le Transpondeur zéta de l\'Ethereum.‡指挥官阿米尔要你杀死5名复仇军刺客、5名复仇军突击队员、2名复仇军研究员和索瓦克斯上尉，然后启动复仇军发射器 - 塞塔。‡指揮官阿密爾要你殺死5個以太皇族刺客、5個以太皇族突擊兵、2個以太皇族調查者還有索瓦斯上尉然後啟動以太皇族傳送器Ⅵ。',
  }
},
[10340] = {
  {
    'Posto Despedaçado‡Парящая застава‡Trümmerposten‡징검다리 거점‡Puesto Devastación‡Puesto Devastación‡La halte du Fracas‡破碎岗哨‡破碎崗哨',
    nil,
    'O Comandante Avançado Kingston quer que você fale com o Comandante de Ala Dabir\'ee, cavalgue um grifo até o Posto Despedaçado e então se apresente a Runatogo Martelo Feroz.‡По приказу командира передовой Кингстона поговорите с командиром звена Даби\'ри, доберитесь на грифоне до Парящей заставы и поговорите с Рунтогом Громовым Молотом.‡Vorpostenkommandant Königstein möchte, dass Ihr mit Schwadronskommandant Dabir\'ee sprecht, auf einem Greifen zum Trümmerposten fliegt und Euch bei Runetog Wildhammer meldet.‡전방사령관 킹스톤이 편대사령관 다비리와 대화한 후에, 그리핀을 타고 징검다리 거점에 도착한 다음 룬토그 와일드해머에게 보고해 달라고 부탁했습니다.‡El comandante de vanguardia Kingston quiere que hables con el comandante del aire Dabir\'ee, vayas en grifo a Puesto Devastación y te presentes ante Runetog Martillo Salvaje.‡El comandante de vanguardia Kingston quiere que hables con el comandante del aire Dabir\'ee, vayas en grifo a Puesto Devastación y te presentes ante Runetog Martillo Salvaje.‡Le commandant des lignes avancées Kingston veut que vous parliez au chef d\'escadrille Dabir\'ee, que vous preniez un griffon pour la halte du Fracas et que vous vous présentiez à Runetog Marteau-hardi.‡前线指挥官金斯顿要求你与空军指挥官达比利交谈，搭乘狮鹫前往破碎岗哨，并向鲁恩托格·蛮锤报告。‡前線指揮官金斯頓要你去找空軍指揮戴畢瑞談談，騎乘獅鷲獸到破碎崗哨，然後找符文衣·蠻錘報到。',
  }
},
[10341] = {
  {
    'Acabe com eles enquanto estão no chão‡Лежачего не бьют – лежачего пинают‡Tretet sie, solange sie am Boden liegen‡확인 사살‡A por ellos cuando no se pueden defender‡A por ellos cuando no se pueden defender‡Cognez-les maintenant qu\'ils sont à terre‡乘胜追击‡趁他人之危',
    nil,
    'Mate 8 Conjuradores Solfúria, 6 Arqueiros Solfúria e 4 Centuriões Solfúria. Fale novamente com a Magistra Larynna, na Área 52, após concluir a tarefa.|n|nCumprir missões para os Áugures fará com que sua reputação entre os Aldor diminua.‡Убейте 8 кудесников, 6 лучников и 4 центурионов клана Ярости Солнца. После завершения задачи вернитесь к магистру Ларинне, находящейся в Зоне 52.|n|nВыполнение заданий Провидцев отрицательно скажется на вашей репутации среди Алдоров.‡Tötet 8 Beschwörer des Sonnenzorns, 6 Jadgschützen des Sonnenzorns und 4 Zenturios des Sonnenzorns. Kehrt zu Magistrix Larynna in Area 52 zurück, wenn Ihr die Aufgabe erledigt habt.|n|nDas Abschließen von Quests für die Seher führt zu einer Verringerung Eures Rufs bei den Aldor.‡성난태양 창조술사 8명, 성난태양 궁병 6명, 성난태양 백인대장 4명을 처치해야 합니다. 이 임무를 완수한 후에 52번 구역에 있는 마법학자 라린나에게 돌아가십시오.|n|n점술가 길드를 위한 퀘스트를 완료하면 알도르 사제회에 대한 평판은 떨어질 것입니다.‡Mata 8 conjuradores Furia del Sol, 6 asaeteadores Furia del Sol y 4 centuriones Furia del Sol. Vuelve a ver a la magistrix Larynna en el Área 52 cuando hayas completado la tarea.|n|nCompletar tareas para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Mata 8 conjuradores Furia del Sol, 6 asaeteadores Furia del Sol y 4 centuriones Furia del Sol. Vuelve a ver a la magistrix Larynna en el Área 52 cuando hayas completado la tarea.|n|nCompletar tareas para los Arúspices hará que disminuya tu nivel de reputación con los Aldor.‡Tuez 8 Adjurateurs solfurie, 6 Franc-archers solfurie et 4 Centurions solfurie. Retournez voir la magistrice Larynna dans la Zone 52 lorsque vous aurez achevé cette tâche.|n|nAccomplir des quêtes pour les Clairvoyants fera baisser votre réputation auprès de l\'Aldor.‡杀死8名日怒咒术师、6名日怒弓箭手和4名日怒百夫长。完成任务后返回52区向魔导师拉恩娜复命。|n|n为占星者完成任务将降低你在奥尔多阵营中的声望等级。‡殺掉8個日怒咒術師，6個日怒射手以及4個日怒百夫長。完成任務後回到52區找博學者萊莉娜。|n|n為占卜者完成任務會讓你的奧多爾聲望降低。',
  }
},
[10342] = {
  {
    'Consiga o xisto dos xistocouro‡Добыча кожи глиношкурых‡Schieferhautschiefer‡혈암가죽 파편‡Asegurar los esquistos Piel de esquisto‡Asegurar los esquistos Piel de esquisto‡Dégoter de la lauze de peau-de-schiste‡收集岩肤油块‡獲得岩層泥岩',
    nil,
    'Colete cinco Xistos de Xistocouro e leve-os ao Botas, na Área 52, em Eternévoa.‡Соберите 5 кусков кожи глиношкурых и отдайте Бутсу в Зоне 52 в Пустоверти.‡Sammelt 5 Stück Schieferhautschiefer und bringt sie zu Stiefels in Area 52 im Nethersturm.‡혈암가죽 파편 5개를 수집한 후 황천의 폭풍의 52번 구역에 있는 부츠에게 가져가야 합니다.‡Recolecta 5 esquistos Piel de esquisto y llévaselos a Botas del Área 52, en la Tormenta Abisal.‡Recolecta 5 esquistos Piel de esquisto y llévaselos a Botas del Área 52, en la Tormenta Abisal.‡Collectez 5 Lauzes de peau-de-schiste et apportez-les à Bottes dans la Zone 52 au Raz-de-Néant.‡收集5块岩肤油块，将它们交给虚空风暴52区的布兹。‡收集5個岩層泥岩並將這些交給虛空風暴上52區的布茲。',
  }
},
[10343] = {
  {
    'Invasão infindável‡Бесконечное вторжение‡Die unendliche Invasion‡끝없는 침략‡La invasión interminable‡La invasión interminable‡L\'invasion sans fin‡无尽的入侵‡無止盡的侵略',
    nil,
    'Encontre, na área infestada de criaturas de mana da Vila Kirin\'Var, um Fragmento de Bomba de Mana e traga-o ao Tenente-Feiticeiro Morran.‡Обыщите кишащий мана-тварями район деревни Кирин\'Вар в поисках фрагмента мана-бомбы и принесите его лейтенант-колдуну Моррану.‡Sucht die von Manakreaturen heimgesuchte Gegend in Kirin\'Var nach einem Manabombenfragment ab und bringt sie zu Zaubererleutnant Morran.‡키린바르 마을에 들끓고 있는 마나 생물에서 마나 폭탄 파편을 찾은 후 마술사 부관 모란에게 가져가야 합니다.‡Busca en la zona del Poblado Kirin\'Var infestada de criaturas de maná un trozo de bomba de maná y llévasela al teniente hechicero Morran.‡Busca en la zona del Poblado Kirin\'Var infestada de criaturas de maná un trozo de bomba de maná y llévasela al teniente hechicero Morran.‡Fouillez la zone de Kirin\'Var infestée de créatures de mana à la recherche d\'un Fragment de bombe de mana et apportez-le au lieutenant-ensorceleur Morran.‡在肯瑞瓦村中法力生物肆虐的地区收集一块魔法炸弹碎片，将它交给巫师上尉莫尔兰。‡搜尋肯瑞瓦村莊大批法力生物出沒的地方找到法力炸彈碎片，並且把它交給莫爾蘭巫士中尉。',
  }
},
[10344] = {
  {
    'Comandante de Ala Grifongar‡Командир звена Грифонгар‡Schwadronskommandant Greifgar‡편대사령관 그리폰가르‡Comandante del aire Grifongar‡Comandante del aire Grifongar‡Le chef d\'escadrille Griffongar‡空军指挥官格莱芬加尔‡空軍指揮葛萊弗卡爾',
    nil,
    'Fale com o Comandante de Ala Grifongar no Posto Despedaçado.‡Поговорите с командиром звена Грифонгаром на Парящей заставе.‡Sprecht mit Schwadronskommandant Greifgar im Trümmerposten.‡징검다리 거점에 있는 편대사령관 그리폰가르와 대화해야 합니다.‡Habla con el comandante del aire Grifongar en el Puesto Devastación.‡Habla con el comandante del aire Grifongar en el Puesto Devastación.‡Parlez au chef d\'escadrille Griffongar à la halte du Fracas.‡与破碎岗哨的空军指挥官格莱芬加尔谈一谈。‡與破碎崗哨的空軍指揮葛萊弗卡爾談談。',
  }
},
[10345] = {
  {
    'A carne é forte...‡Усеял мертвыми костями...‡Fleisch geworden‡누워 있는 시체들‡La carne sí engaña‡La carne sí engaña‡La chair ment...‡血肉会撒谎......‡地上的屍體……',
    nil,
    'Use o incendiador do Protetorado em 12 cadáveres dessecados. Retorne o incendiador do Protetorado ao Agente Araxes, do lado de fora do poço de acesso Zeon, quando a tarefa for concluída.‡Примените поджигатель Протектората к 12 высохшим трупам. Когда задача будет завершена, верните поджигатель Протектората посланнику Араксису, находящемуся у входа в шахту Зеон.‡Benutzt den Anzünder des Protektorats um 12 siechende Leichen zu zerstören. Bringt den Anzünder des Protektorats zu Agent Araxes außerhalb des Zugangsschachts Zeon zurück, wenn Ihr erfolgreich wart.‡말라 비틀어진 시체 12구에 자유연합 점화장치를 사용한 후, 지온 작업 갱도 바깥에 있는 요원 아락세스에게 돌아가야 합니다.‡Usa el encendedor del Protectorado en 12 cadáveres marchitos y devuélveselo al agente Araxes fuera del Eje de Acceso Zeon cuando hayas acabado.|n‡Usa el encendedor del Protectorado en 12 cadáveres marchitos y devuélveselo al agente Araxes fuera del Eje de Acceso Zeon cuando hayas acabado.|n‡Utilisez le Boute-feu du Protectorat sur 12 Cadavres flétris. Lorsque vous aurez fini, rendez le Boute-feu du Protectorat à l\'agent Araxes à l\'extérieur du Puits d\'accès Zéon.‡对12具干枯的尸体使用维序派点火器。完成任务后将维序派点火器还给瑟安竖井外的代理人阿拉克塞。‡對12具腐敗的屍體使用護國者的點火器。在你的任務完成之後，將護國者的點火器還給在礦井之路通道外面的密探阿雷克斯。',
  }
},
[10346] = {
  {
    'Retorno à Prateleira Abissal‡Возвращение на Косогор Бездны‡Rückkehr zur abyssischen Untiefe‡심연의 절벽으로 돌아가기‡Regresa a La Plataforma Abisal‡Regresa a La Plataforma Abisal‡Retour à la saillie abyssale‡返回地狱岩床‡回到深淵沙洲',
    nil,
    'A Grifoneira Urravento do Posto Despedaçado, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по просьбе грифоньера Ветрорева с Парящей заставы на полуострове Адского Пламени.‡Greifnerin Heulwind im Trümmerposten auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen zerstört.‡지옥불 반도의 징검다리 거점에 있는 그리핀 관리인 윈드벨로우가 간아그 일꾼 20마리, 모아그 감독관 5마리, 지옥 대포 5개를 파괴해 달라고 부탁했습니다.‡La grifonera Bramavientos, en el Puesto Devastación, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡La grifonera Bramavientos, en el Puesto Devastación, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le griffonnier Soufflevent de la halte du Fracas dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛破碎岗哨的狮鹫骑士维比洛要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡在地獄火半島破碎崗哨的獅鷲專家風怒要你殺死20個甘納格苦工、5個莫阿格監督者還有5座惡魔火砲。',
  }
},
[10347] = {
  {
    'Retorno à Prateleira Abissal‡Возвращение на Косогор Бездны‡Rückkehr zur abyssischen Untiefe‡심연의 절벽으로 돌아가기‡Regresa a La Plataforma Abisal‡Regresa a La Plataforma Abisal‡Retour à la saillie abyssale‡返回地狱岩床‡回到深淵沙洲',
    nil,
    'O Comandante de Ala Brack, no Posto dos Destroços, na Península Fogo do Inferno, ordenou que você destrua 20 Peões Gan\'args, 5 Feitores Mo\'args e 5 Canhões Vis.‡Уничтожьте 20 ган\'аргов-батраков, 5 мо\'аргов-надзирателей и 5 пушек Скверны по просьбе командира звена Бракка из Гибели Сквернобота на полуострове Адского Пламени.‡Schwadronskommandant Brack im Häschersturz auf der Höllenfeuerhalbinsel möchte, dass Ihr 20 Peons der Gan\'arg, 5 Vorarbeiter der Mo\'arg und 5 Teufelskanonen zerstört.‡지옥불 반도의 지옥절단기 함락지에 있는 편대사령관 브락크가 간아그 일꾼 20명과 모아그 감독관 5명을 처치하고 지옥 대포 5대를 파괴하라는 임무를 맡겼습니다.‡El comandante del aire Brack, en la Caída del Atracador Vil, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡El comandante del aire Brack, en la Caída del Atracador Vil, en la Península del Fuego Infernal, te ha pedido que destruyas 20 peones de Gan\'arg, 5 sobrestantes Mo\'arg y 5 cañones viles.‡Le chef d\'escadrille Brack du Trépas du saccageur dans la péninsule des Flammes infernales vous demande de détruire 20 Péons gan\'arg, 5 Surveillants mo\'arg et 5 Gangrecanons.‡地狱火半岛机甲残骸的空军指挥官布拉克要求你杀死20个甘尔葛苦工和5个莫尔葛监工，并摧毁5门邪能火炮。‡地獄火半島上劫奪者荒野的空軍指揮布拉克要你消滅20個甘納格苦工，5個莫阿格監督者和5座惡魔火砲。',
  }
},
[10348] = {
  {
    'Novas oportunidades‡Новые возможности‡Neue Möglichkeiten‡새로운 기회‡Nuevas oportunidades‡Nuevas oportunidades‡De nouvelles opportunités‡新的机遇‡新的機會',
    nil,
    'Colete 15 Sinos de Marfim e fale novamente com Muhrdad, no Posto Terramédia.‡Соберите 15 "кремовых колокольчиков" и вернитесь к Мердаду на Заставу срединных земель.‡Sammelt 15 Elfenbeinglocken und kehrt dann zu Mehrdad im Mittelreichposten zurück.‡상아 종꽃 15개를 수집한 후 중앙 생태지구 주둔지에 있는 메르다드에게 돌아가야 합니다.‡Recupera 15 campanas de marfil y regresa junto a Mehrdad en el Puesto de la Tierra Media.‡Recupera 15 campanas de marfil y regresa junto a Mehrdad en el Puesto de la Tierra Media.‡Cueillez 15 Clochettes d\'ivoire et retournez voir Mihrdad au comptoir des Terres-médianes.‡收集15株象牙铃笼草，然后向中央圆顶哨站的玛尔达德复命。‡採集15朵象牙鈴，完成後回到領地崗哨找瑪戴德。',
  }
},
[10349] = {
  {
    'A Ataterra‡Землепряд‡Die Erdbinderin‡대지의 결속자‡La Vinculadora terrestre‡La Vinculadora terrestre‡La lieuse de terre‡缚地者‡縛地者',
    nil,
    'Leve o Estilhaço de Cristal Carmesim para a Ataterra Galandria Umbrísia no Posto Cenariano, que fica na Península Fogo do Inferno.‡Отнесите осколок алого хрусталя заклинательнице земли Галандрии Ночной Бриз на Кенарийскую заставу на полуострове Адского Пламени.‡Bringt den Purpurkristallsplitter zu Erdbinderin Galandria Nachtluft im Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 대지의 결속자 갈란드리아 나이트브리즈에게 진홍색 수정 조각을 가져가야 합니다.‡Lleva el fragmento de cristal carmesí a la Vinculadora terrestre Galandria Brisa Nocturna en el Puesto Cenarion en la Península del Fuego Infernal.‡Lleva el fragmento de cristal carmesí a la Vinculadora terrestre Galandria Brisa Nocturna en el Puesto Cenarion en la Península del Fuego Infernal.‡Apportez l\'Éclat de cristal cramoisi à la lieuse de terre Galandria Noctebrise au Poste cénarien dans la péninsule des Flammes infernales.‡将火红水晶碎片交给地狱火半岛塞纳里奥哨站的缚地者加兰蒂娅·夜风。‡將赤紅水晶裂片拿去地獄火半島的塞納里奧前哨交給縛地者卡拉崔亞·夜風。',
  }
},
[10350] = {
  {
    'Behomat‡Бехомат‡Behomat‡베호마트‡Maestro Behomat‡Maestro Behomat‡Behomat‡贝霍玛特‡畢和瑪特',
    nil,
    'Fale com Behomat no Setor Comercial, na Exodar.‡Поговорите с Бехоматом в Торговом ряду Экзодара.‡Sprecht mit Behomat bei der Händlertreppe in der Exodar.‡엑소다르의 교역 지구에 있는 베호마트와 대화해야 합니다.‡Habla con Behomat en La Grada de los Mercaderes de El Exodar.‡Habla con Behomat en La Grada de los Mercaderes de El Exodar.‡Allez parler à Behomat, à l\'Étage des commerces de l\'Exodar.‡与埃索达贸易阶梯的贝霍玛特谈一谈。‡與艾克索達貿易區的畢和瑪特談談。',
  }
},
[10351] = {
  {
    'Remédios naturais‡Целительная сила природы‡Natürliche Heilmittel‡자연 요법‡Remedios naturales‡Remedios naturales‡Remèdes naturels‡自然的治愈‡自然治療法',
    nil,
    'Use a Semente da Revitalização no Círculo da Ataterra para curar a terra em redor do cristal. Então, fale novamente com a Ataterra Galandria Umbrísia, no Posto Cenariano, que fica na Península Fogo do Inferno, e lhe informe o que descobrir.‡Посадите Семя Возрождения в Круге землепряда, чтобы исцелить землю вокруг кристалла. После этого возвращайтесь к землепряду Галандрии Ночной Бриз на Кенарийскую заставу и расскажите о том, что получилось.‡Benutzt den Samen der Wiederbelebung beim Zirkel des Erdbinders, um das Land um den Kristall herum zu heilen. Kehrt dann zu Erdbinderin Galandria Nachtluft im Posten des Cenarius auf der Höllenfeuerhalbinsel mit Euren Beobachtungen zurück.‡대지의 결속자의 마법진에 회복의 씨앗을 사용하여 수정 주변에 있는 땅을 치료한 후 입수한 정보를 가지고 지옥불 반도의 세나리온 초소에 있는 대지의 결속자 갈란드리아 나이트브리즈에게 돌아가야 합니다.‡Usa la semilla de revitalización en el Círculo de los Vinculadores terrestres para sanar la tierra alrededor del cristal. Después ve a informar a la Vinculadora terrestre Galandria Brisa Nocturna al Puesto Cenarion en la Península del Fuego Infernal.‡Usa la semilla de revitalización en el Círculo de los Vinculadores terrestres para sanar la tierra alrededor del cristal. Después ve a informar a la Vinculadora terrestre Galandria Brisa Nocturna al Puesto Cenarion en la Península del Fuego Infernal.‡Utilisez la Graine de revitalisation au Cercle de la lieuse de terre pour guérir la terre autour du cristal. Ensuite, retournez voir la lieuse de terre Galandria Noctebrise au Poste cénarien dans la péninsule des Flammes infernales avec toutes les informations que vous aurez.‡在缚地者法阵中使用新生之种，治愈水晶周围的土地。然后返回地狱火半岛的塞纳里奥哨站，向缚地者加兰蒂娅·夜风汇报情况。‡在縛地者之環使用新生之種去治癒水晶周遭的土地。然後，帶著任何你所獲得的情報返回地獄火半島的塞納里奧前哨找縛地者卡拉崔亞·夜風。',
  }
},
[10352] = {
  {
    'Uma doação de lã‡Пожертвование: шерсть‡Spendet Wolle‡양모 옷감 기부‡Un donativo de lana‡Un donativo de lana‡Un don de laine‡捐献毛料‡捐獻毛料',
