[24848] = {
  {
    '‡Фейерверки в Позолоченной розе‡Feuerwerk bei der Güldenen Rose‡황금 장미 여관에서‡Fuegos artificiales en La Rosa Áurea‡Fuegos artificiales en La Rosa Áurea‡Feux d\'artifice à la Rose dorée‡镶金玫瑰的焰火‡鑲金玫瑰之戀',
    nil,
    '‡Поговорите с Марион Саттон в "Позолоченной розе", которая находится в Торговом квартале Штормграда.‡Redet mit Marion Sutton in der Güldenen Rose im Handelsdistrikt von Sturmwind.‡스톰윈드 상업 지구의 황금 장미 여관에 있는 매리언 서튼과 대화해야 합니다.‡Habla con Marion Sutton en La Rosa Áurea, en el Distrito de Mercaderes de Ventormenta.‡Habla con Marion Sutton en La Rosa Áurea, en el Distrito de Mercaderes de Ventormenta.‡Parlez à Marion Sutton à la Rose dorée, dans le Quartier commerçant de Hurlevent.‡‡',
  }
},
[24849] = {
  {
    '‡По горячим следам‡Auf den Fersen‡실마리를 찾아서‡Pisándole los talones‡Pisándole los talones‡La piste est toute chaude‡热力跟踪‡重要線索',
    nil,
    '‡Поищите Снивела Ржавстера в счетной палате Штормграда, аукционном доме и парикмахерской.‡Sucht Flenni Rostrakete im Zählhaus von Sturmwind, im Auktionshaus und beim Barbier von Sturmwind.‡스톰윈드 회계사무소, 경매장, 미용실에서 스니블 러스트로켓을 찾아야 합니다.‡Busca a Quejica Misilóxido en la Contaduría de Ventormenta, la casa de subastas y la peluquería de la Ciudad de Ventormenta.‡Busca a Quejica Misilóxido en la Contaduría de Ventormenta, la casa de subastas y la peluquería de la Ciudad de Ventormenta.‡Cherchez Chignard Rouillefusée dans la Salle des dépôts de Hurlevent, l\'Hôtel des ventes et le Salon de coiffure de Hurlevent.‡‡',
  }
},
[24850] = {
  {
    '‡Возлюбленная Ржавстера‡Flennis Flamme‡스니블의 연인‡La querida de Quejica‡La querida de Quejica‡La chérie de Chignard‡斯内维尔的情人‡史尼佛的心上人',
    nil,
    '‡Поговорите с Рокой возле "Туристического снаряжения Готри", что в Волоке в Оргриммаре.‡Redet mit Roka bei Gotris Reiseausstattung in der Gasse in Orgrimmar.‡‡Habla con Roka en el Equipo de viaje de Gotri en la Calle Mayor de Orgrimmar.‡Habla con Roka en el Equipo de viaje de Gotri en la Calle Mayor de Orgrimmar.‡Parlez à Roka, à l\'Équipement des voyageurs de Gotri, dans le quartier de la Herse, à Orgrimmar.‡‡',
  }
},
[24851] = {
  {
    '‡По горячим следам‡Auf den Fersen‡실마리를 찾아서‡Pisándole los talones‡Pisándole los talones‡La piste est toute chaude‡热力跟踪‡重要線索',
    nil,
    '‡Поищите Снивела Ржавстера в банке Оргриммара, аукционном доме и парикмахерской.‡Sucht Flenni Rostrakete in der Bank von Orgrimmar im Tal der Stärke, dem Auktionshaus und dem Barbier von Orgrimmar.‡‡Busca a Quejica Misilóxido en el banco de Orgrimmar en el Valle de la Fuerza, en la casa de subastas y en la peluquería en Orgrimmar.‡Busca a Quejica Misilóxido en el banco de Orgrimmar en el Valle de la Fuerza, en la casa de subastas y en la peluquería en Orgrimmar.‡Cherchez Chignard Rouillefusée à la Banque d\'Orgrimmar dans la Vallée de la Force, à l\'Hôtel des ventes et au Salon de coiffure d\'Orgrimmar.‡‡',
  }
},
[24857] = {
  {
    'Aldeia Narache sob ataque‡Нападение на Лагерь Нараче‡Angriff auf Camp Narache‡나라체 야영지에 대한 공격‡Ataque sobre el Campamento Narache‡Ataque al Campamento Narache‡L\'attaque du camp Narache‡纳拉其营地的危机‡襲擊納拉其營地',
    nil,
    'Leve o Plano de Ataque dos Costagulhas ao Chefe Vento do Falcão na Aldeia Narache.‡Отнесите план нападения племени Дыбогривов вождю Соколиному Ветру в Лагерь Нараче.‡Bringt die Angriffspläne der Borstennacken zu Häuptling Falkenwind in Camp Narache.‡나라체 야영지에 있는 족장 호크윈드에게 뾰족털일족의 작전도를 가져가야 합니다.‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Lleva los planes de ataque Erizapúas al jefe Viento de Halcón al Campamento Narache.‡Apportez les Plans d\'attaque des Dos-hirsute au Chef Vent-du-faucon, au camp Narache.‡将刺背野猪人的进攻计划交给纳拉其营地的鹰风酋长。‡將刺背野豬人的進攻計畫交給納拉其營地的鷹風酋長。',
  }
},
[24869] = {
  {
    '‡Перевербовка‡Entprogrammieren‡‡Desprogramación‡Desprogramación‡Déprogrammation‡思想净化‡思想淨化',
    nil,
    '‡Убейте Леди Смертный Шепот, сохранив жизнь Дарнавану.‡Bezwingt Lady Todeswisper, aber stellt dabei sicher, dass Darnavan überlebt.‡‡Derrota a Lady Susurramuerte y asegúrate de que Darnavan sobrevive.‡Derrota a Lady Susurramuerte y asegúrate de que Darnavan sobrevive.‡Battez Dame Murmemort en vous assurant que Darnavan survive.‡‡',
  }
},
[24870] = {
  {
    '‡Оборона Черепного вала‡Sicherung des Bollwerks‡‡Asegurar la muralla‡Asegurar la muralla‡Sécuriser les remparts‡保卫城墙‡保衛城牆',
    nil,
    '‡Убейте гниющего ледяного великана.‡Erledigt den verrottenden Frostriesen.‡‡Mata al gigante de escarcha en podredumbre.‡Mata al gigante de escarcha en podredumbre.‡Tuez le Géant du givre pourrissant.‡‡',
  }
},
[24871] = {
  {
    '‡Оборона Черепного вала‡Sicherung des Bollwerks‡‡Asegurar la muralla‡Asegurar la muralla‡Sécuriser les remparts‡保卫城墙‡保衛城牆',
    nil,
    '‡Убейте гниющего ледяного великана.‡Erledigt den verrottenden Frostriesen.‡‡Mata al gigante de escarcha en podredumbre.‡Mata al gigante de escarcha en podredumbre.‡Tuez le Géant du givre pourrissant.‡‡',
  }
},
[24872] = {
  {
    '‡Отдых для измученной души‡Frieden für eine geschundene Seele‡고통받는 영혼을 위한 유예‡Un respiro para un alma atormentada‡Un respiro para un alma atormentada‡Du répit pour une âme tourmentée‡痛苦灵魂的安息‡受苦靈魂的安息',
    nil,
    '‡Воспользуйтесь кристаллами жизни, чтобы сохранить душу Синдрагосы.‡Benutzt die Lebenskristall, um Sindragosas Essenz zu erhalten.‡고동치는 생명 수정을 사용하여 신드라고사의 정기를 담아야 합니다.‡Usa los cristales de vida para preservar la esencia de Sindragosa.‡Usa los cristales de vida para preservar la esencia de Sindragosa.‡Utilisez les Cristaux de vie pour preserver l\'Essence de Sindragosa.‡‡',
  }
},
[24873] = {
  {
    '‡Болезненная задача‡Wandelnder Wirt‡‡Reunión de residuos‡Reunión de residuos‡Un rendez-vous pour des résidus‡药剂融合‡藥劑融合',
    nil,
    '‡Если вы заразитесь оранжевой и зеленой порчей, вернитесь к алхимику Адрианне.‡Kehrt zu Alchemistin Adrianna zurück, während Ihr mit der orangenen und der grünen Seuche infiziert seid.‡‡Vuelve con la alquimista Adrianna cuando estés $Ginfectado:infectada; con añublo naranja y verde.‡Vuelve con la alquimista Adrianna cuando estés $Ginfectado:infectada; con añublo naranja y verde.‡Retournez voir l\'Alchimiste Adrianna tant que les Chancres orange et vert vous affectent.‡‡',
  }
},
[24874] = {
  {
    '‡Каждая капля крови...‡Erhöhter Blutdruck‡‡Primera sangre‡Primera sangre‡Coup de sang‡鲜血涌动‡鮮血湧動',
    nil,
    '‡Спасите разведчика Минчара прежде, чем его казнят.‡Rettet den Spitzel Minchar, bevor er hingerichtet wird.‡‡Rescata al infiltrado Minchar antes de que lo ejecuten.‡Rescata al infiltrado Minchar antes de que lo ejecuten.‡Sauvez l\'Infiltrateur Minchar avant qu\'il soit exécuté.‡‡',
  }
},
[24875] = {
  {
    '‡Перевербовка‡Entprogrammieren‡‡Desprogramación‡Desprogramación‡Déprogrammation‡思想净化‡思想淨化',
    nil,
    '‡Убейте Леди Смертный Шепот, сохранив жизнь Дарнавану.‡Bezwingt Lady Todeswisper, aber stellt dabei sicher, dass Darnavan überlebt.‡‡Derrota a Lady Susurramuerte y asegúrate de que Darnavan sobrevive.‡Derrota a Lady Susurramuerte y asegúrate de que Darnavan sobrevive.‡Battez Dame Murmemort en vous assurant que Darnavan survive.‡‡',
  }
},
