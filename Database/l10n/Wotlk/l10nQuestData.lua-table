    nil,
  }
},
[8636] = {
  {
    'Troapedra, o Ancião‡Предок Скалогром‡Urahne Rumpelfels‡장로 럼버락‡Rocaestruendo el Ancestro‡Rocaestruendo el Ancestro‡L\'Ancien Pierre-grondante‡巨石长者‡巨石長者',
