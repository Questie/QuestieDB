[13270] = {
  {
    'Buscar panos‡Сбор ткани‡Das Plündern von Stoffen‡옷감 수거법‡Rebuscar tela‡Rebuscar tela‡Récupération de tissu‡布匹搜寻‡布料搜掠',
    nil,
    nil,
  }
},
[13271] = {
  {
    '‡Голос во тьме‡Eine Stimme im Dunklen‡어둠 속의 목소리‡Una voz en la oscuridad‡Una voz en la oscuridad‡Une voix dans l\'obscurité‡黑暗中的声音‡黑暗中的聲音',
    nil,
    '‡Выясните, откуда доносится голос, который вы услышали в Наз\'анаке, Забытых глубинах.‡Untersucht die nahe Stimme in Naz\'anak, den Vergessenen Tiefen.‡망각의 심연 나즈아낙에서 가까이 들리는 목소리를 조사해야 합니다.‡Examina la voz que se oye cerca de ti, en Las Profundidades Olvidadas de Naz\'anak.‡Examina la voz que se oye cerca de ti, en Las Profundidades Olvidadas de Naz\'anak.‡Enquêtez sur la voix toute proche à Naz\'anak, les Profondeurs oubliées.‡在纳扎纳克：遗忘深渊里调查这个声音的来源。‡',
  }
},
[13272] = {
  {
    'Como coletar tecidos‡Сбор ткани‡Das Plündern von Stoffen‡옷감 수거법‡Rebuscar tela‡Rebuscar tela‡Récupération de tissu‡布匹搜寻‡布料搜掠',
    nil,
    nil,
  }
},
[13273] = {
  {
    'Em busca do núcleo‡В поисках ядра‡Dem Kern hinterher‡위치 추적‡En busca del núcleo‡En busca del núcleo‡À la recherche du noyau‡追查诺甘农之核‡追尋核心',
    nil,
    'Encontre as Anotações do Prospector Khrona e os Mapas do Prospector Soren no Acampamento de Brann.‡Найдите записи геолога Хроны и записи геолога Сорена в главном лагере Бранна.‡Geht zu Branns Basislager und sucht nach Ausgrabungsleiter Khronas Notizen und Ausgrabungsleiter Sorens Karten.‡브란의 기지에서 발굴조사단장 크로나의 쪽지와 발굴조사단장 소렌의 지도를 찾아야 합니다.‡Encuentra las notas del prospector Krona y los mapas del prospector Soren en el campamento base de Brann.‡Encuentra las notas del prospector Krona y los mapas del prospector Soren en el campamento base de Brann.‡Trouvez les Notes de la prospectrice Khrona et les Cartes du prospecteur Soren au Campement de Brann.‡在布莱恩的营地寻找勘探员克罗娜的便笺和勘探员索雷的地图。‡在布萊恩營地找出勘察員克羅娜的筆記與勘察員索林的地圖。',
  }
},
[13274] = {
  {
    'O guardião do núcleo‡Хранитель ядра‡Hüter des Kerns‡핵의 수호자‡El vigilante del Núcleo‡El vigilante del Núcleo‡Le gardien du noyau‡诺甘农之核的守护者‡核心的守護者',
    nil,
    'Consiga o Núcleo de Norgannon.‡Добудьте ядро Норганнона.‡Beschafft Norgannons Kern.‡노르간논의 핵을 찾아야 합니다.‡Consigue el núcleo de Norgannon.‡Consigue el núcleo de Norgannon.‡Obtenez le Noyau de Norgannon.‡拿到诺甘农之核。‡取得諾甘農之核。',
  }
},
[13275] = {
  {
    '‡Пора прятаться!‡Zeit zum Verstecken‡숨을 시간‡Hora de esconderse‡Hora de esconderse‡C\'est le moment de se cacher‡藏匿行踪‡快躲起來',
    nil,
    '‡Добудьте 3 образца крови безликих по совету Матиаса Нетлера.‡Matthias Lehner möchte, dass Ihr ihm 3 Proben Blut des Gesichtslosen bringt.‡마시어스 레넷이 얼음왕관 성채에서 얼굴 없는 자의 피 3개를 구해 오라고 했습니다.‡Matthias Lehner quiere que consigas 3 muestras de sangre del ignoto.‡Matthias Lehner quiere que consigas 3 muestras de sangre del ignoto.‡Matthias Lehner vous a demandé d\'obtenir 3 doses de Sang de Sans-visage.‡米斯希尔萨·阿奈尔要你收集3份无面者之血。‡',
  }
},
[13276] = {
  {
    'Abominável!‡Как все погано!‡Das ist monströs!‡혐오스러운 친구‡¡Eso es abominable!‡¡Eso es abominable!‡C\'est abominable !‡你的憎恶伙伴‡有夠討厭!',
    nil,
    'Koltirus Tecemorte, no Martelo de Orgrim, quer que você use o Kit de Reanimação de Abominações para criar uma Abominação Reanimada, e use-a para matar 15 Carniçais do Gelo, 15 Geists Malévolos e 15 Soldados da Aliança Revividos.‡Используйте набор для оживления, чтобы воскресить поганище и убить с его помощью 15 ледяных вурдалаков, 15 агрессивных упырей и 15 восставших солдат Альянса по просьбе Кольтиры Ткача Смерти с "Молота Оргрима".‡Koltira Todesweber auf der Orgrims Hammer möchte, dass Ihr das Monstrositätenwiedererweckungsset benutzt, um eine wiedererweckte Monstrosität zu erschaffen, mit der Ihr dann 15 Eisghule, 15 heimtückische Spuke und 15 auferstandene Soldaten der Allianz töten sollt.‡오그림의 망치호에 있는 콜티라 데스위버가 누더기골렘 부활 도구를 사용해 되살아난 누더기골렘을 만든 다음, 얼음 구울 15마리, 흉포한 외눈깨비 15마리, 되살아난 얼라이언스 병사 15명을 처치해 달라고 부탁했습니다.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que utilices el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que utilices el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande d\'utiliser la Trousse de réanimation d\'abomination pour créer une Abomination réanimée, que vous devez utiliser pour tuer 15 Goules glacées, 15 Geists vicieux et 15 Soldats de l\'Alliance ressuscités.‡奥格瑞姆之锤的库尔迪拉·织亡者要你使用憎恶复活工具包制造一名复活的憎恶，然后利用它杀死15只冰寒食尸鬼、15只残忍的恶鬼和15名复活的联盟士兵。‡奧格林之錘上的寇爾提拉·亡織者要你使用憎惡體再活化工具包創造再活化的憎惡體，並用來殺掉15隻冰結食屍鬼、15隻邪惡的魂屍、15個復活的聯盟士兵。',
  }
},
[13277] = {
  {
    'Contra os gigantes‡Борьба с великанами‡Gegen die Riesen‡거인에 맞서라!‡Contra los gigantes‡Contra los gigantes‡Contre les géants‡对抗巨人‡抵抗巨人族',
    nil,
    'Koltirus Tecemorte, no Martelo de Orgrim, quer que você leve para ele 5 Espinhas Pustulentas dos Horrores Pustulentos em Mord\'rethar.‡Принесите Кольтире Ткачу Смерти на борт "Молота Оргрима" 5 гноящихся позвоночников пустулезных ужасов из Морд\'ретара.‡Koltira Todesweber auf der Orgrims Hammer möchte, dass Ihr ihm 5 pustelige Wirbelsäulen von den pusteligen Schrecken auf Mord\'rethar bringt.‡오그림의 망치호에 있는 콜티라 데스위버가 모드레타르에 있는 공포의 고름 거인에게서 고름투성이 등뼈 5개를 가져다 달라고 부탁했습니다.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que le traigas 5 espinas pustulosas de horrores pustulosos en Mord\'rethar.‡Koltira Tejemuerte en el Martillo de Orgrim quiere que le traigas 5 espinas pustulosas de horrores pustulosos en Mord\'rethar.‡Koltira Tissemort, sur le Marteau d\'Orgrim, vous demande de lui rapporter 5 Épines pustuleuses récupérées sur des Horreurs pustuleuses à Mord\'rethar.‡奥格瑞姆之锤的库尔迪拉·织亡者要你前往莫德雷萨，从血肉巨人身上取回5根奇特的脊骨给他。‡奧格林之錘上的寇爾提拉·亡織者要你從默德雷薩的膿創恐獸身上取得5份膿汁之脊。',
  }
},
[13278] = {
  {
    'Coprous, o Escatológico‡Корпой Оскверненный‡Koprus der Entweihte‡타락자 코프루스‡Coprous el Profanado‡Coprous el Profanado‡Coprous le Profané‡污染者科普洛斯‡污敗的寇普羅斯',
    nil,
    'Koltirus Tecemorte, a bordo do Martelo de Orgrim, quer que você mate Coprous, o Escatológico, em Mord\'rethar.‡Убейте Корпоя Оскверненного из Морд\'ретара по просьбе Кольтиры Ткача Смерти с "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr Koprus den Entweihten bei Mord\'rethar tötet.‡오그림의 망치호에 있는 콜티라 데스위버가 모드레타르에 있는 타락자 코프루스를 처치해 달라고 부탁했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a Coprous el Profanado en Mord\'rethar.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a Coprous el Profanado en Mord\'rethar.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande de tuer Coprous le Profané à Mord\'rethar.‡奥格瑞姆之锤的库尔迪拉·织亡者要你前往莫德雷萨，杀死污染者科普洛斯。‡奧格林之錘上的寇爾提拉·亡織者要你在默德雷薩殺掉污敗的寇普羅斯',
  }
},
[13279] = {
  {
    'Alquimia básica‡Основы химии‡Grundkenntnisse der Chemie‡기초 반응‡Química básica‡Química básica‡La chimie amusante‡化学常识‡基礎化學',
    nil,
    'Koltirus Tecemorte, a bordo do Martelo de Orgrim, quer que você use o Fluido Espinal Pustulento em um caldeirão pestilento em Mord\'rethar.‡Вылейте пустулезную спинномозговую жидкость в чумной котел в Морд\'ретаре по просьбе Кольтиры Ткача Смерти с борта "Молота Оргрима".‡Koltira Todesweber an Bord der Orgims Hammer möchte, dass Ihr pustelige Rückenmarksflüssigkeit in einen Seuchenkessel in Mord\'rethar gießt.‡오그림의 망치호에 있는 콜티라 데스위버가 고름투성이 척수액을 모드레타르의 역병 가마솥에 사용해 달라고 부탁했습니다.‡Kotira Tejemuerte a bordo del Martillo de Orgrimm quiere que uses el líquido de espina pustulosa en una caldera de peste en Mord\'rethar.‡Kotira Tejemuerte a bordo del Martillo de Orgrimm quiere que uses el líquido de espina pustulosa en una caldera de peste en Mord\'rethar.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, veut que vous mettiez du Fluide spinal pustuleux dans un chaudron de peste à Mord\'rethar.‡奥格瑞姆之锤的库尔迪拉·织亡者希望你前往莫德雷萨，将脊骨脓液倒进那里的瘟疫之锅。‡奧格林之錘上的寇爾提拉·亡織者要你在默德雷薩的瘟疫大鍋使用膿汁脊髓液。',
  }
},
[13280] = {
  {
    'O rei da montanha‡Царь горы‡König der Berge‡등산의 제왕‡Rey de la montaña‡Rey de la montaña‡Roi de la montagne‡占山为王‡山脈之王',
    nil,
    'Klaudia Chave-de-fenda, em Ymarheim, quer que você use o Saltotron de Chave-de-fenda para colocar o Estandarte de Batalha da Aliança nos crânios do topo da montanha.‡Используйте прыгобот Зуботески, чтобы установить боевой штандарт Альянса в груде черепов на вершине горы, по просьбе Фраззл Зуботески.‡Fetzi Gangzwinger in Ymirheim möchte, dass Ihr ihren Hüpfboter benutzt, um die Schlachtstandarte der Allianz in den Schädelhaufen auf dem Gipfel des Berges zu stecken.‡이미르하임의 프라즐 기어그라인더가 자신의 도약로봇을 사용하여 산 정상의 해골 더미에 얼라이언스 전투 깃발을 꽂아 달라고 부탁했습니다.‡Desgastada Cadenas en Ymirheim quiere que uses el saltarrobot de Cadenas para plantar el confalón de batalla de la Alianza en las calaveras de la colina de la montaña.‡Desgastada Cadenas en Ymirheim quiere que uses el saltarrobot de Cadenas para plantar el confalón de batalla de la Alianza en las calaveras de la colina de la montaña.‡Flagade Ecrouabouille, à Ymirheim, vous demande d\'utiliser son Sautomate d\'Ecrouabouille pour planter l\'Étendard de bataille de l\'Alliance dans les crânes au sommet de la montagne.‡伊米海姆的弗拉索·磨轮要你使用弗拉索的跳跃机器人，将联盟军旗插到山顶的徽记堆上。‡依米海姆的芙芮索·齒研要你用她的齒研彈跳機器人跳上山頂並在骸骨堆放置聯盟戰旗。',
  }
},
[13281] = {
  {
    '‡Избавление от чумы‡Die Seuche neutralisieren‡역병 중화‡Neutralizar la peste‡Neutralizar la peste‡Neutraliser la peste‡中和瘟疫‡',
    nil,
    '‡По приказу Кольтиры Ткача Смерти с "Молота Оргрима" отправляйтесь в Морд\'ретар и нейтрализуйте содержимое чумного котла с помощью пустулезной спинномозговой жидкости.|n|nПустулезная спинномозговая жидкость изготовляется из позвоночника великана. Его можно получить, убивая пустулезных ужасов.‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr pustelige Rückenmarksflüssigkeit in einen Kessel bei Mord\'rethar schüttet.|n|nPustelige Rückenmarksflüssigkeit kann dadurch gewonnen werden, indem man das Fleischriesenrückgrat eines pusteligen Schreckens benutzt.‡오그림의 망치호에 있는 콜티라 데스위버가 고름투성이 척수액을 모드레타르에 있는 파멸의 역병 가마솥에 사용해 달라고 했습니다.|n|n고름투성이 척수액은 공포의 고름 거인에게서 살덩이 거인 등뼈를 구하여 만들 수 있습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que uses el líquido de espina pustulosa en una caldera de añublo en Mord\'rethar.|n|nPuedes obtener líquido de espina pustulosa usando una espina gigante que recojas de un horror pustuloso.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que uses el líquido de espina pustulosa en una caldera de añublo en Mord\'rethar.|n|nPuedes obtener líquido de espina pustulosa usando una espina gigante que recojas de un horror pustuloso.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, veut que vous utilisiez du Fluide spinal pustuleux sur un Chaudron de chancre à Mord\'rethar.|n|nVous pouvez créer du Fluide spinal pustuleux en utilisant une Épine dorsale de géant provenant d\'une Horreur pustuleuse.‡‡',
  }
},
[13282] = {
  {
    '‡Возвращение на поверхность‡Rückkehr an die Oberfläche‡지상으로 돌아가기‡Regresa a la superficie‡Regresa a la superficie‡Retour vers la surface‡返回地面‡',
    nil,
    '‡Возвращайтесь к Кольтире Ткачу Смерти на борт "Молота Оргрима".‡Kehrt zu Koltira Todesweber an Bord der Orgrims Hammer zurück.‡오그림의 망치호에 있는 콜티라 데스위버에게 가야 합니다.‡Vuelve con Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Vuelve con Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Retournez voir Koltira Tissemort à bord du Marteau d\'Orgrim.‡‡',
  }
},
[13283] = {
  {
    'O rei da montanha‡Царь горы‡König der Berge‡등산의 제왕‡Rey de la montaña‡Rey de la montaña‡Le roi de la montagne‡占山为王‡山脈之王',
    nil,
    'Tonico Pipoco, em Ymarheim, quer que você use o Saltotron dele para colocar o Estandarte de Batalha da Horda nos crânios no topo da montanha.‡Используйте прыгобот Громбабаха, чтобы установить боевой штандарт Орды в груде черепов на вершине горы, по просьбе Бубуха Громбабаха.‡Bumm Donnerbombe in Ymirheim möchte, dass Ihr seinen Hüpfboter benutzt, um die Schlachtstandarte der Horde in den Schädelhaufen auf dem Gipfel des Berges zu stecken.‡이미르하임의 블라스트 썬더봄이 자신의 도약로봇을 사용하여 산 정상의 해골 더미에 호드 전투 깃발을 꽂아 달라고 부탁했습니다.‡Devastador Bombatrueno en Ymirheim quiere que uses el saltarrobot de Bombatrueno para plantar el confalón de batalla de la Horda en las calaveras de la colina de la montaña.‡Devastador Bombatrueno en Ymirheim quiere que uses el saltarrobot de Bombatrueno para plantar el confalón de batalla de la Horda en las calaveras de la colina de la montaña.‡Exploz Tonnebombe, à Ymirheim, vous demande d\'utiliser son Sautomate de Tonnebombe pour planter des Etendards de bataille de la Horde dans des crânes au sommet de la montagne.‡伊米海姆的布拉斯·炸雷要你使用布拉斯的跳跃机器人，将部落军旗插到山顶的徽记堆上。‡依米海姆的轟擊·雷彈要你用他的雷彈彈跳機器人跳上山頂，並在骸骨堆放置部落戰旗。',
  }
},
[13284] = {
  {
    'Ataque terrestre‡Атака пехоты‡Bodenangriff‡지상 공격‡Asalto por tierra‡Asalto por tierra‡Assaut terrestre‡地面突袭‡地面突襲',
    nil,
    'Escolte as tropas do Rompe-céus até os portões de Ymarheim. Depois que completar sua missão, fale com o Comandante Terrestre Koup na borda do glaciar a leste de Ymarheim para receber sua recompensa.‡Сопроводите войска "Усмирителя небес" к вратам Имирхейма. Выполнив задание, вернитесь на край ледника к востоку от Имирхейма к военачальнику Купу за наградой.‡Eskortiert die Truppen der Himmelsbrecher zu den Toren von Ymirheim. Kehrt zu Feldkommandant Koup am Rand des Gletschers im Norden von Ymirheim zurück, nachdem Eure Aufgabe abgeschlossen ist, und holt Eure Belohnung ab.‡하늘파괴자 병사들을 이미르하임의 관문까지 호위하여야 합니다. 임무를 마친 뒤, 이미르하임 동쪽 빙하의 가장자리로 돌아와 그곳에 있는 지상군 사령관 쿠프로부터 임무에 대한 보상을 받아야 합니다.‡Escolta a las tropas de El Rompecielos hasta las puertas de Ymirheim y vuelve junto al comandante de tierra Koup en el borde del glaciar al este de Ymirheim. Te compensará cuando completes esta tarea.‡Escolta a las tropas de El Rompecielos hasta las puertas de Ymirheim y vuelve junto al comandante de tierra Koup en el borde del glaciar al este de Ymirheim. Te compensará cuando completes esta tarea.‡Escortez le Transport de troupe du Brise-ciel jusqu\'aux portes d\'Ymirheim. Retournez voir le Commandant Koup au bord du glacier à l\'est d\'Ymirheim pour obtenir une compensation une fois la tâche terminée.‡护送破天号部队抵达伊米海姆的门口。完成任务后返回伊米海姆东面的冰川边缘，向地面指挥官库普复命。‡護送破天者軍隊抵達依米海姆的入口。回報給依米海姆東面冰冠邊緣的地面指揮官庫普來獲得你的任務報酬。',
  }
},
[13285] = {
  {
    'Forjando a pedra-chave‡Изготовление краеугольного камня‡Den Schlüsselstein schmieden‡쐐기돌 벼려내기‡La forja de la piedra angular‡La forja de la piedra angular‡Forger la pierre-clé‡铸造钥石‡打造鑰匙',
    nil,
    'Brann Barbabronze quer que você o encontre no Templo da Invenção e o ajude a unir o Invólucro de Norgannon ao Núcleo de Norgannon. Depois de ajudar Brann, apresente-se novamente a Boktar Furissangue no Local da Queda de Grom\'arsh.‡Встретьтесь с Бранном Бронзобородом в Храме Изобретений и помогите Бранну сложить вместе оболочку Норганнона и ядро Норганнона. После этого вернитесь к Боктару Кровавому Безумию на место крушения Гром\'арша.‡Brann Bronzebart möchte, dass Ihr ihn im Tempel des Erfindungsreichtums trefft und ihm dabei helft, Norgannons Schale und Norgannons Kern zusammenzufügen. Meldet Euch bei Boktar Blutfurie bei der Absturzstelle Grom\'ash, sobald dies getan ist.‡브란 브론즈비어드가 발명의 신전에서 만나 노르간논의 껍질과 노르간논의 핵을 합치는 일을 도와달라고 부탁했습니다. 브란을 도운 후에 그롬아쉬 추락 지점에 있는 복타르 블러드퓨리에게 보고해야 합니다.‡Brann Barbabronce quiere que te reúnas con él en el Templo de la Invención y que le ayudes a combinar el caparazón de Norgannon y el núcleo de Norgannon. Cuando le hayas ayudado, vuelve a hablar con Boktar Furia Sangrienta en el lugar del accidente Grom\'arsh.‡Brann Barbabronce quiere que te reúnas con él en el Templo de la Invención y que le ayudes a combinar el caparazón de Norgannon y el núcleo de Norgannon. Cuando le hayas ayudado, vuelve a hablar con Boktar Furia Sangrienta en el lugar del accidente Grom\'arsh.‡Brann Barbe-de-bronze vous demande de le rejoindre au Temple de l\'Innovation et de l\'aider à combiner la Coque de Norgannon et le Noyau de Norgannon. Une fois que vous aurez aidé Brann, retournez voir Boktar Rougefurie au Point d\'impact de Grom\'arsh.‡布莱恩·铜须希望你和他在创世神殿碰头，帮助他把诺甘农之壳和诺甘农之核组合起来。等你完成了帮助布莱恩的使命之后，回到格罗玛什坠毁点，向伯克塔·血怒复命。‡布萊恩·銅鬚要你在發明神殿與他會合並且結合諾甘農之殼與諾甘農之核。一旦你協助布萊恩·銅鬚之後便回報給葛羅姆亞什失事地的博克塔·血怒。',
  }
},
[13286] = {
  {
    '...Toda a ajuda que conseguirmos‡Хоть какая-нибудь помощь!‡... Jede Hilfe, die wir kriegen können‡모든 도움을 얻어라‡…Toda la ayuda que podamos conseguir‡…Toda la ayuda que podamos conseguir‡… Toute l\'aide qu\'on peut obtenir‡……所有可能的帮助‡竭盡所能',
    nil,
    'O Alto-capitão Justino Bartolotto, a bordo do Rompe-céus, quer que você fale com Thassarian.‡Поговорите с Тассарианом по просьбе старшего капитана Джастина Бартлетта на борту "Усмирителя небес".‡Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher möchte, dass Ihr mit Thassarian sprecht.‡하늘파괴자호에 탄 수석 선장 저스틴 바틀릿이 타사리안과 대화해봐 달라고 부탁했습니다.‡El gran capitán Justin Bartlett a bordo de El Rompecielos quiere que hables con Thassarian.‡El gran capitán Justin Bartlett a bordo de El Rompecielos quiere que hables con Thassarian.‡Le Grand capitaine Justin Bartlett, à bord du Brise-ciel, veut que vous parliez à Thassarian.‡破天号的高级指挥官加斯汀·巴雷特要你与萨萨里安谈一谈。‡破天者號上的提督賈斯汀·巴特勒要你與薩沙理安交談。',
  }
},
[13287] = {
  {
    'Fura e perfura‡Тычки и тумаки‡Stupsen und stoßen‡적을 알아내는 법‡Codazo y pinchazo‡Codazo y pinchazo‡Titiller l\'ennemi‡知己知彼‡刺探',
    nil,
    'Thassarian, na Belonave da Aliança, o Rompe-céus, quer que você mate 5 Abominações Abrutalhadas, 5 Necromantes Maléficos e 5 Adeptos das Sombras no Front Partido.‡Убейте 5 неповоротливых поганищ, 5 злокозненных некромантов и 5 адептов Тьмы по просьбе Тассариана, находящегося на борту "Усмирителя небес", корабля Альянса.‡Thassarian auf der Himmelsbrecher möchte, dass Ihr 5 bullige Monstrositäten, 5 bösartige Totenbeschwörer und 5 Schattenadepten bei der Zerbrochenen Front tötet.‡얼라이언스 비행포격선인 하늘파괴자호에 있는 타사리안이 파괴된 싸움터에 있는 덩치 큰 누더기골렘 5마리, 재앙의 강령술사 5마리, 어둠의 숙련사제 5명을 처치해 달라고 부탁했습니다.‡Thassarian en el barco de la Alianza, El Rompecielos, quiere que mates a 5 abominaciones descomunales, a 5 nigromantes malévolos y 5 adeptos de sombra en El Frente Roto.‡Thassarian, en el barco de la Alianza, El Rompecielos, quiere que mates a 5 abominaciones descomunales, a 5 nigromantes maléficos y a 5 adeptos de sombra en El Frente Roto.‡Thassarian, sur la Canonnière de l\'Alliance, le Brise-ciel, vous demande de tuer 5 Abominations massives, 5 Nécromanciens maléfiques et 5 Adeptes des ombres au Front brisé.‡破天号上的萨萨里安要你前往破碎前线，杀死5名笨重的憎恶、5名邪恶通灵师和5名暗影专家。‡破天者號上的薩沙理安要你前往破碎前線，並擊敗5隻笨重的憎惡體、5位毒惡的死靈法師，與5位暗影菁英。',
  }
},
[13288] = {
  {
    'Abominável!‡Как все погано!‡Das ist monströs!‡혐오스러운 친구‡¡Eso es abominable!‡¡Eso es abominable!‡C\'est abominable !‡你的憎恶伙伴‡有夠討厭!',
    nil,
    'Thassarian, no Rompe-céus, quer que você use o Kit de Reanimação de Abominações para criar uma Abominação Reanimada, que você deve usar para matar 15 Carniçais do Gelo, 15 Geists Malévolos e 15 Soldados da Aliança Revividos.‡Используйте набор для оживления, чтобы воскресить поганище и убить с его помощью 15 ледяных вурдалаков, 15 агрессивных упырей и 15 восставших солдат Альянса по просьбе Тассариана с "Усмирителя Небес".‡Thassarian auf der Himmelsbrecher möchte, dass Ihr das Wiederbelebungsset für Monstrositäten benutzt, um eine wiedererweckte Monstrosität zu erschaffen, mit der Ihr 15 Eisghule, 15 heimtückische Spuke und 15 auferstandene Soldaten der Allianz töten sollt.‡하늘파괴자호에 있는 타사리안이 누더기골렘 부활 도구를 사용하여 얼음 구울, 흉포한 외눈깨비, 되살아난 얼라이언스 병사 각각 15마리를 처치하는 데 이용할 수 있는 되살아난 누더기골렘을 만들어 달라고 부탁했습니다.‡Thassarian en El Rompecielos quiere que uses el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Thassarian en El Rompecielos quiere que uses el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Thassarian, à bord du Brise-ciel, vous demande d\'utiliser la Trousse de réanimation d\'abomination pour créer une Abomination réanimée, que vous devez utiliser pour tuer 15 Goules glacées, 15 Geists vicieux et 15 Soldats de l\'Alliance ressuscités.‡破天号上的萨萨里安要你使用憎恶复活工具包制造一名复活的憎恶，然后利用它杀死15只冰寒食尸鬼、15只残忍的恶鬼和15名复活的联盟士兵。‡破天者號上的薩沙理安要你使用憎惡體再活化工具包創造再活化的憎惡體，並用來殺掉15隻冰結食屍鬼、15隻邪惡的魂屍、15個復活的聯盟士兵。',
  }
},
[13289] = {
  {
    'Abominável!‡Как все погано!‡Das ist monströs!‡혐오스러운 친구‡¡Eso es abominable!‡¡Eso es abominable!‡C\'est abominable !‡你的憎恶伙伴‡有夠討厭!',
    nil,
    'Thassarian, no Rompe-céus, quer que você use o Kit de Reanimação de Abominações para criar uma Abominação Reanimada, a qual deve matar 15 Carniçais do Gelo, 15 Geists Malévolos e 15 Soldados da Aliança Revividos.‡Используйте набор для оживления, чтобы воскресить поганище и убить с его помощью 15 ледяных вурдалаков, 15 агрессивных упырей и 15 восставших солдат Альянса по просьбе Тассариана с "Усмирителя небес".‡Thassarian auf der Himmelsbrecher möchte, dass Ihr das Wiederbelebungsset für Monstrositäten benutzt, um eine wiedererweckte Monstrosität zu erschaffen, mit der Ihr 15 Eisghule, 15 heimtückische Spuke und 15 auferstandene Soldaten der Allianz töten sollt.‡하늘파괴자호에 있는 타사리안이 누더기골렘 부활 도구를 사용하여 되살아난 누더기골렘을 만들어 얼음 구울 15마리, 흉포한 외눈깨비 15마리, 되살아난 얼라이언스 병사 15명을 처치해 달라고 부탁했습니다.‡Thassarian en El Rompecielos quiere que uses el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Thassarian en El Rompecielos quiere que uses el equipo de reanimación de abominaciones para crear una abominación reanimada que debes usar para matar a 15 necrófagos de Hielo, a 15 geists sañosos y a 15 soldados de la Alianza resucitados.‡Thassarian, à bord du Brise-ciel,vous demande d\'utiliser la Trousse de réanimation d\'abomination pour créer une Abomination réanimée, que vous devez utiliser pour tuer 15 Goules glacées, 15 Geists vicieux et 15 Soldats de l\'Alliance ressuscités.‡破天号上的萨萨里安要你使用憎恶复活工具包制造一名复活的憎恶，然后利用它杀死15只冰寒食尸鬼、15只残忍的恶鬼和15名复活的联盟士兵。‡破天者號上的薩沙理安要你使用憎惡體再活化工具包創造再活化的憎惡體，並用來殺掉15隻冰結食屍鬼、15隻邪惡的魂屍、15個復活的聯盟士兵。',
  }
},
[13290] = {
  {
    'Atenção, por favor‡Немного внимания‡Bitte recht aufmerksam‡주목해 주세요‡Atención, por favor‡Atención, por favor‡Votre attention, s\'il vous plaît‡请留意一下……‡照過來!',
    nil,
    'O Alto-capitão Justino Bartolotto quer que você fale com o Engenheiro-chefe Pertaporca no Rompe-céus.‡Поговорите с главным инженером Болтоключом на борту "Усмирителя небес" по просьбе старшего капитана Джастина Бартлетта.‡Stabshauptmann Bartlett möchte, dass Ihr mit Chefingenieur Bolzenschlüssel in der Himmelsbrecher redet.‡수석 선장 바틀릿이 하늘파괴자호에 있는 선임기술자 볼트렌치와 대화해 달라고 부탁했습니다.‡El gran capitán Bartlett quiere que hables con el ingeniero jefe Aprietatuercas en El Rompecielos.‡El gran capitán Bartlett quiere que hables con el ingeniero jefe Aprietatuercas en El Rompecielos.‡Le Grand capitaine Bartlett vous demande de parler à l\'Ingénieur en chef Vrilleboulon à bord du Brise-ciel.‡高级指挥官加斯汀·巴雷特要你与破天号的首席技师波尔维克谈一谈。‡破天者號上的提督巴特勒要你去跟首席工程師栓鉗說話。',
  }
},
[13291] = {
  {
    'Tecnologia emprestada‡Заимствованная технология‡Geliehene Technologie‡기술 차용‡Tecnología prestada‡Tecnología prestada‡Technologie empruntée‡“借来”的技术‡借來的科技',
    nil,
    'O Engenheiro-chefe Pertaporca, a bordo do Rompe-céus, quer que você use a Solução Afanada no Front Partido.|n|nPara usar a solução, é necessário um Elmo Abandonado, uma Armadura Abandonada e uma Pilha de Ossos, todos encontrados no Front Partido.‡Используйте краденый раствор на Прорванном фронте по просьбе главного инженера Болтоключа на борту "Усмирителя небес".|n|nДля этого вам понадобится брошенный шлем, брошенная броня и груда костей. Все это можно найти на Прорванном фронте.‡Chefingenieur Bolzenschlüssel an Bord der Himmelsbrecher will, dass Ihr die geschmuggelte Lösung an der Zerbrochenen Front benutzt. Um die Lösung zu benutzen, braucht Ihr einen zurückgelassenen Helm, eine zurückgelassene Rüstung und einen Knochenhaufen, die allesamt an der Zerbrochenen Front gefunden werden müssen.‡하늘파괴자호의 선임기술자 볼트렌치가 파괴된 싸움터에서 밀수한 용해제를 사용해 달라고 부탁했습니다.|n|n용해제를 사용하려면 파괴된 싸움터에서 버려진 투구, 버려진 갑옷, 해골 더미를 구해야 합니다.‡El ingeniero jefe Aprietatuercas en El Rompecielos quiere que utilices la solución de contrabando en El Frente Roto.|n|nPara utilizar la solución es necesario un yelmo abandonado, una armadura abandonada, y un montón de huesos. Todos ellos se encuentran en El Frente Roto.‡El ingeniero jefe Aprietatuercas en El Rompecielos quiere que utilices la solución de contrabando en El Frente Roto.|n|nPara utilizar la solución es necesario un yelmo abandonado, una armadura abandonada, y un montón de huesos. Todos ellos se encuentran en El Frente Roto.‡L\'Ingénieur en chef Vrilleboulon, à bord du Brise-ciel, vous demande d\'utiliser la Solution de contrebande au Front brisé.|n|nPour utiliser la solution, vous aurez besoin du Heaume abandonné, de l\'Armure abandonnée et de la Pile d\'ossements, que vous trouverez au Front brisé.‡破天号上的首席技师波尔维克要你在破碎前线使用偷来的液体。|n|n你需要收集被丢弃的头盔、被丢弃的护甲和一堆白骨才能召唤假人，这些材料都可以在破碎前线找到。‡破天者號上的首席工程師栓鉗要你去破碎前線上使用私運溶劑。|n|n使用溶劑必須要具有被遺棄的頭盔、被遺棄的盔甲與骨堆，都可於破碎前線尋得。',
  }
},
[13292] = {
  {
    'A solução da solução‡Решение проблемы‡Die Lösungslösung‡분해 용액‡La solución solución‡La solución solución‡La solution pour la solution‡偷来的解决方案‡溶劑就是好計',
    nil,
    'O Engenheiro-chefe Pertaporca, a bordo do Rompe-céus, quer que você use a Solução Afanada no Front Partido.|n|nPara usar a solução, é necessário um Elmo Abandonado, uma Armadura Abandonada e uma Pilha de Ossos, todos encontrados no Front Partido.‡Используйте краденый раствор на Прорванном фронте по просьбе главного инженера Болтоключа на борту "Усмирителя небес".|n|nДля этого вам понадобится брошенный шлем, брошенная броня и груда костей. Все это можно найти на Прорванном фронте.‡Chefingenieur Bolzenschlüssel an Bord der Himmelsbrecher möchte, dass Ihr die geschmuggelte Lösung an der zerbrochenen Front einsetzt.|n|nUm die Lösung benutzen zu können, benötigt Ihr einen zurückgelassenen Helm, zurückgelassene Rüstung und einen Knochenhaufen, die alle an der zerbrochenen Front zu finden sind.‡하늘파괴자호의 선임기술자 볼트렌치가 파괴된 싸움터에서 밀수한 용해제를 사용해 달라고 부탁했습니다.|n|n용해제를 사용하려면 파괴된 싸움터에서 버려진 투구, 버려진 갑옷, 해골 더미를 구해야 합니다.‡El ingeniero jefe Aprietatuercas en El Rompecielos quiere que utilices la solución de contrabando en El Frente Roto.|n|nPara utilizar la solución es necesario un yelmo abandonado, una armadura abandonada, y un montón de huesos. Todos ellos se encuentran en El Frente Roto.‡El ingeniero jefe Aprietatuercas en El Rompecielos quiere que utilices la solución de contrabando en El Frente Roto.|n|nPara utilizar la solución es necesario un yelmo abandonado, una armadura abandonada, y un montón de huesos. Todos ellos se encuentran en El Frente Roto.‡L\'Ingénieur en chef Vrilleboulon, à bord du Brise-ciel, veut que vous utilisez la Solution de contrebande au Front brisé.|n|nPour utiliser la Solution, vous aurez besoin d\'un Heaume abandonné, d\'une Armure abandonnée et d\'une Pile d\'ossements, que vous trouverez au Front brisé.‡破天号上的首席技师波尔维克要你在破碎前线使用偷来的液体。|n|n你需要收集被丢弃的头盔、被丢弃的护甲和一堆白骨才能召唤假人，这些材料都可以在破碎前线找到。‡破天者號上的首席工程師栓鉗要你去破碎前線上使用私運溶劑。|n|n使用溶劑必須要具有被遺棄的頭盔、被遺棄的盔甲與骨堆，都可於破碎前線尋得。',
  }
},
[13293] = {
  {
    'Vá a Ymarheim!‡В Имирхейм!‡Auf nach Ymirheim!‡이미르하임을 향하여!‡¡Llega a Ymirheim!‡¡Llega a Ymirheim!‡Rendons-nous à Ymirheim !‡前往伊米海姆！‡前進依米海姆!',
    nil,
    'Fale com Tonico Pipoco em Ymarheim.‡Поговорите с Бубухом Громбабахом в Имирхейме.‡Redet mit Bumm Donnerbombe in Ymirheim.‡이미르하임에 있는 블라스트 썬더봄과 대화해야 합니다.‡Habla con Devastador Bombatrueno en Ymirheim.‡Habla con Devastador Bombatrueno en Ymirheim.‡Parler à Exploz Tonnebombe à Ymirheim.‡与伊米海姆的布拉斯·炸雷谈一谈。‡與依米海姆的轟擊·雷彈交談。',
  }
},
[13294] = {
  {
    'Contra os gigantes‡Борьба с великанами‡Gegen die Riesen‡거인에 맞서라!‡Contra los gigantes‡Contra los gigantes‡Contre les géants‡对抗巨人‡抵抗巨人族',
    nil,
    'Thassarian, no Rompe-céus, quer que você leve 5 Espinhas Pustulentas dos Horrores Pustulentos em Mord\'rethar.‡Принесите Тассариану с "Усмирителя небес" 5 позвоночников пустулезных ужасов из Морд\'ретара.‡Thassarian auf der Himmelsbrecher möchte, dass Ihr ihm 5 pustelige Wirbelsäulen von den pusteligen Spuken auf Mord\'rethar bringt.‡하늘파괴자호에 있는 타사리안이 모드레타르에 있는 공포의 고름 거인으로부터 고름투성이 등뼈 5개를 가져다 달라고 부탁했습니다.‡Thassarian en El Rompecielos quiere que le traigas 5 espinas pustulosas de los horrores pustulosos en Mord\'rethar.|n‡Thassarian en El Rompecielos quiere que le traigas 5 espinas pustulosas de los horrores pustulosos en Mord\'rethar.|n‡Thassarian, à bord du Brise-ciel, vous a demandé de lui apporter 5 Épines pustuleuses d\'Horreurs pustuleuses à Mord\'rethar.‡破天号上的萨萨里安要你前往莫德雷萨，从起脓的血肉巨人身上取回5根起脓的脊骨给他。‡破天者號上的薩沙理安要你從默德雷薩的膿創恐獸身上取得5份膿汁之脊。',
  }
},
[13295] = {
  {
    'Alquimia básica‡Основы химии‡Grundkenntnisse der Chemie‡기초 반응‡Química básica‡Química básica‡La chimie amusante‡化学常识‡基礎化學',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você use o Fluido Espinal Pustulento em um caldeirão pestilento em Mord\'rethar.‡Вылейте пустулезную спинномозговую жидкость в чумной котел в Морд\'ретаре по просьбе Тассариана на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr pustelige Rückenmarksflüssigkeit in einen Seuchenkessel in Mord\'rethar gießt.‡하늘파괴자호에 있는 타사리안이 고름투성이 척수액을 모드레타르의 역병 가마솥에 사용해 달라고 부탁했습니다.‡Thassarian a bordo de El Rompecielos quiere que uses el líquido de espina pustulosa en una caldera de peste en Mord\'rethar.‡Thassarian a bordo de El Rompecielos quiere que uses el líquido de espina pustulosa en una caldera de peste en Mord\'rethar.‡Thassarian, à bord du Brise-ciel, vous demande d\'utiliser le Fluide spinal pustuleux sur un Chaudron de peste à Mord\'rethar.‡破天号上的萨萨里安希望你前往莫德雷萨，将脊骨脓液倒进那里的瘟疫之锅。‡破天者號上的薩沙理安要你在默德雷薩的瘟疫大鍋使用膿汁脊髓液。',
  }
},
[13296] = {
  {
    'Vá à Ymarheim!‡В Имирхейм!‡Auf nach Ymirheim!‡이미르하임을 향하여!‡¡Llega a Ymirheim!‡¡Llega a Ymirheim!‡Rendons-nous à Ymirheim !‡前往伊米海姆！‡前進依米海姆!',
    nil,
    'Fale com Klaudia Chave-de-fenda em Ymarheim.‡Поговорите с Фраззл Зуботеской в Имирхейме.‡Sprecht mit Fetzi Gangzwinger in Ymirheim.‡이미르하임에 있는 프라즐 기어그라인더와 이야기해야 합니다.‡Habla con Desgastada Cadenas en Ymirheim.‡Habla con Desgastada Cadenas en Ymirheim.‡Parler à Flagade Ecrouabouille à Ymirheim.‡与伊米海姆的弗拉索·磨轮谈一谈。‡與依米海姆的芙芮索·齒研交談。',
  }
},
[13297] = {
  {
    'Neutralizando a peste‡Избавление от чумы‡Die Seuche neutralisieren‡역병 중화‡Neutralizar la peste‡Neutralizar la peste‡Neutraliser la peste‡中和瘟疫‡中和瘟疫',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você use o Fluido Espinal Pustulento em um caldeirão pestilento em Mord\'rethar.|n|nVocê pode criar o Fluido Espinal Pustulento usando uma Espinha Gigante obtida de um Horror Pustulento.‡По приказу Тассариана с "Усмирителя небес" отправляйтесь в Морд\'ретар и нейтрализуйте содержимое чумного котла с помощью пустулезной спинномозговой жидкости.|n|nПустулезная спинномозговая жидкость изготовляется из позвоночника великана. Его можно получить, убивая пустулезных ужасов.‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr pustelige Rückenmarksflüssigkeit in einen Kessel bei Mord\'rethar schüttet.|n|nPustelige Rückenmarksflüssigkeit kann dadurch gewonnen werden, indem man das Fleischriesenrückgrat eines pusteligen Schreckens benutzt.‡하늘파괴자호에 있는 타사리안이 고름투성이 척수액을 모드레타르에 있는 파멸의 역병 가마솥에 사용해 달라고 부탁했습니다.|n|n고름투성이 척수액은 공포의 고름 거인에게서 살덩이 거인 등뼈를 구해 만들 수 있습니다.‡Thassarian a bordo de El Rompecielos quiere que uses el líquido de espina pustulosa en una caldera de añublo en Mord\'rethar.|n|nPuedes obtener líquido de espina pustulosa usando una espina gigante que recojas de un horror pustuloso.‡Thassarian a bordo de El Rompecielos quiere que uses el líquido de espina pustulosa en una caldera de añublo en Mord\'rethar.|n|nPuedes obtener líquido de espina pustulosa usando una espina gigante que recojas de un horror pustuloso.‡Thassarian, à bord du Brise-ciel, vous demande d\'utiliser du Fluide spinal pustuleux sur un Chaudron de peste à Mord\'rethar.|n|nVous pouvez créer du Fluide spinal pustuleux en utilisant une Épine dorsale de géant récupérée sur une Horreur pustuleuse.‡破天号上的萨萨里安希望你前往莫德雷萨，将脊骨脓液倒进那里的瘟疫之锅。|n|n你可以使用从起脓的血肉巨人身上收集而来的脊骨制造脓液。‡破天者號上的薩沙理安要你在默德雷薩的瘟疫大鍋上使用膿汁脊髓液。|n|n你可以使用從膿創恐獸身上取得的巨人之脊來蒐集膿汁脊髓液。',
  }
},
[13298] = {
  {
    'Coprous, o Escatológico‡Корпой Оскверненный‡Koprus der Entweihte‡타락자 코프루스‡Coprous el Profanado‡Coprous el Profanado‡Coprous le Profané‡污染者科普洛斯‡污敗的寇普羅斯',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você mate Coprous, o Escatológico, em Mord\'rethar.‡Убейте Корпоя Оскверненного из Морд\'ретара по просьбе Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr Koprus den Entweihten in Mord\'rethar tötet.‡하늘파괴자호에 있는 타사리안이 모드레타르에 있는 타락자 코프루스를 처치해 달라고 부탁했습니다.‡Thassarian a bordo de El Rompecielos quiere que mates a Coprous el Profanado en Mord\'rethar.‡Thassarian a bordo de El Rompecielos quiere que mates a Coprous el Profanado en Mord\'rethar.‡Thassarian, à bord du Brise-ciel, vous demande de tuer Coprous le Profané à Mord\'rethar.‡破天号上的萨萨里安要你前往莫德雷萨，杀死污染者科普洛斯。‡破天者號上的薩沙理安要你在默德雷薩殺掉污敗的寇普羅斯。',
  }
},
[13299] = {
  {
    'ZZOLDWisp Cloak‡zzOLDПлащ огонька‡ZZOLDWisp Cloak‡위습 망토‡ZZOLDWisp Cloak‡ZZOLDWisp Cloak‡ZZOLD Cape de feu follet‡ZZOLDWisp Cloak‡ZZOLD幽光披風',
    nil,
    nil,
  }
},
[13300] = {
  {
    'Escravos da Saronita‡Рабы саронитовых шахт‡Vom Saronit abhängig‡사로나이트의 노예‡Esclavos de la saronita‡Esclavos de la saronita‡Esclaves de la saronite‡萨隆邪铁的奴隶‡搶救薩鋼礦奴',
    nil,
    'Absalan, o Pio, a bordo do Rompe-céus, quer que você resgate 10 Escravos da Mina de Saronita.‡Абсалан Благочестивый, находящийся на борту "Усмирителя небес", просит вас освободить 10 рабов из саронитовых шахт.‡Absalan der Fromme an Bord der Himmelsbrecher möchte, dass Ihr 10 Saronitminensklaven rettet.‡하늘파괴자호에 승선한 신앙심 깊은 압살란이 사로나이트 광산 노예 10명을 구출해 달라고 부탁했습니다.‡Absalan el Piadoso a bordo de El Rompecielos quiere que rescates a 10 esclavos de las minas de saronita.‡Absalan el Piadoso a bordo de El Rompecielos quiere que rescates a 10 esclavos de las Minas de Saronita.‡Absalan le Pieux, à bord du Brise-ciel, vous a demandé de sauver 10 Esclaves des mines de saronite.‡破天号上的虔诚的阿布萨兰要你去营救10名萨隆邪铁矿洞奴隶。‡破天者號上的虔誠的亞柏薩倫請你去援救10名薩鋼礦坑奴隸。',
  }
},
[13301] = {
  {
    'Ataque terrestre‡Атака пехоты‡Bodenangriff‡지상 공격‡Asalto por tierra‡Asalto por tierra‡Assaut terrestre‡地面突袭‡地面突襲',
    nil,
    'Escolte as tropas de Kor\'kron para os portões de Ymarheim. Depois que completar sua missão, fale com o Comandante Terrestre Xutja na borda do glaciar ao norte de Ymarheim para receber sua recompensa.‡Сопроводите кор\'кронские войска к вратам Имирхейма. Выполнив задание, вернитесь на край ледника к северу от Имирхейма к командиру наземных войск Ксутье за наградой.‡Eskortiert die Truppen der Kor\'kron zu den Toren von Ymirheim. Kehrt zu Feldkommandant Xutjja an der Kante des Gletschers im Norden von Ymirheim zurück, nachdem Eure Aufgabe abgeschlossen ist, und holt Eure Belohnung ab.‡코르크론 병사들을 이미르하임의 관문까지 호위하여야 합니다. 임무를 마친 뒤, 이미르하임 북쪽 빙하의 가장자리로 돌아와 그곳에 있는 지상군 사령관 수트야로부터 임무에 대한 보상을 받아야 합니다.‡Escolta las tropas Kor\'kron hasta las puertas de Ymirheim y vuelve junto al comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim. Te compensará cuando completes esta tarea.‡Escolta las tropas Kor\'kron hasta las puertas de Ymirheim y vuelve junto al comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim. Te compensará cuando completes esta tarea.‡Escortez le Transporteur de troupe kor\'kron jusqu\'aux portes d\'Ymirheim. Retournez voir le Commandant Xutjja au bord du glacier au nord d\'Ymirheim pour obtenir une compensation une fois la mission terminée.‡护送库卡隆部队抵达伊米海姆的大门。完成任务后返回伊米海姆北面的冰川边缘，向地面指挥官科特亚复命。‡護送柯爾克隆軍隊抵達依米海姆的入口。回報給依米海姆北面冰冠邊緣的地面指揮官蘇加獲得你的任務報酬。',
  }
},
[13302] = {
  {
    'Escravos da Saronita‡Рабы саронитовых шахт‡Vom Saronit abhängig‡사로나이트의 노예‡Esclavos de la saronita‡Esclavos de la saronita‡Esclaves de la saronite‡萨隆邪铁的奴隶‡搶救薩鋼礦奴',
    nil,
    'O Irmão Keltan, a bordo do Martelo de Orgrim, quer que você resgate 10 Escravos da Mina de Saronita.‡Брат Келтан, находящийся на борту "Молота Оргрима", просит вас освободить 10 рабов из саронитовых шахт.‡Bruder Keltan an Bord der Orgrims Hammer möchte, dass Ihr 10 Saronitminensklaven rettet.‡오그림의 망치호에 승선한 수사 켈탄이 사로나이트 광산 노예 10명을 구출해 달라고 부탁했습니다.‡El hermano Keltan sobre el Martillo de Orgrim quiere que rescates a 10 esclavos de las minas de saronita.‡El hermano Keltan sobre el Martillo de Orgrim quiere que rescates a 10 esclavos de las Minas de Saronita.‡Le Frère Keltan, à bord du Marteau d\'Orgrim, vous a demandé de sauver 10 Ouvriers des mines de saronite.‡奥格瑞姆之锤的凯尔坦修士要你去营救10名萨隆邪铁矿洞奴隶。‡奧格林之錘上的凱爾坦修士請你去援救10名薩鋼礦坑奴隸。',
  }
},
[13304] = {
  {
    '‡Ремонт в полевых условиях‡Feldreparaturen‡현장 수리‡Arreglos de campo‡Arreglos de campo‡Des réparations de fortune‡战地维修‡',
    nil,
    '‡Кольтира Ткач Смерти с "Молота Оргрима" хочет, чтобы вы отобрали 5 деталей разрушителя у мусорных упырей в долине Потерянной Надежды и отнесли их к сломанному разрушителю.‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr 5 Verwüsterersatzteile von den aasfressenden Spuken im Tal der Verlorenen Hoffnung beschafft und sie zum defekten Verwüster bringt.‡오그림의 망치호에 있는 콜티라 데스위버가 잃어버린 희망의 계곡에 있는 청소부 외눈깨비로부터 파괴전차 부품 5개를 모아 부서진 파괴전차에 사용해 달라고 했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que recuperes 5 piezas de demoledor de los geists carroñeros en El Valle de la Esperanza Perdida y que las lleves al demoledor destrozado.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que recuperes 5 piezas de demoledor de los geists carroñeros en El Valle de la Esperanza Perdida y que las lleves al demoledor destrozado.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, veut que vous récupériez 5 Pièces détachées de démolisseur sur des Geists charognards dans la Vallée de l\'Espoir perdu et que vous les rapportiez à l\'Épave de démolisseur.‡‡',
  }
},
[13305] = {
  {
    '‡Все к худшему‡Tut Euer Schlechtestes‡소용없는 일‡Haz lo peor‡Haz lo peor‡Faites de votre pire‡竭尽全力‡',
    nil,
    '‡Используйте отремонтированный разрушитель, чтобы уничтожить 150 изгнивших вурдалаков, 20 ледотленных волхвов и 2 костяных великана в долине Потерянной Надежды. Выполнив эту задачу, поговорите с Матиасом Нетлером в лагере сопротивления первого легиона.‡Zerstört mithilfe des Runderneuerten Verwüsters 150 verrottete Ghule, 20 Frostschädelmagier und 2 Knochenriesen im Tal der Verlorenen Hoffnung. Sprecht mit Matthias Lehner im Vorhutslager der Ersten Legion, wenn Ihr die Aufgabe abgeschlossen habt.‡잃어버린 희망의 계곡에서 수리한 파괴전차를 사용하여 썩은 구울 150마리, 얼음해골 마술사 20마리, 해골 거인 2마리를 해치운 다음 1군단 전진기지에 있는 마시어스 레넷과 대화해야 합니다.‡Usa el demoledor reformado para acabar con 150 necrófagos descompuestos, 20 magos Craneoescarcha y 2 gigantes osarios en El Valle de la Esperanza Perdida. Habla con Matthias Lehner en el Puesto de Avanzada de la Primera Legión cuando hayas terminado.‡Usa el demoledor reformado para acabar con 150 necrófagos descompuestos, 20 magos Craneoescarcha y 2 gigantes osarios en El Valle de la Esperanza Perdida. Habla con Matthias Lehner en el Puesto de Avanzada de la Primera Legión cuando hayas terminado.‡Utilisez le Démolisseur remis à neuf pour détruire 150 Goules décomposées, 20 Magi crânegivre et 2 Géants d\'os dans la Vallée de l\'Espoir perdu. Parlez à Matthias Lehner au Camp avancé de la Première légion une fois la tâche accomplie.‡使用整修过的攻城车，在失落希望之谷里消灭150只腐朽的食尸鬼、20个霜颅大法师和2个白骨巨人。完成任务之后前往第一军团前线营地，与米斯希尔萨·阿奈尔谈一谈。‡',
  }
},
[13306] = {
  {
    'Erguendo as barricadas‡Строим баррикады!‡Errichtet die Barrikaden‡방벽 설치 작전‡Levantad las barricadas‡Levantad las barricadas‡Lever les barricades‡构建路障‡架起路障',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você construa 8 Barricadas usando o Kit de Construção de Barricadas.‡Постройте 8 баррикад с помощью комплекта для возведения баррикад по просьбе Кольтиры Ткача Смерти, находящегося на борту "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr 8 Barrikaden mithilfe Eures Barrikadenbausatzes errichtet.‡오그림의 망치호에 승선한 콜티라 데스위버가 방벽 설치 도구를 사용하여 방벽 8개를 설치해 달라고 부탁했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que construyas 8 barricadas con tu equipo para construir barricadas.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que construyas 8 barricadas con tu equipo para construir barricadas.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande de construire 8 Barricades en utilisant votre Matériel de construction de barricades.‡奥格瑞姆之锤的库尔迪拉·织亡者要你使用路障搭设工具建造8处路障。‡奧格林之錘上的寇爾提拉·亡織者要你使用柵欄構築工具包建造八座路障。',
  }
},
[13307] = {
  {
    'Estandartes salpicados de sangue‡Окровавленные знамена‡Blutbespritzte Banner‡피로 얼룩진 깃발‡Estandartes cubiertos de sangre‡Estandartes cubiertos de sangre‡Des bannières maculées de sang‡溅血的旗帜‡染血的旌旗',
    nil,
    'Koltirus Tecemorte, a bordo do Martelo de Orgrim, quer que você mate 5 Portadores do Estandarte do Flagelo, 5 Conversores do Flagelo e 20 Heróis Convertidos.‡Убейте 5 знаменосцев Плети, 5 обратителей Плети и 20 обращенных героев по просьбе Кольтиры Ткача Смерти, который находится на борту "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr 5 Bannerträger der Geißel, 5 Konvertierer der Geißel und 20 konvertierte Helden tötet.‡오그림의 망치호에 승선한 콜티라 데스위버가 스컬지 기수 5명, 스컬지 변환사 5명, 조종 당하는 영웅 20명을 처치해 달라고 부탁했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 portaestandartes de la Plaga, a 5 conversores de la Plaga y a 20 héroes transformados.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 portaestandartes de la Plaga, a 5 conversores de la Plaga y a 20 héroes transformados.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande de tuer 5 Porte-bannières du Fléau, 5 Convertisseurs du Fléau et 20 Héros convertis.‡奥格瑞姆之锤的库尔迪拉·织亡者要你去杀死5个天灾旗手、5个天灾转化者和20个被转化的英雄。‡奧格林之錘上的寇爾提拉·亡織者要你殺掉5個天譴執旗者、5個天譴轉化者、20個轉化的英雄。',
  }
},
[13308] = {
  {
    'Poderes da mente‡Игры разума‡Geistiger Zwang‡마음의 대화‡Trucos mentales‡Trucos mentales‡Un esprit fort‡思维诡计‡千里傳音',
    nil,
    'O Orador Sombrio R\'khem, nas Minas de Saronita, quer que você recupere a Chave do Encarregado para libertá-lo.‡Добудьте ключ штейгера от оков темного проповедника Р\'кхема в Саронитовых шахтах.‡Dunkelsprecher R\'khem in den Saronitminen möchte, dass Ihr den Schlüssel des Großknechts beschafft, um so seine Ketten zu öffnen.‡사로나이트 광산의 암흑예언자 르켐이 자신의 족쇄를 열 수 있는 현장감독의 열쇠를 가지고 와 달라고 부탁했습니다.‡Hablaoscuro R\'khem en las Minas de Saronita quiere que recuperes la llave del supervisor de sus cadenas.‡Hablaoscuro R\'khem en las Minas de Saronita quiere que recuperes la llave del supervisor de sus cadenas.‡Le Sombre orateur R\'khem, dans les Mines de saronite, vous a demandé de récupérer la Clé du contremaître pour le libérer de ses chaînes.‡萨隆邪铁矿洞的黑暗低语者阿克希姆要你去找到工头的钥匙，帮它打开镣铐。‡薩鋼礦坑的暗語者睿克漢要你取得工頭的鑰匙來解開他的鎖鏈。',
  }
},
[13309] = {
  {
    'Ataque aéreo‡Воздушный десант‡Luftangriff‡공중 공격‡Asalto por aire‡Asalto por aire‡Attaque aérienne‡空中突袭‡空中突襲',
    nil,
    'O Comandante Terrestre Koup, na borda do glaciar a leste de Ymarheim, ordenou que você usasse a Torreta de Supressão do Rompe-céus para manter o Transportador de Tropas Rompe-Céus seguro durante o tempo necessário para que todos os homens saltem dentro de Ymarheim.‡По приказу командира Купа, который расположился на склоне ледника к востоку от Имирхейма, воспользуйтесь подавительной пушкой "Усмирителя небес". Обеспечьте прикрытие для транспортного самолета, пока тот будет высаживать десант.‡Feldkommandant Koup an der Kante des Gletschers im Osten von Ymirheim hat Euch befohlen, den Geschützturm der Himmelsbrecher zu benutzen, um den Truppentransporter der Himmelsbrecher lange genug in der Luft zu halten, bis alle abgeworfen wurden.‡이미르하임 동쪽 빙하의 가장자리에 있는 지상군 사령관 쿠프의 명령에 따라 당신은 하늘파괴자 제압포를 사용하여 하늘파괴자 수송선을 보호하고 병사들이 무사히 낙하할 수 있도록 해야 합니다.‡El comandante de tierra Koup en el borde del glaciar al este de Ymirheim te ha ordenado que uses la torreta de supresión de El Rompecielos para mantener el transporte de tropas de El Rompecielos intacto hasta que puedan infiltrarse.|n‡El comandante de tierra Koup en el borde del glaciar al este de Ymirheim te ha ordenado que uses la torreta de supresión de El Rompecielos para mantener el transporte de tropas de El Rompecielos intacto hasta que puedan infiltrarse.|n‡Le Commandant Koup, au bord du glacier à l\'est d\'Ymirheim, vous a ordonné d\'utiliser la Tourelle de suppression du Brise-ciel afin que le Transport de troupe du Brise-ciel résiste assez longtemps pour que tous les sauts soient effectués.‡伊米海姆北面冰川边缘的地面指挥官库普命令你使用破天号压制炮台，保证破天号运兵机安全降落并卸下所有部队。‡依米海姆東面冰冠邊緣的地面指揮官庫普命令你操作破天者號鎮壓砲塔來保護破天者號軍隊運輸機直到部隊完成空降。',
  }
},
[13310] = {
  {
    'Ataque aéreo‡Воздушный десант‡Luftangriff‡공중 공격‡Asalto por aire‡Asalto por aire‡Attaque aérienne‡空中突袭‡空中突襲',
    nil,
    'O Comandante Terrestre Xutja, na borda do glaciar ao norte de Ymarheim, ordenou que você usasse a Torreta de Supressão Kor\'kron para manter o Transportador de Tropas de Kor\'kron seguro durante o tempo necessário para todos os homens saltarem dentro de Ymarheim.‡Командир наземных войск Ксутья на краю ледника возле Имирхейма приказал вам использовать кор\'кронскую заградительную пушку, чтобы обеспечить прикрытие для кор\'кронского транспортника, так чтобы десант был сброшен, а транспортный самолет остался целым.‡Bodentruppenkommandant Xutjja an der Kante des Gletschers im Norden von Ymirheim hat Euch befohlen, den Geschützturm der Kor\'kron zu benutzen, um den Truppentransporter der Kor\'kron lange genug in der Luft zu halten, bis alle abgeworfen wurden.‡이미르하임 북쪽 빙하의 가장자리에 있는 지상군 사령관 수트야의 명령에 따라 코르크론 제압포를 사용하여 코르크론 수송선을 보호하고 병사들이 무사히 낙하할 수 있도록 해야 합니다.‡El comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim te ha ordenado que uses la torreta de supresión Kor\'kron para mantener el transporte de tropas Kor\'kron intacto hasta que puedan infiltrarse.‡El comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim te ha ordenado que uses la torreta de supresión Kor\'kron para mantener el transporte de tropas Kor\'kron intacto hasta que puedan infiltrarse.‡Le Commandant Xutjja, à l\'extrémité du glacier au nord d\'Ymirheim, vous a ordonné d\'utiliser la Tourelle de suppression kor\'kronne afin de protéger le Transporteur de troupe kor\'kron assez longtemps pour que tous les sauts soient effectués.‡伊米海姆北面冰川边缘的地面指挥官科特亚命令你使用库卡隆压制炮台，保证库卡隆运兵机安全降落并卸下所有部队。‡依米海姆北面冰冠邊緣的地面指揮官蘇加命令你操作破天者號鎮壓砲塔來保護破天者號軍隊運輸機直到部隊完成空降。',
  }
},
[13311] = {
  {
    'Baralho de Demônios‡Карты Новолуния: колода Демонов‡Dämonenkartenset‡악마 카드 한 벌‡La baraja de Demonios‡La baraja de Demonios‡Suite de Démons‡恶魔套牌‡群魔套卡',
    nil,
    'Use o Baralho de Demônios para evocar uma Cartomante de Negraluna e entregue o baralho a ela.‡Призовите предсказателя судьбы с Ярмарки Новолуния и отдайте ему колоду Демонов.‡Beschwört mithilfe des Dämonenkartensets einen Wahrsager des Dunkelmond-Jahrmarkts und gebt ihm das Set.‡악마 카드 한 벌로 다크문 점술사를 소환한 다음 카드를 돌려줘야 합니다.‡Usa la baraja de Demonios para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Usa la baraja de Demonios para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Utilisez la Suite de Démons pour invoquer une Diseuse de bonne aventure de la foire de Sombrelune et donnez-lui la suite.‡使用恶魔套牌召唤一位暗月占卜师，并把套牌交给占卜师。‡使用群魔套卡召喚一位暗月算命師，然後把套卡交給他。',
  }
},
[13312] = {
  {
    'A Muralha de Ferro‡Железный вал‡Das Eisenwallbollwerk‡무쇠벽 성채‡La Fortificación del Muro de Hierro‡La Fortificación del Muro de Hierro‡Le rempart Mur-de-fer‡铁墙壁垒‡鐵牆壁壘',
    nil,
    'Derrote Grimkor, o Perverso, e fale com novamente com Koltirus Tecemorte a bordo do Martelo de Orgrim.‡Убейте Гримкора Злобного и возвращайтесь к Кольтире Ткачу Смерти на "Молот Оргрима".‡Besiegt Grimkor den Boshaften und kehrt zu Koltira Todesweber an Bord der Orgrims Hammer zurück.‡사악한 그림코르를 처치하고 오그림의 망치호에 있는 콜티라 데스위버에게 돌아가야 합니다.‡Derrota a Grimkor el Maldito y vuelve junto a Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Derrota a Grimkor el Maldito y vuelve junto a Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Battez Grimkor le Malfaisant, puis retournez voir Koltira Tissemort à bord du Marteau d\'Orgrim.‡击败邪恶的格姆克尔，然后向奥格瑞姆之锤的库尔迪拉·织亡者复命。‡擊敗邪惡的葛林克爾然後回報奧格林之錘上的寇爾提拉·亡織者。',
  }
},
[13313] = {
  {
    'Cegando os olhos no céu‡Ослепить соглядатаев!‡Die Augen im Himmel erblinden lassen‡하늘의 감시자 눈 가리기‡Cerrar los ojos en el cielo‡Cerrar los ojos en el cielo‡Aveugler les yeux dans le ciel‡遮挡天空‡阻礙空中偵察',
    nil,
    'Use o MSG-3 para destruir 6 Caças de Reconhecimento Rompe-céus e, a seguir, apresente-se ao Exterminador dos Céus Korm Escaranegra, a bordo do Martelo de Orgrim.‡С помощью ЗГ-3 уничтожьте 6 разведывательных истребителей "Усмирителя небес", потом вернитесь к покорителю небес Корму Черному Шраму на борт "Молота Оргрима".‡Benutzt die BGR-3, um damit 6 Kampfaufklärer der Himmelsbrecher abzuschießen. Dann meldet Euch wieder bei Himmelshäscher Korm Schwarznarbe an Bord der Orgrims Hammer.‡3세대 대노움 지상 투사기를 이용하여 하늘파괴자 정찰기 6기를 파괴하고, 오그림의 망치호에 승선한 하늘약탈자 코름 블랙스카에게 보고해야 합니다.‡Usa el SGM-3 para acabar con 6 aviones de caza de El Rompecielos y luego informa al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim.‡Usa el SGM-3 para acabar con 6 aviones de caza de El Rompecielos y luego informa al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim.‡Utilisez le MSG-3 pour détruire 6 Chasseurs de reconnaissance du Brise-ciel, puis présentez-vous au Saccageur-des-cieux Korm Noire-balafre à bord du Marteau d\'Orgrim.‡使用SGM-3摧毁6架破天号侦查机，然后向奥格瑞姆之锤的掠天者考尔姆·黑痕复命。‡使用SGM-3飛彈擊落6艘破天者號偵查戰鬥機，然後向奧格林之錘上的空奪者寇姆·黑疤回報。',
  }
},
[13314] = {
  {
    'Recebendo a mensagem‡Перехватить донесения‡Beschafft die Nachricht‡급송문서 가로채기‡Capta el mensaje‡Capta el mensaje‡Capter le message‡获取情报‡獲取信息',
    nil,
    'Apreenda 6 Missivas do Martelo de Orgrim dos Batedores do Martelo de Orgrim e leve-as para o Alto-capitão Justino Bartolotto, a bordo do Rompe-céus.‡Заберите 6 донесений для "Молота Оргрима" у разведчиков с "Молота Оргрима" и отдайте их старшему капитану Джастину Бартлетту на борту "Усмирителя небес".‡Beschafft Euch 6 Sendungen der Orgrims Hammer von den Spähern der Orgrims Hammer und bringt sie zu Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher.‡오그림의 망치 정찰병들로부터 오그림의 망치호 급송문서 6부를 가로채어 하늘파괴자호에 승선한 수석 선장 저스틴 바틀릿에게 가지고 와야 합니다.‡Consigue 6 informes del Martillo de Orgrim de los exploradores del Martillo de Orgrim y tráelos al gran capitán Justin Bartlett a bordo de El Rompecielos.‡Consigue 6 informes del Martillo de Orgrim de los exploradores del Martillo de Orgrim y tráelos al gran capitán Justin Bartlett a bordo de El Rompecielos.‡Récupérez 6 Dépêches du Marteau d\'Orgrim sur des Éclaireurs du Marteau d\'Orgrim, puis rapportez-les au Grand capitaine Justin Bartlett à bord du Brise-ciel.‡从奥格瑞姆之锤斥候身上截获6份奥格瑞姆之锤急件，把它们交给破天号上的高级指挥官加斯汀·巴雷特。‡從奧格林之錘斥候手中攔截6份奧格林之錘急件，並帶回給破天者號上的提督賈斯汀·巴特勒。',
  }
},
[13315] = {
  {
    'Um vislumbre do que está por vir‡Предварительная разведка‡Vorschau‡미리 보기‡La primicia‡La primicia‡Avant-première‡预览‡暗中偵查',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você voe sobre o portão da desolação, visitando as partes sul, central, norte e noroeste do portão.‡Слетайте к Вратам Горя и ознакомьтесь с южной, центральной, северной и северо-западной частями Врат по просьбе Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr hinunter zum Tor der Verwüstung fliegt und Euch den südlichen, zentralen, nördlichen und nordwestlichen Bereich des Tors anseht.‡하늘파괴자호에 승선한 타사리안이 황폐의 관문으로 날아가 관문의 남부, 북부, 북서부 및 중부 지역을 정찰해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que vueles a la puerta de la desolación y que explores las zonas sur, central, norte y noroeste de la puerta.‡Thassarian, a bordo de El Rompecielos, quiere que vueles a la puerta de la desolación y que explores las zonas sur, central, norte y noroeste de la puerta.‡Thassarian, à bord du Brise-ciel, vous a demandé de voler vers la Porte de la Désolation, et de visiter les zones sud, centrale, nord et nord-ouest de la porte.‡破天号的萨萨里安希望你飞往荒凉之门，调查荒凉之门的南部、中部、北部和西北部。‡破天者號上的薩沙理安要你飛往荒寂之門，偵查門的南、中、北、西北區域。',
  }
},
[13316] = {
  {
    '‡Стражи Корп\'ретара‡Die Wächter von Corp\'rethar‡코프레타르의 수호자‡Los guardianes de Corp\'rethar‡Los guardianes de Corp\'rethar‡Les gardiens de Corp\'rethar‡科雷萨的守卫者‡寇普雷薩的守衛者',
    nil,
    '‡Убейте 5 провозвестников ужаса и 5 стражей Корп\'ретара по приказу Кольтиры Ткача Смерти с "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer wünscht, dass Ihr 5 Herolde des Schreckens und 5 Wächter von Corp\'rethar tötet.‡오그림의 망치호에 있는 콜티라 데스위버가 공포의 선구자 5명과 코프레타르 경비병 5명을 처치해 달라고 했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 presagistas de horror y a 5 guardianes de Corp\'rethar.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 presagistas de horror y a 5 guardianes de Corp\'rethar.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous a demandé de tuer 5 Messagers de l\'Horreur et 5 Gardiens de Corp\'rethar.‡‡',
  }
},
[13317] = {
  {
    '----‡----‡----‡----‡----‡----‡----‡----‡----',
    nil,
    nil,
  }
},
[13318] = {
  {
    'Arrastar e soltar‡Перетащить и опустить‡Gefährliche Gewandung‡끌어다 놓기‡Arrastrar y soltar‡Arrastrar y soltar‡Attraper et lâcher‡从天而“降”‡舉手之勞',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você colete Orbes de Ilusão dos Iniciados Amargos, em Aldur\'thar, e que os use em 3 Subjugadores Atrozes de lá.‡Отберите сферы иллюзии у озлобленных посвященных в Алдур\'таре и используйте их против 3 темных поработителей по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr Kugeln der Illusion von bitteren Initianden in Aldur\'thar sammelt und sie dann auf 3 dunkle Unterwerfer anwendet.‡하늘파괴자호에 승선한 타사리안이 알두르타르의 냉혹한 수습생들로부터 환영의 수정구를 모아, 수정구들을 그 곳에 있는 어둠의 정복자 3명에게 사용해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Thassarian, a bordo de El Rompecielos, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Thassarian, à bord du Brise-ciel, vous a demandé de récupérer des Orbes d\'illusion sur des Initiés amers à Aldur\'thar et de les utiliser sur 3 Subjugateurs sombres sur place.‡破天号上的萨萨里安希望你从奥尔杜萨的苦痛新兵身上夺取幻象宝珠，然后对那里的3名黑暗压制者使用。‡破天者號上的薩沙理安要你從奧多薩的惡劣新兵身上取得幻術寶珠，然後在3個黑暗征服者身上使用它。',
  }
},
[13319] = {
  {
    'Cadeia de comando‡Вершина иерархии‡Befehlskette‡지휘 계통‡Cadena de mando‡Cadena de mando‡La chaîne de commandement‡指挥体系‡切斷指揮鍊',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você vá a Aldur\'thar e derrote o Feitor Faedris, o Feitor Savryn, o Feitor Veraj e o Feitor Jhaeqon.‡Отправляйтесь в Алдур\'тар и убейте надзирателя Фэдриса, надзирателя Саврина, надзирателя Веража и надзирателя Джакона про просьбе Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr nach Aldur\'thar geht und Aufseher Faedris, Aufseher Savryn, Aufseher Veraj und Aufseher Jhaeqon besiegt.‡하늘파괴자호에 승선한 타사리안이 알두르타르에 가서 감독관 패드리스, 감독관 사브린, 감독관 베라즈, 감독관 재콘을 제거해 달라고 부탁했습니다.‡Thassarian a bordo de El Rompecielos quiere que vayas a Aldur\'thar para derrotar al sobrestante Faedris, al sobrestante Savryn, al sobrestante Veraj y al sobrestante Jhaeqon.‡Thassarian a bordo de El Rompecielos quiere que vayas a Aldur\'thar para derrotar al sobrestante Faedris, al sobrestante Savryn, al sobrestante Veraj y al sobrestante Jhaeqon.‡Thassarian, à bord du Brise-ciel, vous a demandé d\'aller à Aldur\'thar et de vaincre le Surveillant Faedris, le Surveillant Savryn, le Surveillant Veraj et le Surveillant Jhaeqon.‡破天号的萨萨里安要你前往荒凉之门奥尔杜萨，击败工头法埃迪斯、工头沙维尔、工头维拉恩和工头夏克尔。‡破天者號上的薩沙理安要你前往奧多薩擊敗監督者菲德里斯、監督者薩夫林、監督者維拉傑與監督者杰昆。',
  }
},
[13320] = {
  {
    'Impossível reproduzir‡Невоспроизводимый компонент‡Kann nicht reproduziert werden‡괴상한 약을 찾아서‡Imposible reproducir‡Imposible reproducir‡Impossible à reproduire‡无法复制‡重製失敗',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você encha o Frasco Particionado com o material dos 3 Caldeirões dos Sectários em Aldur\'thar. Em seguida, leve-o ao Engenheiro-chefe Pertaporca.‡Тассариан с корабля "Усмиритель небес" хочет, чтобы вы наполнили трехчастную флягу изо всех 3 котлов служителей культа в Алдур\'таре, а затем отнесли ее главному инженеру Болтоключу.‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr das unterteilte Fläschchen an jedem der 3 Kessel der Kultisten auffüllt und es anschließend zu Chefingenieur Bolzenschlüssel bringt.‡하늘파괴자호에 승선한 타사리안이 알두르타르에 있는 이교도 가마솥 3개의 내용물을 다단 플라스크에 담아 선임기술자 볼트렌치에게 가져가 달라고 요청했습니다.‡Thassarian a bordo de El Rompecielos quiere que uses el frasco dividido en cada una de las 3 calderas de los cultores en Aldur\'thar, y luego llévaselo a ingeniero jefe Aprietatuercas.‡Thassarian a bordo de El Rompecielos quiere que uses el frasco dividido en cada una de las 3 calderas de los cultores en Aldur\'thar, y luego llévaselo a ingeniero jefe Aprietatuercas.‡Thassarian, à bord du Brise-ciel, vous a demandé d\'utiliser le Flacon cloisonné sur chacun des 3 Chaudrons de sectateur, puis de l\'apporter à l\'Ingénieur en chef Vrilleboulon.‡破天号上的萨萨里安希望你前往荒凉之门奥尔杜萨，在那里的3处诅咒教徒的大锅中使用分离的药瓶，然后将其交给首席技师波尔维克。‡破天者號上的薩沙理安要你利用隔離之瓶從3個教徒的大鍋帶回樣本給首席工程師栓鉗。',
  }
},
[13321] = {
  {
    'Novo teste‡Все переиграть‡Jetzt neu testen‡재실험‡Volver a probar‡Volver a probar‡Testez-le à nouveau‡重新考验‡重新測試',
    nil,
    'O Engenheiro-chefe Pertaporca, a bordo do Rompe-céus, quer que você jogue a Massa Deformada em um dos caldeirões de Aldur\'thar.‡Бросьте корчащуюся массу в котел в Алдур\'таре по просьбе главного инженера Болтоключа с "Усмирителя небес".‡Chefingenieur Bolzenschlüssel an Bord der Himmelsbrecher möchte, dass Ihr eine windende Masse in einen der Kessel in Aldur\'thar werft.‡하늘파괴자호에 승선한 선임기술자 볼트렌치가 몸부림치는 덩어리를 알두르타르의 가마솥에 던져 넣어 달라고 부탁했습니다.‡El ingeniero jefe Aprietatuercas a bordo de El Rompecielos quiere que tires una masa aviesa dentro de una caldera en Aldur\'thar.‡El ingeniero jefe Aprietatuercas a bordo de El Rompecielos quiere que tires una masa aviesa dentro de una caldera en Aldur\'thar.‡L\'Ingénieur en chef Vrilleboulon, à bord du Brise-ciel, veut que vous jetiez une Masse grouillante dans un chaudron à Aldur\'thar.‡破天号上的首席技师波尔维克希望你把沸腾的魔质扔进奥尔杜萨的瘟疫之锅里。‡破天者號上的首席工程師栓鉗要你將苦痛糾結凝塊丟進奧多薩的一個大鍋中。',
  }
},
[13322] = {
  {
    'Novo teste‡Все переиграть‡Jetzt neu testen‡재실험‡Volver a probar‡Volver a probar‡Testez-le à nouveau‡重新考验‡重新測試',
    nil,
    'O Engenheiro-chefe Pertaporca, a bordo do Rompe-céus, quer que você beba o Tônico da Seita Diluído e que, em seguida, mate os Sectários de Aldur\'thar para pegar as Essências Maculadas deles. Após ter feito isso, combine 10 essências em uma Massa Deformada e jogue-a em um dos caldeirões.‡Выпейте разбавленное снадобье сектантов по просьбе главного инженера Болтоключа с "Усмирителя небес", затем убивайте любых сектантов, каких встретите в Алдур\'таре, и забирайте их оскверненные сущности. После смешайте 10 сущностей, чтобы получить корчащуюся массу, и бросьте ее в любой из котлов сектантов.‡Chefingenieur Bolzenschlüssel an Bord der Himmelsbrecher möchte, dass Ihr das verdünnte Kulttonikum trinkt, Kultisten in Aldur\'thar tötet und ihnen ihre besudelte Essenz abnehmt. Fügt danach 10 von den Essenzen zu einer windenden Masse zusammen und werft diese dann in einen ihrer Kessel.‡하늘파괴자호에 승선한 선임기술자 볼트렌치가 희석한 이교도 약제를 마시고, 알두르타르의 이교도들을 처치한 뒤 그들의 부정한 정기를 모아 달라고 부탁했습니다. 당신은 부정한 정기 10개를 몸부림치는 덩어리로 만든 뒤 그것을 아무 가마솥에나 던져 넣어야 합니다.‡El ingeniero jefe Aprietatuercas a bordo de El Rompecielos quiere que bebas el tónico de culto diluido, mates cualquier cultor en Aldur\'thar y cojas su esencia mácula. Luego tienes que combinar 10 de las esencias para crear una masa aviesa y tirarla dentro de cualquiera de sus calderas.‡El ingeniero jefe Aprietatuercas a bordo de El Rompecielos quiere que bebas el tónico de culto diluido, mates cualquier cultor en Aldur\'thar y cojas su esencia mácula. Luego tienes que combinar 10 de las esencias para crear una masa aviesa y tirarla dentro de cualquiera de sus calderas.‡L\'Ingénieur en chef Vrilleboulon, à bord du Brise-ciel, vous demande de boire le Tonique du culte dilué, de tuer tout Sectateur présent à Aldur\'thar et de prendre leurs Essences corrompues. Vous devez ensuite combinez 10 Essences corrompues avec une Masse grouillante et jeter le tout dans l\'un de leurs chaudrons.‡破天号上的首席技师波尔维克希望你喝下稀释过的诅咒教徒滋补剂，杀死奥尔杜萨一带的任意诅咒教徒，从他们身上收集被污染的精华。然后将10份被污染的精华组合成沸腾的魔质，把它扔进奥尔杜萨的瘟疫之锅里。‡破天者號上的首席工程師栓鉗要你喝下稀釋的教團補藥，然後在奧多薩殺掉詛咒神教教徒並取得他們受污染的精華。將10個受污染的精華結合成一個苦痛糾結凝塊，將其丟進奧多薩的任何一個大鍋。',
  }
},
[13323] = {
  {
    'Arrastar e soltar‡Перетащить и опустить‡Gefährliche Gewandung‡끌어다 놓기‡Arrastrar y soltar‡Arrastrar y soltar‡Attraper et lâcher‡从天而“降”‡舉手之勞',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você colete Orbes de Ilusão dos Iniciados Amargos, em Aldur\'thar, e que os use em 3 Subjugadores Atrozes de lá.‡Отберите сферы иллюзии у озлобленных посвященных в Алдур\'таре и используйте их против 3 темных поработителей по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr Kugeln der Illusion von bitteren Initianden in Aldur\'thar sammelt und sie dann auf 3 dunkle Unterwerfer anwendet.‡하늘파괴자호에 승선한 타사리안이 알두르타르의 냉혹한 수습생들로부터 환영의 수정구를 모아, 수정구들을 그곳에 있는 어둠의 정복자 3명에게 사용해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Thassarian, a bordo de El Rompecielos, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Thassarian, à bord du Brise-ciel, vous demande de récupérer des Orbes d\'illusion sur des Initiés amers à Aldur\'thar et de les utiliser sur 3 Subjugateurs sombres sur place.‡破天号上的萨萨里安希望你从奥尔杜萨的苦痛新兵身上夺取幻象宝珠，然后对那里的3名黑暗压制者使用。‡破天者號上的薩沙理安要求你，從奧多薩的惡劣新兵身上取得幻術寶珠，然後用在3個黑暗征服者身上。',
  }
},
[13324] = {
  {
    'Baralho de Prismas de Negraluna‡Колода карт Новолуния: Призмы‡Prismenkartenset des Dunkelmond-Jahrmarkts‡다크문 프리즘 카드 한 벌‡La baraja de Prismas‡La baraja de Prismas de la Luna Negra‡Suite de Prismes de Sombrelune‡暗月棱镜套牌‡暗月稜光套卡',
    nil,
    'Devolva o Baralho de Prismas à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Призм на ярмарку Новолуния.‡Gebt das Prismenkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 프리즘 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Prismas a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Prismas a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Prismes à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把棱镜套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把稜光套卡交給他們。',
  }
},
[13325] = {
  {
    'Baralho de Caos de Negraluna‡Колода карт Новолуния: Хаос‡Chaoskartenset des Dunkelmond-Jahrmarkts‡다크문 혼돈 카드 한 벌‡La baraja de Caos de la Luna Negra‡La baraja de Caos de la Luna Negra‡Suite du Chaos de Sombrelune‡暗月混乱套牌‡暗月混沌套卡',
    nil,
    'Devolva o Baralho de Caos à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Хаоса на ярмарку Новолуния.‡Gebt das Chaoskartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 혼돈 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Caos a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Caos a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite du Chaos à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把混乱套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把混沌套卡交給他們。',
  }
},
[13326] = {
  {
    'Baralho de Nobres de Negraluna‡Колода карт Новолуния: Аристократы‡Adligenkartenset des Dunkelmond-Jahrmarkts‡다크문 귀족 카드 한 벌‡La baraja de Nobles de la Luna Negra‡La baraja de Nobles de la Luna Negra‡Suite de Nobles de Sombrelune‡暗月高尚套牌‡暗月貴族套卡',
    nil,
    'Devolva o Baralho de Nobres à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Аристократов на ярмарку Новолуния.‡Gebt das Adligenkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 귀족 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Nobles a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Nobles a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Nobles à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把高尚套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把貴族套卡交給他們。',
  }
},
[13327] = {
  {
    'Baralho de Morte-viva de Negraluna‡Колода карт Новолуния: Нежить‡Untodeskartenset des Dunkelmond-Jahrmarkts‡다크문 불사 카드 한 벌‡La baraja de No-muertos de la Luna Negra‡La baraja de No-muertos de la Luna Negra‡Suite de Non-mort de Sombrelune‡暗月死灵套牌‡暗月不死套卡',
    nil,
    'Devolva o Baralho de Morte-viva à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Нежити на ярмарку Новолуния.‡Gebt das Untotenkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 불사 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de No-muertos a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de No-muertos a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Non-mort à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把死灵套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把不死套卡交給他們。',
  }
},
[13328] = {
  {
    '‡Вдребезги‡Einen Scherbenhaufen hinterlassen‡조각 깨뜨리기‡Hacer añicos los fragmentos‡Hacer añicos los fragmentos‡Briser les éclats‡击破碎片‡擊破碎片',
    nil,
    '‡Принесите Кольтире Ткачу Смерти на "Молот Оргрима" осколки кристалла Ужаса, кристалла Отчаяния и кристалла Страдания.‡Bringt Koltira Todesweber an Bord der Orgrims Hammer den zerbrochenen Splitter des Schreckens, den zerbrochenen Splitter der Verzweiflung und den zerbrochenen Splitter des Leidens.‡오그림의 망치호에 있는 콜티라 데스위버에게 부서진 공포의 조각, 부서진 절망의 조각, 부서진 고통의 조각을 가져가야 합니다.‡Lleva el fragmento de horror roto, el fragmento de desesperación roto y el fragmento de sufrimiento roto a Koltira Tejemuerte en el Martillo de Orgrim.‡Lleva el fragmento de horror roto, el fragmento de desesperación roto y el fragmento de sufrimiento roto a Koltira Tejemuerte en el Martillo de Orgrim.‡Apportez l\'Éclat d\'horreur brisé, l\'Éclat de désespoir brisé et l\'Éclat de souffrance brisé à Koltira Tissemort à bord du Marteau d\'Orgrim.‡‡',
  }
},
[13329] = {
  {
    '‡Пред Вратами Ужаса‡Vor dem Tor des Schreckens‡공포의 관문 앞에서‡Ante el Portal del Horror‡Ante el Portal del Horror‡Devant la porte de l\'horreur‡在恐惧之门前‡驚怖之門',
    nil,
    '‡Растворите останки 6 скелетов-разорителей летучей кислотой по заданию Кольтиры Ткача Смерти с "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer wünscht, dass Ihr mithilfe der flüchtigen Säure die Überreste von 6 Skeletthäschern zersetzt.‡오그림의 망치호에 승선한 콜티라 데스위버가 휘발성 산을 이용하여 해골 약탈자의 유해를 용해해 달라고 했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que uses el ácido volátil para disolver los restos de 6 atracadores esqueléticos.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que uses el ácido volátil para disolver los restos de 6 atracadores esqueléticos.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, vous demande d\'utiliser l\'Acide volatil pour dissoudre les restes de 6 Saccageurs squelettiques.‡‡',
  }
},
[13330] = {
  {
    'Sangue dos escolhidos‡Кровь избранных‡Blut der Auserwählten‡선택받은 자의 피‡Sangre de los elegidos‡Sangre de los elegidos‡Le sang des Élus‡伊米亚之血‡受選者的血',
    nil,
    'O Armipotente Davos Bulício, a bordo do Martelo de Orgrim, ordenou que você matasse 20 vraikalen em Ymarheim.‡Убейте 20 врайкулов в Имирхейме по просьбе завоевателя Давоса Рихта с "Молота Оргрима".‡Kriegshetzer Davos Rabatz auf der Orgrims Hammer hat Euch entsandt, 20 Vrykul in Ymirheim zu töten.‡오그림의 망치호에 승선한 전쟁의 인도자 다보스 리오트가 이미르하임에서 브리쿨 20명을 처치해 달라고 요청했습니다.‡Belisario Davos Rioht en el Martillo de Orgrim te ha enviado a matar a 20 vrykuls en Ymirheim.‡Belisario Davos Rioht en el Martillo de Orgrim te ha enviado a matar a 20 vrykuls en Ymirheim.‡Le Porteguerre Davos Rioht, sur le Marteau d\'Orgrim, vous a demandé de tuer 20 Vrykuls à Ymirheim.‡奥格瑞姆之锤的战争使者达沃斯·里赫要你进入伊米海姆，杀死20个维库人。‡奧格林之錘上的戰爭使者戴沃斯·里歐特要求你，到依米海姆殺掉20個維酷族。',
  }
},
[13331] = {
  {
    '‡Ослепление Альянса‡Der Allianz die Augen zuhalten‡하늘의 감시자 눈 계속 가리기‡Mantener a la Alianza en la oscuridad‡Mantener a la Alianza en la oscuridad‡Que l\'Alliance reste aveugle‡盲目的联盟‡別讓聯盟重見天日',
    nil,
    '‡С помощью ЗГ-3 уничтожьте 6 разведывательных истребителей "Усмирителя небес", потом вернитесь к покорителю небес Корму Черному Шраму на борт "Молота Оргрима".‡Benutzt die BGR-3 um 6 Kampfaufklärer der Himmelsbrecher zu zerstören und erstattet dann dem Himmelshäscher Korm Schwarznarbe an Bord der Orgrims Hammer Bericht.‡3세대 대노움 지상 투사기를 사용하여 하늘파괴자 정찰기 6대를 격추한 뒤 오그림의 망치호에 승선한 하늘약탈자 코름 블랙스카에게 돌아와 보고해야 합니다.‡Usa el SGM-3 para acabar con 6 aviones de caza de El Rompecielos y luego informa al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim.‡Usa el SGM-3 para acabar con 6 aviones de caza de El Rompecielos y luego informa al atracador del cielo Korm Marcanegra a bordo del Martillo de Orgrim.‡Utilisez les MSG-3 pour détruire 6 Chasseurs de reconnaissance du Brise-ciel, puis retournez faire votre rapport au Saccageur-des-cieux Korm Noire-balafre, à bord du Marteau d\'orgrim.‡‡',
  }
},
[13332] = {
  {
    'Erguendo as barricadas‡Строим баррикады!‡Errichtet die Barrikaden‡방벽 설치 작전‡Levantad las barricadas‡Levantad las barricadas‡Lever les barricades‡构建路障‡架起路障',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você construa 8 Barricadas usando o Kit de Construção de Barricadas.‡Постройте 8 баррикад с помощью комплекта для возведения баррикад по просьбе Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr 8 Barrikaden mithilfe Eures Barrikadenbausatzes errichtet.‡하늘파괴자호에 승선한 타사리안이 방벽 설치 장치를 사용하여 방벽 8개를 설치해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que construyas 8 barricadas con tu equipo para construir barricadas.‡Thassarian, a bordo de El Rompecielos, quiere que construyas 8 barricadas con tu equipo para construir barricadas.‡Thassarian, à bord du Brise-ciel, vous demande de construire 8 Barricades en utilisant votre Matériel de construction de barricades.‡破天号的萨萨里安要你使用路障搭设工具建造8处路障。‡破天者號上的薩沙理安要你使用柵欄構築工具包建造八座路障。',
  }
},
[13333] = {
  {
    'Apreender mais missivas‡Перехват донесений‡Mehr Sendungen abfangen‡급송문서 더 가로채기‡A la captura de más informes‡A la captura de más informes‡Récupérez plus de dépêches‡抢夺急件‡攔截更多急件',
    nil,
    'Apreenda 6 Missivas do Martelo de Orgrim dos Batedores do Martelo de Orgrim e leve-as para o Alto-capitão Justino Bartolotto, a bordo do Rompe-céus.‡Заберите 6 донесений для "Молота Оргрима" у разведчиков с "Молота Оргрима", и отдайте их старшему капитану Джастину Бартлетту на борту "Усмирителя небес".‡Fangt 6 Sendungen der Orgrims Hammer von den Spähern der Orgrims Hammer ab und bringt sie zu Stabshauptmann Justin Bartlett an Bord der Himmelsbrecher.‡오그림의 망치호 정찰병들로부터 오그림의 망치호 급송문서를 가로채 하늘파괴자호에 승선한 수석 선장 저스틴 바틀릿에게 가지고 와야 합니다.‡Consigue 6 informes del Martillo de Orgrim de los exploradores del Martillo de Orgrim y tráelos al gran capitán Justin Bartlett a bordo de El Rompecielos.‡Consigue 6 informes del Martillo de Orgrim de los exploradores del Martillo de Orgrim y tráelos al gran capitán Justin Bartlett a bordo de El Rompecielos.‡Récupérez 6 Dépêches du Marteau d\'Orgrim sur les Éclaireurs du Marteau d\'Orgrim et rapportez-les au Grand capitaine Justin Bartlett, à bord du Brise-ciel.‡从奥格瑞姆之锤斥候身上截获6份奥格瑞姆之锤急件，把它们交给破天号上的高级指挥官加斯汀·巴雷特。‡從奧格林之錘斥候手中攔截6份奧格林之錘急件，並帶回給破天者號上的提督賈斯汀·巴特勒。',
  }
},
[13334] = {
  {
    'Estandartes salpicados de sangue‡Окровавленные знамена‡Blutbespritzte Banner‡피로 얼룩진 깃발‡Estandartes cubiertos de sangre‡Estandartes cubiertos de sangre‡Bannières tachées de sang‡溅血的旗帜‡染血的旌旗',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você mate 5 Portadores do Estandarte do Flagelo, 5 Conversores do Flagelo e 20 Heróis Convertidos.‡Убейте 5 знаменосцев Плети, 5 обратителей Плети и 20 обращенных героев по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian auf der Himmelsbrecher möchte, dass Ihr 5 Bannerträger der Geißel, 5 Konvertierer der Geißel und 20 konvertierte Helden tötet.‡하늘파괴자호에 승선한 타사리안이 스컬지 기수 5명, 스컬지 변환사 5명, 조종 당하는 영웅 20명을 처치해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que mates a 5 portaestandartes de la Plaga, a 5 conversores de la Plaga y a 20 héroes transformados.‡Thassarian, a bordo de El Rompecielos, quiere que mates a 5 portaestandartes de la Plaga, a 5 conversores de la Plaga y a 20 héroes transformados.‡Thassarian, à bord du Brise-ciel, vous demande de tuer 5 Porte-bannières du Fléau, 5 Convertisseurs du Fléau et 20 Héros convertis.‡破天号的萨萨里安要你去杀死5个天灾旗手、5个天灾转化者和20个被转化的英雄。‡破天者號上的薩沙理安要你殺掉5個天譴執旗者、5個天譴轉化者、20個轉化的英雄。',
  }
},
[13335] = {
  {
    'Diante do portão do horror‡Пред Вратами Ужаса‡Vor dem Tor des Schreckens‡공포의 관문 앞에서‡Ante el Portal del Horror‡Ante el Portal del Horror‡Devant la porte de l\'horreur‡在恐惧之门前‡驚怖之門',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você use o Ácido Volátil para dissolver os cadáveres de 6 Aniquiladores Descarnados.‡Растворите трупы 6 скелетов-разорителей летучей кислотой по заданию Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher wünscht, dass Ihr mithilfe der flüchtigen Säure die Überreste von 6 Skeletthäschern zersetzt.‡하늘파괴자호에 승선한 타사리안이 휘발성 산을 이용하여 해골 약탈자의 유해를 용해해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que uses el ácido volátil para disolver los restos de 6 atracadores esqueléticos.‡Thassarian, a bordo de El Rompecielos, quiere que uses el ácido volátil para disolver los restos de 6 atracadores esqueléticos.‡Thassarian, à bord du Brise-ciel, vous demande d\'utiliser l\'Acide volatil pour dissoudre les cadavres de 6 Saccageurs squelettiques.‡破天号的萨萨里安要你使用强酸溶解6具冰冠劫掠者的尸体。‡破天者號上的薩沙理安希望你用烈性酸液來溶解6個骷髏劫奪者的屍體。',
  }
},
[13336] = {
  {
    'Sangue dos escolhidos‡Кровь избранных‡Blut der Auserwählten‡선택받은 자의 피‡Sangre de los elegidos‡Sangre de los elegidos‡Le sang des Élus‡伊米亚之血‡受選者的血',
    nil,
    'O Capitão-cavaleiro Drosche, a bordo do Rompe-céus, ordenou que você mate 20 vraikalen em Ymarheim.‡Убейте 20 врайкулов в Имирхейме по просьбе рыцаря-капитана Дроша с "Усмирителя небес".‡Kürassier Drosche auf der Himmelsbrecher hat Euch entsandt, 20 Vrykul in Ymirheim zu töten.‡하늘파괴자호에 승선한 기사대장 드로쉬가 이미르하임에서 브리쿨 20명을 처치해 달라고 요청했습니다.‡Capitán caballero Drosche en El Rompecielos te ha enviado a matar a 20 vrykuls en Ymirheim.‡Capitán caballero Drosche en El Rompecielos te ha enviado a matar a 20 vrykuls en Ymirheim.‡Le Chevalier-capitaine Drosche, à bord du Brise-ciel, vous a demandé de tuer 20 Vrykuls à Ymirheim.‡破天号的骑士队长德洛斯彻要你前往伊米海姆，杀死20个维库人。‡破天者號上的騎士長德羅許要你到依米海姆殺掉20個維酷族。',
  }
},
[13337] = {
  {
    'A Muralha de Ferro‡Железный вал‡Das Eisenwallbollwerk‡무쇠벽 성채‡La Fortificación del Muro de Hierro‡La Fortificación del Muro de Hierro‡Le rempart Mur-de-fer‡铁墙壁垒‡鐵牆壁壘',
    nil,
    'Derrote Grimkor, o Perverso, e fale novamente com Thassarian a bordo do Rompe-céus.‡Убейте Гримкора Злобного и возвращайтесь к Тассариану на "Усмиритель небес".‡Besiegt Grimkor den Boshaften und kehrt zu Thassarian an Bord der Himmelsbrecher zurück.‡사악한 그림코르를 처치하고 하늘파괴자호에 있는 타사리안에게 돌아가야 합니다.‡Derrota a Grimkor el Maldito y vuelve junto a Thassarian a bordo de El Rompecielos.‡Derrota a Grimkor el Maldito y vuelve junto a Thassarian a bordo de El Rompecielos.‡Vaincre Grimkor le Malveillant et retourner voir Thassarian, à bord du Brise-ciel.‡击败邪恶的格姆克尔，然后向破天号的萨萨里安复命。‡擊敗邪惡的葛林克爾然後回報破天者號上的薩沙理安。',
  }
},
[13338] = {
  {
    'Os guardiões de Corp\'rethar‡Стражи Корп\'ретара‡Die Wächter von Corp\'rethar‡코프레타르의 수호자‡Los guardianes de Corp\'rethar‡Los guardianes de Corp\'rethar‡Les gardiens de Corp\'rethar‡科雷萨的守卫者‡寇普雷薩的守衛者',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você mate 5 Emissários do Terror e 5 Guardiões Corp\'rethar.‡Убейте 5 провозвестников ужаса и 5 стражей Корп\'ретара по приказу Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher wünscht, dass Ihr 5 Herolde des Schreckens und 5 Wächter von Corp\'rethar tötet.‡하늘파괴자호에 있는 타사리안이 공포의 선구자 5명과 코프레타르 경비병 5명을 해치워 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que mates a 5 presagistas de horror y a 5 guardianes de Corp\'rethar.‡Thassarian, a bordo de El Rompecielos, quiere que mates a 5 presagistas de horror y a 5 guardianes de Corp\'rethar.‡Thassarian, à bord du Brise-ciel, vous demande de tuer 5 Messagers de l\'Horreur et 5 Gardiens de Corp\'rethar.‡破天号的萨萨里安要你去杀死5个恐惧先驱和5个科雷萨守卫者。‡破天者號上的薩沙理安要你殺掉5個恐慌先驅者與 5個寇普雷薩守護者。',
  }
},
[13339] = {
  {
    'Estilhaçando os estilhaços‡Вдребезги‡Einen Scherbenhaufen hinterlassen‡조각 깨뜨리기‡Hacer añicos los fragmentos‡Hacer añicos los fragmentos‡Briser les éclats‡击破碎片‡擊破碎片',
    nil,
    'Traga o Estilhaço Quebrado do Horror, o Estilhaço Quebrado do Desespero e o Estilhaço Quebrado do Sofrimento para Thassarian, a bordo do Rompe-céus.‡Принесите Тассариану на "Усмиритель небес" осколки кристалла Ужаса, кристалла Отчаяния и кристалла Страдания.‡Bringt Thassarian an Bord der Himmelsbrecher den zerbrochenen Splitter des Schreckens, den zerbrochenen Splitter der Verzweiflung und den zerbrochenen Splitter des Leidens.‡하늘파괴자호에 있는 타사리안에게 부서진 공포의 조각, 부서진 절망의 조각, 부서진 고통의 조각을 가져와야 합니다.‡Lleva el fragmento de horror roto, el fragmento de desesperación roto y el fragmento de sufrimiento roto a Thassarian en El Rompecielos.‡Lleva el fragmento de horror roto, el fragmento de desesperación roto y el fragmento de sufrimiento roto a Thassarian en El Rompecielos.‡Apportez l\'Éclat d\'horreur brisé, l\'Éclat de désespoir brisé et l\'Éclat de souffrance brisé à Thassarian, à bord du Brise-ciel.‡将破损的绝望碎片、破损的恐惧碎片和破损的苦难碎片交给破天号的萨萨里安。‡將破損的驚怖裂片、破損的絕望裂片、破損的苦難裂片，帶回來給破天者號上的薩沙理安。',
  }
},
[13340] = {
  {
    'Juntando-se ao ataque‡Помощь в нападении‡Schließt Euch dem Angriff an‡공격 합류‡Unirse al ataque‡Unirse al ataque‡Des troupes pour l\'assaut‡协助突袭‡聯合作戰',
    nil,
    'Apresente-se ao Comandante Terrestre Xutja na borda do glaciar ao norte de Ymarheim.‡Явитесь к командиру наземных войск Ксутье на краю ледника к северу от Имирхейма.‡Meldet Euch bei Feldkommandant Xutjja an der Kante des Gletschers im Norden von Ymirheim.‡이미르하임 북쪽 빙하의 가장자리에 있는 지상군 사령관 수트야에게 보고해야 합니다.‡Preséntate ante el comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim.‡Preséntate ante el comandante de tierra Xutjja en el borde del glaciar al norte de Ymirheim.‡Présentez-vous au Commandant Xutjja au bord du glacier, au nord d\'Ymirheim.‡向伊米海姆北面冰川边缘的地面指挥官科特亚报到。‡向依米海姆北側冰冠邊緣的地面指揮官蘇加報到。',
  }
},
[13341] = {
  {
    'Juntando-se ao ataque‡Помощь в нападении‡Schließt Euch dem Angriff an‡공격 합류‡Unirse al ataque‡Unirse al ataque‡Des troupes pour l\'assaut‡协助突袭‡聯合作戰',
    nil,
    'Apresente-se ao Comandante Terrestre Koup na borda do glaciar, a leste de Ymarheim.‡Явитесь к военачальнику Купу на краю ледника к северу от Имирхейма.‡Meldet Euch bei Feldkommandant Koup an der Kante des Gletschers im Osten von Ymirheim.‡이미르하임 동쪽 빙하의 가장자리에 있는 지상군 사령관 쿠프에게 보고해야 합니다.‡Preséntate ante el comandante de tierra Koup en el borde del glaciar al este de Ymirheim.‡Preséntate ante el comandante de tierra Koup en el borde del glaciar al este de Ymirheim.‡Présentez-vous au Commandant Koup au bord du glacier à l\'est d\'Ymirheim.‡向伊米海姆东面冰川上的地面指挥官库普报道。‡向依米海姆東側冰冠邊緣的地面指揮官庫普報到。',
  }
},
[13342] = {
  {
    'Outro tipo de grampo‡Ненастоящий шпион‡Keine Wanze‡암흑의 첩보원‡Espía como puedas‡Espía como puedas‡Il n\'est pas nuisible‡活动窃听器‡不只是蟲子',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você colete 5 Matérias Negras e evoque um Mensageiro Sombrio em Aldur\'thar.‡Соберите 5 темных сущностей и вызовите темного посланника в Алдур\'таре по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr 5 dunkle Materien sammelt und in Aldur\'thar einen dunklen Boten beschwört.‡하늘파괴자호에 승선한 타사리안이 알두르타르에서 암흑 물질 5개를 모아 암흑 전령을 소환해 달라고 요청했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que recojas 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar.‡Thassarian, a bordo de El Rompecielos, quiere que recojas 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar.‡Thassarian, à bord du Brise-ciel, veut que vous récupériez 5 Matières noires et que vous invoquiez un Sombre messager à Aldur\'thar.‡破天号上的萨萨里安希望你去收集5份黑暗物质，然后在奥尔杜萨召唤出一名黑暗信使。‡破天者號上的薩沙理安要你在奧多薩蒐集5個黑暗物質來召喚黑暗信差。',
  }
},
[13343] = {
  {
    'O mistério infinito do infinito‡Тайна бесконечности, мания преследования‡Geheimnis der Ewigen, die 2.‡돌아온 무한의 비밀‡El misterio del Infinito, Vuelta atrás‡El misterio del Infinito, Vuelta atrás‡Mystère de l\'infini, le retour‡永恒之龙的秘密，再来一次‡恆龍之謎，復甦',
    nil,
    'Crona, no topo do Templo do Repouso das Serpes, quer que você vá mais uma vez até o Santuário Dragônico Bronze.|n|nUma vez lá dentro, posicione a Ampulheta da Eternidade no chão e ajude o seu Eu Passado a proteger a ampulheta das forças da Revoada Infinita.‡Хроми на вершине храма Драконьего Покоя просит вас снова отправиться в Бронзовое святилище драконов.|n|nОказавшись в святилище, установите песочные часы Вечности и помогите Себе-в-Прошлом защитить их от атак драконов Бесконечности.‡Chromie auf der höchsten Ebene des Wyrmruhtempels wünscht, dass Ihr noch einmal zum Bronzedrachenschrein reist.|n|nSobald Ihr dort seid, sollt Ihr das Stundenglas der Ewigkeit auf den Boden stellen und Eurem vergangenen Selbst dabei helfen, es vor den Truppen des ewigen Drachenschwarms zu beschützen.‡고룡쉼터 사원 꼭대기에 있는 크로미가 청동 용제단으로 한 번 더 이동해 달라고 부탁했습니다.|n|n용제단에 도착하면 영원의 모래시계를 바닥에 놓고 과거의 자신이 모래시계를 무한의 용군단으로부터 보호하도록 도와야 합니다.‡Cromi en la cima del Templo del Reposo del Dragón, te ha pedido que viajes otra vez al Santuario de Dragones Bronce.|n|nUna vez dentro, coloca el reloj de arena de eternidad en el suelo y ayuda a tu Yo pasado a protegerlo de las fuerzas del Vuelo Infinito.‡Cromi en la cima del Templo del Reposo del Dragón, te ha pedido que viajes otra vez al Santuario de Dragones Bronce.|n|nUna vez dentro, coloca el reloj de arena de eternidad en el suelo y ayuda a tu Yo pasado a protegerlo de las fuerzas del Vuelo Infinito.‡Chromie, au sommet du Temple du Repos du ver, vous a demandé de vous rendre une fois encore au Sanctuaire draconique bronze.|n|nUne fois à l\'intérieur, placez le Sablier de l\'Éternité sur le sol et aidez Votre vous passé à le protéger contre les forces du Vol infini.‡龙眠神殿顶层的克罗米要你再次返回青铜巨龙圣地。|n|n进入圣地后，将永恒沙漏放在地上，和过去的你一起保护沙漏，令它免遭永恒之龙的破坏。‡龍眠神殿的克羅米要求你再次回到青銅龍殿。|n|n一旦進入龍殿，將永恆沙漏放在地上並幫助過去的自己抵抗恆龍軍團。',
  }
},
[13344] = {
  {
    'Outro tipo de grampo‡Ненастоящий шпион‡Keine Wanze‡암흑의 첩보원‡Espía como puedas‡Espía como puedas‡Il n\'est pas nuisible‡活动窃听器‡不只是蟲子',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você colete 5 Matérias Negras e evoque um Mensageiro Sombrio em Aldur\'thar.‡Соберите 5 темных сущностей и вызовите темного посланника в Алдур\'таре по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr 5 dunkle Materien sammelt und in Aldur\'thar einen dunklen Boten beschwört.‡하늘파괴자호에 승선한 타사리안이 알두르타르에서 암흑 물질 5개를 수집하여 암흑 전령을 소환해 달라고 요청했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que recojas 5 materias oscuras y que invoques a un mensajero oscuro a Aldur\'thar.‡Thassarian, a bordo de El Rompecielos, quiere que recojas 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar.‡Thassarian, à bord du Brise-ciel, veut que vous récupériez 5 Matières noires et que vous invoquiez un Sombre messager à Aldur\'thar.‡破天号上的萨萨里安希望你去收集5份黑暗物质，然后在奥尔杜萨召唤出一名黑暗信使。‡破天者號上的薩沙理安要你在奧多薩蒐集5個黑暗物質來召喚黑暗信差。',
  }
},
[13345] = {
  {
    'Precisamos de mais informações‡Слишком мало сведений‡Brauche mehr Informationen‡정보 부족‡Más información‡Más información‡Besoin d\'infos supplémentaires‡需要更多情报‡需要更多資訊',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você pegue 3 páginas da Pesquisa dos Sectários dos Pesquisadores da Seita, em Aldur\'thar, e as use para criar a Tese da Seita dos Malditos.‡Отберите у ученых культа в Алдур\'таре 3 страницы Исследований Культа Проклятых и используйте их, чтобы составить доклад о Культе Проклятых по приказу Тассариана с "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr 3 Seiten Forschung der Kultisten von den Forschern der Kultisten in Aldur\'thar sammelt, um damit eine These über den Kult der Verdammten zu erstellen.‡하늘파괴자호에 승선한 타사리안이 알두르타르 이교도 연구원들로부터 이교도 연구 일지 3장을 모아 이를 바탕으로 저주받은 자들의 교단 보고서를 작성해 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que consigas 3 páginas de investigación de cultores de los investigadores del Culto en Aldur\'thar, y las utilices para crear la tesis del Culto de los Malditos.‡Thassarian, a bordo de El Rompecielos, quiere que consigas 3 páginas de investigación de cultores de los investigadores del Culto en Aldur\'thar, y las utilices para crear la tesis del Culto de los Malditos.‡Thassarian, à bord du Brise-ciel, veut que vous récupériez les 3 pages de Recherche du Culte des damnés sur des Chercheurs du culte à Aldur\'thar et que vous les utilisez pour créer la Thèse du Culte des damnés.‡破天号上的萨萨里安希望你从奥尔杜萨的诅咒教派研究员身上收集3页诅咒教派研究笔记，然后将它们组合成诅咒教派论文。‡破天者號上的薩沙理安要你在奧多薩的神教研究員身上蒐集3頁詛咒神教研究，然後編成詛咒神教論文。',
  }
},
[13346] = {
  {
    'Onde os maléficos não têm descanso‡Пусть злодеи не ведают покоя‡Es kann der Böseste nicht in Frieden ruhen...‡악당을 위한 휴식은 없다‡El mal nunca duerme‡El mal nunca duerme‡Pas de repos pour les malfaisants‡片刻不得安宁‡別讓邪惡伺機喘息',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você derrote Alumeth, o Ascencionado, em Aldur\'thar.‡Повергните Алумета Восходящего в Алдур\'таре по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr Alumeth den Aufgestiegenen in Aldur\'thar besiegt.‡하늘파괴자호에 승선한 타사리안이 알두르타르의 승천한 알루메스를 물리쳐 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que derrotes a Alumeth el Ascendido en Aldur\'thar.‡Thassarian, a bordo de El Rompecielos, quiere que derrotes a Alumeth el Ascendido en Aldur\'thar.‡Thassarian, à bord du Brise-ciel, vous demande de vaincre Alumeth le Sublimé à Aldur\'thar.‡破天号上的萨萨里安希望你前往奥尔杜萨，杀死晋升者奥鲁麦斯。‡破天者號上的薩沙理安要你在奧多薩擊敗飛升的雅路麥斯。',
  }
},
[13347] = {
  {
    'Reborn From The Ashes‡Восставший из праха‡Wiedergeboren aus der Asche‡잿더미로부터의 환생‡Renacer de las cenizas‡Renacer de las cenizas‡Renaître de ses cendres‡浴火重生‡從灰燼中重生',
    nil,
    'Gather Fordragon\'s Shield from the field of battle at Angrathar the Wrath Gate and return it to King Varian Wrynn at Stormwind Keep in Stormwind City.‡Найдите щит Фордрагона на поле боя при Ангратаре, Вратах Гнева. Отнесите щит в крепость Штормграда и вручите королю Вариану Ринну.‡Geht zum Schlachtfeld vor Angrathar, der Pforte des Zorns, findet Fordragons Schild und bringt ihn zu König Varian Wrynn nach Burg Sturmwind in Sturmwind.‡분노의 관문 앙그라타르의 전장에서 폴드라곤의 방패를 찾아 스톰윈드 왕궁에 있는 국왕 바리안 린에게 돌려줘야 합니다.‡Recoge el escudo de Fordragón del campo de batalla en Angrathar la Puerta de Cólera y devuélveselo al rey Varian Wrynn en el Castillo de Ventormenta en la ciudad de Ventormenta.‡Recoge el escudo de Fordragón del campo de batalla en Angrathar la Puerta de Cólera y devuélveselo al rey Varian Wrynn en el Castillo de Ventormenta en la ciudad de Ventormenta.‡Récupérez le bouclier de Fordragon sur le champ de bataille à Angrathar, le Portail du Courroux, et rapportez-le au roi Varian Wrynn au Donjon de Hurlevent à Hurlevent.‡从天谴之门安加萨的战场上取回弗塔根之盾，把它交给暴风城要塞中的瓦里安·乌瑞恩国王。‡從『憤怒之門』安格拉薩的戰場上蒐集弗塔根的盾，回到暴風城的暴風要塞，向國王瓦里安·烏瑞恩回報。',
  }
},
[13348] = {
  {
    '‡Тщета‡Sinnlosigkeit‡‡Inutilidad‡Inutilidad‡Futilité‡徒劳‡毫無意義',
    nil,
    '‡Возвращайтесь к Кольтире Ткачу Смерти на борт "Молота Оргрима".‡Kehrt zu Koltira Todesweber an Bord der Orgrims Hammer zurück.‡오그림의 망치호에 있는 콜티라 데스위버에게 가야 합니다.‡Vuelve con Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Vuelve con Koltira Tejemuerte a bordo del Martillo de Orgrim.‡Retournez voir Koltira Tissemort à bord du Marteau d\'Orgrim.‡‡',
  }
},
[13349] = {
  {
    '‡Колыбель ледяных драконов‡Die Wiege der Frostbrut‡서리고룡족의 요람‡Cuna del Razaescarcha‡Cuna del Razaescarcha‡Le berceau des Couvegivres‡冰霜巨龙的摇篮‡霜育之源',
    nil,
    '‡Отправляйтесь в Каньон Гибели Синдрагосы и убейте 5 воскресителей драконов, 8 сектантов-осквернителей и 3 врайкулов-некролордов по просьбе Кольтиры Ткача Смерти с "Молота Оргрима".‡Koltira Todesweber an Bord der Orgrims Hammer möchte, dass Ihr 5 Wyrmwiedererwecker, 8 Verderber der Kultisten und 3 Nekrolords der Vrykul in Sindragosas Sturz tötet.‡오그림의 망치호에 있는 콜티라 데스위버가 신드라고사의 추락지에서 고룡 생환술사 5마리, 이교도 타락자 8마리, 브리쿨 강령군주 3마리를 처치해 달라고 했습니다.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 reanimadores de vermis, 8 corruptores cultores y 3 necroseñores vrykuls en La Caída de Sindragosa.‡Koltira Tejemuerte a bordo del Martillo de Orgrim quiere que mates a 5 reanimadores de vermis, 8 corruptores cultores y 3 necroseñores vrykuls en La Caída de Sindragosa.‡Koltira Tissemort, à bord du Marteau d\'Orgrim, veut que vous tuiez 5 Réanimateurs de wyrms, 8 Sectateurs corrupteurs et 3 Nécro-seigneurs vrykuls à la Chute de Sindragosa.‡‡',
  }
},
[13350] = {
  {
    'Onde os maléficos não têm descanso‡Пусть злодеи не ведают покоя‡Es kann der Böseste nicht in Frieden ruhen...‡악당을 위한 휴식은 없다‡El mal nunca duerme‡El mal nunca duerme‡Pas de repos pour le malfaisant‡片刻不得安宁‡別讓邪惡伺機喘息',
    nil,
    'Thassarian, a bordo do Rompe-céus, quer que você derrote Alumeth, o Ascencionado, em Aldur\'thar.‡Повергните Алумета Восходящего в Алдур\'таре по просьбе Тассариана, который находится на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr Alumeth den Aufgestiegenen in Aldur\'thar vernichtet.‡하늘파괴자호에 승선한 타사리안이 알두르타르의 승천한 알루메스를 물리쳐 달라고 부탁했습니다.‡Thassarian, a bordo de El Rompecielos, quiere que derrotes a Alumeth el Ascendido en Aldur\'thar.‡Thassarian, a bordo de El Rompecielos, quiere que derrotes a Alumeth el Ascendido en Aldur\'thar.‡Thassarian, à bord du Brise-ciel, vous demande de vaincre Alumeth le Sublimé à Aldur\'thar.‡破天号上的萨萨里安希望你前往奥尔杜萨，杀死晋升者奥鲁麦斯。‡破天者號上的薩沙理安要你在奧多薩擊敗飛升的雅路麥斯。',
  }
},
[13351] = {
  {
    'Um vislumbre do que está por vir‡Предварительная разведка‡Vorschau‡미리 보기‡La primicia‡La primicia‡Avant-première‡预览‡暗中偵查',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você voe sobre o portão da desolação, visitando as partes sul, central, norte e noroeste do portão.‡Слетайте к Вратам Горя и ознакомьтесь с южной, центральной, северной и северо-западной частями Врат по просьбе Кольтиры с "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr hinunter zum Tor der Verwüstung fliegt und Euch den südlichen, zentralen, nördlichen und nordwestlichen Bereich des Tors anseht.‡오그림의 망치호에 승선한 콜티라가 황폐의 관문으로 비행하여 관문의 남부, 중부, 북부 및 북서부 지역을 정찰해 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrimm, quiere que vueles a la puerta de la desolación y que explores las zonas sur, central, norte y noroeste de la puerta.‡Koltira, a bordo del Martillo de Orgrimm, quiere que vueles a la puerta de la desolación y que explores las zonas sur, central, norte y noroeste de la puerta.‡Koltira, à bord du Marteau d\'Orgrim, vous a demandé de voler vers la Porte de la Désolation, et de visiter les zones sud, centrale, nord et nord-ouest de la porte.‡奥格瑞姆之锤的库尔迪拉希望你飞往荒凉之门，调查荒凉之门的南部、中部、北部和西北部。‡奧格林之錘上的寇爾提拉·亡織者要你飛往荒寂之門，偵查門的南、中、北、西北區域。',
  }
},
[13352] = {
  {
    'Arrastar e soltar‡Перетащить и опустить‡Gefährliche Gewandung‡끌어다 놓기‡Arrastrar y soltar‡Arrastrar y soltar‡Attraper et lâcher‡从天而“降”‡舉手之勞',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você colete Orbes de Ilusão dos Iniciados Amargos, em Aldur\'thar, e que os use em 3 Subjugadores Atrozes de lá.‡Отберите сферы иллюзии у озлобленных посвященных в Алдур\'таре и используйте их против 3 темных поработителей по просьбе Кольтиры, который находится на борту "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr Kugeln der Illusion von bitteren Initianden in Aldur\'thar sammelt und sie dann auf 3 dunkle Unterwerfer anwendet.‡오그림의 망치호에 승선한 콜티라가 알두르타르의 냉혹한 수습생들로부터 환영의 수정구를 모아, 수정구들을 그 곳에 있는 어둠의 정복자 3명에게 사용해 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Koltira, à bord du Marteau d\'Orgrim, vous a demandé de récupérer des Orbes d\'illusion sur des Initiés amers à Aldur\'thar et de les utiliser sur 3 Subjugateurs sombres sur place.‡奥格瑞姆之锤的库尔迪拉希望你从奥尔杜萨的苦痛新兵身上夺取幻象宝珠，然后对那里的3名黑暗压制者使用。‡奧格林之錘上的寇爾提拉·亡織者要你從奧多薩的惡劣新兵身上取得幻術寶珠，然後在3個黑暗征服者身上使用它。',
  }
},
[13353] = {
  {
    'Arrastar e soltar‡Перетащить и опустить‡Gefährliche Gewandung‡끌어다 놓기‡Arrastrar y soltar‡Arrastrar y soltar‡Attraper et lâcher‡从天而“降”‡舉手之勞',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você colete Orbes de Ilusão dos Iniciados Amargos, em Aldur\'thar, e que os use em 3 Subjugadores Atrozes de lá.‡Отберите сферы иллюзии у озлобленных посвященных в Алдур\'таре и используйте их против 3 темных поработителей по просьбе Кольтиры, который находится на борту "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr Kugeln der Illusion von bitteren Initianden in Aldur\'thar sammelt und sie dann auf 3 dunkle Unterwerfer anwendet.‡오그림의 망치호에 승선한 콜티라가 알두르타르의 냉혹한 수습생들로부터 환영의 수정구를 모아, 수정구들을 그 곳에 있는 어둠의 정복자 3명에게 사용해 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas orbes de ilusión de los iniciados amargos en Aldur\'thar y los uses en 3 subyugadores oscuros.‡Koltira, à bord du Marteau d\'Orgrim, vous demande de récupérer des Orbes d\'illusion sur des Initiés amers à Aldur\'thar et de les utiliser sur 3 Subjugateurs sombres sur place.‡奥格瑞姆之锤的库尔迪拉希望你从奥尔杜萨的苦痛新兵身上夺取幻象宝珠，然后对那里的3名黑暗压制者使用。‡奧格林之錘上的寇爾提拉·亡織者要你從奧多薩的惡劣新兵身上取得幻術寶珠然後用在3個黑暗征服者身上。',
  }
},
[13354] = {
  {
    'Cadeia de comando‡Вершина иерархии‡Befehlskette‡지휘 계통‡Cadena de mando‡Cadena de mando‡La chaîne de commandement‡指挥体系‡切斷指揮鍊',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você vá a Aldur\'thar e derrote o Feitor Faedris, o Feitor Savryn, o Feitor Veraj e o Feitor Jhaeqon.‡Отправляйтесь в Алдур\'тар и убейте надзирателя Фэдриса, надзирателя Саврина, надзирателя Веража и надзирателя Джакона про просьбе Кольтиры с "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr nach Aldur\'thar geht und Aufseher Faedris, Aufseher Savryn, Aufseher Veraj und Aufseher Jhaeqon besiegt.‡오그림의 망치호에 승선한 콜티라가 알두르타르에 가서 감독관 패드리스, 감독관 사브린, 감독관 베라즈, 감독관 재콘을 제거해 달라고 부탁했습니다.‡Koltira a bordo del Martillo de Orgrim quiere que vayas a Aldur\'thar para derrotar al sobrestante Faedris, al sobrestante Savryn, al sobrestante Veraj y al sobrestante Jhaeqon.‡Koltira a bordo del Martillo de Orgrim quiere que vayas a Aldur\'thar para derrotar al sobrestante Faedris, al sobrestante Savryn, al sobrestante Veraj y al sobrestante Jhaeqon.‡Koltira, à bord du Marteau d\'Orgrim, vous a demandé d\'aller à Aldur\'thar et de vaincre le Surveillant Faedris, le Surveillant Savryn, le Surveillant Veraj et le Surveillant Jhaeqon.‡奥格瑞姆之锤的库尔迪拉要你前往荒凉之门奥尔杜萨，击败工头法埃迪斯、工头沙维尔、工头维拉恩和工头夏克尔。‡奧格林之錘上的寇爾提拉要你前往奧多薩擊敗監督者菲德里斯、監督者薩夫林、監督者維拉傑與監督者杰昆。',
  }
},
[13355] = {
  {
    'Impossível reproduzir‡Невоспроизводимый компонент‡Kann nicht reproduziert werden‡괴상한 약을 찾아서‡Imposible reproducir‡Imposible reproducir‡Impossible à reproduire‡无法复制‡重製失敗',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você encha o Frasco Particionado com material dos 3 Caldeirões dos Sectários em Aldur\'thar. Em seguida, leve-o ao Engenheiro-chefe Cobregarra.‡Кольтира с корабля "Молот Оргрима" хочет, чтобы вы наполнили секционную флягу изо всех 3 котлов служителей культа в Алдур\'таре, а затем отнесли ее главному инженеру Меднопалу.‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr das unterteilte Fläschchen an jedem der 3 Kessel der Kultisten auffüllt und es anschließend zu Chefingenieur Kupferklammer bringt.‡오그림의 망치호에 승선한 콜티라가 알두르타르에 있는 이교도 가마솥 3개의 내용물을 다단 플라스크에 담아 선임기술자 코퍼클로에게 가져가 달라고 요청했습니다.‡Koltira a bordo del Martillo de Orgrim quiere que uses el frasco dividido en cada una de las 3 calderas de los cultores en Aldur\'thar, y luego se lo lleves a ingeniero jefe Garrabronce.‡Koltira a bordo del Martillo de Orgrim quiere que uses el frasco dividido en cada una de las 3 calderas de los cultores en Aldur\'thar, y luego se lo lleves a ingeniero jefe Garrabronce.‡Koltira, à bord du Marteau d\'Orgrim, vous demande d\'utiliser le Flacon cloisonné sur chacun des 3 Chaudrons de sectateur à Aldur\'thar. Apportez-le ensuite à l\'Ingénieur en chef Cuivregrif.‡奥格瑞姆之锤的库尔迪拉希望你前往荒凉之门奥尔杜萨，在那里的3处诅咒教徒的大锅中使用分离的药瓶，然后将其交给首席技师考伯克拉。‡奧格林之錘上的寇爾提拉·亡織者要你利用隔離之瓶從3個教徒的大鍋帶回樣本給首席工程師栓鉗。',
  }
},
[13356] = {
  {
    'Novo teste‡Все переиграть‡Jetzt neu testen‡재실험‡Volver a probar‡Volver a probar‡Testez-le à nouveau‡重新考验‡重新測試',
    nil,
    'O Engenheiro-chefe Cobregarra, a bordo do Martelo de Orgrim, quer que você jogue a Massa Deformada em um dos caldeirões de Aldur\'thar.‡Бросьте корчащуюся массу в котел в Алдур\'таре по просьбе главного инженера Меднопала с "Молота Оргрима".‡Chefingenieur Kupferklammer an Bord der Orgrims Hammer möchte, dass Ihr eine windende Masse in einen der Kessel in Aldur\'thar werft.‡오그림의 망치호에 승선한 선임기술자 코퍼클로가 몸부림치는 덩어리를 알두르타르의 가마솥에 던져 넣어 달라고 부탁했습니다.‡El ingeniero jefe Garrabronce a bordo del Martillo de Orgrim quiere que tires una masa aviesa dentro de una caldera de Aldur\'thar.‡El ingeniero jefe Garrabronce a bordo del Martillo de Orgrim quiere que tires una masa aviesa dentro de una caldera de Aldur\'thar.‡L\'Ingénieur en chef Cuivregrif, à bord du Marteau d\'Orgrim, veut que vous jetiez une Masse grouillante dans un chaudron à Aldur\'thar.‡奥格瑞姆之锤的首席技师考伯克拉希望你把沸腾的魔质扔进奥尔杜萨的瘟疫之锅里。‡奧格林之錘上的首席工程師銅爪要你將苦痛糾結凝塊丟進奧多薩的一個大鍋中。',
  }
},
[13357] = {
  {
    'Novo teste‡Все переиграть‡Jetzt neu testen‡재실험‡Volver a probar‡Volver a probar‡Testez-le à nouveau‡重新考验‡重新測試',
    nil,
    'O Engenheiro-chefe Cobregarra, a bordo do Martelo de Orgrim, quer que você jogue a Massa Deformada em um dos caldeirões de Aldur\'thar.‡Бросьте корчащуюся массу в котел в Алдур\'таре по просьбе главного инженера Меднопала с "Молота Оргрима".‡Chefingenieur Kupferklammer an Bord der Orgrims Hammer möchte, dass Ihr eine windende Masse in einen der Kessel in Aldur\'thar werft.‡오그림의 망치호에 승선한 선임기술자 코퍼클로가 몸부림치는 덩어리를 알두르타르의 가마솥에 던져 넣어 달라고 부탁했습니다.‡El ingeniero jefe Garrabronce a bordo del Martillo de Orgrim quiere que tires una masa aviesa dentro de una caldera de Aldur\'thar.‡El ingeniero jefe Garrabronce a bordo del Martillo de Orgrim quiere que tires una masa aviesa dentro de una caldera de Aldur\'thar.‡L\'Ingénieur en chef Cuivregrif, à bord du Marteau d\'Orgrim, veut que vous jetiez une Masse grouillante dans un chaudron à Aldur\'thar.‡奥格瑞姆之锤的首席技师考伯克拉希望你把沸腾的魔质扔进奥尔杜萨的瘟疫之锅里。‡奧格林之錘上的首席工程師銅爪要你將苦痛糾結凝塊丟進奧多薩的一個大鍋中。',
  }
},
[13358] = {
  {
    'Outro tipo de grampo‡Ненастоящий шпион‡Keine Wanze‡암흑의 첩보원‡Espía como puedas‡Espía como puedas‡Il n\'est pas nuisible‡活动窃听器‡不只是蟲子',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você colete 5 Matérias Negras e evoque um Mensageiro Sombrio em Aldur\'thar.‡Соберите 5 темных сущностей и вызовите темного посланника в Алдур\'таре по просьбе Кольтиры, который находится на борту "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr 5 dunkle Materien sammelt und in Aldur\'thar einen dunklen Boten beschwört.‡오그림의 망치호에 승선한 콜티라가 알두르타르에서 암흑 물질 5개를 모아 암흑 전령을 소환해 달라고 요청했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas a 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas a 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar.‡Koltira, à bord du Marteau d\'Orgrim, veut que vous récupériez 5 Matières noires et que vous invoquiez un Sombre messager à Aldur\'thar.‡奥格瑞姆之锤的库尔迪拉希望你去收集5份黑暗物质，然后在奥尔杜萨召唤出一名黑暗信使。‡奧格林之錘上的寇爾提菈要你在奧多薩蒐集5個黑暗物質來召喚黑暗信差。',
  }
},
[13359] = {
  {
    '‡Место гибели драконов‡Wo Drachen einst fielen‡용의 무덤‡Donde perecieron los dragones‡Donde perecieron los dragones‡Où les dragons tombent‡巨龙的墓地‡龍殞之地',
    nil,
    '‡Добудьте в Каньоне Гибели Синдрагосы 6 горстей пыли из костей дракончиков по приказу Матиаса Нетлера.‡Matthias Lehner in Sindragosas Sturz möchte, dass Ihr 6 Einheiten Welpenknochenstaub besorgt.‡신드라고사의 추락지에 있는 마시어스 레넷이 새끼용 뼛가루 6개를 가져다 달라고 했습니다.‡Matthias Lehner en La Caída de Sindragosa quiere que consigas 6 polvos de huesos de cría.‡Matthias Lehner en La Caída de Sindragosa quiere que consigas 6 polvos de huesos de cría.‡Matthias Lehner, à la chute de Sindragosa, vous a demandé de récupérer 6 Poussières d\'os de dragonnet.‡辛达苟萨之墓的米斯希尔萨·阿奈尔要你收集6份雏龙的骨灰。‡',
  }
},
[13360] = {
  {
    '‡Время ответов‡Zeit für Antworten‡응답할 시간‡El momento de respuestas‡El momento de respuestas‡L\'heure des réponses‡寻求答案‡揭曉之時',
    nil,
    '‡Поговорите с Матиасом Нетлером во Дворе Костей.‡Sprecht mit Matthias Lehner im Hof der Knochen.‡뼈의 궁정에 있는 마시어스 레넷과 대화해야 합니다.‡Habla con Matthias Lehner en El Patio de los Huesos.‡Habla con Matthias Lehner en El Patio de los Huesos.‡Parlez à Matthias Lehner à la Cour des Ossements.‡前往白骨之庭，与米斯希尔萨·阿奈尔谈一谈。‡',
  }
},
[13361] = {
  {
    '‡Охотник и принц‡Der Jäger und der Prinz‡사냥꾼과 왕자‡El cazador y el príncipe‡El cazador y el príncipe‡Le chasseur et le prince‡猎人与王子‡王子與獵手',
    nil,
    '‡Матиас Нетлер со Двора Костей хочет, чтобы вы нашли Окровавленный камень и увидели, что случилось с принцем.‡Matthias Lehner im Hof der Knochen möchte, dass Ihr nach einem blutbefleckten Stein sucht und das Schicksal des Prinzen zu Ende bringt.‡뼈의 궁정에 있는 마시어스 레넷이 피로 물든 돌을 찾아 왕자의 운명을 완성해 달라고 했습니다.‡Matthias Lehner en El Patio de los Huesos quiere que busques una roca manchada de sangre y completes el destino del príncipe.‡Matthias Lehner en El Patio de los Huesos quiere que busques una roca manchada de sangre y completes el destino del príncipe.‡Matthias Lehner, à la Cour des Ossements, veut que vous cherchiez une Pierre tachée de sang et que vous accomplissiez le Destin du prince.‡白骨之庭的米斯希尔萨·阿奈尔要你去寻找一块染血的石头，并目睹王子的命运。‡',
  }
},
[13362] = {
  {
    '‡Знание – тяжкая ноша‡Wissen ist eine schreckliche Bürde‡아는 것이 병‡El saber es una carga terrible‡El saber es una carga terrible‡La connaissance est un lourd fardeau‡知识是可怕的负担‡最沉重的負荷',
    nil,
    '‡Вернитесь к Кольтире на борт "Молота Оргрима".‡Meldet Euch bei Koltira Todesweber an Bord der Orgrims Hammer.‡‡Informa otra vez a Koltira a bordo del Martillo de Orgrim.‡Informa otra vez a Koltira a bordo del Martillo de Orgrim.‡Présentez-vous à Koltira à bord du Marteau d\'Orgrim.‡‡',
  }
},
[13363] = {
  {
    '‡Помощь Серебряного Авангарда‡Hilfe vom Argentumkreuzzug‡‡Ayuda argenta‡Ayuda argenta‡L\'aide de l\'Argent‡银色北伐军的协助‡銀色的十字軍',
    nil,
    '‡Поговорите с верховным лордом Тирионом Фордрингом на Вершине Рыцарей.‡Sprecht mit Hochlord Tirion Fordring auf dem Kreuzfahrerturm.‡십자군 봉우리에 있는 대영주 티리온 폴드링과 대화해야 합니다.‡Habla con el alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Habla con el alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Parlez au Généralissime Tirion Fordring à la Cime des Croisés.‡与北伐军之峰的大领主提里奥·弗丁谈一谈。‡',
  }
},
[13364] = {
  {
    '‡Уловка Тириона‡Tirions Schachzug‡티리온의 계략‡Gambito de Tirion‡Gambito de Tirion‡Le gambit de Tirion‡提里奥的尝试‡提里奧的決斷',
    nil,
    '‡Тирион Фордринг с Вершины Рыцарей хочет, чтобы вы достали и надели капюшон сектанта-послушника, а затем встретились с ним у входа в Собор Тьмы, к северо-западу от цитадели Ледяной Короны.‡Tirion Fordring auf dem Kreuzfahrerturm möchte, dass Ihr die Kultistenkapuze besorgt, diese anzieht und Euch mit ihm am Eingang zur Kathedrale der Dunkelheit nordwestlich der Eiskronenzitadelle trefft.‡십자군 봉우리에 있는 티리온 폴드링이 이교도 수행사제 두건을 구해 쓴 다음 얼음왕관 성채의 북서쪽에 있는 어둠의 대성당으로 와달라고 했습니다.‡Tirion Vadín en el Pináculo de los Cruzados quiere que consigas y te pongas una caperuza de acólito cultor y que quedéis en la entrada de la Catedral de la Oscuridad, al noroeste de Ciudadela de la Corona de Hielo.‡Tirion Vadín en el Pináculo de los Cruzados quiere que consigas y te pongas una caperuza de acólito cultor y que quedéis en la entrada de la Catedral de la Oscuridad, al noroeste de Ciudadela de la Corona de Hielo.‡Tirion Fordring, à la Cime des Croisés, vous demande de trouver et de porter un Chaperon d\'acolyte du culte, puis de le rejoindre à l\'entrée de la Cathédrale des ténèbres, au nord-ouest de la Citadelle de la Couronne de glace.‡北伐军之峰的提里奥·弗丁要你想办法获取一件诅咒教徒的兜帽，穿上它，然后前往冰冠堡垒西北方的黑暗大教堂入口处与他汇合。‡',
  }
},
[13365] = {
  {
    'Outro tipo de grampo‡Ненастоящий шпион‡Keine Wanze‡암흑의 첩보원‡Espía como puedas‡Espía como puedas‡Il n\'est pas nuisible‡活动窃听器‡不只是蟲子',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você colete 5 Matérias Negras e evoque um Mensageiro Sombrio em Aldur\'thar.‡Соберите 5 темных сущностей и вызовите темного посланника в Алдур\'таре по просьбе Кольтиры, который находится на борту "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr 5 dunkle Materien sammelt und in Aldur\'thar einen dunklen Boten beschwört.‡오그림의 망치호에 승선한 콜티라가 알두르타르에서 암흑 물질 5개를 모아 암흑 전령을 소환해 달라고 요청했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas a 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar‡Koltira, a bordo del Martillo de Orgrim, quiere que recojas a 5 materias oscuras y que invoques a un mensajero oscuro en Aldur\'thar.‡Koltira, à bord du Marteau d\'Orgrim, vous a demandé de récupérer 5 Matières noires et d\'invoquer un Sombre messager à Aldur\'thar.‡奥格瑞姆之锤的库尔迪拉希望你去收集5份黑暗物质，然后在奥尔杜萨召唤出一名黑暗信使。‡奧格林之錘上的寇爾提菈要你在奧多薩蒐集5個黑暗物質來召喚黑暗信差。',
  }
},
[13366] = {
  {
    'Precisamos de mais informações‡Слишком мало сведений‡Brauche mehr Informationen‡정보 부족‡Más información‡Más información‡Besoin d\'infos supplémentaires‡需要更多情报‡需要更多資訊',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você pegue 3 páginas da Pesquisa dos Sectários dos Pesquisadores da Seita, em Aldur\'thar, e as use para criar a Tese da Seita dos Malditos.‡Отберите у ученых культа в Алдур\'таре 3 страницы Исследований Культа Проклятых и используйте их, чтобы составить доклад о Культе Проклятых по приказу Кольтиры с "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr 3 Seiten Forschung der Kultisten von den Forschern der Kultisten in Aldur\'thar sammelt, um damit eine These über den Kult der Verdammten zu erstellen...‡오그림의 망치호에 승선한 콜티라가 알두르타르 이교도 연구원들로부터 이교도 연구 일지 3장을 모아 이를 바탕으로 저주받은 자들의 교단 보고서를 작성해 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que consigas 3 páginas de investigación de cultores de los investigadores del Culto en Aldur\'thar, y las utilices para crear la tesis del Culto de los Malditos.‡Koltira, a bordo del Martillo de Orgrim, quiere que consigas 3 páginas de investigación de cultores de los investigadores del Culto en Aldur\'thar, y las utilices para crear la tesis del Culto de los Malditos.‡Koltira, à bord du Marteau d\'Orgrim, veut que vous récupériez les 3 pages de Recherche du Culte des damnés sur des Chercheurs du culte à Aldur\'thar et que vous les utilisez pour créer la Thèse du Culte des damnés.‡奥格瑞姆之锤的库尔迪拉希望你从奥尔杜萨的诅咒教派研究员身上收集3页诅咒教派研究笔记，然后将它们组合成诅咒教派论文。‡奧格林之錘上的寇爾提拉要你在奧多薩的神教研究員身上蒐集3頁詛咒神教研究，然後編成詛咒神教論文。',
  }
},
[13367] = {
  {
    'Onde os maléficos não têm descanso‡Пусть злодеи не ведают покоя‡Es kann der Böseste nicht in Frieden ruhen...‡악당을 위한 휴식은 없다‡El mal nunca duerme‡El mal nunca duerme‡Pas de repos pour les malfaisants‡片刻不得安宁‡別讓邪惡伺機喘息',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você derrote Alumeth, o Ascencionado, em Aldur\'thar.‡Повергните Алумета Восходящего в Алдур\'таре по просьбе Кольтиры Ткача Смерти, который находится на борту "Молота Оргрима".‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr Alumeth den Aufgestiegenen in Aldur\'thar besiegt.‡오그림의 망치호에 승선한 콜티라가 알두르타르의 승천한 알루메스를 물리쳐 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que mates a Alumeth el Ascendido en Aldur\'thar.‡Koltira, a bordo del Martillo de Orgrim, quiere que mates a Alumeth el Ascendido en Aldur\'thar.‡Koltira, à bord du Marteau d\'Orgrim, vous demande de tuer Alumeth le Sublimé à Aldur\'thar.‡奥格瑞姆之锤的库尔迪拉希望前往奥尔杜萨，杀死晋升者奥鲁麦斯。‡奧格林之錘上的寇爾提拉，要你在奧多薩擊敗飛升的雅路麥斯。',
  }
},
[13368] = {
  {
    'Onde os maléficos não têm descanso‡Пусть злодеи не ведают покоя‡Es kann der Böseste nicht in Frieden ruhen...‡악당을 위한 휴식은 없다‡El mal nunca duerme‡El mal nunca duerme‡Pas de repos pour le malfaisant‡片刻不得安宁‡別讓邪惡伺機喘息',
    nil,
    'Koltirus, a bordo do Martelo de Orgrim, quer que você derrote Alumeth, o Ascencionado, em Aldur\'thar.‡Кольтира на борту "Молота Оргрима" хочет, чтобы вы убили Алумета Восходящего в Алдур\'таре.‡Koltira an Bord der Orgrims Hammer möchte, dass Ihr Alumeth den Aufgestiegenen in Aldur\'thar tötet.‡오그림의 망치호에 승선한 콜티라가 알두르타르의 승천한 알루메스를 물리쳐 달라고 부탁했습니다.‡Koltira, a bordo del Martillo de Orgrim, quiere que mates a Alumeth el Ascendido en Aldur\'thar.‡Koltira, a bordo del Martillo de Orgrim, quiere que mates a Alumeth el Ascendido en Aldur\'thar.‡Koltira, à bord du Marteau d\'Orgrim, vous a demandé de tuer Alumeth le Sublimé à Aldur\'thar.‡奥格瑞姆之锤的库尔迪拉希望前往奥尔杜萨，杀死晋升者奥鲁麦斯。‡奧格林之錘上的寇爾提拉，要你在奧多薩擊敗飛升的雅路麥斯。',
  }
},
[13369] = {
  {
    'Fate, Up Against Your Will‡Против воли рока‡Das Schicksal wendet sich gegen Euch‡의지와 맞서는 운명‡Destino, contra tu voluntad‡Destino, contra tu voluntad‡Destin, contre votre volonté‡造化弄人‡事與願違',
    nil,
    'Assist Lady Jaina Proudmoore in Orgrimmar. Speak to the Warchief of the Horde, Thrall, at Orgrimmar on the continent of Kalimdor.‡Сопроводите леди Джайну Праудмур в Калимдор в Оргриммар. Поговорите с военачальником Орды Траллом.‡Steht Lady Jaina Prachtmeer in Orgrimmar zur Seite. Sprecht mit Thrall, dem Kriegshäuptling der Horde in Orgrimmar auf dem Kontinent Kalimdor.‡칼림도어 대륙에 있는 오그리마에서 여군주 제이나 프라우드무어를 도와 호드의 대족장 스랄과 대화해야 합니다.‡Ayuda a Jaina Valiente en Orgrimmar. Habla con el Jefe de Guerra de la Horda, Thrall, en Orgrimmar, en el continente de Kalimdor.‡Ayuda a Jaina Valiente en Orgrimmar. Habla con el Jefe de Guerra de la Horda, Thrall, en Orgrimmar, en el continente de Kalimdor.‡Aidez Dame Jaina Portvaillant à Orgrimmar. Parlez au Chef de guerre de la Horde, Thrall, à Orgrimmar sur le continent de Kalimdor.‡陪同吉安娜·普罗德摩尔前往卡利姆多大陆的奥格瑞玛，与部落的萨尔酋长交谈。‡在奧格瑪協助珍娜·普勞德摩爾女士。在卡林多大陸的奧格瑪，與部落的大酋長索爾對話。',
  }
},
[13370] = {
  {
    'A Royal Coup‡Королевский ход‡Ein königlicher Coup‡왕실 쿠데타‡Un golpe Real‡Un golpe Real‡Un coup royal‡政变‡皇室的政變',
    nil,
    'Use the portal in Grommash Hold to return to Stormwind Keep and deliver Thrall\'s message to King Varian Wrynn.‡Воспользуйтесь порталом в крепости Громмаш, чтобы вернуться в крепость Штормграда и передать послание Тралла королю Вариану Ринну.‡Benutzt das Portal in der Feste Grommash, um nach Burg Sturmwind zurückzukehren und Thralls Nachricht an König Varian Wrynn zu übergeben.‡그롬마쉬 요새의 차원문을 통해 스톰윈드 왕실로 돌아가 스랄의 전갈을 국왕 바리안 린에게 전해야 합니다.‡Utiliza el portal en el Fuerte de Grommash para volver al Castillo de Ventormenta y darle el mensaje de Thrall al rey Varian Wrynn.‡Utiliza el portal en el Fuerte de Grommash para volver al Castillo de Ventormenta y darle el mensaje de Thrall al rey Varian Wrynn.‡Utilisez le portail de Fort Grommash pour retourner au Donjon de Hurlevent et porter le message de Thrall au Roi Varian Wrynn.‡使用格罗玛什堡垒中的传送门返回暴风要塞，把萨尔的讯息转达给瓦里安·乌瑞恩国王。‡利用葛羅瑪許堡的傳送門回到暴風要塞，並將索爾的訊息傳遞給瓦里安·烏瑞恩國王。',
  }
},
[13371] = {
  {
    'The Killing Time‡В ожидании дальнейших распоряжений‡Es ist Zeit, totzuschlagen‡시간 보내기‡Hora de matar‡Hora de matar‡Le temps des meurtres‡杀戮时刻‡殺戮時刻',
    nil,
    'Use the Portal to the Undercity inside Stormwind Keep to teleport to the Undercity. Report to Broll Bearmantle when you arrive at your destination.‡Воспользуйтесь порталом в Крепости Штормграда и телепортируйтесь в Подгород. Когда прибудете на место, разыщите Бролла Медвежью Шкуру.‡Benutzt das Portal nach Unterstadt im Inneren von Burg Sturmwind, um Euch nach Unterstadt zu teleportieren. Meldet Euch bei Broll Bärenfell, wenn Ihr am Zielort angekommen seid.‡스톰윈드 왕실 안에서 언더시티로 가는 차원문을 통해 언더시티로 이동한 다음, 브롤 비어맨틀에게 보고해야 합니다.‡Utiliza el portal a Entrañas dentro del Castillo de Ventormenta para teletransportarte a Entrañas. Informa a Broll Manto de Oso cuando llegues a tu destino.‡Utiliza el portal a Entrañas dentro del Castillo de Ventormenta para teletransportarte a Entrañas. Informa a Broll Manto de Oso cuando llegues a tu destino.‡Utilisez le portail vers Fossoyeuse créé dans le donjon de Hurlevent pour vous téléporter à Fossoyeuse. Présentez-vous à Broll Mantelours lorsque vous arriverez à destination.‡使用暴风要塞内的通往幽暗城的传送门前往幽暗城。到达目的地之后，向布罗尔·熊皮报到。‡利用暴風要塞內的傳送門前往幽暗城，抵達目的地時向布洛·熊皮報到。',
  }
},
[13372] = {
  {
    'A chave da Íris Catalisadora‡Ключ к Радужному Средоточию‡Der Schlüssel der fokussierenden Iris‡집중의 눈동자 열쇠‡La llave del Iris de enfoque‡La llave del Iris de enfoque‡La clé de l\'iris de focalisation‡聚焦之虹的钥匙‡聚源虹膜之鑰',
    nil,
    'Entregue a Chave da Íris Catalisadora para Alexstrasza, a Mãe da Vida, no topo do Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Отнесите ключ от Радужного Средоточия Алекстразе Хранительнице Жизни на вершине храма Драконьего Покоя в Драконьем Погосте.‡Liefert den Schlüssel zur fokussierenden Iris bei Alexstrasza der Lebensbinderin auf der höchsten Ebene des Wyrmruhtempels in der Drachenöde ab.‡집중의 눈동자 열쇠를 고룡쉼터 사원의 꼭대기에 있는 생명의 어머니 알렉스트라자에게 가져가야 합니다.‡Entrega la llave del Iris de enfoque a Alexstrasza la Protectora en la cima del Templo del Reposo del Dragón.‡Entrega la llave del Iris de enfoque a Alexstrasza la Protectora en la cima del Templo del Reposo del Dragón.‡Livrez la Clé de l\'iris de focalisation à Alexstrasza la Lieuse-de-vie au sommet du Temple du Repos du ver, dans la Désolation des dragons.‡前往龙骨荒野的龙眠神殿，将聚焦之虹的钥匙交给阿莱克丝塔萨，生命的缚誓者。‡轉交聚源虹膜之鑰給『生命守縛者』雅立史卓莎，她就在龍骨荒野的龍眠神殿頂端。',
  }
},
[13373] = {
  {
    'Os benefícios da ciência marginal‡Последнее слово техники‡Vorzüge der Grenzwissenschaft‡괴짜 과학의 승리‡Beneficios de la ciencia adicional‡Beneficios de la ciencia adicional‡Les avantages de la science marginale‡边缘科学的益处‡激進科學的好處',
    nil,
    'A frangenheira Marginal Tezzla quer que você mate 40 Infantarias de Bombardeio, 8 Capitães de Bombardeio e 15 Gárgulas-emboscadoras.‡Уничтожьте 40 пехотинцев из зоны бомбардировки, 8 капитанов из зоны бомбардировки и 15 горгулий-душительниц по заданию инженера-экспериментатора Теззлы.‡Grenzwissenschaftsingenieurin Tezzla möchte, dass Ihr 40 Bombardementinfanteristen, 8 Bombardementhauptmänner und 15 Gargoylewegelagerer tötet.‡괴짜 기술자 테즐라가 폭격대 보병 40마리, 폭격대 부대장 8마리, 가고일 복병 15마리를 처치해 달라고 요청했습니다.‡La ingeniera adjunta Tezzla quiere que mates a 40 miembros de la infantería de bombardeo, a 8 capitanes de bombardeo y 15 emboscadores gárgolas.‡La ingeniera adjunta Tezzla quiere que mates a 40 miembros de la infantería de bombardeo, a 8 capitanes de bombardeo y 15 emboscadores gárgolas.‡L\'Ingénieur marginal Tezzla veut que vous tuiez 40 Soldats d\'infanterie du bombardement, 8 Capitaines du bombardement et 15 Gargouilles embusquées.‡边缘技师塔兹拉要你去杀死40个轰炸场步兵、80个轰炸场军官和15只石像鬼伏击者。‡偏激工程師泰茲菈要你殺掉40個轟炸地步兵、8個轟炸地隊長與15個石像鬼伏擊者。',
  }
},
[13374] = {
  {
    'Atrás das linhas inimigas‡Боевое задание‡Bereit zur Revolte!‡화끈한 게 좋아!‡¡Amperio de revolución!‡¡Amperio de revolución!‡Équipés pour la révolte !‡炸翻天！‡大反擊!',
    nil,
    'A Frangenheira Marginal Tezzla quer que você destrua Infantarias de Bombardeio, Gárgulas-emboscadoras, Sentinelas Ninhálgida e Máquinas de Guerra do Flagelo.‡Уничтожьте пехотинцев из зоны бомбардировки, боевые машины Плети, горгулий-душительниц и часовых ледяных драконов по заданию инженера-экспериментатора Теззлы.‡Grenzwissenschaftsingenieurin Tezzla möchte, dass Ihr Bombardementinfanteristen, Gargoylewegelagerer, Frostbrutspäher und Kriegsmaschinen der Geißel vernichtet.‡괴짜 기술자 테슬라가 폭격대 보병, 가고일 복병, 서리고룡족 보초병, 스컬지 전쟁 기계를 제거해 달라고 요청했습니다.‡La ingeniera adjunta Tezzla quiere que mates a miembros de la infantería de bombardeo, a emboscadores gárgolas, a centinelas Razaescarcha y máquinas de guerra de la Plaga.‡La ingeniera adjunta Tezzla quiere que mates a miembros de la infantería de bombardeo, a emboscadores gárgolas, a centinelas Razaescarcha y máquinas de guerra de la Plaga.‡L\'Ingénieur marginal Tezzla vous demande de tuer des Soldats d\'infanterie du bombardement, des Gargouilles embusquées, des Factionnaires couvegivres et des Machines de guerre du Fléau.‡边缘技师塔兹拉要你杀死轰炸场步兵、石像鬼伏击者、霜巢斥候，并摧毁天灾战车。‡偏激工程師泰茲菈要你殺掉轟炸地步兵、石像鬼伏擊者、霜育哨兵與天譴戰爭機器。',
  }
},
[13375] = {
  {
    'A chave heroica da Íris Focalizadora‡Ключ к Радужному Средоточию (героический режим)‡Der heroische Schlüssel der fokussierenden Iris‡집중의 눈동자 영웅 열쇠‡La llave heroica del Iris de enfoque‡La llave heroica del Iris de enfoque‡La clé héroïque de l\'iris de focalisation‡英雄聚焦之虹的钥匙‡聚源虹膜英雄之鑰',
    nil,
    'Entregue a Chave heroica da Íris Focalizadora para Alexstrasza, a Mãe da Vida, no topo do Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Отнесите ключ от Радужного Средоточия (героический режим) Алекстразе Хранительнице Жизни на вершине храма Драконьего Покоя в Драконьем Погосте.‡Liefert den heroischen Schlüssel zur fokussierenden Iris bei Alexstrasza der Lebensbinderin auf der höchsten Ebene des Wyrmruhtempels in der Drachenöde ab.‡집중의 눈동자 영웅 열쇠를 고룡쉼터 사원의 꼭대기에 있는 생명의 어머니 알렉스트라자에게 가져가야 합니다.‡Entrega la llave heroica del Iris de enfoque a Alexstrasza la Protectora en la cima del Templo del Reposo del Dragón.‡Entrega la llave heroica del Iris de enfoque a Alexstrasza la Protectora en la cima del Templo del Reposo del Dragón.‡Livrez la Clé héroïque de l\'iris de focalisation à Alexstrasza la Lieuse-de-vie au sommet du Temple du Repos du ver, dans la Désolation des dragons.‡前往龙骨荒野的龙眠神殿，将英雄聚焦之虹的钥匙交给阿莱克丝塔萨，生命的缚誓者。‡轉交聚源虹膜英雄之鑰給『生命守縛者』雅立史卓莎，她就在龍骨荒野的龍眠神殿頂端。',
  }
},
[13376] = {
  {
    'Resistência T-ohm-tal: o Vale das Esperanças Perdidas!‡Война продолжается‡Totale Vernichtung: Das Tal der Verlorenen Hoffnung!‡총 저항: 잃어버린 희망의 계곡!‡Resistencia total: El Valle de la Esperanza Perdida‡Resistencia total: El Valle de la Esperanza Perdida‡Ohmage total : la vallée de l\'Espoir perdu !‡长途轰炸：失落希望之谷！‡遭遇抵抗:逝望山谷!',
    nil,
    'A frangenheira Marginal Tezzla quer que você mate 50 Infantarias de Bombardeio, 20 Gárgulas-emboscadoras, 12 Sentinelas Ninhálgida e 12 Máquinas de Guerra do Flagelo.‡Уничтожьте 50 пехотинцев из зоны бомбардировки, 12 боевых машин Плети, 20 горгулий-душительниц и 12 часовых ледяных драконов по заданию инженера-экспериментатора Теззлы.‡Grenzwissenschaftsingenieurin Tezzla möchte, dass Ihr 50 Bombardementinfanteristen, 20 Gargoylewegelagerer, 12 Frostbrutspäher und 12 Kriegsmaschinen der Geißel vernichtet.‡괴짜 기술자 테즐라가 폭격대 보병 50마리, 가고일 복병 20마리, 서리고룡족 보초병 12마리, 스컬지 전쟁 기계 12개를 제거해 달라고 요청했습니다.‡La ingeniera adjunta Tezzla quiere que mates a 50 miembros de la infantería de bombardeo, a 20 emboscadores gárgolas, a 12 centinelas Razaescarcha y 12 máquinas de guerra de la Plaga.‡La ingeniera adjunta Tezzla quiere que mates a 50 miembros de la infantería de bombardeo, a 20 emboscadores gárgolas, a 12 centinelas Razaescarcha y 12 máquinas de guerra de la Plaga.‡L\'Ingénieur marginal Tezzla vous demande de tuer 50 Soldats d\'infanterie du bombardement, 20 Gargouilles embusquées, 12 Factionnaires couvegivres et 12 Machines de guerre du Fléau.‡边缘技师塔兹拉要你去杀死50个轰炸场步兵、20只石像鬼伏击者和12条霜巢斥候，并摧毁12架天灾战车。‡偏激工程師泰茲菈要你殺掉50個轟炸地步兵、20個石像鬼伏擊者、12個霜育哨兵與12部天譴戰爭機器。',
  }
},
[13377] = {
  {
    'The Battle For The Undercity‡Битва за Подгород‡Die Schlacht um Unterstadt‡언더시티 함락 작전‡La batalla por Entrañas‡La batalla por Entrañas‡La bataille pour Fossoyeuse‡幽暗城之战‡幽暗城之戰',
    nil,
    'Assist King Varian Wrynn and Lady Jaina Proudmoore in bringing Grand Apothecary Putress to justice! Report to King Varian Wrynn should you succeed.‡Помогите королю Вариану Ринну и леди Джайне Праудмур покарать верховного аптекаря Гнилесса! Если вам это удастся, явитесь к королю Вариану Ринну.‡Helft König Varian Wrynn und Lady Jaina Prachtmeer, Großapotheker Putress zur Rechenschaft zu ziehen! Meldet Euch bei König Varian Wrynn, solltet Ihr erfolgreich sein.‡국왕 바리안 린과 여군주 제이나 프라우드무어가 정의의 이름으로 대연금술사 퓨트리스를 심판하도록 도운 다음, 국왕 바리안 린에게 보고해야 합니다.‡Ayuda al rey Varian Wrynn y a Lady Jaina Valiente a traer al Gran Boticario Putress ante la justicia. Informa al rey Varian Wrynn si tienes éxito.‡Ayuda al rey Varian Wrynn y a Lady Jaina Valiente a traer al Gran Boticario Putress ante la justicia. Informa al rey Varian Wrynn si tienes éxito.‡Aidez le Roi Varian Wrynn et Dame Jaina Portvaillant à conduire le Grand apothicaire Putrescin devant la justice ! Retournez voir le Roi Varian Wrynn si vous réussissez.‡协助瓦里安·乌瑞恩国王和吉安娜·普罗德摩尔，剿灭大药剂师普特雷斯！|n|n成功之后，向瓦里安·乌瑞恩国王报告。‡協助瓦里安·烏瑞恩國王與珍娜·普勞德摩爾女士逮捕大藥劑師普崔司!成功之後向瓦里安·烏瑞恩國王回報。',
  }
},
[13378] = {
  {
    'Chief Engineer Copperclaw‡Главный инженер Меднопал‡Chefingenieur Kupferklammer‡선임기술자 코퍼클로‡Ingeniero jefe Garrabronce‡Ingeniero jefe Garrabronce‡Ingénieur en chef Cuivregrif‡首席技师考伯克拉‡首席工程師銅爪',
    nil,
    'Speak with Chief Engineer Copperclaw.‡Поговорите с главным инженером Меднопалом‡Sprecht mit Chefingenieur Kupferklammer.‡선임기술자 코퍼클로와 대화해야 합니다.‡Habla con ingeniero jefe Garrabronce‡Habla con ingeniero jefe Garrabronce.‡Parlez avec l\'Ingénieur en chef Cuivregrif.‡与首席技师考伯克拉谈谈。‡與首席工程師銅爪談話。',
  }
},
[13379] = {
  {
    'Tecnologia verde‡Зеленые технологии‡Grüne Technologie‡녹색 기술‡Tecnología verde‡Tecnología verde‡Technologie verte‡绿色科技‡綠色科技',
    nil,
    'Fale com a frangenheira Marginal Tezzla.‡Поговорите с инженером-экспериментатором Теззлой.‡Sprecht mit Grenzwissenschaftsingenieurin Tezzla.‡괴짜 기술자 테즐라와 이야기해야 합니다.‡Habla con la ingeniera adjunta Tezzla.‡Habla con la ingeniera adjunta Tezzla.‡Parlez à l\'Ingénieur marginal Tezzla.‡与边缘技师塔兹拉谈一谈。‡與偏激工程師泰茲菈談話。',
  }
},
[13380] = {
  {
    'À frente do ataque‡Возглавить нападение‡Den Angriff leiten‡나를 따르라‡Llevar la carga‡Llevar la carga‡Mener la charge‡委以重任‡率領攻擊',
    nil,
    'Kibli Kilohertz quer que você mate 40 Infantarias de Bombardeio, 8 Capitães de Bombardeio e 15 Gárgulas-emboscadoras.‡Убейте 40 пехотинцев из зоны бомбардировки, 8 капитанов из зоны бомбардировки и 15 горгулий-душительниц по заданию Кибли Киллогерца.‡Kibli Killohertz möchte, dass Ihr 40 Bombardementinfanteristen, 8 Bombardementkapitäne und 15 Gargoylewegelagerer tötet.‡키블리 킬로헤르츠가 폭격대 보병 40마리, 폭격대 부대장 8마리, 가고일 복병 15마리를 처치해 달라고 요청했습니다.‡Kibli Kilohercio quiere que mates a 40 miembros de la infantería de bombardeo, a 8 capitanes de bombardeo y a 15 emboscadores gárgolas.‡Kibli Kilohercio quiere que mates a 40 miembros de la infantería de bombardeo, a 8 capitanes de bombardeo y a 15 emboscadores gárgolas.‡Kibli Killohertz vous a demandé de tuer 40 Soldats d\'infanterie du bombardement, 8 Capitaines du bombardement et 15 Gargouilles embusquées.‡吉普利·基罗赫斯要你去杀死40个轰炸场步兵、8个轰炸场军官和15只石像鬼伏击者。‡碁伯里·基羅赫茲要你殺掉40個轟炸地步兵、8個轟炸地隊長與15個石像鬼伏擊者。',
  }
},
[13381] = {
  {
    'Guerra ao terror‡Боевой вылет‡Watt ist mein Ziel‡새로운 목표‡¿Cuál es mi objetivo?‡¿Cuál es mi objetivo?‡Une nouvelle cible‡目标是什么？‡下個目標',
    nil,
    'Kibli Kilohertz quer que você destrua Infantarias de Bombardeio, Gárgulas-emboscadoras, Sentinelas Ninhálgida e Máquinas de Guerra do Flagelo.‡Уничтожьте пехотинцев из зоны бомбардировки, боевые машины Плети, горгулий-душительниц и часовых ледяных драконов по заданию Кибли Киллогерца.‡Kibli Killohertz wünscht, dass Ihr Bombardementinfanteristen, Gargoylewegelagerer, Frostbrutspäher und Kriegsmaschinen der Geißel vernichtet.‡키블리 킬로헤르츠가 폭격대 보병, 가고일 복병, 서리고룡족 보초병, 스컬지 전쟁 기계를 처치해 달라고 부탁했습니다.‡Kibli Kilohercio quiere que mates a miembros de la infantería de bombardeo, a emboscadores gárgola, a centinelas Razaescarcha y a máquinas de guerra de la Plaga.‡Kibli Kilohercio quiere que mates a miembros de la infantería de bombardeo, a emboscadores gárgola, a centinelas Razaescarcha y a máquinas de guerra de la Plaga.‡Kibli Killohertz vous demande de tuer des Soldats d\'infanterie du bombardement, des Gargouilles embusquées, des Factionnaires couvegivres et des Machines de guerre du Fléau.‡吉普利·基罗赫斯要你杀死轰炸场步兵、石像鬼伏击者、霜巢斥候，并摧毁天灾战车。‡碁伯里·基羅赫茲要你殺掉轟炸地步兵、石像鬼伏擊者、霜育哨兵與天譴戰爭機器。',
  }
},
[13382] = {
  {
    'Ajuste de Hertz: Vale das Esperanças Perdidas‡Килотонны смерти‡Mission mit Hertz: Das Tal der Verlorenen Hoffnung‡고통을 투하하라: 잃어버린 희망의 계곡‡Poner el hercio: El Valle de la Esperanza Perdida‡Poner el hercio: El Valle de la Esperanza Perdida‡Objectif Killo : la vallée de l\'Espoir perdu‡长途轰炸：失落希望之谷‡持續轟炸:逝望山谷',
    nil,
    'Kibli Kilohertz quer que você mate 50 Infantarias de Bombardeio, 20 Gárgulas-emboscadoras, 12 Sentinelas Ninhálgida e 12 Máquinas de Guerra do Flagelo.‡Уничтожьте 50 пехотинцев из зоны бомбардировки, 12 боевых машин Плети, 20 горгулий-душительниц и 12 часовых ледяных драконов по заданию Кибли Киллогерца.‡Kibli Killohertz möchte, dass Ihr 50 Bombardementinfanteristen, 20 Gargoylewegelagerer, 12 Frostbrutspäher und 12 Kriegsmaschinen der Geißel vernichtet.‡키블리 킬로헤르츠가 폭격대 보병 50마리, 가고일 복병 20마리, 서리고룡족 보초병 12마리, 스컬지 전쟁 기계 12개를 처치해 달라고 부탁했습니다.‡Kibli Kilohercio quiere que mates a 50 miembros de la infantería de bombardeo, a 20 emboscadores gárgola, a 12 centinelas Razaescarcha y a 12 máquinas de guerra de la Plaga.‡Kibli Kilohercio quiere que mates a 50 miembros de la infantería de bombardeo, a 20 emboscadores gárgola, a 12 centinelas Razaescarcha y a 12 máquinas de guerra de la Plaga.‡Kibli Killohertz vous a demandé de tuer 50 Soldats d\'infanterie du bombardement, 20 Gargouilles embusquées, 12 Factionnaires couvegivres et 12 Machines de guerre du Fléau.‡吉普利·基罗赫斯要你去杀死50个轰炸场步兵、20只石像鬼伏击者和12条霜巢斥候，并摧毁12架天灾战车。‡碁伯里·基羅赫茲要你殺掉50個轟炸地步兵、20個石像鬼伏擊者、12個霜育哨兵與12個天譴戰爭機器。',
  }
},
[13383] = {
  {
    'Killohertz‡Киллогерц‡Killohertz‡킬로헤르츠‡Kilohercio‡Kilohercio‡Killohertz‡吉普利·基罗赫斯‡基羅赫茲',
    nil,
    'O engenheiro-chefe Pertaporca quer que você encontre Kibli Kilohertz no aeroporto secreto da Aliança, sobre Aldur\'thar: o Portão da Desolação.‡Разыщите Кибли Киллогерца на базе в скрытом аэропорту Альянса над Алдур\'таром, Вратами Горя, по приказу главного инженера Болтоключа.‡Chefingenieur Bolzenschlüssel möchte, dass Ihr zum verborgenen Allianzflugplatz über Aldur\'thar, dem Tor der Verwüstung, fliegt und Kibli Killohertz aufsucht.‡선임기술자 볼트렌치가 황폐의 관문 알두르타르 위쪽에 숨겨진 얼라이언스 비행장에서 키블리 킬로헤르츠를 찾아 달라고 부탁했습니다.‡El ingeniero jefe Aprietatuercas quiere que encuentres a Kibli Kilohercio en el aeropuerto escondido de la Alianza encima de Aldur\'thar, La Puerta de la Desolación.‡El ingeniero jefe Aprietatuercas quiere que encuentres a Kibli Kilohercio en el aeropuerto escondido de la Alianza encima de Aldur\'thar, La Puerta de la Desolación.‡L\'Ingénieur en chef Vrilleboulon vous a demandé de retrouver Kibli Killohertz à l\'Aéroport caché de l\'Alliance au-dessus d\'Aldur\'thar, la Porte de la Désolation.‡首席技师波尔维克要你前往荒凉之门奥尔杜萨上空的联盟隐形机场，并与吉普利·基罗赫斯谈一谈。‡首席工程師栓鉗要你前往「荒寂之門」奧多薩的聯盟秘密機場找到碁伯里·基羅赫茲。',
  }
},
[13384] = {
  {
    'Julgamento no Olho da Eternidade‡Правосудие в Оке Вечности‡Entscheidung im Auge der Ewigkeit‡영원의 눈에서의 심판‡Juicio en El Ojo de la Eternidad‡Juicio en El Ojo de la Eternidad‡Jugement à l\'Œil de l\'éternité‡永恒之眼的审判‡永恆之眼的審判',
    nil,
    'Krasus, no topo do Templo do Repouso das Serpes, que fica no Ermo das Serpes, quer que você leve o Coração da Magia para ele.|n|nEssa missão é para a versão do Olho da Eternidade em modo Normal para 10 pessoas.‡Принесите Сердце Магии Красу на вершине храма Драконьего Покоя в Драконьем Погосте.|n|nЭто задание предназначено для обычного уровня сложности и представляет собой версию Ока Вечности для 10 игроков.‡Krasus auf der Spitze des Wyrmruhtempels in der Drachenöde möchte, dass Ihr mit dem Herzen der Magie zurückkehrt.|n|nDiese Quest ist für den normalen Modus, also für die 10-Mann-Version des Auges der Ewigkeit, gedacht.‡용의 안식처에서 고룡심터 사원의 꼭대기에 있는 크라서스가 마법의 심장을 가져와 달라고 부탁했습니다.|n|n이 퀘스트는 영원의 눈 10인 설정인 일반 모드로 설정한 후 진행해야 합니다.‡Krasus, en la cima del Templo del Reposo del Dragón en el Cementerio de Dragones, quiere que vuelvas con el Corazón de magia.|n|nEsta misión es la versión para el modo dificultad normal para 10 personas de El Ojo de la Eternidad.‡Krasus, en la cima del Templo del Reposo del Dragón en el Cementerio de Dragones, quiere que vuelvas con el Corazón de magia.|n|nEsta misión es la versión para el modo dificultad normal para 10 personas de El Ojo de la Eternidad.‡Krasus, au sommet du Temple du Repos du ver, vous a demandé de lui rapporter le Cœur de la magie.|n|nCette quête s\'effectue dans l\'Œil de l\'éternité en mode normal, pour 10 joueurs.‡龙骨荒野龙眠神殿的克拉苏斯要你取回魔法之心。|n|n该任务必须在普通模式下的10人永恒之眼中完成。‡卡薩斯，位於龍骨荒野的龍眠神殿頂端，要你帶著魔法之心回去。|n|n這個任務適用普通難度、10人的永恆之眼副本。',
  }
},
[13385] = {
  {
    'Julgamento heroico no Olho da Eternidade‡Героическое правосудие в Оке Вечности‡Heroische Entscheidung im Auge der Ewigkeit‡영원의 눈에서의 영웅적 심판‡Heroico: Juicio en El Ojo de la Eternidad‡Heroico: Juicio en El Ojo de la Eternidad‡Jugement héroïque à l\'Œil de l\'éternité‡英雄永恒之眼的审判‡永恆之眼的英雄審判',
    nil,
    'Krasus, no topo do Templo do Repouso das Serpes, que fica no Ermo das Serpes, quer que você leve o Coração da Magia para ele.|n|nEssa missão é para a versão do Olho da Eternidade em modo Heroico para 25 pessoas.‡Принесите Сердце Магии Красу на вершине храма Драконьего Покоя в Драконьем Погосте.|n|nЭто задание предназначено для героического уровня сложности и представляет собой версию Ока Вечности для 25 игроков.‡Krasus auf der Spitze des Wyrmruhtempels in der Drachenöde möchte, dass Ihr mit dem Herzen der Magie zurückkehrt.|n|nDiese Quest ist für den heroischen Modus, also für die 25-Mann-Version des Auges der Ewigkeit, gedacht.‡용의 안식처에서 고룡심터 사원의 꼭대기에 있는 크라서스가 마법의 심장을 가져와 달라고 부탁했습니다.|n|n이 퀘스트는 영원의 눈 25인 설정인 영웅 모드로 설정한 후 진행해야 합니다.‡Krasus, en la cima del Templo del Reposo del Dragón en el Cementerio de Dragones, quiere que vuelvas con el Corazón de magia.|n|nEsta misión es el modo dificultad heroico para 25 personas de El Ojo de la Eternidad.‡Krasus, en la cima del Templo del Reposo del Dragón en el Cementerio de Dragones, quiere que vuelvas con el Corazón de magia.|n|nEsta misión es el modo dificultad heroico para 25 personas de El Ojo de la Eternidad.‡Krasus, au sommet du Temple du Repos du ver, vous a demandé de lui rapporter le Cœur de la magie.|n|nCette quête s\'effectue dans l\'Œil de l\'éternité en mode héroïque, pour 25 joueurs.‡龙骨荒野龙眠神殿的克拉苏斯要你取回魔法之心。|n|n该任务必须在英雄模式下的25人永恒之眼中完成。‡卡薩斯，位於龍骨荒野的龍眠神殿頂端，要你帶著魔法之心回去。|n|n這個任務適用英雄難度、25人的永恆之眼副本。',
  }
},
[13386] = {
  {
    'Uma brecha na defesa‡Разведка провала‡Ausnutzen einer Öffnung‡구멍 탐험‡Explotar una entrada‡Explotar una entrada‡Exploiter une ouverture‡缺口‡趁隙突破',
    nil,
    'Fale com o capitão Kendall abaixo da Cidadela da Coroa de Gelo.‡Поговорите с капитаном Кендаллом под цитаделью Ледяной Короны.‡Redet mit Hauptmann Kendall unterhalb der Eiskronenzitadelle.‡얼음왕관 성채 아래의 부대장 켄달과 대화해야 합니다.‡Habla con el capitán Kendall bajo la Ciudadela de la Corona de Hielo.‡Habla con el capitán Kendall bajo la Ciudadela de la Corona de Hielo.‡Parlez au Capitaine Kendall sous la Citadelle de la Couronne de glace.‡与冰冠堡垒下面的肯达尔上尉谈一谈。‡與冰冠城塞底下的坎達爾上尉交談。',
  }
},
[13387] = {
  {
    'A defesa do perímetro‡Круговая оборона‡Sicherung des Gebiets‡경계선 확보‡Asegurar el perímetro‡Asegurar el perímetro‡Sécuriser le périmètre‡保护现场‡確保周邊陣地',
    nil,
    'O Capitão Kendall, na Cidadela da Coroa de Gelo, quer que você mate 10 Terrores Brutos.‡Капитан Кендалл у цитадели Ледяной Короны просит вас убить 10 неповоротливых громад.‡Kapitän Kendall bei der Eiskronenzitadelle möchte, dass Ihr 10 bullige Schrecken tötet.‡얼음왕관 성채의 부대장 켄달이 덩치 큰 역병괴물 10마리를 처치해 달라고 부탁했습니다.‡El capitán Kendall en la Ciudadela de la Corona de Hielo quiere que mates a 10 horrores descomunales.‡El capitán Kendall en la Ciudadela de la Corona de Hielo quiere que mates a 10 horrores descomunales.‡Le Capitaine Kendall, à la Citadelle de la Couronne de glace, vous demande de tuer 10 Horreurs massives.‡冰冠堡垒的肯达尔上尉要你去杀死10只笨重的恐尸。‡冰冠城塞的坎達爾上尉要你殺死10個笨重的恐獸。',
  }
},
[13388] = {
  {
    'Manda ver!‡Поджигай!‡Lasst sie hochgehen!‡발사!‡¡Hazlo explotar!‡¡Hazlo explotar!‡C\'est de la bombe !‡引爆！‡引爆!',
    nil,
    'O Capitão Kendall, abaixo da Cidadela da Coroa de Gelo, quer que você acenda o pavio da Pilha de Bombas de Saronita.‡Капитан Кендалл под стенами цитадели Ледяной Короны просит вас отправиться к ближайшему штабелю саронитовых бомб и поджечь фитиль.‡Hauptmann Kendall unterhalb der Eiskronenzitadelle möchte, dass Ihr die Lunte an dem nahegelegenen Saronitbombenstapel anzündet.‡얼음왕관 성채 아래의 부대장 켄달이 근처에 있는 사로나이트 폭탄 더미의 도화선에 불을 붙여 달라고 부탁했습니다.‡El capitán Kendall debajo de la Ciudadela de la Corona de Hielo quiere que te acerques al montón de bombas de saronita para encender la mecha.‡El capitán Kendall debajo de la Ciudadela de la Corona de Hielo quiere que te acerques al montón de bombas de saronita para encender la mecha.‡Le Capitaine Kendall, sous la Citadelle de la Couronne de Glace, veut que vous alliez près de la Pile de bombes en saronite pour allumer la mèche.‡冰冠堡垒下面的肯达尔上尉要你前往附近的萨隆邪铁炸弹堆旁边，点燃引线。‡冰冠城塞底下的坎達爾上尉要你去附近的薩鋼炸彈堆點燃引信。',
  }
},
[13389] = {
  {
    'Pavio curto‡Фитиль короток!‡Eine kurze Lunte‡짧은 도화선‡Una mecha corta‡Una mecha corta‡Une mèche courte‡引线太短‡一觸即發',
    nil,
    'Quando chegar ao fundo, investigue o lugar, onde quer que seja.‡Там, куда вы падаете, вас ждет кое-что интересное!‡Haltet nach Hinweisen Ausschau, wo auch immer der Sturz Euch hinführt.‡추락한 곳에서 단서를 찾아야 합니다.‡Busca pistas allá donde caigas.‡Busca pistas allá donde caigas.‡Cherchez des indices à l\'endroit où vous serez tombé.‡在你被杂物砸中的地方寻找线索。‡找出你到底掉到了什麼地方。',
  }
},
[13390] = {
  {
    '‡Голос во тьме‡Eine Stimme im Dunklen‡어둠 속의 목소리‡Una voz en la oscuridad‡Una voz en la oscuridad‡Une voix dans l\'obscurité‡黑暗中的声音‡',
    nil,
    '‡Выясните, откуда доносится голос, который вы услышали в Наз\'анаке, Забытых глубинах.‡Untersucht die nahe Stimme in Naz\'anak, den Vergessenen Tiefen.‡망각의 심연 나즈아낙에서 가까이 들리는 목소리를 조사해야 합니다.‡Examina la voz que se oye cerca de ti, en Las Profundidades Olvidadas de Naz\'anak.‡Examina la voz que se oye cerca de ti, en Las Profundidades Olvidadas de Naz\'anak.‡Enquêtez sur la voix toute proche à Naz\'anak, les Profondeurs oubliées.‡在纳扎纳克：遗忘深渊里调查这个声音的来源。‡',
  }
},
[13391] = {
  {
    '‡Пора прятаться!‡Zeit zum Verstecken‡숨을 시간‡Hora de esconderse‡Hora de esconderse‡C\'est le moment de se cacher‡藏匿行踪‡',
    nil,
    '‡Добудьте 3 образца крови безликих по совету Матиаса Нетлера.‡Matthias Lehner möchte, dass Ihr ihm 3 Proben Blut des Gesichtslosen bringt.‡마시어스 레넷이 얼음왕관 성채에서 얼굴 없는 자의 피 3개를 구해 오라고 했습니다.‡Matthias Lehner quiere que consigas 3 muestras de sangre del ignoto.‡Matthias Lehner quiere que consigas 3 muestras de sangre del ignoto.‡Matthias Lehner vous a demandé d\'obtenir 3 doses de Sang de Sans-visage.‡米斯希尔萨·阿奈尔要你收集3份无面者之血。‡',
  }
},
[13392] = {
  {
    '‡Возвращение на поверхность‡Rückkehr an die Oberfläche‡지상으로 돌아가기‡Regresa a la superficie‡Regresa a la superficie‡Retour vers la surface‡返回地面‡重返地表',
    nil,
    '‡Вернитесь к Тассариану на борт "Усмирителя небес".‡Kehrt zu Thassarian an Bord der Himmelsbrecher zurück.‡‡Vuelve con Thassarian a bordo de El Rompecielos.‡Vuelve con Thassarian a bordo de El Rompecielos.‡Retournez voir Thassarian à bord du Brise-ciel.‡返回破天号，向萨萨里安复命。‡',
  }
},
[13393] = {
  {
    '‡Ремонт в полевых условиях‡Feldreparaturen‡현장 수리‡Arreglos de campo‡Arreglos de campo‡Des réparations de fortune‡战地维修‡',
    nil,
    '‡Отберите у упырей-мародеров 5 деталей разрушителя и отнесите их к сломанной катапульте в долине Потерянной Надежды по просьбе Тассариана на борту "Усмирителя небес".‡Thassarian an Bord der Himmelsbrecher möchte, dass Ihr 5 Verwüsterersatzteile von den aasfressenden Spuken sammelt und sie zu dem defekten Verwüster im Tal der Verlorenen Hoffnung bringt.‡하늘파괴자호의 타사리안이 잃어버린 희망의 계곡에 있는 청소부 외눈깨비로부터 파괴전차 부품 5개를 모아 부서진 파괴전차에 사용해 달라고 했습니다.‡Thassarian a bordo de El Rompecielos quiere que recojas 5 piezas de demoledor de los geists carroñeros y que las lleves al demoledor destrozado en El Valle de la Esperanza Perdida.‡Thassarian a bordo de El Rompecielos quiere que recojas 5 piezas de demoledor de los geists carroñeros y que las lleves al demoledor destrozado en El Valle de la Esperanza Perdida.‡Thassarian, à bord du Brise-ciel, veut que vous récupériez 5 Pièces détachées de démolisseur sur les Geists charognards et que vous les apportiez à l\'Epave de démolisseur dans la Vallée de l\'Espoir perdu.‡破天号上的萨萨里安要你从食腐的恶鬼身上收集5块攻城车零件，然后将它们带去失落希望之谷的损毁的攻城车旁。‡',
  }
},
[13394] = {
  {
    '‡Все к худшему‡Tut Euer Schlechtestes‡소용없는 일‡Haz lo peor‡Haz lo peor‡Faites de votre pire‡竭尽全力‡別太認真',
    nil,
    '‡Используйте отремонтированный разрушитель, чтобы уничтожить 150 изгнивших вурдалаков, 20 ледотленных волхвов и 2 костяных великана в долине Потерянной Надежды. Выполнив эту задачу, поговорите с Матиасом Нетлером в лагере сопротивления первого легиона.‡Zerstört mithilfe des Runderneuerten Verwüsters 150 verrottete Ghule, 20 Frostschädelmagier und 2 Knochenriesen im Tal der Verlorenen Hoffnung. Sprecht mit Matthias Lehner im Vorhutslager der Ersten Legion, wenn Ihr die Aufgabe abgeschlossen habt.‡잃어버린 희망의 계곡에서 수리한 파괴전차를 사용하여 썩은 구울 150마리, 얼음해골 마술사 20마리, 해골 거인 2마리를 해치운 다음 1군단 전진기지에 있는 마시어스 레넷과 대화해야 합니다.‡Usa el demoledor reformado para acabar con 150 necrófagos descompuestos, 20 magos Craneoescarcha y 2 gigantes osarios en El Valle de la Esperanza Perdida. Habla con Matthias Lehner en el Puesto de Avanzada de la Primera Legión cuando hayas terminado.‡Usa el demoledor reformado para acabar con 150 necrófagos descompuestos, 20 magos Craneoescarcha y 2 gigantes osarios en El Valle de la Esperanza Perdida. Habla con Matthias Lehner en el Puesto de Avanzada de la Primera Legión cuando hayas terminado.‡Utilisez le Démolisseur remis à neuf pour détruire 150 Goules décomposées, 20 Magi crânegivre et 2 Géants d\'os dans la Vallée de l\'Espoir perdu. Parlez à Matthias Lehner au Camp avancé de la Première légion une fois la tâche accomplie.‡使用整修过的攻城车，在失落希望之谷里消灭150只腐朽的食尸鬼、20个霜颅大法师和2个白骨巨人。完成任务之后前往第一军团前线营地，与米斯希尔萨·阿奈尔谈一谈。‡',
  }
},
[13395] = {
  {
    '‡Войско проклятых‡Armee der Verdammten‡저주받은 자들의 군대‡El ejército de los malditos‡El ejército de los malditos‡L\'armée des damnés‡召唤大军‡詛咒軍團',
    nil,
    '‡Оживите 100 вурдалаков-прислужников по просьбе Матиаса Нетлера в лагере сопротивления первого легиона.‡Matthias Lehner beim Vorhutslager der Ersten Legion möchte, dass Ihr eine Armee von 100 ghulischen Dienern aufstellt.‡1군단 전진기지에 있는 마시어스 레넷이 100마리의 구울 하수인 부대를 되살려 달라고 했습니다.‡Matthias Lehner en el Puesto de Avanzada de la Primera Legión quiere que alces un ejército de 100 esbirros necrófagos.‡Matthias Lehner en el Puesto de Avanzada de la Primera Legión quiere que alces un ejército de 100 esbirros necrófagos.‡Matthias Lehner, au Camp avancé de la Première légion, vous a demandé de lever une armée de 100 Séides macabres.‡第一军团前线营地的米斯希尔萨·阿奈尔要在幻境中向你演示巫妖王如何召唤一支由101个食尸鬼奴仆组成的部队。‡',
  }
},
[13396] = {
  {
    '‡Тщета‡Sinnlosigkeit‡‡Inutilidad‡Inutilidad‡Futilité‡徒劳‡',
    nil,
    '‡Вернитесь к Тассариану на борт "Усмирителя небес".‡Kehrt zu Thassarian an Bord der Himmelsbrecher zurück.‡‡Vuelve con Thassarian a bordo de El Rompecielos.‡Vuelve con Thassarian a bordo de El Rompecielos.‡Retournez voir Thassarian à bord du Brise-ciel.‡返回破天号，向萨萨里安复命。‡',
  }
},
[13397] = {
  {
    '‡Каньон Гибели Синдрагосы‡Sindragosas Sturz‡신드라고사의 추락지‡La Caída de Sindragosa‡La Caída de Sindragosa‡La chute de Sindragosa‡辛达苟萨之墓‡辛德拉苟莎之殞',
    nil,
    '‡Убейте 5 воскресителей драконов, 8 сектантов-осквернителей и 3 врайкулов-некролордов в Каньоне Гибели Синдрагосы по приказу Тассариана с "Усмирителя небес".‡Thassarian an Bord Himmelsbrecher möchte, dass Ihr 5 Wyrmwiedererwecker, 8 Verderber der Kultisten und 3 Nekrolords der Vrykul in Sindragosas Sturz tötet.‡하늘파괴자호의 타사리안이 신드라고사의 추락지에서 고룡 생환술사 5마리, 이교도 타락자 8마리, 브리쿨 강령군주 3마리를 처치해 달라고 했습니다.‡Thassarian a bordo de El Rompecielos quiere que mates a 5 reanimadores de vermis, 8 corruptores cultores y 3 necroseñores vrykuls en La Caída de Sindragosa.‡Thassarian a bordo de El Rompecielos quiere que mates a 5 reanimadores de vermis, 8 corruptores cultores y 3 necroseñores vrykuls en La Caída de Sindragosa.‡Thassarian, à bord du Brise-ciel, vous demande de tuer 5 Réanimateurs de wyrm, 8 Sectateurs corrupteurs et 3 Nécro-seigneurs vrykuls à la Chute de Sindragosa.‡破天号上的萨萨里安要你前往辛达苟萨之墓，杀死5个巨龙复活者、8个诅咒教派腐蚀者和3个维库通灵领主。‡',
  }
},
[13398] = {
  {
    '‡Место гибели драконов‡Wo Drachen einst fielen‡용의 무덤‡Donde perecieron los dragones‡Donde perecieron los dragones‡Où les dragons tombent‡巨龙的墓地‡龍殞之地',
    nil,
    '‡Добудьте в Каньоне Гибели Синдрагосы 6 горстей пыли из костей дракончиков по приказу Матиаса Нетлера.‡Matthias Lehner in Sindragosas Sturz möchte, dass Ihr 6 Einheiten Welpenknochenstaub besorgt.‡신드라고사의 추락지에 있는 마시어스 레넷이 새끼용 뼛가루 6개를 가져다 달라고 했습니다.‡Matthias Lehner en La Caída de Sindragosa quiere que consigas 6 polvos de huesos de cría.‡Matthias Lehner en La Caída de Sindragosa quiere que consigas 6 polvos de huesos de cría.‡Matthias Lehner, à la chute de Sindragosa, vous a demandé de récupérer 6 Poussières d\'os de dragonnet.‡辛达苟萨之墓的米斯希尔萨·阿奈尔要你收集6份雏龙的骨灰。‡',
  }
},
[13399] = {
  {
    '‡Время ответов‡Zeit für Antworten‡응답할 시간‡El momento de respuestas‡El momento de respuestas‡L\'heure des réponses‡寻求答案‡揭曉之時',
    nil,
    '‡Поговорите с Матиасом Нетлером во Дворе Костей.‡Sprecht mit Matthias Lehner im Hof der Knochen.‡뼈의 궁정에 있는 마시어스 레넷과 대화해야 합니다.‡Habla con Matthias Lehner en El Patio de los Huesos.‡Habla con Matthias Lehner en El Patio de los Huesos.‡Parlez à Matthias Lehner à la Cour des Ossements.‡前往白骨之庭，与米斯希尔萨·阿奈尔谈一谈。‡',
  }
},
[13400] = {
  {
    '‡Охотник и принц‡Der Jäger und der Prinz‡사냥꾼과 왕자‡El cazador y el príncipe‡El cazador y el príncipe‡Le chasseur et le prince‡猎人与王子‡王子與獵手',
    nil,
    '‡Матиас Нетлер со Двора Костей хочет, чтобы вы нашли Окровавленный камень и увидели, что случилось с принцем.‡Matthias Lehner im Hof der Knochen möchte, dass Ihr nach einem blutbefleckten Stein sucht und das Schicksal des Prinzen zu Ende bringt.‡뼈의 궁정에 있는 마시어스 레넷이 피로 물든 돌을 찾아 왕자의 운명을 완성해 달라고 했습니다.‡Matthias Lehner en El Patio de los Huesos quiere que busques una roca manchada de sangre y completes el destino del príncipe.‡Matthias Lehner en El Patio de los Huesos quiere que busques una roca manchada de sangre y completes el destino del príncipe.‡Matthias Lehner, à la Cour des Ossements, veut que vous cherchiez une Pierre tachée de sang et que vous accomplissiez le Destin du prince.‡白骨之庭的米斯希尔萨·阿奈尔要你去寻找一块染血的石头，并目睹王子的命运。‡',
  }
},
[13401] = {
  {
    '‡Знание – тяжкая ноша‡Wissen ist eine schreckliche Bürde‡아는 것이 병‡El saber es una carga terrible‡El saber es una carga terrible‡La connaissance est un lourd fardeau‡知识是可怕的负担‡最沉重的負荷',
    nil,
    '‡Вернитесь к Тассариану на борт "Усмирителя небес".‡Meldet Euch bei Thassarian an Bord der Himmelsbrecher.‡하늘파괴자호에 있는 타사리안에게 돌아가 보고해야 합니다.‡Informa otra vez a Thassarian a bordo de El Rompecielos.‡Informa otra vez a Thassarian a bordo de El Rompecielos.‡Retournez voir Thassarian à bord du Brise-ciel.‡向破天号上的萨萨里安复命。‡',
  }
},
[13402] = {
  {
    '‡Помощь Тириона‡Tirions Hilfe‡티리온의 도움‡La ayuda de Tirion‡La ayuda de Tirion‡L\'aide de Tirion‡提里奥的帮助‡提里奧的協助',
    nil,
    '‡Поговорите с верховным лордом Тирионом Фордрингом на Вершине Рыцарей.‡Sprecht mit Hochlord Tirion Fordring auf dem Kreuzfahrerturm.‡십자군 봉우리에 있는 대영주 티리온 폴드링과 대화해야 합니다.‡Habla con el alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Habla con el alto señor Tirion Vadín en el Pináculo de los Cruzados.‡Parlez au Généralissime Tirion Fordring à la Cime des Croisés.‡与北伐军之峰的大领主提里奥·弗丁谈一谈。‡',
  }
},
[13403] = {
  {
    '‡Уловка Тириона‡Tirions Schachzug‡티리온의 계략‡Gambito de Tirion‡Gambito de Tirion‡Le gambit de Tirion‡提里奥的尝试‡提里奧的決斷',
    nil,
    '‡Тирион Фордринг с Вершины Рыцарей хочет, чтобы вы достали и надели капюшон сектанта-послушника, а затем встретились с ним у входа в Собор Тьмы, к северо-западу от цитадели Ледяной Короны.‡Tirion Fordring auf dem Kreuzfahrerturm möchte, dass Ihr die Kultistenkapuze besorgt, diese anzieht und Euch mit ihm am Eingang zur Kathedrale der Dunkelheit nordwestlich der Eiskronenzitadelle trefft.‡십자군 봉우리에 있는 티리온 폴드링이 이교도 수행사제 두건을 구해 쓴 다음 얼음왕관 성채의 북서쪽에 있는 어둠의 대성당으로 와달라고 했습니다.‡Tirion Vadín en el Pináculo de los Cruzados quiere que consigas y te pongas una caperuza de acólito cultor y que quedéis en la entrada de la Catedral de la Oscuridad, al noroeste de Ciudadela de la Corona de Hielo.‡Tirion Vadín en el Pináculo de los Cruzados quiere que consigas y te pongas una caperuza de acólito cultor y que quedéis en la entrada de la Catedral de la Oscuridad, al noroeste de Ciudadela de la Corona de Hielo.‡Tirion Fordring, à la Cime des Croisés, vous demande de trouver et de porter un Chaperon d\'acolyte du culte, puis de le rejoindre à l\'entrée de la Cathédrale des ténèbres, au nord-ouest de la Citadelle de la Couronne de glace.‡北伐军之峰的提里奥·弗丁要你想办法获取一件诅咒教徒的兜帽，穿上它，然后前往冰冠堡垒西北方的黑暗大教堂入口处与他汇合。‡',
  }
},
[13404] = {
  {
    'Tropas de Choque Estáticas: o Bombardeio‡Войска статического разряда: Зона бомбардировки‡Statische Schocktruppen: das Bombardement‡돌격대: 폭격‡Tropas de choque estático: el Bombardeo‡Tropas de choque estático: el Bombardeo‡Troupe de choc statique : le Bombardement‡短程行动：轰炸场‡靜電震擊小組:轟炸地',
    nil,
    'Kibli Kilohertz quer que você mate 50 Infantarias de Bombardeio, 10 Capitães de Bombardeio e 20 Gárgulas-emboscadoras.‡Убейте 50 пехотинцев из зоны бомбардировки, 10 капитанов из зоны бомбардировки и 20 горгулий-душительниц по заданию Кибли Киллогерца.‡Kibli Killohertz möchte, dass Ihr 50 Bombardementinfanteristen, 10 Bombardementkapitäne und 20 Gargoylewegelagerer tötet.‡키블리 킬로헤르츠가 폭격대 보병 50마리, 폭격대 부대장 10마리, 가고일 복병 20마리를 처치해 달라고 부탁했습니다.‡Kibli Kilohercio quiere que mates a 50 miembros de la infantería de bombardeo, a 10 capitanes de bombardeo y a 20 emboscadores gárgolas.‡Kibli Kilohercio quiere que mates a 50 miembros de la infantería de bombardeo, a 10 capitanes de bombardeo y a 20 emboscadores gárgolas.‡Kibli Killohertz vous a demandé de tuer 50 Soldats d\'infanterie du bombardement, 10 Capitaines du bombardement et 20 Gargouilles embusquées.‡吉普利·基罗赫斯要你去杀死50个轰炸场步兵、10个轰炸场军官和20只石像鬼伏击者。‡碁伯里·基羅赫茲要你殺掉50個轟炸地步兵、10個轟炸地隊長與20個石像鬼伏擊者。',
  }
},
[13405] = {
  {
    'Chamado às armas: Baía dos Ancestrais‡К оружию! Берег Древних‡Ruf zu den Waffen: Strand der Uralten‡전장으로: 고대의 해안‡Llamamiento a las armas: Playa de los Ancestros‡Llamamiento a las armas: Playa de los Ancestros‡Appel aux armes : rivage des Anciens‡战斗的召唤：远古海滩‡戰鬥的號角:遠祖灘頭',
    nil,
    'Vença uma partida no campo de batalha da Baía dos Ancestrais e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Выиграйте битву на поле боя Берега Древних и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht auf dem Strand der Uralten und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡고대의 해안 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 돌아가야 합니다.‡Gana un encuentro en el campo de batalla de la Playa de los Ancestros y vuelve a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Playa de los Ancestros y vuelve a un general de brigada de la Alianza en cualquier capital de la Alianza, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille sur le Rivage des Anciens, puis présentez-vous à un Général de brigade de l\'Alliance, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de l\'Alliance.‡在远古海滩战场中获得一场胜利，然后向任意联盟主城、冬拥湖、达拉然或沙塔斯城中的联盟准将复命。‡在遠祖灘頭的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、達拉然或撒塔斯的聯盟准將回報。',
  }
},
[13406] = {
  {
    'Pilotando o comprimento de onda: O Bombardeio‡Новое излучение. Зона бомбардировки‡Auf derselben Wellenlänge: Das Bombardement‡녹색 파장을 타고: 폭격지‡En la cresta de la onda: el Bombardeo‡En la cresta de la onda: el Bombardeo‡Profiter de l\'onde : le Bombardement‡短程行动：轰炸场‡乘著綠光前進:轟炸地',
    nil,
    'A frangenheira Marginal Tezzla quer que você mate 50 Infantarias de Bombardeio, 10 Capitães de Bombardeio e 20 Gárgulas-emboscadoras.‡Уничтожьте 50 пехотинцев из зоны бомбардировки, 10 капитанов из зоны бомбардировки и 20 горгулий-душительниц по заданию инженера-экспериментатора Теззлы.‡Grenzwissenschaftsingenieurin Tezzla möchte, dass Ihr 50 Bombardementinfanteristen, 10 Bombardementhauptmänner und 20 Gargoylewegelagerer tötet.‡괴짜 기술자 테즐라가 폭격대 보병 50마리, 폭격대 부대장 10마리, 가고일 복병 20마리를 처치해 달라고 부탁했습니다.‡La ingeniera adjunta Tezzla quiere que mates a 50 miembros de la infantería de bombardeo, a 10 capitanes de bombardeo y 20 emboscadores gárgolas.‡La ingeniera adjunta Tezzla quiere que mates a 50 miembros de la infantería de bombardeo, a 10 capitanes de bombardeo y 20 emboscadores gárgolas.‡L\'Ingénieur marginal Tezzla vous a demandé de bombarder 50 Soldats d\'infanterie du bombardement, 10 Capitaines du bombardement et 20 Gargouilles embusquées.‡边缘技师塔兹拉要你去杀死50个轰炸场步兵、10个轰炸场军官和20只石像鬼伏击者。‡偏激工程師泰茲菈要你殺掉50個轟炸地步兵、10個轟炸地隊長與20個石像鬼伏擊者。',
  }
},
[13407] = {
  {
    'Chamado às armas: Baía dos Ancestrais‡К оружию! Берег Древних‡Ruf zu den Waffen: Strand der Uralten‡전장으로: 고대의 해안‡Llamamiento a las armas: Playa de los Ancestros‡Llamamiento a las armas: Playa de los Ancestros‡Appel aux armes : rivage des Anciens‡战斗的召唤：远古海滩‡戰鬥的號角:遠祖灘頭',
    nil,
    'Vença uma partida no campo de batalha da Baía dos Ancestrais e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Выиграйте битву на поле боя Берега Древних и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht auf dem Strand der Uralten und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, in Tausendwinter, Dalaran oder Shattrath.‡고대의 해안 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 돌격대장에게 돌아가야 합니다.‡Gana un encuentro en el campo de batalla de la Playa de los Ancestros y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Gana un encuentro en el campo de batalla de la Playa de los Ancestros y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, Conquista del Invierno, Dalaran o Shattrath.‡Remportez la bataille sur le Rivage des Anciens, puis présentez-vous à un Porteguerre de la Horde, à Joug-d\'hiver, à Dalaran, à Shattrath ou dans l\'une des capitales de la Horde.‡在远古海滩战场中获得一场胜利，然后向任意部落主城、冬拥湖、达拉然或沙塔斯城中的部落战争使者复命。‡在遠祖灘頭的戰場中獲勝，然後向任何一座部落主城、冬握湖、達拉然或撒塔斯的部落戰爭使者回報。',
  }
},
[13408] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 성채‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Primeiro-sargento Theresa Pardim na Península do Fogo do Inferno.‡Захватите Дозорное укрепление, Ристалище и Изрезанный холм, и возвращайтесь к прапорщику Трейси Праудвелл в Оплот Чести на Полуострове Адского Пламени.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Stabsfeldwebel Tracy Stolzbrunn in der Ehrenfeste auf der Höllenfeuerhalbinsel zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 지옥불 반도의 명예의 요새에 있는 준위 트레이시 프라우드웰에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir l\'adjudante Tracy Fièrepuits au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上荣耀堡内的委任官翠希·普罗维尔复命。‡奪下望海崖、競技場、和破碎之丘，然後向地獄火半島上榮譽堡裡的士官長崔西·波特威歐回報。',
  }
},
[13409] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 요새‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Arauto de Batalha Olhonegro em Thrallmar.‡Захватите Дозорное укрепление, Ристалище и Изрезанный холм, и возвращайтесь в Траллмар к Черноглазке Зову Войны.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Kriegsherold Blauauge in Thrallmar zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 스랄마에 있는 전투장교 블랙아이에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir le Crieur-de-guerre Coquard à Thrallmar.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上萨尔玛的传令官布莱肯·黑眼复命。‡奪下望海崖、競技場、和破碎之丘，然後向索爾瑪的戰場咆嘯者黑眼回報。',
  }
},
[13410] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 성채‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Primeiro-sargento Theresa Pardim na Península do Fogo do Inferno.‡Захватите Дозорное укрепление, Ристалище и Изрезанный холм, и возвращайтесь к прапорщику Трейси Праудвелл в Оплот Чести на Полуострове Адского Пламени.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Stabsfeldwebel Tracy Stolzbrunn in der Ehrenfeste auf der Höllenfeuerhalbinsel zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 지옥불 반도의 명예의 요새에 있는 준위 트레이시 프라우드웰에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa a la suboficial Tracy Pozobravo en el Bastión del Honor, en la Península del Fuego Infernal.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir l\'adjudante Tracy Fièrepuits au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上荣耀堡内的委任官翠希·普罗维尔复命。‡奪下望海崖、競技場、和破碎之丘，然後向地獄火半島上榮譽堡裡的士官長崔西·波特威歐回報。',
  }
},
[13411] = {
  {
    'As fortificações da cidadela‡Штурмовые укрепления‡Höllenfeuerbefestigungen‡지옥불 반도의 요새‡Fortificaciones del Fuego Infernal‡Fortificaciones del Fuego Infernal‡Les fortifications des Flammes infernales‡地狱火半岛的工事‡地獄火防禦堡壘',
    nil,
    'Capture o Mirante, o Estádio e o Monte Partido, e então fale novamente com a Arauto de Batalha Olhonegro em Thrallmar.‡Захватите Дозорное укрепление, Ристалище и Изрезанный холм, и возвращайтесь в Траллмар к Черноглазке Зову Войны.‡Nehmt den Rundblick, das Stadion und die Trümmerbastion ein, und kehrt dann zu Kriegsherold Blauauge in Thrallmar zurück.‡전망대, 경기장, 무너진 언덕을 점령한 후 스랄마에 있는 전투장교 블랙아이에게 돌아가야 합니다.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Captura La Dominancia, El Estadium y Cerro Tábido e informa al Gritabatalla Ojonegro en Thrallmar.‡Prendre le Surplomb, le Stade et la Colline brisée, puis retourner voir le Crieur-de-guerre Coquard à Thrallmar.‡占领瞭望台、竞赛场和碎石岭，然后向地狱火半岛上萨尔玛的传令官布莱肯·黑眼复命。‡奪下望海崖、競技場、和破碎之丘，然後向索爾瑪的戰場咆嘯者黑眼回報。',
  }
},
[13412] = {
  {
    'Corastrasza‡Корастраза‡Corastrasza‡코라스트라자‡Corastrasza‡Corastrasza‡Corastrasza‡科拉丝塔萨‡寇菈史卓莎',
    nil,
    'A Bibliotecária Serrah quer que você fale com Corastrasza, em Gelarra.‡Поговорите с Корастразой в Хладарре по просьбе библиотекаря Серры.‡Bibliothekarin Serrah möchte, dass Ihr mit Corastrasza in Kaltarra sprecht.‡사서 세라가 콜다라에 있는 코라스트라자와 대화해 달라고 부탁했습니다.‡La bibliotecaria Serrah quiere que hables con Corastrasza en Gelidar.‡La bibliotecaria Serrah quiere que hables con Corastrasza en Gelidar.‡La Bibliothécaire Serrah veut que vous parliez à Corastrasza à Frimarra.‡图书馆员塞尔拉要你去跟考达拉的科拉斯塔萨谈一谈。‡圖書管理員瑟菈要你和凜懼島的寇菈史卓莎談談。',
  }
},
[13413] = {
  {
    'Ases indomáveis!‡Асы, ввысь!‡Schlacht in den Wolken‡하늘의 용사‡Ases del aire‡Ases del aire‡Un as dans notre jeu !‡展翅高飞！‡振翼高飛!',
    nil,
    'Corastrasza, nos círculos mais altos do Nexus em Gelarra, quer que você cavalgue um de seus dracos e mate 5 Devotos da Escama de Elite.‡Возьмите дракона Корастразы из верхнего кольца Нексуса в Хладарре и убейте 5 чешуеклятов-гвардейцев.‡Corastrasza auf dem oberen Ring des Nexus\' in Kaltarra möchte, dass Ihr auf ihrem Drachen 5 Elitesoldaten der Eidschuppen tötet.‡콜다라에 있는 마력의 탑 상부에 있는 코라스트라자가 그녀의 비룡을 타고 비늘신도 정예병 5마리를 처치해 달라고 부탁했습니다.‡Corastrasza en el cinturón superior de El Nexo en Gelidar quiere que montes sobre su draco y que mates a 5 élites Juraescama.‡Corastrasza en el cinturón superior de El Nexo en Gelidar quiere que montes sobre su draco y que mates a 5 élites Juraescama.‡Corastrasza sur l\'Anneau supérieur du Nexus à Frimarra vous demande de chevaucher son drake et de tuer 5 Ligécailles d\'élite.‡考达拉魔枢上层的科拉丝塔萨要你骑着她的幼龙杀死5名鳞誓精英。‡在凜懼島上的奧核之心，寇菈史卓莎要求你，騎乘她的飛龍並殺死5個誓鱗精英。',
  }
},
[13414] = {
  {
    'Ases indomáveis!‡Асы, ввысь!‡Schlacht in den Wolken‡하늘의 용사‡Ases del aire‡Ases del aire‡Un as dans notre jeu !‡展翅高飞！‡振翼高飛!',
    nil,
    'Corastrasza, no círculo mais alto do Nexus, em Gelarra, quer que você cavalgue um de seus dracos e mate 5 Devotos da Escama de Elite.‡Возьмите дракона Корастразы из верхнего кольца Нексуса в Хладарре и убейте 5 чешуеклятов-гвардейцев.‡Corastrasza auf dem oberen Ring des Nexus\' in Kaltarra möchte, dass Ihr auf ihrem Drachen 5 Elitesoldaten der Eidschuppen tötet.‡콜다라에 있는 마력의 탑 상부에 있는 코라스트라자가 그녀의 비룡을 타고 비늘신도 정예병 5마리를 처치해 달라고 부탁했습니다.‡Corastrasza en el cinturón superior de El Nexo en Gelidar quiere que montes sobre su draco y que mates a 5 élites Juraescama.‡Corastrasza en el cinturón superior de El Nexo en Gelidar quiere que montes sobre su draco y que mates a 5 élites Juraescama.‡Corastrasza sur l\'Anneau supérieur du Nexus à Frimarra vous demande de chevaucher son drake et de tuer 5 Ligécailles d\'élite.‡考达拉魔枢上层的科拉丝塔萨要你骑着她的幼龙杀死5名鳞誓精英。‡在凜懼島上的奧核之心，寇菈史卓莎要求你，騎乘她的飛龍並殺死5個誓鱗精英。',
  }
},
[13415] = {
  {
    'O console da biblioteca‡Пульт в библиотеке‡Die Bibliothekenkonsole‡도서관 조작대‡La consola de la Biblioteca‡La consola de la Biblioteca‡La console de la bibliothèque‡图书馆的控制台‡圖書館裡的控制台',
    nil,
    'Leve o Disco do Inventor ao Console da Biblioteca do Inventor.‡Активируйте пульт в Библиотеке Изобретателя с помощью диска изобретателя.‡Bringt die Scheibe des Erfinders zur Bibliothekenkonsole des Erfinders im Inneren der Bibliothek des Erfinders.‡발명가의 도서관 안에 있는 발명가의 도서관 조작대에 발명가의 원반을 가져가야 합니다.‡Lleva el disco de inventor a la Consola de la Biblioteca del Inventor.‡Lleva el disco de inventor a la Consola de la Biblioteca del Inventor.‡Apportez le Disque de l\'inventeur à la Console de la bibliothèque de l\'inventeur dans la Bibliothèque de l\'inventeur.‡拿着创世者的圆盘，前往创世者的图书馆内的控制台。‡將發明者圓盤，帶至發明者圖書館裡的發明者圖書館控制台。',
  }
},
[13416] = {
  {
    'O console da biblioteca‡Пульт в библиотеке‡Die Bibliothekenkonsole‡도서관 조작대‡La consola de la Biblioteca‡La consola de la Biblioteca‡La console de la bibliothèque‡图书馆的控制台‡圖書館裡的控制台',
    nil,
    'Leve o Disco do Inventor ao Console da Biblioteca do Inventor.‡Активируйте пульт в Библиотеке Изобретателя с помощью диска изобретателя.‡Bringt die Scheibe des Erfinders zur Bibliothekenkonsole des Erfinders im Inneren der Bibliothek des Erfinders.‡발명가의 도서관 안에 있는 발명가의 도서관 조작대에 발명가의 원반을 가져가야 합니다.‡Lleva el disco de inventor a la Consola de la Biblioteca del Inventor.‡Lleva el disco de inventor a la Consola de la Biblioteca del Inventor.‡Apportez le Disque de l\'inventeur à la Console de la bibliothèque de l\'inventeur dans la Bibliothèque de l\'inventeur.‡拿着创世者的圆盘，前往创世者的图书馆内的控制台。‡將發明者圓盤，帶至發明者圖書館裡的發明者圖書館控制台。',
  }
},
[13417] = {
  {
    '‡Братья Бронзобороды‡Die Gebrüder Bronzebart‡브론즈비어드 형제들‡Los hermanos Barbabronce‡Los hermanos Barbabronce‡Les frères Barbe-de-bronze‡铜须兄弟‡',
    nil,
    '‡Прикрывайте Бранна Бронзоборода и его ветролет, пока не доберетесь до Ледяной крепости.‡Begleitet Brann Bronzebart und seine Flugmaschine zur Eisfestung.‡브란 브론즈비어드와 함께 그의 비행기를 타고 서리요새로 가야 합니다.‡Acompaña a Brann Barbabronce y a su máquina voladora hasta Fuerte Escarcha.‡Acompaña a Brann Barbabronce y a su máquina voladora hasta Fuerte Escarcha.‡Accompagnez Brann Barbe-de-bronze et sa Machine volante au Fort du Givre.‡与布莱恩·铜须及其飞行器一起返回冰霜堡。‡',
  }
},
[13418] = {
  {
    'Preparativos de guerra‡Подготовка к войне‡Kriegsvorbereitung‡전쟁 준비‡A punto para la guerra‡A punto para la guerra‡Préparatifs de guerre‡作战准备‡備戰',
    nil,
    'Fale com o Oficial Van Rossem para ir para o Rompe-céus. Chegando lá, apresente-se ao Alto-capitão Justino Bartolotto.‡Поговорите с офицером ван Россемом, который переправит вас на борт "Усмирителя небес" в Ледяной Короне, а потом побеседуйте со старшим капитаном Джастином Бартлеттом.‡Sprecht mit Offizier Van Rossem, um Euch sicher zur Himmelsbrecher in Eiskrone bringen zu lassen, und meldet Euch dann bei Stabshauptmann Justin Bartlett.‡얼음왕관에서 하늘파괴자호가 지나가는 길을 확보하려면 장교 반 로셈과 대화해야 합니다. 임무를 마치면 수석 선장 저스틴 바틀릿에게 보고하십시오.‡Habla con el Oficial Van Rossem para asegurarte el pasaje hasta El Rompecielos en Corona de Hielo, y luego informa al gran capitán Justin Bartlett.‡Habla con el Oficial Van Rossem para asegurarte el pasaje hasta El Rompecielos en Corona de Hielo, y luego informa al gran capitán Justin Bartlett.‡Parlez à l\'Officier Van Rossem pour accéder au Brise-ciel dans la Couronne de glace, puis présentez-vous au Grand capitaine Justin Bartlett.‡与军官范恩·罗希姆对话，前往冰冠冰川的破天号。抵达之后，向高级指挥官加斯汀·巴雷特报到。‡與軍官凡·羅森對話，以取得在寒冰皇冠登上破天者號的通行許可，然後向提督賈斯汀·巴特勒報到。',
  }
},
[13419] = {
  {
    'Preparativos de guerra‡Подготовка к войне‡Kriegsvorbereitung‡전쟁 준비‡A punto para la guerra‡A punto para la guerra‡Préparatifs de guerre‡作战准备‡備戰',
    nil,
    'Fale com o Exterminador dos Céus Klum para ir para o Martelo de Orgrim, na Coroa de Gelo, e, a seguir, apresente-se ao Exterminador dos Céus Korm Escaranegra.‡Поговорите с покорителем небес Клумом, который переправит вас на борт "Молота Оргрима" в Ледяной Короне, а потом побеседуйте с покорителем небес Кормом Черным Шрамом.‡Ihr befindet Euch auf dieser Quest.‡얼음왕관에서 오그림의 망치호가 지나가는 길을 확보하려면 하늘약탈자 클룸과 대화해야 합니다. 임무를 마치면 하늘약탈자 코름 블랙스카에게 보고하십시오.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[13420] = {
  {
    'Gelo eterno‡Вечный лед‡Immerfrost‡영원의 서리‡Siemprescarcha‡Siemprescarcha‡Le permagivre‡永冻之冰‡永霜',
    nil,
    'Volte a Dun Niffelem e pergunte a Calder sobre o pedaço de Gelo Eterno.‡Возвращайтесь в Дун Ниффелем и расспросите Кальдера насчет осколка Вечного льда.‡Ihr müsst nach Dun Niffelem zurückkehren und Euch bei Calder über das Stück Immerfrost erkundigen.‡던 니펠렘으로 돌아가 칼더에게 영원의 서리 조각에 대해서 물어봐야 합니다.‡Vuelve a Dun Niffelem y pregunta a Calder sobre el trozo de siemprescarcha.‡Vuelve a Dun Niffelem y pregunta a Calder sobre el trozo de siemprescarcha.‡Vous devez retourner à Dun Niffelem et demander à Calder ce qu\'il sait du morceau de permagivre.‡返回丹尼芬雷，向卡尔德询问关于永冻之冰的事。‡你即將返回丹尼弗蘭詢問考德爾有關這塊永霜的訊息。',
  }
},
[13421] = {
  {
    'Lembre-se do gelo eterno!‡Больше Вечного льда!‡Vergesst das Immerfrosteis nicht!‡영원의 서리를 기억하라!‡¡Acuérdate de siemprescarcha!‡¡Acuérdate de siemprescarcha!‡N\'oubliez pas le permagivre !‡铭记永冻之冰！‡牢記永霜!',
    nil,
    nil,
  }
},
[13422] = {
  {
    'Mantendo a disciplina‡Поучить уму-разуму‡Disziplin bewahren‡규율을 유지하는 자‡Seguir con la disciplina‡Seguir con la disciplina‡Maintenir la discipline‡维持纪律‡維護紀律',
    nil,
    'Gretta, a Árbitra, na Aldeia Brunnhildar, quer que você use o Bastão Disciplinador em 6 Vraikalen Exaustos na Mina Esquecida.‡Накажите 6 обессиленных врайкулов из Заброшенного рудника с помощью вразумляющего жезла по заданию Гретты Судьи из деревни Бруннхильдар.‡Gretta die Schiedsfrau aus Brunnhildar möchte, dass Ihr die Disziplinarrute auf 6 erschöpfte Vrykul in der verlassenen Mine anwendet.‡브룬힐다르 마을에 있는 중재자 그레타가 쓸쓸한 광산 내에 있는 지친 브리쿨 6명에게 규율의 지팡이를 사용해 달라고 부탁했습니다.‡Gretta la Mediadora, en el poblado Brunnhildar, quiere que uses la vara disciplinante en 6 vrykuls agotados dentro de La Mina Desolada.‡Gretta la Mediadora, en el Poblado Brunnhildar, quiere que uses la vara disciplinante en 6 vrykuls agotados dentro de La Mina Desolada.‡Gretta la Médiatrice, à Brunnhildar, veut que vous utilisiez le Bâton de discipline sur 6 Vrykuls épuisés dans la Mine Lugubre.‡布伦希尔达村的仲裁者格蕾塔要你进入荒弃矿洞，对6名筋疲力尽的维库人使用训诫之杖。‡布倫希爾達村的『仲裁者』格瑞塔要你對6個疲憊的維酷人使用紀律權杖。',
  }
},
[13423] = {
  {
    'Defendendo o título‡Подтверждение победы‡Euren Titel verteidigen‡칭호를 지켜내는 자‡Defender tu título‡Defender tu título‡Défendre votre titre‡卫冕战‡衛冕',
    nil,
    'Gretta, a Árbitra, na Aldeia Brunnhildar, quer que você derrote 6 Desafiantes Vitoriosas.‡Одержите победу над 6 дуэлянтами-победителями по заданию Гретты Судьи из деревни Бруннхильдар.‡Gretta die Schiedsfrau in Brunnhildar wünscht, dass Ihr 6 siegreiche Herausforderinnen besiegt.‡브룬힐다르 마을에 있는 중재자 그레타가 승리한 도전자 6명을 처치해 달라고 부탁했습니다.‡Gretta la Mediadora, en el poblado Brunnhildar, quiere que venzas a 6 contendientes victoriosas.‡Gretta la Mediadora, en el Poblado Brunnhildar, quiere que venzas a 6 contendientes victoriosas.‡Gretta la Médiatrice, à Brunnhildar, vous demande de vaincre 6 Prétendantes victorieuses.‡布伦希尔达村的仲裁者格蕾塔要你击败6个获胜的挑战者。‡布倫希爾達村的『仲裁者』格瑞塔要求你擊敗六個挑戰者。',
  }
},
[13424] = {
  {
    '‡Обратно в Яму Клыка‡Zurück in die Grube‡구덩이로 돌아가는 자‡De vuelta al foso‡De vuelta al foso‡Retour dans la fosse‡返回利齿之坑‡重返深淵',
    nil,
    '‡Отправляйтесь в Яму Клыка, воспользуйтесь поводьями матриарха ледочревов и победите 6 боевых медведей Круга хильд по заданию Гретты Судьи из деревни Бруннхильдар.‡Gretta die Schiedsfrau aus Brunnhildar möchte, dass Ihr in die Reißzahngrube geht und mit den Zügeln der Eisschlundmatriarchin 6 Kriegsbären des Hildarthings besiegt.‡‡Gretta la Mediadora, en el Poblado Brunnhildar, quiere que uses las riendas de la matriarca Faucehielo dentro de El Foso del Colmillo para derrotar a 6 osos de guerra de El Encuentro Hyldnir.‡Gretta la Mediadora, en el Poblado Brunnhildar, quiere que uses las riendas de la matriarca Faucehielo dentro de El Foso del Colmillo para derrotar a 6 osos de guerra de El Encuentro Hyldnir.‡Gretta la Médiatrice, à Brunnhildar, veut que vous utilisiez les Rênes de matriarche glacegueule dans la Fosse du croc et que vous battiez 6 Ours de guerre du Hyldsmeet.‡‡',
  }
},
[13425] = {
  {
    'As aberrações têm de morrer‡Смерть гнусным тварям!‡Die Missgeburten müssen sterben‡돌연변이를 처치하는 자‡Las aberraciones deben morir‡Las aberraciones deben morir‡Les aberrations doivent mourir‡消灭那些怪胎！‡那些畸形非死不可',
    nil,
    'Gretta, a Árbitra, na Aldeia Brunnhildar, quer que você vá a Valkyrion e tome Ampolas de Óleo Gélido dos Aspirantes Valkyrion Use as Ampolas de Óleo Gélido para destruir 30 Ovos de Protodraco Pestilento.‡По заданию Гретты Судьи из деревни Бруннхильдар отправляйтесь в Валькирион и добудьте у валькирионских претенденток флаконы масла льда. Используйте флаконы масла льда, чтобы уничтожить 30 зачумленных яиц протодраконов.‡Gretta die Schiedsfrau in Brunnhildar möchte, dass Ihr nach Valkyrion geht und Phiolen mit Frostöl von den Streiterinnen von Valkyrions besorgt. Nutzt die Phiolen dann, um 30 verseuchte Eier der Protodrachen zu zerstören.‡브룬힐다르 마을에 있는 중재자 그레타가 발키리온으로 가서 발키리온 지원자에게 냉기 기름이 든 유리병을 빼앗은 후, 냉기 기름이 든 유리병을 사용하여 역병 걸린 원시비룡 알 30개를 파괴해 달라고 부탁했습니다.‡Gretta la Mediadora, en el poblado Brunnhildar, quiere que vayas a Valkyrion y que consigas el aceite de escarcha de los aspirantes de Valkyrion. Usa los viales de aceite de escarcha para exterminar 30 huevos de protodraco apestados.‡Gretta la Mediadora, en el Poblado Brunnhildar, quiere que vayas a Valkyrion y que consigas el aceite de escarcha de los aspirantes de Valkyrion. Usa los viales de aceite de escarcha para exterminar 30 huevos de protodraco apestados.‡Gretta la Médiatrice, à Brunnhildar, vous demande de vous rendre à Valkyrion et d\'obtenir des Fioles d\'huile glaciale des Aspirantes de Valkyrion. Utilisez les Fioles d\'huile glaciale pour détruire 30 Oeufs de Proto-drakes pestiférés.‡布伦希尔达村的仲裁者格蕾塔要你前往瓦基里安，从瓦基里安候选者身上夺取冰霜油膏，并用冰霜油膏摧毁30枚瘟疫始祖龙卵。‡布倫希爾達村的『仲裁者』格瑞塔要你前往華爾基倫，從華爾基倫野心家身上取得冰霜之油瓶。使用冰霜之油瓶摧毀30個染疫元龍蛋。',
  }
},
[13426] = {
  {
    'Xarantauro, a testemunha‡Ксанатавр, Свидетель‡Der Zeuge Xarantaur‡목격자 자란타우르‡Xarantaur, el Testigo‡Xarantaur, el Testigo‡Xarantaur, le témoin‡见证者夏拉托尔‡札倫陶，見證者',
    nil,
    'Fale com Xarantauro na Aldeia Tunka\'lo.‡Поговорите с Ксанатавром в лагере Тунка\'ло.‡Sprecht mit Xarantaur im Camp Tunka\'lo.‡툰카로 야영지에서 자란타우르와 대화해야 합니다.‡Habla con Xarantaur en el Campamento Tunka\'lo.‡Habla con Xarantaur en el Campamento Tunka\'lo.‡Parlez à Xarantaur au Camp Tunka\'lo.‡与唐卡洛营地的夏拉托尔谈一谈。‡與坦卡羅營地的札倫陶交談。',
  }
},
[13427] = {
  {
    'Chamado às armas: Vale Alterac‡К оружию! Альтеракская долина‡Ruf zu den Waffen: Alteractal‡전장으로: 알터랙 계곡‡Llamamiento a las armas: Valle de Alterac‡Llamamiento a las armas: Valle de Alterac‡Appel aux armes : vallée d\'Alterac‡战斗的召唤：奥特兰克山谷‡戰鬥的號角:奧特蘭克山谷',
    nil,
    'Vença uma partida no campo de batalha do Vale Alterac e fale novamente com um General de Brigada da Aliança em Invérnia, Dalaran, Shattrath ou qualquer capital da Aliança.‡Победите на поле боя Альтеракской долины и вернитесь к бригадному генералу Альянса в любую из столиц Альянса, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Alteractal und meldet Euch anschließend bei einem Brigadegeneral der Allianz in einer der Hauptstädte, Tausendwinter, in Dalaran oder Shattrath.‡알터랙 계곡 전장에서 승리를 거둔 후 얼라이언스 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 얼라이언스 준장에게 돌아가야 합니다.‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, en Conquista del Invierno, en Dalaran o en Shattrath.|n‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un general de brigada de la Alianza en cualquier capital de la Alianza, en Conquista del Invierno, en Dalaran o en Shattrath.|n‡Remportez la bataille dans la Vallée d\'Alterac, puis présentez-vous à un Général de brigade de l\'Alliance, à Dalaran, Shattrath, Joug-d\'hiver ou dans l\'une des capitales de l\'Alliance.‡在奥特兰克山谷战场中获得一场胜利，然后向任意联盟主城、达拉然、冬拥湖或沙塔斯城中的联盟准将复命。‡在奧特蘭克山谷的戰場中獲勝，然後向任何一座聯盟主城、冬握湖、撒塔斯、或達拉然的聯盟准將回報。',
  }
},
[13428] = {
  {
    'Chamado às armas: Vale Alterac‡К оружию! Альтеракская долина‡Ruf zu den Waffen: Alteractal‡전장으로: 알터랙 계곡‡Llamamiento a las armas: Valle de Alterac‡Llamamiento a las armas: Valle de Alterac‡Appel aux armes : vallée d\'Alterac‡战斗的召唤：奥特兰克山谷‡戰鬥的號角:奧特蘭克山谷',
    nil,
    'Vença uma partida no campo de batalha do Vale Alterac e fale novamente com um Armipotente da Horda em Invérnia, Dalaran, Shattrath ou qualquer capital da Horda.‡Победите на поле боя Альтеракской долины и вернитесь к ордынскому вестнику войны в любую из столиц Орды, на Озеро Ледяных Оков, в Даларан или в Шаттрат.‡Gewinnt eine Schlacht im Alteractal und meldet Euch anschließend bei einem Kriegshetzer der Horde in einer der Hauptstädte, Tausendwinter, in Dalaran oder Shattrath.‡알터랙 계곡 전장에서 승리를 거둔 후 호드 대도시나 겨울손아귀 호수, 달라란, 샤트라스에 있는 호드 돌격대장에게 돌아가야 합니다.‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, en Conquista del Invierno, en Dalaran o en Shattrath.‡Gana un encuentro en el campo de batalla del Valle de Alterac y vuelve a ver a un belisario de la Horda en cualquier capital de la Horda, en Conquista del Invierno, en Dalaran o en Shattrath.‡Remportez la bataille dans la Vallée d\'Alterac, puis présentez-vous à un Porteguerre de la Horde, à Dalaran, Shattrath, Joug-d\'hiver ou dans l\'une des capitales de la Horde.‡在奥特兰克山谷战场中获得一场胜利，然后向任意部落主城、达拉然、冬拥湖或沙塔斯城中的部落战争使者复命。‡在奧特蘭克山谷的戰場中獲勝，然後向任何一座部落主城、冬握湖、撒塔斯、或達拉然的部落戰爭使者回報。',
  }
},
[13429] = {
  {
    'Uma distração para Akama‡Отвлекающий маневр‡Ein Ablenkungsmanöver für Akama‡아카마를 위한 소동‡Una distracción para Akama‡Una distracción para Akama‡Une distraction pour Akama‡帮助阿卡玛‡替阿卡瑪製造混亂',
    nil,
    'Akama e Maiev precisam entrar no Templo Negro no Vale da Lua Negra quando as forças de Xi\'ri criarem a distração.‡Убедитесь, что Акама и Майев вошли в Черный храм в долине Призрачной Луны после того, как войска Кси\'ри совершат отвлекающий маневр.‡Stellt sicher, dass Akama und Maiev den Schwarzen Tempel betreten, nachdem Xi\'ris Streitkräfte ihr Ablenkungsmanöver durchgeführt haben.‡지리의 군대가 소동을 일으킨 후에 마이에브와 아카마가 어둠달 골짜기의 검은 사원에 진입하도록 도와야 합니다.‡Asegúrate de que Akama y Maiev entran en El Templo Oscuro, en el Valle Sombraluna, cuando las fuerzas de Xi\'ri creen una distracción.‡Asegúrate de que Akama y Maiev entran en El Templo Oscuro, en el Valle Sombraluna, cuando las fuerzas de Xi\'ri creen una distracción.‡Assurez-vous qu\'Akama et Maiev pénètrent bien dans le Temple noir de la Vallée d\'Ombrelune une fois que les forces de Xi\'ri auront fait diversion.‡在克希利的军队发动佯攻之后，保护阿卡玛和玛维进入影月谷内的黑暗神殿。‡在希瑞的手下製造混亂的時候護送阿卡瑪和瑪翼夫進入影月谷的黑暗神廟。',
  }
},
[13430] = {
  {
    'Prova dos naarus: Magtheridon‡Испытание наару: Магтеридон‡Die Prüfung der Naaru: Magtheridon‡나루의 시험: 마그테리돈‡Prueba de los naaru: Magtheridon‡Prueba de los naaru: Magtheridon‡L\'épreuve des naaru : Magtheridon‡纳鲁的试炼：玛瑟里顿‡那魯的試煉:瑪瑟里頓',
    nil,
    'A\'dal, na cidade de Shattrath, quer que você mate Magtheridon.‡По заданию А\'дала из Шаттрата убейте Магтеридона.‡A\'dal in Shattrath möchte, dass Ihr Magtheridon vernichtet.‡샤트라스에 있는 아달이 마그테리돈을 처치해 달라고 부탁했습니다.‡A\'dal en la Ciudad de Shattrath quiere que mates a Magtheridon.‡A\'dal en la Ciudad de Shattrath quiere que mates a Magtheridon.‡A\'dal de Shattrath vous demande de tuer Magtheridon.‡沙塔斯城的阿达尔要求你杀死玛瑟里顿。‡撒塔斯城的阿達歐要你殺死瑪瑟里頓。',
  }
},
[13431] = {
  {
    'A clava de Kar\'desh‡Дубина Кардеша‡Der Knüppel von Kar\'desh‡카르데쉬의 곤봉‡La cayada de Kar\'desh‡La cayada de Kar\'desh‡Le gourdin de Kar\'desh‡卡达什圣杖‡卡德許的鬥棍',
    nil,
    'Skar\'this, o Herege, no Pátio dos Escravos do Reservatório Presacurva, quer que você leve o Sinete Terreno e o Sinete Fulgurante até ele.‡Принесите эталоны земли и огня Скартису Еретику в Узилище (героический уровень сложности) в Резервуар Кривого Клыка.‡Nar\'biss der Ketzer in den heroischen Sklavenunterkünften des Echsenkessels möchte, dass Ihr ihm das Erdensiegel und das Flammensiegel bringt.‡갈퀴송곳니 저수지의 용사 강제 노역소에 있는 이단자 스카디스가 땅의 인장과 불의 인장을 가져다 달라고 부탁했습니다.‡Skar\'this el Herético, en El Reciento de los Esclavos heroico, en la Reserva Colmillo Torcido, quiere que le lleves el sello terráneo y el sello llameante.‡Skar\'this el Herético, en El Reciento de los Esclavos heroico, en la Reserva Colmillo Torcido, quiere que le lleves el sello terráneo y el sello llameante.‡Skar’this l’Hérétique, dans les Enclos aux esclaves héroïques du Réservoir de Glissecroc, veut que vous lui apportiez la Chevalière terrestre et la Chevalière flamboyante.‡将土灵徽记和灿烂徽记交给盘牙水库奴隶围栏的异教徒斯卡希斯。‡盤牙蓄湖中奴隸監獄的『異端』司卡利斯要你帶給他土靈徽記和熾烈徽記。',
  }
},
[13432] = {
  {
    'As ampolas da eternidade‡Сосуды Вечности‡Die Phiolen der Ewigkeit‡영원의 샘‡Los viales de la eternidad‡Los viales de la eternidad‡Les fioles d\'éternité‡永恒水瓶‡永恆之瓶',
    nil,
    'Soridormi, nas Cavernas do Tempo, quer que você recupere o Resíduo da Ampola de Vashj da Dama Vashj no Reservatório Presacurva e o Resíduo da Ampola de Kael do Kael\'thas Andassol na Bastilha da Tormenta.‡Соридорми из Пещер Времени желает, чтобы вы принесли ей неполный фиал Леди Вайш из Резервуара Кривого Клыка и неполный фиал Кель\'таса из Крепости Бурь.‡Soridormi in den Höhlen der Zeit möchte, dass Ihr die Überreste von Vashjs Phiole im Echsenkessel und die Überreste von Kaels Phiole von Kael\'thas Sonnenwanderer in der Festung der Stürme besorgt.‡시간의 동굴에 있는 소리도르미가 갈퀴송곳니 저수지에 있는 여군주 바쉬에게서 유리병 잔여물을, 폭풍우 요새에 있는 캘타스 선스트라이더로부터 유리병 잔여물을 되찾아 달라고 부탁했습니다.‡Soridormi de las Cavernas del Tiempo quiere que recuperes los restos del vial de Vashj de Lady Vashj en la Reserva Colmillo Torcido, y los restos del vial de Kael de Kael\'thas Caminante del Sol, en El Castillo de la Tempestad.‡Soridormi de las Cavernas del Tiempo quiere que recuperes los restos del vial de Vashj de Lady Vashj en la Reserva Colmillo Torcido, y los restos del vial de Kael de Kael\'thas Caminante del Sol, en El Castillo de la Tempestad.‡Soridormi aux Grottes du temps vous demande de récupérer le Reste de la fiole de Vashj auprès de Dame Vashj au réservoir de Glissecroc et le Reste de la fiole de Kael auprès de Kael\'thas Haut-Soleil au donjon de la Tempête.‡时光之穴的索莉多米要你从盘牙水库的瓦丝琪那里取回瓦丝琪的水瓶残余，并从风暴要塞的凯尔萨斯·逐日者那里取回凯尔萨斯的水瓶残余。‡時光之穴的索芮朵蜜要你去從盤牙蓄湖的瓦許女士身上取得瓦許的殘存之瓶，從風暴要塞的凱爾薩斯·逐日者身上取得凱爾薩斯的殘存之瓶。',
  }
},
