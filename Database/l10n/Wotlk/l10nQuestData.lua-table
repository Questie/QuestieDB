},
[1710] = {
  {
    'Cascas queimadas de sol‡Высохшая скорлупа‡Sonnenverbrannte Schalen‡바짝 마른 알껍질‡Cáscaras asoladas‡Cáscaras asoladas‡Coquilles desséchées au soleil‡晒焦的蛋壳‡曬焦的蛋殼',
    nil,
    'Leve 20 Cascas Queimadas de Sol para Mathiel em Darnassus.‡Принесите 20 кусков высохшей на солнце скорлупы Матилю из Дарнаса.‡Bringt 20 sonnenverbrannte Schalen zu Mathiel in Darnassus.‡다르나서스에 있는 메시엘에게 바짝 마른 알껍질 20개를 가져가야 합니다.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Lleva 20 cáscaras asoladas a Mathiel en Darnassus.‡Apportez 20 Coquilles desséchées au soleil à Mathiel, à Darnassus.‡把20个晒焦的蛋壳交给达纳苏斯的玛希尔。‡把20個曬焦的蛋殼交給達納蘇斯的瑪希爾。',
  }
},
[1711] = {
  {
    '‡Доспехи Матиля‡Mathiels Rüstung‡‡La armadura de Mathiel‡La armadura de Mathiel‡L\'armure de Mathiel‡玛希尔的铠甲‡',
