[12411] = {
  {
    'Dedicação de irmã‡Спасение сестры‡Das Gelöbnis der Schwester‡자매의 맹세‡La promesa de una hermana‡La promesa de una hermana‡Le serment d\'une sœur‡姐姐的誓言‡守護妹妹的誓言',
    nil,
    'Procure por Anya na Gruta do Uivo da Noite, perto da Aldeia Solstício.‡Найдите Аню в Логове Ночного Воя рядом с Деревней Солнцестояния.‡Sucht nach Anya im Grauheulerbau in der Nähe von Julheim.‡극지 마을 근처의 그늘울음 동굴에서 안야를 찾아야 합니다.‡Busca a Anya en el Cubil Aúllaocaso cerca del Poblado Solsticio.‡Busca a Anya en el Cubil Aúllaocaso cerca del Poblado Solsticio.‡Cherchez Anya dans la Tanière des Hurlesoir près de Solstice.‡在冬至村附近的暗嚎兽穴中寻找安娅。‡去暮嚎之穴尋找安雅的下落，就在季至村的附近。',
  }
},
[12412] = {
  {
    'Amigo de inimigo meu‡Друг моего врага‡Freund meines Feindes‡적의 친구‡El amigo de mi enemigo‡El amigo de mi enemigo‡L\'ami de mon ennemi‡我的敌人的朋友‡敵人之友',
    nil,
    'A Conquistadora Krenna, no Forte da Conquista, quer que você mate 8 Caçadores de Arroio Prateado e o líder deles, Vladek, no Posto Boca da Mata.‡Завоевательница Кренна из Крепости Завоевателей приказала вам убить 8 охотников Среброречья и их предводителя Владека с Заставы на опушке.‡Eroberin Krenna in Burg Siegeswall möchte, dass Ihr 8 Jäger von Silberwasser und ihren Anführer Vladek am Posten des Waldrands tötet.‡정복의 요새에 있는 정복자 크레나가 숲 가장자리 초소에서 은빛시내 마을 사냥꾼 8명과 그들의 지도자인 블라데크를 처치해 달라고 부탁했습니다.‡La conquistadora Krenna en Bastión de la Conquista quiere que mates a 8 cazadores de Arroyoplata y a su líder, Vladek, en el Puesto Fronterizo del Bosque.‡La conquistadora Krenna en Bastión de la Conquista quiere que mates a 8 cazadores de Arroyoplata y a su líder, Vladek, en el Puesto Fronterizo del Bosque.‡La Conquérante Krenna du Bastion de la Conquête vous demande de tuer 8 Chasseurs de Ruissargent ainsi que leur chef, Vladek, au poste de la Lisière.‡征服堡的征服者克雷娜要你前往林边哨站，击败8名银溪镇猎人及他们的领袖弗拉德克。‡征服堡的征服者克蓮娜需要你去殺死8名銀溪獵人，以及他們的首領，弗拉戴克。他們就在林邊崗哨中。',
  }
},
[12413] = {
  {
    'Ataque ao Arroio Prateado‡Нападение на Среброречье‡Angriff auf Silberwasser‡은빛시내 마을 공격‡Ataque sobre Arroyoplata‡Ataque sobre Arroyoplata‡L\'attaque de Ruissargent‡攻击银溪镇‡銀溪之戰',
    nil,
    'A Conquistadora Krenna, no Forte da Conquista, quer que você mate 8 Defensores de Arroio Prateado na Serra do Arroio Prateado.‡Завоевательница Кренна из Крепости Завоевателей просит вас yбить 8 защитников Среброречья в Холмах Среброречья.‡Eroberin Krenna in Burg Siegeswall möchte, dass Ihr 8 Verteidiger von Silberwasser in den Hügeln von Silberwasser erschlagt.‡정복의 요새에 있는 정복자 크레나가 은빛시내 마을 언덕에서 은빛시내 마을 수호병 8명을 처치해 달라고 부탁했습니다.‡La conquistadora Krenna en Bastión de la Conquista quiere que mates a 8 defensores de Arroyoplata en las Colinas de Arroyoplata.‡La conquistadora Krenna en Bastión de la Conquista quiere que mates a 8 defensores de Arroyoplata en las Colinas de Arroyoplata.‡La Conquérante Krenna du Bastion de la Conquête vous demande de tuer 8 Défenseurs de Ruissargent dans les Collines de Ruissargent.‡征服堡的征服者克雷娜要你前往银溪丘陵，杀死8名银溪镇防御者。‡征服堡的征服者克蓮娜需要你殺死8名銀溪防衛者，你可以在銀溪丘上找到他們。',
  }
},
[12414] = {
  {
    'Montarias?‡Лошадки для лагеря‡Aufgesessen‡야생마 길들이기‡Monta‡Monta‡Monture guère solide‡顺手牵马‡準備馬匹',
    nil,
    'Cavalgue 5 Mustangues das Terras Altas e os leve ao Escudeiro Percy no Acampamento da Brigada de Cerro Oeste.‡Приведите 5 мустангов нагорья к оруженосцу Перси в Лагерь дружины Западного Края.‡Reitet 5 Hochlandmustangs zurück zu Knappe Percy im Lager der Westfallbrigade.‡산악 야생마 5마리를 타고 서부 몰락지대 여단 야영지에 있는 종자 퍼시에게 돌아가야 합니다.‡Lleva a 5 caballos mesteños de las Tierras Altas al Escudero Percy en el Campamento de la Brigada de los Páramos de Poniente.‡Lleva a 5 caballos mesteños de las Tierras Altas al Escudero Percy en el Campamento de la Brigada de los Páramos de Poniente.‡Chevauchez 5 Mustangs des hautes-terres jusqu\'à l\'Écuyer Percy, au Campement de la brigade de la marche de l\'Ouest.‡驱赶5匹高地野马回到月溪旅营地的侍从皮尔斯那里。‡將5匹高地野馬騎回侍從派西身邊，他就在西荒兵團駐營中。',
  }
},
[12415] = {
  {
    'O irritador de cavalos‡Пугалка для коней‡Der Pferdebrüller‡야생마 겁주기‡La Horda que gritaba a los caballos‡La Horda que gritaba a los caballos‡L\'homme qui hurlait à l\'oreille des chevaux‡惊吓野马‡嚇唬馬匹',
    nil,
    'Espante 15 Mustangues das Terras Altas e fale novamente com Soulok Fúria da Tormenta na Aldeia Oneqwah.‡Обратите в бегство 15 мустангов нагорья и вернитесь к Соулоку Штормовая Ярость в Лагерь Уанква.‡Erschreckt 15 Hochlandmustangs und kehrt zu Soolok Sturmwut im Camp Oneqwah zurück.‡산악 야생마 15마리를 놀라게 하여 쫓아낸 후 원크와 야영지에 있는 소울로크 스톰퓨리에게 돌아가야 합니다.‡Asusta a 15 caballos mesteños de las Tierras Altas y vuelve para hablar con Soulok Furia de Tormenta en el Campamento Oneqwah.‡Asusta a 15 caballos mesteños de las Tierras Altas y vuelve para hablar con Soulok Furia de Tormenta en el Campamento Oneqwah.‡Effrayez 15 Mustangs des hautes-terres puis retournez voir Soulok Furie-des-tempêtes au Camp Oneqwah.‡惊吓15匹高地野马，然后向欧尼瓦营地的索鲁克·雷怒复命。‡驚嚇15匹高地野馬，並回報給索羅克·風暴之怒，他就在歐尼克瓦營地。',
  }
},
[12416] = {
  {
    'Prova de fogo‡Горячая битва‡Im Eifer des Gefechts‡치열한 전투‡Una batalla acalorada‡Una batalla acalorada‡Une vive bataille‡白热化的战斗‡戰火升溫',
    nil,
    'Ajude o Capitão Iskandar a manter posição nos desfiladeiros, participando da morte de 12 Carniçais Frígidos Atacantes, 8 Geists Frígidos Atacantes e 1 Abominação Frígida Atacante.|n|nFale novamente com Ceristrasz quando tiver terminado a tarefa.‡Помогите капитану Искандару удержать каньоны, приняв участие в смерти 12 хладных атакующих вурдалаков, 8 хладных атакующих упырей и 1 хладного атакующего поганища.|n|nКогда это будет выполнено, возвращайтесь к Церистразу.‡Unterstützt Hauptmann Drayzen, die Schluchten zu halten. Tötet 12 eisige Ghulangreifer, 8 eisige Spukangreifer und 1 eisigen Monstrositätenangreifer.|n|nKehrt zu Ceristrasz zurück, sobald die Aufgabe abgeschlossen ist.‡얼어붙은 구울 돌격병 12마리, 얼어붙은 외눈깨비 돌격병 8마리, 그리고 얼어붙은 누더기골렘 돌격병 1마리를 처치하여 협곡을 방어하는 부대장 이스칸다르를 지원하고 임무를 마치면 세리스트라즈에게 돌아가야 합니다.‡Ayuda al capitán Iskandar en la resistencia en los cañones ayudando a matar a 12 agresores necrófagos gélidos, 8 agresores geists gélidos y 1 agresor abominación gélida.|n|nVuelve junto a Ceristrasz cuando hayas terminado esta tarea.‡Ayuda al capitán Iskandar en la resistencia en los cañones ayudando a matar a 12 agresores necrófagos gélidos, 8 agresores geists gélidos y 1 agresor abominación gélida.|n|nVuelve junto a Ceristrasz cuando hayas terminado esta tarea.‡Aidez le Capitaine Iskandar à tenir les canyons en participant à la mort de 12 Goules algides attaquantes, 8 Geists algides attaquants et 1 Abomination algide attaquante. Retournez voir Ceristrasz lorsque vous aurez terminé.‡杀死12个进攻的冰冷食尸鬼、8个进攻的冰冷恶鬼和1个进攻的冰冷憎恶，帮助伊斯坎达尔上尉守住峡谷。完成任务后向塞雷斯塔兹复命。‡幫助伊斯肯達隊長守護山谷，擊敗12隻嚴寒食屍鬼攻擊者、8隻嚴寒魂屍攻擊者，以及1隻嚴寒憎惡體攻擊者。事成以後，向賽利斯塔茲回報。',
  }
},
[12417] = {
  {
    'À terra voltarás‡Погребение‡Der Erde übergeben‡대지의 품으로‡Regresa a la tierra‡Regresa a la tierra‡Retourner à la terre‡重归尘土‡回歸大地',
    nil,
    'Entre no Santuário Dragônico Rubi por uma das passagens ao norte ou ao sul e procure por Bolotas-rubi. Use as bolotas-rubi nos dragões vermelhos caídos para fazer com que seus corpos retornem à terra. Fale novamente com Ceristrasz quando completar a tarefa.‡Отправляйтесь в Рубиновое святилище драконов через любой из южных или северных проходов и поищите рубиновые желуди. С помощью рубиновых желудей предайте тела павших красных драконов земле. По выполнении задания вернитесь к Церистразу.‡Erlangt über einen der nördlichen oder südlichen Pässe Zugang zum Rubindrachenschrein und sucht nach Rubineicheln. Pflanzt die Rubineicheln in der Nähe der gefallenen roten Drachen ein, um ihre Leichen wieder der Erde zu übergeben. Kehrt zu Ceristrasz zurück, sobald die Aufgabe abgeschlossen ist.‡북쪽 또는 남쪽 통로를 이용하여 루비 용제단에 들어간 다음 루비 도토리를 찾으십시오. 죽은 붉은용에게 루비 도토리를 사용해 대지의 품으로 돌려보낸 후 세리스트라즈에게 돌아가야 합니다.‡Entra al Santuario de Dragones Rubí a través de alguno de los puertos norte o sur y busca bellotas rubís. Utiliza las bellotas rubís con los dragones rojos caídos para devolver sus cuerpos a la tierra. Vuelve junto a Ceristrasz cuando esta tarea esté terminada.‡Entra al Santuario de Dragones Rubí a través de alguno de los puertos norte o sur y busca bellotas rubís. Utiliza las bellotas rubís con los dragones rojos caídos para devolver sus cuerpos a la tierra. Vuelve junto a Ceristrasz cuando esta tarea esté terminada.‡Entrez dans le Sanctuaire draconique rubis par l\'une des passes du nord ou du sud et cherchez des Glands de rubis. Utilisez les Glands de rubis sur les cadavres de dragons rouges pour rendre leur corps à la terre. Retournez auprès de Ceristrasz une fois votre tâche accomplie.‡从南面或北面的小路进入红玉巨龙圣地并寻找红玉橡果。对死去的红龙使用红玉橡果，让他们的尸体回归大地。完成任务后向塞雷斯塔兹复命。‡從北方或南方的通道進入晶紅龍殿，尋找晶紅橡實。對戰死的紅龍使用晶紅橡實，使他們的軀體回歸大地。任務完成以後，向賽利斯塔茲回報。',
  }
},
[12418] = {
  {
    'Por campos de fogo‡Через огненные поля‡Durch das Feuer‡불타는 벌판을 지나‡A través de tierras en llamas‡A través de tierras en llamas‡À travers les champs de flammes‡烈焰之地‡走過燃燒之境',
    nil,
    'Entre no Santuário Dragônico Rubi por uma das passagens ao norte ou ao sul, e então mate 6 Necromantes Frígidos e elimine a fonte de corrupção sob o santuário. Fale novamente com Ceristrasz quando completar a tarefa.‡Отправляйтесь в Рубиновое святилище драконов через любой из северных или южных проходов, затем убейте 6 хладных некромантов и уничтожьте источник осквернения, находящийся под святилищем. По выполнении задания вернитесь к Церистразу.‡Betretet den Schrein durch einen der nördlichen oder südlichen Pässe, tötet dann 6 eisige Nekromanten und eliminiert den Quell der Verderbnis unter dem Schrein. Kehrt zu Ceristrasz zurück, sobald die Aufgabe abgeschlossen ist.‡북쪽 또는 남쪽 통로를 이용하여 루비 용제단에 들어간 다음 얼어붙은 강령술사 6명을 처치하고 제단 아래에 있는 타락의 근원을 제거한 후 세리스트라즈에게 돌아가야 합니다.‡Entra al Santuario de Dragones Rubí a través de alguno de los puertos norte o sur, mata a 6 nigromantes gélidos y erradica el origen de la corrupción en el santuario. Vuelve junto a Ceristrasz cuando esta tarea esté terminada.‡Entra al Santuario de Dragones Rubí a través de alguno de los puertos norte o sur, mata a 6 nigromantes gélidos y erradica el origen de la corrupción en el santuario. Vuelve junto a Ceristrasz cuando esta tarea esté terminada.‡Entrez dans le Sanctuaire draconique rubis par l\'une des passes du nord ou du sud, tuez 6 Nécromanciens algides et éliminez la source de la corruption sous le sanctuaire. Retournez voir Ceristrasz une fois votre tâche accomplie.‡从南面或北面的小路进入红玉巨龙圣地，杀死6个冰冷通灵师并摧毁圣地下面的堕落之源。完成任务后向塞雷斯塔兹复命。‡從南方或北方的通道進入晶紅龍殿，並殺死6名嚴寒死靈法師，同時消滅神殿下方腐化的源頭。任務完成以後，向賽利斯塔茲回報。',
  }
},
[12419] = {
  {
    'O destino do Santuário Dragônico Rubi‡Судьба Рубинового святилища драконов‡Das Schicksal des Rubindrachenschreins‡루비 용제단의 최후‡El destino del Santuario de Dragones Rubí‡El destino del Santuario de Dragones Rubí‡Le destin du sanctuaire draconique rubis‡红玉巨龙圣地的命运‡晶紅龍殿的命運',
    nil,
    'Leve o Broche de Rubi de Dália Tocassol para Krasus, na Câmara do Conselho, que fica no Templo do Repouso das Serpes, e informe Krasus do destino de Dália.‡Принесите рубиновую брошь Далии Благословения Солнца Красу в чертог правящего Совета в Драконий Покой и расскажите ему о судьбе Далии.‡Bringt Dahlia Sonnenhands Rubinfibel zu Krasus in der Ratskammer im Wyrmruhtempel und berichtet ihm von Dahlias Schicksal.‡달리아 선터치의 루비 브로치를 고룡쉼터 사원의 연합 회의실에 있는 크라서스에게 전달하고 달리아에게 무슨 일이 있었는지 알려야 합니다.‡Lleva el broche de rubíes de Dahlia Toque Solar a Krasus en la Cámara del Consejo vigente en Reposo del Dragón e infórmale sobre el destino de Dahlia.‡Lleva el broche de rubíes de Dahlia Toque Solar a Krasus en la Cámara del Consejo vigente en Reposo del Dragón e infórmale sobre el destino de Dahlia.‡Apportez la Broche de rubis de Dahlia Soletouche à Krasus, dans la Chambre du Conseil régnant au Repos du ver, et informez-le du destin de Dahlia.‡将达莉亚的红玉胸针带回龙眠神殿的议会大厅交给克拉苏斯，并将她的命运告诉他。‡將妲莉雅·日觸的紅寶石胸針交給卡薩斯，並且通知他妲莉雅之死。卡薩斯就在龍眠神殿的統治會議室中。',
  }
},
[12420] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Larkin Cervaforte na Taberna Pedra de Fogo, em Altaforja.‡Отнесите членскую карточку "Лучшего пивовара месяца" Ларкину Громовару в таверну "Горючий камень" в Стальгорне.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Larkin Donnerbräu in der Steinfeuertaverne in Eisenschmiede.‡"맥주 사랑 동호회" 가입 신청서를 아이언포지의 부싯돌 선술집에 있는 라르킨 썬더브루에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Larkin Tonnebière à la taverne de Brûlepierre à Forgefer.‡将"本月美酒"俱乐部会员资料表交给铁炉堡石火旅店的拉尔金·雷酒。‡把「每月啤酒」俱樂部會員表格帶給拉金·雷酒，他就在鐵爐堡的石火旅店中。',
  }
},
[12421] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Ray\'ma na Salão Agulhas Negras, que fica no Vale dos Espíritos de Orgrimmar.‡Отнесите заполненную членскую карточку "Лучшего пивовара месяца" Рай\'ме в Пристанище Темнотерна. Оно находится в Оргриммаре, в Аллее Духов.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Ray\'ma in der Dunkeldornenlodge im Tal der Geister in Orgrimmar.‡"맥주 사랑 동호회" 가입 신청서를 오그리마 정기의 골짜기에 있는 검은장미 오두막의 레이마에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Ray\'ma en la Cabaña de Brezo en el Valle de los Espíritus de Orgrimmar.‡a Ray\'ma en Cabaña de Brezo en el Valle de los Espíritus de Orgrimmar."‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Ray\'ma au pavillon de Buissombre dans la vallée des Esprits d\'Orgrimmar.‡将"本月美酒"俱乐部会员资料表交给奥格瑞玛精神谷黑石南小屋的莱玛。‡帶著「每月啤酒」俱樂部會員表格交給雷瑪，他就在奧格瑪精神谷的暗木小屋裡。',
  }
},
[12422] = {
  {
    'Clemência tática‡Расчетливая доброта‡Scheinbegnadigung‡전략을 위한 자비‡Clemencia estratégica‡Clemencia estratégica‡Clémence tactique‡顺藤摸瓜‡戰術性赦免',
    nil,
    'Entregue a Carta de Anistia à Coureadora Capturada na Serra do Arroio Prateado.‡Отнесите приказ о помиловании пленному зверолову в Холмы Среброречья.‡Liefert den Begnadigungsbrief bei der gefangenen Fallenstellerin in den Silberwasserhügeln ab.‡사절의 편지를 은빛시내 마을 언덕에 있는 사로잡힌 덫사냥꾼에게 전달해야 합니다.‡Entrega la carta de amnistía a la trampera capturada en las Colinas de Arroyoplata.‡Entrega la carta de amnistía a la trampera capturada en las Colinas de Arroyoplata.‡Apportez la Lettre de grâce à la Trappeuse capturée dans les Collines de Ruissargent.‡带着特赦信前往银溪丘陵，将信交给被囚禁的猎户。‡把赦免信交給銀溪丘上被俘虜的陷捕者。',
  }
},
[12423] = {
  {
    'Diário de Mikhail‡Дневник Михаила‡Mikhails Tagebuch‡미크헤일의 일지‡El diario de Mikhail‡El diario de Mikhail‡Le journal de Mikhail‡米克哈尔的日记‡米克哈爾的日誌',
    nil,
    'Entregue o Diário de Mikhail à Conquistadora Krenna no Forte da Conquista.‡Отнесите дневник Михаила Завоевательнице Кренне в Крепость Завоевателей.‡Bringt Mikhails Tagebuch zu Eroberin Krenna in Burg Siegeswall.‡미크헤일의 일지를 정복의 요새에 있는 정복자 크레나에게 가져가야 합니다.‡Llévale el diario de Mikhail a la conquistadora Krenna en el Bastión de la Conquista.‡Llévale el diario de Mikhail a la conquistadora Krenna en el Bastión de la Conquista.‡Apportez le Journal de Mikhail à la Conquérante Krenna au Bastion de la Conquête.‡将米克哈尔的日记交给征服堡的征服者克雷娜。‡把米克哈爾的日誌帶去給征服堡的征服者克蓮娜。',
  }
},
[12424] = {
  {
    'Gorgonna‡Горгонна‡Gorgonna‡고르고나‡Gorgonna‡Gorgonna‡Gorgonna‡高戈娜‡高耿娜',
    nil,
    'Entregue o Diário de Mikhail a Gorgonna no Forte da Conquista.‡Отнесите дневник Михаила Горгонне в Крепость Завоевателей.‡Bringt Mikhails Tagebuch zu Gorgonna in Burg Siegeswall.‡미크헤일의 일지를 정복의 요새에 있는 고르고나에게 가져가야 합니다.‡Llévale el diario de Mikhail a Gorgonna en el Bastión de la Conquista.‡Llévale el diario de Mikhail a Gorgonna en el Bastión de la Conquista.‡Apportez le Journal de Mikhail à Gorgonna au Bastion de la Conquête.‡将米克哈尔的日记交给征服堡的高戈娜。‡把米克哈爾的日誌交給征服堡的高耿娜。',
  }
},
[12425] = {
  {
    'Ruuna, a Cega‡Рууна Слепая‡Ruuna die Blinde‡눈먼 루나‡Ruuna la Ciega‡Ruuna la Ciega‡Ruuna l\'Aveugle‡盲眼卢娜‡『瞎子』魯巫娜',
    nil,
    'Fale com Ruuna, a Cega, no Acampamento da Ruuna, perto do Desfiladeiro de Vordrassil.‡Поговорите с Рууной Слепой из Лагеря Рууны, что находится рядом с Перевалом Фордрассил.‡Sprecht mit Ruuna der Blinden in Ruunas Lager nahe dem Pass von Vordrassil.‡볼드랏실 고개 근처에 있는 루나의 야영지에서 눈먼 루나와 대화해야 합니다.‡Habla con Ruuna la Ciega en el Campamento de Ruuna cerca del Paso de Vordrassil.‡Habla con Ruuna la Ciega en el Campamento de Ruuna cerca del Paso de Vordrassil.‡Parlez à Ruuna l’Aveugle, au Camp de Ruuna, près de la Passe de Vordrassil.‡前往沃达希尔小径附近的卢娜的营地，与盲眼卢娜谈一谈。‡到沃達希爾小徑附近，魯巫娜的營地與『瞎子』魯巫娜交談。',
  }
},
[12426] = {
  {
    'DEPRECATED‡ИСКЛЮЧЕНО‡DEPRECATED‡미사용‡UNUSED Save Brewfest!‡DEPRECATED‡PÉRIMÉ‡DEPRECATED‡DEPRECATED',
    nil,
    nil,
  }
},
[12427] = {
  {
    'O Fosso da Conquista: luta livre ursina!‡Бойцовская яма: медвежьи бои!‡Die Siegeswallgrube: Bärenringen!‡정복의 요새 투기장: 곰 씨름!‡El Foso de la Conquista: ¡lucha de osos!‡El Foso de la Conquista: ¡lucha de osos!‡La fosse des Conquérants : face à un ours !‡征服斗兽场：斗熊！‡征服之淵:熊摔角!',
    nil,
    'Derrote Couro de Ferro dentro do Fosso da Conquista e fale com o Bookmaker Vel\'jan para ser recompensado.‡Одержите победу над Железной Шкурой в Бойцовской яме и вернитесь к букмекеру Вел\'джену за наградой.‡Besiegt Eisenbalg in der Siegeswallgrube und sprecht anschließend mit Buchmacher Vel\'jen, um eine Belohnung zu erhalten.‡정복의 요새 투기장에서 무쇠가죽과 싸워 이긴 후 사서 벨젠과 대화하여 보상을 받아야 합니다.‡Derrota a Pielférrea dentro del Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.‡Derrota a Pielférrea dentro del Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.‡Vainquez Cuiracier dans la fosse des Conquérants, puis parlez avec Vel\'jen la Paperasse pour obtenir votre récompense.‡击败征服斗兽场内的铁皮，然后找赌徒维尔金领取奖赏。‡在征服者之淵中擊敗鐵皮，然後找布齊·維爾占談話取得你的獎賞。',
  }
},
[12428] = {
  {
    'O Fosso da Conquista: pancadaria com pelursos doidos‡Бойцовская яма: битва с бешеным фурболгом‡Die Siegeswallgrube: Kampf gegen irren Furbolg‡정복의 요새 투기장: 미친 펄볼그 전투‡El Foso de la Conquista: lucha contra el fúrbolg loco‡El Foso de la Conquista: lucha contra el fúrbolg loco‡La fosse des Conquérants : le furbolg fou !‡征服斗兽场：疯狂的熊怪‡征服之淵:瘋熊怪之戰',
    nil,
    'Derrote Torgg Totem do Trovão dentro do Fosso da Conquista e fale com o Bookmaker Vel\'jan para ser recompensado.‡Одержите победу над Торггом Громовым Тотемом в Бойцовской яме, после чего поговорите с букмекером Вел\'дженом.‡Besiegt Torgg Donnertotem in der Siegeswallgrube und sprecht Buchmacher Vel\'jen auf eine Belohnung an.‡정복의 요새 투기장에서 토르그 썬더토템과 싸워 이긴 후, 사서 벨젠과 대화하여 보상을 받아야 합니다.‡Derrota a Torgg Tótem Relámpago en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Derrota a Torgg Tótem Relámpago en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Vainquez Torgg Totem-de-tonnerre dans la fosse des Conquérants, puis parlez avec Vel\'jen la Paperasse pour obtenir votre récompense.‡击败征服斗兽场内的托尔格·雷霆图腾，然后找赌徒维尔金领取奖赏。‡在征服之淵中擊敗托格·雷電圖騰，然後找布齊·維爾占談話取得你的獎賞。',
  }
},
[12429] = {
  {
    'O Fosso da Conquista: sangue e metal‡Бойцовская яма: кровь и железо‡Die Siegeswallgrube: Blut und Metall‡정복의 요새 투기장: 피와 철‡El Foso de la Conquista: sangre y metal‡El Foso de la Conquista: sangre y metal‡La fosse des Conquérants : sang et métal‡征服斗兽场：鲜血与金属‡征服之淵:鐵與血',
    nil,
    'Derrote Sangue de Ferrugem dentro do Fosso da Conquista e fale com o Bookmaker Vel\'jan para ser recompensado.‡Одержите победу над Кроворжавом в Бойцовской яме и вернитесь к букмекеру Вел\'джену за наградой.‡Besiegt Rostblut in der Siegeswallgrube und sprecht anschließend mit Buchmacher Vel\'jen, um eine Belohnung zu erhalten.‡정복의 요새 투기장에서 피녹빛파괴자와 싸워 이긴 후, 사서 벨젠과 대화하여 보상을 받아야 합니다.‡Derrota a Sangre Oxidada en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Derrota a Sangre Oxidada en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Vainquez Rouillesang dans la fosse des Conquérants, puis parlez avec Vel\'jen la Paperasse pour obtenir votre récompense.‡击败征服斗兽场内的锈血，然后找赌徒维尔金领取奖赏。‡在征服者之淵中擊敗鏽血，然後找布齊·維爾占談話取得你的獎賞。',
  }
},
[12430] = {
  {
    'O Fosso da Conquista: a morte é provável‡Бойцовская яма: смерть близка‡Die Siegeswallgrube: Der Tod ist wahrscheinlich‡정복의 요새 투기장: 죽음의 문턱‡El Foso de la Conquista: lo más probable es morir‡El Foso de la Conquista: lo más probable es morir‡La fosse des Conquérants : mort probable‡征服斗兽场：九死一生‡征服之淵:致死方休',
    nil,
    'Derrote Horgrenn Cutelaverno dentro do Fosso da Conquista e fale com o Bookmaker Vel\'jan para ser recompensado.‡Одержите победу над Хоргренном Страшным Расколом в Бойцовской яме и вернитесь к букмекеру Вел\'джену за наградой.‡Besiegt Horgrenn Höllspalter in der Siegeswallgrube und sprecht anschließend mit Buchmacher Vel\'jen, um eine Belohnung zu erhalten.‡정복의 요새 투기장에서 호르그렌 헬클리브와 싸워 이긴 후, 사서 벨젠과 대화하여 보상을 받아야 합니다.‡Derrota a Horgrenn Garra Infernal en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Derrota a Horgrenn Garra Infernal en el Foso de la Conquista y habla con el corredor Vel\'jen para conseguir una recompensa.|n‡Vainquez Horgrenn Tranchenfer dans la fosse des Conquérants, puis parlez avec Vel\'jen la Paperasse pour obtenir votre récompense.‡击败征服斗兽场内的霍尔格雷·地狱之斧，然后找赌徒维尔金领取奖赏。‡在征服之淵中擊敗霍葛倫·地獄斬，然後找布齊·維爾占談話取得你的獎賞。',
  }
},
[12431] = {
  {
    'O Fosso da Conquista: o confronto final‡Бойцовская яма: последняя битва‡Die Siegeswallgrube: Entscheidungskampf‡정복의 요새 투기장: 최종 결전‡El Foso de la Conquista: último combate‡El Foso de la Conquista: último combate‡La fosse des Conquérants : l\'affrontement final‡征服斗兽场：摊牌‡征服之淵:攤牌時刻',
    nil,
    'Derrote Krenna no Fosso da Conquista e fale com Gorgonna para receber sua recompensa.‡Одержите победу над Кренной в Бойцовской яме и обратитесь к Горгонне за наградой.‡Besiegt Krenna in der Siegeswallgrube und sprecht anschließend mit Gorgonna, um eine Belohnung zu erhalten.‡정복의 요새 투기장에서 크레나와 싸워 이긴 후, 고르고나와 대화하여 보상을 받아야 합니다.‡Derrota a Krenna en el Foso de la Conquista y habla con Gorgonna para conseguir una recompensa.‡Derrota a Krenna en el Foso de la Conquista y habla con Gorgonna para conseguir una recompensa.‡Vainquez Krenna dans la fosse des Conquérants, puis parlez avec Gorgonna pour obtenir votre récompense.‡击败征服斗兽场内的克雷娜，然后找高戈娜领取奖赏。‡在征服之淵中擊敗克蓮娜，然後和高耿娜談話取得你的獎賞。',
  }
},
[12432] = {
  {
    'Cavalgando o foguete vermelho‡Верхом на красной ракете‡Ritt auf der roten Rakete‡붉은 로켓을 타고‡Cabalgando sobre el cohete rojo‡Cabalgando sobre el cohete rojo‡À cheval sur la fusée…‡驾驶红色火箭‡乘著紅色火箭',
    nil,
    'O General Gorlok, no farol da Baía dos Empreendimentos, quer que você destrua o Navio de Lenha da Aliança.|n|nO General Gorlok só estará presente no farol enquanto este for controlado pela Horda.‡Генерал Горлок с маяка в Бухте торговцев приказал вам уничтожить грузовой корабль Альянса. |n|nГенерала Горлока можно застать только тогда, когда маяк находится под контролем Орды.‡General Gorlok im Leuchtturm in der Venturebucht möchte, dass Ihr den Holzfrachter der Allianz zerstört.|n|nGeneral Gorlok befindet sich nur dann im Leuchtturm, wenn sich dieser in Besitz der Horde befindet.‡투자개발 만의 등대에 있는 사령관 고를로크가 얼라이언스의 목재 선박을 파괴해 달라고 부탁했습니다.|n|n사령관 고를로크를 만나려면 호드가 등대를 점령해야 합니다.‡El general Gorlok en el faro de Bahía Ventura quiere que destruyas el barco de leña de la Alianza.|n|nEl general Gorlok solo estará presente en el faro cuando la Horda lo tenga en su posesión.‡El general Gorlok en el faro de Bahía Ventura quiere que destruyas el barco de leña de la Alianza.|n|nEl general Gorlok solo estará presente en el faro cuando la Horda lo tenga en su posesión.‡Le Général Gorlok, du phare de la Baie de la KapitalRisk, veut que vous détruisiez le Transport de bois de l’Alliance.|n|nLe général Gorlok n\'est présent au phare que si la Horde contrôle la baie.‡风险湾灯塔的高洛克将军希望你去摧毁联盟的木材运输船。|n|n只有在部落占领灯塔的时候，高洛克将军才会出现。‡風險海灣燈塔中的戈洛科將軍要你摧毀聯盟的運木船隻。|n|n戈洛科將軍只有當部落勢力拿下燈塔之後才會出現在該處。',
  }
},
[12433] = {
  {
    'Resolvendo o solvente‡В поисках растворителя‡Auf der Suche nach Lösungsmittel‡용해제를 찾아서‡Buscando disolvente‡Buscando disolvente‡La chasse au dissolvant‡寻找溶解剂‡尋找溶劑',
    nil,
    'Gurtor, na base da Horda da Baía dos Empreendimentos, quer que você lhe traga um bujão de Elemento 115.‡Гуртор из Торговой бухты Орды просит вас принести ему канистру с элементом 115.‡Gurtor in der Hordenbasis in der Venturebucht möchte, dass Ihr ihm einen Kanister Element 115 bringt.‡투자개발 만의 호드 기지에 있는 거트로가 원료 115 한 통을 가져다 달라고 부탁했습니다.‡Gurtor en la base de la Horda de Bahía Ventura quiere que le lleves un bote de Elemento 115.‡Gurtor en la base de la Horda de Bahía Ventura quiere que le lleves un bote de Elemento 115.‡Gurtor, de la base de la Horde de la Baie de la KapitalRisk, veut que vous lui rapportiez une boîte d’Élément 115.‡风险湾部落基地的古图尔要你取回一罐115号元素。‡風險海灣中，部落基地的葛特需要你帶一罐元素115給他。',
  }
},
[12434] = {
  {
    'Sempre resolvendo o solvente‡Растворитель всегда пригодится!‡Immer auf der Suche nach Lösungsmittel‡더 많은 용해제를 찾아서‡Siempre se busca disolvente‡Siempre se busca disolvente‡Le retour de la chasse au dissolvant‡继续寻找溶解剂‡總是在找溶劑',
    nil,
    nil,
  }
},
[12435] = {
  {
    'Apresente-se ao Lorde Devrestrasz.‡Явиться к лорду Деврестразу‡Erstattet Lord Devrestrasz Bericht‡군주 데브레스트라즈에게 보고‡Informa a lord Devrestrasz‡Informa a Lord Devrestrasz‡Rapport au seigneur Devrestrasz‡向德弗雷斯塔兹领主报到‡向戴伏斯塔茲領主回報',
    nil,
    'Fale com Lorde Devrestrasz no Templo do Repouso das Serpes.‡Поговорите с лордом Деврестразом в храме Драконьего Покоя.‡Sprecht mit Lord Devrestrasz im Wyrmruhtempel.‡고룡쉼터 사원에 있는 군주 데브레스트라즈와 대화해야 합니다.‡Habla con Lord Devrestrasz en el Templo del Reposo del Dragón.‡Habla con Lord Devrestrasz en el Templo del Reposo del Dragón.‡Parlez avec le seigneur Devrestrasz au Temple du Repos du ver.‡与龙眠神殿的德弗雷斯塔兹领主谈一谈。‡和龍眠神殿的戴伏斯塔茲領主交談。',
  }
},
[12436] = {
  {
    'Renda adicional‡Прибавка к зарплате‡Zusatzeinkommen‡은밀한 수입‡Beneficio adicional‡Beneficio adicional‡Un revenu supplémentaire‡赚外快‡額外收入',
    nil,
    'O Fornecedor Lorkran, no Forte da Conquista, quer que você obtenha 5 cortes de Carne Suculenta dos Cervo Altaste da região.‡Поставщик Лоркран из Крепости Завоевателей просит вас убить несколько высокорогих оленей и принести ему 5 кусков сочной оленины.‡Versorger Lorkran in Burg Siegeswall will, dass Ihr 5 saftige Wildbrete von Großhornhirschen in der Nähe besorgt.‡정복의 요새에 있는 배급원 로르크란이 근처에 있는 긴뿔 순록에게서 육즙이 많은 사슴 고기 5개를 가져다달라고 부탁했습니다.‡El Proveedor Lorkran en el Bastión de la Conquista quiere que consigas 5 venados suculentos de los venados cornaaltas cercanos.‡El Proveedor Lorkran en el Bastión de la Conquista quiere que consigas 5 venados suculentos de los venados Cornalta cercanos.‡L’Approvisionneur Lorkran, du Bastion de la Conquête, veut que vous récupériez 5 morceaux de Venaison succulente sur les Cerfs haute-ramure des alentours.‡征服堡的粮食商人洛克兰要求你从附近的耸角雄鹿身上采集5块肥美的鹿肉。‡征服堡的物資供應者羅克芮要你從附近的高角成鹿身上取來5塊多汁鹿肉。',
  }
},
[12437] = {
  {
    'Cavalgando o foguete vermelho‡Верхом на красной ракете‡Ritt auf der roten Rakete‡붉은 로켓을 타고‡Cabalgando sobre el cohete rojo‡Cabalgando sobre el cohete rojo‡À cheval sur la fusée…‡红色鱼雷‡乘著紅色火箭',
    nil,
    'O Comandante Howser, no farol da Baía dos Empreendimentos, quer que você destrua o carregamento de lenha da Horda.|n|nO Comandante Howser só estará presente no farol enquanto este for controlado pela Aliança.‡Командир Хоузер с маяка Бухты торговцев поручил вам уничтожить грузовой корабль Орды.|n|nКомандира Хоузера можно застать только тогда, когда маяк находится под контролем Альянса.‡Kommandant Hauser im Leuchtturm in der Venturebucht möchte, dass Ihr den Holzfrachter der Horde zerstört.|n|nKommandant Hauser befindet sich nur dann im Leuchtturm, wenn sich dieser im Besitz der Allianz befindet.‡투자개발 만의 등대에 있는 사령관 하우저가 호드의 목재 선박을 파괴해 달라고 부탁했습니다.|n|n사령관 하우저를 만나려면 얼라이언스가 등대를 점령해야 합니다.‡El comandante Howser en el faro de Bahía Ventura quiere que destruyas el envío de madera de la Horda.|n|nEl comandante Howser solo estará presente en el faro cuando la Alianza esté en su posesión.‡El comandante Howser en el faro de Bahía Ventura quiere que destruyas el envío de madera de la Horda.|n|nEl comandante Howser solo estará presente en el faro cuando la Alianza esté en su posesión.‡Le Commandant Howser, du phare de la Baie de la KapitalRisk, veut que vous couliez le chargement de bois de la Horde.|n|nLe Commandant Howser n\'est présent au phare que lorsque celui-ci est aux mains de l’Alliance.‡风险湾灯塔的霍瑟尔司令希望你去摧毁部落的木材运输船。|n|n只有在联盟占领灯塔的时候，霍瑟尔司令才会出现。‡風險海灣燈塔的指揮官豪瑟需要你摧毀部落的運木船隻。|n|n指揮官豪瑟只有當聯盟勢力拿下燈塔之後才會出現。',
  }
},
[12438] = {
  {
    'Procura-se: Kreug Quebrajura‡Разыскивается: Креуг Клятвопреступник‡GESUCHT: Kreug Eidbrecher‡현상 수배: 크루그 오스브레이커‡Se busca: Kreug Rompejuramentos‡Se busca: Kreug Rompejuramentos‡On recherche : Kreug le Parjure‡悬赏：克留格·碎誓者‡懸賞:克羅格·毀誓者',
    nil,
    'Mate Kreug Quebrajura e fale novamente com o Grão-lorde Leoric von Zeldig, na Bastilha Invergarde, que fica no Ermo das Serpes, para receber a recompensa.‡Убейте Креуга Клятвопреступника и возвращайтесь за наградой к верховному лорду Леорику фон Цельдигу в крепость Стражей Зимы на Драконьем Погосте.‡Tötet Kreug Eidbrecher und kehrt zu Hochlord Leoric von Zeldig in der Feste Wintergarde in der Drachenöde zurück, um dort Eure Belohnung abzuholen.‡크루그 오스브레이커를 처치한 다음 용의 안식처에 있는 윈터가드 성채의 대영주 레오릭 본 젤디그에게 돌아가 보상을 받아야 합니다.‡Mata a Kreug Rompejuramentos y vuelve con el alto señor Leoric Von Zeldig a la Fortaleza de Hibergarde en el Cementerio de los Dragones para recoger tu recompensa.‡Mata a Kreug Rompejuramentos y vuelve con el alto señor Leoric Von Zeldig a la Fortaleza de Hibergarde en el Cementerio de los Dragones para recoger tu recompensa.‡Tuez Kreug le Parjure, puis allez voir le Généralissime Leoric von Zeldig au Donjon de Garde-hiver dans la Désolation des dragons pour toucher votre récompense.‡杀死克留格·碎誓者，然后前往龙骨荒野的暮冬要塞，向李奥瑞克·冯·泽尔迪格公爵领取奖赏。‡殺死克羅格·毀誓者，然後向大領主李奧瑞克·馮·澤爾迪格領取賞金，他就在龍骨荒野的溫特加德要塞。',
  }
},
[12439] = {
  {
    'Um distúrbio no oeste‡Проблемы на западе‡Erschütterung im Westen‡서쪽의 소란‡Una anomalía al Oeste‡Una anomalía al Oeste‡Une perturbation à l\'ouest‡西部的扰动‡來自西方的波動',
    nil,
    'Fale com Rodney Poços na Bastilha Invergarde para conseguir um voo para o Recanto das Estrelas, na parte oeste do Ermo das Serpes.‡Поговорите с Родни Веллсом в крепости Стражей Зимы, чтобы отправиться в Покой Звезд в западном Драконьем Погосте.‡Sprecht mit Rodney Wells in der Feste Wintergarde zwecks eines Ritts nach Sternenruh im Westen der Drachöde.‡윈터가드 성채에 있는 로드니 웰스와 이야기해 용의 안식처 서부에 있는 별의 쉼터로 가야 합니다.‡Habla con Rodney Wells en la Fortaleza de Hibergarde para reservar un viaje hasta Reposo Estelar al oeste del Cementerio de Dragones.‡Habla con Rodney Wells en la Fortaleza de Hibergarde para reservar un viaje hasta Reposo Estelar al oeste del Cementerio de Dragones.‡Parlez à Rodney Wells au Donjon de Garde-hiver pour prendre un vol à destination du Repos des étoiles, dans l’ouest de la Désolation des dragons.‡去和暮冬要塞的罗尼·威尔斯谈一谈，向他要一头坐骑，前往龙骨荒野西部的群星之墓。‡與溫特加德要塞中，獅鷲站的羅德尼·威爾斯交談，並前往龍骨荒野西方的繁星之眠。',
  }
},
[12440] = {
  {
    'Para o Recanto das Estrelas!‡В Покой Звезд!‡Nach Sternenruh!‡별의 쉼터로‡¡A Reposo Estelar!‡¡A Reposo Estelar!‡En route pour le Repos des étoiles !‡前往群星之墓！‡前去繁星之眠!',
    nil,
    'Fale com a Imagem da Arquimaga Modera no Recanto das Estrelas, a oeste do Ermo das Serpes.‡Поговорите с проекцией верховного мага Модеры в Покое Звезд в западной части Драконьего Погоста.‡Sprecht mit dem Abbild der Erzmagierin Modera in Sternenruh im Westen der Drachenöde.‡용의 안식처 서부에 있는 별의 쉼터에서 대마법사 모데라의 환영과 대화해야 합니다.‡Habla con la imagen de la archimaga Modera en Reposo Estelar al oeste del Cementerio de Dragones.|n‡Habla con la imagen de la archimaga Modera en Reposo Estelar al oeste del Cementerio de Dragones.|n‡Parlez à l’Image de l’archimage Modera, au Repos des étoiles, dans l’ouest de la Désolation des dragons.‡前往龙骨荒野西部的群星之墓，与大法师茉德拉的影像谈一谈。‡與大法師莫德菈交談，他就在龍骨荒野西側的繁星之眠中。',
  }
},
[12441] = {
  {
    'Procura-se: Sumo Xamã Patassangre‡Разыскивается: верховный шаман Кровохват‡GESUCHT: Hochschamane Blutpfote‡현상 수배: 고위주술사 블러드포‡Se busca: Alto chamán Patasangre‡Se busca: Alto chamán Patasangre‡On recherche : le Grand chaman Sangrepatte‡通缉：高阶萨满祭司德金·血爪‡懸賞:高階薩滿血掌',
    nil,
    'Mate o Sumo Xamã Patassangre e fale novamente com o Grão-lorde Leoric von Zeldig, na Bastilha Invergarde, que fica no Ermo das Serpes, para receber a recompensa.‡Убейте верховного шамана Кровохвата и приходите за наградой к верховному лорду Леорику фон Цельдигу в крепость Стражей Зимы на Драконьем Погосте.‡Tötet Hochschamane Blutpfote und kehrt anschließend zu Hochlord Leoric von Zeldig in Wintergarde in der Drachenöde zurück, um Eure Belohnung abzuholen.‡고위주술사 블러드포를 처치한 다음 용의 안식처에 있는 윈터가드 성채의 대영주 레오릭 본 젤디그에게 돌아가 보상을 받아야 합니다.‡Mata al alto chamán Patasangre y vuelve con el alto señor Leoric Von Zeldig a la Fortaleza de Hibergarde en el Cementerio de los Dragones para recoger tu recompensa.‡Mata al alto chamán Patasangre y vuelve con el alto señor Leoric Von Zeldig a la Fortaleza de Hibergarde en el Cementerio de los Dragones para recoger tu recompensa.‡Tuez le Grand chaman Sangrepatte, puis allez voir le Généralissime Leoric von Zeldig au Donjon de Garde-hiver dans la Désolation des dragons pour toucher votre récompense.‡杀死高阶萨满祭司德金·血爪，然后前往龙骨荒野的暮冬要塞，找李奥瑞克·冯·泽尔迪格公爵领取奖赏。‡殺掉高階薩滿血掌，並回報給大領主李奧瑞克·馮·澤爾迪格以獲取你的獎賞;他就在龍骨荒野上的溫特加德要塞裡。',
  }
},
[12442] = {
  {
    'Procura-se: Comandante da Ofensiva Justus‡Разыскивается: командир Алого Натиска Иустус‡GESUCHT: Ansturmkommandant Iustus‡현상 수배: 붉은돌격대 사령관 이우스투스‡Se busca: Comandante del Embate Iustus‡Se busca: Comandante del Embate Iustus‡On recherche : le commandant de l\'Assaut Iustus‡悬赏：先锋军指挥官尤斯图斯‡懸賞:突襲軍指揮官艾尤圖斯',
    nil,
    'Mate o Comandante da Ofensiva Justus e fale novamente com o Grão-lorde Leoric von Zeldig, na Bastilha Invergarde, que fica no Ermo das Serpes, para receber a recompensa.‡Убейте командира Алого Натиска Иустуса и возвращайтесь к верховному лорду Леорику фон Цельдигу в крепости Стражей Зимы в Драконьем Погосте, чтобы получить награду.‡Tötet den Ansturmkommandanten Iustus und kehrt anschließend zu Hochlord Leoric von Zeldig in Wintergarde in der Drachenöde zurück, um Eure Belohnung abzuholen.‡붉은돌격대 사령관 이우스투스를 처치한 다음 용의 안식처에 있는 윈터가드 성채의 대영주 레오릭 본 젤디그에게 돌아가 보상을 받아야 합니다.‡Mata al Comandante del Embate Iustus y vuelve a ver al alto señor Leoric Von Zeldig en la Fortaleza de Hibergarde del Cementerio de Dragones para recoger tu recompensa.|n‡Mata al Comandante del Embate Iustus y vuelve a ver al alto señor Leoric Von Zeldig en la Fortaleza de Hibergarde del Cementerio de Dragones para recoger tu recompensa.|n‡Tuez le Commandant de l\'Assaut Iustus, puis allez voir le Généralissime Leoric von Zeldig au Donjon de Garde-hiver dans la Désolation des dragons pour toucher votre récompense.‡杀死先锋军指挥官尤斯图斯，然后前往龙骨荒野的暮冬要塞，向李奥瑞克·冯·泽尔迪格公爵领取奖赏。‡殺掉突襲軍指揮官艾尤圖斯，並回報給大領主李奧瑞克·馮·澤爾迪格以獲取你的獎賞;他就在龍骨荒野上的溫特加德要塞裡。',
  }
},
[12443] = {
  {
    'Resolvendo o solvente‡В поисках растворителя‡Auf der Suche nach Lösungsmittel‡용해제를 찾아서‡Buscando disolvente‡Buscando disolvente‡La chasse au dissolvant‡寻找溶解剂‡尋找溶劑',
    nil,
    'O Finquestilha, da base da Aliança na Baía dos Empreendimentos, quer que você lhe traga um bujão de Elemento 115.‡Барблфинк с Базы Альянса просит вас принести ему канистру с элементом 115.‡Barbelfink in der Allianzbasis in der Venturebucht möchte, dass Ihr ihm einen Kanister Element 115 bringt.‡투자개발 만의 얼라이언스 기지에 있는 바블핑크가 원료 115 한 통을 가져다 달라고 부탁했습니다.‡Barboesquirol en la base Alianza en Bahía Ventura quiere que le lleves un bote de Elemento 115.‡Barboesquirol en la base Alianza en Bahía Ventura quiere que le lleves un bote de Elemento 115.‡Barbillonneur, de la base de l\'Alliance de la Baie de la KapitalRisk, veut que vous lui rapportiez une boîte d’Élément 115.‡风险湾联盟基地的巴布芬克要你取回一罐115号元素。‡風險海灣中，聯盟基地的巴爾玻芬克需要你帶一罐元素115給他。',
  }
},
[12444] = {
  {
    'Escaramuça no Rio Negro‡Резня в Черноречье‡Gemetzel am Schwarzwasser‡검은강 쟁탈전‡Escaramuza en Río Negro‡Escaramuza en Río Negro‡Escarmouches sur la rivière Noire‡黑水伐木场的战斗‡黑河前哨戰',
    nil,
    'A Capitão dos Batedores Carter quer que você derrote 10 unidades ou jogadores da Horda na Madeireira Rio Negro.‡Капитан разведчиков Картер просит вас убить 10 представителей или игроков Орды на Лесопилке Черноречья.‡Feldspäherhauptmann Carter möchte, dass Ihr 10 Einheiten oder Spieler der Horde im Holzfällerlager Schwarzwasser tötet.‡정찰대장 카터가 검은강 벌목지에서 호드 병사 또는 전투원 10명을 처치해 달라고 부탁했습니다.‡La capitana de exploradores Carter quiere que mates a 10 unidades o jugadores de la Horda en el Aserradero Río Negro.‡La capitana de exploradores Carter quiere que mates a 10 unidades o jugadores de la Horda en el Aserradero Río Negro.‡Le Capitaine des éclaireurs Carter veut que vous tuiez 10 unités ou personnages-joueurs de la Horde au Camp de bûcherons de la rivière Noire.‡斥候队长卡特尔希望你在黑水伐木场击杀10名部落士兵或者玩家。‡斥候隊長卡特需要你去黑河伐木營地殺死10名部落成員或玩家。',
  }
},
[12446] = {
  {
    'Sempre resolvendo o solvente‡Растворитель всегда пригодится!‡Immer auf der Suche nach Lösungsmittel‡더 많은 용해제를 찾아서‡Siempre se busca disolvente‡Siempre se busca disolvente‡Le retour de la chasse au dissolvant‡继续寻找溶解剂‡總是在找溶劑',
    nil,
    nil,
  }
},
[12447] = {
  {
    'O Santuário Dragônico Obsidiano‡Обсидиановое святилище драконов‡Der Obsidiandrachenschrein‡흑요석 용제단‡El Santuario de Dragones Obsidiana‡El Santuario de Dragones Obsidiana‡Le Sanctuaire draconique obsidien‡黑曜石巨龙圣地‡黑曜龍殿',
    nil,
    'Vá para o Santuário Dragônico Obsidiano, a Noroeste do Templo do Repouso das Serpes, e a Oeste do Portão da Ira. Encontre Serinar dentro do santuário e lhe ofereça ajuda.‡Отправляйтесь в Обсидиановое святилище драконов к северо-западу от Драконьего Покоя, совсем рядом с Вратами Гнева. Найдите в святилище Серинара и предложите ему свою помощь.‡Reist zum Obsidiandrachenschrein nordwestlich des Wyrmruhtempels und gleich westlich der Pforte des Zorns. Sucht im Inneren des Schreins nach Serinar und bietet ihm Eure Hilfe an.‡고룡쉼터 사원의 북서쪽이자 분노의 관문 서쪽에 있는 흑요석 용제단으로 이동해, 제단 안에 있는 세린나를 찾아 도움을 줘야 합니다.‡Viaja hasta el Santuario de Dragones Obsidiana al noroeste de Reposo del Dragón y al oeste inmediato de la Puerta de Cólera. Encuentra a Serinar dentro del santuario y ofrécele tu ayuda.‡Viaja hasta el Santuario de Dragones Obsidiana al noroeste de Reposo del Dragón y al oeste inmediato de la Puerta de Cólera. Encuentra a Serinar dentro del santuario y ofrécele tu ayuda.‡Allez au Sanctuaire draconique obsidien au nord-ouest du Repos du ver et juste à l\'ouest du Portail du Courroux. Retrouvez-y Sérinar et proposez-lui votre aide.‡前往位于龙眠神殿西北方、天谴之门正西方的黑曜石巨龙圣地，找到瑟里纳尔并帮助他。‡前往龍眠神殿西北方、憤怒之門正西方的黑曜龍殿。到龍殿中找賽瑞納爾，並提供你的協助。',
  }
},
[12448] = {
  {
    'Prova de fogo‡Горячая битва‡In der Hitze des Gefechts‡치열한 전투‡Una batalla acalorada‡Una batalla acalorada‡Bataille ardente‡白热化的战斗‡戰火升溫',
    nil,
    'Ajude o Capitão Drayzen a manter posição nos desfiladeiros, participando da morte de 12 Carniçais Frígidos Atacantes, 8 Geists Frígidos Atacantes e 1 Abominação Frígida Atacante.|n|nFale novamente com Vargastrasz quando tiver cumprido a tarefa.‡Помогите капитану Дрейзену удержать каньоны, приняв участие в смерти 12 хладных атакующих вурдалаков, 8 хладных атакующих упырей и 1 хладного атакующего поганища.|n|nКогда это будет выполнено, возвращайтесь к Варгастразу.‡Unterstützt Hauptmann Drayzen, die Canyons zu halten. Tötet 12 eisige Ghulangreifer, 8 eisige Spukangreifer und 1 eisigen Monstrositätenangreifer.|n|nKehrt zu Vargastrasz zurück, sobald die Aufgabe abgeschlossen ist.‡얼어붙은 구울 돌격병 12마리, 얼어붙은 외눈깨비 돌격병 8마리, 얼어붙은 누더기골렘 돌격병 1마리를 처치하여 협곡을 방어하는 부대장 이스칸다르를 지원하고 임무를 마치면 바르가스트라즈에게 돌아가야 합니다.‡Ayuda al capitán Drayzen en la resistencia en los cañones ayudando a matar a 12 agresores necrófagos gélidos, 8 agresores geists gélidos y 1 agresor abominación gélida.|n|nVuelve junto a Vargastrasz cuando hayas terminado esta tarea.‡Ayuda al capitán Drayzen en la resistencia en los cañones ayudando a matar a 12 agresores necrófagos gélidos, 8 agresores geists gélidos y 1 agresor abominación gélida.|n|nVuelve junto a Vargastrasz cuando hayas terminado esta tarea.‡Aidez le Capitaine Drayzen à tenir les canyons en participant à la mort de 12 Goules algides attaquantes, 8 Geists algides attaquants et 1 Abomination algide attaquante. Retournez auprès de Vargastrasz une fois cette tâche terminée.‡杀死12个进攻的冰冷食尸鬼、8个进攻的冰冷恶鬼和1个进攻的冰冷憎恶，帮助德雷森上尉守住峡谷。完成任务后向瓦加斯塔兹复命。‡幫助德拉森隊長守護山谷，擊敗12隻嚴寒食屍鬼攻擊者、8隻嚴寒魂屍攻擊者，以及1隻嚴寒憎惡體攻擊者。事成以後，向凡加斯塔茲回報。',
  }
},
[12449] = {
  {
    'À terra voltarás‡Погребение‡Zur Erde zurückkehren‡대지의 품으로‡Regresa a la tierra‡Regresa a la tierra‡Retourner à la terre‡重归尘土‡回歸大地',
    nil,
    'Entre no Santuário Dragônico Rubi pela passagem ao sul e procure por Bolotas-rubi. Use as bolotas-rubi nos dragões vermelhos caídos para fazer com que seus corpos retornem à terra. Fale novamente com Vargastrasz quando completar a tarefa.‡Отправляйтесь в Рубиновое святилище драконов через южный проход и поищите там рубиновые желуди. С помощью рубиновых желудей предайте тела павших красных драконов земле. По выполнении задания вернитесь к Варгастразу.‡Betretet den Schrein durch den südlichen Pass und sucht nach Rubineicheln. Benutzt die Rubineicheln nahe den gefallenen roten Drachen, um ihre Körper zur Erde zurückkehren zu lassen. Kehrt zu Vargastrasz zurück, sobald die Aufgabe abgeschlossen ist.‡남쪽 통로를 이용하여 루비 용제단에 들어간 다음 루비 도토리를 찾으십시오. 죽은 붉은용에게 루비 도토리를 사용해 대지의 품으로 돌려보낸 후 바르가스트라즈에게 돌아가야 합니다.‡Entra al Santuario de Dragones Rubí a través del puerto sur y busca bellotas rubís. Utiliza las bellotas rubís con los dragones rojos caídos y devuelve sus cuerpos a la tierra. Vuelve junto a Vargastrasz cuando esta tarea esté terminada.‡Entra al Santuario de Dragones Rubí a través del puerto sur y busca bellotas rubís. Utiliza las bellotas rubís con los dragones rojos caídos y devuelve sus cuerpos a la tierra. Vuelve junto a Vargastrasz cuando esta tarea esté terminada.‡Pénétrez dans le Sanctuaire draconique rubis par le passage sud et cherchez les Glands de rubis. Utilisez les Glands de rubis sur les dragons rouges décédés pour ramener leur corps à la vie. Retournez auprès de Vargastrasz une fois la tâche accomplie.‡从南面的小路进入红玉巨龙圣地并寻找红玉橡果。对死去的红龙使用红玉橡果，让他们的尸体回归大地。完成任务后向瓦加斯塔兹复命。‡從南方的通道進入晶紅龍殿，尋找晶紅橡實。對戰死的紅龍使用晶紅橡實，使他們的軀體回歸大地。任務完成以後，向凡加斯塔茲回報。',
  }
},
[12450] = {
  {
    'Por campos de fogo‡Через огненные поля‡Durch das Feuer‡불타는 벌판을 지나‡A través de tierras en llamas‡A través de tierras en llamas‡À travers les champs de flammes‡烈焰之地‡走過燃燒之境',
    nil,
    'Entre no Santuário Dragônico Rubi pela passagem sul, mate 6 Necromantes Frígidos e elimine a fonte de corrupção sob o santuário. Fale novamente com Vargastrasz quando completar a tarefa.‡Отправляйтесь в Рубиновое святилище драконов через южный проход, затем убейте 6 хладных некромантов и уничтожьте источник осквернения, находящийся под святилищем. По выполнении задания вернитесь к Варгастразу.‡Betretet den Schrein durch den südlichen Pass, tötet dann 6 eisige Nekromanten und eliminiert den Quell der Verderbnis unter dem Schrein. Kehrt zu Vargastrasz zurück, sobald die Aufgabe abgeschlossen ist.‡남쪽 통로를 이용하여 루비 용제단에 들어간 다음 얼어붙은 강령술사 6명을 처치하고 제단 아래에 있는 타락의 근원을 제거한 후 바르가스트라즈에게 돌아가야 합니다.‡Entra al Santuario de Dragones Rubí a través del puerto sur, mata a 6 nigromantes gélidos y erradica el origen de la corrupción en el santuario. Vuelve junto a Vargastrasz cuando esta tarea esté terminada.‡Entra al Santuario de Dragones Rubí a través del puerto sur, mata a 6 nigromantes gélidos y erradica el origen de la corrupción en el santuario. Vuelve junto a Vargastrasz cuando esta tarea esté terminada.‡Entrez dans le Sanctuaire draconique rubis par la passe du sud, tuez 6 Nécromanciens algides et éliminez la source de la corruption sous le sanctuaire. Retournez voir Vargastrasz une fois votre tâche accomplie.‡从南面的小路进入红玉巨龙圣地，杀死6个冰冷通灵师并摧毁圣地下面的堕落之源。完成任务后向瓦加斯塔兹复命。‡從南方的通道進入晶紅龍殿，並殺死6名嚴寒死靈法師，同時消滅神殿下方腐化的源頭。任務完成以後，向凡加斯塔茲回報。',
  }
},
[12451] = {
  {
    'Rumo à Aldeia Oneqwah‡Вперед, в Лагерь Уанква‡Weiter nach Camp Oneqwah‡원크와 야영지로‡Hacia el Campamento Oneqwah‡Hacia el Campamento Oneqwah‡En route pour le camp Oneqwah‡前往欧尼瓦营地‡前往歐尼克瓦營地',
    nil,
    'Fale com Batedor Vor\'takh na Aldeia Oneqwah.‡Поговорите с разведчиком Вор\'такхом в Лагере Уанква.‡Sprecht mit Späher Vor\'takh im Camp Oneqwah.‡원크와 야영지에 있는 척후병 보르타크와 대화해야 합니다.‡Habla con el Explorador Vor\'takh en el Campamento Oneqwah.‡Habla con el Explorador Vor\'takh en el Campamento Oneqwah.‡Parlez à l\'Éclaireur Vor\'takh au Camp Oneqwah.‡与欧尼瓦营地的斥候沃塔肯谈一谈。‡和歐尼克瓦營地的斥候沃塔克交談。',
  }
},
[12452] = {
  {
    'zzOLD The Fate of the Ruby Dragonshrine‡zzOLD Судьба рубинового святилища драконов‡zzOLD The Fate of the Ruby Dragonshrine‡zzOLD The Fate of the Ruby Dragonshrine‡zzOLD El destino del Santuario de Dragones Rubí‡zzOLD El destino del Santuario de Dragones Rubí‡zzOLD The Fate of the Ruby Dragonshrine‡zzOLD The Fate of the Ruby Dragonshrine‡zzOLD晶紅龍殿的命運',
    nil,
    'Bring Dahlia\'s Ruby Broach to Ceristrasz and inform him of her fate.‡Принесите Церистразу рубиновую брошь Далии и расскажите ему о ее судьбе.‡Bringt Dahlias Rubinfibel zu Ceristrasz und erzählt ihm von ihrem Schicksal.‡Bring Dahlia\'s Ruby Broach to Ceristrasz and inform him of her fate.‡Lleva el broche de rubíes de Dahlia a Ceristrasz e infórmale sobre su destino.‡Lleva el broche de rubíes de Dahlia a Ceristrasz e infórmale sobre su destino.‡Apportez la Broche de rubis de Dahlia à Ceristrasz, et racontez-lui son destin.‡Bring Dahlia\'s Ruby Broach to Ceristrasz and inform him of her fate.‡將妲莉雅的紅寶石墜飾交給賽利斯塔茲，並將妲莉雅之死告訴他。',
  }
},
[12453] = {
  {
    'Olhos alados‡Взгляд с высоты‡Der Himmel hat Augen‡하늘의 눈‡Ojos en el cielo‡Ojos en el cielo‡Vu d\'en haut‡白肩鹰的眼睛‡上空的窺伺',
    nil,
    'A Vidente Chifre Cinzento quer que você use a Pena de Prata em 6 Águias Imperiais na Serra Gris.‡Заклинательница ветра Серый Рог просит вас коснуться серебряным пером шести императорских орлов в Седых холмах.‡Windseherin Grauhorn möchte, dass Ihr die silberne Feder auf 6 Kaiseradler in den Grizzlyhügeln anwendet.‡바람현자 그레이혼이 회색 구릉지에 있는 흰죽지수리 6마리에게 은빛 깃털을 사용해 달라고 부탁했습니다.‡La vidente del viento Cuerno Gris quiere que uses la Pluma de plata con 6 águilas imperiales de las Colinas Pardas.‡La vidente del viento Cuerno Gris quiere que uses la Pluma de plata con 6 águilas imperiales de las Colinas Pardas.‡La Voyante des vents Corne-grise veut que vous utilisiez la Plume argentée sur 6 Aigles impériaux dans les Grisonnes.‡风之先知希尔·灰角希望你在灰熊丘陵的6只白肩鹰身上使用银色羽毛。‡風先知灰角要你在6隻灰白之丘的帝王雄鷹身上使用銀羽。',
  }
},
[12454] = {
  {
    'O ciclo da vida‡Жизненный цикл‡Kreislauf des Lebens‡생명의 순환‡El ciclo de la vida‡El ciclo de la vida‡Le cycle de la vie‡生命的循环‡生命的循環',
    nil,
    'Nishera, a Guardiã do Jardim, no Santuário Dragônico Esmeralda, quer que você mate 5 Garraéreas Esmeralda.‡По просьбе Нишеры Хранительницы Садов из изумрудного святилища драконов убейте 5 изумрудных небесных когтей.‡Nishera die Gartenbewahrerin im Smaragddrachenschrein möchte, dass Ihr 5 Smaragdhimmelsklauen niederstreckt.‡에메랄드 용제단에 있는 정원의 수호자 니셰라가 에메랄드 하늘발톱 5마리를 처치해 달라고 부탁했습니다.‡Nishera la Jardinera en el Santuario de Dragones Esmeralda te ha pedido que mates a 5 Garfacielos esmeralda.‡Nishera la Jardinera en el Santuario de Dragones Esmeralda te ha pedido que mates a 5 Garfacielos esmeralda.‡Nishera la Gardienne du jardin au Sanctuaire draconique émeraude vous a demandé de tuer 5 Serres-du-ciel émeraudes.‡翡翠巨龙圣地的护园者尼瑟拉要你去杀死5只翡翠天爪枭。‡翡翠龍殿的『花園看守者』尼夏拉請求你殺死5頭翡翠天爪。',
  }
},
[12455] = {
  {
    'Espalhada ao vento‡Унесенные ветром‡In alle Winde verstreut‡바람 속에 흩어지다‡Esparcidos por los aires‡Esparcidos por los aires‡Dispersées aux quatre vents‡随风散落‡隨風而逝',
    nil,
    'Amgo Cash, no Mausoléu Invergarde, no Ermo das Serpes. quer que você recupere 8 Peças de Munição de Invergarde.‡По поручению Амбо Кэша из усыпальницы Стражей Зимы соберите 8 ящиков снаряжения Стражей Зимы.‡Ambo Unkesch im Mausoleum von Wintergarde in der Drachenöde möchte, dass Ihr 8 Munitionskisten von Wintergarde beschafft.‡용의 안식처에 있는 윈터가드 묘지의 앰보 캐시가 윈터가드 군수품 8개를 가져와 달라고 부탁했습니다.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere que recuperes 8 municiones de Hibergarde.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere que recuperes 8 municiones de Hibergarde.‡Ambo Cash, du Mausolée de Garde-hiver dans la Désolation des dragons, veut que vous récupériez 8 Caisses de munitions de Garde-hiver.‡龙骨荒野暮冬陵园的阿姆博·卡什要你取回8箱暮冬军需品。‡龍骨荒野，溫特加德墓塚中的安柏·凱許需要你拿回8件溫特加德軍火。',
  }
},
[12456] = {
  {
    'A pena de Alystros‡Перо Алистоса‡Der Federschmuck von Alystros‡알리스트로스의 깃털‡La pluma de Alystros‡La pluma de Alystros‡La plume d\'Alystros‡奥雷托斯的羽毛‡艾里史卓斯的長羽',
    nil,
    'Nishera, a Guardiã do Jardim, no Santuário Dragônico Esmeralda, quer que você consiga a Pena de Alystros.‡Добудьте и принесите Нишере Хранительнице Садов в Изумрудное святилище драконов перо Алистоса.‡Nishera die Gartenbewahrerin im Smaragddrachenschrein möchte, dass Ihr den Federschmuck von Alystros beschafft.‡에메랄드 용제단의 정원의 수호자 니셰라가 알리스트로스의 깃털을 가져다 달라고 부탁했습니다.‡Nishera la Jardinera en el Santuario de Dragones Esmeralda te ha pedido que consigas la pluma de Alystros.‡Nishera la Jardinera en el Santuario de Dragones Esmeralda te ha pedido que consigas la pluma de Alystros.‡Nishera la Gardienne du jardin au Sanctuaire draconique émeraude vous a demandé d\'obtenir La plume d\'Alystros.‡翡翠巨龙圣地的护园者尼瑟拉要你取得奥雷托斯的羽毛。‡翡翠龍殿的『花園看守者』尼夏拉要求你取得艾里史卓斯的長羽。',
  }
},
[12457] = {
  {
    'Seu canhão e você‡Ты и пушка‡Die Maschinenkanone und du‡퇴로를 뚫어라‡La ametralladora y tú‡La ametralladora y tú‡Votre amie, la mitrailleuse‡重机枪与你‡鏈砲與你',
    nil,
    'Amgo Cash, no Mausoléu Invergarde, no Ermo das Serpes. quer que você salve 8 Soldados da 7ª Legião Feridos.‡Спасите 8 раненых солдат 7-го легиона по просьбе Амбо Кэша из усыпальницы Стражей Зимы в Драконьем Погосте.‡Ambo Unkesch im Mausoleum von Wintergarde in der Drachenöde möchte, dass Ihr 8 verletzte Soldaten der 7. Legion rettet.‡용의 안식처에 있는 윈터가드 묘지의 앰보 캐시가 부상당한 7군단 병사 8명을 구조해 달라고 부탁했습니다.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere salves a 8 soldados de la Séptima Legión heridos.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere salves a 8 soldados de la Séptima Legión heridos.‡Ambo Cash, du Mausolée de Garde-hiver dans la Désolation des dragons, veut que vous sauviez 8 Soldats blessés de la 7e Légion.‡龙骨荒野暮冬陵园的阿姆博·卡什要你营救8名受伤的第七军团士兵。‡龍骨荒野，溫特加德墓塚中的安柏·凱許要你援救8名受傷的第七軍團士兵。',
  }
},
[12458] = {
  {
    'Sementes de açoitadeira‡Семена плеточника‡Samen der Peitscher‡덩굴손 씨앗‡Semillas de los azotadores‡Semillas de los azotadores‡Des graines de flagellant‡鞭笞者的种子‡鞭笞者之種',
    nil,
    'Lorde Itharius, no topo do Templo do Repouso das Serpes, quer que você consiga 3 Sementes de Açoitadeira.‡Принесите 3 семени плеточника лорду Итару на вершине храма Драконьего Покоя.‡Lord Itharius in der Spitze des Wyrmruhtempels möchte, dass Ihr 3 Peitschersamen zu ihm zurückbringt.‡고룡쉼터 사원 꼭대기에 있는 군주 이타리우스가 덩굴손 씨앗 3개를 가져와 달라고 부탁했습니다.‡Lord Itharius en lo alto del Templo del Reposo del Dragón te ha pedido que vuelvas con 3 semillas de azotador.‡Lord Itharius en lo alto del Templo del Reposo del Dragón te ha pedido que vuelvas con 3 semillas de azotador.‡Le Seigneur Itharius, au sommet du Temple du Repos du ver, vous a demandé de lui rapporter 3 Graines de flagellant.‡龙眠神殿顶层的伊萨里奥斯勋爵要你去收集3份鞭笞者的种子。‡龍眠神殿頂端的伊薩里奧斯領主要求你拿回3顆鞭笞者種子。',
  }
},
[12459] = {
  {
    'O que cria também destrói‡Что создает, то может и разрушать‡Das Schaffende kann auch zerstören‡창조의 힘, 파괴의 힘‡El que crea también puede destruir‡El que crea también puede destruir‡Ce qui peut donner la vie peut également la reprendre‡创造与毁灭的力量‡水能載舟亦能覆舟',
    nil,
    'Lorde Itharius, no topo do Templo do Repouso das Serpes, quer que você destrua uma Serpe Gélida Reanimada Enfraquecida, Túrgido, o Torpe Enfraquecido e o Feitor Necrolhos Enfraquecido.‡Уничтожьте ослабленного оживленного ледяного змея, ослабленного Турджида Зловещего и ослабленного наблюдателя Убийственного Взгляда по просьбе лорда Итара, который находится на вершине храма Драконьего Покоя.‡Lord Itharius in der Spitze des Wyrmruhtempels möchte, dass Ihr einen geschwächten wiedererweckten Frostwyrm, den geschwächten Turgid den Grässlichen und den geschwächten Aufseher Todesblick vernichtet.‡고룡쉼터 사원 꼭대기에 있는 군주 이타리우스가 약해진 되살아난 서리고룡, 약해진 흉측한 투르기드, 그리고 약해진 감독관 데스게이즈를 처치해 달라고 부탁했습니다.‡Lord Itharius en lo alto del Templo del Reposo del Dragón te ha pedido que acabes con una vermis de escarcha reanimada debilitada, con Turgid el Vil debilitado y con el sobrestante Mirada Mortal debilitado.‡Lord Itharius en lo alto del Templo del Reposo del Dragón te ha pedido que acabes con una vermis de escarcha reanimada debilitada, con Turgid el Vil debilitado y con el sobrestante Mirada Mortal debilitado.‡Le Seigneur Itharius, au sommet du Temple du Repos du ver, vous a demandé de détruire un Wyrm de givre réanimé affaibli, Turgid l\'Infâme affaibli et le Surveillant Miremort affaibli.‡龙眠神殿顶层的伊萨里奥斯勋爵要你去杀死一头被削弱的冰霜巨龙、被削弱的图尔基德和被削弱的监工戴瑟盖斯。‡龍眠神殿頂端的伊薩里奧斯領主要求你摧毀弱化的再活化冰霜巨龍、弱化的『邪惡』特基德、以及弱化的監督者死凝。',
  }
},
[12460] = {
  {
    'Apresente-se no Santuário Dragônico Rubi‡Прибытие в Рубиновое святилище драконов‡Beim Rubindrachenschrein Bericht erstatten‡루비 용제단에 보고‡Informa en el Santuario de Dragones Rubí‡Informa en el Santuario de Dragones Rubí‡Rapport au sanctuaire draconique rubis‡前往红玉巨龙圣地‡到晶紅龍殿報到',
    nil,
    'Apresente-se a Ceristrasz na cordilheira a leste do Santuário Dragônico Rubi, a oeste do Templo do Repouso das Serpes.‡Явитесь к Церистразу на уступе к востоку от Рубинового святилища драконов, к западу от Драконьего Покоя.‡Meldet Euch bei Ceristrasz, der sich auf dem Grat östlich des Rubindrachenschreins befindet. Der Schrein liegt westlich des Wyrmruhtempels.‡고룡쉼터 사원 서쪽의 루비 용제단 동쪽 산등성이에 있는 세리스트라즈에게 보고해야 합니다.‡Preséntate ante Ceristrasz en la cresta este del Santuario de Dragones Rubí al oeste de Reposo del Dragón.‡Preséntate ante Ceristrasz en la cresta este del Santuario de Dragones Rubí al oeste de Reposo del Dragón.‡Allez faire votre rapport à Ceristrasz, sur la crête à l\'est du Sanctuaire draconique rubis, à l\'ouest du Repos du ver.‡前往红玉巨龙圣地东面的山脊，向塞雷斯塔兹报到。红玉巨龙圣地就在龙眠神殿以西。‡向晶紅龍殿東邊山脊上的賽利斯塔茲報到，就在龍眠神殿的西方。',
  }
},
[12461] = {
  {
    'Apresente-se no Santuário Dragônico Rubi‡Прибытие в Рубиновое святилище драконов‡Beim Rubindrachenschrein Bericht erstatten‡루비 용제단에 보고‡Informa en el Santuario de Dragones Rubí‡Informa en el Santuario de Dragones Rubí‡Rapport au sanctuaire draconique rubis‡前往红玉巨龙圣地‡到晶紅龍殿報到',
    nil,
    'Apresente-se a Vargastrasz no penhasco próximo ao Santuário Dragônico Rubi, a leste do Martelo de Agmar.‡Явитесь к Варгастразу на хребте у Рубинового святилища драконов, к востоку от Молота Агмара.‡Meldet Euch bei Vargastrasz, der sich gleich östlich von Agmars Hammer auf einer Anhöhe in der Nähe des Rubindrachenschreins befindet.‡아그마르의 망치 동쪽의 루비 용제단 서쪽에 있는 산등성이의 바르가스트라즈에게 보고해야 합니다.‡Preséntate ante Vargastrasz en la cresta a las afueras del Santuario de Dragones Rubí justo al este de Martillo de Agmar.‡Preséntate ante Vargastrasz en la cresta a las afueras del Santuario de Dragones Rubí justo al este de Martillo de Agmar.‡Allez faire votre rapport à Vargastrasz, sur une crête à l\'extérieur du Sanctuaire draconique rubis, juste à l\'est du Marteau d\'Agmar.‡前往阿格玛之锤以东的红玉巨龙圣地，向圣地外面山脊上的瓦加斯塔兹报到。‡向晶紅龍殿外邊山脊的凡加斯塔茲報到，就在阿格瑪之錘的東方。',
  }
},
[12462] = {
  {
    'Um pouco de ação‡Кирпичик за кирпичиком‡Schon Spaß gehabt?‡침투 준비‡Partir un trozo‡Partir un trozo‡Éclatons-nous un peu !‡深入陵园‡搞定這件事',
    nil,
    'Yord Barbagelo, o Calamidade, no Mausoléu Invergarde, no Ermo das Serpes, quer que você mate o Necrolorde X\'avius, o Necrolorde Hórus e 15 Flagelos de Naxxramas.‡По заданию Йорда "Бедствия" Снегоборода, находящегося у усыпальницы Стражей Зимы, убейте некролордов Кс\'авиуса и Гора, а также 15 наксрамасских воинов Плети.‡Yord "Katastrophe" Eisbart im Mausoleum von Wintergarde in der Drachenöde möchte, dass Ihr Nekrolord X\'avius, Nekrolord Horus und 15 Diener von Naxxramas tötet.‡용의 안식처에 있는 윈터가드 묘지에 있는 "불운아" 요르드 아이스비어드가 강령군주 자비우스, 강령군주 호러스, 낙스라마스 스컬지 15마리를 처치해 달라고 부탁했습니다.‡Yord Barbahielo "el Calamidad" en el Mausoleo de Hibergarde del Cementerio de Dragones quiere que mates al necroseñor X\'avius, al necroseñor Horus y a 15 miembros de la Plaga de Naxxramas.|n‡Yord Barbahielo "el Calamidad" en el Mausoleo de Hibergarde del Cementerio de Dragones quiere que mates al necroseñor X\'avius, al necroseñor Horus y a 15 miembros de la Plaga de Naxxramas.|n‡Yord « Calamité » Barbeglace, au Mausolée de Garde-hiver dans la Désolation des dragons, veut que vous tuiez le Nécro-seigneur X\'avius, le Nécro-seigneur Horus et 15 membres du Fléau de Naxxramas.‡龙骨荒野暮冬陵园的“灾星”尤尔德·冰须要你杀死通灵领主萨维奥斯、通灵领主霍鲁斯和15名纳克萨玛斯天灾士兵。‡龍骨荒野，溫特加德墓塚的『災禍』約德·冰鬚要你殺死死靈領主薩維斯，死靈領主赫魯斯，和15個納克薩瑪斯天譴部隊。',
  }
},
[12463] = {
  {
    'Barbapilha tem de ser encontrado!‡Жаднобород должен быть найден!‡Ramschbart muss gefunden werden!‡플런더비어드를 찾아라!‡¡Debemos encontrar a Barbarrapiña!‡¡Debemos encontrar a Barbarrapiña!‡Il faut trouver Barbapille !‡找到普兰比尔德！‡一定要找到掠鬚!',
    nil,
    'Amgo Cash, no Mausoléu Invergarde, no Ermo das Serpes. quer que você encontre Barbapilha.‡По просьбе Амбо Кэша у усыпальницы Стражей Зимы найдите Жадноборода.‡Ambo Unkesch im Mausoleum von Wintergarde in der Drachenöde möchte, dass Ihr Ramschbart findet.‡용의 안식처에 있는 윈터가드 묘지의 앰보 캐시가 플런더비어드를 찾아달라고 부탁했습니다.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere que encuentres a Barbarrapiña.‡Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones quiere que encuentres a Barbarrapiña.‡Ambo Cash, au Mausolée de Garde-hiver dans la Désolation des dragons, vous a demandé de retrouver Barbapille.‡龙骨荒野暮冬陵园的阿姆博·卡什要你寻找普兰比尔德的下落。‡龍骨荒野，溫特加德墓塚的安柏·凱許要你找到掠鬚。',
  }
},
[12464] = {
  {
    'Minha velha inimiga‡Мой старый враг‡Mein alter Feind‡오랜 적수‡Mi eterna enemiga‡Mi eterna enemiga‡Ma vieille ennemie‡我的老对手‡我的宿敵',
    nil,
    'Entregue a Cabeça da General-de-exército ao Comandante Eligor Alvorada, na Bastilha Invergarde.‡Принесите голову верховного генерала командиру Элигору Вестник Рассвета из крепости Стражей Зимы.‡Liefert den Kopf des Hochgenerals bei Kommandant Eligor Morgenbringer in der Feste Wintergarde ab.‡고위사령관의 머리카락을 윈터가드 성채에 있는 사령관 엘리고르 돈브링어에게 가져와야 합니다.‡Entrega la cabeza de la Alta General al comandante Eligor Albar en la Fortaleza de Hibergarde.‡Entrega la cabeza de la Alta General al comandante Eligor Albar en la Fortaleza de Hibergarde.‡Rapportez la tête du Grand général au Commandant Eligor Portelaube au Donjon de Garde-hiver.‡把阿比迪斯将军的徽记交给暮冬要塞的指挥官埃里戈尔·黎明使者。‡把大將軍的頭顱帶去給溫特加德要塞的指揮官艾利格·黎明使者。',
  }
},
[12465] = {
  {
    'O diário de Barbapilha‡Дневник Жадноборода‡Ramschbarts Tagebuch‡플런더비어드의 일지‡El diario de Barbarrapiña‡El diario de Barbarrapiña‡Le journal de Barbapille‡普兰比尔德的日记‡掠鬚的日誌',
    nil,
    'Recupere a Página 4, a Página 5, a Página 6 e a Página 7 do Diário de Barbapilha e entregue-as para Amgo Cash no Mausoléu Invergarde, no Ermo das Serpes.‡Найдите недостающие страницы дневника Жадноборода: страницу 4, страницу 5, страницу 6 и страницу 7. Отнесите их Амбо Кэшу, ожидающему рядом с усыпальницей Стражей Зимы на Драконьем Погосте.‡Beschafft die 4., 5., 6. und 7. Seite von Ramschbarts Tagebuch und bringt sie Ambo Unkesch im Mausoleum von Wintergarde in der Drachenöde.‡플런더비어드의 일지 제4장, 플런더비어드의 일지 제5장, 플런더비어드의 일지 제6장, 플런더비어드의 일지 제7장을 찾아 용의 안식처에 있는 윈터가드 묘지의 앰보 캐시에게 가져가야 합니다.‡Recupera la página 4 del diario de Barbarrapiña, la página 5 del diario de Barbarrapiña, la página 6 del diario de Barbarrapiña y la página 7 del diario de Barbarrapiña, y llévaselas a Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones.‡Recupera la página 4 del diario de Barbarrapiña, la página 5 del diario de Barbarrapiña, la página 6 del diario de Barbarrapiña y la página 7 del diario de Barbarrapiña, y llévaselas a Ambo Calderilla en el Mausoleo de Hibergarde en el Cementerio de Dragones.‡Récupérez les pages 4, 5, 6 et 7 du journal de Barbapille et donnez-les à Ambo Cash au Mausolée de Garde-hiver dans la Désolation des dragons.‡将普兰比尔德的日记的第4页、第5页、第6页和第7页交给龙骨荒野暮冬陵园的阿姆博·卡什。‡回收掠鬚日誌的第四頁、掠鬚日誌的第五頁、掠鬚日誌的第六頁、以及掠鬚日誌的第七頁;然後向安柏·凱許回報，他就在龍骨荒野的溫特加德墓塚。',
  }
},
[12466] = {
  {
    'À procura de Nevascal: Front da 7ª Legião‡Погоня за Ледяной Бурей: передовая 7-го легиона‡Dem Eissturm hinterher: Front der 7. Legion‡얼음폭풍 추적: 7군단 전초지‡Persiguiendo a Tormenta de Hielo: El Frente de la Séptima Legión‡Persiguiendo a Tormenta de Hielo: El Frente de la Séptima Legión‡À la poursuite de Foudreglace : le front de la 7e Légion‡追击冰雪风暴：第七军团前线‡追擊冰颶:第七軍團前線',
    nil,
    'Apresente-se ao Comandante de Legião Tyralion, no Front da 7ª Legião, no Ermo das Serpes.‡Явитесь к командиру легиона Тиралиону на передовой 7-го легиона в центральном Драконьем Погосте.‡Meldet Euch bei Legionskommandant Tyralion an der Front der 7. Legion im Zentrum der Drachenöde.‡용의 안식처 중심부의 7군단 전초지에 있는 군단 사령관 티랄리온에게 보고해야 합니다.‡Preséntate ante el comandante de la Legión Tyralion en el Frente de la Séptima Legión en el centro del Cementerio de Dragones.‡Preséntate ante el comandante de la Legión Tyralion en el Frente de la Séptima Legión en el centro del Cementerio de Dragones.‡Présentez-vous au Commandant de la Légion Tyralion au Front de la 7e Légion au centre de la Désolation des dragons.‡前往龙骨荒野中部的第七军团前线，向军团司令泰拉里安报到。‡向龍骨荒野中央，第七軍團前線的軍團指揮官泰拉里恩報到。',
  }
},
[12467] = {
  {
    'À procura de Nevascal: Filactério de Thel\'zan‡Охота на Ледяную Бурю: филактерия Тель\'зана‡Dem Eissturm hinterher: Thel\'zans Phylakterium‡얼음폭풍 추적: 텔잔의 성물함‡Persiguiendo a Tormenta de Hielo: la filacteria de Thel\'zan‡Persiguiendo a Tormenta de Hielo: la filacteria de Thel\'zan‡À la poursuite de Foudreglace : le phylactère de Thel\'zan‡追击冰雪风暴：塞尔赞的护命匣‡追擊冰颶:賽爾贊的骨匣',
    nil,
    'Recupere o Filactério de Thel\'zan de Nevascal e entregue-o para o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, no Ermo das Serpes.‡Добудьте с тела Ледяной Бури филактерию Тель\'зана и отнесите ее главнокомандующему Халфорду Змеевержцу в крепость Стражей Зимы.‡Nehmt Eissturm Thel\'zans Phylakterium ab und bringt es zurück zu Hochkommandant Halford Wyrmbann in der Feste Wintergarde.‡얼음폭풍에게서 텔잔의 성물함을 되찾아 윈터가드 성채에 있는 총사령관 할포드 웜베인에게 가져가야 합니다.‡Recupera la filacteria de Thel\'zan de Tormenta de Hielo y llévasela al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde.|n‡Recupera la filacteria de Thel\'zan de Tormenta de Hielo y llévasela al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde.|n‡Reprenez le Phylactère de Thel\'zan à Foudreglace et rapportez-le au Haut-commandant Halford Verroctone au Donjon de Garde-hiver.‡从冰雪风暴手中夺得塞尔赞的护命匣，将它交给暮冬要塞的高级指挥官哈尔弗·维姆班恩。‡從冰颶身上取得賽爾贊的骨匣，然後將它交給溫特加德要塞的高階指揮官海弗德·龍禍。',
  }
},
[12468] = {
  {
    'A tarefa do conquistador‡Поручение Завоевательницы‡Die Aufgabe des Eroberers‡정복자의 임무‡La tarea del Conquistador‡La tarea del Conquistador‡Les exigences de la conquérante‡征服者的指派‡征服者的工作',
    nil,
    'Fale com o Sargento Nazgrim no Forte da Conquista.‡Поговорите с сержантом Назгримом в Крепости Завоевателей.‡Sprecht mit Unteroffizier Nazgrim in Burg Siegeswall.‡정복의 요새에 있는 하사관 나즈그림과 대화해야 합니다.‡Habla con el Sargento Nazgrim en el Bastión de la Conquista.‡Habla con el Sargento Nazgrim en el Bastión de la Conquista.‡Parlez au Sergent Nazgrim au Bastion de la Conquête.‡与征服堡的纳兹格利姆中士谈一谈。‡與征服堡的士官納茲格寧姆交談。',
  }
},
[12469] = {
  {
    'Devolver ao remetente‡Вернуть отправителю‡Zurück an den Absender‡발신자에게 반송‡Devolver al remitente‡Devolver al remitente‡Retour à l\'envoyeur‡退回发件人‡返還派遣者',
    nil,
    'Siga a cordilheira para o leste e entregue o pacote de explosivos para Xink, no Posto Ferrugem, na parte norte do Ermo das Serpes.‡Ступайте на восток вдоль гряды и доставьте груз взрывчатки Зинку в Лагерь Соплозабилось в северном Драконьем Погосте.‡Folgt dem Grat nach Osten und liefert das Sprengstoffpaket bei Xink im Düsenrostposten im Norden der Drachenöde ab.‡동쪽 산등성이를 따라 이동하여 용의 안식처 북부의 녹주둥이 전초기지에 있는 싱크에게 폭탄 꾸러미를 전달해야 합니다.‡Sigue la cresta hacia el este y entrega el paquete de explosivos a Xink en el Puesto Boquilla Oxidada en el norte del Cementerio de Dragones.‡Sigue la cresta hacia el este y entrega el paquete de explosivos a Xink en el Puesto Boquilla Oxidada en el norte del Cementerio de Dragones.‡Suivez la crête vers l\'est et livrez le paquet d\'explosifs à Xink au Poste de Rouilletuyère dans le nord de la Désolation des dragons.‡沿着山脊向东面走，将炸药包交给龙骨荒野北部诺兹拉斯哨站的辛克。‡沿著山脊往東走，把炸藥包送回去給鏽鼻崗哨的辛克，在龍骨荒野的北方。',
  }
},
[12470] = {
  {
    'O mistério do infinito‡Тайна бесконечности‡Mysterium der Unendlichkeit‡무한의 비밀‡El misterio del Infinito‡El misterio del Infinito‡Mystère de l\'infini‡永恒之龙的秘密‡恆龍的秘密',
    nil,
    'Crona, no topo do Templo do Repouso das Serpes, quer que você vá até o Santuário Dragônico Bronze. Uma vez lá dentro, posicione a Ampulheta da Eternidade no chão.|n|nProteja a ampulheta pelo tempo que for necessário, e então informe Crona de suas descobertas.‡Отправляйтесь в бронзовое святилище драконов. Когда проникнете в святилище, поставьте на землю песочные часы Вечности.|n|nЗащищайте часы, пока они идут, а потом возвращайтесь к Хроми на вершину храма Драконьего покоя и передайте ей полученную вами информацию.‡Chromie auf der Spitze des Wyrmruhtempels möchte, dass Ihr zum Bronzedrachenschrein reist. Stellt das Stundenglas der Ewigkeit dort im Inneren des Schreins auf den Boden.|n|nBeschützt das Stundenglas so lange wie nötig und kehrt anschließend mit den erhaltenen Informationen zu Chromie zurück.‡고룡쉼터 사원 꼭대기에 있는 크로미가 청동 용제단으로 이동해 달라고 부탁했습니다. 용제단에 도착하면 영원의 모래시계를 바닥에 놓아야 합니다.|n|n모래시계를 끝까지 보호한 다음 알아낸 정보를 가지고 돌아가십시오.‡Cromi en lo alto del Templo del Reposo del Dragón te pide que vayas hasta el santuario de Dragones Bronce. En cuanto estés dentro, sitúa el reloj de arena de eternidad en el suelo.|n|nProtégelo todo lo que dure y devuélvelo a Cromi con cualquier información que hayas obtenido.‡Cromi en lo alto del Templo del Reposo del Dragón te pide que vayas hasta el santuario de Dragones Bronce. En cuanto estés dentro, sitúa el reloj de arena de eternidad en el suelo.|n|nProtégelo todo lo que dure y devuélvelo a Cromi con cualquier información que hayas obtenido.‡Chromie, au sommet du Temple du Repos du ver, vous a demandé de vous rendre au Sanctuaire draconique bronze. Une fois à l\'intérieur, posez le Sablier de l\'Éternité au sol.|n|nProtégez le sablier le temps qu\'il se vide, puis retournez la voir avec toute information que vous aurez obtenue.‡克罗米要你进入青铜巨龙圣地，将永恒沙漏放在地上。|n|n保护沙漏，直到你获得克罗米想要的情报。完成任务后返回龙眠神殿顶层向她复命。‡龍眠神殿頂端的克羅米拜託你前往青銅龍殿。一旦進入殿中，將永恆沙漏放置地上。|n|n持續保護沙漏，並將你所收集到的情報回覆給她。',
  }
},
[12471] = {
  {
    'A Crueldade dos Kvaldir‡Жестокость квалдиров‡Grausamkeiten der Kvaldir‡크발디르의 잔인함‡La crueldad de los Kvaldir‡La crueldad de los Kvaldir‡La cruauté des kvaldirs‡残忍的科瓦迪尔‡科瓦迪爾的兇殘',
    nil,
    'Fale com Karuk sobre o Prisioneiro Morsano Capturado.‡Расскажите Каруку о пленном узнике-клыкарре.‡Sprecht mit Karuk über den eingesperrten Tuskarrgefangenen‡카루크와 사로잡힌 투스카르 포로에 대해 대화해야 합니다.‡Habla con Karuk sobre el prisionero colmillarr capturado.‡Habla con Karuk sobre el prisionero colmillarr capturado.‡Parlez à Karuk du Prisonnier rohart capturé.‡将海象人囚犯的情况告诉卡鲁克。‡告訴卡魯克關於被俘虜的巨牙海民囚犯的事。',
  }
},
[12472] = {
  {
    'Agora só falta você‡Шаг к победе‡Endgültigkeit‡최후‡El momento decisivo‡El momento decisivo‡Finalité‡终结‡結局',
    nil,
    'Entregue o Filactério de Thel\'zan para o Comandante de Legião Jorge, dentro do Mausoléu Invergarde, no Ermo das Serpes.‡Отнесите филактерию Тель\'зана командиру легиона Йорику в усыпальницу Стражей Зимы в Драконьем Погосте.‡Bringt Thel\'zans Phylakterium zu Legionskommandant Yorik im Inneren des Mausoleums von Wintergarde in der Drachenöde.‡텔잔의 성물함을 용의 안식처에 있는 윈터가드 묘지의 군단 사령관 요릭에게 가져가야 합니다.‡Lleva la filacteria de Thel\'zan al comandante de la Legión Yorik dentro del Mausoleo de Hibergarde en el Cementerio de Dragones.‡Lleva la filacteria de Thel\'zan al comandante de la Legión Yorik dentro del Mausoleo de Hibergarde en el Cementerio de Dragones.‡Apportez le Phylactère de Thel\'zan au commandant de la Légion Yorik à l\'intérieur du Mausolée de Garde-hiver de la Désolation des dragons.‡带着塞尔赞的护命匣前往龙骨荒野的暮冬陵园，向军团司令尤瑞克报到。‡將賽爾贊的骨匣帶給軍團指揮官約立克，他就在龍骨荒野上的溫特加德墓塚中。',
  }
},
[12473] = {
  {
    'Um final e um começo‡Конец и начало‡Ein Ende und ein neuer Anfang‡끝과 시작‡Un final y un principio‡Un final y un principio‡Une fin et un début‡结束和开始‡開頭與尾聲',
    nil,
    'Derrote Thel\'zan, o Noctífero, e apresente-se ao Alto-comandante Haraldo Serpecida na Bastilha Invergarde, no Ermo das Serpes.‡Сразите Тель\'зана Мраконосца и доложите об этом главнокомандующему Халфорду Змеебою из крепости Стражей Зимы на Драконьем Погосте.‡Besiegt Thel\'zan den Dämmerbringer und meldet Euch anschließend bei Oberkommandant Halford Wyrmbann in Wintergarde in der Drachenöde.‡황혼의 인도자 텔잔을 처치한 다음 용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 보고해야 합니다.‡Vence a Thel\'zan el Portador del Ocaso e informa al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Vence a Thel\'zan el Portador del Ocaso e informa al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Vainquez Thel\'zan le Portebrune et faites votre rapport au Haut-commandant Halford Verroctone au Donjon de Garde-hiver dans la Désolation des dragons.‡击败塞尔赞，然后前往龙骨荒野的暮冬要塞，向高级指挥官哈尔弗·维姆班恩报告。‡擊敗『幽暮使者』賽爾贊並向高階指揮官海弗德·龍禍回報，他就在龍骨荒野的溫特加德要塞中。',
  }
},
[12474] = {
  {
    'Para o Forte Fordragon!‡За крепость Фордрагона!‡Auf zur Feste Fordragon!‡폴드라곤 요새로!‡¡Al Bastión de Fordragón!‡¡Al Bastión de Fordragón!‡En route pour le bastion Fordragon !‡前往弗塔根要塞！‡前往弗塔根堡!',
    nil,
    'Vá para o Forte Fordragon, que fica no Ermo das Serpes, e fale com o Grão-lorde Bolvar Fordragon.‡Отправляйтесь в крепость Фордрагона в Драконьем Погосте и поговорите с верховным лордом Болваром Фордрагоном.‡Geht zur Feste Fordragon in der Drachenöde und sprecht mit Hochlord Bolvar Fordragon.‡용의 안식처에 있는 폴드라곤 요새로 이동하여 대영주 볼바르 폴드라곤과 대화해야 합니다.‡Aventúrate en el Bastión Fordragón en el Cementerio de Dragones y habla con el alto señor Bolvar Fordragón.|n‡Aventúrate en el Bastión Fordragón en el Cementerio de Dragones y habla con el alto señor Bolvar Fordragón.|n‡Rendez-vous au bastion Fordragon dans la Désolation des dragons et parlez au généralissime Bolvar Fordragon.‡前往龙骨荒野的弗塔根要塞，与伯瓦尔·弗塔根公爵谈一谈。‡前往龍骨荒野的弗塔根堡，與大領主伯瓦爾·弗塔根交談。',
  }
},
[12475] = {
  {
    'Os segredos que os homens encobrem‡Какие тайны они скрывают?‡Männergeheimnisse‡붉은돌격대 지도‡Los secretos que esconden los hombres‡Los secretos que esconden los hombres‡Les secrets que cachent les hommes‡隐藏的秘密‡人們藏匿的秘密',
    nil,
    'Zelig, o Visionário, na Bastilha Invergarde, no Ermo das Serpes, quer que você encontre o Mapa da Ofensiva e o devolva para ele.‡Добудьте карту Натиска по просьбе Зелига Иллюзорного из крепости Стражей Зимы в Драконьем Погосте и вернитесь с ней к Зелигу.‡Zelig der Visionär in der Feste Wintergarde in der Drachenöde möchte, dass Ihr die Karte des Scharlachroten Ansturms findet und sie zu ihm zurückbringt.‡붉은돌격대 지도를 찾아 용의 안식처에 있는 윈터가드 성채의 예지자 젤리그에게 가져가야 합니다.‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que encuentres el mapa del Embate y que se lo devuelvas.‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que encuentres el mapa del Embate y que se lo devuelvas.‡Zelig le Visionnaire au Donjon de Garde-hiver dans la Désolation des dragons veut que vous trouviez la Carte de l’Assaut et que vous la lui rapportiez.‡暮冬要塞的幻象师瑟里格要你去找到先锋军地图。‡『遠識』齊利格要你將突襲軍地圖帶回來給他，他就在龍骨荒野中溫特加德要塞裡面。',
  }
},
[12476] = {
  {
    'O retorno da Cruzada?‡Возвращение Алого ордена?‡Die Rückkehr des Kreuzzugs?‡십자군의 귀환?‡¿El retorno de la Cruzada?‡¿El retorno de la Cruzada?‡Le retour de la Croisade ?‡血色十字军归来？‡十字軍回歸?',
    nil,
    'A Comandante Lynore Golpevento, na Bastilha Invergarde, no Ermo das Serpes, quer que você mate 20 membros da Ofensiva Escarlate, na Base da Ofensiva.‡Убейте 20 воинов Алого Натиска в лагере Алого Натиска по приказу командира Линоры Порыв Ветра.‡Kommandantin Lynore Windstreich in der Feste Wintergarde in der Drachenöde möchte, dass Ihr 20 Mitglieder des Scharlachroten Ansturms im Basislager des Ansturms tötet.‡용의 안식처에 있는 윈터가드 성채의 사령관 리노어 윈드스트라이크가 붉은돌격대 주둔지에 있는 붉은돌격대 20명을 처치해 달라고 부탁했습니다.‡La comandante Lynore Ventostryke de la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que mates a 20 miembros de El Embate Escarlata en el campamento del Embate.‡La comandante Lynore Ventostryke de la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que mates a 20 miembros de El Embate Escarlata en el campamento del Embate.‡Le Commandant Lynore Frappevent, du Donjon de Garde-hiver dans la Désolation des dragons, veut que vous tuiez 20 membres de l’Assaut écarlate au Camp de base de l’Assaut écarlate.‡暮冬要塞的指挥官莱诺尔·风矛要你前往先锋军营地，消灭20个血色先锋军成员。‡龍骨荒野，溫特加德要塞裡的最高指揮官萊諾爾·風矛要你去突襲營地殺死20名血色突襲軍員。',
  }
},
[12477] = {
  {
    'O Caminho da Redenção‡Путь искупления‡Der Weg der Erlösung‡구원의 길‡El Camino de la Redención‡El Camino de la Redención‡Le Chemin de la rédemption‡救赎之路‡救贖之途',
    nil,
    'Leve o "Caminho da Redenção" para o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, que fica no Ermo das Serpes.‡Принесите копию "Пути искупления" главнокомандующему Халфорду Змеевержцу из крепости Стражей Зимы в Драконьем Погосте.‡Bringt "Der Weg der Erlösung" zu Oberkommandant Halford Wyrmbann in der Feste Wintergarde in der Drachenöde.‡용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 \'구원의 길\'을 가져가야 합니다.‡Devuelve "El Camino de la Redención" al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Devuelve "El Camino de la Redención" al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Remettez un exemplaire du « Chemin de la rédemption » au Haut-commandant Halford Verroctone, au Donjon de Garde-hiver dans la Désolation des dragons.‡将《救赎之路》带回龙骨荒野的暮冬要塞，交给高级指挥官哈尔弗·维姆班恩。‡將「救贖之途」交給高階指揮官海弗德·龍禍，他就在龍骨荒野的溫特加德要塞裡面。',
  }
},
[12478] = {
  {
    'Caverna Gélido Lamento‡Пещера Ледяной Скорби‡Frostgramhöhlen‡서리한 동굴‡La Caverna Agonía de Escarcha‡La Caverna Agonía de Escarcha‡La caverne de Deuillegivre‡霜之哀伤洞穴‡霜之哀傷洞窟',
    nil,
    'Zelig, o Visionário, na Bastilha Invergarde, no Ermo das Serpes, quer que você use o Orbe de Vidência de Zelig no fundo da Caverna Gélido Lamento. Descubra os segredos do passado!‡Используйте гадальный шар Зелига на дне пещеры Ледяной Скорби по просьбе Зелига Иллюзорного из крепости Стражей Зимы в Драконьем Погосте. Откройте тайны былого!‡Zelig der Visionär in der Feste Wintergarde in der Drachenöde möchte, dass Ihr am Ende der Frostgramhöhlen Zeligs Seherkugel benutzt. Lüftet die Geheimnisse der Vergangenheit!‡용의 안식처에 있는 윈터가드 성채의 예지자 젤리그가 서리한 동굴 깊숙한 곳에서 젤리그의 수정구를 사용해 달라고 부탁했습니다. 과거의 비밀을 파헤쳐야 합니다!‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que uses el orbe de visión de Zelig en el fondo de la Caverna Agonía de Escarcha. ¡Desata los secretos del pasado!‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que uses el orbe de visión de Zelig en el fondo de la Caverna Agonía de Escarcha. ¡Desata los secretos del pasado!‡Zelig le Visionnaire, du donjon de Garde-hiver dans la Désolation des dragons, veut que vous utilisiez l’Orbe de divination de Zelig au fond de la Caverne de Deuillegivre. Découvrez les secrets du passé !‡龙骨荒野暮冬要塞的幻象师瑟里格要你在霜之哀伤洞穴深处使用瑟里格的占卜宝珠，解开尘封的秘密！‡溫特加德要塞的『遠識』齊利格要你在霜之哀傷洞窟底部使用齊利格的占卜寶珠，揭開過去的秘密!',
  }
},
[12479] = {
  {
    'Para Nortúndria!‡Onwards to Northrend!‡Auf nach Nordend!‡노스렌드를 향하여!‡¡Hacia Rasganorte!‡¡Hacia Rasganorte!‡En route pour le Norfendre !‡Onwards to Northrend!‡前往北裂境!',
    nil,
    'Fale com o Recrutador da Aliança na Bastilha Valentia, que fica na Tundra Boreana, ou com o Recrutador da Aliança que fica no Porto Vendeta no Fiorde Uivante.‡Speak to the Alliance Recruiter inside Valiance Keep in Borean Tundra or the one at Vengeance Landing in Howling Fjord.‡Sprecht mit dem Rekrutierer der Allianz in der Valianzfeste in der boreanischen Tundra oder im Hafen der Vergeltung im heulenden Fjord.‡북풍의 땅에 있는 용맹의 성채나 울부짖는 협만에 있는 발가드로 가서 얼라이언스 징병관과 대화해야 합니다.‡Habla con el reclutador de la Alianza dentro de la Fortaleza Denuedo en la Tundra Boreal o con el de Campo Venganza en Fiordo Aquilonal.‡Habla con el reclutador de la Alianza dentro de la Fortaleza Denuedo en la Tundra Boreal o con el de Campo Venganza en Fiordo Aquilonal.‡Parlez au Recruteur de l’Alliance au Donjon de la Bravoure, dans la toundra Boréenne ; ou à celui de Valgarde, dans le Fjord Hurlant.‡Speak to the Alliance Recruiter inside Valiance Keep in Borean Tundra or the one at Vengeance Landing in Howling Fjord.‡與北風凍原、驍勇要塞的聯盟招募員或是凜風峽灣、復仇臺地的聯盟招募員交談。',
  }
},
[12480] = {
  {
    'Para Nortúndria!‡Onwards to Northrend!‡Auf nach Nordend!‡노스렌드를 향하여!‡¡Hacia Rasganorte!‡¡Hacia Rasganorte!‡En route pour le Norfendre !‡Onwards to Northrend!‡前往北裂境!',
    nil,
    'Fale com o Recrutador da Horda na Fortaleza Brado Guerreiro, que fica na Tundra Boreana, ou com o Recrutador da Horda que fica no Porto Vendeta no Fiorde Uivante.‡Speak to the Horde Recruiter inside Warsong Hold in Borean Tundra or Vengeance Landing in Howling Fjord.‡Sprecht mit dem Rekrutierer der Horde im Inneren der Kriegshymnenfeste in der boreanischen Tundra oder im Hafen der Vergeltung im heulenden Fjord.‡북풍의 땅에 있는 전쟁노래부족 요새나 울부짖는 협만에 있는 복수의 상륙지로 가서 호드 징병관과 대화해야 합니다.‡Habla con el reclutador de la Horda dentro del Bastión Grito de Guerra en la Tundra Boreal o con el de Campo Venganza en el Fiordo Aquilonal.‡Habla con el reclutador de la Horda dentro del Bastión Grito de Guerra en la Tundra Boreal o con el de Campo Venganza en el Fiordo Aquilonal.‡Parlez au Recruteur de la Horde du Bastion Chanteguerre, dans la toundra Boréenne, ou à celui de l’Accostage de la Vengeance, dans le Fjord Hurlant.‡Speak to the Horde Recruiter inside Warsong Hold in Borean Tundra or Vengeance Landing in Howling Fjord.‡與北風凍原、戰歌堡的部落招募員或是凜風峽灣、復仇臺地的部落招募員交談。',
  }
},
[12481] = {
  {
    'Botando lenha na fogueira‡Оскорбительное поражение‡Salz in die Wunde streuen‡상처에 소금 뿌리기‡Eres un... Y un... Y además...‡Eres un... Y un... Y además...‡Retourner le couteau dans la plaie‡骂阵‡罵上加傷',
    nil,
    'Leia o Insulto Vraikal para Bjorn Halgurdsson em Baleheim, e então atraia-o até a Cilada de Lídio e ajude a matá-lo.‡Зачитайте врайкульское оскорбление Бьорну Халгудссону из Гибльхейма, после чего приведите его прямо к Засаде Лиделла и помогите его убить.‡Lest Björn Halgurdsson in Quälheim die Vrykulbeleidigung laut vor, lockt ihn dann zu Lydells Hinterhalt und helft den anderen, ihn zu töten.‡베일하임에 있는 비요른 할구르드슨에게 브리쿨어 욕설을 읽은 다음 리델의 매복지로 유인해서 처치해야 합니다.‡Lee el insulto vrykul a Bjorn Halgurdsson en Baleheim y luego llévalo hasta la Emboscada de Lydell y ayúdale a matarlo.‡Lee el insulto vrykul a Bjorn Halgurdsson en Baleheim y luego llévalo hasta la Emboscada de Lydell y ayúdale a matarlo.‡Lisez l’Insulte vrykule à Bjorn Halgurdsson à Torvheim, puis conduisez-le à l’embuscade de Lydell et participez à sa mise à mort.‡在拜尔海姆对布约恩·哈古德森朗读维库人的脏话，然后把他引到林德尔的伏击点，帮助林德尔杀了他。‡對貝爾海姆的畢雍·海格德森唸出維酷人的侮辱語，然後將他引回黎戴爾的埋伏處，幫忙殺了他。',
  }
},
[12482] = {
  {
    'Contra Niffelvar‡Атака на Ниффлвар‡Gegen Niffelvar‡니플바르 전투‡Contra Nafsavar‡Contra Nafsavar‡Contre Nifflevar‡进攻尼弗莱瓦‡對付尼弗瓦',
    nil,
    'A Capitão-patrulheira Areiel quer que você vá até Niffelvar e mate 5 Guerreiros Esfola-dragão, 4 Leitores de Runas Esfola-dragão e 4 Cães de Caça Esfola-dragão.‡Капитан следопытов Арейел просит вас отправиться в Ниффлвар и убить 5 воинов из клана Укротителей драконов, 4 руномантов из клана Укротителей драконов и 4 гончих-охотников из клана Укротителей драконов.‡Waldläuferhauptmann Areiel möchte, dass Ihr nach Niffelvar geht und 5 Krieger der Drachenschinder, 4 Runenseher der Drachenschinder und 4 Jagdhunde der Drachenschinder tötet.‡순찰대장 아레이엘이 니플바르에서 용약탈부족 전사 5명, 용약탈부족 룬점쟁이 4명, 용약탈부족 사냥개 4마리를 제거해 달라고 부탁했습니다.‡La capitana forestal Areiel quiere que vayas a Nafsavar y mates a 5 guerreros Desuelladragones, a 4 videntes de runas Desuelladragones y a 4 canes de caza Desuelladragones.‡La capitana forestal Areiel quiere que vayas a Nafsavar y mates a 5 guerreros Desuelladragones, a 4 videntes de runas Desuelladragones y a 4 canes de caza Desuelladragones.‡Le capitaine des forestiers Areiel vous demande d\'aller à Nifflevar et d\'y tuer 5 Guerriers écorche-dragon, 4 Voyants des runes écorche-dragon et 4 Chiens de chasse écorche-dragon.‡游侠队长艾蕾尔要你前往尼弗莱瓦，杀死5名掠龙战士、4名掠龙符文法师和4条掠龙猎犬。‡遊俠隊長艾瑞依爾要你去尼弗瓦殺死5個掠龍戰士、4個掠龍符文先知以及4隻掠龍巡狩獵犬。',
  }
},
[12483] = {
  {
    'Ensopado de Brilhacampa‡Похлебка из снежных грибов‡Schimmerkappeneintopf‡눈꽃버섯 스튜‡Estofado de champiñones brillantes‡Estofado de champiñones brillantes‡Le ragoût de chapeneiges‡蘑菇汤！‡燉幻光菇',
    nil,
    'Prigmon, nas Fontes Graníticas, quer que você colete 5 Campaneves Tremeluzentes e 5 Olhos de Serpente do Gelo das Ruínas de Drak\'Zin, e 5 Raízes-doces de Zeb\'Halak.‡Пригмон из Гранитных ключей просит вас собрать 5 мерцающих снежных грибов и 5 глаз ледяных змеев из руин Драк\'Зина и 5 сладокорней из Зеб\'Халака.‡Prigmon am Granitquell möchte, dass Ihr 5 Schimmernde Schneekappen und 5 Eisschlangenaugen in den Ruinen von Drak\'Zin und 5 Süßwurzeln aus Zeb\'Halak sammelt.‡화강암 웅덩이에 있는 프리그몬이 드락진 폐허에서 반짝이는 눈꽃버섯 5개와 얼음 천둥매 눈 5개, 제브할락에서 감초 5개를 가져다 달라고 부탁했습니다.‡Prigmon en el Manantial de Granito quiere que consigas 5 funguinieves fulgurantes y 5 ojos de serpiente de hielo en las Ruinas de Drak\'Zin y 5 dulcerraíces de Zeb\'Halak.‡Prigmon en el Manantial de Granito quiere que consigas 5 funguinieves fulgurantes y 5 ojos de serpiente de hielo en las Ruinas de Drak\'Zin y 5 dulcerraíces de Zeb\'Halak.‡Dasnob, aux Sources de granit, veut que vous récoltiez 5 Chapeneiges chatoyants et 5 Yeux de serpents des glaces dans les Ruines de Drak\'Zin, et 5 brins de Réglisse à Zeb\'Halak.‡岩石之泉的普雷蒙要你在达克辛废墟中收集5份幽光雪菇和5份冰蛇之眼，再到塞布哈拉克去收集5份甜根茎。‡花崗岩之泉的皮格蒙要你去德拉克辛遺跡收集5個幻光雪菇和5個冰蛇之眼，以及從札布哈拉克收集5個甜根。',
  }
},
[12484] = {
  {
    'Espetinho de Flagelo‡Шашлык из Плети‡Geißelkebab‡스컬지 화장‡Kebab de Plaga‡Kebab de Plaga‡Kébab de Fléau‡清理天灾‡天譴烤肉',
    nil,
    'Prigmon, nas Fontes Graníticas, quer que você leve uma Carcaça Mumificada de Troll a Mack Fearsen e que a coloque no fogo.‡Пригмон из Гранитных ключей просит вас отнести мумифицированный труп тролля Маку Фирсену и бросить его в огонь.‡Prigmon am Granitquell möchte, dass Ihr eine mumifizierte Trollleiche zu Mack Fearsen bringt und sie dort ins Feuer werft.‡화강암 웅덩이에 있는 프리그몬이 스컬지 트롤 미라를 맥 피어센에게 가져가 불에 태워 달라고 부탁했습니다.‡Prigmon en el Manantial de Granito quiere que le lleves los restos de un trol momificado a Mack Miedosen y los coloques en el fuego.‡Prigmon en el Manantial de Granito quiere que le lleves los restos de un trol momificado a Mack Fearsen y los coloques en el fuego.‡Dasnob, des Sources de granit, veut que vous remettiez une Carcasse de troll momifié à Mack Froussen et que vous la jetiez au feu.‡岩石之泉的普雷蒙要你把一具僵化的巨魔尸体拖到马克·菲尔森那里，并把它用高温处理掉。‡花崗岩之泉的皮格蒙要你把一具乾縮食人妖屍體帶去給麥客·菲爾森，然後放進火裡。',
  }
},
[12485] = {
  {
    '‡Howling Fjord: aa - A - LK FLAG‡Howling Fjord: aa - A - LK FLAG‡‡Howling Fjord: aa - A - LK FLAG‡Howling Fjord: aa - A - LK FLAG‡Howling Fjord: aa - A - LK FLAG‡嚎风峡湾: aa - A - LK FLAG‡',
    nil,
    nil,
  }
},
[12486] = {
  {
    'Para o Posto Avançado Bor\'gorok, rápido!‡Быстро, на заставу Бор\'горока!‡Auf zum Außenposten Bor\'gorok, schnell!‡보르고로크 전초기지로!‡A la Avanzada Bor\'gorok... ¡Rápido!‡A la Avanzada Bor\'gorok... ¡Rápido!‡À l\'avant-poste de Bor\'gorok, vite !‡立即前往博古洛克前哨站！‡前往博格洛克前哨，快一點!',
    nil,
    'Fale com a Porta-voz Espiritual Rosnapresas no Posto Avançado Bor\'gorok.‡Поговорите с говорящей с духами Рычеклык на заставе Бор\'горока.‡Sprecht mit Geisterflüsterin Fletschfang im Außenposten Bor\'gorok.‡보르고로크 전초기지에 있는 영매 스날팡과 대화해야 합니다.‡Habla con la médium Colmillo Gruñente en la Avanzada Bor\'gorok.‡Habla con la médium Colmillo Gruñente en la Avanzada Bor\'gorok.‡Allez voir la spirite Grognecroc à l\'Avant-poste de Bor\'gorok.‡与博古洛克前哨站的灵语者斯纳尔芬谈一谈。‡和博格洛克前哨的靈語者嗥牙交談。',
  }
},
[12487] = {
  {
    'Para o Forte da Conquista, mas cuidado!‡В крепости Завоевателей держи ухо востро!‡Auf nach Burg Siegeswall! Doch Achtung!‡정복의 요새로! 단, 조심해서!‡Al Bastión de la Conquista, ¡pero ten cuidado!‡Al Bastión de la Conquista, ¡pero ten cuidado!‡Au bastion de la Conquête, mais avec prudence !‡前往征服堡，自求多福吧！‡前往征服堡，但要小心!',
    nil,
    'Apresente-se à Conquistadora Krenna no Forte da Conquista, na Serra Gris.‡Явитесь к завоевательнице Кренне в крепости Завоевателей в Седых холмах.‡Stellt Euch Eroberin Krenna vor. Sie befindet sich in Burg Siegeswall in den Grizzlyhügeln.‡회색 구릉지에 있는 정복의 요새에서 정복자 크레나를 만나야 합니다.‡Preséntate ante la Conquistadora Krenna en el Bastión de la Conquista en las Colinas Pardas.‡Preséntate ante la Conquistadora Krenna en el Bastión de la Conquista en las Colinas Pardas.‡Présentez-vous à la Conquérante Krenna au Bastion de la Conquête dans les Grisonnes.‡前往灰熊丘陵的征服堡，向征服者克雷娜介绍你自己。‡向征服者克蓮娜自我介紹，她就在灰白之丘的征服堡。',
  }
},
[12488] = {
  {
    'O Alto-executor precisa de você‡Запрос от верховного палача‡Der Hochexekutor braucht Euch‡고위집행관의 부름‡El sumo ejecutor te necesita‡El sumo ejecutor te necesita‡Le grand exécuteur a besoin de vous‡高级执行官需要你‡高階執行官需要你',
    nil,
    'Fale com o Alto-executor Iracundo em Perfídia, que fica no Ermo das Serpes.‡Поговорите с верховным палачом Росом в Ядозлоби, что в Драконьем Погосте.‡Sprecht mit Hochexekutor Zürner in Gallgrimm in der Drachenöde.‡용의 안식처의 원한의 초소에 있는 고위집행관 워로스와 대화해야 합니다.‡Habla con el sumo ejecutor Wroth en Rencor Venenoso, en el Cementerio de Dragones.‡Habla con el sumo ejecutor Wroth en Rencor Venenoso, en el Cementerio de Dragones.‡Parlez au Grand exécuteur Ulcéré à Vexevenin, dans la Désolation des dragons.‡与龙骨荒野怨毒镇的高级执行官乌洛斯谈一谈。‡到龍骨荒野的毒怨之地找高階執行官羅思交談。',
  }
},
[12489] = {
  {
    'Boas-vindas à Bacia Sholazar‡Добро пожаловать в Низину Шолазар‡Willkommen im Sholazarbecken‡숄라자르 분지에서의 환영 인사‡Bienvenido a la Cuenca de Sholazar‡Bienvenido a la Cuenca de Sholazar‡Bienvenue dans le bassin de Sholazar !‡欢迎来到索拉查盆地‡歡迎來到休拉薩盆地',
    nil,
    'Siga a trilha para noroeste para chegar ao acampamento mencionado por Múncio.‡Идите по тропе на запад, пока не дойдете до лагеря, о котором говорил Монти.‡Folgt dem Pfad in Richtung Nordwesten, bis Ihr das Lager erreicht, das Monti erwähnt hat.‡북서쪽 길을 따라 가서 몬테가 말한 야영지로 가야 합니다.‡Sigue el camino hacia el noroeste hasta llegar al campamento que mencionó Monte.‡Sigue el camino hacia el noroeste hasta llegar al campamento que mencionó Monte.‡Suivez le chemin au nord-ouest pour rejoindre le camp que Total a mentionné.‡沿着西北方的道路前往蒙特提到的营地。‡循著往西北方的道路前往蒙特所提及的營地。',
  }
},
[12490] = {
  {
    'A vingança de Veehja‡Месть Вихьи‡Veehjas Rache‡비야의 복수‡La venganza de Veehja‡La venganza de Veehja‡La vengeance de Veehja‡维赫亚的复仇‡薇迦的復仇',
    nil,
    'Veehja, no Altar das Escamas, quer que você mate 6 Marinheiros Skadir, 3 Tecelões de Brumas Skadir e 2 Lança-runas Skadir.‡Убейте 6 скадирских моряков, 3 скадирских ткачей туманов и 2 скадирских заклинателей рун по просьбе Вихьи из Святилища Чешуи.‡Veehja im Schrein der Schuppen möchte, dass Ihr 6 Matrosen der Skadir, 3 Nebelwirker der Skadir und 2 Runenmagier der Skadir erschlagt.‡비늘 제단에 있는 비야가 스카디르 갑판원 6명, 스카디르 안개마술사 3명, 스카디르 룬마술사 2명을 처치해 달라고 부탁했습니다.‡Veehja en el Santuario de Escamas quiere que mates a 6 marinos Skadir, a 3 tejebrumas Skadir y a 2 taumaturgos de runas Skadir.‡Veehja en el Santuario de Escamas quiere que mates a 6 marinos Skadir, a 3 tejebrumas Skadir y a 2 taumaturgos de runas Skadir.‡Veehja, au sanctuaire des Écailles, vous demande de tuer y 6 Mariniers skadir, 3 Tisse-brume skadir et 2 Lanceurs de runes skadir.‡蛇鳞神殿的维赫亚希望你去消灭6个斯卡迪尔水手、3个斯卡迪尔织雾者和2个斯卡迪尔符文法师。‡群鱗聖壇的薇迦要你去殺了6個斯卡迪爾海員、3個斯卡迪爾織霧者和2個斯卡迪爾符文使。',
  }
},
[12491] = {
  {
    'A Cerva Atroz do Cervatroz‡Худое варево Худовара‡Düsterbräus Düsterbräu‡다이어브루의 독한 맥주‡La cerveza temible de Cerveza Temible‡La cerveza temible de Cerveza Temible‡La navre-bière de Navrebière‡科林的烈酒‡恐酒的恐酒',
    nil,
    'Entregue a Cerva Atroz do Cervatroz para Ipfelkofer Barrildechope na CervaFest, perto de Altaforja.‡Отнесите худое варево Худовара Ипфелькоферу Железному Бочонку в лагерь Хмельного фестиваля возле Стальгорна.‡Bringt Düsterbräus Düsterbräu zu Ipfelkofer Eisenfass im Braufestlager in der Nähe von Eisenschmiede.‡다이어브루의 독한 맥주를 아이언포지 근처의 가을 축제 광장에 있는 이펠코퍼 아이언케그에게 전달해야 합니다.‡Dale la cerveza temible de Cerveza Temible a Ipfelkofer Barril de Hierro en el campamento de la Fiesta de la cerveza cerca de Forjaz.‡Dale la cerveza temible de Cerveza Temible a Ipfelkofer Barril de Hierro en el campamento de la Fiesta de la cerveza cerca de Forjaz.‡Donnez la Navre-bière de Navrebière à Ipfelkofer Baril-de-fer au camp de la fête des Brasseurs près de Forgefer.‡将科林的烈酒交给铁炉堡附近美酒节营地的埃菲库格·铁桶。‡將恐酒的恐酒帶到鐵爐堡附近的啤酒節營地交給易菲克佛·鐵桶。',
  }
},
[12492] = {
  {
    'A Cerva Atroz do Cervatroz‡Худое варево Худовара‡Düsterbräus Düsterbräu‡다이어브루의 독한 맥주‡La cerveza temible de Cerveza Temible‡La cerveza temible de Cerveza Temible‡La navre-bière de Navrebière‡科林的烈酒‡恐酒的恐酒',
    nil,
    'Entregue a Cerva Atroz do Cervatroz para Torneiro Barrilantra na CervaFest, perto de Orgrimmar.‡Отнесите худое варево Худовара Слухарю Жмухли в лагерь Хмельного фестиваля возле Оргриммара.‡Bringt Düsterbräus Düsterbräu zu Zapfus Schwindelfass im Braufestlager in der Nähe von Orgrimmar.‡다이어브루의 독한 맥주를 오그리마 근처의 가을 축제 광장에 있는 급사 스윈들케그에게 전달해야 합니다.‡Dale la cerveza temible de Cerveza Temible al espitador Barritimo en el campamento de la Fiesta de la cerveza cerca de Orgrimmar.‡Dale la cerveza temible de Cerveza Temible al espitador Barritimo en el campamento de la Fiesta de la cerveza cerca de Orgrimmar.‡Donnez la navre-bière de Navrebière à Perce Fauchebaril au camp de la fête des Brasseurs près d\'Orgrimmar.‡将科林的烈酒交给奥格瑞玛附近美酒节营地的塔波尔·斯威雷格。‡將恐酒的恐酒帶到奧格瑪附近的啤酒節營地交給泰伯·詐桶。',
  }
},
[12493] = {
  {
    'Tese de JxJ‡Тест PvP‡PvP-Test‡PvP Test‡PvP Test‡PvP Test‡Test PvP‡PvP Test‡PvP測試',
    nil,
    'Mate 10 oponentes.‡Убейте 10 противников.‡Tötet 10 Gegner.‡Kill 10 opponents.‡Mata a 10 oponentes.‡Mata a 10 oponentes.‡Tuez 10 méchants.‡Kill 10 opponents.‡殺死十個對手。',
  }
},
[12494] = {
  {
    '‡УКАЗАТЕЛЬ: приглашение на тренировки по верховой езде (20)‡Flagge: Werbung für den Reitlehrer (20)‡‡FLAG: Riding Trainer Advertisement (20)‡FLAG: Riding Trainer Advertisement (20)‡DRAPEAU: publicité du maître de monte (20)‡旗帜:骑术训练师启事(20)‡',
    nil,
    nil,
  }
},
[12495] = {
  {
    'Audiência com a Rainha Dragonesa‡Аудиенция у королевы драконов‡Audienz bei der Drachenkönigin‡용의 여왕 알현‡Una audiencia con la reina de dragones‡Una audiencia con la reina de dragones‡Une audience auprès de la reine dragon‡巨龙女王的指引‡晉見龍后',
    nil,
    'Fale com Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Отыщите Алекстразу Хранительницу Жизни в храме Драконьего Покоя в Драконьем Погосте.‡Geht zum Wyrmruhtempel in der Drachenöde und sucht Alexstrasza die Lebensbinderin auf.‡용의 안식처에 있는 고룡쉼터 사원에서 생명의 어머니 알렉스트라자를 찾아야 합니다.‡Busca a Alexstrasza la Protectora en el Templo del Reposo del Dragón, en el Cementerio de Dragones.‡Busca a Alexstrasza la Protectora en el Templo del Reposo del Dragón, en el Cementerio de Dragones.‡Trouvez Alexstrasza la Lieuse-de-vie au Temple du Repos du ver à la Désolation des dragons.‡在龙骨荒野的龙眠神殿寻找阿莱克丝塔萨，生命的缚誓者。‡在龍骨荒野的龍眠神殿中找到『生命守縛者』雅立史卓莎。',
  }
},
[12496] = {
  {
    'Audiência com a Rainha Dragonesa‡Аудиенция у королевы драконов‡Audienz bei der Drachenkönigin‡용의 여왕 알현‡Una audiencia con la reina de dragones‡Una audiencia con la reina de dragones‡Une audience auprès de la reine dragon‡巨龙女王的指引‡晉見龍后',
    nil,
    'Fale com Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Отыщите Алекстразу Хранительницу Жизни в храме Драконьего Покоя в Драконьем Погосте.‡Geht zum Wyrmruhtempel in der Drachenöde und sucht Alexstrasza die Lebensbinderin auf.‡용의 안식처에 있는 고룡쉼터 사원에서 생명의 어머니 알렉스트라자를 찾아야 합니다.‡Busca a Alexstrasza la Protectora en el Templo del Reposo del Dragón, en el Cementerio de Dragones.‡Busca a Alexstrasza la Protectora en el Templo del Reposo del Dragón, en el Cementerio de Dragones.‡Trouvez Alexstrasza la Lieuse-de-vie au Temple du Repos du ver, à la Désolation des dragons.‡在龙骨荒野的龙眠神殿寻找阿莱克丝塔萨，生命的缚誓者。‡在龍骨荒野的龍眠神殿找『生命守縛者』雅立史卓莎。',
  }
},
[12497] = {
  {
    'Galakrond e o Flagelo‡Галакронд и армия Плети‡Galakrond und die Geißel‡갈라크론드와 스컬지‡Galakrond y la Plaga‡Galakrond y la Plaga‡Galakrond et le Fléau‡迦拉克隆与天灾军团‡葛拉克朗與天譴軍團',
    nil,
    'Fale com Torastrasza no Templo do Repouso das Serpes, que fica no Ermo das Serpes.‡Поговорите с Торастразой в храме Драконьего Покоя на Драконьем Погосте.‡Sprecht mit Torastrasza im Wyrmruhtempel in der Drachenöde.‡용의 안식처에 있는 고룡쉼터 사원의 토라스트라자와 대화해야 합니다.‡Habla con Torastrasza en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Habla con Torastrasza en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Parlez à Torastrasza au Temple du Repos du ver de la Désolation des dragons.‡与龙骨荒野龙眠神殿的托拉斯塔萨谈一谈。‡和托菈史卓莎交談，他就在龍骨荒野的龍眠神殿。',
  }
},
[12498] = {
  {
    'Em asas de rubi‡На рубиновых крыльях‡Auf rubinroten Schwingen‡루비의 날개 위에‡Sobre unas alas rubí‡Sobre unas alas rubí‡Sur des ailes de rubis‡红龙之翼‡乘著晶紅之翼',
    nil,
    'Destrua 30 Catadores dos Ermos e recupere a Foice de Antiok. Fale com Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes, após cumprir a tarefa.‡Уничтожьте 30 мусорщиков Пустошей и добудьте косу Антиока. При выполнении задания возвращайтесь к Алекстразе Хранительнице Жизни в храм Драконьего Покоя.‡Zerstört 30 Ödnisplünderer und beschafft Euch Antioks Sense. Kehrt anschließend zu Alexstrasza der Lebensbinderin im Wyrmruhtempel zurück, solltet Ihr diese Aufgabe abschließen.‡황무지 청소부 30마리를 처치하고 안티오크의 낫을 되찾아야 합니다. 임무를 마친 다음, 고룡쉼터 사원에 있는 생명의 어머니 알렉스트라자에게 돌아가십시오.‡Mata a 30 carroñeros de baldío y recupera la guadaña de Antiok. Vuelve junto a Alexstrasza la Protectora en el Templo del Reposo del Dragón si completas esta misión.‡Mata a 30 carroñeros de baldío y recupera la guadaña de Antiok. Vuelve junto a Alexstrasza la Protectora en el Templo del Reposo del Dragón si completas esta misión.‡Détruisez 30 Charognards du désert et récupérez la faux d\'Antiok. Retournez auprès d\'Alexstrasza la Lieuse-de-vie au Temple du Repos du ver si vous parvenez à accomplir cette tâche.‡消灭30个废土挖掘者并夺取安提沃克的镰刀。完成这个任务之后，回到龙眠神殿去找阿莱克丝塔萨，生命的缚誓者。‡消滅30個荒原拾荒者，並收回安提歐克的鐮刀。一旦你完成這項任務，就返回龍眠神殿向『生命守縛者』雅立史卓莎回報。',
  }
},
[12499] = {
  {
    'Retorno a Angrathar‡Возвращение в Ангратар‡Die Rückkehr nach Angrathar‡앙그라타르로 귀환‡Regresa a Angrathar‡Regresa a Angrathar‡Retour à Angrathar‡返回安加萨‡回到安格拉薩',
    nil,
    'Fale com o Grão-lorde Bolvar Fordragon, no Forte Fordragon, e conte a ele da sua vitória sobre o Flagelo.‡Поговорите с верховным лордом Болваром Фордрагоном в крепости Фордрагона и расскажите ему о своей победе над силами Плети.‡Sprecht mit Hochlord Bolvar Fordragon in der Feste Fordragon und erzählt ihm von Eurem Sieg über die Geißel.‡폴드라곤 요새에 있는 대영주 볼바르 폴드라곤에게 돌아가, 스컬지에 대항해 승리를 거두었음을 알려야 합니다.‡Habla con el alto señor Bolvar Fordragón en el Bastión de Fordragón y cuéntale tu victoria sobre la Plaga.|n‡Habla con el alto señor Bolvar Fordragón en el Bastión de Fordragón y cuéntale tu victoria sobre la Plaga.|n‡Parlez au Généralissime Bolvar Fordragon au Bastion Fordragon et rapportez-lui votre victoire contre le Fléau.‡回到弗塔根要塞，向伯瓦尔·弗塔根公爵汇报你对天灾军团取得的胜利。‡與弗塔根堡的大領主伯瓦爾·弗塔根談談，並告知他有關你戰勝天譴軍團的事。',
  }
},
[12500] = {
  {
    'Retorno a Angrathar‡Возвращение в Ангратар‡Die Rückkehr nach Angrathar‡앙그라타르로 귀환‡Regresa a Angrathar‡Regresa a Angrathar‡Retour à Angrathar‡返回安加萨‡回到安格拉薩',
    nil,
    'Fale com Saurfang, o Jovem, na Vanguarda Kor\'kron, e conte a ele sobre a derrota do Flagelo.‡Поговорите с Саурфангом Младшим в отряде Кор\'крона и расскажите ему о своей победе над силами Плети.‡Sprecht mit Saurfang dem Jüngeren im Vorposten der Kor\'kron und erzählt ihm von Eurem Sieg über die Geißel.‡코르크론 선봉기지에 있는 사울팽의 아들에게 돌아가, 스컬지에 대항해 승리를 거두었음을 알려야 합니다.‡Habla con Colmillosauro el Joven en la Vanguardia Kor\'kron y cuéntale tu victoria sobre la Plaga.‡Habla con Colmillosauro el Joven en la Vanguardia Kor\'kron y cuéntale tu victoria sobre la Plaga.‡Parlez à Saurcroc le Jeune à l\'Avant-garde kor\'kronne et rapportez-lui votre victoire contre le Fléau.‡回到库卡隆先锋营地，向小萨鲁法尔汇报你对天灾军团取得的胜利。‡與柯爾克隆先鋒駐地的小薩魯法爾談談，並告知他有關你戰勝天譴軍團的事。',
  }
},
[12501] = {
  {
    'Patrulha troll‡Тролльский дозор‡Trollpatrouille‡트롤 순찰‡Patrulla trol‡Patrulla trol‡Patrouille anti-trolls‡巡逻员‡食人妖巡邏',
    nil,
    'O Comandante Kunz, na Fortaleza Argêntea, quer que você vá até os quatro postos da Cruzada Argêntea, siga as ordens dos capitães de cada um deles e, depois, apresente-se novamente a ele.|n|nO Capitão Brandão e o Capitão Ruperto estão em Drak\'Sotra, o Capitão Grondel está em Draz\'Agal e o Alquimista Bacamarte está em Heb\'Valok.‡Обойдите четыре заставы Серебряного Авангарда, выполните приказы капитанов и возвратитесь к командиру Кунцу на Серебряную заставу с докладом.|n|nЗаставы капитана Брендона и капитана Руперта расположены в Драк\'Сотре, к юго-востоку, застава капитана Гронделя – в Драк\'Агале, прямо на восток, а застава алхимика Финкльштейна – в Хеб\'Валоке, к северу.‡Kommandant Kunz von der Argentumwache möchte, dass Ihr die vier Posten des Argentumkreuzzugs besucht, die Befehle der dortigen Hauptmänner ausführt und anschließend zurückkehrt und Bericht erstattet.|n|nHauptmann Brandon und Hauptmann Rupert sind in Drak\'Sotra stationiert, Hauptmann Grondel findet Ihr in Drak\'Agal und Alchemist Finkelstein am Posten von Heb\'Valok.‡은빛십자군 격전지에 있는 사령관 쿤즈가 은빛십자군 초소를 방문해 각 대장이 주는 임무를 마치고 돌아와서 보고해 달라고 했습니다.|n|n대장 브랜든과 대장 루퍼트는 드락소트라에, 대장 그론델은 드락아갈에, 연금술사 핀클스타인은 헤브발로크에 있습니다.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡Le Commandant Kunz du Séjour d\'Argent vous a demandé de vous rendre aux quatre postes de la Croisade d\'argent, de suivre les ordres de leurs capitaines et de revenir ensuite lui faire un rapport.|n|nLe capitaine Brandon et le capitaine Rupert se trouvent à Drak\'Sotra, le capitaine Grondel à Drak\'Agal, et l\'alchimiste Finklestein à Heb\'Valok.‡银色前沿的指挥官库恩斯要你拜访四座银色北伐军的岗哨，并完成那里的上尉交给你的任务，然后回去向他复命。|n|n布兰顿上尉和鲁伯特上尉驻扎在达克索塔。|n|n格隆迪尔上尉驻扎在达克迦尔。|n|n炼金师菲肯斯坦驻扎在赫布瓦罗。‡銀白看臺的指揮官康茲要你造訪四座銀白十字軍崗哨，遵從該處上尉的命令，完成後回報給他。布蘭登上尉和魯伯特上尉駐守在德拉克索璀，格隆戴爾上尉駐守在德拉克亞苟，而鍊金師芬克斯坦駐守在希伯伐洛克。',
  }
},
[12502] = {
  {
    'Patrulha troll: padrões elevados‡Тролльский дозор: выше знамена!‡Trollpatrouille: Standarten hoch‡트롤 순찰: 깃발을 높이 올려라‡Patrulla trol: Estandartes en alto‡Patrulla trol: Estandartes en alto‡Patrouille anti-trolls : hissez les étendards !‡巡逻员：战旗飘扬‡食人妖巡邏:旗幟高揚',
    nil,
    'O Capitão Brandão quer que você coloque o Estandarte da Cruzada Argêntea nos Pedestais Drakkari, que ficam em Drak\'Sotra.‡По поручению капитана Брендона расставьте знамена Серебряного Авангарда на пьедесталах Драккари в Драк\'Сотре.‡Hauptmann Brandon möchte, dass Ihr das Banner des Argentumkreuzzugs auf den Drakkaripodesten in Drak\'Sotra aufstellt.‡대장 브랜든이 은빛십자군 깃발을 드락소트라의 드라카리 단상에 꽂아 달라고 했습니다.‡El capitán Brandon quiere que coloques el estandarte de la Cruzada Argenta en los pedestales Drakkari de Drak\'Sotra.‡El capitán Brandon quiere que coloques el estandarte de la Cruzada Argenta en los pedestales Drakkari de Drak\'Sotra.‡Le Capitaine Brandon vous a demandé de placer la Bannière de la Croisade d\'argent sur les Piédestaux drakkari à Drak\'Sotra‡布兰顿上尉要你将银色北伐军战旗挂在达克索塔的达卡莱支架上。‡布蘭登上尉要你將銀白十字軍旌旗放置在德拉克索璀的德拉克瑞石臺上。',
  }
},
[12503] = {
  {
    'Defenda a Fortaleza‡Защита заставы‡Verteidigt die Stellung‡언덕을 사수하라‡Defiende el Confín‡Defiende el Confín‡Séjour de paix‡保卫银色前沿‡守護看臺',
    nil,
    'O Comandante Falstaav lhe conferiu a tarefa de destruir 10 servos quaisquer do Flagelo no pátio, na Fortaleza Argêntea.‡По поручению командира Фальштава убейте 10 приспешников Плети во внутреннем дворе Серебряной заставы.‡Kommandant Falstaav hat Euch damit beauftragt, 10 beliebige Diener der Geißel auf dem Hof der Argentumwache zu vernichten.‡사령관 팔스타브가 은빛십자군 격전지 마당에서 종류에 관계없이 스컬지 10마리를 처치하라고 했습니다.‡El comandante Falstaav te ha encargado que acabes con 10 enemigos de la Plaga en el patio de El Confín Argenta.‡El comandante Falstaav te ha encargado que acabes con 10 enemigos de la Plaga en el patio de El Confín Argenta.‡Le Commandant Falstaav vous a demandé de détruire 10 créatures du Fléau dans la cour du Séjour d\'Argent.‡指挥官法斯塔夫要你到银色前沿的庭院中去，消灭任意10个天灾军团士兵。‡指揮官法爾斯戴夫派你去銀白看臺庭院區內殺掉10名天譴軍團成員。',
  }
},
[12504] = {
  {
    'Cruzada Argêntea, estamos partindo!‡Серебряный Авангард, уходим!‡Der Argentumkreuzzug rückt ab!‡은빛십자군, 여길 떠난다!‡¡Cruzada Argenta, nos vamos!‡¡Cruzada Argenta, nos vamos!‡Croisade d\'argent, parés au départ !‡银色北伐军，撤退！‡銀白十字軍，我們要離開了!',
    nil,
    'O Sargento Malhomonte, no Altar de Sseratus, quer que você diga a 10 dos Soldados Argênteos para se apresentarem a ele.‡Поговорите с 10 солдатами Серебряного Авангарда и скажите им, чтобы они немедленно возвращались к сержанту Метателю Молота к алтарю Шшератуса.‡Unteroffizier Stackhammer am Altar von Sseratus möchte, dass Ihr mit 10 seiner Argentumsoldaten sprecht und ihnen sagt, dass sie sich bei ihm zurückmelden sollen.‡하사관 스택해머에게 보고하라는 명령을 은빛십자군 병사 10명에게 전한 다음, 세라투스의 제단에 있는 하사관 스택해머에게 돌아와야 합니다.‡El sargento Martillo Estragos del Altar de Sseratus quiere que hables con 10 de sus soldados Argenta y les digas que se presenten ante él.‡El sargento Martillo Estragos del Altar de Sseratus quiere que hables con 10 de sus soldados Argenta y les digas que se presenten ante él.‡Le Sergent Stockemarteau, à l\'Autel de Sseratus, vous demande de parler avec 10 de ses Soldats d\'argent et de leur dire de revenir au rapport.‡西莱图斯祭坛的斯塔哈默中士要你和10个银色士兵交谈，让他们回去向他复命。‡司瑟拉圖斯祭壇的疊錘中士要你去跟10名他手下的銀白士兵談談，並要求他們向他回報。',
  }
},
[12505] = {
  {
    'Novas ordens para o Sargento Malhomonte‡Новый приказ для сержанта Метателя Молота‡Neue Befehle für Unteroffizier Stackhammer‡하사관 스택해머 만나기‡Nuevas órdenes para el sargento Martillo Estragos‡Nuevas órdenes para el sargento Martillo Estragos‡De nouveaux ordres pour le sergent Stockemarteau‡给斯塔哈默中士的新命令‡給疊錘中士的新指令',
    nil,
    'O Comandante Kunz quer que você entregue as Novas Ordens de Posicionamento ao Sargento Malhomonte no Altar de Sseratus.‡По поручению командира Кунца доставьте приказ о передислокации сержанту Метателю Молота к алтарю Шшератуса.‡Kommandant Kunz hat Euch gebeten, Unteroffizier Stackhammer am Altar von Sseratus die Neuen Einsatzbefehle zu bringen.‡사령관 쿤즈가 새 배치 명령서를 세라투스의 제단에 있는 하사관 스택해머에게 전달해 달라고 했습니다.‡El comandante Kunz te ha pedido que lleves las nuevas órdenes de despliegue al sargento Martillo Estragos en el Altar de Sseratus.‡El comandante Kunz te ha pedido que lleves las nuevas órdenes de despliegue al sargento Martillo Estragos en el Altar de Sseratus.‡Le Commandant Kunz vous a demandé de remettre les Nouveaux ordres de déploiement au Sergent Stockemarteau à l\'Autel de Sseratus.‡指挥官库恩斯要你把调度命令交给西莱图斯祭坛的斯塔哈默中士。‡中尉康茲要你將新的部署命令送到司瑟拉圖斯祭壇交給疊錘中士。',
  }
},
[12506] = {
  {
    'Complicações no Altar de Sseratus‡Волнения у алтаря Шшератуса‡Ärger am Altar von Sseratus‡세라투스 제단의 문제‡Problemas en el Altar de Sseratus‡Problemas en el Altar de Sseratus‡Ennuis d\'autel‡西莱图斯祭坛的麻烦‡司瑟拉圖斯祭壇的麻煩',
    nil,
    'O Bagateiro Ubungo, na Fortaleza Argêntea, pediu para você investigar o prédio principal do altar no Altar de Sseratus.‡По поручению мастера проклятий Убунго отправляйтесь на разведку в главный храм у алтаря Шшератуса.‡Verhexer Ubungo in der Argentumwache möchte, dass Ihr das Hauptaltargebäude auf dem Altar von Sseratus untersucht.‡은빛십자군 격전지에 있는 주술사 우분고가 세라투스의 제단의 중앙 건물 안을 조사해 달라고 부탁했습니다.‡El aojador Ubungo de El Confín Argenta te ha pedido que investigues el edificio principal del Altar de Sseratus.‡El aojador Ubungo de El Confín Argenta te ha pedido que investigues el edificio principal del Altar de Sseratus.‡Le Maléficieur Ubungo, du Séjour d\'Argent, vous a demandé d\'explorer le bâtiment principal de l\'autel à l\'Autel de Sseratus.‡银色前沿的妖术师乌布戈要你去调查西莱图斯祭坛的主建筑。‡銀白看臺的妖術師烏邦茍要你去調查司瑟拉圖斯祭壇的主祭壇建築。',
  }
},
[12507] = {
  {
    'Mojo estranho‡Странная настойка‡Seltsames Mojo‡기묘한 모조‡Mojo extraño‡Mojo extraño‡Étrange mojo‡奇怪的魔精‡奇怪的魔精',
    nil,
    'Entregue o Mojo Estranho ao Bagateiro Ubungo na Fortaleza Argêntea, em Zul\'Drak.‡Отнесите странную настойку мастеру проклятий Убунго на Серебряную заставу.‡Liefert das seltsame Mojo bei Verhexer Ubungo in der Argentumwache ab.‡기묘한 모조를 은빛십자군 격전지에 있는 주술사 우분고에게 전달해야 합니다.‡Llévale el mojo extraño al aojador Ubungo de El Confín Argenta.‡Llévale el mojo extraño al aojador Ubungo de El Confín Argenta.‡Apportez le Mojo étrange au Maléficieur Ubungo au Séjour d\'Argent.‡把奇怪的魔精交给银色前沿的妖术师乌布戈。‡將奇怪的魔精帶給銀白看臺的妖術師烏邦茍。',
  }
},
[12508] = {
  {
    'Passando o rodo‡Зачистка территории‡Die Sache erledigen‡추종자 처단‡Haciendo limpieza‡Haciendo limpieza‡Passer la serpillère‡扫清巨魔‡完成任務',
    nil,
    'A Cabo Magha, no Altar de Sseratus, quer que você mate qualquer combinação de 10 Campeões de Sseratus, Sacerdotes de Sseratus ou Encantadores de Cobra Drakkari.‡По поручению капрала Маги у алтаря Шшератуса убейте 10 приверженцев Шшератуса – воителей Шшератуса, жрецов Шшератуса или факиров драккари.‡Korporal Mala am Altar von Sseratus möchte, dass Ihr Champions von Sseratus, Priester von Sseratus oder Schlangenführer der Drakkari tötet - insgesamt jedoch 10.‡세라투스의 제단에 있는 하사관 마가가 세라투스의 용사, 세라투스의 사제, 드라카리 뱀 조련사를 종류에 상관없이 총 10명 처치해 달라고 부탁했습니다.‡La cabo Maga del Altar de Sseratus quiere que mates una combinación cualquiera de 10 campeones de Sseratus, sacerdotes de Sseratus o cuidadores de serpientes Drakkari.‡La cabo Maga del Altar de Sseratus quiere que mates una combinación cualquiera de 10 campeones de Sseratus, sacerdotes de Sseratus o cuidadores de serpientes Drakkari.‡Le Caporal Maga, à l\'Autel de Sseratus, veut que vous tuiez 10 fidèles de Sseratus parmi les Champions de Sseratus, les Prêtres de Sseratus et les Charmeurs de serpents drakkari.‡西莱图斯祭坛的玛加下士要你杀死任意10个西莱图斯勇士、西莱图斯祭司或达卡莱驯蛇者。‡司瑟拉圖斯祭壇的瑪嘉下士要你去殺了總計10名的司瑟拉圖斯勇士，司瑟拉圖斯祭師或德拉克瑞控蛇者 。',
  }
},
[12509] = {
  {
    'Patrulha troll: fortitude intestinal‡Тролльский дозор: сила духа‡Trollpatrouille: Starker Magen‡트롤 순찰: 배짱 키우기‡Patrulla trol: Fortaleza intestinal‡Patrulla trol: Fortaleza intestinal‡Patrouille anti-trolls : un peu de courage !‡巡逻员：鼓舞士气‡食人妖巡邏:勇氣',
    nil,
    'O Capitão Ruperto, em Drak\'Sotra, quer que você recupere a coragem dos Recrutas da Cruzada covardes.‡По поручению капитана Руперта из Драк\'Сотры поднимите боевой дух рекрутов Серебряного ордена.‡Hauptmann Rupert in Drak\'Sotra möchte, dass Ihr den Mut der kauernden Rekruten des Kreuzzugs wiederherstellt.‡드락소트라에 있는 대장 루퍼트가 겁먹은 십자군 보충병에게 용기를 북돋워 달라고 부탁했습니다.‡El capitán Rupert de Drak\'Sotra quiere que les devuelvas el valor a los acobardados reclutas de la Cruzada.‡El capitán Rupert de Drak\'Sotra quiere que les devuelvas el valor a los acobardados reclutas de la Cruzada.‡Le Capitaine Rupert, à Drak\'Sotra, vous demande de redonner du courage aux Recrues de la Croisade.‡达克索塔的鲁伯特上尉要你去让那些恐惧的北伐军新兵重新振作起来。‡德拉克索璀的魯伯特上尉要你去替畏縮的十字軍新兵回復勇氣。',
  }
},
[12510] = {
  {
    'Fluidos elementais preciosos‡Совершенные элементальные флюиды‡Kostbare elementare Flüssigkeiten‡고귀한 정령의 영액‡Fluidos preciosos de elemental‡Fluidos preciosos de elemental‡Des fluides élémentaires précieux‡珍贵的元素液体‡珍貴的元素液體',
    nil,
    'O Bagateiro Ubungo, na Fortaleza Argêntea, quer que você obtenha 3 Fluidos Elementais Preciosos.‡Добудьте 3 образца совершенных элементальных флюидов для мастера проклятий Убунго с Серебряной заставы.‡Verhexer Ubungo in der Argentumwache möchte, dass Ihr 3 kostbare elementare Flüssigkeiten beschafft.‡은빛십자군 격전지에 있는 주술사 우분고가 고귀한 정령의 영액을 가져다 달라고 했습니다.‡El aojador Ubungo de El Confín Argenta quiere que consigas 3 fluidos preciosos de elemental.‡El aojador Ubungo de El Confín Argenta quiere que consigas 3 fluidos preciosos de elemental.‡Le Maléficieur Ubungo, au Séjour d\'Argent, veut que vous obteniez 3 Fluides élémentaires précieux.‡银色前沿的妖术师乌布戈要你收集3份珍贵的元素液体。‡銀白看臺的妖術師烏邦茍要你取得3個珍貴的元素液體。',
  }
},
[12511] = {
  {
    'Para as montanhas!‡У холмов есть не только глаза‡Die Hügel der bärigen Augen‡구릉지의 난관‡Las colinas tienen ojos‡Las colinas tienen ojos‡Les Grisonnes ont besoin de nous‡丘陵援兵‡我們在灰白之丘的軍隊',
    nil,
    'Apresente-se ao Tenente Dumont no Chalé do Pinho Âmbar na parte oeste da Serra Gris.‡Отметьтесь у лейтенанта Думонта в Приюте Янтарной Сосны в западной части Седых холмов.‡Meldet Euch bei Leutnant Dumont bei der Ammertannhütte in den westlichen Grizzlyhügeln.‡회색 구릉지 서부의 호박빛소나무 오두막에 있는 부관 듀몬트에게 보고해야 합니다.‡Preséntate ante el teniente Dumont en el refugio Pino Ámbar al oeste de las Colinas Pardas.|n‡Preséntate ante el teniente Dumont en el refugio Pino Ámbar al oeste de las Colinas Pardas.|n‡Présentez-vous au Lieutenant Dumont, au Gîte Ambrepin, dans l\'ouest des Grisonnes.‡前往灰熊丘陵的西部，向琥珀松木营地的杜蒙特中尉报告。‡前往灰白之丘西邊的琥珀松小屋向都蒙特中尉回報。',
  }
},
[12512] = {
  {
    'Ninguém fica para trás‡Спасти всех‡Lasst niemanden zurück‡죽어도 함께 죽는다‡Que nadie se quede atrás‡Que nadie se quede atrás‡Ne laissez personne derrière vous‡一个也不能少‡一個都不能少',
    nil,
    'O Dr. Rogers, em Drak\'Sotra, quer que você encontre o Cruzado Lamoof, o Cruzado Jonas e a Cruzada Josefina. Use a Bandagem do Cruzado neles e acompanhe-os até o Dr. Rogers.‡Разыщите рыцаря Ламуфа, рыцаря Джонатана и рыцаря Жозефину. Перевяжите их раны бинтами и проводите к доктору Роджерсу в Драк\'Сотру.‡Dr. Rogers in Drak\'Sotra möchte, dass Ihr Kreuzfahrer Lamoof, Kreuzfahrer Jonathan und Kreuzfahrerin Josephine findet. Legt ihnen dann die Verbände des Kreuzfahrers an und gebt ihnen so lange Geleitschutz, bis sie bei Dr. Rogers angelangt sind.‡드락소트라에 있는 박사 로저스가 성전사 라무프, 성전사 조나단, 성전사 조세핀을 찾아, 성전사의 붕대를 사용한 다음 그들을 안전하게 호위해 돌아와 달라고 부탁했습니다.‡El Dr. Rogers, en Drak\'Sotra, quiere que encuentres al cruzado Lamoof, al cruzado Jonathan y a la cruzada Josephine. Ponles la venda de cruzado y procura que vuelvan sanos y salvos junto al Dr. Rogers.‡El Dr. Rogers, en Drak\'Sotra, quiere que encuentres al cruzado Lamoof, al cruzado Jonathan y a la cruzada Josephine. Ponles la venda de cruzado y procura que vuelvan sanos y salvos junto al Dr. Rogers.‡Le Dr Rogers à Drak\'Sotra veut que vous trouviez le Croisé Lamoof, le Croisé Jonathan et la Croisée Joséphine. Utilisez le Bandage de croisé sur eux, puis mettez-les en sécurité auprès du Dr Rogers.‡达克索塔的罗杰斯博士要你找到北伐军战士拉莫夫、北伐军战士乔纳森和北伐军战士约瑟芬。对他们使用北伐军的绷带，并护送他们安全回来。‡德拉克索璀的羅傑斯醫生要求你，找到十字軍拉姆夫、十字軍強納森、和十字軍約瑟芬，在他們身上使用十字軍繃帶，並護送他們安全回到羅傑斯醫生處。',
  }
},
[12513] = {
  {
    'Belo chapéu...‡Милая шляпка...‡Netter Hut...‡멋진 모자군요...‡Bonito sombrero...‡Bonito sombrero...‡Un joli chapeau...‡好帽子......‡漂亮的帽子……',
    nil,
    'Dom Ramón desafiou você dizendo que você não é capaz de derrotá-lo no passado, na Antiga Eira dos Montes. Depois disso, traga o Chapéu do Dom Ramón para ele mesmo, como prova, em Tanaris.‡Сам того не желая, Дон Карлос сподвиг вас сразиться с ним молодым в Старом Хилсбраде. Принесите ему шляпу Дона Карлоса в доказательство вашей победы. Он будет ждать вас в Танарисе.‡Don Carlos hat Euch versehentlich dazu herausgefordert, sein jüngeres Ich im Alten Hügelland zu besiegen. Bringt ihm anschließend seinen Hut als Beweis. Er befindet sich in Tanaris.‡돈 카를로스가 무심결에 옛 힐스브래드에 있는 젊은 돈 카를로스를 이겨보라고 제안했습니다. 싸움에 이긴 증거로 돈 카를로스의 모자를 타나리스에 있는 그에게 가져가야 합니다.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos vous a, par inadvertance, chargé de défier et vaincre son jeune alter ego de la Hautebrande d\'antan. Lorsque ce sera fait, apportez le Chapeau de don Carlos à Don Carlos, à Tanaris, comme preuve de votre victoire.‡卡洛斯要你进入旧希尔斯布莱德，击败年轻时候的卡洛斯。然后将他的帽子交给塔纳利斯的卡洛斯。‡卡洛斯大爺無意間對你發出挑戰，要你去希爾斯布萊德丘陵舊址擊敗年輕時的他。完成後，將卡洛斯大爺之帽帶回塔納利斯交給他做為證明。',
  }
},
[12514] = {
  {
    'Misturador de cogumelo‡Грибная добавка‡Pilzemixer‡버섯 섞기‡Mezclando champiñones‡Mezclando champiñones‡Un cocktail aux champignons‡蘑菇混合剂‡蘑菇混合者',
    nil,
    'Colete 10 Fungos do Pileque e entregue-os ao Bagateiro Ubungo na Fortaleza Argêntea.‡Соберите 10 грибов-дурманов и принесите их мастеру проклятий Убунго на Серебряную заставу.‡Sammelt 10 Krauskappenfungi und bringt sie zu Verhexer Ubungo in der Argentumwache.‡어리버섯 10개를 모아 은빛십자군 격전지에 있는 주술사 우분고에게 가져가야 합니다.‡Recoge 10 hongos fungilodos y llévaselos al aojador Ubungo en El Confín Argenta.‡Recoge 10 hongos fungilodos y llévaselos al aojador Ubungo en El Confín Argenta.‡Récupérez 10 Champignons chapebrouilles et rapportez-les au Maléficieur Ubungo au Séjour d\'Argent.‡收集10份混乱毒菇，将它们交给银色前沿的妖术师乌布戈。‡收集10朵渾帽菌，並將它們交給銀白看臺的妖術師烏邦茍。',
  }
},
[12515] = {
  {
    'Belo chapéu...‡Милая шляпка...‡Netter Hut...‡멋진 모자군요...‡Bonito sombrero...‡Bonito sombrero...‡Un joli chapeau...‡好帽子......‡漂亮的帽子……',
    nil,
    'Dom Ramón desafiou você dizendo que você não é capaz de derrotá-lo no passado, na Antiga Eira dos Montes. Depois disso, traga o Chapéu do Dom Ramón para ele mesmo, como prova, em Tanaris.‡Сам того не желая, Дон Карлос сподвиг вас сразиться с ним молодым в Старом Хилсбраде. Принесите ему шляпу Дона Карлоса в доказательство вашей победы. Он будет ждать вас в Танарисе.‡Don Carlos hat Euch versehentlich dazu herausgefordert, sein jüngeres Ich im Alten Hügelland zu besiegen. Bringt ihm anschließend seinen Hut als Beweis. Er befindet sich in Tanaris.‡돈 카를로스가 무심결에 옛 힐스브래드에 있는 젊은 돈 카를로스를 이겨보라고 제안했습니다. 싸움에 이긴 증거로 돈 카를로스의 모자를 타나리스에 있는 그에게 가져가야 합니다.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos te ha retado involuntariamente a que derrotes a su yo joven en la Antigua Trabalomas. Después, llévale el sombrero de Don Carlos a Tanaris como prueba.‡Don Carlos vous a, par inadvertance, chargé de défier et vaincre son jeune alter ego de la Hautebrande d\'antan. Lorsque ce sera fait, apportez le Chapeau de don Carlos à Don Carlos, à Tanaris, comme preuve de votre victoire.‡卡洛斯要你进入旧希尔斯布莱德，击败年轻时候的卡洛斯。然后将他的帽子交给塔纳利斯的卡洛斯。‡卡洛斯大爺無意間對你發出挑戰，要你去希爾斯布萊德丘陵舊址擊敗年輕時的他。完成後，將卡洛斯大爺之帽帶回塔納利斯交給他做為證明。',
  }
},
[12516] = {
  {
    'Colhendo bons frutos‡Хорошенького понемножку‡Zu viel des Guten‡과유불급‡Exceso de algo bueno‡Exceso de algo bueno‡Il ne faut pas abuser des bonnes choses‡过犹不及‡樂極生悲',
    nil,
    'Assassine o Profeta de Sseratus Embriagado e depois fale novamente com o Bagateiro Ubungo na Fortaleza Argêntea.‡Убейте одурманенного пророка Шшератуса и возвращайтесь к мастеру проклятий Убунго на Серебряную заставу.‡Erschlagt den verworrenen Propheten von Sseratus und kehrt anschließend zu Verhexer Ubungo in der Argentumwache zurück.‡혼란스러운 세라투스의 예언자를 처치한 다음 은빛십자군 격전지에 있는 주술사 우분고에게 돌아가야 합니다.‡Mata al profeta de Sseratus confuso y vuelve al aojador Ubungo en El Confín Argenta.‡Mata al profeta de Sseratus confuso y vuelve al aojador Ubungo en El Confín Argenta.‡Tuez le Prophète troublé de Sseratus et retournez auprès du Maléficieur Ubungo au Séjour d\'Argent.‡杀死混乱的西莱图斯先知，然后向银色前沿的妖术师乌布戈复命。‡殺掉混亂的司瑟拉圖斯預言者，然後回到銀白看臺回報妖術師烏邦茍。',
  }
},
[12517] = {
  {
    'Baralho de Ladinos‡Карты Новолуния: колода Разбойников‡Schurkenkartenset‡도적 카드 한 벌‡La baraja de Pícaros‡La baraja de Pícaros‡Suite de Voleurs‡盗贼套牌‡群盜套卡',
    nil,
    'Use o Baralho de Ladinos para evocar uma Cartomante de Negraluna e entregue o baralho a ela.‡Призовите предсказателя судьбы с Ярмарки Новолуния и отдайте ему колоду Разбойников.‡Beschwört mithilfe des Schurkenkartensets einen Wahrsager des Dunkelmond-Jahrmarkts und gebt ihm das Set.‡도적 카드 한 벌로 다크문 점술사를 소환한 다음 카드를 돌려줘야 합니다.‡Usa la baraja de Pícaros para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Usa la baraja de Pícaros para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Utilisez la Suite de Voleurs pour invoquer une Diseuse de bonne aventure de la foire de Sombrelune et donnez-lui la suite.‡使用盗贼套牌召唤一位暗月占卜师，并把套牌交给占卜师。‡使用群盜套卡召喚一位暗月算命師，然後把套卡交給他。',
  }
},
[12518] = {
  {
    'Baralho de Magos‡Карты Новолуния: колода Магов‡Magierkartenset‡마법사 카드 한 벌‡La baraja de Magos‡La baraja de Magos‡Suite de Mages‡法师套牌‡法師套卡',
    nil,
    'Use o Baralho de Magos para evocar uma Cartomante de Negraluna e entregue o baralho a ela.‡Призовите предсказателя судьбы с Ярмарки Новолуния и отдайте ему колоду Магов.‡Beschwört mithilfe des Magierkartensets einen Wahrsager des Dunkelmond-Jahrmarkts und gebt ihm das Set.‡마법사 카드 한 벌로 다크문 점술사를 소환한 다음 카드를 돌려줘야 합니다.‡Usa la baraja de Magos para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Usa la baraja de Magos para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Utilisez la Suite de Mages pour invoquer une Diseuse de bonne aventure de la foire de Sombrelune et donnez-lui la suite.‡使用法师套牌召唤一位暗月占卜师，并把套牌交给占卜师。‡使用法師套卡召喚一位暗月算命師，然後把套卡交給他。',
  }
},
[12519] = {
  {
    'Patrulha troll: vai uma medalha?‡Тролльский дозор: сбор медальонов‡Trollpatrouille: Was wollt Ihr - \'ne Medaille?‡트롤 순찰: 머릿수 세기‡Patrulla trol: ¿Qué quieres, una medalla?‡Patrulla trol: ¿Qué quieres, una medalla?‡Patrouille anti-trolls : vous voulez quoi ? Une médaille ?‡巡逻员：你想要勋章？‡食人妖巡邏:你想要啥，一面勳章?',
    nil,
    'O Capitão Grondel, na entrada do Coliseu, quer que você reúna 7 Medalhões Drakkari dos Cadáveres Drakkari próximos.‡Принесите капитану Гронделю к Колизею в Драк\'Агале 7 медальонов Драккари, снятых с убитых троллей Драккари.‡Hauptmann Grondel vor dem Kolosseum möchte, dass Ihr 7 Medaillons der Drakkari von den Drakkarileichen in der Nähe beschafft.‡고뇌의 투기장 바깥에 있는 대장 그론델이 주변의 드라카리 시체에서 드라카리 메달 7개를 가져다 달라고 부탁했습니다.‡El capitán Grondel fuera del Coliseo quiere que recojas 7 medallones Drakkari de los cadáveres Drakkari cercanos.‡El capitán Grondel fuera del Coliseo quiere que recojas 7 medallones Drakkari de los cadáveres Drakkari cercanos.‡Le Capitaine Grondel à l\'extérieur du Colisée vous demande de récupérer 7 Médailles drakkari sur les Cadavres drakkari des alentours.‡斗兽场外面的格隆迪尔上尉要你从附近的达卡莱尸体上收集7枚达卡莱勋章。‡大競技場外的格隆戴爾上尉要你從附近的德拉克瑞屍體上收集7個德拉克瑞勳章。',
  }
},
[12520] = {
  {
    'Maestria dos rinocerontes: o teste‡Охота на люторогов: проверка‡Meister der Rhinozerosjagd: Die Prüfung‡코뿔소 사냥법 익히기: 시험‡Domina el rinoceronte: la prueba‡Domina el rinoceronte: la prueba‡La maîtrise des rhinos : l\'épreuve‡狩猎犀牛：初试身手‡犀牛專精:試煉',
    nil,
    'Mate 15 Rinocerontes Estilhastes e fale novamente com Rosarães Guima, no Acampamento do Rosarães.‡Убейте 15 груборогих люторогов и вернитесь в лагерь Эрнестуэя к Хемингу Эрнестуэю.‡Tötet 15 Splitterhornrhinozerosse und kehrt anschließend zu Hemet Nesingwary in Nesingwarys Basislager zurück.‡수정뿔 코뿔소 15마리를 처치한 다음 네싱워리 주둔지에 있는 헤멧 네싱워리에게 돌아가야 합니다.‡Mata a 15 rinocerontes Trozocuerno y vuelve a ver a Hemet Nesingwary al Campamento Base de Nesingwary.‡Mata a 15 rinocerontes Trozocuerno y vuelve a ver a Hemet Nesingwary al Campamento Base de Nesingwary.‡Tuez 15 Rhinocéros cornéclats et retournez voir Hemet Nesingwary au Camp de base de Nesingwary.‡杀死15头碎角犀牛，然后返回奈辛瓦里营地，向赫米特·奈辛瓦里复命。‡殺死15隻碎角犀牛，再去向奈辛瓦里營地的赫米特·奈辛瓦里回報。',
  }
},
[12521] = {
  {
    'Onde diabos está Rosarães Guima?‡Куда запропастился Хеминг Эрнестуэй?‡Wo in aller Welt ist Hemet Nesingwary?‡헤멧 네싱워리의 행방‡¿Dónde se esconde Hemet Nesingwary?‡¿Dónde se esconde Hemet Nesingwary?‡Où est passé Hemet Nesingwary ?‡赫米特·奈辛瓦里哪去了？‡赫米特·奈辛瓦里到底在哪裡?',
    nil,
    'Fale com o Arquimago Pentarus quando você estiver pronto para partir para a Bacia Sholazar. Ao chegar lá, fale com Múncio Tirambaço no Mangue Verdejante da Bacia Sholazar.‡Поговорите с верховным магом Пентарусом, когда соберетесь отправиться в Низину Шолазар. По прибытии поговорите с Монти Мушкетоном в диких мангровых зарослях Низины Шолазар.‡Ihr befindet Euch auf dieser Quest.‡숄라자르 분지로 떠날 준비가 되면 대마법사 펜타루스와 대화하십시오. 도착하면 숄라자르 분지의 야생수풀 늪지대에 있는 몬테 머즐샷과 대화해야 합니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[12522] = {
  {
    'Precisa de um motor? Pega aí!‡Нужен двигатель – найдем двигатель!‡Brauch \'nen Motor, hol \'nen Motor‡엔진이 필요하면 가지리라‡Necesitar un motor, coger un motor‡Necesitar un motor, coger un motor‡Besoin d\'un moteur ? Servez-vous !‡需要引擎‡需要引擎，就拿一個',
    nil,
    'Veslex Chaveloz, no Acampamento do Rosarães, quer que você lhe traga o Motor de Máquina Voadora.‡Веслекс Вездеключ из лагеря Эрнестуэя просит вас принести ему мотор для ветролета.‡Weslex Schnellzang in Nesingwarys Basislager möchte, dass Ihr ihm den Motor einer Flugmaschine bringt.‡네싱워리 주둔지에 있는 웨슬렉스 퀵렌치가 비행기 엔진을 가져다달라고 부탁했습니다.‡Weslex Llave Rápida en el Campamento Base de Nesingwary quiere que le lleves un motor de máquina voladora.‡Weslex Llave Rápida en el Campamento Base de Nesingwary quiere que le lleves un motor de máquina voladora.‡Weslex Viveclef, au Camp de base de Nesingwary, veut que vous lui rapportiez un Moteur de machine volante.‡奈辛瓦里营地的维斯雷·扭钳要你帮他找到一台飞行器引擎。‡奈辛瓦里營地的威斯雷克斯·迅鉗要你帶一部飛行器引擎給他。',
  }
},
[12523] = {
  {
    'Tem uma peça? Me dê uma!‡Есть детали? – Тащи сюда!‡Hast ein Teil, dann gib ein Teil‡부품을 구하면 주리라‡Tener una parte, dar una parte‡Tener una parte, dar una parte‡Pièces détachées à gogo‡借零件‡零件轉手',
    nil,
    'Traga 7 Peças Sobressalentes da Empreendimentos S.A. para Veslex Chaveloz no Acampamento do Rosarães.‡Принесите 7 запчастей Торговой Компании Веслексу Вездеключу в лагерь Эрнестуэя.‡Bringt 7 Ersatzteile der Venture Co. zu Weslex Schnellzang in Nesingwarys Basislager.‡네싱워리 주둔지에 있는 웨슬렉스 퀵렌치에게 투자개발회사 예비 부품 7개를 가져가야 합니다.‡Trae 7 piezas de repuesto de Ventura y Cía. a Weslex Llave Rápida en el Campamento Base de Nesingwary.‡Trae 7 piezas de repuesto de Ventura y Cía. a Weslex Llave Rápida en el Campamento Base de Nesingwary.‡Apportez 7 Pièces détachées de la KapitalRisk à Weslex Viveclef au Camp de base de Nesingwary.‡将7份风险投资公司备用零件交给奈辛瓦里营地的维斯雷·扭钳。‡將7個風險投資公司備用零件交給奈辛瓦里營地的威斯雷克斯·迅鉗。',
  }
},
[12524] = {
  {
    'Acidente da Empreendimentos S.A.‡Проблемы Торговой Компании‡Missgeschick der Venture Co.‡투자개발회사의 불운‡Desventura de Ventura y Cía.‡Desventura de Ventura y Cía.‡La mésaventure de la KapitalRisk‡风险投资公司的风险‡風險投資公司的禍事',
    nil,
    'Debaar, no Acampamento do Rosarães, quer que você mate 15 membros da Empreendimentos S.A.. Você pode matar tanto Rufiões quanto Escavadores da Empreendimentos S.A.‡Дебаар из лагеря Эрнестуэя хочет, чтобы вы убили 15 членов Торговой Компании. Вы можете убить бузотеров или землечерпов Компании.‡Debaar in Nesingwarys Basislager möchte, dass Ihr 15 Mitglieder der Venture Company tötet. Ihr könnt entweder Grobiane der Venture Co. oder Ausgräber der Venture Co. töten.‡네싱워리 주둔지에 있는 데바르가 투자개발회사 무법자나 발굴인부 15명을 처치해 달라고 부탁했습니다.‡Debaar en el Campamento Base de Nesingwary quiere que mates a 15 miembros de Ventura y Cía. Debes matar a rufianes de Ventura y Cía. o a excavadores de Ventura y Cía.‡Debaar en el Campamento Base de Nesingwary quiere que mates a 15 miembros de Ventura y Cía. Debes matar a rufianes de Ventura y Cía. o a excavadores de Ventura y Cía.‡Debaar, au Camp de base de Nesingwary, veut que vous tuiez 15 membres de la KapitalRisk. Vous pouvez tuer des Forbans de la KapitalRisk ou des Excavateurs de la KapitalRisk, au choix.‡奈辛瓦里营地的蒂巴尔要你去杀死15名风险投资公司雇员，风险投资公司无赖或是风险投资公司挖掘者都可以。‡奈辛瓦里營地的戴巴爾要你去殺死15個風險投資公司的成員。你可以殺死風險投資公司惡棍或是風險投資公司挖掘者。',
  }
},
[12525] = {
  {
    'Tira aquele sorriso da cara dele‡Сотри ухмылку с его лица‡Wischt ihm das Grinsen vom Gesicht‡스윈들그린의 최후‡Bórrale esa sonrisa de la cara‡Bórrale esa sonrisa de la cara‡Effacez-moi ce sourire de son visage‡工头斯温迪格林‡讓他再也笑不出來',
    nil,
    'Mate o Encarregado Vigarício e o Bolofo e, em seguida, fale novamente com Debaar no Acampamento do Rosarães.‡Убейте штейгера Хитрохмыла и его телохранителя Мясного Пирога, а затем вернитесь к Дебаар в лагерь Эрнестуэя.‡Tötet Großknecht Schwindelgrins und Fleischklops und kehrt danach zu Debaar in Nesingwarys Basislager zurück.‡현장감독 스윈들그린과 덩치 큰 아이를 처치한 다음 네싱워리 주둔지에 있는 데바르에게 돌아가야 합니다.‡Mata al supervisor Timomueca y a Pastel de Carne, y vuelve junto a Debaar al Campamento Base de Nesingwary.‡Mata al supervisor Timomueca y a Pastel de Carne, y vuelve junto a Debaar al Campamento Base de Nesingwary.‡Tuez le Contremaître Ricarnaque et Tourte-au-rôt, puis retournez auprès de Debaar au Camp de base de Nesingwary.‡杀死工头斯温迪格林和肉饼，然后返回奈辛瓦里营地，向蒂巴尔复命。‡殺死工頭詐咧與肉派，然後回去找奈辛瓦里營地的戴巴爾。',
  }
},
[12526] = {
  {
    'Maestria dos rinocerontes: a caçada‡Охота на люторогов: погоня‡Beherrschen der Rhinozerosjagd: Die Verfolgung‡코뿔소 사냥법 익히기: 추적‡Domina el rinoceronte: la persecución‡Domina el rinoceronte: la persecución‡La maîtrise des rhinos : la traque‡狩猎犀牛：乘胜追击‡犀牛專精:追捕',
    nil,
    'Fale com o Oráculo Soo-rahm, nos Ossos de Nozronn.‡Поговорите с Оракулом Су-рамом у Скелета Нозронна.‡Sprecht mit Orakel Soo-rahm bei den Knochen von Nozronn.‡노즈론의 무덤에서 점쟁이 수람과 대화해야 합니다.‡Habla con el Oráculo Soo-liloquio en los Huesos de Nozronn.‡Habla con el Oráculo Soo-liloquio en los Huesos de Nozronn.‡Parlez à l\'Oracle Soo-fiett aux Os de Nozronn.‡与诺兹隆之骨的神谕者索乌拉姆谈一谈。‡在諾茲朗之骨和神諭者蘇-臘姆交談。',
  }
},
[12527] = {
  {
    'Tocaieiros glutões‡Прожорливые твари‡Gefräßige Lauerer‡먹보 바실리스크‡Rondadores glotones‡Rondadores glotones‡Rôdeurs gloutons‡贪吃的蜥蜴‡貪吃的潛伏者',
    nil,
    'Entregue 5 Cristais de Basilisco ao Alquimista Bacamarte no santuário, em Heb\'Valok.‡Принесите 5 кристаллов василиска алхимику Финкльштейну в святилище в Хеб\'Валоке.‡Bringt 5 Basiliskenkristalle zu Alchemist Finkelstein im Schrein in Heb\'Valok.‡바실리스크 수정 5개를 헤브발로크의 제단에 있는 연금술사 핀클스타인에게 전달해야 합니다.‡Llévale 5 cristales de basilisco al alquimista Finklestein en el santuario de Heb\'Valok.‡Llévale 5 cristales de basilisco al alquimista Finklestein en el santuario de Heb\'Valok.‡Apportez 5 Cristaux de basilic à l\'Alchimiste Finklestein dans le sanctuaire de Heb\'Valok.‡将5块石化蜥蜴水晶交给赫布瓦罗神殿的炼金师菲肯斯坦。‡把5顆石化蜥蜴水晶交給在希伯伐洛克聖壇的鍊金師芬克斯坦。',
  }
},
[12528] = {
  {
    'Cooperando‡Подыграть несложно‡Gute Miene zum bösen Spiel‡새로운 관계‡Seguir la corriente‡Seguir la corriente‡Jouer le jeu‡伪装奴隶‡配合',
    nil,
    'Apresente-se ao Sumo Xamã Rakjak, no Morro dos Feralma, e diga que você é o novo "escravo".‡Найдите верховного шамана Ракжака на холме Бешеного Сердца и скажите, что вы – его новый "раб".‡Meldet Euch beim Hochschamanen Rakjak auf dem Hügel der Wildherzen und stellt Euch als neuer "Sklave" vor.‡광란의심장 언덕에 있는 대주술사 라크자크에게 새 "노예" 신분으로서 보고해야 합니다.‡Preséntate ante el alto chamán Rakjak en la Colina Corazón Frenético como el nuevo "esclavo".‡Preséntate ante el alto chamán Rakjak en la Colina Corazón Frenético como el nuevo "esclavo".‡Présentez-vous au Haut-chaman Rakjak à la Colline de Frénécœur en tant que nouvel « esclave ».‡以新“奴隶”的身份向狂心岭的高阶萨满祭司拉克亚克报到。‡到狂心之丘，以新「奴隸」的身份向高階薩滿拉克杰克回報。',
  }
},
[12529] = {
  {
    'O escravo do caçador de gorilas‡Раб охотника на обезьян‡Der Sklave der Affenjäger‡고릴라 사냥꾼의 노예‡El esclavo del cazador de monos‡El esclavo del cazador de monos‡L\'esclave du chasseur de singes‡猩猩猎手的奴隶‡猩猩獵人的奴隸',
    nil,
    'Mate 8 Colhedores Falanjões e 6 Agressores Falanjões para o Sumo Xamã Rakjak, no Morro dos Feralma.|n|nSe perder os Grilhões de Goregek, fale com o Ancião Harkek, no Morro dos Feralma.‡Убейте 8 покорных барабанчей и 6 лютых барабанчей по просьбе верховного шамана Ракжака, живущего на холме Бешеного Сердца.|n|nЕсли вы потеряете кандалы Горегека, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Tötet für Hochschamanen Rakjak in den Hügeln der Wildherzen 8 Hartknöchelfutterwühler und 6 Hartknöchelstürmer.|n|nSprecht mit dem Ältesten Harkek im Hügel der Wildherzen, falls Ihr Goregeks Fesseln verlieren solltet.‡굶주린 바위돌기고릴라 8마리와 사나운 바위돌기고릴라 6마리를 처치하고 광란의심장 언덕에 있는 대주술사 라크자크에게 돌아가야 합니다.|n|n고어게크의 족쇄를 잃어버리면 광란의심장 언덕에 있는 장로 하르케크와 이야기하십시오.‡Mata a 8 batidores Callonudillos y 6 destreros Callonudillos para el alto chamán Rakjak de la Colina Corazón Frenético. |n|nSi pierdes los grilletes de Goregek, habla con el anciano Harkek en la Colina Corazón Frenético.‡Mata a 8 batidores Callonudillos y 6 destreros Callonudillos para el alto chamán Rakjak de la Colina Corazón Frenético. |n|nSi pierdes los grilletes de Goregek, habla con el anciano Harkek en la Colina Corazón Frenético.‡Tuez 8 Fourrageurs poings-durs et 6 Fonceurs poings-durs pour le Haut-chaman Rakjak à la Colline de Frénécœur.|n|nSi vous perdez les Chaînes de Goregek, parlez à l\'Ancien Harkek sur la Colline de Frénécœur.‡狂心岭的高阶萨满祭司拉克亚克要你去杀死8只硬皮抢夺者和6只硬皮冲锋者。|n|n如果你弄丢了格拉克伊克的镣铐，就去找狂心岭的长者哈尔卡克。‡為高階薩滿拉克杰克殺死8隻聽話的硬拳和6隻兇殘的硬拳，他就在狂心之丘上。|n|n如果你把茍瑞格克的鐐銬搞丟了，跟狂心之丘的長者哈爾凱克聊聊。',
  }
},
[12530] = {
  {
    'Atormentando os falanginhos‡Вопли барабанчат‡Knöchelchen schikanieren‡비단돌기고릴라 괴롭히기‡Atormentar a los badanudillos‡Atormentar a los badanudillos‡Asticoter les Poings-doux‡狩猎硬皮猩猩‡折磨軟拳',
    nil,
    'Goregek te deu um Cutucador de Falanginhos. Use-o para cutucar os Falanginhos e, assim, chamar a atenção da Matriarca dos Falanjões, tirando-a do esconderijo. Mate a Matriarca dos Falanjões e informe o Sumo Xamã Rakjak sobre a morte dela. Você pode encontrar Rakjak no Morro dos Feralma.|n|nSe perder os Grilhões de Goregek, fale com o Ancião Harkek no Morro dos Feralma.‡Горегек дал вам прут для барабанчат: если потыкать их этим прутом, то на их крики из укрытия появится предводительница стаи барабанчей. Убейте предводительницу стаи и расскажите об этом верховному шаману Ракжаку на холме Бешеного Сердца.|n|nЕсли вы потеряете кандалы Горегека, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Goregek hat Euch einen Knöchelchenpiekser gegeben, den Ihr auf die kleinen Knöchelchen anwenden sollt, um so die Hartknöchelmatriachin aus ihrem Versteck zu locken. Tötet die Hartknöchelmatriachin und erstattet anschließend dem Hochschamanen Rakjak auf dem Hügel der Wildherzen Bericht.|n|nSolltet Ihr Goregeks Fesseln verlieren, sprecht mit dem Ältesten Harkek vom Hügel der Wildherzen.‡고어게크가 비단돌기고릴라용 꼬챙이로 비단돌기고릴라를 찔러 숨어 있는 우두머리 바위돌기고릴라를 유인한 다음 처치하라고 했습니다. 일을 처리하고 난 다음 광란의심장 언덕에 있는 대주술사 라크자크에게 보고하십시오.|n|n고어게크의 족쇄를 잃어버리면 광란의심장 언덕의 장로 하르케크와 이야기하면 됩니다.‡Goregek te ha dado un atizador de badanudillos para hacer que la matriarca Callonudillo salga de su escondite. Mata a la matriarca Callonudillo e informa sobre su muerte al alto chamán Rajak en la Colina Corazón Frenético.|n|nSi pierdes los grilletes de Goregek, habla con el anciano Harkek en la Colina Corazón Frenético.‡Goregek te ha dado un atizador de badanudillos para hacer que la matriarca Callonudillo salga de su escondite. Mata a la matriarca Callonudillo e informa sobre su muerte al alto chamán Rajak en la Colina Corazón Frenético.|n|nSi pierdes los grilletes de Goregek, habla con el anciano Harkek en la Colina Corazón Frenético.‡Goregek vous a donné un Asticoteur à poings-doux. Utilisez-le pour piquer les poings-doux jusqu\'à ce que la Matriarche poing-dur sorte de sa cachette.|n|nTuez la Matriarche poing-dur, et retournez ensuite voir le Haut-chaman Rakjak à la Colline de Frénécœur.|n|nSi vous perdez les Chaînes de Goregek, parlez à l\'Ancien Harkek à la Colline de Frénécœur.‡对软皮猩猩使用格拉克伊克给你的软皮木棍，将雌性硬皮猩猩引出来。击败雌性硬皮猩猩，然后向狂心岭的高阶萨满祭司拉克亚克汇报情况。|n|n如果你弄丢了格拉克伊克的镣铐，就去找狂心岭的长者哈尔卡克。‡苟瑞格克給了你一把軟拳火鉗，用它去戳軟拳，直到硬拳獸穴之母從躲藏處出現。殺死硬拳獸穴之母，然後回到狂心之丘向高階薩滿拉克杰克回報。|n|n如果你弄丟了茍瑞格克的鐐銬，去找狂心之丘的長者哈爾凱克談談。',
  }
},
[12531] = {
  {
    'A ameaça subterrânea‡Подземная угроза‡Bedrohung aus dem Untergrund‡땅속의 위협‡La amenaza subterránea‡La amenaza subterránea‡La menace souterraine‡地下的威胁‡秘密威脅',
    nil,
    'Encontre Serfex sob as areias do rio ao sul, mate-o e leve as garras dele para o Sumo Xamã Rakjak, no Morro dos Feralma.|n|nSe perder o Giz Usado de Dajik, fale com o Ancião Harkek no Morro dos Feralma.‡Разыщите Серфекса под песками южной реки и принесите его коготь верховному шаману Ракжаку на холм Бешеного Сердца.|n|nЕсли вы потеряете кусок мела Дажика, поговорите со Старейшиной Харкеком на холме Бешеного Сердца.‡Findet Serfex unter dem Sand des südlichen Flusses, tötet ihn und bringt seine Klaue zu Hochschamane Rakjak auf dem Hügel der Wildherzen.|n|nWenn Ihr Dajiks gebrauchte Kreide verliert, sprecht mit Ältesten Harkek auf dem Hügel der Wildherzen.‡남쪽 강 모래밭 아래에 있는 서펙스를 추적해서 처치하고, 그 발톱을 광란의심장 언덕에 있는 대주술사 라크자크에게 가져가야 합니다.|n|n다지크의 닳은 분필을 잃어버리면 광란의심장 언덕에 있는 장로 하르케크과 이야기하십시오.‡Encuentra a Serfex bajo las arenas del río sur, mátalo y tráele su garra al alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Encuentra a Serfex bajo las arenas del río sur, mátalo y tráele su garra al alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Trouvez Serfex dans les sables de la rivière sud, tuez-le et rapportez sa Griffe au Haut-chaman Rakjak à la Colline de Frénécœur.|n|nSi vous perdez la Craie usée de Dajik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡前往南部河流的沙滩，找到并杀死瑟菲克斯，将他的爪子交给狂心岭的高阶萨满祭司拉克亚克。|n|n如果你弄丢了达伊克的旧粉笔，就去找狂心岭的长者哈尔卡克。‡在南邊河流沙地找出瑟菲克斯，殺了牠，把牠的爪子帶給狂心之丘的拉克杰克。|n|n如果你弄丟了達吉克的破舊粉筆，去狂心之丘找長者哈爾凱克談談。',
  }
},
[12532] = {
  {
    'A fuga das galinhas!‡Побег из курятника‡Aus dem Staub gemacht!‡닭 잡기!‡¡Se dieron a la fuga!‡¡Se dieron a la fuga!‡Il y a un couac !‡鸡飞狼跳！‡離巢!',
    nil,
    'Capture 12 Galinhas Desgarradas para o Ancião Harkek.|n|nSe perder o Giz Usado de Dajik, fale com o Ancião Harkek, no Morro dos Feralma.‡Поймайте 12 сбежавших куриц для старейшины Харкека.|n|nЕсли вы потеряете кусок мела Дажика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Fangt für den Ältesten Harkek 12 entflohene Hühner.|n|nSolltet Ihr Dajiks gebrauchte Kreide verlieren, sprecht mit dem Ältesten Harkek auf dem Hügel der Wildherzen.‡도망친 닭 12마리를 잡아 장로 하르케크에게 돌아가야 합니다.|n|n다지크의 닳은 분필을 잃어버리면 광란의심장 언덕에 있는 장로 하르케크와 이야기하면 됩니다.‡Atrapa 12 pollos fugitivos para el anciano Harkek.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Atrapa 12 pollos fugitivos para el anciano Harkek.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Capturez 12 Poulets évadés pour l\'Ancien Harkek.|n|nSi vous perdez la Craie usée de Dajik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡捕捉12只逃走的小鸡，然后向长者哈尔卡克复命。|n|n如果你弄丢了达伊克的旧粉笔，就去找狂心岭的长者哈尔卡克。‡替長者哈爾凱克抓住12隻逃跑雞。|n|n如果你弄丟了達吉克的破舊粉筆，去狂心之丘找長者哈爾凱克談談。',
  }
},
[12533] = {
  {
    'O aprendiz do caçador de vespas‡Ученик охотника на ос‡Der Lehrling des Wespenjägers‡말벌 사냥꾼의 수습생‡El aprendiz de cazador de avispas‡El aprendiz de cazador de avispas‡L\'apprenti du Chasse-guêpe‡蓝蜂猎手的学徒‡黃蜂獵人的學徒',
    nil,
    'Mate 6 Vespas Safiras e 9 Zangões Safiras para o Sumo Xamã Rakjak, no Morro dos Feralma.|n|nSe perder o Giz Usado de Dajik, fale com o Ancião Harkek no Morro dos Feralma.‡Убейте 6 ос Сапфирного Улья и 9 рабочих Сапфирного улья для шамана Ракжака, живущего на холме Бешеного Сердца.|n|nЕсли вы потеряете кусок мела Дажика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Tötet für Hochschamanen Rakjak auf dem Hügel der Wildherzen 6 Saphirblaue Schwarmwespen und 9 Saphirblaue Schwarmdronen.|n|nSprecht mit dem Ältesten Harkek auf dem Hügel der Wildherzen, falls Ihr Dajiks gebrauchte Kreide verlieren solltet.‡사파이어 부화장 말벌 6마리와 사파이어 부화장 일꾼 9마리를 제거한 다음 광란의심장 언덕에 있는 대주술사 라크자크에게 돌아와야 합니다.|n|n다지크의 닳은 분필을 잃어버리면 광란의심장 언덕의 장로 하르케크와 이야기하면 됩니다.‡Mata 6 avispas del Enjambre Zafiro y 9 zánganos del Enjambre Zafiro para el alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Mata 6 avispas del Enjambre Zafiro y 9 zánganos del Enjambre Zafiro para el alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Tuez 6 Guêpes de la ruche Saphir et 9 Bourdons de la ruche Saphir pour le Haut-chaman Rakjak à la colline de Frénécœur.|n|nSi vous perdez la Craie usée de Dajik, allez parler à l\'Ancien Harkek sur la Colline de Frénécœur.‡狂心岭的高阶萨满祭司拉克亚克要你杀死6只蓝玉虫巢巨蜂和9只蓝玉虫巢雄蜂。|n|n如果你弄丢了达伊克的旧粉笔，就去找狂心岭的长者哈尔卡克。‡殺死6隻天藍蜂巢黃蜂和9隻天藍蜂巢雄蜂，然後回去找高階薩滿拉克杰克。|n|n如果你弄丟了達吉克的破舊粉筆，去找狂心之丘的長者哈爾凱克聊聊。',
  }
},
[12534] = {
  {
    'A rainha safira‡Матка Сапфирового Улья‡Die Saphirkönigin‡사파이어 여왕‡La reina Zafiro‡La reina Zafiro‡La reine de saphir‡蓝色蜂后‡天藍女王',
    nil,
    'Traga o Aguilhão da Rainha Safira para o Sumo Xamã Rakjak, no Morro dos Feralma.|n|nSe perder o Giz Usado de Dajik, fale com o Ancião Harkek no Morro dos Feralma.‡Принесите жало матки Сапфирного Улья верховному шаману Ракжаку, обитающему на холме Бешеного Сердца.|n|nЕсли вы потеряете кусок мела Дажика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Bringt den Stachel der Saphirkönigin zu Hochschamane Rakjak auf dem Hügel der Wildherzen.|n|nWenn Ihr Dajiks gebrauchte Kreide verliert, wendet Euch an Ältesten Harkek auf dem Hügel der Wildherzen.‡사파이어 여왕의 독침을 광란의심장 언덕에 있는 대주술사 라크자크에게 가져가야 합니다.|n|n다지크의 닳은 분필을 잃어버리면 광란의심장 언덕의 장로 하르케크와 이야기하십시오.‡Llévale el aguijonero de la reina Zafiro al alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Llévale el aguijonero de la reina Zafiro al alto chamán Rakjak en la Colina Corazón Frenético.|n|nSi pierdes la tiza desgastada de Dajik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Rapportez le Dard de la reine de saphir au Haut-chaman Rakjak à la Colline de Frénécœur.|n|nSi vous perdez la Craie usée de Dajik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡将蓝玉虫巢蜂后的钉刺交给狂心岭的高阶萨满祭司拉克亚克。|n|n如果你弄丢了达伊克的旧粉笔，就去找狂心岭的长者哈尔卡克。‡把天藍女王的刺帶去給狂心之丘的高階薩滿拉克杰克。|n|n如果你弄丟了達吉克的破舊粉筆，去狂心之丘找長者哈爾凱克談談。',
  }
},
[12535] = {
  {
    'Preparando os danos‡Кристаллы силы‡Unfug im Gange‡수정 장난‡Malicia en la creación‡Malicia en la creación‡Des bêtises‡恶作剧的材料‡造物的惡作劇',
    nil,
    'O Sumo Xamã Rakjak, no Morro dos Feralma, quer que você colete 8 Veios de Cristal do Pilar Beira-céu.‡Верховный шаман Ракжак с холма Бешеного Сердца хочет, чтобы вы принесли ему 8 кристаллов Небесного Пути.‡Hochschamane Rakjak auf dem Hügel der Wildherzen möchte, dass Ihr ihm 8 Himmelszeltkristallformationen bringt.‡광란의심장 언덕에 있는 대주술사 라크자크가 하늘길 수정 조각 8개를 가져와 달라고 했습니다.‡El alto chamán Rakjak en la Colina Corazón Frenético quiere 8 marañas de cristal Trecho Celestial.‡El alto chamán Rakjak en la Colina Corazón Frenético quiere 8 marañas de cristal Trecho Celestial.‡Récupérez 8 Grappes de cristaux pour le Haut-chaman Rakjak à la Colline de Frénécœur.‡狂心岭的高阶萨满祭司拉克亚克要你去收集8块通天水晶簇。‡狂心之丘的高階薩滿拉克杰克需要8個擎天水晶束。',
  }
},
[12536] = {
  {
    'Andar a crocolisco‡Трудная поездка‡Ein holpriger Ritt‡울퉁불퉁한 등에 올라‡Un viaje complicado‡Un viaje complicado‡Une dure chevauchée‡颠簸的航行‡艱困騎乘',
    nil,
    'Monte no crocolisco capturado e traga-o para o Refúgio Brumurmúria. A seguir, fale com Zepik para obter mais instruções.|n|nSe perder a Trompa de Caça de Zepik, fale com o Ancião Harkek, no Morro dos Feralma.‡Оседлайте пойманного кроколиска и отправляйтесь к убежищу Шепота Тумана; затем обратитесь к Зепику за дальнейшими указаниями.|n|nЕсли вы потеряете охотничий рог Зепика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Reitet auf dem gefangenen Krokilisken zur Zuflucht der Nebelflüsterer und fragt Zepik nach weiteren Anweisungen.|n|nSprecht mit dem Ältesten Harkek auf dem Hügel der Wildherzen, falls Ihr Zepiks Jagdhorn verlieren solltet.‡사로잡힌 악어를 타고 안개속삭임 야영지로 간 다음 제피크와 이야기하여 지시를 받아야 합니다.|n|n제피크의 사냥용 뿔피리를 잃어버리면 광란의심장 언덕에 있는 장로 하르케크와 이야기하십시오.‡Viaja sobre el crocolisco cautivo hasta el Refugio Susurraneblina y habla con Zepik para recibir instrucciones.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Viaja sobre el crocolisco cautivo hasta el Refugio Susurraneblina y habla con Zepik para recibir instrucciones.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Chevauchez le Crocilisque captif jusqu\'au Refuge de Murmebrume et parlez ensuite à Zepik pour obtenir de nouvelles instructions.|n|nSi vous perdez le Cor de chasse de Zepik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡骑上被俘虏的鳄鱼前往雾语村，向瑟匹克寻求下一步的指示。|n|n如果你弄丢了瑟匹克的狩猎号角，就去找狂心岭的长者哈尔卡克。‡騎乘被俘虜的鱷魚前往霧語避難所，和賽匹克談話以獲得更多的指示。|n|n如果你把賽匹克的狩獵號角搞丟了，和狂心之丘的長者哈爾凱克聊聊。',
  }
},
[12537] = {
  {
    'O raio cai duas vezes no mesmo lugar‡Молния все-таки бьет в то же место‡Der Blitz schlägt immer zwei Mal ein‡벼락은 반드시 두 번 친다‡El rayo golpea dos veces sin duda‡El rayo golpea dos veces sin duda‡La foudre frappe vraiment deux fois‡闪电确实两次打中同一个地方！‡禍不單行',
    nil,
    'Zepik quer que você esmague os Veios de Cristal do Pilar Beira-céu em frente ao santuário do tempo de Brumurmúria.|n|nSe perder a Trompa de Caça de Zepik, fale com o Ancião Harkek, no Morro dos Feralma.‡Зепик хочет, чтобы вы разрушили кристаллы Небесного Пути перед алтарем Шепота Тумана.|n|nЕсли вы потеряете охотничий рог Зепика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Zepik möchte, dass Ihr vor dem Wetterschrein der Nebelflüsterer die Himmelszeltkristallformation zertrümmert.|n|nFalls Ihr Zepiks Jagdhorn verlieren solltet, dann sprecht mit dem Ältesten Harkek auf den Hügeln der Wildherzen.‡제피크가 하늘길 수정 조각을 안개속삭임 기우 제단 앞에서 깨트려 달라고 했습니다.|n|n제피크의 사냥용 뿔피리를 잃어버리면 광란의심장 언덕에 있는 장로 하르케크와 대화해야 합니다.‡Zepik quiere que rompas las marañas de cristal Trecho Celestial delante del Santuario Climático Susurraneblina.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Zepik quiere que rompas las marañas de cristal Trecho Celestial delante del Santuario Climático Susurraneblina.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Détruisez les Grappes de cristaux des Confins-du-ciel, en face du Sanctuaire du temps Murmebrume, pour le compte de Zepik.|n|nSi vous perdez le Cor de chasse de Zepik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡瑟匹克要你在雾语天气祭坛前敲碎通天水晶簇。|n|n如果你弄丢了瑟匹克的狩猎号角，就去找狂心岭的长者哈尔卡克。‡賽匹克要你在霧語天候聖壇前敲碎擎天水晶簇。|n|n如果你弄丟了賽匹克的狩獵號角，去找狂心之丘的長者哈爾凱克談談。',
  }
},
[12538] = {
  {
    'A névoa não está escutando‡Шептуны не станут слушать‡Der Nebel hört nicht zu‡즐거운 안개속삭임 골록 사냥‡La bruma no está escuchando‡La bruma no está escuchando‡La brume n\'écoute pas‡猎杀雾语鳄鱼人‡霧並未傾聽',
    nil,
    'Zepik quer que você mate 12 Gorlocs Brumurmúria.|n|nSe perder a Trompa de Caça de Zepik, fale com o Ancião Harkek, no Morro dos Feralma.‡Зепик хочет, чтобы вы убили 12 горлоков Шепота Тумана.|n|nЕсли вы потеряете охотничий рог Зепика, поговорите со старейшиной Харкеком на холме Бешеного Сердца.‡Zepik möchte, dass Ihr 12 Gorlocs der Nebelflüsterer tötet.|n|nSprecht mit dem Ältesten Harkek vom Hügel der Wildherzen, falls Ihr Zepiks Jagdhorn verlieren solltet.‡제피크가 안개속삭임 골록 12마리를 처치해달라고 부탁했습니다.|n|n제피크의 사냥용 뿔피리를 잃어버리면 광란의심장 언덕에 있는 장로 하르케크와 이야기하십시오.‡Zepik quiere que mates a 12 górlocs Susurraneblina.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Zepik quiere que mates a 12 górlocs Susurraneblina.|n|nSi pierdes el cuerno de caza de Zepik, habla con el anciano Harkek en la Colina Corazón Frenético.‡Tuez 12 Gorlocs murmebrumes pour Zepik.|n|nSi vous perdez le Cor de chasse de Zepik, allez parler à l\'Ancien Harkek à la Colline de Frénécœur.‡瑟匹克要你去杀死12个雾语鳄鱼人。|n|n如果你弄丢了瑟匹克的狩猎号角，就去找狂心岭的长者哈尔卡克。‡殺死霧語避難所的12個霧語戈洛克，然後去和賽匹克交談。|n|n如果你弄丟了賽匹克的狩獵號角，去找狂心之丘的長者哈爾凱克談談。',
  }
},
[12539] = {
  {
    'Gastando sola‡Вместе весело шагать‡Und raus hier‡이번엔 걸어서‡A pata‡A pata‡À pattes‡步行回家‡踱步',
    nil,
    'Volte para o Morro dos Feralma e fale com o Sumo Xamã Rakjak.‡Найдите дорогу к холму Бешеного Сердца и поговорите с верховным шаманом Ракжаком.‡Sucht den Weg zurück zum Hügel der Wildherzen und sprecht mit Hochschamane Rakjak.‡길을 찾아 광란의심장 언덕으로 돌아간 다음 대주술사 라크자크와 이야기해야 합니다.‡Vuelve a la Colina Corazón Frenético y habla con el alto chamán Rakjak.‡Vuelve a la Colina Corazón Frenético y habla con el alto chamán Rakjak.‡Retrouvez votre chemin jusqu\'à la Colline de Frénécœur, puis parlez au Haut-chaman Rakjak.‡返回狂心岭，与高阶萨满祭司拉克亚克谈一谈。‡找到路回去狂心之丘，並且和高階薩滿拉克杰克交談。',
  }
},
[12540] = {
  {
    'Apenas seguindo ordens‡Исполнение приказа‡Tu nur meine Pflicht‡명령 복종‡Siguiendo órdenes‡Siguiendo órdenes‡Je n\'ai fait que suivre les ordres…‡遵命行事‡服從命令',
    nil,
    'Encontre o Oráculo Voz-da-chuva Ferido para o Sumo Xamã Rakjak no Morro dos Feralma.‡Найдите раненого оракула Гласа Дождя по просьбе верховного шамана Ракжака с холма Бешеного Сердца.‡Sucht für Hochschamanen Rakjak auf dem Hügel der Wildherzen ein verletztes Orakel der Regenrufer.‡광란의심장 언덕에 있는 대주술사 라크자크의 부탁대로 상처입은 구름몰이골록 점쟁이를 찾아야 합니다.‡Encuentra un Oráculo Hablalluvia herido para el alto chamán Rakjak en la Colina Corazón Frenético.|n‡Encuentra un Oráculo Hablalluvia herido para el alto chamán Rakjak en la Colina Corazón Frenético.|n‡Trouvez un Oracle parlepluie blessé pour le Haut-chaman Rakjak à la Colline de Frénécœur.‡狂心岭的高阶萨满祭司拉克亚克要你去找到一个受伤的雨声神谕者。‡替狂心之丘的高階薩滿拉克杰克找到受傷的雨頌神諭者。',
  }
},
[12541] = {
  {
    'Patrulha troll: o aprendiz do alquimista‡Тролльский дозор: в подмастерья к алхимику‡Trollpatrouille: Der Lehrling des Alchemisten‡트롤 순찰: 연금술사의 제자‡Patrulla trol: el aprendiz de alquimista‡Patrulla trol: el aprendiz de alquimista‡Patrouille anti-trolls : l\'apprenti alchimiste‡巡逻员：炼金师的帮手‡食人妖巡邏:鍊金師的學徒',
    nil,
    'O alquimista Bacamarte, em Heb\'Valok, quer que você o ajude a criar um soro da verdade.|n|nQuando você estiver pronto para começar, fale com ele e siga as instruções.‡Помогите алхимику Финкльштейну в Хеб\'Валоке в приготовлении сыворотки правды.|n|nКогда вы будете готовы приступить к работе, скажите об этом алхимику и выполняйте все его указания.‡Alchemist Finkelstein in Heb\'Valok möchte, dass Ihr ihm bei der Herstellung eines Wahrheitsserums helft.|n|nSprecht ihn an und folgt seinen Anweisungen, sobald Ihr bereit seid.‡헤브발로크에 있는 연금술사 핀클스타인이 진실의 물약 제조를 도와달라고 했습니다.|n|n시작할 준비가 되면 그에게 말을 걸고 지시를 따라야 합니다.‡El alquimista Finklestein en Heb\'Valok quiere que lo ayudes en la creación de un suero de la verdad.|n|nCuando estés listo para empezar, habla con él y sigue sus instrucciones.‡El alquimista Finklestein en Heb\'Valok quiere que lo ayudes en la creación de un suero de la verdad.|n|nCuando estés listo para empezar, habla con él y sigue sus instrucciones.‡L\'Alchimiste Finklestein de Heb\'Valok vous demande de l\'aider dans la fabrication d\'un sérum de vérité.|n|nQuand vous serez prêt à commencer, allez lui parler et suivez ses instructions.‡赫布瓦罗的炼金师菲肯斯坦要你帮他制作真言药水。|n|n准备好以后与他交谈，并按照他的指示行动。‡希伯伐洛克的鍊金師芬克斯坦要你協助他製作自白劑。|n|n你準備好要開始的時候就和他交談，然後遵循他的指示。',
  }
},
[12542] = {
  {
    'O chamado da Cruzada‡Зов Ордена‡Der Ruf des Kreuzzugs‡은빛십자군의 부름‡La Llamada de la Cruzada‡La Llamada de la Cruzada‡L\'appel de la Croisade‡北伐军的召唤‡十字軍的呼喚',
    nil,
    'Apresente-se ao Cruzado Valus na Guarda da Luz, no Ermo das Serpes.‡Явитесь к рыцарю Валусу в Опоре Света в Драконьем Погосте.‡Meldet Euch bei Kreuzritter Valus in der Lichtwarte in der Drachenöde.‡용의 안식처의 믿음의 빛 거점에 있는 성전사 발루스에게 보고해야 합니다.‡Preséntate ante el cruzado Valus en la Confianza de la Luz del Cementerio de Dragones.|n‡Preséntate ante el cruzado Valus en la Confianza de la Luz del Cementerio de Dragones.|n‡Faites votre rapport au Croisé Valus à la Confiance de Lumière, dans la Désolation des dragons.‡向龙骨荒野圣光之望礼拜堂的北伐军战士瓦鲁斯报告。‡向十字軍瓦魯思回報，他在龍骨荒野的聖光之託。',
  }
},
[12543] = {
  {
    'Um presente para Soo-rahm‡Подношение Су-раму‡Eine Opfergabe für Soo-rahm‡수람을 위한 공물‡Una ofrenda para Soo-liloquio‡Una ofrenda para Soo-liloquio‡Une offrande à Soo-fiett‡给索乌拉姆的祭品‡給蘇-臘姆的禮物',
    nil,
    'Leve 5 Presas de Naja Intactas para o Oráculo Soo-rahm, perto dos Ossos de Nozronn.‡Принесите оракулу Су-раму, живущему возле Скелета Нозронна, 5 целых зубов кобры.‡Bringt dem Orakel Soo-rahm in der Nähe der Knochen von Nozronn 5 Intakte Kobragiftzähne.‡온전한 코브라 송곳니 5개를 노즈론의 무덤 근처에 있는 점쟁이 수람에게 가져가야 합니다.‡Trae 5 colmillos de cobra intactos al Oráculo Soo-liloquio cerca de los Huesos de Nozronn.‡Trae 5 colmillos de cobra intactos al Oráculo Soo-liloquio cerca de los Huesos de Nozronn.‡Rapportez 5 Crocs de cobras intacts à l\'Oracle Soo-fiett, près des Os de Nozronn.‡将5颗完整的眼镜蛇牙交给诺兹隆之骨附近的神谕者索乌拉姆。‡將5根完整的眼鏡蛇牙帶去給諾茲朗之骨附近的神諭者蘇-臘姆。',
  }
},
[12544] = {
  {
    'Ossos de Nozronn‡Скелет Нозронна‡Die Knochen von Nozronn‡노즈론의 무덤‡Los Huesos de Nozronn‡Los Huesos de Nozronn‡Les os de Nozronn‡诺兹隆之骨‡諾茲朗之骨',
    nil,
    'Use o Incenso de Soo-rahm perto dos Ossos de Nozronn e retorne a Rosarães Guima, no Acampamento do Rosarães, com as informações que obtiver.‡Используйте фимиам Су-рама возле скелета Нозронна, а затем вернитесь к Хемингу Эрнестуэю в его лагерь и расскажите о том, что узнали.‡Benutzt Soo-rahms Weihrauch in der Nähe der Knochen von Nozronn, kehrt dann mit den Informationen, die Ihr in Erfahrung gebracht habt, zu Hemet Nesingwary in Nesingwarys Basislager zurück.‡노즈론의 무덤 근처에서 수람의 향료를 사용하여 정보를 얻은 다음 네싱워리 주둔지에 있는 헤멧 네싱워리에게 돌아가야 합니다.‡Utiliza el incienso de Soo-liloquio cerca de Los Huesos de Nozronn y luego vuelve junto a Hemet Nesingwary al Campamento Base de Nesingwary con la información que hayas conseguido.‡Utiliza el incienso de Soo-liloquio cerca de Los Huesos de Nozronn y luego vuelve junto a Hemet Nesingwary al Campamento Base de Nesingwary con la información que hayas conseguido.‡Utilisez l\'encens de Soo-fiett près des Os de Nozronn, puis retournez voir Hemet Nesingwary au camp de base de Nesingwary avec l\'information obtenue.‡在诺兹隆之骨附近使用索乌拉姆的薰香，然后返回奈辛瓦里营地，向赫米特·奈辛瓦里汇报你得到的情报。‡在諾茲朗之骨附近使用蘇-臘姆的薰香，然後帶著你得到的情報去找奈辛瓦里營地的赫米特·奈辛瓦里。',
  }
},
[12545] = {
  {
    'A purificação de Jintha\'kalar‡Очищение Джинта\'калара‡Die Säuberung von Jintha\'kalar‡진타칼라르 정화‡La limpieza de Jintha\'kalar‡La limpieza de Jintha\'kalar‡La purification de Jintha\'kalar‡净化金萨卡拉‡辛薩卡拉的淨化',
    nil,
    'O Cruzado Valus, na Guarda da Luz, no Ermo das Serpes, quer que você mate 15 Flagelos de Jintha\'kalar.‡По заданию рыцаря Валуса из Опоры Света на Драконьем Погосте убейте 15 джинта\'каларских воинов Плети.‡Kreuzritter Valus bei der Lichtwarte in der Drachenöde möchte, dass Ihr 15 Anhänger der Geißel von Jintha\'kalar tötet.‡믿음의 빛 거점에 있는 성전사 발루스가 진타칼라르 스컬지 15마리를 처치해 달라고 부탁했습니다.‡El cruzado Valus en la Confianza de la Luz del Cementerio de Dragones te pide que mates a 15 miembros de la Plaga en Jintha\'kalar.‡El cruzado Valus en la Confianza de la Luz del Cementerio de Dragones te pide que mates a 15 miembros de la Plaga en Jintha\'kalar.‡Le Croisé Valus de la Confiance de Lumière, à la Désolation des dragons, vous a demandé de tuer 15 membres du Fléau de Jintha\'kalar.‡龙骨荒野圣光之望礼拜堂的北伐军战士瓦鲁斯要求你去消灭15个金萨卡拉天灾成员。‡聖光之託的十字軍瓦魯思要你殺死15個辛薩卡拉天譴軍。',
  }
},
[12546] = {
  {
    'Reivindicação‡Отмщение‡Wiedergewinnung‡길들이기‡Reclamación‡Reclamación‡La reconquête‡力挽狂澜‡開闢',
    nil,
    'Vá ao Avalanche, na Bacia Sholazar, e use a Runa Ômega para chamar o Etimidiano. Use-o para matar 200 Lacaios do Flagelo, Bythius, o Molda-carne, Urgreth das Mil Tumbas e Escarnizus.|n|nQuando concluir a tarefa, fale com o Avatar de Freya, na Bacia Sholazar.‡Отправляйтесь к Застывшей лавине в Низине Шолазар и используйте руну "Омега", чтобы привести в действие Этимидиана. Используйте его, чтобы уничтожить 200 прислужников Плети, Битиуса Ваятеля Плоти, Ургрета из Тысячи Могил и Градохлада.|n|nВыполнив задание, поговорите с Аватарой Фрейи в Низине Шолазар.‡Geht zur Lawine im Sholazarbecken und verwendet die Omegarune, um den Etymidian zu aktivieren. Tötet mit ihm 200 Diener der Geißel, Bythius den Fleischformer, Urgreth von den Tausend Gräbern und Hagel\'skorn.|n|nSprecht mit dem Avatar von Freya im Sholazarbecken, sobald Ihr diese Aufgabe abgeschlossen habt.‡숄라자르 분지에 있는 눈사태 언덕에서 최후의 룬을 사용해 에티미디안을 불러내야 합니다. 에티미디안을 이용해 스컬지 부하 200마리, 살덩이형성자 비티우스, 그리고 대학살자 우르그레스와 냉소의 서리고룡을 처치하십시오.|n|n임무를 마치면 숄라자르 분지에 있는 프레이야의 화신과 이야기해야 합니다.‡Ve a la Avalancha en la Cuenca de Sholazar y usa la runa omega para desplegar al Etimidiano. Úsalo para matar a 200 Esbirros de la Plaga, a Bythius el Formador de carne, a Urgreth de Las Mil Tumbas y a Iragélida.|n|nHabla con el avatar de Freya en la Cuenca de Sholazar cuando hayas terminado la misión.‡Ve a la Avalancha en la Cuenca de Sholazar y usa la runa omega para desplegar al Etimidiano. Úsalo para matar a 200 esbirros de la Plaga, a Bythius el Formador de carne, a Urgreth de Las Mil Tumbas y a Iragélida.|n|nHabla con el avatar de Freya en la Cuenca de Sholazar cuando hayas terminado la misión.‡Allez à l\'Avalanche dans le Bassin de Sholazar et utilisez la Rune Oméga pour déployer l\'Etymidian. Utilisez-le pour tuer 200 Serviteurs du Fléau, Bythius le Sculpte-chair, Urgreth des Mille Tombeaux et Morguegrêle.|n|nParlez à l\'Avatar de Freya dans le Bassin de Sholazar quand vous aurez accompli cette tâche.‡前往索拉查盆地的雪崩山麓，使用欧米伽符文操纵源生石像，消灭200名天灾军团的爪牙、血肉塑造者拜休斯、千墓之魔乌格雷斯和海斯克恩。|n$完成任务后与索拉查盆地的弗蕾亚的化身谈一谈。‡前往休拉薩盆地的雪崩地並且使用終末符文來部署伊提米迪安。用他殺死200名天譴部隊、『血肉塑形者』拜西厄斯、千塚的烏格雷希和海爾思康。|n|n當你完成任務之後，和休拉薩盆地的芙蕾雅交談。',
  }
},
[12547] = {
  {
    'A runa de ativação‡Руна пробуждения‡Die Aktivierungsrune‡활성의 룬‡La activación de la runa‡La activación de la runa‡La rune d\'activation‡启动符文‡啟動符文',
    nil,
    'Pegue a Runa Ômega no Terraço do Moldador e leve-a ao Etimidiano.‡Найдите руну "Омега" на Террасе Создателя и принесите ее к Этимидиану.‡Besorgt die Omegarune von der Terrasse des Formers und bringt sie zu Etymidian.‡구체자의 정원 안에서 최후의 룬을 구해 에티미디안에게 가져가야 합니다.‡Consigue la runa omega dentro del Bancal del Creador y llévasela a El Etimidiano.‡Consigue la runa omega dentro del Bancal del Creador y llévasela a El Etimidiano.‡Obtenez la Rune Oméga à l\'intérieur de la Terrasse du Façonneur et rapportez-la à Etymidian.‡在塑造者之台内找到欧米伽符文，将它带至源生石像身边。‡取得塑造者殿堂內的終末符文，然後帶去找伊提米迪安。',
  }
},
[12548] = {
  {
    'O Etimidiano‡Этимидиан‡Der Etymidian‡에티미디안‡El Etimidiano‡El Etimidiano‡L\'Etymidian‡源生石像‡伊提米迪安',
    nil,
    'Atravesse o pórtico ao sul da Bacia Sholazar e procure a arma conhecida como O Etimidiano no outro lado.‡Войдите в Связующую спираль на южной границе Низины Шолазар и разыщите оружие, известное как Этимидиан.‡Durchschreitet das Tor am südlichen Ende des Sholazarbeckens und sucht auf der anderen Seite nach der Waffe, die der Etymidian genannt wird.‡숄라자르 분지의 남쪽 끝에 있는 차원문으로 들어가 반대편에서 에티미디안으로 알려진 무기를 찾아야 합니다.‡Atraviesa la Puerta en el extremo sur de la Cuenca de Sholazar y busca el arma conocida como el Etimidiano al otro lado.‡Atraviesa la Puerta en el extremo sur de la Cuenca de Sholazar y busca el arma conocida como el Etimidiano al otro lado.‡Traversez le Portail à l\'extrémité sud du Bassin de Sholazar et cherchez l\'arme connue sous le nom de l\'Etymidian qui se trouve de l\'autre côté.‡穿越索拉查盆地南端的界门，在另一侧寻找那件被称为源生石像的武器。‡穿過休拉薩盆地南端的甬道之門，在另一端尋找被稱作伊提米迪安的武器。',
  }
},
[12549] = {
  {
    'Maestria dos deimossabres: tornando-se um predador‡Охота на терропардов: стать хищником‡Beherrschen der Schreckenssäblerjagd: Zum Raubtier werden‡공포의 호랑이 사냥법 익히기: 포식자 되기‡Domina el sable aterrador: convertirse en depredador‡Domina el sable aterrador: convertirse en depredador‡La maîtrise des sabres-d\'effroi : devenir un prédateur‡狩猎恶刃豹：成为猎手‡懼刃豹專精:成為掠食者',
    nil,
    'Mate 15 Deimossabres e fale novamente com Buck Cantwell, no Acampamento do Rosarães.‡Убейте 15 терропардов и возвращайтесь в лагерь Эрнестуэя к Баку Кантвеллу.‡Tötet 15 Schreckenssäbler und kehrt anschließend zu Buck Cantwell in Nesingwarys Basislager zurück.‡공포의 호랑이 15마리를 처치한 다음 네싱워리 주둔지에 있는 버크 캔웰에게 돌아가야 합니다.‡Mata 15 sables aterradores y vuelve a Buck Ladobién en el Campamento Base de Nesingwary.‡Mata 15 sables aterradores y vuelve a Buck Ladobién en el Campamento Base de Nesingwary.‡Tuez 15 Sabres-d\'effroi et retournez voir Buck Bellamble au Camp de base de Nesingwary.‡杀死15只恶刃豹，然后向奈辛瓦里营地的巴克·坎维尔复命。‡殺死15隻懼刃豹，然後回去奈辛瓦里營地找巴克·坎特威爾。',
  }
},
[12550] = {
  {
    'Maestria dos deimossabres: espreitando a presa‡Охота на терропардов: по следу зверя‡Meister der Schreckenssäblerjagd: Der Beute auf der Spur‡공포의 호랑이 사냥법 익히기: 먹잇감 추적‡Domina el sable aterrador: acechar a la presa‡Domina el sable aterrador: acechar a la presa‡La maîtrise des sabres-d\'effroi : traquer sa proie‡狩猎恶刃豹：追踪猎物‡懼刃豹專精:跟蹤獵物',
    nil,
    'Buck Cantwell, no Acampamento do Rosarães, quer que você identifique 3 Pegadas de Shango, partindo das Pegadas de Deimossabres perto do Lago Maremarga.‡Бак Кантвелл из лагеря Эрнестуэя хочет, чтобы вы выявили 3 следа Шанго среди следов терропардов у озера Горьких Волн.‡Buck Cantwell in Nesingwarys Basislager möchte, dass Ihr 3 Shangofährten aus den Schreckenssäblerfährten nahe des Bittertidensees herauslest.‡네싱워리 주둔지에 있는 버크 캔웰이 거센물결 호수 근처에 있는 공포의 호랑이 발자국 중에서 샨고의 발자국 3개를 찾아 달라고 부탁했습니다.‡Buck Ladobién en el Campamento Base de Nesingwary quiere que identifiques 3 huellas de Shango entre las huellas de sable aterrador cerca del lago Olamarga.‡Buck Ladobién en el Campamento Base de Nesingwary quiere que identifiques 3 huellas de Shango entre las huellas de sable aterrador cerca del lago Olamarga.‡Buck Bellamble, au Camp de base de Nesingwary, vous a demandé d\'identifier 3 Empreintes de Shango parmi les empreintes de sabres-d\'effroi, près du lac de Flot-amer.‡奈辛瓦里营地的巴克·坎维尔要你从苦潮湖附近的恶刃豹足迹中鉴别出3条杉苟的足迹。‡奈辛瓦里營地的巴克·坎特威爾要你到惡潮湖附近從懼刃豹足跡中檢驗出三個尚戈的足跡。',
  }
},
[12551] = {
  {
    'Maestria dos crocoliscos: a prova‡Охота на кроколисков: испытание‡Meister der Krokiliskenjagd: Die Prüfung‡악어 사냥법 익히기: 시도‡Domina el crocolisco: la prueba‡Domina el crocolisco: la prueba‡La maîtrise des crocilisques : l\'épreuve‡狩猎鳄鱼：试炼‡鱷魚專精:磨練',
    nil,
    'Mate 15 Crocoliscos do Mangue e fale novamente com Debaar, no Acampamento do Rosarães.‡Убейте 15 мангровых кроколисков и вернитесь к Дебаар в лагерь Эрнестуэя.‡Tötet 15 Mangalkrokilisken und kehrt zu Debaar in Nesingwarys Basislager zurück.‡늪지대 악어 15마리를 처치한 다음 네싱워리 주둔지에 있는 데바르에게 돌아가야 합니다.‡Mata 15 crocoliscos del manglar y vuelve a Debaar en el Campamento de Nesingwary.‡Mata 15 crocoliscos del manglar y vuelve a Debaar en el Campamento de Nesingwary.‡Tuez 15 Crocilisques de la mangrove et retournez voir Debaar au Camp de base de Nesingwary.‡杀死15条蛮藤谷鳄鱼，然后向奈辛瓦里营地的蒂巴尔复命。‡殺死15隻沼林鱷，然後向奈辛瓦里營地的戴巴爾回報。',
  }
},
[12552] = {
  {
    'Morte aos necromagi‡Смерть некромагам!‡Tod den Nekromagiern‡강령마법사에게 죽음을‡Muerte a los necromagos‡Muerte a los necromagos‡Mort aux nécromagi‡通灵师之死‡殺死死靈魔導師',
    nil,
    'O Sargento Lunarmento, em Drak\'Sotra, pediu para você matar 8 Necromagi Hath\'ar.‡По поручению сержанта Осколка Луны в Драк\'Сотре убейте 8 некромагов Хат\'ар.‡Unteroffizier Mondsplitter in Drak\'Sotra möchte, dass Ihr 8 Nekromagier von Hath\'ar vernichtet.‡드락소트라에 있는 하사관 문샤드가 하스아르 강령마법사 8마리를 처치해 달라고 부탁했습니다.‡El sargento Cascoluna en Drak\'Sotra te ha pedido que destruyas 8 necromagos Hath\'ar.‡El sargento Cascoluna en Drak\'Sotra te ha pedido que destruyas 8 necromagos Hath\'ar.‡Le Sergent Tesson-de-lune à Drak\'Sotra vous a demandé de détruire 8 Nécromagi hath\'ar.‡达克索塔的穆尔沙·月影中士要你去杀死8个哈沙尔通灵师。‡德拉克索璀的月裂中士要你消滅8個哈薩爾死靈魔導師。',
  }
},
[12553] = {
  {
    'Fiandeiras das raspadeiras‡Прядильные органы‡Seglerspinndrüsen‡칼날거미 돌기‡Hileras de rayador‡Hileras de rayador‡Filières de frôleurs‡撒网者的喷丝头‡剝奪者的絲囊',
    nil,
    'Especialista Engreneide, em Drak\'Sotra, pediu para você coletar 5 Fiandeiras das Raspadeiras Intactas.‡Принесите специалисту Зубоколесу в Драк\'Сотру 5 целых прядильных органов.‡Spezialistin Zahnrad in Drak\'Sotra möchte, dass Ihr 5 intakte Seglerspinndrüsen beschafft.‡드락소트라에 있는 전문가 코그휠이 온전한 칼날거미 돌기 5개를 구해달라고 부탁했습니다.‡La especialista Engranaje en Drak\'Sotra te ha pedido que consigas 5 hileras de rayador intactas.‡La especialista Engranaje en Drak\'Sotra te ha pedido que consigas 5 hileras de rayador intactas.‡La Spécialiste Roudenté à Drak\'Sotra vous a demandé de récupérer 5 Filières de frôleurs intactes.‡达克索塔的专家考格维尔要你去收集5个完整的撒网者喷丝头。‡德拉克索璀的專家榫輪要你收集5個完整的剝奪者絲囊。',
  }
},
[12554] = {
  {
    'Malash, o Corruptor‡Малас Осквернитель‡Malas der Verderber‡타락자 말라스‡Malash el Corruptor‡Malash el Corruptor‡Malas le Corrupteur‡腐蚀者玛拉斯‡『墮落者』瑪拉斯',
    nil,
    'O Sargento Lunarmento insiste que você volte com a Cabeça do Corruptor.‡Принесите сержанту Осколку Луны в Драк\'Сотру голову Осквернителя.‡Unteroffizier Mondsplitter in Drak\'Sotra besteht darauf, dass Ihr ihm den Kopf des Verderbers bringt.‡드락소트라에 있는 하사관 문샤드가 타락자의 머리를 가져와 달라고 부탁했습니다.‡El sargento Cascoluna en Drak\'Sotra insiste en que vuelvas con la cabeza del Corruptor.‡El sargento Cascoluna en Drak\'Sotra insiste en que vuelvas con la cabeza del Corruptor.‡Le Sergent Tesson-de-lune à Drak\'Sotra vous a demandé de revenir avec la Tête du Corrupteur.‡达克索塔的穆尔沙·月影中士要你带回腐蚀者的徽记。‡德拉克索璀的月裂中士強烈要求你帶著墮落者的頭顱回去找他。',
  }
},
[12555] = {
  {
    'Um novelo emaranhado‡Оплетающие сети‡Ein Wirrgespinst‡헝클어진 실‡Una madeja enredada‡Una madeja enredada‡Un écheveau enchevêtré‡缠绕投网器‡盤根錯節',
    nil,
    'A Especialista Engreneide, em Drak\'Sotra, pediu para você usar o Arremessador de Novelo Emaranhado para causar a destruição de 5 Pulverizadores de Peste.‡По поручению специалиста Зубоколес из Драк\'Сотры сбейте 5 сеятелей чумы с помощью катапульты-сетемета.‡Spezialistin Zahnrad in Drak\'Sotra möchte, dass Ihr mithilfe des Wirrgespinstwerfers 5 Seuchensprüher zerstört.‡드락소트라에 있는 전문가 코그휠이 얽힌 거미줄 뭉치 발사기를 사용해 역병 분사기 5개를 파괴해 달라고 부탁했습니다.‡La especialista Engranaje en Drak\'Sotra te ha pedido que utilices el lanzamadeja enredada para causar la destrucción de 5 pulverizadores de peste.‡La especialista Engranaje en Drak\'Sotra te ha pedido que utilices el lanzamadeja enredada para causar la destrucción de 5 pulverizadores de peste.‡La Spécialiste Roudenté à Drak\'Sotra vous a demandé d\'utiliser le Lance-écheveau enchevêtré pour détruire 5 Pulvérisateurs de peste.‡达克索塔的专家考格维尔要你使用缠绕投网器摧毁5台药剂喷射器。‡德拉克索璀的專家榫輪要你使用盤根錯節投擲器毀掉5個瘟疫噴灑器。',
  }
},
[12556] = {
  {
    'Maestria dos rinocerontes: o abate‡Охота на люторогов: смертельный удар‡Meister der Rhinozerosjagd: Der Todesstoß‡코뿔소 사냥법 익히기: 처치‡Domina el rinoceronte: la muerte‡Domina el rinoceronte: la muerte‡La maîtrise des rhinos : la mise à mort‡狩猎犀牛：终极决战‡犀牛專精:獵殺',
    nil,
    'Leve o Chifre de Farunn para Rosarães Guima, no Acampamento do Rosarães.‡Принесите рог Фаранна Хемингу Эрнестуэю в его лагерь.‡Bringt Farunns Horn zu Hemet Nesingwary in Nesingwarys Basislager.‡네싱워리 주둔지에 있는 헤멧 네싱워리에게 파룬의 뿔을 가져가야 합니다.‡Tráele el cuerno de Farunn a Hemet Nesingwary en el Campamento Base de Nesingwary.‡Tráele el cuerno de Farunn a Hemet Nesingwary en el Campamento Base de Nesingwary.‡Rapportez la Corne de Farunn à Hemet Nesingwary au Camp de base de Nesingwary.‡将法鲁恩的犄角交给奈辛瓦里营地的赫米特·奈辛瓦里。‡把法魯恩的角帶到奈辛瓦里營地給赫米特·奈辛瓦里。',
  }
},
[12557] = {
  {
    'Trabalho de laboratório‡Лабораторная работа‡Laborarbeit‡연구실 작업‡Trabajo de laboratorio‡Trabajo de laboratorio‡Un travail de laboratoire‡实验室的学徒‡實驗室作業',
    nil,
    'O Alquimista Bacamarte, em Heb\'Valok, quer que você encontre um Verme de Lama Lodosa, uma Asa Seca de Morcego, uma Semente Âmbar e um pouco de Muco Gelado de Serpente no laboratório dele.‡Отыщите в лаборатории Финкльштейна грязную болотную личинку, иссохшее крыло нетопыря, янтарный желудь и замерзшую змеиную слизь.‡Alchemist Finkelstein in Heb\'Valok möchte, dass Ihr in sein Labor geht und ihm eine schlammige Moormade, einen getrockneten Fledermausflügel, einen Bernsteinsamen und ein wenig gekühlten Schlangenschleim beschafft.‡헤브발로크에 있는 연금술사 핀클스타인이 자기 연구실에서 진흙투성이 늪 구더기, 말라버린 박쥐날개, 호박색 씨앗, 한기서린 뱀 점액을 찾아보라고 했습니다.‡El alquimista Finklestein en Heb\'Valok quiere que encuentres un gusano de fango, un ala de murciélago mustia, un grano ámbar y un poco de moco de serpiente frío en su laboratorio.‡El alquimista Finklestein en Heb\'Valok quiere que encuentres un gusano de fango, un ala de murciélago mustia, un grano ámbar y un poco de moco de serpiente frío en su laboratorio.‡L\'Alchimiste Finklestein à Heb\'Valok veut que vous lui rapportiez un Asticot fangeux, une Aile de chauve-souris desséchée, une Ambregraine et un peu de Mucus de serpent glacé dans son laboratoire.‡赫布瓦罗的炼金师菲肯斯坦要求你在他的实验室内找到一只泥潭蛆虫、一片干瘪的蝙蝠翼、一粒琥珀种子和一些冰冷的毒蛇粘液。‡希伯伐洛克的鍊金師芬克斯坦要你從他的實驗室中找出1個爛沼泥蛆，1個萎縮的蝙蝠翅膀，1顆琥珀種子，還有一些寒冽巨蛇黏液。',
  }
},
[12558] = {
  {
    'Maestria dos deimossabres: pronto para atacar‡Охота на терропардов: прыжок‡Meister der Schreckenssäblerjagd: Bereit zum Angriff‡공포의 호랑이 사냥법 익히기: 습격 준비‡Domina el sable aterrador: listo para saltar‡Domina el sable aterrador: listo para saltar‡La maîtrise des sabres-d\'effroi : prêt à bondir‡狩猎恶刃豹：突然袭击‡懼刃豹專精:準備突襲',
    nil,
    'Leve a Pelagem de Shango para Buck Cantwell, no Acampamento do Rosarães.‡Принесите шкуру Шанго Баку Кантвеллу в лагерь Эрнестуэя.‡Bringt Shangos Pelz zu Buck Cantwell in Nesingwarys Basislager.‡샨고의 모피를 네싱워리 주둔지에 있는 버크 캔웰에게 가져가야 합니다.‡Tráele la pelambre de Shango a Buck Ladobién en el Campamento Base de Nesingwary.‡Tráele la pelambre de Shango a Buck Ladobién en el Campamento Base de Nesingwary.‡Rapportez la Peau de Shango à Buck Bellamble au Camp de base de Nesingwary.‡将杉苟的毛皮交给奈辛瓦里营地的巴克·坎维尔。‡帶著尚戈的毛皮去找奈辛瓦里營地的巴克·坎特威爾。',
  }
},
[12559] = {
  {
    'Energizando o pórtico: o Ninho do Criador‡Включение Спирали: Обитель Творцов‡Aufladen des Tors - Hort der Schöpfer‡관문 에너지 공급 - 창조주의 감시대‡Activar la Puerta - El Pedestal de los Creadores‡Activar la Puerta - El Pedestal de los Creadores‡Activation du portail d\'accès : le perchoir du Faiseur‡开启界门 - 造物者之座‡甬道之門充能 - 造物者棲所',
    nil,
    'O Avatar de Freya, nas Cachoeiras de Voz-da-chuva, quer que você vá ao Ninho do Criador e use o Interruptor Gama.‡Аватара Фрейи с водопадов Гласа Дождя хочет, чтобы вы отправились в Обитель Творцов и воспользовались активационным переключателем "гамма".‡Der Avatar von Freya im Katarakt der Regenrufer möchte, dass Ihr Euch zum Hort der Schöpfer begebt und den Aktivierungsschalter Gamma betätigt.‡구름몰이 여울목에 있는 프레이야의 화신이 창조주의 감시대에 가서 활성화 제어기 감마를 작동해 달라고 부탁했습니다.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que vayas a El Pedestal de los Creadores y uses el interruptor de activación Gamma.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que vayas a El Pedestal de los Creadores y uses el interruptor de activación Gamma.‡L\'Avatar de Freya, aux Rapides Parlepluie, veut que vous alliez au Perchoir du Faiseur et que vous utilisiez l\'Interrupteur d\'activation Gamma.‡雨声河的弗蕾亚的化身要你前往造物者之座，启动界门开关 - 伽玛。‡雨頌者急湍的芙蕾雅化身要你前往造物者棲所並使用啟動開關γ。',
  }
},
[12560] = {
  {
    'Maestria dos crocoliscos: o plano‡Охота на кроколисков: план‡Meister der Krokiliskenjagd: Der Plan‡악어 사냥법 익히기: 계획‡Domina el crocolisco: el plan‡Domina el crocolisco: el plan‡La maîtrise des crocilisques : le plan‡狩猎鳄鱼：计划‡鱷魚專精:謀劃',
    nil,
    'Leve 5 Samambaias-da-areia para Debaar, no Acampamento do Rosarães.‡Принесите 5 листьев песочного папоротника Дебаар в лагерь Эрнестуэя.‡Bringt Debaar in Nesingwarys Basislager 5 Sandfarnwedel.‡네싱워리 주둔지에 있는 데바르에게 모래고비 5개를 가져가야 합니다.‡Tráele 5 helechos de arena a Debaar en el Campamento Base de Nesingwary.‡Tráele 5 helechos de arena a Debaar en el Campamento Base de Nesingwary.‡Rapportez 5 feuilles de Fougère des sables à Debaar, au Camp de base de Nesingwary.‡将5片沙蕨叶交给奈辛瓦里营地的蒂巴尔。‡帶5個砂蕨葉給奈辛瓦里營地的達巴爾。',
  }
},
[12561] = {
  {
    'Uma questão de confiança‡Вопрос доверия‡Eine Vertrauensfrage‡신용 문제‡Una cuestión de confianza‡Una cuestión de confianza‡Un problème de confiance‡信任危机‡信任問題',
    nil,
    'Obtenha a confiança de Freya destruindo 6 Cadáveres Empesteados e 10 Assoladores Ceifa-ossos nas Terras Perdidas.‡Завоюйте доверие Фрейи: уничтожьте 6 чумных трупов и 10 острокостных опустошителей в Затерянных землях.‡Gewinnt Freyas Vertrauen, indem Ihr 6 verseuchte Leichname und 10 Knochensensenverheerer in den verlorenen Landen vernichtet.‡잃어버린 땅에서 말라죽은 시체 6구와 해골사신 칼날발톱 10마리를 제거하여 프레이야의 신뢰를 얻어야 합니다.‡Gánate la confianza de Freya destruyendo 6 cadáveres contagiados y 10 devastadores Segahuesos en Las Tierras Perdidas.‡Gánate la confianza de Freya destruyendo 6 cadáveres contagiados y 10 devastadores Segahuesos en Las Tierras Perdidas.‡Obtenez la confiance de Freya en détruisant 6 Cadavres chancreux et 10 Ravageurs de la faucheuse d\'os dans les Terres Perdues.‡进入迷失之地，消灭6个损毁的天灾怪和10个骨镰劫掠者，以此获得弗蕾亚的信任。‡在失落之地摧毀6具荒疫污染屍體和10個骨鐮劫毀者以贏得芙蕾雅的信任。',
  }
},
[12562] = {
  {
    'Os Drakkari não precisam de elementais da água!‡Элементали не для Драккари‡Die Drakkari brauchen keine Wasserelementare!‡드라카리에게 물의 정령은 필요 없다!‡¡Los Drakkari no necesitan elementales de agua!‡¡Los Drakkari no necesitan elementales de agua!‡Pas besoin que les Drakkari aient des élémentaires d\'eau !‡达卡莱巨魔不需要水元素！‡德拉克瑞不需要水元素!',
    nil,
    'A Subtenente Jax, na Fortaleza Argêntea, pediu para você matar 10 Magos d\'Água Drakkari.‡По заданию младшего лейтенанта Джакса из Серебряной заставы убейте 10 водопрядов Драккари.‡Unterleutnant Jax in der Argentumwache möchte, dass Ihr 10 Wasserbinder der Drakkari tötet.‡은빛십자군 격전지에 있는 부관대리 작스가 드라카리 물결속자 10명을 처치해 달라고 부탁했습니다.‡La alférez Jax en El Confín Argenta te ha pedido que mates 10 vinculadores de agua Drakkari.‡La alférez Jax en El Confín Argenta te ha pedido que mates 10 vinculadores de agua Drakkari.‡Le Sous-lieutenant Jax au Séjour d\'Argent vous a demandé de tuer 10 Lieurs d\'eau drakkari.‡银色前沿的亚克斯中尉要求你去消灭10名达卡莱缚水者。‡銀白看臺的賈克斯中尉要你殺死10個德拉克瑞縛水者。',
  }
},
[12563] = {
  {
    'Patrulha troll‡Тролльский дозор‡Trollpatrouille‡트롤 순찰‡Patrulla trol‡Patrulla trol‡Patrouille anti-trolls‡巡逻员‡食人妖巡邏',
    nil,
    'O Comandante Kunz, na Fortaleza Argêntea, quer que você vá até os quatro postos da Cruzada Argêntea, siga as ordens dos capitães de cada um deles e, depois, apresente-se novamente a ele.|n|nO Capitão Brandão e o Capitão Ruperto estão em Drak\'Sotra, o Capitão Grondel está em Draz\'Agal e o Alquimista Bacamarte está em Heb\'Valok.‡Обойдите четыре заставы Серебряного Авангарда, выполните приказы капитанов и возвратитесь к командиру Кунцу на Серебряную заставу с докладом.|n|nЗаставы капитана Брендона и капитана Руперта расположены в Драк\'Сотре, застава капитана Гронделя – в Драк\'Агале, а застава алхимика Финкльштейна – в Хеб\'Валоке.‡Kommandant Kunz in der Argentumwache möchte, dass Ihr die vier Stützpunkte des Argentumkreuzzugs besucht, den Befehlen der dortigen Anführer gehorcht und anschließend bei ihm Bericht erstattet.|n|nHauptmann Brandon und Hauptmann Rupert sind in Drak\'Sotra stationiert, Hauptmann Grondel in Drak\'Agal und Alchemist Finkelstein in Heb\'Valok.‡은빛십자군 격전지에 있는 사령관 쿤즈가 은빛십자군 초소를 방문해 각 대장이 주는 임무를 마치고 돌아와서 보고해 달라고 했습니다.|n|n대장 브랜든과 대장 루퍼트는 드락소트라에, 대장 그론델은 드락아갈에, 연금술사 핀클스타인은 헤브발로크에 있습니다.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡Le Commandant Kunz du Séjour d\'Argent vous a demandé de vous rendre aux quatre postes de la Croisade d\'argent, de suivre les ordres de leurs capitaines puis de revenir lui faire votre rapport.|n|nLe Capitaine Brandon et le Capitaine Rupert sont en poste à Drak\'Sotra, le Capitaine Grondel à Drak\'Agal, et l\'Alchimiste Finklestein à Heb\'Valok.‡银色前沿的指挥官库恩斯要你拜访四座银色北伐军的岗哨，并完成那里的上尉交给你的任务，然后回去向他复命。|n|n布兰顿上尉和鲁伯特上尉驻扎在达克索塔。格隆迪尔上尉驻扎在达克迦尔。炼金师菲肯斯坦驻扎在赫布瓦罗。‡銀白看臺的指揮官康茲要你造訪四座銀白十字軍崗哨，遵從該處上尉的命令，完成後回報給他。布蘭登上尉和魯伯特上尉駐守在德拉克索璀，格隆戴爾上尉駐守在德拉克亞苟，而鍊金師芬克斯坦駐守在希伯伐洛克。',
  }
},
[12564] = {
  {
    '‡Тролльский дозор: обезболивающее снадобье‡Trollpatrouille: Etwas gegen die Schmerzen‡트롤 순찰: 고통 경감‡Patrulla trol: algo para el dolor‡Patrulla trol: algo para el dolor‡Patrouille anti-trolls: un remède contre la douleur‡巡逻员：止痛药‡食人妖巡邏:痛苦特效藥',
    nil,
    '‡Соберите 5 распустившихся водяных маков на полях Драк\'Сотры для капитана Брендона из Драк\'Сотры.‡Hauptmann Brandon in Drak\'Sotra möchte, dass Ihr 5 Stück reifen Wassermohns von den Feldern von Drak\'Sotra besorgt.‡드락소트라에 있는 대장 브랜든이 드락소트라 농장에서 다 자란 물양귀비 5개를 가져다 달라고 했습니다.‡El capitán Brandon en Drak\'Sotra quiere que recojas 5 amapolas de agua adultas en los Campos de Drak\'Sotra.‡El capitán Brandon en Drak\'Sotra quiere que recojas 5 amapolas de agua adultas en los Campos de Drak\'Sotra.‡Le Capitaine Brandon de Drak\'Sotra vous a demandé de récolter 5 Pavots aquatiques à maturité dans les champs de Drak\'Sotra.‡达克索塔的布兰顿上尉希望你从达克索塔农田采集5份成熟的水罂粟。‡',
  }
},
[12565] = {
  {
    'A bênção de Zim\'Abwa‡Благословение Зим\'Абвы‡Der Segen von Zim\'Abwa‡짐아브와의 축복‡La bendición de Zim\'Abwa‡La bendición de Zim\'Abwa‡La bénédiction de Zim\'Abwa‡希姆埃巴的祝福‡辛阿布瓦的祝福',
    nil,
    'O Bagateiro Ubungo, na Fortaleza Argêntea, quer que você leve 10 Oferendas Drakkari à estátua de Zim\'Abwa.‡По поручению мастера проклятий Убунго принесите 10 подношений Драккари к изваянию Зим\'Абвы.‡Verhexer Ubungo in der Argentumwache möchte, dass Ihr der Statue von Zim\'Abwa 10 Drakkariopfergaben darbringt.‡은빛십자군 격전지에 있는 주술사 우분고가 드라카리 공물 10개를 짐아브와 조각상에 바쳐 달라고 부탁했습니다.‡El aojador Ubungo en El Confín Argenta quiere que lleves 10 ofrendas Drakkari a la estatua de Zim\'Abwa.‡El aojador Ubungo en El Confín Argenta quiere que lleves 10 ofrendas Drakkari a la estatua de Zim\'Abwa.‡Le Maléficieur Ubungo au Séjour d\'Argent veut que vous présentiez 10 Offrandes drakkari à la statue de Zim\'Abwa.‡银色前沿的妖术师乌布戈要求你在希姆埃巴的雕像前奉上10份达卡莱供品。‡銀白看臺的妖術師烏邦茍，要你在辛阿布瓦的雕像面前獻上10份德拉克瑞祭品。',
  }
},
[12566] = {
  {
    'Ajuda à Aldeia Casco Invernal‡Помощь Лагерю Заиндевевшего Копыта‡Hilfe für das Lager der Winterhufe‡겨울발굽 야영지의 도움‡Ayuda para el Campamento Pezuña Invernal‡Ayuda para el Campamento Pezuña Invernal‡De l\'aide pour le camp Sabot-d\'hiver‡增援冬蹄营地‡幫助冬蹄營地',
    nil,
    'Fale com o Chefe Totem de Cinzas na Aldeia Casco Invernal.‡Поговорите с вождем Прахтотемом в Лагере Заиндевевшего Копыта.‡Sprecht mit Häuptling Aschtotem im Lager der Winterhufe.‡겨울발굽 야영지에 있는 족장 애쉬토템과 대화해야 합니다.‡Habla con el cabecilla Tótem de Ceniza en el Campamento Pezuña Invernal.‡Habla con el cabecilla Tótem de Ceniza en el Campamento Pezuña Invernal.‡Parler au Chef Totem-de-frêne au Camp Sabot-d\'hiver.‡与冬蹄营地的灰烬图腾酋长谈一谈。‡與冬蹄營地的灰燼圖騰酋長交談。',
  }
},
[12567] = {
  {
    'Bênção de Zim\'Abwa‡Благословение Зим\'Абвы‡Der Segen von Zim\'Abwa‡짐아브와의 축복‡Bendición de Zim\'Abwa‡Bendición de Zim\'Abwa‡Bénédiction de Zim\'Abwa‡希姆埃巴的祝福‡辛阿布瓦的祝福',
    nil,
    nil,
  }
},
[12568] = {
  {
    '‡Тролльский дозор: смертельная усталость‡Trollpatrouille: todsicher gehen‡트롤 순찰: 진정한 죽음‡Patrulla trol: hasta la muerte‡Patrulla trol: hasta la muerte‡Patrouille anti-trolls: morts incinérés‡巡逻员：阵亡者的尊严‡食人妖巡邏:徹底死亡',
    nil,
    '‡По поручению капитана Руперта полейте 5 павших пехотинцев Серебряного Авангарда в Драк\'Сотре маслом для сожжения.‡Hauptmann Rupert möchte, dass Ihr das einäschernde Öl über 5 besiegte Argentumfußsoldaten gießt.‡대장 루퍼트가 드락소트라에 있는 패배한 은빛십자군 보병 5명의 시체에 소각용 기름을 사용해 달라고 했습니다.‡El capitán Rupert quiere que uses el aceite de incineración sobre 5 lacayos Argenta derrotados en Drak\'Sotra.‡El capitán Rupert quiere que uses el aceite de incineración sobre 5 lacayos Argenta derrotados en Drak\'Sotra.‡Le Capitaine Rupert vous a demandé d\'utiliser l\'Huile incinératrice sur 5 Fantassins d\'argent défaits à Drak\'Sotra.‡‡',
  }
},
[12569] = {
  {
    'Maestria dos crocoliscos: a emboscada‡Охота на кроколисков: засада‡Meister der Krokiliskenjagd: Der Hinterhalt‡악어 사냥법 익히기: 매복‡Domina el crocolisco: la emboscada‡Domina el crocolisco: la emboscada‡La maîtrise des crocilisques : l\'embuscade‡狩猎鳄鱼：伏击‡鱷魚專精:伏擊',
    nil,
    'Leve a Mandíbula do Atacamato para Debaar, no Acampamento do Rosarães.‡Принесите челюсть Прогрызателя Дебаар в лагерь Эрнестуэя.‡Bringt Buschräubers Kiefer zu Debaar in Nesingwarys Basislager.‡네싱워리 주둔지에 있는 데바르에게 덤불잠복꾼의 턱을 가져가야 합니다.‡Tráele la quijada de Matagolpe a Debaar en el Campamento Base de Nesingwary.‡Tráele la quijada de Matagolpe a Debaar en el Campamento Base de Nesingwary.‡Rapportez la Mâchoire de Broussard à Debaar, au Camp de base de Nesingwary.‡将丛林霸王的颚骨交给奈辛瓦里营地的蒂巴尔。‡把奇襲者的顎骨帶去奈辛瓦里營地的給戴巴爾。',
  }
},
[12570] = {
  {
    'Bom mal-entendido‡Счастливое непонимание‡Glückliche Missverständnisse‡오해가 행운으로‡Malentendidos afortunados‡Malentendidos afortunados‡Un heureux malentendu‡幸福的误会‡幸運的誤解',
    nil,
    'Escolte o Oráculo Voz-da-chuva Ferido até as Frondes Voz-da-chuva e fale com o Sumo Oráculo Soo-say.‡Отведите раненого оракула в Прибежище Гласа Дождя и поговорите с верховным оракулом Су-сэем.‡Geleitet das verletzte Orakel der Regenrufer sicher zum Baldachin der Regenrufer und sprecht mit dem Hochorakel Soo-say.‡상처입은 구름몰이골록 점쟁이를 구름몰이 거처로 호위한 다음 대점쟁이 수세이와 대화해야 합니다.‡Escolta al Oráculo Hablalluvia herido hasta la Espesura Hablalluvia y habla con el sumo Oráculo Soo-pinstán.‡Escolta al Oráculo Hablalluvia herido hasta la Espesura Hablalluvia y habla con el sumo Oráculo Soo-pinstán.‡Escortez l\'Oracle parlepluie blessé jusqu\'à la Canopée Parlepluie et allez parler au Haut-oracle Soo-pape.‡护送受伤的雨声神谕者返回雨声树屋，然后与高阶神谕者索乌塞谈一谈。‡護送受傷的雨頌神諭者回到雨頌者之篷然後與高階神諭者蘇-楔交談。',
  }
},
[12571] = {
  {
    'Faz a cobra malvada ir embora‡Большая Скверная Змея должна уйти‡Mach böse Schlangen fort‡사악한 뱀 처치‡Haz que se vaya la serpiente mala‡Haz que se vaya la serpiente mala‡Faire partir le méchant serpent‡赶走坏蛇‡叫壞蛇滾開',
    nil,
    'O Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva, quer que você mate Venena e 10 Najas Imperatrizes.|n|nSe perder a Sacola de Insetos do Lafu, fale com o Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva.‡Верховный оракул Су-сэй из Прибежища Гласа Дождя просит вас убить Ядоклыка и 10 императорских кобр.|n|nЕсли потеряете мешок с жуками Лафу, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Das Hochorakel Soo-say im Baldachin der Regenrufer möchte, dass Ihr Giftspitze und 10 Kaiserkobras tötet.|n|nWenn Ihr Lafoos Käfertasche verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡구름몰이 거처에 있는 대점쟁이 수세이가 맹독혓바닥과 황제 코브라 10마리를 처치해달라고 부탁했습니다.|n|n라푸의 벌레 가방을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 이야기하십시오.‡El sumo Oráculo Soo-pinstán en la Espesura Hablalluvia quiere que mates a Venopunta y a 10 cobras emperador.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡El sumo Oráculo Soo-pinstán en el Canope de Hablalluvia quiere que mates a Venopunta y a 10 cobras emperador.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Le Haut-oracle Soo-pape à la Canopée Parlepluie vous a demandé de tuer Pointevenin et 10 Cobras empereurs.|n|nSi vous perdez le Sac d\'insectes de Lafoo, allez parler au Haut-oracle Soo-pape à la Canopée Parlepluie.‡雨声树屋的高阶神谕者索乌塞要你杀死毒尖和10条帝王眼镜蛇。|n|n如果你弄丢了拉弗乌的虫袋，就去找雨声树屋的高阶神谕者索乌塞。‡雨頌者之篷的高階神諭者蘇-楔要你殺了毒尖與10條大王眼鏡蛇。|n|n如果你弄丟了拉富的蟲子袋，去雨頌者之蓬找高階神諭者蘇-楔談談。',
  }
},
[12572] = {
  {
    'Deuses gostam de coisas brilhantes‡Боги любят блестящие штучки‡Götter wollen Glitzerglitzer‡신은 반짝이를 좋아해‡A los dioses les gustan las cosas brillantes‡A los dioses les gustan las cosas brillantes‡Les dieux aiment le qui-brille‡神祗喜欢亮闪闪的东西‡神喜歡亮晶晶的東西',
    nil,
    'Colete 6 tesouros desenterrados por Lafu e leve-os ao Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva.|n|nSe perder a Sacola de Insetos do Lafu, fale com o Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva.‡Соберите 6 драгоценных блестяшек, которые выкопает Лафу, и принесите их верховному оракулу Су-сэю в прибежище Гласа Дождя.|n|nЕсли потеряете мешок с жуками Лафу, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Sammelt 6 von den Schätzen, die Lafoo ausgräbt, und bringt sie zum Hochorakel Soo-say auf dem Baldachin der Regenrufer.|n|nSprecht mit dem Hochorakel Soo-say auf dem Baldachin der Regenrufer, falls Ihr Lafoos Käfertasche verlieren solltet.‡라푸가 파낸 보물 6개를 구름몰이 거처에 있는 대점쟁이 수세이에게 가져가야 합니다.|n|n라푸의 벌레 가방을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 이야기하십시오.‡Recoge 6 de los tesoros que Lafoo encuentre y llévaselos al sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Recoge 6 de los tesoros que Lafoo encuentre y llévaselos al sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Récupérez 6 des trésors déterrés par Lafoo et rapportez-les au Haut-oracle Soo-pape à la Canopée Parlepluie.|n|nSi vous perdez le Sac d\'insectes de Lafoo, allez parler au Haut-oracle Soo-pape à la Canopée Parlepluie.‡收集6份拉弗乌从土堆里挖出的闪闪发亮的宝贝，将它们交给雨声树屋的高阶神谕者索乌塞。|n|n如果你弄丢了拉弗乌的虫袋，就去找雨声树屋的高阶神谕者索乌塞。‡收集拉富挖出來的6個物品然後帶回去給高階神諭者蘇-楔，他就在雨頌者之篷。|n|n如果你搞丟了拉富的蟲子袋，去和雨頌者之蓬的高階神諭者蘇-楔聊聊。',
  }
},
[12573] = {
  {
    'Fazendo as pazes‡Заключение мира‡Frieden schließen‡평화 협정‡Hacer las paces‡Hacer las paces‡Faire la paix‡议和‡締造和平',
    nil,
    'O Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva, quer que você entregue uma proposta de paz ao Xamã Vekjik e retorne com a resposta dele.|n|nSe perder a Sacola de Insetos do Lafu, fale com o Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva.‡Верховный оракул Су-сэй из Прибежища Гласа Дождя хочет, чтобы вы пошли к шаману Векжику и предложили ему мир. Вернитесь к Су-сэю с ответом.|n|nЕсли потеряете мешок с жуками Лафу, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Das Hochorakel Soo-say im Baldachin der Regenrufer möchte, dass Ihr Schamanen Vekjik ein Friedensangebot unterbreitet und anschließend mit seiner Antwort wieder zurückkehrt.|n|nSprecht mit dem Hochorakel Soo-say im Baldachin der Regenrufer, falls Ihr Lafoos Käfertasche verlieren solltet.‡구름몰이 거처에 있는 대점쟁이 수세이가 주술사 베크지크에게 구름몰이골록들이 보낸 평화의 선물을 건넨 다음 대답을 받아 오라고 했습니다.|n|n라푸의 벌레 가방을 잃어버리면 구름몰이 거처에 있는 대점쟁이 수세이와 이야기하십시오.‡El sumo Oráculo Soo-pinstán en la Espesura Hablalluvia quiere que le hagas una oferta de paz al chamán Vekjik y vuelvas con su respuesta.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡El sumo Oráculo Soo-pinstán en el Canope de Hablalluvia quiere que le hagas una oferta de paz al chamán Vekjik y vuelvas con su respuesta.|n|nSi pierdes la bolsa de bichos de Lafoo, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Le Haut-oracle Soo-pape à la Canopée Parlepluie vous a demandé de donner l\'Offrande de paix au Chaman Vekjik, puis de revenir lui donner sa réponse.|n|nSi vous perdez le Sac d\'insectes de Lafoo, parlez au Haut-oracle Soo-pape à la Canopée Parlepluie.‡雨声树屋的高阶神谕者索乌塞要你将雨声议和礼物交给萨满祭司维克伊克，然后转达他的回应。|n|n如果你弄丢了拉弗乌的虫袋，就去找雨声树屋的高阶神谕者索乌塞。‡雨頌者之篷的高階神諭者蘇-楔要你將和平的提議交給薩滿維克吉克，接著將他的回應帶回來。|n|n如果你弄丟了拉富的蟲子袋，去和雨頌者之蓬的高階神諭者蘇-楔談談。',
  }
},
[12574] = {
  {
    'Já de volta?‡Так скоро?‡Schon zurück?‡벌써 왔나?‡¿Ya has vuelto?‡¿Ya has vuelto?‡Déjà de retour ?‡这么快就回来啦？‡這麼快就回來?',
    nil,
    'Vá até o Refúgio Brumurmúria e fale com o Chamabruma Soo-gan.|n|nSe perder o Cristal Favorito de Jaloot, fale com o Sumo Oráculo Soo-say nas Frondes Voz-da-chuva.‡Отправляйтесь в убежище Шепота Тумана и поговорите с Призывателем туманов Су-ганом.|n|nЕсли вы потеряете любимый кристалл Джалута, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Reist zur Zuflucht der Nebelflüsterer und sprecht mit Nebelrufer Soo-gan.|n|nWenn Ihr Jaloots Lieblingskristall verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡안개속삭임 야영지로 가서 안개부름이 수간과 이야기해야 합니다.|n|n잘루트의 애지중지 수정을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 이야기하십시오.‡Ve al Refugio Susurraneblina y habla con el clamaneblina Soo-papo.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Ve al Refugio Susurraneblina y habla con el clamaneblina Soo-papo.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Rendez-vous au Refuge de Murmebrume et parlez au Mandebrume Soo-flet.|n|nSi vous perdez le Cristal favori de Jaloot, allez parler au Haut-oracle Soo-pape à la Canopée Parlepluie.‡前往雾语村，与唤雾者索乌甘谈一谈。|n|n如果你弄丢了亚鲁乌特的宝贝水晶，就去找雨声树屋的高阶神谕者索乌塞。‡前往霧語村，並且與喚霧者蘇-綱交談。|n|n如果你弄丟了賈露特最愛的水晶，去找雨頌者之蓬的高階神諭者蘇-楔談談。',
  }
},
[12575] = {
  {
    'O tesouro perdido de Brumurmúria‡Потерянное сокровище Шепота Тумана‡Der verlorene Schatz der Nebelflüsterer‡잃어버린 안개속삭임 보물‡El tesoro Susurraneblina perdido‡El tesoro Susurraneblina perdido‡Le trésor perdu de Murmebrume‡被抢走的雾语宝物‡丟失的霧語寶藏',
    nil,
    'Mate o Senhor da Guerra Tartek e recupere o Tesouro de Brumurmúria para o Chamabruma Soo-gan, no Refúgio Brumurmúria.|n|nSe perder o Cristal Favorito de Jaloot, fale com o Sumo Oráculo Soo-say nas Frondes Voz-da-chuva.‡Убейте полководца Тартека и добудьте сокровище Шепота Тумана по просьбе призывателя туманов Су-гана.|n|nЕсли вы потеряете любимый кристалл Джалута, поговорите с верховным оракулом Су-сэем в Прибежище Гласа Дождя.‡Tötet Kriegsfürst Tartek und bringt den Schatz der Nebelflüsterer für Soo-gan in der Zuflucht der Nebelflüsterer zurück.|n|nWenn Ihr Jaloots Lieblingskristall verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡대군주 타르텍을 처치하고 안개속삭임 보물을 안개속삭임 야영지에 있는 안개부름이 수간에게 가져다주어야 합니다.|n|n잘루트의 애지중지 수정을 잃어버리면 구름몰이 거처에 있는 대점쟁이 수세이와 대화하십시오.‡Mata al señor de la guerra Tartek y recupera el tesoro Susurraneblina para el clamaneblina Soo-papo en el Refugio Susurraneblina.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Mata al señor de la guerra Tartek y recupera el tesoro Susurraneblina para el clamaneblina Soo-papo en el Refugio Susurraneblina.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Tuez le Seigneur de guerre Tartek, puis rapportez le Trésor de Murmebrume au Mandebrume Soo-flet au Refuge de Murmebrume.|n|nSi vous perdez le Cristal favori de Jaloot, parlez au Haut-oracle Soo-pape dans la Canopée Parlepluie.‡雾语村的唤雾者索乌甘要你杀死督军塔尔特克，并取回雾语宝物。|n|n如果你弄丢了亚鲁乌特的宝贝水晶，就去找雨声树屋的高阶神谕者索乌塞。‡殺掉督軍塔提克，然後把霧語寶藏帶回去給霧語避難所的喚霧者蘇-綱。|n|n如果你弄丟了賈露特最愛的水晶，去找雨頌者之蓬的高階神諭者蘇-楔談談。',
  }
},
[12576] = {
  {
    'Dando um basta‡Тяжелая рука‡Mit harter Hand‡무력으로 해결‡A la fuerza‡A la fuerza‡Nous veut pas…‡被迫出手‡強迫手段',
    nil,
    'Mate 8 Lanceiros Feralma e 6 Catadores Feralma para o Chamabruma Soo-gan, no Refúgio Brumurmúria.|n|nSe perder o Cristal Favorito de Jaloot, fale com o Sumo Oráculo Soo-say nas Frondes Voz-da-chuva.‡Убейте 8 копьеносцев племени Бешеного Сердца и 6 падальщиков племени Бешеного Сердца по просьбе Призывателя туманов Су-гана из убежища Шепота Тумана.|n|nЕсли вы потеряете любимый кристалл Джалута, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Tötet 8 Speerträger der Wildherzen und 6 Strauchdiebe der Wildherzen für Nebelrufer Soo-gan in der Zuflucht der Nebelflüsterer.|n|nWenn Ihr Jaloots Lieblingskristall verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡광란의심장일족 창잡이 8마리와 광란의심장일족 청소부 6마리를 처치하고 안개속삭임 야영지에 있는 안개부름이 수간에게 돌아가야 합니다.|n|n잘루트의 애지중지 수정을 잃어버리면 구름몰이 거처에 있는 대점쟁이 수세이와 이야기하십시오.‡Mata a 8 arponeros Corazón Frenético y a 6 carroñeros Corazón Frenético para el clamaneblina Soo-papo en el Refugio Susurraneblina.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Mata a 8 arponeros Corazón Frenético y a 6 carroñeros Corazón Frenético para el clamaneblina Soo-papo en el Refugio Susurraneblina.|n|nSi pierdes el cristal favorito de Jaloot, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Tuez 8 Porte-épieux frénécœurs et 6 Charognards frénécœurs pour le Mandebrume Soo-flet au Refuge de Murmebrume.|n|nSi vous perdez le Cristal favori de Jaloot, parlez au Haut-oracle Soo-pape dans la Canopée Parlepluie.‡雾语村的唤雾者索乌甘要你杀死8个狂心持矛者和6个狂心清除者。|n|n如果你弄丢了亚鲁乌特的宝贝水晶，就去找雨声树屋的高阶神谕者索乌塞。‡替霧語避難所的喚霧者蘇-綱，殺死8隻狂心持矛者和6隻狂心拾荒者，完成後向喚霧者蘇-綱回報。|n|n如果你弄丟了賈露特最愛的水晶，去雨頌者之蓬找高階神諭者蘇-楔談談。',
  }
},
[12577] = {
  {
    'Hora de voltar para casa!‡Пора домой!‡Hausezeit!‡집으로!‡¡Hora de volver a casa!‡¡Hora de volver a casa!‡Il est temps de rentrer !‡回家喽！‡回家囉!',
    nil,
    'Retorne às Frondes Voz-da-chuva.‡Возвращайтесь в прибежище Гласа Дождя.‡Kehrt zum Baldachin der Regenrufer zurück.‡구름몰이 거처로 돌아가야 합니다.‡Vuelve a la Espesura Hablalluvia.‡Vuelve al Canope de Hablalluvia.‡Retournez à la Canopée Parlepluie.‡返回雨声树屋。‡回到雨頌者之蓬。',
  }
},
[12578] = {
  {
    'O furioso Gorloc‡Разгневанный горлок‡Der wütende Gorloc‡골록의 분노‡El górloc enfadado‡El górloc enfadado‡Le gorloc furieux‡愤怒的鳄鱼人‡憤怒的戈洛克',
    nil,
    'Vá até a Aldeia Mofâmbulo e fale com Mútli.|n|nSe perder a Bola de Relaxamento do Mútli, fale com o Sumo Oráculo Soo-say nas Frondes Voz-da-chuva.‡Отправляйтесь в деревню Мохобродов и поговорите с Мульдом.|n|nЕсли вы потеряете резиновый мячик Мульда, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Reist ins Mooswandlerdorf und sprecht gleich nach Eurer Ankunft mit Moodle.|n|nWenn Ihr Moodles Stressball verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡이끼걸음 마을로 가서 무들과 이야기해야 합니다.|n|n무들의 족쇄공을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 대화하십시오.‡Ve al Poblado Caminamoho y habla con Moodle cuando llegues.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Ve al Poblado Caminamoho y habla con Moodle cuando llegues.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Rendez-vous à Marchemousse et parlez à Moudel lorsque vous serez arrivé.|n|nSi vous perdez la Balle anti-stress de Moudel, parlez au Haut-oracle Soo-pape dans la Canopée Parlepluie.‡抵达苔行村后与莫乌德谈一谈。|n|n如果你弄丢了莫乌德的皮球，就去找雨声树屋的高阶神谕者索乌塞。‡前往苔行者村，抵達後與穆斗交談。|n|n如果你失去了穆斗的壓力球，去找雨頌者之蓬的高階神諭者蘇-楔談談。',
  }
},
[12579] = {
  {
    'Sangue vital do santuário Mofâmbulo‡Жизненная Сила для мохобродов‡Lebensblut des Mooswandlerschreins‡이끼걸음 제단 생명의 피‡Sangrevida del santuario Caminamoho‡Sangrevida del santuario Caminamoho‡Le sang-de-vie du sanctuaire marchemousse‡苔行祭坛的源血碎片‡苔行者聖壇的活血水晶',
    nil,
    'Mútli quer que você colete 10 Estilhaços de Sangue Vital, mas fique longe da caverna que fica dentro do pilar.|n|nSe perder a Bola de Relaxamento do Mútli, fale com o Sumo Oráculo Soo-say nas Frondes Voz-da-chuva.‡Мульд хочет, чтобы вы собрали 10 осколков Жизненной Силы, но при этом держались подальше от пещеры внутри самой колонны.|n|nЕсли вы потеряете резиновый мячик Мульда, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Moodle möchte, dass Ihr 10 Lebensblutscherben sammelt, aber haltet Euch von der Höhle innerhalb der Säule selbst fern.|n|nWenn Ihr Moodles Stressball verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡무들이 생명의 피 결정 10개를 모아오라고 했습니다. 봉우리 안쪽에 있는 동굴에는 가까이 가지 말아야 합니다.|n|n무들의 족쇄공을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 이야기하십시오.‡Moodle quiere que recojas 10 fragmentos de sangrevida, pero no te acerques a la cueva que hay dentro del propio pilar.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Moodle quiere que recojas 10 fragmentos de sangrevida, pero no te acerques a la cueva que hay dentro del propio pilar.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Moudel vous a demandé de récolter 10 Éclats sang-de-vie, mais d\'éviter de vous rendre dans la grotte à l\'intérieur du pilier.|n|nSi vous perdez la Balle anti-stress de Moudel, parlez au Haut-oracle Soo-pape dans la Canopée Parlepluie.‡莫乌德要你去收集10块源血碎片，但是你最好不要进入石柱中的洞穴。|n|n如果你弄丢了莫乌德的皮球，就去找雨声树屋的高阶神谕者索乌塞。‡穆斗要你收集10個活血裂片，但是不要靠近石柱內的洞窟。|n|n如果你弄丟了穆斗的壓力球，去找雨頌者之蓬的高階神諭者蘇-楔談談。',
  }
},
[12580] = {
  {
    'O salvador dos Mofâmbulos‡Спаситель мохобродов‡Retter der Mooswandler‡이끼걸음골록의 구원자‡El salvador de los Caminamoho‡El salvador de los Caminamoho‡Le sauveur des Marchemousses‡苔行村的救星‡苔行者救星',
    nil,
    'Mútli quer que você resgate 6 Mofâmbulos Vitimados na Aldeia Mofâmbulo. No entanto, alguns deles podem não estar mais vivos para serem salvos.|n|nSe perder a Bola de Relaxamento do Mútli, fale com o Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva.‡Мульд хочет, чтобы вы спасли 6 мохобродов-жертв из деревни Мохобродов, хотя некоторые из них, возможно, уже мертвы.|n|nЕсли вы потеряете резиновый мячик Мульда, поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя.‡Moodle möchte, dass Ihr 6 Mooswandleropfer im Mooswandlerdorf rettet, obwohl manche von ihnen vielleicht bereits nicht mehr länger leben.|n|nWenn Ihr Moodles Stressball verliert, wendet Euch an das Hochorakel Soo-say im Baldachin der Regenrufer.‡무들이 이끼걸음 마을에서 이끼걸음골록 희생자 6명을 구해달라고 했습니다. 마을에는 이미 죽은 이끼걸음골록 희생자도 있습니다.|n|n무들의 족쇄공을 잃어버리면 구름몰이 거처의 대점쟁이 수세이와 이야기하십시오.‡Moodle quiere que rescates a 6 de las víctimas Caminamoho en el Poblado Caminamoho, aunque algunas quizás ya no estén vivas.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia.‡Moodle quiere que rescates a 6 de las víctimas Caminamoho en el Poblado Caminamoho, aunque algunas quizás ya no estén vivas.|n|nSi pierdes la bola antiestrés de Moodle, habla con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia.‡Moudel vous a demandé de sauver 6 Victimes marchemousses à Marchemousse, même s\'il sera sans doute trop tard pour certaines d\'entre elles.|n|nSi vous perdez la Balle anti-stress de Moudel, parlez au Haut-oracle Soo-pape dans la Canopée Parlepluie.‡莫乌德要你前往苔行村搭救6名苔行村受害者。也许有些鳄鱼人已经命在旦夕，难以挽救了。|n|n如果你弄丢了莫乌德的皮球，就去找雨声树屋的高阶神谕者索乌塞。‡穆斗要你去苔行者村拯救6名苔行受害者，雖然他們之中可能早就死了而無法拯救。|n|n如果你弄丟了穆斗的壓力球，去雨頌者之蓬和高階神諭者蘇-楔談談。',
  }
},
[12581] = {
  {
    'O fardo de um herói‡Бремя героя‡Bürde eines Helden‡영웅의 짐‡La carga de un héroe‡La carga de un héroe‡Le fardeau d\'un héros‡英雄的负担‡英雄的負擔',
    nil,
    'Mate Artruis, o Nefando.|n|nApesar de recomendarmos fortemente garantir a ajuda de amigos, Mútli não poderá acompanhá-lo nesta tarefa.‡Убейте Артруиса Бессердечного.|n|nМульд не сможет отправиться с вами. Вам потребуется помощь друзей.‡Tötet Artruis den Herzlosen.|n|nDa Moodle Euch bei dieser Aufgabe nicht begleiten kann, wird empfohlen, zur Sicherheit auf die Hilfe von Freunden zurückzugreifen.‡냉혹의 알트루이스를 처치해야 합니다.|n|n무들은 이 임무를 도와줄 수 없으니 동료를 구하는 것이 좋습니다.‡Mata a Artruis el Inhumano.|n|nAunque se recomienda buscar la ayuda de otros compañeros, Moodle no podrá acompañarte en esta misión.‡Mata a Artruis el Inhumano.|n|nAunque se recomienda buscar la ayuda de otros compañeros, Moodle no podrá acompañarte en esta misión.‡Tuez Artruis le Sans-cœur.|n|nIl vaudrait mieux avoir de l\'aide, car Moudel ne pourra pas vous accompagner pour cette tâche.‡杀死残忍的阿图里斯。|n|n莫乌德无法陪你执行这项任务，因此你最好召集其他伙伴帮忙。‡殺死『無心者』阿楚依思。|n|n進行援救的過程中，強烈建議需要朋友的協助，穆斗沒有辦法陪你進行這項任務。',
  }
},
[12582] = {
  {
    'Campeão Feralma‡Защитник племени Бешеного Сердца‡Champion der Wildherzen‡광란의심장일족 용사‡Campeón Corazón Frenético‡Campeón Corazón Frenético‡Le champion frénécœur‡狂心氏族的勇士‡狂心勇士',
    nil,
    nil,
  }
},
[12583] = {
  {
    'Pulverizador perdido‡Разбившийся сеятель‡Abgestürzter Seuchensprüher‡파괴된 분사기‡Pulverizador estrellado‡Pulverizador estrellado‡Le pulvérisateur pulvérisé‡坠毁的喷射器‡墜毀的噴灑器',
    nil,
    'A Especialista Engreneide, em Drak\'Sotra, pediu para você coletar as Peças do Pulverizador de Peste.‡Соберите детали сеятеля чумы для специалиста Зубоколеса в Драк\'Сотре.‡Spezialistin Zahnrad in Drak\'Sotra möchte, dass Ihr Seuchensprüherteile sammelt.‡드락소트라에 있는 전문가 코그휠이 역병 분사기 부품을 가져와 달라고 부탁했습니다.‡La especialista Engranaje en Drak\'Sotra te ha pedido que consigas piezas de pulverizador de peste.‡La especialista Engranaje en Drak\'Sotra te ha pedido que consigas piezas de pulverizador de peste.‡La Spécialiste Roudenté à Drak\'Sotra vous a demandé de collecter des Pièces du pulvérisateur de peste.‡达克索塔的专家考格维尔要求你去收集药剂喷射器零件。‡德拉克索璀的專家榫輪要你去收集瘟疫噴灑器零件。',
  }
},
[12584] = {
  {
    'Pura maldade‡Зло в чистом виде‡Das pure Böse‡악의 정수‡Mal en estado puro‡Mal en estado puro‡Le mal à l\'état pur‡纯粹的邪恶‡純粹的邪惡',
    nil,
    'Capitão Ruperto pediu para você coletar 10 Pedaços de Saronita e entregá-los a Eitrigg, na Fortaleza Argêntea.‡По указанию капитана Руперта соберите 10 кусков саронита и отнесите их Эйтриггу на Серебряную заставу.‡Hauptmann Rupert möchte, dass Ihr 10 Brocken Saronit einsammelt und sie anschließend zu Etrigg in der Argentumwache bringt.‡대장 루퍼트가 사로나이트 덩어리 10개를 모아 은빛십자군 격전지에 있는 아이트리그에게 전달해 달라고 부탁했습니다.‡El capitán Rupert te ha pedido que recojas 10 trozos de saronita y se los lleves a Eitrigg en El Confín Argenta.‡El capitán Rupert te ha pedido que recojas 10 trozos de saronita y se los lleves a Eitrigg en El Confín Argenta.‡Le Capitaine Rupert vous a demandé de collecter 10 Morceaux de saronite et de les apporter à Eitrigg au Séjour d\'Argent.‡鲁伯特上尉要求你收集10份大块的萨隆邪铁，并将它们交给银色前沿的伊崔格。‡魯伯特上尉要你收集10個大塊的薩鋼礦然後送去給銀白看臺的伊崔格。',
  }
},
[12585] = {
  {
    '‡Тролльский дозор: животворящее тепло‡Trollpatrouille: Annehmlichkeiten‡트롤 순찰: 편안한 휴식‡Patrulla trol: bienestar material‡Patrulla trol: bienestar material‡Patrouille anti-trolls: une bonne flambée‡巡逻员：温暖的篝火‡食人妖巡邏:物質享受',
    nil,
    '‡Принесите капитану Гронделю в Драк\'Агал 20 кусков древесины высохшего колючника.‡Hauptmann Grondel in Drak\'Agal möchte, dass Ihr ihm 20 Stück abgestorbenes Dornholz bringt.‡드락아갈에 있는 대장 그론델이 죽은 가시나무 20개를 가져다 달라고 했습니다.‡El capitán Grondel en Drak\'Agal quiere que le traigas 20 trozos de arbusto espinoso seco.‡El capitán Grondel en Drak\'Agal quiere que le traigas 20 trozos de arbusto espinoso seco.‡Le Capitaine Grondel de Drak\'Agal vous a demandé de lui rapporter 20 morceaux de Bois d\'épineux mort.‡达克迦尔的格隆迪尔上尉要你为他收集20份枯死的荆木。‡',
  }
},
[12586] = {
  {
    'In Search of Bigger Game‡В поисках крупной дичи‡In Search of Bigger Game‡더 큰 사냥감을 찾아서‡Buscando presas mayores‡Buscando presas mayores‡À la recherche d\'un plus gros gibier‡In Search of Bigger Game‡搜尋更大的獵物',
    nil,
    'Talk to <x> at <x>.‡Talk to <x> at <x>.‡Talk to <x> at <x>.‡<x>에 있는 <x>와 이야기해야 합니다.‡Habla con <x> en <x>.‡Habla con <x> en <x>.‡Parlez à <x> à <x>.‡与<x>的<x>交谈。‡與<x>的<x>交談。',
  }
},
[12587] = {
  {
    'Patrulha troll‡Тролльский дозор‡Trollpatrouille‡트롤 순찰‡Patrulla trol‡Patrulla trol‡Patrouille anti-trolls‡巡逻员‡食人妖巡邏',
    nil,
    'O Comandante Kunz, na Fortaleza Argêntea, quer que você vá até os quatro postos da Cruzada Argêntea, siga as ordens dos capitães de cada um deles e depois se apresente novamente a ele.|n|nO Capitão Brandão e o Capitão Ruperto estão em Drak\'Sotra, o Capitão Grondel está em Draz\'Agal e o Alquimista Bacamarte está em Heb\'Valok.‡Обойдите четыре заставы Серебряного Авангарда, выполните приказы капитанов и возвратитесь к командиру Кунцу на Серебряную заставу с докладом.|n|nЗаставы капитана Брендона и капитана Руперта расположены в Драк\'Сотре, к юго-востоку, застава капитана Гронделя – в Драк\'Агале, прямо на восток, а застава алхимика Финкльштейна – в Хеб\'Валоке, к северу.‡Kommandant Kunz in der Argentumwache möchte, dass Ihr die vier Stützpunkte des Argentumkreuzzugs besucht, den Befehlen der dortigen Anführer gehorcht und anschließend bei ihm Bericht erstattet.|n|nHauptmann Brandon und Hauptmann Rupert sind in Drak\'Sotra stationiert, Hauptmann Grondel in Drak\'Agal und Alchemist Finkelstein in Heb\'Valok.‡은빛십자군 격전지에 있는 사령관 쿤즈가 은빛십자군 초소를 방문해 각 대장이 주는 임무를 마치고 돌아와서 보고해 달라고 했습니다.|n|n대장 브랜든과 대장 루퍼트는 드락소트라에, 대장 그론델은 드락아갈에, 연금술사 핀클스타인은 헤브발로크에 있습니다.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡El comandante Kunz de El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, cumplas las órdenes de sus capitanes y vuelvas para informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, el capitán Grondel está apostado en Drak\'Agal y el alquimista Finklestein está apostado en Heb\'Valok.‡Le Commandant Kunz du Séjour d\'Argent vous a demandé de vous rendre aux quatre postes de la Croisade d\'argent, de suivre les ordres de leurs capitaines et de revenir ensuite lui faire votre rapport.|n|nLe Capitaine Brandon et le Capitaine Rupert sont en poste à Drak\'Sotra, le Capitaine Grondel est en poste à Drak\'Agal, et l\'Alchimiste Finklestein est en poste à Heb\'Valok.‡银色前沿的指挥官库恩斯要你拜访四座银色北伐军的岗哨，并完成那里的上尉交给你的任务，然后回去向他复命。|n|n布兰顿上尉和鲁伯特上尉驻扎在达克索塔。|n|n格隆迪尔上尉驻扎在达克迦尔。|n|n炼金师菲肯斯坦驻扎在赫布瓦罗。‡銀白看臺的指揮官康茲要你造訪四座銀白十字軍崗哨，遵從該處上尉的命令，完成後回報給他。布蘭登上尉和魯伯特上尉駐守在德拉克索璀，格隆戴爾上尉駐守在德拉克亞苟，而鍊金師芬克斯坦駐守在希伯伐洛克。',
  }
},
[12588] = {
  {
    'Patrulha troll: você sabe cavar?‡Тролльский дозор: будем копать‡Trollpatrouille: Könnt Ihrs aushalten?‡트롤 순찰: 보물 발굴‡Patrulla trol: ¿Quieres cavar?‡Patrulla trol: ¿Quieres cavar?‡Patrouille anti-trolls : et que ça creuse !‡巡逻员：挖挖看？‡食人妖巡邏:你能挖出來嗎?',
    nil,
    'O Capitão Brandão, em Drak\'Sotra, quer que você use a Picareta de Aço nos Monturos de Terra Antigos para obter a Relíquia Drakkari Antiga.‡По поручению капитана Брана из Драк\'Сотры возьмите стальной заступ, раскопайте курганы древних троллей неподалеку и отыщите реликвию Драккари.‡Hauptmann Brandon in Drak\'Sotra möchte, dass Ihr mit dem Stahlspaten in den uralten Erdhaufen in der Nähe herumgrabt, um das uralte Relikt der Drakkari zu finden.‡드락소트라에 있는 대장 브랜든이 근처의 고대 흙더미에서 철제 부삽을 사용해 고대 드라카리 유물을 찾아달라고 부탁했습니다.‡El capitán Brandon en Drak\'Sotra quiere que uses la pala de acero en los túmulos antiguos para recuperar la reliquia Drakkari antigua.‡El capitán Brandon en Drak\'Sotra quiere que uses la pala de acero en los túmulos antiguos para recuperar la reliquia Drakkari antigua.‡Le Capitaine Brandon, à Drak\'Sotra, vous a demandé d\'utiliser la Bêche en acier sur les Monticules de terre anciens alentours pour récupérer la Relique drakkari ancienne.‡达克索塔的布兰顿上尉希望你前往附近的上古土堆附近，使用钢铲寻找上古达卡莱圣物。‡德拉克索璀的布蘭登上尉要你在附近的上古土堆使用鋼鏟來回收上古德拉克瑞聖物。',
  }
},
[12589] = {
  {
    'Coice? Que coice?‡Ничего опасного‡Kick, was für\'n Kick?‡반동? 무슨 반동?‡¿Retroceso? ¿Qué retroceso?‡¿Retroceso? ¿Qué retroceso?‡Du recul ? Quel recul ?‡后坐力？什么后坐力？‡後座力?什麼後座力?',
    nil,
    'Usando o Rifle RJR, atire na maçã na cabeça de Guilherme Sortudo. A seguir, fale com Drostan.‡Выстрелите из винтовки РЖР в яблоко на голове Везучего Вильгельма, а потом поговорите с Дростаном.‡Schießt mit dem RJR-Gewehr den Apfel vom Kopf von Wilhelm dem Glückspilz und sprecht dann mit Drostan.‡RJR 라이플을 사용해 운 좋은 빌헬름의 머리 위에 있는 사과를 맞춘 다음 드로스탄과 대화해야 합니다.‡Usando el rifle RJR, dispara a la manzana encima de la cabeza de Suertudo Wilhelm y luego habla con Drostan.‡Usando el rifle RJR, dispara a la manzana encima de la cabeza de Suertudo Wilhelm y luego habla con Drostan.‡Avec la Carabine RJR, tirez sur la pomme placée sur le crâne de Wilhelm le Verni, puis parlez à Drostan.‡使用RJR步枪击中幸运的威尔海姆头顶的苹果，然后与德洛斯坦谈一谈。‡使用RJR步槍，射擊幸運的維爾海姆頭上的蘋果，然後和德羅斯坦交談。',
  }
},
[12590] = {
  {
    'Blahblah[PH]‡Blahblah[PH]‡Blahblah[PH]‡Blahblah[PH]‡Blahblah[PH]‡Blahblah[PH]‡Blahblah [PH]‡Blahblah[PH]‡布拉布拉[PH]',
    nil,
    nil,
  }
},
[12591] = {
  {
    'Patrulha troll: entrando em combate‡Тролльский дозор: подрывные работы‡Trollpatrouille: Werfen‡트롤 순찰: 폭발물 투척‡Patrulla trol: lanzamientos‡Patrulla trol: lanzamientos‡Patrouille anti-trolls : attention en dessous !‡巡逻员：扔手雷‡食人妖巡邏:投彈',
    nil,
    'O Capitão Ruperto, em Drak\'Sotra, quer que você use Granadas de Alto Impacto perto de 5 Crateras Nerubianas.‡По поручению капитана Руперта из Драк\'Сотры взорвите 5 нерубианских кратеров с помощью фугасных гранат.‡Hauptmann Rupert in Drak\'Sotra möchte, dass Ihr hocheffektive Granaten in der Nähe von 5 nerubischen Kratern einsetzt.‡드락소트라에 있는 대장 루퍼트가 네루비안 굴 5개에 고충격 폭발물을 사용해 달라고 부탁했습니다.‡El capitán Rupert en Drak\'Sotra quiere que uses granadas de gran impacto cerca de 5 cráteres nerubianos.‡El capitán Rupert en Drak\'Sotra quiere que uses granadas de gran impacto cerca de 5 cráteres nerubianos.‡Le Capitaine Rupert à Drak\'Sotra vous a demandé d\'utiliser des Grenades à percussion près de 5 Cratères néthurbiens.‡达克索塔的鲁伯特上尉希望你在5个蛛魔隧道附近使用高能冲击手雷。‡德拉克索璀的魯伯特上尉要你對5個奈幽蟲坑使用高衝擊手榴彈。',
  }
},
[12592] = {
  {
    'O desafio do grande caçador‡Вызов великого охотника‡Des großen Jägers Wettstreit‡위대한 사냥꾼의 대결‡El gran desafío del cazador‡El gran desafío del cazador‡Le défi du grand chasseur‡猎人的挑战‡偉大獵人的挑戰',
    nil,
    'Mate 60 Animais enquanto ajuda Rosarães e seus companheiros na caça. Quando terminar de matar os 60, fale novamente com Drostan, no Acampamento do Rosarães, e compare os resultados.‡Убейте 60 животных, помогая Хемингу и его друзьям на охоте. Когда покончите с этим, возвращайтесь к Дростану в лагерь Эрнестуэя, чтобы сравнить ваши результаты.‡Tötet 60 Beutetiere, während Ihr Hemet und seinen Kameraden bei der Jagd helft. Kehrt zu Drostan in Nesingwarys Basislager zurück, wenn Ihr Eure 60 getötet habt, um Ergebnisse zu vergleichen.‡헤멧과 그의 원정대원들의 사냥을 도와주면서 사냥감 60 마리를 처치해야 합니다. 60마리를 제거하면 다음 네싱워리 주둔지에 있는 드로스탄에게 돌아가 숫자를 비교해 보십시오.‡Mata 60 animales de caza mientras ayudas a Hemet y sus compañeros en la cacería. Cuando mates a los 60, vuelve a Drostan en el Campamento Base de Nesingwary para comparar vuestros números.‡Mata 60 animales de caza mientras ayudas a Hemet y sus compañeros en la cacería. Cuando mates a los 60, vuelve a Drostan en el Campamento Base de Nesingwary para comparar tus números.‡Tuez 60 têtes de Gibier pour aider Hemet et ses compagnons pendant la chasse. Lorsque vous aurez tué vos 60 proies, retournez voir Drostan au Camp de base de Nesingwary pour comparer vos chiffres.‡在协助赫米特和探险队其他成员狩猎的过程中，杀死60只猎物。在你达成60个的击杀目标后，回到奈辛瓦里营地，与德洛斯坦比对猎物数量。‡在幫助赫米特與其同伴的過程中殺死60隻獵物。當你殺死60隻之後，回到奈辛瓦里營地和德羅斯坦比較數字多寡。',
  }
},
[12593] = {
  {
    'A serviço do Lich Rei‡На службе Короля-лича‡Im Dienste des Lichkönigs‡리치 왕을 위하여‡Al servicio del Rey Exánime‡Al servicio del Rey Exánime‡Au service du roi-liche‡为巫妖王而战‡為巫妖王效力',
    nil,
    'Apresente-se ao instrutor Razúvio no Coração de Áquerus.‡Доложите о своем прибытии инструктору Разувию из Сердца Акеруса.‡Meldet Euch bei Instrukteur Razuvious, sobald Ihr dort seid.‡아케루스의 심장부에 있는 훈련교관 라주비어스에게 보고해야 합니다.‡Preséntate ante el instructor Razuvious en El Corazón de Acherus.|n‡Informa al instructor Razuvious en El Corazón de Acherus.|n‡Présentez-vous à l’instructeur Razuvious au Cœur d\'Achérus.‡向阿彻鲁斯要塞内的教官拉苏维奥斯报告。‡到亞榭洛之心向講師拉祖維斯報到。',
  }
},
[12594] = {
  {
    'Patrulha troll: estou pouco me lixando‡Тролльский дозор: зачистка местности‡Trollpatrouille: Juckt mich kein bisschen‡트롤 순찰: 그냥 두지 않겠다!‡Patrulla trol: me da lo mismo‡Patrulla trol: me da lo mismo‡Patrouille anti-trolls : je m\'en fiche totalement !‡巡逻员：清理场地‡食人妖巡邏:無法坐視',
    nil,
    'O Capitão Grondel quer que você mate 7 Musgos Irados em Draz\'Agal.‡По поручению капитана Гронделя убейте 7 мшистых буянов в Драк\'Агале.‡Hauptmann Grondel möchte, dass Ihr 7 moosbedeckte Amokläufer in Drak\'Agal tötet.‡대장 그론델이 드락아갈에 있는 광포한 이끼 괴물 7마리를 처치해 달라고 부탁했습니다.‡El capitán Grondel quiere que mates 7 arrasadores musgosos en Drak\'Agal.‡El capitán Grondel quiere que mates 7 arrasadores musgosos en Drak\'Agal.‡Le Capitaine Grondel vous a demandé de tuer 7 Chambardeurs moussus dans Drak\'Agal.‡格隆迪尔上尉要你前往达克迦尔，消灭7只青苔狂暴者。‡格隆戴爾上尉要你在德拉克亞苟殺死7隻青苔狂暴者。',
  }
},
[12595] = {
  {
    'Em busca de uma caça maior‡В поисках крупной дичи‡Auf der Suche nach größerem Wild‡더 큰 사냥감을 찾아서‡Buscando presas mayores‡Buscando presas mayores‡À la recherche d\'un plus gros gibier‡更大的猎物‡搜尋更大的獵物',
    nil,
    'Fale com Dorian, o Caçador de Dracos, no Posto Avançado de Dorian, que fica na Bacia Sholazar.‡Поговорите с Дорианом Грозой Драконов в его лагере в Низине Шолазар.‡Sprecht mit Dorian Drachenlauer in Dorians Außenposten im Sholazarbecken.‡숄라자르 분지의 도리안의 전초기지에 있는 도리안 드레이크스토커와 대화해야 합니다.‡Habla con Dorian Asoladracos en la Avanzada de Dorian, en la Cuenca de Sholazar.‡Habla con Dorian Asoladracos en la Avanzada de Dorian, en la Cuenca de Sholazar.‡Parlez à Dorian Traquedrake, à l\'Avant-poste de Dorian, au Bassin de Sholazar.‡与索拉查盆地中多里安营地的多里安·达克斯托谈一谈。‡到休拉薩盆地的多里安營地找多里安·龍巡者交談。',
  }
},
[12596] = {
  {
    'Pa\'Troll‡Па\'трулль‡Pa\'trollieren‡순찰 임무‡Patrulla trol‡Patrulla trol‡L\'organisation des pays producteurs d\'épais trolls‡巡逻任务‡巡食人妖',
    nil,
    'O Comandante Kunz, na Fortaleza Argêntea, quer que você vá até os quatro postos da Cruzada Argêntea, siga as ordens dos líderes de cada um e depois se apresente novamente a ele.|n|nO Capitão Brandão e o Capitão Ruperto estão em Drak\'Sotra, a sudeste daqui.|n|nO Capitão Grondel está em Draz\'Agal, a leste.|n|nO Alquimista Bacamarte está em Heb\'Valok, ao norte.‡Обойдите четыре заставы Серебряного Авангарда, выполните приказы капитанов и возвратитесь к командиру Кунцу на Серебряную заставу с докладом.|n|nЗаставы капитана Брендона и капитана Руперта расположены в Драк\'Сотре, к юго-востоку, застава капитана Гронделя – в Драк\'Агале, прямо на восток, а застава алхимика Финкльштейна – в Хеб\'Валоке, к северу.‡Kommandant Kunz in der Argentumwache möchte, dass Ihr die vier Stützpunkte des Argentumkreuzzugs besucht, den Befehlen der dortigen Anführer gehorcht und anschließend bei ihm Bericht erstattet.|n|nHauptmann Brandon und Hauptmann Rupert sind in Drak\'Sotra südöstlich von hier stationiert.|n|nHauptmann Grondel ist in Drak\'Agal gleich im Osten stationiert.|n|nAlchemist Finkelstein ist in Heb\'Valok im Norden stationiert.‡은빛십자군 격전지에 있는 사령관 쿤즈가 은빛십자군 초소를 방문해 각 대장이 주는 임무를 마치고 돌아와서 보고해 달라고 했습니다.|n|n대장 브랜든과 대장 루퍼트는 남동쪽의 드락소트라에 있습니다.|n|n대장 그론델은 정동쪽의 드락아갈에 있습니다.|n|n연금술사 핀클스타인은 북쪽의 헤브발로크에 있습니다.‡El comandante Kunz en El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, sigas las instrucciones de sus líderes y vuelvas a informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, al sureste de aquí.|n|nEl capitán Grondel está apostado en Drak\'Agal, al este.|n|nEl alquimista Finklestein está apostado en Heb\'Valok, al norte.‡El comandante Kunz en El Confín Argenta quiere que visites los cuatro puestos de la Cruzada Argenta, sigas las instrucciones de sus líderes y vuelvas a informarle.|n|nEl capitán Brandon y el capitán Rupert están apostados en Drak\'Sotra, al sureste de aquí.|n|nEl capitán Grondel está apostado en Drak\'Agal, al este.|n|nEl alquimista Finklestein está apostado en Heb\'Valok, al norte.‡Le Commandant Kunz au Séjour d\'Argent vous a demandé de vous rendre aux quatre postes de la Croisade d\'argent, de suivre les ordres de leurs chefs et de revenir lui faire votre rapport.|n|nLe Capitaine Brandon et le Capitaine Rupert sont en poste à Drak\'Sotra, au sud-est.|n|nLe Capitaine Grondel est en poste à Drak\'Agal, à l\'est.|n|nL\'Alchimiste Finklestein est en poste à Heb\'Valok, au nord.‡银色前沿的指挥官库恩斯要你拜访四座银色北伐军的岗哨，并完成那里的上尉交给你的任务，然后回去向他复命。|n|n布兰顿上尉和鲁伯特上尉驻扎在东南面的达克索塔。|n|n格隆迪尔上尉驻扎在正东边的达克迦尔。|n|n炼金师菲肯斯坦驻扎在北边的赫布瓦罗。‡銀白看臺的指揮官康茲要你造訪四座銀白十字軍崗哨，遵從該處指揮的命令，完成後回報給他。布蘭登上尉和魯伯特上尉駐守在東南方的德拉克索璀。|n|n格隆戴爾上尉駐守在東方的德拉克亞苟。|n|n而鍊金師芬克斯坦駐守在北方的希伯伐洛克。',
  }
},
[12597] = {
  {
    'Algo para a dor‡Обезболивающее снадобье‡Etwas gegen die Schmerzen‡고통 경감‡Algo para el dolor‡Algo para el dolor‡Un remède contre la douleur‡止痛药‡痛苦特效藥',
    nil,
    'O Capitão Brandão, em Drak\'Sotra, quer que você colete 5 Papoulas d\'Água Maduras nos Campos de Drak\'Sotra.‡Соберите 5 распустившихся водяных маков на полях Драк\'Сотры для капитана Брендона из Драк\'Сотры.‡Hauptmann Brandon in Drak\'Sotra möchte, dass Ihr 5 Stück reifen Wassermohns von den Feldern von Drak\'Sotra besorgt.‡드락소트라에 있는 대장 브랜든이 드락소트라 농장에서 다 자란 물양귀비 5개를 가져와 달라고 부탁했습니다.‡El capitán Brandon en Drak\'Sotra quiere que recojas 5 amapolas de agua adultas en los Campos de Drak\'Sotra.‡El capitán Brandon en Drak\'Sotra quiere que recojas 5 amapolas de agua adultas en los Campos de Drak\'Sotra.‡Le Capitaine Brandon de Drak\'Sotra vous a demandé de récolter 5 Pavots aquatiques à maturité dans les champs de Drak\'Sotra.‡达克索塔的布兰顿上尉希望你从达克索塔农田采集5份成熟的水罂粟。‡德拉克索璀的布蘭登上尉要你從德拉克索璀原野收集5個成熟的水罌粟。',
  }
},
[12598] = {
  {
    'Entrando em combate‡Подрывные работы‡Hinunterwerfen‡폭발물 투척‡Lanzamientos‡Lanzamientos‡Attention en dessous !‡扔手雷‡扔下去',
    nil,
    'O Capitão Ruperto, em Drak\'Sotra, quer que você use Granadas de Alto Impacto perto de 5 Crateras Nerubianas.‡По заданию капитана Руперта из Драк\'Сотры обрушьте 5 нерубских тоннелей с помощью фугасных гранат.‡Hauptmann Rupert in Drak\'Sotra möchte, dass Ihr die hocheffektiven Granaten in der Nähe von 5 nerubischen Kratern verwendet.‡드락소트라에 있는 대장 루퍼트가 네루비안 굴 5개에 고충격 폭발물을 사용해 달라고 부탁했습니다.‡El capitán Rupert en Drak\'Sotra quiere que uses granadas de gran impacto cerca de 5 cráteres nerubianos.‡El capitán Rupert en Drak\'Sotra quiere que uses granadas de gran impacto cerca de 5 cráteres nerubianos.‡Le Capitaine Rupert à Drak\'Sotra vous a demandé d\'utiliser des Grenades à percussion près de 5 Cratères nérubiens.‡达克索塔的鲁伯特上尉希望你在5个蛛魔隧道附近使用高能冲击手雷。‡德拉克索璀的魯伯特上尉要你對5個奈幽蟲坑使用高衝擊手榴彈。',
  }
},
[12599] = {
  {
    'Para o alívio de todos‡Животворящее тепло‡Annehmlichkeiten‡편안한 휴식‡Bienestar material‡Bienestar material‡Une bonne flambée‡温暖的篝火‡物質享受',
    nil,
    'O Capitão Grondel, em Draz\'Agal, quer que você leve 20 Troncoespinhos Mortas.‡Принесите капитану Гронделю в Драк\'Агал 20 кусков древесины высохшего колючника.‡Hauptmann Grondel in Drak\'Agal möchte, dass Ihr ihm 20 Stück abgestorbenes Dornholz bringt.‡드락아갈에 있는 대장 그론델이 죽은 가시나무 20개를 가져와 달라고 부탁했습니다.‡El capitán Grondel en Drak\'Agal quiere que le traigas 20 trozos de arbusto espinoso seco.‡El capitán Grondel en Drak\'Agal quiere que le traigas 20 trozos de arbusto espinoso seco.‡Le Capitaine Grondel de Drak\'Agal vous a demandé de lui rapporter 20 morceaux de Bois d\'épineux mort.‡达克迦尔的格隆迪尔上尉要你为他收集20份枯死的荆木。‡德拉克亞苟的格隆戴爾上尉要你拿給他20塊枯死的棘木。',
  }
},
[12600] = {
  {
    '‡Рекламный код Upper Deck – Верховой медведь‡Bärenreittier‡카드매니아 - 곰 탈것‡Promoción de Upper Deck - Montura de oso‡Promoción de Upper Deck - Montura de oso‡Promotion Upper Deck - Ours de monte‡兑换商品–熊坐骑‡兌換商品–熊坐騎',
    nil,
    nil,
  }
},
[12601] = {
  {
    'The Alchemist\'s Apprentice‡В подмастерья к алхимику‡Der Lehrling des Alchemisten‡연금술사의 제자‡El aprendiz de alquimista‡El aprendiz de alquimista‡L\'apprenti alchimiste‡炼金师的帮手‡鍊金師學徒',
    nil,
    'Alchemist Finklestein at Heb\'valok wants you to assist him in the creation of a truth serum.|n|nWhen you are ready to begin, you are to speak to him and follow his instructions.‡Помогите алхимику Финкльштейну в Хеб\'валоке в приготовлении сыворотки правды.|n|nКогда вы будете готовы приступить к работе, скажите об этом алхимику и выполняйте все его указания.‡Alchemist Finkelstein in Heb\'Valok möchte, dass Ihr ihm bei der Herstellung eines Wahrheitsserums helft.|n|nSprecht ihn an und folgt seinen Anweisungen, sobald Ihr bereit seid.‡헤브발로크에 있는 연금술사 핀클스타인이 진실의 물약 제조를 도와달라고 했습니다.|n|n시작할 준비가 되면 그에게 말을 걸고 지시를 따라야 합니다.‡El alquimista Finklestein en Heb\'Valok quiere que le ayudes en la creación del suero de la verdad.|n|nCuando estés listo tienes que hablar con él y seguir sus instrucciones.‡El alquimista Finklestein en Heb\'Valok quiere que lo ayudes en la creación de un suero de la verdad.|n|nCuando estés listo para empezar, habla con él y sigue sus instrucciones.‡L\'Alchimiste Finklestein de Heb\'Valok vous demande de l\'aider dans la fabrication d\'un sérum de vérité.|n|nQuand vous serez prêt à commencer, allez lui parler et suivez ses instructions.‡赫布瓦罗的炼金师菲肯斯坦要你帮他制作真言药水。|n|n准备好以后与他交谈，并按照他的指示行动。‡希伯伐洛克的鍊金師芬克斯坦要你協助他製作自白劑。|n|n你準備好要開始的時候就和他交談，然後遵循他的指示。',
  }
},
[12602] = {
  {
    'The Alchemist\'s Apprentice‡В подмастерья к алхимику‡Der Lehrling des Alchemisten‡연금술사의 제자‡El aprendiz de alquimista‡El aprendiz de alquimista‡L\'apprenti alchimiste‡炼金师的帮手‡鍊金師學徒',
    nil,
    'Alchemist Finklestein at Heb\'valok wants you to assist him in the creation of a truth serum.|n|nWhen you are ready to begin, you are to speak to him and follow his instructions.‡Помогите алхимику Финкльштейну в Хеб\'Валоке в приготовлении сыворотки правды.|n|nКогда вы будете готовы приступить к работе, скажите об этом алхимику и выполняйте все его указания.‡Alchemist Finkelstein in Heb\'Valok möchte, dass Ihr ihm bei der Herstellung eines Wahrheitsserums helft.|n|nSprecht ihn an und folgt seinen Anweisungen, sobald Ihr bereit seid.‡헤브발로크에 있는 연금술사 핀클스타인이 진실의 물약 제조를 도와달라고 했습니다.|n|n시작할 준비가 되면 그에게 말을 걸고 지시를 따라야 합니다.‡El alquimista Finklestein en Heb\'Valok quiere que le ayudes en la creación del suero de la verdad.|n|nCuando estés listo tienes que hablar con él y seguir sus instrucciones.‡El alquimista Finklestein en Heb\'Valok quiere que lo ayudes en la creación de un suero de la verdad.|n|nCuando estés listo para empezar, habla con él y sigue sus instrucciones.‡L\'Alchimiste Finklestein de Heb\'Valok vous demande de l\'aider dans la fabrication d\'un sérum de vérité.|n|nQuand vous serez prêt à commencer, allez lui parler et suivez ses instructions.‡赫布瓦罗的炼金师菲肯斯坦要你帮他制作真言药水。|n|n准备好以后与他交谈，并按照他的指示行动。‡希伯伐洛克的鍊金師芬克斯坦要你協助他製作自白劑。|n|n你準備好要開始的時候就和他交談，然後遵循他的指示。',
  }
},
[12603] = {
  {
    'Afiando as garras‡Время точить когти‡Klauen schärfen‡발톱 갈기‡Afilar tus garras‡Afilar tus garras‡Aiguisez vos griffes‡磨尖你的爪子‡磨利你的爪子',
    nil,
    'Mate 6 Dracos Primordiais e fale com Dorian, o Caçador de Dracos, no Posto Avançado de Dorian.‡Убейте 6 доисторических драконов, а затем поговорите с Дорианом Грозой Драконов в форпосте Дориана.‡Tötet 6 urzeitliche Drachen und sprecht anschließend mit Dorian Drachenlauer in Dorians Außenposten.‡태고의 비룡 6마리를 처치한 후 도리안의 전초기지에 있는 도리안 드레이크스토커와 대화해야 합니다.‡Mata a 6 dracos primordiales y luego habla con Dorian Asoladracos en la Avanzada de Dorian.‡Mata a 6 dracos primordiales y luego habla con Dorian Asoladracos en la Avanzada de Dorian.‡Tuez 6 Drakes primordiaux puis retournez voir Dorian Traquedrake, à l\'Avant-poste de Dorian.‡杀死6只始生幼龙，然后与多里安哨站的多里安·达克斯托克谈一谈。‡殺死6隻原始飛龍然後和多里安前哨的多里安·龍巡者交談。',
  }
},
[12604] = {
  {
    'Meus parabéns!‡Поздравляем!‡Herzlichen Glückwunsch!‡축하합니다!‡¡Felicidades!‡¡Felicidades!‡Félicitations !‡祝贺你！‡恭喜!',
    nil,
    nil,
  }
},
[12605] = {
  {
    'Armando a isca‡Подготовка ловушки‡Den Köder sichern‡미끼 확보‡Conseguir el cebo‡Conseguir el cebo‡Se procurer l\'appât‡诱龙出巢‡確保誘餌',
    nil,
    'Traga 6 Filhotes Primordiais para Dorian, o Caçador de Dracos, no Posto Avançado de Dorian.‡Принесите Дориану Грозе Драконов 6 доисторических дракончиков в форпост Дориана.‡Bringt 6 urzeitliche Jungtiere zu Dorian Drachenlauer in Dorians Außenposten.‡도리안의 전초기지에 있는 도리안 드레이크스토커에게 태고의 비룡 새끼 6마리를 가져가야 합니다.‡Lleva 6 proles primordiales a Dorian Asoladracos en la Avanzada de Dorian.‡Lleva 6 proles primordiales a Dorian Asoladracos en la Avanzada de Dorian.‡Apportez 6 Jeunes drakes primordiaux à Dorian Traquedrake, à l\'Avant-poste de Dorian.‡将6只始生龙幼崽交给多里安哨站的多里安·达克斯托克。‡把6隻原始雛龍帶給多里安前哨的多里安·龍巡者。',
  }
},
[12606] = {
  {
    'Encasulados!‡В коконах‡In Kokons eingesponnen!‡고치 안의 생존자‡¡Encerrado!‡¡Encerrado!‡Les cocons, c\'est à ça qu\'on les reconnaît.‡茧中人‡繭縛!',
    nil,
    'O Capitão Ruperto quer que você abra os Casulos Nerubianos, em Drak\'Sotra, e fale novamente com ele após libertar 3 Soldados Rasos Cativos.‡Вскройте нерубские коконы в Драк\'Сотре и вернитесь к капитану Руперту в Драк\'Сотру, освободив 3 взятых в плен пехотинцев.‡Hauptmann Rupert möchte, dass Ihr die nerubischen Kokons in Drak\'Sotra öffnet und wieder zu ihm zurückkehrt, sobald Ihr 3 gefangene Fußsoldaten befreit habt.‡대장 루퍼트가 드락소트라에 있는 네루비안 고치를 열어 사로잡힌 보병 3명을 풀어준 다음 돌아와 달라고 부탁했습니다.‡El capitán Rupert quiere que abras capullos nerubianos en Drak\'Sotra y que vuelvas cuando hayas liberado a 3 lacayos cautivos.‡El capitán Rupert quiere que abras capullos nerubianos en Drak\'Sotra y que vuelvas cuando hayas liberado a 3 lacayos cautivos.‡Le Capitaine Rupert vous a demandé d\'ouvrir les Cocons nérubiens de Drak\'Sotra et de revenir le voir quand vous aurez libéré 3 Fantassins emprisonnés.‡鲁伯特上尉要你打开达克索塔的蛛魔之茧，释放3个被俘虏的步兵，然后回去向他复命。‡魯伯特上尉要你打開德拉克索璀的奈幽之繭，解救3個俘虜步卒之後回去和他交談。',
  }
},
[12607] = {
  {
    'Domando o mamute‡Поимка мамонта‡Ein Mammutunternehmen‡매머드 길들이기‡Cazar un mamut‡Cazar un mamut‡À pied, à cheval et en mammouth…‡驯服猛犸象‡一個長毛象任務',
    nil,
    'Traga um Mamute Demolifante para Quebragulho no Posto Avançado de Dorian.‡Приведите Любопытсону в форпост Дориана твердобивневого мамонта.‡Bringt ein Spaltzahnmammut zu Spleenix in Dorians Außenposten.‡조각엄니 매머드를 도리안의 전초기지에 있는 주트피즐에게 데려가야 합니다.‡Trae un mamut Partecolmillos a Zootsilbo en el campamento de Dorian.‡Trae un mamut Partecolmillos a Zootsilbo en el campamento de Dorian.‡Ramenez un Mammouth fracasse-défense à Zazoutille, à l\'Avant-poste de Dorian.‡将一头裂牙猛犸交给多里安哨站的苏特菲兹。‡帶一隻碎牙長毛象給多里安前哨的狹嘶。',
  }
},
[12608] = {
  {
    'Incursão dos sectários‡Вторжение сектантов‡Angriff der Kultisten‡이교도의 습격‡Incursión cultora‡Incursión cultora‡L\'incursion des sectateurs‡诅咒教派的袭击‡教徒入侵',
    nil,
    'Fale com o Avatar de Freya nas Cachoeiras de Voz-da-chuva.‡Поговорите с Аватарой Фрейи у водопадов Гласа Дождя.‡Sprecht mit dem Avatar von Freya im Katarakt der Regenrufer.‡구름몰이 여울목에 있는 프레이야의 화신과 대화해야 합니다.‡Habla con el avatar de Freya en Rápidos de Hablalluvia.‡Habla con el avatar de Freya en Rápidos de Hablalluvia.‡Parlez à l\'Avatar de Freya aux Rapides Parlepluie.‡前往雨声河，与弗蕾亚的化身谈一谈。‡到雨頌者急湍與芙蕾雅的化身交談。',
  }
},
[12609] = {
  {
    'Abastecendo as prateleiras‡Пополнение запасов‡Die Regale einräumen‡시약 재료 수집‡Reponer las existencias‡Reponer las existencias‡Regarnir les étagères‡收集腐液‡補充貨架',
    nil,
    'O Capitão Arnath, em Heb\'Valok, quer que você colete 7 porções de Linfa de Aranha Fresca das Viúvas-negras Rastejantes em Zul\'Drak.‡Соберите 7 унций свежей паучьей лимфы от пауков-капканщиков в Зул\'Драке для капитана Арната из Хеб\'Валока.‡Hauptmann Arnath in Heb\'Valok möchte, dass Ihr 7 Einheiten frischen Spinnensekrets von den Falltürkrabblern in Zul\'Drak sammelt.‡헤브발로크에 있는 대장 아르나스가 줄드락에 있는 들창 거미에게서 신선한 거미 수액 7개를 모아 달라고 부탁했습니다.‡El capitán Arnath en Heb\'Valok te ha pedido que recojas 7 unidades de icor de araña fresco de reptadores ctenízidos en Zul\'Drak.‡El capitán Arnath en Heb\'Valok te ha pedido que recojas 7 unidades de icor de araña fresco de reptadores ctenízidos en Zul\'Drak.‡Le Capitaine Arnath à Heb\'Valok vous a demandé de trouver 7 Ichors d\'araignée frais sur les Rampantes des trappes à Zul\'Drak.‡赫布瓦罗的阿纳斯上尉要你从祖达克的暗门爬行者身上收集7份新鲜的蜘蛛腐液。‡希伯伐洛克的阿爾納斯上尉，要你從組爾德拉克的地門爬行者身上，收集7份新鮮的蜘蛛毒液。',
  }
},
[12610] = {
  {
    'Corte as asinhas‡Подрезанные крылышки‡Ihre Flügel stutzen‡부러진 날개‡Cortar las alas‡Cortar las alas‡Leur couper les ailes‡蝙蝠翅膀‡剪掉他們的翅膀',
    nil,
    'O Capitão Arnath, em Heb\'Valok, pediu para você coletar 7 Asas de Morcego Imaculadas dos Morcegos de Zul\'Drak.‡Соберите 7 безукоризненных крыльев нетопырей в Зул\'Драке для капитана Арната из Хеб\'Валока.‡Hauptmann Arnath in Heb\'Valok möchte, dass Ihr 7 makellose Fledermausflügel von den Fledermäusen von Zul\'Drak sammelt.‡헤브발로크에 있는 대장 아르나스가 줄드락 박쥐에게서 흠집 없는 박쥐 날개 7개를 가져와 달라고 부탁했습니다.‡El capitán Arnath en Heb\'Valok te ha pedido que recojas 7 alas de murciélago inmaculadas de los murciélagos de Zul\'Drak.‡El capitán Arnath en Heb\'Valok te ha pedido que recojas 7 alas de murciélago inmaculadas de los murciélagos de Zul\'Drak.‡Le Capitaine Arnath à Heb\'Valok vous a demandé de lui trouver 7 Ailes de chauve-souris impeccables provenant de Chauve-souris de Zul\'Drak.‡赫布瓦罗的阿纳斯上尉要你从祖达克蝙蝠身上收集7对完美的蝙蝠翅膀。‡希伯伐洛克的阿爾納斯上尉，要你從組爾德拉克蝙蝠身上，收集7個無瑕疵的蝙蝠翼。',
  }
},
[12611] = {
  {
    'Devolver com poder sete vezes maior‡Семикратное воздаяние‡Siebenfach zurückgezahlt‡일곱 배로 돌려주기‡Devolver en séptuplo‡Devolver en séptuplo‡Rendu au centuple‡七倍奉还‡七倍奉還',
    nil,
    'O Avatar de Freya quer que você derrote Thalgran, o Arauto da Peste, usando a Proteção de Freya para refletir as Setas da Morte sobre ele com um poder sete vezes maior.‡Аватара Фрейи хочет, чтобы вы победили Талграна Сеятеля Гнили при помощи Оберега Фрейи, отразив его проклятия и обратив их против него.‡Der Avatar von Freya möchte, dass Ihr Thalgran Seuchenbringer besiegt, indem Ihr mit Freyas Wall seine Todesblitze siebenfach auf ihn zurückwerft.‡프레이야의 화신이 프레이야의 수호물로 탈그란 블라이트브링어가 시전하는 죽음의 화살을 일곱 배로 반사하여 그를 처치해달라고 부탁했습니다.‡El avatar de Freya quiere que derrotes a Thalgran Añublador usando el resguardo de Freya para devolverle sus Descargas de muerte multiplicadas por siete.‡El avatar de Freya quiere que derrotes a Thalgran Añublador usando el resguardo de Freya para devolverle sus Descargas de muerte multiplicadas por siete.‡L\'Avatar de Freya vous demande de vaincre Thalgran Portechancre en utilisant le Gardien de Freya pour lui renvoyer ses Traits de mort au centuple.‡弗蕾亚的化身要你使用弗蕾亚的结界将沙格兰·凋零使者的死亡之箭以7倍伤害返还，以此击败他。‡芙蕾雅的化身要你使用芙蕾雅之禦將薩爾葛倫·荒疫使者的死亡箭七倍反彈回去以擊敗他。',
  }
},
[12612] = {
  {
    'O pilar caído‡Разрушенная колонна‡Die gestürzte Säule‡무너진 봉우리‡El pilar caído‡El pilar caído‡Le pilier effondré‡倒塌的水晶柱‡傾倒之柱',
    nil,
    'Vá ao Pilar Sangue da Vida e procure pistas de sua destruição.‡Отправляйтесь к колонне Жизненной Силы и попытайтесь понять, как она была разрушена.‡Reist zur Lebensblutsäule und sucht nach Hinweisen, die auf die Ursache ihrer Zerstörung hinweisen.‡생명의 피 봉우리로 가서 파괴된 원인을 찾아야 합니다.‡Viaja a El Pilar Sangrevida y busca pistas sobre su destrucción.‡Viaja a El Pilar Sangrevida y busca pistas sobre su destrucción.‡Allez au Pilier Sang-de-vie et cherchez des indices sur les raisons de sa destruction.‡前往源血之柱，寻找石柱倒塌的原因。‡前往活血之柱，尋找它被破壞的線索。',
  }
},
[12613] = {
  {
    'Energizando o pórtico: o Mirante do Criador‡Включение Спирали: Дозор Творцов‡Aufladen des Tors - Die Warte der Schöpfer‡관문 에너지 공급 - 창조주의 전망대‡Activar la puerta: El Mirador de los Creadores‡Activar la puerta: El Mirador de los Creadores‡Activation du portail d\'accès : le surplomb du Faiseur‡开启界门 - 造物者悬台‡甬道之門充能 - 造物者瞰臺',
    nil,
    'O Avatar de Freya quer que você vá ao Mirante do Criador, a leste da Bacia Sholazar, e use o Interruptor Teta.‡Аватара Фрейи хочет, чтобы вы направились к Дозору Творцов на востоке Низины Шолазар и там задействовали активационный переключатель "тета".‡Der Avatar von Freya möchte, dass Ihr Euch zur Warte der Schöpfer im Osten des Sholazarbeckens begebt und den Aktivierungsschalter Theta betätigt.‡프레이야의 화신이 숄라자르 분지 동부에 있는 창조주의 전망대로 가서 활성화 제어기 세타를 작동해 달라고 부탁했습니다.‡El avatar de Freya quiere que te dirijas al Mirador de los Creadores, al este de la Cuenca de Sholazar, y uses el interruptor de activación Theta.‡El avatar de Freya quiere que te dirijas al Mirador de los Creadores, al este de la Cuenca de Sholazar, y uses el interruptor de activación Theta.‡L\'avatar de Freya vous demande de vous diriger vers le Surplomb du Faiseur, à l\'est du Bassin de Sholazar, et d\'utiliser l\'Interrupteur d\'activation Thêta.‡弗蕾亚的化身要你前往索拉查盆地东部的造物者悬台，启动界门开关 - 泰塔。‡芙蕾雅的化身要你前往休拉薩盆地東方的造物者瞰臺，然後使用啟動開關θ。',
  }
},
[12614] = {
  {
    'Agressão pós-parto‡Материнский гнев‡Postnatale Aggression‡어미의 난폭함‡Agresión posparto‡Agresión posparto‡Agression post-partum‡母龙之怒‡產後憂鬱',
    nil,
    'Mate a Prolemadre Slivina e fale novamente com Dorian, o Caçador de Dracos, no Posto Avançado de Dorian.‡Убейте Праматерь Сливину и возвращайтесь к Дориану Грозе Драконов в форпост Дориана.‡Tötet Brutmutter Slivina und kehrt zu Dorian Drachenlauer bei Dorians Außenposten zurück.‡여왕 슬리비나를 처치하고 도리안의 전초기지에 있는 도리안 드레이크스토커에게 돌아가야 합니다.‡Mata a la madre de linaje Slivina y vuelve junto a Dorian Asoladracos en la Avanzada de Dorian.‡Mata a la madre de linaje Slivina y vuelve junto a Dorian Asoladracos en la Avanzada de Dorian.‡Tuez la Mère des couvées Slivina et retournez voir Dorian Traquedrake, à l\'Avant-poste de Dorian.‡杀死母龙斯利维娜，然后向多里安哨站的多里安·达克斯托克复命。‡殺死育母斯莉薇娜，然後向多里安前哨的多里安·龍巡者回報。',
  }
},
[12615] = {
  {
    'A bênção de Zim\'Torga‡Благословение Зим\'Торги‡Der Segen von Zim\'Torga‡짐토르가의 가호‡La bendición de Zim\'Torga‡La bendición de Zim\'Torga‡La bénédiction de Zim\'Torga‡希姆托加的祝福‡辛托加之祝福',
    nil,
    'O Mandingueiro Khufu, na Fortaleza Argêntea, quer que você leve 10 Oferendas Drakkari à estátua de Zim\'Torga.‡По поручению знахаря Кхуфу принесите 10 подношений Драккари к изваянию Зим\'Торги.‡Hexendoktor Khufu möchte, dass Ihr der Statue von Zim\'Torga 10 Drakkariopfergaben darbringt.‡의술사 쿠푸가 짐토르가 조각상에 드라카리 공물 10개를 바쳐 달라고 부탁했습니다.‡El médico brujo Khufu quiere que presentes 10 ofrendas Drakkari a la estatua de Zim\'Torga.‡El médico brujo Khufu quiere que presentes 10 ofrendas Drakkari a la estatua de Zim\'Torga.‡Le Féticheur Khufu vous a demandé de présenter 10 Offrandes drakkari à la statue de Zim\'Torga.‡巫医库弗要求你在希姆托加的雕像前奉上10份达卡莱供品。‡巫醫庫弗要你在辛托加的雕像前獻上10份德拉克瑞祭品。',
  }
},
[12616] = {
  {
    'Tenris e a câmara secreta‡Тайная комната‡Kammer der Geheimnisse‡비밀의 방‡La Cámara de los Secretos‡La Cámara de los Secretos‡La chambre des secrets‡卡拉赞的密室‡滿載秘密的房間',
    nil,
    'O Emissário da Aurora Argêntea quer que você investigue a câmara do Príncipe Tenris Sanguebreu no Alojamento dos Empregados de Karazhan.‡Посланник Серебряного Рассвета просит вас обыскать комнату Тенриса Мутная Кровь, которая находится в квартале слуг Каражана.‡Der Abgesandte der Argentumdämmerung möchte, dass Ihr Tenris Mirkbluts Kammer in den Bedienstetenunterkünften in Karazhan durchsucht.‡은빛 여명회 사절이 카라잔의 하인 숙소에 있는 텐리스 머크블러드의 방을 조사해 달라고 부탁했습니다.‡El emisario de El Alba Argenta quiere que encuentres la habitación de Tenris Sangre Penumbra dentro de los aposentos de los sirvientes en Karazhan.‡El emisario de El Alba Argenta quiere que encuentres la habitación de Tenris Sangre Penumbra dentro de los aposentos de los sirvientes en Karazhan.‡L\'Émissaire de l\'Aube d\'argent vous a demandé de fouiller la chambre de Tenris Bourbassang, dans le Quartier des domestiques de Karazhan.‡银色特使要你进入卡拉赞的仆役宿舍，在特里斯·黯血王子的房间中寻找线索。‡銀色黎明大使要你到卡拉贊的佣人區去，搜索坦瑞斯·暗血的房間。',
  }
},
[12617] = {
  {
    'Exterminando os invasores‡Уничтожение захватчиков‡Die Eindringlinge vernichten‡침입자 처단‡Exterminar a los intrusos‡Exterminar a los intrusos‡Exterminer les intrus‡消灭入侵者‡滅絕入侵者',
    nil,
    'O Avatar de Freya, nas Cachoeiras de Voz-da-chuva, quer que você vá ao Posto Avançado Mão da Morte, a noroeste, e mate 8 Sectários Infiltradores.‡Аватара Фрейи, стоящая у водопадов Гласа Дождя, попросила вас отправиться в лагерь Руки Смерти на северо-западе и убить 8 секретных агентов сектантов.‡Der Avatar von Freya am Katarakt der Regenrufer möchte, dass Ihr Euch zum Lager der Todeshand im Nordwesten begebt und 8 infiltrierende Kultisten tötet.‡구름몰이 여울목에 있는 프레이야의 화신이 북서쪽에 있는 죽음의 손 야영지로 가서 이교도 첩보원 8명을 처치해 달라고 부탁했습니다.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que vayas al Campamento Mano de la Muerte al noroeste y que mates a 8 cultores infiltrados.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que vayas al Campamento Mano de la Muerte al noroeste y que mates a 8 cultores infiltrados.‡L\'Avatar de Freya aux Rapides Parlepluie veut que vous alliez au Campement de la Main de Mort, au nord-ouest, et que vous tuiez 8 Sectateurs infiltrés.‡雨声河的弗蕾亚的化身要求你前往西北方的死亡之手营地，消灭8名诅咒教派入侵者。‡雨頌者急湍的芙蕾雅化身要你前往西北邊的死亡之手駐營，並殺死8個教徒滲透者。',
  }
},
[12618] = {
  {
    'Bênção de Zim\'Torga‡Благословение Зим\'Торги‡Der Segen von Zim\'Torga‡짐토르가의 가호‡La bendición de Zim\'Torga‡La bendición de Zim\'Torga‡Bénédiction de Zim\'Torga‡希姆托加的祝福‡辛托加的祝福',
    nil,
    nil,
  }
},
[12619] = {
  {
    'A lâmina rúnica brasonada‡Украшенный рунический меч‡Die verzierte Runenklinge‡장식된 룬검‡La hojarruna blasonada‡La hojarruna blasonada‡La lame runique blasonnée‡符文之剑‡紋飾符文刃',
    nil,
    'Vasculhe cavaletes de armas na Fortaleza de Ébano para encontrar uma Espada Gasta pela Batalha. Em seguida, use-a em uma forja rúnica para moldar uma Espada de Lâmina Rúnica.|n|nLeve a Espada de Lâmina Rúnica ao instrutor Razúvio na Fortaleza de Ébano.‡Обыщите оружейные стойки в Черном оплоте, найдите затупившийся в боях меч и перекуйте его в рунический меч в рунной кузне.|n|nПринесите готовый клинок инструктору Разувию в Черный оплот.‡Geht zu den Waffenregalen in der Schwarzen Festung und sucht nach einem kampferprobten Schwert. Verwandelt es anschließend in einer Runenschmiede zu einem Runenklingenschwert.|n|nBringt das Runenklingenschwert danach zu Instrukteur Razuvious in der Schwarzen Festung.‡칠흑의 요새에 있는 무기 선반에서 전투로 닳은 검을 찾아 룬가열로에서 룬검으로 만들어야 합니다.|n|n룬검을 칠흑의 요새에 있는 훈련교관 라주비어스에게 가져가십시오.‡Encuentra una espada desgastada por la batalla en los expositores de armas de El Bastión de Ébano y úsala en una forja de runas para crear una espada de hojarruna.|n|nDevuelve la espada de hojarruna al instructor Razuvious en El Bastión de Ébano.‡Encuentra una espada desgastada por la batalla en los expositores de armas de El Bastión de Ébano y úsala en una forja de runas para crear una espada de hojarruna.|n|nDevuelve la espada de hojarruna al instructor Razuvious en El Bastión de Ébano.‡Cherchez une Épée détériorée sur les râteliers d\'armes du Fort d\'Ébène et utilisez-la sur une Forgerune pour créer une Épée à lame runique.|n|nRemettez l\'Épée à lame runique à l\'Instructeur Razuvious au Fort d\'Ébène.‡在黑锋要塞内的武器架上找一把破旧的长剑，并以它为基础，在符文熔炉内锻造出一把符文之剑。|n|n带着你的符文之剑去向黑锋要塞的教官拉苏维奥斯报告。‡搜索黯黑堡的武器架，找出一把戰損之劍，然後在符文熔爐使用它來鍛造一把符文刃劍。|n|n將符文刃劍交給黯黑堡的講師拉祖維斯。',
  }
},
[12620] = {
  {
    'A fúria da guardiã da vida‡Гнев Хранительницы Жизни‡Der Zorn der Lebenswächterin‡분노한 생명 감시자‡La cólera de la guardiana de vida‡La cólera de la guardiana de vida‡Le courroux de la Gardienne de la vie.‡生命守卫者之怒‡生命守護者之怒',
    nil,
    'O Avatar de Freya, nas Cachoeiras de Voz-da-chuva, quer que você use a Trompa de Freya no topo do Pilar Rutilante.‡Аватара Фрейи у водопадов Гласа Дождя хочет, чтобы вы протрубили в Рог Фрейи на вершине Мерцающей колонны.‡Der Avatar von Freya im Katarakt der Regenrufer möchte, dass Ihr auf dem Gipfel der Schimmersäule Freyas Horn blast.‡구름몰이 여울목에 있는 프레이야의 화신이 미명의 봉우리 위에서 프레이야의 뿔피리를 사용해 달라고 부탁했습니다.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que utilices el cuerno de Freya en lo alto de El Pilar Iluminado.‡El avatar de Freya en los Rápidos de Hablalluvia quiere que utilices el cuerno de Freya en lo alto de El Pilar Iluminado.‡L\'Avatar de Freya, aux Rapides Parlepluie, veut que vous utilisiez le Cor de Freya au sommet du Pilier Scintillant.‡雨声河的弗蕾亚的化身要求你登上光芒之柱的顶端，吹响弗蕾亚的号角。‡雨頌者急湍的芙蕾雅化身要你在微光之柱的頂端使用芙蕾雅的號角。',
  }
},
[12621] = {
  {
    'O pacto de Freya‡Договор Фрейи‡Freyas Pakt‡프레이야와 약속하기‡El pacto de Freya‡El pacto de Freya‡Le pacte de Freya‡弗蕾亚的契约‡芙蕾雅的契約',
    nil,
    'Escute o que o Avatar de Freya tem a dizer.‡Выслушайте то, что вам расскажет Аватара Фрейи.‡Hört zu, was der Avatar von Freya zu sagen hat.‡프레이야의 화신이 하는 말을 들어야 합니다.‡Escucha lo que tiene que decir el avatar de Freya.‡Escucha lo que tiene que decir el avatar de Freya.‡Écoutez ce que l\'Avatar de Freya veut vous dire.‡聆听弗蕾亚的化身的话语。‡聽芙蕾雅的化身要說什麼。',
  }
},
[12622] = {
  {
    'Líderes de Jin\'Alai‡Вожди у Джин\'Алаи‡Die Anführer in Jin\'Alai‡진알라이의 지도자들‡Los líderes de Jin\'Alai‡Los líderes de Jin\'Alai‡Les chefs de Jin\'Alai‡金亚莱的领袖‡金阿萊的領袖',
    nil,
    'O Escalpelador Ahunae, em Zim\'torga, pediu para você recuperar o Tesouro de Kutube\'sa, o Tesouro de Gawanil e o Tesouro de Chalo, o Louco.‡По поручению охотника за скальпами Ауне из Зим\'торги заберите сокровища у Кутубе\'сы, Гаванила и Чуло Безумного.‡Skalpierer Ahunae in Zim\'Torga möchte, dass Ihr den Schatz von Kutube\'sa, den Schatz von Gawanil und den Schatz von Chulo dem Verrückten beschafft.‡짐토르가의 무두장이 아훈네가 쿠투베사의 보물, 가와닐의 보물, 미치광이 춘로의 보물을 가져와 달라고 부탁했습니다.‡El arrancacabelleras Ahunae, de Zim\'Torga, te ha pedido que recuperes el tesoro de Kutube\'sa, el tesoro de Gawanil y el tesoro de Chulo el Loco.‡El arrancacabelleras Ahunae, de Zim\'Torga, te ha pedido que recuperes el tesoro de Kutube\'sa, el tesoro de Gawanil y el tesoro de Chulo el Loco.‡Le Scalpeur Ahunae à Zim\'Torga vous a demandé de récupérer les Trésors de Kutube\'sa, de Gawanil et de Chulo le Fol.‡希姆托加的剥皮师埃霍奈要求你收集库图比萨的宝藏、疯子克乌罗的宝藏和加瓦尼尔的宝藏。‡辛托加的割顱者艾胡奈要你拿到庫吐貝沙的寶藏，加瓦尼爾的寶藏以及『瘋子』丘洛的寶藏。',
  }
},
[12623] = {
  {
    'Para o Mandingueiro‡К знахарю‡Auf zum Hexendoktor‡의술사와의 만남‡A ver al médico brujo‡A ver al médico brujo‡Rendez-vous chez le féticheur‡巫医库弗‡去找巫醫',
    nil,
    'Fale com o Mandingueiro Khufu em Zim\'Torga.‡Поговорите со знахарем Кхуфу в Зим\'Торге.‡Sprecht mit Hexendoktor Khufu in Zim\'Torga.‡짐토르가에 있는 의술사 쿠푸와 대화해야 합니다.‡Habla con el médico brujo Khufu en Zim\'Torga.‡Habla con el médico brujo Khufu en Zim\'Torga.‡Allez parler au Féticheur Khufu à Zim\'Torga.‡与希姆托加的巫医库弗谈一谈。‡到辛托加與巫醫庫弗談談。',
  }
},
[12624] = {
  {
    'Pode estar em qualquer lugar!‡Оно может быть где угодно!‡Er könnte überall sein!‡어딘가엔 있을 거야!‡¡Podría estar en cualquier lugar!‡¡Podría estar en cualquier lugar!‡Il pourrait être n\'importe où !‡不知所踪！‡它可能在任何地方!',
    nil,
    'Procure um Anel de Noivado Dourado nas várias criaturas da Bacia Sholazar.‡Ищите золотое обручальное кольцо у всех обитателей Низины Шолазар.‡Sucht nach einem goldenen Verlobungsring, den Ihr in den Mägen der verschiedenen Kreaturen im Sholazarbecken finden könnt.‡숄라자르 분지에 서식하는 다양한 생물들로부터 황금 약혼 반지를 찾아내야 합니다.‡Busca el anillo de compromiso dorado en las diversas criaturas de la Cuenca de Sholazar.‡Busca el anillo de compromiso dorado en las diversas criaturas de la Cuenca de Sholazar.‡Recherchez l\'Anneau de fiançailles en or sur les différentes créatures du Bassin de Sholazar.‡在索拉查盆地的生物身上寻找金色订婚戒指。‡從休拉薩盆地的各種生物身上尋找黃金訂婚戒。',
  }
},
[12625] = {
  {
    'Dominion Over Acherus‡Власть над Акерусом‡Herrschaft über Acherus‡아케루스 장악‡Dominio de Acherus‡Dominio de Acherus‡Dominer Achérus‡支配阿彻鲁斯‡支配亞榭洛',
    nil,
    'Report to Master Siegesmith Corvus on the garrison floor of Ebon Hold.‡Найдите главного кузнеца крепости Корвия на войсковом этаже Черного оплота.‡Meldet Euch bei Meisterbelagerungsschmied Corvus auf der Etage der Garnison in der Schwarzen Festung.‡칠흑의 요새 주둔지 층에 있는 대공성대장장이 코르부스에게 보고해야 합니다.‡Preséntate ante el maestro herrero de asedio Corvus en el piso del cuartel de El Bastión de Ébano.‡Preséntate ante el maestro herrero de asedio Corvus en el piso del cuartel de El Bastión de Ébano.‡Présentez-vous au Maître poliorcète Corvus à l\'Étage de la garnison du Fort d\'Ébène.‡向黑锋要塞守备层的攻城锻造大师科弗斯报到。‡向黯黑堡駐防層的攻城鐵匠大師寇孚斯回報。',
  }
},
[12627] = {
  {
    'Abrindo caminho em Jin\'Alai‡Прорыв в Джин\'Алаи‡Nach Jin\'Alai durchkommen‡진알라이 돌파‡Abrirse paso entre los Jin\'Alai‡Abrirse paso entre los Jin\'Alai‡Interférences à Jin\'Alai‡横扫金亚莱‡突破金阿萊',
    nil,
    'O Mandingueiro Khufu, em Zim\'Torga, pediu para você perturbar o Caldeirão Azul, o Caldeirão Verde, o Caldeirão Roxo e o Caldeirão Vermelho.‡По поручению знахаря Кхуфу из Зим\'Торги опрокиньте Синий котел, Зеленый котел, Фиолетовый котел и Красный котел.‡Hexendoktor Khufu in Zim\'Torga möchte, dass Ihr den blauen, grünen, purpurnen und roten Kessel sabotiert.‡짐토르가에 있는 의술사 쿠푸가 파란색 가마솥, 녹색 가마솥, 보라색 가마솥, 빨간색 가마솥을 휘저어 의식을 방해해 달라고 부탁했습니다.‡El médico brujo Khufu, de Zim\'Torga, te ha pedido que estropees la caldera azul, la caldera verde, la caldera púrpura y la caldera roja.‡El médico brujo Khufu, de Zim\'Torga, te ha pedido que estropees la caldera azul, la caldera verde, la caldera púrpura y la caldera roja.‡Le Féticheur Khufu à Zim\'Torga vous a demandé de perturber le Chaudron bleu, le Chaudron vert, le Chaudron violet et le Chaudron rouge.‡希姆托加的巫医库弗要求你破坏蓝色大锅、绿色大锅、紫色大锅和红色大锅。‡辛托加的巫醫庫弗要你擾亂藍色大鍋，綠色大鍋，紫色大鍋和紅色大鍋。',
  }
},
[12628] = {
  {
    'Falar com Har\'koa‡Разговор с Хар\'коа‡Mit Har\'koa sprechen‡하르코아와 대화하기‡A hablar con Har\'koa‡A hablar con Har\'koa‡Une discussion avec Har\'koa‡与哈克娅交谈‡與哈寇亞談話',
    nil,
    'Fale com Har\'koa no Altar de Har\'koa.‡Поговорите с Хар\'коа у алтаря Хар\'коа.‡Sprecht mit Har\'koa am Altar von Har\'koa.‡하르코아의 제단에서 하르코아와 대화해야 합니다.‡Habla con Har\'koa en el Altar de Har\'koa.‡Habla con Har\'koa en el Altar de Har\'koa.‡Parlez à Har\'koa à l\'Autel de Har\'koa.‡与哈克娅祭坛的哈克娅谈一谈。‡到哈寇亞祭壇與哈寇亞談話。',
  }
},
[12629] = {
  {
    'Você pode correr, mas não pode se esconder‡Можно убежать, но нельзя скрыться‡Es gibt kein Entkommen‡도망갈 수는 있지만 숨을 수는 없다‡Puedes correr pero no esconderte‡Puedes correr pero no esconderte‡Oh, vous pouvez courir…‡无处可藏‡你可以逃，但你躲不了',
    nil,
    'Stefan, no Posto Ébano, quer que você vá ao Relicário da Agonia coletar 5 Tripas de Abominação Pútridas e 5 Babas Babosas de Carniçal.‡По указанию Стефана с Черной заставы отправляйтесь за Реликварий Агонии и соберите 5 клубков прогнивших внутренностей поганища с тлетворных поганищ и 5 сгустков вязкой слюны вурдалака.‡Stefan in der Schwarzen Wacht möchte, dass Ihr zur Reliquie der Pein geht und dort 5 eitrige Monstrositäteninnereien von den eitrigen Monstrositäten und 5 Einheiten glibbrigen Ghulsabbers sammelt.‡칠흑의 감시초소에 있는 스테판이 고뇌의 성물함으로 가서 부패한 누더기골렘들로부터 부패한 누더기골렘 창자 5개와 끈끈한 구울 타액 5개를 가져와 달라고 부탁했습니다.‡Stefan del Puesto de Vigilancia de Ébano te ha pedido que vayas al Relicario de Agonía y consigas 5 tripas de abominación pútrida y 5 babas de necrófago pegajosas.‡Stefan del Puesto de Vigilancia de Ébano te ha pedido que vayas al Relicario de Agonía y consigas 5 tripas de abominación pútrida y 5 babas de necrófago pegajosas.‡Stefan au Guet d\'Ébène vous a demandé d\'aller au Reliquaire d\'agonie et de récupérer 5 Entrailles d\'abominations putrescentes sur des Abominations putrescentes et 5 Baves de goule collantes.‡黑锋哨站的斯特凡要你到折磨之匣下面去，从腐烂憎恶身上收集5份腐烂憎恶之物，并收集5份黏稠的食尸鬼口水。‡黯黑守望的史戴芬要你前往苦楚聖匣，從惡臭的憎惡體身上收集5個惡臭的憎惡體內臟，以及收集5份黏稠的食屍鬼唾液。',
  }
},
[12630] = {
  {
    'Chutando Nabunda‡Насса надо как следует пнуть‡Narsch treten und Haare krümmen‡나스를 걷어차고 머리카락을 걷어내라‡Patadas a Nass para muestras‡Patadas a Nass para muestras‡L\'engeance tous risques‡纳斯和巨魔的毛发‡踢納斯、拿毛髮',
    nil,
    'Stefan, no Posto Ébano, quer que você use o Nabunda para coletar 10 amostras de cabelo dos Trolls Definhados.|n|nSe você perder Nabunda de vista, fale novamente com Stefan para encontrá-lo.‡С помощью Насса соберите образцы волос 10 иссохших троллей для Стефана с Черной заставы.|n|nЕсли вы потеряете Насса, возвращайтесь к Стефану.‡Stefan in der Schwarzen Wacht möchte, dass Ihr mithilfe von Narsch 10 Haarproben von den siechenden Trollen sammelt.|n|nKehrt zu Stefan zurück, falls Ihr Narsch verlieren solltet, damit er ihn für Euch zurückbekommt.‡칠흑의 감시초소에 있는 스테판이 나스를 이용하여 부패한 트롤의 머리카락 견본 10개를 가져다 달라고 부탁했습니다.|n|n나스를 잃어버리면 스테판에게 돌아가 다시 데려와야 합니다.‡Stefan en el Puesto de Vigilancia de Ébano quiere que uses a Nass para recoger 10 muestras de pelo de trols marchitos.|n|nSi pierdes a Nass, vuelve con Stefan para recuperarlo.‡Stefan en el Puesto de Vigilancia de Ébano quiere que uses a Nass para recoger 10 muestras de pelo de trols marchitos.|n|nSi pierdes a Nass, vuelve con Stefan para recuperarlo.‡Stefan, du Guet d\'Ébène, vous a demandé d\'utiliser Nass pour recueillir 10 Échantillons de cheveux de Trolls flétris.|n|nSi vous perdez Nass, retournez voir Stefan pour le récupérer.‡黑锋哨站的斯特凡要求你使用纳斯从干瘪的巨魔身上收集10份毛发样本。|n|n如果你把纳斯弄丢了，就回到斯特凡那里去找他。‡黯黑守望的史戴芬要你用納斯從乾癟的食人妖身上收集10份毛髮樣本。|n|n如果你失去了納斯，就回去找史戴芬。',
  }
},
[12631] = {
  {
    'Uma espécie de convite...‡Приглашение‡Eine Art Einladung...‡불길한 초대‡Una especie de invitación…‡Una especie de invitación…‡Une invitation, en quelque sorte…‡某种邀请……‡某種邀請…',
    nil,
    'Leve a Gargantilha do Vivo-morto a Stefan no Posto Ébano.‡Отнесите колье нежизни Стефану на Черную заставу.‡Bringt den untoten Halsreif zu Stefan in der Schwarzen Wacht.‡청산의 목걸이를 칠흑의 감시초소에 있는 스테판에게 가져가야 합니다.‡Lleva la gargantilla sin vida a Stefan en el Puesto de Vigilancia de Ébano.‡Lleva la gargantilla sin vida a Stefan en el Puesto de Vigilancia de Ébano.‡Apportez le Sautoir non-vivant à Stefan au Guet d\'Ébène.‡将尸灵项圈交给黑锋哨站的斯特凡。‡把無息頸飾交給黯黑守望的史戴芬。',
  }
},
[12632] = {
  {
    'Meus filhos acima de tudo‡Первым делом – мои дети‡Aber zunächst meine Jungen‡하르코아의 자손‡No sin mis crías‡No sin mis crías‡Ma progéniture d\'abord‡我的后裔‡但首先是我的後裔',
    nil,
    'Har\'koa pediu que você use o bigode nos cadáveres dos filhos dela para libertá-los e ressuscitá-los. Fale com ela novamente no Altar de Har\'koa quando terminar.‡Используйте удивительные свойства уса Хар\'коа для того, чтобы освободить и воскресить ее детей. Когда все будет сделано, вернитесь к Хар\'коа. Она ждет вас у алтаря.‡Har\'koa hat Euch gebeten, ihre Barthaare mit den Leichnamen ihrer Kinder zu benutzen und sie wiederzubeleben. Kehrt zu ihr am Altar von Har\'koa zurück, sobald Ihr fertig seid.‡하르코아의 자손 7마리를 쓰러트린 후 하르코아의 수염을 사용해 그들을 해방하고 부활시킨 다음, 하르코아의 제단에 있는 하르코아에게 돌아가야 합니다.‡Har\'koa te ha pedido que uses su bigote en los cadáveres de sus hijos para liberarlos y resucitarlos. Vuelve a verla al Altar de Har\'koa cuando hayas acabado.‡Har\'koa te ha pedido que uses su bigote en los cadáveres de sus hijos para liberarlos y resucitarlos. Vuelve a verla al Altar de Har\'koa cuando hayas acabado.‡Har\'koa vous a demandé d\'utiliser un poil de sa moustache sur les corps de ses enfants pour les libérer et les ramener à la vie. Retournez la voir à l\'Autel de Har\'koa une fois que ce sera fait.‡哈克娅要求你对她的孩子们的尸体使用她的胡须，解放并复活它们。完成任务之后回到哈克娅祭坛去向她复命。‡哈寇亞要你在她子嗣的屍體上使用她的鬍鬚來釋放他們，並且將他們復活。當你完成之後回到哈寇亞祭壇找她。',
  }
},
[12633] = {
  {
    'O chamado das trevas‡Зов тьмы‡Die Finsternis ruft‡어둠의 부름‡La llamada de la oscuridad‡La llamada de la oscuridad‡L\'appel des ténèbres‡黑暗的召唤‡黑暗呼喚',
    nil,
    'Leve a Gargantilha Repelente a Stefan no Posto Ébano.‡Отнесите змеевидное колье Стефану на Черную заставу.‡Bringt Stefan in der Schwarzen Wacht den zuckenden Halsreif.‡고통의 목걸이를 칠흑의 감시초소에 있는 스테판에게 가져가야 합니다.‡Lleva la gargantilla aviesa a Stefan del Puesto de Vigilancia de Ébano.‡Lleva la gargantilla aviesa a Stefan del Puesto de Vigilancia de Ébano.‡Apportez le Sautoir putride à Stefan au Guet d\'Ébène.‡将扭曲项圈交给黑锋哨站的斯特凡。‡把苦痛糾結頸飾交給黯黑守望的史戴芬。',
  }
},
[12634] = {
  {
    'Alguns fazem limonada, outros fazem caipirinha‡Кому ликер, кому лимонад‡Die einen machen Limonade draus, die anderen Schnaps‡누군가의 음료수, 누군가의 술‡Algunos hacen limonada y otros hacen licores‡Algunos hacen limonada y otros hacen licores‡Certains font de la limonade, d\'autres de la liqueur‡酿酒的材料‡有些人會打成檸檬汁，有些人會釀成酒',
    nil,
    'Traga 1 Laranja, 2 Cachos de Bananas e 1 Mamão para Canabraba Cervaforte, no Acampamento do Rosarães.‡Принесите Мрачнобуху Громовару в лагерь Эрнестуэя 1 апельсин, 2 грозди бананов и 1 папайю.‡Bringt 1 Orange, 2 Bananenbündel und 1 Papaya zu Schnapsbart Donnerbräu in Nesingwarys Basislager.‡오렌지 1개, 바나나 송이 2개, 파파야 1개를 네싱워리 주둔지에 있는 그림부즈 썬더브루에게 가져가야 합니다.‡Lleva 1 naranja, 2 racimos de plátanos y 1 papaya a Tragoamargo Cebatruenos, al Campamento Base de Nesingwary.‡Lleva 1 naranja, 2 racimos de plátanos y 1 papaya a Tragoamargo Cebatruenos, al Campamento Base de Nesingwary.‡Rapportez 1 Orange, 2 Régimes de bananes et 1 Papaye à Tristevin Tonnebière au Camp de base de Nesingwary.‡将1颗橙子、2串香蕉和1颗木瓜交给奈辛瓦里营地的葛瑞姆·雷酒。‡把1個柳橙，2串香蕉，還有1個木瓜拿給奈辛瓦里營地的葛林布茲·雷酒。',
  }
},
[12635] = {
  {
    'Relíquias da Deusa dos Leopardos da Neve‡Реликвии богини‡Relikte der Schneeleopardengöttin‡눈표범 여신의 유물‡Reliquias de la diosa leopardo de la nieve‡Reliquias de la diosa leopardo de las nieves‡Les reliques de la déesse léopard des neiges‡雪豹之神的圣物‡雪豹女神的聖物',
    nil,
    'O Cronista To\'kini, em Zim\'Torga, quer que você recupere 10 Relíquias Har\'koanas.‡По поручению То\'кини из Зим\'Торги соберите 10 хар\'коанских реликвий.‡Chronist To\'kini in Zim\'Torga möchte, dass Ihr 10 Har\'koarelikte beschafft.‡짐토르가에 있는 기록가 토키니가 하르코아 유물 10개를 가져와 달라고 부탁했습니다.‡El cronista To\'kini de Zim\'Torga quiere que recuperes 10 reliquias de Har\'koan.‡El cronista To\'kini de Zim\'Torga quiere que recuperes 10 reliquias de Har\'koan.‡Le Chroniqueur To\'kini à Zim\'Torga vous demande de récupérer 10 Reliques har\'koanes.‡希姆托加的记载者图基尼要求你收集10件哈克娅圣物。‡辛托加的撰史者托基尼要你回收10個哈寇亞聖物。',
  }
},
[12636] = {
  {
    'O olho de Áquerus‡Око Акеруса‡Das Auge von Acherus‡아케루스의 눈‡El ojo de Acherus‡El ojo de Acherus‡L\'œil d\'Achérus‡阿彻鲁斯之眼‡亞榭洛之眼',
    nil,
    'Apresente-se ao Lich Rei na Fortaleza de Ébano.‡Предстаньте перед Королем-личом в Черном оплоте.‡Meldet Euch beim Lichkönig in der Schwarzen Festung.‡칠흑의 요새에 있는 리치 왕에게 보고해야 합니다.‡Preséntate ante el Rey Exánime en El Bastión de Ébano.‡Preséntate ante el Rey Exánime en El Bastión de Ébano.‡Présentez-vous au Roi-liche dans le Fort d\'Ébène.‡向黑锋要塞的巫妖王报到。‡向黯黑堡的巫妖王報到。',
  }
},
[12637] = {
  {
    'Por um triz‡Счастливое избавление‡Um ein Haar‡다가오는 운명‡Casi un fracaso‡Casi un fracaso‡Manqué de justesse‡幸免于难‡擦身而過',
    nil,
    'Stefan, no Posto Ébano, quer que você mostre a Gargantilha do Vivo-morto a Datura Sanguerrosa.‡Отдайте колье нежизни Датуре Кровавой Розе.‡Stefan in der Schwarzen Wacht möchte, dass Ihr den untoten Halsreif zu Datura Blutrose bringt.‡칠흑의 감시초소에 있는 스테판이 청산의 목걸이를 핏빛장미 다투라에게 전달해 달라고 부탁했습니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que le lleves la gargantilla sin vida a Rosangre Datura.‡Stefan del Puesto de Vigilancia de Ébano quiere que le lleves la gargantilla sin vida a Rosangre Datura.‡Stefan au Guet d\'Ébène vous demande d\'apporter le Sautoir non-vivant à Datura Rose-sang.‡黑锋哨站的斯特凡要你将尸灵项圈交给血玫瑰达图拉。‡黯黑守望的史戴芬要你把無息頸飾交給血玫·達圖拉。',
  }
},
[12638] = {
  {
    'Decisão difícil‡На волосок от смерти‡Eine knappe Sache‡가까워진 부름‡Llamada cercana‡Llamada cercana‡Pas passé loin‡侥幸逃脱‡迫近的呼喚',
    nil,
    'Stefan, no Posto Ébano, quer que você mostre a Gargantilha Repelente a Datura Sanguerrosa.‡По предложению Стефана с Черной заставы отнесите змеевидное колье Датуре Кровавой Розе.‡Stefan in der Schwarzen Wacht möchte, dass Ihr den zuckenden Halsreif zu Datura Blutrose bringt.‡칠흑의 감시초소에 있는 스테판이 고통의 목걸이를 핏빛장미 다투라에게 전달해 달라고 부탁했습니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que le lleves la gargantilla aviesa a Rosangre Datura.‡Stefan del Puesto de Vigilancia de Ébano quiere que le lleves la gargantilla aviesa a Rosangre Datura.‡Stefan au Guet d\'Ébène vous demande d\'apporter le Sautoir putride à Datura Rose-sang.‡黑锋哨站的斯特凡要你将扭曲项圈交给血玫瑰达图拉。‡黯黑守望的史戴芬要你把苦痛糾結頸飾交給血玫·達圖拉。',
  }
},
[12639] = {
  {
    'Terra Congelada‡Застывшая земля‡Die gefrorene Erde‡얼어붙은 대지정령‡La tierra congelada‡La tierra congelada‡Les terres gelées‡冻土精华‡冰凍土元素',
    nil,
    'A Domadora de Elementos Dagoda, em Zim\'Torga, quer que você colete 7 Essências da Terra Congelada.‡Принесите укротителю стихий Дагоде в Зим\'Торге 7 порций субстанции ледяной земли.‡Elementzähmerin Dagoda in Zim\'Torga möchte, dass Ihr 7 Essenzen der gefrorenen Erde beschafft.‡짐토르가에 있는 정령조련사 다고다가 얼어붙은 대지정령의 정수 7개를 가져와 달라고 부탁했습니다.‡La domadora de elementos Dagoda de Zim\'Torga quiere que recolectes 7 esencias de la tierra congelada.‡La domadora de elementos Dagoda de Zim\'Torga quiere que recolectes 7 esencias de la tierra congelada.‡La Dompteuse des éléments Dagoda à Zim\'Torga veut que vous collectiez 7 Essences de terre gelée.‡希姆托加的元素驯服者德苟达要求你收集7块冻土精华。‡辛托加的元素馴伏者達茍答要你收集7個冰凍土元素精華。',
  }
},
[12640] = {
  {
    'Selando as fendas‡Закрытие порталов‡Die Risse versiegeln‡균열 봉인‡Sellar fallas‡Sellar fallas‡Sceller les failles‡封印裂隙‡封閉裂隙',
    nil,
    'O Escalpelador Ahunae, em Zim\'Torga, quer que você sele 7 Fendas Elementais.‡По поручению охотника за скальпами Ауне из Зим\'торги закройте 7 порталов элементалей.‡Skalpierer Ahunae in Zim\'Torga möchte, dass Ihr 7 Elementarrisse verschließt.‡짐토르가에 있는 무두장이 아훈네가 정기의 균열 7개를 봉인해 달라고 부탁했습니다.‡El arrancacabelleras Ahunae de Zim\'Torga te ha pedido que selles 7 fallas elementales.‡El arrancacabelleras Ahunae de Zim\'Torga te ha pedido que selles 7 fallas elementales.‡Le Scalpeur Ahunae à Zim\'Torga vous a demandé de sceller 7 Failles élémentaires.‡希姆托加的剥皮师埃霍奈要求你封印7处元素裂隙。‡辛托加的割顱者艾胡奈要你封閉7個元素裂隙。',
  }
},
[12641] = {
  {
    'A morte vem do alto‡Смерть подбирается с высоты‡Tod kommt von ganz oben‡하늘로부터의 죽음‡La muerte viene de arriba‡La muerte viene de arriba‡La mort vient de l\'œil‡天降厄运‡死亡從天而降',
    nil,
    'O Lich Rei ordena que você use o Olho de Áquerus para analisar o Castelo Escarlate, a Forja de Nova Avalon, a Prefeitura de Nova Avalon e a Capela da Chama Carmesim.|n|nControle o Olho de Áquerus usando o Mecanismo de Controle do Olho de Áquerus.‡Король-лич приказал вам заглянуть в Око Акеруса, чтобы осмотреть Крепость Алого ордена, Кузню Нового Авалона, Ратушу Нового Авалона и Часовню Багрового Пламени.|n|nДля этого воспользуйтесь механизмом управления Оком Акеруса.‡Der Lichkönig befiehlt Euch, mithilfe des Auges von Acherus die Scharlachrote Festung, die Schmiede von Neu-Avalon, das Rathaus von Neu-Avalon und die Kapelle der Scharlachroten Flamme zu analysieren.|n|nDas Auge von Acherus lässt sich mithilfe der Steuerung für das Auge von Acherus kontrollieren.‡리치 왕이 아케루스의 눈을 사용해 붉은십자군 요새, 신 아발론 대장간, 신 아발론 마을회관 및 진홍불꽃의 예배당을 조사하라고 명령했습니다.|n|n아케루스의 눈 제어 장치를 사용하여 아케루스의 눈을 조종해야 합니다.‡El Rey Exánime te ordena que uses el ojo de Acherus para analizar el Bastión Escarlata, la Forja de Nuevo Avalon, el Concejo de Nuevo Avalon y la Capilla de la Llama Carmesí.|n|nControla el ojo de Acherus usando el mecanismo de control del ojo de Acherus.‡El Rey Exánime te ordena que uses el ojo de Acherus para analizar el Bastión Escarlata, la Forja de Nuevo Avalon, el Concejo de Nuevo Avalon y la Capilla de la Llama Carmesí.|n|nControla el ojo de Acherus usando el mecanismo de control del ojo de Acherus.‡Le Roi-liche vous ordonne d\'utiliser l\'Œil d\'Achérus pour analyser le Fort écarlate, la Forge de la Nouvelle-Avalon, l\'Hôtel de ville de la Nouvelle-Avalon et la Chapelle de la Flamme cramoisie.|n|nContrôlez l\'Œil d\'Achérus en utilisant le mécanisme de contrôle de l\'Œil d\'Achérus.‡巫妖王命令你使用阿彻鲁斯之眼，侦察并分析血色城堡、新阿瓦隆熔炉、新阿瓦隆市政厅和赤色烈焰礼拜堂的情况。|n|n使用阿彻鲁斯之眼的控制台来控制阿彻鲁斯之眼。‡巫妖王命令你利用亞榭洛之眼分析血色堡、新亞法隆熔爐、新亞法隆市政廳，以及赤紅之焰禮拜堂。|n|n使用亞榭洛之眼控制裝置來控制亞榭洛之眼。',
  }
},
[12642] = {
  {
    'Espírito de Rhunok‡Дух Рунока‡Der Geist von Rhunok‡루노크의 영혼‡El espíritu de Rhunok‡El espíritu de Rhunok‡L\'esprit de Rhunok‡伦诺克之魂‡魯諾克之靈',
    nil,
    'Fale com o Espírito de Rhunok no Altar de Rhunok.‡Поговорите с духом Рунока у алтаря Рунока.‡Sprecht mit dem Geist von Rhunok am Altar von Rhunok.‡루노크의 제단에 있는 루노크의 영혼과 대화해야 합니다.‡Habla con el espíritu de Rhunok en el Altar de Rhunok.‡Habla con el espíritu de Rhunok en el Altar de Rhunok.‡Parler avec l\'Esprit de Rhunok à l\'Autel de Rhunok.‡与伦诺克祭坛的伦诺克之魂谈一谈。‡在魯諾克祭壇與魯諾克之靈交談。',
  }
},
[12643] = {
  {
    'Esperança‡Серебряная отделка‡Lichtblick‡어둠 속의 빛줄기‡Un resquicio de esperanza‡Un resquicio de esperanza‡Le côté positif‡一线希望‡銀內襯',
    nil,
    'Stefan, no Posto Ébano, quer que você vá ao Relicário da Agonia coletar 5 Tripas de Abominação Pútridas e 5 Babas Babosas de Carniçal.‡По указанию Стефана с Черной заставы отправляйтесь за Реликварий Агонии и соберите 5 клубков прогнивших внутренностей поганища с тлетворных поганищ и 5 сгустков вязкой слюны вурдалака.‡Stefan in der Schwarzen Wacht möchte, dass Ihr zur Reliquie der Pein geht und dort 5 eitrige Monstrositäteninnereien von den eitrigen Monstrositäten und 5 Einheiten glibbrigen Ghulsabbers sammelt.‡칠흑의 감시초소에 있는 스테판이 고뇌의 성물함으로 가서 부패한 누더기골렘들로부터 부패한 누더기골렘 창자 5개와 끈끈한 구울 타액 5개를 가져와 달라고 부탁했습니다.‡Stefan del Puesto de Vigilancia de Ébano te ha pedido que vayas al Relicario de Agonía y consigas 5 tripas de abominación pútrida y 5 babas de necrófago pegajosas.‡Stefan del Puesto de Vigilancia de Ébano te ha pedido que vayas al Relicario de Agonía y consigas 5 tripas de abominación pútrida y 5 babas de necrófago pegajosas.‡Stefan au Guet d\'Ébène vous a demandé d\'aller au Reliquaire d\'agonie pour récupérer 5 Entrailles d\'abominations putrescentes sur les Abominations putrescentes et 5 Baves de goules collantes.‡黑锋哨站的斯特凡要你到折磨之匣下面去，从腐烂憎恶身上收集5份腐烂憎恶之物，并收集5份黏稠的食尸鬼口水。‡黯黑守望的史戴芬要你前往苦楚聖匣，從惡臭的憎惡體身上收集5個惡臭的憎惡體內臟，以及收集5份黏稠的食屍鬼唾液。',
  }
},
[12644] = {
  {
    'Alambicando o balde‡Выпивка – дело тонкое…‡Immer noch dabei‡지금은 증류 작업 중‡Seguimos destilando‡Seguimos destilando‡Une recette alambiquée‡酒香犹存‡靜置',
    nil,
    'Conclua o processo de destilação com êxito e leve o Ponche da Selva do Cervaforte pronto para Canabraba Cervaforte no Acampamento do Rosarães.‡Завершите процесс дистилляции и принесите пунш "Зов джунглей" Мрачнобуха Громовара в лагерь Эрнестуэя.‡Schließt den Destillationsprozess erfolgreich ab und bringt Donnerbräus Dschungelpunsch, wenn er fertig ist, zu Schnapsbart Donnerbräu in Nesingwarys Basislager.‡증류 과정을 마친 다음 썬더브루의 정글 펀치를 네싱워리 주둔지에 있는 그림부즈 썬더브루에게 가져가야 합니다.‡Completa el proceso de destilación con éxito y trae el ponche salvaje de Cebatruenos a Tragoamargo Cebatruenos en el Campamento Base de Nesingwary.‡Completa el proceso de destilación con éxito y trae el ponche salvaje de Cebatruenos a Tragoamargo Cebatruenos en el Campamento Base de Nesingwary.‡Menez le procédé de distillation à son terme et rapportez le Punch de la jungle de Tonnebière à Tristevin Tonnebière, au Camp de base de Nesingwary.‡成功完成蒸馏作业，然后将雷酒的丛林佳酿交给奈辛瓦里营地的葛瑞姆·雷酒。‡成功完成蒸餾流程，然後把做好的雷酒的叢林調酒交給奈辛瓦里營地的葛林布茲·雷酒。',
  }
},
[12645] = {
  {
    'A prova dos três‡Дегустация‡Der Geschmackstest‡시음회‡La prueba de la cata‡La prueba de la cata‡Le test de dégustation‡品酒‡試喝',
    nil,
    'Ofereça uma amostra do Ponche da Selva do Cervaforte para Rosarães Guima, Hadrius Harlowe e Tamara Rodafrouxa. Em seguida, fale novamente com Canabraba Cervaforte, no Acampamento do Rosarães.‡Предложите Хемингу Эрнестуэю, Гадриусу Гарлоу и Тамаре Шестеркрут попробовать пунш "Зов джунглей", а затем вернитесь к Мрачнобуху Громовару в лагерь Эрнестуэя.‡Bietet Hemet Nesingwary, Hadrius Harlowe und Tamara Wackelspross eine Probe von Donnerbräus Dschungelpunsch an. Kehrt anschließend zu Schnapsbart Donnerbräu in Nesingwarys Basislager zurück.‡썬더브루의 시음용 정글 펀치를 헤멧 네싱워리, 하드리우스 할로, 타마라 워블스프로킷에게 제공한 다음 네싱워리 주둔지에 있는 그림부즈 썬더브루에게 돌아가야 합니다.‡Ofrece una muestra de ponche salvaje de Cebatruenos a Hemet Nesingwary, Hadrius Harlowe y Tamara Piñonflojo, después regresa junto a Tragoamargo Cebatruenos al Campamento Base de Nesingwary.‡Ofrece una muestra de ponche salvaje de Cebatruenos a Hemet Nesingwary, Hadrius Harlowe y Tamara Piñonflojo, después regresa junto a Tragoamargo Cebatruenos al Campamento Base de Nesingwary.‡Proposez un Échantillon de punch de la jungle de Tonnebière à Hemet Nesingwary, Hadrius Harlowe et Tamara Tremblerouage, puis retournez voir Tristevin Tonnebière au Camp de base de Nesingwary.‡将雷酒的丛林佳酿的酒样交给赫米特·奈辛瓦里、哈迪乌斯·哈洛维和塔玛拉·摇链品尝，然后向奈辛瓦里营地的葛瑞姆·雷酒复命。‡把雷酒的叢林調酒樣品交給赫米特·奈辛瓦里，海德里厄斯·哈羅威，以及塔瑪拉·顛鏈，然後回到奈辛瓦里營地向葛林布茲·雷酒回報。',
  }
},
[12646] = {
  {
    'Meu profeta, meu inimigo‡Пророк мой – враг мой‡Der Feind mein Prophet‡나의 예언자, 나의 적‡Mi profeta, mi enemigo‡Mi profeta, mi enemigo‡Mon prophète, mon ennemi‡我的先知，我的敌人‡我的預言者，我的敵人',
    nil,
    'O Espírito de Rhunok, no Altar de Rhunok, pediu que você recupere o Mojo do Deus Urso Ártico.‡Принесите духу Рунока настой бога белых медведей.‡Der Geist von Rhunok am Altar von Rhunok möchte, dass Ihr sein Mojo des arktischen Bärengottes wiederbeschafft.‡루노크의 제단에 있는 루노크의 영혼이 북극곰 신의 모조를 가져와 달라고 부탁했습니다.‡El espíritu de Rhunok en el Altar de Rhunok te ha pedido que consigas el mojo de dios oso ártico.‡El espíritu de Rhunok en el Altar de Rhunok te ha pedido que consigas el mojo de dios oso ártico.‡L\'Esprit de Rhunok à l\'Autel de Rhunok vous a demandé de récupérer son Mojo du dieu ours arctique.‡伦诺克祭坛的伦诺克之魂要求你找回他的极地熊神魔精。‡魯諾克祭壇的魯諾克之靈要你取得他的寒地熊神魔精。',
  }
},
[12647] = {
  {
    'Um fim para o sofrimento‡Конец мучениям‡Dem Leid ein Ende bereiten‡고통의 끝‡Acabar con el sufrimiento‡Acabar con el sufrimiento‡La fin de la souffrance‡结束痛苦‡苦難的盡頭',
    nil,
    'O Espírito de Rhunok pediu para você usar o Incenso do Atormentador para despertar o corpo dele. Depois mate Rhunok com o poder que o espírito dele lhe deu.|n|nSe, por algum motivo, você perder a aura do Mojo de Rhunok, basta retornar ao Espírito de Rhunok e ele lhe dará uma nova aura.‡Используйте фимиам мучителя, чтобы пробудить тело Рунока. Сила, которой вас наделил дух, поможет вам убить Рунока.|n|nЕсли по каким-то причинам аура амулета будет рассеяна, возвращайтесь к духу Рунока, чтобы возобновить эффект.‡Der Geist von Rhunok möchte, dass Ihr das Rauchwerk des Foltermeisters dazu einsetzt, um seinen Körper zu erwecken. Danach sollt Ihr Rhunok mithilfe der Macht, die sein Geist Euch verliehen hat, töten.|n|nFalls aus irgendeinem Grund die Aura für das Mojo von Rhunok von Euch weichen sollte, dann könnt Ihr zum Geist von Rhunok zurückkehren und Euch wieder segnen lassen.‡심문관의 향료를 사용해 루노크의 육신을 깨운 후, 루노크의 영혼이 내린 힘을 빌려 그를 처치해야 합니다.|n|n루노크의 영혼이 내린 힘이 사라지면 돌아가 다시 받을 수 있습니다.‡El espíritu de Rhunok te ha pedido que uses el incienso de torturador para despertar su cuerpo. Luego debes matar a Rhunok con el poder que te ha imbuido su espíritu.|n|nSi por alguna razón pierdes el aura de mojo de Rhunok, puedes volver con el espíritu de Rhunok para que te la vuelva a poner.‡El espíritu de Rhunok te ha pedido que uses el incienso de torturador para despertar su cuerpo. Luego debes matar a Rhunok con el poder que te ha imbuido su espíritu.|n|nSi por alguna razón pierdes el aura de mojo de Rhunok, puedes volver con el espíritu de Rhunok para que te la vuelva a poner.‡L\'Esprit de Rhunok vous a demandé d\'utiliser l\'Encens du tourmenteur pour réveiller son corps. Vous devez ensuite tuer Rhunok en utilisant le pouvoir que cet esprit vous a donné.|n|nSi vous perdez le Mojo de Rhunok, retournez voir l\'Esprit de Rhunok.‡伦诺克祭坛的伦诺克之魂要求你对他的身躯使用折磨者的薰香，使之被唤醒。然后，你要使用伦诺克灌注在你身体内的能量杀死他。|n|n如果你不小心失去了伦诺克魔精光环的影响，可以回到伦诺克之魂那里再次寻求帮助。‡魯諾克之靈要你用折磨者薰香喚醒他的身體。然後你要用他的靈魂灌注給你的力量殺死魯諾克。|n|n如果你失去了魯諾克的魔精光環，你可以回去找魯諾克之靈重新獲取它。',
  }
},
[12648] = {
  {
    'Vestido a rigor‡Маскировка‡Leger kleiden‡감쪽같은 위장‡Vestirse humildemente‡Vestirse humildemente‡Soirée déguisée‡乔装打扮‡裝扮',
    nil,
    'Stefan, no Posto Ébano, quer que você use a Gargantilha Enfeitiçada para ativar o disfarce de Flagelo.|n|nEnquanto você estiver disfarçado de membro do Flagelo, compre o Plasma Amargo vendido por Cartilaginoso.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡Используйте заколдованное колье, чтобы замаскироваться под воина Плети.|n|nПребывая в личине воина Плети, купите для Стефана с Черной заставы горькую плазму у Гнилехряща.|n|nЕсли вы потеряете свое заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr mithilfe des bezauberten Halsreifs die Geißelverkleidung auf Euch anwendet.|n|nWährend Ihr in Geißelgestalt seid, sollt Ihr bitteres Plasma von Knorpelsack kaufen.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und Ihr werdet Ersatz bekommen.‡칠흑의 감시초소에 있는 스테판이 마법의 목걸이를 사용해 스컬지 분장을 착용해 달라고 부탁했습니다.|n|n스컬지의 모습을 한 상태로 출렁창자에게서 쓴 유장을 구입해야 합니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que uses la gargantilla embrujada para disfrazarte como la Plaga.|n|nMientras estés en forma de la Plaga, tienes que comprar un plasma amargo de Cartilaginoso. |n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan del Puesto de Vigilancia de Ébano quiere que uses la gargantilla embrujada para disfrazarte como la Plaga.|n|nMientras estés en forma de la Plaga, tienes que comprar un plasma amargo de Cartilaginoso. |n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan au Guet d\'Ébène veut que vous utilisiez le Sautoir ensorcelé pour appliquer le déguisement du Fléau.|n|nAinsi déguisé, vous devez acheter du Plasma amer à Carnentraille.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡黑锋哨站的斯特凡要你使用迷惑项圈激活天灾伪装。|n|n在天灾形态下，到骨肠那里去购买苦痛浆液。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬要你使用蠱惑頸飾披上天譴偽裝。|n|n當你變成天譴軍的外貌以後，從軟魄那裡買一瓶苦澀血漿。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12649] = {
  {
    'É hora do show!‡Переодевание‡Anziehen!‡감쪽같은 위장‡¡Vestirse para la ocasión!‡¡Vestirse para la ocasión!‡En costume !‡乔装打扮！‡著裝!',
    nil,
    'Stefan, no Posto Ébano, quer que você use a Gargantilha Enfeitiçada para ativar o disfarce do Flagelo.|n|nEnquanto você estiver disfarçado de membro do Flagelo, compre o Plasma Amargo vendido por Cartilaginoso.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡Используйте Заколдованное колье, чтобы замаскироваться под воина Плети.|n|nПребывая в личине воина Плети, купите горькую плазму у Гнилехряща.|n|nЕсли вы потеряете свое заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr mithilfe des bezauberten Halsreifs die Geißelverkleidung auf Euch anwendet.|n|nWährend Ihr in Geißelgestalt seid, sollt Ihr bitteres Plasma von Knorpelsack kaufen.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und Ihr werdet Ersatz bekommen.‡칠흑의 감시초소에 있는 스테판이 마법의 목장식을 사용해 스컬지 분장을 착용해 달라고 했습니다.|n|n스컬지의 모습을 한 상태로 출렁창자에게서 쓴 유장을 구입해야 합니다.|n|n마법의 목장식을 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que uses la gargantilla embrujada para disfrazarte como la Plaga.|n|nMientras estés en forma de la Plaga, tienes que comprar un plasma amargo de Cartilaginoso. |n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan del Puesto de Vigilancia de Ébano quiere que uses la gargantilla embrujada para disfrazarte como la Plaga.|n|nMientras estés en forma de la Plaga, tienes que comprar un plasma amargo de Cartilaginoso. |n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan au Guet d\'Ébène veut que vous utilisiez le Sautoir ensorcelé pour appliquer le Déguisement du Fléau.|n|nAinsi déguisé, vous devez acheter du Plasma amer à Carnentraille.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡黑锋哨站的斯特凡要你使用迷惑项圈激活天灾伪装。|n|n在天灾形态下，到骨肠那里去购买苦痛浆液。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬，要你使用蠱惑頸飾以披上天譴偽裝。|n|n當你變成天譴軍的外貌以後，從軟魄那裡買一瓶苦澀血漿。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12650] = {
  {
    'Saqueando o próprio povo‡Разграбленное святилище‡Eigene Artefakte plündern‡어리석은 약탈자‡Saqueo propio‡Saqueo propio‡Se piller soi-même‡自毁家园‡掠奪他們自己的神器',
    nil,
    'O Cronista To\'kini, em Zim\'Torga, quer que você recupere 7 Artefatos Rhunokianos.‡Принесите летописцу То\'кини в Зим\'Торгу 7 артефактов Рунока.‡Chronist To\'kini in Zim\'Torga möchte, dass Ihr 7 Rhunokianartefakte beschafft.‡짐토르가에 있는 기록가 토키니가 루노키안 유물 7개를 되찾아 달라고 부탁했습니다.‡El cronista To\'kini de Zim\'Torga quiere que recuperes 7 artefactos rhunokianos.‡El cronista To\'kini de Zim\'Torga quiere que recuperes 7 artefactos rhunokianos.‡Le Chroniqueur To\'kini à Zim\'Torga vous demande de récupérer 7 Reliques rhunokiennes.‡希姆托加的记载者图基尼要求你收集7件伦诺克圣物。‡辛托加的撰史者托基尼要你回收7個魯諾克神器。',
  }
},
[12651] = {
  {
    'Giroporto do Lago‡Лагерь у озера‡Landeplatz am See‡호반의 착륙장‡Pista del Lago‡Pista del Lago‡Le terrain d\'atterrissage de Rive-du-lac‡湖边着陆场‡湖畔起降場',
    nil,
    'Fale com Tamara Rodafrouxa no Giroporto do Lago.‡Поговорите с Тамарой Шестеркрут в лагере у озера.‡Sprecht mit Tamara Wackelspross am Landeplatz am See.‡호반의 착륙장에 있는 타마라 워블스프로킷과 대화해야 합니다.‡Habla con Tamara Piñonflojo en la Pista del Lago.‡Habla con Tamara Piñonflojo en la Pista del Lago.‡Parlez à Tamara Tremblerouage au Terrain d\'atterrissage de Rive-du-lac.‡与湖边着陆场的塔玛拉·摇链谈一谈。‡與湖畔起降場的塔瑪拉·顛鏈交談。',
  }
},
[12652] = {
  {
    'Comida pros "carniçaus"‡Преющие вурдалаки проголодались‡Gebt dem Ghul Zucker‡구울 먹이기‡Da\'d de comedd a ezoz necrófagoz‡Da\'d de comedd a ezoz necrófagoz‡La goule au pot‡喂饱食尸鬼‡餵食食屍鬼',
    nil,
    'Cartilaginoso, no Relicário da Agonia, quer que você use a Tigela de Bucho com Miolo perto de 10 Carniçais em Decomposição.‡По поручению Гнилехряща из Реликвария Агонии возьмите чашу мозгов и кишок и накормите 10 преющих вурдалаков.‡Knorpelsack an der Reliquie der Pein möchte, dass Ihr die Schüssel voll sämigem Hirn mit Kutteln in der Nähe von 10 zerfallenden Ghulen benutzt.‡고뇌의 성물함에 있는 출렁창자가 부식된 구울 10마리 옆에서 내장탕을 사용해 달라고 부탁했습니다.‡Cartilaginoso en el Relicario de Agonía quiere que uses el cuenco de intestinos y cerebros cerca de 10 necrófagos putrefactos.‡Cartilaginoso en el Relicario de Agonía quiere que uses el cuenco de intestinos y cerebros cerca de 10 necrófagos putrefactos.‡Carnentraille au Reliquaire d\'agonie veut que vous utilisiez la Fracassée de boyaux à la cervelle près de 10 Goules putréfiées.‡折磨之匣的骨肠要求你在10只腐烂的食尸鬼附近使用杂碎大餐。‡苦楚聖匣的軟魄，要你在10個凋零的食屍鬼旁邊使用腸腦煲。',
  }
},
[12653] = {
  {
    'De volta a Har\'koa‡Назад к Хар\'коа‡Zurück zu Har\'koa‡다시 하르코아에게‡Volver con Har’koa‡Volver con Har’koa‡Retour auprès de Har\'koa‡返回哈克娅身边‡返回哈寇亞處',
    nil,
    'Fale com Har\'koa no Altar de Har\'koa.‡Поговорите с Хар\'коа у алтаря Хар\'коа.‡Sprecht mit Har\'koa am Altar von Har\'koa.‡하르코아의 제단에서 하르코아와 대화해야 합니다.‡Habla con Har’koa en el Altar de Har’koa.‡Habla con Har\'koa en el Altar de Har\'koa.‡Parlez à Har\'koa à l\'Autel de Har\'koa.‡与哈克娅祭坛的哈克娅谈一谈。‡到哈寇亞祭壇與哈寇亞交談。',
  }
},
[12654] = {
  {
    'Caçadora nas horas vagas‡Охотник на полставки‡Der Teilzeitjäger‡시간제 사냥꾼‡El cazador a tiempo parcial‡El cazador a tiempo parcial‡La chasseresse à temps partiel‡兼职猎人‡兼差獵人',
    nil,
    'Leve os Restos Mortais do Suassuno para Tamara Rodafrouxa, no Giroporto do Lago.‡Доставьте останки Острокола Тамаре Шестеркрут в лагерь у озера.‡Bringt Pechs Überreste zu Tamara Wackelspross am Landeplatz am See.‡검은 갈기의 유해를 호반의 착륙장에 있는 타마라 워블스프로킷에게 가져가야 합니다.‡Lleva los restos de Brea a Tamara Piñonflojo en la Pista del Lago.‡Lleva los restos de Brea a Tamara Piñonflojo en la Pista del Lago.‡Rapportez les Restes de Poix à Tamara Tremblerouage au Terrain d\'atterrissage de Rive-du-lac.‡将匹奇的遗体交给湖边着陆场的塔玛拉·摇链。‡把匹奇的殘骸帶去給湖畔起降場的塔瑪拉·顛鏈。',
  }
},
[12655] = {
  {
    'A bênção de Zim\'Rhuk‡Благословение Зим\'Рука‡Der Segen von Zim\'Rhuk‡짐루크의 가호‡La bendición de Zim\'Rhuk‡La bendición de Zim\'Rhuk‡La bénédiction de Zim\'Rhuk‡希姆鲁克的祝福‡辛茹克的祝福',
    nil,
    'O Mandingueiro Khufu, na Fortaleza Argêntea, quer que você leve 10 Oferendas Drakkari à estátua de Zim\'Rhuk.‡По поручению знахаря Кхуфу принесите 10 подношений Драккари к изваянию Зим\'Рука.‡Hexendoktor Khufu möchte, dass Ihr der Statue von Zim\'Rhuk 10 Drakkariopfergaben darbringt.‡의술사 쿠푸가 짐루크 조각상에 드라카리 공물 10개를 바쳐 달라고 부탁했습니다.‡El médico brujo Khufu quiere que presentes 10 ofrendas Drakkari ante la estatua de Zim\'Rhuk.‡El médico brujo Khufu quiere que presentes 10 ofrendas Drakkari ante la estatua de Zim\'Rhuk.‡Le Féticheur Khufu vous a demandé de présenter 10 Offrandes drakkari à la statue de Zim\'Rhuk.‡巫医库弗要求你在希姆鲁克的雕像前奉上10份达卡莱供品。‡巫醫庫弗要你對辛茹克的雕像獻上10份德拉克瑞祭品。',
  }
},
[12656] = {
  {
    'Bênção de Zim\'Rhuk‡Благословение Зим\'Рука‡Der Segen von Zim\'Rhuk‡짐루크의 가호‡La bendición de Zim\'Rhuk‡La bendición de Zim\'Rhuk‡Bénédiction de Zim\'Rhuk‡希姆鲁克的祝福‡辛茹克的祝福',
    nil,
    nil,
  }
},
[12657] = {
  {
    'O poder do Flagelo‡Мощь Плети‡Die Macht der Geißel‡스컬지의 힘‡El poder de la Plaga‡El poder de la Plaga‡La puissance du Fléau‡天灾的力量‡天譴軍團的力量',
    nil,
    'O Lich Rei quer que você entregue as ordens para o grão-lorde Dárion Mograine na Fortaleza de Ébano.|n|nUse o transportador iluminado atrás do Lich Rei para chegar ao grão-lorde Dárion Mograine, no Salão de Comando.‡Король-лич приказал вам передать его распоряжения верховному лорду Дариону Могрейну в Черный оплот.|n|nЧтобы попасть в Зал Власти, воспользуйтесь мерцающим телепортом позади Короля-лича.‡Der Lichkönig gebietet Euch, seine Befehle zu Hochlord Darion Mograine in der Schwarzen Festung zu bringen.|n|nBenutzt den leuchtenden Transporter, der sich hinter dem Lichkönig befindet, um zu Hochlord Darion Mograine in die Hallen des Befehls zu gelangen.‡리치 왕이 자신의 명령서를 칠흑의 요새에 있는 대영주 다리온 모그레인에게 전달하라고 명령했습니다.|n|n지휘의 광장에 있는 대영주 다리온 모그레인에게 가려면 리치 왕의 뒤에 있는 빛나는 순간이동기를 사용해야 합니다.‡El Rey Exánime te pide que lleves sus órdenes al alto señor Darion Mograine en El Bastión de Ébano.|n|nUsa el teletransportador resplandeciente que hay detrás del Rey Exánime para llegar hasta el alto señor Darion Mograine en la Sala de Mando.‡El Rey Exánime quiere que lleves sus órdenes al alto señor Darion Mograine en El Bastión de Ébano.|n|nUsa el teletransportador resplandeciente que hay detrás del Rey Exánime para llegar hasta el alto señor Darion Mograine en la Sala de Mando.‡Le Roi-liche vous ordonne d\'apporter ses ordres au Généralissime Darion Mograine au Fort d\'Ébène.|n|nUtilisez le transporteur lumineux derrière le roi-liche pour vous rendre auprès du Généralissime Darion Mograine dans la Salle de commandement.‡巫妖王要你带着他的命令去找黑锋要塞内的大领主达里安·莫格莱尼。|n|n使用巫妖王身后的传送器，前往大领主达里安·莫格莱尼所在的命令大厅。‡巫妖王命令你將他的飭令交給黯黑堡的大領主達瑞安·莫格萊尼。|n|n使用巫妖王背後發著光的傳送器去指揮大廳找大領主達瑞安·莫格萊尼。',
  }
},
[12658] = {
  {
    'Minha mascote é um galvo‡Моя ручная птица Рух‡Mein Kuschelroc‡나의 귀여운 로크‡Mi mascota roc‡Mi mascota roc‡Mon roc familier‡我的宠物大鹏‡我的大鵬寵物',
    nil,
    'Leve 7 Ovos de Galvo para Quebragulho no Posto Avançado de Dorian.‡Принесите Любопытсону в форпост Дориана 7 яиц руха.‡Bringt Spleenix bei Dorians Außenposten 7 Eier eines Rocs.‡로크 알 7개를 도리안의 전초기지에 있는 주트피즐에게 가져가야 합니다.‡Lleva 7 huevos de roc a Zootsilbo en la Avanzada de Dorian.‡Lleva 7 huevos de roc a Zootsilbo en la Avanzada de Dorian.‡Rapportez 7 Œufs de roc à Zazoutille, à l\'Avant-poste de Dorian.‡将7枚大鹏卵交给多里安哨站的苏特菲兹。‡把7個大鵬蛋帶去給多里安前哨的狹嘶。',
  }
},
[12659] = {
  {
    'Escalpos!‡Скальпы!‡Skalpe!‡본때를 보여줘!‡¡Cabelleras!‡¡Cabelleras!‡Des scalps !‡巫毒头饰！‡割頭皮!',
    nil,
    'O Escalpelador Ahunae, em Zim\'Torga, quer quer você use a Faca de Ahunae para cortar o escalpo de 10 trolls Heb\'Drakkar.|n|nO escalpelador o lembra que você deve saqueá-los primeiro.‡По поручению Ауне из Зим\'торги возьмите нож Ауне и снимите скальпы с 10 хеб\'драккарских троллей.|n|nНе забывайте, сначала троллей следует обыскать.‡Skalpierer Ahunae in Zim\'Torga möchte, dass Ihr Ahunaes Messer benutzt, um 10 Heb\'Drakkar Trolle zu skalpieren.|n|nDer Skalpierer erinnert Euch daran, sie zuerst auszuplündern.‡짐토르가에 있는 무두장이 아훈네가 아훈네의 칼을 사용하여 헤브드라카 트롤 10명을 처치하고 머리카락을 잘라 오라고 부탁했습니다.|n|n칼을 사용하기 전에 전리품부터 챙기라고도 일러주었습니다.‡El arrancacabelleras Ahunae en Zim\'Torga quiere que utilices el puñal de Ahunae para arrancar la cabellera a 10 trols de Heb\'Drakkar.|n|nEl arrancacabelleras te recuerda que primero tienes que despojarlos.‡El arrancacabelleras Ahunae en Zim\'Torga quiere que utilices el puñal de Ahunae para arrancar la cabellera a 10 trols de Heb\'Drakkar.|n|nEl arrancacabelleras te recuerda que primero tienes que despojarlos.‡Le Scalpeur Ahunae à Zim\'Torga vous demande d\'utiliser le Couteau d\'Ahunae pour scalper 10 Trolls d\'Heb\'Drakkar.|n|nLe Scalpeur vous rappelle que vous devez d\'abord récupérer le butin qu\'ils ont sur eux.‡希姆托加的剥皮师埃霍奈要求你使用埃霍奈的小刀拆下10名赫布达卡巨魔的巫毒头饰。|n|n他还提醒你，要先搜索过他们的 躯体之后再拆卸巫毒头饰。‡辛托加的割顱者艾胡奈要你使用艾胡奈小刀去割10個希伯德拉卡食人妖的頭皮。|n|n割顱者提醒你記得要先拾取他們身上的物品。',
  }
},
[12660] = {
  {
    'Armas da destruição‡Орудия разрушения‡Vernichtungswaffen‡파괴의 무기‡Armas de destrucción‡Armas de destrucción‡Les armes de destruction‡毁灭性的武器‡毀滅武器',
    nil,
    'O Avatar de Freya quer que você vá ao Posto Avançado Mão da Morte, a noroeste, e destrua 4 Explosivos Instáveis.‡По поручению Аватары Фрейи отправляйтесь в лагерь Руки Смерти на северо-запад и уничтожьте 4 единицы нестабильной взрывчатки.‡Der Avatar von Freya möchte, dass Ihr zum Lager der Todeshand in den Nordwesten geht und 4 Stück des instabilen Sprengstoffs zerstört.‡프레이야의 화신이 북서쪽에 있는 죽음의 손 야영지로 가서 불안정한 폭발물 4개를 파괴해 달라고 했습니다.‡El avatar de Freya quiere que vayas al Campamento Mano de la Muerte al noroeste y destruyas 4 explosivos inestables.‡El avatar de Freya quiere que vayas al Campamento Mano de la Muerte al noroeste y destruyas 4 explosivos inestables.‡L\'Avatar de Freya vous demande d\'aller au Campement de la Main de Mort, au nord-ouest, pour y détruire 4 Explosifs instables.‡弗蕾亚的化身要求你前往西北方的死亡之手营地，销毁4车不稳定的炸药。‡芙蕾雅的化身要你前往西北方的死亡之手駐營摧毀4個不穩定爆裂物。',
  }
},
[12661] = {
  {
    'Infiltrando-se em Voltarus‡На разведку в Волтар‡Als Spion nach Voltarus‡볼타루스 침투‡Infiltrarse en Voltarus‡Infiltrarse en Voltarus‡Infiltrer Voltarus‡潜入沃尔塔鲁斯‡滲透沃塔魯斯',
    nil,
    'Stefan quer que você use a Gargantilha Enfeitiçada para entrar em Voltarus e fazer o que o líder do Flagelo mandar.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡По поручению Стефана используйте заколдованное колье, чтобы пробраться в Волтар. Там вы должны делать все, о чем вас попросит предводитель сил Плети.|n|nЕсли вы потеряете Заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan möchte, dass Ihr Euren bezauberten Halsreif benutzt, um Euch in Voltarus einzuschleichen und dort alles zu tun, was der Anführer der Geißel von Euch verlangt.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und besorgt Euch einen neuen.‡스테판이 마법의 목걸이를 사용해 볼타루스에 들어간 다음 스컬지 지휘관이 하라는 대로 따르라고 부탁했습니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan quiere que utilices la gargantilla embrujada para entrar en Voltarus y hacer lo que te pida el líder de la Plaga.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de la Avanzada de Ébano para conseguir otra.‡Stefan quiere que utilices la gargantilla embrujada para entrar en Voltarus y hacer lo que te pida el líder de la Plaga.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de la Avanzada de Ébano para conseguir otra.‡Stefan veut que vous utilisiez le Sautoir ensorcelé pour pénétrer dans Voltarus et faire tout ce que le Commandant du Fléau sur place vous demande.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡斯特凡你要你使用迷惑项圈进入沃尔塔鲁斯，并按照天灾军团指挥官的命令行动。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡史戴芬要你使用蠱惑頸飾進入沃塔魯斯然後完成天譴指揮官的任何要求。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12662] = {
  {
    'Derrube Heb\'Jin‡Смерть Хеб\'Джина‡Heb\'Jin erledigen‡헤브진 처단‡Abate a Heb\'Jin‡Abate a Heb\'Jin‡Heb\'Jin toxique‡击落赫布金‡宰掉希伯金',
    nil,
    'A Domadora de Elementos Dagoda, em Zim\'Torga, quer que você mate Heb\'Jin.‡По заданию укротителя стихий Дагоды из Зим\'Торги убейте Хеб\'Джина.‡Elementzähmerin Dagoda in Zim\'Torga möchte, dass Ihr Heb\'Jin tötet.‡짐토르가에 있는 정령조련사 다고다가 헤브진을 처치해 달라고 부탁했습니다.‡La domadora de elementos Dagoda de Zim\'Torga quiere que mates a Heb\'Jin.‡La domadora de elementos Dagoda de Zim\'Torga quiere que mates a Heb\'Jin.‡La Dompteuse des éléments Dagoda à Zim\'Torga vous a demandé de tuer Heb\'Jin.‡希姆托加的元素驯服者德苟达要求你去杀死赫布金。‡辛托加的元素馴伏者達茍答要你殺死希伯金。',
  }
},
[12663] = {
  {
    '‡Воссоединение‡Wiedervereint‡재회‡Reunidos‡Reunidos‡Retrouvailles‡久别重逢‡聚首',
    nil,
    '‡По заданию Дракуру из Волтара поговорите с Кровомесом и отправляйтесь в Зул\'Драк.‡Drakuru in Voltarus möchte, dass Ihr mit Grindbruch sprecht und den Rundflug über Zul\'Drak macht.‡볼타루스에 있는 드라쿠루가 고어백과 이야기해 줄드락을 돌아봐 달라고 했습니다.‡Drakuru de Voltarus quiere que hables con Bolsasangrienta y que des una vuelta por Zul\'Drak.‡Drakuru de Voltarus quiere que hables con Bolsasangrienta y que des una vuelta por Zul\'Drak.‡Drakuru, à Voltarus, veut que vous parliez à Sakassang et que vous visitiez Zul\'Drak.‡沃尔塔鲁斯的达库鲁要求你与高尔巴格交谈，并游览祖达克。‡',
  }
},
[12664] = {
  {
    'Horizonte sombrio‡Темный горизонт‡Dunkler Horizont‡어두운 지평선‡Horizonte Oscuro‡Horizonte Oscuro‡Sombre horizon‡黑暗的地平线‡黑暗地平線',
    nil,
    'Drakuru, em Voltarus, quer que você fale com o Bolssang e faça um tour por Zul\'Drak.‡По заданию Дракуру из Волтара поговорите с Кровомесом и отправляйтесь в Зул\'Драк.‡Drakuru in Voltarus möchte, dass Ihr mit Grindbruch sprecht und den Rundflug über Zul\'Drak macht.‡볼타루스에 있는 드라쿠루가 고어백과 이야기해 줄드락을 돌아봐 달라고 부탁했습니다.‡Drakuru de Voltarus quiere que hables con Bolsasangrienta y que des una vuelta por Zul\'Drak.‡Drakuru de Voltarus quiere que hables con Bolsasangrienta y que des una vuelta por Zul\'Drak.‡Drakuru, à Voltarus, veut que vous parliez à Sakassang et que vous visitiez Zul\'Drak.‡沃尔塔鲁斯的达库鲁要求你与高尔巴格交谈，并游览祖达克。‡沃塔魯斯的德拉庫魯要你跟血袋交談，然後參觀祖爾德拉克。',
  }
},
[12665] = {
  {
    'Sinto um distúrbio‡Дурное предчувствие‡Ich spüre eine Erschütterung‡불안한 느낌‡Noto una alteración‡Noto una alteración‡Ça sent les problèmes‡不祥的扰动‡我感應到不安',
    nil,
    'Har\'koa pediu para você descobrir o que aconteceu com Quetz\'lun. Fale com ela para cavalgar sorrateiramente em um dos filhos dela até o Altar de Quetz\'lun.|n|nDepois disso, fale com ela novamente no Altar de Har\'koa.‡Узнайте, что случилось с Кетц\'лун. Хар\'коа даст вам в помощь одного из своих детей, чтобы незаметно пробраться к алтарю Кетц\'лун.|n|nКогда все выясните, возвращайтесь обратно к Хар\'коа – она ждет вас у своего алтаря.‡Har\'koa hat Euch gebeten, herauszufinden, was mit Quetz\'lun geschehen ist. Sprecht mit ihr, um heimlich auf einem ihrer Kinder zum Altar von Quetz\'lun zu reiten.|n|nKehrt zu ihr am Altar von Har\'koa zurück, sobald Ihr die Aufgabe erfüllt habt.‡하르코아가 쿠에츠룬에게 무슨 일이 생겼는지 알아봐 달라고 부탁했습니다. 하르코아와 이야기하면 그녀의 자손을 타고 은신한 상태로 쿠에츠룬의 제단으로 갈 수 있습니다.|n|n임무를 마치면 하르코아의 제단에 있는 하르코아와 이야기해야 합니다.‡Har\'koa te ha pedido que averigües qué le ha pasado a Quetz\'lun. Habla con ella para que te deje a una de sus crías y puedas ir sigilosamente al Altar de Quetz\'lun.|n|nVuelve con ella al Altar de Har\'koa cuando lo hayas hecho.‡Har\'koa te ha pedido que averigües qué le ha pasado a Quetz\'lun. Habla con ella para que te deje a una de sus crías y puedas ir sigilosamente al Altar de Quetz\'lun.|n|nVuelve con ella al Altar de Har\'koa cuando lo hayas hecho.‡Har\'koa vous a demandé de découvrir ce qui est arrivé à Quetz\'lun. Allez lui parler pour pouvoir chevaucher un de ses enfants et vous rendre discrètement à l\'Autel de Quetz\'lun.|n|nLorsque ce sera fait, retournez la voir à l\'Autel de Har\'koa.‡哈克娅要求你去查明奎丝鲁恩的状况。你可以与哈克娅交谈，乘在她孩子的背上悄悄潜入奎丝鲁恩祭坛。|n|n完成侦察任务之后，回到哈克娅祭坛向她报告。‡哈寇亞要你查清楚奎茲倫身上發生了什麼事。和她交談以騎上她的孩子，潛入奎茲倫的祭壇。|n|n當你完成任務之後回到哈寇亞祭壇找她。',
  }
},
[12666] = {
  {
    'Preparativos para o submundo‡Путешествие в Нижний мир‡Vorbereitungen für die Unterwelt‡저승에 갈 준비‡Preparaciones para el inframundo‡Preparaciones para el inframundo‡Préparation pour un voyage au cœur du monde souterrain‡进入灵界的准备‡進入幽界的準備',
    nil,
    'Har\'koa quer que você colete 8 Adornos Sagrados. Entregue-os a ela no Altar de Har\'koa.‡Соберите 8 священных украшений и принесите их Хар\'коа к алтарю Хар\'коа.‡Har\'koa am Altar von Har\'koa möchte, dass Ihr 8 Stück heiliger Zier sammelt und sie anschließend bei ihr abliefert.‡신성한 장신구 8개를 모아 하르코아의 제단에 있는 하르코아에게 가져가야 합니다.‡Har\'koa quiere que recojas 8 adornos sacros. Entrégaselos en el Altar de Har\'koa.‡Har\'koa quiere que recojas 8 adornos sacros. Entrégaselos en el Altar de Har\'koa.‡Har\'koa vous demande de récupérer 8 Parures sacrées et de les lui rapporter à l\'Autel de Har\'koa.‡哈克娅要求你收集8枚神圣符印，并把它们带回哈克娅祭坛交给她。‡哈寇亞要你收集8個神聖飾物。收集完成之後送去哈寇亞祭壇給她。',
  }
},
[12667] = {
  {
    'Encontre a deusa serpente do vento‡Поиски богини крылатых змеев‡Sucht die Windschlangengöttin auf‡천둥매 여신 찾기‡Busca a la diosa serpiente alada‡Busca a la diosa serpiente alada‡À la recherche de la déesse serpent du vent‡寻找风蛇女神‡尋找風蛇女神',
    nil,
    'Procure o Espírito de Quetz\'lun no Altar de Quetz\'lun.‡Разыщите дух Кетц\'лун у алтаря Кетц\'лун.‡Geht zum Altar von Quetz\'lun und sucht Quetz\'luns Geist auf.‡쿠에츠룬의 제단에서 쿠에츠룬의 영혼을 찾아야 합니다.‡Busca el espíritu de Quetz\'lun en el Altar de Quetz\'lun.‡Busca el espíritu de Quetz\'lun en el Altar de Quetz\'lun.‡Recherchez l\'Esprit de Quetz\'lun à l\'Autel de Quetz\'lun.‡前往奎丝鲁恩祭坛，寻找奎丝鲁恩之魂。‡到奎茲倫祭壇找出奎茲倫之靈。',
  }
},
[12668] = {
  {
    'Base para a vingança‡Задел для мести‡Den Weg zur Rache ebnen‡복수의 초석‡Cimientos de venganza‡Cimientos de venganza‡Les bases de la vengeance‡复仇的基础‡復仇的基礎',
    nil,
    'O Espírito de Quetz\'lun lhe conferiu a tarefa de exterminar 12 trolls, Adoradores de Quetz\'luz ou Berserkers Tocados pela Serpente, perto das Fontes de Almas.|n|nFale novamente com ela no Altar de Quetz\'lun somente após cumprir a tarefa.‡Убейте 12 троллей из числа служителей Кетц\'лун или помешанных на змеях берсерков рядом с Темными купелями.|n|nПотом вернитесь к Кетц\'лун, которая будет ждать вас у алтаря.‡Quetz\'luns Geist am Altar von Quetz\'lun hat Euch damit beauftragt, in der Nähe ihrer Seelenbrunnen 12 Trolle zu töten. Diese können entweder Anbeter von Quetz\'lun oder schlangengebissene Berserker sein.|n|nKehrt erst dann wieder zu ihr zurück, wenn Ihr Eure Aufgabe erfüllt habt.‡쿠에츠룬의 영혼이 영혼의 샘 근처에서 쿠에츠룬 숭배자나 천둥매를 영접한 광전사 12명을 처치하라고 했습니다.|n|n임무를 마치면 쿠에츠룬의 제단에 있는 쿠에츠룬의 영혼에게 돌아가야 합니다.‡El espíritu de Quetz\'lun te ha encargado la exterminación de 12 trols, beatos de Quetz\'lun o rabiosos vipéridos, cerca de sus fuentes de almas. Solo cuando hayas cumplido con esto volverás con ella al Altar de Quetz\'lun.‡El espíritu de Quetz\'lun te ha encargado la exterminación de 12 trols, veneradores de Quetz\'lun o rabiosos vipéridos, cerca de sus fuentes de almas.|n|nSolo cuando hayas cumplido con esto volverás con ella al Altar de Quetz\'lun.‡L\'esprit de Quetz\'lun vous a demandé de tuer 12 trolls, soit des Adorateurs de Quetz\'lun, soit des Berserkers touchés par le serpent, près de ses Fontaines d\'âmes.|n|nCe n\'est qu\'une fois que vous aurez accompli cette tâche que vous pourrez retourner la voir à l\'Autel de Quetz\'lun.‡奎丝鲁恩之魂要你在她的灵魂之泉附近杀死12个巨魔，奎丝鲁恩崇拜者或蛇灵狂暴者都可以。|n|n完成任务之后回到奎丝鲁恩祭坛向她复命。‡奎茲倫之靈要你在她的靈魂聖水器附近毀滅12個食人妖，不管是奎茲倫崇拜者或蛇觸狂戰士都可以。|n|n你只能在完成這任務之後才回去她的祭壇找她。',
  }
},
[12669] = {
  {
    'Tudo péssimo até agora‡Пока все идет на удивление паршиво‡So weit, so schlecht‡지금까지는 좋지 않은 성과‡Por ahora todo mal‡Por ahora todo mal‡Pour l\'instant, tout va mal‡目前为止，一切很糟‡目前為止一切都很糟',
    nil,
    'Stefan, no Posto Ébano, quer que você fale novamente com Drakuru e cumpra quaisquer tarefas que ele ordenar.|n|nEnquanto estiver no Relicário da Dor, use o Aditivo de Diluição em 5 Caldeirões de Praga.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡По поручению Стефана с Черной заставы вернитесь к Дракуру и выполняйте его приказы.|n|nКогда вернетесь в Реликварий Боли, вылейте растворитель в 5 котлов Плети.|n|nЕсли вы потеряете свое заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr zu Drakuru zurückkehrt und alles tut, was er von Euch verlangt.|n|nWährend Ihr beim Reliquiar des Schmerzes seid, sollt Ihr die Verdünnungslösung in 5 Seuchenkessel schütten.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und Ihr werdet Ersatz bekommen.‡칠흑의 감시초소에 있는 스테판이 드라쿠루에게 돌아가 그가 시키는 임무를 완수하라고 했습니다.|n|n고통의 성물함에 있는 동안 역병 희석제를 파멸의 역병 가마솥 5개에 사용해야 합니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan en el Puesto de Vigilancia de Ébano quiere que vuelvas con Drakuru y completes cualquier tarea que tenga para ti.|n|nMientras estés en el Relicario de Dolor, utiliza el aditivo diluido en 5 calderas de añublo.|n|nSi pierdes tu gargantilla embrujada, vuelve con Stefan del Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan en el Puesto de Vigilancia de Ébano quiere que vuelvas con Drakuru y completes cualquier tarea que tenga para ti.|n|nMientras estés en el Relicario de Dolor, utiliza el aditivo diluido en 5 calderas de añublo.|n|nSi pierdes tu gargantilla embrujada, vuelve con Stefan del Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan au Guet d\'Ébène veut que vous retourniez auprès de Drakuru et que vous accomplissiez les tâches qu\'il vous donne.|n|nPendant que vous serez au Reliquaire de souffrance, versez le Diluant dans 5 Chaudrons de chancre.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡黑锋哨站的斯特凡要你回到达库鲁身边并听从他的指挥。|n|n在痛苦之匣一带对5只瘟疫之锅使用稀释药剂。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬要你回去找德拉庫魯，然後完成他交代你的工作。|n|n當你到痛苦聖匣的時候，你要對5個荒疫大鍋使用稀釋添加物。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12670] = {
  {
    'Colheita escarlate‡Жатва Алых‡Die Scharlachrote Ernte‡붉은십자군 공격‡La cosecha Escarlata‡La cosecha Escarlata‡La moisson écarlate‡血色收割‡血色收割',
    nil,
    'Apresente-se ao príncipe Valanar na Vanguarda da Morte.‡Доложите о своем прибытии в Разлом Смерти принцу Валанару.‡Meldet Euch bei Prinz Valanar bei der Todesbresche.‡죽음의 틈에 있는 공작 발라나르에게 보고해야 합니다.‡Preséntate ante el príncipe Valanar en la Brecha de la Muerte.‡Preséntate ante el príncipe Valanar en la Brecha de la Muerte.‡Présentez-vous au Prince Valanar à Brèche-de-Mort.‡前往死亡裂口，向瓦拉纳王子报到。‡向死亡止境的瓦拉納爾親王報到。',
  }
},
[12671] = {
  {
    'Voo de reconhecimento‡Разведывательный полет‡Aufklärungsflug‡정찰 비행‡Vuelo de reconocimiento‡Vuelo de reconocimiento‡Un vol de reconnaissance‡侦察飞行‡空中偵察',
    nil,
    'Ajude o Piloto Vic a completar o Voo de Reconhecimento.‡Помогите пилоту Вику совершить разведывательный полет.‡Helft Pilot Vic den Aufklärungsflug abzuschließen.‡조종사 빅이 정찰 비행을 완수하도록 도와야 합니다.‡Ayuda al piloto Vic a completar el vuelo de reconocimiento.‡Ayuda al piloto Vic a completar el vuelo de reconocimiento.‡Aidez le Pilote Vic à effectuer un Vol de reconnaissance.‡帮助飞行员维克完成侦察飞行。‡協助駕駛員維克完成偵察飛行。',
  }
},
[12672] = {
  {
    'Preparando o terreno‡Подготовка к мести‡Wegbereiter‡무대 꾸미기‡Preparando el escenario‡Preparando el escenario‡Mise en place‡创造条件‡準備舞台',
    nil,
    'O Espírito de Quetz\'lun exige que você colete 10 Fragmentos de Poder do Submundo. Fale com ela novamente no Altar de Quetz\'lun somente após terminar.‡Соберите 10 потусторонних энергетических фрагментов и вернитесь к алтарю Кетц\'лун.‡Quetz\'luns Geist verlangt, dass Ihr 10 Fragmente unterweltlicher Macht sammelt. Kehrt zu ihr zum Altar von Quetz\'lun zurück, wenn Euch dies geglückt ist.‡저승의 주술 파편 10개를 모아서 쿠에츠룬의 제단에 있는 쿠에츠룬의 영혼에게 돌아가야 합니다.‡El espíritu de Quetz\'lun te ha pedido que recojas 10 fragmentos de poder del inframundo. Vuelve con ella al Altar de Quetz\'lun cuando hayas acabado.‡El espíritu de Quetz\'lun te ha pedido que recojas 10 fragmentos de poder del inframundo. Vuelve con ella al Altar de Quetz\'lun cuando hayas acabado.‡L\'Esprit de Quetz\'lun vous a demandé de récupérer 10 Fragments de pouvoir du monde souterrain. Retournez la voir à l\'Autel de Quetz\'lun une fois la tâche effectuée.‡奎丝鲁恩之魂要你收集10块灵界能量碎片。完成任务后返回奎丝鲁恩祭坛向她复命。‡奎茲倫的靈魂要你收集10個幽界力量碎片。當你完成之後回到奎茲倫祭壇找她，',
  }
},
[12673] = {
  {
    'Agora é com você‡Сбор кристаллов‡Nach oben buckeln, nach unten treten‡일꾼 다루기‡Donde hay patrón…‡Donde hay patrón…‡Là-bas tout en bas‡官大一级压死人‡滾下山坡',
    nil,
    'O Suserano Drakuru, em Voltarus, quer que você use o Cetro de Sugestão nos Geists da Praga e depois mande-os coletar 7 Cristais da Praga.‡Командир Дракуру в Волтарасе хочет, чтобы вы взяли скипетр внушения и с его помощью заставили гнилостных упырей собрать 7 кристаллов гнили.‡Oberanführer Drakuru in Voltarus möchte, dass Ihr das Szepter der Suggestion auf die Seuchenspuke anwendet und sie dann 7 Seuchenkristalle sammeln lasst.‡역병 외눈깨비에게 독려의 홀을 사용해 역병 결정 7개를 채취한 다음, 볼타루스에 있는 대군주 드라쿠루에게 돌아가야 합니다.‡El Señor supremo Drakuru en Voltarus quiere que utilices el cetro de sugerencia en geists de añublo y que les ordenes a recolectar 7 cristales de añublo.‡El señor supremo Drakuru en Voltarus quiere que utilices el cetro de sugerencia en geists de añublo y que les ordenes recolectar 7 cristales de añublo.‡Le Seigneur Drakuru à Voltarus veut que vous utilisiez le Sceptre de suggestion sur les Geists chancreux et que vous leur ordonniez ensuite de récolter 7 Cristaux chancreux.‡沃尔塔鲁斯的指挥官达库鲁要你对荒芜恶鬼使用暗示节杖，并指挥它们采集7颗荒芜水晶。‡沃塔魯斯的德拉庫魯指揮官，要你對荒疫魂屍使用建言權杖，然後命令他們收集7個荒疫水晶。',
  }
},
[12674] = {
  {
    'O inferno treme de fúria‡Вся ярость преисподней‡Zornentbrannte Hölle‡지옥의 분노‡Ira de mujer…‡Ira de mujer…‡L\'enfer a une furie‡地狱的复仇‡地獄也會憤怒',
    nil,
    'O Espírito de Quetz\'lun, no Altar de Quetz\'lun, quer que você use a Vara Mandingada de Quetz\'lun no Alto-sacerdote Mu\'funu, na Alta-sacerdotisa Tua-Tua e no Alto-sacerdote Hawinni. Mate-os depois disso.‡По поручению духа Кетц\'Лун воздействуйте проклинаающим жезлом Кетц\'лун на верховного жреца Му\'фуну, верховную жрицу Туа-Туа и верховного жреца Хавинни. После этого вы должны их убить.‡Quetz\'luns Geist am Altar von Quetz\'lun möchte, dass Ihr Quetz\'luns Verhexungsstecken auf Hohepriester Mu\'funu, Hohepriester Tua-Tua und Hohepriester Hawinni anwendet. Anschließend sollt Ihr sie vernichten.‡대사제 무푸누, 대여사제 투아투아, 대사제 하위니에게 쿠에츠룬의 주술 막대를 사용하고 처치한 다음 쿠에츠룬의 제단에 있는 쿠에츠룬의 영혼에게 돌아가야 합니다.‡El espíritu de Quetz\'lun quiere que utilices el palo de maleficios de Quetz\'lun contra el sumo sacerdote Mu\'funu, la suma sacerdotisa Tua-Tua y el sumo sacerdote Hawinni. Cuando lo hayas hecho, mátalos.‡El espíritu de Quetz\'lun quiere que utilices el palo de maleficios de Quetz\'lun contra el sumo sacerdote Mu\'funu, la suma sacerdotisa Tua-Tua y el sumo sacerdote Hawinni. Cuando lo hayas hecho, mátalos.‡L\'Esprit de Quetz\'lun à l\'Autel de Quetz\'lun vous a demandé d\'utiliser la Badine maléficieuse de Quetz\'lun sur le Grand prêtre Mu\'funu, la Grande prêtresse Tua-Tua et le Grand prêtre Hawinni. Lorsque ce sera fait, tuez-les.‡奎丝鲁恩祭坛的奎丝鲁恩之魂要你对高阶祭司穆弗努、高阶祭司图亚图亚和高阶祭司哈文尼使用奎丝鲁恩的妖术棒，然后杀死他们。‡奎茲倫祭壇的奎茲倫之靈要你對高階祭司姆弗努、高階祭司托托、還有高階祭司哈文尼使用奎茲倫的妖術手杖。一旦使用完手杖，就殺了他們。',
  }
},
[12675] = {
  {
    'Mais uma coisa‡И последнее...‡Eine letzte Sache‡마지막 재료‡Una última cosa‡Una última cosa‡Une dernière chose‡最后一步‡最後一件事',
    nil,
    'Entregue os Fragmentos de Poder do Submundo a Har\'koa e suplique a ela um pouco de seu espírito. Ela ainda está no Altar de Har\'koa.‡Отнесите Хар\'коа потусторонние энергетические фрагменты и попросите ее зарядить их частичкой ее духа. Вы найдете ее у алтаря Хар\'коа.‡Liefert die Fragmente unterweltlicher Macht bei Har\'koa ab und bittet sie um einen Teil ihres Geistes. Sie befindet sich noch immer am Altar von Har\'koa.‡하르코아의 제단에 있는 하르코아에게 저승의 주술 파편을 가져가 그녀의 영혼 일부를 얻어야 합니다.‡Entrega el fragmento de poder del inframundo a Har\'koa y suplícale que te dé una muestra de su espíritu. Aún debe estar en el Altar de Har\'koa.‡Entrega el fragmento de poder del inframundo a Har\'koa y suplícale que te dé una muestra de su espíritu. Aún debe estar en el Altar de Har\'koa.‡Apportez les Fragments de pouvoir du monde souterrain à Har\'koa et suppliez-la de vous donner une portion de son esprit. Vous la trouverez à l\'Autel de Har\'koa.‡前往哈克娅祭坛，请求哈克娅在灵界能量碎片中注入一丝她的精魄。‡將幽界力量碎片堆送去給哈寇亞，請求她給你部分的靈魂。你仍會在哈寇亞祭壇找到她。',
  }
},
[12676] = {
  {
    'Sabotagem‡Диверсия‡Sabotage‡방해 공작‡Sabotaje‡Sabotaje‡Sabotage‡爆破活动‡破壞工作',
    nil,
    'Stefan, no Posto Ébano, quer que você cumpra outra tarefa para Drakuru.|n|nAlém disso, use 5 Cargas Explosivas em 5 Carroções do Flagelo no Relicário da Dor.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡По поручению Стефана с Черной заставы продолжайте выполнять поручения Дракуру.|n|nКроме того, активируйте заряды взрывчатки, чтобы уничтожить 5 повозок Плети в Реликварии Боли.|n|nЕсли вы потеряете свое заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr eine weitere Aufgabe für Drakuru erledigt.|n|nZusätzlich dazu müsst Ihr an 5 Geißelwagen im Reliquiar des Schmerzes Sprengladungen anbringen.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und Ihr werdet Ersatz bekommen.‡칠흑의 감시초소에 있는 스테판이 드라쿠루가 주는 임무를 수행해 달라고 부탁했습니다.|n|n고통의 성물함에서 스컬지마차 5개에 폭발물을 사용해야 합니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que realices otra tarea para Drakuru.|n|nAdemás, tienes que poner 5 cargas explosivas en los carros de la Plaga en el Relicario de Dolor.|n|nSi pierdes tu gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan del Puesto de Vigilancia de Ébano quiere que realices otra tarea para Drakuru.|n|nAdemás, tienes que poner 5 cargas explosivas en los carros de la Plaga en el Relicario de Dolor.|n|nSi pierdes tu gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan au Guet d\'Ébène vous a demandé d\'effectuer une autre tâche pour Drakuru.|n|nDe plus, vous devez utiliser les Charges explosives sur 5 Chariots du Fléau au Reliquaire de souffrance.|n|nSi vous perdez le Sautoir ensorcelé, allez voir Stefan au Guet d\'Ébène, il vous en donnera un autre.‡黑锋哨站的斯特凡要求你再去为达库鲁执行一项任务。|n|n除此之外，他还要你前往痛苦之匣，使用炸药束摧毁5辆天灾车。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬要你再替德拉庫魯完成一項任務。|n|n此外，你還要在痛苦聖匣用爆破炸藥炸毀5台血屍車。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12677] = {
  {
    'Materiais perigosos‡Опасные материалы‡Gefährliche Materialien‡위험한 물건‡Materiales arriesgados‡Materiales arriesgados‡Matières dangereuses‡危险的材料‡危險物質',
    nil,
    'Stefan, no Posto Ébano, quer que você vá a Voltarus e complete quaisquer tarefas que Drakuru ordenar. Enquanto você estiver lá, roube 5 Cristais da Praga Colhidos.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡По поручению Стефана с Черной заставы вернитесь в Волтар и продолжайте выполнять поручения Дракуру. Также вам нужно украсть 5 добытых кристаллов гнили.|n|nЕсли вы потеряете свое заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr nach Voltarus geht und all das erledigt, was Drakuru Euch aufgibt. Während Ihr dort seid, sollt Ihr 5 geerntete Seuchenkristalle stehlen.|n|nKehrt zu Stefan in der Schwarzen Wacht zurück, falls Ihr Euren bezauberten Halsreif verlieren solltet, und Ihr werdet Ersatz bekommen.‡칠흑의 감시초소에 있는 스테판이 볼타루스로 가서 드라쿠루가 주는 임무를 완료해 달라고 부탁했습니다. 볼타루스에 있는 동안 채취한 역병 결정 5개를 손에 넣어야 합니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que vayas a Voltarus y completes cualquier tarea que Drakuru tenga para ti. Mientras estés ahí, tienes que robar 5 cristales de añublo recolectados.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan del Puesto de Vigilancia de Ébano quiere que vayas a Voltarus y completes cualquier tarea que Drakuru tenga para ti. Mientras estés ahí, tienes que robar 5 cristales de añublo recolectados.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan en el Puesto de Vigilancia de Ébano para conseguir otra.‡Stefan au Guet d\'Ébène vous a demandé d\'aller à Voltarus et d\'exécuter les ordres de Drakuru. Une fois sur place, vous devez voler 5 Cristaux chancreux récoltés.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡黑锋哨站的斯特凡要你前往沃尔塔鲁斯,并完成达库鲁给予的任务。你还要从那里偷取5块采集到的荒芜水晶。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬要你去沃塔魯斯完成任何德拉庫魯要你做的任務。當你到那裡的時候，要去偷取5個採收的荒疫水晶。|n|n如果你失去了蠱惑頸飾，回去黯黑守望找史戴芬再要一個。',
  }
},
[12678] = {
  {
    'Se o caos dirige, que o sofrimento segure as rédeas‡Когда Хаос правит бал, Страдание заказывает музыку‡Leid wird vom Chaos getrieben‡혼돈이 밀려오면, 고통이 너희를 장악하리라‡Cuando llegue el caos, deja que el sufrimiento tome las riendas‡Cuando llegue el caos, deja que el sufrimiento tome las riendas‡Si le chaos règne, laissons la souffrance tenir les rênes‡混乱战车，苦痛驭之‡混沌所驅，讓苦難控制你的情感',
    nil,
    'O príncipe Valanar, na Vanguarda da Morte, ordena você massacrar 10 Cruzados Escarlates ou Camponeses da Cruzada e 10 Cidadãos da Vila do Amparo.‡Принц Валанар из Разлома Смерти приказал вам убить 10 солдат Алого ордена или 10 крестьян из Алого ордена и 10 граждан Тихоземья.‡Prinz Valanar in der Todesbresche befiehlt Euch, 10 Scharlachrote Kreuzfahrer oder Scharlachrote Arbeiter, und 10 Bürger von Havenau zu töten.‡붉은십자군의 병사나 일꾼 10명, 헤이븐샤이어 시민 10명을 처치한 후 죽음의 틈에 있는 공작 발라나르에게 돌아가야 합니다.‡El príncipe Valanar en la Brecha de la Muerte te ordena que mates a 10 cruzados Escarlata o campesinos Escarlata y a 10 ciudadanos de Villa Refugio.‡El príncipe Valanar en la Brecha de la Muerte te ordena que mates a 10 cruzados Escarlata o campesinos Escarlata y a 10 ciudadanos de Villa Refugio.‡Le Prince Valanar à Brèche-de-Mort vous ordonne de tuer 10 Croisés écarlates ou Paysans écarlates et 10 Citoyens de Havre-comté.‡死亡裂口的瓦拉纳王子命令你击败10个血色十字军战士或血色农夫，以及10个海文郡预备兵。‡死亡止境的瓦拉納爾親王命令你殺死10個血色十字軍或血色農民，以及10個避風郡市民。',
  }
},
[12679] = {
  {
    'Colheita maldita‡Сегодня мы ужинаем в Тихоземье‡Heute Abend speisen wir in Havenau‡오늘 밤 헤이븐샤이어로‡Esta noche cenamos en Villa Refugio‡Esta noche cenamos en Villa Refugio‡Ce soir nous dînons à Havre-comté‡今夜，我们在海文郡欢宴！‡今晚我們在避風郡用餐',
    nil,
    'Orithos, o Anuviador Celeste, da Vanguarda da Morte, quer que você recupere 15 Flechas de Saronita.‡Оритос Затмитель Небес из Разлома Смерти просит вас принести ему 15 саронитовых стрел.‡Orithos der Himmelsverdunkler in der Todesbresche möchte, dass ihr 15 Saronitpfeile beschafft.‡죽음의 틈에 있는 하늘의 암흑인도자 오리토스가 사로나이트 화살 15개를 모아 달라고 부탁했습니다.‡Orithos, el Ensombrecedor del Cielo en Brecha de la Muerte, quiere que recuperes 15 flechas de saronita.‡Orithos, el Ensombrecedor del Cielo en Brecha de la Muerte, quiere que recuperes 15 flechas de saronita.‡Orithos l\'Assombrisseur des cieux à Brèche-de-Mort veut que vous récupériez 15 Flèches en saronite.‡死亡裂口的遮天者奥里索斯要你去回收15支萨隆邪铁箭矢。‡死亡止境的『晦天者』歐里索斯要你回收15枝薩鋼箭。',
  }
},
[12680] = {
  {
    'O grande roubo de cavalos‡Великий угонщик‡Grand Theft Palomino‡위대한 종마 도둑‡El gran robo de Palomino‡El gran robo de Palomino‡Voleurs de chevaux‡阿彻鲁斯战马‡俠盜獵馬手',
    nil,
    'Salanar, o Cavalgante, quer que você roube um cavalo dos Estábulos da Vila do Amparo e o entregue para ele na Vanguarda da Morte.‡Саланар Всадник предложил вам украсть лошадь из Тихоземских стойл и привести ее в Разлом Смерти.‡Salanar der Reiter in der Todesbresche möchte, dass Ihr ein Pferd aus den Ställen von Havenau stehlt und es zu ihm bringt.‡죽음의 틈에 있는 기사 살라나르가 헤이븐샤이어 마구간에서 말을 훔쳐 오라고 했습니다.‡Salanar el Jinete te pide que robes un caballo del Establo de Villa Refugio y lo lleves a la Brecha de la Muerte‡Salanar el Jinete te pide que robes un caballo del Establo de Villa Refugio y lo lleves a la Brecha de la Muerte.‡Salanar le Cavalier vous a demandé de voler un cheval dans l\'Écurie de Havre-comté et de le lui ramener à Brèche-de-Mort.‡骑手萨拉纳尔要你从海文郡马厩中骑上一匹血色战马，然后回到死亡裂口，把马交给他。‡『騎士』撒拉納要你從避風郡獸欄偷來一匹馬，然後回到死亡止境交給他。',
  }
},
[12681] = {
  {
    'Agente dos reagentes‡Агент по реагентам‡Reagenzagent‡시약 전문 요원‡Agente componente‡Agente componente‡Expert en composants‡猎取材料‡試劑專員',
    nil,
    'Traga 5 Gadanhos Retorcidos de Galvo para Colvin Norrington, no Posto Avançado de Dorian.‡Принесите в форпост Дориана 5 изогнутых когтей руха и отдайте Колвину Норрингтону.‡Bringt Colvin Norrington an Dorians Außenposten 5 verdrehte Rocklauen.‡뒤틀린 로크 발톱을 도리안의 전초기지에 있는 콜빈 노링턴에게 가져다주어야 합니다.‡Lleva 5 garras retorcidas de roc a Colvin Norrington en la avanzada de Dorian.‡Lleva 5 garras retorcidas de roc a Colvin Norrington en la avanzada de Dorian.‡Apportez 5 Griffes de roc déformées à Colvin Norrington, à l\'Avant-poste de Dorian.‡将5只扭曲的大鹏爪交给多里安哨站的考尔文·诺灵顿。‡將5個扭曲的大鵬爪帶給多里安前哨的寇爾文·諾靈頓。',
  }
},
[12682] = {
  {
    'Uncharted Territory (DEPRECATED)‡Неразведанная территория (DEPRECATED)‡Unerforschtes Gebiet (DEPRECATED)‡어디에도 없는 지역(미사용)‡Uncharted Territory (DEPRECATED)‡Uncharted Territory (DEPRECATED)‡En territoire inconnu (PÉRIMÉ)‡Uncharted Territory (DEPRECATED)‡人跡未竟之地(DEPRECATED)',
    nil,
    nil,
  }
},
[12683] = {
  {
    'Cuspido e escarrado‡Жгучее желание помочь‡Brenn darauf zu helfen‡돕고 싶어 몸살날 지경‡Ansioso por ayudar‡Ansioso por ayudar‡Une envie brûlante d\'aider‡燃烧的唾液‡十萬火急',
    nil,
    'Colvin Norrington, no Posto Avançado de Dorian, quer que você obtenha 5 Amostras de Escarro da Hidra e mate 5 Hidras Ondamaras.‡Колвин Норрингтон из форпоста Дориана хочет, чтобы вы принесли 5 образцов слюны гидры и убили 5 гидр Горьких Волн.‡Colvin Norrington bei Dorians Außenposten möchte, dass Ihr 5 Proben Hydrasputum sammelt und 5 Bittertidenhydras tötet.‡도리안의 전초기지에 있는 콜빈 노링턴이 거센물결 히드라 5마리를 처치하고 히드라 침 견본 5개를 가져와 달라고 했습니다.‡Colvin Norrington en la avanzada de Dorian quiere que recojas 5 muestras de esputo de hidra y que mates a 5 hidras Olamarga.‡Colvin Norrington en la avanzada de Dorian quiere que recojas 5 muestras de esputo de hidra y que mates a 5 hidras Olamarga.‡Colvin Norrington, à l\'Avant-poste de Dorian, vous a demandé de récupérer 5 Échantillons de glaires d\'hydre et de tuer 5 Hydres Flot-amer.‡多里安哨站的考尔文·诺灵顿要你收集5份多头蛇唾液样本并杀死5只苦潮多头蛇。‡多里安前哨的寇爾文·諾靈頓要你採集5份多頭蛇唾液樣本並殺死5隻惡潮多頭蛇。',
  }
},
[12684] = {
  {
    'Sangue de um deus morto‡Кровь мертвого бога‡Das Blut eines toten Gottes‡죽은 신의 피‡Sangre de un dios muerto‡Sangre de un dios muerto‡Le sang d\'un dieu mort‡死去神灵的血液‡逝神之血',
    nil,
    'Har\'koa pediu para você coletar 7 porções do Sangue de Mam\'toth. Entregue-os a ela no Altar de Har\'koa.‡Соберите 7 колб крови Мам\'тота и принесите их Хар\'коа к алтарю Хар\'коа.‡Har\'koa hat Euch gebeten, 7 Blutproben von Mam\'toth zu sammeln. Bringt sie zu ihr am Altar von Har\'koa.‡맘토스의 피를 7개 모아, 하르코아의 제단에 있는 하르코아에게 가져가십시오.‡Har\'koa te ha pedido que recojas 7 muestras de sangre de Mam\'toth. Llévaselas al Altar de Har\'koa.‡Har\'koa te ha pedido que recojas 7 muestras de sangre de Mam\'toth. Llévaselas al Altar de Har\'koa.‡Har\'koa vous a demandé de récupérer 7 doses de Sang de Mam\'toth. Rapportez-les-lui à l\'Autel de Har\'koa.‡哈克娅要求你收集7份犸托斯之血，并把它们带回哈克娅祭坛交给她。‡哈寇亞要你去收集7個瑪姆托司之血。將它們帶回去哈寇亞祭壇給她。',
  }
},
[12685] = {
  {
    'Aqui se faz, aqui se paga‡Что посеешь, то и пожнешь‡Man erntet, was man sät‡뿌린 대로 거둔다‡Recoges lo que siembras‡Recoges lo que siembras‡On récolte ce qu\'on sème‡种瓜得瓜种豆得豆‡自作自受',
    nil,
    'Mate o Profeta Drenado de Quetz\'lun e depois se apresente ao Mandingueiro Khufu em Zim\'Torga.‡Убейте истощенного пророка Кетц\'лун и доложите об исполнении знахарю Кхуфу из Зим\'Торги.‡Erschlagt den ausgelaugten Propheten von Quetz\'lun und informiert anschließend Hexendoktor Khufu in Zim\'Torga.‡약해진 쿠에츠룬의 예언자를 처치한 다음 짐토르가에 있는 의술사 쿠푸에게 보고해야 합니다.‡Mata al profeta de Quetz\'lun extenuado y luego informa al médico brujo Khufu en Zim\'Torga.‡Mata al profeta de Quetz\'lun extenuado y luego informa al médico brujo Khufu en Zim\'Torga.‡Tuez le Prophète de Quetz\'lun épuisé, puis allez voir le Féticheur Khufu à Zim\'Torga.‡杀死虚弱的奎丝鲁恩先知，然后通知希姆托加的巫医库弗。‡殺死枯竭的奎茲倫預言者然後通知辛托加的巫醫庫弗。',
  }
},
[12686] = {
  {
    'Tolerância zero‡Терпение лопнуло‡Null Toleranz‡관용 따윈 없다‡Tolerancia cero‡Tolerancia cero‡Tolérance zéro‡无法容忍‡忍無可忍',
    nil,
    'Drakuru, em Voltarus, quer que você vá para o Relicário da Dor e use o Cetro de Potencialização em um Serviçal de Drakuru. Depois use as habilidades dele para derrotar Darmuk.‡По поручению Дракуру из Волтара отправляйтесь в Реликварий Боли и примените скипетр Дозволенности к одному из слуг Дракуру. Потом с помощью этого слуги убейте Дармука.‡Drakuru in Voltarus möchte, dass Ihr zum Reliquiar des Schmerzes geht und das Ermächtigungsszepter auf einen Diener von Drakuru anwendet, um anschließend mit seiner Hilfe Darmuk zu töten.‡볼타루스에 있는 드라쿠루가 고통의 성물함으로 내려가 드라쿠루의 하수인에게 권능의 홀을 사용한 후, 그의 기술을 이용해 다르무크를 처치해 달라고 부탁했습니다.‡Drakuru en Voltarus quiere que vayas al Relicario de Dolor y que uses el cetro en el sirviente de Drakuru. Luego tendrás que hacer uso de tus talentos para derrotar a Darmuk.‡Drakuru en Voltarus quiere que vayas al Relicario de Dolor y que uses el cetro en el sirviente de Drakuru. Luego tendrás que hacer uso de tus talentos para derrotar a Darmuk.‡Drakuru à Voltarus veut que vous alliez au Reliquaire de souffrance et que vous utilisiez le Sceptre de renforcement sur un Serviteur de Drakuru. Vous devez alors utiliser ses capacités pour battre Darmuk.‡沃尔塔鲁斯的达库鲁要求你前往痛苦之匣，对一名达库鲁的仆从使用强化节杖，然后使用它的技能击败达穆克。‡沃塔魯斯的德拉庫魯要你前往痛苦聖匣，並且對德拉庫魯的僕從使用活效權杖。接著用它的能力來擊敗達穆克。',
  }
},
[12687] = {
  {
    'No Reino das Sombras‡Путь в Долину Теней‡Ins Reich des Schattens‡어둠의 영역을 향하여‡En el Reino de las Sombras‡En el Reino de las Sombras‡Dans le royaume des ombres‡进入暗影界‡進入陰影之境',
    nil,
    'Salanar, o Cavalgante, na Vanguarda da Morte, desafiou você a matar o Cavalgante Negro de Áquerus e a roubar o Corcel da Morte de Áquerus dele.|n|nSe você tiver sucesso, leve o Corcel da Morte de Áquerus para a Vanguarda da Morte e use o Chamado do Cavaleiro para evocar Salanar.‡Саланар Всадник из Разлома Смерти предложил вам убить темного всадника Акеруса и забрать его скакуна.|n|nЕсли вам удастся совершить это, вернитесь в Разлом Смерти на коне и вызовите Саланара.‡Salanar der Reiter auf der Todesanhöhe hat Euch dazu herausgefordert, einen dunklen Reiter von Acherus zu erschlagen und sein Todesstreitross von Acherus in Eure Gewalt zu bringen.|n|nBringt das Todesstreitross von Acherus auf die Todesanhöhe und lasst den Ruf des Reiters ertönen, um Salanar herbeizurufen.‡죽음의 틈에 있는 기사 살라나르가 아케루스의 암흑 기수를 처치하고 그가 타던 아케루스 죽음의 군마를 죽음의 틈으로 데려오라고 했습니다.|n|n일을 성공적으로 완수했다면, 기사의 부름을 사용하여 살라나르를 불러내야 합니다.‡Salanar el Jinete, en la Brecha de la Muerte, te desafía a matar al jinete oscuro de Acherus y tomar su destrero de la muerte de Acherus.|n|nSi lo consigues, lleva el destrero de la muerte de Acherus a la Brecha de la Muerte y usa la Llamada del jinete para invocar a Salanar.‡Salanar el Jinete, en la Brecha de la Muerte, te desafía a matar al jinete oscuro de Acherus y tomar su destrero de la muerte de Acherus.|n|nSi lo consigues, lleva el destrero de la muerte de Acherus a la Brecha de la Muerte y usa la Llamada del jinete para invocar a Salanar.‡Salanar le Cavalier, à Brèche-de-Mort, vous a mis au défi de tuer le Cavalier noir d\'Achérus et de lui prendre son Destrier de la mort d\'Achérus.|n|nSi vous réussissez, ramenez le Destrier de la mort d\'Achérus à Brèche-de Mort et utilisez l\'Appel du cavalier pour invoquer Salanar.‡死亡裂口的骑手萨拉纳尔要求你去消灭阿彻鲁斯黑暗骑士，并夺走他的阿彻鲁斯死亡战马。|n|n如果你成功地将阿彻鲁斯死亡战马带回死亡裂口，就使用“骑手的召唤”技能召唤萨拉纳尔。‡死亡止境的『騎士』撒拉納要你去挑戰並殺死亞榭洛黑騎兵，然後奪走他的亞榭洛死亡戰騎。|n|n如果你成功了，把亞榭洛死亡戰騎帶回死亡止境，然後用騎士之喚召喚撒拉納。',
  }
},
[12688] = {
  {
    'A engenharia de um desastre‡Проектирование аварии‡Ein Desaster konstruieren‡깔끔한 위기 탈출‡Ingeniería de un desastre‡Ingeniería de un desastre‡Orchestrer un désastre‡工程师的逃亡‡設計工程災難',
    nil,
    'Ajude a Engenheira Halice a escapar da Escavação do Caloteiro e fale com Rosarães Guima, no Acampamento do Rosarães.‡Помогите инженеру Хелис сбежать из Раскопа Хитрохмыла, а затем поговорите с Хемингом Эрнестуэем в лагере Эрнестуэя.‡Helft Ingenieurin Helice, aus Schwindelgrins\' Grabungsstätte zu entkommen, und sprecht dann mit Hemet Nesingwary in Nesingwarys Basislager.‡기술자 헬리스가 스윈들그린의 채굴현장에서 빠져나오도록 도운 다음, 네싱워리 주둔지에 있는 헤멧 네싱워리와 대화해야 합니다.‡Ayuda la ingeniera Hélice a escapar de la Excavación de Timomueca y luego habla con Hemet Nesingwary en el Campamento Base de Nesingwary.‡Ayuda la ingeniera Hélice a escapar de la Excavación de Timomueca y luego habla con Hemet Nesingwary en el Campamento Base de Nesingwary.‡Aidez l\'Ingénieur Hélice à s\'enfuir du Site de fouilles de Ricarnaque, puis parlez avec Hemet Nesingwary au Camp de base de Nesingwary.‡护送工程师赫莉丝逃离斯温迪格林挖掘场，然后与奈辛瓦里营地的赫米特·奈辛瓦里谈一谈。‡幫助工程師海里斯從詐咧挖掘場逃脫，然後到奈辛瓦里營地找赫米特·奈辛瓦里談話。',
  }
},
[12689] = {
  {
    'A mão dos oráculos‡Длань Оракулов‡Hand der Orakel‡점쟁이 조합과 손잡기‡Mano de los Oráculos‡Mano de los Oráculos‡La main des oracles‡神谕者之手‡神諭者之手',
    nil,
    nil,
  }
},
[12690] = {
  {
    'Lenha para a fogueira‡Нам это на руку‡Brennstoff‡불에 기름 붓기‡Combustible para el fuego‡Combustible para el fuego‡Alimenter le feu‡火上浇油‡火上加油',
    nil,
    'Drakuru, em Voltarus, quer que você use o Cetro do Comando nas Abominações Inchadas. Depois, use as habilidades delas no Pontal Frio para matar 60 Quebra-crânios Drakkari e atrair 3 Chefes Drakkari.|n|nOs chefes aparecerão depois que você matar um certo número de Quebra-crânios.‡По поручению Дракуру из Волтара с помощью скипетра властности получите контроль над раздувшимися поганищами. С их помощью у Хладного разлома убейте 60 дробителей черепов Драккари, чтобы выманить 3 вождей племени.|n|nВожди появятся, когда будет убито достаточно дробителей черепов.‡Drakuru in Voltarus möchte, dass Ihr das Szepter des Befehls auf die aufgeblähten Monstrositäten anwendet und dann ihre Fähigkeiten dazu einsetzt, um 60 Schädelberster der Drakkari zu töten und 3 Häuptlinge der Drakkari hervorzulocken.|n|nDie Häuptlinge tauchen erst dann auf, wenn genug Schädelberster getötet wurden.‡볼타루스에 있는 드라쿠루가 지배의 홀로 비대한 누더기골렘에게 명령을 내려 얼어붙은 틈에 있는 드라카리 해골분쇄자 60마리를 처치하고, 그 와중에 나타나는 드라카리 족장을 3마리 꾀어내달라고 부탁했습니다.‡Drakuru en Voltarus quiere que uses el cetro de mando en abominaciones hinchadas y que hagas uso de sus talentos en la Brecha Gélida para matar a 60 trituracráneos Drakkari y que captures a 3 cabecillas Drakkari.|n|nLos cabecillas aparecerán cuando hayas matado suficientes trituracráneos.‡Drakuru en Voltarus quiere que uses el cetro de mando en abominaciones hinchadas y que hagas uso de sus talentos en la Brecha Gélida para matar a 60 trituracráneos Drakkari y que captures a 3 cabecillas Drakkari.|n|nLos cabecillas aparecerán cuando hayas matado suficientes trituracráneos.‡Drakuru à Voltarus veut que vous utilisiez le Sceptre de commandement sur des Abominations boursouflées et que vous utilisiez leurs capacités dans la Brèche algide pour tuer 60 Brise-tête drakkari et attirer 3 Chefs drakkari.|n|nLes chefs apparaîtront lorsque vous aurez tué suffisamment de Brise-têtes.‡沃尔塔鲁斯的达库鲁要求你对浮肿的憎恶使用命令节杖，然后利用它们的能力在冰冷裂口击败60名达卡莱裂颅者，并将3名达卡莱酋长引诱出来。|n|n只要击败足够数量的达卡莱裂颅者，酋长们就会出现。‡沃塔魯斯的德拉庫魯要你用指揮權杖控制浮腫的憎惡體，然後在嚴寒止境用他們的能力殺死60個德拉克瑞碎顱者，並引出3個德拉克瑞酋長。|n|n當你殺死夠多碎顱者之後酋長就會出現。',
  }
},
[12691] = {
  {
    'O cofre envelhecido‡Старинный сундук‡Eine verwitterte Kiste‡오래된 궤짝‡Una arca estropeada por el tiempo‡Una arca estropeada por el tiempo‡Un coffre vétuste‡古旧的石箱‡古舊的石箱',
    nil,
    'Obtenha uma Grande Chave de Pedra com os Guardiões de Sholazar e traga-a para o Cofre Envelhecido no Mirante dos Criadores.‡Добудьте у стражей Шолазара огромный каменный ключ и старинный откройте сундук, который вы нашли в Дозоре Творцов.‡Erbeutet einen gewaltigen, steinernen Schlüssel von einem der Sholazarwächter in der Nähe und bringt ihn zur verwitterten Kiste bei der Warte der Schöpfer.‡근처에 있는 숄라자르 수호자에게서 커다란 돌 열쇠를 구한 다음, 오래된 궤짝이 있는 창조주의 전망대로 가져가야 합니다.‡Consigue una llave de piedra enorme de los guardianes de Sholazar y tráela al arca estropeada por el tiempo en el Mirador de los Creadores.‡Consigue una llave de piedra enorme de los guardianes de Sholazar y tráela al arca estropeada por el tiempo en el Mirador de los Creadores.‡Obtenez une Énorme clé en pierre d\'un des gardiens de Sholazar à proximité, et rapportez-la au Coffre vétuste au Surplomb du Faiseur.‡从索拉查卫士身上取得巨型石钥匙，用它打开造物者悬台上的古旧石箱。‡從附近的休拉薩守護者身上取得巨型石頭鑰匙然後帶到造物者瞰臺的古舊石箱處。',
  }
},
[12692] = {
  {
    'O retorno do caçador de lich‡Возвращение охотника на личей‡Rückkehr des Lichjägers‡리치 사냥꾼의 귀환‡El retorno del cazador de exánimes‡El retorno del cazador de exánimes‡Le retour du chasseur de liches‡巫妖猎手归来‡巫妖獵人的歸來',
    nil,
    'Volte ao Morro dos Feralma e fale com o Ancião Harkek.‡Вернитесь на холм Бешеного Сердца и поговорите со старейшиной Харкеком.‡Kehrt zum Hügel der Wildherzen zurück und sprecht mit dem Ältesten Harkek.‡광란의심장 언덕으로 돌아가 장로 하르케크와 대화해야 합니다.‡Vuelve a la Colina Corazón Frenético y habla con el anciano Harkek.‡Vuelve a la Colina Corazón Frenético y habla con el anciano Harkek.‡Retournez à la Colline de Frénécœur et parlez à l\'ancien Harkek.‡返回狂心岭，与长者哈尔卡克谈一谈。‡返回狂心之丘，並與長者哈爾凱克交談。',
  }
},
[12693] = {
  {
    '‡Отслеживатель выбора фракции волчеров‡Wolvar-Fraktionswahl Fährtenleser‡울바르 진영 선택 추적‡Wolvar Faction Choice Tracker‡Wolvar Faction Choice Tracker‡Suivi du choix de faction (varleu)‡狼獾人阵营‡狼獾人陣營',
    nil,
    nil,
  }
},
[12694] = {
  {
    '‡Отслеживатель выбора фракции оракулов‡Orakel-Fraktionswahl Fährtenleser‡점쟁이 조합 선택 추적‡Oracle Faction Choice Tracker‡Oracle Faction Choice Tracker‡Suivi du choix de faction (oracle)‡神谕者阵营‡神諭者陣營',
    nil,
    nil,
  }
},
[12695] = {
  {
    'O retorno do amistoso pelesseca‡Возвращение сухой шкуры‡Rückkehr der netten Trockenhaut‡친절한 뽀송피부 씨‡El retorno del pielseca amistoso‡El retorno del pielseca amistoso‡Le retour du peau-sèche gentil‡友善的干燥皮肤朋友‡友善乾皮的歸來',
    nil,
    'Retorne às Frondes Voz-da-chuva e fale com o Sumo Oráculo Soo-say.‡Вернитесь в прибежище Гласа Дождя и поговорите с верховным оракулом Су-сэем.‡Kehrt zum Baldachin der Regenrufer zurück und sprecht mit dem Hochorakel Soo-say.‡구름몰이 거처에 있는 대점쟁이 수세이와 대화해야 합니다.‡Regresa a la Espesura Hablalluvia y habla con el sumo Oráculo Soo-pinstán.‡Regresa al Canope de Hablalluvia y habla con el sumo Oráculo Soo-pinstán.‡Retournez à la Canopée Parlepluie et parlez au Haut-oracle Soo-pape.‡返回雨声树屋，与高阶神谕者索乌塞谈一谈。‡返回雨頌者之蓬，並且與高階神諭者蘇-楔交談。',
  }
},
[12696] = {
  {
    'Inspeção aérea‡Воздушная разведка‡Luftüberwachung‡공중 정찰‡Reconocimiento aéreo‡Reconocimiento aéreo‡Surveillance aérienne‡空中侦察‡空中監視',
    nil,
    'A Professora Calvert quer que você pegue o voo para o Giroporto do Lago e fale com o Piloto Vic quando chegar lá.‡Профессор Кальверт хочет, чтобы вы полетели в лагерь у озера и там поговорили с пилотом Виком.‡Professorin Kalvert möchte, dass Ihr den Flug zum Landeplatz am See nehmt und dort mit Pilot Vic sprecht.‡학자 칼버트가 호반의 착륙장으로 가서 조종사 빅과 대화하라고 했습니다.‡La profesora Calvert quiere que cojas el vuelo a la Pista del Lago y que hables con el piloto Vic.‡La profesora Calvert quiere que cojas el vuelo a la Pista del Lago y que hables con el piloto Vic.‡Le Professeur Calvert veut que vous preniez le vol pour le Terrain d\'atterrissage de Rive-du-lac, et que vous parliez au Pilote Vic une fois rendu là-bas.‡卡尔维特教授要你飞往湖边着陆场，与飞行员维克谈一谈。‡卡爾微特教授要你飛到湖畔起降場與駕駛員維克交談。',
  }
},
[12697] = {
  {
    'Gothik, o Ceifador‡Готик Жнец‡Gothik der Ernter‡영혼 착취자 고딕‡Gothik el Cosechador‡Gothik el Cosechador‡Gothik le Moissonneur‡收割者戈提克‡『收割者』高希',
    nil,
    'Fale com Gothik, o Ceifador, na Vanguarda da Morte.‡Поговорите с Готиком Жнецом в Разломе Смерти.‡Sprecht mit Gothik dem Ernter in der Todesbresche.‡죽음의 틈에 있는 영혼 착취자 고딕과 대화해야 합니다.‡Habla con Gothik el Cosechador en la Brecha de la Muerte.‡Habla con Gothik el Cosechador en la Brecha de la Muerte.‡Parler avec Gothik le Moissonneur à Brèche-de-Mort.‡与死亡裂口的收割者戈提克谈一谈。‡與死亡止境的『收割者』高希交談。',
  }
},
[12698] = {
  {
    'O aspirador de almas‡Подарок с подвохом‡Das Geschenk, das nicht aufhört zu schenken‡아낌없이 뿌리리라‡La ofrenda que sigue dando‡La ofrenda que sigue dando‡Le don continu‡收割者的礼物‡好禮送不完',
    nil,
    'Gothik, o Ceifador, na Vanguarda da Morte, deu a você a Dádiva do Ceifador para usar nos Mineradores da Cruzada. Crie 5 Carniçais Escarlates com o dispositivo e entregue os carniçais a Gothik.‡Готик Жнец из Разлома Смерти передал вам Дар Жнеца, с помощью которого вам надо обратить 5 шахтеров из Алого ордена в вурдалаков. Выполнив это поручение, верните прибор Жнецу.‡Gothik der Ernter in der Todesbresche hat Euch die Gabe des Ernters gegeben, um sie gegen die Scharlachroten Minenarbeiter einzusetzen. Erschafft mithilfe des Geräts 5 Scharlachrote Ghule und kehrt anschließend zu Gothik zurück.‡죽음의 틈에 있는 영혼 착취자 고딕이 준 영혼 착취자의 선물을 붉은십자군 광부에게 사용하여 만든 붉은십자군 구울 5마리를 이끌고 고딕에게 돌아가야 합니다.‡Gothik el Cosechador en Brecha de la Muerte te ha dado el regalo del Cosechador para usarlo con los mineros escarlatas. Crea 5 necrófagos escarlata con este dispositivo y lleva los necrófagos a Gothik.‡Gothik el Cosechador en Brecha de la Muerte te ha dado el regalo del Cosechador para usarlo con los mineros escarlatas. Crea 5 necrófagos escarlata con este dispositivo y lleva los necrófagos a Gothik.‡Gothik le Moissonneur à Brèche-de-Mort vous a remis le Don du moissonneur pour que vous l\'utilisiez contre les Mineurs écarlates. Créez 5 Goules écarlates avec l\'appareil et rapportez-les à Gothik.‡死亡裂口的收割者戈提克让你对血色矿工使用收割者的礼物，制造出5个被控制的血色矿工之后向戈提克复命。‡死亡止境的『收割者』高希交給你收割者的禮物，要你用在血色礦工身上。用這個裝置製造5個血色食屍鬼，然後把食屍鬼帶去給高希。',
  }
},
[12699] = {
  {
    'Um incidente embaraçoso‡Затруднительное положение‡Der peinliche Vorfall‡당황스러운 사건‡Un incidente embarazoso‡Un incidente embarazoso‡C\'est un peu embarrassant…‡尴尬的处境‡難堪的插曲',
    nil,
    'Procure as Chaves do Vic dentro do lago do Coração do Rio.‡Поищите ключи Вика в Слиянии рек.‡Sucht nach Vics Schlüssel im See am Flussnabel.‡강의 심장부에 있는 호수 밑에서 빅의 열쇠를 찾아야 합니다.‡Busca las llaves de Vic dentro del lago en el Corazón del Río.‡Busca las llaves de Vic dentro del lago en el Corazón del Río.‡Cherchez les Clés de Vic dans le lac du Cœur du fleuve.‡在河流之心的湖泊中寻找维克的钥匙。‡在大河之心的湖水中尋找維克的鑰匙串。',
  }
},
[12700] = {
  {
    'Um golpe de oportunismo‡Момент для атаки‡Gelegenheitsangriff‡공격 기회‡Un ataque de oportunidad‡Un ataque de oportunidad‡Une occasion d\'attaquer‡伺机待发‡趁勢攻擊',
    nil,
    'Fale com o príncipe Valanar na Vanguarda da Morte.‡Поговорите с принцем Валанаром в Разломе Смерти.‡Sprecht mit Prinz Valanar in der Todesbresche.‡죽음의 틈에 있는 공작 발라나르와 대화해야 합니다.‡Habla con el príncipe Valanar en la Brecha de la Muerte.‡Habla con el príncipe Valanar en la Brecha de la Muerte.‡Parlez au Prince Valanar à Brèche-de-Mort.‡与死亡裂口的瓦拉纳王子谈一谈。‡與死亡止境的瓦拉納爾親王交談。',
  }
},
[12701] = {
  {
    'Massacre no Pontal da Luz‡Побоище у Заставы Света‡Massaker am Lichtgipfel‡빛의 거점 대학살‡Masacre en la Punta de la Luz‡Masacre en la Punta de la Luz‡Massacre à la halte de la Lumière‡炮轰圣光哨站‡聖光之尖大屠殺',
    nil,
    'O príncipe Valanar, na Vanguarda da Morte, quer que você massacre 100 Defensores Escarlates.‡Принц Валанар из Разлома Смерти приказал вам убить 100 защитников из Алого ордена.‡Prinz Valanar in der Todesbresche hat Euch befohlen, 100 Scharlachrote Verteidiger zu vernichten.‡죽음의 틈에 있는 공작 발라나르가 붉은십자군 호위병 100명을 처치하라고 명령했습니다.‡El príncipe Valanar, en la Brecha de la Muerte, te ha ordenado que mates a 100 defensores Escarlata.‡El príncipe Valanar, en la Brecha de la Muerte, te ha ordenado que mates a 100 defensores Escarlata.‡Le Prince Valanar à Brèche-de-Mort vous a ordonné de massacrer 100 Défenseurs écarlates.‡死亡裂口的瓦拉纳王子命令你去打倒100个血色防御者。‡死亡止境的瓦拉納爾親王命令你殺死100個血色防衛者。',
  }
},
[12702] = {
  {
    'Festa das galinhas!‡И снова цыплята!‡Hühnerparty!‡닭 잡으러 나간다!‡¡Fiesta de pollos!‡¡Fiesta de pollos!‡Des poulets et des varleus‡抓鸡狂欢节！‡雞派對!',
    nil,
    'Capture 12 Galinhas Desgarradas para o Ancião Harkek, no Morro dos Feralma.‡Поймайте 12 сбежавших кур для старейшины Харкека с холма Бешеного Сердца.‡Fangt 12 entflohene Hühner für Ältesten Harkek auf dem Hügel der Wildherzen.‡광란의심장 언덕에 있는 장로 하르케크가 부탁한 대로 도망친 닭 12마리를 잡아야 합니다.‡Captura 12 pollos fugitivos para el anciano Harkek en la Colina Corazón Frenético.‡Captura 12 pollos fugitivos para el anciano Harkek en la Colina Corazón Frenético.‡L\'Ancien Harkek à la Colline de Frénécœur vous a demandé de capturer 12 Poulets évadés.‡狂心岭的长者哈尔卡克要你去捕捉12只逃走的小鸡。‡給狂心之丘的長者哈爾凱克逮住12隻逃跑雞。',
  }
},
[12703] = {
  {
    'O alvoroço de Kartak‡Буйство Картака‡Kartaks Wut‡광포한 카르탁‡La locura de Kartak‡La locura de Kartak‡Le massacre de Kartak‡卡塔克的愤怒‡卡爾塔克的衝撞',
    nil,
    'Traga uma amostra de Sangue de Oráculo para o Altar de Kartak para evocar Kartak. Com a ajuda dos poderes de Kartak, mate 50 Gorlocs de Piscabrilha para o Xamã Jakjek, na Aldeia de Kartak.‡Принесите чистый образчик Крови Оракула к алтарю Картака, чтобы призвать Картака. Используя его силу, уничтожьте 50 горлоков из племени Заиндевелых по просьбе шамана Джакжека в форте Картака.‡Bringt eine reine Probe vom Blut der Orakel zum Altar von Kartak, um Kartak zu beschwören. Mit der Hilfe von Kartaks geteilten Kräften sollt Ihr für Schamanen Jakjek in Kartaks Stellung 50 in der Nähe befindliche, funkenbesprühte Gorlocs töten.‡순수한 점쟁이 혈액을 카르탁의 요새에 있는 카르탁의 제단으로 가져가서 카르탁을 소환해야 합니다. 카르탁의 요새에 있는 주술사 자크제크가 부탁한 대로, 카르탁의 힘을 나눠 받아 주변에 있는 번개불꽃골록 50마리를 처치하십시오.‡Lleva una muestra pura de sangre del Oráculo al altar de Kartak para invocar a Kartak. Con la ayuda de los poderes compartidos de Kartak, mata a 50 de los górlocs Pavesa para el Chamán Jakjek en el Bastión de Kartak.‡Lleva una muestra pura de sangre del Oráculo al altar de Kartak para invocar a Kartak. Con la ayuda de los poderes compartidos de Kartak, mata a 50 de los górlocs Pavesa para el Chamán Jakjek en el Bastión de Kartak.‡Trouvez un échantillon pur de Sang d\'oracle et apportez-le à l\'autel de Kartak pour invoquer Kartak.|n|nAvec l\'aide des pouvoirs de Kartak, massacrez 50 Gorlocs touchétincelles pour le Chaman Jakjek au Bastion de Kartak.‡将1份纯净的神谕者的血带去卡塔克的祭坛，召唤出卡塔克。借助他的力量在祭坛附近杀死50个灵鳍鳄鱼人，然后向卡塔克要塞的萨满祭司亚克耶克复命。‡將純淨的神諭者之血樣本帶到卡爾塔克的祭壇，召喚出卡爾塔克。只要有卡爾塔克分享力量的幫助，替卡爾塔克堡的薩滿賈克杰克殺死附近50個炫觸戈洛克。',
  }
},
[12704] = {
  {
    'Acalmando a grande pedra da chuva‡Умиротворение Великого камня дождя‡Besänftigung des großen Regensteins‡거대한 비 바위 진정시키기‡Apaciguar la Gran Piedra de Lluvia‡Apaciguar la Gran Piedra de Lluvia‡Apaiser la pierre à Pluie toute-puissante‡取悦雨水巨石‡取悅偉大雨石',
    nil,
    'O Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva, quer que você leve um companheiro para cavar e coletar 6 Tesouros Brilhantes.|n|nNão deixe de falar com o Sumo Oráculo Soo-say, nas Frondes Voz-da-chuva, sobre garantir a ajuda de um dos seus companheiros anteriores.‡По просьбе верховного оракула Су-сэя из прибежища Гласа Дождя выберите себе спутника и с его помощью выкопайте 6 сверкающих сокровищ.|n|nОбязательно поговорите с верховным оракулом Су-сэем в прибежище Гласа Дождя, чтобы заручиться поддержкой кто-то из ваших прежних спутников.‡Das Hochorakel Soo-say im Baldachin der Regenrufer möchte, dass Ihr einen Gefährten auswählt und 6 glänzende Kostbarkeiten sammelt.|n|nSprecht noch einmal mit dem Hochorakel Soo-say, um Euch die Hilfe eines Eurer früheren Gefährten zusichern zu lassen.‡구름몰이 거처에 있는 대점쟁이 수세이가 동료를 데리고 반짝이는 보물 6개를 파내라고 했습니다.|n|n구름몰이 거처에 있는 대점쟁이 수세이에게 이전 동료 하나가 도와주었다는 얘기를 반드시 해야 합니다.‡El sumo Oráculo Soo-pinstán, dla Espesura Hablalluvia, quiere que elijas un compañero para escavar y conseguir 6 tesoros lustrosos.|n|nAsegúrate de hablar con el sumo Oráculo Soo-pinstán en la Espesura Hablalluvia para conseguir la ayuda de uno de tus anteriores compañeros.‡El sumo Oráculo Soo-pinstán, del Canope de Hablalluvia, quiere que elijas un compañero para excavar y conseguir 6 tesoros lustrosos.|n|nAsegúrate de hablar con el sumo Oráculo Soo-pinstán en el Canope de Hablalluvia para conseguir la ayuda de uno de tus anteriores compañeros.‡Le Haut-oracle Soo-pape de la Canopée Parlepluie vous a demandé de récupérer 6 Trésors parmi ceux déterrés par votre compagnon.|n|nAllez parler au Haut-oracle Soo-pape à la Canopée Parlepluie pour obtenir l\'aide d\'un de vos anciens compagnons.‡雨声树屋的高阶神谕者索乌塞要你带上一名同伴，挖掘并收集6份闪闪发亮的宝贝。|n|n记得与雨声树屋的高阶神谕者索乌塞谈谈关于帮手的事。‡雨頌者之篷的高階神諭者蘇-楔要你帶著一個同伴挖掘收集6個閃亮的財寶。|n|n記得向雨頌者之蓬的高階神諭者蘇-楔要你先前的同伴。',
  }
},
[12705] = {
  {
    'Vontade dos titãs‡Воля Титанов‡Wille der Titanen‡티탄의 의지‡Voluntad de los titanes‡Voluntad de los titanes‡La volonté des titans‡泰坦的意志‡泰坦的意志',
    nil,
    'Tome um Cristal Maculado dos guaxinantes perto do Refúgio Piscabrilha e leve-o para a Grande Pedra de Relâmpagos, para chamar Soo-holu. Com a ajuda dos poderes de Soo-holu, mate 50 guaxinantes Feralma e fale com o Traztrovão Soo-met, perto da Grande Pedra de Relâmpagos.‡Добудьте зараженный кристалл у одного из волчеров, что водятся рядом с Заиндевевшей гаванью и принесите его к великому камню молний, чтобы вызвать Со-холу. С помощью Со-холу убейте 50 находящихся поблизости волчеров Бешеного Сердца, после чего вернитесь к призывателю Су-мету в Заиндевелую гавань.‡Erlangt einen getrübten Kristall von den Wolvar in der Nähe der Zuflucht der Funkenbesprühten und bringt ihn zum großen Blitzstein, um Soo-holu zu beschwören. Tötet mithilfe Soo-holus geteilter Macht 50 in der Nähe befindliche Wolvar der Wildherzen und kehrt anschließend zu Blitzrufer Soo-met in der Nähe des großen Donnersteins zurück.‡번개불꽃 안식처 근처에 있는 울바르에게서 오염된 수정을 구해 거대한 번개 바위로 가져가 수홀루를 불러내십시오. 수홀루의 힘을 나눠 받아 가까이에 있는 광란의심장일족 울바르 50마리를 처치한 다음, 거대한 번개 바위 근처에 있는 번개부름이 수멧에게 돌아가야 합니다.‡Consigue un cristal máculo de los wolvar cerca de Retiro Pavesa y llévalo a la Gran Piedra de Rayos para invocar a Soo-brada. Con la ayuda de los poderes compartidos de Soo-brada, mata a 50 de los wolvar Corazón Frenético cercanos, después vuelve junto al Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Consigue un cristal máculo de los wolvar cerca de Retiro Pavesa y llévalo a la Gran Piedra de Rayos para invocar a Soo-brada. Con la ayuda de los poderes compartidos de Soo-brada, mata a 50 de los wolvar Corazón Frenético cercanos, después vuelve junto al Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Récupérez un Cristal corrompu sur les varleus du Havre Touchétincelle. Rapportez-le à la Pierre à foudre toute-puissante pour demander l\'aide de Soo-palonion. Grâce aux pouvoirs de Soo-palonion, tuez 50 Varleus frénécœurs. Une fois la tâche achevée, parlez au Mandefoudre Soo-briquet au Havre Touchétincelle.‡从灵鳍湾附近的狼獾人身上取得1块被污染的水晶，将它带去闪电巨石处，召唤出索乌霍鲁。借助他的力量在神祠附近杀死50个狂心狼獾人，然后向灵鳍湾的唤雷者索乌米特复命。‡從炫觸避風港附近的獾狼怪身上取得一塊受污染的水晶，並帶往偉大閃電石召喚蘇-侯魯。在蘇-侯魯所分享的力量幫助下，殺死50個附近的狂心獾狼怪，然後向偉大閃電石附近的喚雷者蘇-邁特回報。',
  }
},
[12706] = {
  {
    'Vitória na Vanguarda da Morte‡Победа у Разлома Смерти‡Sieg an der Todesbresche!‡죽음의 틈에서 거둔 승리!‡¡Victoria en la Brecha de la Muerte!‡¡Victoria en la Brecha de la Muerte!‡Victoire à Brèche-de-Mort !‡死亡裂口大捷！‡死亡止境的勝利!',
    nil,
    'Entregue o Relatório do Príncipe Valanar para o Grão-lorde Dárion Mograine em Áquerus: a Fortaleza de Ébano.‡Доставьте доклад принца Валанара верховному лорду Дариону Могрейну в Акерус: Черный оплот.‡Liefert Prinz Valanars Bericht bei Hochlord Darion Mograine in Acherus: der Schwarzen Festung ab.‡아케루스: 칠흑의 요새에 있는 대영주 다리온 모그레인에게 공작 발라나르의 보고서를 전달해야 합니다.‡Entrega el informe del príncipe Valanar al alto señor Darion Mograine en Acherus: El Bastión de Ébano.‡Entrega el informe del príncipe Valanar al alto señor Darion Mograine en Acherus: El Bastión de Ébano.‡Livrez le Rapport du prince Valanar au Généralissime Mograine dans Achérus : le fort d\'Ébène.‡将瓦拉纳王子的报告交给黑锋要塞阿彻鲁斯的大领主达里安·莫格莱尼。‡把瓦拉納爾親王的報告交給亞榭洛:黯黑堡中的大領主達瑞安·莫格萊尼。',
  }
},
[12707] = {
  {
    'Revolta dos cabeludos‡Яростное правосудие‡Wollige Gerechtigkeit‡매머드의 정의‡El peso de la justicia‡El peso de la justicia‡Justice laineuse‡猛犸的复仇‡毛茸茸的正義',
    nil,
    'Escalpelador Ahunae, em Zim\'Torga, quer que você use o Medalhão de Mam\'toth para acalmar um Mamute Enfurecido e cavalgar nele. Depois, você deve pisotear 12 Discípulos de Mam\'toth até a morte.‡По поручению Ауне из Зим\'торги используйте медальон Мам\'тота, чтобы успокоить одного из разъяренных мамонтов и забраться к нему на спину. Затем затопчите насмерть 12 послушников Мам\'тота.‡Skalpierer Ahunae in Zim\'Torga möchte, dass Ihr mithilfe des Medaillons von Mam\'toth ein tobendes Mammut beruhigt, um dann auf ihm zu reiten. Anschließend sollt Ihr 12 Jünger von Mam\'toth zu Tode trampeln.‡짐토르가에 있는 무두장이 아훈네가 분노한 매머드를 맘토스의 메달로 진정시킨 다음, 그 위에 올라 맘토스 신도 12명을 처치하라고 부탁했습니다.‡El arrancacabelleras Ahunae de Zim\'Torga quiere que uses el medallón de Mam\'toth para calmar y montar sobre un mamut enfurecido. Luego quiere que pisotees 12 discípulos de Mam\'toth hasta que mueran.‡El arrancacabelleras Ahunae de Zim\'Torga quiere que uses el medallón de Mam\'toth para calmar y montar sobre un mamut enfurecido. Luego quiere que pisotees 12 discípulos de Mam\'toth hasta que mueran.‡Le Scalpeur Ahunae à Zim\'Torga vous a demandé d\'utiliser le Médaillon de Mam\'toth pour calmer et chevaucher un Mammouth enragé. Vous devez ensuite piétiner à mort 12 Disciples de Mam\'toth.‡希姆托加的剥皮师埃霍奈希望你使用犸托斯勋章让被激怒的猛犸象冷静下来，然后骑乘它去消灭12个犸托斯信徒。‡辛托加的割顱者艾胡奈要你使用瑪姆托司勳章安撫一頭暴怒的長毛象，然後騎上牠將12個瑪姆托司信徒踐踏至死。',
  }
},
[12708] = {
  {
    'Guerreiros da Carranca Encantados‡Заколдованные воины Тики‡Verzauberte Tikikrieger‡마력 깃든 티키 전사‡Guerreros Tiki encantados‡Guerreros Tiki encantados‡Guerriers tiki enchantés‡魔化蒂基面具战士‡附魔提基戰士',
    nil,
    'A Domadora de Elementos, em Zim\'Torga, pediu para você matar 12 Guerreiros da Carranca Encantados.‡По заданию укротителя стихий Дагоды из Зим\'Торги уничтожьте 12 заколдованных воинов Тики.‡Elementzähmerin Dagoda in Zim\'Torga möchte, dass Ihr 12 verzauberte Tikikrieger zerstört.‡짐토르가에 있는 정령조련사 다고다가 마력 깃든 티키 전사 12개를 파괴해 달라고 했습니다.‡La domadora de elementos Dagoda en Zim\'Torga te ha pedido que acabes con 12 guerreros Tiki encantados.‡La domadora de elementos Dagoda en Zim\'Torga te ha pedido que acabes con 12 guerreros Tiki encantados.‡La Dompteuse des éléments Dagoda à Zim\'Torga vous a demandé de détruire 12 Guerriers tiki enchantés.‡希姆托加的元素驯服者德苟达要求你消灭12名魔化蒂基面具战士。‡辛托加的元素馴伏者達茍答要你消滅12個附魔提基戰士。',
  }
},
[12709] = {
  {
    'Baús bagateados‡Проклятые тайники‡Verhexte Behälter‡주술 걸린 귀중품‡Alijos embrujados‡Alijos embrujados‡Les caches ensorcelées‡妖术宝箱‡中了妖術的儲藏箱',
    nil,
    'O Cronista To\'kini, em Zim\'Torga, pediu para você se apoderar de 12 Baús da Fortaleza de Zol\'Maz.‡Принесите летописцу То\'кини в Зим\'Торгу 12 трофеев из крепости Зол\'Маза.‡Chronist To\'kini in Zim\'Torga möchte, dass Ihr 12 Behälter der Festung Zol\'Maz sammelt.‡짐토르가에 있는 기록가 토키니가 졸마즈 요새 귀중품 12개를 가져다 달라고 부탁했습니다.‡El cronista To\'kini en Zim\'Torga te ha pedido que consigas 12 alijos del Bastión de Zol\'Maz.‡El cronista To\'kini en Zim\'Torga te ha pedido que consigas 12 alijos del Bastión de Zol\'Maz.‡Le Chroniqueur To\'kini à Zim\'Torga vous a demandé d\'obtenir 12 Caches du bastion de Zol\'Maz.‡希姆托加的记载者图基尼要求你为他夺取12只佐尔玛兹要塞宝箱。‡辛托加的撰史者托基尼要你收集12個佐爾馬茲堡砦貯藏箱。',
  }
},
[12710] = {
  {
    'Revelação‡Открытая тайна‡Enthüllung‡폭로‡Revelación‡Revelación‡Révélation‡真相大白‡揭露真相',
    nil,
    'Drakuru, em Voltarus, quer que você use o teleportador para a câmara superior.‡Телепортируйтесь в верхний зал Дракуру в Волтаре.‡Drakuru in Voltarus möchte, dass Ihr den Teleporter benutzt, der in sein oberes Gemach führt.‡볼타루스에 있는 드라쿠루가 순간이동기를 사용해 볼타루스 상층 방으로 이동해 달라고 부탁했습니다.‡Drakuru en Voltarus quiere que cojas el teletransportador hasta su cámara superior.‡Drakuru en Voltarus quiere que cojas el teletransportador hasta su cámara superior.‡Drakuru à Voltarus veut que vous vous téléportiez jusqu\'à la chambre supérieure.‡沃尔塔鲁斯的达库鲁要求你通过传送器前往他的上层密室。‡沃塔魯斯的德拉庫魯要你傳送至他的上層房間。',
  }
},
[12711] = {
  {
    'Cartas abandonadas‡Заброшенный почтовый ящик‡Herrenlose Post‡버려진 편지‡Mensaje abandonado‡Mensaje abandonado‡Du courrier abandonné‡被遗弃的信件‡被遺棄的信件',
    nil,
    nil,
  }
},
[12712] = {
  {
    'A chave do Senhor da Guerra Zol\'Maz‡Ключ полководца Зол\'Маза‡Der Schlüssel des Kriegslords Zol\'Maz‡장군 졸마즈의 열쇠‡La llave del señor de la guerra Zol\'Maz‡La llave del señor de la guerra Zol\'Maz‡La clé du seigneur de guerre Zol\'Maz‡督军佐尔玛兹的钥匙‡督軍佐爾馬茲的鑰匙',
    nil,
    'Har\'koa, em Zim\'Torga, pediu para você se apoderar da Chave do senhor da guerra Zol\'Maz.‡Раздобудьте ключ полководца Зол\'Маза для Хар\'коа из Зим\'Торги.‡Har\'koa in Zim\'Torga möchte, dass Ihr den Schlüssel des Kriegslords Zol\'Maz beschafft.‡짐토르가에 있는 하르코아가 장군 졸마즈의 열쇠를 구해 달라고 부탁했습니다.‡Har\'koa de Zim\'Torga te ha pedido que consigas la llave del señor de la guerra Zol\'Maz.‡Har\'koa de Zim\'Torga te ha pedido que consigas la llave del señor de la guerra Zol\'Maz.‡Har\'koa à Zim\'Torga vous a demandé d\'obtenir la Clé du Seigneur de guerre Zol\'Maz.‡希姆托加的哈克娅要求你去夺取督军佐尔玛兹的钥匙。‡辛托加的哈寇亞要你去取得督軍佐爾馬茲的鑰匙。',
  }
},
[12713] = {
  {
    'Traição‡Предательство‡Verrat‡배신‡Traición‡Traición‡Trahison‡背叛‡背叛',
    nil,
    'Stefan, no Posto Ébano, quer que você derrote Drakuru.|n|nSe você perder a Gargantilha Enfeitiçada, fale com Stefan, no Posto Ébano, para obter outra.‡По поручению Стефана с Черной заставы убейте Дракуру.|n|nЕсли вы потеряете заколдованное колье, возвращайтесь к Стефану на Черную заставу, и он даст вам другое.‡Stefan in der Schwarzen Wacht möchte, dass Ihr Drakuru besiegt.|n|nFalls Ihr Euren bezauberten Halsreif verlieren solltet, dann kehrt zu Stefan in der Schwarzen Wacht zurück und besorgt Euch einen neuen.‡칠흑의 감시초소에 있는 스테판이 드라쿠루를 처치해 달라고 부탁했습니다.|n|n마법의 목걸이를 잃어버리면 칠흑의 감시초소로 돌아가서 스테판에게 다시 얻어야 합니다.‡Stefan del Puesto de Vigilancia de Ébano quiere que derrotes a Drakuru.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan del Puesto de Vigilancia de Ébano para obtener otra.‡Stefan del Puesto de Vigilancia de Ébano quiere que derrotes a Drakuru.|n|nSi pierdes la gargantilla embrujada, vuelve con Stefan del Puesto de Vigilancia de Ébano para obtener otra.‡Stefan au Guet d\'Ébène vous a demandé de vaincre Drakuru.|n|nSi vous perdez le Sautoir ensorcelé, retournez voir Stefan au Guet d\'Ébène.‡黑锋哨站的斯特凡要求你击败达库鲁。|n|n如果你丢失了迷惑项圈，可以返回黑锋哨站的斯特凡那里去再要一个。‡黯黑守望的史戴芬要你擊敗德拉庫魯。|n|n如果你把蠱惑頸飾搞丟了，返回黯黑守望的史戴芬處再拿一個。',
  }
},
[12714] = {
  {
    'A vontade do Lich Rei‡Воля Короля-лича‡Der Wille des Lichkönigs‡리치 왕의 굳건한 의지‡La voluntad del Rey Exánime‡La voluntad del Rey Exánime‡La volonté du roi-liche‡巫妖王的意志‡巫妖王的意志',
    nil,
    'Retorne para a Vanguarda da Morte e se apresente ao Príncipe Valanar.‡Возвращайтесь в Разлом Смерти и обратитесь к принцу Валанару.‡Kehrt zur Todesbresche zurück und meldet Euch bei Prinz Valanar.‡죽음의 틈으로 돌아가서 공작 발라나르에게 보고해야 합니다.‡Vuelve a Brecha de la Muerte e informa al príncipe Valanar.‡Vuelve a Brecha de la Muerte e informa al príncipe Valanar.‡Retournez à Brèche-de-Mort et faites votre rapport au Prince Valanar.‡回到死亡裂口，向瓦拉纳王子报到。‡返回死亡止境，向瓦拉納爾親王報到。',
  }
},
[12715] = {
  {
    'A Cripta da Memória‡Склеп Воспоминаний‡Die Krypta der Erinnerung‡기념 납골당‡La Cripta de los Recuerdos‡La Cripta de los Recuerdos‡La crypte du Souvenir‡追忆墓穴‡緬懷墓穴',
    nil,
    'Apresente-se ao príncipe Keleseth na Cripta da Memória.‡Найдите принца Келесета в Склепе Воспоминаний.‡Meldet Euch bei Prinz Keleseth in der Krypta der Erinnerung.‡기념 납골당에 있는 공작 켈레세스에게 보고해야 합니다.‡Preséntate ante el príncipe Keleseth en la Cripta de los Recuerdos.‡Preséntate ante el príncipe Keleseth en la Cripta de los Recuerdos.‡Présentez-vous au Prince Keleseth dans la Crypte du Souvenir.‡向追忆墓穴的凯雷塞斯王子报到。‡向緬懷墓穴的凱雷希斯親王報到。',
  }
},
[12716] = {
  {
    'O pedido do pestífero‡Просьба распространителя чумы‡Des Seuchenfürstens Gesuch‡역병술사의 요청‡La solicitud del Pesteador‡La solicitud del Pesteador‡La requête du porte-peste‡药剂师的要求‡瘟疫使者的要求',
    nil,
    'Noth, o Pestífero, quer que você leve para ele 1 Caldeirão Vazio, 1 Corrente de Ferro e 10 Crânios de Cruzados.‡Нот Чумной попросил вас принести ему пустой котел, железную цепь и 10 черепов рыцарей Света.‡Noth der Seuchenfürst möchte, dass Ihr ihm 1 leeren Kessel, 1 Eisenkette und 10 Kreuzfahrerschädel bringt.‡역병술사 노스가 빈 가마솥 1개, 무쇠 사슬 1개와 십자군 유골 10개를 가져오라고 요청했습니다.‡Noth el Pesteador ha solicitado que le traigas 1 caldera vacía, 1 cadena de hierro y 10 calaveras de cruzado.‡Noth el Pesteador ha solicitado que le traigas 1 caldera vacía, 1 cadena de hierro y 10 calaveras de cruzado.‡Noth le Porte-peste vous a demandé de lui rapporter 1 Chaudron vide, 1 Chaîne de fer et 10 Crânes de croisés.‡药剂师诺斯要求你交给他一口空锅、一条铁链和10块十字军徽记。‡『瘟疫使者』諾斯要求你替他拿1個空的大鍋，1條鐵鍊，還有10個十字軍顱骨來。',
  }
},
[12717] = {
  {
    'Beberagem Especial do Noth‡Особое варево Нота‡Noths Spezialgebräu‡노스의 특수 혼합물‡El brebaje especial de Noth‡El brebaje especial de Noth‡La cuvée spéciale de Noth‡诺斯的特殊药剂‡諾斯特調',
    nil,
    'Coloque a Pilha de Crânios de Cruzados dentro do Caldeirão Pestilento.‡Положите груду рыцарских черепов в чумной котел.‡Werft den Haufen Kreuzfahrerschädel in den Seuchenkessel.‡십자군 유골 더미를 역병 가마솥 안에 넣어야 합니다.‡Coloca la pila de calaveras de cruzado dentro de la caldera de peste.‡Coloca la pila de calaveras de cruzado dentro de la caldera de peste.‡Placez la Pile de crânes de croisés dans le Chaudron de peste.‡将一堆十字军徽记放入天灾之锅。‡把十字軍顱骨堆放進瘟疫大鍋中。',
  }
},
[12718] = {
  {
    'Mais crânios para a mistura‡Черепа для пойла‡Mehr Totenschädel fürs Gebräu‡해골 더 넣기‡Más calaveras para brebaje‡Más calaveras para brebaje‡Plus de crânes pour la cuvée‡更多的徽记‡用更多的顱骨來釀製',
    nil,
    nil,
  }
},
[12719] = {
  {
    'Sem escape e sem abrigo‡Некуда бежать и негде спрятаться‡Es gibt kein Entrinnen‡뛰어봤자 벼룩‡No hay escapatoria‡No hay escapatoria‡Nul lieu pour fuir ou se cacher‡无路可逃，无处可藏‡無處可逃，無處可躲',
    nil,
    'O príncipe Keleseth, na Cripta da Memória, quer que você mate o prefeito Quimby e pegue os Arquivos de Nova Avalon.‡Принц Келесет из Склепа Воспоминаний приказал вам убить мэра Квимби и принести учетную книгу Нового Авалона.‡Prinz Keleseth in der Krypta der Erinnerung hat Euch befohlen, Bürgermeister Quimby zu töten und die Registratur von Neu-Avalon zu beschaffen.‡기념 납골당에 있는 공작 켈레세스가 시장 큄비를 처치하고 신 아발론 기록부를 찾아오라고 명령했습니다.‡El príncipe Keleseth de la Cripta de los Recuerdos te ha ordenado matar al alcalde Quimby y recuperar el registro de Nuevo Avalon.‡El príncipe Keleseth de la Cripta de los Recuerdos te ha ordenado matar al alcalde Quimby y recuperar el registro de Nuevo Avalon.‡Le Prince Keleseth, dans la Crypte du Souvenir, vous a ordonné de tuer le Maire Quimby et de rapporter le Registre de la Nouvelle-Avalon.‡追忆墓穴的凯雷塞斯王子命令你去击败奎比镇长，并找到新阿瓦隆户籍册。‡緬懷墓穴的凱雷希斯親王命令你殺死鎮長昆比，並取得新亞法隆名冊。',
  }
},
[12720] = {
  {
    'Como fazer amigos e influenciar inimigos‡Как завоевывать друзей и оказывать влияние на врагов‡Wie man Freunde gewinnt und Feinde beeinflusst‡친구를 사귀고 적을 감화시키는 방법‡Cómo ganar amigos e influenciar a los enemigos‡Cómo ganar amigos e influenciar a los enemigos‡Comment se faire des amis et influencer ses ennemis‡说服者‡如何影響敵人，獲得朋友',
    nil,
    'O príncipe Keleseth, na Cripta da Memória, quer que você descubra a verdade sobre a "Aurora Escarlate".|n|nRemova os Persuasores de Keleseth da Caixa Adornada de Joias e use-os para "persuadir" os membros da Cruzada Escarlate a falar.‡Принц Келесет из Склепа Воспоминаний приказал вам узнать всю правду про "Багровый Рассвет."|n|nДостаньте доводы Келесета из узорной шкатулки и "разговорите" с их помощью рыцарей Алого ордена.‡Prinz Keleseth in der Krypta der Erinnerung hat Euch befohlen, die Wahrheit über den "Scharlachroten Morgen" herauszufinden.|n|nNehmt Keleseths Überzeuger aus der juwelenbesetzten Schatulle und bringt damit einen Scharlachroten Kreuzzügler zum Reden.‡기념 납골당에 있는 공작 켈레세스가 "진홍빛 서광"에 관한 진실을 알아내라고 명령했습니다.|n|n화려한 보석 장식 상자에서 꺼낸 켈레세스의 강권을 사용하여 붉은십자군이 말하도록 "설득"해야 합니다.‡El príncipe Keleseth de la Cripta de los Recuerdos te ha ordenado que descubras la verdad sobre el "Alba Carmesí".|n|nSaca los persuasores de Keleseth de la caja ornamentada con joyas y úsalos para "persuadir" a la Cruzada Escarlata para que hable.‡El príncipe Keleseth de la Cripta de los Recuerdos te ha ordenado que descubras la verdad sobre el "Alba Carmesí".|n|nSaca los persuasores de Keleseth de la caja ornamentada con joyas y úsalos para "persuadir" a la Cruzada Escarlata para que hable.‡Le Prince Keleseth à la Crypte du Souvenir vous a ordonné de découvrir la vérité à propos de l\'« Aube cramoisie ».|n|nEnlevez les Éloquentes de Keleseth de la Boîte à bijoux ouvragée et utilisez-les pour rendre la Croisade écarlate « éloquente ».‡追忆墓穴的凯雷塞斯王子命令你去探寻“血色的黎明”的真相。|n|n从精致的珠宝箱中取出凯雷塞斯的说服者，使用它们来“说服”血色十字军吐露真相。‡緬懷墓穴的凱雷希斯親王命令你去找出關於「赤紅黎明」的真相。|n|n把凱雷希斯說服者從華麗珠寶盒拿出來，然後用它們來「說服」血色十字軍吐實。',
  }
},
[12721] = {
  {
    'Alvoroço‡Буйство‡Randale‡아칼리를 구해라‡Arrasando‡Arrasando‡Saccage‡狂暴‡暴怒',
    nil,
    'Har\'koa, em Zim\'Torga, pediu para libertar Akali e depois avisar o Mandingueiro Khufu em Zim\'Torga.‡По поручению Хар\'коа из Зим\'Торги освободите Акали и сообщите об этом знахарю Кхуфу в Зим\'Торге.‡Har\'koa in Zim\'Torga möchte, dass Ihr Akali befreit und danach Hexendoktor Khufu in Zim\'Torga benachrichtigt.‡짐토르가에 있는 하르코아가 아칼리를 풀어준 다음 짐토르가로 돌아와 의술사 쿠푸에게 알려달라고 부탁했습니다.‡Har\'koa en Zim\'Torga te ha pedido que liberes a Akali y luego informes al médico brujo Khufu en Zim\'Torga.‡Har\'koa en Zim\'Torga te ha pedido que liberes a Akali y luego informes al médico brujo Khufu en Zim\'Torga.‡Har\'koa à Zim\'Torga vous a demandé de libérer Akali et d\'en informer ensuite le Féticheur Khufu à Zim\'Torga.‡希姆托加的哈克娅要你去释放阿卡里，并将这个消息通知巫医库弗。‡辛托加的哈寇亞要你釋放阿卡利，然後到辛托加通知巫醫庫弗。',
  }
},
[12722] = {
  {
    'Como cordeiros no matadouro‡Овцы на бойне‡Wie Lämmer zur Schlachtbank‡새끼 양 사냥‡Corderos a la matanza‡Corderos al matadero‡Comme des agneaux à l\'abattoir‡羊入虎口‡待宰羔羊',
    nil,
    'O Barão Rivendare, na Cripta da Memória, quer que você mate 10 Soldados da Cruzada Escarlate e 15 Cidadãos de Nova Avalon.‡Барон Ривендер из Склепа Воспоминаний приказал вам убить 10 солдат Алого ордена и 15 жителей Нового Авалона.‡Baron Totenschwur in der Krypta der Erinnerung hat Euch befohlen, 10 Soldaten des Scharlachroten Kreuzzugs und 15 Bürger von Neu-Avalon zu erschlagen.‡기념 납골당에 있는 리븐데어 남작이 붉은십자군 병사 10명과 신 아발론 시민 15명을 처치하라고 했습니다.‡El barón Osahendido en la Cripta de los Recuerdos te ha ordenado que mates a 10 soldados de la Cruzada Escarlata y 15 ciudadanos de Nuevo Avalon.‡El barón Osahendido en la Cripta de los Recuerdos te ha ordenado que mates a 10 soldados de la Cruzada Escarlata y 15 ciudadanos de Nuevo Avalon.‡Le Baron Vaillefendre à la Crypte du Souvenir vous a ordonné de tuer 10 Soldats de la Croisade écarlate et 15 Habitants de la Nouvelle-Avalon.‡追忆墓穴的瑞文戴尔男爵命令你去消灭10个血色十字军士兵和15个新阿瓦隆预备兵。‡緬懷墓穴的瑞文戴爾男爵命令你殺死10個血色十字軍士兵和15個新亞法隆市民。',
  }
},
[12723] = {
  {
    'Atrás das linhas escarlates‡За Алым фронтом‡Hinter den Linien der Scharlachroten‡붉은십자군의 방어선 너머‡Detrás de las líneas Escarlata‡Detrás de las líneas Escarlata‡Derrière les lignes écarlates‡深入血色敌后‡在血色防線後方',
    nil,
    'Apresente-se a Orbaz Ruinassangue na Taberna Escarlate, que fica em Nova Avalon.‡Найдите Орбаза Кровопорча в Таверне Алого ордена в Новом Авалоне.‡Meldet Euch bei Orbaz Blutbann in der Scharlachroten Taverne in Neu-Avalon.‡신 아발론의 붉은십자군 선술집에 있는 오르바즈 블러드베인에게 보고해야 합니다.‡Preséntate ante Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon.‡Preséntate ante Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon.‡Présentez-vous à Orbaz Sangreplaie à la Taverne écarlate de la Nouvelle-Avalon.‡前往新阿瓦隆，向血色旅店内的奥尔巴兹·血毒报到。‡向血色旅店的歐貝茲·血禍報到。血色旅店位於新亞法隆。',
  }
},
[12724] = {
  {
    'O caminho do Cruzado justo‡Путь истинного рыцаря‡Der Pfad des gerechten Kreuzfahrers‡붉은십자군의 정찰 일정‡El camino del cruzado honrado‡El camino del cruzado honrado‡Le chemin du croisé vertueux‡十字军的巡逻路线‡正義十字軍之道',
    nil,
    'Orbaz Ruinassangue, na Taberna Escarlate, em Nova Avalon, quer que você roube o Itinerário das Patrulhas de Nova Avalon do Castelo Escarlate.‡Орбаз Кровопорч из Таверны Алого ордена в Новом Авалоне приказал вам украсть расписание патрулей Нового Авалона из Крепости Алого ордена.‡Orbaz Blutbann in der Scharlachroten Taverne in Neu-Avalon hat Euch befohlen, die Patrouillenaufstellung von Neu-Avalon aus der Scharlachroten Festung zu stehlen.‡신 아발론의 붉은십자군 선술집에 있는 오르바즈 블러드베인이 붉은십자군 요새에서 신 아발론 정찰 일정표를 훔쳐 오라고 했습니다.‡Orbaz de la Taberna Escarlata en Nuevo Avalon te ha ordenado que robes el horario de patrullas de Nuevo Avalon que hay en el Bastión Escarlata.‡Orbaz de la Taberna Escarlata en Nuevo Avalon te ha ordenado que robes el horario de patrullas de Nuevo Avalon que hay en el Bastión Escarlata.‡Orbaz Sangreplaie, à la Taverne écarlate de la Nouvelle-Avalon, vous a ordonné de voler le Plan de route des patrouilles de la Nouvelle-Avalon dans le Fort écarlate.‡血色旅店内的奥尔巴兹·血毒命令你进入血色城堡，偷取新阿瓦隆巡逻日程表。‡新亞法隆，血色旅店的歐貝茲·血禍命令你去血色堡偷取新亞法隆巡邏日程表。',
  }
},
[12725] = {
  {
    'Irmãos na morte‡Братья по смерти‡Im Tode vereint‡위기에 처한 전우‡Hermanos en la muerte‡Hermanos en la muerte‡Frères dans la mort‡死亡骑士的兄弟情谊‡亡者兄弟',
    nil,
    'Encontre Koltirus Tecemorte no Castelo Escarlate.‡Найдите Кольтиру Ткача Смерти в Крепости Алого ордена.‡Sucht nach Koltira Todesweber in der Scharlachroten Festung.‡붉은십자군 요새에서 콜티라 데스위버를 찾아야 합니다.‡Busca a Koltira Tejemuerte en el Bastión Escarlata‡Busca a Koltira Tejemuerte en el Bastión Escarlata.‡Cherchez Koltira Tissemort dans le Fort écarlate.‡在血色城堡内寻找库尔迪拉·织亡者。‡在血色堡中找出寇爾提拉·亡織者。',
  }
},
[12726] = {
  {
    'Canto de Vento e Água‡Песнь Ветра и Воды‡Lied von Wind und Wasser‡바람과 물의 노래‡Canción de viento y agua‡Canción de viento y agua‡Le chant du Vent et de l\'Eau‡风与水之歌‡風與水之歌',
    nil,
    'Soo-nee quer que você use os Tambores da Tempestade na Prateleira do Criador da Tempestade e ajude Hufão a devorar 3 Elementais Vingativos da Tempestade e 3 Espíritos Aquosos.‡Су-ни хочет, чтобы вы использовали Барабаны Шторма на уступе Ваятеля Бурь и помогли Хайфуну поглотить 3 загробников бури и 3 призраков дождя.‡Soo-nee möchte, dass Ihr die Trommeln des Sturms auf dem Sturmherrenschelf verwendet und Haifun dabei helft, 3 Sturmwiedergänger und 3 Aqueousgeister zu verschlingen.‡수네가 폭풍전령 바위에서 폭풍우의 북소리를 사용하여 하이피훈이 폭풍 망령 3마리와 물의 정령 3마리를 삼키도록 도와달라고 부탁했습니다.‡Soo-nata quiere que uses los tambores de la tempestad en La Plataforma del Tormentoso y que ayudes a Haifón a devorar 3 aparecidos tormentosos y 3 espíritus acuosos.‡Soo-nata quiere que uses los tambores de la tempestad en La Plataforma del Tormentoso y que ayudes a Haifón a devorar 3 aparecidos tormentosos y 3 espíritus acuosos.‡Soo-premm veut que vous utilisiez les Tambours de la tempête à la Saillie de Forgetempête et que vous aidiez Haiphoon à dévorer 3 Revenants des tempêtes et 3 Esprits aqueux.‡索乌尼要你在雷暴台地使用雷雨之鼓，帮助海波恩吞噬3个风暴亡魂和3个流水之魂。‡蘇-睨要你到風暴工匠沙洲用暴風雨之鼓幫助駭風吞噬3個風暴亡魄和3個水漾之靈。',
  }
},
[12727] = {
  {
    'Fuga sangrenta‡Кровавый побег‡Blutiger Ausbruch‡필사적인 탈출‡Estallido sangriento‡Estallido sangriento‡Une issue sanglante‡杀出一条血路‡血腥突圍',
    nil,
    'Mate o Alto-inquisidor Valroth e entregue a Cabeça de Valroth a Thassarian, que está na Taberna Escarlate, em Nova Avalon.‡Убейте верховного инквизитора Валрота и отнесите его голову Тассариану в таверну Алого ордена в Новом Авалоне.‡Erschlagt Hochinquisitor Valroth und bringt Valroths Kopf zu Thassarian in der Scharlachroten Taverne in Neu-Avalon.‡종교재판관 발로스를 처치하고 발로스의 머리카락을 신 아발론의 붉은십자군 선술집에 있는 타사리안에게 가져가야 합니다.‡Mata al Alto Inquisidor Valroth y lleva su cabeza a Thassarian en la Taberna Escarlata de Nuevo Avalon.‡Mata al Alto Inquisidor Valroth y lleva su cabeza a Thassarian en la Taberna Escarlata de Nuevo Avalon.‡Tuez le Grand inquisiteur Valroth et rapportez la Tête de Valroth à Thassarian à la Taverne écarlate à la Nouvelle-Avalon.‡击败大检查官瓦洛斯，并把瓦洛斯的徽记带回新阿瓦隆的血色旅店，交给萨萨里安。‡殺死高階審判官瓦羅斯，把瓦羅斯的頭顱帶去給血色旅店的薩沙理安。血色旅店位於新亞法隆。',
  }
},
[12728] = {
  {
    'Monitoramento da fissura: Caverna Falésia Invernal‡Наблюдения за расселиной: пещера Зимних Плавников‡Die Klamm beobachten: Höhlen der Winterflossen‡균열 조사: 겨울지느러미 동굴‡Observar la falla: Cavernas Aleta Invernal‡Observar la falla: Cavernas Aleta Invernal‡Surveiller la faille : les cavernes des Ailerons-d\'hiver‡监视裂谷：冬鳞洞穴‡監控裂口:冬鰭洞窟',
    nil,
    'O Bibliotecário Garren, no Promontório Âmbar, quer que você use o Arcanômetro na Caverna Falésia Invernal.‡По просьбе библиотекаря Гаррена с Янтарной гряды воспользуйтесь тайнометром у пещер Зимних Плавников.‡Bibliothekar Garren vom Bernsteinflöz möchte, dass Ihr zu den Höhlen der Winterflossen geht und dort das Arkanometer benutzt.‡호박석 절벽에 있는 사서 가렌이 겨울지느러미 동굴에서 비전력 측정기를 사용해 달라고 부탁했습니다.‡El bibliotecario Garren en El Saliente Ámbar quiere que uses el arcanómetro en las Cavernas Aleta Invernal.‡El bibliotecario Garren en El Saliente Ámbar quiere que uses el arcanómetro en las Cavernas Aleta Invernal.‡Le Bibliothécaire Garren, à l\'Escarpement d\'Ambre, vous a demandé d\'utiliser l\'Arcanomètre dans les Cavernes des Ailerons-d\'hiver.‡琥珀崖的盖伦要你在冬鳞洞穴处使用奥术测量器。‡琥珀岩臺的圖書管理員加倫要你在冬鰭洞窟使用奧能檢測儀。',
  }
},
[12729] = {
  {
    'Os deuses se pronunciaram‡Боги говорили с нами...‡Die Götter haben gesprochen‡신의 조언‡Los dioses han hablado‡Los dioses han hablado‡Les dieux ont parlé‡诸神的指引‡諸神已然開口',
    nil,
    'Entregue o Coração Imaculado do Guardião e a Essência Tempestuosa do Protetor a Har\'koa em Zim\'Torga.‡Принесите безупречное сердце стража и субстанцию ветра Хар\'коа в Зим\'Торгу.‡Bringt das unbefleckte Herz des Wächters und die stürmische Essenz des Behüters zu Har\'koa in Zim\'Torga.‡수호자의 흠집 없는 심장과 감시자의 돌풍 정수를 짐토르가에 있는 하르코아에게 가져가야 합니다.‡Entrega el corazón del guardián inmaculado y la esencia ventosa del celador a Har\'koa en Zim\'Torga.‡Entrega el corazón del guardián inmaculado y la esencia ventosa del celador a Har\'koa en Zim\'Torga.‡Livrez le Cœur du gardien impeccable et l\'Essence venteuse du gardien à Har\'koa, dans Zim\'Torga.‡将完美的守卫者精华和充满活力的典狱官精华交给希姆托加的哈克娅。‡將無瑕疵的守護者之心和守望者的陣風精華送去給辛托加的哈寇亞。',
  }
},
[12730] = {
  {
    'Convocação em Zol\'Heb‡Вызов в Зол\'Хебе‡Beschwörung bei Zol\'Heb‡줄드락의 영웅‡Convocatoria en Zol\'Heb‡Convocatoria en Zol\'Heb‡Convocation à Zol\'Heb‡在佐尔赫布相会‡佐爾希伯的召集',
    nil,
    'Har\'koa, em Zim\'Torga, pediu para você matar o Profeta de Akali.‡По заданию Хар\'коа из Зим\'Торги убейте пророка Акали.‡Har\'koa in Zim\'Torga möchte, dass Ihr den Propheten von Akali tötet.‡짐토르가에 있는 하르코아가 아칼리의 예언자를 처치해 달라고 했습니다.‡Har\'koa en Zim\'Torga te ha pedido que mates al profeta de Akali.‡Har\'koa en Zim\'Torga te ha pedido que mates al profeta de Akali.‡Har\'koa à Zim\'Torga vous a demandé de tuer le Prophète d\'Akali.‡希姆托加的哈克娅要求你杀死阿卡里先知。‡辛托加的哈寇亞要你殺死阿卡利預言者。',
  }
},
[12732] = {
  {
    'A força cordissangue‡Сила озаренной крови‡Des Herzbluts Stärke‡심혈의 힘‡La fuerza de corazón de sangre‡La fuerza de corazón de sangre‡La force du sang du cœur‡日灼之力‡心臟血液的力量',
    nil,
    'Leve uma ampola de Cordissangue Tocado pelo Sol para Rejek, no Morro dos Feralma.‡Принесите фиал озаренной крови матриарха Реджеку на холм Бешеного Сердца.‡Bringt eine Phiole voll Sonnenstrahlherzblut zu Rejek auf dem Hügel der Wildherzen.‡광란의심장 언덕에 있는 레이제크에게 해마루 심혈이 담긴 병을 가져가야 합니다.‡Lleva un vial de corazón de sangre Toquesol a Rejek a la Colina Corazón Frenético.‡Lleva un vial de corazón de sangre Toquesol a Rejek a la Colina Corazón Frenético.‡Apportez une fiole de Sang du cœur Solegrâce à Rejek, à la Colline de Frénécœur.‡将一瓶日灼精华交给狂心岭的雷耶克。‡將一份日觸心臟血液交給狂心之丘的瑞傑克。',
  }
},
[12733] = {
  {
    'O Desafio da Morte‡Вызов смерти‡Herausforderung des Todes‡죽음의 도전‡Desafío de la Muerte‡Desafío de la Muerte‡Le défi de la mort‡死亡的挑战‡死亡挑戰',
    nil,
    'Olrun, a Voz da Batalha, quer que você vença 5 duelos contra outros cavaleiros da morte.|n|nVocê pode escolher entre lutar contra cavaleiros da morte iniciados ou jogadores.‡Олрун Зовущая Битву приказала вам выиграть 5 дуэлей с другими рыцарями смерти.|n|nВыберите себе противников среди посвященных рыцарей смерти или других игроков.‡Olrun die Schlachtenruferin hat Euch befohlen, 5 Duelle mit anderen Todesrittern zu gewinnen.|n|nIhr könnt gegen Initianden der Todesritter oder gegen Spieler kämpfen.‡전투징집관 올룬이 죽음의 기사와 결투를 벌여 5번 승리하라고 했습니다.|n|n다른 죽음의 기사나 수습 죽음의 기사 중에 상대를 선택할 수 있습니다.‡Olrun la Clamabatallas te ha ordenado que ganes 5 duelos contra otros caballeros de la Muerte.|n|nDeberías luchar contra caballeros de la Muerte iniciados o jugadores.‡Olrun la Clamabatallas te ha ordenado que ganes 5 duelos contra otros caballeros de la Muerte.|n|nDeberías luchar contra caballeros de la Muerte iniciados o jugadores.‡Olrun le Mande-guerre vous a ordonné de gagner 5 duels contre d\'autres chevaliers de la mort.|n|nVous pouvez affronter des initiés chevaliers de la mort ou des joueurs chevaliers de la mort.‡战斗召唤者奥尔伦命令你在决斗中战胜5名死亡骑士。|n|n你可以选择死亡骑士新兵或玩家作为对手。‡『戰鬥召喚者』歐魯命令你與5個死亡騎士決鬥並獲得勝利。|n|n你可以選擇與死亡騎士新兵或玩家作戰。',
  }
},
[12734] = {
  {
    'Rejek: programado para matar‡Реджек: первая кровь‡Rejek: Erstes Blut‡레이제크: 첫 번째 피‡Rejek: Primeras manchas de sangre‡Rejek: Primeras manchas de sangre‡Rejek : le premier sang‡雷耶克：第一滴血‡瑞傑克:第一滴血',
    nil,
    'Ensanguentar a Lâmina de Rejek nos cadáveres de uma Vespa Safira, de um Agressor Falanjão e de 3 membros da Tribo Brumurmúria. É possível ensanguentar a lâmina tanto nos Oráculos Brumurmúrias quanto nos Guerreiros Brumurmúrias. Após completar a tarefa, fale com Rejek, no Morro dos Feralma.‡Омойте меч Реджека в крови осы Сапфирного улья, лютого барабанча и трех воинов или оракулов Шепота Тумана. Вернитесь на холм Бешеного Сердца к Реджеку.‡Taucht Rejeks Klinge in das Blut der Leichen von einer saphirblauen Schwarmwespe, einem Hartknöchelstürmer und 3 Mitgliedern des Stamms der Nebelflüsterer - es können entweder Orakel der Nebelflüsterer oder Krieger der Nebelflüsterer sein. Kehrt zu Rejek auf dem Hügel der Wildherzen zurück, sobald die Aufgabe abgeschlossen ist.‡레이제크의 검에 사파이어 부화장 말벌, 사나운 바위돌기고릴라, 안개속삭임골록 3마리의 시체에서 피를 묻혀야 합니다. 안개속삭임골록 점쟁이나 전사에게 검을 사용하여 피를 묻히고 광란의심장 언덕에 있는 레이제크에게 돌아가야 합니다.‡Mancha de sangre la hoja de Rejek en los cadáveres de una avispa del Enjambre Zafiro, un destrero Callonudillo y 3 miembros de la tribu Susurraneblinas. Puedes manchar la hoja con sangre de Oráculos Susurraneblina o de guerreros Susurraneblina. Vuelve junto a Rejek a la Colina Corazón Frenético cuando acabes la tarea.‡Mancha de sangre la hoja de Rejek en los cadáveres de una avispa del Enjambre Zafiro, un destrero Callonudillo y 3 miembros de la tribu Susurraneblinas. Puedes manchar la hoja con sangre de Oráculos Susurraneblina o de guerreros Susurraneblina. Vuelve junto a Rejek a la Colina Corazón Frenético cuando acabes la tarea.‡Avec l\'Épée de Rejek, tuez une Guêpe de la ruche Saphir, un Fonceur poing-dur, et 3 Membres de la tribu murmebrume. Vous pouvez tuer des Oracles murmebrumes ou des Guerriers murmebrumes, au choix. Retournez voir Rejek à la Colline de Frénécœur quand vous aurez effectué cette tâche.‡击败1只蓝玉虫巢巨蜂、1只硬皮冲锋者和3名雾语氏族的成员，完成雷耶克的仪式。你可以选择击败雾语神谕者或是雾语战士。完成任务后，向狂心岭的雷耶克复命。‡用狂心之丘黃蜂、硬拳衝鋒者、3個霧語族的成員的屍體讓瑞傑克之刃飲血。不論是霧語神諭者或霧語戰士都可以。當你完成了任務之後，回去狂心之丘找瑞傑克。',
  }
},
[12735] = {
  {
    'Um canto purificador‡Песнь Очищения‡Ein reinigendes Lied‡정화의 노래‡Canción de purificación‡Canción de purificación‡Un chant de purification‡净化之歌‡淨化之歌',
    nil,
    'Soo-nee, nas Frondes Voz-da-chuva, quer que você toque o Carrilhão de Purificação no Lago Maremarga, no Rio Invérnia e no Coração do Rio e, em seguida, mate os espíritos malignos que infestam as águas.‡Су-ни из прибежища Гласа Дождя хочет, чтобы вы прозвонили в колокола Очищения возле озера Горьких Волн, у реки Ледяных Оков и у Слияния рек, а затем убили злых духов, отравляющих эти воды.‡Soo-nee beim Baldachin der Regenrufer will, dass Ihr am Bittertidensee, am Tausendwinterfluss und am Flussnabel das läuternde Glockenspiel erklingen lasst und die bösen Geister tötet, die das Wasser dort verschmutzen.‡구름몰이 거처에 있는 수네가 거센물결 호수, 겨울손아귀 강, 강의 심장부에서 정화의 노래를 연주하여 그곳의 물을 오염시키는 악마의 영혼들을 처치해 달라고 부탁했습니다.‡Soo-nata, en la Espesura Hablalluvia, quiere que hagas sonar la campana de purificación en el Lago Olamarga, el Río Conquista del Invierno y el Corazón del Río, y que mates a los espíritus maléficos que habitan en sus aguas.‡Soo-nata, en el Canope de Hablalluvia, quiere que hagas sonar la campana de purificación en el Lago Olamarga, el Río Conquista del Invierno y el Corazón del Río, y que mates a los espíritus maléficos que habitan en sus aguas.‡Soo-premm, à la Canopée Parlepluie, vous demande de jouer du Carillon purificateur au lac Flot-amer, au fleuve le Joug-d\'hiver et au Cœur du fleuve, et de tuer les esprits maléfiques qui polluent leurs eaux.‡雨声树屋的索乌尼要你在苦潮湖、冬拥河和河流之心敲响净化之钟，杀死污染水源的邪灵。‡雨頌者之蓬的蘇-睨要你在惡潮湖、冬握河、還有大河之心彈奏淨化排鐘，然後殺死污染水源的邪惡靈魂。',
  }
},
[12736] = {
  {
    'O sopro da reflexão‡Песнь Размышления‡Lied der Besinnung‡사색의 노래‡Canción de reflexión‡Canción de reflexión‡Un chant de réflexion‡沉思之歌‡冥思之歌',
    nil,
    'Soo-nee, nas Frondes Voz-da-chuva, quer que você toque o Didjeridu da Contemplação no topo do Pilar Rutilante, do Pilar Tocado pelo Sol, do Pilar Verdeluz e do Pilar Beira-céu.‡Су-ни из прибежища Гласа Дождя хочет, чтобы вы сыграли на диджериду созерцания на вершине Мерцающей колонны, Колонны Солнечного Благословения, Колонны Мохосвета и Колонны Небесного Пути.‡Soo-nee im Baldachin der Regenrufer möchte, dass Ihr das Didgeridoo des Nachsinnens auf der Spitze der Schimmersäule, der Sonnenstrahlsäule, der Mooslichtsäule und der Himmelszeltsäule verwendet.‡구름몰이 거처에 있는 수네가 미명의 봉우리, 해마루 봉우리, 이끼빛 봉우리, 하늘길 봉우리의 꼭대기에서 명상의 나무통피리를 사용해 달라고 부탁했습니다.‡Soo-nata, en la Espesura Hablalluvia, quiere que uses el didgeridoo de contemplación en lo alto de El Pilar Iluminado, El Pilar Musgoluz y El Pilar del Trecho Celestial.‡Soo-nata, en el Canope de Hablalluvia, quiere que uses el didgeridoo de contemplación en lo alto de El Pilar Iluminado, El Pilar Musgoluz y El Pilar del Trecho Celestial.‡Soo-premm, à la Canopée Parlepluie, vous a demandé d\'utiliser le Didjeridou de contemplation au sommet du Pilier Scintillant, du Pilier Solegrâce, du Pilier Mousselume et du Pilier Confins-du-ciel.‡雨声树屋的索乌尼要你在光芒之柱、日灼之柱、苔光之柱和通天之柱的顶端吹响沉思乐管。‡雨頌者之蓬的蘇-睨要你在微光之柱、日觸之柱、苔光之柱和擎天之柱的頂端使用冥想長管笛。',
  }
},
[12737] = {
  {
    'O som da fecundidade‡Песнь Плодородия‡Lied der Fruchtbarkeit‡비옥의 노래‡Canción de fecundidad‡Canción de fecundidad‡Un chant de fécondité‡丰饶之歌‡豐饒之歌',
    nil,
    'Soo-nee, nas Frondes Voz-da-chuva, quer que você vá para a Prateleira do Criador da Tempestade, ao noroeste do Ninho do Criador, e toque a Trompa da Fecundidade perto de 8 pilhas de Terra Fértil Molhada.‡Оракул Су-ни из прибежища Гласа Дождя хочет, чтобы вы отправились на уступ Ваятеля Бурь, что к северо-западу от Обители Творцов, и сыграли на Роге Плодородия возле 8 кучек влажной плодородной грязи.‡Soo-nee beim Baldachin der Regenrufer möchte, dass Ihr zum Sturmherrenschelf nordwestlich des Horts der Schöpfer geht und das Horn der Fruchtbarkeit neben 8 Hügeln durchtränkten Mutterbodens blast.‡구름몰이 거처에 있는 수네가 창조주의 감시대에서 북서쪽에 있는 폭풍전령 바위로 가서 근처에 있는 8개의 물에 젖은 기름진 흙더미에 비옥의 노래를 연주해 달라고 부탁했습니다.‡Soo-nata en la Espesura Hablalluvia quiere que vayas a la Plataforma del Tormentoso, al noroeste de El Pedestal de los Creadores y que toques el cuerno de fecundidad cerca de 8 montones de tierra fértil empapada.‡Soo-nata en el Canope de Hablalluvia quiere que vayas a La Plataforma del Tormentoso, al noroeste de El Pedestal de los Creadores y que toques el cuerno de fecundidad cerca de 8 montones de tierra fértil empapada.‡Soo-premm, à la Canopée Parlepluie, vous demande d\'aller à la Saillie de Forgetempête, au nord-ouest du Perchoir du Faiseur, et d\'utiliser la Corne de fécondité près de 8 Monticules de terre fertile trempés.‡雨声树屋的索乌尼要你前往造物者之座西北方的雷暴台地，在8堆肥沃的土堆附近吹响丰饶号角。‡雨頌者之蓬的蘇-睨要你前往造物者棲所西北邊的風暴工匠沙洲，並在8堆濕潤的肥沃土堆附近演奏豐饒號角。',
  }
},
[12738] = {
  {
    'Um grito de vingança!‡Мольбы об отмщении‡Schrei nach Rache!‡복수의 메아리‡¡Un grito de venganza!‡¡Un grito de venganza!‡Vengeance !‡复仇的呐喊！‡復仇的吶喊!',
    nil,
    'Apresente-se ao Cavaleiro Comandante Pestecarpo na Capela da Chama Carmesim.‡Найдите командора Чумопала в Часовне Багрового Пламени.‡Meldet Euch bei Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트에게 보고해야 합니다.‡Preséntate ante el caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí.‡Preséntate ante el caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí.‡Présentez-vous au Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie.‡到赤色烈焰礼拜堂去，向骑士团指挥官普雷菲斯特报到。‡到赤紅之焰禮拜堂向騎士指揮官瘟疫之拳報到。',
  }
},
[12739] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Malar Chifre Bravo, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Малара Храброга, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Malar Tapferhorn hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥 안에 있는 은빛 여명회 죄수인 말라 브레이브혼을 처치하라고 했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Malar Cuernobravo, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Malar Cuernobravo, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Malar Corne-brave, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，玛拉尔·勇角，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，瑪拉·勇角。',
  }
},
[12740] = {
  {
    'Paraquedas para a Cruzada Argêntea‡Парашюты для Серебряного Авангарда‡Fallschirme für den Argentumkreuzzug‡은빛십자군을 위한 낙하산‡Paracaídas para la Cruzada Argenta‡Paracaídas para la Cruzada Argenta‡Parachute argenté‡银色北伐军的降落伞‡給銀白十字軍的降落傘',
    nil,
    'O Comandante Falstaav, na Fortaleza Argêntea, pediu para você equipar 10 Cruzados Argênteos ou Escudeiros Argênteos no pátio com paraquedas.‡По поручению командира Фальштава на Серебряной заставе передайте парашюты 10 серебряным рыцарям или щитоносцам Серебряного Авангарда во внутреннем дворе.‡Kommandant Falstaav in der Argentumwache möchte, dass Ihr 10 Argentumkreuzfahrer oder Argentumschildmänner draußen auf dem Hof mit Fallschirmen versorgt.‡은빛십자군 격전지에 있는 사령관 팔스타브가 마당에 있는 은빛십자군 성전사나 은빛십자군 방패기사 10명에게 낙하산을 착용할 수 있게 해 달라고 부탁했습니다.‡El Comandante Falstaav de El Confín Argenta te ha pedido que entregues paracaídas a 10 cruzados Argenta o escuderos Argenta en el patio.‡El Comandante Falstaav de El Confín Argenta te ha pedido que entregues paracaídas a 10 cruzados Argenta o escuderos Argenta en el patio.‡Le Commandant Falstaav au Séjour d\'Argent vous a demandé d\'équiper 10 Croisés d\'argent ou Porte-boucliers d\'argent qui se trouvent dans la cour de parachutes.‡银色前沿的指挥官法斯塔夫要你为庭院里的10名银色北伐军战士或银色持盾战士配备降落伞。‡銀白看臺的指揮官法爾斯戴夫要你替10個庭院裡的銀白十字軍或銀白盾侍裝備降落傘。',
  }
},
[12741] = {
  {
    'Força da tempestade‡Сила Бури‡Kraft des Sturms‡폭풍우의 힘‡Fuerza de la tempestad‡Fuerza de la tempestad‡La puissance de la tempête‡雷雨之力‡暴風的力量',
    nil,
    'Reúna 3 Essências da Monção e 3 Essências da Tempestade e leve-as ao Santuário da Tempestade. Fale novamente com Rejek no Morro dos Feralma, que fica na Bacia Sholazar, quando tiver o Poder Verdadeiro da Tempestade.‡Соберите 3 субстанции грозы и 3 субстанции бури и отнесите их в Святилище бурь. Вернитесь на холм Бешеного Сердца к Реджеку и принесите ему истинную силу бури.‡Sammelt 3 Essenzen des Monsuns und 3 Essenzen des Sturms ein und bringt sie zum Sturmschrein. Kehrt mit der wahren Macht des Sturms zu Rejek auf dem Hügel der Wildherzen zurück.‡계절풍의 정수 3개와 폭풍의 정수 3개를 모아 폭풍우의 제단으로 가져간 다음, 광란의심장 언덕에 있는 레이제크에게 폭풍우의 진정한 힘을 가지고 돌아가야 합니다.‡Recoge 3 esencias del monzón y 3 esencias de la tormenta y llévalas al Santuario de la Tempestad. Vuelve junto a Rejek a la Colina Corazón Frenético con el poder verdadero de la tempestad.‡Recoge 3 esencias del monzón y 3 esencias de la tormenta y llévalas al Santuario de la Tempestad. Vuelve junto a Rejek a la Colina Corazón Frenético con el poder verdadero de la tempestad.‡Rassemblez 3 Essences de la mousson et 3 Essences de la tempête, et apportez-les au Sanctuaire de la tempête. Retournez voir Rejek à la Colline de Frénécœur avec le Véritable pouvoir de la tempête.‡收集3份季风精华和3份风暴精华，将它们带到雷雨祭坛去。然后将真正的雷雨之力交给狂心岭的雷耶克。‡收集3個季風精華和3個風暴精華，然後帶去暴風雨聖壇。帶著暴風雨的真實力量回去狂心之丘找瑞傑克。',
  }
},
[12742] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Ellen Pontenova, uma prisioneira da Aurora Argêntea, que está na prisão.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Эллен Станбридж, узницу из Серебряного Рассвета, заключенную в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Ellen Stanbrück hinzurichten - eine gefangene Anhängerin der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 엘렌 스탠브릿지를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Ellen Puentecanto, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Ellen Puentecanto, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Ellen Perrepont, une prisonnière de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，艾琳·斯坦布雷，并结束她的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，艾倫·史坦布利吉。',
  }
},
[12743] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O cavaleiro comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Yazmina Urzeforte, uma prisioneira da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Язмину Окенторн, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Yazmina Eichendorn hinzurichten - eine gefangene Anhängerin der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 야즈미나 오켄손을 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Jazmina Cuerno de Roble, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Jazmina Cuerno de Roble, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Yazmina Roncechêne, une prisonnière de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，亚米娜·橡刺，并结束她的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，雅茲米娜·橡棘。',
  }
},
[12744] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Donovan Pulgelo, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Донована Пулфроста, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Donovan Dulfrost hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 도노반 풀프로스트를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Donovan Pulhelado, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Donovan Pulhelado, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Donovan Tirgivre, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，多诺凡·普弗斯特，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，多諾汎·普佛羅斯特。',
  }
},
[12745] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Goby Plosivo, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Гоби Покрышкинса, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Goby Blastenheimer hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 고비 블라스텐하이머를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Goby Pimpampum, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Goby Pimpampum, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Goby Explonheimer, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，戈比·雷管，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，高比·布雷斯頓海默。',
  }
},
[12746] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Valok, o Íntegro, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Валока Праведного, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Valok den Gerechten hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 정의의 발로크를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Valok El Honrado, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Valok el Honrado, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Valok le Vertueux, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，正义的瓦洛克，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，『公正』伐洛克。',
  }
},
[12747] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Lady Eonys, uma prisioneira da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить леди Эонис, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Lady Eonys hinzurichten - eine gefangene Anhängerin der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 여군주 이오니스를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Lady Eonys, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Lady Eonys, una prisionera de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Dame Eonys, une prisonnière de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，艾欧妮丝女士，并结束她的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，伊歐尼斯女士。',
  }
},
[12748] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Kug Ferroqueixo, um prisioneiro da Aurora Argêntea que está na prisão.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Кага Сталезуба, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Kug Eisenkiefer hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 쿠그 아이언조를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Kug Quijahierro, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Kug Quijahierro, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Kug Gueule-de-fer, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，库格·铁腭，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，庫格·鐵顎。',
  }
},
[12749] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Iggy Presanegra, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Игги Темноклыка, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Iggy Dunkelhauer hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 이기 다크터스크를 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Iggy Colmilloscuro, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste en la Capilla de la Llama Carmesí te ha ordenado que ejecutes a Iggy Colmilloscuro, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Iggy Sombrebroche, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，伊吉·暗齿，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，伊吉·暗牙。',
  }
},
[12750] = {
  {
    'Uma surpresa especial‡Приятный сюрприз‡Eine besondere Überraschung‡특별한 선물‡Una sorpresa especial‡Una sorpresa especial‡Une surprise spéciale‡特殊的怜悯‡特別驚喜',
    nil,
    'O Cavaleiro Comandante Pestecarpo, na Capela da Chama Carmesim, quer que você execute Antoine Brack, um prisioneiro da Aurora Argêntea, que está na prisão das redondezas.‡Командор Чумопал в Часовне Багрового Пламени поручил вам казнить Антуана Брэка, узника из Серебряного Рассвета, заключенного в темнице.‡Ritterkommandant Seuchenfaust an der Kapelle der Scharlachroten Flamme hat Euch befohlen, Antoine Brack hinzurichten - einen gefangenen Anhänger der Argentumdämmerung im Gefängnis in der Nähe.‡진홍불꽃의 예배당에 있는 기사단 사령관 플레이그피스트가 가까운 감옥에 있는 은빛 여명회 죄수인 안톤 브랙을 처치하라고 명령했습니다.‡El caballero Comandante Puño de Peste te ha ordenado que ejecutes a Antoine Brack, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡El caballero Comandante Puño de Peste te ha ordenado que ejecutes a Antoine Brack, un prisionero de El Alba Argenta dentro de la casa prisión de los alrededores.‡Le Chevalier-commandant Poing-du-Fléau à la Chapelle de la Flamme cramoisie vous a ordonné d\'exécuter Antoine Brack, un prisonnier de l\'Aube d\'argent à l\'intérieur de la prison à proximité.‡赤色烈焰礼拜堂的骑士团指挥官普雷菲斯特希望你去探视牢房里的银色黎明俘虏，安东尼·布拉克，并结束他的痛苦。‡赤紅之焰禮拜堂的騎士指揮官瘟疫之拳命令你處決附近牢房裡關押的銀色黎明囚犯，安東尼·布瑞克。',
  }
},
[12751] = {
  {
    'Um pouco como voltar pra casa‡Возвращение домой‡So etwas wie Heimkehr‡일종의 귀향‡Como volver a casa‡Como volver a casa‡Un retour au pays... en quelque sorte‡欢迎回家‡算是光榮返鄉',
    nil,
    'Fale novamente com Thassarian, na Taberna Escarlate de Nova Avalon, e conte-lhe sobre a sua vitória.‡Возвращайтесь к Тассариану в Таверну Алого ордена, что в Новом Авалоне, и сообщите ему о вашей победе.‡Überbringt Thassarian in der Scharlachroten Taverne in Neu-Avalon die Nachricht Eures Sieges.‡승리의 소식을 가지고 신 아발론의 붉은십자군 선술집에 있는 타사리안에게 돌아가야 합니다.‡Vuelve a Thassarian en la Taberna Escarlata de Nuevo Avalon con noticias de tu victoria.‡Vuelve a Thassarian en la Taberna Escarlata de Nuevo Avalon con noticias de tu victoria.‡Retournez voir Thassarian dans la Taverne écarlate à la Nouvelle-Avalon et rapportez-lui la nouvelle de votre victoire.‡向新阿瓦隆血色旅店的萨萨里安汇报你胜利的消息。‡帶著你勝利的消息返回新亞法隆的血色旅店找薩沙理安。',
  }
},
[12752] = {
  {
    '‡Отчаянный поиск‡Verzweifelte Forschung‡필사적인 조사‡Investigación desesperada‡Investigación desesperada‡Recherche désespérée‡绝望的研究‡孤注一擲的研究',
    nil,
    '‡Поговорите с верховным аптекарем Гнилессом в новом аптекарском лагере на Террасе Света в Шаттрате.‡Sprecht mit Großapotheker Putress im neuen Apothekerlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새 연금술사 주둔지에서 대연금술사 퓨트리스와 대화해야 합니다.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Parlez au Grand apothicaire Putrescin, au nouveau Camp des Apothicaires sur la Terrasse de la Lumière à Shattrath.‡‡',
  }
},
[12753] = {
  {
    '‡Вынужденный союз‡Eine verzweifelte Allianz‡필사적인 얼라이언스‡Una alianza desesperada‡Una alianza desesperada‡Une alliance désespérée‡绝望的联军‡孤注一擲的聯盟',
    nil,
    '‡Поговорите с епископом Лазарил в новом лагере Альянса на Террасе Света в Шаттрате.‡Sprecht mit Bischöfin Lazaril im neuen Allianzlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새로운 얼라이언스 주둔지에 있는 주교 라자릴과 대화해야 합니다.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Parlez à l\'Évêque Lazaril au Nouveau campement de l\'Alliance à la Terrasse de la Lumière, à Shattrath.‡‡',
  }
},
[12754] = {
  {
    'Emboscada no penhasco‡Засада в укреплении‡Überfall am Rundblick‡전망대 매복‡Emboscada en el mirador‡Emboscada en el mirador‡Embuscade au surplomb‡悬崖伏击‡瞰臺伏擊',
    nil,
    'Orbaz Ruinassangue, na Taberna Escarlate, em Nova Avalon, quer que você mate o Mensageiro Escarlate e roube os Pertences do Mensageiro Escarlate e a Mensagem do Mensageiro Escarlate.‡Орбаз Кровопорч из Таверны Алого ордена в Новом Авалоне приказал вам убить курьера Алого ордена и забрать его пожитки и депешу.‡Orbaz Blutbann in der Scharlachroten Taverne in Neu-Avalon hat Euch befohlen, den Scharlachroten Kurier zu töten und seine Sachen und die Nachricht zu beschaffen.‡신 아발론의 붉은십자군 선술집에 있는 오르바즈 블러드베인이 붉은십자군 급사를 처치하고 붉은십자군 급사의 소지품과 붉은십자군 급사의 전갈을 가져오라고 명령했습니다.‡Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon te ha ordenado que mates al mensajero Escarlata y que recuperes las pertenencias del mensajero Escarlata y el mensaje del mensajero Escarlata.‡Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon te ha ordenado que mates al mensajero Escarlata y que recuperes las pertenencias del mensajero Escarlata y el mensaje del mensajero Escarlata.‡Orbaz Sangreplaie à la Taverne écarlate à la Nouvelle-Avalon vous a ordonné de tuer le Courrier écarlate et de récupérer les Possessions du courrier écarlate, ainsi que le Message du courrier écarlate.‡新阿瓦隆血色旅店内的奥尔巴兹·血毒要求你击败血色信使，并收集血色信使的衣物和血色信使的信件。‡位於新亞法隆中，血色旅店內的歐貝茲·血禍命令你殺死血色信差並取回血色信差的所有物，以及血色信差的信息。',
  }
},
[12755] = {
  {
    'Um encontro com o destino‡Встреча с судьбой‡Begegnung mit dem Schicksal‡운명과 만나다‡Una reunión con el destino‡Una reunión con el destino‡Une rencontre avec le destin‡命运的交汇点‡與命運相見',
    nil,
    'Orbaz Ruinassangue quer que você entregue a Mensagem do Mensageiro Escarlate para a General-de-exército Abbendis, no Porto Real.‡Орбаз Кровопорч приказал вам доставить депешу курьера Алого ордена верховному генералу Аббендис в Королевскую гавань.‡Orbaz Blutbann hat Euch befohlen, die Nachricht des Scharlachroten Kuriers bei Hochgeneral Abbendis im Hafen des Königs abzuliefern.‡오르바즈 블러드베인이 왕의 항구에 있는 고위사령관 아벤디스에게 붉은십자군 급사의 전갈을 전달하라고 명령했습니다.‡Orbaz Malasangre te ha ordenado que entregues el mensaje del mensajero escarlata a la alta general Abbendis en Puerto del Rey.‡Orbaz Malasangre te ha ordenado que entregues el mensaje del mensajero escarlata a la alta general Abbendis en Puerto del Rey.‡Orbaz Sangreplaie vous a ordonné de livrer le Message du courrier écarlate au Grand général Abbendis à Port-royal.‡奥尔巴兹·血毒命令你将血色信使的信件交给国王港的阿比迪斯将军。‡歐貝茲·血禍命令你把血色信差的信息送去國王港給大將軍阿比迪斯。',
  }
},
[12756] = {
  {
    'Surge a Ofensiva Escarlate‡Алый Натиск‡Der Scharlachrote Ansturm tritt hervor‡붉은돌격대가 일어나다‡El Embate Escarlata aparece‡El Embate Escarlata aparece‡L\'Assaut écarlate émerge‡血色先锋军‡血色突襲軍出線',
    nil,
    'Entregue O Caminho da Redenção a Orbaz Ruinassangue na Taberna Escarlate, que fica em Nova Avalon.‡Отнесите Путь Искупления Орбазу Кровопорчу в Таверну Алого ордена в Новом Авалоне.‡Liefert das Buch "Der Weg der Erlösung" bei Orbaz Blutbann in der Scharlachroten Taverne in Neu-Avalon ab.‡신 아발론에 있는 붉은십자군 선술집으로 가서 오르바즈 블러드베인에게 구원의 길을 전달해야 합니다.‡Entrega El Camino de la Redención a Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon.‡Entrega El Camino de la Redención a Orbaz Malasangre en la Taberna Escarlata de Nuevo Avalon.‡Donnez le Chemin de la rédemption à Orbaz Sangreplaie dans la Taverne écarlate à la Nouvelle-Avalon.‡将《救赎之路》交给新阿瓦隆血色旅店内的奥尔巴兹·血毒。‡將「救贖之途」帶到新亞法隆的血色旅店交給歐貝茲·血禍。',
  }
},
[12757] = {
  {
    'Os exércitos da Cruzada se aproximam...‡Теплый прием для армий Алого ордена‡Die Armeen des Scharlachroten Ansturms rücken näher...‡붉은십자군 군대가 다가온다...‡El ejército escarlata se acerca…‡El ejército escarlata se acerca…‡L\'approche des armées écarlates‡血色十字军进犯……‡血色軍隊迫近…',
    nil,
    'Entregue O Caminho da Redenção para o Grão-lorde Dárion Mograine em Áquerus: a Fortaleza de Ébano.‡Отнесите Путь Искупления верховному лорду Дариону Могрейну в Акерус: Черный оплот.‡Liefert das Buch "Der Weg der Erlösung" bei Hochlord Darion Mograine in "Acherus: der Schwarzen Festung" ab.‡아케루스: 칠흑의 요새에 있는 대영주 다리온 모그레인에게 구원의 길을 전달해야 합니다.‡Entrega El Camino de la Redención al alto señor Darion Mograine en Acherus: El Bastión de Ébano.‡Entrega El Camino de la Redención al alto señor Darion Mograine en Acherus: El Bastión de Ébano.‡Donnez le Chemin de la rédemption au Généralissime Darion Mograine à Achérus : le fort d\'Ébène.‡将《救赎之路》交给黑锋要塞阿彻鲁斯内的大领主达里安·莫格莱尼。‡將救贖之途交給在亞榭洛:黯黑堡的大領主達利安·莫格萊尼。',
  }
},
[12758] = {
  {
    'O elmo de um herói‡Шлем героя‡Des Helden Helm‡영웅의 머리보호구‡Un casco de héroe‡Un casco de héroe‡Un couvre-chef de héros‡英雄的头盔‡英雄的頭盔',
    nil,
    'Pegue os Explosivos da Empreendimentos S.A. de qualquer uma das unidades da Empreendimentos S.A. na Escavação do Caloteiro e use-os para obter a Cabeça do Vigilante da Tempestade. Leve a Cabeça do Vigilante da Tempestade para Rejek, no Morro dos Feralma.‡Заполучите взрывчатку у любого члена Торговой Компании возле Раскопа Хитрохмыла и используйте ее, чтобы заполучить голову наблюдателя бурь. Принесите голову на холм Бешеного Сердца и отдайте Реджеку.‡Besorgt Sprengstoff der Venture Co. von der Venture Company in Schwindelgrins\' Grabungsstätte und benutzt ihn, um den Kopf eines Sturmbetrachters zu erhalten. Bringt Rejek beim Hügel der Wildherzen den Kopf des Sturmbetrachters.‡스윈들그린의 채굴현장에서 투자개발회사에 소속된 자를 처치하고 얻은 투자개발회사 다이너마이트로 폭풍감시자의 머리를 구해 광란의심장 언덕에 있는 레이제크에게 가져와야 합니다.‡Consigue explosivos Ventura y Cía. de cualquier unidad de Ventura y Cía. en la Excavación de Timomueca y úsalos para obtener una cabeza de vigía de tormenta. Lleva la cabeza de vigía de tormenta a Rejek en la Colina Corazón Frenético.‡Consigue explosivos Ventura y Cía. de cualquier unidad de Ventura y Cía. en la Excavación de Timomueca y úsalos para obtener una cabeza de vigía de tormenta. Lleva la cabeza de vigía de tormenta a Rejek en la Colina Corazón Frenético.‡Récupérez des Explosifs de la KapitalRisk sur n\'importe quelle unité de la KapitalRisk, au Site de fouilles de Ricarnaque, et utilisez-les pour obtenir la Tête d\'un Guette-tempête. Apportez-la ensuite à Rejek à la Colline de Frénécœur.‡前往斯温迪格林挖掘场，从风险投资公司的驻地搞到风险投资公司炸药，然后使用它们获得风暴看守的头盔。将风暴看守的头盔交给狂心岭的雷耶克。‡從詐咧挖掘場的風險投資公司裝置上取得風險投資公司爆裂物，使用它們來取得風暴看守者的頭顱。將風暴看守者的頭顱帶到狂心之丘交給瑞傑克。',
  }
},
[12759] = {
  {
    'Ferramentas de guerra‡Орудия войны‡Instrument des Krieges‡전쟁 도구‡Herramientas de guerra‡Herramientas de guerra‡De drôle d\'outils de guerre‡战争的工具‡戰爭工具',
    nil,
    'Pegue as armadilhas de Zepik do estoque na Aldeia de Kartak. Use as armadilhas para matar 50 Gorlocs de Piscabrilha e fale com o Xamã Jakjek, na Aldeia de Kartak.‡Раздобудьте несколько ловушек Зепика из форта Картака. Используя ловушки, убейте 50 горлоков из племени Заиндевелых, а затем вернитесь к шаману Якжеку в форт Картака.‡Holt einige von Zepiks Fallen aus seiner Truhe in Kartaks Stellung. Verwendet die Fallen, um 50 der sich in der Nähe aufhaltenden, funkenbesprühten Gorlocs zu töten, dann kehrt zu Schamane Jakjek in Kartaks Stellung zurück.‡카르탁의 요새에 있는 보관함에서 제피크의 덫을 꺼내십시오. 덫을 사용하여 가까이에 있는 번개불꽃골록 50마리를 처치한 다음, 카르탁의 요새에 있는 주술사 자크제크에게 돌아가야 합니다.‡Coge algunas de las trampas de Zepik de su alijo en el Bastión de Kartak. Usando las trampas, mata a 50 de los górlocs Pavesa cercanos y vuelve junto al chamán Jakjek en el Bastión de Kartak.‡Coge algunas de las trampas de Zepik de su alijo en el Bastión de Kartak. Usando las trampas, mata a 50 de los górlocs Pavesa cercanos y vuelve junto al chamán Jakjek en el Bastión de Kartak.‡Récupérez certains des Pièges de Zepik dans son trésor au Bastion de Kartak. Utilisez-les pour tuer 50 Gorlocs touchétincelles, puis retournez voir le Chaman Jakjek au Bastion de Kartak.‡前往卡塔克要塞，取出被瑟匹克藏起来的陷阱。利用它们杀死50个灵鳍鳄鱼人，然后向卡塔克要塞的萨满祭司亚克耶克复命。‡從賽匹克在卡爾塔克堡的藏匿處中，取回一些陷阱。使用這些陷阱，屠殺附近50個炫觸戈洛克，然後回到卡爾塔克堡找薩滿賈克杰克。',
  }
},
[12760] = {
  {
    'Força Secreta dos Feralma‡Тайная сила племени Бешеного Сердца‡Geheime Kraft der Wildherzen‡광란의심장일족의 비밀스러운 힘‡Fuerza secreta de los Corazón Frenético‡Fuerza secreta de los Corazón Frenético‡La puissance secrète des Frénécœurs‡狂心氏族的秘密武器‡狂心的秘密力量',
    nil,
    'Use a bebida secreta dos Feralma para matar 30 Gorlocs de Piscabrilha na Aldeia de Kartak.‡Воспользовавшись силой секретного напитка племени Бешеного Сердца, перебейте 30 горлоков из племени Заиндевелых у форта Картака.‡Nutzt den geheimen Trank der Wildherzen und tötet mit der Kraft des Tranks 30 funkenbesprühte Gorlocs um Kartaks Stellung herum.‡이 비밀의 음료를 마시고 얻은 힘으로, 카르탁의 요새 근처에 있는 번개불꽃골록 30마리를 처치해야 합니다.‡Usando la bebida secreta de los Corazón Frenético, mata a 30 de los górlocs Pavesa que rodean el Bastión de Kartak.‡Usando la bebida secreta de los Corazón Frenético, mata a 30 de los górlocs Pavesa que rodean el Bastión de Kartak.‡Utilisez la boisson secrète frénécœur pour tuer 30 Gorlocs touchétincelles autour du Bastion de Kartak.‡喝下神秘的狂心氏族饮料，然后在卡塔克要塞附近消灭30个灵鳍鳄鱼人。‡喝下狂心秘密飲料，在卡爾塔克堡附近殺死30隻炫觸戈洛克。',
  }
},
[12761] = {
  {
    'Maestria dos cristais‡Власть над кристаллами‡Beherrschen der Kristalle‡수정 제어‡Dominio de los Cristales‡Dominio de los Cristales‡La maîtrise des cristaux‡掌握水晶‡水晶精通',
    nil,
    'Recupere as defesas de cristal no Refúgio Piscabrilha e use-as para matar 50 guaxinantes Feralma. Quando concluir as tarefas, fale com o Traztrovão Soo-met no Refúgio Piscabrilha.‡Добудьте кристаллы в Заиндевелой гавани и используйте их, чтобы убить 50 волчеров Бешеного Сердца, находящихся поблизости. Выполнив задание, возвращайтесь к призывателю молний Су-мету в Заиндевелую гавань.‡Erlangt die Verteidigung des Kristalls in der Zuflucht der Funkenbesprühten und verwendet sie, um 50 in der Nähe befindliche Wildherzwolvar zu töten. Kehrt zu Blitzrufer Soo-met in der Zuflucht der Funkenbesprühten zurück, sobald diese Aufgaben abgeschlossen sind.‡번개불꽃 안식처에서 수정 방어물을 찾은 다음 그 힘으로 근처에 있는 광란의심장일족 울바르 50마리를 처치해야 합니다. 이 임무를 마치고 나면, 번개불꽃 안식처에 있는 번개부름이 수멧에게 돌아가야 합니다.‡Recupera las defensas de cristal en el Retiro Pavesa y utilízalos para matar 50 Corazones Frenéticos wolvar. Cuando acabes, vuelve con Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Recupera las defensas de cristal en el Retiro Pavesa y utilízalos para matar 50 Corazones Frenéticos wolvar. Cuando acabes, vuelve con Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Récupérez les Défenses de cristal au Havre Touchétincelle et utilisez-les pour tuer 50 Varleus frénécœurs. Une fois la tâche effectuée, retournez voir le Mandefoudre Soo-briquet au Havre Touchétincelle.‡拿到灵鳍湾的防御水晶，借助水晶的力量杀死附近的50个狂心狼獾人。完成任务后向灵鳍湾的唤雷者索乌米特复命。‡前往炫觸避風港並且取得水晶防護。使用水晶防護殺死附近的50隻狂心獾狼怪。|n|n等這些工作都完成，回去找炫觸避風港的喚雷者蘇-邁特。',
  }
},
[12762] = {
  {
    'Poder dos Grandiosos‡Могущество Великих‡Macht der Großen‡위대한 자들의 힘‡Poder de los Magnos‡Poder de los Magnos‡Le pouvoir des Tout-puissants‡造物主的力量‡偉大諸神的力量',
    nil,
    'Carregue o Cristal Polido Inativo no Pilar Sangue da Vida exposto. Vá ao Refúgio Piscabrilha e use o poder concedido pelo cristal para matar 30 guaxinantes Feralma. A seguir, fale com Traztrovão Soo-met no Refúgio Piscabrilha.‡Зарядите отполированный дремлющий кристалл возле колонны Жизненной Силы. Затем отправляйтесь в Заиндевелую гавань и используйте силу кристалла, чтобы убить 30 волчеров из стаи Бешеного Сердца, находящихся поблизости, и поговорите с Призывателем молний Су-метом в Заиндевелой гавани.‡Ladet den schlafenden polierten Kristall an der offenen Lebensblutsäule. Reist zur Zuflucht der Funkenbesprühten und verwendet die Kraft des Kristalls, um 30 der sich in der Nähe aufhaltenden Wolvar der Wildherzen zu töten. Sprecht anschließend mit Blitzrufer Soo-met in der Zuflucht der Funkenbesprühten.‡드러난 생명의 피 봉우리에서 잠든 채로 빛나는 수정에 힘을 불어넣으십시오. 번개불꽃 안식처로 가서 수정의 힘을 받아 근처에 있는 광란의심장일족 울바르 30마리를 처치한 다음, 번개불꽃 안식처에 있는 번개부름이 수멧에게 보고해야 합니다.‡Carga el cristal pulido durmiente en El Pilar Sangrevida expuesto. Viaja al Retiro Pavesa y usa el poder que confiere el cristal para matar a 30 de los wolvar Corazón Frenético cercanos. Después habla con el Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Carga el cristal pulido durmiente en El Pilar Sangrevida expuesto. Viaja al Retiro Pavesa y usa el poder que confiere el cristal para matar a 30 de los wolvar Corazón Frenético cercanos. Después habla con el Clamarelámpagos Soo-notone en el Retiro Pavesa.‡Chargez le Cristal dormant poli au Pilier Sang-de-vie découvert. Rendez-vous au Havre Touchétincelle et utilisez le pouvoir contenu dans le cristal pour massacrer 30 Varleus frénécœurs, puis parlez au Mandefoudre Soo-briquet au Havre Touchétincelle.‡在源血之柱的暴露部分附近为休眠的无瑕水晶充能。前往灵鳍湾，使用水晶的能量杀死附近的30个狂心狼獾人，然后与灵鳍湾的唤雷者索乌米特谈一谈。‡利用暴露出來的活血之柱替休眠拋光水晶充能。前往炫觸避風港，用水晶給你的能量殺死30個附近的狂心獾狼怪，然後把你的成果告訴炫觸避風港的喚雷者蘇-邁特。',
  }
},
[12763] = {
  {
    'Alteração de prioridades‡Смена приоритетов‡Verschiebung von Prioritäten‡전황 변화‡Cambio de prioridades‡Cambio de prioridades‡Changement de priorités‡前线告急‡重點移轉',
    nil,
    'O batedor Vor\'takh quer que você vá até Zul\'Drak e se apresente à Sargento Riannah no Campo da Luz.|n|nMakki Vento de Inverno, no Acampamento Onequah, fornecerá o transporte.‡Разведчик Вор\'такх просит вас отправиться в Зул\'Драк и разыскать сержанта Рианну в Разломе Света.|n|nВам укажет дорогу Макки Зимний Ветер.‡Späher Vor\'takh möchte, dass Ihr nach Zul\'Drak reist und Euch bei Unteroffizier Riannah an der Lichtbresche meldet.|n|nMakki Orkan im Lager Oneqwah wird für Euren Transport sorgen.‡척후병 보르타크가 줄드락으로 이동해 빛의 틈에 있는 하사관 리안나에게 보고하라고 했습니다.|n|n원크와 야영지에 있는 마키 윈터게일이 이동 수단을 제공해 줄 것입니다.‡El explorador Vor\'takh quiere que vayas a Zul\'Drak y que informes a la sargento Riannah en la Brecha de la Luz.|n|nMakki Vendaval de Invierno en el Campamento Onequah te ofrecerá medio de transporte.‡El explorador Vor\'takh quiere que vayas a Zul\'Drak y que informes a la sargento Riannah en la Brecha de la Luz.|n|nMakki Vendaval de Invierno en el Campamento Onequah te ofrecerá medio de transporte.‡L\'Éclaireur Vor\'takh veut que vous vous rendiez à Zul\'Drak et que vous vous présentiez au sergent Riannah à la Brèche de Lumière.|n|nMakki Trombe-de-l\'hiver, au Camp Onequah, vous aidera à vous y rendre.‡斥候沃塔肯要你前往祖达克的圣光据点，向莉安娜中士报到。|n|n欧尼瓦营地的玛吉·冬风会提供前往圣光据点的交通工具。‡斥候沃塔克要你前往祖爾德拉克回報聖光止境的瑞安娜中士。|n|n歐尼克瓦營地的邁基·冬風會提供你交通工具。',
  }
},
[12764] = {
  {
    '‡Секрет кунгалуша‡Das Geheimnis von Kungaloosh‡‡El secreto de Kungaloosh‡El secreto de Kungaloosh‡Le secret du kungaloosh‡康加露酒的秘密‡康加露酒的秘密',
    nil,
    nil,
  }
},
[12765] = {
  {
    '‡Кунгалуш‡Kungaloosh‡‡Kungaloosh‡Kungaloosh‡Kungaloosh‡康加露酒 (DEPRECATED)‡康加露酒',
    nil,
    nil,
  }
},
[12766] = {
  {
    'Fale com a embaixadora‡Разговор с послом‡Sprecht mit Eurem Abgesandten‡사절 만나기‡Habla con tu embajadora‡Habla con tu embajadora‡Parler avec l\'ambassadrice‡与你们的大使相谈‡與你的大使談談',
    nil,
    'Fale com Lauriel Gumecerto no Templo do Repouso das Serpes.‡Поговорите с Лориэль Верный Клинок в храме Драконьего Покоя.‡Sprecht mit Lauriel Wahrklinge im Wyrmruhtempel.‡고룡쉼터 사원에 있는 라우리엘 트루블레이드와 이야기해야 합니다.‡Habla con Lauriel Filoveraz en el Templo del Reposo del Dragón.‡Habla con Lauriel Filoveraz en el Templo del Reposo del Dragón.‡Parler avec Lauriel Lamevraie au Temple du Repos du ver.‡与龙眠神殿的劳莉耶尔·图布雷谈一谈。‡與龍眠神殿的洛瑞爾·真刃談談。',
  }
},
[12767] = {
  {
    'Fale com o embaixador‡Разговор с послом‡Sprecht mit Eurem Abgesandten‡사절 만나기‡Habla con tu embajador‡Habla con tu embajador‡Parler avec l\'ambassadeur‡与你们的大使相谈‡與你的大使談談',
    nil,
    'Fale com Golluck Punhopétreo no Templo do Repouso das Serpes.‡Поговорите с Голлуком Каменным Кулаком в храме Драконьего Покоя.‡Sprecht mit Golluck Felsenfaust im Wyrmruhtempel.‡고룡쉼터 사원에 있는 골루크 록피스트와 대화해야 합니다.‡Habla con Golluck Puño de Roca en el Templo del Reposo del Dragón.‡Habla con Golluck Puño de Roca en el Templo del Reposo del Dragón.‡Parler avec Golluck Poing-roc au Temple du Repos du ver.‡与龙眠神殿的古拉克·石拳谈一谈。‡與龍眠神殿的葛拉克·岩拳談談。',
  }
},
[12768] = {
  {
    'O Administrador do Templo do Repouso das Serpes‡Распорядитель храма Драконьего Покоя‡Der Wächter des Wyrmruhtempels‡고룡쉼터 사원의 청지기‡El administrador del Templo del Reposo del Dragón‡El administrador del Templo del Reposo del Dragón‡Le régisseur du temple du Repos du ver‡龙眠神殿的执事‡龍眠神殿管理者',
    nil,
    'Fale com Tariolstrasz no Templo do Repouso das Serpes.‡Поговорите с Тариолстразом в храме Драконьего Покоя.‡Sprecht mit Tariolstrasz im Wyrmruhtempel.‡고룡쉼터 사원에 있는 타리올스트라즈와 이야기해야 합니다.‡Habla con Tariolstrasz en el Templo del Reposo del Dragón.‡Habla con Tariolstrasz en el Templo del Reposo del Dragón.‡Parler à Tariolstrasz au Temple du Repos du ver.‡与龙眠神殿的塔里奥斯塔兹谈一谈。‡和龍眠神殿的泰瑞歐斯塔茲交談。',
  }
},
[12769] = {
  {
    'O Administrador do Templo do Repouso das Serpes‡Распорядитель храма Драконьего Покоя‡Der Wächter des Wyrmruhtempels‡고룡쉼터 사원의 청지기‡El administrador del Templo del Reposo del Dragón‡El administrador del Templo del Reposo del Dragón‡Le régisseur du temple du Repos du ver‡龙眠神殿的执事‡龍眠神殿管理者',
    nil,
    'Fale com Tariolstrasz no Templo do Repouso das Serpes.‡Поговорите с Тариолстразом в храме Драконьего Покоя.‡Sprecht mit Tariolstrasz im Wyrmruhtempel.‡고룡쉼터 사원에 있는 타리올스트라즈와 이야기해야 합니다.‡Habla con Tariolstrasz en el Templo del Reposo del Dragón.‡Habla con Tariolstrasz en el Templo del Reposo del Dragón.‡Parler à Tariolstrasz au Temple du Repos du ver.‡与龙眠神殿的塔里奥斯塔兹谈一谈。‡和龍眠神殿的泰瑞歐斯塔茲交談。',
  }
},
[12770] = {
  {
    'Realocando recursos‡Перераспределение‡Umverteilung der Ressourcen‡인력 재배치‡Redistribuir los recursos‡Redistribuir los recursos‡Répartition des ressources‡资源调配‡資源調度',
    nil,
    'Miguel Mantoforte quer que você se apresente à Sargento Riannah, no Campo da Luz, em Zul\'Drak.|n|nFale com Samuel Calbuque para arranjar transporte para Campo da Luz.‡Гриан Камнегрив отправил вас к сержанту Рианне в Разлом Света, находящийся в Зул\'Драке.|n|nОбратитесь к Самуэлю Клирбуку, и он доставит вас на место.‡Gryan Starkmantel will, dass Ihr Euch bei Unteroffizier Riannah an der Lichtbresche in Zul\'Drak meldet.|n|nIhr könnt wegen einer Transportmöglichkeit zur Lichtbresche bei Samuel Klarbuch vorsprechen.‡그라이언 스타우트맨틀이 줄드락의 빛의 틈에 있는 하사관 리안나에게 보고해 달라고 했습니다.|n|n사무엘 클리어북과 이야기하면 빛의 틈으로 가는 그리핀을 탈 수 있습니다.‡Gryan Mantorrecio quiere que te presentes ante la sargento Riannah en la Brecha de la Luz en Zul\'Drak.|n|nPuedes hablar con Samuel Libroclaro para que te proporcione un transporte a la Brecha de la Luz.‡Gryan Mantorrecio quiere que te presentes ante la sargento Riannah en la Brecha de la Luz en Zul\'Drak.|n|nPuedes hablar con Samuel Libroclaro para que te proporcione un transporte a la Brecha de la Luz.‡Gryan Roidemantel veut que vous vous présentiez au Sergent Riannah à la Brèche de Lumière, dans Zul\'Drak.|n|nParlez à Samuel Livrouvert pour être transporté à l\'Espoir de Lumière.‡格里安·斯托曼要你前往祖达克的圣光据点，向莉安娜中士报到。|n|n萨缪尔·克莱布克会提供前往圣光据点的交通工具。‡格里安·斯托曼要你向聖光止境的瑞安娜中士報到，位於祖爾德拉克之中。|n|n你可以與山繆·克里爾布克談話，他會送你去聖光止境。',
  }
},
[12771] = {
  {
    '‡Стальгорн‡Eisenschmiede‡아이언포지‡Forjaz‡Forjaz‡Forgefer‡铁炉堡‡鐵爐堡',
    nil,
    '‡Епископ Лазарил просит вас отнести заряженный Светом артефакт королю Магни Бронзобороду в Стальгорн.‡Bischöfin Lazaril möchte, dass Ihr das lichterfüllte Artefakt zu König Magni Bronzebart in Eisenschmiede bringt.‡‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al rey Magni Barbabronce en Forjaz.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al rey Magni Barbabronce en Forjaz.‡L\'Evêque Lazaril vous demande d\'apporter l\'Artéfact imprégné de Lumière au Roi Magni Barbe-de-bronze à Forgefer.‡‡',
  }
},
[12772] = {
  {
    '‡Вынужденный союз‡Eine verzweifelte Allianz‡필사적인 얼라이언스‡Una alianza desesperada‡Una alianza desesperada‡Une alliance désespérée‡绝望的联军‡孤注一擲的聯盟',
    nil,
    '‡Поговорите с епископом Лазарил в новом лагере Альянса на Террасе Света в Шаттрате.‡Sprecht mit Bischöfin Lazaril im neuen Allianzlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새로운 얼라이언스 주둔지에 있는 주교 라자릴과 대화해야 합니다.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Parlez à l\'Évêque Lazaril au Nouveau campement de l\'Alliance à la Terrasse de la Lumière, à Shattrath.‡‡',
  }
},
[12773] = {
  {
    '‡Дарнас‡Darnassus‡다르나서스‡Darnassus‡Darnassus‡Darnassus‡达纳苏斯‡達納蘇斯',
    nil,
    '‡Епископ Лазарил просит вас отнести заряженный Светом артефакт Тиранде Шелест Ветра в Дарнас.‡Bischöfin Lazaril möchte, dass Ihr das lichterfüllte Artefakt zu Tyrande Wisperwind in Darnassus bringt.‡주교 라자릴이 다르나서스에 있는 티란데 위스퍼윈드에게 빛이 깃든 유물을 가져가 달라고 했습니다.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida a Tyrande Susurravientos en Darnassus.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida a Tyrande Susurravientos en Darnassus.‡L\'Evêque Lazaril vous demande d\'apporter l\'Artéfact imprégné de Lumière à Tyrande Murmevent à Darnassus.‡‡',
  }
},
[12774] = {
  {
    '‡Штормград‡Sturmwind‡스톰윈드‡Ventormenta‡Ventormenta‡Hurlevent‡暴风城‡暴風城',
    nil,
    '‡Епископ Лазарил просит вас отнести заряженный Светом артефакт королю Вариану Ринну в Штормград.‡Bischöfin Lazaril möchte, dass Ihr das lichterfüllte Artefakt zu König Varian Wrynn in Sturmwind bringt.‡‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al rey Varian Wrynn en Ventormenta.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al rey Varian Wrynn en Ventormenta.‡L\'Evêque Lazaril vous demande d\'apporter l\'Artéfact imprégné de Lumière au Roi Varian Wrynn à Hurlevent.‡‡',
  }
},
[12775] = {
  {
    '‡Вынужденный союз‡Eine verzweifelte Allianz‡필사적인 얼라이언스‡Una alianza desesperada‡Una alianza desesperada‡Une alliance désespérée‡绝望的联军‡孤注一擲的聯盟',
    nil,
    '‡Поговорите с епископом Лазарил в новом лагере Альянса на Террасе Света в Шаттрате.‡Sprecht mit Bischöfin Lazaril im neuen Allianzlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새로운 얼라이언스 주둔지에 있는 주교 라자릴과 대화해야 합니다.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Parlez à l\'Évêque Lazaril au Nouveau campement de l\'Alliance à la Terrasse de la Lumière, à Shattrath.‡‡',
  }
},
[12776] = {
  {
    '‡Экзодар‡Die Exodar‡엑소다르‡El Exodar‡El Exodar‡L\'Exodar‡埃索达‡埃索達',
    nil,
    '‡Епископ Лазарил просит вас отнести заряженный Светом артефакт Велену в Экзодар.‡Bischöfin Lazaril möchte, dass Ihr das lichterfüllte Artefakt bei Velen in der Exodar abliefert.‡주교 라자릴이 엑소다르에 있는 벨렌에게 빛이 깃든 유물을 가져가 달라고 했습니다.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida a Velen en El Exodar.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida a Velen en El Exodar.‡L\'Evêque Lazaril vous demande d\'apporter l\'Artéfact infusé de lumière à Velen, à l\'Exodar.‡‡',
  }
},
[12777] = {
  {
    '‡Вынужденный союз‡Eine verzweifelte Allianz‡필사적인 얼라이언스‡Una alianza desesperada‡Una alianza desesperada‡Une alliance désespérée‡绝望的联军‡絕望的聯軍',
    nil,
    '‡Поговорите с епископом Лазарил в новом лагере Альянса на Террасе Света в Шаттрате.‡Sprecht mit Bischöfin Lazaril im neuen Allianzlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새로운 얼라이언스 주둔지에 있는 주교 라자릴과 대화해야 합니다.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Parlez à l\'Évêque Lazaril au Nouveau campement de l\'Alliance à la Terrasse de la Lumière, à Shattrath.‡‡',
  }
},
[12778] = {
  {
    'O apocalipse escarlate‡Конец Алого ордена‡Das Ende des Scharlachroten Kreuzzugs‡붉은십자군 대참사‡El apocalipsis escarlata‡El apocalipsis escarlata‡L\'apocalypse écarlate‡血色十字军的末日‡血色天啟',
    nil,
    'Encontre o Lich Rei na Vanguarda da Morte.‡Найдите Короля-лича в Разломе Смерти.‡Geht zur Todesbresche und sucht den Lichkönig auf.‡죽음의 틈에서 리치 왕을 찾아야 합니다.‡Busca al Rey Exánime en la Brecha de la Muerte.‡Busca al Rey Exánime en la Brecha de la Muerte.‡Cherchez le Roi-liche à Brèche-de-Mort.‡在死亡裂口找到巫妖王。‡找到死亡止境的巫妖王。',
  }
},
[12779] = {
  {
    'O fim de todas as coisas‡Конец всему...‡Alle Dinge müssen ein Ende...‡모든 일의 끝‡Un final para todas las cosas…‡Un final para todas las cosas…‡La fin de toutes choses…‡万物的终结……‡萬事萬物的終結……',
    nil,
    'O Lich Rei quer que você erradique a Cruzada Escarlate.|n|nUse o Chifre de Ninhálgida para convocar um Conquistador Ninhálgida e, com ele, mate 150 Soldados Escarlates e destrua 10 Balistas Escarlates. Desvie-se dos projéteis que vão em sua direção saindo da linha de fogo!‡Король-лич приказал вам покончить с Алым орденом.|n|nВозьмите рог ледяного наследия и призовите ледяного покорителя, с помощью которого вам надо будет убить 150 солдат из Алого ордена и уничтожить 10 баллист Алого ордена. Постарайтесь не попасть под обстрел и вовремя уходите с линии огня!‡Der Lichkönig hat Euch befohlen, den Scharlachroten Kreuzzug auszuradieren.|n|nBenutzt das Horn der Frostbrut, um einen Frostbrutbezwinger herbeizurufen und mit ihm 150 Scharlachrote Soldaten und 10 Scharlachrote Ballisten zu vernichten. Weicht Geschossen aus, indem Ihr aus ihrer Schusslinie fliegt!‡리치 왕이 붉은십자군을 완전히 없애라고 명했습니다.|n|n서리고룡족의 뿔피리를 사용해 서리고룡족 제압자를 불러낸 후, 붉은십자군 병사 150명과 붉은십자군 쇠뇌 10개를 없애야 합니다. 적이 발사하는 투사체에 맞지 않도록 조준선에서 벗어나십시오!‡El Rey Exánime te ha ordenado que acabes con la Cruzada Escarlata.|n|nUsa el cuerno de Razaescarcha para llamar al vencedor Razaescarcha, matar a 150 soldados Escarlata y aniquilar a 10 balistas Escarlatas. ¡Evita proyectiles del contrario saliendo de su línea de tiro!‡El Rey Exánime te ha ordenado que acabes con la Cruzada Escarlata.|n|nUsa el cuerno de Razaescarcha para llamar al vencedor Razaescarcha, matar a 150 soldados Escarlata y aniquilar a 10 balistas Escarlatas. ¡Evita proyectiles del contrario saliendo de su línea de tiro!‡Le Roi-liche vous a ordonné d\'éradiquer la Croisade écarlate.|n|nUtilisez le Cor des Couvegivres pour invoquer un Vainqueur couvegivre. Avec son aide, tuez 150 Soldats écarlates et détruisez 10 Balistes écarlates. Évitez les projectiles en sortant de leur ligne de tir !‡巫妖王命令你消灭血色十字军。|n|n使用冰霜巨龙号角召唤出一条冰霜征服者，和它一起击败150名血色十字军士兵，并摧毁10台血色弩车。灵活地飞出他们的射程，免得自己被乱箭射穿！‡巫妖王命令你徹底滅絕血色十字軍。|n|n使用霜育號角召喚一隻霜育鎮壓者，殺死150名血色士兵和摧毀10台血色弩砲。避開他們的彈道以閃躲來襲的砲火!',
  }
},
[12780] = {
  {
    'DEPRICATED>>Enemy of Our Enemy‡ИСПОРЧЕНО>>Враг наших врагов‡Der Feind unseres Feindes‡적의 적은 친구‡DEPRICATED>>Enemy of Our Enemy‡DEPRICATED>>Enemy of Our Enemy‡PÉRIMÉ>>L\'ennemi de notre ennemi‡敌人的敌人‡廢棄>>敵人的敵人',
    nil,
    'Sergeant Riannah in Light\'s Breach wants you to speak with Stefan in Ebon Watch and offer your assistance.‡По поручению сержанта Рианны из Разлома Света поговорите со Стефаном на Черной заставе и предложите ему свою помощь.‡Unteroffizier Riannah in der Lichtbresche möchte, dass Ihr mit Stefan in der Schwarzen Wacht sprecht und ihm Eure Unterstützung anbietet.‡빛의 틈에 있는 하사관 리안나가 칠흑의 감시초소에 있는 스테판을 찾아가 도움을 주라고 부탁했습니다.‡La sargento Riannah de la Brecha de la Luz quiere que hables con Stefan del Puesto de Vigilancia de Ébano y que le ofrezcas tu ayuda.‡La sargento Riannah de la Brecha de la Luz quiere que hables con Stefan del Puesto de Vigilancia de Ébano y que le ofrezcas tu ayuda.‡Le Sergent Riannah à la Brèche de Lumière veut que vous parliez à Stefan au Guet d\'Ébène et que vous lui offriez votre aide.‡圣光据点的莉安娜中士要你去跟黑锋哨站的斯特凡谈一谈，并向他提供帮助。‡聖光止境的瑞安娜中士要你和黯黑守望的史戴芬談談，並且提供你的協助。',
  }
},
[12781] = {
  {
    'Boas-vindas!‡Добро пожаловать!‡Willkommen!‡환영합니다!‡¡Te damos la bienvenida!‡¡Te damos la bienvenida!‡Bienvenue !‡欢迎！‡歡迎!',
    nil,
    'Entregue o Vale-brinde da Fortaleza de Ébano para Siouxsie, a Banshee, na Fortaleza de Ébano.‡Отнесите подарочный сертификат Черного Оплота в Черный Оплот и отдайте его Банши Сиокси.‡Bringt den Geschenkgutschein der Schwarzen Festung zu Siouxsie der Banshee in der Schwarzen Festung.‡칠흑의 요새에 있는 밴시 시우크시에게 칠흑의 요새 선물교환권을 가져가야 합니다.‡Lleva el vale regalo de El Bastión de Ébano a Siouxsie el alma en pena en El Bastión de Ébano.‡Lleva el vale regalo de El Bastión de Ébano a Siouxsie el alma en pena en El Bastión de Ébano.‡Apportez le Bon-cadeau du Fort d\'Ébène à Siouxsie la banshee au Fort d\'Ébène.‡将黑锋要塞礼品券交给黑锋要塞的女妖希奥克丝。‡將黯黑堡禮品券交給黯黑堡的『女妖』席厄克希。',
  }
},
[12782] = {
  {
    '‡Отчаянный поиск‡Verzweifelte Forschung‡필사적인 조사‡Investigación desesperada‡Investigación desesperada‡Recherche désespérée‡绝望的研究‡孤注一擲的研究',
    nil,
    '‡Поговорите с верховным аптекарем Гнилессом в новом аптекарском лагере на Террасе Света в Шаттрате.‡Sprecht mit Großapotheker Putress im neuen Apothekerlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새 연금술사 주둔지에서 대연금술사 퓨트리스와 대화해야 합니다.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Parlez au Grand apothicaire Putrescin, au nouveau Camp des Apothicaires sur la Terrasse de la Lumière à Shattrath.‡‡',
  }
},
[12783] = {
  {
    '‡Отчаянный поиск‡Verzweifelte Forschung‡필사적인 조사‡Investigación desesperada‡Investigación desesperada‡Recherche désespérée‡绝望的研究‡孤注一擲的研究',
    nil,
    '‡Поговорите с верховным аптекарем Гнилессом в новом аптекарском лагере на Террасе Света в Шаттрате.‡Sprecht mit Großapotheker Putress im neuen Apothekerlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새 연금술사 주둔지에서 대연금술사 퓨트리스와 대화해야 합니다.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Parlez au Grand apothicaire Putrescin, au nouveau Camp des Apothicaires sur la Terrasse de la Lumière à Shattrath.‡‡',
