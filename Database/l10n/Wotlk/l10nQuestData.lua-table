    nil,
  }
},
[65562] = {
  {
    'Tabardo das Chamas‡Гербовая накидка Пламени‡Wappenrock der Flamme‡화염의 휘장‡Tabardo de las llamas‡Tabardo de las llamas‡Tabard de flammes‡烈焰徽章‡烈焰外袍',
    nil,
    nil,
  }
},
[65593] = {
  {
    'Corações dos amantes‡Сердца влюбленных‡Herzen der Liebenden‡연인의 유품‡Los corazones de los amantes‡Corazón de los amantes‡Les cœurs des amoureux‡爱人的徽记‡戀人的心臟',
    nil,
    'Leve os corações de Avelina Lily e Isaac Pessoa para Silvério Hidalgo no Templo dos Malditos.‡Принесите сердца Авелины Лилли и Исаака Пирсона Карнедину Халгару в Храм Проклятых.‡Bringt die Herzen von Avelina Lilly und Isaac Pearson zu Carendin Halgar im Tempel der Verdammten.‡저주의 사원에 있는 카렌딘 할가르에게 아벨리나 릴리의 유품과 이삭 피어슨의 유품을 가져가야 합니다.‡Llévale los corazones de Avelina Lilly e Isaac Pearson a Carendin Halgar, que está en el Templo de los Condenados.‡Lleva el corazón de Avelina Lilly e Isaac Pearson a Carendin Halgar en el Templo de los Condenados.‡Apportez les Cœurs d’Avelina Lilly et d’Isaac Pearson à Carendin Halgar dans le Temple des Damnés.‡把阿薇丽娜·莉莉和艾萨克·皮尔森的徽记带给诅咒神殿的凯伦丁·哈加尔。‡把艾芙琳娜‧莉蕾和艾薩克‧佩爾森的心臟交給詛咒神殿的凱倫丁。',
  }
},
[65601] = {
  {
    'O amor machuca‡Несчастная любовь‡Liebe kann schmerzhaft sein‡사랑은 아프다‡El amor duele‡El amor duele‡Les affres de l’amour‡要爱就会受伤害‡痛心的愛',
    nil,
    'Fale com Magar em Orgrimmar.‡Поговорите с Магаром в Оргриммаре.‡Sprecht mit Magar in Orgrimmar.‡오그리마에 있는 마가르와 대화하십시오.‡Habla con Magar en Orgrimmar.‡Habla con Magar en Orgrimmar.‡Parlez à Magar, à Orgrimmar.‡和奥格瑞玛的玛加尔谈一谈。‡和奧格瑪的瑪加爾交談。',
  }
},
[65602] = {
  {
    'Amar é...‡Лучшие друзья‡Alles aus Liebe‡사랑이란 무얼까?‡¿Qué es el amor?‡¿Qué es el amor?‡Qu’est-ce que l’amour ?‡爱是什么？‡愛為何物?',
    nil,
    'Obtenha a Estatueta de Madeira e leve para Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Добудьте деревянную статуэтку и принесите ее Гакину Темнопряду в квартал магов Штормграда.‡Beschafft die Holzstatuette und bringt sie zu Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡목재 조각상을 찾아 스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Recupera la figurilla de madera y llévasela a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Recupera la figurilla de madera y llévasela a Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Récupérez la Figurine en bois et rapportez-la à Gakin le Tisse-noir, au Quartier des mages de Hurlevent.‡取得木雕，把它交给暴风城法师区里的黑暗缚灵者加科因。‡取回木雕刻像，然後交給暴風城法師區的『黑暗縛靈師』加金。',
  }
},
[65603] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El sometimiento‡Le lien‡束缚‡誓縛',
    nil,
    'Usando a Estatueta de Madeira, evoque e subjugue um íncubo. Depois, devolva a Estatueta de Madeira para Gakin, o Neromante, no Cordeiro Imolado.‡Воспользуйтесь деревянной статуэткой, чтобы призвать и подчинить инкуба, затем верните статуэтку Гакину Темнопряду. Он будет ждать в "Забитом ягненке".‡Beschwört mit Hilfe der Holzstatuette einen Inkubus, unterwerft ihn und bringt dann die Holzstatuette zu Gakin dem Dunkelbinder im geschlachteten Lamm zurück.‡목재 조각상을 사용하여 인큐버스를 소환해 제압한 후, 어둠의 희생양 선술집에 있는 대흑마법사 게이킨에게 목재 조각상을 가져가야 합니다.‡Utilizando la figurilla de madera, invoca y somete a un íncubo. Después, devuelve la figurilla de madera a Gakin el Presotenebra en El Cordero Degollado.‡Usa la figurilla de madera para invocar y someter a un íncubo. Después, llévasela de regreso a Gakin el Presotenebra en El Cordero Degollado.‡Utilisez la Figurine en bois pour invoquer et asservir un incube, puis rapportez l’objet à Gakin le Tisse-noir à l’Agneau assassiné.‡使用木雕召唤并制服一个夜魔，然后将木雕还给已宰的羔羊旅店的黑暗缚灵者加科因。‡使用木雕刻像來召喚夢魔並加以制伏，然後將木雕刻像還給已宰的羔羊旅店的『黑暗縛靈師』加金。',
  }
},
[65604] = {
  {
    'A vinculação‡Связывание‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡束缚‡誓縛',
    nil,
    'Usando o Lenço Fenecido, evoque e subjugue um íncubo. Depois, devolva o Lenço Fenecido para Gan\'rul Olho de Sangue em Orgrimmar.‡С помощью истлевшего платка призовите и подчините своей воле инкуба, затем верните его Ган\'рулу Кровавому Глазу в Оргриммаре.‡Beschwört mithilfe des abgetragenen Schals einen Inkubus, unterwerft ihn und bringt dann den abgetragenen Schal zu Gan\'rul Blutauge in Orgrimmar zurück.‡너덜너덜한 목도리를 사용해 인큐버스를 소환하여 처치한 다음 오그리마에 있는 간룰 블러드아이에게 너덜너덜한 목도리를 가지고 돌아가십시오.‡Usa el pañuelo raído para invocar y dominar a un íncubo y después lleva el pañuelo raído a Gan\'rul Ojosangre a Orgrimmar.‡Usa la bufanda desgastada para invocar y someter a un íncubo. Después devuelve la bufanda desgastada a Gan\'rul Ojosangre en Orgrimmar.‡Utilisez l’Écharpe flétrie pour invoquer et asservir un Incube, puis rapportez-la à Gan’rul Œil-sanglant, à Orgrimmar.‡使用皱缩头巾召唤并征服一只夜魔，然后皱缩头巾还给奥格瑞玛的甘鲁尔·血眼。‡使用乾癟的圍巾來召喚夢魔，然後加以制伏，再把乾癟的圍巾交給奧格瑪的甘盧爾·血眼。',
  }
},
[65610] = {
  {
    'A esperança é a última que morre‡Если бы мы были вместе...‡Irgendwo anders‡그대가 여기 있었으면‡Ojalá estuvieras aquí‡Ojalá estuvieras aquí‡Comme tu me manques‡希望你还在‡真希望你也在這裡',
    nil,
    'Investigue o Lago Céu Caído, que fica no Vale Gris, e relate suas descobertas a Gan\'rul Olho de Sangue em Orgrimmar.‡Осмотрите озеро Зеркало Небес в Ясеневом лесу и расскажите о находках Ган\'рулу Кровавый Глаз в Оргриммаре.‡Untersucht den Himmelssturzsee im Eschental und erstattet Gan\'rul Blutauge in Orgrimmar Bericht.‡잿빛 골짜기에 있는 유성 호수를 조사한 후 오그리마에 있는 간룰 블러드아이에게 보고해야 합니다.‡Investiga el Lago Cielo Estrellado de Vallefresno e informa de tus hallazgos a Gan\'rul Ojosangre, que está en Orgrimmar.‡Explora el Lago Cielo Estrellado en Vallefresno e informa lo que encontraste a Gan\'rul Ojosangre en Orgrimmar.‡Explorez le Lac Tombeciel en Orneval et rendez compte de vos découvertes à Gan’rul Œil-sanglant, à Orgrimmar.‡调查灰谷的坠星湖并将你的发现告诉奥格瑞玛的甘鲁尔·血眼。‡調查梣谷的墜星湖，然後向奧格瑪的甘盧爾·血眼回報。',
  }
},
