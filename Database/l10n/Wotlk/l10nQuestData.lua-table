},
[6901] = {
  {
    'Iniciem o ataque!‡В атаку!‡Startet den Angriff!‡공격 개시!‡Lanzar el ataque‡Lanzar el ataque‡Lancez l\'attaque !‡开始攻击！‡開始攻擊!',
    nil,
    nil,
  }
},
[6921] = {
  {
    'Nas ruínas‡Среди руин‡Inmitten der Ruinen‡폐허 사이로‡Entre ruinas‡Entre ruinas‡Parmi les ruines‡废墟之间‡廢墟之間',
    nil,
    'Leve o Núcleo das Profundezas para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Принесите глубинный сердечник Дже\'неу Санкри в форт Зорам\'гар в Ясеневый лес.‡Bringt den Tiefenkern zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 심연의 핵을 가져가야 합니다.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Noyau de la brasse à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, dans Orneval.‡把深渊之核交给灰谷佐拉姆加前哨站里的耶努萨克雷。‡把深淵之核交給梣谷佐拉姆加前哨站裡的耶努薩克雷。',
  }
},
[6922] = {
  {
    'O Barão Aquanis‡Барон Акванис‡Baron Aquanis‡군주 아쿠아니스‡Barón Aquanis‡Barón Aquanis‡Baron Aquanis‡阿奎尼斯男爵‡阿奎尼斯男爵',
    nil,
    'Leve o Globo d\'Água Estranho para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Принесите странную водяную сферу Дже\'неу Санкри в форт Зорам\'гар в Ясеневом лесу.‡Bringt die seltsame Wasserkugel zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 이상한 물구슬을 가져가야 합니다.‡Llévale el extraño globo de agua a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el extraño globo de agua a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Globe d\'eau étrange à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, dans Orneval.‡把奇怪的水球交给灰谷佐拉姆加前哨站的耶努萨克雷。‡把奇怪的水球交給梣谷佐拉姆加前哨站的耶努薩克雷。',
  }
},
[6941] = {
  {
    'Clamor do Ar – Esquadrilha de Vipore‡Небо зовет – флот Змейера‡Ruf der Lüfte - Vipores Luftflotte‡바람의 부름 - 비포르의 편대‡La llamada del aire: la flota de Vipore‡La llamada del aire: la flota de Vipore‡L\'appel des airs - l\'escadrille de Vipore‡天空的召唤 - 维波里的空军‡天空的召喚 - 維波里的空軍',
