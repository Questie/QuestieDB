    nil,
  }
},
[1007] = {
  {
    'A estatueta ancestral‡Древняя статуэтка‡Die antike Statuette‡고대 조각상‡La antigua estatuilla‡La estatuilla antigua‡L\'ancienne statuette‡远古雕像‡遠古雕像',
    nil,
    'Leve a Estatueta Ancestral para Talen, no acampamento perto da Praia de Zoram.‡Принесите древнюю статуэтку Талену в его лагерь близ Зорамского взморья.‡Bringt Talen im Lager in der Nähe des Zoramstrands die antike Statuette.‡조람 해안 근처에서 야영하고 있는 탈렌에게 고대 조각상을 가져가야 합니다.‡Llévale la estatuilla antigua a Talen en su campamento cerca de La Ensenada de Zoram.‡Lleva la estatuilla antigua a Talen en su campamento cerca de la Ensenada de Zoram.‡Apportez l\'Ancienne Statuette à Talen, dans son camp près de la grève de Zoram.‡把远古雕像交给塔尔伦，他的营地就在佐拉姆海岸附近。‡把遠古雕像交給塔爾倫，他的營地就在佐拉姆海岸附近。',
  }
},
[1008] = {
  {
    'Praia de Zoram‡Зорамское взморье‡Der Zoramstrand‡조람 해안‡La Ensenada de Zoram‡La Ensenada de Zoram‡La grève de Zoram‡佐拉姆海岸‡佐拉姆海岸',
    nil,
    'Entregue 20 Cabeças de Iracauda para Shindrell Fogofugaz em Astranaar.‡Принесите 20 голов наг из клана Зловещего Хвоста Шиндрелл Огненный Всполох в Астранаар.‡Bringt Shindrell Feuerflink in Astranaar 20 Köpfe von Rächerflossen.‡아스트라나르에 있는 신드렐 스위프트파이어에게 성난지느러미일족의 머리 20개를 가져가야 합니다.‡Llévale 20 cabezas de Colafuria a Shindrell Fuegoveloz en Astranaar.‡Llévale 20 cabezas de Colafuria a Shindrell Fuegoveloz en Astranaar.‡Apportez 20 Têtes d\'Irequeue à Shindrell Prestefeu, à Astranaar.‡收集20颗怒尾纳迦的徽记，把它们交给阿斯特兰纳的辛德瑞尔。‡收集20顆怒尾納迦的頭顱，把它們交給阿斯特蘭納的辛德瑞爾。',
  }
},
[1009] = {
  {
    'Ruuzel‡Руузель‡Ruuzel‡루젤‡Ruuzel‡Ruuzel‡Ruuzel‡卢泽尔‡盧澤爾',
    nil,
    'Leve o Anel de Zoram para Talen, perto da Praia de Zoram.‡Принесите кольцо Зорама Талену на Зорамское взморье.‡Bringt Talen im Lager in der Nähe des Zoramstrands den Ring von Zoram.‡조람 해안 근처에 있는 탈렌에게 조람의 반지를 가져가야 합니다.‡Llévale el Anillo de Zoram a Talen, cerca de La Ensenada de Zoram.‡Lleva el anillo de Zoram a Talen cerca de la Ensenada de Zoram.‡Apportez l\'Anneau de Zoram à Talen près de la grève de Zoram.‡找到佐拉姆之戒，把它交给佐拉姆海岸边的塔尔伦。‡找到佐拉姆之戒，把它交給佐拉姆海岸邊的塔爾倫。',
  }
},
[1010] = {
  {
    'Cabelo-de-bathran‡Батранов волос‡Bathranshaar‡배스랜초‡Cabello de Bathran‡Cabello de Bathran‡Les Cheveux de Bathran‡巴斯兰的头发‡巴斯蘭的頭髮',
    nil,
    'Leve 5 Cabelos-de-bathran para Orendil Folharga no Vale Gris.‡Принесите 5 стеблей Батранова волоса Орендилу Широколисту в Ясеневый лес.‡Bringt Orendil Rundblatt im Eschental 5 Bathranshaar-Pflanzen.‡잿빛 골짜기에 있는 오렌딜 브로드리프에게 배스랜초 5개를 가져가야 합니다.‡Llévale 5 cabellos de Bathran a Orendil Hojagrande en Vallefresno.‡Lleva 5 cabellos de Bathran a Orendil Hojagrande en Vallefresno.‡Rapporter 5 Cheveux de Bathran à Orendil Largefeuille dans Orneval.‡收集5份巴斯兰的头发，把它们带给灰谷的奥雷迪尔·阔叶。‡收集5份巴斯蘭的頭髮，把它們帶給梣谷的奧雷迪爾·闊葉。',
  }
},
[1011] = {
  {
    'Moléstias renegadas‡Чума Отрекшихся‡Verlassenenkrankheit‡포세이큰의 역병‡Los males de los Renegados‡Los males de los Renegados‡Les maladies des Réprouvés‡被遗忘者的病菌‡被遺忘者的病菌',
    nil,
    'Leve uma Garrafa de Moléstia para Kainet Brisacalma em Cantilenda.‡Принесите бутыль заразы Кайнету Штилю в Лесную Песнь.‡Bringt Kayneth Stillwind in Waldeslied eine Krankheitsflasche.‡숲의 노래에 있는 케이네스 스틸윈드에게 역병 견본 하나를 가져가야 합니다.‡Llévale una botella de enfermedad a Kayneth Ventoleve en Canción del Bosque.‡Llévale una botella de enfermedad a Kayneth Ventoleve en Canción del Bosque.‡Apporter une Bouteille des maladies à Kayneth Mortebrise au Chant des Forêts.‡找到一瓶病毒，把它交给林歌神殿中的凯尼斯·静风。‡找到一瓶病毒，把它交給林歌神殿的凱尼斯·靜風。',
  }
},
[1012] = {
  {
    'Druidas insanos‡Безумные друиды‡Irrsinnige Druiden‡미쳐버린 드루이드‡Druidas dementes‡Druidas dementes‡Les druides fous‡疯狂的德鲁伊‡瘋狂的德魯伊',
    nil,
    'Mate os druidas Taneel Lenhanegra, Uthil Chamaluna e Mavoris Rasganimbus. Depois fale novamente com Kainet Brisacalma em Cantilenda.‡Убейте друидов: Таниэля Темный Лес, Этиля Зов Луны и Мавориса Проблеск Солнца, затем возвращайтесь к Кайнету Штилю в Лесную Песнь.‡Tötet die Druiden Taneel Finsterwald, Uthil Mondweise und Mavoris Wolkenbruch und kehrt dann zu Kayneth Stillwind in Waldeslied zurück.‡드루이드 지도자인 타닐 다크우드, 우실 문콜, 마보리스 클라우즈브레이크를 처치한 다음 숲의 노래에 있는 케이네스 스틸윈드에게 돌아가야 합니다.‡Mata a los druidas Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes y vuelve junto a Kayneth Ventoleve en Canción del Bosque.‡Mata a los druidas Taneel Leñoscuro, Uthil Llamaluna y Mavoris Quiebranubes y regresa con Kayneth Ventoleve en Canción del Bosque.‡Tuer les druides : Taneel Sombrebois, Uthil Huchelune, Mavoris Eclairciel ; puis retourner auprès de Kayneth Mortebrise au Chant des Forêts.‡杀死这些德鲁伊：坦尼尔·黑木、尤希尔·唤月和玛沃里斯·裂云，然后向慰藉之林中的凯尼斯·静风复命。‡殺死這些德魯伊:坦尼爾·黑木、尤希爾·喚月和瑪沃裡斯·裂雲，然後向林歌神殿的凱尼斯·靜風覆命。',
  }
},
[1013] = {
  {
    'O Livro de Ur‡Книга Ура‡Das Buch von Ur‡우르의 책‡El Libro de Ur‡El Libro de Ur‡Le Livre d\'Ur‡乌尔之书‡烏爾之書',
    nil,
    'Leve o Livro de Ur para o Guardião Bel\'dugur no Boticarium da Cidade Baixa.‡Принесите книгу Ура хранителю Бел\'дугуру в Район Фармацевтов в Подгород.‡Bringt dem Bewahrer Bel\'dugur im Apothekarium in Unterstadt das Buch von Ur.‡언더시티의 연금술 실험실에 있는 관리인 벨두거에게 우르의 책을 가져가야 합니다.‡Lleva el Libro de Ur al vigilante Bel\'dugur al Apothecarium de Entrañas.‡Lleva el Libro de Ur al vigilante Bel\'dugur al Apothecarium de Entrañas.‡Apportez le "Livre d\'Ur" au Gardien Bel\'dugur à l\'Apothicarium à Fossoyeuse.‡把乌尔之书交给幽暗城炼金区里的看守者贝尔杜加。‡把烏爾之書拿給幽暗城鍊金區裡的看守者貝爾杜加。',
  }
},
[1014] = {
  {
    'Arugal tem que morrer‡Смерть Аругалу!‡Arugal muss sterben‡아루갈의 최후‡Arugal debe morir‡Arugal debe morir‡Arugal doit mourir‡除掉阿鲁高‡除掉阿魯高',
    nil,
    'Mate Arugal e leve sua cabeça para Dalar Tessalba no Sepulcro.‡Убейте Аругала и принесите его голову Далару Ткачу Рассвета в Гробницу.‡Tötet Arugal und bringt Dalar Morgenweber in dem Grabmal seinen Kopf.‡아루갈을 처치하고 그 증거로 그의 머리카락을 공동묘지에 있는 달라 돈위버에게 가져가야 합니다.‡Mata a Arugal y lleva su cabeza a Dalar Dawnweaver en El Sepulcro.‡Mata a Arugal y lleva su cabeza a Dalar Tejealba en El Sepulcro.‡Tuer Arugal et apporter sa Tête à Dalar Tisselaube au Sépulcre.‡杀死阿鲁高，把他的徽记带给瑟伯切尔的达拉尔·道恩维沃尔。‡殺死阿魯高，把他的頭帶給瑟伯切爾的達拉爾·織曦者。',
  }
},
[1015] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом из дарнасского анклава Кенария относительно призыва Круга Кенария к изучению окраин Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Hirschhaupt über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대한 얘기를 나눠야 합니다.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'archidruide Fandral Forteramure, dans l\'Enclave cénarienne, à Darnassus. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納里奧區的大德魯伊范達爾·鹿盔談談關於議會號召聯盟成員探索卡林多大陸的事情。',
  }
},
[1016] = {
  {
    'Braçadeiras Elementais‡Браслеты элементалей‡Elementararmschienen‡정령의 족쇄‡Brazales elementales‡Brazales elementales‡Les bracelets d\'élémentaire‡元素护腕‡元素護腕',
    nil,
    'Recolha 5 Braçadeiras Elementais Intactas e use o Pergaminho Divinatório nelas. Depois, leve o Pergaminho Vaticinado para a Sentinela Velene Golpestela no Refúgio Brisaprata.‡Соберите 5 неповрежденных браслетов элементалей, а затем задействуйте на них божественный свиток. После отнесите разгаданный свиток Стражу Велене Звездный Всполох в Приют Серебряного Ветра.‡Sammelt 5 intakte Elementararmschienen und wendet die Rolle der Bestimmung darauf an. Bringt danach der Schildwache Velene Sternenschlag in der Silberwindzuflucht die bestimmte Rolle.‡온전한 정령의 족쇄 5개를 모아서 예언의 두루마리를 사용한 후, 실바람 산장에 있는 파수꾼 벨레네 스타스트라이크에게 예언된 두루마리를 가져가야 합니다.‡Reúne 5 brazales elementales intactos y aplícales el pergamino de adivinación. A continuación, llévale el pergamino descifrado a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Recoge 5 brazales elementales intactos y usa el pergamino de adivinación sobre ellos. Después, llévaselo a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Récolter 5 Bracelets élémentaires intacts et utiliser le Parchemin de divination sur eux. Ensuite, apporter le Parchemin de divination à la Sentinelle Velene Heurtétoile au Refuge de Vent-argent.‡收集5个完整的元素护腕，并对它们使用占卜卷轴。然后把使用过的占卜卷轴带给银风避难所的哨兵维尔莉妮·星坠。‡收集5個完整的元素護腕，並對它們使用預言卷軸。然後把使用過的預言卷軸帶給銀風避難所的哨兵維爾莉妮·星墜。',
  }
},
[1017] = {
  {
    'O mago evocador‡Маг-призыватель‡Magier-Beschwörer‡물의 정령 배후의 마법사‡Mago invocador‡Mago invocador‡Mage invocateur‡召唤者‡法師召喚者',
    nil,
    'Mate Sarilus Malnato e leve a cabeça dele para a Sentinela Velene Golpestela no Refúgio Brisaprata.‡Убейте Сарилуса Грязнорожденного и принесите его голову часовому Велене Звездный Всполох в Приют Серебряного Ветра.‡Erschlagt Sarilus Faulmut und bringt Schildwache Velene Sternenschlag in der Silberwindzuflucht seinen Kopf.‡사릴루스 파울본을 처치하고 그 증거로 그의 머리카락을 실바람 산장에 있는 파수꾼 벨레네 스타스트라이크에게 가져가야 합니다.‡Mata a Sarilus Fuenteviciosa y lleva su cabeza a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Mata a Sarilus Fuenteviciosa y lleva su cabeza a la centinela Velene Golpe Estelar en el Refugio Brisa de Plata.‡Tuer Sarilus Souillemporte et apporter sa Tête à la Sentinelle Velene Heurtétoile au Refuge de Vent-argent.‡干掉萨瑞鲁斯·法伯尼，把他的徽记交给银风避难所的哨兵维尔莉妮·星坠。‡殺掉薩瑞魯斯·法伯尼，把他的首級交給銀風避難所的哨兵維爾莉妮·星墜。',
  }
},
[1018] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Platô dos Anciãos, no Penhasco do Trovão, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Обратитесь к верховному друиду Хамуулу Руническому Тотему на Вершине Старейшин Громового Утеса по поводу помощи Кругу Кенария в исследовании границ Калимдора.‡Sprecht auf der Anhöhe der Ältesten in Donnerfels mit dem Erzdruiden Hamuul Runentotem über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡썬더 블러프의 장로의 봉우리에 있는 대드루이드 하뮬 룬토템을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 얘기를 나눠야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Hamuul Tótem de Runa en el Alto de los Ancestros de Cima del Trueno acerca de la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'archidruide Hamuul Totem-runique, sur la Cime des Anciens des Pitons du Tonnerre. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与雷霆崖长者高地的大德鲁伊哈缪尔·符文图腾谈一谈关于议会号召部落成员探索卡利姆多大陆的事情。‡與雷霆崖長者高地的大德魯伊哈繆爾·符文圖騰談一談關於議會號召部落成員探索卡林多大陸的事情。',
  }
},
[1019] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом из дарнасского анклава Кенария относительно призыва Круга Кенария к изучению окраин Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Hirschhaupt über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대해 얘기를 나눠야 합니다.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'archidruide Fandral Forteramure, dans l\'Enclave cénarienne, à Darnassus. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納里奧區的大德魯范達爾·鹿盔談一談關於議會號召聯盟成員探索卡林多大陸的事情。',
  }
},
[1020] = {
  {
    'Cura de Orendil‡Лекарство Орендила‡Orendils Heilmittel‡오렌딜의 치료제‡Cura de Orendil‡Cura de Orendil‡Jouvence d\'Orendil‡奥雷迪尔的药剂‡奧雷迪爾的藥劑',
    nil,
    'Entregue a Cura de Orendil a Pelturas Lunalva em Astranaar.‡Принесите лекарство Орендила Пельтуру Белой Луне в Астранаар.‡Bringt Pelturas Weißmond in Astranaar Orendils Heilmittel.‡아스트라나르에 있는 펠투러스 화이트문에게 오렌딜의 치료제를 가져가야 합니다.‡Llévale la cura de Orendil a Pelturas Lunablanca en Astranaar.‡Llévale la cura de Orendil a Pelturas Lunablanca en Astranaar.‡Apporter la Jouvence d\'Orendil à Pelturas Blanchelune dans Astranaar.‡把奥雷迪尔的药剂交给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡把奧雷迪爾的藥劑交給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1021] = {
  {
    'Malditos sátiros! Dríades em perigo!‡Сатиры коварны! Дриады в опасности!‡Elende Satyrn! Die Dryaden sind in Gefahr!‡사악한 사티로스와 위험에 처한 드리아드‡¡Vil sátiro! ¡Dríades en peligro!‡¡Vil sátiro! ¡Dríades en peligro!‡Vil satyre ! Dryades en danger !‡身陷危险的树妖！‡邪惡的薩特!身陷危險的林精!',
    nil,
    'Encontre Anilia em Xavian, que fica no Vale Gris.‡Найдите Анилию в Ксавиане, что в Ясеневом лесу.‡Sucht in Xavian im Eschental nach Anilia.‡잿빛 골짜기의 사비안에서 아닐리아를 찾아야 합니다.‡Encuentra a Anilia en Xavian, en Vallefresno.‡Encuentra a Anilia en Xavian, en Vallefresno.‡Trouver Anilia dans Xavian, à Orneval.‡到灰谷的萨维亚去找到安妮莉亚。‡到梣谷的薩維亞尋找安妮莉亞。',
  }
},
[1022] = {
  {
    'Vale Uivante‡Воющая долина‡Das heulende Tal‡울부짖는 골짜기‡La Vega del Aullido‡La Vega del Aullido‡Le Val hurlant‡狼嚎谷‡狼嚎谷',
    nil,
    'Vá para o Vale Uivante estudar o Tomo de Mel\'Thandris, depois fale novamente com a Sentinela Melyria Algissombra em Cantilenda.‡Отправляйтесь в Воющую Долину, изучите фолиант Мел\'Тандрис, затем возвращайтесь к часовому Мелирии Ледяной Тени в Лесную Песнь.‡Begebt Euch ins heulende Tal, studiert den Folianten von Mel\'Thandris und kehrt dann zur Schildwache Melyria Frostschatten in Waldeslied zurück.‡울부짖는 골짜기로 가서 멜탄드리스의 마법책을 찾아 읽어 본 다음 숲의 노래에 있는 파수꾼 멜리리아 프로스트섀도에게 돌아가야 합니다.‡Ve a Vega del Aullido y estudia el Libro de Mel\'Thandris, vuelve entonces junto a la Centinela Melyria Sombrigélida en la Canción del Bosque.‡Ve a La Vega del Aullido y estudia el Libro de Mel\'Thandris, vuelve entonces junto a la Centinela Melyria Sombrigélida en la Canción del Bosque.‡Allez au Val hurlant et étudiez le Tome de Mel\'Thandris, puis retournez voir la Sentinelle Melyria Ombregivre au Chant des forêts.‡到狼嚎谷去，研究一下麦尔莎迪丝之书，然后向林歌神殿的哨兵梅丽瑞亚·霜影复命。‡到狼嚎谷去，研究一下麥爾莎迪絲之書，然後向林歌神殿的哨兵梅麗瑞亞·霜影覆命。',
  }
},
[1023] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre a Gema Faiscante e fale novamente com Raene Correlobos em Astranaar, em posse do Diário de Teronis.‡Найдите светящийся самоцвет и вернитесь к Раэне Волкопас в Астранаар с дневником Терониса.‡Sucht den leuchtenden Edelstein und bringt ihn zusammen mit Teronis\' Tagebuch zu Raene Wolfsläufer in Astranaar.‡빛나는 보석을 찾아 테로니스의 일지와 함께 아스트라나르에 있는 레이네 울프러너에게 가져가야 합니다.‡Encuentra la gema resplandeciente y llévasela a Raene Correlobo en Astranaar junto con el diario de Teronis.‡Busca la gema resplandeciente y regresa a ver a Raene Correlobo en Astranaar con el diario de Teronis.‡Trouver la Gemme luminescente et retourner voir Raene Mène-loup dans Astranaar avec le Journal de Teronis.‡找到发光的宝石，连同泰洛尼斯的日记一起交给阿斯特兰纳的莱恩·狼行者。‡找到發光的寶石，連同泰洛尼斯的日記一起交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1024] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre Shael\'dryn no poço lunar a nordeste.‡Найдите Шаэл\'дрин у лунного колодца на северо-востоке.‡Sucht Shael\'dryn beim Mondbrunnen im Nordosten auf.‡북동쪽에 있는 달샘에서 셸드린을 찾아야 합니다.‡Encuentra a Shael\'dryn en la Poza de la Luna al noreste.‡Busca a Shael\'dryn en la poza de la luna al noreste.‡Trouver Shael\'dryn, au Puits de lune, au nord-est.‡在东北方的月亮井旁找到莎尔蒂恩。‡在東北方的月井旁找到莎爾蒂恩。',
  }
},
[1025] = {
  {
    'Uma defesa agressiva‡Лучшая защита – нападение‡Eine aggressive Verteidigung‡공격적 방어‡Una defensa agresiva‡Una defensa agresiva‡Une défense agressive‡先发制人‡先發制人',
    nil,
    'Mate 1 Vigia do Covil, 2 Ursinos, 10 Totêmicos e 12 Guerreiros da tribo Torpeflora, depois fale novamente com Raene Correlobos em Astranaar.‡Убейте 1 дозорного, 2 ведмедей, 10 тотемистов и 12 воинов из племени Гиблой Чащи, а затем вернитесь к Раэне Волкопас в Астранаар.‡Tötet 1 Höhlenbehüter, 2 Ursa, 10 Totemiker sowie 12 Krieger der Fäulnisklauen und kehrt dann zu Raene Wolfsläufer in Astranaar zurück.‡썩은나무일족 보초 1마리, 썩은나무일족 펄볼그 2마리, 썩은나무일족 토템술사 10마리 및 썩은나무일족 전사 12마리를 처치한 다음 아스트라나르에 있는 레이네 울프러너에게 돌아가야 합니다.‡Mata a 1 vigía del cubil, 2 ursas, 10 totémicos y 12 guerreros de la tribu de los Maderiza y vuelve junto a Raene Correlobo en Astranaar.‡Mata a 1 vigía del cubil, 2 ursas, 10 totémicos y 12 guerreros de la tribu de los Maderiza y vuelve junto a Raene Correlobo en Astranaar.‡Tuer 1 Protecteur, 2 Ursas, 10 Totemiques et 12 Guerriers de la tribu Vile-sylve, puis retourner voir Raene Mène-loup, à Astranaar.‡杀掉污林部族里的1个污林卫兵、2个污林巨熊、10个污林萨满祭司和12个污林战士，然后回到阿斯特兰纳向莱恩·狼行者复命。‡殺掉汙林族的1個汙林守衛者、2個汙林巨熊、10個汙林薩滿和12個汙林戰士，然後回去找阿斯特蘭納的萊恩·狼行者。',
  }
},
[1026] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre a Chave de Madeira e uma parte do Bastão de Dartol antes de falar novamente com Shael\'dryn no poço lunar.‡Найдите деревянный ключ и обломок жезла Дартола прежде, чем вернуться к Шаэл\'дрин у Лунного колодца.‡Sucht den Holzschlüssel und das Teil von Dartols Rute, bevor Ihr zu Shael\'dryn beim Mondbrunnen zurückkehrt.‡나무 열쇠와 다르톨의 변신마법봉의 조각을 찾아 달샘에 있는 셸드린에게 돌아가야 합니다.‡Encuentra la llave de madera y una pieza de la vara de Dartol antes de volver junto a Shael\'dryn en la Poza de la Luna.‡Encuentra la llave de madera y una pieza de la vara de Dartol antes de regresar con Shael\'dryn en la poza de la luna.‡Trouver la Clé en bois et un morceau du Bâtonnet de Dartol avant de retourner voir Shael\'dryn au Puits de lune.‡找到木制钥匙和一段达图尔的魔棒，然后回到月亮井的莎尔蒂恩那里。‡找到木製鑰匙和一段達圖爾的魔棒，然後回到月井的莎爾蒂恩那裡。',
  }
},
[1027] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre a última peça do Bastão de Dartol e fale novamente com Shael\'dryn no poço lunar.‡Найдите последний фрагмент жезла Дартола и вернитесь к Шаэл\'дрин у Лунного колодца.‡Sucht das letzte Teil von Dartols Rute und bringt es Shael\'dryn beim Mondbrunnen.‡다르톨의 마법봉을 만들기 위한 마지막 조각을 찾아 달샘에 있는 셸드린에게 돌아가야 합니다.‡Encuentra la última pieza de la vara de Dartol y vuelve junto a Shael\'dryn en la Poza de la Luna.‡Encuentra la última pieza de la vara de Dartol y regresa con Shael\'dryn en la poza de la luna.‡Trouver le dernier morceau du Bâtonnet de Dartol et retourner voir Shael\'dryn au puits de lune.‡找到达图尔的魔棒的最后一段，然后回到月亮井旁的莎尔蒂恩那里。‡找到達圖爾的魔棒的最後一段，然後回到月井旁的莎爾蒂恩那裡。',
  }
},
[1028] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre o santuário oculto e encante o Bastão de Dartol.‡Найдите потаенное святилище и снова наполните чарами жезл Дартола.‡Sucht den verborgenen Schrein und verzaubert Dartols Rute erneut.‡숨겨진 제단을 찾아 다르톨의 마법봉에 다시 마력을 불어 넣어야 합니다.‡Encuentra el Santuario Oculto y encanta de nuevo la vara de Dartol.‡Encuentra el Santuario Oculto y encanta de nuevo la vara de Dartol.‡Trouver l\'Autel caché et recharger le Bâtonnet de Dartol.‡找到隐藏的神殿并给达图尔的魔棒重新注入魔力。‡找到隱藏的神殿並給達圖爾的魔棒重新注入魔力。',
  }
},
[1029] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Fale novamente com Raene Correlobos em Astranaar.‡Вернитесь к Раэне Волкопас в Астранаар.‡Kehrt zu Raene Wolfsläufer in Astranaar zurück.‡아스트라나르에 있는 레이네 울프러너에게 돌아가야 합니다.‡Vuelve junto a Raene Correlobo en Astranaar.‡Vuelve junto a Raene Correlobo en Astranaar.‡Retourner voir Raene Mène-loup à Astranaar.‡回到阿斯特兰纳的莱恩·狼行者那里。‡回到阿斯特蘭納的萊恩·狼行者那裡。',
  }
},
[1030] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Encontre um pelurso não corrompido e use o poder do Bastão de Transformação de Dartol para falar com ele.‡Найдите не затронутого порчей фурболга и поговорите с ним при помощи жезла преображения Дартола.‡Sucht einen nicht verderbten Furbolg und benutzt die Macht von Dartols Rute der Transformation, um mit ihm zu sprechen.‡오염되지 않은 펄볼그를 찾아 다르톨의 변신마법봉의 힘을 사용하여 그와 대화해야 합니다.‡Encuentra un fúrbolg sin corromper y, mediante el poder de la vara de transformación de Dartol, habla con él.‡Busca un fúrbolg sin corromper y usa el poder de la vara de transformación de Dartol para hablarle.‡Trouver un furbolg non corrompu et lui parler en utilisant le pouvoir du Bâtonnet de transformation de Dartol.‡找到一个尚未堕落的熊怪，利用达图尔的变形魔棒的能力与其交谈。‡找到一個尚未墮落的熊怪，利用達圖爾的變形魔棒的能力與其交談。',
  }
},
[1031] = {
  {
    'O ramo de Cenarius‡Ветвь Кенария‡Der Zweig des Cenarius‡세나리우스의 가지‡La Rama de Cenarius‡La Rama de Cenarius‡La branche de Cénarius‡塞纳留斯的树枝‡塞納留斯的樹枝',
    nil,
    'Mate Geltharis e leve o Ramo de Cenarius para Iliana em Cantilenda.‡Убейте Гелтариса и верните Ветвь Кенария Иллиане в Лесную Песнь.‡Tötet Geltharis und bringt Illiyana in Waldeslied den Zweig des Cenarius.‡겔타리스를 처치하고 숲의 노래에 있는 일리야나에게 세나리우스의 가지를 돌려줘야 합니다.‡Mata a Geltharis y devuélvele la Rama de Cenarius a Illiyana a Canción del Bosque.‡Mata a Geltharis y vuelve a ver a Illiyana con la rama de Cenarius en el Santuario de Aessina.‡Tuer Geltharis et rendre la Branche de Cénarius à Illiyana au Chant des forêts.‡杀掉加萨里斯，把塞纳留斯的树枝交给林歌神殿的伊莉亚娜。‡殺掉加薩里斯，把塞納留斯的樹枝交給林歌神殿的伊莉亞娜。',
  }
},
[1032] = {
  {
    'Temporada de caça aos sátiros‡Убийство сатиров!‡Satyrn schlachten!‡사티로스 처치‡¡Muerte a los sátiros!‡¡Muerte a los sátiros!‡Mort aux satyres !‡猎杀萨特！‡獵殺薩特!',
    nil,
    'Leve 16 Chifres de Sátiro para Iliana em Cantilenda.‡Принесите 16 рогов сатиров Иллиане в Лесную Песнь.‡Bringt Illiyana in Waldeslied 16 Satyrhörner.‡숲의 노래에 있는 일리야나에게 사티로스의 뿔 16개를 가져다주어야 합니다.‡Llévale 16 cuernos de sátiro a Illiyana en Canción del Bosque.‡Lleva 16 cuernos de sátiro a Illiyana en el Santuario de Aessina.‡Apporter 16 Cornes de satyre à Illiyana, au Chant des forêts.‡收集16支萨特的角，把它们交给林歌神殿的伊莉亚娜。‡收集16支薩特的角，把它們交給林歌神殿的伊莉亞娜。',
  }
},
[1033] = {
  {
    'Lágrima de Eluna‡Слеза Элуны‡Elunes Träne‡엘룬의 눈물‡Lágrima de Elune‡Lágrima de Elune‡Larme d\'Elune‡月神之泪‡月神之淚',
    nil,
    'Leve a Lágrima de Eluna para Pelturas em Astranaar.‡Принесите Слезу Элуны Пельтуру в Астранаар.‡Bringt Pelturas in Astranaar die Träne von Elune.‡아스트라나르에 있는 펠투러스에게 엘룬의 눈물을 가져가야 합니다.‡Llévale la lágrima de Elune a Pelturas en Astranaar.‡Lleva la lágrima de Elune a Pelturas en Astranaar.‡Apporter une Larme d\'Elune à Pelturas Blanchelune à Astranaar.‡找到月神之泪，把它交给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡找到月神之淚，把它交給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1034] = {
  {
    'Ruínas de Poeira Estelar‡Руины Звездной Пыли‡Die Sternenstaubruinen‡별가루의 폐허‡Las Ruinas del Polvo Estelar‡Las Ruinas del Polvo Estelar‡Les ruines de Chimétoile‡星尘废墟‡星塵廢墟',
    nil,
    'Leve 5 Punhados de Poeira Estelar para Pelturas em Astranaar.‡Принесите 5 горстей звездной пыли Пельтуру в Астранаар.‡Bringt Pelturas in Astranaar 5 Hand voll Sternenstaub.‡아스트라나르에 있는 펠투러스에게 별가루 5줌을 가져가야 합니다.‡Llévale 5 puñados de polvo estelar a Pelturas en Astranaar.‡Llévale 5 puñados de polvo estelar a Pelturas en Astranaar.‡Rapporter 5 Poignées de Poussière d\'étoile à Pelturas Blanchelune à Astranaar.‡收集5份星尘，把它们交给灰谷的皮尔图拉斯·怀特姆恩。‡收集5份星塵，把它們交給梣谷的皮爾圖拉斯·懷特姆恩。',
  }
},
[1035] = {
  {
    'Lago Céu Caído‡Зеркало Небес‡Der Himmelssturzsee‡유성 호수‡Lago Cielo Estrellado‡Lago Cielo Estrellado‡Le lac Tombeciel‡坠星湖‡墜星湖',
    nil,
    'Recolha uma Pedra-da-lua Caída do Oráculo Umbrárvore, depois leve-a para Pelturas em Astranaar.‡Отнимите лунный камень Упавшего Неба у Чащобного Оракула и принесите его Пельтуру в Астранаар.‡Holt von dem Schattendickichtorakel einen gefallenen Mondstein und bringt ihn Pelturas in Astranaar.‡그늘덤불 나무현자에게서 유성 월장석을 빼앗아서 아스트라나르에 있는 펠투러스에게 가져가야 합니다.‡Recupera una piedra lunar caída del Oráculo Sombramatorral y llévasela a Pelturas en Astranaar.‡Recupera una piedra lunar caída del Oráculo Sombramatorral y llévasela a Pelturas en Astranaar.‡Reprendre une Pierre de lune tombée à l\'Oracle Sombretaillis puis l\'apporter à Pelturas Blanchelune à Astranaar.‡从沼泽兽智者那里取回一枚陨落的月亮石，并把它带给阿斯特兰纳的皮尔图拉斯·怀特姆恩。‡從沼澤獸神諭者那裡取回一枚隕落的月亮石，並把它帶給阿斯特蘭納的皮爾圖拉斯·懷特姆恩。',
  }
},
[1036] = {
  {
    'Ioho, cão sarnento!‡Суши весла, сухопутная крыса‡Hierher, Taugenichts‡붉은해적단과의 만남‡¡Adelante, pillín!‡¡Adelante, pillín!‡En avant toutes, jeune mariole !‡嘿，水手！‡嘿，水手!',
    nil,
    'Fale com o Mestre de Frota Firalião a bordo do Véu Carmesim na costa da Selva do Espinhaço.‡Поговорите с командиром флота Фираллоном на борту "Кровавой завесы" на побережье Тернистой долины.‡Sprecht mit Flottenmeister Firallon an Bord der Purpurschleier vor der Küste des Schlingendorntals.‡가시덤불 골짜기 해안에 정박해 있는 주홍빛 장막호에서 함장 피랠론과 대화해야 합니다.‡Habla con el maestro de flota Firallon a bordo de El Velo Carmesí cerca de la costa de la Vega de Tuercespina.‡Habla con el maestro de flota Firallon a bordo de El Velo Carmesí cerca de la costa de la Vega de Tuercespina.‡Parler à l\'amiral Firallon, à bord du Voile cramoisi, au large de la côte de la vallée de Strangleronce.‡登上停泊在荆棘谷海岸边的红雾号，与船里的舰队指挥官菲尔拉伦谈一谈。‡登上停泊在荊棘谷海岸邊的紅霧號，與船裡的艦隊指揮官菲爾拉倫談話。',
  }
},
[1037] = {
  {
    'Velinde Stelacanto‡Велинда Песнь Звезд‡Velinde Sternensang‡벨린데 스타송‡Velinde Cantoestelar‡Velinde Cantoestelar‡Velinde Chantétoile‡维琳德·星歌‡維琳德·星歌',
    nil,
    'Fale com Thyn\'tel Tecelâmina no Terraço dos Guerreiros, em Darnassus.‡Поговорите с Тин\'тель Танцем Клинка на террасе Воинов в Дарнасе.‡Sprecht auf der Terrasse der Krieger in Darnassus mit Thyn\'tel Klingenweber.‡다르나서스의 전사의 정원에 있는 신텔 블레이드위버와 대화해야 합니다.‡Habla con Thyn\'tel Tejespada en el Bancal del Guerrero en Darnassus.‡Habla con Thyn\'tel Tejespada en el Bancal del Guerrero en Darnassus.‡Parler à Thyn\'tel Tisselame à la Terrasse des guerriers de Darnassus.‡在达纳苏斯的战士区与塞恩提尔·刃纹谈一谈。‡在達納蘇斯的公正之廳與塞恩提爾·刃紋談話。',
  }
},
[1038] = {
  {
    'Os efeitos de Velinde‡Эффекты Велинды‡Velindes Besitztümer‡벨린데의 영향‡Las pertenencias de Velinde‡Las pertenencias de Velinde‡Les effets personnels de Velinde‡维琳德的日记‡維琳德的日記',
    nil,
    'Vasculhe o baú de Velinde atrás do seu diário, depois leve-o junto com a chave para Thyn\'tel Tecelâmina em Darnassus.‡Поищите в сундуке Велинды ее дневник, затем принесите его вместе с ключом Тинтэль Танцующий Клинок в Дарнас.‡Durchsucht Velindes Truhe nach ihrem Tagebuch und bringt es zusammen mit dem Schlüssel nach Darnassus zu Thyn\'tel Klingenweber.‡벨린데의 상자에서 일지를 찾은 다음 열쇠와 함께 다르나서스에 있는 신텔 블레이드위버에게 돌려주어야 합니다.‡Busca el diario de Velinde en su cofre y llévaselo, junto con la llave, a Thyn\'tel Tejespada a Darnassus.‡Busca el diario de Velinde en su cofre y llévaselo, junto con la llave, a Thyn\'tel Tejespada a Darnassus.‡Fouiller le coffre de Velinde pour trouver son Journal et le rendre ensuite avec la clé à Thyn\'tel Tisselame à Darnassus.‡在维琳德的箱子里搜寻她的日记，把日记连同钥匙一起交给达纳苏斯的塞恩提尔·刃纹。‡在維琳德的箱子裡搜尋她的日記，把日記連同鑰匙一起交給達納蘇斯的塞恩提爾·刃紋。',
  }
},
[1039] = {
  {
    'O porto dos Sertões‡Порт в Степях‡Der Brachlandhafen‡불모의 땅 항구‡El puerto de Los Baldíos‡El puerto de Los Baldíos‡Le port des Tarides‡贫瘠之地的港口‡貧瘠之地的港口',
    nil,
    'Fale com o Mestre Portuário Caruncho na Vila Catraca, que fica nos Sertões.‡Поговорите с управляющим пристанью Головокружилкинсом в Кабестане, что в Степях.‡Sprecht mit Werftmeister Flunkerblick in Ratschet im Brachland.‡불모의 땅, 톱니항에 있는 부두주임 디지위그와 대화해야 합니다.‡Ve a Trinquete, en Los Baldíos, y habla con el maestro de muelles Vertipeluca.‡Ve a Trinquete, en Los Baldíos, y habla con el maestro de muelles Vertipeluca.‡Aller voir le Maître des quais Tournoupette à Cabestan, dans les Tarides.‡和贫瘠之地棘齿城的码头管理员迪兹维格谈一谈。‡去貧瘠之地的棘齒城，和碼頭管理員迪茲維格談話。',
  }
},
[1040] = {
  {
    'Um barco para a Angra do Butim‡Дорога до Пиратской Бухты‡Passage nach Beutebucht‡무법항으로의 여정‡Pasaje a Bahía del Botín‡Pasaje a Bahía del Botín‡Passage à Baie-du-Butin‡藏宝海湾的航道‡藏寶海灣的航道',
    nil,
    'Pegue um barco para Angra do Butim e fale com Caravaneiro Russote.‡Плывите в Пиратскую Бухту и поговорите с караванщиком Раззготом.‡Nehmt ein Schiff nach Beutebucht und sprecht dort mit dem Karawanenführer Ruzzgot.‡무법항으로 배를 타고 가서 행상 러즈고트와 대화해야 합니다.‡Coge un barco a Bahía del Botín y habla con el caravanero Ruzzgot.‡Viaja en barco a Bahía del Botín y habla con el caravanero Ruzzgot.‡Prendre un bateau pour Baie-du-Butin et aller voir le Caravanier Ruzzgot.‡坐船去藏宝海湾，和旅行者拉兹戈特谈一谈。‡坐船去藏寶海灣，和旅行者拉茲戈特談話。',
  }
},
[1041] = {
  {
    'Na estrada com a Caravana‡Путь каравана‡Die Karawanenstraße‡행상길‡La ruta de la caravana‡La ruta de la caravana‡La route de la caravane‡商队通路‡商隊通路',
    nil,
    'Fale com o Tabelião Azambuja na Vila Sombria.‡Поговорите с клерком Далтри из Темнолесья.‡Sprecht in Dunkelhain mit Amtmann Daltry.‡다크샤이어에 있는 서기관 달트리와 대화해야 합니다.‡Habla con el secretario Daltry en Villa Oscura.‡Habla con el secretario Daltry en Villa Oscura.‡Aller voir le greffier Daltry à Sombre-comté.‡与夜色镇的书记员达尔塔谈一谈。‡與夜色鎮的書記員達爾塔談話。',
  }
},
[1042] = {
  {
    'A família Carevino‡Семья Карвин‡Die Familie Treuwein‡카레빈 일가‡La familia Carevin‡La familia Carevin‡La famille Carevin‡卡尔文家族‡卡爾文家族',
    nil,
    'Fale com João Carevino na Vila Sombria.‡Поговорите с Джонатаном Карвином в Темнолесье.‡Sprecht mit Jonathan Treuwein in Dunkelhain.‡다크샤이어에 있는 조나단 카레빈과 대화해야 합니다.‡Habla con Jonathan Carevin en Villa Oscura.‡Habla con Jonathan Carevin en Villa Oscura.‡Aller voir Jonathan Carevin à Sombre-comté.‡去和夜色镇的乔纳森·卡尔文谈谈。‡去和夜色鎮的喬納森·卡爾文談談。',
  }
},
[1043] = {
  {
    'A foice de Eluna‡Коса Элуны‡Die Sense von Elune‡엘룬의 낫‡La Guadaña de Elune‡La Guadaña de Elune‡La Faux d\'Elune‡月神的镰刀‡月神的鐮刀',
    nil,
    'Procure sinais da Foice de Eluna, e depois fale novamente com João Carevino na Vila Sombria.‡Отыщите признаки местонахождения Косы Элуны и вернитесь к Джонатану Карвину в Темнолесье.‡Sucht nach Hinweisen auf die Sense von Elune und kehrt dann zu Jonathan Treuwein in Dunkelhain zurück.‡엘룬의 낫의 흔적을 찾은 다음 다크샤이어에 있는 조나단 카레빈에게 돌아가야 합니다.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Busca signos de la Guadaña de Elune y regresa a Villa Oscura, con Jonathan Carevin.‡Chercher les signes de la Faux d\'Elune puis retourner voir Jonathan Carevin à Sombre-comté.‡去找关于月神镰刀的消息，然后回到夜色镇见乔纳森·卡尔文。‡去找關於月神鐮刀的消息，然後回到夜色鎮見喬納森·卡爾文。',
  }
},
[1044] = {
  {
    'Perguntas esclarecidas‡Полученные ответы‡Beantwortete Fragen‡해결된 의문‡La respuesta a las preguntas‡La respuesta a las preguntas‡Réponses aux questions‡问题的答案‡獲得答覆的問題',
    nil,
    'Fale novamente com Thyn\'tel Tecelâmina em Darnassus.‡Вернитесь к Тин\'тель Танцу Клинка в Дарнас.‡Kehrt nach Darnassus zu Thyn\'tel Klingenweber zurück.‡다르나서스에 있는 신텔 블레이드위버에게 돌아가야 합니다.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Regresa a Darnassus y habla con Thyn\'tel Tejespada.‡Retournez vers Thyn\'tel Tisselame à Darnassus.‡回到达纳苏斯去见塞恩提尔·刃纹。‡回到達納蘇斯去見塞恩提爾·刃紋。',
  }
},
[1045] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Mate Ran Dente Sangrento e 4 Guardas Dente Sangrento e colete o Crânio de Ran Dente Sangrento. Fale novamente com Krolg perto do Lago Mistral quando tiver sucesso.‡Убейте Рэна Кровавого Клыка, 4 кровозубых стражей и принесите череп Рэна Кролгу у озера Мистраль.‡Tötet Ran Blutreißer sowie 4 Wachen von Blutreißer. Beschafft Euch Ran Blutreißers Schädel und kehrt dann zu Krolg in der Nähe des Mystralsees zurück.‡랜 블러드투스와 붉은송곳니 경비병 4명을 처치하고 랜 블러드투스의 해골을 미스트랄 호수 근처에 있는 크롤그에게 가져가야 하니다.‡Mata a Ran Sangradientes, 4 guardias Sangradientes y coge la calavera de Ran Sangradientes. Regresa con Krolg cerca del Lago Mystral cuando lo hayas conseguido.‡Mata a Ran Sangradientes, 4 guardias Sangradientes y coge la calavera de Ran Sangradientes. Regresa con Krolg cerca del Lago Mystral cuando lo hayas conseguido.‡Tuez Ran Dent-rouge ainsi que 4 Gardes de Dent-rouge et récupérez le Crâne de Ran Dent-rouge. Si vous réussissez, retournez voir Krolg près du lac Mystral.‡杀死兰恩·血牙和4个血牙保镖，并拿到兰恩·血牙的徽记，然后向密斯特拉湖附近的克罗尔格复命。‡殺死蘭恩·血牙和4個血牙保鏢，並帶走蘭恩·血牙的顱骨。完成之後再回去密斯特拉湖附近找庫羅格。',
  }
},
[1046] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Leve o Crânio de Ran Dente Sangrento para Raene Correlobos em Astranaar.‡Принесите череп Рэна Кровавого Клыка Раэне Волкопас в Астранаар.‡Bringt Raene Wolfsläufer in Astranaar Ran Blutreißers Schädel.‡아스트라나르에 있는 레이네 울프러너에게 랜 블러드투스의 해골을 가져가야 합니다.‡Llévale la calavera de Ran Sangradientes a Raene Correlobo en Astranaar.‡Llévale la calavera de Ran Sangradientes a Raene Correlobo en Astranaar.‡Apporter le Crâne de Ran Dent-rouge à Raene Mène-loup à Astranaar.‡把兰恩·血牙的徽记交给阿斯特兰纳的莱恩·狼行者。‡把蘭恩·血牙的顱骨交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1047] = {
  {
    'Uma nova fronteira‡Новое пограничье‡Die neue Grenze‡새로운 미개척지‡La nueva frontera‡La nueva frontera‡La nouvelle frontière‡新的边疆‡新的邊疆',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo, no Enclave Cenariano de Darnassus, sobre o chamado do Círculo Cenariano para explorar as fronteiras de Kalimdor.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом из дарнасского анклава Кенария относительно призыва Круга Кенария к изучению окраин Калимдора.‡Sprecht in der Enklave des Cenarius in Darnassus mit dem Erzdruiden Fandral Hirschhaupt über den Aufruf des Zirkels des Cenarius zur Erforschung der Grenzgebiete von Kalimdor.‡다르나서스의 세나리온 자치령에 있는 대드루이드 판드랄 스테그헬름을 찾아가 세나리온 의회의 칼림도어 미개척지 탐험 지원자 모집에 대한 얘기를 나눠야 합니다.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Habla con el archidruida Fandral Corzocelada en el Enclave Cenarion de Darnassus sobre la llamada del Círculo Cenarion para explorar las fronteras de Kalimdor.‡Parler à l\'archidruide Fandral Forteramure, dans l\'Enclave cénarienne, à Darnassus. Évoquer l\'appel du Cercle cénarien concernant l\'exploration des frontières de Kalimdor.‡与达纳苏斯塞纳里奥区的大德鲁范达尔·鹿盔谈一谈关于议会号召联盟成员探索卡利姆多大陆的事情。‡與達納蘇斯塞納里奧區的大德魯范達爾·鹿盔談一談關於議會號召聯盟成員探索卡林多大陸的事情。',
  }
},
[1048] = {
  {
    'Adentrando o Monastério Escarlate‡В монастырь Алого ордена‡In das Scharlachrote Kloster‡붉은십자군 수도원으로‡En el Monasterio Escarlata‡En el Monasterio Escarlata‡Au monastère écarlate‡深入血色修道院‡深入血色修道院',
    nil,
    'Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.‡Kill High Inquisitor Whitemane, Scarlet Commander Mograine, Herod, the Scarlet Champion and Houndmaster Loksey and then report back to Varimathras in the Undercity.',
  }
},
[1049] = {
  {
    'O Compêndio dos Caídos‡"Компендиум павших"‡Kompendium der Gefallenen‡타락의 개요‡El Compendio de los Caídos‡El Compendio de los Caídos‡Compendium des Déchus‡堕落者纲要‡墮落者綱要',
    nil,
    'Recupere o Compêndio dos Caídos no Monastério nas Clareiras de Tirisfal e volte a falar com o Sábio Devoto da Verdade no Penhasco do Trovão.‡Добудьте "Компендиум павших" из монастыря в Тирисфальских лесах и возвращайтесь к Ведуну Искателю Истины в Громовой Утес.‡Holt das \'Kompendium der Gefallenen\' aus dem Kloster in Tirisfal und bringt es zu dem Weisen Wahrspruch in Donnerfels.‡티리스팔 숲의 붉은십자군 수도원에서 타락의 개요를 찾아 썬더 블러프에 있는 현자 트루스시커에게 가져가야 합니다.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscador de la Verdad, que está en Cima del Trueno.‡Recupera el Compendio de los Caídos del Monasterio que se encuentra en los Claros de Tirisfal y regresa ante Sabio Buscador de la Verdad, que está en Cima del Trueno.‡Trouver le « Compendium des Déchus » au Monastère dans les Clairières de Tirisfal et retourner voir le Sage Recherche-la-vérité aux Pitons du Tonnerre.‡从血色修道院里找到《堕落者纲要》，把它交给雷霆崖的圣者图希克。‡從血色修道院裡找到《墮落者綱要》，把它交給雷霆崖的賢者圖希克。',
  }
},
[1050] = {
  {
    'Mitologia dos Titãs‡"Мифология Титанов"‡Mythologie der Titanen‡티탄 신화‡Mitología de los titanes‡Mitología de los titanes‡Mythologie des titans‡泰坦神话‡泰坦神話',
    nil,
    'Recupere o livro Mitologia dos Titãs no Monastério e leve-o para a Bibliotecária Maé Palidopó em Altaforja.‡Добудьте "Мифологию Титанов" из монастыря и принесите ее библиотекарю Мае Белокожке в Стальгорн.‡Holt die \'Mythologie der Titanen\' aus dem Kloster und bringt die der Bibliothekarin Mae Bleichstaub in Eisenschmiede.‡수도원에서 티탄 신화라는 책을 찾아 아이언포지에 있는 사서 메이 페일더스트에게 가져가야 합니다.‡Coge Mitología de los titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Busca Mitología de los titanes en el monasterio y llévaselo a la bibliotecaria Mae Palipolvo a Forjaz.‡Reprendre « la Mythologie des titans » au Monastère et le rapporter à la Bibliothécaire Mae Blêmepoussière à Forgefer.‡从修道院拿回《泰坦神话》，把它交给铁炉堡的图书馆员麦伊·苍尘。‡從修道院拿回《泰坦神話》，把它交給鐵爐堡的圖書館員麥伊·蒼塵。',
  }
},
[1051] = {
  {
    'A vingança de Vorrel‡Месть Воррела‡Vorrels Rache‡보렐의 복수‡La venganza de Vorrel‡La venganza de Vorrel‡La vengeance de Vorrel‡沃瑞尔的复仇‡沃瑞爾的復仇',
    nil,
    'Leve a aliança de Vorrel Sentripaz para Mônica Sentripaz na Serraria Tarren.‡Верните обручальное кольцо Воррела Сенгутца Монике Сенгутц в Мельнице Таррен.‡Bringt Monika Sengutz in Tarrens Mühle den Ehering von Vorrel Sengutz.‡타렌 밀농장에 있는 모니카 센구츠에게 보렐의 결혼반지를 가져가야 합니다.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Lleva la alianza de Vorrel Sengutz a Monika Sengutz de Molino Tarren.‡Rapporter l\'anneau de mariage de Vorrel Sengutz à Monika Sengutz à Moulin-de-Tarren.‡把沃瑞尔·森加斯的结婚戒指还给塔伦米尔的莫尼卡·森古特斯。‡把沃瑞爾·森古斯的結婚戒指還給塔倫米爾的莫尼卡·森古斯。',
  }
},
[1052] = {
  {
    'No caminho Escarlate‡По пути Алого ордена‡Auf dem Scharlachroten Pfad‡붉은십자군의 길‡El sendero Escarlata‡El sendero Escarlata‡Sur le chemin écarlate‡血色之路‡血色之路',
    nil,
    'Leve a Carta de Comenda de Anton para Raul, o Devotado, na Costa Sul.‡Отнесите рекомендательное письмо брата Антона Ролею Благочестивому в Южнобережье.‡Bringt Raleigh dem Andächtigen in Süderstade Bruder Antons Empfehlungsschreiben.‡사우스쇼어에 있는 경건한 신자 랄레이에게 수사 안톤의 추천서를 가져가야 합니다.‡Lleva la carta de recomendación del hermano Anton a Raleigh el Devoto, en Costasur.‡Lleva la carta de mención honorífica del hermano Anton a Raleigh el Devoto, en Costasur.‡Apporter la Lettre de recommandation du Frère Anton à Raleigh le Dévot à Austrivage.‡将安东修士的表彰信带给南海镇的虔诚的莱雷恩。‡將安東修士的表彰信帶給南海鎮的虔誠的萊雷恩。',
  }
},
[1053] = {
  {
    'Em nome da Luz‡Во имя Света!‡Im Namen des Lichts‡빛의 이름으로!‡En el nombre de la Luz‡En el nombre de la Luz‡Au nom de la Lumière‡以圣光之名‡以聖光之名',
    nil,
    'Mate a Alta-inquisidora Cristalba, o Comandante Escarlate Mograine, Herodes, o Campeão Escarlate e o Mestre de Matilha Lobato, depois volte a falar com Raul, o Devotado na Costa Sul.‡Убейте Верховного инквизитора Вайтмейн, командира Могрейна из Алого ордена, воителя Ирода из Алого ордена и псаря Локси, после этого вернитесь с докладом к Ролею Благочестивому в Южнобережье.‡Tötet Hochinquisitorin Weißsträhne, den Scharlachroten Kommandant Mograine, Herod, den Scharlachroten Helden sowie den Hundemeister Loksey und meldet Euch dann wieder bei Raleigh dem Andächtigen in Süderstade.‡종교재판관 화이트메인, 붉은십자군 사령관 모그레인, 붉은십자군 용사 헤로드와 사냥개조련사 록시를 처치한 후 사우스쇼어에 있는 경건한 신자 랄레이에게 돌아가 보고하십시오.‡Mata a la alta inquisidora Melenablanca, al Comandante Escarlata Mograine, a Herod, el Campeón Escarlata y al maestro de canes Loksey. A continuación, preséntate ante Raleigh el Devoto, en Costasur.‡Mata a la alta inquisidora Melenablanca, al Comandante Escarlata Mograine, a Herod, el Campeón Escarlata y al maestro de canes Loksey. A continuación, preséntate ante Raleigh el Devoto, en Costasur.‡Tuer la Grande inquisitrice Blanchetête, Mograine le Commandant de la Croisade, Hérode le Champion de la Croisade et le Maître-chien Loksey, et retourner faire un rapport à Raleigh le Dévot à Austrivage.‡杀死大检察官怀特迈恩，血色十字军指挥官莫格莱尼，十字军的勇士赫洛德和驯犬者洛克希并向南海镇的莱雷恩复命。‡殺死高階審判官懷特邁恩，血色十字軍指揮官莫格萊尼，十字軍的勇士赫洛德和馴犬者洛克希並向南海鎮的萊雷恩覆命。',
  }
},
[1054] = {
  {
    'Contendo a ameaça‡Устранение угрозы‡Die Auswahl der Bedrohung‡위협 제거‡Matanza selectiva‡Matanza selectiva‡Diminution de la menace‡解除威胁‡解除威脅',
    nil,
    'Leve o Crânio de Dal Sangarra para Raene Correlobos em Astranaar.‡Принесите череп Дала Жилотяга Раэне Волкопас в Астранаар.‡Bringt Raene Wolfsläufer in Astranaar Dal Blutklaues Schädel.‡아스트라나르에 있는 레이네 울프러너에게 달 블러드클로의 해골을 가져가야 합니다.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Llévale la calavera de Dal Zarpasangrante a Raene Correlobo en Astranaar.‡Apporter le Crâne de Dal Griffe-de-sang à Raene Mène-loup à Astranaar.‡把达尔·血爪的徽记交给阿斯特兰纳的莱恩·狼行者。‡把達爾·血爪的顱骨交給阿斯特蘭納的萊恩·狼行者。',
  }
},
[1055] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Fale novamente com Shael\'dryn no poço lunar.‡Вернитесь к Шаэл\'дрин у лунного колодца.‡Kehrt zu Shael\'dryn beim Mondbrunnen zurück.‡달샘에 있는 셸드린에게 돌아가야 합니다.‡Vuelve junto a Shael\'dryn en la Poza de la Luna.‡Vuelve junto a Shael\'dryn en la Poza de la Luna.‡Retourner voir Shael\'dryn au puits de lune.‡回到月亮井旁的莎尔蒂恩那里。‡回到月井旁的莎爾蒂恩那裡。',
  }
},
[1056] = {
  {
    'A jornada para o Morro das Torres de Pedra‡Путешествие к Пику Каменного Когтя‡Reise zum Steinkrallengipfel‡돌발톱 봉우리로의 여정‡Viaje a Cima del Espolón‡Viaje a Cima del Espolón‡Voyage au pic des Serres-Rocheuses‡石爪峰之旅‡石爪峰之旅',
    nil,
    'Vá até o Guardião Albagorm no Morro das Torres de Pedra.‡Отправляйтесь к хранителю Албагорму на Пик Каменного Когтя.‡Reist zu Bewahrer Albagorm auf dem Steinkrallengipfel.‡돌발톱 봉우리에 있는 수호자 알바고름을 찾아가야 합니다.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Ve junto al vigilante Albagorm en la Cima del Espolón.‡Voyager pour aller voir le Gardien Albagorm au pic des Serres-Rocheuses.‡拜访石爪峰的看守者奥巴格姆。‡拜訪石爪峰的看守者奧巴格姆。',
  }
},
[1057] = {
  {
    'Reivindicando o Vale Carbonizado‡Возвращение Горелой Долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'O Guardião Albagorm, no Morro das Torres de Pedra, quer que você mate 7 Harpias Furissangue, 7 Emboscadoras Furissangue e 7 Plumerrantes Furissangue.‡Хранитель Албагорм с Пика Каменного Когтя просит вас убить 7 гарпий, 7 душительниц, 7 душегубок и 7 бродяжниц из стаи Кровавой Ярости.‡Bewahrer Albagorm auf dem Steinkrallengipfel möchte, dass Ihr 7 Harpyien der Blutfurien, 7 Wegelagerinnen der Blutfurien, 7 Töterinnen der Blutfurien und 7 Wildfedern der Blutfurien erschlagt.‡돌발톱 봉우리에 있는 수호자 알바고름이 혈폭풍하피 7마리, 혈폭풍일족 복병 7마리, 혈폭풍일족 암살자 7마리, 그리고 혈폭풍일족 약탈자 7마리를 처치해 달라고 부탁했습니다.‡El vigilante Albagorm en la Cima del Espolón quiere que mates 7 arpías Furia Sangrienta, 7 emboscadoras Furia Sangrienta, 7 destripadoras Furia Sangrienta y 7 malaplumas Furia Sangrienta.‡El vigilante Albagorm en la Cima del Espolón quiere que mates a 7 arpías Furia Sangrienta, a 7 emboscadoras Furia Sangrienta, a 7 destripadoras Furia Sangrienta y a 7 malaplumas Furia Sangrienta.‡Le Gardien Albagorm du pic des Serres-Rocheuses veut que vous tuiez 7 Harpies, 7 Embusqués, 7 Tueuses et 7 Volplumes Rougefuries.‡石爪峰的守护者奥巴格姆要求你杀死7个血怒鹰身人、7个血怒伏击者、7个血怒杀戮者和7个血怒游荡者。‡石爪峰的守護者奧巴格姆要求你殺死7個血怒鷹身人、7個血怒伏擊者、7個血怒殺戮者和7個血怒遊蕩者。',
  }
},
[1058] = {
  {
    'A magia florestal de Jin\'Zil‡Лесная магия Джин\'Зила‡Jin\'Zils Waldmagie‡진질의 숲의 마법‡Magia del bosque de Jin\'Zil‡Magia del bosque de Jin\'Zil‡Magie de la forêt de Jin\'Zil‡金吉尔的森林魔法‡金吉爾的森林魔法',
    nil,
    'O Mandingueiro Jin\'Zil, em Malaka\'jin, quer 5 porções de Seiva das Torres de Pedra, 5 Bigodes de Felino do Crepúsculo, 30 Olhos de Corcel e uma Escama de Dragão Encantado.‡Знахарь Джин\'Зил из Малака\'джина требует принести 5 порций слизи Каменного когтя, 5 сумеречных усиков, 30 глаз бегового оленя и чешуйку волшебного дракончика.‡Hexendoktor Jin\'Zil in Malaka\'jin möchte 5 Portionen Steinkrallensaft, 5 Schnurrhaare eines Mondlichtläufers, 30 Renneraugen und die Schuppe eines Siechdrachen.‡말라카진에 있는 의술사 진질이 돌발톱 수액 5개, 황혼의 수염 5개, 순록의 눈 30개와 마룡 비늘 1개를 가져다 달라고 부탁했습니다.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia del Espolón, 5 mostachos Crepusculares, 30 ojos de trotadores y una escama de dragón hada.‡El médico brujo Jin\'Zil en Malaka\'jin quiere 5 porciones de savia del Espolón, 5 mostachos Crepusculares, 30 ojos de trotadores y una escama de dragón hada.‡Le Féticheur Jin\'Zil à Malaka\'jin veut 5 doses de Sève des Serres-Rocheuses, 5 Moustaches crépusculaires, 30 Yeux de coursier et une Ecaille de dragon-faë.‡玛拉卡金的巫医金吉尔需要5瓶石爪苔液、5根夜行虎须、30颗巨角鹿的眼球和1块灵龙的鳞片。‡瑪拉卡金的巫醫金吉爾需要5瓶石爪苔液、5根夜行虎鬚、30顆巨角鹿的眼球和1塊靈龍的鱗片。',
  }
},
[1059] = {
  {
    'Reivindicando o Vale Carbonizado‡Возвращение Обугленной долины‡Die Rückeroberung des verbrannten Tals‡잿더미 계곡 복원‡La reconquista de La Vega Carbonizada‡La reconquista de La Vega Carbonizada‡À la reconquête du Val calciné‡夺回焦炭谷‡奪回焦炭谷',
    nil,
    'Viaje até Falfindel Trilhemas na fronteira entre Mil Agulhas e Feralas.‡Отправляйтесь к Фалфиндеру Хранителю Дорог, живущему на границе Тысячи Игл и Фераласа.‡Reist zu Falfindel Wegeshut an der Grenze zwischen Tausend Nadeln und Feralas.‡버섯구름 봉우리와 페랄라스의 경계에 있는 팔핀델 웨이워더를 찾아가야 합니다.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Ve a ver al Díscolo Falfindel en la frontera entre Las Mil Agujas y Feralas.‡Trouver Falfindel Gardevoie à la frontière entre les Mille pointes et Féralas.‡在千针石林与菲拉斯的边境上找到法芬德尔。‡在千針石林與菲拉斯的邊境上找到法芬德爾。',
  }
},
[1060] = {
  {
    'Uma carta para Jin\'Zil‡Письмо Джин\'Зилу‡Brief an Jin\'Zil‡진질에게 보내는 편지‡Una carta para Jin\'Zil‡Carta para Jin\'Zil‡Lettre à Jin\'Zil‡写给金吉尔的信‡寫給金吉爾的信',
    nil,
    'Entregue a carta de Darsok a Jin\'Zil em sua caverna em Malaka\'jin, nas Torres de Pedra.‡Отнесите письмо Дарсока Джин\'Зилу в пещеру Малака\'джин в Когтистых горах.‡Überbringt Jin\'Zil in seiner Höhle in Malaka\'jin im Steinkrallengebirge Darsoks Brief.‡돌발톱 산맥의 동굴에서 야영을 하는 진질에게 달소크의 편지를 전달해야 합니다.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Entrégale la carta de Darsok a Jin\'Zil en su cueva de Malaka\'jin, en Espolón.‡Remettez la lettre de Darsok à Jin\'Zil dans sa caverne de Malaka\'Jin, dans les Serres-Rocheuses.‡把达索克的亲笔信交给金吉尔，他住在石爪山的洞穴中。‡把達索克的親筆信交給金吉爾，他住在石爪山的洞穴中。',
  }
},
[1061] = {
  {
    'Os espíritos das Torres de Pedra‡Духи Каменного Когтя‡Die Geister des Steinkrallengebirges‡돌발톱 산맥의 정령‡Los espíritus del Espolón‡Los espíritus del Espolón‡Les esprits des Serres-Rocheuses‡石爪之灵‡石爪之靈',
    nil,
    'Speak with Seereth Stonebreak at the border of the Stonetalon Mountains and the Barrens.‡Поговорите с Сирит Камнелом на границе Когтистых гор и Степей.‡Sprecht mit Seereth Bruchstein an der Grenze zwischen dem Steinkrallengebirge und dem Brachland.‡불모의 땅과 돌발톱 산맥의 경계에 있는 시리스 스톤브레이크와 대화해야 합니다.‡Habla con Seereth Rompepedras en la frontera entre Sierra Espolón y Los Baldíos.‡Habla con Seereth Petrajada en la frontera entre Sierra Espolón y Los Baldíos.‡Parler à Seereth Bris-de-pierre à la frontière des Serres-Rocheuses et des Tarides.‡找到石爪山脉和贫瘠之地交界处的的希雷斯·碎石并和她谈一谈。‡找到在石爪山和貧瘠之地邊界的希雷斯·碎石並和她談話。',
  }
},
[1062] = {
  {
    'Invasores goblins‡Вторжение гоблинов‡Goblineindringlinge‡고블린 침략자‡Los invasores goblin‡Los invasores goblin‡Les invasions gobelines‡地精侵略者‡哥布林侵略者',
    nil,
    'Mate 15 Madeireiros da Empreendimentos S.A. e, então, fale novamente com Seereth Quebra-pedra na fronteira entre as Torres de Pedra e os Sertões.‡Убейте 15 лесорубов Торговой Компании, затем вернитесь к Сирет Камнелом на границу Каменного Когтя и Степей.‡Tötet 15 Holzfäller der Venture Co. und kehrt dann zu Seereth Bruchstein an der Grenze des Steinkrallengebirges und dem Brachland zurück.‡투자개발회사 나무꾼 15명을 처치한 다음 돌발톱 산맥과 불모의 땅의 경계에 있는 시리스 스톤브레이크에게 돌아가야 합니다.‡Mata 15 leñadores de Ventura y Cía. y vuelve a ver a Seereth Rompepedras, en la frontera entre Espolón y Los Baldíos.‡Mata a 15 leñadores de Ventura y Cía. y vuelve a ver a Seereth Petrajada, en la frontera entre Espolón y Los Baldíos.‡Tuer 15 Déboiseurs de la KapitalRisk, puis retourner auprès de Seereth Bris-de-pierre à la frontière des Serres-Rocheuses et des Tarides.‡杀死15个风险投资公司樵夫，然后向石爪山与贫瘠之地交界处的希雷斯·碎石复命。‡殺死15個風險投資公司的伐木工，然後回去找石爪山與貧瘠之地交界處的希雷斯·碎石。',
  }
},
[1063] = {
  {
    'A Bruxa Anciã‡Мудрая старуха‡Die Ältestengreisin‡원로 마가타‡La vieja bruja‡La bruja anciana‡L\'Ancienne‡长者‡長者',
    nil,
    'Fale com Magatha no Penhasco do Trovão.‡Поковорите с Магатой в Громовом Утесе.‡Sprecht in Donnerfels mit Magatha.‡썬더 블러프에 있는 마가타와 대화해야 합니다.‡Habla con Magatha en Cima del Trueno.‡Habla con Magatha en Cima del Trueno.‡Parler à Magatha aux Pitons du Tonnerre.‡与雷霆崖的玛加萨谈一谈。‡與雷霆崖的瑪加薩談話。',
  }
},
[1064] = {
  {
    'Ajuda Renegada‡Помощь Отрекшихся‡Die Hilfe der Verlassenen‡포세이큰의 원조‡La ayuda de los Renegados‡Ayuda de los Renegados‡L\'aide des Réprouvés‡被遗忘者的援助‡被遺忘者的援助',
    nil,
    'Fale com a Boticária Zaqueia nos Poços das Visões, que ficam no Penhasco do Trovão.‡Поговорите с аптекаршей Замой у Прудов Видений в Громовом Утесе.‡Sprecht bei den Teichen der Visionen in Donnerfels mit der Apothekerin Zamah.‡썬더 블러프의 예언의 웅덩이에 있는 연금술사 자마와 대화해야 합니다.‡Habla con la boticaria Zamah en las Pozas de las Visiones de Cima del Trueno.‡Habla con la boticaria Zamah en las Pozas de las Visiones de Cima del Trueno.‡Parler à l\'Apothicaire Zamah aux Bassins de la vision.‡和预见之池的药剂师扎玛谈一谈。‡和預見之池的藥劑師札瑪談話。',
  }
},
[1065] = {
  {
    'A jornada para Serraria Tarren‡Путешествие в Мельницу Таррен‡Reise nach Tarrens Mühle‡타렌 밀농장으로의 모험‡Viaja a Molino Tarren‡Viaje a Molino Tarren‡Un voyage vers Moulin-de-Tarren‡塔伦米尔之旅‡塔倫米爾之旅',
    nil,
    'Leve o Bilhete de Zaqueia para o Boticário Lindolfo na Serraria Tarren.‡Принесите записку Замы аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle Zamahs Notiz.‡타렌 밀농장에 있는 연금술사 라이던에게 자마의 쪽지를 가져가야 합니다.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Entrégale la nota de Zamah al boticario Lydon, que está en Molino Tarren.‡Apportez la Note de Zamah à l\'Apothicaire Lydon à Moulin-de-Tarren.‡把扎玛的信带给塔伦米尔的林度恩。‡把札瑪的便箋帶給塔倫米爾的林度恩。',
  }
},
[1066] = {
  {
    'Sangue dos Inocentes‡Невинная кровь‡Das Blut Unschuldiger‡순결한 피‡Sangre inocente‡Sangre inocente‡Le sang des innocents‡无辜者之血‡無辜者之血',
    nil,
    'Leve 5 Ampolas de Sangue Inocente para o Boticário Lindolfo na Serraria Tarren.‡Принесите 5 фиалов крови невинных аптекарю Лидону в Мельницу Таррен.‡Bringt Apotheker Lydon in Tarrens Mühle 5 Phiolen mit dem Blut Unschuldiger.‡타렌 밀농장에 있는 연금술사 라이던에게 순결한 피가 든 유리병 5병을 가져가야 합니다.‡Lleva 5 viales de sangre inocente al boticario Lydon de Molino Tarren.‡Lleva 5 viales de sangre inocente al boticario Lydon de Molino Tarren.‡Apporter 5 Fioles de Sang d\'innocent à l\'apothicaire Lydon à Moulin-de-Tarren.‡为塔伦米尔的药剂师林度恩收集5瓶无辜者之血。‡為塔倫米爾的藥劑師林度恩收集5瓶無辜者之血。',
  }
},
[1067] = {
  {
    'Volte ao Penhasco do Trovão‡Возвращение в Громовой Утес‡Rückkehr nach Donnerfels‡썬더 블러프로의 귀환‡Regresa a Cima del Trueno‡Regreso a Cima del Trueno‡Le retour aux Pitons du Tonnerre‡返回雷霆崖‡返回雷霆崖',
    nil,
    'Leve a Toxina do Lindolfo para a Boticária Zaqueia no Penhasco do Trovão.‡Отнесите отраву Лидона аптекарю Заме в Громовой Утес.‡Bringt Apothekerin Zamah in Donnerfels Lydons Toxin.‡썬더 블러프에 있는 연금술사 자마에게 라이던의 독약을 가져가야 합니다.‡Lleva la toxina de Lydon a la boticaria Zamah de Cima del Trueno.‡Lleva la toxina de Lydon a la boticaria Zamah de Cima del Trueno.‡Apporter la Toxine de Lydon à l\'Apothicaire Zamah aux Pitons du Tonnerre.‡把林度恩的毒药交给雷霆崖的药剂师扎玛。‡把林度恩的毒藥交給雷霆崖的藥劑師札瑪。',
  }
},
[1068] = {
  {
    'Retalhando as máquinas retalhadoras‡Механические измельчители‡Schreddermaschinen‡벌목기‡Las sierras XT:4 y XT:9‡Las sierras XT:4 y XT:9‡Les machines à déchiqueter‡伐木机‡伐木機',
    nil,
    'Destrua os retalhadores XT:4 e XT:9 e, então, fale novamente com Seereth Quebra-pedra na fronteira entre a Cordilheira das Torres de Pedra e os Sertões.‡Уничтожьте шреддеры XT:4 и XT:9, затем вернитесь к Сирит Камнелом на границу Когтистых гор и Степей.‡Vernichtet die Schredder XT:4 und XT:9 und kehrt dann zu Seereth Bruchstein an der Grenze zwischen dem Steinkrallengebirge und dem Brachland zurück.‡벌목기 XT:4와 XT:9를 파괴한 다음 돌발톱 산맥과 불모의 땅의 경계에 있는 시리스 스톤브레이크에게 돌아가야 합니다.‡Destruye las sierras XT:4 y XT:9, a continuación vuelve a ver a Seereth Rompepedras, en la frontera entre Sierra Espolón y Los Baldíos.‡Destruye las sierras XT:4 y XT:9, a continuación vuelve a ver a Seereth Petrajada, en la frontera entre Sierra Espolón y Los Baldíos.‡Détruire les Déchiqueteurs XT4 et XT9, puis retourner voir Seereth Bris-de-pierre à la frontière entre les Serres-Rocheuses et les Tarides.‡杀死伐木机XT:4和XT:9，然后向石爪山与贫瘠之地交界处的希雷斯·碎石复命。‡殺死伐木機XT:4和XT:9，然後向石爪山與貧瘠之地交界處的希雷斯·碎石覆命。',
  }
},
[1069] = {
  {
    'Ovos de Aranha de Fundolimo‡Яйца мохового паука‡Eier der Kluftmoosspinnen‡동굴이끼거미알‡Huevos de arañas Musgondo‡Huevos de araña musgondo‡Omelette à la mousse profonde‡深苔蜘蛛的卵‡深苔蜘蛛的卵',
    nil,
    'Leve 15 Ovos de Fundolimo para Cáliper Porcatraca em Vila Catraca.‡Принесите Мебоку Миззриксу из Кабестана 15 яиц мохового паука.‡Bringt Mebok Mizzyrix in Ratschet 15 Kluftmooseier.‡톱니항에 있는 메보크 미지릭스에게 동굴이끼거미알 15개를 가져가야 합니다.‡Llévale 15 huevos de musgondo a Mebok Mizzyrix en Trinquete‡Llévale 15 huevos de Musgondo a Mebok Mizzyrix en Trinquete.‡Apporter 15 Œufs des mousses profondes à Mebok Mizzyrix à Cabestan.‡收集15颗深苔蜘蛛的卵，把它们交给棘齿城的麦伯克·米希瑞克斯。‡收集15顆深苔蜘蛛的卵，把它們交給棘齒城的麥伯克·米希瑞克斯。',
  }
},
[1070] = {
  {
    'Em guarda nas Torres de Pedra‡На страже в Когтистых горах‡Wache halten im Steinkrallengebirge‡돌발톱 산맥에서의 임무‡Estar de guardia en Espolón‡Estar de guardia en Espolón‡De garde dans les Serres-Rocheuses‡守卫石爪山‡守衛石爪山',
    nil,
    'Encontre Kaela Umbralança, que está de frente para o vale que adentra o Rochedo Cortavento, na Cordilheira das Torres de Pedra.‡Найдите Келу Копье Тени, которая наблюдает за долиной, выходящей к Утесу Ветрорезов в Когтистых горах.‡Sucht Kaela Schattenspeer, die auf der Scherwindklippe im Steinkrallengebirge den Taleingang beobachtet.‡돌발톱 산맥에 있는 칼바람 바위산 입구에 계곡이 내려다보이는 곳에 캘라 섀도스피어를 찾아야 합니다.‡Encuentra a Kaela Lanzasombra contemplando la vista del valle a la entrada del Risco Cortaviento, en Sierra Espolón.‡Encuentra a Kaela Lanzasombra contemplando la vista del valle a la entrada del Risco Cortaviento, en Sierra Espolón.‡Retrouver Kaela Ombrelance qui surveille la vallée à l\'entrée de la combe des Cisailles dans les Serres-Rocheuses.‡找到位于石爪山脉狂风峭壁旁的山谷中的凯拉·影矛。‡找到位於石爪山脈狂風峭壁旁的山谷中的凱拉·影矛。',
  }
},
[1071] = {
  {
    'Adiamento gnômico‡Отсрочка для гнома‡Der Aufschub des Gnoms‡노움의 부탁‡Una tregua para el gnomo‡Una tregua para el gnomo‡Du répit pour un gnome‡侏儒学者‡地精學者',
    nil,
    'Mate 10 Madeireiros da Empreendimentos S.A. e 10 Desmatadores da Empreendimentos S.A. e fale novamente com Gaxim Deuxabu nas Torres de Pedra.‡Убейте 10 лесорубов и 10 лесозаготовителей Торговой Компании и вернитесь к Гаксиму Ржавошиппи в Каменный Коготь.‡Tötet 10 Holzfäller der Venture Co. und 10 Roder der Venture Co. und kehrt dann zu Gaxim Rostknirsch im Steinkrallengebirge zurück.‡투자개발회사 나무꾼 10명 및 투자개발회사 벌채꾼 10명을 처치하고 돌발톱 산맥에 있는 각심 러스트피즐에게 돌아가야 합니다.‡Mata 10 leñadores de Ventura y Cía. y 10 deforestadores de Ventura y Cía. A continuación, vuelve a ver a Gaxim Silvóxido en Espolón.‡Mata a 10 leñadores de Ventura y Cía. y a 10 deforestadores de Ventura y Cía. A continuación, vuelve a ver a Gaxim Silvóxido en Espolón.‡Tuer 10 Déboiseurs de la KapitalRisk et 10 Défricheurs de la KapitalRisk, puis retourner voir Gaxim Larguerouille dans les Serres-Rocheuses.‡杀掉10名风险投资公司樵夫和10名风险投资公司砍树工，然后向石爪山的加克希姆·尘链复命。‡殺掉10名風險投資公司伐木工和10名風險投資公司砍樹工，然後向石爪山的加克希姆·塵鏈覆命。',
  }
},
[1072] = {
  {
    'Um velho colega‡Старый коллега‡Ein alter Kollege‡오랜 동료‡Un viejo colega‡Un viejo colega‡Un vieux collègue‡老同事‡老同事',
    nil,
    'Fale com Lomac Motopista em Altaforja.‡Поговорите с Ломаком Демонтирсом в Стальгорне.‡Sprecht mit Lomac Ritzeldreh in Eisenschmiede.‡아이언포지에 있는 로막 기어스트립과 대화해야 합니다.‡Habla con Lomac Destrabaengranajes en Forjaz.‡Habla con Lomac Destrabaengranajes en Forjaz.‡Parler à Lomac Rubangrenage à Forgefer.‡与铁炉堡的洛玛克·链带谈一谈。‡與鐵爐堡的洛瑪克·鏈帶談話。',
  }
},
[1073] = {
  {
    'Inaptidão + Reagentes = Diversão‡Неумение + реактивы = потеха!‡Stümperhaftigkeit + Chemikalien = Riesenspaß!‡어리석음 + 화학 물질 = 재미‡Ineptitud + Productos químicos = Diversión‡Ineptitud + Productos químicos = Diversión‡Inaptitude + Produits chimiques = Rigolo‡失职+药剂=快乐‡失職+藥劑=快樂',
    nil,
    'Leve 4 Poções Menores de Mana e 2 Elixires de Fortitude Menor para Lomac Motopista em Altaforja.‡Принесите 4 крохотных флакона с зельем маны и 2 слабых эликсира стойкости Ломаку Демонтирсу в Стальгорн.‡Bringt Lomac Ritzeldreh in Eisenschmiede 4 schwache Manatränke und 2 Elixiere der schwachen Seelenstärke.‡아이언포지에 있는 로막 기어스트립에게 최하급 마나 물약 4개와 최하급 인내의 비약 2개를 가져가야 합니다.‡Lleva 4 pociones de maná menores y 2 elixires de entereza menores a Lomac Destrabaengranajes en Forjaz.‡Lleva 4 pociones menores de maná y 2 elixires de entereza menor a Lomac Destrabaengranajes en Forjaz.‡Apporter 4 Potions de mana mineures et 2 Elixirs de Robustesse mineure à Lomac Rubangrenage à Forgefer.‡给铁炉堡的洛玛克·链带拿去4瓶初级法力药水和2瓶初级坚韧药剂。‡給鐵爐堡的洛瑪克·鏈帶拿去4瓶初級法力藥水和2瓶初級堅韌藥劑。',
  }
},
[1074] = {
  {
    'Inaptidão + Reagentes = Diversão‡Неумение + реактивы = потеха!‡Stümperhaftigkeit + Chemikalien = Riesenspaß!‡어리석음 + 화학 물질 = 재미‡Ineptitud + Productos químicos = Diversión‡Ineptitud + Productos químicos = Diversión‡Inaptitude + Produits chimiques = Rigolo‡失职+药剂=快乐‡失職+藥劑=快樂',
    nil,
    'Leve o Nitromirglicerônio para Gaxim Deuxabu nas Torres de Pedra.‡Отнесите нитромирглицероний Гаксиму Ржавошиппи в Каменный Коготь.‡Bringt Gaxim Rostknirsch im Steinkrallengebirge das Nitromirglyceronium.‡돌발톱산맥에 있는 각심 러스트피즐에게 니트로미르글리세로니움을 가져가야 합니다.‡Lleva el nitromirgliceronio de vuelta a Gaxim Silvóxido en Espolón.‡Lleva el nitromirgliceronio de vuelta a Gaxim Silvóxido en Espolón.‡Apportez le Nitromirglyceronium à Gaxim Larguerouille, dans les Serres-Rocheuses.‡将硝酸甘油炸药带回石爪山，交给加克希姆·尘链。‡將硝酸甘油炸藥帶回石爪山，交給加克希姆·塵鏈。',
  }
},
[1075] = {
  {
    'Um pergaminho de Mauren‡Свиток от Маурена‡Eine Rolle von Mauren‡마우렌의 두루마리‡Un pergamino de Mauren‡Un pergamino de Mauren‡Un parchemin de Collin Mauren‡玛伦的卷轴‡馬倫的卷軸',
    nil,
    'Encontre Collin Mauren em Ventobravo.‡Найдите в Штормграде Коллина Маурена.‡Sucht Collin Mauren in Sturmwind auf.‡스톰윈드에 있는 콜린 마우렌을 찾아야 합니다.‡Encuentra a Collin Mauren en Ventormenta.‡Encuentra a Collin Mauren en Ventormenta.‡Trouver Collin Mauren à Hurlevent.‡找到暴风城的科林·玛伦。‡找到暴風城的科林·馬倫。',
  }
},
[1076] = {
  {
    'Redemoinhos no Cerro Oeste‡Демоны в Западном Крае‡Teufel in Westfall‡서부 몰락지대의 악령‡Demonios en los Páramos de Poniente‡Demonios en los Páramos de Poniente‡Des diables dans la marche de l\'Ouest‡西部荒野中的恶魔‡西部荒野中的惡魔',
    nil,
    'Leve os Destroços do Redemoinho de Poeira para Álvaro Columba em Ventobravo.‡Принесите прах Пыледемона Коллину Маурену в Штормград.‡Bringt Collin Mauren in Sturmwind Staubteufeltrümmer.‡스톰윈드에 있는 콜린 마우렌에게 먼지 악령의 파편을 가져가야 합니다.‡Lleva restos de demonio del polvo a Collin Mauren en Ventormenta.‡Lleva restos de demonio de polvo a Collin Mauren en Ventormenta.‡Apporter des Débris de Diable de poussière à Collin Mauren à Hurlevent.‡将尘魔的残骸带回给暴风城的科林·玛林。‡將塵魔的殘骸帶回給暴風城的科林·瑪林。',
  }
},
[1077] = {
  {
    'Entrega especial para Gaxim‡Особая посылка для Гаксима‡Speziallieferung für Gaxim‡각심을 위한 특별한 선물‡Entrega especial para Gaxim‡Entrega especial para Gaxim‡Livraison spéciale pour Gaxim‡给加克希姆的特快专递‡給加克希姆的特快專遞',
    nil,
    'Leve o Pergaminho de Mensagem para Gaxim Deuxabu nas Torres de Pedra.‡Отнесите свиток с посланием Гаксиму Ржавошиппи в Каменный Коготь.‡Bringt Gaxim Rostknirsch im Steinkrallengebirge die Rolle der Nachrichtenübermittlung.‡돌발톱 산맥에 있는 각심 러스트피즐에게 교신의 두루마리를 가져가야 합니다.‡Lleva el Pergamino de mensajes de vuelta a Gaxim Silvóxido en Espolón.‡Lleva el Pergamino de mensajes de vuelta a Gaxim Silvóxido en Espolón.‡Apportez le Parchemin de contact à Gaxim Larguerouille dans les Serres-Rocheuses.‡将通讯卷轴交给石爪山的加克希姆·尘链。‡將通訊卷軸交給石爪山的加克希姆·塵鏈。',
  }
},
[1078] = {
  {
    'Coleta para Columba‡Поиск для Маурена‡Suche für Mauren‡마우렌 돕기‡Escamas cristalizadas para Mauren‡Escamas cristalizadas para Mauren‡Des retrouvailles pour Mauren‡完鳞归玛伦‡完鱗歸瑪倫',
    nil,
    'Leve 8 Escamas Cristalizadas para Álvaro Columba em Ventobravo.‡Принесите 8 кристаллических чешуй Коллину Маурену в Штормград.‡Bringt Collin Mauren in Sturmwind 8 kristallisierte Schuppen.‡스톰윈드에 있는 콜린 마우렌에게 비늘 결정체 8개를 가져가야 합니다.‡Lleva 8 escamas cristalizadas a Collin Mauren en Ventormenta.‡Lleva 8 escamas cristalizadas a Collin Mauren en Ventormenta.‡Apporter 8 Ecailles de cristal à Collin Mauren à Hurlevent.‡给暴风城的科林·玛伦带回8片水晶鳞片。‡給暴風城的科林·瑪倫帶回8片晶化鱗片。',
  }
},
[1079] = {
  {
    'Operações secretas – Alfa‡Секретная операция – Альфа‡Geheimoperation Alpha‡비밀 작전 - 1단계‡Operaciones secretas: plan A‡Operaciones secretas: plan A‡Opérations secrètes - Plan A‡隐秘行动：A‡隱秘行動:A',
    nil,
    'Consiga os Planos de Engenharia da Empreendimentos S.A. na serraria, no Rochedo Cortavento.‡Добудьте технические чертежи Торговой Компании с лесопилки на Утесе Ветрорезов.‡Holt die Ingenieurspläne der Venture Company aus dem Sägewerk auf der Scherwindklippe.‡칼바람 바위산에 있는 제재소에서 투자개발회사의 토목 공사 계획서를 찾아 와야 합니다.‡Recupera los planos de ingeniería de Ventura y Cía. de la serrería en el Risco Cortaviento.‡Recupera los planos de ingeniería de Ventura y Cía. de la serrería en el Risco Cortaviento.‡Récupérer les Plans d\'ingénierie de la KapitalRisk dans la scierie de la Combe des Cisailles.‡将风险投资公司工程计划书从峭壁湖的伐木场中偷出来。‡將風險投資公司工程計畫書從狂風峭壁的伐木場中偷出來。',
  }
},
[1080] = {
  {
    'Operações secretas - Beta‡Секретная операция – Бета‡Geheimoperation Beta‡비밀 작전 - 2단계‡Operaciones secretas: plan B‡Operaciones secretas: plan B‡Opérations secrètes - Plan B‡隐秘行动：B‡隱秘行動:B',
    nil,
    'Consiga as Cartas da Empreendimentos S.A. na Mina Cortavento, que fica no extremo leste do Rochedo Cortavento.‡Добудьте документы Торговой Компании из Рудника Ветрорезов у восточного края Утеса Ветрорезов.‡Holt die Dokumente der Venture Company aus der Scherwindmine am Ostende der Scherwindklippe.‡칼바람 바위산의 동쪽 끝에 있는 칼바람 광산에서 투자개발회사의 편지를 찾아와야 합니다.‡Recupera las cartas de Ventura y Cía. de la Mina Cortaviento, en el extremo este del Risco Cortaviento.‡Recupera las cartas de Ventura y Cía. de la Mina Cortaviento, en el extremo este del Risco Cortaviento.‡Récupérer les Notes de la KapitalRisk dans la mine des Cisailles à l\'extrémité est de la Combe des Cisailles.‡将风险投资公司函件从峭壁湖最东面的风剪矿洞中偷出来。‡將風險投資公司函件從狂風峭壁最東面的狂風礦坑中偷出來。',
  }
},
[1081] = {
  {
    'A recepção de Tyrande‡Приглашение от Тиранды‡Tyrandes Empfang‡티란데의 환대‡El recibimiento de Tyrande‡El recibimiento de Tyrande‡Réception par Tyrande‡泰兰德的接待‡泰蘭妲的接待',
    nil,
    'Encontre Tyrande Murmuréolo em Darnassus.‡Найдите в Дарнасе Тиранду Шелест Ветра.‡Sucht Tyrande Wisperwind in Darnassus auf.‡다르나서스에서 티란데 위스퍼윈드를 찾아야 합니다.‡Encuentra a Tyrande Susurravientos en Darnassus.‡Encuentra a Tyrande Susurravientos en Darnassus.‡Trouver Tyrande Murmevent à Darnassus.‡到达纳苏斯去找到泰兰德·语风。‡到達納蘇斯去找到泰蘭妲·語風。',
  }
},
[1082] = {
  {
    'Deixando a Sentinela Tenysil a par de tudo‡Новости для часового Тенисил‡Neuigkeiten für Schildwache Thenysil‡파수꾼 테니실‡Noticias para Centinela Thenysil‡Noticias para Centinela Thenysil‡Une mise à jour pour la Sentinelle Thenysil‡向塞恩希尔报告‡向塞恩希爾報告',
    nil,
    'Fale novamente com a Sentinela Tenysil no Vale Gris.‡Вернитесь к часовому Тенисил в Ясеневый лес.‡Kehrt zu Schildwache Thenysil im Eschental zurück.‡잿빛 골짜기에 있는 파수꾼 테니실에게 돌아가야 합니다.‡Ve a ver a la centinela Thenysil en Vallefresno.‡Ve a ver a la centinela Thenysil en Vallefresno.‡Retourner voir la Sentinelle Tara Thenysil en Orneval.‡向灰谷的哨兵塞恩希尔复命。‡向梣谷的哨兵塞恩希爾覆命。',
  }
},
[1083] = {
  {
    'Espíritos enfurecidos‡Разъяренные духи‡Wütende Geister‡분노한 정령들‡Los espíritus iracundos‡Los espíritus iracundos‡Esprits enragés‡怒灵‡怒靈',
    nil,
    'Leve 8 Brasas Fumegantes de quaisquer elementais do fogo do Vale Carbonizado a Kaela Umbralança nas Torres de Pedra.‡Принесите 8 тлеющих углей от любых элементалей огня из Обугленной долины Келе Копье Тени в Когтистые горы.‡Bringt Kaela Schattenspeer im Steinkrallengebirge 8 glimmende Überreste der Feuerelementare des verbrannten Tals.‡돌발톱 산맥에 있는 캘라 섀도스피어에게 잿더미 계곡에 있는 불의 정령들로부터 얻은 꺼져 가는 불씨 8개를 가져가야 합니다.‡Lleva 8 ascuas humeantes de cualquiera de los elementales de fuego de la Vega Carbonizada a Kaela Lanzasombra, en Espolón.‡Lleva 8 ascuas ardientes de cualquiera de los elementales de fuego de la Vega Carbonizada a Kaela Lanzasombra, en Espolón.‡Apporter 8 Braises fumantes provenant de n\'importe quel élémentaire de feu du Val calciné à Kaela Ombrelance, dans les Serres-Rocheuses.‡从焦炭谷中的任意火元素身上收集8个闷烧余烬，把它们交给石爪山的凯拉·影矛。‡從焦炭谷中的任意火元素身上收集8個悶燒餘燼，把它們交給石爪山的凱拉·影矛。',
  }
},
[1084] = {
  {
    'Ancientes feridos‡Раны Дерев‡Verletzte Urtume‡상처 입은 고대정령‡Los antárboles corruptos‡Los antárboles corruptos‡Les Anciens blessés‡受伤的古树‡受傷的古樹',
    nil,
    'Leve alguns Estilhaços Corroídos para Kaela Umbralança nas Torres de Pedra.‡Принесите образец ржавой шрапнели Келе Копье Тени в Каменный Коготь.‡Bringt Kaela Schattenspeer im Steinkrallengebirge ein Stück zerfressenes Schrapnell.‡돌발톱 산맥에 있는 캘라 섀도스피어에게 부식된 파편 1개를 가져가야 합니다.‡Lleva una pieza de metralla corroída a Kaela Lanzasombra en Espolón.‡Lleva una pieza de metralla corroída a Kaela Lanzasombra en Espolón.‡Apporter un morceau de Shrapnel corrodé à Kaela Ombrelance, dans les Serres-Rocheuses.‡给石爪山的凯拉·影矛带回一块被腐蚀的弹片。‡給石爪山的凱拉·影矛帶回一塊被腐蝕的彈片。',
  }
},
[1085] = {
  {
    'Em guarda nas Torres de Pedra‡На страже в Когтистых горах‡Wache halten im Steinkrallengebirge‡돌발톱 산맥에서의 임무‡Estar de guardia en Espolón‡Estar de guardia en Espolón‡De garde dans les Serres-Rocheuses‡守卫石爪山‡守衛石爪山',
    nil,
    'Fale com Gaxim na Cordilheira das Torres de Pedra.‡Поговорите с Гаксимом в Когтистых горах.‡Sprecht mit Gaxim im Steinkrallengebirge.‡돌발톱 산맥에 있는 각심과 대화해야 합니다.‡Habla con Gaxim en Sierra Espolón.‡Habla con Gaxim en Sierra Espolón.‡Parler à Gaxim dans les Serres-Rocheuses.‡与石爪山脉的加克希姆谈一谈。‡到石爪山脈找加克希姆談話。',
  }
},
[1086] = {
  {
    'Aeroporto de máquinas voadoras‡Аэропорт ветролетов‡Der Flugapparathafen‡비행장‡El aeropuerto‡El aeropuerto de máquinas voladoras‡L\'aéroport de la machine volante‡地精空港‡飛行器機場',
    nil,
    'Leve o Vaporizador Tóxico até o aeródromo da Empreendimentos S.A. e depois fale com a Boticária Zaqueia.‡Отнесите распылитель ядовитого тумана в аэропорт Торговой Компании и вернуться к аптекарю Заме.‡Bringt den Toxinvernebler zum Flugplatz der Venture Company und kehrt dann zu Apothekerin Zamah zurück.‡투자개발회사의 비행장에 독가스통을 갖다 놓고 연금술사 자마에게 돌아와야 합니다.‡Lleva la niebla tóxica al aeropuerto de Ventura y Cía. e informa a la boticaria Zamah.‡Lleva el nublador tóxico al aeropuerto de Ventura y Cía. e informa a la boticaria Zamah.‡Apportez le Brouillard toxique à l\'aéroport de la KapitalRisk, puis retourner voir l\'Apothicaire Zamah.‡把剧毒粮草带到风险投资公司的空港去，然后向药剂师扎玛复命。‡把劇毒糧草帶到風險投資公司的機場去，然後向藥劑師札瑪覆命。',
  }
},
[1087] = {
  {
    'O legado de Cenarius‡Наследие Кенария‡Cenarius\' Vermächtnis‡세나리우스의 유산‡El legado de Cenarius‡El legado de Cenarius‡L\'héritage de Cénarius‡塞纳留斯的遗产‡塞納留斯的遺產',
    nil,
    'Mate 4 Filhos de Cenarius, 4 Filhas de Cenarius e 4 Botânicos Cenarianos para Braelyn Manígnea, no Retiro Rocha do Sol.‡Убейте 4 сыновей Кенария, 4 дочерей Кенария и 4 кенарийских ботаников по поручению Брайлин Огненной Длани из Приюта у Солнечного Камня.‡Tötet für Braelyn Feuerhand in Sonnenfels 4 Söhne des Cenarius, 4 Töchter des Cenarius und 4 cenarische Botaniker.‡해바위 야영지 근처에 있는 브랠린 파이어핸드를 위해 세나리우스의 후예, 세나리우스의 딸, 세나리온 식물학자들을 각각 4명씩 처치해야 합니다.‡Mata 4 Hijos de Cenarius, 4 Hijas de Cenarius y 4 botánicos Cenarion para Braelyn Manofuego, cerca del Refugio Roca del Sol.‡Mata a 4 Hijos de Cenarius, 4 Hijas de Cenarius y 4 botánicas Cenarion para Braelyn Manofuego, cerca del Refugio Roca del Sol.‡Tuer 4 Fils de Cénarius, 4 Filles de Cénarius et 4 Botanistes cénariens pour Braelyn Brasemain, près de la Retraite de Roche-Soleil.‡为石爪峰附近的布莱林·火拳杀死4名塞纳留斯的儿子，4名塞纳留斯的女儿以及4名塞纳里奥植物学家。‡為石爪峰附近的布萊林·火拳殺死4名塞納留斯的兒子，4名塞納留斯的女兒以及4名塞納里奧植物學家。',
  }
},
[1088] = {
  {
    'Ornanos‡Ордан‡Ordanus‡오르다누스‡Ordanus‡Ordanus‡Ordanus‡奥达努斯‡奧達努斯',
    nil,
    'Leve a Cabeça de Ornanos a Braelyn Manígnea no Retiro Rocha do Sol.‡Принесите голову Ордана Брайлин Огненной Длани к Приюту у Солнечного Камня.‡Bringt Braelyn Feuerhand in der Nähe von Sonnenfels Ordanus\' Kopf.‡오르다누스를 처치하고 그 증거로 그의 머리 장식을 해바위 야영지 근처에 있는 브랠린 파이어핸드에게 가져가야 합니다.‡Lleva la cabeza de Ordanus a Braelyn Manofuego cerca del Refugio Roca del Sol.‡Lleva la cabeza de Ordanus a Braelyn Manofuego cerca del Refugio Roca del Sol.‡Apporter la Tête d\'Ordanus à Braelyn Brasemain, près de la Retraite de Roche-Soleil.‡将奥达努斯的徽记带给石爪峰的布莱林·火拳。‡將奧達努斯的頭顱帶給石爪峰的布萊林·火拳。',
  }
},
[1089] = {
  {
    'O Retiro‡Логово‡Der Bau‡갈퀴발톱굴‡El Cubil‡El Cubil‡L\'Antre‡大兽穴‡大獸穴',
    nil,
    'Vá ao Retiro da Garra no Morro das Torres de Pedra. Usando a Chave do Guardião do Portal, obtenha os itens escondidos pelos druidas. Use esses itens para abrir o Tesouro do Retiro da Garra.‡Отправляйтесь к пещере на Пике Каменного Когтя. При помощи Ключа Хранителя Врат добудьте предметы, спрятанные друидами. Используйте эти предметы для того, чтобы открыть сокровищницу Логова Когтя.‡Begebt Euch zum Bau auf den Steinkrallengipfel. Benutzt den Torwächterschlüssel, um Euch die versteckten Gegenstände der Druiden zu besorgen. Benutzt diese Gegenstände, um den Hort des Krallenbaus zu öffnen.‡돌발톱 봉우리에 있는 갈퀴발톱굴로 가야 합니다. 문지기의 열쇠를 이용해 드루이드의 숨겨진 물건을 얻어야 합니다. 그 물건을 이용해 갈퀴발톱굴 저장고를 여십시오.‡Ve a El Cubil, en la Cima del Espolón. Utiliza la Llave del Guardián y consigue los objetos ocultos del druida. Utiliza esos objetos para abrir el tesoro de El Cubil del Espolón.‡Ve a El Cubil, en la Cima del Espolón. Utiliza la llave del Guardián y consigue los objetos ocultos del druida. Utiliza esos objetos para abrir el tesoro de El Cubil del Espolón.‡Aller dans l\'Antre, sur le Pic des Serres-Rocheuses. En utilisant la Clé du gardien, obtenir les objets cachés des druides. Utiliser ces objets pour ouvrir le Trésor de l\'Antre des Serres.‡到石爪峰上的洞穴中去，使用守门人的钥匙拿到能打开石爪峰顶的猛禽洞穴储藏室的物品。‡到石爪峰上的洞穴中去，使用守門人的鑰匙，取得德魯伊藏匿的物品。用這些物品打開石爪峰洞穴儲藏室。',
  }
},
[1090] = {
  {
    'Ordens de Hanfritz‡Приказы Геренцо‡Gerenzos Befehle‡게렌조의 지시‡Órdenes de Gerenzo‡Órdenes de Gerenzo‡Les ordres de Gerenzo‡格雷苏的要求‡格雷蘇的要求',
    nil,
    'Pegue o minério misterioso com Piznik depois que ele terminar de minerá-lo.‡Возьмите образец загадочной руды у Пузника после того, как он ее добудет.‡Nehmt das rätselhafte Erz, nachdem Piznik es fertig abgebaut hat.‡피즈닉이 미확인 광석을 캐내면 그 광석을 받아야 합니다.‡Consigue el misterioso mineral de Piznik cuando termine de extraerlo.‡Consigue el misterioso mineral de Piznik cuando termine de extraerlo.‡Obtenir le minerai mystérieux de Piznik après qu\'il l\'aura extrait.‡在匹兹尼克完成开采之后拿到神秘矿石。‡在匹茲尼克完成開採之後拿到神秘礦石。',
  }
},
[1091] = {
  {
    'Deixando Kaela a par de tudo‡Новости для Каэлы‡Kaelas Update‡캘라를 위한 새로운 정보‡Noticias para Kaela‡Noticias para Kaela‡Des nouvelles pour Kaela‡向凯拉回报‡向凱拉回報',
    nil,
    'Leve as Cartas da Empreendimentos S.A. a Kaela Umbralança na Cordilheira das Torres de Pedra.‡Отнесите документы Торговой Компании Келе Копье Тени в Когтистые горы.‡Bringt Kaela Schattenspeer im Steinkrallengebirge die Dokumente der Venture Company.‡돌발톱 산맥에 있는 캘라 섀도스피어에게 투자개발회사의 편지를 가져가야 합니다.‡Lleva las cartas de Ventura y Cía. a Kaela Lanzasombra a Sierra Espolón.‡Lleva las cartas de Ventura y Cía. a Kaela Lanzasombra a Sierra Espolón.‡Apportez les Notes de la KapitalRisk à Kaela Ombrelance aux Serres-Rocheuses.‡将风险投资公司函件带给石爪山脉的凯拉·影矛。‡到石爪山脈，把風險投資公司函件帶給凱拉·影矛。',
  }
},
[1092] = {
  {
    'Ordens de Hanfritz‡Приказы Геренцо‡Gerenzos Befehle‡게렌조의 지시‡Órdenes de Gerenzo‡Órdenes de Gerenzo‡Les ordres de Gerenzo‡格雷苏的要求‡格雷蘇的要求',
    nil,
    'Entregue o Minério Não Identificado a Zé Fízzica na Cordilheira das Torres de Pedra.‡Доставьте Неопознанную Руду Зизу Физзиксу в Когтистые горы.‡Bringt Ziz Fizziks im Steinkrallengebirge das unbekannte Erz.‡돌발톱 산맥에 있는 지즈 피직스에게 미확인 광석을 가져가야 합니다.‡Lleva la mena sin identificar a Ziz Fizziks en Sierra Espolón.‡Lleva la mena sin identificar a Ziz Fizziks, en Sierra Espolón.‡Remettre le Minerai non identifié à Ziz Fizzik dans les Serres-Rocheuses.‡将未经化验的矿石送到石爪山的菲兹克斯那里。‡將未經化驗的礦石送到石爪山的菲茲克斯那裡。',
  }
},
[1093] = {
  {
    'Super Ceifador 6000‡Супер-дровосек 6000‡Superschnitter 6000‡슈퍼 절단기 6000‡Súper Segadora 6000‡Súper Segadora 6000‡Super-Découpeur 6000‡超级收割机6000‡超級收割機6000',
    nil,
    'Consiga os Diagramas do Super Ceifador 6000 e entregue-os a Zé Fízzica na Cordilheira das Torres de Pedra.‡Добудьте чертежи "Супер-дровосека 6000" для Зиза Физзикса с Когтистых гор.‡Besorgt für Ziz Fizziks im Steinkrallengebirge die Superschnitter-6000-Blaupause.‡돌발톱 산맥에 있는 지즈 피직스를 위해 슈퍼 절단기 6000 설계도를 입수해야 합니다.‡Consigue los planos de la Súper Segadora 6000 para Ziz Fizziks de Sierra Espolón.‡Consigue los planos de la Súper Segadora 6000 para Ziz Fizziks en Sierra Espolón.‡Trouver le Plan du Super-Découpeur 6000 pour Ziz Fizzik dans les Serres-Rocheuses.‡为石爪山的菲兹克斯偷来超级收割机6000型的设计图。‡為石爪山的菲茲克斯偷來超級收割機6000型的設計圖。',
  }
},
[1094] = {
  {
    'Instruções adicionais‡Дальнейшие указания‡Weitere Instruktionen‡또 다른 지시 사항‡Más instrucciones‡Más instrucciones‡D\'autres instructions‡新的指示‡新的指示',
    nil,
    'Entregue o Envelope Selado a Cobogó na Vila Catraca, que fica nos Sertões.‡Доставьте запечатанный конверт Пароклапану в Кабестан, что в Степях.‡Bringt Stotterspritter in Ratschet im Brachland den versiegelten Umschlag.‡불모의 땅의 톱니항에 있는 스퍼터밸브에게 봉인된 편지를 전달해야 합니다.‡Lleva el sobre lacrado a Petardol a Trinquete, en Los Baldíos.‡Lleva el sobre lacrado a Petardol a Trinquete, en Los Baldíos.‡Remettre l\'Enveloppe scellée à Krachevalve à Cabestan, dans les Tarides.‡将密封的信封交给贫瘠之地棘齿城的斯布特瓦夫。‡到貧瘠之地的棘齒城，將密封的信封交給斯布特瓦夫。',
  }
},
[1095] = {
  {
    'Instruções adicionais‡Дальнейшие указания‡Weitere Instruktionen‡추가 지령‡Más instrucciones‡Nuevas instrucciones‡D\'autres instructions‡新的指示‡新的指示',
    nil,
    'Leve as novas ordens a Zé Fízzica na Cordilheira das Torres de Pedra.‡Отнесите Зизу Физзиксу в Когтистых горах новые приказы.‡Bringt Ziz Fizziks im Steinkrallengebirge die neuen Befehle.‡돌발톱 산맥에 있는 지즈 피직스에게 새로운 명령을 전해야 합니다.‡Lleva las nuevas órdenes a Ziz Fizziks en Sierra Espolón.‡Lleva las nuevas órdenes a Ziz Fizziks en Sierra Espolón.‡Apportez les nouveaux ordres à Ziz Fizzik dans les Serres-Rocheuses.‡把新的指令带给石爪山的菲兹克斯。‡把新的指令帶給石爪山的菲茲克斯。',
  }
},
[1096] = {
  {
    'Hanfritz Schaventorck‡Геренцо Терминатрикс‡Gerenzo Pfeifzang‡게렌조 렌치휘슬‡Gerenzo Silbillave‡Gerenzo Silbillave‡Gerenzo Siffleclef‡格雷苏‡格雷蘇',
    nil,
    'Leve o Braço Mecânico do Hanfritz a Zé Fízzica na Cordilheira das Torres de Pedra.‡Принесите механическую руку Геренцо Терминатрикса Зиззу Физзиксу в Когтистые горы.‡Bringt Ziz Fizziks im Steinkrallengebirge Gerenzo Pfeifzangs mechanischen Arm.‡돌발톱 산맥에 있는 지즈 피직스에게 게렌조의 기계팔을 가져가야 합니다.‡Lleva el brazo mecánico de Gerenzo Silbillave a Ziz Fizziks en Sierra Espolón.‡Lleva el brazo mecánico de Gerenzo Silbillave a Ziz Fizziks, en Sierra Espolón.‡Apporter le Bras mécanique de Gerenzo Siffleclef à Ziz Fizzik dans les Serres-Rocheuses.‡将格雷苏的机械臂带给石爪山脉的菲兹克斯。‡將格雷蘇的機械臂帶給石爪山脈的菲茲克斯。',
  }
},
[1097] = {
  {
    'Tarefa de Elmore‡Просьба Элмора‡Elmores Aufgabe‡엘모어의 임무‡La tarea de Elmore‡La tarea de Elmore‡La quête d\'Elmore‡艾尔默的任务‡艾爾默的任務',
    nil,
    'Fale com Grimand Elmore em Ventobravo.‡Поговорите с Гримандом Элмором в Штормграде.‡Sprecht mit Grimand Elmore in Sturmwind.‡스톰윈드에 있는 그리만트 엘모어와 대화해야 합니다.‡Habla con Grimand Elmore en Ventormenta.‡Habla con Grimand Elmore en Ventormenta.‡Parler à Grimand Elmore à Hurlevent.‡与暴风城的格瑞曼德·艾尔默谈一谈。‡到暴風城與格瑞曼德·艾爾默交談。',
  }
},
[1098] = {
  {
    'Sicários na Presa Negra‡Пропавшие стражи смерти‡Todespirscher in Burg Schattenfang‡그림자송곳니 성채의 죽음의추적자‡Mortacechadores en Colmillo Oscuro‡Mortacechadores en Colmillo Oscuro‡Des nécrotraqueurs à Ombrecroc‡影牙城堡里的亡灵哨兵‡影牙城堡裡的亡靈哨兵',
    nil,
    'Encontre o Sicário Admeto e o Sicário Vicente.‡Найдите стражей смерти Адаманта и Винсента.‡Sucht die Todespirscher Adamant und Vincent.‡죽음의추적자 아다만트와 죽음의추적자 빈센트를 찾아야 합니다.‡Encuentra a los mortacechadores Adamant y Vincent.‡Encuentra a los mortacechadores Adamant y Vincent.‡Trouver les Nécrotraqueurs Adamant et Vincent.‡找到亡灵哨兵阿达曼特和亡灵哨兵文森特。‡找尋亡靈哨兵阿達曼和亡靈哨兵文森。',
  }
},
[1099] = {
  {
    'Vitória dos goblins!‡Гоблины победили!‡Die Goblins haben gewonnen!‡고블린 승리!‡¡Los goblins ganan!‡¡Los goblins ganan!‡Les gobelins gagnent !‡地精获胜！‡哥布林獲勝!',
    nil,
    nil,
  }
},
[1100] = {
  {
    'Diário do Monocelha‡Дневник Хмурня‡Einbraues Tagebuch‡론브로우의 일지‡El diario de Soliceja‡El diario de Soliceja‡Journal de Lonebrow‡亨里格的日记‡亨里格的日記',
    nil,
    'Leia o Diário de Henrig Monocelha.‡Прочитайте дневник Хенрига Хмурня.‡Lest Henrig Einbraues Tagebuch.‡헨리그 론브로우의 일지를 읽어야 합니다.‡Lee el diario de Henrig Soliceja.‡Lee el diario de Henrig Soliceja.‡Lire le Journal d\'Henrig Lonebrow.‡阅读亨里格·独眉的日记。‡閱讀亨里格·獨眉的日記。',
  }
},
[1101] = {
  {
    'A bruxa má do Urzal‡Хозяйка Лабиринтов‡Die Greisin des Krals‡가시덩굴 우리의 대모‡La bruja del Horado‡La bruja del Horado‡La mégère du Kraal‡卡尔加·刺肋‡剃刀沼澤的乾癟老太婆',
    nil,
    'Leve o Medalhão da Talhaflanco para Falfindel Trilhemas em Thalanaar.‡Принесите медальон Чарлги Остробок Фалфиндеру Хранителю Путей в Таланааре.‡Bringt Falfindel Wegeshut in Thalanaar Klingenflankes Medaillon.‡탈라나르에 있는 팔핀델 웨이워더에게 차를가의 메달을 가져가야 합니다.‡Llévale el medallón de Filonavaja a Díscolo Falfindel de Thalanaar.‡Llévale el medallón de Filonavaja a Díscolo Falfindel de Thalanaar.‡Apporter le Médaillon de Trancheflanc à Falfindel Gardevoie à Thalanaar.‡把卡尔加·刺肋的徽章交给萨兰纳尔的法芬德尔。‡把卡爾加·刺肋的大勳章帶給薩蘭納爾的法芬德爾。',
  }
},
[1102] = {
  {
    'Um destino vingativo‡Отмщение грядет!‡Ein schreckliches Schicksal‡운명의 복수‡Un destino vengador‡Un destino vengador‡Un destin funeste‡奥尔德的报复‡奧爾德的報復',
    nil,
    'Leve o Coração da Talhaflanco para Auld Agulha de Pedra no Penhasco do Trovão.‡Принесите сердце Чарлги Остробок Ольду Каменному Копью в Громовой Утес.‡Bringt Auld Steinkeil in Donnerfels Klingenflankes Herz.‡썬더 블러프에 있는 아울드 스톤스파이어에게 차를가의 심장을 가져가야 합니다.‡Llévale el corazón de Filonavaja a Auld Picopiedra, que está en Cima del Trueno.‡Llévale el corazón de Filonavaja a Auld Picopiedra, que está en Cima del Trueno.‡Apporter le Cœur de Trancheflanc à Cime-de-pierre le Vieil, aux Pitons du Tonnerre.‡把卡尔加·刺肋的精华交给雷霆崖的奥尔德·石塔。‡把卡爾加·刺肋的心臟交給雷霆崖的奧爾德·石塔。',
  }
},
[1103] = {
  {
    'O clamor da Água‡Зов воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve uma Sapta da Água para Tiev Borduno na Floresta de Pinhaprata se não tiver conseguido falar com a Manifestação Menor da Água.‡Принесите Тьеву Мордуну, который находится в Серебряном бору, сапту воды, если вам не удалось поговорить с низшим воплощением воды.‡Bringt Tiev Mordune im Silberwald ein Wassersapta, wenn Ihr nicht mit der schwachen Wassermanifestation gesprochen habt.‡하급 물의 현신과 대화하지 못했으면 은빛소나무 숲에 있는 티에브 모르둔에게 물의 정기를 가져다주어야 합니다.‡Llévale una sapta de agua a Tiev Mordune en el Bosque de Argénteos si no consigues hablar con la manifestación de agua menor.‡Llévale una sapta de agua a Tiev Mordune en el Bosque de Argénteos si no consigues hablar con la manifestación de agua menor.‡Apporter un sapta d\'eau à Tiev Mordune dans la forêt des Pins argentés, si vous n\'arrivez pas à parler à la Manifestation d\'eau mineure.‡如果你没能与水之魂交谈，就给银松森林的提夫·摩杜恩再拿去一瓶水之灵契。‡如果你沒能與水之靈體交談，就給銀松森林的提夫·摩杜恩再拿去一瓶水之靈契。',
  }
},
[1104] = {
  {
    'Peçonha do salar‡Яд Соляных равнин‡Salziges Gift‡소금기 있는 전갈 독‡Veneno de escórpidos salados‡Veneno de El Desierto de Sal‡Le venin acide des salines‡含盐的蝎毒‡含鹽的蠍毒',
    nil,
    'Leve 6 Peçonhas Salgadas de Escorpídeo para Xabu Latafuso no Salar Cintilante.‡Принесите 6 порций соленого яда скорпида Пшиксу Медноштифу на Мерцающую равнину.‡Bringt Fizzel Kupferbolz in der schimmernden Ebene 6 Einheiten salziges Skorpidgift.‡소금 평원에 있는 피즐 브라스볼츠에게 소금기 있는 전갈 독 6개를 가져가야 합니다.‡Llévale 6 glándulas de veneno de escórpidos salados a Fizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 6 glándulas de veneno de escórpidos salados a Fizzle Pernolatón, que está en El Desierto de Sal.‡Apportez 6 doses de Venin de scorpide acide à Féplouf Zéboulon, dans les Salines.‡为闪光平原的菲兹尔·铜栓带去6份含盐的蝎毒。‡為閃光平原的菲茲爾·銅栓帶去6份含鹽的蠍毒。',
  }
},
[1105] = {
  {
    'Cascos endurecidos‡Крепкие панцири‡Gehärtete Schalen‡단단한 등껍질‡Caparazones endurecidos‡Caparazones endurecidos‡Les carapaces durcies‡硬化龟壳‡硬化龜殼',
    nil,
    'Leve 9 Cascos Endurecidos de Tartaruga para Capu Latafuso no Salar Cintilante.‡Принесите 9 крепких черепашьих панцирей Виззлу Медноштифу на Мерцающую равнину.‡Bringt Wizzel Kupferbolz in der schimmernden Ebene 9 gehärtete Schildkrötenpanzer.‡소금 평원에 있는 위즐 브라스볼츠에게 단단한 거북 등껍질 9개를 가져가야 합니다.‡Llévale 9 caparazones de tortuga endurecidos a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 9 caparazones de tortuga endurecidos a Wizzle Pernolatón, que está en El Desierto de Sal.‡Apporter 9 Carapaces de tortue durcies à Lachnouf Zéboulon dans les Salines.‡收集9块硬化龟壳，把它们交给闪光平原的维兹尔·铜栓。‡收集9塊硬化龜殼，把它們交給閃光平原的維茲爾·銅栓。',
  }
},
[1106] = {
  {
    'Martek, o Exilado‡Мартек Изгой‡Martek der Verbannte‡망명자 마르텍‡Martek el Exiliado‡Martek el Exiliado‡Martek l\'Exilé‡流放者马特克‡『流放者』馬特克',
    nil,
    'Entregue a carta do Xabu para Martek, o Exilado, nos Ermos.‡Отнесите письмо Пшикса Мартеку Изгою в Бесплодные земли.‡Bringt Martek dem Verbannten im Ödland Fizzel Kupferbolz\' Brief.‡황야의 땅에 있는 망명자 마르텍에게 피즐의 편지를 가져가야 합니다.‡Llévale la carta de Fizzle Pernolatón a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Llévale la carta de Fizzle Pernolatón a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Apporter la Lettre de Féplouf à Martek l\'Exilé dans les Terres ingrates.‡把菲兹尔·铜栓的信带给荒芜之地的流放者马特克。‡把菲茲爾·銅栓的信帶給荒蕪之地的『流放者』馬特克。',
  }
},
[1107] = {
  {
    'Barbatanas de cauda incrustada‡Средство против трения‡Verkrustete Schwanzflossen‡딱딱한 꼬리지느러미‡Aletas dorsales taraceadas‡Aletas dorsales taraceadas‡Les nageoires incrustées‡坚硬的尾鳍‡堅硬的尾鰭',
    nil,
    'Leve 10 Barbatanas de Cauda Incrustada para Capu Latafuso no Salar Cintilante.‡Принесите 10 соленых хвостовых плавников Виззлу Медноштифту на Мерцающую равнину.‡Bringt Wizzel Kupferbolz in der schimmernden Ebene 10 verkrustete Schwanzflossen.‡소금 평원에 있는 위즐 브라스볼츠에게 딱딱한 꼬리지느러미 10개를 가져가야 합니다.‡Llévale 10 aletas dorsales taraceadas a Wizzle Pernolatón, que está en El Desierto de Sal.‡Llévale 10 aletas dorsales taraceadas a Wizzle Pernolatón, que está en El Desierto de Sal.‡Apporter 10 Nageoires incrustées à Lachnouf Zéboulon dans les Salines.‡给闪光平原上的瑞兹尔·铜栓带去10片坚硬的尾鳍。‡給閃光平原上的瑞茲爾·銅栓帶去10片堅硬的尾鰭。',
  }
},
[1108] = {
  {
    'Indúrio‡Индарилий‡Indurium‡인듀리움 광석‡Indurio‡Indurio‡Indurium‡精铁碎片‡精鐵碎片',
    nil,
    'Leve 10 Lâminas de Indúrio para Martek, o Exilado, nos Ermos.‡Принесите 10 пластин индарилия Мартеку Изгою в Бесплодные земли.‡Bringt Martek dem Verbannten im Ödland 10 Induriumspäne.‡황야의 땅에 있는 망명자 마르텍에게 인듀리움 조각 10개를 가져가야 합니다.‡Llévale 10 láminas de indurio a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Llévale 10 láminas de indurio a Martek el Exiliado, que está en las Tierras Inhóspitas.‡Apporter 10 Paillettes d\'indurium à Martek l\'Exilé dans les Terres ingrates.‡收集10块精铁碎片，把它们交给荒芜之地的流放者马特克。‡收集10塊精鐵碎片，把它們交給荒蕪之地的『流放者』馬特克。',
  }
},
[1109] = {
  {
    'Matéria orguânica‡Груды гуано‡Go, Go, Guano!‡조분석을 나에게!‡Guano del Horado‡Guano del Horado‡Corvée de guano‡蝙蝠的粪便‡蝙蝠的糞便',
    nil,
    'Leve 1 porção de Guano de Morcego para o Mestre-boticário Faranello na Cidade Baixa.‡Принесите 1 кучку гуано летучей мыши Лабиринтов мастеру-аптекарю Фаранеллу в Подгород.‡Bringt dem Apothekermeister Faranell in Unterstadt 1 Häufchen Kralguano.‡언더시티에 있는 수석 연금술사 파라넬에게 가시덩굴 조분석을 가져가야 합니다.‡Llévale una pila de guano del Horado al maestro boticario Faranell de Entrañas.‡Llévale una pila de guano del Horado al maestro boticario Faranell en Entrañas.‡Apporter 1 tas de Guano du kraal au maître apothicaire Faranell à Fossoyeuse.‡帮幽暗城的大药剂师法拉尼尔带回一堆沼泽蝙蝠的粪便。‡幫幽暗城的藥劑大師法拉尼爾帶回一堆沼澤蝙蝠的糞便。',
  }
},
[1110] = {
  {
    'Peças de carro-foguete‡Обломки болидов‡Raketenwagenteile‡로켓 자동차 부품‡Las partes de coche cohete‡Las piezas de coche cohete‡Pièces de chariot explosif‡火箭车零件‡火箭車零件',
    nil,
    'Leve 30 Peças de Carro-foguete para Kravel Barbakarvão no Salar Cintilante.‡Принестие 30 деталей болида Кравелу Углебороду на Мерцающую равнину.‡Bringt 30 Raketenwagenteile zu Kravel Kohlebart in der schimmernden Ebene.‡소금 평원의 크레이블 콜비어드에게 로켓 자동차 부품 30개를 가져가야 합니다.‡Llévale 30 partes de coche cohete a Kravel Karbarbán, que está en El Desierto de Sal.‡Llévale 30 piezas de coche cohete a Kravel Karbarbán, que está en El Desierto de Sal.‡Apporter 30 Pièces de Chariot explosif à Kravel Koalbarbe des Salines.‡收集30个火箭车零件，把它们交给闪光平原的克拉维尔·浓须。‡收集30個火箭車零件，把它們交給閃光平原的克拉維爾·濃須。',
  }
},
[1111] = {
  {
    'Mestre Portuário Caruncho‡Управляющий пристанью Головокружилкинс‡Werftmeister Flunkerblick‡부두주임 디지위그‡Maestro de muelles Vertipeluca‡Maestro de muelles Vertipeluca‡Maître des quais Tournoupette‡码头管理员迪兹维格‡碼頭管理員迪茲維格',
    nil,
    'Bring Kravel\'s Parts Order to Wharfmaster Dizzywig at Ratchet in the Barrens.‡Отнесите заказ на детали Крейвела управляющему пристанью Головокружилкинcу в Кабестан, что в Степях.‡Bringt Kravels Teilebestellung zu Werftmeister Flunkerblick nach Ratschet im Brachland.‡불모의 땅의 톱니항에 있는 부두주임 디지위그에게 크레이블의 부품주문서를 가져가야 합니다.‡Llévale el pedido de piezas de Kravel al maestro de muelles Vertipeluca en Trinquete, en Los Baldíos.‡Llévale el pedido de piezas de Kravel al maestro de muelles Vertipeluca en Trinquete, en Los Baldíos.‡Apporter la Commande de Kravel au Maître des quais Tournoupette à Cabestan, dans les Tarides.‡把克拉维尔的零件订单交给贫瘠之地棘齿城的码头管理员迪兹维格。‡前往貧瘠之地，把克拉維爾的零件訂單交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[1112] = {
  {
    'Peças para Kravel‡Детали для Крейвела‡Teile für Kravel‡크레이블의 부품‡Las piezas de Kravel‡Las piezas de Kravel‡Les pièces détachées de Kravel‡给克拉维尔的零件‡給克拉維爾的零件',
    nil,
    'Bring Kravel\'s Parts to Kravel Koalbeard on the Shimmering Flats in Thousand Needles.‡Отнесите Кравелу Углебороду его детали на Мерцающую равнину, что в Тысяче Игл.‡Bringt Kravels Teile zu Kravel Kohlebart. Zu finden ist er in der schimmernden Ebene in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 크레이블 콜비어드에게 크레이블의 부품을 가져가야 합니다.‡Llévale las piezas de Kravel a Kravel Karbarbán, que está en El Desierto de Sal en Las Mil Agujas.‡Llévale las piezas de Kravel a Kravel Karbarbán, que está en El Desierto de Sal en Las Mil Agujas.‡Apporter les Pièces détachées de Kravel à Kravel Koalbarbe dans les Salines, aux Milles pointes.‡把克拉维尔的零件交给千针石林中闪光平原的克拉维尔·浓须。‡到千針石林把克拉維爾的零件交給閃光平原的克拉維爾·濃鬚。',
  }
},
[1113] = {
  {
    'Corações do fanatismo‡Сердца Доблести‡Herzen des Eifers‡열정의 증거‡Corazones de fanatismo‡Corazones de fanatismo‡Des cœurs zélés‡狂热之链‡狂熱之心',
    nil,
    'O Mestre-boticário Faranello, da Cidade Baixa, quer 20 Corações do Fanatismo.‡Мастер-аптекарь Фаранелл из Подгорода просит принести ему 20 сердец Доблести.‡Apothekermeister Faranell in Unterstadt möchte 20 Herzen des Eifers.‡언더시티에 있는 수석 연금술사 파라넬에게 열정의 증거 20개를 가져가야 합니다.‡El maestro boticario Faranell de Entrañas quiere 20 corazones de fervor.‡El maestro boticario Faranell de Entrañas quiere 20 corazones de fanatismo.‡Le maître apothicaire Faranell, à Fossoyeuse, veut 20 Cœurs zélés.‡幽暗城的大药剂师法拉尼尔需要20根狂热之链。‡幽暗城的藥劑大師法拉尼爾需要20顆狂熱之心。',
  }
},
[1114] = {
  {
    'Entrega para os gnomos‡Заказ гномов‡Lieferung für die Gnome‡노움에게 배달‡Un envío para los gnomos‡Un envío para los gnomos‡Une livraison pour les gnomes‡侏儒的货物‡送貨給地精',
    nil,
    'Leve as Peças Frágeis de Carro para Xabu Latafuso no Salar Cintilante.‡Отнесите хрупкие детали машины Пшиксу Медноштифу на Мерцающую равнину.‡Bringt die empfindlichen Autoteile zu Fizzel Kupferbolz.‡소금 평원에 있는 피즐 브라스볼츠에게 정밀한 부품을 가져가야 합니다.‡Llévale las piezas de coche delicadas a Fizzle Pernolatón, que está en El Desierto de Sal.‡Llévale las piezas de coche delicadas a Fizzle Pernolatón, que está en El Desierto de Sal.‡Apportez les Pièces de chariot fragiles à Féplouf Zéboulon dans les Salines.‡把精密赛车零件交给菲兹尔·铜栓。‡把精密的賽車零件交給閃光平原的菲茲爾·銅栓。',
  }
},
[1115] = {
  {
    'O boateiro‡Сплетник‡Der Gerüchteverbreiter‡소문을 퍼뜨리는 자‡Rumores‡Rumores‡Le marchand de rumeurs‡车手的传闻‡車手的傳聞',
    nil,
    'Talk to Krazek at Booty Bay in Stranglethorn Vale.‡Поговорите с Кразеком в Пиратской Бухте, что в Тернистой долине.‡Sprecht mit Krazek in Beutebucht im Schlingendorntal.‡가시덤불 골짜기의 무법항에 있는 크라젝과 대화해야 합니다.‡Habla con Krazek en Bahía del Botín, en la Vega de Tuercespina.‡Habla con Krazek en Bahía del Botín, en la Vega de Tuercespina.‡Parler à Krazek à Baie-du-Butin, dans la Vallée de Strangleronce.‡和荆棘谷藏宝海湾的克拉兹克谈一谈。‡到荊棘谷的藏寶海灣找克拉茲克談話。',
  }
},
[1116] = {
  {
    'Pó onírico no pantanal‡Сонная пыль в болоте‡Traumstaub im Sumpf‡습지의 꿈가루‡Polvo onírico en el pantano‡Polvo onírico en el pantano‡De la poussière de rêve dans les marécages‡沼泽中的梦境粉尘‡沼澤中的幻夢之塵',
    nil,
    'Leve 10 Partículas de Pó Onírico para Krazek na Angra do Butim. O Pó Onírico é coletado dos dragonetes no Pântano das Mágoas.‡Принесите 10 щепоток сонной пыли Кразеку в Пиратскую Бухту. Сонную пыль можно собрать с дракончиков на Болоте Печали.‡Bringt 10 Körnchen Traumstaub zu Krazek in Beutebucht. Traumstaub erhaltet Ihr von den Drachenwelpen in den Sümpfen des Elends.‡무법항에 있는 크라젝에게 꿈가루 10줌을 가져가야 합니다. 꿈가루는 슬픔의 늪에 있는 용들에게서 얻을 수 있습니다.‡Llévale 10 pizcas de polvo onírico a Krazek a Bahía del Botín. El polvo onírico se obtiene de las crías de dragón que habitan en el Pantano de las Penas.‡Llévale 10 pizcas de polvo onírico a Krazek a Bahía del Botín. El polvo onírico se obtiene de las crías de dragón que habitan en el Pantano de las Penas.‡Apporter 10 Grains de poussière de rêve à Krazek à Baie-du-Butin. La Poussière de rêve se récupère sur les dragonnets du marais des Chagrins.‡为藏宝海湾的克拉兹克收集10份梦境粉尘。‡為藏寶海灣的克拉茲克收集10份幻夢之塵微粒。幻夢之塵微粒可以在悲傷沼澤的幼龍身上找到。',
  }
},
[1117] = {
  {
    'Rumores para Kravel‡Сплетни для Крейвела‡Gerüchte für Kravel‡크레이블을 위한 소문‡Rumores para Kravel‡Rumores para Kravel‡Des rumeurs pour Kravel‡地精的谣言‡地精的謠言',
    nil,
    'Bring the Goblin Rumors to Kravel Koalbeard on the Shimmering Flats in Thousand Needles.‡Отнесите письмо с гоблинскими сплетнями Кравелу Углебороду на Мерцающую равнину, что в Тысяче Игл.‡Bringt die Goblingerüchte zu Kravel Kohlebart. Zu finden ist er in der schimmernden Ebene in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 크레이블 콜비어드에게 고블린의 소문을 가져가야 합니다.‡Llévale los rumores goblin a Kravel Karbarbán, que está en El Desierto de Sal en Las Mil Agujas.‡Llévale los rumores goblin a Kravel Karbarbán, que está en El Desierto de Sal en Las Mil Agujas.‡Apportez les Rumeurs gobelines à Kravel Koalbarbe dans les Salines, aux Milles pointes.‡把地精的谣言带给千针石林中闪光平原的克拉维尔·浓须。‡到千針石林把哥布林的謠言帶給閃光平原的克拉維爾·濃須。',
  }
},
[1118] = {
  {
    'De volta à Angra do Butim‡Назад в Пиратскую Бухту‡Zurück nach Beutebucht‡무법항으로의 귀환‡De vuelta a Bahía del Botín‡De vuelta a Bahía del Botín‡Retour à Baie-du-Butin‡返回藏宝海湾‡返回藏寶海灣',
    nil,
    'Bring Kravel\'s Scheme to Crank Fizzlebub at Booty Bay in Stranglethorn Vale.‡Отнесите план Крейвела Шиззи Пуззыриксу в Пиратскую Бухту, что в Тернистой долине.‡Bringt Kravels Plan zu Crank Zischelbub nach Beutebucht im Schlingendorntal.‡가시덤불 골짜기의 무법항에 있는 크랭크 피즐버브에게 피즐버브에게 보내는 편지를 가져가야 합니다.‡Llévale el esquema de Kravel a Loquillo Pinchabujas a Bahía del Botín, en la Vega de Tuercespina.‡Llévale el esquema de Kravel a Loquillo Pinchabujas a Bahía del Botín, en Vega de Tuercespina.‡Apporter le Plan de Kravel à Grincheux Bullévente à Baie-du-Butin, dans la Vallée de Strangleronce.‡把克拉维尔的计划书交给荆棘谷藏宝海湾的克兰克·菲兹巴布。‡到荊棘谷把克拉維爾的計畫書交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1119] = {
  {
    'Preparado de Zanzil e Cerveja Escura do Tonto‡Смесь Занзила и "Дурацкое Крепкое"‡Zanzils Mixtur und Fools Starkbier‡잔질의 혼합물과 멍텅구리 스타우트 맥주‡La mezcla y cerveza de tontos de Zanzil‡La mezcla de Zanzil y la cerveza de tontos‡La mixture de Zanzil et la bière brune du Sot‡赞吉尔的药剂和蠢人酒‡贊吉爾的藥劑和蠢人酒',
    nil,
    'Bring the Fool\'s Stout back to Kravel on the Shimmering Flats in Thousand Needles.‡Отнесите "Дурацкое Крепкое" Крейвелу на Мерцающую равнину, что в Тысяче Игл.‡Bringt Fools Starkbier zu Kravel zurück. Zu finden ist er in der schimmernden Ebene in Tausend Nadeln.‡버섯구름 봉우리의 소금 평원에 있는 크레이블에게 멍텅구리 스타우트 맥주를 가지고 돌아가야 합니다.‡Llévale la cerveza de tontos a Kravel, que está en El Desierto de Sal en Las Mil Agujas.‡Llévale la cerveza de tontos a Kravel, que está en El Desierto de Sal en Las Mil Agujas.‡Apportez la Bière brune du Sot à Kravel, aux Salines, aux Milles pointes.‡把蠢人酒交给千针石林中闪光平原的克拉维尔。‡到千針石林把蠢人酒交給閃光平原的克拉維爾。',
  }
},
[1120] = {
  {
    'Deixe os gnomos bêbados‡Напоить гномов‡Die Gnome betrunken machen‡노움 취하게 하기‡Emborrachar a los gnomos‡Emborrachar a los gnomos‡Saoulez les gnomes‡灌醉侏儒‡灌醉地精',
    nil,
    'Bring the Fool\'s Stout to the Gnome Pit Boss at Mirage Raceway in Thousand Needles.‡Отнесите "Дурацкое Крепкое" начальнику гномского гаража в поселок Виражи на Миражах, что в Тысяче Игл.‡Bringt Fools Starkbier zum Gnomenboxenboss bei der Illusionenrennbahn in Tausend Nadeln.‡버섯구름 봉우리의 신기루 경주장에 있는 노움 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al encargado de foso gnomo al Circuito del Espejismo, en Las Mil Agujas.‡Llévale la cerveza de tontos al encargado de foso gnomo al Circuito del Espejismo, en Las Mil Agujas.‡Apportez la Bière brune du Sot au Chef-mécanicien gnome, à la Piste des mirages, aux Milles pointes.‡把蠢人酒带给千针石林中沙漠赛道的侏儒车队老板。‡到千針石林的沙漠賽道，把蠢人酒帶給地精車隊老闆。',
  }
},
[1121] = {
  {
    'Deixe os goblins bêbados‡Напоить гоблинов‡Die Goblins betrunken machen‡고블린 취하게 하기‡Emborrachar a los goblins‡Emborrachar a los goblins‡Saoulez les gobelins‡灌醉地精‡灌醉哥布林',
    nil,
    'Bring the Fool\'s Stout to the Goblin Pit Boss at Mirage Raceway in Thousand Needles.‡Отнесите "Дурацкое Крепкое" начальнику гномского гаража в поселок Виражи на Миражах, что в Тысяче Игл.‡Bringt Fools Starkbier zum Goblinboxenboss bei der Illusionenrennbahn in Tausend Nadeln.‡버섯구름 봉우리의 신기루 경기장에 있는 고블린 정비주임에게 멍텅구리 스타우트 맥주를 가져가야 합니다.‡Llévale la cerveza de tontos al encargado de foso goblin al Circuito del Espejismo, en Las Mil Agujas.‡Llévale la cerveza de tontos al encargado de foso goblin al Circuito del Espejismo, en Las Mil Agujas.‡Apportez la Bière brune du Sot au Chef-mécanicien gobelin, à la Piste des mirages, aux Milles pointes.‡把蠢人酒交给千针石林中沙漠赛道的地精车队老板。‡到千針石林的沙漠賽道，把蠢人酒交給哥布林車隊老闆。',
  }
},
[1122] = {
  {
    'Fale novamente com Mirrabolha‡Возвращение к Пуззыриксу‡Meldet Euch bei Zischelbub‡피즐버브에게 돌아가기‡Volver a informar a Pinchabujas‡Volver a informar a Pinchabujas‡Retourner voir Bullévente‡向菲兹巴布报告‡向菲茲巴布報告',
    nil,
    'Bring the Fool\'s Stout report to Crank Fizzlebub at Booty Bay in Stranglethorn Vale.‡Отнесите отчет о "Дурацком Крепком" Шиззи Пуззыриксу в Пиратскую Бухту, что в Тернистой долине.‡Bringt den Bericht über Fools Starkbier zu Crank Zischelbub nach Beutebucht im Schlingendorntal.‡가시덤불 골짜기의 무법항에 있는 크랭크 피즐버브에게 멍텅구리 스타우트 보고서를 가져가야 합니다.‡Llévale el informe de cerveza de tontos a Loquillo Pinchabujas, que está en Bahía del Botín en la Vega de Tuercespina.‡Llévale el informe de cerveza de tontos a Loquillo Pinchabujas, que está en Bahía del Botín en la Vega de Tuercespina.‡Apportez le Rapport sur la bière brune du Sot à Grincheux Bullévente, à Baie-du-Butin, dans la Vallée de Strangleronce.‡把蠢人酒试验报告交给石爪山脉藏宝海湾的克兰克·菲兹巴布。‡到荊棘谷把蠢人酒的試驗報告交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1123] = {
  {
    'Ravine Saturna‡Рабин Сатурна‡Rabine Saturna‡라빈 사투르나‡Rabine Saturna‡Rabine Saturna‡Rabine Saturna‡拉比恩·萨图纳‡拉比恩·薩圖納',
    nil,
    'Fale com Ravine Saturna no Refúgio Noturno, que fica na Clareira da Lua. A Clareira da Lua fica entre a Selva Maleva e Hibérnia, uma estrada que sai do Domínio dos Presamatos leva até lá.‡Поговорите с Рабином Сатурной в селении Ночная Гавань на Лунной поляне. Лунная поляна находится между Оскверненным лесом и Зимними Ключами, туда можно добраться по дороге, идущей от крепости Древобрюхов.‡Sprecht mit Rabine Saturna im Dorf Nachthafen auf der Mondlichtung. Die Mondlichtung liegt zwischen dem Teufelswald und Winterquell, und Ihr erreicht es über den Pfad, der aus der Holzschlundfeste herausführt.‡달의 숲의 나이트헤이븐에 있는 라빈 사투르나와 대화해야 합니다. 달의 숲은 악령의 숲과 여명의 설원 사이에 있으며 나무구렁 요새에서 나가는 길을 통해 갈 수 있습니다.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión Fauces de Madera.‡Ve a Claro de la Luna, al poblado Amparo de la Noche y habla con Rabine Saturna. Claro de la Luna se encuentra entre Frondavil y Cuna del Invierno; para llegar, tienes que seguir el camino que sale del Bastión Fauces de Madera.‡Parler à Rabine Saturna, au village de Havrenuit, à Reflet-de-Lune. Reflet-de-Lune se trouve entre Gangrebois et le Berceau-de-l\'Hiver. Le chemin qui y mène traverse le Repaire des Grumegueules.‡与月光林地永夜港的拉比恩·萨图纳谈一谈。月光林地在费伍德森林和冬泉谷之间，可以从木喉要塞中的一条通道抵达那里。‡與月光林地永夜港的拉比恩·薩圖納談一談。月光林地在費伍德森林和冬泉谷之間，可以從木喉要塞中的一條通道抵達那裡。',
  }
},
[1124] = {
  {
    'Terras Devastadas‡Пустошь‡Einöde‡황무지‡Páramo‡Páramo‡La dévastation‡废土‡荒地',
    nil,
    'Mostre a Carta de Ravine para Layo Golpestela perto do Repouso dos Valorosos, o cemitério de Silithus.‡Поговорите с Лайо Зведным Всполохом близ кладбища Погост Отважных в Силитусе и покажите ему письмо Рабина.‡Sprecht in der Nähe des Friedhofs Heldenwacht in Silithus mit Layo Sternenschlag und zeigt ihm Rabines Brief.‡실리더스의 묘지인 용사의 안식처 근처에 있는 라요 스타스트라이크를 찾아가 라빈의 편지를 보여주어야 합니다.‡Enséñale la carta de Rabine a Layo Golpe Estelar cerca del cementerio de Sosiego del Valor en Silithus.‡Enséñale la carta de Rabine a Layo Golpe Estelar cerca del cementerio de Sosiego del Valor en Silithus.‡Parler à Layo Heurtétoile, à proximité du Repos des vaillants de Silithus, et lui montrer la Lettre de Rabine.‡在希利苏斯的勇士之墓附近找莱耶·星击谈谈，把拉比恩的信交给他。‡在希利蘇斯的勇士之墓附近找萊耶·星擊談談，把拉比恩的信交給他。',
  }
},
[1125] = {
  {
    'Os espíritos de Vento Sul‡Духи Южного Ветра‡Die Geister vom Südwindposten‡마파람의 영혼‡Los espíritus de Viento del Sur‡Los espíritus de Viento del Sur‡Les esprits de Sudevent‡南风村的灵魂‡南風村的靈魂',
    nil,
    'Liberte os espíritos de 8 Druidas Torturados e 8 Sentinelas Torturadas na Vila do Vento Sul, depois fale novamente com Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Освободите в деревне Южного Ветра души 8 истерзанных друидов и 8 истерзанных часовых и вернитесь к Лайо Звездному Всполоху на кладбище Силитуса, Погост Отважных.‡Befreit die Geister von 8 gequälten Druiden und 8 gequälten Schildwachen beim Südwindposten und kehrt dann zu Layo Sternenschlag auf den Friedhof Heldenwacht in Silithus zurück.‡마파람 마을에서 고통받는 드루이드 8명과 고통받는 파수꾼 8명의 영혼을 해방한 후, 실리더스, 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 돌아가야 합니다.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturados en la Aldea del Viento del Sur. A continuación, reúnete con Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Libera los espíritus de 8 druidas torturados y 8 centinelas torturados en la Aldea del Viento del Sur. A continuación, reúnete con Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Libérer l\'esprit de 8 Druides torturés et de 8 Sentinelles torturées, dans le village de Sudevent, puis revenir voir Layo Heurtétoile, au cimetière du Repos des Vaillants de Silithus.‡在南风村释放8个被折磨的德鲁伊和8个被折磨的哨兵的灵魂，然后向希利苏斯勇士之墓的莱耶·星击复命。‡在南風村釋放8個受折磨的德魯伊和8個受折磨的哨兵的靈魂，然後向希利蘇斯勇士之墓的萊耶·星擊覆命。',
  }
},
[1126] = {
  {
    'A colmeia da torre‡Улей в башне‡Schwarmbau im Turm‡탑 속 소굴‡Una colmena en la torre‡Una colmena en la torre‡Une ruche dans la tour‡塔中之巢‡塔中之巢',
    nil,
    'Escale a torre da Vila do Vento Sul e descubra um jeito de despertar a colmeia. Leve tudo de estranho que encontrar durante a missão para Layo Golpestela no Repouso dos Valorosos, o cemitério de Silithus.‡Осмотрите башню деревни Южного Ветра и отыщите способ разворошить улей. Принесите все необычное, что попадется при выполнении задания Лайо Звездному Всполоху на кладбище Силитуса, Погост Отважных.‡Besteigt den Turm beim Südwindposten und findet eine Möglichkeit, den Schwarmbau der Silithiden aufzuscheuchen. Bringt alles Ungewöhnliche, das Ihr dabei entdeckt, zu Layo Sternenschlag auf den Friedhof Heldenwacht in Silithus.‡마파람 마을에 있는 탑 위로 올라가 실리시드 소굴을 들쑤셔 놓을 방법을 찾아야 합니다. 그러는 가운데 뭔가 알아낸 것이 있으면 실리더스의 용사의 안식처 묘지에 있는 라요 스타스트라이크에게 보고해야 합니다.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Sube a la torre de la Aldea del Viento del Sur y encuentra la forma de agitar la colmena de silítidos para que entre en actividad. Recoge cualquier cosa extraña que encuentres y llévasela a Layo Golpe Estelar en el cementerio de Sosiego del Valor en Silithus.‡Escalader la tour du village de Sudevent, et trouver un moyen de mettre la ruche des silithides en activité. Toute chose inhabituelle doit être rapportée à Layo Heurtétoile, au cimetière du Repos des vaillants de Silithus.‡爬上南风村的塔，找寻激活异种蝎群的方法。把任何你认为不寻常的东西交给希利苏斯勇士之墓的莱耶·星击。‡爬上南風村的塔，找尋啟動異種蠍群的方法。把任何你認為不尋常的東西交給希利蘇斯勇士之墓的萊耶·星擊。',
  }
},
[1127] = {
  {
    'Cerveja Escura do Tonto‡"Дурацкое Крепкое"‡Fools Starkbier‡멍텅구리 스타우트 맥주‡Cerveza de tontos‡Cerveza de tontos‡La bière du Sot‡蠢人酒‡蠢人酒',
    nil,
    'Leve 12 Preparados de Zanzil para Cranque Mirrabolha na Angra do Butim.‡Принесите 12 порций смеси Занзила Шиззи Пуззыриксу в Пиратскую Бухту.‡Bringt 12 von Zanzils Mixturen zu Crank Zischelbub in Beutebucht.‡무법항에 있는 크랭크 피즐버브에게 잔질의 혼합물 12개를 가져가야 합니다.‡Llévale 12 mezclas de Zanzil a Loquillo Pinchabujas, que está en Bahía del Botín.‡Llévale 12 mezclas de Zanzil a Loquillo Pinchabujas, que está en Bahía del Botín.‡Apporter 12 Mixtures de Zanzil à Grincheux Bullévente, à Baie-du-Butin.‡收集12份赞吉尔的药剂，把它们交给藏宝海湾的克兰克·菲兹巴布。‡收集12份贊吉爾的藥劑，把它們交給藏寶海灣的克蘭克·菲茲巴布。',
  }
},
[1130] = {
  {
    'Melor mandou lembranças‡Весть от Мелора‡Melor schickt Kunde‡멜로르의 전갈‡Melor manda saludos‡Melor manda saludos‡Melor envoie un message‡梅洛的关注‡梅洛的關注',
    nil,
    'Fale com Melor Casco de Pedra no Penhasco do Trovão.‡Поговорите с Мелором Каменным Копытом в Громовом Утесе.‡Sprecht mit Melor Steinhuf in Donnerfels.‡썬더 블러프에 있는 멜로르 스톤후프와 대화해야 합니다.‡Habla con Melor Pezuña Pétrea en Cima del Trueno.‡Habla con Melor Pezuña Pétrea en Cima del Trueno.‡Parler à Melor Sabot-de-pierre aux Pitons du Tonnerre.‡和雷霆崖的梅洛·石蹄交谈。‡和雷霆崖的梅洛·石蹄交談。',
  }
},
[1131] = {
  {
    'Estalaço‡Сталезуб‡Stahlbiss‡무쇠이빨 하이에나‡Metaleador‡Metaleador‡Broie-l\'acier‡钢齿土狼‡鋼齒土狼',
    nil,
    'Leve a Costela do Estalaço para Melor Casco de Pedra no Penhasco do Trovão.‡Принесите ребро Сталезуба Мелору Каменному Копыту в Громовой Утес.‡Bringt Stahlbiss\' Rippe zu Melor Steinhuf in Donnerfels.‡썬더 블러프의 멜로르 스톤후프에게 무쇠이빨 하이에나의 갈비뼈를 가져가야 합니다.‡Llévale la costilla de Metaleador a Melor Pezuña Pétrea, que está en Cima del Trueno.‡Llévale la costilla de Metaleador a Melor Pezuña Pétrea, que está en Cima del Trueno.‡Apportez 1 Côte de Broie-l\'acier à Melor Sabot-de-pierre aux Pitons du Tonnerre.‡把钢齿土狼的肋骨带给雷霆崖的梅洛。‡把鋼齒土狼的肋骨交給雷霆崖的梅洛·石蹄。',
  }
},
[1132] = {
  {
    'Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears‡Fiora Longears',
    nil,
    'Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.‡Speak with Fiora Longears on the docks at Auberdine in Darkshore.',
