},
[1683] = {
  {
    'Vorlus Cascruel‡Ворлус Подлое Копыто‡Vorlus Elendshuf‡볼루스 바일후프‡Vorlus Pezuñavil‡Vorlus Pezuñavil‡Vorlus Vilsabot‡沃鲁斯·邪蹄‡沃魯斯·邪蹄',
    nil,
    'Leve a Trompa de Vorlus para Elanaria em Darnassus.‡Принесите рог Ворлуса Эланарии из Дарнаса.‡Bringt das Horn von Vorlus zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 볼루스의 뿔을 가져가야 합니다.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Lleva el cuerno de Vorlus a Elanaria en Darnassus.‡Apportez la Corne de Vorlus Vilsabot à Elanaria, à Darnassus.‡将沃鲁斯的角交给达纳苏斯的艾兰娜瑞。‡將沃魯斯的角交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1684] = {
  {
    'Elanaria‡Эланария‡Elanaria‡엘라나리아‡Elanaria‡Elanaria‡Elanaria‡艾兰娜瑞‡艾蘭娜瑞',
    nil,
    'Fale com Elanaria.‡Поговорите с Эланарией.‡Sprecht mit Elanaria.‡엘라나리아와 대화해야 합니다.‡Habla con Elanaria.‡Habla con Elanaria.‡Parler à Elanaria.‡和艾兰娜瑞谈一谈。‡和艾蘭娜瑞談話。',
  }
},
[1685] = {
  {
    'Convocação de Gakin‡Приглашение Гакина‡Gakins Beschwörung‡게이킨의 부름‡La invocación de Gakin‡La invocación de Gakin‡Convocation de Gakin‡加科因的召唤‡加科因的召喚',
    nil,
    'Apresente-se a Gakin, o Neromante, no Distrito dos Magos de Ventobravo.‡Обратитесь к Гакину Темнопряду в квартал магов Штормграда.‡Meldet Euch bei Gakin dem Dunkelbinder im Magierviertel von Sturmwind.‡스톰윈드의 마법사 지구에 있는 대흑마법사 게이킨에게 보고해야 합니다.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Preséntate ante Gakin el Presotenebra en el Barrio de los Magos de Ventormenta.‡Aller voir Gakin le Tisse-noir dans le quartier des mages de Hurlevent.‡去暴风城的法师区向黑暗缚灵者加科因报到。‡去暴風城的法師區向『黑暗縛靈師』加金報到。',
  }
},
[1686] = {
  {
    'O vulto de Elura‡Тень Элуры‡Eluras Schemen‡엘룰라의 유령‡La sombra de Elura‡La sombra de Elura‡L\'Ombre d\'Elura‡艾鲁拉的阴影‡艾魯拉的陰影',
    nil,
    'Leve 8 cargas de Minério de Elunita e o Medalhão de Elura para Elanaria em Darnassus.‡Принесите 8 партий элунитовой руды и медальон Элуры Эланарии из Дарнаса.‡Bringt 8 Ladungen Eluniterz und das Medaillon von Elura zu Elanaria in Darnassus.‡다르나서스에 있는 엘라나리아에게 엘루니트 광석 상자 8개와 엘루라의 메달을 가져가야 합니다.‡Lleva 8 cargamentos de mena de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Lleva 8 piezas de mineral de elunita y el Medallón de Elura a Elanaria en Darnassus.‡Apporter 8 Caisses de minerai d\'élunite et le Médaillon d\'Elura à Elanaria à Darnassus.‡将艾鲁拉的徽章和8块月神矿石交给达纳苏斯的艾兰娜瑞。‡將艾魯拉的勳章和8塊月神礦石交給達納蘇斯的艾蘭娜瑞。',
  }
},
[1687] = {
  {
    'Farol assombrado‡Маяк с привидениями‡Der gruselige Leuchtturm‡무서운 등대‡El faro fantasma‡El faro fantasma‡Le phare hanté‡幽灵灯塔‡幽靈燈塔',
    nil,
    'Leve o órfão ao Farol, na costa de Cerro Oeste.‡Отведите сироту к маяку на побережье Западного Края.‡Besucht mit Eurem Schützling den Leuchtturm an der Küste von Westfall.‡랜디스를 서부 몰락지대 해안에 있는 등대로 데려가야 합니다.‡Lleva al huérfano a ver el faro de la costa de los Páramos de Poniente.|n‡Lleva al huérfano a ver el faro de la cosa de los Páramos de Poniente.|n‡Emmenez l\'orphelin voir le phare sur la côte de la marche de l\'Ouest.‡带着你看护的孤儿去西部荒野海岸边的灯塔。‡帶著你看護的孤兒去西部荒野海岸邊的燈塔。',
  }
},
[1688] = {
  {
    'Surena Caledon‡Сурена Каледон‡Surena Caledon‡슈레나 캘리돈‡Surena Caledon‡Surena Caledon‡Surena Caledon‡苏伦娜·凯尔东‡蘇倫娜·凱爾東',
    nil,
    'Recupere a Gargantilha de Surena e entregue-a a Gakin, o Neromante, em Ventobravo.‡Верните колье Кровавого камня Гакину Темной Вязи в Штормград.‡Beschafft Surenas Halsreif für Gakin den Dunkelbinder in Sturmwind.‡슈레나의 목걸이를 찾아 스톰윈드에 있는 대흑마법사 게이킨에게 가져가야 합니다.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Consigue la gargantilla de Surena para Gakin el Presotenebra de Ventormenta.‡Retrouver le Foulard de Surena pour Gakin le Tisse-noir à Hurlevent.‡为暴风城的黑暗缚灵者加科因夺回苏伦娜的项圈。‡為暴風城的『黑暗縛靈師』加金奪回蘇倫娜的頸飾。',
  }
},
[1689] = {
  {
    'A vinculação‡Оковы‡Die Bindung‡결속‡El vínculo‡El vínculo‡Le lien‡誓缚‡誓縛',
    nil,
    'Usando a Gargantilha de Pedra-sangrenta, evoque e sobrepuje um emissário do caos. Depois, devolva a Gargantilha de Pedra-sangrenta a Gakin, o Neromante, em Ventobravo.‡С помощью колье кровавого камня призовите и подчините демона Бездны, затем верните колье кровавого камня Гакину Темнопряду.‡Beschwört mithilfe des Blutsteinhalsreifs einen Leerwandler, unterwerft ihn und bringt dann den Blutsteinhalsreif zu Gakin dem Dunkelbinder in Sturmwind zurück.‡혈석 목걸이를 사용하여 보이드워커를 소환해 제압한 후, 스톰윈드에 있는 대흑마법사 게이킨에게 혈석 목걸이를 돌려주어야 합니다.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Con la gargantilla de sangrita, invoca y somete a un abisario. Después devuelve la gargantilla de sangrita a Gakin el Presotenebra, en Ventormenta.‡Utiliser l\'Écharpe de pierre de sang pour invoquer et soumettre un marcheur du Vide, puis la rapporter à Gakin le Tisse-noir, à Hurlevent.‡召唤并制服一个虚空行者，然后将血石颈环还给暴风城的黑暗缚灵者加科因。‡召喚並制服一個虛無行者，然後將血石頸飾還給暴風城的『黑暗縛靈師』加金。',
  }
},
[1690] = {
  {
    'O erro dos Errantes‡Расправа над Скитальцами Пустыни‡Wüstenläufergerechtigkeit‡사막유랑단 처단‡Justicia para bandidos‡Justicia para los Vagayermos‡Châtier les Bat-le-désert‡废土的公正‡制裁廢土遊民',
    nil,
    'Elimine 10 Bandidos e Ladrões Errantes a leste de Geringontzan, depois fale novamente com o Engenheiro-chefe Silvadágua.‡Убейте 10 бандитов и 10 воров из шайки Скитальцев Пустыни на востоке от Прибамбасска и возвращайтесь к главному инженеру Чепухастеру.‡Erledigt 10 Banditen und Diebe der Wüstenläufer östlich von Gadgetzan und meldet Euch dann wieder bei Chefingenieur Bilgenritzel.‡가젯잔의 동쪽에서 10명의 사막유랑단 약탈자와 좀도둑을 처치한 후, 선임기술자 빌지위즐에게 돌아와 보고하십시오.‡Acaba con 10 bandidos y ladrones Deambuladores al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Acaba con 10 bandidos y ladrones Vagayermos al este de Gadgetzan y después vuelve a ver al ingeniero jefe Pasaquillas.‡Abattez 10 Bandits et 10 Larrons Bat-le-désert à l\'est de Gadgetzan, puis revenez faire votre rapport à l\'ingénieur en chef Vizisanie.‡去加基森的东面杀掉10个废土窃贼和10个废土强盗，然后向总工程师比格维兹复命。‡去加基森的東面殺掉10個廢土竊賊和10個廢土強盜，然後向首席工程師膨嘯覆命。',
  }
},
[1691] = {
  {
    'O enterro dos Errantes‡Еще одна расправа над Скитальцами Пустыни‡Noch mehr Wüstenläufergerechtigkeit‡사막유랑단 추가 처단‡Más justicia para bandidos‡Más justicia para los Vagayermos‡Continuer à châtier les Bat-le-désert‡废土的公正‡制裁更多廢土遊民',
    nil,
    'Elimine 10 Magos das Sombras Errantes, 8 Ladinos Errantes e 6 Assassinos Errantes para o Engenheiro-chefe Silvadágua em Geringontzan.|n‡Убейте 10 темных магов, 8 разбойников и 6 убийц из шайки Скитальцев Пустыни по поручению главного инженера Чепухастера из Прибамбасска.‡Erledigt 10 Schattenmagier der Wüstenläufer, 8 Schurken der Wüstenläufer und 6 Auftragsmörder der Wüstenläufer für Chefingenieur Bilgenritzel in Gadgetzan.‡가젯잔에 있는 선임기술자 빌지위즐을 위해 사막유랑단 도적 8명, 사막유랑단 암살자 6명, 사막유랑단 어둠마법사 10명을 처치해야 합니다.‡Acaba con 10 magos oscuros Deambuladores, 8 pícaros Deambuladores y 6 asesinos Deambuladores para el ingeniero jefe Pasaquillas de Gadgetzan.|n‡Acaba con 10 magos oscuros Vagayermos, 8 pícaros Vagayermos y 6 asesinos Vagayermos para el ingeniero jefe Pasaquillas de Gadgetzan.|n‡Tuez 10 Mages de l\'ombre Bat-le-désert, 8 Voleurs Bat-le-désert et 6 Assassins Bat-le-désert pour l\'ingénieur en chef Vizisanie à Gadgetzan.‡杀死10个废土暗法师、8个废土游荡者和6个废土刺客，然后向加基森的总工程师比格维兹报告。‡殺死10個廢土暗法師、8個廢土遊蕩者和6個廢土刺客，然後向加基森的首席工程師膨嘯報告。',
  }
},
[1692] = {
  {
    'Mathiel, o ferreiro‡Кузнец Матиль‡Schmied Mathiel‡대장장이 메시엘‡Mathiel, el herrero‡Mathiel, el herrero‡Forgeron Mathiel‡铁匠玛希尔‡鐵匠瑪希爾',
    nil,
    'Leve o Caixote de Elunita para Mathiel, o Ferreiro. ‡Отнесите сундук элунита кузнецу Матилю.‡Bringt die Kiste mit Elunit zu Schmied Mathiel.‡엘루니트 상자를 대장장이 메시엘에게 가져가야 합니다.‡Lleva la caja de elunita al herrero Mathiel.‡Lleva el estuche de elunita al herrero Mathiel.‡Apportez la Caisse d\'élunite au Forgeron Mathiel.‡把这箱月神矿石交给铁匠玛希尔。‡把這箱月神礦石交給鐵匠瑪希爾。',
  }
},
[1693] = {
  {
    'Armas de elunita‡Оружие из элунита‡Waffen aus Elunit‡엘루니트의 무기‡Armas de Elunita‡Armas de Elunita‡Armes en élunite‡月神武器‡月神武器',
    nil,
    nil,
  }
},
[1698] = {
  {
    'Yorus Cervevada‡Йорус Ячменовар‡Yorus Gerstenbräu‡요루스 발리브루‡Yorus Cebadiz‡Yorus Cebadiz‡Yorus Brasselorge‡犹鲁斯·麦酒‡猶魯斯·麥酒',
    nil,
    'Fale com Yorus Cervevada.‡Поговорите с Йорусом Ячменоваром.‡Sprecht mit Yorus Gerstenbräu.‡요루스 발리브루와 대화해야 합니다.‡Habla con Yorus Cebadiz.‡Habla con Yorus Cebadiz.‡Parler à Yorus Brasselorge.‡与犹鲁斯·麦酒谈一谈。‡與猶魯斯·麥酒談話。',
  }
},
[1699] = {
  {
    'Desafio da Retibana‡Ретбанский вызов‡Der Rethbanspießrutenlauf‡레스밴 도전‡El guantelete de Rethban‡El guantelete de Rethban‡Le défi de Rethban‡往返瑞斯班洞穴‡往返瑞斯班洞穴',
    nil,
    'Entre nas Cavernas Retibanas, chegue à primeira bifurcação e volte até Yorus Cervevada no tempo estipulado.|n|nMorrer e libertar o espírito não é permitido.‡Войдите в пещеры Ретбана, доберитесь до первой развилки и вернитесь к Йорусу Ячменовару за отведенное время.|n|nВы не должны умирать и освобождать свой дух.‡Betretet die Rethbanhöhlen, geht bis zur ersten Gabelung und kehrt innerhalb der zulässigen Zeit zu Yorus Gerstenbräu zurück.|n|nIhr dürft nicht sterben und Euren Geist befreien.‡주어진 시간 내에 레스밴 동굴의 첫번째 분기점까지 들어갔다가 요루스 발리브루에게로 되돌아와야 합니다.|n|n죽어서 영혼이 빠져나가서는 안 됩니다.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|n|nNo debes morir y liberar tu espíritu.‡Entra en las Cavernas de Rethban, llega hasta la primera bifurcación y regresa junto a Yorus Cebadiz en el tiempo estipulado.|n|nNo debes morir y liberar tu espíritu.‡Entrer dans les Cavernes de Rethban jusqu\'à la première fourche, et revenir voir Brasselorge dans le temps imparti.|n|nVous ne devez pas mourir et libérer votre esprit.‡进入瑞斯班洞穴，然后在规定的时间内回到犹鲁斯·麦酒那里。|n|n在整个过程中你都不能死掉或者释放灵魂，否则任务就宣告失败。‡進入瑞斯班洞穴，然後在規定的時間內回到猶魯斯·麥酒那裡。|n|n在整個過程中你都不能死掉或者釋放靈魂，否則任務就宣告失敗。',
  }
},
[1700] = {
  {
    'Grimand Elmore‡Гриманд Элмор‡‡‡‡‡‡‡',
    nil,
    'Leve as Notas de Furen para Grimand Elmore.‡Отнесите записки Фьюрена Гриманду Элмору.‡Bringt Furens Notizen zu Grimand Elmore.‡‡Lleva las notas de Furen a Grimand Elmore.‡Lleva las notas de Furen a Grimand Elmore.‡Porter les Notes de Furen à Grimand Elmore.‡把弗伦的笔记交给格瑞曼德·艾尔默。‡',
  }
},
[1701] = {
  {
    'Malha endurecida a fogo‡Закаленный доспех‡Feuergehärteter Panzer‡불에 달궈 만든 갑옷‡Armadura de malla endurecida con fuego‡Armadura de malla endurecida con fuego‡Une cotte de mailles en acier trempé‡弗伦的铠甲‡淬火鎖甲',
    nil,
    'Colete as matérias-primas pedidas por Furen Barbalonga e leve-as para ele em Ventobravo.‡Соберите все необходимые материалы для Фьюрена Длинноборода и отнесите их в Штормград.‡Sammelt die Materialien, die Furen Langbart benötigt, und bringt sie zu ihm nach Sturmwind.‡스톰윈드에 있는 푸렌 롱비어드에게 그가 필요로 하는 재료들을 모아서 가져가야 합니다.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Reúne los materiales que necesita Furen Barbalarga y llévaselos a Ventormenta.‡Réunir les matériaux dont Furen Barbe-longue a besoin et lui apporter à Hurlevent.‡收集必需的材料，将它们交给暴风城的弗伦·长须。‡收集必需的材料，將它們交給暴風城的弗倫·長鬚。',
  }
},
[1702] = {
  {
    'O fabricante de escudos‡Щитник‡Der Schildschmied‡방패 상인‡El forjador de escudos‡El forjador de escudos‡Fabricant de bouclier‡铸盾师‡鑄盾師',
    nil,
    'Leve o Barril de Grogue para Furen Barbalonga.‡Отнесите бочонок жгучего пива Фьюрену Длиннобороду.‡Bringt das Fässlein mit Gerstenbräu zu Furen Langbart.‡푸렌 롱비어드에게 스칼더 술통을 가져가야 합니다.‡Lleva el tonel de brebaje a Furen Barbalarga.‡Lleva el barril de brebaje a Furen Barbalarga.‡Apporter la Barrique de Scalder à Furen Barbe-longue.‡将这桶热酒交给弗伦·长须。‡將這桶熱酒交給弗倫·長鬚。',
  }
},
[1703] = {
  {
    '‡Матиль‡Mathiel‡‡Mathiel‡Mathiel‡Mathiel‡玛希尔‡',
    nil,
    '‡Отнесите Матилю записки Фьюрена.‡Bringt Furens Notizen zu Mathiel.‡‡Lleva las notas de Furen a Mathiel.‡Lleva las notas de Furen a Mathiel.‡Apporter les Notes de Furen à Mathiel.‡把弗伦的笔记交给玛希尔。‡',
