    nil,
  }
},
[962] = {
  {
    'Ofídeas‡Змеецвет‡Schlangenflaum‡불뱀꽃‡Reptilia‡Reptilia‡Fleur de serpent‡毒蛇花‡毒蛇花',
    nil,
    'A Boticária Zaqueia, no Penhasco do Trovão, quer que você colete 10 Ofídeas.‡Аптекарь Зама из Громового Утеса просит вас принести ей 10 змеецветов.‡Die Apothekerin Zamah in Donnerfels möchte, dass Ihr zehn Schlangenflaum für sie sammelt.‡썬더 블러프에 있는 연금술사 자마가 불뱀꽃 10개를 모아 달라고 부탁했습니다.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡La boticaria Zamah de Cima del Trueno quiere que recojas 10 reptilias.‡L\'Apothicaire Zamah des Pitons du Tonnerre veut que vous récoltiez 10 Fleurs de serpent.‡为雷霆崖的药剂师扎玛收集10朵毒蛇花。‡為雷霆崖的藥劑師札瑪收集10朵毒蛇花。',
  }
},
[963] = {
  {
    'Amor eterno‡Во имя вечной любви‡In ewiger Liebe‡영원한 사랑‡Un amor eterno‡Un amor eterno‡Un amour éternel‡永志不渝‡永志不渝',
    nil,
    'Liberte o espírito de Anaya Correalba e leve seu pingente para Cerellean Garralva em Auberdine.‡Освободите дух Анайи Вестницы Зари и принесите ее подвеску Кириллиану Белому Когтю в Аубердин.‡Befreit den Geist von Anaya Dämmerflucht und bringt ihren Anhänger zu Cerellean Weißklaue in Auberdine.‡아나야 돈러너의 영혼을 자유롭게 한 다음 그녀의 펜던트를 아우버다인에 있는 셀렐리안 화이트클로에게 가져가야 합니다.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libera el espíritu de Anaia Correalba y lleva su colgante a Cerellean Zarpablanca a Auberdine.‡Libérer l\'esprit d\'Anaya Coursaurore et rapporter son pendentif à Cerellean Blanchegriffe à Auberdine.‡释放安娜雅·晨路的灵魂，把她的坠饰交给奥伯丁的塞瑞利恩·白爪。‡釋放安娜雅·曦奔的靈魂，把她的墜飾交給奧伯丁的塞瑞利恩·白爪。',
  }
},
[964] = {
  {
    'Fragmentos de Ossos‡Фрагменты скелетов‡Skelettfragmente‡뼛조각‡Trozos esqueléticos‡Trozos esqueléticos‡Fragments de squelette‡骸骨碎片‡骷髏碎片',
    nil,
    'Leve 15 Fragmentos de Ossos para o Boticário Trépido no Baluarte, que fica nas Terras Pestilentas Ocidentais.‡Принесите 15 фрагментов скелетов аптекарю Дитерсу в Бастион в Западных Чумных землях.‡Bringt 15 Skelettfragmente zu Apotheker Zitters am Bollwerk in Tirisfal.‡서부 역병지대의 보루에 있는 연금술사 디더스에게 뼛조각 15개를 가져가야 합니다.‡Lleva 15 trozos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Lleva 15 trozos esqueléticos al boticario Dithers en El Baluarte, en las Tierras de la Peste del Oeste.‡Apporter 15 Fragments de squelette à l\'Apothicaire Dithers à la Barricade, dans les Maleterres de l\'ouest.‡将15块骸骨碎片交给西瘟疫之地亡灵壁垒的药剂师迪瑟斯。‡將15塊骷髏碎片交給西瘟疫之地亡靈壁壘的藥劑師迪瑟斯。',
  }
},
[965] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Encontre Balthule Umbrataque perto da Torre de Althalaxx, que fica na Costa Negra.‡Найдите Балтула Удар Тени возле башни Алталакса на Темных берегах.‡Sucht Balthule Schattenhieb in der Nähe des Turms von Althalaxx in Dunkelküste.‡어둠의 해안에 있는 알살락스의 탑 근처에서 발툴 섀도스트라이크를 찾아야 합니다.‡Encuentra a Balthule Golpesombra cerca de La Torre de Althalaxx en Costa Oscura.‡Encuentra a Balthule Tenebroso cerca de La Torre de Althalaxx en Costa Oscura.‡Trouver Balthule Frappelombre près de la Tour d\'Althalaxx à Sombrivage.‡在黑海岸的奥萨拉克斯之塔附近找到巴苏尔·影击。‡在黑海岸的奧薩拉克斯之塔附近找到巴蘇爾·影擊。',
  }
},
[966] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete 4 Pergaminhos Gastos para Balthule Umbrataque, perto da Torre de Althalaxx.‡Соберите 4 свитка истрепанного пергамента для Балтула Удара Тени возле башни Алталакса.‡Sammelt 4 abgenutzte Pergamentfetzen für Balthule Schattenhieb in der Nähe des Turms von Althalaxx.‡알살락스의 탑 근처에 있는 발툴 섀도스트라이크를 위해 낡은 양피지 문서 4개를 모아야 합니다.‡Reúne 4 papiros desgastados para Balthule Golpesombra acerca de La Torre de Althalaxx.‡Reúne 4 papiros desgastados para Balthule Golpesombra acerca de La Torre de Althalaxx.‡Collecter 4 Parchemins passés pour Balthule Frappelombre près de la Tour d\'Althalaxx.‡在奥萨拉克斯之塔附近帮巴苏尔·影击收集4块破旧的羊皮纸。‡在奧薩拉克斯之塔附近幫巴蘇爾·影擊收集4塊破舊的羊皮紙。',
  }
},
[967] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Entregue a carta de Balthule a Dinis, o Purificador, na Floresta do Vale Gris.‡Доставьте письмо Балтула Делгрену Очистителю в Ясеневый лес.‡Überbringt Delgren dem Läuterer im Eschental Balthules Brief.‡잿빛 골짜기 숲에 있는 수호자 델그렌에게 발툴의 편지를 전해야 합니다.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Entrega la carta de Balthule a Delgren el Purificador que está en el Bosque de Vallefresno.‡Remettre la Lettre de Balthule à Delgren le Purificateur dans la forêt d\'Orneval.‡把巴苏尔的信送给灰谷森林中的净化者德尔格伦。‡把巴蘇爾的信送給梣谷森林中的『淨化者』德爾葛蘭。',
  }
},
[968] = {
  {
    'Os Poderes de Baixo‡"Подземные Силы"‡Die Macht in der Tiefe‡힘의 저편‡Los Poderes Subyacentes‡Los Poderes Subyacentes‡Les puissances d\'en bas‡深渊之神‡深淵之神',
    nil,
    'Leve o Livro: Os Poderes de Baixo para Gerrig Agarrosso na Caverna Esquecida, em Altaforja.‡Принесите книгу "Подземные Силы" Геррику Костохвату в Заброшенный грот в Стальгорне.‡Bringt das Buch: \'Die Macht in der Tiefe\' zu Gerrig Knochengriff im düsteren Viertel in Eisenschmiede.‡아이언포지에 있는 게릭 본그립에게 \'힘의 저편\'이라는 책을 가져가야 합니다.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Lleva el libro Los Poderes Subyacentes a Gerrig Agarrahueso a La Caverna Abandonada, en Forjaz.‡Apportez le Livre : Les puissances d\'en bas à Gerrig Poigne-d\'os, dans la Caverne lugubre de Forgefer.‡把《深渊之神》交给铁炉堡的葛利·硬骨。‡把《深淵之神》交給鐵爐堡荒棄的洞穴中的葛利·硬骨。',
  }
},
[969] = {
  {
    'Que a sorte esteja contigo‡Да пребудет с тобой удача!‡Das Glück sei mit Euch‡행운이 함께하기를‡Que la suerte sea contigo‡Que la suerte sea contigo‡Que la chance soit avec vous‡祝你好运‡祝你好運',
    nil,
    'Colete 4 Lascas de Friomalho para Mandingueira Mau\'ari, em Visteterna.‡Соберите 4 кристалла великанов Ледяного Молота для знахарки Мау\'ари из Круговзора.‡Sammelt 4 Frosthagelsplitter für die Hexendoktorin Mau\'ari in der Ewigen Warte.‡눈망루 마을의 의술사 마우아리에게 서리망치거인조각 4개를 가져가야 합니다.‡Recoge 4 esquirlas de Machacahielo para la médica bruja Mau\'ari de Vista Eterna.‡Recoge 4 esquirlas de Machacahielo para la médica bruja Mau\'ari de Vista Eterna.‡Collecter 4 Éclats cognegivre pour la féticheuse Mau\'ari à Long-guet.‡收集4块霜槌碎片，把它们交给永望镇的巫医玛艾里。‡收集4塊霜槌裂片，把它們交給永望鎮的巫醫瑪艾里。',
  }
},
[970] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Colete uma Gema Anímica Faiscante e fale novamente com Dinis, o Purificador, no Entreposto de Maestra.‡Добудьте светящийся самоцвет Души и вернитесь к Делгрену Очистителю на заставу Мейстры.‡Beschafft einen leuchtenden Seelenedelstein und bringt ihn Delgren dem Läuterer in Maestras Posten.‡빛나는 영혼의 보석을 모아 마에스트라 주둔지에 있는 수호자 델그렌에게 가져가야 합니다.‡Reúne una gema de alma resplandeciente y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Reúne una gema de alma resplandeciente y vuelve junto a Delgren el Purificador en la Atalaya de Maestra.‡Trouver une Gemme d\'âme luminescente et la rapporter à Delgren le Purificateur au poste de Maestra.‡搜集一枚发光的灵魂宝石，并把它交给迈斯特拉岗哨的净化者德尔格伦。‡搜集一枚發光的靈魂寶石，並把它交給邁斯特拉崗哨的『淨化者』德爾葛蘭。',
  }
},
[971] = {
  {
    'Conhecimento nas Profundezas‡Знание в пучине‡Wissen in der Tiefe‡심연의 지식‡El conocimiento de las profundidades‡Conocimiento en las Cavernas‡La connaissance des profondeurs‡深渊中的知识‡深淵中的知識',
    nil,
    'Leve o Manuscrito de Lorgalis para Gerrig Agarrosso na Caverna Esquecida, em Altaforja.‡Принесите манускрипт Лоргалиса Геррику Костохвату в Заброшенный грот в Стальгорне.‡Bringt das Manuskript von Lorgalis zu Gerrig Knochengriff in Eisenschmiede.‡아이언포지, 쓸쓸한 뒷골목에 있는 게릭 본그립에게 로르갈리스 초본을 가져가야 합니다.‡Lleva el manuscrito de Lorgalis a Gerrig Agarrahueso, que está en la Caverna Abandonada en Forjaz.‡Lleva el manuscrito de Lorgalis a Gerrig Agarrahueso en la Caverna Abandonada de Forjaz.‡Apportez le « Manuscrit de Lorgalis » à Gerrig Poigne-d\'os dans la Caverne lugubre de Forgefer.‡把洛迦里斯手稿带给铁炉堡的葛利·硬骨。‡把洛迦里斯手稿帶給鐵爐堡荒棄的洞穴的葛利·硬骨。',
  }
},
[972] = {
  {
    '‡Сапта воды‡Wassersapta‡물의 정기‡La sapta de agua‡La sapta de agua‡Le sapta d\'eau‡水之灵契‡水之靈契',
    nil,
    nil,
  }
},
[973] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Leve o Tomo de Ilkrud Magthrull para Dinis, o Purificador, no Entreposto de Maestra.‡Принесите фолиант Илкруда Магтрулла Делгрену Очистителю на заставу Мейстры.‡Bringt Delgren dem Läuterer in Maestras Posten Ilkrud Magskluves Folianten.‡마에스트라 주둔지에 있는 수호자 델그렌에게 일크루드 마그스룰의 마법책을 가져가야 합니다.‡Llévale el escrito de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Llévale el Libro de Ilkrud Magthrull a Delgren el Purificador en la Atalaya de Maestra.‡Apporter le Tome d\'Ilkrud Magthrull à Delgren le Purificateur au Poste de Maestra.‡把伊克鲁德·玛格苏尔之书交给迈斯特拉岗哨的净化者德尔格伦。‡把伊克魯德·瑪格蘇爾之書交給邁斯特拉崗哨的『淨化者』德爾葛蘭。',
  }
},
[974] = {
  {
    'Morno... morno... quente!‡Найти источник‡Die Quelle finden‡앗! 뜨거!‡Busca la fuente‡Busca la fuente‡À la recherche de la source‡究根问底‡究根問底',
    nil,
    'Gualter, na Cratera Un\'Goro, quer que você encontre a área mais quente do Pico Penacho de Fogo.|n|nAo se deparar com um ponto de calor, clique com o botão direito no termômetro para medir a temperatura. Procure até encontrar o mais quente de todos.‡Выясните, где находится точка самой высокой температуры на Вулкане Огненного Венца, по просьбе Кракла из Кратера Ун\'Горо. |n|nДля измерения температуры щелкните по термометру правой кнопкой мыши. Проверяйте все жаркие точки, пока не будет обнаружена точка с самой высокой температурой.‡Krakle im Krater von Un\'Goro möchte, dass Ihr den heißesten Bereich des Feuersäulengrats findet.|n|nImmer, wenn Ihr eine heiße Stelle findet, klickt Ihr das Thermometer mit der rechten Maustaste an, um die Temperatur zu überprüfen. Sucht, bis Ihr die heißeste Stelle gefunden habt.‡운고로 분화구에 있는 크래클이 불기둥 마루에서 가장 뜨거운 자리를 찾도록 요청했습니다.|n|n뜨거운 열점을 찾을 때마다 온도계측장치를 오른쪽 클릭해 온도를 재십시오. 가장 뜨거운 열점을 찾을 때까지 계속 재야 합니다.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|n|nSiempre que des con un punto caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Krakle, en el Cráter de Un\'Goro, quiere que encuentres la zona más caliente de la Cresta del Penacho en Llamas.|n|nSiempre que des con un punto caliente, pulsa con el botón derecho sobre el termómetro para comprobar la temperatura. Sigue buscando hasta que encuentres el punto más caliente.‡Krakle, au cratère d\'Un\'Goro, vous demande de découvrir la zone la plus chaude de la crête de la Fournaise.|n|nQuand vous trouvez une zone de chaleur, cliquez avec le bouton droit de la souris sur le thermomètre afin de prendre la température. Continuez vos recherches jusqu\'à avoir trouvé la zone la plus chaude.‡安戈洛尔环形山的克拉兰克要你去找到火羽山中温度最高的地方。|n|n当你找到一个看上去很热的地方时，就右键点击温度计来测量当地的温度。不断尝试，直到你找到温度最高的地方。‡安戈洛環形山的克拉蘭克要你去找到火羽山中溫度最高的地方。|n|n當你找到一個看起來很熱的地方時，就右鍵點擊溫度計來測量當地的溫度。不斷嘗試，直到你找到溫度最高的地方。',
  }
},
[975] = {
  {
    'Provisões de Mau\'ari‡Сокровище Мау\'ари‡Behälter von Mau\'ari‡마우아리의 부적‡Alijo de Mau\'ari‡Alijo de Mau\'ari‡Cache de Mau\'ari‡玛艾里的容器‡瑪艾里的容器',
    nil,
    'Fale novamente com a Mandingueira Mau\'ari em alguns instantes para receber o patuá da sorte.‡Еще раз поговорите со знахаркой Мау\'ари через минуту, чтобы получить талисман на удачу.‡Wartet einen Moment und sprecht dann erneut mit Hexendoktorin Mau\'ari, um den Glücksbringer zu erhalten.‡행운깃든 부적을 얻으려면 다시 한번 의술사 마우아리와 대화해야 합니다.‡Vuelve a hablar en un momento con la médica bruja Mau\'ari para recibir el talismán de la suerte.‡Vuelve a hablar en un momento con la médica bruja Mau\'ari para recibir el talismán de la suerte.‡Attendre un instant, puis reparler à la Féticheuse Mau\'ari pour recevoir le Charme de chance.‡与巫医玛艾里再次谈话，然后拿到好运符。‡與巫醫瑪艾里再次談話，然後拿到幸運符。',
  }
},
[976] = {
  {
    'Suprimentos para Auberdine‡Поставка для Аубердина‡Nachschub für Auberdine‡아우버다인으로의 보급품‡Suministros a Auberdine‡Suministros a Auberdine‡De l\'approvisionnement pour Auberdine‡奥伯丁的补给品‡奧伯丁的補給品',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra, após escoltar Firo pela Floresta do Vale Gris.‡Поговорите с Делгреном Очистителем на заставе Мейстры после того, как проводите Фиро через Ясеневый лес.‡Sprecht mit Delgren dem Läuterer bei Maestras Posten, nachdem Ihr Feero sicher durch das Eschental geführt habt.‡피로가 안전하게 잿빛 골짜기를 통과하도록 경호한 뒤 마에스트라 주둔지에 있는 수호자 델그렌과 대화해야 합니다.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Habla con Delgren el Purificador en la Atalaya de Maestra después ayudar a Feero a cruzar el Bosque de Vallefresno y dejarlo a buen recaudo.‡Parler à Delgren le Purificateur, au Poste de Maestra, après avoir escorté Feero à travers la Forêt d\'Orneval.‡护送费罗·艾隆汉安全地穿越灰谷森林，然后和迈斯特拉岗哨的净化者德尔格伦谈一谈。‡護送費羅·艾隆漢安全地穿越梣谷森林，再與邁斯特拉崗哨的『淨化者』德爾葛蘭談話。',
  }
},
[977] = {
  {
    'Eu yeti falar uma coisa...‡Йети где-то рядом…‡Sind wir endlich da, Yeti?‡깜짝 기계설인 대작전‡Yeti... ¿ya hemos llegado?‡Yeti... ¿ya hemos llegado?‡Yéti ? Y es-tu ?‡雪怪计划！‡雪人計畫!',
    nil,
    'Colete 2 Chifres Impolutos de Yeti para Umi Zombarruga em Visteterna.‡Добудьте 2 безупречных рога Йети для Уми Смехотреп из Круговзора.‡Sammelt 2 makellose Yetihörner für Umi Rumpelkicher in der Ewigen Warte.‡눈망루 마을에 있는 우미 럼플스니커에게 온전한 설인 뿔 2개를 가져가야 합니다.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Reúne 2 cuernos prístinos de yeti para Umi Risitas en Vista Eterna.‡Collecter 2 Cornes de yéti en parfait état pour Umi Sarcafroisse, à Long-guet‡为永望镇的乌米收集2支完美的雪人角。‡為永望鎮的烏米收集2支完美的雪人角。',
  }
},
[978] = {
  {
    'Coruscantes Lunamarca‡Осененные луной дикие совухи‡Mondbestrahltes Wildekin‡달빛의 올빼미야수‡Lechúcico Lunadón‡Lechúcico Lunadón‡Les Indomptables lunaires‡月光羽毛‡月光羽毛',
    nil,
    'Colete 10 Penas Lunamarca de Hibérnia, depois fale novamente com Erelas Ambarcéu, na Vila de Rut\'theran.‡Соберите в Зимних Ключах 10 осененных луной перьев и принесите их Эреласу Янтарному Небу в деревню Рут\'теран.‡Sammelt 10 mondbestrahlte Federn aus Winterquell und kehrt dann zu Erelas Himmelsbern in Rut\'theran zurück.‡여명의 설원에서 달빛 깃든 깃털을 10개 모아서 루테란 마을의 에렐라스 엠버스카이에게 가져와야 합니다.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Erelas Cieloámbar en Aldea Rut\'theran.‡Recoge 10 plumas Lunadón de Cuna del Invierno y regresa con Erelas Cieloámbar en Aldea Rut\'theran.‡Récupérez 10 Plumes de Chouettard lunaire au Berceau-de-l\'Hiver, puis retournez voir Erelas Ambreciel, à Rut\'theran.‡从冬泉谷收集10片月光羽毛，然后将它们带给鲁瑟兰村的艾瑞拉斯·琥珀。‡從冬泉谷收集10片月光羽毛，然後將它們帶給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[979] = {
  {
    'Encontrando Ranshalla‡В поисках Раншаллы‡Ranshalla suchen‡란샬라 찾기‡Encuentra a Ranshalla‡Encuentra a Ranshalla‡Trouver Ranshalla‡兰莎尔拉‡蘭莎爾拉',
    nil,
    'Encontre Ranshalla em Hibérnia oriental.‡Найдите Раншаллу в восточной части Зимних Ключей.‡Sucht nach Ranshalla im östlichen Winterquell.‡여명의 설원 동부에 있는 란샬라를 찾아야 합니다.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Encuentra a Ranshalla en la zona oriental de Cuna del Invierno.‡Trouver Ranshalla dans l\'est du Berceau-de-l\'Hiver.‡在冬泉谷找到兰莎尔拉。‡在冬泉谷找到蘭莎爾拉。',
  }
},
[980] = {
  {
    'As novas fontes‡Новые источники‡Die neuen Quellen‡새로운 온천‡Nuevos manantiales‡Nuevos manantiales‡Les nouvelles sources‡新的泉水‡新的泉水',
    nil,
    'Vá a Hibérnia e fale com Bruna Covaneve.‡Отправьтесь в Зимние Ключи и побеседуйте с Доновой Снегонорой.‡Reist nach Winterquell und sprecht mit Donova Schneeweh.‡여명의 설원으로 가서 도노바 스노우덴과 대화해야 합니다.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Viaja hasta Cuna del Invierno y habla con Donova Cubilnevado.‡Voyager jusqu\'au Berceau-de-l\'Hiver et parler à Donova Antreneige.‡到冬泉谷去和多诺瓦·雪山谈一谈。‡到冬泉谷去和多諾瓦·雪山談話。',
  }
},
[981] = {
  {
    'A Torre de Althalaxx‡Башня Алталакса‡Der Turm von Althalaxx‡알살락스의 탑‡La Torre de Althalaxx‡La Torre de Althalaxx‡La Tour d\'Althalaxx‡奥萨拉克斯之塔‡奧薩拉克斯之塔',
    nil,
    'Fale com Dinis, o Purificador, no Entreposto de Maestra.‡Поговорите с Делгреном Очистителем на Заставе Мейстры.‡Sprecht mit Delgren dem Läuterer in Maestras Posten.‡마에스트라 주둔지에 있는 수호자 델그렌과 대화해야 합니다.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Habla con Delgren el Purificador en la Atalaya de Maestra.‡Aller voir Delgren le Purificateur au Poste de Maestra.‡和迈斯特拉岗哨的净化者德尔格伦谈一谈。‡和邁斯特拉崗哨的『淨化者』德爾葛蘭談話。',
  }
},
[982] = {
  {
    'Nas profundezas do mar‡Безбрежное море, глубокий океан‡Tiefer Ozean, weites Meer‡깊고 푸른 바다‡Profundo océano, mar inmenso‡Profundo océano, mar inmenso‡Océan profond, mer immense‡深不可测的海洋‡深不可測的海洋',
    nil,
    'Recupere o Baú do Aurora de Prata e o Baú do Véu das Brumas para Gorbold Manácero em Auberdine. Os dois itens podem ser encontrados nos destroços dos navios, a norte da vila.‡Добудьте сейф "Серебряной Зари" и сейф "Туманной Пелены" для Горбольда Стальной Руки в Аубердине. Оба предмета можно найти в останках потерпевших крушение кораблей к северу от деревни.‡Beschafft die Schließkassette der Silbermorgen und die Schließkassette der Nebelschleier für Gorbold Stahlhand in Auberdine. Beide Gegenstände findet Ihr an Bord der Schiffswracks nördlich des Dorfes.‡아우버다인에 있는 골볼트 스틸핸드에게 은빛 새벽호의 금고와 안개 장막호의 금고를 가져가야 합니다. 모두 마을의 북쪽에 있는 난파선에서 찾을 수 있을 것입니다.‡Recupera el arcón de Amanecer de plata y el arcón del Halo de Bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Recupera el arcón del Amanecer de Plata y la caja fuerte del Halo de Bruma para Gorbold Mano de Acero de Auberdine. Ambos objetos deberían estar en los cascos de los navíos naufragados al norte de la aldea.‡Récupérer le Coffret de l\'Aube argentée et le Coffret du Voile de brume, pour Gorbold Main-d\'acier, à Auberdine. Ces deux objets se trouvent à bord des épaves des navires respectifs, au nord du village.‡找到银色清晨号的保险箱和迷雾之纱号的保险箱，把它们交给奥伯丁的高尔博德·钢手。你可以在村庄北部遇难的船只里找到这两只箱子。‡找到銀色清晨號的帶鎖箱和迷霧之紗號的帶鎖箱，把它們交給奧伯丁的高爾博多·鋼手。你可以在村莊北部遇難的船隻裡找到這兩隻帶鎖箱。',
  }
},
[983] = {
  {
    'Caixazorra 827‡Жужжалка 827‡Dröhnkiste 827‡버즈박스 827‡La caja mecánica 827‡La caja mecánica 827‡Bigobox 827‡传声盒827号‡傳聲盒827號',
    nil,
    'Colete 6 Patas de Rastejante e coloque-as na Caixazorra 827.‡Добудьте 6 ножек крабов и поместите их в Жужжалку 827.‡Sammelt 6 Kriecherbeine und baut sie in Dröhnkiste 827 ein.‡집게다리 6개를 모아 버즈박스 827에 넣어야 합니다.‡Reúne 6 patas de reptador y colócalas en la caja mecánica 827.‡Reúne 6 patas de reptador y colócalas en la caja mecánica 827.‡Réunir 6 Pattes de clampants et les mettre dans la Bigobox 827.‡收集6只蟹腿，把它们放进传声盒827号。‡收集6隻蟹腿，把它們放進傳聲盒827號。',
  }
},
[984] = {
  {
    'Uma grande ameaça?‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Encontre um acampamento de pelursos corrompidos na Costa Negra e fale novamente com Terenthis em Auberdine.‡Найдите оскверненный лагерь фурболгов на Темных берегах и вернитесь к Терентису в Аубердин.‡Sucht in Dunkelküste nach einem verderbten Furbolglager und kehrt dann zu Terenthis in Auberdine zurück.‡어둠의 해안에서 오염된 펄볼그 야영지를 찾은 다음 아우버다인에 있는 테렌디스에게 돌아가야 합니다.‡Encuentra el campamento de fúrbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Encuentra el campamento de fúrbolgs corruptos en Costa Oscura, vuelve a Auberdine y busca a Terenthis.‡Trouver un camp de furbolgs corrompus à Sombrivage et retourner voir Terenthis dans Auberdine.‡在黑海岸找到一处堕落熊怪的营地，然后向奥伯丁的特伦希斯报告。‡在黑海岸找到一處墮落熊怪的營地，然後向奧伯丁的特倫希斯報告。',
  }
},
[985] = {
  {
    'Uma grande ameaça‡Насколько велика угроза?‡Wie groß ist die Bedrohung?‡거대한 위협‡La extensión de la amenaza‡La extensión de la amenaza‡Quelle est l\'ampleur de la menace ?‡熊怪的威胁‡熊怪的威脅',
    nil,
    'Mate 8 Desbravadores Bosquenero e 5 Vozes-do-vento, depois fale novamente com Terenthis, em Auberdine.‡Убейте 8 землепроходцев и 5 заклинателей ветра из племени Чернолесья, а затем вернитесь к Терентису в Аубердин.‡Tötet 8 Pfadfinder der Schwarzfelle und 5 Windsprecher und kehrt dann zu Terenthis in Auberdine zurück.‡검은나무일족 길잡이 8마리와 풍수사 5마리를 처치한 다음 아우버다인에 있는 테렌디스에게 돌아가야 합니다.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Mata a 5 soplavientos y a 8 abrecaminos Bosque Negro y vuelve a Auberdine a buscar a Terenthis.‡Tuer 8 Guides et 5 Messagers du vent Noirbois puis retourner voir Terenthis à Auberdine.‡杀掉8个黑木探路者和5个黑木风语者，然后回到奥伯丁向特伦希斯汇报。‡殺掉8個黑木探路者和5個黑木風語者，然後回到奧伯丁向特倫希斯彙報。',
  }
},
[986] = {
  {
    'Um mestre perdido‡Пропавший хозяин‡Ein verirrter Meister‡사라진 주인‡El maestro perdido‡El maestro perdido‡Un maître perdu‡失踪的主人‡丟失的主人',
    nil,
    'Encontre 5 Pelagens de Espreitaluna Finas e leve-as para Terenthis, em Auberdine.‡Найдите 5 прекрасных шкур лунопарда и принесите их Терентису в Аубердин.‡Sucht 5 feine Mondpirscherpelze und bringt sie Terenthis in Auberdine.‡고급 달표범 모피 5필을 찾아 아우버다인에 있는 테렌디스에게 가져가야 합니다.‡Encuentra 5 pelambres de Acechalunas refinadas y llévaselas a Terenthis a Auberdine.‡Encuentra 5 pelambres de Acechalunas refinadas y llévaselas a Terenthis a Auberdine.‡Trouver 5 Belles peaux de traquelune et les apporter à Terenthis, à Auberdine.‡收集5张优质月夜猛虎毛皮，把它们交给奥伯丁的特伦希斯。‡收集5張優質月夜猛虎毛皮，把它們交給奧伯丁的特倫希斯。',
  }
},
[987] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[990] = {
  {
    'Viagem ao Vale Gris‡Путь в Ясеневый лес‡Marsch ins Eschental‡잿빛 골짜기로의 여정‡El camino de Vallefresno‡El camino de Vallefresno‡Voyage vers Orneval‡灰谷之旅‡梣谷之旅',
    nil,
    'Encontre Raene Correlobos, no Vale Gris.‡Найдите в Ясеневом лесу Раэну Волкопас.‡Sucht Raene Wolfsläufer im Eschental auf.‡잿빛 골짜기에 있는 레이네 울프러너를 찾아가야 합니다.‡Encuentra a Raene Correlobo en Vallefresno.‡Encuentra a Raene Correlobo en Vallefresno.‡Trouver Raene Mène-loup dans Orneval.‡在灰谷中找到莱恩·狼行者。‡在梣谷中找到萊恩·狼行者。',
  }
},
[991] = {
  {
    'O expurgo de Raene‡Раэна – санитар Ясеневого леса‡Raenes Säuberung‡레이네의 정화‡La limpieza de Raene‡La limpieza de Raene‡Le nettoyage selon Raene‡莱恩的净化‡萊恩的淨化',
    nil,
    'Procure Teronis no Vale Gris.‡Найдите в Ясеневом лесу Терониса.‡Sucht im Eschental nach Teronis.‡잿빛 골짜기에서 테로니스를 찾아야 합니다.‡Encuentra a Teronis en Vallefresno.‡Busca a Teronis en Vallefresno.‡Trouver Teronis dans Orneval.‡在灰谷找到泰洛尼斯。‡在梣谷找到泰洛尼斯。',
  }
},
[992] = {
  {
    'Levantamento das águas de Geringontzan‡Исследование воды‡Gadgetzan Wassersondierung‡가젯잔 수자원 측량‡Un estudio de agua de Gadgetzan‡Un estudio de agua de Gadgetzan‡Étude des eaux de Gadgetzan‡加基森水业公司‡加基森水業公司的調查報告',
    nil,
    'Use o treco de coleta vazio junto à poça d\'água perto do Posto Silitriste. Depois que você coletar a amostra, leve o treco de coleta cheio para o Topógrafo Sênior Secamolha em Geringontzan.‡Воспользуйтесь нетронутым устройством для поиска воды возле пруда на Заставе Скорбных Песков. Забрав пробу, отнесите устройство старшему геодезисту Рудознатцу в Прибамбасск.‡Benutzt den unangezapften Wünschelrutenapparat in der Nähe des Teichs bei der Sandmarterwache. Bringt den angezapften Wünschelrutenapparat zum Leitenden Feldmesser Rutenwünschels nach Gadgetzan zurück, wenn Ihr die Probe entnommen habt.‡슬픈모래 감시탑의 물 웅덩이 부근에서 추출 전의 탐사장치를 사용하십시오. 다 채웠으면 가젯잔에 있는 선임측량사 피즐도저에게 추출한 탐사장치를 가져가야 합니다.‡Utiliza la pipeta de muestras abierta en la poza de agua de Vigía Penas de Arena. Cuando hayas recogido la muestra, llévale la pipeta de muestras cerrada al perito jefe Picoflojo, que está en Gadgetzan.‡Utiliza la pipeta de muestras abierta en la poza de agua de Vigía Penas de Arena. Cuando hayas recogido la muestra, llévale la pipeta de muestras cerrada al perito jefe Picoflojo, que está en Gadgetzan.‡Utiliser la Fiole de sourcier vide à la mare près du Guet de Tristesable. Une fois l\'échantillon récolté, remettre la Fiole de sourcier pleine au grand géomètre Radiésthéflop à Gadgetzan.‡用未使用的寻水器在流沙岗哨旁边的池中采集水样。一旦你收集到水样，就尽快将其交给加基森的高级勘探员菲兹杜瑟。‡用未使用的尋水器在流沙崗哨旁邊的池中採集水樣。一旦你收集到水樣，就儘快將其交給加基森的高級勘探員菲茲杜瑟。',
  }
},
[993] = {
  {
    'Um mestre perdido‡Пропавший хозяин‡Ein verirrter Meister‡사라진 주인‡El maestro perdido‡El maestro perdido‡Un maître perdu‡丢失的主人‡丟失的主人',
    nil,
    'Encontre Volcor na Costa Negra e entregue a ele o Manto Encantado de Espreitaluna.‡Найдите Волкора на Темных берегах и отдайте ему зачарованный плащ лунопарда.‡Sucht Volcor in Dunkelküste und gebt ihm den verzauberten Mondpirscherumhang.‡어둠의 해안에 있는 볼코르를 찾아서 마법 달표범 망토를 주어야 합니다.‡Encuentra a Volcor en Costa Oscura y dale la capa de Acechalunas encantada.‡Encuentra a Volcor en Costa Oscura y dale la capa de Acechalunas encantada.‡Trouver Volcor, à Sombrivage, et lui donner la Cape enchantée de traquelune.‡找到沃科尔。‡在黑海岸找到沃科爾並且將附魔月虎披風交給他。',
  }
},
[994] = {
  {
    'Fuga difícil‡Спасение с помощью силы‡Flucht durch Gewalt‡무력 탈출‡Escaparse por la fuerza‡Escaparse por la fuerza‡Évasion par la force‡杀出重围‡殺出重圍',
    nil,
    'Proteja Volcor até vocês alcançarem a estrada, então fale com Terenthis em Auberdine.‡Защищайте Волкора, пока не доберетесь до дороги, а затем поговорите с Терентисом в Аубердине.‡Beschützt Volcor, bis Ihr die Straße erreicht habt und sprecht dann mit Terenthis in Auberdine.‡길에 이를 때까지 볼코르를 보호한 다음 아우버다인에 있는 테렌디스와 대화해야 합니다.‡Protege a Volcor hasta que lleguéis al camino y luego ve a Auberdine a hablar con Terenthis.‡Protege a Volcor hasta que lleguen al camino y luego ve a Auberdine a hablar con Terenthis.‡Protéger Volcor jusqu\'à la route puis aller voir Terenthis à Auberdine.‡保护沃科尔离开，然后去和奥伯丁的特伦希斯谈一谈。‡保護沃科爾離開，然後去和奧伯丁的特倫希斯談話。',
  }
},
[995] = {
  {
    'Fuga furtiva‡Спасение с помощью скрытности‡Flucht durch Verstohlenheit‡은밀한 탈출‡Escaparse furtivamente‡Escaparse furtivamente‡Évasion par la ruse‡偷偷溜走‡偷偷溜走',
    nil,
    'Fuja da caverna do Pelurso e encontre Terenthis em Auberdine.‡Совершите побег из пещеры фурболгов и встретьтесь в Аубердине с Терентисом.‡Flieht aus der Furbolghöhle und trefft Euch in Auberdine mit Terenthis.‡펄볼그 동굴을 탈출한 다음 아우버다인에 있는 테렌디스를 만나야 합니다.‡Escapa de la cueva fúrbolg y reúnete con Terenthis en Auberdine.‡Escapa de la cueva fúrbolg y reúnete con Terenthis en Auberdine.‡S\'échapper de la grotte des furbolgs et aller voir Terenthis à Auberdine.‡离开熊怪洞穴，然后去见奥伯丁的特伦希斯。‡離開熊怪洞穴，然後去見奧伯丁的特倫希斯。',
  }
},
[996] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
    nil,
    nil,
  }
},
[997] = {
  {
    'A terra de Denalan‡Земля Деналана‡Denalans Erde‡데날란의 흙‡Las tierras de Denalan‡Las tierras de Denalan‡La terre de Denalan‡德纳兰的泥土‡德納蘭的泥土',
    nil,
    'Leve o pacote de Terra Rara para Denalan no Lago Al\'Ameth.‡Отнесите горсть редкой земли Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee die seltene Erde.‡알아메스 호수에 있는 데날란에게 귀한 흙을 가져가야 합니다.‡Llévale el paquete con tierras raras a Denalan, que está en el Lago Al\'Ameth.‡Llévale el paquete con tierras raras a Denalan, que está en el Lago Al\'Ameth.‡Apportez le paquet de Terre rare à Denalan au lac Al\'Ameth.‡把稀土交给奥拉密斯湖畔的德纳兰。‡把稀土交給奧拉密斯湖畔的德納蘭。',
  }
},
[998] = {
  {
    'Botão Selvagem corrompido‡Оскверненный ветроцвет‡Verderbte Windblüte‡오염된 바람꽃‡Flor del viento corrupta‡Flor del viento corrupta‡La fleur-de-vent corrompue‡被腐化的迎风花‡被腐化的迎風花',
