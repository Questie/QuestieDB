[890] = {
  {
    'Carregamento perdido‡Пропавший груз‡Die verloren gegangene Lieferung‡사라진 뱃짐‡El envío perdido‡El envío perdido‡La livraison perdue‡丢失的货物‡丟失的貨物',
    nil,
    'Leve o Livro-caixa do Gasganete para o Mestre Portuário Caruncho.‡Отнесите учетную книжку Газлоу управляющему пристанью Головокружилкинсу.‡Bringt Werftmeister Flunkerblick Gazlowes Geschäftsbuch.‡부두주임 디지위그에게 가즈로의 장부를 가져가야 합니다.‡Llévale el libro de contabilidad de Gazlowe al maestro de muelles Vertipeluca.‡Llévale el libro de contabilidad de Gazlowe al maestro de muelles Vertipeluca.‡Apporter le Grand Livre de Gazleu au Maître des quais Tournoupette.‡把加兹鲁维的账本交给棘齿城的码头管理员迪兹维格。‡把加茲魯維的帳本交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[891] = {
  {
    'Os canhões da Guardanorte‡Пушки крепости Северной Стражи‡Die Kanonen von Nordwacht‡전초기지의 대포‡Las armas del Fuerte del Norte‡Las armas del Fuerte del Norte‡Sous le feu de l\'ennemi‡北方城堡的火炮‡北方城堡的火砲',
    nil,
    'O Capitão Thalo\'thas Solaz de Vila Catraca quer que você obtenha 10 Medalhas de Theramore e mate a Capitão Amazona, o Canhoneiro Ocastro e o Canhoneiro Smythe.‡Капитан Тало\'тас Сияющий поручил вам собрать 10 тераморских медалей и убить капитана Гордостанную, канонира Вессана и канонира Смайта.‡Kapitän Thalo\'thas Blendsonn aus Ratschet möchte, dass Ihr 10 Medaillen von Theramore sammelt und Hauptmann Hellstieg, Kanonier Knoch und Kanonier Hecksler tötet.‡톱니항에 있는 선장 탈로타스 브라이트썬이 테라모어 휘장 10개를 모으고 경비대장 페어마운트, 포병 훼산, 포병 스마이드를 처치해 달라고 부탁했습니다.‡El capitán Thalo\'thas Solbrillante de Trinquete quiere que le consigas 10 medallas de Theramore y que ejecutes a la capitana Justamonta, al cañonero Whessan y al cañonero Smythe.‡El capitán Thalo\'thas Solbrillante de Trinquete quiere que recojas 10 medallas de Theramore y mates a la capitana Justamonta, el cañonero Whessan y el cañonero Smythe.‡Le capitaine Thalo\'thas Brillesoleil de Cabestan veut que vous collectiez 10 Médailles de Theramore et que vous tuiez le Capitaine Beaumont, le Canonnier Whessan et le Canonnier Smythe.‡棘齿城中的沙罗萨斯船长要你收集10枚塞拉摩徽章并干掉法莫斯队长、炮兵维桑恩和炮兵斯密瑟。‡棘齒城中的沙羅薩斯船長要你收集10枚塞拉摩徽章並幹掉法莫斯隊長、砲手維桑恩和砲手斯密瑟。',
  }
},
[892] = {
  {
    'Carregamento perdido‡Пропавший груз‡Die verloren gegangene Lieferung‡사라진 뱃짐‡El envío perdido‡El envío perdido‡La livraison perdue‡丢失的货物‡丟失的貨物',
    nil,
    'Leve o Livro-caixa do Gasganete para o Gasganete na Vila Catraca.‡Верните Газлоу из Кабестана его регистр.‡Bringt Gazlowe in Ratschet sein Geschäftsbuch zurück.‡톱니항에 있는 가즈로에게 가즈로의 장부를 돌려주어야 합니다.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Llévale el libro de contabilidad de Gazlowe a Gazlowe en Trinquete.‡Rapporter le Grand Livre de Gazleu à Gazleu à Cabestan.‡把加兹鲁维的账本交还给棘齿城的加兹鲁维。‡把加茲魯維的帳本交還給棘齒城的加茲魯維。',
  }
},
[893] = {
  {
    'Armas preferidas‡Предпочитаемое оружие‡Ausgewählte Waffen‡최고의 무기‡Una selección de armas‡Una selección de armas‡Des armes de choix‡野猪人的武器‡選擇武器',
    nil,
    'Leve um Punhal Crinavalha, uma Varinha de Crinavalha Carbonizada e um Escudo de Guerra Crinavalha ao Trapista Forjaço no Acampamento Taurajo, que fica nos Sertões.‡Принесите стилет Иглогривых, обгоревший жезл Иглогривых и боевой щит Иглогривых Таттернаку Стальному Горну в Лагерь Таурахо в Степях.‡Bringt Tatternack Stahlformer im Camp Taurajo im Brachland einen Klingenmähnenrückenstecher, einen verkohlten Klingenmähnenzauberstab und einen Klingenmähnenkriegsschild.‡불모의 땅, 타우라조 야영지에 있는 테터낵 스틸포지에게 서슬갈기일족의 기습용 단검, 불타는 마법봉, 전투용 방패를 가져가야 합니다.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo de guerra Crines de Acero a Jironack Forjacero en Campamento Taurajo en Los Baldíos.‡Llévale 1 puñal Crines de Acero, 1 varita Crines de Acero carbonizada y 1 escudo de guerra Crines de Acero a Jironack Forjacero en Campamento Taurajo en Los Baldíos.‡Apporter un Eustache tranchecrin, une Baguette tranchecrin carbonisée et un Bouclier tranchecrin à Tatternack Forgacier au camp Taurajo dans les Tarides.‡给陶拉祖营地的塔特纳克·钢炉带去一把钢鬃背刺匕首、一根烧焦的钢鬃魔杖和一面钢鬃大盾。‡給陶拉祖營地的塔特納克·鋼爐帶去一把鋼鬃背刺匕首、一根燒焦的鋼鬃魔杖和一面鋼鬃大盾。',
  }
},
[894] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麼什麼平衡器',
    nil,
    'Acesse o Painel de Controle no laboratório da Empreendimentos S.A.‡Получите доступ к терминалу в исследовательском центре Торговой Компании.‡Verschafft Euch Zugang zur Steuerkonsole in der Forschungseinrichtung der Venture Company.‡투자개발회사 연구 시설의 제어장치로 접근해야 합니다.‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía.‡Accede a la consola de control del laboratorio de investigación de Ventura y Cía.‡Accéder à la Console de contrôle au Centre de recherches de la KapitalRisk.‡在风险投资公司研究基地里找到控制台。‡在風險投資公司研究基地裡找到控制臺。',
  }
},
[895] = {
  {
    'PROCURA-SE: Barão Longacosta‡Разыскивается: Барон Дольноберег‡GESUCHT: Baron Küstenschipper‡롱쇼어 남작 현상 수배‡SE BUSCA: Barón Longavera‡SE BUSCA: Barón Longavera‡ON RECHERCHE : baron de Longrivage‡通缉：巴隆·朗绍尔‡懸賞:巴隆·朗紹爾',
    nil,
    'Leve a cabeça do Barão Longacosta para Gasganete na Vila Catraca.‡Принесите Газлоу в Кабестан голову барона Дольноберега.‡Bringt Gazlowe in Ratschet Baron Küstenschippers Kopf.‡롱쇼어 남작을 처치하고 그 증거로 그의 머리카락을 톱니항에 있는 가즈로에게 가져다주어야 합니다.‡Llévale la cabeza del Barón Longavera a Gazlowe en Trinquete.‡Llévale la cabeza del barón Longavera a Gazlowe en Trinquete.‡Apportez la tête du baron de Longrivage à Gazleu à Cabestan.‡把巴隆·朗绍尔的徽记交给棘齿城的加兹鲁维。‡把巴隆·朗紹爾的頭顱交給棘齒城的加茲魯維。',
  }
},
[896] = {
  {
    'A fortuna do mineiro‡Удача шахтера‡Des Minenarbeiters Vermögen‡광부의 행운‡La fortuna de un minero‡La fortuna de un minero‡La bonne fortune d\'un mineur pauvre‡矿工的宝贝‡礦工的寶貝',
    nil,
    'Consiga a Esmeralda Olho-de-gato de um dos feitores ou seguranças da Empreendimentos S.A. e leve para o Mestre Portuário Caruncho, em Vila Catraca.‡Заберите изумруд "Кошачий глаз" у одного из надзирателей или головорезов Торговой Компании и отдайте его управляющему пристанью Головокружилкинсу в Кабестане.‡Beschafft Euch von einem der Vorarbeiter oder Vollstrecker der Venture Company den Katzenaugensmaragd und bringt ihn zu Werftmeister Flunkerblick in Ratschet.‡톱니항에 있는 부두주임 디지위그가 투자개발회사 감독이나 투자개발회사 집행자로부터 고양이눈 에메랄드를 가져다 달라고 부탁했습니다.‡Recupera la esmeralda ojo de gato de un sobrestante de Ventura y Cía. o de uno de sus gorilas para el maestro de muelles Vertipeluca, en Trinquete.‡Recupera la esmeralda ojo de gato de un sobrestante o un agente de Ventura y Cía para el maestro de muelles Vertipeluca en Trinquete.‡Prendre l\'Emeraude œil-de-chat à l\'un des Surveillants ou l\'un des Massacreurs de la KapitalRisk pour le Maître des quais Tournoupette à Cabestan.‡从风险投资公司的某个监督或者执行者那里夺取猫眼翡翠，然后把它交给棘齿城的码头管理员迪兹维格。‡從風險投資公司的某個監督者或者執行者那裡奪取貓眼翡翠，然後把它交給棘齒城的碼頭管理員迪茲維格。',
  }
},
[897] = {
  {
    'O ceifador‡Жнец‡Der Ernter‡여왕 실리시드‡El Cosechador‡El Cosechador‡Le Moissonneur‡收割者‡收割者',
    nil,
    'Leve a Cabeça do Ceifador para Jorn Vidente do Céu.‡Принесите голову Жнеца Джорну Заклинателю Небес.‡Bringt den Ernterkopf zu Jorn Himmelsdeuter.‡조른 스카이시어에게 여왕 실리시드의 머리를 가져다주어야 합니다.‡Llévale la cabeza de cosechador a Jorn Videncielo.‡Llévale la cabeza del Cosechador a Jorn Vidente del Cielo.‡Apportez la Tête du Moissonneur à Jorn Oeil-des-cieux.‡把收割者的徽记交给乔恩·星眼。‡把收割者的頭顱交給喬恩·星眼。',
  }
},
[898] = {
  {
    'Ex-detento‡Свобода!‡Aus der Gefangenschaft befreit‡요새 탈출‡Escapar del fuerte‡Escapar del fuerte‡Hors du fort‡逃离监牢‡逃離監牢',
    nil,
    'Escolte Gilthares Galhareda em segurança até o Capitão Solaz, que está na Vila Catraca.‡Проводите Гилтареса Огненный Цветок к капитану Сияющему в Кабестан.‡Begleitet Gilthares Feuerzweig sicher zurück zu Kapitän Blendsonn in Ratschet.‡길사레즈 파이어바우를 톱니항에 있는 브라이트썬 선장에게 데려가야 합니다.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escolta a Gilthares Ramafuego de vuelta hasta Trinquete con el Capitán Solbrillante.‡Escorter en toute sécurité Gilthares Ramefeu jusqu\'au capitaine Brillesoleil à Cabestan.‡护送基尔萨瑞斯·火枝安全地返回棘齿城的沙罗萨斯船长那里。‡護送基爾薩瑞斯·火枝安全地返回棘齒城的沙羅薩斯船長那裡。',
  }
},
[899] = {
  {
    'Consumido pelo ódio‡Огонь ненависти‡Von Hass zerfressen‡타오르는 증오‡Consumido por el odio‡Consumido por el odio‡Consumé par la haine‡复仇的怒火‡復仇的怒火',
    nil,
    'Leve 60 Presas de Javatusco Costagulha para Mankrik na Encruzilhada.‡Принесите Манкрику с Перекрестка 60 клыков свинобразов из племени Дыбогривов.‡Bringt Mankrik beim Wegekreuz 60 Stacheleberhauer der Borstennacken.‡크로스로드에 있는 만크릭에게 뾰족털 가시멧돼지 엄니 60개를 가져가야 합니다.‡Llévale 60 colmillos de jabaespín Erizapúas a Mankrik en El Cruce.‡Lleva 60 colmillos de jabaespines erizapúas a Mankrik en El Cruce.‡Apporter 60 Défenses de huran Dos-hirsute à Mankrik, à la Croisée.‡收集60根刺背野猪人的獠牙，把它们交给十字路口的曼科里克。‡收集60根刺背野豬人的獠牙，把它們交給十字路口的曼寇里克。',
  }
},
[900] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麼什麼平衡器',
    nil,
    'Feche a Válvula de Controle de Combustível, a Válvula de Regulagem e a Válvula Principal e, em seguida, use o Painel de Controle.‡Закройте топливный распределительный клапан, перепускной клапан и главный клапан управления, а потом снова попытайтесь воспользоваться панелью управления.‡Schließt das Treibstoffzufuhrventil, das Regelventil und das Hauptsteuerventil, und benutzt dann noch einmal die Steuerkonsole.‡연료 제어 밸브, 압력 조절 밸브, 주제어 밸브를 잠근 다음 제어장치로 돌아가십시오.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Cierra la válvula de control de combustible, la válvula reguladora y la válvula de control principal y usa entonces de nuevo la consola de control.‡Fermer la Valve de contrôle du carburant, la Valve de réglage et la Valve de contrôle principale, puis utiliser à nouveau la console de contrôle.‡关闭燃油控制阀、调节阀和主控制阀，然后再使用控制台。‡關閉燃油控制閥、調節閥和主控制閥，然後再使用控制臺。',
  }
},
[901] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麼什麼平衡器',
    nil,
    'Pegue a Chave do Painel do Engenhoqueiro Faísca para usar no painel de controle.‡Возьмите у ремонтника Угрелова ключ от терминала и отоприте им панель управления.‡Besorgt Euch bei Tüftler Kichers den Konsolenschlüssel, um damit die Steuerkonsole zu öffnen.‡땜장이 스니글즈에게서 제어장치 열쇠를 구해야 합니다.‡Consigue la llave de la consola de Manitas el Risitas para usarla en la consola de control.‡Consigue la llave de la consola del manitas el Risitas para usarla en la consola de control.‡Obtenir la Clé de la console du bricoleur Brokarde, puis l\'utiliser sur la console de contrôle.‡从工匠斯尼格斯那里拿到能打开控制台的钥匙。‡從技工斯尼格斯那裡拿到能打開控制臺的鑰匙。',
  }
},
[902] = {
  {
    'A rebimboca‡Самофланж‡Samophlang‡사모플랜지‡El churumbele‡El churumbele‡Samophlange‡什么什么平衡器‡什麼什麼平衡器',
    nil,
    'Leve a Rebimboca para Cobogó na Vila Catraca.‡Отнесите самофланж Пароклапану в Кабестан.‡Bringt das Samophlang zu Stotterspritter in Ratschet.‡톱니항에 있는 스퍼터밸브에게 사모플랜지를 가져가야 합니다.‡Llévale el churumbele a Petardol en Trinquete.‡Devuélvele el churumbele a Petardol en Trinquete.‡Rapporter le Samophlange à Krachevalve à Cabestan.‡把主动式负载平衡器交给棘齿城的斯布特瓦夫。‡把主動式負載平衡器交給棘齒城的斯布特瓦夫。',
  }
},
[903] = {
  {
    'Predadores dos Sertões‡Хищники Степей‡Streuner des Brachlandes‡불모의 땅의 굶주린 사자‡Merodeadores de los Baldíos‡Merodeadores en Los Baldíos‡Les rôdeurs des Tarides‡草原上的徘徊者‡草原上的徘徊者',
    nil,
    'Colete 7 Garras de Predador de Predadores da Savana para Sergra Espinhonegro na Encruzilhada.‡Принесите 7 когтей хищников саванны Сергре Черный Шип на Перекресток.‡Besorgt für Sergra Dunkeldorn beim Wegekreuz 7 Streunerklauen von den Savannenstreunern.‡불모의 땅의 굶주린 사바나 사자에게서 굶주린 사자의 발톱 7개를 모아 크로스로드에 있는 셀그라 다크쏜에게 돌아가야 합니다.‡Reúne 7 garras de merodeador de la sabana y llévaselas a Sergra Espinoscura en El Cruce.‡Recoge 7 garras de merodeadores de la sabana para Sergra Espinoscura en El Cruce.‡Collecter 7 Griffes de Rôdeur des savanes pour Sergra Sombreronce à la Croisée.‡帮十字路口的瑟格拉·黑棘收集7只徘徊者的爪子。‡幫十字路口的瑟格拉·黑棘收集7隻徘徊者的爪子。',
  }
},
[905] = {
  {
    'Garrafoices furiosos‡Разъяренные смертехваты‡Die wütenden Sensenklauen‡성난 갈퀴발톱 열대초원랩터‡La ira de los segadores‡Los segadores furiosos‡Les Faucheurs furieux‡狂暴的镰爪龙‡狂暴的鐮爪龍',
    nil,
    'Mate raptores Helióscamos e colete as penas. Use as penas em 3 dos ninhos de Garrafoices. Fale novamente com Sergra Espinhonegro na Encruzilhada.‡Поохотьтесь на яркочешуйчатых ящеров и соберите с них перья. Отнесите перья в 3 гнезда когтедеров. Возвращайтесь к Сергре Черный Шип в Перекресток.‡Tötet Bluthornraptoren und nehmt ihre Federn mit. Benutzt die Federn bei den drei Sensenklauennestern. Kehrt zu Sergra Dunkeldorn beim Wegekreuz zurück.‡열대초원랩터를 처치하고 그들의 깃털을 모아야 합니다. 이 깃털을 열대초원랩터 둥지 3개에 사용한 다음 크로스로드에 있는 셀그라 다크쏜에게 돌아가십시오.‡Mata a raptores solescama y recoge sus plumas. Usa estas plumas en los 3 nidos de segador. Vuelve junto a Sergra Espinoscura en El Cruce.‡Mata raptores solescama y recoge sus plumas. Usa las plumas en los 3 nidos de segadores. Vuelve con Sergra Espinoscura en El Cruce.‡Tuer des raptors solécaille et récupérer leurs plumes. Placer ces plumes dans les 3 nids de Faucheurs solécaille, puis retourner voir Sergra Sombreronce à la Croisée.‡杀死赤鳞迅猛龙并收集它们的羽毛，把这些羽毛放在3个赤鳞镰爪龙的巢穴里，然后返回十字路口的瑟格拉·黑棘那里。‡殺死赤鱗迅猛龍並收集它們的羽毛，把這些羽毛放在3個赤鱗鐮爪龍的巢穴裡，然後返回十字路口的瑟格拉·黑棘那裡。',
  }
},
[906] = {
  {
    'Traição intestina‡Предатель в наших рядах‡Verräter in den eigenen Reihen‡내부의 배반자‡Traidores‡Traidores‡Une trahison de l\'intérieur‡内奸‡內奸',
    nil,
    'Leve o Crânio de Lok para Thork na Encruzilhada, que fica nos Sertões.‡Отнесите череп Лока Тхорку на Перекресток.‡Bringt Loks Schädel zu Thork beim Wegekreuz im Brachland.‡불모의 땅, 크로스로드에 있는 톨크에게 로크의 해골을 가져가야 합니다.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Llévale la calavera de Lok a Thork en El Cruce, en Los Baldíos.‡Apporter le Crâne de Lok à Thork à la Croisée des Tarides.‡把洛克·奥克班恩的徽记交给十字路口的索克。‡把洛克·奧克班恩的顱骨交給十字路口的索克。',
  }
},
[907] = {
  {
    'Lagartos trovejantes enfurecidos‡Разъяренные рокочущие ящерицы‡Wütende Donnerechsen‡분노한 천둥도마뱀‡Los truenagartos iracundos‡Los truenagartos iracundos‡Les lézards-tonnerre enragés‡被激怒的雷霆蜥蜴‡被激怒的雷霆蜥蜴',
    nil,
    'Leve 3 unidades de Sangue de Lagarto Trovejante para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отнесите 3 порции крови рокочущей ящерицы Джорну Искателю Неба в Лагерь Таурахо.‡Bringt das Blut von 3 Donnerechsen ins Camp Taurajo zu Jorn Himmelsdeuter.‡천둥도마뱀 피 3개를 모아 타우라조 야영지에 있는 조른 스카이시어에게 가져다주어야 합니다.‡Llévale 3 unidades de sangre de truenagarto a Jorn Vidente del Cielo en el Campamento Taurajo.‡Llévale 3 unidades de sangre de truenagarto a Jorn Vidente del Cielo en el Campamento Taurajo.‡Apporter 3 doses de Sang de lézard-tonnerre à Jorn Oeil-des-cieux, au Camp Taurajo.‡收集3瓶雷霆蜥蜴的血液，把它们交给陶拉祖营地的乔恩·星眼。‡收集3瓶雷霆蜥蜴的血液，把它們交給陶拉祖營地的喬恩·星眼。',
  }
},
[908] = {
  {
    'Nas ruínas‡Среди руин‡Inmitten der Ruinen‡폐허 사이로‡Entre ruinas‡Entre ruinas‡Parmi les ruines‡废墟之间‡廢墟之間',
    nil,
    'Leve o Núcleo das Profundezas para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Принесите глубинный сердечник Дже\'неу Санкри в форт Зорам\'гар в Ясеневый лес.‡Bringt den Tiefenkern zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡심연의 핵을 잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 가져가십시오.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el núcleo de las profundidades a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Noyau de la Brasse à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, dans Orneval.‡把深渊之核交给灰谷佐拉姆加前哨站里的耶努萨克雷。‡把深淵之核交給梣谷佐拉姆加前哨站裡的耶努薩克雷。',
  }
},
[909] = {
  {
    'O Barão Aquanis‡Барон Акванис‡Baron Aquanis‡군주 아쿠아니스‡Barón Aquanis‡Barón Aquanis‡Baron Aquanis‡阿奎尼斯男爵‡阿奎尼斯男爵',
    nil,
    'Leve o Globo d\'Água Estranho para Je\'neu Sancrea no Assentamento Zoram\'gar, no Vale Gris.‡Принесите странную водяную сферу Дже\'неу Санкри в форт Зорам\'гар в Ясеневом лесу.‡Bringt die seltsame Wasserkugel zu Je\'neu Sancrea beim Außenposten von Zoram\'gar im Eschental.‡이상한 물구슬을 잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 가져가십시오.‡Llévale el globo de agua extraño a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Llévale el extraño globo de agua a Je\'neu Sancrea de la Avanzada de Zoram\'gar, Vallefresno.‡Apporter le Globe d\'eau étrange à Je\'neu Sancrea, à l\'Avant-poste de Zoram\'gar, dans Orneval.‡把奇怪的水球交给灰谷佐拉姆加前哨站的耶努萨克雷。‡把奇怪的水球交給梣谷佐拉姆加前哨站的耶努薩克雷。',
  }
},
[910] = {
  {
    'Lá nas docas‡В порту‡Unten an den Docks‡바다가 보고파요‡Un paseo por los embarcaderos‡Un paseo por los embarcaderos‡Un tour sur les quais‡降帆靠港‡降帆靠港',
    nil,
    'Leve seu protegido às docas da Vila Catraca, que fica nos Sertões.‡Отведите своего подопечного в порт Кабестана в Степях.‡Bringt Euren Schützling in die Docks von Ratschet im Brachland.‡돌보고 있는 고아를 불모의 땅에 있는 톱니항까지 데려다 주어야 합니다.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Lleva a tu pupilo a los embarcaderos de Trinquete en Los Baldíos.‡Emmenez votre protégé sur les quais de Cabestan, dans les Tarides.‡带着你看护的孤儿去贫瘠之地的棘齿城码头。‡帶著你看護的孤兒去貧瘠之地的棘齒城碼頭。',
  }
},
[911] = {
  {
    'O portal da fronteira‡Врата пограничья‡Das Tor zur Grenze‡최전선으로 가는 관문‡El acceso a la frontera‡El acceso a la frontera‡L\'accès vers la frontière‡前线之门‡前線之門',
    nil,
    'Leve seu protegido até a Paliçada Mor\'shan, que fica ao norte dos Sertões, um pouco antes da entrada do Vale Gris.‡Отведите своего подопечного к Заставе Мор\'шан в северной части Степей на границе с Ясеневым лесом.‡Begleitet Euren Schützling zum Schutzwall von Mor\'shan im nördlichen Teil des Brachlands, kurz bevor man das Eschental betritt.‡불모의 땅 북부에서 잿빛 골짜기로 들어가기 직전에 있는 몰샨의 망루까지 돌보고 있는 고아를 데려다 주어야 합니다.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Lleva a tu pupilo a La Empalizada de Mor\'shan en la zona norte de Los Baldíos, antes de la entrada a Vallefresno.‡Emmenez votre protégé au Rempart de Mor\'shan dans la région nord des Tarides, juste à l\'entrée d\'Orneval.‡带着你看护的孤儿去贫瘠之地北部的莫尔杉壁垒，它就在靠近灰谷入口的地方。‡帶著你看護的孤兒去貧瘠之地北部的莫爾杉壁壘，它就在靠近梣谷入口的地方。',
  }
},
[913] = {
  {
    'O grito do Falcotrom‡Крик грозового змея‡Der Ruf des Donnerfalken‡천둥매의 울음 소리‡El chillido del halcón trueno‡El chillido del halcón trueno‡Le cri du faucon-tonnerre‡雷鹰的嘶鸣‡雷鷹的嘶鳴',
    nil,
    'Encontre e mate um falcotrom, depois leve as asas dele para Jorn Vidente do Céu, no Acampamento Taurajo.‡Отыщите и убейте грозового змея. Принесите его крылья Джорну Заклинателю Небес в Лагерь Таурахо.‡Sucht und erschlagt einen Donnerfalken und bringt Jorn Himmelsdeuter in Camp Taurajo seine Flügel.‡천둥매를 찾아 처치하고 천둥매 날개를 타우라조 야영지에 있는 조른 스카이시어에게 가져가야 합니다.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Vidente del Cielo en el Campamento Taurajo.‡Encuentra 1 halcón trueno, mátalo y llévale sus alas a Jorn Vidente del Cielo en el Campamento Taurajo.‡Trouver et tuer un faucon-tonnerre, et rapporter ses ailes à Jorn Oeil-des-cieux, au Camp Taurajo.‡找到一只雷鹰，杀掉它，然后把它的翅膀交给陶拉祖营地的乔恩·星眼。‡找到一隻雷鷹，殺掉它，然後把它的翅膀交給陶拉祖營地的喬恩·星眼。',
  }
},
[914] = {
  {
    'Líderes da Presa‡Повелители Змей‡Anführer der Giftzähne‡송곳니의 드루이드 우두머리‡Líderes del Colmillo‡Líderes del Colmillo‡Les druides du Croc‡尖牙德鲁伊‡尖牙德魯伊',
    nil,
    'Leve as Gemas de Cobrahn, Sucurina, Pítias e Serpentis para Nara Juba Agreste no Penhasco do Trovão.‡Принесите камни Кобрана, Анакондры, Пифаса и Серпентиса Наре Буйногривой, на Громовой Утес.‡Bringt die Edelsteine von Kobrahn, Anacondra, Pythas und Serpentis nach Donnerfels zu Nara Wildmähne.‡코브란, 아나콘드라, 피타스, 서펜티스의 보석을 모아 썬더 블러프에 있는 나라 와일드메인에게 돌아가야 합니다.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Ferocrín en Cima del Trueno.‡Lleva las gemas de Cobrahn, Anacondra, Pythas y Serpentis a Nara Ferocrín en Cima del Trueno.‡Apportez les Gemmes de Cobrahn, d\'Anacondra, de Pythas et de Serpentis à Nara Crin-sauvage aux Pitons du Tonnerre.‡将考布莱恩宝石、安娜科德拉宝石、皮萨斯宝石和瑟芬迪斯宝石交给雷霆崖的纳拉·蛮鬃。‡將考布萊恩寶石、安娜科德拉寶石、皮薩斯寶石和瑟芬迪斯寶石交給雷霆崖的納拉·蠻鬃。',
  }
},
[915] = {
  {
    'Olha o sorvete!‡Женщинам – цветы, детям – ...‡Lecker Eis‡아이스크림! 아이스크림!‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace !‡草莓冰激凌‡草莓冰淇淋',
    nil,
    'Consiga Sorvete de Morango para o órfão. Ele parece gostar de sorvete da marca Tigule.‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуля.‡Besorgt für Euren Schützling etwas Erdbeereis. Der Kleine scheint die Marke \'Tigules Eiscreme\' zu bevorzugen.‡돌보고 있는 고아에게 딸기 아이스크림을 사다 주어야 합니다. 티굴의 딸기 아이스크림을 아주 좋아하는 것 같습니다.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule.‡Allez chercher de la glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢"提古勒"牌的草莓冰激凌。‡為你看護的孩子買一些草莓冰淇淋。這個孩子似乎最喜歡提古勒的草莓冰淇淋。',
  }
},
[916] = {
  {
    'Peçonha de lenhateia‡Яд чащобного паука‡Waldwebergift‡나무그물거미의 독‡El veneno de las Tejemadera‡Veneno de tejemadera‡Le venin des Tissebois‡树林蜘蛛的毒囊‡樹林蜘蛛的毒囊',
    nil,
    'Leve 10 Vesículas de Peçonha de Lenhateia para Gilshalan Andavento em Aldrassil.‡Принесите 10 ядовитых желез чащобных тенетников Гилшалану Буйному Ветру, стоящему у Альдрассила.‡Bringt Gilshalan Windwandler in Aldrassil 10 Waldwebergiftbeutel.‡알드랏실에 있는 길스할란 윈드워커에게 나무그물거미의 독주머니 10개를 가져가야 합니다.‡Lleva 10 glándulas venenosas de Tejemadera a Gilshalan Caminaviento a Aldrassil.‡Lleva 10 glándulas de veneno de tejemadera a Gilshalan Caminaviento en Aldrassil.‡Apporter 10 Glandes à venin Tissebois à Gilshalan Marche-vent, à Aldrassil.‡给奥达希尔的基尔沙兰·风行者带回10个树林蜘蛛的毒囊。‡給奧達希爾的基爾沙蘭·風行者帶回10個樹林蜘蛛的毒囊。',
  }
},
[917] = {
  {
    'Ovo de Lenhateia‡Яйцо чащобного паука‡Waldweberei‡나무그물거미의 알‡Huevo de Tejemadera‡Huevo de Tejemadera‡L\'œuf d\'araignée Tissebois‡树林蜘蛛的卵‡樹林蜘蛛的卵',
    nil,
    'Leve um Ovo de Lenhateia para Gilshalan em Aldrassil.‡Принесите яйцо чащобного тенетника Гилшалану, стоящему у Альдрассила.‡Bringt Gilshalan in Aldrassil ein Waldweberei.‡알드랏실에 있는 길스할란에게 나무그물거미알을 가져가야 합니다.‡Lleva 1 huevo de Tejemadera a Gilshalan en Aldrassil.‡Llévale un huevo de tejemadera a Gilshalan en Aldrassil.‡Apporter un Œuf d\'araignée Tissebois à Gilshalan à Aldrassil.‡给奥达希尔的基尔莎兰带回1枚树林蜘蛛的卵。‡帶1枚樹林蜘蛛的卵回來給奧達希爾的基爾莎蘭。',
  }
},
[918] = {
  {
    'Sementes de muscoide‡Саженцы древесника‡Bäumlingssamenkörner‡나무괴물 씨앗‡Semillas de Brezomadera‡Semillas de Brezomadera‡Les graines de sylvain‡林精的种子‡樹精的種子',
    nil,
    'Leve 8 Sementes de Muscoide para Denelan no Lago Al\'Ameth.‡Принесите 8 саженцев древесников Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee 8 Bäumlingssamenkörner.‡알아메스 호수에 있는데날란에게 나무괴물 씨앗 8개를 가져가야 합니다.‡Llévale 8 semillas de Brezomadera a Denalan, que está en el Lago Al\'Ameth.‡Lleva 8 semillas de brezomadera a Denalan en el Lago Al\'Ameth.‡Apporter 8 Graines de sylvain à Denalan au lac Al\'Ameth.‡给奥拉密斯湖边的德纳兰带去8粒林精的种子。‡給奧拉密斯湖邊的德納蘭帶去8粒樹精的種子。',
  }
},
[919] = {
  {
    'Brotos de muscoide‡Ростки древесника‡Bäumlingssprosse‡나무괴물 씨눈‡Brotes de Brezomadera‡Brotes de Brezomadera‡Les pousses de sylvain‡林精的新芽‡樹精的新芽',
    nil,
    'Leve 12 Brotos de Muscoide para Denalan no Lago Al\'Ameth.‡Принесите 12 ростков древесника Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee 12 Bäumlingssprosse.‡알아메스 호수에 있는 데날란에게 나무괴물 씨눈 12개를 가져가야 합니다.‡Llévale 12 brotes de Brezomadera a Denalan, que está en el Lago Al\'Ameth.‡Lleva 12 brotes de brezomadera a Denalan en el Lago Al\'Ameth.‡Apporter 12 Pousses de sylvain à Denalan au lac Al\'Ameth.‡给奥拉密斯湖边的德纳兰带去12个林精的新芽。‡給奧拉密斯湖邊的德納蘭帶去12個樹精的新芽。',
  }
},
[920] = {
  {
    'O chamado de Tenaron‡Зов Тенарона‡Tenarons Einladung‡테나론의 부름‡Las invocaciones de Tenaron‡Las invocaciones de Tenaron‡Les appels de Tenaron‡特纳隆的召唤‡特納隆的召喚',
    nil,
    'Fale com Tenaron Fortagarras no topo de Aldrassil, em Umbravale.‡Поговорите с Тенароном Хваткой Бури. Он ждет вас на вершине Альдрассила в Тенистой долине.‡Sprecht im Laubschattental über den Dächern von Aldrassil mit Tenaron Sturmgewalt.‡그늘 협곡, 알드랏실 꼭대기에 있는 테나론 스톰그립과 대화해야 합니다.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Habla con Tenaron Tormentagarre en Aldrassil, en Cañada Umbría.‡Parler à Tenaron Poignorage au sommet d\'Aldrassil à Sombrevallon.‡与奥达希尔顶部的特纳隆·雷拳交谈。‡與幽影谷內奧達希爾頂部的特納隆·雷拳交談。',
  }
},
[921] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Cristal e leve-o de volta para Tenaron Fortagarras, no topo de Aldrassil.‡Наполните хрустальный фиал и отнесите его Тенарону Хватке Бури, обитающему на вершине Альдрассила.‡Füllt die Kristallphiole und bringt sie Tenaron Sturmgewalt über den Dächern von Aldrassil.‡수정 유리병에 물을 채워서 알드랏실 꼭대기에 있는 테나론 스톰그립에게 돌아가야 합니다.‡Lleva la ampolla de cristal llena a Tenaron Tormentagarre a Aldrassil.‡Llena la ampolla de cristal y devuélvesela a Tenaron Tormentagarre en la cima de Aldrassil.‡Remplir la Fiole de cristal et la rapporter à Tenaron Poignorage au sommet d\'Aldrassil.‡装满水晶瓶并将其带回给奥达希尔顶部的特纳隆·雷拳。‡裝滿水晶之瓶並將其帶回給奧達希爾頂部的特納隆·雷拳。',
  }
},
[922] = {
  {
    'Rellian Spiraverde‡Релиан Зеленый Костер‡Rellian Grünwipfel‡레엘리안 그린스파이어‡Rellian Verdeguja‡Rellian Verdeguja‡Rellian Vertecime‡雷利亚·绿树‡雷利亞·綠樹',
    nil,
    'Leve uma Semente de Muscoide para Rellian Spiraverde, em Darnassus.‡Принесите росток древесника Релиану Зеленому Костру в Дарнас.‡Bringt Rellian Grünwipfel in Darnassus ein Bäumlingssamenkorn.‡다르나서스에 있는 레엘리안 그린스파이어에게 나무괴물 씨앗을 가져가야 합니다.‡Llévale 1 semilla de Brezomadera a Rellian Verdeguja, que está en Darnassus.‡Llévale una semilla de Brezomadera a Rellian Verdeguja en Darnassus.‡Apporter une Graine de sylvain à Rellian Vertecime à Darnassus.‡给达纳苏斯的雷利亚·绿树带去一粒林精的种子。‡給達納蘇斯的雷利亞·綠樹帶去一粒樹精的種子。',
  }
},
[923] = {
  {
    'Tumores‡Опухоли‡Tumore‡종양‡Los tumores‡Tumores‡Tumeurs‡青苔之瘤‡青苔之瘤',
    nil,
    'Leve 5 Tumores Musguentos para Rellian Spiraverde, em Darnassus.‡Принесите 5 мшистых опухолей Релиану Зеленому Костру в Дарнас.‡Bringt Rellian Grünwipfel in Darnassus 5 moosartige Tumore.‡다르나서스에 있는 레엘리안 그린스파이어에게 이끼 낀 종양 5개를 가져가야 합니다.‡Lleva 5 tumores musgosos a Rellian Verdeguja a Darnassus.‡Lleva 5 tumores musgosos a Rellian Verdeguja en Darnassus.‡Apporter 5 Tumeurs moussues à Rellian Vertecime à Darnassus.‡收集5个青苔之瘤，然后把它们交给达纳苏斯的雷利亚·绿树。‡收集5個青苔之瘤，然後把它們交給達納蘇斯的雷利亞·綠樹。',
  }
},
[924] = {
  {
    'A Semente Demoníaca‡Демоново семя‡Die Dämonensaat‡악마의 씨앗‡La Semilla del Demonio‡La Semilla del Demonio‡La Graine démoniaque‡恶魔之种‡惡魔之種',
    nil,
    'Pegue uma Pedra do Poder Defeituosa. Leve-a ao Altar de Fogo antes que ela expire e fale novamente com Ak\'Zeloth.‡Возьмите треснувший камень силы, возложите его на алтарь Огня до окончания его действия и возвращайтесь к Ак\'Зелоту.‡Nehmt einen fehlerhaften Kraftstein. Bringt ihn zum Altar des Feuers, bevor dessen Wirkung erlischt, und kehrt dann zu Ak\'Zeloth zurück.‡우선 혼란의 마법석을 손에 넣으십시오. 마법석의 힘이 다하기 전에 불의 제단에 가져다 놓은 후 아크젤로스에게 돌아가야 합니다.‡Coge 1 piedra de energía con imperfecciones. Llévala al Altar de Fuego antes de que caduque la piedra y vuelve entonces junto a Ak\'Zeloth.‡Coge 1 piedra de energía imperfecta. Llévala al Altar de Fuego antes de que su energía desaparezca y vuelve junto a Ak\'Zeloth.‡Prendre une Pierre de puissance imparfaite. L\'apporter à l\'autel de feu avant que le pouvoir de la pierre n\'expire, puis revenir à Ak\'Zeloth.‡取一块有瑕疵的能量石。在能量石失去魔法之前把它带到火焰祭坛去，然后向雅克塞罗斯复命。‡取一塊有瑕疵的能量石。在能量石失去魔法之前把它帶到火焰祭壇去，然後向雅克塞羅斯覆命。',
  }
},
[925] = {
  {
    'Impressão do casco de Caerne‡Отпечаток копыта Кэрна‡Cairnes Hufabdruck‡케른의 발굽도장‡Marca de la pezuña de Cairne‡Marca de la pezuña de Cairne‡L\'empreinte de Cairne‡凯恩的蹄印‡凱恩的蹄印',
    nil,
    'Vá ao Penhasco do Trovão para tentar conseguir a impressão do casco de Caerne Casco Sangrento para o seu protegido.‡Отправляйтесь в Громовой Утес и постарайтесь получить отпечаток копыта Кэрна Кровавого Копыта для своего подопечного.‡Reist nach Donnerfels und versucht für Euren Schützling einen Hufabdruck von Cairne Bluthuf zu ergattern.‡돌보고 있는 고아를 위해 썬더 블러프로 가서 케른 블러드후프의 발굽도장을 받아야 합니다.‡Viaja a Cima del Trueno para intentar conseguir las huellas pezuñales de Cairne Pezuña de Sangre para tu pupilo.‡Viaja a Cima del Trueno para intentar conseguir las huellas de pezuñas de Cairne Pezuña de Sangre para tu pupilo.‡Allez aux Pitons du Tonnerre pour tenter d\'obtenir l\'empreinte de sabot de Cairne pour votre protégé.‡到雷霆崖去，为你看护的孩子拿到一份凯恩·血蹄的蹄印。‡到雷霆崖去，為你看護的孩子拿到一份凱恩·血蹄的蹄印。',
  }
},
[926] = {
  {
    'Pedra do Poder Defeituosa‡Треснувший камень силы‡Fehlerhafter Kraftstein‡혼란의 마법석‡La piedra de energía con imperfecciones‡La piedra de energía con imperfecciones‡Pierre de puissance imparfaite‡有瑕疵的能量石‡有瑕疵的能量石',
    nil,
    nil,
  }
},
[927] = {
  {
    'O coração enroscado em musgo‡Сердце, поросшее мхом‡Das moosumschlungene Herz‡이끼로 덮인 심장‡El corazón musgoso‡El corazón musgoso‡Le cœur moussu‡布满苔藓的心脏‡佈滿苔蘚的心臟',
    nil,
    'Leve o Coração Enroscado em Musgo para Denalan no Lago Al\'Ameth.‡Принесите поросшее мхом сердце Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee das moosumschlungene Herz.‡이끼로 덮인 심장을 알아메스 호수에 있는 데날란에게 가져가야 합니다.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Llévale el corazón musgoso a Denalan, que está en el Lago Al\'Ameth.‡Apportez le Cœur moussu à Denalan au lac Al\'Ameth.‡将布满苔藓的心脏交给奥拉密斯湖畔的德纳兰。‡將佈滿苔蘚的心臟交給奧拉密斯湖畔的德納蘭。',
  }
},
[928] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Leve o Recipiente Parcialmente Cheio a Corithras Lunafúria em Dolanaar.‡Отнесите частично наполненный сосуд Коритрасу Лунному Гневу в Доланаар.‡Bringt Corithras Mondzorn in Dolanaar das teilweise gefüllte Gefäß.‡돌라나르에 있는 코리드라스 문레이지에게 반쯤 찬 유리병을 가져가십시오.‡Lleva la vasija parcialmente llena a Corithras Furia Lunar a Dolanaar.‡Lleva la vasija casi llena a Corithras Furia Lunar a Dolanaar.‡Apportez le Récipient à moitié rempli à Corithras Ragelune à Dolanaar.‡将装着半瓶水的瓶子交给多兰纳尔的科瑞萨斯·月怒。‡將裝著半瓶水的瓶子交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[929] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Jade e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните нефритовый фиал и принесите его Коритрасу Лунному Гневу в Доланаар.‡Füllt die Jadephiole und bringt sie Corithras Mondzorn in Dolanaar zurück.‡비취 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de jade y devuélvesela a Corithras Furia Lunar, que está en Dolanaar.‡Llena la ampolla de jade y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Fiole de jade et la rapporter à Corithras Ragelune à Dolanaar.‡用月亮井的水装满翡翠瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月井的水裝滿碧玉之瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[930] = {
  {
    'A fruta brilhante‡Светящийся плод‡Die leuchtende Frucht‡빛나는 과일‡El fruto resplandeciente‡El fruto resplandeciente‡Le fruit luminescent‡发光的水果‡發光的水果',
    nil,
    'Leve a Fruta Brilhante para Denalan no Lago Al\'Ameth.‡Принесите светящийся плод Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee die leuchtende Frucht.‡알아메스 호수에 있는 데날란에게 빛나는 과일을 가져가야 합니다.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Llévale el fruto resplandeciente a Denalan, que está en el Lago Al\'Ameth.‡Apportez le Fruit luminescent à Denalan au lac Al\'Ameth.‡把这颗发光的水果交给奥拉密斯湖的德纳兰。‡把這顆發光的水果交給奧拉密斯湖的德納蘭。',
  }
},
[931] = {
  {
    'A fronde cintilante‡Мерцающий росток‡Der schimmernde Wedel‡희미하게 빛나는 잎‡Fronda fulgurante‡Fronda fulgurante‡Les racines chatoyantes‡发光的树叶‡發光的樹葉',
    nil,
    'Leve uma Fronde Cintilante para Denalan no Lago Al\'Ameth‡Принесите мерцающий росток Деналану к озеру Аль\'Амет.‡Bringt Denalan am Al\'Amethsee einen der schimmernden Wedel.‡알아메스 호수에 있는 데날란에게 희미하게 빛나는 잎을 가져가야 합니다.‡Llévale una fronda fulgurante a Denalan, que está en el Lago Al\'Ameth.‡Lleva una fronda fulgurante a Denalan en el Lago Al\'Ameth‡Apporter les Racines chatoyantes à Denalan au lac Al\'Ameth.‡给奥拉密斯湖畔的德纳兰带去1片发光的树叶。‡給奧拉密斯湖畔的德納蘭帶去1片發光的樹葉。',
  }
},
[932] = {
  {
    'Aversão pervertida‡Извращенная ненависть‡Krankhafter Hass‡뒤틀린 증오‡Odio enraizado‡Odio enraizado‡Haine folle‡扭曲的仇恨‡扭曲的仇恨',
    nil,
    'Mate o Senhor Málinus e leve a cabeça dele para Tallonkai Radicélere, em Dolanaar.‡Убейте лорда Меленаса и принесите его голову Таллонкаю Гибкому Корню в Доланаар.‡Tötet Lord Melenas und bringt Tallonkai Flinkwurzel in Dolanaar seinen Kopf.‡제왕 멜레나스를 처치한 다음 돌라나르에 있는 탈론카이 스위프트루트에게 멜레나스의 머리띠를 가져가야 합니다.‡Mata a Lord Melenas y llévale su cabeza a Tallonkai Cruzarraíz, que está en Dolanaar.‡Mata a Lord Melenas y llévale su cabeza a Tallonkai Cruzarraíz en Dolanaar.‡Tuer le seigneur Melenas et apporter sa tête à Tallonkai Viveracine à Dolanaar.‡杀掉迈雷纳斯，带他的徽记去见多兰纳尔的塔隆凯·捷根。‡殺掉邁雷納斯領主，帶他的頭去見多蘭納爾的塔隆凱·捷根。',
  }
},
[933] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Turmalina e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните турмалиновый фиал и вернитесь к Коритрасу Лунному Гневу в Доланаар.‡Füllt die Turmalinphiole und bringt sie Corithras Mondzorn in Dolanaar.‡전기석 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de turmalina y devuélvesela a Corithras Furia Lunar, que está en Dolanaar.‡Llena la ampolla de turmalina y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Fiole de tourmaline et la rapporter à Corithras Ragelune à Dolanaar.‡用月亮井的水装满红玉瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月井的水裝滿紅玉之瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[934] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Encha o Frasco de Ametista e leve-o de volta para Corithras Lunafúria em Dolanaar.‡Наполните аметистовый фиал и принесите его Коритрасу Лунному Гневу в Доланаар.‡Füllt die Amethystphiole und bringt sie Corithras Mondzorn in Dolanaar.‡자수정 약병을 채운 다음 돌라나르에 있는 코리드라스 문레이지에게 가져가야 합니다.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Llena la ampolla de amatista y devuélvesela a Corithras Furia Lunar en Dolanaar.‡Remplir la Flasque d\'améthyste et la rapporter à Corithras Ragelune à Dolanaar.‡用月亮井的水装满紫水晶瓶，然后把它交给多兰纳尔的科瑞萨斯·月怒。‡用月井的水裝滿紫水晶之瓶，然後把它交給多蘭納爾的科瑞薩斯·月怒。',
  }
},
[935] = {
  {
    'Coroa da Terra‡Венец Земли‡Krone der Erde‡대지의 왕관‡La corona de la Tierra‡La corona de la Tierra‡La couronne de la Terre‡大地之冠‡大地之冠',
    nil,
    'Leve o Recipiente Cheio para o Arquidruida Fandral Guenelmo em Darnassus.‡Отнесите наполненный сосуд верховному друиду Фэндралу Оленьему Шлему в Дарнас.‡Bringt dem Erzdruiden Fandral Hirschhaupt in Darnassus das gefüllte Gefäß.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 가득 찬 유리병을 가져가야 합니다.‡Llévale la vasija llena al archidruida Fandral Corzocelada de Darnassus.‡Llévale la vasija llena al archidruida Fandral Corzocelada de Darnassus.‡Apportez le Récipient rempli à l\'archidruide Fandral Forteramure à Darnassus.‡将装满月亮井水的瓶子带给在达纳苏斯的大德鲁伊范达尔·鹿盔。‡將裝滿月井水的瓶子帶給在達納蘇斯的大德魯伊范達爾·鹿盔。',
  }
},
[936] = {
  {
    'Auxílio ao Arquidruida Runa Totem‡Помощь верховному друиду Руническому Тотему‡Erzdruide Runentotem helfen‡대드루이드 룬토템 돕기‡Ayuda al archidruida Tótem de Runa‡Ayuda al archidruida Tótem de Runa‡L\'aide à l\'archidruide Totem-runique‡协助大德鲁伊‡協助大德魯伊符文圖騰',
    nil,
    'Fale com o Arquidruida Hamuul Runa Totem no Penhasco do Trovão.‡Поговорите с верховным друидом Хамуулом Руническим Тотемом на Уступе Древних Громового Утеса.‡Sprecht in Donnerfels mit Erzdruide Hamuul Runentotem.‡썬더 블러프에 있는 대드루이드 하뮬 룬토템과 대화해야 합니다.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Habla con el archidruida Hamuul Tótem de Runa en Cima del Trueno.‡Parler à l\'archidruide Hamuul Totem-runique aux Pitons du Tonnerre.‡与雷霆崖的大德鲁伊哈缪尔·符文图腾谈一谈。‡與雷霆崖的大德魯伊哈繆爾·符文圖騰談話。',
  }
},
[937] = {
  {
    'A Clareira Encantada‡Зачарованная поляна‡Die verzauberte Lichtung‡마법의 터‡El claro encantado‡El claro encantado‡La clairière enchantée‡神谕林地‡神諭林地',
    nil,
    'Consiga 6 Cintos Plumassangue e leve-os para a Sentinela Arynia Rasganimbus, na Clareira do Oráculo.‡Соберите 6 поясов Кровавых перьев и принесите из часовому Арании Проблеску Солнца на Поляну Оракула.‡Beschafft 6 Blutfedergürtel und bringt sie der Schildwache Arynia Wolkenbruch in der Lichtung des Orakels.‡붉은깃털일족 허리띠 6개를 구해 신탁의 숲에 있는 파수꾼 아리니아 클라우드브레이크에게 가져가야 합니다.‡Consigue 6 cinturones Sangrepluma y llévaselos a la centinela Arynia Quiebranubes a El Claro del Oráculo.‡Consigue 6 cinturones Sangrepluma y llévaselos a la centinela Arynia Quiebranubes de El Claro del Oráculo.‡Acquérir 6 Ceintures plumesang et les apporter à la Sentinelle Arynia Eclairciel à la clairière de l\'Oracle.‡收集6条血羽腰带，把它们交给神谕林地里的哨兵阿瑞尼亚·碎云。‡收集6條血羽腰帶，把它們交給神諭林地裡的哨兵阿瑞尼亞·碎雲。',
  }
},
[938] = {
  {
    'Bruma‡Туманна‡Nebel‡미스트‡Niebla‡Niebla‡Brume‡密斯特‡密斯特',
    nil,
    'Escolte Bruma para a Sentinela Arynia Rasganimbus no poço lunar, perto da Árvore dos Oráculos.‡Проводите Туманну к Стражу Арании Проблеску Солнца к лунному колодцу близ Древа-оракула.‡Begleitet Nebel zur Schildwache Arynia Wolkenbruch beim Mondbrunnen in der Nähe des Orakelbaums.‡신탁의 나무 근처의 달샘에 있는 파수꾼 아리니아 클라우드브레이크에게 미스트를 데려가야 합니다.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la Poza de la Luna situada cerca del Árbol del Oráculo.‡Lleva a Niebla ante la centinela Arynia Quiebranubes que se encuentra en la Poza de la Luna situada cerca del Árbol del Oráculo.‡Escorter Brume vers la Sentinelle Arynia Eclairciel au puits de lune, près de l\'arbre-oracle.‡护送密斯特去神谕之树附近的月亮井旁找哨兵阿瑞尼亚·碎云。‡護送密斯特去神諭之樹附近的月井旁找哨兵阿瑞尼亞·碎雲。',
  }
},
[939] = {
  {
    'Flauta de Xavaric‡Флейта Ксаварика‡Flöte des Xavaric‡사바릭의 플룻‡La Flauta de Xavaric‡La Flauta de Xavaric‡Flûte de Xavaric‡萨瓦里克长笛‡薩瓦里克長笛',
    nil,
    'Leve a Flauta de Xavaric e 5 amostras de Ligavil de Flamejade para Eridan Brisazul, na parte sul da Selva Maleva.‡Принесите флейту Ксаварика и 5 образцов уз Скверны нефритового огня Эридане Грусти Ветра в южную часть Оскверненного леса.‡Bringt die Flöte von Xavaric und 5 Jadefeuerteufelsbinder zu Eridan Blauwind im südlichen Teil des Teufelswalds.‡사바릭의 플룻과 악의 비취불꽃 매듭 5개를 악령의 숲 남쪽의 에리단 블루윈드에게 가져가야 합니다.‡Lleva la Flauta de Xavaric y 5 muestras de lazo vil de fuego de jade a Eridan Vientoazul al Frondavil meridional.‡Lleva la Flauta de Xavaric y 5 muestras de lazo vil de fuego de jade a Eridan Vientoazul al Frondavil meridional.‡Apportez la Flûte de Xavaric et 5 échantillons de Lien maudit Jadefeu à Eridan Ventebleu, dans le sud de Gangrebois.‡将萨瓦里克长笛和5个碧火魔符交给费伍德森林南部的艾瑞丹·蓝风。‡將薩瓦里克長笛和5個碧火魔符交給費伍德森林南部的艾瑞丹·藍風。',
  }
},
[940] = {
  {
    'Teldrassil‡Тельдрассил‡Teldrassil‡텔드랏실‡Teldrassil‡Teldrassil‡Teldrassil‡泰达希尔‡泰達希爾',
    nil,
    'Entregue o relatório da Árvore dos Oráculos para o Arquidruida Fandral Guenelmo em Darnassus.‡Передайте отчет древа-оракула верховному друиду Фэндралу Оленьему Шлему в Дарнас.‡Überbringt dem Erzdruiden Fandral Hirschhaupt in Darnassus den Bericht des Orakelbaums.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름에게 글씨가 새겨진 나무껍질을 전해야 합니다.‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Llévale el informe del Árbol del Oráculo al archidruida Fandral Corzocelada de Darnassus.‡Remettre le rapport de l\'arbre-oracle à l\'archidruide Fandral Forteramure à Darnassus.‡把神谕之树的报告交给达纳苏斯的大德鲁伊范达尔·鹿盔。‡把神諭之樹的報告交給達納蘇斯的大德魯伊范達爾·鹿盔。',
  }
},
[941] = {
  {
    'Plantando coração‡Сердце-семя‡Das Einpflanzen des Herzens‡오염된 심장 재배‡Plantar el corazón‡Plantar el corazón‡Une belle plante‡培养精华‡培養心臟',
    nil,
    'Plante o Coração Maculado na Sementeira do Denalan.‡Посадите запятнанное сердце в кадку Деналана.‡Pflanzt das besudelte Herz in Denalans Blumentopf ein.‡데날란의 화분에 오염된 심장을 심어야 합니다.‡Coloca el corazón máculo en la maceta de Denalan.‡Coloca el corazón máculo en la maceta de Denalan.‡Planter le Cœur corrompu dans le Pot de Denalan.‡把被污染的精华放到德纳兰的培养槽里。‡把受污染的心臟放到德納蘭的培養槽裡。',
  }
},
[942] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Leve o fóssil misterioso ao Arqueólogo Pançacheia no Porto de Menethil.‡Отвезите таинственную окаменелость археологу Бутылопузу в Гавань Менетилов.‡Bringt das rätselhafte Fossil zum Archäologen Magenbitter im Hafen von Menethil.‡메네실 항구에 있는 고고학자 플라곤구트에게 신비로운 화석을 가져가야 합니다.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Lleva el fósil misterioso al arqueólogo Gargavino al Puerto de Menethil.‡Apporter le mystérieux Fossile à l\'Archéologue Outrepanse au port de Menethil.‡把神秘的化石交给米奈希尔港的考古学家弗拉冈特。‡把神秘的化石交給米奈希爾港的考古學家弗拉岡特。',
  }
},
[943] = {
  {
    'O prospector distraído‡Рассеянный геолог‡Der geistesabwesende Ausgrabungsleiter‡정신 없는 발굴조사단장‡El prospector despistado‡El prospector despistado‡Les absences du Prospecteur‡健忘的勘察员‡健忘的勘察員',
    nil,
    'Arqueólogo Pançacheia, no Porto de Menethil, quer que você traga a Pedra de Relu e o Fóssil do Pançacheia para ele.‡Археолог Бутылопуз в Гавани Менетилов хочет, чтобы вы принесли ему камень Релу и окаменелость Бутылопуза.‡Der Archäologe Magenbitter im Hafen von Menethil möchte, dass Ihr ihm den Stein von Relu und Magenbitters Fossil bringt.‡메네실 항구에 있는 고고학자 플라곤구트가 렐루의 돌과 플라곤구트의 화석을 가져다 달라고 부탁했습니다.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡El arqueólogo Gargavino, del Puerto de Menethil, quiere que le lleves la Piedra de Relu y el fósil de Gargavino.‡L\'archéologue Outrepanse au port de Menethil veut que vous lui apportiez la Pierre de Relu et le Fossile d\'Outrepanse.‡米奈希尔港的考古学家弗拉冈特要你把雷鲁之石带给他。‡米奈希爾港的考古學家弗拉岡特要你把雷魯之石帶給他。',
  }
},
[944] = {
  {
    'Glaive do Mestre‡Меч Властителя‡Die Meistergleve‡지배자의 무덤‡La Espada del Maestro‡La Espada del Maestro‡Le Glaive du Maître‡主宰之剑‡主宰之劍',
    nil,
    'Reúna informações, depois use o Frasco de Vidência para criar uma Bacia de Vidência. Use a bacia para falar com Onu.‡Соберите информацию, а затем используйте фиал виденья для создания гадальной чаши. С помощью чаши поговорите с Ону.‡Tragt Informationen zusammen und benutzt dann die Wahrsagephiole, um eine Wahrsageschale zu erschaffen. Benutzt die Schale, um mit Onu zu sprechen.‡정보를 수집한 다음 수정점의 유리병을 사용하여 수정점 그릇을 만드십시오. 만들어진 그릇을 사용하여 오누와 대화하십시오.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onus.‡Reúne información y luego utiliza una ampolla de adivinación para crear un cuenco de visión. Utiliza el cuenco para hablar con Onus.‡Trouver des informations, puis utiliser la Flasque de divination pour créer une Coupe de divination. Utiliser la coupe pour parler à Onu.‡收集信息，然后使用占卜之水创造出一个占卜之碗，并利用这个碗和安努通话。‡收集資訊，然後使用占卜之瓶創造出一個占卜之碗，並利用這個碗和安努通話。',
  }
},
[945] = {
  {
    'A fuga de Therylune‡Спасение Терилун‡Therylunes Flucht‡테리루네의 탈출‡La fuga de Therylune‡La fuga de Therylune‡L\'évasion de Therylune‡护送瑟瑞露尼‡護送瑟瑞露尼',
    nil,
    'Ajude Therylune a escapar e, depois, conte a Therysil, no Altar de Aessina do Vale Gris, que a irmã dela está a salvo.‡Помогите Терилун спастись, а потом сообщите Тересиль, что ее сестра в безопасности. Тересиль можно найти у Святилища Эссины в Ясеневом лесу.‡Verhelft Therylune zur Flucht und teilt dann Therysil beim Schrein von Aessina im Eschental mit, dass ihre Schwester in Sicherheit ist.‡테리루네의 탈출을 도운 다음 잿빛 골짜기의 아에시나의 제단에 있는 테리실에게 그녀가 무사하다는 사실을 알려야 합니다.‡Ayuda a escapar a Therylune y luego dile a Therysil, en el Santuario de Aessina en Vallefresno, que su hermana está a salvo.‡Ayuda a escapar a Therylune y luego dile a Therysil, en el Santuario de Aessina en Vallefresno, que su hermana está a salvo.‡Aider Therylune à s\'échapper, puis dire à Therysil au Sanctuaire d\'Aessina, à Orneval, que sa sœur est saine et sauve.‡帮助瑟瑞露尼逃跑，然后告诉在灰谷艾森娜神殿的瑟瑞希尔，她的妹妹目前很安全。‡幫助瑟瑞露尼逃跑，然後前往梣谷的艾森娜神殿通知瑟瑞希爾，她的妹妹安然無恙。',
  }
},
[946] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    nil,
  }
},
[947] = {
  {
    'Cogumelos da caverna‡Пещерные грибы‡Höhlenpilze‡동굴 버섯‡La cueva de las setas‡La cueva de las setas‡La caverne aux champignons‡洞中的蘑菇‡洞中的蘑菇',
    nil,
    'Leve 5 Galhos de Piolho e 1 Cogumelo-cicuta para Barithras Sombraluna, em Auberdine.‡Принесите 5 ножек струпника и 1 мертвянку Баритасу Лунному Сумраку в Аубердин.‡Bringt Barithras Mondschatten in Auberdine 5 Schorfstänglinge und 1 Todeskappe.‡아우버다인에 있는 바리스라스 문셰이드에게 껄껄이그물버섯 5개와 알광대버섯 1개를 가져가야 합니다.‡Lleva 5 boletos rudos y 1 oronja verde a Barithras Sombra Lunar a Auberdine.‡Lleva 5 boletos rudos y 1 oronja verde a Barithras Sombra Lunar a Auberdine.‡Apporter 5 Pédoncules d\'Amanite et 1 Amanite phalloïde à Barithras Lunombrage à Auberdine.‡收集5个粗柄蘑菇和1个毒帽蘑菇，把它们交给奥伯丁的巴瑞萨斯·月影。‡收集5個粗柄蘑菇和1個毒帽蘑菇，把它們交給奧伯丁的巴瑞薩斯·月影。',
  }
},
[948] = {
  {
    'Onu‡Ону‡Onu‡오누‡Onus‡Onus‡Onu‡安努‡安努',
    nil,
    'Fale com Onu no Bosque dos Ancientes.‡Поговорите с Ону в Роще Древних.‡Sprecht im Hain der Uralten mit Onu.‡고대정령의 숲에서 오누와 대화해야 합니다.‡Ve al Páramo de los Ancianos y habla con Onus.‡Ve al Páramo de los Ancianos y habla con Onus.‡Parler à Onu au Bosquet des Anciens.‡和古树之林的安努谈一谈。‡和古樹之林的安努談話。',
  }
},
[949] = {
  {
    'O Acampamento do Crepúsculo‡Лагерь Сумеречного Молота‡Das Lager des Schattenhammers‡황혼의망치단 야영지‡El campamento del Martillo Crepuscular‡El campamento del Martillo Crepuscular‡Le camp du Marteau du crépuscule‡暮光之锤的营地‡暮光之錘的營地',
    nil,
    'Encontre uma pista no acampamento do Martelo do Crepúsculo, que fica na Glaive do Mestre.‡Найдите подсказку в лагере клана Сумеречного Молота, расположенном у Меча Властителя.‡Sucht im Lager des Schattenhammerklans in der Meistergleve nach einem Hinweis.‡지배자의 무덤에 있는 황혼의망치단 야영지에서 단서를 찾아야 합니다.‡Encuentra una pista en el campamento del Martillo Crepuscular en La Espada del Maestro.‡Encuentra una pista en el campamento del Martillo Crepuscular en La Espada del Maestro.‡Trouver un indice au Camp du Marteau du crépuscule au Glaive du Maître.‡到位于主宰之剑的暮光之锤营地去寻找线索。‡到位於主宰之劍的暮光之錘營地去尋找線索。',
  }
},
[950] = {
  {
    'A volta a Onu‡Возвращение к Ону‡Rückkehr zu Onu‡오누에게로의 귀환‡Regresa junto a Onus‡Regresa junto a Onus‡Retourner voir Onu‡向安努回复‡向安努回覆',
    nil,
    'Leve para Onu os Rabiscos Malucos.‡Принесите Ону лист с безумными письменами.‡Bringt Onu das irrsinnige Gekritzel, das Ihr gefunden habt.‡오누에게 광기의 양피지 문서를 가져가야 합니다.‡Lleva a Onus los garabatos incomprensibles que has encontrado.‡Lleva a Onus los garabatos incomprensibles que has encontrado.‡Apporter les Gribouillages déments à Onu.‡把令人发狂的书页交给安努。‡把令人發狂的書頁交給安努。',
  }
},
[951] = {
  {
    'Relíquias de Mathistra‡Реликвии Матистры‡Relikte von Mathystra‡마시스트라의 유물‡Las reliquias de Mathystra‡Las reliquias de Mathystra‡Les Reliques de Mathystra‡玛塞斯特拉遗物‡瑪塞斯特拉聖物',
    nil,
    'Leve 6 Relíquias de Mathistra para Onu no Bosque dos Ancientes.‡Принесите Ону в Рощу Древних 6 реликвий Матистры.‡Bringt 6 Relikte von Mathystra zu Onu in den Hain der Uralten.‡고대정령의 숲에 있는 오누에게 마시스트라 유물 6개를 가져가야 합니다.‡Lleva 6 reliquias de Mathystra a Onus al Páramo de los Ancianos.‡Lleva 6 reliquias de Mathystra a Onus al Páramo de los Ancianos.‡Apporter 6 Reliques de Mathystra à Onu, au Bosquet des Anciens.‡收集6个黑暗深渊遗物，把它们交给古树之林的安努。‡收集6個黑暗深淵聖物，把它們交給古樹之林的安努。',
  }
},
[952] = {
  {
    'Bosque dos Ancientes‡Роща Древних‡Der Hain der Uralten‡고대정령의 숲‡El Páramo de los Ancianos‡El Páramo de los Ancianos‡Bosquet des Anciens‡古树之林‡古樹之林',
    nil,
    'Entregue a mensagem de Fandral para Onu no Bosque dos Ancientes, que fica na Costa Negra, ao sul de Auberdine.‡Доставьте письмо Фэндрала Ону в Рощу Древних на Темные берега к югу от Аубердина.‡Bringt Fandrals Nachricht zu Onu in den Hain der Uralten in Dunkelküste, südlich von Auberdine.‡어둠의 해안, 고대정령의 숲에 있는 오누에게 판드랄의 전갈을 전해야 합니다.‡Entrégale el mensaje de Fandral a Onus en el Páramo de los Ancianos en Costa Oscura, al sur de Auberdine.‡Entrégale el mensaje de Fandral a Onus en el Páramo de los Ancianos en Costa Oscura, al sur de Auberdine.‡Livrer le message de Fandral à Onu au Bosquet des Anciens, à Sombrivage, au sud d\'Auberdine.‡把范达尔的信交给黑海岸古树之林里的安努。‡把范達爾的信交給黑海岸古樹之林裡的安努。',
  }
},
[953] = {
  {
    'A queda de Ameth\'Aran‡Падение Амет\'Арана‡Der Untergang von Ameth\'Aran‡아메스아란의 멸망‡La caída de Ameth\'Aran‡La caída de Ameth\'Aran‡La Chute d\'Ameth\'Aran‡亚米萨兰的毁灭‡亞米薩蘭的毀滅',
    nil,
    'Estude as tabuletas que contam sobre Ameth\'Aran e sua queda, depois fale novamente com a Sentinela Tysha Lamiluna na Costa Negra.‡Изучите таблички, рассказывающие об Амет\'Аране и его падении, а затем возвращайтесь к часовому Тише Лунный Клинок, находящейся на Темных берегах.‡Studiert die Schrifttafeln, die von Ameth\'Aran und ihrem Untergang erzählen, und kehrt dann zur Schildwache Tysha Mondklinge in Dunkelküste zurück.‡멸망한 아메스아란의 역사가 기록되어 있는 서판의 내용을 알아낸 다음 어둠의 해안에 있는 파수꾼 티샤 문블레이드에게 돌아가야 합니다.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Estudia las tablillas que hablan de Ameth\'Aran y de su caída y reúnete con la centinela Tysha Filoluna en Costa Oscura.‡Étudier les tablettes qui parlent d\'Ameth\'Aran et de sa chute, puis retourner voir la Sentinelle Tysha Lamelune à Sombrivage.‡研究刻有亚米萨兰的故事及其被毁经过的石碑，然后回到黑海岸的哨兵坦莎·月刃那里。‡研究刻有亞米薩蘭的故事及其被毀經過的石碑，然後回到黑海岸的哨兵坦莎·月刃那裡。',
  }
},
[954] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Encontre a fonte da estranha aura azul nas ruínas de Bashal\'Aran.‡Найдите источник странного синего свечения в руинах Башал\'Арана.‡Sucht in den Ruinen von Bashal\'Aran nach der Quelle der seltsamen blauen Aura.‡바샬아란의 폐허에 감도는 이상한 푸른 기운의 근원을 찾아야 합니다.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Encuentra la fuente de la extraña aura azul en las Ruinas de Bashal\'Aran.‡Trouver la source de l\'aura bleue dans les Ruines de Bashal\'Aran.‡到巴莎兰废墟去找到奇怪蓝光的源头。‡到巴莎蘭廢墟尋找奇怪藍光的源頭。',
  }
},
[955] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Consiga 8 Brinco de Capeta para Astérion em Bashal\'Aran.‡Соберите 8 серег греллей для Астериона в Башал\'Аране.‡Beschafft für Asterion in Bashal\'Aran 8 Grellohrringe.‡바샬아란에 있는 아스테리온을 위해 그렐족 귀걸이 8개를 구해야 합니다.‡Consigue 8 pendientes grell y llévaselos a Asterion a Bashal\'Aran.‡Consigue 8 pendientes de grell y llévaselos a Asterion a Bashal\'Aran.‡Acquérir 8 Boucles d\'oreilles de grell pour Asterion à Bashal\'Aran.‡帮巴莎兰的阿斯特利安收集8只劣魔耳环。‡幫巴莎蘭的阿斯特利安收集8只劣魔耳環。',
  }
},
[956] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Obtenha o Selo Antigo de Pedra-da-lua e leve-o para Astérion em Bashal\'Aran.‡Добудьте древнюю печать из лунного камня и принесите ее Астериону в Башал\'Аран.‡Beschafft das alte Mondsteinsiegel und bringt es Asterion in Bashal\'Aran.‡고대 월장석 봉인을 찾아 바샬아란에 있는 아스테리온에게 가져가야 합니다.‡Consigue el sello de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Consigue el sello de piedra lunar antiguo y llévaselo a Asterion a Bashal\'Aran.‡Obtenir l\'Ancien sceau de pierre de lune et l\'apporter à Asterion à Bashal\'Aran.‡获取远古月亮石封印，把它交给巴莎兰的阿斯特利安。‡獲取遠古月亮石封印，把它交給巴莎蘭的阿斯特利安。',
  }
},
[957] = {
  {
    'Bashal\'Aran‡Башал\'Аран‡Bashal\'Aran‡바샬아란‡Bashal\'Aran‡Bashal\'Aran‡Bashal\'Aran‡巴莎兰‡巴莎蘭',
    nil,
    'Destrua o Selo Antigo de Pedra-da-lua na chama ancestral em Ameth\'Aran, depois fale novamente com Astérion em Bashal\'Aran.‡Уничтожьте древнюю печать из лунного камня у древнего пламени в Амет\'Аране, затем вернитесь к Астериону в Башал\'Аран.‡Zerstört das alte Mondsteinsiegel in der uralten Flamme in Ameth\'Aran und kehrt dann zu Asterion in Bashal\'Aran zurück.‡아메스아란에 있는 고대의 불꽃으로 고대 월장석 봉인을 파괴한 다음 바샬아란에 있는 아스테리온에게 돌아가야 합니다.‡Destruye el sello de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Destruye el sello de piedra lunar antiguo en la antigua llama de Ameth\'Aran y vuelve a reunirte con Asterion en Bashal\'Aran.‡Détruire l\'Ancien sceau de pierre de lune à la flamme antique qui se trouve dans Ameth\'Aran, puis retourner voir Asterion à Bashal\'Aran.‡用亚米萨兰废墟中的远古火焰摧毁远古月亮石封印，然后回到巴莎兰的阿斯特利安那里。‡用亞米薩蘭廢墟中的遠古火焰摧毀遠古月亮石封印，然後回到巴莎蘭的阿斯特利安那裡。',
  }
},
[958] = {
  {
    'Ferramentas dos Altaneiros‡Инструменты высокорожденных‡Werkzeuge der Hochgeborenen‡명가의 도구‡Las herramientas de los Altonato‡Las herramientas de los Altonato‡Les outils des Bien-nés‡上层精灵的工具‡精靈貴族的工具',
    nil,
    'Resgate 7 Relíquias dos Altaneiros para Trovejius Tecevento, em Auberdine.‡Добудьте 7 реликвий высокорожденных для Тандриса Ветропряда в Аубердине.‡Sucht sieben Hochgeborenenrelikte und bringt sie Thundris Windwirker in Auberdine.‡아우버다인에 있는 툰드리스 윈드위버를 위해 명가의 유물 7개를 찾아 와야 합니다.‡Reúne 7 reliquias de Altonato y llévaselas a Thundris Tejevientos a Auberdine.‡Reúne 7 reliquias de los Altonato y llévaselas a Thundris Tejevientos a Auberdine.‡Retrouver 7 Reliques de Bien-né pour Thundris Tissevent à Auberdine.‡帮奥伯丁的桑迪斯·织风取回7个上层精灵的遗物。‡幫奧伯丁的桑迪斯·織風取回7個精靈貴族的聖物。',
  }
},
[959] = {
  {
    'Encrencas nas docas‡Неприятности в порту‡Ärger auf den Docks‡99년 묵은 포도주‡¡A por la botella!‡¡A por la botella!‡Fuite de porto aux docks‡港口的麻烦‡港口的麻煩',
    nil,
    'O Operador de Grua Mafuá, em Vila Catraca, quer que você recupere a garrafa de Xerez de 99 Anos com Maluc Insano, que se refugiou na Caverna Ululante.‡Оператор крана Биггльфузз из Кабестана попросил вас отнять бутылку портвейна 99-летней выдержки у Безумного Магглиша, который прячется в Пещерах Стенаний.‡Kranführer Moppelfuzz in Ratschet möchte, dass Ihr Zausel dem Verrückten, der sich in den Höhlen des Wehklagens versteckt, die Flasche mit 99 Jahre altem Portwein wieder abnehmt.‡톱니항에 있는 기중기 기사 비글퍼즈가 통곡의 동굴에 숨어 있는 광기의 매글리시에게서 99년 숙성된 포트 포도주를 되찾아 달라고 부탁했습니다.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de Oporto con 99 años de antigüedad de Loco Magglish, que se esconde en las Cuevas de los Lamentos.‡El operador de grúa Pelardo de Trinquete quiere que le consigas una botella de Oporto con 99 años de antigüedad de Loco Magglish, que se esconde en las Cuevas de los Lamentos.‡Le grutier Bigglefuzz de Cabestan veut que vous repreniez la Bouteille de porto vieille de 99 ans à Magglish le Dingue, qui se cache dans les Cavernes des lamentations.‡棘齿城的起重机操作员比戈弗兹让你从疯狂的马格利什那儿取回一瓶99年波尔多陈酿，疯狂的马格利什就藏在哀嚎洞穴里。‡棘齒城的起重機操作員比戈弗茲讓你從瘋狂的馬格利什那兒取回一瓶99年波爾多陳釀，瘋狂的馬格利什就藏在哀嚎洞穴裡。',
  }
},
[960] = {
  {
    '‡Размышление Ону‡Onu meditiert‡‡Onus lo está meditando‡Onus lo está meditando‡Onu réfléchit‡安努正在沉思‡',
    nil,
    nil,
  }
},
[961] = {
  {
    '‡Размышление Ону‡Onu meditiert‡‡Onus lo está meditando‡Onus lo está meditando‡Onu réfléchit‡正在冥想的安努‡',
