},
[12784] = {
  {
    '‡Отчаянный поиск‡Verzweifelte Forschung‡필사적인 조사‡Investigación desesperada‡Investigación desesperada‡Recherche désespérée‡绝望的研究‡孤注一擲的研究',
    nil,
    '‡Поговорите с верховным аптекарем Гнилессом в новом аптекарском лагере на Террасе Света в Шаттрате.‡Sprecht mit Großapotheker Putress im neuen Apothekerlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새 연금술사 주둔지에서 대연금술사 퓨트리스와 대화해야 합니다.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Parlez au Grand apothicaire Putrescin, au nouveau Camp des Apothicaires sur la Terrasse de la Lumière à Shattrath.‡‡',
  }
},
[12785] = {
  {
    '‡Оргриммар‡Orgrimmar‡오그리마‡Orgrimmar‡Orgrimmar‡Orgrimmar‡奥格瑞玛‡奧格瑪',
    nil,
    '‡Верховный аптекарь Гнилесс просит вас отнести разрываемый на части мозг аптекарю Карлову в Оргриммар.‡Großapotheker Putress möchte, dass Ihr Apotheker Karlov in Orgrimmar das Zwei-Seuchen-Hirn bringt.‡‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Karlov en Orgrimmar.‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Karlov en Orgrimmar.‡Le Grand apothicaire Putrescin vous a demandé de donner le Cerveau doublement pestiféré à l\'Apothicaire Karlov à Orgrimmar.‡‡',
  }
},
[12786] = {
  {
    '‡Громовой Утес‡Donnerfels‡썬더 블러프‡Cima del Trueno‡Cima del Trueno‡Les Pitons-du-Tonnerre‡雷霆崖‡雷霆崖',
    nil,
    '‡Верховный аптекарь Гнилесс просит вас отнести разрываемый на части мозг аптекарю Чейни в Громовой Утес.‡Großapotheker Putress möchte, dass Ihr Apotheker Chaney in Donnerfels das Zwei-Seuchen-Hirn bringt.‡‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Chaney en Cima del Trueno.‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Chaney en Cima del Trueno.‡Le Grand apothicaire Putrescin vous a demandé d\'apporter le Cerveau doublement pestiféré à l\'Apothicaire Chaney aux Pitons-du-Tonnerre.‡‡',
  }
},
[12787] = {
  {
    '‡Подгород‡Die Unterstadt‡언더시티‡Entrañas‡Entrañas‡Fossoyeuse‡幽暗城‡幽暗城',
    nil,
    '‡Верховный аптекарь Гнилесс просит вас отнести разрываемый на части мозг опытному аптекарю Фаранеллу в Подгород.‡Großapotheker Putress möchte, dass Ihr Apothekermeister Faranell in Unterstadt das Zwei-Seuchen-Hirn bringt.‡대연금술사 퓨트리스가 언더시티에 있는 수석 연금술사 파라넬에게 이중 역병에 감염된 신체를 가져가 달라고 했습니다.‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al maestro boticario Faranell en Entrañas.‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al maestro boticario Faranell en Entrañas.‡Le Grand apothicaire Putrescin vous demande d\'apporter le Cerveau doublement pestiféré au Maître apothicaire Faranell à Fossoyeuse.‡‡',
  }
},
[12788] = {
  {
    '‡Луносвет‡Silbermond‡실버문‡Lunargenta‡Lunargenta‡Lune-d’Argent‡银月城‡銀月城',
    nil,
    '‡Верховный аптекарь Гнилесс просит вас отнести разрываемый на части мозг аптекарю Тепеш в Луносвет.‡Großapotheker Putress möchte, dass Ihr Apothekerin Tepesh in Silbermond das Zwei-Seuchen-Hirn bringt.‡대연금술사 퓨트리스가 실버문에 있는 연금술사 테페시에게 이중 역병에 감염된 신체를 가져가 달라고 했습니다.‡El gran boticario Putress quiere entregues el cerebro doblemente apestado a la boticaria Tepesh en la Ciudad de Lunargenta.‡El gran boticario Putress quiere entregues el cerebro doblemente apestado a la boticaria Tepesh en la Ciudad de Lunargenta.‡Le Grand apothicaire Putrescin vous a demandé de donner le Cerveau doublement pestiféré à l\'Apothicaire Tepesh à Lune-d\'Argent.‡‡',
  }
},
[12789] = {
  {
    'Para o Campo da Luz!‡В Разлом!‡Auf zur Bresche!‡빛의 틈으로!‡¡Cruzando la brecha!‡¡Cruzando la brecha!‡Dans la brèche !‡前往圣光据点！‡深入止境!',
    nil,
    'O Cruzado Valus, na Guarda da Luz, quer que você se apresente à Sargento Riannah, no Campo da Luz, que fica em Zul\'Drak.‡По распоряжению рыцаря Валуса из Опоры Света доложите о своем прибытии сержанту Рианне из Разлома Света в Зул\'Драке.‡Kreuzritter Valus bei der Lichtwarte möchte, dass Ihr Euch bei Unteroffizier Riannah in Lichtbresche in Zul\'Drak meldet.‡믿음의 빛 거점에 있는 성전사 발루스가 줄드락에 있는 빛의 틈으로 가서, 하사관 리안나에게 보고해 달라고 부탁했습니다.‡El cruzado Valus de Confianza de la Luz quiere que informes a la sargento Riannah en la Brecha de la Luz de Zul\'Drak.‡El cruzado Valus de Confianza de la Luz quiere que informes a la sargento Riannah en la Brecha de la Luz de Zul\'Drak.‡Le Croisé Valus de la Confiance de Lumière veut que vous vous présentiez auprès du Sergent Riannah à la Brèche de Lumière, dans Zul\'Drak.‡圣光之望礼拜堂的北伐军战士瓦鲁斯要你前往祖达克的圣光据点，向莉安娜中士报到。‡聖光之託的十字軍瓦魯思要你向瑞安娜中士報到，她就在祖爾德拉克的聖光止境。',
  }
},
[12790] = {
  {
    'Aprendendo a partir e retornar: o caminho mágico‡Как уйти и вернуться: магический путь‡Hin- und zurückkommen: mit Magie‡떠났다 돌아오는 법 익히기: 마법의 길‡Aprender a ir y a volver: la manera mágica‡Aprender a ir y a volver: la manera mágica‡Apprendre à partir et revenir : le chemin magique‡来去如风‡學習來去之法:魔法通道',
    nil,
    'A Arquimaga Celindra, do Portão Violeta, em Dalaran, quer que você use o Cristal de Teleporte para a Fortaleza Violácea e o Cristal de Teleporte para Dalaran.‡Воспользуйтесь кристаллом телепортации на Аметистовую заставу у Даларана и кристаллом телепортации в Даларан по просьбе верховного мага Селиндры из Даларана.‡Erzmagierin Celindra am Violetten Tor möchte, dass Ihr den Teleporter zum Kristall der Violetten Wacht und den Teleporter zum Dalarankristall verwendet.‡달라란의 보랏빛 관문에 있는 대마법사 셀린드라가 보랏빛 단으로 통하는 순간이동 수정과 달라란으로 통하는 순간이동 수정을 시험해 보라고 말했습니다.‡La archimaga Celindra de la Puerta Violeta en Dalaran quiere que utilices el cristal de teletransporte a El Confín Violeta y el cristal de teletransporte a Dalaran.‡La archimaga Celindra de la Puerta Violeta en Dalaran quiere que utilices el cristal de teletransporte a El Confín Violeta y el cristal de teletransporte a Dalaran.‡L\'Archimage Célindra à la Porte Pourpre à Dalaran vous a demandé d\'utiliser le Téléporteur vers le Cristal du Séjour pourpre et le Téléporteur vers le Cristal de Dalaran.‡达拉然紫罗兰之门的大法师塞琳德拉要求你使用通向达拉然下方废墟的传送水晶和通向达拉然的传送水晶。‡位於達拉然裡紫羅蘭之門的大法師瑟琳卓，希望你使用傳送至紫羅蘭看臺的水晶以及傳送至達拉然的水晶。',
  }
},
[12791] = {
  {
    'O reino mágico de Dalaran‡Магическое королевство Даларан‡Das magische Königreich Dalaran‡마법 왕국 달라란‡El reino mágico de Dalaran‡El reino mágico de Dalaran‡Le royaume magique de Dalaran‡魔法王国达拉然‡魔法王國達拉然',
    nil,
    'Leve o Sinete Kirin Tor à Arquimaga Celindra, no Portão Violeta, em Dalaran.‡Отнесите кирин-торский перстень верховному магу Селиндре к Аметистовым Вратам Даларана.‡Liefert das Signet der Kirin Tor bei Erzmagierin Celindra am Violetten Tor in Dalaran ab.‡달라란의 보랏빛 관문에 있는 대마법사 셀린드라에게 키린 토 인장을 보여줘야 합니다.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Donnez la Chevalière du Kirin Tor à l\'Archimage Célindra à la Porte Pourpre à Dalaran.‡将肯瑞托徽记之戒交给达拉然紫罗兰之门的大法师塞琳德拉。‡將祈倫托徽記交給位於達拉然裡紫羅蘭之門的大法師瑟琳卓。',
  }
},
[12792] = {
  {
    'Primeiro as coisas mais importantes‡Первым делом‡Das Wichtigste zuerst‡가장 먼저 해야 할 일‡Lo primero es lo primero‡Lo primero es lo primero‡Chaque chose en son temps‡紧急事务‡輕重緩急',
    nil,
    'O Comandante Kunz, na Fortaleza Argêntea, quer que você se apresente à Sargento Riannah no Campo da Luz.‡По поручению командира Кунца помогите сержанту Рианне в Разломе Света.‡Kommandant Kunz in der Argentumwacht möchte, dass Ihr Euch bei Unteroffizier Riannah in der Lichtbresche meldet.‡은빛십자군 격전지에 있는 사령관 쿤즈가 빛의 틈에 있는 하사관 리안나에게 보고하라고 부탁했습니다.‡El Comandante Kunz de El Confín Argenta quiere que te presentes ante la sargento Riannah en la Brecha de la Luz.‡El Comandante Kunz de El Confín Argenta quiere que te presentes ante la sargento Riannah en la Brecha de la Luz.‡Le Commandant Kunz au Séjour d\'Argent vous a demandé d\'aller rejoindre le Sergent Riannah à la Brèche de Lumière.‡银色前沿的指挥官库恩斯要你前往圣光据点，向莉安娜中士报到。‡銀白看臺的指揮官康茲要你向聖光止境的瑞安娜中士報到。',
  }
},
[12793] = {
  {
    'Fumaça no horizonte‡Дым на горизонте‡Rauch am Horizont‡지평선 위로 솟는 연기‡Humo en el horizonte‡Humo en el horizonte‡De la fumée à l\'horizon‡地平线上的硝烟‡地平線上的煙塵',
    nil,
    'Khufu, em Zim\'Torga, quer que você vá até o Campo da Luz e se apresente à Sargento Riannah.|n|nMaaka providenciará o transporte.‡По поручению Кхуфу из Зим\'Торги переговорите с сержантом Рианной в Разломе Света.|n|nМаака обеспечит вам безопасное путешествие.‡Khufu in Zim\'Torga möchte, dass Ihr zur Lichtbresche reist und Euch bei Unteroffizier Riannah meldet.|n|nMaaka wird Euch dorthin bringen.‡짐토르가에 있는 쿠푸가 빛의 틈으로 가서 하사관 리안나에게 보고하라고 했습니다.|n|n마아카에게 얘기하면 빛의 틈까지 가도록 조처해줄 것입니다.‡Khufu de Zim\'Torga quiere que viajes a la Brecha de la Luz y que te presentes ante la sargento Riannah.|n|nMaaka te proporcionará un transporte.‡Khufu de Zim\'Torga quiere que viajes a la Brecha de la Luz y que te presentes ante la sargento Riannah.|n|nMaaka te proporcionará un transporte.‡Khufu, dans Zim\'Torga, veut que vous vous rendiez à la Brèche de Lumière et que vous vous présentiez au Sergent Riannah.|n|nMaaka vous fournira le transport.‡希姆托加的巫医库弗要你前往圣光据点，向莉安娜中士报到。|n|n玛尔卡会向你提供必需的交通工具。‡辛托加的庫弗要你前往聖光止境向瑞安娜中士報到。|n|n瑪卡會把你送到那裡去。',
  }
},
[12794] = {
  {
    'O reino mágico de Dalaran‡Магическое королевство Даларан‡Das magische Königreich von Dalaran‡마법 왕국 달라란‡El reino mágico de Dalaran‡El reino mágico de Dalaran‡Le royaume magique de Dalaran‡魔法王国达拉然‡魔法王國達拉然',
    nil,
    'Leve o Sinete Kirin Tor à Arquimaga Celindra, no Portão Violeta, em Dalaran.‡Отнесите кирин-торский перстень верховному магу Селиндре к Аметистовым Вратам Даларана.‡Bringt der Erzmagierin Celindra am Violetten Tor in Dalaran das Signet der Kirin Tor.‡달라란의 보랏빛 관문에 있는 대마법사 셀린드라에게 키린 토 인장을 보여줘야 합니다.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Donnez la Chevalière du Kirin Tor à l\'Archimage Célindra à la Porte Pourpre à Dalaran.‡将肯瑞托徽记之戒交给达拉然紫罗兰之门的大法师塞琳德拉。‡將祈倫托徽記交給位於達拉然裡紫羅蘭之門的大法師瑟琳卓。',
  }
},
[12795] = {
  {
    'Ajuda a caminho‡На помощь заставе‡Farbe bekennen‡입장 표명‡Adoptar una postura‡Adoptar una postura‡Passons au séjour‡银色前沿‡前往看臺',
    nil,
    'Datura Sanguerrosa, no Posto Ébano, quer que você fale com o Comandante Falstaav na Fortaleza Argêntea.‡По поручению Датуры Кровавой Розы поговорите с командиром Фальштавом на Серебряной заставе.‡Datura Blutrose an der Schwarzen Wacht möchte, dass Ihr mit Kommandant Falstaav in der Argentumwache sprecht.‡칠흑의 감시초소에 있는 핏빛장미 다투라가 은빛십자군 격전지에 있는 사령관 팔스타브와 얘기해 보라고 부탁했습니다.‡Rosangre Datura en el Puesto de Vigilancia de Ébano quiere que hables con el comandante Falstaav en El Confín Argenta.‡Rosangre Datura en el Puesto de Vigilancia de Ébano quiere que hables con el comandante Falstaav en El Confín Argenta.‡Datura Rose-sang au Guet d\'Ébène veut que vous alliez parler au Commandant Falstaav au Séjour d\'Argent.‡黑锋哨站的血玫瑰达图拉要求你去跟银色前沿的指挥官法斯塔夫谈一谈。‡黯黑守望的血玫·達吐拉要你去跟銀白看臺的指揮官法爾斯戴夫談談。',
  }
},
[12796] = {
  {
    'O reino mágico de Dalaran‡Магическое королевство Даларан‡Das magische Königreich Dalaran‡마법 왕국 달라란‡El reino mágico de Dalaran‡El reino mágico de Dalaran‡Le royaume magique de Dalaran‡魔法王国达拉然‡魔法王國達拉然',
    nil,
    'Leve o Sinete Kirin Tor à Arquimaga Celindra, no Portão Violeta, em Dalaran.‡Отнесите кирин-торский перстень верховному магу Селиндре к Аметистовым Вратам Даларана.‡Liefert das Signet der Kirin Tor bei Erzmagierin Celindra am Violetten Tor in Dalaran ab.‡달라란의 보랏빛 관문에 있는 대마법사 셀린드라에게 키린 토 인장을 보여줘야 합니다.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Entrega el sello de Kirin Tor a la archimaga Celindra en la Puerta Violeta en Dalaran.‡Donnez la Chevalière du Kirin Tor à l\'Archimage Célindra à la Porte Pourpre à Dalaran.‡将肯瑞托徽记之戒交给达拉然紫罗兰之门的大法师塞琳德拉。‡將祈倫托徽記交給位於達拉然裡紫羅蘭之門的大法師瑟琳卓。',
  }
},
[12797] = {
  {
    'Retorno pelo pórtico‡Назад по Связующей спирали‡Zurück durchs Tor‡차원문을 통하여‡Vuelta a la puerta‡Vuelta a la puerta‡Retour par le portail d\'accès‡界门的回程‡由甬道之門返回',
    nil,
    'Leve a Runa Ômega ao Avatar de Freya nas Cachoeiras de Voz-da-chuva, que ficam na Bacia Sholazar.‡Принесите Аватаре Фрейи руну "Омега". Вы найдете Аватару в Низине Шолазар у водопадов Гласа Дождя.‡Bringt die Omegarune zum Avatar von Freya im Katarakt der Regenrufer im Sholazarbecken.‡숄라자르 분지의 구름몰이 여울목에 있는 프레이야의 화신에게 최후의 룬을 가져가야 합니다.‡Lleva la runa omega al avatar de Freya en los Rápidos Hablalluvia de la Cuenca de Sholazar.‡Lleva la runa omega al avatar de Freya en los Rápidos Hablalluvia de la Cuenca de Sholazar.‡Apportez la Rune Oméga à l\'Avatar de Freya aux Rapides Parlepluie, dans le Bassin de Sholazar.‡将欧米伽符文带回索拉查盆地的雨声河，交给弗蕾亚的化身。‡將終末符文帶回去休拉薩盆地交給雨頌者急湍的芙蕾雅化身。',
  }
},
[12798] = {
  {
    'Baralho de Espadas‡Карты Новолуния: колода Мечей‡Schwertkartenset‡다크문 검 카드 한 벌‡La baraja de Espadas‡La baraja de Espadas‡Suite d\'Épées‡长剑套牌‡眾劍套卡',
    nil,
    'Use o Baralho de Espadas para evocar uma Cartomante de Negraluna e entregue o baralho a ela.‡Призовите предсказателя судьбы с Ярмарки Новолуния и отдайте ему колоду Мечей.‡Beschwört mithilfe des Schwertkartensets einen Wahrsager des Dunkelmond-Jahrmarkts und gebt ihm das Set.‡검 카드 한 벌로 소환한 다크문 점술사에게 그 카드를 돌려줘야 합니다.‡Usa la baraja de Espadas para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Usa la baraja de Espadas para invocar a una clarividente de la Luna Negra y devuélveles la baraja.‡Utilisez la Suite d\'Épées pour invoquer une Diseuse de bonne aventure de la foire de Sombrelune et donnez-lui la suite.‡使用长剑套牌召唤一位暗月占卜师，并把套牌交给占卜师。‡使用眾劍套卡召喚一位暗月算命師，然後把套卡交給他。',
  }
},
[12799] = {
  {
    'Aprisionando os espíritos‡Сбор эктоплазмы‡Geister aufsaugen‡고대 영혼의 심령체‡Succionar a los espíritus‡Succionar a los espíritus‡Récupération d\'esprits‡吸取灵魂‡吸取靈魂',
    nil,
    'O Capitão Arnath, em Heb\'Valok, quer que você colete 5 Ectoplasmas Velhos dos Espíritos Drakkari Perdidos nos Poços de Zha\'Jin.‡Соберите 5 колб древней эктоплазмы от заблудших духов Драккари на озерах Жа\'Джина для капитана Арната из Хеб\'Валока.‡Hauptmann Arnath in Heb\'Valok möchte, dass Ihr 5 Einheiten uralten Ektoplasmas von den verlorenen Drakkarigeistern in den Teichen von Zha\'jin sammelt.‡헤브발로크에 있는 대장 아르나스가 자진의 웅덩이에 있는 길 잃은 드라카리 영혼을 처치하고 고대 심령체 5개를 모아 달라고 부탁했습니다.‡El capitán Arnath de Heb\'Valok quiere que consigas 5 ectoplasmas antiguos de los espíritus Drakkari perdidos en las Pozas de Zha\'Jin.‡El capitán Arnath de Heb\'Valok quiere que consigas 5 ectoplasmas antiguos de los espíritus Drakkari perdidos en las Pozas de Zha\'Jin.‡Le Capitaine Arnath à Heb\'Valok vous demande de récupérer 5 Ectoplasmes anciens d\'Esprits drakkari égarés aux Bassins de Zha\'Jin.‡赫布瓦罗的阿纳斯上尉要求你前往扎尔金之池，从迷失的达卡莱灵魂身上收集5份上古灵质。‡希伯伐洛克的阿爾納斯上尉要你去薩金之池從迷失的德拉克瑞靈魂身上收集5個上古魂能。',
  }
},
[12800] = {
  {
    'O comando do Lich Rei‡Приказ Короля-лича‡Befehl des Lichkönigs‡리치 왕의 명령‡La orden del Rey Exánime‡La orden del Rey Exánime‡Le dernier ordre du roi-liche‡巫妖王的命令‡巫妖王的命令',
    nil,
    'Apresente-se ao Comandante do Flagelo Thalanor no Engenho Assombrado.‡Найдите Командира Плети Таланора у лесопилки Бровача.‡Meldet Euch bei Geißelkommandant Thalanor bei Braumanns Mühle.‡브라우만 밀농장에 있는 스컬지 사령관 탈라노르에게 보고해야 합니다.‡Preséntate ante el comandante de la Plaga Thalanor en el Molino Cejifrente.‡Preséntate ante el comandante de la Plaga Thalanor en el Molino Cejifrente.‡Faites votre rapport au Commandant du Fléau Thalanor à la Scierie de Browman.‡向布洛米尔的天灾指挥官萨拉诺尔报到。‡到布洛米爾向天譴指揮官薩拉諾報到。',
  }
},
[12801] = {
  {
    'A luz da aurora‡Сияние Рассвета‡Das Licht der Morgendämmerung‡새벽의 빛‡La luz del alba‡La luz del alba‡La Lumière de l\'Aube‡黎明之光‡黎明曙光',
    nil,
    'Vença as forças da Aurora Argêntea e descubra a Luz da Aurora.|n|nApresente-se ao Grão-lorde Dárion Mograine, se você sobreviver.‡Разбейте войска Серебряного Рассвета и найдите Сияние Рассвета.|n|nЕсли вам удастся выжить, доложите о своей победе верховному лорду Дариону Могрейну.‡Besiegt die Streitkräfte der Argentumdämmerung und findet das Licht der Morgendämmerung.|n|nMeldet Euch bei Hochlord Darion Mograine, falls Ihr überleben solltet.‡은빛십자군 병력을 무찌르고 새벽의 빛을 드러내야 합니다.|n|n전투에서 살아남은 다음 대영주 다리온 모그레인에게 보고하십시오.‡Derrota las fuerzas de El Alba Argenta y descubre la luz de alba.|n|nInforma al alto señor Darion Mograine si sobrevives.‡Derrota las fuerzas de El Alba Argenta y descubre la luz de alba.|n|nInforma al alto señor Darion Mograine si sobrevives.‡Battez les forces de l\'Aube d\'argent et découvrez la Lumière de l\'Aube.|n|nSi vous survivez, faites votre rapport au Généralissime Darion Mograine.‡击败银色黎明的部队，揭开黎明之光的秘密。|n|n如果你活着从战场上归来，就去向大领主达里安·莫格莱尼复命。‡擊敗銀色黎明的部隊，並且發現黎明曙光。|n|n要是你成功活了下來，就向大領主達瑞安·莫格萊尼報告。',
  }
},
[12802] = {
  {
    'Com o coração na mão‡Мое сердце – в твоих руках‡Mein Herz liegt in Euren Händen‡그 손에 내 심장이‡Mi corazón está en tus manos‡Mi corazón está en tus manos‡Mon cœur est entre tes mains‡尽在掌控‡我心與你同在',
    nil,
    'Drakuru quer que você leve o Coração dos Antigos para ele na Passagem de Drak\'atal.|n|nColete 5 Mojos Desesperados para poder usar o Elixir de Drakuru lá.‡Дракуру просит вас принести Сердце древних на его пьедестал в Перевале Драк\'атала.|n|nНо сначала вам надо будет собрать 5 настоев безнадеги – иначе эликсир не сработает.‡Drakuru möchte, dass Ihr ihm das Herz der Uralten zur Drak\'atal Passage bringt.|n|nUm das Elixier verwenden zu können, müsst Ihr 5 verzweifelte Mojo sammeln.‡드라쿠루가 드라카탈 통로에 있는 그에게 선조의 심장을 가져와 달라고 부탁했습니다.|n|n그곳에 있는 단상에서 비약을 사용하려면 절망의 모조 5개를 모아야 합니다.‡Drakuru quiere que le lleves el corazón de los ancestros al Pasaje de Drak\'atal.|n|nTendrás que conseguir 5 mojos de desesperación para usar allí el elixir.‡Drakuru quiere que le lleves el corazón de los ancestros al Pasaje de Drak\'atal.|n|nTendrás que conseguir 5 mojos de desesperación para usar allí el elixir.‡Drakuru vous a demandé de lui rapporter le Cœur des anciens au Passage de Drak\'atal.|n|nVous allez devoir récupérer 5 Mojos désespérés pour utiliser l\'élixir sur place.‡达克阿塔小径的达库鲁要求你将古树精华宝石交给他。|n|n你还需要收集5份绝望魔精，才能在那里使用药剂。‡德拉庫魯需要你把先祖之心帶給他，就在德拉克托通道中。|n|n你要收集5個絕望魔精才能在那裡使用藥劑。',
  }
},
[12803] = {
  {
    'Força da Natureza‡Сила природы‡Naturgewalt‡자연의 힘‡Fuerza de la naturaleza‡Fuerza de la naturaleza‡Une force de la nature‡自然的力量‡自然之力',
    nil,
    'Vá ao Confim da Praga, entre as Cachoeiras de Voz-da-chuva e as Terras Perdidas, na Bacia Sholazar, e fale com o Avatar de Freya.‡Отправляйтесь на Увядшую поляну, расположенную между водопадами Гласа Дождя и Затерянными землями и найдите Аватару Фрейи.‡Begebt Euch zur Seuchenfront zwischen dem Katarakt der Regenrufer und den verlorenen Landen im Sholazarbecken und sucht den Avatar von Freya.‡숄라자르 분지의 구름몰이 여울목과 잃어버린 땅 사이에 있는 파멸의 역병지로 가서 프레이야의 화신을 찾아봐야 합니다.‡Ve a la Línea de Añublo, entre los Rápidos de Hablalluvia y las Tierras Perdidas en la Cuenca de Sholazar y busca al Avatar de Freya.‡Ve a La Línea de Añublo, entre los Rápidos de Hablalluvia y Las Tierras Perdidas en la Cuenca de Sholazar y busca al Avatar de Freya.‡Rendez-vous à la Ligne de la désolation, entre les Rapides Parlepluie et les Terres Perdues du Bassin de Sholazar, et cherchez l\'Avatar de Freya.‡前往索拉查盆地的荒芜边界，寻找弗蕾亚的化身。荒芜边界就在雨声河与迷失之地的交界处。‡前往介於休拉薩盆地之中，雨頌者急湍和失落之地之間的荒疫線，然後找出芙蕾雅的化身。',
  }
},
[12804] = {
  {
    'Um bife digno de um caçador‡Стейк, достойный охотника‡Ein Steak für Jäger‡진짜 사냥꾼 스테이크‡Un filete digno de un cazador‡Un filete digno de un cazador‡Un steak digne d\'un chasseur‡猎人们的肉排‡適合獵人的肉排',
    nil,
    'Traga 5 Bifes de Ruminalta para Korg, o Cutelo, no Acampamento do Rosarães.‡Принесите Коргу Тесаку в лагерь Эрнестуэя 5 стейков из длинношеего травояда.‡Bringt 5 Langhalsgrasfresser-Steaks zu Korg dem Spalter in Nesingwarys Basislager.‡긴목 기린 스테이크 5개를 네싱워리 주둔지에 있는 썰기의 달인 코르그에게 가져다주어야 합니다.‡Tráele 5 filetes de raspa Cuellolargo a Korg el Cuchilla en el Campamento Base de Nesingwary.‡Tráele 5 filetes de raspa Cuellolargo a Korg el Cuchilla en el Campamento Base de Nesingwary.‡Apportez 5 Steaks de Longs-cous à Korg le Fendeur, au Camp de base de Nesingwary.‡将5份食草长颈鹿肉排交给奈辛瓦里营地的菜刀库尔格。‡把5塊長頸食草者肉排帶回去奈辛瓦里營地給『斬擊者』寇爾格。',
  }
},
[12805] = {
  {
    'Salvando a força da vida‡Сохранение жизненной силы‡Einfangen von Lebenskraft‡생명의 힘 복구‡Recuperar la fuerza vital‡Recuperar la fuerza vital‡La préservation de la force vitale‡回收生命的力量‡搶救生命之力',
    nil,
    'O Avatar de Freya quer que você vá ao Estilhaço Partido, a sudeste, e use a Gema da Força Vital em 8 Elementais Sangue da Vida destruídos.‡По просьбе Фрейи отправляйтесь к Одинокому осколку на юго-восток и примените самоцвет жизненной силы к 8 уничтоженным элементалям жизненной силы.‡Der Avatar von Freya möchte, dass Ihr Euch zur Versprengten Scherbe im Südosten begebt und den Edelstein der Lebenskraft an 8 vernichteten Lebensblutelementaren verwendet.‡프레이야의 화신이 남동쪽에 있는 갈라진 수정동굴로 가서 파괴된 생명의 피 정령 8마리에게 생명의 피 보석을 사용해달라고 부탁했습니다.‡El Avatar de Freya quiere que vayas a El Fragmento Hendido al sureste y uses la gema fuerza de vida sobre 8 elementales sangrevida muertos.‡El Avatar de Freya quiere que vayas a El Fragmento Hendido al sureste y uses la gema fuerza de vida sobre 8 elementales sangrevida muertos.‡L\'Avatar de Freya veut que vous alliez à l\'Éclat scindé au sud-est, et que vous utilisiez la Gemme de force vitale sur 8 Élémentaires sang-de-vie détruits.‡弗蕾亚的化身要求你前往东南方的崩裂碎片，消灭8只源血元素，然后对它们的躯体使用源血宝钻。‡芙蕾雅要你去東南方的破碎裂片，在8個被摧毀的活血元素身上使用生命之力寶石。',
  }
},
[12806] = {
  {
    'A toda velocidade, rumo ao beiral!‡На Уступ Смерти со всех ног!‡Zur Todesanhöhe so schnell Ihr könnt!‡서둘러 가라, 죽음의 마루로!‡¡A Ascenso a toda prisa!‡¡A Ascenso a toda prisa!‡Se lever en toute hâte !‡全速赶往死亡高地！‡全速前往高地!',
    nil,
    'Apresente-se ao Lorde-comandante Arlote no Beiral da Morte, que fica na Coroa de Gelo.‡Отправляйтесь к лорду-командиру Арету на Уступ Смерти, что в Ледяной Короне.‡Meldet Euch bei Lordkommandant Arete auf der Todesanhöhe in Eiskrone.‡얼음왕관의 죽음의 마루에 있는 사령관 아레트 경에게 보고해야 합니다.‡Preséntate ante el lord comandante Arete en Ascenso de la Muerte, en Corona de Hielo.‡Preséntate ante el lord comandante Arete en Ascenso de la Muerte, en Corona de Hielo.‡Faites votre rapport au Seigneur-commandant Arete à la Cime de la Mort, dans la Couronne de glace.‡向死亡高地的高级指挥官埃雷特报到。‡到寒冰皇冠的死亡高崗找指揮統領艾睿特回報。',
  }
},
[12807] = {
  {
    'Inteirando-se da história...‡Немного истории...‡Was bis jetzt geschehen ist...‡지금까지 있었던 일은...‡La historia hasta ahora…‡La historia hasta ahora…‡Résumé des épisodes précédents…‡迄今为止的故事……‡至今的故事…',
    nil,
    'Escute a história do Lorde-comandante Arlote no Beiral da Morte.‡Выслушайте рассказ лорда-командира Арета на Уступе Смерти.‡Lauscht Lordkommandant Aretes Erzählung über die Todesanhöhe.‡죽음의 마루에 있는 사령관 아레트 경의 이야기를 들어야 합니다.‡Escucha la historia del lord comandante Arete en Ascenso de la Muerte.‡Escucha la historia del lord comandante Arete en Ascenso de la Muerte.‡Écoutez l\'histoire du Seigneur-commandant Arete à la Cime de la Mort.‡聆听死亡高地的高级指挥官埃雷特讲述的故事。‡在死亡高崗聽取指揮統領艾睿特的故事。',
  }
},
[12808] = {
  {
    '‡Вынужденный союз‡Eine verzweifelte Allianz‡필사적인 얼라이언스‡Una alianza desesperada‡Una alianza desesperada‡Une alliance désespérée‡绝望的联军‡孤注一擲的聯盟',
    nil,
    '‡Поговорите с епископом Лазарил в новом лагере Альянса на Террасе Света в Шаттрате.‡Sprecht mit Bischöfin Lazaril im neuen Allianzlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새로운 얼라이언스 주둔지에 있는 주교 라자릴과 대화해야 합니다.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Habla con el obispo Lazaril en el nuevo campamento de la Alianza en el Bancal de la Luz de Shattrath.‡Parlez à l\'Évêque Lazaril au Nouveau campement de l\'Alliance à la Terrasse de la Lumière, à Shattrath.‡‡',
  }
},
[12809] = {
  {
    '‡Стальгорн‡Eisenschmiede‡아이언포지‡Forjaz‡Forjaz‡Forgefer‡铁炉堡‡鐵爐堡',
    nil,
    '‡Епископ Лазарил просит вас отнести заряженный Светом артефакт главному механику Меггакруту в Стальгорн.‡Bischöfin Lazaril möchte, dass Ihr das lichterfüllte Artefakt zu Hochtüftler Mekkadrill in Eisenschmiede bringt.‡주교 라자릴이 아이언포지에 있는 땜장이왕 멕카토크에게 빛이 깃든 유물을 가져가 달라고 했습니다.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al Manitas Mayor Mekkatorque en Forjaz.‡El obispo Lazaril quiere que lleves el artefacto de luz imbuida al Manitas Mayor Mekkatorque en Forjaz.‡L\'Evêque Lazaril vous demande d\'apporter l\'Artéfact imprégné de Lumière au Grand Bricoleur Mekkanivelle à Forgefer.‡‡',
  }
},
[12810] = {
  {
    'Água Suja de Sangue‡Кровавая вода‡Blut im Wasser‡물속에서 피 찾기‡Sangre en el agua‡Sangre en el agua‡Du sang dans l\'eau‡水中之血‡水中之血',
    nil,
    'O Lorde-comandante Arlote, no Beiral da Morte, quer que você encha a Bexiga de Sangue com o sangue de 10 Tubarozes.‡Соберите кровь 10 прожорливых акул в бурдюк для крови и принесите его лорду-командиру Арету на Уступ Смерти.‡Lordkommandant Arete auf der Todesanhöhe möchte, dass Ihr die Blutblase mit dem Blut von 10 ausgehungerten Haien füllt.‡죽음의 마루에 있는 사령관 아레트 경이 포악한 귀상어 10마리의 피를 핏물 주머니에 채워오라고 했습니다.‡El lord comandante Arete en Ascenso de la Muerte quiere que llenes la vejiga de sangre con la sangre de 10 fauces voraces.‡El lord comandante Arete en Ascenso de la Muerte quiere que llenes la vejiga de sangre con la sangre de 10 fauces voraces.‡Le Seigneur-commandant Arete, à la Cime de la Mort,vous a demandé de remplir la Vessie de sang avec le sang de 10 Dents voraces de la mer.‡死亡高地的高级指挥官埃雷特要求你用10只饥饿的巨鲨的血装满血囊。‡死亡高崗的指揮統領艾睿特要你用血囊裝滿10隻極餓的大白鯊的鮮血。',
  }
},
[12811] = {
  {
    '‡Отчаянный поиск‡Verzweifelte Forschung‡필사적인 조사‡Investigación desesperada‡Investigación desesperada‡Recherche désespérée‡绝望的研究‡孤注一擲的研究',
    nil,
    '‡Поговорите с верховным аптекарем Гнилессом в новом аптекарском лагере на Террасе Света в Шаттрате.‡Sprecht mit Großapotheker Putress im neuen Apothekerlager auf der Terrasse des Lichts in Shattrath.‡샤트라스 내 빛의 정원에 있는 새 연금술사 주둔지에서 대연금술사 퓨트리스와 대화해야 합니다.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Habla con el gran boticario Putress en el nuevo Campamento de Boticarios en el Bancal de la Luz de Shattrath.‡Parlez au Grand apothicaire Putrescin, au nouveau Camp des Apothicaires sur la Terrasse de la Lumière à Shattrath.‡‡',
  }
},
[12812] = {
  {
    '‡Оргриммар‡Orgrimmar‡오그리마‡Orgrimmar‡Orgrimmar‡Orgrimmar‡奥格瑞玛‡奧格瑪',
    nil,
    '‡Верховный аптекарь Гнилесс просит вас отнести разрываемый на части мозг аптекарю Карлову в Оргриммар.‡Großapotheker Putress möchte, dass Ihr Apotheker Karlov in Orgrimmar das Zwei-Seuchen-Hirn bringt.‡‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Karlov en Orgrimmar.‡El gran boticario Putress quiere que entregues el cerebro doblemente apestado al boticario Karlov en Orgrimmar.‡Le Grand apothicaire Putrescin vous a demandé de donner le Cerveau doublement pestiféré à l\'Apothicaire Karlov à Orgrimmar.‡‡',
  }
},
[12813] = {
  {
    'Ergam-se dos cadáveres!‡Из праха восстаньте!‡Erhebt euch von den Toten!‡시체에서 생명을!‡¡De sus cadáveres se alzan!‡¡De sus cadáveres se alzan!‡Réanimez leurs cadavres !‡转化尸体‡從他們的屍體上復甦!',
    nil,
    'Setaal Reparadora Sombria, no Beiral da Morte, deu-lhe a Tintura da Reparadora Sombria. Aplique-a nos cadáveres de 10 unidades da Ofensiva Escarlate no Porto da Ofensiva.‡Возьмите настойку Темной Целительницы, которую дала вам Сетаал Темная Целительница на Уступе Смерти, и окропите тела любых 10 бойцов Алого Натиска, которых найдете.‡Setaal Dunkelheiler auf der Todesanhöhe hat Euch die Tinktur des Dunkelheilers gegeben. Träufelt sie auf 10 beliebige Leichen der Einheiten des Scharlachroten Ansturms, die Ihr im Hafen des Ansturms findet.‡죽음의 마루에 있는 세타알 다크멘더에게서 받은 다크멘더의 정기를 붉은돌격대 항구에 있는 붉은돌격대 시체 10구에 사용해야 합니다.‡Setaal Ensalmadora Oscura en Ascenso de la Muerte te ha dado la tintura de la Ensalmadora Oscura. Aplícasela a los cadáveres de 10 unidades cualesquiera de El Embate Escarlata en el Puerto del Embate.‡Setaal Ensalmadora Oscura en Ascenso de la Muerte te ha dado la tintura de la Ensalmadora Oscura. Aplícasela a los cadáveres de 10 unidades cualesquiera de El Embate Escarlata en el Puerto del Embate.‡Setaal Soignobscur à la Cime de la Mort vous a donné la Teinture du sombre réparateur. Appliquez-la sur les cadavres de 10 unités de l\'Assaut écarlate trouvées au Port de l\'Assaut.‡死亡高地的希塔尔·达克门德给了你一份达克门德的药剂，并要求你对先锋军港口一带的任意10具血色先锋军成员的尸体使用它。‡死亡高崗的瑟塔爾·暗癒者給了你暗癒者的酊劑。把它用在10具突襲軍港口的血色突襲軍屍體上。',
  }
},
[12814] = {
  {
    'Você vai precisar de um grifo‡Потребность в грифоне‡Ihr werdet einen Greifen brauchen‡그리핀이 필요할 텐데‡Necesitarás un grifo‡Necesitarás un grifo‡Vous aurez besoin d\'un griffon‡你需要狮鹫‡你會需要一頭獅鷲獸',
    nil,
    'Leve um Grifo da Ofensiva a Uzo Bradamorte no Beiral da Morte.‡Отведите грифона Алого Натиска к Узо Призывателю Смерти на Уступ Смерти.‡Bringt Uzo Todesrufer auf der Todesanhöhe einen Greifen des Ansturms.‡죽음의 마루에 있는 우조 데스콜러에게 붉은돌격대 그리핀을 가져다주어야 합니다.‡Lleva un grifo del Embate a Uzo Clamamuerte en Ascenso de la Muerte.‡Lleva un grifo del Embate a Uzo Clamamuerte en Ascenso de la Muerte.‡Amenez un Griffon de l\'Assaut à Uzo Mandemort à la Cime de la Mort.‡将一只先锋军狮鹫交给死亡高地的乌佐·唤亡者。‡將一頭突襲軍獅鷲獸送到死亡高崗的烏佐·喚死者手中。',
  }
},
[12815] = {
  {
    'Zona de voo restrito‡Закрытое воздушное пространство‡Flugsperrzone‡비행 금지 구역‡Espacio aéreo protegido‡Espacio aéreo protegido‡Zone d\'exclusion aérienne‡禁飞区‡禁航區',
    nil,
    'Uzo Bradamorte, no Beiral da Morte, quer que você mate 10 Cavalga-grifos da Ofensiva.‡Убейте 10 всадников на грифонах из Алого Натиска по распоряжению Узо Призывателя Смерти с Уступа Смерти.‡Uzo Todesrufer auf der Todesanhöhe möchte, dass Ihr 10 Greifenreiter des Ansturms tötet.‡죽음의 마루에 있는 우조 데스콜러가 붉은돌격대 그리핀 기수 10명을 처치해달라고 부탁했습니다.‡Uzo Clamamuerte en Ascenso de la Muerte quiere que mates a 10 jinetes de grifos del Embate.‡Uzo Clamamuerte en Ascenso de la Muerte quiere que mates a 10 jinetes de grifos del Embate.‡Uzo Mandemort, à la Cime de la Mort, vous demande de tuer 10 Chevaucheurs de griffons de l\'Assaut.‡死亡高地的乌佐·唤亡者要求你杀死10名先锋军狮鹫骑士。‡死亡高崗的烏佐·喚死者要你殺死10個突襲軍獅鷲騎士。',
  }
},
[12816] = {
  {
    'Investigação do Flagelo em Luaprata‡Нападение Плети на Луносвет‡Untersucht die Geißel bei Silbermond‡실버문의 스컬지 조사‡Investiga la Plaga de Lunargenta‡Investiga la Plaga de Lunargenta‡Enquêter au sujet du Fléau à Lune-d\'argent‡调查银月城的天灾入侵‡調查銀月城的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno de Luaprata e investigue os círculos rúnicos perto da base do Flagelo.‡Соберите три тусклых Некротических камня Плети, которые носит при себе нежить, откружившая Луносвет, и исследуйте светящиеся рунические круги вблизи лагеря Плети.‡Sammelt drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb von Silbermond und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers.‡실버문 외곽에 있는 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모으고, 스컬지 야영지 근처에서 빛나는 룬 마법진을 조사해야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Lunargenta e investiga los círculos rúnicos brillantes que hay cerca de su campamento.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de Lunargenta e investiga los círculos rúnicos brillantes que hay cerca de su campamento.‡Récupérez 3 Pierres nécrotiques pâles du Fléau à l\'extérieur de Lune-d\'argent et enquêtez à propos des Cercles runiques brillants près de leur campement.‡从银月城外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。‡從銀月城外的天譴軍團身上，收集三個暗淡的亡域之石，並調查它們營地附近發光的符文法陣。',
  }
},
[12817] = {
  {
    'Investigação do Flagelo na Exodar‡Нападение Плети на Экзодар‡Untersucht die Geißel bei der Exodar‡엑소다르의 스컬지 조사‡Investigar la Plaga de El Exodar‡Investigar la Plaga de El Exodar‡Enquêter au sujet du Fléau à l\'Exodar‡调查埃索达的天灾入侵‡調查艾克索達的天譴軍團',
    nil,
    'Colete três Pedras Necróticas Opacas dos membros do Flagelo no entorno da Exodar e investigue os círculos rúnicos brilhantes perto da base do Flagelo. Em seguida, fale novamente com o Tenente Kregor.‡Соберите три тусклых некротических камня созданий Плети, бродящих вокруг Экзодара, и изучите светящиеся рунические круги вокруг лагеря, после чего вернитесь к лейтенанту Крегору.‡Sammelt drei dunkle nekrotische Steine von den Dienern der Geißel außerhalb der Exodar und untersucht die leuchtenden Runenkreise in der Nähe ihres Lagers. Kehrt anschließend zu Leutnant Kregor zurück.‡엑소다르 외곽에 있는 스컬지를 처치하여 희미하게 빛나는 죽음의 돌 3개를 모으고, 스컬지 야영지 근처에서 빛나는 룬 마법진을 조사해야 합니다.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de El Exodar e investiga los círculos rúnicos brillantes que hay cerca de su campamento. Luego vuelve con el teniente Kregor.‡Recoge 3 piedras necróticas oscuras de la Plaga a las afueras de El Exodar e investiga los círculos rúnicos brillantes que hay cerca de su campamento. Luego vuelve con el teniente Kregor.‡Récupérez 3 Pierres nécrotiques pâles sur les membres du Fléau à l\'extérieur de l’Exodar et enquêtez sur les Cercles runiques brillants près de leur campement. Puis retournez voir le Lieutenant Kregor.‡从埃索达外面的天灾士兵身上收集3块暗淡的死灵石，并调查天灾营地附近的发光符文法阵。然后向克雷格尔上尉复命。‡從艾克索達外的天譴軍團身上，收集三個暗淡的亡域之石，並調查它們營地附近發光的符文法陣。然後回去找克瑞格中尉。',
  }
},
[12818] = {
  {
    'Limpar‡Сбор деталей‡Aufräumen‡폐품 줍기‡Limpieza‡Limpieza‡Nettoyage‡清理残骸‡清理',
    nil,
    'Zombo Curtomada em K3 quer 10 peças de Destroços Calcinados.‡Принесите Глуму Свечекруту в К-3 10 деталей из обугленных обломков.‡Jeer Funksockel auf dem K3 hätte gerne 10 verbrannte Trümmer.‡K3에 있는 지어 스파크소켓이 그을린 잔해 10개를 가져다 달라고 부탁했습니다.‡Jeer Encajebujía en K3 quiere 10 restos carbonizados.‡Jeer Encajebujía en K3 quiere 10 restos carbonizados.‡Gouaille Grilledouille à K3 vous a demandé 10 morceaux de Débris calcinés.‡K3的基尔·斯巴索克需要10份烧焦的零件。‡K3的吉爾·炫臼想要10塊燒焦的殘骸。',
  }
},
[12819] = {
  {
    'Virando a esquina‡Плевое дело‡Nur einen Minenwurf entfernt‡발조심‡A la vuelta de la esquina‡A la vuelta de la esquina‡Juste à côté‡雷区里的工具‡危機四伏',
    nil,
    'Zombo Curtomada, em K3, quer de volta as ferramentas dele que ficaram no campo minado.‡По поручению Глума Свечекрута из К-3 принесите инструменты Свечекрута с минного поля.‡Jeer Funksockel am K3 bittet Euch, dass Ihr Funksockels Werkzeuge aus seinem Minenfeld holt.‡K3에 있는 지어 스파크소켓이 그의 지뢰밭으로 가서 스파크소켓의 도구를 회수해 달라고 부탁했습니다.‡Jeer Encajebujía en K3 quiere que recuperes las herramientas de Encajebujía de su campo de minas.‡Jeer Encajebujía en K3 quiere que recuperes las herramientas de Encajebujía de su campo de minas.‡Gouaille Grilledouille, à K3, aimerait récupérer ses Outils de Grilledouille oubliés dans son champ de mines.‡K3的基尔·斯巴索克要你进入雷区，取回斯巴索克的工具。‡K3的吉爾·炫臼希望能從他的地雷區取回炫臼的工具。',
  }
},
[12820] = {
  {
    'Um toque delicado‡Осторожное прикосновение‡Zwölf auf einen Streich‡섬세한 작업‡Un toque delicado‡Un toque delicado‡Une délicate attention‡亲密接触‡精巧的手法',
    nil,
    'Ricket, em K3, quer que você use Minas Terrestres Aprimoradas na Perdição de Garm para rechaçar 12 atacantes de Garm. Tanto Invasores Garm quanto Seguidores Ceganeve contam.‡Рикет из К-3 просит вас воспользоваться усовершенствованными противопехотными минами на Побоище Гарма, чтобы оттеснить 12 противников: захватчиков из Гарма или последователей с Холмов Снежной Слепоты.‡Ricket in K3 wünscht, dass Ihr mithilfe der verbesserten Landminen Garms Bann vor 12 Angreifern verteidigt. Zu den Angreifern zählen Garmeindringlinge sowie schneeblinde Anhänger.‡K3에 있는 리켓이 가름의 파멸에 개량된 지뢰를 설치해, 가름에서 몰려오는 공격자 12마리를 막아 달라고 했습니다. 가름 침략자나 설맹의 추종자 중 아무나 처치하면 됩니다.‡Ricket en el K3 te ha pedido que uses minas terrestres mejoradas para matar a 12 invasores de Garm en Pesadilla de Garm. Tanto los invasores de Garm como los seguidores Veloneve cuentan.‡Ricket en el K3 te ha pedido que uses minas terrestres mejoradas para matar a 12 invasores de Garm en Pesadilla de Garm. Tanto los invasores de Garm como los seguidores Veloneve cuentan.‡Ricket, à K3, veut que vous utilisiez les Mines améliorées à Plaie-de-Garm pour repousser 12 Attaquants de Garm. Les Envahisseurs de Garm et les Suivants Brûleglace comptent comme attaquants.‡K3的莉吉特要求你前往加姆雷区，使用改进型地雷杀死12个从加姆方向冲过来的敌人。加姆入侵者和雪盲追随者都算数。‡K3的瑞基特要求你，在迦姆之禍用強化地雷抵擋12個來自迦姆的攻擊者。迦姆入侵者與雪盲跟隨者，都算在任務目標的攻擊者之內。',
  }
},
[12821] = {
  {
    'Bateria não inclusa‡Танго в тюремном блоке‡Zellenblocktango‡전지를 찾아라‡Cargados hasta la célula‡Célula faltante‡Le tango du pénitencier‡牢门探戈‡能量爆發',
    nil,
    'Ricket em K3 quer que você encontre a Célula de Energia do Transportador e use-a para ativar a Plataforma de Transporte na Ladeira de Garm.‡По поручению Рикет из К-3 разыщите батарею для телепортера и с ее помощью активируйте площадку телепортера у Подъема Гарма.‡Ricket am K3 möchte, dass Ihr den Transporterakku findet und damit die Transporterplatte in Garms Erhebung aktiviert.‡순간이동기 전원공급장치를 찾아 가름의 마루에 있는 순간이동 장치를 켠 후, K3에 있는 리켓에게 돌아가야 합니다.‡Ricket en K3 quiere que encuentres la célula de energía del teletransportador y la uses para activar la plataforma de teletransporte en Pesadilla de Garm.‡Ricket en K3 quiere que encuentres la célula de energía del teletransportador y la uses para activar la plataforma de teletransporte en Pesadilla de Garm.‡Ricket à K3 voudrait que vous localisiez la Batterie de télétransporteur et que vous l\'utilisiez pour activer la Plate-forme de téléportation à la Cime de Garm.‡K3的莉吉特要你去找到传送器能量晶格，并用它启动加姆高地的传送器。‡K3的瑞基特要你找出傳送器能量電池並用它來啟動迦姆高崗的傳送平臺。',
  }
},
[12822] = {
  {
    'Esqueça o medo‡Средство для устрашения‡Kenne keine Furcht‡두려움을 모르는 자‡Sin conocer el miedo‡Sin conocer el miedo‡N\'ayez pas peur‡无所畏惧‡不知恐懼為何物',
    nil,
    'Ricket em K3 quer que você mate 6 Vigias Garm e 8 Devotos Ceganeve‡По заданию Рикет из К-3 убейте 6 дозорных Гарма и 8 приверженцев с Холмов Снежной Слепоты.‡Ricket auf dem K3 möchte, dass Ihr 6 Garmwächter und 8 schneeblinde Anhänger tötet.‡K3에 있는 리켓이 가름 감시자 6마리와 설맹의 신자 8마리를 처치해 달라고 했습니다.‡Ricket en K3 quiere que mates a 6 vigías de Garm y a 8 devotos Veloneve.‡Ricket en K3 quiere que mates a 6 vigías de Garm y a 8 devotos Veloneve.‡Ricket à K3 vous demande de tuer 6 Guetteurs de Garm et 8 Fidèles brûleglace.‡K3的莉吉特要你去杀死6个加姆观察者和8个雪盲信徒。‡K3的瑞基特要你殺死6個迦姆看守者與8個雪盲誓徒。',
  }
},
[12823] = {
  {
    'Um plano infalível‡Безупречный план‡Ein perfekter Plan‡흠 없는 계획‡Un plan perfecto‡Un plan perfecto‡Un plan sans accroc‡完美的计划‡天衣無縫的計畫',
    nil,
    'Gino na Ladeira de Garm quer que você plante o Feixe Explosivo Compactado perto do Altar do Friatripa, mate Tormar Friatripa e fuja da caverna antes de ela desmoronar em cima de você.‡Джино у Подъема Гарма просит вас положить надежно перевязанный сверток со взрывчаткой у алтаря Хладонутра, убить Тормара Хладонутра и выбраться из пещеры до того, как она обрушится.‡Gino auf Garms Erhebung möchte, dass Ihr das dichtgepackte Sprengstoffbündel in der Nähe von Frostgeweides Altar anbringt und anschließend Tormar Frostgeweide tötet. Danach sollt Ihr entkommen, bevor die Höhle über Euch einbricht.‡프로스트거트의 제단 근처에 단단한 폭탄 묶음을 설치한 후, 토르마르 프로스트거트를 처치해야 합니다. 그러고 나면 동굴이 무너지기 전에 빠져나와 가름의 마루에 있는 지노에게 돌아가십시오.‡Gino en Alto de Garm quiere que coloques el fardo explosivo prieto cerca del Altar de Tripaescarcha, mates a Tormar Tripaescarcha y huyas de la cueva antes de que se hunda sobre tu cabeza.‡Gino en Alto de Garm quiere que coloques el fardo explosivo prieto cerca del Altar de Tripaescarcha, mates a Tormar Tripaescarcha y huyas de la cueva antes de que se hunda sobre tu cabeza.‡Gino à la Cime de Garm vous a demandé de placer le Paquet d\'explosifs durcis près de l\'Autel de Givrebide, de tuer Tormar Givrebide puis de vous échapper avant que la caverne ne s\'effondre sur vous.‡加姆高地的吉诺要你把重磅炸药包偷偷放到霜胆的祭坛附近，炸死塔尔玛·霜胆，然后在洞穴坍塌前逃出来。‡迦姆高崗的基諾，要你把硬盒裝爆裂物裝置在霜膽的祭壇附近，然後殺死托爾瑪·霜膽，在洞穴坍塌壓垮你之前逃出去。',
  }
},
[12824] = {
  {
    'Demolidor extraordinário‡Выдающийся подрывник‡Explosive Stimmung‡최고의 폭파병‡Experto en demoliciones‡Experto en demoliciones‡Artificier extraordinaire‡杰出的爆破专家‡傑出的爆破專家',
    nil,
    'Fale novamente com a Ricket em K3.‡Возвращайтесь к Рикет в К-3.‡Begebt Euch zu Ricket am K3.‡K3에 있는 리켓에게 돌아가야 합니다.‡Vuelve a Ricket en K3.‡Vuelve a Ricket en K3.‡Retournez voir Ricket à K3.‡回K3向莉吉特复命。‡回去K3找瑞基特。',
  }
},
[12825] = {
  {
    'Expressions of Gratitude‡Выражение благодарности‡Ein Zeichen des Dankes‡감사 표시‡Muestras de gratitud‡Muestras de gratitud‡Une preuve de gratitude‡Expressions of Gratitude‡表達謝意',
    nil,
    '[PLACEHOLDER] Use mini-plane to kamakazi on the gnoll leader.‡[PLACEHOLDER] Используйте мини-самолет с камикадзе на вождя гноллов.‡[PLACEHOLDER] Use mini-plane to kamakazi on the gnoll leader.‡[PLACEHOLDER]꼬마 비행기를 타고 놀 지도자인 카마카지에게 가야 합니다.‡[PLACEHOLDER] Use mini-plane to kamakazi on the gnoll leader.‡[PLACEHOLDER] Use mini-plane to kamakazi on the gnoll leader.‡[PLACEHOLDER] Utilisez les mini avions pour jouer les kamikazes sur le chef gnoll.‡[PLACEHOLDER] Use mini-plane to kamakazi on the gnoll leader.‡[PH]用迷你飛機神風特攻豺狼人領袖。',
  }
},
[12826] = {
  {
    'Ligeiramente instável‡Почти безопасны‡Leicht instabil‡불안정한 그녀‡Ligeramente inestable‡Ligeramente inestable‡Légèrement instable‡新型地雷‡輕微不穩定',
    nil,
    'Entregue as Minas Terrestres Aprimoradas do Zombo à Ricket, em K3.‡Отнесите усовершенствованные противопехотные мины Глума Рикет в К-3.‡Liefert Jeers verbesserte Landminen bei Ricket am K3 ab.‡지어가 만든 개량된 지뢰를 K3에 있는 리켓에게 배달해야 합니다.‡Llévale las minas terrestres mejoradas de Jeer a Ricket en K3.‡Llévale las minas terrestres mejoradas de Jeer a Ricket en K3.‡Apportez les Mines améliorées de Gouaille à Ricket à K3.‡把基尔的改进型地雷交给K3的莉吉特。‡把吉爾的強化地雷送去給K3的瑞基特。',
  }
},
[12827] = {
  {
    'Rações recuperadas‡Пополнение запасов провизии‡Rationen-Recycling‡식량 되찾기‡Raciones reclamadas‡Raciones reclamadas‡Vol de rations‡收集粮食‡回收乾糧再利用',
    nil,
    'Ricket em K3 quer que você retome 16 Rações de Gnoll Secas dos Gnolls da Colina Selvagem.‡По заданию Рикет из К-3 стащите 16 сухих пайков гноллов из ближайшего лагеря свирепых гноллов холмов.‡Ricket am K3 bittet Euch, 16 getrocknete Gnollmahlzeiten von den wilden Hügelgnollen in der Nähe zu beschaffen.‡K3에 있는 리켓이 주변의 야만의 언덕 놀들을 처치하고 말린 놀 휴대식량 16개를 모아 달라고 했습니다.‡Ricket en K3 quiere que recuperes 16 raciones de gnoll secas de los gnolls de Cerro Salvaje cercanos.‡Ricket en K3 quiere que recuperes 16 raciones de gnoll secas de los gnolls de Cerro Salvaje cercanos.‡Ricket à K3 vous demande de récupérer 16 Rations gnolles séchées sur les Gnolls de la colline Sauvage, qui se trouvent non loin.‡K3的莉吉特想让你从附近的野蛮岭豺狼人那里夺取16份豺狼人的干粮。‡K3的瑞基特，要你從附近的野生山丘豺狼人身上，回收16份風乾的豺狼人口糧。',
  }
},
[12828] = {
  {
    'Inspiração magnânima‡Полет вдохновения‡Welch Eingebung!‡대단한 발상‡Amplia inspiración‡Amplia inspiración‡Une grande inspiration‡突发奇想‡豐沛的靈感',
    nil,
    'Ricket em K3 quer que você pegue um C.M.O.R.R.E., use-o para explodir um mamute e pegue 8 pedaços de Carne Suculenta de Mamute.‡По просьбе Рикет из К-3 возьмите УРВР, убейте мамонта и принесите в К-3 8 больших кусков мяса мамонта.‡Ricket auf dem K3 möchte, dass ihr ein I.D.S.V. besorgt, damit ein Mammut in die Luft jagt und 8 Stücke herzhaftes Mammutfleisch einsammelt.‡U.D.E.D.를 획득해 매머드를 처치한 후, 기름진 매머드 고기 8개를 모아 K3에 있는 리켓에게 돌아가야 합니다.‡Ricket en K3 quiere que consigas un D.E.D.I., lo utilices con un mamut y traigas 8 trozos de carne de mamut.‡Ricket en K3 quiere que consigas un D.E.D.I., lo utilices con un mamut y traigas 8 trozos de carne de mamut.‡Ricket, à K3, veut que vous récupériez un T.E.M.O.R. Utilisez-le pour faire sauter un mammouth et récupérez 8 Viandes de mammouth copieuses.‡K3的莉吉特要你去拿取一颗D16限时炸弹，用它炸翻一头猛犸象，然后收集8块巨大的猛犸肉。‡K3的瑞基特要你拿一個U.D.E.D，然後用它把一頭長毛象炸碎，接著帶回8個營養的長毛象肉塊。',
  }
},
[12829] = {
  {
    'A mudança‡Перед тем, как входить‡Einrücken‡동굴 진출‡La entrada‡La entrada‡Installation‡进入矿洞‡上前線',
    nil,
    'Tori Chavencrenca, na entrada da Caverna da Teia de Cristal, quer que você mate 12 Aranhas da Caverna da Teia de Cristal.‡По заданию Торы Громыхалы у пещеры Хрустальной Паутины убейте 12 пауков в этой пещере.‡Tore Rumpelschlüssel vor der Kristallnetzhöhle möchte, dass Ihr 12 Kristallnetzspinnen tötet.‡수정그물 동굴 바깥에 있는 토어 럼블렌치가 수정그물 거미를 12마리 처치해 달라고 부탁했습니다.‡Tore Llavestruendo en la entrada de la Caverna Red de Cristal quiere que mates 12 arañas Red de Cristal.‡Tore Llavestruendo en la entrada de la Caverna Red de Cristal quiere que mates 12 arañas Red de Cristal.‡Tore Grondelevier à l\'extérieur de la Caverne de la Toile cristalline vous a demandé de tuer 12 Araignées de la Toile cristalline.‡水晶蛛网洞穴外的托莉·兰波维奇要你杀死12只水晶蛛网蜘蛛。‡晶網洞窟外面的托爾·滾鉗要你殺死12隻晶網蜘蛛。',
  }
},
[12830] = {
  {
    'Retomada do minério‡Изъятие руды‡Rückgewinnung des Erzes‡광석 회수‡Recuperación de mineral‡Recuperación de mineral‡Récupération de minerai‡收集矿石‡重新獲得礦石',
    nil,
    'Tori Chavencrenca na entrada da Caverna da Teia de Cristal quer que você pegue 5 amostras de Minério Impuro de Saronita.‡По просьбе Тор Громыхалы у пещеры Хрустальной Паутины соберите 5 образцов нечистой саронитовой руды.‡Tore Rumpelschlüssel vor der Kristallnetzhöhle hätte gerne, dass Ihr 5 Proben unreines Saroniterz sammelt.‡수정그물 동굴 바깥에 있는 토어 럼블렌치가 불순물이 섞인 사로나이트 광석 5개를 가져다 달라고 부탁했습니다.‡Tore Llavestruendo en la entrada de la Caverna Red de Cristal quiere que consigas 5 muestras de mena de saronita impura.‡Tore Llavestruendo en la entrada de la Caverna Red de Cristal quiere que consigas 5 muestras de mena de saronita impura.‡Tore Grondelevier à l\'extérieur de la Caverne de la Toile cristalline vous a demandé de récupérer 5 échantillons de Minerai de saronite impur.‡水晶蛛网洞穴外的托莉·兰波维奇要你去收集5份不纯的萨隆邪铁矿石。‡晶網洞窟外面的托爾·滾鉗，要你取回5個不純淨的薩鋼礦石樣本。',
  }
},
[12831] = {
  {
    'Apenas em parte esquecido‡Ядовитый укус‡Nur teilweise vergessen‡나를 잊었나요‡Olvidado solo en parte‡Olvidado solo en parte‡Seulement à moitié oublié‡未被遗忘‡只忘一半',
    nil,
    'Um dos Mineradores Goblin Feridos na Caverna da Teia de Cristal quer que você traga de volta a Vesícula de Peçonha de uma Rastejante Sincelária.‡Принесите раненому гоблину-рудокопу в пещере Хрустальной Паутины ядовитую железу ледяного ползуна.‡Ein verletzter Goblinminenarbeiter in der Kristallnetzhöhle möchte, dass Ihr ihm einen Eisspitzengiftbeutel von einer Eisspitzenspinne bringt.‡얼음침 거미에게서 얼음침 독주머니를 하나 구한 후, 수정그물 동굴에 있는 부상당한 고블린 광부에게 돌아가야 합니다.‡Un minero goblin herido en la Caverna Red de Cristal quiere que le traigas una glándula de veneno de hielopunta de un reptador de hielopunta.‡Un minero goblin herido en la Caverna Red de Cristal quiere que le traigas una glándula de veneno Hielopunta de un reptador Hielopunta.‡Un Mineur gobelin blessé à la Caverne de la Toile cristalline vous a demandé de lui apporter une Glande à venin pointeglace trouvée sur une Rampante pointeglace.‡水晶蛛网洞穴里的受伤的地精矿工希望你从冰尖爬行者身上找到一个冰尖毒囊。‡晶網洞窟中受傷的哥布林礦工要你從冰尖爬行者身上取得冰尖毒囊。',
  }
},
[12832] = {
  {
    'Partida amarga‡Побег‡Bittere Trennung‡쓰라린 출발‡Amarga partida‡Amarga partida‡Un départ amer‡痛苦的离别‡苦澀的啟程',
    nil,
    'Escolte um dos Mineradores Goblins Feridos até a saída da Caverna da Teia de Cristal e fale com a Ricket em K3.‡Проводите раненого гоблина-рудокопа из пещеры Хрустальной Паутины в К-3, а потом поговорите с Рикет.‡Begleitet den verletzten Goblinminenarbeiter aus der Kristallnetzhöhle und meldet Euch danach bei Ricket in K3.‡부상당한 고블린 광부를 호위해 수정그물 동굴을 빠져나간 후, K3에 있는 리켓과 이야기해야 합니다.‡Escolta al minero goblin herido fuera de la Caverna Red de Cristal y luego habla con Ricket en K3.‡Escolta al minero goblin herido fuera de la Caverna Red de Cristal y luego habla con Ricket en K3.‡Escortez le Mineur gobelin blessé hors de la Caverne de la Toile cristalline, puis parlez à Ricket à K3.‡护送受伤的地精矿工离开水晶蛛网洞穴，然后与K3的莉吉特谈一谈。‡護送受傷的哥布林礦工離開晶網洞窟，然後與K3的瑞基特交談。',
  }
},
[12833] = {
  {
    'Estoque em excesso‡Излишки‡Überbestand‡재고 과잉‡Suministros sobrantes‡Suministros sobrantes‡Surplus‡库存过剩‡存貨過多',
    nil,
    'Ricket, em K3, quer que você use Minas Terrestres Aprimoradas na Perdição de Garm para rechaçar os atacantes de Garm. Tanto Invasores Garm quanto Seguidores Ceganeve contam.‡Рикет из К-3 просит вас воспользоваться усовершенствованными противопехотными минами на Побоище Гарма, чтобы оттеснить захватчиков из Гарма и последователей с Холмов Снежной Слепоты.‡Ricket in K3 wünscht, dass Ihr mithilfe der verbesserten Landminen Garms Bann vor den Angreifern verteidigt. Zu den Angreifern zählen Garmeindringlinge sowie schneeblinde Anhänger.‡K3에 있는 리켓이 가름의 파멸에서 개량된 지뢰를 사용하여 가름에서 오는 공격자들을 방어해 달라고 부탁했습니다. 가름 침략자나 설맹의 추종자를 처치하면 됩니다.‡Ricket en el K3 te ha pedido que uses minas terrestres mejoradas para matar a los invasores de Garm en Pesadilla de Garm. Tanto los invasores de Garm como los seguidores Veloneve cuentan.‡Ricket en el K3 te ha pedido que uses minas terrestres mejoradas para matar a los invasores de Garm en Pesadilla de Garm. Tanto los invasores de Garm como los seguidores Veloneve cuentan.‡Ricket, à K3, veut que vous utilisiez les Mines améliorées à Plaie-de-Garm pour repousser les attaquants de Garm. Les Envahisseurs de Garm et les Suivants Brûleglace comptent comme attaquants.‡K3的莉吉特要求你前往加姆雷区，使用改进型地雷杀死12个从加姆方向冲过来的敌人。加姆入侵者和雪盲追随者都算数。‡K3的瑞基特要求你，在迦姆之禍用強化地雷抵擋來自迦姆的攻擊者。迦姆入侵者與雪盲跟隨者，都算在任務目標的攻擊者內。',
  }
},
[12834] = {
  {
    'Not Rain, Nor Snow, Nor Exploding Plane‡Ни дождь, ни снег, ни катастрофа‡Weder Regen noch Schnee noch explodierender Flieger‡Not Rain, Nor Snow, Nor Exploding Plane‡Ni lluvia, ni nieve, ni avión explotando‡Ni lluvia, ni nieve, ni avión explotando‡Ni la pluie, ni la neige, ni un avion qui explose‡Not Rain, Nor Snow, Nor Exploding Plane‡不是雨，也不是雪，也不是爆炸的飛機',
    nil,
    '[PLACEHOLDER] Test cold-weather bomber on giant.‡[PLACEHOLDER] Испытайте всепогодный бомбардировщик на великане.‡[PLACEHOLDER] Test cold-weather bomber on giant.‡[PLACEHOLDER] Test cold-weather bomber on giant.‡[PLACEHOLDER] Test cold-weather bomber on giant.‡[PLACEHOLDER] Test cold-weather bomber on giant.‡[PLACEHOLDER] Test bombardement temps froid sur géant.‡[PLACEHOLDER] Test cold-weather bomber on giant.‡[PH]對巨人測試冷天氣炸彈。',
  }
},
[12835] = {
  {
    'All Grown Up‡Все взрослые‡Voll ausgewachsen‡All Grown Up‡Maduro del todo‡Maduro del todo‡Déjà grand‡All Grown Up‡全部長大',
    nil,
    '[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PLACEHOLDER] Испытайте взрослого йормунгара на великане.‡[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PLACEHOLDER] Test Jormungar adulte sur géant‡[PLACEHOLDER] Test Grown Up Jormungar on Giant‡[PH]對巨人測試長大的蟄猛巨蟲',
  }
},
[12836] = {
  {
    'Gratidão manifesta‡Выражение благодарности‡Zeichen der Dankbarkeit‡감사의 표시‡Demostración de gratitud‡Demostración de gratitud‡Une preuve de gratitude‡感激之情‡表達謝意',
    nil,
    'Ricket em K3 quer que você mate Courosna.‡По заданию Рикет из К-3 убейте Кривошерста.‡Ricket am K3 möchte, dass Ihr Knarzfell tötet.‡K3에 있는 리켓이 옹이가죽을 처치해 달라고 부탁했습니다.‡Ricket en K3 quiere que mates a Tuercecuero.‡Ricket en K3 quiere que mates a Tuercecuero.‡Ricket à K3 veut que vous tuiez Peau-noueuse.‡K3的莉吉特要你去杀死瘤皮。‡K3的瑞基特要你殺死瘤皮。',
  }
},
[12837] = {
  {
    'Tore\'s Got the Goods‡У Тор есть все, что надо‡Tore hat die Waren‡Tore\'s Got the Goods‡Tore tiene el material‡Tore tiene el material‡Tore a les fournitures‡Tore\'s Got the Goods‡貨在托爾那',
    nil,
    '[PLACEHOLDER] Report to Tore‡[PLACEHOLDER] Явиться к Тор.‡[PLACEHOLDER] Meldet Euch bei Tore‡[PLACEHOLDER] Report to Tore‡[PLACEHOLDER] Report to Tore‡[PLACEHOLDER] Report to Tore‡[PLACEHOLDER] Faites votre rapport à Tore‡[PLACEHOLDER] Report to Tore‡[PH]向托爾回報',
  }
},
[12838] = {
  {
    'Trabalho da inteligência‡Сбор информации‡Informationsbeschaffung‡정보 수집‡Acumular inteligencia‡Acumular inteligencia‡Trouver des informations‡收集情报‡情報收集',
    nil,
    'Auroque Triste Sina, no Beiral da Morte, quer que você recolha 5 Documentos Internos da Ofensiva.‡Соберите 5 донесений разведки Алого Натиска по заданию Аурока Мрачного Проклятия с Уступа Смерти.‡Aurochs Grimmbann auf der Todesanhöhe möchte, dass Ihr 5 Geheimdokumente des Ansturms beschafft.‡죽음의 마루에 있는 오로크스 그림베인이 붉은돌격대 정보 문서 5개를 모아오라고 했습니다.‡Aurochs Ruina Sombría en Ascenso de la Muerte quiere que consigas 5 documentos de inteligencia de acometida.‡Aurochs Ruina Sombría en Ascenso de la Muerte quiere que consigas 5 documentos de inteligencia de acometida.‡Morneplaie des aurochs, à la Cime de la Mort, vous a demandé de récupérer 5 Documents de renseignement de l\'Assaut.‡死亡高地的奥卢克斯·邪鬃要求你去收集5份先锋军情报文档。‡死亡高崗的野牛·厲禍要你收集5份突襲軍情報文件。',
  }
},
[12839] = {
  {
    'O plano do grão-almirante‡Грандиозные планы верховного адмирала‡Der große Plan (des Admirals)‡총사령관의 총 계획‡El plan del gran almirante‡El plan del gran almirante‡Le grand plan de l\'amiral‡元帅的计划‡上將的偉大計畫',
    nil,
    'Entregue o Bilhete do Grão-almirante ao Lorde-comandante Arlote no Beiral da Morte.‡Отнесите письмо верховного адмирала лорду-командиру Аретy на Уступ Смерти.‡Bringt dem Lordkommandanten Arete auf der Todesanhöhe die Nachricht vom Großadmiral.‡총사령관의 쪽지를 죽음의 마루에 있는 사령관 아레트 경에게 전달해야 합니다.‡Lleva la nota del Gran Almirante al lord comandante Arete en Ascenso de la Muerte.‡Lleva la nota del Gran Almirante al lord comandante Arete en Ascenso de la Muerte.‡Remettez la Note du Grand Amiral au seigneur-commandant Arete à la Cime de la Mort.‡将韦斯温元帅的便笺交给死亡高地的高级指挥官埃雷特。‡將上將的信箋交給死亡高崗的指揮統領艾睿特。',
  }
},
[12840] = {
  {
    'Informação sigilosa‡Совершенно секретно‡Streng vertraulich‡극비 사항‡En estricta confidencia‡En estricta confidencia‡Que ça reste entre nous‡心腹的情报‡絕對機密',
    nil,
    'O Lorde-comandante Arlote, no Beiral da Morte, quer que você arranque a informação dos capitães Welsington e Hartford.‡Выбейте информацию из капитанов Вельсингтона и Хартфорда, убейте обоих и возвращайтесь к лорду-командиру Арету на Уступ Смерти.‡Lordkommandant Arete auf der Todesanhöhe möchte, dass Ihr Informationen aus den Kapitänen Welsington und Hartford herausprügelt.‡죽음의 마루에 있는 사령관 아레트 경이 선장 웰싱턴과 선장 하트포드에게서 정보를 캐내오라고 했습니다.‡El lord comandante Arete en Ascenso de la Muerte quiere que le saques información a los capitanes Welsington y Hartford.‡El lord comandante Arete en Ascenso de la Muerte quiere que le saques información a los capitanes Welsington y Hartford.‡Le Seigneur-commandant Arete, à la Cime de la Mort, vous a demandé d\'extirper l\'information des capitaines Welsington et Hartford.‡死亡高地的高级指挥官埃雷特要求你拷打维辛顿船长和哈弗德船长，并从他们口中得到情报。‡死亡高崗的指揮統領艾睿特要你從威辛頓船長和哈特弗德船長口中逼問出情報來。',
  }
},
[12841] = {
  {
    'A barganha da Bruxa Má‡Сделка с Каргой‡Der Handel der Alten‡마녀의 제안‡El trato de la vieja bruja‡El trato de la vieja bruja‡La proposition de la mégère‡女巫的交易‡巫婆的交易',
    nil,
    'Lok\'lira, a Velha, na Mina Esquecida, quer que você pegue as Runas dos Yrkvinn com a Feitora Syra.‡По просьбе Лок\'лиры Карги принесите ей в Заброшенный рудник руны Ирквинн, отобрав их у надзирательницы Сиры.‡Lok\'lira die Greisin in der verlassenen Mine möchte, dass Ihr Yrkvinns Runen von Aufseherin Syra holt.‡쓸쓸한 광산 안에 있는 마녀 로크리라가 감독관 시라를 처치하고 이르크빈의 룬을 되찾아 달라고 부탁했습니다.‡Lok\'lira la Vieja Bruja dentro de La Mina Desolada quiere que recuperes las Runas de los Yrkvinn de la sobrestante Syra.‡Lok\'lira la Vieja Bruja dentro de La Mina Desolada quiere que recuperes las Runas de los Yrkvinn de la sobrestante Syra.‡Lok\'lira la Mégère à l\'intérieur de la Mine Lugubre vous a demandé de récupérer les Runes des Yrkvinn que détient la Surveillante Syra.‡荒弃矿洞的女巫洛莉拉要求你从监督者希尔拉手中夺回伊克芬符文。‡凋落礦坑的『巫婆』洛莉拉要你從監督者塞拉手上把依爾克凡符文拿回來。',
  }
},
[12842] = {
  {
    'Forjando runas: preparativos para a batalha‡Ковка рун: подготовка к битве‡Runen schmieden: Vorbereitung auf den Kampf‡룬벼리기: 전투 준비‡Forja de runas: preparativos para la batalla‡Forja de runas: preparativos para la batalla‡La runeforge : se préparer à la bataille‡符文熔铸：战争的准备‡符文鑄造:準備作戰',
    nil,
    'O Instrutor Razúvio, na Fortaleza de Ébano, quer que você use sua habilidade de forjar runas para gravar uma runa à escolha na sua Laminalma Rúnica.|n|nVocê pode trocar a runa da sua arma a qualquer momento, bastando para isso estar próximo a uma Forja Rúnica.‡Инструктор Разувий из Черного оплота приказал вам выгравировать любую руну на вашем руническом клинке души.|n|nВыбранную гравировку можно заменить в любой момент, воспользовавшись ближайшей кузней рун.‡Instrukteur Razuvious in der Schwarzen Festung befiehlt Euch, mithilfe Eurer Fertigkeit \'Runen schmieden\' eine beliebige Rune in Eure runenbeschriebene Seelenklinge zu prägen.|n|nIhr könnt die Prägung auf Eurer Waffe jederzeit durch eine andere ersetzen, solange Ihr Euch in der Nähe einer Runenschmiede befindet.‡칠흑의 요새에 있는 훈련교관 라주비어스가 룬벼리기 기술을 사용해 룬문자 영혼검을 당신이 선택한 룬으로 장식하라고 했습니다.|n|n룬가열로 근처에 있다면 무기에 장식한 룬을 마음대로 바꿀 수 있습니다.‡El instructor Razuvious en El Bastión de Ébano te ha ordenado que uses tu forja de runas para blasonar tu hoja de alma rúnica con una runa [de tu elección].|n|nPuedes cambiar libremente el grabado de tu arma en cualquier momento mientras estés cerca de una forja de runas.‡El instructor Razuvious en El Bastión de Ébano te ha ordenado que uses tu forja de runas para blasonar tu hoja de alma rúnica con una runa [de tu elección].|n|nPuedes cambiar libremente el grabado de tu arma en cualquier momento mientras estés cerca de una forja de runas.‡L’Instructeur Razuvious du Fort d’Ébène, vous ordonne de vous rendre à une runeforge, et de vous servir de votre talent Runeforge pour graver une rune de votre choix sur votre Lame d’âme runique.|n|nVous pourrez la remplacer n’importe quand, tant que vous serez à proximité d’une runeforge.‡黑锋要塞的教官拉苏维奥斯命令你使用“符文熔铸”能力为你的符文之剑附上任意一种由你选择的符文。|n|n只要在符文熔炉旁，你就可以随意替换附着在武器上的符文种类，无需消耗任何材料。‡黯黑堡的講師拉祖維斯命令你用你的符文鑄造技能為你的符文魂刃刻上[你所選擇的]符文。|n|n只要有符文熔爐，你就可以隨時將刻在武器上的符文自由替換。',
  }
},
[12843] = {
  {
    'Levaram nossos homens!‡Они забрали наших мужчин!‡Sie haben unsere Männer!‡남자가 모자라!‡¡Se llevaron a nuestros hombres!‡¡Se llevaron a nuestros hombres!‡Elles ont pris nos hommes !‡她们把男人都抓走了！‡他們把男人抓走了!',
    nil,
    'Gretchen Saifaísca quer que você vá à Aldeia Sifreldar e resgate 5 Prisioneiros Goblins.‡По просьбе Гретхен Искрошип отправляйтесь в деревню Сифрельдар и спасите 5 плененных гоблинов.‡Gretchen Zischelfunken möchte, dass Ihr nach Sifreldar geht und 5 Goblingefangene befreit.‡시프렐다르 마을로 가 고블린 포로 5명을 구출한 후 그레첸 피즐스파크에게 돌아가야 합니다.‡Gretchen Chispeante quiere que vayas al Poblado Sifreldar y rescates a 5 prisioneros goblin.‡Gretchen Chispeante quiere que vayas al Poblado Sifreldar y rescates a 5 prisioneros goblin.‡Gretchen Pfutincelle vous demande d\'aller à Sifreldar et de secourir 5 Prisonniers gobelins.‡格莱奇·菲兹巴克要你前往希弗列尔达村，救出5名地精囚犯。‡格雷徹·嘶炫要你前往希弗爾達村並拯救5個哥布林囚犯。',
  }
},
[12844] = {
  {
    'Recuperação do equipamento‡Вернуть оборудование‡Ausrüstungsbergung‡장비 되찾기‡Recuperación de equipo‡Recuperación de equipo‡Récupération de l\'équipement‡夺回设备‡裝備回收',
    nil,
    'Gretchen Saifaísca quer que você consiga 8 peças do Equipamento de K3 na Aldeia Sifreldar a norte de K3.‡По просьбе Гретхен Искрошип принесите ей 8 предметов из снаряжения К-3, которые вы найдете в деревне Сифрельдар к северу от K-3.‡Gretchen Zischelfunken möchte, dass Ihr 8 Teile der K3-Ausrüstung aus Sifreldar holt, das nördlich des K3 liegt.‡K3 북쪽에 있는 시프렐다르 마을에서 K3 장비 8개를 되찾은 후 그레첸 피즐스파크에게 돌아가야 합니다.‡Gretchen Chispeante quiere que obtengas 8 piezas de equipo K3 en el Poblado Sifreldar al norte de K3.‡Gretchen Chispeante quiere que obtengas 8 piezas de equipo K3 en el Poblado Sifreldar al norte de K3.‡Gretchen Pfutincelle vous a demandé d\'obtenir 8 Equipements K3 à Sifreldar, au nord de K3.‡格莱奇·菲兹巴克要你前往K3北方的希弗列尔达村，找回8件K3设备。‡格雷徹·嘶炫要你到K3北邊的希弗爾達村收集8份K3裝備。',
  }
},
[12845] = {
  {
    '‡Даларанский кристалл телепортации: флаг‡Dalaran Teleport Crystal Flag‡순간이동 수정 이동 Flag‡Bandera de cristal de teletransporte a Dalaran‡Bandera de cristal de teletransporte a Dalaran‡Drapeau du cristal de téléportation à Dalaran‡达拉然传送水晶旗帜‡',
    nil,
    nil,
  }
},
[12846] = {
  {
    'Que nenhum goblin fique para trás‡Найти всех до единого...‡Lasst keinen Goblin zurück‡한 명도 포기할 수 없다‡Ningún goblin se queda atrás‡Ningún goblin se queda atrás‡Le gobelin manquant‡一个地精也不能少‡一個哥布林都不能少',
    nil,
    'Encontre a entrada da Mina Esquecida a norte da Aldeia Sifreldar e encontre pistas do paradeiro de Zeev Saifaísca.‡Разыщите вход в Заброшенный рудник на севере деревни Сифрельдар и попробуйте выяснить, где может быть Зив Искрошип.‡Findet den Eingang zu den verlassenen Minen im Norden von Sifreldar und sucht nach Hinweisen auf Zeev Zischelfunkens Aufenthaltsort.‡시프렐다르 마을 북부에서 쓸쓸한 광산의 입구를 찾아, 지브 피즐스파크의 행방에 관한 단서를 찾아야 합니다.‡Encuentra la entrada de la Mina Desolada al norte del Poblado Sifreldar y busca pistas del paradero de Zeev Chispeante.‡Encuentra la entrada de la Mina Desolada al norte del Poblado Sifreldar y busca pistas del paradero de Zeev Chispeante.‡Trouvez l\'entrée de la Mine Lugubre au nord du Village Sifreldar et cherchez des indices sur l\'endroit où se trouve Zeev Pfutincelle.‡前往希弗列尔达村的北部，找到荒弃矿洞的入口，并寻找西弗·菲兹巴克的下落。‡在希弗爾達村的北部找出凋落礦坑的入口，然後找出關於奇夫·炫嘶所在位置的線索。',
  }
},
[12847] = {
  {
    'Sem riscos‡Второй шанс‡Zweite Chancen‡두 번째 기회‡Segundas oportunidades‡Segundas oportunidades‡Secondes chances‡第二次机会‡第二次機會',
    nil,
    'Mate o Arcebispo Landgren e, em seguida, evoque o Portal de Arlote na presença do cadáver. Fale com o Lorde-comandante Arlote, no interior da Catedral Carmesim, assim que ele acabar o interrogatório.‡Убейте архиепископа Ландгрена и откройте Врата Арета рядом с трупом. Поговорите с лордом-командиром Аретом, когда тот закончит допрашивать дух архиепископа в Багровом соборе.‡Tötet Erzbischof Landgren und beschwört anschließend Aretes Tor in Gegenwart seiner Leiche. Sprecht mit Lordkommandant Arete im Hafen des Ansturms, sobald er sein Verhör mit dem Geist des Erzbischofs beendet hat.‡대주교 랜드그렌을 처치하고 그 시체가 사라지기 전에 아레트의 관문을 열어야 합니다. 대주교의 영혼에 질문을 마친 아레트 경과 진홍빛 성당에서 대화해야 합니다.‡Mata al arzobispo Landgren y luego invoca la Puerta de Arete en presencia de su cadáver. Habla con el lord comandante Arete dentro de la Catedral Carmesí cuando haya terminado su interrogatorio del espíritu del arzobispo.‡Mata al arzobispo Landgren y luego invoca la Puerta de Arete en presencia de su cadáver. Habla con el lord comandante Arete dentro de la Catedral Carmesí cuando haya terminado su interrogatorio del espíritu del arzobispo.‡Tuez le Grand abbé Langrain, puis invoquez la Porte d\'Arete en présence de son cadavre. Parlez au Seigneur-commandant Arete à l\'intérieur de la Cathédrale cramoisie une fois qu\'il aura questionné l\'esprit du grand abbé.‡杀死大主教兰德雷，并在他的尸体旁召唤出埃雷特之门。等高级指挥官埃雷特从大主教的灵魂那里拷问出情报以后，在赤色大教堂内与他谈一谈。‡殺死大主教蘭格瑞，然後在他的屍體旁召喚艾睿特之門。等指揮統領艾睿特訊問完大主教的靈魂之後，在赤紅大教堂與他交談。',
  }
},
[12848] = {
  {
    'A fome sem fim‡Вечный голод‡Der endlose Hunger‡끝없는 갈망‡El hambre sin fin‡El hambre sin fin‡La faim sans fin‡无尽的饥渴‡無邊飢渴',
    nil,
    'O Instrutor Razúvio, na Fortaleza de Ébano, quer que você liberte um Iniciado Indigno e, então, mate-o a sangue-frio!|n|nÉ a sua vida ou a dele!‡Инструктор Разувий из Черного оплота приказал вам освободить недостойного ученика и хладнокровно убить его!|n|nВыжить должен только один!‡Instrukteur Razuvious in der Schwarzen Festung befiehlt Euch, einen unwürdigen Initianden zu befreien und ihn kaltblütig umzubringen!|n|nEntweder ist es Euer oder ihr Leben!‡칠흑의 요새에 있는 훈련교관 라주비어스가 변변찮은 수습생을 풀어주고 가차없이 처치하라고 했습니다!|n|n실패하면 당신의 목숨이 위험합니다!‡El instructor Razuvious en El Bastión de Ébano te ha ordenado que liberes a un iniciado indigno y que ¡lo mates a sangre fría!|n|n¡Es tu vida o la suya!‡El instructor Razuvious en El Bastión de Ébano te ha ordenado que liberes a un iniciado indigno y que ¡lo mates a sangre fría!|n|n¡Es tu vida o la suya!‡L\'Instructeur Razuvious à Fort d\'Ébène vous a demandé de libérer un Initié indigne puis de tuer l\'Initié indigne de sang-froid !|n|nC\'est votre vie ou la sienne !‡黑锋要塞的教官拉苏维奥斯命令你释放一名黑锋叛徒，并击败他。|n|n不成功，则成仁。‡黯黑堡的講師拉祖維斯命令你釋放一個拙劣的新兵，然後冷血地殺死他!|n|n不是你死就是他們亡!',
  }
},
[12849] = {
  {
    'O poder do sangue, do gelo e do profano‡Сила крови, льда и нечестивости‡Die Macht des Blutes, des Frosts und der unheiligen Kraft‡혈기, 냉기, 부정의 힘‡El poder de la sangre, la escarcha y lo profano‡El poder de la sangre, la escarcha y lo profano‡Le pouvoir du sang, du givre et de l\'impie‡鲜血、冰霜与邪恶的力量‡血魄、冰霜與穢邪之力',
    nil,
    nil,
  }
},
[12850] = {
  {
    'Apresente-se ao comandante do Flagelo Thalanor‡Командир сил Плети Таланор‡Meldet Euch bei Geißelkommandant Thalanor‡스컬지 사령관 탈라노르에게 보고‡Preséntate ante el comandante de la Plaga Thalanor‡Preséntate ante el comandante de la Plaga Thalanor‡Rapport au commandant du Fléau Thalanor‡向天灾指挥官萨拉诺尔报到‡向天譴指揮官薩拉諾報到',
    nil,
    'Apresente-se ao Comandante do Flagelo Thalanor na sacada do primeiro andar da Fortaleza de Ébano.‡Найдите командира сил Плети Таланора на балконе первого этажа Черного оплота.‡Meldet Euch beim Geißelkommandanten Thalanor auf dem Balkon auf der ersten Ebene der Schwarzen Festung.‡칠흑의 요새 1층에 있는 발코니로 가서 스컬지 사령관 탈라노르에게 보고해야 합니다.‡Preséntate ante el comandante de la Plaga Thalanor en el balcón de la primera planta de El Bastión de Ébano.‡Preséntate ante el comandante de la Plaga Thalanor en el balcón de la primera planta de El Bastión de Ébano.‡Faites votre rapport au Commandant du Fléau Thalanor sur le balcon au premier étage du Fort d\'Ébène.‡向黑锋要塞第一层展望台上的天灾指挥官萨拉诺尔报到。‡向黯黑堡一樓陽台的天譴指揮官薩拉諾報到。',
  }
},
[12851] = {
  {
    'Não solta o urso‡Медвежья хватка‡Eiskalte Jagd‡곰을 타고‡La osa y la valerosa‡Una osa poderosa‡La pro de l’ours‡熊熊大作战‡騎上熊背',
    nil,
    'Brijana na Aldeia Brunnhildar quer que você monte em Presagelo e atire em 7 Geloworgs e 15 Gigantes de Gelo no Vale dos Antigos Invernos.‡По заданию Бриджаны из деревни Бруннхильдар оседлайте Ледоклыка и застрелите 7 снежных воргов и 15 снежных великанов в долине Древней Зимы.‡Brijana in Brunnhildar möchte, dass Ihr Eiszahn benutzt und 7 Frostworge und 15 Frostriesen im uralten Wintertal tötet.‡얼음송곳니를 타고 고대의 겨울 계곡에서 서리 검은늑대 7마리와 서리 거인 15명을 쏘아 맞힌 후, 브룬힐다르 마을에 있는 브리야나에게 돌아가야 합니다.‡Brijana en el Poblado Brunnhildar quiere que montes a Colmillo de Hielo y dispares a 7 huargos de escarcha y 15 gigantes de escarcha en el Valle de los Viejos Inviernos.‡Brijana en el Poblado Brunnhildar quiere que montes a Colmillo de Hielo y dispares a 7 huargos de escarcha y 15 gigantes de escarcha en el Valle de los Viejos Inviernos.‡Brijana à Brunnhildar vous a demandé de chevaucher Croc-de-glace et d\'abattre 7 Worgs de givre et 15 Géants du givre dans la Vallée des Anciens hivers.‡布伦希尔达村的布莉亚娜要求你骑着冰牙前往上古寒冬山谷，在那里射击7头冰霜座狼和15个冰霜巨人。‡布倫希爾達村的布瑞嘉娜，要你騎上冰牙到遠古寒冬山射擊7隻冰霜座狼以及15個冰霜巨人。',
  }
},
[12852] = {
  {
    'O esconderijo do Almirante foi revelado‡Поиски адмирала‡Den Admiral aufgespürt‡총사령관과 결판 내기‡El almirante descubierto‡El almirante descubierto‡L\'amiral à découvert‡元帅的下落‡揭露上將',
    nil,
    'O Lorde-comandante Arlote quer que você mate o Grão-almirante Zefirália. Fale novamente com o Lorde-comandante Arlote no Beiral da Morte após cumprir a missão.‡Убейте верховного адмирала Вествинда, а потом возвращайтесь к лорду-командиру Арету на Уступ Смерти.‡Lordkommandant Arete möchte, dass Ihr Euch um Großadmiral Westwind kümmert. Kehrt danach zum Lordkommandanten auf die Todesanhöhe zurück.‡사령관 아레트 경이 총사령관 웨스트윈드를 처치하고 죽음의 마루로 돌아와 대화하자고 했습니다.‡El lord comandante Arete quiere que te encargues del gran almirante Viento Oeste. Vuelve al Lord Comandante en Ascenso de la Muerte cuando lo hayas hecho.‡El lord comandante Arete quiere que te encargues del gran almirante Viento Oeste. Vuelve al Lord Comandante en Ascenso de la Muerte cuando lo hayas hecho.‡Le Seigneur-commandant Arete vous a demandé de tuer le Grand amiral Ponevent. Retournez voir le Seigneur-commandant à la Cime de la Mort quand la tâche est accomplie.‡高级指挥官埃雷特希望你去除掉巴利·韦斯温元帅。等你完成任务之后，回到死亡高地向他复命。‡指揮統領艾睿特要你解決韋斯溫上將。完成之後回到死亡高崗找指揮統領。',
  }
},
[12853] = {
  {
    'Refúgio exuberante!‡Поторопить события‡Luxusreise!‡호화로운 여행!‡¡Lujosa escapada!‡¡Lujosa escapada!‡Une escapade luxueuse !‡豪华的体验！‡華麗登場!',
    nil,
    'Fale com Zombo Curtomada em K3 nos Picos Tempestuosos.‡Поговорите с Глумом Свечекрутом в лаборатории К-3 в Грозовой Гряде.‡Sprecht mit Jeer Funksockel am K3 in den Sturmgipfeln.‡폭풍우 봉우리에 있는 K3로 가서 지어 스파크소켓과 대화해야 합니다.‡Habla con Jeer Encajebujía en K3 en las Cumbres Tormentosas.‡Habla con Jeer Encajebujía en K3 en las Cumbres Tormentosas.‡Allez voir Gouaille Grilledouille à K3, aux Pics Foudroyés.‡前往风暴峭壁的K3，与基尔·斯巴索克谈一谈。‡到風暴群山的K3找吉爾·炫臼談談。',
  }
},
[12854] = {
  {
    'No rastro de Brann‡По следам Бранна‡Auf Branns Spuren‡브란의 흔적을 찾아‡Tras la pista de Brann‡Tras la pista de Brann‡Sur les traces de Brann‡布莱恩的踪迹‡跟隨布萊恩的足跡',
    nil,
    'Recupere o Bilhete Embrulhado em Lona no acampamento de Brann e entregue-o ao Arqueólogo Andorin na Fortaleza Gelada.‡Заберите завернутую в мешковину записку из лагеря Бранна и возвращайтесь к археологу Андорину в Ледяную крепость.‡Beschafft die in Sackleinen gewickelte Notiz aus Branns Lager und bringt sie zu Archäologe Andorin in der Eisfestung.‡브란의 기지에서 온 삼베로 포장된 쪽지를 서리요새에 있는 고고학자 안도린에게 가져가야 합니다.‡Recupera la nota envuelta de arpillera del campamento de Brann y llévasela al Arqueólogo Andorin en Fuerte Escarcha.‡Recupera la nota envuelta de arpillera del campamento de Brann y llévasela al Arqueólogo Andorin en Fuerte Escarcha.‡Récupérez la Note enveloppée dans de la toile au bivouac de Brann et rapportez-la à l\'Archéologue Andorin à Fort du Givre.‡在布莱恩的营地中找到用麻布裹起来的便笺，把它交给冰霜堡的考古学家安多林。‡從布萊恩的營地取得粗麻包裹的信箋，然後交還給霜堡的考古學家安多林。',
  }
},
[12855] = {
  {
    'Farejando o criminoso‡Найти преступника‡Den Täter ausschnüffeln‡범죄 흔적을 좇아‡Encontrar al culpable‡Encontrar al culpable‡Renifler le coupable‡追踪罪犯‡嗅出犯人',
    nil,
    'Use a Coleira do Cão do Gelo no Acampamento Abandonado para rastrear quem quer que tenha se apoderado dos pertences de Brann. Quando recuperá-los, use o dispositivo de comunicação e fale com qualquer um que consiga contatar.‡Используйте ошейник северной гончей в Заброшенном лагере, чтобы выследить тех, кто забрал вещи Бранна. Когда вы их разыщете, включите переговорное устройство и свяжитесь с теми, с кем получится связаться.‡Nutzt das Frosthundhalsband im Verlassenen Lager um herauszufinden, wer Branns Habseligkeiten an sich genommen hat. Wenn Ihr sie finden konntet, setzt das Kommunikationsgerät ein und sprecht mit wem auch immer Ihr Kontakt bekommt.‡버려진 야영지에서 서리사냥개 목줄을 사용하여 브란의 소지품을 가진 자를 추적해야 합니다. 소지품을 찾은 다음, 장치를 사용해서 통신이 되는 이와 대화하십시오.‡Usa la collera de can de escarcha en el Campamento Abandonado para rastrear a quien se llevara las posesiones de Brann. Cuando las recuperes, usa el dispositivo de comunicación y habla con quienquiera que contactes.‡Usa la collera de can de escarcha en el Campamento Abandonado para rastrear a quien se llevara las posesiones de Brann. Cuando las recuperes, usa el dispositivo de comunicación y habla con quienquiera que contactes.‡Utilisez le Collier de molosse du givre au Camp abandonné pour suivre la piste des objets de Brann. Quand vous les aurez récupérés, utilisez l\'appareil de communication et contactez qui vous pouvez.‡在被遗弃的营地使用冰霜猎犬的项圈，查明是谁偷走了布莱恩的物品。找到这些东西之后，使用通讯装置与你所联系到的人进行交流。‡在廢棄營地使用冰霜獵犬項圈，追蹤拿走布萊恩所有物的傢伙。當你回收了物品，就使用通訊裝置聯絡你聯絡的到的人。',
  }
},
[12856] = {
  {
    'Frieza‡Холодные сердца‡Kaltherzig‡얼음 감옥‡Corazón helado‡Corazón helado‡Brisons la glace‡冰冷的心‡冰冷之心',
    nil,
    'Brijana, a leste da Aldeia Brunnhildar, quer que você voe até Dun Niffelem, liberte 3 Protodracos Capturados e resgate 9 Prisioneiras Brunnhildar.‡По заданию Бриджаны летите в Дун Ниффелем, освободите 3 пленных протодраконов, спасите 9 пленных бруннхильдарок и привезите их обратно, к востоку от деревни Бруннхильдар.‡Brijana gleich östlich von Brunnhildar möchte, dass Ihr nach Dun Niffelem fliegt, 3 gefangene Protodrachen befreit und 9 gefangene Brunnhildar rettet.‡브룬힐다르 마을의 동쪽에 있는 브리야나가 던 니펠렘으로 날아가 사로잡힌 원시비룡 3마리를 풀어주고, 브룬힐다르 포로 9명을 구출해 달라고 부탁했습니다.‡Brijana, justo en el este del Poblado Brunnhildar, quiere que vueles hasta Dun Niffelem, que liberes a 3 protodracos cautivas y rescates a 9 prisioneras Brunnhildar.‡Brijana, justo en el este del Poblado Brunnhildar, quiere que vueles hasta Dun Niffelem, que liberes a 3 protodracos cautivas y rescates a 9 prisioneras Brunnhildar.‡Brijana, à l\'est de Brunnhildar, veut que vous voliez jusqu\'à Dun Niffelem, que vous libériez 3 Proto-drakes captifs et que vous sauviez 9 Prisonnières de Brunnhildar.‡布伦希尔达村东边的布莉亚娜要你飞往丹尼芬雷，解救3头被俘虏的始祖幼龙，然后解救9名布伦希尔达囚犯。‡布倫希爾達村東邊的布瑞嘉娜要求你，飛去丹尼弗蘭，救出三個被俘虜的元龍和九位布倫希爾達囚犯。',
  }
},
[12857] = {
  {
    'Procura-se: Barbatana do Jubafúria‡Плавник Ярогрива‡Gesucht: Rachmähnes Flosse‡현상 수배: 맹위갈기의 물갈퀴‡Se busca: Aleta de Crines de Ira‡Se busca: Aleta de Crines de Ira‡Avis de recherche : Nageoire de Crin-de-rage‡悬赏：怒鬃的鳍肢‡懸賞: 怒鬃的蹼',
    nil,
    'Recupere a Barbatana do Jubafúria e depois a entregue ao Chefe Patafúria no Campo da Luz, em Zul\'Drak.‡Принесите плавник Ярогрива вождю Яростного Когтя в Разлом Света в Зул\'Драке.‡Beschafft Rachmähnes Flosse und bringt sie zu Häuptling Zornklaue in der Lichtbresche in Zul\'Drak.‡줄드락으로 가서 빛의 틈에 있는 족장 성난발톱에게 맹위갈기의 물갈퀴를 구해다 주어야 합니다.‡Consigue la aleta de Crines de Ira y llévasela al Jefe Garrafuria en la Brecha de la Luz en Zul\'Drak.‡Consigue la aleta de Crines de Ira y llévasela al Jefe Garrafuria en la Brecha de la Luz en Zul\'Drak.‡Récupérez la Nageoire de Crin-de-rage et rapportez-la au Chef Grifferage à la Brèche de Lumière à Zul\'Drak.‡得到怒鬃的鳍肢，将它交给圣光据点的怒爪酋长。‡取回怒鬃的蹼，然後交給祖爾德拉克中，聖光止境的怒爪酋長。',
  }
},
[12858] = {
  {
    'As peças do quebra-cabeça‡Кусочки головоломки‡Puzzleteile‡조각 맞추기‡Piezas del puzle‡Piezas del puzle‡Les pièces du puzzle‡拼图游戏‡謎團的拼圖',
    nil,
    'Reúna 6 Fragmentos de Disco do Inventor e use-os para montar o Disco do Inventor.‡Соберите 6 фрагментов диска изобретателя и сложите из них диск изобретателя.‡Sucht 6 Fragmente der Scheibe des Erfinders und setzt sie damit wieder zusammen.‡발명가의 원반 조각 6개를 모아 발명가의 원반을 만들어야 합니다.‡Reúne 6 fragmentos de disco de inventor y úsalos para ensamblar el disco de inventor.‡Reúne 6 fragmentos de disco de inventor y úsalos para ensamblar el disco de inventor.‡Rassemblez les 6 Fragments du disque de l\'inventeur et utilisez-les pour assembler le Disque de l\'inventeur.‡收集6块创世者的圆盘碎片，将它们组合成创世者的圆盘。‡收集六片發明者圓盤的碎片，將它們組成發明者圓盤。',
  }
},
[12859] = {
  {
    'Extra, extra: Fogo ainda quente!‡Негасимый огонь‡Das Allerneueste: Feuer noch immer heiß!‡따끈따끈한 소식: 아직도 불길은 활활!‡Noticias frescas: ¡el fuego sigue estando caliente!‡Noticias frescas: ¡el fuego sigue estando caliente!‡Nouvelle neuve : le feu ça brûle !‡火仍在烧！‡這個讚:火還很燙!',
    nil,
    'O Xamã Ancião Moky, no Campo da Luz, em Zul\'Drak, quer que você use o Extintor de Incêndio dos Patafúria para apagar o fogo de 15 cabanas no Covil Patafúria.‡Используйте огнетушитель Яростного Когтя, чтобы потушить 15 пожаров в логове Яростного Когтя по просьбе старого шамана Моки в Разломе Света в Зул\'Драке.‡Schamanenältester Moky in der Lichtbresche in Zul\'Drak möchte, dass Ihr mithilfe des Feuerlöschers der Zornklauen 15 Hüttenfeuer im Zornklauenbau löscht.‡줄드락, 빛의 틈에 있는 장로 주술사 모키가 성난발톱 소화기를 성난발톱 소굴에서 불이 난 오두막 15채에 사용하라고 부탁했습니다.‡El anciano chamán Moky en la Brecha de la Luz en Zul\'Drak quiere que uses el extintor Garrafuria para apagar 15 fuegos de cabañas en la Guarida Garrafuria.|n‡El anciano chamán Moky en la Brecha de la Luz en Zul\'Drak quiere que uses el extintor Garrafuria para apagar 15 fuegos de cabañas en la Guarida Garrafuria.|n‡L\'Ancien chaman Moky à la Brèche de Lumière à Zul\'Drak vous demande d\'utiliser l\'Extincteur grifferage pour éteindre 15 Feux de hutte à la Tanière grifferage.‡圣光据点的萨满长者莫奇希望你前往怒爪巢穴，使用怒爪灭火器扑灭15堆火焰。‡祖爾德拉克聖光止境的巫醫長老摩基要你用怒爪滅火器撲滅15個怒爪巢穴裡的著火小屋。',
  }
},
[12860] = {
  {
    'Prospecção de dados‡Сбор информации‡Daten schürfen‡정보 추출‡Extracción de datos‡Extracción de datos‡À la recherche de données‡采集数据‡資料探勘',
    nil,
    'Use o Disco do Inventor para obter 7 fragmentos de Dados Ocultos nos Bancos de Dados.‡Воспользуйтесь диском изобретателя, чтобы считать 7 фрагментов секретных данных из банков данных.‡Nutzt die Scheibe des Erfinders, um 7 Teile der versteckten Daten aus den Datenbanken zu beschaffen.‡발명가의 원반을 사용해 정보 저장고에서 숨겨진 정보 7 개를 찾아와야 합니다.‡Usa el disco de inventor para recuperar 7 juegos de datos ocultos de los bancos de datos.‡Usa el disco de inventor para recuperar 7 juegos de datos ocultos de los bancos de datos.‡Utilisez le disque de l\'inventeur pour récupérer 7 Fragments de données cachées dans les Banques de données.‡使用创世者的圆盘，从数据库中获得7条秘密数据。‡用發明者圓盤檢索7份在資料庫裡的隱藏資料。',
  }
},
[12861] = {
  {
    'Os troll tá tudo doido!‡Плохие тролли‡Die Trolle sind durchgedreht!‡트롤은 미쳤어!‡¡Los trols se han vuelto locos!‡¡Los trols se han vuelto locos!‡Les trolls ils ont tombé sur la tête !‡巨魔疯啦！‡食人妖發瘋啦!',
    nil,
    'O Chefe Patafúria, no Campo da Luz, quer que você use os "Abridores de Fechadura" de Drakuru, encontrados com vários trolls Drakuru, para libertar 8 Patafúrias Capturados.‡По заданию вождя Яростного Когтя из Разлома Света в Зул\'Драке отберите у троллей Дракуру необходимое количество "Отмычек" Дракуру и освободите 8 пойманных волчеров из стаи Яростного Когтя.‡Häuptling Zornklaue in der Lichtbresche in Zul\'Drak möchte, dass Ihr mithilfe der "Schlossöffner" von Drakuru, welche die verschiedenen Drakurutrolle bei sich tragen, 8 gefangene Zornklauen befreit.‡줄드락, 빛의 틈에 있는 족장 성난발톱이 드라쿠루 트롤에게서 구한 드라쿠루 "족쇄 따개"를 사용하여 사로잡힌 성난발톱일족 8명을 구해내라고 했습니다.‡El jefe Garrafuria en la Brecha de la Luz en Zul\'Drak quiere que uses los "abridores de cerraduras" Drakuru encontrados en varios trols Drakuru para liberar a 8 Garrafuria capturados.‡El jefe Garrafuria en la Brecha de la Luz en Zul\'Drak quiere que uses los "abridores de cerraduras" Drakuru encontrados en varios trols Drakuru para liberar a 8 Garrafuria capturados.‡Le Chef Grifferage à la Brèche de Lumière à Zul\'Drak vous demande d\'utiliser les Ouvre-serrures de Drakuru trouvés sur différents trolls Drakuru pour libérer 8 Grifferages capturés.‡祖达克圣光据点的怒爪酋长希望你使用从达库鲁巨魔身上找到的达库鲁“开锁器”，解救8名被俘虏的怒爪狼獾人。‡祖爾德拉克聖光止境的怒爪酋長要你用從不同食人妖身上拿到的德拉庫魯『開鎖器』解救八個怒爪囚犯。',
  }
},
[12862] = {
  {
    'Quando tudo mais falha‡Когда остается единственный выход...‡Wenn alles andere versagt‡모두 포기할 때‡Cuando todo lo demás falla‡Cuando todo lo demás falla‡Quand tout le reste a échoué…‡终极运输方案‡最後一招',
    nil,
    'Fale com Ricket para usar seu Dispositivo Propelido de Entrega D16 e adentrar os Picos Tempestuosos.‡Воспользуйтесь принадлежащим Рикет пропеллерным доставочным аппаратом Д16, чтобы продвинуться вглубь Грозовой Гряды.‡Sprecht mit Ricket, um mithilfe von Rickets D16-angetriebenem Lieferungsgerät tiefer in das Gebiet der Sturmgipfel vorzudringen.‡리켓과 이야기하면, D16 추진 발사 장치를 사용해 폭풍우 봉우리 깊숙이 들어갈 수 있습니다.‡Habla con Ricket para usar el Artefacto de entrega propulsado D16 para profundizar en Las Cumbres Tormentosas.‡Habla con Ricket para usar el Artefacto de entrega propulsado D16 para profundizar en Las Cumbres Tormentosas.‡Parlez à Ricket pour utiliser l\'Engin de livraison à propulsion D16 de Ricket afin de pénétrer au cœur des Pics Foudroyés.‡与莉吉特谈一谈，使用她的D16推进运载器进入风暴峭壁的深处。‡與瑞基特對話，並利用瑞基特的D16傳送推進裝置，深入風暴群山。',
  }
},
[12863] = {
  {
    'O agradecimento‡Большое спасибо‡Danksagung‡감사 표시‡Dar las gracias‡Dar las gracias‡Des remerciements‡表示感谢‡致謝',
    nil,
    'Leve o caixote de suprimentos médicos para Glorthal Barbadura na Fortaleza Gelada.‡Отнесите ящик с медикаментами Глорталу Жесткобороду из Ледяной крепости.‡Bringt Glorthal Steifbart in der Eisfestung die Kiste mit Heilvorräten.‡서리요새에 있는 글로살 스티프비어드에게 의약품 보급 상자를 가져가야 합니다.‡Lleva la caja de suministros médicos a Glorthal Barbatiesa en Fuerte Escarcha.‡Lleva la caja de suministros médicos a Glorthal Barbatiesa en Fuerte Escarcha.‡Apportez la caisse de Fournitures médicales à Glorthal Barberêche à Fort du givre.‡将医疗物资箱交给冰霜堡的格罗萨·硬须。‡把醫療補給箱交給霜堡的格洛梭·硬鬚。',
  }
},
[12864] = {
  {
    'Os batedores perdidos‡Пропавшие разведчики‡Vermisste Späher‡정찰병을 찾아라‡Exploradores desaparecidos‡Exploradores desaparecidos‡Les éclaireurs manquants‡失踪的斥候‡消失的斥候',
    nil,
    'Glorthal, na Fortaleza Gelada, solicitou uma busca no Vale de Bor e na Cascata de Bor por sinais dos Batedores Gelonatos perdidos.‡Обыщите долину Дыхания Бора и водопад Бора и попробуйте разыскать пропавших разведчиков из клана Зиморожденных.‡Glorthal in der Frostfestung hat darum gebeten, im Tal namens Bors Atem und bei Bors Sturz nach Anzeichen für die vermissten Späher der Frosterben zu suchen.‡서리요새에 있는 글로살이 보르의 숨결 계곡과 보르의 폭포 근처를 수색해 실종된 서릿결부족 정찰병의 흔적을 찾아달라고 요청했습니다.‡Glorthal en Fuerte Escarcha te ha pedido que busques en el valle del Aliento de Bor y en la Caída de Bor indicios de los exploradores Natoescarcha desaparecidos.‡Glorthal en Fuerte Escarcha te ha pedido que busques en el valle del Aliento de Bor y en la Caída de Bor indicios de los exploradores Natoescarcha desaparecidos.‡Glorthal, au Fort du Givre, vous a demandé d\'explorer la vallée du Souffle de Bor et la Chute de Bor en quête d\'une trace des Éclaireurs givre-nés disparus.‡冰霜堡的格罗萨要求你前往伯尔之息山谷和伯尔瀑布，搜寻失踪的霜脉斥候的踪迹。‡霜堡的格洛梭要求你，搜索伯爾之息河谷與伯爾瀑布，尋找失蹤霜誕斥候的蹤跡。',
  }
},
[12865] = {
  {
    'Companheiros leais‡Верные друзья‡Treue Gefährten‡충성스러운 동료‡Compañeros leales‡Compañeros leales‡Des compagnons loyaux‡忠诚的伙伴‡忠誠的夥伴',
    nil,
    'Fjorlin Cenhofrio, na Fortaleza Gelada, quer que você consiga 8 nacos de Carne Fresca de Rinoceronte do Gelo e use-os para alimentar as águias do Pico Crista de Gelo acima da cidade.‡По поручению Фьюрлина Ледоброва из Ледяной крепости добудьте 8 кусков свежего мяса люторога и покормите грозовестников, обитающих прямо над городом.‡Fjorlin Frostbraue in der Eisfeste möchte, dass Ihr 8 Stück frisches Rhinozerosfleisch beschafft und es an die Sturmspitzenadler auf den Gipfeln über der Stadt verfüttert.‡서리요새에 있는 피욜린 프로스트브로우가 신선한 얼음 코뿔소 고기 8개를 가져와서 폭풍마루에 있는 폭풍마루 독수리에게 먹여달라고 부탁했습니다.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que consigas 8 trozos de carne de rinoceronte de hielo fresca y los uses para alimentar a las águilas de Crestormenta que hay sobre la ciudad.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que consigas 8 trozos de carne de rinoceronte de hielo fresca y los uses para alimentar a las águilas de Crestormenta que hay sobre la ciudad.‡Fjorlin Front-de-givre, au Fort du Givre, veut que vous récupériez 8 tranches de Viande fraîche de rhinocéros des glaces, et que vous les utilisiez pour nourrir les Aigles foudrecrête qui nichent au-dessus de la ville.‡冰霜堡的弗亚林·霜眉希望你收集8块新鲜的冰犀牛肉，然后将它们喂食给小镇上方的雷羽鹰。‡在霜堡的弗尤林·霜眉要求你，獵取8片新鮮寒冰犀牛肉，並用來餵飽鎮上的風暴頂雄鷹。',
  }
},
[12866] = {
  {
    'Enfrentando os agressores‡Сопротивление агрессорам‡Den Aggressoren Einhalt gebieten‡하피 소탕‡Frenar a las agresoras‡Frenar a las agresoras‡Contenir les agresseurs‡震慑侵犯者‡擊退來犯者',
    nil,
    'Glorthal Barbadura, na Fortaleza Gelada, quer que você mate 8 Guinchadoras Penálgidas e 8 Feiticeiras Penálgidas.‡По заданию Глортала Жесткоборода из Ледяной крепости убейте 8 крикуний и 8 ведьм из стаи Ледяного Пера.‡Glorthal Steifbart in der Eisfestung möchte, dass Ihr 8 Frostfederkreischerinnen und 8 Frostfederhexen tötet.‡서리깃일족 비명소리 하피 8마리와 서리깃일족 마녀 8마리를 처치하고 서리요새에 있는 글로살 스티프비어드에게 돌아가야 합니다.‡Glorthal Barbatiesa en Fuerte Escarcha quiere que mates 8 estridadoras Plumaescarcha y 8 brujas Plumaescarcha.‡Glorthal Barbatiesa en Fuerte Escarcha quiere que mates 8 estridadoras Plumaescarcha y 8 brujas Plumaescarcha.‡Glorthal Barberêche au Fort du Givre veut que vous tuiez 8 Hurleuses givreplumes et 8 Sorcières givreplumes.‡冰霜堡的格罗萨·硬须希望你去杀死8个霜羽尖啸者和8个霜羽女巫。‡霜堡的格洛梭·硬鬚要你殺死8個霜羽尖嘯者以及8個霜羽女巫。',
  }
},
[12867] = {
  {
    'Ladras de filhotes‡Похитители птенцов‡Babydiebe‡알 도둑‡Ladrones de bebés‡Ladrones de bebés‡Voleurs de bébés‡偷宝宝的鹰身人‡偷嬰賊',
    nil,
    'Fjorlin Cenhofrio, na Fortaleza Gelada, quer que você traga 15 Ovos de Águia da Crista de Gelo.‡Принесите Фьюрлину Ледоброву из Ледяной крепости 15 яиц грозовестников.‡Fjorlin Frostbraue in der Eisfeste möchte, dass Ihr 15 Eier eines Sturmspitzenadlers zurückbringt.‡서리요새에 있는 피욜린 프로스트브로우가 폭풍마루 독수리 알 15개를 다시 가져와 달라고 부탁했습니다.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que le traigas 15 huevos de águila de Crestormenta.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que le traigas 15 huevos de águila de Crestormenta.‡Fjorlin Front-de-givre au Fort du Givre vous a demandé de lui rapporter 15 Œufs d\'aigles foudrecrêtes.‡冰霜堡的弗亚林·霜眉希望你交给他15枚雷羽鹰卵。‡霜堡的弗尤林·霜眉要你帶回15顆風暴頂鷹蛋。',
  }
},
[12868] = {
  {
    'Sirana Gritálgida‡Источник всех бед‡Sirana Eisschrei‡시라나 아이스슈리크‡Sirana Alarido de Hielo‡Sirana Alarido de Hielo‡Sirana Hurleglace‡希尔拉娜·冰啸‡西拉納·冰嘯',
    nil,
    'Glorthal Barbadura, na Fortaleza Gelada, quer que você mate Sirana Gritálgida.‡По просьбе Глортала Жесткоборода убейте Сирану Ледяной Вопль.‡Glorthal Steifbart in der Eisfestung möchte, dass Ihr Sirana Eisschrei tötet.‡시라나 아이스슈리크를 처치한 후, 서리요새에 있는 글로살 스티프비어드에게 돌아가야 합니다.‡Glorthal Barbatiesa en Fuerte Escarcha quiere que mates a Sirana Alarido de Hielo.‡Glorthal Barbatiesa en Fuerte Escarcha quiere que mates a Sirana Alarido de Hielo.‡Glorthal Barberêche au Fort du Givre veut que vous éliminiez Sirana Hurleglace.‡冰霜堡的格罗萨·硬须要求你去杀死希尔拉娜·冰啸。‡霜堡的格洛梭·硬鬚要你殺死西拉納·冰嘯。',
  }
},
[12869] = {
  {
    'Forçados ao extremo‡Все слишком далеко зашло‡Zu weit getrieben‡너무 밀어 붙였더니...‡Más allá del límite‡Más allá del límite‡Trop loin‡地盘之争‡逼人太甚',
    nil,
    'Fjorlin Cenhofrio, na Fortaleza, Gelada quer que você voe em uma Águia da Crista de Gelo e mate 16 Serpes do Pico das Tempestades nas Estepes do Sopé.‡По поручению Фьюрлина Ледоброва убейте с помощью грозовестника 16 змеев Грозовой Гряды в Подножии.‡Fjorlin Frostbraue in der Eisfestung möchte, dass Ihr auf einem Sturmspitzenadler 16 Sturmgipfelwyrm in den Fußmarschen niederstreckt.‡서리요새에 있는 피욜린 프로스트브로우가 폭풍마루 독수리를 타고 눈봉우리 분지로 가서 폭풍우 봉우리 고룡 16마리를 처치해 달라고 부탁했습니다.‡Fjorling Cejohelado en Fuerte Escarcha quiere que mates a 16 vermis de Las Cumbres Tormentosas en Las Estepas Inferiores.‡Fjorling Cejohelado en Fuerte Escarcha quiere que mates a 16 vermis de Las Cumbres Tormentosas en Las Estepas Inferiores.‡Fjorlin Front-de-givre veut que vous chevauchiez un Aigle foudrecrête et que vous tuiez 16 Wyrms foudrepics dans le Pied-mont.‡弗亚林·霜眉要你骑上雷羽鹰前往山底平原，杀死16条风暴峭壁巨龙。‡霜堡的弗尤林·霜眉要求你，騎乘一頭風暴頂雄鷹，並前往足跡冷原殺死16隻風暴巔巨龍。',
  }
},
[12870] = {
  {
    'Relíquias ancestrais‡Древние реликвии‡Uralte Relikte‡고대의 유물‡Reliquias antiguas‡Reliquias antiguas‡Reliques anciennes‡远古的圣物‡遠古聖物',
    nil,
    'Leve 10 Relíquias de Ulduar para Rork Queixofino na Fortaleza Gelada.‡Принесите Рорку Остробороду в Ледяную крепость 10 реликвий Ульдуара.‡Bringt 10 Relikte von Ulduar zu Rork Spitzkinn in die Eisfestung.‡서리요새에 있는 롤크 샤프친에게 울두아르의 유물 10개를 가져가야 합니다.‡Llévale 10 reliquias de Ulduar a Rork Barbilla Aguda en Fuerte Escarcha.‡Llévale 10 reliquias de Ulduar a Rork Barbilla Aguda en Fuerte Escarcha.‡Rapportez 10 Reliques d\'Ulduar à Rork Menton-pointu au Fort du Givre.‡将10件奥杜尔的圣物交给冰霜堡的洛尔克·锐须。‡把10個奧杜亞聖物帶去給霜堡的洛克·銳頦。',
  }
},
[12871] = {
  {
    'Ajuda da Liga dos Exploradores‡Помощь Лиги исследователей‡Hilfe von der Forscherliga‡탐험가 연맹으로부터의 원조‡Ayuda de la Liga de Expedicionarios‡Ayuda de la Liga de Expedicionarios‡De l\'aide de la Ligue des explorateurs‡探险者协会的帮助‡來自探險者協會的援助',
    nil,
    'Leve o Invólucro de Norgannon para Lagnus na Fortaleza Gelada.‡Отнесите оболочку Норганнона Лагнусу в Ледяную крепость.‡Bringt Norgannons Schale zu Lagnus in die Eisfestung.‡서리요새에 있는 라그누스에게 노르간논의 껍질을 가져가야 합니다.‡Lleva el caparazón de Norgannon a Lagnus en Fuerte Escarcha.‡Lleva el caparazón de Norgannon a Lagnus en Fuerte Escarcha.‡Apportez la Coque de Norgannon à Lagnus, au Fort du Givre.‡将诺甘农之壳交给冰霜堡的拉格努斯。‡帶著諾甘農之殼去霜堡找拉格努斯。',
  }
},
[12872] = {
  {
    'Invólucro de Norgannon‡Оболочка Норганнона‡Norgannons Schale‡노르간논의 껍질‡El caparazón de Norgannon‡El caparazón de Norgannon‡La coque de Norgannon‡诺甘农之壳‡諾甘農之殼',
    nil,
    'Obtenha o Invólucro de Norgannon com o Arquivista Mecaton.‡Заберите оболочку Норганнона у архивариуса Мехатона.‡Beschafft Euch Norgannons Schale von Archivar Mechaton.‡기록관 메카톤에게서 노르간논의 껍질을 되찾아야 합니다.‡Recupera el caparazón de Norgannon del archivista Mechaton.‡Recupera el caparazón de Norgannon del archivista Mechaton.‡Récupérez la Coque de Norgannon auprès de l\'Archiviste Mécaton.‡从档案员麦卡顿那里拿到诺甘农之壳。‡從管理員梅查頓那取回諾甘農之殼。',
  }
},
[12873] = {
  {
    'O Rei Gelonato‡Король Зиморожденных‡Der König der Frosterben‡서릿결부족의 왕‡El Rey Natoescarcha‡El Rey Natoescarcha‡Le roi des givre-nés‡霜脉矮人之王‡霜誕國王',
    nil,
    'Fale com Yorg Tempestocórdio na Fortaleza Gelada.‡Поговорите с Йоргом Грозовым Сердцем в Ледяной крепости.‡Sprecht mit Yorg Sturmherz in der Eisfestung.‡서리요새에 있는 요르그 스톰하트와 대화해야 합니다.‡Habla con Yorg Cuoretormenta en Fuerte Escarcha.‡Habla con Yorg Cuoretormenta en Fuerte Escarcha.‡Parlez au Roi Yorg Foudrecœur au Fort du Givre.‡与冰霜堡的约尔格·雷心谈一谈。‡與霜堡的約格·風暴之心交談。',
  }
},
[12874] = {
  {
    'Fervor do Gelonato‡Рвение Зиморожденного‡Eifer der Frosterben‡서릿결부족의 열정‡Fervor de los Natoescarcha‡Fervor de los Natoescarcha‡La ferveur du givre-né‡霜脉矮人的热情‡霜誕的熱情',
    nil,
    'Yorg Tempestocórdio na Fortaleza Gelada pediu para você falar com Fjorlin Cenhofrio para arranjar uma condução e encarar o desafio.‡По указанию Йорга Грозового Сердца из Ледяной Крепости поговорите с Фьюрлином Ледобровом, который организует вам поездку и назначит для вас испытание.‡Yorg Sturmherz in der Eisfestung hat Euch gebeten, mit Fjorlin Frostbraue zu sprechen und Euch der Herausforderung zu stellen.‡서리요새에 있는 요르그 스톰하트가 탈것을 확보하고 도전에 임하도록 피욜린 프로스트브로우와 대화해 달라고 부탁했습니다.‡Yorg Cuoretormenta en Fuerte Escarcha te ha pedido que hables con Fjorlin Cejohelado para conseguir un viaje y enfrentarte a tu desafío.‡Yorg Cuoretormenta en Fuerte Escarcha te ha pedido que hables con Fjorlin Cejohelado para conseguir un viaje y enfrentarte a tu desafío.‡Yorg Foudrecœur, au Fort du givre, vous a demandé de parler à Fjorlin Front-de-givre pour récupérer une monture et passer votre épreuve.‡冰霜堡的约尔格·雷心要你去和弗亚林·霜眉谈一谈，从他那里获得一匹坐骑，并迎接挑战。‡霜堡的約格·風暴之心要求你與弗尤林·霜眉交談，取得坐騎，並進行你的挑戰。',
  }
},
[12875] = {
  {
    'Um guia experiente‡Опытный проводник‡Ein erfahrener Führer‡숙련된 지도‡Un guía con experiencia‡Un guía con experiencia‡Un guide expérimenté‡经验丰富的向导‡經驗老到的導遊',
    nil,
    'Encontre Drom Toquegelo.‡Разыщите Дрома Ледохвата.‡Macht Drom Frostgriff ausfindig.‡드롬 프로스트그립을 찾아야 합니다.‡Encuentra a Drom Puño Helado.‡Encuentra a Drom Puño Helado.‡Localiser Drom Poignegivre.‡找到德鲁姆·霜握。‡找出德洛·霜握。',
  }
},
[12876] = {
  {
    'Convidados indesejáveis‡Нежеланные гости‡Unwillkommene Gäste‡환영받지 못한 손님‡Huéspedes no deseados‡Huéspedes no deseados‡Des invités indésirables‡不速之客‡不速之客',
    nil,
    'Fjorlin Cenhofrio na Fortaleza Gelada quer que você mate 10 Invasores Forjados em tempestade.‡По просьбе Фьюрлина Ледоброва убейте 10 погромщиков из клана Закаленных Бурей.‡Fjorlin Frostbraue in der Eisfestung möchte, dass Ihr 10 Sturmgeschmiedete Eindringlinge tötet.‡서리요새에 있는 피욜린 프로스트브로우가 폭풍우로 벼려낸 침략자 10명을 처치해달라고 부탁했습니다.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que mates a 10 invasores Tronaforjado.‡Fjorlin Cejohelado en Fuerte Escarcha quiere que mates a 10 invasores Tronaforjado.‡Fjorlin Front-de-givre au Fort du givre vous a demandé de tuer 10 Envahisseurs forge-foudre.‡冰霜堡的弗亚林·霜眉要你杀死10个雷铸铁矮人入侵者。‡霜堡的弗尤林·霜眉要你殺死10個風暴冶煉入侵者。',
  }
},
[12877] = {
  {
    'O vigia solitário‡Одинокий часовой‡Der einsame Wächter‡쓸쓸한 감시자‡El guardián solitario‡El guardián solitario‡Le guetteur solitaire‡孤独的守护者‡孤獨看守者',
    nil,
    'Recupere o Anel-sinete de Toquegelo com um Anão de Ferro e leve-o a Creteus nas Estepes do Sopé.‡Заберите у наблюдателя железных дворфов перстень-печатку Ледохвата и покажите его Кретею в Подножии.‡Beschafft Frostgriffs Siegelring von einem der Eisenzwergüberwacher und bringt ihn zu Creteus in den Fußmarschen.‡무쇠 드워프 감시자에게서 프로스트그립의 인장 반지를 구한 다음 눈봉우리 분지에 있는 크레테우스에게 가져가야 합니다.‡Recupera el sello Puño Helado de un amonestador enano férreo y llévaselo a Creteus en las Estepas Inferiores.‡Recupera el sello Puño Helado de un amonestador enano férreo y llévaselo a Creteus en las Estepas Inferiores.‡Reprenez la Chevalière de Poignegivre des mains d\'un Observateur nain de fer et apportez-la à Creteus dans le Pied-mont.‡从一个铁矮人监督者手中夺回德鲁姆·霜握的徽记之戒，并把它交给山底平原的克莱特乌斯。‡從鐵矮人監控者身上取回霜握的璽戒，然後帶去足跡冷原找克里圖思。',
  }
},
[12878] = {
  {
    'A relíquia oculta‡Спрятанная реликвия‡Das versteckte Relikt‡숨겨진 유물‡La reliquia oculta‡La reliquia oculta‡La relique cachée‡隐藏的圣物‡隱藏的聖物',
    nil,
    'Creteus, nas Estepes do Sopé, forneceu as informações necessárias para a localização do Núcleo de Norgannon.‡Найдите ядро Норганнона, руководствуясь информацией, которую дал Кретей в Подножии.‡Creteus in den Fußmarschen hat Euch Informationen zukommen lassen, mit deren Hilfe Ihr Norgannons Kern finden könnt. Macht Euch auf den Weg dorthin.‡눈봉우리 분지에 있는 크레테우스가 알려준 노르간논의 핵이 있는 위치로 가 노르간논의 핵을 회수하여 그에게 돌아가야 합니다.‡Creteus en Las Estepas Inferiores te ha proporcionado la información necesaria para encontrar el núcleo de Norgannon.‡Creteus en Las Estepas Inferiores te ha proporcionado la información necesaria para encontrar el núcleo de Norgannon.‡Creteus, dans le Pied-mont, vous a donné des informations qui vous permettent de localiser le Noyau de Norgannon.‡山底平原的克莱特乌斯已经把诺甘农之核的位置告诉了你。‡足跡冷原的克里圖斯，向你提供了關於找到諾甘農之核的資訊。',
  }
},
[12879] = {
  {
    'A fúria do Rei Gelonato‡Ярость короля Зиморожденных‡Zorn des Frosterbenkönigs‡서릿결부족 제왕의 분노‡La furia del rey Natoescarcha‡La furia del rey Natoescarcha‡La fureur du roi givre-né‡霜脉国王之怒‡霜誕國王之怒',
    nil,
    'Leve o Núcleo de Norgannon para Creteus nas Estepes do Sopé.‡Отнесите ядро Норганнона Кретею в Подножие.‡Bringt Norgannons Kern zu Creteus in die Fußmarschen.‡노르간논의 핵을 눈봉우리 분지에 있는 크레테우스에게 가져가야 합니다.‡Llévale el núcleo de Norgannon a Creteus en Las Estepas Inferiores.‡Llévale el núcleo de Norgannon a Creteus en Las Estepas Inferiores.‡Rapportez le noyau de Norgannon à Creteus au Pied-mont.‡将诺甘农之核交给山底平原的克莱特乌斯。‡把諾甘農之核帶回去給足跡冷原的克里圖斯。',
  }
},
[12880] = {
  {
    'O mestre-explorador‡Главный исследователь‡Der Meisterforscher‡대단한 탐험가‡El maestro expedicionario‡El maestro expedicionario‡L\'explorateur en chef‡探险大师‡探索大師',
    nil,
    'Leve o Núcleo de Norgannon para Brann Barbabronze no Maquinário dos Criadores.‡Отнесите ядро Норганнона Бранну Бронзобороду к Машине Творцов.‡Bringt Norgannons Kern zu Brann Bronzebart in die Maschine der Schöpfer.‡창조주의 기계에 있는 브란 브론즈비어드에게 노르간논의 핵을 가져가야 합니다.‡Llévale el núcleo de Norgannon a Brann Barbabronce en el Motor de los Creadores.‡Llévale el núcleo de Norgannon a Brann Barbabronce en el Motor de los Creadores.‡Rapportez le noyau de Norgannon à Brann Barbe-de-bronze au Moteur des Faiseurs.‡将诺甘农之核交给造物者引擎里的布莱恩·铜须。‡將諾甘農之核帶去造物者動力核心給布萊恩·銅鬚。',
  }
},
[12881] = {
  {
    'The Brothers Bronzebeard‡Братья Бронзобороды‡Die Gebrüder Bronzebart‡브란 브론즈비어드‡Los hermanos Barbabronce‡Los hermanos Barbabronce‡Les frères Barbe-de-bronze‡The Brothers Bronzebeard‡銅鬚兄弟',
    nil,
    nil,
  }
},
[12882] = {
  {
    'Relíquias ancestrais‡Древние реликвии‡Uralte Relikte‡고대의 유물‡Reliquias antiguas‡Reliquias antiguas‡Reliques anciennes‡远古的圣物‡遠古聖物',
    nil,
    'Leve 10 Relíquias de Ulduar para Olut Chopança no Local da Queda de Grom\'arsh.‡Отнесите 10 реликвий Ульдуара Олуту Пивобрюху на место крушения Гром\'арша.‡Ihr befindet Euch auf dieser Quest.‡그롬아쉬 추락 지점에 있는 올루트 알레구트에게 울두아르의 유물 10개를 가져가야 합니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[12883] = {
  {
    'Ordens de Drakuru‡Приказы Дракуру‡Befehle von Drakuru‡드라쿠루의 명령서‡Órdenes de Drakuru‡Órdenes de Drakuru‡Ordres de Drakuru‡达库鲁的命令‡德拉庫魯的命令',
    nil,
    'Entregue as Ordens de Drakuru ao Lorde Cruzado Lantinga no Campo da Luz, em Zul\'Drak.‡Отнесите приказы Дракуру главе рыцарей Лантинге в Разлом Света в Зул\'Драке.‡Bringt Drakurus Befehle zu Kreuzfahrerlord Lantinga in der Lichtbresche in Zul\'Drak.‡드라쿠루의 명령서를 줄드락, 빛의 틈에 있는 성전사 란틴가 경에게 가져가야 합니다.‡Lleva las órdenes de Drakuru al señor cruzado Lantinga en la Brecha de la Luz en Zul\'Drak.‡Lleva las órdenes de Drakuru al señor cruzado Lantinga en la Brecha de la Luz en Zul\'Drak.‡Rapportez les Ordres de Drakuru au Seigneur croisé Lantinga à la Brèche de Lumière à Zul\'Drak.‡将达库鲁的命令交给祖达克圣光据点的北伐军领主兰迪加。‡把德拉庫魯的命令拿給祖爾德拉克聖光止境的十字軍領主蘭迪加。',
  }
},
[12884] = {
  {
    'Posto Ébano‡Черная застава‡Die Schwarze Wacht‡칠흑의 감시초소‡El Puesto de Vigilancia de Ébano‡El Puesto de Vigilancia de Ébano‡Le guet d\'Ébène‡黑锋哨站‡黯黑守望',
    nil,
    'Entregue as Ordens de Drakuru a Stefan Vadu no Posto Ébano, em Zul\'Drak.‡Отнесите приказы Дракуру Стефану Ваду на Черную Заставу в Зул\'Драке.‡Liefert Drakurus Befehle bei Stefan Vadu in der Schwarzen Wacht in Zul\'Drak ab.‡드라쿠루의 명령서를 줄드락, 칠흑의 감시초소에 있는 스테판 바두에게 전달해야 합니다.‡Lleva las órdenes de Drakuru a Stefan Vadu en el Puesto de Vigilancia de Ébano en Zul\'Drak.‡Lleva las órdenes de Drakuru a Stefan Vadu en el Puesto de Vigilancia de Ébano en Zul\'Drak.‡Portez les Ordres de Drakuru à Stefan Vadu au Guet d\'Ébène à Zul\'Drak.‡将达库鲁的命令交给祖达克黑锋哨站的斯特凡·瓦杜。‡將德拉庫魯的命令送到祖爾德拉克黯黑守望的史戴芬·瓦度手上。',
  }
},
[12885] = {
  {
    'Os exilados de Ulduar‡Изгнанники Ульдуара‡Die Verbannten von Ulduar‡울두아르의 피난민‡Los exiliados de Ulduar‡Los exiliados de Ulduar‡Les exilés d\'Ulduar‡奥杜尔的流亡者‡奧杜亞的流亡者',
    nil,
    'Fale com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Поговорите с Глыбоскалом Камнетесом в Приюте Глыбоскала.‡Sprecht mit Bergfels dem Steinformer in Bergfels\' Zuflucht.‡바울더크랙의 은거처에 있는 돌조각장이 바울더크랙과 대화해야 합니다.‡Habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Parlez à Rochecombe le Sculpteroc au Refuge de Rochecombe.‡与布德克拉格庇护所的塑石者布德克拉格谈一谈。‡跟石崖避難所的『塑岩者』石崖談話。',
  }
},
[12886] = {
  {
    'O Drakkensryd‡Драконобойца‡Der Drakkensryd‡드라켄스리드‡El Drakkensryd‡El Drakkensryd‡Le Drakkensryd‡驭龙赛‡德拉坎舍試煉',
    nil,
    'Use o Arpão das Hyldnir para derrotar 10 Cavalga-dracos do Tornehylde no Templo das Tempestades. Use o Arpão das Hyldnir em um Ornamento de Coluna para sair do Drakkensryd e fale com Thorim quando obtiver êxito.‡Воспользуйтесь хильдским гарпуном, чтобы победить 10 наездниц на драконе Круга хильд в Храме Штормов, после чего выстрелите гарпуном в украшение на колонне и поговорите с Торимом.‡Verwendet die Hyldnirharpune, um 10 Drachenreiterinnen des Hildarthings im Tempel der Stürme zu besiegen. Wendet die Hyldnirharpune auf ein Säulenornament an, um den Drakkensryd zu verlassen. Sprecht anschließend mit Thorim, solltet Ihr erfolgreich gewesen sein.‡힐드니르 작살을 사용해 폭풍의 신전에서 힐드스미트 비룡기수 10명을 처치해야 합니다. 힐드니르 작살을 기둥 장식에 사용하여 드라켄스리드에서 빠져나온 다음 토림과 대화하십시오.‡Usa el arpón Hyldnir para derrotar a 10 jinetes de dracos de El Encuentro Hyldnir en el Templo de las Tormentas. Usa el arpón Hyldnir en un adorno de columna para salir del Drakkensryd y habla con Thorim cuando lo hayas conseguido.‡Usa el arpón Hyldnir para derrotar a 10 jinetes de dracos de El Encuentro Hyldnir en el Templo de las Tormentas. Usa el arpón Hyldnir en un adorno de columna para salir del Drakkensryd y habla con Thorim cuando lo hayas conseguido.‡Utilisez le Harpon hyldnir pour vaincre 10 Chevaucheuses de drake du Hyldsmeet au Temple des Tempêtes. Utilisez le Harpon hyldnir sur un Ornement de colonne pour quitter le Drakkensryd et parler à Thorim une fois la tâche accomplie.‡使用海德尼尔鱼叉，在风暴神殿击败10名海德比武会龙骑士。获胜后对装饰石柱使用海德尼尔鱼叉以完成驭龙赛，然后与托里姆谈一谈。‡用海迪尼爾魚叉打敗10個風暴神殿的海茲競技龍騎士。在圓柱裝飾上使用海迪尼爾魚叉，以離開德拉坎舍試煉，並於成功後，和索林姆對話。',
  }
},
[12887] = {
  {
    'Só diversão‡Непростая работа‡Nichts als Spaß und Spiele‡즐거운 장난‡Pura diversión‡Pura diversión‡Qu\'est-ce qu\'on se marre‡乐趣十足‡這是有趣的遊戲',
    nil,
    'Destrua o Oculário e, em seguida, apresente-se ao Barão Laska, na Abóbada das Sombras.‡Уничтожьте Глаз и переговорите с бароном Раздором в Мрачном Своде.‡Zerstört das Okular und erstattet danach Baron Splitter im Schattengewölbe Bericht.‡왕의 눈을 파괴하고 어둠의 무기고에 있는 남작 슬리버에게 보고해야 합니다.‡Acaba con El Ocular y luego informa al Barón Tajada en La Cámara de las Sombras.‡Acaba con El Ocular y luego informa al Barón Tajada en La Cámara de las Sombras.‡Détruisez l\'Oculaire et faites votre rapport au Baron Lesquille au Caveau des Ombres.‡摧毁魔眼，然后向暗影拱顶的斯利文男爵报告。‡破壞窺探之眼，然後向暗影穹殿的史力弗男爵回報。',
  }
},
[12888] = {
  {
    'METALL-E‡УБЕР-И‡SCHROTT-E‡고철이‡CHATARR-A‡CHATARR-A‡FERRAILL-E‡E型检修员‡廢料E號',
    nil,
    'Leve o Cartão de Acesso de METALL-E junto com 4 Punhados de Parafusos de Cobalto e 5 Capacitores Sobrecarregados para o METALL-E na Biblioteca do Inventor.‡Принесите в Библиотеку Изобретателя карту доступа к УБЕР-И, 4 пригоршни кобальтовых болтов и 5 перегруженных конденсаторов и попробуйте починить УБЕР-И.‡Bringt die Zugriffskarte für SCHROTT-E sowie 4 Hand voll Kobaltbolzen und 5 überladene Kondensatoren zu SCHROTT-E in die Bibliothek des Erfinders.‡고철이 접근 카드, 코발트 나사 한 줌 4개, 과충전된 축전기 5개를 발명가의 도서관에 있는 고철이에게 가져가야 합니다.‡Llévale la tarjeta de acceso de CHATARR-A junto a 4 puñados de tornillos de cobalto y 5 condensadores sobrecargados a CHATARR-A en la Biblioteca del Inventor.‡Llévale la tarjeta de acceso de CHATARR-A junto a 4 puñados de tornillos de cobalto y 5 condensadores sobrecargados a CHATARR-A en la Biblioteca del Inventor.‡Apportez la Carte d\'accès de FERRAILL-E, ainsi que 4 Poignées de boulons en cobalt et 5 Condensateurs surchargés à FERRAILL-E à la Bibliothèque de l\'inventeur.‡将E型检修员控制卡、4份钴螺丝和5份超载电容器交给创世者的图书馆中的E型检修员。‡將廢料E號操作卡、4把鈷藍螺栓、5個過載電容器帶到發明者圖書館裡的廢料E號。',
  }
},
[12889] = {
  {
    'O protótipo de console‡Панель управления прототипом‡Die Prototypenkonsole‡모형 조작대‡La consola prototipo‡La consola prototipo‡La console prototype‡原型机控制台‡原型控制臺',
    nil,
    'Interaja com o protótipo de console na Biblioteca do Inventor.‡Попробуйте разобраться с панелью управления прототипом в Библиотеке Изобретателя.‡Benutzt die Prototypenkonsole in der Bibliothek des Erfinders.‡발명가의 도서관에 있는 모형 조작대를 작동시켜야 합니다.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Utilisez la Console prototype à la Bibliothèque de l\'inventeur.‡使用创世者的图书馆中的原型机控制台。‡控制發明者圖書館內的原型控制臺。',
  }
},
[12890] = {
  {
    'If Size Mattered...‡Если размер имеет значение...‡Wenn Größe von Bedeutung wäre...‡If Size Mattered...‡Si el tamaño importara…‡Si el tamaño importara…‡Si la taille était importante‡If Size Mattered...‡要是大小重要的話……',
    nil,
    nil,
  }
},
[12891] = {
  {
    'Tenho uma ideia, mas antes...‡Воплощение идеи‡Ich habe da eine Idee, aber zuerst...‡좋은 생각은 있지만, 일단...‡Tengo una idea, pero primero…‡Tengo una idea, pero primero…‡J\'ai une idée mais d\'abord…‡我有一计……‡我有個點子，但首先……',
    nil,
    'O Barão Laska, na Abóbada das Sombras, pediu que você coletasse um Bastão do Sectário, um Gancho da Abominação, uma Corda de Geist e 5 Essências do Flagelo.‡Принесите скипетр сектанта, крюк поганища, веревку упыря и 5 эссенций Плети барону Раздору в Мрачный Свод.‡Baron Splitter im Schattengewölbe hat Euch gebeten, eine Kultistenrute, einen Monstrositätenhaken, ein Spukseil und 5 Geißelessenzen zu besorgen.‡어둠의 무기고에 있는 남작 슬리버가 이교도 지팡이와 누더기골렘 고리, 외눈깨비 밧줄과 스컬지 정수 5개를 구해달라고 부탁했습니다.‡El Barón Tajada en La Cámara de las Sombras te ha pedido que consigas una vara de cultor, un gancho de abominación, una cuerda Geist y 5 esencias de la Plaga.‡El Barón Tajada en La Cámara de las Sombras te ha pedido que consigas una vara de cultor, un gancho de abominación, una cuerda Geist y 5 esencias de la Plaga.‡Le Baron Lesquille, au Caveau des Ombres, vous a demandé de trouver un Bâtonnet de sectateur, un Crochet d\'abomination, une Corde de Geist et 5 Essences du Fléau.‡暗影拱顶的斯利文男爵要求你去收集一根教徒的魔棒、一根憎恶的弯钩、一条恶鬼的绳子和5份天灾精华。‡暗影穹殿的史力弗男爵要你收集一把教徒節杖、一個憎惡體之鉤、一條魂屍之繩、還有五個天譴精華。',
  }
},
[12892] = {
  {
    'Só diversão‡Непростая работа‡Nichts als Spaß und Spiele‡즐거운 장난‡Pura diversión‡Pura diversión‡Qu\'est-ce qu\'on se marre‡乐趣十足‡這是有趣的遊戲',
    nil,
    'Destrua o Oculário e, em seguida, apresente-se ao Barão Laska, na Abóbada das Sombras.‡Уничтожьте Глаз и переговорите с бароном Раздором в Мрачном Своде.‡Zerstört das Okular und erstattet Bericht bei Baron Splitter im Schattengewölbe.‡왕의 눈을 파괴하고 어둠의 무기고에 있는 남작 슬리버에게 보고해야 합니다.‡Acaba con El Ocular y luego informa al Barón Tajada en La Cámara de las Sombras.‡Acaba con El Ocular y luego informa al Barón Tajada en La Cámara de las Sombras.‡Détruisez l\'Oculaire puis faites votre rapport au Baron Lesquille au Caveau des Ombres.‡摧毁魔眼，然后向暗影拱顶的斯利文男爵报告。‡破壞窺探之眼，然後向暗影穹殿的史力弗男爵回報。',
  }
},
[12893] = {
  {
    'Liberar sua Mente‡Освобождение разума‡Befreit Euren Geist‡실력 발휘‡Libera tu mente‡Libera tu mente‡Libérez votre esprit‡解放你的思想‡解放你的心靈',
    nil,
    'O Barão Laska, na Abóbada das Sombras, quer que você use o Bastão Soberano nos cadáveres do Torpe, da lady Noctibosque e do Saltador.‡Подействуйте скипетром повеления на тела Злоба, леди Найтсвуд и Прыгуна, а потом возвращайтесь к барону Раздору в Мрачный Свод.‡Baron Splitter im Schattengewölbe möchte, dass Ihr den Herrschaftsstab auf die Leichen von Ekel, Lady Nachtwald und dem Springer anwendet.‡어둠의 무기고에 있는 남작 슬리버가 군주의 지팡이를 썩은내, 여군주 나이츠우드, 껑충이 시체에 사용해 달라고 했습니다.‡El Barón Tajada en La Cámara de las Sombras quiere que uses la vara soberana en los cadáveres de Vil, Lady Bosqueténebro y El Saltador.‡El Barón Tajada en La Cámara de las Sombras quiere que uses la vara soberana en los cadáveres de Vil, Lady Bosqueténebro y El Saltador.‡Le Baron Lesquille, au Caveau des Ombres, vous demande d\'utiliser le Bâtonnet souverain sur les cadavres de Vil, Dame Bois-de-nuit et Le Bondisseur.‡暗影拱顶的斯利文男爵希望你在劣尸维尔、奈丝伍德夫人和跳跃者的尸体上使用统治魔棒。‡暗影穹殿的史力弗男爵要求你，在暗邪、夜林女士與跳躍者的屍體上使用最高統治節杖。',
  }
},
[12894] = {
  {
    'Acampamento Avançado dos Cruzados‡Передовой лагерь рыцарей‡Lager der Kreuzfahrer‡십자군 전진기지‡El Puesto de Avanzada de los Cruzados‡El Puesto de Avanzada de los Cruzados‡Le camp avancé des croisés‡北伐军前线营地‡十字軍前進營地',
    nil,
    'Procure o Cruzado MacKellar no Campo Avançado dos Cruzados, em Zul\'Drak.‡Разыщите рыцаря Маккеллара в Передовом лагере рыцарей в Зул\'Драке.‡Sucht Kreuzfahrer MacKellar im Lager der Kreuzfahrer in Zul\'Drak auf.‡줄드락, 십자군 전진기지에 있는 성전사 맥켈라르를 찾아야 합니다.‡Busca al cruzado MacKellar en el Puesto de Avanzada de los Cruzados en Zul\'Drak.‡Busca al cruzado MacKellar en el Puesto de Avanzada de los Cruzados en Zul\'Drak.‡Allez trouver le Croisé MacKellar au Camp avancé des croisés à Zul\'Drak.‡在祖达克的北伐军前线营地寻找北伐军战士马克拉尔。‡在祖爾德拉克的十字軍前進營地中找到十字軍麥克凱拉。',
  }
},
[12895] = {
  {
    'O Barbabronze perdido‡Пропавший Бронзобород‡Der verschwundene Bronzebart‡브론즈비어드는 어디에‡El Barbabronce desaparecido‡El Barbabronce desaparecido‡Le Barbe-de-bronze manquant‡失踪的布莱恩·铜须‡失蹤的銅鬚',
    nil,
    'Encontre o Bilhete Embrulhado em Lona no acampamento de Brann e entregue-o a Boktar Furissangue no Local da Queda de Grom\'arsh.‡Заберите завернутую в мешковину записку из лагеря Бранна и возвращайтесь к Боктару Кровавому Безумию на место крушения Гром\'арша.‡Ihr befindet Euch auf dieser Quest.‡버려진 야영지에서 삼베로 포장된 쪽지를 찾아, 그롬아쉬 추락 지점에 있는 복타르 블러드퓨리에게 돌아가야 합니다.‡Estás en esta misión‡Estás en esta misión‡Vous effectuez cette quête‡你已经在做这个任务了‡你正在進行此任務',
  }
},
[12896] = {
  {
    'Se não conseguir convertê-lo...‡Последний аргумент‡Wenn man ihn nicht überzeugen kann‡마음을 돌릴 수 없다면‡Si no puede ser transformado‡Si no puede ser transformado‡S\'il ne peut pas être détourné…‡顽固的敌人‡如果無法感化他',
    nil,
    'Derrote o General Halonegro e, em seguida, informe o seu sucesso a Thassarian, a bordo do Rompe-céus.‡Убейте генерала Погибель Света и доложите об исполнении Тассариану на борту "Усмирителя небес".‡Besiegt General Lichtbann und informiert anschließend Thassarian an Bord der Himmelsbrecher über Euren Erfolg.‡장군 라이츠베인을 무찌르고 비행포격선인 하늘파괴자호에 있는 타사리안에게 돌아가 승전보를 알려야 합니다.‡Derrota al general Aterraluz e informa de tu éxito a Thassarian a bordo de El Rompecielos, la nave de guerra.‡Derrota al general Aterraluz e informa de tu éxito a Thassarian a bordo de El Rompecielos, la nave de guerra.‡Tuez le Général Plaie-de-lumière puis allez rapporter votre succès à Thassarian à bord de la canonnière Brise-ciel.‡击败莱斯班恩将军，然后向联盟飞行战舰上的萨萨里安报捷。‡擊敗光禍將軍，然後回到砲艇，破天者號向薩沙理安回報你的成功。',
  }
},
[12897] = {
  {
    'Se não conseguir convertê-lo...‡Последний аргумент‡Wenn man ihn nicht überzeugen kann...‡마음을 돌릴 수 없다면‡Si no puede ser transformado‡Si no puede ser transformado‡S\'il ne peut pas être détourné…‡顽固的敌人‡如果無法感化他',
    nil,
    'Derrote o general Halonegro e, em seguida, informe o seu sucesso a Koltirus Tecemorte, a bordo da belonave Martelo de Orgrim.‡Убейте генерала Погибель Света и доложите об исполнении Кольтире Ткачу Смерти на борту "Молота Оргрима".‡Besiegt General Lichtbann und berichtet dann Koltira Todesweber an Bord des Kanonenboots Orgrims Hammer von Eurem Erfolg.‡장군 라이츠베인을 무찌르고 비행포격선인 오그림의 망치호에 있는 콜티라 데스위버에게 돌아가 승전보를 알려야 합니다.‡Derrota al general Aterraluz e informa de tu éxito a Koltira Tejemuerte a bordo del Martillo de Orgrim, la nave de guerra.‡Derrota al general Aterraluz e informa de tu éxito a Koltira Tejemuerte a bordo del Martillo de Orgrim, la nave de guerra.‡Tuez le Général Plaie-de-lumière puis allez rapporter votre succès auprès de Koltira Tissemort à bord de la canonnière, le Marteau d\'Orgrim.‡击败莱斯班恩将军，然后向部落飞行战舰上的库尔迪拉·织亡者报捷。‡擊敗光禍將軍，然後回到砲艇，奧格林之錘向寇爾提拉·亡織者回報你的成功。',
  }
},
[12898] = {
  {
    'A Abóbada das Sombras‡Мрачный Свод‡Das Schattengewölbe‡어둠의 무기고‡La Cámara de las Sombras‡La Cámara de las Sombras‡Le caveau des Ombres‡暗影拱顶‡暗影穹殿',
    nil,
    'Apresente-se ao Barão Laska na Abóbada das Sombras.‡Поговорите с бароном Раздором в Мрачном Своде.‡Meldet Euch bei Baron Splitter im Schattengewölbe.‡어둠의 무기고에 있는 남작 슬리버에게 돌아가 보고해야 합니다.‡Informa al Barón Tajada en La Cámara de las Sombras.‡Informa al Barón Tajada en La Cámara de las Sombras.‡Présentez-vous au Baron Lesquille au Caveau des Ombres.‡向暗影拱顶的斯利文男爵报到。‡回到暗影穹殿向史力弗男爵報告。',
  }
},
[12899] = {
  {
    'A Abóbada das Sombras‡Мрачный Свод‡Das Schattengewölbe‡어둠의 무기고‡La Cámara de las Sombras‡La Cámara de las Sombras‡Le caveau des Ombres‡暗影拱顶‡暗影穹殿',
    nil,
    'Apresente-se ao Barão Laska na Abóbada das Sombras.‡Поговорите с бароном Раздором в Мрачном Своде.‡Meldet Euch bei Baron Splitter im Schattengewölbe zurück.‡어둠의 무기고에 있는 남작 슬리버에게 돌아가 보고해야 합니다.‡Informa al Barón Tajada en La Cámara de las Sombras.‡Informa al Barón Tajada en La Cámara de las Sombras.‡Présentez-vous au Baron Lesquille au Caveau des Ombres.‡向暗影拱顶的斯利文男爵报到。‡回到暗影穹殿向史力弗男爵報告。',
  }
},
[12900] = {
  {
    'Confeccionando um arnês‡Изготовление сбруи‡Ein Geschirr anfertigen‡고삐 만들기‡Hacer un arnés‡Hacer un arnés‡Fabriquer un harnais‡制造挽具‡製作鞍具',
    nil,
    'Astrid Bjornrittar na Aldeia Brunnhildar quer que você consiga 3 Peles de Yeti Jubálgida.‡По заданию Астрид Бьорнриттар из деревни Бруннхильдар раздобудьте 3 шкуры ледогривых йети.‡Astrid Björnrittar aus Brunnhildar möchte, dass Ihr 3 Bälge von Eismähnenyetis besorgt.‡얼음갈기 설인 가죽 3개를 모아 브룬힐다르 마을의 아스트리드 비요른리타에게 가져가야 합니다.‡Astrid Bjornrittar en el Poblado Brunnhildar quiere que consigas 3 pellejos de yeti Pelohielo.‡Astrid Bjornrittar en el Poblado Brunnhildar quiere que consigas 3 pellejos de yeti Pelohielo.‡Astrid Bjornrittar à Brunnhildar veut que vous rapportiez 3 Peaux de yéti crins-de-glace.‡布伦希尔达村的艾丝崔·约利塔尔希望你交给她3张冰鬃雪人的毛皮。‡布倫希爾達村的艾絲翠德·畢優利塔要你取得3塊冰鬃雪人毛皮。',
  }
},
[12901] = {
  {
    'A arte de criar algo do nada‡Что-то из ничего‡Aus nichts etwas herstellen‡무에서 유를 창조‡Hacer algo a partir de nada‡Hacer algo a partir de nada‡Système D‡从无到有‡無中生有',
    nil,
    'O Engenheiro Reed, no Campo Avançado dos Cruzados, em Zul\'Drak, quer que você recupere 10 pedaços de Sucata do Flagelo.‡Принесите 10 обломков металлолома Плети инженеру Риду в Передовой лагерь рыцарей в Зул\'Драке.‡Ingenieur Schilf im Lager der Kreuzfahrer in Zul\'Drak möchte, dass Ihr 10 Stück Metallschrott der Geißel beschafft.‡줄드락의 십자군 전진기지에 있는 기술자 리드가 스컬지 금속 조각 10개를 가져다달라고 했습니다.‡El ingeniero Carrizo en el Puesto de Avanzada de los Cruzados en Zul\'Drak te ha pedido que consigas 10 trozos de chatarra de la Plaga.‡El ingeniero Carrizo en el Puesto de Avanzada de los Cruzados en Zul\'Drak te ha pedido que consigas 10 trozos de chatarra de la Plaga.‡L’Ingénieur Reed, du Camp avancé des croisés à Zul’Drak, vous a demandé de récupérer 10 Morceaux de ferraille du Fléau.‡北伐军前线营地的工程师里德要求你收集10块天灾金属废料。‡十字軍前進營地的工程師瑞德要你回收10個天譴金屬碎塊。',
  }
},
[12902] = {
  {
    'Em busca de respostas‡Кто за этим стоит?‡Auf der Suche nach Antworten‡해답을 찾아서‡En busca de respuestas‡En busca de respuestas‡En quête de réponses‡寻找答案‡尋找答案',
    nil,
    'Procure, no Covil Patafúria, uma pista de quem ou o que iniciou os ataques contra os Guaxinantes Patafúria.‡Обыщите логово Яростного Когтя и попытайтесь узнать, кто был зачинщиком атаки на волчеров Яростного Когтя.‡Durchsucht den Zornklauenbau nach Hinweisen darüber, wer oder was die Angriffe gegen die Wolvar der Zornklauen eingeleitet hat.‡성난발톱 소굴을 수색하여 성난발톱일족 울바르를 처음으로 공격한 것이 누구인지 또는 무엇인지 단서를 찾아내야 합니다.‡Registra la Guarida de Garrafuria para buscar pistas sobre quién o qué inició el ataque contra los wolvar Garrafuria.‡Registra la Guarida de Garrafuria para buscar pistas sobre quién o qué inició el ataque contra los wolvar Garrafuria.‡Fouillez la Tanière Grifferage à la recherche d’indices sur l’origine de ceux qui, ou de ce qui, a attaqué les varleus Grifferage.‡前往怒爪巢穴寻找线索，查出向怒爪狼獾人发动进攻的幕后主使。‡搜索怒爪巢穴，找攻擊怒爪獾狼怪的元兇所留下的線索。',
  }
},
[12903] = {
  {
    'É para isso que servem os amigos...‡Для того и нужны друзья...‡Dafür sind Freunde da...‡진정한 친구란...‡Para eso están los amigos…‡Para eso están los amigos…‡Les amis sont là pour ça…‡朋友的意义……‡這就是朋友的意義……',
    nil,
    'O Cruzado MacKellar, no Campo Avançado dos Cruzados, quer que você encontre o Cruzado Dargath, Gerk e Burr.‡Разыщите рыцаря Даргата, Герка и Бурра по просьбе рыцаря Маккеллара из Передового лагеря рыцарей.‡Kreuzfahrer MacKellar im Lager der Kreuzfahrer möchte, dass Ihr nach Kreuzfahrer Dargath, Gerk und Burr sucht.‡십자군 전진기지에 있는 성전사 맥켈라르가 성전사 다르가스, 그리고 게르크와 부르를 찾아달라고 했습니다.‡El cruzado MacKellar en el Puesto de Avanzada de los Cruzados te ha pedido que encuentres al cruzado Dargath, a Gerk y a Burr.‡El cruzado MacKellar en el Puesto de Avanzada de los Cruzados te ha pedido que encuentres al cruzado Dargath, a Gerk y a Burr.‡Le Croisé MacKellar, au Camp avancé des croisés, vous a demandé de trouver le Croisé Dargath, ainsi que Gerk et Burr.‡北伐军前线营地的北伐军战士马克拉尔要求你找到北伐军战士达加斯、戈尔克和布尔。‡十字軍前進營地的十字軍麥克凱拉要你找到十字軍達加希、介爾克、與孛爾。',
  }
},
[12904] = {
  {
    'A Luz não me concederá vingança‡Орудие мести‡Das Licht verwehrt mir meine Rache‡미처 하지 못한 복수‡La Luz no me dará la venganza‡La Luz no me dará la venganza‡La Lumière ne m\'accorde pas la vengeance‡圣光不能为我复仇‡聖光不會賜予我復仇',
    nil,
    'Gerk, na Ruína de Thrym, em Zul\'Drak, quer que você mate 15 varguls.‡Убейте 15 варгулов по просьбе Герка из Тупика Трыма в Зул\'Драке.‡Gerk in Thryms Ende in Zul\'Drak möchte, dass Ihr 15 Vargul tötet.‡줄드락에 있는 스림의 최후에서 게르크가 바르굴 15명을 처치해달라고 부탁했습니다.‡Gerk en el Fin de Thrym en Zul\'Drak quiere que mates a 15 vargul.|n‡Gerk en el Fin de Thrym en Zul\'Drak quiere que mates a 15 vargul.|n‡Gerk, à la Fin de Thrym à Zul’Drak, veut que vous tuiez 15 Varguls.‡塞穆之末的戈尔克希望你去消灭15个瓦古维库人。‡瑟瑞姆之歿的介爾克要你殺死15個瓦苟。',
  }
},
[12905] = {
  {
    'Mildred, a Cruel‡Милдред Жестокая‡Mildred die Grausame‡무자비한 밀드레드‡Mildred la Cruel‡Mildred la Cruel‡Mildred la Cruelle‡残酷的米尔德蕾‡殘酷的米歐瑞德',
    nil,
    'Fale com Mildred, a Cruel, no interior da Mina Esquecida.‡Поговорите с Милдред Жестокой в Заброшенном руднике.‡Sprecht mit Mildred der Grausamen in der verlassenen Mine.‡쓸쓸한 광산 안에서 무자비한 밀드레드와 대화해야 합니다.‡Habla con Mildred la Cruel en la Mina Desolada.‡Habla con Mildred la Cruel en la Mina Desolada.‡Parlez à Mildred la Cruelle à la Mine Lugubre.‡在荒弃矿洞内与残酷的米尔德蕾谈一谈。‡與殘酷的米歐瑞德交談，她就在凋落礦坑裡。',
  }
},
[12906] = {
  {
    'Disciplina‡Поучить уму-разуму‡Disziplin‡규율‡Disciplina‡Disciplina‡Discipline‡训诫‡紀律',
    nil,
    'Mildred, a Cruel, na Mina Esquecida, quer que você use o Bastão Disciplinador em 6 Vraikalen Exaustos.‡По заданию Милдред Жестокой из Заброшенного рудника накажите 6 обессиленных врайкулов с помощью вразумляющего жезла.‡Mildred die Grausame an der verlassenen Mine möchte, dass Ihr die Disziplinarrute auf 6 erschöpfte Vrykul anwendet.‡쓸쓸한 광산에 있는 지친 브리쿨 6명에게 규율의 지팡이를 사용한 다음 무자비한 밀드레드에게 돌아가야 합니다.‡Mildred la Cruel en La Mina Desolada quiere que uses la vara disciplinante sobre 6 vrykul agotados.‡Mildred la Cruel en La Mina Desolada quiere que uses la vara disciplinante sobre 6 vrykuls agotados.‡Mildred la Cruelle à la Mine Lugubre vous a demandé d\'utiliser le Bâton de discipline sur 6 Vrykuls épuisés.‡荒弃矿洞中的残酷的米尔德蕾要求你使用训诫之杖威吓6个筋疲力尽的维库人。‡凋落礦坑的殘酷的米歐瑞德要你對6個精疲力竭的維酷人使用紀律節杖。',
  }
},
[12907] = {
  {
    'Um exemplo a ser dado‡Нужны показательные примеры‡Exempel statuieren‡본보기‡Castigos ejemplares‡Castigos ejemplares‡Faire des exemples‡杀一儆百‡殺一儆百',
    nil,
    'Mildred, a Cruel, na Mina Esquecida, quer que você mate Garhal.‡По заданию Милдред Жестокой из Заброшенного рудника убейте Гархала.‡Mildred die Grausame in der verlassenen Mine möchte, dass Ihr Garhal tötet.‡쓸쓸한 광산에 있는 무자비한 밀드레드가 가르할을 처치해 달라고 부탁했습니다.‡Mildred la Cruel en la Mina Desolada quiere que mates a Garhal.‡Mildred la Cruel en la Mina Desolada quiere que mates a Garhal.‡Mildred la Cruelle à la Mine Lugubre vous a demandé de tuer Garhal.‡荒弃矿洞内的残酷的米尔德蕾命令你去处死加哈尔。‡凋落礦坑的殘酷的米歐瑞德要你殺死賈爾赫。',
  }
},
[12908] = {
  {
    'Uma certa prisioneira‡Наглая пленница‡Eine bestimmte Gefangene‡어떤 죄수‡Un prisionero concreto‡Un prisionero concreto‡La bravache et la prisonnière‡特殊的囚犯‡某個囚犯',
    nil,
    'Leve a chave de Mildred para Lok\'lira, a Velha, na Mina Esquecida.‡Отнесите ключ Милдред Лок\'лире Карге в Заброшенный рудник.‡Bringt Mildreds Schlüssel zu Lok\'lira der Greisin in die verlassene Mine.‡쓸쓸한 광산에 있는 마녀 로크리라에게 밀드레드의 열쇠를 가져가야 합니다.‡Llévale la llave de Mildred a Lok\'lira la Vieja Bruja en la Mina Desolada.‡Llévale la llave de Mildred a Lok\'lira la Vieja Bruja en la Mina Desolada.‡Apportez la Clé de Mildred à Lok\'lira la Mégère à la Mine Lugubre.‡把米尔德蕾的钥匙交给荒弃矿洞的女巫洛莉拉。‡拿著米歐瑞德的鑰匙去凋落礦坑找『巫婆』洛莉拉。',
  }
},
[12909] = {
  {
    'O nariz sabe‡Острый нюх‡Der Nase trauen‡개코가 따로 없다‡Por el olfato se sabe‡Por el olfato se sabe‡Le nez sait‡敏锐的嗅觉‡鼻子知道',
    nil,
    'Fale com Khaliisi aos pés da montanha a leste do Local da Queda de Grom\'arsh.‡Поговорите с Калииси у подножья горы, на востоке от места крушения Гром\'арша.‡Sprecht mit Khaliisi am Fuße des Berges östlich der Absturzstelle Grom\'ash.‡그롬아쉬 추락 지점 동쪽의 산자락에 있는 칼리이시와 대화해야 합니다.‡Habla con Khaliisi a los pies de la montaña al este del lugar del accidente de Grom\'arsh.‡Habla con Khaliisi a los pies de la montaña al este del lugar del accidente de Grom\'arsh.‡Parlez à Khaliisi au pied de la montagne au Point d\'impact de Grom\'arsh.‡前往格罗玛什坠毁点以东的山麓，与凯尔莉丝谈一谈。‡到葛羅姆亞什失事地東面的山腳下與卡莉希交談。',
  }
},
[12910] = {
  {
    'Farejando o criminoso‡Найти преступника‡Den Täter ausschnüffeln‡범인을 찾아라‡Encontrar al culpable‡Encontrar al culpable‡Renifler le coupable‡追踪罪犯‡嗅出犯人',
    nil,
    'Monte em Mandíbulas de Gelo e cavalgue-a até a origem do cheiro do bilhete de Brann. Em seguida, recupere o Comunicador de Brann e use-o para fazer contato com Brann Barbabronze.‡Садитесь верхом на Ледокус и езжайте на юг, взяв след по записке Бранна. Когда вам удастся заполучить переговорное устройство Бранна, свяжитесь с его помощью с Бранном Бронзобородом.‡Schwingt Euch auf Frostbeißer und folgt der Fährte von Branns Notiz bis zu ihrem Ausgangspunkt. Beschafft anschließend Branns Kommunikator und stellt mit seiner Hilfe Kontakt mit Brann Bronzebart her.‡얼음이빨을 타고, 브란의 쪽지에서 풍기는 냄새의 근원지를 추적해야 합니다. 그러고 나서 브란의 통신기를 찾아 브란 브론즈비어드와 대화하십시오.‡Monta a Mordisquielo y ve con ella a la fuente del olor de la nota de Brann. Luego, recupera el comunicador de Brann y úsalo para contactar con Brann Barbabronce.‡Monta a Mordisquielo y ve con ella a la fuente del olor de la nota de Brann. Luego, recupera el comunicador de Brann y úsalo para contactar con Brann Barbabronce.‡Chevauchez Morsure-de-givre et amenez-la jusqu\'à la source de l\'odeur de la note de Brann. Puis, retrouvez le Communicateur de Brann et utilisez-le pour entrer en contact avec Brann Barbe-de-bronze.‡骑上霜齿，让它带你寻找布莱恩的便笺上的气味的源头。然后找到布莱恩的通讯器，使用它与布莱恩·铜须取得联系。‡騎上霜齧，然後騎向布萊恩的便箋上殘留氣味的源頭。然後回收布萊恩的通訊器，用它跟布萊恩·銅鬚聯絡。',
  }
},
[12911] = {
  {
    'Kill Credit Test‡Kill Credit Test‡Kill Credit Test‡Test용 처치 크레딧‡Prueba de crédito por muerte‡Prueba de crédito por muerte‡Test de crédit de mort‡Kill Credit Test‡擊殺獎勵測試',
    nil,
    '/wave at Kill Credit Test‡/wave at Kill Credit Test‡/wave at Kill Credit Test‡Test용 처치 크레딧에게 /손인사를 하십시오.‡Saluda a la prueba de crédito por muerte escribiendo /wave‡Saluda a la prueba de crédito por muerte escribiendo /wave‡/signe au test de crédit de mort‡/wave at Kill Credit Test‡對擊殺獎勵測試/揮手',
  }
},
[12912] = {
  {
    'Uma grande tempestade se aproxima‡Приближение великой бури‡Ein großer Sturm rückt an‡엄청난 폭풍이 밀려온다‡Se acerca una gran tormenta‡Se acerca una gran tormenta‡Une grande tempête approche‡风暴将至‡巨大風暴的迫近',
    nil,
    'Gymer, Rei dos Gigantes da Tempestade, quer que você encontre um modo de libertá-lo da jaula. Fale com o Engenheiro Reed no Campo Avançado dos Cruzados.‡Придумайте способ, как освободить из клетки Гимера, короля штормовых великанов. Поговорите с инженером Ридом в Передовом лагере рыцарей.‡Gymer, König der Sturmriesen, hat Euch gebeten, einen Weg zu finden, ihn aus seinem Käfig zu befreien. Sprecht mit Ingenieur Schilf im Lager der Kreuzfahrer.‡폭풍 거인의 왕인 자이머가 자신을 우리에서 꺼내줄 방법을 찾아내 달라고 부탁했습니다. 십자군 전진기지에 있는 기술자 리드와 대화하십시오.‡Gymer, rey de los gigantes de tormenta, te ha pedido que encuentres un modo de liberarlo de su celda. Habla con el ingeniero Carrizo en el Puesto de Avanzada de los Cruzados.‡Gymer, rey de los gigantes de tormenta, te ha pedido que encuentres un modo de liberarlo de su celda. Habla con el ingeniero Carrizo en el Puesto de Avanzada de los Cruzados.‡Gymer, le roi des géants des tempêtes, vous a demandé de trouver un moyen de le libérer de sa cage. Allez voir l’Ingénieur Reed, au Camp avancé des croisés.‡风暴巨人之王盖米尔要求你想办法把他从笼子里面救出来。与北伐军前线营地的工程师里德谈谈该怎么办。‡風暴巨人之王基默要求你找出從牢籠中釋放他的方法。與十字軍前進營地的工程師瑞德交談。',
  }
},
[12913] = {
  {
    'Fale órquico, homem!‡Говори по-орочьи!‡Sprich Orcisch, Mann!‡오크어로 떠들란 말이다!‡¡Habla orco, hombre!‡¡Habla orco, hombre!‡Vous ne pouvez pas parler orc comme tout le monde ?‡讲兽人语会死吗？‡說獸人語啊，老兄!',
    nil,
    'Fale com Moteha Filho do Vento, no Local da Queda de Grom\'arsh.‡Отправляйтесь на место крушения Гром\'арша и узнайте, не сможет ли Мотеха Дитя Ветра вам помочь.‡Sprecht mit Moteha Windkind bei der Absturzstelle Grom\'ash.‡그롬아쉬 추락 지점에 있는 모테하 윈드본과 대화해야 합니다.‡Habla con Moteha Natoviento en el Lugar del accidente de Grom\'arsh.‡Habla con Moteha Natoviento en el Lugar del accidente de Grom\'arsh.‡Parlez à Moteha Né-du-vent, au Point d\'impact de Grom\'arsh.‡与格罗玛什坠毁点的莫塔哈·风魂谈一谈。‡與葛羅姆亞什失事地的摩特哈·風誕談談。',
  }
},
[12914] = {
  {
    'Resgate de Gymer‡Спасение Гимера‡Gymers Rettung‡자이머의 구원‡La salvación de Gymer‡La salvación de Gymer‡Le salut de Gymer‡拯救盖米尔‡拯救基默',
    nil,
    'O Engenheiro Reed, no Campo Avançado dos Cruzados, em Zul\'Drak, quer que você leve 6 Essências de Banshee e 6 amostras de Terra Diatomácea para ele.‡Принесите 6 субстанций банши и 6 комьев диатомовой земли инженеру Риду в Передовой лагерь рыцарей в Зул\'Драке.‡Ingenieur Schilf im Lager der Kreuzfahrer in Zul\'Drak möchte, dass Ihr ihm 6 Essenzen der Banshees und 6 Einheiten Kieselerde bringt.‡줄드락의 십자군 전진기지에 있는 기술자 리드가 밴시의 정수 6개와 규조 토양 6개를 가져다 달라고 부탁했습니다.‡El ingeniero Carrizo en el Puesto de Avanzada de los Cruzados en Zul\'Drak quiere que le traigas 6 esencias de alma en pena y 6 tierras de diatomeas.‡El ingeniero Carrizo en el Puesto de Avanzada de los Cruzados en Zul\'Drak quiere que le traigas 6 esencias de alma en pena y 6 tierras de diatomeas.‡L’Ingénieur Reed, du Camp avancé des croisés à Zul’Drak, a besoin de 6 Essences de banshees et de 6 Diatomites.‡北伐军前线营地的工程师里德希望你交给他6份女妖精华和6份硅藻土。‡十字軍前進營地的工程師瑞德要你把6個女妖精華與6個矽藻土壤交給他。',
  }
},
[12915] = {
  {
    'Fazendo as pazes‡Возобновление старых связей‡Zäune reparieren‡마음의 벽 허물기‡Enmiendas‡Enmiendas‡Rentrer dans les bonnes grâces‡弥补关系‡修補圍籬',
    nil,
    'Thorim, no Templo das Tempestades, quer que você mate Fjorn e 5 Gigantes Forjados em Tempestade na Bigorna de Fjorn, a leste de Dun Niffelem.|n|nO Amuleto da Terra de Thorim, quando usado, evoca os Terranos para lutar ao seu lado. O amuleto requer um Pedregulho de Granito da Bigorna de Fjorn, próxima dali.‡По заданию Торима из Храма Штормов убейте Фьорна и 5 железных великанов из клана Закаленных Бурей у Наковальни Фьорна к востоку от Дун Ниффелема. Чтобы вызвать на подмогу воинов земли, воспользуйтесь оберегом земли Торима. Чтобы его задействовать, нужен гранитный валун из Наковальни Фьорна.‡Thorim im Tempel der Stürme möchte, dass Ihr Fjorn und 5 Sturmgeschmiedete Eisenriesen in Fjorns Amboss östlich von Dun Niffelem tötet.|n|nMit Thorims Glücksbringer der Erde könnt Ihr seine Irdenen zur Unterstützung holen. Zum Benutzen des Glücksbringers benötigt Ihr einen Granitfelsen aus Fjorns Amboss in der Nähe.‡던 니펠렘 동쪽에 있는 피요른의 모루에서 폭풍으로 벼려낸 무쇠 거인 5마리와 피요른을 처치하고, 폭풍의 신전에 있는 토림에게 돌아가야 합니다.|n|n토림의 대지 부적을 사용하면 전투를 돕는 토석인을 불러낼 수 있습니다. 부적을 사용하려면 피요른의 모루에서 얻는 화강암 돌이 필요합니다.‡Thorim en el Templo de las Tormentas quiere que mates a Fjorn y a 5 gigantes de hierro Tronaforjado en el Yunque de Fjorn, al este de Dun Niffelem.|n|nUsando el talismán de tierra de Thorim invocarás a sus terráneos para que luchen a tu lado. El talismán requiere una roca de granito cerca del yunque de Fjorn.‡Thorim en el Templo de las Tormentas quiere que mates a Fjorn y a 5 gigantes de hierro Tronaforjado en el Yunque de Fjorn, al este de Dun Niffelem.|n|nUsando el talismán de tierra de Thorim invocarás a sus terráneos para que luchen a tu lado. El talismán requiere una roca de granito; se encuentran cerca del Yunque de Fjorn.‡Thorim au Temple des Tempêtes vous a demandé de tuer Fjorn et 5 Géants de fer forge-foudre à l\'Enclume de Fjorn, à l\'est de Dun Niffelem.|n|nUtilisez le Charme de terre de Thorim pour invoquer ses Terrestres qui se battront à vos côtés. Vous aurez besoin d\'un Rocher de granit près de l\'Enclume de Fjorn pour que le charme fonctionne.‡风暴神殿的托里姆要你前往丹尼芬雷东边的弗约恩之砧，杀死弗约恩和5名雷铸铁巨人。|n|n你可以使用托里姆的大地符咒召唤他的土灵助战。必须借助弗约恩之砧附近的花岗岩石块才能使用这枚符咒。‡風暴神殿的索林姆要求你到丹尼弗蘭東邊的斐雍之砧，殺死斐雍與5個鐵巨人。|n|n使用索林姆的大地符咒，可以召喚他的土靈與你一同作戰。要發動符咒，必須準備斐雍之砧附近所產的花崗岩巨石。',
  }
},
[12916] = {
  {
    'Nossa única esperança‡Наша единственная надежда‡Unsere einzige Hoffnung‡유일한 희망‡Nuestra única esperanza‡Nuestra única esperanza‡Notre seul espoir‡唯一的希望‡我們唯一的希望',
    nil,
    'Fale com Gymer, na Ruína de Thrym, em Zul\'Drak, após usar a Mega Carga de Cequatrum para abrir a Jaula do Flagelo que o mantém preso.‡Поговорите с Гимером в Тупике Трыма в Зул\'Драке после того, как освободите его из клетки Плети с помощью огромного сефориевого заряда.‡Sprecht mit Gymer in Thryms Ende in Zul\'Drak, nachdem Ihr mit der riesigen Zephyriumladung die Umzäunung der Geißel geöffnet habt, in welcher der Gefangene festgehalten wird.‡거대한 시포리움 폭약을 사용하여 자이머가 갇힌 스컬지 감옥을 연 다음 줄드락, 스림의 최후에 있는 자이머와 대화해야 합니다.‡Habla con Gymer en el Fin de Thrym en Zul\'Drak cuando hayas usado la carga de seforio enorme para abrir el recinto de la Plaga donde está prisionero.‡Habla con Gymer en el Fin de Thrym en Zul\'Drak cuando hayas usado la carga de seforio enorme para abrir el recinto de la Plaga donde está prisionero.‡Utilisez la Charge d’hydroglycérine éléphantesque pour détruire l’Enclos du Fléau qui retient Gymer prisonnier. Lorsque ce sera fait, parlez à Gymer, à la Fin de Thrym à Zul’Drak.‡在祖达克的塞穆之末使用巨型爆盐炸弹，打开囚禁着盖米尔的天灾围栏，然后与盖米尔谈一谈。‡一旦你使用超超超大爆鹽炸藥打開天譴圍欄之後，就與與瑟瑞姆之歿的基默交談。',
  }
},
[12917] = {
  {
    'Falando com a voz do vento‡Поймай голос ветра!..‡Mit der Stimme des Windes sprechen‡바람의 목소리‡Hablar con la voz del viento‡Hablar con la voz del viento‡Parler avec la voix du vent‡寒风的声音‡以風之聲交談',
    nil,
    'Traga 5 Vozes do Vento para Moteha Filho do Vento, no Local da Queda de Grom\'arsh.‡Поймайте 5 голосов ветра, Мотеха Дитя Ветра на месте крушения Гром\'арша ждет, чтобы вы их принесли.‡Bringt 5 Stimmen des Windes zu Moteha Windkind an der Absturzstelle Grom\'ash.‡그롬아쉬 추락 지점에 있는 모테하 윈드본에게 바람의 목소리 5개를 가져가야 합니다.‡Llévale 5 voces del viento a Moteha Natoviento en el Lugar del accidente de Grom\'arsh.‡Llévale 5 voces del viento a Moteha Natoviento en el Lugar del accidente de Grom\'arsh.‡Apportez 5 Voix du vent à Moteha Né-du-vent, au Point d\'impact de Grom\'arsh.‡将5份寒风之声交给格罗玛什坠毁点的莫塔哈·风魂。‡把5個風之聲帶去給葛羅姆亞什失事地的摩特哈·風誕。',
  }
},
[12918] = {
  {
    'Gema Perfeita‡Огранка камней‡Edelsteine perfektionieren‡보석의 완벽함‡Gemas perfectas‡Gemas perfectas‡La perfection des gemmes‡完美宝石‡寶石完美工法',
    nil,
    'Leve dois Citrinos Grandes, dois Jades-Escuros e dois Cristais Sombras para Ounolo, em Valgarde.‡Принесите два огромных цитрина, два темных нефрита и два сумрачных кристалла Унгуло в Валгард.‡Bringt zwei Riesencitrin, zwei Nephrite und zwei Schattenkristalle zu Ounhulo in Valgarde.‡발가드에 있는 아운훌로에게 거대 황수정 2개, 암색 비취 2개, 암흑 수정 2개를 가져가야 합니다.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de sombras a Ounhulo en Valgarde.‡Llévale dos citrinos enormes, dos jades oscuros y dos cristales de Sombras a Ounhulo en Valgarde.‡Ounhulo, à Valgarde, a besoin de deux Énormes citrines, de deux Jades sombres et de deux Cristaux ombreux.‡将茶晶石、黑玉和暗影水晶各两颗交给瓦加德的恩霍罗。‡將兩顆巨黃晶，兩顆暗玉，與兩顆暗影水晶交給瓦爾加德的安胡洛。',
  }
},
[12919] = {
  {
    'Vingança do Rei da Tempestade‡Месть короля Бурь‡Die Rache des Sturmkönigs‡폭풍 제왕의 복수‡La venganza del Rey de la Tormenta‡La venganza del Rey de la Tormenta‡La vengeance du roi des tempêtes‡风暴之王的复仇‡風暴之王的復仇',
    nil,
    'Fale com Gymer para começar.|n|nEnquanto estiver em cima de Gymer, destrua 100 lacaios do Flagelo e mate Algar, o Escolhido, Thrym e o Príncipe Navarius. Apresente-se ao Cruzado MacKellar no Campo Avançado dos Cruzados ao cumprir a missão.‡Когда будете готовы к битве, скажите об этом Гимеру.|n|nСидя на голове у Гимера, уничтожьте 100 воинов Плети и убейте Алгара Избранного, Трыма и принца Навариуса. В случае успешного исхода доложите об этом серебряному рыцарю Маккеллару из передового лагеря рыцарей.‡Sprecht mit Gymer, um auf ihm zu reiten.|n|nVernichtet 100 Diener der Geißel und Algar den Auserwählten, Thrym und Prinz Navarius. Meldet Euch bei Kreuzfahrer MacKellar im Lager der Kreuzfahrer, falls Ihr erfolgreich sein solltet.‡자이머와 대화하십시오.|n|n자이머를 타고 스컬지 100명과 선택받은 알가르, 스림, 왕자 나바리우스를 처치해야 합니다. 임무를 마치면 십자군 전진기지에 있는 성전사 맥켈라르에게 보고하십시오.‡Habla con Gymer para empezar.|n|nCon Gymer como montura, destruye a 100 de la Plaga y mata a Algar el Elegido, a Thrym y al príncipe Navarius. Informa al cruzado MacKellar en el Puesto de Avanzada de los Cruzados si tienes éxito.‡Habla con Gymer para empezar.|n|nCon Gymer como montura, destruye a 100 de la Plaga y mata a Algar el Elegido, a Thrym y al príncipe Navarius. Informa al cruzado MacKellar en el Puesto de Avanzada de los Cruzados si tienes éxito.‡Parlez à Gymer pour commencer.|n|nLorsque vous serez sur son dos, détruisez 100 créatures du Fléau, et tuez Algar l’Élu, Thrym et le Prince Navarius. Si vous réussissez, allez faire votre rapport au Croisé MacKellar, au Camp avancé des croisés.‡与盖米尔交谈以开始行动。|n|n骑着盖米尔去消灭100个天灾士兵，并消灭天选者奥贾尔、塞穆和纳瓦留斯王子。成功之后，向北伐军前线营地的北伐军战士马克拉尔报告。‡與基默交談出發。|n|n騎著基默摧毀100個天譴軍，並殺死『天選』奧嘉爾、瑟瑞姆以及納法勒斯王子。一旦你成功了，就向十字軍前進營地的十字軍麥克凱拉報告。',
  }
},
[12920] = {
  {
    'Compreendendo Brann‡Вдогонку за Бранном‡Brann einholen‡브란과 대화하기‡Alcanzar a Brann‡Alcanzar a Brann‡Retrouver Brann‡联络布莱恩‡追上布萊恩',
    nil,
    'Use o Comunicador de Brann para fazer contato e falar com ele. Em seguida, fale com Boktar Furissangue no Local da Queda de Grom\'arsh.|n|nSe perder o Comunicador de Brann, fale com Moteha Filho do Vento no Local da Queda de Grom\'arsh.‡Используйте переговорное устройство Бранна, чтобы связаться с Бранном Бронзобородом. Потом доложите о результатах Боктару Кровавому Безумию, который ждет вас на месте крушения Гром\'арша.|n|nЕсли вы потеряете переговорное устройство Бранна, вам поможет Мотеха Дитя Ветра на месте крушения Гром\'арша.‡Benutzt Branns Kommunikator, um Euch mit Brann Bronzebart in Verbindung zu setzen. Erstattet anschließend Boktar Blutfurie bei der Absturzstelle Grom\'ash Bericht.|n|nFalls Ihr Branns Kommunikator verlieren solltet, dann sprecht mit Moteha Windkind bei der Absturzstelle Grom\'ash.‡브란의 통신기를 이용해 브란 브론즈비어드에게 연락을 취하고 나서, 그롬아쉬 추락 지점에 있는 복타르 블러드퓨리와 대화해야 합니다.|n|n브란의 통신기를 잃어버리면 그롬아쉬 추락 지점에 있는 모테하 윈드본과 대화하십시오.‡Usa el comunicador de Brann para contactar con Brann Barbabronce y habla con él, y luego habla con Boktar Furia Sangrienta en el lugar del accidente de Grom\'arsh.|n|nSi pierdes el comunicador de Brann, habla con Moteha Natoviento en el lugar del accidente de Grom\'arsh.‡Usa el comunicador de Brann para contactar con Brann Barbabronce y habla con él, y luego habla con Boktar Furia Sangrienta en el lugar del accidente de Grom\'arsh.|n|nSi pierdes el comunicador de Brann, habla con Moteha Natoviento en el lugar del accidente de Grom\'arsh.‡Utilisez le Communicateur de Brann pour contacter Brann Barbe-de-bronze et parlez-lui, puis parlez à Boktar Rougefurie au Point d\'impact de Grom\'arsh.|n|nSi vous perdez le Communicateur de Brann, allez parler à Moteha Né-du-vent au Point d\'impact de Grom\'arsh.‡使用布莱恩的通讯器与布莱恩·铜须联络并与他交谈，然后与格罗玛什坠毁的伯克塔·血怒谈一谈。|n|n如果你遗失了布莱恩的通讯器，可以找格罗玛什坠毁点的莫塔哈·风魂再要一个。‡使用布萊恩的通訊器與布萊恩·銅鬚通訊，與他交談，然後和葛羅姆亞什失事地的博克塔·血怒交談。|n|n如果你弄丟了布萊恩的通訊器，去找葛羅姆亞什失事地的摩特哈·風誕談談。',
  }
},
[12921] = {
  {
    'Mudança de cenário‡Смена декораций‡Tapetenwechsel‡다른 무대에서‡Un cambio de escenario‡Un cambio de escenario‡Changer de décor‡改头换面‡轉換舞台',
    nil,
    'Reúna-se novamente com Lok\'lira, a Velha, na Aldeia Brunnhildar.‡Поговорите с Лок\'лирой Каргой в деревне Бруннхильдар.‡Trefft Euch mit Lok\'lira der Greisin in Brunnhildar.‡브룬힐다르 마을에서 마녀 로크리라를 다시 만나야 합니다.‡Reúnete con Lok\'lira la Vieja Bruja en el poblado Brunnhildar.‡Reúnete con Lok\'lira la Vieja Bruja en el Poblado Brunnhildar.‡Retrouvez Lok\'lira la Mégère à Brunnhildar.‡到布伦希尔达村与女巫洛莉拉汇合。‡到布倫希爾達村與『巫婆』洛莉拉會合。',
  }
},
[12922] = {
  {
    'O fogo do refinador‡Очищающее пламя‡Des Veredlers Feuer‡제련의 불꽃‡El fuego del refinador‡El fuego del refinador‡Le feu du raffineur‡精炼之火‡精鍊之火',
    nil,
    'Colete 10 Centelhas Furiosas dos Elementais Vingativos Exasperados no Lago Congelado e use os na Bigorna de Fjorn.‡Соберите 10 гневных искр с пылающих загробников на Промерзшем озере и с их помощью разожгите огонь в Наковальне Фьорна.‡Ihr müsst 10 wütende Funken von den wutentbrannten Klagegeistern auf dem Frostfeldsee sammeln und anschließend den Amboss bei Fjorns Amboss verwenden.‡서리평원 호수의 소용돌이치는 망령에게서 성난 불꽃 10개를 모아 피요른의 모루에서 사용해야 합니다.‡Debes reunir 10 chispas furiosas de aparecidos hirvientes en el lago Campo de Escarcha y usarlas en el yunque del Yunque de Fjorn.‡Debes reunir 10 chispas furiosas de aparecidos hirvientes en el lago Campo de Escarcha y usarlas en el yunque del Yunque de Fjorn.‡Récupérez 10 Étincelles furieuses sur des Revenants vengeurs au Lac du Champ-gelé, puis utilisez l\'enclume à l\'Enclume de Fjorn.‡从霜原湖的火热的亡魂身上收集10份狂怒火花，然后前往弗约恩之砧，使用那里的铁砧。‡你必須從霜域湖的沸騰亡魄身上收集10個狂烈火花，然後在斐雍之砧使用它們。',
  }
},
[12924] = {
  {
    'Forjando uma aliança‡Возобновление союза‡Ein Bündnis schließen‡동맹 맺기‡Forjando una Alianza‡Forjando una Alianza‡Forger une alliance‡重铸盟约‡鑄成同盟',
    nil,
    'Vá a Dun Niffelem e peça ao Rei Iokkum para permitir que a armadura de Thorim seja reforjada. Após concluir a tarefa de Iokkum, fale com Njormeld em Dun Niffelem.‡Отправляйтесь в Дун Ниффелем и попросите короля Йоккума разрешить воссоздать доспех Торима. Выполнив поручение Йоккума, поговорите с Ньормельдом в Дун Ниффелеме.‡Ihr sollt nach Dun Niffelem gehen und König Jokkum darum bitten, Thorims Rüstung neu schmieden zu lassen. Nachdem Ihr Jokkums Aufgabe abgeschlossen habt, sollt Ihr mit Njormeld in Dun Niffelem sprechen.‡던 니펠렘에 있는 제왕 요쿰에게 토림의 방어구를 재련해 달라고 부탁해야 합니다. 요쿰의 일을 마치고 던 니펠렘에 있는 요르멜드에게 돌아가야 합니다.‡Debes ir a Dun Niffelem y pedirle al rey Jokkum que permita que se vuelva a forjar la armadura de Thorim. Después de completar la tarea de Jokkum, habla con Njormeld en Dun Niffelem.‡Debes ir a Dun Niffelem y pedirle al rey Jokkum que permita que se vuelva a forjar la armadura de Thorim. Después de completar la tarea de Jokkum, habla con Njormeld en Dun Niffelem.‡Rendez-vous à Dun Niffelem et demandez au Roi Jokkum de permettre que l\'Armure de Thorim soit reforgée. Après avoir terminé la tâche de Jokkum, allez parler à Njormeld à Dun Niffelem.‡前往丹尼芬雷，请求约库姆国王帮忙重铸托里姆的护甲。完成约库姆交付的任务之后，与丹尼芬雷的亚米尔德谈一谈。‡你要去丹尼弗蘭，請求裘庫姆王允許重鑄索林姆之甲。完成他的任務之後，你要去找丹尼弗蘭的尼約梅爾德談話。',
  }
},
[12925] = {
  {
    'Aberrações‡Верность традициям‡Missgeburten‡괴물‡Aberraciones‡Aberraciones‡Aberrations‡维持传统‡畸形',
    nil,
    'Thyra Kvinnshal, na Aldeia Brunnhildar, quer que você vá a Valkyrion e tome Ampolas de Óleo Gélido das Aspirantes Valkyrion. Use as Ampolas de Óleo Gélido para destruir 30 Ovos de Protodraco Pestilento.‡По заданию Тиры Квиншал из деревни Бруннхильдар отправляйтесь в Валькирион и добудьте у валькирионских претенденток флаконы масла льда. Используйте их, чтобы уничтожить 30 зачумленных яиц протодраконов.‡Thyra Kvinnshal in Brunnhildar möchte, dass Ihr nach Valkyrion geht und Phiolen mit Frostöl von den Streiterinnen von Valkyrions besorgt. Nutzt die Phiolen dann, um 30 verseuchte Eier der Protodrachen zu zerstören.‡발키리온에 있는 발키리온 지원자에게서 냉기 기름이 든 유리병을 구해, 역병 걸린 원시비룡 알 30개에 사용해야 합니다. 그러고 나서 브룬힐다르 마을에 있는 티라 크빈샬에게 돌아가십시오.‡Thyra Kvinnshal en el Poblado Brunnhildar quiere que vayas a Valkyrion y consigas viales de aceite de Escarcha de las aspirantes de Valkyrion. Usa los viales de aceite de Escarcha para destruir 30 huevos de protodraco apestado.‡Thyra Kvinnshal en el Poblado Brunnhildar quiere que vayas a Valkyrion y consigas viales de aceite de Escarcha de las aspirantes de Valkyrion. Usa los viales de aceite de Escarcha para destruir 30 huevos de protodraco apestado.‡Thyra Kvinnshal à Brunnhildar vous demande de vous rendre à Valkyrion et d\'obtenir des Fioles d\'huile glaciale des Aspirantes de Valkyrion. Utilisez les Fioles d\'huile glaciale pour détruire 30 Oeufs de Proto-drakes pestiférés.‡布伦希尔达村的塞拉·克文沙尔要你前往瓦基里安，从瓦基里安候选者身上夺取冰霜油膏，并用冰霜油膏摧毁30枚瘟疫始祖龙卵。‡布倫希爾達村的賽拉·克微蕭要求你，前往華爾基倫並從華爾基倫野心家身上取得冰霜之油瓶。使用冰霜之油摧毀30個染疫元龍蛋。',
  }
},
[12926] = {
  {
    'As peças do quebra-cabeça‡Кусочки головоломки‡Teile des Rätsels‡수수께끼의 일부‡Piezas del rompecabezas‡Piezas del rompecabezas‡Les pièces du puzzle‡拼图游戏‡拼圖的碎片',
    nil,
    'Use o Comunicador para fazer contato com Brann Barbabronze e descobrir o que fazer em seguida.‡Воспользуйтесь переговорным устройством Бранна, чтобы связаться с Бранном Бронзобородом и выяснить, что делать дальше.‡Benutzt Branns Kommunikator, um Euch mit Brann Bronzebart in Verbindung zu setzen.‡브란의 통신기로 브란 브론즈비어드와 접촉해 다음에 무슨 일을 해야 하는지 알아봐야 합니다.‡Usa el comunicador de Brann para contactar con Brann Barbabronce y que te explique qué hacer a continuación.‡Usa el comunicador de Brann para contactar con Brann Barbabronce y que te explique qué hacer a continuación.‡Utilisez le Communicateur de Brann pour contacter Brann Barbe-de-bronze afin de savoir que faire ensuite.‡使用布莱恩的通讯器联络布莱恩·铜须，并了解下一步的行动计划。‡使用布萊恩的通訊器聯絡布萊恩·銅鬚，了解下一步該做的事。',
  }
},
[12927] = {
  {
    'Prospecção de dados‡Сбор информации‡Daten schürfen‡정보 추출‡Extracción de datos‡Extracción de datos‡Collecte de données‡采集数据‡資料探勘',
    nil,
    'Use o Disco do Inventor para obter 7 fragmentos de Dados Ocultos nos Bancos de Dados.‡Воспользуйтесь диском изобретателя, чтобы считать 7 фрагментов секретных данных из банков данных.‡Nutzt die Scheibe des Erfinders, um 7 versteckte Daten aus den Datenbanken zu beschaffen.‡발명가의 원반을 사용해 정보 저장고에서 숨겨진 정보 7 개를 찾아와야 합니다.‡Usa el Disco del Inventor para recuperar las 7 partes de datos ocultos en los bancos de datos.‡Usa el disco de inventor para recuperar 7 juegos de datos ocultos de los bancos de datos.‡Utilisez le Disque de l\'inventeur pour retrouver 7 fragments de Données cachées dans les Banques de données.‡使用创世者的圆盘，从数据库中获得7条秘密数据。‡使用發明者圓盤從資料庫取得7份隱藏資料。',
  }
},
[12928] = {
  {
    'Invólucro de Norgannon‡Оболочка Норганнона‡Norgannons Schale‡노르간논의 껍질‡El caparazón de Norgannon‡El caparazón de Norgannon‡La coque de Norgannon‡诺甘农之壳‡諾甘農之殼',
    nil,
    'Obtenha o Invólucro de Norgannon com o Arquivista Mecaton.‡Заберите оболочку Норганнона у архивариуса Мехатона.‡Beschafft Euch Norgannons Schale von Archivar Mechaton.‡기록관 메카톤에게서 노르간논의 껍질을 구해야 합니다.‡Recupera el caparazón de Norgannon del archivista Mechaton.‡Recupera el caparazón de Norgannon del archivista Mechaton.‡Récupérez le Noyau de Norgannon auprès de l’Archiviste Mécaton.‡从档案员麦卡顿那里拿到诺甘农之壳。‡從管理員梅查頓那取回諾甘農之殼。',
  }
},
[12929] = {
  {
    'Os Terranos de Ulduar‡Земельники Ульдуара‡Die Irdenen von Ulduar‡울두아르의 토석인‡Los terráneos de Ulduar‡Los terráneos de Ulduar‡Les Terrestres d\'Ulduar‡奥杜尔的土灵‡奧杜亞的土靈',
    nil,
    'Fale com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Поговорите с Глыбоскалом Камнетесом в Приюте Глыбоскала.‡Sprecht mit Bergfels dem Steinformer in Bergfels’ Zuflucht.‡바울더크랙의 은거처에 있는 돌조각장이 바울더크랙과 대화해야 합니다.‡Habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Parlez à Rochecombe le Sculpteroc au Refuge de Rochecombe.‡与布德克拉格庇护所的塑石者布德克拉格谈一谈。‡與石崖避難所的『塑岩者』石崖交談。',
  }
},
[12930] = {
  {
    'Terra Rara‡Редкоземельный элемент‡Seltene Erde‡귀한 흙‡Tierra rara‡Tierra rara‡Une terre rare‡稀有的土壤‡稀有的土壤',
    nil,
    'Use a Picareta de Mineração Terrana para escavar 7 torrões de Terra Encantada. Leve a terra e 5 Friotramas para Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡С помощью шахтерской кирки земельника добудьте 7 комков зачарованной земли и принесите 5 отрезов ледяной ткани Глыбоскалу Камнетесу в Приют Глыбоскала.‡Baut mit der Spitzhacke der Irdenen 7 Klumpen verzauberte Erde ab. Bringt anschließend die Erde und 5 Einheiten Froststoff zu Bergfels dem Steinformer in Bergfels\' Zuflucht.‡대지 채광용 곡괭이를 사용하여 마력 깃든 대지 7개를 캐낸 다음, 서리매듭 옷감 5개와 함께 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 가져다주어야 합니다.‡Usa el pico de minería terráneo para minar 7 puñados de tierra encantada. Lleva la tierra y 5 telas de tejido de Escarcha a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Usa el pico de minería terráneo para minar 7 puñados de tierra encantada. Lleva la tierra y 5 telas de tejido de Escarcha a Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Utilisez la Pioche terrestre pour extraire 7 mottes de Terre enchantée. Apportez la Terre enchantée et 5 Etoffes de tisse-givre à Rochecombe le Sculpteroc au Refuge de Rochecombe.‡使用土灵采矿锄收集7块魔化土壤。将这些土壤和5张霜纹布交给布德克拉格庇护所的塑石者布德克拉格。‡使用土靈採礦鎬採取7堆附魔土壤。將附魔土壤與5張霜紋布帶去給石崖避難所的『塑岩者』石崖。',
  }
},
[12931] = {
  {
    'Revidando o ataque‡Контратака‡Zurückschlagen‡반격‡Contraatacando‡Contraatacando‡Contre-attaquer‡反击‡反擊',
    nil,
    'Petrenedo, o Moldador de Rochas, quer que você mate 10 Atacantes Forjados em Tempestade e fale novamente com ele no Refúgio do Petrenedo. Você pode matar Saqueadores Forjados em Tempestade ou Aniquiladores Forjados em Tempestade.‡По заданию Глыбоскала Камнетеса убейте 10 мародеров или разорителей из клана Закаленных Бурей и возвращайтесь к нему в Приют Глыбоскала.‡Bergfels der Steinformer in Bergfels\' Zuflucht möchte, dass Ihr 10 sturmgeschmiedete Angreifer tötet und anschließend zu ihm zurückkehrt. Ihr könnt entweder sturmgeschmiedete Räuber oder Häscher töten.‡폭풍으로 벼려낸 약탈병이나 파괴자를 10명 처치하고, 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Pedruscón el Creador de rocas quiere que mates a 10 atacantes Tronaforjado y que vuelvas a hablar con él en el Refugio de Pedruscón. Puedes matar a asaltantes Tronaforjado o atracadores Tronaforjado.‡Pedruscón el Creador de rocas quiere que mates a 10 atacantes Tronaforjado y que vuelvas a hablar con él en el Refugio de Pedruscón. Puedes matar a asaltantes Tronaforjado o atracadores Tronaforjado.‡Rochecombe le Sculpteroc veut que vous tuiez 10 Attaquants forge-foudre et que vous retourniez le voir au Refuge de Rochecombe. Vous pouvez tuer soit des Ecumeurs forge-foudre soit des Saccageurs forge-foudre.‡塑石者布德克拉格希望你杀死总计10名雷铸袭击者或雷铸掠夺者，然后返回布德克拉格庇护所向他复命。‡『塑岩者』石崖要你殺死10個風暴冶煉進攻者，然後回到石崖避難所向他回報。殺死風暴冶煉劫掠者或風暴冶煉劫奪者都可以。',
  }
},
[12932] = {
  {
    'Anfiteatro da Angústia: Yggdras!‡Амфитеатр Страданий: Иггдрас!‡Das Amphitheater der Agonie: Yggdras!‡고뇌의 투기장: 이그드라스!‡El Anfiteatro de la Angustia: ¡Yggdras!‡El Anfiteatro de la Angustia: ¡Yggdras!‡L\'Amphithéâtre de l\'Angoisse : Yggdras !‡痛苦斗兽场：伊戈达斯！‡苦痛露天競技場:伊格卓斯!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Yggdras! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Иггдраса! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Yggdras! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 이그드라스와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Yggdras! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Yggdras! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez d’Yggdras ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败伊戈达斯！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗伊格卓斯!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12933] = {
  {
    'Anfiteatro da Angústia: Magnatauro!‡Амфитеатр Страданий: магнатавр!‡Das Amphitheater der Agonie: Magnataur!‡고뇌의 투기장: 마그나타우르!‡El Anfiteatro de la Angustia: ¡Magnatauro!‡El Anfiteatro de la Angustia: ¡Magnatauro!‡L\'Amphithéâtre de l\'Angoisse : magnataure !‡痛苦斗兽场：猛犸人！‡苦痛露天競技場:猛瑪象人!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Barbodum! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Смрадоборода! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Stinkbart! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 노린내수염과 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Barbahedionda! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Barbahedionda! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez de Barbapue ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败恶臭之须！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗臭鬚!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12934] = {
  {
    'Anfiteatro da Angústia: Do além!‡Амфитеатр Страданий: существо из другого мира!‡Das Amphitheater der Agonie: Aus einer anderen Welt!‡고뇌의 투기장: 저쪽 세상에서!‡El Anfiteatro de la Angustia: ¡del más allá!‡El Anfiteatro de la Angustia: ¡del más allá!‡L\'Amphithéâtre de l\'Angoisse : de l\'au-delà !‡痛苦斗兽场：异界的对手！‡苦痛露天競技場:超越次元!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote um dos lordes elementais! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите повелителя элементалей! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt einen der Elementarfürsten! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 정령 군주 하나와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a uno de los señores elementales! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a uno de los señores elementales! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez de l’un des seigneurs élémentaires ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败一位元素领主！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗一位元素領主!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12935] = {
  {
    'Anfiteatro da Angústia: Morsarmagedom!‡Амфитеатр Страданий: Клыкаррмагеддон!‡Das Amphitheater der Agonie: Tuskarrmageddon!‡고뇌의 투기장: 투스카르 대결전!‡El Anfiteatro de la Angustia: ¡Colmillarrmagedón!‡El Anfiteatro de la Angustia: ¡Colmillarrmagedón!‡L\'Amphithéâtre de l\'Angoisse : rohart-maggedon !‡痛苦斗兽场：海象人的末日！‡苦痛露天競技場:巨牙世界末日!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Orinoko Quebrapresa! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Ориноко Клыколома! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Orinoko Hauerbrecher! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 오리노코 터스크브레이커와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Orinoko Rompecolmillos! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Orinoko Rompecolmillos! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez d’Orinoko Brise-défense ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败奥里努克·碎牙！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗歐令諾寇·碎牙者!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12936] = {
  {
    'Anfiteatro da Angústia: Korrak, o Sanguinário!‡Амфитеатр Страданий: Коррак Кровопуск!‡Das Amphitheater der Agonie: Korrak der Blutrünstige!‡고뇌의 투기장: 피의 광전사 콜라크!‡El Anfiteatro de la Angustia: ¡Korrak el Sanguinario!‡El Anfiteatro de la Angustia: ¡Korrak el Sanguinario!‡L\'Amphithéâtre de l\'Angoisse : Korrak le Ragesang !‡痛苦斗兽场：血怒者科尔拉克！‡苦痛露天競技場:『血怒者』科爾拉克!',
    nil,
    'Entre na arena do Anfiteatro da Angústia e derrote Korrak, o Sanguinário! Fale com Wodin, o Serviçal Troll, para resgatar o seu prêmio.‡Выйдите на арену в Амфитеатре Страданий и победите Коррака Кровопуска! Потом вернитесь к троллю-прислужнику Водину и получите награду.‡Betretet die Arena im Amphitheater der Agonie und besiegt Korrak den Blutrünstigen! Kehrt zu Wodin dem Trolldiener zurück, um Eure Belohnung entgegenzunehmen.‡고뇌의 투기장 안으로 들어가 피의 광전사 콜라크와 싸워 이기십시오! 승리를 거둔 다음, 하수인 우딘에게 돌아가면 보상을 받을 수 있습니다.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Korrak el Sanguinario! Habla con Wodin el sirviente trol para recoger tu recompensa.‡¡Entra en la arena del Anfiteatro de la Angustia y derrota a Korrak el Sanguinario! Habla con Wodin el sirviente trol para recoger tu recompensa.‡Entrez dans l’arène de l’Amphithéâtre de l’Angoisse et triomphez de Korrak le Ragesang ! Ensuite, allez voir Wodin le Serviteur-troll pour toucher votre récompense.‡进入痛苦斗兽场，击败血怒者科尔拉克！回到巨魔仆从伍迪那里领取你的奖励。‡進入苦痛露天競技場並且擊敗『血怒者』科爾拉克!然後去找『食人妖僕從』烏丁領賞。',
  }
},
[12937] = {
  {
    'Alívio aos que tombaram‡Исцеление раненых‡Unterstützung für die Gefallenen‡부상자 치료하기‡Alivio para los caídos‡Alivio para los caídos‡Soulager les blessés‡救死扶伤‡解救倒下者',
    nil,
    'Use o Cataplasma Terrano para curar 8 Defensores Terranos Caídos e fale novamente com Petrenedo, o Moldador de Rochas, no Refúgio do Petrenedo.‡Используйте земляные примочки, чтобы вылечить 8 раненых земельников-защитников, потом возвращайтесь к Глыбоскалу Камнетесу в Приют Глыбоскала.‡Heilt mithilfe der Vulkanschlammpackung 8 gefallene Irdene Verteidiger und kehrt anschließend zu Bergfels dem Steinformer in Bergfels\' Zuflucht zurück.‡대지의 붕대를 사용해 약해진 토석인 수호병 8명을 치료한 후, 바울더크랙의 은거처에 있는 돌조각장이 바울더크랙에게 돌아가야 합니다.‡Usa la cataplasma telúrica para sanar a 8 defensores terráneos caídos, después habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Usa la cataplasma telúrica para sanar a 8 defensores terráneos caídos, después habla con Pedruscón el Creador de rocas en el Refugio de Pedruscón.‡Utilisez le Cataplasme tellurique pour soigner 8 Défenseurs terrestres tombés au combat, puis retournez voir Rochecombe le Sculpteroc au Refuge de Rochecombe.‡使用土质药膏治疗8名倒下的土灵防御者，然后返回布德克拉格庇护所，向塑石者布德克拉格复命。‡使用脈流糊藥治療8個倒下的土靈防衛者，然後回到石崖避難所找『塑岩者』石崖。',
  }
},
[12938] = {
  {
    'O duque‡Герцог‡Der Herzog‡공작‡El Duque‡El Duque‡Le duc‡公爵‡公爵',
    nil,
    'Fale com o Duque Lankral na Abóbada das Sombras.‡Поговорите с герцогом Ланкралом в Мрачном Своде.‡Sprecht mit Herzog Lankral im Schattengewölbe.‡어둠의 무기고에서 공작 란크랄과 대화해야 합니다.‡Habla con el duque Lankral en La Cámara de las Sombras.‡Habla con el duque Lankral en La Cámara de las Sombras.‡Parlez au Duc Lankral au Caveau des Ombres.‡与暗影拱顶的兰克拉尔公爵谈一谈。‡與暗影穹殿的蘭克洛公爵交談。',
  }
},
[12939] = {
  {
    'Desafio de honra‡Вызов чести‡Ehrenhafte Herausforderung‡명예로운 도전‡Desafío de honor‡Desafío de honor‡Un défi pour l\'honneur‡荣耀的挑战‡榮耀挑戰',
    nil,
    'O Duque Lankral, na Abóbada das Sombras, quer que você use a Bandeira de Desafio para desafiar e derrotar 6 Combatentes Mjordin.‡Возьмите флаг вызова, вызовите на поединок и победите 6 мьординских бойцов по просьбе герцога Ланкрала из Мрачного Свода.‡Herzog Lankral vom Schattengewölbe bittet Euch, die Herausforderungsflagge zu nutzen und 6 Mjordinkrieger zu besiegen.‡어둠의 무기고에 있는 공작 란크랄이 도전 깃발을 가지고 가서 미요르딘 전투원 6명을 처치하라고 했습니다.‡El duque Lankral en La Cámara de las Sombras te ha pedido que uses la bandera de desafío para que desafíes y derrotes a 6 combatientes Mjordin.‡El duque Lankral en La Cámara de las Sombras te ha pedido que uses la bandera de desafío para que desafíes y derrotes a 6 combatientes Mjordin.‡Le Duc Lankral, au Caveau des Ombres, vous a demandé d\'utiliser le Drapeau de défi pour défier et vaincre 6 Combattants de Mjordin.‡暗影拱顶的兰克拉尔公爵要你使用挑战之旗向6名尤尔丁格斗者发起挑战，并击败他们。‡暗影穹殿的蘭克洛公爵要你用挑戰旗幟挑戰並擊敗6個默約丁戰鬥員。',
  }
},
[12940] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12941] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12942] = {
  {
    'Fora com as asas negras‡Черные крылья‡Reißt ihnen die schwarzen Schwingen aus‡날개를 꺾어라‡Fuera sus alas negras‡Fuera sus alas negras‡Qu\'on leur coupe leurs ailes noires !‡黑暗的羽翼‡斬下她們的黑翼',
    nil,
    'Iva, a Vingativa, na Aldeia Brunnhildar, quer que você vá a Valkyrion e mate 12 Val\'kyr Nascentes.‡По заданию Ивы Мстительной из деревни Бруннхильдар отправляйтесь в Валькирион и убейте 12 рождающихся валь\'кир.‡Iva die Rachsüchtige in Brunnhildar möchte, dass Ihr nach Valkyrion geht und 12 werdende Val\'kyr erschlagt.‡발키리온에서 발키르 지원자 12명을 처치한 후, 브룬힐다르 마을에 있는 복수심에 불타는 이바에게 돌아가야 합니다.‡Iva la Vengativa en el poblado Brunnhildar quiere que vayas a Valkyrion y mates a 12 Val\'kyr nacientes.‡Iva la Vengativa en el Poblado Brunnhildar quiere que vayas a Valkyrion y mates a 12 Val\'kyr nacientes.‡Iva la Vengeresse à Brunnhildar vous demande de vous rendre à Valkyrion et de tuer 12 Val\'kyrs naissantes.‡布伦希尔达村的复仇者伊芬要你去瓦基里安杀死12个初生的瓦格里。‡布倫希爾達村的『復仇』伊娃要你去華爾基倫殺死12個初生的華爾琪。',
  }
},
[12943] = {
  {
    'O decreto da Abóbada das Sombras‡Указ Мрачного Свода‡Erlass des Schattengewölbes‡어둠의 무기고 율령‡Decreto de La Cámara de las Sombras‡Decreto de La Cámara de las Sombras‡Le décret du caveau des Ombres‡暗影拱顶裁决令‡暗影穹殿敕令',
    nil,
    'O Duque Lankral, na Abóbada das Sombras, ordenou que você leia o Decreto da Abóbada das Sombras na presença de Thane Ufrang, o Potente, e, em seguida, mate-o.‡Зачитайте указ Мрачного Свода, составленный герцогом Ланкралом, тану Уфрангу Могущественному, после чего убейте Уфранга.‡Herzog Lankral vom Schattengewölbe hat angeordnet, dass Ihr den Erlass des Schattengewölbes laut vor Than Ufrang dem Mächtigen vorlest und ihn dann tötet.‡어둠의 무기고에 있는 공작 란크랄이 강력한 영주 우프랑 앞에서 어둠의 무기고 율령을 읽은 다음, 처치하라고 명령했습니다.‡El duque Lankral en La Cámara de las Sombras te ha ordenado que leas el decreto de La Cámara de las Sombras en presencia del señor feudal Ufrang el Poderoso y después lo mates.‡El duque Lankral en La Cámara de las Sombras te ha ordenado que leas el decreto de La Cámara de las Sombras en presencia del señor feudal Ufrang el Poderoso y después lo mates.‡Le Duc Lankral, au Caveau des Ombres, vous a ordonné de lire le Décret du caveau des Ombres en présence du Thane Ufrang le Puissant, puis de le tuer.‡暗影拱顶的兰克拉尔公爵命令你向强大的乌弗朗领主宣读暗影拱顶裁决令，然后杀死他。‡暗影穹殿的蘭克洛公爵命令你在『強者』烏弗蘭族長面前朗讀暗影穹殿敕令，然後殺了他。',
  }
},
[12944] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12945] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12946] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
