    nil,
  }
},
[4808] = {
  {
    'Felnok Molaço‡Фелнок Сталлист‡Felnok Stahlfeder‡펠노크 스틸스프링‡Felnok Acerovera‡Felnok Acerovera‡Felnok Ressordacier‡菲诺克‡菲諾克',
    nil,
    'Give Tinkee\'s Letter to Felnok Steelspring at Everlook in Winterspring.‡Отнесите письмо Тинки Фелноку Сталлисту в Круговзор, что в Зимних Ключах.‡Gebt Felnok Stahlfeder in der Ewigen Warte in Winterquell Tinkees Brief.‡여명의 설원의 눈망루 마을에 있는 팅키의 편지를 펠노크 윈터스프링에게 가져다주어야 합니다.‡Entrégale la carta de Tinkee a Felnok Acerovera en Vista Eterna, en Cuna del Invierno.‡Entrégale la carta de Tinkee a Felnok Acerovera en Vista Eterna, en Cuna del Invierno.‡Donner la Lettre de Brikolette à Felnok Ressordacier à Long-guet, à Berceau-de-l\'Hiver.‡把丁奇的信交给冬泉谷永望镇的菲诺克。‡到冬泉谷的永望鎮，把丁奇的信交給菲諾克。',
  }
},
[4809] = {
  {
    'Chifres de ventogelante‡Рога хладнокрылов‡Hörner der Eiswindschimären‡서리바람 키메라의 뿔‡Cuernos de Orvallo‡Cuernos de Orvallo‡Cornes de Noroît‡冰风奇美拉角‡冰風奇美拉角',
    nil,
    'Collect 8 Uncracked Chillwind Horns.‡Добудьте 8 безупречных рогов хладнокрыла.‡Beschafft Euch 8 unbeschädigte Hörner.‡온전한 서리바람 키메라의 뿔 8개를 모아야 합니다.‡Reúne 8 cuernos de quimera del Orvallo.‡Reúne 8 cuernos de quimera del Orvallo.‡Collectez 8 Cornes intactes de Noroît.‡收集8支完整的冰风奇美拉角。‡收集8支完整的冰風奇美拉角。',
  }
},
[4810] = {
  {
    'Fale novamente com Vera‡Возвращение к Тинки‡Rückkehr zu Tinkee‡팅키에게 돌아가는 길‡Regresa junto a Tinkee‡Regresa junto a Tinkee‡Retourner voir Brikolette‡返回丁奇身边‡返回丁奇身邊',
    nil,
    'Bring Felnok\'s Package to Tinkee Steamboil at Flame Crest in the Burning Steppes.‡Отнесите ящик Фелнока Тинки Кипеллер в Пылающие степи. Ее можно найти возле Пламенеющего Стяга.‡Bringt Tinkee Kesseldampf auf dem Flammenkamm in der brennenden Steppe Felnoks Päckchen.‡불타는 평원의 화염 마루에 있는 팅키 스팀보일에게 펠노크의 소포를 가져가야 합니다.‡Llévale el paquete de Felnok a Tinkee Vaporio en el Peñasco Llamarada en Las Estepas Ardientes.‡Llévale el paquete de Felnok a Tinkee Vaporio en el Peñasco Llamarada en Las Estepas Ardientes.‡Apporter le Paquet de Felnok à Brikolette Toutevapeur à la Corniche des flammes, dans les Steppes ardentes.‡把菲诺克的包裹交给燃烧平原烈焰峰的丁奇·斯迪波尔。‡到燃燒平原把菲諾克的包裹交給烈焰峰的丁奇·斯迪波爾。',
  }
},
[4811] = {
  {
    'O cristal vermelho‡Красный кристалл‡Der rote Kristall‡붉은 수정‡El cristal rojo‡El cristal rojo‡Le cristal rouge‡红色水晶‡紅色水晶',
    nil,
    'Viaje para o leste de Auberdine e procure por um grande cristal vermelho na montanha leste da Costa Negra. Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Направляйтесь на восток от Аубердина и поищите большой красный кристалл в горной гряде на востоке Темных берегов. Вернитесь с докладом к часовому Глинде Нал\'Шие в Аубердин.‡Reist von Auberdine nach Osten und sucht nach einem großen, roten Kristall entlang der östlichen Bergkette von Dunkelküste. Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡어둠의 해안의 동쪽 산맥을 따라 아우버다인 동쪽으로 가서 거대한 붉은 수정을 찾은 다음 아우버다인에 있는 파수꾼 글린다 날셰에게 보고해야 합니다.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Viaja al este de Auberdine y busca un gran cristal rojo en la zona montañosa que hay al este de Costa Oscura. Vuelve a Auberdine e informa de lo que has encontrado a la centinela Glynda Nal\'Shea.‡Voyager en direction de l\'est en partant d\'Auberdine et chercher un gros cristal rouge le long de la chaîne de montagne est de Sombrivage. Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡到奥伯丁的东边去，沿着黑海岸东部边界的山脉寻找一颗巨大的红色水晶，然后向奥伯丁的哨兵戈琳达·纳希恩汇报你的发现。‡到奧伯丁的東邊去，沿著黑海岸東部邊界的山脈尋找一顆巨大的紅色水晶，然後向奧伯丁的哨兵戈琳達·納希恩彙報你的發現。',
  }
},
[4812] = {
  {
    'Como cascatas‡Пока струится вода...‡Wenn das Wasser fließt‡수정에 물이 흐르면‡Agua en cascada‡Agua en cascada‡Comme l\'eau tombe en cascade‡清洗水晶‡清洗水晶',
    nil,
    'Encha o Tubo de Água Vazio no poço lunar de Auberdine, e depois investigue o cristal vermelho na encosta da montanha leste da Costa Negra.‡Наполните пустую колбу для воды в лунном колодце Аубердина, а затем исследуйте красный кристалл, находящийся в горной гряде на востоке Темного Берега.‡Füllt die leere Wasserröhre am Mondbrunnen von Auberdine und untersucht dann den roten Kristall an der östlichen Bergkette von Dunkelküste.‡빈 시험관에 아우버다인의 달샘 물을 채운 후 어둠의해안의 동쪽 산에 있는 붉은 수정을 찾아 조사해야 합니다.‡Llena el tubo de agua vacío en la Poza de la Luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Llena el tubo de agua vacío en la Poza de la Luna de Auberdine y luego examina el cristal rojo a lo largo de la pared montañosa oriental de Costa Oscura.‡Remplir le Tube d\'eau vide au Puits de lune d\'Auberdine, puis chercher le cristal rouge le long des falaises des montagnes à l\'est de Sombrivage.‡在奥伯丁月亮井中把空水瓶装满，然后调查黑海岸东部山脉的红水晶。‡在奧伯丁月井中把空水瓶裝滿，然後調查黑海岸東部山脈的紅水晶。',
  }
},
[4813] = {
  {
    'Fragmentos incrustados‡Скрытые фрагменты‡Die Fragmente im Inneren‡수정 안의 뼈‡Los trozos del interior‡Los trozos del interior‡Les fragments à l\'intérieur‡水晶中的碎骨‡水晶中的碎骨',
    nil,
    'Relate o que você descobriu à Sentinela Glynda Nal\'Shea, em Auberdine.‡Доложите о результатах ваших изысканий часовому Глинде Нал\'Шие в Аубердине.‡Informiert Schildwache Glynda Nal\'Shea in Auberdine über Eure Erkenntnisse.‡아우버다인에 있는 파수꾼 글린다 날셰에게 알아 낸 사실을 보고해야 합니다.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Vuelve a Auberdine e informa de lo que has averiguado a la centinela Glynda Nal\'Shea.‡Aller faire un rapport de ce que vous avez trouvé à la Sentinelle Glynda Nal\'Shea à Auberdine.‡向奥伯丁的哨兵哨兵戈琳达·纳希恩报告你的发现。‡向奧伯丁的哨兵哨兵戈琳達·納希恩報告你的發現。',
  }
},
[4821] = {
  {
    'Ovo alienígena‡Странное яйцо‡Fremdartiges Ei‡괴상한 알‡Un huevo extraño‡Un huevo extraño‡L\'œuf étrange‡异型卵‡異型卵',
    nil,
    'Leve o Ovo Alienígena a Hagar Casco de Raio, na Aldeia Vento Livre.‡Принесите странное яйцо Хагару Грозовому Копыту на Заставу Вольного Ветра.‡Bringt Hagar Blitzhuf am Freiwindposten das fremdartige Ei.‡높새바람 봉우리에 있는 하가르 라이트닝후프에게 괴상한 알을 가져가야 합니다.‡Devuélvele el huevo extraño a Hagar Pezuña del Rayo, que está en el Poblado Viento Libre.‡Devuélvele el huevo extraño a Hagar Pezuña del Rayo, que está en el Poblado Viento Libre.‡Rapporter l\'Œuf étrange à Hagar Sabot-de-foudre au Poste de Librevent.‡把异型卵交给乱风岗的哈加尔·雷蹄。‡把異型卵交給亂風崗的哈加爾·雷蹄。',
  }
},
[4822] = {
  {
    '‡Детям – мороженое!‡Lecker Eis‡아이스크림! 아이스크림!‡¡Quiero un heladooooo!‡¡Quiero un heladooooo!‡Je veux une glaaaaace!‡草莓冰激凌*‡',
    nil,
    '‡Купите своему подопечному клубничное мороженое. Кажется, мальчик предпочитает мороженое Тигуля и Форора.‡Besorgt für Euren Schützling etwas Erdbeereis. Der Kleine scheint die Marke \'Tigules und Forors Eiscreme\' zu bevorzugen.‡‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Consigue helado de fresa para tu pupilo. Parece que el favorito del muchacho es el helado de Tigule y Foror.‡Allez chercher de la glace à la fraise pour votre protégé. Le gamin semble préférer la marque de glace Aguilor & Dagharn.‡为你看护的孩子买一些草莓冰激凌。这个孩子似乎最喜欢“提古勒和弗洛尔”牌的草莓冰激凌。‡',
  }
},
[4841] = {
  {
    'Pacifique o Centauro‡Упокоение кентавров‡Befriedung der Zentauren‡켄타우로스 처치‡Apaciguar al centauro‡Apaciguar al centauro‡Pacifier les centaures‡清除半人马‡清除半人馬',
    nil,
    'Mate 12 Batedores Galath, 10 Cavalgantes Galath e 6 Ventilhões Galath, depois fale novamente com o Vigia do Rochedo Chifre Longo na Aldeia Vento Livre.‡Убейте 12 разведчиков, 10 пастухов и 6 ветроловок из племени Галак, после чего вернитесь к дозорному утесов Долгорогу на Заставу Вольного Ветра.‡Tötet 12 Späher der Galak, 10 Zänker der Galak sowie 6 Windjäger der Galak und kehrt dann zu Klippenbehüter Langhorn am Freiwindposten zurück.‡갈라크일족 척후병 12명, 갈라크일족 사냥꾼 10명, 갈라크일족 바람전사 6명을 처치한 후, 높새바람 봉우리에 있는 절벽파수꾼 롱혼에게 돌아가야 합니다.‡Mata a 12 exploradores Galak, 10 vaqueros Galak y 6 cazavientos Galak, y después ve a ver de nuevo a Vigiarisco Cuerno Largo al Poblado Viento Libre.‡Mata a 12 exploradores Galak, 10 retadores Galak y 6 cazavientos Galak, y después ve a ver de nuevo al vigiarrisco Cuerno Largo al Poblado Viento Libre.‡Tuer 12 Eclaireurs galak, 10 Querelleurs galak, et 6 Chasse-vent galak, puis retourner auprès du garde-falaise Longue-corne au Poste de Librevent.‡杀掉12个加拉克斥候、10个加拉克争斗者和6个加拉克逐风者，然后向乱风岗的峭壁卫兵图林·长角复命。‡殺掉12個加拉克斥候、10個加拉克爭吵者和6個加拉克逐風者，然後向亂風崗的峭壁看守者長角覆命。',
  }
},
[4842] = {
  {
    'Fontes estranhas‡Выяснение причин‡Sonderbare Quellen‡이상한 근원‡Fuentes extrañas‡Fuentes extrañas‡Sources étranges‡奇怪的源头‡奇怪的源頭',
    nil,
    'Siga as instruções de Bruna Covaneve, depois fale novamente com ela.‡Последуйте указаниям Доновы Снегоноры, а затем вернитесь к ней.‡Befolgt Donova Schneewehs Anweisungen und meldet Euch dann wieder bei ihr.‡도노바 스노우덴의 지시를 따라 탐색을 한 후 되돌아가야 합니다.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Sigue las indicaciones de Donova Cubilnevado y vuelve a informarle.‡Suivre les instructions de Donova Antreneige, puis faire un rapport.‡根据多诺瓦·雪山的指示行动，然后回到她那里报告。‡根據多諾瓦·雪山的指示行動，然後回到她那裡報告。',
  }
},
[4861] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre o acampamento destruído e os suprimentos de Jaron Moldapedra na parte sul de Hibérnia.‡Найдите разоренный лагерь Джерона Гранильщика и его припасы на юге Зимних Ключей.‡Findet Jaron Steinschleifers ruiniertes Lager samt dessen Vorräten im südlichen Winterquell.‡여명의 설원 남부 지역에서 야론 스톤셰이퍼의 야영지를 찾아서 부서진 보급품 상자를 되찾아 와야 합니다.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiza el campamento arrasado y los suministros de Jaron Tallapiedras en la parte sur de Cuna del Invierno.‡Localiser le camp démoli et les fournitures de Jaron Sculptepierre, au sud du Berceau-de-l\'Hiver.‡在冬泉谷的南部寻找加隆·石矛的被破坏的营帐，以及他的补给物资。‡在冬泉谷的南部尋找加隆·石矛的被破壞的營帳，以及他的補給物資。',
  }
},
[4862] = {
  {
    'Nojento!‡Товар на любителя‡Be-Öh-Es-Eh‡더러운 거미알‡Bestia amaestrada‡Bestia amaestrada‡Mauvais‡蜘蛛卵‡蜘蛛卵',
    nil,
    'Vá para o Pico da Rocha Negra e colete 15 Ovos de Aranha do Pináculo para Kibler.|n|nPelo nome, é de se pensar que eles fiquem perto das aranhas.|n‡Отправьтесь на пик Черной горы и принесите Киблеру 15 яиц скального паука.|n|nСудя по всему, яйца надо искать недалеко от пауков.‡Reist zur Schwarzfelsspitze und sammelt 15 Spitzenspinneneier für Kibler.|n|nLogischerweise müsstet Ihr diese Eier in der Nähe von Spinnen finden.‡검은바위 첨탑으로 가서 키블러를 위해 첨탑 거미알 15개를 수집해야 합니다.|n|n들리는 소문으로는 그 알들은 거미들이 서식하는 근처에서 찾을 수 있다고 합니다.‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|n|nYo diría que se pueden encontrar estos huevos cerca de arañas.|n‡Viaja a la Cumbre de Roca Negra y reúne 15 huevos de araña de la cumbre para Kibler.|n|nYo diría que se pueden encontrar estos huevos cerca de arañas.|n‡Aller au Pic Rochenoire et ramasser 15 Œufs d\'araignée du pic pour Kibler.|n|nCes œufs peuvent être trouvés à proximité des araignées.‡到黑石塔去为基布雷尔收集15枚尖塔蜘蛛卵。|n|n听说那些蜘蛛周围有许多这样的卵。‡到黑石塔去為基布雷爾收集15枚尖塔蜘蛛卵。|n|n聽說那些蜘蛛周圍有許多這樣的卵。',
  }
},
[4863] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Encontre a carroça destruída de Jaron Moldapedra.‡Найдите опрокинутый фургон Джерона Гранильщика.‡Sucht Jaron Steinschleifers zerstörten Wagen.‡야론 스톤셰이퍼의 부서진 마차를 찾아야 합니다.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Encuentra el carro destrozado de Jaron Tallapiedras.‡Trouver le chariot saccagé de Jaron Sculptepierre.‡找到加隆·石矛的马车。‡找到加隆·石矛的馬車。',
  }
},
[4864] = {
  {
    'Coruscante enfurecido‡Взбесившиеся дикие совухи‡Wütende Wildekin‡성난 올빼미야수‡Lechúcico salvaje iracundo‡Lechúcico salvaje iracundo‡Les Indomptables enragés‡被激怒的枭兽‡被激怒的梟獸',
    nil,
    'Pegue os Suprimentos do Jaron na neve, depois encontre o coruscante que roubou o amuleto de que Jaron falou.|n|nEntregue os Suprimentos do Jaron e o Amuleto de Penas Azuis para Jaron Moldapedra na cabana, em Hibérnia.‡Подберите припасы Джерона из снега, и найдите дикого совуха, похитившего амулет, о котором говорил Джерон.|n|nПринесите припасы и ожерелье миних перьев Джерону Гранильщику в его дом в Зимних Ключах.‡Klaubt Jarons Ladung aus dem Schnee und sucht dann die Wildekin, die das Amulett gestohlen haben, von dem Jaron gesprochen hatte.|n|nBringt Jaron Steinschleifer in der Lodge in Winterquell dessen Ladung und das blaugefiederte Amulett.‡눈 속에서 야론의 보급품을 회수한 다음, 야론이 찾는 아뮬렛을 훔친 올빼미야수들을 찾아야 합니다.|n|n여명의 설원, 별똥별 마을에 있는 야론 스톤셰이퍼에게 야론의 보급품과 푸른 깃털달린 아뮬렛을 갖다주어야 합니다.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.|n|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Recoge de la nieve los Suministros de Jaron y encuentra al lechúcico salvaje que robó el amuleto del que te habló Jaron.|n|nLleva los Suministros de Jaron y el Amuleto de plumas azules a Jaron Tallapiedras en el refugio de Cuna del Invierno.‡Ramasser les Fournitures de Jaron dans la neige, puis trouver l\'Indomptable qui a volé l\'amulette dont Jaron a parlé.|n|nRapporter les fournitures de Jaron et l\'Amulette de la plume bleue à Jaron Sculptepierre dans son pavillon au Berceau-de-l\'Hiver.‡从雪地中拾起加隆的补给物资，然后寻找盗取加隆所说的护符的枭兽。|n|n将加隆的补给物资和蓝色羽毛护符交给冬泉谷的加隆-石矛。‡從雪地中拾起加隆的補給物資，然後尋找加隆所說偷走護符的梟獸。|n|n將加隆的補給物資和藍色羽毛護符交給冬泉谷小屋的加隆·石矛。',
  }
},
[4865] = {
  {
    'Selva da serpente‡Змеиная дикость‡Wilde Schlange‡뱀의 복수‡Venganza‡Venganza‡Serpent sauvage‡狂热之蛇‡狂熱之蛇',
    nil,
    'Report your findings to Motega Firemane at Whitereach Post in Thousand Needles.‡Расскажите о найденном Мотеге Огненной Гриве на Заставе Белого Плеса, что в Тысяче Игл.‡Berichtet Motega Feuermähne von Euren Entdeckungen. Zu finden ist er im Weißgipfelposten in Tausend Nadeln.‡버섯구름 봉우리의 백사장 야영지에 있는 모테가 파이어메인에게 발견한 사실을 보고해야 합니다.‡Cuéntale lo que has descubierto a Motega Crin de Fuego en el Campamento del Tramo Blanco, en Las Mil Agujas.‡Cuéntale lo que has descubierto a Motega Crin de Fuego en el Campamento del Tramo Blanco, en Las Mil Agujas.‡Faire un rapport de vos trouvailles à Motega Crin-de-feu au Poste de Blanc-relais, aux Milles pointes.‡向千针石林白沙岗哨的莫特加·火鬃汇报你的发现。‡到千針石林的白沙崗哨向莫特加·火鬃彙報你的發現。',
  }
},
[4866] = {
  {
    'Leite materno‡Материнское молоко‡Muttermilch‡여왕 거미의 독‡La leche de la madre‡La leche de la madre‡Le lait matriarcal‡蛛后的乳汁‡蛛后的乳汁',
    nil,
    'No coração do Pico da Rocha Negra você vai encontrar a Mãe Queimateia. Chame a atenção dela e deixe-a envenenar você. É bem provável que você precise matá-la também. Fale novamente com João Roto depois que for envenenado para que ele possa "ordenhar" você.‡Найдите в самом сердце пика Черной горы мать Дымную Паутину. Сражайтесь с ней, пока она не введет вам свой яд. Скорее всего ее также придется убить. Когда яд будет в вас, вернитесь к Джону-Оборванцу, чтобы он смог добыть яд.‡Ihr findet Mutter Glimmernetz im Herzen der Schwarzfelsspitze. Kämpft mit ihr und bringt sie dazu, Euch zu vergiften. Es kann gut sein, dass Ihr sie sogar töten müsst. Kehrt zum struppigen John zurück, sobald Ihr vergiftet seid, damit er Euch \'melken\' kann.‡검은바위 첨탑 중심부에서 여왕 불그물거미를 찾을 수 있습니다. 여왕 불그물거미를 공격하거나 접근하여 그 독에 중독되어야 합니다. 독에 걸릴 확률을 높이기 위해서는 거미를 죽여야 할 수도 있습니다. 중독되면 털보 존에게 돌아가서 그가 그 독을 추출하게 해야 합니다.‡En el corazón de la Cumbre de Roca Negra encontrarás a Madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡En el corazón de la Cumbre de Roca Negra encontrarás a Madre Telabrasada. Provócala para que te envenene. Lo más seguro es que tendrás que matarla también. Vuelve junto a John Andrajoso cuando estés envenenado para que pueda extraer el veneno de ti.‡Vous trouverez la Matriarche Couveuse au cœur du pic Rochenoire. Attaquez-la et poussez-la à vous empoisonner. Vous devrez sans doute la tuer. Une fois empoisonné, trouvez John le Loqueteux afin qu\'il puisse prélever un échantillon.‡你可以在黑石塔的中心地带找到烟网蛛后。与她战斗，让她在你体内注入毒汁。如果你有能力的话，就杀死她吧。当你中毒之后，回到狼狈不堪的约翰那儿，他会从你的身体里抽取这些"蛛后的乳汁"。‡你可以在黑石塔的中心地帶找到煙網蛛后。與她戰鬥，讓她在你體內注入毒汁。如果你有能力的話，就殺死她吧。當你中毒之後，回到狼狽不堪的約翰那兒，他會從你的身體裡抽取這些「蛛后的乳汁」。',
  }
},
[4867] = {
  {
    'Urok Uivo-da-ruína‡Аррок Смертный Вопль‡Urok Schreckensbote‡우로크 둠하울‡Urok Aullapocalipsis‡Urok Aullasino‡Urok Hurleruine‡乌洛克‡烏洛克·末日嚎',
    nil,
    'Leia o Pergaminho do Warosh. Traga o Mojo do Warosh para Warosh.‡Прочитайте записку Вароша. Принесите Варошу его амулет.‡Lest Waroshs Rolle. Bringt Waroshs Mojo zu Warosh.‡와로쉬의 두루마리를 읽어야 합니다. 와로쉬에게 그의 부적을 가져가야 합니다.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lee el pergamino de Warosh. Llévale el mojo de Warosh a Warosh.‡Lire le Parchemin de Warosh. Apporter le Mojo de Warosh à Warosh.‡阅读瓦罗什的卷轴。将瓦罗什的蟑螂交给他。‡閱讀瓦羅什的卷軸。將瓦羅什的魔精交給他。',
  }
},
[4881] = {
  {
    'Plano de assassinato‡Убийственный заговор‡Auftragsmordplan‡암살 음모‡Complot de asesinato‡Complot de asesinato‡Complot d\'assassinat‡暗杀计划‡暗殺計畫',
    nil,
    'Alerte Kanati Nuvem Cinzenta, no Posto Confinalvo, do plano para assassiná-lo.‡Предупредите Канати Серое Облако на заставе Белого Плеса, что на него готовится покушение.‡Warnt Kanati Grauwolke am Weißgipfelposten, dass man vorhat, ihn zu töten.‡백사장 야영지에 있는 카나티 그레이클라우드에게 가서 암살 음모에 대해 경고해 주어야 합니다.‡Avisa a Kanati Nube Gris, en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Avisa a Kanati Nube Gris, en el Campamento del Tramo Blanco, acerca de la conspiración para acabar con su vida.‡Prévenir Kanati Nuage-gris au Poste de Blanc-relais qu\'un complot le menace.‡将暗杀计划通知给白沙岗哨的卡纳提·灰云。‡將暗殺計畫通知給白沙崗哨的卡納提·灰雲。',
  }
},
[4882] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewachen‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡緊守秘密',
    nil,
    'Leve o Colar de Penas Azuis para Trull Ruinazar, no Posto Peçonha.‡Отнесите ожерелье синих перьев Труллу Баловню Судьбы на заставу Отравленной Крови.‡Bringt Trull Scheiterbann beim Blutgiftposten das blaugefiederte Amulett.‡피멍울 초소에 있는 트룰 페일베인에게 푸른 깃털달린 목걸이를 가져가야 합니다.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Lleva el Collar de plumas azules a Trull Fallarruina en el Puesto del Veneno.‡Apporter le Collier de plumes bleues à Trull Faillemort au Poste de la Vénéneuse.‡把蓝羽项链交给血毒岗哨的特鲁尔-法贝恩。‡把藍羽項鍊交給血毒崗哨的特盧爾·法貝恩。',
  }
},
[4883] = {
  {
    'Segredos guardados‡Умение хранить секреты‡Geheimnisse bewahren‡수호에 대한 비밀‡Guardar un secreto‡Guardar un secreto‡Secrets gardés‡守护秘密‡緊守秘密',
    nil,
    'Leve o Colar de Penas Azuis para Nara Juba Agreste.‡Отнесите ожерелье синих перьев Наре Буйногривой.‡Bringt Nara Wildmähne das blaugefiederte Amulett.‡푸른 깃털달린 목걸이를 나라 와일드메인에게 갖다주어야 합니다.‡Lleva el Collar de plumas azules a Nara Ferocrín.‡Lleva el Collar de plumas azules a Nara Ferocrín.‡Apporter le Collier de plumes bleues à Nara Crin-sauvage.‡把蓝羽项链交给纳拉-蛮鬃。‡把藍羽項鍊交給納拉·蠻鬃。',
  }
},
[4901] = {
  {
    'Guardiões do altar‡Стражи алтаря‡Wächter des Altars‡제단의 수호자‡Guardianes del altar‡Guardianes del altar‡Les gardiens de l\'autel‡祭坛守护者‡祭壇守護者',
    nil,
    'Proteja Ranshalla enquanto ela tenta reativar o Altar de Eluna. Relate suas descobertas a Erelas Ambarcéu, na Vila de Rut\'theran.‡Защитите Раншаллу, пока она пытается активировать алтарь Элуны. Сообщите о ваших находках Эреласу Янтарному Небу в деревне Рут\'теран.‡Schützt Ranshalla, während sie versucht, den Altar von Elune wieder zu aktivieren. Berichtet Erelas Himmelsbern in Rut\'theran von Eurem Fund.‡엘룬의 제단을 여는 과정에서 란샬라를 보호해야 합니다. 성공하면 루테란 마을에 있는 에렐라스 앰버스카이에게 발견한 내용을 보고해야 합니다.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Erelas Cieloámbar de Aldea Rut\'theran.‡Protege a Ranshalla mientras intenta reactivar el Altar de Elune. Informa sobre tus descubrimientos a Erelas Cieloámbar de Aldea Rut\'theran.‡Protéger Ranshalla pendant qu\'elle s\'efforce de réactiver l\'Autel d\'Elune. Faire un rapport de vos découvertes à Erelas Ambreciel, au village de Rut\'theran.‡在兰莎尔拉尝试激活艾露恩祭坛的过程中保护她。然后将你的发现报告给鲁瑟兰村的艾瑞拉斯·琥珀。‡在蘭莎爾拉嘗試啟動伊露恩祭壇的過程中保護她。然後將你的發現報告給魯瑟蘭村的艾瑞拉斯·琥珀。',
  }
},
[4902] = {
  {
    'Coruscante de Eluna‡Питомцы Элуны‡Wildekin von Elune‡엘룬의 올빼미야수‡Lechúcico salvaje de Elune‡Lechúcico salvaje de Elune‡Les Indomptables d\'Elune‡艾露恩的枭兽‡伊露恩的梟獸',
    nil,
    'Fale com o Arquidruida Fandral Guenelmo em Darnassus.‡Поговорите с верховным друидом Фэндралом Оленьим Шлемом в Дарнасе.‡Sprecht mit Erzdruide Fandral Hirschhaupt in Darnassus.‡다르나서스에 있는 대드루이드 판드랄 스테그헬름과 대화해야 합니다.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Habla con el archidruida Fandral Corzocelada en Darnassus.‡Parler à l\'archidruide Fandral Forteramure, à Darnassus.‡与达纳苏斯的大德鲁伊范达尔·鹿盔谈一谈。‡與達納蘇斯的大德魯伊范達爾·鹿盔談話。',
  }
},
[4903] = {
  {
    'O comando do Senhor da Guerra‡Приказ полководца‡Befehl des Kriegsherrn‡장군의 명령‡La orden del Señor de la Guerra‡La orden del Señor de la Guerra‡Ordre du chef de guerre‡高图斯的命令‡高圖斯的命令',
    nil,
    'Mate o Grão-lorde Omokk, o Senhor da Guerra Voone e o Lorde Supremo Wyrmthalak. Recupere Documentos Importantes dos Rocha Negra. Fale novamente com o Senhor da Guerra Trincador, em Karrath, quanto a missão tiver sido cumprida.‡Убейте вождя Омокка, воеводу Вуна и повелителя Змейталака. Найденные при них важные бумаги Черной горы доставьте полководцу Клинозубу в Каргат.‡Tötet Hochlord Omokk, Kriegsmeister Voone und Oberanführer Wyrmthalak. Findet die wichtigen Schwarzfelsdokumente. Kehrt zum Kriegsherrn Bluthauer nach Kargath zurück, sobald Ihr diese Mission erledigt habt.‡대군주 오모크와 대장군 부네, 대군주 웜타라크를 처단해야 합니다. 검은바위의 중요한 문서들을 확보해야 합니다. 임무를 완수하는 대로 카르가스의 장군 고어투스에게로 돌아가야 합니다.‡Mata al Alto señor Omokk, al maestro de guerra Voone y al Señor Supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Mata al alto señor Omokk, al maestro de guerra Voone y al señor supremo Vermiothalak. Recupera importantes documentos Roca Negra. Vuelve junto al señor de la guerra Dientegore en Kargath cuando hayas cumplido la misión.‡Tuer le généralissime Omokk, le maître de guerre Voone et le seigneur Wyrmthalak. Récupérer les Importants documents Rochenoire. Retourner voir le chef de guerre Sangredent à Kargath une fois la mission accomplie.‡杀死欧莫克大王、指挥官沃恩和维姆萨拉克。找到重要的黑石文件，然后向卡加斯的军官高图斯汇报。‡殺死歐莫克大王、將領沃恩和維姆薩拉克主宰。找到重要的黑石文件，然後向卡加斯的督軍高圖斯彙報。',
  }
},
[4904] = {
  {
    'Liberdade, liberdade‡Долгожданная свобода‡Endlich frei‡마침내 자유를‡Al fin libre‡Al fin libre‡Libre, enfin !‡终获解救‡終獲自由',
    nil,
    'Escolte Lakota Cantéolo para fora do Pináculo da Nuvem Negra e depois fale com Thalia Couro Âmbar, na Aldeia Vento Livre.‡Выведите Лакоту Песню Ветра с Пика Темного Облака, а потом поговорите с Талией Янтарной Шкурой на Заставе Вольного Ветра.‡Geleitet Lakota Windweise vom Düsterwolkengipfel hinab und sprecht dann im Freiwindposten mit Thalia Bernhaut.‡라코타 윈드송을 먹구름 봉우리에서 구출한 후, 높새바람 봉우리에 있는 탈리아 앰버하이드와 대화해야 합니다.‡Saca a Lakota Son del Viento de Cumbre de la Nube Negra y después habla con Thalia Pellejo Ámbar, que está en el Poblado Viento Libre.‡Saca a Lakota Son del Viento de Cumbre de la Nube Negra y después habla con Thalia Ocultaámbar, que está en el Poblado Viento Libre.‡Escorter Lakota Chant-du-vent hors de la Cime de Noir-nuage, puis parler à Thalia Peau-d\'ambre au Poste de Librevent.‡护送拉克塔·风歌离开恐怖图腾营地，然后与乱风岗的萨利亚谈一谈。‡護送拉克塔·風歌離開恐怖圖騰營地，然後與亂風崗的薩利亞談話。',
  }
},
[4905] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud‡Defend Kanati Greycloud',
  }
},
[4906] = {
  {
    'Mais corrupção‡Снова порча!‡Weitere Verderbnis‡오염의 확산‡Más corrupción‡Más corrupción‡Plus de corruption‡更深重的堕落‡更深重的墮落',
    nil,
    'Eridan Brisazul, na Selva Maleva, quer que você mate 8 Infernarautos Flamejade, 8 Traidores Flamejade, 8 Trapaceiros Flamejade e Xavaric. Fale novamente com Eridan quando a tarefa estiver concluída.‡Эридана Грусть Ветра из Оскверненного леса просит вас убить 8 призывателей Пламени, 8 предателей и 8 плутов из племени Нефритового Пламени, а также Ксаварика. По выполнении задания возвращайтесь к Эридане.‡Eridan Blauwind im Teufelswald möchte, dass Ihr Xavaric sowie 8 Jadefeuerhöllenrufer, 8 Jadefeuerverräter und 8 Jadefeuerschwindler tötet. Kehrt zu Eridan zurück, sobald Ihr die Aufgabe erfüllt habt.‡에리단 블루윈드를 위해 비취불꽃 지옥소환사 8명과 배반자 8명, 요술사 8명과 사바릭을 처치하고 에리단에게 돌아가야 합니다.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Vientoazul de Frondavil quiere que mates a 8 clamainfernos Fuego de Jade, 8 traidores Fuego de Jade, 8 timadores Fuego de Jade y a Xavaric. Vuelve con Eridan cuando lo hayas hecho.‡Eridan Ventebleu de Gangrebois veut que vous tuiez 8 Implorateurs de l\'enfer Jadefeu, 8 Traîtres Jadefeu, 8 Entourloupeurs Jadefeu et Xavaric. Revenez auprès d\'Eridan une fois la tâche accomplie.‡费伍德森林的艾瑞丹·蓝风要你去杀掉8个碧火唤魔者、8个碧火背叛者、8个碧火欺诈者和萨瓦里克。任务完成之后回到艾瑞丹那里复命。‡費伍德森林的艾瑞丹·藍風要你去殺掉8個碧火喚魔者、8個碧火背叛者、8個碧火欺詐者和薩瓦里克。任務完成之後回到艾瑞丹那裡覆命。',
  }
},
[4907] = {
  {
    'Vera Brequim‡Тинки Кипеллер‡Tinkee Kesseldampf‡팅키 스팀보일‡Tinkee Vaporio‡Tinkee Vaporio‡Brikolette Toutevapeur‡丁奇·斯迪波尔‡丁奇·斯迪波爾',
    nil,
    'Speak with Tinkee Steamboil at Flame Crest in the Burning Steppes.‡Поговорите с Тинки Кипеллер. Ее можно найти возле Пламенеющего Стяга в Пылающих степях.‡Sprecht mit Tinkee Kesseldampf auf dem Flammenkamm in der brennenden Steppe.‡불타는 평원의 화염 마루에 있는 팅키 스팀보일과 대화해야 합니다.‡Habla con Tinkee Vaporio en el Peñasco Llamarada, en las Estepas Ardientes.‡Habla con Tinkee Vaporio en el Peñasco Llamarada, en las Estepas Ardientes.‡Parler à Brikolette Toutevapeur à la Corniche des flammes, dans les Steppes ardentes.‡与燃烧平原烈焰峰的丁奇·斯迪波尔谈一谈。‡到燃燒平原的烈焰峰與丁奇·斯迪波爾談話。',
  }
},
[4921] = {
  {
    'Perdida em combate‡Пропавшая без вести‡In der Schlacht vermisst‡전쟁으로 잃은 아내‡Perdida en la batalla‡Perdida en la batalla‡Disparition au combat‡在战斗中失踪‡在戰鬥中失蹤',
    nil,
    'Encontre a Mulher de Mankrik e depois fale novamente com ele na Encruzilhada.‡Отыщите жену Манкрика и возвращайтесь к нему в Перекресток.‡Sucht Mankriks Frau und kehrt dann zu ihm in die Siedlung beim Wegekreuz zurück.‡크로스로드에 있는 만크릭을 위해 그의 아내의 흔적을 찾아 돌아가야 합니다.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Encuentra a la esposa de Mankrik y llévala a El Cruce.‡Trouver la femme de Mankrik puis retourner le voir à la Croisée.‡找到曼科里克的妻子，然后回到十字路口找他。‡找到曼寇里克的妻子，然後回到十字路口找他。',
  }
},
[4941] = {
  {
    'A sabedoria de Eitrigg‡Мудрость Эйтригга‡Etriggs Weisheit‡아이트리그의 지혜‡La sabiduría de Eitrigg‡La sabiduría de Eitrigg‡Sagesse d\'Eitrigg‡伊崔格的智慧‡伊崔格的智慧',
    nil,
    'Fale com Eitrigg em Orgrimmar. Quando tiver discutido o assunto com Eitrigg, busque o conselho de Thrall.|n|nVocê se lembra de ter visto Eitrigg nos aposentos de Thrall.‡Поговорите с Эйтриггом в Оргриммаре. После этого обратитесь к вождю Траллу. |n|nВ последний раз Эйтригг был в в зале приемов Тралла.‡Sprecht mit Etrigg in Orgrimmar. Wenn Ihr die Angelegenheit mit Etrigg besprochen habt, bittet Thrall um Rat.|n|nIhr erinnert Euch, dass Ihr Etrigg in Thralls Gemächern gesehen habt.‡오그리마의 스랄의 요새에 있는 아이트리그와 대화해야 합니다. 아이트리그의 얘기를 듣고 난 후에는 대족장 스랄과 상의해야 합니다.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.|n|nRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Habla con Eitrigg en Orgrimmar. Cuando hayas tratado unos asuntos con Eitrigg, busca el consejo de Thrall.|n|nRecuerdas haber visto a Eitrigg en la Cámara de Thrall.‡Parler à Eitrigg, à Orgrimmar. Après avoir discuté avec Eitrigg, demander conseil à Thrall.|n|nVous avez déjà vu Eitrigg dans les Appartements de Thrall.‡和奥格瑞玛的伊崔格谈一谈。讨论完毕后，咨询萨尔的意见。|n|n你回忆起曾在萨尔的大厅中见过伊崔格。‡和奧格瑪的伊崔格談話。討論完畢後，諮詢索爾的意見。|n|n你回憶起曾在索爾的大廳中見過伊崔格。',
  }
},
[4961] = {
  {
    'A purificação do Orbe de Orahil‡Очищение шара Орахила‡Die Säuberung der Kugel von Orahil‡오라힐 보주의 정화‡La purificación del orbe de Orahil‡La purificación del orbe de Orahil‡La purification de l\'Orbe d\'Orahil‡奥拉赫宝珠的净化‡奧拉赫寶珠的淨化',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화해야 합니다.‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuer le Démon de l\'Orbe, puis parler à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡殺死寶珠之魔，然後與塔貝薩談話。',
  }
},
[4962] = {
  {
    'Estilhaço de canisvil‡Осколок гончей Скверны‡Splitter eines Teufelshundes‡지옥사냥개의 영혼‡Fragmento de can manáfago‡Fragmento de can manáfago‡Un éclat de gangrechien‡地狱犬的灵魂‡惡魔犬的靈魂',
    nil,
    'Pegue o Rubi de Felhas e use-o em um dos Canisvis encontrados em Desolação. Depois de conseguir, leve o Rubi de Felhas e o Espírito de Canisvil Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите рубин Сквернолова и поймайте в него одну из гончих скверны в Пустошах. Добившись успеха, отнесите плененный дух Гончей Скверны и рубин Сквернолова Менаре Расщепительнице Бездны из Степей.‡Nehmt den Teufelsrubin und benutzt ihn bei einem der Teufelshunde von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Leerbringer im Brachland den eingekerkerten Teufelshundgeist und den Teufelsrubin.‡지옥의 루비를 가지고 가서 잊혀진 땅에 서식하는 지옥사냥개 중 한 마리에게 사용해야 합니다. 성공하면 지옥의 루비와 사로잡은 지옥사냥개의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago encarcelado a Menara Nadiz en Los Baldíos.‡Lleva el rubí de Felhas y úsalo en uno de los canes manáfagos de Desolace. Cuando lo consigas, llévale el rubí de Felhas y el espíritu del can manáfago encarcelado a Menara Nadiz en Los Baldíos.‡Prendre le Rubis de Felhas et l\'utiliser sur l\'un des gangrechiens de Désolace. Quand vous aurez réussi, rapporter le Rubis de Felhas et l\'Esprit de gangrechien emprisonné à Menara Taillevide, dans les Tarides.‡带上地狱犬红宝石到凄凉之地去，用它捕获一只地狱犬的灵魂。成功之后，将地狱犬红宝石和被禁锢的地狱犬灵魂交给贫瘠之地的梅纳拉·沃伦德。‡帶上惡魔犬紅寶石到淒涼之地去，用它捕獲一隻惡魔犬的靈魂。成功之後，將惡魔犬紅寶石和被禁錮的惡魔犬靈魂交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4963] = {
  {
    'Estilhaço de infernal‡Осколок инфернала‡Splitter einer Höllenbestie‡지옥불정령의 영혼‡Fragmento de infernal‡Fragmento de infernal‡Un éclat d\'infernal‡地狱火的灵魂‡煉獄火的靈魂',
    nil,
    'Pegue a Esmeralda Infusa e use-a em um dos Infernais encontrados em Desolação. Depois de conseguir, leve a Esmeralda Infusa e o Espírito de Infernal Aprisionado de volta a Menara Nihila, nos Sertões.‡Возьмите Пылающий изумруд и поймайте в него одного из инферналов в Пустошах. Добившись успеха, отнесите плененный дух инфернала и пылающий изумруд Менаре Расщепительнице Бездны из Степей.‡Nehmt den Infussmaragd und benutzt ihn bei einer der Höllenbestien von Desolace. Wenn Ihr Erfolg hattet, bringt Menara Leerbringer im Brachland den eingekerkerten Höllenbestiengeist und den Infussmaragd.‡지옥불 에메랄드를 가지고 가서 잊혀진 땅의 지옥불정령 중 하나에게 사용해 영혼을 사로 잡아야 합니다. 성공하면 지옥불 에메랄드와 사로잡은 지옥불정령의 영혼을 불모의 땅에 있는 미네라에게 가져가야 합니다.‡Coge la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal encarcelado a Menara Nadiz en Los Baldíos.‡Lleva la esmeralda de Infus y úsala en uno de los infernales de Desolace. Cuando lo consigas, llévale la esmeralda de Infus y el espíritu del infernal encarcelado a Menara Nadiz en Los Baldíos.‡Prendre l\'Emeraude d\'Infus et l\'utiliser sur l\'un des Infernaux qui se trouvent en Désolace. Quand vous aurez réussi, rapporter l\'Emeraude d\'Infus et l\'Esprit d\'Infernal emprisonné à Menara Taillevide, dans les Tarides.‡带上地狱火绿宝石到凄凉之地去，用它捕获一个地狱火的灵魂。成功之后，将地狱火绿宝石和被禁锢的地狱火灵魂交给贫瘠之地的梅纳拉·沃伦德。‡對淒涼之地的煉獄火使用煉鑄翡翠。成功之後，將煉鑄翡翠和被禁錮的煉獄火靈魂交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4964] = {
  {
    'Orbe de Dar\'Orathil concluído‡Завершение шара Дар\'орахила‡Die fertiggestellte Kugel von Dar\'Orahil‡완성된 다르오라힐의 보주‡El orbe completo de Dar\'Orahil‡El orbe completo de Dar\'Orahil‡L\'Orbe complet de Dar\'Orahil‡达奥拉赫宝珠‡達奧拉赫寶珠',
    nil,
    'Espere Menara Nihila completar o Orbe de Dar\'Orathil e fale com ela novamente.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над шаром Дар\'орахила, и еще раз поговорите с ней.‡Wartet, bis Menara Leerbringer die Kugel von Dar\'Orahil fertig gestellt hat, und sprecht dann noch einmal mit ihr.‡미네라 보이드렌더가 다르오라힐의 보주를 완성시킬 때까지 기다렸다가 그녀에게 말을 걸어야 합니다.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Espera a Menara Nadiz para completar el orbe de Dar\'Orahil y vuelve entonces a hablar con ella.‡Attendre que Menara Taillevide termine l\'Orbe de Dar\'Orahil, puis lui reparler.‡等待梅纳拉·沃伦德完成达奥拉赫宝珠，然后再与她谈一谈。‡等待梅納拉·虛無撕裂者完成達奧拉赫寶珠，然後再與她談一談。',
  }
},
[4965] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parlez à Menara Taillevide, dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4966] = {
  {
    'Proteja Kanati Nuvem Cinzenta‡Защитить Канати Серое Облако‡Kanati Grauwolke schützen‡카나티 그레이클라우드 보호‡Defensa de Kanati Nube Gris‡Defensa de Kanati Nube Gris‡Protéger Kanati Nuage-gris‡保护卡纳提·灰云‡保護卡納提·灰雲',
    nil,
    'Proteja Kanati Nuvem Cinzenta do ataque dos centauros.‡Защитите Канати Серое Облако от нападения кентавров.‡Beschützt Kanati Grauwolke vor den Angriffen der Zentauren.‡켄타우로스의 공격으로부터 카나티 그레이클라우드를 보호해야 합니다.‡Defiende a Kanati Nube Gris contra el ataque de los centauros.‡Defiende a Kanati Nube Gris contra el ataque de los centauros.‡Protéger Kanati Nuage-gris contre l\'attaque centaure.‡保护卡纳提·灰云免受半人马的袭击。‡保護卡納提·灰雲免受半人馬的襲擊。',
  }
},
[4967] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parlez à Menara Taillevide, dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4968] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parlez à Menara Taillevide, dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4969] = {
  {
    'O conhecimento do Orbe de Orahil‡Знание шара Орахила‡Wissen der Kugel von Orahil‡오라힐 보주의 지혜‡El conocimiento del orbe de Orahil‡El conocimiento del orbe de Orahil‡Connaissance de l\'Orbe d\'Orahil‡奥拉赫宝珠‡奧拉赫寶珠的知識',
    nil,
    'Fale com Menara Nihila nos Sertões.‡Поговорите с Менарой Расщепительницей Бездны в Степях.‡Sprecht mit Menara Leerbringer im Brachland.‡불모의 땅에 있는 미네라 보이드렌더와 대화하십시오.‡Habla con Menara Nadiz en Los Baldíos.‡Habla con Menara Nadiz en Los Baldíos.‡Parlez à Menara Taillevide, dans les Tarides.‡与贫瘠之地的梅纳拉·沃伦德谈一谈。‡與貧瘠之地的梅納拉·虛無撕裂者談話。',
  }
},
[4970] = {
  {
    'Suprimentos para os sabres-de-gelo‡Накормить ледопардов‡Frostsäblerverpflegung‡눈호랑이의 먹이‡Provisiones Sable de Hielo‡Provisiones de sable de hielo‡Provisions de sabres-de-givre‡霜刃豹的食物‡霜刃豹的糧食',
    nil,
    'Colete 5 peças de Carne de Dentilhaços e 5 peças de Carne de Ventogelantes para Ripárion Glaciares, em Hibérnia.‡Соберите 5 кусков мяса медведей-щербозубов и 5 кусков мяса стылодыхов для Риверна Холодного Ветра в Зимних Ключах.‡Sammelt 5 Splitterzahnfleischstücke und 5 Fleischstücke einer Eiswindschimäre für Rivern Frostwind in Winterquell.‡톱니이빨곰 고기 5개와 서리바람 키메라 고기 5개를 여명의 설원에 있는 리베른 프로스트윈드에게 갖다주어야 합니다.‡Recoge 5 carnes de Dentoesquirla y 5 carnes de Orvallo para Rivern Ventogélido de Cuna del Invierno.‡Recoge 5 carnes de Dentoesquirla y 5 carnes de Orvallo para Rivern Ventogélido de Cuna del Invierno.‡Collecter 5 morceaux de Viande de Croc acéré et 5 morceaux de Viande de Noroît pour Rivern Givrevent du Berceau-de-l\'Hiver.‡收集5块碎齿熊肉和5块冰风奇美拉肉，把它们交给冬泉谷的雷沃·霜翼。‡收集5塊裂齒熊肉和5塊冰風奇美拉肉交給冬泉谷的雷沃·霜風。',
  }
},
[4971] = {
  {
    'É questão de tempo‡Вопрос времени‡Eine Frage der Zeit‡시간 문제‡Una cuestión de tiempo‡Una cuestión de tiempo‡Une question de temps‡时间问题‡時間問題',
    nil,
    'Use o Deslocador Temporal perto de um dos silos de Andorhal e desencave Parasitas Temporais.|n|nMate 10 Parasitas Temporais e depois devolva o Deslocador Temporal para Crona na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Воспользуйтесь временным переместителем рядом с одним из амбаров Андорала и найдите временных паразитов.|n|nУбейте 10 временных паразитов и верните временной переместитель Хроми в Андоральскую таверну в Западных Чумных землях.‡Benutzt den Temporalversetzer in der Nähe eines der Silos von Andorhal, um die temporalen Parasiten aufzuspüren.|n|nTötet 10 temporale Parasiten und bringt dann den Temporalversetzer zu Chromie im Gasthaus Andorhal in den westlichen Pestländern.‡안돌할 저장고 근처에서 시간의 재배열기를 이용해 시간의 기생충들을 찾아내십시오.|n|n시간의 기생충 10마리를 처치한 후, 서부 역병지대의 안돌할 여관에 있는 크로미에게 시간의 재배열기를 가져가야 합니다.‡Utiliza el desplazador temporal junto a uno de los silos de Andorhal y saca a la luz los parásitos temporales.|n|nMata a 10 parásitos temporales y devuélvele el desplazador temporal a Cromi en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Utiliza el desplazador temporal junto a uno de los silos de Andorhal y saca a la luz los parásitos temporales.|n|nMata a 10 parásitos temporales y devuélvele el desplazador temporal a Cromi en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Utiliser le Déplaceur temporel à côté de l\'un des silos d\'Andorhal pour révéler des Parasites temporels.|n|nTuer 10 Parasites temporels et rapporter le Déplaceur temporel à Chromie, à l\'auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔的一处仓库附近使用时光置换器，使时光寄生虫现身。|n|n杀掉10只时光寄生虫，然后将时光置换器还给西瘟疫之地安多哈尔旅店的克罗米。‡在安多哈爾的一處倉庫附近使用時光置換器，使時光寄生蟲現身。|n|n殺掉10隻時光寄生蟲，然後將時光置換器還給西瘟疫之地安多哈爾旅店的克羅米。',
  }
},
[4972] = {
  {
    'Contando o tempo‡Отсчет времени‡Tempus fugit‡시간을 거슬러‡Contar el tiempo‡Contar el tiempo‡Arrêt du temps‡找回时间‡找回時間',
    nil,
    'Encontre 5 Relógios de Andorhal, que estão em cofres em meio às ruínas da cidade. Regresse com eles até Crona, que está na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Найдите 5 часов Андорала, спрятанных в сундуки среди руин. Принесите их Хроми в таверну Андорала в Западных Чумных землях.‡Sucht 5 Uhren von Andorhal, die in Schließkassetten überall im Schutt der Stadt zu finden sind. Kehrt mit ihnen zu Chromie ins Gasthaus Andorhal in den westlichen Pestländern zurück.‡안돌할 도시의 폐허에서 안돌할 시계 5개를 찾아 서부 역병지대의 안돌할 여관에 있는 크로미에게 가져가야 합니다.‡Localiza 5 relojes de Andorhal, los encontrarás en cajas fuertes entre las ruinas de la ciudad. Cuando los tengas regresa con Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Localiza 5 relojes de Andorhal, los encontrarás en cajas fuertes entre las ruinas de la ciudad. Cuando los tengas regresa con Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Trouver 5 Montres d\'Andorhal, dans des coffrets qui se trouvent parmi les décombres de la ville, et les rapporter à Chromie à l\'Auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔城中四处散落的保险箱里找到5只安多哈尔怀表，然后把它们交给西瘟疫之地安多哈尔旅店里的克罗米。‡在安多哈爾城中四處散落的帶鎖箱裡找到5個安多哈爾懷錶，然後把它們交給西瘟疫之地安多哈爾旅店裡的克羅米。',
  }
},
[4973] = {
  {
    'Contando o tempo‡Отсчет времени‡Tempus fugit‡시간을 거슬러‡Contar el tiempo‡Contar el tiempo‡Arrêt du temps‡找回时间‡找回時間',
    nil,
    'Encontre 5 Relógios de Andorhal em meio às ruínas da cidade e regresse com eles até Crona, que está na Estalagem Andorhal, que fica nas Terras Pestilentas Ocidentais.‡Найдите 5 часов Андорала, спрятанных в сундуки среди руин. Принесите их Хроми в таверну Андорала в Западных Чумных землях.‡Sucht 5 Uhren von Andorhal in den Ruinen der Stadt und bringt sie Chromie im Gasthaus Andorhal in den westlichen Pestländern.‡안돌할 도시의 폐허에서 안돌할 시계 5개를 찾아 서부 역병지대의 안돌할 여관에 있는 크로미에게 가져가야 합니다.‡Localiza 5 relojes de Andorhal entre las ruinas de la ciudad y llévaselos a Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Localiza 5 relojes de Andorhal entre las ruinas de la ciudad y llévaselos a Cromi, en la posada de Andorhal, en las Tierras de la Peste del Oeste.‡Trouver 5 Montres d\'Andorhal parmi les décombres de la ville et les rapporter à Chromie à l\'Auberge d\'Andorhal, dans les Maleterres de l\'ouest.‡在安多哈尔城的废墟里找到5只安多哈尔怀表，然后把它们交给西瘟疫之地安多哈尔旅店里的克罗米。‡在安多哈爾城的廢墟裡找到5個安多哈爾懷錶，然後把它們交給西瘟疫之地安多哈爾旅店裡的克羅米。',
  }
},
[4974] = {
  {
    'Pela Horda!‡За Орду!‡Für die Horde!‡호드를 위하여!‡¡Por la Horda!‡¡Por la Horda!‡Pour la Horde !‡为部落而战！‡為部落而戰!',
    nil,
    'Viaje para o Pico da Rocha Negra e mate o Chefe Guerreiro Laceral Mão Negra. Pegue sua cabeça e volte para Orgrimmar.‡Отправляйтесь в Пик Черной горы и убейте вождя Ренда Чернорука. Принесите его голову в Оргриммар.‡Begebt Euch zur Schwarzfelsspitze und tötet den Kriegshäuptling Rend Schwarzfaust. Nehmt seinen Kopf und kehrt nach Orgrimmar zurück.‡검은바위 첨탑으로 가서 대족장 렌드 블랙핸드를 처치하십시오. 그 증거로 그의 머리카락을 가지고 오그리마로 돌아와야 합니다.‡Ve a Cumbre de Roca Negra para matar al Jefe de Guerra Rend Puño Negro. Lleva su cabeza a Orgrimmar.‡Ve a Cumbre de Roca Negra para matar al Jefe de Guerra Rend Puño Negro. Lleva su cabeza a Orgrimmar.‡Aller au Pic Rochenoire et tuer le Chef de guerre, Rend Main-noire. Prendre sa tête et retourner à Orgrimmar.‡去黑石塔杀死大酋长雷德·黑手，带着他的徽记返回奥格瑞玛。‡去黑石塔殺死大酋長雷德·黑手，帶著他的頭顱返回奧格瑪。',
  }
},
[4975] = {
  {
    'O Orbe de Nor\'Orahil concluído‡Завершение шара Дар\'орахила‡Die fertiggestellte Kugel von Noh\'Orahil‡완성된 노오라힐의 보주‡El orbe completo de Noh\'Orahil‡El orbe completo de Noh\'Orahil‡L\'Orbe complet de Noh\'Orahil‡诺奥拉赫宝珠‡諾奧拉赫寶珠',
    nil,
    'Espere Menara Nihila completar o Orbe de Nor\'Orahil e fale com ela novamente.‡Дождитесь, пока Менара Расщепительница Бездны закончит работу над шаром Дар\'орахила, и еще раз поговорите с ней.‡Wartet, bis Menara Leerbringer die Kugel von Noh\'Orahil fertig gestellt hat, und sprecht dann noch einmal mit ihr.‡미네라 보이드렌더가 노오라힐의 보주를 완성하길 기다렸다가 그녀에게 말을 걸어야 합니다.‡Espera a Menara Nadiz para completar el orbe de Noh\'Orahil y vuelve entonces a hablar con ella.‡Espera a Menara Nadiz para completar el orbe de Noh\'Orahil y vuelve entonces a hablar con ella.‡Attendre que Menara Taillevide ait terminé l\'Orbe de Noh\'Orahil, puis lui reparler.‡等待梅纳拉·沃伦德完成诺奥拉赫宝珠，然后再与她谈一谈。‡等待梅納拉·虛無撕裂者完成諾奧拉赫寶珠，然後再與她談話。',
  }
},
[4976] = {
  {
    'Devolução do orbe purificado‡Возвращение к Менаре‡Ablieferung der gesäuberten Kugel‡정화의 보주 가져가기‡Devolver el orbe purificado‡Devolver el orbe purificado‡Rapporter l\'Orbe purifié‡归还净化过的宝珠‡歸還淨化過的寶珠',
    nil,
    'Leve o Orbe Infernal Purificado a Menara Nihila nos Sertões.‡Отнесите очищенную сферу инфернала Менаре Расщепительнице Бездны в Степи.‡Bringt die gesäuberte Höllenkugel zu Menara Leerbringer ins Brachland.‡정화된 지옥의 보주를 불모의 땅의 미네라에게 가져가야 합니다.‡Llévale el orbe infernal limpio a Menara Nadiz en Los Baldíos.‡Llévale el orbe infernal limpio a Menara Nadiz en Los Baldíos.‡Rapporter l\'Orbe infernal purifié à Menara Taillevide, dans les Tarides.‡将净化过的地狱火宝珠交给贫瘠之地的梅纳拉·沃伦德。‡將淨化過的煉獄火寶珠交給貧瘠之地的梅納拉·虛無撕裂者。',
  }
},
[4981] = {
  {
    'Agente Biju‡Агент Блестяшка‡Agentin Bijou‡요원 비쥬‡La espía Bijou‡La espía Bijou‡Agent Bijou‡狡猾的比修‡狡猾的比修',
    nil,
    'Vá ao Pico da Rocha Negra e descubra o que aconteceu com Biju.‡Отправьтесь к пику Черной горы и выясните, что сталось с Блестяшкой.‡Begebt Euch zur Schwarzfelsspitze und findet heraus, was aus Bijou geworden ist.‡검은바위 첨탑으로 가서 비쥬에게 무슨 일이 생겼는지 알아봐야 합니다.‡Viaja hasta la Cumbre de Roca Negra y averigua qué le ha ocurrido a Bijou.‡Viaja hasta la Cumbre de Roca Negra y averigua qué le ha ocurrido a Bijou.‡Allez au Pic Rochenoire et découvrez ce qui est arrivé à Bijou.‡到黑石塔去查明比修的下落。‡到黑石塔去查明比修的下落。',
  }
},
[4982] = {
  {
    'Pertences da Biju‡Вещи Блестяшки‡Bijous Habseligkeiten‡비쥬의 물건들‡Las pertenencias de Bijou‡Las pertenencias de Bijou‡Les affaires de Bijou‡比修的装置‡比修的裝置',
    nil,
    'Encontre os Pertences de Biju e devolva-os a ela. Ela mencionou tê-los guardado no nível mais profundo da cidade.|n‡Найдите вещи Блестяшки и верните их владелице. Блестяшка сказала, что она спрятала свое оборудование где-то на нижнем ярусе подземелья.‡Sucht Bijous Habseligkeiten und bringt sie ihr. Ihr erinnert Euch daran, dass sie erwähnte, ihre Sachen auf der untersten Ebene der Stadt versteckt zu haben.‡비쥬의 소지품을 찾아서 그녀에게 돌아가야 합니다. 비쥬가 도시의 바닥에 소지품을 숨겼다고 했습니다.‡Encuentra las pertenencias de Bijou y devuélveselas. Recuerdas que ella mencionó haberlas ocultado en la planta baja de la ciudad.|n‡Encuentra las pertenencias de Bijou y devuélveselas. Recuerdas que ella mencionó haberlas ocultado en la planta baja de la ciudad.|n‡Trouver les Affaires de Bijou et les lui rapporter. Elle vous a dit les avoir cachées dans le niveau inférieur de la ville.‡找到比修的装置并把它们还给她。你记得她说过她把装置藏在城市的最底层。‡找到比修的裝置並把它們還給她。你記得她說過她把裝置藏在城市的最底層。',
  }
},
[4983] = {
  {
    'Relatório de reconhecimento de Biju‡По данным разведки‡Bijous Aufklärungsbericht‡비쥬의 정찰 보고‡El informe de reconocimiento de Bijou‡El informe de reconocimiento de Bijou‡Rapport de reconnaissance de Bijou‡比修的侦察报告‡比修的偵察報告',
    nil,
    'Leve o Relatório de Reconhecimento de Biju para o Grão-mestre Lexlort em Karrath.|n‡Передайте донесение Блестяшки гроссмейстеру Лекслорту в Каргат.‡Bringt Bijous Aufklärungsbericht zu Großmeister Lexlort nach Kargath.‡비쥬의 정찰 보고서를 가지고 카르가스의 렉스로트에게 가야 합니다.‡Llévale el informe de reconocimiento de Bijou al maestro mayor Lexlort en Kargath.|n‡Llévale el informe de reconocimiento de Bijou al maestro mayor Lexlort en Kargath.|n‡Rapporter le Rapport de reconnaissance de Bijou au Grand-maître Lexlort, à Kargath.‡把比修的侦查报告交给卡加斯的雷克斯洛特。‡把比修的偵察報告交給卡加斯的宗師雷克斯洛特。',
  }
},
[4984] = {
  {
    'A vida selvagem também sofre‡Страдания природы‡Die Tierwelt leidet auch‡야생동물들의 고통‡La naturaleza también sufre‡La naturaleza también sufre‡La faune et la flore souffrent aussi‡大自然的苦楚‡大自然的苦楚',
    nil,
    'Destrua 8 Lobos Doentes e fale novamente com Mulgris Riofundo no Antro Repelente, que fica nas Terras Pestilentas Ocidentais.|n|n‡Убейте 8 больных волков и вернитесь к Мулгрису Глубокой Реке в Удел Страданий в Западных Чумных землях.‡Tötet 8 kranke Wölfe und kehrt dann zu Mulgris Tiefenfurt auf dem trostlosen Feld in den westlichen Pestländern zurück.‡병에 걸린 늑대 8마리를 처치한 후, 서부 역병지대의 고통의 흉가에 있는 멀그리스 딥리버에게 돌아가야 합니다.‡Destruye 8 lobos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.|n|n‡Destruye 8 lobos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.|n|n‡Détruire 8 Loups malades, puis retourner voir Mulgris Rivière-profonde, au Repaire putride dans les Maleterres de l\'ouest.‡消灭8只生病的狼，然后去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。‡消滅8隻染病的狼，然後去找西瘟疫之地苦痛鬼屋的穆格雷斯·深水。',
  }
},
[4985] = {
  {
    'A vida selvagem também sofre‡Страдания природы‡Die Tierwelt leidet auch‡야생동물들의 고통‡La naturaleza también sufre‡La naturaleza también sufre‡La faune et la flore souffrent aussi‡大自然的苦楚‡大自然的苦楚',
    nil,
    'Destrua 8 Ursos-cinzentos Doentes e fale novamente com Mulgris Riofundo no Antro Repelente, que fica nas Terras Pestilentas Ocidentais.‡Убейте 8 болезненных гризли и вернитесь к Мулгрису Глубокой Реке в Удел Страданий в Западных Чумных землях.‡Tötet 8 kranke Grizzlys und kehrt dann zu Mulgris Tiefenfurt auf dem trostlosen Feld in den westlichen Pestländern zurück.‡병에 걸린 불곰 8마리를 처치한 후, 서부 역병지대의 고통의 흉가에 있는 멀그리스 딥리버에게 돌아가야 합니다.‡Destruye 8 pardos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.‡Destruye 8 pardos malsanos y regresa con Mulgris Río Hondo en El Tormento, en las Tierras de la Peste del Oeste.‡Détruire 8 Grizzlys malades, puis retourner voir Mulgris Rivière-profonde au Repaire putride, dans les Maleterres de l\'ouest.‡消灭8只生病的灰熊，然后去找西瘟疫之地嚎哭鬼屋的穆格雷斯·深水。‡消滅8隻染病的灰熊，然後去找西瘟疫之地苦痛鬼屋的穆格雷斯·深水。',
  }
},
[4986] = {
  {
    'Galho de carvalho com glifos‡Покрытая письменами дубовая ветвь‡Glyphenverzierter Eichenast‡문자가 새겨진 떡갈나무 가지‡Rama de roble con inscripciones‡Rama de roble con inscripciones‡La branche de chêne glyphée‡雕文橡木枝‡雕紋橡木樹枝',
    nil,
    'Baseado na magia imbuída no galho de carvalho com glifos, sua entrega ao Círculo Cenariano em Darnassus é o próximo passo que o druida tauren buscava. Procure a ajuda de um dos druidas.‡Судя по магии, вложенной в покрытую письменами дубовую ветвь, друид-таурен желал отнести ее в Круг Кенария в Дарнасе. Попросите о помощи одного из тамошних друидов.‡Nach der Magie zu urteilen, mit der der glyphenverzierte Eichenast erfüllt ist, hatte der Taurendruide wohl gewollt, dass Ihr den Ast zum Zirkel des Cenarius nach Darnassus bringt. Bittet einen der Druiden dort um Hilfe.‡문자가 새겨진 떡갈나무 가지에 걸린 문자로 미루어볼 때 타우렌 드루이드가 이 가지를 가져가려고 한 장소는 다르나서스에 있는 세나리온 의회입니다. 그곳에서 드루이드를 한 명 찾아 도움을 요청하십시오.‡Según la magia con la que está encantada La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion en Darnassus. Pide ayuda a uno de los druidas que encontrarás allí.‡Según la magia con la que está encantada La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion en Darnassus. Pide ayuda a uno de los druidas que encontrarás allí.‡D\'après la magie contenue dans la Branche de chêne à glyphes, le druide tauren voulait qu\'elle soit apportée au Cercle cénarien, à Darnassus. Aller solliciter l\'assistance de l\'un des druides, là-bas.‡根据雕文橡木枝上面所附加的魔法，这个牛头人德鲁伊本来准备把它交给达纳苏斯的塞纳里奥议会。看来你应该到那里去找一个德鲁伊，并寻求他的帮助。‡根據這枝雕紋橡木樹枝所附加的魔法，這個牛頭人德魯伊本來準備把它交給達納蘇斯的塞納里奧議會。到那裡去尋求某個德魯伊的幫助吧。',
  }
},
[4987] = {
  {
    'Galho de carvalho com glifos‡Покрытая письменами дубовая ветвь‡Glyphenverzierter Eichenast‡문자가 새겨진 떡갈나무 가지‡Rama de roble con inscripciones‡Rama de roble con inscripciones‡La branche de chêne glyphée‡雕文橡木枝‡雕紋橡木樹枝',
    nil,
    'Baseado na magia imbuída no galho de carvalho com glifos, sua entrega ao Círculo Cenariano no Penhasco do Trovão é o próximo passo que o druida Tauren buscava. Procure a ajuda de um dos druidas.‡Судя по магии, записанной в покрытую письменами дубовую ветвь, друид-таурен желал отнести ее в Круг Кенария в Громовом Утесе. Попросите о помощи одного из тамошних друидов.‡Nach der Magie zu urteilen, mit der der glyphenverzierte Eichenast erfüllt ist, hatte der Taurendruide wohl gewollt, dass Ihr den Ast zum Zirkel des Cenarius nach Donnerfels bringt. Bittet einen der Druiden dort um Hilfe.‡문자가 새겨진 떡갈나무 가지에 걸린 문자로 미루어볼 때 타우렌 드루이드가 이 가지를 가져가려고 한 장소는 썬더 블러프에 있는 세나리온 의회입니다. 그곳에서 드루이드를 한 명 찾아 도움을 받도록 하십시오.‡Según la magia con la que está encantada de La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion de Cima del Trueno. Pide ayuda a uno de los druidas que encontrarás allí.‡Según la magia con la que está encantada de La rama de roble con inscripciones, el siguiente paso del druida tauren debía ser su entrega al Círculo Cenarion de Cima del Trueno. Pide ayuda a uno de los druidas que encontrarás allí.‡D\'après la magie contenue dans la Branche de chêne à glyphes, le druide tauren voulait qu\'elle soit apportée au Cercle cénarien, aux Pitons du Tonnerre. Aller solliciter l\'assistance de l\'un des druides, là-bas.‡根据雕文橡木枝上面所附加的魔法，这个牛头人德鲁伊本来准备把它交给雷霆崖的塞纳里奥议会。看来你应该到那里去找一个德鲁伊，并寻求他的帮助。‡根據這枝雕紋橡木樹枝所附加的魔法，這個牛頭人德魯伊本來準備把它交給雷霆崖的塞納里奧議會。到那裡去尋求某個德魯伊的幫助吧。',
  }
},
[5001] = {
  {
    'Pertences da Biju‡Вещи Блестяшки‡Bijous Habseligkeiten‡비쥬의 소지품‡Las pertenencias de Bijou‡Las pertenencias de Bijou‡Les affaires de Bijou‡比修的装置‡比修的裝置',
    nil,
    'Encontre os Pertences de Biju e devolva-os a ela. Boa sorte!|n‡Найдите вещи Блестяшки и верните их владелице. Удачи!‡Sucht Bijous Habseligkeiten und bringt sie ihr. Viel Glück!‡비쥬의 소지품을 찾아 그녀에게 돌려줘야 합니다!‡Encuentra las pertenencias de Bijou y devuélveselas. ¡Suerte!|n‡Encuentra las pertenencias de Bijou y devuélveselas. ¡Suerte!|n‡Retrouver les Affaires de Bijou et les lui rapporter. Bonne chance !‡找到比修的装置并把它们还给她。祝你好运！‡找到比修的裝置並且交還給她。祝你好運!',
  }
},
[5002] = {
  {
    'Mensagem para Maxwell‡Донесение Максвелла‡Nachricht an Maxwell‡맥스웰에게 보내는 정보‡Un mensaje para Maxwell‡Un mensaje para Maxwell‡Message à Maxwell‡给麦克斯韦尔的消息‡給麥斯威爾的訊息',
    nil,
    'Viaje para as Estepes Ardentes e dê as Informações de Biju para o Oficial Maxwell.‡Передайте маршалу Максвеллу информацию Блестяшки.‡Begebt Euch in die brennende Steppe und leitet Bijous Informationen an Marschall Maxwell weiter.‡불타는 평원에 있는 치안대장 맥스웰에게 비쥬의 정보를 전해야 합니다.‡Viaja a Las Estepas Ardientes y dale la información sobre Bijou al mariscal Maxwell.‡Viaja a Las Estepas Ardientes y dale la información sobre Bijou al mariscal Maxwell.‡Se rendre dans les Steppes ardentes et confier les Renseignements de Bijou au maréchal Maxwell.‡到燃烧平原去，把比修的情报交给麦克斯韦尔元帅。‡把比修的消息帶去給在燃燒平原的麥斯威爾元帥。',
  }
},
[5021] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'As divagações da mulher fantasmagórica indicavam que ela precisava que um pacote fosse entregue. Ela afirmou que ele estava no mesmo lugar que seu cavalo. Quanto ao local onde o cavalo está ou onde o pacote deve ser entregue, continua sendo impossível entender o fantasma.‡Судя по сбивчивым объяснениям призрачной женщины, она хочет доставить посылку. Бедняга уверяет, что посылка лежала там, где стоял ее конь. Где именно это было, женщина не сказала.‡Das wilde Gebrabbel der Geisterfrau deutete darauf hin, dass sie ein Paket ausliefern musste. Sie behauptete, dass es dort war, wo auch ihr Pferd war. Darüber, wo das Pferd jetzt ist oder wohin das Paket ausgeliefert werden muss, sagt der Geist nichts.‡유령 여인의 두서없는 말을 들으니 소포를 전달해야 했던 것 같습니다. 자신의 말이 있던 곳에 소포가 있다고 했는데, 말이 어디 있는지, 그리고 소포를 어디로 전달해야 하는지에 대해서는 이해할 수 없는 말만 늘어놓습니다.‡Entre lamentos, la mujer fantasmal recordaba tener que entregar un paquete. Según ella estaba junto a su caballo. No puedes entender dónde está el caballo o dónde había que entregar el paquete.‡Entre lamentos, la mujer fantasmal recordaba tener que entregar un paquete. Según ella estaba junto a su caballo. No puedes entender dónde está el caballo o dónde había que entregar el paquete.‡Le discours incohérent de la femme fantomatique indique qu\'elle a besoin qu\'on livre un colis pour elle. Elle a dit que le colis se trouvait là où se trouve son cheval. Le fantôme est incompréhensible lorsqu\'il s\'agit de préciser où se trouve son cheval ou l\'endroit où le paquet doit être livré.‡这个女人的幽灵告诉你她要送出一只包裹。她说那只包裹就在她的马旁边。至于马在哪里或者包裹要送到哪里去，她却根本没有说。‡這個女人的鬼魂告訴你她要送出一個包裹。她說那個包裹就在她的馬旁邊。至於馬在哪裡或者包裹要送到哪裡去，她卻根本沒有說。',
  }
},
[5022] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'Fale com os Administradores Reais de Ventobravo para saber o paradeiro da Bia Pedravil. Geralmente tem um agente do censo na Prefeitura.‡Выясните у королевских представителей Переписи Штормграда местонахождение Эммы Фелстоун. Офицера-переписчика можно найти в Ратуше.‡Wendet Euch an die königlichen Disponenten von Sturmwind, um etwas über den Aufenthaltsort von Emma Teufelsstein herauszufinden. Normalerweise findet sich ein Volkszählungsbeamter im Rathaus.‡스톰윈드의 왕실 조사원과 대화하여 엠마 펠스톤의 행방을 알아내십시오. 인구조사국 담당자는 보통 스톰윈드 시청에 있습니다.‡Consulta con los agentes reales de Ventormenta para averiguar el paradero de una tal Emma Piedra Mácula. Suele haber un oficial del censo en el Ayuntamiento.‡Consulta con los agentes reales de Ventormenta para averiguar el paradero de una tal Emma Piedra Mácula. Suele haber un oficial del censo en el Ayuntamiento.‡Rendre visite aux Facteurs royaux de Hurlevent pour apprendre l\'adresse d\'une certaine Emma Gangrepierre. En général, il y a un officier du recensement à l\'Hôtel de ville.‡与暴风城的皇家代理人巴瑟罗尔协商，查找到艾玛·费尔斯通的下落。通常在市政厅里都有一个人口普查官。‡向暴風城的皇家代理人確認艾瑪·費爾斯通的下落。通常在市政廳裡都有一個人口普查官。',
  }
},
[5023] = {
  {
    'Antes tarde do que nunca‡Лучше поздно, чем никогда‡Besser spät als nie‡늦어버린 소포 배달‡Más vale tarde que nunca‡Más vale tarde que nunca‡Mieux vaut tard que jamais‡迟到总比不到好‡遲到總比不到好',
    nil,
    'Fale com os Feitores Reais da Cidade Baixa para saber o paradeiro da Jeremias Pedravil. Geralmente tem um agente do censo perto do registro de guilda e tabardo.‡Поговорите с королевскими инспекторами Подгорода и наведите справки о Иеремии Фелстоуне. Офицера-переписчика можно найти рядом с пунктом регистрации гильдий и гербовых накидок.‡Wendet Euch an die königlichen Vorarbeiter von Unterstadt, um etwas über den Aufenthaltsort von Jeremiah Teufelsstein herauszufinden. Normalerweise findet sich ein Volkszählungsbeamter in der Nähe der Gilden- und Wappenrock-Registrierung.‡언더시티의 왕실감독원과 대화하여 제레미어 펠스톤의 행방을 알아내십시오. 인구조사국 담당자는 보통 길드 사무소 근처에 있습니다.‡Consulta con los supervisores reales de Entrañas para averiguar el paradero de Jeremiah Piedra Mácula. Suele haber un oficial del censo junto a la oficina de registro de hermandades y tabardos.‡Consulta con los supervisores reales de Entrañas para averiguar el paradero de Jeremiah Piedra Mácula. Suele haber un oficial del censo junto a la oficina de registro de hermandades y tabardos.‡Se renseigner auprès des Surveillants royaux de Fossoyeuse pour apprendre l\'adresse d\'un certain Jeremiah Gangrepierre. En général, il y a un officier du recensement près du bureau d\'inscription des guildes et tabards.‡与幽暗城的皇家管理人巴哈乌斯协商，查找杰雷米亚·费尔斯通的下落。通常在公会注册处附近会有一个人口普查官。‡與幽暗城的皇家監督者打聽傑雷米亞·費爾斯通的下落。通常在公會註冊處附近會有一個人口普查官。',
  }
},
[5041] = {
  {
    'Suprimentos para a Encruzilhada‡Снабжение Перекрестка‡Vorräte für das Wegekreuz‡크로스로드의 보급품‡Suministros para El Cruce‡Suministros para El Cruce‡Ravitaillement pour la Croisée‡十字路口的补给品‡十字路口的補給物資',
    nil,
    'Encontre e devolva os Caixotes de Suprimentos da Encruzilhada a Thork, nos Sertões.‡Найдите и верните Тхорку из Степей ящики с припасами из Перекрестка.‡Findet die Vorratskisten des Wegekreuzes und bringt sie zu Thork im Brachland zurück.‡크로스로드 보급품 상자를 찾아서 불모의 땅의 톨크에게 가져가 주어야 합니다.‡Encuentra los cajones de suministros de El Cruce y devuélveselos a Thork en Los Baldíos.‡Encuentra los cajones de suministros en El Cruce y devuélvelos a Thork en los Baldíos.‡Trouver et rapporter les Caisses de ravitaillement de la Croisée à Thork dans les Tarides.‡找到十字路口的补给箱，把它还给贫瘠之地的索克。‡找到並把十字路口的補給木箱還給貧脊之地的索克。',
  }
},
