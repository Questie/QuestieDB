[13740] = {
  {
    '‡Рождение героя‡Aufstieg eines Champions‡용사 등극‡Se alza un Campeón‡Se alza un Campeón‡La naissance d\'un champion‡冠军诞生‡一位勇士的出現',
    nil,
    '‡Поговорите с вершительницей правосудия Мариэль Чистосердечной на Ристалище Серебряного турнира.‡Sprecht mit Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 심판관 마리엘 트루하트와 대화해야 합니다.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Habla con la justicar Mariel Corazón Veraz en los Campos del Torneo Argenta.‡Parlez à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13741] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Лане Твердомолот в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Lana Starkhammer beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Lana Martillotenaz en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Lana Martillotenaz en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Lana Rudemartel dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的兰娜·硬锤。‡',
  }
},
[13742] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Лане Твердомолот в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Lana Starkhammer beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 라나 스타우트해머에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Lana Martillotenaz en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Lana Martillotenaz en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的兰娜·硬锤。‡',
  }
},
[13743] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Лана Твердомолот из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Lana Starkhammer beim Argentumturnierplatz möchte, dass Ihr ihr die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 라나 스타우트해머가 겨울 칼날을 가져다 달라고 했습니다.‡Lana Martillotenaz en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Lana Martillotenaz en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Lana Rudemartel, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的兰娜·硬锤。‡',
  }
},
[13744] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию Ролло Меткострела из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Rollo Immertreff beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 롤로 슈어샷이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Rolo Tiro Acertado en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Rolo Tiro Acertado en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Rollo Coup-sûr, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的鲁洛·强击要你消灭10名被转化的英雄。‡',
  }
},
[13745] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Кларе Взубногой в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Clara Torkelbräu beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 클라라 텀블브루에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Clara Vueltabirra en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Clara Vueltabirra en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Clara voltebière, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的克拉拉·沸酒。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13746] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Амброзу Искрокруту в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Ambrose Bolzenfunk beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的安布罗斯·雷钉。‡',
  }
},
[13747] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Амброзу Искрокруту в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Ambrose Bolzenfunk beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Ambrose Chisparrayo en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的阿姆布罗斯·电光。‡',
  }
},
[13748] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Амброз Искрокрут из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Ambrose Bolzenfunk beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 암브로스 볼트스파크가 겨울 칼날을 가져다 달라고 했습니다.‡Ambrose Chisparrayo en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Ambrose Chisparrayo en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Ambrose Étinceboulon, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的安布罗斯·雷钉。‡',
  }
},
[13749] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 воинов Плети в Ледяной Короне по заданию Тикля Гайковерта из Павильона Серебряного союза на Ристалище Серебряного турнира. Вы можете найти их в любой части Ледяной Короны, за исключением Бомбардировки.‡Klack Radspanner beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 티킨 기어스패너가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Tickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Tickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Koche Clépharnaüm, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的提克·扳钳要你消灭10名被转化的英雄。‡',
  }
},
[13750] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Фликлю Гайковерту в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Klick Radspanner beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 플리킨 기어스패너에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Flickin Trazagranaje en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Flickin Trazagranaje en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Krante Clépharnaüm, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的弗林克·扳钳。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13752] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Колосусу в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Kolosos beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 콜로소스에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Colosos en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Colosos en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Colossos, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的科鲁索斯。‡',
  }
},
[13753] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Колосусу в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Bringt Kolosos beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 콜로소스에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Colosos en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Colosos en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Colossos, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的科鲁索斯。‡',
  }
},
[13754] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Колосус из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Kolosos beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 콜로소스가 겨울 칼날을 가져다 달라고 했습니다.‡Colosos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Colosos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Colossos, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的科鲁索斯。‡',
  }
},
[13755] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию Саандоса из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Saandos beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 산도스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Saandos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Saandos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Saandos, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的萨安度斯要你消灭10名被转化的英雄。‡',
  }
},
[13756] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Рании в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Ranii beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 라니에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Ranii en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Ranii en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Ranii, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的兰妮。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13757] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Джейлин Закатной Песне а шатер Альянса на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Jaelyne Abendlied beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的亚琳·永歌。‡',
  }
},
[13758] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Джейлин Закатной Песне в шатер Альянса на Ристалище Серебряного турнира.‡Bringt Jaelyne Abendlied beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 제일린 이븐송에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Jaelyne Unicanto en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的亚琳·永歌。‡',
  }
},
[13759] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Джейлин Закатная Песня из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести ей Клинок Зимы.‡Jaelyne Abendlied beim Argentumturnierplatz möchte, dass Ihr ihr die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 제일린 이븐송이 겨울 칼날을 가져다 달라고 했습니다.‡Jaelyne Unicanto en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Jaelyne Unicanto en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Jaelyne Chant-du-soir, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的亚琳·永歌。‡',
  }
},
[13760] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев в Ледяной Короне по заданию Иллестрии Певицы Клинка из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Illestria Klingensänger beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 일레스트리아 블레이드싱어가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Illestria Rugefilo en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Illestria Rugefilo en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Illestria Chantelame, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的伊蕾丝蒂亚·刃歌要你消灭10名被转化的英雄。‡',
  }
},
[13761] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Айре Устремленной к Звездам в шатер Альянса на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Airae Sternensucher beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 아이래 스타시커에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Airae Buscaestelar en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Airae Buscaestelar en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Airae Cherchétoile, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡将三枚勇士的印记交给银色比武场的艾莱·觅星。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13762] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Mokra dem Schädelberster beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡找到灰木之剑，把它交给银色比武场的碎颅者莫克拉。‡',
  }
},
[13763] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Мокре Дробителю Черепов в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Mokra dem Schädelberster beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Mokra el Trituracráneos en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13764] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Мокра Дробитель Черепов из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Mokra der Schädelberster beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡은빛십자군 마상시합 광장에 있는 해골분쇄자 모크라가 겨울 칼날을 가져다 달라고 했습니다.‡Mokra el Trituracráneos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Mokra el Trituracráneos en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Mokra le Brise-tête, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的碎颅者莫克拉。‡',
  }
},
[13765] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев в Ледяной Короне по заданию Акиноса из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Akinos beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 아키노스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Akinos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Akinos en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Akinos, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的埃基诺斯要你消灭10名被转化的英雄。‡',
  }
},
[13767] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Море Сестре Воргов в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Morah Worgschwester beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 모라 워그시스터에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Morah Hermana de Huargos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Morah Hermana de Huargos en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Morah Sœur-worg, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的茉拉·狼女。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13768] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Зул\'тору в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Zul\'tore beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 줄토어에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Zul\'tore en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Zul\'tore en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13769] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Зул\'тору в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Zul\'tore beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 줄토어에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Zul\'tore en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Zul\'tore en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Zul\'tore, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13770] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Зул\'тор из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Zul\'tore beim Argentumturnierplatz möchte, dass Ihr ihm die Winterschneide beschafft.‡‡Zul\'tore en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Zul\'tore en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Zul\'tore, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡‡',
  }
},
[13771] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию темного охотника Мезил-Кри из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Schattenjäger Mezil-kree beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 어둠사냥꾼 메질크리가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡El cazador de las Sombras Mezil-kree en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡El cazador de las Sombras Mezil-kree en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Le Chasseur des ombres Mezil-kree, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡‡',
  }
},
[13772] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Гаджу в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Gahju beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 가쥬에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Gahju en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Gahju en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Gahju, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡将三枚勇士的印记交给银色比武场的加尔祖。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13773] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Руноку Буйногривому в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Runok Wildmähne beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Runok Ferocrín en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Runok Ferocrín en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13774] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Руноку Буйногривому в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Runok Wildmähne beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 루노크 와일드메인에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Runok Ferocrín en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Runok Ferocrín en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent.‡将达克玛尔之剑交给银色比武场的鲁诺克·蛮鬃。‡',
  }
},
[13775] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Рунок Буйногривый из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Runok Wildmähne beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 루노크 와일드메인이 겨울 칼날을 가져다 달라고 했습니다.‡Runok Ferocrín en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Runok Ferocrín en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Runok Crin-sauvage, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡‡',
  }
},
[13776] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию Дерна Тотема Ярости из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Dern Zorntotem beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 던 레이지토템이 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Dern Tótem de Ira en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Dern Tótem de Ira en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Dern Totem-de-rage, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的德恩·暴怒图腾要你消灭10名被转化的英雄。‡',
  }
},
[13777] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Анке Точеное Копыто в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Anka Klauenhuf beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 안카 클로후프에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Anka Garrapezuña en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso a Anka Garrapezuña en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant à Anka Sabot-Griffu, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡‡',
  }
},
[13778] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его стражу смерти Визери в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Todespirscher Visceri beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 죽음추적자 비세리에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela al mortacechador Visceri en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela al mortacechador Visceri en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13779] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Стражу смерти Визери на Ристалище Серебряного турнира.‡Bringt Todespirscher Visceri beim Argentumturnierplatz die Klinge von Drak\'Mar.‡‡Lleva la hoja de Drak\'Mar al mortacechador Visceri en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar al mortacechador Visceri en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar au Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13780] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Страж смерти Визери из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Todespirscher Visceri beim Argentumturnierplatz möchte, dass Ihr ihm Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 죽음추적자 비세리가 겨울 칼날을 가져다 달라고 했습니다.‡El mortacechador Visceri en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡El mortacechador Visceri en los Campos del Torneo Argenta quiere que le lleves Filoinvierno.‡Le Nécrotraqueur Viscéri, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡‡',
  }
},
[13781] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию Сары Чолк из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Sarah Chalke beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 사라 초크가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Sarah Chalke en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sarah Chalke en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Sarah Chalke, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡‡',
  }
},
[13782] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы дрессировщику Дречу в шатер Орды на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Похитителей Солнца.‡Bringt 3 Male des Recken zu Tierführer Dretch beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 조련사 드레치에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso al cuidador Dretch en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Llévale 3 marcas del Valeroso al cuidador Dretch en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón Atracasol.‡Apportez 3 Marques de vaillant au Dresseur Dretch, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon de Saccage-soleil.‡‡',
  }
},
[13783] = {
  {
    '‡Клинок, достойный чемпиона‡Eine Klinge, eines Champions würdig‡용사에게 걸맞은 검‡Una espada de Campeón‡Una espada de Campeón‡Une lame digne d\'un champion‡冠军的利剑‡名劍配勇士',
    nil,
    '‡Раздобудьте меч Ясеневого озера и принесите его Эрессее Певице Рассвета в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Besorgt Eschenbrand und bringt es Eressea Morgensänger beim Argentumturnierplatz.‡잿빛나무 검을 구해 은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 가져가야 합니다.‡Recupera la espada de Lago Fresno y llévasela a Eressea Cantoalba en los Campos del Torneo Argenta.‡Recupera la espada de Lago Fresno y llévasela a Eressea Cantoalba en los Campos del Torneo Argenta.‡Récupérez le Brant en frêne et apportez-le à Eressea Chantelaube dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13784] = {
  {
    '‡Достойное оружие‡Eine würdige Waffe‡훌륭한 무기‡Un arma digna‡Un arma digna‡Une arme remarquable‡珍贵的武器‡足以匹配的武器',
    nil,
    '‡Принесите меч Драк\'Мара Эрессее Певице Рассвета в Павильон Похитителей Солнца на Ристалище Серебряного турнира.‡Bringt Eressea Morgensänger beim Argentumturnierplatz die Klinge von Drak\'Mar.‡은빛십자군 마상시합 광장에 있는 에레시아 돈싱어에게 드락마의 검을 가져가야 합니다.‡Lleva la hoja de Drak\'Mar a Eressea Cantoalba en los Campos del Torneo Argenta.‡Lleva la hoja de Drak\'Mar a Eressea Cantoalba en los Campos del Torneo Argenta.‡Apportez la Lame de Drak\'Mar à Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13785] = {
  {
    '‡Клинок Зимы‡Auf Winters Schneide‡겨울의 칼날‡El Filo del invierno‡El Filo del invierno‡Fil de l\'hiver‡冬之利刃‡凜冬之鋒',
    nil,
    '‡Эрессея Певица Рассвета из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести Клинок Зимы.‡Eressea Morgensänger beim Argentumturnierplatz möchte, dass Ihr ihr Winterschneide bringt.‡은빛십자군 마상시합 광장에 있는 에레시아 돈싱어가 겨울 칼날을 가져다 달라고 했습니다.‡Eressea Cantoalba en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Eressea Cantoalba en los Campos del Torneo Argenta quiere que le lleves el Filoinvierno.‡Eressea Chantelaube, dans l\'Enceinte du tournoi d\'Argent, vous demande de lui rapporter Fil de l\'hiver.‡将冬之利刃交给银色比武场的伊蕾希亚·晨歌。‡',
  }
},
[13786] = {
  {
    '‡Теория и практика‡Feldübungen eines Recken‡용맹전사의 실전 훈련‡Instrucción en el campo de un Valeroso‡Instrucción en el campo de un Valeroso‡L\'entraînement sur le terrain d\'un vaillant‡勇士的实战训练‡驍士的實地訓練',
    nil,
    '‡Убейте 10 обращенных героев по заданию Кетиэля Солнечного Копья из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Kethiel Sonnenlanze beim Argentumturnierplatz möchte, dass Ihr 10 konvertierte Helden tötet.‡은빛십자군 마상시합 광장에 있는 케시엘 선랜스가 조종 당하는 영웅 10명을 처치해 달라고 했습니다.‡Kethiel Lanzasol en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Kethiel Lanzasol en los Campos del Torneo Argenta quiere que mates a 10 héroes transformados.‡Kethiel Lance-solaire, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 10 Héros convertis.‡银色比武场的克希尔·炎枪要你消灭10名被转化的英雄。‡',
  }
},
[13787] = {
  {
    '‡Великая битва‡Der große Arenakampf‡최고 마상전‡El gran combate cuerpo a cuerpo‡El gran combate cuerpo a cuerpo‡La grande mêlée‡总决赛‡技擊大賽',
    nil,
    '‡Принесите три знака искателя славы Анире Турон в Павильон Похитителей Солнца на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в Павильоне Серебряного союза.‡Bringt 3 Male des Recken zu Aneera Thuron beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 아니라 투론에게 용맹전사의 징표 3개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Llévale 3 marcas del Valeroso a Aneera Thuron en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Llévale 3 marcas del Valeroso a Aneera Thuron en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza, puedes coger otra de cualquier expositor de lanzas que hay cerca de los establos o en el Pabellón de El Pacto de Plata.‡Apportez 3 Marques de vaillant à Aneera Thuron, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre sur n\'importe quel Râtelier de lances près des écuries ou dans le Pavillon du Concordat argenté.‡‡',
  }
},
[13788] = {
  {
    '‡Атака с воздуха‡Bedrohung von oben‡하늘의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    '‡Крок Гроза Плети с Ристалища Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов – сектантов.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡‡',
  }
},
[13789] = {
  {
    '‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    '‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Селлиана Первого Луча из Серебряного павильона на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны.‡Cellian Tagesanbruch beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Anhänger des Kults der Verdammten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 셀리안 데이브레이크가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar a miembros del Culto de los Malditos en cualquier parte de Corona de Hielo.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar a miembros del Culto de los Malditos en cualquier parte de Corona de Hielo.‡Cellian Bonmatin, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez les tuer partout dans la Couronne de glace.‡银色比武场的塞利安·碎日要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭这些诅咒教派的成员。‡',
  }
},
[13790] = {
  {
    '‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    '‡Принесите 4 знака чемпиона Луури в павильон Серебряного союза на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне.‡Bringt 4 Male des Champions zu Luuri beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.|n‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.|n‡Apportez 4 Marques de champion à Luuri, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡‡',
  }
},
[13791] = {
  {
    '‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    '‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Зор\'бе Кровопускателя с Ристалища Серебряного турнира. Вы можете действовать в любой области Ледяной Короны.‡Zor\'be der Blutvergießer beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 피를 부르는 조르베가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be le Saigneur, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的放血者佐尔比要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭那些异教徒。‡',
  }
},
[13793] = {
  {
    '‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions...‡冠军的比武‡勇士們',
    nil,
    '‡Принесите 4 знака чемпиона Иллирии Приходу Тьмы на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Серебряного союза.‡Bringt 4 Male des Champions zu Illyrie Nachtlauer beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere vor dem Silberbundpavillon oder im Pavillon selbst, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 일라이리 나이트폴에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 은빛 서약단 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón de El Pacto de Plata.‡Apportez 4 Marques de champion à Illyrie Tombenuit, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon du Concordat argenté.‡将四枚冠军的印记交给银色比武场的伊尔蕾·夜幕。|n|n如果你丢失了长枪，可以在银色盟约大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13794] = {
  {
    '‡Эдрик Чистый‡Eadric der Reine‡성기사 에드릭‡Eadric el Puro‡Eadric el Puro‡Eadric le Pur‡纯洁者耶德瑞克‡『純淨者』埃卓克',
    nil,
    '‡Поговорите с Эдриком Чистым из Серебряного павильона на Ристалище Серебряного турнира.‡Sprecht mit Eadric dem Reinen beim Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭과 대화해야 합니다.‡Habla con Eadric el Puro en los Campos del Torneo Argenta.‡Habla con Eadric el Puro en los Campos del Torneo Argenta.‡Parlez à Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13795] = {
  {
    '‡Гроза Плети‡Der Geißelbann‡‡El Finiquiplaga‡El Finiquiplaga‡Le Plaie-du-Fléau‡科罗克·斩亡者‡天譴剋星',
    nil,
    '‡Поговорите с Кроком Грозой Плети в северной стороне Ристалище Серебряного турнира.‡Sprecht mit Crok Geißelbann beim Argentumturnierplatz.‡‡Habla con Crok Finiquiplaga en los Campos del Torneo Argenta.‡Habla con Crok Finiquiplaga en los Campos del Torneo Argenta.‡Parlez à Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[13807] = {
  {
    '‡FLAG: Приглашение на турнир‡Kennzeichnung: Turniereinladung‡마상시합 초대장‡Invitación al Torneo‡Invitación al Torneo‡FLAG: invitation au tournoi‡旗帜:联赛邀请‡',
    nil,
    nil,
  }
},
[13809] = {
  {
    '‡Атака с воздуха‡Bedrohung von oben‡하늘의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    '‡Эдрик Чистый из Серебряного павильона на Ристалище Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов – сектантов.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric el Puro, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Eadric le Pur, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡‡',
  }
},
[13810] = {
  {
    '‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    '‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Селлиана Первого Луча из Серебряного павильона на Ристалище Серебряного турнира. Вы можете найти их в любой области Ледяной Короны.‡Cellian Tagesanbruch beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 셀리안 데이브레이크가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Cellian Rompedía, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Cellian Bonmatin, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的塞利安·碎日要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭这些诅咒教派的成员。‡',
  }
},
[13811] = {
  {
    '‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    '‡Принесите 4 знака чемпиона Луури в павильон Серебряного союза на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Похитителей Солнца.‡Bringt 4 Male des Champions zu Luuri beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 루리에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Lleva 4 marcas del Campeón a Luuri en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Apportez 4 Marques de champion à Luuri, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡将四枚冠军的印记交给银色比武场的鲁莉。|n|n如果你丢失了长枪，可以在夺日者大帐或者兽栏附近的长枪架上再拿一根。‡',
  }
},
[13812] = {
  {
    '‡Атака с воздуха‡Bedrohung von oben‡하늘의 위협‡Amenaza desde el cielo‡Amenaza desde el cielo‡La menace vient d\'en haut‡空中的威胁‡來自上空的威脅',
    nil,
    '‡Крок Гроза Плети с Ристалища Серебряного турнира просит вас уничтожить Ледяную Пасть и 3 бомбистов – сектантов.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr Frostschlund und 3 Kultistenbombenschützen besiegt.‡‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Finiquiplaga, en el Torneo Argenta, quiere que derrotes a Yertafauce y a 3 bombarderos cultor.‡Crok Plaie-du-Fléau, dans l\'Enceinte du tournoi d\'Argent, vous demande de vaincre Frissegueule et 3 Sectateurs bombardiers.‡‡',
  }
},
[13813] = {
  {
    '‡Битва на вражеской территории‡Die Schlacht zum Gegner tragen‡선제 대응‡Llevar la batalla al enemigo‡Llevar la batalla al enemigo‡Sur le territoire ennemi‡攻入敌阵‡和敵人一戰',
    nil,
    '‡Убейте 15 членов Культа Проклятых в Ледяной Короне по заданию Зор\'бе Кровопускателя с Ристалища Серебряного турнира. Вы можете действовать в любой области Ледяной Короны.‡Zor\'be der Blutvergießer beim Argentumturnierplatz möchte, dass Ihr 15 Anhänger des Kults der Verdammten tötet. Dazu zählen alle Kultisten im Bereich von Eiskrone.‡은빛십자군 마상시합 광장에 있는 피를 부르는 조르베가 얼음왕관 지역에 있는 저주받은 자들의 교단 일원 15마리를 처치해 달라고 했습니다.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be el Flebotomista, en los Campos del Torneo Argenta, quiere que mates a 15 miembros del Culto de los Malditos. Puedes matar cultores en cualquier parte de Corona de Hielo.‡Zor\'be le Saigneur, dans l\'Enceinte du tournoi d\'Argent, vous demande de tuer 15 membres du Culte des damnés. Vous pouvez tuer des sectateurs partout dans la Couronne de glace.‡银色比武场的放血者佐尔比要你在冰冠冰川地区消灭15名诅咒教派成员。你可以在冰冠冰川的任何地方消灭那些异教徒。‡',
  }
},
[13814] = {
  {
    '‡На равных с чемпионами‡Unter Champions‡용사 대 용사‡Entre los campeones‡Entre los campeones‡Entre champions…‡冠军的比武‡勇士們',
    nil,
    '‡Принесите 4 знака чемпиона Иллирии Приходу Тьмы на Ристалище Серебряного турнира.|n|nЕсли вы потеряете копье, возьмите другое с любой оружейной стойки рядом со стойлами или в павильоне Похитителей Солнца.‡Bringt 4 Male des Champions zu Illyrie Nachtlauer beim Argentumturnierplatz.|n|nLanzen gibt es auf jedem Lanzenständer in der Nähe der angebundenen Reittiere oder im Sonnenhäscherpavillon, falls Ihr die Eure verlieren solltet.‡은빛십자군 마상시합 광장에 있는 일라이리 나이트폴에게 용사의 징표 4개를 가져가야 합니다.|n|n창을 잃으면 마구간 근처나 선리버 막사에 있는 창 선반에서 다른 창을 구할 수 있습니다.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Lleva 4 marcas del Campeón a Illyrie Ocaso en los Campos del Torneo Argenta.|n|nSi pierdes tu lanza puedes obtener otra de cualquiera de los expositores de lanzas cerca de los establos o en el pabellón Atracasol.‡Apportez 4 Marques de champion à Illyrie Tombenuit, dans l\'Enceinte du tournoi d\'Argent.|n|nSi vous perdez votre lance, vous pouvez en prendre une autre dans n\'importe quel Râtelier de lances près des écuries, ou dans le Pavillon de Saccage-soleil.‡‡',
  }
},
[13816] = {
  {
    '‡Священный планетарий (героич.)‡Heroisch: Das Himmlische Planetarium‡영웅: 별자리 투영관‡Heroico: El Planetario Celestial‡Heroico: El Planetario Celestial‡Héroïque: le planétarium céleste‡英雄：天文台‡英雄:星穹渾天儀',
    nil,
    '‡Найдите Священный планетарий по заданию геолога Лорен из Архива в Ульдуаре.‡Ausgrabungsleiterin Loren im Archivum möchte, dass Ihr den Eingang zum Himmlischen Planetarium findet.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 별자리 투영관의 입구를 찾아 달라고 했습니다.‡El prospector Loren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡El prospector Loren en El Archivum de Ulduar quiere que localices la entrada al Planetario Celestial.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé de trouver l\'entrée du Planétarium céleste.‡奥杜尔档案馆中的勘探员罗尔伦要你找到天文台的入口。‡',
  }
},
[13817] = {
  {
    'Modo Heroico: Disco de Dados do Archivum‡Диск доступа к Архиву (героич.)‡Heroisch: Datenscheibe des Archivums‡영웅: 고대 기록관 자료 원반‡Heroico: Disco de datos de El Archivum‡Heroico: Disco de datos de El Archivum‡Héroïque : le disque de données de l\'Archivum‡英雄：档案馆数据圆盘‡英雄:大資料庫資料圓盤',
    nil,
    'Leve o Disco de Dados do Archivum ao Console do Archivum em Ulduar.‡Отнесите диск доступа к Архиву к панели управления Архивом в Ульдуаре.‡Bringt die Datenscheibe des Archivums zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 고대 기록관 자료 원반을 가져가야 합니다.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Lleva el disco de datos de El Archivum a la consola de El Archivum en Ulduar.‡Apportez le Disque de données de l\'Archivum à la Console de l\'Archivum dans Ulduar.‡将档案馆数据圆盘带到奥杜尔的档案馆控制台前。‡將大資料資料取圓盤帶到奧杜亞的大資料庫控制臺。',
  }
},
[13818] = {
  {
    '‡Алгалон (героич.)‡Heroisch: Algalon‡영웅: 알갈론‡Heroico: Algalon‡Heroico: Algalon‡Héroïque: Algalon‡英雄：奥尔加隆‡英雄:艾爾加隆',
    nil,
    '‡Принесите печати хранителей к панели управления Архивом в Ульдуаре.‡Bringt die Siegel der Wächter zur Archivumkonsole in Ulduar.‡울두아르 안에 있는 고대 기록관 조작대로 감시자의 인장 묶음을 가져가야 합니다.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Lleva los sigilos de los vigías a la consola de El Archivum en Ulduar.‡Apportez les Cachets des guetteurs à la Console de l\'Archivum d\'Ulduar.‡‡',
  }
},
[13819] = {
  {
    'Modo Heroico: Tudo está bem quando termina bem‡Все хорошо, что хорошо кончается (героич.)‡Heroisch: Ende gut, alles gut‡영웅: 끝이 좋으면 다 좋다‡Heroico: Bien está lo que bien acaba‡Heroico: Bien está lo que bien acaba‡Héroïque : tout est bien qui finit bien‡英雄：结果好，一切都好‡英雄:情況良好，完美收場',
    nil,
    'Leve o Código de Resposta Alfa para Rhonin em Dalaran.‡Доставьте код отклика "Альфа" Ронину в Даларан.‡Überbringt Rhonin in Dalaran den Antwortcode Alpha.‡응답 코드 알파를 달라란에 있는 로닌에게 가져가야 합니다.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Lleva el código de respuesta Alfa a Rhonin en Dalaran.‡Apportez le Code-réponse Alpha à Rhonin, à Dalaran.‡将回复代码阿尔法交给达拉然的罗宁。‡將回覆代碼Α帶給達拉然的羅甯。',
  }
},
[13820] = {
  {
    '‡Семья Рвизасовов‡Die Gebrüder Sprengbolz‡블라스트볼트 형제‡Los hermanos Cargarrayo‡Los hermanos Cargarrayo‡Les frères Boumboulon‡布拉斯波兄弟‡爆栓兄弟',
    nil,
    '‡Поговорите с Беззлом Рвизасовом на Ристалище Серебряного турнира.‡Sprecht mit Stumpi Sprengbolz am Argentumturnierplatz.‡은빛십자군 마상시합 광장에 있는 베즐 블라스트볼트와 대화해야 합니다.‡Habla con Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Habla con Bezzle Cargarrayo en los Campos del Torneo Argenta.‡Parlez à Gaspi Boumboulon dans l\'Enceinte du tournoi d\'Argent.‡与银色比武场的贝兹尔·布拉斯波谈一谈。‡',
  }
},
[13821] = {
  {
    '‡Печать Фрейи (героич.)‡Heroisch: Freyas Siegel‡영웅: 프레이야의 인장‡Heroico: El sigilo de Freya‡Heroico: El sigilo de Freya‡Héroïque: le cachet de Freya‡英雄：弗蕾亚的徽记‡英雄:芙蕾雅的符印',
    nil,
    '‡Добудьте печать Фрейи по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Freyas Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Freyas Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 프레이야의 인장을 가져와 달라고 했습니다.|n|n프레이야의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Freya.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Freya.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将弗蕾亚的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得弗蕾亚的徽记。‡',
  }
},
[13822] = {
  {
    '‡Печать Ходира (героич.)‡Heroisch: Hodirs Siegel‡영웅: 호디르의 인장‡Heroico: El sigilo de Hodir‡Heroico: El sigilo de Hodir‡Héroïque: le cachet de Hodir‡英雄：霍迪尔的徽记‡英雄:霍迪爾的符印',
    nil,
    '‡Добудьте печать Ходира по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Hodirs Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Hodirs Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 호디르의 인장을 가져와 달라고 했습니다.|n|n호디르의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Hodir.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Hodir.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将霍迪尔的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得霍迪尔的徽记。‡',
  }
},
[13823] = {
  {
    '‡Печать Торима (героич.)‡Heroisch: Thorims Siegel‡영웅: 토림의 인장‡Heroico: El sigilo de Thorim‡Heroico: El sigilo de Thorim‡Héroïque: le cachet de Thorim‡英雄：托里姆的徽记‡英雄:索林姆的符印',
    nil,
    '‡Добудьте печать Торима по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiterin Loren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Thorims Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Thorims Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 토림의 인장을 가져와 달라고 했습니다.|n|n토림의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Thorim.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Thorim.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将托里姆的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得托里姆的徽记。‡',
  }
},
[13824] = {
  {
    '‡Печать Мимирона (героич.)‡Heroisch: Mimirons Siegel‡영웅: 미미론의 인장‡Heroico: El sigilo de Mimiron‡Heroico: El sigilo de Mimiron‡Héroïque: le cachet de Mimiron‡英雄：米米尔隆的徽记‡英雄:彌米倫的符印',
    nil,
    '‡Добудьте печать Мимирона по заданию геолога Лорен.|n|nЗа дополнительными сведениями обратитесь к панели управления Архивом.‡Ausgrabungsleiter Doren im Archivum in Ulduar möchte, dass Ihr in den Besitz von Mimirons Siegel gelangt.|n|nUm mehr darüber herauszufinden, wie Ihr Mimirons Siegel erlangen könnt, solltet Ihr die Archivumkonsole zu Rate ziehen.‡울두아르의 고대 기록관에 있는 발굴조사단장 로렌이 미미론의 인장을 가져와 달라고 했습니다.|n|n미미론의 인장에 대해 더 많은 정보를 얻으려면 고대 기록관 조작대를 참고하십시오.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡El prospector Loren en El Archivum de Ulduar quiere que consigas el sigilo de Mimiron.|n|nSi quieres más información sobre cómo conseguirlo, consulta la consola de El Archivum.‡La Prospectrice Loren, à l\'Archivum d\'Ulduar, vous a demandé d\'obtenir le Cachet de Mimiron.|n|nPour savoir comment faire, consultez la console de l\'Archivum.‡将米米尔隆的徽记交给奥杜尔档案馆中的勘探员罗尔伦。|n|n你可以向档案馆控制台查询如何获得米米尔隆的徽记。‡',
  }
},
[13825] = {
  {
    'Escondidinho Marisquete‡Мидии с сюрпризом‡Muschelette Surprise‡조개 별미‡Sorpresa de almejate‡Sorpresa de almejate‡La surprise de palourdes‡蚌肉大餐‡蚌肉大餐',
    nil,
    nil,
  }
},
[13826] = {
  {
    'Nat Pagle, o pescador supremo‡Нат Пэгл, великий рыболов‡Nat Pagle, Extremangler‡낚시의 달인 내트 페이글‡Nat Pagle, pescador extremo‡Nat Pagle, pescador extremo‡Nat Pagle, pêcheur de l\'extrême‡钓鱼专家纳特·帕格‡釣魚專家納特·帕格',
    nil,
    nil,
  }
},
[13828] = {
  {
    '‡Мастер ближнего боя‡Den Nahkampf beherrschen‡근접 공격 완전 정복‡Dominio del combate cuerpo a cuerpo‡Dominio del combate cuerpo a cuerpo‡La maîtrise de la mêlée‡近战训练‡精通近戰',
    nil,
    '‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Джераном Локвудом и отработайте прием "Выпад" 5 раз на манекене для ближнего боя. После этого вернитесь к чародею Таэлису в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Jeran Waldesruh und wendet fünfmal die Fähigkeit \'Zustoßen\' gegen ein Nahkampfziel an. Kehrt anschließend zu Arkanist Taelis beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 제란 록우드와 이야기를 나누고 근접 표적에 찌르기를 5번 사용한 다음 은빛십자군 마상시합 광장에 있는 신비술사 탤리스에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver al arcanista Taelis en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver al arcanista Taelis en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Jeran Boisclos et utilisez 5 fois le Coup de lance sur une Cible de mêlée. Puis retournez voir l\'Arcaniste Taelis dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和耶兰·洛克伍德谈一谈，然后对一个近战目标使用5次刺击。完成训练后回到银色比武场，向奥术师泰利斯复命。‡',
  }
},
[13829] = {
  {
    '‡Мастер ближнего боя‡Den Nahkampf beherrschen‡근접 공격 완전 정복‡Dominio del combate cuerpo a cuerpo‡Dominio del combate cuerpo a cuerpo‡La maîtrise de la mêlée‡近战训练‡精通近戰',
    nil,
    '‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Джераном Локвудом и отработайте прием "Выпад" 5 раз на манекене для ближнего боя. После этого вернитесь к магистру Эдиену Солнечной Низине в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den abgestellten Falkenschreiter der Sonnenhäscher außerhalb des Pavillons. Sprecht mit Jeran Waldesruh und wendet fünfmal die Fähigkeit \'Zustoßen\' auf ein Nahkampfziel an. Kehrt anschließend zu Magister Edien Sonnental beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 제란 록우드와 이야기를 나누고 근접 표적에 찌르기를 5번 사용한 다음 은빛십자군 마상시합 광장에 있는 마법학자 에디엔 선할로우에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver a Edien Vacuosol en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Jeran Cierramadera y usa Estocada 5 veces contra un objetivo cuerpo a cuerpo, luego ve a ver a Edien Vacuosol en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie qui se trouve devant le pavillon. Parlez à Jeran Boisclos et utilisez 5 fois le Coup de lance sur une Cible de mêlée. Puis retournez voir le Magistère Edien Solcreuse dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和耶兰·洛克伍德谈一谈，然后对一个近战目标使用5次刺击。完成训练后回到银色比武场，向魔导师埃迪恩·炎谷复命。‡',
  }
},
[13830] = {
  {
    'O Peixe-espectro‡Рыба-призрак‡Der Geisterfisch‡유령물고기‡El espeztro‡El espeztro‡Le poisson-fantôme‡幽灵鱼‡魅影鬼魚',
    nil,
    'Márcia Caniço, em Dalaran, quer que você desvende o mistério do Peixe-espectro Fantasma.‡Раскройте тайну рыбы-призрака по просьбе Марсии Чейз из Даларана.‡Marcia Balzer in Dalaran möchte, dass Ihr hinter das Geheimnis des Phantomgeisterfischs kommt.‡달라란에 있는 마르시아 체이스가 허깨비 유령물고기의 비밀을 알아내 달라고 부탁했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que descubras el misterio del espeztro.‡Marcia Sedal en Ciudad de Dalaran quiere que descubras el misterio del espeztro.‡Marcia Chase, à Dalaran, veut que vous découvriez le mystère du Poisson-fantôme spectral.‡达拉然城中的玛西娅·切斯希望你去揭开幽灵鱼的秘密。‡達拉然的瑪西亞·切斯要你揭開魅影鬼魚的秘密。',
  }
},
[13832] = {
  {
    'Joia dos esgotos‡Звезда сточных вод‡Perle der Kanalisation‡하수도의 보석‡Joya de las cloacas‡Joya de las cloacas‡Le joyau des égouts‡下水道中的珍宝‡下水道的珠寶',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga uma Joia Corroída.‡Принесите Марсии Чейз в Даларан ржавое украшение.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr korrodierten Schmuck bringt.‡달라란에 있는 마르시아 체이스가 녹슨 장신구를 가져다 달라고 부탁했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas una joya corroída.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas una joya corroída.‡Marcia Chase, à Dalaran, veut que vous lui apportiez un Bijou corrodé.‡将一块被腐蚀的珠宝交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞·切斯要你帶給她一塊被腐蝕的首飾。',
  }
},
[13833] = {
  {
    'O sangue é forte‡Густая кровь‡Blut ist dicker‡피는 진하다‡La sangre es más espesa‡La sangre es más espesa‡Le sang est plus épais que l\'eau‡危险的美食‡血濃於水',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga 5 Farnesins-dente-sangrento.‡Принесите Марсии Чейз в Даларан 5 ужрей-кровопийц.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr 5 Blutzahnfrenzys bringt.‡달라란에 있는 마르시아 체이스가 핏빛이빨 프렌지 5마리를 잡아다 달라고 부탁했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 5 peces furia sangradientes.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 5 peces furia sangradientes.‡Marcia Chase, à Dalaran, veut que vous lui apportiez 5 Furies dents-sanglantes.‡将10条恐怖鱼交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞·切斯要你帶給她5隻血牙狂魚。',
  }
},
[13834] = {
  {
    'Delicioso e letal‡Опасный деликатес‡Gefährlich köstlich‡겁나게 맛있는‡Peligrosamente delicioso‡Peligrosamente delicioso‡Dangereusement délicieux...‡危险的美食‡危險的美味',
    nil,
    'Márcia Caniço, em Dalaran, quer que você lhe traga 10 Deimopeixes.‡Принесите Марсии Чейз в Даларан 10 террорелей.‡Marcia Balzer in Dalaran möchte, dass Ihr ihr 10 Schreckensfische bringt.‡달라란에 있는 마르시아 체이스가 공포물고기 10마리를 잡아다 달라고 부탁했습니다.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 10 peces de terror.‡Marcia Sedal en Ciudad de Dalaran quiere que le traigas 10 peces de terror.‡Marcia Chase, à Dalaran, veut que vous lui apportiez 10 Terrochets.‡将10条恐怖鱼交给达拉然城中的玛西娅·切斯。‡達拉然的瑪西亞·切斯要你帶給她10隻駭魚。',
  }
},
[13835] = {
  {
    '‡Мастер дальнего боя‡Den Schildbrecherangriff beherrschen‡방패 부수기의 대가‡Dominio de Romper escudo‡Dominio de Romper escudo‡La maîtrise du brise-bouclier‡碎盾训练‡精通破盾',
    nil,
    '‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Валисом Ловцом Ветра и отработайте "Удар по щиту" 2 раза на мишени для дальнего боя. После этого вернитесь к разведчице Шалиндрии на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Valis Windhetzer und wendet die Fähigkeit "Schildbrecher" gegen 2 ungeschützte Distanzziele an. Kehrt anschließend zu Späherin Shalyndria beim Argentumturnierplatz zurück.‡창을 장착하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 발리스 윈드체이서와 대화하고, 약해진 원거리 표적 2개에 방패 부수기를 사용한 다음 은빛십자군 마상시합 광장에 있는 정찰병 샬린드리아에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a la exploradora Shalyndria en los Campos del Torneo Argenta.‡Équipez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Valis Chassevent et utilisez le Brise-bouclier sur 2 Cibles à distance vulnérables. Puis retournez voir l\'Éclaireur Shalyndria dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和瓦利斯·逐风者谈一谈，然后对两个脆弱的远程目标使用碎盾技能。完成训练后回到银色比武场，向斥候沙琳蒂亚复命。‡',
  }
},
[13836] = {
  {
    'Situação desembraçosa!‡Обезручен!‡Arm dran, Arm ab!‡별난 낚시‡¡Desbrazado!‡¡Desbrazado!‡Les bras lui en tombent‡胳膊丢了！‡少了隻胳膊!',
    nil,
    'Olissarra, a Bondosa, em Dalaran, quer que você lhe traga o Braço decepado.‡Принесите откушенную руку Олисарре Доброй в Даларан.‡Olisarra die Gütige in Dalaran möchte, dass Ihr ihr den abgetrennten Arm bringt.‡달라란에 있는 친절한 올리사라가 뜯어진 장갑을 가져다 달라고 부탁했습니다.‡Olisarra la Amable, en Ciudad de Dalaran, quiere que le traigas el brazo arrancado.‡Olisarra la Amable, en Ciudad de Dalaran, quiere que le traigas el brazo arrancado.‡Olisarra la Charitable, à Dalaran, veut que vous lui rapportiez le Bras coupé.‡将断臂交给达拉然城中的善良的欧莉萨拉。‡達拉然的仁慈的歐莉珊拉要你把斷裂的手臂帶給她。',
  }
},
[13837] = {
  {
    '‡Мастер стремительной атаки‡Den Ansturmangriff beherrschen‡돌진 완전 정복‡Dominio de Cargar‡Dominio de Cargar‡La maîtrise de la charge‡冲锋训练‡精通衝鋒',
    nil,
    '‡Вооружитесь копьем и оседлайте кель\'дорайского скакуна – он ждет вас снаружи павильона. Поговорите с Раганом Сталебрюхом и отработайте "Рывок" 2 раза на манекене для стремительной атаки. После этого вернитесь к Аварету Молниеносному Удару в шатер Альянса на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf das abgestellte Streitross der Quel\'dorei außerhalb des Pavillons. Sprecht mit Rugan Stahlbauch und wendet die Fähigkeit \'Sturmangriff\' gegen 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Avareth Flinkstoß beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 쿠엘도레이 군마에 올라타십시오. 루간 스틸벨리와 이야기를 나누고, 약해진 돌진 표적에 돌진을 2번 사용한 다음 은빛십자군 마상시합 광장에 있는 아바레스 스위프트스트라이크에게 가야 합니다.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Avareth Golpeveloz en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el corcel Quel\'dorei de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Avareth Golpeveloz en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Palefroi quel\'dorei à l\'écurie qui se trouve devant le pavillon. Parlez à Rugan Ventracier et Chargez 2 Cibles de charge vulnérables, puis retournez voir Avareth Frappe-rapide dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的奎尔多雷战马。和卢格安·钢胃谈一谈，然后向两个脆弱的冲锋目标发动冲锋。完成训练后回到银色比武场，向阿瓦雷斯·迅击复命。‡',
  }
},
[13838] = {
  {
    '‡Мастер дальнего боя‡Den Schildbrecherangriff beherrschen‡방패 부수기의 대가‡Dominio de Romper escudo‡Dominio de Romper escudo‡La maîtrise du brise-bouclier‡碎盾训练‡精通破盾',
    nil,
    '‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Валисом Ловцом Ветра и 2 раза отработайте "Удар по щиту" на мишени для дальнего боя. После этого вернитесь к Галатии Сияющий Рассвет в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den abgestellten Falkenschreiter der Sonnenhäscher. Sprecht mit Valis Windhetzer und wendet die Fähigkeit \'Schildbrecher\' gegen 2 ungeschützte Distanzziele an. Kehrt anschließend zu Galathia Morgenglanz beim Argentumturnierplatz zurück.‡창을 장착하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 발리스 윈드체이서와 대화하고 약해진 원거리 표적 2개에 방패 부수기를 사용한 다음 은빛십자군 마상시합 광장에 있는 갈라시아 브라이트돈에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo. Habla con Valis Cazavientos y usa Romper escudo sobre 2 objetivos a distancia vulnerables, luego ve a ver a Galathia Alba Brillante en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie. Parlez à Valis Chassevent et utilisez le Brise-bouclier sur 2 Cibles à distance vulnérables, puis retournez voir Galathia Brillaube dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和瓦利斯·逐风者谈一谈，然后对两个脆弱的远程目标使用碎盾技能。完成训练后回到银色比武场，向加拉希亚·晨光复命。‡',
  }
},
[13839] = {
  {
    '‡Мастер стремительной атаки‡Den Ansturmangriff beherrschen‡돌진 완전 정복‡Dominio de Cargar‡Dominio de Cargar‡La maîtrise de la charge‡冲锋训练‡精通衝鋒',
    nil,
    '‡Вооружитесь копьем и оседлайте крылобега Похитителей Солнца – он ждет вас снаружи павильона. Поговорите с Раганом Сталебрюхом и отработайте прием "Рывок" 2 раза на манекене для стремительной атаки. После этого вернитесь к Амариэлю Верному Солнцу в шатер Орды на Ристалище Серебряного турнира.‡Nehmt Eure Lanze und steigt auf den angebundenen Falkenschreiter der Sonnenhäscher außerhalb des Pavillons. Sprecht mit Rugan Stahlbauch und wendet die Fähigkeit \'Sturmangriff\' gegen 2 ungeschützte Sturmangriffsziele an. Kehrt anschließend zu Amariel Sonnenschwur beim Argentumturnierplatz zurück.‡창을 착용하고 막사 밖에 있는 길들인 선리버 매타조에 올라타십시오. 루간 스틸벨리와 이야기를 나누고, 약해진 돌진 표적에 돌진을 2번 사용한 다음 은빛십자군 마상시합 광장에 있는 아마리엘 선스원에게 가야 합니다.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Amariel Jurasol en los Campos del Torneo Argenta.‡Equipa tu lanza y monta el halcón zancudo Atracasol de establo que hay fuera del pabellón. Habla con Rugan Tripacero y usa Cargar sobre 2 objetivos de carga vulnerables, luego ve a ver a Amariel Jurasol en los Campos del Torneo Argenta.‡Empoignez votre lance et montez le Faucon-pérégrin saccage-soleil à l\'écurie qui se trouve devant le pavillon. Parlez à Rugan Ventracier et Chargez 2 Cibles de charge vulnérables, puis retournez voir Amariel Ligesol dans l\'Enceinte du tournoi d\'Argent.‡装备上你的长枪，到大帐外面骑上兽栏中的夺日者陆行鸟。和卢格安·钢胃谈一谈，然后向两个脆弱的冲锋目标发动冲锋。完成训练后回到银色比武场，向阿玛里尔·火盟复命。‡',
  }
},
[13840] = {
  {
    'REUSE‡ПОВТОРНОЕ ИСПОЛЬЗОВАНИЕ‡GLUCK!‡미사용‡REUTILIZAR‡REUSE‡RÉUTILISER‡REUSE‡重複使用',
    nil,
    'Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡Найдите цыплячий корм и вернитесь к загадочной курице. Когда найдете курицу, покажите ей, как вы рады ее видеть (эмоция "/рад"), а потом накормите специальным цыплячьим кормом.‡Beschafft Euch etwas Spezialhühnerfutter und kehrt zu dem Huhn zurück, das sich mit Euch angefreundet hat. Wenn Ihr es gefunden habt, dann benutzt erst /cheer, ehe Ihr dem Huhn das Spezialhühnerfutter gebt.‡Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Consigue comida para pollos especial y vuelve junto a tu nuevo amigo pollo. Cuando lo encuentres, anímalo con el comando /animar antes de darle la comida para pollos especial.‡Trouver de la Nourriture spéciale pour poulet et l\'apporter à la poule que vous voulez aider. Lorsque vous l\'aurez trouvée, encouragez-la (/acclame) avant d\'essayer de lui donner la Nourriture spéciale pour poulet.‡Find some Special Chicken Feed and return to your befriended chicken. When you find it, /cheer at it before trying to give it the Special Chicken Feed.‡找一些特殊的雞飼料，把它交給友好的小雞。當你找到小雞的時候，在餵食它特殊的雞飼料之前對它做出拍動翅膀的表情。(使用/cheer 命令)',
  }
},
[13843] = {
  {
    '‡Комплект для сборки Хламобота‡Das Konstruktionsset: Schrottbot‡‡El equipo de construcción de robot chatarra‡El equipo de construcción de robot chatarra‡Le kit de construction de robot-ferrailleur‡废物贩卖机器人制造器‡廢物販賣機器人製造器',
    nil,
    '‡Изучите данные панели управления прототипом в библиотеке Изобретателя.‡Benutzt die Prototypenkonsole in der Bibliothek des Erfinders.‡발명가의 도서관에 있는 모형 조작대를 작동시켜야 합니다.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Interactúa con la consola prototipo en la Biblioteca del Inventor.‡Utilisez la Console prototype à la Bibliothèque de l\'inventeur.‡使用创世者的图书馆中的原型机控制台。‡',
  }
},
[13845] = {
  {
    'Ampola lacrada de veneno‡Запечатанный фиал с ядом‡Versiegelte Giftphiole‡봉인된 독약병‡Vial de veneno sellado‡Vial de veneno sellado‡Une fiole de poison scellée‡密封的毒药瓶‡密封的毒藥瓶',
    nil,
    'Entregue a Ampola Lacrada de Veneno para o Alquimista Cinestra nos Esgotos de Dalaran.‡Принесите запечатанный фиал с ядом алхимику Синесре в Стоки Даларана.‡Bringt die versiegelte Giftphiole zu Alchemist Cinesra in die Kanalisation von Dalaran.‡달라란 하수도에 있는 연금술사 시네스라에게 봉인된 독약병을 가져가야 합니다.‡Llévale el vial de veneno sellado al alquimista Cinesra en las Cloacas de Dalaran.‡Llévale el vial de veneno sellado al alquimista Cinesra en las Cloacas de Dalaran.‡Apportez la Fiole de poison scellée à l’Alchimiste Cinesra, dans les Égouts de Dalaran.‡将密封的毒药瓶交给达拉然下水道的炼金师辛奈斯拉。‡把這個密封的毒藥瓶交給達拉然下水道的鍊金師席尼斯拉。',
  }
},
[13846] = {
  {
    '‡Вклад в общее дело‡Einen Beitrag leisten‡대의에 기부하라‡Contribuir a la causa‡Contribuir a la causa‡Un don pour la cause‡微薄的贡献‡為理念捐款',
    nil,
    '‡Поговорите с оруженосцем Арти и пожертвуйте 10 золотых на нужды Серебряного Авангарда.‡Sprecht mit Knappe Artie, um einen Beitrag von 10 Gold an den Argentumkreuzzug zu leisten.‡종자 아티와 대화하여 은빛십자군의 대의를 위해 10골드를 기부해야 합니다.‡Habla con el escudero Artie para donar 10 oros a la causa de la Cruzada Argenta.‡Habla con el escudero Artie para donar 10 oros a la causa de la Cruzada Argenta.‡Parlez à l\'Ecuyer Artie pour faire un don de 10 pièces d\'or à la cause de la Croisade d\'Argent.‡与侍从亚迪再次交谈，为银色北伐军的事业捐献10枚金币。‡',
  }
},
[13847] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию капитана Джозефа Холли из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Hauptmann Joseph Holley beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 대장 조셉 홀리가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡El capitán Joseph Holley en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡El capitán Joseph Holley en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Capitaine Joseph Holley, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的约瑟夫·霍雷上尉要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13850] = {
  {
    'Tolerância tóxica‡Иммунитет к яду‡Gifttoleranz‡독에 대한 내성‡Tolerancia tóxica‡Tolerancia tóxica‡Mithridatisation‡毒药的免疫力‡抗禦毒性',
    nil,
    'Mor\'vek, na Cratera Un\'Goro, disse que se você ficar coberto com o sangue dos Ravassauros Pelenosos 20 vezes, poderá montar um deles sem morrer. Para ter uma chance de ficar envenenado, basta atacar um Ravassauro Pelenoso.‡Мор\'век из Кратера Ун\'Горо утверждает, что вам необходимо 20 раз отравиться кровью ядошкурого равазавра, чтобы выработать иммунитет к яду. Чтобы кровь равазавра попала на вашу кожу, нападите на него.‡Mor\'vek im Krater von Un\'Goro behauptet, dass wenn man 20-mal von dem Blut eines Gifthautravasauriers vergiftet wurde, auf einem reiten könnte, ohne zu sterben. Greift die Saurier an, um vielleicht vergiftet zu werden.‡운고로 분화구에 있는 모르벡이 맹독가죽 라바사우르스 피에 20번 중독된다면 탔을 때 죽지 않는다고 말했습니다. 독을 맞도록 맹독가죽 라바사우르스를 공격해야 합니다.‡Según Mor\'vek en el Cráter de Un\'Goro, si te salpica la sangre envenenada de un ravasaurio pellejo venenoso 20 veces, podrás montar uno sin morirte. Ataca a los ravasaurios pellejo venenoso para que te envenenen.‡Según Mor\'vek en el Cráter de Un\'Goro, si te salpica la sangre envenenada de un ravasaurio Pellejo Venenoso 20 veces, podrás montar uno sin morirte. Ataca a los ravasaurios Pellejo Venenoso para que te envenenen.‡Mor\'vek, dans le cratère d’Un’goro, assure que si vous êtes empoisonné 20 fois par du sang de ravasaure peau-de-venin, vous pouvez en monter sans mourir. Attaquez des Ravasaures peau-de-venin pour avoir une chance d’être empoisonné.‡安戈洛环形山的莫维克说，如果你能被毒皮暴掠龙的血染上20次毒，就可以安全地骑它了。攻击毒皮魔暴龙，有一定几率会中毒。‡安戈洛環形山的莫維克聲稱如果暴露在毒皮暴掠龍的毒血之下達20次後，騎乘毒皮暴掠龍就不會被毒死。攻擊毒皮暴掠龍就有機會中毒。',
  }
},
[13851] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Клары Взубногой из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Clara Torkelbräu beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 클라라 텀블브루가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Clara Vueltabirra en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Clara Vueltabirra en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Clara Voltebière, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的克拉拉·沸酒要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13852] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Фликля Гайковерта из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Klick Radspanner beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 플리킨 기어스패너가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Flickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Flickin Trazagranaje en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Krante Clépharnaüm, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的弗林克·扳钳要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13854] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Рании из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Ranii beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 라니가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Ranii en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Ranii en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Ranii, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的兰妮要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13855] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Айре Устремленной к Звездам из Павильона Серебряного союза на Ристалище Серебряного турнира .‡Airae Sternensucher beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 아이래 스타시커가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Airae Buscaestelar en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Airae Buscaestelar en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Airae Cherchétoile, dans l\'Enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的艾莱·觅星要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13856] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Моры Сестры Воргов из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Morah Worgschwester beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 모라 워그시스터가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Morah Hermana de Huargos en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Morah Hermana de Huargos en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Morah Sœur-worg, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的茉拉·狼女要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13857] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Гаджу из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Gahju beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 가쥬가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Gahju en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Gahju en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Gahju, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的加尔祖要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13858] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Анки Точеное Копыто из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Anka Klauenhuf beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache un 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 안카 클로후프가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Anka Garrapezuña en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Anka Garrapezuña en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Anka Sabot-Griffu, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡‡',
  }
},
[13859] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию Аниры Турон из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Aneera Thuron beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 아니라 투론이 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡Aneera Thuron en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Aneera Thuron en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Aneera Thuron, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡银色比武场的安妮拉·索隆要求你消灭15名白骨卫士步兵、10名白骨卫士斥候和3名白骨卫士军官。‡',
  }
},
[13860] = {
  {
    '‡У вражеских врат‡Vor den Toren des Feindes‡적의 관문에서‡A las puertas del enemigo‡A las puertas del enemigo‡Aux portes de l\'ennemi‡兵临城下‡在敵人的大門前',
    nil,
    '‡Убейте 15 костяных пехотинцев, 10 костяных разведчиков и 3 костяных лейтенантов по заданию дрессировщика Дреча из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Tierführer Dretch beim Argentumturnierplatz möchte, dass Ihr 15 Fußsoldaten der Knochenwache, 10 Späher der Knochenwache und 3 Leutnants der Knochenwache vernichtet.‡은빛십자군 마상시합 광장에 있는 조련사 드레치가 해골경비대 보병 15마리, 해골경비대 정찰병 10마리, 해골경비대 부관 3마리를 처치해 달라고 했습니다.‡El cuidador Dretch en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡El cuidador Dretch en los Campos del Torneo Argenta quiere que mates a 15 lacayos Guardahuesos, 10 exploradores Guardahuesos y 3 tenientes Guardahuesos.‡Le Dresseur Dretch, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 15 Fantassins de la garde d\'os, 10 Eclaireurs de la garde d\'os et 3 Lieutenants de la garde d\'os.‡‡',
  }
},
[13861] = {
  {
    '‡Битва у Цитадели‡Schlacht vor der Zitadelle‡성채를 향한 전투‡Batalla ante la ciudadela‡Batalla ante la ciudadela‡La bataille devant la citadelle‡堡垒外的战斗‡冰冠城塞前的戰鬥',
    nil,
    '‡По заданию Эдрика Чистого из Серебряного павильона на Ристалище Серебряного турнира убейте 3 костяных командиров.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr 3 Kommandanten der Knochenwache tötet.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭이 해골경비대 사령관 3마리를 처치해 달라고 했습니다.‡Eadric el Puro en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Eadric el Puro en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Eadric le Pur, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 3 Commandants de la garde d\'os.‡银色比武场的纯洁者耶德瑞克要求你消灭3名白骨卫士指挥官。‡',
  }
},
[13862] = {
  {
    '‡Битва у Цитадели‡Schlacht vor der Zitadelle‡성채를 향한 전투‡Batalla ante la ciudadela‡Batalla ante la ciudadela‡La bataille devant la citadelle‡堡垒外的战斗‡冰冠城塞前的戰鬥',
    nil,
    '‡По заданию Эдрика Чистого из Серебряного павильона на Ристалище Серебряного турнира убейте 3 костяных командиров.‡Eadric der Reine beim Argentumturnierplatz möchte, dass Ihr 3 Kommandanten der Knochenwache tötet.‡은빛십자군 마상시합 광장에 있는 성기사 에드릭이 해골경비대 사령관 3마리를 처치해 달라고 했습니다.‡Eadric el Puro en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Eadric el Puro en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Eadric le Pur, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 3 Commandants de la garde d\'os.‡银色比武场的纯洁者耶德瑞克要求你消灭3名白骨卫士指挥官。‡',
  }
},
[13863] = {
  {
    '‡Битва у Цитадели‡Schlacht vor der Zitadelle‡성채를 향한 전투‡Batalla ante la ciudadela‡Batalla ante la ciudadela‡La bataille devant la citadelle‡堡垒外的战斗‡冰冠城塞前的戰鬥',
    nil,
    '‡По заданию Крока Грозы Плети с Ристалища Серебряного турнира убейте 3 костяных командиров.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr 3 Kommandanten der Knochenwache tötet.‡은빛십자군 마상시합 광장에 있는 크록 스컬지베인이 해골경비대 사령관 3마리를 처치해 달라고 했습니다.‡Crok Finiquiplaga en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Crok Finiquiplaga en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Crok Plaie-du-Fléau, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 3 Commandants de la garde d\'os.‡银色比武场的科罗克·斩亡者要求你消灭3名白骨卫士指挥官。‡',
  }
},
[13864] = {
  {
    '‡Битва у Цитадели‡Schlacht vor der Zitadelle‡성채를 향한 전투‡Batalla ante la ciudadela‡Batalla ante la ciudadela‡La bataille devant la citadelle‡堡垒外的战斗‡冰冠城塞前的戰鬥',
    nil,
    '‡По заданию Крока Грозы Плети с Ристалища Серебряного турнира убейте 3 костяных командиров.‡Crok Geißelbann beim Argentumturnierplatz möchte, dass Ihr 3 Kommandanten der Knochenwache tötet.‡은빛십자군 마상시합 광장에 있는 크록 스컬지베인이 해골경비대 사령관 3마리를 처치해 달라고 했습니다.‡Crok Finiquiplaga en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Crok Finiquiplaga en los Campos del Torneo Argenta quiere que mates a 3 comandantes Guardahuesos.‡Crok Plaie-du-Fléau, dans l\'enceinte du tournoi d\'Argent, veut que vous tuiez 3 Commandants de la garde d\'os.‡银色比武场的科罗克·斩亡者要求你消灭3名白骨卫士指挥官。‡',
  }
},
[13887] = {
  {
    'Ovos de Pelenoso‡Яйца ядошкурого равазавра‡Gifthauteier‡맹독가죽 알‡Huevo de pellejo venenoso‡Huevo de Pellejo Venenoso‡Des œufs de peau-de-venin‡毒皮暴掠龙蛋‡毒皮暴掠龍蛋',
    nil,
    'Traga 4 Ovos de Ravassauro Pelenoso para Mor\'vek, na parte sudeste dos Pantânos da Cratera Un\'Goro.‡Принесите Мор\'веку 4 яйца ядошкурого равазавра. Он будет ждать вас на юго-востоке Топей.‡Bringt Mor\'vek im südöstlichen Teil der Marschen 4 Eier von Gifthautravasauriern.‡늪지대 남동부에 있는 모르벡에게 맹독가죽 라바사우르스 알 4개를 가져가야 합니다.‡Lleva 4 huevos de ravasaurio pellejo venenoso a Mor\'vek a la zona sudeste de Los Pantanales.‡Lleva 4 huevos de ravasaurio Pellejo Venenoso a Mor\'vek a la zona sudeste de Los Pantanales.‡Apportez 4 Œufs de ravasaure peau-de-venin à Mor\'vek au sud de La Fondrière.‡把4枚毒皮暴掠龙蛋带给位于沼泽地东南的莫维克。‡帶4個毒皮暴掠龍蛋給沼澤地東南邊的莫維克。',
  }
},
[13889] = {
  {
    '‡Бедный, голодный равазаврик‡Sooooo hungrig‡고프고 또 고파요‡Una prole muy, muy hambrienta‡Una prole muy, muy hambrienta‡Il a faim… très faim!‡饥饿的小龙‡嗷嗷待哺',
    nil,
    '‡Ваш равазаврик хочет съесть 15 кусков свежего мяса динозавра.‡Euer Gifthautjunges möchte, das Ihr 15 frische Dinosaurierfleischstücke an ihn verfüttert.‡새끼 맹독가죽에게 신선한 공룡 고기 15개를 먹여야 합니다.‡Tu prole de Pellejo Venenoso quiere que le des de comer 15 trozos de carne de dinosaurio fresca.‡Tu prole de Pellejo Venenoso quiere que le des de comer 15 trozos de carne de dinosaurio fresca.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 15 morceaux de Viande de dinosaure fraîche.‡‡',
  }
},
[13903] = {
  {
    'Verme Gorishi‡Обед из улья Гориши‡Gorishigelee‡고리쉬 맘마‡Larva Gorishi‡Larva Gorishi‡Des larves gorishi‡格里什幼虫‡格里什幼蟲',
    nil,
    'O seu Filhote de Pelenoso quer devorar 10 pedaços de Carne de Silitídeo.‡Ваш равазаврик проголодался. Принесите ему 10 кусков мяса силитида.‡Euer Gifthautjunges möchte, das Ihr 10 Stück Silithidenfleisch an ihn verfüttert.‡새끼 맹독가죽에게 실리시드 고기 10개를 먹여야 합니다.‡Tu prole de pellejo venenoso quiere que le des de comer 10 carnes de silítido.‡Tu prole de Pellejo Venenoso quiere que le des de comer 10 carnes de silítido.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 10 morceaux de Viande de silithide.‡你的毒皮暴掠龙幼崽想要你喂它10块异种蝎肉。‡你的毒皮小暴掠龍要你餵牠10片異種蟲肉。',
  }
},
[13904] = {
  {
    '‡Всмятку, в мешочек или сырые?‡Pochiert, gerührt oder roh?‡완숙으로? 반숙으로? 아니면 날로?‡¿Pochados, revueltos o crudos?‡¿Pochados, revueltos o crudos?‡Pochés, brouillés ou crus?‡水煮、爆炒还是生吃？‡煮熟？熱炒？還是生吃？',
    nil,
    '‡Ваш равазаврик хочет, чтобы вы принесли ему 12 яиц силитида.‡Euer Gifthautjunges möchte, das Ihr 12 Silithideneier an ihn verfüttert.‡새끼 맹독가죽에게 실리시드 알 12개를 먹여야 합니다.‡Tu prole de Pellejo Venenoso quiere que le des 12 huevos de silítido para comer.‡Tu prole de Pellejo Venenoso quiere que le des 12 huevos de silítido para comer.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 12 Œufs de silithide.‡你的毒皮暴掠龙幼崽想要你喂它12枚异种蝎卵。‡',
  }
},
[13905] = {
  {
    'Penas de Rocas Flamejantes‡Перья опаляющего руха‡Sengende Rocfedern‡불타는 로크 깃털‡Plumas de roc abrasador‡Plumas de roc abrasador‡Des plumes de roc incendiaire‡炎鹏的羽毛‡炎鵬羽毛',
    nil,
    'O Filhote de Pelenoso quer que você colete 5 Plumagens de Roca Flamejante.‡Ваш равазаврик хочет, чтобы вы принесли ему 5 перьев опаляющего руха.‡Euer Gifthautjunges möchte, das Ihr ihm 5 Federn von sengenden Rocs bringt.‡새끼 맹독가죽에게 불타는 로크 깃털 5개를 가져다주어야 합니다.‡Tu prole de pellejo venenoso quiere 5 trozos de plumaje de roc abrasador.‡Tu prole de Pellejo Venenoso quiere 5 trozos de plumaje de roc abrasador.‡Votre Jeune peau-de-venin veut que vous rapportiez 5 pièces de Plumage de roc incendiaire.‡你的毒皮暴掠龙幼崽想要你给它弄来5根炎鹏的羽毛。‡你的毒皮小暴掠龍要你帶給牠5片炎鵬全羽。',
  }
},
[13906] = {
  {
    'Ninguém segura esse bebê‡Они так быстро растут‡Sie werden so schnell erwachsen‡너무 빨리 커‡Crecen tan deprisa‡Crecen tan deprisa‡Ils grandissent tellement vite‡飞速成长‡一暝大一吋',
    nil,
    'Entregue 20 Dentes de Bebês Pelenosos, o Filhote de Pelenoso, 20 peças de Runatrama, 20 peças de Couro Rústico e 80 peças de ouro para Mor\'vek na parte sudeste dos Pântanos da Cratera Un\'Goro.‡Вернитесь к Мор\'веку на юго-восток Топей в Кратер Ун\'Горо со своим равазавриком, а также принесите 20 молочных зубов равазавра, 20 отрезов рунической ткани, 20 кусков грубой кожи и 80 золотых монет.‡Bringt 20 Gifthautzähnchen, das Gifthautjunge, 20 Stück Runenstoff, 20 unverwüstliches Leder und 80 Gold zu Mor\'vek im südöstlichen Teil des Marschlands im Krater von Un\'Goro.‡맹독가죽 젖니 20개, 새끼 맹독가죽, 룬무늬 옷감 20개, 튼튼한 가죽 20개, 80골드를 가지고 운고로 분화구의 늪지대 남동부에 있는 모르벡에게 돌아가야 합니다.‡Devuelve 20 dientes de leche de pellejo venenoso, la prole de pellejo venenoso, 20 paños rúnicos, 20 trozos de cuero basto y 80 monedas de oro a Mor\'vek, en la zona sudeste de Los Pantanales en el Cráter de Un\'Goro.‡Devuelve 20 dientes de leche de pellejo venenoso, la cría de pellejo venenoso, 20 paños rúnicos, 20 trozos de cuero basto y 80 monedas de oro a Mor\'vek, en la zona sudeste de Los Pantanales en el Cráter de Un\'Goro.‡Rapportez 20 Dents de lait de peau-de-venin, le Jeune peau-de-venin, 20 Étoffes runiques, 20 Cuirs robustes et 80 pièces d\'or à Mor\'vek au sud-est de La Fondrière, dans le Cratère d\'Un\'Goro.‡将20枚毒皮暴掠幼龙牙齿、你的毒皮暴掠龙幼崽，还有20块符文布、20块硬甲皮和80金币交给位于安戈洛环形山沼泽地东南的莫维克。‡帶著20顆毒皮乳牙、毒皮小暴掠龍、20塊符文布、20張硬甲皮以及80玫金幣去找安戈洛環形山沼澤地東南邊的莫維克。',
  }
},
[13908] = {
  {
    '‡Приготовьтесь к поездке‡Aufsatteln‡‡Equiparse para montar‡Equiparse para montar‡Un harnachement spécial‡好龙配好鞍‡好龍配好鞍',
    nil,
    '‡Принесите 20 кусков грубой кожи, 20 отрезов рунической ткани и 80 золотых монет Мор\'веку. Он ждет вас на юго-востоке Топей в Кратере Ун\'Горо‡Bringt Mor\'vek im südöstlichen Teil der Marschen im Krater von Un\'Goro 20 unverwüstliche Leder, 20 Runenstoff und 80 Gold.‡‡Lleva 20 cueros bastos, 20 paños rúnicos y 80 oros a Mor\'vek en la parte sureste de los Pantanales en el Cráter de Un\'Goro.‡Lleva 20 cueros bastos, 20 paños rúnicos y 80 oros a Mor\'vek en la parte sureste de los Pantanales en el Cráter de Un\'Goro.‡Rapportez 20 Cuirs robustes, 20 Étoffes runiques et 80 pièces d\'or à Mor\'vek dans la partie sud-est de la Fondrière dans le Cratère d\'Un\'Goro.‡‡',
  }
},
[13914] = {
  {
    'Penas de Rocas Flamejantes‡Перья опаляющего руха‡Sengende Rocfedern‡불타는 로크 깃털‡Plumas de roc abrasador‡Plumas de roc abrasador‡Des plumes de roc incendiaire‡炎鹏的羽毛‡炎鵬羽毛',
    nil,
    'O Filhote de Pelenoso quer que você colete 5 Plumagens de Roca Flamejante.‡Ваш равазаврик хочет, чтобы вы принесли ему 5 перьев опаляющего руха.‡Euer Gifthautjunges möchte, das Ihr ihm 5 Federn von sengenden Rocs bringt.‡새끼 맹독가죽에게 불타는 로크 깃털 5개를 가져다주어야 합니다.‡Tu prole de pellejo venenoso quiere 5 trozos de plumaje de roc abrasador.‡Tu prole de Pellejo Venenoso quiere 5 trozos de plumaje de roc abrasador.‡Votre Jeune peau-de-venin veut que vous rapportiez 5 pièces de Plumage de roc incendiaire.‡你的毒皮暴掠龙幼崽想要你给它弄来5根炎鹏的羽毛。‡你的毒皮小暴掠龍要你帶給牠5片炎鵬全羽。',
  }
},
[13915] = {
  {
    'Hora do lanche‡Бедный, голодный равазаврик‡Sooooo hungrig‡고프고 또 고파요‡Una prole muy, muy hambrienta‡Una prole muy, muy hambrienta‡Il a faim… très faim !‡饥饿的小龙‡嗷嗷待哺',
    nil,
    'O Filhote de Pelenoso quer devorar 15 pedaços de Carne Fresca de Dinossauro.‡Ваш равазаврик хочет съесть 15 кусков свежего мяса динозавра.‡Euer Gifthautjunges möchte, das Ihr 15 frische Dinosaurierfleischstücke an ihn verfüttert.‡새끼 맹독가죽에게 신선한 공룡 고기 15개를 먹여야 합니다.‡Tu prole de pellejo venenoso quiere que le des de comer 15 trozos de carne de dinosaurio fresca.‡Tu prole de Pellejo Venenoso quiere que le des de comer 15 trozos de carne de dinosaurio fresca.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 15 morceaux de Viande de dinosaure fraîche.‡你的毒皮暴掠龙幼崽想要你喂它15片鲜嫩的恐龙肉。‡你的毒皮小暴掠龍要你餵牠15片新鮮的恐龍肉。',
  }
},
[13916] = {
  {
    'Cozido, mexido ou cru mesmo?‡Всмятку, в мешочек или сырые?‡Pochiert, gerührt oder roh?‡완숙으로? 반숙으로? 아니면 날로?‡¿Pochados, revueltos o crudos?‡¿Pochados, revueltos o crudos?‡Pochés, brouillés ou crus ?‡水煮、爆炒还是生吃？‡煮熟?熱炒?還是生吃?',
    nil,
    'O Filhote de Pelenoso quer devorar 12 Ovos de Silitídeo.‡Ваш равазаврик хочет, чтобы вы принесли ему 12 яиц силитида.‡Euer Gifthautjunges möchte, das Ihr 12 Silithideneier an ihn verfüttert.‡새끼 맹독가죽에게 실리시드 알 12개를 먹여야 합니다.‡Tu prole de pellejo venenoso quiere que le des 12 huevos de silítido para comer.‡Tu prole de Pellejo Venenoso quiere que le des 12 huevos de silítido para comer.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 12 Œufs de silithide.‡你的毒皮暴掠龙幼崽想要你喂它12枚异种蝎卵。‡你的毒皮小暴掠龍要你餵牠12個異種蟲蛋。',
  }
},
[13917] = {
  {
    'Verme Gorishi‡Обед из улья Гориши‡Gorishigelee‡고리쉬 맘마‡Larva Gorishi‡Larva Gorishi‡Des larves gorishi‡格里什幼虫‡格里什幼蟲',
    nil,
    'O seu Filhote de Pelenoso quer devorar 10 pedaços de Carne de Silitídeo.‡Ваш равазаврик проголодался. Принесите ему 10 кусков мяса силитида.‡Euer Gifthautjunges möchte, das Ihr 10 Stück Silithidenfleisch an ihn verfüttert.‡새끼 맹독가죽에게 실리시드 고기 10개를 먹여야 합니다.‡Tu prole de pellejo venenoso quiere que le des de comer 10 carnes de silítido.‡Tu prole de Pellejo Venenoso quiere que le des de comer 10 carnes de silítido.‡Votre Jeune peau-de-venin veut que vous le nourrissiez de 10 morceaux de Viande de silithide.‡你的毒皮暴掠龙幼崽想要你喂它10块异种蝎肉。‡你的毒皮小暴掠龍要你餵牠10片異種蟲肉。',
  }
},
[13926] = {
  {
    'Ruu dos Oráculos, o pequeno órfão‡Ру, оракул-сиротка‡Kleines Waisenkind Roo von den Orakeln‡점쟁이 조합 고아 루‡Pequeño huérfano Lito de los Oráculos‡Pequeño huérfano Lito de los Oráculos‡Thann, le petit orphelin oracle‡神谕者孤儿鲁鲁‡神諭小孤兒阿若',
    nil,
    'Fale com a Matriarca Aria. Em seguida, use o Apito de Órfão Guaxinante para chamar o órfão de quem você vai cuidar durante a Semana das Crianças.‡Поговорите с попечительницей сирот Арией; после этого воспользуйтесь детской свистулькой оракула, чтобы позвать сиротку, о котором вы будете заботиться во время Детской недели.‡Sprecht mit Waisenmatrone Aria und benutzt dann die Pfeife des Orakelwaisenkindes, um das Waisenkind zu rufen, für das Ihr während der Kinderwoche sorgen werdet.‡보육원 원장님 아리아와 이야기를 나누고, 점쟁이 고아 호루라기를 사용하여 어린이 주간 동안 돌볼 고아를 불러야 합니다.‡Habla con la supervisora de huérfanos Aria y, después, usa el silbato de huérfano Oráculo para llamar al huérfano del que te vas a encargar durante la Semana de los Niños.‡Habla con la supervisora de huérfanos Aria y, después, usa el silbato de huérfano Oráculo para llamar al huérfano del que te vas a encargar durante la Semana de los Niños.‡Parlez à la Directrice de l\'orphelinat Aria, puis utilisez le Sifflet d\'orphelin oracle pour appeler l\'enfant que vous protégerez durant la Semaine des enfants.‡同孤儿监护员艾蕊娅交谈，然后使用神谕者孤儿哨召唤你要在儿童周照顾的孤儿。‡和孤兒監護員阿瑞雅談談，然後使用神諭者孤兒哨來呼喚你在兒童週所領養的孤兒。',
  }
},
[13927] = {
  {
    'Kekeké Guaxinante, o pequeno órfão‡Кекек, волчер-сиротка‡Kleines Waisenkind Kekek von den Wolvar‡광란의심장일족 고아 케켁‡Pequeño huérfano Kekek de los wolvar‡Pequeño huérfano Kekek de los wolvar‡Kekek, le petit orphelin varleu‡狼獾人孤儿科科‡獾狼小孤兒恰嘎',
    nil,
    'Fale com a Matriarca Aria. Em seguida, use o Apito de Órfão Guaxinante para chamar o órfão de quem você vai cuidar durante a Semana das Crianças.‡Поговорите с попечительницей сирот Арией, после этого воспользуйтесь детской свистулькой волчера, чтобы позвать сиротку, о котором вы будете заботиться во время Детской недели.‡Sprecht mit Waisenmatrone Aria und benutzt dann die Pfeife des Wolvarwaisenkindes, um das Waisenkind zu rufen, für das Ihr während der Kinderwoche sorgen werdet.‡보육원 원장님 아리아와 이야기를 나누고, 울바르 고아 호루라기를 사용하여 어린이 주간 동안 돌볼 고아를 불러야 합니다.‡Habla con la supervisora de huérfanos Aria y, después, usa el silbato de huérfano wolvar para llamar al huérfano del que te vas a encargar durante la Semana de los Niños.‡Habla con la supervisora de huérfanos Aria y, después, usa el silbato de huérfano wolvar para llamar al huérfano del que te vas a encargar durante la Semana de los Niños.‡Parlez à la Directrice de l\'orphelinat Aria, puis utilisez le Sifflet d\'orphelin varleu pour appeler l\'enfant que vous protégerez durant la Semaine des enfants.‡同孤儿监护员艾蕊娅交谈，然后使用狼獾人孤儿哨召唤你要在儿童周照顾的孤儿。‡和孤兒監護員阿瑞雅談談，然後使用獾狼怪孤兒哨來呼喚你在兒童週所領養的孤兒。',
  }
},
[13929] = {
  {
    '‡Самое большое дерево!‡Der grööößte Baum überhaupt!‡세상에서 제일 큰 나무!‡¡El árbol más grande de todos!‡¡El árbol más grande de todos!‡Le plus grand arbre du monde!‡史上最巨大的树！‡',
    nil,
    '‡Отведите вашего подопечного Ру к Седой Пасти. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Besucht mit Eurem Waisenkind Roo den Grauschlund. Falls er nicht anwesend ist, wenn Ihr den großen Baum betretet, solltet Ihr nach ihm rufen.‡고아 루를 데리고 회색구렁 요새를 방문해야 합니다. 이 요새의 거대한 나무 줄기에 들어갈 때 루가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Lito, a visitar Fauceparda. Asegúrate de llamarlo si no está presente cuando entres en el tronco del gran árbol.‡Lleva a tu huérfano, Lito, a visitar Fauceparda. Asegúrate de llamarlo si no está presente cuando entres en el tronco del gran árbol.‡Emmenez votre orphelin, Thann, visiter Grisegueule. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous entrez dans le tronc du grand arbre.‡带着你的孤儿鲁鲁前往灰喉堡。当你进入到那棵大树的树干里时，如果他不在你身边，一定要召唤他过来。‡',
  }
},
[13930] = {
  {
    '‡Дом людей-медведей‡Heimat der Bärenleute‡곰 인간의 고향‡El hogar de los hombres-oso‡El hogar de los hombres-oso‡La demeure des hommes-ours‡熊怪的家园‡',
    nil,
    '‡Отведите вашего подопечного Кекека к Седой Пасти. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Besucht mit Eurem Waisenkind Kekek den Grauschlund. Falls er nicht anwesend ist, wenn Ihr den großen Baum betretet, solltet Ihr nach ihm rufen.‡고아 케켁을 데리고 회색구렁 요새를 방문해야 합니다. 이 요새의 거대한 나무 줄기에 들어갈 때 케켁이 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Kekek, de visita a Fauceparda. Asegúrate de llamarlo si no está presente cuando entres en el tronco del gran árbol.‡Lleva a tu huérfano, Kekek, de visita a Fauceparda. Asegúrate de llamarlo si no está presente cuando entres en el tronco del gran árbol.‡Emmenez votre orphelin, Kekek, visiter Grisegueule. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous entrez dans le tronc du grand arbre.‡带着你的孤儿科科前往灰喉堡。当你进入那棵巨树的树干时，如果他不在你身边，一定要召唤他过来。‡',
  }
},
[13931] = {
  {
    '‡Новый подарок к новому году‡Ein neues Jahr, ein neues Souvernir‡새해에는 새 기념품!‡Otro año, otro recuerdo‡Otro año, otro recuerdo‡Une nouvelle année, un nouveau souvenir‡又一年，又一次纪念‡又過了一年，又一個紀念品。',
    nil,
    '‡Отоварьте свой купон на праздничную кружку у Бликса Чиништукса в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Blix Fixtand im hinteren Teil des Braufestlagers ein.‡가을 축제 광장 뒤쪽에 있는 블릭스 픽스위젯에게 가을 축제 잔 상품권을 가져가서 축제 잔으로 교환해야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la Cerveza.‡Échangez le Bon pour un bock de la fête des Brasseurs à Blix Réparouage à l\'arrière du campement de la fête des Brasseurs.‡‡',
  }
},
[13932] = {
  {
    '‡Новый подарок к новому году‡Ein neues Jahr, ein neues Souvernir‡새해에는 새 기념품!‡Otro año, otro recuerdo‡Otro año, otro recuerdo‡Une nouvelle année, un nouveau souvenir‡又是一年美酒飘香时。‡又是一年美酒飄香時。',
    nil,
    '‡Отоварьте свой купон на праздничную кружку у Бликса Чиништукса в лагере Хмельного фестиваля.‡Löst Euren Gutschein für einen Braufestkrug bei Belbi Blitzknips im Braufestlager ein.‡가을 축제 광장 뒤쪽에 있는 벨비 퀵스위치에게 가을 축제 잔 상품권을 가져가서 축제 잔으로 교환해야 합니다.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Entrega el vale de jarra de la Fiesta de la Cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la Cerveza.‡Échangez le bon-cadeau à Belbi Coupecircuit dans le campement de la fête des Brasseurs.‡去美酒节营地的贝尔比那里兑换美酒节礼品券。‡',
  }
},
[13933] = {
  {
    '‡Святилище бронзовых драконов‡Der Bronzedrachenschrein‡청동 용제단‡El Santuario de Dragones Bronce‡El Santuario de Dragones Bronce‡Le sanctuaire draconique bronze‡青铜巨龙圣地‡',
    nil,
    '‡Отведите вашего подопечного Ру к Бронзовому святилищу драконов. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Besucht mit Eurem Waisenkind Roo den Bronzedrachenschrein. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 루를 데리고 청동 용제단을 방문해야 합니다. 도착했을 때 루가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Lito, a visitar el Santuario de Dragones Bronce. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Lito, a visitar el Santuario de Dragones Bronce. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Thann, visiter le Sanctuaire draconique bronze. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带上你的孤儿鲁鲁前往青铜巨龙圣地。如果当你到达那里的时候，他不在你身边，一定要召唤他过来。‡',
  }
},
[13934] = {
  {
    '‡Святилище бронзовых драконов‡Der Bronzedrachenschrein‡청동 용제단‡El Santuario de Dragones Bronce‡El Santuario de Dragones Bronce‡Le sanctuaire draconique bronze‡青铜巨龙圣地‡',
    nil,
    '‡Отведите вашего подопечного Кекека к Бронзовому святилищу драконов. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Besucht mit Eurem Waisenkind Kekek den Bronzedrachenschrein. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 케켁을 데리고 청동 용제단을 방문해야 합니다. 도착했을 때 케켁이 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Kekek, a visitar el Santuario de Dragones Bronce. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Kekek, a visitar el Santuario de Dragones Bronce. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Kekek, visiter le Sanctuaire draconique bronze. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带上你的孤儿科科前往青铜巨龙圣地。如果当你到达那里的时候，他不在你身边，一定要召唤他过来。‡',
  }
},
[13937] = {
  {
    '‡Поездка в Чудо чудное.‡Ein Besuch bei den Wunderwerken‡‡Un viaje a Obras Asombrosas‡Un viaje a Obras Asombrosas‡Une balade à la Miraclerie‡转至奇妙玩具店的旅行‡',
    nil,
    '‡Купите бумажный дирижаблик в магазине "Чудо чудное" и бросьте его вашему подопечному Ру.‡Kauft einen kleinen Papierzeppelin bei den Wunderwerken und werft ihn Eurem Waisenkind, Roo, zu.‡‡Compra un zepelín de papel pequeño en Obras Asombrosas y tíraselo a tu huérfano, Lito.‡Compra un zepelín de papel pequeño en Obras Asombrosas y tíraselo a tu huérfano, Lito.‡Achetez un Petit zeppelin en papier à la Miraclerie et lancez-le à votre orphelin, Thann.‡在奇妙玩具店购买一只小型纸飞艇，然后把它掷给你的孤儿鲁鲁。‡',
  }
},
[13938] = {
  {
    '‡Заглянем в Чудо чудное.‡Ein Besuch bei den Wunderwerken‡신기한 장난감 상점 방문‡Una visita a Obras Asombrosas‡Una visita a Obras Asombrosas‡Une visite de la Miraclerie‡转至奇妙玩具店的旅行‡',
    nil,
    '‡Купите бумажный дирижаблик в магазине "Чудо чудное" и отдайте его вашему подопечному Кекеку.‡Kauft einen kleinen Papierzeppelin bei den Wunderwerken und werft ihn Eurem Waisenkind, Kekek, zu.‡‡Compra un zepelín de papel pequeño en Obras Asombrosas y después tíraselo a tu huérfano, Kekek.‡Compra un zepelín de papel pequeño en Obras Asombrosas y después tíraselo a tu huérfano, Kekek.‡Achetez un Petit zeppelin en papier à La Miraclerie et lancez-le à votre orphelin, Kekek.‡‡',
  }
},
[13950] = {
  {
    '‡Друзья детства!‡Spielgefährten!‡친구야, 놀자!‡¡Compañeros de juegos!‡¡Compañeros de juegos!‡Des camarades de jeu!‡伙伴！‡',
    nil,
    '‡Отведите вашего подопечного Ру к Приюту Зимних Плавников. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Roo, und besucht die Zuflucht der Winterflossen. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 루를 데리고 겨울지느러미 은신처를 방문해야 합니다. 도착했을 때 루가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Lito, a visitar el Refugio Aleta Invernal. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Lito, a visitar el Refugio Aleta Invernal. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Thann, visiter la Retraite des Ailerons-d\'hiver. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带领你的孤儿鲁鲁前去拜访冬鳞避难所。当你到达那里的时候，如果他不在你身边，一定要召唤他过来。‡',
  }
},
[13951] = {
  {
    '‡Друзья детства!‡Spielgefährten!‡친구야, 놀자!‡¡Compañeros de juegos!‡¡Compañeros de juegos!‡Des camarades de jeu!‡伙伴！‡',
    nil,
    '‡Отведите вашего подопечного Кекека на Поляну Снегопада. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Kekek, und besucht die Schneewehenlichtung. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 케켁을 데리고 눈사태 숲을 방문해야 합니다. 도착했을 때 케켁이 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Kekek, a visitar Claro Avalancha. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Kekek, a visitar Claro Avalancha. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Kekek, visiter la Clairière de Tombeneige. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带着你的孤儿科科前往飘雪林地。当你到达那里的时候，如果他不在你身边，一定要召唤他过来。‡',
  }
},
[13952] = {
  {
    'Mortos de fome‡Благодарный покойник‡Die dankbaren Toten‡고마워하는 영혼‡Los muertos agradecidos‡Los muertos agradecidos‡Les morts reconnaissants‡死者的感激‡感激的亡者',
    nil,
    'Arranje um Pão dos Mortos e entregue-o para o Espírito Humano Alegre no cemitério de Ventobravo.|n|nUse um Cravo-de-defunto Laranja para enxergar o espírito.‡Принесите поминальный хлеб веселому духу человека на кладбище Штормграда.|n|nЧтобы увидеть дух, используйте оранжевые бархатцы.‡Besorgt Euch ein wenig Totenspeise und gebt sie dem heiteren Menschengeist auf dem Friedhof von Sturmwind.|n|nBenutzt eine orangefarbene Ringelblume, um den ansonsten unsichtbaren Geist zu sehen.‡망자의 빵을 구해서 스톰윈드의 무덤에 있는 명랑한 인간 영혼에게 가져가야 합니다.|n|n보이지 않는 영혼을 보려면 주황색 금잔화를 사용하십시오.‡Consigue pan de muerto y dáselo al espíritu de humana alegre en el cementerio de Ventormenta.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Consigue pan de muerto y dáselo al espíritu de humana alegre en el cementerio de Ventormenta.|n|nUsa una flor de muerto naranja para ver al espíritu que sin ella sería invisible.‡Récupérez un peu de Pain des morts et donnez-le à l\'Esprit d\'humain joyeux dans le cimetière de Hurlevent.|n|nUtilisez un Chrysanthème orange pour voir l’esprit, qui sinon restera invisible.‡弄到悼念糕饼，并把它交给暴风城墓地的欢快的人类灵魂。|n|n你必须使用一朵橙菊，才能看到那个隐形的灵魂。‡拿一些亡者麵包給暴風城墓地中興奮的人類靈魂。|n|n使用橘色金盞花可以看見這些隱形的靈魂。',
  }
},
[13954] = {
  {
    '‡Королева драконов‡Die Drachenkönigin‡용의 여왕‡La reina de los dragones‡La reina de los dragones‡La reine dragon‡红龙女王‡',
    nil,
    '‡Отведите вашего подопечного Ру познакомиться с Алекстразой Связующей Жизнь, которая обитает на вершине храма Драконьего Покоя. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Roo, und besucht Alexstrasza die Lebensbinderin auf der Spitze des Wyrmruhtempels. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 루를 데리고 고룡쉼터 사원 꼭대기에 있는 생명의 어머니 알렉스트라자를 방문해야 합니다. 도착했을 때 루가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Lito, a visitar a Alexstrasza la Protectora en lo alto del Templo del Reposo del Dragón. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Lito, a visitar a Alexstrasza la Protectora en lo alto del Templo del Reposo del Dragón. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Thann, rendre visite à Alexstrasza la Lieuse-de-vie, au sommet du Temple du Repos du ver. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带上你的孤儿鲁鲁去拜访阿莱克丝塔萨，生命的缚誓者，她就在龙眠神殿的顶端。如果当你到达那里的时候，他不在你身边，一定要召唤他过来。‡',
  }
},
[13955] = {
  {
    '‡Королева драконов‡Die Drachenkönigin‡용의 여왕‡La reina de los dragones‡La reina de los dragones‡La reine dragon‡红龙女王‡',
    nil,
    '‡Отведите вашего подопечного Кекека познакомиться с Алекстразой Хранительницей Жизни, на вершину храма Драконьего Покоя. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Kekek, und besucht Alexstrasza die Lebensbinderin auf der Spitze des Wyrmruhtempels. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡‡Lleva a tu huérfano, Kekek, a visitar a Alexstrasza la Protectora en lo alto del Templo del Reposo del Dragón. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Kekek, a visitar a Alexstrasza la Protectora en lo alto del Templo del Reposo del Dragón. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Kekek, rendre visite à Alexstrasza la Lieuse-de-vie, au sommet du Temple du Repos du ver. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡‡',
  }
},
[13956] = {
  {
    '‡Встреча с Великим‡Einen Großen treffen‡위대한 자와의 만남‡Conocer a un Magno‡Conocer a un Magno‡La rencontre avec un Tout-puissant‡拜访一位造物主‡',
    nil,
    '‡Отведите вашего подопечного Ру к Этимидиану на Террасу Создателя. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Roo, und besucht den Etymidian auf der Terrasse des Formers. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 루를 데리고 구체자의 정원에 있는 에티미디안을 방문해야 합니다. 도착했을 때 루가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Lito, a visitar a El Etimidiano en el Bancal del Creador. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Lito, a visitar a El Etimidiano en el Bancal del Creador. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Thann, visiter l\'Etymidian à la terrasse du Façonneur. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带着你的孤儿鲁鲁前往塑造者之台的源生石像那里。当你到达那里的时候，如果他不在你身边，一定要召唤他过来。‡',
  }
},
[13957] = {
  {
    '‡Великий Хеминг Эрнестуэй‡Der mächtige Hemet Nesingwary‡나의 영웅 헤멧 네싱워리‡El poderoso Hemet Nesingwary‡El poderoso Hemet Nesingwary‡Le puissant Hemet Nesingwary‡强大的赫米特·奈辛瓦里‡',
    nil,
    '‡Отведите вашего подопечного Кекека познакомиться с Хемингом Эрнестуэем в Лагерь Эрнестуэя. Не забудьте позвать сиротку, если его не окажется рядом, когда вы прибудете на место.‡Nehmt Euer Waisenkind, Kekek, und besucht Hemet Nesingwary in Nesingwarys Basislager. Falls er nicht anwesend ist, wenn Ihr eintrefft, solltet Ihr nach ihm rufen.‡고아 케켁을 데리고 네싱워리 주둔지에 있는 헤멧 네싱워리를 방문해야 합니다. 도착했을 때 케켁이 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfano, Kekek, a visitar el Campamento Base de Nesingwary. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Lleva a tu huérfano, Kekek, a visitar el Campamento Base de Nesingwary. Asegúrate de llamarlo si no está presente cuando llegues allí.‡Emmenez votre orphelin, Kekek, rendre visite à Hemet Nesingwary, au Camp de base de Nesingwary. N\'oubliez pas de l\'appeler s\'il n\'est pas présent lorsque vous arrivez là-bas.‡带着你的孤儿科科去拜访赫米特·奈辛瓦里。他就在奈辛瓦里营地。如果当你到达那里的时候，他不在你身边，一定要召唤他过来。‡',
  }
},
[13959] = {
  {
    '‡Возвращение в приют‡Zurück zum Waisenhaus‡보육원으로 돌아가는 길‡De vuelta al orfanato‡De vuelta al orfanato‡De retour à l\'orphelinat‡返回孤儿院‡返回孤兒院',
    nil,
    '‡Отведите вашего подопечного обратно в приют Даларана, отдав детскую свистульку оракула попечительнице сирот Арии.‡Bringt Euren Schutzbefohlenen zurück zum Waisenhaus in Dalaran, indem Ihr der Waisenmatrone Aria in Dalaran die Pfeife des Orakelwaisenkindes überreicht.‡‡Regresa con tu pupilo al orfanato de Dalaran y entrega el silbato de huérfano Oráculo a la supervisora de huérfanos Aria en Dalaran.‡Regresa con tu pupilo al orfanato de Dalaran y entrega el silbato de huérfano Oráculo a la supervisora de huérfanos Aria en Dalaran.‡Ramenez votre protégé à l\'orphelinat de Dalaran, en rendant le Sifflet d\'orphelin oracle à la Directrice de l\'orphelinat Aria à Dalaran.‡‡',
  }
},
[13960] = {
  {
    '‡Возвращение в приют‡Zurück zum Waisenhaus‡보육원으로 돌아가는 길‡De vuelta al orfanato‡De vuelta al orfanato‡De retour à l\'orphelinat‡返回孤儿院‡返回孤兒院',
    nil,
    '‡Отведите вашего подопечного обратно в приют Даларана, отдав детскую свистульку волчера попечительнице сирот Арии.‡Bringt Euren Schutzbefohlenen zurück zum Waisenhaus in Dalaran, indem Ihr der Waisenmatrone Aria in Dalaran die Pfeife des Wolvarwaisenkindes überreicht.‡‡Regresa con tu pupilo al orfanato de Dalaran y entrega el silbato de huérfano wolvar a la supervisora de huérfanos Aria en Dalaran.‡Regresa con tu pupilo al orfanato de Dalaran y entrega el silbato de huérfano wolvar a la supervisora de huérfanos Aria en Dalaran.‡Ramenez votre protégé à l\'orphelinat de Dalaran, en rendant le Sifflet d\'orphelin varleu à la Directrice de l\'orphelinat Aria à Dalaran.‡‡',
  }
},
[13966] = {
  {
    'Um presente de Véu de Inverno‡Подарок Зимнего Покрова‡Ein Winterhauchgeschenk‡겨울맞이 선물‡Un obsequio del Festival de Invierno‡Un obsequio del Festival de Invierno‡Un cadeau pour le Voile d\'hiver‡冬幕节礼物‡一個冬幕節禮物',
    nil,
    nil,
  }
},
[13986] = {
  {
    'Uma colega ferida‡Раненый товарищ‡Ein verletzter Kollege‡부상당한 동료‡Un colega herido‡Un colega herido‡Une collègue blessée‡受伤的同伴‡一位受傷的同僚',
    nil,
    'Leve o Escudo Tribal Surrado para Aponi Crina Clara, no Platô dos Anciãos, que fica no Penhasco do Trovão.‡Отнесите побитый фамильный щит Апони Светлой Гриве на Вершину Старейшин Громового Утеса.‡Bringt Aponi Lichtmähne auf der Anhöhe der Ältesten in Donnerfels den ramponierten Stammesschild.‡썬더 블러프 안, 장로의 봉우리에 있는 아포니 브라이트메인에게 닳아해진 부족 방패를 가져가야 합니다.‡Lleva el escudo tribal maltrecho a Aponi Crin Brillante en el Alto de los Ancestros, en Cima del Trueno.‡Lleva el escudo tribal maltrecho a Aponi Crin Brillante en el Alto de los Ancestros, en Cima del Trueno.‡Apportez le Bouclier tribal endommagé à Aponi Crin-brillant sur la Cime des Anciens, aux Pitons du Tonnerre.‡将破旧的部族护盾交给奥伯妮·亮鬃。她就在雷霆崖里的长者高地。‡把這個破損的部族盾牌拿給雷霆崖長者高地的阿波尼·亮鬃。',
  }
},
[13990] = {
  {
    '‡Рекламный код Upper Deck – верховой цыпленок‡Upper Deck Promo - Hühnerreittier‡어퍼덱 프로모션‡Upper Deck Promo - Chicken Mount‡Upper Deck Promo - Chicken Mount‡Promo Upper Deck - Monture poulet‡魔法公鸡‡',
    nil,
    nil,
  }
},
[13997] = {
  {
    'Se você está lendo isso enquanto estou em combate...‡If You\'re Reading This While I\'m In Combat...‡If You\'re Reading This While I\'m In Combat...‡제가 전투 중인데 이 내용을 읽고 계시다면...‡Si estás leyendo esto mientras estoy en combate...‡Si estás leyendo esto mientras estoy en combate...‡Si vous lisez ceci pendant que je suis en train de combattre...‡如果在我战斗的时候，你读到了这个……‡如果你在我處於戰鬥中時讀到這個…',
    nil,
    'ELM Estontear Alvo quer que você mate 5 Atacantes ELM para o Dan e a Grande Justiça!‡ELM Daze Target wants you to kill 5 ELM Attackers for Dan and Great Justice!‡ELM Daze Target wants you to kill 5 ELM Attackers for Dan and Great Justice!‡댄과 위대한 정의를 위해, ELM 공격자 5마리를 해치워야 합니다!‡ELM Daze Target wants you to kill 5 ELM Attackers for Dan and Great Justice!‡ELM Daze Target wants you to kill 5 ELM Attackers for Dan and Great Justice!‡ELM Cible d\'hébétement veut que vous tuiez 5 ELM attaquants pour Dan et la Grande Justice !‡ELM Daze Target想要你为Dan和Great Justice消灭5个ELM Attacker‡ELM暈眩目標要求你為了丹及偉大的正義殺掉5個ELM攻擊者!',
  }
},
[14016] = {
  {
    '‡Проклятие Черного рыцаря‡Der Fluch des Schwarzen Ritters‡흑기사의 저주‡La maldición del Caballero Negro‡La maldición del Caballero Negro‡La malédiction du Chevalier noir‡黑骑士的诅咒‡黑騎士的詛咒',
    nil,
    '‡Рыцарь Райдалла из Серебряного павильона на Ристалище Серебряного Турнира просит вас осмотреть могилу Черного рыцаря.‡Kreuzfahrerin Rhydalla auf dem Argentumturnierplatz möchte, dass Ihr das Grab des Schwarzen Ritters untersucht.‡은빛십자군 마상시합 광장에 있는 성전사 라이달라가 흑기사의 무덤을 조사해 달라고 했습니다.‡La cruzada Rhydalla en los Campos del Torneo Argenta quiere que investigues la lápida del Caballero Negro.‡La cruzada Rhydalla en los Campos del Torneo Argenta quiere que investigues la lápida del Caballero Negro.‡La croisée Rhydalla, dans l\'Enceinte du tournoi d\'Argent, vous demande d\'enquêter sur la Tombe du Chevalier noir.‡‡',
  }
},
[14017] = {
  {
    '‡Судьба Черного рыцаря‡Das Schicksal des Schwarzen Ritters‡흑기사의 운명‡El destino del Caballero Negro‡El destino del Caballero Negro‡Le destin du Chevalier noir‡黑骑士的命运‡黑騎士的命運',
    nil,
    '‡Перехватите приказы доктора Колера на Заставе Вестника Смерти, а затем вернитесь к рыцарю Райдалле в Серебряный павильон на Ристалище Серебряного Турнира.‡Geht nach Todessprechers Wacht, bringt Doktor Kohlers Befehle in Euren Besitz und kehrt dann zu Kreuzfahrerin Rhydalla auf dem Argentumturnierplatz zurück.‡죽음예언자 감시초소에서 박사 콜러의 명령서를 획득하고 은빛십자군 마상시합 광장에 있는 성전사 라이달라에게 돌아와야 합니다.‡Captura las órdenes del doctor Kolher en la Avanzada del Portavoz de la Muerte, después vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Captura las órdenes del doctor Kolher en la Avanzada del Portavoz de la Muerte, después vuelve a ver a la cruzada Rhydalla en los Campos del Torneo Argenta.‡Emparez-vous des Ordres du docteur Kohler au Guet du nécrorateur, puis retournez voir la Croisée Rhydalla dans l\'Enceinte du Tournoi d\'argent.‡‡',
  }
},
[14022] = {
  {
    'Festa da Fartura‡Пиршество странников‡Pilgerfreuden‡순례자의 감사절‡La Generosidad del Peregrino‡La Generosidad del Peregrino‡Les Bienfaits du pèlerin‡感恩节‡旅人豐年祭',
    nil,
    'Fale com Gregório Tabor do lado de fora dos portões de Ventobravo.‡Поговорите с Грегори Табором – он стоит рядом с вратами Штормграда.‡Sprecht mit Gregory Tabor außerhalb der Tore Sturmwinds.‡스톰윈드 성문 바로 밖에 있는 그레고리 테이버와 대화해야 합니다.‡Habla con Gregory Tabor justo a las afueras de las puertas de Ventormenta.‡Habla con Gregory Tabor justo a las afueras de las puertas de Ventormenta.‡Parlez à Gregory Tabor, qui se tient devant les portes de Hurlevent.‡同暴风城大门外的格雷戈里·塔波交谈。‡與暴風城大門外邊的葛列格里·塔波談談。',
  }
},
[14023] = {
  {
    'Farofa-fa‡Пряная хлебная запеканка‡Gewürzbrotfüllung‡매콤한 빵 범벅‡Relleno de pan de especias‡Relleno de pan de especias‡La farce au pain épicé‡玉米馅料‡香料麵包餡料',
    nil,
    'Prepare 5 porções de Farofa de Pão de Especiarias e leve-as para Gaspar Morus na Festa da Fartura, em frente aos portões de Ventobravo.‡Приготовьте 5 порций пряной хлебной запеканки и отнесите ее Джасперу Муру, который стоит возле праздничных столов у ворот Штормграда.‡Bereitet 5 Portionen Gewürzbrotfüllung zu und bringt sie zu Jasper Moore an die Festtafel außerhalb der Tore Sturmwinds.‡매콤한 빵 범벅 5개를 만들고 스톰윈드 성문 밖의 잔치 지역에 있는 재스퍼 무어에게 가져가야 합니다.‡Cocina 5 raciones de relleno de pan de especias y llévaselas a Jasper Moore a la zona del festín a las afueras de las puertas de Ventormenta.‡Cocina 5 raciones de relleno de pan de especias y llévaselas a Jasper Moore a la zona del festín a las afueras de las puertas de Ventormenta.‡Préparez 5 portions de Farce au pain épicé puis apportez-les à Jasper Moore au festin qui se déroule à l\'extérieur des portes de Hurlevent.‡制作5份玉米馅料，把它们交给加斯帕·摩尔，他就在暴风城大门外的宴会区。‡製作5份香料麵包餡料，然後帶給暴風城大門外邊餐會區的賈斯伯·摩爾。',
  }
},
[14024] = {
  {
    '‡Тыквенный пирог‡Kürbiskuchen‡호박 파이‡Tarta de calabaza‡Tarta de calabaza‡La tarte à la citrouille‡南瓜馅饼‡南瓜派',
    nil,
    '‡Испеките 5 кусков тыквенного пирога и принесите их Эдварду Уинслоу, который стоит возле праздничных столов Стальгорна.‡Bereitet 5 Kürbiskuchen zu und bringt sie Edward Winslow an die Festtafel außerhalb von Eisenschmiede.‡호박 파이 5개를 만들고 아이언포지 성문 밖의 잔치 지역에 있는 에드워드 윈슬로에게 가져가야 합니다.‡Haz 5 pedazos de tarta de calabaza y llévaselos a Edward Winslow en la zona del festín a las afueras de Forjaz.‡Haz 5 pedazos de tarta de calabaza y llévaselos a Edward Winslow en la zona del festín a las afueras de Forjaz.‡Confectionnez 5 parts de Tarte à la citrouille et apportez-les à Edward Winslow, au festin qui se tient devant Forgefer.‡制作5份南瓜馅饼，将它们交给铁炉堡外宴会区的爱德华·文斯洛。‡',
  }
},
[14028] = {
  {
    '‡Клюквенный соус‡Moosbeerenchutney‡새콤달콤 덩굴월귤 소스‡Chatni de arándanos‡Chatni de arándanos‡La sauce aux canneberges‡酸果蔓酱‡蔓越莓甜酸醬',
    nil,
    '‡Приготовьте 5 порций клюквенного соуса и отнесите ее Джасперу Муру, который стоит возле праздничных столов у ворот Штормграда.‡Bereitet 5 Portionen Moosbeerenchutney zu und bringt sie zu Jasper Moore an die Festtafel außerhalb Sturmwinds.‡새콤달콤 덩굴월귤 소스 5개를 만들어 스톰윈드 성문 밖의 잔치 지역에 있는 재스퍼 무어에게 가져가야 합니다.‡Haz 5 raciones de chatni de arándanos y llévaselas a Jasper Moore en el área festiva en las afueras de Ventormenta.‡Haz 5 raciones de chatni de arándanos y llévaselas a Jasper Moore en el área festiva en las afueras de Ventormenta.‡Préparez 5 portions de Sauce aux canneberges et apportez-les à Jasper Moore, au festin qui se tient devant Hurlevent.‡制作5份酸果蔓酱，并把它们送到暴风城外宴会区的加斯帕·摩尔那里去。‡',
  }
},
[14030] = {
  {
    '‡Голодающие Дарнаса‡Darnassus darbt‡다르나서스에 있는 굶주린 그들‡En Darnassus están hambrientos‡En Darnassus están hambrientos‡Ils sont affamés à Darnassus‡达纳苏斯的人都饿极了‡達納蘇斯的貪吃鬼',
    nil,
    '‡Приготовьте 5 порций хлебной запеканки и отнесите ее Исааку Аллертону, который стоит у входа в Дарнас.‡Bringt 5 Portionen Gewürzbrotfüllung und 5 Kürbiskuchen zu Isaac Allerton in der Nähe des Eingangs nach Darnassus.‡양념빵 범벅 5개와 호박 파이 5개를 다르나서스 입구 근처에 있는 아이작 앨러튼에게 가져가야 합니다.‡Lleva 5 raciones de relleno de pan de especias y 5 tartas de calabaza a Isaac Allerton cerca de la entrada de Darnassus.‡Lleva 5 raciones de relleno de pan de especias y 5 tartas de calabaza a Isaac Allerton cerca de la entrada de Darnassus.‡Apportez 5 portions de Farce au pain épicé et 5 Tartes à la citrouille à Isaac Allerton près de l\'entrée de Darnassus.‡将5份玉米馅料和5份南瓜馅饼送给达纳苏斯入口处附近的艾萨克·奥勒登。‡',
  }
},
[14032] = {
  {
    'Limpeza no acampamento dos kobolds‡Нападение на лагерь кобольдов‡Säuberung im Koboldlager‡코볼트 소탕‡La limpieza del campamento kóbold‡La limpieza del campamento kóbold‡Le nettoyage du camp des kobolds‡清剿狗头人营地‡清理狗頭人營地',
    nil,
    'Mate 8 Kobolds Daninhos, depois fale novamente com o Major Belmonte.‡Уничтожьте 8 кобольдов-вредителей. Вернитесь к маршалу Макбрайду.‡Tötet 8 von dem Koboldgezücht und kehrt dann zu Marschall McBride zurück.‡코볼트 졸개 8마리를 처치한 다음 치안대장 맥브라이드에게 돌아가야 합니다.‡Mata a 8 alimañas kóbold y ve a hablar con el alguacil McBride.‡Mata a 8 alimañas kóbold y ve a hablar con el alguacil McBride.‡Tuez 8 Vermines kobolds, puis revenez voir le Maréchal McBride.‡消灭8个狗头人歹徒，然后回去见治安官玛克布莱德。‡殺掉8隻狗頭人惡黨，然後回去找治安官瑪克布萊德。',
  }
},
[14033] = {
  {
    '‡Засахаренный батат‡Kandierte Süßkartoffeln‡고구마 맛탕‡Batatas confitadas‡Batatas confitadas‡Les patates douces confites‡糖心甜土豆‡蜜煮甘薯',
    nil,
    '‡Приготовьте 5 порций засахаренного батата и отнесите их Грегори Табору, который стоит у ворот Штормграда.‡Bereitet 5 Portionen kandierte Süßkartoffeln zu und bringt sie zu Gregory Tabor außerhalb der Tore Sturmwinds.‡스톰윈드 성문 바로 밖에 있는 그레고리 테이버에게 고구마 맛탕 5개를 가져가야 합니다.‡Haz cinco raciones de batatas confitadas y llévaselas a Gregory Tabor, justo a la entrada de Ventormenta.‡Haz cinco raciones de batatas confitadas y llévaselas a Gregory Tabor, justo a la entrada de Ventormenta.‡Confectionnez 5 portions de Patates douces confites et apportez-les à Gregory Tabor, juste devant les portes de Hurlevent.‡‡',
  }
},
[14035] = {
  {
    '‡Запеченная индейка‡Langsam gerösteter Truthahn‡서서히 구운 칠면조‡Pavo a fuego lento‡Pavo a fuego lento‡La dinde rôtie‡慢烤火鸡‡慢烤火雞',
    nil,
    '‡Приготовьте 5 запеченных индеек и отнесите их Исааку Аллертону к вратам Дарнаса.‡Bereitet 5 langsam geröstete Truthähne zu und bringt sie zu Isaac Allerton, in der Nähe der Tore von Darnassus.‡‡Prepara 5 pavos a fuego lento y llévaselos a Isaac Allerton cerca de las puertas de Darnassus.‡Prepara 5 pavos a fuego lento y llévaselos a Isaac Allerton cerca de las puertas de Darnassus.‡Préparez 5 Dindes rôties et apportez-les à Isaac Allerton, près des portes de Darnassus.‡‡',
  }
},
[14036] = {
  {
    'Festa da Fartura‡Пиршество странников‡Pilgerfreuden‡순례자의 감사절‡La Generosidad del Peregrino‡La Generosidad del Peregrino‡Les Bienfaits du pèlerin‡感恩节‡旅人豐年祭',
    nil,
    'Fale com Aristide Funto na pátio acima da Cidade Baixa.‡Поговорите с Майлсом Стендишом во внутреннем дворе Подгорода.‡Sprecht mit Miles Standish im Innenhof über Unterstadt.‡언더시티 안마당에 있는 마일즈 스탠디쉬와 대화해야 합니다.‡Habla con Miles Standish en el patio sobre Entrañas.‡Habla con Miles Standish en el patio sobre Entrañas.‡Parlez à Miles Standish dans la cour au-dessus de Fossoyeuse.‡同幽暗城庭院里的米尔斯·斯坦迪什谈谈。‡和幽暗城上層中庭的邁爾斯·墨壺談談。',
  }
},
[14037] = {
  {
    'Farofa-fa‡Пряная хлебная запеканка‡Gewürzbrotfüllung‡매콤한 빵 범벅‡Relleno de pan de especias‡Relleno de pan de especias‡La farce au pain épicé‡玉米馅料‡香料麵包餡料',
    nil,
    'Prepare 5 porções de Farofa de Pão de Especiarias e leve-as para Guilhem Mirto na Festa da Fartura, que está montada no pátio sobre a Cidade Baixa.‡Приготовьте 5 порций пряной хлебной запеканки и отнесите ее Вилльяму Маллинсу, который стоит возле праздничных столов во внутреннем дворе Подгорода.‡Bereitet 5 Portionen der Gewürzbrotfüllung zu und bringt sie dann zu William Mullins an die Festtafel im Innenhof über Unterstadt.‡매콤한 빵 범벅 5개를 만들고 언더시티 위쪽 안마당에 벌어진 잔치 지역에 있는 윌리엄 멀린스에게 가져다주어야 합니다.‡Cocina 5 raciones de relleno de pan de especias y llévaselas a William Mullins a la zona del festín sobre el patio de Entrañas.‡Cocina 5 raciones de relleno de pan de especias y llévaselas a William Mullins a la zona del festín sobre el patio de Entrañas.‡Préparez 5 portions de Farce au pain épicé puis apportez-les à William Mullins au festin à l\'intérieur de la cour au-dessus de Fossoyeuse.‡制作5份玉米馅料，把它们交给威廉·穆林，他就在幽暗城上方庭院的宴会区里。‡製作5份香料麵包餡料，然後帶給幽暗城中庭餐會區的威廉·慕林。',
  }
},
[14040] = {
  {
    '‡Тыквенный пирог‡Kürbiskuchen‡호박 파이‡Tarta de calabaza‡Tarta de calabaza‡La tarte à la citrouille‡南瓜馅饼‡南瓜派',
    nil,
    '‡Испеките 5 кусков тыквенного пирога и принесите их Фрэнсису Итону, который стоит у праздничных столов возле Оргриммара.‡Bereitet 5 Stücke Kürbiskuchen zu und bringt sie zu Francis Eaton an die Festtafel außerhalb von Orgrimmar.‡호박 파이 5개를 만들고 오그리마 밖의 잔치 지역에 있는 프란시스 이튼에게 가져가야 합니다.‡Haz 5 pedazos de tarta de calabaza y llévaselos a Francis Eaton en la zona del festín a las afueras de Orgrimmar.‡Haz 5 pedazos de tarta de calabaza y llévaselos a Francis Eaton en la zona del festín a las afueras de Orgrimmar.‡Confectionnez 5 parts de Tarte à la citrouille et apportez-les à Francis Eaton, au festin qui se tient devant Orgrimmar.‡‡',
  }
},
[14041] = {
  {
    '‡Клюквенный соус‡Moosbeerenchutney‡새콤달콤 덩굴월귤 소스‡Chatni de arándanos‡Chatni de arándanos‡La sauce aux canneberges‡酸果蔓酱‡蔓越莓甜酸醬',
    nil,
    '‡Приготовьте пять порций клюквенного соуса и принесите их Докину Дальнему Лугу, который ждет у подъемника на западе Громового Утеса.‡Bereitet 5 Portionen Moosbeerenchutney zu und bringt sie zu Dokin Grasland am Fuße des Aufzugs westlich von Donnerfels.‡새콤달콤 덩굴월귤 소스 5개를 만들어 썬더 블러프의 서쪽 승강기 아래에 있는 도킨 파플레인에게 가져가야 합니다.‡Haz 5 raciones de chatni de arándanos y llévaselas a Dokin Llanura Lejana en la base del elevador del lado occidental de Cima del Trueno.‡Haz 5 raciones de chatni de arándanos y llévaselas a Dokin Llanura Lejana en la base del elevador del lado occidental de Cima del Trueno.‡Préparez 5 portions de Sauce aux canneberges et apportez-les à Dokin Plaine-lointaine, au pied de l\'ascenseur du côté ouest des Pitons-du-Tonnerre.‡制作5份酸果蔓酱，并把它们交给雷霆崖西侧升降梯底层的多金·辽原。‡',
  }
},
[14043] = {
  {
    '‡Засахаренный батат‡Kandierte Süßkartoffeln‡고구마 맛탕‡Batatas confitadas‡Batatas confitadas‡Les patates douces confites‡糖心甜土豆‡蜜煮甘薯',
    nil,
    '‡Приготовьте 5 порций засахаренного батата и принесите их Фрэнсису Итону, который стоит у праздничных столов возле Оргриммара.‡Bereitet 5 Portionen kandierte Süßkartoffeln zu und bringt sie zu Francis Eaton außerhalb der Tore Orgrimmars.‡오그리마 바로 밖에 있는 프란시스 이튼에게 고구마 맛탕 5개를 가져가야 합니다.‡Haz cinco raciones de batatas confitadas y llévaselas a Francis Eaton, justo a la entrada de Orgrimmar.‡Haz cinco raciones de batatas confitadas y llévaselas a Francis Eaton, justo a la entrada de Orgrimmar.‡Confectionnez 5 portions de Patates douces confites et apportez-les à Francis Eaton, juste devant Orgrimmar.‡‡',
  }
},
[14044] = {
  {
    '‡Нехватка продовольствия в Подгороде‡Unterstadt ist unterversorgt‡부족한 언더시티‡Cortos de suministros en Entrañas‡Cortos de suministros en Entrañas‡On creuse sa tombe avec ses dents‡幽暗城急需美食‡食物短缺的幽暗城',
    nil,
    '‡Приготовьте 5 порций пряной хлебной запеканки и 5 порций клюквенного соуса, и отнесите их Майлсу Стендишу к входу в Подгород.‡Bringt 5 Portionen Gewürzbrotfüllung und 5 Portionen Moosbeerenchutney zu Miles Standish in der Nähe des Eingangs von Unterstadt.‡양념빵 범벅 5개와 새콤달콤 덩굴월귤 소스 5개를 언더시티 입구 근처에 있는 마일스 스탠디쉬에게 가져가야 합니다.‡Lleva 5 raciones de relleno de pan de especias y 5 raciones de chatni de arándanos a Miles Standish cerca de la entrada de Entrañas.‡Lleva 5 raciones de relleno de pan de especias y 5 raciones de chatni de arándanos a Miles Standish cerca de la entrada de Entrañas.‡Apportez 5 portions de Farce au pain épicé et 5 portions de Sauce aux canneberges à Miles Standish, près de l\'entrée de Fossoyeuse.‡将5份玉米馅料和5份酸果蔓酱交给幽暗城入口附近的米尔斯·斯坦迪什。‡',
  }
},
[14047] = {
  {
    '‡Запеченная индейка‡Langsam gerösteter Truthahn‡서서히 구운 칠면조‡Pavo a fuego lento‡Pavo a fuego lento‡La dinde rôtie‡慢烤火鸡‡慢烤火雞',
    nil,
    '‡Приготовьте 5 запеченных индеек и принесите их Фрэнсису Итону к вратам Оргриммара.‡Bereitet 5 langsam geröstete Truthähne zu und bringt sie zu Francis Eaton, in der Nähe der Tore von Orgrimmar.‡‡Prepara 5 pavos a fuego lento y llévaselos a Francis Eaton cerca de las puertas de Orgrimmar.‡Prepara 5 pavos a fuego lento y llévaselos a Francis Eaton cerca de las puertas de Orgrimmar.‡Préparez 5 Dindes rôties et apportez-les à Francis Eaton, près des portes d\'Orgrimmar.‡‡',
  }
},
[14048] = {
  {
    'Peru a dar com pau‡Слишком мало индеек‡Ich krieg einfach nicht genug ... Truthahn‡부족한 칠면조‡No tenemos suficiente pavo...‡No tenemos suficiente pavo...‡Il n\'y aura jamais assez de dinde‡火鸡还是缺‡火雞不足',
    nil,
    'Leve 20 Perus Assados Lentamente para Natasha Leira, em frente a Altaforja.‡Принесите 20 запеченных индеек Кэтрин Железный Чан к вратам Стальгорна.‡Bringt 20 langsam geröstete Truthähne zu Caitrin Eisenkessel außerhalb von Eisenschmiede.‡아이언포지 성문 밖에 있는 케이트린 아이언케틀에게 서서히 구운 칠면조 20마리를 가져가야 합니다.‡Lleva 20 pavos a fuego lento a Caitrin Hierrocaldera en las afueras de Forjaz.‡Lleva 20 pavos a fuego lento a Caitrin Hierrocaldera en las afueras de Forjaz.‡Apportez 20 Dindes rôties à Caitrin Bouilloire-de-fer, devant Forgefer.‡将20份慢烤火鸡交给铁炉堡外面的凯特琳·铁壶。‡帶20隻炆烤火雞給鐵爐堡外的凱特倫·鐵壺。',
  }
},
[14051] = {
  {
    'Não se esqueça da farofa!‡Не забыть про запеканку!‡Die Füllung ist alles!‡빵 범벅을 잊지 말아요!‡¡No olvides el relleno!‡¡No olvides el relleno!‡N\'oubliez pas la farce !‡别忘了那馅料！‡別忘了餡料!',
    nil,
    'Leve 20 porções de Farofa de Pão de Especiarias para Natasha Leira na Festa da Fartura, em frente a Altaforja.‡Принесите 20 порций пряной хлебной запеканки Кэтрин Железный Чан к праздничным столам у ворот Стальгорна.‡Bringt 20 Portionen Gewürzbrotfüllung zu Caitrin Eisenkessel nahe der Festtafel außerhalb von Eisenschmiede.‡아이언포지 성문 밖의 잔치 지역에 있는 케이트린 아이언케틀에게 매콤한 빵 범벅 20개를 가져가야 합니다.‡Lleva 20 rellenos de pan de especias a Caitrin Hierrocaldera en el área festiva en las afueras de Forjaz.‡Lleva 20 rellenos de pan de especias a Caitrin Hierrocaldera en el área festiva en las afueras de Forjaz.‡Apportez 20 portions de Farce au pain épicé à Caitrin Bouilloire-de-fer, au festin qui se trouve devant Forgefer.‡将20份玉米馅料交给凯特琳·铁壶。 他就在铁炉堡宴会区外面。‡帶20份香料麵包餡料給鐵爐堡外邊餐會區的凱特倫·鐵壺。',
  }
},
[14053] = {
  {
    'Acabou o chutney de mirtilo de novo?‡У нас опять кончился соус?‡Schon wieder kein Moosbeerenchutney mehr?‡새콤달콤 덩굴월귤 소스가 또 떨어졌다고?‡¿Otra vez sin chatni de arándanos?‡¿Otra vez sin chatni de arándanos?‡On est encore à court de sauce ?‡酸果蔓酱又吃完了？‡蔓越莓酸甜醬又吃完了?',
    nil,
    'Leve 20 porções de Chutney de Mirtilo para Helena Morus na Festa da Fartura, em frente a Ventobravo.‡Принесите 20 порций клюквенного соуса Эллен Мур к праздничным столам возле Штормграда.‡Bringt 20 Portionen Moosbeerenchutney zu Ellen Moore an die Festtafel außerhalb Sturmwinds.‡스톰윈드 성문 밖의 잔치 지역에 있는 엘렌 무어에게 새콤달콤 덩굴월귤 소스 20개를 가져가야 합니다.‡Lleva 20 raciones de chatni de arándanos a Ellen Moore, en el área festiva fuera de Ventormenta.‡Lleva 20 raciones de chatni de arándanos a Ellen Moore, en el área festiva fuera de Ventormenta.‡Apportez 20 portions de Sauce aux canneberges à Ellen Moore, au festin qui se tient devant Hurlevent.‡将20份酸果蔓酱交给暴风城外宴会区的艾伦·摩尔。‡帶20份蔓越莓酸甜醬給暴風城外邊餐會區的愛蓮·摩爾。',
  }
},
[14054] = {
  {
    'O que te importa? Come torta!‡Проще пареной тыквы‡Kuchen versuchen‡누워서 파이 먹기‡Fácil como una tarta‡Fácil como una tarta‡C\'est du gâteau‡小菜一碟‡一「派」輕鬆',
    nil,
    'Leve 20 fatias de Torta de Abóbora para Mariana Benford na Festa da Fartura, perto dos portões de Darnassus.‡Принесите 20 кусков тыквенного пирога Мэри Аллертон к праздничным столам возле Дарнаса.‡Bringt 20 Kürbiskuchen zu Mary Allerton an die Festtafel vor den Toren von Darnassus.‡다르나서스 성문 주위의 잔치 지역에 있는 메리 앨러튼에게 호박 파이 20개를 가져가야 합니다.‡Lleva 20 raciones de tarta de calabaza a Mary Allerton en el área festiva cerca de las puertas de Darnassus.‡Lleva 20 raciones de tarta de calabaza a Mary Allerton en el área festiva cerca de las puertas de Darnassus.‡Apportez 20 Tartes à la citrouille à Mary Allerton, au festin qui se tient près des portes de Darnassus.‡将20份南瓜馅饼交给达纳苏斯大门附近宴会区的玛丽·奥勒登。‡帶20片南瓜派給達納蘇斯大門附近餐會區的瑪麗·愛勒頓。',
  }
},
[14055] = {
  {
    'Qual é o doce mais doce?‡Батат – значит, батат!‡Rein in die Kartoffeln, raus aus den Kartoffeln‡그녀는 고구마라 했지요‡El corro de las batatas‡El corro de las batatas‡Des patates pour ma douce‡她喜欢土豆‡她要甜薯',
    nil,
    'Leve 20 Batatas Doces Caramelizadas para Gaspar Morus na Festa da Fartura em Ventobravo.‡Принесите 20 порций засахаренного батата Джасперу Муру к праздничным столам возле Штормграда.‡Bringt 20 kandierte Süßkartoffeln zu Jasper Moore an die Festtafel außerhalb von Sturmwind.‡스톰윈드 성문 밖에 있는 잔치 지역에 있는 재스퍼 무어에게 고구마 맛탕 20개를 가져가야 합니다.‡Lleva 20 batatas confitadas a Jasper Moore en el área del festín a las afueras de Ventormenta.‡Lleva 20 batatas confitadas a Jasper Moore en el área del festín a las afueras de Ventormenta.‡Apportez 20 Patates douces confites à Jasper Moore, au festin qui se tient devant Hurlevent.‡将20份糖心甜土豆交给暴风城外面宴会区的加斯帕·摩尔。‡帶20份糖煮甜薯給暴風城外邊餐會區的賈斯伯·摩爾。',
  }
},
[14058] = {
  {
    'Qual é o doce mais doce?‡Батат – значит, батат!‡Rein in die Kartoffeln, raus aus den Kartoffeln‡그녀는 고구마라 했지요‡El corro de las batatas‡El corro de las batatas‡Si vous avez la patate...‡她喜欢土豆‡她要甜薯',
    nil,
    'Traga 20 Batatas Doces Caramelizadas para Guilhem Mirto na área da festa, acima da Cidade Baixa.‡Принесите 20 порций засахаренного батата Вилльяму Маллинсу к праздничным столам над Подгородом.‡Bringt 20 kandierte Süßkartoffeln zu William Mullins an die Festtafel oberhalb von Unterstadt.‡언더시티 위쪽의 잔치 지역에 있는 윌리엄 멀린스에게 고구마 맛탕 20개를 가져다주어야 합니다.‡Lleva 20 batatas confitadas a William Mullins en el área del festín sobre Entrañas.‡Lleva 20 batatas confitadas a William Mullins en el área del festín sobre Entrañas.‡Apportez 20 Patates douces confites à William Mullins, au festin qui se tient au-dessus de Fossoyeuse.‡将20份糖心甜土豆交给幽暗城上方宴会区里的威廉·穆林。‡帶20份糖煮甜薯給幽暗城餐會區的威廉·慕林。',
  }
},
[14059] = {
  {
    'Acabou o chutney de mirtilo de novo?‡У нас опять кончился соус?‡Schon wieder kein Moosbeerenchutney mehr?‡새콤달콤 덩굴월귤 소스가 또 떨어졌다고?‡¿Otra vez sin chatni de arándanos?‡¿Otra vez sin chatni de arándanos?‡On est encore à court de sauce ?‡酸果蔓酱又吃完了？‡蔓越莓酸甜醬又吃完了?',
    nil,
    'Leve 20 porções de Chutney de Mirtilo para Jéssica Dáver na Festa da Fartura, que está montada no pátio acima da Cidade Baixa.‡Принесите 20 порций клюквенного соуса Роберте Картер, которая стоит возле праздничных столов во внутреннем дворе Подгорода.‡Bringt 20 Portionen Moosbeerenchutney zu Roberta Carter an die Festtafel in den Innenhof oberhalb von Unterstadt.‡새콤달콤 덩굴월귤 소스 20개를 만들어 언더시티 위쪽 안마당의 잔치 지역에 있는 로버타 카터에게 가져가야 합니다.‡Lleva 20 raciones de chatni de arándanos a Roberta Carter en el área festiva en el patio sobre Entrañas.‡Lleva 20 raciones de chatni de arándanos a Roberta Carter en el área festiva en el patio sobre Entrañas.‡Apportez 20 portions de Sauce aux canneberges à Roberta Carter, au festin qui se tient au-dessus de Fossoyeuse.‡将20份酸果蔓酱交给幽暗城庭院上方宴会区的罗贝塔·卡特。‡帶20份蔓越莓酸甜醬給幽暗城中庭餐會區的蘿貝塔·卡特。',
  }
},
[14060] = {
  {
    'O que te importa? Come torta!‡Проще пареной тыквы‡Kuchen versuchen‡누워서 파이 먹기‡Fácil como una tarta‡Fácil como una tarta‡C\'est du gâteau‡小菜一碟‡一「派」輕鬆',
    nil,
    'Leve 20 porções de Torta de Abóbora para Mahara Trigoflavo na Festa da Fartura, que está montada ao lado do Penhasco do Trovão.‡Принесите 20 кусков тыквенного пирога Мархаре Голдвит к праздничным столам возле Громового Утеса.‡Bringt 20 Kürbiskuchen zu Mahara Goldweizen nahe der Festtafel außerhalb von Donnerfels.‡썬더 블러프 외곽의 잔치 지역에 있는 마하라 골드윗에게 호박 파이 20개를 가져다주어야 합니다.‡Lleva 20 pedazos de tarta de calabaza a Mahara Orotrigo al área del festín en las afueras de Cima del Trueno.‡Lleva 20 pedazos de tarta de calabaza a Mahara Orotrigo al área del festín en las afueras de Cima del Trueno.‡Apportez 20 Tartes à la citrouille à Mahara Blé-doré, au festin qui se tient devant les Pitons du Tonnerre.‡将20份南瓜馅饼交给雷霆崖外宴会区的玛哈拉·金穗。‡帶20片南瓜派給雷霆崖外邊餐會區的瑪哈拉·金麥。',
  }
},
[14061] = {
  {
    'Peru a dar com pau‡Слишком мало индеек‡Ich krieg einfach nicht genug … Truthahn‡부족한 칠면조‡No tenemos suficiente pavo...‡No tenemos suficiente pavo...‡Il n\'y aura jamais assez de dinde‡火鸡还是缺‡火雞不足',
    nil,
    'Leve 20 Perus Assados Lentamente para Ondani Grão-moinho em frente a Orgrimmar.‡Принесите 20 запеченных индеек Ондани Большой Мельнице к вратам Оргриммара.‡Bringt 20 langsam geröstete Truthähne zu Ondani Mühlenrad außerhalb von Orgrimmar.‡오그리마 밖에 있는 온다니 그레이트밀에게 서서히 구운 칠면조 20마리를 가져가야 합니다.‡Lleva 20 pavos a fuego lento a Ondani Gran Molino en las afueras de Orgrimmar.‡Lleva 20 pavos a fuego lento a Ondani Gran Molino en las afueras de Orgrimmar.‡Apportez 20 Dindes rôties à Ondani Grand-moulin, devant Orgrimmar.‡将20份慢烤火鸡交给奥格瑞玛外面的昂丹尼。‡帶20隻炆烤火雞給奧格瑪外邊的昂達尼·巨磨。',
  }
},
[14062] = {
  {
    'Não se esqueça da farofa!‡Не забыть про запеканку!‡Die Füllung ist alles!‡빵 범벅을 잊지 말아요!‡¡No olvides el relleno!‡¡No olvides el relleno!‡N\'oubliez pas la farce !‡别忘了那馅料！‡別忘了餡料!',
    nil,
    'Leve 20 porções de Farofa de Pão de Especiarias para Ondani Grão-moinho em frente a Orgrimmar.‡Принесите 20 порций пряной хлебной запеканки Ондани Большой Мельнице к вратам Оргриммара.‡Bringt 20 Portionen Gewürzbrotfüllung zu Ondani Mühlenrad an die Festtafel außerhalb von Orgrimmar.‡오그리마 밖에 있는 온다니 그레이트밀에게 매콤한 빵 범벅 20개를 가져가야 합니다.‡Lleva 20 rellenos de pan de especias a Ondani Gran Molino en el área festiva en las afueras de Orgrimmar.‡Lleva 20 rellenos de pan de especias a Ondani Gran Molino en el área festiva en las afueras de Orgrimmar.‡Apportez 20 portions de Farce au pain épicé à Ondani Grand-moulin, devant Orgrimmar.‡将20份玉米馅料交给奥格瑞玛外面的昂丹尼。‡帶20份香料麵包餡料給奧格瑪外邊的昂達尼·巨磨。',
  }
},
[14064] = {
  {
    'Um banquete farto‡Богатый пир‡Teilen an der Festtafel‡푸짐한 잔치 음식 나누기‡Compartir un festín generoso‡Compartir un festín generoso‡Partager un festin des Bienfaits‡分享盛宴大餐‡分享豐年祭盛宴',
    nil,
    'Coma 5 porções de cada prato em uma Mesa Abundante até receber o Espírito da Partilha.‡Съешьте по 5 порций каждого из праздничных блюд с пиршественного стола, пока не ощутите дух пиршества.‡Verspeist fünf Portionen jedes Gerichts an einem reich gedeckten Tisch, bis Ihr zu der Erkenntnis kommt: Teilen macht Freude.‡나눔의 정신을 얻기 전까지 푸짐한 잔칫상에 있는 음식 중 5개의 음식을 먹어야 합니다.‡Come cinco raciones de cada comida en una mesa generosa hasta que obtengas El espíritu de compartir.‡Come cinco raciones de cada comida en una mesa generosa hasta que obtengas El espíritu de compartir.‡Mangez cinq fois de chacun des plats présentés sur la Table des Bienfaits, jusqu\'à ce que vous gagniez l\'amélioration Esprit du partage.‡在盛宴餐桌旁将每一种食物都吃过五份，以此获得分享之魂。‡在豐年祭餐席上吃下每種食物各五份直到獲得有福同享。',
  }
},
[14065] = {
  {
    'Um banquete farto‡Богатый пир‡Teilen an der Festtafel‡푸짐한 잔치 음식 나누기‡Compartir un festín generoso‡Compartir un festín generoso‡Partager un festin des Bienfaits‡分享盛宴大餐‡分享豐年祭盛宴',
    nil,
    'Coma 5 porções de cada prato em uma Mesa Abundante até receber o Espírito da Partilha.‡Съешьте по 5 порций каждого из праздничных блюд с пиршественного стола, пока не ощутите дух пиршества.‡Verspeist fünf Portionen jedes Gerichts an einem reich gedeckten Tisch, bis Ihr zu der Erkenntnis kommt: Teilen macht Freude.‡나눔의 정신을 얻기 전까지 푸짐한 잔칫상에 있는 음식 중 5개의 음식을 먹어야 합니다.‡Come cinco raciones de cada comida en una mesa generosa hasta que obtengas El espíritu de compartir.‡Come cinco raciones de cada comida en una mesa generosa hasta que obtengas El espíritu de compartir.‡Mangez cinq fois de chacun des plats présentés sur la Table des Bienfaits, jusqu\'à ce que vous gagniez l\'amélioration Esprit du partage.‡在盛宴餐桌旁将每一种食物都吃过五份，以此获得分享之魂。‡在豐年祭餐席上吃下每種食物各五份直到獲得有福同享。',
  }
},
[14074] = {
  {
    '‡Лапами кверху‡Legt mal ein Bein zu‡다리 지원‡Por patas‡Por patas‡Comment retomber sur ses pattes…‡一腿之力‡被劫的腿肉補給',
    nil,
    '‡Верните 10 украденных окорочков долгонога Нараси Снежной Заре из Павильона Серебряного союза на Ристалище Серебряного турнира.‡Beschafft 10 gestohlene Weitschreiterbeine zurück und bringt sie zu Narasi Schneedämmerung auf dem Argentumturnierplatz.‡도난당한 타조 다리 10개를 되찾아 은빛십자군 마상시합 광장에 있는 나라시 스노우돈에게 가져가야 합니다.‡Recupera 10 patas de zancaalta robadas para Nasari Albanieve en los Campos del Torneo Argenta.‡Recupera 10 patas de zancaalta robadas para Nasari Albanieve en los Campos del Torneo Argenta.‡Récupérer 10 Pilons de haut-trotteur volés pour Narasi Aubeneige, dans l\'Enceinte du tournoi d\'Argent.‡夺回10条被偷走的陆行鸟腿，交给银色比武场的纳莱丝·晨雪。‡',
  }
},
[14076] = {
  {
    '‡Завтрак для чемпионов‡Frühstück der Champions‡용사의 아침 식사‡Desayuno de campeones‡Desayuno de campeones‡Le petit-déjeuner des champions‡勇士的早餐‡勇士的早餐',
    nil,
    '‡Найдите 4 яйца йормунгаров и принесите их Савинии Певице Преданий на ристалище Серебряного турнира.‡Beschafft Euch 4 Eiersäcke eines Jormungars und bringt sie zu Savinia Lehrensang auf dem Argentumturnierplatz.‡요르문가르 알 주머니 4개를 모아 은빛십자군 마상시합 광장에 있는 사비나 로어송에게 가져가야 합니다.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Savinia Romanza en los Campos del Torneo Argenta.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Savinia Romanza en los Campos del Torneo Argenta.‡Procurez-vous 4 Cocons d\'œufs de jormungar et remettez-les à Savinia Chanterite dans l\'Enceinte du tournoi d\'argent.‡取得4只冰虫的卵鞘，将它们交给银色比武场的萨雯妮娅·慧歌。‡',
  }
},
[14077] = {
  {
    '‡Милосердие Света‡Die Barmherzigkeit des Lichts‡빛의 자비‡La piedad de la Luz‡La piedad de la Luz‡La miséricorde de la Lumière‡圣光的仁慈‡聖光的憐憫',
    nil,
    '‡Воспользуйтесь Молитвенником исповедницы для проведения последнего обряда над телами 8 убитых туаликов, после чего вернитесь к Нараси Снежной Заре в шатер Альянса на Ристалище Серебряного турнира.‡Benutzt das Gebetsbuch der Beichtpatin, um 8 erschlagenen Tualiq-Bewohnern ihre Sterbesakramente zu lesen, und kehrt dann zu Narasi Schneedämmerung auf dem Argentumturnierplatz zurück.‡고해사제의 기도서를 사용하여 살해된 투알리크 주민 8명에게 종부성사를 해 주고, 은빛십자군 마상시합 광장에 있는 나라시 스노우돈에게 돌아와야 합니다.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Utilisez le Livre de prière du confesseur pour célébrer les derniers sacrements sur 8 Villageois tualiq morts, puis retournez voir Narasi Aubeneige dans l\'Enceinte du tournoi d\'Argent.‡使用神官的祈祷书，为8位被屠戮的图亚里克村民举行追悼仪式，然后返回银色比武场，去见纳莱丝·晨雪。‡',
  }
},
[14079] = {
  {
    'Aprenda a cavalgar na Floresta de Elwynn‡Уроки верховой езды в Элвиннском лесу‡Reiten lernen im Wald von Elwynn‡엘윈 숲에서 타는 법 배우기‡Aprende a montar en el Bosque de Elwynn‡Aprende a montar en el Bosque de Elwynn‡Un cavalier débutant dans la forêt d\'Elwynn‡驰骋在艾尔文森林‡在艾爾文森林學習騎術',
    nil,
    'Entregue o panfleto a Randal Caçador na Madeireira Vale do Leste, que fica na Floresta de Elwynn.‡Верните это рекламное сообщение Рандалу Охотнику на лесопилку Восточной долины в Элвиннском лесу.‡Bringt diesen Handzettel zu Randal Waidmann beim Holzfällerlager des Osttals im Wald von Elwynn.‡엘윈 숲의 동부 벌목지에 있는 랜들 헌터에게 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Randal Predatio, que se encuentra en el Aserradero de la Vega del Este en el Bosque de Elwynn.‡Devuelve este panfleto a Randal Predatio, que se encuentra en el Aserradero de la Vega del Este en el Bosque de Elwynn.‡Rapportez ce fascicule à Randal Hunter au Camp de bûcherons du Val d\'est dans la Forêt d\'Elwynn.‡将这本小册子交还给艾尔文森林东谷伐木场的兰达尔·亨特。‡到艾爾文森林的東谷伐木場，把這本小手冊繳回給蘭達爾·亨特。',
  }
},
[14080] = {
  {
    '‡Остановить нападение‡Einhalt den Aggressoren‡침략자를 저지하라‡Detén a los agresores‡Detén a los agresores‡Arrêter les agresseurs‡抗击侵略者‡阻止侵略者',
    nil,
    '‡Нараси Снежная Заря из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас убить 10 квалдиров.‡Narasi Schneedämmerung auf dem Argentumturnierplatz möchte, dass Ihr 10 Kvaldir tötet.‡은빛십자군 마상시합 광장에 있는 나라시 스노우돈이 크발디르 10명을 처치해 달라고 했습니다.‡Narasi Albanieve en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Narasi Albanieve en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Narasi Aubeneige, de l\'Enceinte du tournoi d\'Argent, veut que vous tuiez 10 Kvaldirs.‡银色比武场的纳莱丝·晨雪想让你消灭10名克瓦迪尔。‡',
  }
},
[14081] = {
  {
    'Aprenda a cavalgar na Floresta do Canto Eterno‡Уроки верховой езды в Лесах Вечной Песни‡Reiten lernen im Immersangwald‡영원노래 숲에서 타는 법 배우기‡Aprende a montar en el Bosque Canción Eterna‡Aprende a montar en el Bosque Canción Eterna‡Un cavalier débutant au bois des Chants éternels‡驰骋在永歌森林‡在永歌森林學習騎術',
    nil,
    'Entregue o panfleto a Peralandro na Cocheira de Thuron, que fica em Luaprata.‡Верните это рекламное сообщение Пераскамину в стойла Турона в Луносвете.‡Bringt diesen Handzettel zu Perascamin bei Turons Aufzucht in Silbermond.‡실버문의 투론의 매타조 훈련장에 있는 페라스카민에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Perascamin, que se encuentra en la Caballería de Thuron en Ciudad de Lunargenta.‡Devuelve este panfleto a Perascamin, que se encuentra en la Caballería de Thuron en Ciudad de Lunargenta.‡Rapportez ce fascicule à Perascamin à l\'Écurie de Thuron, à Lune-d\'argent.‡将这本小册子交还给银月城苏伦的养殖场的佩拉斯卡米。‡到銀月城，把這本小手冊繳回給珀拉斯坎。',
  }
},
[14082] = {
  {
    'Aprenda a cavalgar na Exodar‡Уроки верховой езды в Экзодаре‡Reiten lernen in der Exodar‡엑소다르에서 타는 법 배우기‡Aprende a montar en El Exodar‡Aprende a montar en El Exodar‡Un cavalier débutant à l\'Exodar‡驰骋在埃索达‡在艾克索達學習騎術',
    nil,
    'Entregue este panfleto a Aalun na entrada da Exodar, que fica na Ilha Névoa Lazúli.‡Верните это рекламное сообщение Аалун, которая находится неподалеку от Экзодара на острове Лазурной Дымки.‡Bringt diesen Handzettel zu Aalun außerhalb der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르에 있는 알룬에게 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Aalun a las afueras de El Exodar en la Isla Bruma Azur.‡Devuelve este panfleto a Aalun a las afueras de El Exodar en la Isla Bruma Azur.‡Rapportez ce fascicule à Aalun à l\'extérieur de l\'Exodar, sur l\'Île de Brume-azur.‡将这本小册子交给秘蓝岛上的埃亚伦。‡到藍謎島的艾克索達外頭，把這本小手冊繳回給阿露恩。',
  }
},
[14083] = {
  {
    'Aprenda a cavalgar em Dun Morogh‡Уроки верховой езды в Дун Мороге‡Reiten lernen in Dun Morogh‡던 모로에서 타는 법 배우기‡Aprende a montar en Dun Morogh‡Aprende a montar en Dun Morogh‡Un cavalier débutant à Dun Morogh‡驰骋在丹莫罗‡在丹莫洛學習騎術',
    nil,
    'Entregue o panfleto a Ultham Chifrerro no Rancho Ambarmanso, que fica em Dun Morogh.‡Верните это рекламное сообщение Ультаму Громовому Рогу на ферму Янтарленов в Дун Мороге.‡Bringt diesen Handzettel zu Ultham Eisenhorn beim Gehöft Bernruh in Dun Morogh.‡던 모로의 앰버스틸 목장에 있는 울담 아이언혼에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Ulthaan Ferrocorno, que se encuentra en la Granja de Semperámbar en Dun Morogh.‡Devuelve este panfleto a Ulthaan Ferrocorno, que se encuentra en la Granja de Semperámbar en Dun Morogh.‡Rapportez ce fascicule à Ultham Corne-de-fer à la ferme des Distillambre en Dun Morogh.‡将这本小册子交给丹莫罗冻石农场的奥萨姆·铁角。‡到丹莫洛的凍石農場，把這本小手冊繳回給奧薩姆·鐵角。',
  }
},
[14084] = {
  {
    'Aprenda a cavalgar em Dun Morogh‡Уроки верховой езды в Дун Мороге‡Reiten lernen in Dun Morogh‡던 모로에서 타는 법 배우기‡Aprende a montar en Dun Morogh‡Aprende a montar en Dun Morogh‡Un cavalier débutant à Dun Morogh‡驰骋在丹莫罗‡在丹莫洛學習騎術',
    nil,
    'Entregue o panfleto a Binjy Penapita na Garagem do Gradaço, que fica em Dun Morogh.‡Верните это рекламное сообщение Бинджи Перосвисту в поселок Сталежара в Дун Мороге.‡Bringt diesen Handzettel zu Binjy Federpfiff bei Stahlrosts Depot in Dun Morogh.‡던 모로의 스틸그릴의 정비소에 있는 빈지 페더휘슬에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Binjy Plumasilba, que se encuentra en el Almacén de Brasacerada en Dun Morogh.‡Devuelve este panfleto a Binjy Plumasilba, que se encuentra en el Almacén de Brasacerada en Dun Morogh.‡Rapportez ce fascicule à Binjy Siffleplume au Dépôt de Grillacier en Dun Morogh.‡将这本小册子交给丹莫罗钢架补给站的宾吉·羽哨。‡到丹莫洛的鋼架補給站，把這本小手冊繳回給賓吉·羽哨。',
  }
},
[14085] = {
  {
    'Aprenda a cavalgar em Darnassus‡Уроки верховой езды в Дарнасе‡Reiten lernen in Darnassus‡다르나서스에서 타는 법 배우기‡Aprende a montar en Darnassus‡Aprende a montar en Darnassus‡Un cavalier débutant à Darnassus‡驰骋在达纳苏斯‡在達納蘇斯學習騎術',
    nil,
    'Entregue o panfleto a Jartsam no Enclave Cenariano, que fica em Darnassus.‡Верните это рекламное сообщение Джартсаму в анклав Кенария в Дарнасе.‡Bringt diesen Handzettel zu Jartsam bei der Enklave des Cenarius in Darnassus.‡다르나서스의 상인의 정원에 있는 잘트삼에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Jartsam, que se encuentra en el Enclave Cenarion en Darnassus.‡Devuelve este panfleto a Jartsam, que se encuentra en el Enclave Cenarion en Darnassus.‡Rapportez ce fascicule à Jartsam, dans l\'Enclave cénarienne de Darnassus.‡将这本小册子交给达纳苏斯塞纳里奥区的贾萨姆。‡到達納蘇斯的塞納里奧區，把這本小手冊繳回給賈薩姆。',
  }
},
[14086] = {
  {
    'Aprenda a cavalgar em Orgrimmar‡Уроки верховой езды в Оргриммаре‡Reiten lernen in Orgrimmar‡오그리마에서 타는 법 배우기‡Aprende a montar en Orgrimmar‡Aprende a montar en Orgrimmar‡Un cavalier débutant à Orgrimmar‡驰骋在奥格瑞玛‡在奧格瑪學習騎術',
    nil,
    'Entregue o panfleto a Kildar no Vale da Honra, que fica em Orgrimmar.‡Верните это рекламное сообщение Кильдару в Аллею Чести в Оргриммаре.‡Bringt diesen Handzettel zu Kildar im Tal der Ehre in Orgrimmar.‡오그리마의 명예의 골짜기에 있는 킬다르에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Kildar, que se encuentra en el Valle del Honor de Orgrimmar.‡Devuelve este panfleto a Kildar, que se encuentra en el Valle del Honor de Orgrimmar.‡Rapportez ce fascicule à Kildar, dans la Vallée de l\'Honneur d\'Orgrimmar.‡将这本小册子交给奥格瑞玛荣耀谷的基尔达。‡到奧格瑪的榮譽谷，把這本小手冊繳回給基爾達。',
  }
},
[14087] = {
  {
    'Aprenda a cavalgar em Mulgore‡Уроки верховой езды в Мулгоре‡Reiten lernen in Mulgore‡멀고어에서 타는 법 배우기‡Aprende a montar en Mulgore‡Aprende a montar en Mulgore‡Un cavalier débutant à Mulgore‡驰骋在莫高雷‡在莫高雷學習騎術',
    nil,
    'Entregue este panfleto a Kar Tormenta Cantante na Aldeia Casco Sangrento, que fica em Mulgore.‡Верните это рекламное сообщение Кару Певцу Бури в деревню Кровавого Копыта в Мулгоре.‡Bringt diesen Handzettel zu Kar Sturmsang beim Dorf der Bluthufe in Mulgore.‡멀고어의 블러드후프 마을에 있는 카르 스톰싱어에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Kar Tormensón, que se encuentra en el Poblado Pezuña de Sangre en Mulgore.‡Devuelve este panfleto a Kar Tormensón, que se encuentra en el Poblado Pezuña de Sangre en Mulgore.‡Rapportez ce fascicule à Kar Chante-l\'orage, à Sabot-de-sang en Mulgore.‡将这本小册子交给莫高雷血蹄村的卡尔·雷歌。‡到莫高雷的血蹄村，把這本小手冊繳回給卡爾·雷詠。',
  }
},
[14088] = {
  {
    'Aprenda a cavalgar em Durotar‡Уроки верховой езды в Дуротаре‡Reiten lernen in Durotar‡듀로타에서 타는 법 배우기‡Aprende a montar en Durotar‡Aprende a montar en Durotar‡Un cavalier débutant à Durotar‡驰骋在杜隆塔尔‡在杜洛塔學習騎術',
    nil,
    'Entregue o panfleto a Xar\'Ti na Aldeia Sen\'jin, que fica na parte sul de Durotar.‡Верните это рекламное сообщение Ксар\'Ти в деревню Сен\'Джин в Дуротаре.‡Bringt diesen Handzettel zu Xar\'Ti in Sen\'jin im südlichen Durotar.‡듀로타 남쪽의 센진 마을에 있는 살티에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Xar\'Ti, que se encuentra en el Poblado Sen\'jin en la parte sur de Durotar.‡Devuelve este panfleto a Xar\'Ti, que se encuentra en el Poblado Sen\'jin en la parte sur de Durotar.‡Rapportez ce fascicule à Xar\'Ti, à Sen\'jin en Durotar.‡将这本小册子交还给杜隆塔尔南面森金村的克萨尔迪。‡到杜洛塔南邊的森金村，把這本小手冊繳回給札爾提。',
  }
},
[14089] = {
  {
    'Aprenda a cavalgar nas Clareiras de Tirisfal‡Уроки верховой езды в Тирисфальскх лесах‡Reiten lernen in Tirisfal‡티리스팔 숲에서 타는 법 배우기‡Aprende a montar en los Claros de Tirisfal‡Aprende a montar en los Claros de Tirisfal‡Un cavalier débutant dans les clairières de Tirisfal‡驰骋在提瑞斯法林地‡在提里斯法林地學習騎術',
    nil,
    'Entregue o panfleto a Vilma Warnam em Montalvo, que fica nas Clareiras de Tirisfal.‡Верните это рекламное сообщение Вельме Варнам в Брилл в Тирисфальских лесах.‡Bringt diesen Handzettel zu Velma Warnam in Brill in Tirisfal.‡티리스팔 숲의 브릴에 있는 벨마 워넘에게 이 전단지를 가져다주어야 합니다.‡Devuelve este panfleto a Velma Warnam, que se encuentra en Rémol en los Claros de Tirisfal.‡Devuelve este panfleto a Velma Warnam, que se encuentra en Rémol en los Claros de Tirisfal.‡Rapportez ce fascicule à Velma Warnam à Brill dans les Clairières de Tirisfal.‡将这本小册子交给提瑞斯法林地布瑞尔的维尔玛。‡到提里斯法林地的布瑞爾，把這本小手冊繳回給維爾瑪·瓦納姆。',
  }
},
[14090] = {
  {
    '‡Гормоку нужны снобольды‡Gormok will seine Schneebolde‡스노볼트를 찾는 고르목‡Gormok quiere sus snóbolds‡Gormok quiere sus snóbolds‡Gormok veut ses frigbolds !‡戈莫克想要他的狗头人‡戈莫克要他的極地狗頭人',
    nil,
    '‡Воспользуйтесь утяжеленной сетью, чтобы поймать 8 последователей с Холмов Снежной Слепоты, и приведите их Савинии Певице Преданий в Павильон Серебряного союза на Ристалище Серебряного турнира.‡Fangt mithilfe des beschwerten Netzes 8 schneeblinde Anhänger und bringt sie zu Savinia Lehrensang auf dem Argentumturnierplatz.‡무거운 그물로 설맹의 추종자 8마리를 붙잡아 은빛십자군 마상시합 광장에 있는 사비나 로어송에게 가져가야 합니다.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Savinia Romanza, en los Campos del Torneo Argenta.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Savinia Romanza, en los Campos del Torneo Argenta.‡Servez-vous du Filet lesté pour capturer 8 Suivants Brûleglace, et remettez-les à Savinia Chanterite, dans l\'Enceinte du tournoi d\'Argent.‡使用强化渔网抓住8个雪盲追随者，并把它们交给银色比武场的萨雯妮娅·慧歌。‡',
  }
},
[14092] = {
  {
    '‡Завтрак для чемпионов‡Frühstück der Champions‡용사의 아침 식사‡Desayuno de campeones‡Desayuno de campeones‡Le petit-déjeuner des champions‡勇士的早餐‡勇士的早餐',
    nil,
    '‡Принесите 4 яйца йормунгаров Тайлосу Вестнику Зари в шатер Орды на Ристалище Серебряного турнира.‡Beschafft Euch 4 Eiersäcke eines Jormungars und bringt sie zu Tylos Dämmerflucht auf dem Argentumturnierplatz.‡요르문가르 알 주머니 4개를 은빛십자군 마상시합 광장에 있는 틸로스 돈러너에게 가져가야 합니다.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Tylos Correalba en los Campos del Torneo Argenta.‡Consigue 4 sacos de huevos de jormungar y llévaselos a Tylos Correalba en los Campos del Torneo Argenta.‡Procurez-vous 4 Cocons d\'œufs de jormungar et remettez-les à Tylos Coursaurore dans l\'Enceinte du tournoi d\'argent.‡‡',
  }
},
[14095] = {
  {
    '‡Опознание останков‡Die Überreste identifizieren‡유해 식별‡Identificar los restos‡Identificar los restos‡L\'identification des restes‡鉴定遗留物‡鑑定屍體',
    nil,
    '‡Отнесите зуб кракена Крестоносцу Серебристый Рассвет в Серебряный павильон.‡Bringt den Krakenzahn zum Beweis Eures Sieges zu Kreuzfahrer Silberdämmerung.‡승리의 증거로 북해 크라켄 이빨을 성전사 실버돈에게 가져가야 합니다.‡Llévale el diente de kraken al cruzado Albaplata como prueba de tu victoria.‡Llévale el diente de kraken al cruzado Albaplata como prueba de tu victoria.‡Apportez la Dent de kraken au Croisé Aubargent comme preuve de votre victoire.‡带上海怪的牙齿作为你胜利的证明，去见北伐军战士希瓦多恩。‡',
  }
},
[14096] = {
  {
    '‡На этот раз ты нарвался, Кул‡Diesmal habt Ihr Euch wirklich selbst übertroffen, Kul‡제대로 한 건 했군, 쿨‡Esta vez la has liado, Kul‡Esta vez la has liado, Kul‡Oh bravo, Kul !!!‡这次你真的做到了，库尔‡庫爾，看看你這次幹得好事',
    nil,
    '‡Спасите Кула Безрассудного и 4 пленных претендентов с Заставы Вестника Смерти и вернитесь к Нараси Снежной Заре в шатер Альянса на Ристалище Серебряного турнира.‡Rettet Kul den Tollkühnen und 4 gefangene Streiter aus Todessprechers Wacht und kehrt dann zu Narasi Schneedämmerung auf dem Argentumturnierplatz zurück.‡못 말리는 쿨과 4명의 사로잡힌 지원자들을 죽음예언자 감시초소에서 구하고 은빛십자군 마상시합 광장에 있는 나라시 스노우돈에게 가야 합니다.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Narasi Albanieve en los Campos del Torneo Argenta.‡Sauvez Kul le Téméraire et 4 Aspirants captifs du Guet du nécrorateur. Lorsque ce sera fait, retournez voir Narasi Aubeneige, dans l\'Enceinte du tournoi d\'Argent.‡在亡语者岗哨援救鲁莽的库尔和4名被俘虏的候选者，然后返回银色比武场，去见纳莱丝·晨雪。‡',
  }
},
[14100] = {
  {
    'Relic of the Earthen Ring‡Реликвия Служителей Земли‡Relikt des Irdenen Rings‡속세의 고리회 유물‡Reliquia del Anillo de la Tierra‡Reliquia del Anillo de la Tierra‡La relique du Cercle terrestre‡大地之环的遗迹‡陶土議會聖物',
    nil,
    'Bring your four totems to Gotura Fourwinds in Orgrimmar.‡Принесите четыре тотема Готуру Четыре Ветра в Оргриммар.‡Bringt Eure vier Totems nach Orgrimmar zu Gotura Vierwind.‡오그리마에서 고투라 포윈즈를 찾아야 합니다.‡Llévale tus cuatro tótems a Gotura Cuatro Vientos a Orgrimmar.‡Llévale tus cuatro tótems a Gotura Cuatro Vientos a Orgrimmar.‡Apportez vos quatre totems à Gotura Quatre-vents à Orgrimmar.‡将你的四大元素图腾交给奥格瑞玛的戈图拉·林风。‡帶著你的四種圖騰去找奧格瑪的古圖拉·四風。',
  }
},
[14101] = {
  {
    '‡Дроттинн Хротгар‡Drottinn Hrothgar‡드로틴 흐로스가르‡Drottinn Hrothgar‡Drottinn Hrothgar‡Le drottinn Hrothgar‡德罗丁·洛斯加尔‡多廷‧赫魯斯加',
    nil,
    '‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Дроттинна Хротгара.‡Hochmeister Adelard auf dem Argentumturniergelände möchte, dass Ihr Drottinn Hrothgar besiegt.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 드로틴 흐로스가르를 물리쳐 달라고 했습니다.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que derrotes a Drottinn Hrothgar.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que derrotes a Drottinn Hrothgar.‡Le Haut croisé Adélard, dans l\'Enceinte du tournoi d\'Argent, veut que vous vainquiez le Drottinn Hrothgar.‡银色比武场的高阶十字军艾德拉德希望你去击败德罗丁·洛斯加尔。‡',
  }
},
[14102] = {
  {
    '‡Призыватель туманов Йингвар‡Nebelrufer Yngvar‡안개부름이 잉그바르‡El clamaneblina Yngvar‡El clamaneblina Yngvar‡Le mandebrume Yngvar‡唤雾者伊戈瓦尔‡喚霧者伊格瓦',
    nil,
    '‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Призывателя туманов Йингвара.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Nebelrufer Yngvar tötet.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 안개부름이 잉그바르를 처치해 달라고 했습니다.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates al clamaneblina Yngvar.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates al clamaneblina Yngvar.‡Le Haut croisé Adélard, dans l\'Enceinte du tournoi d\'Argent, veut que vous tuiez le Mandebrume Yngvar.‡银色比武场的高阶十字军艾德拉德希望你能消灭唤雾者伊戈瓦尔。‡',
  }
},
[14103] = {
  {
    'Pó de Titânico‡Титаниевый порошок‡Titanstaub‡티타늄 가루‡Partículas de titanio‡Partículas de titanio‡La poudre de titanium‡泰坦神铁粉末‡泰坦鋼粉末',
    nil,
    nil,
  }
},
[14104] = {
  {
    '‡Орнолф Меченый‡Ornolf der Vernarbte‡칼부림 오르놀프‡Ornolf el Cicatrices‡Ornolf el Cicatrices‡Ornolf le Balafré‡疤面者奥诺夫‡『刀疤』歐諾夫',
    nil,
    '‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Орнолфа Меченого.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Ornolf den Vernarbten tötet.‡‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates a Ornolf el Cicatrices.‡El alto cruzado Adelard en los Campos del Torneo Argenta quiere que mates a Ornolf el Cicatrices.‡Le Haut croisé Adélard, dans l\'Enceinte du tournoi d\'Argent, veut que vous tuiez Ornolf le Balafré.‡‡',
  }
},
[14105] = {
  {
    '‡Вестник смерти Карос‡Todessprecher Kharos‡죽음예언자 카로스‡Portavoz de la muerte Kharos‡Portavoz de la muerte Kharos‡Le nécrorateur Kharos‡亡语者卡罗斯‡亡頌者凱洛斯',
    nil,
    '‡Верховный крестоносец Аделард из Серебряного павильона на Ристалище Серебряного турнира просит вас одолеть Вестника Смерти Кароса.‡Hochmeister Adelard auf dem Argentumturnierplatz möchte, dass Ihr Todessprecher Kharos tötet.‡은빛십자군 마상시합 광장에 있는 고위 성전사 아델라드가 죽음예언자 카로스를 처치해 달라고 했습니다.‡El alto cruzado Adelard, en los Campos del Torneo Argenta, quiere que mates al portavoz de la muerte Kharos.‡El alto cruzado Adelard, en los Campos del Torneo Argenta, quiere que mates al portavoz de la muerte Kharos.‡Le Haut croisé Adélard, dans l\'Enceinte du tournoi d\'Argent, veut que vous tuiez le Nécrorateur Kharos.‡银色比武场的高阶十字军艾德拉德想让你消灭亡语者卡罗斯。‡',
  }
},
[14106] = {
  {
    '‡Na Kada\'s Quest Test‡Na Kada\'s Questtest‡‡Na Kada\'s Quest Test‡Na Kada\'s Quest Test‡Quête de test de Na Kada‡纳·卡达的任务测试‡',
    nil,
    nil,
  }
},
[14107] = {
  {
    '‡Судьба Павших‡Das Schicksal der Gefallenen‡죽은 자의 운명‡El destino de los caídos‡El destino de los caídos‡Le destin des défunts‡阵亡者的命运‡逝往者的命運',
    nil,
    '‡Крестоносец Серебристый Рассвет из Серебряного павильона просит вас даровать покой 6 духам павших героев.‡Kreuzfahrer Silberdämmerung möchte, dass Ihr dafür sorgt, dass 6 Geister der gefallenen Helden Frieden finden.‡성전사 실버돈이 전사한 영웅의 영혼 6명에게 안식을 되찾아 달라고 했습니다.‡El cruzado Albaplata quiere que proporciones paz a 6 espíritus de héroe caído.‡El cruzado Albaplata quiere que proporciones paz a 6 espíritus de héroe caído.‡Le Croisé Aubargent veut que vous apportiez la paix à 6 Esprits de héros défunts.‡北伐军战士希瓦多恩希望你让6位死去英雄的灵魂得到安息。‡',
  }
},
[14108] = {
  {
    '‡Изгнать Кракена!‡Kraken am Haken‡크라켄을 잡아라!‡¡Toma kraken!‡¡Toma kraken!‡Sus au kraken!‡猎捕海怪！‡逮住海怪!',
    nil,
    '‡Крестоносец Серебристый Рассвет из Серебряного павильона просит вас оседлать серебряного гиппогрифа, бросить 6 пылающих копий в кракена Северного моря и поразить 3 врайкулов-пробудителей глубин.|n|nСеребряного гиппогрифа можно найти возле палатки Серебряного Авангарда на Ристалище Серебряного Турнира.‡Kreuzfahrer Silberdämmerung möchte, dass Ihr auf einen Argentumhippogryph steigt, 8 flammende Speere auf den Nordmeerkraken werft und 6 Tiefenrufer der Kvaldir ausschaltet.|n|nIhr findet die Argentumhippogryphen gleich außerhalb des Zelts auf dem Argentumturnierplatz.‡‡El cruzado Albaplata quiere que montes un hipogrifo Argenta, lances 8 lanzas llameantes al Kraken de El Mar del Norte y que acabes con 6 clamahondos vrykul.|n|nPuedes encontrar los hipogrifos Argenta justo en el exterior de la tienda de La Cruzada Argenta en los Campos del Torneo.‡El cruzado Albaplata quiere que montes un hipogrifo Argenta, lances 8 lanzas llameantes al Kraken de El Mar del Norte y que acabes con 6 clamahondos vrykul.|n|nPuedes encontrar los hipogrifos Argenta justo en el exterior de la tienda de La Cruzada Argenta en los Campos del Torneo.‡Le Croisé Aubargent veut que vous chevauchiez un Hippogriffe d\'Argent, que vous lanciez 8 Lances enflammées sur le Kraken de la mer Boréale, et que vous abattiez 6 Mande-fonds kvaldirs.|n|nVous trouverez des Hippogriffes d\'Argent devant la tente de la Croisade d\'argent, dans l\'Enceinte du tournoi d\'argent.‡‡',
  }
},
[14111] = {
  {
    'Relic of the Earthen Ring‡Реликвия Служителей Земли‡Relikt des Irdenen Rings‡속세의 고리회 유물‡Reliquia del Anillo de la Tierra‡Reliquia del Anillo de la Tierra‡La relique du Cercle terrestre‡大地之环的遗迹‡陶土議會聖物',
    nil,
    'Bring your four totems to Farseer Eannu in Ironforge.‡Принесите четыре тотема Предсказателю Эанну в Стальгорн.‡Bringt Eure vier Totems nach Eisenschmiede zu Weitseher Eannu.‡아이언포지에서 선견자 이누를 찾아야 합니다.‡Llévale tus cuatro tótems al clarividente Eannu a Forjaz.‡Llévale tus cuatro tótems al clarividente Eannu a Forjaz.‡Apportez vos quatre totems au Long-voyant Eannu à Forgefer.‡带着你的四件图腾去见铁炉堡的先知安努。‡帶著你的四種圖騰去找鐵爐堡的先知埃努。',
  }
},
[14112] = {
  {
    '‡Кстати, чем питаются йети?‡Was fressen eigentlich Yetis?‡설인에게는 뭘 먹이세요?‡¿Y qué comen los yetis?‡¿Y qué comen los yetis?‡Ça mange quoi, un yéti, d\'abord?‡你们到底喂雪人吃什么？‡雪人到底該吃什麼？',
    nil,
    '‡Савиния Певица Преданий из Павильона Серебряного союза на Ристалище Серебряного турнира просит вас принести ей 3 куска мяса акулы Северного моря.‡Savinia Lehrensang auf dem Argentumturnierplatz möchte, dass Ihr ihr 3 Stück Fleisch eines Nordmeerhais bringt.‡은빛십자군 마상시합 광장에 있는 사비나 로어송이 북해 상어 고기 3개를 가져다 달라고 했습니다.‡Savinia Romanza en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Savinia Romanza en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Savinia Chanterite, dans l\'Enceinte du tournoi d\'Argent, veut que vous lui apportiez 3 morceaux de Chair de requin de la mer Boréale.‡银色比武场的萨雯妮娅·慧歌想让你带给她3块北海鲨鱼肉。‡',
  }
},
[14119] = {
  {
    '‡Blank [PH]‡Blank [PH]‡‡Blank [PH]‡Blank [PH]‡Blank [PH]‡祖达萨之眼‡',
    nil,
    nil,
  }
},
[14136] = {
  {
    '‡Спасательная операция на море‡Rettungseinsatz auf See‡해상 구조‡Rescate en el mar‡Rescate en el mar‡Secours en mer‡海上救援‡海上救援',
    nil,
    '‡Гирана Окровавленная из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас убить 8 квалдиров-берсерков и 3 квалдиров-гарпунеров, напавших на "Огненный Ястреб".‡Girana die Blutgezeichnete auf dem Argentumturnierplatz möchte, dass Ihr 8 Berserker der Kvaldir und 3 Harpunierer der Kvaldir an Bord der Feuerfalke tötet.‡은빛십자군 마상시합 광장에 있는 피의 여전사 지라나가 불꽃매호에 올라타서 크발디르 광전사 8명과 크발디르 작살병 3명을 처치하라고 했습니다.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates 8 rabiosos Kvaldir y 3 arponeros Kvaldir a bordo del Halcón de Fuego.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates 8 rabiosos Kvaldir y 3 arponeros Kvaldir a bordo del Halcón de Fuego.‡Girana Premier-sang, de l\'Enceinte du tournoi d\'Argent, veut que vous tuiez 8 Berserkers kvaldirs et 3 Harponneurs kvaldirs à bord du Faucon-de-feu.‡银色比武场的身经百战的吉莱娜要你在炎鹰号上消灭8名克瓦迪尔狂暴者和3名克瓦迪尔持戟者。‡',
  }
},
[14140] = {
  {
    '‡Остановить нападение‡Einhalt den Aggressoren‡침략자를 저지하라‡Detén a los agresores‡Detén a los agresores‡Arrêter les agresseurs‡抗击侵略者‡阻止侵略者',
    nil,
    '‡Гирана Окровавленная с Ристалища Серебряного турнира просит вас убить 10 квалдиров.‡Girana die Blutgezeichnete auf dem Argentumturnierplatz möchte, dass Ihr 10 Kvaldir tötet.‡은빛십자군 마상시합 광장에 있는 피의 여전사 지라나가 크발디르 10명을 처치해 달라고 했습니다.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Girana la Ensangrentada en los Campos del Torneo Argenta quiere que mates a 10 Kvaldir.‡Girana Premier-sang, de l\'Enceinte du tournoi d\'Argent, veut que vous tuiez 10 Kvaldirs.‡‡',
  }
},
[14141] = {
  {
    '‡Гормоку нужны снобольды‡Gormok will seine Schneebolde‡스노볼트를 찾는 고르목‡Gormok quiere sus snóbolds‡Gormok quiere sus snóbolds‡Gormok veut ses frigbolds !‡戈莫克想要他的狗头人‡戈莫克要他的極地狗頭人',
    nil,
    '‡Воспользуйтесь утяжеленной сетью, чтобы поймать 8 последователей с Холмов Снежной Слепоты, и приведите их Тайлосу Вестнику Зари в шатер Орды на Ристалище Серебряного турнира.‡Fangt mithilfe des beschwerten Netzes 8 schneeblinde Anhänger und bringt sie zu Tylos Dämmerflucht auf dem Argentumturnierplatz.‡무거운 그물로 설맹의 추종자 8마리를 붙잡아 은빛십자군 마상시합 광장에 있는 틸로스 돈러너에게 가져가야 합니다.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Tylos Correalba, en los Campos del Torneo Argenta.‡Usa la atarraya para capturar 8 seguidores Veloneve y llévaselos a Tylos Correalba, en los Campos del Torneo Argenta.‡Servez-vous du Filet lesté pour capturer 8 Suivants Brûleglace, et remettez-les à Tylos Coursaurore, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[14142] = {
  {
    '‡На этот раз ты нарвался, Кул‡Diesmal habt Ihr Euch wirklich selbst übertroffen, Kul‡제대로 한 건 했군, 쿨‡Esta vez la has liado, Kul‡Esta vez la has liado, Kul‡Oh bravo, Kul !!!‡这次你真的做到了，库尔‡庫爾，看看你這次幹得好事',
    nil,
    '‡Спасите Кула Безрассудного и 4 пленных претендентов с Заставы Вестника Смерти и вернитесь к Гиране Окровавленной на Ристалище Серебряного турнира.‡Rettet Kul den Tollkühnen und 4 gefangene Streiter aus Todessprechers Wacht und kehrt dann zu Girana der Blutgezeichneten auf dem Argentumturnierplatz zurück.‡못 말리는 쿨과 사로잡힌 지원자 4명을 죽음예언자 감시초소에서 구한 다음 은빛십자군 마상시합 광장에 있는 피의 여전사 지라나에게 가야 합니다.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Girana la Ensangrentada a los Campos del Torneo Argenta.‡Rescata a Kul el Temerario y a 4 aspirantes cautivos de la Avanzada del Portavoz de la Muerte y vuelve a ver a Girana la Ensangrentada a los Campos del Torneo Argenta.‡Sauvez Kul le Téméraire et 4 Aspirants captifs du Guet du nécrorateur. Lorsque ce sera fait, retournez voir Girana Premier-sang dans l\'Enceinte du tournoi d\'Argent.‡在亡语者岗哨援救鲁莽的库尔和4名被俘虏的候选者，然后返回银色比武场，去见身经百战的吉莱娜。‡',
  }
},
[14143] = {
  {
    '‡Лапами кверху‡Legt mal ein Bein zu‡다리 지원‡Por patas‡Por patas‡Comment retomber sur ses pattes…‡一腿之力‡被劫的腿肉補給',
    nil,
    '‡Верните 10 украденных окорочков долгонога Гиране Окровавленной из Павильона Похитителей Солнца на Ристалище Серебряного турнира.‡Beschafft 10 gestohlene Weitschreiterbeine zurück und bringt sie zu Girana der Blutgezeichneten auf dem Argentumturnierplatz.‡도난당한 타조 다리 10개를 되찾아 은빛십자군 마상시합 광장에 있는피의 여전사 지라나에게 가져가야 합니다.‡Recupera 10 patas de zancaalta robadas para Girana la Ensangrentada en los Campos del Torneo Argenta.‡Recupera 10 patas de zancaalta robadas para Girana la Ensangrentada en los Campos del Torneo Argenta.‡Récupérer 10 Pilons de haut-trotteur volés pour Girana Premier-sang, dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[14144] = {
  {
    '‡Милосердие Света‡Die Barmherzigkeit des Lichts‡빛의 자비‡La piedad de la Luz‡La piedad de la Luz‡La miséricorde de la Lumière‡圣光的仁慈‡聖光的憐憫',
    nil,
    '‡Воспользуйтесь Молитвенником исповедницы для проведения последнего обряда над телами 8 убитых туаликов, после чего вернитесь к Гиране Окровавленной в шатер Орды на Ристалище Серебряного турнира.‡Benutzt das Gebetsbuch der Beichtpatin, um 8 erschlagenen Tualiq-Bewohnern ihre Sterbesakramente zu lesen, und kehrt dann zu Girana der Blutgezeichneten auf dem Argentumturnierplatz zurück.‡고해사제의 기도서를 사용하여 살해된 투알리크 주민 8명에게 종부성사를 해 주고 은빛십자군 마상시합 광장에 있는 피의 여전사 지라나에게 돌아와야 합니다.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Girana la Ensangrentada en los Campos del Torneo Argenta.‡Usa el libro de oraciones de la confesora para dar la extremaunción a 8 habitantes Tualiq asesinados y después vuelve a ver a Girana la Ensangrentada en los Campos del Torneo Argenta.‡Utilisez le Livre de prière du confesseur pour célébrer les derniers sacrements sur 8 Villageois tualiq morts, puis retournez voir Girana Premier-sang dans l\'Enceinte du tournoi d\'Argent.‡‡',
  }
},
[14145] = {
  {
    '‡Кстати, чем питаются йети?‡Was fressen eigentlich Yetis?‡설인에게는 뭘 먹이세요?‡¿Y qué comen los yetis?‡¿Y qué comen los yetis?‡Ça mange quoi, un yéti, d\'abord?‡你们到底喂雪人吃什么？‡雪人到底該吃什麼？',
    nil,
    '‡Тайлос Вестник Зари из Павильона Похитителей Солнца на Ристалище Серебряного турнира просит вас принести ему 3 куска мяса акулы Северного моря.‡Tylos Dämmerflucht auf dem Argentumturnierplatz möchte, dass Ihr ihm 3 Stück Fleisch eines Nordmeerhais bringt.‡은빛십자군 마상시합 광장에 있는 틸로스 돈러너가 북해 상어 고기 3개를 가져다 달라고 했습니다.‡Tylos Correalba en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Tylos Correalba en los Campos del Torneo Argenta quiere que le lleves 3 trozos de carne de tiburón de El Mar del Norte.‡Tylos Coursaurore, dans l\'Enceinte du tournoi d\'Argent, veut que vous lui apportiez 3 morceaux de Chair de requin de la mer Boréale.‡银色比武场的泰罗斯·晨行者想让你带给她3块北海鲨鱼肉。‡',
  }
},
