[11864] = {
  {
    'Instrução de uma missão‡Вступление‡Eine Missionsrichtlinie‡임무 서약‡Objetivos de una misión‡Objetivos de una misión‡Exposé de mission‡决战奈辛瓦里‡任務聲明',
    nil,
    nil,
  }
},
[11865] = {
  {
    'A morte é pouco‡Им рано умирать‡Des Todes unwürdig‡죽음조차 아까운 자‡No se merecen la muerte‡No se merecen la muerte‡Indignes de mourir‡死不足惜‡不宜死亡',
    nil,
    'Zazá no Acampamento da DruiPA, que fica na Tundra Boreana, quer que você use a Pilha de Peles Falsas para prender 8 Coureadores de Rosarães.‡Используйте охапку искусственных шкур, чтобы поймать в ловушки 8 звероловов Эрнестуэя по просьбе Зазы из лагеря Д.Э.Г.О.Ж. в Борейской тундре.‡Zaza im Lager der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr den Haufen Kunstpelze dazu verwendet, um 8 von Nesingwarys Fallenstellern in die Falle zu locken.‡북풍의 땅에 있는 동물보호협회 야영지의 자자가 인조모피 무더기를 사용해 네싱워리 덫사냥꾼 8명을 처치해 달라고 부탁했습니다.‡Zaza en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que utilices el montón de pellejos falsos para tender una trampa a 8 tramperos de Nesingwary.|n‡Zaza en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que utilices el montón de pellejos falsos para tender una trampa a 8 tramperos de Nesingwary.|n‡Zaza, au Campement de la SdPA dans la Toundra Boréenne, vous demande d\'utiliser la Pile de fausses fourrures pour piéger 8 Trappeurs de Nesingwary.‡仁德会营地的扎扎要求你使用一堆人造皮毛抓捕8名奈辛瓦里猎户。‡北風凍原，D.E.H.T.A.駐營的札扎要你使用一堆假毛皮使8個奈辛瓦里陷捕者落入陷阱。',
  }
},
[11866] = {
  {
    'Faça-os ouvir!‡Уши мертвых врагов‡Die Ohren unserer Feinde‡용서할 수 없는 적‡Las orejas de nuestros enemigos‡Las orejas de nuestros enemigos‡Les oreilles de nos ennemis‡敌人的耳环‡吾敵之耳',
    nil,
    'Arquidruida Lathorius no Acampamento da DruiPA, que fica na Tundra Boreana, disse que recompensará quem trouxer 15 Orelhas de Lacaios de Rosarães.‡Принесите верховному друиду Латориусу из лагеря Д.Э.Г.О.Ж. в Борейской тундре 15 ушей прихвостней Эрнестуэя и получите награду.‡Erzdruide Lathorius im Lager der D.E.H.T.A. in der boreanischen Tundra hat gesagt, dass er Euch belohnen wird, wenn Ihr ihm 15 Ohren von Nesingwarys Lakaien bringt.‡북풍의 땅에 있는 동물보호협회 야영지의 대드루이드 라소리우스가 네싱워리 추종자의 귀걸이 15개를 가져와 달라고 했습니다.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal ha dicho que te recompensará si le traes 15 orejas de lacayo de Nesingwary.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal ha dicho que te recompensará si le traes 15 orejas de lacayo de Nesingwary.‡L\'Archidruide Lathorius au Campement de la SdPA dans la Toundra Boréenne vous a promis une récompense si vous lui apportez 15 Oreilles de laquais de Nesingwary.‡仁德会营地的大德鲁伊拉索留斯许诺，若你能带回15只奈辛瓦里同党的耳环，他就会给予你丰厚的奖赏。‡北風凍原，D.E.H.T.A.駐營的大德魯伊拉索利厄思說，如果你可以帶15個奈辛瓦里僕人之耳給他，他將會獎勵你。',
  }
},
[11867] = {
  {
    'Não vão me ouvir reclamar!‡Коллекция ушей‡Spitzt die Ohren‡그래도 용서할 수 없는 적‡No tenemos suficientes orejas...‡No tenemos suficientes orejas...‡Des oreilles en boucle…‡更多耳环……‡耳朵，永遠都不夠……',
    nil,
    'Arquidruida Lathorius no Acampamento da DruiPA, que fica na Tundra Boreana, disse que recompensará quem trouxer 15 Orelhas de Lacaio de Rosarães.‡Принесите верховному друиду Латориусу из лагеря Д.Э.Г.О.Ж. в Борейской тундре 15 ушей прихвостней Эрнестуэя и получите награду.‡Erzdruide Lathorius im Lager der D.E.H.T.A. in der boreanischen Tundra hat gesagt, dass er Euch belohnen wird, wenn Ihr ihm 15 Ohren von Nesingwarys Lakaien bringt.‡북풍의 땅에 있는 동물보호협회 야영지의 대드루이드 라소리우스가 네싱워리 추종자의 귀걸이 15개를 가져와 달라고 했습니다.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal ha dicho que te recompensará si le traes 15 orejas de lacayo de Nesingwary.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal ha dicho que te recompensará si le traes 15 orejas de lacayo de Nesingwary.‡L\'Archidruide Lathorius à l\'Avant-poste de la SdPA dans la Toundra Boréenne vous a promis une récompense si vous lui apportez 15 Oreilles de laquais de Nesingwary.‡仁德会营地的大德鲁伊拉索留斯许诺，若你能带回15只奈辛瓦里同党的耳环，他就会给予你丰厚的奖赏。‡北風凍原D.E.H.T.A.前哨的大德魯伊拉索利厄思提到如果你可以帶15個奈辛瓦里僕人之耳給他，他將會獎勵你。',
  }
},
[11868] = {
  {
    'Eis que vem a Abatedora‡Сортировщица грядет!‡Die Schlächterin wird kommen‡학살자 처단‡La llegada de la Asesina‡La llegada de la Asesina‡La Sélectionneuse arrive‡驯鹿杀手之死‡挑選者來了',
    nil,
    'Zazá no Acampamento da DruiPA, que fica na Tundra Boreana, quer que você mate Karen, a Abatedora.‡По заданию Заза из лагеря Д.Э.Г.О.Ж. в Борейской тундре убейте Карину Сортировщицу.‡Zaza im Lager der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr Karen die Schlächterin tötet.‡북풍의 땅에 있는 동물보호협회 야영지의 자자가 도살꾼 카렌을 처치해 달라고 부탁했습니다.‡Zaza en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Karen la Asesina de Caribús.‡Zaza en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Karen la Asesina de Caribús.‡Zaza, au Campement de la SdPA dans la Toundra Boréenne, vous demande de tuer Karen la Sélectionneuse.‡仁德会营地的扎扎要求你除掉驯鹿杀手卡琳。‡北風凍原，D.E.H.T.A.駐營的札扎要你去殺了『挑選者』凱倫。',
  }
},
[11869] = {
  {
    'Feliz feito um marisco‡Судьба моллюсков‡Glücklich wie eine Turnmuschel‡조개의 행복‡Cada almeja con su pareja‡Cada almeja con su pareja‡« À la pêche aux palourdes, ils n\'iront plus maman »‡欢乐的蚌壳‡跟蚌殼一樣開心',
    nil,
    'A Hierofante Cenius no Acampamento da DruiPA, que fica na Tundra Boreana, quer que você mate 10 Mergulhadores Ávidos por Despojos.‡По заданию иерофанта Сениуса из лагеря Д.Э.Г.О.Ж. в Борейской тундре убейте 10 загребущих ныряльщиков.‡Hierophant Cenius im Lager der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr 10 beutegierige Taucher tötet.‡북풍의 땅에 있는 동물보호협회 야영지의 제사장 세니우스가 광기어린 잠수부 10명을 처치해 달라고 부탁했습니다.‡La hierofante Cenius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a 10 buzos enloquecidos despojadores.‡La hierofante Cenius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a 10 buzos enloquecidos despojadores.‡La Hiérophante Cénius, du Campement de la SdPA dans la Toundra Boréenne, veut que vous tuiez 10 Plongeurs fous de butin.‡仁德会营地的圣职者塞妮丝要求你杀死10名利欲熏心的潜水员。‡北風凍原，D.E.H.T.A.駐營的祭師賽紐斯要你去殺掉10個掠寶狂潛水者。',
  }
},
[11870] = {
  {
    'Confins Abandonados‡Покинутый предел‡Die verlassenen Weiten‡버려진 해안‡El Tramo Abandonado‡El Tramo Abandonado‡Les confins Abandonnés‡遗弃海岸‡被遺棄之境',
    nil,
    'Encontre a Hierofante Liandra, nos Confins Abandonados.‡Найдите иерофанта Лиандру в Покинутом пределе.‡Sucht Hierophantin Liandra in den verlassenen Weiten auf.‡버려진 해안에서 제사장 리안드라를 찾아야 합니다.‡Busca a la hierofante Liandra en El Tramo Abandonado.‡Busca a la hierofante Liandra en El Tramo Abandonado.‡Allez voir la Hiérophante Liandra aux Confins Abandonnés.‡前往遗弃海岸，寻找圣职者莉安德拉。‡找到被遺棄之境的祭師利安卓。',
  }
},
[11871] = {
  {
    'Não na nossa vigília‡Пока мы на страже‡Nicht, solange wir Wache halten‡눈 뜨고 못 볼 일‡No bajo nuestra vigilancia‡No durante nuestra guardia‡Pas de ça chez nous‡不可容忍‡在我們的看守下，想都別想',
    nil,
    'A Hierofante Liandra, nos Confins Abandonados da Tundra Boreana, quer que você recupere 12 Carregamentos de Pedaços de Animais.‡Добудьте 12 партий частей тел животных по просьбе иерофанта Лиандры из Покинутого предела в Борейской тундре.‡Hierophantin Liandra in den verlassenen Weiten in der boreanischen Tundra möchte, dass ihr 12 Lieferungen von Tierteilen beschafft.‡북풍의 땅에 있는 버려진 해안의 제사장 리안드라가 동물 부산물이 담긴 뱃짐 12개를 회수해 달라고 부탁했습니다.‡La hierofante Liandra en El Tramo Abandonado en la Tundra Boreal quiere que recuperes 12 envíos de piezas de animales.‡La hierofante Liandra en El Tramo Abandonado en la Tundra Boreal quiere que recuperes 12 envíos de piezas de animales.‡La Hiérophante Liandra, des Confins Abandonnés de la Toundra Boréenne, veut que vous récupériez 12 Cargaisons de morceaux d’animaux.‡遗弃海岸的圣职者莉安德拉要求你找回12个动物杂货箱。‡北風凍原，被遺棄之境的祭師利安卓要你去取得12箱的動物肢體。',
  }
},
[11872] = {
  {
    'O nefário senhor dos mariscos...‡Гнусный специалист по моллюскам‡Der ruchlose Käpt\'n...‡사악한 조개왕‡El villano maestro de almejas...‡El villano maestro de almejas...‡Le sinistre maître des palourdes…‡罪恶的蛤蜊主宰……‡惡劣的蚌殼大師',
    nil,
    'Mate o Senhor dos Mariscos K e fale com a Hierofante Cenius no Acampamento da DruiPA.‡Убейте специалиста по моллюскам К и возвращайтесь к иерофанту Сениус в лагерь Д.Э.Г.О.Ж.‡Erschlagt Käpt\'n I. Glu, kehrt anschließend ins Lager der D.E.H.T.A. zurück und sprecht mit Hierophantin Cenius.‡조개왕 K를 제거하고 동물보호협회 야영지의 제사장 세니우스에게 돌아가야 합니다.‡Mata al maestro de almejas K y vuelve con la hierofante Cenius en el Campamento D.E.H.T.A.|n‡Mata al maestro de almejas K y vuelve con la hierofante Cenius en el Campamento D.E.H.T.A.|n‡Tuez le Maître des palourdes K puis retournez auprès de la Hiérophante Cénius au Campement de la SdPA.‡杀死蛤蜊主宰老K，然后向仁德会营地的圣职者塞妮丝复命。‡殺了蚌殼大師凱並回到D.E.H.T.A.駐營找祭師賽紐斯。',
  }
},
[11873] = {
  {
    'Notícias ao Biela‡Новости для Выкрутеня‡Teilt Kurbelzisch die Neuigkeiten mit‡피즈크랭크에게 소식 전하기‡Dale la noticia a Palanqueta‡Dale la noticia a Palanqueta‡Informez Spumelevier‡通知菲兹兰克‡傳遞消息給嘶軸',
    nil,
    'Volte para a Pista de Pouso do Biela e fale com o Biela Velotroll.‡Вернитесь на взлетную полосу Выкрутеня и поговорите с Выкрутенем Разгоняйло.‡Begebt Euch zurück zur Landebahn Kurbelzisch und sprecht mit Kurbelzisch Vollgas.‡피즈크랭크 비행장으로 돌아가 피즈크랭크 풀스로틀과 대화해야 합니다.‡Ábrete camino hasta la Pista de Aterrizaje de Palanqueta y habla con Palanqueta Todogás.‡Ábrete camino hasta la Pista de Aterrizaje de Palanqueta y habla con Palanqueta Todogás.‡Partez pour la Piste d\'atterrissage de Spumelevier et parlez à Spumelevier Pleingaz.‡回到菲兹兰克机场，与菲兹兰克·铁阀谈一谈。‡回到嘶軸簡易機場並與嘶軸·滿閥談談。',
  }
},
[11874] = {
  {
    '‡Upper Deck Promo – Верховая ракета‡Upper Deck Promo - Reitrakete‡카드매니아 - 로켓 탈것‡Upper Deck Promo - Rocket Mount‡Upper Deck Promo - Rocket Mount‡Promo Upper Deck - Monture fusée‡Upper Deck Promo - Rocket Mount‡',
    nil,
    nil,
  }
},
[11875] = {
  {
    'Tomando a dianteira‡Обретение преимущества‡Einen Vorteil gewinnen‡공격대 지원‡Lograr ventaja‡Lograr ventaja‡Prendre l\'avantage‡占据上风‡取得優勢',
    nil,
    'Leve 8 Resíduos de Éter ao Emissário Mordin em Shattrath.‡Принесите 8 горстей пыли Пустоты эмиссару Мордину в Шаттрат.‡Bringt dem Abgesandten Mordin in Shattrath 8 Netherrückstände.‡샤트라스에 있는 사절 모르딘에게 황천의 잔류물 8개를 가져가야 합니다.‡Llévale 8 residuos abisales al emisario Mordin en la Ciudad de Shattrath.‡Llévale 8 residuos abisales al emisario Mordin en la Ciudad de Shattrath.‡Apportez 8 Résidus de Néant à l\'Émissaire Mordin, à Shattrath.‡给沙塔斯城的摩尔丁特使带去8份虚空残渣。‡將8個虛空殘渣交給撒塔斯城中的大使莫爾丁。',
  }
},
[11876] = {
  {
    'Ajude quem não pode se ajudar‡Помоги тем, кто не может помочь себе сам‡Hilfe für die Hilflosen‡무력한 존재에게 도움의 손길을‡Ayuda a aquellos que no pueden valerse por sí mismos‡Ayuda a aquellos que no pueden valerse por sí mismos‡Aidez ceux qui ne peuvent pas s\'aider eux-mêmes‡帮助弱小‡幫助那些無力自救者',
    nil,
    'Arquidruida Lathorius no Acampamento da DruiPA, que fica na Tundra Boreana, quer que você use a Esmagadora de Armadilhas da DruiPA para libertar 8 Filhotes de Mamute.‡По заданию верховного друида Латориуса в лагере Д.Э.Г.О.Ж. в Борейской тундре освободите 8 мамонтят с помощью уничтожителя ловушек Д.Э.Г.О.Ж.‡Erzdruide Lathorius im Lager der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr mithilfe des Fallenzerstörers der D.E.H.T.A. 8 Mammutkälber befreit.‡북풍의 땅에 있는 동물보호협회 야영지의 대드루이드 라소리우스가 동물보호협회 덫 분쇄기를 사용해 매머드 새끼 8마리를 풀어달라고 부탁했습니다.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que utilices el aplasta trampas de D.E.H.T.A. para liberar a 8 crías de mamut.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que utilices el aplasta trampas de D.E.H.T.A. para liberar a 8 crías de mamut.‡L’archidruide Lathorius, au Campement de la SdPA dans la Toundra Boréenne, veut que vous utilisiez l’Écrase-piège de la SdPA pour libérer 8 Jeunes mammouths.‡仁德会营地的大德鲁伊拉索留斯要求你使用陷阱破坏锤释放8只猛犸幼崽。‡大德魯伊拉索利厄思要你使用D.E.H.T.A.陷阱粉碎者去釋放8隻小長毛象。拉索利厄思就在北風凍原的D.E.H.T.A.駐營。',
  }
},
[11877] = {
  {
    'Plano de Ataque dos Solfúria‡План нападения клана Ярости Солнца‡Angriffspläne des Sonnenzorns‡성난태양 공격 계획서‡Planes de ataque Furia del Sol‡Planes de ataque Furia del Sol‡Les plans d\'attaque solfurie‡日怒攻击计划‡日怒攻擊計畫',
    nil,
    'Lorde Torvos, em Shattrath, quer que você obtenha o Plano de Ataque dos Solfúria.‡Лорд Торвос из Шаттрата хочет, чтобы вы захватили планы нападения клана Ярости Солнца.‡Lord Torvos in Shattrath möchte, dass Ihr die Angriffspläne des Sonnenzorns beschafft.‡샤트라스에 있는 토르보스 경에게 성난태양 공격 계획서를 가져가야 합니다.‡Lord Torvos en la Ciudad de Shattrath quiere que consigas los planes de ataque Furia del Sol.‡Lord Torvos en la Ciudad de Shattrath quiere que consigas los planes de ataque Furia del Sol.‡Le Seigneur Torvos, à Shattrath, veut que vous vous empariez des Plans d\'attaque solfurie.‡沙塔斯城的托沃斯男爵希望你能缴获日怒攻击计划。‡撒塔斯的托沃斯領主要你前去取得日怒攻擊計畫。',
  }
},
[11878] = {
  {
    'Khu\'nok saberá‡Ку\'нок обо всем позаботится!‡Khu\'nok wird\'s wissen‡쿠노크는 알고 있다‡Khu\'nok sabrá qué hacer‡Khu\'nok sabrá qué hacer‡Khu\'nok saura quoi faire‡库诺克的智慧‡庫諾克知道',
    nil,
    'Leve o Filhote Órfão de Mamute para Khu\'nok, o Beemote na Tundra Boreana.‡Отведите мамонтенока-сиротку к Ку\'ноку Чудовищу в Борейской тундре.‡Bringt das verwaiste Mammutkalb zu Khu\'nok dem Ungetüm in der boreanischen Tundra.‡새끼 고아 매머드를 북풍의 땅에 있는 거수 쿠노크에게 데려가야 합니다.‡Llévale la cría de mamut huérfana a Khu\'nok el Behemoth en la Tundra Boreal.‡Llévale la cría de mamut huérfana a Khu\'nok el Behemoth en la Tundra Boreal.‡Remettez le Jeune mammouth orphelin à Khu\'nok le Béhémoth, dans la Toundra Boréenne.‡将猛犸幼崽孤儿带到北风苔原的巨兽库诺克那里去。‡帶失怙的小長毛象去找北風凍原的『巨獸』庫諾克。',
  }
},
[11879] = {
  {
    'Kaw, o Destruidor de Mamutes‡Кау Гроза Мамонтов‡Kraa der Mammutvernichter‡매머드 학살자 카우‡Kaw el Destructor de Mamuts‡Kaw el Destructor de Mamuts‡Kaw le Destructeur de mammouths‡猛犸毁灭者卡奥‡『長毛象摧毀者』卡烏',
    nil,
    'Mate Kaw, o Destruidor de Mamutes e recupere a Alabarda de Guerra do Kaw. Entregue a Alabarda de guerra do Kaw para o Arquidruida Lathorius no Acampamento da DruiPA, que fica na Tundra Boreana.‡Убейте Кау Грозу Мамонтов и добудьте боевую алебарду Кау. Доставьте ее верховному друиду Латориусу в лагерь Д.Э.Г.О.Ж. в Борейской тундре.‡Tötet Kraa den Mammutvernichter und beschafft Euch Kraas Kriegshellebarde. Liefert Kraas Kriegshellebarde bei Erzdruide Lathorius im Lager der D.E.H.T.A. in der boreanischen Tundra ab.‡매머드 학살자 카우를 처치하고 카우의 전쟁 미늘창을 빼앗아, 북풍의 땅에 있는 동물보호협회 야영지의 대드루이드 라소리우스에게 가져가야 합니다.‡Mata a Kaw el Destructor de Mamuts y consigue la alabarda de guerra de Kaw. Llévasela al archidruida Lathorius del Campamento D.E.H.T.A. en la Tundra Boreal.‡Mata a Kaw el Destructor de Mamuts y consigue la alabarda de guerra de Kaw. Llévasela al archidruida Lathorius del Campamento D.E.H.T.A. en la Tundra Boreal.‡Tuez Kaw le Destructeur de mammouths et récupérez la Hallebarde de guerre de Kaw, puis apportez-la à l’Archidruide Lathorius au Campement de la SdPA dans la Toundra Boréenne.‡杀死猛犸毁灭者卡奥，并夺取卡奥的战戟。将卡奥的战戟带回北风苔原的仁德会营地，交给大德鲁伊拉索留斯。‡殺掉『長毛象摧毀者』卡烏並取得卡烏的戰戟。將卡烏的戰戟送到北風凍原的D.E.H.T.A.駐營交給大德魯伊拉索利厄思。',
  }
},
[11880] = {
  {
    'Sondagem multifásica‡Мультифазовый подход‡Die Multiphasen-Vermessung‡다상 소용돌이 조사‡La investigación multifase‡La investigación multifase‡L\'examen multiphase‡多相数据调查‡多相測量',
    nil,
    'O Precursor Haronem, em Shattrath, quer que você use os Óculos Espectrográficos Multifásicos para obter 6 Leituras Multifásicas.‡Предвестник Харонем из Шаттрата просит вас при помощи мультифазовых спектрографических очков 6 раз провести считывание мультифазовых данных.‡Herold Haronem in Shattrath möchte, dass Ihr die spektrografische Multiphasenbrille benutzt, um 6 Multiphasenmessungen durchzuführen.‡샤트라스에 있는 선구자 하로넴이 다상분광 고글을 사용해 다상 도수를 6번 측정해 오라고 했습니다.‡El presagista Haronem de la Ciudad de Shattrath quiere que uses las gafas espectrográficas multifase para obtener 6 lecturas multifase.‡El presagista Haronem de la Ciudad de Shattrath quiere que uses las gafas espectrográficas multifase para obtener 6 lecturas multifase.‡Le Messager Haronem, à Shattrath, veut que vous utilisiez les Lunettes spectrographiques multiphases pour prendre 6 Relevés multiphases.‡沙塔斯城的先驱者哈隆奈姆希望你使用多相光谱护目镜去获取6份多相数据。‡撒塔斯城的先驅者哈洛尼恩希望你使用多相光譜護目鏡來取得6個多相讀數。',
  }
},
[11881] = {
  {
    'Carreguem-na!‡Ценный груз‡Fertig zum Transport!‡가득 실어!‡¡Cárgala!‡¡Cárgala!‡Charge la mule !‡运货行动！‡帶回來!',
    nil,
    'Ajude a Geni a andar do local do acidente até Fazzix Girarroda na Aldeia Taunka\'le sem perder todo o carregamento.‡Помогите ослице Дженни добраться с места крушения к Феззиксу Штукельверту в деревню Таунка\'ле, не растеряв груз.‡Helft Jenny dabei, von der Absturzstelle bis nach Taunka\'le zu Fezzix Drehgang zu gelangen, ohne dabei ihre ganze Ladung zu verlieren.‡제니를 도와 추락 지점에서 타운카르 마을에 있는 페직스 기어 트위스트에게 안전하게 짐을 가져다주어야 합니다.‡Fezzix Girarrosca quiere que ayudes a Jenny a llegar desde el lugar del accidente hasta el Poblado Taunka\'le sin perder todo su cargamento.‡Fezzix Girarrosca quiere que ayudes a Jenny a llegar desde el lugar del accidente hasta el Poblado Taunka\'le sin perder todo su cargamento.‡Aidez Jenny à se rendre du site de l\'accident à Taunka\'le, où elle retrouvera Fezzix Torduvrille, sans perdre tout son chargement.‡帮助珍妮从坠毁点返回牦牛村的菲兹克斯·盖维斯特身边，并确保她驮载的货物完好无损。‡協助潔妮帶著她所有的貨物從失事地點抵達坦卡雷村的菲奇司·絞輪處。',
  }
},
[11882] = {
  {
    'Brincando com fogo‡Игра с огнем‡Spiel mit dem Feuer‡불장난‡Jugando con fuego‡Jugando con fuego‡Jouer avec le feu‡玩火‡玩火',
    nil,
    'Fale com um Mestre Engolidor de Fogo em qualquer capital da Aliança.‡Поговорите с мастером-огнеглотателем в любой из столиц Альянса.‡Sprecht mit einem Feuerschluckmeister in einer der Hauptstädte.‡얼라이언스 대도시에 있는 불꽃마술의 대가와 대화해야 합니다.‡Habla con un maestro tragafuegos en cualquiera de las capitales de la Alianza.‡Habla con un maestro tragafuegos en cualquiera de las capitales de la Alianza.‡Parlez à un Maître mangeur de feu dans n\'importe quelle capitale de l\'Alliance.‡与任意联盟主城的吞火大师谈一谈。‡跟任何一個聯盟主城的吞火者大師談談。',
  }
},
[11883] = {
  {
    'Dança do Fogo?‡Танцы с огнем?‡Feuertanzen?‡불춤?‡¿Danza con fuego?‡¿Danza con fuego?‡La danse de feu‡火焰的舞蹈？‡火舞?',
    nil,
    'Fale com uma Mestre Dançarina do Fogo em qualquer capital da Horda.‡Поговорите с мастером огненного танца в любой из столиц Орды.‡Sprecht mit einem Feuertanzmeister in einer der Hauptstädte.‡호드 주요 도시에 있는 불춤의 대가와 대화해야 합니다.‡Habla con un maestro de danza del fuego en cualquier capital de la Horda.‡Habla con un maestro de danza del fuego en cualquier capital de la Horda.‡Parlez à un Maître danseur de feu dans n\'importe quelle capitale de la Horde.‡与任意部落主城的火舞大师谈一谈。‡跟任一個何部落主城的火舞者大師談談。',
  }
},
[11884] = {
  {
    'Nedar, o Senhor dos Rinocerontes...‡Нед, "Повелитель люторогов"‡Ned, Herr der Rhinozerosse‡코뿔소 군주 네다르‡Ned, señor de rinocerontes...‡Ned, señor de rinocerontes...‡Ned, seigneur des rhinos…‡尼达尔，犀牛之王……‡犀牛王尼德…',
    nil,
    'Mortígero, o Vigia do Covil, no Acampamento da DruiPA, que fica na Tundra Boreana, quer que você mate Nedar, Senhor dos Rinocerontes, e sua mascote “Lancheira”.‡По заданию Киллинджера Смотрителя Логова из лагеря Д.Э.Г.О.Ж. в Борейской тундре убейте Недара, "Повелителя люторогов", и его спутника, люторога по кличке "Закуска".‡Killinger der Höhlenbehüter im Außenposten der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr Nedar, den Herrn der Rhinozerosse, und seinen Begleiter "Vesperhino" tötet.‡북풍의 땅에 있는 동물보호협회 야영지의 동굴보초 킬린저가 코뿔소 군주 네다르와, 그가 타고 다니는 "도시락"을 처치해 달라고 부탁했습니다.‡Kilinger el Vigía del Cubil en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Nedar, Señor de rinocerontes y a su compañero, "Fiambrera."‡Kilinger el Vigía del Cubil en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Nedar, señor de rinocerontes y a su compañero, "Fiambrera."‡Killinger le Garde-tanière, du Campement de la SdPA dans la Toundra Boréenne, veut que vous alliez tuer Nedar le Seigneur des rhinos et son compagnon « Musette ».‡仁德会营地的兽穴卫士凯林格要求你杀死“犀牛之王”尼达尔以及他的宠物“午餐盒”。‡『獸穴看守者』基林格爾要你去殺死『犀牛王』尼達爾和他的同伴『午餐盒』，完成之後再回到北風凍原的D.E.H.T.A.駐營向他回報。',
  }
},
[11885] = {
  {
    'Sangue adversário‡Кровные враги‡Feindesblut‡적의 피‡Sangre adversaria‡Sangre adversaria‡Lignées antagonistes‡仇敌的血脉‡敵人之血',
    nil,
    'Encontre as Pilhas de Crânios no meio dos círculos de evocação em Skettis. Evoque e derrote cada um dos descendentes usando 10 Pergaminhos do tempo perdido na Pilha de Crânios. Fale novamente com Hazzik no Campo de Pouso Ventonegro.‡Найдите груды черепов в середине кругов призыва Скеттиса. С помощью 10 свитков затерянных во времени призовите каждого потомка Скеттиса, уничтожьте их и отнесите трофеи Хаззику в лагерь Черного Ветра.‡Findet die Schädelhaufen innerhalb der Beschwörungskreise in Skettis. Beschwört die Nachfahren, indem Ihr 10 zeitverlorene Schriftrollen am Schädelhaufen benutzt und bezwingt sie. Kehrt mit einem Beweisstück von jedem zu Hazzik am Schattenwindlager zurück.‡스케티스에서 소환 마법진과 해골더미를 찾은 후, 잃어버린 시간의 두루마리 10개씩을 해골더미에 사용하여 자손들을 소환해야 합니다. 자손들을 처치하고 검은바람 비행기지에 있는 하지크에게 돌아가야 합니다.‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Vuelve a ver a Hazzik al Alto de los Vientonegro.‡Encuentra los montones de cráneos en el centro de los círculos de invocación de Skettis. Invoca y derrota a cada uno de los descendientes usando 10 Pergaminos perdidos en el Tiempo en el montón de cráneos. Vuelve a ver a Hazzik al Alto de los Vientonegro.‡Trouvez les Piles de crânes au milieu des cercles d\'invocation de Skettis. Invoquez et vainquez chacun des descendants des adversaires de Terokk en utilisant 10 Parchemins perdus dans le temps à la Pile de crâne. Retournez ensuite auprès de Hazzik au Raie\'odrome de Noirvent.‡在斯克提斯寻找召唤法阵中的徽记堆，用10张迷失卷轴召唤出一个泰罗克仇敌的后裔，并击败总共四个泰罗克仇敌的后裔。完成任务之后回去向黑风码头的哈吉克复命。‡在司凱堤斯的召喚法陣中央找到顱骨堆。在顱骨堆用10個時光流逝卷軸召喚並擊敗每個子嗣。回到黑風平臺找海茲克。',
  }
},
[11886] = {
  {
    'Atividade incomum‡Необычная активность‡Ungewöhnliche Aktivitäten‡이상한 활동‡Actividad sospechosa‡Actividad sospechosa‡Une activité inhabituelle‡反常的活动‡不尋常的活動',
    nil,
    'Vá para o novo Acampamento do Crepúsculo, ao sul da Entrada das Profundezas Negras, na Praia de Zoram - a qual fica no Vale Gris - e pegue a Correspondência do Crepúsculo dos sectários. Depois, convoque o Guia da Harmonia Telúrica usando a Lanterna Totêmica.‡Отправляйтесь в новый лагерь культа Сумеречного Молота к югу от входа в Непроглядную Пучину на Зорамском взморье, что в Ясеневом лесу, и добудьте сумеречную корреспонденцию, затем при помощи тотема-маяка свяжитесь с проводником из Служителей Земли.‡Geht zum Lager des Schattenhammers südlich des Eingangs zur Tiefschwarzen Grotte am Zoramstrand im Eschental und sucht nach Briefen des Schattenhammers. Die Kultisten werden sie voraussichtlich bei sich tragen. Benutzt anschließend das totemische Leuchtfeuer, um einen Führer des Irdenen Rings zu beschwören.‡잿빛 골짜기의 조람 해안, 검은심연의 나락의 남쪽에 있는 새로운 황혼의 야영지로 가서, 신도들에게서 암호화된 황혼의 서신을 입수한 후 신호 토템을 사용하여 속세의 고리회 인도자를 소환해야 합니다.‡Ve hasta el nuevo Campamento Crepúsculo al sur de la entrada a las Cavernas de Brazanegra en La Ensenada de Zoram de Vallefresno y recupera la correspondencia Crepuscular de los cultores. Después, pide la ayuda del guía Anillo de la Tierra mediante la baliza totémica.‡Ve hasta el nuevo Campamento Crepuscular, al sur de la entrada a las Cavernas de Brazanegra en La Ensenada de Zoram de Vallefresno, y recupera la correspondencia Crepuscular de los cultores. Después, invoca al guía del Anillo de la Tierra mediante la baliza totémica.‡Rendez-vous au nouveau Camp du Crépuscule, au sud de l\'entrée des Profondeurs de Brassenoire sur la grève de Zoram, dans Orneval, et récupérez la Correspondance du crépuscule sur les sectateurs. Puis appelez le Guide du Cercle terrestre en utilisant la Balise totémique.‡前往灰谷的佐拉姆海岸，在黑暗深渊入口以南寻找新建的暮光营地，从该处的暮光教徒身上搜寻暮光信件，然后使用图腾信标召唤大地之环幽灵狼。‡前往位於梣谷，佐拉姆海岸的黑暗深淵入口南邊新成立的暮光營地。為陶土議會找出答案，然後使用圖騰信號召喚陶土議會嚮導。',
  }
},
[11887] = {
  {
    'Equipamentos de emergência‡Неприкосновенный запас‡Notrationen‡긴급 보급품‡Suministros de emergencia‡Suministros de emergencia‡Fournitures d\'urgence‡应急的物资‡緊急補給',
    nil,
    'Consiga 7 Equipamentos de Emergência Gnômicos dos corpos dos Pilotos de Reconhecimento do Biela e leve-os para Fazzix Girarroda na Aldeia Taunka\'le.‡Соберите 7 гномских ремонтных наборов с тел погибших пилотов-разведчиков со станции Выкрутеня и принесите их Феззиксу Штукельверту в деревню Таунка\'ле.‡Sammelt 7 gnomische Notfallwerkzeugkästen und bringt sie zu Fezzix Drehgang in Taunka\'le. Die Kästen findet Ihr bei den Leichen abgestürzter Aufklärungspiloten von Kurbelzisch.‡추락한 피즈크랭크 정찰대 조종사 시체에서 노움 비상 도구함 7개를 모아 타운카르 마을에 있는 페직스 기어트위스트에게 가져가야 합니다.‡Consigue 7 equipos de emergencia gnomos de los cuerpos de los pilotos de reconocimiento de Palanqueta estrellados y llévaselos a Fezzix Girarrosca al Poblado Taunka\'le.‡Consigue 7 equipos de emergencia gnomos de los cuerpos de los pilotos de reconocimiento de Palanqueta estrellados y llévaselos a Fezzix Girarrosca al Poblado Taunka\'le.‡Ramassez 7 Trousses d\'urgence gnomes sur les corps de Pilotes de reconnaissance de Spumelevier accidentés et apportez-les à Fezzix Torduvrille à Taunka\'le.‡从坠机的菲兹兰克侦察机飞行员尸体上收集7个侏儒应急工具包，将它们交给牦牛村的菲兹克斯·盖维斯特。‡從墜毀的嘶軸偵查駕駛員的屍體上收集7個地精緊急工具箱。然後帶給坦卡雷村的菲奇司·絞輪。',
  }
},
[11888] = {
  {
    'Viagem à Aldeia Taunka\'le‡Поездка в деревню Таунка\'ле‡Reitet nach Taunka\'le‡타운카르 마을로‡Vuela al Poblado Taunka\'le‡Vuela al Poblado Taunka\'le‡Chevaucher jusqu’à Taunka’le‡前往牦牛村‡前往坦卡雷村',
    nil,
    'Fale com o Sábio Terra e Céu na Aldeia Taunka\'le.‡Поговорите с ведуном земли и неба в деревне Таунка\'ле.‡Sprecht mit Weiser Erde und Himmel in Taunka\'le.‡타운카르 마을에 있는 현자 하늘땅과 대화해야 합니다.‡Habla con el sabio Tierra y Cielo en el Poblado Taunka\'le.‡Habla con el sabio Tierra y Cielo en el Poblado Taunka\'le.‡Parlez au Sage Terre-et-Ciel à Taunka’le.‡与北风苔原牦牛村的天空大地先知谈一谈。‡和坦卡雷村的賢者地空談談。',
  }
},
[11889] = {
  {
    'A morte vem de cima‡Смерть с небес‡Der Tod lauert in der Luft‡날아드는 죽음의 손길‡Muertos desde arriba‡La muerte cae desde el cielo‡La mort vient d\'en haut‡空中的虫子‡從天而降的死亡',
    nil,
    'Sargento Martelmonte quer que você use a Rede Reforçada para aprisionar e matar 6 Cospe-chamas Flagelados, fora da Bastilha Valentia.‡По поручению сержанта Молотогора убейте вне стен крепости Отваги 6 порабощенных Плетью изрыгателей огня с помощью укрепленной сети.‡Unteroffizier Hammerberg möchte, dass Ihr mithilfe des verstärkten Netzes 6 verseuchte Flammenspucker außerhalb der Valianzfeste tötet.‡하사관 해머힐이 강화 그물을 사용해 용맹의 성채 밖에 있는 스컬지 화염나방 6마리를 처치해 달라고 부탁했습니다.‡El sargento Colinamartillo quiere que utilices la red reforzada para ayudarte a matar a 6 escupefuegos plagados a las afueras de la Fortaleza Denuedo.‡El sargento Colinamartillo quiere que utilices la red reforzada para ayudarte a matar a 6 escupefuegos plagados a las afueras de la Fortaleza Denuedo.‡Le Sergent Martèlemont veut que vous utilisiez le Filet renforcé pour tuer 6 Cracheurs de flammes flaellés, à l\'extérieur du Donjon de la Bravoure.‡哈默希尔中士要你到无畏要塞外使用强化捕网捕捉并杀死6只天灾烈焰蛛。‡錘丘中士希望你使用強化織網來殺死6隻驍勇要塞外的天譴噴火者。',
  }
},
[11890] = {
  {
    'O que estão tramando?‡Что там с ними?‡Was haben sie vor?‡무슨 꿍꿍이속이지?‡¿Qué se traen entre manos?‡¿Qué se traen entre manos?‡Que préparent-ils ?‡他们想干什么？‡他們在搞什麼鬼?',
    nil,
    'Investigue a área nos arredores da Estação Bombeadora do Biela. Depois, fale novamente com o Sábio Terra e Céu, na Aldeia Taunka\'le.‡Исследуйте область вокруг насосной станции Выкрутеня, а затем возвращайтесь к ведуну земли и неба в деревню Таунка\'ле.‡Untersucht die Gegend um die Pumpstation Kurbelzisch herum. Kehrt anschließend wieder zum Weisen Erde und Himmel in Taunka\'le zurück.‡피즈크랭크 채굴 현장 주변을 조사한 다음 타운카르 마을에 있는 현자 하늘땅에게 돌아가야 합니다.‡Investiga la zona que rodea la Estación de Bombeo de Palanqueta. Después, vuelve a ver al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Investiga la zona que rodea la Estación de Bombeo de Palanqueta. Después, vuelve a ver al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Explorez la zone qui entoure la Station de pompage de Spumelevier. Ensuite, retournez voir le Sage Terre-et-Ciel à Taunka\'le.‡调查菲兹兰克泵站周围的区域，然后返回北风苔原的牦牛村，向天空大地先知汇报你的发现。‡調查嘶軸幫浦站四周的區域。然後向坦卡雷村的賢者地空回報。',
  }
},
[11891] = {
  {
    'Um disfarce inocente‡Невинный маскарад‡Eine unschuldige Verkleidung‡단순한 변장‡Un disfraz inofensivo‡Un disfraz inofensivo‡Un déguisement innocent‡人畜无害‡無辜的偽裝',
    nil,
    'Use o Orbe do Caranguejo para espionar o novo Acampamento do Crepúsculo a oeste da Entrada das Profundezas Negras na Praia de Zoram do Vale Gris. Depois, evoque o Guia da Harmonia Telúrica usando a Lanterna Totêmica.‡При помощи сферы Краба проникните в новый Сумеречный лагерь к западу от входа в Непроглядную Пучину на Зорамском взморье в Ясеневом лесу, затем вызовите проводника из Служителей Земли при помощи тотема-маяка.‡Benutzt die Krabbenkugel und spioniert das neue Lager des Schattenhammers aus. Es befindet sich westlich des Eingangs zur Tiefschwarzen Grotte auf dem Zoramstrand im Eschental. Benutzt anschließend das totemische Leuchtfeuer, um den Führer des Irdenen Rings zu beschwören.‡잿빛 골짜기의 조람 해안, 검은심연의 나락의 서쪽에 있는 새로운 황혼의 야영지로 가서 딸각게의 수정구를 사용하여 대화를 엿듣고, 신호 토템을 사용하여 속세의 고리회 인도자를 소환해야 합니다.‡Utiliza el orbe del reptador para espiar en el nuevo Campamento Crepuscular al oeste de la entrada de las Cavernas de Brazanegra en La Ensenada de Zoram en Vallefresno, luego invoca al guía del Anillo de la Tierra usando la baliza totémica.‡Utiliza el orbe del reptador para espiar en el nuevo Campamento Crepúsculo al oeste de la entrada de las Cavernas de Brazanegra en La Ensenada de Zoram en Vallefresno.‡Servez-vous de l\'Orbe du clampant pour espionner le nouveau camp du Crépuscule, à l\'ouest des Profondeurs de Brassenoire, sur la grève de Zoram, en Orneval. Ensuite, invoquez le Guide du Cercle terrestre à l\'aide de la Balise totémique.‡在灰谷佐拉姆海岸的黑暗深渊入口以西寻找新建的暮光营地，使用螃蟹宝珠打探情报，然后使用图腾信标召唤大地之环幽灵狼。‡使用爬行者寶珠去刺探位於梣谷，佐拉姆海岸的黑暗深淵西邊新成立的暮光營地。然後使用圖騰信號召喚陶土議會嚮導。',
  }
},
[11892] = {
  {
    'O assassinato de Manuelzão‡Убить Гарольда Лейна!‡Die Ermordung von Harold Fährten‡해럴드 레인 암살‡El asesinato de Harold Sendero‡El asesinato de Harold Sendero‡L\'assassinat de Harold Lane‡刺杀哈罗德·兰恩‡刺殺哈洛德·蘭恩',
    nil,
    'O Arquidruida Lathorius no Posto Avançado da DruiPA, que fica na Tundra Boreana, quer que você mate Manuelzão.‡По поручению верховного друида Латориуса из лагеря Д.Э.Г.О.Ж. в Борейской тундре убейте Гарольда Лейна.‡Erzdruide Lathorius im Lager der D.E.H.T.A. in der boreanischen Tundra möchte, dass Ihr Harold Fährten tötet.‡북풍의 땅에 있는 동물보호협회 야영지의 대드루이드 라소리우스가 해럴드 레인을 처치해 달라고 부탁했습니다.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Harold Sendero.‡El archidruida Lathorius en el Campamento D.E.H.T.A. en la Tundra Boreal quiere que mates a Harold Sendero.‡L’archidruide Lathorius à l’Avant-poste de la SdPA dans la Toundra Boréenne veut que vous tuiez Harold Lane.‡仁德会营地的大德鲁伊拉索留斯要求你杀死哈罗德·兰恩。‡大德魯伊拉索利厄思要你殺掉哈洛德·蘭恩，拉索利厄思就在北風凍原的D.E.H.T.A.前哨。',
  }
},
[11893] = {
  {
    'O poder dos elementos‡Сила стихий‡Die Macht der Elemente‡정령의 힘‡El poder de los elementos‡El poder de los elementos‡La puissance des éléments‡元素的力量‡元素的力量',
    nil,
    'Dorain Casco Gélido, na Aldeia Taunka\'le, quer que você use o Totem Almeólico para obter a energia de 10 Coléricos Vaporíferos.‡Дорейн Морозное Копыто из деревни Таунка\'ле просит вас использовать тотем духа ветра, чтобы собрать энергию 10 паровых яростней.‡Dorain Frosthuf in Taunka\'le möchte, dass Ihr mithilfe des Totems der Windseele die Energie von 10 Dampfwütern sammelt.‡타운카르 마을에 있는 도레인 프로스트후프가 바람영혼 토템을 사용해 분노한 증기 정령 10마리의 기운을 모아 달라고 부탁했습니다.‡Dorain Pezuña Helada en el Poblado Taunka\'le quiere que utilices el tótem alma de viento para reunir la energía de 10 furibundos de vapor.‡Dorain Pezuña Helada en el Poblado Taunka\'le quiere que utilices el tótem alma de viento para reunir la energía de 10 furibundos de vapor.‡Dorain Sabot-de-givre, de Taunka\'le, vous demande d\'utiliser le Totem âmevent pour emmagasiner l\'énergie de 10 Enragés de vapeur.‡牦牛村的多莱安·霜蹄要你利用风魂图腾收集10只蒸汽狂怒者的能量。‡坦卡雷村的杜然·霜蹄希望你使用風魂圖用收集10個蒸汽狂怒者的能量。',
  }
},
[11894] = {
  {
    'Remendando‡Заплатки‡Zusammenflicken‡땜질 작업‡Yo lo remendaba, yo lo remendé‡Yo lo remendaba, yo lo remendé‡Quelques réparations‡修修补补‡拼湊貼補',
    nil,
    'Fazzix Girarroda, na Aldeia Taunka\'le, quer que você lhe traga 5 Pelegos Curtidos no Vapor.‡Принесите 5 пропаренных шкур Феззиксу Штукельверту в деревню Таунка\'ле.‡Fezzix Drehgang in Taunka\'le möchte, dass Ihr ihm 5 dampfgegerbte Bälge bringt.‡타운카르 마을에 있는 페직스 기어트위스트가 증기 처리한 가죽 5개를 가져와 달라고 부탁했습니다.‡Fezzix Girarrosca del Poblado Taunka\'le quiere que le lleves 5 cueros curados con vapor.‡Fezzix Girarrosca del Poblado Taunka\'le quiere que le lleves 5 cueros curados con vapor.‡Fezzix Torduvrille, à Taunka\'le, vous demande de lui apporter 5 Peaux traitées à la vapeur.‡牦牛村的菲兹克斯·盖维斯特要你给他带回5张蒸汽熟化鹿皮。‡坦卡雷村的菲奇司·絞輪要你帶給他5張蒸汽燻製皮。',
  }
},
[11895] = {
  {
    'Mestre da tormenta‡Одолеть бурю‡Bezwingt den Sturm‡폭풍의 지배자‡Domina a la tormenta‡Domina a la tormenta‡Maîtrisez l\'orage‡风暴的主宰‡駕馭風暴',
    nil,
    'Derrote a Tormenta da Tempestade e fale com o Sábio Terra e Céu na Aldeia Taunka\'le.‡Одолейте порыв шторма, затем возвращайтесь к ведуну земли и неба в деревне Таунка\'ле.‡Besiegt die Sturmbö und kehrt anschließend zum Weisen Erde und Himmel in Taunka\'le zurück.‡폭풍 바람을 처치하고 북풍의 땅에 있는 타운카르 마을에서 현자 하늘땅과 대화해야 합니다.‡Vence a la tempestad de tormenta y vuelve junto al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Vence a la tempestad tormentosa y vuelve junto al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Terrassez la Tempête d\'orage puis retournez voir le Sage Terre-et-Ciel à Taunka\'le.‡击败狂乱风暴，然后向北风苔原牦牛村的天空大地先知复命。‡擊敗狂亂風暴，然後回到坦卡雷村找賢者地空。',
  }
},
[11896] = {
  {
    'Suscetível à eletricidade‡Уязвимы для молний‡Eine Schwäche für Blitze‡번개 주의보‡Débiles ante el relámpago‡Débiles ante el relámpago‡Vulnérables à la foudre‡闪电的力量‡電擊弱點',
    nil,
    'Destrua 15 Unidades Robóticas, exceto gnomecânicos enquanto estiverem enfraquecidos pelo poder da tormenta nos arredores dos grandes poços, na Estação Bombeadora do Biela.|n|nDepois, fale novamente com o Sábio Terra e Céu na Aldeia Taunka\'le.‡Уничтожьте 15 любых роботов, кроме механогномов, ослабленных воздействием ярости шторма, в области прудов вокруг насосной станции Выкрутеня.|n|nПосле этого вернитесь к ведуну земли и неба в деревне Таунка\'ле.‡Zerstört 15 verschiedene Robotereinheiten im größeren Teichareal um die Pumpstation Kurbelzisch herum, während sie von der Macht des Sturms geschwächt sind. Ignoriert jedoch die Mechagnome.|n|nKehrt anschließend zu Weiser Erde und Himmel in Taunka\'le zurück.‡피즈크랭크 채굴 현장 주변에 있는 커다란 웅덩이에서 폭풍의 힘으로 기계노움을 제외하고 약해진 로봇 15대를 파괴해야 합니다.|n|n그런 다음 타운카르 마을에 있는 현자 하늘땅에게 돌아가야 합니다.‡Mientras estén debilitados por el Poder de la tormenta, destruye a 15 unidades robóticas, exceptuando a los mecagnomos, en la gran área de pozas que rodean la Estación de Bombeo de Palanqueta.|n|nDespués, vuelve junto al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Mientras estén debilitados por el Poder de la tormenta, destruye a 15 unidades robóticas, exceptuando a los mecagnomos, en la gran área de pozas que rodean la Estación de Bombeo de Palanqueta.|n|nDespués, vuelve junto al sabio Tierra y Cielo en el Poblado Taunka\'le.‡Détruisez 15 unités robotisées (mais pas de mécagnomes) affaiblies par la Puissance de l\'orage dans la zone des bassins qui entourent la Station de pompage de Spumelevier.|n|nEnsuite, retournez voir le Sage Terre-et-Ciel à Taunka\'le.‡利用风暴的力量削弱并摧毁15名机器人（不包括那些机械侏儒）。你可以在菲兹兰克泵站周围的池塘中找到它们。|n|n完成任务后回到北风苔原的牦牛村，向天空大地先知复命。‡當機器單位處於被風暴之力弱化的狀況時，摧毀嘶軸幫浦站週遭大池區中，除了機械地精以外的任意15個機器單位。|n|n完成後，向坦卡雷村的賢者地空回報。',
  }
},
[11897] = {
  {
    'Tampem as fossas‡Заткнуть воронки!‡Stopft die Schlundlöcher‡구덩이 봉쇄‡Obstruye los sumideros‡Obstruye los sumideros‡Boucher les puisards‡炸毁虫孔‡塞住坑道口',
    nil,
    'Sargento Martelmonte quer que você use os Explosivos Incendiários para fazer ruir as fossas a sudoeste e a noroeste da Bastilha Valentia.‡По поручению сержанта Молотогора используйте зажигательную взрывчатку, чтобы взорвать и обвалить воронки к юго-западу и северо-западу от крепости Отваги.‡Unteroffizier Hammerberg möchte, dass Ihr mithilfe des Brandsatzes die Schlundlöcher süd- und nordwestlich der Valianzfeste zum Einsturz bringt.‡하사관 해머힐이 소이탄을 사용해 용맹의 성채 남서쪽과 북서쪽에 있는 구덩이를 파괴해 달라고 부탁했습니다.‡El sargento Colinamartillo quiere que uses los explosivos incendiarios para hacer explotar los sumideros suroeste y noroeste de la Fortaleza Denuedo.‡El sargento Colinamartillo quiere que uses los explosivos incendiarios para hacer explotar los sumideros suroeste y noroeste de la Fortaleza Denuedo.‡Le Sergent Martèlemont veut que vous utilisiez les Explosifs incendiaires pour faire s\'effondrer les puisards qui se trouvent au sud-ouest et au nord-ouest du Donjon de la Bravoure.‡哈默希尔中士要你使用火焰炸弹摧毁无畏要塞西南方和西北方的虫孔。‡錘丘中士要你使用燃燒爆裂物去破壞驍勇要塞西北邊和西南邊的坑道口。',
  }
},
[11898] = {
  {
    'Abrindo caminho‡Прорыв‡Durchbrechen‡돌파‡Abriéndose paso‡Abriéndose paso‡L\'intrusion‡过关斩将‡突破',
    nil,
    'Derrote o Príncipe Valanar e seus tenentes Vanthryn, o Impiedoso, e Luthion, o Torpe, e então apresente-se ao Chefe Vento de Inverno na Aldeia Taunka\'le.‡Одолейте принца Валанара с его подручными, Вантрином Безжалостным и Лютионом Злобным, потом явитесь к вождю Зимней Стуже в деревне Таунка\'ле.‡Besiegt Prinz Valanar und seine Leutnants Vanthryn den Erbarmungslosen und Luthion den Grässlichen. Meldet Euch anschließend bei Häuptling Orkan in Taunka\'le.‡공작 발라나르와 그의 부관인 무자비한 반스린, 비열한 루시온을 처치하고 타운카르 마을의 족장 윈터게일에게 보고해야 합니다.‡Derrota al príncipe Valanar y a sus tenientes, Vanthryn el Despiadado y Luthion el Vil, e informa de ello al cabecilla Vendaval de Invierno en el Poblado Taunka\'le.‡Derrota al príncipe Valanar y a sus tenientes, Vanthryn el Despiadado y Luthion el Vil, e informa de ello al cabecilla Vendaval de Invierno en el Poblado Taunka\'le.‡Abattez le Prince Valanar et ses lieutenants, Vanthryn l\'Impitoyable et Luthion l\'Infâme, puis faites votre rapport au Chef Trombe-de-l\'hiver à Taunka\'le.‡击败瓦拉纳王子以及他手下的两名中尉，残忍的范瑟雷和邪恶的卢修恩，然后向牦牛村的冬风酋长复命。‡擊敗瓦拉納爾親王及他的部下，『殘酷』范希林和『邪惡』路西翁，接著回報給坦卡雷村的冬風酋長。',
  }
},
[11899] = {
  {
    'O desalmar dos desalmados‡Души распроклятых‡Seelen der vom Fluch befreiten‡저주에서 해방된 영혼‡Las almas de los desembrujados‡Las almas de los desembrujados‡Les âmes dé-maudites‡灵魂的解脱‡除咒的靈魂',
    nil,
    'Use O Apanhador de Almas da Grande Mãe para capturar as almas de 10 gnomecânicos do Biela. Depois, fale novamente com a Grande Mãe Taiga na Aldeia Taunka\'le.‡Используйте ловца душ Великой Матери, чтобы захватить души 10 мехагномов со станции Выкрутеня. Затем вернитесь к Великой Матери Тайге в деревне Таунка\'ле.‡Fangt mithilfe von Großmutters Seelenfänger 10 Seelen der Mechagnome von Kurbelzisch. Kehrt anschließend zu Großmutter Taiga in Taunka\'le zurück, sobald Ihr das erledigt habt.‡대모의 영혼갈무리를 사용해 피즈크랭크 기계노움 10마리의 영혼을 포획해야 합니다. 임무를 마치면 타운카르 마을에 있는 대모 타이가에게 돌아가십시오.‡Usa el cazador de almas de la Abuela para capturar las almas de 10 mecagnomos de Palanqueta. Después, vuelve junto a la abuela Taiga en el Poblado Taunka\'le cuando hayas terminado.‡Usa el cazador de almas de la Abuela para capturar las almas de 10 mecagnomos de Palanqueta. Después, vuelve junto a la abuela Taiga en el Poblado Taunka\'le cuando hayas terminado.‡Utilisez le Capturâme de la grande-mère pour emprisonner les âmes de 10 Mécagnomes de Spumelevier. Quand ce sera fait, retournez voir la Grande-mère Taiga à Taunka\'le.‡使用祖母的捕魂器捕获10个菲兹兰克机械侏儒的灵魂。完成任务后返回北风苔原的牦牛村，向塔迦祖母复命。‡使用主母的攝魂器來捕捉10個嘶軸機械地精的靈魂。然後回坦卡雷村向主母泰嘉回報。',
  }
},
[11900] = {
  {
    'Leitura dos medidores‡Что показывают приборы?‡Die Zähler ablesen‡수치 측정‡Lectura de medidores‡Lectura de medidores‡Relever les compteurs‡监测数据‡檢查讀數',
    nil,
    'Arquimago Berinand, no Escudo de Transitus, pediu que você faça as leituras dos instrumentos dele em Gelarra.‡По просьбе верховного мага Беринанда из лагеря под Маскировочным щитом соберите показания его приборов в Хладарре.‡Erzmagier Berinand im Transitusschild möchte, dass Ihr mit den Messwerten seiner Instrumente in Kaltarra zu ihm zurückkehrt.‡변위의 보호막에 있는 대마법사 베리난드가 콜다라 주변에 설치한 장치에서 수치를 얻어 달라고 부탁했습니다.‡El archimago Berinand en el Escudo de Tránsito te ha pedido que recojas las lecturas de sus instrumentos en Gelidar.‡El archimago Berinand en el Escudo de Tránsito te ha pedido que recojas las lecturas de sus instrumentos en Gelidar.‡L\'Archimage Bérinand au Bouclier Transitus vous a demandé de récupérer les relevés de ses appareils de mesure à Frimarra.‡永生之盾的大法师伯林纳德要你去收集他安装在考达拉的监测仪器上的数据。‡隘境之盾的大法師貝瑞那德希望你去收集他設在凜懼島的儀器的數據。',
  }
},
[11901] = {
  {
    'Militar? Que militar?‡Военные? Какие военные?‡Truppen? Welche Truppen?‡군대? 무슨 군대?‡¿Destacamento? ¿Qué destacamento?‡¿Destacamento? ¿Qué destacamento?‡L\'armée, quelle armée ?‡军队？什么军队？‡軍隊?什麼軍隊?',
    nil,
    'Geraldo Delleprane, em Algures, quer que você vá até a mina ao norte e descubra o que aconteceu com a guarnição militar que foi para lá.‡По просьбе Джеральда Грина из Далечья отправляйтесь на север, в шахту, и выясните, что случилось с направленным туда воинским подразделением.‡Gerald Grün in Fernhain möchte, dass Ihr euch in die Mine im Norden begebt und herausfindet, was mit der Einsatztruppe, die dorthin geschickt wurde, geschehen ist.‡파샤이어의 제랄드 그린이 북쪽에 있는 광산에 파견된 부대에 무슨 일이 일어났는지 조사해 달라고 부탁했습니다.‡Gerald Verde de Lindeallá quiere que vayas a la mina del norte y descubras qué le ocurrió al destacamento militar que enviaron allí.‡Gerald Verde de Lindeallá quiere que vayas a la mina del norte y descubras qué le ocurrió al destacamento militar que enviaron allí.‡Gerald Green, de Comté-lointaine, veut que vous alliez dans la mine, au nord, et que vous découvriez ce qui est arrivé au détachement qui y a été envoyé.‡致远郡的吉拉德·格林要你到北方的矿井去看看那里的守军发生了什么事。‡遠郡的吉羅德·葛林要你前往北方的礦坑，查出派遣到那邊去的特遣隊發生了什麼事。',
  }
},
[11902] = {
  {
    'Evidência nociva‡Ужасное свидетельство‡Schädliche Beweise‡역병의 증거‡Una evidencia perniciosa‡Una evidencia perniciosa‡Une preuve pernicieuse‡致命的谷物‡有毒的證據',
    nil,
    'Fale novamente com Geraldo Delleprane, em Algures.‡Возвращайтесь в Далечье к Джеральду Грину.‡Kehrt zu Gerald Grün in Fernhain zurück.‡파샤이어에 있는 제랄드 그린에게 돌아가야 합니다.‡Vuelve junto a Gerald Verde en Lindeallá.‡Vuelve junto a Gerald Verde en Lindeallá.‡Retournez voir Gerald Green à Comté-lointaine.‡回到致远郡，向吉拉德·格林复命。‡向遠郡的吉羅德·葛林回報。',
  }
},
[11903] = {
  {
    'Hora de agir‡Время действовать!‡Zeit zu handeln‡행동을 취할 시간‡Es hora de actuar‡Es hora de actuar‡Il est temps d\'agir‡战斗的时刻‡是行動的時候了',
    nil,
    'Geraldo Delleprane, em Algures, quer que você mate 14 Catadores Pestilentos.‡По просьбе Джеральда Грина из Далечья убейте 14 чумных падальщиков.‡Gerald Grün in Fernhain möchte, dass Ihr 14 verseuchte Aasfresser tötet.‡파샤이어의 제랄드 그린이 역병 걸린 청소부 14마리를 제거해 달라고 부탁했습니다.‡Gerald Verde en Lindeallá quiere que mates a 14 carroñeros apestados.‡Gerald Verde en Lindeallá quiere que mates a 14 carroñeros apestados.‡Gerald Green, à Comté-lointaine, vous demande de tuer 14 Charognards pestiférés.‡致远郡的吉拉德·格林要你去杀死14个天灾食腐者。‡遠郡的吉羅德·葛林要你去殺死14個染疫食腐者。',
  }
},
[11904] = {
  {
    'Frutos dos nossos esforços‡Плоды трудов наших‡Die Früchte unserer Arbeit‡노동의 결실‡Frutos de nuestro trabajo‡Frutos de nuestro trabajo‡Les fruits de notre travail‡劳动的果实‡勞動的果實',
    nil,
    'Vá até a mina em Algures, consiga a Chave de Liberação do Vagão do Capitão Jácobo e use-a para soltar o vagonete de minério. Fale com Geraldo Delleprane, em Algures, quando tiver completado esta tarefa.‡Отправляйтесь на шахту Далечья, добудьте ключ от повозки у капитана Якобса и используйте его для того, чтобы пустить повозку с рудой. По завершении задания вернитесь к Джеральду Грину в Далечье.‡Geht zur Mine in Fernhain, nehmt Hauptmann Jacobs den Wegrollsperrenschlüssel ab und macht den Wagen mit Erz los. Kehrt zu Gerald Grün in Fernhain zurück, sobald Ihr Eure Aufgabe beendet habt.‡파샤이어 광산으로 이동해 대장 제이콥스로부터 수레 열쇠를 얻은 다음 광석 수레를 풀고, 파샤이어에 있는 제랄드 그린에게 돌아가십시오.‡Ve hasta la mina de Lindeallá, consigue la llave para liberar la vagoneta del capitán Jacobs y utilízala para liberar la vagoneta de mena. Vuelve a ver a Gerald Verde en Lindeallá cuando hayas completado esta misión.‡Ve hasta la mina de Lindeallá, consigue la llave para liberar la vagoneta del capitán Jacobs y utilízala para liberar la vagoneta de mena. Vuelve a ver a Gerald Verde en Lindeallá cuando hayas completado esta misión.‡Allez dans la mine de Comté-lointaine, prenez la Clé de déblocage du chariot au capitaine Jacobs et utilisez-la pour déverrouiller le Chariot à minerai. Retournez voir Gerald Green à Comté-lointaine quand ce sera fait.‡前往致远郡的矿井，从亚克布上尉身上夺取矿石车钥匙，并用它开启矿石车。完成任务后向致远郡的吉拉德·格林复命。‡前往遠郡的礦坑，從傑考伯司上尉身上取得貨車啟動手把鑰匙，並用它來鬆開運礦車。完成任務後回到遠郡找吉羅德·葛林。',
  }
},
[11905] = {
  {
    'Adiando o inevitável‡Оттянуть неотвратимое‡Das Unvermeidliche hinauszögern‡임시방편‡Posponer lo inevitable‡Posponiendo lo inevitable‡Retarder l\'inévitable‡延缓灾难‡拖延不可避免的毀滅',
    nil,
    'O Arquimago Berinand, no Escudo de Transitus, quer que você use o Reconstituidor Interdimensional perto da fissura no Nexus.‡Используйте восстановитель измерений вблизи разлома в Нексусе по просьбе верховного мага Беринарда из лагеря под Маскировочным щитом.‡Erzmagier Berinand im Transitusschild möchte, dass Ihr den interdimensionalen Refabrikator in der Nähe des Risses im Nexus benutzt.‡변위의 보호막에 있는 대마법사 베리난드가 마력의 탑 안에 생긴 균열 근처에서 다차원 재구성기를 사용해 달라고 부탁했습니다.‡El archimago Berinand en el Escudo de Tránsito quiere que uses el refabricador interdimensional cerca de la falla de El Nexo.‡El archimago Berinand en el Escudo de Tránsito quiere que uses el refabricador interdimensional cerca de la falla de El Nexo.‡L\'Archimage Bérinand, au Bouclier Transitus, vous demande d\'utiliser le Refabricateur interdimensionnel près de la faille du Nexus.‡永生之盾的大法师伯林纳德要你在魔枢的裂隙附近使用交叉空间重塑器。‡隘境之盾的大法師貝瑞那德希望你前往奧核之心，在裂隙旁邊使用間次元重製器。',
  }
},
[11906] = {
  {
    'Limpando os poços‡Очищение прудов‡Die Teiche säubern‡웅덩이 청소‡Limpiando las Pozas‡Limpiando las Pozas‡Nettoyer les bassins‡净化水池‡淨化水池',
    nil,
    'Colete 15 Peças Sobressalentes do Biela e entregue-as para Olhos de Ferro na Aldeia Taunka\'le.‡Соберите 15 запасных деталей Выкрутеня и доставьте их Стальным Глазам в деревню Таунка\'ле.‡Sammelt 15 Ersatzteile von Kurbelzisch und bringt sie zu Eisenauge in Taunka\'le.‡피즈크랭크 예비 부품 15개를 모아 타운카르 마을에 있는 무쇠눈박이에게 전달해야 합니다.‡Recoge 15 piezas de repuesto de Palanqueta y entrégaselas a Ojos de Hierro en el Poblado Taunka\'le.‡Recoge 15 piezas de repuesto de Palanqueta y entrégaselas a Ojos de Hierro en el Poblado Taunka\'le.‡Ramassez 15 Pièces détachées de Spumelevier et rapportez-les à Yeux-de-fer à Taunka\'le.‡将15个菲兹兰克备用零件交给北风苔原牦牛村的铁眼。‡收集15個嘶軸的備用零件，然後交給坦卡雷村的鐵眼。',
  }
},
[11907] = {
  {
    'Os subchefes‡Подручные Механозода‡Die Offiziere‡부관 처리‡Los subtenientes‡Los subtenientes‡Les sous-chefs‡机械副官‡副手',
    nil,
    'Derrote Clanq, ED-210, Max Blasto e O Triturador. Depois, fale com o Sábio Terra e Céu na Aldeia Taunka\'le.‡Уничтожьте Шатунишку, ЕД-210, Макса Шмякса и Шлифовальщика, затем вернитесь к Ведуну земли и неба в деревню Таунка\'ле.‡Besiegt Twonkie, ED-210, Max Kawummso und Molok den Zermalmer und meldet Euch anschließend beim Weisen Erde und Himmel in Taunka\'le.‡트웡키, ED-210, 맥스 블라스토, 완벽분쇄기를 제거한 다음 타운카르 마을에 있는 현자 하늘땅에게 보고해야 합니다.‡Derrota a Twonky, ED-210, Max Blasto y El Moledor, y vuelve a ver al sabio Tierra y Cielo al Poblado Taunka\'le.‡Derrota a Twonky, ED-210, Max Blasto y El Moledor, y vuelve a ver al sabio Tierra y Cielo al Poblado Taunka\'le.‡Désactivez Twonky, ED-210, Max Blasto et Le Broyeur, puis retournez voir le Sage Terre-et-Ciel à Taunka\'le.‡摧毁托奇、ED-210、麦克斯·布拉斯托和研磨者，然后返回北风苔原的牦牛村，向天空大地先知复命。‡打倒噹機、ED-210、極限爆衝和研磨者，然後向坦卡雷村的賢者地空回報。',
  }
},
[11908] = {
  {
    'Material de referência‡Справочные материалы‡Referenzmaterial‡참고 자료‡Material de referencia‡Material de referencia‡Un ouvrage de référence‡参考资料‡相關用具',
    nil,
    'Jeremias Ranieri quer que você recupere o livro "Campos, Fábricas e Oficinas" da construção em chamas perto da mina em Algures.‡По просьбе Иеремии Хоунинга вынесите книгу "Поля, заводы и мастерские" из горящего здания рядом с рудником Далечья.‡Jeremias Hohning möchte, dass Ihr das Buch "Felder, Fabriken und Werkstätten" aus dem brennenden Gebäude neben der Mine in Fernhain holt.‡제레미어 호닝이 파샤이어의 광산 옆에 있는 불타는 건물에서 "들판과 공장, 그리고 작업장"이라는 책을 가져와 달라고 부탁했습니다.‡Jeremiah Hawning quiere que recuperes el libro "Campos, fábricas y talleres" del edificio en llamas junto a la mina en Lindeallá.‡Jeremiah Hawning quiere que recuperes el libro "Campos, fábricas y talleres" del edificio en llamas junto a la mina en Lindeallá.‡Jeremiah Hawning vous demande de récupérer le livre "Chantiers, Usines et Ateliers" dans le bâtiment en feu à côté de la mine de Comté-lointaine.‡耶雷米亚·霍宁要你到致远郡矿井旁那间着火的屋子里拿回他的手册《农田、工厂与车间》。‡杰瑞米亞·豪寧要你從遠郡礦坑旁燃燒的建築中找回一本書《農地、工廠和工坊》。',
  }
},
[11909] = {
  {
    'Derrote o engrenochefe‡Убить механизатора!‡Besiegt den Ritzelmeister‡톱니반장 처치‡Vence al maestro de palancas‡Vence al maestro de palancas‡Abattre le maître des rouages‡击败机甲专家‡打敗齒輪大師',
    nil,
    'Investigue o Manual do Engrenochefe e traga a Cabeça do Mecanozod para a Grande Mãe Taiga na Aldeia Taunka\'le.‡Изучите Руководство механизатора и принесите голову Механозода Великой матери Тайге в деревню Таунка\'ле.‡Untersucht das Handbuch des Ritzelmeisters und bringt Mechazods Kopf zu Großmutter Taiga in Taunka\'le.‡톱니반장의 교본을 조사한 다음 메카조드의 머리를 가지고 타운카르 마을에 있는 대모 타이가에게 돌아가야 합니다.‡Busca el manual del maestro de palancas y llévale la cabeza de Mecazod a la abuela Taiga en el Poblado Taunka\'le.‡Busca el manual del maestro de palancas y llévale la cabeza de Mecazod a la abuela Taiga en el Poblado Taunka\'le.‡Trouvez le Manuel du Maître des rouages Mécazod puis rapportez sa tête à la Grande-mère Taiga à Taunka\'le.‡研究机甲专家的手册，并将机甲专家麦卡佐德的徽记带回北风苔原的牦牛村，向塔迦祖母汇报你获胜的消息。‡研究齒輪大師的手冊，並且帶著梅卡佐德的頭回到坦卡雷村向主母泰嘉報告。',
  }
},
[11910] = {
  {
    'Segredo dos Ancientes‡Тайны Древних‡Geheimnisse der Urtume‡고대정령의 비밀‡Secretos de los ancestros‡Secretos de los ancestros‡Les secrets des Anciens‡古树的秘密‡古樹的秘密',
    nil,
    'O Arquimago Berinand, no Escudo de Transitus, quer que você consiga 3 Estilhaços Glaciais e 3 Estilhaços Embruxados dos Ancientes em Gelarra.‡По просьбе верховного мага Беринарда из-под Маскировочного щита принесите 3 ледяных осколка и 3 щепки зачарованного древа, собранных с древ в Хладарре.‡Erzmagier Berinand im Transitusschild möchte, dass Ihr 3 eiszeitliche Späne und 3 magiegebundene Späne von den Urtumen in Kaltarra besorgt.‡변위의 보호막에 있는 대마법사 베리난드가 콜다라에 있는 고대정령에게서 빙하의 파편 3개와 마법에 구속된 파편 3개를 모아달라고 부탁했습니다.‡El archimago Berinand en el Escudo de Tránsito quiere que recojas 3 esquirlas glaciales y 3 esquirlas de vinculado a magia de los ancestros de Gelidar.‡El archimago Berinand en el Escudo de Tránsito quiere que recojas 3 esquirlas glaciales y 3 esquirlas de vinculado a magia de los ancestros de Gelidar.‡L\'Archimage Bérinand, au Bouclier Transitus, vous demande de collecter 3 Echardes glaciaires et 3 Echardes liées par magie sur les Anciens de Frimarra.‡永生之盾的大法师伯林纳德要你从考达拉的古树身上收集3块冰川古树碎片和3块魔缚古树碎片。‡隘境之盾的大法師貝瑞那德希望你從凜懼島的古樹身上收集3個冰川裂塊和3個咒縛裂塊。',
  }
},
[11911] = {
  {
    'A metamorfose‡Преображение‡Beschleunigen‡계속되는 변화‡Acelerando‡Acelerando‡Métamorphose‡苏醒‡加速',
    nil,
    'O Arquimago Berinand, no Escudo de Transitus, quer que você entre no Nexus e colete 5 Estilhaços Arcanos dos Protetores Cristalinos.‡По заданию верховного мага Беринанда из лагеря под Маскировочным щитом отправьтесь в Нексус и соберите 5 магических обломков кристаллических заступников.‡Erzmagier Berinand im Transitusschild möchte, dass Ihr den Nexus betretet und 5 arkane Späne von den kristallinen Beschützern beschafft.‡변위의 보호막에 있는 대마법사 베리난드가 마력의 탑에 들어가 수정 수호정령으로부터 비전 파편 5개를 모아달라고 부탁했습니다.‡El archimago Berinand en el Escudo de Tránsito quiere que entres en El Nexo y reúnas 5 astillas arcanas de protectores cristalinos.‡El archimago Berinand en el Escudo de Tránsito quiere que entres en El Nexo y reúnas 5 astillas arcanas de protectores cristalinos.‡L\'Archimage Bérinand, au Bouclier Transitus, vous demande de pénétrer dans le Nexus et de collecter 5 Echardes arcaniques sur les Protecteurs cristallins.‡永生之盾的大法师伯林纳德要你进入魔枢，并从晶化保卫者身上收集5块奥术古树碎片。‡隘境之盾的大法師貝瑞那德希望你進入奧核之心從結晶保衛者身上收集5個秘法裂塊。',
  }
},
[11912] = {
  {
    'Loucos por frutinhas‡На подножном корму‡Verrückt nach Beeren‡딸기가 좋아‡Locos por unos gelifructus‡Locos por unos gelifructus‡Fou de baies‡冰冷的草莓‡為莓發狂',
    nil,
    'A Bibliotecária Serrah, no Escudo de Transitus, quer que você colha 10 Frutagelos dos Arbustos de Frutagelo em Gelarra.‡Соберите 10 ягод снежевики с кустов снежевики в Хладарре по просьбе библиотекаря Серры из лагеря под Маскировочным щитом.‡Bibliothekarin Serrah im Transitusschild möchte, dass Ihr 10 Frostbeeren von den Frostbeerbüschen in Kaltarra besorgt.‡변위의 보호막에 있는 사서 세라가 콜다라의 서리딸기 덤불에서 서리딸기 10개를 구해달라고 부탁했습니다.‡La bibliotecaria Serrah del Escudo de Tránsito quiere que recojas 10 gelifructus de los arbustos de gelifructus de Gelidar.‡La bibliotecaria Serrah del Escudo de Tránsito quiere que recojas 10 gelifructus de los arbustos de gelifructus de Gelidar.‡La Bibliothécaire Serrah, au Bouclier Transitus, vous demande de cueillir 10 Givrelles sur les Buissons de givrelles de Frimarra.‡永生之盾的图书馆员塞尔拉要你从考达拉的冰莓灌木丛上收集10份冰莓。‡隘境之盾的圖書管理員瑟菈要你從凜懼島的霜莓叢收集10個霜莓。',
  }
},
[11913] = {
  {
    'Sem arriscar‡Надо действовать наверняка‡Kein Risiko eingehen‡사전 예방‡No tientes a la suerte‡No tientes a la suerte‡Ne prenons pas de risques‡万无一失‡不要冒險',
    nil,
    'Vanda Rúbia quer que você use a Tocha da Vanda para queimar 8 sacos de Grão de Algures.‡По просьбе Венди Даррен сожгите 8 мешков с зерном Далечья, воспользовавшись факелом Венди.‡Wendy Darren möchte, dass Ihr mithilfe von Wendys Fackel 8 Säcke Korn aus Fernhain verbrennt.‡웬디 다렌이 웬디의 횃불을 사용해 파샤이어 곡식 8자루를 불태워 달라고 부탁했습니다.‡Wendy Darren quiere que uses la antorcha de Wendy para quemar 8 sacos de grano de Lindeallá.‡Wendy Darren quiere que uses la antorcha de Wendy para quemar 8 sacos de grano de Lindeallá.‡Wendy Darren vous demande d\'utiliser la Torche de Wendy pour brûler 8 sacs de Céréales de Comté-lointaine.‡温蒂·达伦要你使用温蒂的火炬烧掉8袋致远郡谷物。‡溫蒂·達倫需要你使用溫蒂的火炬，將8袋遠郡穀物燒毀。',
  }
},
[11914] = {
  {
    'Mantenha o segredo a salvo‡Сохранение секретности‡Das Geheimnis hüten‡보호막 유지‡Guarda el secreto‡Guarda el secreto‡Conserver le secret‡保持隐蔽‡守護秘密',
    nil,
    'A Bibliotecária Serrah, no Escudo de Transitus, precisa que você mate Serpentes Arcanas perto do Nexus e consiga 5 Essências de Mana do Nexus delas.‡По просьбе библиотекаря Серры убейте волшебных змеев и принесите за Маскировочный щит 5 субстанций маны Нексуса.‡Bibliothekarin Serrah im Transitusschild möchte, dass Ihr arkane Schlangen in der Nähe des Nexus tötet und 5 Nexusmanaessenzen sammelt.‡변위의 보호막에 있는 사서 세라가 마력의 탑 근처에 있는 비전 독사 5마리를 처치하고 마력의 탑 마나 정수 5개를 가져와 달라고 부탁했습니다.‡La bibliotecaria Serrah del Escudo de Tránsito necesita que mates serpientes arcanas cerca de El Nexo para reunir 5 muestras de esencia de maná nexa.‡La bibliotecaria Serrah del Escudo de Tránsito necesita que mates serpientes arcanas cerca de El Nexo para reunir 5 muestras de esencia de maná nexa.‡La Bibliothécaire Serrah, au Bouclier Transitus, vous demande de tuer des Serpents arcaniques près du Nexus et de prendre 5 Essences de mana sur eux.‡永生之盾的图书馆员塞尔拉要你杀死魔枢附近的奥术浮蛇，并收集5份魔枢法力精华。‡隘境之盾的圖書管理員瑟菈要你殺死奧核之心附近的秘法巨蛇，並且收集5個奧核法力精華。',
  }
},
[11915] = {
  {
    'Brincando com fogo‡Игра с огнем‡Spiel mit dem Feuer‡불놀이‡Jugando con fuego‡Jugando con fuego‡Jouer avec le feu‡玩火‡玩火',
    nil,
    'Fale com um Mestre Engolidor de Chamas em qualquer capital da Horda.‡Поговорите с пламеглотателем-виртуозом в любой из столиц Орды.‡Sprecht mit einem Feuerschluckmeister in einer der Hauptstädte.‡호드 대도시에 있는 불꽃 마술의 대가와 대화해야 합니다.‡Habla con un maestro tragallamas en cualquiera de las capitales de la Horda.‡Habla con un maestro tragallamas en cualquiera de las capitales de la Horda.‡Parlez à un Maître avaleur de flammes dans n\'importe quelle capitale de la Horde.‡与任意部落主城的食焰大师谈一谈。‡跟任一個何部落主城的吞焰者大師談談。',
  }
},
[11916] = {
  {
    'Campeão do Grito Infernal‡Воин Адского Крика‡Höllschreis Champion‡헬스크림의 용사‡El campeón de Grito Infernal‡El campeón de Grito Infernal‡Le champion de Hurlenfer‡地狱咆哮的勇士‡地獄吼的勇士',
    nil,
    'Encontre o Chefe Vento de Inverno na Aldeia Taunka\'le.‡Отыщите вождя Зимнюю Стужу в деревне Таунка\'ле.‡Geht nach Taunka\'le und sucht Häuptling Orkan auf.‡타운카르 마을에서 족장 윈터게일을 찾아야 합니다.‡Busca al cabecilla Vendaval de Invierno en el Poblado Taunka\'le.‡Busca al cabecilla Vendaval de Invierno en el Poblado Taunka\'le.‡Allez voir le chef Trombe-de-l’hiver à Taunka’le.‡前往牦牛村与冬风酋长谈一谈。‡前往坦卡雷村拜訪冬風酋長。',
  }
},
[11917] = {
  {
    '‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    '‡Убейте лейтенанта Хладоволна, помощника Ахуна, вызвав его при помощи Камня Льда на Зорамском взморье в Ясеневом лесу, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens auf dem Zoramstrand im Eschental den Leutnant der Frostwelle, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡잿빛 골짜기에 있는 조람 해안에서 얼음 기둥을 사용하여 서리파도 부관을 소환한 다음 처치하고, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Olaescarcha que invoques desde la piedra de hielo situada en La Ensenada de Zoram en Vallefresno. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Olaescarcha que invoques desde la piedra de hielo situada en La Ensenada de Zoram en Vallefresno. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Vaguegivre invoqué par la Pierre de glace située sur la grève de Zoram, en Orneval, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡‡',
  }
},
[11918] = {
  {
    'Treinamento básico‡Первое знакомство‡Grundausbildung‡기본 훈련‡Entrenamiento básico‡Entrenamiento básico‡Entraînement de base‡基本的训练‡基本訓練',
    nil,
    'Raelorasz, no Escudo de Transitus, quer que você mate 10 Tecencantos de Gelarra.‡Убейте 10 чароплетов Хладарры по просьбе Релораза из лагеря под Маскировочным щитом.‡Raelorasz im Transitusschild möchte, dass Ihr 10 Spruchwirker von Kaltarra tötet.‡변위의 보호막에 있는 라엘로라즈가 콜다라 주문술사 10명을 처치해 달라고 했습니다.‡Raelorasz en el Escudo de Tránsito quiere que mates a 10 tejehechizos de Gelidar.‡Raelorasz en el Escudo de Tránsito quiere que mates a 10 tejehechizos de Gelidar.‡Raelorasz, au Bouclier Transitus, vous demande de tuer 10 Tisse-sorts de Frimarra.‡永生之盾的莱洛拉斯要你消灭10个考达拉织法者。‡隘境之盾的瑞洛拉茲要你去殺死10隻凜懼島織法者。',
  }
},
[11919] = {
  {
    'Caçada dracônica‡Охота на драконов‡Drachenjagd‡비룡 사냥‡Caza de dracos‡Caza de dracos‡La chasse au drake‡猎龙‡獵龍',
    nil,
    'Raelorasz quer que você use a Lança de Raelorasz para dominar um Filhote de Draco do Nexus e trazê-lo até ele, no Escudo de Transitus.‡По просьбе Релораза используйте копье с окровавленным наконечником, чтобы подчинить детеныша дракона Нексуса, а затем принесите Релоразу копье назад за Маскировочный щит.‡Raelorasz möchte, dass Ihr mithilfe von Raelorasz\' Speer ein Nexusdrachenjunges bändigt und es anschließend zu ihm zurückbringt. Er befindet sich im Transitusschild.‡라엘로라즈가 라엘로라즈의 창을 사용해 마력의 탑 새끼 비룡 한 마리를 약해지게 한 다음 변위의 보호막으로 데려오라고 했습니다.‡Raelorasz quiere que uses la lanza de Raelorasz para dominar a una prole de draco de El Nexo y regreses junto a él en el Escudo de Tránsito.‡Raelorasz quiere que uses la lanza de Raelorasz para dominar a una prole de draco de El Nexo y regreses junto a él en el Escudo de Tránsito.‡Raelorasz vous a demandé d\'utiliser la Lance de Raelorasz pour soumettre un Jeune drake du Nexus, et de le ramener au Bouclier Transitus.‡莱洛拉斯要你使用他的长矛驯服一只魔枢雏龙，并把它带回永生之盾交给他。‡瑞洛拉茲要你使用瑞洛拉茲之矛來制服一隻奧核雛龍，然後帶回隘境之盾給他。',
  }
},
[11920] = {
  {
    'Sectários entre nós‡Сектанты среди нас‡Kultisten unter uns‡내부의 이교도‡Cultores entre nosotros‡Cultores entre nosotros‡Des sectateurs parmi nous‡隐藏的诅咒教徒‡教徒內奸',
    nil,
    'Fale com Capitão "Canhoto" Velabaixa acima do Rompe-procelas, na Bastilha Valentia.‡Поговорите с капитаном "Левшой" Люггером на "Рассекателе туч" в Крепости Отваги.‡Sprecht mit Kapitän "Linksdatsch" Gaffelsegel an Deck der Sturmbrecher in der Valianzfeste.‡용맹의 성채에 있는 폭풍파괴자호에서 선장 "왼손잡이" 러그세일과 대화해야 합니다.‡Habla con el capitán "Zurdo" Vela al Tercio a bordo de El Rompetormentas en la Fortaleza Denuedo.‡Habla con el capitán "Zurdo" Vela al Tercio a bordo de El Rompetormentas en la Fortaleza Denuedo.‡Parlez au Capitaine Lougres "le Gaucher" sur le Brise-tempête au Donjon de la Bravoure.‡与无畏要塞内的斩雷号战舰上的“左撇子”鲁格塞尔船长谈一谈。‡『左撇子』縱帆船長談談，他就在驍勇要塞的風暴破碎者上。',
  }
},
[11921] = {
  {
    'Mais arremessos de tochas‡Опять бросаем факелы‡Noch einmal Fackeln werfen‡횃불을 더 많이 던져라!‡Más lanzamiento de antorchas‡Más lanzamiento de antorchas‡Lancer plus de torches‡继续扔火炬‡投擲更多的火炬',
    nil,
    'Vença o jogo de arremessar as tochas e então fale com o Mestre Engolidor de Fogo.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 던지기 시험을 통과하고 불꽃마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragafuegos.‡Gagnez le jeu de lancer de torches, puis parlez au Maître mangeur de feu.‡赢得一场扔火炬游戏，然后与吞火大师谈一谈。‡在火炬投擲遊戲中獲勝，然後與吞火者大師談話。',
  }
},
[11922] = {
  {
    'Arremesso de tochas‡Жонглирование факелами‡Fackelwurf‡횃불을 던져라!‡Lanzamiento de antorchas‡Lanzamiento de antorchas‡Lancer des torches‡扔火炬‡投擲火炬',
    nil,
    'Vença o jogo de arremessar tochas e então fale com o Mestre Engolidor de Chamas.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister des Sonnenwendfests.‡횃불 던지기 시험을 통과하고 불꽃 마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gagnez le jeu de lancer de torches, puis parlez au Maître avaleur de flammes.‡赢得一场扔火炬游戏，然后与食焰大师谈一谈。‡在火炬投擲遊戲中獲勝，然後跟吞焰者大師談話。',
  }
},
[11923] = {
  {
    'Piromalabarismo‡Поймай факел!‡Fackeln fangen‡횃불을 잡아라!‡Caza de antorchas‡Caza de antorchas‡Attraper des torches‡接火炬‡接住火炬',
    nil,
    'Pegue 4 tochas seguidas e então fale com o Mestre Engolidor de Chamas.‡Поймайте подряд 4 факела, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 4 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 4개를 연달아 던졌다 잡고 나서, 불꽃 마술의 대가와 대화해야 합니다.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Atrapa 4 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Attrapez 4 torches de suite, puis parlez au Maître avaleur de flammes.‡连续接住火炬4次，然后与食焰大师谈一谈。‡連續接住4根火炬，然後跟吞焰者大師談話。',
  }
},
[11924] = {
  {
    'Mais piromalabarismo‡Опять жонглирование факелами‡Noch einmal Fackeln fangen‡횃불을 더 많이 잡아라!‡Más caza de antorchas‡Más caza de antorchas‡Attraper plus de torches‡继续接火炬‡接住更多的火炬',
    nil,
    'Pegue 10 tochas seguidas e então fale com o Mestre Engolidor de Fogo.‡Поймайте 10 факелов подряд, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 10 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 10개를 연달아 던졌다 잡고 나서, 불꽃마술의 대가와 대화해야 합니다.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragafuegos.‡Attrapez 10 torches de suite, puis parlez au Maître mangeur de feu.‡连续接住火炬10次，然后与吞火大师谈一谈。‡連續接住10根火炬，然後跟吞火者大師談話。',
  }
},
[11925] = {
  {
    'Mais piromalabarismo‡Опять жонглирование факелами‡Noch einmal Fackeln fangen‡횃불을 더 많이 잡아라!‡Más caza de antorchas‡Más caza de antorchas‡Attraper plus de torches‡继续接火炬‡接住更多的火炬',
    nil,
    'Pegue 10 tochas seguidas e então fale com o Mestre Engolidor de Chamas.‡Поймайте 10 факелов подряд, затем поговорите с пламеглотателем-виртуозом.‡Fangt nacheinander 10 Fackeln und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 10개를 연달아 던졌다 잡고 나서, 불꽃 마술의 대가와 대화해야 합니다.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Atrapa 10 antorchas seguidas y después ve a hablar con el maestro tragallamas.‡Attrapez 10 torches de suite, puis parlez au Maître avaleur de flammes.‡连续接住火炬10次，然后与食焰大师谈一谈。‡連續接住10根火炬，然後跟吞焰者大師談話。',
  }
},
[11926] = {
  {
    'Mais arremessos de tochas‡Опять бросаем факелы‡Noch einmal Fackeln werfen‡횃불을 더 많이 던져라!‡Más lanzamiento de antorchas‡Más lanzamiento de antorchas‡Lancer plus de torches‡继续扔火炬‡投擲更多的火炬',
    nil,
    'Vença o jogo de arremessar tochas e então fale com o Mestre Engolidor de Chamas.‡Выиграйте игру в бросание факелов, затем поговорите с пламеглотателем-виртуозом.‡Gewinnt das Fackelwurfspiel und sprecht anschließend mit dem Feuerschluckmeister.‡횃불 던지기 경기에서 이긴 다음, 불꽃 마술의 대가와 대화해야 합니다.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gana la prueba de lanzamiento de antorchas y ve a hablar con el maestro tragallamas.‡Gagnez le jeu de lancer de torches, puis parlez au Maître avaleur de flammes.‡赢得一场扔火炬游戏，然后与食焰大师谈一谈。‡在火炬投擲遊戲中獲勝，然後跟吞焰者大師談話。',
  }
},
[11927] = {
  {
    'Boato das ruas‡Встреча в трактире‡Man munkelt‡거리에 도는 소문‡Dicen por la calle‡Dicen por la calle‡La rumeur de la rue‡坊间的传言‡街上的消息',
    nil,
    'Encontre Leryssa na Bastilha Valentia.‡Найдите Лериссу в таверне в крепости Отваги.‡Geht zum Gasthaus in der Valianzfeste und sucht Leryssa auf.‡용맹의 성채 여관에서 레리사를 찾아야 합니다.‡Busca a Leryssa en la posada de la Fortaleza Denuedo.‡Busca a Leryssa en la posada de la Fortaleza Denuedo.‡Trouvez Leryssa à l\'auberge du donjon de la Bravoure.‡在无畏要塞的旅店中找到莉蕾萨。‡在驍勇要塞的旅店中找到蕾瑞莎。',
  }
},
[11928] = {
  {
    'Algures‡Далечье‡Fernhain‡파샤이어‡Lindeallá‡Lindeallá‡Comté-lointaine‡致远郡‡遠郡',
    nil,
    'Vá para Algures, na Tundra Boreana, e fale com Geraldo Delleprane.‡Отправляйтесь в Далечье в Борейской Тундре и поговорите с Джеральдом Грином.‡Reist nach Fernhain in der boreanischen Tundra und sprecht mit Gerald Grün.‡북풍의 땅에 있는 파샤이어로 가서 제랄드 그린과 대화해야 합니다.‡Viaja a Lindeallá, en la Tundra Boreal, y habla con Gerald Verde.‡Viaja a Lindeallá, en la Tundra Boreal, y habla con Gerald Verde.‡Partez pour Comté-lointaine dans la Toundra Boréenne et parlez à Gerald Green.‡前往北风苔原的致远郡，与吉拉德·格林谈一谈。‡前往北風凍原的遠郡，然後和吉羅德·葛林談談。',
  }
},
[11929] = {
  {
    'A queda da Aldeia Taunka\'le‡Гибель деревни Таунка\'ле‡Taunka\'les Untergang‡타운카르 마을의 함락‡La caída del Poblado Taunka\'le‡La caída del Poblado Taunka\'le‡La chute de Taunka\'le‡牦牛村的陷落‡坦卡雷村的陷落',
    nil,
    'Fale com Mãe Tauranuk do lado de fora dos portões da Aldeia Taunka\'le.‡Поговорите с матерью Тауранук у ворот деревни Таунка\'ле.‡Sprecht mit Mutter Tauranook außerhalb von Taunka\'le.‡타운카르 마을의 문밖에 있는 대모 타우라누크와 대화해야 합니다.‡Habla con Madre Tauranuk a las puertas del Poblado Taunka\'le.‡Habla con Madre Tauranuk a las puertas del Poblado Taunka\'le.‡Parlez à Mère Tauranook à la sortie de Taunka\'le.‡与牦牛村外的陶拉努克宗母谈一谈。‡和坦卡雷村大門外的教母托蘭努克交談。',
  }
},
[11930] = {
  {
    'Além de Transbórea‡Через Трансборею‡Quer durch Transborea‡북풍길 횡단‡Cruzando Transborea‡Cruzando Transborea‡La traversée de Transborée‡横贯冰原‡穿過越風之地',
    nil,
    'Escolte os Retirantes de Taunka\'le através da Transbórea até Guerratuk Gelonato, na fronteira com o Ermo das Serpes.‡Проводите эвакуированных жителей Таунка\'ле через Трансборею на границу Драконьего Погоста, где их ждет Вартук Дитя Льда.‡Eskortiert die Evakuierten aus Taunka\'le durch die Transborea bis zu Wartuk Eiskind in der Drachenöde.‡타운카르 피난민들을 호위해 북풍길을 지나 용의 안식처 경계에 있는 워툭 아이스본에게 데려가야 합니다.‡Escolta a los evacuados de Taunka\'le a través de Transborea hasta Guerratuk Hielonato, que se encuentra en la frontera con Cementerio de Dragones.|n‡Escolta a los evacuados de Taunka\'le a través de Transborea hasta Guerratuk Hielonato, que se encuentra en la frontera con Cementerio de Dragones.|n‡Escortez les Évacués de Taunka\'le à travers Transborée jusqu’à Priseguerre Né-de-glace, à la frontière de la Désolation des dragons.‡护送牦牛村撤离者穿越横贯冰原，与龙骨荒野边界处的沃图克碰面。‡護送坦卡雷疏散者通過越風之地，瓦圖克·冰誕在龍骨荒野的邊界等著你。',
  }
},
[11931] = {
  {
    'Quebrando o código‡Взломать шифр‡Den Code entziffern‡암호 해독‡Interpretar el código‡Interpretar el código‡Percer le code‡破译密码‡破解密碼',
    nil,
    'Raelorasz, no Escudo de Transitus, quer que você pegue o Códice Lazúli do Inquisidor Caleras e consiga 3 Runas Cintilantes dos Mesmerizadores de Gelarra.‡Добудьте Лазурный кодекс у инквизитора Калераса и 3 мерцающих руны у его чародеев Хладарры и отнесите Релоразу за Маскировочный щит.‡Raelorasz im Transitusschild möchte, dass Ihr den azurblauen Kodex von Inquisitor Caleras besorgt und 3 schimmernde Runen seiner Zauberbindern von Kaltarra besorgt.‡변위의 보호막에 있는 라엘로라즈가 심문관 칼레라스에게서 하늘빛 법전을 구하고, 콜다라 역술사에게서 빛나는 룬 3개를 구해달라고 부탁했습니다.‡Raelorasz en el Escudo de Tránsito quiere que consigas el códice azur del inquisidor Caleras y que reúnas 3 runas fulgurantes de sus vinculahechizos de Gelidar.‡Raelorasz en el Escudo de Tránsito quiere que consigas el códice azur del inquisidor Caleras y que reúnas 3 runas fulgurantes de sus vinculahechizos de Gelidar.‡Raelorasz, au Bouclier Transitus, vous demande de prendre le Codex azur à l\'Inquisiteur Caleras et de récupérer 3 Runes chatoyantes sur ses Lieurs de sorts de Frimarra.‡永生之盾的莱洛拉斯要你从审讯者卡勒拉斯那里取得碧蓝书典，并从他手下的考达拉缚法者那里收集3枚闪烁的符文。‡隘境之盾的瑞洛拉茲要你去從審判官卡列拉斯身上取得蒼藍聖典，並從他的凜懼島縛法者身上取得3個幻光符文。',
  }
},
[11932] = {
  {
    'Covardes e tolos‡Дураки и трусы‡Feiglinge und Dummköpfe‡겁쟁이와 바보‡Cobardes e insensatos‡Cobardes e insensatos‡Des lâches et des imbéciles‡懦夫和蠢货‡懦夫與傻瓜',
    nil,
    'Fale com Ataika em Kaskala, a nordeste da Bastilha Valentia.‡Поговорить с Атаикой в Каскале, к северо-востоку от крепости Отваги.‡Sprecht mit Ataika in Kaskala nordöstlich der Valianzfeste.‡용맹의 성채의 북동쪽에 있는 카스칼라에서 아타이카와 대화해야 합니다.‡Habla con Ataika en Kashala, al noreste de la Fortaleza Denuedo.‡Habla con Ataika en Kashala, al noreste de la Fortaleza Denuedo.‡Parlez à Ataika à Kaskala, au nord-est du Donjon de la Bravoure.‡前往无畏要塞东北边的卡斯卡拉，与阿泰卡谈一谈。‡跟卡斯卡拉的阿泰卡談話，他在驍勇要塞的東北方。',
  }
},
[11933] = {
  {
    'Roubando a chama da Exodar‡Похищение пламени Экзодара‡Raubt die Flamme der Exodar‡엑소다르의 불꽃 훔치기‡Robar la llama de El Exodar‡Robar la llama de El Exodar‡Voler la flamme de l\'Exodar‡盗取埃索达的烈焰‡偷取艾克索達之焰',
    nil,
    'Entregue a Chama da Exodar para o Contador de Histórias do Festival.‡Верните Пламя Экзодара Праздничному сказителю.‡Bringt die Flamme der Exodar zum Geschichtenerzähler.‡한여름 축제 이야기꾼에게 엑소다르의 불꽃을 돌려줘야 합니다.‡Devuelve la Llama de El Exodar al cuentacuentos del Festival.‡Devuelve la Llama de El Exodar al cuentacuentos del Festival.‡Rapportez la Flamme de l\'Exodar au Conteur de la fête.‡将埃索达烈焰交给节日诗人。‡將艾克索達之焰交給節慶故事使者。',
  }
},
[11935] = {
  {
    'Roubando a chama de Luaprata‡Похищение пламени Луносвета‡Raubt die Flamme von Silbermond‡실버문 불꽃 훔치기‡Robar la llama de Lunargenta‡Robar la llama de Lunargenta‡Voler la flamme de Lune-d\'argent‡盗取银月城的烈焰‡偷取銀月之焰',
    nil,
    'Entregue a Chama de Luaprata para o Historiador do Festival.‡Верните пламя Луносвета хранителю мудрости Праздника.‡Bringt die Flamme von Silbermond zum Meister der Lehren.‡한여름 축제 현자에게 실버문 불꽃을 가져다 줘야 합니다.‡Devuelve la Llama de Lunargenta al maestro cultural del Festival.‡Devuelve la Llama de Lunargenta al maestro cultural del Festival.‡Rapportez la Flamme de Lune-d\'argent au Maître des traditions de la fête.‡将银月城烈焰交给节日博学者。‡將銀月之焰交給節慶博學大師。',
  }
},
[11936] = {
  {
    'Chocando um plano‡Наклевывается план!‡Einen Plan ausbrüten‡작전 시작‡Incubando un plan‡Incubando un plan‡L\'éclosion d\'un plan‡蓝龙的卵‡醞釀策劃',
    nil,
    'Raelorasz, no Escudo de Transitus, quer que você mate Draconoides de Gelarra e use seus machados de gelo para quebrar 5 ovos de dragão azul.‡Убейте драконидов из Хладарры и используйте их застывшие топоры, чтобы разбить 5 яиц синих драконов по просьбе Релораза из лагеря под Маскировочным щитом.‡Raelorasz im Transitusschild möchte, dass Ihr Wyrmkin von Kaltarra erschlagt und mit ihren gefrorenen Äxten 5 Eier von blauen Drachen zertrümmert.‡변위의 보호막에 있는 라엘로라즈가 콜다라 고룡족을 제거하고 얼어붙은 도끼를 얻어, 푸른용 알 5개를 파괴해 달라고 부탁했습니다.‡Raelorasz en el Escudo de Tránsito quiere que mates vermintes de Gelidar y uses sus hachas congeladas para romper 5 huevos de dragón azul.‡Raelorasz en el Escudo de Tránsito quiere que mates vermintes de Gelidar y uses sus hachas congeladas para romper 5 huevos de dragón Azul.‡Raelorasz, au Bouclier Transitus, vous a demandé de tuer des Wyrmides de Frimarra et d\'utiliser leurs haches glacées pour casser 5 œufs de dragons bleus.‡永生之盾的莱洛拉斯要你杀死考达拉龙人，并用它们的冰霜战斧打碎5枚蓝龙卵。‡隘境之盾的瑞洛拉茲要你殺死凜懼島龍人，然後使用他們的冰凍的斧頭去打破5顆藍龍蛋。',
  }
},
[11937] = {
  {
    '‡УКАЗАТЕЛЬ – все факелы возвращены, задание выполнено‡FLAG - all torch return quests are complete‡FLAG-횃불 반환 퀘스트 모두 완료‡FLAG - all torch return quests are complete‡FLAG - all torch return quests are complete‡MARQUEUR - Toutes les quêtes des torches sont terminées‡旗帜 - 归还所有火炬的任务完成‡旗幟 - 歸還所有火炬的任務完成',
    nil,
    nil,
  }
},
[11938] = {
  {
    'Conseguindo mais tempo‡Отвлечь противника‡Zeit schinden‡시간을 벌어라‡Ganar algo de tiempo‡Ganar algo de tiempo‡Gagner un peu de temps‡争取时间‡爭取一點時間',
    nil,
    'Thassarian no Zigurate dos Lamentos, na Tundra Boreana, quer que você cause 20 baixas contra os membros do Flagelo, dentro da Cidade-Templo de En\'kilah. Use os Ossos de Lúrido, caso precise de ajuda.‡Подстройте 20 несчастных случаев, в которых пострадает Плеть в Храмовом городе Эн\'кила, по просьбе Тассариана из Стонущего зиккурата в Борейской тундре. Используйте кости Лурида, если вам понадобится помощь.‡Thassarian in der klagenden Ziggurat in der boreanischen Tundra möchte, dass Ihr 20 Anhänger der Geißel in der Tempelstadt En\'kilah erschlagt. Benutzt Lurids Knochen, falls Ihr Unterstützung benötigt.‡북풍의 땅의 고통의 지구라트에 있는 타사리안이 엔킬라 사원 안에서 스컬지 20마리를 처치해 달라고 했습니다. 도움이 필요하면 백골의 두개골을 사용하십시오.‡Thassarian en El Zigurat de los Lamentos en la Tundra Boreal quiere que provoques 20 bajas entre los miembros de la Plaga dentro de la Ciudad Templo de En\'kilah. Usa los huesos de Escabroso si necesitas ayuda.‡Thassarian en El Zigurat de los Lamentos en la Tundra Boreal quiere que provoques 20 bajas entre los miembros de la Plaga dentro de la Ciudad Templo de En\'kilah. Usa los huesos de Escabroso si necesitas ayuda.‡Thassarian, à la Ziggourat Gémissante dans la Toundra Boréenne, vous demande d\'infliger 20 pertes aux troupes du Fléau dans la Ville-temple d\'En\'kilah. Utilisez les Os de Lourid si vous avez besoin d\'aide.‡悲叹通灵塔里的萨萨里安要求你杀进圣城恩其拉，消灭20名天灾军团士兵。如果你需要帮助，就使用鲁瑞德的骨头。‡北風凍原上悲嘯通靈塔中的薩沙理安要你對恩吉拉聖城中的天譴軍團造成20人的傷亡。你可以使用路瑞德的骨頭來協助你。',
  }
},
[11939] = {
  {
    '?????‡?????‡?????‡?????‡?????‡?????‡?????‡?????‡????',
    nil,
    nil,
  }
},
[11940] = {
  {
    'Caçada dracônica‡Охота на драконов‡Drachenjagd‡비룡 사냥‡Caza de dracos‡Caza de dracos‡La chasse au drake‡猎龙‡獵龍',
    nil,
    'Raelorasz quer que você use a Lança com Ponta de Sangue para dominar um Filhote de Draco do Nexus e trazê-lo até ele, no Escudo de Transitus.‡По просьбе Релораза используйте копье с окровавленным наконечником, чтобы подчинить детеныша дракона Нексуса, а затем принесите ему копье за Маскировочный щит.‡Raelorasz möchte, dass Ihr mithilfe des mit Blut benetzten Speers ein Nexusdrachenjunges bändigt und es anschließend zu ihm zurückbringt. Er befindet sich im Transitusschild.‡라엘로라즈가 라엘로라즈의 창을 사용해 마력의 탑 새끼 비룡 한 마리를 약해지게 한 다음 변위의 보호막으로 데려오라고 했습니다.‡Raelorasz quiere que uses la lanza manchada de sangre para dominar a una prole de draco de El Nexo y regreses junto a él en el Escudo de Tránsito.‡Raelorasz quiere que uses la lanza manchada de sangre para dominar a una prole de draco de El Nexo y regreses junto a él en el Escudo de Tránsito.‡Raelorasz vous demande d\'utiliser la Lance à pointe sanglante pour soumettre un Jeune drake du Nexus et de le rapporter au Bouclier Transitus.‡莱洛拉斯要你使用他的长矛驯服一只魔枢雏龙，并把它带回永生之盾交给他。‡瑞洛拉茲要你使用染血的長矛來制服一隻奧核雛龍，然後帶回隘境之盾交給他。',
  }
},
[11941] = {
  {
    'Enigmas...‡Загадочный обломок‡Rätselhaft...‡수수께끼‡Juntando las piezas...‡Juntando las piezas...‡Bizarre…‡奇怪……‡謎題…',
    nil,
    'Leve o Fragmento Esplendoroso para Raelorasz, no Escudo de Transitus.‡Принесите искрометный обломок Релоразу за Маскировочный щит.‡Bringt das schillernde Fragment zu Raelorasz im Transitusschild.‡변위의 보호막에 있는 라엘로라즈에게 화려하게 빛나는 조각을 가져가야 합니다.‡Lleva el fragmento centelleante a Raelorasz al Escudo de Tránsito.‡Lleva el fragmento centelleante a Raelorasz al Escudo de Tránsito.‡Apportez le Fragment scintillant à Raelorasz au Bouclier Transitus.‡把闪耀的碎片交给永生之盾的莱洛拉斯。‡將閃爍碎片交給隘境之盾的瑞洛拉茲。',
  }
},
[11942] = {
  {
    'Palavras de poder‡Слова могущества‡Worte der Macht‡힘이 깃든 말‡Palabras de poder‡Palabras de poder‡Mots de pouvoir‡通行之语‡真言',
    nil,
    'Thassarian no Zigurate dos Lamentos quer que você vá para a Cidade-Templo de En\'kilah e recupere os Pergaminho do Alto-sacerdote Talet-Kha na Torre da Dor, o Pergaminho do Alto-sacerdote Naferset na Torre da Decomposição e o Pergaminho do Alto-sacerdote Andorath.‡По поручению Тассариана, который находится у Стонущего зиккурата, отправляйтесь в храмовый город Эн\'кила и раздобудьте свиток верховного жреца Талет-Ха в Шпиле Боли, свиток верховного жреца Наферсета – в Шпиле Порчи и свиток верховного жреца Андората – в Шпиле Крови.‡Thassarian in der klagenden Ziggurat möchte, dass Ihr in die Tempelstadt En\'kilah geht und Hohepriester Talet-Khas Rolle aus der Säule der Pein, Hohepriester Nafersets Rolle aus der Säule der Fäulnis und Hohepriester Andoraths Rolle aus der Säule des Blutes besorgt.‡통곡의 지구라트에 있는 타사리안이 엔킬라 사원으로 가서 고통의 첨탑에서 대사제 탈레트카의 두루마리를, 부패의 첨탑에서 대사제 내페세트의 두루마리를, 그리고 피의 첨탑에서 대사제 안도라스의 두루마리를 가져와 달라고 했습니다.‡Thassarian en El Zigurat de los Lamentos quiere que vayas a la Ciudad Templo de En\'kilah y recuperes el pergamino del sumo sacerdote Talet-Kha de la Aguja de Dolor, el pergamino del sumo sacerdote Naferset de la Aguja de Putrefacción y el pergamino del sumo sacerdote Andorath de la Aguja de Sangre.‡Thassarian en El Zigurat de los Lamentos quiere que vayas a la Ciudad Templo de En\'kilah y recuperes el pergamino del sumo sacerdote Talet-Kha de la Aguja de Dolor, el pergamino del sumo sacerdote Naferset de la Aguja de Putrefacción y el pergamino del sumo sacerdote Andorath de la Aguja de Sangre.‡Thassarian, à la Ziggourat Gémissante, vous demande d\'aller à la Ville-temple d\'En\'kilah et de récupérer le Parchemin du grand prêtre Talet-Kha dans la Flèche de la Douleur, le Parchemin du grand prêtre Naferset dans la Flèche de la Décomposition et le Parchemin du grand prêtre Andorath dans la Flèche du Sang.‡悲叹通灵塔里的萨萨里安要求你前往圣城恩其拉，在痛苦尖塔中夺取高阶祭司塔雷坎的卷轴，在凋零尖塔中夺取高阶祭司纳菲塞特的卷轴，在鲜血尖塔中夺取高阶祭司安多拉斯的卷轴。‡悲嘯通靈塔的薩沙理安要你前往恩吉拉聖城，並且從苦痛尖塔回收高階祭司塔烈卡的卷軸;從凋零尖塔回收高階祭司納菲賽特的卷軸，以及從鮮血尖塔回收高階祭司安杜拉斯的卷軸。',
  }
},
[11943] = {
  {
    'A prisão‡Магическая клетка‡Die Zelle‡감옥‡La celda‡La celda‡La cellule‡牢笼‡囚籠',
    nil,
    'Raelorasz, no Escudo de Transitus, quer que você obtenha o Invólucro da Prisão do General Cerúleo e o Núcleo de Energia do Armipotente Goredrak.‡Добудьте тюремную обшивку у генерала Церулеана и энергетическое ядро у завоевателя Кровозмея по просьбе Релораза из лагеря под Маскировочным щитом.‡Raelorasz im Transitusschild möchte, dass Ihr General Cerulean die Gefängnisummantelung und Kriegshetzer Goredrak den Energiekern abnehmt.‡변위의 보호막에 있는 라엘로라즈가 사령관 세룰리안에게서 감옥 외피를, 전쟁의 인도자 고어드락에게서 에너지 핵을 구해달라고 했습니다.‡Raelorasz en el Escudo de Tránsito quiere que consigas los marcos de la prisión del general Cerulean y el núcleo de energía del belisario Goredrak.‡Raelorasz en el Escudo de Tránsito quiere que consigas los marcos de la prisión del general Cerulean y el núcleo de energía del belisario Goredrak.‡Raelorasz, au Bouclier Transitus, vous demande de vous procurer l\'Armature de la prison sur le Général Céruléan, et le Noyau énergétique sur le Porteguerre Draksang.‡永生之盾的莱洛拉斯要你从塞鲁利恩将军手里夺取牢笼外壳，从战争使者戈德拉克手里夺取能量核心。‡隘境之盾的瑞洛拉茲要你從天藍將軍身上取得監禁外殼，以及從戰爭使者寇瑞卓克身上取得能量之核。',
  }
},
[11944] = {
  {
    'Cercados!‡В окружении!‡Umzingelt!‡진퇴양난!‡¡Rodeados!‡¡Rodeados!‡Encerclés !‡我们被包围了！‡受到包圍!',
    nil,
    'Cabo Venn, no Campo da Morte, quer que você mate 7 Defensores do Zigurate.‡По заданию капрала Венна убейте 7 защитников зиккурата.‡Korporal Venn in Todeswehr möchte, dass Ihr 7 Verteidiger der Ziggurat niederstreckt.‡죽음의 언덕에 있는 하사관 벤이 지구라트 파수꾼 7마리를 처치해 달라고 부탁했습니다.‡El cabo Venn en el Confín de la Muerte quiere que mates a 7 defensores del zigurat.‡El cabo Venn en el Confín de la Muerte quiere que mates a 7 defensores del zigurat.‡Le Caporal Venn, au Séjour de la Mort, veut que vous tuiez 7 Défenseurs de la ziggourat.‡死亡营地的韦恩下士希望你消灭7名通灵塔防御者。‡死亡看臺的下士維恩要你去殺掉7個通靈塔防衛者。',
  }
},
[11945] = {
  {
    'Preparação para o pior‡Подготовка к самому худшему‡Auf das Schlimmste gefasst sein‡최악의 사태에 대비하라‡Preparándose para lo peor‡Preparándose para lo peor‡Se préparer au pire‡做最坏的打算‡作最壞的打算',
    nil,
    'Utaik quer que você junte 8 Suprimentos de Kaskala, em Kaskala.‡По просьбе Утайка соберите в Каскале 8 ящиков припасов Каскала.‡Utaik möchte, dass Ihr nach Kaskala geht und 8 Kisten mit Vorräten von Kaskala sammelt.‡우타이크가 카스칼라에서 카스칼라 보급품 8개를 모아 달라고 부탁했습니다.‡Utaik quiere que reúnas 8 suministros de Kashala en Kashala.‡Utaik quiere que reúnas 8 suministros de Kashala en Kashala.‡Utaik vous demande de ramasser 8 Fournitures de Kaskala à Kaskala.‡乌泰克要你在卡斯卡拉收集8份卡斯卡拉补给品。‡戊塔克需要你在卡斯卡拉收集8個卡斯卡拉補給品。',
  }
},
[11946] = {
  {
    'Keristrasza‡Керистраза‡Keristrasza‡케리스트라자‡Keristrasza‡Keristrasza‡Keristrasza‡克莉斯塔萨‡凱瑞史卓莎',
    nil,
    'Keristrasza quer que você fale com ela quando estiver pronto para confrontar Malygos.|n|nCaso perca sua Prisão Arcana Aumentada, fale com Raelorasz no Escudo de Transitus.‡Поговорите с Керистразой, когда будете готовы к встрече с Малигосом.|n|nЕсли потеряете свою магическую клетку, поговорите с Релоразом у Маскировочного щита.‡Keristrasza möchte, dass Ihr sie ansprecht, sobald Ihr bereit seid, Malygos entgegenzutreten.|n|nSprecht mit Raelorasz im Transitusschild, falls Ihr Euer verstärktes arkanes Gefängnis verlieren solltet.‡케리스트라자가 당신에게 말리고스와 맞설 준비를 돕겠다면 자신에게 이야기하라고 했습니다.|n|n촘촘한 비전 감옥을 잃어버리면 변위의 보호막에 있는 라엘로라즈와 대화해야 합니다.‡Keristrasza quiere que hables con ella cuando estés preparado para enfrentarte a Malygos.|n|nSi pierdes tu prisión Arcana aumentada, habla con Raelorasz en el Escudo de Transito.‡Keristrasza quiere que hables con ella cuando estés preparado para enfrentarte a Malygos.|n|nSi pierdes tu prisión Arcana aumentada, habla con Raelorasz en el Escudo de Transito.‡Keristrasza vous demande de lui parler quand vous serez prêt à préparer la confrontation avec Malygos.|n|nSi vous perdez votre Prison arcanique améliorée, parlez à Raelorasz au Bouclier Transitus.‡当你做好与玛里苟斯战斗的准备之后，与克莉斯塔萨谈一谈。|n|n如果你把奥术牢笼弄丢了，可以去找永生之盾的莱洛拉斯。‡凱瑞史卓莎要你在準備好對抗瑪里苟斯之後再和她談話。|n|n如果你弄丟了增強的秘法監牢，和隘境之盾的瑞洛拉茲談談。',
  }
},
[11947] = {
  {
    '‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    '‡Убейте лейтенанта Градня, помощника Ахуна, вызвав его при помощи Камня Льда к Этель-Ретор в Пустошах, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens am Ethel Rethor in Desolace den Leutnant des Eishagels, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡잊혀진 땅의 에텔 레소르에서 얼음 기둥을 사용하여 우박의 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Granizo que invoques desde la piedra de hielo situada en Ethel Rethor en Desolace. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Granizo que invoques desde la piedra de hielo situada en Ethel Rethor en Desolace. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Grêlon invoqué par la Pierre de glace située à Ethel rethor en Désolace, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡‡',
  }
},
[11948] = {
  {
    '‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    '‡Убейте лейтенанта Промозглый Ветер, помощника Ахуна, вызвав его при помощи Камня Льда на островке элементалей воды к западу от Тернистой долины, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens auf der Insel der Wasserelementare im Westen des Schlingendorntals den Leutnant des Eiswinds, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡가시덤불 골짜기 서쪽, 물의 정령들이 있는 섬에서 얼음 기둥을 사용하여 서리바람 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Viento Gélido que invoques desde la piedra de hielo situada en la isla de los elementales de agua en la zona oeste de Vega de Tuercespina. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Viento Gélido que invoques desde la piedra de hielo situada en la isla de los elementales de agua en la zona oeste de Vega de Tuercespina. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant Noroît invoqué par la Pierre de glace située sur l\'île de l\'élémentaire d\'eau à l\'ouest de la Vallée de Strangleronce, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡‡',
  }
},
[11949] = {
  {
    'De graça, não!‡Не сдаваться без боя!‡Nicht ohne einen Kampf!‡싸워야 산다!‡¡No sin luchar!‡¡No sin luchar!‡Pas sans nous battre !‡战斗到底！‡決心一戰!',
    nil,
    'Ataika quer que você mate 12 Saqueadores Kvaldir, em Kaskala.‡По просьбе Атаики убейте 12 налетчиков из племени Квалдир в Каскале.‡Ataika möchte, dass Ihr nach Kaskala geht und dort 12 Räuber der Kvaldir tötet.‡아타이카가 카스칼라에서 크발디르 약탈자 12명을 처치해 달라고 부탁했습니다.‡Ataika quiere que mates a 12 asaltantes Kvaldir en Kashala.‡Ataika quiere que mates a 12 asaltantes Kvaldir en Kashala.‡Ataika vous demande de tuer 12 Écumeurs kvaldirs à Kaskala.‡阿泰卡要你在卡斯卡拉杀死12名克瓦迪尔劫掠者。‡阿泰卡要你在卡斯卡拉殺死12個科瓦迪爾劫掠者。',
  }
},
[11950] = {
  {
    'A sabedoria de Muahit‡Мудрость Муахита‡Muahits Weisheit‡무아히트의 지혜‡La sabiduría de Muahit‡La sabiduría de Muahit‡La sagesse de Muahit‡穆希特的智慧‡穆亞希的智慧',
    nil,
    'Encontre o Ancião Muahit, em Kaskala.‡Найдите в Каскале старейшину Муахита.‡Findet den Ältesten Muahit in Kaskala.‡카스칼라에서 장로 무아히트를 찾아야 합니다.‡Encuentra al anciano Muahit en Kashala.‡Encuentra al anciano Muahit en Kashala.‡Trouvez l\'Ancien Muahit à Kaskala.‡在卡斯卡拉找到长者穆希特。‡在卡斯卡拉尋找長者穆亞希。',
  }
},
[11951] = {
  {
    'Isca e anzol‡Приманка‡Köder und Rute‡미끼 만들기‡Caer en el anzuelo‡Caer en el anzuelo‡Appâter le dragon‡诱饵‡誘餌與攻擊',
    nil,
    'Keristrasza pediu-lhe que consiga 10 Estilhaços de Mana Cristalizados em Gelarra.|n|nCaso perca sua Prisão Arcana Aumentada, fale com Raelorasz no Escudo de Transitus.‡Соберите в Хладарре 10 осколков кристаллизованной маны по просьбе Керистразы.|n|nЕсли потеряете свою магическую клетку, поговорите с Релоразом у Маскировочного щита.‡Keristrasza hat Euch gebeten, 10 kristallisierte Manasplitter in Kaltarra zu sammeln.|n|nFalls Ihr Euer verstärktes arkanes Gefängnis verliert, sprecht mit Raelorasz beim Transitusschild.‡케리스트라자가 콜다라 주변에서 결정화된 마나 파편 10개를 구해달라고 부탁했습니다.|n|n촘촘한 비전 감옥을 잃어버리면 변위의 보호막에 있는 라엘로라즈와 대화해야 합니다.‡Keristrasza te ha pedido que reúnas 10 fragmentos de maná cristalizado que se encuentran por Gelidar.|n|nSi pierdes tu prisión Arcana aumentada, habla con Raelorasz en el Escudo de Tránsito.‡Keristrasza te ha pedido que reúnas 10 fragmentos de maná cristalizado que se encuentran por Gelidar.|n|nSi pierdes tu prisión Arcana aumentada, habla con Raelorasz en el Escudo de Tránsito.‡Keristrasza vous a demandé de collecter 10 Éclats de mana cristallisé dans les alentours de Frimarra.|n|nSi vous perdez votre Prison arcanique améliorée, parlez à Raelorasz au Bouclier Transitus.‡克莉斯塔萨要你在考达拉一带收集10块晶化法力碎片。|n|n如果你把奥术牢笼弄丢了，可以去找永生之盾的莱洛拉斯。‡凱瑞史卓莎要你從凜懼島四周收集10個晶化法力裂片。|n|n如果你弄丟了增強的秘法監牢，和隘境之盾的瑞洛拉茲談談。',
  }
},
[11952] = {
  {
    '‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    '‡Убейте лейтенанта Лютостужу, помощника Ахуна, вызвав его при помощи Камня Льда в пещере под горами Огненной стражи на северо-западе от Тлеющего ущелья, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in der Höhle unter dem Feuerwachtgrat im Nordwesten der Sengenden Schlucht den Leutnant des Eises, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡이글거리는 협곡 북서쪽, 불망루 마루 아래쪽에 있는 동굴에서 얼음 기둥을 사용하여 극한의 부관을 소환해 처치한 후, 대도시에 있는 대지 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Frígido que invoques desde la piedra de hielo situada en la cueva bajo Cresta Vigía en el noroeste de La Garganta de Fuego. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Frígido que invoques desde la piedra de hielo situada en la cueva bajo Cresta Vigía en el noroeste de La Garganta de Fuego. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant algide invoqué par la Pierre de glace située dans la caverne sous la Crête de Guet-du-feu, au nord-ouest de la Gorge des Vents brûlants, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡‡',
  }
},
[11953] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    'Mate o Tenente Glacial evocado pela Pedra de Gelo, localizada no Passeio do Crepúsculo que fica na parte norte de Silithus. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте лейтенанта Хладноглыба, помощника Ахуна, вызвав его при помощи Камня Льда в Сумеречной пещере в северном Силитусе, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in den Kavernen des Schattenhammers im Norden von Silithus den Leutnant des Gletschers, zerstört ihn und kehrt anschließend zum Urahnen des Irdenen Rings zurück. Letzterer befindet sich in einer der Hauptstädte.‡실리더스 북쪽 황혼의 터에서 얼음 기둥을 사용하여 빙하의 부관을 소환해 처치한 후, 대도시에 있는 속세의 고리회 장로에게 돌아와야 합니다.‡Mata al teniente Glacial que invoques desde la piedra de hielo situada en el Paseo Crepúsculo en la zona norte de Silithus. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al teniente Glacial que invoques desde la piedra de hielo situada en el Paseo Crepúsculo en la zona norte de Silithus. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Lieutenant glaciaire invoqué par la Pierre de glace située dans le défilé du Crépuscule, au nord de Silithus, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往希利苏斯北部的暮光小径，杀死从寒冰之石中召唤出来的冰川上尉，然后返回任意主城中的大地之环长者处复命。‡把冰石召喚出來的冰川副官殺死，冰石就在希利蘇斯北部的暮光小徑。然後向主城中的陶土議會長老回報。',
  }
},
[11954] = {
  {
    'Contra-ataque‡Ответный удар‡Zurückschlagen‡되받아치기‡El contraataque‡El contraataque‡Contre-attaquer‡反击‡反攻',
    nil,
    'Mate o Templário Glacial evocado pela Pedra de Gelo, localizada perto do Portal Negro, que fica na Península Fogo do Inferno. Depois, retorne ao Ancião da Harmonia Telúrica em uma capital.‡Убейте ледяного храмовника, помощника Ахуна, вызвав его при помощи камня льда к Темному порталу на полуострове Адского Пламени, затем вернитесь к старейшине Служителей Земли в столицу.‡Beschwört mithilfe des Eisbrockens in der Nähe des Dunklen Portals auf der Höllenfeuerhalbinsel den eisigen Templer, zerstört ihn und kehrt anschließend zu einem der Urahnen des Irdenen Rings zurück. Letztere befinden sich in den Hauptstädten.‡지옥불 반도의 어둠의 문 근처에서 얼음 기둥을 사용하여 빙하의 기사를 소환해 처치한 후, 대도시에 있는 속세의 고리회 장로에게 돌아와야 합니다.‡Mata al templario Glacial que invoques desde la piedra de hielo situada cerca de El Portal Oscuro en la Península del Fuego Infernal. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Mata al templario glacial que invoques desde la piedra de hielo situada cerca de El Portal Oscuro en la Península del Fuego Infernal. Después, ve a ver al anciano del Anillo de la Tierra en alguna de las capitales.‡Tuez le Templier glaciaire invoqué par la Pierre de glace située près de la Porte des ténèbres dans la Péninsule des flammes infernales, puis retournez voir un Ancien du Cercle terrestre dans l\'une des capitales.‡前往地狱火半岛的黑暗之门，杀死从寒冰之石中召唤出来的冰川圣殿骑士，然后返回任意主城中的大地之环长者处复命。‡把冰石召喚出來的冰川聖殿騎士殺死，冰石就在地獄火半島靠近黑暗之門的地方。然後向主城中的陶土議會長老回報。',
  }
},
[11955] = {
  {
    'Ahune, o Senhor do Gelo‡Ахун, Повелитель Холода‡Ahune der Frostfürst‡서리 군주 아훈‡Ahune, el Señor de la Escarcha‡Ahune, el Señor de la Escarcha‡Ahune, le seigneur du Givre‡冰霜之王埃霍恩‡艾胡恩，冰霜領主',
    nil,
    'Viaje para o Pátio dos Escravos no Reservatório Presacurva, que fica no Pântano Zíngaro e fale com Numa Irmã das Nuvens‡Отправляйтесь в Узилище в резервуар Кривого Клыка, что в Зангартопи, и поговорите с Нумой Сестрой Облаков.‡Begebt Euch in die Sklavenunterkünfte im Echsenkessel in den Zangarmarschen und sprecht mit Numa Wolkenschwester.‡장가르 습지대 지역에 있는 갈퀴송곳니 저수지의 강제 노역소로 가서 누마 클라우드시스터와 대화해야 합니다.‡Viaja hasta el Recinto de los Colmillo Torcido en Marisma de Zangar y habla con Numa Nubesoror.‡Viaja hasta el Recinto de los Colmillo Torcido en Marisma de Zangar y habla con Numa Nubesoror.‡Voyagez jusqu\'à l\'Enclos aux esclaves, dans le Réservoir de Glissecroc, au Marécage de Zangar, et parlez à Numa Sœur-des-nuages.‡前往赞加沼泽盘牙水库的奴隶围栏，与努玛·云女谈一谈。‡前往贊格沼澤的盤牙蓄湖，進入其中的奴隸監獄，並且和紐瑪·雲女交談。',
  }
},
[11956] = {
  {
    'Encontre o filactério‡Поиски талисмана‡Findet das Phylakterium‡성물함 찾기‡Encuentra la filacteria‡Encuentra la filacteria‡Trouver le phylactère‡寻找护命匣‡尋找骨匣',
    nil,
    'Vá para o Campo da Morte e cavalgue a égua Crepúsculo até a localização do Filactério de Tanathal. Pegue-o e leve-o de volta para Thassarian dentro do Zigurate dos Lamentos.‡Отправляйтесь на Стоянку Смерти и скачите на Сумраке к месту, где находится талисман Танатала. Добудьте его и принесите Тассариану в Стонущий зиккурат.‡Begebt Euch nach Todeswehr und reitet mit Abenddämmerung zu der Stelle, an der sich Tanathals Phylakterium befindet. Nehmt es an Euch und bringt anschließend zu Thassarian im Inneren der klagenden Ziggurat.‡죽음의 언덕으로 가서 황혼이를 타고 타나탈의 성물함이 있는 곳으로 이동해 성물함을 획득한 다음, 통곡의 지구라트에 있는 타사리안에게 가져가야 합니다.‡Ve hasta Confín de la Muerte y cabalga con Anochecer hasta el lugar donde se encuentra la filacteria de Tanathal. Hazte con ella y llévasela a Thassarian dentro de El Zigurat de los Lamentos.‡Ve hasta Confín de la Muerte y cabalga con Anochecer hasta el lugar donde se encuentra la filacteria de Tanathal. Hazte con ella y llévasela a Thassarian dentro de El Zigurat de los Lamentos.‡Allez au Séjour de la Mort, puis chevauchez Vespéran jusqu\'à l\'endroit où se trouve le Phylactère de Thanathal. Récupérez-le, puis retournez voir Thassarian dans la Ziggourat Gémissante.‡前往死亡营地，骑着黄昏找到塔纳沙尔藏匿护命匣的地方。将它找出来并带回悲叹通灵塔，交给萨萨里安。‡前往死亡看臺騎上幽暮，找到塔那薩爾骨匣的位置。然後把它帶回來交給悲嘯通靈塔的薩沙理安。',
  }
},
[11957] = {
  {
    'O fim de Saragosa‡Смерть Сарагосе!‡Saragosas Ende‡사라고사의 최후‡El final de Saragosa‡El final de Saragosa‡La fin de Saragosa‡莎拉苟萨的末日‡薩拉苟莎的下場',
    nil,
    'Keristrasza quer que você use a Concentração de Poder para atrair Saragosa e, então, derrotá-la.‡По просьбе Керистразы используйте средоточие магии для привлечения внимания Сарагосы, а затем сразитесь с ней.‡Keristrasza möchte, dass Ihr mithilfe des arkanen Kraftfokus\' Saragosa anlockt und sie anschließend besiegt.‡케리스트라자가 비전 마력 집중기를 사용해 사라고사를 유인하여 처치해 달라고 부탁했습니다.‡Keristrasza quiere que uses el foco de poder para atraer a Saragosa y que después la derrotes.‡Keristrasza quiere que uses el foco de poder para atraer a Saragosa y que después la derrotes.‡Keristrasza vous demande d\'utiliser le Focalisateur de puissance pour piéger Saragosa, puis de la vaincre.‡克莉斯塔萨要你使用奥术能量源引出莎拉苟萨并打败她。‡凱瑞史卓莎要你使用能量聚合體來引誘薩拉苟莎，然後擊敗她。',
  }
},
[11958] = {
  {
    'Não deixe nada se perder‡Чтоб ничего не пропало!‡Nichts darf verderben‡여행 물자 회수‡No dejes que nada se eche a perder‡No dejes que nada se eche a perder‡Surtout, ne laissons rien perdre‡不要浪费‡不可浪費',
    nil,
    'Recupere 6 Mercadorias Roubadas de Moa\'ki dos guaxinantes. Devolva as mercadorias para o Ancião Ko\'nani, no Porto Moa\'ki.‡Отберите у волчеров 6 украденных припасов Моа\'ки. Верните их старейшине Ко\'нани в Гавани Моа\'ки.‡Beschafft von den Wolvar 6 gestohlene Güter von Moa\'ki. Bringt sie zum Ältesten Ko\'nani im Hafen Moa\'ki zurück.‡훔친 모아키 물품 6개를 울바르에게서 되찾은 다음 모아키 항구에 있는 장로 코나니에게 가져가야 합니다.‡Recupera 6 bienes Moa\'ki robados de los wolvar y devuélveselos al anciano Ko\'nani en el Puerto Moa\'ki.‡Recupera 6 bienes Moa\'ki robados de los wolvar y devuélveselos al anciano Ko\'nani en el Puerto Moa\'ki.‡Reprenez 6 lots de Marchandises moa’ki volées aux varleus, puis remettez-les au Chef Ko’nani, à Port-Moa’ki.‡从狼獾人手中夺回6份被偷走的莫亚基货物，把它们带回龙骨荒野的莫亚基港口，交给长者库纳尼。‡從獾狼怪身上奪回6個被偷取的默亞基貨物。將貨物交還給默亞基港的長者科納尼。',
  }
},
[11959] = {
  {
    'Mate Loguhn‡Убить Логуна!‡Tötet Loguhn‡로군 처치‡Mata a Loguhn‡Mata a Loguhn‡Tuez Loguhn‡消灭洛根‡殺掉洛根',
    nil,
    'Esfregue o Sangue de Loguhn em você e então fale novamente com o Ancião Ko\'nani no Porto Moa\'ki.‡Намажьтесь кровью Логуна и возвращайтесь к старейшине Ко\'нани в гавань Моа\'ки.‡Zeichnet Euch mit Loguhns Blut und kehrt dann zum Ältesten Ko\'nani im Hafen Moa\'ki zurück.‡로군의 피를 온몸에 바르고 모아키 항구에 있는 장로 코나니에게 돌아가야 합니다.‡Embadúrnate con la sangre de Loguhn y vuelve junto al anciano Ko\'nani en el Puerto Moa\'ki.‡Embadúrnate con la sangre de Loguhn y vuelve junto al anciano Ko\'nani en el Puerto Moa\'ki.‡Aspergez-vous du Sang de Loguhn, puis retournez voir le Chef Ko’nani à Port-Moa’ki.‡将洛根的血抹在身上，然后回到龙骨荒野的莫亚基港口，向长者库纳尼复命。‡將洛根之血塗抹在你身上之後，向默亞基港的長者科納尼回報。',
  }
},
[11960] = {
  {
    'Planos para o futuro‡Планы на будущее‡Zukunftsplanungen‡미래를 위한 계획‡Pensando en el futuro‡Pensando en el futuro‡Préparer l\'avenir‡未来的种子‡計畫未來',
    nil,
    'Colete 12 filhotes da Clareira Nevada. Leve-os para o Coureador Mau\'i no Porto Moa\'ki.‡Соберите 12 щенков Поляны Снегопада. Принесите их зверолову Мау\'и в гавани Моа\'ки.‡Sammelt 12 Schneewehenwelpen und liefert sie anschließend bei Fallensteller Mau\'i im Hafen Moa\'ki ab.‡눈사태숲일족 새끼 12마리를 모아키 항구에 있는 덫사냥꾼 마우이에게 가져가야 합니다.‡Recoge 12 cachorros de Claro Avalancha. Llévaselos al trampero Mau\'i al Puerto Moa\'ki.‡Recoge 12 cachorros de Claro Avalancha. Llévaselos al trampero Mau\'i al Puerto Moa\'ki.‡Récupérez 12 Louveteaux de la clairière de Tombeneige, puis remettez-les au Trappeur Mau’i à Port-Moa’ki.‡找到12个飘雪林地幼崽，把他们带回莫亚基港口，交给猎手莫伊。‡收集12個落雪林地小獾狼。把他們交給默亞基港的陷捕者茂伊。',
  }
},
[11961] = {
  {
    'Que os espíritos nos guardem‡Духи присматривают за нами‡Die Geister wachen über uns‡영혼께서 지켜보신다‡Los espíritus nos protegen‡Los espíritus nos protegen‡Que les esprits veillent sur nous‡神灵的眷顾‡精靈在看照著我們',
    nil,
    'O Ancião Muahit, na Baía do Bafo de Njord, quer que você ache o cadáver de Iruk na água e recupere o Totem de Issliruk.‡Найдите тело Ирука в воде, заберите тотем Иссилрука и принесите старейшине Муахиту в бухту Дыхания Ньорда.‡Ältester Muahit in der Bucht des Njordatems möchte, dass Ihr im Wasser nach Iruks Leiche sucht und Issliruks Totem bergt.‡요르드의 숨결 만에 있는 장로 무아히트가 물속에서 이루크의 시체를 찾아내고 이슬리루크의 토템을 찾아 달라고 부탁했습니다.‡El anciano Muahit en Bahía Aliento de Njord quiere que encuentres el cadáver de Iruk dentro del agua y recuperes el tótem de Issliruk.‡El anciano Muahit en Bahía Aliento de Njord quiere que encuentres el cadáver de Iruk dentro del agua y recuperes el tótem de Issliruk.‡L\'Ancien Muahit, dans la Baie du Souffle de Njord, vous demande de trouver le Cadavre d\'Iruk dans l\'eau et de récupérer le Totem d\'Issliruk.‡尼约德海湾的长者穆希特要你潜入水中找到伊鲁克的尸体，取回伊斯利鲁克的图腾。‡尼約德之息海灣的長者穆亞希要你進入水中去尋找埃魯克的屍體，並且拿回依斯里魯克的圖騰。',
  }
},
[11962] = {
  {
    'Uma última entrega‡Последняя партия‡Eine letzte Lieferung‡마지막 배달‡Una última entrega‡Una última entrega‡Une dernière livraison‡最后一批矿石‡最後一次遞送',
    nil,
    'Entregue o Caixote de Minério de Algures para Hilda Forjapétrea, na Bastilha Valentia.‡Доставьте ящик руды из Далечья Хильде Каменной Кузне в крепость Отваги.‡Liefert die Kiste mit Erz aus Fernhain zu Hilda Steinschmiede in der Valianzfeste.‡파샤이어 광석 상자를 용맹의 성채에 있는 힐다 스톤포지에게 전달해야 합니다.‡Llévale el cajón de mena de Lindeallá a Hilda Forjapiedra en la Fortaleza Denuedo.‡Llévale el cajón de mena de Lindeallá a Hilda Forjapiedra en la Fortaleza Denuedo.‡Apportez la Caisse de minerai de Comté-lointaine à Hilda Forge-pierre au Donjon de la Bravoure.‡将一箱致远郡矿石交给无畏要塞里的希尔达·熔石。‡把遠郡礦石箱送交給驍勇要塞的希爾妲·石鑄。',
  }
},
[11963] = {
  {
    'Armas para Algures‡Оружие для Далечья‡Waffen für Fernhain‡파샤이어에 무기를‡Armas para Lindeallá‡Armas para Lindeallá‡Des armes pour Comté-lointaine‡给致远郡的武器‡給遠郡的武器',
    nil,
    'Fale novamente com Geraldo Delleprane, em Algures.‡Вернитесь к Джеральду Грину в Далечье.‡Kehrt zu Gerald Grün in Fernhain zurück.‡파샤이어의 제랄드 그린에게 돌아가야 합니다.‡Vuelve junto a Gerald Verde en Lindeallá.‡Vuelve junto a Gerald Verde en Lindeallá.‡Retournez voir Gerald Green à Comté-lointaine.‡回到致远郡，向吉拉德·格林复命。‡回去找遠郡的吉羅德·葛林。',
  }
},
[11964] = {
  {
    'Incenso para as faíscas de verão‡Благовония для летних пламеней‡Rauchwerk für die Sommerflämmlinge‡한여름 불덩이에게 향료를‡Incienso para los agostizos de verano‡Incienso para los agostizos de verano‡De l\'encens pour les brûletins de l\'été‡夏季的焚香‡夏日小焦焰的薰香',
    nil,
    'O Historiador do Festival quer que você ofereça um Incenso Estival para uma Faísca de Verão do lado de fora de qualquer acampamento da Aliança.‡Хранитель мудрости Праздника хочет, чтобы вы отнесли благовония Лета летнему пламеню к любому поселению Альянса.‡Der Meister der Lehren möchte, dass Ihr einem Sommerflämmling Rauchwerk des Sommers bringt. Die Flämmlinge befinden sich außerhalb jeder Siedlung der Allianz.‡한여름 축제 현자가 얼라이언스 마을 바깥에 있는 한여름 불덩이에게 한여름 향료를 가져가 달라고 부탁했습니다.‡El maestro cultural del Festival quiere que le lleves incienso de verano a algún agostizo de verano a las afueras de cualquier asentamiento de la Alianza.‡El maestro cultural del Festival quiere que le lleves incienso de verano a algún agostizo de verano a las afueras de cualquier asentamiento de la Alianza.‡Le maître des traditions de la fête vous demande d\'apporter de l\'Encens estival à un Brûletin d\'été à l\'extérieur de n\'importe quelle ville de l\'Alliance.‡节日博学者希望你带着夏季焚香前往任意联盟营地外的篝火旁，将焚香交给该处的夏季火元素。‡節慶博學大師要你把夏日薰香帶給任何一座聯盟據點外的夏日小焦焰。',
  }
},
[11965] = {
  {
    'Chamado às armas!‡К оружию!‡Zu den Waffen!‡전투 준비!‡¡Llamamiento a las armas!‡¡Llamamiento a las armas!‡Appel aux armes !‡集结的钟声！‡集結!',
    nil,
    'Vá para a prefeitura de Algures e toque o sino.‡Войдите в здание ратуши в Далечье и позвоните в колокол, находящийся в этом здании.‡Geht zum Rathaus in Fernhain und lasst die Glocke läuten.‡파샤이어의 마을회관 건물에서 종을 울려야 합니다.‡Ve hasta el concejo de Lindeallá y toca la campana que hay en su interior.‡Ve hasta el concejo de Lindeallá y toca la campana que hay en su interior.‡Allez dans le bâtiment de l\'hôtel de ville de Comté-lointaine et faites sonner la cloche à l\'intérieur.‡前往致远郡的议事大厅，敲响里面的钟。‡前往遠郡的市鎮廳，敲響裡面的警鐘。',
  }
},
[11966] = {
  {
    'Incenso para as faíscas do festival‡Благовония для праздничных сполохов‡Rauchwerk für die Festflämmlinge‡축제 불덩이에게 향료를‡Incienso para los agostizos del Festival‡Incienso para los agostizos del Festival‡De l\'encens pour les brûletins de la fête‡节日的焚香‡節慶小焦焰薰香',
    nil,
    'O Contador de Histórias do Festival quer que você ofereça um Incenso Estival para uma Faísca do Festival do lado de fora de qualquer acampamento da Horda.‡Праздничный сказитель хочет, чтобы вы отнесли благовония Лета праздничному сполоху к любому поселению Орды.‡Der Geschichtenerzähler möchte, dass Ihr einem Festflämmling Rauchwerk des Sommers bringt. Die Flämmlinge befinden sich außerhalb jeder Siedlung der Horde.‡축제 이야기꾼이 한여름 향료를 호드 마을 외곽지역에 있는 축제 불덩이에게 가져다주라고 했습니다.‡El cuentacuentos del Festival quiere que le lleves incienso de verano a algún agostizo del Festival a las afueras de cualquier asentamiento de la Horda.‡El cuentacuentos del Festival quiere que le lleves incienso de verano a algún agostizo del Festival a las afueras de cualquier asentamiento de la Horda.‡Le conteur de la fête vous demande d\'apporter de l\'Encens estival à un Brûletin de la fête à l\'extérieur de n\'importe quelle ville de la Horde.‡节日诗人希望你带着夏季焚香前往任意部落营地外的篝火旁，将焚香交给该处的夏季火元素。‡節慶故事使者要你把夏日薰香帶給任何一座部落據點外的節慶小焦焰。',
  }
},
[11967] = {
  {
    'Alistamento vermelho‡Сбор красных драконов‡Die Roten versammeln‡붉은용군단의 집결‡Reunir a los Rojos‡Reunir a los Rojos‡Rassembler les rouges‡集结红龙‡召集紅龍',
    nil,
    'Keristrasza pediu para que a leve até Raelorasz, no Escudo de Transitus.‡Отведите Керистразу к Релоразу к Маскировочному щиту.‡Keristrasza hat Euch gebeten, sie zu Raelorasz am Transitusschild zu bringen.‡케리스트라자가 변위의 보호막에 있는 라엘로라즈에게 자신을 데려가 달라고 부탁했습니다.‡Keristrasza te ha pedido que la lleves junto a Raelorasz en el Escudo de Tránsito.‡Keristrasza te ha pedido que la lleves junto a Raelorasz en el Escudo de Tránsito.‡Keristrasza vous a demandé de la conduire auprès de Raelorasz au Bouclier Transitus.‡克莉斯塔萨要你带她去永生之盾会见莱洛拉斯。‡凱瑞史卓莎請你帶她去隘境之盾找瑞洛拉茲。',
  }
},
[11968] = {
  {
    'O virar das marés‡Поворот колеса Фортуны‡Das Blatt wendet sich‡전세 뒤집기‡Las circunstancias cambian‡Las circunstancias cambian‡Le vent tourne‡情势扭转‡局勢轉變',
    nil,
    'O Ancião Muahit quer que você mate Heigarr, o Horrível, na Baía do Bafo de Njord.‡По просьбе старейшины Муахита убейте Хейгарра Душегуба в бухте Дыхания Ньорда.‡Ältester Muahit möchte, dass Ihr Euch zur Bucht des Njordatems begebt und Heigarr den Schrecklichen erschlagt.‡장로 무아히트가 요르드의 숨결 만에서 공포의 헤이가르를 처치해 달라고 부탁했습니다.‡El anciano Muahit quiere que mates a Heigarr el Horrible en Bahía Aliento de Njord.‡El anciano Muahit quiere que mates a Heigarr el Horrible en Bahía Aliento de Njord.‡L\'Ancien Muahit vous a demandé de tuer Heigarr l\'Horrible, dans la Baie du Souffle de Njord.‡长者穆希特要你去除掉尼约德海湾的可怕的赫迦尔。‡長者穆亞希要你去尼約德之息海灣殺死可怕的海嘉爾。',
  }
},
[11969] = {
  {
    'Acionando a armadilha‡Сработавший капкан‡Die Falle zuschnappen lassen‡공격 신호‡Soltar la trampa‡Soltar la trampa‡Déclencher le piège‡触动陷阱‡發動陷阱',
    nil,
    'Raelorasz quer que você use a Centelha de Raelorasz no Sinal de Fumaça em Gelarra.‡Используйте сигнальный огонь Релораза у северо-западного входа в Нексус по просьбе Релораза.‡Raelorasz möchte, dass Ihr Raelorasz\' Funken beim Signalfeuer in Kaltarra benutzt.‡라엘로라즈가 콜다라에 있는 봉화에 라엘로라즈의 불꽃을 사용해 달라고 부탁했습니다.‡Raelorasz quiere que uses la chispa de Raelorasz en la señal de fuego de Gelidar.‡Raelorasz quiere que uses la chispa de Raelorasz en la señal de fuego de Gelidar.‡Raelorasz vous demande d\'utiliser l\'Étincelle de Raelorasz sur le feu de signal à Frimarra.‡莱洛拉斯要你在考达拉的信号火焰处使用莱洛拉斯的火花。‡瑞洛拉茲要你在凜懼島的火源信號使用瑞洛拉茲的燃信。',
  }
},
[11970] = {
  {
    'O mestre do folclore de verão‡Хранитель мудрости праздника Середины Лета‡Der Meister der Sommerlehre‡한여름 불꽃축제의 의미‡El maestro en tradición de verano‡El maestro en tradición de verano‡Le maître des traditions estivales‡节日博学者‡夏日傳說大師',
    nil,
    'Fale com um Catedrático do Festival em qualquer capital da Aliança.‡Поговорите с Хранителем мудрости Празднества в любой из столиц Альянса.‡Sprecht mit einem Meister der Lehren in einer der Hauptstädte.‡얼라이언스 대도시에 있는 한여름 축제 현자와 대화해야 합니다.‡Habla con el maestro cultural del Festival en cualquiera de las capitales de la Alianza.‡Habla con el maestro cultural del Festival en cualquiera de las capitales de la Alianza.‡Parlez au Maître des traditions de la fête dans n\'importe quelle capitale de l\'Alliance.‡与任意联盟主城的节日博学者谈一谈。‡和聯盟主城的任何一位節慶博學大師談談。',
  }
},
[11971] = {
  {
    'O contador de histórias de verão‡Сказитель Летнего праздника‡Der Erzähler der Sommergeschichten‡여름 이야기꾼‡El tejedor de historias de verano‡El tejedor de historias de verano‡Le conteur des légendes estivales‡节日诗人‡夏日故事使者',
    nil,
    'Fale com um Contador de Histórias do Festival em qualquer capital da Horda.‡Поговорите с праздничным сказителем в любой из столиц Орды.‡Sprecht mit einem Geschichtenerzähler in einer der Hauptstädte.‡호드 대도시 중 한 곳으로 가서 한여름 축제 이야기꾼과 대화해야 합니다.‡Habla con el cuentacuentos del Festival en cualquiera de las capitales de la Horda.‡Habla con el cuentacuentos del Festival en cualquiera de las capitales de la Horda.‡Parlez au Conteur de la fête dans n\'importe quelle capitale de la Horde.‡与任意部落主城的节日诗人谈一谈。‡和部落主城的任何一位節慶故事使者談談。',
  }
},
[11972] = {
  {
    'Fragmentos de Ahune‡Осколки Ахуна‡Splitter von Ahune‡아훈이 남긴 파편‡Fragmentos de Ahune‡Fragmentos de Ahune‡Éclats d\'Ahune‡埃霍恩的碎片‡艾胡恩裂片',
    nil,
    'Entregue os Estilhaços de Gelo para Luma Mãe dos Céus.‡Принесите ледяные осколки Луме Матери Небес.‡Bringt die Eissplitter zu Luma Himmelsmutter.‡얼음 파편을 루마 스카이마더에게 가져가야 합니다.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Apportez les Éclats de glace à Luma Mère-des-cieux.‡将寒冰碎片交给鲁玛·天母。‡將寒冰裂片交給魯瑪·天空之母。',
  }
},
[11973] = {
  {
    'Prisioneira de guerra‡Пленница‡Kriegsgefangene‡포로‡Prisionera de guerra‡Prisionera de guerra‡Prisonnière de guerre‡战争的囚徒‡戰爭的囚犯',
    nil,
    'Raelorasz, no Escudo de Transitus, quer que você entre no Nexus e liberte Keristrasza.‡По просьбе Релораза из лагеря под Маскировочным щитом отправьтесь в Нексус и освободите Керистразу.‡Raelorasz im Transitusschild möchte, dass Ihr den Nexus betretet und Keristrasza befreit.‡변위의 보호막에 있는 라엘로라즈가 마력의 탑에 들어가 케리스트라자를 풀어달라고 부탁했습니다.‡Raelorasz en el Escudo de Tránsito quiere que te adentres en El Nexo y liberes a Keristrasza.‡Raelorasz en el Escudo de Tránsito quiere que te adentres en El Nexo y liberes a Keristrasza.‡Raelorasz, au Bouclier Transitus, vous demande de pénétrer dans le Nexus et de libérer Keristrasza.‡永生之盾的莱洛拉斯要你进入魔枢并释放克莉斯塔萨。‡隘境之盾的瑞洛拉茲要你進入奧核之心釋放凱瑞史卓莎。',
  }
},
[11975] = {
  {
    'Quando eu crescer...‡Когда я вырасту...‡Nun, wenn ich einmal groß bin...‡이제, 어른이 되면...‡Después, cuando sea mayor...‡Después, cuando sea mayor...‡Et maintenant, quand je serai grande...‡等我长大了......‡現在，等我長大…',
    nil,
    'Leve a sua órfã Salandria para ver a banda Chefe Tauren Elite no Passeio dos Anciãos, que fica em Luaprata. Não se esqueça de chamá-la, caso ela não esteja com você ao chegar lá.‡Отведите свою подопечную, сиротку Саландрию, посмотреть на группу "Вожди тауренов" в Луносвет на Путь Старейшин. Обязательно позовите Саландрию, если по прибытии ее не окажется рядом.‡Geht mit Eurem Waisenkind Salandria zur Straße der Urahnen in Silbermond, um die Elite Tauren Chieftain zu sehen. Ruft sie zu Euch, falls sie nicht bei Euch ist, wenn Ihr ankommt.‡고아 소녀 살란드리아를 실버문 장로의 거리로 데려가 70레벨 정예 타우렌 족장을 만나게 해야 합니다. 도착했을 때 살란드리아가 보이지 않으면 다시 불러내야 합니다.‡Lleva a tu huérfana, Salandria, a ver a los Tauren Chieftains al Camino de los Ancestros en Ciudad de Lunargenta. Tendrás que ir a buscarla si no está allí cuando llegues.‡Lleva a tu huérfana, Salandria, a ver a los Tauren Chieftains al Camino de los Ancestros en Ciudad de Lunargenta. Tendrás que ir a buscarla si no está allí cuando llegues.‡Conduisez votre orpheline, Salandria, à la promenade des Anciens de Lune-d\'argent pour voir les Elite Tauren Chieftains. Si elle n\'est pas présente lorsque vous serez sur place, n\'oubliez pas de l\'appeler.‡带上孤儿萨兰蒂亚，前往银月城的长者步道拜访牛头人酋长乐队。如果你抵达时发现她不在身边，记得要先召唤她。‡帶你的孤兒，瑟蘭德雅去看精英牛頭大佬，他們在銀月城的長者步道。當你抵達時，如果她不附近記得要叫她。',
  }
},
[11976] = {
  {
    'Ice Shards‡Ледяные осколки‡Eissplitter‡얼음 파편‡Fragmentos de hielo‡Fragmentos de hielo‡Éclats de glace‡冰片‡寒冰裂片',
    nil,
    'Bring the Ice Shards to Luma Skymother.‡Принесите ледяные осколки Луме Матери Небес.‡Bringt die Eissplitter zu Luma Himmelsmutter.‡얼음 파편을 루마 스카이마더에게 가져가야 합니다.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Lleva los fragmentos de hielo a Luma Cielomater.‡Apportez les Éclats de glace à Luma Mère-des-cieux.‡将冰片交给鲁玛·天母。‡將寒冰裂片交給魯瑪·天空之母。',
  }
},
[11977] = {
  {
    'Uma tauren entre os taunkas‡Таурен среди таунка‡Ein Tauren unter Taunka‡타운카 속의 타우렌‡Un tauren entre los taunka‡Un tauren entre los taunka‡Une taurène parmi les taunkas‡牦牛人中的牛头人‡坦卡族中的牛頭人',
    nil,
    'Procure a Emissária Casco Luminoso no Campo de Refugiados de Zefirália.‡Поищите эмиссара Светлое Копыто в лагере беженцев Западного Ветра.‡Geht zum Flüchtlingslager von Westwind und sucht Abgesandte Leuchthuf auf.‡서풍의 피난민 행렬에서 사절 브라이트후프를 찾아야 합니다.‡Busca a la emisaria Pezuña Brillante en el Campo de Refugiados de Viento Oeste.‡Busca a la emisaria Pezuña Brillante en el Campo de Refugiados de Viento Oeste.‡Allez trouver l\'Émissaire Sabot-brillant au Camp de réfugiés de Ponevent.‡在西风避难营内找到特使艾米萨·闪蹄。‡前往西風難民營尋找特使亮蹄。',
  }
},
[11978] = {
  {
    'Novas forças para a Horda‡Добро пожаловать в Орду‡Mit offenen Armen empfangen‡맞아들일 준비‡En el redil‡En el redil‡Il est temps de nous rejoindre‡深入密林‡進入窪地',
    nil,
    'A Emissária Casco Luminoso no Campo de Refugiados de Zefirália, no Ermo das Serpes, quer que você recupere 10 Armamentos da Horda.‡По просьбе эмиссара Светлое Копыто из лагеря беженцев Западного Ветра на Драконьем Погосте добудьте 10 ящиков с ордынским оружием.‡Abgesandte Leuchthuf im Flüchtlingslager von Westwind in der Drachenöde möchte, dass Ihr 10 Waffen der Horde beschafft.‡용의 안식처의 서풍의 피난민 행렬에 있는 사절 브라이트후프가 호드 장비 10개를 모아달라고 부탁했습니다.‡La emisaria Pezuña Brillante del Campo de Refugiados de Viento Oeste, en el Cementerio de Dragones, quiere que recuperes 10 armamentos de la Horda.‡La emisaria Pezuña Brillante del Campo de Refugiados de Viento Oeste, en el Cementerio de Dragones, quiere que recuperes 10 armamentos de la Horda.‡L’Émissaire Sabot-brillant, du Camp de réfugiés de Ponevent dans la Désolation des dragons, veut que vous récupériez 10 Armes de la Horde.‡龙骨荒野西风避难营的特使艾米萨·闪蹄要求你找回10套部落军备。‡龍骨荒野，西風難民營的特使亮蹄要你去找回10個部落武裝。',
  }
},
[11979] = {
  {
    'Os taunkas e os taurens‡Таунка и таурены‡Die Taunka und die Tauren‡타운카와 타우렌‡Los taunka y los tauren‡Los taunka y los tauren‡Les taunkas et les taurens‡牦牛人和牛头人‡坦卡族與牛頭人',
    nil,
    'Procure a Emissária Casco Luminoso no Campo de Refugiados de Zefirália.‡Отыщите эмиссара Светлое Копыто в лагере беженцев Западного Ветра.‡Geht zum Flüchtlingslager von Westwind und sucht Abgesandte Leuchthuf auf.‡서풍의 피난민 행렬에서 사절 브라이트후프를 찾아야 합니다.‡Busca a la emisaria Pezuña Brillante en el Campo de Refugiados de Viento Oeste.|n‡Busca a la emisaria Pezuña Brillante en el Campo de Refugiados de Viento Oeste.|n‡Allez voir l’Émissaire Sabot-brillant au Camp de réfugiés de Ponevent.‡在西风避难营内找到特使艾米萨·闪蹄。‡在西風難民營尋找特使亮蹄。',
  }
},
[11980] = {
  {
    'Orgulho da Horda‡Гордость Орды‡Stolz der Horde‡호드의 긍지‡Orgullo de la Horda‡Orgullo de la Horda‡La fierté de la Horde‡部落的荣耀‡部落的驕傲',
    nil,
    'O Guarda-de-Sangue Roh\'kill, no Campo de Refugiados de Zefirália, no Ermo das Serpes, quer que você mate 15 Emboscadores Anub\'ar.‡Убейте 15 ануб\'арских душителей по просьбе кровавого стража Рох\'килла из лагеря беженцев Западного Ветра в Драконьем Погосте.‡Blutwache Roh\'kill im Flüchtlingslager von Westwind in der Drachenöde möchte, dass Ihr 15 Wegelagerer der Anub\'ar niederstreckt.‡용의 안식처 내 서풍의 피난민 행렬에 있는 혈투사 로킬이 아눕아르 복병 15마리를 처치해 달라고 부탁했습니다.‡El guardia de sangre Roh\'kill en el Campo de Refugiados de Viento Oeste en el Cementerio de Dragones quiere que mates a 15 emboscadores Anub\'ar.|n‡El guardia de sangre Roh\'kill en el Campo de Refugiados de Viento Oeste en el Cementerio de Dragones quiere que mates a 15 emboscadores Anub\'ar.|n‡Le Garde de sang Roh’kill, du Camp de réfugiés de Ponevent dans la Désolation des dragons, veut que vous tuiez 15 Embusqués anub’ar.‡龙骨荒野西风避难营的血卫士洛恩基尔要求你消灭15只阿努巴尔伏击者。‡血衛士羅奇爾要去殺死15隻阿努巴伏擊者，他就在龍骨荒野的西風難民營。',
  }
},
[11981] = {
  {
    'Encontre Karun!‡Найди Куруна!‡Findet Kurun!‡쿠룬을 찾아라!‡¡Encuentra a Kurun!‡¡Encuentra a Kurun!‡Trouvez Kurun !‡找到库伦！‡找到庫倫!',
    nil,
    'Fale com Karun no morro sobre Thor Modan.‡Поговорите с Куруном, который стоит на холме, возвышающимся над Тор Моданом.‡Sprecht mit Kurun auf dem Hügel, der Thor Modan überblickt.‡토르 모단이 내려다보이는 언덕에서 쿠룬과 대화해야 합니다.‡Habla con Kurun en la colina que da a Thor Modan.‡Habla con Kurun en la colina que da a Thor Modan.‡Parlez à Kurun sur la colline qui domine Thor Modan.‡前往俯瞰索尔莫丹的丘陵地带，在那里找到库伦。‡和庫倫交談，他就在可以俯瞰鐸爾莫丹的山丘上。',
  }
},
[11982] = {
  {
    'Chuva de pedras que cai sem parar‡Каменный дождь‡Es regnet Zerstörung‡빗발치는 파괴‡Llueve destrucción‡Llueve destrucción‡Que pleuve la destruction‡巨石横飞‡降下毀滅',
    nil,
    'Karun, que está no morro sobre Thor Modan, quer que você jogue penedos na área exposta de Thor Modan para interromper o trabalho dos anões de ferro.‡Курун, стоящий на холме, рядом с Тор Моданом, просит вас помешать железным дворфам, сбросив в котлован Тор Модана несколько булыжников.‡Kurun auf dem Hügel, der Thor Modan überblickt, möchte, dass Ihr die Arbeiten der Eisenzwerge dadurch stört, dass Ihr Felsbrocken in den freigelegten Bereich von Thor Modan werft.‡토르 모단이 내려다보이는 언덕에 있는 쿠룬이 토르 모단의 노출된 지역에 바위를 던져 무쇠 드워프의 작업을 방해해 달라고 부탁했습니다.‡Kurun en la colina que da a Thor Modan quiere que interrumpas el trabajo de los enanos férreos tirando rocas al área descubierta de Thor Modan.‡Kurun en la colina que da a Thor Modan quiere que interrumpas el trabajo de los enanos férreos tirando rocas al área descubierta de Thor Modan.‡Kurun, sur la colline qui domine Thor Modan, veut que vous interrompiez les efforts des nains de fer en jetant des rochers sur la partie exposée de Thor Modan.‡在丘陵上俯瞰索尔莫丹的库伦要求你向索尔莫丹的露天区域投掷石块，以此骚扰铁矮人的挖掘工作。‡庫倫要你將巨礫丟入鐸爾莫丹的暴露區域以干擾鐵矮人的工作。他就在可以俯瞰鐸爾莫丹的山丘上。',
  }
},
[11983] = {
  {
    'Juramento de sangue da Horda‡Клятва крови Орды‡Blutschwur der Horde‡호드의 피의 맹세‡El juramento de sangre de la Horda‡El juramento de sangre de la Horda‡Le serment de sang de la Horde‡部落的血誓‡部落的血誓',
    nil,
    'Fale com os taunkas no Campo de Refugiados de Zefirália e faça 5 deles jurarem aliança à Horda.|n|nDevolva o Juramento de Sangue da Horda à Emissária Casco Luminoso quando tiver completado a tarefa.‡Поговорите с таунка в лагере беженцев Западного Ветра и примите у пятерых из них клятву верности Орде.|n|nВерните клятву крови Орды эмиссару Светлое Копыто, когда выполните задание.‡Sprecht mit den Taunka im Flüchtlingslager von Westwind und bringt 5 von ihnen dazu, der Horde Treue zu geloben.|n|nBringt den Blutschwur der Horde wieder zur Abgesandten Leuchthuf, sobald Ihr diese Aufgabe abgeschlossen habt.‡서풍의 피난민 행렬에 있는 타운카들과 대화하여 5명의 타운카에게서 호드에 대한 충성을 다짐받아야 합니다.|n|n임무를 완료하면 호드 연합 피의 맹세를 사절 브라이트후프에게 가져가십시오.‡Habla con los taunka en el Campo de Refugiados de Viento Oeste y haz que 5 de ellos juren lealtad a la Horda.|n|nDevuelve el juramento de sangre de la Horda a la emisaria Pezuña Brillante cuando hayas completado esta tarea.‡Habla con los taunka en el Campo de Refugiados de Viento Oeste y haz que 5 de ellos juren lealtad a la Horda.|n|nDevuelve el juramento de sangre de la Horda a la emisaria Pezuña Brillante cuando hayas completado esta tarea.‡Parlez aux taunkas du Camp de réfugiés de Ponevent et amenez 5 d’entre eux à prêter allégeance à la Horde.|n|nLorsque ce sera fait, rendez le Serment de sang de la Horde à l’Émissaire Sabot-brillant.‡与西风避难营的牛头人交谈，并收集5份他们对部落的效忠宣誓书。|n|n完成任务之后，带着部落的血誓向特使艾米萨·闪蹄复命。‡和西風難民營中的坦卡族交談，讓他們其中5個人宣誓加入部落。|n|n完成之後帶著部落的血誓回去找特使亮蹄。',
  }
},
[11984] = {
  {
    'Enchendo as jaulas‡Захлопнуть клетку‡Die Käfige vollmachen‡철창 속의 트롤‡Llenar las jaulas‡Llenar las jaulas‡Remplir les cages‡抓巨魔‡把籠子裝滿',
    nil,
    'Samir, nas Fontes Graníticas, quer que você use a Jaula de Caçador de Recompensas num troll drakkari que tenha sido atordoado por Bino.‡Самир из Гранитных ключей просит вас запереть в клетку охотника оглушенного Баддом ледяного тролля.‡Samir am Granitquell möchte, dass Ihr mithilfe des Käfigs des Kopfgeldjägers einen Troll einfangt, der von Budd betäubt wurde.‡화강암 웅덩이에 있는 사미르가 버드가 기절시킨 드라카리 트롤에게 현상금 사냥꾼의 우리를 사용해 달라고 부탁했습니다.‡Samir, en el Manantial de Granito, quiere que uses la Jaula de Cazarrecompensas con un trol Drakkari que haya aturdido Budd.‡Samir, en el Manantial de Granito, quiere que uses la Jaula de Cazarrecompensas con un trol Drakkari que haya aturdido Budd.‡Samir, des Sources de granit, veut que vous vous serviez de la Cage du chasseur de primes sur un troll drakkari qui a été étourdi par Budd.‡岩石之泉的萨米尔希望你对被巴德打昏的达卡莱巨魔使用赏金猎人的笼子。‡花崗岩之泉的山米爾要你對著被霸德擊昏的寒冰食人妖使用賞金獵人的籠子。',
  }
},
[11985] = {
  {
    'Atentado em Thor Modan‡Битва в Проломе‡In die Bresche springen‡역경을 무릅쓰고‡Abriendo brecha‡Abriendo brecha‡Dans la brèche‡攻破防线‡進入缺口',
    nil,
    'Karun, que está no morro sobre Thor Modan, quer que você mate Thane de Ferro Argrum.‡Курун, стоящий на холме, возвышающемся над Тор Моданом, просит вас убить железного тана Аргрума.‡Kurun auf dem Hügel, der Thor Modan überblickt, möchte, dass Ihr den Eisenthan Argrum tötet.‡토르 모단이 내려다보이는 언덕에 있는 쿠룬이 무쇠 영주 알그룸을 처치해 달라고 부탁했습니다.‡Kurun en la colina que da a Thor Modan quiere que mates al Señor feudal férreo Argrum.‡Kurun en la colina que da a Thor Modan quiere que mates al Señor feudal férreo Argrum.‡Kurun, sur la colline qui domine Thor Modan, veut que vous tuiez le Thane-de-fer Argrum.‡库伦要你杀死指挥官阿格鲁姆，然后返回鸟瞰索尔莫丹的小山坡向他复命。‡在可以俯瞰鐸爾莫丹的山丘上的庫倫要你殺死鐵族長阿爾古姆。',
  }
},
[11986] = {
  {
    'O diário danificado‡Потрепанный дневник‡Das beschädigte Tagebuch‡닳아해진 일지‡El diario deteriorado‡El diario deteriorado‡Le journal endommagé‡破损的日记‡破損的日誌',
    nil,
    'Recupere 8 Páginas Perdidas do Diário, combine-as com o Diário Incompleto e entregue o diário completo a Torthen Cavafundo no Acampamento da Brigada de Cerro Oeste.‡Разыщите 8 недостающих страниц, вклейте их в дневник и принесите его Тортену Глубокопу в Лагерь дружины Западного Края.‡Sammelt 8 der fehlenden Tagebuchseiten, ergänzt damit das Tagebuch und bringt Torthen Grabtief im Lager der Westfallbrigade das vervollständigte Buch.‡잃어버린 일지 페이지 8장을 되찾아 완성되지 않은 일지와 합쳐 완성된 일지로 만들어 서부 몰락지대 여단 야영지에 있는 토르덴 딥딕에게 가져가야 합니다.‡Recupera 8 hojas de diario desaparecidas, completa con ellas el diario incompleto y devuélvele el diario completo a Torthen Cavahondo en el Campamento de la Brigada de los Páramos de Poniente.‡Recupera 8 hojas de diario desaparecidas, completa con ellas el diario incompleto y devuélvele el diario completo a Torthen Cavahondo en el Campamento de la Brigada de los Páramos de Poniente.‡Retrouvez les 8 Pages manquantes du journal, combinez-les avec le Journal incomplet, et remettez le journal complété à Torthen Fouillafond, au Campement de la brigade de la marche de l’Ouest.‡找到8张遗失的日记书页，将它们与不完整的日记拼凑起来，然后将日记交给月溪旅营地的托尔森·迪普迪格。‡找回8頁失蹤日誌紙頁，將它們和不完整的日誌黏合起來，然後將完整的日誌交給西荒兵團駐營的多杉·深掘。',
  }
},
[11987] = {
  {
    'zzOLDFortune Card: Silver‡zzOLDГадательная карта: Серебро‡Glückskarte: Silber‡[미사용] 행운 카드: 은‡zzOLDFortune Card: Silver‡zzOLDFortune Card: Silver‡zzOLDLa carte porte-bonheur en argent‡幸运卡片：白银‡zzOLD占卜卡:銀色',
    nil,
    nil,
  }
},
[11988] = {
  {
    'A pedra decifradora de runas‡Рунический краеугольный камень‡Der Runenschlüsselstein‡룬문자 쐐기돌‡La piedra angular rúnica‡La piedra angular rúnica‡La pierre-clé runique‡符文钥石‡符刻拱心石',
    nil,
    'Traga 5 Fragmentos de Pedra Decifradora de Runas para Torthen Cavafundo no Acampamento da Brigada de Cerro Oeste.‡Принесите 5 фрагментов рунического краеугольного камня Тортену Глубокопу в Лагерь дружины Западного Края.‡Bringt Torthen Grabtief im Lager der Westfallbrigade 5 Fragmente des Runenschlüsselsteins.‡서부 몰락지대 여단 야영지에 있는 토르덴 딥딕에게 룬문자 쐐기돌 조각 5개를 가져가야 합니다.‡Lleva 5 fragmentos de piedra angular rúnica a Torthen Cavahondo al Campamento de la Brigada de los Páramos de Poniente.‡Lleva 5 fragmentos de piedra angular rúnica a Torthen Cavahondo al Campamento de la Brigada de los Páramos de Poniente.‡Remettez 5 Fragments de pierre-clé runique à Torthen Fouillafond au Campement de la brigade de la marche de l’Ouest.‡将5块符文钥石碎片交给月溪旅营地的托尔森·迪普迪格。‡西荒兵團駐營的多杉·深掘要你帶給他5個符刻拱心石碎片。',
  }
},
[11989] = {
  {
    'Trégua?‡Перемирие?‡Waffenstillstand?‡휴전?‡¿Tregua?‡¿Tregua?‡Trêve ?‡停战？‡休戰?',
    nil,
    'Drakuru, nas Fontes Graníticas, quer que você use a Faca Cega, que está perto da jaula, e então fale com ele.‡Дракуру из Гранитных ключей просит вас скрепить перемирие кровью, поцарапав свою руку тупым резаком, лежащим возле его клетки.‡Drakuru am Granitquell möchte, dass Ihr in der Nähe seines Käfigs das stumpfe Schnitzmesser benutzt und dann mit ihm sprecht.‡화강암 웅덩이에 있는 드라쿠루가 갇힌 우리 옆에 있는 무딘 조각칼을 사용한 다음 그와 다시 대화해야 합니다.‡Drakuru en el Manantial de Granito quiere uses el trinchante tosco junto a su jaula y que luego hables con él.‡Drakuru en el Manantial de Granito quiere uses el trinchante tosco junto a su jaula y que luego hables con él.‡Drakuru, aux Sources de granit, veut que vous utilisiez le Couteau à découper émoussé, puis que vous lui parliez.‡岩石之泉的达库鲁希望你在他的笼子附近使用钝刻刀，然后和他对话。‡花崗岩之泉的德拉庫魯要你在他籠子附近使用粗鈍的雕刻刀，然後再和他交談。',
  }
},
[11990] = {
  {
    'O vidro das visões‡Пузырек видений‡Phiole der Visionen‡환영의 약병‡Vial de visiones‡Vial de visiones‡La fiole aux visions‡幻象之瓶‡幻象之瓶',
    nil,
    'Drakuru, nas Fontes Graníticas, quer que você leve a ele 1 Ampola Imbuída, 1 Ramo de Aguapé e 3 Folhas-de-névoa.‡Дракуру из Гранитных ключей просит вас принести ему укрепленную колбу, сплетение водорослей и три листа туманнолистника.‡Drakuru am Granitquell möchte, dass Ihr ihm eine magieerfüllte Phiole, einen Wassergraswedel und 3 Dunstblätter bringt.‡화강암 웅덩이에 있는 드라쿠루가 마법 약병, 수초 잎사귀 1개와 안개나무 잎 3장을 가져다 달라고 부탁했습니다.‡Drakuru en el Manantial de Granito quiere que le traigas 1 vial imbuido, 1 ejemplar de hojas de algas y 3 hojas de neblina.‡Drakuru en el Manantial de Granito quiere que le traigas 1 vial imbuido, 1 ejemplar de hojas de algas y 3 hojas de neblina.‡Drakuru, aux Sources de granit, veut que vous lui rapportiez une Fiole imprégnée, une Feuille d’élodée et 3 Feuilles de brume.‡岩石之泉的达库鲁希望你把一只灌魔之瓶、一片水草叶和3片薄雾叶交给他。‡花崗岩之泉的德拉庫魯要你帶給他灌魔之瓶、1個水蘊草藻葉和3個霧葉。',
  }
},
[11991] = {
  {
    'Sujeito a interpretação‡Требуется расшифровка‡Interpretationssache‡판독 작업‡Requiere interpretación‡Requiere interpretación‡Sujet à interprétation‡解读象形文字‡呈交翻譯',
    nil,
    'Drakuru quer que você pegue 5 Mojos Congelados dos Trolls Drakkari nas Ruínas de Drak\'Zin e, em seguida, use o elixir no Braseiro de Drakuru, nas mesmas ruínas.‡Дракуру просит вас добыть 5 застывших настоев у Драккари, обитающих среди Руин Драк\'Зина, и затем выпить эликсир возле жаровни Дракуру.‡Drakuru möchte, dass Ihr 5 Flaschen gefrorenes Mojo von den Drakkaritrollen in den Ruinen von Drak\'Zin beschafft und anschließend das Elixier bei Drakurus Kohlenbecken trinkt.‡드락진 폐허에 있는 드라카리 트롤에게서 얼어붙은 모조 5개를 구한 다음 비약을 드라쿠루의 화로에 사용해야 합니다.‡Drakuru quiere que consigas 5 muestras de mojo congelado de los trols Drakkari en las Ruinas de Drak\'Zin y que luego uses el elixir en el Pedestal de Drakuru.‡Drakuru quiere que consigas 5 muestras de mojo congelado de los trols Drakkari en las Ruinas de Drak\'Zin y que luego uses el elixir en el Pedestal de Drakuru.‡Drakuru veut que vous récupériez 5 Mojos glacés sur les Trolls drakkari des Ruines de Drak’Zin. Lorsque ce sera fait, utilisez l’élixir au Brasero de Drakuru.‡达库鲁希望你从达克辛废墟的达卡莱巨魔身上获取5份冰冻魔精，然后在达库鲁的火盆处使用他的药剂。‡德拉庫魯需要你從德拉克辛遺跡的德拉克瑞食人妖身上獲得5個冰凍魔精，然後在德拉庫魯的火盆上使用藥劑。',
  }
},
[11993] = {
  {
    'As profecias rúnicas‡Рунические пророчества‡Die Runenprophezeiungen‡룬의 예언‡Las profecías rúnicas‡Las profecías rúnicas‡Les prophéties runiques‡符文中的预言‡符文預言',
    nil,
    'Torthen Cavafundo, no Acampamento da Brigada de Cerro Oeste, quer que você decifre as três Placas Rúnicas.‡Тортен Глубокоп из Лагеря дружины Западного Края просит вас расшифровать три рунических диска.‡Torthen Grabtief im Lager der Westfallbrigade möchte, dass Ihr die drei Runenplatten entziffert.‡서부 몰락지대 여단 야영지에 있는 토르덴 딥딕이 룬문자 판 3개를 해독해 달라고 부탁했습니다.‡Torthen Cavahondo en el Campamento de la Brigada de los Páramos de Poniente quiere que descifres las tres placas rúnicas.‡Torthen Cavahondo en el Campamento de la Brigada de los Páramos de Poniente quiere que descifres las tres placas rúnicas.‡Thorten Fouillafond, au Campement de la brigade de la marche de l’Ouest, veut que vous déchiffriez trois Plaques runiques.‡月溪旅营地的托尔森·迪普迪格要你破译3块符文金属板的内容。‡西荒兵團駐營的多杉·深掘要你解讀三塊符文板。',
  }
},
[11994] = {
  {
    '‡Juno\'s Flag Tester‡Junos Flaggentester‡‡Juno\'s Flag Tester‡Juno\'s Flag Tester‡Test de drapeau de Juno‡Juno/s Flag Tester[日常]‡',
    nil,
    nil,
  }
},
[11995] = {
  {
    'Sua presença é requisitada no Recanto das Estrelas‡Безотлагательное путешествие в Покой Звезд‡In Sternenruh wird Eure Anwesenheit benötigt‡별의 쉼터로‡Se requiere tu presencia en Reposo Estelar‡Se requiere tu presencia en Reposo Estelar‡Votre présence est demandée au Repos des étoiles‡前往群星之墓‡繁星之眠需要你',
    nil,
    'Fale com a Imagem da Arquimaga Modera no Recanto das Estrelas.‡Поговорите с проекцией верховного мага Модеры в Покое Звезд.‡Sprecht mit dem Abbild von Erzmagierin Modera in Sternenruh.‡별의 쉼터에 있는 대마법사 모데라의 환영과 대화해야 합니다.‡Habla con la imagen de la archimaga Modera en Reposo Estelar.‡Habla con la imagen de la archimaga Modera en Reposo Estelar.‡Parlez à l\'Image de l\'archimage Modera au Repos des étoiles.‡前往群星之墓，与大法师茉德拉的影像谈一谈。‡到繁星之眠和大法師莫德菈的影像談談。',
  }
},
[11996] = {
  {
    'Sua presença é requisitada no Martelo de Agmar‡Безотлагательное путешествие в Молот Агмара‡Eure Anwesenheit wird in Agmars Hammer verlangt‡아그마르의 망치로‡Se requiere tu presencia en Martillo de Agmar‡Se requiere tu presencia en Martillo de Agmar‡Votre présence est demandée au Marteau d\'Agmar‡前往阿格玛之锤‡阿格瑪之錘需要你',
    nil,
    'Fale com a Imagem do Arquimago Aethas Fendessol no Martelo de Agmar.‡Поговорите с проекцией верховного мага Этаса Похитителя Солнца в Молоте Агмара.‡Sprecht mit dem Abbild des Erzmagiers Aethas Sonnenhäscher in Agmars Hammer.‡아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영과 대화해야 합니다.‡Habla con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Habla con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Parlez à l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡前往阿格玛之锤，与大法师艾萨斯·夺日者的影像谈一谈。‡和位於阿格瑪之錘的大法師埃薩·奪日者的影像談談。',
  }
},
[11997] = {
  {
    'REUTILIZAR‡REUSE‡Findet Gryan Starkmantel‡재사용‡REUSE‡REUSE‡RÉUTILISER‡再次向格里安·斯托曼报到‡重複利用',
    nil,
    'Fale com o Capitão Miguel Mantoforte no Acampamento da Brigada de Cerro Oeste.‡Поговорите с капитаном Грианом Камнегривом в Лагере дружины Западного Края.‡Sprecht mit Hauptmann Gryan Starkmantel im Lager der Westfallbrigade.‡서부 몰락지대 여단 야영지에 있는 대장 그라이언 스타우트맨틀과 대화해야 합니다.‡Habla con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Habla con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Parlez au Capitaine Gryan Roidemantel au Campement de la brigade de la marche de l’Ouest.‡与月溪旅营地的格里安·斯托曼上尉谈一谈。‡和西荒兵團駐營的格里安·斯托曼上尉談談。',
  }
},
[11998] = {
  {
    'Embebedando o peru‡Подсластить пилюлю‡Den Schlag abschwächen‡충격 완화‡Suavizar el golpe‡Suavizar el golpe‡Adoucir le coup‡灵活的手段‡動之以情',
    nil,
    'Leve um barril de Pinga Boa da Disgrama para Brugar Rasgalito no Acampamento da Brigada de Cerro Oeste.‡Принесите Бругару Гравировщику из Лагеря дружины Западного Края бочку старого доброго самогона.‡Bringt Brugar Steinscher im Lager der Westfallbrigade ein Fässchen mit zum Heulen gutem Fusel.‡서부 몰락지대 여단 야영지에 있는 브루가르 스톤쉬어에게 엄청나게 맛있는 밀주 1통을 가져가야 합니다.‡Lleva un barril de licor excelente a Brugar Petraescucha al Campamento de la Brigada de los Páramos de Poniente.‡Lleva un barril de licor excelente a Brugar Petraescucha al Campamento de la Brigada de los Páramos de Poniente.‡Apportez à Brugar Cisaillepierre au Campement de la brigade de la marche de l’Ouest un bidon de Tord-boyaux du tonnerre.‡将一桶冰风月光酒交给月溪旅营地的布鲁加尔·石剪。‡帶給布魯嘉·石聽一桶豪林的高級月光酒，他就在西荒兵團駐營。',
  }
},
[11999] = {
  {
    'Vasculhe os cadáveres‡Обшарить трупы‡Leichenfleddern‡단서를 찾아라‡Saquea los cadáveres‡Saquea los cadáveres‡Fouillez les corps‡寻找线索‡搜索屍體',
    nil,
    'Encontre os Planos dos Jardins Lua Serena e entregue-os à Imagem do Arquimago Aethas Fendessol, no Martelo de Agmar.‡Найдите планы в Садах Лунного Покоя и вернитесь с ними к проекции верховного мага Этаса Похитителя Солнца в Молоте Агмара.‡Findet die Pläne der Mondruhgärten und bringt sie zum Abbild des Erzmagiers Aethas Sonnenhäscher in Agmars Hammer.‡달쉼터 정원 작전서를 찾아 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 가져가야 합니다.‡Encuentra los planes de los Jardines Reposo Lunar y llévaselos a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Encuentra los planes de los Jardines Reposo Lunar y llévaselos a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Trouvez les Plans des jardins de Repos-de-Lune et rapportez-les à l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡找到眠月花园计划书，然后返回阿格玛之锤，将它交给大法师艾萨斯·夺日者的影像。‡找出月眠花園計畫書，並交到阿格瑪之錘給大法師埃薩·奪日者的影像。',
  }
},
[12000] = {
  {
    'Vasculhe os cadáveres‡Обшарить трупы‡Leichenfleddern‡단서를 찾아라‡Saquea los cadáveres‡Saquea los cadáveres‡Fouillez les corps‡寻找线索‡搜索屍體',
    nil,
    'Encontre os Planos dos Jardins Lua Serena e entregue-os para a Imagem da Arquimaga Modera, no Recanto das Estrelas.‡Найдите планы в Садах Лунного Покоя и вернитесь с ними к проекции верховного мага Модеры в Покое Звезд.‡Findet die Pläne der Mondruhgärten und bringt sie zu Erzmagierin Modera in Sternenruh.‡달쉼터 정원 작전서를 찾아 별의 쉼터에 있는 대마법사 모데라의 환영에게 가져가야 합니다.‡Encuentra los planes de los Jardines Reposo Lunar y llévaselos a la imagen de la archimaga Modera en Reposo Estelar.‡Encuentra los planes de los Jardines Reposo Lunar y llévaselos a la imagen de la archimaga Modera en Reposo Estelar.‡Trouvez les Plans des jardins de Repos-de-Lune et rapportez-les à l\'Image de l\'archimage Modera au Repos des étoiles.‡找到眠月花园计划书，然后返回群星之墓，将它交给大法师茉德拉的影像。‡找出月眠花園計畫書，並帶去繁星之眠給大法師莫德菈的影像。',
  }
},
[12001] = {
  {
    'zzOLDHunting Tarot: Lesser Beasts‡zzOLDКарты охотника: меньшие звери‡Jagdtarot: Geringe Bestien‡[미사용] 사냥 타로 카드: 하급 야수‡zzOLDHunting Tarot: Lesser Beasts‡zzOLDHunting Tarot: Lesser Beasts‡zzOLDTarot de chasse : Fauves mineurs‡zzOLDHunting Tarot: Lesser Beasts‡zzOLD狩獵塔羅牌:次級野獸',
    nil,
    'Collect 12 Torn Hides and then summon the Huntsman with the Hunting Tarot. The Torn Hides can only be gathered from beasts of level 5 or higher.‡Соберите 12 рваных шкур и призовите охотника с помощью карты. Рваные шкуры можно добыть, убивая зверей 5 уровня или выше.‡Sammelt 12 zerrissene Felle und benutzt anschließend das Jagdtarot, um den Jäger herbeizurufen. Ihr könnt die zerrissenen Felle nur von Bestien der Stufe 5 oder höher erhalten.‡5 레벨 이상의 야수를 잡아 찢어진 곰 모피 12개를 모아 사냥 타로 카드로 사냥꾼을 소환해야 합니다.‡Recoge 12 pellejos rotos y después invoca al Montero usando el tarot de caza. Los pellejos rotos solo se consiguen con bestias de nivel 5 o superior.‡Recoge 12 pellejos rotos y después invoca al Montero usando el tarot de caza. Los pellejos rotos solo se consiguen con bestias de nivel 5 o superior.‡Trouvez 12 Peaux déchirées, puis invoquez le Veneur avec le Tarot de chasse. Les peaux déchirées ne peuvent être obtenues que sur des bêtes de niveaux 5 ou supérieur.‡Collect 12 Torn Hides and then summon the Huntsman with the Hunting Tarot.  The Torn Hides can only be gathered from beasts of level 5 or higher.‡收集12張破損的皮革，然後使用狩獵塔羅牌召喚獵人。破碎的皮革只能從5級或以上的野獸身上取得。',
  }
},
[12002] = {
  {
    'Irmãos na batalha‡Братья по оружию‡Brüder in der Schlacht‡싸움터의 형제들‡Hermanos en guerra‡Hermanos en guerra‡Frères d\'armes‡战斗中的兄弟‡戰鬥中的弟兄',
    nil,
    'Mate 10 Golens de Batalha Rúnicos e fale novamente com Brugar Rasgalito, no Acampamento da Brigada de Cerro Oeste.‡Убейте 10 рунических боевых големов и вернитесь к Бругару Гравировщику в Лагерь дружины Западного Края.‡Tötet 10 Runenschlachtgolems und kehrt zu Brugar Steinscher im Lager der Westfallbrigade zurück.‡룬문자 전투 골렘 10마리를 처치한 다음 서부 몰락지대 여단 아영지에 있는 브루가르 스톤쉬어에게 돌아가야 합니다.‡Mata a 10 gólems de batalla rúnicos y vuelve junto a Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente.‡Mata a 10 gólems de batalla rúnicos y vuelve junto a Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente.‡Tuer 10 Golems d’assaut runiques et retourner voir Brugar Cisaillepierre au Campement de la brigade de la marche de l’Ouest.‡消灭10台符文作战魔像，然后返回月溪旅营地向布鲁加尔·石剪复命。‡殺死10個符刻戰鬥魔像然後向西荒兵團駐營的布魯嘉·石聽回報。',
  }
},
[12003] = {
  {
    'Descobrindo os túneis‡В поисках туннелей‡Die Suche nach den Tunnels‡굴 탐색‡Destapando los túneles‡Destapando los túneles‡À la découverte des tunnels‡寻找隧道‡發掘隧道',
    nil,
    'Brugar Rasgalito no Acampamento da Brigada de Cerro Oeste quer que você explore o Edifício Norte, o Edifício Leste e o Edifício Sul de Thor Modan.‡Бругар Гравировщик из Лагеря дружины Западного Края просит вас осмотреть северное, восточное и южное строения в Тор Модане.‡Brugar Steinscher im Lager der Westfallbrigade möchte, dass Ihr das Nordgebäude, das Ostgebäude und das Südgebäude von Thor Modan untersucht.‡서부 몰락지대 여단 야영지의 브루가르 스톤쉬어가 토르 모단의 북쪽 건물, 동쪽 건물, 남쪽 건물을 조사해 달라고 부탁했습니다.‡Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente quiere que explores el edificio norte, el edificio este y el edificio sur de Thor Modan.‡Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente quiere que explores el edificio norte, el edificio este y el edificio sur de Thor Modan.‡Brugar Cisaillepierre, au Campement de la brigade de la marche de l’Ouest, veut que vous exploriez le Bâtiment nord, le Bâtiment est et le Bâtiment sud de Thor Modan.‡月溪旅营地的布鲁加尔·石剪要你前去侦查索尔莫丹的北部建筑物、东部建筑物和南部建筑物。‡西荒兵團駐營的多杉·深掘希望你去探索鐸爾莫丹的北部建築、東部建築和南部建築。',
  }
},
[12004] = {
  {
    'Impeça o acordo‡Предотвратить союз‡Verhindert das Abkommen‡협상을 막아라‡Evita el acuerdo‡Evita el acuerdo‡Empêcher l\'accord‡阻碍协议‡阻礙協議',
    nil,
    'Entregue os Restos do Mercador do Vento Mu\'fah e as Escamas de Goramosh para a Imagem da Arquimaga Modera, no Recanto das Estrelas.‡Принесите проекции верховного мага Модеры в Покой Звезд останки торговца Ветром Му\'фа и чешую Горамоша.‡Bringt Windhändler Mu\'fahs Überreste und die Schuppen von Goramosh zum Abbild der Erzmagierin Modera in Sternenruh.‡바람의 무역상 무파의 유품과 고라모쉬의 비늘을 별의 쉼터에 있는 대마법사 모데라의 환영에게 가져가야 합니다.‡Lleva los restos del comerciante de viento Mu\'fah y las escamas de Goramosh a la imagen de la archimaga Modera en Reposo Estelar.‡Lleva los restos del comerciante de viento Mu\'fah y las escamas de Goramosh a la imagen de la archimaga Modera en Reposo Estelar.‡Apportez les Restes du marchand des vents Mu\'fah et les Écailles de Goramosh à l\'Image de l\'archimage Modera au Repos des étoiles.‡将商人穆法赫的遗骸和古拉莫什的鳞片带回群星之墓，交给大法师茉德拉的影像。‡將風之貿易者穆法的殘骸和戈拉莫什的鱗片帶去繁星之眠給大法師莫德菈的影像。',
  }
},
[12005] = {
  {
    'Impeça o acordo‡Предотвратить союз‡Verhindert das Abkommen‡협상을 막아라‡Evita el acuerdo‡Evita el acuerdo‡Empêcher l\'accord‡阻碍协议‡阻礙協議',
    nil,
    'Entregue os Restos do Mercador do Vento Mu\'fah e as Escamas de Goramosh para a Imagem do Arquimago Aethas Fendessol, no Martelo de Agmar.‡Доставьте останки Му\'фы Торговца Ветром и чешую Горамоша к проекции верховного мага Этаса Похитителя Солнца в Молоте Агмара.‡Bringt Windhändler Mu\'fahs Überreste und die Schuppen von Goramosh zum Abbild des Erzmagiers Aethas Sonnenhäscher bei Agmars Hammer.‡바람의 무역상 무파의 유품과 고라모쉬의 비늘을 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 가져가야 합니다.‡Lleva los restos del comerciante de viento Mu\'fah y las escamas de Goramosh a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Lleva los restos del comerciante de viento Mu\'fah y las escamas de Goramosh a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Apportez les Restes du marchand des vents Mu\'fah et les Écailles de Goramosh à l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡将商人穆法赫的遗骸和古拉莫什的鳞片带回阿格玛之锤，交给大法师艾萨斯·夺日者的影像。‡將風之貿易者穆法的殘骸和戈拉莫什的鱗片交給大法師埃薩·奪日者的影像，位在阿格瑪之錘。',
  }
},
[12006] = {
  {
    'Vingue essa atrocidade!‡Месть за бесчинства!‡Rächt diese Gräueltat!‡만행에 복수를!‡¡Vénganos de esa atrocidad!‡¡Vénganos de esa atrocidad!‡Vengez-nous de cette atrocité !‡上层精灵的愤怒‡為暴行復仇!',
    nil,
    'Mate 15 inimigos, entre Caça-magos do Ermo das Serpes, Espreitadores da Lua Serena, Feiticeiros da Agulha de Mana e Teurgos de Concentração. Quando cumprir a missão, fale com Ethenial Umbraluna, nos Jardins Lua Serena.‡Убейте охотников на магов с Драконьего Погоста, ловчих из Садов Лунного Покоя, колдунов Волноловов и волшебников средоточия, общим числом 15, после чего возвращайтесь к Этениалу Тени Луны в Сады Лунного Покоя.‡Tötet insgesamt 15 Magierjäger der Drachenöde, Mondruhpirscher, Zauberer der Sognadel, Fokushexer oder eine Kombination aus mehreren. Kehrt zu Ethenial Mondnacht zurück, sobald Ihr das erledigt habt.‡용의 안식처 마법사 사냥꾼, 달쉼터 정원 사냥개, 폭풍 바늘 마술사, 정신 집중 중인 마법사를 종류에 상관없이 총 15명 처치한 후, 달쉼터 정원에 있는 에테니얼 문섀도에게 돌아가야 합니다.‡Mata cualquier combinación de 15 cazadores de magos de Cementerio de Dragones, acechadores Reposo Lunar, hechiceros de Aguja de Flujo y zahorís de enfoque. Cuando lo hayas hecho, vuelve junto a Ethenial Umbraluna en los Jardines Reposo Lunar.‡Mata cualquier combinación de 15 cazadores de magos de Cementerio de Dragones, acechadores Reposo Lunar, hechiceros de Aguja de Flujo y zahorís de enfoque. Cuando lo hayas hecho, vuelve junto a Ethenial Umbraluna en los Jardines Reposo Lunar.‡Tuez 15 des créatures suivantes, dans n’importe quelle combinaison : Chasseur de mages de la désolation des dragons, Traqueur de Repos-de-Lune, Sorcier du capteur tellurique et Sorcier focalisé. Lorsque ce sera fait, retournez voir Ethénial Lunombre aux jardins de Repos-de-Lune.‡击败龙骨荒野法师猎手、眠月魔犬、湍流之针巫师和魔法焦点巫师，总计15名。完成任务后返回眠月花园，向伊瑟尼安·月影复命。‡殺死總計15名的龍骨荒野狩法獵人、月眠巡者、極濤磁針巫士或節點巫師。完成之後向月眠花園的伊希尼歐·月影回報。',
  }
},
[12007] = {
  {
    'Se é pelo bem de todos...‡Необходимые жертвы‡Opfer müssen erbracht werden‡어쩔 수 없는 희생‡Es necesario hacer sacrificios‡Es necesario hacer sacrificios‡Il faut savoir faire des sacrifices‡必要的牺牲‡犧牲是必要的',
    nil,
    'Drakuru quer que você leve o Olho dos Profetas para ele no Braseiro de Drakuru em Zeb\'Halak.|n|nColete o Mojo do Zim\'bo para poder usar o Elixir do Drakuru lá.‡Дракуру просит принести ему Око пророка к жаровне в Зеб\'Халаке.|n|nЧтобы эликсир Дракуру сработал на пьедестале, вам придется добыть настой Зим\'бо.‡Drakuru möchte, dass Ihr ihm das Auge der Propheten zum Kohlenbecken in Zeb\'Halak bringt.|n|nIhr müsst Zim\'bos Mojo einsammeln, um Drakurus Elixier dort benutzen zu können.‡드라쿠루가 제브할락에 있는 드라쿠루의 화로로 예언가의 눈을 가져와 달라고 부탁했습니다.|n|n그곳에 있는 드라쿠루의 화로를 사용하려면 짐보의 모조를 구해야 합니다.‡Drakuru quiere que le traigas el ojo de los profetas a su blandón de Drakuru en Zeb\'Halak.|n|nTendrás que recoger mojo de Zim\'Bo para usar el elixir de Drakuru allí.‡Drakuru quiere que le traigas el ojo de los profetas a su blandón de Drakuru en Zeb\'Halak.|n|nTendrás que recoger mojo de Zim\'Bo para usar el elixir de Drakuru allí.‡Drakuru veut que vous apportiez l’Œil des prophètes au Brasero de Drakuru, à Zeb’Halak.|n|nVous aurez besoin de récupérer le mojo de Zim’bo pour y utiliser l’Elixir de Drakuru lorsque vous serez au piédestal.‡达库鲁希望你前往塞布哈拉克，找到他的火盆，并将预言者之眼交给他。|n|n你需要取得督军希姆波的魔精，才能在那里使用达库鲁的药剂。‡德拉庫魯要你將預言者之眼帶給他，就在札布哈拉克的德拉庫魯的火盆處。|n|n你必須收集辛波的魔精，以便在火盆上使用德拉庫魯的藥劑。',
  }
},
[12008] = {
  {
    'O Martelo de Agmar‡Молот Агмара‡Agmars Hammer‡아그마르의 망치‡El Martillo de Agmar‡El Martillo de Agmar‡Le Marteau d\'Agmar‡阿格玛之锤‡阿格瑪之錘',
    nil,
    'Vá para o Martelo de Agmar, que fica no Ermo das Serpes, e fale com o Lorde Supremo Agmar.‡Отправляйтесь в Молот Агмара на Драконьем Погосте и поговорите с командиром Агмаром.‡Reist nach Agmars Hammer in der Drachenöde und sprecht mit Oberanführer Agmar.‡용의 안식처의 아그마르의 망치에서 대군주 아그마르와 대화해야 합니다.‡Viaja hasta el Martillo de Agmar, en el Cementerio de Dragones, y habla con el señor supremo Agmar.|n‡Viaja hasta el Martillo de Agmar, en el Cementerio de Dragones, y habla con el señor supremo Agmar.|n‡Rendez-vous au Marteau d’Agmar, dans la Désolation des dragons, et parlez au Suzerain Agmar.‡前往龙骨平原的阿格玛之锤，与阿格玛大王谈一谈。‡前往龍骨荒野的阿格瑪之錘，和霸主阿格瑪談談。',
  }
},
[12009] = {
  {
    'Armadilhas para caranguejo de Tua\'kea‡Крабовые ловушки Туа\'кеа‡Tua\'keas Krabbenfallen‡투아키 게 덫‡Trampas de cangrejos de Tua\'kea‡Trampas de cangrejos de Tua\'kea‡Les pièges à crabes de Tua\'kea‡图尔凯的螃蟹陷阱‡突凱亞的螃蟹陷阱',
    nil,
    'Colete 8 Armadilhas para Caranguejo de Tua\'kea e devolva-as para ele no Porto Moa\'ki.‡Соберите 8 ловушек Туа\'кеа для крабов и принесите их ему в гавань Моа\'ки.‡Sammelt 8 von Tua\'keas Krabbenfallen ein und bringt sie wieder zu ihm. Er befindet sich im Hafen Moa\'ki.‡투아키 게 덫 8개를 모아 모아키 항구에 있는 투아키에게 가져가야 합니다.‡Reúne 8 trampas de cangrejos de Tua\'kea en el Puerto Moa\'ki.‡Reúne 8 trampas de cangrejos de Tua\'kea en el Puerto Moa\'ki.‡Collectez 8 des Pièges à crabes de Tua\'kea et rapportez-les-lui à Port-Moa\'ki.‡收集8个图尔凯的螃蟹陷阱，然后把它们交给莫亚基港口的图尔凯。‡收集8個突凱亞的螃蟹陷阱，交還給默亞基港的突凱亞。',
  }
},
[12010] = {
  {
    'O destino de Orlond‡Что случилось с Орлондом?‡Das Schicksal Orlonds‡올런의 운명‡El destino de Orlond‡El destino de Orlond‡Le destin d\'Orlond‡奥尔隆德的命运‡歐隆德的命運',
    nil,
    'Encontre o Topógrafo Orlond dentro de Thor Modan.‡Найдите геодезиста Орлонда в Тор Модане.‡Findet Feldmesser Orlond innerhalb Thor Modans.‡토르 모단에서 측량사 올런을 찾아야 합니다.‡Encuentra al perito Orlond en Thor Modan.‡Encuentra al perito Orlond en Thor Modan.‡Trouver le Géomètre Orlond dans Thor Modan.‡前往索尔莫丹寻找勘查员奥尔隆德的下落。‡在鐸爾莫丹中尋找勘測員歐隆德。',
  }
},
[12011] = {
  {
    'Sinais de encrenca na água‡Признаки большой проблемы‡Anzeichen großen wässrigen Ärgers‡축축하고 불길한 예감‡Signos de importantes disturbios acuáticos‡Signos de importantes disturbios acuáticos‡Signes de gros ennuis aquatiques‡大麻烦的征兆‡大海問題的徵兆',
    nil,
    'Informe Tua\'kea, no Porto Moa\'ki, sobre a armadilha para caranguejos destruída.‡Сообщите рыбаку Туа\'кеа о разрушенной ловушке на крабов.‡Informiert Tua\'kea im Hafen Moa\'ki über die zerstörte Krabbenfalle.‡모아키 항구에 있는 투아키에게 부서진 게 덫에 대해 알려야 합니다.‡Informa a Tua\'kea del Puerto Moa\'ki acerca de la trampa de cangrejos destrozada.‡Informa a Tua\'kea del Puerto Moa\'ki acerca de la trampa de cangrejos destrozada.‡Parlez à Tua\'kea à Port-Moa\'ki du piège à crabes détruit que vous avez vu.‡前往莫亚基港口，将螃蟹陷阱被破坏的事情告诉图尔凯。‡回到默亞基港詢問突凱亞關於破爛的螃蟹陷阱。',
  }
},
[12012] = {
  {
    'Informe o ancião‡Сообщи старейшинам‡Den Urahnen benachrichtigen‡장로에게 소식 전달‡Informa al anciano‡Informa al anciano‡Informez l\'Ancien‡通知长者‡通知長老',
    nil,
    'Vá para a capital e fale com o Ancião da Harmonia Telúrica.‡Отправляйтесь в столицу и поговорите со старейшиной Служителей Земли.‡Reist in eine der Hauptstädte und sprecht mit dem Urahnen des Irdenen Rings.‡대도시로 가서 속세의 고리회 장로와 대화해야 합니다.‡Viaja a una capital y habla con el anciano del Anillo de la Tierra.‡Viaja a una capital y habla con el anciano del Anillo de la Tierra.‡Voyagez jusqu\'à une capitale et parlez à un Ancien du Cercle terrestre.‡返回任意主城，同大地之环长者交谈。‡回到任何一座主城，並和陶土議會長老交談。',
  }
},
[12013] = {
  {
    'Acabe com Arcanimus‡Покончить с Арканимусом!‡Weg mit Arkanimus‡아르카니무스 처단‡Acaba con Arcanimus‡Acaba con Arcanimus‡Abattre Arcanimus‡阿坎尼姆斯的终结‡終結阿肯尼瑪斯',
    nil,
    'Destrua Arcanimus e, então, fale novamente com Ethenial Umbraluna, que fica nos Jardins Lua Serena.‡Уничтожьте Арканимуса и вернитесь к Этениалу Тени Луны в сады Лунного Покоя.‡Vernichtet Arkanimus und kehrt zu Ethenial Mondnacht bei den Mondruhgärten zurück.‡아르카니무스를 처치하고 달쉼터 정원에 있는 에테니얼 문섀도에게 돌아가야 합니다.‡Destruye a Arcanimus y vuelve junto a Ethenial Umbraluna en los Jardines Reposo Lunar.‡Destruye a Arcanimus y vuelve junto a Ethenial Umbraluna en los Jardines Reposo Lunar.‡Détruisez Arcanimus, puis retournez voir Ethénial Lunombre aux Jardins de Repos-de-Lune.‡摧毁阿坎尼姆斯，然后返回眠月花园向伊瑟尼安·月影复命。‡消滅阿肯尼瑪斯，然後回去找月眠花園的伊希尼歐·月影。',
  }
},
[12014] = {
  {
    'Firme como uma rocha?‡Крепкий как камень?‡Fels in der Brandung?‡돌처럼 단단한?‡¿Duro como una piedra?‡¿Duro como una piedra?‡Stable comme un roc ?‡坚如磐石？‡穩若泰山?',
    nil,
    'Recupere o Sismógrafo Portátil, use-o para tomar leituras de estabilidade em Thor Modan, e então fale novamente com Brugar Rasgalito no Acampamento da Brigada de Cerro Oeste.‡Верните портативный сейсмограф и сделайте последний замер колебаний в Тор Модане, после чего вернитесь к Бругару Гравировщику в Лагерь дружины Западного Края.‡Beschafft den tragbaren Seismographen und führt mit ihm Messungen durch, um die Stabilität in Thor Modan zu untersuchen. Kehrt anschließend zu Brugar Steinscher im Lager der Westfallbrigade zurück.‡휴대용 진동계를 회수하여 토르 모단의 안전성 수치를 측정한 다음 서부 몰락지대 여단 야영지에 있는 브루가르 스톤쉬어에게 돌아가야 합니다.‡Recupera el sismógrafo portátil y úsalo para recoger lecturas de estabilidad en Thor Modan. Después, vuelve con Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente.‡Recupera el sismógrafo portátil y úsalo para recoger lecturas de estabilidad en Thor Modan. Después, vuelve con Brugar Petraescucha en el Campamento de la Brigada de los Páramos de Poniente.‡Retrouver le Sismographe portable et s’en servir pour mesurer la stabilité de Thor Modan, puis retourner voir Brugar Cisaillepierre au Campement de la brigade de la marche de l’Ouest.‡夺回便携式测震仪，并用它记录索尔莫丹地下隧道的稳定性指数，然后返回月溪旅营地，向布鲁加尔·石剪复命。‡拿回可攜式地震儀，並使用它讀取鐸爾莫丹的讀數。最後向西荒兵團駐營的布魯嘉·石聽回報。',
  }
},
[12015] = {
  {
    'Test Quest for Craig‡Тестовое задание для Крейга‡Test Quest for Craig‡크레이그를 위한 시험용 퀘스트‡Test Quest for Craig‡Test Quest for Craig‡Quête de test pour Craig‡Test Quest for Craig‡Test Quest for Craig',
    nil,
    'Craig Amai at wherever wants you to bring him 5 whatevers.‡Принесите 5 незнамо чего Крейгу Амай незнамо куда.‡Craig Amai at wherever wants you to bring him 5 whatevers.‡어딘가에 있는 크레이그 아마이가 무언가를 5개 가져와 달라고 부탁했습니다.‡Craig Amai at wherever wants you to bring him 5 whatevers.‡Craig Amai at wherever wants you to bring him 5 whatevers.‡Craig de Quelque part veut que vous rapportiez 5 Quelque chose.‡Craig Amai at wherever wants you to bring him 5 whatevers.‡Craig Amai at wherever wants you to bring him 5 whatevers.',
  }
},
[12016] = {
  {
    'A isca‡Наживка‡Der Köder‡미끼‡El cebo‡El cebo‡L\'appât‡诱饵‡誘餌',
    nil,
    'Consiga a Carne de "Duas Pinças Enormes" e entregue-a para Tua\'kea, no Porto Moa\'ki.‡Добудьте мясо матриарха по прозвищу "Огромные Клешни" и принесите его Туа\'кеа в гавань Моа\'ки.‡Besorgt das Fleisch von "Zwei gewaltige Scheren" und liefert es bei Tua\'kea im Hafen Moa\'ki ab.‡"거대 쌍 집게발"의 게살을 손에 넣은 다음 모아키 항구에 있는 투아키에게 가져가야 합니다.‡Consigue la carne de "Dos Pinzas Enormes" y llévasela a Tua\'kea en el Puerto Moa\'ki.‡Consigue la carne de "Dos Pinzas Enormes" y llévasela a Tua\'kea en el Puerto Moa\'ki.‡Obtenir la Chair de « Deux-grosses-pinces » et l\'apporter à Tua\'kea à Port-Moa\'ki.‡取得“双钳巨蟹”的肉，把它交给莫亚基港口的图尔凯。‡取得『雙巨螯』之肉，並且把它交給默亞基港的突凱亞。',
  }
},
[12017] = {
  {
    'Carne no anzol‡Наживка на крючке‡Fleisch am Haken‡낚싯바늘에 꿴 고기‡Carne en el anzuelo‡Carne en el anzuelo‡De la viande au bout de la ligne‡鱼钩上的肉‡鉤上的肉',
    nil,
    'Mate Tu\'u\'gwar e então fale novamente com Tua\'kea, no Porto Moa\'ki.‡Убейте Ту\'у\'гвара, а затем вернитесь к Туа\'кеа в гавань Моа\'ки.‡Streckt Tu\'u\'gwar nieder und kehrt anschließend zu Tua\'kea im Hafen Moa\'ki zurück.‡투우그와르를 처치한 다음 모아키 항구에 있는 투아키에게 돌아가야 합니다.‡Mata a Tu\'u\'gwar y luego vuelve con Tua\'kea en el Puerto Moa\'ki.‡Mata a Tu\'u\'gwar y luego vuelve con Tua\'kea en el Puerto Moa\'ki.‡Tuer Tu\'u\'gwar et retourner voir Tua\'kea à Port-Moa\'ki.‡杀死图格瓦尔，然后向莫亚基港口的图尔凯复命。‡殺掉吐烏格瓦，向默亞基港的突凱亞回報。',
  }
},
[12018] = {
  {
    'Sweet Revenge‡Месть сладка‡Rache ist süß‡달콤한 복수‡Dulce venganza‡Dulce venganza‡La vengeance est un plat qui se mange froid‡Sweet Revenge‡甜美的復仇',
    nil,
    'Obtain 2 Stone Hunks O\' Gargoyle from Carrion Gargoyles in the Eastern Carrion Fields. Return to Lord Bevis when the task is complete.‡Добудьте 2 отколотых куска горгульи, убивая горгулий-падальщиков с восточных Полей Падальщиков. Выполнив задачу, вернитесь к лорду Бевису.‡Beschafft Euch 2 Gargoylekieselhaufen von Aasgargoyles von den östlichen Aasfeldern. Kehrt zu Lord Bevis zurück, sobald Ihr die Aufgabe erfüllt habt.‡부패의 벌판의 동쪽에 있는 청소부 가고일에게서 가고일 돌 파편 2개를 입수한 다음 군주 베비스에게 돌아가야 합니다.‡Consigue dos trozos de piedra de gárgola de gárgolas carroñeras en el este de Los Campos de Carroña. Vuelve con Lord Bevis cuando termines.‡Consigue dos trozos de piedra de gárgola de gárgolas carroñeras en el este de Los Campos de Carroña. Vuelve con Lord Bevis cuando termines.‡Récupérez 2 Morceaux de pierre de gargouille sur les Gargouilles putrides dans les Champs de la Charogne de l’est. Revenez voir le seigneur Bevis quand vous aurez terminé.‡Obtain 2 Stone Hunks O\' Gargoyle from Carrion Gargoyles in the Eastern Carrion Fields.  Return to Lord Bevis when the task is complete.‡從東部腐屍農地的腐屍石像鬼身上取得2個石像鬼的石頭軀幹。等任務完成之後回去找貝維思領主。',
  }
},
[12019] = {
  {
    'Últimos ritos‡Последние ритуалы‡Letzte Riten‡마지막 의식‡Los últimos ritos‡Los últimos ritos‡Derniers sacrements‡最后的义务‡最後的儀式',
    nil,
    'Vá para a Cidade-Templo de En\'kilah e encontre a orbe de teleporte abaixo da cidade Flagelo de Naxxnar. Use-a para chegar até o topo e ajude Thassarian lá.‡Отправьтесь в Храмовый город Эн\'кила и отыщите сферу телепортации под парящей цитаделью Наксанар. Используйте сферу, чтобы попасть на вершину цитадели и помочь Тассариану.‡Geht zur Tempelstadt En\'kilah und sucht die Teleportationskugel unter der schwebenden Geißelzitadelle von Naxxanar. Benutzt sie, um ganz nach oben zu gelangen und helft dort Thassarian.‡엔킬라 사원에서 공중 스컬지 성채 낙사나르 밑에 있는 순간이동 보주를 사용해 꼭대기로 이동한 다음 그곳에 있는 타사리안을 도와야 합니다.‡Ve hasta la Ciudad Templo de En\'kilah y encuentra el orbe de teletransporte que se encuentra bajo la ciudadela flotante de la Plaga en Naxxanar. Úsalo para alcanzar el punto más alto y ayudar allí a Thassarian.‡Ve hasta la Ciudad Templo de En\'kilah y encuentra el orbe de teletransporte que se encuentra bajo la ciudadela flotante de la Plaga en Naxxanar. Úsalo para alcanzar el punto más alto y ayudar allí a Thassarian.‡Allez dans la Ville-temple d\'En\'Kilah et trouvez l\'Orbe de téléportation situé sous la citadelle flottante du Fléau de Naxxanar. Utilisez-le pour atteindre le sommet, et aidez Thassarian.‡进入圣城恩其拉，找到浮空城纳克萨纳尔下方的传送宝珠。使用它进入浮空城的顶部，然后帮助萨萨里安。‡前往恩吉拉聖城並且找出浮空要塞納克薩爾下方的傳送寶珠。使用寶珠抵達塔頂，然後幫助薩沙理安。',
  }
},
[12020] = {
  {
    'Certa vez, quando eu estava bêbado...‡Однажды, напившись в...‡Dieses eine Mal, als ich betrunken war...‡가을 축제를 즐기는 자세‡Ese día que estaba borracho...‡Ese día que estaba borracho...‡Et une fois, quand j\'étais ivre...‡那次，我喝醉了之后......‡就這麼一次，在我酒醉的時候…',
    nil,
    'Fale com Caxias Girafuso na CervaFest.‡Поговорите с Бокси Болтокрутом в лагере Хмельного фестиваля.‡Sprecht mit Boxi Bolzdreher im Braufestlager.‡가을 축제 천막에 있는 복시 볼트스피너와 이야기해야 합니다.‡Habla con Boxey Bolahuso en el campamento de la Fiesta de la cerveza.‡Habla con Boxey Bolahuso en el campamento de la Fiesta de la cerveza.‡Parlez à Boxey Tournécrou au campement de la fête des Brasseurs.‡与美酒节营地的波克希·博斯宾谈一谈。‡與啤酒節營地的博克西·栓旋者交談。',
  }
},
[12021] = {
  {
    'A Letter Home‡Письмо домой‡Ein Brief in die Heimat‡집으로 보내는 편지‡Una carta a casa‡Una carta a casa‡Une lettre pour la maison‡一封家书‡家書',
    nil,
    'Bring the letter home to Lady Alustra in the Eastern Carrion Fields.‡Доставьте письмо домой к леди Алистре на восточные Поля Падальщиков.‡Bringt den Brief zu Lady Alustra in den östlichen Aasfeldern.‡부패의 벌판 동쪽에 있는 귀부인 알루스타에게 편지를 전달해야 합니다.‡Lleva la carta a casa a Lady Alustra a Los Campos de Carroña del este.‡Lleva la carta a casa a Lady Alustra a Los Campos de Carroña del este.‡Apportez la Lettre pour la maison à Dame Alustra dans les Champs de la Charogne de l’est.‡Bring the letter home to Lady Alustra in the Eastern Carrion Fields.‡將家書帶給東部腐屍農地的艾露斯卓女士。',
  }
},
[12022] = {
  {
    'Caneco no boneco!‡Пей до дна!‡Haut weg das Zeug!‡아자! 가자! 나가자!‡¡Traga y tira!‡¡Traga y tira!‡Buvez, éliminez !‡扔酒杯！‡乾了再砸!',
    nil,
    'Use a Amostra de Cortesia da CervaFest para acertar o B.I.R.I.T.A. 5 vezes. Em seguida, fale com Caxias Girafuso.‡Попадите кружкой с бесплатным пивом в С.С.М. 5 раз, затем поговорите с Бокси Болтокрутом.‡Benutzt den Freibierkrug, um A.L.K. fünfmal zu treffen, und sprecht dann mit Boxi Bolzdreher.‡시음용 가을 축제 맥주를 사용하여 주.정.뱅.이.를 5번 맞힌 후 복시 볼트스피너와 대화해야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Boxey Bolahuso.‡Utilisez le Tastebière-cadeau pour toucher la C.E.R.V.O.I.S.E. 5 fois, puis revenez parler à Boxey Tournécrou.‡用免费美酒节取样器击中掷杯训练器5次，然后与波克希·博斯宾谈一谈。‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和博克西·栓旋者談談。',
  }
},
[12023] = {
  {
    '‡Сладость мести‡Noch süßere Rache‡‡Venganza más dulce‡Venganza más dulce‡La vengeance est un plat qui se mange glacé‡甜蜜的复仇‡',
    nil,
    '‡Убейте поганище, бродящее по склону в восточных Полях Падальщиков. Затем возвращайтесь к лорду Бевису.‡Tötet die Monstrosität am Hang in den Östlichen Aasfeldern. Kehrt sofort zu Lord Bevis zurück, wenn Ihr mit der Hinrichtung fertig seid.‡‡Mata a la abominación en la ladera de Los Campos de Carroña del Este. Vuelve con Lord Bevis cuando hayas terminado la matanza.‡Mata a la abominación en la ladera de Los Campos de Carroña del Este. Vuelve con Lord Bevis cuando hayas terminado la matanza.‡Tuez l\'Abomination sur la colline dans les Champs de la Charogne de l\'est. Revenez voir le seigneur Bevis quand le massacre sera terminé.‡‡',
  }
},
[12024] = {
  {
    'Recording the Fallen‡Перепись павших‡Die Gefallenen registrieren‡죽은 자의 이름‡Registro de los fallecidos‡Registro de los fallecidos‡L\'enregistrement des morts‡记录阵亡者‡記錄陣亡者',
    nil,
    'Search the skeletons in the Carrion Fields for Alliance Settlement Documents.‡Обыщите скелеты на Полях Падальщиков и заберите у них расчетные ведомости Альянса.‡Durchsucht die Skelette auf den Aasfeldern nach Siedlungsdokumenten der Allianz.‡부패의 벌판에 있는 해골을 뒤져 얼라이언스 거주 증명서를 찾아야 합니다.‡Busca documentos de Acuerdo de la Alianza entre los esqueletos de Campos de Carroña.‡Busca documentos de Acuerdo de la Alianza entre los esqueletos de Campos de Carroña.‡Fouillez les squelettes dans les Champs de la Charogne pour trouver des Certificats d’installation de l’Alliance.‡在腐臭平原的骸骨中寻找联盟居民名单。‡搜索腐屍農地上的骨骸，尋找聯盟居住地文件。',
  }
},
[12025] = {
  {
    'A Scarlet Among Us‡Алый орден среди нас‡Ein Scharlachroter unter uns‡붉은십자군의 첩자‡Un Escarlata entre nosotros‡Un Escarlata entre nosotros‡Une touche d\'écarlate‡A Scarlet Among Us‡血色內奸',
    nil,
    'Search for evidence of the Scarlet Crusade on the freshly risen Carrion Ghouls in the Eastern Carrion Fields. Return to Lady Alustra with anything you find.‡Отыщите свидетельства связи с Алым орденом на недавно появившихся вурдалаках-падальщиках с восточных Полей Падальщиков. Когда что-нибудь найдете, вернитесь к леди Алустре.‡Sucht bei den erst kürzlich auferstandenen Aasghule in der östlichen Gegend der Aasfelder nach Beweisen hinsichtlich des Scharlachroten Kreuzzugs. Bringt Lady Alustra alles, was Ihr finden könnt.‡부패의 벌판 동부에 새롭게 나타난 부패의 구울에게서 붉은십자군의 단서를 찾아 귀부인 알루스타에게 돌아가야 합니다.‡Busca pistas sobre la Cruzada Escarlata sobre los necrófagos carroñeros recién levantados en Los Campos de Carroña. Vuelve a ver a Lady Alustra con cualquier información que encuentres.‡Busca pistas sobre la Cruzada Escarlata sobre los necrófagos carroñeros recién levantados en Los Campos de Carroña. Vuelve a ver a Lady Alustra con cualquier información que encuentres.‡Cherchez des preuves de la présence de la Croisade écarlate sur les Goules putrides dans les Champs de la Charogne de l’est. Retournez voir Dame Alustra avec tout ce que vous aurez trouvé.‡在Eastern Carrion Fields内刚被召唤起的Carrion Ghoul中寻找有关血色十字军的线索。将你的发现报告给Lady Alustra。‡在東部腐屍農地中新近復活的腐屍食屍鬼身上尋找血色十字軍的證據。把你找到的東西拿回去給艾露斯卓女士。',
  }
},
[12026] = {
  {
    'O diário danificado‡Порванный журнал‡Das beschädigte Tagebuch‡손상된 일지‡El diario deteriorado‡El diario deteriorado‡Le journal endommagé‡破损的日记‡破損的日誌',
    nil,
    'Recupere 8 Páginas Perdidas do Diário , combine-as com o Diário Incompleto e entregue o diário completo à Sábia Paluna na Aldeia Oneqwah.‡Разыщите 8 недостающих страниц, вклейте их в дневник и верните его Ведунье Палуне в Лагерь Уанква.‡Sammelt 8 der fehlenden Tagebuchseiten, ergänzt damit das Tagebuch und bringt der Weisen Paluna im Camp Oneqwah das vervollständigte Buch.‡잃어버린 일지 페이지 8장을 되찾아 완성되지 않은 일지와 합쳐 완성된 일지로 만들어 원크와 아영지에 있는 현자 팔루나에게 가져가야 합니다.‡Recupera 8 hojas de diario desaparecidas, completa con ellas el diario incompleto y devuélvele el diario completo a la sabia Paluna en el Campamento Oneqwah.‡Recupera 8 hojas de diario desaparecidas, completa con ellas el diario incompleto y devuélvele el diario completo a la sabia Paluna en el Campamento Oneqwah.‡Retrouvez les 8 Pages manquantes du journal, combinez-les avec le Journal incomplet, et remettez le journal complété à la Sage Paluna, au Camp Oneqwah.‡收集8张遗失的日记书页，将它们与不完整的日记合并，然后将完整的日记交给欧尼瓦营地的先知帕鲁纳。‡找回8頁失蹤日誌紙頁，將它們和不完整的日誌黏合起來，然後將完整的日誌交給歐尼克瓦營地的賢者帕努納。',
  }
},
[12027] = {
  {
    'As Perigosas Peripécias do Sr. Pinote‡Удивительное приключение мистера Ушастика‡Mr. Floppys gefährliches Abenteuer‡깡총 군의 모험‡La arriesgada aventura de Floppy‡La arriesgada aventura de Floppy‡La grande aventure de monsieur Toumou‡小毛球的冒险‡軟綿綿先生的冒險之旅',
    nil,
    'Ajude Emília e o Sr. Pinote a voltar ao Acampamento da Brigada de Cerro Oeste, e então fale com o Escudeiro Walter.‡Помогите Эмили и мистеру Ушастику вернуться в Лагерь дружины Западного Края, после чего поговорите с оруженосцем Волтером.‡Helft Emily und Mr. Floppy, den Weg zurück zum Lager der Westfallbrigade zu finden, dann sprecht mit dem Knappen Walter.‡에밀리와 깡총 군이 서부 몰락지대 여단 야영지로 돌아가는 것을 도와준 다음 종자 월터와 대화해야 합니다.‡Ayuda a Emily y a Floppy a volver al Campamento de la Brigada de los Páramos de Poniente.‡Ayuda a Emily y a Floppy a volver al Campamento de la Brigada de los Páramos de Poniente.‡Aidez Emilie et Monsieur Toumou à regagner le Campement de la brigade de la marche de l’Ouest. Lorsque ce sera fait, allez parler à l’Écuyer Walter.‡帮助艾米莉和小毛球逃回月溪旅营地，然后向侍从瓦尔特复命。‡幫助愛蜜莉和軟綿綿先生回到西荒兵團駐營，然後再向侍從沃特交談。',
  }
},
[12028] = {
  {
    'Iluminação espiritual‡Духовное озарение‡Spirituelle Eingebung‡영적인 통찰‡Visión espiritual‡Visión espiritual‡Clairvoyance spirituelle‡灵魂视界‡靈魂洞察',
    nil,
    'Fale com Toalu\'u, o Místico, no Porto Moa\'ki, quando obtiver a iluminação espiritual.‡Поговорите с Тоалу\'у Мистиком после того, как пройдете обряд поиска видений.‡Sprecht mit Toalu\'u dem Mystiker im Hafen Moa\'ki, nachdem Euch die spirituelle Eingebung zuteil wurde.‡영적인 통찰을 얻어 임무를 마친 후 모아키 항구에 있는 비술사 토아루우와 대화해야 합니다.‡Habla con Toalu\'u el Místico en el Puerto Moa\'ki una vez que hayas alcanzado tu visión espiritual.‡Habla con Toalu\'u el Místico en el Puerto Moa\'ki una vez que hayas alcanzado tu visión espiritual.‡Parlez à Toalu\'u le Mystique à Port-Moa\'ki après avoir atteint la clairvoyance spirituelle.‡通过灵魂视界观察因度雷村，然后向莫亚基港口的秘法师图阿鲁汇报情况。‡完成靈魂洞察之後和默亞基港的『秘法師』托阿魯交談。',
  }
},
[12029] = {
  {
    'Churrasco de Flagelo‡Пылающая Плеть‡Die angesengte Geißel‡불타는 스컬지‡Plaga chamuscada‡Plaga chamuscada‡Fléau flambé‡净化天灾巨魔‡燒烤天譴軍',
    nil,
    'Mack, nas Fontes Graníticas, quer que você use o grogue dele para queimar 20 Trolls Esfomeados do Flagelo em Drak\'Tharon.‡Мак с Гранитных ключей просит вас поджечь 20 голодающих троллей Плети с помощью его грога.‡Mack beim Granitquell möchte, dass Ihr seinen Grog benutzt, um 20 ausgemergelte Geißeltrolle in Drak\'Tharon zu verbrennen.‡화강암 웅덩이에 있는 맥이 그로그주를 사용해 드락타론의 굶주린 스컬지 트롤 20명을 불태워 달라고 했습니다.‡Mack en Manantial de Granito quiere que uses su grog para matar a 20 trols de la Plaga famélicos en Drak\'Tharon.‡Mack en Manantial de Granito quiere que uses su grog para matar a 20 trols de la Plaga famélicos en Drak\'Tharon.‡Mack, aux Sources de granit, veut que vous utilisiez son grog pour brûler 20 Trolls faméliques du Fléau à Drak’Tharon.‡岩石之泉的马克希望你在达克萨隆用他的烈酒净化20个饥饿的天灾巨魔。‡花崗岩之泉的麥客要你前往德拉克薩隆，使用他的烈酒去燒20個極餓的天譴食人妖。',
  }
},
[12030] = {
  {
    'Ancião Mana\'loa‡Старейшина Мана\'лоа‡Ältester Mana\'loa‡장로 마나로아‡El ancestro Mana\'loa‡El ancestro Mana\'loa‡L\'Ancien Mana\'loa‡长者玛纳洛‡長者馬納洛亞',
    nil,
    'Fale com a estátua do Ancião Mana\'loa, na Aldeia Indu\'le.‡Поговорите со статуей старейшины Мана\'лоа в деревне Инду\'ле.‡Sprecht mit der Statue vom Ältesten Mana\'loa in Indu\'le.‡인두르 마을에 있는 조각상인 장로 마나로아와 대화해야 합니다.‡Habla con la estatua del ancestro Mana\'loa en el Poblado Indu\'le.‡Habla con la estatua del ancestro Mana\'loa en el Poblado Indu\'le.‡Parlez à la statue de l\'Ancien Mana\'loa à Indu\'le.‡前往因度雷村，与长者玛纳洛的雕像谈一谈。‡和長者馬納洛亞交談，他就是因度雷村中的雕像。',
  }
},
[12031] = {
  {
    'Liberdade para os espíritos‡Свобода перемещения‡Freiheit den Verweilenden‡떠도는 영혼에 자유를‡Libertad para los que padecen‡Libertad para los que padecen‡La liberté pour ceux qui ne peuvent partir‡解脱和安息‡解放徘徊者',
    nil,
    'Dê o descanso final a 15 aldeões Indu\'le, dentre Pescadores, Místicos e Guerreiros. Então fale com o Ancião Mana\'loa na Aldeia Indu\'le.‡Успокойте рыбаков, мистиков и воинов из деревни Инду\'ле (общим числом 15 противников), а затем вернитесь к старейшине Мана\'лоа в деревню Инду\'ле.‡Erlöst insgesamt 15 Geister von Indu\'le, egal ob Fischer, Mystiker oder Krieger, und kehrt anschließend zum Ältesten Mana\'loa in Indu\'le zurück.‡인두르 낚시꾼, 인두르 비술사, 인두르 전사를 종류에 상관없이 15명 처치한 다음 인두르 마을에 있는 장로 마나로아에게 돌아가야 합니다.‡Devuelve la paz a cualquier combinación de 15 pescadores Indu\'le, místicos Indu\'le y guerreros Indu\'le y vuelve a ver al ancestro Mana\'loa al Poblado Indu\'le.‡Devuelve la paz a cualquier combinación de 15 pescadores Indu\'le, místicos Indu\'le y guerreros Indu\'le y vuelve a ver al ancestro Mana\'loa al Poblado Indu\'le.‡Donnez le repos à 15 habitants d\'Indu\'le, qu\'il s\'agisse de Pêcheurs, de Mystiques ou de Guerriers, puis retournez auprès de l\'Ancien Mana\'loa à Indu\'le.‡让15名因度雷海象人安息，渔夫、秘法师或是战士都行。完成任务后向因度雷村的长者玛纳洛复命。‡讓總計15名的因度雷漁夫、因度雷秘法師或因度雷戰士獲得安息，並向因度雷村的長者馬納洛亞回報。',
  }
},
[12032] = {
  {
    'Conversando com as profundezas‡Разговор с бездной‡Gespräche mit den Tiefen‡심연의 대화‡Conversando con las profundidades‡Conversando con las profundidades‡Entretien avec les profondeurs‡海洋女神‡深海晤談',
    nil,
    'Invoque Oacha\'noa com a Pérola das Profundezas e faça o que a deusa do mar ordenar.|n|nSe você sobreviver à prova, fale novamente com Toalu\'u, o Místico, no Porto Moa\'ki.‡Обратитесь к Жемчужине Бездны и выполните распоряжения морской богини Оача\'ноа.|n|nЕсли вы переживете все испытания, вернитесь к Тоалу\'у Мистику в гавани Моа\'ки.‡Nehmt mithilfe der Perle der Tiefen Verbindung mit der Meeresgöttin Oacha\'noa auf und tut, was sie befiehlt.|n|nKehrt zu Toalu\'u dem Mystiker im Hafen Moa\'ki zurück, falls Ihr die Feuerprobe bestehen solltet.‡심연의 진주로 바다의 여신 오아카노아와 대화한 다음 그녀의 지시에 따라야 합니다.|n|n이 시련을 이겨낸 다음 모아키 항구에 있는 비술사 토아루우에게 돌아가십시오.‡Reza ante La Perla de las Profundidades y haz todo lo que te indique la diosa marina Oacha\'noa.|n|nSi sobrevives al penoso calvario, vuelve a ver a Toalu\'u el Místico en el Puerto Moa\'ki.‡Reza ante La Perla de las Profundidades y haz todo lo que te indique la diosa marina Oacha\'noa.|n|nSi sobrevives al penoso calvario, vuelve a ver a Toalu\'u el Místico en el Puerto Moa\'ki.‡Communiez avec la Perle des profondeurs et faites ce que la déesse des mers Oacha\'noa vous demandera.|n|nSi vous survivez à cette épreuve, retournez voir Toalu\'u le Mystique à Port-Moa\'ki.‡与深海珍珠进行沟通，按照海之女神奥卡诺娅的指示行动。|n|n通过考验后，回到龙骨荒野的莫亚基港口，向秘法师图阿鲁复命。‡透過深淵珍珠溝通，照著海神歐巧諾亞指示的去做。|n|n只要你通過了考驗，就向默亞基港的『秘法師』托阿魯回報。',
  }
},
[12033] = {
  {
    'Mensagem do oeste‡Послание с запада‡Nachricht aus dem Westen‡서쪽에서 온 전갈‡Un mensaje desde el Oeste‡Un mensaje desde el Oeste‡Un message de l\'ouest‡萨鲁法尔的信‡從西方來的消息',
    nil,
    'Leia a Carta de Saurfang e, depois, destrua-a.|n|nFale com o Mensageiro Torvus ao completar essa tarefa.‡Прочитайте письмо от Саурфанга и уничтожьте его.|n|nВыполнив это, поговорите с посланником Торвусом.‡Lest den Brief von Saurfang und zerstört ihn anschließend.|n|nSprecht mit Bote Torvus, sobald Ihr die Aufgabe abgeschlossen habt.‡사울팽의 편지를 읽은 다음 파기해야 합니다.|n|n일을 마치면 전령 토르부스와 대화해야 합니다.‡Lee la carta de Colmillosauro y después destrúyela.|n|nHabla con el mensajero Torvus cuando hayas terminado esta tarea.‡Lee la carta de Colmillosauro y después destrúyela.|n|nHabla con el mensajero Torvus cuando hayas terminado esta tarea.‡Lisez la Lettre de Saurcroc, puis détruisez-la.|n|nParlez au Messager Torvus une fois votre tâche accomplie.‡阅读萨鲁法尔给你的信，然后摧毁它。|n|n做完这件事情之后与信使托弗斯谈一谈。‡閱讀來自薩爾法魯的信，然後把它給毀了。|n|n等你完成之後再和信差托伏斯交談。',
  }
},
[12034] = {
  {
    'A vitória se aproxima‡Победа близка…‡Der Sieg ist nahe...‡눈앞의 승리‡La victoria se acerca...‡La victoria se acerca...‡La victoire approche…‡胜利将近……‡勝利在望…',
    nil,
    'Fale com o Primeiro-Sargento Juktok, que fica no Martelo de Agmar.‡Поговорите с главным сержантом Юктоком в Молоте Агмара.‡Sprecht mit Schlachtrufer Juktok in Agmars Hammer.‡아그마르의 망치에 있는 정예수호병 주크토크과 대화해야 합니다.‡Habla con el capataz primero Juktok en el Martillo de Agmar.‡Habla con el capataz primero Juktok en el Martillo de Agmar.‡Parlez au Sergent-chef Juktok au Marteau d’Agmar.‡与阿格玛之锤的军士长祖托克谈一谈。‡和阿格瑪之錘的資深士官丘科多克交談。',
  }
},
[12035] = {
  {
    'Tecnologia reobjetivada‡Переналадка технологии‡Wiederverwertung von Technologie‡재가동 기술‡Tecnología con otro propósito‡Tecnología con otro propósito‡Technologie reconvertie‡重新装配‡改寫技術',
    nil,
    'Jeremias Ranieri, em Algures, quer que você destrua 5 Golens Colheiteiros e use as Ferramentas do Jeremias para reprogramá-los.‡По поручению Иеремии Хоунинга обезвредьте 5 сборщиков урожая, а затем воспользуйтесь инструментами Иеремии, чтобы перемонтировать их.‡Jeremias Hohning in Fernhain möchte, dass Ihr 5 Erntesammler zerstört und dann Jeremias\' Werkzeuge benutzt, um sie neu zu verkabeln.‡파샤이어의 제레미어 호닝이 작물 수확기 5대를 정지시킨 다음, 제레미어의 연장을 사용해 개조해 달라고 부탁했습니다.‡Jeremiah Hawning en Lindeallá quiere que destruyas a 5 recolectores de cosecha y que luego uses las herramientas de Jeremiah para alterar su sistema eléctrico.‡Jeremiah Hawning en Lindeallá quiere que destruyas a 5 recolectores de cosecha y que luego uses las herramientas de Jeremiah para alterar su sistema eléctrico.‡Jeremiah Hawning, de Comté-lointaine, vous demande de détruire 5 Collecteurs des moissons et d\'ensuite utiliser les Outils de Jeremiah pour modifier leurs circuits.‡致远郡的耶雷米亚·霍宁要你打倒5个收割采集者，并使用耶雷米亚的工具重新组装它们。‡遠郡的杰瑞米亞·豪寧要你摧毀5台收割機器人，然後使用杰瑞米亞的工具重新改寫它們。',
  }
},
[12036] = {
  {
    'Das profundezas de Azjol-Nerub‡Глубины Азжол-Неруба‡Aus den Tiefen von Azjol-Nerub‡아졸네룹의 심연에서‡Desde las profundidades de Azjol-Nerub‡Desde las profundidades de Azjol-Nerub‡Des profondeurs d\'Azjol-Nérub‡艾卓-尼鲁布的深渊‡從阿茲歐-奈幽的深處',
    nil,
    'Explore o Fosso de Narjun e reporte suas descobertas para o Primeiro-Sargento Juktok no Martelo de Agmar.‡Исследуйте Провал Наржуна и возвращайтесь с данными к главному сержанту Юктоку, ожидающему у Молота Агмара.‡Erforscht die Grube von Narjun und kehrt anschließend mit dem, was Ihr gefunden habt, zu Schlachtrufer Juktok in Agmars Hammer zurück.‡나르준의 구덩이를 조사한 다음 아그마르의 망치에 있는 정예수호병 주크토크에게 돌아가야 합니다.‡Explora El Foso de Narjun y cuéntale lo que hayas descubierto al capataz primero Juktok en Martillo de Agmar.‡Explora El Foso de Narjun y cuéntale lo que hayas descubierto al capataz primero Juktok en Martillo de Agmar.‡Explorez la Fosse de Narjun puis retournez voir le Sergent-chef Juktok au Marteau d\'Agmar pour lui faire part de vos découvertes.‡探索纳尔苏深渊，并将你的发现汇报给阿格玛之锤的军士长祖托克。‡探索那金之淵然後將你發現向阿格瑪之錘的資深士官丘科多克回報。',
  }
},
[12037] = {
  {
    'Busca e resgate‡Спасательная операция‡Rettungsaktion‡수색과 구출‡Búsqueda y rescate‡Búsqueda y rescate‡Mission de sauvetage‡搜寻和营救‡搜救行動',
    nil,
    'Mack, nas Fontes Graníticas, quer que você entre em Drak\'Tharon e descubra o que houve com Kurzel.‡Мак из Гранитных ключей просит вас отправиться в Драк\'Тарон и узнать, все ли в порядке с Курцель.‡Mack beim Granitquell möchte, dass Ihr nach Drak\'Tharon geht und herausfindet, was mit Kurzel passiert ist.‡화강암 웅덩이에 있는 맥이 드락타론 안에 가서 쿠르젤에게 무슨 일이 일어났는지 알아봐 달라고 부탁했습니다.‡Mack, en el Manantial de Granito, quiere que vayas a Drak\'Tharon y averigües que le ha pasado a Kurzel.‡Mack, en el Manantial de Granito, quiere que vayas a Drak\'Tharon y averigües que le ha pasado a Kurzel.‡Mack, des Sources de granit, veut que vous entriez dans Drak’Tharon pour découvrir ce qui est arrivé à Kurzel.‡岩石之泉的马克希望你前往达克萨隆，看看库塞尔到底出了什么事。‡花崗岩之泉的麥客要你進入德拉克薩隆，找出庫賽爾發生了什麼事。',
  }
},
[12038] = {
  {
    'Churrasco de Flagelo‡Пылающая Плеть‡Die angesengte Geißel‡불타는 스컬지‡Plaga chamuscada‡Plaga chamuscada‡Fléau flambé‡净化天灾巨魔‡燒烤天譴軍',
    nil,
    'Mack, nas Fontes Graníticas, quer que você use o grogue dele para queimar 30 Trolls Esfomeados do Flagelo.‡Мак из Гранитных ключей просит вас поджечь 30 голодающих троллей Плети с помощью его грога.‡Mack am Granitquell möchte, dass Ihr seinen Grog nehmt und 30 ausgemergelte Geißeltrolle in Flammen aufgehen lasst.‡화강암 웅덩이에 있는 맥이 그로그주를 사용해 굶주린 스컬지 트롤 30명을 불태워 달라고 했습니다.‡Mack en Manantial de Granito quiere que uses su grog para matar a 30 trols de la Plaga famélicos en Drak\'Tharon.‡Mack en Manantial de Granito quiere que uses su grog para matar a 30 trols de la Plaga famélicos en Drak\'Tharon.‡Mack, aux Sources de granit, veut que vous utilisiez son grog pour brûler 30 Trolls faméliques du Fléau.‡岩石之泉的马克希望你在达克萨隆用他的烈酒净化30个饥饿的天灾巨魔。‡花崗岩之泉的麥客要你使用他的烈酒燒掉30個極餓的天譴食人妖。',
  }
},
[12039] = {
  {
    'O sangue negro de Yogg-Saron‡Черная кровь Йогг-Сарона‡Das schwarze Blut von Yogg-Saron‡요그사론의 검은피‡Sangre negra de Yogg-Saron‡Sangre negra de Yogg-Saron‡Le sang noir de Yogg-Saron‡尤格-萨隆的黑血‡尤格薩倫的黑血',
    nil,
    'Borus Dobraferro, no Martelo de Agmar, no Ermo das Serpes, quer que você recupere 10 Amostras de Sangue Negro de Yogg-Saron.‡Принесите Борусу Железные Клещи из Молота Агмара на Драконьем Погосте 10 образцов черной крови Йогг-Сарона.‡Borus Eisenbieger in Agmars Hammer in der Drachenöde möchte, dass Ihr ihm 10 Proben des schwarzen Blutes von Yogg-Saron beschafft.‡용의 안식처의 아그마르의 망치에 있는 보러스 아이언밴더가 요그사론의 검은피 견본 10개를 구해달라고 부탁했습니다.‡Borus Doblahierro en Martillo de Agmar en el Cementerio de Dragones quiere que consigas 10 muestras de sangre negra de Yogg-Saron.‡Borus Doblahierro en Martillo de Agmar en el Cementerio de Dragones quiere que consigas 10 muestras de sangre negra de Yogg-Saron.‡Borus Torlefer, au Marteau d’Agmar dans la Désolation des dragons, veut que vous vous procuriez 10 Échantillons du sang noir de Yogg-Saron.‡阿格玛之锤的伯鲁斯·折铁要求你收集10份尤格-萨隆黑血样本。‡阿格瑪之錘的伯魯斯·折鐵者要你收集10個尤格薩倫的黑血樣本給他。',
  }
},
[12040] = {
  {
    'Inimigo comum‡Общий враг в лице Артаса‡Arthas zum Feinde‡아서스의 적‡Un enemigo en Arthas‡Un enemigo en Arthas‡Notre ennemi Arthas‡阿尔萨斯的死敌‡在阿薩斯體內的敵人',
    nil,
    'Kilix, o Desfiador, no Fosso de Narjun, no Ermo das Serpes, quer que você mate 6 Sublordes Anub\'ar.‡По заданию Киликса Разрушителя у Провала Наржуна на Драконьем Погосте убейте 6 ануб\'арских владык подземелий.‡Kilix der Entwirrer in der Grube von Narjun in der Drachenöde möchte, dass Ihr 6 Unterfürsten der Anub\'ar tötet.‡용의 안식처의 나르준의 구덩이에 있는 해결자 킬릭스가 아눕아르 지하군주 6마리를 처치해 달라고 부탁했습니다.‡Kilix el Desenmarañador, en El Foso de Narjun del Cementerio de Dragones, te ha pedido que mates 6 infraseñores Anub\'ar.|n‡Kilix el Desenmarañador, en El Foso de Narjun del Cementerio de Dragones, te ha pedido que mates 6 infraseñores Anub\'ar.|n‡Kilix le Démêleur, de la Fosse de Narjun dans la Désolation des dragons, vous a demandé de tuer 6 Seigneurs-du-dessous anub\'ar.‡纳尔苏深渊的拆解者基里克斯要求你杀死6只阿努巴尔蛛魔领主。‡『排除者』齊力克斯要求你殺死6隻阿努巴地下領主。他就在龍骨荒野的那金之淵。',
  }
},
[12041] = {
  {
    'O Império perdido‡Потерянная империя‡Das verlorene Reich‡사라진 제국‡El imperio perdido‡El imperio perdido‡L\'empire perdu‡失落的帝国‡失落的帝國',
    nil,
    'Entregue o Plano de Batalha de Kilix ao Lorde Supremo Agmar no Martelo de Agmar, no Ermo das Serpes.‡Доставьте боевые планы Киликса командиру Агмару в Молот Агмара на востоке.‡Liefert Kilixs Schlachtplan bei Oberanführer Agmar im östlichen Agmars Hammer ab.‡킬릭스의 전투 계획서를 동쪽의 아그마르의 망치에 있는 대군주 아그마르에게 전달해야 합니다.‡Llévale el plan de batalla de Kilix al señor supremo Agmar en Martillo de Agmar al este.‡Llévale el plan de batalla de Kilix al señor supremo Agmar en Martillo de Agmar al este.‡Remettez le Plan de bataille de Kilix au Suzerain Agmar, au Marteau d’Agmar, à l’est.‡将基里克斯的作战计划带到东边的阿格玛之锤去，交给阿格玛大王。‡將齊力克斯的作戰計畫交給霸主阿格瑪，他就在東邊的阿格瑪之錘。',
  }
},
[12042] = {
  {
    'Coração dos antigos‡Сердце древних‡Das Herz der Uralten‡선조의 심장‡Corazón de los ancestros‡Corazón de los ancestros‡Le Cœur des anciens‡古树精华宝石‡先祖之心',
    nil,
    'Drakuru quer que você vá à câmara mais alta da Madeireira Céu Azul e encontre o Coração dos Antigos.‡Дракуру просит вас отправиться в самую верхнюю комнату Лесозаготовок Синего Неба и найти Сердце древних.‡Drakuru möchte, dass Ihr zur höchsten Kammer beim Holzfällerposten Blauhimmel geht und dort nach dem Herz der Uralten sucht.‡드라쿠루가 푸른 하늘 벌목장의 최상층 방으로 가서 선조의 심장을 찾아봐 달라고 부탁했습니다.‡Drakuru quiere que vayas al punto más alto del Aserradero Cielo Azul y que encuentres el corazón de los ancestros.‡Drakuru quiere que vayas al punto más alto del Aserradero Cielo Azul y que encuentres el corazón de los ancestros.‡Drakuru veut que vous vous rendiez dans la partie la plus haute du Chantier d\'abattage du Ciel bleu et que vous trouviez le Cœur des anciens.‡达库鲁希望你前往蓝天伐木场的最上层房间，在一个地精的尸体附近找到古树精华宝石。‡德拉庫魯要你去藍天伐木地最高處的房間找到先祖之心。',
  }
},
[12043] = {
  {
    'Em Defesa do Posto Ferrugem‡Защита Лагеря Соплозабилось‡Verteidigung von Düsenrost‡녹주둥이 전초기지 방어‡Defensa de Boquilla Oxidada‡Defensa de Boquilla Oxidada‡Défense de Rouilletuyère‡诺兹拉斯的防御‡鏽鼻防禦',
    nil,
    'Mate 12 Escavadores dos Ermos e 1 Capataz dos Ermos nas escavações próximas do Repouso de Galakrond. Fale novamente com Narf, no Posto Ferrugem, quando completar a tarefa.‡Убейте 12 землекопов пустошей и одного надсмотрщика пустошей на раскопках, окружающих Покой Галакронда. Вернитесь к Нарфу в Лагерь Соплозабилось, когда задание будет выполнено.‡Tötet 12 Buddler der Weiten und 1 Zuchtmeister der Weiten, die sich in den Ausgrabungsorten um Galakronds Ruhestätte herum befinden. Kehrt anschließend zu Narf im Düsenrostposten zurück, sobald die Aufgabe erledigt ist.‡갈라크론드의 안식처 주변에서 황무지 채굴꾼 12마리와 황무지 감독관 1명을 처치한 다음, 녹주둥이 전초기지에 있는 나르프에게 돌아가야 합니다.‡Mata a 12 cavadores de la Plaga y a 1 capataz del baldío en las excavaciones que rodean Reposo de Galakrond. Vuelve con Narf en el Puesto Boquilla Oxidada cuando hayas completado esta tarea.‡Mata a 12 cavadores de la Plaga y a 1 capataz del baldío en las excavaciones que rodean Reposo de Galakrond. Vuelve con Narf en el Puesto Boquilla Oxidada cuando hayas completado esta tarea.‡Tuer 12 Terrassiers du désert et 1 Sous-chef du désert sur les sites de fouilles autour du Repos de Galakrond. Retourner voir Narf au Poste de Rouilletuyère lorsque la tâche est terminée.‡在迦拉克隆之墓附近的挖掘站内杀死12个废土挖掘者和1个废土工头。完成任务之后向诺兹拉斯哨站的纳尔弗复命。‡在葛拉克朗安息地周邊的挖掘場殺死12個荒原掘地工和1個荒原監工。任務完成之後向鏽鼻崗哨的納孚回報。',
  }
},
[12044] = {
  {
    'Farmácia particular‡Припасти руды‡Aufstocken‡물자 확보‡Abasteciéndose‡Abastecerse‡Approvisionnement‡囤积矿石‡進貨',
    nil,
    'Colete 8 montes de Minério Composto dos buracos próximos ao Repouso de Galakrond, e leve-os para Xink, no Posto Ferrugem.‡Соберите 8 пригоршней композитной руды на раскопках, окружающих Покой Галакронда и принесите их Зинку в Лагерь Соплозабилось.‡Geht zu den Ausgrabungsorten, die sich um Galakronds Ruhestätte herum befinden, sammelt 8 Ladungen Kompositerz und bringt sie anschließend zu Xink im Düsenrostposten.‡갈라크론드의 안식처 근처에 있는 발굴현장에서 합성 광물을 8개 모은 다음 녹주둥이 전초기지에 있는 싱크에게 가져가야 합니다.‡Reúne 8 montones de mena de amalgama de las excavaciones que rodean Reposo de Galakrond y llévaselos a Xink en el Puesto Boquilla Oxidada.‡Reúne 8 montones de mena de amalgama de las excavaciones que rodean Reposo de Galakrond y llévaselos a Xink en el Puesto Boquilla Oxidada.‡Rassemblez 8 tas de Minerai composite des fouilles autour du Repos de Galakrond et rapportez-les à Xink au Poste de Rouilletuyère.‡在迦拉克隆之墓附近的挖掘站内收集8堆合金矿石，把它们交给诺兹拉斯哨站的辛克。‡從葛拉克朗安息地周邊的挖掘場收集8堆混合礦物，然後交給鏽鼻崗哨的辛克。',
  }
},
[12045] = {
  {
    'Estilhaços de gelo‡Битый лед‡Eiskristalle‡얼음의 파편‡Hielo afilado‡Hielo afilado‡Glace pilée‡刨冰‡銼冰',
    nil,
    'Colete 4 Drusas de Estilhaços de Gelo dos Elementais de Gelo ao norte e leve-as para Zivlix, no Posto Ferrugem.‡Соберите 4 горсти осколков льда от ледяных элементалей на севере и принесите их Живликс в Лагерь Соплозабилось.‡Sammelt 4 Eissplitterklumpen von den Eiselementaren gen Norden und bringt sie zu Zivlix im Düsenrostposten.‡북쪽의 얼음 정령에게서 얼음 수정 조각 4개를 모아 녹주둥이 전초기지의 지블릭스에게 가져가야 합니다.‡Recoge 4 montones de fragmentos de hielo de los elementales de hielo al norte y llévaselos a Zivlix en el Puesto Boquilla Oxidada.‡Recoge 4 montones de fragmentos de hielo de los elementales de hielo al norte y llévaselos a Zivlix en el Puesto Boquilla Oxidada.‡Récolter 4 Grappes d\'éclats de glace sur les Élémentaires de glace au nord et les rapporter à Zivlix au Poste de Rouilletuyère.‡在北边的冰元素身上收集4块碎冰簇，把它们交给诺兹拉斯哨站的希弗里克斯。‡從北邊的冰元素身上收集4個寒冰爆裂碎片，帶回來交給鏽鼻崗哨的希伏利克司。',
  }
},
[12046] = {
  {
    'Invólucro macio‡Мягкая оболочка‡Weiches Hüllenmaterial‡부드러운 외피‡Un recubrimiento suave‡Un recubrimiento suave‡Emballage délicat‡柔软的包装‡柔軟的彈殼',
    nil,
    'Colete 12 Pelegos Animais Finos dos Escavadores Yormungar ou dos Condores Dracósseos perto do Posto Ferrugem. Quando conseguir os pelegos, leve-os para Zivlix.‡Соберите 12 тонких шкур животных, убив нужное количество туннельных йормунгаров или глодателей драконьих костей близ Лагеря Соплозабилось. Добыв шкуры, вернитесь с ними к Живликс.‡Sammelt 12 dünne Tierbälge von den Jormungartunnelgräbern oder den Drachenknochenkondoren in der Nähe des Düsenrostpostens und bringt sie anschließend zu Zivlix.‡녹주둥이 전초기지 인근의 요르문가르 땅굴구더기 또는 용뼈 대머리수리에게서 얇은 동물 가죽 12개를 모아 지블릭스에게 가져가야 합니다.‡Recoge 12 pellejos de animal finos de los tuneladores jormungar o de los cóndores de hueso de dragón en los aledaños del Puesto Boquilla Oxidada. Cuando hayas encontrado los pellejos, llévaselos a Zivlix.‡Recoge 12 pellejos de animal finos de los tuneladores jormungar o de los cóndores de hueso de dragón en los aledaños del Puesto Boquilla Oxidada. Cuando hayas encontrado los pellejos, llévaselos a Zivlix.‡Récoltez 12 Peaux d\'animal légères sur les Jormungars tunneliers et les Condors os-de-dragon près du Poste de Rouilletuyère. Une fois que vous aurez récupéré les peaux, rapportez-les à Zivlix.‡从诺兹拉斯哨站附近的掘洞冰虫或龙骨秃鹫身上收集12张薄兽皮，把它们交给希弗里克斯。‡從蟄猛巨蟲隧掘者、或龍骨兀鷹身上收集12張薄獸皮，牠們出沒在鏽鼻崗哨附近。當你拿到了獸皮，把它們給希伏利克司。',
  }
},
[12047] = {
  {
    'Algo que não derreta‡Нечто тугоплавкое‡Etwas, das nicht schmilzt‡녹지 않는 물건‡Algo que no se derrita‡Algo que no se derrita‡Quelque chose qui ne fond pas‡不会融化的东西‡不會融化的東西',
    nil,
    'Procure por 12 Pedaços de Osso Estilhaçado nos ossos de dragão a leste do Posto Ferrugem.‡Найдите среди драконьих костей к востоку от лагеря Соплозабилось 12 расколотых костей.‡Sucht inmitten der Drachenknochen östlich des Düsenrostpostens nach 12 zersplitterten Knochenstücken.‡녹주둥이 전초기지의 동쪽에 있는 용의 뼈 근처에서 조각난 뼈 덩어리 12개를 찾아야 합니다.‡Busca 12 trozos de hueso astillados entre los huesos de dragón al este del Puesto Boquilla Oxidada.‡Busca 12 trozos de hueso astillados entre los huesos de dragón al este del Puesto Boquilla Oxidada.‡Cherchez 12 Morceaux d\'os brisés sur les os de dragon à l\'est du Poste de Rouilletuyère.‡在诺兹拉斯哨站东边的巨龙骸骨堆里收集12块破碎的骨片。‡在鏽鼻崗哨東邊的龍骨中搜尋12根斷裂的大骨。',
  }
},
[12048] = {
  {
    'Armamentos do Flagelo‡Доспехи воинов Плети‡Waffen der Geißel‡스컬지 병기‡Armamentos de la Plaga‡Armamentos de la Plaga‡Les armes du Fléau‡天灾的装备‡天譴武裝',
    nil,
    'Borus Dobraferro, no Martelo de Agmar, no Ermo das Serpes, quer que você colete 8 Armamentos do Flagelo.‡Принесите 8 элементов доспехов воинов Плети Борусу Железные Клещи из Молота Агмара.‡Borus Eisenbieger in Agmars Hammer in der Drachenöde möchte, dass Ihr ihm 8 Waffen der Geißel bringt.‡용의 안식처의 아그마르의 망치에 있는 보러스 아이언밴더가 스컬지 병기 8개를 구해달라고 부탁했습니다.‡Borus Doblahierro en Martillo de Agmar en el Cementerio de Dragones quiere que le traigas 8 armamentos de la Plaga.‡Borus Doblahierro en Martillo de Agmar en el Cementerio de Dragones quiere que le traigas 8 armamentos de la Plaga.‡Borus Torlefer, au Marteau d\'Agmar dans la Désolation des dragons, veut que vous lui rapportiez 8 Armes du Fléau.‡阿格玛之锤的伯鲁斯·折铁要求你给他带回8套天灾军备。‡伯魯斯·折鐵者要你收集8個天譴武裝，他就在龍骨荒野的阿格瑪之錘。',
  }
},
[12049] = {
  {
    'Duro de engolir‡Мясо с пылу с жару‡Schwer zu schlucken‡삼키기 힘든 것‡Difícil de tragar‡Difícil de tragar‡Dur à avaler‡难以下咽‡難以下嚥',
    nil,
    'Lute com um Yormungar Imponente a leste do Posto Ferrugem até que ele abra a boca, então jogue uma Carga Explosiva Potente na garganta do verme. Quando o verme explodir, colete 6 nacos de Carne de Yormungar Queimada do chão e leve-os de volta para Xink.‡К востоку от Лагеря Соплозабилось сразитесь с огромным йормунгаром – до тех пор, пока тот не откроет рот. Затем бросьте ему в глотку мощную взрывчатку. После взрыва соберите 6 кусков обугленного мяса йормунгара с земли и принесите их Зинку.‡Kämpft so lange gegen einen bulligen Jormungar östlich des Düsenrostpostens, bis er sein Maul öffnet, um dann eine potente Sprengladung hineinzuwerfen. Sammelt, nachdem er explodiert ist, 6 Stücke verbranntes Jormungarfleisch vom Boden auf und bringt sie zu Xink.‡녹주둥이 전초기지 동쪽에 있는 덩치 큰 요르문가르와 전투를 벌여, 요르문가르가 입을 벌렸을 때 강력한 폭발물을 던져 넣으십시오. 요르문가르가 폭발하면 주변에 흩어진 그슬린 요르문가르 고기 6개를 주워 싱크에게 가져가야 합니다.‡Lucha contra un jormungar descomunal al este del Puesto Boquilla Oxidada hasta que abra la boca y lánzale una carga explosiva potente dentro de la garganta. Recoge 6 trozos de carne de jormungar chamuscada del suelo cuando haya explotado y llévaselos a Xink.‡Lucha contra un jormungar descomunal al este del Puesto Boquilla Oxidada hasta que abra la boca y lánzale una carga explosiva potente dentro de la garganta. Recoge 6 trozos de carne de jormungar chamuscada del suelo cuando haya explotado y llévaselos a Xink.‡Combattre un Jormungar trapu à l\'est du Poste de Rouilletuyère, jusqu\'à ce qu\'il ouvre grand la gueule, et lui lancer une Charge explosive toute-puissante dans la gorge. Ramasser 6 morceaux de Viande de jormungar calcinée sur le sol après l\'explosion du jormungar et les rapporter à Xink.‡在诺兹拉斯哨站东面与巨大的冰虫作战，直到它张开嘴，然后将高能炸药扔进它的嘴里。爆炸之后，收集6块烧焦的冰虫肉，把它们交给辛克。‡到鏽鼻崗哨的東邊，和一頭笨重的蟄猛巨蟲戰鬥，直到牠張嘴之際，將高效爆破炸藥丟進他的喉嚨裡。當蟲爆炸以後，從地面上收集6片燒焦的蟄猛巨蟲肉帶回去給辛克。',
  }
},
[12050] = {
  {
    'Madeeeira!‡Лесорубы‡Holz hacken‡목재 도둑‡¡Más madera!‡¡Más madera!‡Débitez-les !‡抢木材‡伐木',
    nil,
    'Use o Dispositivo de Controle de Retalhador do Xink para convocar um Retalhador, quando você chegar aos Ninhos das Harpias, ao Norte. Colete 50 montes de Madeira das árvores da área, e então fale novamente com Xink, no Posto Ferrugem.|n|nSe você perder o Dispositivo de Controle de Retalhador, peça outro para Xink, no Posto Ferrugem.‡Используйте пульт управления Крошшером Зинка, чтобы вызвать Крошшер, когда доберетесь до гнездовья гарпий на севере. Соберите 50 связок бревен и возвращайтесь к Зинку в Лагерь Соплозабилось.|n|nЕсли потеряете пульт управления Крошшером Зинка, поговорите с Зинком в Лагере Соплозабилось, чтобы получить новый.‡Ruft mithilfe von Xinks Schreddersteuerung einen Schredder, sobald Ihr das Nistgebiet der Harpyien im Norden erreicht habt. Sammelt 50 Bündel Nutzholz von den Bäumen in der Gegend und kehrt anschließend zu Xink im Düsenrostposten zurück.|n|nWendet Euch an Xink im Düsenrostposten, falls Ihr Xinks Schreddersteuerung verlieren solltet, um eine neue zu erhalten.‡북쪽으로 하피 거주 지역에 가서 싱크의 벌목기 조작 장치를 사용해 싱크의 벌목기를 소환한 다음, 목재 50단을 모아 녹주둥이 전초기지에 있는 싱크에게 돌아가야 합니다.|n|n싱크의 벌목기 조작 장치를 잃어버리면 녹주둥이 전초기지에 있는 싱크와 이야기해 다시 받아야 합니다.‡Utiliza el dispositivo de control de la trituradora de Xink para llamar a una trituradora una vez que llegues a los nidales de las arpías al norte. Reúne 50 montones de madera de los árboles de la zona y luego vuelve junto a Xink en el Puesto Boquilla Oxidada.|n|nSi pierdes el dispositivo de control de la trituradora de Xink, habla con Xink en el Puesto Boquilla Oxidada para que te dé uno nuevo.‡Utiliza el dispositivo de control de la trituradora de Xink para llamar a una trituradora una vez que llegues a los nidales de las arpías al norte. Reúne 50 montones de madera de los árboles de la zona y luego vuelve junto a Xink en el Puesto Boquilla Oxidada.|n|nSi pierdes el dispositivo de control de la trituradora de Xink, habla con Xink en el Puesto Boquilla Oxidada para que te dé uno nuevo.‡Une fois arrivé aux nids des harpies, au nord, utilisez la Télécommande de déchiqueteur de Xink pour faire appel à un déchiqueteur. Rassemblez 50 Tas de bois dans la zone, puis retournez voir Xink au Poste de Rouilletuyère.|n|nSi vous perdez la Télécommande de déchiqueteur de Xink, parlez à Xink au Poste de Rouilletuyère pour en obtenir une nouvelle.‡前往北边的鹰身人巢穴，使用辛克的伐木机控制器召唤出一只伐木机器人。从该区域的树上收集50捆木材，然后把它们交给诺兹拉斯哨站的辛克。|n|n如果你弄丢了辛克的伐木机控制器，就去找诺兹拉斯哨站的辛克再要一个。‡在你抵達北方的鷹身人築巢地之後，使用辛克的伐木機控制裝置召來一台伐木機。從那個地區收集50捆的木材，然後回到鏽鼻崗哨去找辛克。|n|n如果你弄丟了辛克的伐木機控制裝置，去跟鏽鼻崗哨的辛克談話，再要一個新的。',
  }
},
[12051] = {
  {
    'Uma harpia incomoda muita gente‡Выдирание перьев‡Ein paar Federn rascheln lassen‡깃털 스치는 소리‡Machacar algunas plumas‡Machacar algunas plumas‡Volez-leur dans les plumes‡消灭鹰身人‡偷一些羽毛',
    nil,
    'Narf, no Posto Ferrugem, quer que você mate 20 Harpias a Noroeste do Posto Ferrugem.‡По просьбе Нарфа из лагеря Соплозабилось убейте 20 гарпий к северо-западу от Лагеря Соплозабилось.‡Narf im Düsenrostposten möchte, dass Ihr 20 Harpyien nordwestlich des Düsenrostpostens tötet.‡녹주둥이 전초기지의 나르프가 녹주둥이 전초기지 북서쪽에 있는 하피 20명을 처치해 달라고 부탁했습니다.‡Mata a 20 arpías al noroeste del Puesto Boquilla Oxidada para Narf en el Puesto Boquilla Oxidada.‡Mata a 20 arpías al noroeste del Puesto Boquilla Oxidada para Narf en el Puesto Boquilla Oxidada.‡Tuer 20 harpies au nord-ouest du Poste de Rouilletuyère pour Narf.‡前往诺兹拉斯哨站的西北边，为诺兹拉斯哨站的纳尔弗消灭20个鹰身人。‡替鏽鼻崗哨的納孚殺死20名鷹身人，她們就出沒在鏽鼻崗哨的西北邊。',
  }
},
[12052] = {
  {
    'Não passarão, passarinhos!‡Смерть гарпиям!‡Nimm das, Harpyie!‡이거나 먹어라!‡¡Toma arpía!‡¡Toma arpía!‡Remettez-en une couche !‡该死的鹰身人！‡有夠囉唆!',
    nil,
    'Mate a Senhora do Vento Frio e 15 Harpias do Vento Frio nas montanhas a noroeste do Posto Ferrugem. Fale novamente com Narf quando completar a tarefa.|n|nSe precisar do Dispositivo de Controle de Retalhador, peça para Xink no Posto Ferrugem.‡Убейте госпожу Морозной выси и 15 гарпий Морозной выси в горах к северо-западу от лагеря Соплозабилось. Когда задание будет выполнено, возвращайтесь к Нарфу.|n|nЕсли вам понадобится пульт управления крошшером Зинка, обратитесь к Зинку в Лагерь Соплозабилось.‡Tötet die Meisterin des Kaltwinds und 15 Kaltwindharpyien in den Bergen nordwestlich des Düsenrostpostens. Kehrt zu Narf zurück, sobald die Aufgabe erledigt ist.|n|nSprecht mit Xink im Düsenrostposten, falls Ihr seine Schreddersteuerung benötigen solltet.‡녹주둥이 전초기지 북서쪽 산에 있는 눈바람 하피 15명과 눈바람의 여군주를 처치한 후 나르프에게 돌아가야 합니다. |n|n싱크의 벌목기 조작 장치가 필요하면 녹주둥이 전초기지에 있는 싱크와 이야기하십시오.‡Mata a la maestra del Viento Helado y a 15 arpías Viento Helado en las montañas al noroeste del Puesto Boquilla Oxidada. Vuelve con Narf cuando hayas completado esta tarea.|n|nSi necesitas el dispositivo de control de la trituradora de Xink, habla con Xink en el Puesto Boquilla Oxidada.‡Mata a la maestra del Viento Helado y a 15 arpías Viento Helado en las montañas al noroeste del Puesto Boquilla Oxidada. Vuelve con Narf cuando hayas completado esta tarea.|n|nSi necesitas el dispositivo de control de la trituradora de Xink, habla con Xink en el Puesto Boquilla Oxidada.‡Tuez la Maîtresse du Vent-froid et 15 harpies du Vent-froid dans les montagnes au nord-ouest du Poste de Rouilletuyère. Retournez voir Narf une fois cette tâche accomplie.|n|nSi vous avez besoin de la Télécommande de déchiqueteur de Xink, parlez à Xink au Poste de Rouilletuyère.‡前往诺兹拉斯哨站西北方的山地中，杀死冷风女王和15个冷风女巫。完成任务之后向纳尔弗复命。|n|n如果你需要辛克的伐木机控制器，就去找诺兹拉斯哨站的辛克。‡殺死冷風之女及15名冷風鷹身人，他們出沒在鏽鼻崗哨西北邊的山區中。完成之後，向納孚回報。|n|n如果你需要辛克的伐木機控制裝置，與鏽鼻崗哨的辛克談談。',
  }
},
[12053] = {
  {
    'A força da Horda‡Мощь Орды‡Die Macht der Horde‡호드의 힘‡El poder de la Horda‡El poder de la Horda‡La puissance de la Horde‡部落的力量‡部落的力量',
    nil,
    'O Primeiro-Sargento Juktok, no Martelo de Agmar, no Ermo das Serpes, quer que você finque o Estandarte de Batalha do Brado Guerreiro na Aldeia Bruma Boreal, e o defenda dos agressores.|n|nDevolva o Estandarte de Batalha do Brado Guerreiro quando terminar a missão.‡Установите боевой штандарт клана Песни Войны в деревне Ледяной Пыли и защитите его от нападающих.|n|nЗатем верните боевой штандарт клана Песни Войны главному сержанту Юктоку в Молот Агмара на Драконьем Погосте.‡Schlachtrufer Juktok in Agmars Hammer in der Drachenöde möchte, dass Ihr die Schlachtstandarte des Kriegshymnenklans in Eisnebel aufstellt und sie gegen alle Angreifer verteidigt.|n|nBringt die Schlachtstandarte des Kriegshymnenklans wieder zurück, wenn Ihr die Aufgabe abgeschlossen habt.‡아그마르의 망치에 있는 정예수호병 주크토크가 얼음안개 마을에서 전쟁노래부족 전투 깃발을 땅에 꽂은 다음, 공격자들로부터 깃발을 보호해 달라고 부탁했습니다.|n|n임무를 완료하면 전쟁노래부족 전투 깃발을 돌려줘야 합니다.‡El capataz primero Juktok en Martillo de Agmar en el Cementerio de Dragones quiere que utilices el confalón de batalla Grito de Guerra en el Poblado Bruma de Hielo y lo defiendas de sus atacantes.|n|nDevuelve el confalón de batalla Grito de Guerra cuando hayas terminado.‡El capataz primero Juktok en Martillo de Agmar en el Cementerio de Dragones quiere que utilices el confalón de batalla Grito de Guerra en el Poblado Bruma de Hielo y lo defiendas de sus atacantes.|n|nDevuelve el confalón de batalla Grito de Guerra cuando hayas terminado.‡Le Sergent-chef Juktok au Marteau d\'Agmar dans la Désolation des dragons veut que vous utilisiez l\'Étendard de bataille chanteguerre au village de Brume-glace, et que vous le défendiez contre les attaques.|n|nRendez l\'Étendard de bataille chanteguerre lorsque vous aurez terminé.‡阿格玛之锤的军士长祖托克要求你在冰雾村使用战歌军旗，并确保它免遭一切攻击。|n|n完成任务之后，将战歌军旗还给军士长祖托克。‡龍骨荒野上，阿格瑪之錘的資深士官丘科多克需要你在冰霧村中使用戰歌戰旗，護衛它免於攻擊。|n|n事成以後，將戰歌戰旗一併帶回來。',
  }
},
[12054] = {
  {
    'Decifrando o diário‡Расшифровать записи‡Das Tagebuch entschlüsseln‡일지 해독‡Descifrar el diario‡Descifrar el diario‡Déchiffrer le journal‡翻译日记‡日誌解讀',
    nil,
    'Traga um ramo de Halispírito para Sábia Paluna na Aldeia Oneqwah.‡Принесите пучок дыхания духа ведунье Палуне в Лагерь Уанква.‡Bringt der Weisen Paluna in Camp Oneqwah einen Geisteratemzweig.‡원크와 야영지에 있는 현자 팔루나에게 영혼의 숨결 가지 하나를 가져가야 합니다.‡Llévale una ramita de aliento de espíritus a la sabia Paluna en el Campamento Oneqwah.‡Llévale una ramita de aliento de espíritus a la sabia Paluna en el Campamento Oneqwah.‡Apportez un brin de Souffle de l’esprit à la Sage Paluna au Camp Oneqwah.‡将一小株灵息草交给欧尼瓦营地的先知帕鲁纳。‡帶一小截精靈之息給歐尼克瓦營地的賢者帕努納。',
  }
},
[12055] = {
  {
    'Um dispositivo estranho‡Странное приспособление‡Ein seltsames Gerät‡이상한 장치‡Un extraño aparato‡Un extraño aparato‡Un appareil étrange‡奇怪的设备‡奇怪的裝置',
    nil,
    'Entregue o Dispositivo Estranho de Goramosh para a Imagem da Arquimaga Modera no Recanto das Estrelas.‡Отнесите странное устройство Горамоша проекции верховного мага Модеры в Покой Звезд.‡Bringt Goramoshs seltsames Gerät zum Abbild der Erzmagierin Modera in Sternenruh.‡고라모쉬의 이상한 장치를 별의 쉼터에 있는 대마법사 모데라의 환영에게 전달해야 합니다.‡Lleva el extraño dispositivo de Goramosh a la imagen de la archimaga Modera en Reposo Estelar.‡Lleva el extraño dispositivo de Goramosh a la imagen de la archimaga Modera en Reposo Estelar.‡Apportez l\'Étrange mécanisme de Goramosh à l\'Image de l\'archimage Modera au Repos des étoiles.‡将古拉莫什的奇怪设备带回群星之墓，交给大法师茉德拉的影像。‡把戈拉莫什的奇怪裝置交給繁星之眠的大法師莫德菈的影像。',
  }
},
[12056] = {
  {
    'Marcado para Morrer: Grão-sectário Zangus‡Приговорен к смерти: верховный сектант Зангус‡Zum Tode verurteilt: Hochkultist Zangus‡죽음의 표적: 고위 이교도 장구스‡Marcado para morir: Sumo cultor Zangus‡Marcado para morir: Sumo cultor Zangus‡Condamné à mort : le haut-sectateur Zangus‡死亡名单：高阶教徒扎古斯‡死亡標記:高階教徒贊古司',
    nil,
    'Mate o Grão-sectário Zangus e leve a Cabeça do Grão-sectário Zangus para o Capitão Gort no Martelo de Agmar, que fica no Ermo das Serpes.‡Убейте верховного сектанта Зангуса и отнесите его голову капитану Горту в Молот Агмара на Драконьем Погосте.‡Tötet Hochkultist Zangus und bringt den Kopf des Hochkultisten Zangus zu Hauptmann Gort in Agmars Hammer in der Drachenöde.‡고위 이교도 장구스를 처치한 다음 고위 이교도 장구스의 머리카락를 용의 안식처의 아그마르 망치에 있는 경비대장 고르트에게 가져가야 합니다.‡Mata al Sumo cultor Zangus y lleva la cabeza del Sumo cultor Zangus al capitán Gort en el Martillo de Agmar en el Cementerio de Dragones.‡Mata al Sumo cultor Zangus y lleva la cabeza del Sumo cultor Zangus al capitán Gort en el Martillo de Agmar en el Cementerio de Dragones.‡Tuez le haut-sectateur Zangus, puis remettez la Tête du haut-sectateur Zangus au Capitaine Gort, du Marteau d’Agmar dans la Désolation des dragons.‡杀死高阶教徒扎古斯，并将高阶教徒扎古斯的徽记带回龙骨荒野的阿格玛之锤，交给高尔特上尉。‡殺掉高階教徒贊古司，並將他的頭交給苟爾特隊長。他就在龍骨荒野上的阿格瑪之錘裡。',
  }
},
[12057] = {
  {
    'O tomo encadernado com carne‡Сшитый плотью фолиант‡Der fleischgebundene Foliant‡살점달린 고서‡El escrito encuadernado en carne‡El escrito encuadernado en carne‡Le tome relié de chair‡血之魔典‡鑲肉骨書',
    nil,
    'Leve o Tomo Encadernado com Carne para o Capitão Gort, no Martelo de Agmar.‡Доставьте сшитый плотью фолиант капитану Горту в Молот Агмара.‡Bringt Hauptmann Gort in Agmars Hammer den fleischgebundenen Folianten.‡살점달린 고서를 아그마르의 망치에 있는 경비대장 고르트에게 가져가야 합니다.‡Devuelve el escrito encuadernado en carne al capitán Gort del Martillo de Agmar.‡Devuelve el escrito encuadernado en carne al capitán Gort del Martillo de Agmar.‡Remettez le Tome relié de chair au Capitaine Gort au Marteau d’Agmar.‡将血之魔典交给阿格玛之锤的高尔特上尉。‡將鑲肉骨書交到阿格瑪之錘的苟爾特隊長手上。',
  }
},
[12058] = {
  {
    'As profecias rúnicas‡Рунические пророчества‡Prophezeiungen der Runen‡룬의 예언‡Las profecías rúnicas‡Las profecías rúnicas‡Les prophéties runiques‡符文中的预言‡符文預言',
    nil,
    'A Sábia Paluna, na Aldeia Oneqwah, quer que você decifre as três Placas Rúnicas.‡Ведунья Палуна из Лагеря Уанква просит вас перевести надписи на трех Рунических дисках.‡Die Weise Paluna im Camp Oneqwah möchte, dass Ihr die drei Runenplatten entziffert.‡원크와 야영지에 있는 현자 팔루나가 룬문자 판 3개를 해독해 달라고 부탁했습니다.‡La sabia Paluna en el Campamento Oneqwah quiere que descifres las tres placas rúnicas.‡La sabia Paluna en el Campamento Oneqwah quiere que descifres las tres placas rúnicas.‡La Sage Paluna, au Camp Oneqwah, veut que vous déchiffriez les trois Plaques runiques.‡欧尼瓦营地的先知帕鲁纳要求你解读出三块符文板上的文字。‡歐尼克瓦營地的賢者帕努納需要你解讀這三塊符文板。',
  }
},
[12059] = {
  {
    'Um dispositivo estranho‡Странное приспособление‡Ein seltsames Gerät‡이상한 장치‡Un extraño aparato‡Un extraño aparato‡Un appareil étrange‡奇怪的设备‡奇怪的裝置',
    nil,
    'Entregue o Dispositivo Estranho de Goramosh para a Imagem do Arquimago Aethas Fendessol no Martelo de Agmar.‡Отнесите странное устройство Горамоша проекции верховного мага Этаса Похитителю Солнца в Молот Агмара.‡Bringt Goramoshs seltsames Gerät zum Abbild des Erzmagiers Aethas Sonnenhäscher.‡고라모쉬의 이상한 장치를 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 전달해야 합니다.‡Lleva el extraño dispositivo de Goramosh a la imagen del archimago Aethas Atracasol a Martillo de Agmar.‡Lleva el extraño dispositivo de Goramosh a la imagen del archimago Aethas Atracasol a Martillo de Agmar.‡Apportez l\'Appareil étrange de Goramosh à l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡将古拉莫什的奇怪设备带回阿格玛之锤，交给大法师艾萨斯·夺日者的影像。‡把戈拉莫什的奇怪裝置交給阿格瑪之錘的大法師埃薩·奪日者的影像。',
  }
},
[12060] = {
  {
    'Projeções e planos‡Проекты и проекции‡Projektionen und Pläne‡투영과 계획‡Proyecciones y planos‡Proyecciones y planos‡Projections et projets‡投影和计划‡投影與計畫',
    nil,
    'Aproxime-se da Agulha de Mana flutuando acima dos Jardins Lua Serena e observe a projeção.|n|nEntão, relate o que descobrir para a Imagem da Arquimaga Modera, no Recanto das Estrelas.‡Подберитесь поближе и обследуйте конструкцию на вершине волнолова, плавающего в воздухе над Садами Лунного Покоя.|n|nПосле этого возвращайтесь с полученной информацией к проекции верховного мага Модеры в Покой Звезд.‡Geht zur Projektion auf der Sognadel über den Mondruhgärten, um sie zu untersuchen.|n|nKehrt anschließend mit den Informationen zum Abbild der Erzmagierin Modera in Sternenruh zurück.‡달쉼터 정원 공중에 있는 폭풍 바늘로 이동해, 투영된 영상을 조사해야 합니다.|n|n정보를 얻어 별의 쉼터에 있는 대마법사 모데라의 환영에게 돌아가십시오.‡Acércate y observa la proyección en la cumbre de la Aguja de Flujo que hay flotando sobre los Jardines Reposo Lunar.|n|nLuego vuelve hasta la imagen de la archimaga Modera en Reposo Estelar con la información.‡Acércate y observa la proyección en la cumbre de la Aguja de Flujo que hay flotando sobre los Jardines Reposo Lunar.|n|nLuego vuelve hasta la imagen de la archimaga Modera en Reposo Estelar con la información.‡Rapprochez-vous pour observer la projection sur le capteur tellurique qui flotte au-dessus des jardins de Repos-de-Lune.|n|nRetournez ensuite voir l\'Image de l\'archimage Modera au Repos des étoiles pour lui communiquer les informations dont vous disposez.‡靠近并观察漂浮在眠月花园上空的湍流之针上的物品。|n|n完成任务后返回群星之墓，向大法师茉德拉的影像汇报你的发现。‡靠近並觀察月眠花園上空極濤磁針裡的投影。|n|n帶著情報，回到繁星之眠的大法師莫德菈的影像身邊。',
  }
},
[12061] = {
  {
    'Projeções e planos‡Проекты и проекции‡Projektionen und Pläne‡투영과 계획‡Proyecciones y planos‡Proyecciones y planos‡Projections et projets‡投影和计划‡投影與計畫',
    nil,
    'Aproxime-se da Agulha de Mana flutuando acima dos Jardins Lua Serena e observe a projeção.|n|nEntão relate o que descobrir para a Imagem do Arquimago Aethas Fendessol, no Martelo de Agmar.‡Подберитесь поближе и обследуйте конструкцию на вершине волнолова, плавающего в воздухе над Садами Лунного Покоя.|n|nПосле этого возвращайтесь с полученной информацией к проекции верховного мага Этаса Похитителя Солнца в Молот Агмара‡Geht zur Projektion auf der Sognadel über den Mondruhgärten, um sie zu untersuchen.|n|nKehrt anschließend mit den Informationen zum Abbild des Erzmagiers Aethas Sonnenhäscher in Agmars Hammer zurück.‡달쉼터 정원 공중에 있는 폭풍 바늘로 이동해, 투영된 영상을 조사해야 합니다.|n|n정보를 얻어 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 돌아가십시오.‡Acércate y observa la proyección en la cumbre de la Aguja de Flujo que hay flotando sobre los Jardines Reposo Lunar.|n|nLuego vuelve hasta la imagen del archimago Aethas Atracasol en Martillo de Agmar con la información.‡Acércate y observa la proyección en la cumbre de la Aguja de Flujo que hay flotando sobre los Jardines Reposo Lunar.|n|nLuego vuelve hasta la imagen del archimago Aethas Atracasol en Martillo de Agmar con la información.‡Observez la projection sur le capteur tellurique qui flotte au-dessus des jardins de Repos-de-Lune.|n|nRetournez ensuite voir l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar pour partager avec lui les informations dont vous disposez.‡靠近并观察漂浮在眠月花园上空的湍流之针上的物品。|n|n完成任务后返回阿格玛之锤，向大法师艾萨斯·夺日者的影像汇报你的发现。‡靠近並觀察月眠花園上空極濤磁針裡的投影。|n|n帶著情報，向阿格瑪之錘的大法師埃薩·奪日者的影像回報。',
  }
},
[12062] = {
  {
    'Insulte Coren Cervatroz‡Оскорбить Корена Худовара‡Beleidigt Coren Düsterbräu‡코렌 다이어브루와의 싸움‡Insulta a Coren Cerveza Temible‡Insulta a Coren Cerveza Temible‡Insulter Coren Navrebière‡侮辱科林·烈酒‡羞辱寇仁·恐酒',
    nil,
    'Fale com Coren Cervatroz.‡Поговорите с Кореном Худоваром.‡Geht und fangt Streit mit Coren Düsterbräu an.‡코렌 다이어브루와 대화해야 합니다.‡Habla con Coren Cerveza Temible.‡Habla con Coren Cerveza Temible.‡Parlez à Coren Navrebière.‡与科林·烈酒谈一谈。‡與寇仁·恐酒交談。',
  }
},
[12063] = {
  {
    'O poder da Bruma Boreal‡Сила Ледяной Пыли‡Eisnebels Stärke‡아이스미스트의 힘‡Fuerza de Bruma de Hielo‡Fuerza de Bruma de Hielo‡La force de Brume-glace‡冰雾的力量‡冰霧的力量',
    nil,
    'Encontre Banthok Bruma Boreal, na Aldeia Bruma Boreal.‡Найдите Бантока Ледяную Пыль в окрестностях деревни Ледяной Пыли.‡Sucht in Eisnebel nach Banthok Eisnebel.‡얼음안개 마을에서 반토크 아이스미스트를 찾아야 합니다.‡Encuentra a Banthok Bruma de Hielo en el Poblado Bruma de Hielo.‡Encuentra a Banthok Bruma de Hielo en el Poblado Bruma de Hielo.‡Trouvez Banthok Brume-glace au village de Brume-glace.‡在冰雾村内找到班索克·冰雾。‡在冰霧村尋找班索克·冰霧。',
  }
},
[12064] = {
  {
    'Correntes dos Anub\'ar‡Ануб\'арские оковы‡Ketten der Anub\'ar‡아눕아르의 사슬‡Las cadenas de los Anub\'ar‡Las cadenas de los Anub\'ar‡Les chaînes des Anub\'ar‡阿努巴尔的束缚‡阿努巴之鏈',
    nil,
    'Banthok Bruma Boreal, na Aldeia Bruma Boreal, que fica no Ermo das Serpes, quer que você leve para ele a Parte da Chave de Anok\'ra, a Parte da Chave de Tivax e a Parte da Chave de Sinok.‡Принесите Бантоку Ледяной Пыли, ожидающему у деревни Ледяной Пыли на Драконьем Погосте, фрагмент ключа Анок\'ры, фрагмент ключа Тивакса и фрагмент ключа Синока.‡Banthok Eisnebel in Eisnebel in der Drachenöde möchte, dass Ihr ihm Anok\'ras Schlüsselfragment, Tivax\' Schlüsselfragment und Sinoks Schlüsselfragment beschafft.‡용의 안식처의 얼음안개 마을에 있는 반토크 아이스미스트가 아녹라의 열쇠 조각, 티바스의 열쇠 조각, 시노크의 열쇠 조각을 가져와 달라고 부탁했습니다.‡Banthok Bruma de Hielo en el Poblado Bruma de Hielo en el Cementerio de Dragones te ha pedido que le traigas el fragmento de la llave de Anok\'ra, el fragmento de la llave de Tivax y el fragmento de la llave de Sinok.|n‡Banthok Bruma de Hielo en el Poblado Bruma de Hielo en el Cementerio de Dragones te ha pedido que le traigas el fragmento de la llave de Anok\'ra, el fragmento de la llave de Tivax y el fragmento de la llave de Sinok.|n‡Banthok Brume-glace, du village de Brume-glace de la Désolation des dragons, veut que vous lui rapportiez le Fragment de la clé d’Anok’ra, le Fragment de la clé de Tivax et le Fragment de la clé de Sinok.‡冰雾村的班索克·冰雾要求你将安诺科拉的钥匙碎片、提瓦克斯的钥匙碎片和西诺克的钥匙碎片交给他。‡班索克·冰霧要求你把阿諾克拉之鑰碎片、提法科斯之鑰碎片和席諾克之鑰碎片帶給他。他就在龍骨荒野上的冰霧村中。',
  }
},
[12065] = {
  {
    'O foco na praia‡Фокусы на взморье‡Der Fokus am Strand‡해변의 집중점‡El foco de la playa‡El foco de la playa‡Le focalisateur sur la plage‡海岸上的魔法焦点‡海灘上的節點',
    nil,
    'Obtenha o Anel de Controle do Foco da Linha do Meridiano e use-o para conseguir informações do Foco da Linha do Meridiano na Praia Reluzente.|n|nEntão, fale novamente com a Imagem da Arquimaga Modera no Recanto das Estrelas.‡Добудьте кольцо управления средоточием силовых линий и воспользуйтесь им для получения информации о средоточии силовых линий на Сверкающем взморье.|n|nЗатем вернитесь к проекции верховного мага Модеры в Покое Звезд.‡Beschafft Euch den Steuerungsring des Leylinienfokus und verwendet ihn, um Informationen vom Leylinienfokus am Glimmerstrand zu erhalten.|n|nKehrt anschließend zum Abbild der Erzmagierin Modera in Sternenruh zurück.‡지맥 집중점 제어 반지를 얻어 반짝이는 해안의 지맥 집중점 정보를 수집해야 합니다.|n|n그런 다음 별의 쉼터에 있는 대마법사 모데라의 환영에게 돌아가야 합니다.‡Consigue el anillo de control de foco de línea Ley y úsalo para conseguir información del foco de línea Ley en la Orilla Resplandeciente.|n|nLuego, vuelve con la imagen de la archimaga Modera en Reposo Estelar.‡Consigue el anillo de control de foco de línea Ley y úsalo para conseguir información del foco de línea Ley en la Orilla Resplandeciente.|n|nLuego, vuelve con la imagen de la archimaga Modera en Reposo Estelar.‡Procurez-vous l\'Anneau de contrôle des lignes telluriques et utilisez-le pour obtenir des informations sur le Focalisateur de lignes telluriques de la Grève Lumineuse.|n|nRetournez ensuite auprès de l\'Image de l\'archimage Modera au Repos des étoiles.‡夺取魔网能量焦点控制指环，用它从灿烂海岸的魔网能量线焦点中获取信息。|n|n然后返回群星之墓，向大法师茉德拉的影像复命。‡取得地脈節點控制戒指並且對閃耀水岸的地脈節點使用，以獲得更多的訊息。|n|n然後回去找大法師莫德菈的影像，他就在繁星之眠中。',
  }
},
[12066] = {
  {
    'O foco na praia‡Фокусы на взморье‡Der Fokus am Strand‡해변의 집중점‡El foco de la playa‡El foco de la playa‡Le focalisateur sur la plage‡海岸上的魔法焦点‡海灘上的節點',
    nil,
    'Obtenha o Anel de Controle do Foco da Linha do Meridiano e use-o para conseguir informações do Foco da Linha do Meridiano na Praia Reluzente.|n|nEntão, fale novamente com a Imagem do Arquimago Aethas Fendessol no Martelo de Agmar.‡Добудьте кольцо управления средоточием силовых линий и воспользуйтесь им для получения информации о средоточии силовых линий на Сверкающем взморье.|n|nЗатем вернитесь к проекции верховного мага Этаса Похитителя Солнца в Молот Агмара.‡Beschafft Euch den Steuerungsring des Leylinienfokus und verwendet ihn, um Informationen vom Leylinienfokus am Glimmerstrand zu erhalten.|n|nKehrt anschließend zum Abbild des Erzmagiers Aethas Sonnenhäscher bei Agmars Hammer zurück.‡지맥 집중점 제어 반지를 얻어 반짝이는 해안의 지맥 집중점 정보를 수집해야 합니다.|n|n그런 다음 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 돌아가야 합니다.‡Consigue el anillo de control de foco de línea Ley y úsalo para conseguir información del foco de línea Ley en la Orilla Resplandeciente.|n|nLuego, vuelve con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Consigue el anillo de control de foco de línea Ley y úsalo para conseguir información del foco de línea Ley en la Orilla Resplandeciente.|n|nLuego, vuelve con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Procurez-vous l\'Anneau de contrôle des lignes telluriques et utilisez-le pour obtenir des informations sur le Focalisateur de lignes telluriques de la Grève Lumineuse.|n|nRetournez ensuite auprès de l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡夺取魔网能量焦点控制指环，用它从灿烂海岸的魔网能量线焦点中获取信息。|n|n然后返回阿格玛之锤，向大法师艾萨斯·夺日者的影像复命。‡取得地脈節點控制戒指並且對閃耀水岸的地脈節點使用，以獲得更多的訊息。|n|n然後回去阿格瑪之錘找大法師埃薩·奪日者的影像。',
  }
},
[12067] = {
  {
    'Uma carta para casa‡Письмо домой‡Ein Brief an Zuhause‡집으로 보내는 편지‡Una carta para casa‡Una carta para casa‡Une lettre pour la maison‡一封家书‡一封家書',
    nil,
    'Entregue a Carta da Capitão Malin para a Comandante Saia Azulaço, no Recanto das Estrelas.‡Доставьте письмо капитана Малин командиру Сайе Лазурной Стали в Покой Звезд.‡Liefert Hauptmann Malins Brief bei Kommandantin Saia Azurstahl in Sternenruh ab.‡부대장 말린의 편지를 별의 쉼터에 있는 사령관 사이아 아주어스틸에게 전달해야 합니다.‡Lleva la carta de la capitana Malin a la comandante Saia Aceroazur a Reposo Estelar.‡Lleva la carta de la capitana Malin a la comandante Saia Aceroazur a Reposo Estelar.‡Apportez la Lettre du capitaine Malin au Commandant Saia Azuracier au Repos des étoiles.‡将艾米·马林的信交给群星之墓的指挥官塞雅·蓝钢。‡把馬林隊長的信帶給繁星之眠的指揮官賽雅·蒼鋼。',
  }
},
[12068] = {
  {
    'Pergunte ao pó‡Голоса прошлого‡Stimmen aus dem Staub‡먼지의 목소리‡Voces entre las ruinas‡Voces entre las ruinas‡Les voix de la poussière‡灰尘之声‡自塵土而來的聲音',
    nil,
    'Drakuru quer que você colete as Tabuletas Drakkari das Ruínas de Drakil\'jin, e 5 Mojos Sagrados dos Oráculos Drakkari e Protetores Drakkari da região. Em seguida, use o Elixir de Drakuru no Braseiro de Drakuru nas ruínas para evocar a imagem dele.‡Дракуру просит вас собрать скрижали Драккари в Руинах Дракил\'джин и отобрать 5 священных настоев у оракулов и заступников Драккари. Затем вам надо будет выпить эликсир Дракуру возле жаровни в руинах, чтобы призвать его дух.‡Drakuru möchte, dass Ihr in die Ruinen von Drakil\'jin geht, dort die Tafeln der Drakkari sammelt und 5 Einheiten heiliges Mojo von den Orakeln und Beschützern der Drakkari sammelt. Geht danach zu Drakurus Kohlenbecken in den Ruinen, benutzt Drakurus Elixier und ruft sein Abbild herbei.‡드락진 폐허에서 드라카리 현자와 드라카리 수호병으로부터 드라카리 서판과 신성한 모조 5개를 모은 후, 드라쿠루의 화로에서 드라쿠루의 비약을 사용해 그의 환영을 소환해야 합니다.‡Drakuru quiere que reúnas las tablillas Drakkari de las Ruinas de Drakil\'jin y 5 muestras de mojo sacro de los oráculos y protectores Drakkari. Después tendrás que utilizar el elixir de Drakuru en el pedestal de Drakuru en las ruinas para invocar su imagen.‡Drakuru quiere que reúnas las tablillas Drakkari de las Ruinas de Drakil\'jin y 5 muestras de mojo sacro de los oráculos y protectores Drakkari. Después tendrás que utilizar el elixir de Drakuru en el pedestal de Drakuru en las ruinas para invocar su imagen.‡Drakuru veut que vous récupériez les Tablettes drakkari dans les Ruines de Drakil’jin et 5 Mojos sacrés sur des Oracles et des Protecteurs drakkari. Ensuite, vous devrez utiliser l’Elixir de Drakuru sur son Brasero dans les ruines pour invoquer son image.‡达库鲁希望你在达基尔金废墟中找到达卡莱石板，并从达卡莱先知和达卡莱保卫者身上收集5份神圣魔精。然后在废墟中达库鲁的火盆上使用达库鲁的药剂，召唤出他的影像。‡德拉庫魯要你從德拉齊金遺跡中，找到德拉克瑞銘碑，並且從德拉克瑞神諭者和保衛者身上取得5個神聖魔精。然後在遺跡的德拉庫魯的火盆使用德拉庫魯藥劑召喚他的影像。',
  }
},
[12069] = {
  {
    'O retorno do Chefe Supremo‡Возвращение верховного вождя‡Die Rückkehr des Oberhäuptlings‡대족장의 귀환‡El regreso del Gran Jefe‡El regreso del Gran Jefe‡Le retour du grand chef‡大酋长归来‡向大酋長回報',
    nil,
    'Liberte o Chefe Supremo Bruma Boreal usando a Chave da Prisão Anub\'ar e ajude-o a derrotar o Baixo-Rei Anub\'et\'kan.|n|nLeve um Fragmento da Casca de Anub\'et\'kan para o Lorde Supremo Agmar, no Martelo de Agmar, que fica no Ermo das Serpes.‡Освободите верховного вождя Ледяную Пыль с помощью ключа от ануб\'арской темницы и помогите ему одолеть короля подземелий Ануб\'ет\'кана.|n|nДобудьте кусок панциря Ануб\'ет\'кана и вернитесь с ним к командиру Агмару в Молоте Агмара в Драконьем Погосте.‡Befreit Oberanführer Eisnebel mit dem Gefängnisschlüssel von Anub\'ar und helft ihm dabei, Unterkönig Anub\'et\'kan zu besiegen.|n|nNehmt Euch ein Bruchstück aus Anub\'et\'kans Panzer und bringt es zurück zu Oberanführer Agmar in Agmars Hammer in der Drachenöde.‡아눕아르 감옥 열쇠를 사용해 대족장 아이스미스트를 풀어주고 그를 도와 악마왕 아눕에칸을 처치해야 합니다.|n|n아눕에칸의 껍질 조각을 입수하여 용의 안식처의 아그마르의 망치에 있는 대군주 아그마르에게 가져가야 합니다.‡Libera al gran jefe Bruma de Hielo utilizando la llave de la prisión Anub\'ar y ayúdale a derrotar al infrarrey Anub\'et\'kan.|n|nRecupera un fragmento del caparazón de Anub\'et\'kan y devuélveselo al señor supremo Agmar en Martillo de Agmar en el Cementerio de Dragones.‡Libera al gran jefe Bruma de Hielo utilizando la llave de la prisión Anub\'ar y ayúdale a derrotar al infrarrey Anub\'et\'kan.|n|nRecupera un fragmento del caparazón de Anub\'et\'kan y devuélveselo al señor supremo Agmar en Martillo de Agmar en el Cementerio de Dragones.‡Libérez le Grand chef Brume-glace à l’aide de la Clé de la prison anub’ar, puis aidez-le à vaincre le Roi-d’en-bas Anub’et’kan.|n|nRécupérez un Fragment de la carapace d’Anub’et’kan et présentez-le au Suzerain Agmar, au Marteau d’Agmar de la Désolation des dragons.‡使用阿努巴尔牢笼钥匙放出冰雾部族的大酋长，并协助他击败虫王阿努布耶坎。|n|n取回一片阿努布耶坎的外壳碎片，把它带回龙骨荒野的阿格玛之锤，交给阿格玛大王。‡用阿努巴監獄鑰匙釋放大酋長冰霧，並且幫助他擊敗幽暗蟲王阿努貝坎。|n|n拾起一塊阿努貝坎之殼的碎片，交給阿格瑪霸主。他就在龍骨荒野上的阿格瑪之錘裡。',
  }
},
[12070] = {
  {
    'Incentivo às tropas‡Второе дыхание‡Neue Kraft für die Truppen‡병력 모으기‡Alentando a las tropas‡Alentando a las tropas‡Rallier les troupes‡鼓舞士气‡重整部隊',
    nil,
    'Use o Estilhaço da Terra para incentivar os Gigantes da Serra Gris lutando nos Montes dos Penedos, mate quaisquer anões de ferro que se opuserem, e então apresente-se a Karun no morro acima de Thor Modan.‡Воспользуйтесь осколком земли, чтобы излечить великанов с Седых холмов, сражающихся в Каменистых холмах, убейте всех железных дворфов, что осмелятся встать у вас на пути, и вернитесь к Куруну на холм, возвышающийся над Тор Моданом.‡Benutzt den Splitter der Erde, um den Grizzlyhügelriesen, die in den Felshügeln kämpfen, neue Kraft einzuflößen. Tötet alle Eisenzwerge, die sich Euch widersetzen, und erstattet dann Kurun auf dem Hügel, der Thor Modan überblickt, Bericht.‡대지의 파편을 사용해 바위 언덕에서 싸우는 회색 구릉지 거인의 기운을 북돋아주어야 합니다. 방해하는 무쇠 드워프는 모두 제거한 다음 토르 모단이 내려다보이는 언덕에 있는 쿠룬에게 보고해야 합니다.‡Utiliza el fragmento de la Tierra para alentar a los gigantes de las Colinas Pardas que luchan en las Colinas Pedrusco, mata a cualquier enano férreo que se enfrente a ti y luego ve a informar a Kurun a la colina que da a Thor Modan.‡Utiliza el fragmento de la Tierra para alentar a los gigantes de las Colinas Pardas que luchan en las Colinas Pedrusco, mata a cualquier enano férreo que se enfrente a ti y luego ve a informar a Kurun a la colina que da a Thor Modan.‡Utilisez l’Éclat de la terre pour rallier les Géants des Grisonnes qui se battent dans les Collines du Rocher, tuez tous les nains de fer qui s’opposent à vous, puis allez faire votre rapport à Kurun, sur la colline qui domine Thor Modan.‡使用大地碎片鼓舞巨石丘陵的灰熊丘陵巨人，杀死所有与你交战的铁矮人，然后回到俯瞰索尔莫丹的丘陵地带，向库伦复命。‡在巨礫之丘的戰鬥中使用大地裂片來重整灰白之丘巨人，殺死阻礙你的鐵矮人，然後向庫倫回報，他就在可以俯瞰鐸爾莫丹的山丘上。',
  }
},
[12071] = {
  {
    'Ataque aéreo!‡Ударим с воздуха!‡Angriff aus der Luft!‡공습!‡¡Ataque aéreo!‡¡Ataque aéreo!‡Attaque aérienne !‡空中打击！‡空襲!',
    nil,
    'Apresente-se ao Furivento Valnok no Martelo de Agmar.‡Поговорите с Вальноком Ветрояром в Молоте Агмара.‡Sprecht mit Valnok Windzürner in Agmars Hammer.‡아그마르의 망치에 있는 발노크 윈드레이저와 대화해야 합니다.‡Habla con Valnok Furia del Viento en el Martillo de Agmar.‡Habla con Valnok Furia del Viento en el Martillo de Agmar.‡Parlez à Valnok Ragevent au Marteau d\'Agmar.‡与阿格玛之锤的瓦诺克·风怒谈一谈。‡和阿格瑪之錘的沃爾諾克·風怒者交談。',
  }
},
[12072] = {
  {
    'Pro inferno com as mangraferas!‡Будь прокляты эти чумные звери!‡Verdammt sollen die Seuchenbestien sein!‡파멸충 박멸!‡¡Malditas bestias de añublo!‡¡Malditas bestias de añublo!‡Que les bêtes-chancreuses soient damnées !‡该死的荒芜兽！‡荒獸死定了!',
    nil,
    'Use a Pistola Sinalizadora de Valnok para chamar uma Mantícora de Batalha Kor\'kron, na Aldeia Bruma Boreal. Monte na Mantícora de Batalha Kor\'kron e use-a para matar 25 Mangraferas Anub\'ar!|n|nFale novamente com Furivento Valnok, no Martelo de Agmar, ao completar a missão.‡С помощью сигнального ружья Вальнока вызовите в деревню Ледяной Пыли кор\'кронскую боевую виверну. Воспользовавшись ею, убейте 25 ануб\'арских гнилостных зверей!|n|nЕсли выполните задание, возвращайтесь к Вальноку Ветрояру в Молот Агмара.‡Geht nach Eisnebel, benutzt Valnoks Leuchtpistole, um einen Kriegsreiter der Kor\'kron zu rufen, setzt auf und tötet mit seiner Hilfe 25 Seuchenbestien der Anub\'ar!|n|nKehrt anschließend wieder zu Valnok Windzürner in Agmars Hammer zurück, sobald Ihr diese Mission erfüllt habt.‡얼음안개 마을에서 발노크의 신호용 권총을 사용해 코르크론 전투와이번을 소환하여 올라탄 다음 아눕아르 파멸충 25마리를 처치해야 합니다!|n|n임무를 마친 다음에는 아그마르의 망치에 있는 발노크 윈드레이저에게 돌아가야 합니다.‡Usa la pistola de bengalas de Valnok para llamar a un jinete de guerra Kor\'kron en el Poblado Bruma de Hielo. Monta sobre el jinete de guerra Kor\'kron y úsalo para matar a 25 bestias de añublo Anub\'ar.|n|nSi completas esta misión, vuelve junto a Valnok Furia del Viento en el Martillo de Agmar.‡Usa la pistola de bengalas de Valnok para llamar a un jinete de guerra Kor\'kron en el Poblado Bruma de Hielo. Monta sobre el jinete de guerra Kor\'kron y úsalo para matar a 25 bestias de añublo Anub\'ar.|n|nSi completas esta misión, vuelve junto a Valnok Furia del Viento en el Martillo de Agmar.‡Utilisez le Lance-fusée de Valnok pour appeler un Chevaucheur de guerre kor\'kron. Montez sur son dos et utilisez-le pour tuer 25 Bêtes-chancreuses anub\'ar !|n|nRetournez voir Valnok Ragevent au Marteau d\'Agmar si vous réussissez cette mission.‡在冰雾村内使用瓦诺克的信号枪呼叫一只库卡隆作战双足飞龙，骑坐它杀死25只阿努巴尔荒芜兽！|n|n完成任务后返回阿格玛之锤向瓦诺克·风怒复命。‡在冰霧村中使用沃爾諾克的信號槍以呼喚柯爾克隆戰鬥坐騎。騎乘柯爾克隆戰鬥坐騎殺死25頭阿努巴荒獸!|n|n任務完成後回去阿格瑪之錘找沃爾諾克·風怒者。',
  }
},
[12073] = {
  {
    'Marretando o ferro‡Куй железо, пока горячо‡Das Eisen bearbeiten‡허점 공략‡Golpear el hierro‡Golpear el hierro‡Il faut battre le fer…‡“钢铁之子”‡重擊鐵矮人',
    nil,
    'Mate 10 Anões de Ferro de qualquer tipo que estiverem defendendo Thor Modan e, depois, apresente-se ao Batedor Vor\'takh na Aldeia Oneqwah.‡Убейте 10 любых железных дворфов, охраняющих Тор Модан, после чего доложите разведчику Вор\'такху из Лагеря Уанква об успешном выполнении его поручения.‡Tötet 10 beliebige Eisenzwerge in Thor Modan und kehrt dann zu Späher Vor\'takh im Camp Oneqwah zurück.‡토르 모단을 지키는 무쇠 드워프 10명을 처치한 다음 원크와 야영지에 있는 척후병 보르타크에게 돌아가야 합니다.‡Mata a 10 enanos férreos que defienden Thor Modan y vuelve al Campamento Oneqwah para informar al explorador Vor\'takh.‡Mata a 10 enanos férreos que defienden Thor Modan y vuelve al Campamento Oneqwah para informar al explorador Vor\'takh.‡Tuez 10 nains de fer de n’importe quel type parmi les défenseurs de Thor Modan, puis allez faire votre rapport à l’Éclaireur Vor\'takh au Camp Oneqwah.‡杀死10名守卫索尔莫丹的铁矮人，然后向欧尼瓦营地的斥候沃塔肯复命。‡殺死任意10位防衛鐸爾莫丹的鐵矮人，並且向歐尼克瓦營地的斥候沃塔克回報。',
  }
},
[12074] = {
  {
    'Um aliado oportuno‡Удобный союзник‡Ein nützlicher Verbündeter‡정략적 동맹‡Un aliado muy oportuno‡Un aliado muy oportuno‡Un allié de circonstance‡新的盟友‡權衡之下的盟友',
    nil,
    'Fale com Karun no morro sobre Thor Modan.‡Поговорите с Куруном, который стоит на вершине холма рядом с Тор Моданом.‡Sprecht mit Kurun auf dem Hügel, der Thor Modan überblickt.‡토르 모단이 내려다보이는 언덕에서 쿠룬과 대화해야 합니다.‡Habla con Kurun en la colina que da a Thor Modan.‡Habla con Kurun en la colina que da a Thor Modan.‡Parlez à Kurun sur la colline qui domine Thor Modan.‡前往俯瞰索尔莫丹的丘陵地带，在那里找到库伦。‡和山丘上俯瞰整座鐸爾莫丹的庫倫交談。',
  }
},
[12075] = {
  {
    'Amostras de morte‡Образец каменной плоти‡Mageres Angebot‡견본 채취‡Pocos restos‡Pocos restos‡La portion congrue‡采集样本‡精挑細選',
    nil,
    'Colete uma amostra de carne pétrea do cadáver do Gigante do Gelo na entrada da caverna na Fenda Cristalina, ao norte de onde Zort está. Quando completar essa tarefa, volte a falar com Zort perto do centro do desfiladeiro.‡Возьмите образец каменной плоти с тела ледяного великана у входа в пещеру в ущелье Порочных Кристаллов, к северу от места, где стоит Зорт. Выполнив это задание, вернитесь к Зорту, ожидающему вас у центра каньона.‡Beschafft eine Steinfleischprobe von der Eisriesenleiche am Höhleneingang nördlich von Zort in der Kristallschlucht und kehrt wieder zu ihm zurück, sobald die Aufgabe abgeschlossen ist. Er befindet sich in der Nähe des Zentrums der Schlucht.‡수정 계곡에서 조르트가 있는 곳 북쪽으로 동굴이 하나 있습니다. 동굴 입구에 있는 얼음 거인의 시체에서 거인의 돌덩이 견본을 채취하여 협곡 한가운데 근처에 있는 조르트에게 돌아가야 합니다.‡Consigue una muestra de carne de roca del cadáver del gigante de hielo de la entrada a la caverna en el Vicio de Cristal, al norte del emplazamiento de Zort. Cuando hayas hecho esto, vuelve junto a Zort, cerca del centro del cañón.‡Consigue una muestra de carne de roca del cadáver del gigante de hielo de la entrada a la caverna en el Vicio de Cristal, al norte del emplazamiento de Zort. Cuando hayas hecho esto, vuelve junto a Zort, cerca del centro del cañón.‡Collectez un Échantillon de chair rocheuse sur le cadavre du Géant des glaces à l\'entrée de la caverne dans l\'Étau de cristal, au nord de la position de Zort. Lorsque vous aurez terminé, retournez voir Zort près du centre du canyon.‡前往佐特的北面，在水晶裂痕下面的洞穴入口处的冰巨人尸体上收集一份岩石躯体样本。完成收集工作之后把它交给峡谷中央的佐特。‡從冰巨人的屍體上收集1份岩肉樣本，位置在水晶之鉗的山洞口，佐特的北邊。任務完成以後，向峽谷中央附近的佐特回報。',
  }
},
[12076] = {
  {
    'Negócio sujo‡Грязное дело‡Dreckige Angelegenheit‡지저분한 일‡Negocios sucios‡Negocios sucios‡Une sale affaire‡恶心的生意‡骯髒的事情',
    nil,
    'Colete 2 Ampolas de Cuspe Corrosivo dos Yormungares, usando a raspadeira em você mesmo. Leve as ampolas para Zort, na Fenda Cristalina, quando completar a tarefa.‡Соберите два фиала едкой слюны йормунгаров с помощью скребка. Выполнив задачу, принесите сосуды Зорту в ущелье Порочных Кристаллов.‡Füllt 2 Phiolen mit ätzendem Speichel, indem Ihr den Schaber auf Euch anwendet. Bringt die Phiolen wieder zu Zort in der Kristallschlucht, wenn Eure Aufgabe abgeschlossen ist.‡조르트의 긁개를 사용해 요르문가르의 부식성 타액이 담긴 유리병 2개를 모아서 수정 계곡에 있는 조르트에게 가져가십시오.‡Recoge 2 viales de flema corrosiva de los jormungar utilizando la rasqueta en ti. Lleva los viales a Zort en el Vicio de Cristal cuando hayas terminado.‡Recoge 2 viales de flema corrosiva de los jormungar utilizando la rasqueta en ti. Lleva los viales a Zort en el Vicio de Cristal cuando hayas terminado.‡Collectez 2 Fioles de crachat corrosif de jormungar en utilisant le racloir sur vous. Rapportez ensuite les fioles à Zort à l\'Étau de cristal.‡对自己使用佐特的刮刀，并收集2瓶腐蚀性的唾液。将你收集到的东西交给水晶裂痕内的佐特。‡對你自己使用刮鏟，收集2瓶蟄猛巨蟲吐出來的腐蝕唾液。任務完成以後，把瓶子帶給水晶之鉗的佐特。',
  }
},
[12077] = {
  {
    'Aplique duas vezes ao dia‡Употреблять дважды в день‡Zwei Mal am Tag anwenden‡하루에 두 번 복용‡Aplicar dos veces al día‡Aplicar dos veces al día‡À appliquer deux fois par jour‡主动示好‡一天兩次外敷',
    nil,
    'Ofereça o elixir que Zort preparou para Ko\'char, o Inquebrável.‡Предложите приготовленный Зортом эликсир Ко\'чару Неуязвимому.‡Bietet das von Zort zubereitete Elixier Ko\'char dem Unbezwingbaren an.‡조르트가 준비해 준 물약을 무적의 코차르에게 전달해야 합니다.‡Ofrécele a Ko\'char el Irrompible el elixir que ha preparado Zort.‡Ofrécele a Ko\'char el Irrompible el elixir que ha preparado Zort.‡Offrez l\'élixir préparé par Zort à Ko\'char l\'Invaincu.‡将佐特准备好的药剂交给坚不可摧的科查尔。‡把佐特準備的藥劑交給『無敵』寇恰。',
  }
},
[12078] = {
  {
    'O encantador de vermes‡Червячный наездник‡Wurmcowboy‡벌레 사냥꾼‡Domador de gusanos‡Retador de gusanos‡Ver querelleur‡抓虫子‡牧蟲人',
    nil,
    'Entre nas cavernas da Fenda Cristalina e capture 3 Crias de Yormungar usando os caixotes resistentes. Só pegue os caixotes de volta depois que os filhotes estiverem presos lá dentro!|n|nLeve as Crias de Yormungar de volta para Zort na Fenda Cristalina.‡Отправляйтесь в пещеры в ущелье Порочных кристаллов и заманите 3 порождения йормунгаров в крепкие ящики. Не забудьте собрать ящики, когда порождения йормунгаров окажутся в них!|n|nПринесите пойманные порождения йормунгаров Зорту в ущелье Порочных кристаллов.‡Betretet die Höhlen in der Kristallschlucht und fangt mithilfe stabiler Kisten 3 Exemplare der Jormungarbrut. Achtet jedoch darauf, dass Ihr die Kisten einsteckt, sobald die Jormungarbrut gefangen ist!|n|nBringt sie dann zu Zort in der Kristallschlucht.‡수정 계곡에 있는 동굴에 들어가 튼튼한 상자로 요르문가르 새끼 3마리를 사로잡아야 합니다. 요르문가르가 상자에 갇힌 후에 상자를 집어드십시오!|n|n사로잡힌 요르문가르 새끼를 가지고 수정 계곡에 있는 조르트에게 돌아가야 합니다.‡Entra en las cavernas del Vicio de Cristal y captura a 3 engendros jormungar dentro de cajones robustos. ¡No te olvides de recoger los cajones cuando los engendros jormungar estén bien atrapados dentro!|n|nLlévale los engendros jormungar a Zort en el Vicio de Cristal.‡Entra en las cavernas del Vicio de Cristal y captura a 3 engendros jormungar dentro de cajones robustos. ¡No te olvides de recoger los cajones cuando los engendros jormungar estén bien atrapados dentro!|n|nLlévale los engendros jormungar a Zort en el Vicio de Cristal.‡Rendez-vous dans les cavernes sous l’Étau de cristal et capturez 3 Rejetons jormungars dans des caisses solides. Ne ramassez les caisses que lorsque les Rejetons jormungars seront piégés à l’intérieur !|n|nEnsuite, apportez les Rejetons jormungars à Zort, à l’Étau de cristal.‡进入水晶裂痕下方的洞穴，使用盒子抓捕3只冷心冰虫幼体。记得在冷心冰虫幼体钻进盒子之后拿起盒子！|n|n将你抓获的冷心冰虫幼体带回水晶裂痕，交给佐特。‡進入水晶之鉗底下的洞窟，使用結實的木箱捕捉3隻蟄猛巨蟲幼蟲。在抓到幼蟲之後記得要把箱子撿起來!|n|n把被捕獲的蟄猛巨蟲幼蟲交給水晶之鉗的佐特。',
  }
},
[12079] = {
  {
    'Reconquistando a caverna‡Излюбленное место червяков‡Das Revier‡땅 다지기‡Territorio preferido‡Territorio preferido‡Terres piétinées‡践踏大地‡重踏地面',
    nil,
    'Penetre na caverna na parte norte da Fenda Cristalina e mate 8 Yormungares Caçadoras Gelocórdias para Ko\'char, o Inquebrável.‡Отправляйтесь в пещеру у северной оконечности ущелья Порочных кристаллов и убейте по поручению Ко\'чара Неуязвимого 8 йормунгаров-трутней Ледяного Сердца.‡Ko\'char der Unbezwingbare möchte, dass Ihr die Höhlen am nördlichen Ende der Kristallschlucht erforscht und 8 Eiskernjormungarfresser tötet.‡수정 계곡 북쪽 끝에 있는 동굴에서 요르문가르 청소부 8마리를 처치하고 무적의 코차르에게 돌아가야 합니다.‡Adéntrate en la caverna al extremo norte del Vicio de Cristal y mata a 8 alimentadores jormungar Corazón de Hielo para Ko\'char el Irrompible.‡Adéntrate en la caverna al extremo norte del Vicio de Cristal y mata a 8 alimentadores jormungar Corazón de Hielo para Ko\'char el Irrompible.‡Entrez dans la caverne à l\'extrême nord de l\'Étau de cristal et tuez 8 Nourrisseurs jormungars du cœur de glace pour Ko\'char l\'Invaincu.‡坚不可摧的科查尔要求你进入水晶裂痕北部末端的洞穴，杀死8条冷心冰虫喂食者。‡潛入水晶之鉗北端的洞穴，替『無敵』寇恰殺死8隻冰心蟄猛餵食者。',
  }
},
[12080] = {
  {
    'Verme enorme‡Вот это червяк!‡Mächtig großer Wurm‡거대한 벌레‡Un gusano muy grande‡Un gusano muy grande‡Très grand ver‡冰虫之母‡超級大蟲',
    nil,
    'Entre na Caverna Gelocórdia e mate Cascavadora. Se você ainda tiver, use o Elixir Protetor de Zort contra a cusparada corrosiva da Yormungar.|n|nFale novamente com Ko\'char, o Inquebrável, quando completar a tarefa.‡Войдите в пещеру Ледяного Сердца и убейте Грохотунью. Не забудьте использовать защитный эликсир Зорта, чтобы спастись от едких плевков йормунгаров – если, конечно, этот эликсир у вас еще есть.|n|nВыполнив задачу, вернитесь к Ко\'чару Неуязвимому в ущелье Порочных кристаллов.‡Betretet die Eiskernhöhlen und streckt Rüttelbohrer nieder. Benutzt Zorts schützendes Elixier, falls Ihr es noch besitzen solltet, um Euch vor dem ätzenden Speichel der Jormungar zu schützen.|n|nKehrt zu Ko\'char dem Unbezwingbaren in der Kristallschlucht zurück, wenn die Aufgabe abgeschlossen ist.‡얼음 심장 동굴에 들어가 톱날이빨을 처치해야 합니다. 조르트의 소화불량 비약으로 요르문가르의 부식성 침을 막을 수 있습니다.|n|n임무를 마치면 수정 계곡에 있는 무적의 코차르에게 돌아가야 합니다.‡Entra en la Caverna Corazón de Hielo y mata a Cascabore. Si aún está en tu posesión, asegúrate de usar el elixir protector de Zort para protegerte de la flema corrosiva de jormungar. |n|nVuelve a ver a Ko\'char el Irrompible en el Vicio de Cristal cuando hayas completado la tarea.‡Entra en la Caverna Corazón de Hielo y mata a Cascabore. Si aún está en tu posesión, asegúrate de usar el elixir protector de Zort para protegerte de la flema corrosiva de jormungar. |n|nVuelve a ver a Ko\'char el Irrompible en el Vicio de Cristal cuando hayas completado la tarea.‡Entrez dans la Caverne du Cœur de glace et tuez Cliquettroue. S\'il est toujours en votre possession, utilisez l\'élixir protecteur de Zort pour vous protéger du crachat corrosif du jormungar.|n|nRetournez auprès de Ko\'char l\'Invaincu, à l\'Étau de cristal, lorsque vous aurez accompli votre tâche.‡进入水晶裂痕底部的洞穴并杀死钻雪虫。如果你手中还有佐特的防护药剂，记得使用它来避免受到冰虫酸液的伤害。|n|n完成任务之后回去向坚不可摧的科查尔复命。‡進入冰心洞窟殺死響鑽。如果你還帶著的話，記得要用佐特的保護藥劑來保護你自己不受蟄猛巨蟲的噴酸傷害。|n|n當你完成任務之後向水晶之鉗的『無敵』寇恰回覆。',
  }
},
[12081] = {
  {
    'Gavrocha‡Гаврок‡Gavrock‡가브록‡Gavrock‡Gavrock‡Gavrock‡加弗洛克‡葛夫洛克',
    nil,
    'Fale com Gavrocha nas Ruínas de Tethys.‡Поговорите с Гавроком в Руинах Тетиса.‡Sprecht mit Gavrock in den Ruinen von Tethys.‡테시스의 폐허에 있는 가브록과 대화해야 합니다.‡Habla con Gavrock en las Ruinas de Tethys.‡Habla con Gavrock en las Ruinas de Tethys.‡Parlez à Gavrock aux Ruines de Téthys.‡与泰塞斯废墟内的加弗洛克谈一谈。‡和瑟希斯遺跡的葛夫洛克交談。',
  }
},
[12082] = {
  {
    'Ta-na-na-náá!‡Дун-да-Дун-та!‡Dan-ta dan-ta dan-ta-dah!‡빰빠밤빰 빰빠밤!‡¡Tralarí, tralará!‡¡Tralarí, tralará!‡Ta-ta da ta-Da da !‡喔——哒！！‡嘟–答–嘟–噠!',
    nil,
    'Escolte Harrison das Ruínas de Drakil\'jin, e em seguida fale com Harkor no Acampamento do Harkor.‡Сопроводите Харрисона по пути из руин Дракил\'джин, после чего поговорите с Харкором в лагере Харкора.‡Eskortiert Harrison aus den Ruinen von Drakil\'jin, sprecht dann mit Harkor im gleichnamigen Lager.‡드락진 폐허에서부터 해리슨을 호위한 다음, 하코르의 야영지에 있는 하코르와 대화해야 합니다.‡Escolta a Harrison de las Ruinas de Drakil\'jin, después habla con Harkor en el Campamento de Harkor.‡Escolta a Harrison de las Ruinas de Drakil\'jin, después habla con Harkor en el Campamento de Harkor.‡Accompagnez Harrison jusqu\'à la sortie des Ruines de Drakil\'jin, puis parlez à Harkor au Camp de Harkor.‡护送哈里森离开达基尔金废墟，然后与哈考尔营地的哈考尔谈一谈。‡護送哈里遜從德拉齊金遺跡逃脫，接著和哈克爾營地的哈克爾交談。',
  }
},
[12083] = {
  {
    'No alto dos bosques‡В лесах‡Über dem Waldland‡숲속으로‡En lo alto del bosque‡En lo alto del bosque‡Là-haut dans la forêt‡森林上空‡林地之上',
    nil,
    'Obtenha o Amuleto de Controle do Foco da Linha do Meridiano e use-o para conseguir informações do Foco da Linha do Meridiano nos bosques de Lothalor.|n|nEntão, fale novamente com a Imagem da Arquimaga Modera no Recanto das Estrelas.‡Добудьте амулет управления средоточием силовых линий и используйте его для получения сведений о средоточии силовых линий в Лоталорском редколесье.|n|nПосле этого вернитесь к проекции верховного мага Модеры в Покое Звезд.‡Beschafft Euch das Steuerungsamulett des Leylinienfokus und verwendet es, um Informationen vom Leylinienfokus in den Waldländern von Lothalor zu erhalten.|n|nKehrt anschließend zum Abbild der Erzmagierin Modera in Sternenruh zurück.‡지맥 집중점 제어 아뮬렛을 얻어 로탈로르 숲의 지맥 집중점 정보를 수집해야 합니다.|n|n그런 다음 별의 쉼터에 있는 대마법사 모데라의 환영에게 돌아가야 합니다.‡Consigue el amuleto de control de foco de línea Ley del Bosque Lothalor.|n|nDespués, vuelve con la imagen de la archimaga Modera en Reposo Estelar.‡Consigue el amuleto de control de foco de línea Ley del Bosque Lothalor.|n|nDespués, vuelve con la imagen de la archimaga Modera en Reposo Estelar.‡Procurez-vous l\'Amulette de contrôle des lignes telluriques et utilisez-la pour obtenir des informations sur le Focalisateur de lignes telluriques de la Forêt de Lothalor.|n|nRetournez ensuite auprès de l\'Image de l\'archimage Modera au Repos des étoiles.‡夺取魔网能量焦点控制护符，用它从罗萨洛尔森林的的魔网能量线焦点中获取信息。|n|n然后返回群星之墓，向大法师茉德拉的影像复命。‡取得地脈節點控制護符並且對繁星之眠的地脈節點使用，以獲得更多的訊息。|n|n接著，向繁星之眠的大法師莫德菈的影像回報。',
  }
},
[12084] = {
  {
    'No alto dos bosques‡В лесах‡Über den Waldländern‡숲속으로‡En lo alto del bosque‡En lo alto del bosque‡Là-haut dans la forêt‡森林上空‡林地之上',
    nil,
    'Obtenha o Amuleto de Controle do Foco da Linha do Meridiano e use-o para conseguir informações do Foco da Linha do Meridiano nos bosques de Lothalor.|n|nEntão, fale novamente com a Imagem do Arquimago Aethas Fendessol no Martelo de Agmar.‡Добудьте амулет управления средоточием силовых линий и воспользуйтесь им для получения сведений от средоточия силовых линий в Лоталорском редколесье.|n|nЗатем вернитесь к проекции верховного мага Этаса Похитителя Солнца в Молот Агмара.‡Beschafft Euch das Steuerungsamulett des Leylinienfokus und verwendet es, um Informationen vom Leylinienfokus in den Waldländern von Lothalor zu erhalten.|n|nKehrt anschließend zum Abbild des Erzmagiers Aethas Sonnenhäscher bei Agmars Hammer zurück.‡지맥 집중점 제어 아뮬렛을 얻어 로탈로르 숲의 지맥 집중점 정보를 수집해야 합니다.|n|n그런 다음 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 돌아가야 합니다.‡Consigue el amuleto de control de foco de línea Ley y úsalo para obtener información sobre el foco de línea Ley en el Bosque Lothalor.|n|nDespués, vuelve con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Consigue el amuleto de control de foco de línea Ley y úsalo para obtener información sobre el foco de línea Ley en el Bosque Lothalor.|n|nDespués, vuelve con la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Procurez-vous l\'Amulette de contrôle des lignes telluriques et utilisez-la pour obtenir des informations sur le Focalisateur de lignes telluriques de la Forêt de Lothalor.|n|nRetournez ensuite auprès de l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡夺取魔网能量焦点控制护符，用它从罗萨洛尔森林的的魔网能量线焦点中获取信息。|n|n然后返回阿格玛之锤，向大法师艾萨斯·夺日者的影像复命。‡取得地脈節點控制護符並且對洛薩羅林地的地脈節點使用，以獲得更多的訊息。|n|n接著，向阿格瑪之錘的大法師埃薩·奪日者的影像回報。',
  }
},
[12085] = {
  {
    'Uma carta para casa‡Письмо домой‡Ein Brief an Zuhause‡집으로 보내는 편지‡Una carta para casa‡Una carta para casa‡Une lettre pour la maison‡一封家书‡一封家書',
    nil,
    'Entregue a Carta do Tenente Ta\'zinni ao Lorde Supremo Agmar no Martelo de Agmar.‡Отнесите письмо лейтенанта Та\'зинни командиру Агмару в Молот Агмара.‡Liefert Leutnant Ta\'zinnis Brief bei Oberanführer Agmar in Agmars Hammer ab.‡부관 타진니의 편지를 아그마르의 망치에 있는 대군주 아그마르에게 전달해야 합니다.‡Entrega la carta del teniente Ta\'zinni al señor supremo Agmar en Martillo de Agmar.‡Entrega la carta del teniente Ta\'zinni al señor supremo Agmar en Martillo de Agmar.‡Apportez la Lettre du lieutenant Ta\'zinni au Suzerain Agmar au Marteau d\'Agmar.‡将塔辛尼中尉的信交给阿格玛之锤的阿格玛大王。‡將塔辛尼中尉的信件送給阿格瑪之錘的霸主阿格瑪。',
  }
},
[12086] = {
  {
    'O filho de Karkut‡Сын Каркута‡Karkuts Sohn‡카르쿠트의 자손‡El hijo de Karkut‡El hijo de Karkut‡Le fils de Karkut‡卡库特之子‡卡庫特之子',
    nil,
    'Vá para o Campo da Morte, depois de Unu\'pe.‡Идите на восток к Стоянке Смерти, находящейся сразу за Уну\'пе.‡Geht in Richtung Osten nach Todeswehr jenseits von Unu\'pe.‡동쪽으로 가 우누페 바로 너머에 있는 죽음의 언덕으로 가야 합니다.‡Ve al Confín de la Muerte, pasando Unu\'pe.‡Ve al Confín de la Muerte, pasando Unu\'pe.‡Aller au Séjour de la mort. C\'est vers l\'est, juste au-delà d\'Unu\'pe.‡前往乌努比东边的死亡营地。‡越過昂紐沛，前往東方的死亡看臺。',
  }
},
[12087] = {
  {
    'A Little Help Here? DEPRECATED‡Немного помочь? DEPRECATED‡A Little Help Here? DEPRECATED‡도움의 손길‡¿Un poco de ayuda? DEPRECATED‡¿Un poco de ayuda? DEPRECATED‡Un peu d’aide ?‡A Little Help Here? DEPRECATED‡幫點小忙?DEPRECATED',
    nil,
    'Corporal Venn at Death\'s Stand wants you to kill 8 Ziggurat Defenders.‡Убейте 8 защитников зиккурата по просьбе капрала Венна со Стоянки Смерти.‡Corporal Venn at Death\'s Stand wants you to kill 8 Ziggurat Defenders.‡죽음의 언덕에 있는 하사관 벤이 지구라트 파수꾼 8마리를 처치해 달라고 부탁했습니다.‡El cabo Venn en el Confín de la Muerte quiere que mates a 8 defensores del zigurat.‡El cabo Venn en el Confín de la Muerte quiere que mates a 8 defensores del zigurat.‡Le Caporal Venn, au Séjour de la Mort, veut que vous tuiez 8 Défenseurs de la ziggourat.‡Corporal Venn at Death\'s Stand wants you to kill 8 Ziggurat Defenders.‡死亡看臺的下士維恩要你殺死8個通靈塔防衛者。',
  }
},
[12088] = {
  {
    'Thassarian, o Cavaleiro da Morte‡Тассариан, рыцарь Смерти‡Thassarian der Todesritter‡죽음의 기사, 타사리안‡Thassarian, el caballero de la Muerte‡Thassarian, el caballero de la Muerte‡Thassarian, le chevalier de la mort‡死亡骑士萨萨里安‡薩沙理安，死亡騎士',
    nil,
    'Procure por Thassarian dentro do Zigurate dos Lamentos, ao norte do Campo da Morte.‡Отыщите Тассариана внутри Стонущего зиккурата, к северу от Стоянки Смерти.‡Seht nach Thassarian im Inneren der klagenden Ziggurat nördlich von Todeswehr.‡죽음의 언덕의 북쪽에 있는 통곡의 지구라트에서 타라시안을 찾아야 합니다.‡Busca a Thassarian dentro de El Zigurat de los Lamentos, al norte de Confín de la Muerte.‡Busca a Thassarian dentro de El Zigurat de los Lamentos, al norte de Confín de la Muerte.‡Partez à la recherche de Thassarian dans la ziggourat Gémissante au nord du Séjour de la Mort.‡进入死亡营地北方的悲叹通灵塔，寻找萨萨里安。‡在死亡看臺北方的悲嘯通靈塔中尋找薩沙理安。',
  }
},
[12089] = {
  {
    'Procura-se: Magíster Keldonus‡Разыскивается: магистр Кельдонус!‡GESUCHT: Magister Keldonus‡현상 수배: 마법학자 켈도누스‡Se busca: Magister Keldonus‡Se busca: Magister Keldonus‡On recherche : magistère Keldonus‡通缉：魔导师凯尔多努斯‡懸賞:博學者克爾多努斯',
    nil,
    'Mate o Magíster Keldonus e fale com o Capitão Gort, no Martelo de Agmar, que fica no Ermo das Serpes.‡Убейте магистра Кельдонуса и вернитесь к капитану Горту в Молот Агмара в Драконьем Погосте.‡Erschlagt Magister Keldonus und kehrt anschließend zu Hauptmann Gort in Agmars Hammer in der Drachenöde zurück.‡마법학자 켈도누스를 처치한 다음 용의 안식처의 아그마르의 망치에 있는 경비대장 고르트에게 돌아가야 합니다.‡Mata al magister Keldonus y ve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.‡Mata al magister Keldonus y ve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.‡Tuer le Magistère Keldonus et retourner voir le Capitaine Gort au Marteau d\'Agmar à la Désolation des dragons.‡杀死魔导师凯尔多努斯，然后返回龙骨荒野的阿格玛之锤，向高尔特上尉复命。‡殺死博學者克爾多努斯，並向苟爾特隊長回報，他在龍骨荒野的阿格瑪之錘中。',
  }
},
[12090] = {
  {
    'Procura-se: Gigantauro‡Разыскивается: Гигантавр‡Gesucht: Gigantaur‡현상 수배: 기간타우르‡Se busca: Gigantauro‡Se busca: Gigantauro‡On recherche : Gigantaure‡通缉：吉加托尔‡懸賞:吉甘陶',
    nil,
    'Mate Gigantauro e fale novamente com o Capitão Gort no Martelo de Agmar, que fica no Ermo das Serpes.‡Убейте Гигантавра и приходите за вознаграждением к капитану Горту в Молоте Агмара на Драконьем Погосте.‡Erschlagt Gigantaur und kehrt anschließend zu Hauptmann Gort in Agmars Hammer in der Drachenöde zurück.‡기간타우르를 제거한 다음 용의 안식처의 아그마르의 망치에 있는 경비대장 고르트에게 돌아가야 합니다.‡Mata a Gigantauro y vuelve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.|n‡Mata a Gigantauro y vuelve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.|n‡Tuer Gigantaure et retourner voir le Capitaine Gort au Marteau d\'Agmar à la Désolation des dragons.‡杀死吉加托尔，然后返回龙骨荒野的阿格玛之锤，向高尔特上尉复命。‡殺死吉甘陶，並向苟爾特隊長回報，他在龍骨荒野的阿格瑪之錘中。',
  }
},
[12091] = {
  {
    'Procura-se: Garra Horrenda‡Разыскивается: Коготь Ужаса‡GESUCHT: Schreckensklaue‡현상 수배: 공포의 갈고리‡Se busca: Garra Temible‡Se busca: Garra Temible‡On recherche : Serreffroi‡通缉：恐怖之爪‡懸賞:懼爪',
    nil,
    'Mate Garra Horrenda e fale com o Capitão Gort, no Martelo de Agmar, que fica no Ermo das Serpes.‡Убейте Когтя Ужаса и вернитесь за вознаграждением к капитану Горту в Молот Агмара на Драконьем Погосте.‡Erschlagt Schreckensklaue und kehrt anschließend zu Hauptmann Gort in Agmars Hammer in der Drachenöde zurück.‡공포의 갈고리를 제거한 다음 용의 안식처의 아그마르의 망치에 있는 경비대장 고르트에게 돌아가야 합니다.‡Mata a Garra Temible y vuelve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.‡Mata a Garra Temible y vuelve a ver al capitán Gort al Martillo de Agmar en el Cementerio de Dragones.‡Tuer Serreffroi et retourner voir le Capitaine Gort au Marteau d\'Agmar à la Désolation des dragons.‡杀死恐怖之爪，然后返回龙骨荒野的阿格玛之锤，向高尔特上尉复命。‡殺死懼爪，並向苟爾特隊長回報，他在龍骨荒野的阿格瑪之錘中。',
  }
},
[12092] = {
  {
    'Fortaleça os ancientes‡Усиление древняков‡Den Urtumen Kraft verleihen‡고대정령에게 힘을‡Devuelve la fuerza a los ancestros‡Devuelve la fuerza a los ancestros‡Renforcer les Anciens‡强化古树‡強化古樹',
    nil,
    'Use a Casca dos Andarilhos para fortalecer 3 Ancientes de Lothalor e então fale novamente com Sarendryana no Recanto das Estrelas.‡Воспользуйтесь корой древня для усиления 3 древ Лоталора, а затем вернитесь к Сарендриане в Покой Звезд.‡Benutzt die Borke der Wanderer und stärkt damit 3 Urtume von Lothalor. Kehrt anschließend zu Sarendryana in Sternenruh zurück.‡정령의 나무껍질을 사용해 로탈로르 선조 3마리가 힘을 되찾게 한 다음, 별의 쉼터에 있는 세렌드리아나에게 돌아가야 합니다.‡Usa la corteza de los caminantes para devolver la fuerza a 3 ancestros Lothalor y luego vuelve con Sarendryana en Reposo Estelar.‡Usa la corteza de los caminantes para devolver la fuerza a 3 ancestros Lothalor y luego vuelve con Sarendryana en Reposo Estelar.‡Utiliser l\'Écorce des marcheurs pour renforcer 3 Anciens de Lothalor et retourner auprès de Sarendryana au Repos des étoiles.‡使用树人的树皮让3个罗萨洛尔古树恢复力量，然后向群星之墓的萨蕾德亚娜复命。‡對3個洛薩羅古樹使用行者樹皮以強化他們，然後向繁星之眠的薩瑞翠亞納回報。',
  }
},
[12093] = {
  {
    'Runas de compulsão‡Руны порабощения‡Runen des Zwangs‡속박의 룬‡Runas de coacción‡Runas de coacción‡Les runes de contrainte‡压制符文‡強制符文',
    nil,
    'Gavrocha, nas Ruínas de Tethys, quer que você neutralize as quatro Runas de Compulsão derrotando o Feitor Durval, o Feitor Korgan, o Feitor Lochli e o Feitor Brunon.‡Гаврок с Руин Тетиса просит вас отключить четыре руны порабощения, убив надзирателя Дюрваля, надзирателя Коргана, надзирателя Лочли и надзирателя Брунона.‡Gavrock in den Ruinen von Tethys möchte, dass Ihr die vier Runen des Zwangs ausschaltet, indem Ihr Aufseher Durval, Aufseher Korgan, Aufseher Lochli und Aufseher Brunon besiegt.‡테시스의 폐허에 있는 가브록이 감독관 더발, 감독관 코르간, 감독관 로클리, 그리고 감독관 브루논을 처치하고 속박의 룬 4개를 무력화해 달라고 부탁했습니다.‡Gavrock en las Ruinas de Tethys quiere que neutralices las cuatro runas de coacción. Para ello tendrás que derrotar al sobrestante Durval, al sobrestante Korgan, al sobrestante Lochli y al sobrestante Brunon.‡Gavrock en las Ruinas de Tethys quiere que neutralices las cuatro runas de coacción. Para ello tendrás que derrotar al sobrestante Durval, al sobrestante Korgan, al sobrestante Lochli y al sobrestante Brunon.‡Gavrock, des Ruines de Téthys, veut que vous neutralisiez les quatre Runes de contrainte en triomphant du Surveillant Durval, du Surveillant Korgan, du Surveillant Lochli et du Surveillant Brunon.‡泰塞斯废墟内的加弗洛克要求你通过击败工头多瓦尔、工头库尔甘、工头洛克里和工头布隆诺的方式中和全部四处压制符文。‡瑟希斯遺跡的葛夫洛克要你去打敗監督者德沃、監督者寇爾甘、監督者羅克利和監督者布魯農，好讓四個強制符文失去效力。',
  }
},
[12094] = {
  {
    'Poder latente‡Спящая сила‡Latente Macht‡잠재된 힘‡Poder latente‡Poder latente‡Une puissance latente‡潜在的能量‡潛在的力量',
    nil,
    'Energize o Estilhaço de Gavrocha no Primeiro Marco Ancestral, no Segundo Marco Ancestral e no Terceiro Marco Ancestral, e em seguida fale novamente com Gavrocha nas Ruínas de Tethys.‡Зарядите осколок Гаврока у первого, второго и третьего древних камней, после чего вернитесь к Гавроку в Руины Тетиса.‡Ladet den Splitter von Gavrock am ersten, zweiten und dritten uralten Stein auf und kehrt anschließend zu Gavrock in den Ruinen von Tethys zurück.‡첫 번째 고대 표석, 두 번째 고대 표석, 그리고 세 번째 북쪽 표석에서 가브록의 파편에 힘을 불어넣은 다음 테시스의 폐허에 있는 가브록에게 돌아가야 합니다.‡Carga el Fragmento de Gavrock en la primera piedra antigua, la segunda piedra antigua y la tercera piedra antigua, después regresa con Gavrock en las Ruinas de Tethys.‡Carga el Fragmento de Gavrock en la primera piedra antigua, la segunda piedra antigua y la tercera piedra antigua, después regresa con Gavrock en las Ruinas de Tethys.‡Chargez l’Éclat de Gavrock à la Première pierre des anciens, à la Deuxième pierre des anciens et à la Troisième pierre des anciens, puis retournez voir Gavrock aux Ruines de Téthys.‡分别在第一块远古巨石、第二块远古巨石和第三块远古巨石为加弗洛克碎片充能，然后向泰塞斯废墟内的加弗洛克复命。‡到第一塊遠古之石、第二塊遠古之石、以及第三塊遠古之石替葛夫洛克裂片充能，然後返回瑟希斯遺跡找葛夫洛克。',
  }
},
[12095] = {
  {
    'Para a Aldeia do Dragão Arruinado‡В Драконью Погибель‡Zum Drachenjägerposten‡용사냥 마루로‡A Caída del Dragón‡A Caída del Dragón‡Direction la Chute du dragon‡前往猎龙营地‡前往龍殞營地',
    nil,
    'Fale com Rokhan, na Aldeia do Dragão Arruinado, que fica no Ermo das Serpes.‡Поговорите с Рокханом в Драконьей Погибели в Драконьем Погосте.‡Sprecht mit Rokhan in Drachensturz in der Drachenöde.‡용의 안식처 내 용사냥 마루에 있는 로칸과 대화해야 합니다.‡Habla con Rokhan en Caída del Dragón en el Cementerio de Dragones.‡Habla con Rokhan en Caída del Dragón en el Cementerio de Dragones.‡Parler à Rokhan à la Chute du dragon dans la Désolation des dragons.‡前往龙骨荒野的猎龙营地，与洛坎谈一谈。‡與龍骨荒野上龍殞營地的洛克漢交談。',
  }
},
[12096] = {
  {
    'Fortaleça os ancientes‡Усиление древняков‡Stärkt die Urtume‡고대정령에게 힘을‡Devuelve la fuerza a los ancestros‡Devuelve la fuerza a los ancestros‡Renforcer les Anciens‡强化古树‡強化古樹',
    nil,
    'Use a Casca dos Andarilhos para fortalecer 3 Ancientes de Lothalor e então fale novamente com o Guarda da Terra Grife no Martelo de Agmar.‡Воспользуйтесь корой древня для усиления 3 древ Лоталора, а затем вернитесь к хранителю земли Грифу в Молот Агмара.‡Benutzt die Borke der Wanderer, um 3 Urtume von Lothalor zu stärken, und kehrt anschließend zu Erdenwächter Graif in Agmars Hammer zurück.‡정령의 나무껍질을 사용해 로탈로르 선조 3마리에게 힘을 되찾게 한 다음 아그마르의 망치에 있는 대지의 파수꾼 그리프에게 돌아가야 합니다.‡Utiliza la corteza de los caminantes para devolver la fuerza a 3 ancestros Lothalor y vuelve con el celador de la tierra Grife en Martillo de Agmar.‡Utiliza la corteza de los caminantes para devolver la fuerza a 3 ancestros Lothalor y vuelve con el celador de la tierra Grife en Martillo de Agmar.‡Utiliser l\'Écorce des marcheurs pour renforcer 3 Anciens de Lothalor et retourner auprès du Garde-terre Grife au Marteau d\'Agmar.‡使用树人的树皮让3个罗萨洛尔古树恢复力量，然后向阿格玛之锤的大地看守者格莱弗复命。‡對3個洛薩羅古樹使用行者樹皮以強化他們，然後向阿格瑪之錘的大地守望者格里夫回報。',
  }
},
[12097] = {
  {
    'Sarathstra, Flagelo do norte‡Сарастра, бич Севера‡Sarathstra, Geißel des Nordens‡북방의 스컬지, 사라스트라‡Sarathstra, Plaga del norte‡Sarathstra, Plaga del norte‡Sarathstra, Fléau du nord‡萨拉斯塔，北地的灾祸‡薩拉絲婥，北方災厄',
    nil,
    'Peça para Rokhan chamar a serpe gélida Sarathstra.|n|nMate Sarathstra e entregue o Coração Gelado de Sarathstra para o Capitão Gort no Martelo de Agmar.‡Поговорите с Рокханом, чтобы призвать ледяного змея Сарастру.|n|nУбейте змея и отнесите ледяное сердце Сарастры капитану Горту в Молот Агмара.‡Sprecht mit Rokhan, um den Frostwyrm Sarathstra herbeizurufen.|n|nTötet Sarathstra und liefert Sarathstras gefrorenes Herz bei Hauptmann Gort in Agmars Hammer ab.‡로칸과 대화하여 서리고룡 사라스트라를 불러내야 합니다.|n|n사라스트라를 제거한 다음 사라스트라의 얼어붙은 심장을 아그마르의 망치에 있는 경비대장 고르트에게 가져가야 합니다.‡Habla con Rokhan para atraer a la vermis de escarcha Sarathstra.|n|nMata a Sarathstra y lleva el corazón congelado de Sarathstra al capitán Gort en Martillo de Agmar.‡Habla con Rokhan para atraer a la vermis de escarcha Sarathstra.|n|nMata a Sarathstra y lleva el corazón congelado de Sarathstra al capitán Gort en Martillo de Agmar.‡Parler à Rokhan pour qu\'il invoque le wyrm de givre Sarathstra.|n|nTuer Sarathstra et remettre le Cœur glacé de Sarathstra au Capitaine Gort au Marteau d\'Agmar.‡与猎龙营地的洛坎交谈，让他将冰霜巨龙萨拉斯塔召唤下来。|n|n杀死萨拉斯塔，并将萨拉斯塔的冰冻之心交给阿格玛之锤的高尔特上尉。‡與洛克漢交談，呼喚冰霜巨龍薩拉絲婥。|n|n殺死薩拉絲婥並且把薩拉絲婥的冰凍心臟送去給阿格瑪之錘的苟爾特隊長。',
  }
},
[12098] = {
  {
    'Vasculhe a Aldeia Indu\'le‡Поиски в деревне Инду\'ле‡Durchsucht Indu\'le‡인두르 마을 수색‡Busca por el Poblado Indu\'le‡Busca por el Poblado Indu\'le‡Fouillez Indu\'le‡搜索因度雷村‡搜索因度雷村',
    nil,
    'Procure o comandante das tropas de caça-magos na Aldeia Indu\'le e no Lago Indu\'le.‡Найдите командира охотников на магов в деревне Инду\'ле либо на озере Инду\'ле.‡Sucht in Indu\'le und im Wasser von Indu\'le nach dem Kommandanten der Magierjägertruppen.‡인두르 마을과 인두르 호수에서 마법사 사냥꾼 부대의 지휘관을 찾아야 합니다.‡Busca al comandante de las fuerzas de cazadores de magos en el Poblado Indu\'le y en el Lago Indu\'le.‡Busca al comandante de las fuerzas de cazadores de magos en el Poblado Indu\'le y en el Lago Indu\'le.‡Cherchez le commandant des forces des chasseurs de mages à Indu\'le et au Lac Indu\'le.‡在因度雷村和因度雷湖寻找法师猎手部队的指挥官。‡尋找因度雷村和因度雷湖的狩法獵人指揮者。',
  }
},
[12099] = {
  {
    'Liberdade, liberdade‡Долгожданная свобода‡Endlich frei‡마침내 맞이한 자유‡Por fin libres‡Por fin libres‡Libres, enfin‡终获解救‡終獲自由',
    nil,
    'Use o Quebra-runas de Gavrocha para libertar 4 Gigantes Rúnicos, e então fale novamente com Gavrocha nas Ruínas de Tethys.‡Воспользуйтесь Руноломом Гаврока, чтобы освободить четырех рунических великанов, после чего вернитесь к Гавроку в Руины Тетиса.‡Befreit mit Gavrocks Runenbrecher 4 runenbeschriebene Riesen und kehrt anschließend zu Gavrock in den Ruinen von Tethys zurück.‡가브록의 룬파괴석을 사용해 룬문자 거인 4마리를 풀어준 다음 테시스의 폐허에 있는 가브록에게 돌아가야 합니다.‡Utiliza el romperrunas de Gavrock para liberar a 4 gigantes con runas y luego vuelve junto a Gavrock en las Ruinas de Tethys.‡Utiliza el romperrunas de Gavrock para liberar a 4 gigantes con runas y luego vuelve junto a Gavrock en las Ruinas de Tethys.‡Utilisez le Briserune de Gavrock pour libérer 4 Géants runifiés, puis retournez voir Gavrock aux Ruines de Téthys.‡使用加弗洛克的符文碎裂之石解救4名符文巨人，然后向泰塞斯废墟内的加弗洛克复命。‡使用葛夫洛克的符文破壞者釋放四個符文巨人，然後向瑟希斯遺跡的葛夫洛克回報。',
  }
},
[12100] = {
  {
    'Contendo a putrefação‡Сдерживание гнили‡Der Verwesung Einhalt gebieten‡부패를 막아라‡Contener la putrefacción‡Contener la putrefacción‡Contenir la putréfaction‡腐烂的器官‡遏止腐敗',
    nil,
    'Pairante Fúria da Águia, no Martelo de Agmar, no Ermo das Serpes, quer que você mate 15 Animais Selvagens Infectados e ache um Órgão Resistente à Putrefação.‡По заданию Соара Ярости Ястреба из Молота Агмара на Драконьем Погосте убейте 15 зараженных тварей и добудьте орган сопротивления гниению.‡Soar Falkenzorn in Agmars Hammer in der Drachenöde möchte, dass Ihr 15 infizierte Wildtiere tötet und ein verwesungsresistentes Organ beschafft.‡용의 안식처에 있는 아그마르의 망치의 소어 호크퓨리가 병든 야생동물 15마리를 처치하고 썩지 않고 보존된 기관을 가져와 달라고 부탁했습니다.‡Soar Furia de Halcón en Martillo de Agmar en el Cementerio de Dragones quiere que mates a 15 ejemplares de fauna infectada y recuperes un órgano resistente a la putrefacción.‡Soar Furia de Halcón en Martillo de Agmar en el Cementerio de Dragones quiere que mates a 15 ejemplares de fauna infectada y recuperes un órgano resistente a la putrefacción.‡Essor Fureur-du-faucon au Marteau d\'Agmar dans la Désolation des dragons veut que vous tuiez 15 Spécimens de la faune infectés et que vous trouviez un Organe résistant à la putréfaction.‡龙骨荒野阿格玛之锤的索艾·鹰怒要你杀死15只被感染的野生动物，并取回一个防腐内脏。‡龍骨荒野上，阿格瑪之錘的梭爾·鷹怒要你殺死15個被感染的野生生物，並取得抗腐內臟。',
  }
},
[12101] = {
  {
    'O bom doutor...‡Добрый доктор...‡Der gute Doktor...‡훌륭한 의사...‡El buen doctor...‡El buen doctor...‡Le bon docteur…‡好医生……‡好醫生…',
    nil,
    'Entregue o Órgão Resistente à Putrefação ao Dr. Síntar C. Málius, no Martelo de Agmar.‡Отнесите орган сопротивления гниению доктору Синтару Злобениусу в Молот Агмара.‡Liefert das verwesungsresistente Organ bei Doktor Sintar Malefius in Agmars Hammer ab.‡아그마르의 망치에 있는 의술사 신타르 말레피오스에게 썩지 않고 보존된 기관을 전달해야 합니다.‡Entrega el órgano resistente a la putrefacción al doctor Sintar Malefious en Martillo de Agmar.|n‡Entrega el órgano resistente a la putrefacción al doctor Sintar Malefious en Martillo de Agmar.|n‡Remettez l\'Organe résistant à la putréfaction au Dr Maléfious au Marteau d\'Agmar.‡将防腐内脏交给阿格玛之锤的辛塔尔·玛菲奥斯博士。‡將抗腐內臟送去給阿格瑪之錘的辛塔爾·瑪雷菲爾斯醫生。',
  }
},
[12102] = {
  {
    'Em busca da lilás-rubi‡В поисках рубиновой сирени‡Auf der Suche nach dem rubinfarbenen Flieder‡루비 라일락을 찾아서‡En busca de la lila de color rubí‡En busca de la lila de color rubí‡À la recherche du lilas rubis‡红玉丁香‡尋找晶紅紫丁香',
    nil,
    'O Doutor Síntar C. Málius, no Martelo de Agmar, no Ermo das Serpes, quer que você colete 1 Lilás-rubi.‡Принесите 1 цветок рубиновой сирени доктору Синтару Злобениусу в Молот Агмара на Драконьем Погосте.‡Doktor Sintar Malefius in Agmars Hammer in der Drachenöde möchte, dass Ihr 1 rubinfarbenen Flieder pflückt.‡용의 안식처에 있는 아그마르의 망치의 의술사 신타르 말레피오스가 루비 라일락 한 송이를 가져와 달라고 부탁했습니다.‡El doctor Sintar Malefious en Martillo de Agmar en el Cementerio de Dragones quiere que consigas una lila de color rubí.‡El doctor Sintar Malefious en Martillo de Agmar en el Cementerio de Dragones quiere que consigas una lila de color rubí.‡Le Docteur Sintar Maléfious au Marteau d\'Agmar dans la Désolation des dragons veut que vous alliez chercher 1 Lilas rubis.‡龙骨荒野阿格玛之锤的辛塔尔·玛菲奥斯博士要你采集一株红玉丁香。‡龍骨荒野，阿格瑪之錘的辛塔爾·瑪雷菲爾斯醫生要你收集1個晶紅紫丁香。',
  }
},
[12103] = {
  {
    '‡ИСКЛЮЧЕНО‡‡미사용‡‡‡VIEUX‡你疯了吗，高弗雷？协议？！‡',
    nil,
    '‡Капитан Деррик из Приюта Янтарной Сосны просит вас убить 8 селян Среброречья и 8 звероловов Среброречья.‡‡‡El Capitán Derrick en el Refugio Pino Ámbar quiere que mates a 8 habitantes de Arroyoplata y a 8 tramperos de Arroyoplata.‡El Capitán Derrick en el Refugio Pino Ámbar quiere que mates a 8 habitantes de Arroyoplata y a 8 tramperos de Arroyoplata.‡Le capitaine Derrick du gîte Ambrepin vous demande de tuer 8 Villageois de Ruissargent et 8 Trappeurs de Ruissargent.‡‡',
  }
},
[12104] = {
  {
    'Falar com Pairante‡Вакцина для Соара‡Kehrt zu Soar zurück‡소어에게 돌아가기‡Regresa junto a Soar‡Regresa junto a Soar‡Retour vers Essor‡返回索艾身边‡向梭爾回報',
    nil,
    'Entregue a Vacina de Síntar a Pairante Fúria da Águia no Martelo de Agmar.‡Отнесите вакцину Синтара Соару Ярости Ястреба в Молот Агмара.‡Liefert Sintars Impfstoff bei Soar Falkenzorn in Agmars Hammer ab.‡아그마르의 망치에 있는 소어 호크퓨리에게 신타르의 예방약을 전달해야 합니다.‡Entrega la vacuna de Sintar a Soar Furia de Halcón en Martillo de Agmar.‡Entrega la vacuna de Sintar a Soar Furia de Halcón en Martillo de Agmar.‡Apportez le vaccin de Sintar à Essor Fureur-du-faucon au Marteau d\'Agmar.‡将辛塔尔的疫苗交给阿格玛之锤的索艾·鹰怒。‡把辛塔爾的疫苗送去給阿格瑪之錘的梭爾·鷹怒。',
  }
},
[12105] = {
  {
    'Descida às trevas‡Погружение во мрак‡Abstieg in die Dunkelheit‡어둠 속으로‡Descenso a la oscuridad‡Descenso a la oscuridad‡Descente dans les ténèbres‡坠入黑暗‡深入黑暗',
    nil,
    'Entregue o Diário de Mikhail ao Tenente Dumont no Chalé do Pinho Âmbar.‡Отнесите дневник Михаила лейтенанту Думонту в Приют Янтарной Сосны.‡Bringt Mikhails Tagebuch zu Leutnant Dumont bei der Ammertannhütte.‡미크헤일의 일지를 호박빛소나무 오두막에 있는 부관 듀몬트에게 가져가야 합니다.‡Llévale el diario de Mikhail al teniente Dumont en el Refugio Pino Ámbar.‡Llévale el diario de Mikhail al teniente Dumont en el Refugio Pino Ámbar.‡Remettez le Journal de Mikhail au Lieutenant Dumont, du Gîte Ambrepin.‡将米克哈尔的日记交给琥珀松木营地的杜蒙特中尉。‡將米克哈爾的日誌帶給琥珀松小屋的都蒙特中尉。',
  }
},
[12106] = {
  {
    'Vasculhe a Aldeia Indu\'le‡Поиски в деревне Инду\'ле‡Durchsucht Indu\'le‡인두르 마을 수색‡Busca por el Poblado Indu\'le‡Busca por el Poblado Indu\'le‡Fouillez Indu\'le‡搜索因度雷村‡搜索因度雷村',
    nil,
    'Procure o comandante das tropas de caça-magos na Aldeia Indu\'le e no Lago Indu\'le.‡Поищите командующего силами охотников на магов в деревне Инду\'ле и озере Инду\'ле.‡Sucht in Indu\'le und im Wasser von Indu\'le nach dem Kommandanten der Magierjägertruppen.‡인두르 마을과 인두르 호수에서 마법사 사냥꾼 부대의 지휘관을 찾아야 합니다.‡Busca al comandante de las fuerzas de cazadores de magos en el Poblado Indu\'le y en el Lago Indu\'le.‡Busca al comandante de las fuerzas de cazadores de magos en el Poblado Indu\'le y en el Lago Indu\'le.‡Cherchez le commandant des forces des chasseurs de mages à Indu\'le et au Lac Indu\'le.‡在因度雷村和因度雷湖寻找法师猎手部队的指挥官。‡調查因度雷村中狩法獵人部隊的指揮官，以及因度雷湖。',
  }
},
[12107] = {
  {
    'O fim da linha‡Конец цепочки‡Endstation‡지맥의 끝‡El final de la línea‡El final de la línea‡Le bout de la ligne‡魔网能量线的终端‡地脈的盡頭',
    nil,
    'Use o Talismã de Controle do Foco da Linha do Meridiano para conseguir informações do Foco da Linha do Meridiano sob o Lago Indu\'le. Então, siga na direção leste para o Santuário Dragônico Lazúli, perto da parte centro-sul do Ermo das Serpes, e, do parapeito ocidental, observe o que está acontecendo lá.|n|nDepois, fale novamente com a Imagem da Arquimaga Modera, no Recanto das Estrelas.‡Используйте талисман управления средоточием силовых линий, чтобы получить сведения о средоточии силовых линий под озером Инду\'ле. Затем отправляйтесь на восток, к Лазуритовому святилищу драконов, расположенному почти в центре южного Драконьего Погоста, и с западного уступа понаблюдайте за тем, что там происходит.|n|nПосле этого вернитесь к проекции верховного мага Модеры в Покое Звезд.‡Benutzt den Steuerungstalisman des Leylinienfokus, um Informationen vom Leylinienfokus unter dem Wasser von Indu\'le zu erhalten. Geht anschließend nach Osten zum Azurdrachenschrein, der sich vom Zentrum der Drachenöde aus gesehen weiter südlich befindet, und beobachtet das dortige Vorgehen vom westlichen Felsvorsprung aus.|n|nKehrt danach zum Abbild der Erzmagierin Modera in Sternenruh zurück.‡먼저 지맥 집중점 제어 부적을 사용해 인두르 호수 물속의 지맥 집중점 정보를 수집하고, 청금석 용제단의 서쪽 절벽으로 가서 용제단에서 무슨 일이 벌어지는지 정찰해야 합니다. 청금석 용제단은 용의 안식처 남부의 중앙쯤에 있습니다.|n|n일을 모두 마치면 별의 쉼터에 있는 대마법사 모데라의 환영에게 돌아가야 합니다.‡Utiliza el talismán de control de foco de línea Ley para obtener información del foco de línea Ley bajo el Lago Indu\'le. Después, dirígete al este hasta el Santuario de Dragones Azur cerca del sur central del Cementerio de Dragones y observa lo que está ocurriendo desde el extremo oeste.|n|nLuego, vuelve junto a la imagen de la archimaga Modera en Reposo Estelar.‡Utiliza el talismán de control de foco de línea Ley para obtener información del foco de línea Ley bajo el Lago Indu\'le. Después, dirígete al este hasta el Santuario de Dragones Azur cerca del sur central del Cementerio de Dragones y observa lo que está ocurriendo desde el extremo oeste.|n|nLuego, vuelve junto a la imagen de la archimaga Modera en Reposo Estelar.‡Utilisez le Talisman de contrôle des lignes telluriques pour obtenir des informations du Focalisateur des lignes telluriques sous le Lac Indu\'le. Ensuite, allez vers l\'est au Sanctuaire draconique azur près du sud du centre de la Désolation des dragons et observez ce qu\'il s\'y passe depuis l\'escarpement ouest.|n|nQuand ce sera fait, retournez auprès de l\'Image de l\'archimage Modera au Repos des étoiles.‡使用魔网能量焦点控制饰品从因度雷湖底的魔网能量焦点处收集信息。然后往东抵达龙骨荒野中南部的碧蓝巨龙圣地，从圣地西侧展开调查。|n|n完成任务后返回群星之墓，向大法师茉德拉的影像复命。‡使用地脈節點控制咒符，從因度雷湖底下的地脈節點中取得你所需的資訊。接下來往東前去蒼藍龍殿，就在龍骨荒野中央偏南的地方，從西邊的岩架調查發生了什麼事情。|n|n最後，返回繁星之眠大法師莫德菈的影像之處。',
  }
},
[12108] = {
  {
    'DEPRECATED‡ИСКЛЮЧЕНО‡Mikhails Grab‡미사용‡DEPRECATED‡DEPRECATED‡PÉRIMÉ‡DEPRECATED‡DEPRECATED',
    nil,
    'Bring Mikhail\'s Note to Cartographer Tobias at Amberpine Lodge.‡Принесите дневник Михаила картограферу Тобиасу в Приют Янтарной Сосны.‡Bringt Mikhails Notiz zum Kartografen Tobias bei der Ammertannhütte.‡미크헤일의 쪽지를 호박빛소나무 오두막에 있는 지도제작자 토비아스에게 가져가야 합니다.‡Llévale la nota de Mikhail al Cartógrafo Tobias en el Refugio Pino Ámbar.‡Llévale la nota de Mikhail al Cartógrafo Tobias en el Refugio Pino Ámbar.‡Remettez la Note de Mikhail au Cartographe Tobias au Gîte Ambrepin.‡Bring Mikhail\'s Note to Cartographer Tobias at Amberpine Lodge.‡把米克哈爾的短箋交給琥珀松小屋的製圖師圖比亞斯。',
  }
},
[12109] = {
  {
    'Apresente-se a Miguel Mantoforte... de novo‡И снова к Гриану Камнегриву...‡Meldet Euch bei Gryan Starkmantel... schon wieder‡다시 그라이언 스타우트맨틀에게 보고‡Informa a Gryan Mantorrecio... otra vez‡Informa a Gryan Mantorrecio... otra vez‡Aller voir Gryan Roidemantel… une fois de plus‡再次向格里安·斯托曼报到‡向格里安·斯托曼報到…又來了',
    nil,
    'Fale com o Capitão Miguel Mantoforte no Acampamento da Brigada de Cerro Oeste.‡Поговорите с капитаном Грианом Камнегривом в Лагере дружины Западного Края.‡Sprecht mit Hauptmann Gryan Starkmantel im Lager der Westfallbrigade.‡서부 몰락지대 여단 야영지에 있는 대장 그라이언 스타우트맨틀과 이야기해야 합니다.‡Habla con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Habla con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Parlez au Capitaine Gryan Roidemantel au Campement de la brigade de la marche de l\'Ouest.‡与月溪旅营地的格里安·斯托曼谈一谈。‡和西荒兵團駐營的格里安·斯托曼交談。',
  }
},
[12110] = {
  {
    'O fim da linha‡Конец цепочки‡Endstation‡지맥의 끝‡El final de la línea‡El final de la línea‡Le bout de la ligne‡魔网能量线的终端‡地脈的盡頭',
    nil,
    'Use o Talismã de Controle do Foco da Linha do Meridiano para conseguir informações do Foco da Linha do Meridiano sob o Lago Indu\'le. Então, siga na direção leste para o Santuário Dragônico Lazúli, perto da parte centro-sul do Ermo das Serpes, e observe o que está acontecendo lá, do parapeito ocidental.|n|nDepois, fale novamente com a Imagem do Arquimago Aethas Fendessol, no Martelo de Agmar.‡Используйте талисман управления средоточием силовых линий, чтобы получить сведения о средоточии силовых линий на дне озера Инду\'ле. Затем отправляйтесь на восток, к Лазуритовому святилищу драконов, расположенному почти в центре южного Драконьего Погоста, и с западного уступа понаблюдайте за тем, что там происходит.|n|nПосле этого вернитесь к проекции верховного мага Этаса Похитителя Солнца в Молоте Агмара.‡Benutzt den Steuerungstalisman des Leylinienfokus, um Informationen vom Leylinienfokus unter dem Wasser von Indu\'le zu erhalten. Geht anschließend nach Osten zum Azurdrachenschrein, der sich vom Zentrum der Drachenöde aus gesehen weiter südlich befindet, und beobachtet das dortige Vorgehen vom westlichen Felsvorsprung aus.|n|nKehrt danach zum Abbild des Erzmagiers Aethas Sonnenhäscher in Agmars Hammer zurück.‡먼저 지맥 집중점 제어 부적을 사용해 인두르 호수 물속의 지맥 집중점 정보를 수집하고, 청금석 용제단의 서쪽 절벽으로 가서 용제단에서 무슨 일이 벌어지는지 정찰해야 합니다. 청금석 용제단은 용의 안식처 남부의 중앙쯤에 있습니다.|n|n일을 모두 마치면 아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영에게 돌아가야 합니다.‡Utiliza el talismán de control de foco de línea Ley para obtener información del foco de línea Ley bajo el Lago Indu\'le. Después, dirígete al este hasta el Santuario de Dragones Azur cerca del sur central del Cementerio de Dragones y observa lo que está ocurriendo desde el extremo oeste.|n|nLuego, vuelve junto a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Utiliza el talismán de control de foco de línea Ley para obtener información del foco de línea Ley bajo el Lago Indu\'le. Después, dirígete al este hasta el Santuario de Dragones Azur cerca del sur central del Cementerio de Dragones y observa lo que está ocurriendo desde el extremo oeste.|n|nLuego, vuelve junto a la imagen del archimago Aethas Atracasol en Martillo de Agmar.‡Utilisez le Talisman de contrôle des lignes telluriques pour obtenir des informations du Focalisateur des lignes telluriques sous le Lac Indu\'le. Ensuite, allez vers l\'est au Sanctuaire draconique azur près du sud du centre de la Désolation des dragons et observez ce qu\'il s\'y passe depuis l\'escarpement ouest.|n|nQuand ce sera fait, retournez auprès de l\'Image de l\'archimage Aethas Saccage-soleil au Marteau d\'Agmar.‡使用魔网能量焦点控制饰品从因度雷湖底的魔网能量焦点处收集信息。然后向东走，前往龙骨荒野中南部区域的碧蓝巨龙圣地，在那里的西侧进行调查。|n|n完成调查之后，回到龙骨荒野的阿格玛之锤，向大法师艾萨斯·夺日者的影像复命。‡使用地脈節點控制咒符，從因度雷湖底下的地脈節點中取得你所需的資訊。接下來往東前去蒼藍龍殿，就在龍骨荒野中央偏南的地方，從西側的岩架觀察發生了什麼事情。|n|n最後，返回阿格瑪之錘的大法師埃薩·奪日者的影像之處。',
  }
},
[12111] = {
  {
    'Onde moram os bichos selvagens‡Где бродят дикие звери‡Wo die wilden Tiere wohnen‡야생동물이 거니는 곳‡Donde vagan las cosas salvajes‡Donde vagan las cosas salvajes‡Là où les monstres rôdent‡野生动物的疫苗‡野生物遊蕩之地',
    nil,
    'Pairante Fúria da Águia, no Martelo de Agmar, no Ermo das Serpes, quer que você use o Pacote de Vacinas para vacinar 5 Cervos Nevados e 5 Ursos Árticos.‡Используйте суму с вакцинами, чтобы привить 5 снегопадных лосей и 5 полярных гризли по просьбе Соара Ярости Ястреба из Молота Агмара в Драконьем Погосте.‡Soar Falkenzorn in Agmars Hammer in der Drachenöde möchte, dass Ihr mithilfe der Packung mit Impfstoffen 5 Schneewehenelche und 5 arktische Grizzlys impft.‡용의 안식처에 있는 아그마르의 망치의 소어 호크퓨리가 예방약 꾸러미를 사용해 눈사태 숲 사슴 5마리와 북극 회색곰 5마리에게 예방 접종을 해달라고 부탁했습니다.‡Soar Furia de Halcón en Martillo de Agmar en el Cementerio de Dragones quiere que uses el paquete de vacunas para vacunar a 5 alces de avalancha y a 5 pardos árticos.‡Soar Furia de Halcón en Martillo de Agmar en el Cementerio de Dragones quiere que uses el paquete de vacunas para vacunar a 5 alces de avalancha y a 5 pardos árticos.‡Essor Fureur-du-faucon au Marteau d\'Agmar dans la Désolation des dragons veut que vous utilisiez le Paquet de vaccins pour vacciner 5 Orignaux de Tombeneige et 5 Grizzlys arctiques.‡龙骨荒野阿格玛之锤的索艾·鹰怒要你使用疫苗包为5头雪落麋鹿和5头极地灰熊接种疫苗。‡阿格瑪之錘的梭爾·鷹怒需要你對5頭落雪麋鹿和5頭寒地灰熊使用疫苗包裹。',
  }
},
[12112] = {
  {
    'Negociações rígidas‡Деловые отношения‡Erstarrte Verhandlungen‡경직된 협상‡Negociaciones difíciles‡Negociaciones difíciles‡Des négociations difficiles‡艰难的沟通‡艱難的交涉',
    nil,
    'Encontre Zort no centro da Fenda Cristalina, a nordeste do Posto Ferrugem.‡Найдите Зорта в центре ущелья порочных кристаллов, к северо-востоку от Лагеря Соплозабилось.‡Geht zum Zentrum der Kristallschlucht und sucht Zort auf.‡녹주둥이 전초기지 북동쪽에 있는 수정 계곡의 중심에서 조르트를 찾아야 합니다.‡Encuentra a Zort en el centro del Vicio de Cristal al noreste del Puesto Boquilla Oxidada.‡Encuentra a Zort en el centro del Vicio de Cristal al noreste del Puesto Boquilla Oxidada.‡Trouver Zort au centre de l\'Étau de cristal, au nord-est du Poste de Rouilletuyère.‡前往诺兹拉斯哨站的东北方，在水晶裂痕中部找到佐特。‡找到人在水晶之鉗中心的佐特，在鏽鼻崗哨的東北邊。',
  }
},
[12113] = {
  {
    'A marvada carne‡Здравствуй, мяско!‡Ohne Fleisch kein Preis‡반가운 인사‡Encantado de carnecerte‡Encantado de carnecerte‡Vous aimez la viande des Grisonnes ?‡等肉下锅‡很高興認識你……的肉!',
    nil,
    'Harkor, no Acampamento do Harkor, quer que você colete 10 peças de Carne Fibrosa de Worg dos Predadores Uivo da Noite, e 10 Bifes de Hastepás dos Ruminantes Cascolongo.‡Харкор из Лагеря Харкора просит вас принести 10 кусков жилистого мяса ворга, которые можно добыть, поохотившись на хищников Ночного Воя, и 10 стейков из черпоклыка. Их можно вырезать из туш травоядных веслорогов.‡Harkor in Harkors Lager möchte, dass Ihr 10 Stück feinfasriges Worgfleisch von den streunenden Grauheulern und 10 Schaufelhornsteaks von den Langhufgrasfressern beschafft.‡하코르의 야영지에 있는 하코르가 그늘울음 늑대에게서 섬유질이 많은 검은늑대 고기 10개, 긴발굽 뾰족엄니에게서 뾰족엄니 스테이크 10개를 구해달라고 부탁했습니다.‡Harkor en el Campamento de Harkor quiere que consigas 10 trozos de carne fibrosa de huargo de los merodeadores aúllaocaso y 10 filetes de cornopala de los pastadores pezuña larga.‡Harkor en el Campamento de Harkor quiere que consigas 10 trozos de carne fibrosa de huargo de los merodeadores aúllaocaso y 10 filetes de cornopala de los pastadores pezuña larga.‡Harkor, du Camp de Harkor, veut que vous collectiez 10 morceaux de Viande de worg fibreuse sur des Rôdeurs Hurlesoir et 10 Steaks de cornepelle sur des Ruminants long-sabot.‡哈考尔营地的哈考尔希望你能帮他从暗嚎徘徊者身上收集10块多汁的座狼肉，从厚蹄食草鹿身上收集10块铲角肉排。‡哈克爾營地的哈克爾需要你從暮嚎徘徊者身上收集10塊多筋座狼肉，以及長蹄牧者身上收集10塊鍬角排。',
  }
},
[12114] = {
  {
    'Terapia‡Анти-стрессовая терапия‡Therapie‡기분 전환‡Terapia‡Terapia‡Thérapie‡心灵的创伤‡復仇療法',
    nil,
    'Harkor, no Acampamento do Harkor, quer que você mate 10 Protetores Drakkari e 10 Oráculos Drakkari do lado de fora das Ruínas de Drakil\'jin.‡Харкор из Лагеря Харкора просит вас убить 10 заступников Драккари и 10 оракулов Драккари возле Руин Дракил\'джин.‡Harkor in Harkors Lager möchte, dass Ihr 10 Drakkaribeschützer und 10 Drakkariorakel außerhalb der Ruinen von Drakil\'jin tötet.‡하코르의 야영지에 있는 하코르가 드라킬진 폐허 밖에 있는 드라카리 수호병 10명과 드라카리 현자 10명을 처치해 달라고 부탁했습니다.‡Harkor en el Campamento de Harkor quiere que mates a 10 protectores Drakkari y a 10 oráculos Drakkari fuera de las Ruinas de Drakil\'jin.‡Harkor en el Campamento de Harkor quiere que mates a 10 protectores Drakkari y a 10 oráculos Drakkari fuera de las Ruinas de Drakil\'jin.‡Harkor, du Camp de Harkor, veut que vous tuiez 10 Protecteurs drakkari et 10 Oracles drakkari à l’extérieur des Ruines de Drakil’jin.‡哈考尔营地的哈考尔要你在达基尔金废墟外面杀死10个达卡莱保卫者和10个达卡莱先知。‡哈克爾營地的哈克爾要你去德拉齊金遺跡外，殺10名德拉克瑞保衛者和10名德拉克瑞神諭者。',
  }
},
[12115] = {
  {
    'Koltirus e a linguagem da morte‡Кольтира и язык смерти‡Koltira und die Sprache des Todes‡콜티라와 죽음의 언어‡Koltira y el idioma de la muerte‡Koltira y el idioma de la muerte‡Koltira et le langage de la mort‡库尔迪拉和亡者之语‡寇爾提拉與死亡的語言',
    nil,
    'Leve o Tomo Encadernado com Carne para Koltirus Tecemorte.‡Отнесите сшитый плотью фолиант Кольтире Ткачу Смерти.‡Bringt den fleischgebundenen Folianten zu Koltira Todesweber.‡살점달린 고서를 콜티라 데스위버에게 가져가야 합니다.‡Llévale el escrito encuadernado en carne a Koltira Tejemuerte.‡Llévale el escrito encuadernado en carne a Koltira Tejemuerte.‡Apportez le Tome relié de chair à Koltira Tissemort.‡将血之魔典交给库尔迪拉·织亡者。‡將鑲肉骨書交給寇爾提拉·亡織者。',
  }
},
[12116] = {
  {
    'Das tripas coração‡Только смелым покоряются...‡Man braucht schon einen starken Magen...‡용기가 필요한 일‡Requiere agallas…‡Requiere agallas…‡Il faut des tripes…‡孤胆英雄……‡膽子要大…',
    nil,
    'Kraz, no Acampamento do Harkor, quer que você entre nas Ruínas de Drakil\'jin e colete 5 Vasos Canópicos Drakkari.‡Краз из Лагеря Харкора просит вас войти в Руины Дракил\'джина и собрать 5 каноп Драккари.‡Kraz in Harkors Lager möchte, dass Ihr Euch in die Ruinen von Drakil\'jin begebt und 5 Drakkarikanopen einsammelt.‡하코르의 야영지에 있는 크라즈가 드라킬진 폐허에 들어가 드라카리 유골 단지 5개를 구해달라고 부탁했습니다.‡Kraz en Campamento de Harkor quiere que entres en las Ruinas de Drakil\'jin y recojas 5 vasos canopes Drakkari.‡Kraz en Campamento de Harkor quiere que entres en las Ruinas de Drakil\'jin y recojas 5 vasos canopes Drakkari.‡Kraz, du Camp de Harkor, veut que vous entriez dans les Ruines de Drakil’jin pour y récupérer 5 Vases canopes drakkari.‡哈考尔营地的克拉斯要你进入达基尔金废墟，收集5只达卡莱之罐。‡哈克爾營地的卡拉茲要你進入德拉齊金遺跡，並收集5罐德拉克瑞臟器罈。',
  }
},
[12117] = {
  {
    'Viagem para Porto Moa\'ki‡Путешествие в гавань Моа\'ки‡Reist zum Hafen Moa\'ki‡모아키 항구로 이동‡Viaja hasta el Puerto Moa\'ki‡Viaja hasta el Puerto Moa\'ki‡En route pour Moa\'ki‡前往莫亚基港口‡前往默亞基港',
    nil,
    'Vá até Porto Moa\'ki no Ermo das Serpes e fale com o Ancião Ko\'nani.‡Отправляйтесь в гавань Моа\'ки на Драконий Погост и поговорите со старейшиной Ко\'нани.‡Reist zum Hafen Moa\'ki in der Drachenöde und sprecht mit dem Ältesten Ko\'nani.‡용의 안식처에 있는 모아키 항구로 이동한 다음 장로 코나니와 대화해야 합니다.‡Viaja hasta el Puerto Moa\'ki en el Cementerio de Dragones y habla con el ancestro Ko\'nani.‡Viaja hasta el Puerto Moa\'ki en el Cementerio de Dragones y habla con el ancestro Ko\'nani.‡Rendez-vous à Port-Moa’ki, dans la Désolation des dragons, et parlez au Chef Ko’nani.‡前往龙骨荒野的莫亚基港口，与长者库纳尼谈一谈。‡前往龍骨荒野的默亞基港，並與長者科納尼交談。',
  }
},
[12118] = {
  {
    'Viagem para Porto Moa\'ki‡Путешествие в гавань Моа\'ки‡Reist zum Hafen Moa\'ki‡모아키 항구로 이동‡Viaja hasta el Puerto Moa\'ki‡Viaja hasta el Puerto Moa\'ki‡En route pour Moa\'ki‡前往莫亚基港口‡前往默亞基港',
    nil,
    'Vá até Porto Moa\'ki no Ermo das Serpes e fale com o Ancião Ko\'nani.‡Отправляйтесь в гавань Моа\'ки на Драконий Погост и поговорите со старейшиной Ко\'нани.‡Reist zum Hafen Moa\'ki in der Drachenöde und sprecht mit Häuptling Ko\'nani.‡용의 안식처에 있는 모아키 항구로 이동해 장로 코나니와 대화해야 합니다.‡Viaja hasta el Puerto Moa\'ki en el Cementerio de Dragones y habla con el ancestro Ko\'nani.‡Viaja hasta el Puerto Moa\'ki en el Cementerio de Dragones y habla con el ancestro Ko\'nani.‡Rendez-vous à Port-Moa’ki, dans la Désolation des dragons, et parlez au Chef Ko’nani.‡前往龙骨荒野的莫亚基港口，与长者库纳尼谈一谈。‡前往龍骨荒野的默亞基港，並與長者科納尼交談。',
  }
},
[12119] = {
  {
    'Requerimento de audiência‡Добиться аудиенции‡Eine Audienz erhalten‡알현 준비‡Conseguir una audiencia‡Conseguir una audiencia‡Obtenir une audience‡拜见巨龙女王‡等候謁見',
    nil,
    'Entregue sua Carta de Apresentação ao Templo do Repouso das Serpes para Tariolstrasz, no Templo do Repouso das Serpes.‡Вручите свое приглашение Тариолстразу в храме Драконьего Покоя.‡Geht zum Wyrmruhtempel und liefert das Vorstellungsschreiben bei Tariolstrasz ab.‡고룡쉼터 사원에 있는 타리올스트라즈에게 소개장을 가져가야 합니다.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Tariolstrasz en el Templo del Reposo del Dragón.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Tariolstrasz en el Templo del Reposo del Dragón.‡Apportez votre Lettre d\'introduction à Tariolstrasz au Temple du Repos du ver.‡前往龙眠神殿，将这封给龙眠神殿的介绍信交给塔里奥斯塔兹。‡將介紹信送交到龍眠神殿的泰瑞歐斯塔茲手上。',
  }
},
[12120] = {
  {
    'A marreta de Drag\'akaal‡Молот Драк\'агуула‡Schlaghammer von Drak\'aguul‡드락아굴의 철퇴‡La marra de Drak\'aguul‡La marra de Drak\'aguul‡La massette de Drak\'aguul‡达卡古尔之槌‡德拉克古歐的木槌',
    nil,
    'Kraz, no Acampamento do Harkor, quer que você mate Drag\'akaal do lado de fora das Ruínas de Drakil\'jin e volte com a Marreta Drakil\'jin.‡Краз из Лагеря Харкора просит вас убить Драк\'агуула возле Руин Дракил\'джин и принести ему Дракил\'джинский молот.‡Kraz in Harkors Lager möchte, dass Ihr Drak\'aguul außerhalb der Ruinen von Drakil\'jin tötet und mit dem Schlaghammer von Drakil\'jin zurückkehrt.‡하코르의 야영지에 있는 크라즈가 드라킬진 폐허 밖에 있는 드락아굴을 처치한 다음 드라킬진 철퇴를 가지고 돌아와 달라고 부탁했습니다.‡Kraz en el Campamento de Harkor quiere que mates a Drak\'aguul a las afueras de las Ruinas de Drakil\'jin y vuelvas con la marra de Drakil\'jin.‡Kraz en el Campamento de Harkor quiere que mates a Drak\'aguul a las afueras de las Ruinas de Drakil\'jin y vuelvas con la marra de Drakil\'jin.‡Kraz, du Camp de Harkor, veut que vous tuiez Drak’aguul, à l’extérieur des Ruines de Drakil’jin. Lorsque ce sera fait, retournez le voir avec la Massette de Drakil’jin.‡哈考尔营地的克拉斯希望你去杀死达基尔金废墟外的达卡古尔，然后把达基尔金之槌交给他。‡哈克爾營地的克拉茲要你殺死德拉齊金遺跡外頭的德拉克古歐，然後帶著德拉其金木槌回來。',
  }
},
[12121] = {
  {
    'A gente se vê no aquém do além‡Увидимся в другом мире‡Wir sehen uns auf der anderen Seite wieder‡생의 저편에서‡Te veo al otro lado‡Te veo al otro lado‡On se revoit de l\'autre côté‡死后相见‡另一頭見',
    nil,
    'Kraz, no Acampamento do Harkor, quer que você use a Marreta Drakil\'jin nos gongos do lado de fora das Ruínas de Drakil\'jin. Uma vez assassinado, entre nas ruínas e fale com o espírito de Gan\'jo enquanto estiver morto.‡Краз из Лагеря Харкора просит вас ударить Дракил\'джинским молотом в гонги, окружающие Руины Дракил\'джин. После этого вас, скорее всего, убьют, и тогда вы сможете войти в руины, чтобы поговорить с Ган\'джо из мира мертвых.‡Kraz in Harkors Lager möchte, dass Ihr den Schlaghammer von Drakil\'jin auf die Gongs außerhalb der Ruinen von Drakil\'jin anwendet. Ihr sollt die Ruinen betreten, sobald Ihr erschlagen wurdet, und mit dem Geist von Gan\'jo sprechen, solange Ihr tot seid.‡하코르의 야영지에 있는 크라즈가 드라킬진 폐허 밖에 있는 징에 드라킬진 철퇴를 사용해 달라고 부탁했습니다. 죽은 다음에는 영혼 상태로 폐허에 들어가 간조의 영혼과 대화해야 합니다.‡Kraz en Campamento de Harkor quiere que uses la marra de Drakil\'jin en los gongs a las afueras de las Ruinas de Drakil\'jin. Cuando te hayan matado, deberás entrar a las ruinas y hablar con el espíritu de Gan\'jo mientras estés muerto.‡Kraz en Campamento de Harkor quiere que uses la marra de Drakil\'jin en los gongs a las afueras de las Ruinas de Drakil\'jin. Cuando te hayan matado, deberás entrar a las ruinas y hablar con el espíritu de Gan\'jo mientras estés muerto.‡Kraz, du Camp de Harkor, veut que vous utilisiez la Massette de Drakil’jin sur les gongs qui se trouvent à l’extérieur des Ruines de Drakil’jin. Lorsque vous aurez été tué, vous devrez entrer dans les ruines et parler à l’esprit de Gan’jo.‡哈考尔营地的克拉斯希望你使用达基尔金之槌敲响达基尔金废墟外的锣。等你被杀死以后，以灵魂形态进入废墟，与甘休的灵魂交谈。‡哈克爾營地的卡拉茲要你用德拉齊金木槌敲響德拉齊金遺跡外面的銅鑼。等到你被殺死後，就能夠進入遺跡並且與剛裘的靈魂交談。',
  }
},
[12122] = {
  {
    'Requerimento de audiência‡Добиться аудиенции‡Eine Audienz erhalten‡알현 준비‡Conseguir una audiencia‡Conseguir una audiencia‡Obtenir une audience‡拜见巨龙女王‡等候謁見',
    nil,
    'Entregue sua Carta de Apresentação ao Templo do Repouso das Serpes para Tariolstrasz, no Templo do Repouso das Serpes.‡Вручите свое приглашение в храм Драконьего Покоя Тариолстразу в храме Драконьего Покоя.‡Geht zum Wyrmruhtempel und liefert das Vorstellungsschreiben bei Tariolstrasz ab.‡고룡쉼터 사원에 있는 타리올스트라즈에게 소개장을 가져가야 합니다.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Tariolstrasz en el Templo del Reposo del Dragón.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Tariolstrasz en el Templo del Reposo del Dragón.‡Apportez votre Lettre d\'introduction à Tariolstrasz au Temple du Repos du ver.‡前往龙眠神殿，将这封给龙眠神殿的介绍信交给塔里奥斯塔兹。‡將介紹信送交到龍眠神殿的泰瑞歐斯塔茲手上。',
  }
},
[12123] = {
  {
    'Informando a rainha‡Информация для королевы‡Die Königin verständigen‡여왕 알현‡Informar a la reina‡Informar a la reina‡Informer la Reine‡通知女王‡警告龍后',
    nil,
    'Entregue sua Carta de Apresentação ao Templo do Repouso das Serpes a Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes.‡Вручите свое приглашение Алекстразе Хранительнице Жизни в храме Драконьего Покоя.‡Liefert Euer Vorstellungsschreiben bei Alexstrasza der Lebensbinderin im Wyrmruhtempel ab.‡고룡쉼터 사원에 있는 생명의 어머니 알렉스트라자에게 소개장을 가져가야 합니다.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Apportez votre Lettre d\'introduction à Alexstrasza la Lieuse-de-vie au Temple du Repos du ver.‡前往龙眠神殿，将这封给龙眠神殿的介绍信交给阿莱克丝塔萨，生命的缚誓者。‡將介紹信送交到龍眠神殿的『生命守縛者』龍后雅立史卓莎手上。',
  }
},
[12124] = {
  {
    'Informando a rainha‡Информация для королевы‡Die Königin verständigen‡여왕 알현‡Informar a la reina‡Informar a la reina‡Informer la Reine‡通知女王‡警告龍后',
    nil,
    'Entregue sua Carta de Apresentação ao Templo do Repouso das Serpes a Alexstrasza, a Mãe da Vida, no Templo do Repouso das Serpes.‡Вручите свое приглашение в храм Драконьего Покоя Алекстразе Хранительнице Жизни в храме Драконьего Покоя.‡Liefert Euer Vorstellungsschreiben bei Alexstrasza der Lebensbinderin im Wyrmruhtempel ab.‡고룡쉼터 사원에 있는 생명의 어머니 알렉스트라자에게 소개장을 가져가야 합니다.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Entrega tu carta de presentación para el Templo del Reposo del Dragón a Alexstrasza la Protectora en el Templo del Reposo del Dragón.‡Apportez votre Lettre d\'introduction à Alexstrasza la Lieuse-de-vie au Temple du Repos du ver.‡前往龙眠神殿，将这封给龙眠神殿的介绍信交给阿莱克丝塔萨，生命的缚誓者。‡將介紹信送交到龍眠神殿的『生命守縛者』龍后雅立史卓莎手上。',
  }
},
[12125] = {
  {
    'A serviço do sangue‡Ради крови‡Im Dienste des Blutes‡혈기의 힘을 위하여‡Al servicio de la sangre‡Al servicio de la sangre‡Au service du sang‡邪能之约‡為血魄效力',
    nil,
    'Koltirus Tecemorte, no Martelo de Agmar, no Ermo das Serpes, quer que você use a Gema Sangrenta em um Aldeão Indu\'le Demente. Se apresente novamente a ele com uma Gema Sangrenta Preenchida.‡По просьбе Кольтиры Ткача Смерти воздействуйте кровавым самоцветом на спятившего селянина Инду\'ле, а затем возвращайтесь к Кольтире в Молот Агмара на Драконьем Погосте с наполненным кровавым самоцветом.‡Koltira Todesweber in Agmars Hammer in der Drachenöde möchte, dass Ihr die Blutgemme auf die verstörten Bewohner von Indu\'le anwendet und sie gefüllt wieder zu ihm zurückbringt.‡광기어린 인두르 주민에게 혈기 보석을 사용하여 충만한 혈기 보석을 만든 다음, 용의 안식처의 아그마르의 망치에 있는 콜티라 데스위버에게 가져가야 합니다.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema de sangre sobre un habitante de Indu\'le trastornado y vuelvas con una gema de sangre llena.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema de sangre sobre un habitante de Indu\'le trastornado y vuelvas con una gema de sangre llena.‡Koltira Tissemort, au Marteau d\'Agmar à la Désolation des dragons, veut que vous utilisiez la Gemme sanguine sur un Villageois d\'Indu\'le dérangé et que vous lui rapportiez une Gemme sanguine remplie.‡龙骨荒野阿格玛之锤的库尔迪拉·织亡者要求你在一名疯狂的因度雷村民身上使用能量宝石，然后将充能的能量宝石还给他。‡阿格瑪之錘的寇爾提拉·亡織者要你對發狂的因度雷村民使用血魄寶石，然後帶著充盈的血魄寶石向他回報。',
  }
},
[12126] = {
  {
    'A serviço do profano‡На службе нечестивости‡Im Dienste des Unheiligen‡부정의 힘을 위하여‡Al servicio de lo profano‡Al servicio de lo profano‡Au service de l\'impie‡邪恶之约‡為穢邪效力',
    nil,
    'Koltirus Tecemorte, no Martelo de Agmar, no Ermo das Serpes, quer que você use a Gema Profana no Duque Vallenhal e se apresente novamente a Koltirus Tecemorte com uma Gema Profana Preenchida.‡Используйте нечестивый самоцвет против герцога Валленхола и вернитесь с наполненным нечестивым самоцветом к Кольтире Ткачу Смерти в Молот Агмара на Драконий Погост.‡Koltira Todesweber in Agmars Hammer in der Drachenöde möchte, dass Ihr die unheilige Gemme auf Fürst Vallenhal anwendet und sie gefüllt wieder zu ihm zurückbringt.‡공작 발렌할에게 부정한 보석을 사용하여 충만한 부정의 보석으로 만든 다음, 용의 안식처에 있는 아그마르의 망치의 콜티라 데스위버에게 가져가야 합니다.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema profana sobre el duque Vallenhal y vuelvas con una gema profana llena.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema profana sobre el duque Vallenhal y vuelvas con una gema profana llena.‡Koltira Tissemort, au Marteau d\'Agmar à la Désolation des dragons, veut que vous utilisiez la Gemme impie sur le Duc Vallenhal et que vous lui rapportiez une Gemme impie remplie.‡龙骨荒野阿格玛之锤的库尔迪拉·织亡者要求你对瓦伦哈尔公爵使用邪恶宝石，然后将充能的邪恶宝石还给他。‡阿格瑪之錘的寇爾提拉·亡織者要你對瓦倫赫公爵使用穢邪寶石，然後將充盈的穢邪寶石交還給他。',
  }
},
[12127] = {
  {
    'A serviço do gelo‡На службе у мороза‡Im Dienste des Frosts‡서리의 힘을 위하여‡Al servicio de la escarcha‡Al servicio de la escarcha‡Au service du givre‡冰霜之约‡為冰霜效力',
    nil,
    'Koltirus Tecemorte, no Martelo de Agmar, no Ermo das Serpes, quer que você use a Gema Gélida nos Elementais Vingativos Gélidos e se apresente novamente a ele com uma Gema Gélida Preenchida.‡Используйте ледяной самоцвет против загробников льда и вернитесь к Кольтире Ткачу Смерти в Молот Агмара на Драконий Погост с наполненным ледяным самоцветом.‡Koltira Todesweber in Agmars Hammer in der Drachenöde möchte, dass Ihr die Frostgemme auf die Eisklagegeister anwendet und sie gefüllt zu ihm zurückbringt.‡얼음 망령에게 서리 보석을 사용하여 충만한 서리 보석으로 만든 다음, 용의 안식처에 있는 아그마르의 망치의 콜티라 데스위버에게 가져가야 합니다.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema de escarcha con aparecidos de hielo y vuelvas con la gema de escarcha llena.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que uses la gema de escarcha con aparecidos de hielo y vuelvas con la gema de escarcha llena.‡Koltira Tissemort, au Marteau d\'Agmar à la Désolation des dragons, veut que vous utilisiez la Gemme de givre sur des Revenants des glaces et que vous lui rapportiez une Gemme de givre remplie.‡龙骨荒野阿格玛之锤的库尔迪拉·织亡者要求你对冰雪亡魂使用冰霜宝石，然后将充能的冰霜宝石还给他。‡阿格瑪之錘的寇爾提拉·亡織者要你對冰冷亡魄使用冰霜寶石，然後帶著充盈的冰霜寶石回去給他。',
  }
},
[12128] = {
  {
    'Conferindo a situação de Raegar‡Как дела у Регара?‡Seht mal nach Raegar‡레가르의 안부‡Visita a Raegar‡Visita a Raegar‡Prendre des nouvelles de Raegar‡找到莱加尔‡與瑞加爾聯繫',
    nil,
    'Fale com Raegar Quebracelha no Mirante do Minerador.‡Поговорите с Регаром Бровебоем в Лагере горняков.‡Sprecht mit Raegar Brechbraue im Prospektorat.‡발굴단 거점에 있는 레가르 브레이크브로우와 대화해야 합니다.‡Habla con Raegar Rompecejas en el Altozano del Prospector.‡Habla con Raegar Rompecejas en el Altozano del Prospector.‡Parlez à Raegar Cassefront à la Pointe du Prospecteur.‡与勘探员哨站的莱加尔·断眉谈一谈。‡與勘察員崗哨的瑞加爾·斷眉交談。',
  }
},
[12129] = {
  {
    'O plano perfeito‡Безукоризненный замысел‡Der perfekte Plan‡완벽한 계획‡El plan perfecto‡El plan perfecto‡Le plan parfait‡完美的计划‡完美的設計圖',
    nil,
    'Traga o Diagrama do Golem de Guerra completo para Raegar Quebracelha no Mirante do Minerador.‡Принесите полный набор чертежей боевого голема Регару Бровебою в Лагерь горняков.‡Bringt Raegar Brechbraue im Prospektorat die kompletten Blaupausen für einen Kriegsgolem.‡완성된 전쟁 골렘 설계도를 발굴단 거점에 있는 레가르 브레이크브로우에게 가져가야 합니다.‡Llévale el plano de gólem de guerra completo a Raegar Rompecejas en Altozano del Prospector.‡Llévale el plano de gólem de guerra completo a Raegar Rompecejas en Altozano del Prospector.‡Remettez les Plans du golem de guerre complétés à Raegar Cassefront à la Pointe du Prospecteur.‡将一份完整的作战魔像蓝图交给勘探员哨站的莱加尔·断眉。‡把完整的戰爭魔像藍圖交給勘察員崗哨的瑞加爾·斷眉。',
  }
},
[12130] = {
  {
    'Para que fabricar se você pode confiscar?‡Зачем ковать то, что можно отобрать?‡Lieber requirieren als produzieren‡슬쩍하면 되는데 왜 만들어?‡¿Por qué fabricarlo cuando puedes apropiártelo?‡¿Por qué fabricarlo cuando puedes apropiártelo?‡Pourquoi fabriquer ce que vous pouvez faucher ?‡抢夺零件‡可以盜用的時候為什麼要動手製造?',
    nil,
    'Traga 8 Peças de Golem de Guerra para Raegar Quebracelha no Mirante do Minerador.‡Принесите 8 частей боевого голема Регару Бровебою в Лагерь горняков.‡Bringt 8 Teile eines Kriegsgolems zu Raegar Brechbraue im Prospektorat.‡전쟁 골렘 부품 8개를 발굴단 거점에 있는 레가르 브레이크브로우에게 가져가야 합니다.‡Llévale 8 piezas de gólem de guerra a Raegar Rompecejas en el Altozano del Prospector.‡Llévale 8 piezas de gólem de guerra a Raegar Rompecejas en el Altozano del Prospector.‡Raegar Cassefront, de la Pointe du Prospecteur, veut 8 Pièces de golem de guerre‡将8份作战魔像零件交给勘探员哨站的莱加尔·断眉。‡把8個戰爭魔像零件交給勘察員崗哨的瑞加爾·斷眉。',
  }
},
[12131] = {
  {
    'Nós temos a força‡Нам нужна энергия‡Wir haben die Macht‡우리에겐 전력이 있다!‡Tenemos el poder...‡Tenemos el poder...‡Nous avons l\'énergie…‡我们有能源‡我們要能量',
    nil,
    'Traga a Pilha de Durar e a Pilha de Kathorn para Raegar Quebracelha no Mirante do Minerador.‡Принесите энергобатареи Дурара и Каторна Регару Бровебою в Лагерь горняков.‡Bringt Durars Energiezelle und Kathorns Energiezelle zu Raegar Brechbraue im Prospektorat.‡발굴단 거점에 있는 레가르 브레이크브로우에게 듀라르의 전지와 카손의 전지를 가져가야 합니다.‡Llévale la célula de energía de Durar y la célula de energía de Kathorn a Raegar Rompecejas en el Altozano del Prospector.‡Llévale la célula de energía de Durar y la célula de energía de Kathorn a Raegar Rompecejas en el Altozano del Prospector.‡Remettez la Cellule énergétique de Durar et la Cellule énergétique de Kathorn à Raegar Cassefront, à la Pointe du Prospecteur.‡将杜拉尔的能量晶格和卡索恩的能量晶格交给勘探员哨站的莱加尔·断眉。‡把杜拉爾的能量電池和卡索恩的能量電池交給勘察員崗哨的瑞加爾·斷眉。',
  }
},
[12132] = {
  {
    'O poder de destruir‡Сила разрушения‡Die Macht zu Zerstören...‡파괴해야 할 힘‡El poder para destruir‡El poder para destruir‡Le pouvoir de détruire‡毁灭的力量‡毀滅之力',
    nil,
    'Koltirus Tecemorte, no Martelo de Agmar, que fica no Ermo das Serpes, quer que você entre no mundo das sombras e derrote 6 Atormentadores Sombrios.|n|nFale com Koltirus Tecemorte se precisar entrar novamente no reino das sombras.‡По просьбе Кольтиры Ткача Смерти из Молота Агмара, что на Драконьем Погосте, войдите в мир теней и сразите 6 мрачных мучителей.|n|nЕсли вам нужно будет еще раз войти в мир теней, обратитесь к Кольтире.‡Koltira Todesweber in Agmars Hammer in der Drachenöde möchte, dass Ihr die Welt der Schatten betretet und 6 schattenhafte Peiniger besiegt.|n|nSprecht mit Koltira Todesweber, solltet Ihr die Welt der Schatten wieder betreten müssen.‡용의 안식처에 있는 아그마르의 망치의 콜티라 데스위버가 어둠의 세계로 들어가 어둠의 심문관 6명을 처치해 달라고 부탁했습니다.|n|n어둠의 세계에 다시 들어가려면 콜티라 데스위버와 대화해야 합니다.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que entres en el mundo de las sombras y derrotes a 6 torturadores enigmáticos.|n|nHabla con Koltira Tejemuerte si necesitas volver a entrar en el mundo de las sombras.‡Koltira Tejemuerte en Martillo de Agmar en el Cementerio de Dragones quiere que entres en el mundo de las sombras y derrotes a 6 torturadores enigmáticos.|n|nHabla con Koltira Tejemuerte si necesitas volver a entrar en el mundo de las sombras.‡Koltira Tissemort, au Marteau d\'Agmar à la Désolation des dragons, veut que vous entriez dans le Monde des ombres et que vous tuiez 6 Tourmenteurs ténébreux.|n|nParlez à Koltira Tissemort si vous avez besoin de retourner dans le monde des ombres.‡阿格玛之锤的库尔迪拉·织亡者要求你进入阴影界并击败6名暗影折磨者。|n|n如果需要再次进入阴影界，就去找库尔迪拉·织亡者帮忙。‡龍骨荒野上，阿格瑪之錘的寇爾提拉·亡織者需要你進入暗影世界，擊敗6隻幽暗折磨者。|n|n如果你需要再次進入暗影世界，和寇爾提拉·亡織者交談。',
  }
},
[12133] = {
  {
    'Esmague a abóbora‡Разбей тыкву!‡Zermatsch den Kürbis‡호박 깨뜨리기‡Aplasta la calabaza‡Aplasta la calabaza‡Ecraser la citrouille‡击碎南瓜‡砸碎南瓜',
    nil,
    'Dê o Símbolo Sagrado Chamuscado para a Matriarca Fantasiada.‡Отдайте опаленный священный символ переодетой попечительнице сирот.‡Bring das versengte, heilige Symbol zur kostümierten Waisenmatrone.‡축제 의상을 입은 보육원 원장님에게 불타버린 신성한 징표를 가져가야 합니다.‡Dale el símbolo sagrado chamuscado a la supervisora de huérfanos disfrazada.‡Dale el símbolo sagrado chamuscado a la supervisora de huérfanos disfrazada.‡Donnez le Symbole sacré brûlé à la Directrice d\'orphelinat costumée.‡将烧焦的神圣符记交给穿戏服的孤儿院长。‡將燒焦的聖徽交給變裝的孤兒監護員。',
  }
},
[12134] = {
  {
    'A caçada de Sasha‡Саша выходит на охоту‡Sashas Jagd‡사샤의 사냥‡La caza de Sasha‡La caza de Sasha‡Sasha chasse‡萨莎的狩猎‡莎夏的狩獵',
    nil,
    'Sasha quer que você mate 12 Caçadores do Solstício na Aldeia Solstício.‡Саша просит вас убить 12 охотников солнцестояния в Деревне Солнцестояния.‡Sasha möchte, dass Ihr nach Julheim geht und dort 12 Jäger von Julheim tötet.‡사샤가 극지 마을에 있는 극지 사냥꾼 12마리를 처치해 달라고 부탁했습니다.‡Sasha quiere que mates a 12 cazadores del solsticio en el Poblado Solsticio.‡Sasha quiere que mates a 12 cazadores del solsticio en el Poblado Solsticio.‡Sasha veut que vous tuiez 12 Chasseurs de Solstice à Solstice.‡萨莎要求你在冬至村中击败12名冬至村猎人。‡莎夏要你去季至村殺死12個季至獵人。',
  }
},
[12135] = {
  {
    '"Que venha o fogo!"‡"И гори все огнем!"‡"Lasset die Feuer kommen!"‡곧 불길이 닥치리니!‡"¡Dejad que el fuego se acerque!"‡"¡Dejen que el fuego se acerque!"‡« Que viennent les flammes ! »‡"放火过来吧！"‡「讓火焰來吧!」',
    nil,
    'A Matriarca Fantasiada quer que você ajude a apagar os focos de incêndio na vila assim que o Cavaleiro Sem Cabeça atear fogo. Quando acabar, fale novamente com a Matriarca Fantasiada.‡Переодетая попечительница сирот просит вас помочь потушить пожар в деревне, если ее подожжет Всадник без головы. Когда пожар будет потушен, снова поговорите с попечительницей сирот.‡Die kostümierte Matrone bittet um Eure Hilfe. Sie möchte, dass Ihr alle Feuer im Dorf löscht, nachdem der kopflose Reiter diese entzündet hat. Sprecht noch einmal mit der kostümierten Matrone, sobald alle Feuer erloschen sind.‡축제 의상을 입은 보육원 원장님이 저주받은 기사 때문에 마을에 발생한 화재를 진압해 달라고 부탁했습니다. 불이 꺼지면 축제 의상을 입은 보육원 원장님과 대화해야 합니다.‡La supervisora de huérfanos disfrazada quiere que ayudes a apagar todos los incendios de la ciudad que provoque el Jinete decapitado. Cuando termines, vuelve a hablar con ella.‡La supervisora de huérfanos disfrazada quiere que ayudes a apagar todos los incendios de la ciudad que provoque el Jinete decapitado. Cuando termines, vuelve a hablar con ella.‡La Directrice de l\'orphelinat costumée veut que vous l\'aidiez à éteindre les incendies du village quand le Cavalier sans tête les aura allumés. Quand ils seront éteints, retournez la voir.‡穿戏服的孤儿院长希望你在无头骑士发动攻击时帮忙扑灭村子里的所有火焰。完成任务后与穿戏服的孤儿院长谈一谈。‡變裝的孤兒監護員希望你在無頭騎士縱火之後，幫助撲滅村莊中的火勢。等火完全撲滅之後，再和變裝的孤兒監護員交談。',
  }
},
[12136] = {
  {
    'O tomo traduzido‡Переведенная книга‡Der übersetzte Foliant‡해독된 고서‡El escrito traducido‡El escrito traducido‡Le tome traduit‡翻译过的魔典‡譯妥的骨書',
    nil,
    'Leve o Tomo Encadernado com Carne Traduzido para o Capitão Gort, no Martelo de Agmar.‡Доставьте переведенный сшитый плотью фолиант капитану Горту в Молот Агмара.‡Liefert den übersetzten fleischgebundenen Folianten bei Hauptmann Gort in Agmars Hammer ab.‡해독된 살점달린 고서를 아그마르의 망치에 있는 경비대장 고르트에게 전달해야 합니다.‡Entrega el escrito encuadernado en carne traducido al capitán Gort en Martillo de Agmar.‡Entrega el escrito encuadernado en carne traducido al capitán Gort en Martillo de Agmar.‡Remettre le Tome relié de chair traduit au Capitaine Gort au Marteau d\'Agmar.‡将翻译过的血之魔典交给阿格玛之锤的高尔特上尉。‡將翻譯過的鑲肉骨書帶給阿格瑪之錘的苟爾特隊長。',
  }
},
[12137] = {
  {
    'Fica frio, camarada‡Остынь, чудо!‡Ganz ruhig, Mann‡마음의 안식‡Relá\'hatee, coleega‡Relá\'hatee, coleega‡Relax, mec‡冷静一下，伙计‡老兄，冷靜點',
    nil,
    'Gan\'jo quer que você colete a Neve do Sono Eterno no baú nas Ruínas de Drakil\'jin.|n|nVocê então deverá usar a Neve nos Antigos Espíritos Drakkari de lá e levar as Partículas Espirituais Drakkari de volta a Kraz no Acampamento do Harkor.‡Ган\'джо просит вас собрать снег вечного сна из его сундука в руинах Дракил\'джин.|n|nИм надо окропить древних духов Драккари и отнести крупицы духов Драккари Кразу в Лагерь Харкора.‡Gan\'jo möchte, dass Ihr den Schnee des ewigen Schlafes von seiner Kiste in den Ruinen von Drakil\'jin nehmt.|n|nIhr müsst den Schnee bei den dortigen uralten Drakkarigeistern einsetzen und anschließend die Partikel der Drakkarigeister zurück zu Kraz in Harkors Lager bringen.‡간조가 드라킬진 폐허에 있는 그의 궤짝에서 영면의 눈을 얻으라고 부탁했습니다.|n|n눈을 고대 드라카리 영혼에게 사용한 다음, 드라카리 영혼 조각을 하코르의 야영지에 있는 크라즈에게 가져가야 합니다.‡Gan\'jo quiere que recojas la nieve de sueño eterno de su cofre en las Ruinas de Drakil\'jin.|n|nDeberás usar la nieve sobre los antiguos espíritus Drakkari allí y llevar sus partículas de espíritus Drakkari a Kraz en Campamento de Harkor.‡Gan\'jo quiere que recojas la nieve de sueño eterno de su cofre en las Ruinas de Drakil\'jin.|n|nDeberás usar la nieve sobre los antiguos espíritus Drakkari allí y llevar sus partículas de espíritus Drakkari a Kraz en Campamento de Harkor.‡Gan’jo veut que vous récupériez de la Neige de léthargie éternelle dans son coffre, dans les Ruines de Drakil\'jin.|n|nVous devrez ensuite utiliser la Neige sur les Anciens esprits drakkari des ruines, et rapporter leurs Particules spirituelles drakkari à Kraz, au Camp de Harkor.‡甘休希望你能从他在达基尔金废墟的箱子里拿到永恒休眠之雪。|n|n对那里的上古阿卡莱幽魂使用永恒休眠之雪，然后把它们的达卡莱灵魂微粒交给哈考尔营地的克拉斯。‡剛裘需要你到德拉齊金遺跡裡，從他的箱子中收集永眠之雪。|n|n對上古德拉克瑞之靈上使用雪花，將德拉克瑞靈魂粒子帶給哈克爾營地的卡拉茲。',
  }
},
[12138] = {
  {
    '... Ou talvez a gente não tenha‡... а может быть, и нет‡... oder vielleicht auch nicht‡... 아니, 없을지도 모른다‡... O quizás no‡... O quizás no‡… ou peut-être pas, après tout‡……我们没有能源‡…也許還沒好',
    nil,
    'Carregue seu Golem de Guerra com a energia de 10 Sentinelas Relâmpago e fale novamente com Raegar Quebracelha no Mirante do Minerador.‡Подзарядите вашего Боевого голема от десяти грозовых караульных и вернитесь к Регару Бровебою в Лагерь горняков.‡Ladet Euren Kriegsgolem mit der Energie von 10 Blitzwachen auf und kehrt anschließend zu Raegar Brechbraue im Prospektorat zurück.‡전쟁 골렘에게 번개 파수꾼 10마리의 힘을 충전한 다음 발굴단 거점에 있는 레가르 브레이크브로우에게 돌아가야 합니다.‡Carga tu gólem de guerra con la energía de 10 avizores de relámpagos y regresa junto a Raegar Rompecejas en Altozano del Prospector.‡Carga tu gólem de guerra con la energía de 10 avizores de relámpagos y regresa junto a Raegar Rompecejas en Altozano del Prospector.‡Chargez votre Golem de guerre avec l’énergie de 10 Factionnaires de foudre, puis retournez voir Raegar Cassefront à la Pointe du Prospecteur.‡利用10个闪电斥候为你的作战魔像充能，然后将充能完毕的作战魔像交给勘探员哨站的莱加尔·断眉。‡從10個閃電哨兵上替你的戰爭魔像充能，然後向勘察員崗哨的瑞加爾·斷眉回報。',
  }
},
[12139] = {
  {
    '"Que venha o fogo!"‡"И гори все огнем!"‡"Lasset die Feuer kommen!"‡"오라, 불길이여!"‡"¡Dejad que el fuego se acerque!"‡"¡Dejen que el fuego se acerque!"‡« Que viennent les flammes ! »‡"放火过来吧！"‡「讓火焰來吧!」',
    nil,
    'A Matriarca Mascarada quer que você ajude a apagar os incêndios da vila. Quando acabar, fale novamente com a Matriarca Mascarada na cidade.‡Попечительница сирот в маске просит вас помочь потушить пожар в деревне. Когда пожар потухнет, снова поговорите с попечительницей сирот в маске в городе.‡Die maskierte Matrone bittet um Eure Hilfe. Sie möchte, dass Ihr alle Feuer im Dorf löscht. Sprecht noch einmal mit der maskierten Matrone, sobald alle Feuer erloschen sind.‡가면 쓴 보육원 원장님이 마을에 발생한 화재를 진압해 달라고 부탁했습니다. 불이 꺼지면 가면 쓴 보육원 원장님과 대화해야 합니다.‡La supervisora de huérfanos enmascarada quiere que ayudes a apagar todos los incendios en las ciudades. Cuando estén apagados, vuelve a hablar con ella.‡La supervisora de huérfanos enmascarada quiere que ayudes a apagar todos los incendios en las ciudades. Cuando estén apagados, vuelve a hablar con ella.‡La Directrice d\'orphelinat masquée veut que vous l\'aidiez à éteindre les incendies du village. Quand ils seront éteints, retournez la voir.‡戴面具的孤儿院长希望你在无头骑士发动攻击时帮忙扑灭村子里的所有火焰。完成任务后与戴面具的孤儿院长谈一谈。‡戴面具的孤兒監護員要你幫忙撲滅村莊中的火勢。等火完全撲滅之後，再和鎮上的戴面具的孤兒監護員交談。',
  }
},
[12140] = {
  {
    'Salve Roanauk!‡Славься, Роанук!‡Ein Hoch auf Roanauk!‡로아나우크를 맞이하라!‡¡Viva Roanauk!‡¡Viva Roanauk!‡Gloire à Roanauk !‡洛纳乌克万岁！‡全體向隆諾克致敬!',
    nil,
    'Procure por Roanauk Bruma Boreal no Martelo de Agmar, e oficie sua iniciação como membro e líder das tropas da Horda.|n|nFale novamente com o Lorde Supremo Agmar com o Juramento de Sangue da Horda quando você completar a missão.‡Найдите Роанука Ледяную Пыль в Молоте Агмара, примите его в лоно Орды и посвятите его в вожди сил Орды.|n|nКогда ритуал будет завершен, вернитесь к командиру Агмару с клятвой крови Орды.‡Geht nach Agmars Hammer, sucht Roanauk Eisnebel auf und macht ihn zu einem Mitglied und Anführer der Hordestreitkräfte.|n|nKehrt anschließend mit dem Blutschwur der Horde zu Oberanführer Agmar zurück, sobald Ihr diese Aufgabe abgeschlossen habt.‡아그마르의 망치에서 로아나우크 아이스미스트를 찾아 그를 호드 군대의 일원으로 받아들이고 지도자로 임명해야 합니다.|n|n임무를 마친 다음 호드 연합 피의 맹세를 대군주 아그마르에게 돌려줘야 합니다.‡Busca a Roanauk Bruma de Hielo en Martillo de Agmar e iníciale como miembro y líder de las fuerzas de la Horda.|n|nVuelve junto al señor supremo Agmar con el juramento de sangre de la Horda cuando completes esta misión.|n‡Busca a Roanauk Bruma de Hielo en Martillo de Agmar e iníciale como miembro y líder de las fuerzas de la Horda.|n|nVuelve junto al señor supremo Agmar con el juramento de sangre de la Horda cuando completes esta misión.|n‡Allez trouver Roanauk Brume-glace au Marteau d\'Agmar et initiez-le à son rôle de membre et de chef des forces de la Horde.|n|nRetournez voir le Suzerain Agmar avec le Serment de sang de la Horde lorsque vous aurez terminé cette tâche.‡在阿格玛之锤找到洛纳乌克·冰雾，并引导他加入部落，成为部落的领袖之一。|n|n完成任务之后带着部落的血誓向阿格玛大王复命。‡在阿格瑪之錘找到隆諾克·冰霧，並讓他以坦卡牛頭人領袖的身份加入部落。|n|n當你完成任務之後，帶著部落的血誓回去找霸主阿格瑪。',
  }
},
[12141] = {
  {
    'Uma missão diplomática‡Дипломатическое поручение‡Eine diplomatische Mission‡외교 임무‡Una misión diplomática‡Una misión diplomática‡Une mission diplomatique‡外交任务‡外交任務',
    nil,
    'Fale com Karuk, no Areal Quebramar, sudoeste da Bastilha Valentia.‡Поговорите с Каруком на берегу Терзающего Бича, к юго-западу от крепости Отваги.‡Sprecht mit Karuk am Strand der Peitschennarbe südwestlich der Valianzfeste.‡용맹의 성채 남서쪽에 있는 채찍파도 해안에서 카루크와 대화해야 합니다.‡Habla con Karuk en el Litoral Tralladón, al suroeste de la Fortaleza Denuedo.‡Habla con Karuk en el Litoral Tralladón, al suroeste de la Fortaleza Denuedo.‡Parlez à Karuk sur la Grève des Courcinglants, au sud-ouest du donjon de la Bravoure.‡前往无畏要塞西南方的裂鞭海岸，与卡鲁克谈一谈。‡與卡魯克交談，他就在驍勇要塞西南方的裂鞭水岸。',
  }
},
[12142] = {
  {
    'Controle de Pragas‡Контроль над чумой‡Seuchenkontrolle‡성가신 녀석들‡Control de plagas‡Control de plagas‡Contrôle des nuisibles‡害虫控制‡害蟲控管',
    nil,
    'Dúnio, do Front da 7ª Legião, quer que você mate 10 Nevolds da Planície Nevada e 3 Magnatauros do Ermo das Serpes, nos acampamentos de magnatauros ao redor do Templo do Repouso das Serpes.‡По заданию Дуана с передовой 7-го легиона убейте 10 снобольдов Снежных равнин и 3 магнатавров Драконьего Погоста в лагерях магнатавров, окружающих Драконий Покой.‡Duane bei der Front der 7. Legion möchte, dass Ihr 10 Schneebolde der Schneeebene und 3 Magnatauren der Drachenöde in den Lagern um den Wyrmruhtempel herum tötet.‡고룡쉼터 사원을 둘러싼 마그나타우르 야영지에서 눈평원 스노볼트 10마리, 용의 안식처 마그나타우르 3마리를 처치하고, 7군단 전초지에 있는 듀안에게 돌아가야 합니다.‡Duane en el Frente de la Séptima Legión quiere que mates a 10 snóbolds Llano Nevado y a 3 magnatauros del Cementerio de Dragones en los campos de magnatauros que rodean Reposo del Dragón.‡Duane en el Frente de la Séptima Legión quiere que mates a 10 snóbolds Llano Nevado y a 3 magnatauros del Cementerio de Dragones en los campos de magnatauros que rodean Reposo del Dragón.‡Duane au Front de la 7e Légion vous demande de tuer 10 Frigbolds plaineige et 3 Magnataures de la Désolation des dragons dans les camps de magnataures près du Repos du ver.‡第七军团前线的杜埃尼希望你前往龙眠神殿周围的猛犸人营地，消灭10个冰原雪地狗头人和3个龙骨荒野猛犸人。‡第七軍團前線的杜安要求你，到龍眠神殿周圍的猛瑪象人營地殺死10隻雪原極地狗頭人和3隻龍骨荒野猛瑪象人。',
  }
},
[12143] = {
  {
    'Perseguição no desfiladeiro‡Преследование в каньоне‡Jagd durch die Schluchten‡협곡의 추격전‡Persecución por el cañón‡Persecución por el cañón‡Course-poursuite dans le canyon‡峡谷追击‡峽谷追擊戰',
    nil,
    'Dúnio quer que você persiga os nevolds pelo desfiladeiro a nordeste do Front da 7ª Legião, e que você dê um jeito no líder deles.‡Дуан просит вас идти по следу снобольдов по каньону к северо-востоку от передовой 7-го легиона и разобраться с их вожаком.‡Duane möchte, dass Ihr die Schneebolde im Canyon nordöstlich der Front der 7. Legion verfolgt und Euch anschließend um deren Anführer kümmert.‡7군단 전초지의 북동쪽 협곡으로 스노볼트를 쫓아가 그 우두머리를 처치한 후 듀안에게 돌아가야 합니다.‡Duane quiere que persigas a los snóbolds por el cañón al noreste del Frente de la Séptima Legión y que acabes con su líder.‡Duane quiere que persigas a los snóbolds por el cañón al noreste del Frente de la Séptima Legión y que acabes con su líder.‡Duane veut que vous poursuiviez les Frigbolds dans le canyon au nord-est du Front de la 7e légion et que vous vous occupiez de leur chef.‡杜埃尼希望你在第七军团前线东北方向的峡谷中找到雪地狗头人的踪迹，并干掉它们的领袖。‡第七軍團前線的杜安要求你，沿著第七軍團前線東北方的峽谷追擊極地狗頭人，並且處理掉他們的領導者。',
  }
},
[12144] = {
  {
    'Controle de pragas‡Заразу – под контроль!‡Seuchenkontrolle‡성가신 녀석들‡Control de plagas‡Control de plagas‡Contrôle des nuisibles‡害虫控制‡害蟲控管',
    nil,
    'Kontokanis, na Aldeia do Dragão Arruinado, quer que você mate 10 Nevolds da Planície Nevada e 3 Magnatauros do Ermo das Serpes, nos acampamentos de magnatauros ao redor do Templo do Repouso das Serpes.‡Убейте 10 снобольдов Снежных равнин и 3 магнатавров Драконьего Погоста в лагерях магнатавров, расположенных к юго-востоку от Драконьего Покоя. Выполнив задачу, вернитесь к Контоканису в Драконьей Погибели в северо-западных Драконьих пустошах.‡Kontokanis in Drachensturz möchte, dass Ihr 10 Schneebolde der Schneeebene und 3 Magnatauren der Drachenöde in den Lagern um den Wyrmruhtempel herum tötet.‡고룡쉼터 사원을 둘러싼 마그나타우르 야영지에서 눈평원 스노볼트 10마리, 용의 안식처 마그나타우르 3마리를 처치한 후, 용사냥 마루에 있는 콘토카니스에게 돌아가야 합니다.‡Kontokanis en Caída del Dragón quiere que mates a 10 discípulos Llano Nevado y a 3 magnatauros alfa en los campos de magnatauros que rodean Reposo del Dragón.‡Kontokanis en Caída del Dragón quiere que mates a 10 discípulos Llano Nevado y a 3 magnatauros alfa en los campos de magnatauros que rodean Reposo del Dragón.‡Kontokanis à la Chute du dragon vous a demandé de tuer 10 Frigbolds plaineige et 3 Magnataures dans les camps de magnataures près du Repos du ver.‡猎龙营地的肯图卡尼斯要你前往龙眠神殿周围的猛犸人营地，消灭10个冰原雪地狗头人和3个龙骨荒野猛犸人。‡龍殞營地的剛朵卡尼斯要求你，到龍眠神殿週遭的猛瑪象人營地殺死10隻雪原極地狗頭人和3隻龍骨荒野猛瑪象人。',
  }
},
[12145] = {
  {
    'Perseguição no desfiladeiro‡Преследование в каньоне‡Jagd durch die Schluchten‡협곡의 추격전‡Persecución por el cañón‡Persecución por el cañón‡Course-poursuite dans le canyon‡峡谷追击‡峽谷追擊戰',
    nil,
    'Kontokanis quer que você persiga os nevolds pelo desfiladeiro a sul da Aldeia do Dragão Arruinado, e que você dê um jeito no líder deles.‡По поручению Контоканиса преследуйте снобольдов по каньону к югу от Драконьего Зова и разберитесь с их вожаком.‡Kontokanis möchte, dass Ihr die Schneebolde in der Schlucht südlich von Drachensturz verfolgt und anschließend ihren Anführer beseitigt.‡용사냥 마루 남쪽에 있는 협곡으로 스노볼트를 쫓아가 그 우두머리를 처치한 후, 콘토카니스에게 돌아가야 합니다.‡Kontokanis quiere que persigas a los snóbolds por el cañón al sur de Caída del Dragón y que acabes con su líder.‡Kontokanis quiere que persigas a los snóbolds por el cañón al sur de Caída del Dragón y que acabes con su líder.‡Kontokanis veut que vous poursuiviez les frigbolds dans le canyon au sud de la Chute du dragon et que vous vous occupiez de leur chef.‡肯图卡尼斯希望你在猎龙营地以南的峡谷中找到雪地狗头人的踪迹，并干掉它们的领袖。‡剛朵卡尼斯要求你沿著龍殞營地南方的峽谷追擊極地狗頭人，並且殺掉他們的領袖。',
  }
},
[12146] = {
  {
    'Implicações perturbadoras‡Зловещие выводы‡Beunruhigende Hinweise‡불길한 암시‡Implicaciones inquietantes‡Implicaciones inquietantes‡Des implications troublantes‡奇怪的符号‡擾人的暗示',
    nil,
    'Leve a Corneta de Batalha Brasonada para o Templo do Repouso das Serpes e procure alguém interessado em avaliar a ameaça potencial.‡Отнесите расписанный боевой рог к Драконьему Покою и найдите того, кто захотел бы оценить исходящую от него угрозу.‡Bringt das geschmückte Kriegshorn zum Wyrmruhtempel und sucht dort nach jemandem, der die drohende Gefahr einschätzen kann.‡문장 장식된 전투 뿔피리를 고룡쉼터 사원으로 가져가, 잠재적인 위협에 관심이 있는 이를 찾아야 합니다.‡Lleva el cuerno de batalla blasonado hasta Reposo del Dragón y busca a alguien que pudiera estar interesado en evaluar el nivel potencial de amenaza.‡Lleva el cuerno de batalla blasonado hasta Reposo del Dragón y busca a alguien que pudiera estar interesado en evaluar el nivel potencial de amenaza.‡Apportez le Cor de bataille blasonné au Repos du ver et cherchez quelqu\'un qui voudrait évaluer la menace potentielle.‡带上精美的战斗号角前往龙眠神殿，看看那里有谁可以评估一下这潜在的威胁。‡帶著紋飾戰鬥號角前往龍眠神殿，找出能評估這個潛在威脅的人。',
  }
},
[12147] = {
  {
    'Implicações perturbadoras‡Зловещие выводы‡Beunruhigende Hinweise‡불길한 암시‡Implicaciones inquietantes‡Implicaciones inquietantes‡Des implications troublantes‡古怪的暗示‡擾人的暗示',
    nil,
    'Leve a Corneta de Batalha Brasonada para o Templo do Repouso das Serpes e procure alguém interessado em avaliar a ameaça potencial.‡Отнесите расписанный боевой рог к Драконьему Покою и найдите того, кто заинтересовался бы возможностью оценить потенциальную угрозу.‡Bringt das geschmückte Kriegshorn zum Wyrmruhtempel und sucht dort nach jemandem, der die drohende Gefahr einschätzen kann.‡문장 장식된 전투 뿔피리를 고룡쉼터 사원으로 가져가, 잠재적인 위협에 관심이 있는 이를 찾아야 합니다.‡Lleva el cuerno de batalla blasonado hasta Reposo del Dragón y busca a alguien que pudiera estar interesado en evaluar el nivel potencial de amenaza.‡Lleva el cuerno de batalla blasonado hasta Reposo del Dragón y busca a alguien que pudiera estar interesado en evaluar el nivel potencial de amenaza.‡Apportez le Cor de bataille blasonné au Repos du ver et cherchez quelqu\'un qui voudrait évaluer la menace potentielle.‡带上精美的战斗号角前往龙眠神殿，看看那里有谁可以评估一下这潜在的威胁。‡帶著紋飾戰鬥號角前往龍眠神殿，找出願意評估這個潛在威脅的人。',
  }
},
[12148] = {
  {
    'Um tipo único‡Единственный в своем роде‡Einzigartig‡증거를 찾아라‡Único‡Único‡Un spécimen unique‡集结的信号‡獨一無二',
    nil,
    'Encontre e mate Assolaosso no ou perto do desfiladeiro a noroeste do Santuário Dragônico Lazúli. Leve quaisquer provas que encontrar de volta a Aurastrasza no Templo do Repouso das Serpes.‡Найдите и убейте Расщепителя Костей в каньоне (или рядом с ним), находящемся к северо-западу от Лазуритового святилища драконов. Принесите найденное вами свидетельство Аурастразе в храм Драконьего Покоя.‡Findet und tötet Knochenkracher in der Nähe der Schlucht nordwestlich des Azurdrachenschreins. Bringt jegliche Informationen zurück zu Aurastrasza im Wyrmruhtempel.‡청금석 용제단 북서쪽 협곡이나 그 근처에서 해골도살자를 찾아 처치하고, 발견한 증거를 고룡쉼터 사원의 아우라스트라자에게 전해야 합니다.‡Encuentra y mata a Hiendehuesos cerca del cañón al noroeste del Santuario de Dragones Azur. Llévale cualquier prueba que encuentres a Aurastrasza en el Templo del Reposo del Dragón.‡Encuentra y mata a Hiendehuesos cerca del cañón al noroeste del Santuario de Dragones Azur. Llévale cualquier prueba que encuentres a Aurastrasza en el Templo del Reposo del Dragón.‡Trouvez et tuez Scinde-les-os dans le canyon au nord-ouest du Sanctuaire draconique azur ou aux alentours. Rapportez toute preuve que vous trouverez à Aurastrasza au temple du Repos du ver.‡在碧蓝巨龙圣地西北边的峡谷附近找到裂骨者，并杀死它。带着证据回去向龙眠神殿的奥拉斯塔萨复命。‡在蒼藍龍殿西北方的峽谷中，或峽谷附近找出骨裂，並且殺了牠。把你找到的任何證據帶回來給龍眠神殿的歐拉史卓莎。',
  }
},
[12149] = {
  {
    'O poderoso magnatauro‡Могучие магнатавры‡Die mächtigen Magnatauren‡마그나타우르의 힘‡Un poderoso magnatauro‡Un poderoso magnatauro‡Un magnataure puissant‡强大的猛犸人‡強悍的猛瑪象人',
    nil,
    'Cace e mate Sangrentauro, Quebra-Gelo e Gangredraco a leste do Repouso das Serpes.|n|nSangrentauro reside no canto sudeste dos Ermos Dragônicos, a norte do Santuário Dragônico Esmeralda. Quebra-Gelo patrulha o limite norte do Espelho da Aurora. Gangredraco vagueia no fundo dos penhascos a oeste do Santuário Dragônico Bronze.|n|nFale novamente com Aurastrasza no Repouso das Serpes quando os magnatauros forem abatidos.‡Выследите и убейте Кровавого Пира, Ледоскала и Дракрова к востоку от Драконьего Покоя.|n|nКровавый Пир обитает в юго-восточном углу Драконьих Пустошей, прямо к северу от изумрудного святилища драконов. Ледоскал патрулирует северную оконечность Зеркала Рассвета. Дракров бродит у подножья утесов к западу от бронзового святилища драконов.|n|nКогда все три магнатавра будут убиты, возвращайтесь к Аурастразе в Драконий Покой.‡Bringt Blutschmaus, Eisberster und Drachenblut, die sich östlich des Wyrmruhtempels befinden, zur Strecke.|n|nBlutschmaus wohnt im südöstlichen Bereich der Dracheneiswüste, gleich nördlich des Smaragddrachenschreins. Eisberster patrouilliert an der nördlichen Grenze des Spiegels der Morgenröte. Drachenblut wandert am Fuße der Klippen westlich des Bronzedrachenschreins umher.|n|nKehrt zu Aurastrasza im Wyrmruhtempel zurück, sobald Ihr die Magnatauren erschlagen habt.‡고룡쉼터 사원 동쪽에 있는 피발굽, 얼음파괴자, 비룡사냥꾼을 처치해야 합니다.|n|n피발굽은 용의 황무지의 남동쪽 모퉁이, 에메랄드 용제단 바로 위에 있습니다. 얼음파괴자는 새벽의 거울 북쪽 가장자리를 순찰합니다. 비룡사냥꾼은 청동 용제단 서쪽의 절벽 아래를 돌아다닙니다.|n|n임무를 마치면 고룡쉼터 사원의 아우라스트라자에게 돌아와야 합니다.‡Da caza y muerte a Sangría, Trizahielo y a Dracogor al este de Reposo del Dragón.|n|nSangría se encuentra en el rincón sureste del Baldío del Dragón, al norte del Santuario de Dragones Esmeralda. Trizahielo patrulla el extremo norte de El Espejo del Alba. Dracogor vaga por la parte inferior de los acantilados al oeste del Santuario de Dragones Bronce.|n|nVuelve junto a Aurastrasza en Reposo del Dragón cuando hayas matado a los magnatauros.‡Da caza y muerte a Sangría, Trizahielo y a Dracogor al este de Reposo del Dragón.|n|nSangría se encuentra en el rincón sureste del Baldío del Dragón, al norte del Santuario de Dragones Esmeralda. Trizahielo patrulla el extremo norte de El Espejo del Alba. Dracogor vaga por la parte inferior de los acantilados al oeste del Santuario de Dragones Bronce.|n|nVuelve junto a Aurastrasza en Reposo del Dragón cuando hayas matado a los magnatauros.‡Pourchassez et tuez Festin-de-sang, Briseglace et Drakentraille à l\'est du Repos du ver.|n|nFestin-de-sang réside au coin sud-est du Désert des Dragons, juste au nord du Sanctuaire draconique émeraude. Briseglace patrouille à l\'extrémité nord du Miroir de l\'aube. Drakentraille erre au pied des falaises à l\'ouest du Sanctuaire draconique bronze.|n|nRetournez voir Aurastrasza au Repos du ver lorsque vous aurez abattu les magnataures.‡在龙眠神殿以东找到并杀死食血者、破冰者和德拉古尔。|n|n食血者盘踞在巨龙废土的东南角，就在翡翠巨龙圣地北面。裂冰者控制着黎明之镜的北部边界。德拉古尔则在青铜巨龙圣地的西部峭壁下来回巡视。|n|n杀死这三个猛犸人后返回龙眠神殿，向奥拉斯塔萨复命。‡獵殺在龍眠神殿東方的血饗，冰碎，和龍牴。|n|n血饗位於龍墳荒原的東南角，就在翡翠龍殿的北邊。冰碎在黎明之鏡的北緣巡邏。龍牴在青銅龍殿西方的懸崖底下遊蕩。|n|n殺死這些猛瑪象人之後向龍眠神殿的歐拉史卓莎報告。',
  }
},
[12150] = {
  {
    'O recluso mestre de runas‡Мастер рун-затворник‡Der zurückgezogene Runenmeister‡은둔한 룬술사‡Un maestro de runas solitario‡Un maestro de runas solitario‡Un maître des runes reclus‡隐居的铭语师‡隱居的符文大師',
    nil,
    'Encontre Dregmar Marcarruna perto da caverna dele, que fica no caminho para os penhascos acima do Espelho da Aurora. Desafie-o e descubra o nome do líder dos magnatauros custe o que custar. Fale novamente com Aurastrasza, no Repouso das Serpes, quando conseguir alguma informação.‡Отыщите Дрегмара Рунического Знака неподалеку от его пещеры, на тропе, ведущей в утесы над Зеркалом Рассвета. Бросьте ему вызов и любой ценой узнайте имя повелителя магнатавров. Добыв нужные сведения, вернитесь к Аурастразе в Драконьем Покое.‡Sucht Dregmar Runenbrand auf. Er befindet sich in der Nähe seiner Höhle auf dem Weg zu den Klippen am Spiegel der Morgenröte. Fordert ihn heraus und tut, was notwendig ist, um den Namen des magnataurischen Anführers herauszufinden. Kehrt zu Aurastrasza im Wyrmruhtempel zurück, sobald Ihr die Information erhalten habt.‡새벽의 거울을 내려다보는 절벽에 있는 동굴 근처에서 드레그마르 룬브랜드를 찾아내, 그와 싸워 마그나타우르 지도자의 이름을 알아낸 다음 고룡쉼터 사원의 아우라스트라자에게 돌아가십시오.‡Encuentra a Dregmar Runarrama cerca de su cueva en la senda que dirige a los acantilados que dan a El Espejo del Alba. Desafíale y revela el nombre del líder magnatauro utilizando los medios necesarios. Vuelve junto a Aurastrasza en Reposo del Dragón cuando hayas obtenido la información.‡Encuentra a Dregmar Runarrama cerca de su cueva en la senda que dirige a los acantilados que dan a El Espejo del Alba. Desafíale y revela el nombre del líder magnatauro utilizando los medios necesarios. Vuelve junto a Aurastrasza en Reposo del Dragón cuando hayas obtenido la información.‡Localisez Dregmar Marquerune près de sa caverne sur la route des falaises surplombant le Miroir de l\'aube. Défiez-le et découvrez le nom du chef magnataure par tous les moyens nécessaires. Retournez auprès d\'Aurastrasza au Repos du ver lorsque vous aurez obtenu l\'information.‡登上俯瞰黎明之镜的悬崖，在德雷格玛尔·符印栖身的洞穴附近找到他。向他发起挑战，用尽一切办法逼他说出猛犸人领袖的名字。完成任务后返回龙眠神殿，向奥拉斯塔萨复命。‡找出德瑞格瑪·符標;在通往能俯瞰黎明之鏡懸崖的途中，有個道路旁邊的洞穴，他就在裡面。向他挑戰，使用一切手段問出猛瑪象人領袖的名字。獲得情報後向龍眠神殿的歐拉史卓莎回報。',
  }
},
[12151] = {
  {
    'Senhor sinistro‡Распоясавшийся полководец‡Rücksichtsloser Kriegsherr‡무자비한 지도자‡Un Señor de la Guerra atroz‡Un Señor de la Guerra atroz‡Un chef de guerre cruel‡暴虐的酋长‡跋扈的督軍',
    nil,
    'Vá até o círculo das tochas a sul do Santuário Dragônico Lazúli e toque a Corneta de Batalha Brasonada. Derrote Grom\'thar, o Arauto do Trovão, e leve a cabeça dele para Aurastrasza no Repouso das Serpes.‡Отправляйтесь к кругу факелов к югу от лазуритового святилища драконов и протрубите в расписанный боевой рог. Сразите Гром\'тара Громовержца и принесите его голову Аурастразе в Драконий Покой.‡Geht zum Fackelring südlich des Azurdrachenschreins und stoßt in das geschmückte Kriegshorn. Besiegt Grom\'thar den Donnerbringer und bringt seinen Kopf zurück zu Aurastrasza im Wyrmruhtempel.‡청금석 용제단 남쪽에 있는, 횃불로 이루어진 원 안에서 문장 장식된 전투 뿔피리를 불어야 합니다. 천둥의 인도자 그롬타르를 처치한 다음 그 증거를 고룡쉼터 사원에 있는 아우라스트라자에게 가져가십시오.‡Viaja hasta el anillo de antorchas al sur del Santuario de Dragones Azur y sopla el cuerno de batalla blasonado. Derrota a Grom\'thar el Portador del Trueno y llévale su cabeza a Aurastrasza en Reposo del Dragón.‡Viaja hasta el anillo de antorchas al sur del Santuario de Dragones Azur y sopla el cuerno de batalla blasonado. Derrota a Grom\'thar el Portador del Trueno y llévale su cabeza a Aurastrasza en Reposo del Dragón.‡Voyagez jusqu\'au cercle de torches au sud du Sanctuaire draconique azur et soufflez dans le Cor de bataille blasonné. Triomphez de Grom\'thar le Portefoudre et rapportez sa tête à Aurastrasza au Repos du ver.‡前往碧蓝巨龙圣地以南的火炬之环，吹响精美的战斗号角。击败雷霆使者戈洛塔尔，并将他的首级交给龙眠神殿的奥拉斯塔萨。‡前往蒼藍龍殿南方的火炬圈，然後吹響紋飾戰鬥號角。擊敗『雷霆使者』葛羅姆薩爾，然後把他的頭帶回去給龍眠神殿的歐拉史卓莎。',
  }
},
[12152] = {
  {
    'O fim de Jin\'arrak‡Погибель Джин\'аррака‡Jin\'arraks Ende‡진아라크의 최후‡El final de Jin\'arrak‡El final de Jin\'arrak‡La fin de Jin\'arrak‡金亚拉克的末日‡吉納拉克的末路',
    nil,
    'Kraz, no Acampamento do Harkor, quer que você colete a Oferenda Sagrada Drakkari nas Ruínas de Drakil\'jin e use o Pó Espiritual Drakkari nela. Use a Oferenda Drakkari Infundida nos gongos do lado de fora das Ruínas de Drakil\'jin.‡Краз из Лагеря Харкора просит вас найти cвященное подношение Драккари в руинах Дракил\'джина и осенить его пылью духов Драккари. После этого положите подношение к гонгам у руин Дракил\'джина.‡Kraz in Harkors Lager möchte, dass Ihr die heilige Drakkariopfergabe aus den Ruinen von Drakil\'jin holt und den Drakkariseelenstaub darauf benutzt. Benutzt die beseelte Drakkariopfergabe bei den Gongs außerhalb der Ruinen von Drakil\'jin.‡하코르의 야영지에 있는 크라즈가 드라킬진 폐허에서 성스러운 드라카리 공물을 구한 다음 거기에 드라카리 영혼 티끌을 사용해 달라고 부탁했습니다. 그런 다음 마력 깃든 드라카리 공물을 드라킬진 폐허 밖에 있는 징에 사용해야 합니다.‡Kraz en Campamento de Harkor quiere que recojas la ofrenda Drakkari sacra de las Ruinas de Drakil\'jin y eches el polvo de espíritus Drakkari sobre ella. Debes usar la ofrenda Drakkari imbuida con los gongs que hay a las afueras de las Ruinas de Drakil\'jin.‡Kraz en Campamento de Harkor quiere que recojas la ofrenda Drakkari sacra de las Ruinas de Drakil\'jin y eches el polvo de espíritus Drakkari sobre ella. Debes usar la ofrenda Drakkari imbuida con los gongs que hay a las afueras de las Ruinas de Drakil\'jin.‡Kraz, du Camp de Harkor, veut que vous récupériez l’Offrande sacrée drakkari dans les Ruines de Drakil’jin, et que vous lanciez la Poudre spirituelle drakkari dessus. Ensuite, utilisez l’Offrande drakkari infusée près des gongs, à l’extérieur des Ruines de Drakil’jin.‡哈考尔营地的克拉斯希望你从达基尔金废墟收集神圣达卡莱供品，然后将达卡莱灵魂之尘撒在上面。你必须在达基尔金废墟的锣处使用灌注能量的达卡莱供品。‡哈克爾營地的卡拉茲要你在德拉齊金遺跡裡面收集神聖德拉克瑞祭品，並且對其使用德拉克瑞靈魂之塵。你必須在哈克爾營地外的鑼使用注入能量的德拉克瑞祭品。',
  }
},
[12153] = {
  {
    'O thane de ferro e sua bigorna‡Тан и его Наковальня‡Der Eisenthan und sein Amboss‡무쇠 영주와 그의 경호원‡El señor feudal férreo y su Yunque‡El señor feudal férreo y su Yunque‡Le thane de fer et son Enclume‡铁领主和他的保镖‡鐵族長與他的鐵鉆',
    nil,
    'Use as habilidades do Golem de Guerra para derrotar o Thane de Ferro Furiamalho e em seguida fale novamente com Raegar Quebracelha no Mirante do Minerador.‡Воспользовавшись боевым големом, убейте тана Гневного Топора, после чего вернитесь к Регару Бровебою в Лагерь горняков.‡Setzt die Fähigkeiten Eures Kriegsgolems ein, besiegt den Eisenthan Zornhammer und kehrt dann zu Raegar Brechbraue im Prospektorat zurück.‡전쟁 골렘의 기술을 사용해 무쇠 영주 퓨리해머를 처치한 다음 발굴단 거점에 있는 레가르 브레이크브로우에게 돌아가야 합니다.‡Utilizando las facultades de tu gólem de guerra, derrota al señor feudal férreo Martillo Furioso y luego vuelve junto a Raegar Rompecejas en Altozano del Prospector.‡Utilizando las facultades de tu gólem de guerra, derrota al señor feudal férreo Martillo Furioso y luego vuelve junto a Raegar Rompecejas en Altozano del Prospector.‡Battez le Thane de fer Marteau-de-fureur grâce aux capacités de votre Golem de guerre. Ensuite, retournez voir Raegar Cassefront à la Pointe du Prospecteur.‡驾驶作战魔像击败铁领主弗雷哈默尔，然后返回勘探员哨站向莱加尔·断眉复命。‡利用戰爭魔像的能力，擊敗鐵族長怒錘，接著向勘察員崗哨的瑞加爾·斷眉回報。',
  }
},
[12154] = {
  {
    'Apagão‡Затмение‡Stromausfall‡정전‡Apagón‡Apagón‡La grande panne‡停电‡熄燈號',
    nil,
    'Use os Explosivos do Raegar para destruir o Núcleo Rúnico de Força em Dun Argol, e em seguida apresente-se a Raegar Quebracelha no Mirante do Minerador.‡Воспользуйтесь взрывчаткой Регара, чтобы уничтожить руническое силовое ядро в Дун Арголе. Доложите о своем успехе Регару Бровебою из Лагеря горняков.‡Benutzt Raegars Sprengstoff, um den Runenkraftkern in Dun Argol zu zerstören, und erstattet anschließen Bericht bei Raegar Brechbraue im Prospektorat.‡레가르의 폭발물을 사용해 던 아르골에 있는 던 아르골 동력핵을 파괴한 다음 발굴단 거점에 있는 레가르 브레이크브로우에게 보고해야 합니다.‡Utiliza los explosivos de Raegar para destruir la batería de runas de Dun Argol y luego ve a informar a Raegar Rompecejas en Altozano del Prospector.‡Utiliza los explosivos de Raegar para destruir la batería de runas de Dun Argol y luego ve a informar a Raegar Rompecejas en Altozano del Prospector.‡Servez-vous des Explosifs de Raegar pour détruire la Batterie runique à Dun Argol, puis allez faire votre rapport à Raegar Cassefront à la Pointe du Prospecteur.‡使用莱加尔的炸药摧毁丹厄古尔的符文能量核心，然后返回勘探员哨站向莱加尔·断眉复命。‡利用瑞加爾的爆裂物摧毀丹亞戈的符文能量核心，接著向勘察員崗哨的瑞加爾·斷眉回報。',
  }
},
[12155] = {
  {
    'Esmague a abóbora‡Разбей тыкву!‡Zermatsch den Kürbis‡호박 깨뜨리기‡Aplasta la calabaza‡Aplasta la calabaza‡Ecraser la citrouille‡击碎南瓜‡砸碎南瓜',
    nil,
    'Dê o Símbolo Sagrado Chamuscado para a Matriarca Mascarada.‡Отдайте опаленный священный символ попечительнице сирот в маске.‡Bring das versengte, heilige Symbol zur maskierten Waisenmatrone.‡가면 쓴 보육원 원장님에게 불타버린 신성한 징표를 가져가야 합니다.‡Dale el símbolo sagrado chamuscado a la supervisora de huérfanos enmascarada.‡Dale el símbolo sagrado chamuscado a la supervisora de huérfanos enmascarada.‡Donnez le Symbole sacré brûlé à la Directrice d\'orphelinat masquée.‡将烧焦的神圣符记交给戴面具的孤儿院长。‡將燒焦的聖徽交給戴面具的孤兒監護員。',
  }
},
[12156] = {
  {
    'DEPRECAED‡DEPRECAED‡ABGELEHNT‡미사용‡DEPRECATED‡DEPRECATED‡PÉRIMÉ‡DEPRECAED‡DEPRECAED',
    nil,
    'Escolte o Enviado da Aliança até a cidade do Arroio Prateado. Em seguida, apresente-se ao Tenente Dumont no Chalé do Pinho Âmbar.‡Сопроводите посланца Альянса в Среброречье. Выполнив это задание, вернитесь к лейтенанту Думонту в Приют Янтарной Сосны.‡Eskortiert den Gesandten der Allianz ins Dorf Silberwasser. Erstattet Leutnant Dumont bei der Ammertannhütte Bericht, sobald Ihr Eure Aufgabe abgeschlossen habt.‡얼라이언스 사절을 은빛시내 마을까지 호위해야 합니다. 임무를 완료하면 호박빛소나무 오두막에 있는 부관 듀몬트에게 보고하십시오.‡Escolta al enviado de la Alianza hasta la ciudad de Arroyoplata. Informa al teniente Dumont en Refugio Pino Ámbar cuando hayas completado esta tarea.‡Escolta al enviado de la Alianza hasta la ciudad de Arroyoplata. Informa al teniente Dumont en Refugio Pino Ámbar cuando hayas completado esta tarea.‡Escorter l’Envoyé de l’Alliance à Ruissargent. Lorsque ce sera fait, présentez-vous au lieutenant Dumont, au gîte Ambrepin.‡Escort the Alliance Envoy to the town of Silverbrook.  Report to Lieutenant Dumont at the Amberpine Lodge when you\'ve completed this task.‡護送聯盟特使前往銀溪鎮。任務完成以後，向琥珀松小屋的都蒙特中尉回報。',
  }
},
[12157] = {
  {
    'O mensageiro perdido‡Пропавший курьер‡Der vermisste Kurier‡사라진 급사‡El mensajero perdido‡El mensajero perdido‡Le messager perdu‡失踪的信使‡迷路的信差',
    nil,
    'Fale com o Mensageiro Lanson no Recanto das Estrelas, que fica no Ermo das Serpes.‡Поговорите с курьером Лансоном в Покое Звезд, что в Драконьем Погосте.‡Sprecht mit Kurier Lanson in Sternenruh in der Drachenöde.‡용의 안식처의 별의 쉼터에 있는 급사 랜슨과 대화해야 합니다.‡Habla con el mensajero Lanson en Reposo Estelar, en el Cementerio de Dragones.‡Habla con el mensajero Lanson en Reposo Estelar, en el Cementerio de Dragones.‡Parlez au Messager Lanson au Repos des étoiles, dans la Désolation des dragons.‡与龙骨荒野群星之墓的信使兰森谈一谈。‡到龍骨荒野和繁星之眠的信差蘭森談談。',
  }
},
[12158] = {
  {
    'Mina da Pedra Oca‡Рудник Полого Камня‡Hohlsteinmine‡빈돌 광산‡Mina Piedrahueca‡Mina Piedrahueca‡La mine de la Pierre creuse‡空石矿洞‡穴石礦坑',
    nil,
    'Procure por pistas dentro da Mina da Pedra Oca a noroeste do Acampamento da Brigada de Cerro Oeste.‡Обыщите Рудник Полого Камня к северо-западу от Лагеря дружины Западного Края.‡Sucht nach Hinweisen in der Hohlsteinmine, nordwestlich vom Lager der Westfallbrigade.‡서부 몰락지대 여단 야영지의 북서쪽에 있는 빈돌 광산에서 단서를 찾아야 합니다.‡Busca pistas dentro de la Mina Piedrahueca al noroeste del Campamento de la Brigada de los Páramos de Poniente.‡Busca pistas dentro de la Mina Piedrahueca al noroeste del Campamento de la Brigada de los Páramos de Poniente.‡Cherchez des indices dans la Mine de la Pierre creuse, au nord-ouest du Campement de la brigade de la marche de l’Ouest.‡进入月溪旅营地西北方的空石矿洞寻找线索。‡調查穴石礦坑內的線索，就在西荒兵團駐營的西北邊。',
  }
},
[12159] = {
  {
    'Almas inquietas‡Неупокоенные души‡Seelenunfrieden‡떠도는 영혼‡Almas sin descanso‡Almas sin descanso‡Les âmes agitées‡无法安息的灵魂‡無法安息之魂',
    nil,
    'Petrov, na Mina da Pedra Oca, quer que você use o Lampião do Minerador para queimar os corpos de 8 Mineradores da Pedra Oca.‡Петров с Рудника Полого Камня просит вас поджечь с помощью шахтерского фонаря трупы 8 шахтеров с Рудника Полого Камня.‡Petrov bei der Hohlsteinmine möchte, dass Ihr mit der Minenarbeiterlaterne die Leichen von 8 Minenarbeitern der Hohlsteinmine verbrennt.‡빈돌 광산에 있는 페트로프가 광부의 등불을 사용해 빈돌 광산 광부 시체 8구를 불태워 달라고 부탁했습니다.‡Petrov en Mina Piedrahueca quiere que uses la linterna de minero para quemar los cadáveres de 8 mineros Piedrahueca.‡Petrov en Mina Piedrahueca quiere que uses la linterna de minero para quemar los cadáveres de 8 mineros Piedrahueca.‡Petrov, de la Mine de la Pierre creuse, veut que vous utilisiez la Lanterne de mineur pour brûler les cadavres de 8 Mineurs de la Pierre creuse.‡空石矿洞的派特洛夫要求你使用矿工的灯笼净化8具空石矿工的躯体。‡穴石礦坑的派特洛夫要你用礦工提燈燒掉八個穴石礦工的屍體。',
  }
},
[12160] = {
  {
    'Um nome do passado‡Имя из прошлого‡Ein Name aus der Vergangenheit‡과거의 이름‡Un nombre del pasado‡Un nombre del pasado‡Un nom surgi du passé‡往日的名字‡來自往日的名字',
    nil,
    'Fale novamente com o Capitão Miguel Mantoforte no Acampamento da Brigada de Cerro Oeste.‡Вернитесь к капитану Гриану Камнегриву в Лагерь дружины Западного Края.‡Kehrt zu Hauptmann Gryan Starkmantel im Lager der Westfallbrigade zurück.‡서부 몰락지대 여단 야영지에 있는 대장 그라이언 스타우트맨틀에게 돌아가야 합니다.‡Vuelve con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Vuelve con el capitán Gryan Mantorrecio en el Campamento de la Brigada de los Páramos de Poniente.‡Retournez voir le Capitaine Gryan Roidemantel au Campement de la brigade de la marche de l’Ouest.‡向月溪旅营地的格里安·斯托曼复命。‡返回格里安·斯托曼上尉之處，他在西荒兵團駐營。',
  }
},
[12161] = {
  {
    'Ruuna, a Cega‡Рууна Слепая‡Ruuna die Blinde‡눈먼 루나‡Ruuna la Ciega‡Ruuna la Ciega‡Ruuna l\'Aveugle‡盲眼卢娜‡『瞎子』魯巫娜',
    nil,
    'Fale com Ruuna, a Cega, no Acampamento da Ruuna, perto do Desfiladeiro de Vordrassil.‡Поговорите с Рууной Слепой, которая живет в Лагере Рууны рядом с Перевалом Фордрассил.‡Sprecht mit Ruuna der Blinden in Ruunas Lager in der Nähe des Vordrassilpasses.‡볼드랏실 고개 근처의 루나의 야영지에 있는 눈먼 루나와 대화해야 합니다.‡Habla con Ruuna la Ciega en el Campamento de Ruuna cerca del Paso de Vordrassil.‡Habla con Ruuna la Ciega en el Campamento de Ruuna cerca del Paso de Vordrassil.‡Parlez à Ruuna l’Aveugle, au Camp de Ruuna, près de la Passe de Vordrassil.‡前往沃达希尔小径附近的卢娜的营地，与盲眼卢娜谈一谈。‡到沃達希爾小徑附近，魯巫娜的營地中和『瞎子』魯巫娜交談。',
  }
},
[12162] = {
  {
    'Aldeia Solstício‡Деревня Солнцестояния‡Julheim‡극지 마을‡Poblado Solsticio‡Poblado Solsticio‡Le village de Solstice‡Solstice Village‡季至村',
    nil,
    nil,
  }
},
[12163] = {
  {
    'O Mal Abaixo‡The Evil Below‡Das Böse lauert am Meeresgrund‡저 아래 악마‡El mal de abajo‡El mal de abajo‡La mal rôde dans les profondeurs‡The Evil Below‡暗藏邪惡',
    nil,
    nil,
  }
},
[12164] = {
  {
    'Arugal II: A Missão‡Час ворга‡Stunde des Worg‡검은늑대의 시간‡La hora del huargo‡La hora del huargo‡L\'heure du worg‡狼人的末日‡獵狼時刻',
    nil,
    'Sasha, no Entreposto Pinheiro Branco, quer que você vá à Ilha Sangreluna e mate Selas, Varlam, Gorjavil e o Vulto de Arugal.‡Саша из Торговой лавки Белой Сосны посылает вас на Остров Кровавой Луны убить Селаас, Варлама, Вспоробрюха и Тень Аругала.‡Sasha im Handelsposten Weißkiefer möchte, dass Ihr zur Blutmondinsel geht und Selas, Varlam, Blutschlund und den Schatten von Arugal tötet.‡흰 소나무 교역소에 있는 사샤가 핏빛달 섬에 가서 셀라스, 바를람, 흰송곳니, 아루갈의 망령을 처치해 달라고 부탁했습니다.‡Sasha en el Puesto de Venta de Pino Blanco quiere que vayas a la Isla Luna de Sangre y mates a Selas, Varlam, Buchegore y a la sombra de Arugal.‡Sasha en el Puesto de Venta de Pino Blanco quiere que vayas a la Isla Luna de Sangre y mates a Selas, Varlam, Buchegore y a la sombra de Arugal.‡Sasha, du comptoir du Pin blanc, veut que vous alliez sur l\'île de la Lune sanguine pour y tuer Selas, Varlam, Gueulétripe et l\'Ombre d\'Arugal.‡白松商栈的萨莎要求你前往血月岛，杀死塞拉斯、瓦拉姆、污血之喉和阿鲁高之影。‡白松貿易站的莎夏要你前往血月島殺死榭拉斯、凡爾廉、破喉以及阿魯高之影。',
  }
},
[12165] = {
  {
    'Um plano intrigante‡Коварный план‡Ein faszinierender Plan‡흥미로운 계획‡Un plan intrigante‡Un plan intrigante‡Un plan tentant‡有趣的计划‡陰謀策劃',
    nil,
    'Traga o Diagrama do Golem de Pedra completo para Rokar na Aldeia Oneqwah.‡Принесите полный комплект чертежей боевого голема геологу Рокару в Лагерь Уанква.‡Bringt die vollständige Blaupause für die Kriegsgolems zu Ausgrabungsleiter Rokar in Camp Oneqwah.‡완성된 전쟁 골렘 설계도를 원크와 야영지에 있는 발굴조사단장 로카르에게 가져가야 합니다.‡Llévale el plano gólem de guerra completo al prospector Rokar en el Campamento Oneqwah.‡Llévale el plano gólem de guerra completo al prospector Rokar en el Campamento Oneqwah.‡Le Prospecteur Rokar, du Camp Oneqwah, veut que vous lui rapportiez les Plans du golem de guerre terminés.‡将完整的作战魔像蓝图交给欧尼瓦营地的勘探员罗卡尔。‡將拼湊好的戰爭魔像藍圖交給勘察員洛卡，他就在歐尼克瓦營地裡。',
  }
},
[12166] = {
  {
    'O fogo líquido de Eluna‡Жидкое пламя Элуны‡Das flüssige Feuer Elunes‡엘룬의 액화 불길‡El fuego líquido de Elune‡El fuego líquido de Elune‡Le feu liquide d\'Élune‡艾露恩的火油‡伊露恩的液態火焰',
    nil,
    'A Guardiã Jodi Lunacanto, no Recanto das Estrelas, quer que você use o Fogo Líquido de Eluna para limpar os cadáveres de 6 Cervos Empesteados e 6 Ursos Árticos Raivosos.‡По просьбе стража-смотрителя Джоди Песни Луны из Покоя Звезд воспользуйтесь жидким пламенем Элуны для очищения трупов 6 гнилостных маралов и 6 бешеных гризли.‡Aufseherin Jodi Mondweise in Sternenruh hat Euch gebeten, das flüssige Feuer Elunes zu nutzen, um die Kadaver von 6 verseuchten Elchen und 6 tollwütigen Grizzlys zu läutern.‡별의 쉼터에 있는 감시자 조디 문송이 엘룬의 액화 불길을 사용하여 말라버린 사슴 6마리와 광포한 회색불곰 6마리의 시체를 정화해 달라고 부탁했습니다.‡La celadora Jodi Canción de Luna en Reposo Estelar te ha pedido que uses el fuego líquido de Elune para limpiar los cadáveres de 6 alces contagiados y 6 pardos rabiosos.‡La celadora Jodi Canción de Luna en Reposo Estelar te ha pedido que uses el fuego líquido de Elune para limpiar los cadáveres de 6 alces contagiados y 6 pardos rabiosos.‡La Gardienne Jodi Lunechant, au Repos des étoiles, vous a demandé d\'utiliser le Feu liquide d\'Élune pour purifier les cadavres de 6 Orignaux corrompus et de 6 Grizzlys enragés.‡群星之墓的典狱官朱蒂·月歌要你使用艾露恩的火油净化6只天灾麋鹿的尸体和6只狂暴灰熊的尸体。‡繁星之眠的看守者裘迪·月歌要你使用伊露恩的液態火焰淨化6頭荒疫污染麋鹿和6頭狂暴灰熊的屍體。',
  }
},
[12167] = {
  {
    'Mate os sectários‡Убить сектантов‡Tötet die Kultisten‡이교도 처단‡Mata a los cultores‡Mata a los cultores‡Tuez les sectateurs‡消灭教徒‡殺光教徒',
    nil,
    'Colete 5 Roupas Funcionais de Sectários para a Guardiã Jodi Lunacanto, no Recanto das Estrelas.‡Соберите 5 рабочих костюмов сектантов по просьбе стража-смотрителя Джоди Песни Луны из Покоя Звезд.‡Sammelt für Aufseherin Jodi Mondweise 5 funktionstüchtige Kultistenanzüge und bringt sie zu ihr nach Sternenruh.‡기능성 이교도 의상 5벌을 모아 별의 쉼터에 있는 감시자 조디 문송에게 가져가야 합니다.‡Reúne 5 trajes funcionales de cultor para la celadora Jodi Canción de Luna en Reposo Estelar.‡Reúne 5 trajes funcionales de cultor para la celadora Jodi Canción de Luna en Reposo Estelar.‡Collecter 5 Tenues de sectateur fonctionnelles pour la Gardienne Jodi Lunechant au Repos des étoiles.‡群星之墓的典狱官朱蒂·月歌要你收集5件教徒的衣物。‡收集5件教徒特殊作用服裝，交給繁星之眠的看守者裘迪·月歌。',
  }
},
[12168] = {
  {
    'O presente de Zangus‡Памятный дар Зангуса‡Zangus Ehrengabe‡장구스의 편지‡El Favor de Zangus‡El Favor de Zangus‡La faveur de Zangus‡扎古斯的礼物‡贊古司的信札',
    nil,
    'Entregue o Presente de Zangus para a Guardiã Jodi Lunacanto, no Recanto das Estrelas.‡Принесите памятный дар Зангуса стражу-смотрителю Джоди Песни Луны в Покой Звезд.‡Bringt Zangus Ehrengabe zu Aufseherin Jodi Mondweise in Sternenruh.‡장구스의 편지를 별의 쉼터에 있는 감시자 조디 문송에게 전달해야 합니다.‡Entrega el Favor de Zangus a la celadora Jodi Canción de Luna en Reposo Estelar.‡Entrega el Favor de Zangus a la celadora Jodi Canción de Luna en Reposo Estelar.‡Rapportez la Faveur de Zangus à la Gardienne Jodi Lunechant au Repos des étoiles.‡将扎古斯的礼物交给群星之墓的典狱官朱蒂·月歌要。‡將贊古司的信札帶給繁星之眠的看守者裘迪·月歌。',
  }
},
[12169] = {
  {
    'O Grão-sectário‡Верховный сектант‡Der Hochkultist‡고위 이교도‡El sumo cultor‡El sumo cultor‡Le haut-sectateur‡高阶教徒‡高階教徒',
    nil,
    'A Guardiã Jodi Lunacanto, no Recanto das Estrelas, quer que você mate o Grão-sectário Zangus.‡По заданию Стража-смотрителя Джоди Песни Луны из Покоя Звезд убейте верховного сектанта Зангуса.‡Aufseherin Jodi Mondweise in Sternenruh hat Euch gebeten, Hochkultist Zangus zu töten.‡별의 쉼터에 있는 감시자 조디 문송이 고위 이교도 장구스를 처치해 달라고 부탁했습니다.‡La celadora Jodi Canción de Luna en Reposo Estelar te ha pedido que mates al sumo cultor Zangus.‡La celadora Jodi Canción de Luna en Reposo Estelar te ha pedido que mates al sumo cultor Zangus.‡La Gardienne Jodi Lunechant, au Repos des étoiles, vous a demandé d\'abattre le Haut-sectateur Zangus.‡群星之墓的典狱官朱蒂·月歌要你杀死高阶教徒扎古斯。‡繁星之眠的看守者裘迪·月歌要求你殺死高階教徒贊古司。',
  }
},
[12170] = {
  {
    'Olhos roxos no Rio Negro‡Схватка в Черноречье‡Keilerei in Schwarzwasser‡검은강 전투‡Pelea en Río Negro‡Pelea en Río Negro‡Baston sur la rivière Noire‡黑水伐木场的战斗‡黑河爭奪戰',
    nil,
    'O Capitão dos Saqueadores Kronn quer que você mate 10 unidades ou jogadores da Horda na Madeireira Rio Negro.‡Капитан налетчиков Кронн просит вас убить 10 представителей или игроков Альянса на Лесопилке Черноречья.‡Räuberhauptmann Kronn möchte, dass Ihr 10 Einheiten oder Spieler der Allianz beim Holzfällerlager von Schwarzwasser tötet.‡공격대장 크론이 검은강 벌목지에 있는 얼라이언스 병사 혹은 전투원 10명을 처치해 달라고 부탁했습니다.‡El capitán de asaltantes Kronn quiere que mates a 10 unidades o jugadores de la Alianza en el Aserradero Río Negro.‡El capitán de asaltantes Kronn quiere que mates a 10 unidades o jugadores de la Alianza en el Aserradero Río Negro.‡Le Capitaine des écumeurs Kronn veut que vous tuiez 10 unités ou personnages-joueurs de l\'Alliance au Camp de bûcherons de la rivière Noire.‡骑兵队长克洛恩希望你在黑水伐木场击杀10名联盟士兵或者玩家。‡狼騎兵隊長克羅恩要你去黑河伐木營地，殺死10名聯盟成員或玩家。',
  }
},
[12171] = {
  {
    'Sobre traição e traidores‡О предателях и предательстве‡Von Verrätern und Verrat‡반역과 배신‡De traidores y traición‡De traidores y traición‡Traîtres et trahisons‡叛徒的名单‡叛徒與通敵',
    nil,
    'Mostre a Missiva da Aliança para Palena Nefelargenta no Recanto das Estrelas.‡Покажите депешу Альянса Палене Серебряное Облако в Покое Звезд.‡Zeigt Palena Silberwolke in Sternenruh das Schreiben der Allianz.‡얼라이언스 서신을 별의 쉼터에 있는 팔레나 실버클라우드에게 보여야 합니다.‡Enséñale la misiva de la Alianza a Palena Nube de Plata en Reposo Estelar.‡Enséñale la misiva de la Alianza a Palena Nube de Plata en Reposo Estelar.‡Montrez la Missive de l’Alliance à Palena Nuée-argent, au Repos des étoiles.‡向群星之墓的帕蕾娜·银云出示联盟信函。‡將聯盟公文交給繁星之眠的帕雷那·銀雲。',
  }
},
[12172] = {
  {
    'Em sintonia com Dalaran‡Настройка на Даларан‡Abstimmung auf Dalaran‡달라란과의 조율‡Armonización hacia Dalaran‡Armonización hacia Dalaran‡Harmonisation à Dalaran‡达拉然的能量调和‡與達拉然同調',
    nil,
    'A Imagem da Arquimaga Modera, no Recanto das Estrelas, quer que você entre em sintonia com as Linhas de Meridiano de Nortúndria.‡По заданию проекции верховного мага Модеры в Покое Звезд настройтесь на силовые линии Нордскола.‡Das Abbild der Erzmagierin Modera in Sternenruh möchte, dass Ihr Euch auf Nordends Leylinien abstimmt.‡노스렌드의 지맥에 맞게 자신을 조율한 후, 별의 쉼터에 있는 대마법사 모데라의 환영에게 돌아가야 합니다.‡La imagen de la archimaga Modera en Reposo Estelar te ha pedido que te armonices con las líneas Ley de Rasganorte.‡La imagen de la archimaga Modera en Reposo Estelar te ha pedido que te armonices con las líneas Ley de Rasganorte.‡L\'Image de l\'archimage Modera vous a demandé de vous Harmoniser avec les lignes telluriques du Norfendre.‡群星之墓的大法师茉德拉的影像要你与诺森德的魔网能量线进行调和。‡繁星之眠的大法師莫德菈的影像要求你和北裂境的地脈同調。',
  }
},
[12173] = {
  {
    'Em sintonia com Dalaran‡Настройка на Даларан‡Abstimmung auf Dalaran‡달라란과의 조율‡Armonización hacia Dalaran‡Armonización hacia Dalaran‡Harmonisation à Dalaran‡达拉然的能量调和‡與達拉然同調',
    nil,
    'A Imagem do Arquimago Aethas Fendessol, no Martelo de Agmar, quer que você entre em Sintonia com as Linhas de Meridiano de Nortúndria.‡По заданию проекции верховного мага Этаса Похитителя Солнца в Молоте Агмара настройтесь на силовые линии Нордскола.‡Das Abbild des Erzmagiers Aethas Sonnenhäscher in Agmars Hammer möchte, dass Ihr Euch auf Nordends Leylinien abstimmt.‡아그마르의 망치에 있는 대마법사 에이타스 선리버의 환영이 노스렌드의 지맥에 맞게 자신을 조율하고 오라고 부탁했습니다.‡La imagen del archimago Aethas Atracasol en Martillo de Agmar te ha pedido que te armonices con las líneas Ley de Rasganorte.‡La imagen del archimago Aethas Atracasol en Martillo de Agmar te ha pedido que te armonices con las líneas Ley de Rasganorte.‡L\'Image de l\'archimage Aethas Saccage-soleil, au Marteau d\'Agmar, vous a demandé de vous Harmoniser avec les lignes telluriques du Norfendre.‡阿格玛之锤的大法师艾萨斯·夺日者的影像要你与诺森德的魔网能量线进行调和。‡阿格瑪之錘的大法師埃薩·奪日者的影像要求你和北裂境的地脈同調。',
  }
},
[12174] = {
  {
    'Alto-comandante Haraldo Serpecida‡Главнокомандующий Халфорд Змеевержец‡Oberkommandant Halford Wyrmbann‡총사령관 할포드 웜베인‡Alto comandante Halford Aterravermis‡Alto comandante Halford Aterravermis‡Le haut-commandant Halford Verroctone‡高级指挥官哈尔弗·维姆班恩‡高階指揮官海弗德·龍禍',
    nil,
    'Entregue a Missiva da Aliança para o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, a leste do Ermo das Serpes.‡Доставьте депешу Альянса главнокомандующему Халфорду Змеевержцу в крепость Стражей Зимы в восточной части Драконьего Погоста.‡Überbringt Oberkommandant Halford Wyrmbann das Schreiben der Allianz. Er befindet sich in der Feste Wintergarde im Osten der Drachenöde.‡얼라이언스 서신을 용의 안식처 동부에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 전달해야 합니다.‡Entrega la misiva de la Alianza al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde al este del Cementerio de Dragones.|n‡Entrega la misiva de la Alianza al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde al este del Cementerio de Dragones.|n‡Remettez la Missive de l’Alliance au Haut-commandant Halford Verroctone, au Donjon de Garde-hiver, dans l’est de la Désolation des dragons.‡前往龙骨荒野东部的暮冬要塞，将联盟信函交给高级指挥官哈尔弗·维姆班恩。‡將聯盟公文交給高階指揮官海弗德·龍禍，他就在龍骨荒野東邊的溫特加德要塞中。',
  }
},
[12175] = {
  {
    'Pelegos de worg cinzento‡Серые шкуры воргов‡Graue Worgbälge‡회색 늑대 가죽‡Pieles de huargo gris‡Pieles de huargo gris‡Les peaux de worgs gris‡灰狼的毛皮‡銀灰座狼皮',
    nil,
    'O Comerciante de Peles Jun\'ik, no Forte da Conquista, quer que você lhe traga 3 Pelegos de Worg Cinzento dos Caçadores Brumagris das florestas ao norte.‡Торговец шкурами Джун\'ик из Крепости Завоевателей просит вас добыть 3 серые шкуры ворга с серо-дымчатых охотников, которые водятся в лесах на севере.‡Balghändler Jun\'ik möchte, dass Ihr ihm 3 graue Worgbälge von Graunebeljägern in den nördlichen Wäldern bringt.‡정복의 요새에 있는 가죽상인 준이크가 북쪽 숲에 있는 회색안개 늑대에게서 회색 늑대 가죽 3장을 가져와 달라고 부탁했습니다.‡Jun\'ik, el comerciante de pellejos en Bastión de la Conquista quiere que le consigas 3 pieles de huargo gris de los cazadores brumagris que hay en los bosques al norte.‡Jun\'ik, el comerciante de pellejos en Bastión de la Conquista quiere que le consigas 3 pieles de huargo gris de los cazadores brumagris que hay en los bosques al norte.‡Le Marchand de peaux Jun\'ik, du bastion de la Conquête, veut que vous préleviez 3 Peaux de worg gris sur des Chasseurs brumegrise dans les bois du nord.‡征服堡的皮货商人休尼克希望你能从北面森林的灰雾捕猎者身上获取3张灰色座狼皮。‡征服堡的皮革商人朱尼克需要你從灰霧獵食者身上取得3張銀灰座狼皮，牠們出沒在北邊的樹林裡。',
  }
},
[12176] = {
  {
    'Uma pequena substituição‡Мелкая подмена‡Ein kleiner Ersatz‡눈을 속일 물건‡Un pequeño cambio‡Un pequeño cambio‡Une substitution sans importance‡替代品‡窮則變變則通',
    nil,
    'O Comerciante de Peles Jun\'ik quer que você lhe traga 6 Pelegos de Urso-cinzento.‡Торговец шкурами Джун\'ик просит вас принести ему 6 шкур медведей гризли.‡Balghändler Jun\'ik möchte, dass Ihr ihm 6 Grizzlybälge bringt.‡가죽상인 준이크가 회색 구릉지 곰 가죽 6장을 가져와 달라고 부탁했습니다.‡El comerciante de pellejos Jun\'ik quiere que le lleves 6 pellejos de oso pardo.‡El comerciante de pellejos Jun\'ik quiere que le lleves 6 pellejos de oso pardo.‡Le Marchand de peaux Jun\'ik veut que vous lui rapportiez 6 Peaux de grizzly.‡皮货商人休尼克希望你能交给他6张灰熊皮。‡皮革商人朱尼克需要你帶給他6張灰熊毛皮。',
  }
},
[12177] = {
  {
    'A malandragem do Jun\'ik‡Уловка Джун\'ика‡Jun\'iks Vertuschung‡눈 가리고 아웅‡La mentirijilla de Jun\'ik‡La mentirijilla de Jun\'ik‡Les petites magouilles de Jun\'ik‡休尼克的掩饰‡越描越灰',
    nil,
    'Leve 1 pedaço de Carvão e 5 unidades de Farinha Simples para o Comerciante de Peles Jun\'ik no Forte da Conquista, que fica na Serra Gris.‡Принесите кусок угля и пять горстей простой муки торговцу шкурами Джун\'ику в Крепость Завоевателей в Седых холмах.‡Bringt dem Balghändler Jun\'ik in der Burg Siegeswall in den Grizzlyhügeln 1 Kohlestück und 5 Portionen herkömmliches Mehl.‡석탄 1조각과 밀가루 5포대를 회색 구릉지에 있는 정복의 요새로 가서 가죽상인 준이크에게 가져가야 합니다.‡Llévale 1 trozo de carbón y 5 paquetes de harina simple al comerciante de pellejos Jun\'ik en Bastión de la Conquista en las Colinas Pardas.‡Llévale 1 trozo de carbón y 5 paquetes de harina simple al comerciante de pellejos Jun\'ik en Bastión de la Conquista en las Colinas Pardas.‡Le Marchand de peaux Jun\'ik, du bastion de la Conquête des Grisonnes, a besoin d\'un morceau de Charbon et de 5 mesures de Farine simple.‡将1份煤块和5份面粉交给灰熊丘陵征服堡的皮货商人休尼克。‡帶1塊煤塊和5包簡易麵粉給皮革商人朱尼克，他在灰白之丘的征服堡裡。',
  }
},
[12178] = {
  {
    'Entrega para a Sra. Krenna‡Сверток для Кренны‡Lieferung für Krenna‡크레나에게 배달‡Entrega a Krenna‡Entrega a Krenna‡Livraison à Krenna‡给克雷娜送货‡交貨給克蓮娜',
    nil,
    'Entregue o Pacote de Peles a Krenna no Forte da Conquista‡Отнесите связку шкур Кренне в Крепость Завоевателей.‡Nehmt das Bündel Felle und bringt es zu Krenna in Burg Siegeswall.‡가죽 묶음을 정복의 요새에 있는 크레나에게 가져가야 합니다.‡Lleva el Fardo de Pieles a Krenna en Bastión de la Conquista.‡Lleva el fardo de pellejos a Krenna en Bastión de la Conquista.‡Remettez le Tas de peaux à Krenna au Bastion de la Conquête.‡将一捆兽皮交给征服堡的克雷娜。‡將一捆獸皮拿給征服堡的克蓮娜。',
  }
},
[12179] = {
  {
    'Specialization 1 [PH]‡Specialization 1 [PH]‡Specialization 1 [PH]‡Specialization 1 [PH]‡Specialization 1 [PH]‡Specialization 1 [PH]‡Specialisation 1 [PH]‡Specialization 1 [PH]‡特別任務1[PH]',
    nil,
    'LOG: Complete this quest for Specialization 1.‡LOG: Complete this quest for Specialization 1.‡LOG: Complete this quest for Specialization 1.‡LOG: Complete this quest for Specialization 1.‡LOG: Complete this quest for Specialization 1.‡LOG: Complete this quest for Specialization 1.‡JOURNAL : Accomplir cette quête pour la spécialisation 1.‡LOG: Complete this quest for Specialization 1.‡紀錄:為了特別任務1完成這項任務。',
  }
},
[12180] = {
  {
    'Os prospectores cativos‡Пленные геологи‡Die gefangenen Ausgrabungsleiter‡사로잡힌 발굴조사단장‡Los prospectores cautivos‡Los prospectores cautivos‡Les prospecteurs captifs‡被俘虏的勘探员‡被俘的勘察員',
    nil,
    'Liberte o Prospector Gann, o Prospector Torgan e a Prospectora Varana, e em seguida fale novamente com o Montanhista Kilian no Mirante do Minerador.‡Освободите геолога Ганна, геолога Торгана и геолога Варана, после чего вернитесь к горному пехотинцу Килиану в Лагерь горняков.‡Befreit die Ausgrabungsleiter Gann, Torgan und Varana, dann kehrt zu Gebirgsjäger Kilian im Prospektorat zurück.‡발굴조사단장 간, 발굴조사단장 토르간, 발굴조사단장 바라나를 풀어준 다음 발굴단 거점에 있는 산악경비병 킬리안에게 돌아가야 합니다.‡Libera al prospector Gann, al prospector Torgan y a la prospectora Varana, y luego vuelve junto al montaraz Kilian en Altozano del Prospector.‡Libera al prospector Gann, al prospector Torgan y a la prospectora Varana, y luego vuelve junto al montaraz Kilian en Altozano del Prospector.‡Libérez le Prospecteur Gann, le Prospecteur Torgan et la Prospectrice Varana, puis retournez voir le Montagnard Kilian à la Pointe du Prospecteur.‡营救勘探员甘恩、勘探员托尔根和勘探员瓦拉纳，然后返回勘探员哨站，向巡山人基连复命。‡救出勘察員加恩、勘察員拓剛和勘察員韋拉那，再向勘察員崗哨的巡山人基立安回報。',
  }
},
[12181] = {
  {
    'Dê nome à criança‡Имя для заразы‡Gebt dem Zeugs einen Namen‡이름 짓기‡Ponle un nombre‡Ponle un nombre‡Lui donner un nom‡给它一个名字‡取名',
    nil,
    'Mostre o Espécime de Praga para Tobias Sarkhoff em Nova Agamand.‡Покажите образец гнили Тобиасу Саркхоффу в Ядозлоби.‡Zeigt Tobias Sarkhoff in Neu-Agamand die Pesthauchprobe.‡신 아가만드에 있는 토비아스 사르코프에게 파멸의 역병 표본을 보여줘야 합니다.‡Enséñale el espécimen de añublo a Tobias Sarkhoff en Nuevo Agamand.|n‡Enséñale el espécimen de añublo a Tobias Sarkhoff en Nuevo Agamand.|n‡Montrez le Spécimen chancreux à Tobias Sarkhoff à la Nouvelle-Agamand.‡向新阿加曼德的托比亚斯·萨克霍夫出示你的凋零药剂样本。‡把荒疫採樣拿給新阿加曼德的圖比亞斯·薩寇夫看。',
  }
},
[12182] = {
  {
    'Para Perfídia!‡В Ядозлобь!‡Nach Gallgrimm!‡원한의 초소로!‡¡A Rencor Venenoso!‡¡A Rencor Venenoso!‡En route pour Vexevenin !‡前往怨毒镇！‡前往毒怨之地!',
    nil,
    'Entregue o Espécime de Praga para o Pestífero-chefe Militão em Perfídia, na parte leste do Ermo das Serpes.‡Передайте образец гнили Главному распространителю чумы Миддлтону, который живет в Ядозлоби на востоке Драконьего Погоста.‡Liefert die Pesthauchprobe beim obersten Seuchenfürsten Middleton ab. Er befindet sich in Gallgrimm im Osten der Drachenöde.‡파멸의 역병 견본을 용의 안식처 동부의 원한의 초소에 있는 역병인도자 미들턴에게 전달해야 합니다.‡Entrega el espécimen de añublo al jefe pesteador Middleton en Rencor Venenoso, al este del Cementerio de Dragones.‡Entrega el espécimen de añublo al jefe pesteador Middleton en Rencor Venenoso, al este del Cementerio de Dragones.‡Livrez le Spécimen chancreux au Porte-peste en chef Mideton, à Vexevenin, à l’est de la Désolation des dragons.‡前往龙骨荒野东部的怨毒镇，将凋零药剂样本交给首席药剂师米德尔顿。‡將荒疫採樣送到首席瘟疫使者米道頓手上。他就在龍骨荒野東方的毒怨之地上。',
  }
},
[12183] = {
  {
    'Vestindo a beca‡Часть маскировки‡Überzeugende Verkleidung‡그럴 듯한 위장복‡Dando el pego‡Dando el pego‡L\'habit fait le moine‡搜集制服‡搜身',
    nil,
    'Traga o Uniforme do Supervisor para o Montanhista Kilian no Mirante do Minerador.‡Принесите униформу надзирателя горному пехотинцу Килиану в Лагерь горняков.‡Bringt eine Aufseheruniform zu Gebirgsjäger Kilian im Prospektorat.‡감독관의 제복을 구해 발굴단 거점에 있는 산악경비병 킬리안에게 가져가야 합니다.‡Llévale el uniforme de sobrestante al montaraz Kilian en Altozano del Prospector.‡Llévale el uniforme de sobrestante al montaraz Kilian en Altozano del Prospector.‡Apportez un Uniforme de surveillant au montagnard Kilian à la pointe du Prospecteur.‡将一件监工的制服交给勘探员哨站的巡山人基连。‡帶一件監督者制服給勘察員崗哨的巡山人基立安。',
  }
},
[12184] = {
  {
    'Cultivando uma imagem‡Улыбайтесь, вас снимают!‡Fotosafari‡색다른 사진 촬영‡Cultivando una imagen‡Cultivando una imagen‡Cultiver son image‡拍摄照片‡留下倩影',
    nil,
    'Use a Câmera do Kilian para gravar imagens de 8 Anões de Ferro em Dun Argol, e em seguida fale novamente com o Montanhista Kilian no Mirante do Minerador.‡С помощью камеры Килиана сделайте снимки 8 железных дворфов в Дун Арголе, после чего вернитесь к горному пехотинцу Килиану в Лагерь горняков.‡Benutzt Kilians Kamera, um Bilder von 8 Eisenzwergen in Dun Argol aufzunehmen. Dann kehrt zu Gebirgsjäger Kilian im Prospektorat zurück.‡킬리안의 카메라로 던 아르골에 있는 무쇠 드워프 8명의 사진을 찍은 다음 발굴단 거점에 있는 산악경비병 킬리안에게 돌아가야 합니다.‡Utiliza la cámara de Kilian para grabar las imágenes de 8 enanos férreos en Dun Argol y luego vuelve junto al montaraz Kilian en Altozano del Prospector.‡Utiliza la cámara de Kilian para grabar las imágenes de 8 enanos férreos en Dun Argol y luego vuelve junto al montaraz Kilian en Altozano del Prospector.‡Utilisez l\'Appareil photographique de Kilian pour enregistrer les images de 8 Nains de fer à Dun Argol, puis retournez voir Kilian à la pointe du Prospecteur.‡用基连的相机拍摄8张丹厄古尔铁矮人的照片，然后返回勘探员哨站，向巡山人基连复命。‡利用齊里安的攝像機紀錄8位丹亞戈的鐵矮人影像，然後向勘察員崗哨的巡山人基立安回報。',
  }
},
[12185] = {
  {
    'Fazendo carão para Loken‡Лучшая маскировка для Локена‡Setzt Eure beste Miene auf für Loken‡로켄에게 잘보이기‡Ponte tu mejor cara para Loken‡Ponte tu mejor cara para Loken‡Faire bon visage à Loken‡笑脸面对洛肯！‡為洛肯笑一個',
    nil,
    'Use o disfarce de Feitor da Runa Férrea, intercepte a mensagem de Loken e por fim se apresente ao Montanhista Kilian no Mirante do Minerador.‡Замаскируйтесь под железного надзирателя рун, перехватите послание от Локена и передайте его горному пехотинцу Килиану в Лагерь горняков.‡Verkleidet Euch als Eisenrunenaufseher, fangt die Nachricht von Loken ab und kehrt dann zu Gebirgsjäger Kilian im Prospektorat zurück.‡무쇠룬부족 감독관으로 위장하고 로켄이 보낸 전언을 가로챈 다음 발굴단 거점에 있는 산악경비병 킬리안에게 보고해야 합니다.‡Disfrázate de sobrestante Runaférrea, intercepta el mensaje de Kronus y luego informa al montaraz Kilian en Altozano del Prospector.‡Disfrázate de sobrestante Runaférrea, intercepta el mensaje de Kronus y luego informa al montaraz Kilian en Altozano del Prospector.‡Déguisez-vous en Surveillant Rune-de-fer, interceptez le message de Loken, puis faites votre rapport au Montagnard Kilian à la Pointe du Prospecteur.‡伪装成铁符文监工，截获洛肯的指令，然后返回勘探员哨站，向巡山人基连复命。‡把你自己偽裝成鐵符文監督者，攔截洛肯的訊息，然後回報給勘察員崗哨的巡山人基立安。',
  }
},
[12186] = {
  {
    '‡УКАЗАТЕЛЬ: Победитель‡Flagge: Sieger‡승리자‡MARCA: Ganador‡MARCA: Ganador‡MARQUEUR : Gagnant‡旗帜:赢家‡',
    nil,
    nil,
  }
},
[12187] = {
  {
    '‡УКАЗАТЕЛЬ: Участник‡Flagge: Teilnehmer‡참가자‡MARCA: Participante‡MARCA: Participante‡MARQUEUR : Participant‡旗帜:参赛者‡',
    nil,
    nil,
  }
},
[12188] = {
  {
    'A praga dos renegados e você: como não morrer‡Гниль Отрекшихся и вы: как не заразиться самим‡Die Seuche der Verlassenen und du: Wie man nicht stirbt‡포세이큰 파멸의 역병과 당신: 죽지 않는 비결‡El añublo de los Renegados y tú: cómo no morir‡El añublo de los Renegados y tú: cómo no morir‡La flétrissure des Réprouvés et vous : petit manuel de survie‡凋零药剂与你：如何自保‡被遺忘者荒疫與你:如何不死',
    nil,
    'O Pestífero-chefe Militão, em Perfídia, que fica no Ermo das Serpes, quer que você leve 10 Resíduos Ectoplásmicos para ele.‡Принесите главному распространителю чумы Миддлтону из Ядозлоби в Драконьем Погосте 10 образцов эктоплазменного осадка.‡Oberster Seuchenfürst Middleton in Gallgrimm in der Drachenöde möchte, dass Ihr ihm 10 ektoplasmische Überreste bringt.‡용의 안식처에 있는 원한의 초소의 고위 역병인도자 미들턴이 심령체 잔류물 10개를 가져와 달라고 부탁했습니다.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que le traigas 10 muestras de residuo ectoplásmico.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que le traigas 10 muestras de residuo ectoplásmico.‡Le Porte-peste en chef Mideton, à Vexevenin dans la Désolation des dragons, veut que vous lui rapportiez 10 Résidus ectoplasmiques.‡怨毒镇的首席药剂师米德尔顿要求你给他带回10份灵质残渣。‡龍骨荒野上，毒怨之地中的首席瘟疫使者米道頓需要你帶10個魂能殘渣給他。',
  }
},
[12189] = {
  {
    'Imbecis aos montes!‡Меня окружают идиоты!‡Schwachköpfe, wo man nur hinsieht!‡온통 바보들뿐이야!‡Los tontos abundan‡Los tontos abundan‡Une bande d\'imbéciles !‡笨蛋加白痴！‡到處都是白痴!',
    nil,
    'Vá para Perfídia, no Ermo das Serpes e fale com o Pestífero-chefe Militão.‡Отправляйтесь в Ядозлобь в Драконьем Погосте и поговорите с главным распространителем чумы Миддлтоном.‡Reist nach Gallgrimm in der Drachenöde und sprecht mit dem obersten Seuchenfürsten Middleton.‡용의 안식처에 있는 원한의 초소로 가서 고위 역병인도자 미들턴과 대화해야 합니다.‡Viaja hasta Rencor Venenoso en el Cementerio de Dragones y habla con el jefe pesteador Middleton.|n‡Viaja hasta Rencor Venenoso en el Cementerio de Dragones y habla con el jefe pesteador Middleton.|n‡Voyager jusqu\'à Vexevenin dans la Désolation des dragons et parler avec le Porte-peste en chef Mideton.‡前往龙骨荒野的怨毒镇，与首席药剂师米德尔顿谈一谈。‡前往毒怨之地，和首席瘟疫使者米道頓交談。',
  }
},
[12190] = {
  {
    'O Prigmon mandou um beijo‡Поздоровайся с моим маленьким другом‡Sagt hallo zu meinem kleinen Freund‡작은 친구에게 안부를‡Saluda a mi amiguito‡Saluda a mi amiguito‡Dis bonjour à mon p\'tit pote‡跟我的小朋友打招呼‡跟我的小朋友問好',
    nil,
    'Prigmon quer que você entregue os Ingredientes do Harkor ao Harkor no Acampamento do Harkor.‡Пригмон просит вас отнести ингредиенты для Харкора в Лагерь Харкора.‡Prigmon möchte, dass Ihr Harkors Zutaten zu Harkor in Harkors Lager bringt.‡프리그몬이 하코르의 재료를 하코르의 야영지에 있는 하코르에게 전달해 달라고 부탁했습니다.‡Prigmon quiere que le lleves a Harkor sus ingredientes al Campamento Harkor.‡Prigmon quiere que le lleves a Harkor sus ingredientes al Campamento Harkor.‡Dasnob veut que vous remettiez les Ingrédients de Harkor à Harkor, au Camp de Harkor.‡普雷蒙希望你将哈考尔的调料的交给哈考尔营地的哈考尔。‡皮格蒙要你將哈克爾的原料，帶給哈克爾營地的哈克爾。',
  }
},
[12191] = {
  {
    'Caneco no boneco!‡Пей до дна!‡Haut weg das Zeug!‡아자가자 나가자!‡¡Traga y tira!‡¡Traga y tira!‡Buvez, éliminez !‡扔酒杯！‡乾了再砸!',
    nil,
    'Use a Amostra de Cortesia da CervaFest para acertar o B.I.R.I.T.A. 5 vezes. Depois, fale com Bizu Sobelogo.‡Попадите кружкой с бесплатным пивом в С.С.М. 5 раз, затем поговорите с Биззлем Эхпрокачуном.‡Benutzt den Freibierkrug, um A.L.K. fünfmal zu treffen, und sprecht dann mit Bissel Schnellhub.‡시음용 가을 축제 맥주를 사용하여 주.정.뱅.이.를 5번 맞힌 후 비즐 퀵리프트와 대화해야 합니다.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Bizzle Birlotutti.‡Utiliza la jarra de degustación de la Fiesta de la cerveza de obsequio para golpear a la G.U.A.O. 5 veces, y luego ve a hablar con Bizzle Birlotutti.‡Utilisez le Tastebière-cadeau pour toucher la C.E.R.V.O.I.S.E. 5 fois, puis revenez parler à Bizzle Soulevite.‡用免费美酒节取样器击中掷杯训练器5次，然后与比兹尔·奎利弗谈一谈。‡使用免費招待的啤酒節樣品並丟中S.T.O.U.T.5次，然後和比索·迅提談談。',
  }
},
[12192] = {
  {
    'Certa vez, quando eu estava bêbado...‡Однажды, напившись в...‡Dieses eine Mal, als ich betrunken war...‡가을 축제를 즐기는 자세‡Ese día que estaba borracho...‡Ese día que estaba borracho...‡Et une fois, quand j\'étais ivre...‡那次，我喝醉了之后......‡就這麼一次，在我酒醉的時候…',
    nil,
    'Fale com Bizu Sobelogo no acampamento da CervaFest.‡Поговорите с Биззлем Эхпрокачуном в лагере Хмельного фестиваля.‡Sprecht mit Bissel Schnellhub im Braufestlager.‡가을 축제 천막에 있는 비즐 퀵리프트와 이야기해야 합니다.‡Habla con Bizzle Birlotutti en el campamento de la Fiesta de la cerveza.‡Habla con Bizzle Birlotutti en el campamento de la Fiesta de la cerveza.‡Parlez à Bizzle Soulevite au campement de la fête des Brasseurs.‡与美酒节营地的比兹尔·奎利弗谈一谈。‡與啤酒節營地的比索·迅提交談。',
  }
},
[12193] = {
  {
    'Então, será que por acaso também tem suvenir este ano, hein?‡А не будет ли сувенирчика в нынешнем году?‡Sagt mal, es gibt dieses Jahr nicht zufällig ein Souvenir?‡아니, 올해는 기념품이 없다는 게 말이 돼?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Dites, il n\'y aurait pas un souvenir cette année ?‡今年有没有纪念品？‡喂，聽說今年沒有紀念品，是不是真的啊?',
    nil,
    'Troque o Vale-caneco da CervaFest com Bebel Trocarrápida na CervaFest.‡Найдите в лагере Хмельного фестиваля Белби Быстросмен, отдайте ей купон и получите бесплатную праздничную пивную кружку.‡Löst Euren Gutschein für einen Braufestkrug bei Belbi Blitzknips im Braufestlager ein.‡가을 축제 천막에 있는 벨비 퀵스위치에게 가을 축제 맥주잔 상품권을 가져다주어야 합니다.‡Entrega el vale de jarra de la Fiesta de la cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la cerveza.‡Entrega el vale de jarra de la Fiesta de la cerveza a Belbi Tiratrastos en el campamento de la Fiesta de la cerveza.‡Échangez le bon pour un bock à Belbi Coupecircuit dans le campement de la fête des Brasseurs.‡在美酒节营地的贝尔比处兑换礼品券。‡把啤酒節酒杯兌換券交給啤酒節營地的貝爾碧·迅移。',
  }
},
[12194] = {
  {
    'Então, será que por acaso também tem suvenir este ano, hein?‡А не будет ли сувенирчика в нынешнем году?‡Sagt mal, es gibt dieses Jahr nicht zufällig ein Souvenir?‡아니, 올해는 기념품이 없다는 게 말이 돼?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Oye, ¿no habrá por casualidad un souvenir este año?‡Dites, il n\'y aurait pas un souvenir, cette année ?‡今年有没有纪念品？‡喂，聽說今年沒有紀念品，是不是真的啊?',
    nil,
    'Troque o Vale-caneco da CervaFest com Blix Consertatreco nos fundos da área do festival.‡Найдите в лагере Хмельного фестиваля Бликса Чиништукса, отдайте ему купон и получите бесплатную праздничную пивную кружку.‡Löst Euren Gutschein für einen Braufestkrug bei Blix Fixtand im hinteren Teil des Braufestlagers ein.‡가을 축제 천막에 있는 블릭스 픽스위젯에게 가을 축제 맥주잔 상품권을 가져다주어야 합니다.‡Entrega el vale de jarra de la Fiesta de la cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la cerveza.‡Entrega el vale de jarra de la Fiesta de la cerveza a Blix Chirimbolo en la parte trasera del campamento de la Fiesta de la cerveza.‡Échangez le Bon pour un bock de la fête des Brasseurs à Blix Réparouage à l\'arrière du campement de la fête des Brasseurs.‡在美酒节营地背后的布利克斯·菲克维特处兑换礼品券。‡把啤酒節酒杯兌換券交給啤酒節營地後方的布力克斯·修械。',
  }
},
[12195] = {
  {
    'O "convidado" inesperado‡Незваный гость‡Ein unerwarteter "Gast"‡초대하지 않은 \'손님\'‡El "invitado" inesperado‡El "invitado" inesperado‡Un « invité » inattendu‡不速之“客”‡意外的訪客',
    nil,
    'Traga 5 Chifres de Cervo Adulto para Tormak, o Marcado, na Aldeia Oneqwah.‡Принесите 5 рогов взрослых оленей Тормаку Бывалому из Лагеря Уанква.‡Bringt 5 ausgewachsene Hirschgeweihe zu Tormak dem Vernarbten in Camp Oneqwah.‡다 자란 순록 뿔 5개를 원크와 야영지에 있는 영광의 흉터 토르마크에게 가져가야 합니다.‡Llévale 5 cuernos de venado adulto a Tormak el Cicatrices en el Campamento Oneqwah.‡Llévale 5 cuernos de venado adulto a Tormak el Cicatrices en el Campamento Oneqwah.‡Apportez 5 Bois de cerf adulte à Tormak le Balafré au Camp Oneqwah.‡将5根成熟的雄鹿角交给欧尼瓦营地的托尔玛克。‡把5根成年鹿角帶給歐尼克瓦營地的『刀疤』托邁克。',
  }
},
[12196] = {
  {
    'Do começo ao fim‡С самого начала‡Von Grund auf‡하나부터 열까지‡Desde cero‡Desde cero‡En partant de zéro‡收集零件‡從頭開始',
    nil,
    'Traga 8 Peças de Golem de Guerra para Rokar na Aldeia Oneqwah.‡Принесите 8 частей боевого голема геологу Рокару в Лагерь Уанква.‡Bringt Ausgrabungsleiter Rokar im Camp Oneqwah 8 Teile eines Kriegsgolems.‡전쟁 골렘 부품 8개를 원크와 야영지에 있는 발굴조사단장 로카르에게 가져가야 합니다.‡Llévale 8 trozos de gólem de guerra al prospector Rokar en el Campamento Oneqwah.‡Llévale 8 trozos de gólem de guerra al prospector Rokar en el Campamento Oneqwah.‡Apportez 8 Pièces de golem de guerre au prospecteur Rokar au Camp Oneqwah.‡将8个作战魔像零件交给欧尼瓦营地的勘探员罗卡尔。‡把8個戰爭魔像零件交給歐尼克瓦營地的勘察員洛卡。',
  }
},
[12197] = {
  {
    'Nós temos a força‡Нам нужна энергия‡Wir haben die Macht‡우리에겐 전력이 있다!‡Tenemos el poder...‡Tenemos el poder...‡Nous avons l\'énergie…‡我们有能源‡我們要能量',
    nil,
    'Traga a Pilha do Durar e a Pilha de Kathorn para o Prospector Rokar da Aldeia Oneqwah.‡Принесите энергобатареи Дурара и Каторна Геологу Рокару в Лагерь Уанква.‡Bringt Durars Energiezelle und Kathorns Energiezelle zu Ausgrabungsleiter Rokar im Camp Oneqwah.‡듀라르의 전지와 카손의 전지를 원크와 야영지에 있는 발굴조사단장 로카르에게 가져가야 합니다.‡Llévale la célula de energía de Durar y la célula de energía de Kathorn al Prospector Rokar en el Campamento Oneqwah.‡Llévale la célula de energía de Durar y la célula de energía de Kathorn al Prospector Rokar en el Campamento Oneqwah.‡Apportez la Cellule énergétique de Durar et la Cellule énergétique de Kathorn au Prospecteur Rokar au Camp Oneqwah.‡将杜拉尔的能量晶格和卡索恩的能量晶格交给欧尼瓦营地的勘探员罗卡尔。‡把杜拉爾的能量電池和卡索恩的能量電池交給歐尼克瓦營地的勘察員洛卡。',
  }
},
[12198] = {
  {
    '... Ou talvez a gente não tenha‡... а может быть, и нет‡... oder vielleicht doch nicht‡...아니, 없을지도 모른다‡... O quizás no‡... O quizás no‡… ou peut-être pas, après tout‡……我们没有能源‡…也許還沒好',
    nil,
    'Carregue seu Golem de Guerra com a energia de 10 Sentinelas Relâmpago e fale novamente com o Prospector Rokar na Aldeia Oneqwah.‡Подзарядите вашего Боевого голема от десяти грозовых караульных и вернитесь к геологу Рокару в Лагерь Уанква.‡Ladet Euren Kriegsgolem mit der Energie von 10 Blitzwachen auf und kehrt dann zu Ausgrabungsleiter Rokar in Camp Oneqwah zurück.‡번개 파수꾼 10마리로부터 전쟁 골렘의 에너지를 충전한 다음 원크와 야영지에 있는 발굴조사단장 로카르에게 돌아가야 합니다.‡Carga tu gólem de guerra con la energía de 10 avizores de relámpagos y regresa con el Prospector Rokar en el Campamento Oneqwah.‡Carga tu gólem de guerra con la energía de 10 avizores de relámpagos y regresa con el Prospector Rokar en el Campamento Oneqwah.‡Chargez votre Golem de guerre avec l\'énergie de 10 Factionnaires de foudre et revenez voir le Prospecteur Rokar au Camp Oneqwah.‡用10个闪电斥候身上的能量给你的作战魔像充电，然后向欧尼瓦营地的勘探员罗卡尔复命。‡從10個閃電哨兵上替你的戰爭魔像充能，然後向歐尼克瓦營地的勘察員洛卡回報。',
  }
},
[12199] = {
  {
    'Derrubando o Thane de Ferro‡Свержение железного тана‡Nieder mit dem Eisenthan!‡무쇠 영주 처단‡Acaba con el señor feudal férreo‡Acaba con el señor feudal férreo‡Renverser le thane-de-fer‡击败铁领主‡打倒鐵族長',
    nil,
    'Use as habilidades do Golem de Guerra para derrotar o Thane de Ferro Furiamalho, e em seguida fale novamente com Tormak, o Marcado, na Aldeia Oneqwah.‡Воспользовавшись особой функцией вашего Боевого голема, убейте железного тана Гневного Топора, после чего вернитесь к Тормаку Бывалому в Лагерь Уанква.‡Besiegt den Eisenthan Zornhammer mithilfe Eures Kriegsgolems und kehrt dann zu Tormak dem Vernarbten im Camp Oneqwah zurück.‡전쟁 골렘의 능력을 사용해 무쇠 영주 퓨리해머를 처치한 다음 원크와 야영지에 있는 영광의 흉터 토르마크에게 돌아가야 합니다.‡Usando las habilidades de tu gólem de guerra derrota al señor feudal férreo Martillo Furioso y después habla con Tormak el Cicatrices en el Campamento Oneqwah.‡Usando las habilidades de tu gólem de guerra derrota al señor feudal férreo Martillo Furioso y después habla con Tormak el Cicatrices en el Campamento Oneqwah.‡À l\'aide des capacités de votre Golem de guerre, vainquez le Thane de fer Marteau-de-fureur, puis retournez voir Tormak le Balafré au Camp Oneqwah.‡使用你的作战魔像去打败铁领主弗雷哈默尔，然后向欧尼瓦营地的托尔玛克复命。‡利用戰爭魔像的能力，擊敗鐵族長怒錘，接著向歐尼克瓦營地的『刀疤』托邁克回報。',
  }
},
[12200] = {
  {
    'Lágrimas de dragão esmeralda‡Слезы изумрудного дракона‡Smaragddrachentränen‡에메랄드 용의 눈물‡Lágrimas de dragón esmeralda‡Lágrimas de dragón esmeralda‡Les larmes de dragon émeraude‡翡翠龙泪‡翡翠龍之淚',
    nil,
    'O Pestífero-chefe Militão, em Perfídia, que fica no Ermo das Serpes, quer que você leve 8 Lágrimas de Dragão Esmeralda para ele.‡Принесите 8 слез изумрудного дракона главному распространителю чумы Миддлтону в Ядозлобь в Драконьем Погосте.‡Oberster Seuchenfürst Middleton in Gallgrimm in der Drachenöde möchte, dass Ihr 8 Smaragddrachentränen sammelt.‡용의 안식처에 있는 원한의 초소의 고위 역병인도자 미들턴이 에메랄드 용의 눈물 8개를 가져와 달라고 부탁했습니다.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que recojas 8 lágrimas de dragón esmeralda.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que recojas 8 lágrimas de dragón esmeralda.‡Le Porte-peste en chef Mideton, à Vexevenin dans la Désolation des dragons, vous demande de collecter 8 Larmes de dragon émeraude.‡怨毒镇的首席药剂师米德尔顿要求你收集8份翡翠龙泪。‡首席瘟疫使者米道頓需要你收集8顆翡翠龍之淚。他就在龍骨荒野上的毒怨之地裡。',
  }
},
[12201] = {
  {
    'A sombra do feitor‡Тень надзирателя‡Des Aufsehers Schatten‡감독관의 모습으로‡La sombra del Sobrestante‡La sombra del Sobrestante‡L\'ombre du surveillant‡监工的制服‡監督者的分身',
    nil,
    'Traga o Uniforme do Supervisor para o Batedor Vor\'takh na Aldeia Oneqwah, que fica na Serra Gris.‡Принесите униформу надзирателя Разведчику Вор\'такху в Лагерь Уанква.‡Bringt eine Aufseheruniform zu Späher Vor\'takh in Oneqwah.‡감독관의 제복을 원크와 야영지에 있는 척후병 보르타크에게 가져가야 합니다.‡Llévale un uniforme de sobrestante al Explorador Vor\'takh en el Campamento Oneqwah.‡Llévale un uniforme de sobrestante al Explorador Vor\'takh en el Campamento Oneqwah.‡Apportez un Uniforme de surveillant à l\'Éclaireur Vor\'takh au Camp Oneqwah.‡将监工的制服交给欧尼瓦营地的斥候沃塔肯。‡將一件監督者制服帶給歐尼克瓦營地的斥候沃塔克。',
  }
},
[12202] = {
  {
    'Cultivando uma imagem‡Улыбайтесь, вас снимают!‡Fotosafari‡색다른 사진 촬영‡Cultivando una imagen‡Cultivando una imagen‡Cultiver son image‡活灵活现‡留下倩影',
    nil,
    'Use a Câmera de Rokar para registrar as imagens de 8 Anões de Ferro em Dun Argol, e em seguida fale novamente com o Batedor Vor\'takh na Aldeia Oneqwah.‡С помощью камеры Рокара сделайте снимки 8 железных дворфов в Дун Арголе, после чего вернитесь к Разведчик Вор\'такху в Лагерь Уанква.‡Benutzt Rokars Kamera, um in Dun Argol die Bilder von 8 Eisenzwergen aufzunehmen und kehrt dann zu Späher Vor\'takh im Camp Oneqwah zurück.‡로카르의 카메라로 던 아르골에 있는 무쇠 드워프 8명의 사진을 찍은 다음 원크와 야영지에 있는 척후병 보르타크에게 돌아가야 합니다.‡Usa la Cámara de Rokar para conseguir las imágenes de 8 enanos férreos en Dun Argol, después regresa con el Explorador Vor\'takh en el Campamento Oneqwah.‡Usa la Cámara de Rokar para conseguir las imágenes de 8 enanos férreos en Dun Argol, después regresa con el Explorador Vor\'takh en el Campamento Oneqwah.‡Utilisez l\'Appareil photographique de Rokar pour enregistrer les images de 8 Nains de fer à Dun Argol, puis retournez voir l\'éclaireur Vor\'takh au Camp Oneqwah.‡前往丹厄古尔，使用罗卡尔的照相机拍摄8张铁矮人的照片，然后向欧尼瓦营地的斥候沃塔肯复命。‡使用洛卡的攝像機紀錄8位丹亞戈鐵矮人的影像，然後向歐尼克瓦營地的斥候沃塔克回報。',
  }
},
[12203] = {
  {
    'Ordens de Loken‡Приказы Локена‡Lokens Befehle‡로켄의 명령‡Las órdenes de Loken‡Las órdenes de Loken‡Les ordres de Loken‡洛肯的命令‡洛肯的命令',
    nil,
    'Use o disfarce de Feitor da Runa Férrea, intercepte a mensagem de Loken e por fim se apresente ao Batedor Vor\'takh na Aldeia Oneqwah.‡Замаскируйтесь под железного надзирателя рун, перехватите послание от Локена и передайте его разведчику Вор\'такху в Лагерь Уанква.‡Verkleidet Euch als Eisenrunenaufseher, fangt die Nachricht von Loken ab und erstattet dann Späher Vor\'takh im Camp Oneqwah Bericht.‡무쇠룬부족 감독관으로 위장한 다음 로켄이 보낸 전언을 가로채 원크와 야영지에 있는 척후병 보르타크에게 보고해야 합니다.‡Disfrázate de sobrestante Runaférrea, intercepta el mensaje de Loken y después informa al Explorador Vor\'takh en el Campamento Oneqwah.‡Disfrázate de sobrestante Runaférrea, intercepta el mensaje de Loken y después informa al Explorador Vor\'takh en el Campamento Oneqwah.‡Déguisez-vous en Surveillant Rune-de-fer, interceptez le message de Loken, puis faites votre rapport à l\'éclaireur Vor\'takh au Camp Oneqwah.‡伪装成铁符文监工，从洛肯那里截获情报，然后向欧尼瓦营地的斥候沃塔肯复命。‡把你自己偽裝成鐵符文監督者，攔截洛肯的訊息，然後回報給歐尼克瓦營地的斥候沃塔克。',
  }
},
[12204] = {
  {
    'Tá todo mundo Loken‡Во имя Локена‡In Lokens Namen‡로켄의 이름으로‡En nombre de Loken‡En nombre de Loken‡Au nom de Loken‡以洛肯之名‡以洛肯之名',
    nil,
    'Fale com Hugo Copas e Gavrocha sobre Loken, e em seguida apresente suas descobertas ao Batedor Vor\'takh na Aldeia Oneqwah.‡Поговорите с Хью Глассом и Гавроком о Локене, после чего передайте полученные сведения разведчику Вор\'такху из Лагеря Уанква.‡Redet Mit Hugh Glass und Gavrock über Loken und übermittelt Eure Erkenntnisse Späher Vor\'takh im Camp Oneqwah.‡휴 글라스와 가브록과 얘기를 하고 로켄에 관해 알아낸 다음 원크와 야영지에 있는 척후병 보르타크에게 보고해야 합니다.‡Pregunta a Hugh Copa y a Gavrock acerca de Loken, después informa de tus descubrimientos al Explorador Vor\'takh en el Campamento Oneqwah.‡Pregunta a Hugh Copa y a Gavrock acerca de Loken, después informa de tus descubrimientos al Explorador Vor\'takh en el Campamento Oneqwah.‡Interrogez Hugues Leverre et Gavrock au sujet de Loken, puis faites part de vos découvertes à l\'éclaireur Vor\'takh au Camp Oneqwah.‡与休·格兰斯和加弗洛克谈谈有关洛肯的事情，然后把你的发现汇报给欧尼瓦营地的斥候沃塔肯。‡和休·格雷斯、葛夫洛克聊聊關於洛肯的消息，並向歐尼克瓦營地的斥候沃塔克回報。',
  }
},
[12205] = {
  {
    'Procura-se: A Ofensiva Escarlate‡Разыскивается: Алый Натиск‡GESUCHT: Der Scharlachrote Ansturm‡현상 수배: 붉은돌격대‡Se busca: El Embate Escarlata‡Se busca: El Embate Escarlata‡On recherche : l\'Assaut écarlate‡通缉：血色先锋军‡懸賞:血色突襲軍',
    nil,
    'Mate 20 membros da Ofensiva Escarlate e, então, apresente-se ao Alto-executor Iracundo, em Perfídia.‡Убейте 20 членов Алого Натиска и доложите об этом верховному палачу Росу из Ядозлоби.‡Tötet 20 Mitglieder des Scharlachroten Ansturms und meldet Euch anschließend bei Hochexekutor Zürner in Gallgrimm.‡붉은돌격대의 일원 20명을 처치한 다음 원한의 초소에 있는 고위집행관 워로스에게 보고해야 합니다.‡Mata a 20 miembros de El Embate Escarlata e informa al sumo ejecutor Wroth en Rencor Venenoso.‡Mata a 20 miembros de El Embate Escarlata e informa al sumo ejecutor Wroth en Rencor Venenoso.‡Tuez 20 membres de l\'Assaut écarlate puis faites votre rapport au Grand exécuteur Ulcéré à Vexevenin.‡消灭20个血色先锋军的成员，然后向怨毒镇的高级执行官乌洛斯汇报。‡殺死20名血色突襲軍成員，並將成果回報給毒怨之地的高階執行官羅思。',
  }
},
[12206] = {
  {
    'Os ritos finais da praga‡Испорченные последние ритуалы‡Verseuchte letzte Riten‡역병으로 물든 마지막 의식‡Una extremaunción con añublo‡Una extremaunción con añublo‡Les derniers rites de la flétrissure‡测试药剂‡荒疫告別式',
    nil,
    'A Boticária Rivadávia Levine, em Perfídia, quer que você teste a Ampola de Praga no Prisioneiro da Ofensiva Escarlate.‡По просьбе аптекаря Вики Левин из Ядозлоби испробуйте настой порчи на узнике Алого Натиска.‡Apothekerin Vicky Levine in Gallgrimm möchte, dass Ihr das Seuchenfläschchen an dem Gefangenen des Scharlachroten Ansturms austestet.‡원한의 초소에 있는 연금술사 비키 레빈이 파멸의 역병 영약을 붉은돌격대 포로에게 사용해 봐 달라고 부탁했습니다.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que pruebes el frasco de añublo sobre un prisionero de El Embate Escarlata.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que pruebes el frasco de añublo sobre un prisionero de El Embate Escarlata.‡L\'Apothicaire Vicky Levine de Vexevenin vous demande de tester le Flacon de flétrissure sur le Prisonnier de l\'Assaut écarlate.‡怨毒镇的药剂师薇吉·莱文要你把药剂泼在血色先锋军士兵的身上。‡毒怨之地的藥劑師維琪·萊文要求你對血色突襲軍囚犯測試荒疫之瓶。',
  }
},
[12207] = {
  {
    'A queda de Vordrassil‡Падение Фордрассила‡Vordrassils Fall‡볼드랏실의 몰락‡La caída de Vordrassil‡La caída de Vordrassil‡La chute de Vordrassil‡沃达希尔的陨落‡沃達希爾的傾圮',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você vá até a Rama de Vordrassil, Coração de Vordrassil ou Lágrimas de Vordrassil e obtenha 6 Amostras de Visgo das Gosmas Entrópicas.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас отправиться к Ветвям Фордрассила, Сердцу Фордрассила или Слезам Фордрассила и принести ей 6 образцов слизи энтропических слизнюков.‡Windseherin Grauhorn in Burg Siegeshall möchte, dass Ihr zu Vordrassils Ast, Vordrassils Herz oder Vordrassils Tränen geht und 6 Schleimproben des entropischen Schlamms besorgt.‡정복의 요새에 있는 바람현자 그레이혼이 볼드랏실의 가지, 볼드랏실의 심장 또는 볼드랏실의 눈물로 가서 혼돈의 수액괴물로부터 수액괴물 견본 6개를 가져다달라고 부탁헀습니다.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil o a las Lágrimas de Vordrassil y consigas 6 muestras de babosa de los mocos entrópicos.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil o a las Lágrimas de Vordrassil y consigas 6 muestras de babosa de los mocos entrópicos.‡La Voyante des vents Corne-grise, du bastion de la Conquête, veut que vous alliez à la Branche de Vordrassil, au Cœur de Vordrassil ou aux Larmes de Vordrassil, pour récupérer 6 Échantillons de gelée sur des Limons entropiques.‡征服堡的风之先知希尔·灰角希望你前往沃达希尔之臂、沃达希尔之心或沃达希尔之泪，从熵能软泥怪那里取回6份软泥怪样本。‡征服堡的風先知灰角需要你前往沃達希爾之枝、沃達希爾之心與沃達希爾之淚三處，從熱能軟泥怪身上獲得6件黏液樣本。',
  }
},
[12208] = {
  {
    'Gênio introllável‡Удачи в охоте за троллями!‡Gute Trolljagd‡트롤을 사냥하라‡La caza de trols‡La caza de trols‡Bonne chasse aux trolls !‡狩猎巨魔‡食人妖獵捕手',
    nil,
    'O Sargento Thurkin mandou você falar com Samir nas Fontes Graníticas.‡Сержант Туркин отправил вас к Самиру в Гранитные ключи.‡Unteroffizier Thurkin möchte, dass Ihr mit Samir am Granitquell sprecht.‡하사관 투르킨이 화강암 웅덩이에 있는 사미르와 대화해보라고 부탁했습니다.‡El sargento Thurkin quiere que hables con Samir en el Manantial de Granito.‡El sargento Thurkin quiere que hables con Samir en el Manantial de Granito.‡Le Sergent Thurkin vous a demandé de parler à Samir, aux Sources de granit.‡苏尔肯中士希望你去跟岩石之泉的萨米尔谈一谈。‡士官蘇爾金告訴你和花崗岩之泉的山米爾交談。',
  }
},
[12209] = {
  {
    'Roubo de equipamento‡Кража материальных ценностей‡Kriegsbeute‡장비 탈취‡Saqueo de material‡Saqueo de material‡Pillage de matériel‡夺取装备‡掠奪軍品',
    nil,
    'O Intendente Bartolotto, em Perfídia, quer que você roube 8 Armaduras da Ofensiva Escarlate e 8 Armas da Ofensiva Escarlate.‡По заданию интенданта Бартлетта из Ядозлоби похитьте 8 доспехов Алого Натиска и 8 единиц оружия Алого Натиска.‡Quartiermeister Bartlett in Gallgrimm möchte, dass Ihr 8 Rüstungen des Scharlachroten Ansturms und 8 Waffen des Scharlachroten Ansturms stehlt.‡원한의 초소에 있는 병참장교 바틀릿이 붉은돌격대 방어구 8개와 붉은돌격대 무기 8개를 훔쳐와 달라고 부탁했습니다.‡El intendente Bartlett en Rencor Venenoso te ha pedido que robes 8 armaduras y 8 armas de El Embate Escarlata.‡El intendente Bartlett en Rencor Venenoso te ha pedido que robes 8 armaduras y 8 armas de El Embate Escarlata.‡L\'Intendant Bartlett de Vexevenin vous a demandé de voler 8 pièces d\'Armures de l\'Assaut écarlate et 8 Armes de l\'Assaut écarlate.‡怨毒镇的军需官巴莱特要你去夺取8件血色先锋军护甲和8件血色先锋军武器。‡毒怨之地中的軍需官巴特勒要求你偷取8件血色突襲軍護甲與8把血色突襲軍武器。',
  }
},
[12210] = {
  {
    'Temporada de caça aos trolls‡Сезон охоты на троллей!‡Trollsaison!‡트롤 사냥철!‡¡Temporada de trols!‡¡Temporada de trols!‡La chasse aux trolls est ouverte !‡狩猎巨魔的季节！‡獵食人妖季!',
    nil,
    'O Tenente Dumont, no Chalé do Pinho Âmbar, quer que você fale com Samir nas Fontes Graníticas.‡Лейтенант Думонт из Приюта Янтарной Сосны послал вас поговорить с Самиром в Гранитных ключах.‡Leutnant Dumont bei der Ammertannhütte möchte, dass Ihr mit Samir am Granitquell sprecht.‡호박빛소나무 오두막의 부관 듀몬트가 화강암 웅덩이에 있는 사미르와 이야기해 달라고 부탁했습니다.‡El teniente Dumont en el Refugio Pino Ámbar quiere que hables con Samir en el Manantial de Granito.‡El teniente Dumont en el Refugio Pino Ámbar quiere que hables con Samir en el Manantial de Granito.‡Le Lieutenant Dumont, du Gîte Ambrepin, veut que vous parliez à Samir aux Sources de granit.‡琥珀松木营地的杜蒙特中尉希望你去跟岩石之泉的萨米尔谈一谈。‡琥珀松小屋的都蒙特中尉需要你與花崗岩之泉的山米爾交談。',
  }
},
[12211] = {
  {
    'Que eles não se levantem!‡Не дадим им подняться!‡Lasst sie nicht wieder auferstehen!‡부활을 막아라!‡¡No dejes que se levanten!‡¡No dejes que se levanten!‡Qu\'ils ne se relèvent pas !‡确保他们不再站起来！‡阻止他們復活!',
    nil,
    'A Boticária Rivadávia Levine, em Perfídia, quer que você use a Caixa de Ratos para "limpar" os cadáveres de 15 membros da Ofensiva Escarlate, em Nova Amparo.‡По заданию аптекаря Вики Левин из Ядозлоби воспользуйтесь ее клеткой с крысами в Новом Дольном Очаге, чтобы ободрать дочиста 15 тел, принадлежащих Алому Натиску.‡Apothekerin Vicky Levine aus Gallgrimm hat Euch gebeten, Ihr Behältnis voller Ratten zu benutzen, um 15 Leichen von Anhängern des Scharlachroten Ansturms in Neuherdweiler zu beseitigen.‡원한의 초소에 있는 연금술사 비키 레빈이 쥐 상자를 사용해 신 하스글렌에 있는 붉은돌격대 시체 15구에서 보호 효과를 제거하는 작업을 진행해 달라고 부탁했습니다.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses su contenedor de ratas para no dejar ni rastro de 15 miembros de El Embate Escarlata en Nueva Vega del Amparo‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses su contenedor de ratas para no dejar ni rastro de 15 miembros de El Embate Escarlata en Nueva Vega del Amparo.‡L\'Apothicaire Vicky Levine de Vexevenin vous a demandé d\'utiliser sa Caisse de rats pour nettoyer les cadavres de 15 membres de l\'Assaut écarlate à la Nouvelle-Âtreval.‡怨毒镇的药剂师薇吉·莱文要你前往新壁炉谷，在15个倒下的血色先锋军成员那里使用她的老鼠箱。‡毒怨之地的藥劑師維琪·萊文要求你使用她的老鼠容器到新壁爐谷清理15具血色突襲軍成員的屍體。',
  }
},
[12212] = {
  {
    'Reabastecimento‡Пополнение запасов‡Das Lagerhaus auffüllen‡창고 채우기‡Reabasteciendo el almacén‡Reabasteciendo el almacén‡Regarnir les réserves‡补充食物‡倉庫補貨',
    nil,
    'O Mestre Mateiro Anderhol, no Chalé do Pinho Âmbar, quer que você mate Cervos Altastes e recolha 8 pedaços de Carne Suculenta.‡Старший лесник Андорхол из Приюта Янтарной Сосны просит вас убить несколько высокорогих оленей и принести ему 8 кусков сочной оленины.‡Förstermeister Anderhol bei der Ammertannhütte möchte, dass Ihr Großhornhirsche tötet und 8 Stück saftiges Wildbret sammelt.‡호박빛소나무 오두막에 있는 수렵의 대가 안델홀이 긴뿔 순록을 잡아 육즙이 많은 사슴 고기 8개를 가져다 달라고 부탁했습니다.‡El maestro trabajador forestal Anderhol del Refugio Pino Ámbar quiere que mates a venados cornaaltas y que consigas 8 trozos de venado suculento.‡El maestro trabajador forestal Anderhol del Refugio Pino Ámbar quiere que mates a venados Cornalta y que consigas 8 trozos de venado suculento.‡Le maître bûcheron Anderhol, du Gîte Ambrepin, veut que vous tuiez des Cerfs haute-ramure pour lui rapporter 8 morceaux de Venaison succulente.‡琥珀松木营地的护林主管安德霍尔希望你能去猎杀耸角雄鹿，并收集8份肥美的鹿肉。‡琥珀松小屋的護林者大師安德豪爾需要你殺死高角成鹿，並收集8塊多汁鹿肉。',
  }
},
[12213] = {
  {
    'As trevas subterrâneas‡Подземная тьма‡Die Dunkelheit darunter‡발밑의 어둠‡La oscuridad interior‡La oscuridad interior‡Les ténèbres du dessous‡地下的黑暗‡竄出的黑暗',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você vá à Rama de Vordrassil, ao Coração de Vordrassil e às Lágrimas de Vordrassil e use o Orbe do Geomante nas profundezas.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас отыскать Сердце Фордрассила, Слезы Фордрассила и Ветви Фордрассила, углубиться под землю и воспользоваться Геомантской сферой для измерения уровня энергии.‡Windseherin Grauhorn möchte, dass Ihr zu Vordrassils Herz, Vordrassils Tränen und Vordrassils Ast geht und die Kugel des Geomanten in den Tiefen unter der Erdoberfläche anwendet.‡정복의 요새에 있는 바람현자 그레이혼이 볼드랏실의 가지, 볼드랏실의 심장, 볼드랏실의 눈물 아래의 깊은 곳에서 흙점쟁이의 보주를 사용해 달라고 부탁했습니다.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil y a las Lágrimas de Vordrassil y que uses el Orbe de geomántico en las profundidades de la superficie.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil y a las Lágrimas de Vordrassil y que uses el Orbe de geomántico en las profundidades de la superficie.‡La Voyante des vents Corne-grise, du Bastion de la Conquête, veut que vous alliez à la Branche de Vordrassil, au Cœur de Vordrassil et aux Larmes de Vordrassil, et que vous utilisiez l’Orbe de géomancien dans les profondeurs sous la surface.‡征服堡的风之先知希尔·灰角希望你前往沃达希尔之臂、沃达希尔之心和沃达希尔之泪，然后在地表之下使用地占师的宝珠。‡征服堡的風先知灰角需要你前往沃達希爾之枝、沃達希爾之心與沃達希爾之淚三處，在其地表之下深處使用地卜者寶珠。',
  }
},
[12214] = {
  {
    'Novas montarias‡Новые кони‡Ersatzpferde‡새로운 탈것‡Monturas frescas‡Monturas frescas‡Des montures fraîches‡补充坐骑‡新鮮的馬匹',
    nil,
    'Alcebíades da Gama, em Perfídia, quer que você roube 3 Corcéis da Ofensiva Escarlate e os entregue, passando as rédeas para ele.‡Украдите 3 боевых коней Алого Натиска и доставьте их Ханзелу Бауэру в Ядозлобь. Передайте Ханзелу поводья из рук в руки.‡Hänsel Bauer in Gallgrimm möchte, dass Ihr 3 Kriegspferde des Ansturms stehlt, sie anschließend bei ihm abliefert und ihm dann auch die Zügel übergebt.‡원한의 초소에 있는 한셀 바우어가 붉은돌격대 전투마 3마리를 빼앗은 다음 데려와 고삐를 넘겨달라고 부탁했습니다.‡Hansel Bauer en Rencor Venenoso te ha pedido que robes 3 caballos de guerra de El Embate Escarlata y se los lleves. Para ello, entrégale las riendas.‡Hansel Bauer en Rencor Venenoso te ha pedido que robes 3 caballos de guerra de El Embate Escarlata y se los lleves. Para ello, entrégale las riendas.‡Hansel Bauer de Vexevenin vous a demandé de voler 3 Chevaux de guerre de l\'Assaut et de les lui apporter en lui donnant leurs rênes.‡怨毒镇的汉瑟·鲍尔要你牵回3匹血色先锋军战马，并将战马缰绳交给他。‡毒怨之地的漢瑟爾·包爾要求你竊取3匹突襲軍戰馬然後把韁繩交給他。',
  }
},
[12215] = {
  {
    'Situação worg-rível‡Мы или они!‡Sie oder wir!‡생존 경쟁‡¡O ellos, o nosotros!‡¡O ellos, o nosotros!‡Eux ou nous !‡你死我活！‡不是你死，就是我亡!',
    nil,
    'Anderhol, no Chalé do Pinho Âmbar, quer que você encontre e mate 6 Caçadores Brumagris na Serra Gris.‡Андерхол из Приюта Янтарной Сосны просит вас найти и убить 6 серо-дымчатых охотников в Седых холмах.‡Anderhol bei der Ammertannhütte möchte, dass Ihr in den Grizzlyhügeln nach 6 Graunebeljägern sucht und sie tötet.‡호박빛소나무 오두막에 있는 수렵의 대가 안델홀이 회색 구릉지에 가서 회색안개 늑대 6마리를 처치해 달라고 부탁했습니다.‡Anderhol en el Refugio Pino Ámbar quiere que encuentres y mates a 6 cazadores Brumacana en Las Colinas Pardas.‡Anderhol en el Refugio Pino Ámbar quiere que encuentres y mates a 6 cazadores Brumacana en Las Colinas Pardas.‡Anderhol, du Gîte Ambrepin, veut que vous tuiez 6 Chasseurs brumegrises dans les Grisonnes.‡琥珀松木营地的安德霍尔希望你能在灰熊丘陵找到并杀死6条灰雾捕猎者。‡琥珀松小屋的護林者大師安德豪爾希望你找出並殺掉6個灰白之丘的灰霧獵食者。',
  }
},
[12216] = {
  {
    'Lambada no lombo!‡Бери самое нежное!‡Bärenhatz!‡뒤에서 공격해!‡¡Cógeles el trasero!‡¡Quítales el trasero!‡Ne flanchet pas !‡猎熊！‡從後面上!',
    nil,
    'Anderhol, no Chalé do Pinho Âmbar, quer que você lhe traga 8 Lombos de Urso Pardo dos Ursos Pardos da Serra Gris.‡Андерхол из Приюта Янтарной Сосны просит вас добыть 8 боков медведей гризли, которые водятся в Седых холмах.‡Anderhol bei der Ammertannhütte möchte, dass Ihr 8 Grizzlyflanken von den Grizzlybären in den Grizzlyhügeln ergattert.‡호박빛소나무 오두막에 있는 수렵의 대가 안델홀이 회색 구릉지에 있는 회색 구릉지 곰을 잡아, 회색 구릉지 곰 살코기 8개를 구해 달라고 부탁했습니다.‡Anderhol en el Refugio Pino Ámbar quiere que recojas 8 costillares de oso de los osos pardos de Colinas Pardas.‡Anderhol en el Refugio Pino Ámbar quiere que recojas 8 costillares de oso de los osos pardos de Colinas Pardas.‡Anderhol, du Gîte Ambrepin, veut que vous récupériez 8 Flanchets de grizzly sur les Ours des Grisonnes.‡琥珀松木营地的安德霍尔希望你从灰熊丘陵的灰鬃熊身上收集8块灰鬃熊肋排。‡琥珀松小屋的安德豪爾需要你從灰白之丘的灰熊身上收集8塊灰熊腰肉。',
  }
},
[12217] = {
  {
    'Olhos de águia‡Орлиный взор‡Adleraugen‡독수리의 눈‡Ojos de águila‡Ojos de águila‡Des yeux d\'aigle‡鹰的眼睛‡鷹眼',
    nil,
    'Anderhol, no Chalé do Pinho Âmbar, quer que você mate 5 Águias Imperiais e, em seguida, fale com ele novamente.‡Андерхол из Приюта Янтарной Сосны просит вас убить 5 императорских орлов и доложить ему о выполнении задания.‡Anderhol bei der Ammertannhütte möchte, dass Ihr 5 Kaiseradler tötet und ihm anschließend Bericht erstattet.‡호박빛소나무 오두막에 있는 수렵의 대가 안델홀이 흰죽지수리 5마리를 잡은 다음 보고해 달라고 부탁했습니다.‡Anderhol en el Refugio Pino Ámbar quiere que mates a 5 águilas imperiales y que luego vuelvas a informarle.‡Anderhol en el Refugio Pino Ámbar quiere que mates a 5 águilas imperiales y que luego vuelvas a informarle.‡Anderhol, du Gîte Ambrepin, veut que vous tuiez 5 Aigles impériaux avant de revenir le voir.‡琥珀松木营地的安德霍尔希望你去消灭5只白肩鹰，然后向他复命。‡琥珀松小屋的安德豪爾需要你殺死5隻帝王雄鷹，並向他回報。',
  }
},
[12218] = {
  {
    'Espalhe as boas novas‡Добрые вести не ждут на месте‡Verbreitet die guten Neuigkeiten‡희소식 전파‡Transmite la buena nueva‡Transmite la buena nueva‡Répandez la bonne nouvelle‡传达好消息‡把好話傳出去',
    nil,
    'O Pestífero-chefe Militão, em Perfídia, no Ermo das Serpes, quer que você use a Bomba Empesteada do Vetor da Praga Renegado para destruir 30 Mortos Vorazes nos arredores dos Campos de Carniça.‡Используйте чумную бомбу распространителя гнили Отрекшихся, чтобы уничтожить 30 голодающих покойников на краю Полей Падальщиков по приказу главного распространителя чумы Миддлтона из Ядозлоби в Драконьем Погосте.‡Oberster Seuchenfürst Middleton in Gallgrimm in der Drachenöde möchte, dass Ihr in den Seuchenverbreiter der Verlassenen steigt, zu den Randgebieten der Aasfelder fahrt und dort mithilfe der Seuchenbombe 30 hungernde Tote vernichtet.‡용의 안식처의 원한의 초소에 있는 고위 역병인도자 미들턴이 포세이큰 파멸의 역병 살포기의 파멸의 역병탄을 사용해 부패의 벌판 주변에 있는 굶주린 망자 30마리를 처치해 달라고 부탁했습니다.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que utilices la bomba de añublo del propagador del añublo de los Renegados para acabar con 30 muertos hambrientos a las afueras de Los Campos de Carroña.‡El jefe pesteador Middleton en Rencor Venenoso en el Cementerio de Dragones quiere que utilices la bomba de añublo del propagador del añublo de los Renegados para acabar con 30 muertos hambrientos a las afueras de Los Campos de Carroña.‡Le Porte-peste en chef Mideton, à Vexevenin dans la Désolation des dragons, veut que vous utilisiez la Bombe chancreuse de l\'Épandeur de chancre réprouvé pour détruire 30 Morts affamés aux abords des Champs de la Charogne.‡怨毒镇的首席药剂师米德尔顿要求你使用被遗忘者凋零战车上的凋零炸弹，在腐臭平原外围消灭30名饥饿的死尸。‡位在龍骨荒野，毒怨之地的首席瘟疫使者米道頓要你使用被遺忘者荒疫散佈者的荒疫炸彈摧毀30個位於腐屍農地外圍飢餓的死屍。',
  }
},
[12219] = {
  {
    'A Árvore do Mundo fracassada‡Обломки мирового древа‡Der eingegangene Weltenbaum‡버려진 세계수‡El árbol del mundo fallido‡El Árbol del Mundo fallido‡L\'arbre-monde manqué‡倒下的世界之树‡衰退的世界樹',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você vá até a Rama de Vordrassil, Coração de Vordrassil ou Lágrimas de Vordrassil e obtenha 6 Amostras de Visgo das Gosmas Entrópicas.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас найти Ветви Фордрассила, Сердце Фордрассила или Слезы Фордрассила и принести ей 6 образцов слизи энтропических слизнюков.‡Hierophant Thayreen bei der Ammertannhütte möchte, dass Ihr zu Vordrassils Ast, Vordrassils Herz oder zu Vordrassils Tränen geht und 6 Schleimproben des entropischen Schlamms beschafft.‡호박빛소나무 오두막에 있는 제사장 타이렌이 볼드랏실의 가지, 볼드랏실의 심장, 볼드랏실의 눈물 중 한 곳에 가서, 혼돈의 수액괴물에게서 수액괴물 견본 6개를 가져다 달라고 부탁했습니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil o las Lágrimas de Vordrassil y que le traigas 6 muestras de babosas de mocos entrópicos.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil o las Lágrimas de Vordrassil y que le traigas 6 muestras de babosas de mocos entrópicos.‡La Hiérophante Thayreen, du Gîte Ambrepin, veut que vous alliez à la Branche de Vordrassil, au Cœur de Vordrassil ou aux Larmes de Vordrassil, pour récupérer 6 Échantillons de gelée sur des Limons entropiques.‡琥珀松木营地的圣职者塞瑞恩希望你前往沃达希尔之臂、沃达希尔之心或沃达希尔之泪，从熵能软泥怪那里取回6份软泥怪样本。‡琥珀松小屋的祭師賽苓需要你前去沃達希爾之枝、沃達希爾之心、和沃達希爾之淚三處，從熱能軟泥怪身上獲得6份黏液樣本。',
  }
},
[12220] = {
  {
    'Influência perversa‡Темное влияние‡Ein dunkler Einfluss‡어둠의 손길‡Una influencia oscura‡Una influencia oscura‡Une sombre influence‡黑暗的影响‡黑暗的影響',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você vá à Rama de Vordrassil, ao Coração de Vordrassil e às Lágrimas de Vordrassil e use o Orbe do Geomante nas profundezas.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас отыскать Сердце Фордрассила, Слезы Фордрассила и Ветви Фордрассила, углубиться под землю и воспользоваться Геомантской сферой для измерения уровня энергии.‡Hierophant Thayreen bei der Ammertannhütte will, dass Ihr zu Vordrassils Herz, Vordrassils Tränen und Vordrassils Ast geht und die Kugel des Geomanten in den Tiefen unter der Erdoberfläche anwendet.‡호박빛소나무 오두막에 있는 제사장 타이렌이 볼드랏실의 가지, 볼드랏실의 심장, 볼드랏실의 눈물 바닥 아래의 깊은 곳에서 흙점쟁이의 보주를 사용해 달라고 부탁했습니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil y a las Lágrimas de Vordrassil y que uses el orbe de geomántico en las profundidades bajo la superficie.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a la Extremidad de Vordrassil, al Corazón de Vordrassil y a las Lágrimas de Vordrassil y que uses el orbe de geomántico en las profundidades bajo la superficie.‡La Hiérophante Thayreen, du Gîte Ambrepin, veut que vous alliez au Cœur de Vordrassil, aux Larmes de Vordrassil et à la Branche de Vordrassil, et que vous utilisiez l’Orbe de géomancien dans les profondeurs sous la surface.‡琥珀松木营地的圣职者塞瑞恩希望你前往沃达希尔之臂、沃达希尔之心和沃达希尔之泪，然后在地表之下使用地占师的宝珠。‡琥珀松小屋的祭師賽苓需要你前往沃達希爾之枝、沃達希爾之心與沃達希爾之淚三處，在其地表之下深處使用地卜師寶珠。',
  }
},
[12221] = {
  {
    'Praga dos Renegados‡Гниль Отрекшихся‡Die Seuche der Verlassenen‡포세이큰 파멸의 역병‡El añublo de los Renegados‡El añublo de los Renegados‡La flétrissure des Réprouvés‡被遗忘者的凋零药剂‡被遺忘者荒疫',
    nil,
    'Entregue a Praga dos Renegados ao Dr. Síntar C. Málius, no Martelo de Agmar.‡Доставьте образец гнили Отрекшихся доктору Синтару Злобениусу в Молот Агмара.‡Liefert die Seuche der Verlassenen bei Doktor Sintar Malefius in Agmars Hammer ab.‡아그마르의 망치에 있는 의술사 신타르 말레피오스에게 포세이큰 파멸의 역병을 전달해야 합니다.‡Entrega el añublo de los Renegados al doctor Sintar Malefious en Martillo de Agmar.‡Entrega el añublo de los Renegados al doctor Sintar Malefious en Martillo de Agmar.‡Livrer la Flétrissure des Réprouvés au Docteur Sintar Maléfious au Marteau d\'Agmar.‡将被遗忘者的凋零药剂交给阿格玛之锤的辛塔尔·玛菲奥斯博士。‡將被遺忘者荒疫送給阿格瑪之錘的辛塔爾·瑪雷菲爾斯醫生。',
  }
},
[12222] = {
  {
    'Segredos dos flamestres‡Тайны прядильщиц пламени‡Geheimnisse der Flammenbinder‡불꽃술사의 비밀‡Secretos de las vinculadoras de llamas‡Secretos de las vinculadoras de llamas‡Les secrets des lieuses de flammes‡缚焰者的秘密‡縛火者的秘密',
    nil,
    'Traga 3 Talismãs Imbuídos de Chamas para o Mateiro Draco no Chalé do Pinho Âmbar.‡Принесите 3 огнепрочных талисмана плотнику Дрейку в Приют Янтарной Сосны.‡Bringt dem Förster Drach bei der Ammertannhütte 3 flammenerfüllte Talismane.‡불꽃 깃든 인장 3개를 호박빛소나무 오두막에 있는 수렵꾼 드레이크에게 가져가야 합니다.‡Llévale 3 talismanes imbuidos en llamas al trabajador forestal Draco en el Refugio Pino Ámbar.‡Llévale 3 talismanes imbuidos en llamas al trabajador forestal Draco en el Refugio Pino Ámbar.‡Le Bûcheron Drake, du Gîte Ambrepin, veut que vous lui rapportiez 3 Talismans imprégnés de flammes.‡将3枚烈焰能量护符交给琥珀松木营地的伐木工德拉克。‡帶3條火焰灌注咒符給琥珀松小屋的護林者崔克。',
  }
},
[12223] = {
  {
    'Reduzir as hostes‡Ослабление врага‡Die Reihen lichten‡머릿수 줄이기‡Reduciendo su número‡Disminuir las filas‡Éclaircir les rangs‡先发制人‡削弱敵軍',
    nil,
    'Mate 12 Vassalos Esfola-dragão e fale novamente com o Mateiro Draco no Chalé do Pinho Âmbar.‡Убейте 12 хускерлов из клана Укротителей драконов и вернитесь к плотнику Дрейку в Приют Янтарной Сосны.‡Tötet 12 Huscarls der Drachenschinder und kehrt anschließend zu Förster Drach in der Ammertannhütte zurück.‡용약탈부족 정예병 12명을 처치한 다음 호박빛소나무 오두막에 있는 수렵꾼 드레이크에게 돌아가야 합니다.‡Mata a 12 huscarles Desuelladragones y habla con el trabajador forestal Draco en el Refugio Pino Ámbar.‡Mata a 12 huscarles Desuelladragones y habla con el trabajador forestal Draco en el Refugio Pino Ámbar.‡Tuez 12 Huscarls écorche-dragon, puis retournez voir le Bûcheron Drake au Gîte Ambrepin.‡消灭12个掠龙侍卫，然后向琥珀松木营地的伐木工德拉克复命。‡殺死12名掠龍侍衛，返回琥珀松小屋的護林者崔克那裡。',
  }
},
[12224] = {
  {
    'A Vanguarda Kor\'kron!‡Авангард кор\'крона‡Der Vorposten der Kor\'kron!‡코르크론 선봉기지로!‡¡La Vanguardia Kor\'kron!‡¡La Vanguardia Kor\'kron!‡L\'avant-garde kor\'kronne !‡库卡隆先锋！‡柯爾克隆先鋒駐地!',
    nil,
    'Fale com Saurfang, o Jovem, na Vanguarda Kor\'kron.‡Явитесь к Саурфангу Младшему в авангард кор\'крона.‡Meldet Euch bei Saurfang dem Jüngeren im Vorposten der Kor\'kron.‡코르크론 선봉기지에 있는 사울팽의 아들에게 보고해야 합니다.‡Preséntate ante Colmillosauro el Joven en la Vanguardia Kor\'kron.‡Preséntate ante Colmillosauro el Joven en la Vanguardia Kor\'kron.‡Présentez-vous à Saurcroc le jeune à l\'Avant-garde kor\'kronne.‡前往库卡隆先锋营地，向小萨鲁法尔报到。‡向年輕的薩魯法爾回報消息，他就在柯爾克隆先鋒駐地。',
  }
},
[12225] = {
  {
    'Hmmmmm... Semente Âmbar!‡М-м-м... Янтарные желуди!‡Mmm... Bernsteinsamen!‡맛좋은 호박색 씨앗‡Mmm... ¡Grano ámbar!‡Mmm... ¡Grano ámbar!‡Mmmm… des ambregraines !‡美味的琥珀种子！‡嗯…琥珀種子!',
    nil,
    'Fale com o Mestre Mateiro Anderhol no Chalé do Pinho Âmbar.‡Поговорите с искусным резчиком по дереву Андерхолом в Приюте Янтарной Сосны.‡Sprecht mit Förstermeister Anderhol in der Ammertannhütte.‡호박빛소나무 오두막에 있는 수렵의 대가 안델홀과 이야기해야 합니다.‡Habla con el maestro trabajador forestal Anderhol en el Refugio Pino Ámbar.‡Habla con el maestro trabajador forestal Anderhol en el Refugio Pino Ámbar.‡Parlez au Maître bûcheron Anderhol au Gîte Ambrepin.‡与琥珀松木营地的护林主管安德霍尔谈一谈。‡和護林者大師安德豪爾交談，他就在琥珀松小屋。',
  }
},
[12226] = {
  {
    'Evacuação de emergência‡Ух, пронесло!‡Wieder raus damit‡시원하게 내려드립니다‡Digiriendo‡Digiriendo‡Elles ne font que passer‡种子穿肠过……‡一路暢通到底',
    nil,
    'Anderhol, no Chalé do Pinho Âmbar, quer que você lhe traga 5 Talos de Raiz Negra.‡Андерхол из Приюта Янтарной Сосны просит вас принести ему 5 стеблей чернокорня.‡Anderhol bei der Ammertannhütte möchte, dass Ihr ihm 5 Schwarzwurzelstrünke bringt.‡호박빛소나무 오두막에 있는 안델홀이 검은뿌리 줄기 5개를 가져다 달라고 부탁했습니다.‡Anderhol en Refugio Pino Ámbar quiere que le traigas 5 tallos de raíz negra.‡Anderhol en Refugio Pino Ámbar quiere que le traigas 5 tallos de raíz negra.‡Anderhol, du Gîte Ambrepin, veut que vous lui rapportiez 5 Tiges d’euphraise.‡琥珀松木营地的安德霍尔要你去收集5份黑根草杆。‡琥珀松小屋的安德豪爾需要你帶給他5株黑根莖。',
  }
},
[12227] = {
  {
    'O cumprimento do feder‡За дело!‡Tut Eure Pflicht‡볼일 보기‡Cumplir con tu deber‡Cumplir con tu deber‡Faites votre devoir‡尽你的职责‡我可幫不了你',
    nil,
    'Anderhol, no Chalé do Pinho Âmbar, quer que você tome a Sidra Redonda de Anderhol e use a casinha para recuperar as Sementes Âmbar Parcialmente Processadas.‡Андерхол из Приюта Янтарной Сосны просит вас взять слабительную настойку Андерхола и воспользоваться ближайшим туалетом, чтобы извлечь частично переваренные янтарные желуди.‡Anderhol bei der Ammertannhütte möchte, dass Ihr Anderhols Karussellstöffsche nehmt und das nahegelegene Plumpsklo aufsucht, um die teilweise verarbeiteten Bernsteinsamen zurückzuholen.‡호박빛소나무 오두막에 있는 안델홀이 근처의 화장실에서 안델홀의 주룩주룩 탄산수를 사용하여 소화되다가 만 호박색 씨앗을 가져다 달라고 부탁했습니다.‡Anderhol en Refugio Pino Ámbar quiere que cojas la sidra hidra de Anderhol y que uses la letrina cercana para recuperar el grano ámbar semiprocesado.‡Anderhol en Refugio Pino Ámbar quiere que cojas la sidra hidra de Anderhol y que uses la letrina cercana para recuperar el grano ámbar semiprocesado.‡Anderhol, du Gîte Ambrepin, veut que vous preniez le Cidre cathartique d’Anderhol et que vous vous en serviez dans les toilettes voisines, afin de récupérer les Ambregraines à moitié digérées.‡琥珀松木营地的安德霍尔希望你在附近的厕所里喝下安德霍尔的泻药，以此来取回还未消化掉的琥珀种子。‡琥珀松小屋的安德豪爾需要你飲用安德豪爾的黑根沙，並且利用附近的廁所將消化一半的琥珀種子取回來。',
  }
},
[12228] = {
  {
    '‡Возвращение магии [PH]‡Sich der Magie wieder bemächtigen‡‡Volver a adquirir la magia [PH]‡Volver a adquirir la magia [PH]‡Reacquiring the Magic [PH]‡重获法术‡重獲法術',
    nil,
    nil,
  }
},
[12229] = {
  {
    'Uma possível conexão‡Возможная связь‡Eine mögliche Verbindung‡의심스러운 관계‡Una posible relación‡Una posible relación‡Un lien possible‡可能的关联‡可能的關聯性',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você obtenha 8 amostras de Sangue de Pelurso Louco dos Pelursos da Ermida Verossangue e da Ermida Presa Raivosa.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас принести 8 образцов крови безумных фурболгов, обитающих в Святилище Кровавого Сердца и Святилище Красного Клыка.‡Windseherin Grauhorn in der Burg Siegeswall möchte, dass Ihr 8 Proben des Bluts eines wahnsinnigen Furbolgs von den Furbolgs am Schrein des Herzbluts und am Schrein des Grollfangs sammelt.‡정복의 요새에 있는 바람현자 그레이혼이 혈심장 제단과 분노의 송곳니 제단에서 광포한 펄볼그 피 8개를 가져다 달라고 부탁했습니다.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que consigas 8 unidades de sangre de fúrbolg enloquecido de los fúrbolgs en el Santuario Colmillo Iracundo y en el Santuario Sangre de Corazón.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que consigas 8 unidades de sangre de fúrbolg enloquecido de los fúrbolgs en el Santuario Colmillo Iracundo y en el Santuario Sangre de Corazón.‡La Voyante des vents Corne-grise, au Bastion de la Conquête, vous demande de vous procurer 8 échantillons de Sang de furbolg affolé sur les Furbolgs du Sanctuaire du Croc rageur et du Sanctuaire du Sang du cœur.‡征服堡的风之先知希尔·灰角要你从心血神殿和怒牙神殿的熊怪身上收集8份疯狂熊怪的血液。‡征服堡的風先知灰角需要你從怒牙聖壇和心之血聖壇的熊怪身上獲取8瓶瘋狂熊怪之血。',
  }
},
[12230] = {
  {
    'Roubando dos mestres de cerco‡Кража у осадных мастеров‡Von den Belagerungsschmieden klauen‡공성대장장이에게서 슬쩍하기‡Robando a los herreros de asedio‡Robando a los herreros de asedio‡Voler aux poliorcètes‡收取炸弹‡向攻城鐵匠行竊',
    nil,
    'O Necroguarda Molder, em Perfídia, quer que você recupere 6 Bombas de Mestre de Cerco.‡По поручению Стража смерти Молдера из Ядозлоби раздобудьте 6 осадных бомб.‡Todeswache Molder in Gallgrimm möchte, dass Ihr 6 Bomben des Belagerungsschmiedes beschafft.‡원한의 초소에 있는 죽음의경비병 몰더가 공성대장장이 폭탄 6개를 가져와 달라고 부탁했습니다.‡El guardia de la Muerte Molder en Rencor Venenoso te ha pedido que recojas 6 bombas de herrero de asedio.‡El guardia de la Muerte Molder en Rencor Venenoso te ha pedido que recojas 6 bombas de herrero de asedio.‡Le Nécrogarde Meuledur de Vexevenin vous a demandé de récupérer 6 Bombes de poliorcète.‡怨毒镇的亡灵卫兵莫德尔要你收集6颗攻城锻造师的炸弹。‡毒怨之地的亡靈衛兵莫爾德要求你拿回6個攻城鐵匠炸彈。',
  }
},
[12231] = {
  {
    'As crias do deus-urso‡Отпрыски медвежьего бога‡Die Jungen des Bärengottes‡곰 신의 후예‡La progenie del dios oso‡La progenie del dios oso‡La progéniture du dieu Ours‡熊神的后代‡熊神的後裔',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você converse com Orsonn na Ermida Presa Raivosa e Kodian na Ermida Verossangue.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас разыскать Орсонна в Святилище Красного Клыка и Кодиан в Святилище Кровавого Сердца.‡Windseherin Grauhorn in der Burg Siegeswall möchte, dass Ihr mit Orsonn am Schrein des Grollfangs und Kodian am Schrein des Herzbluts sprecht.‡정복의 요새에 있는 바람현자 그레이혼이 분노의 송곳니 제단에 있는 오르손, 혈심장 제단에 있는 코디안과 대화해봐 달라고 부탁했습니다.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que hables con Orsonn en el Santuario Colmillo Iracundo y con Kodian en el Santuario Sangre de Corazón.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que hables con Orsonn en el Santuario Colmillo Iracundo y con Kodian en el Santuario Sangre de Corazón.‡La Voyante des vents Corne-grise, au Bastion de la Conquête, vous demande de parler à Orsonn au Sanctuaire du Croc rageur et à Kodian au Sanctuaire du Sang du cœur.‡征服堡的风之先知希尔·灰角希望你去跟怒牙神殿的奥索恩和心血神殿的科蒂安谈一谈。‡征服堡的風先知灰角要求你和怒牙聖壇的歐爾嵩，以及心之血聖壇的寇荻安交談。',
  }
},
[12232] = {
  {
    'Bombardeie as balistas‡Бомбардировка баллист‡Bombardiert die Ballisten‡쇠뇌 폭파‡Bombardea las balistas‡Bombardea las balistas‡Bombarder les balistes‡炸毁弩炮‡炸毀弩砲',
    nil,
    'O Necroguarda Molder, em Perfídia, quer que você use as Bombas de Mestre de Cerco para bombardear 5 Balistas de Nova Amparo.‡По заданию Стража смерти Молдера из Ядозлоби уничтожьте 5 баллист Нового Дольного Очага с помощью осадных бомб.‡Todeswache Molder in Gallgrimm möchte, dass Ihr mit den Bomben des Belagerungsschmiedes 5 Ballisten von Neuherdweiler unter Beschuss nehmt.‡원한의 초소에 있는 죽음의경비병 몰더가 공성대장장이 폭탄을 사용해 신 하스글렌 쇠뇌 5대를 폭파해 달라고 부탁했습니다.‡El guardia de la Muerte Molder en Rencor Venenoso te ha pedido que uses las bombas de herrero de asedio para bombardear 5 balistas de Nueva Vega del Amparo.‡El guardia de la Muerte Molder en Rencor Venenoso te ha pedido que uses las bombas de herrero de asedio para bombardear 5 balistas de Nueva Vega del Amparo.‡Le Nécrogarde Meuledur de Vexevenin vous a demandé d\'utiliser les Bombes de poliorcète pour bombarder 5 Balistes de Nouvelle-Âtreval.‡怨毒镇的亡灵卫兵莫德尔要你前往新壁炉谷，利用攻城锻造师的炸弹炸毁5台新壁炉谷弩炮。‡毒怨之地的亡靈衛兵莫爾德要你使用攻城鐵匠炸彈轟炸5臺新壁爐谷弩砲。',
  }
},
[12233] = {
  {
    '[Depricated]Sewing Your Seed‡[Depricated]Высадить семена‡Den Samen aussäen‡씨앗 처리‡[Deprecated]Recoges lo que siembras‡[Deprecated]Recoges lo que siembras‡[Périmé]Semez votre graine‡处理种子‡[Depricated]含淚播種',
    nil,
    nil,
  }
},
[12234] = {
  {
    'Em busca de respostas‡Надо знать‡Das muss ich wissen‡정보 수집‡Tengo que saber‡Tengo que saber‡Besoin de savoir‡日常计划‡不可不知',
    nil,
    'A Espiã-chefe Repine, em Perfídia, quer que você roube as Ordens do Dia da Ofensiva Escarlate: Abadia, Ordens do Dia da Ofensiva Escarlate: Quartel e Ordens do Dia da Ofensiva Escarlate: Praia.‡Украдите текущие приказы Алого Натиска в аббатстве, в казармах и на побережье по просьбе госпожи шпионов Репины из Ядозлоби.‡Spionagemeisterin Repine möchte, dass Ihr die "Tagesübersicht des Scharlachroten Ansturms: Abtei", "Tagesübersicht des Scharlachroten Ansturms: Kaserne" und die "Tagesübersicht des Scharlachroten Ansturms: Strand" stehlt.‡원한의 초소에 있는 비밀요원 레피네가 붉은돌격대 일일 명령서: 수도원, 붉은돌격대 일일 명령서: 병영, 붉은돌격대 일일 명령서: 해안을 훔쳐와 달라고 부탁했습니다.‡La maestra de espías Lamento en Rencor Venenoso te ha pedido que robes las órdenes diarias de El Embate Escarlata: Abadía, las órdenes diarias de El Embate Escarlata: Barracones y las órdenes diarias de El Embate Escarlata: Playa.‡La maestra de espías Lamento en Rencor Venenoso te ha pedido que robes las órdenes diarias de El Embate Escarlata: Abadía, las órdenes diarias de El Embate Escarlata: Barracones y las órdenes diarias de El Embate Escarlata: Playa.‡La Maître-espionne Récrimine de Vexevenin vous a demandé de voler les Ordres quotidiens de l\'Assaut écarlate : abbaye, les Ordres quotidiens de l\'Assaut écarlate : caserne, les Ordres quotidiens de l\'Assaut écarlate : plage.‡怨毒镇的间谍女王瑞贝娅要你收集血色先锋军日常命令：修道院、血色先锋军日常命令：兵营和血色先锋军日常命令：海滩。‡毒怨之地的女間諜瑞派恩要求你竊取血色突襲軍每日命令:修道院、血色突襲軍每日命令:兵營和血色突襲軍每日命令:海灘。',
  }
},
[12235] = {
  {
    'Naxxramas e a queda de Invergarde‡Наксрамас и падение крепости Стражей Зимы‡Naxxramas und der Fall von Wintergarde‡윈터가드 성채와 낙스라마스‡Naxxramas y la caída de Hibergarde‡Naxxramas y la caída de Hibergarde‡Naxxramas et la chute de Garde-hiver‡纳克萨玛斯与暮冬城的陷落‡納克薩瑪斯與溫特加德的陷落',
    nil,
    'Apresente-se ao Comandante de Grifos Eurico, na estação de grifos da Bastilha Invergarde.‡Поговорите с командиром грифонов Уриком на грифоньей площадке в крепости Стражей Зимы.‡Sprecht mit dem Greifenkommandanten Urik an der Greifenstation in der Feste Wintergarde.‡윈터가드 성채의 그리핀 기지에 있는 그리핀 사령관 우릭과 이야기해야 합니다.‡Habla con el comandante de grifos Urik en la estación de grifos en la Fortaleza de Hibergarde.‡Habla con el comandante de grifos Urik en la estación de grifos en la Fortaleza de Hibergarde.‡Parlez au commandant des griffons Urik, au nid de griffons du Donjon de Garde-hiver.‡与暮冬要塞飞行点的狮鹫指挥官乌瑞克谈一谈。‡和獅鷲獸指揮官烏里克交談，他就在溫特加德要塞的獅鷲站裡。',
  }
},
[12236] = {
  {
    'Ursoc, o deus-urso‡Урсок, медвежий бог‡Ursoc, der Bärengott‡곰 신, 우르속‡Ursoc, el dios oso‡Ursoc, el dios oso‡Ursoc, le dieu Ours‡乌索克，巨熊之神‡熊神厄索克',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você encontre Tur Patafúria, próximo ao Covil de Ursoc, e derrote Ursoc com a ajuda dele. Então use as Cinzas Purificadas de Vordrassil no Cadáver de Ursoc.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас найти Тура Яролапа возле Логова Урcока и победить Урсока с его помощью. Когда Урсок падет, осыпьте его тело очищенным пеплом Фордрассила.‡Windseherin Grauhorn in Burg Siegeswall möchte, dass Ihr Tur Wutpranke in der Nähe von Ursocs Höhle findet und Ursoc mit seiner Hilfe besiegt. Streut die geläuterte Asche von Vordrassil auf Ursocs Leiche, nachdem Ihr ihn getötet habt.‡정복의 요새에 있는 바람현자 그레이혼이 우르속의 동굴 근처에서 성난발톱 투르를 찾고 그의 도움을 받아 우르속을 처치해 달라고 부탁했습니다. 일을 마치면 우르속의 시체에 정화된 볼드랏실의 재를 사용해야 합니다.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que encuentres a Tur Patafuria cerca de la guarida de Ursoc y que derrotes a Ursoc con su ayuda. Cuando hayas logrado eso, usa las Cenizas purificadas de Vordrassil con el cadáver de Ursoc.‡La Vidente del viento Cuerno Gris en Bastión de la Conquista quiere que encuentres a Tur Patafuria cerca de la guarida de Ursoc y que derrotes a Ursoc con su ayuda. Cuando hayas logrado eso, usa las Cenizas purificadas de Vordrassil con el cadáver de Ursoc.‡La Voyante des vents Corne-grise, au Bastion de la Conquête, vous demande de trouver Tur Ragepatte près de la tanière d\'Ursoc et de vaincre Ursoc avec son aide. Utilisez les Cendres purifiées de Vordrassil sur le cadavre d\'Ursoc quand ce sera fait.‡征服堡的风之先知希尔·灰角希望你能在乌索克的巢穴的附近找到图尔·怒爪，在它的帮助下打败乌索克。然后在乌索克的尸体上使用净化过的沃达希尔的灰烬。‡位在征服堡的風先知灰角要你找到厄索克之穴附近的圖爾·怒掌，在他的協助之下擊潰厄索克。達成任務之後，在厄索克的屍身上使用淨化過的沃達希爾灰燼。',
  }
},
[12237] = {
  {
    'O voo do defensor de Invergarde‡Полет защитника Стражей Зимы‡Flug des Verteidigers von Wintergarde‡윈터가드 수호병의 비행‡Vuelo del defensor de Hibergarde‡Vuelo del defensor de Hibergarde‡Le vol du défenseur de Garde-hiver‡拯救暮冬城平民‡溫特加德防衛者的航行',
    nil,
    'Resgate 10 Aldeões de Invergarde Indefesos e fale novamente com o Comandante de Grifos Eurico na Bastilha Invergarde.‡Спасите 10 беспомощных селян Стражей Зимы и возвращайтесь к командиру грифонов Урику в крепость Стражей Зимы.‡Rettet 10 hilflose Dorfbewohner von Wintergarde und kehrt anschließend zum Greifenkommandanten Urik in Wintergarde zurück.‡무력한 윈터가드 주민 10명을 구해 윈터가드 성채의 그리핀 사령관 우릭에게 돌아가야 합니다.‡Rescata a 10 habitantes de Hibergarde indefensos y vuelve con el comandante de grifos Urik a la Fortaleza de Hibergarde.‡Rescata a 10 habitantes de Hibergarde indefensos y vuelve con el comandante de grifos Urik a la Fortaleza de Hibergarde.‡Sauvez 10 Villageois de Garde-hiver sans défense, et remettez-les au Commandant des griffons Urik au Donjon de Garde-hiver.‡营救10名无助的暮冬城平民，然后向暮冬城的狮鹫指挥官乌瑞克复命。‡救出10名無助的溫特加德村民後，返回溫特加德要塞的獅鷲獸指揮官烏里克之處。',
  }
},
[12238] = {
  {
    'A limpeza de Drak\'Tharon‡Очищение Драк\'Тарона‡Die Reinigung Drak\'Tharons‡드락타론 정화‡Limpiar Drak\'Tharon‡Limpiar Drak\'Tharon‡La purification de Drak\'Tharon‡净化达克萨隆‡淨化德拉克薩隆',
    nil,
    'Drakuru quer que você use o Elixir de Drakuru no braseiro dentro de Drak\'Tharon. Para usar o Elixir do Drakuru, você precisará de 5 Mojos Implacáveis.‡Дракуру просит вас выпить эликсир возле его жаровни в Драк\'Тароне. Для использования эликсира вам понадобится пять настоев терпения.‡Drakuru möchte, dass Ihr Drakurus Elixier an seinem Kohlenbecken innerhalb Drak\'Tharons benutzt. Um das Elixier dort benutzen zu können, benötigt Ihr 5 Ausdauermojos.‡드라쿠루가 드락타론 성채 안에 있는 자신의 화로에서 드라쿠루의 비약을 사용해 달라고 부탁했습니다. 성채에서 드라쿠루의 비약을 사용하려면 인내의 모조 5개가 필요합니다.‡Drakuru quiere que uses el elixir de Drakuru en su pedestal dentro de Drak\'Tharon. Para usar el elixir de Drakuru ahí vas a necesitar 5 mojos de resistencia.‡Drakuru quiere que uses el elixir de Drakuru en su pedestal dentro de Drak\'Tharon. Para usar el elixir de Drakuru ahí vas a necesitar 5 mojos de resistencia.‡Drakuru veut que vous utilisiez l’Élixir de Drakuru au piédestal qui se trouve dans Drak’Tharon. Pour ce faire, vous aurez besoin de 5 Mojos endurcis.‡达库鲁希望你前往达克萨隆，在那里找到他的火盆。使用达库鲁的药剂需要消耗5份耐久魔精。‡德拉庫魯需要你在德拉克薩隆的火盆上使用德拉庫魯的藥劑。你需要五個耐久魔精才能使用德拉庫魯的藥劑。',
  }
},
[12239] = {
  {
    'A espiã em Nova Amparo‡Шпион в Новом Дольном Очаге‡Der Spion in Neuherdweiler‡신 하스글렌의 요원‡La espía en Nueva Vega del Amparo‡La espía en Nueva Vega del Amparo‡L\'espionne de Nouvelle-Âtreval‡新壁炉谷的卧底‡新壁爐谷中的間諜',
    nil,
    'Entregue as Ordens do Dia da Ofensiva Escarlate para a Agente Skully, em Nova Amparo.‡Доставьте текущие приказы Алого Натиска агенту Скулли в Новый Дольный Очаг.‡Liefert die Tagesübersicht des Scharlachroten Ansturms bei Agentin Skully in Neuherdweiler ab.‡붉은돌격대 일일 명령서를 신 하스글렌에 있는 요원 스컬리에게 전달해야 합니다.‡Entrega las órdenes diarias de El Embate Escarlata a la agente Skully en Nueva Vega del Amparo.‡Entrega las órdenes diarias de El Embate Escarlata a la agente Skully en Nueva Vega del Amparo.‡Apportez les Ordres quotidiens de l\'Assaut écarlate à l\'Agent Skoulis à la Nouvelle-Âtreval.‡将血色先锋军日常命令交给新壁炉谷的斯古莉探员。‡將血色突襲軍每日命令交給人在新壁爐谷的史考莉探員。',
  }
},
[12240] = {
  {
    'Meios para um fim‡Цель и средства‡Ein Mittel zum Zweck‡끝내기 위한 방법‡Medios para un fin‡Medios para un fin‡Un moyen pour une fin‡解决方案‡解決手段',
    nil,
    'A Boticária Rivadávia Levine, em Perfídia, quer que você use os Cupins da Família Levine para atrair o Encarregado Kaleiki e matá-lo.‡Используйте термитов семейки Левин, чтобы выманить штейгера Калейки и убить его по просьбе аптекаря Вики Левин из Ядозлоби.‡Apothekerin Vicky Levine in Gallgrimm möchte, dass Ihr mithilfe der Termiten der Levinefamilie Großknecht Kaleiki hervorlockt und ihn tötet.‡원한의 초소에 있는 연금술사 비키 레빈이 레빈 가문의 흰개미통을 사용해 현장감독 칼레이키를 유인하여 처치해 달라고 부탁했습니다.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses las termitas de la familia Levine para sacar al supervisor Kaleiki y matarlo.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses las termitas de la familia Levine para sacar al supervisor Kaleiki y matarlo.‡L\'Apothicaire Vicky Levine de Vexevenin vous a demandé d\'utiliser les Termites de la famille Levine afin d\'attirer le contremaître Kaleiki à l\'extérieur et de le tuer.‡怨毒镇的药剂师薇吉·莱文要你利用莱温家族白蚁将工头卡列基引诱出来，然后杀死他。‡毒怨之地的藥劑師維琪·萊文要求你使用萊文家族白蟻來誘出工頭卡列基，並且把他殺掉。',
  }
},
[12241] = {
  {
    'Destrua a muda‡Уничтожить саженец‡Zerstört den Schössling‡나무정령의 묘목‡Destruir el árbol joven‡Destruir el árbol joven‡Détruisez l\'arbrisseau‡摧毁树苗‡摧毀樹苗',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você use a Tocha Verdejante para queimar a Muda de Vordrassil. Traga as Cinzas de Vordrassil para Vidente Chifre Cinzento.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас взять лиственный факел и сжечь саженец Фордрассила. Принесите пепел Фордрассила Серому Рогу.‡Windseherin Grauhorn in Burg Siegeswall möchte, dass Ihr die grüne Fackel nehmt und sie benutzt, um Vordrassils Schössling zu verbrennen. Bringt Vordrassils Asche zurück zu Windseher Grauhorn.‡정복의 요새에 있는 바람현자 그레이혼이 신록의 횃불을 사용하여 볼드랏실의 묘목을 불태워 달라고 부탁했습니다. 볼드랏실의 재를 바람현자 그레이혼에게 가져가야 합니다.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que cojas la Antorcha verdeante y que la uses para quemar el árbol joven de Vordrassil. Dale las Cenizas de Vordrassil a la Vidente del viento Cuerno Gris.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que cojas la Antorcha verdeante y que la uses para quemar el árbol joven de Vordrassil. Dale las Cenizas de Vordrassil a la Vidente del viento Cuerno Gris.‡La Voyante des vents Corne-grise, au Bastion de la Conquête, veut que vous preniez la Torche verdoyante et que vous vous en serviez pour brûler l’Arbrisseau de Vordrassil. Ensuite, rapportez les Cendres de Vordrassil à la Voyante des vents Corne-grise.‡征服堡的风之先知希尔·灰角希望你用翠绿火炬去焚烧沃达希尔的树苗。将沃达希尔的灰烬带回去交给风之先知希尔·灰角。‡征服堡的風先知灰角需要你拿著嫩綠火炬，使用它燒盡沃達希爾樹苗。將沃達希爾灰燼交給風先知灰角。',
  }
},
[12242] = {
  {
    'As sementes de Vordrassil‡Семена Фордрассила‡Vordrassils Samen‡볼드랏실의 씨앗‡Las semillas de Vordrassil‡Las semillas de Vordrassil‡Les graines de Vordrassil‡沃达希尔的种子‡沃達希爾種子',
    nil,
    'A Vidente Chifre Cinzento, no Forte da Conquista, quer que você vá até a Bocaina Velha e obtenha 8 das Sementes de Vordrassil.‡Заклинательница ветра Серый Рог из Крепости Завоевателей просит вас отправиться в Седую Пасть и принести ей 8 семян Фордрассила.‡Windseherin Grauhorn in Burg Siegeswall möchte, dass Ihr nach Grauschlund geht und 8 Samen von Vordrassil beschafft.‡정복의 요새에 있는 바람현자 그레이혼이 회색구렁 요새에 가서 볼드랏실의 씨앗 8개를 가져다달라고 부탁했습니다.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que vayas a Fauceparda y consigas 8 semillas de Vordrassil.‡La Vidente del viento Cuerno Gris en el Bastión de la Conquista quiere que vayas a Fauceparda y consigas 8 semillas de Vordrassil.‡La Voyante des vents Corne-grise, du Bastion de la Conquête, veut que vous alliez à Grisegueule pour y récupérer 8 Graines de Vordrassil.‡征服堡的风之先知希尔·灰角希望你前往灰喉堡取回8颗沃达希尔的种子。‡征服堡的風先知灰角要求你前往灰喉鎮拾取8顆沃達希爾種子。',
  }
},
[12243] = {
  {
    'Fogo sobre as águas‡Огонь над водами‡Feuer auf dem Wasser‡수면 위의 불꽃‡Fuego sobre las aguas‡Fuego sobre las aguas‡Feu sur les eaux‡水火之灾‡水火同源',
    nil,
    'A Boticária Rivadávia Levine, em Perfídia, quer que você use a Água Escaldante da Boticária para incendiar as velas do Extravagância do Pecador.|n|nEnquanto os taifeiros estiverem ocupados tentando apagar o fogo, vá para o alojamento do capitão e pegue as Cartas Náuticas do Capitão Selmo.‡По заданию аптекаря Вики Левин из Ядозлоби воспользуйтесь Пылающей водой аптекаря, чтобы поджечь паруса "Глупости Грешника".|n|nПока матросы будут заняты тушением пожара, спуститесь вниз и раздобудьте у капитана лоцию капитана Шели.‡Apothekerin Vicky Levine in Gallgrimm möchte, dass Ihr mithilfe des Feuerwassers des Apothekers die Segel der Sündenbabel in Brand steckt.|n|nGeht unter Deck, während die Deckmatrosen damit beschäftigt sind, das Feuer zu löschen, und sucht nach Kapitän Shelys Seekarten.‡원한의 초소에 있는 연금술사 비키 레빈이 불신자의 만용호에서 연금술사의 불타는 물을 사용하여 돛을 불태워 달라고 부탁했습니다.|n|n선원들이 불을 끄느라 분주한 동안 선실로 들어가 선장에게서 선장 쉘리의 항해도를 가져와야 합니다.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses el agua de fuego de la boticaria para prender fuego a las velas del Locura del Pecador.|n|nMientras los marineros de cubierta estén ocupados intentando apagar el fuego, dirígete a la cubierta inferior y recupera las rutas del capitán Shely, en posesión del capitán.‡La boticaria Vicky Levine en Rencor Venenoso te ha pedido que uses el agua de fuego de la boticaria para prender fuego a las velas del Locura del Pecador.|n|nMientras los marineros de cubierta estén ocupados intentando apagar el fuego, dirígete a la cubierta inferior y recupera las rutas del capitán Shely, en posesión del capitán.‡L\'Apothicaire Vicky Levine de Vexevenin vous a demandé d\'utiliser son Eau brûlante de l\'apothicaire afin de mettre le feu aux voiles de la Folie du pécheur.|n|nPendant que les matelots seront occupés à tenter d\'éteindre l\'incendie, descendez sous le pont et récupérez les Portulans du capitaine Shely sur celui-ci.‡龙骨荒野怨毒镇的药剂师薇吉·莱文要求你在罪人的愚行号的船帆上使用药剂师的燃烧液，将船帆点燃。|n|n在水手们忙着灭火的时候，前往下层甲板偷取舍雷船长的航海图。‡毒怨之地的藥劑師維琪·萊文要你用藥劑師的燃燒之水在罪人愚行號的船帆上放火。|n|n在船員忙著滅火的時候，進入船艙從船長身上取得雪利船長的航海指針。',
  }
},
[12244] = {
  {
    'Conserte o retalhador‡Починка крошшеров‡Schredder reparieren‡벌목기 수리‡Reparación de trituradoras‡Reparación de trituradoras‡Réparation de déchiqueteurs‡翻修伐木机‡伐木機維修',
    nil,
    'Synipus, na Madeireira Céu Azul, quer que você lhe traga 3 Retalhadores Quebrados.‡Синипус с Лесозаготовок Синего Неба просит вас привезти ему 3 сломанных крошшера.‡Synipus beim Holzfällerposten Blauhimmel möchte, dass Ihr ihm 3 kaputte Schredder bringt.‡푸른 하늘 벌목장에 있는 시니푸스가 망가진 벌목기 3대를 몰고 와 달라고 부탁했습니다.‡Synipus del Aserradero Cielo Azul quiere que le traigas de vuelta 3 trituradoras averiadas.‡Synipus del Aserradero Cielo Azul quiere que le traigas de vuelta 3 trituradoras averiadas.‡Synipus, du Chantier d’abattage du Ciel bleu, veut que vous lui rapportiez 3 Déchiqueteurs en panne.‡蓝天伐木场的塞尼普斯希望你将3台瘫痪的伐木机带回去交给他。‡藍天伐木地的辛尼普斯需要你帶3台壞掉的伐木機給他。',
  }
},
[12245] = {
  {
    'Sem piedade para com os prisioneiros‡Никакой пощады пленникам‡Keine Gnade für Gefangene‡포로를 위한 자비는 없다‡Ninguna piedad con los cautivos‡Ninguna piedad con los cautivos‡Pas de pitié pour les captifs‡毫不留情‡格殺俘虜',
    nil,
    'A Espiã-chefe Repine quer que você mate a Necroguarda Xavier, o Escrivão-mestre Kinnedius, o Engenheiro Braga e o Chanceler Amai.|n|nDepois de cumprir a tarefa, relate seu sucesso ao Alto-executor Iracundo em Perfídia.‡По поручению главы шпионов Репайн убейте Стража смерти Шнайдера, главного писаря Киннедия, инженера Бурка и канцлера Амай.|n|nКогда выполните это задание, сообщите об этом верховному палачу Росу в Ядозлобь.‡Spionagemeisterin Repine hat Euch gebeten, Todeswache Schneider, Chefschreiber Kinnedius, Ingenieur Hindermann und Kanzler Amai zu töten.|n|nFalls Ihr Erfolg habt, berichtet Hochexekutor Zürner in Gallgrimm davon.‡첩보단장 레피네가 죽음경비병 슈나이더, 상급 서기관 키네디우스, 기술자 버크, 장관 아마이를 처치해 달라고 했습니다.|n|n임무를 완료하면 원한의 초소에 있는 고위집행관 워로스에게 보고해야 합니다.‡La maestra de espías Lamento te ha pedido que mates al guardia de la muerte Schneider, al escribano jefe Kinnedius, al ingeniero Burke y al canciller Amai.|n|nCuando hayas cumplido esta tarea, informa de tu éxito al sumo ejecutor Wroth en Rencor Venenoso.‡La maestra de espías Lamento te ha pedido que mates al guardia de la Muerte Schneider, al escribano jefe Kinnedius, al ingeniero Burke y al canciller Amai.|n|nCuando hayas cumplido esta tarea, informa de tu éxito al sumo ejecutor Wroth en Rencor Venenoso.‡La Maître-espionne Récrimine de Vexevenin vous a demandé de tuer le Nécrogarde Schneider, le Copiste en chef Kinnedius, l’Ingénieur Burke et le Chancelier Amai.|n|nQuand vous aurez accompli cette tâche, allez faire part de votre succès au Grand exécuteur Ulcéré à Vexevenin.‡间谍女王瑞贝娅要求你去杀死亡灵卫兵斯克尼德、首席抄写员基尼迪乌斯、工程师布尔克和司法官亚麦。|n|n完成任务后，向怨毒镇的高级执行官乌洛斯复命。‡女間諜瑞派恩要求你除去亡靈衛兵施耐德，資深書記金尼迪斯，工程師波奇，以及大法官亞邁。|n|n任務完成之後，與毒怨之地的高階執行官羅思回報你完成的消息。',
  }
},
[12246] = {
  {
    'Uma possível conexão‡Возможная связь‡Eine mögliche Verbindung‡의심스러운 관계‡Una posible relación‡Una posible relación‡Un lien possible‡可能的关联‡可能的關聯性',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você obtenha 8 amostras de Sangue de Pelurso Louco dos Pelursos da Ermida Verossangue e da Ermida Presa Raivosa.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас принести 8 образцов безумных фурболгов, обитающих в Святилище Кровавого Сердца и Святилище Красного Клыка.‡Hierophant Thayreen bei der Ammertannhütte möchte, dass Ihr am Schrein des Grollfangs und am Schrein des Herzbluts 8 Blutproben von wahnsinnigen Furbolgs sammelt.‡호박빛소나무 오두막에 있는 제사장 타이렌이 혈심장 제단이나 분노의 송곳니 제단에서 광포한 펄볼그 피 8개를 가져다 달라고 부탁했습니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que consigas 8 unidades de sangre de fúrbolg enloquecido de los fúrbolgs en el Santuario Colmillo Iracundo y en el Santuario Sangre de Corazón.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que consigas 8 unidades de sangre de fúrbolg enloquecido de los fúrbolgs en el Santuario Colmillo Iracundo y en el Santuario Sangre de Corazón.‡La Hiérophante Thayreen, au Gîte Ambrepin, vous demande de vous procurer 8 échantillons de Sang de furbolg affolé sur les furbolgs du Sanctuaire du Croc rageur et du Sanctuaire du Sang du cœur.‡琥珀松木营地的圣职者塞瑞恩要你从心血神殿和怒牙神殿的熊怪身上收集8份疯狂熊怪的血液。‡琥珀松小屋的祭師賽苓需要你從心之血聖壇和怒牙聖壇的熊怪身上獲取8瓶瘋狂熊怪之血。',
  }
},
[12247] = {
  {
    'Filhos de Ursoc‡Дети Урсока‡Kinder von Ursoc‡우르속의 후예‡Hijos de Ursoc‡Hijos de Ursoc‡Les enfants d\'Ursoc‡乌索克的孩子‡厄索克的子嗣',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você converse com Orsonn na Ermida Presa Raivosa e Kodian na Ermida Verossangue.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас разыскать Орсонна в Святилище Красного Клыка и Кодиан в Святилище Кровавого Сердца.‡Hierophant Thayreen bei der Ammertannhütte möchte, dass Ihr mit Orsonn im Schrein des Grollfangs und mit Kodian im Schrein des Herzensblutes sprecht.‡호박빛소나무 오두막에 있는 제사장 타이렌이 분노의 송곳니 제단에 있는 오르손과 혈심장 제단에 있는 코디안과 이야기해 달라고 부탁했습니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que hables con Orsonn en el Santuario Colmillo Iracundo y con Kodian en el Santuario Sangre de Corazón.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que hables con Orsonn en el Santuario Colmillo Iracundo y con Kodian en el Santuario Sangre de Corazón.‡La Hiérophante Thayreen, au Gîte Ambrepin, vous demande de parler à Orsonn au Sanctuaire du Croc rageur et à Kodian au Sanctuaire du Sang du cœur.‡琥珀松木营地的圣职者塞瑞恩希望你去跟怒牙神殿的奥索恩和心血神殿的科蒂安谈一谈。‡琥珀松小屋的祭師賽苓需要你和怒牙聖壇的歐爾嵩、心之血聖壇的寇荻安交談。',
  }
},
[12248] = {
  {
    'A muda de Vordrassil‡Саженец Фордрассила‡Vordrassils Schössling‡볼드랏실의 묘목‡El árbol joven de Vordrassil‡El árbol joven de Vordrassil‡L\'arbrisseau de Vordrassil‡沃达希尔的树苗‡沃達希爾樹苗',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você use a Tocha Verdejante para queimar a Muda de Vordrassil. Traga as Cinzas de Vordrassil para Hierofante Theyreen.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас взять зеленый факел и сжечь саженец Фордрассила. Принесите ей пепел Фордрассила.‡Hierophant Thayreen in der Ammertannhütte möchte, dass Ihr mithilfe der grünen Fackel Vordrassils Schössling anzündet und ihr die daraus entstehende Asche von Vordrassil bringt.‡호박빛소나무 오두막에 있는 제사장 타이렌이 신록의 횃불을 가지고 가서 볼드랏실의 묘목을 불태워 달라고 부탁했습니다. 볼드랏실의 재를 제사장 타이렌에게 가져가야 합니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que cojas la Antorcha verdeante y que la uses para quemar el árbol joven de Vordrassil. Llévale las cenizas de Vordrassil a la Hierofante Thayreen.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que cojas la Antorcha verdeante y que la uses para quemar el árbol joven de Vordrassil. Llévale las cenizas de Vordrassil a la Hierofante Thayreen.‡La Hiérophante Thayreen, au Gîte Ambrepin, vous demande de prendre la Torche verdoyante et de l\'utiliser pour brûler l\'Arbrisseau de Vordrassil. Rapportez les Cendres de Vordrassil au Hiérophante Thayreen.‡琥珀松木营地的圣职者塞瑞恩希望你用翠绿火炬焚烧沃达希尔的树苗。将沃达希尔的灰烬带回去交给她。‡琥珀松小屋的祭師賽苓需要你拿著嫩綠火炬，使用它燒盡沃達希爾樹苗。將沃達希爾灰燼交給祭師賽苓。',
  }
},
[12249] = {
  {
    'Ursoc, o deus-urso‡Урсок, медвежий бог‡Ursoc, der Bärengott‡곰 신, 우르속‡Ursoc, el dios oso‡Ursoc, el dios oso‡Ursoc, le dieu Ours‡乌索克，巨熊之神‡熊神厄索克',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você encontre Tur Patafúria, próximo ao Covil de Ursoc, e derrote Ursoc com a ajuda dele. Então use as Cinzas Purificadas de Vordrassil no Cadáver de Ursoc.‡Иерофант Тайрин из Приюта Янтарной Сосны просит вас найти Тура Яролапа возле Логова Урcока и победить Урсока с его помощью. Когда Урсок падет, осыпьте его тело очищенным пеплом Фордрассила.‡Hierophant Thayreen bei der Ammertannhütte möchte, dass Ihr Tur Wutpranke in der Nähe von Ursocs Höhle aufsucht und mit seiner Hilfe Ursoc besiegt. Streut anschließend die geläuterte Asche von Vordrassil auf Ursocs Leiche.‡호박빛소나무 오두막에 있는 제사장 타이렌이 우르속의 동굴 근처에서 성난발톱 투르를 찾아 달라고 부탁했습니다. 그의 도움을 받아 우르속을 처치한 후, 우르속의 시체에 정화된 볼드랏실의 재를 사용해야 합니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que encuentres a Tur Patafuria cerca de la guarida de Ursoc y derrotes a Ursoc con su ayuda. Cuando hayas logrado esto, usa las Cenizas purificadas de Vordrassil en el cadáver de Ursoc.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que encuentres a Tur Patafuria cerca de la guarida de Ursoc y derrotes a Ursoc con su ayuda. Cuando hayas logrado esto, usa las Cenizas purificadas de Vordrassil en el cadáver de Ursoc.‡La Hiérophante Thayreen, au Gîte Ambrepin, vous demande de trouver Tur Ragepatte près de la tanière d\'Ursoc et de vaincre Ursoc avec son aide. Utilisez les Cendres purifiées de Vordrassil sur le cadavre d\'Ursoc quand ce sera fait.‡琥珀松木营地的圣职者塞瑞恩希望你能在乌索克的巢穴的附近找到图尔·怒爪，在他的帮助下打败乌索克。然后在乌索克的尸体上使用净化过的沃达希尔的灰烬。‡琥珀松小屋的祭師賽苓要你找到厄索克之穴附近的圖爾·怒掌，在他的協助之下擊潰厄索克。達成任務之後，在厄索克的屍身上使用淨化過的沃達希爾灰燼。',
  }
},
[12250] = {
  {
    'As sementes de Vordrassil‡Семена Фордрассила‡Vordrassils Samen‡볼드랏실의 씨앗‡Las semillas de Vordrassil‡Las semillas de Vordrassil‡Les graines de Vordrassil‡沃达希尔的种子‡沃達希爾種子',
    nil,
    'A Hierofante Theyreen, no Chalé do Pinho Âmbar, quer que você vá até a Bocaina Velha e obtenha 8 das Sementes de Vordrassil.‡Иерофант Тайрин из Приюта Янтарной Сосны из Крепости Завоевателей просит вас отправиться в Седую Пасть и принести ей 8 семян Фордрассила.‡Hierophant Thayreen in der Ammertannhütte will, dass Ihr zum Grauschlund geht und 8 Samen von Vordrassil besorgt.‡호박빛소나무 오두막에 있는 제사장 타이렌이 회색구렁 요새에 가서 볼드랏실의 씨앗 8개를 가져다 달라고 부탁했습니다.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a Fauceparda y consigas 8 semillas de Vordrassil.‡La Hierofante Thayreen en el Refugio Pino Ámbar quiere que vayas a Fauceparda y consigas 8 semillas de Vordrassil.‡La Hiérophante Thayreen, au Gîte Ambrepin, vous demande d\'aller à Grisegueule et de vous procurer 8 Graines de Vordrassil.‡琥珀松木营地的圣职者塞瑞恩希望你前往灰喉堡取回8颗沃达希尔的种子。‡琥珀松小屋的祭師賽苓要求你前往灰喉鎮拾取8顆沃達希爾種子。',
  }
},
[12251] = {
  {
    'Apresentação ao Alto-comandante‡Возвращение к верховному главнокомандующему‡Kehrt zum Oberkommandanten zurück‡총사령관에게 돌아가기‡Regresa junto al Alto Comandante‡Regresa junto al Alto comandante‡Retourner voir le haut-commandant‡向高级指挥官复命‡向高階指揮官回報',
    nil,
    'Fale com o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, que fica no Ermo das Serpes.‡Поговорите с верховным главнокомандующим Халфордом Змеевержцем в крепости Стражей Зимы на Драконьем Погосте.‡Sprecht mit Oberkommandant Halford Wyrmbann in Wintergarde in der Drachenöde.‡용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인과 대화해야 합니다.‡Habla con el alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Habla con el alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Parlez au Haut-commandant Halford Verroctone, au Donjon de Garde-hiver dans la Désolation des dragons.‡前往龙骨荒野的暮冬要塞，与高级指挥官哈尔弗·维姆班恩谈一谈。‡與龍骨荒野上，溫特加德要塞的高階指揮官海弗德·龍禍談話。',
  }
},
[12252] = {
  {
    'Torture o torturador‡Истязание истязателя‡Foltert den Folterer‡고문관 고문하기‡Tortura al torturador‡Tortura al torturador‡Torturer le tortionnaire‡拷问者里克拉夫‡折磨拷問者',
    nil,
    'O Alto-executor Iracundo, em Perfídia, quer que você use o ferro de marcar 5 vezes no Torturador Alphonse para extrair as informações dele. Depois disso, mate-o.‡По поручению верховного палача Роса из Ядозлоби пять раз припечатайте клеймом истязателя Альфонса, чтобы вытянуть из него нужную информацию. Получив ее, убейте Альфонса.‡Hochexekutor Zürner in Gallgrimm möchte, dass Ihr Folterer Alphonse fünfmal mit dem Brandeisen bearbeitet und die Informationen aus ihm herausquetscht. Anschließend sollt Ihr ihn töten.‡원한의 초소에 있는 고위집행관 워로스가 고문관 알폰스에게 쇠도장을 사용하여 5번 낙인을 찍어 정보를 캐낸 다음 그를 처치해 달라고 했습니다.‡El sumo ejecutor Wroth en Rencor Venenoso quiere que uses el hierro de marcar 5 veces sobre el torturador Alphonse para sonsacarle la información. Después, mátalo.‡El sumo ejecutor Wroth en Rencor Venenoso quiere que uses el hierro de marcar 5 veces sobre el torturador Alphonse para sonsacarle la información. Después, mátalo.‡Le Grand exécuteur Ulcéré de Vexevenin vous demande d’utiliser 5 fois le Fer à marquer sur le Tortionnaire Alphonse pour obtenir de lui les informations désirées. Ensuite, tuez-le.‡怨毒镇的高级执行官乌洛斯要你对拷问者阿方斯连续使用5次权杖，获得情报后回来报告。‡毒怨之地的高階執行官羅思要你在拷問者阿爾馮斯身上使用5次烙鐵來拷問出情報。然後殺了他。',
  }
},
[12253] = {
  {
    'Resgate na praça‡Спасение с городской площади‡Rettung vom Marktplatz‡마을 주민 구출 작전‡Rescátalos de Plaza de la Ciudad‡Rescátalos de Plaza de la Ciudad‡Sauvés de la place du village‡拯救暮冬城的平民‡城鎮廣場救援行動',
    nil,
    'O Alto-comandante Haraldo Serpecida na Bastilha Invergarde, no Ermo das Serpes, quer quer você resgate 6 Aldeões de Invergarde Presos.‡Спасите 6 пойманных жителей крепости Стражей Зимы по просьбе главнокомандующего Халфорда Змеевержца из крепости Стражей Зимы в Драконьем Погосте.‡Oberkommandant Halford Wyrmbann in der Feste Wintergarde in der Drachenöde möchte, dass Ihr 6 gefangene Dorfbewohner von Wintergarde befreit.‡용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인이 갇혀 있는 윈터가드 주민 6명을 구출해 달라고 부탁했습니다.‡El alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que rescates a 6 habitantes de Hibergarde atrapados.‡El alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que rescates a 6 habitantes de Hibergarde atrapados.‡Le Haut-commandant Halford Verroctone, au Donjon de Garde-hiver, dans la Désolation des dragons, vous a demandé de sauver 6 Villageois de Garde-hiver piégés.‡暮冬要塞的高级指挥官哈尔弗·维姆班恩要求你救回6名被困的暮冬城平民。‡溫特加德要塞的高階指揮官海弗德·龍禍要你去拯救6個受困的溫特加德村民。',
  }
},
[12254] = {
  {
    'Oração do Moribundo‡Без молитвы – никак‡Ohne Gebet‡결정적인 단서‡Sin una oración‡Sin una oración‡Sans une prière‡祈祷之书‡除去祈禱',
    nil,
    'A Agente Skully, em Nova Amparo, quer que você obtenha o Livro de Orações do Bispo Alameda.‡По заданию агента Скулли из Нового Дольного Очага раздобудьте молитвенник епископа Стрита.‡Agentin Skully in Neuherdweiler möchte, dass Ihr das Gebetsbuch von Bischof Straß besorgt.‡신 하스글렌에 있는 요원 스컬리가 주교 스트리트의 기도서를 가져와 달라고 부탁했습니다.‡La agente Skully en Nueva Vega del Amparo te ha pedido que consigas el libro de oración del Obispo Calle.‡La agente Skully en Nueva Vega del Amparo te ha pedido que consigas el libro de oración del Obispo Calle.‡L\'Agent Skoulis, à la Nouvelle-Âtreval, vous a demandé de vous procurer le Livre de prières de l\'évêque Delarue.‡新壁炉谷的斯古莉探员要求你去弄到斯崔特主教的祈祷之书。‡新壁爐谷的史考莉探員要你取得主教史曲特的祈禱書。',
  }
},
[12255] = {
  {
    'O thane dos Runavold‡Тан Волдруна‡Der Than von Voldrune‡볼드룬의 영주‡El señor feudal de Runavold‡El señor feudal de Runavold‡Le thane de Voldrune‡沃德伦的领主‡沃德盧恩的族長',
    nil,
    'Use Flamarauto para derrotar o Thane Torvald Eriksson e se apresente ao Mateiro Draco no Chalé do Pinho Âmbar.‡Одержите победу над таном Торвальдом Эрикксоном с помощью Огнедышащего и доложите об успехе плотнику Дрейку из Приюта Янтарной Сосны.‡Besiegt mithilfe von Flammenbringer den Than Torvald Eriksson und meldet Euch anschließend bei Förster Drach bei der Ammertannhütte.‡불꽃인도자를 조종하여 영주 토르발트 에릭슨을 처치하고 호박빛소나무 오두막에 있는 수렵꾼 드레이크에게 보고해야 합니다.‡Usa a Clamallamas para derrotar al señor feudal Torvald Eriksson e informa al trabajador forestal Draco en el Refugio Pino Ámbar.‡Usa a Clamallamas para derrotar al señor feudal Torvald Eriksson e informa al trabajador forestal Draco en el Refugio Pino Ámbar.‡Utilisez Porte-flamme pour vaincre le Thane Torvald Eriksson, puis faites votre rapport au Bûcheron Drake au Gîte Ambrepin.‡利用烈焰使者击败托瓦德·埃里克森领主，然后向琥珀松木营地的伐木工德拉克复命。‡利用烈焰使者擊敗族長特沃德·艾利克森，然後向琥珀松小屋的護林者崔克回報。',
  }
},
[12256] = {
  {
    'O segredo dos flamestres‡Тайны огневязов‡Geheimnis der Flammenbinder‡불꽃술사의 비밀‡Los secretos de las vinculadoras de llamas‡Los secretos de las vinculadoras de llamas‡Les secrets des lieuses de flammes‡缚焰者的秘密‡縛火者之秘',
    nil,
    'Traga 3 Talismãs Impregnados de Chamas para o Sargento Nazgrim no Forte da Conquista.‡Принесите 3 огнепрочных талисмана сержанту Назгриму в Крепость Завоевателей.‡Bringt 3 flammenerfüllte Talismane zu Unteroffizier Nazgrim in Burg Siegeswall.‡불꽃 깃든 인장 3개를 정복의 요새에 있는 하사관 나즈그림에게 가져가야 합니다.‡Llévale 3 talismanes imbuidos en llamas al Sargento Nazgrim en el Bastión de la Conquista.‡Llévale 3 talismanes imbuidos en llamas al Sargento Nazgrim en el Bastión de la Conquista.‡Apportez 3 Talismans imprégnés de flammes au Sergent Nazgrim au Bastion de la Conquête.‡将3枚烈焰能量护符交给征服堡的纳兹格利姆中士。‡帶3個火焰灌注咒符給征服堡的士官納茲格寧姆。',
  }
},
[12257] = {
  {
    'Demonstração de força‡Демонстрация силы‡Eine Demonstration der Stärke‡무력 과시‡Una demostración de fuerza‡Una demostración de fuerza‡Une démonstration de force‡显示力量‡展現實力',
    nil,
    'Mate 12 Vassalos Esfola-dragão e fale novamente com o Sargento Nazgrim no Forte da Conquista, que fica na Serra Gris.‡Убейте 12 хускерлов из клана Укротителей драконов и вернитесь к сержанту Назгриму в Крепость Завоевателей.‡Tötet 12 Huscarls der Drachenschinder und kehrt zu Unteroffizier Nazgrim am Siegeswall zurück.‡용약탈부족 정예병 12명을 처치한 다음 정복의 요새에 있는 하사관 나즈그림에게 돌아가야 합니다.‡Mata a 12 huscarles Desuelladragones y habla con el Sargento Nazgrim en el Bastión de la Conquista.‡Mata a 12 huscarles Desuelladragones y habla con el Sargento Nazgrim en el Bastión de la Conquista.‡Tuez 12 Huscarls écorche-dragon puis retournez voir le Sergent Nazgrim au Bastion de la Conquête.‡消灭12个掠龙侍卫，然后向征服堡的纳兹格利姆中士复命。‡殺死12個掠龍侍衛，然後回去找征服堡的士官納茲格寧姆。',
  }
},
[12258] = {
  {
    'Praça de guerra‡Судьба погибших‡Das Schicksal der Toten‡망자의 운명‡El destino de los muertos‡El destino de los muertos‡Le destin des morts‡亡者的命运‡亡者的宿命',
    nil,
    'A Comandante Lynore Golpevento, na Bastilha Invergarde, no Ermo das Serpes, quer que você mate 15 Geists Vingativos.‡Убейте 15 мстительных упырей по приказу командира Линоры Порыв Ветра в крепости Стражей Зимы в Драконьем Погосте.‡Kommandantin Lynore Windstreich in der Feste Wintergarde in der Drachenöde möchte, dass Ihr 15 rachsüchtige Spuke tötet.‡용의 안식처에 있는 윈터가드 성채의 사령관 리노어 윈드스트라이크가 복수의 외눈깨비 15마리를 처치해 달라고 부탁했습니다.‡La comandante Lynore Ventostryke en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que mates a 15 geists vengativos.|n‡La comandante Lynore Ventostryke en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que mates a 15 geists vengativos.|n‡Le Commandant Lynore Frappevent, du Donjon de Garde-hiver dans la Désolation des dragons, veut que vous tuiez 15 Geists vengeurs.‡龙骨荒野暮冬要塞的指挥官莱诺尔·风矛要求你杀死15只复仇的恶鬼。‡龍骨荒野上溫特加德要塞中的指揮官萊諾爾·風矛需要你殺死15隻復仇魂屍。',
  }
},
[12259] = {
  {
    'O thane dos Runavold‡Тан Волдруна‡Der Than von Voldrune‡볼드룬의 영주‡El señor feudal de Runavold‡El señor feudal de Runavold‡Le thane de Voldrune‡沃德伦的领主‡沃德盧恩的族長',
    nil,
    'Use Flamarauto para derrotar o Thane Torvald Eriksson e se apresente ao Sargento Nazgrim no Forte da Conquista.‡Одержите победу над таном Торвальдом Эрикксоном с помощью Огнедышащего и доложите сержанту Назгриму из Крепости Завоевателей.‡Besiegt mithilfe von Flammenbringer Than Torvald Eriksson und meldet Euch anschließend bei Unteroffizier Nazgrim in Burg Siegeswall.‡불꽃인도자를 조종하여 영주 토르발트 에릭슨을 처치하고 정복의 요새에 있는 하사관 나즈그림에게 보고해야 합니다.‡Usa a Clamallamas para derrotar al señor feudal Torvald Eriksson e informa al Sargento Nazgrim en el Bastión de la Conquista.‡Usa a Clamallamas para derrotar al señor feudal Torvald Eriksson e informa al Sargento Nazgrim en el Bastión de la Conquista.‡Utilisez Porte-flamme pour vaincre le Thane Torvald Eriksson, puis faites votre rapport au Sergent Nazgrim au Bastion de la Conquête.‡利用烈焰使者击败托瓦德·埃里克森领主，然后向征服堡的纳兹格利姆中士复命。‡利用烈焰使者擊敗族長特沃德·艾利克森，然後向征服堡的士官納茲格寧姆回報。',
  }
},
[12260] = {
  {
    'Dessemelhança perfeita‡Полное несходство‡Die perfekte Heuchelei‡완벽한 위장‡La máscara perfecta‡La máscara perfecta‡Le déguisement parfait‡完美的伪装‡完美的假象',
    nil,
    'A Agente Skully, em Nova Amparo, quer que você roube a imagem de um Sacerdote Corvo da Ofensiva. Devolva o Espelho Mágico da Banshee a ela quando terminar.‡По заданию агента Скулли из Нового Дольного Очага похитьте образ жреца-ворона Алого Натиска. После этого верните Волшебное зеркало банши агенту Скалли.‡Agentin Skully in Neuherdweiler möchte, dass Ihr das Abbild eines Rabenpriesters des Ansturms stehlt. Bringt den magischen Spiegel der Banshee wieder zurück, wenn Ihr das getan habt.‡신 하스글렌에 있는 요원 스컬리가 붉은돌격대 까마귀 사제의 모습을 훔쳐와 달라고 부탁했습니다. 작업을 마친 다음 밴시의 마법 거울을 돌려줘야 합니다.‡La agente Skully en Nueva Vega del Amparo te ha pedido que robes la imagen de un sacerdote cuervo del Embate. Devuélvele el espejo mágico de alma en pena cuando hayas terminado.‡La agente Skully en Nueva Vega del Amparo te ha pedido que robes la imagen de un sacerdote cuervo del Embate. Devuélvele el espejo mágico de alma en pena cuando hayas terminado.‡L\'Agent Skoulis, à Nouvelle-Âtreval, vous a demandé de voler l\'image d\'un Prêtre corbeau de l\'Assaut. Rendez-lui le Miroir magique de la banshee lorsque vous aurez terminé.‡新壁炉谷的斯古莉探员要求你去窃取先锋军黑鸦祭司的影像。完成任务之后，把女妖的魔镜还给她。‡新壁爐谷的史考莉探員要你偷取突襲軍血鴉牧師的影像。完成之後將女妖的魔鏡還給史考莉探員。',
  }
},
[12261] = {
  {
    'Sem lugar pra correr‡Отрезать пути к отступлению‡Kein Ausweg‡퇴로 차단‡Sin escapatoria‡Sin escapatoria‡Aucune chance de fuite‡无路可逃‡無處可逃',
    nil,
    'Posicione um Marco Destrutivo no final do caminho saindo do Santuário Dragônico Obsidiano, no ponto em que a estrada começa a desaparecer sob a neve. Proteja o marco até que ele esteja totalmente energizado, então fale novamente com Serinar.‡Поместите тотем уничтожения в конце тропы, ведущей из Обсидианового святилища драконов, там, где дорогу начинает заносить снегом. Защищайте его до полной зарядки, затем вернитесь к Серинару.‡Stellt eine zerstörerische Barriere am Ende des Pfades auf, der aus dem Obsidiandrachenschrein hinausführt; dort, wo die Straße in Schnee übergeht. Schützt die Barriere, bis sie vollständig aufgeladen ist und kehrt dann zu Serinar zurück.‡흑요석 용제단에서 나가는 길 끝, 눈 덮인 땅과 길이 만나는 곳에 파괴의 수호물을 설치해야 합니다. 수호물이 마력으로 충만해질 때까지 보호한 다음 세린나에게 돌아가십시오.‡Coloca un resguardo destructivo en la senda de salida del Santuario de Dragones Obsidiana donde la carretera empieza a dar paso a la nieve. Protege el resguardo hasta que se cargue por completo y luego vuelve junto a Serinar.‡Coloca un resguardo destructivo en la senda de salida del Santuario de Dragones Obsidiana donde la carretera empieza a dar paso a la nieve. Protege el resguardo hasta que se cargue por completo y luego vuelve junto a Serinar.‡Placez un Garde de destruction au bout du chemin permettant de sortir du Sanctuaire draconique obsidien à l\'endroit où la route fait place à la neige. Protégez le garde jusqu\'à ce qu\'il soit chargé, puis retournez auprès de Sérinar.‡将毁灭结界放在黑曜石巨龙圣地出口的尽头，雪花开始覆盖道路的地方。保护它完成充能，然后向瑟里纳尔复命。‡將毀滅禦符放在黑曜龍殿的出路盡頭，就在開始積雪的地方。保護禦符，直到它完全充能好為止，然後向賽瑞納爾回報。',
  }
},
[12262] = {
  {
    'Sem misericórdia‡Без надежды на спасение‡Und niemand, der Euch retten wird...‡철저한 죽음‡Nadie para salvarte‡Nadie para salvarte‡Personne ne viendra vous sauver‡驱逐天灾‡求救無門',
    nil,
    'Mate 6 Necrólitos das Profundezas Flamejantes e 10 Esqueletos Fumegantes na parte externa do Santuário Dragônico Obsidiano. Fale novamente com Serinar quando completar a tarefa.‡Убейте 6 некролитов Пылающих Глубин и 10 тлеющих скелетов за пределами Обсидианового святилища драконов, после этого вернитесь к Серинару.‡Tötet außerhalb des Obsidiandrachenschreins 6 Nekrolyten der Brennenden Tiefen und 10 glimmende Skelette. Kehrt zu Serinar zurück, sobald Eure Aufgabe abgeschlossen ist.‡흑요석 용제단 밖에 있는 불타는 심연 강령사 6명과 이글거리는 해골 10마리를 처치한 후 세린나에게 돌아가야 합니다.‡Mata a 6 necrólitos de las profundidades ardientes y a 10 esqueletos en el exterior del Santuario de Dragones Obsidiana. Vuelve junto a Serinar cuando hayas completado la tarea.‡Mata a 6 necrólitos de las profundidades ardientes y a 10 esqueletos en el exterior del Santuario de Dragones Obsidiana. Vuelve junto a Serinar cuando hayas completado la tarea.‡Tuez 6 Nécrolytes des profondeurs ardentes et 10 Squelettes fumants à l\'extérieur du Sanctuaire draconique obsidien. Quand ce sera fait, retournez voir Sérinar.‡到黑曜石巨龙圣地外面击败6个燃烧深渊通灵侍僧和10个冒烟的骷髅。完成任务后向瑟里纳尔复命。‡在黑曜龍殿外面殺死6個燃燒深淵通靈師與10個悶燒的骷髏。一旦你完成了這項工作，向賽瑞納爾回報。',
  }
},
[12263] = {
  {
    'As melhores intenções‡С наилучшими намерениями‡Nur die besten Absichten‡적의 계획‡La mejor de las intenciones‡La mejor de las intenciones‡Les meilleures intentions‡敌人的意图‡不懷好意',
    nil,
    'Espere até que Serinar aplique em você o disfarce de Necrólito das Profundezas Flamejantes. Então, siga até os fundos da Bocarra de Neltharion, e descubra o que a Seita dos Malditos está fazendo lá. Fale novamente com Serinar e lhe repasse os detalhes do que descobrir.‡Дождитесь, пока Серинар замаскирует вас под некролита Пылающих Глубин, потом проникните в глубь Пасти Нелтариона, чтобы узнать, что там делает Культ Проклятых. Вернитесь к Серинару и расскажите о том, что они замышляют.‡Wartet, bis Serinar Euch in die Verkleidung eines Nekrolyten der Brennenden Tiefen gehüllt hat. Dringt in die Tiefen des Schlundes von Neltharion vor, um aufzudecken, was den Kult der Verdammten hierher lockt. Kehrt mit Details ihres Vorhabens zu Serinar zurück.‡불타는 심연 강령사의 모습이 된 다음, 넬타리온의 턱 뒤편으로 가서 저주받은 자들의 교단이 무엇을 하고 있는지 알아내 세린나에게 돌아가야 합니다.‡Espera a Serinar para que te administre el disfraz de un necrólito de las profundidades ardientes y luego entra hasta la parte posterior de las Fauces de Neltharion para averiguar lo que el Culto de los Malditos está haciendo allí. Vuelve junto a Serinar con los detalles de sus intenciones.‡Espera a Serinar para que te administre el disfraz de un necrólito de las profundidades ardientes y luego entra hasta la parte posterior de las Fauces de Neltharion para averiguar lo que el Culto de los Malditos está haciendo allí. Vuelve junto a Serinar con los detalles de sus intenciones.‡Attendez que Sérinar vous ait donné l\'apparence d\'un Nécrolyte des profondeurs ardentes, puis avancez vers le fond de la Gueule de Neltharion pour découvrir ce qu\'y prépare le Culte des damnés. Retournez auprès de Sérinar lorsque vous aurez des détails sur leurs intentions.‡等待瑟里纳尔将你变成燃烧深渊通灵侍僧，然后到奈萨里奥之喉深处去打探诅咒教派的意图。完成任务后向瑟里纳尔复命。‡等待賽瑞納爾幫你偽裝成燃燒深淵通靈師，然後回到奈薩里奧之喉刺探詛咒神教的動向。完成後向賽瑞納爾回報他們的意圖與細節。',
  }
},
[12264] = {
  {
    'Abater os Malditos‡Разборка с Проклятыми‡Das Ausmerzen der Verdammten‡저주받은 자들 처단‡La matanza de los Malditos‡La matanza de los Malditos‡L\'élimination des damnés‡扫荡诅咒教派‡剔除詛咒神教',
    nil,
    'Mate 3 Necromantes das Profundezas Flamejantes, 6 Constructos Ardentes e 6 Geists Ardentes na Bocarra de Neltharion, e então fale novamente com Serinar.‡Убейте 3 некромантов Пылающих Глубин, 6 тлеющих созданий и 6 тлеющих упырей в Пасти Нелтариона, а затем возвращайтесь к Серинару.‡Tötet in Neltharions Schlund 3 Nekromanten der Brennenden Tiefen, 6 glimmende Konstrukte und 6 glimmende Spuke. Kehrt dann zu Serinar zurück.‡넬타리온의 턱에서 불타는 심연 강령술사 3명, 이글거리는 피조물 6마리, 이글거리는 외눈깨비 6마리를 처치한 다음 세린나에게 돌아가야 합니다.‡Mata a 3 nigromantes de las profundidades ardientes, 6 ensamblajes en llamas y 6 geists en llamas en las Fauces de Neltharion, y luego vuelve junto a Serinar.‡Mata a 3 nigromantes de las profundidades ardientes, 6 ensamblajes en llamas y 6 geists en llamas en las Fauces de Neltharion, y luego vuelve junto a Serinar.‡Tuer 3 Nécromanciens des profondeurs ardentes, 6 Assemblages fumants et 6 Geists fumants dans la Gueule de Neltharion, puis retourner auprès de Sérinar.‡前往奈萨里奥之喉，杀死3个燃烧深渊通灵师、6个冒烟的构造体和6个冒烟的恶鬼，然后向瑟里纳尔复命。‡殺掉位於奈薩里奧之喉的3名燃燒深淵死靈法師，6具悶燒的傀儡以及6隻悶燒的魂屍以後，返回賽瑞納爾處。',
  }
},
[12265] = {
  {
    'Profanar profanadores‡Осквернение осквернителей‡Die Schändung der Entweiher‡파멸자의 파멸‡Profanando a los profanadores‡Profanando a los profanadores‡Profaner les profanateurs‡污染的能量‡污染污染者',
    nil,
    'Encontre e destrua 8 Runas Necromânticas desenhadas no chão dentro da Bocarra de Neltharion. Fale novamente com Serinar quando completar a tarefa.‡Найдите и уничтожьте 8 некромантских рун, выявленных на дне Пасти Нелтариона. Выполнив это, возвращайтесь к Серинару.‡Findet 8 nekromantische Runen, die auf den Boden von Neltharions Schlund gezeichnet wurden und löscht sie aus. Kehrt zu Serinar zurück, sobald die Aufgabe abgeschlossen ist.‡넬타리온의 턱에서 바닥에 그려진 강령술 룬 8개를 밟아 없앤 다음 세린나에게 돌아가야 합니다.‡Encuentra y destruye 8 runas nigrománticas que se han dibujado en el suelo dentro de las Fauces de Neltharion. Vuelve junto a Serinar cuando completes esta misión.‡Encuentra y destruye 8 runas nigrománticas que se han dibujado en el suelo dentro de las Fauces de Neltharion. Vuelve junto a Serinar cuando completes esta misión.‡Localisez et détruisez 8 Runes nécromantiques dessinées sur le sol à l\'intérieur de la Gueule de Neltharion. Une fois ceci fait, retournez auprès de Sérinar.‡进入奈萨里奥之喉，找到并砸碎8枚通灵符文。完成任务后向瑟里纳尔复命。‡標記並且擊碎8個畫在奈薩里奧之喉中地板上的死靈符文。完成後回去找賽瑞納爾。',
  }
},
[12266] = {
  {
    'Histórias de destruição‡Рассказ о разрушении‡Kunde der Zerstörung‡파괴의 이야기‡Historias de destrucción‡Historias de destrucción‡Récits de destruction‡毁灭的故事‡毀滅的故事',
    nil,
    'Volte para o Templo do Repouso das Serpes e informe Nalice que as tarefas de Serinar foram cumpridas.‡Отправляйтесь обратно в Драконий Покой и расскажите Нэлис, что задание Серинара выполнено.‡Kehrt zum Wyrmruhtempel zurück und lasst Yntrige wissen, dass Serinars Aufgabe abgeschlossen ist.‡고룡쉼터 사원에 있는 날리스에게 돌아가 세린나가 맡긴 임무를 끝냈다고 전해야 합니다.‡Vuelve a Reposo del Dragón e informa a Nalice de que has completado la misión de Serinar.‡Vuelve a Reposo del Dragón e informa a Nalice de que has completado la misión de Serinar.‡Retourner au Repos du ver et annoncer à Nalice que la tâche de Sérinar est accomplie.‡返回龙眠神殿，告诉纳莉丝你已经完成了瑟里纳尔的任务。‡返回龍眠神殿，並且讓納麗絲知道賽瑞納爾的任務已經完成了。',
  }
},
[12267] = {
  {
    'A chama de Neltharion‡Пламя Нелтариона‡Neltharions Flamme‡넬타리온의 불꽃‡La llama de Neltharion‡La llama de Neltharion‡La flamme de Neltharion‡奈萨里奥的烈焰‡奈薩里奧之焰',
    nil,
    'Use a Chama de Neltharion para purificar a área de ressurreição nos fundos da Bocarra de Neltharion. Quando você atrair a atenção de Podran, mate-o. Então, fale novamente com Serinar, na frente da caverna.‡Используйте пламя Нелтариона, чтобы очистить область призыва в глубине Пасти Нелтариона. После того как привлечете внимание Ротина Гниющего, убейте его, затем вернитесь к Серинару у входа в пещеру.‡Äschert mit Neltharions Flamme die Beschwörungskammer im hinteren Teil von Neltharions Schlund ein. Tötet Rothin den Verfallenen, nachdem Ihr seine Aufmerksamkeit auf Euch gezogen habt, und kehrt anschließend zu Serinar am Eingang der Höhle zurück.‡넬타리온의 불꽃을 사용해 넬타리온의 턱 뒤편에 있는 부활의 방을 정화한 후, 부패의 로딘을 처치하고 세린나에게 돌아가야 합니다.‡Utiliza la llama de Neltharion para apagar la zona de invocación de la parte posterior de las Fauces de Neltharion. Cuando llames la atención de Rothin el Putrefacto, mátalo y vuelve junto a Serinar delante de la cueva.‡Utiliza la llama de Neltharion para apagar la zona de invocación de la parte posterior de las Fauces de Neltharion. Cuando llames la atención de Rothin el Putrefacto, mátalo y vuelve junto a Serinar delante de la cueva.‡Aspergez la zone d\'invocation à l\'arrière de la Gueule de Neltharion avec la Flamme de Neltharion. Lorsque vous aurez attiré l\'attention de Rothin le Putréfié, tuez-le, puis retournez voir Sérinar devant la caverne.‡进入奈萨里奥之喉深处，使用奈萨里奥的烈焰净化召唤区域。当你吸引到腐烂者洛森的注意力之后，杀掉他，然后把瓶子还给洞穴外的瑟里纳尔。‡使用奈薩里奧之焰淨化奈薩里奧之喉後方的召喚區。一旦你引起『凋零』羅辛的注意，就殺死他，然後回到洞穴前方去找賽瑞納爾。',
  }
},
[12268] = {
  {
    'Partes apartadas‡Запчасти‡Einzelteile‡부품 조각‡Piezas y partes‡Piezas y partes‡Pour quelques bouts de ferraille de plus…‡伐木机零件‡拼湊零件',
    nil,
    'Pepe Kabong, na Madeireira Céu Azul, quer que você recolha 4 Engrenagens Sulcadas, 3 Rodas Ranhuradas e 2 Molas de Alta Tensão.‡Трубкочист с Лесозаготовок Синего Неба просит вас собрать 4 рифленых шестеренки, 3 зубчатых колеса и 2 тугих пружины.‡Pipthwak beim Holzfällerposten Blauhimmel möchte, dass Ihr ihm 4 gefalzte Zahnräder, 3 gekerbte Winkel und 2 Hochspannungsfedern bringt.‡푸른 하늘 벌목장에 있는 핍스와크가 홈이 팬 기어 4개, 들쭉날쭉한 톱니 3개, 그리고 고장력 용수철 2개를 가져다 달라고 부탁했습니다.‡Pipthchiflo en el Aserradero Cielo Azul quiere que consigas 4 engranajes con muescas, 3 ruedas dentadas y 2 resortes de alta tensión.‡Pipthchiflo en el Aserradero Cielo Azul quiere que consigas 4 engranajes con muescas, 3 ruedas dentadas y 2 resortes de alta tensión.‡Pépingrenu, du Chantier d\'abattage du Ciel bleu, vous demande de ramasser 4 Poulies à gorge, 3 Pignons ébréchés et 2 Ressorts de haute torsion.‡蓝天伐木场的皮普斯维克希望你去收集4个凹槽齿轮、3个刻缺链条和2个高压弹簧。‡藍天伐木地的籽擊要你去收集4個溝槽齒輪、3個凹槽扣鏈齒輪和2個高壓彈簧。',
  }
},
[12269] = {
  {
    'Na nossa mina, não!‡Только не c нашего рудника!‡Nicht in unserer Mine‡광산의 비극‡No en nuestra mina‡No en nuestra mina‡Pas dans notre mine‡我们的矿洞？休想！‡不許在我們的礦坑胡搞',
    nil,
    'O Grão-lorde Leoric von Zeldig, na Bastilha Invergarde, no Ermo das Serpes, quer que você recupere 10 Cartões dos Mineradores de Invergarde.‡По поручению верховного лорде Леорика фон Цельдига из крепости Стражей Зимы на Драконьем Погосте добудьте 10 удостоверений шахтера Стражей Зимы.‡Hochlord Leoric von Zeldig in der Feste Wintergarde in der Drachenöde möchte, dass Ihr 10 Bergarbeiterausweise von Wintergarde beschafft.‡용의 안식처에 있는 윈터가드 성채의 대영주 레오릭 본 젤디그가 윈터가드 광부의 명함 10장을 찾아와 달라고 부탁했습니다.‡El alto señor Leoric Von Zeldig en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que recuperes 10 tarjetas de minero de Hibergarde.‡El alto señor Leoric Von Zeldig en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que recuperes 10 tarjetas de minero de Hibergarde.‡Le Généralissime Leoric von Zeldig, au Donjon de Garde-hiver dans la Désolation des dragons, veut que vous récupériez 10 Cartes de mineur de Garde-hiver.‡龙骨荒野的暮冬要塞里的李奥瑞克·冯·泽尔迪格公爵要你带回10张暮冬矿工的工作证。‡位於龍骨荒野，溫特加德要塞的大領主李奧瑞克·馮·澤爾迪格要你取回十個溫特加德礦工名牌。',
  }
},
[12270] = {
  {
    'Retalhando a Aliança‡Искрошить Альянс‡Schreddert die Allianz‡얼라이언스의 벌목기‡Machaca a la Alianza‡Machaca a la Alianza‡Déchiquetez l\'Alliance‡收割联盟‡鋸開聯盟',
    nil,
    'Grekk, na Madeireira Céu Azul, quer que você lhe traga 3 retalhadores.‡Грекк с Лесозаготовок Синего Неба просит вас добыть для него 3 крошшера.‡Grekk im Holzfällerlager Blauhimmel möchte, dass Ihr 3 Schredder besorgt und diesen zu ihm zurückkehrt.‡푸른 하늘 벌목장에 있는 그레크가 벌목기 3대를 몰고 와 달라고 부탁했습니다.‡Grekk en el Aserradero Cielo Azul quiere que consigas 3 trituradoras y se las lleves.‡Grekk en el Aserradero Cielo Azul quiere que consigas 3 trituradoras y se las lleves.‡Grekk, du Chantier d\'abattage du Ciel bleu, vous demande de vous procurer 3 Déchiqueteurs et de les lui rapporter.‡蓝天伐木场的格利克希望你夺取3台伐木机，然后把它们交给他。‡藍天伐木地的葛列克要你奪取三台伐木機給他。',
  }
},
[12271] = {
  {
    'O Bastão da Compulsão‡Жезл принуждения‡Die Rute des Zwangs‡강압의 마법봉‡La vara de coacción‡La vara de coacción‡Le bâtonnet de contrainte‡强制魔棒‡強制權杖',
    nil,
    'Entregue o Bastão do Torturador para o Alto-executor Iracundo, em Perfídia.‡Отнесите жезл истязателя верховному палачу Росу в Ядозлобь.‡Liefert den Stab des Folterers bei Hochexekutor Zürner in Gallgrimm ab.‡고문관의 마법봉을 원한의 초소에 있는 고위집행관 워로스에게 전달해야 합니다.‡Entrega la vara de torturador al sumo ejecutor Wroth en Rencor Venenoso.‡Entrega la vara de torturador al sumo ejecutor Wroth en Rencor Venenoso.‡Apportez le Bâtonnet du tortionnaire au Grand exécuteur Ulcéré à Vexevenin.‡将拷问者的魔棒交给怨毒镇的高级执行官乌洛斯。‡將拷問者的權杖交給毒怨之地的高階執行官羅思。',
  }
},
[12272] = {
  {
    'O minério que sangra‡Кровоточащая руда‡Das blutende Erz‡피 흘리는 광석‡La mena sangrante‡La mena sangrante‡Le minerai sanguinolent‡流血的矿石‡流血的礦石',
    nil,
    'O Engenheiro de Cerco Quarteirão, na Bastilha Invergarde, no Ermo das Serpes, quer que você recupere 10 amostras de Minério Estranho da Mina Invergarde.‡По поручению осадного инженера Полувспыха из крепости Стражей Зимы на Драконьем Погосте добудьте 10 образцов странной руды на руднике Стражей Зимы.‡Belagerungsingenieur Viertelblitz in der Feste Wintergarde in der Drachenöde möchte, dass Ihr 10 Proben des seltsamen Erzes aus der Mine von Wintergarde beschafft.‡용의 안식처에 있는 윈터가드 성채의 공성 기술자 쿼터플래쉬가 윈터가드 광산에서 괴상한 광석 10개를 회수해 달라고 부탁했습니다.‡El ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que consigas 10 muestras de mena extraña de la Mina de Hibergarde.‡El ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones quiere que consigas 10 muestras de mena extraña de la Mina de Hibergarde.‡L\'Ingénieur de siège Quatreflash, au Donjon de Garde-hiver dans la Désolation des dragons, veut que vous alliez récupérer 10 échantillons de Minerai étrange dans la Mine de Garde-hiver.‡龙骨荒野暮冬要塞的攻城技师夸特弗拉什要你前往暮冬矿洞，取回10份奇怪的矿石的样品。‡龍骨荒野上溫特加德要塞的攻城工程師刻閃要你從溫特加德礦坑回收10個奇怪的礦石的樣本。',
  }
},
[12273] = {
  {
    'A denúncia‡Отречение‡Die Verleumdung‡자아 비판‡La acusación‡La acusación‡La trahison‡谴责‡辱罵',
    nil,
    'O Alto-executor Iracundo, em Perfídia, quer que você use o Bastão da Compulsão no Comandante Jardel, no Mestre Canhoneiro Zenão, no Ferreiro Bonhomme e no Mestre de Estábulo Mércio.|n|nDepois de aplicar o bastão neles, mate-os para que suas últimas palavras sejam uma denúncia da Ofensiva.‡По заданию верховного палача Роса из Ядозлоби воздействуйте жезлом принуждения на командира Джордана, главного канонира Зирхата, кузнеца Гудмана и смотрителя стойл Мерсера.|n|nКогда они подпадут под влияние жезла, убейте каждого из них, вырвав у них перед смертью признание об отречении от Алого Натиска.‡Hochexekutor Zürner in Gallgrimm hat Euch damit beauftragt, den Stab des Zwangs auf Kommandant Jordan, Kanonierführer Zierhut, Schmied Gutmann und Stallmeister Mercer anzuwenden.|n|nTötet sie, sobald Ihr den Stab verwendet habt, um ihnen als letzte Worte die Verleumdung des Scharlachroten Ansturms abzuverlangen.‡원한의 초소에 있는 고위집행관 워로스가 강압의 마법봉을 사령관 조던, 선임 포병 자이어후트, 대장장이 굿맨, 그리고 야수 관리인 머서에게 사용해 달라고 부탁했습니다.|n|n그들에게 마법봉을 사용하여 각각 붉은돌격대를 비난하게 한 다음 제거하십시오.‡El sumo ejecutor Wroth en Rencor Venenoso te ha encargado la tarea de usar la vara de coacción con el comandante Jordan, el cañonero mayor Zierhut, el herrero Buenhombre y el maestro de establos Mercer.|n|nCuando hayas usado la vara con ellos, mátalos para coaccionarlos a hacer de sus últimas palabras una acusación contra El Embate Escarlata.‡El sumo ejecutor Wroth en Rencor Venenoso te ha encargado la tarea de usar la vara de coacción con el comandante Jordan, el cañonero mayor Zierhut, el herrero Buenhombre y el maestro de establos Mercer.|n|nCuando hayas usado la vara con ellos, mátalos para coaccionarlos a hacer de sus últimas palabras una acusación contra El Embate Escarlata.‡Le Grand exécuteur Ulcéré, à Vexevenin, vous a chargé d\'utiliser le Bâtonnet de contrainte sur le Commandant Jordan, le Cannonier en chef Zierhut, le Forgeron Bonhomme et le Maître des écuries Mercer.|n|nLorsque vous aurez utilisé le bâtonnet sur eux, faites-leur payer leur trahison envers l\'Assaut écarlate en les exécutant.‡怨毒镇的高级执行官乌洛斯要你对指挥官乔丹、炮兵队长泽尔哈特、铁匠古德曼和兽栏管理员默希尔使用强制魔棒。|n|n等他们在魔棒的作用下公开谴责血色先锋军后就杀掉他们。‡高階執行官羅思指派你對指揮官喬丹、砲手指揮吉爾哈特、鐵匠古德曼，以及獸欄管理員梅瑟使用強制權杖。|n|n使用之後殺了他們，迫使他們在臨終前辱罵血色突襲軍。',
  }
},
[12274] = {
  {
    'Caindo em desgraça‡Греховное падение‡In Ungnade fallen‡영광으로부터의 추락‡Caída en desgracia‡Caída en desgracia‡Tombé en disgrâce‡狼狈不堪‡失寵',
    nil,
    'A Agente Skully, em Nova Amparo, quer que você toque o sino da abadia e, depois, fale com Abade-mor para extrair informações dele.‡Позвоните в колокол аббатства, затем поговорите с верховным настоятелем по просьбе агента Скулли из Нового Дольного Очага.‡Agentin Skully in Neuherdweiler möchte, dass Ihr die Glocke der Abtei läutet und anschließend vom Hochabt die benötigten Informationen beschafft.‡신 하스글렌에 있는 요원 스컬리가 수도원의 종을 친 다음 대수도원장과 대화하여 정보를 얻어달라고 부탁했습니다.‡La agente Skully en Nueva Vega del Amparo te ha pedido que toques la campana de la abadía y luego vayas a hablar con el sumo abad para sonsacarle información.‡La agente Skully en Nueva Vega del Amparo te ha pedido que toques la campana de la abadía y luego vayas a hablar con el sumo abad para sonsacarle información.‡L\'Agent Skoulis à Nouvelle-Âtreval vous a demandé de faire sonner la cloche de l\'abbaye, puis d\'aller parler avec le Grand abbé pour lui soutirer des informations.‡新壁炉谷的斯古莉探员要求你前往修道院鸣钟，然后去和那里的高阶修士谈话，从他嘴里套出情报。‡新壁爐谷的史考莉探員要你敲響修道院的鐘，然後與高階修士談話獲取情報。',
  }
},
[12275] = {
  {
    'O explo-gnomo‡Демогном‡Der Sprenggnom‡폭파전문노움 슬린킨‡El Demognomo‡El Demognomo‡Le démo-gnome‡破坏专家斯林奇‡爆破地精',
    nil,
    'Fale com o Engenheiro de Cerco Quarteirão, na Bastilha Invergarde, que fica no Ermo das Serpes.‡Поговорите с осадным инженером Полувспыхом в крепости Стражей Зимы в Драконьем Погосте.‡Sprecht mit Belagerungsingenieur Viertelblitz in der Feste Wintergarde in der Drachenöde.‡용의 안식처에 있는 윈터가드 성채의 공성 기술자 쿼터플래쉬와 대화해야 합니다.‡Habla con el ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Habla con el ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Parler à l\'Ingénieur de siège Quatreflash au Donjon de Garde-hiver dans la Désolation des dragons.‡前往龙骨荒野的暮冬要塞，与攻城技师夸特弗拉什谈一谈。‡和龍骨荒野中，溫特加德要塞的攻城工程師刻閃交談。',
  }
},
[12276] = {
  {
    'À procura de Slinkinho‡В поисках Слинкина‡Die Suche nach Schleicha‡슬린킨을 찾아서‡La búsqueda de Slinkin‡La búsqueda de Slinkin‡À la recherche de Subrepte‡寻找斯林奇‡尋找史霖金',
    nil,
    'Encontre Slinkinho, o Explo-gnomo, na Mina Invergarde. Use o Robô Teleguiado de Quarteirão se precisar de ajuda para encontrar a mina.‡Отыщите Слинкина Демогнома в руднике Стражей Зимы. Используйте самонаводящегося робота Полувспыха, если вам нужна будет помощь в поисках рудника.‡Sucht und findet Schleicha den Sprenggnom in den Minen von Wintergarde. Holt Euch Viertelblitz\' Zielsuchroboter zu Hilfe, wenn Ihr die Minen nicht finden könnt.‡윈터가드 광산에서 폭파전문노움 슬린킨을 찾아야 합니다. 광산을 찾는 데 도움이 필요하면 쿼터플래쉬의 유도 로봇을 사용하십시오.‡Encuentra a Slinkin el Demognomo en la Mina de Hibergarde. Utiliza el buscabot de Quartoflash si necesitas ayuda para encontrar la mina.‡Encuentra a Slinkin el Demognomo en la Mina de Hibergarde. Utiliza el buscabot de Quartoflash si necesitas ayuda para encontrar la mina.‡Trouvez Subrepte le Démo-gnome dans la Mine de Garde-hiver. Utilisez le Robot-chercheur de Quatreflash si vous avez besoin d\'aide pour localiser la mine.‡前往暮冬矿洞寻找破坏专家斯林奇。你可以使用夸特弗拉什的导航机器人来帮忙寻找矿洞。‡在溫特加德礦坑中找到『爆破地精』史霖金。如果你需要引導，可以利用刻閃的追蹤機器人。',
  }
},
[12277] = {
  {
    'Não dê sopa pro azar‡Ничего не оставлять на волю случая‡Überlasst nichts dem Zufall‡운에 기대지 말라‡No dejes nada a la suerte‡No dejes nada a la suerte‡Ne laissez rien au hasard‡阻绝邪恶‡步步為營',
    nil,
    'Pegue uma Bomba da Mina Invergarde e use-a para explodir o Túnel Superior da Mina Invergarde e o Túnel Inferior da Mina Invergarde. Fale novamente com o Engenheiro de Cerco Quarteirão, na Bastilha Invergarde, que fica no Ermo das Serpes, quando completar a tarefa.‡Добудьте бомбу Стражей Зимы и используйте ее, чтобы взорвать верхний и нижний стволы рудника Стражей Зимы. Выполнив задачу, вернитесь к осадному инженеру Полувспыху в крепость Стражей Зимы в Драконьем Погосте.‡Beschafft eine Minenbombe von Wintergarde und verwendet sie, um den oberen und unteren Minenschacht von Wintergarde zu sprengen. Erstattet Belagerungsingenieur Viertelblitz bei der Feste Wintergarde in Drachenöde Bericht, sobald Ihr die Aufgabe erfüllt habt.‡윈터가드 광산 폭탄을 입수하여 윈터가드 광산 위쪽 입구와 윈터가드 광산 아래쪽 입구를 폭파하고, 용의 안식처에 있는 윈터가드 성채의 공성 기술자 쿼터플래쉬에게 보고해야 합니다.‡Recupera una bomba de la Mina de Hibergarde y úsala para volar por los aires el eje de la Mina de Hibergarde alta y el eje de la Mina de Hibergarde baja. Vuelve a informar al ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones cuando hayas completado esta misión.‡Recupera una bomba de la Mina de Hibergarde y úsala para volar por los aires el eje de la Mina de Hibergarde alta y el eje de la Mina de Hibergarde baja. Vuelve a informar al ingeniero de asedio Quartoflash en la Fortaleza de Hibergarde en el Cementerio de Dragones cuando hayas completado esta misión.‡Récupérez une Bombe de la mine de Garde-hiver et utilisez-la pour faire sauter le Puits de mine supérieur de Garde-hiver et le Puits de mine inférieur de Garde-hiver. Retournez faire votre rapport à l\'Ingénieur de siège Quatreflash au Donjon de Garde-hiver dans la Désolation des dragons lorsque vous aurez terminé.‡找到暮冬矿洞炸弹，并用它把暮冬矿洞的上层入口和暮冬矿洞的下层入口炸掉。完成任务后，前往龙骨荒野的暮冬要塞，向攻城技师夸特弗拉什复命。‡取回溫特加德挖礦用炸彈，並使用它炸毀上層溫特加德礦坑礦井與下層溫特加德礦坑礦井。事成之後回報龍骨荒野、溫特加德要塞中的攻城工程師刻閃。',
  }
},
[12278] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Larkin Cervaforte na Taberna Pedra de Fogo, em Altaforja.‡Отнесите членскую карточку "Лучшего пивовара месяца" Ларкину Громовару в таверну "Горючий камень" в Стальгорне.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Larkin Donnerbräu in der Steinfeuertaverne in Eisenschmiede.‡"맥주 사랑 동호회" 가입 신청서를 아이언포지의 부싯돌 선술집에 있는 라르킨 썬더브루에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Larkin Cebatruenos en la Taberna Roca de Fuego en Forjaz.‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Larkin Tonnebière à la taverne de Brûlepierre à Forgefer.‡将"本月美酒"俱乐部会员资料表交给铁炉堡石火旅店的拉尔金·雷酒。‡把「每月啤酒」俱樂部會員表格帶給拉金·雷酒，他就在鐵爐堡的石火旅店中。',
  }
},
[12279] = {
  {
    'Um apetite de urso‡Медвежий аппетит‡Bärenhunger‡굶주린 곰‡Hambre de osa‡Hambre de osa‡Un appétit d\'ours‡熊的美食‡大胃熊',
    nil,
    'Traga 6 Salmões do Norte para Hugo Copas no Entreposto Sequoia.‡Принесите 6 северных лососей Хью Глассу в Торговую лавку Красного леса.‡Bringt Hugh Glass am Handelsposten von Rotholz 6 Nordlachse.‡붉은나무 교역소에 있는 휴 글라스에게 극지 연어 6마리를 가져가야 합니다.‡Llévale 6 salmones del norte a Hugh Copa en el Puesto de Venta Madera Roja.‡Llévale 6 salmones del norte a Hugh Copa en el Puesto de Venta Madera Roja.‡Apportez 6 Saumons nordiques à Hugues Leverre au Comptoir du Cèdre.‡给红木商栈的休·格兰斯带去6条北地鲑鱼。‡帶回6條北地鮭魚給位在紅木貿易站的休·格雷斯。',
  }
},
[12280] = {
  {
    'Consertando‡Текущий ремонт‡Reparaturen‡벌목기 수리‡Haciendo arreglos‡Haciendo arreglos‡Procéder aux réparations‡修理伐木机‡維修工作',
    nil,
    'Lurz, na Madeireira Céu Azul, quer que você recolha 4 Engrenagens Sulcadas, 3 Rodas Ranhuradas e 2 Molas de Alta Tensão.‡Лурц с Лесозаготовок Синего Неба просит вас собрать 4 рифленых шестеренки, 3 зубчатых колеса и две тугих пружины.‡Lurz beim Holzfällerposten Blauhimmel möchte, dass Ihr 4 gefalzte Zahnräder, 3 gekerbte Winkel und 2 Hochspannungsfedern sammelt.‡푸른 하늘 벌목장에 있는 룰즈가 홈이 팬 기어 4개, 들쭉날쭉한 톱니 3개, 고장력 용수철 2개를 가져다달라고 부탁했습니다.‡Lurz en el Aserradero Cielo Azul quiere que consigas 4 engranajes con muescas, 3 ruedas dentadas y 2 resortes de alta tensión.‡Lurz en el Aserradero Cielo Azul quiere que consigas 4 engranajes con muescas, 3 ruedas dentadas y 2 resortes de alta tensión.‡Lurz, du Chantier d\'abattage du Ciel bleu, vous demande de ramasser 4 Poulies à gorge, 3 Pignons ébréchés et 2 Ressorts de haute torsion.‡蓝天伐木场的鲁尔兹希望你去收集4个凹槽齿轮、3个刻缺链条和2个高压弹簧。‡藍天伐木地的盧爾茲要你去收集4個溝槽齒輪、3個凹槽扣鏈齒輪和2個高壓彈簧。',
  }
},
[12281] = {
  {
    'Para entender a máquina de guerra do Flagelo‡Понимание военной машины Плети‡Die Kriegsmaschine der Geißel verstehen‡스컬지 전쟁 기계 이해‡Comprender la máquina de guerra de la Plaga‡Comprender la máquina de guerra de la Plaga‡Étudier les machines de guerre du Fléau‡天灾战争机器的奥秘‡瞭解天譴戰爭機器',
    nil,
    'Entregue o Pacote de Quarteirão para o Alto-comandante Haraldo Serpecida, na Bastilha Invergarde.‡Доставьте амуницию Полувспыха главнокомандующему Халфорду Змеевержцу в крепость Стражей Зимы.‡Liefert Viertelblitz\' Paket bei Oberkommandant Halford Wyrmbann in der Feste Wintergarde ab.‡쿼터플래쉬의 꾸러미를 윈터가드 성채에 있는 총사령관 할포드 웜베인에게 전달해야 합니다.‡Entrega el paquete de Quartoflash al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde.‡Entrega el paquete de Quartoflash al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde.‡Livrez le Colis de Quatreflash au Haut-commandant Halford Verroctone au Donjon de Garde-hiver.‡把夸特弗拉什的包裹交给暮冬要塞的高级指挥官哈尔弗·维姆班恩。‡將刻閃的包裹遞送給位於溫特加德要塞的高階指揮官海弗德·龍禍。',
  }
},
[12282] = {
  {
    'Marcas do passado‡Отпечатки былого‡Spuren der Vergangenheit‡과거의 상처‡Huellas en el pasado‡Huellas en el pasado‡L\'empreinte du passé‡往日的烙印‡往日的傷痕',
    nil,
    'Zelig, o Visionário, na Bastilha Invergarde, que fica no Ermo das Serpes, quer que você recupere o Orbe de Vidência.‡Принесите Зелигу Иллюзорному из крепости Стражей Зимы в Драконьем Погосте его гадальный шар.‡Zelig der Visionär in der Feste Wintergarde in der Drachenöde möchte, dass Ihr seine Seherkugel holt.‡용의 안식처에 있는 윈터가드 성채의 예지자 젤리그가 그의 수정구를 찾아와 달라고 부탁했습니다.‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que recuperes su orbe de visión.‡Zelig el Visionario en la Fortaleza de Hibergarde del Cementerio de Dragones quiere que recuperes su orbe de visión.‡Zelig le Visionnaire au Donjon de Garde-hiver dans la Désolation des dragons veut que vous récupériez son Orbe de divination.‡暮冬要塞的幻象师瑟里格要求你帮忙找回他的占卜宝珠。‡位於龍骨荒野，溫特加德要塞的『遠識』齊利格需要你找回他的占卜寶珠。',
  }
},
[12283] = {
  {
    'A verdade aparecerá‡Правду не скроешь‡Die Wahrheit wird herauskommen‡진실은 밝혀진다‡La verdad saldrá‡La verdad saldrá‡C\'est la vérité, d\'ailleurs‡寻找真相‡真相大白',
    nil,
    'A Agente Skully quer que você adquira o Diário da General Abbendis e o entregue para o Alto-executor Iracundo, em Perfídia.‡Добудьте дневник верховного генерала Аббендис по просьбе агента Скулли и передайте этот дневник верховному палачу Росу в Ядозлоби.‡Agentin Skully möchte, dass Ihr das Tagebuch von Hochgeneral Abbendis beschafft und es zu Hochexekutor Zürner in Gallgrimm bringt.‡요원 스컬리가 고위사령관 아벤디스의 일기를 구해 원한의 초소에 있는 고위집행관 워로스에게 전달해 달라고 부탁했습니다.‡La agente Skully te ha pedido que consigas el diario de la alta general Abbendis y se lo lleves al sumo ejecutor Wroth en Rencor Venenoso.‡La agente Skully te ha pedido que consigas el diario de la alta general Abbendis y se lo lleves al sumo ejecutor Wroth en Rencor Venenoso.‡L\'Agent Skoulis vous a demandé de voler le Journal du grand général Abbendis et de le remettre au Grand exécuteur Ulcéré à Vexevenin.‡斯古莉探员要求你去获取阿比迪斯将军的日记，然后将它交给怨毒镇的高级执行官乌洛斯。‡史考莉探員要求你拿取大將軍阿比迪斯的日記，並將其交給毒怨之地的高階執行官羅思。',
  }
},
[12284] = {
  {
    'Tem que puxar as orelhas‡Преследуй по пятам‡Haltet sie auf Trab‡맹렬한 공격‡Que se queden donde están‡Que se queden donde están‡Mettez-les sur les dents‡穷追不舍‡讓他們動彈不得',
    nil,
    'O Comandante Bargok quer que você derrote 15 unidades ou jogadores da Aliança na Madeireira Céu Azul.‡Командир Баргок приказал вам убить 15 представителей или игроков Альянса на Лесозаготовках Синего Неба.‡Kommandant Bargok möchte, dass Ihr beim Holzfällerposten Blauhimmel 15 Einheiten oder Spieler der Allianz tötet.‡사령관 바르고크가 푸른 하늘 벌목장에 있는 얼라이언스 병사 또는 전투원 15명을 처치해 달라고 부탁했습니다.‡El comandante Bargok quiere que mates a 15 unidades o jugadores de la Alianza en el Aserradero Cielo Azul.‡El comandante Bargok quiere que mates a 15 unidades o jugadores de la Alianza en el Aserradero Cielo Azul.‡Le Commandant Bargok vous demande de tuer 15 unités ou personnages-joueurs de l\'Alliance au Chantier d\'abattage du Ciel bleu.‡指挥官巴尔格克希望你在蓝天伐木场消灭15个联盟士兵或者联盟玩家。‡指揮官巴茍克要你刺殺15名藍天伐木地的聯盟成員或玩家。',
  }
},
[12285] = {
  {
    'Fazei aos outros‡Без головы не возвращайся!‡Tu anderen...‡타인을 위해‡Hacer a los demás‡Hacer a los demás‡Œil pour œil‡先发制人‡還以顏色',
    nil,
    'O Alto-executor Iracundo, em Perfídia, quer que você entregue a Cabeça da General-de-exército Abbendis para ele.‡По заданию верховного палача Роса из Ядозлоби убейте верховного генерала Аббендис и принесите ему ее голову.‡Hochexekutor Zürner in Gallgrimm hat Euch befohlen, mit dem Kopf des Hochgenerals zurückzukehren.‡원한의 초소에 있는 고위집행관 워로스가 고위사령관의 머리카락을 가져오라고 명령했습니다.‡El sumo ejecutor Wroth te ha ordenado que vuelvas con la cabeza de la Alta General.‡El sumo ejecutor Wroth te ha ordenado que vuelvas con la cabeza de la Alta General.‡Le Grand exécuteur Ulcéré, à Vexevenin, vous a ordonné de revenir avec la Tête du grand général.‡怨毒镇的高级执行官乌洛斯命令你将阿比迪斯将军的徽记交给他。‡毒怨之地的高階執行官羅思命令你帶著大將軍的頭顱回來。',
  }
},
[12286] = {
  {
    'Balde de balas‡Кулек конфет‡Eimer mit Süßigkeiten‡사탕 바구니‡Cubo de caramelos‡Cubo de caramelos‡Seau de bonbons‡糖罐‡糖果桶',
    nil,
    nil,
  }
},
[12287] = {
  {
    'Orik Fidélio e a Costa Abandonada‡Орик Чистосердечный и Забытое взморье‡Orik Treuherz und der Vergessene Strand‡오리크 트루하트와 망각의 해변‡Orik Corazón Veraz y La Orilla Olvidada‡Orik Corazón Veraz y La Orilla Olvidada‡Orik Cœur-vrai et la côte Oubliée‡欧瑞克·图哈特‡歐利克·真心與遺民之濱',
    nil,
    'Procure a ajuda de Orik Fidélio nos Confins da Aurora, no Ermo das Serpes.‡Ищите помощи у Орика Чистосердечного в Рассветном краю на Драконьем Погосте.‡Sucht Orik Treuherz auf der Dämmerkuppe in der Drachenöde auf.‡용의 안식처에 있는 십자군 주둔지에서 오리크 트루하트의 도움을 구해야 합니다.‡Busca la ayuda de Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones.‡Busca la ayuda de Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones.‡Allez demander de l’aide à Orik Cœur-vrai aux Confins de l’Aube, dans la Désolation des dragons.‡前往龙骨荒野的黎明河滩，寻求欧瑞克·图哈特的帮助。‡在龍骨荒野的黎明之境上，尋求歐利克·真心的協助。',
  }
},
[12288] = {
  {
    'Sobrecarregada!‡В военном лазарете‡Überfordert!‡부상자 속출‡¡Abrumado!‡¡Abrumado!‡Débordée !‡力不能支！‡潰不成軍!',
    nil,
    'Aumana, na Madeireira Céu Azul, quer que você use o Torniquete Recuperador em 10 Escaramuçadores Feridos.‡Аумана с Лесозаготовок Синего Неба просит вас перевязать медицинским жгутом 10 израненных рыскателей.‡Aumana beim Holzfällerposten Blauhimmel möchte, dass Ihr die erneuernde Abschnürbinde auf 10 verwundete Scharmützler anwendet.‡푸른 하늘 벌목장에 있는 아우마나가 소생의 지혈대로 상처입은 척후병 10명을 치료해 달라고 부탁했습니다.‡Aumana en el Aserradero Cielo Azul quiere que uses el Torniquete de renovación en 10 hostigadores heridos.‡Aumana en el Aserradero Cielo Azul quiere que uses el Torniquete de renovación en 10 hostigadores heridos.‡Aumana, au Chantier d\'abattage du Ciel bleu, vous demande d\'utiliser le Garrot de rénovation sur 10 Tirailleurs blessés.‡蓝天伐木场的奥曼娜希望你在10名受伤的散兵身上使用急救止血带。‡藍天伐木地的奧瑪納需要你對10名受傷的爭鬥者使用恢復止血帶。',
  }
},
[12289] = {
  {
    'Chutando cachorro morto‡Нападем, пока враг слаб!‡Tritt rein, solang\' sie am Boden liegen‡결정적인 공격‡Golpéalos mientras han caído‡Golpéalos mientras han caído‡Frappez-les tant qu\'ils sont à terre‡乘胜追击‡落井下石',
    nil,
    'O Sargento Hartsman quer que você derrote 15 unidades ou jogadores da Horda na Madeireira Céu Azul.‡Сержант Хартсман поручил вам убить 15 игроков или представителей Орды на Лесозаготовках Синего Неба.‡Unteroffizier Hartsmann möchte, dass Ihr 15 Einheiten oder Spieler der Horde im Holzfällerlager Blauhimmel besiegt.‡하사관 하츠만이 푸른 하늘 벌목장에 있는 호드 병사 또는 전투원 15명을 처치해 달라고 부탁했습니다.‡El sargento Hartsman quiere que derrotes a 15 unidades o jugadores de la Horda en el Aserradero Cielo Azul.‡El sargento Hartsman quiere que derrotes a 15 unidades o jugadores de la Horda en el Aserradero Cielo Azul.‡Le Sergent Hartsman vous demande d\'abattre 15 unités ou personnages-joueurs de la Horde au Chantier d\'abattage du Ciel bleu.‡哈斯曼中士希望你在蓝天伐木场消灭15个部落成员。‡士官赫茲曼需要你解決15名藍天伐木地的部落成員或玩家。',
  }
},
[12290] = {
  {
    'O elixir de herassombra‡Эликсир из темноплевела‡Das Düstergraselixier‡암흑풀 영약‡El elixir de hierba tiniebla‡El elixir de hierba tiniebla‡L\'élixir de tourbeline‡黑暗草‡陰鬱草藥劑',
    nil,
    'Orik Fidélio, nos Confins da Aurora, no Ermo das Serpes, quer que você colete 5 Herassombras no Cerro Lúgubre.‡Добудьте на Зловещей возвышенности 5 экземпляров темноплевела по просьбе Орика Чистосердечного из Рассветного края в Драконьем Погосте.‡Orik Treuherz auf der Dämmerkuppe in der Drachenöde möchte, dass Ihr 5 Düstergräser von den Düsterhöhen holt.‡용의 안식처의 십자군 주둔지에 있는 오리크 트루하트가 으스스한 언덕에서 암흑풀 5개를 가져와 달라고 부탁했습니다.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que recojas 5 muestras de hierba tiniebla de los Altos de Eldritch.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que recojas 5 muestras de hierba tiniebla de las Cumbres Fantasmales.‡Orik Cœur-vrai aux Confins de l’Aube, dans la Désolation des dragons, veut que vous récupériez 5 Tourbelines dans les Hauts Surréels.‡黎明河滩上的欧瑞克·图哈特要求你从埃尔德齐断崖上收集5株黑暗草。‡龍骨荒野黎明之境上的歐利克·真心需要你尋回5株陰鬱草，就生長在異法陵地上。',
  }
},
[12291] = {
  {
    'A história esquecida‡Забытая повесть‡Die vergessene Geschichte‡슬픈 이야기‡La historia olvidada‡La historia olvidada‡Le récit oublié‡被遗忘的故事‡遺民的故事',
    nil,
    'Orik Fidélio, nos Confins da Aurora, no Ermo das Serpes. quer que você escute as histórias de um Camponês Esquecido, de um Carabineiro Esquecido, de um Cavaleiro Esquecido e de um Soldado Raso Esquecido.‡Выслушайте повесть о бедствиях забытого крестьянина, забытого ружейника, забытого рыцаря и забытого пехотинца по просьбе Орика Чистосердечного из Рассветного края в Драконьем Погосте.‡Orik Treuherz auf der Dämmerkuppe in der Drachenöde möchte, dass Ihr Euch die Geschichte der vergessenen Arbeiter, vergessenen Scharfschützen, vergessenen Ritter und der vergessenen Fußsoldaten anhört.‡용의 안식처의 십자군 주둔지에 있는 오리크 트루하트가 잊혀진 농부, 잊혀진 소총병, 잊혀진 기사, 그리고 잊혀진 보병의 이야기를 들어 달라고 부탁했습니다.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que escuches las historias de un campesino olvidado, un fusilero olvidado, un caballero olvidado y un lacayo olvidado.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que escuches las historias de un campesino olvidado, un fusilero olvidado, un caballero olvidado y un lacayo olvidado.‡Orik Cœur-vrai aux Confins de l’Aube, dans la Désolation des dragons, veut que vous écoutiez le récit d’un Paysan oublié, d’un Fusilier oublié, d’un Chevalier oublié et d’un Fantassin oublié.‡黎明河滩上的欧瑞克·图哈特要求你听取被遗忘的农夫、被遗忘的火枪手、被遗忘的骑士和被遗忘的步兵所讲述的故事。‡龍骨荒野黎明之境的歐利克·真心需要你聆聽遺民農民、遺民步槍兵、遺民騎士和遺民步卒的故事。',
  }
},
[12292] = {
  {
    'Apoio local‡Помощь местных жителей‡Die Unterstützung der Einheimischen‡토착민 돕기‡Apoyo local‡Apoyo local‡Le soutien local‡当地人的支持‡當地人的支援',
    nil,
    'O Tenente Dumont, no Chalé do Pinho Âmbar, quer que você vá até Entreposto Perene e obtenha o Baú de Cedro.‡Лейтенант Думонт из Приюта Янтарной Сосны поручил вам добраться до Торговой лавки Вечнозеленого леса и забрать кедровый сундук.‡Leutnant Dumont bei der Ammertannhütte möchte, dass Ihr Euch zum Handelsposten Immergrün begebt und die Zedernholzkiste beschafft.‡호박빛소나무 오두막에 있는 부관 듀몬트가 사철나무 교역소에서 참죽나무 상자를 가져와 달라고 부탁했습니다.‡El teniente Dumont en el Refugio Pino Ámbar quiere que vayas al Puesto de Venta de Siempreverde y consigas el cofre de cedro.‡El teniente Dumont en el Refugio Pino Ámbar quiere que vayas al Puesto de Venta de Siempreverde y consigas el cofre de cedro.‡Le Lieutenant Dumont, du Gîte Ambrepin, veut que vous alliez au Comptoir des Conifères et que vous récupériez le Coffre en cèdre.‡琥珀松木营地的杜蒙特中尉要你前往常青商栈夺回雪松木箱。‡琥珀松小屋的都蒙特中尉要你前往常青貿易站取得雪松木箱。',
  }
},
[12293] = {
  {
    'Acordo fechado‡Дело сделано‡Schließt den Handel ab‡거래 완료‡Cierra el trato‡Cierra el trato‡Sceller l\'accord‡完成交易‡完成約定',
    nil,
    'Leve o Baú de Cedro a Ivan no Posto Álamo.‡Отнесите кедровый сундук Ивану на Заставу Тополиной рощи.‡Bringt die Zedernholzkiste zu Ivan im Posten des Espenhains.‡참죽나무 상자를 미루나무 숲 초소에 있는 이반에게 가져가야 합니다.‡Llévale el cofre de cedro a Ivan en el Puesto de la Alameda.‡Llévale el cofre de cedro a Ivan en el Puesto de la Alameda.‡Remettez le Coffre en cèdre à Ivan, au Poste de la Tremblaie.‡将雪松木箱交给白杨商栈的伊凡。‡將雪松木箱帶去給白楊崗哨的伊凡。',
  }
},
[12294] = {
  {
    'Um pacto experimental‡Заключение договора‡Ein vorläufiger Pakt‡임시 협정‡Un pacto provisional‡Un pacto provisional‡Un marché incertain‡暂时的协议‡暫時性的條約',
    nil,
    'Fale novamente com o Tenente Dumont no Chalé do Pinho Âmbar.‡Вернитесь к лейтенанту Думонту в Приют Янтарной Сосны.‡Kehrt zu Leutnant Dumont in der Ammertannhütte zurück.‡호박빛소나무 오두막에 있는 부관 듀몬트에게 돌아가야 합니다.‡Vuelve junto al teniente Dumont en el Refugio Pino Ámbar.‡Vuelve junto al teniente Dumont en el Refugio Pino Ámbar.‡Retournez voir le Lieutenant Dumont au Gîte Ambrepin.‡向琥珀松木营地的杜蒙特中尉复命。‡向琥珀松小屋的都蒙特中尉回報。',
  }
},
[12295] = {
  {
    'Exercícios diplomáticos‡Урок дипломатии‡Eine Übung in Sachen Diplomatie‡외교적인 노력‡Un ejercicio de diplomacia‡Un ejercicio de diplomacia‡Un exercice de diplomatie‡外交活动‡外交行動',
    nil,
    'Fale com o Enviado Ducal no Arroio Prateado.‡Поговорите с военным атташе Дюкалем в Среброречье.‡Sprecht mit dem Entsandten Ducal in Silberwasser.‡은빛시내 마을에 있는 사절 듀칼과 이야기해야 합니다.‡Habla con el enviado Ducal en Arroyoplata.‡Habla con el enviado Ducal en Arroyoplata.‡Parlez à l\'Envoyé Ducal à Ruissargent.‡与银溪镇的杜卡尔特使谈一谈。‡與銀溪鎮的特使杜卡交談。',
  }
},
[12296] = {
  {
    'Vida ou morte‡На грани жизни и смерти‡Leben oder Tod‡삶과 죽음‡A vida o muerte‡A vida o muerte‡La vie ou la mort‡生存或是死亡‡生死一線',
    nil,
    'Rheanna, na Madeireira Céu Azul, quer que você use a Bandagem Recuperadora em 10 Soldados de Infantaria Feridos de Cerro Oeste.‡Реанна с Лесозаготовок Синего Неба просит вас перевязать медицинскими бинтами 10 израненных пехотинцев отряда Западного Края.‡Rheanna beim Holzfällerposten Blauhimmel möchte, dass Ihr die erneuernde Bandage bei 10 verwundeten Westfall-Einheiten anwendet.‡푸른 하늘 벌목장에 있는 리안나가 소생의 붕대로 상처입은 서부 몰락지대 여단 보병 10명을 치료해 달라고 부탁했습니다.‡Rheanna en el Aserradero Cielo Azul quiere que uses el vendaje de renovación en 10 soldados de infantería de los Páramos de Poniente heridos.‡Rheanna en el Aserradero Cielo Azul quiere que uses el vendaje de renovación en 10 soldados de infantería de los Páramos de Poniente heridos.‡Rheanna, au Chantier d\'abattage du Ciel bleu, vous demande d\'utiliser le Bandage de rénovation sur 10 Soldats d\'infanterie de la marche de l\'Ouest blessés.‡蓝天伐木场的蕾安娜要你对10名受伤的月溪旅步兵使用恢复绷带。‡藍天伐木地的雷安娜要你使用恢復繃帶照料10個受傷的西荒步兵。',
  }
},
[12297] = {
  {
    'Sobre traidores e traição‡О предателях и предательстве‡Von Verrätern und Verrat‡반역과 배신‡De traidores y traición‡De traidores y traición‡Traîtres et trahisons‡叛徒的名单‡叛徒與通敵',
    nil,
    'O Capitão Carneiro quer que você mostre a Missiva da Aliança para Grier Metalomalho na Bastilha da Guarda Oeste.‡Капитан Адамс попросил вас показать депешу Альянса Гриру Рудомолоту из Крепости Западной Стражи.‡Hauptmann Adams möchte, dass Ihr das Schreiben der Allianz zu Greer Erzhammer in Westwacht bringt.‡경비대장 아담스가 얼라이언스 서신을 서부경비대 성채에 있는 그리어 오어해머에게 보여 주라고 했습니다.‡El capitán Adams te ha pedido que le enseñes la misiva de la Alianza a Greer Martillo de Mena en la Fortaleza de la Guardia Oeste.‡El capitán Adams te ha pedido que le enseñes la misiva de la Alianza a Greer Martillo de Mena en la Fortaleza de la Guardia Oeste.‡Le Capitaine Adams vous a demandé de montrer la Missive de l\'Alliance à Greer Martel-à-minerai, au Donjon de la Garde de l’ouest.‡亚当斯上尉要你向西部卫戍要塞的格雷尔·岩锤出示联盟信函。‡亞當斯隊長要你把聯盟公文拿給鎮西要塞的格銳爾·礦錘看。',
  }
},
[12298] = {
  {
    'Alto-comandante Haraldo Serpecida‡Главнокомандующий Халфорд Змеевержец‡Oberkommandant Halford Wyrmbann‡총사령관 할포드 웜베인‡Alto comandante Halford Aterravermis‡Alto comandante Halford Aterravermis‡Le haut-commandant Halford Verroctone‡高级指挥官哈尔弗·维姆班恩‡高階指揮官海弗德·龍禍',
    nil,
    'Entregue a Missiva da Aliança para o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, a leste do Ermo das Serpes.‡Отвезите депешу Альянса главнокомандующему Халфорду Змеевержцу в Крепость Стражей Зимы, которая находится на востоке Драконьего Погоста.‡Überbringt Oberkommandant Halford Wyrmbann das Schreiben der Allianz. Er befindet sich in der Feste Wintergarde im Osten der Drachenöde.‡얼라이언스 서신을 용의 안식처 동부에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 전달해야 합니다.‡Entrega la misiva de la Alianza al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde al este del Cementerio de Dragones.|n‡Entrega la misiva de la Alianza al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde al este del Cementerio de Dragones.|n‡Remettez la Missive de l’Alliance au Haut-commandant Halford Verroctone, au Donjon de Garde-hiver, à l’est de la Désolation des dragons.‡前往龙骨荒野东部的暮冬要塞，将联盟信函交给高级指挥官哈尔弗·维姆班恩。‡將聯盟公文交給高階指揮官海弗德·龍禍，他就在龍骨荒野東部的溫特加德要塞。',
  }
},
[12299] = {
  {
    'Hospitalidade nortista‡Северное гостеприимство‡Nördliche Gastfreundschaft‡북방의 축하 방식‡La hospitalidad norteña‡La hospitalidad norteña‡L\'hospitalité du nord‡北边的敌人‡北方的待客之道',
    nil,
    'Sergei, em Arroio Prateado, quer que você mate 8 Espoliadores do Forte da Conquista.‡Сергей из Среброречья просит вас убить 8 мародеров из Крепости Завоевателей.‡Sergei in Silberwasser will, dass Ihr 8 Marodeure von Burg Siegeswall tötet.‡은빛시내 마을에 있는 세르게이가 정복의 요새 습격자 8명을 처치해 달라고 부탁했습니다.‡Sergei en Arroyoplata quiere que mates a 8 maleantes del Bastión de la Conquista.‡Sergei en Arroyoplata quiere que mates a 8 maleantes del Bastión de la Conquista.‡Sergei de Ruissargent veut que vous tuiez 8 Maraudeurs du bastion de la Conquête.‡银溪镇的瑟尔基要你杀死8名征服堡劫掠者。‡銀溪鎮的瑟傑要你殺死八個征服堡掠奪者。',
  }
},
[12300] = {
  {
    'Teste de Coragem‡Испытание смелости‡Eignungstest‡용기의 시련‡Prueba de valor‡Prueba de valor‡Montrez votre cran‡勇气的试炼‡堅毅試煉',
    nil,
    'Encontre o Sargento Quebraossos a noroeste de Arroio Prateado e passe no Teste de Coragem.‡Найдите часового Костехвата к северо-западу от Среброречья и пройдите испытание смелости.‡Findet Unteroffizier Knochenknack nordwestlich von Silberwasser und besteht den Eignungstest.‡은빛시내 마을의 북서쪽에서 하사관 본스냅을 찾아 용기의 시련을 통과해야 합니다.‡Encuentra al sargento Cascahueso al oeste de Arroyoplata y supera la prueba de valor.‡Encuentra al sargento Cascahueso al oeste de Arroyoplata y supera la prueba de valor.‡Trouvez le Sergent Bris’os au nord-ouest de Ruissargent, et Montrez votre cran.‡在银溪镇西北边找到博斯纳普中士，以此通过勇气的试炼。‡在銀溪鎮的西北邊找出斷骨中士，並且通過堅毅試煉。',
  }
},
[12301] = {
  {
    'A verdade nos libertará‡Правда вернет нам свободу‡Möge die Wahrheit uns befreien‡진실이 우리를 해방하리라‡La verdad nos hará libres‡La verdad nos hará libres‡La vérité nous libérera‡真相会让我们解脱‡真相會解放我們',
    nil,
    'Orik Fidélio, nos Confins da Aurora, no Ermo das Serpes, quer que você use o Orbe Cristalino de Orik nas ruínas da Costa Abandonada para redimir os Esquecidos.‡По просьбе Орика Чистосердечного из Рассветного края, что на Драконьем Погосте, задействуйте хрустальную сферу Орика в развалинах, расположенных на Забытом взморье, для освобождения обитающих там Забытых.‡Orik Treuherz auf der Dämmerkuppe in der Drachenöde möchte, dass Ihr Oriks kristalline Kugel in den Ruinen des Vergessenen Strands einsetzt, um die Vergessenen zu erlösen.‡용의 안식처의 십자군 주둔지에 있는 오리크 트루하트가 망각의 해변에 있는 폐허에서 오리크의 수정 구슬을 사용해 잊혀진 자들을 구원해 달라고 부탁했습니다.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que uses el orbe cristalino de Orik en las ruinas de La Orilla Olvidada para redimir a los Olvidados.‡Orik Corazón Veraz en Tramo del Alba en el Cementerio de Dragones quiere que uses el orbe cristalino de Orik en las ruinas de La Orilla Olvidada para redimir a los Olvidados.‡Orik Cœur-vrai aux Confins de l’Aube, dans la Désolation des dragons, veut que vous utilisiez l’Orbe cristallin d’Orik dans les ruines situées sur la Côte Oubliée pour racheter l’âme des damnés.|n|nRevenez voir Orik avec son Orbe cristallin quand vous aurez réussi.‡龙骨荒野黎明河滩的欧瑞克·图哈特要你在遗忘海岸的废墟中使用欧瑞克的水晶球，以拯救那些被遗忘的灵魂。‡龍骨荒野中黎明之境的歐利克·真心需要你在遺民之濱的廢墟中使用歐利克水晶寶珠，救贖這些被遺民。',
  }
},
[12302] = {
  {
    'Palavras de advertência‡Предупреждение‡Worte der Warnung‡경고의 말‡Una advertencia‡Una advertencia‡Un avertissement‡萨莎的警告‡警告的話語',
    nil,
    'Vá para o noroeste de Arroio Prateado.‡Дойдите до северо-западного края Среброречья.‡Begebt Euch zum nordwestlichen Ende von Silberwasser.‡은빛시내 마을의 북서쪽 구석에 가봐야 합니다.‡Ve al extremo noroeste de Arroyoplata.‡Ve al extremo noroeste de Arroyoplata.‡Allez à l\'extrémité nord-ouest de Ruissargent.‡前往银溪镇的西北角。‡前往銀溪鎮的西北邊緣。',
  }
},
[12303] = {
  {
    'Verbas para o esforço de guerra‡Финансовое обеспечение военных нужд‡Die Kriegsanstrengungen finanzieren‡전쟁 예산 확보‡Financiar la guerra‡Financiar la guerra‡Financer l\'effort de guerre‡战争的开销‡提供軍資金',
    nil,
    'O Intendente Bartolotto, em Perfídia, quer que você recupere 6 Tesouros Esquecidos.‡По заданию интенданта Бартлетта из Ядозлоби добудьте 6 сундучков с забытыми сокровищами.‡Quartiermeister Bartlett in Gallgrimm möchte, dass Ihr 6 vergessene Schätze beschafft.‡원한의 초소에 있는 병참장교 바틀릿이 잊혀진 보물 6개를 가져와 달라고 부탁했습니다.‡El intendente Bartlett de Rencor Venenoso te ha pedido que recuperes 6 tesoros olvidados.‡El intendente Bartlett de Rencor Venenoso te ha pedido que recuperes 6 tesoros olvidados.‡L\'intendant Bartlett de Vexevenin vous a demandé de récupérer 6 Trésors oubliés.‡怨毒镇的军需官巴莱特要求你去取回6份被遗忘的宝藏。‡毒怨之地的軍需官巴特勒要你回收6個遺民寶藏。',
  }
},
[12304] = {
  {
    'A casa de praia‡Недвижимость на взморье‡Ein Grundstück am Strand‡해변 확보‡Propiedad delante de la playa‡Propiedad delante de la playa‡Une propriété sur le front de mer‡海边的地产‡海濱地產',
    nil,
    'O Topógrafo Reis, ao norte da Costa Abandonada, quer que você mate 20 fantasmas Esquecidos.‡По поручению наблюдателя Хансена, находящегося к северу от Забытого взморья убейте 20 призраков Забытого взморья.‡Feldmesser Hansen gleich nördlich des Vergessenen Strands möchte, dass Ihr 20 vergessene Geister vernichtet.‡망각의 해변 바로 북쪽에 있는 측량사 한센이 잊혀진 유령 20마리를 처치해 달라고 부탁했습니다.‡El perito Hansen, justo en el norte de La Orilla Olvidada, te ha pedido que mates a 20 fantasmas olvidados.‡El perito Hansen, justo en el norte de La Orilla Olvidada, te ha pedido que mates a 20 fantasmas olvidados.‡Le Géomètre Hansen, juste au nord de la Côte Oubliée, vous a demandé de tuer 20 Fantômes oubliés.‡测量员汉森要求你前往南面的遗忘海岸，击杀20个被遗忘的幽灵。‡遺民之濱北邊的勘測員漢森要你殺死20個遺民鬼魂。',
  }
},
[12305] = {
  {
    'Pensamentos finais‡Прощальные мысли‡Gedanken des Abschieds‡흩어지는 생각들‡Pensamientos de despedida‡Pensamientos de despedida‡Un adieu‡离别的思绪‡離情',
    nil,
    'Fale novamente com Zelig, o Visionário, na Bastilha Invergarde, que fica no Ermo das Serpes.‡Вернитесь к Зелигу Иллюзорному в крепость Стражей Зимы в Драконьем Погосте.‡Kehrt zu Zelig dem Visionär in der Feste Wintergarde in der Drachenöde zurück.‡용의 안식처에 있는 윈터가드 성채의 예지자 젤리그에게 돌아가야 합니다.‡Vuelve junto a Zelig el Visionario en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Vuelve junto a Zelig el Visionario en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Retournez voir Zelig le Visionnaire au Donjon de Garde-hiver dans la Désolation des dragons.‡回到龙骨荒野的暮冬要塞，向幻象师瑟里格复命。‡到龍骨荒野的溫特加德要塞找『遠識』齊利格。',
  }
},
[12306] = {
  {
    'Clube da Cerveja do Mês‡Клуб "Пиво месяца"‡Bier des Monats e.V.‡맥주 사랑 동호회‡Club de la Cerveza del Mes‡Club de la Cerveza del Mes‡Le club de la Bière du mois‡本月美酒俱乐部‡每月啤酒俱樂部',
    nil,
    'Entregue a ficha de inscrição do clube "Cerveja do Mês" para Ray\'ma na Salão Agulhas Negras, que fica no Vale dos Espíritos de Orgrimmar.‡Отнесите заполненную членскую карточку "Лучшего пивовара месяца" Рай\'ме в Пристанище Темнотерна. Оно находится в Оргриммаре, в Аллее Духов.‡Bringt Euren Mitgliedschaftsantrag für den "Bier des Monats e.V." zu Ray\'ma in der Dunkeldornenlodge im Tal der Geister in Orgrimmar.‡"맥주 사랑 동호회" 가입 신청서를 오그리마 정기의 골짜기에 있는 검은장미 오두막의 레이마에게 가져가야 합니다.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Ray\'ma en la Cabaña de Brezo en el Valle de los Espíritus de Orgrimmar.‡Llévale el formulario de socio del Club de la "Cerveza del Mes" a Ray\'ma en Cabaña de Brezo en el Valle de los Espíritus de Orgrimmar.‡Apporter le bulletin d\'adhésion du club de la « Bière du mois » à Ray\'ma au pavillon de Buissombre dans la vallée des Esprits d\'Orgrimmar.‡将"本月美酒"俱乐部会员资料表交给奥格瑞玛精神谷黑石南小屋的莱玛。‡帶著「每月啤酒」俱樂部會員表格交給雷瑪，他就在奧格瑪精神谷的暗木小屋裡。',
  }
},
[12307] = {
  {
    'Raiz de acônito‡Аконитовый корень‡Wolfsbannwurzel‡늑대잡이풀‡Raíz aterralobos‡Raíz aterralobos‡La racine d\'aconit‡破狼草‡禍狼根',
    nil,
    'Katia, em Arroio Prateado, quer que você arranque 8 Raízes de Acônito.‡Катя из Среброречья просит вас выдернуть восемь аконитовых кореньев.‡Katja in Silberwasser möchte, dass Ihr 8 Wolfsbannwurzeln ausreißt.‡은빛시내 마을에 있는 카트야가 늑대잡이풀 8포기를 뽑아달라고 부탁했습니다.‡Katja en Arroyoplata quiere que arranques 8 raíces de aterralobos.‡Katja en Arroyoplata quiere que arranques 8 raíces de aterralobos.‡Katja de Ruissargent vous demande d\'arracher 8 Racines d\'aconit.‡银溪镇的卡娅要求你拔出8株破狼草根。‡銀溪鎮的卡特加要你拔除8個禍狼根。',
  }
},
[12308] = {
  {
    'Fuga do Arroio Prateado‡Побег из Среброречья‡Flucht aus Silberwasser‡은빛시내 마을 탈출‡Huye de Arroyoplata‡Huye de Arroyoplata‡L\'évasion de Ruissargent‡逃离银溪镇‡逃離銀溪鎮',
    nil,
    'Abra a Jaula de Madeira e ajude o Batedor Libertado da Aliança a escapar de Arroio Prateado. Apresente-se ao Tenente Dumont quando chegar ao Chalé do Pinho Âmbar.‡Откройте деревянную клетку и помогите освобожденному разведчику Альянса сбежать из Среброречья. Когда вы доберетесь до Приюта Янтарной Сосны, доложите лейтенанту Думонту обо всем, что вы видели.‡Öffnet den hölzernen Käfig und helft dem befreiten Späher der Allianz, aus Silberwasser zu entkommen. Meldet Euch bei Leutnant Dumont, sobald Ihr die Ammertannhütte erreicht habt.‡나무 우리를 연 다음, 풀려난 얼라이언스 정찰병이 은빛시내 마을에서 탈출할 수 있도록 도와야 합니다. 호박빛소나무 오두막에 도착하면 부관 듀몬트에게 보고하십시오.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Abre la jaula de madera y ayuda al explorador de la Alianza liberado a escapar de Arroyoplata. Cuando llegues al Refugio Pino Ámbar, informa al teniente Dumont.‡Ouvrez la Cage en bois et aidez l\'Éclaireur de l\'Alliance libéré à s\'échapper de Ruissargent. Présentez-vous au Lieutenant Dumont quand vous aurez atteint le Gîte Ambrepin.‡打开木笼，帮助联盟斥候逃出银溪镇。抵达琥珀松木营地后向杜蒙特中尉汇报情况。‡打開木籠，然後幫助獲釋的聯盟斥候逃離銀溪鎮。當你抵達琥珀松小屋之後，向都蒙特中尉報告。',
  }
},
[12309] = {
  {
    'Encontre Durkon!‡Найти Дюркона!‡Findet Durkon!‡드류콘을 찾아라!‡¡Encuentra a Durkon!‡¡Encuentra a Durkon!‡Trouvez Durkon !‡找到杜尔库！‡找到德肯!',
    nil,
    'Procure o Paladino Durkon, na Cripta de Invergarde, no Ermo das Serpes.‡Отыщите кавалериста Дюркона в склепе Стражей Зимы в Драконьем Погосте.‡Sucht Dragoner Durkon bei der Gruft von Wintergarde in der Drachenöde auf.‡용의 안식처에 있는 윈터가드 납골당에서 기병 드류콘을 찾아야 합니다.‡Busca al hidalgo Durkon en la Cripta de Hibergarde, Cementerio de Dragones.|n‡Busca al hidalgo Durkon en la Cripta de Hibergarde, Cementerio de Dragones.|n‡Trouvez le Cavalier Durkon à la Crypte de Garde-hiver, dans la Désolation des dragons.‡在龙骨荒野的暮冬地穴找到骑兵杜尔库。‡在龍骨荒野的溫特加德墓穴找出騎兵德肯。',
  }
},
[12310] = {
  {
    'Uma reação rápida‡Мгновенный ответ‡Eine prompte Reaktion‡신속한 대응‡Una reacción inmediata‡Una reacción inmediata‡Une réponse rapide‡快速反应‡快速反應',
    nil,
    'O Tenente Dumont quer que você vá ao Posto Boca da Mata e mate Vladek e 7 Caçadores de Arroio Prateado.‡Лейтенант Думонт отправил вас к Заставе на опушке убить Владека и 7 охотников Среброречья.‡Leutnant Dumont möchte, dass Ihr zum Posten des Waldrands geht und Vladek sowie 7 Fährtenleser von Silberwasser erledigt.‡부관 듀몬트가 숲 가장자리 초소에 가서 은빛시내 마을 사냥꾼 7명과 블라데크를 처치해 달라고 부탁했습니다.‡El teniente Dumont quiere que vayas al Puesto Fronterizo del Bosque y mates a Vladek y a 7 cazadores de Arroyoplata.‡El teniente Dumont quiere que vayas al Puesto Fronterizo del Bosque y mates a Vladek y a 7 cazadores de Arroyoplata.‡Le Lieutenant Dumont vous a demandé d\'aller au Poste de la Lisière et de tuer Vladek et 7 Chasseurs de Ruissargent.‡杜蒙特中尉要你前往林边哨站，杀死弗拉德克以及7名银溪镇猎人。‡都蒙特中尉要你去林邊崗哨殺死弗拉戴克，以及7名銀溪獵人。',
  }
},
[12311] = {
  {
    'A cripta do nobre‡Подземная обитель некролорда‡Die Gruft des Adligen‡귀족의 납골당‡La cripta del noble‡La cripta del noble‡La crypte des nobles‡贵族的陵墓‡貴族之墓',
    nil,
    'O Paladino Durkon, na Bastilha Invergarde, quer que você mate o Necrolorde Amarion.‡По заданию кавалериста Дюркона из крепости Стражей Зимы убейте некролорда Амариона.‡Dragoner Durkon in der Feste Wintergarde möchte, dass Ihr Nekrolord Amarion tötet.‡윈터가드 성채에 있는 기병 드류콘이 강령군주 아마리온을 처치해 달라고 부탁했습니다.‡El hidalgo Durkon en la Fortaleza de Hibergarde quiere que mates al necroseñor Amarion.‡El hidalgo Durkon en la Fortaleza de Hibergarde quiere que mates al necroseñor Amarion.‡Le Cavalier Durkon, au Donjon de Garde-hiver, veut que vous tuiez le Nécro-seigneur Amarion.‡暮冬要塞的骑兵杜尔库要求你杀死通灵领主阿玛里恩。‡溫特加德要塞的騎兵德肯需要你殺掉死靈領主艾瑪利恩。',
  }
},
[12312] = {
  {
    'Segredos do Flagelo‡Тайны Плети‡Geheimnisse der Geißel‡스컬지의 비밀‡Secretos de la Plaga‡Secretos de la Plaga‡Les secrets du Fléau‡天灾的秘密‡天譴軍團的秘密',
    nil,
    'Entregue o Tomo Encadernado com Carne ao Paladino Durkon, na Bastilha Invergarde, no Ermo das Serpes.‡Отнесите сшитый плотью фолиант кавалеристу Дюркону, находящемуся в крепости Стражей Зимы на Драконьем Погосте.‡Bringt den fleischgebundenen Folianten zu Dragoner Durkon in der Feste Wintergarde in der Drachenöde.‡용의 안식처에 있는 윈터가드 성채의 기병 드류콘에게 살점달린 고서를 전달해야 합니다.‡Entrega el escrito encuadernado en carne al hidalgo Durkon en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Entrega el escrito encuadernado en carne al hidalgo Durkon en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Remettez le Tome relié de chair au Cavalier Durkon, au Donjon de Garde-hiver dans la Désolation des dragons.‡将血之魔典交给龙骨荒野暮冬要塞的骑兵杜尔库。‡將鑲肉骨書拿給騎兵德肯，他就在龍骨荒野的溫特加德要塞中。',
  }
},
[12313] = {
  {
    'UNUSED Save Brewfest!‡Unused Save Brewfest!‡Rettet das Braufest!‡미사용 가을 축제를 구해라!‡UNUSED Save Brewfest!‡UNUSED Save Brewfest!‡[UNUSED] Sauvez la fête des Brasseurs !‡UNUSED Save Brewfest!‡UNUSED 挽救啤酒節!',
    nil,
    'Talk to the Brewfest spy in the Grim Guzzler of Blackrock Depths.‡Поговорите со шпионом Хмельного фестиваля в "Угрюмом обжоре" , что в Глубинах Черной горы.‡Sprecht mit dem Spion des Braufests im Grimmigen Säufer in den Schwarzfelstiefen.‡검은바위 나락의 험상궂은 주정뱅이 선술집에 있는 가을 축제 비밀요원과 대화해야 합니다.‡Habla con el espía de la Fiesta de la cerveza en el Tragapenas de las Profundidades de Roca Negra.|n‡Habla con el espía de la Fiesta de la cerveza en el Tragapenas de las Profundidades de Roca Negra.|n‡Allez voir l’Espion de la fête des Brasseurs au Sinistre écluseur, dans les Profondeurs de Rochenoire.‡进入黑石深渊，与黑铁酒吧的美酒节间谍谈一谈。‡和黑鐵酒吧的啤酒節間諜交談。',
  }
},
[12314] = {
  {
    'Abaixo a capitão Zorna!‡Смерть капитану Зорне!‡Nieder mit Kapitänin Zorna!‡선장 조르나를 처치하라!‡¡Abajo la Capitana Zorna!‡¡Abajo la capitana Zorna!‡Mort au capitaine Zorna !‡除掉佐娜船长！‡和柔納船長一併擊沉!',
    nil,
    'Mate a Capitão Zorna e apresente-se ao barão Franco na Baía dos Empreendimentos.‡Убейте капитана Зорну и вернитесь к барону Фриману в Бухту торговцев.‡Tötet Kapitänin Zorna und erstattet Baron Freimann in der Venturebucht Bericht.‡선장 조르나를 처치하고 투자개발 만에 있는 바론 프리만에게 보고해야 합니다.‡Mata a la Capitana Zorna e informa al Barón Hombrelibre en Bahía Ventura.‡Mata a la capitana Zorna e informa al Barón Hombrelibre en Bahía Ventura.‡Tuez le Capitaine Zorna puis présentez-vous au Baron Lefranc dans la Baie de la KapitalRisk.‡杀死佐娜船长，然后向风险湾的弗里曼男爵复命。‡殺死柔納船長，並回報給風險海灣的佛里曼男爵。',
  }
},
[12315] = {
  {
    'Esmague o Capitão Aguaclara!‡Смерть капитану Брайтвотеру!‡Zerschmettert Kapitän Hellwasser!‡선장 브라이트워터를 제거하라!‡¡Aplasta al Capitán Agualuz!‡¡Aplasta al Capitán Agualuz!‡Abattez le capitaine Brilleflot !‡消灭布莱沃特船长！‡粉碎澈水艦長!',
    nil,
    'Mate o Capitão Aguaclara e apresente-se ao General Khizgur na Baía dos Empreendimentos.‡Убейте капитана Брайтвотера и доложите о своей победе генералу Хазгару из Бухты торговцев.‡Tötet Kapitän Hellwasser und erstattet anschließend General Khazgar in der Venturebucht Bericht.‡선장 브라이트워터를 처치하고 투자개발 만에 있는 사령관 카즈가르에게 보고해야 합니다.‡Mata al Capitán Agualuz e informa al General Khazgar en Bahía Ventura.‡Mata al capitán Agualuz e informa al general Khazgar en Bahía Ventura.‡Tuez le Capitaine Brilleflot puis présentez-vous au Général Khazgar dans la Baie de la KapitalRisk.‡杀死布莱沃特船长，然后向风险湾的卡兹加尔将军复命。‡殺死澈水艦長，然後向風險海灣的卡茲嘉將軍報告。',
  }
},
[12316] = {
  {
    'Você já foi à baía?‡Припрем их к стенке!‡Haltet sie auf!‡항구를 사수하라‡¡Mantenlos a raya!‡¡Mantenlos a raya!‡Ra-baie-ssez l\'ennemi‡夺取港口！‡死守海灣!',
    nil,
    'Derrote 10 unidades ou jogadores da Horda na Baía dos Empreendimentos e fale novamente com o Tenente Stuart.‡Убейте 10 представителей или игроков Орды в Бухте торговцев, после чего вернитесь к лейтенанту Стюарту.‡Besiegt 10 Einheiten oder Spieler der Horde in der Venturebucht und kehrt zu Leutnant Stuart zurück.‡투자개발 만에 있는 호드 병사 또는 전투원 10명을 처치한 다음 부관 스튜어트에게 돌아가야 합니다.‡Derrota a 10 unidades o jugadores de la Horda en Bahía Ventura y regresa con el teniente Stuart.‡Derrota a 10 unidades o jugadores de la Horda en Bahía Ventura y regresa con el teniente Stuart.‡Tuez 10 unités ou personnages-joueurs de la Horde dans la Baie de la KapitalRisk, puis retournez voir le Lieutenant Stuart.‡杀死10名部落成员，然后返回风险湾向斯图亚特中尉复命。‡擊敗10個部落成員或玩家，然後向風險海灣的斯圖亞特中尉回報。',
  }
},
[12317] = {
  {
    'Você já foi à baía?‡Припрем их к стенке‡Haltet sie auf!‡항구를 사수하라‡¡Mantenlos a raya!‡¡Mantenlos a raya!‡Ra-baie-ssez l\'ennemi‡港口中的联盟‡死守海灣',
    nil,
    'Derrote 10 unidades ou jogadores da Aliança na Baía dos Empreendimentos e fale novamente com o Centurião Kiggram.‡Убейте 10 представителей или игроков Альянса в Бухте торговцев, после чего вернитесь к центуриону Каггруму.‡Besiegt 10 Einheiten oder Spieler der Allianz in der Venturebucht und kehrt zu Zenturion Kaggrum zurück.‡투자개발 만에 있는 얼라이언스 병사 또는 전투원 10명을 처치한 다음 백인대장 카그룸에게 돌아가야 합니다.‡Derrota a 10 unidades o jugadores de la Alianza en Bahía Ventura y regresa con el centurión Kaggrum.‡Derrota a 10 unidades o jugadores de la Alianza en Bahía Ventura y regresa con el centurión Kaggrum.‡Tuez 10 unités ou personnages-joueurs de l\'Alliance dans la Baie de la KapitalRisk, puis retournez auprès du Centurion Kaggrum.‡杀死10名联盟成员，然后返回风险湾向百夫长卡格鲁姆复命。‡擊敗10個聯盟成員或玩家，然後向風險海灣的百夫長卡格朗姆回報。',
  }
},
[12318] = {
  {
    'Salve a CervaFest!‡Спасем Хмельной фестиваль!‡Rettet das Braufest!‡가을 축제를 구해라!‡¡Salva la Fiesta de la cerveza!‡¡Salva la Fiesta de la cerveza!‡Sauvez la fête des Brasseurs !‡拯救美酒节！‡挽救啤酒節!',
    nil,
    'Fale com o Espião da CervaFest no Glutão Implacável, que fica no Abismo Rocha Negra.|n‡Поговорите со шпионом Хмельного фестиваля в таверне "Угрюмый обжора" в Глубинах Черной горы.‡Sprecht mit dem Spion des Braufests im Grimmigen Säufer in den Schwarzfelstiefen.‡검은바위 나락의 험상궂은 주정뱅이 선술집에 있는 가을 축제 비밀요원과 대화해야 합니다.‡Habla con el espía de la Fiesta de la cerveza en el Tragapenas de las Profundidades Roca Negra.|n‡Habla con el espía de la Fiesta de la cerveza en el Tragapenas de las Profundidades Roca Negra.|n‡Parlez avec l\'Espion de la fête des Brasseurs, au Sinistre écluseur dans les Profondeurs de Rochenoire.‡进入黑石深渊，与黑铁酒吧的美酒节间谍谈一谈。‡與啤酒節間諜交談。他就在黑石深淵的黑鐵酒吧裡。',
  }
},
[12319] = {
  {
    'O mistério do tomo‡Тайна книги‡Das Rätsel des Folianten‡고서의 비밀‡El misterio del escrito‡El misterio del escrito‡Le mystère du tome‡血之魔典‡書中的秘密',
    nil,
    'Leve o Tomo Encadernado com Carne para o Alto-comandante Haraldo Serpecida na Bastilha Invergarde, que fica no Ermo das Serpes.‡Отнесите сшитый плотью фолиант главнокомандующему Халфорду Змеевержцу в крепость Стражей Зимы в Драконьем Погосте.‡Übergebt Oberkommandant Halford Wyrmbann in der Feste Wintergarde in der Drachenöde den fleischgebundenen Foliant.‡용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 살점달린 고서를 가져가야 합니다.‡Llévale el escrito encuadernado en carne al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Llévale el escrito encuadernado en carne al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde en el Cementerio de Dragones.‡Remettez le Tome relié de chair au haut-commandant Halford Verroctone, au Donjon de Garde-hiver dans la Désolation des dragons.‡将血之魔典交给龙骨荒野暮冬要塞的高级指挥官哈尔弗·维姆班恩。‡把鑲肉骨書帶去給高階指揮官海弗德·龍禍，他就在龍骨荒野的溫特加德要塞中。',
  }
},
[12320] = {
  {
    'A linguagem da morte‡Язык Смерти‡Die Sprache des Todes verstehen‡죽음의 언어 이해하기‡Comprender el idioma de la muerte‡Comprender el idioma de la muerte‡Comprendre la langue des morts‡破译魔典‡了解死者的語言',
    nil,
    'Leve o Tomo Encadernado com Carne para o Inquisidor Galhardo na prisão da Bastilha Invergarde.‡Отнесите сшитый плотью фолиант инквизитору Халларду в тюрьме крепости Стражей Зимы.‡Bringt den fleischgebundenen Folianten zu Inquisitor Hallard im Gefängnis der Feste Wintergarde.‡윈터가드 성채 감옥에 있는 심문관 할라드에게 살점달린 고서를 가져가야 합니다.‡Llévale el escrito encuadernado en carne al inquisidor Hallard en la prisión de la Fortaleza de Hibergarde.‡Llévale el escrito encuadernado en carne al inquisidor Hallard en la prisión de la Fortaleza de Hibergarde.‡Remettez le Tome relié de chair à l’Inquisiteur Hallard, dans la prison du donjon de Garde-hiver.‡将血之魔典交给龙骨荒野暮冬要塞监狱内的审讯员哈尔拉德。‡把鑲肉骨書帶給溫特加德要塞地牢的審判官哈拉德。',
  }
},
[12321] = {
  {
    'Um sermão virtuoso‡Праведная проповедь‡Eine rechtschaffene Predigt‡정의로운 설교‡Un sermón de rectitud‡Un sermón de rectitud‡Un sermon édifiant‡正义的审判‡諄諄善誘',
    nil,
    'Espere o Inquisidor Galhardo terminar o Sermão Virtuoso e informe o que você descobrir ao Alto-comandante Haraldo Serpecida na Bastilha Invergarde, no Ermo das Serpes.‡Дождитесь, пока инквизитор Халлард закончит свою праведную проповедь, и возвращайтесь к главнокомандующему Халфорду Змеевержцу в крепость Стражей Зимы на Драконьем Погосте с добытой информацией.‡Wartet, bis Inquisitor Hallard seine rechtschaffene Predigt gehalten hat, und kehrt dann mit Euren Entdeckungen zu Oberkommandant Halford Wyrmbann in der Feste Wintergarde in der Drachenöde zurück.‡심문관 할라드의 설교가 끝날 때까지 기다렸다가 알아낸 정보를 가지고 용의 안식처에 있는 윈터가드 성채의 총사령관 할포드 웜베인에게 돌아가야 합니다.‡Espera a que el inquisidor Hallard termine su sermón de rectitud y vuelve junto al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde, en el Cementerio de Dragones, con la información que averigües.‡Espera a que el inquisidor Hallard termine su sermón de rectitud y vuelve junto al alto comandante Halford Aterravermis en la Fortaleza de Hibergarde, en el Cementerio de Dragones, con la información que averigües.‡Attendez que l’Inquisiteur Hallard ait terminé son Sermon édifiant, puis retournez voir le Haut-commandant Halford Verroctone au Donjon de Garde-hiver dans la Désolation des dragons avec les informations qui vous auront été communiquées.‡等待审讯员哈尔拉德完成他的正义审讯，然后带着你获得的情报回到暮冬要塞的高级指挥官哈尔弗·维姆班恩那里复命。‡等待審判官哈拉德的大義凜然的宣教結束，將你揭露的消息回報給高階指揮官海弗德·龍禍，他就在溫特加德要塞中。',
  }
},
[12323] = {
  {
    'Ô fumacê, fumacê‡Выкурим их!‡Räuchert sie aus‡연막 작전‡Ahúmalos‡Ahúmalos‡Enfumez-les‡把他们熏出来！‡把他們燻出來',
    nil,
    'Use a Bomba de Fumaça para expulsar 20 Trabalhadores Retardatários dos prédios e então se apresente ao Sargento Downey.‡С помощью дымовой шашки выкурите 20 отставших работников Торговой Компании из зданий. Доложите об успешном выполнении поручения сержанту Дауни.‡Jagt mithilfe der Rauchbombe 20 Nachzügler der Venture Co. aus ihren Gebäuden und meldet Euch anschließend bei Unteroffizier Downey.‡연막탄을 사용해 꾀부리는 투자개발회사 인부 20명을 건물에서 몰아낸 다음 하사관 다우니에게 보고해야 합니다.‡Usa la bomba de humo para sacar a 20 rezagados de Ventura y Cía. de sus edificios y después informa al Sargento Downey.‡Usa la bomba de humo para sacar a 20 rezagados de Ventura y Cía. de sus edificios y después informa al sargento Downey.‡Utilisez la Bombe fumigène pour forcer à sortir de leurs bâtiments 20 Traînards de la KapitalRisk, puis faites votre rapport au Sergent Downey.‡利用烟雾炸弹迫使20名风险投资公司游荡者逃出他们的藏身之地，然后向杜内恩中士复命。‡使用煙霧彈來把20個風險投資公司離群者從建築物驅逐出去，然後向士官當尼報告。',
  }
},
[12324] = {
  {
    'Ô fumacê, fumacê‡Выкурим их!‡Räuchert sie aus‡연막 작전‡Ahúmalos‡Ahúmalos‡Enfumez-les‡把他们熏出来！‡把他們燻出來',
    nil,
    'Use a Bomba de Fumaça para expulsar 20 Trabalhadores Retardatários dos prédios e então se apresente ao Guarda Pétreo Totem da Fúria.‡С помощью дымовой шашки выкурите 20 отставших работников Торговой Компании из зданий. Доложите об успешном выполнении поручения Каменному стражу Тотему Ярости.‡Jagt mithilfe der Rauchbombe 20 Nachzügler der Venture Co. aus ihren Gebäuden und meldet Euch anschließend bei Steingardist Rachtotem.‡연막탄을 사용해 꾀부리는 투자개발회사 인부 20명을 건물에서 몰아낸 다음 투사 레이지토템에게 보고해야 합니다.‡Usa la bomba de humo para sacar a 20 rezagados de Ventura y Cía. de sus edificios y después informa al Guardia de Piedra Tótem de Ira.‡Usa la bomba de humo para sacar a 20 rezagados de Ventura y Cía. de sus edificios y después informa al guardia de piedra Tótem de Ira.‡Utilisez la Bombe fumigène pour forcer à sortir de leurs bâtiments 20 Traînards de la KapitalRisk, puis faites votre rapport au Garde de pierre Totem-de-rage.‡利用烟雾炸弹迫使20名风险投资公司游荡者逃出他们的藏身之地，然后向石头守卫诺卡·怒火图腾复命。‡用煙霧彈把20個風險投資公司離群者從建築物驅逐出去，然後向石衛士狂暴圖騰報告。',
  }
},
[12325] = {
  {
    'Em território inimigo‡Заброс на вражескую территорию‡Hinein ins Feindgebiet‡적진으로‡En territorio hostil‡En territorio hostil‡En territoire ennemi‡进入敌占区‡大敵當前',
    nil,
    'Fale com o Comandante de Grifos Eurico e pegue um voo para o Posto de Thorson. Apresente-se ao Duque Augusto Martel quando você chegar ao Posto de Thorson no Ermo das Serpes.‡Поговорите с командиром грифонов Уриком, чтобы организовать полет на заставу Торсона на Драконьем Погосте. Когда прибудете на заставу, доложитесь герцогу Августу Крушителю Врагов.‡Sprecht mit Greifenmeister Urik und fliegt zu Thorsons Posten. Meldet Euch bei Herzog August Feindhammer, wenn Ihr bei Thorsons Posten in der Drachenöde angekommen seid.‡그리핀 사령관 우릭과 대화하여 토르손의 전초기지로 가는 이동 수단을 얻은 후, 용의 안식처에 있는 토르손의 전초기지에 도착하면 대공 어거스트 포해머에게 보고해야 합니다.‡Habla con el comandante de grifos Urik para reservar un viaje hasta el Puesto de Thorson. Informa al duque August Martinimigos cuando llegues al Puesto de Thorson, en el Cementerio de Dragones.|n‡Habla con el comandante de grifos Urik para reservar un viaje hasta el Puesto de Thorson. Informa al duque August Martinimigos cuando llegues al Puesto de Thorson, en el Cementerio de Dragones.|n‡Parlez au Commandant des griffons Urik pour prendre un vol à destination du Poste de Thorson. Lorsque vous serez au Poste de Thorson dans la Désolation des dragons, présentez-vous au duc Auguste Marteau-des-ennemis.‡与狮鹫指挥官乌瑞克交谈，搭乘狮鹫飞往索尔森的岗哨。抵达目的地之后，向奥古斯特公爵报到。‡和獅鷲獸指揮官烏里克交談，飛往托爾森崗哨。在抵達龍骨荒野的托爾森崗哨之後，向奧古斯特·敵錘公爵回報。',
  }
},
[12326] = {
  {
    'Surpresa a vapor‡Паровой сюрприз‡Dampfpanzerüberraschung‡증기 전차 작전‡Tanque de vapor con sorpresa‡Tanque de vapor con sorpresa‡Char à vapeur surprise‡蒸汽坦克行动‡蒸氣坦克突襲',
    nil,
    'Use um Tanque a Vapor da Aliança para destruir 6 Carroças Pestilentas e descarregar os Soldados de Elite da 7ª Legião no Mausoléu Invergarde. Fale com Amgo Cash dentro do Mausoléu Invergarde, que fica no Ermo das Serpes.‡Воспользовавшись паровым танком Альянса, уничтожьте 6 чумных телег и доставьте гвардейцев 7-го легиона к усыпальнице Стражей Зимы. Если успешно выполните задание, поговорите с Амбо Кэшем внутри усыпальницы Стражей Зимы на Драконьем Погосте.‡Zerstört mithilfe des Dampfpanzers der Allianz 6 Seuchewagen und ladet die Elitesoldaten der 7. Legion beim Mausoleum von Wintergarde ab. Sprecht anschließend mit Ambo Unkesch im Inneren des Mausoleums von Wintergarde, wenn Eure Aufgabe erledigt ist.‡얼라이언스 증기 전차를 사용해 역병 수레 6대를 파괴한 다음 7군단 정예병을 윈터가드 묘지로 데려가는 임무를 마친 후, 용의 안식처에 있는 윈터가드 묘지에서 앰보 캐시와 대화해야 합니다.‡Utiliza un tanque de vapor de la Alianza para destruir 6 vagones de peste y para llevar a las Élites de la Séptima Legión al Mausoleo de Hibergarde. Si lo logras, habla con Ambo Calderilla dentro del Mausoleo de Hibergarde en el Cementerio de Dragones.‡Utiliza un tanque de vapor de la Alianza para destruir 6 vagones de peste y para llevar a las Élites de la Séptima Legión al Mausoleo de Hibergarde. Si lo logras, habla con Ambo Calderilla dentro del Mausoleo de Hibergarde en el Cementerio de Dragones.‡Utilisez un Char à vapeur de l\'Alliance pour détruire 6 Chariots à peste et déposer les Soldats d\'élite de la 7e Légion au Mausolée de Garde-hiver. Si vous réussissez, allez parler à Ambo Cash, à l\'intérieur du Mausolée de Garde-hiver, dans la Désolation des dragons.‡使用联盟蒸汽坦克摧毁6台天灾战车，并将第七军团精英送入暮冬陵园。成功之后与暮冬陵园里的阿姆博·卡什谈一谈。‡駕駛聯盟蒸汽坦克去摧毀6架瘟疫戰車，然後把第七軍團精英送到溫特加德墓塚。成功了之後，就與安柏·凱許交談，他就在龍骨荒野的溫特加德墓塚。',
  }
},
[12327] = {
  {
    'Experiência Extracorpórea‡Опыт вне тела‡Außerkörperliche Erfahrung‡유체 이탈‡Una experiencia extracorporal‡Una experiencia extracorporal‡Expérience extra-corporelle‡梦游体验‡出竅體驗',
    nil,
    'Beba a Poção de Teia Diáfana perto da Bola de Cristal de Ruuna e testemunhe uma Visão do Passado.‡Выпейте зелье из легчайшей пыльцы возле хрустального шара Рууны и узрите видение из прошлого.‡Trinkt den samtigen Trank bei Ruunas Kristallkugel und werdet Zeuge einer Vision der Vergangenheit.‡루나의 수정 구슬 근처에서 명주 물약을 마신 다음 과거의 영상을 들여다 봐야 합니다.‡Bebe la poción delicada mientras estás junto a la bola de cristal de Ruuna y contempla la visión del pasado.‡Bebe la poción delicada mientras estás junto a la bola de cristal de Ruuna y contempla la visión del pasado.‡Buvez la Potion vaporeuse près de la Boule de cristal de Ruuna et assistez à la Vision du passé.‡在卢娜的水晶球旁饮下幻境药水，见证过去的景象。‡在魯巫娜的水晶球旁飲用輕靈藥水，觀看過去的幻象。',
  }
},
[12328] = {
  {
    'O pedido de Ruuna‡Просьба Рууны‡Ruunas Bitte‡루나의 부탁‡La petición de Ruuna‡La petición de Ruuna‡La demande de Ruuna‡卢娜的要求‡魯巫娜的要求',
    nil,
    'Ruuna, a Cega, quer que você obtenha 4 punhados de Poeira Diáfana.‡Рууна Слепая просит вас принести ей четыре горсти легчайшей пыльцы.‡Ruuna die Blinde möchte, dass Ihr 4 Handvoll samtigen Staubs besorgt.‡눈먼 루나가 명주 가루 4줌을 가져다달라고 부탁했습니다.‡Ruuna la Ciega quiere que consigas 4 puñados de polvo delicado.‡Ruuna la Ciega quiere que consigas 4 puñados de polvo delicado.‡Ruuna l\'Aveugle vous demande de vous procurer 4 mesures de Poudre vaporeuse.‡盲眼卢娜要你收集4堆幻境粉尘。‡『瞎子』魯巫娜要你取得4把輕靈粉末。',
  }
},
[12329] = {
  {
    'Destino e coincidência‡Судьба и совпадения‡Schicksal und Zufall‡운명과 우연‡Destino y coincidencia‡Destino y coincidencia‡Destin et coïncidences‡命运与巧合‡命運與巧合',
    nil,
    'Fale com Sasha no Entreposto Pinheiro Branco.‡Поговорите с Сашей в Торговой лавке Белой Сосны.‡Sprecht mit Sasha im Handelsposten Weißkiefer.‡흰 소나무 교역소에 있는 사샤와 대화해야 합니다.‡Habla con Sasha en el Puesto de Venta de Pino Blanco.‡Habla con Sasha en el Puesto de Venta de Pino Blanco.‡Parlez à Sasha au Comptoir du Pin blanc.‡与白松商栈的萨莎谈一谈。‡與白松貿易站的莎夏交談。',
  }
},
[12330] = {
  {
    'Anatólio falará‡Слабое место Анатолия‡Anatol wird reden‡아나톨리 심문‡Anatoly hablará‡Anatoly hablará‡Anatoly va parler‡阿纳托雷‡逼安那托利開口',
    nil,
    'Sasha, no Entreposto Pinheiro Branco, quer que você use o Dardo Tranquilizante em Tatiana na Aldeia Solstício. Traga Tatiana de volta ao Entreposto Pinheiro Branco.‡Саша из Торговой лавки Белой Сосны просит вас выстрелить усыпляющим дротиком в Татьяну, жительницу Деревни Солнцестояния. Принесите ее в Торговую лавку Белой Сосны.‡Sasha im Handelsposten Weißkiefer möchte, dass Ihr den Betäubungspfeil nehmt und ihn auf Tatjana in Julheim schießt. Bringt Tatjana dann zum Handelsposten Weißkiefer zurück.‡흰 소나무 교역소에 있는 사샤가 안정의 단검을 가져가 극지 마을에 있는 타트야나에게 사용해 달라고 부탁했습니다. 타트야나를 흰 소나무 교역소로 데려와야 합니다.‡Sasha en el Puesto de Venta de Pino Blanco quiere que cojas el dardo sedante y lo uses con Tatjana en el Poblado Solsticio. Trae a Tatjana de vuelta al Puesto de Venta de Pino Blanco.‡Sasha en el Puesto de Venta de Pino Blanco quiere que cojas el dardo sedante y lo uses con Tatjana en el Poblado Solsticio. Trae a Tatjana de vuelta al Puesto de Venta de Pino Blanco.‡Sasha au Comptoir du Pin blanc vous demande de prendre la Fléchette tranquillisante et de l\'utiliser sur Tatjana à Solstice. Ramenez ensuite Tatjana au Comptoir du Pin blanc.‡白松商栈的萨莎要你进入冬至村，对塔特亚娜使用麻醉飞镖。然后将塔特亚娜带回白松商栈。‡白松貿易站的莎夏需要你拿著鎮定飛鏢，對著季至村的塔迦納使用。把塔迦納帶回白松貿易站。',
  }
},
