[1947] = {
  {
    'Jornada ao pântano‡Путь в болото‡Reise in die Marschen‡습지대로의 여행‡Viaje al pantano‡Viaje al pantano‡Voyager vers le Marais‡沼泽之旅‡沼澤之旅',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화해야 합니다.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1948] = {
  {
    'Itens do poder‡Волшебные предметы‡Gegenstände der Macht‡강력한 물건‡Objetos de poder‡Objetos de poder‡Les Objets de Puissance‡强大的物品‡強大的物品',
    nil,
    'Traga 1 Jade e a Morácea Carregada por Raio para Tabetha no Pântano Vadeoso.‡Принесите 1 нефрит и шипастый жезл Молний Табете в Пылевые топи.‡Bringt 1 Stück Jade und den vom Blitz aufgeladenen Dornbusch zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 비취 1개와 벼락 맞은 나뭇가지를 가져가야 합니다.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Lleva 1 jade y la zarza electrificada a Tabetha en el Marjal Revolcafango.‡Apporter 1 Jade et le Roncier de foudre à Tabetha, dans le marécage d\'Âprefange.‡将电能草莓和1颗翡翠交给尘泥沼泽的塔贝萨。‡將電能草莓和1顆碧玉交給塵泥沼澤的塔貝薩。',
  }
},
[1949] = {
  {
    'Segredos ocultos‡Великие тайны‡Verborgene Geheimnisse‡숨겨진 비밀‡Secretos escondidos‡Secretos escondidos‡Des secrets cachés‡隐藏的秘密‡隱藏的秘密',
    nil,
    'Fale com Tirth, o Mago, no Salar Cintilante.‡Поговорите с волхвом Тиртом на Мерцающей равнине.‡Sprecht mit Magus Tirth in der schimmernden Ebene.‡소금 평원에 있는 학자 틸스와 대화해야 합니다.‡Habla con Magus Tirth en El Desierto de Sal.‡Habla con Magus Tirth en El Desierto de Sal.‡Parler au magus Tirth dans les Salines.‡和闪光平原的大法师提尔斯谈一谈。‡和閃光平原的魔導師提爾斯談話。',
  }
},
[1950] = {
  {
    'Tente a sorte‡Волшебное слово‡Der Knüller schlechthin‡주문 알아오기‡Santo y seña‡Santo y seña‡Trouver le Scoop‡解封咒语‡解封咒語',
    nil,
    'Encontre a frase que abre o cofre de Tirth e fale novamente com ele.‡Узнайте волшебные слова, отпирающие сейф Тирта и вернитесь к Тирту.‡Bringt den Satz für Tirths Geldkassette in Erfahrung und kehrt zu Tirth zurück.‡틸스의 금고를 여는 주문을 알아서 틸스에게 돌아가야 합니다.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Averigua la frase para la caja fuerte de Tirth y regresa con Tirth.‡Trouvez l\'Incantation pour ouvrir le coffre-fort de Tirth, puis retournez voir Tirth.‡找到提尔斯保险箱的解封咒语，然后向提尔斯复命。‡找到提爾斯保險箱的解封咒語，然後向提爾斯覆命。',
  }
},
[1951] = {
  {
    'Rituais do Poder‡Обряды власти‡Rituale der Macht‡마력의 의식‡Rituales de poder‡Rituales de poder‡Rituels du Pouvoir‡能量仪祭‡能量儀式',
    nil,
    'Leve o livro Rituais do Poder para Tabetha no Pântano Vadeoso.‡Принесите книгу "Обряды власти" Табете в Пылевых топях.‡Bringt das Buch \'Rituale der Macht\' zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 마력의 의식을 가져가야 합니다.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Lleva el libro Rituales de poder a Tabetha en el Marjal Revolcafango.‡Apportez le livre des « Rituels du pouvoir » à Tabetha dans le marécage d\'Âprefange.‡将《能量仪祭》交给尘泥沼泽的塔贝萨。‡將《能量儀式》交給塵泥沼澤的塔貝薩。',
  }
},
[1952] = {
  {
    'Varinha do Mago‡Магический жезл‡Der Zauberstab des Magiers‡마법사의 마법봉‡Varitas de mago‡Varitas de mago‡La baguette du mage‡法师的魔杖‡法師的魔杖',
    nil,
    'Fale com Tabetha depois do ritual.‡Поговорите с Табетой по завершении ритуала.‡Sprecht nach ihrem Ritual mit Tabetha.‡의식이 끝나면 타베사와 대화해야 합니다.‡Habla con Tabetha cuando termine su ritual.‡Habla con Tabetha cuando termine su ritual.‡Parler à Tabetha après son rituel.‡等塔贝萨的仪式完成后，和她谈一谈。‡等塔貝薩的儀式完成後，和她談話。',
  }
},
[1953] = {
  {
    'Retorno ao pântano‡Возвращение на болота‡Rückkehr in die Marschen‡다시 습지대로‡Regresa al Marjal‡Regresa a la Marisma‡Retourner dans le Marais‡返回沼泽‡回到沼澤',
    nil,
    'Fale com Tabetha.‡Поговорите с Табетой.‡Sprecht mit Tabetha.‡타베사와 대화해야 합니다.‡Habla con Tabetha.‡Habla con Tabetha.‡Aller voir Tabetha.‡和塔贝萨谈一谈。‡和塔貝薩談話。',
  }
},
[1954] = {
  {
    'O Orbe Infernal‡Сфера подземного огня‡Die Höllenkugel‡지옥의 보주‡El orbe infernal‡El orbe infernal‡L\'orbe infernal‡地狱火宝珠‡煉獄火寶珠',
    nil,
    'Leve um Orbe Infernal para Tabetha no Pântano Vadeoso.‡Принесите сферу Подземного огня Табете из Пылевых топей.‡Bringt eine Höllenkugel zu Tabetha in den Düstermarschen.‡먼지진흙 습지대에 있는 타베사에게 지옥의 보주를 가져가야 합니다.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Lleva un orbe infernal a Tabetha en el Marjal Revolcafango.‡Apporter un Orbe infernal à Tabetha dans le marécage d\'Âprefange.‡将一颗地狱火宝珠交给尘泥沼泽的塔贝萨。‡將一顆煉獄火寶珠交給塵泥沼澤的塔貝薩。',
  }
},
[1955] = {
  {
    'O Exorcismo‡Поединок с демоном‡Die Austreibung‡악마 퇴치‡El exorcismo‡El exorcismo‡L\'Exorcisme‡驱除魔鬼‡驅除魔鬼',
    nil,
    'Mate o Demônio do Orbe, depois fale com Tabetha.‡Убейте демона сферы, а потом поговорите с Табетой.‡Tötet den Dämon der Kugel und sprecht dann mit Tabetha.‡보주의 악마를 물리치고 타베사와 대화해야 합니다.‡Mata al demonio del orbe y luego habla con Tabetha.‡Mata al demonio del orbe y luego habla con Tabetha.‡Tuez le démon de l\'Orbe, puis parlez à Tabetha.‡杀死宝珠之魔，然后与塔贝萨谈一谈。‡殺死寶珠之魔，然後與塔貝薩談話。',
  }
},
[1956] = {
  {
    'Poder em Uldaman‡Сила Ульдамана‡Macht in Uldaman‡울다만의 마력원천‡Poder en Uldaman‡Poder en Uldaman‡L\'énergie d\'Uldaman‡奥达曼的能量源‡奧達曼的能量源',
    nil,
    'Recupere uma Fonte de Energia de Obsidiana e leve-a para Tabetha no Pântano Vadeoso.‡Добудьте обсидиановый источник силы и принесите его Табете в Пылевые топи.‡Beschafft Euch eine Obsidiankraftquelle und bringt sie in die Düstermarschen zu Tabetha.‡흑요석 마력원천을 구해서 먼지진흙 습지대에 있는 타베사에게 가져가야 합니다.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Hazte con una fuente de poder obsidiano y llévasela a Tabetha en el Marjal Revolcafango.‡Récupérer une Source d\'énergie en obsidienne et la rapporter à Tabetha dans le marécage d\'Âprefange.‡找到一个黑曜石能量源，将其交给尘泥沼泽的塔贝萨。‡找到一個黑曜石能量源，將其交給塵泥沼澤的塔貝薩。',
  }
},
[1957] = {
  {
    'Surtos de mana‡Волнолов маны‡Manawogen‡마력의 폭풍‡Oleadas de maná‡Oleadas de maná‡Les éruptions de mana‡法力怒灵‡法力怒靈',
    nil,
    'Mate 12 Surtos de Mana no tempo limite permitido.‡Убейте 12 волноловов маны за отведенное время.‡Vernichtet 12 Manawogen innerhalb des Zeitlimits.‡주어진 시간 안에 마력의 폭풍 12마리를 물리쳐야 합니다.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Mata 12 oleadas de maná dentro del tiempo permitido.‡Tuer 12 Eruptions de mana dans la limite de temps imposée.‡在限定时间内杀死12只法力怒灵。‡在限定時間內殺死12隻法力怒靈。',
  }
},
[1958] = {
  {
    'Poder celestial‡Небесная сила‡Himmlische Macht‡천공의 힘‡Poder celestial‡Poder celestial‡L\'énergie céleste‡苍穹之力‡天國之力',
    nil,
    nil,
  }
},
[1959] = {
  {
    'Apresente-se a Anastácia‡Задание Анастасии‡Meldung bei Anastasia‡아나스타샤에게 보고‡Preséntate ante Anastasia‡Preséntate ante Anastasia‡Rendre compte à Anastasia‡向安娜斯塔西娅报告‡向安娜斯塔西婭報告',
    nil,
    'Fale com Anastácia Cordato.‡Поговорите с Анастасией Хартвелл.‡Sprecht mit Anastasia Hirschbrunn.‡아나스타샤 하트웰과 대화해야 합니다.‡Habla con Anastasia Hartwell.‡Habla con Anastasia Hartwell.‡Allez voir Anastasia Hartwell.‡和安娜斯塔西娅·哈特威尔谈一谈。‡和安娜斯塔西婭·哈特威爾談話。',
  }
},
[1960] = {
  {
    'Investigue a Loja de Alquimia‡Лавка алхимика‡Untersuchungen im Alchemistenladen‡연금술 상점 조사‡Investiga la tienda de alquimia‡Investiga la tienda de alquimia‡Enquêter dans le magasin de l\'Alchimiste‡调查炼金店‡調查鍊金店',
    nil,
    'Obtenha um Cantochão da Manifestação e um Baú de Cofres de Contenção atrás de Anastácia Cordato. Traga 3 Cofres de Contenção Cheios, o Baú de Cofres de Contenção e o Cantochão da Manifestação para Anastácia na Cidade Baixa.‡Возьмите свиток заклятия Проявления и ящик с шкатулками-духоловками за спиной у Анастасии Хартвелл. Принесите 3 заполненных шкатулки-духоловки, ящик со шкатулками духоловками и заклинание Проявления Анастасии в Подгород.‡Besorgt eine Inkantation der Manifestation und eine Truhe mit Verwahrungskästen von Anastasia Hirschbrunn. Bringt 3 gefüllte Verwahrungskästen, die Truhe mit Verwahrungskästen sowie die Inkantation der Manifestation zu Anastasia in Unterstadt.‡아나스타샤 하트웰의 뒤에 있는 현신의 주문서와 속박의 상자를 집어야 합니다. 언더시티에 있는 아나스타샤 하트웰에게 채워진 속박의 상자 3개와, 속박의 상자, 현신의 주문서를 가져가야 합니다.‡Detrás de Anastasia Hartwell encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Detrás de Anastasia Hartwell encontrarás un Canto de manifestación y un cofre de arcas de contención. Cógelos y lleva 3 arcas de contención llenas, el cofre de arcas de contención y el canto de manifestación a Anastasia en Entrañas.‡Obtenir un Chant de Manifestation et une Caisse de Coffres de retenue placée derrière Anastasia Hartwell. Apporter 3 Coffres de retenue remplis, la Caisse de Coffres de retenue et l\'Incantation de Manifestation à Anastasia Hartwell à Fossoyeuse.‡从安娜斯塔西娅·哈特威尔身后拿取一根显形卷轴以及一盒封灵箱。将3个装满的封灵箱交给幽暗城的安娜斯塔西娅·哈特威尔。‡從安娜斯塔西婭·哈特威爾身後拿取一根顯形卷軸以及一盒封靈箱。將3個裝滿的封靈箱交給幽暗城的安娜斯塔西婭·哈特威爾。',
  }
},
[1961] = {
  {
    'Em busca de materiais‡Сбор материалов‡Materialsammlung‡재료 수집‡Recolección de materiales‡Recolección de materiales‡Rassembler les matériaux‡收集原料‡收集原料',
    nil,
    'Leve 10 peças de Linho e 6 Gemas de Mana de Dalaran para Josefo Gregório.‡Принесите 10 кусков льна и 6 даларанских самоцветов маны Джозефу Грегориану.‡Bringt 10 Leinenstoff und 6 Manaedelsteine aus Dalaran zu Josef Gregorian.‡조셉 그레고리안에게 리넨 옷감 10장과 달라란 마나석 6개를 가져가야 합니다.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Consigue 10 trozos de paño de lino y 6 gemas de maná de Dalaran para Josef Gregorian.‡Apporter 10 morceaux d\'Etoffe de lin et 6 Gemmes de mana de Dalaran à Josef Gregorian.‡把10块亚麻布和6块达拉然法力宝石带给乔瑟夫·格里高利。‡把10塊亞麻布和6塊達拉然法力寶石帶給喬瑟夫·格里高利。',
  }
},
[1962] = {
  {
    'Vestes de fogo místico‡Одеяние из огненной чароткани‡Roben des Zauberfeuers‡마법불꽃 로브‡Toga de fuego de hechizo‡Toga de fuego de hechizo‡Robe du feu-sorcier‡魔焰长袍‡魔焰長袍',
