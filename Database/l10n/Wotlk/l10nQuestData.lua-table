[7926] = {
  {
    'A Feira de Negraluna‡Ярмарка Новолуния‡Der Dunkelmond-Jahrmarkt‡다크문 축제‡La Feria de la Luna Negra‡La Feria de la Luna Negra‡La foire de Sombrelune‡暗月马戏团‡暗月馬戲團',
    nil,
    'Entregue o Vale-ingresso para Gelvas Portassuja na Feira de Negraluna.‡Передайте сертификат на призовой купон Гельвасу Угольному Шлюзу в лагерь ярмарки Новолуния.‡Bringt den Gutschein zu Gelvas Rußgatter, der sich innerhalb des Dunkelmond-Jahrmarkts aufhält.‡다크문 축제가 열리고 있는 장소로 가서 겔바스 그림게이트에게 무료 상품 교환권을 제출해야 합니다.‡Entrega el vale a Gelvas Roñas, que estará justo pasada la entrada de la Feria de la Luna Negra.‡Entrega el vale de entrada gratuita a Gelvas Roñoso en la Feria de la Luna Negra.‡Donnez le Coupon pour des bons gratuits à Gelvas Crasseporte, qui se trouve dans la foire de Sombrelune.‡到暗月马戏团的场地里去，将免费券交给吉瓦斯·格里加特。‡將這張免費獎券兌換券交給暗月馬戲團中的吉瓦斯·葛萊蓋特。',
  }
},
[7927] = {
  {
    'Baralho de Portais de Negraluna‡Карты Новолуния:Порталы‡Portalkartenset des Dunkelmond-Jahrmarkts‡다크문 차원문 카드 한 벌‡La baraja de Portales de la Luna Negra‡La baraja de Portales de la Luna Negra‡Suite de Portails de Sombrelune‡暗月入口套牌‡暗月傳送門套卡',
    nil,
    'Devolva o Baralho de Portais à Feira de Negraluna quando ela voltar à cidade.‡Принесите карты Порталов на ярмарку Новолуния.‡Gebt das Portalkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 차원문 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Portales a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Portales a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Portails à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把入口套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把傳傳送門套卡交給他們。',
  }
},
[7928] = {
  {
    'Baralho de Generais de Negraluna‡Колода карт Новолуния: Полководцы‡Kriegsfürstenkartenset des Dunkelmond-Jahrmarkts‡다크문 대장군 카드 한 벌‡La baraja de Señores de la Guerra de la Luna Negra‡La baraja de Señores de la Guerra de la Luna Negra‡Suite de Seigneurs de guerre de Sombrelune‡暗月督军套牌‡暗月督軍套卡',
    nil,
    'Devolva o Baralho de Generais à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Полководцев на ярмарку Новолуния.‡Gebt das Kriegsfürstenkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 대장군 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Señores de la Guerra a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Señores de la Guerra a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite de Seigneurs de guerre à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把督军套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把督軍套卡交給他們。',
  }
},
[7929] = {
  {
    'Baralho de Elementais de Negraluna‡Колода карт Новолуния: Элементали‡Elementarkartenset des Dunkelmond-Jahrmarkts‡다크문 정령 카드 한 벌‡La baraja de Elementales de la Luna Negra‡La baraja de Elementales de la Luna Negra‡Suite d\'Elémentaires de Sombrelune‡暗月元素套牌‡暗月元素套卡',
    nil,
    'Devolva o Baralho de Elementais à Feira de Negraluna quando ela voltar à cidade.‡Принесите колоду Элементалей на ярмарку Новолуния.‡Gebt das Elementarkartenset auf dem Dunkelmond-Jahrmarkt ab, sobald dieser wieder in der Stadt ist.‡다크문 유랑단이 마을에 오면 정령 카드 한 벌을 돌려줘야 합니다.‡Lleva la baraja de Elementales a la Feria de la Luna Negra cuando pase por la ciudad.‡Lleva la baraja de Elementales a la Feria de la Luna Negra cuando pase por la ciudad.‡Rapporter la suite d\'Elémentaires à la foire de Sombrelune quand elle reviendra en ville.‡当暗月马戏团来到镇上的时候，把元素套牌交给他们。‡當暗月馬戲團來到鎮上的時候，把元素套卡交給他們。',
  }
},
