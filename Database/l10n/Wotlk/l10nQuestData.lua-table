    nil,
  }
},
[9484] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Falcodrago Enlouquecido. Depois, fale novamente com a Tenente Correalba.‡Приручите безумного дракондора с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Зари.‡Verwendet die Zähmerrute, um einen wahnsinnigen Drachenfalken zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 광포한 용매를 길들인 후 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un dracohalcón enloquecido y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un dracohalcón enloquecido y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser un Faucon-dragon affolé, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只疯狂的龙鹰，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服瘋狂的龍鷹，然後再回到曦奔中尉那裡。',
  }
},
[9485] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Brumorcego. Depois, fale novamente com a Tenente Correalba.‡Приручите мрачницу с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Зари.‡Verwendet die Zähmerrute, um eine Nebelfledermaus zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 안개박쥐를 길들인 다음 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un murciélago brumoso y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un murciélago brumoso y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser une Brumoptère, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只迷雾蝠，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服迷霧蝙蝠，然後再回到曦奔中尉那裡。',
  }
},
[9486] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡야수 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Bastão de Adestramento para domar um Garrataque Ancião. Depois, fale novamente com a Tenente Correalba.‡Приручите взрослого прыголапа с помощью хлыста приручения, потом вернитесь к лейтенанту Вестнице Зари.‡Verwendet die Zähmerrute, um eine alte Bachtatze zu zähmen. Kehrt anschließend zu Leutnant Dämmerflucht zurück.‡조련용 막대를 사용하여 덩치 큰 갈기발 스라소니를 길들인 다음 부관 돈러너에게 돌아가십시오.‡Usa la fusta de doma para domar un garragil mayor y vuelve junto a la teniente Correalba.‡Usa la fusta de doma para domar un garragil anciano y vuelve junto a la teniente Correalba.‡Utilisez le Bâtonnet de domptage pour apprivoiser un Ancien Preste-patte, puis retournez voir le lieutenant Coursaurore.‡使用驯兽棒驯服一只老魔泉豹，然后向达恩·晨行者中尉复命。‡用馴獸棒來馴服年長的泉爪山貓，然後再回到曦奔中尉那裡。',
  }
},
[9487] = {
  {
    'Aniquiladores arcanos‡Волшебные разорители‡Arkanhäscher‡비전 약탈자‡Atracadores Arcanos‡Atracadores Arcanos‡Les saccageurs des arcanes‡奥术掠夺者‡秘法劫奪者',
    nil,
    'O Arcanista Vandril quer que você colete 10 Fragmentos Arcanos para ele.‡Чародей Вандрил хочет, чтобы вы принесли ему 10 осколков тайной магии.‡Arkanist Vandril möchte, dass Ihr 10 Arkantrümmer für ihn sammelt.‡비전술사 반드릴이 비전 조각 10개를 모아달라고 합니다.‡El arcanista Vandril quiere que reúnas 10 fragmentos arcanos para él.‡El arcanista Vandril quiere que reúnas 10 fragmentos arcanos para él.‡L\'arcaniste Vandril veut que vous récupériez 10 Fragments arcaniques pour son compte.‡奥术师范迪瑞尔要你为他收集10块奥术残片。‡秘法師范德隆要你收集10個秘法碎片給他。',
  }
},
[9488] = {
  {
    'Um robe simples‡Простое одеяние‡Eine einfache Robe‡간단한 로브‡Una toga sencilla‡Una toga sencilla‡Une robe simple‡简单的长袍‡一件簡單的長袍',
    nil,
    'O Arcanista Vandril quer que você leve 15 Pedaços de Linho e uma Glândula de Seda de Fusaracna.‡Чародей Вандрил хочет, чтобы вы принесли ему 15 кусков льняной ткани и паутинную железу паука-прядильщика.‡Arkanist Vandril möchte, dass Ihr ihm 15 Leinenstoff und eine Seidendrüse der Spindelweber bringt.‡비전술사 반드릴이 리넨 옷감 15개, 물레그물 분비선 1개를 모아달라고 부탁했습니다.‡El arcanista Vandril quiere que le lleves 15 piezas de paño de lino y 1 glándula de seda de husaraña.‡El arcanista Vandril quiere que le lleves 15 piezas de paño de lino y 1 glándula de seda de husaraña.‡L\'arcaniste Vandril a besoin de 15 Etoffes de lin et d\'une Glande à soie de filetoile.‡将15张亚麻布和1个纺丝蜘蛛的丝囊交给奥术师范迪瑞尔。‡秘法師范德隆要你幫他帶來15塊亞麻布和一個細網絲囊。',
  }
},
[9489] = {
  {
    'Purificando a trilha‡Поднять боевой дух‡Ordnung in der Schneise‡흉터 치유‡Limpiar La Cicatriz‡Limpiar La Cicatriz‡Purifier la Malebrèche‡清理死亡之痕‡淨化斷崖',
    nil,
    'Lance Palavra de Poder: Fortitude em 6 Patrulheiros de Canto Eterno na Trilha da Morte.‡Примените "Слово Силы: Стойкость" к 6 следопытам из лесов Вечной Песни на Тропе Мертвых.‡Wirkt das Machtwort: Seelenstärke auf 6 Waldläufer von Immersang in der Todesschneise.‡죽음의 흉터에 있는 영원노래 순찰자 6명에게 신의 권능: 인내를 시전해야 합니다.‡Lanza Palabra de poder: entereza a 6 forestales Canción Eterna en La Cicatriz Muerta.‡Lanza Palabra de poder: entereza a 6 forestales Canción Eterna en La Cicatriz Muerta.‡Lancez Mot de pouvoir : Robustesse sur 6 Forestiers des Chants éternels dans la Malebrèche.‡对死亡之痕的6个永歌游侠施放真言术：韧。‡對死亡之痕的6個永歌森林遊俠施放真言術:韌。',
  }
},
[9490] = {
  {
    'A matriarca esfola-pedra‡Матриарх камнедеров‡Die Felsklauenmatriarchin‡이칸의 복수‡La matriarca despellejadora de roca‡La matriarca despellejadora de roca‡La matriarche des écorche-roc‡剥石者的女王‡岩石鐮奪怪女王',
    nil,
    'Obtenha as Garras de Garranegra, a Selvagem, na Grande Fenda, e leve-a para Ikan, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Добудьте когти Свирепой Черноскребки, которая обитает в Глубоком Разломе и принесите их Икану в храм Телхамат на полуострове Адского Пламени.‡Besorgt Schwarzkralles Klauen von Schwarzkralle der Wilden in der großen Kluft und bringt sie zu Ikan beim Tempel von Telhamat auf der Höllenfeuerhalbinsel.‡거대한 균열에 있는 흉포한 검은갈퀴의 발톱을 지니고, 지옥불 반도의 텔하마트 사원에 있는 이칸에게 가져가야 합니다.‡Consigue una garra de Garranegra el Indómito en La Gran Fisura y llévasela a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Consigue las garras de Garfanegra la Indómita en La Gran Fisura y llévasela a Ikan en el Templo de Telhamat, en la Península del Fuego Infernal.‡Prenez les Griffes de Griffe-noire la Sauvage dans la Grande fissure et remettez-les à Ikan, au temple de Telhamat la Péninsule des flammes infernales.‡前往大裂隙杀死凶猛的黑色利爪，将黑色利爪的爪子交给地狱火半岛塔哈玛特神殿的伊坎。‡從大裂縫的『野蠻者』黑爪身上取得黑爪之爪，將它帶回地獄火半島給特爾哈曼神廟的依坎。',
  }
},
[9491] = {
  {
    'Greed‡Не откажусь‡Gier‡욕심‡Avaricia‡Avaricia‡Cupidité‡贪婪‡貪婪',
    nil,
    'Eralan, em Tranquillien, quer que você recupere o Elo Coberto de Ouro das Catacumbas Amani.‡Эраланна из Транквиллиона хочет, чтобы вы добыли исцарапанное золотое кольцо из катакомб Амани.‡Eralan in Tristessa möchte, dass Ihr ihr einen gekörnten Goldring aus den Amanikatakomben bringt.‡트랜퀼리엔에 있는 에랄란이 아마니 지하묘지에서 흠집 난 금반지를 구해오라고 부탁했습니다.‡Eralan de Tranquillien quiere que encuentres el anillo de oro marcado en las Catacumbas Amani.‡Eralan de Tranquillien quiere que encuentres el anillo de oro marcado en las Catacumbas Amani.‡Erelan, à Tranquillien, veut que vous retrouviez la Bague ébréchée en or dans les catacombes des Amani.‡前往阿曼尼墓穴取回陪葬的金戒指，然后向塔奎林的艾拉兰复命。‡安寧地的依蘭兒要你從阿曼尼地下墓穴取回缺口金指環。',
  }
},
[9492] = {
  {
    'Virando o jogo‡Новый поворот событий‡Das Schicksal wenden‡전황의 변화‡Girando las tornas‡Girando las tornas‡L\'heure du tournant‡扭转战局‡扭轉情勢',
    nil,
    'Leve o Punho do Chefe Guerreiro Karrath para o Comandante-chefe Danath Matatroll na Fortaleza da Honra.‡Принесите кулак вождя Каргата боевому командиру Данату Троллебою в Оплот Чести.‡Bringt Kriegshäuptling Kargaths Faust zu Truppenkommandant Danath Trollbann in der Ehrenfeste.‡명예의 요새에 있는 전투사령관 다나스 트롤베인에게 대족장 카르가스의 주먹을 가져가야 합니다.‡Lleva el puño del Jefe de Guerra Kargath al comandante en jefe Danath Aterratrols al Bastión del Honor.‡Lleva el puño del Jefe de Guerra Kargath al comandante en jefe Danath Aterratrols al Bastión del Honor.‡Apportez le Poing du chef de guerre Kargath au commandant Danath Trollemort, au Bastion de l\'Honneur.‡将卡加斯酋长之拳交给荣耀堡的远征军指挥官达纳斯·托尔贝恩。‡把大酋長卡加斯之手帶給榮譽堡的軍隊指揮者達納斯·托爾貝恩。',
  }
},
[9493] = {
  {
    'Orgulho da Horda Vil‡Элита Орды Скверны‡Der Stolz der Höllenhorde‡타락한 호드의 자랑‡El orgullo de la Horda vil‡El orgullo de la Horda vil‡L\'orgueil de la Gangr\'horde‡邪部落的荣耀‡魔獄部落的驕傲',
    nil,
    'O Comandante de Campo Rômulo, na Fortaleza da Honra, quer que você mate 8 Legionários da Mão Despedaçada, 4 Centuriões da Mão Despedaçada e 4 Campeões da Mão Despedaçada.‡Убейте 8 легионеров клана Изувеченной Длани, 4 центуриона клана Изувеченной Длани и 4 воителей клана Изувеченной Длани по приказу боевого командира Ромуса из Оплота Чести.‡Feldkommandeur Romus in der Ehrenfeste möchte, dass Ihr 8 Legionäre der Zerschmetterten Hand, 4 Zenturios der Zerschmetterten Hand und 4 Champions der Zerschmetterten Hand tötet.‡명예의 요새에 있는 야전사령관 로무스가 으스러진 손의 군단병 8명, 으스러진 손의 백인대장과 용사를 각각 4명씩 처치해 달라고 부탁했습니다.‡El comandante de campo Romus del Bastión del Honor quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 campeones Mano Destrozada.‡El comandante de operaciones Romus del Bastión del Honor quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 campeones Mano Destrozada.‡Le commandant Romus du Bastion de l\'Honneur veut que vous alliez tuer 8 Légionnaires de la Main brisée, 4 Centurions de la Main brisée et 4 Champions de la Main brisée.‡荣耀堡的战地指挥官洛姆斯要求你杀死8名碎手军团士兵、4名碎手百夫长和4名碎手勇士。‡榮譽堡的戰場元帥洛摩斯要你殺死8個破碎之手軍團士兵，4個破碎之手百夫長，和4個破碎之手勇士。',
  }
},
[9494] = {
  {
    'Brasas vis‡Угли Скверны‡Teufelsglut‡지옥의 불씨‡Ascuas viles‡Ascuas viles‡Les gangrebraises‡邪能灰烬‡魔化餘燼',
    nil,
    'A Magus Zabraxis, na Fortaleza da Honra, quer que você lhe traga uma Brasa Vil.‡Принесите уголь Скверны волхву Забраксис из Оплота Чести.‡Magus Zabraxis in der Ehrenfeste möchte, dass Ihr ihr ein Stück Teufelsglut bringt.‡명예의 요새에 있는 대학자 자브라시스가 지옥의 불씨를 가져다 달라고 부탁했습니다.‡La magus Zabraxis del Bastión del Honor quiere que le lleves ascuas viles.‡La magus Zabraxis del Bastión del Honor quiere que le lleves ascuas viles.‡Le magus Zabraxis du Bastion de l\'Honneur veut que vous lui rapportiez une Gangrebraise.‡荣耀堡的大法师萨布兰希要求你给她带回一块邪能灰烬。‡榮譽堡的魔導師薩柏瑞希斯要你幫她帶來一份魔化餘燼。',
  }
},
[9495] = {
  {
    'A vontade do Chefe Guerreiro‡Воля Вождя‡Der Wille des Kriegshäuptlings‡대족장의 의지‡La voluntad del Jefe de Guerra‡La voluntad del Jefe de Guerra‡La volonté du Chef de guerre‡酋长的意志‡大酋長的希望',
    nil,
    'Leve o Punho do Chefe Guerreiro Karrath para Nazgrel, em Thrallmar.‡Принесите кулак вождя Каргата Назгрелу в Траллмар.‡Bringt Kriegshäuptling Kargaths Faust zu Nazgrel in Thrallmar.‡스랄마에 있는 나즈그렐에게 대족장 카르가스의 주먹을 가져가야 합니다.‡Lleva el puño del Jefe de Guerra Kargath a Nazgrel a Thrallmar.‡Lleva el puño del Jefe de Guerra Kargath a Nazgrel a Thrallmar.‡Nazgrel à Thrallmar veut que vous lui rapportiez le Poing du chef de guerre Kargath.‡将卡加斯酋长之拳交给萨尔玛的纳兹格雷尔。‡把大酋長卡加斯之手帶給索爾瑪的納茲格雷爾。',
  }
},
[9496] = {
  {
    'Orgulho da Horda Vil‡Элита Орды Скверны‡Der Stolz der Höllenhorde‡타락한 호드의 자랑‡El orgullo de la Horda vil‡El orgullo de la Horda vil‡L\'orgueil de la Gangr\'horde‡邪部落的荣耀‡魔獄部落的驕傲',
    nil,
    'O Caçador Sombrio Ty\'jin, em Thrallmar, quer que você mate 8 Legionários da Mão Despedaçada, 4 Centuriões da Mão Despedaçada e 4 Campeões da Mão Despedaçada.‡Убейте 8 легионеров клана Изувеченной Длани, 4 центуриона клана Изувеченной Длани и 4 воителей из клана Изувеченной Длани по приказу темного охотника Туджина из Траллмара.‡Schattenjäger Ty\'jin in Thrallmar möchte, dass Ihr 8 Legionäre der Zerschmetterten Hand, 4 Zenturios der Zerschmetterten Hand und 4 Champions der Zerschmetterten Hand tötet.‡스랄마에 있는 어둠사냥꾼 타이진이 으스러진 손의 군단병 8명, 으스러진 손의 백인대장 4명, 그리고 으스러진 손의 용사 4명을 처치해 달라고 부탁했습니다.‡El cazador de las Sombras Ty\'jin de Thrallmar quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 Campeones Mano Destrozada.‡El cazador de las Sombras Ty\'jin de Thrallmar quiere que mates a 8 legionarios Mano Destrozada, 4 centuriones Mano Destrozada y 4 Campeones Mano Destrozada.‡Le chasseur des ombres Ty\'jin, de Thrallmar, veut que vous tuiez 8 Légionnaires de la Main brisée, 4 Centurions de la Main brisée et 4 Champions de la Main brisée.‡萨尔玛的暗影猎手塔金要求你杀死8名碎手军团士兵、4名碎手百夫长和4名碎手勇士。‡索爾瑪的影子獵人泰巾要你殺死8個破碎之手軍團士兵，4個破碎之手百夫長，和4個破碎之手勇士。',
  }
},
[9497] = {
  {
    'O emblema da Horda Vil‡Знамя Орды Скверны‡Emblem der Höllenhorde‡타락한 호드의 문장‡El emblema de la Horda vil‡El emblema de la Horda vil‡Le symbole de la Gangr\'horde‡邪部落的象征‡魔獄部落的徽章',
    nil,
    'Mate o Armipotente O\'mrogg e capture o Estandarte da Horda Vil. Em seguida, devolva-o ao Suserano Huno Mutilapunho em Thrallmar.‡Убейте О\'мрогга Завоевателя и захватите ордынское знамя Скверны. После этого возвращайтесь к властителю Хану Изуверу в Траллмар.‡Tötet Kriegshetzer O\'mrogg und besorgt Euch das Banner der Höllenhorde. Kehrt danach zu Oberanführer Hun Stümmelfaust in Thrallmar zurück.‡돌격대장 오므로그를 처치하고 타락한 호드 깃발을 차지한 후, 스랄마에 있는 대군주 훈 메임피스트에게 깃발을 가져가야 합니다.‡Mata al belisario O\'mrogg. Captura el estandarte de la Horda vil y llévaselo al señor supremo Hun Puñolisiado a Thrallmar.‡Mata al belisario O\'mrogg. Captura el estandarte de la Horda vil y llévaselo al señor supremo Hun Puñolisiado a Thrallmar.‡Tuez le porteguerre O\'mrogg, emparez-vous de la Bannière de la Gangr\'horde et remettez-la au suzerain Hun Mutilepoing à Thrallmar.‡杀死战争使者沃姆罗格，并夺得邪部落军旗，然后把它交给萨尔玛的大督军霍恩·重拳。‡殺了戰爭使者歐姆拉格並取得魔獄部落旌旗，然後再回索爾瑪的霸主殘拳那裡。',
  }
},
[9498] = {
  {
    'Vigília do Falcão‡Соколиный дозор‡Falkenwacht‡매의 감시탑‡La Avanzada del Halcón‡La Avanzada del Halcón‡Le Guet de l\'épervier‡猎鹰岗哨‡獵鷹哨站',
    nil,
    'Apresente-se ao Capitão-patrulheiro Venn\'ren, na Vigília do Falcão, na Península Fogo do Inferno.‡Доложитесь капитану следопытов Венн\'рену в Соколином дозоре на полуострове Адского Пламени.‡Meldet Euch bei Waldläuferhauptmann Venn\'ren bei der Falkenwacht auf der Höllenfeuerhalbinsel.‡지옥불 반도의 매의 감시탑에 있는 순찰대장 벤렌에게 보고해야 합니다.‡Preséntate ante el capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Preséntate ante el capitán forestal Venn\'ren en la Avanzada del Halcón en la Península del Fuego Infernal.‡Présentez-vous au capitaine des forestiers Venn\'ren au Guet de l\'épervier de la péninsule des Flammes infernales.‡前往地狱火半岛的猎鹰岗哨，向游侠队长维恩雷报到。‡到地獄火半島向獵鷹哨站的遊俠隊長范瑞報告。',
  }
},
[9499] = {
  {
    'Vigília do Falcão‡Соколиный дозор‡Falkenwacht‡매의 감시탑‡La Avanzada del Halcón‡La Avanzada del Halcón‡Le Guet de l\'épervier‡猎鹰岗哨‡獵鷹哨站',
    nil,
    'Vá para a Vigília do Falcão, no sudoeste da Península Fogo do Inferno, e apresente-se ao Capitão-patrulheiro Venn\'ren.‡Отправляйтесь в Соколиный дозор, на юго-запад полуострова Адского Пламени, и поговорите с капитаном следопытов Венн\'реном.‡Reist zur Falkenwacht im Südwesten der Höllenfeuerhalbinsel und meldet Euch bei Waldläuferhauptmann Venn\'ren.‡지옥불 반도의 남서쪽에 있는 매의 감시탑으로 간 후 순찰대장 벤렌에게 보고해야 합니다.‡Ve a la Avanzada del Halcón al suroeste de la Península del Fuego Infernal y preséntate ante el capitán forestal Venn\'ren.‡Ve a la Avanzada del Halcón al suroeste de la Península del Fuego Infernal y preséntate ante el capitán forestal Venn\'ren.‡Rendez-vous au Guet de l\'épervier au sud-ouest de la péninsule des Flammes infernales et présentez-vous au capitaine des forestiers Venn\'ren.‡前往地狱火半岛西南方的猎鹰岗哨，向游侠队长维恩雷报到。‡前往地獄火半島西南方的獵鷹哨站並向遊俠隊長范瑞報告。',
  }
},
[9500] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Найдите на острове Лазурной Дымки в Кристальном зале Экзодара предсказателя Нобундо и поговорите с ним.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르의 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l\'intérieur de l\'Exodar sur l\'île de Brume-azur.‡与埃索达内水晶大厅的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9501] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com Aquos no Recife Oculto da Ilha Névoa Rubra.‡Найдите Водяницу у Подводного Рифа возле острова Кровавой Дымки и поговорите с ней.‡Sprecht mit Aqueous im versteckten Riff bei der Blutmythosinsel.‡핏빛안개 섬의 숨은 산호초에 있는 아쿠에어스와 대화해야 합니다.‡Ve a El Arrecife Oculto, en la Isla Bruma de Sangre, y habla con Acuosa‡Ve a El Arrecife Oculto, en la Isla Bruma de Sangre, y habla con Acuosa.‡Parlez à Aqueuse, à l\'intérieur du Récif caché, près de l\'île de Brume-sang.‡与秘血岛藏帆暗礁的阿奎欧斯谈一谈。‡到血謎島的隱秘沙洲和阿基歐斯談談。',
  }
},
[9502] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Найдите на острове Лазурной Дымки в Кристальном зале Экзодара предсказателя Нобундо и поговорите с ним.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l\'intérieur de l\'Exodar sur l\'île de Brume-azur.‡与埃索达内水晶大厅的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9503] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Colete 6 Essências Pútridas e leve tudo para Aquos, no Recife Oculto da Ilha Névoa Rubra.‡Принесите 6 бутылочек смрадной эссенции на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте Водянице.‡Sammelt 6 besudelte Essenzen ein und bringt sie zu Aqueous im versteckten Riff bei der Blutmythosinsel.‡부정의 정수를 6개를 모은 후 핏빛안개 섬 근처의 숨은 산호초에 있는 아쿠에어스에게 돌아가야 합니다.‡Reúne 6 viales de esencia hedionda y llévaselas a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Reúne 6 viales de esencia hedionda y llévaselas a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Récupérer 6 Essences infectes et les remettre à Aqueuse, au Récif caché, près de l\'île de Brume-sang.‡收集6份邪恶精华，把它们交给秘血岛藏帆暗礁的阿奎欧斯。‡收集6份腐敗精華再帶回血謎島給隱秘沙洲的阿基歐斯。',
  }
},
[9504] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Encha o Odre Rústico Vazio e volte até Aquos no Recife Oculto da Ilha Névoa Rubra.‡Наполните пустой бурдюк, а затем вернитесь на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте бурдюк Водянице.‡Füllt den leeren Botabeutel und kehrt anschließend zu Aqueous im versteckten Riff bei der Blutmythosinsel zurück.‡빈 물주머니를 채운 후 핏빛안개 섬 근처의 숨은 산호초에 있는 아쿠에어스에게로 돌아가야 합니다.‡Llena la bota y llévasela a Acuosa a El Arrecife Oculto en la Isla Bruma de Sangre.‡Llena la bota y llévasela a Acuosa a El Arrecife Oculto en la Isla Bruma de Sangre.‡Remplir la Gourde en peau vide et retourner voir Aqueuse, au Récif caché, près de l\'île de Brume-sang.‡将水注满空的波涛之袋，然后把它交给秘血岛藏帆暗礁的阿奎欧斯。‡裝滿空皮製水袋再回到血謎島的隱秘沙洲找阿基歐斯。',
  }
},
[9505] = {
  {
    'A profecia de Velen‡Пророчество Велена‡Die Prophezeiung von Velen‡벨렌의 예언‡La profecía de Velen‡La profecía de Velen‡La prophétie de Velen‡维伦的预言‡費倫的預言',
    nil,
    'Daedal quer que você viaje para o sul e que procure as pessoas que a criatura ferida mencionou.‡Отправляйтесь на юг и отыщите народ, о котором говорило раненое существо.‡Daedal möchte, dass Ihr nach Süden reist und die Personen aufsucht, von denen das verletzte Wesen gesprochen hat.‡대달이 남쪽으로 가서 앞서 말한 부상당한 존재의 동족을 찾아달라고 부탁했습니다.‡Daedal quiere que vayas hacia el sur y busques al pueblo que mencionó la criatura herida.‡Daedal quiere que vayas hacia el sur y busques al pueblo que mencionó la criatura herida.‡Daedal veut que vous alliez au sud, à la recherche des gens mentionnés par la créature blessée.‡丹达尔希望你到南方去寻找这个受伤的生物提到的人。‡爹達歐要你前往南方找到受傷的生物提到的人們。',
  }
},
[9506] = {
  {
    'Um pequeno começo‡Начало положено‡Ein kleiner Anfang‡연합의 시작‡Un pequeño susto‡Un pequeño susto‡Il faut bien commencer quelque part‡第三类接触‡一個小開始',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, quer que você recupere a Bússola Náutica e o Mapa Náutico roubados pela Empreendimentos S.A.‡Верните адмиралу Одиссию морской компас и морскую карту, украденные Торговой компанией.‡Admiral Odesyus bei Odesyus\' Ankerplatz möchte, dass Ihr den von der Venture Co. gestohlenen nautischen Kompass und die nautische Karte wiederbeschafft.‡오디시우스의 정박지의 제독 오디시우스가 투자개발회사에 빼앗긴 항해용 나침반과 항해 지도를 되찾아 달라고 부탁했습니다.‡El almirante Odesyus del Desembarco de Odesyus quiere que recuperes la rosa náutica y el mapa náutico robados por Ventura y Cía.‡El almirante Odesyus del Desembarco de Odesyus quiere que recuperes la brújula marina y el mapa náutico robados por Ventura y Cía.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus, veut que vous récupériez le Compas de marine et la Carte nautique volés par la KapitalRisk.‡奥德修斯营地的海军上将奥德修斯希望你能夺回被风险投资公司偷走的航海罗盘和航海图。‡奧迪席斯平臺的艦隊司令·奧迪席斯要你取回被風險投資公司偷走的航海指南針和航海地圖。',
  }
},
[9508] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve a Cabeça de Tel\'athion para Aquos no Recife Oculto da Ilha Névoa Rubra.‡Принесите голову Телатиона на остров Кровавой Дымки в храм Сокрытого Рифа и отдайте Водянице.‡Bringt Tel\'athions Kopf zu Aqueous im versteckten Riff bei der Blutmythosinsel zurück.‡핏빛안개 섬의 숨은 산호초에 있는 아쿠에어스에게 텔아시온을 죽인 증거를 가져가야 합니다.‡Lleva la cabeza de Tel\'athion a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre‡Lleva la cabeza de Tel\'athion a Acuosa en El Arrecife Oculto, en la Isla Bruma de Sangre.‡Apportez la Tête de Tel\'athion à Aqueuse, du récif caché près de l\'île de Brume-sang.‡将塔希恩的徽记交给秘血岛藏帆暗礁的阿奎欧斯。‡把泰阿希恩的頭顱帶到血謎島給隱秘沙洲的阿基歐斯。',
  }
},
[9509] = {
  {
    'Call of Water‡Зов Воды‡Ruf des Wassers‡물의 부름‡La llamada del agua‡La llamada del agua‡L\'appel de l\'eau‡水之召唤‡水之召喚',
    nil,
    'Leve o Frasco da Mais Pura Água para o Clarividente Nobambo na Exodar, na Ilha Névoa Lazúli.‡Отнесите флакон чистейшей воды предсказателю Нобундо. Его можно найти на острове Лазурной Дымки в Экзодаре.‡Nehmt das Fläschchen mit reinstem Wasser zu Weissager Nobundo innerhalb der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 안에 있는 선견자 노분도에게 순수한 물이 든 병을 가져가야 합니다.‡Llévale el frasco del agua más pura al clarividente Nobundo en El Exodar, en la Isla Bruma Azur.‡Llévale el frasco del agua más pura al clarividente Nobundo en El Exodar, en la Isla Bruma Azur.‡Remettez la Flasque de l\'eau la plus pure au long-voyant Nobundo à l\'intérieur de l\'Exodar sur l\'île de Brume-azur.‡将纯水之瓶交给秘蓝岛埃索达的预言者努波顿。‡把純淨水瓶帶回藍謎島給艾克索達的先知諾柏多。',
  }
},
[9510] = {
  {
    '‡Шкура щетинистого копытня‡Bälge eines borstigen Grollhufs‡‡Pellejos de uñagrieta lomohirsuto‡Pellejos de uñagrieta lomohirsuto‡Les peaux de sabots-fourchus poil-hirsute‡刺毛裂蹄兽皮‡',
    nil,
    '‡Добудьте 5 шкур щетинистого копытня по просьбе поставщика Бракнара с Заставы маг\'харов на Полуострове Адского Пламени.‡Versorger Braknar beim Mag\'harposten auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 5 Bälge eines borstigen Grollhufs bringt.‡‡El proveedor Braknar del Puesto Mag\'har, en la Península del Fuego Infernal, quiere que le lleves 5 pellejos de uñagrieta lomohirsuto.‡El proveedor Braknar del Puesto Mag\'har, en la Península del Fuego Infernal, quiere que le lleves 5 pellejos de uñagrieta lomohirsuto.‡L\'approvisionneur Braknar au poste de Mag\'har dans la péninsule des Flammes infernales veut que vous lui rameniez 5 Peaux de sabots-fourchus poil-hirsute.‡‡',
  }
},
[9511] = {
  {
    'Planos de batalha de Karrath‡Боевые планы Каргата‡Kargaths Schlachtpläne‡카르가스의 전투 계획서‡Los planes de guerra de Kargath‡Los planes de guerra de Kargath‡Les plans de bataille de Kargath‡Kargath\'s Battle Plans‡卡加斯的戰鬥計畫書',
    nil,
    nil,
  }
},
[9512] = {
  {
    'Risoto do "Cuca"‡Крабовый супчик поваренка‡Kräckas Jumboeintopf‡쿠키의 세숫대야 스프‡El jumbo gumbo de Cocinitas‡El jumbo gumbo de Cocinitas‡Jumbo gumbo du cuistot‡曲奇的大餐‡廚師的特大燴肉',
    nil,
    '"Cuca" MacMolhofraco, no Assentamento de Odisseu, quer que você lhe traga 6 unidades de Carne de Estalatisco.‡Принесите 6 кусков мяса шустрых крабов "Поваренку" Максоусу в лагерь Одиссия.‡"Kräcka" Aschebäscha bei Odesyus\' Ankerplatz möchte, dass Ihr ihm 6 Stücke Raubkriecherfleisch bringt.‡오디시우스의 정박지의 "쿠키" 맥위크소스가 땅거미 게살 6개를 가져다 달라고 부탁했습니다.‡"Cocinitas" MacSalsafloja en Desembarco de Odesyus quiere que le lleves 6 piezas de carne de reptador sigiloso.‡"Cocinitas" MacSalsafloja en Desembarco de Odesyus quiere que le lleves 6 piezas de carne de reptador sigiloso.|n‡« Cuistot » McFadesauce, au Point d\'accostage d\'Odesyus, veut que vous lui rapportiez 6 Chairs de clampant grouillant.‡奥德修斯营地的"曲奇"米维克索斯要你给他带回6块迅捷螃蟹的肉。‡奧迪席斯平臺的『小廚』麥克威醬要你幫他帶來6塊滑膩的爬行者肉。',
  }
},
[9513] = {
  {
    'A reconquista das ruínas‡Возвращение руин‡Die Rückeroberung der Ruinen‡폐허 수복‡Recuperar las ruinas‡Recuperar las ruinas‡Reconquérir les ruines‡夺回废墟‡奪回廢墟',
    nil,
    'A Sacerdotisa Cailin Il\'dinero, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você mate 5 Mirmidões Escamódio, 5 Nagas Escamódio e 5 Sirenas Escamódio.‡Убейте 5 мирмидонов, 5 наг и 5 сирен из клана Зловещей Чешуи для жрицы Кайлин Ил\'динар.‡Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr 5 Myrmidonen der Hasspranken, 5 Naga der Hasspranken und 5 Sirenen der Hasspranken tötet.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레가 성난비늘일족 미르미돈, 성난비늘일족 나가, 성난비늘일족 세이렌을 각각 5마리씩 처치해 달라고 부탁했습니다.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que mates 5 mirmidones Escama de Cólera, 5 nagas Escama de Cólera y 5 sirenas Escama de Cólera.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que mates 5 mirmidones Escama de Cólera, 5 nagas Escama de Cólera y 5 sirenas Escama de Cólera.‡La Prêtresse Kyleen Il\'dinare, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous tuiez 5 Myrmidons Irécaille, 5 Nagas Irécaille et 5 Sirènes Irécaille.‡秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜要求你杀死5只怒鳞侍从、5只怒鳞纳迦和5只怒鳞海妖。‡藍謎島，奧迪席斯平臺的女牧師凱玲·伊丹奈爾要你殺死5個怒鱗部屬、5個怒鱗納迦和5個怒鱗海妖。',
  }
},
[9514] = {
  {
    'A tabuleta coberta de runas‡Покрытая рунами табличка‡Runenbesetzte Schrifttafel‡룬문자 휘장‡Tablilla cubierta de runas‡Tablilla cubierta de runas‡Tablette couverte de runes‡写满符文的石板‡符文雕飾石板',
    nil,
    'Leve a Tabuleta Coberta de Runas à Sacerdotisa Cailin Il\'dinero no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli.‡Отнеcите покрытую рунами табличку жрице Кайлин Ил\'динар в лагерь Одиссия на острове Лазурной Дымки.‡Bringt die runenbesetzte Schrifttafel zu Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레에게 룬문자 휘장을 가져가야 합니다.‡Llévale la tablilla cubierta de runas a la sacerdotisa Kyleen Il\'dinare a Desembarco de Odesyus en Isla Bruma Azur.|n‡Llévale la tablilla cubierta de runas a la sacerdotisa Kyleen Il\'dinare a Desembarco de Odesyus en Isla Bruma Azur.|n‡Apportez la Tablette couverte de runes à la Prêtresse Kyleen Il\'dinare au Point d\'accostage d\'Odesyus, sur l\'île de Brume-azur.‡将写满符文的石板交给秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜。‡把符文雕飾石板帶到藍謎島給奧迪席斯平臺的女牧師凱玲·伊丹奈爾。',
  }
},
[9515] = {
  {
    'O senhor da guerra Sriss\'tiz‡Полководец Шрисс\'тиз‡Kriegsherr Sriss\'tiz‡장군 스리스티즈 처치‡Señor de la guerra Sriss\'tiz‡Señor de la guerra Sriss\'tiz‡Le seigneur de guerre Sriss\'tiz‡督军斯雷提兹‡督軍司瑞史提斯',
    nil,
    'A Sacerdotisa Cailin Il\'dinero, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você mate o Senhor da Guerra Sriss\'tiz.‡Жрица Кайлин Ил\'динар из лагеря Одиссия попросила вас убить полководца Шрисс\'тиза.‡Priesterin Kyleen Il\'dinare bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr Kriegsherr Sriss\'tiz tötet.‡하늘안개 섬의 오디시우스의 정박지에 있는 여사제 킬린 일디나레가 장군 스리스티즈를 처치해 달라고 부탁했습니다.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus en la Isla Bruma Azur quiere que mates al señor de la guerra Sriss\'tiz.‡La sacerdotisa Kyleen Il\'dinare en el Desembarco de Odesyus en la Isla Bruma Azur quiere que mates al señor de la guerra Sriss\'tiz.‡La Prêtresse Kyleen Il\'dinare, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous tuiez le chef de guerre Sriss\'tiz.‡秘蓝岛奥德修斯营地的女祭司基琳·伊尔蒂娜要求你杀死督军斯雷提兹。‡藍謎島，奧迪席斯平臺的女牧師凱玲·伊丹奈爾要你殺了督軍司瑞史提斯。',
  }
},
[9516] = {
  {
    'Destroy the Legion‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruye a la Legión‡Destruye a la Legión‡Détruire la Légion‡毁灭燃烧军团‡摧毀軍團',
    nil,
    'Mate 6 Açoitadeiras Mannoroth, 6 Guardas Vis e 6 Infernais Abrasadores. Depois, fale novamente com o Vindicante Vedaar na Cantilenda, que fica no Vale Gris.‡Уничтожьте 6 бичевательниц Маннорока, 6 стражей Скверны и 6 опаляющих инферналов, а затем вернитесь к воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Tötet 6 Mannorocpeitscher, 6 Teufelswachen und 6 Sengende Höllenbestien und kehrt dann zu Verteidiger Vedaar in Waldeslied im Eschental zurück.‡만노로크 채찍마녀 6명, 떠도는 지옥군단병 6명, 불타는 지옥불정령 6마리를 처치한 후, 잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 돌아가야 합니다.‡Mata 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Mata 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Tuez 6 Flagellantes de Mannoroc, 6 Gangregardes et 6 Infernaux incendiaires, puis retournez voir le Redresseur de torts Vedaar au Chant des forêts à Orneval.‡杀死6个玛诺洛克鞭笞者、6个恶魔守卫和6个灼热的地狱火，然后向灰谷林歌神殿的守备官维达尔复命。‡殺死6個瑪諾洛克鞭笞者，6個惡魔守衛，和6個灼熱的煉獄火，再回到梣谷的林歌神殿找復仇者維達。',
  }
},
[9517] = {
  {
    'A Shameful Waste‡Напрасные усилия‡Eine schändliche Verschwendung‡숲의 파괴‡¡Sería una lástima desperdiciarlo!‡¡Sería una lástima desperdiciarlo!‡Un gaspillage honteux‡可耻的浪费‡可恥的浪費',
    nil,
    'Leve 15 Tábuas dos Brado Guerreiro e 5 Madeiras Vis de Satyrnaar para Nodoso em Cantilenda.‡Доставьте 15 связок древесины Песни Войны и 5 связок оскверненной древесины Сатирнаара Кривокрону в Лесную Песнь.‡Bringt 15 Stück Holz des Kriegshymnenklans und 5 Stück verdorbenes Satyrnaarholz zu Knorre in Waldeslied.‡숲의 노래에 있는 그날에게 전쟁노래부족 목재 15개, 사티르나르의 오염된 목재 5개를 가져가야 합니다.‡Llévale 15 piezas de madera Grito de Guerra y 5 piezas de madera vil de Satyrnaar a Gnarl a la Canción del Bosque.‡Llévale 15 piezas de madera Grito de Guerra y 5 piezas de madera vil de Satyrnaar a Gnarl a la Canción del Bosque.‡Rapportez 15 morceaux de Bois de coupe Chanteguerre et 5 morceaux de Bois gangrené de Satyrnaar à Noueux, au Chant des forêts.‡将15块战歌木材和5块萨提纳尔木材交给林歌神殿的纳亚尔。‡帶15塊戰歌林材和5塊薩提納爾地獄木頭給林歌神殿的格納。',
  }
},
[9518] = {
  {
    'Agents of Destruction‡Пособники разрушения‡Agenten der Zerstörung‡파괴 요원‡Agentes de destrucción‡Agentes de destrucción‡Les agents de la destruction‡毁灭的使者‡毀滅間諜',
    nil,
    'A Sentinela Luciel Sussurrastra, em Cantilenda, quer que você mate o Feitor Gorthak, 2 Retalhadores do Brado Guerreiro, 5 Desflorestadoras da Horda e 10 Batedores da Horda.‡Часовая Люсьель Шепот Звезд из Лесной Песни хочет, чтобы вы убили надзирателя Гортака, 2 пилотов крошшеров клана Песни Войны, 5 ордынских лесозаготовителей и 10 ордынских разведчиков.‡Schildwache Luciel Sternwisper in Waldeslied möchte, dass Ihr Vorarbeiter Gorthak, 2 Schredder des Kriegshymnenklans, 5 Roder der Horde und 10 Späher der Horde tötet.‡숲의 노래에 있는 파수꾼 루시엘 스타위스퍼가 감독관 고르닥, 전쟁노래부족 벌목기 2개, 호드 벌채꾼 5명, 호드 정찰병 10명을 처치해 달라고 부탁했습니다.‡La centinela Luciel Susurrestelar de Canción del Bosque quiere que mates al sobrestante Gorthak, 2 machacadores Grito de Guerra, 5 deforestadores de la Horda y 10 exploradores de la Horda.‡La centinela Luciel Susurrestelar de Canción del Bosque quiere que mates al sobrestante Gorthak, 2 machacadores Grito de Guerra, 5 deforestadores de la Horda y 10 exploradores de la Horda.‡La sentinelle Luciel Murmétoile du Chant des forêts veut que vous tuiez le Surveillant Gorthak, 2 Déchireurs Chanteguerre, 5 Défricheurs de la Horde et 10 Eclaireurs de la Horde.‡林歌神殿的哨兵卢希尔·星语要求你杀死监工古尔萨克、2台战歌伐木机、5名部落伐木工和10名部落斥候。‡林歌神殿的哨兵露西歐·星語要你摧毀監督者高薩克，2個戰歌伐木機，5個部落伐木工，和10個部落斥候。',
  }
},
[9519] = {
  {
    'The Lost Chalice‡Потерянная чаша‡Elunes Kelch‡엘룬의 성배‡El cáliz perdido‡El cáliz perdido‡Le calice perdu‡失落的圣杯‡丟失的酒杯',
    nil,
    'Leve o Cálice de Eluna a Kainet Brisacalma em Cantilenda, que fica no Vale Gris.‡Принесите чашу Элуны Кайнету Штилю в Лесную Песнь.‡Bringt Elunes Kelch zu Kayneth Stillwind in Waldeslied.‡숲의 노래에 있는 케이네스 스틸윈드에게 엘룬의 성배를 가져가야 합니다.‡Llévale el Cáliz de Elune a Kayneth Ventoleve en la Canción del Bosque.‡Llévale el Cáliz de Elune a Kayneth Ventoleve en la Canción del Bosque.‡Apportez le Calice d\'Elune à Kayneth Mortebrise, au Chant des forêts.‡将艾露恩的圣杯交给林歌神殿的凯尼斯·静风。‡把伊露恩酒杯帶給林歌神殿的凱尼斯·靜風。',
  }
},
[9520] = {
  {
    'Diabolical Plans‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Les plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Entregue os Planos Diabólicos ao Vindicante Vedaar em Cantilenda, que fica no Vale Gris.‡Доставьте демонические планы воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Bringt die teuflischen Pläne zu Verteidiger Vedaar in Waldeslied im Eschental.‡잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 악마의 계획서를 가져가야 합니다.‡Entrega los planes diabólicos al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Entrega los planes diabólicos al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Apporter les Plans diaboliques au Redresseur de torts Vedaar au Chant des forêts à Orneval.‡将恶魔的计划交给灰谷林歌神殿的守备官维达尔。‡將殘忍計畫送到梣谷給林歌神殿的復仇者維達。',
  }
},
[9521] = {
  {
    'Report from the Northern Front‡Донесение с северного фронта‡Bericht von der Nordfront‡북쪽 전초기지에서의 보고서‡Informe del frente norte‡Informe del frente norte‡Un rapport du front nord‡北方前线的报告‡北方前線的報告',
    nil,
    'Entregue o relatório da Sentinela Luciel à Sentinela Cantálgures no Bosque Asa de Prata.‡Доставьте донесение часовой Люсьель часовой Дальней Песне в рощу Среброкрылых.‡Bringt Schildwache Luciels Bericht zu Schildwache Weltensang im Hain der Silberschwingen.‡은빛날개 숲에 있는 파수꾼 파송에게 파수꾼 루시엘의 보고서를 전달해야 합니다.‡Entrega el informe de la centinela Luciel a la centinela Cantolejano en el Claro Ala de Plata.‡Entrega el informe de la centinela Luciel a la centinela Cantolongo en el Claro Ala de Plata.‡Apporter le Rapport de la sentinelle Luciel à la sentinelle Chanteloin au Bosquet d\'Aile-argent.‡将哨兵卢希尔的报告送给银翼树林的哨兵艾蒂亚·轻歌。‡將哨兵露西歐·星語的報告送給銀翼樹林的哨兵輕歌。',
  }
},
[9522] = {
  {
    'Never Again!‡Больше никогда!‡Nie wieder!‡두 번 다시 일어나서는 안 될 일!‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡休想！‡永遠沒有下一次!',
    nil,
    'Mate Gorgannon e Diathorus, o Inquisidor, depois fale novamente com o Vindicante Vedaar em Cantilenda, que fica no Vale Gris.‡Убейте Горганнона и Диатора Ищейку и вернитесь к воздаятелю Ведаару в Лесную Песнь в Ясеневом лесу.‡Tötet Gorgannon und Diathorus den Sucher und kehrt danach zu Verteidiger Vedaar in Waldeslied im Eschental zurück.‡고르간논과 수색자 디아토루스를 처치한 다음 잿빛 골짜기의 숲의 노래에 있는 구원자 베다르에게 돌아가야 합니다.‡Mata a Gorgannon y a Diathorus el Buscador, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Mata a Gorgannon y a Diathorus el Buscador, y regresa junto al vindicador Vedaar en Canción del Bosque, en Vallefresno.‡Tuer Gorgannon et Diathorus le Chercheur, puis retourner voir le redresseur de torts Vedaar au Chant des forêts à Orneval..‡杀死戈加农和搜寻者迪亚索鲁斯，然后向灰谷林歌神殿的守备官维达尔复命。‡殺了戈甘諾恩和『追尋者』迪亞索魯斯，再回到梣谷的林歌神殿找復仇者維達。',
  }
},
[9523] = {
  {
    'Relíquia é coisa para se guardar debaixo de sete chaves‡Хрупкие предметы. Не кантовать!‡Marmor, Stein und Eisen bricht, aber uralte Nachtelfenrelikte nicht...‡고대 유물 발굴‡Material frágil y valioso, manipúlese con cuidado‡Material frágil y valioso, manipúlese con cuidado‡Fragile et précieux - à manipuler avec précaution‡贵重物品，小心轻放‡小心輕放',
    nil,
    'O Arqueólogo Adamantino Ferrocordis, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você leve 8 Relíquias Antigas para ele.‡Принесите 8 древних реликвий археологу Адаманту Железному Сердцу в лагерь Одиссия на острове Лазурной Дымки.‡Archäologe Adamant Eisenherz bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr ihm 8 uralte Relikte bringt.‡하늘안개 섬의 오디시우스의 정박지에 있는 고고학자 아다만트 아이언하트가 고대 유물 8개를 가져다 달라고 부탁했습니다.‡El arqueólogo Adamant Coracero en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 8 reliquias antiguas.‡El arqueólogo Adamant Coracero en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 8 reliquias antiguas.‡L\'archéologue Adamant Cœur-de-fer, au point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous lui rameniez 8 Reliques anciennes.‡秘蓝岛奥德修斯营地的考古学家阿达曼特·铁心要求你给他找到8块上古圣物。‡藍謎島，奧迪席斯平臺的考古學家阿達曼·鐵心要你幫他帶來8個古代聖物。',
  }
},
[9524] = {
  {
    'Aprisionado na cidadela‡Узник цитадели‡Gefangene der Zitadelle‡성채에 수감된 자‡Encarcelados en la Ciudadela‡Encarcelados en la Ciudadela‡Prisonnière de la citadelle‡堡垒中的囚徒‡監禁堡壘',
    nil,
    'Resgate a Capitão Alina na Cidadela Fogo do Inferno antes que ela seja executada.|n|nA missão tem que ser concluída no modo Heroico da masmorra.‡Спасите капитана Алину в цитадели Адского Пламени до того, как ее казнят.|n|nЭто задание выполняется только в героическом режиме.‡Rettet Hauptmann Alina aus der Höllenfeuerzitadelle, bevor sie hingerichtet wird.|n|nUm diese Aufgabe zu beenden, müsst Ihr den Dungeon auf dem Schwierigkeitsgrad \'Heroisch\' betreten.‡지옥불 성채 안에 있는 대장 알리나가 처형되기 전에 구출해야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Rescata a la capitana Alina del interior de la Ciudadela del Fuego Infernal antes de que la ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Rescata a la capitana Alina del interior de la Ciudadela del Fuego Infernal antes de que la ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Sauver le capitaine Alina, à l\'intérieur de la citadelle des Flammes infernales, avant son exécution.|n|nCette quête doit être accomplie en mode de difficulté du donjon Héroïque.‡在地狱火堡垒内的奥琳娜上尉被处决前救出她。|n|n该任务必须在英雄等级难度的地下城中完成。‡在地獄火堡壘的隊長阿蓮娜被處決前拯救她。|n|n這個任務只能在英雄難度的地城中完成。',
  }
},
[9525] = {
  {
    'Aprisionado na cidadela‡Узник цитадели‡Gefangene der Zitadelle‡성채에 수감된 자‡Encarcelados en la Ciudadela‡Encarcelados en la Ciudadela‡Prisonnier de la citadelle‡堡垒中的囚徒‡監禁堡壘',
    nil,
    'Resgate o Capitão Estilhossos na Cidadela Fogo do Inferno antes que ele seja executado.|n|nA missão tem que ser concluída no modo heroico da masmorra.‡Спасите капитана Костолома в цитадели Адского Пламени до того, как его казнят.|n|nЭто задание выполняется только в героическом режиме.‡Rettet Hauptmann Knochenbrecher aus der Höllenfeuerzitadelle, bevor er hingerichtet wird.|n|nUm diese Aufgabe zu beenden, müsst Ihr den Dungeon auf dem Schwierigkeitsgrad \'Heroisch\' betreten.‡지옥불 성채에 있는 대장 본쉐터가 처형되기 전에 구출해야 합니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Rescata al capitán Triturahuesos del interior de la Ciudadela del Fuego Infernal antes de que lo ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Rescata al capitán Triturahuesos del interior de la Ciudadela del Fuego Infernal antes de que lo ejecuten.|n|nEsta misión se debe completar en dificultad de mazmorra heroica.‡Sauver le capitaine Fracasse-os, à l\'intérieur de la citadelle des Flammes infernales, avant son exécution.|n|nCette quête doit être accomplie en mode de difficulté du donjon Héroïque.‡在地狱火堡垒内的沙塔·碎骨上尉被处决前救出他。|n|n该任务必须在英雄等级难度的地下城中完成。‡在地獄火堡壘的隊長碎骨被處決前拯救他。|n|n這個任務只能在英雄難度的地城中完成。',
  }
},
[9526] = {
  {
    'Reclaiming Felfire Hill‡Возрождение Холма Демонического Огня‡Die Rückeroberung des Dämonenhügels‡악령불 언덕‡Recuperar el Cerro Lumbrevil‡Recuperar el Cerro Lumbrevil‡Reprendre la colline Gangrefeu‡夺回冥火岭‡奪回冥火嶺',
    nil,
    'Plante 8 Mudas de Árvore em Monturos de Terra Fértil e fale novamente com Nodoso em Cantilenda, no Vale Gris.‡Посадите 8 древесных саженцев в кучи плодородной земли и вернитесь к Кривокрону в Лесную Песнь в Ясеневом лесу.‡Pflanzt 8 Baumsetzlinge in die fruchtbaren Erdhaufen und kehrt dann zu Knorre in Waldeslied im Eschental zurück.‡기름진 흙더미에 나무 씨앗 8개를 심은 후 잿빛 골짜기의 숲의 노래에 있는 그날에게 돌아가야 합니다.‡Planta 8 semillas de árbol en los montículos de tierra fértil y vuelve junto a Gnarl en la Canción del Bosque, en Vallefresno.‡in‡Planter 8 Boutures d\'arbre dans les Monticules de terre fertile, puis retourner voir Noueux au Chant des forêts, en Orneval.‡将8棵小树苗种植在肥沃的土壤中，然后向灰谷林歌神殿的纳亚尔回报。‡將8顆樹苗種在肥沃的土堆裡，再回到梣谷的林歌神殿找格納。',
  }
},
[9527] = {
  {
    'O que restou‡Все, что осталось‡Was noch bleibt‡카우렌의 부탁‡Solo quedan los restos‡Solo quedan los restos‡Tout ce qui reste‡遗体‡剩下的一切',
    nil,
    'Capúleo, na Ilha Névoa Lazúli, quer que você recupere os Restos Mortais da Família de Capúleo.‡Верните Коулену останки его семьи.‡Cowlen auf der Azurmythosinsel möchte, dass Ihr ihm die Überreste von Cowlens Familie bringt.‡하늘안개 섬에 있는 카우렌이 가족의 유해를 되찾아 달라고 부탁했습니다.‡Cowlen, de la Isla Bruma Azur, quiere que recuperes los restos de su familia.‡Cowlen, de la Isla Bruma Azur, quiere que recuperes los restos de su familia.‡Cowlen, de l\'île de Brume-azur, veut que vous retrouviez les Restes de la famille de Cowlen.‡秘蓝岛的库雷要求你回收他的家人的遗体。‡藍謎島的科倫要你找到科倫家族遺骨。',
  }
},
[9528] = {
  {
    'Um grito de socorro‡Крик о помощи‡Ein Hilferuf‡마그윈 호위‡Una llamada de socorro‡Una llamada de socorro‡Un appel à l\'aide‡乞求帮助‡求救',
    nil,
    'Escolte Marian até a casa dela.‡Проводите Магвин через остров до дома.‡Begleitet Magwin über die Insel zu ihrem Zuhause.‡섬을 지나 그녀의 집까지 마그윈을 데려가야 합니다.‡Escolta a Magwin por la isla hasta su casa.‡Escolta a Magwin por la isla hasta su casa.‡Escorter Magwin à travers l\'île, jusqu\'à chez elle.‡护送麦戈薇穿越小岛，回到家中。‡護送麥格文穿過島嶼回到她的家。',
  }
},
[9529] = {
  {
    'A pedra‡Камень‡Der Stein‡공허의 돌‡La piedra‡La piedra‡La Pierre‡虚空石‡虛無石',
    nil,
    'Pegue uma Pedra do Caos na Trilha da Morte.‡Добудьте камень Бездны с Тропы Мертвых.‡Beschafft Euch einen Leerstein von der Todesschneise.‡죽음의 흉터에서 공허의 돌을 찾아야 합니다.‡Consigue una piedra del vacío de La Cicatriz Muerta.‡Consigue una piedra del vacío de La Cicatriz Muerta.‡Trouvez une Pierre de Vide dans la Malebrèche.‡在死亡之痕找到一颗虚空石。‡從死亡之痕取得虛無石。',
  }
},
[9530] = {
  {
    'Planta infalível‡Созревший план‡Einen Plan aus Hecken‡나무와 나뭇잎 수집‡Hay un traidor‡Hay un traidor‡Un plan bourgeonne‡天才的方案！‡我要一棵樹',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você leve uma Árvore Oca e 5 Montes de Folhas para ele.‡Принесите выдолбленный ствол и 5 охапок листьев адмиралу Одиссию в лагерь Одиссия на острове Лазурной Дымки.‡Admiral Odesyus bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr ihm einen ausgehöhlten Stamm und 5 Laubhaufen bringt.‡하늘안개 섬의 오디시우스의 정박지에 있는 제독 오디시우스가 통나무 밑동 1개와 나뭇잎 더미 5개를 가져다 달라고 부탁했습니다.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 1 árbol hueco y 5 pilas de hojas.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que le lleves 1 árbol hueco y 5 pilas de hojas.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus sur l\'île de Brume-azur, veut que vous lui rameniez un Arbre creux et 5 Piles de feuilles.‡秘蓝岛奥德修斯营地的海军上将奥德修斯要求你收集一株中空的树干和5堆树叶。‡藍謎島，奧迪席斯平臺的艦隊司令·奧迪席斯要你幫他帶回中空樹和5堆樹葉。',
  }
},
[9531] = {
  {
    'Debaixo do pé de árvore‡У деревьев есть уши‡Laubangriff‡배신자의 정체‡En compañía de árboles‡En compañía de árboles‡L\'art du camouflage ne se perd pas‡间谍之树‡樹的偽裝',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, que fica na Ilha Névoa Lazúli, quer que você espione o encontro que se realizará entre Zé Ruela e o traidor.|n|nFale com ele novamente quando souber a identidade do velhaco.‡Проследите за встречей Гизла с предателем.|n|nРасскажите обо всем увиденном адмиралу Одиссию.‡Admiral Odesyus bei Odesyus\' Ankerplatz auf der Azurmythosinsel möchte, dass Ihr das Treffen beobachtet, das Geezle und der Verräter gemeinsam ausgemacht haben.|n|nKehrt zu ihm zurück, wenn Ihr ihm die Identität des Verräters mitteilen könnt.‡하늘안개 섬의 오디시우스의 정박지에 있는 제독 오디시우스가 기즐과 배신자가 만나는 장면을 염탐해 달라고 부탁했습니다.|n|n배신자의 정체를 확인한 후 제독 오디시우스에게 돌아가야 합니다.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que vigiles la reunión que tendrá lugar entre Geezle y el traidor.|n|nRegresa junto a él cuando sepas la identidad del traidor.‡El almirante Odesyus en el Desembarco de Odesyus, en la Isla Bruma Azur, quiere que vigiles la reunión que tendrá lugar entre Geezle y el traidor.|n|nRegresa junto a él cuando sepas la identidad del traidor.‡L\'amiral Odesyus, au Point d\'accostage d\'Odesyus de l\'île de Brume-azur, veut que vous observiez la rencontre entre Geezle et le traître.|n|nRetournez le voir lorsque vous connaîtrez l\'identité du traître.‡秘蓝岛奥德修斯营地的海军上将奥德修斯要求你监视吉兹尔与叛徒的会面与谈话。|n|n确认叛徒的身份之后回去向他复命。‡藍謎島，奧迪席斯平臺的艦隊司令·奧迪席斯要你去觀察吉索和背叛者的會議。|n|n等你知道了背叛者的身份就回去找他。',
  }
},
[9532] = {
  {
    'Encontre Keltus Umbrafronde‡Найти Келтуса Темного Листа‡Findet Keltus Dunkellaub‡켈투스 다크리프 찾기‡Encuentra a Keltus Hojaoscura‡Encuentra a Keltus Hojaoscura‡Trouver Keltus Sombrefeuille‡找到克尔图斯·暗叶‡找到卡特斯·暗葉',
    nil,
    'Localize Keltus Umbrafronde.‡Найдите Келтуса Темного Листа.‡Macht Keltus Dunkellaub ausfindig.‡켈투스 다크리프를 찾아야 합니다.‡Encuentra a Keltus Hojaoscura.‡Encuentra a Keltus Hojaoscura.‡Trouver Keltus Sombrefeuille.‡找到克尔图斯·暗叶。‡找到卡特斯·暗葉。',
  }
},
[9533] = {
  {
    'A Helping Hand‡Рука помощи‡Eine helfende Hand‡도움의 손길‡Una mano amiga‡Una mano amiga‡La main tendue‡援助之手‡伸出援手',
    nil,
    'Vá até Cantilenda e fale com o Arquiteto Nemos.‡Отправляйтесь в Лесную Песнь и поговорите с архитектором Немосом.‡Geht nach Waldeslied und sprecht mit Architekt Nemos.‡숲의 노래로 가서 건축가 네모스와 대화해야 합니다.‡Dirígete a Canción del Bosque y habla con el arquitecto Nemos.‡Dirígete a Canción del Bosque y habla con el arquitecto Nemos.‡Rendez-vous au Chant des forêts, et parlez à l\'architecte Nemos.‡到达林歌神殿，与建筑师尼莫斯谈一谈。‡前往林歌神殿和建築師尼莫斯談談。',
  }
},
[9534] = {
  {
    'Destroy the Legion‡Уничтожить Легион!‡Zerstört die Legion‡불타는 군단 섬멸‡Destruye a la Legión‡Destruye a la Legión‡Détruire la Légion‡毁灭燃烧军团‡摧毀軍團',
    nil,
    'Mate 6 Açoitadeiras Mannoroth, 6 Guardas Vis e 6 Infernais Abrasadores, depois fale novamente com Valusha no Posto Machadada, que fica no Vale Gris.‡Уничтожьте 6 бичевательниц Маннорока, 6 стражей Скверны и 6 опаляющих инферналов, а затем вернитесь к Валуше на заставу Расщепленного Дерева в Ясеневом лесу.‡Tötet 6 Mannorocpeitscher, 6 Teufelswachen und 6 sengende Höllenbestien und kehrt dann zu Valusha im Splitterholzposten in Eschental zurück.‡만노로크 채찍마녀, 떠도는 지옥군단병, 불타는 지옥불정령을 6마리씩 해치운 후 잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 돌아가야 합니다.‡Mata a 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores y ve a ver a Valusha al Puesto del Hachazo en Vallefresno.‡Mata a 6 azotadoras Mannoroc, 6 guardias viles y 6 infernales abrasadores y ve a ver a Valusha al Puesto del Hachazo en Vallefresno.‡Tuez 6 Flagellantes de Mannoroc, 6 Gangregardes et 6 Infernaux incendiaires, puis retournez voir Valusha au poste de Bois-brisé en Orneval.‡杀死6个玛诺洛克鞭笞者、6个恶魔守卫和6个灼热的地狱火，然后向灰谷碎木岗哨的瓦鲁莎复命。‡殺死6個瑪諾洛克鞭笞者，6個惡魔守衛和6個灼熱的煉獄火，再回到梣谷的碎木崗哨找瓦露薩。',
  }
},
[9535] = {
  {
    'Diabolical Plans‡Демонические планы‡Teuflische Pläne‡악마의 계획서‡Planes diabólicos‡Planes diabólicos‡Les plans diaboliques‡恶魔的计划‡殘忍計畫',
    nil,
    'Deliver the Diabolical Plans to Valusha at Splintertree Post in Ashenvale.‡Доставьте демонические планы Валуше на заставу Расщепленного Дерева, что в Ясеневом лесу.‡Bringt die teuflischen Pläne zu Valusha im Splitterholzposten im Eschental.‡잿빛 골짜기의 토막나무 주둔지에 있는 발루샤에게 악마의 계획서를 전달해야 합니다.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Entrega los planes diabólicos a Valusha en el Puesto del Hachazo en Vallefresno.‡Apporter les Plans diaboliques à Valusha au poste de Bois-brisé en Orneval.‡将恶魔的计划交给灰谷碎木岗哨的瓦鲁莎。‡將殘忍計畫送到梣谷給碎木崗哨的瓦露薩。',
  }
},
[9536] = {
  {
    'Never Again!‡Больше никогда!‡Nie wieder!‡두 번 다시 일어나서는 안 될 일!‡¡Nunca más!‡¡Nunca más!‡Plus jamais !‡休想！‡永遠沒有下一次!',
    nil,
    'Mate Gorgannon e Diathorus, o Inquisidor.‡Убейте Гроганнона и Диатора Ищейку.‡Tötet Gorgannon und Diathorus den Sucher.‡고르간논과 수색자 디아토루스를 처치해야 합니다.‡Mata a Gorgannon y a Diathorus el Buscador.‡Mata a Gorgannon y a Diathorus el Buscador.‡Tuer Gorgannon et Diathorus le Chercheur.‡杀死戈加农和搜寻者迪亚索鲁斯。‡殺了戈甘諾恩和『追尋者』迪亞索魯斯。',
  }
},
[9537] = {
  {
    'Gnomicídio‡Не ведая пощады‡Keine Gnade mit dem Gnom‡반역자의 교신 내용‡Justicia para el gnomo‡Justicia para el gnomo‡Le gnominé est...‡绳侏儒以法‡別對地精仁慈',
    nil,
    'O Almirante Odisseu, no Assentamento de Odisseu, quer que você consiga o Comunicado do Traidor com o Engenheiro "Chispa" Trincabrás.‡Добудьте для адмирала Одиссия переписку предателя у инженера "Искра" Перемолоттера‡Admiral Odesyus bei Odesyus\' Ankerplatz möchte, dass Ihr die Mitteilung des Verräters von Ingenieur "Funks" Oberschleif an Euch bringt.‡오디시우스의 정박지에 있는 제독 오디시우스가 기술자 "불똥" 오버그라인드에게서 반역자의 교신 내용을 되찾아 달라고 부탁했습니다.‡El almirante Odesyus de El Desembarco de Odesyus quiere que le saques información al traidor ingeniero "Chispik" Pasarrosca.‡El almirante Odesyus de El Desembarco de Odesyus quiere que le saques información al traidor ingeniero "Chispik" Pasarrosca.‡L\'amiral Odesyus, du point d\'accostage d\'Odesyus, veut que vous récupériez la Communication du traître sur l\'ingénieur Finemouture, dit « l\'Étincelle ».‡奥德修斯营地的海军上将奥德修斯要求你从工程师欧格林德那里取得叛徒的证据。‡奧迪席斯平臺的艦隊司令·奧迪席斯要你從工程師火花·歐爾滾那裡取回叛徒的信件。',
  }
},
[9538] = {
  {
    'O aprendizado de uma língua‡Изучение языка‡Erlernen der Sprache‡미지의 언어 습득‡Aprendizaje de idiomas‡Aprendizaje de idiomas‡Apprendre la langue‡学外语......‡學習語言',
    nil,
    'Leia a Cartilha da Língua dos Pelursos Pinhoquieto que Aurren lhe deu e interaja com o Totem de Akira no Entreposto Lazúli.‡Изучите пергамент "Язык фурболгов из племени Тихвой для начинающих", полученный от Ауррена, а затем изучите тотемом Акиды на Лазурной заставе.‡Lest die Übersetzungsfibel der Tannenruhfeste, die Aurren Euch gegeben hat. Kommuniziert anschließend mit dem Totem von Akida bei der Azurwacht.‡아울렌이 준 너울소나무 펄볼그 언어 입문서를 읽은 후, 하늘 감시초소에 있는 아키다의 토템과 교감해야 합니다.‡Lee el manual de idioma fúrbolg de Semprepino que Aurren te dio e interactúa con el Tótem de Akida en la Avanzada Azur.‡Lee el manual de idioma fúrbolg de Semprepino que Aurren te dio e interactúa con el Tótem de Akida en la Avanzada Azur.‡Lisez le Manuel de langue furbolg calmepin qui vous a été remis par Aurren, puis examinez le Totem d\'Akida au Guet d\'azur.‡阅读奥鲁恩给你的止松熊怪语言入门，以便和碧蓝岗哨的阿基达图腾交流。‡閱讀奧蘭給你的靜松熊怪語言入門書並和藍色守望的阿契達的圖騰互動。',
  }
},
[9539] = {
  {
    'O totem de Coor‡Тотем Ку‡Totem von Coo‡쿠우의 토템‡El Tótem de Coo‡El Tótem de Coo‡Le totem de Coo‡库欧图腾‡庫的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Coor.‡Найдите тотем Ку с помощью проводника.‡Findet das Totem von Coo, indem Ihr den Hinweisen folgt.‡주어진 단서로 쿠우의 토템을 찾아야 합니다.‡Encuentra el Tótem de Coo con las pistas que tienes.‡Encuentra el Tótem de Coo con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Coo.‡根据线索找到库欧图腾。‡使用提供給你的線索找到庫的圖騰。',
  }
},
[9540] = {
  {
    'O totem de Tikti‡Тотем Тикти‡Totem von Tikti‡티크티의 토템‡El Tótem de Tikti‡El Tótem de Tikti‡Le totem de Tikti‡提克提图腾‡堤克悌的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Tikti.‡Найдите тотем Тикти с помощью проводника.‡Findet das Totem von Tikti, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 티크티의 토템을 찾아야 합니다.‡Encuentra el Tótem de Tikti con las pistas que tienes.‡Encuentra el Tótem de Tikti con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Tikti.‡根据线索找到提克提图腾。‡使用提供給你的線索找到堤克悌的圖騰。',
  }
},
[9541] = {
  {
    'O totem de Yor‡Тотем Йора‡Totem von Yor‡요르의 토템‡El Tótem de Yor‡El Tótem de Yor‡Le totem de Yor‡尤尔图腾‡優兒的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Yor.‡Найдите тотем Йора с помощью проводника.‡Findet das Totem von Yor, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 요르의 토템을 찾아야 합니다.‡Encuentra el Tótem de Yor con las pistas que tienes.‡Encuentra el Tótem de Yor con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Yor.‡根据线索找到尤尔图腾。‡使用提供給你的線索找到優兒的圖騰。',
  }
},
[9542] = {
  {
    'O totem de Vark‡Тотем Варк‡Totem von Vark‡바르크의 토템‡El Tótem de Vark‡El Tótem de Vark‡Le totem de Vark‡瓦克图腾‡瓦克的圖騰',
    nil,
    'Siga as pistas para encontrar o Totem de Vark.‡Найдите тотем Варк с помощью проводника.‡Findet das Totem von Vark, indem Ihr den Hinweisen folgt.‡주어진 단서를 통해 바르크의 토템을 찾아야 합니다.‡Encuentra el Tótem de Vark con las pistas que tienes.‡Encuentra el Tótem de Vark con las pistas que tienes.‡Grâce aux indices qui vous ont été fournis, trouvez le totem de Vark.‡根据线索找到瓦克图腾。‡使用提供給你的線索找到瓦克的圖騰。',
  }
},
[9543] = {
  {
    'Expiação‡Искупление‡Sühne‡속죄‡Expiación‡Expiación‡Expiation‡救赎‡贖罪',
    nil,
    'Fale com Amaan, o Sábio, no Templo de Telhamat, que fica na Península Fogo do Inferno.‡Поговорите с Амааном Мудрым в храме Телхамат на полуострове Адского Пламени.‡Sprecht mit Amaan dem Weisen beim Tempel von Telhamat auf der Höllenfeuerhalbinsel.‡지옥불 반도의 텔하마트 사원에 있는 현자 아만과 대화해야 합니다.‡Habla con Amaan el Sabio en el Templo de Telhamat en la Península del Fuego Infernal.‡Habla con Amaan el Sabio en el Templo de Telhamat en la Península del Fuego Infernal.‡Parler à Amaan le Sage, au temple de Telhamat dans la péninsule des Flammes infernales.‡与地狱火半岛塔哈玛特神殿的智者阿曼恩谈一谈。‡到地獄火半島和特爾哈曼神廟的『智者』阿曼談談。',
  }
},
[9544] = {
  {
    'A profecia de Akira‡Пророчество Акиды‡Die Prophezeiung von Akida‡아키다의 예언‡La profecía de Akida‡La profecía de Akida‡La prophétie d\'Akida‡阿基达的预言‡阿契達的預言',
    nil,
    'Liberte 8 Pinhoquieto Cativos das jaulas que se encontram na Aldeia dos Ericerdos. Fale com Aruguu dos Pinhoquieto no Entreposto Lazúli quando houver cumprido a tarefa.‡Освободите 8 пленников из племени Тихвой из клеток в деревне Косолапов. Вернитесь к Аругу из племени Тихвой на Лазурную заставу.‡Befreit 8 gefangene Furbolgs der Tannenruhfeste aus den Käfigen im Dorf der Sichelklauen. Kehrt anschließend zu Arugoo der Tannenruhfeste bei der Azurwacht zurück.‡뾰족가지 마을에 있는 우리에서 너울소나무일족 포로 8명을 구출한 후, 하늘 감시초소에 있는 너울소나무일족 아루구에게 돌아가야 합니다.‡Libera a 8 cautivos Semprepino de las jaulas que se encuentran en la Aldea Brazolanudo. Vuelve junto a Arugoo de los Semprepino, en la Avanzada Azur, cuando completes esta tarea.‡Libera a 8 cautivos Semprepino de las jaulas que se encuentran en la Aldea Brazolanudo. Vuelve junto a Arugoo de los Semprepino, en la Avanzada Azur, cuando completes esta tarea.‡Libérez 8 Captifs Calmepins des cages du village des Bras-hirsutes. Retournez voir Arugoo des Calmepins au Guet d\'azur quand vous aurez accompli cette tâche.‡在刺臂村中释放8名止松俘虏。完成任务之后回到碧蓝岗哨，找止松部族的阿鲁古复命。‡釋放8個在鬚肢村裡發現的靜松俘虜。完成後回到藍色守望找靜松要塞的阿魯古。',
  }
},
[9545] = {
  {
    'A relíquia do vidente‡Реликвия ясновидца‡Das Relikt des Sehers‡현자의 유물‡La reliquia del vidente‡La reliquia del vidente‡La relique du prophète‡先知的圣物‡先知的聖物',
    nil,
    'Amaan, o Sábio, no Templo de Telhamat, na Península Fogo do Inferno, quer que você volte para o local do Cadáver de Sedai, a nordeste do Templo de Telhamat, e use a Relíquia do Vidente lá. Fale novamente com ele ao concluir a tarefa.‡Вернитесь к телу Седаи, которое находится к северо-востоку от храма Телхамат, и используйте там реликвию ясновидца по просьбе Амаана Мудрого из храма Телхамат на полуострове Адского Пламени. После выполнения задания возвращайтесь к Амаану.‡Amaan der Weise beim Tempel von Telhamat auf der Höllenfeuerhalbinsel möchte, dass Ihr Sedais Leichnam erneut aufsucht, um dort das Relikt des Sehers zu benutzen. Kehrt nach Abschluss der Aufgabe zu ihm zurück.‡지옥불 반도의 텔하마트 사원에 있는 현자 아만이 텔하마트 사원의 북동쪽에 있는 세다이의 시체로 돌아간 후, 그곳에서 현자의 유물을 사용하라고 부탁했습니다. 일을 마친 후 현자 아만에게 돌아가야 합니다.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas al cadáver de Sedai al noreste del Templo y uses la reliquia del vidente allí. Después vuelve a ver a Amaan.‡Amaan el Sabio del Templo de Telhamat en la Península del Fuego Infernal quiere que vayas al cadáver de Sedai al noreste del Templo y uses la reliquia del vidente allí. Después vuelve a ver a Amaan.‡Amaan le Sage, du temple de Telhamat dans la péninsule des Flammes infernales, veut que vous retourniez auprès du Cadavre de Sedaï, au nord-est du temple de Telhamat, et que vous utilisiez la Relique du prophète à cet endroit. Revenez le voir quand ce sera fait.‡地狱火半岛塔哈玛特神殿的智者阿曼恩要你回到瑟丹的尸体旁，使用先知的圣物。任务完成之后回去向他复命。‡地獄火半島的特爾哈曼神廟的『智者』阿曼要你回到特爾哈曼神廟東北方希戴的屍體那邊使用先知的聖物。任務完成後回去找他。',
  }
},
[9547] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара на острове Лазурной Дымки.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l\'intérieur de l\'Exodar sur l\'île de Brume-azur.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9548] = {
  {
    'O furto dos equipamentos‡Украденное снаряжение‡Gestohlene Ausrüstung‡도둑맞은 장비‡Equipamiento robado‡Equipamiento robado‡L\'équipement chapardé‡被偷走的设备‡被偷走的裝備',
    nil,
    'Devolva o Equipamento do Xote para Xote Cabeçote, que está escondido num casco de tartaruga na praia.‡Верните Клопперу Бацбаху его оборудование. Клоппера можно найти в старом черепашьем панцире на берегу.‡Bringt Kloppers Ausrüstung zurück zu Klopper Knacksklug, der sich in einem angespülten Schildkrötenpanzer versteckt hält.‡해변으로 밀려 올라온 거북이 껍질 속에 숨어 있는 클로퍼 위즈뱅에게 클로퍼의 장비를 가져가야 합니다.‡Lleva el equipamiento de Clopper a Clopper Zumbibang, que se oculta en un caparazón de tortuga en la playa.‡Lleva el equipamiento de Clopper a Clopper Zumbibang, que se oculta en un caparazón de tortuga en la playa.‡Rapportez l\'Equipement de Clopper à Clopper Crackboum, qui se cache dans une carapace de tortue échouée.‡找回克劳伯的设备，把它交给躲在海滩龟壳中的克劳伯·维兹班。‡把克羅波的裝備帶回來給克羅波·維茲班，他藏在海邊的一個龜殼裡面。',
  }
},
[9549] = {
  {
    'Os artefatos dos Trevareia‡Артефакты племени Черного Ила‡Schwarzschlammartefakte‡검은진흙멀록의 물건 수집‡Los artefactos de los Cienonegro‡Los artefactos de los Cienonegro‡Les artéfacts des Vase noire‡黑沙神器‡黑沙的手工藝品',
    nil,
    'Entregue 3 Ídolos Murloc Rudimentares e 6 Facas Murloc Rudimentares para Xote Cabeçote, que está escondido num casco de tartaruga na praia.‡Принесите 3 варварских идола и 6 варварских ножа мурлоков Клопперу Бацбаху, который прячется в старом черепашьем панцире на берегу.‡Bringt 3 kunstlose Murlocgötzen und 6 kunstlose Murlocmesser zu Klopper Knacksklug, der sich in einem angespülten Schildkrötenpanzer versteckt hält.‡해변으로 밀려 올라온 거북이 껍질 속에 숨어 있는 클로퍼 위즈뱅에게 조잡한 멀록 우상 3개, 조잡한 멀록 손칼 6개를 가져가야 합니다.‡Lleva tres ídolos múrlocs rudimentarios y seis cuchillos múrlocs rudimentarios a Clopper Zumbibang, que se esconde en el caparazón de una tortuga de la playa.‡Lleva tres ídolos múrlocs rudimentarios y seis cuchillos múrlocs rudimentarios a Clopper Zumbibang, que se esconde en el caparazón de una tortuga de la playa.‡Apportez 3 Idoles murlocs grossières et 6 Couteaux murlocs grossiers à Clopper Crackboum, qui se cache dans une carapace de tortue échouée.‡收集3个粗糙的鱼人神像和6把粗糙的鱼人小刀，把它们交给躲藏在海滩龟壳里的克劳伯·维兹班。‡帶3個粗糙的魚人塑像和6把粗糙的魚人小刀給克羅波·維茲班，他藏在海邊的一個龜殼裡面。',
  }
},
[9550] = {
  {
    'Um mapa de onde?‡Загадочная карта‡Wohin führt die Karte?‡지도 조사‡Un mapa con destino desconocido‡Un mapa con destino desconocido‡Une carte pour où ?‡一张地图？‡模糊的地圖?',
    nil,
    'Encontre o pavilhão descrito no mapa e procure o que o autor do documento quis registrar.‡Найдите павильон, изображенный на карте, и выясните, что в нем необычного.‡Macht den auf der Karte beschriebenen Pavillon ausfindig und sucht, auf was der Verfasser der Karte hinweisen wollte.‡지도에 그려진 누각을 찾아서 지도를 그린 이가 뭘 기록하려 했는지 조사해야 합니다.‡Encuentra el pabellón descrito en el mapa y busca lo que el cartógrafo intentaba registrar.‡Encuentra el pabellón descrito en el mapa y busca lo que el cartógrafo intentaba registrar.‡Trouvez le pavillon décrit par la carte, et découvrez ce que celui qui l\'a dessinée essayait de représenter.‡找出图中描述的亭子，寻找画图人所记录的信息。‡找到地圖中描繪的亭子並尋找製圖者想記錄下來的東西。',
  }
},
[9551] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar, que fica na Ilha Névoa Lazúli.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара на острове Лазурной Дымки.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar auf der Azurmythosinsel.‡하늘안개 섬의 엑소다르 내에 수정의 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en La Sala de Cristal dentro de El Exodar, en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo, dans le Hall de Cristal, à l\'intérieur de l\'Exodar sur l\'île de Brume-azur.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡與藍謎島中艾克索達裡水晶大廳的先知諾柏多談談。',
  }
},
[9552] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Fale com Velaada no Morro Vento Selvagem, que fica na Ilha Névoa Lazúli.‡Поговорите с Велаадой на Штормовом Пике острова Лазурной Дымки.‡Sprecht mit Velaada beim Wildwindgipfel auf der Azurmythosinsel.‡하늘안개 섬의 갈기바람 봉우리에 있는 벨라아다와 대화해야 합니다.‡Habla con Velaada en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Habla con Velaada en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Parlez à Velaada au pic Vent-sauvage, sur l\'île de Brume-azur.‡与秘蓝岛狂风山的维兰达谈一谈。‡到藍謎島的狂風山尖和維拉達談談。',
  }
},
[9553] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Fale com Susurrus no Morro Vento Selvagem, que fica na Ilha Névoa Lazúli.‡Поговорите с Шептателем на Штормовом Пике острова Лазурной Дымки.‡Sprecht mit Susurrus beim Wildwindgipfel auf der Azurmythosinsel.‡하늘안개 섬의 갈기바람 봉우리에 있는 수술루스와 대화해야 합니다.‡Habla con Susurrus en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Habla con Susurrus en la Cima Ventosalvaje, en la Isla Bruma Azur.‡Parlez à Susurrus au pic Vent-sauvage, sur l\'île de Brume-azur.‡与秘蓝岛狂风山的苏苏鲁斯谈一谈。‡到藍謎島的狂風山尖和蘇瑟拉斯談談。',
  }
},
[9554] = {
  {
    'Call of Air‡Зов воздуха‡Ruf der Luft‡바람의 부름‡La llamada del aire‡La llamada del aire‡L\'appel de l\'air‡空气的召唤‡風之召喚',
    nil,
    'Fale novamente com o Clarividente Nobambo na Exodar, que fica na Ilha Névoa Lazúli, levando o Redemoinho de Ar.‡Отдайте Завихрение воздуха предсказателю Нобундо в Экзодаре.‡Kehrt mit dem Luftwirbel zu Weissager Nobundo bei der Exodar auf der Azurmythosinsel zurück.‡바람의 소용돌이를 가지고 하늘안개 섬의 엑소다르에 있는 선견자 노분도에게 돌아가야 합니다.‡Vuelve junto al clarividente Nobundo en El Exodar, en la Isla Bruma Azur, con la espiral de aire‡Vuelve junto al clarividente Nobundo en El Exodar, en la Isla Bruma Azur, con la espiral de aire.‡Retournez voir le long-voyant Nobundo, à l\'Exodar, sur l\'île de Brume-azur, avec la Volute d\'air.‡将空气之漩交给埃索达的预言者努波顿。‡帶著空氣漩渦回到藍謎島找艾克索達的先知諾柏多。',
  }
},
[9555] = {
  {
    'Call of Fire‡Зов огня‡Ruf des Feuers‡불의 부름‡La llamada del fuego‡La llamada del fuego‡L\'appel du feu‡火焰的召唤‡火之召喚',
    nil,
    'Fale com o Clarividente Nobambo no Salão de Cristal da Exodar.‡Поговорите с предсказателем Нобундо в Кристальном зале Экзодара.‡Sprecht mit Weissager Nobundo in der Kristallhalle der Exodar.‡엑소다르의 수정 전당에 있는 선견자 노분도와 대화해야 합니다.‡Habla con el clarividente Nobundo en El Exodar en la Isla Bruma Azur.‡Habla con el clarividente Nobundo en El Exodar en la Isla Bruma Azur.‡Parlez au long-voyant Nobundo dans le Hall de Cristal, à bord de l\'Exodar.‡与埃索达水晶大厅中的预言者努波顿谈一谈。‡到艾克索達和水晶大廳的先知諾柏多談談。',
  }
},
[9556] = {
  {
    'Ao vencedor...‡Вода для мага‡Dem Sieger...‡승리의 길로...‡Al victori...‡Para el vencedor...‡Au vainqueur...‡胜者为王‡給勝利者……',
    nil,
    'Colete uma garrafa de Água Benta de Stratholme dentro da cidade de Stratholme e leve-a para o Mago de Lordaeron no Distrito dos Magos de Ventobravo ou da Cidade Baixa quando seu lado for vitorioso nas Terras Pestilentas Orientais.‡Найдите бутылку святой воды Стратхольма на улицах Стратхольма и доставьте ее Лордеронскому магу в квартал магов в Штормграде или Подгороде, если вашей стороне удалось одержать верх в Восточных Чумных землях.‡Sucht nach einer Phiole mit heiligem Wasser in Stratholme und bringt sie zu dem Magier von Lordaeron im Magierviertel von Sturmwind oder in Unterstadt, falls Eure Seite in den östlichen Pestländern erfolgreich war.‡자신의 진영이 동부 역병지대에서 승리하면 스톰윈드나 언더시티 마법사 지구 내에 있는 로데론 마법사에게 스트라솔름 성수를 가져가야 합니다.‡Hazte con una botella de agua Sagrada de Stratholme en la ciudad con el mismo nombre y entrégala al mago de Lordaeron en el Barrio de los Magos de Ventormenta o Entrañas una vez consigas la victoria para tu bando en las Tierras de la Peste.‡Hazte con una botella de agua Sagrada de Stratholme en la ciudad de Stratholme y entrégasela al mago de Lordaeron, en el Barrio de los Magos de Ventormenta o Entrañas, una vez consigas la victoria para tu bando en las Tierras de la Peste del Este.‡Récupérez une bouteille d\'Eau sacrée de Stratholme à l\'intérieur de Stratholme, et remettez-la au Mage de Lordaeron, au quartier des mages de Hurlevent ou de Fossoyeuse, lorsque votre camp aura vaincu.‡从斯坦索姆城内收集到一瓶斯坦索姆圣水，在你的阵营获得东瘟疫之地的胜利之后，将圣水交给暴风城或幽暗城内法师区的洛丹伦法师。‡從斯坦索姆城裡取得一瓶斯坦索姆聖水，當你的陣營在東瘟疫之地獲得勝利，就把它交給暴風城或幽暗城法師區裡的羅德隆法師。',
  }
},
[9557] = {
  {
    'Decifrar o livro‡Расшифровка книги‡Entziffern des Buchs‡고대 일지 해독‡Descifrar el libro‡Descifrar el libro‡Déchiffrer le livre‡破译书籍‡解讀這本書',
    nil,
    'Entregue o Diário Antigo para o Anacoreta Paetheus no Entreposto Rubro.‡Отнесите древние записи на Кровавую заставу и покажите анахорету Пайтеусу.‡Bringt das alte Tagebuch zu Anachoret Paetheus bei der Blutwacht.‡핏빛 감시초소에 있는 수도사 패테우스에게 고대 일지를 가져가야 합니다.‡Llévale el diario antiguo al Anacoreta Paetheus en la Avanzada de Sangre.‡Llévale el diario antiguo al Anacoreta Paetheus en la Avanzada de Sangre.‡Apportez l\'Ancien journal de bord à l\'Anachorète Paetheus au Guet du sang.‡把这本日记交给秘血岗哨的学者菲索斯。‡把古老的日記帶給血色守望的隱士裴薩斯。',
  }
},
[9558] = {
  {
    'Os Barbalonga‡Длиннобородые‡Die Langbarts‡그렘니 롱비어드 찾기‡Los Barbalarga‡Los Barbalarga‡Les Barbe-longue‡长须兄弟‡長鬚兄弟',
    nil,
    'Encontre Gremni Barbalonga a noroeste do Antro de Haal\'esh, a oeste da Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Найдите Гремни Длинноборода на северо-западе от логова Хаал\'эш на полуострове Адского Пламени.‡Sucht nach Gremni Langbart nordwestlich des Haal\'eshbaus, weit im Westen der Ehrenfeste auf der Höllenfeuerhalbinsel.‡지옥불 반도의 명예의 요새 서쪽으로 하알에쉬 소굴의 북서쪽에서 그렘니 롱비어드를 찾아야 합니다.‡Busca a Gremni Barbalarga al noroeste de El Cubil de Haal\'esh, hacia el oeste del Bastión del Honor en la Península del Fuego Infernal.‡Busca a Gremni Barbalarga al noroeste de El Cubil de Haal\'esh, hacia el oeste del Bastión del Honor en la Península del Fuego Infernal.‡Cherchez Gremni Barbe-longue au nord-ouest de la tanière des Haal\'esh, loin à l\'ouest du bastion de l\'Honneur de la péninsule des Flammes infernales.‡前往地狱火半岛荣耀堡以西的哈尔什巢穴，在巢穴西北方寻找格雷尼·长须的下落。‡前往海艾斯洞穴的西北邊找葛明尼·長鬚，在地獄火半島的榮譽堡西邊。',
  }
},
[9559] = {
  {
    'A aldeia de Pinhoquieto‡Логово племени Тихвой‡Tannenruhfeste‡너울소나무 요새‡El Bastión Semprepino‡El Bastión Semprepino‡Le repaire des Calmepins‡止松要塞‡靜松要塞',
    nil,
    'Fale com o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto.‡Поговорите с верховным вождем в логове племени Тихвой.‡Sprecht mit dem Oberhäuptling bei der Tannenruhfeste.‡너울소나무 요새에 있는 대족장 너울소나무와 대화해야 합니다.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Parlez au Grand chef Calmepin au repaire des Calmepins.‡与止松要塞的止松老酋长谈一谈。‡和靜松要塞的大酋長靜松談談。',
  }
},
[9560] = {
  {
    'As bestas do Apocalipse!‡Звери Судного дня!‡Biester aus der Apokalypse!‡계시의 생물들!‡¡Las bestias del apocalipsis!‡¡Las bestias del apocalipsis!‡Les bêtes de l\'Apocalypse !‡末日的野兽！‡天啟的野獸!',
    nil,
    'Moordo, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você leve 8 Pelegos de Assolador para ele.‡Принесите 8 шкур опустошителей Мурдо в логово племени Тихвой.‡Moordo bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr ihm 8 Felshetzerbälge bringt.‡하늘안개 섬의 너울소나무 요새에 있는 무르도가 칼날발톱 가죽 8개를 가져다 달라고 부탁했습니다.‡Moordo del Bastión Semprepino, en la Isla Bruma Azur, quiere que le lleves 8 pellejos de devastador.‡Moordo del Bastión Semprepino, en la Isla Bruma Azur, quiere que le lleves 8 pellejos de devastador.‡Moordo, du repaire des Calmepins de l\'île de Brume-azur, veut que vous lui rapportiez 8 Peaux de ravageurs.‡秘蓝岛止松要塞的莫多要求你给他带回8张掠食者的皮。‡藍謎島，靜松要塞的墨爾多要你幫他帶來8塊劫毀者皮。',
  }
},
[9561] = {
  {
    'As palavras de Nolkai‡Записи Нолкаи‡Nolkais Worte‡놀카이의 마지막 말‡Las palabras de Nolkai‡Las palabras de Nolkai‡Les mots de Nolkai‡诺尔凯的日记‡諾凱的話',
    nil,
    'Encontre o lugar descrito no diário e recupere os bens de Nolkai há muito enterrados.‡Найдите место, описанное в дневнике Нолкаи, и отыщите его тайник.‡Findet den in Nolkais Tagebuch beschriebenen Ort und sucht nach seinen seit langem vergrabenen Besitztümern.‡놀카이의 일지에 기록된 위치를 찾아 오래전에 묻힌 그의 소지품을 되찾아야 합니다.‡Encuentra la ubicación descrita en el diario de Nolkai y descubre sus pertenencias enterradas desde hace tiempo.‡Encuentra la ubicación descrita en el diario de Nolkai y descubre sus pertenencias enterradas desde hace tiempo.‡Trouvez l\'endroit décrit dans le journal de Nolkai et découvrez les biens qu\'il a enterrés il y a longtemps.‡找到诺尔凯的日记中提到的地方和他埋藏多年的财物。‡找到諾凱的日記中描述的地點及那裡埋藏已久的財產。',
  }
},
[9562] = {
  {
    'Murlocs... Por que aqui? E por que agora?‡Мурлоки... За что нам эта напасть?‡Murlocs... Warum hier? Warum jetzt?‡예상치 못한 멀록의 등장‡Múrlocs... ¿Por qué?‡Múrlocs... ¿Por qué?‡Pourquoi les murlocs ?‡鱼人......‡魚人……為何此時?為何此地?',
    nil,
    'Gurf, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você recupere 5 sacos de Grão de Pinhoquieto.‡Верните 5 мешков зерна племени Тихвой.‡Gurf bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr 5 Säcke mit Tannenruhgetreide wiedererlangt.‡하늘안개 섬의 너울소나무 요새에 있는 굴프가 너울소나무일족 곡식 5개를 되찾아 달라고 부탁했습니다.‡Gurf del Bastión Semprepino en la Isla Bruma Azur quiere que recuperes 5 sacos de grano Semprepino.‡Gurf del Bastión Semprepino en la Isla Bruma Azur quiere que recuperes 5 sacos de grano Semprepino.‡Gurf, du repaire des Calmepins sur l\'île de Brume-azur, veut que vous retrouviez 5 sacs de Céréales calmepins.‡秘蓝岛止松要塞的古尔弗要求你找回5袋止松谷物。‡藍謎島，靜松要塞的克夫要你取回5袋靜松穀物。',
  }
},
[9563] = {
  {
    'Ganhando a confiança de Mirren‡Доверие Миррена‡Mirrens Vertrauen erlangen‡미렌의 신뢰 얻기‡Ganar la confianza de Mirren‡Ganar la confianza de Mirren‡Gagner la confiance de Mirren‡米伦的信任‡贏得麥倫的信任',
    nil,
    'Mirren Barbalonga quer que você lhe traga 1 Cerveja Etergarde. Será necessário alcançar reputação de Respeitado pela Fortaleza da Honra para completar a missão.‡Принесите Миррену Длиннобороду 1 кружку горькой настойки Стражей Пустоты. Для выполнения этого задания необходимо иметь дружелюбное отношение Оплота Чести.‡Mirren Langbart auf der Höllenfeuerhalbinsel möchte, dass Ihr ihm 1 Nethergarde Bitter bringt. Diese Aufgabe erfordert zum Abschluss auch einen freundlichen Ruf bei der Ehrenfeste.‡미렌 롱비어드가 네더가드 흑맥주 한 잔을 가져다 달라고 부탁했습니다. 이 퀘스트를 완료하려면 명예의 요새로부터 약간 우호적 이상의 평판을 얻어야 합니다.‡Mirren Barbalarga quiere que le lleves 1 cerveza de Nethergarde. También debes alcanzar la reputación de amistoso ante el Bastión del Honor para completar esta misión.‡Mirren Barbalarga quiere que le lleves 1 cerveza de Nethergarde. También debes alcanzar la reputación de amistoso ante el Bastión del Honor para completar esta misión.‡Mirren Barbe-longue veut que vous lui procuriez 1 Bière amère de Rempart-du-Néant. Pour achever cette quête, les gens du bastion de l\'Honneur doivent être Amicaux envers vous.‡将一杯守望堡烈酒交给米伦·长须。完成任务后，你在荣耀堡的声望必须达到友好才能完成这个任务。‡麥倫·長鬚要你幫他帶來1杯守望苦味啤酒。同時你必須在榮譽堡達到友好聲望值才能完成這個任務。',
  }
},
[9564] = {
  {
    'A dignidade de Gurf‡Клок шерсти Гурфа‡Gurfs Würde‡굴프의 자존심‡La dignidad de Gurf‡La dignidad de Gurf‡La dignité de Gurf‡古尔弗的尊严‡克夫的尊嚴',
    nil,
    'Devolva a Dignidade de Gurf na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli.‡Верните Гурфу клок его шерсти в логово племени Тихвой на острове Лазурной Дымки.‡Bringt Gurfs Würde zu Gurf bei der Tannenruhfeste auf der Azurmythosinsel.‡하늘안개 섬의 너울소나무 요새에 있는 굴프에게 굴프의 자존심을 회복해 줘야 합니다.‡Devuélvele a Gurf su dignidad en el Bastión Semprepino en la Isla Bruma Azur.‡Devuélvele a Gurf su dignidad en el Bastión Semprepino en la Isla Bruma Azur.‡Rapportez la Dignité de Gurf à Gurf au repaire des Calmepins sur l\'île de Brume-azur.‡将古尔弗的尊严交给秘蓝岛止松要塞的古尔弗。‡將克夫的尊嚴帶到藍謎島的靜松要塞還給克夫。',
  }
},
[9565] = {
  {
    'A busca na aldeia de Pinhoquieto‡Поиски в логове племени Тихвой‡Sucht in der Tannenruhfeste‡너울소나무 요새 조사‡Registra el Bastión Semprepino‡Registra el Bastión Semprepino‡Fouillez le repaire des Calmepins‡搜索止松要塞‡搜索靜松要塞',
    nil,
    'Procure pistas nas cavernas da Aldeia de Pinhoquieto.‡Найдите в логове племени Тихвой причины предательства совухов.‡Sucht in der Tannenruhfeste nach Hinweisen.‡너울소나무 요새를 조사하여 단서를 찾아야 합니다.‡Busca pistas en el Bastión Semprepino.‡Busca pistas en el Bastión Semprepino.‡Fouillez le repaire des Calmepins à la recherche d\'indices.‡在止松要塞内寻找线索。‡搜索靜松要塞找到線索。',
  }
},
[9566] = {
  {
    'Cristais de sangue‡Кровавые кристаллы‡Blutkristalle‡핏빛 수정‡Cristales de sangre‡Cristales de sangre‡Les cristaux de sang‡血水晶‡血水晶',
    nil,
    'Fale com o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto.‡Поговорите с верховным вождем в логове племени Тихвой.‡Sprecht mit dem Oberhäuptling bei der Tannenruhfeste.‡너울소나무 요새에 있는 대족장 너울소나무와 대화해야 합니다.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Habla con el gran jefe Semprepino en el Bastión Semprepino.‡Parlez au Grand chef Calmepin au repaire des Calmepins.‡与止松要塞的止松老酋长谈一谈。‡和靜松要塞的大酋長靜松談談。',
  }
},
[9567] = {
  {
    'Conhece o teu inimigo‡Лицо врага‡Kenne deinen Feind‡적에 대한 정보‡Conoce a tu enemigo‡Conoce a tu enemigo‡Connais ton ennemi‡知己知彼‡了解敵人',
    nil,
    'Encontre o Monumento a Nazzivus, em Nazzivian, e pegue um Glifo de Monumento a Nazzivus. Em seguida, fale novamente com a Vindicante Aalesia no Entreposto Rubro.‡Найдите в Наззивиане монумент Наззивуса, возьмите один из иероглифов с монумента и вернитесь к воздаятельнице Аалезии на Кровавую заставу.‡Findet das Monument der Nazzivus in Nazzivian und beschafft Euch eine Glyphe vom Monument der Nazzivus. Kehrt zu Verteidigerin Aalesia bei der Blutwacht zurück, sobald Ihr die Glyphe habt.‡나지비안에 있는 나지부스 기념비를 찾아서 나지부스 기념비 상형문자를 얻어낸 후, 핏빛 감시초소에 있는 구원자 알레시아에게 돌아가야 합니다.‡Encuentra el monumento de Nazzivus en Nazzivian y recupera un glifo de dicho monumento. Regresa junto a la vindicadora Aalesia en la Avanzada de Sangre cuando tengas uno de los glifos.‡Encuentra el monumento de Nazzivus en Nazzivian y recupera un glifo de dicho monumento. Regresa junto a la vindicadora Aalesia en la Avanzada de Sangre cuando tengas uno de los glifos.‡Trouvez le Monument de Nazzivus à Nazzivian et récupérez un Glyphe du monument de Nazzivus. Lorsque vous l\'aurez, retournez voir le redresseur de torts Aalesia au Guet du sang.‡找到纳兹维安的碑石，将得到的纳兹维安碑石雕文交给秘血岗哨的守备官艾蕾希亚。‡找到納茲維恩的納茲維斯紀念碑並取得納茲維斯紀念碑雕紋。拿到一個雕紋後回到血色守望的復仇者艾樂希雅那裡。',
  }
},
[9568] = {
  {
    'On the Offensive‡Лучшая защита‡In der Offensive‡공격 감행‡A la ofensiva‡A la ofensiva‡À l\'offensive‡DEPRECATED‡進攻勢態',
    nil,
    'Vindicator Aalesia at Blood Watch wants you to kill 10 Nazzivus Satyr, 5 Nazzivus Rogues, and 5 Nazzivus Felsworn.‡Воздаятельница Аалезия с Кровавой заставы просит убить 10 сатиров, 5 разбойников и 5 скверноподанных из племени Наззивус.‡Verteidigerin Aalesia bei der Blutwacht möchte, dass Ihr 10 Satyrn der Nazzivus, 5 Schurken der Nazzivus und 5 Teufelsanbeter der Nazzivus tötet.‡핏빛 감시초소에 있는 구원자 알레시아가 나지부스 사티로스 10명, 나지부스 도적 5명, 나지부스 악마추종자 5명을 처치해 달라고 부탁했습니다.‡La vindicadora Aalesia en la Avanzada de Sangre quiere que mates a 10 sátiros Nazzivus, 5 pícaros Nazzivus y 5 jurapenas Nazzivus.‡La vindicadora Aalesia en la Avanzada de Sangre quiere que mates a 10 sátiros Nazzivus, 5 pícaros Nazzivus y 5 jurapenas Nazzivus.‡Le redresseur de torts Aalesia du Guet du sang veut que vous tuiez 10 Satyres Nazzivus, 5 Voleurs Nazzivus et 5 Gangreliges Nazzivus.‡秘血岗哨的Vindicator Aalesia要你杀掉10个Nazzivus Satyr，5个Nazzivus Rogues和5个Nazzivus Felsworn。‡血色守望的復仇者艾樂希雅要你殺死10個納茲維斯薩特，5個納茲維斯盜賊，和5個納茲維斯魔語。',
  }
},
[9569] = {
  {
    'Conter a ameaça‡Противостояние‡Die Bedrohung bekämpfen‡오염된 수정 수집‡Contener la amenaza‡Contener la amenaza‡Contenir la menace‡化解危机‡遏制威脅',
    nil,
    'Mate Zevrax, 5 Assombrantes Axxarien e 5 Arautos Infernais Axxarien. Em seguida, pegue 5 Cristais Corrompidos e fale novamente com a Vindicante Aalesia no Entreposto Rubro.‡Убейте Зевракса, 5 аксариенских тенеловов и 5 аксариенских призывателей огня, соберите 5 оскверненных кристаллов и отнесите их на Кровавую заставу воздаятельнице Аалезии.‡Tötet 5 Schattenpirscher von Axxarien, 5 Höllenrufer von Axxarien und Zevrax. Sammelt außerdem 5 verderbte Kristalle ein und kehrt zu Verteidigerin Aalesia bei der Blutwacht zurück.‡악사리엔 그림자추적자 5명, 악사리엔 지옥소환사 5명과 제브락스를 해치운 후, 오염된 수정 5개를 모아서 핏빛 감시초소에 있는 구원자 알레시아에게 돌아가야 합니다.‡Mata a 5 acechasombras Axxarien, 5 clamainfernos Axxarien y a Zevrax, recolecta entonces 5 cristales corruptos y llévaselos a la vindicadora Aalesia en la Avanzada de Sangre.‡Mata a 5 acechasombras Axxarien, 5 clamainfernos Axxarien y a Zevrax, recolecta entonces 5 cristales corruptos y llévaselos a la vindicadora Aalesia en la Avanzada de Sangre.‡Tuez 5 Traqueurs des ombres araxxiens, 5 Invocateurs infernaux axxariens et Zevrax, puis récupérez 5 Cristaux corrompus et retournez auprès du Redresseur de torts Aalesia au Guet du sang.‡杀掉5个阿克萨林暗影行者、5个阿克萨林唤魔者和塞弗拉克斯，然后收集5块被腐蚀的水晶，把它们交给秘血岗哨的守备官艾蕾希亚。‡殺死5個艾克薩瑞安巡影者，5個艾克薩瑞安地獄呼喚者，和澤伏瑞斯，再收集5個被汙染的水晶交給血色守望的復仇者艾樂希雅。',
  }
},
[9570] = {
  {
    'O Cárcaro do tártaro‡Куркен-жмуркен‡Kurken lauert‡쿠르켄 처치‡El Kurken acecha‡El Kurken acecha‡Le Kurken se cache dans le coin‡可怕的库肯‡潛伏的克爾肯',
    nil,
    'Korz, o Revelador, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você mate o Cárcaro e que leve o Couro do Cárcaro para ele.‡Убейте Куркена и принесите его шкуру Курцу Прорицателю в логово племени Тихвой на острове Лазурной Дымки.‡Kurz der Weise bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr Kurken tötet und dass Ihr ihm Kurkens Balg bringt.‡하늘안개 섬의 너울소나무 요새에 있는 계시자 쿠르즈가 쿠르켄을 해치운 후, 쿠르켄의 통가죽을 가져다 달라고 부탁했습니다.‡Kurz el Revelador del Bastión Semprepino en la Isla Bruma Azur quiere que mates a El Kurken y que le lleves su pellejo.‡Kurz el Revelador del Bastión Semprepino en la Isla Bruma Azur quiere que mates a El Kurken y que le lleves su pellejo.‡Kurz le Révélateur, du repaire des Calmepins de l\'île de Brume-azur, veut que vous tuiez le Kurken et que vous lui rameniez la Peau du Kurken.‡秘蓝岛止松要塞的启示者库尔兹要求你杀死库肯，并带回库肯的毛皮。‡藍謎島，靜松要塞的『啟示者』克茲要你殺死克爾肯再帶回克爾肯的皮。',
  }
},
[9571] = {
  {
    'O Couro do Cárcaro‡Шкура Куркена‡Kurkens Balg‡쿠르켄의 통가죽‡El pellejo de El Kurken‡El pellejo de El Kurken‡La peau du Kurken‡库肯的毛皮‡克爾肯的皮',
    nil,
    'Entregue o Couro do Cárcaro a Moordo na Aldeia de Pinhoquieto.‡Отнесите шкуру Куркена Мурдо в логово племени Тихвой.‡Bringt Kurkens Balg zu Moordo bei der Tannenruhfeste.‡너울소나무 요새에 있는 무르도에게 쿠르켄의 통가죽을 가져가야 합니다.‡Entrega el pellejo de El Kurken a Moordo en el Bastión Semprepino.‡Entrega el pellejo de El Kurken a Moordo en el Bastión Semprepino.‡Donnez la Peau du Kurken à Moordo, au repaire des Calmepins.‡将库肯的毛皮交给止松要塞的莫多。‡將克爾肯的皮送給靜松要塞的墨爾多。',
  }
},
[9572] = {
  {
    'Enfraquecer as defesas‡Ослабить оборону валов‡Die Bollwerke schwächen‡성루 무력화‡Debilitar la muralla‡Debilitar la muralla‡Affaiblir les remparts‡攻陷城墙‡削弱防禦',
    nil,
    'Mate o Guarda Gargulmar; Omor, o Intocado; e o draco Nazan. Traga a Mão de Gargulmar, o Casco de Omor e a Cabeça de Nazan para Caza\'rez em Thrallmar, que fica na Península Fogo do Inferno.‡Убейте начальника стражи Гарголмара, Омора Неодолимого и дракона Назана. Принесите руку Гарголмара, копыто Омора и голову Назана Каза\'ресу в Траллмар на Полуострове Адского Пламени.‡Tötet den Wachhabenden Gargolmar, Omor den Narbenlosen und Nazan, den Drachen. Bringt Gargolmars Hand, Omors Huf und Nazans Kopf zu Caza\'rez in Thrallmar auf der Höllenfeuerhalbinsel.‡감시자 가르골마르, 무적의 오모르, 비룡 나잔을 처치한 후, 지옥불 반도의 스랄마에 있는 카자레즈에게 가르골마르의 오른팔, 오모르의 발굽, 나잔의 머리를 가져가야 합니다.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Tuez le gardien des guetteurs Gargolmar, Omor l\'Intouché et le drake Nazan. Rapportez la Main de Gargolmar, le Sabot d\'Omor et la Tête de Nazan à Caza\'rez, à Thrallmar dans la péninsule des Flammes infernales.‡杀死巡视者加戈玛、无疤者奥摩尔和座龙纳杉，并将加戈玛之手、奥摩尔之蹄和纳杉之颅交给地狱火半岛上的萨尔玛内的卡萨雷兹。‡殺死看護者卡爾古瑪、『無疤者』歐瑪爾和納桑。將卡爾古瑪之手、歐瑪爾的蹄子和納桑之顱帶到地獄火半島的索爾瑪交給卡沙瑞斯。',
  }
},
[9573] = {
  {
    'Chefe Umuuruu‡Вождь Умуру‡Häuptling Oomooroo‡족장 우무루 처치‡El cabecilla Oomooroo‡El cabecilla Oomooroo‡Le chef Oomooroo‡欧莫鲁酋长‡歐沐魯酋長',
    nil,
    'Pinhoquieto, o Jovem, na Aldeia de Pinhoquieto, que fica na Ilha Névoa Lazúli, quer que você mate o Chefe Umuuruu e 9 Coruscantes Enlouquecidos.‡Убейте вождя Умуру и 9 безумных диких совухов.‡Der Jüngling Tannenruh bei der Tannenruhfeste auf der Azurmythosinsel möchte, dass Ihr Häuptling Oomooroo und 9 wahnsinnige Wildekin tötet.‡하늘안개 섬의 너울소나무 요새에 있는 젊은 너울소나무가 족장 우무루, 정신나간 올빼미야수 9마리를 처치해 달라고 부탁했습니다.‡Semprepino el Menor del Bastión Semprepino en la Isla Bruma Azur quiere que mates al cabecilla Oomooroo y a 9 lechúcico salvaje enloquecido.|n‡Semprepino el Menor del Bastión Semprepino en la Isla Bruma Azur quiere que mates al cabecilla Oomooroo y a 9 lechúcico salvaje enloquecido.|n‡Calmepin le Jeune, du repaire des Calmepins de l\'île de Brume-azur, veut que vous tuiez le chef Oomooroo et 9 Indomptables affolés.‡秘蓝岛止松要塞的止松酋长要求你杀死欧莫鲁酋长和9只发狂的野枭兽。‡藍謎島，靜松要塞的靜松年少者要你殺死歐沐魯酋長和9個瘋狂的梟獸。',
  }
},
[9574] = {
  {
    'Vítimas da corrupção‡Отравленные скверной‡Opfer der Verderbnis‡오염의 희생자‡Víctimas de la corrupción‡Víctimas de la corrupción‡Victimes de la corruption‡腐蚀的牺牲品‡腐敗的受害者',
    nil,
    'Entregue 6 pedaços de Casca Cristalizada para Morae no Entreposto Rubro.‡Принесите на Кровавую заставу 6 кусков коры, покрытой кристаллами, и отдайте Морэ.‡Bringt 6 Stücke kristallisierte Rinde zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 결정화된 나무껍질 6개를 가져가야 합니다.‡Llévale 6 trozos de corteza cristalizada a Morae en la Avanzada de Sangre.‡Llévale 6 trozos de corteza cristalizada a Morae en la Avanzada de Sangre.‡Apportez 6 morceaux d\'Ecorce cristallisée à Morae, au Guet du sang.‡找到6片晶化树皮，把它们交给秘血岗哨的莫莱。‡帶6塊晶化樹皮給血色守望的莫瑞伊。',
  }
},
[9575] = {
  {
    'Enfraquecer as defesas‡Ослабить оборону валов‡Die Bollwerke schwächen‡성루 무력화‡Debilitar la muralla‡Debilitar la muralla‡Affaiblir les remparts‡攻陷城墙‡削弱防禦',
    nil,
    'Mate o Guarda Gargulmar; Omor, o Intocado; e o draco Nazan. Traga a Mão de Gargulmar, o Casco de Omor e a Cabeça de Nazan para o Gunny na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Убейте начальника стражи Гарголмара, Омора Неодолимого и дракона Назана. Принесите руку Гарголмара, копыто Омора и голову Назана Пушкаренку в Оплот Чести на полуострове Адского Пламени.‡Tötet den Wachhabenden Gargolmar, Omor den Narbenlosen und Nazan, den Drachen. Bringt Gargolmars Hand, Omors Huf und Nazans Kopf zu Gunny in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡감시자 가르골마르, 무적의 오모르, 비룡 나잔을 처치한 후, 지옥불 반도의 명예의 요새에 있는 구니에게 가르골마르의 오른팔, 오모르의 발굽, 나잔의 머리를 가져가야 합니다.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Mata al guardián vigía Gargolmar, a Omor el Sinmarcas y el draco, Nazan. Llévale la mano de Gargolmar, la pezuña de Omor y la cabeza de Nazan a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Tuez le gardien des guetteurs Gargolmar, Omor l\'Intouché et le drake Nazan. Rapportez la Main de Gargolmar, le Sabot d\'Omor et la Tête de Nazan à Flingot, du bastion de l\'Honneur dans la péninsule des Flammes infernales.‡杀死巡视者加戈玛、无疤者奥摩尔和座龙纳杉，并将加戈玛之手、奥摩尔之蹄和纳杉之颅交给地狱火半岛上的荣耀堡内的冈尼。‡殺死看護者卡爾古瑪、『無疤者』歐瑪爾和納桑。將卡爾古瑪之手、歐瑪爾的蹄子和納桑之顱帶到地獄火半島的榮譽堡給甘尼。',
  }
},
[9576] = {
  {
    'O colar de Cruelo‡Ожерелье Жестокого Плавника‡Schandflosses Anhänger‡뾰족갈퀴의 목걸이‡El colgante de Cruelfin‡El colgante de Cruelfin‡Le collier d\'Aileron-cruel‡克鲁芬的项链‡酷鰭的項鍊',
    nil,
    'Entregue o Pingente de Cristal Vermelho para Morae no Entreposto Rubro.‡Покажите подвеску красного кристалла Морэ на Кровавой заставе.‡Bringt den roten Kristallanhänger zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 붉은 수정 펜던트를 가져가야 합니다.‡Llévale el colgante de cristal rojo a Morae en la Avanzada de Sangre.‡Llévale el colgante de cristal rojo a Morae en la Avanzada de Sangre.‡Apportez le Pendentif de cristal rouge à Morae au Guet du sang.‡将红色水晶坠饰交给秘血岗哨的莫莱。‡將紅色水晶綴飾帶給血色守望的莫瑞伊。',
  }
},
[9577] = {
  {
    'DAILY TEST QUEST (PVP)‡DAILY TEST QUEST (PVP)‡DAILY TEST QUEST (PVP)‡!REUSE ME!‡DAILY TEST QUEST (PVP)‡DAILY TEST QUEST (PVP)‡QUÊTE JOURNALIÈRE DE TEST (JcJ)‡DAILY TEST QUEST (PVP)‡!REUSE ME!',
    nil,
    'Speak with <QUESTGIVER> in the <AREA>.‡Поговорите с <QUESTGIVER> в <AREA>.‡Sprecht mit <QUESTGIVER> in <AREA>.‡Speak with <QUESTGIVER> in the <AREA>.‡Habla con <QUESTGIVER> en <AREA>.‡Habla con <QUESTGIVER> en <AREA>.‡Parlez à <QUESTGIVER> dans <REGION>.‡Speak with <QUESTGIVER> in the <AREA>.‡Speak with <QUESTGIVER> in the <AREA>.',
  }
},
[9578] = {
  {
    'À procura de Galaen‡В поисках Галена‡Suche nach Galaen‡갈라엔의 생사 확인‡En busca de Galaen‡En busca de Galaen‡À la recherche de Galaen‡搜寻加莱恩‡尋找高拉恩',
    nil,
    'Procure Galaen, o marido de Morae.‡Найдите Галена, мужа Морэ.‡Sucht nach Moraes Mann Galaen.‡모라에의 남편 갈라엔을 찾아야 합니다.‡Busca al marido de Morae, Galaen.‡Busca al marido de Morae, Galaen.‡Retrouvez Galaen, le mari de Morae.‡寻找莫莱的丈夫加莱恩。‡尋找莫瑞伊的丈夫高拉恩。',
  }
},
[9579] = {
  {
    'O destino de Galaen‡Судьба Галена‡Galaens Schicksal‡갈라엔의 운명‡El sino de Galaen‡El sino de Galaen‡Le destin de Galaen‡加莱恩的命运‡高拉恩的命運',
    nil,
    'Entregue o Amuleto de Galaen para Morae no Entreposto Rubro.‡Принесите на Кровавую заставу амулет Галена и отдайте его Морэ.‡Bringt Galaens Amulett zu Morae bei der Blutwacht.‡핏빛 감시초소에 있는 모라에에게 갈라엔의 아뮬렛을 가져가야 합니다.‡Llévale el amuleto de Galaen a Morae en la Avanzada de Sangre.‡Llévale el amuleto de Galaen a Morae en la Avanzada de Sangre.‡Remettez l\'Amulette de Galaen à Morae au Guet du sang.‡将加莱恩的护符交给秘血岗哨的莫莱。‡將高拉恩的護符帶給血色守望的莫瑞伊。',
  }
},
[9580] = {
  {
    'Necessidades ursinas‡Вскормленные медвежатиной‡Bärdarfsgüter‡식량 수집‡Las necesidades del oso‡Las necesidades del oso‡Les premiers sec-ours‡猎熊‡熊的必需品',
    nil,
    'Entregue 8 Flancos de Urso Marrom Ancião para o Rastreador Lyceon no Entreposto Rubro.‡Принесите зверолову Лисеону на Кровавую заставу 8 кусков мяса с боков старых бурых медведей.‡Bringt 8 Flanken eines alten Braunbären zu Fährtenleser Lyceon bei der Blutwacht.‡핏빛 전초기지에 있는 추적자 리시온에게 덩치 큰 불곰 갈빗살 8개를 가져가야 합니다.‡Llévale 8 costillares de oso marrón adulto al rastreador Lyceon en la Avanzada de Sangre.‡Llévale 8 costillares de oso marrón adulto al rastreador Lyceon en la Avanzada de Sangre.‡Le pisteur Lyceon, du Guet du sang, veut 8 Flanchets d\'anciens ours bruns.‡收集8块老年棕熊的肉，把它们交给秘血岗哨的追踪者兰塞恩。‡帶8塊老棕熊腰肉給血色守望的追蹤者萊希安。',
  }
},
[9581] = {
  {
    'Aprender com os cristais‡Изучение кристаллов‡Von den Kristallen lernen‡수정 견본 확보‡Las lecciones de los cristales‡Las lecciones de los cristales‡Ce qu\'apprennent les cristaux‡研究水晶‡水晶的學問',
    nil,
    'Usando a Picareta de Mineração de Cristais no Cristal do Local de Impacto, recolha uma Amostra de Cristal e entregue-a ao Emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места крушения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Kristallprobe der Absturzstelle von einem Kristall der Absturzstelle zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡충돌 지점 수정에 수정 채광용 곡괭이를 사용하여 충돌 지점 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 가져가야 합니다.‡Consigue una muestra de cristal del lugar del accidente usando el pico de minero de cristales en el cristal del lugar del accidente y llévalo al presagista Mikolaas de la Avanzada de Sangre.‡Consigue una muestra de cristal del lugar del accidente usando el pico de minero de cristales en el cristal del lugar del accidente y llévalo al presagista Mikolaas de la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal du site de l\'impact en utilisant la Pioche à cristaux sur le Cristal du site de l\'impact et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在坠毁点水晶上采集一份坠毁点水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對衝擊遺址水晶使用水晶採礦鎬以取得衝擊遺址水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9582] = {
  {
    'Prova de força‡Силой единой‡Die Stärke des Einen‡죽음의 칼날발톱‡La fuerza de uno solo‡La fuerza de uno solo‡La force de l\'Un‡一人之力‡一人的力量',
    nil,
    'Abra a Jaula do Assolador e mate o Assolador Mortal. Em seguida, fale com Ruada no Entreposto Lazúli, que fica em Névoa Lazúli.‡Откройте клетку смертоносного опустошителя, убейте его и вернитесь к Руаде на Лазурную заставу на острове Лазурной Дымки.‡Öffnet den Felshetzerkäfig und tötet den darin befindlichen Todesfelshetzer. Kehrt dann zu Ruada in der Azurwacht auf der Azurmythosinsel zurück.‡칼날발톱 우리를 열고 그 안에 있는 죽음의 칼날발톱을 처치한 후, 하늘안개 섬의 하늘 감시초소에 있는 루아다에게 돌아가야 합니다.‡Abre la jaula del devastador, mata al devastador de la Muerte, y regresa junto a Ruada en la Avanzada Azur, en la Isla Bruma Azur.‡Abre la jaula del devastador, mata al devastador de la Muerte, y regresa junto a Ruada en la Avanzada Azur, en la Isla Bruma Azur.‡Ouvrez la Cage du ravageur et tuez le Ravageur de la mort qui s\'y trouve, puis retournez voir Ruada au Guet d\'azur, sur l\'île de Brume-azur.‡打开掠食者的牢笼，干掉死亡掠食者，然后向碧蓝岗哨的鲁安达复命。‡打開劫毀者牢籠殺死死亡劫毀者，再回藍謎島的藍色守望找羅達。',
  }
},
[9583] = {
  {
    'Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest‡Omar\'s Test Quest',
    nil,
    'Get Omar some cloth‡Принесите Омару ткани.‡Bringt Omar Stoff.‡Get Omar some cloth‡Consigue tela para Omar‡Consigue tela para Omar‡Donner à Omar du tissu‡Get Omar some cloth‡幫歐瑪拿衣服',
  }
},
[9584] = {
  {
    'A segunda amostra‡Второй образец‡Die zweite Probe‡두 번째 수정 견본‡La segunda muestra‡La segunda muestra‡Le deuxième échantillon‡第二份样本‡第二個樣本',
    nil,
    'Colete uma Amostra de Cristal Alterado do Cristal de Névoa Rubra Alterado usando a Picareta de Mineração de Cristais e entregue-a ao emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места столкновения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте его предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Veränderte Kristallprobe von einem veränderten Blutmythoskristall zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡변형된 핏빛안개 수정에 수정 채광용 곡괭이를 사용하여 변형된 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 돌아가야 합니다.‡Consigue una muestra de cristal alterado utilizando el pico de minero de cristal en el cristal de Bruma de Sangre modificado al presagista Mikolaas de la Avanzada de Sangre.‡Consigue una muestra de cristal alterado utilizando el pico de minero de cristal en el cristal de Bruma de Sangre modificado al presagista Mikolaas de la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal altéré en utilisant la Pioche à cristaux sur le Cristal de Brume-sang altéré et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在变异的秘血水晶上采集一份变异水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對變質的血謎水晶使用水晶採礦鎬以取得變質的水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9585] = {
  {
    'A última amostra‡Последний образчик‡Die letzte Probe‡마지막 수정 견본‡La última muestra‡La última muestra‡Le dernier échantillon‡最终的样本‡最後的樣本',
    nil,
    'Colete uma Amostra de Cristal Axxarien do Cristal Axxarien usando a Picareta de Mineração de Cristais e entregue-a ao emissário Mikolaas no Entreposto Rubro.‡Добудьте образец кристалла с места столкновения, отколов фрагмент кайлом для добычи кристаллов. Принесите образец на Кровавую заставу и отдайте предвестнику Миколаасу.‡Benutzt die Kristallspitzhacke, um eine Axxarienkristallprobe von einem Axxarienkristall zu nehmen. Bringt die Probe zu Herold Mikolaas bei der Blutwacht.‡악사리엔 수정에 수정 채광용 곡괭이를 사용하여 악사리엔 수정 견본을 얻은 후, 핏빛 감시초소에 있는 선구자 미콜라스에게 돌아가야 합니다.‡Consigue una muestra de cristal Axxarien utilizando el Pico de minero de cristales en el cristal Axxarien y llévaselo al heraldo en la Avanzada de Sangre.‡Consigue una muestra de cristal Axxarien utilizando el Pico de minero de cristales en el cristal Axxarien y llévaselo al heraldo en la Avanzada de Sangre.‡Procurez-vous un Échantillon de cristal axxarien en utilisant la Pioche à cristaux sur le Cristal axxarien et apportez-le au messager Mikolaas au Guet du sang.‡使用水晶矿锄在阿克萨林水晶上采集一份阿克萨林水晶样本，把它交给秘血岗哨的先行官米库拉斯。‡對艾克薩瑞安水晶使用水晶採礦鎬以取得艾克薩瑞安水晶樣本然後交給血色守望的通報者米可拉斯。',
  }
},
[9586] = {
  {
    'Ajude Tavera‡Помощь Таваре‡Helft Tavara‡타바라 돕기‡Ayudar a Tavara‡Ayudar a Tavara‡Aider Tavara‡帮助塔瓦拉‡幫助塔瓦拉',
    nil,
    'Guvan, no Entreposto Lazúli, quer que você encontre Tavera e cure as feridas dela.‡Найдите Тавару и исцелите ее раны.‡Guvan bei der Azurwacht möchte, dass Ihr Tavara findet und ihre Wunden heilt.‡하늘 감시초소에 있는 구반이 타바라를 찾아서 상처를 치료해 달라고 부탁했습니다.‡Guvan de la Avanzada Azur quiere que encuentres a Tavara y cures sus heridas.‡Guvan de la Avanzada Azur quiere que encuentres a Tavara y cures sus heridas.‡Guvan du Guet d\'azur veut que vous trouviez Tavara et que vous guérissiez ses blessures.‡碧蓝岗哨的古安要求你找到塔瓦拉并治好她的伤势。‡藍色守望的古樊要你找到塔瓦拉並治療她的傷口。',
  }
},
[9587] = {
  {
    'Notícias sombrias‡Предвестье беды‡Düstere Neuigkeiten‡어둠의 형세‡Aciagas nuevas‡Aciagas nuevas‡De sombres nouvelles‡黑暗之潮‡黑暗的消息',
    nil,
    'Leve a Carta Agourenta para o Comandante-chefe Danath Matatroll na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Доставьте угрожающее письмо боевому командиру Данату Троллебою в Оплот Чести на полуострове Адского Пламени.‡Bringt den unheilvollen Brief zu Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡지옥불 반도의 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 불길한 편지를 가져가야 합니다.‡Ve al Bastión del Honor, en la Península del Fuego Infernal, y entrégale al comandante en jefe Danath Aterratrols la carta agorera.‡Ve al Bastión del Honor, en la Península del Fuego Infernal, y entrégale al comandante en jefe Danath Aterratrols la carta agorera.‡Apportez la Lettre inquiétante au commandant Danath Trollemort au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡将不祥的信件交给地狱火半岛上荣耀堡的远征军指挥官达纳斯·托尔贝恩。‡將不祥的信件帶到地獄火半島交給榮譽堡的軍隊指揮者達納斯·托爾貝恩。',
  }
},
[9588] = {
  {
    'Notícias sombrias‡Предвестье беды‡Düstere Neuigkeiten‡어둠의 형세‡Aciagas nuevas‡Aciagas nuevas‡De sombres nouvelles‡黑暗之潮‡黑暗的消息',
    nil,
    'Leve a Carta Agourenta para Nazgrel em Thrallmar, que fica na Península Fogo do Inferno.‡Доставьте угрожающее письмо Назгрелу в Траллмар на Полуострове Адского Пламени.‡Bringt den unheilvollen Brief zu Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 나즈그렐에게 불길한 편지를 가져가야 합니다.‡Lleva la carta agorera a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Lleva la carta agorera a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Apportez la Lettre inquiétante à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡将不祥的信件交给地狱火半岛上萨尔玛的纳兹格雷尔。‡將不祥的信件帶到地獄火半島交給索爾瑪的納茲格雷爾。',
  }
},
[9589] = {
  {
    'Sangue é vida‡Кровь есть жизнь‡Blut bedeutet Leben‡생명의 근원‡La sangre es vida‡La sangre es vida‡Le sang, c\'est la vie‡鲜血就是生命‡血液就是生命',
    nil,
    'Recolha 10 Frascos de Sangue de Orc Vil e entregue-os a Gunny na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Принесите 10 фиалов крови орков Скверны Пушкаренку в Оплот Чести на полуострове Адского Пламени.‡Sammelt 10 Phiolen mit Höllenorcblut und bringt sie zu Gunny in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡타락한 오크의 혈액 견본 10개를 모아서 지옥불 반도의 명예의 요새에 있는 구니에게 가져가야 합니다.‡Reúne 10 viales de sangre de orco vil y regresa junto a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Reúne 10 viales de sangre de orco vil y regresa junto a Pistolete en el Bastión del Honor, en la Península del Fuego Infernal.‡Récupérez 10 Fioles de sang de gangr\'orc et rapportez-les à Flingot au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡收集10份邪兽人血样，把它们交给地狱火半岛上的荣耀堡内的冈尼。‡收集10個魔獄獸人血瓶後回到地獄火半島的榮譽堡找甘尼。',
  }
},
[9590] = {
  {
    'Sangue é vida‡Кровь есть жизнь‡Blut bedeutet Leben‡생명의 근원‡La sangre es vida‡La sangre es vida‡Le sang, c\'est la vie‡鲜血就是生命‡血液就是生命',
    nil,
    'Recolha 10 Frascos de Sangue de Orc Vil e entregue-os ao Centurião Caza\'rez em Thrallmar, que fica na Península Fogo do Inferno.‡Принесите 10 фиалов крови орков Скверны центуриону Каза\'ресу в Траллмар на Полуострове Адского Пламени.‡Sammelt 10 Phiolen mit Höllenorcblut und bringt sie zu Zenturio Caza\'rez in Thrallmar auf der Höllenfeuerhalbinsel.‡타락한 오크의 혈액 견본 10개를 모은 후 지옥불 반도의 스랄마에 있는 카자레즈에게 가져가야 합니다.‡Consigue 10 viales de sangre de orcos viles y llévaselos al centurión Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Consigue 10 viales de sangre de orcos viles y llévaselos al centurión Caza\'rez en Thrallmar, en la Península del Fuego Infernal.‡Récupérez 10 Fioles de sang de gangr\'orc et rapportez-les au centurion Caza\'rez à Thrallmar dans la péninsule des Flammes infernales.‡收集10份邪兽人血样，把它们交给地狱火半岛上的萨尔玛内的卡萨雷兹。‡收集10個魔獄獸人血瓶帶回地獄火半島的索爾瑪給百夫長卡沙瑞斯。',
  }
},
[9591] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡미늘가시게 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Barbatisco e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите колючего краба. Вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen Stachelkriecher zu bändigen. Kehrt nach gelungenem Unterfangen zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 미늘가시게를 길들인 후 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un reptador con púas y vuelve junto a la cazadora Kella Arconocturno cuando lo hayas conseguido.‡Usa el Tótem de doma para domesticar un reptador con púas y vuelve junto a la cazadora Kella Arconocturno cuando lo hayas conseguido.‡Utilisez le Totem de domptage pour apprivoiser un Clampant barbelé et revenez voir la chasseresse Kella Arquenuit lorsque vous aurez réussi.‡使用驯兽图腾驯化一只带刺的螃蟹，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和尖刺的爬行者做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9592] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡수풀타조 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Xilostruz Maior e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите большого лесонога, после чего вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen großen Grünschreiter zu bändigen und kehrt anschließend zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 커다란 수풀타조를 길들인 후, 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un maderazancudo superior y vuelve junto a la cazadora Kella Arconocturno.‡Usa el Tótem de doma para domesticar un maderazancudo superior y vuelve junto a la cazadora Kella Arconocturno.‡Utilisez le Totem de domptage pour apprivoiser un Trotteur des bois supérieur et retournez voir la chasseresse Kella Arquenuit.‡使用驯兽图腾驯化一只巨型林地陆行鸟，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和大林地陸行鳥做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9593] = {
  {
    'Taming the Beast‡Приручение зверя‡Die Zähmung der Bestie‡밤호랑이 길들이기‡Domesticar la bestia‡Domesticar la bestia‡Dompter la bête‡驯服野兽‡馴服野獸',
    nil,
    'Use o Totem de Adestramento para fazer amizade com um Espreitanoite e fale novamente com a Caçadora Kella Arconyx quando tiver conseguido.‡Используйте тотем приручения и приручите ночного ловца. Вернитесь к охотнице Келле Тетиве Ночи.‡Benutzt das Zähmertotem, um einen Nachtpirscher zu bändigen und kehrt anschließend zu Jägerin Kella Nachtbogen zurück.‡조련용 토템을 사용하여 밤호랑이를 길들인 후 여사냥꾼 켈라 나이트보우에게 돌아가야 합니다.‡Usa el Tótem de doma para domesticar un acechador nocturno y vuelve junto a la cazadora Kella Arconocturno.‡Usa el Tótem de doma para domesticar un acechador nocturno y vuelve junto a la cazadora Kella Arconocturno.‡Utilisez le Totem de domptage pour apprivoiser un Traquenuit et revenez voir la chasseresse Kella Arquenuit.‡使用驯兽图腾驯化一只夜行豹，成功之后向女猎手凯拉·夜弓复命。‡使用馴服圖騰和夜間潛獵者做朋友再回到女獵人凱拉·夜弓那裡。',
  }
},
[9594] = {
  {
    'Os sinais da Legião‡Знаки Легиона‡Zeichen der Legion‡불타는 군단의 조짐‡Signos de la Legión‡Signos de la Legión‡Les signes de la Légion‡军团的徽记‡燃燒軍團的徵象',
    nil,
    'Mate 8 Sátiros Nazzivus e 8 Devotos Vis Nazzivus. Em seguida, entregue a Placa de Armadura do Tzerak para a Vindicante Aalesia no Entreposto Rubro.‡Убейте 8 сатиров из племени Наззивус и 8 скверноподданных из племени Наззивус, а затем отнесите латный доспех Тзерака воздаятельнице Аалезии на Кровавую заставу.‡Tötet 8 Satyrn der Nazzivus und 8 Teufelsanbeter der Nazzivus. Bringt anschließend Tzeraks Panzerplatte zu Verteidigerin Aalesia bei der Blutwacht.‡나지부스 사티로스 8명, 나지부스 악마추종자 8명을 처치한 후, 핏빛 감시초소에 있는 구원자 알레시아에게 트제라크의 판금 갑옷 조각을 가져가야 합니다.‡Mata a ocho sátiros Nazzivus y a ocho Jurapenas Nazzivus, y lleva la placa de armadura de Tzerak a la vindicadora Aalesia de la Avanzada de Sangre.‡Mata a ocho sátiros Nazzivus y a ocho Jurapenas Nazzivus, y lleva la placa de armadura de Tzerak a la vindicadora Aalesia de la Avanzada de Sangre.‡Tuez 8 Satyres Nazzivus et 8 Gangreliges Nazzivus, puis apportez la Plaque d\'armure de Tzerak au redresseur de torts Aalesia, au Guet du sang.‡除掉8个纳兹维安萨特和8个纳兹维安魔誓者，然后将瑟拉克的护甲块交给秘血岗哨的守备官艾蕾希亚。‡殺死8個納茲維斯薩特和8個納茲維斯魔語，然後帶著泰斯拉克的鎧甲到血色守望找復仇者艾樂希雅。',
  }
},
[9595] = {
  {
    'Controle‡Контроль‡Kontrolle‡마법의 노예‡Control‡Control‡Contrôle‡控制‡控制魔法',
    nil,
    'Mate os Murlocs da Baía do Limo para evocar um Magespectro Quel\'dorei e, então, destrua-o. Em seguida, fale com Rate na Cripta das Luzes, na Exodar.‡Убивайте мурлоков с Илистого Берега до тех пор, пока не появится призрак кель\'дорайского мага, затем уничтожьте его. После этого поговорите с Бати в Чертоге Света Экзодара.‡Vernichtet die Murlocs der Schlickerküste, um einen Magiergeist der Quel\'dorei zu rufen, und vernichtet ihn. Sprecht dann mit Bati in der Halle des Lichts in der Exodar.‡개펄 해안의 멀록을 처치하여 쿠엘도레이 마법사 망령이 나타나게 한 후 그를 처치하고 엑소다르 빛의 전당에 있는 바티와 대화해야 합니다.‡Mata múrlocs de La Costa de Cieno para invocar a la ánima maga quel\'dorei. Destrúyela y ve a hablar con Bati en El Arca de las Luces de El Exodar.‡Mata múrlocs de La Costa de Cieno para invocar a la ánima maga quel\'dorei. Destrúyela y ve a hablar con Bati en El Arca de las Luces de El Exodar.‡Tuez des Murlocs sur le Rivage envasé pour invoquer une Âme en peine quel\'dorei magicienne, puis détruisez-la. Allez ensuite parler à Bati à la Voûte des lumières de l\'Exodar.‡杀死淤泥海岸附近的鱼人以召唤出奎尔多雷法师怨灵，并消灭它。完成之后与埃索达圣光穹顶的巴蒂谈一谈。‡殺死淤塞海岸的魚人來召喚奎爾多雷法師怨靈，然後擊敗它。完成之後，到艾克索達的聖光地窖和巴提談談。',
  }
},
[9598] = {
  {
    'Redemption‡Искупление‡Erlösung‡구원‡Redención‡Redención‡Rédemption‡救赎‡救贖',
    nil,
    'Estude o Tomo de Divindade e fale com Jol.‡Прочтите Фолиант Божественности и поговорите с Джоль.‡Lest das Buch der Offenbarung und sprecht mit Jol.‡신앙의 고서를 공부한 후에 졸과 대화해야 합니다.‡Estudia el Libro de Divinidad y habla con Jol.‡Estudia el Libro de Divinidad y habla con Jol.‡Étudiez le Tome de divinité et parlez à Jol.‡阅读圣洁之书后和约尔谈一谈。‡研讀聖潔之書並且跟喬歐談話。',
  }
},
[9599] = {
  {
    '<UNUSED>‡<UNUSED>‡<UNUSED>‡[미사용] 신앙의 고서‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>‡<UNUSED>',
    nil,
    'Speak with Jol in the Exodar.‡Speak with Jol in the Exodar.‡Sprecht mit Jol in der Exodar.‡엑소다르에 있는 졸과 대화해야 합니다.‡Habla con Jol en El Exodar.‡Habla con Jol en El Exodar.‡Parlez à Jol, à l\'Exodar.‡Speak with Jol in the Exodar.‡和艾克索達的喬歐談談。',
  }
},
[9600] = {
  {
    'Redemption‡Искупление‡Erlösung‡구원의 길‡Redención‡Redención‡Rédemption‡救赎‡救贖',
    nil,
    'Jol quer que você ressuscite um Xamã Pelurso Jovem com o Símbolo da Vida e fale novamente com ela.‡Воскресите молодого фурболга-шамана из племени Тихвой при помощи знака Жизни, а затем вернитесь к Джоль.‡Jol möchte, dass Ihr einen jungen Schamanen der Furbolgs mit dem Symbol des Lebens wieder zum Leben erweckt und dass Ihr anschließend wieder zu ihr zurückkehrt.‡생명의 징표를 사용하여 젊은 펄볼그 주술사를 부활시킨 후, 상급 성기사인 졸에게 돌아가야 합니다.‡Jol quiere que resucites al chamán fúrbolg joven con el Símbolo de la Vida y después se lo devuelvas.‡Jol quiere que resucites al chamán fúrbolg joven con el Símbolo de la Vida y después se lo devuelvas.‡Jol veut que vous vous serviez du Symbole de vie pour ressusciter un Jeune chaman furbolg avant de revenir la voir.‡约尔希望你利用生命符记复活一个年轻的熊怪萨满祭司，然后回去向她复命。‡喬歐要你用生命符記復活一個年輕的熊怪薩滿再回去找她。',
  }
},
[9601] = {
  {
    'Ao Baluarte‡В Бастион‡Zum Bollwerk‡보루를 향한 여정‡Hacia El Baluarte‡Hacia El Baluarte‡En route pour la Barricade‡前往亡灵壁垒‡前進亡靈壁壘',
    nil,
    'Fale com Mehlar Aurolume no Baluarte.‡Поговорите с Меларом Клинком Рассвета из Бастиона.‡Sprecht mit Mehlar Dämmerklinge beim Bollwerk.‡보루에 있는 메라 돈블레이드와 대화해야 합니다.‡Habla con Mehlar Hojalba en El Baluarte.‡Habla con Mehlar Hojalba en El Baluarte.‡Parlez à Mehlar Aubelame à la Barricade.‡与亡灵壁垒的麦拉·黎明之刃谈一谈。‡和在亡靈壁壘的梅拉爾·曦刃談談。',
  }
},
[9602] = {
  {
    'Livrai-os de todo mal...‡Избавь их от лукавого...‡Unheilvolle Mitteilung‡반역자의 교신 내용 전달‡Líbralos del mal...‡Líbralos del mal...‡Délivrez-les du mal...‡邪恶的书信‡傳遞不幸的消息……',
    nil,
    'Entregue o Comunicado do Traidor ao Exarca Menelaus, no Entreposto Lazúli.‡Отнесите переписку предателя экзарху Менелаусу на Лазурную заставу.‡Bringt die Mitteilung des Verräters zu Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스에게 반역자의 교신 내용을 가져가야 합니다.‡Entrega la comunicación del traidor al exarca Menelaous en la Avanzada Azur.‡Entrega la comunicación del traidor al exarca Menelaous en la Avanzada Azur.‡Remettre la Communication du traître à l\'exarque Menelaous au Guet d\'azur.‡将叛徒的证据交给碧蓝岗哨的大主教梅内莱厄斯。‡將叛徒的信件帶給藍色守望的主教米奈奧斯。',
  }
},
[9603] = {
  {
    'Roupa de cama, mesa e etc‡Лежанки, лекарства и прочая ерунда‡Betten, Verbände und noch viel mehr‡토퍼의 목록 전달‡Camas, vendas y algo más‡Camas, vendas y algo más‡Des lits, des bandages, etc.‡床铺，绷带，以及更多‡床，繃帶，和很多很多',
    nil,
    'Leve a Lista do Topher a Laando, o Mestre de Hipogrifos, no Entreposto Rubro.‡Отвезите список Тофера на Кровавую заставу дрессировщику гиппогрифов Лаандо.‡Bringt Tophers Liste zu Laando, dem Hippogryphenmeister bei der Blutwacht.‡핏빛 감시초소에 있는 히포그리프 조련사 라안도에게 토퍼의 목록을 가져가야 합니다.‡Llévale la lista de Topher a Laando, el maestro de hipogrifos de la Avanzada de Sangre.‡Llévale la lista de Topher a Laando, el maestro de hipogrifos de la Avanzada de Sangre.‡Remettez la Liste de Topher à Laando, le maître des hippogriffes du Guet du sang.‡将托菲尔的清单交给秘血岗哨的角鹰兽管理员兰度。‡把塔伏爾的單子交給血色守望的角鷹獸管理員勒藍度。',
  }
},
[9604] = {
  {
    'Nas asas do hipogrifo‡На крыльях гиппогрифа‡Auf dem Rücken eines Hippogryphen‡히포그리프에 몸을 싣고‡En alas de un hipogrifo‡En alas de un hipogrifo‡Sur les ailes d\'un hippogriffe‡乘坐角鹰兽‡飛快的角鷹獸',
    nil,
    'Pague Laando por uma viagem de hipogrifo até a Exodar. Ao pousar, leve a Lista do Topher a Nurguni na Sede dos Naarus, que fica na Exodar.‡Возьмите у Лаандо гиппогрифа и летите в Экзодар. В Экзодаре отдайте список Тофера Нургуни. Нургуни можно найти у трона Наару в Экзодаре.‡Erwerbt bei Laando einen Hippogryphenritt zur Exodar. Bringt Tophers Liste nach der Landung zu Nurguni im Sitz der Naaru der Exodar.‡라안도에게 히포그리프를 빌려 엑소다르로 간 후, 나루의 보좌에 있는 누르구니에게 토퍼의 목록을 가져가야 합니다.‡Cómprale a Laando un viaje en hipogrifo a El Exodar. Cuando aterrices, llévale la lista de Topher a Nurguni en el Trono de los Naaru, en El Exodar.‡Cómprale a Laando un viaje en hipogrifo a El Exodar. Cuando aterrices, llévale la lista de Topher a Nurguni en el Trono de los Naaru, en El Exodar.‡Acheter à Laando un vol en hippogriffe jusqu\'à l\'Exodar. À votre arrivée, remettez la Liste de Topher à Nurguni, au Siège du naaru dans l\'Exodar.‡乘坐角鹰兽从兰度处飞往埃索达。到达后，将托菲尔的清单交给纳鲁之座的努古尼。‡向勒藍度那租借一隻角鷹獸飛往艾克索達，抵達後，將塔伏爾的單子交給那魯之座的魯古尼。',
  }
},
[9605] = {
  {
    'O mestre de hipogrifos Stephanos‡Укротитель гиппогрифов Стефанос‡Hippogryphenmeister Stephanos‡히포그리프 조련사 스테파노스‡El maestro de hipogrifos Stephanos‡El maestro de hipogrifos Stephanos‡Le maître des hippogriffes Stephanos‡斯泰法努斯‡角鷹獸管理員史丹樊那斯',
    nil,
    'Fale com Stephanos diante da Exodar e compre uma viagem de hipogrifo de volta ao Entreposto Rubro.‡Найдите Стефаноса у ворот Экзодара и наймите гиппогрифа для возвращения на Кровавую заставу.‡Geht zu Stephanos in der Exodar und erwerbt einen Hippogryphenritt zurück zur Blutwacht.‡엑소다르 외부에 스테파노스를 찾아서 히포그리프를 타고 핏빛 감시초소로 돌아가야 합니다.‡Encuentra a Stephanos en las afueras de El Exodar y compra un viaje en hipogrifo para volver a la Avanzada de Sangre.‡Encuentra a Stephanos en las afueras de El Exodar y compra un viaje en hipogrifo para volver a la Avanzada de Sangre.‡Allez trouver Stephanos à l\'extérieur de l\'Exodar et achetez-lui un vol à dos d\'hippogriffe pour rentrer au Guet du sang.‡找到埃索达外的斯泰法努斯，乘坐他的角鹰兽回到秘血岗哨。‡到艾克索達外去找史丹樊那斯，並乘坐角鷹獸回到血色守望。',
  }
},
[9606] = {
  {
    'Fale novamente com Topher Loaal‡Возвращение к Тоферу Лоаалу‡Zurück zu Topher Loaal‡토퍼 로알에게 돌아가기‡Regresa junto a Topher Loaal‡Regreso junto a Topher Loaal‡Retourner voir Topher Loaal‡返回托菲尔·罗阿身边‡回到塔伏爾·羅歐那裡',
    nil,
    'Fale com Stephanos e pague uma viagem de hipogrifo de volta ao Entreposto Rubro. Quando chegar, entregue os Suprimentos de Nurguni ao Hospedeiro Topher Loaal.‡Договоритесь со Стефаносом и наймите у него гиппогрифа для путешествия на Кровавую заставу. На заставе доставьте припасы Нургуни корчмарю Тоферу Лоаалу.‡Sprecht mit Stephanos und erwerbt einen Hippogryphenritt zurück zur Blutwacht. Bringt Nurgunis Vorräte nach Eurer Ankunft zu Versorger Topher Loaal.‡스테파노스와 대화한 후 히포그리프를 타고 핏빛 감시초소로 돌아가 도착한 후, 간병인 토퍼 로알에게 누르구니의 보급상자를 가져가야 합니다.‡Habla con Stephanos para comprar un viaje en hipogrifo de vuelta a la Avanzada de Sangre. Cuando llegues, entrégale los suministros de Nurguni al cuidador Topher Loaal.‡Habla con Stephanos para comprar un viaje en hipogrifo de vuelta a la Avanzada de Sangre. Cuando llegues, entrégale los suministros de Nurguni al cuidador Topher Loaal.‡Achetez à Stephanos un vol en hippogriffe pour rentrer au Guet du sang. Une fois arrivé, livrez les Fournitures de Nurguni à l\'Hôte Topher Loaal.‡与斯泰法努斯谈一谈，然后租用一头角鹰兽回秘血岗哨。达到后，将努古尼的补给品交给托菲尔·罗阿。‡與史丹樊那斯租借一隻角鷹獸回到血色守望。一旦抵達後，運送魯古尼的補給品給照顧者塔伏爾·羅歐',
  }
},
[9607] = {
  {
    'Coração da ira‡В сердце ярости‡Im Herzen des Hasses‡격노의 한복판‡Corazón furioso‡Corazón furioso‡Cœur de rage‡愤怒之心‡狂怒之心',
    nil,
    'Investigue a Fornalha de Sangue por completo e então apresente-se ao Comandante-chefe Danath Matatroll na Fortaleza da Honra, que fica na Península Fogo do Inferno.‡Детально изучите Кузню Крови и доложите об увиденном командиру армии Данату Троллебою в Оплот Чести на полуострове Адского Пламени.‡Untersucht das gesamte Areal des Blutkessels und meldet Euch anschließend bei Truppenkommandant Danath Trollbann in der Ehrenfeste auf der Höllenfeuerhalbinsel.‡피의 용광로를 샅샅이 조사한 후, 지옥불 반도의 명예의 요새에 있는 전투사령관 다나스 트롤베인에게 보고해야 합니다.‡Investiga a fondo El Horno de Sangre y después informa al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Investiga a fondo El Horno de Sangre y después informa al comandante en jefe Danath Aterratrols en el Bastión del Honor, en la Península del Fuego Infernal.‡Faire une enquête exhaustive sur la Fournaise du sang, puis en faire un rapport au commandant de corps Danath Trollemort, au bastion de l\'Honneur dans la péninsule des Flammes infernales.‡全面调查鲜血熔炉，然后向地狱火半岛上的荣耀堡内的远征军指挥官达纳斯·托尔贝恩汇报。‡徹底調查血熔爐再到地獄火半島的榮譽堡向軍隊指揮者達納斯·托爾貝恩回報。',
  }
},
[9608] = {
  {
    'Coração da ira‡В сердце ярости‡Im Herzen des Hasses‡격노의 한복판‡Corazón furioso‡Corazón furioso‡Cœur de rage‡愤怒之心‡狂怒之心',
    nil,
    'Investigue a Fornalha de Sangue por completo e então apresente-se a Nazgrel em Thrallmar, que fica na Península Fogo do Inferno.‡Детально изучите Кузню Крови и доложите об увиденном Назгрелу из Траллмара на Полуострове Адского Пламени.‡Untersucht das gesamte Areal des Blutkessels und meldet Euch anschließend bei Nazgrel in Thrallmar auf der Höllenfeuerhalbinsel.‡피의 용광로를 샅샅이 조사한 후 지옥불 반도의 스랄마에 있는 나즈그렐에게 보고해야 합니다.‡Investiga a fondo El Horno de Sangre y después informa a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Investiga a fondo El Horno de Sangre y después informa a Nazgrel en Thrallmar en la Península del Fuego Infernal.‡Faire une enquête exhaustive sur la Fournaise du sang, puis en faire un rapport à Nazgrel, à Thrallmar dans la péninsule des Flammes infernales.‡全面调查鲜血熔炉，然后向地狱火半岛上的萨尔玛内的纳兹格雷尔汇报。‡徹底調查血熔爐再到地獄火半島的索爾瑪向納茲格雷爾回報。',
  }
},
[9609] = {
  {
    'Ajude o Vigia Biggs‡Помощь дозорному Биггсу‡Helft Behüter Biggs‡파수병 비그스 돕기‡Ayuda al vigía Biggs‡Ayuda al vigía Biggs‡Aidez le gardien Biggs‡帮助卫兵比格斯‡幫助看守者比格斯',
    nil,
    'Encontre o Vigia Biggs no Pântano das Mágoas.‡Найдите дозорного Биггса на Болоте Печали.‡Sucht Behüter Biggs in den Sümpfen des Elends.‡슬픔의 늪에 있는 파수병 비그스를 찾아야 합니다.‡Encuentra al vigía Biggs en el Pantano de las Penas.‡Encuentra al vigía Biggs en el Pantano de las Penas.‡Trouvez le gardien Biggs dans le marais des Chagrins.‡找到悲伤沼泽的卫兵比格斯。‡在悲傷沼澤裡找到看守者比格斯。',
  }
},
[9610] = {
  {
    'Poço de Lágrimas‡Озеро Слез‡Der Tränenteich‡눈물의 연못‡Charca de Lágrimas‡Poza de lágrimas‡Le bassin des larmes‡泪水之池‡淚水之池',
    nil,
    'Obtain 5 Atal\'ai Artifacts and return them to Holaaru at the Harborage in the Swamp of Sorrows.‡Добудьте 5 артефактов Атал\'ай и вернитесь с ними к Холаару в Убежище на Болото Печали.‡Besorgt 5 Artefakte der Atal\'ai und bringt sie zu Holaaru im sicheren Hafen in den Sümpfen des Elends.‡아탈라이 유물 5개를 구해서 슬픔의 늪의 피난처에 있는 홀라아루에게 돌아가야 합니다.‡Consigue 5 artefactos Atal\'ai y llévaselos a Holaaru en El Puerto del Pantano de las Penas.‡Consigue 5 artefactos Atal\'ai y llévaselos a Holaaru en El Puerto del Pantano de las Penas.‡Procurez-vous 5 Artéfacts atal\'ai et remettez-les à Holaaru, au Havre boueux du marais des Chagrins.‡取得5个阿塔莱神器，将它们交给悲伤沼泽避难营的霍拉鲁。‡取得5個阿塔萊神器再回到悲傷沼澤的避難營找何拉魯。',
  }
},
[9612] = {
  {
    'Agradeço de coração!‡Большое спасибо!‡Herzlichen Dank!‡생명의 은인‡¡Gracias de corazón!‡¡Gracias de corazón!‡Merci du fond du cœur !‡非常感谢！‡衷心的感謝!',
    nil,
    'Fale com o Exarca Menelaus no Entreposto Lazúli.‡Поговорите с экзархом Менелаусом на Лазурной заставе.‡Sprecht mit Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스와 대화해야 합니다.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Parlez à l\'exarque Menelaous au Guet d\'azur.‡与碧蓝岗哨的大主教梅内莱厄斯谈一谈。‡和藍色守望的主教米奈奧斯談談。',
  }
},
[9613] = {
  {
    'Deprecated: Keanna\'s Will‡Испорчено: завещание Кинны‡Keannas Wille‡킨나의 의지‡Deprecated: El testamento de Keanna‡Deprecated: El testamento de Keanna‡[PÉRIMÉ]La volonté de Keanna‡Deprecated: Keanna\'s Will‡Deprecated:琪安娜的遺囑',
    nil,
    'A Lâmina Estilhaçada que você encontrou em Karazhan quer que você peça a Koren que a conserte. Você precisa da reputação de Honrado pelo Olho Violeta para completar a missão.‡Раздробленный клинок, который вы отыскали в Каражане, просит вас найти Корена, чтобы тот мог восстановить его. Для завершения этого задания необходимо иметь как минимум уважительное отношение Аметистового Ока.‡Die zertrümmerte Klinge, die ihr in Karazhan gefunden habt, möchte, dass Ihr Koren bittet, sie zu reparieren. Ihr müsst außerdem einen wohlwollenden Ruf beim Violetten Auge innehaben, um die Quest abzuschließen.‡카라잔에서 발견한 파괴된 검이 코렌에게 자기를 고쳐 달라고 요청해 달라고 부탁했습니다. 또한 이 퀘스트를 완료하려면 보랏빛 눈으로부터 우호적 이상의 평판을 얻어야 합니다.‡La espada destrozada que encontraste en Karazhan quiere que le pidas a Koren que la repare. También debes alcanzar la reputación de honorable ante El Ojo Violeta para completar esta misión.‡La espada destrozada que encontraste en Karazhan quiere que le pidas a Koren que la repare. También debes alcanzar la reputación de honorable ante El Ojo Violeta para completar esta misión.‡La Lame brisée découverte à Karazhan veut que vous demandiez à Koren de la réparer. Pour achever cette quête, il faut aussi que vous soyez Honoré  par l\'Œil pourpre‡The Shattered Blade you found in Karazhan wants you to ask Koren to repair it.  You\'ll also need to attain Honored reputation with the Violet Eye to complete this quest.‡你在卡拉贊找到的Shattered Blade要你請卡爾侖將它修復。你還需要在紫羅蘭之眼達到尊敬聲望值才能完成這個任務。',
  }
},
[9616] = {
  {
    'Bandoleiros!‡Бандиты!‡Banditen!‡블러드 엘프 약탈자!‡¡Bandidos!‡¡Bandidos!‡Bandits !‡强盗！‡土匪!',
    nil,
    'Leve o Comunicado dos Elfos Sangrentos ao Exarca Menelaus no Entreposto Lazúli.‡Отнесите сообщение эльфов крови экзарху Менелаусу на Лазурную заставу.‡Nehmt das Blutelfendokument zu Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스에게 블러드 엘프 교신 내용을 가져가야 합니다.‡Llévale la comunicación del elfo de sangre al exarca Menelaous en la Avanzada Azur.‡Llévale la comunicación del elfo de sangre al exarca Menelaous en la Avanzada Azur.‡Remettez la Communication des elfes de sang à l\'exarque Menelaous au Guet d\'azur.‡将血精灵布告交给碧蓝岗哨的大主教梅内莱厄斯。‡將血精靈情報帶給藍色守望的主教米奈奧斯。',
  }
},
[9617] = {
  {
    'Procure os Andarilhos‡На поиски Странников‡Sucht die Weltenwanderer auf‡원정순찰대를 찾아서...‡Busca a los errantes‡Busca a los errantes‡Aller voir les pérégrins‡寻找远行者‡尋找遠行者',
    nil,
    'Fale com a Tenente Correalba no Retiro dos Andarilhos.‡Поговорите с лейтенантом Вестницей Рассвета в обители Странников.‡Sprecht mit Leutnant Dämmerflucht bei der Zuflucht der Weltenwanderer.‡원정순찰대 산장에 있는 부관 돈러너와 대화하십시오.‡Habla con la teniente Correalba en El Retiro del Errante.‡Habla con la teniente Correalba en El Retiro del Errante.‡Parlez au lieutenant Coursaurore à la retraite des Pérégrins.‡与远行者居所的达恩·晨行者中尉谈一谈。‡和遠行者居所的曦奔中尉談談。',
  }
},
[9618] = {
  {
    'Entregue os relatórios‡Возвращение с донесениями‡Überbringen der Berichte‡보고서 전달‡Devuelve los informes‡Devuelve los informes‡Remettre les rapports‡交回报告‡交回報告',
    nil,
    'Leve os Relatórios de Keltus Umbrafronde a Zelanis em Luaprata.‡Отнесите донесения Келтуса Темного Листа Зеланису в Луносвет.‡Bringt Keltus Dunkellaubs Berichte zu Zelanis in Silbermond.‡실버문에 있는 젤라니스에게 켈투스 다크리프의 보고서를 가져가야 합니다.‡Lleva los informes de Keltus Hojaoscura a Zelanis en la Ciudad de Lunargenta.‡Lleva los informes de Keltus Hojaoscura a Zelanis en la Ciudad de Lunargenta.‡Transmettez les Rapports de Keltus Sombrefeuille à Zelanis, à Lune-d\'argent.‡将克尔图斯·暗叶的报告交给银月城的瑟兰尼斯。‡將卡特斯·暗葉的報告帶給銀月城的賽藍尼斯。',
  }
},
[9619] = {
  {
    'A Runa de Evocação‡Руна призыва‡Beschwörungsrune‡소환의 룬‡La runa de invocación‡La runa de invocación‡La rune d\'invocation‡召唤符文‡召喚符文',
    nil,
    'Use a Pedra do Caos para evocar um Emissário do Caos na Vila de Aurinévoa, derrote-o e fale novamente com Talionia em Luaprata.‡Используйте камень Бездны, чтобы призвать демона Бездны в деревню Золотистой Дымки, одолейте демона и вернитесь к Талионии в Луносвет.‡Verwendet den Leerstein, um einen Leerwandler in Goldnebel zu beschwören. Bezwingt ihn und kehrt zu Talionia in Silbermond zurück.‡황금안개 마을에서 공허의 돌을 사용하여 보이드워커를 소환한 다음 해치워야 합니다. 그런 후 실버문에 있는 탈리오니아에게 돌아가십시오.‡Usa la piedra del vacío para invocar a un abisario en la Aldea Bruma Dorada, derrótalo, y regresa junto a Talionia en la Ciudad de Lunargenta.‡Usa la piedra del vacío para invocar a un abisario en la Aldea Bruma Dorada, derrótalo, y regresa junto a Talionia en la Ciudad de Lunargenta.‡Servez-vous de la Pierre de Vide pour invoquer un Marcheur du Vide au village Brume-d\'or, vainquez-le puis retournez voir Talionia à Lune-d\'argent.‡在金雾村使用虚空石召唤出虚空行者，打败它，然后回到银月城的塔莱尼娅身边。‡在金霧村使用虛無石召喚出一個虛無行者，擊敗它，再回到銀月城的塔萊妮亞那裡。',
  }
},
[9620] = {
  {
    'A equipe de levantamento desaparecida‡Пропавшие картографы‡Das vermisste Vermessungsteam‡실종된 조사단‡El equipo de investigación desaparecido‡El equipo de investigación desaparecido‡Les explorateurs disparus‡失踪的测量小组‡失蹤的調查小組',
    nil,
    'O Emissário Mikolaas quer que você encontre a Equipe de Levantamento Topográfico enviada para as Ruínas de Loreth\'Aran e ajude-a no que for preciso.‡Предвестник Миколаас просит разыскать группу разведчиков, которую он послал к развалинам Лорет\'Арана, и помочь группе чем только возможно.‡Herold Mikolaas möchte, dass Ihr das Vermessungsteam findet, das er zu den Ruinen von Loreth\'Aran entsendet hatte, und dass Ihr dem Team so gut es geht zur Seite steht.‡선구자 미콜라스가 로레스아란 폐허로 보낸 조사단을 찾아서 가능한 모든 도움을 주라고 부탁했습니다.‡El presagista Mikolaas quiere que encuentres al equipo de reconocimiento que había enviado a las Ruinas de Loreth\'Aran y les ayudes en todo lo que puedas.‡El presagista Mikolaas quiere que encuentres al equipo de reconocimiento que había enviado a las Ruinas de Loreth\'Aran y les ayudes en todo lo que puedas.‡Le messager Mikolaas veut que vous retrouviez l\'équipe d\'explorateurs qu\'il a envoyé dans les ruines de Loreth\'Aran, et que vous les aidiez de votre mieux.‡先行官米库拉斯希望你找到他派去洛雷萨兰废墟的测量小组，尽力帮助他们。‡通報者米可拉斯要你找到他派去羅薩倫廢墟的調查小組並盡力幫助他們。',
  }
},
[9621] = {
  {
    'Carta para Sylvana‡Посол к Орде‡Gesandter zur Horde‡사절로서 호드에 파견되다‡Enviado de la Horda‡Enviado de la Horda‡Emissaire auprès de la Horde‡部落的特使‡部落的使者',
    nil,
    'Leve a Carta de Lor\'themar Theron para a Grande Dama Sylvana Correventos na Cidade Baixa, a capital dos Renegados que fica nas Clareiras de Tirisfal.‡Отнесите письмо от Лор\'темара Терона леди Сильване Ветрокрылой в Подгород, столицу Отрекшихся в Тирисфальских лесах.‡Bringt den Brief von Lor\'themar Theron zu Fürstin Sylvanas Windläufer in Unterstadt, der Hauptstadt der Verlassenen in Tirisfal.‡티리스팔 숲에 위치한 포세이큰의 수도인 언더시티로 가서 여군주 실바나스 윈드러너에게 로르테마르 테론의 편지를 전해야 합니다.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Remettez la Lettre de Lor\'themar Theron à dame Sylvanas Coursevent à Fossoyeuse, la capitale des Réprouvés dans les clairières de Tirisfal.‡到提瑞斯法林地去，将洛瑟玛·塞隆的信交给被遗忘者的首都幽暗城中的希尔瓦娜斯·风行者。‡將來自洛索瑪·塞隆的信帶到幽暗城，提里斯法林地的被遺忘者首都給希瓦娜斯·風行者。',
  }
},
[9622] = {
  {
    'Leve a mensagem ao seu povo‡Предупреди свой народ‡Warnt vor der Gefahr‡총독 메넬라우스와의 대화‡Avisar a tu pueblo‡Avisar a tu pueblo‡Avertir votre peuple‡警告你的人民‡警告你的族人',
    nil,
    'Fale com o Exarca Menelaus no Entreposto Lazúli.‡Поговорите с экзархом Менелаусом на Лазурной заставе.‡Sprecht mit Exarch Menelaous bei der Azurwacht.‡하늘 감시초소에 있는 총독 메넬라우스와 대화해야 합니다.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Habla con el exarca Menelaous en la Avanzada Azur.‡Parlez à l\'exarque Menelaous au Guet d\'azur.‡与碧蓝岗哨的大主教梅内莱厄斯谈一谈。‡和藍色守望的主教米奈奧斯談談。',
  }
},
[9623] = {
  {
    'A maturidade‡Время пришло‡Reiferwerden‡시대의 부름‡Madurez‡Madurez‡Il est temps de grandir‡成年‡是時候了',
    nil,
    'O Exarca Menelaus, no Entreposto Lazúli, pediu que você entregasse as Ordens do Exarca a Toralius, o Tratador, do lado de fora da Exodar.‡Передайте распоряжения экзарха Тораллиусу Пастуху. Он находится у Экзодара, недалеко от входа.‡Exarch Menelaous bei der Azurwacht hat Euch gebeten, die Befehle des Exarchen zu Torallius dem Herdentreiber, der außerhalb der Exodar steht, zu bringen.‡하늘 감시초소에 있는 총독 메넬라우스가 엑소다르 밖에 서 있는 조련사 토랄리우스에게 총독의 명령서를 전해 달라고 부탁했습니다.‡El exarca Menelaous en la Avanzada Azur ha pedido que entregues las órdenes del exarca a Torallius el Controlador de la Manada que se encuentra a las afueras de El Exodar.‡El exarca Menelaous en la Avanzada Azur ha pedido que entregues las órdenes del exarca a Torallius el Controlador de la Manada que se encuentra a las afueras de El Exodar.‡L\'exarque Menelaous, du Guet d\'azur, veut que vous remettiez les Ordres de l\'exarque à Torallius le Pâtre, qui se trouve hors de l\'Exodar.‡碧蓝岗哨的大主教梅内莱厄斯要求你将主教的命令交给埃索达门外的象群管理者妥拉留斯。‡藍色守望的主教米奈奧斯要你將主教的命令送給『獸群管理者』托拉利斯，他就在艾克索達外面。',
  }
},
[9624] = {
  {
    'Regalo de elekk‡Любимое блюдо‡Lieblingsleckerli‡맛있는 모래배‡Un caprichito goloso‡Un caprichito goloso‡La meilleure des gâteries‡美味的点心‡最愛的一道菜',
    nil,
    'Aonar, da Travessia de Kessel, quer que você lhe traga 10 Peras Orientais.‡Принесите 10 песчаных груш Аонару в лагерь Кессела.‡Aonar bei Kessels Wegelager möchte, dass Ihr ihm 10 Sandbirnen bringt.‡케셀의 길목에 있는 아오나르가 모래배 10개를 가져다 달라고 부탁했습니다.‡Aonar de la Encrucijada de Kessel quiere que le lleves 10 peras de arena.‡Aonar de la Encrucijada de Kessel quiere que le lleves 10 peras de arena.‡Aonar, à la Croisée de Kessel, veut que vous lui rameniez 10 Poires des sables.‡凯希尔路口的奥纳尔希望你能帮他找到10个沙梨。‡凱索十字路的艾昂爾要你幫他帶來10顆沙梨。',
  }
},
[9625] = {
  {
    'Elekk é negócio sério‡Элекки – это серьезно‡Elekk sind starker Tobak‡엘레크 다루기‡Con los elekks no se bromea‡Con los elekks no se bromea‡On ne plaisante pas avec les elekk‡雷象可不是好玩的！‡伊萊克是嚴肅的職責',
    nil,
    'Fala com Vorkhan, o Pastor de Elekks, na Ilha Névoa Rubra.‡Поговорите с Ворканом Пастухом Элекков на острове Кровавой Дымки.‡Sprecht mit Vorkhan dem Elekktreiber auf der Blutmythosinsel.‡핏빛안개 섬에 있는 엘레크 조련사 보르칸에게 가야 합니다.‡Habla con Vorkhan el Pastor de elekks, en la Isla Bruma de Sangre.‡Habla con Vorkhan el Pastor de elekks, en la Isla Bruma de Sangre.‡Parlez à Vorkhan le berger des elekk sur l\'île de Brume-sang.‡与秘血岛的雷象管理者沃克汉谈一谈。‡和血謎島的『伊萊克牧者』渥卡恩談談。',
  }
},
[9626] = {
  {
    'Encontro com o Chefe Guerreiro‡Встреча с вождем‡Ein Treffen mit dem Kriegshäuptling‡대족장 알현‡Encuentro con el Jefe de Guerra‡Encuentro con el Jefe de Guerra‡Rencontrer le chef de guerre‡觐见酋长‡會見大酋長',
    nil,
    'A Grande Dama Sylvana Correventos quer que você leve a Carta Selada por Sylvana para Thrall em Orgrimmar, capital de Durotar.‡Отнесите письмо с печатью Леди Сильваны Ветрокрылой Траллу в Оргриммар, столицу Дуротара.‡Fürstin Sylvanas Windläufer möchte, dass Ihr den Brief mit Sylvanas\' Siegel zu Thrall nach Orgrimmar, Hauptstadt von Durotar, bringt.‡여군주 실바나스 윈드러너가 듀로타의 수도인 오그리마에 있는 스랄에게 실바나스의 인장이 찍힌 편지를 전해달라고 부탁했습니다.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas a Thrall en Orgrimmar, capital de Durotar.‡Lady Sylvanas Brisaveloz quiere que lleves la carta con su sello a Thrall en Orgrimmar, capital de Durotar.‡Dame Sylvanas veut que vous remettiez la Lettre scellée par Sylvanas à Thrall, à Orgrimmar, la capitale de Durotar.‡希尔瓦娜斯·风行者要求你将她的密信交给杜隆塔尔首都奥格瑞玛的萨尔。‡希瓦娜斯·風行者要你將希瓦娜斯蓋章的信帶給杜洛塔首都，奧格瑪的索爾。',
  }
},
[9627] = {
  {
    'Aliança à Horda!‡Верность Орде‡Treue gegenüber der Horde‡호드의 일원이 되다!‡Fidelidad a la Horda‡Fidelidad a la Horda‡L\'allégeance à la Horde‡部落的盟约‡效忠部落',
    nil,
    'Volte para Luaprata e apresente-se a Lor\'themar Theron.‡Возвращайтесь в Луносвет и поговорите с Лор\'темаром Тероном.‡Kehrt nach Silbermond zurück und erstattet Lor\'themar Theron Bericht.‡실버문으로 돌아가서 로르테마르 테론에게 보고해야 합니다.‡Vuelve a la Ciudad de Lunargenta y habla con Lor\'themar Theron.‡Vuelve a la Ciudad de Lunargenta y habla con Lor\'themar Theron.‡Retournez à Lune-d\'argent et allez faire votre rapport à Lor\'themar Theron.‡回到银月城，向洛瑟玛·塞隆复命。‡回到銀月城向洛索瑪·塞隆回報。',
  }
},
[9628] = {
  {
    'Recuperação de dados‡Цена знания – жизнь‡Bergung der Daten‡자료 회수‡Recuperar los datos‡Recuperar los datos‡Récupérer des données‡夺回数据‡搶回資料',
    nil,
    'Retome o Cristal de Dados da Expedição das nagas Escamódio próximas aos corpos dos cartógrafos e devolva-o para o emissário Mikolaas no Entreposto Rubro.‡Неподалеку от того места, где были убиты картографы, обитают наги из клана Зловещей Чешуи. Отберите у них кристалл с результатами наблюдений и доставьте его на Кровавую заставу предвестнику Миколаасу.‡Erlangt den Vermessungsdatenkristall von den Hasspranken nahe der toten Kartografen wieder und bringt ihn zu Herold Mikolaas bei der Blutwacht.‡죽은 지도제작자 근처에 성난비늘일족 나가에게서 관측 자료 수정을 찾아 핏빛 감시초소에 있는 선구자 미콜라스에게 가져가야 합니다.‡Consigue el cristal de datos de la expedición de la Escama de Cólera cerca de los cartógrafos muertos y regresa junto al presagista Mikolaas en la Avanzada de Sangre.‡Consigue el cristal de datos de la expedición de la Escama de Cólera cerca de los cartógrafos muertos y regresa junto al presagista Mikolaas en la Avanzada de Sangre.‡Récupérez le Cristal de données du relevé sur les nagas Irécailles près des cartographes morts et remettez-le au messager Mikolaas, au Guet du sang.‡从测量人员尸体附近的怒鳞纳迦手中夺回测量数据水晶，把它交给秘血岗哨的先行官米库拉斯。‡從死亡的製圖師附近的怒鱗身上取得勘察資料水晶，再帶回血色守望給通報者米可拉斯。',
  }
},
[9629] = {
  {
    'Pegar e soltar‡Поймать и отпустить‡Kurz geschnappt‡멀록 표시총‡Aquí te pillo, aquí te marco‡Aquí te pillo, aquí te marco‡Attraper... relâcher...‡研究鱼人‡標記魚人',
    nil,
    'Morae, no Entreposto Rubro, quer que você "marque" 6 Batedores Trevareia usando a Etiquetadora de Murloc.‡Морэ с Кровавой заставы просит вас "пометить" 6 разведчиков из племени Черного Ила при помощи маркировщика мурлоков.‡Morae bei der Blutwacht möchte, dass Ihr 6 Späher der Schwarzschlammküste mit einem Murlocsender \'markiert\'.‡핏빛 감시초소에 있는 모라에가 멀록 표시총을 사용하여 검은진흙멀록 정찰꾼 6마리에게 \'표시\'를 해 달라고 부탁했습니다.‡Morae, de la Avanzada de Sangre, quiere que \'marques\' a 6 exploradores Cienonegro con el hierro múrloc.‡Morae, de la Avanzada de Sangre, quiere que \'marques\' a 6 exploradores Cienonegro con el hierro múrloc.‡Morae, du Guet du sang, veut que vous « marquiez » 6 Eclaireurs Vase noir avec le Marqueur de murlocs.‡秘血岗哨的莫莱希望你用鱼人标记枪去"标记"6个黑沙斥候。‡血色守望的莫瑞伊要你使用魚人標示器「標記」6個黑沙斥候。',
  }
},
[9630] = {
  {
    'O Diário de Medivh‡Дневник Медива‡Medivhs Tagebuch‡메디브의 일지‡El diario de Medivh‡El diario de Medivh‡Le journal de Medivh‡麦迪文的日记‡麥迪文的日記',
    nil,
    'O Arquimago Alturus, na Trilha do Vento Morto, quer que você entre em Karazhan e fale com Wravien.‡По поручению верховного мага Альтура на Перевале Мертвого Ветра войдите в Каражан и поговорите с Вравьеном.‡Erzmagier Alturus am Gebirgspass der Totenwinde möchte, dass Ihr nach Karazhan geht und mit Wravien sprecht.‡죽음의 고개에 있는 대마법사 알투루스가 카라잔으로 가서 레비엔과 대화해 보라고 부탁했습니다.‡El archimago Alturus, del Paso de la Muerte, quiere que vayas a Karazhan y hables con Wravien.‡El archimago Alturus, del Paso de la Muerte, quiere que vayas a Karazhan y hables con Wravien.‡L’archimage Alturus, du défilé de Deuillevent, veut que vous entriez dans Karazhan et que vous parliez à Wravien.‡逆风小径的大法师奥图鲁斯要你进入卡拉赞，与拉维恩谈一谈。‡逆風小徑的大法師艾特羅斯要你進入卡拉贊並和瑞依恩談談。',
  }
},
[9631] = {
  {
    'Ajuda de uma colega‡Взаимовыручка‡Hilfe unter Kollegen‡동료의 도움‡La ayuda de una compañera‡La ayuda de una compañera‡L\'aide d\'une collègue‡同事的帮助‡朋友的協助',
    nil,
    'Leve o Fragmento de Osso Carbonizado para Kalynna Lathred na Área 52, que fica em Eternévoa.‡Доставьте фрагмент обугленной кости Калинне Латред в Зону 52 в Пустоверти.‡Bringt das verkohlte Knochenfragment zu Kalynna Lathred in Area 52 im Nethersturm.‡황천의 폭풍의 52번 구역에 있는 칼린나 나스레드에게 그을린 뼈 조각을 가져가야 합니다.‡Lleva el trozo de hueso carbonizado a Kalynna Lathrojo en el Área 52 en Tormenta Abisal.‡Lleva el trozo de hueso carbonizado a Kalynna Lathrojo en el Área 52 en Tormenta Abisal.‡Remettez le Fragment d\'os carbonisé à Kalynna Rougelatte, dans la Zone 52 de Raz-de-Néant.‡将焦骨碎块交给虚空风暴52区的卡琳娜·拉瑟德。‡將燒焦的白骨碎片帶給虛空風暴的凱娜·拉斯蕊德。',
  }
},
[9632] = {
  {
    'Aliados de última hora‡Новые союзники‡Neue Verbündete‡연합의 협력‡Aliados inesperados‡Aliados inesperados‡De nouveaux alliés‡新的盟友‡新找到的盟友',
    nil,
    'Entregue a Carta de Apresentação para a Caçadora Kella Arconyx na Ilha Névoa Lazúli.‡Доставьте рекомендательное письмо охотнице Келле Тетиве Ночи на Остров Лазурной Дымки.‡Bringt das Vorstellungsschreiben zu Jägerin Kella Nachtbogen auf die Azurmythosinsel.‡하늘안개 섬에 있는 여사냥꾼 켈라 나이트보우에게 소개장을 가져가야 합니다.‡Llévale la carta de presentación a la cazadora Kella Arconocturno en la Isla Bruma Azur.‡Llévale la carta de presentación a la cazadora Kella Arconocturno en la Isla Bruma Azur.‡Remettez la Lettre d\'introduction à la chasseresse Kella Arquenuit, à l\'Île de Brume-azur.‡将介绍信交给秘蓝岛的女猎手凯拉·夜弓。‡到藍謎島把介紹信交給女獵人凱拉·夜弓。',
  }
},
[9633] = {
  {
    'O caminho de Auberdine‡Дорога к Аубердину‡Der Weg nach Auberdine‡아우버다인으로의 여정‡Camino de Auberdine‡Camino de Auberdine‡En route pour Auberdine‡前往奥伯丁‡去奧伯丁的路',
    nil,
    'Pegue o barco no cais perto da Caçadora Kella Arconyx até Auberdine. Uma vez lá, leve a Carta de Apresentação a Trovejius Tecevento.‡Сядьте на корабль, идущий в Аубердин. Пристань находится неподалеку от дома охотницы Келлы Тетивы Ночи. В Аубердине отдайте рекомендательное письмо Тандрису Ветропряду.‡Nehmt das Schiff in der Nähe von Jägerin Kella Nachtbogen nach Auberdine. Bringt das Vorstellungsschreiben zu Thundris Windwirker, sobald Ihr in Auberdine angekommen seid.‡여사냥꾼 켈라 나이트보우 근처의 부두에서 배를 타고 아우버다인에 도착한 후, 툰드리스 윈드위버에게 소개장을 가져가야 합니다.‡Lleva el barco desde el embarcadero próximo a la cazadora Kella Arconocturno hasta Auberdine. Cuando llegues a Auberdine, lleva la carta de presentación a Thundris Tejevientos.‡Lleva el barco desde el embarcadero próximo a la cazadora Kella Arconocturno hasta Auberdine. Cuando llegues a Auberdine, lleva la carta de presentación a Thundris Tejevientos.‡Prenez le bateau pour Auberdine. Il part du quai qui se trouve près de la chasseresse Kella Arquenuit. Lorsque vous serez à Auberdine, présentez votre Lettre d\'introduction à Thundris Tissevent.‡在女猎手凯拉·夜弓附近的码头乘船去奥伯丁。到达奥伯丁后，将介绍信交给桑迪斯·织风。‡從靠近女獵人凱拉·夜弓的碼頭上搭船前往奧伯丁。等你到了奧伯丁，將介紹信拿給桑迪斯·織風。',
  }
},
[9634] = {
  {
    'Predadores alienígenas‡Чужие-хищники‡Raubtiere aus einer anderen Welt‡미지의 약탈자들‡Depredadores alienígenas‡Depredadores alienígenas‡Des prédateurs d\'outre-monde‡大战异型掠夺者‡外來掠奪者',
    nil,
    'Mate 10 Filhotes de Névoa Rubra e, em seguida, fale novamente com Vorkhan, o Pastor de Elekks, na Travessia de Kessel, que fica na Ilha Névoa Rubra.‡Убейте 10 детенышей опустошителя с острова Кровавой Дымки и вернитесь к Воркану Пастуху Элекков. Воркана можно найти на острове Кровавой Дымки в лагере Кессела.‡Tötet 10 junge Blutfelshetzer und kehrt danach zu Vorkhan dem Elekktreiber bei Kessels Wegelager auf der Blutmythosinsel zurück.‡새끼 핏빛안개 갈퀴발톱 10마리를 처치한 후 핏빛안개 섬의 케셀의 길목에 있는 엘레크 조련사 보르칸에게 돌아가야 합니다.‡Mata 10 proles de Bruma de Sangre y vuelve a hablar con Vorkhan el pastor de elekks en la Encrucijada de Kessel en la Isla Bruma de Sangre.‡Mata 10 proles Bruma de Sangre y vuelve a hablar con Vorkhan el pastor de elekks en la Encrucijada de Kessel en la Isla Bruma de Sangre.‡Tuez 10 Jeunes Brume-sang, puis retournez voir Vorkhan le berger des elekk à la Croisée de Kessel sur l\'île de Brume-sang.‡杀掉10个秘血幼崽，然后向秘血岛凯希尔路口的雷象管理者沃克汉复命。‡殺死10隻血謎幼蟲後回到血謎島的凱索十字路找『伊萊克牧者』渥卡恩。',
  }
},
[9635] = {
  {
    'O Extrator de Partículas Zapeacelera!‡Удаленный конденсатор выхлопов!‡Der schockdrosselnde Partikelextraktor!‡기압조절 가스 추출기‡¡El extractor de motas Zapacelerador!‡¡El extractor de motas Zapacelerador!‡L\'extracteur de granules Zappeur-Gazier !‡气阀微粒提取器！‡快速節流微粒吸取器!',
    nil,
    'Traga 15 Partes de Bomba a Vapor para o Mergulhador Mack em Zabra\'jin, no Pântano Zíngaro.‡Принесите 15 деталей парового насоса Маку Дайверу в Забра\'джин в Зангартопи.‡Bringt 15 Dampfpumpenteile zu Mack Dyver in Zabra\'jin in den Zangarmarschen.‡장가르 습지대의 자브라진에 있는 맥 다이버에게 증기 양수기 부품 15개를 가져가야 합니다.‡Llévale 15 piezas de bomba de vapor a Mack Diver en Zabra\'jin, en la Marisma de Zangar.‡Llévale 15 piezas de bomba de vapor a Mack Diver en Zabra\'jin, en la Marisma de Zangar.‡Apportez 15 Pièces détachées de la pompe à vapeur à Mack Diver, à Zabra\'jin dans le marécage de Zangar.‡将15个蒸汽泵零件交给赞加沼泽萨布拉金的马克·迪沃。‡帶15個蒸汽幫浦零件到贊格沼澤給薩布拉金的麥客·戴沃。',
  }
},
[9636] = {
  {
    'O Extrator de Partículas Zapeacelera!‡Удаленный конденсатор выхлопов!‡Der schockdrosselnde Partikelextraktor!‡기압조절 가스 추출기!‡¡El extractor de motas Zapacelerador!‡¡El extractor de motas Zapacelerador!‡L\'extracteur de granules Zappeur-Gazier !‡气阀微粒提取器！‡快速節流微粒吸取器!',
    nil,
    'Traga 15 Partes de Bomba a Vapor para K. Lee Smallfry em Telredor, no Pântano Zíngaro.‡Принесите 15 деталей парового насоса К. Ли Мелюзге в Телредор в Зангартопи.‡Bringt 15 Dampfpumpenteile zu K. Lee Kleinfrey in Telredor in den Zangarmarschen.‡장가르 습지대의 텔레도르에 있는 K. 리 스몰프라이에게 증기 양수기 부품 15개를 가져가야 합니다.‡Llévale 15 piezas de bomba de vapor a K. Lee Fritito en Telredor, en la Marisma de Zangar.‡Llévale 15 piezas de bomba de vapor a K. Lee Fritito en Telredor, en la Marisma de Zangar.‡Apportez 15 Pièces détachées de la pompe à vapeur à Manue Fretin, à Telredor dans le marécage de Zangar.‡将15个蒸汽泵零件交给赞加沼泽泰雷多尔的凯莉·弗莱。‡帶15個蒸汽幫浦零件到贊格沼澤給泰倫多爾的李小炸。',
  }
},
[9637] = {
  {
    'O pedido de Kalynna‡Требование Калинны‡Kalynnas Bitte‡칼린나의 부탁‡La petición de Kalynna‡La petición de Kalynna‡La requête de Kalynna‡卡琳娜的要求‡凱娜的要求',
    nil,
    'Kalynna Lathred quer que você recupere o Tomo de Crepúsculo do Grão-bruxo Maléter nos Salões Despedaçados, que ficam na Cidadela Fogo do Inferno, e também o Livro dos Nomes Esquecidos do Tecetrevas Syth nos Salões dos Sethekk, que ficam em Auchindoun.|n|nEssa missão deve ser completada no modo Heroico.‡Калинна Латред требует отыскать и принести ей фолиант сумерек и книгу забытых имен. Первой владеет главный чернокнижник Пустоклят, его можно найти в Разрушенных залах цитадели Адского Пламени. Вторая принадлежит заклинателю тьмы Ситу, который находится в Сетеккских залах в Аукиндоне.|n|nЭто задание должно быть выполнено на героическом уровне сложности.‡Kalynna Lathred möchte, dass Ihr den Dämmerfolianten vom Großhexenmeister Nethekurse in den Zerschmetterten Hallen der Höllenfeuerzitadelle und das Buch der vergessenen Namen von Dunkelwirker Syth in den Sethekkhallen in Auchindoun besorgt.|n|nIhr müsst diese Quest auf dem Schwierigkeitsgrad \'Heroisch\' abschließen.‡칼린나 나스레드가 지옥불 성채의 으스러진 손의 전당에 있는 대흑마법사 네더쿠르스로부터 어둠의 고서를, 아킨둔의 세데크 전당에 있는 흑마술사 시스에게서 잊혀진 이름의 고서를 되찾아 달라고 부탁했습니다.|n|n이 퀘스트는 던전 난이도를 영웅으로 설정한 후 수행해야 합니다.‡Kalynna Lathrojo quiere recuperar el Escrito del Ocaso del brujo supremo Malbisal en Las Salas Arrasadas de la Ciudadela del Fuego Infernal y el Libro de los Nombres Olvidados de Tejeoscuro Syth en las Salas Sethekk de Auchindoun.|n|nEsta misión debe ser completada en dificultad heroica.‡Kalynna Lathrojo quiere recuperar el Escrito del Ocaso del brujo supremo Malbisal en Las Salas Arrasadas de la Ciudadela del Fuego Infernal y el Libro de los Nombres Olvidados de Tejeoscuro Syth en las Salas Sethekk de Auchindoun.|n|nEsta misión debe ser completada en dificultad heroica.‡Kalynna Rougelatte veut que vous récupériez le Tome de la pénombre sur le Grand démoniste Néanathème dans la citadelle des Flammes infernales, et le Livre des noms oubliés sur le Tisseur d\'ombre Syth dans les salles des Sethekk à Auchindoun.|n|nCette quête doit être accomplie en mode de difficulté Héroïque.‡从地狱火堡垒破碎大厅的高阶术士奈瑟库斯手中夺得暮色魔典，从奥金顿塞泰克大厅的黑暗编织者塞斯手中夺得忘却之名，将它们交给卡琳娜·拉瑟德。|n|n该任务必须在英雄难度下完成。‡凱娜·拉斯蕊德要你到地獄火堡壘的破碎大廳，從大術士奈德克斯那裡取得黑暗之書，再到奧齊頓的塞司克大廳，從暗法師希斯那裡取得遺忘之名魔典。這個任務必須在英雄難度下完成。',
  }
},
[9638] = {
  {
    'Em boas mãos‡В хороших руках‡In guten Händen‡그라다브와의 대화‡En buenas manos‡En buenas manos‡En de bonnes mains‡书呆子‡妥善保管',
    nil,
    'Fale com Gradav na Biblioteca do Guardião, em Karazhan.‡Поговорите с Градавом в Библиотеке стража в Каражане.‡Sprecht mit Gradav in der Bibliothek des Wächters in Karazhan.‡카라잔의 수호자의 도서관에 있는 그라다브와 대화해야 합니다.‡Habla con Gradav en la Biblioteca del Guardián, en Karazhan.‡Habla con Gradav en la Biblioteca del Guardián, en Karazhan.‡Parler avec Gradav dans la Bibliothèque du gardien, à Karazhan.‡与卡拉赞守护者的图书馆中的格拉达夫谈一谈。‡到卡拉贊和守護者圖書館的葛瑞戴談談。',
  }
},
[9639] = {
  {
    'Kamsis‡Камсис‡Kamsis‡캄시스와의 대화‡Kamsis‡Kamsis‡Kamsis‡卡姆希丝‡康席斯',
    nil,
    'Fale com Kamsis na Biblioteca do Guardião, em Karazhan.‡Поговорите с Камсис в Библиотеке Стража в Каражане.‡Sprecht mit Kamsis in der Bibliothek des Wächters in Karazhan.‡카라잔의 수호자의 도서관에 있는 캄시스와 대화해야 합니다.‡Habla con Kamsis en la Biblioteca del Guardián, en Karazhan.‡Habla con Kamsis en la Biblioteca del Guardián, en Karazhan.‡Parler avec Kamsis dans la Bibliothèque du gardien, à Karazhan.‡与卡拉赞守护者的图书馆中的卡姆希丝谈一谈。‡到卡拉贊和守護者圖書館的康席斯談談。',
  }
},
[9640] = {
  {
    'O vulto de Aran‡Тень Арана‡Arans Schemen‡아란의 망령‡La sombra de Aran‡La sombra de Aran‡L\'ombre d\'Aran‡埃兰之影‡埃蘭之影',
    nil,
    'Obtenha o Diário de Medivh e fale novamente com Kamsis na Biblioteca do Guardião, em Karazhan.‡Достаньте дневник Медива и верните его Камсис в Библиотеку Стража в Каражане.‡Beschafft Medivhs Tagebuch und kehrt zu Kamsis in der Bibliothek des Wächters in Karazhan zurück.‡메디브의 일지를 얻은 후 카라잔의 수호자의 도서관에 있는 캄시스에게 돌아가야 합니다.‡Consigue el diario de Medivh y vuelve junto a Kamsis en la Biblioteca del Guardián, en Karazhan.‡Consigue el diario de Medivh y vuelve junto a Kamsis en la Biblioteca del Guardián, en Karazhan.‡Obtenez le Journal de Medivh et retournez voir Kamsis dans la Bibliothèque du Gardien de Karazhan.‡将麦迪文的日记交给卡拉赞守护者的图书馆中的卡姆希丝。‡取得麥迪文的日記並帶到卡拉贊的守護者圖書館交給康席斯。',
  }
},
[9641] = {
  {
    'Estilhaços de cristal irradiado‡Осколки облученного кристалла‡Bestrahlte Kristallsplitter‡오염에 노출된 수정 조각‡Fragmentos de cristal irradiado‡Fragmentos de cristal irradiado‡Les éclats de cristal irradié‡辐射水晶碎片‡受到輻射的水晶裂片',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você lhe traga 10 Estilhaços de Cristal Irradiado.‡Принесите 10 осколков облученного кристалла воздаятелю Боросу на Кровавую заставу.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr ihm 10 bestrahlte Kristallsplitter bringt.‡핏빛 감시초소에 있는 구원자 보로스가 오염에 노출된 수정 조각 10개를 가져다 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quiere que le lleves diez fragmentos de cristal radioactivo.‡El vindicador Boros de la Avanzada de Sangre quiere que le lleves diez fragmentos de cristal radioactivo.‡Le redresseur de torts Boros du Guet du sang veut que vous lui apportiez 10 Éclats de cristal irradiés.‡秘血岗哨的守备官波鲁斯希望你帮他收集10块辐射水晶碎片。‡血色守望的復仇者波羅斯要你幫他帶來10個受到輻射的水晶裂片。',
  }
},
[9642] = {
  {
    'Mais estilhaços de cristal irradiado‡И снова облученные кристаллы‡Mehr bestrahlte Kristallsplitter‡오염에 노출된 수정 조각 추가 수집‡Más fragmentos de cristal irradiado‡Más fragmentos de cristal irradiado‡Encore des éclats de cristal irradié‡更多辐射水晶碎片‡更多受到輻射的水晶裂片',
    nil,
    nil,
  }
},
[9643] = {
  {
    'Ô trepadeira danada!‡Удушающая лоза‡Würgeranken‡가시 돋친 덩굴손 줄기‡Parras constrictoras‡Parras constrictoras‡Les lianes étrangleuses‡荆棘巨藤‡蟒藤',
    nil,
    'O Rastreador Lyceon, do Entreposto Rubro, quer que você entregue 6 Trepadeiras Espinhosas Constritoras para ele.‡Принесите зверолову Лисеону 6 побегов колючей удушающей лозы.‡Fährtenleser Lyceon bei der Blutwacht möchte, dass Ihr ihm 6 dornige Würgeranken bringt.‡핏빛 감시초소에 있는 추적자 리시온이 가시 돋친 덩굴손 줄기 6개를 가져다 달라고 부탁했습니다.‡El rastreador Lyceon en la Avanzada de Sangre quiere que le lleves 6 parras constrictoras espinosas.‡El rastreador Lyceon en la Avanzada de Sangre quiere que le lleves 6 parras constrictoras espinosas.‡Le pisteur Lyceon, du Guet du sang, veut que vous lui rameniez 6 Lianes étrangleuses épineuses.‡秘血岗哨的追踪者兰塞恩希望你帮他收集6根荆棘巨藤。‡血色守望的追蹤者萊希安要你幫他帶來6個多刺的蟒藤。',
  }
},
[9644] = {
  {
    'Nocturno‡Ночная Погибель‡Schrecken der Nacht‡파멸의 어둠‡Nocturno‡Nocturno‡Plaie-de-nuit‡夜之魇‡夜禍',
    nil,
    'Vá até o Terraço do Mestre em Karazhan e toque a Urna Enegrecida para evocar Nocturno. Recupere a Essência Arcana Enfraquecida do cadáver de Nocturno e leve-a para o Arquimago Alturus.‡Ступайте на террасу Мастера в Каражане и прикоснитесь к урне Калинны, чтобы призвать Ночную Погибель. Извлеките из тела Ночной Погибели слабую чародейскую сущность и доставьте ее верховному магу Альтуру.‡Geht zur Terrasse des Meisters in Karazhan und berührt die geschwärzte Urne, um den Schrecken der Nacht zu rufen. Entzieht dem Körper des Schreckens die schwache arkane Essenz und bringt sie zu Erzmagier Alturus.‡카라잔에 있는 주인의 테라스로 간 후 어둠의 단지를 만져 파멸의 어둠을 소환한 후, 파멸의 어둠의 시체에서 희미한 비전 정수를 되찾은 후 대마법사 알투루스에게 가져가야 합니다.‡Ve a El Bancal del Maestro en Karazhan y usa la urna ennegrecida para invocar a Nocturno. Recupera la esencia arcana intangible del cadáver de Nocturno y llévasela al archimago Alturus.‡Ve a El Bancal del Maestro en Karazhan y usa la urna ennegrecida para invocar a Nocturno. Recupera la esencia arcana intangible del cadáver de Nocturno y llévasela al archimago Alturus.‡Allez sur la Terrasse du Maître à Karazhan et utilisez l\'Urne noircie pour invoquer Plaie-de-nuit. Récupérez l\'Essence arcanique voilée sur le cadavre de Plaie-de-nuit, et rapportez-la à l\'archimage Alturus.‡进入卡拉赞的主宰的露台，碰触黑色骨灰，召唤夜之魇并杀死它，然后从夜之魇的尸体上取得暗淡的奥术精华，并将它交给大法师奥图鲁斯。‡前往卡拉贊大師的露臺並碰觸燻黑的骨灰甕來召喚夜禍。從夜禍的屍體取得微弱的秘法精華並帶給大法師艾特羅斯。',
  }
},
[9645] = {
  {
    'O Terraço do Mestre‡Терраса Мастера‡Die Terrasse des Meisters‡주인의 테라스‡El Bancal del Maestro‡El Bancal del Maestro‡La terrasse du Maître‡主宰的露台‡大師的露臺',
    nil,
    'Vá até o Terraço do Mestre em Karazhan e leia o Diário de Medivh. Volte ao Arquimago Alturus com o Diário de Medivh depois de completar a tarefa.‡Поднимитесь на террасу Мастера в Каражане и прочитайте дневник Медива. После этого возвращайтесь вместе с дневником к верховному магу Альтуру.‡Geht zur Terrasse des Meisters in Karazhan und lest Medivhs Tagebuch. Kehrt danach mit Medivhs Tagebuch zu Erzmagier Alturus zurück.‡카라잔에 있는 주인의 테라스로 가서 메디브의 일지를 읽은 후 메디브의 일기를 가지고 대마법사 알투루스에게 돌아가야 합니다.‡Ve a El Bancal del Maestro en Karazhan y lee el diario de Medivh. Regresa junto al archimago Alturus con el diario de Medivh después de completar esta tarea.‡Ve a El Bancal del Maestro en Karazhan y lee el diario de Medivh. Regresa junto al archimago Alturus con el diario de Medivh después de completar esta tarea.‡Allez sur la terrasse du Maître à Karazhan et lisez le Journal de Medivh. Retournez auprès de l\'archimage Alturus avec le Journal de Medivh lorsque vous aurez accompli cette tâche.‡进入卡拉赞的主宰的露台，阅读麦迪文的日记。完成任务后将麦迪文的日记交给大法师奥图鲁斯。‡前往卡拉贊的大師的露臺並閱讀麥迪文的日記。完成任務後帶著麥迪文的日記回到大法師艾特羅斯那裡。',
  }
},
[9646] = {
  {
    'PROCURA-SE: Garra da Morte‡РАЗЫСКИВАЕТСЯ: Коготь Смерти‡GESUCHT: Todespranke‡현상 수배: 죽음의 발톱‡SE BUSCA: Garraletal‡SE BUSCA: Garraletal‡Avis de recherche : Griffe-de-mort‡通缉：死爪‡懸賞:死亡之爪',
    nil,
    'Entregue a Pata do Garra da Morte para o Emissário Mikolaas na Ilha Névoa Rubra.‡Принесите лапу Когтя Смерти предвестнику Миколаасу на Кровавую заставу.‡Bringt Todesprankes Tatze zu Herold Mikolaas bei der Blutwacht.‡핏빛 감시초소에 있는 선구자 미콜라스에게 죽음의 발톱 앞발을 가져가야 합니다.‡Lleva la garra de Garraletal al presagista Mikolaas en la Avanzada de Sangre.‡Lleva la garra de Garraletal al presagista Mikolaas en la Avanzada de Sangre.‡Apportez la Patte de Griffe-de-mort au Messager Mikolaas au Guet du sang.‡将死爪的爪子交给秘血岗哨的先行官米库拉斯。‡將死亡之爪的爪子帶給血色守望的通報者米可拉斯。',
  }
},
[9647] = {
  {
    'Cortar as asinhas‡Ловля бражников‡Ausmerzen der Falter‡나방의 공격성‡Sacrificar a los aleteadores‡Sacrificar a los aleteadores‡Réduire les bruissements‡消灭巨蛾‡撲殺翼蛾',
    nil,
    'O Rastreador Lyceon, do Entreposto Rubro, quer que você entregue 10 Esvoaçantes-reais Azuis para ele.‡Зверолов Лисеон просит убить 10 царственных синих бражников.‡Fährtenleser Lyceon bei der Blutwacht möchte, dass Ihr 10 königsblaue Falter tötet.‡핏빛 감시초소에 있는 추적자 리시온이 푸른날개 황제나방 10마리를 처치해 달라고 부탁했습니다.‡El rastreador Lyceon en la Avanzada de Sangre quiere que mates 10 aleteadores azul real.‡El rastreador Lyceon en la Avanzada de Sangre quiere que mates 10 aleteadores azul real.‡Le pisteur Lyceon au Guet du sang veut que vous tuiez 10 Virevolteurs bleus royaux.‡秘血岗哨的追踪者兰塞恩要你杀掉10只鲜艳的蓝翼巨蛾。‡血色守望的追蹤者萊希安要你殺死10隻皇家藍翼蛾。',
  }
},
[9648] = {
  {
    'Sem emoção, não tem graça‡Грибная похлебочка Матпарма‡Pilzsammlung von Maatparm‡버섯쟁이 마아트팜‡La colección de champiñones de Maatparm‡La colección de champiñones de Maatparm‡Ménagerie mycologique de Maatparm‡玛特帕尔姆蘑菇展‡馬特龐野生蘑菇',
    nil,
    'Maatparm, do Entreposto Rubro, quer que você lhe traga 1 Cornofétido Aquático, 1 Cogumelo de Sangue, 1 Polísporo Ruinoso e 1 Fungo Conífero Vil.‡Матпарм просит принести ему на Кровавую заставу по одному экземпляру водянистого смрадорога, кровавого гриба, губительной полиспоры и конусовидной поганки.‡Maatparm bei der Blutwacht möchte 1 Wasserstinkmorchel, 1 Blutpilz, 1 ruinösen Birkensporling und 1 Teufelszapfenfungus.‡핏빛 감시초소에 있는 마아트팜이 고린뿔물버섯, 피버섯, 파멸의 버섯, 지옥방울버섯을 각각 1개씩 가져다 달라고 부탁했습니다.‡Maatparm, que está en la Avanzada de Sangre, quiere 1 cuernohediondo acuático, 1 champiñón sanguino, 1 poliespora ruinosa y 1 hongo de bellota vil.‡Maatparm en la Avanzada de Sangre quiere 1 cuernohediondo acuático, 1 champiñón sanguino, 1 poliespora ruinosa y 1 hongo de bellota vil.‡Maatparm au Guet du sang veut 1 Satyre puant aquatique, 1 Champignon de sang, 1 Polypore des ruines et 1 Collybie gangrenée.‡秘血岗哨的玛特帕尔姆希望你找到一个水生臭角菇、一个血蘑菇、一个致命孢子簇和一个邪锥蘑菇。‡血色守望的馬特龐要1個水生惡菌菇，1個血色蘑菇，1個有害的孢子群，和1個魔錐果真菌。',
  }
},
[9649] = {
  {
    'Lágrimas de Ysera‡Слеза Изеры‡Yseras Tränen‡이세라의 눈물‡Las lágrimas de Ysera‡Las lágrimas de Ysera‡Les larmes d\'Ysera‡伊瑟拉之泪‡伊瑟拉之淚',
    nil,
    'Maatparm, do Entreposto Rubro, quer que você lhe traga 2 Lágrimas de Ysera.‡Матпарм просит принести ему на Кровавую заставу 2 экземпляра Слезы Изеры.‡Maatparm bei der Blutwacht möchte 2 Yseras Tränen.‡핏빛 감시초소에 있는 마아트팜이 이세라의 눈물 2개를 가져다 달라고 부탁했습니다.‡Maatparm, que está en la Avanzada de Sangre, quiere 2 lágrimas de Ysera.‡Maatparm en la Avanzada de Sangre quiere 2 lágrimas de Ysera.‡Maatparm au Guet du sang veut 2 Larmes d’Ysera.‡秘血岗哨的玛特帕尔姆希望你找到2个伊瑟拉之泪。‡血色守望的馬特龐要2個伊瑟拉之淚。',
  }
},
[9663] = {
  {
    'A maratona de Kessel‡Дуга Кессела‡Der Korsallauf‡케셀의 부탁‡La carrera de Kessel‡La carrera de Kessel‡La tournée de Kessel‡凯希尔的信使‡幫凱索的忙',
    nil,
    'Kessel, da Travessia de Kessel, quer que você alerte o Chefe Supremo Pinhoquieto na Aldeia de Pinhoquieto, o Exarca Menelaus no Entreposto Lazúli e o Almirante Odisseu no Assentamento de Odisseu sobre a iminente invasão dos elfos sangrentos. Em seguida, fale novamente com Kessel. Você tem 15 minutos para terminar a tarefa. (Mantenha o elekk fora d\'água.)‡Сообщите верховному вождю племени Тихвой, экзарху Менелаусу и адмиралу Одиссию о готовящемся вторжении эльфов крови, а затем возвратитесь к Кесселу. У вас есть 15 минут. Элекка следует держать подальше от воды.‡Kessel bei Kessels Wegelager möchte, dass Ihr den Oberhäuptling der Tannenruhfeste, Exarch Menelaous bei der Azurwacht und Admiral Odesyus bei Odesyus\' Ankerplatz vor der unmittelbar bevorstehenden Blutelfeninvasion warnt. Ihr habt 15 Minuten. Kehrt anschließend zu Kessel zurück. Denkt daran, dass Elekks wasserscheu sind!‡케셀의 길목에 있는 케셀이 너울소나무 요새에 있는 대족장 너울소나무, 하늘 전초기지에 있는 총독 메넬라우스, 오디시우스의 정박지에 있는 제독 오디시우스에게 블러드 엘프의 공격이 임박했다는 사실을 전해 달라고 부탁했습니다. 엘레크가 물에 닿지 않도록 하여 15분 안에 소식을 전달한 후 케셀에게 돌아가야 합니다.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que avises al gran jefe Semprepino del Bastión Semprepino, al exarca Menelaous de la Avanzada Azur y al almirante Odesyus del Desembarco de Odesyus sobre la inminente invasión de los elfos de sangre. Tienes 15 minutos. Regresa junto a Kessel cuando hayas completado esta tarea. (Asegúrate de que no toque el agua).‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que avises al gran jefe Semprepino del Bastión Semprepino, al exarca Menelaous de la Avanzada Azur y al almirante Odesyus del Desembarco de Odesyus sobre la inminente invasión de los elfos de sangre. Tienes 15 minutos. Regresa junto a Kessel cuando hayas completado esta tarea. (Asegúrate de que no toque el agua).‡Kessel, à la croisée de Kessel, veut que vous alliez prévenir de l\'invasion imminente des elfes de sang le Grand chef Calmepin au repaire des Calmepins, l\'Exarque Menelaous au Guet d\'azur et l\'Amiral Odesyus au Point d\'accostage d\'Odesyus. Revenez voir Kessel lorsque vous aurez terminé cette tâche. Vous avez 15 minutes. (Attention à ne pas aller dans l\'eau.)‡凯希尔路口的凯希尔要你把血精灵即将入侵的消息通知给止松要塞的止松老酋长、碧蓝岗哨的大主教梅内莱厄斯和奥德修斯营地的海军上将奥德修斯。你只有15分钟的时间。（记住让雷象远离水体。）‡凱索十字路的凱索要你去警告靜松要塞的大酋長靜松，藍色守望的主教米奈奧斯，和奧迪席斯平臺的艦隊司令·奧迪席斯關於血精靈即將發動的攻擊。完成任務後回到凱索那裡。你只有15分鐘。',
  }
},
[9664] = {
  {
    'Novos postos avançados‡Новые форпосты‡Mehr Befestigungen‡새로운 전초기지 건설‡Nuevas avanzadas‡Nuevas avanzadas‡Fonder de nouveaux avant-postes‡建立新据点‡建立新前哨',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Barbabranca, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и вернитесь к посланнику Белобороду в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Weißbart bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑, 역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 화이트비어드에게 돌아가야 합니다.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Barbablanca en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d\'est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l\'est. Revenez ensuite voir l\'émissaire Blanchebarbe à la Chapelle de l\'Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的白须大使复命。‡佔領東瘟疫之地的皇冠哨塔，東牆之塔，北地哨塔和病木林哨塔，再回到聖光之願禮拜堂的密使·白鬚那裡。',
  }
},
[9665] = {
  {
    'Reforçando nossas defesas‡Укрепим оборону‡Verstärkung der Verteidigung‡방어선 강화‡Fortalecimiento de nuestras defensas‡Fortalecimiento de nuestras defensas‡Renforcer nos défenses‡加强防御‡增強防禦',
    nil,
    'Capture a Torre da Coroa, a Torre da Muralha Leste, a Torre do Passo Norte e a Torre do Bosque Pestilento, nas Terras Pestilentas Orientais, depois fale novamente com o Emissário Gormok, na Capela Esperança da Luz.‡Захватите башню Королевской Стражи, Восточную башню, Башню Северного перевала и башню Проклятого леса в Восточных Чумных землях и возвращайтесь к посланнику Гормоку в Часовню Последней Надежды.‡Erobert den Turm der Kronenwache, den Ostwallturm, den Nordpassturm und den Pestwaldturm in den östlichen Pestländern. Kehrt anschließend zum Abgesandten Gormok bei der Kapelle des hoffnungsvollen Lichts zurück.‡동부 역병지대에 있는 산마루 경비탑, 동부방벽 경비탑, 북부관문 경비탑,  역병의 숲 경비탑을 점령한 다음 희망의 빛 예배당에 있는 사절 고르목에게 돌아가십시오.‡Captura la Torre de la Guardia de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Captura la Torre de la Corona, la Torre de la Muralla del Este, la Torre del Paso Norte y la Torre del Bosque de la Peste en las Tierras de la Peste del Este. Tras hacerlo, regresa y habla con el Emisario Gormok en la Capilla de la Esperanza de la Luz.‡Capturez la Tour de la garde de la couronne, la Tour du Mur d\'est, la Tour du Col du nord et la Tour de Pestebois dans les Maleterres de l\'est. Revenez ensuite voir l\'émissaire Gormok à la Chapelle de l\'Espoir de Lumière.‡夺取东瘟疫之地的皇冠哨塔、东墙哨塔、北地哨塔和病木林哨塔，然后向圣光之愿礼拜堂的高莫克大使复命。‡佔領東瘟疫之地的皇冠哨塔，東牆之塔，北地哨塔和病木林哨塔，再回到聖光之願禮拜堂的密使·戈莫克那裡。',
  }
},
[9666] = {
  {
    'Declaração de poder‡Демонстрация силы‡Machtdemonstration‡힘의 경고‡Declaración de poder‡Declaración de poder‡Déclaration de puissance‡展示力量‡宣示力量',
    nil,
    'Kessel, da Travessia de Kessel, que fica na Ilha Névoa Rubra, quer que você mate o Lorde Xiz no Covil dos Escamódios e enfie o Estandarte Draenei no cadáver.‡Проникните в логово клана Зловещей Чешуи, убейте лорда Ксиза и пронзите его тело древком дренейского знамени.‡Kessel bei Kessels Wegelager auf der Blutmythosinsel möchte, dass Ihr Lord Xiz bei der Hassprankenzuflucht tötet und das Banner der Draenei durch seinen Körper stoßt.‡핏빛안개 섬의 케셀의 길목에 있는 케셀이 성난비늘 둥지에 있는 군주 시즈를 처치한 후, 그의 시체에 드레나이 깃발을 꽂아 달라고 부탁했습니다.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que mates a Lord Xiz, de la Guarida Escama de Cólera, y atravieses su cadáver con el estandarte draenei.‡Kessel de la Encrucijada de Kessel, en la Isla Bruma de Sangre, quiere que mates a Lord Xiz, de la Guarida Escama de Cólera, y atravieses su cadáver con el estandarte draenei.‡Sur ordre de Kessel, à la Croisée de Kessel sur l\'Île de Brume-sang, allez tuer le Seigneur Xiz au Repaire des Irécailles et plantez la Bannière draeneï sur son cadavre.‡秘血岛凯希尔路口的凯希尔要你杀掉怒鳞巢穴的克希兹领主，并将德莱尼军旗插在他的尸体上。‡血謎島，凱索十字路的凱索要你殺了怒鱗巢穴的希司領主，並將德萊尼旌旗插入他的屍體。',
  }
},
[9667] = {
  {
    'O resgate da Princesa Pinhoquieto‡Спасение принцессы Тихвой‡Rettet die Prinzessin der Tannenruhfeste‡공주 너울소나무 구출‡Salvar a la princesa Semprepino‡Salvar a la princesa Semprepino‡Il faut sauver la princesse Calmepin‡拯救止松公主‡拯救靜松公主',
    nil,
    'Liberte a Princesa Pinhoquieto da jaula e, em seguida, fale com o Embaixador de Pinhoquieto Olorg no Entreposto Rubro.|n|nÉ preciso matar o Chefe Supremo Ericerdo para pegar a chave que abre a jaula.‡Выпустите принцессу Тихвою из клетки, а затем найдите на Кровавой заставе посла племени Тихвой Олорга и поговорите с ним.|n|nЧтобы раздобыть ключ от клетки, убейте верховного вождя племени Косолапов.‡Befreit die Prinzessin der Tannenruhfeste aus ihrem Käfig und sprecht anschließend mit Botschafter Olorg der Tannenruhfeste bei der Blutwacht.|n|nIhr müsst den Oberhäuptling der Sichelklauen töten, um an den Schlüssel für den Käfig zu gelangen.‡공주 너울소나무를 철장에서 구해낸 후 핏빛 감시초소에 있는 너울소나무일족 대사 올로그와 대화해야 합니다.|n|n그녀를 구하려면 대족장 뾰족가지를 처치하고 열쇠를 얻어야 합니다.‡Libera a la Princesa Semprepino de su jaula y habla después con el embajador Semprepino Olorg, en la Avanzada de Sangre.|n|nTienes que matar al Gran Jefe Brazolanudo para conseguir la llave de la jaula.‡Libera a la Princesa Semprepino de su jaula y habla después con el embajador Semprepino Olorg, en la Avanzada de Sangre.|n|nTienes que matar al gran jefe Erizapúas para conseguir la llave de la jaula.‡Faites sortir la Princesse Calmepin de sa cage, puis allez parler à l’ambassadeur calmepin Olorg au Guet du sang.|n|nVous devez tuer le Grand chef Bras-hirsute pour obtenir la clé qui ouvre la cage.‡将止松公主救出牢笼，然后与秘血岗哨的止松大使欧罗尔格谈一谈。|n|n你必须杀掉刺臂酋长才能拿到牢笼的钥匙。‡釋放囚禁在籠子裡的靜松公主後與血色守望的靜松大使歐洛格談談。|n|n你得殺掉大酋長鬚肢才能得到籠子的鑰匙。',
  }
},
[9668] = {
  {
    'Apresente-se ao exarca Admetius‡Доклад экзарху Адметиусу‡Erstattet Exarch Admetius Bericht‡총독 애드미티우스에게 보고‡Informar al exarca Admetius‡Informar al exarca Admetius‡Rapport à l\'exarque Admetius‡向主教埃德门图斯报告‡向主教阿德密特斯回報',
    nil,
    'Fale com o Exarca Admetius no Entreposto Rubro.‡Поговорите с экзархом Адметиусом на Кровавой заставе.‡Sprecht mit Exarch Admetius bei der Blutwacht.‡핏빛 감시초소에 있는 총독 애드미티우스와 대화해야 합니다.‡Habla con el exarca Admetius en la Avanzada de Sangre.‡Habla con el exarca Admetius en la Avanzada de Sangre.‡Parlez à l\'Exarque Admetius au Guet du sang.‡与秘血岗哨的主教埃德门图斯谈一谈。‡和血色守望的主教阿德密特斯談談。',
  }
},
[9669] = {
  {
    'A expedição desaparecida‡Пропавшая экспедиция‡Forschungsreise in den Tod‡실종된 연구단‡La expedición desaparecida‡La expedición desaparecida‡L\'expédition disparue‡覆灭的远征队‡失蹤的遠征隊',
    nil,
    'Mate 8 Tecelãs das Brumas, 8 Sangra-brumas e a líder das aranhas, Zarakh. Fale novamente com Achelus no Entreposto Rubro quando terminar a tarefa.‡Убейте 8 пауков-ткачих, 8 паучих-кровопийц и матриарха пауков – Зарак. По завершении задания вернитесь на Кровавую заставу к Акелусу.‡Tötet 8 Mythosspinner, 8 Mythosfänger und ihre Anführerin Zarakh. Kehrt anschließend zu Achelus bei der Blutwacht zurück.‡안개 그물거미 8마리, 안개 흡혈거미 8마리, 우두머리인 자라크를 처치한 후 핏빛 감시초소에 있는 아켈루스에게 돌아가야 합니다.‡Mata 8 brumahiladoras, 8 brumasanguijuela y a su líder, Zarakh. Vuelve a ver a Achelus en la Avanzada de Sangre cuando hayas completado la tarea.‡Mata 8 hiladoras de bruma, 8 parasitadoras de bruma y a su líder, Zarakh. Vuelve a ver a Achelus en la Avanzada de Sangre cuando hayas completado la tarea.‡Tuez 8 Tisseuses de brume, 8 Sangsues de brume et leur chef Zarakh. Revenez voir Achelus au Guet du sang quand votre mission sera achevée.‡杀掉8个秘网编织者、8个秘网吸血者和它们的首领萨拉肯。任务完成后向秘血岗哨的阿彻鲁斯复命。‡殺死8隻謎霧紡紗者，8隻謎霧吸血者和他們的領導者，沙拉克。任務完成後回到血色守望找阿奇拉斯。',
  }
},
[9670] = {
  {
    'Estão todos vivos! Ou não...‡Они живы! Может быть...‡Sie leben! Vielleicht...‡생존자 구출‡¡Viven! A lo mejor...‡¡Viven! A lo mejor...‡Ils sont vivants ! Peut-être...‡他们还活着！也许......‡他們還活著!或許吧……',
    nil,
    'O Pesquisador Cornelius quer que você liberte 5 Pesquisadores da Expedição.‡Освободите 5 ученых экспедиции по просьбе ученого Корнелиуса.‡Forscher Cornelius hat Euch darum gebeten, 5 Expeditionsforscher zu befreien.‡연구원 코르넬리우스가 원정대 연구원 5명을 구해 달라고 부탁했습니다.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡Le Chercheur Cornelius vous a demandé de libérer 5 Chercheurs de l\'expédition.‡研究员考内留斯要你救出5个远征队研究员。‡研究員卡尼勒斯要你救出5個遠征隊研究員。',
  }
},
[9671] = {
  {
    'Entrega urgente‡Срочная доставка‡Dringende Nachricht‡긴급 배달‡Entrega urgente‡Entrega urgente‡Une livraison urgente‡紧急信件‡緊急送件',
    nil,
    nil,
  }
},
[9672] = {
  {
    'O Almirante Negro‡Наследие Проклятой Крови‡Das Vermächtnis des Blutfluchs‡핏빛저주의 유산‡El legado de la Sangre Maldita‡El legado de la Sangre Maldita‡L\'héritage du sang maudit‡血咒的遗产‡血咒遺產',
    nil,
    'O Almirante Odisseu pediu para você encontrar e falar com o Capitão Cândido João.‡Адмирал Одиссий просит разыскать капитана Эдварда Хейнса и поговорить с ним.‡Admiral Odesyus hat Euch gebeten, nach Kapitän Edward Hanes zu suchen und mit ihm zu sprechen.‡제독 오디시우스가 선장 에드워드 헤인즈를 찾아서 대화해 보라고 부탁했습니다.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡L\'amiral Odesyus vous a demandé de trouver le capitaine Edward Hanes et de lui parler.‡海军上将奥德修斯要你找到艾德华·汉斯船长，然后与他谈一谈。‡艦隊司令·奧迪席斯要你找到隊長艾德華·漢尼斯並和他談談。',
  }
},
[9673] = {
  {
    'Beast Training‡Дрессировка‡Wildtierausbildung‡야수 길들이기‡Doma de bestias‡Doma de bestias‡La formation de dresseur‡训练野兽‡野獸訓練',
    nil,
    'Fale com Halthenis em Luaprata.‡Поговорите с Хальтенисом в Луносвете.‡Sprecht mit Halthenis in Silbermond.‡실버문에 있는 할데니스와 대화해야 합니다.‡Ve a la Ciudad de Lunargenta y habla con Halthenis.‡Ve a la Ciudad de Lunargenta y habla con Halthenis.‡Parlez à Halthenis à Lune-d\'argent.‡与银月城的哈森尼斯谈一谈。‡和銀月城的海德尼斯談談。',
  }
},
[9674] = {
  {
    'As nagas Sangue Maldito‡Проклятые наги‡Die Naga des Blutfluchs‡핏빛저주에 걸린 나가‡Los nagas Sangre Maldita‡Los nagas Sangre Maldita‡Les nagas au sang maudit‡血咒纳迦‡血咒納迦',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você mate 10 Nagas Sangue Maldito.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит убить 10 наг с острова Проклятой Крови.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr 10 Naga des Blutfluchs tötet.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 핏빛저주에 걸린 나가 10마리를 처치해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que mates a 10 nagas Sangre Maldita.|n‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que mates a 10 nagas Sangre Maldita.|n‡Le capitaine Edward Hanes, sur l\'île Balafre-du-ver, veut que vous tuiez 10 Nagas du sang maudit.‡龙痕岛的艾德华·汉斯船长要你杀掉10个血咒纳迦。‡龍痕島的隊長艾德華·漢尼斯要你殺死10個血咒納迦。',
  }
},
[9675] = {
  {
    'Beast Training‡Дрессировка‡Wildtierausbildung‡가나르와의 대화‡Doma de bestias‡Doma de bestias‡La formation de dresseur‡野兽训练‡野獸訓練',
    nil,
    'Fale com Ganaar no Setor Comercial da Exodar.‡Поговорите с Ганааром в Торговом ряду Экзодара.‡Sprecht mit Ganaar bei der Händlertreppe der Exodar.‡엑소다르의 교역 지구에 있는 가나르와 대화해야 합니다.‡Habla con Ganaar en La Grada de los Mercaderes de El Exodar.‡Habla con Ganaar en La Grada de los Mercaderes de El Exodar.‡Parlez à Ganaar à l\'Étage des commerces de l\'Exodar.‡与埃索达贸易阶梯内的甘纳尔谈一谈。‡到艾克索達的貿易區和加納談談。',
  }
},
[9676] = {
  {
    'Treinamento de paladino‡Наставник паладинов‡Ausbildung zum Paladin‡성기사 훈련‡Instrucción de paladín‡Instrucción de paladín‡La formation du paladin‡圣骑士训练‡聖騎士訓練',
    nil,
    'Fale com o instrutor de paladinos Jesthenis Golpessol na Torre do Sol, que fica na Ilha Andassol.‡Поговорите с наставником паладинов Джестенисом Солнцесветом в Солнечном Шпиле на острове Солнечного Скитальца.‡Sprecht mit Jesthenis Sonnensturm - dem Paladinlehrer - im Sonnenturm auf der Insel der Sonnenwanderer.‡선스트라이더 섬의 태양 첨탑 안에 있는 상급 성기사 제스테니스 선스트라이커와 대화해야 합니다.‡Habla con Jesthenis Golpesol, el instructor de clase de paladines, en La Aguja del Sol en la Isla del Caminante del Sol.‡Habla con Jesthenis Golpesol, el instructor de clase de paladines, en La Aguja del Sol en la Isla del Caminante del Sol.‡Parlez à Jesthenis Heurtesoleil, le maître des paladins, à l\'intérieur de la Flèche solaire, sur l\'île de Haut-soleil.‡与逐日岛太阳之塔内的圣骑士训练师耶泰尼斯-射日者谈一谈。‡和傑斯賽尼斯·擊日者 - 聖騎士職業訓練師 - 談談，他就在逐日者之島的日尖塔裡。',
  }
},
[9677] = {
  {
    'Convocação do Grão-cavaleiro Sangueroico‡Призыв предводителя рыцарей Доблестной Крови‡Aufforderung des Ritterfürsten Heldenblut‡기사군주 블러드밸러의 호출‡El llamamiento del Lord caballero Sangrevalor‡El llamamiento del Lord caballero Sangrevalor‡Le chevalier-seigneur Vaillessang vous réclame‡骑士领主布拉德瓦罗的召唤‡騎士領主伯洛德瓦勒的召喚',
    nil,
    'Fale com o Grão-cavaleiro Sangueroico no Largo dos Andarilhos, que fica em Luaprata.‡Поговорите с предводителем рыцарей Доблестной Кровью на площади Странников в Луносвете.‡Sprecht mit Ritterfürst Heldenblut beim Platz der Weltenwanderer in Silbermond.‡실버문의 순찰대 광장에 있는 기사군주 블러드밸러와 대화하십시오.‡Habla con el Lord caballero Sangrevalor en la Plaza del Errante de la Ciudad de Lunargenta.‡Habla con el Lord caballero Sangrevalor en la Plaza del Errante de la Ciudad de Lunargenta.‡Parlez au chevalier-seigneur Vaillessang, place des Pérégrins, à Lune-d\'argent.‡与银月城远行者广场的骑士领主布拉德瓦罗谈一谈。‡到銀月城的遠行者廣場和騎士領主伯洛德瓦勒談談。',
  }
},
[9678] = {
  {
    'A primeira provação‡Первое испытание‡Die erste Prüfung‡첫 번째 시험‡La primera prueba‡La primera prueba‡La première épreuve‡第一项试炼‡第一個試煉',
    nil,
    'Vá até a ilha descrita pelo Grão-cavaleiro Sangueroico, encontre a caverna e acenda o braseiro. Depois da Primeira Provação, fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Отправляйтесь на остров, описанный предводителем рыцарей Доблестной Кровью, найдите пещеру и разожгите огонь в жаровне. Пройдя первое испытание, возвращайтесь к предводителю рыцарей Доблестной Крови в Луносвет.‡Reist zu der Insel, die Euch Ritterfürst Heldenblut beschrieben hat, sucht die Höhle und entzündet die Kohlepfanne. Kehrt, nachdem Ihr die erste Prüfung bestanden habt, zu Ritterfürst Heldenblut in Silbermond zurück.‡기사군주 블러드밸러가 설명한 섬으로 가서 동굴을 찾은 다음 화로에 불을 붙여야 합니다. 첫 번째 시험을 통과하면 실버문에 있는 기사군주 블러드밸러에게 돌아가십시오.‡Viaja a la isla que el Lord caballero Sangrevalor describió, encuentra la caverna, y enciende el blandón. Cuando acabe la primera prueba vuelve junto al Lord caballero Sangrevalor en la Ciudad de Lunargenta.‡Viaja a la isla que el Lord caballero Sangrevalor describió, encuentra la caverna, y enciende el blandón. Cuando acabe la primera prueba vuelve junto al Lord caballero Sangrevalor en la Ciudad de Lunargenta.‡Voyagez jusqu\'à l\'île que le chevalier-seigneur a décrite, trouvez la caverne et allumez le brasero. Lorsque la Première épreuve sera terminée, retournez voir le chevalier-seigneur Vaillessang à Lune-d\'argent.‡前往骑士领主布拉德瓦罗所描述的那座小岛，找到洞穴，并点亮火盆。当第一个试炼完成之后，向银月城的骑士领主布拉德瓦罗复命。‡前往騎士領主伯洛德瓦勒所描述的島，找到洞穴，並點燃火盆。當第一個試煉結束，回到銀月城的騎士領主·伯洛德瓦勒那裡。',
  }
},
[9680] = {
  {
    'Desencavando o passado‡Тайны прошлого‡Die Vergangenheit aufwühlen‡과거의 추적‡Resucitar el pasado‡Resucitar el pasado‡Exhumer le passé‡挖掘历史‡發掘過去',
    nil,
    'O Arquimago Alturus quer que você vá até as montanhas ao sul de Karazhan, na Trilha do Vento Morto, e recupere um Fragmento de Osso Carbonizado.‡Верховный маг Альтур желает, чтобы вы нашли в горах к югу от Каражана на Перевале Мертвого Ветра фрагмент обугленной кости и доставили ему.‡Erzmagier Alturus möchte, dass Ihr zu den Bergen südlich von Karazhan im Gebirgspass der Totenwinde geht und ein verkohltes Knochenfragment besorgt.‡대마법사 알투루스가 카라잔 남쪽의 죽음의 고개에 있는 산으로 가서 그을린 뼈 조각을 되찾아 달라고 부탁했습니다.‡El archimago Alturus quiere que vayas a las montañas al sur de Karazhan en el Paso de la Muerte y consigas un trozo de hueso carbonizado.‡El archimago Alturus quiere que vayas a las montañas al sur de Karazhan en el Paso de la Muerte y consigas un trozo de hueso carbonizado.‡L\'archimage Alturus veut que vous vous rendiez dans les montagnes au sud de Karazhan dans le défilé de Deuillevent et que vous y récupériez un Fragment d\'os carbonisé.‡大法师奥图鲁斯要求你前往逆风小径，从卡拉赞以南的山脉中取回一块焦骨碎块。‡大法師艾特羅斯要你去卡拉贊南方山脈的逆風小徑取回一個燒焦的白骨碎片。',
  }
},
[9681] = {
  {
    'Um estudo da energia‡Источник силы‡Eine Studie der Macht‡힘을 연구하다‡Un estudio sobre el poder‡Un estudio sobre el poder‡Une étude du pouvoir‡掌握力量‡學習力量',
    nil,
    'Fale com o Magíster Astalor Jurassangue na câmara oculta sob o quartel-general dos Cavaleiros Sangrentos.‡Поговорите с магистром Асталором Кровавой Клятвой в тайной зале, расположенной под штабом рыцарей крови.‡Sprecht mit Magister Astalor Blutschwur in der Geheimen Kammer unter dem Hauptquartier der Blutelfen.‡혈기사 본부 지하에 숨겨진 방에 있는 마법학자 아스탈로르 블러드스원과 대화해야 합니다.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del cuartel general de los Caballeros de sangre.‡Habla con el magister Astalor Jurasangre en la cámara oculta debajo del cuartel general de los Caballeros de sangre.‡Parlez au magistère Astalor Ligessang dans la chambre secrète sous les quartiers généraux des chevaliers de sang.‡与血骑士总部楼下密室中的魔导师阿斯塔洛·血誓谈一谈。‡到血騎士總部底下隱藏的房間裡和博學者阿斯塔樂·血誓談談。',
  }
},
[9682] = {
  {
    'Os desesperados...‡Отчаявшиеся‡Die Hoffnungslosen...‡핏빛저주의 영혼‡Los Desesperados...‡Los Desesperados...‡Les sans-espoir...‡绝望者......‡絕望者……',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você recupere 4 Almas de Sangue Amaldiçoado.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит освободить 4 души с острова Проклятой Крови.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr 4 Seelen des Blutfluchs zu ihm bringt.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 핏빛저주에 걸린 영혼 4명을 구원해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que consigas 4 almas de Sangre Maldita.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que consigas 4 almas de Sangre Maldita.‡Le capitaine Edward Hanes de l\'île Balafre-du-ver veut que vous récupériez 4 Âmes au sang maudit.‡龙痕岛的艾德华·汉斯船长要你找到4个血咒之魂。‡龍痕島的隊長艾德華·漢尼斯要你帶回4個血咒靈魂。',
  }
},
[9683] = {
  {
    'Acabando com o Sangue Maldito‡Избавление от Проклятой Крови‡Beendigung des Blutfluchs‡핏빛저주의 멸망‡El fin de la Sangre Maldita‡El fin de la Sangre Maldita‡Mettre un terme à la malédiction du sang‡血咒的终结‡終止血咒',
    nil,
    'O Capitão Cândido João, da Ilha Mal-da-serpe, quer que você destrua a Estátua da Rainha Azshara e mate Atoph, o Sangue Maldito.‡Капитан Эдвард Хейнс с острова Драконьей Скорби просит уничтожить статую королевы Азшары и убить Атофа Проклятую Кровь.‡Kapitän Edward Hanes auf der Insel Drachenfels möchte, dass Ihr die Statue der Königin Azshara zerstört und Atoph des Blutfluchs tötet.‡고룡흉터 섬에 있는 선장 에드워드 헤인즈가 아즈샤라 여왕의 석상을 파괴하고 핏빛저주의 아토프를 처치해 달라고 부탁했습니다.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que destruyas la estatua de la reina Azshara y mates a Atoph, el Sangre Maldita.‡El capitán Edward Hanes de la Isla Cicatriz de Vermis quiere que destruyas la estatua de la reina Azshara y mates a Atoph, el Sangre Maldita.‡Le capitaine Edward Hanes de l\'île Balafre-du-ver veut que vous détruisiez la Statue de la reine Azshara et éliminiez Atoph du Sang maudit.‡龙痕岛的艾德华·汉斯船长要你毁掉艾萨拉女王的雕像，并杀掉血咒者埃托弗。‡龍痕島的隊長艾德華·漢尼斯要你摧毀艾薩拉女王雕像並殺了血咒的阿托夫。',
  }
},
[9684] = {
  {
    'Poder sobre a Luz‡Получение силы Света‡Die Beherrschung des Lichts‡빛을 추구하다‡Buscando la Luz‡Buscando la Luz‡Revendiquer la Lumière‡驾驭圣光‡掌握聖光',
    nil,
    'Use o Recipiente Cintilante nos Magísteres Elfos Sangrentos para enchê-lo e fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Используйте мерцающий сосуд на эльфах крови-магистрах, чтобы наполнить его магической силой, и возвращайтесь к предводителю рыцарей Доблестной Крови в Луносвет.‡Wendet das schimmernde Gefäß auf die Magister der Blutelfen an, um es zu füllen und kehrt anschließend zu Ritterfürst Heldenblut in Silbermond zurück.‡희미하게 빛나는 용기 안에 블러드 엘프 마법학자의 힘을 가득 채운 다음 실버문의 기사군주 블러드밸러와 다시 대화해야 합니다.‡Llena la vasija refulgente en magistri elfos de sangre y llévasela al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Llena la vasija refulgente en magistri elfos de sangre y llévasela al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Utilisez le Calice chatoyant sur les Magistères elfes de sang pour le remplir et retournez voir le chevalier-seigneur Vaillessang à Lune-d\'argent.‡用血精灵魔导师身上的能量装满微光容器，然后向银月城的骑士领主布拉德瓦罗复命。‡在血精靈博學者身上使用幻光容器來裝滿它，再回到銀月城的騎士領主伯洛德瓦勒那裡。',
  }
},
[9685] = {
  {
    'Morreu, mas passa bem‡Воскрешение‡Die Erlösung der Toten‡죽은 자 부활시키기‡Redimir a los muertos‡Redimir a los muertos‡La rédemption des morts‡救赎死者‡解救亡者',
    nil,
    'Leve o Recipiente Cintilante Cheio até a estalagem de Luaprata e use a magia contida nele para ressuscitar Sangrias Tranquilâmina.‡Отправляйтесь в таверну Луносвета и воскресите Сангриаса Безмолвного Клинка с помощью силы, заключенной в наполненном мерцающем сосуде.‡Bringt das gefüllte schimmernde Gefäß zum Gasthaus von Silbermond und verwendet seine Magie, um Sangrias Stillstreich wiederzubeleben.‡실버문의 여관에 가득 찬 희미하게 빛나는 용기를 가져가십시오. 용기 안에 담긴 마력을 이용하여 상그리아스 스틸블레이드를 부활시켜야 합니다.‡Lleva la vasija refulgente llena a la posada de la Ciudad de Lunargenta y utiliza su magia para resucitar a Sangrias Hojafirme.‡Lleva la vasija refulgente llena a la posada de la Ciudad de Lunargenta y utiliza su magia para resucitar a Sangrias Hojafirme.‡Apportez le Calice chatoyant rempli à l\'auberge de Lune-d\'argent et utilisez ses pouvoirs magiques pour ressusciter Sangrias Mortelame.‡带着装满的微光容器到银月城旅店去，使用其中的力量复活桑利亚斯·静刃。‡帶著裝滿的幻光容器到銀月城旅店並使用它的魔法來復活桑古瑞斯·靜刃。',
  }
},
[9686] = {
  {
    'The Second Trial‡Второе испытание‡Die zweite Prüfung‡두 번째 시험‡La segunda prueba‡La segunda prueba‡La deuxième épreuve‡第二项试炼‡第二個試煉',
    nil,
    'Conclua a segunda provação vencendo o Campeão Furiassangue, o Campeão Rasgaluz, a Campeã Lâmina Célere e o Campeão Golpessol no pavilhão próximo do Mestre Kelerun Sanguemágoa.‡Пройдите второе испытание, победив воителя Ярокрова, воителя Светореза, воительницу Быстромеч и воителя Солнцесвета в павильоне у наставника Келерана Алого Взмаха.‡Besteht die zweite Prüfung und besiegt Champion Rachblut, Champion Lichtrend, Champion Schnellklinge und Champion Sonnensturm im Pavillon in der Nähe von Meister Kelerun Blutpein.‡단장 켈레룬 블러드모운와 가까운 거리를 유지한 채 건물 안에서 용사 블러드래스, 용사 라이트렌드, 용사 스위프트블레이드, 용사 선스트라이커를 물리치고 두 번째 시험을 완료해야 합니다.‡Completa la segunda prueba derrotando a los Campeones Furiasangre, Rasgaluz, Hojágil y Golpesol en el pabellón cerca del maestro Kelerun Lamento de Sangre.‡Completa la segunda prueba derrotando a los Campeones Furiasangre, Rasgaluz, Hojágil y Golpesol en el pabellón cerca del maestro Kelerun Lamento de Sangre.‡Achevez la seconde épreuve en battant le Champion Hargnessang, le Champion Brise-Lumière, le Champion Vivelame et le Champion Heurtesoleil dans le pavillon situé à côté de maître Kelerun Deuillessang.‡击败克雷伦·血伤一旁帐篷中的勇士布拉维·血怒、勇士莱伦德·光痕、勇士玛尔娅·迅刃和勇士斯塔克·射日者，完成第二项试炼。‡完成第二次的試煉，在大師克萊倫‧布勞德摩爾附近的亭子裡擊敗血怒勇士，勇士萊特蘭德，迅刃勇士，及勇士桑司瑞克。',
  }
},
[9687] = {
  {
    'Devolver o sagrado sossego‡Святотатство‡Wiederherstellung der Heiligkeit‡신성한 의무‡Recuperando huesos sacros‡Recuperando huesos sacros‡Rétablir la tranquillité‡找回尊严‡恢復聖潔',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, quer que você recupere 8 Ossos de Dragão.‡Принц Торет с острова Драконьей Скорби просит отыскать 8 костей драконов.‡Prinz Toreth auf der Insel Drachenfels möchte, dass Ihr 8 Drachenknochen wiedererlangt.‡고룡흉터 섬에 있는 왕자 토레스가 용의 뼈 8개를 되찾아 달라고 부탁했습니다.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que le lleves 8 huesos de dragón.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que le lleves 8 huesos de dragón.‡Le prince Toreth de l\'île Balafre-du-ver veut que vous rapportiez 8 Os de dragon.‡龙痕岛的托雷斯王子要你找回8根龙骨。‡龍痕島的托瑞斯王子要你取回8根龍骨。',
  }
},
[9688] = {
  {
    'Sonho impossível‡Дорога в Сон‡Im Traum‡녹색용군단의 영혼 구원‡Entrando en el Sueño‡Entrando en el Sueño‡Vers le Rêve‡进入梦境‡進入夢境',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, pediu que você matasse 5 Dragonetes Viridianos e 5 Filhotes Viridianos.‡Принц Торет с острова Драконьей Скорби просит убить 5 темно-зеленых дракончиков и 5 детенышей зеленого дракона.‡Prinz Toreth auf der Insel Drachenfels hat von Euch verlangt, dass Ihr 5 Viridianwelpen und 5 Viridianbrutlinge tötet.‡고룡흉터 섬에 있는 왕자 토레스가 작은 청록 새끼용, 청록 새끼용을 각각 5마리씩 처치해 달라고 부탁했습니다.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que mates 5 crías y 5 estirpes viridianas.‡El príncipe Toreth de Isla Cicatriz de Vermis quiere que mates 5 crías y 5 estirpes viridianas.‡Le prince Toreth de l\'île Balafre-du-ver vous a demandé de tuer 5 Jeunes virides et 5 Rejetons virides.‡龙痕岛的托雷斯王子要你杀掉5只绿色雏龙和5只绿色龙崽。‡龍痕島的托瑞斯王子要你殺死5隻翠綠色幼龍和5隻翠綠色小龍。',
  }
},
[9689] = {
  {
    'Rasgaqueixo‡Острозуб‡Messerrachen‡칼날아귀‡Tajobuche‡Tajobuche‡Tranchegueule‡刺喉‡瑞索默',
    nil,
    'O Príncipe Toreth, da Ilha Mal-da-serpe, pediu que você matasse o Rasgaqueixo.‡Принц Торет с острова Драконьей Скорби просит убить Острозуба.‡Prinz Toreth auf der Insel Drachenfels hat von Euch verlangt, dass Ihr Messerrachen tötet.‡고룡흉터 섬에 있는 왕자 토레스가 칼날아귀를 처치해 달라고 부탁했습니다.‡El príncipe Toreth de la Isla Cicatriz de Vermis ha pedido que mates a Tajobuche.‡El príncipe Toreth de la Isla Cicatriz de Vermis ha pedido que mates a Tajobuche.‡Le prince Toreth de l\'île Balafre-du-ver vous a demandé de tuer Tranchegueule.‡龙痕岛的托雷斯王子要你杀掉刺喉。‡龍痕島的托瑞斯王子要你殺了瑞索默。',
  }
},
[9690] = {
  {
    'The Second Trial‡Второе испытание‡Die zweite Prüfung‡두 번째 시험‡La segunda prueba‡La segunda prueba‡La deuxième épreuve‡第二项试炼‡第二個試煉',
    nil,
    'Apresente-se ao Mestre Kelerun Sanguemágoa.‡Поговорите с наставником Келераном Алым Взмахом.‡Meldet Euch bei Meister Kelerun Blutpein.‡단장 켈레룬 블러드모운에게 보고해야 합니다.‡Preséntate ante el maestro Kelerun Lamento de Sangre.‡Preséntate ante el maestro Kelerun Lamento de Sangre.‡Présentez-vous au maître Kelerun Deuillessang.‡向克雷伦·血伤报到。‡向大師克萊倫·布勞德摩爾回報。',
  }
},
[9691] = {
  {
    'Retorno a Luaprata‡Возвращение в Луносвет‡Rückkehr nach Silbermond‡실버문으로 돌아가기‡Regresa a Lunargenta‡Regresa a Lunargenta‡Retour à Lune-d\'argent‡返回银月城‡回到銀月城',
    nil,
    'Fale novamente com o Grão-cavaleiro Sangueroico em Luaprata.‡Возвращайтесь к предводителю рыцарей Доблестной Крови в Луносвет.‡Kehrt zu Ritterfürst Heldenblut nach Silbermond zurück.‡실버문에 있는 기사군주 블러드밸러에게 돌아가십시오.‡Ve a ver al Lord caballero Sangrevalor en Ciudad de Lunargenta.‡Ve a ver al Lord caballero Sangrevalor en Ciudad de Lunargenta.‡Retournez voir le chevalier-seigneur Vaillessang à Lune-d\'argent.‡向银月城的骑士领主布拉德瓦罗报到。‡回到銀月城的騎士領主伯洛德瓦勒那裡。',
  }
},
[9692] = {
  {
    'Caminho do adepto‡Путь адепта‡Der Pfad des Adepten‡숙련 혈기사의 길‡El camino de los adeptos‡El camino de los adeptos‡La voie de l\'adepte‡骑士之路‡高手之路',
    nil,
    'Leve uma Gema Kor Corrompida, um Caixote de Lingotes Forjados em Sangue, uma porção de Sangue do Irascível e uma Insígnia do Cavaleiro Sangrento para o Grão-cavaleiro Sangueroico em Luaprata.‡Принесите оскверненный самоцвет Кора, ящик со слитками, закаленными в крови, нужное количество крови разгневанных и знак отличия рыцаря крови предводителю рыцарей Доблестной Крови в Луносвет.‡Bringt Ritterfürst Heldenblut in Silbermond einen verderbten Koredelstein, eine Kiste mit blutgeschmiedeten Blöcken, etwas Blut des Hasserfüllten und ein Insigne der Blutritter.‡실버문에 있는 기사군주 블러드밸러에게 부정한 코르석, 핏빛철로 주괴 상자, 진노의 피, 혈기사 휘장을 하나씩 가져가야 합니다.‡Lleva 1 gema kor corrupta, 1 caja de lingotes forjados con sangre, sangre del Colérico y 1 insignia de Caballero de sangre al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Lleva 1 gema kor corrupta, 1 caja de lingotes forjados con sangre, sangre del Colérico y 1 insignia de Caballero de sangre al Lord caballero Sangrevalor a Ciudad de Lunargenta.‡Apportez une Gemme de Kor corrompue, une Caisse de lingots de forge-sang, une bonne mesure de Sang du Courroucé et un Insigne de chevalier de sang au Chevalier-seigneur Vaillessang, à Lune-d\'argent.‡将一块被污染的科尔宝石、一箱血铸铁锭、一份愤怒者之血和一枚血骑士徽章交给银月城的骑士领主布拉德瓦罗。‡將一顆被污染的科爾寶石，血鑄錠木箱，大量憤怒之血，和一個血騎士徽記帶給銀月城的騎士領主伯洛德瓦勒。',
  }
},
[9693] = {
  {
    'O que Argus significa para mim‡Что для тебя Аргус?..‡Was Argus für mich bedeutet‡아르거스의 대리인으로서‡¿Qué es Argus para ti?‡¿Qué es Argus para ti?‡Ce qu\'Argus signifie pour moi‡阿古斯的意义‡阿古斯對我的意義',
    nil,
    'O Exarca Admetius, do Entreposto Rubro, quer que você fale com o Vindicante Boros.‡Экзарх Адметиус с Кровавой заставы просит поговорить с воздаятелем Боросом.‡Exarch Admetius bei der Blutwacht wies Euch an, mit Verteidiger Boros zu sprechen.‡핏빛 감시초소에 있는 총독 애드미티우스가 구원자 보로스와 대화하라고 부탁했습니다.‡El exarca Admetius de la Avanzada de Sangre quiere que hables con el vindicador Boros.‡El exarca Admetius de la Avanzada de Sangre quiere que hables con el vindicador Boros.‡L\'exarque Admetius du Guet du sang vous a demandé de parler au redresseur de torts Boros.‡秘血岗哨的主教埃德门图斯要你去跟守备官波鲁斯谈一谈。‡血色守望的主教阿德密特斯要你去和復仇者波羅斯談談。',
  }
},
[9694] = {
  {
    'O Entreposto Rubro‡Кровавая застава‡Blutwacht‡핏빛 감시초소‡Avanzada de Sangre‡Avanzada de Sangre‡Le Guet du sang‡秘血岗哨‡血色守望',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você mate 10 Espiões Falconélius.‡Убейте 10 шпионов Солнечных Ястребов и сообщите об этом на Кровавую заставу воздаятелю Боросу.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr 10 Spione der Sonnenfalken tötet.‡핏빛 감시초소에 있는 구원자 보로스가 태양매 비밀요원 10명을 처치해 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quieres que mates a 10 espías Halcón del Sol.‡El vindicador Boros de la Avanzada de Sangre quieres que mates a 10 espías Halcón del Sol.‡Le redresseur de torts Boros au Guet du sang veut que vous tuiez 10 Espions Epervier du soleil.‡杀死10个炎鹰间谍，然后向秘血岗哨的守备官波鲁斯复命。‡血色守望的復仇者波羅斯要你殺死10個太陽之鷹間諜。',
  }
},
[9695] = {
  {
    'The Sun King\'s Command‡Повеление Солнечного короля‡Die Anweisung des Sonnenkönigs‡‡Las órdenes del Rey del Sol‡Las órdenes del Rey del Sol‡Les ordres du roi-soleil‡DEPRECATED‡太陽之王的命令',
    nil,
    'Take the Sun King\'s Command to Vindicator Boros at Blood Watch.‡Доставьте повеление Солнечного короля воздаятелю Боросу на Кровавую заставу.‡Bringt die Anweisung des Sonnenkönigs zu Verteidiger Boros bei der Blutwacht.‡‡Lleva la orden del Rey del Sol al vindicador Boros a la Avanzada de Sangre.|n‡Lleva la orden del Rey del Sol al vindicador Boros a la Avanzada de Sangre.|n‡Apportez les Ordres du roi-soleil au redresseur de torts Boros au Guet du sang.‡将Sun King\'s Command交给秘血岗哨的Vindicator Boros。‡將太陽之王的命令帶給血色守望的復仇者波羅斯。',
  }
},
[9696] = {
  {
    'Traduttore, traditore‡Переводы...‡Übersetzungen...‡문서 번역‡Traducciones‡Traducciones‡Traductions...‡翻译......‡翻譯……',
    nil,
    'Leve a Missiva do Falconélius para a Interrogadora Elysia no Entreposto Rubro.‡Доставьте послание Солнечных Ястребов дознавательнице Элизии на Кровавую заставу.‡Bringt das Schreiben der Sonnenfalken zur Vernehmungsbeauftragten Elysia bei der Blutwacht.‡핏빛 감시초소에 있는 심문관 엘리시아에게 태양매 서한을 가져가야 합니다.‡Lleva la misiva de los Halcones del Sol a la interrogadora Elysia a la Avanzada de Sangre.‡Lleva la misiva de los Halcones del Sol a la interrogadora Elysia a la Avanzada de Sangre.‡Apportez la Missive des Eperviers du soleil à l\'interrogatrice Elysia au Guet du sang.‡将炎鹰信函交给秘血岗哨的审讯者埃莉西亚。‡將太陽之鷹書信帶給血色守望的審問者伊萊希雅。',
  }
},
[9697] = {
  {
    'Vigia Leesa\'oh‡Наблюдательница Лиса\'о‡Behüterin Leesa\'oh‡관찰자 리사오‡La vigía Leesa\'oh‡La vigía Leesa\'oh‡La gardienne Leesa\'oh‡观察者莉萨奥‡看守者里薩歐',
    nil,
    'Fale com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Поговорите с наблюдательницей Лиса\'о у кенарийского караульного поста в Зангартопи.‡Sprecht mit Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen.‡장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오와 대화해야 합니다.‡Ve al Puesto de Vigilancia Cenarion de la Marisma de Zangar y habla con la vigía Leesa\'oh.‡Ve al Puesto de Vigilancia Cenarion de la Marisma de Zangar y habla con la vigía Leesa\'oh.‡Parlez à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡与赞加沼泽塞纳里奥岗哨的观察者莉萨奥谈一谈。‡到贊格沼澤的塞納里奧看守站和看守者里薩歐談談。',
  }
},
[9698] = {
  {
    'Audiência com o profeta‡Аудиенция у Пророка‡Audienz beim Propheten‡태양왕의 명령서‡Audiencia con el Profeta‡Audiencia con el Profeta‡Une audience avec le Prophète‡会见先知‡覲見預言者',
    nil,
    'Entregue a Missiva do Falconélius Traduzida para o Profeta Velen na Exodar.‡Доставьте переведенное послание Солнечных Ястребов Пророку Велену в Экзодар.‡Bringt das übersetzte Schreiben der Sonnenfalken zum Propheten Velen bei der Exodar.‡엑소다르에 있는 예언자 벨렌에게 번역된 태양매 서한을 가져가야 합니다.‡Lleva la traducción de la carta de los Halcón del Sol al profeta Velen a El Exodar.‡Lleva la traducción de la carta de los Halcón del Sol al profeta Velen a El Exodar.‡Apportez la Missive des Eperviers du soleil traduite au prophète Velen à l\'Exodar.‡将炎鹰信函的译文交给埃索达的先知维伦。‡將翻譯太陽之鷹的書信帶給艾克索達的預言者費倫。',
  }
},
[9699] = {
  {
    'Verdade ou ficção‡Правда или вымысел‡Was ist wahr?‡진실과 거짓‡Verdad o mentira‡Verdad o mentira‡Vérité ou fiction‡真相还是谎言‡是真是假',
    nil,
    'Entregue as Ordens de Velen para o Vindicante Boros no Entreposto Rubro.‡Доставьте распоряжения Велена воздаятелю Боросу на Кровавую заставу.‡Bringt Velens Anordnungen zu Verteidiger Boros bei der Blutwacht.‡핏빛 감시초소에 있는 구원자 보로스에게 벨렌의 명령서를 가져가야 합니다.‡Lleva las órdenes de Velen al vindicador Boros a la Avanzada de Sangre.‡Lleva las órdenes de Velen al vindicador Boros a la Avanzada de Sangre.‡Apportez les Ordres de Velen au redresseur de torts Boros, au Guet du sang.‡将维伦的命令交给秘血岗哨的守备官波鲁斯。‡將費倫的命令帶給血色守望的復仇者波羅斯。',
  }
},
[9700] = {
  {
    'A dimensão do caos tá TENSA‡Магия против Тьмы‡Licht ins Dunkel bringen‡어둠에 쏘아진 마법‡Disparando magia en la oscuridad‡Disparando magia en la oscuridad‡Des traits de magie dans l\'obscurité‡黑暗中的魔法‡向黑暗中發射魔法',
    nil,
    'O Vindicante Boros, do Entreposto Rubro, quer que você encontre o local do Portal Solar e mate 5 Anomalias do Caos.‡Воздаятель Борос с Кровавой заставы просит найти солнечный портал и убить 5 аномалий Бездны.‡Verteidiger Boros bei der Blutwacht möchte, dass Ihr die Lage des Sonnenportals ausfindig macht und 5 Anomalien der Leere tötet.‡핏빛 감시초소에 있는 구원자 보로스가 태양의 차원문 흔적을 찾고 공허의 변형물 5마리를 처치해 달라고 부탁했습니다.‡El vindicador Boros de la Avanzada de Sangre quiere que encuentres el portal del Sol y mates 5 anomalías del vacío.‡El vindicador Boros de la Avanzada de Sangre quiere que encuentres el portal del Sol y mates 5 anomalías del vacío.‡Le redresseur de torts Boros du Guet du sang veut que vous trouviez l\'emplacement du Portail du soleil et que vous tuiez 5 Anomalies du Vide.‡前往太阳传送站杀死5个虚空畸能，然后向秘血岗哨的守备官波鲁斯复命。‡血色守望的復仇者波羅斯要你找到太陽之門地點並殺死5個虛無反常者。',
  }
},
[9701] = {
  {
    'Observando os Sporeggar‡Наблюдение за спорлингами‡Sporlinge beobachten‡스포어링의 생태 관찰‡Observación de esporinos‡Observación de esporinos‡L\'observation des sporelins‡观察孢子人‡觀察孢子人',
    nil,
    'Investigue o Vale dos Rebentos, no Pântano Zíngaro, e volte a falar com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro, levando seus achados.‡Исследуйте Грибную поляну в Зангартопи, затем вернитесь к наблюдательнице Лиса\'о к кенарийскому караульному посту в Зангартопи и расскажите об увиденном.‡Untersucht das Pilzgeflecht in den Zangarmarschen und berichtet danach Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen von Euren Beobachtungen.‡장가르 습지대에 있는 부화의 골짜기를 조사한 후, 발견한 내용을 세나리온 감시초소에 있는 관찰자 리사오에게 보고해야 합니다.‡Investiga La Cañada Emergente en la Marisma de Zangar e informa a la vigía Leesa\'oh del Puesto de Vigilancia Cenarion en la Marisma de Zangar de tus pesquisas.‡Investiga La Cañada Emergente en la Marisma de Zangar e informa a la vigía Leesa\'oh del Puesto de Vigilancia Cenarion en la Marisma de Zangar de tus pesquisas.‡Examiner le Vallon des pontes dans le marécage de Zangar, puis rapporter vos découvertes à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡调查赞加沼泽的孢殖林，然后返回赞加沼泽的塞纳里奥岗哨，向观察者莉萨奥汇报你的发现。‡調查贊格沼澤的重生峽谷，再將你的發現帶回贊格沼澤向塞納里奧看守站的看守者里薩歐回報。',
  }
},
[9702] = {
  {
    'Um problema de gula‡Вопросы питания‡Eine Frage der Fressgier‡굶주림의 이유‡Cuestión de glotonería‡Cuestión de glotonería‡Un problème de gloutonnerie‡狼吞虎咽‡暴食的問題',
    nil,
    'Colete 10 amostras de Nutrimentos Descartados e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 10 образцов выброшенного корма и вернитесь к наблюдательнице Лиса\'о на кенарийский караульный пост в Зангартопи.‡Sammelt 10 Stück liegengelassene Nahrung und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버려진 버섯 10개를 수집한 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recoge 10 restos de alimentos y llévaselos a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Recoge 10 restos de alimentos y llévaselos a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Rassembler 10 morceaux d\'Aliments abandonnés puis revenir voir la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡将10份丢弃的食物交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集10份被丟棄的營養品再回到贊格沼澤的塞納里奧看守站找看守者里薩歐。',
  }
},
[9703] = {
  {
    'O Crio-núcleo‡Криогенный блок‡Der Kryokern‡극저온 핵‡El Crionúcleo‡El Crionúcleo‡Le cryocœur‡冷却核心‡冬眠核心',
    nil,
    'O Vindicante Kuros, do Entreposto Rubro, quer que você recupere 12 caixas de Suprimentos Médicos.‡Воздаятель Курос хочет, чтобы вы доставили на Кровавую заставу 12 коробок с медицинскими припасами.‡Verteidiger Kuros bei der Blutwacht möchte, dass Ihr 12 Kisten mit Heilvorräten sichert.‡핏빛 감시초소에 있는 구원자 쿠로스가 의약품 상자 12상자를 찾아 달라고 부탁했습니다.‡El vindicador Kuros de la Avanzada de Sangre quiere que recuperes 12 cajas de suministros médicos.‡El vindicador Kuros de la Avanzada de Sangre quiere que recuperes 12 cajas de suministros médicos.‡Le redresseur de torts Kuros au Guet du sang veut que vous récupériez 12 boîtes de Fournitures médicales.‡取回12箱医疗补给品，然后向秘血岗哨的守备官库卢斯复命。‡血色守望的復仇者庫羅斯要你取得12箱醫療補給。',
  }
},
[9704] = {
  {
    'Ceifado pelos ignóbeis!‡Смерть от рук Презренных‡Von den Getriebenen getötet‡버림받은 자들에 의해 살해된 길잡이‡Ejecutados por los desdichados‡Ejecutados por los desdichados‡Tuée par les Déshérités‡失心者的牺牲品‡鄙惡者兇手',
    nil,
    'Rume para as ruínas de Luaprata ao sul e encontre a Vanguardeira Assassinada na Alameda Alvorecente.‡Отправляйтесь на юг, в руины Луносвета, и отыщите убитого курьера на Рассветной улице.‡Geht nach Süden zu den Ruinen von Silbermond und haltet nach der getöteten Kundschafterin beim Dämmerweg Ausschau.‡남쪽 실버문의 폐허로 가서 새벽길에 있는 살해된 길잡이를 찾아야 합니다.‡Ve hacia el sur a las Ruinas de Ciudad de Lunargenta y busca a la avanzada asesinada en Calle del Alba.‡Ve hacia el sur a las Ruinas de Ciudad de Lunargenta y busca a la avanzada asesinada en Calle del Alba.‡Allez au sud dans les ruines de Lune-d\'argent et cherchez l\'Estafette morte dans l\'allée du Point-du-jour.‡往南进入银月城废墟，在黎明之路附近寻找被杀死的信使。‡往南進入銀月廢墟的黎明小路尋找被殺的先驅者。',
  }
},
[9705] = {
  {
    'Recuperação do pacote‡Возвращение посылки‡Bergung des Päckchens‡소포 회수‡Recuperación de paquete‡Recuperación de paquete‡Récupérer un paquet‡找回包裹‡重獲包裹',
    nil,
    'Fale novamente com a Vanguardeira Alarion levando o Pacote da Erona.‡Вернитесь к курьеру Аларион с посылкой Эроны.‡Kehrt mit Eronas Päckchen zu Kundschafterin Alarion zurück.‡이로나의 소포를 가지고 길잡이 알라리온에게 돌아가야 합니다.‡Regresa junto a la avanzada Alarion con el paquete de Erona.‡Regresa junto a la avanzada Alarion con el paquete de Erona.‡Retournez voir l\'estafette Alarion avec le Paquet d\'Erona.‡将艾洛娜的包裹交给信使奥拉莉恩。‡將伊羅娜的包裹帶給先驅者艾拉瑞恩。',
  }
},
[9706] = {
  {
    'Diário de Galaen - O destino do vindicante Saruan‡Дневник Галена: судьба воздаятеля Саруана‡Galaens Tagebuch - Das Schicksal von Verteidiger Saruan‡구원자 사루안의 운명‡El diario de Galaen: El destino del vindicador Saruan‡El diario de Galaen: El destino del vindicador Saruan‡Le journal de Galaen - Le destin du redresseur de torts Saruan‡加莱恩的日记 - 守备官撒鲁安的命运‡高拉恩的日誌 - 復仇者薩魯安的命運',
    nil,
    'Entregue o Diário de Galaen para o Vindicante Kuros no Entreposto Rubro.‡Доберитесь до Кровавой заставы и отдайте дневник Галена воздаятелю Куросу.‡Bringt Galaens Tagebuch zu Verteidiger Kuros bei der Blutwacht.‡핏빛 감시초소에 있는 구원자 쿠로스에게 갈라엔의 일지를 가져가야 합니다.‡Lleva el diario de Galaen al vindicador Kuros a la Avanzada de Sangre.|n‡Lleva el diario de Galaen al vindicador Kuros a la Avanzada de Sangre.|n‡Apportez le Journal de Galaen au redresseur de torts Kuros au Guet du sang.‡将加莱恩的日记交给秘血岗哨的守备官库卢斯。‡將高拉恩的日誌帶給血色守望的復仇者庫羅斯。',
  }
},
[9707] = {
  {
    'A forja da arma‡Ковка оружия‡Das Schmieden der Waffe‡무기 제작‡Forjando el arma‡Forjando el arma‡Forger l\'arme‡铸造武器‡鑄造武器',
    nil,
    'Leve o Caixote de Materiais para Bemarrin em Luaprata.‡Принесите ящик с материалами Бемаррину в Луносвет.‡Bringt die Kiste mit Rohmaterialien zu Bemarrin in Silbermond.‡실버문에 있는 베마린에게 재료가 든 상자를 가져가야 합니다.‡Lleva el cajón de materiales a Bemarrin a Ciudad de Lunargenta.‡Lleva el cajón de materiales a Bemarrin a Ciudad de Lunargenta.‡Apportez la Caisse de matériaux à Bemarrin à Lune-d\'argent.‡将这箱材料交给银月城的波玛尔。‡把原料木箱帶給銀月城的貝瑪倫。',
  }
},
[9708] = {
  {
    'Fungos familiares‡Знакомые грибы‡Bekannter Pilz‡익숙한 버섯종‡Ese hongo me suena‡Ese hongo me suena‡Des champignons familiers‡熟悉的蘑菇‡熟悉的蘑菇',
    nil,
    'Colete 15 Amostras de Cogumelos e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 15 образцов грибов и принесите их наблюдательнице Лиса\'о на караульный пост Кенария в Зангартопи.‡Sammelt 15 Pilzproben und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버섯 견본 15개를 수집한 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recolecta 15 muestras de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Recolecta 15 muestras de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion de la Marisma de Zangar.‡Collectez 15 Échantillons de champignon et apportez-les à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡将15份蘑菇样本交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集15個蘑菇樣本再回到贊格沼澤的塞納里奧看守站交給看守者里薩歐。',
  }
},
[9709] = {
  {
    'Ladrão que rouba ladrão...‡Ворованные грибы‡Die Pilze zurückstehlen‡버섯 도로 훔쳐오기‡Volver a robar los champiñones‡Volver a robar los champiñones‡Voler aux voleurs‡偷回蘑菇‡偷回蘑菇',
    nil,
    'Colete 10 Caixas de Cogumelos e fale novamente com a Vigia Leesa\'oh na Guarita Cenariana, no Pântano Zíngaro.‡Соберите 10 ящиков грибов и вернитесь с ними к наблюдательнице Лиса\'о на караульный пост Кенария в Зангартопи.‡Sammelt 10 Kisten Pilze und kehrt dann zu Behüterin Leesa\'oh im Wachposten des Cenarius in den Zangarmarschen zurück.‡버섯 상자 10개를 모은 후 장가르 습지대에 세나리온 감시초소에 있는 관찰자 리사오에게 돌아가야 합니다.‡Recolecta 10 cajas de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Recolecta 10 cajas de champiñones y llévaselas a la vigía Leesa\'oh al Puesto de Vigilancia Cenarion en la Marisma de Zangar.‡Récupérez 10 Boîtes de champignons et rapportez-les à la gardienne Leesa\'oh au Poste de garde cénarien dans le marécage de Zangar.‡将10箱蘑菇交给赞加沼泽塞纳里奥岗哨的观察者莉萨奥。‡收集10箱蘑菇再回到贊格沼澤的塞納里奧看守站交給看守者里薩歐。',
  }
},
[9710] = {
  {
    'O tridente temperado em sangue‡Закаленный кровью протазан‡Der blutgehärtete Ranseur‡피로 벼려낸 장창‡La corcesca templada en sangre‡La corcesca templada en sangre‡La corsèque à la trempe de sang‡淬血长矛‡血淬三叉矛',
    nil,
    'Espere enquanto Bemarrin forja sua arma.‡Дождитесь, пока Бемаррин смастерит оружие.‡Wartet, während Bemarrin Eure Waffe schmiedet.‡베마린이 무기를 만드는 동안 기다려야 합니다.‡Espera mientras Bemarrin forja tu arma.‡Espera mientras Bemarrin forja tu arma.‡Attendez pendant que Bemarrin forge votre arme.‡等待波玛尔为你锻造出你的武器。‡等待貝瑪倫幫你鑄造武器。',
  }
},
[9711] = {
  {
    'Matis, o Cruel‡Матис Жестокий‡Matis der Grausame‡학살자 마티스‡Matis el Cruel‡Matis el Cruel‡Matis le Cruel‡残忍的玛提斯‡殘忍的馬帝斯',
    nil,
    'O Vindicante Kuros, do Entreposto Rubro, quer que você capture Matis, o Cruel.‡Воздаятель Курос с Кровавой заставы требует, чтобы Матис Жестокий был пойман.‡Verteidiger Kuros bei der Blutwacht möchte, dass Ihr Matis den Grausamen gefangen nehmt.‡핏빛 감시초소에 있는 구원자 쿠로스에게 학살자 마티스를 잡아 데려가야 합니다.‡El vindicador Kuros de Avanzada de Sangre quiere que captures a Matis el Cruel.‡El vindicador Kuros de Avanzada de Sangre quiere que captures a Matis el Cruel.‡Le redresseur de torts Kuros du Guet du sang veut que vous capturiez Matis le Cruel.‡秘血岗哨的守备官库卢斯要你俘获残忍的玛提斯。‡血色守望的復仇者庫羅斯要你抓到殘忍的馬帝斯。',
  }
},
[9712] = {
  {
    'O cavalo de guerra thalassiano‡Талассийский боевой конь‡Das thalassische Schlachtross‡탈라시안 전투마‡El caballo de guerra thalassiano‡El caballo de guerra thalassiano‡Le cheval de guerre thalassien‡萨拉斯战马‡薩拉斯戰馬',
    nil,
    'Fale com o Grão-Cavaleiro Sangueroico para aprender como evocar seu Cavalo de Guerra Thalassiano.‡Поговорите с предводителем рыцарей Доблестной Кровью, чтобы научиться вызывать талассийского боевого коня.‡Sprecht mit Ritterfürst Heldenblut, um zu erfahren, wie Ihr Euer thalassisches Schlachtross beschwören könnt.‡기사군주 블러드밸러에게 탈라시안 전투마 소환하는 방법을 배워야 합니다.‡Habla con el Lord caballero Sangrevalor para aprender a invocar a tu caballo de guerra thalassiano.‡Habla con el Lord caballero Sangrevalor para aprender a invocar a tu caballo de guerra thalassiano.‡Parlez au chevalier-seigneur Vaillessang pour apprendre comment invoquer votre cheval de guerre thalassien.‡与骑士领主布拉德瓦罗交谈，学习如何召唤你的萨拉斯战马。‡和騎士領主伯洛德瓦勒談談，學習如何召喚你的薩拉斯戰馬。',
  }
},
[9713] = {
  {
    '‡Включение возможности сбора огнешляпки‡Glowcap Harvesting Enabling Flag‡[미사용] 초롱버섯 수집‡Recogiendo fluochampiñones‡Recogiendo fluochampiñones‡Drapeau pour la récolte des chapeluisants‡白闪菇可采集标志‡',
    nil,
    nil,
  }
},
[9714] = {
  {
    'Traga-me outro canteiro de arbusto!‡Принеси мне еще одну клумбу!‡Bringt mir ein weiteres Gebüsch!‡핏빛 불상화 추가 수집‡¡Tráeme otra mata!‡¡Tráeme otra mata!‡Ramenez-moi un autre jardinet !‡我还要红色木槿！‡再給我木槿花!',
    nil,
    nil,
  }
},
[9715] = {
  {
    'Traga-me um canteiro de arbusto!‡Принеси мне клумбу!‡Bringt mir ein Gebüsch!‡핏빛 불상화‡¡Tráeme una mata!‡¡Tráeme una mata!‡Ramenez-moi un jardinet !‡我要红色木槿！‡給我木槿花!',
    nil,
    'Colete 5 Hibiscos Sanguíneos e entregue-os a Gzhun\'tt em Sporeggar, que fica no Pântano Zíngaro.‡Добудьте 5 растений кровавого гибискуса и отнесите их Гзхун\'тту в Спореггар в Зангартопи.‡Sammelt 5 Stück Bluthibiskus und bringt sie zu Gzhun\'tt in Sporeggar in den Zangarmarschen.‡핏빛 불상화 5개를 모은 후 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Recolecta 5 hibiscos sanguinos y llévaselos a Gzhun\'tt en Esporaggar en la Marisma de Zangar.‡Recolecta 5 hibiscos sanguinos y llévaselos a Gzhun\'tt en Esporaggar en la Marisma de Zangar.‡Récupérez 5 Hibiscus sanguins et rapportez-les à Gzhun\'tt à Sporeggar dans le marécage de Zangar.‡将5朵红色木槿交给赞加沼泽孢子村的舒特。‡收集5朵血紅木槿再回到贊格沼澤的斯博格爾交給卡思汗特。',
  }
},
[9716] = {
  {
    'Transtorno no Lago Charco Sombrio‡Неприятности на озере Тенетопь‡Anomalie am Umbrafennsee‡그늘늪 호수의 장애‡Problemas en el Lago Umbropantano‡Problemas en el Lago Umbropantano‡Des ennuis au lac Umbretourbe‡暗泽湖的异常‡昂布拉凡湖的憂慮',
    nil,
    'Investigue a causa do esgotamento de água no Lago Charco Sombrio. Depois, fale novamente com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Выясните причину убывания воды в озере Тенетопь. Затем вернитесь к Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Untersucht den Grund für die sinkenden Wasserspiegel am Umbrafennsee. Kehrt dann zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡그늘늪 호수의 물이 고갈되고 있는 원인을 조사한 후, 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Investiga el origen de la pérdida de agua en Lago Umbropantano. Luego ve a ver a Ysiel Vientocantor al Refugio Cenarion, en la Marisma de Zangar.‡Investiga el origen de la pérdida de agua en Lago Umbropantano. Luego ve a ver a Ysiel Vientocantor al Refugio Cenarion, en la Marisma de Zangar.‡Déterminez la cause de la diminution de l\'eau au lac Umbretourbe. Puis retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡调查暗泽湖水位下降的原因，然后返回赞加沼泽的塞纳里奥避难所，向伊谢尔·风歌复命。‡調查昂布拉凡湖水量銳減的原因。再回到贊格沼澤的塞納里奧避難所找伊斯歐·風詠。',
  }
},
[9717] = {
  {
    'Então tá!‡Удачный ход‡Los geht\'s!‡지하포자 잎사귀 수집‡El esqueje‡El esqueje‡Oh, alors s\'ils veulent la guerre...‡孢子叶‡喔，開始吧!',
    nil,
    'Pegue uma Fronde de Subesporo e leve para T\'shu em Sporeggar, que fica no Pântano Zíngaro.‡Добудьте ветку подспорника и вернитесь с ней к Т\'шу в Спореггар в Зангартопи.‡Besorgt einen Tiefensporenfarn und bringt ihn zu T\'shu in Sporeggar in den Zangarmarschen.‡지하포자 잎사귀를 모아서 장가르 습지대의 스포어가르에 있는 트슈에게 가져가야 합니다.‡Recolecta un esqueje de sotoespora y llévaselo a T\'shu a Esporaggar en la Marisma de Zangar.‡Recolecta un esqueje de sotoespora y llévaselo a T\'shu a Esporaggar en la Marisma de Zangar.‡Cueillez une Palme de sporielle et rapportez-la à T\'shu à Sporeggar dans le marécage de Zangar.‡将一片幽暗孢子叶交给赞加沼泽孢子村的塔苏。‡收集一片地孢之葉交給贊格沼澤的斯博格爾的塔蘇。',
  }
},
[9718] = {
  {
    'Quando o corvo voa‡С высоты птичьего полета‡Der Flug der Krähe‡일직선으로...‡A vuelo de pájaro‡A vuelo de pájaro‡À vol d\'oiseau‡乌鸦的飞翔‡烏鴉高飛時',
    nil,
    'Ysiel Cantavento quer que você use o Amuleto Corvo da Tormenta para explorar os grandes lagos no Pântano Zíngaro.‡Используйте амулет буревестника, чтобы исследовать основные озера Зангартопи по просьбе Исиэли Песни Ветра.‡Ysiel Windsänger möchte, dass Ihr das Sturmkrähenamulett benutzt, um die größeren Seen in den Zangarmarschen zu erkunden.‡이시엘 윈드싱어가 폭풍까마귀 아뮬렛을 사용하여 장가르 습지대의 주요 호수들을 확인해 달라고 부탁했습니다.‡Ysiel Vientocantor quiere que uses el amuleto de cuervo tormentoso para explorar los lagos principales de la Marisma de Zangar.‡Ysiel Vientocantor quiere que uses el amuleto de cuervo tormentoso para explorar los lagos principales de la Marisma de Zangar.‡Ysiel Chantelevent veut que vous vous serviez de l\'Amulette du corbeau des tempêtes pour explorer chacun des principaux lacs du Marécage de Zangar.‡伊谢尔·风歌要求你使用风暴乌鸦护符，然后调查赞加沼泽的主要湖泊。‡伊斯歐·風詠要你使用風暴烏鴉護符來探勘贊格沼澤的主要湖泊。',
  }
},
[9719] = {
  {
    'Espreite o espreitador‡Охота на Охотницу‡Tötet die Mutter‡검은 추적자 처치‡El acechador acechado‡El acechador acechado‡Traquer la traqueuse‡黑色阔步者‡追蹤潛獵者',
    nil,
    'Entregue o Cérebro da Espreitadora Negra para Khn\'nix em Sporeggar, que fica no Pântano Zíngaro.‡Принесите мозг Черной Охотницы Кхн\'иксу в Спореггар в Зангартопи.‡Bringt das Gehirn der Schattenmutter zu Khn\'nix in Sporeggar in den Zangarmarschen.‡장가르 습지대의 스포어가르에 있는 크닉스에게 검은 추적자의 머리를 가져가야 합니다.‡Lleva el cerebro de la Acechadora Negra a Khn\'nix en Esporaggar en la Marisma de Zangar.‡Lleva el cerebro de la Acechadora Negra a Khn\'nix en Esporaggar en la Marisma de Zangar.‡Apportez le Cerveau de la Traqueuse noire à Khn\'nix à Sporeggar dans le marécage de Zangar.‡将黑色阔步者的大脑交给赞加沼泽孢子村的肯尼克斯。‡把黑色潛獵者的大腦帶給贊格沼澤的斯博格爾的奇尼克斯。',
  }
},
[9720] = {
  {
    'É preciso preservar o equilíbrio‡Необходимо поддерживать равновесие!‡Das Gleichgewicht muss erhalten bleiben‡자연의 균형 수호‡Restaurar el equilibrio‡Restaurar el equilibrio‡L\'équilibre doit être préservé‡恢复平衡‡一定要保持平衡',
    nil,
    'Ysiel Cantavento quer que você use as Sementes de Vinaferro nos Controles da Bomba de Vapor no Lago Serpente, no Lago Charco Sombrio, no Lago Pantanoso e na Lagoa. Depois, fale novamente com ela no Refúgio Cenariano, no Pântano Zíngaro, e leve de volta quaisquer sementes que ainda estiverem com você.‡Осыпьте семенами железной лозы пульты управления паровым насосом в Змеином озере, озере Тенетопь, озере Болотных Огоньков и в Лагуне. Затем вернитесь к Исиэль Песни Ветра в Кенарийский приют в Зангартопи и отдайте ей оставшиеся семена.‡Ysiel Windsänger möchte, dass Ihr die Eisenrankensamenkörner benutzt, um die Dampfpumpensteuerungen am Schlangensee, Umbrafennsee, Sumpflichtsee und der Lagune zu zerstören. Kehrt danach mit den übrigen Samen zu ihr in die Zuflucht des Cenarius in den Zangarmarschen zurück.‡물갈퀴 호수, 그늘늪 호수, 수렁등불 호수, 바다자리 호수에 있는 증기 양수기 제어장치에 무쇠덩굴 씨앗을 사용한 뒤에, 남은 씨앗을 가지고 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Ysiel Vientocantor quiere que utilices las semillas de Parraférrea en los controles de las bombas de vapor en el Lago Serpiente, el Lago Umbropantano, el Lago Luz Pantanosa y La Laguna. A continuación vuelve a verla al Refugio Cenarion en la Marisma de Zangar y llévale las sobras que tengas.‡Ysiel Vientocantor quiere que utilices las semillas de Parraférrea en los controles de las bombas de vapor en el Lago Serpiente, el Lago Umbropantano, el Lago Luz Pantanosa y La Laguna. A continuación vuelve a verla al Refugio Cenarion en la Marisma de Zangar y llévale las sobras que tengas.‡Ysiel Chantelevent veut que vous utilisiez les Graines de vignefer sur les Commandes de pompe à vapeur au Lac des serpents, au Lac Umbretourbe, au Lac des furoles et au Lagon. Retournez ensuite lui rendre les graines qu\'il vous reste au Refuge cénarien dans le marécage de Zangar.‡伊谢尔·风歌要你利用铁藤种子，破坏毒蛇湖、暗泽湖、沼光湖和环礁湖的蒸汽泵控制台，然后返回赞加沼泽的塞纳里奥庇护所，将剩余的铁藤种子还给她。‡伊斯歐·風詠要你在毒蛇之湖、昂布拉凡湖、沼澤光之湖和瀉湖的蒸汽泵使用鐵藤之種。再帶著未使用的種子回到贊格沼澤的塞納里奧避難所找她。',
  }
},
[9721] = {
  {
    'Convocação do Lorde Solanar‡Призыв леди Лиадрин‡Aufforderung von Lord Solanar‡솔라나르 경의 호출‡Lord Solanar te convoca‡Lord Solanar te convoca‡Le seigneur Solanar vous réclame‡索拉纳大人的召唤‡索拉納爾領主的召喚',
    nil,
    'Fale com o Lorde Solanar Furiassangue em Luaprata.‡Поговорите с Лордом Соланаром в Луносвете.‡Sprecht mit Lord Solanar Blutzorn in Silbermond.‡실버문에 있는 솔라나르 블러드레이스 경과 대화해야 합니다.‡Habla con Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Habla con Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Parlez au seigneur Solanar Hargnessang à Lune-d\'argent.‡与银月城的索拉纳·血怒谈一谈。‡和銀月城的索拉納爾·血怒領主談談。',
  }
},
[9722] = {
  {
    'O caminho do mestre‡Путь мастера‡Der Pfad des Meisters‡정통 혈기사의 길‡El camino del maestro‡El camino del maestro‡La voie du maître‡大师之路‡大師之路',
    nil,
    'Fale novamente com o Lorde Solanar Furiassangue em Luaprata para aceitar a oferta de apoio dele.‡Поговорите с Лордом Соланаром еще раз и примите предложение о покровительстве.‡Sprecht nochmals mit Lord Solanar Blutzorn, um seine angebotene Unterstützung für Eure Aufnahme zu akzeptieren.‡솔라나르 블러드레이스 경의 후원 제안을 수락하려면 그와 다시 대화해야 합니다.‡Habla con Lord Solanar Sangre Colérica y acepta su ofrecimiento de patrocinio.‡Habla con Lord Solanar Sangre Colérica y acepta su ofrecimiento de patrocinio.‡Allez revoir le seigneur Solanar Hargnessang pour accepter son offre de parrainage.‡再次与索拉纳·血怒交谈，接受他对你的推荐。‡再和索拉納爾·血怒領主談談以接受他的推薦。',
  }
},
[9723] = {
  {
    'Um gesto de comprometimento‡Жест преданности‡Eine Geste der Hingabe‡헌신의 몸짓‡Un gesto de entrega‡Un gesto de entrega‡Un geste d\'engagement‡血骑士的义务‡承諾的手勢',
    nil,
    'Leve 40 Runatramas, 6 Barras de Arcanita, 10 Ervassóis, 5 Runas Negras e 150 de Ouro para o Lorde Solanar Furiassangue em Luaprata.‡Принесите лорду Соланару в Луносвет 40 отрезов рунической ткани, 6 арканитовых слитков, 10 солнечников, 5 темных рун и 150 золотых.‡Bringt 40 Einheiten Runenstoff, 6 Arkanitbarren, 10 Einheiten Sonnengras, 5 Dunkelrunen und 150 Goldstücke zu Lord Solanar Blutzorn in Silbermond.‡실버문에 있는 솔라나르 블러드레이스 경에게 룬무늬 옷감 40개, 아케이나이트 주괴 6개, 태양풀 10개, 암흑의 룬 5개, 그리고 150골드를 가져가야 합니다.‡Lleva 40 paños rúnicos, 6 barras de arcanita, 10 soleas, 5 runas oscuras y 150 piezas de oro a Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Lleva 40 paños rúnicos, 6 barras de arcanita, 10 soleas, 5 runas oscuras y 150 piezas de oro a Lord Solanar Sangre Colérica en la Ciudad de Lunargenta.‡Apporter 40 Etoffes runiques, 6 Barres d\'arcanite, 10 Soleillettes, 5 Runes ténébreuses et 150 pièces d\'or au seigneur Solanar Hargnessang, à Lune-d\'argent.‡将40块符文布、6块奥金锭、10株太阳草、5个黑暗符文和150枚金币交给银月城的索拉纳·血怒。‡帶40塊符文布，6個奧金錠，10根太陽草，5個黑暗符文和150金幣給銀月城的索拉納爾·血怒領主。',
  }
},
[9724] = {
  {
    'Alerte o Círculo Cenariano‡Предупреждение Кругу Кенария‡Den Zirkel des Cenarius warnen‡세나리온 의회에 전하는 경고‡Advertir al Círculo Cenarion‡Advertir al Círculo Cenarion‡Prévenir le Cercle cénarien‡通知塞纳里奥议会‡警告塞納里奧議會',
    nil,
    'Fale com Amithiel Andanévoa no Posto Cenariano, na Península Fogo do Inferno.‡Поговорите с Амитиэль Странницей Туманов на Заставе Кенария на полуострове Адского Пламени.‡Sprecht mit Amythiel Nebelgänger beim Posten des Cenarius auf der Höllenfeuerhalbinsel.‡지옥불 반도의 세나리온 초소에 있는 아미시엘 미스트워커와 대화해야 합니다.‡Habla con Amythel Caminaniebla en el Puesto Cenarion, en la Península del Fuego Infernal.‡Habla con Amythel Caminaniebla en el Puesto Cenarion, en la Península del Fuego Infernal.‡Parlez à Amythiel Marche-brume au Poste cénarien dans la péninsule des Flammes infernales.‡与地狱火半岛的塞纳里奥哨站中的阿米希尔·迷雾行者谈一谈。‡到地獄火半島和塞納里奧前哨的艾咪希·迷霧長者談談。',
  }
},
[9725] = {
  {
    'Demonstração de lealdade‡Доказательство лояльности‡Eine Demonstration Eurer Loyalität‡충성심의 증거‡Una demostración de lealtad‡Una demostración de lealtad‡Une preuve de loyauté‡忠诚的表现‡展現忠誠',
    nil,
    'Lorde Solanar Furiassangue, de Luaprata, quer que você destrua 3 Carroças Carniceiras do Flagelo e mate 15 Engenheiros de Cerco do Flagelo.‡Лорд Соланар Кровогнев из Луносвета просит уничтожить 3 мясных фургона и убить 15 инженеров Плети.‡Lord Solanar Blutzorn in Silbermond möchte, dass Ihr 3 Fleischwagen der Geißel zerstört und 15 Belagerungsingenieure der Geißel tötet.‡실버문에 있는 솔라나르 블러드레이스 경이 스컬지 시체마차 3대를 파괴하고 스컬지 공성 기술병 15명을 처치해 달라고 부탁했습니다.‡Lord Solanar Sangre Colérica en la Ciudad de Lunargenta quiere que destruyas 3 carros de despojos de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Lord Solanar Sangre Colérica en la Ciudad de Lunargenta quiere que destruyas 3 carros de despojos de la Plaga y mates a 15 ingenieros de asedio de la Plaga.‡Le seigneur Solanar Hargnessang, à Lune-d\'argent, veut que vous détruisiez 3 Chariots à viande du Fléau et que vous tuiez 15 Ingénieurs de machines de siège du Fléau.‡银月城的索拉纳·血怒要求你摧毁3台天灾绞肉车，并杀死15名天灾攻城技师。‡銀月城的索拉納爾·血怒領主要你摧毀3台天譴軍團血屍戰車並殺死15個天譴攻城技師。',
  }
},
[9726] = {
  {
    'Agora que somos amigos...‡Теперь, когда мы друзья...‡Jetzt, da wir Freunde sind...‡우정의 확인‡Ahora que somos amigos...‡Ahora que somos amigos...‡Puisque nous sommes entre amis...‡既然我们是朋友......‡既然我們是朋友……',
    nil,
    'Mate 12 Feitores de Escravos Sangrescama e 6 Encantadoras Sangrescama. Em seguida, fale novamente com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Убейте 12 надсмотрщиков за рабами из клана Кровавой Чешуи, 6 чародеек из клана Кровавой Чешуи и возвращайтесь к Гзхун\'тту в Спореггар в Зангартопи.‡Tötet 12 Sklaventreiber der Blutschuppen und 6 Verzauberinnen der Blutschuppen und kehrt dann zu Gzhun\'tt in Sporeggar in den Zangarmarschen zurück.‡피비늘일족 노예감독 12마리, 피비늘일족 마법부여사 6마리를 처치한 후, 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Tuez 12 Esclavagistes Écailles-sanglantes et 6 Enchanteresses Écailles-sanglantes, puis retournez voir Gzhun\'tt à Sporeggar dans le marécage de Zangar.‡杀掉12个血鳞驱奴者和6个血鳞女巫，然后向赞加沼泽孢子村的舒特复命。‡殺死12個血鱗奴隸驅使者和6個血鱗女巫師，再回到贊格沼澤找斯博格爾的卡思汗特。',
  }
},
[9727] = {
  {
    'E como ainda somos amigos...‡Раз уж мы по-прежнему друзья...‡Jetzt, da wir immer noch Freunde sind...‡우정의 재확인‡Ahora que aún somos amigos...‡Ahora que aún somos amigos...‡Puisque nous sommes toujours entre amis...‡既然我们仍是朋友......‡既然我們還是朋友……',
    nil,
    'Mate 12 Feitores de Escravos Sangrescama e 6 Encantadoras Sangrescama. Em seguida, fale novamente com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Убейте 12 надсмотрщиков за рабами из клана Кровавой Чешуи, 6 чародеек из клана Кровавой Чешуи и возвращайтесь к Гзхун\'тту в Спореггар в Зангартопи.‡Tötet 12 Sklaventreiber der Blutschuppen und 6 Verzauberinnen der Blutschuppen und kehrt dann zu Gzhun\'tt in Sporeggar in den Zangarmarschen zurück.‡피비늘일족 노예감독 12마리, 피비늘일족 마법부여사 6마리를 처치한 후, 장가르 습지대의 스포어가르에 있는 그준트에게 돌아가야 합니다.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Mata a 12 explotadores Escamas de Sangre y a 6 encantadoras Escamas de Sangre, y vuelve junto a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Tuez 12 Esclavagistes Écailles-sanglantes et 6 Enchanteresses Écailles-sanglantes, puis retournez voir Gzhun\'tt à Sporeggar dans le marécage de Zangar.‡杀掉12个血鳞驱奴者和6个血鳞女巫，然后向赞加沼泽孢子村的舒特复命。‡殺死12個血鱗奴隸驅使者和6個血鱗女巫師，再回到贊格沼澤找斯博格爾的卡思汗特。',
  }
},
[9728] = {
  {
    'Calorosas boas-vindas‡Теплый прием‡Ein herzliches Willkommen‡격전의 증거‡Una cálida bienvenida‡Una cálida bienvenida‡Un accueil chaleureux‡热情的欢迎‡溫馨款待',
    nil,
    'O Guardião Hamoot, no Refúgio Cenariano, quer que você traga 30 Garras de Naga.‡Принесите стражу Хамуту из Кенарийского приюта 30 когтей наг.‡Bringt 30 Nagaklauen zu Aufseher Hamuht in der Zuflucht des Cenarius.‡세나리온 야영지에 있는 감시자 하무트가 나가 발톱 30개를 가져다 달라고 부탁했습니다.‡El celador Hamoot del Refugio Cenarion quiere que le lleves 30 garras de naga.‡El celador Hamoot del Refugio Cenarion quiere que le lleves 30 garras de naga.‡Le gardien Hamoot du Refuge cénarien veut que vous lui apportiez 30 Griffes de naga.‡将30个纳迦爪子交给塞纳里奥庇护所的监护者哈穆特。‡塞納里奧避難所的守望者漢姆特要你幫他帶來30個納迦之爪。',
  }
},
[9729] = {
  {
    'Fhwoor esmaga!‡Фхвур крушить!‡Fhwoor zerschmettern!‡프우르의 공격!‡¡Fhwoor da el golpe!‡¡Fhwoor da el golpe!‡Fhwoor écrabouiller !‡弗沃尔发怒了！‡擊潰費斯伍爾!',
    nil,
    'Escolte Fhwoor até a área da bomba de vapor pantanosa, para recuperar a Arca de Ssslith. Leve Fhwoor e a arca de volta a salvo e fale com Gzhun\'tt em Sporeggar, no Pântano Zíngaro.‡Проводите Фхвура к паровому насосу на озере Болотных Огоньков, чтобы добыть ковчег Ссслита. Потом доставьте обратно Фхвура и ковчег в целости и сохранности, и вернитесь к Гзхун\'тту в Спореггар в Зангартопи.‡Begleitet Fwoohr in das Gebiet bei der Dampfpumpe am Sumpflichtsee, um die Lade von Ssslith zu holen. Bringt Fhwoor und die Lade sicher zurück und meldet Euch bei Gzhun\'tt in Sporeggar in den Zangarmarschen.‡수렁등불 증기 양수기가 있는 지역까지 프우르를 호위하여 안전하게 쉬슬리스의 방주를 되찾은 후, 장가르 습지대의 스포어가르에 있는 그준트에게 보고해야 합니다.‡Escolta a Fhwoor hasta la zona de la bomba de vapor de la Luz Pantanosa para recuperar el Arca de Ssslith. Asegúrate de que Fhwoor y el arca vuelven sin peligro e informa a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Escolta a Fhwoor hasta la zona de la bomba de vapor de la Luz Pantanosa para recuperar el Arca de Ssslith. Asegúrate de que Fhwoor y el arca vuelven sin peligro e informa a Gzhun\'tt en Esporaggar, en la Marisma de Zangar.‡Escortez Fhwoor près de la pompe à vapeur des Furoles pour récupérer l\'Arche de Ssslith. Ramenez Fhwoor avec l\'arche jusqu\'à un endroit sûr, puis allez faire votre rapport à Gzhun\'tt, à Sporeggar dans le marécage de Zangar.‡护送弗沃尔进入沼光湖水域，在蒸汽泵处找回萨斯里斯圣柜，保护弗沃尔携带圣柜安然返回，然后向赞加沼泽孢子村的舒特复命。‡護送費斯伍爾進入沼澤光蒸汽幫浦區域取得斯利斯方舟。將費斯伍爾和方舟安全地帶回來再去贊格沼澤和斯博葛爾的卡思汗特回報。',
  }
},
[9730] = {
  {
    'Líder dos Cristanegra‡Предводитель Темного Гребня‡Anführer der Dunkelkämme‡암흑갈기일족의 지도자‡El líder de los Cresta Oscura‡El líder de los Cresta Oscura‡Le chef des Sombrecrêtes‡暗潮纳迦的首领‡暗羽領導者',
    nil,
    'Mate o Rajá Haghazed na Lagoa e fale novamente com o Guardião Hamoot na Expedição Cenariana, que fica no Pântano Zíngaro, para receber a sua recompensa.‡Убейте раджу Хагазеда в Лагуне и вернитесь к стражу Хамуту из Кенарийской экспедиции в Зангартопи, чтобы получить награду.‡Tötet Rajah Haghazed bei der Lagune und kehrt danach zu Aufseher Hamuht bei der Expedition des Cenarius in den Zangarmarschen zurück, um eine Belohnung zu erhalten.‡바다자리 호수에 있는 라자 해그헤이즈드를 처치한 후 장가르 습지대의 세나리온 원정대에 있는 감시자 하무트에게 돌아가서 보상을 받아야 합니다.‡Mata al rajá Brujobruma en La Laguna y regresa junto al celador Hamoot de la Expedición Cenarion, en la Marisma de Zangar, por tu recompensa.‡Mata al rajá Brujobruma en La Laguna y regresa junto al celador Hamoot de la Expedición Cenarion, en la Marisma de Zangar, por tu recompensa.‡Tuez Rajah Haghazed au Lagon et retournez voir le gardien Hamoot de l\'Expédition cénarienne dans le marécage de Zangar pour chercher votre récompense.‡杀死环礁湖的哈格哈兹王子，然后返回赞加沼泽的塞纳里奥远征队，向监护者哈穆特领取奖赏。‡殺了瀉湖的洛迦海卡斯特並回到贊格沼澤的塞納里奧遠征隊向守望者漢姆特回報。',
  }
},
[9731] = {
  {
    'Diagrama dos esgotos‡Схема стоков‡Kanalisationspläne‡배수로 설계도‡Planos de conducto‡Planos de conducto‡Plan des canalisations‡抽水泵结构图‡排水結構圖',
    nil,
    'Procure sinais de um dreno no Lago Serpente. Informe suas descobertas a Ysiel Cantavento no Refúgio Cenariano.‡Найдите в Змеином озере признаки утечки воды. Вернитесь к Исиэли Песни Ветра в Кенарийский оплот и сообщите о своем открытии.‡Durchsucht den Grund des Schlangensees nach einem Ablauf. Kehrt mit Neuigkeiten über Eure Entdeckung zu Ysiel Windsänger in der Zuflucht des Cenarius zurück.‡물갈퀴 호수를 조사하여 배수로의 흔적을 찾은 후 발견한 내용을 세나리온 야영지에 있는 이시엘 윈드싱어에게 보고해야 합니다.‡Busca en el fondo del Lago Serpiente signos de un conducto. Regresa junto a Ysiel Vientocantor en el Refugio Cenarion con las noticias de lo que descubras.‡Busca en el fondo del Lago Serpiente signos de un conducto. Regresa junto a Ysiel Vientocantor en el Refugio Cenarion con las noticias de lo que descubras.‡Explorez le Lac des Serpents à la recherche d’un drain. Retournez voir Ysiel Chantelevent au Refuge cénarien pour présenter vos découvertes.‡前往毒蛇湖搜寻抽水泵的踪迹，然后向塞纳里奥庇护所的伊谢尔·风歌汇报你的发现。‡搜尋毒蛇之湖尋找排水管的徵兆。帶著你的發現的消息回到塞納里奧避難所找伊斯歐·風詠。',
  }
},
[9732] = {
  {
    'Retorno ao pântano‡Назад в болото‡Rückkehr in die Marschen‡다시 습지대로‡Regresa a la Marisma‡Regresa a la Marisma‡Retour au marécage‡返回沼泽‡回到沼澤',
    nil,
    'Fale novamente com Ysiel Cantavento no Refúgio Cenariano, no Pântano Zíngaro.‡Вернитесь к Исиэль Песни Ветра в Кенарийском приюте в Зангартопи.‡Kehrt zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡返回赞加沼泽的塞纳里奥庇护所，向伊谢尔·风歌复命。‡回到贊格沼澤塞納里奧避難所的伊斯歐·風詠那裡。',
  }
},
[9733] = {
  {
    'Warning the Cenarion Circle‡Предупреждение Кругу Кенария‡Warnung an den Zirkel des Cenarius‡세나리온 의회에 전하는 경고‡Advertir al Círculo Cenarion‡Advertir al Círculo Cenarion‡Prévenir le Cercle cénarien‡通知塞纳里奥议会‡警告塞納里奧議會',
    nil,
    'Speak to Mahuram Stouthoof at Thrallmar in Hellfire Peninsula.‡Поговорите с Махурамом Крепким Копытом в Траллмаре на Полуострове Адского Пламени.‡Sprecht mit Mahuram Starkhuf in Thrallmar auf der Höllenfeuerhalbinsel.‡지옥불 반도의 스랄마에 있는 마후람 스타우트후프와 대화해야 합니다.‡Habla con Mahuram Pezuña Recia en Thrallmar, en la Península del Fuego Infernal.‡Habla con Mahuram Pezuña Recia en Thrallmar, en la Península del Fuego Infernal.‡Parlez à Mahuram Sabot-robuste à Thrallmar dans la péninsule des Flammes infernales.‡与地狱火半岛的萨尔玛城中的玛霍拉姆·硬蹄谈一谈。‡到地獄火半島的索爾瑪和馬琥藍·胖蹄談談。',
  }
},
[9734] = {
  {
    'Return to the Marsh‡Возвращение на болота‡Rückkehr in die Marschen‡다시 습지대로‡Regresa a la Marisma‡Regresa a la Marisma‡Retour au marécage‡DEPRECATED‡回到沼澤',
    nil,
    'Return to Ysiel Windsinger at the Cenarion Refuge in Zangarmarsh.‡Вернитесь к Исиэль Песни Ветра в Кенарийском приюте в Зангартопи.‡Kehrt zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 돌아가야 합니다.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Regresa junto a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Retournez voir Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡返回向赞加沼泽塞纳里奥庇护所的Ysiel复命。‡回到贊格沼澤塞納里奧避難所的伊斯歐·風詠那裡。',
  }
},
[9735] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Lorde Solanar Furiassangue, de Luaprata, quer que você traga para ele um frasco da Água Sagrada da Manopla de Tyr.‡Принесите фиал святой воды Длани Тира Лорду Соланару Кровогневу в Луносвет.‡Bringt Lord Solanar Blutzorn in Silbermond eine Phiole Weihwasser von Tyrs Hand.‡실버문에 있는 솔라나르 블러드레이스 경이 티르의 손 성수 한 병을 가져다달라고 부탁했습니다.‡Lord Solanar Sangre Colérica, en la Ciudad de Lunargenta, quiere le lleves 1 vial de agua sagrada de la Mano de Tyr.‡Lord Solanar Sangre Colérica, en la Ciudad de Lunargenta, quiere le lleves 1 vial de agua sagrada de la Mano de Tyr.‡Le seigneur Solanar Hargnessang de Lune-d\'argent veut que vous lui apportiez une fiole d\'Eau bénite de la Main de Tyr.‡银月城的索拉纳·血怒要求你给他带回一瓶提尔之手圣水。‡銀月城的索拉納爾·血怒領主要你幫他帶來提爾之手聖水。',
  }
},
[9736] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Lorde Solanar Furiassangue, de Luaprata, quer que você traga para ele 1 Catalisador Arcano, 1 Pó Crepuscular, 1 Diamante Azerotiano e 1 Diamante Preto Límpido.‡Принесите Лорду Соланару Кровогневу в Луносвет 1 чародейский катализатор, 1 меру сумеречного порошка, 1 азеротский алмаз и 1 безупречный черный алмаз.‡Bringt Lord Solanar Blutzorn in Silbermond 1 arkanen Katalysator, 1 Einheit krepuskulares Pulver, 1 azerothischen Diamanten und 1 makellosen schwarzen Diamanten.‡실버문에 있는 솔라나르 블러드레이스 경이 비전 촉매, 황혼의 가루, 아제로스 다이아몬드, 온전한 검은 다이아몬드를 하나씩 가져다달라고 부탁했습니다.‡Lord Solanar Sangre Colérica de Ciudad de Lunargenta quiere que le lleves 1 catalizador arcano, 1 partículas Crepusculares, 1 diamante de Azeroth y 1 diamante negro prístino.‡Lord Solanar Sangre Colérica de Ciudad de Lunargenta quiere que le lleves 1 catalizador arcano, 1 partículas Crepusculares, 1 diamante de Azeroth y 1 diamante negro prístino.‡Le seigneur Solanar Hargnessang de Lune-d\'argent veut que vous lui apportiez 1 Catalyseur arcanique, 1 Poudre crépusculaire, 1 Diamant d\'Azeroth et 1 Diamant noir parfait.‡银月城的索拉纳·血怒要求你给他带回一份奥术触媒、一份黄昏之尘、一颗艾泽拉斯钻石和一颗原始黑钻石。‡銀月城的索拉納爾·血怒領主要你幫她帶來1份秘法催化劑，1份微光粉末，1顆艾澤拉斯鑽石和1顆原始黑鑽石。',
  }
},
[9737] = {
  {
    'True Masters of the Light‡Истинные владыки Света‡Wahre Meister des Lichts‡진실로 빛에 정통한 자‡Verdaderos maestros de la Luz‡Verdaderos maestros de la Luz‡Les vrais maîtres de la Lumière‡圣光的主人‡聖光真正的主人',
    nil,
    'Use a Mistura Extintora perto da chama eterna na Capela Alonsus para remover a proteção da Luz. Prepare-se para enfrentar defensores da capela.‡Потушите неугасимое пламя часовни Алонсия с помощью огнетушительной смеси и уничтожьте всех, кто попробует защитить часовню.‡Verwendet die Löschmischung in der Nähe der ewigen Flamme in der Alonsuskapelle, um den Schutz des Lichts zu brechen. Seid bereit, jeden zu töten, der versucht, die Kapelle zu verteidigen.‡알론서스 교회의 영원의 불꽃 근처에서 소멸의 혼합물을 사용하여 신성한 빛의 보호막을 제거해야 합니다. 교회를 지키기 위해 당신을 공격하는 자가 있으면 모두 해치우십시오.‡Utiliza la mezcla de extinción cerca de la llama eterna de la Capilla de Alonsus para eliminar la protección de la Luz. Prepárate para luchar contra cualquiera que pretenda defender la capilla.‡Utiliza la mezcla de extinción cerca de la llama eterna de la Capilla de Alonsus para eliminar la protección de la Luz. Prepárate para luchar contra cualquiera que pretenda defender la capilla.‡Utilisez la Mixture d\'extinction près de la flamme éternelle dans la chapelle d\'Alonsus pour ôter la protection de la Lumière. Vainquez quiconque tentera de défendre la chapelle.‡在阿隆索斯礼拜堂的永恒之焰上使用熄焰之水，除去圣光的保护，然后消灭所有试图保卫礼拜堂的人。‡在阿隆索斯教堂的永恆火焰旁使用混合物撲滅劑來移除聖光的防護。準備和任何要保衛教堂的人作戰。',
  }
},
[9738] = {
  {
    'Perdidos em ação‡Пропавшие без вести‡Bei der Arbeit verschollen‡실종된 동료‡Desaparecidos en combate‡Desaparecidos en combate‡Disparus au combat‡失踪的同伴‡無法行動',
    nil,
    'Descubra o que aconteceu com o Ataterra Rayge, o Naturalista Mordida, o Mondadeiro Dedo Verde e o Arauto do Vento Garra. Em seguida, fale novamente com a Vigia Jhang no Reservatório Presacurva, que fica no Pântano Zíngaro.‡Выясните, что стало с заклинателем земли Гневвсом, натуралистом Кусом, культиватором Зеленопалом и призывателем ветров Когтем. Затем возвращайтесь к дозорному Джанг в резервуар Кривого Клыка в Зангартопь.‡Findet heraus, was mit Erdbinder Rayge, Naturalist Biss, Jäter Gründaum und Windrufer Klaue geschehen ist. Kehrt dann zu Behüterin Jhang im Echsenkessel in den Zangarmarschen zurück.‡대지의 결속자 레이지, 식물학자 바이트, 약초학자 그린썸, 바람소환사 클로에게 무슨 일이 생겼는지 알아본 후, 장가르 습지대의 갈퀴송곳니 저수지에 있는 감시자 쟝에게 돌아가야 합니다.‡Averigua qué le ha ocurrido al vinculador terrestre Rayge, al naturalista Mordisco, al desherbador Pulgarverde y al clamavientos Zarpa. Después, vuelve junto al vigía Jhang en la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Averigua qué le ha ocurrido al vinculador terrestre Rayge, al naturalista Mordisco, al desherbador Pulgarverde y al clamavientos Zarpa. Después, vuelve junto al vigía Jhang en la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Découvrez ce qui est arrivé au lieur de terre Rayge, au naturaliste Morsure, à l\'Échardonneur Vertemain et à l\'implorateur céleste Griffe. Retournez ensuite voir la guetteuse Jhang au réservoir de Glissecroc dans le marécage de Zangar.‡查明缚地者雷葛、博学者拜特、除草者格林萨姆和唤风者克劳恩的下落，然后返回赞加沼泽的盘牙水库，向观察者杰哈恩复命。‡調查縛地者瑞吉，自然學家拜特，威德·綠指和喚風者卡勞發生了什麼事。然後再回到贊格沼澤的盤牙蓄湖找看守者詹汗格。',
  }
},
[9739] = {
  {
    'A situação dos Sporeggar‡Проблемы спорлингов‡Die Misere der Sporlinge‡스포어링의 곤경‡La aflicción de los esporinos‡La aflicción de los esporinos‡Les malheurs des sporelins‡孢子人的困境‡孢子人的困境',
    nil,
    'Fahssn, no Vale dos Rebentos, quer que você colete 10 Esporângios Maduros.‡Соберите 10 мешочков зрелых спор по просьбе Фассна с Грибной поляны.‡Fahssn im Pilzgeflecht möchte, dass Ihr 10 reife Sporenbeutel sammelt.‡부화의 골짜기에 있는 파흐슨이 완전히 자란 포자 주머니 10개를 모아달라고 부탁했습니다.‡Fahssn, de La Cañada Emergente, quiere que reúnas 10 bolsas de esporas maduras.‡Fahssn, de La Cañada Emergente, quiere que reúnas 10 bolsas de esporas maduras.‡Fahssn au vallon des pontes veut que vous collectiez 10 Sacs de spores mûres.‡孢殖林的法恩森要你收集10个成熟的孢子囊。‡重生峽谷的法斯恩要你收集10個成熟的孢子囊。',
  }
},
[9740] = {
  {
    'O Portal Solar‡Солнечные Ворота‡Das Sonnentor‡태양의 문‡El portal solar‡El portal solar‡Le portail du soleil‡太阳之门‡太陽之門',
    nil,
    'O Vindicante Aesom, do Entreposto Rubro, quer que você destrua o Portal Solar.‡Воздаятель Эсом с Кровавой заставы хочет, чтобы солнечные врата были уничтожены.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr das Sonnentor zerstört.‡핏빛 전초기지에 있는 구원자 아에솜이 태양의 문을 파괴해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que destruyas el portal solar.‡El vindicador Aesom de la Avanzada de Sangre quiere que destruyas el portal solar.‡Le redresseur de torts Aesom du Guet du sang veut que vous détruisiez le Portail du soleil.‡秘血岗哨的守备官伊索姆要你摧毁太阳之门。‡血色守望的復仇者艾伊森要你摧毀太陽之門。',
  }
},
[9741] = {
  {
    'Criaturas do caos‡Твари из Бездны‡Geschöpfe aus der Leere‡공허의 피조물‡Alimañas del vacío‡Alimañas del vacío‡Les bestioles du vide‡虚空幼体‡虛無異常者',
    nil,
    'Mate 12 Bichos do Caos e apresente-se ao Vindicante Aesom no Entreposto Rubro.‡Убейте 12 тварей Бездны и сообщите об этом на Кровавую заставу воздаятелю Эсому.‡Tötet 12 Geschöpfe der Leere und erstattet Verteidiger Aesom bei der Blutwacht Bericht.‡공허의 피조물 12마리를 처치한 후 핏빛 감시초소에 있는 구원자 아에솜에게 보고해야 합니다.‡Mata 12 alimañas del vacío e informa luego al vindicador Aesom en la Avanzada de Sangre.|n‡Mata 12 alimañas del vacío e informa luego al vindicador Aesom en la Avanzada de Sangre.|n‡Tuez 12 Bestioles du Vide et faites votre rapport au redresseur de torts Aesom au Guet du sang.‡杀死12个虚空幼体，然后向秘血岗哨的守备官伊索姆复命。‡殺死12個虛無異常者再向血色守望的復仇者艾伊森回報。',
  }
},
[9742] = {
  {
    'Mais esporângios!‡Новые мешочки со спорами‡Noch ein paar Sporensäcke‡포자 주머니 추가 수집‡Más bolsas de esporas‡Más bolsas de esporas‡Encore des sacs de spores‡更多孢子囊‡更多孢子囊',
    nil,
    nil,
  }
},
[9743] = {
  {
    'Inimigos naturais‡Природные враги‡Natürliche Feinde‡자연의 적‡Enemigos naturales‡Enemigos naturales‡Ennemis par nature‡天敌‡自然天敵',
    nil,
    'Fahssn no Vale dos Rebentos, no Pântano Zíngaro, quer que você traga 6 Gavinhas de Senhor do Brejo.‡Принесите Фассну с Грибной поляны в Зангартопи 6 усиков болотника.‡Bringt 6 Sumpflordranken zu Fahssn im Pilzgeflecht in den Zangarmarschen.‡장가르 습지대의 부화의 골짜기에 있는 파흐슨이 수렁군주 덩굴손 6개를 가져다 달라고 부탁했습니다.‡Fahssn, de La Cañada Emergente en la Marisma de Zangar, quiere que le lleves 6 zarcillos de señor de la marisma.‡Fahssn, de La Cañada Emergente en la Marisma de Zangar, quiere que le lleves 6 zarcillos de señor de la marisma.‡Fahssn, du vallon des pontes du marécage de Zangar, veut que vous lui rameniez 6 Vrilles de seigneurs-tourbe.‡将6根沼泽领主的卷须交给赞加沼泽孢殖林的法恩森。‡贊格沼澤，重生峽谷的法斯恩要你幫他帶來6個泥沼領主藤鬚。',
  }
},
[9744] = {
  {
    'Mais gavinhas!‡Еще усиков!‡Mehr Ranken!‡덩굴손 추가 수집‡¡Más zarcillos!‡¡Más zarcillos!‡Plus de vrilles !‡更多卷须！‡更多藤鬚!',
    nil,
    nil,
  }
},
[9746] = {
  {
    'No limite‡Границы возможного‡Grenze der Erschöpfung‡태양매 소탕‡Los límites del agotamiento‡Los límites del agotamiento‡Les limites de l\'épuisement physique‡精疲力尽‡體能極限',
    nil,
    'O Vindicante Aesom, no Entreposto Rubro, quer que você mate 10 Piromantes Falconélius e 10 Defensores Falconélius.‡Убейте 10 пиромантов и 10 защитников Солнечных Ястребов и сообщите об этом на Кровавую заставу воздаятелю Эсому.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr 10 Pyromanten der Sonnenfalken und 10 Verteidiger der Sonnenfalken tötet.‡핏빛 전초기지에 있는 구원자 아에솜이 태양매 화염술사, 태양매 파수병을 각각 10명씩 처치해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que mates a 10 pirománticos de los Halcones del Sol y a 10 defensores de los Halcones del Sol.|n‡El vindicador Aesom de la Avanzada de Sangre quiere que mates a 10 pirománticos de los Halcones del Sol y a 10 defensores de los Halcones del Sol.|n‡Le redresseur de torts Aesom au Guet du sang veut que vous tuiez 10 Pyromanciens Epervier du soleil et 10 Défenseurs Epervier du soleil.‡杀死10个炎鹰火法师和10个炎鹰防御者，然后向秘血岗哨的守备官伊索姆复命。‡血色守望的復仇者艾伊森要你殺死10個太陽之鷹控火者和10個太陽之鷹防衛者。',
  }
},
[9747] = {
  {
    'A tribo do Charco Sombrio‡Племя Тенетопи‡Der Umbrafennstamm‡그늘늪일족‡La tribu Umbropantano‡La tribu Umbropantano‡La tribu Umbretourbe‡暗泽部族‡昂布拉凡部族',
    nil,
    'Ikeyen, no Refúgio Cenariano, quer que você vá até a Aldeia do Charco Sombrio e mate Kataru, 8 Videntes do Charco Sombrio, 6 Mandingueiros do Charco Sombrio e 6 Oráculos do Charco Sombrio.‡Отправляйтесь в деревню Тенетопь и убейте Катару, 8 провидцев, 6 знахарей и 6 оракулов из племени Тенетопи по просьбе Икейена из Кенарийского приюта.‡Ikeyen in der Zuflucht des Cenarius möchte, dass Ihr nach Umbrafenn reist und Kataru, 8 Seher von Umbrafenn, 6 Hexendoktoren von Umbrafenn und 6 Orakel von Umbrafenn tötet.‡세나리온 야영지에 있는 이케옌이 그늘늪 마을로 가서 카타루, 그늘늪일족 점쟁이 8명, 그늘늪일족 예언자 6명, 그늘늪일족 의술사 6명을 처치해 달라고 부탁했습니다.‡Ikeyen del Refugio Cenarion quiere que vayas a la Aldea Umbropantano y mates a Kataru, 8 videntes de Umbropantano, 6 médicos brujos de Umbropantano y 6 oráculos de Umbropantano.‡Ikeyen del Refugio Cenarion quiere que vayas a la Aldea Umbropantano y mates a Kataru, 8 videntes de Umbropantano, 6 médicos brujos de Umbropantano y 6 oráculos de Umbropantano.‡Ikeyen du Refuge cénarien veut que vous vous rendiez au village Umbretourbe pour y tuer Kataru, 8 Prophètes d\'Umbretourbe, 6 Féticheurs d\'Umbretourbe et 6 Oracles d\'Umbretourbe.‡塞纳里奥庇护所的伊卡因希望你前往暗泽村，杀死卡塔鲁、8个暗泽先知、6个暗泽巫医和6个暗泽神谕者。‡塞納里奧避難所的伊奇言要你前往昂布拉凡村殺死卡塔魯，8個昂布拉凡先知，6個昂布拉凡巫醫和6個昂布拉凡神諭者。',
  }
},
[9748] = {
  {
    'Água que passarinho não bebe‡Не пей эту воду!‡Trinkt nicht das Wasser‡마실 수 없는 물‡Agua que no has de beber...‡Agua que no has de beber...‡Ne buvez pas l\'eau‡毒水‡別喝那裡的水',
    nil,
    'O Vindicante Aesom, do Entreposto Rubro, quer que você use o Frasco para Amostra de Água para pegar uma Amostra de Água de Névoa Rubra.‡Воздаятель Эсом на Кровавой заставе попросил вас принести пробу воды с острова Кровавой Дымки во флаконе, который он предоставил.‡Verteidiger Aesom bei der Blutwacht möchte, dass Ihr den Wasserprobenbehälter verwendet, um eine Wasserprobe der Blutmythosinsel zu entnehmen.‡핏빛 감시초소에 있는 구원자 아에솜이 견본 물병을 사용하여 핏빛안개 물 견본을 채집해 달라고 부탁했습니다.‡El vindicador Aesom de la Avanzada de Sangre quiere que uses el frasco para recoger una muestra de agua de Bruma de Sangre.‡El vindicador Aesom de la Avanzada de Sangre quiere que uses el frasco para recoger una muestra de agua de Bruma de Sangre.‡Le Redresseur de torts Aesom au Guet du sang veut que vous utilisiez le Flacon d\'échantillon d\'eau pour obtenir un Échantillon d\'eau de Brume-sang.‡用水样瓶取回一份秘血岛水样，然后向秘血岗哨的守备官伊索姆复命。‡血色守望的復仇者艾伊森要你使用水樣本瓶取得血謎水樣本。',
  }
},
[9749] = {
  {
    'They\'re Alive! Maybe...‡Они живы! Может быть…‡Sie leben! Vielleicht...‡생존자 구출‡¡Viven! A lo mejor...‡¡Viven! A lo mejor...‡Ils sont vivants ! Peut-être...‡DEPRECATED‡他們還活著!或許吧……',
    nil,
    'Researcher Cornelius has asked that you free 5 Expedition Researchers.‡Освободите 5 ученых экспедиции по просьбе ученого Корнелиуса.‡Forscher Cornelius hat Euch darum gebeten, 5 Expeditionsforscher zu befreien.‡연구원 코르넬리우스가 원정대 연구원 5명을 구해 달라고 부탁했습니다.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡El investigador Cornelius ha pedido que liberes 5 investigadores de la expedición.‡Le Chercheur Cornelius a demandé que vous libériez 5 Chercheurs de l\'expédition.‡Researcher Cornelius要你解救5个Expedition Researchers。‡研究員卡尼勒斯要你救出5個遠征隊研究員。',
  }
},
[9750] = {
  {
    'UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery‡UNUSED Urgent Delivery',
    nil,
    nil,
  }
},
[9751] = {
  {
    'O Almirante Negro‡Наследие Проклятой Крови‡Das Vermächtnis des Blutfluchs‡핏빛저주의 유산‡El legado de la Sangre Maldita‡El legado de la Sangre Maldita‡L\'héritage du sang maudit‡血咒的遗产‡血咒遺產',
    nil,
    'O Almirante Odisseu pediu para você encontrar e falar com o Capitão Cândido João.‡Адмирал Одиссий просит разыскать капитана Эдварда Хейнса и поговорить с ним.‡Admiral Odesyus hat Euch gebeten, nach Kapitän Edward Hanes zu suchen und mit ihm zu sprechen.‡제독 오디시우스가 선장 에드워드 헤인즈를 찾아서 대화해 보라고 부탁했습니다.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡El almirante Odesyus te ha pedido que encuentres al capitán Edward Hanes y hables con él.‡L\'amiral Odesyus vous a demandé de trouver le capitaine Edward Hanes et de lui parler.‡海军上将奥德修斯要你找到艾德华·汉斯船长，然后与他谈一谈。‡艦隊司令·奧迪席斯要你去找隊長艾德華·漢尼斯並和他談談。',
  }
},
[9752] = {
  {
    'Fuga do Charco Sombrio‡Спасение с озера Тенетопь‡Flucht aus Umbrafenn‡그늘늪 탈출‡Evasión de Umbropantano‡Evasión de Umbropantano‡L\'évadée d\'Umbretourbe‡逃离暗泽村‡逃離昂布拉凡',
    nil,
    'Escolte Kayra Jubalonga até Refúgio Cenariano, no Pântano Zíngaro. Apresente-se a Ysiel Cantavento quando completar essa tarefa.‡Проводите Кайру Длинную Гриву в Кенарийский приют в Зангартопи. Выполнив эту задачу, поговорите с Исиэль Песнью Ветра.‡Begleitet Kayra Langmähne zur Zuflucht des Cenarius in den Zangarmarschen. Gebt Ysiel Windsänger Bescheid, sobald Ihr diese Aufgabe erledigt habt.‡카이라 롱메인을 호위해서 장가르 습지대에 있는 세나리온 야영지까지 간 후 이시엘 윈드싱어에게 보고해야 합니다.‡Acompaña a Kayra Crin Larga al Refugio Cenarion en la Marisma de Zangar. Después ve a ver a Ysiel Vientocantor.‡Acompaña a Kayra Crin Larga al Refugio Cenarion en la Marisma de Zangar. Después ve a ver a Ysiel Vientocantor.‡Escortez Kayra Long-crin jusqu\'au Refuge cénarien dans le marécage de Zangar. Présentez-vous à Ysiel Chantelevent lorsque vous aurez accompli cette tâche.‡护送凯拉·长鬃返回赞加沼泽的塞纳里奥庇护所，然后向伊谢尔·风歌复命。‡護送凱拉·長鬃回到贊格沼澤的塞納里奧避難所。完成任務後向伊斯歐·風詠回報。',
  }
},
[9753] = {
  {
    'O que sabemos...‡То, что мы знаем...‡Was wir wissen...‡알아낸 정보‡Saber es poder‡Saber es poder‡Ce que nous savons...‡我们所知道的......‡我們所知道的事……',
    nil,
    'Fale com o Exarca Admetius no Entreposto Rubro.‡Поговорите с экзархом Адметиусом на Кровавой заставе.‡Sprecht mit Exarch Admetius bei der Blutwacht.‡핏빛 감시초소에 있는 총독 애드미티우스와 대화해야 합니다.‡Habla con el exarca Admetius en Avanzada de Sangre.‡Habla con el exarca Admetius en Avanzada de Sangre.‡Parlez à l\'exarque Admetius au Guet du sang.‡与秘血岗哨的主教埃德门图斯谈一谈。‡和血色守望的主教阿德密特斯談談。',
  }
},
[9756] = {
  {
    'O que não sabemos...‡То, чего мы не знаем...‡Was wir nicht wissen...‡알아야 할 정보‡Lo que no sabemos‡Lo que no sabemos‡Ce que nous ne savons pas...‡我们不知道的......‡我們不知道的事……',
    nil,
    'Fale com o Agente Falconélius Capturado no Entreposto Rubro e obtenha as Informações sobre os Falconélius. Fale novamente com o Exarca Admetius quando completar a missão.‡Поговорите с пленным агентом Солнечных Ястребов, которого держат на Кровавой заставе. Передайте полученные сведения экзарху Адметиусу.‡Sprecht mit einem gefangenen Agenten der Sonnenfalken bei der Blutwacht und eignet Euch Informationen der Sonnenfalken an. Kehrt zu Exarch Admetius zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡핏빛 감시초소에 있는 사로잡힌 태양매 첩보원과 대화하여 태양매에 대한 정보를 알아낸 후 총독 애드미티우스에게 돌아가야 합니다.‡Habla con un agente Halcón del Sol capturado en Avanzada de Sangre y consigue información. Luego ve a ver al exarca Admetius.‡Habla con un agente Halcón del Sol capturado en Avanzada de Sangre y consigue información. Luego ve a ver al exarca Admetius.‡Parlez à un agent Epervier du soleil capturé au Guet du sang et obtenez des informations secrètes des Eperviers du soleil. Retournez auprès de l\'exarque Admetius quand vous aurez terminé cette tâche.‡与秘血岗哨的被抓住的炎鹰间谍交谈，了解炎鹰的相关信息。完成任务后向主教埃德门图斯复命。‡和血色守望被俘虜的太陽之鷹密探談談並取得太陽之鷹情報。完成任務後回報主教阿德密特斯。',
  }
},
[9757] = {
  {
    'Encontre a Caçadora Kella Arconyx‡Охотница Келла Тетива Ночи‡Sucht Jägerin Kella Nachtbogen auf‡여사냥꾼과의 대화하기‡La cazadora Kella Arconocturno‡La cazadora Kella Arconocturno‡Aller trouver la chasseresse Kella Arquenuit‡寻找女猎手凯拉·夜弓‡尋找女獵人凱拉·夜弓',
    nil,
    'Fale com a Caçadora Kella Arconyx perto do Atracadouro de Valaar.‡Поговорите с охотницей Келлой Тетивой Ночи рядом с причалом Валаара.‡Sprecht mit Jägerin Kella Nachtbogen nahe Valaars Steg.‡발라르의 나루 근처에 있는 여사냥꾼 켈라 나이트보우와 대화해야 합니다.‡Habla con la cazadora Kella Arconocturno cerca del Atracadero de Valaar.‡Habla con la cazadora Kella Arconocturno cerca del Atracadero de Valaar.‡Parlez à la chasseresse Kella Arquenuit près de l\'Amarrage de Valaar.‡与瓦拉尔港口附近的女猎手凯拉·夜弓谈一谈。‡和瓦拉船台附近的女獵人凱拉·夜弓談談。',
  }
},
[9758] = {
  {
    'Fale com o arcanista Vandril‡Возвращение к чародею Вандрилу‡Rückkehr zu Arkanist Vandril‡비전술사 반드릴에게 돌아가기‡Regresa junto al arcanista Vandril‡Regresa junto al arcanista Vandril‡Retourner voir l\'arcaniste Vandril‡返回奥术师范迪瑞尔身边‡回到秘法師范德隆那裡',
    nil,
    'Fale novamente com o Arcanista Vandril em Tranquillien, que fica na Terra Fantasma.‡Возвращайтесь к чародею Вандрилу в Транкивиллион, что в Призрачных землях.‡Kehrt zu Arkanist Vandril in Tristessa in den Geisterlanden zurück.‡유령의 땅, 트랜퀼리엔에 있는 비전술사 반드릴에게 돌아가십시오.‡Llévaselos al arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Preséntate ante el arcanista Vandril en Tranquillien, en las Tierras Fantasma.‡Retournez voir l\'arcaniste Vandril à Tranquillien dans les Terres fantômes.‡返回幽魂之地的塔奎林，与奥术师范迪瑞尔谈一谈。‡回到鬼魂之地的安寧地找秘法師范德隆。',
  }
},
[9759] = {
  {
    'A missão suicida‡Отречемся от старого мира‡Ihre Welt enden lassen‡사선으로...‡El fin de su mundo‡El fin de su mundo‡La fin de leur monde‡终结他们的世界‡結束他們的世界',
    nil,
    'Siga e proteja o Demolidor Legoso enquanto ele tenta destruir a Espiral Vetorial e mate Sironas. Fale novamente com o Exarca Admetius no Entreposto Rubro após cumprir a missão.‡Подрывник Легосо собирается разрушить энергоблок и убить Сиронас. Попытайтесь защитить его и, если задание будет успешно выполнено, расскажите об этом экзарху Адметиусу на Кровавой заставе.‡Folgt und beschützt Demolierer Legoso, während er versucht, die Vektorspule zu zerstören und tötet Sironas. Kehrt zu Exarch Admetius bei der Blutwacht zurück, sobald Ihr Eure Aufgabe erfüllt habt.‡폭파병 레고소가 벡터 코일을 파괴하고 시로나스를 해치우는 동안 그를 따라가서 보호하여 임무를 수행한 후, 핏빛 감시초소에 있는 총독 애드미티우스에게 돌아가야 합니다.‡Sigue y protege al demoledor Legoso mientras intenta destruir La Espiral Vectorial y matar a Sironas. Ve a ver al exarca Admetius en la Avanzada de Sangre si completas la misión.‡Sigue y protege al demoledor Legoso mientras intenta destruir La Espiral Vectorial y matar a Sironas. Ve a ver al exarca Admetius en la Avanzada de Sangre si completas la misión.‡Suivez et protégez le démolisseur Legoso pendant qu\'il essaye de détruire la Bobine vectorielle et tuer Sironas. Retournez voir l\'exarque Admetius au Guet du sang si vous réussissez cette mission.‡在爆破专家莱戈苏尝试摧毁矢量感应器的过程中保护他，并杀死希隆娜丝。完成任务后向秘血岗哨的主教埃德门图斯复命。‡在爆破兵勒茍索嘗試摧毀旋繞導航器並殺死賽羅娜斯時跟著他並保護他。完成任務後回到血色守望的主教阿德密特斯那裡。',
  }
},
[9760] = {
  {
    'O Recanto do Vindicante‡Привал Защитника‡Verteidigers Ruh\'‡구원자의 안식처‡El Reposo del Vindicador‡El Reposo del Vindicador‡Le Repos du redresseur de torts‡守备官营地‡復仇者之陵',
    nil,
    'Fale com a Vindicante Corin no Recanto do Vindicante, que fica na Ilha Névoa Rubra.‡Поговорите с воздаятельницей Корин в селении Привал Защитника на острове Кровавой Дымки;.‡Sprecht mit Verteidigerin Corin bei Verteidigers Ruh\' auf der Blutmythosinsel.‡핏빛안개 섬의 구원자의 안식처에 있는 구원자 코린과 대화해야 합니다.‡Habla con el vindicador Corin en El Reposo del Vindicador en Isla Bruma de Sangre.|n‡Habla con el vindicador Corin en El Reposo del Vindicador en Isla Bruma de Sangre.|n‡Parlez au redresseur de torts Corin au Repos du redresseur de torts sur l\'île de Brume-sang.‡与秘血岛守备官营地的守备官考尔琳谈一谈。‡到血謎島和復仇者之陵的復仇者科林談談。',
  }
},
[9761] = {
  {
    'Abrindo caminho‡Расчистка пути‡Den Weg frei machen‡장애물 제거‡Despejando el camino‡Despejando el camino‡Ouvrir la voie‡清除路障‡清除道路',
    nil,
    'A Vindicante Corin, do Recanto do Vindicante, quer que você mate 8 Sabotadores Falconélius e 8 Agentes Falconélius.‡Убейте 8 саботажников и 8 посланников из клана Солнечных Ястребов и сообщите об этом воздаятельнице Корин в Привале Защитника.‡Verteidigerin Corin bei Verteidigers Ruh\' möchte, dass Ihr 8 Saboteure der Sonnenfalken und 8 Agenten der Sonnenfalken tötet.‡구원자의 안식처에 있는 구원자 코린이 태양매 정찰병, 태양매 첩보원을 각각 8명씩 처치해 달라고 부탁했습니다.‡El vindicador Corin de El Reposo del Vindicador quiere que mates a 8 saboteadores y 8 agentes Halcón del Sol.|n‡El vindicador Corin de El Reposo del Vindicador quiere que mates a 8 saboteadores y 8 agentes Halcón del Sol.|n‡Le redresseur de torts Corin au Repos du redresseur de torts veut que vous tuiez 8 Saboteurs Epervier du soleil et 8 Agents Epervier du soleil.‡杀死8个炎鹰破坏者和8个炎鹰侦察兵，然后向守备官营地的守备官考尔琳复命。‡復仇者之陵的復仇者科林要你殺死8個太陽之鷹破壞者和8個太陽之鷹密探。',
  }
},
[9762] = {
  {
    'A profecia não escrita‡Неписаное пророчество‡Die ungeschriebene Prophezeiung‡두 가지 선물‡La profecía no escrita‡La profecía no escrita‡Une prophétie à écrire‡未知的命运‡未寫下的預言',
    nil,
    nil,
  }
},
[9763] = {
  {
    'O esconderijo do senhor da guerra‡Убежище врага‡Das Versteck des Kriegsherren‡장군의 은신처‡La guarida del Señor de la Guerra‡La guarida del Señor de la Guerra‡Le repaire du seigneur de guerre‡督军的末日‡督軍的藏身之處',
    nil,
    'A Vigia Jhang quer que você encontre e mate o Senhor da Guerra Kalithresh no Reservatório Presacurva.‡Дозорный Джанг хочет, чтобы вы нашли и убили полководца Калитреша в резервуаре Кривого Клыка.‡Behüterin Jhang möchte, dass Ihr Kriegsherr Kalithresh im Echsenkessel findet und tötet.‡감시자 쟝이 갈퀴송곳니 저수지 안에 있는 장군 칼리스레쉬를 찾아서 처치해 달라고 부탁했습니다.‡El vigía Jhang quiere que encuentres y mates al señor de la guerra Kalithresh dentro de la Reserva Colmillo Torcido.‡La vigía Jhang quiere que encuentres y mates al señor de la guerra Kalithresh dentro de la Reserva Colmillo Torcido.‡La guetteuse Jhang veut que vous trouviez et exécutiez le seigneur de guerre Kalithresh à l\'intérieur du réservoir de Glissecroc.‡观察者杰哈恩要求你找到并杀死盘牙水库的督军卡利瑟里斯。‡看守者詹汗格要你找到並殺死盤牙蓄湖裡的督軍卡利斯瑞。',
  }
},
[9764] = {
  {
    'Ordens da Lady Vashj‡Приказы Леди Вайш‡Befehle von Lady Vashj‡여군주 바쉬의 명령서‡Órdenes de Lady Vashj‡Órdenes de Lady Vashj‡Les ordres de dame Vashj‡瓦丝琪的命令‡瓦許女士的命令',
    nil,
    'Leve as Ordens da Lady Vashj para Ysiel Cantavento no Refúgio Cenariano, que fica no Pântano Zíngaro.‡Отнесите приказы леди Вайш Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Bringt die Befehle von Lady Vashj zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 여군주 바쉬의 명령서를 전달해야 합니다.‡Entrega las órdenes de Lady Vashj a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Entrega las órdenes de Lady Vashj a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Apportez les Ordres de dame Vashj à Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡将瓦丝琪女王的命令交给赞加沼泽塞纳里奥庇护所的伊谢尔·风歌。‡將瓦許女士的命令帶到贊格沼澤給塞納里奧避難所的伊斯歐·風詠。',
  }
},
[9765] = {
  {
    'Preparativos de guerra‡Готовится к войне‡Kriegsvorbereitungen‡전쟁 준비‡Preparativos de guerra‡Preparativos de guerra‡Les préparatifs de guerre‡战争准备‡準備作戰',
    nil,
    'Obtenha Armamento Presacurva das nagas do Reservatório Presacurva e fale novamente com Ysiel Cantavento no Refúgio Cenariano, que fica no Pântano Zíngaro.‡Добудьте оружие клана Кривого Клыка у наг в резервуаре Кривого Клыка и принесите его Исиэль Песни Ветра в Кенарийский приют в Зангартопи.‡Besorgt die Waffen des Echsenkessels von den Naga im Echsenkessel und kehrt dann zu Ysiel Windsänger in der Zuflucht des Cenarius in den Zangarmarschen zurück.‡갈퀴송곳니 저수지의 나가에게서 갈퀴송곳니 무기를 얻은 후 장가르 습지대의 세나리온 야영지에 있는 이시엘 윈드싱어에게 가져가야 합니다.‡Consigue armamentos Colmillo Torcido de los nagas en la Reserva Colmillo Torcido y llévaselos a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Consigue armamentos Colmillo Torcido de los nagas en la Reserva Colmillo Torcido y llévaselos a Ysiel Vientocantor en el Refugio Cenarion, en la Marisma de Zangar.‡Procurez-vous des Armes de Glissecroc sur les nagas du réservoir de Glissecroc et apportez-les à Ysiel Chantelevent au Refuge cénarien dans le marécage de Zangar.‡从盘牙水库的纳迦手中夺得盘牙武器，将它们交给赞加沼泽塞纳里奥庇护所的伊谢尔·风歌。‡從盤牙蓄湖的納迦身上取得盤牙裝備並將它們帶回贊格沼澤給塞納里奧避難所的伊斯歐·風詠。',
  }
},
[9766] = {
  {
    'Armamento presacurva‡Оружие Кривого Клыка‡Waffen des Echsenkessels‡갈퀴송곳니 무기 추가 수집‡Armamentos de Colmillo Torcido‡Armamentos de Colmillo Torcido‡Les armes de Glissecroc‡盘牙武器‡盤牙裝備',
    nil,
    nil,
  }
},
[9767] = {
  {
    'Know Your Enemy‡Врага нужно знать в лицо‡Den Feind kennen‡적에 대한 정보‡Conoce a tu enemigo‡Conoce a tu enemigo‡Connais ton adversaire‡DEPRECATED‡了解你的敵人',
    nil,
    'Obtain a Coilfang Spellbook from the naga inside of Coilfang Reservoir and bring it to Ashyen at the Cenarion Refuge in Zangarmarsh.‡Добудьте книгу заклинаний клана Кривого Клыка у наг из резервуара Кривого Клыка и принесите ее Ашьену в Кенарийский приют в Зангартопи.‡Besorgt ein Zauberbuch des Echsenkessels von den Naga im Echsenkessel und bringt es zu Ashyen in der Zuflucht des Cenarius in den Zangarmarschen.‡갈퀴송곳니 안에 있는 나가로부터 갈퀴송곳니 마법책을 얻은 후 장가르 습지대의 세나리온 야영지에 있는 아쉬옌에게 가져가야 합니다.‡Consigue un libro de hechizos Colmillo Torcido de los nagas de la Reserva Colmillo Torcido y llévaselo a Ashyen en el Refugio Cenarion en la Marisma de Zangar.‡Consigue un libro de hechizos Colmillo Torcido de los nagas de la Reserva Colmillo Torcido y llévaselo a Ashyen en el Refugio Cenarion en la Marisma de Zangar.‡Procurez-vous un Grimoire de Glissecroc sur les nagas du réservoir de Glissecroc et apportez-le à Ashyen au Refuge cénarien dans le marécage de Zangar.‡从盘牙水库内的纳迦身上获得一本Coilfang Spellbook，将其带给赞加沼泽内塞纳里奥庇护所的Ashyen。‡從盤牙蓄湖的納迦身上取得盤牙法術書並將它帶到贊格沼澤給塞納里奧避難所的艾斯炎。',
  }
},
[9769] = {
  {
    'Que roupinha mucho louca‡Мода непредсказуема!‡Mode kann man nicht erklären‡패션을 위해서라면‡Antes muertos que sencillos‡Antes muertos que sencillos‡La mode, ça ne s\'explique pas‡时尚无罪‡流行沒有理由',
    nil,
    'Traga 8 Asas Diáfanas de qualquer espécie de vaga-lume do Pântano Zíngaro para Magasha, no Mocó do Rato Lamacento.‡Принесите 8 прозрачных крыльев любых видов светлячков, обитающих в Зангартопи, Магаше с заставы Болотной Крысы.‡Bringt 8 lichtdurchlässige Flügel von einer beliebigen Glühwürmchenart der Zangarmarschen zu Magasha im Sumpfrattenposten.‡늪쥐 감시초소에 있는 마가샤에게 장가르 습지대에 서식하는 반딧불이종 곤충을 처치하고 얻은 투명한 날개 8개를 가져가야 합니다.‡Lleva ocho alas diáfanas de cualquier especie de aguijonero de la Marisma de Zangar a Magasha, en la Avanzada Rata del Pantano.‡Lleva ocho alas diáfanas de cualquier especie de aguijonero de la Marisma de Zangar a Magasha, en la Avanzada Rata del Pantano.‡Apportez 8 Ailes diaphanes de n\'importe quelles lucioles du marécage de Zangar à Magasha au poste du Rat des marais.‡猎杀赞加沼泽的萤火虫，将8片透明的虫翼交给沼泽鼠岗哨的玛加沙。‡從螢光蛾身上弄到8個透明之翼給斯溫派特崗哨的瑪卡莎。',
  }
},
[9770] = {
  {
    'Ameaça presamangue‡Опасные болотные клыки‡Bedrohliche Marschenfänge‡늪송곳니 가오리의 위협‡La amenaza de los Colmillo de la Marisma‡La amenaza de los Colmillo de la Marisma‡Les crocs-du-marais menaçants‡沼牙的威胁‡險惡的沼牙',
    nil,
    'Reavij, no Mocó do Rato Lamacento, quer que você mate 10 Estripadores Presamangue‡Убейте 10 болотных потрошителей по просьбе Реавижа с заставы Болотной Крысы.‡Reavij im Sumpfrattenposten möchte, dass Ihr 10 Marschfangreißer tötet.‡늪쥐 감시초소에 있는 레아비즈가 톱니 늪송곳니 가오리 10마리를 해치워 달라고 부탁했습니다.‡Reavij de la Avanzada Rata del Pantano quiere que mates a 10 destripadores Colmillo de la Marisma.‡Reavij de la Avanzada Rata del Pantano quiere que mates a 10 destripadores Colmillo de la Marisma.‡Reavij du Poste du rat des marais veut que vous alliez tuer 10 Eventreurs Croc-du-marais.‡沼泽鼠岗哨的里维伊要你去杀死10只沼牙撕裂者。‡斯溫派特崗哨的瑞伏基要你殺死10個沼牙撕裂者。',
  }
},
[9771] = {
  {
    'À procura do Batedor Jyoba‡Поиски разведчика Джиобы‡Auf der Suche nach Späher Jyoba‡정찰병 죠바 찾기‡En busca del explorador Jyoba‡En busca del explorador Jyoba‡À la recherche de l\'éclaireur Jyoba‡寻找斥候尤尔巴‡尋找斥候傑巴',
    nil,
    'Procure o Batedor Jyoba no Charco Fantasma, no Pântano Zíngaro.‡Найдите разведчика Джиобу в Мертвой трясине, что в Зангартопи.‡Sucht Späher Jyoba im Todesmoor in den Zangarmarschen.‡장가르 습지대의 죽음의 늪에 있는 정찰병 죠바를 찾아야 합니다.‡Busca al explorador Jyoba en El Lodo Muerto, en la Marisma de Zangar.‡Busca al explorador Jyoba en El Lodo Muerto, en la Marisma de Zangar.‡Partez à la recherche de l\'éclaireur Jyoba à la Morte-bourbe, au Marécage de Zangar.‡在赞加沼泽的死亡泥潭搜寻斥候尤尔巴的下落。‡到贊格沼澤的死亡污泥，尋找斥候傑巴。',
  }
},
[9772] = {
  {
    'Relatório de Jyoba‡Донесение разведчика Джиобы‡Jyobas Bericht‡정찰병 죠바의 보고서‡El informe de Jyoba‡El informe de Jyoba‡Le rapport de Jyoba‡尤尔巴的报告‡傑巴的報告',
    nil,
    'Recupere o Relatório do Batedor Jyoba dos Gigantes Definhados e leve-o para Zurai, no Mocó do Rato Lamacento.‡Добудьте донесение разведчика Джиобы у высохших великанов и вернитесь с ним к Зураю на заставу Болотной Крысы.‡Besorgt Späher Jyobas Bericht von den siechenden Riesen und kehrt dann zu Zurai im Sumpfrattenposten zurück.‡말라 비틀어진 포자거인을 처치하고 정찰병 죠바의 보고서를 찾아서 늪쥐 감시초소에 있는 주라이에게 가져가야 합니다.‡Recupera el informe del explorador Jyoba de los gigantes marchitos y llévaselo a Zurai, en la Avanzada Rata del Pantano.‡Recupera el informe del explorador Jyoba de los gigantes marchitos y llévaselo a Zurai, en la Avanzada Rata del Pantano.‡Reprenez le Rapport de l\'éclaireur Jyoba aux Géants flétris et rapportez-le à Zurai au poste du Rat des marais.‡从枯萎的巨人手中夺回斥候尤尔巴的报告，把它交给沼泽鼠岗哨的祖莱。‡從枯萎的巨人那裡取得斥候傑巴的報告並將它交給斯溫派特崗哨的祖瑞伊。',
  }
},
[9773] = {
  {
    'Chega de cogumelos!‡Довольно грибов!‡Keine Pilze mehr!‡버섯은 질렸다고!‡¡Ya basta de champiñones!‡¡Ya basta de champiñones!‡Plus de champignons !‡别再提蘑菇了！‡不要再給我蘑菇了!',
    nil,
    'Consiga 8 Filés de Enguia das Enguias do Charco Sombrio e leve-os para Magasha, no Mocó do Rato Lamacento.‡Добудьте 8 филе угря с угрей из озера Тенетопь и принесите их Магаше на заставу Болотной Крысы.‡Bringt 8 Aalfilets von Umbrafennaalen zu Magasha im Sumpfrattenposten.‡그늘늪 뱀장어를 처치하고 뱀장어 살토막 8개를 모아서 늪쥐 감시초소에 있는 마가샤에게 가져가야 합니다.‡Recolecta 8 filetes de anguila de las anguilas Umbropantano y llévaselos a Magasha en la Avanzada Rata del Pantano.‡Recolecta 8 filetes de anguila de las anguilas Umbropantano y llévaselos a Magasha en la Avanzada Rata del Pantano.‡Prélever 8 Filets d\'anguilles sur des Anguilles d\'Umbretourbe et les apporter à Magasha, au poste du Rat des marais.‡猎杀暗泽鳗鱼，将8份电鳗鱼片交给沼泽鼠岗哨的玛加沙。‡從昂布拉凡鰻魚身上收集8份鰻魚片並帶給斯溫派特崗哨的瑪卡莎。',
  }
},
[9774] = {
  {
    'Escamas grossas de hidra‡Толстая чешуя гидры‡Dicke Hydraschuppen‡두꺼운 히드라 비늘‡Escama de hidra gruesa‡Escama de hidra gruesa‡Les écailles d\'hydre épaisses‡厚重多头蛇鳞片‡厚多頭蛇鱗片',
    nil,
    'Zurai, no Mocó do Rato Lamacento, quer que você traga 12 Escamas Grossas de Hidra.‡Принесите Зураю на заставу Болотной Крысы 12 толстых чешуек гидры.‡Bringt 12 dicke Hydraschuppen zu Zurai im Sumpfrattenposten.‡늪쥐 감시초소에 있는 주라이가 두꺼운 히드라 비늘 12개를 가져다 달라고 부탁했습니다.‡Zurai en la Avanzada Rata del Pantano quiere que le lleves 12 escamas de hidra gruesas.‡Zurai en la Avanzada Rata del Pantano quiere que le lleves 12 escamas de hidra gruesas.‡Zurai, au poste du Rat des marais, veut que vous lui apportiez 12 Écailles d\'hydre épaisses.‡将12块厚重多头蛇鳞片交给沼泽鼠岗哨的祖莱。‡斯溫派特崗哨的祖瑞伊要你幫他帶來12片厚多頭蛇鱗片。',
  }
},
[9775] = {
  {
    'Apresente-se ao caçador sombrio Denjai‡Донесение темному охотнику Денжаю‡Bericht an Schattenjäger Denjai‡어둠사냥꾼 덴자이에게 보고‡Cazador de las Sombras Denjai‡Cazador de las Sombras Denjai‡Aller voir le chasseur des ombres Denjai‡向暗影猎手德恩加报到‡向暗影獵人丹傑回報',
    nil,
    'Leve o Relatório de Zurai para o Caçador Sombrio Denjai em Zabra\'jin, no Pântano Zíngaro.‡Отнесите донесение Зурая темному охотнику Дэнжаю в Забра\'джин, что в Зангартопи.‡Bringt Zurais Bericht zu Schattenjäger Denjai in Zabra\'jin in den Zangarmarschen.‡장가르 습지대의 자브라진에 있는 어둠사냥꾼 덴자이에게 주라이의 보고서를 가져가야 합니다.‡Lleva el informe de Zurai al cazador de las Sombras Denjai a Zabra\'jin en la Marisma de Zangar.‡Lleva el informe de Zurai al cazador de las Sombras Denjai a Zabra\'jin en la Marisma de Zangar.‡Apportez le Rapport de Zurai au Chasseur des ombres Denjai, à Zabra\'jin, au Marécage de Zangar.‡将祖莱的报告交给赞加沼泽中萨布拉金的暗影猎手德恩加。‡到贊格沼澤的薩布拉金，將祖瑞伊的報告帶給暗影獵人丹傑。',
  }
},
[9776] = {
  {
    'O Porto Orebor‡Прибежище Оребор‡Die Oreborzuflucht‡오레보르 피난처‡El Puerto Orebor‡El Puerto Orebor‡Le Havre d\'Orebor‡奥雷柏尔营地‡奧雷伯爾港',
    nil,
    'Fale com Ikuti no Porto Orebor, no Pântano Zíngaro.‡Поговорите с Икути в Прибежище Оребор, что в Зангартопи.‡Sprecht mit Ikuti in der Oreborzuflucht in den Zangarmarschen.‡장가르 습지대의 오레보르 피난처에 있는 이쿠티와 대화해야 합니다.‡Habla con Ikuti en el Puerto Orebor, en la Marisma de Zangar.‡Habla con Ikuti en el Puerto Orebor, en la Marisma de Zangar.‡Parlez à Ikuti au Havre d\'Orebor, au Marécage de Zangar.‡与赞加沼泽中奥雷柏尔营地的伊库提谈一谈。‡到贊格沼澤的奧雷伯爾港找伊庫堤談談。',
  }
},
[9777] = {
  {
    'Esporos de fulgor‡Споры гриба-блескуна‡Fulgorsporen‡펄고르 버섯‡Esporas refulgentes‡Esporas refulgentes‡Les spores de fulgor‡灿烂的孢子‡明亮孢子',
    nil,
    'Traga 6 Esporos de Fulgor para Ruam, em Telredor.‡Принесите 6 спор гриба-блескуна Руаму в Телредоре.‡Bringt 6 Fulgorsporen zu Ruam in Telredor.‡텔레도르에 있는 루암에게 펄고르 버섯 6개를 가져가야 합니다.‡Lleva 6 esporas refulgentes a Ruam en Telredor.‡Lleva 6 esporas refulgentes a Ruam en Telredor.‡Apportez 6 Spores de fulgor à Ruam, à Telredor.‡将6个灿烂的孢子交给泰雷多尔的鲁埃姆。‡帶6個明亮孢子給泰倫多爾的洛安瑪。',
  }
},
[9778] = {
  {
    'Guardião Hamoot‡Страж Хамут‡Aufseher Hamuht‡감시자 하무트와 대화‡El celador Hamoot‡El celador Hamoot‡Le gardien Hamoot‡监护者哈穆特‡守望者漢姆特',
    nil,
    'Apresente-se ao Guardião Hamoot no Refúgio Cenariano, no Pântano Zíngaro.‡Поговорите со стражем Хамутом в Кенарийском приюте в Зангартопи.‡Meldet Euch bei Aufseher Hamuht in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 감시자 하무트에게 보고해야 합니다.‡Preséntate ante el celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar.‡Preséntate ante el celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar.‡Allez vous présenter au gardien Hamoot au Refuge cénarien dans le marécage de Zangar.‡向赞加沼泽塞纳里奥庇护所的监护者哈穆特报到。‡到贊格沼澤的塞納里奧避難所向守望者漢姆特報告。',
  }
},
[9779] = {
  {
    'Interceptar a mensagem‡Перехват сообщения‡Abfangen der Nachricht‡태양매 서한 탈취‡Interceptando el mensaje‡Interceptando el mensaje‡L\'interception des messages‡拦截情报‡攔截訊息',
    nil,
    'Mate elfos Falconélius até encontrar a Missiva do Falconélius. Em seguida, entregue-a para o Vindicante Boros no Entreposto Rubro.‡Найдите послание Солнечных Ястребов. Возможно, для этого придется убить нескольких из них. Послание должно быть доставлено на Кровавую заставу воздаятелю Боросу.‡Tötet die Elfen der Sonnenfalken, bis Ihr das Schreiben der Sonnenfalken findet, und bringt es zu Verteidiger Boros bei der Blutwacht.‡태양매 서한을 찾을 때까지 태양매 블러드 엘프들을 처치하여 서한을 얻은 후, 핏빛 감시초소에 있는 구원자 보로스에게 가져가야 합니다.‡Mata elfos de Halcón del Sol hasta que encuentres la misiva de Halcón del Sol. Después, vuelve a hablar con el vindicador Boros en Avanzada de Sangre.‡Mata elfos de Halcón del Sol hasta que encuentres la misiva de Halcón del Sol. Después, vuelve a hablar con el vindicador Boros en Avanzada de Sangre.‡Tuez assez d\'elfes Eperviers du soleil pour trouver la Missive des Éperviers du soleil et rapportez-la au Redresseur de torts Boros, au Guet du sang.‡不断杀死炎鹰血精灵，直到你找到炎鹰信函，然后向秘血岗哨的守备官波鲁斯复命。‡殺死太陽之鷹的血精靈們直到你取得太陽之鷹書信，然後交給血色守望的復仇者波羅斯。',
  }
},
[9780] = {
  {
    'Filés de enguia do Charco Sombrio‡Филе угрей из озера Тенетопь‡Aalfilets von Umbrafenn‡그늘늪 뱀장어‡Filetes de anguila de Umbropantano‡Filetes de anguila de Umbropantano‡Les filets d\'anguilles d\'Umbretourbe‡电鳗鱼片‡昂布拉凡鰻魚片',
    nil,
    'Noraani em Telredor quer que você traga 8 Filés de Enguia.‡Принесите Нораани из Телредора 8 филе угря.‡Bringt 8 Aalfilets zu Noraani in Telredor.‡텔레도르에 있는 노라니가 뱀장어 살토막 8개를 가져다 달라고 부탁했습니다.‡Noraani de Telredor quiere que le traigas 8 filetes de anguila.‡Noraani de Telredor quiere que le traigas 8 filetes de anguila.‡Noraani, à Telredor, veut que vous lui apportiez 8 Filets d\'anguille.‡将8份电鳗鱼片交给泰雷多尔的诺兰妮。‡泰倫多爾的諾納尼要你幫她帶來8份鰻魚片。',
  }
},
[9781] = {
  {
    'Muitas bocas para alimentar‡Слишком много ртов!‡Zu viele Mäuler zu stopfen‡식량 경쟁‡Demasiadas bocas que alimentar‡Demasiadas bocas que alimentar‡Trop de bouches à nourrir‡不堪重负‡僧多粥少',
    nil,
    'Mate 10 Hidras Lodosas e fale novamente com Haalrun, em Telredor.‡Убейте 10 болотных гидр и вернитесь к Хаалруну в Телредор.‡Tötet 10 Morasthydras und kehrt zu Haalrun in Telredor zurück.‡수렁 히드라 10마리를 처치한 후 텔레도르에 있는 하알룬에게 돌아가야 합니다.‡Mata 10 hidras de lodazal y vuelve a ver a Haalrun en Telredor.‡Mata 10 hidras de lodazal y vuelve a ver a Haalrun en Telredor.‡Tuez 10 Hydres du bourbier et retournez voir Haalrun à Telredor.‡杀死10只泥潭多头蛇，然后向泰雷多尔的海尔伦复命。‡殺死10個污泥多頭蛇再回到泰倫多爾的哈爾隆恩那裡。',
  }
},
[9782] = {
  {
    'O Charco Fantasma‡Мертвая трясина‡Das Todesmoor‡죽음의 늪‡El Lodo Muerto‡El Lodo Muerto‡La Morte-bourbe‡死亡泥潭‡死亡污泥',
    nil,
    'Traga uma Amostra de Solo do Charco Fantasma para o Vindicante Idaar em Telredor.‡Принесите пробу почвы Мертвой трясины воздаятелю Идаару в Телредоре.‡Bringt eine Erdprobe vom Todesmoor zu Verteidiger Idaar in Telredor.‡텔레도르에 있는 구원자 이다르에게 죽음의 늪 토양 견본을 가져가야 합니다.‡Lleva una muestra de tierra de El Lodo Muerto al vindicador Idaar, en Telredor.‡Lleva una muestra de tierra de El Lodo Muerto al vindicador Idaar, en Telredor.‡Apportez un Échantillon de terre de Morte-bourbe au Redresseur de torts Idaar, à Telredor.‡将一份死亡泥潭土壤样本交给泰雷多尔的守备官伊达尔。‡將死亡污泥泥土樣本帶給泰倫多爾的復仇者伊達爾。',
  }
},
[9783] = {
  {
    'Estiagem anormal‡Неестественная засуха‡Eine unnatürliche Dürre‡혹독한 가뭄‡Una sequía no natural‡Una sequía no natural‡Une sécheresse peu naturelle‡异样的干旱‡不尋常的乾旱',
    nil,
    'O Vindicante Idaar, em Telredor, quer que você mate 12 Gigantes Definhados.‡Убейте 12 иссохших великанов по просьбе воздаятеля Идаара из Телредора.‡Verteidiger Idaar in Telredor möchte, dass Ihr 12 siechende Riesen tötet.‡텔레도르에 있는 구원자 이다르가 말라 비틀어진 포자거인 12마리를 처치해 달라고 부탁했습니다.‡El vindicador Idaar en Telredor quiere que mates 12 gigantes marchitos.‡El vindicador Idaar en Telredor quiere que mates 12 gigantes marchitos.‡Le redresseur de torts Idaar, à Telredor, veut que vous tuiez 12 Géants flétris.‡泰雷多尔的守备官伊达尔要你去杀死12个枯萎的巨人。‡泰倫多爾的復仇者伊達爾要你去殺死12個枯萎的巨人。',
  }
},
[9784] = {
  {
    'Identificar fragmentos de plantas‡Определение растений‡Pflanzenteile identifizieren‡식물 기관 확인‡Identificar partes de plantas‡Identificar partes de plantas‡L\'identification des morceaux de plantes‡鉴定植物‡辨別植物組織',
    nil,
    nil,
  }
},
[9785] = {
  {
    'Bênção dos anciãos‡Благословение Древ‡Der Segen der Uralten‡고대정령의 축복‡Bendición de los ancestros‡Bendición de los ancestros‡La bénédiction des anciens‡古树的祝福‡古樹的祝福',
    nil,
    'A Arauto do Vento Casco Negro quer que você fale com os ancientes Ashyen e Keleth no Refúgio Cenariano e ganhe suas bênçãos.‡Призывательница ветров Черное Копыто просит вас поговорить с древами Ашьеном и Келетом в Кенарийском приюте и получить их благословение.‡Windruferin Schwarzhuf möchte, dass Ihr mit den Urtumen Ashyen und Keleth in der Zuflucht des Cenarius sprecht und um ihren Segen bittet.‡바람소환사 블랙후프가 세나리온 야영지에 있는 아쉬옌과 켈레스와 대화해 보고 그들의 축복을 얻으라고 말했습니다.‡Clamavientos Pezuña Negra quiere que hables con los ancianos Ashyen y Keleth en el Refugio Cenarion y que obtengas su bendición.‡Clamavientos Pezuñanegra quiere que hables con los ancianos Ashyen y Keleth en el Refugio Cenarion y que obtengas su bendición.‡L\'imploratrice céleste Sabot-noir veut que vous alliez parler aux anciens Ashyen et Keleth au Refuge cénarien, pour obtenir leur bénédiction.‡唤风者塔鲁·黑蹄要求你与塞纳里奥庇护所的埃西恩和克勒斯谈一谈，获得古树的祝福。‡喚風者黑蹄要你去和塞納里奧避難所的古樹艾斯炎及奇里斯談談並取得他們的祝福。',
  }
},
[9786] = {
  {
    'As Ruínas de Boha\'mu‡Руины Боха\'му‡Die Ruinen von Boha\'mu‡보하무 폐허‡Las Ruinas Boha\'mu‡Las Ruinas Boha\'mu‡Les ruines de Boha\'mu‡博哈姆废墟‡波哈姆廢墟',
    nil,
    'O Anacoreta Ahuurn em Telredor quer que você explore as Ruínas de Boha\'mu.‡Исследуйте руины Боха\'му по просьбе анахорета Ахуурна из Телредора.‡Anachoret Ahuurn in Telredor möchte, dass Ihr die Ruinen von Boha\'mu erforscht.‡텔레도르에 있는 수도사 아후른이 보하무 폐허를 조사해 달라고 부탁했습니다.‡El anacoreta Ahuurn de Telredor quiere que explores las Ruinas Boha\'mu.‡El anacoreta Ahuurn de Telredor quiere que explores las Ruinas Boha\'mu.‡L\'anachorète Ahuurn de Telredor veut que vous exploriez les Ruines de Boha\'mu.‡泰雷多尔的学者安霍尔要你去侦察博哈姆废墟。‡泰倫多爾的隱士阿浩恩要你去波哈姆廢墟探勘。',
  }
},
[9787] = {
  {
    'Ídolos do Charco das Feras‡Идолы Дикотопи‡Götzen des Wildfennstamms‡야생늪일족 우상‡Ídolos de Feropantano‡Ídolos de Feropantano‡Les idoles des Tourbe-farouches‡蛮沼雕像‡菲拉芬塑像',
    nil,
    'Colete 6 Ídolos de Charco das Feras e devolva-os para o Anacoreta Ahuurn, em Telredor.‡Соберите 6 идолов Дикотопи и вернитесь с ними к анахорету Ахуурну в Телредор.‡Sammelt 6 Wildfenngötzen und kehrt dann zu Anachoret Ahuurn in Telredor zurück.‡야생늪일족 우상 6개를 모은 후 텔레도르에 있는 수도사 아후른에게 가져가야 합니다.‡Recolecta 6 ídolos de Feropantano y llévaselos al anacoreta Ahuurn a Telredor.‡Recolecta 6 ídolos de Feropantano y llévaselos al anacoreta Ahuurn a Telredor.‡Récupérez 6 Idoles tourbe-farouche et rapportez-les à l\'anachorète Ahuurn à Telredor.‡将6个蛮沼雕像交给泰雷多尔的学者安霍尔。‡收集6個菲拉芬塑像並帶回泰倫多爾給隱士阿浩恩。',
  }
},
[9788] = {
  {
    'Um lugar úmido e escuro‡Темное, сырое место‡Ein feuchter, düsterer Ort‡축축하고 어두운 곳‡Un lugar húmedo y sombrío‡Un lugar húmedo y sombrío‡Un lieu sombre et humide‡阴冷之地‡黑暗潮濕的地方',
    nil,
    'Procure pelos Pertences de Ikeyen dentro da caverna ao sul do Charco Sombrio. Devolva-os para Ikeyen no Refúgio Cenariano, no Pântano Zíngaro.‡Отыщите вещи Икейена в пещере к югу от Тенетопи. Верните их Икейену в Кенарийском приюте в Зангартопи.‡Sucht nach Ikeyens Habseligkeiten in einer Höhle südlich von Umbrafenn. Bringt sie zurück zu Ikeyen in der Zuflucht des Cenarius in den Zangarmarschen.‡그늘늪의 남쪽에 있는 동굴 안에서 이케옌의 소지품을 찾은 후, 장가르 습지대의 세나리온 야영지에 있는 이케옌에게 가져가야 합니다.‡Busca las pertenencias de Ikeyen en una cueva al sur de Umbropantano. Llévaselas de vuelta a Ikeyen en el Refugio Cenarion, en la Marisma de Zangar.‡Busca las pertenencias de Ikeyen en una cueva al sur de Umbropantano. Llévaselas de vuelta a Ikeyen en el Refugio Cenarion, en la Marisma de Zangar.‡Cherchez les affaires d\'Ikeyen à l\'intérieur d\'une caverne au sud d\'Umbretourbe. Rapportez-les à Ikeyen au Refuge cénarien dans le marécage de Zangar.‡进入暗泽村以南的一处洞穴寻找伊卡因的物品，把它们还给赞加沼泽塞纳里奥庇护所的伊卡因。‡在昂布拉凡南方的洞穴裡尋找伊奇言的物品。把它們帶回贊格沼澤還給塞納里奧避難所的伊奇言。',
  }
},
[9789] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Cace 12 Fenocerontes e fale novamente com Rosarães Guima, no Safári Rosarães, em Nagrand, para provar seu valor.‡Убейте 12 копытней и вернитесь к Хемингу Эрнестуэю в его охотничий лагерь в Награнде.‡Erlegt 12 Grollhufe und kehrt anschließend zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand zurück, um Euch zu beweisen.‡갈래발굽 12마리를 잡아서 나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 돌아가 사냥 실력을 증명해야 합니다.‡Caza 12 uñagrietas y vuelve a ver a Hemet Nesingwary en el Safari Nesingwary, en Nagrand, para demostrar tu valía.‡Caza 12 uñagrietas y vuelve a ver a Hemet Nesingwary en el Safari Nesingwary, en Nagrand, para demostrar tu valía.‡Chassez 12 Sabots-fourchus et retournez voir Hemet Nesingwary au safari de Nesingwary, en Nagrand, pour prouver votre valeur.‡杀死12头裂蹄牛，然后向纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里复命。‡獵殺12隻裂蹄後回到奈辛瓦里旅隊找赫米特·奈辛瓦里證明自己',
  }
},
[9790] = {
  {
    'Asas diáfanas‡Прозрачные крылья‡Lichtdurchlässige Flügel‡투명한 날개‡Alas diáfanas‡Alas diáfanas‡Ailes diaphanes‡透明的虫翼‡透明之翼',
    nil,
    'Haalrun, em Telredor, quer que você traga 8 Asas Diáfanas de qualquer espécie de vaga-lume do Pântano Zíngaro.‡Принесите Хаалруну из Телредора 8 прозрачных крыльев любых видов светляков, обитающих в Зангартопи.‡Bringt 8 lichtdurchlässige Flügel von einer beliebigen Glühwürmchenart der Zangarmarschen zu Haalrun in Telredor.‡텔레도르에 있는 하알룬이 장가르 습지대에 있는 어떤 반딧불이에게서든 투명한 날개 8개를 구해 가져다 달라고 부탁했습니다.‡Haalrun en Telredor quiere que le lleves 8 alas diáfanas de cualquier especie voladora de la Marisma de Zangar.‡Haalrun en Telredor quiere que le lleves 8 alas diáfanas de cualquier especie voladora de la Marisma de Zangar.‡Haalrun de Telredor veut que vous lui rameniez 8 Ailes diaphanes de n\'importe quelles lucioles du marécage de Zangar.‡猎杀赞加沼泽的萤火虫，将8片透明的虫翼交给泰雷多尔的海尔伦。‡泰倫多爾的哈爾隆恩要你幫他從贊格沼澤的任何螢火蟲身上帶回8個透明之翼。',
  }
},
[9791] = {
  {
    'Ameaça presamangue‡Опасные болотные клыки‡Bedrohliche Marschenfänge‡늪송곳니 가오리의 위협‡La amenaza de los Colmillo de la Marisma‡La amenaza de los Colmillo de la Marisma‡Les crocs-du-marais menaçants‡沼牙的威胁‡險惡的沼牙',
    nil,
    'Mate 10 Estripadores Presamangue e fale novamente com Noraani, em Telredor.‡Убейте 10 болотных потрошителей и вернитесь к Нораани в Телредор.‡Tötet 10 Marschenfangreißer und kehrt dann zu Noraani in Telredor zurück.‡톱니 늪송곳니 가오리 10마리를 처치한 후 텔레도르에 있는 노라니에게 돌아가야 합니다.‡Mata 10 destripadores Colmillo de la Marisma y vuelve a ver a Noraani en Telredor.‡Mata 10 destripadores Colmillo de la Marisma y vuelve a ver a Noraani en Telredor.‡Tuez 10 Eventreurs Croc-du-marais et retournez voir Noraani à Telredor.‡杀掉10个沼牙撕裂者，然后向泰雷多尔的诺兰妮复命。‡殺死10個沼牙撕裂者再回到泰倫多爾的諾納尼那裡。',
  }
},
[9792] = {
  {
    'Uma mensagem para Telaar‡Послание в Телаар‡Eine Botschaft für Telaar‡텔라아르로 전할 메시지‡Un mensaje para Telaar‡Un mensaje para Telaar‡Un message pour Telaar‡前往塔拉‡給泰拉的消息',
    nil,
    'Fale com Nahuud em Telaar, que fica em Nagrand.‡Поговорите с Нахуудом в Телааре в Награнде.‡Sprecht mit Nahuud in Telaar in Nagrand.‡나그란드의 텔라아르에 있는 나후우드와 대화해야 합니다.‡Habla con Nahuud en Telaar, en Nagrand.‡Habla con Nahuud en Telaar, en Nagrand.‡Parlez à Nahuud, à Telaar en Nagrand.‡前往纳格兰，与塔拉的纳霍德谈一谈。‡到納葛蘭和泰拉的納霍德談談。',
  }
},
[9793] = {
  {
    'O destino de Tuurem‡Судьба Туурема‡Das Schicksal von Tuurem‡투렘의 운명‡El destino de Tuurem‡El destino de Tuurem‡La destinée de Tuurem‡图雷姆的命运‡杜瑞的命運',
    nil,
    'Leve a Carta do Vindicante Idaar para Andarl na Fortaleza Alleriana, na Mata Terokkar.‡Отнесите письмо воздаятеля Идаара Андарлу в бастион Аллерии в лесу Тероккар.‡Bringt Verteidiger Idaars Brief zu Andarl in Allerias Feste in den Wäldern von Terokkar.‡테로카르 숲의 알레리아 성채에 있는 안다를에게 구원자 이다르의 편지를 전달해야 합니다.‡Lleva la carta del vindicador Idaar a Andarl en el Bastión Allerian, en el Bosque de Terokkar.‡Lleva la carta del vindicador Idaar a Andarl en el Bastión Allerian, en el Bosque de Terokkar.‡Apportez la Lettre du redresseur de torts Idaar à Andarl au Bastion allérien dans la forêt de Terokkar.‡将守备官伊达尔的信交给泰罗卡森林奥蕾莉亚要塞的安达尔。‡將復仇者伊達爾的信帶到泰洛卡森林給艾蘭里堡壘的安達爾歐。',
  }
},
[9794] = {
  {
    'Sem tempo para curiosos‡Не время для любопытства‡Keine Zeit für Neugier‡궁금해할 새도 없이...‡No hay tiempo para la curiosidad‡No hay tiempo para la curiosidad‡La curiosité est un vilain défaut‡禁止拆阅‡沒時間好奇了',
    nil,
    'Entregue a Carta de Timóteo Dinis a Kialon em Sylvanaar, nas Montanhas da Lâmina Afiada.‡Доставьте письмо Тимоти Киалону в Сильванаар в Острогорье.‡Bringt Timothys Brief zu Kialon in Sylvanaar im Schergrat.‡칼날 산맥의 실바나르에 있는 키알론에게 티모시가 보낸 편지를 전달해야 합니다.‡Lleva la carta de Timothy a Kialon en Sylvanaar, en las Montañas Filospada.‡Lleva la carta de Timothy a Kialon en Sylvanaar, en las Montañas Filospada.‡Apportez la Lettre de Timothy à Kialon à Sylvanaar dans les Tranchantes.‡将迪莫斯的信交给刀锋山希尔瓦纳的基亚隆。‡把提莫斯的信帶給位在劍刃山脈希爾瓦納的齊亞隆。',
  }
},
[9795] = {
  {
    'A ameaça dos ogros‡Угроза со стороны огров‡Die Ogerbedrohung‡오우거의 위협‡La amenaza de los ogros‡La amenaza de los ogros‡La menace ogre‡食人魔的威胁‡巨魔威脅',
    nil,
    'Viaje para a Cidadela do Senhor do Trovão, nas Montanhas da Lâmina Afiada, e fale com Nekthar.‡Отправляйтесь в оплот Громоборцев в Острогорье и поговорите с Нехтаром.‡Reist zur Donnerfeste im Schergrat und sprecht mit Nekthar.‡칼날 산맥에 있는 천둥군주 요새로 가서 네크타르와 대화해야 합니다.‡Ve al Bastión Señor del Trueno en las Montañas Filospada y habla con Nekthar.‡Ve al Bastión Señor del Trueno en las Montañas Filospada y habla con Nekthar.‡Rendez-vous au bastion des Sire-tonnerre dans les Tranchantes, et parlez à Nekthar.‡前往刀锋山的雷神要塞，与奈克塔尔谈一谈。‡前往劍刃山脈的雷霆王村和奈克薩爾談談。',
  }
},
[9796] = {
  {
    'Notícias do Pântano Zíngaro‡Новости из Зангартопи‡Nachricht aus den Zangarmarschen‡장가르 습지대에서 온 소식‡Noticias de la Marisma de Zangar‡Noticias de la Marisma de Zangar‡Des nouvelles du marécage de Zangar‡赞加沼泽的来客‡贊格沼澤的消息',
    nil,
    'Fale com Mokasa na Vila de Quebrapedra, na Mata Terokkar.‡Поговорите с Мокасой в форте Камнеломов в лесу Тероккар.‡Sprecht mit Mokasa in der Steinbrecherfeste in den Wäldern von Terokkar.‡테로카르 숲의 돌망치 요새에 있는 모카사와 대화해야 합니다.‡Habla con Mokasa en el Bastión Rompepedras, en el Bosque de Terokkar.‡Habla con Mokasa en el Bastión Rompepedras, en el Bosque de Terokkar.‡Parlez à Mokasa, au fort des Brise-pierres, dans la forêt de Terokkar.‡前往泰罗卡森林的裂石堡，与莫萨卡谈一谈。‡到泰洛卡森林和碎石堡的莫卡薩談談。',
  }
},
[9797] = {
  {
    'Reforços para Garadar‡Подкрепление для Гарадара‡Verstärkung für Garadar‡가라다르 지원‡Refuerzos para Garadar‡Refuerzos para Garadar‡Des renforts pour Garadar‡支援加拉达尔‡卡拉達爾的援軍',
    nil,
    'Fale com Capitão Kroghan na cidade de Garadar, em Nagrand.‡Поговорите с капитаном Кроганом в Гарадаре в Награнде.‡Sprecht mit Hauptmann Kroghan in Garadar in Nagrand.‡나그란드의 가라다르에 있는 경비대장 크로그한과 대화해야 합니다.‡Habla con el capitán Kroghan en Garadar, en Nagrand.‡Habla con el capitán Kroghan en Garadar, en Nagrand.‡Parlez au capitaine Kroghan à Garadar en Nagrand.‡前往纳格兰的加拉达尔，与克洛坎上尉谈一谈。‡到納葛蘭和卡拉達爾的隊長卡洛克汗談談。',
  }
},
[9798] = {
  {
    'Os planos dos elfos sangrentos‡Планы эльфов крови‡Blutelfenpläne‡블러드 엘프의 계획서‡Planes de los elfos de sangre‡Planes de los elfos de sangre‡Les plans des elfes de sang‡血精灵计划书‡血精靈計畫書',
    nil,
    'Leve os Planos dos Elfos Sangrentos ao Vindicante Aldar no Ponto de Impacto, que fica no Vale Ammen.‡Отнесите планы эльфов крови воздаятелю Алдару на место крушения в долине Аммен.‡Bringt die Blutelfenpläne zu Verteidiger Aldar bei der Absturzstelle im Am\'mental.‡암멘 골짜기의 추락 지점에 있는 구원자 알다르에게 블러드 엘프의 계획서를 가져가야 합니다.‡Lleva los planes de los elfos de sangre al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Lleva los planes de los elfos de sangre al vindicador Aldar en el Lugar del Accidente, en el Valle Ammen.‡Apportez les Plans des elfes de sang au redresseur de torts Aldar au point d\'impact du val d\'Ammen.‡将血精灵计划书交给埃门谷坠毁点的守备官奥达尔。‡帶著血精靈計畫書到安曼谷的失事地點找復仇者艾德。',
  }
},
[9799] = {
  {
    'Trabalho de campo: botânica‡Сбор трав‡Botanische Hilfsarbeit‡식물학적 탐문 조사‡Trabajo de campo‡Trabajo de campo‡Un travail de botanique‡跑腿采花‡植物學家的跑腿任務',
    nil,
    'Colha 3 Flores Corrompidas e leve-as para a Aprendiz Vishael no Ponto de Impacto, que fica no Vale Ammen.‡Сорвите 3 оскверненных цветка и вернитесь к ученице Вишаэль на месте крушения в долине Аммен.‡Sammelt 3 verderbte Blumen und kehrt zu Lehrling Vishael bei der Absturzstelle im Am\'mental zurück.‡오염된 꽃 3개를 모아 암멘 골짜기의 추락 지점에 있는 수습생 비쉘에게 가져가야 합니다.‡Recolecta 3 flores corruptas y llévaselas a la aprendiza Vishael a Lugar del Accidente, en Valle Ammen.‡Recolecta 3 flores corruptas y llévaselas a la aprendiza Vishael a Lugar del Accidente, en Valle Ammen.‡Cueillez 3 Fleurs corrompues et apportez-les à l\'apprentie Vishael au point d\'impact du val d\'Ammen.‡采集3朵被污染的花朵，然后向埃门谷坠毁点的学徒维莎尔复命。‡收集3朵被污染的花朵再回到安曼谷的失事地點找學徒米虛歐。',
  }
},
[9800] = {
  {
    'Grãos muito especiais‡Редкий деликатес‡Eine seltene Bohne‡귀한 콩‡Una extraña judía‡Una extraña judía‡Une graine rare‡稀有的豆子‡稀有的豆子',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você lhe traga 8 Caracolis Digeridos.‡Принесите Повелителю стихий Ло\'апу к Трону Стихий в Награнде 8 семян караколлы.‡Bringt 8 verdaute Caracolibohnen zu Elementarist Lo\'ap am Thron der Elemente.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 반쯤 소화된 카라콜리 8개를 모아 달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que le consigas 8 anacardos digeridos.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que le consigas 8 anacardos digeridos.‡L’Elémentalise Lo’ap, au Trône des éléments de Nagrand, veut que vous lui apportiez 8 Caracolis digérés‡将8颗挖出来的卡拉果交给纳格兰元素王座的元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你幫他帶來8個消化過的豆子。',
  }
},
[9801] = {
  {
    'Coleta de reagentes‡Сбор реагентов‡Die Reagenzien sammeln‡물약 재료 수집‡Recogiendo componentes‡Recogiendo componentes‡Rassembler les composants‡收集材料‡尋找材料',
    nil,
    'O Anacoreta Ahuurn, em Telredor, quer que você traga 4 Olhos de Quirósporo e 4 Tentáculos de Pernalta do Charco.‡Принесите анахорету Ахууму в Телредоре 4 глаза спороската и 4 щупальца болотного долгонога.‡Anachoret Ahuurn in Telredor möchte, dass Ihr ihm 4 Sporensegleraugen und 4 Fennschreitertentakel bringt.‡텔레도르에 있는 수도사 아후른이 포자날개 눈, 성큼걸이 포자손 촉수를 각각 4개씩 가져다 달라고 부탁했습니다.‡El anacoreta Ahuurn de Telredor quiere que le lleves 4 ojos de esporiélago y 4 tentáculos de zancudo pantanoso.‡El anacoreta Ahuurn de Telredor quiere que le lleves 4 ojos de esporiélago y 4 tentáculos de zancudo pantanoso.‡L\'anachorète Ahuurn, de Telredor, veut que vous lui rameniez 4 Yeux de sporoptères et 4 Tentacules de trotteur des tourbières.‡将4只孢子蝠的眼睛和4根沼泽阔步者的触须交给泰雷多尔的学者安霍尔。‡泰倫多爾的隱士阿浩恩要你幫他帶來4個孢子蝙蝠眼睛和4個沼地行者觸鬚。',
  }
},
[9802] = {
  {
    'Plantas do Pântano Zíngaro‡Растения Зангартопи‡Pflanzen der Zangarmarschen‡장가르 습지대의 식물‡Plantas de Marisma de Zangar‡Plantas de Marisma de Zangar‡Les plantes du marécage de Zangar‡赞加沼泽的植物‡贊格沼澤的植物',
    nil,
    'Traga 10 Fragmentos de Plantas não Identificadas para Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Принесите 10 неопознанных частей растений Лоранне Тар\'велл в Кенарийском приюте в Зангартопи.‡Bringt 10 unbekannte Pflanzenteile zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 정체 불명의 식물 기관 10개를 가져가야 합니다.‡Lleva 10 partes de plantas sin identificar a Lauranna Thar\'well al Refugio Cenarion en Marisma de Zangar.‡Lleva 10 fragmentos de plantas sin identificar a Lauranna Thar\'well al Refugio Cenarion en Marisma de Zangar.‡Apportez 10 Morceaux de plantes non identifiées à Lauranna Thar\'well, au Refuge cénarien dans le marécage de Zangar.‡将10株未鉴定过的植物交给赞加沼泽塞纳里奥庇护所的劳兰娜·萨维尔。‡帶10個未經辨認的植物組織到贊格沼澤給塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[9803] = {
  {
    'Mensageiro para o Charco das Feras‡Посланец в Дикотопь‡Botschaft für den Wildfennstamm‡야생늪일족으로 갈 전령‡Mensajero de los Feropantanos‡Mensajero de los Feropantanos‡Un message pour Tourbe-farouche‡蛮沼的信使‡菲拉芬的信差',
    nil,
    'Beba o Elixir de Ahuurn enquanto estiver nas Ruínas de Boha\'mu. Fale com o Ancião Kuruti enquanto estiver na forma de arakkoa.‡Отправляйтесь в руины Боха\'му и выпейте эликсир Ахуурна. Приняв обличье араккоа, поговорите со старейшиной Курути.‡Trinkt Ahuurns Elixier in den Ruinen von Boha\'mu. Sprecht mit dem Ältesten Kuruti in der Form eines Arakkoas.‡보하무 폐허로 가서 아후른의 비약을 마신 후 아라코아의 모습으로 변신하여 장로 쿠루티와 대화해야 합니다.‡Bebe el elixir de Ahuurn cuando estés en las Ruinas Boha\'mu. Habla con el ancestro Kuruti cuando hayas adoptado la forma de un arakkoa.‡Bebe el elixir de Ahuurn cuando estés en las Ruinas Boha\'mu. Habla con el ancestro Kuruti cuando hayas adoptado la forma de un arakkoa.‡Une fois dans les ruines de Boha\'mu, buvez l\'Elixir d\'Ahuurn. Lorsque vous serez sous forme d\'arakkoa, allez parler à l\'Ancien Kuruti.‡到达博哈姆废墟后饮下安霍尔的药剂，伪装成鸦人，然后与长者库鲁提谈一谈。‡到達波哈姆廢墟後喝下阿浩恩藥劑。在阿拉卡形態下和年長的克魯提談談。',
  }
},
[9804] = {
  {
    'Espíritos inquietos do Celicanto‡Беспокойные духи озера Небесной Песни‡Aufgebrachte Geister des Himmelsweisensees‡흥분한 하늘노래의 정령‡Espíritus agitados de Sol Celeste‡Espíritus agitados de Sol Celeste‡Esprits agités de Chanteciel‡天歌湖的元素‡天歌的焦慮精靈',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua 8 Espíritos do Lago.‡Уничтожьте 8 озерных духов по просьбе Повелителя cтихий Ло\'апа, обитающего у Трона Стихий.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr 8 Seegeister tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 호수 정령 8마리를 해치워 달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas 8 espíritus del lago.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas 8 espíritus del lago.‡L\'élémentaliste Lo\'ap, du Trône des éléments en Nagrand, veut que vous détruisiez 8 Esprits du lac.‡消灭8个湖水之魂，然后向纳格兰元素王座的元素师鲁艾普复命。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀8個湖中水之靈。',
  }
},
[9805] = {
  {
    'Bênção de Incineratus‡Благословение Возжигателя‡Segen des Incineratus‡인시네라투스의 축복‡Bendición de Incineratus‡Bendición de Incineratus‡La bénédiction d\'Incineratus‡伊森拉图斯的祝福‡辛納瑞塔斯的祝福',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua a Grande Cabana, a Cabana do Oeste, a Cabana do Sul e a Cabana do Leste, todas na Aldeia Canavento.|n|nAo terminar a tarefa, devolva o Fogo Vivo ao Elementalista Lo\'ap.‡Спалите самый большой дом и три лачуги на западной, восточной и южной окраинах деревни Трепещущего Тростника.|n|nКогда выполните поручение, верните живой огонь повелителю стихий Ло\'апу.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr die große Hütte, die westliche Hütte, die südliche Hütte und die östliche Hütte in Schilftanz zerstört.|n|nBringt das beseelte Feuer zurück zu Elementarist Lo\'ap, wenn Ihr fertig seid.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 바람갈대 마을에 있는 대형 막사, 서부 막사, 남부 막사, 동부 막사를 파괴해 달라고 부탁했습니다.|n|n일을 마치면 정령술사 로아프에게 살아있는 불을 가지고 돌아가십시오.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la Cabaña Grande, la Cabaña del Oeste, la Cabaña del Sur y la Cabaña del Este en la Aldea Junco Alabeado.|n|nDevuelve el fuego viviente al elementalista Lo\'ap cuando hayas completado tu tarea.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la Cabaña Grande, la Cabaña del Oeste, la Cabaña del Sur y la Cabaña del Este en la Aldea Junco Alabeado.|n|nDevuelve el fuego viviente al elementalista Lo\'ap cuando hayas completado tu tarea.‡L\'Elémentaliste Lo\'ap, au Trône des éléments, en Nagrand, veut que vous détruisiez la Grande hutte, la Hutte de l\'ouest, la Hutte du sud et la Hutte de l\'est à Ventejonc.|n|nRendez le Feu vivant à l\'Elémentaliste Lo\'ap quand vous aurez terminé votre tâche.‡纳格兰元素王座的元素师鲁艾普要你焚毁风茅村的大棚屋、西部棚屋、南部棚屋和东部棚屋。|n|n完成任务后将活火还给元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀風蘆村的大營房，西營房，南營房，和東營房。|n|n完成任務後將生命之火還給元素師羅艾柏。',
  }
},
[9806] = {
  {
    'Esporos férteis‡Прорастающие споры‡Fruchtbare Sporen‡생식 포자‡Esporas fértiles‡Esporas fértiles‡Des spores fertiles‡成熟的孢子‡豐饒孢子',
    nil,
    'Gshaff quer que você recolha 6 Esporos Férteis dos vários Quirósporos e Pernaltas do Pântano no Pântano Zíngaro. Fale novamente com Gshaff em Sporeggar quando tiver completado a tarefa.‡Соберите 6 прорастающих спор с различных спороскатов и болотобродов. Выполнив задачу, вернитесь к Гшаффу в Спореггар.‡Sammelt 6 fruchtbare Sporen von den Sporenseglern und den Marschenläufern der Zangarmarschen und kehrt danach zu Gshaff in Sporeggar zurück.‡장가르 습지대의 다양한 포자날개와 습지대 포자손에게서 생식 포자 6개를 모은 후 스포어가르에 있는 그샤프에게 돌아가야 합니다.‡Gshaff quiere que reúnas 6 esporas fértiles entre los esporiélagos y los caminantes de marismas de la Marisma de Zangar. Vuelve a ver a Ghsaff en Esporaggar cuando hayas completado la tarea.‡Gshaff quiere que reúnas 6 esporas fértiles entre los esporiélagos y los caminantes de marismas de la Marisma de Zangar. Vuelve a ver a Ghsaff en Esporaggar cuando hayas completado la tarea.‡Gshaff veut que vous récoltiez 6 Spores fertiles sur les Sporoptères et Marcheurs des marais du marécage de Zangar. Revenez voir Gshaff à Sporeggar quand vous aurez terminé cette tâche.‡从赞加沼泽的孢子蝠和泥沼游荡者身上收集6个成熟的孢子，把它们交给孢子村的格沙弗。‡吉薩夫要你從贊格沼澤不同的孢子蝙蝠和沼澤行者身上收集6份豐饒孢子。完成任務後回到斯博格爾找吉薩夫。',
  }
},
[9807] = {
  {
    'Mais esporos férteis‡Новые прорастающие споры‡Noch mehr fruchtbare Sporen‡생식 포자 추가 수집‡Más esporas‡Más esporas‡Plus de spores fertiles‡更多成熟的孢子‡更多豐饒孢子',
    nil,
    nil,
  }
},
[9808] = {
  {
    'Chapéus-opalinos‡Грибы-огнешляпки‡Glühkappenpilze‡초롱버섯‡Fluochampiñones‡Fluochampiñones‡Les chapeluisants‡亮顶蘑菇‡白閃菇',
    nil,
    'Traga 10 Chapéus-opalinos para Msshi\'fn em Sporeggar, no Pântano Zíngaro.‡Принесите 10 огнешляпок Мссхи\'фну в Спореггар в Зангартопи.‡Bringt 10 Glühkappen zu Msshi\'fn in Sporeggar in den Zangarmarschen.‡장가르 습지대의 스포어가르에 있는 므쉬픈에게 초롱버섯 10개를 가져가야 합니다.‡Lleva 10 fluochampiñones a Msshi\'fn a Esporaggar en Marisma de Zangar.‡Lleva 10 fluochampiñones a Msshi\'fn a Esporaggar en Marisma de Zangar.‡Apportez 10 Chapeluisants à Msshi\'fn de Sporeggar, dans le marécage de Zangar.‡将10枚亮顶蘑菇交给赞加沼泽孢子村中的姆希菲。‡帶10個白閃菇到贊格沼澤給斯博格爾的米斯恩。',
  }
},
[9809] = {
  {
    'Mais chapéus-opalinos‡Нужно больше грибов!‡Noch mehr Glühkappen‡초롱버섯 추가 수집‡Más fluochampiñones‡Más fluochampiñones‡Plus de chapeluisants‡更多亮顶蘑菇‡更多白閃菇',
    nil,
    nil,
  }
},
[9810] = {
  {
    'Espírito poluído‡Оскверненный дух‡Der verschmutzte Geist‡오염된 영혼‡El espíritu contaminado‡El espíritu contaminado‡L\'esprit pollué‡污染的灵魂‡被污染的靈魂',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você destrua a Essência Poluída de Watoosun e 8 Irrompedores do Lago.‡Уничтожьте загрязненную сущность Ватуусана и 8 озерных волноплесков по просьбе Повелителя cтихий Ло\'апа.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr Watoosuns verschmutzte Essenz und 8 Seewoger tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 와투순의 오염된 정수와 굽이치는 호수 정령 8마리를 처치해 달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la esencia contaminada de Watoosun y 8 mareas del lago.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que destruyas la esencia contaminada de Watoosun y 8 mareas del lago.‡L’Elémentaliste Lo’ap, au Trône des éléments, en Nagrand, veut que vous détruisiez l’Essence polluée de Watoosun et 8 Surgisseurs du lac.‡杀死瓦图苏的污染精华和8个湖水涌动者，然后向纳格兰元素王座的元素师鲁艾普复命。‡納葛蘭，元素王座的元素師羅艾柏要你摧毀瓦吐森的污染精華和8個湖水元素。',
  }
},
[9811] = {
  {
    'Amigo dos Sin\'dorei‡Друг син\'дорай‡Freund der Sin\'dorei‡신도레이의 친구‡Amigos de los sin\'dorei‡Amigos de los sin\'dorei‡L\'amitié des Sin\'dorei‡辛多雷的朋友‡辛多雷的朋友',
    nil,
    'Leve a Cabeça de Dar\'Khan para Lor\'themar Theron em Luaprata.‡Принесите голову Дар\'Хана Лор\'темару Терону в Луносвет.‡Bringt Dar\'Khans Kopf zu Lor\'themar Theron in Silbermond.‡다르칸을 처치하고 실버문에 있는 로르테마르 테론에게 그 증거를 가져가야 합니다.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron a Ciudad de Lunargenta.‡Lleva la cabeza de Dar\'Khan a Lor\'themar Theron a Ciudad de Lunargenta.‡Apportez la Tête de Dar\'Khan à Lor\'themar Theron, à Lune-d\'argent.‡将达尔坎的徽记交给银月城的洛瑟玛·塞隆。‡把達克汗的頭顱交給銀月城的洛索瑪·塞隆。',
  }
},
[9812] = {
  {
    'Carta para Sylvana‡Посол к Орде‡Gesandter zur Horde‡사절로서 호드에 파견되다‡Enviado de la Horda‡Enviado de la Horda‡Emissaire auprès de la Horde‡部落的特使‡部落的使者',
    nil,
    'Leve a Carta de Lor\'themar Theron para a Grande Dama Sylvana Correventos na Cidade Baixa, a capital dos Renegados que fica nas Clareiras de Tirisfal.‡Отнесите письмо от Лор\'темара Терона леди Сильване Ветрокрылой в Подгород, столицу Отрекшихся в Тирисфальских лесах.‡Bringt den Brief von Lor\'themar Theron zu Fürstin Sylvanas Windläufer in Unterstadt, der Hauptstadt der Verlassenen in Tirisfal.‡티리스팔 숲에 위치한 포세이큰의 수도인 언더시티로 가서 여군주 실바나스 윈드러너에게 로르테마르 테론의 편지를 전해야 합니다.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Lleva la carta de Lor\'themar Theron a Lady Sylvanas Brisaveloz en Entrañas, la capital de los Renegados, en los Claros de Tirisfal.‡Remettez la Lettre de Lor\'themar Theron à dame Sylvanas Coursevent à Fossoyeuse, la capitale des Réprouvés dans les clairières de Tirisfal.‡到提瑞斯法林地去，将洛瑟玛·塞隆的信交给被遗忘者的首都幽暗城中的希尔瓦娜斯·风行者。‡將來自洛索瑪·塞隆的信帶到幽暗城，提里斯法林地的被遺忘者首都給希瓦娜斯·風行者。',
  }
},
[9813] = {
  {
    'Encontro com o Chefe Guerreiro‡Встреча с вождем‡Ein Treffen mit dem Kriegshäuptling‡대족장 알현‡Encuentro con el Jefe de Guerra‡Encuentro con el Jefe de Guerra‡Rencontrer le chef de guerre‡觐见酋长‡會見大酋長',
    nil,
    'A Grande Dama Sylvana Correventos quer que você leve a Carta Selada por Sylvana para Thrall em Orgrimmar, capital de Durotar.‡Отнесите письмо с печатью Леди Сильваны Ветрокрылой Траллу в Оргриммар, столицу Дуротара.‡Fürstin Sylvanas Windläufer möchte, dass Ihr den Brief mit Sylvanas\' Siegel zu Thrall nach Orgrimmar, Hauptstadt von Durotar, bringt.‡여군주 실바나스 윈드러너가 듀로타의 수도인 오그리마에 있는 스랄에게 실바나스의 인장이 찍힌 편지를 전해 달라고 부탁했습니다.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas a Thrall en Orgrimmar, capital de Durotar.‡Lady Sylvanas Brisaveloz quiere que lleves la carta sellada por Sylvanas a Thrall en Orgrimmar, capital de Durotar.‡Dame Sylvanas veut que vous remettiez la Lettre scellée par Sylvanas à Thrall, à Orgrimmar, la capitale de Durotar.‡希尔瓦娜斯·风行者要求你将她的密信交给杜隆塔尔首都奥格瑞玛的萨尔。‡希瓦娜斯·風行者要你將希瓦娜斯蓋章的信帶到杜洛塔首都，奧格瑪給索爾。',
  }
},
[9814] = {
  {
    'Cogumelos surpresa, cara!‡Грибы-пороховики, слышь?‡Berstkappenpilze, Mann!‡내게 펑갓 버섯을!‡¡Champiñones fulminantes, colega!‡¡Champiñones fulminantes, colega!‡Des têtes-tonnantes, mon pote !‡爆顶蘑菇‡破頂蘑菇，老兄!',
    nil,
    'Traga 6 Cogumelos Surpresa para o Mandingueiro Tor\'gash.‡Принесите знахарю Тор\'геш 6 грибов-пороховиков.‡Bringt Hexendoktor Tor\'gash 6 Berstkappen.‡의술사 토르가쉬에게 펑갓 버섯 6개를 가져가야 합니다.‡Lleva al médico brujo Tor\'gash 6 champiñones fulminantes.‡Lleva al médico brujo Tor\'gash 6 champiñones fulminantes.‡Le féticheur Tor\'gash veut 6 Têtes-tonnantes.‡将6枚爆顶蘑菇交给巫医托尔加什。‡幫巫醫·托卡斯帶6個破頂蘑菇來。',
  }
},
[9815] = {
  {
    'Chafurda mais um pouco‡Грязные делишки‡Schlammtauchen‡진흙으로 잠수‡Bucear en lodo‡Bucear en lodo‡Un plongeon dans la boue‡潜水‡摧毀菌體',
    nil,
    'O Elementalista Lo\'ap, do Trono dos Elementos, em Nagrand, quer que você recolha 5 Núcleos Lamacentos.‡Принесите повелителю стихий Ло\'апу к Трону стихий в Награнде 5 ядер порождений грязи.‡Elementarist Lo\'ap am Thron der Elemente in Nagrand möchte, dass Ihr 5 schlammbesudelte Kerne besorgt.‡나그란드의 정령의 옥좌에 있는 정령술사 로아프가 진흙 덮인 핵 5개를 찾아달라고 부탁했습니다.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que consigas 5 núcleos de lodo.‡El elementalista Lo\'ap en El Trono de los Elementos, en Nagrand, quiere que consigas 5 núcleos de lodo.‡L\'Elémentaliste Lo\'ap, au Trône des éléments, en Nagrand, veut que vous récupériez 5 Noyaux couverts de boue.‡将5个沾满淤泥的核心交给纳格兰元素王座的元素师鲁艾普。‡納葛蘭，元素王座的元素師羅艾柏要你取得5個浮泥核心。',
  }
},
[9816] = {
  {
    'Já viu um desses?‡Видали вы такое?‡Habt Ihr so was schon mal gesehen?‡요렇게 예쁜 멀록을 본 적 있나?‡Mascotas adorables‡Mascotas adorables‡Ouvrez, ouvrez la cage aux...‡你见过鱼人吗？‡你看過他們嗎?',
    nil,
    'Leve a Gaiola de Murloc e ponha-a na pedra lisa perto da Aldeia Lamadaga.‡Отнесите клетку с мурлоками в деревню Остротопь и оставьте ее на плоском камне.‡Bringt den Murlockäfig nach Dolchfenn und stellt ihn auf den flachen Stein in der Nähe des Dorfs.‡멀록 우리를 가지고 가서 비수늪 마을의 평평한 바위 위에 놓아야 합니다.‡Coloca la jaula de múrlocs en la piedra plana cerca de la Aldea Dagapantano.‡Coloca la jaula de múrlocs en la piedra plana cerca de la Aldea Dagapantano.‡Prenez la Cage à murlocs et posez-la sur le rocher plat, près de Tourbedague.‡将鱼人笼放在匕潭村附近的平坦的岩石上。‡帶著魚人鐵籠並將它放在匕首沼地村附近的平坦岩石上。',
  }
},
[9817] = {
  {
    'Líder dos Sangrescama‡Глава клана Кровавой Чешуи‡Anführerin der Blutschuppen‡피비늘일족의 지도자‡Líder de los Escamas de Sangre‡Líder de los Escamas de Sangre‡Le chef des Écailles-sanglantes‡血鳞纳迦的领袖‡血鱗領導者',
    nil,
    'Mate Rajis Fyashe no Lago Serpente e fale com o Guardião Hamoot no Refúgio Cenariano, no Pântano Zíngaro, para receber a recompensa.‡Убейте раджис Фьяше в Змеином озере и вернитесь к стражу Хамуту в Кенарийский приют в Зангартопи, чтобы получить награду.‡Tötet Rajis Fyashe am Schlangensee und kehrt dann zu Aufseher Hamuht in der Zuflucht des Cenarius in den Zangarmarschen zurück, um eine Belohnung zu erhalten.‡물갈퀴 호수에 있는 라지스 피아쉬를 처치한 후, 장가르 습지대의 세나리온 야영지에 있는 감시자 하무트에게 돌아가서 보상을 받아야 합니다.‡Mata a Rajis Fyashe en el Lago Serpiente y ve a ver al celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar para obtener la recompensa.‡Mata a Rajis Fyashe en el Lago Serpiente y ve a ver al celador Hamoot en el Refugio Cenarion, en la Marisma de Zangar para obtener la recompensa.‡Tuez Rajis Fyashe au Lac des Serpents et revenez voir le gardien Hamoot au refuge cénarien dans le marécage de Zangar pour recevoir votre récompense.‡杀死毒蛇湖的弗亚希王女，然后返回赞加沼泽的塞纳里奥庇护所，向监护者哈穆特领取奖赏。‡殺了毒蛇之湖的納吉斯·法亞司再回到贊格沼澤的塞納里奧避難所找守望者漢姆特領取獎勵。',
  }
},
[9818] = {
  {
    'O subterrâneo‡Из глубин‡Im Untergrund‡지하에서...‡Bajo la tierra‡Bajo la tierra‡Les entrailles de la terre‡地下的滋扰‡地底之下',
    nil,
    'Comunique-se com ele.‡Поговорите с Гордаугом.‡Kommuniziert mit Gordawg.‡고르다우그과 대화해야 합니다.‡Comunícate con Gordawg.‡Comunícate con Gordawg.‡Communiquer avec Gordawg.‡与戈达乌沟通。‡和葛爾道格溝通。',
  }
},
[9819] = {
  {
    'Terra atormentada‡Истерзанные духи земли‡Die gequälte Erde‡고통받는 대지‡La tierra torturada‡La tierra torturada‡La terre torturée‡被折磨的地灵‡痛苦的大地',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua 10 Espíritos Telúricos Atormentados.‡Уничтожьте 10 истерзанных духов земли по просьбе Гордага из Трона Стихий Награнда.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr 10 gequälte Erdgeister tötet.‡나그란드의 정령의 옥좌에 있는 고르다우그가 고통받는 대지의 정령 10마리를 해치워 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que acabes con 10 espíritus de tierra torturados.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que acabes con 10 espíritus de tierra torturados.‡Gordawg, du Trône des Éléments en Nagrand, vous a demandé de détruire 10 Esprits de la terre torturés.‡纳格兰元素王座的戈达乌要你消灭10个被折磨的地灵。‡納葛蘭，元素王座的葛爾道格要你去摧毀10個痛苦的大地之靈。',
  }
},
[9820] = {
  {
    'PROCURA-SE: Chefe Grog\'ak‡РАЗЫСКИВАЕТСЯ: Главарь Грог\'ак‡GESUCHT: Boss Grog\'ak‡현상 수배: 우두머리 그록아크‡SE BUSCA: Jefe Grog\'ak‡SE BUSCA: Jefe Grog\'ak‡ON RECHERCHE : Boss Grog\'ak‡通缉：格罗阿克‡懸賞:葛洛卡老大',
    nil,
    'Traga a Cabeça do Chefe Grog\'ak para o Caçador Sombrio Denjai, em Zabra\'jin.‡Принесите голову главаря Грог\'ака темному охотнику Денжаю в Забра\'джин.‡Bringt Boss Grog\'aks Kopf zu Schattenjäger Denjai in Zabra\'jin.‡자브라진에 있는 어둠사냥꾼 덴자이에게 우두머리 그록아크의 머리장식을 가져가야 합니다.‡Lleva la cabeza del jefe Grog\'ak al cazador de las Sombras Denjai en Zabra\'jin.‡Lleva la cabeza del jefe Grog\'ak al cazador de las Sombras Denjai en Zabra\'jin.‡Le chasseur des ombres Denjai, de Zabra\'jin, veut que vous lui apportiez la Tête du boss Gorg\'ak.‡将格罗阿克的徽记交给萨布拉金的暗影猎手德恩加。‡將葛洛卡老大的頭顱帶給薩布拉金的暗影獵人丹傑。',
  }
},
[9821] = {
  {
    'Comendo para a condenação‡Попробовать зло на зуб‡Verdammnis schmecken‡저주를 먹는 자‡Comiendo condenación‡Comiendo condenación‡Damnation au menu‡吞食诅咒‡吃掉精髓',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você lhe traga 10 Núcleos de Esmagador Enfurecido.‡Принесите Гордаугу к Трону Стихий 10 средоточий разъяренных сокрушителей.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr ihm 10 Kerne eines wütenden Zermalmers bringt.‡나그란드의 정령의 옥좌에 있는 고르다우그가 분노한 우레정령의 핵 10개를 가져다 달라고 부탁했습니다.‡Gordawg en El Trono de los Elementos, en Nagrand, te ha pedido que le lleves 10 núcleos de trituradores iracundos.‡Gordawg en El Trono de los Elementos, en Nagrand, te ha pedido que le lleves 10 núcleos de trituradores iracundos.‡Gordawg, au Trône des éléments, en Nagrand, vous a demandé de lui apporter 10 Noyaux d\'écraseur enragé.‡将10块被激怒的碾压者的核心交给纳格兰元素王座的戈达乌。‡納葛蘭，元素王座的葛爾道格要你幫他帶回10個暴怒的粉碎者精髓。',
  }
},
[9822] = {
  {
    'Ataque iminente‡Угроза нападения‡Drohender Angriff‡임박한 공격‡Ataque inminente‡Ataque inminente‡Une attaque imminente‡战斗迫近‡逼近的攻擊',
    nil,
    'Traga o Plano de Ataque Ango\'rosh para o Caçador Sombrio Denjai, em Zabra\'jin.‡Принесите планы нападения клана Анго\'рош темному охотнику Денжаю в Забра\'джин.‡Bringt die Angriffspläne der Ango\'rosh zu Schattenjäger Denjai in Zabra\'jin.‡자브라진에 있는 어둠사냥꾼 덴자이에게 앙고로쉬 공격 계획서를 가져가야 합니다.‡Lleva los planes de ataque de Ango\'rosh al cazador de las Sombras Denjai en Zabra\'jin.‡Lleva los planes de ataque de Ango\'rosh al cazador de las Sombras Denjai en Zabra\'jin.‡Le chasseur des ombres Denjai, de Zabra\'jin, veut que vous lui apportiez les Plans d\'attaque des Ango\'rosh.‡将安葛洛什攻击计划交给交给萨布拉金的暗影猎手德恩加。‡將安格拉斯攻擊計畫帶回薩布拉金給暗影獵人丹傑。',
  }
},
[9823] = {
  {
    'Nós ou eles‡Мы и они‡Sie oder wir‡결전의 순간‡Nosotros o ellos‡Nosotros o ellos‡Eux ou nous‡你死我活‡不是你死就是我活',
    nil,
    'Mate o Lorde Supremo Punho de Sangue, 10 Espancadores Ango\'rosh, 10 Devoralmas Ango\'rosh e fale com o Caçador Sombrio Denjai, em Zabra\'jin.‡Убейте властителя Кровавого Кулака, 10 извергов из клана Анго\'рош и 10 пожирателей душ из клана Анго\'рош и вернитесь к темному охотнику Денжаю в Забра\'джин.‡Tötet Oberanführer Schmetterfaust, 10 Raufer der Ango\'rosh, 10 Seelenfresser der Ango\'rosh und meldet Euch dann bei Schattenjäger Denjai in Zabra\'jin zurück.‡대군주 고어피스트, 앙고로쉬일족 싸움꾼 10마리, 앙고로쉬일족 영혼착취자 10마리를 해치운 다음, 자브라진에 있는 어둠사냥꾼 덴자이에게 돌아가서 보고해야 합니다.‡Mata al señor supremo Puño Sajante, 10 aplastadores Ango\'rosh y 10 devoralmas Ango\'rosh y preséntate ante el cazador de las Sombras Denjai en Zabra\'jin.‡Mata al señor supremo Puño Sajante, 10 aplastadores Ango\'rosh y 10 devoralmas Ango\'rosh y preséntate ante el cazador de las Sombras Denjai en Zabra\'jin.‡Tuez le Suzerain Poing-sanglant, 10 Marteleurs Ango\'rosh et 10 Mangeurs-d\'âmes Ango\'rosh, et faites votre rapport au chasseur des ombres Denjai à Zabra\'jin.‡杀死戈尔费斯大王、10个安葛洛什殴斗者和10个安葛洛什食魂者，完成任务后向萨布拉金的暗影猎手德恩加复命。‡殺了血拳主宰，10個安格拉斯蠻槌兵，和10個安格拉斯噬魂者再向薩布拉金的暗影獵人丹傑回報。',
  }
},
[9824] = {
  {
    'Perturbações arcanas‡Колебания тайной магии‡Arkane Störungen‡발산되는 비전의 힘‡Alteraciones arcanas‡Alteraciones arcanas‡Des troubles arcaniques‡奥术扰动‡秘法干擾',
    nil,
    'Use o Cristal Violeta da Vidência perto de fontes subterrâneas de água no Porão do Senhorio e, depois, fale novamente com o Arquimago Alturus nos arredores de Karazhan.‡Активируйте кристалл ясновидения Аметистового Ока рядом с подземными источниками вод в Хозяйском погребе и вернитесь к верховному магу Альтуру, находящемуся у входа в Каражан.‡Benutzt den violetten Aufzeichnungskristall in der Nähe von unterirdischen Wasserquellen im Keller des Meisters und kehrt zu Erzmagier Alturus außerhalb von Karazhan zurück.‡지배자의 지하실에 있는 지하 수원 근처에서 보랏빛 수정구슬을 사용한 후 카라잔 밖에 있는 대마법사 알투루스에게 돌아가야 합니다.‡Utiliza el cristal de visión violeta cerca de fuentes subterráneas de agua en El Sótano del Maestro y vuelve a ver al archimago Alturus en las afueras de Karazhan.‡Utiliza el cristal de visión violeta cerca de fuentes subterráneas de agua en El Sótano del Maestro y vuelve a ver al archimago Alturus en las afueras de Karazhan.‡Utilisez le Cristal de divination pourpre près des sources d\'eau souterraines dans la Cave du maître, puis retournez voir l\'archimage Alturus à l\'extérieur de Karazhan.‡在麦迪文的酒窖内的地下水源附近使用紫罗兰占卜水晶，然后向卡拉赞外的大法师奥图鲁斯复命。‡到大師的地窖，在靠近地下水源的地方使用紫羅蘭占卜水晶再回到卡拉贊外面的大法師艾特羅斯那裡。',
  }
},
[9825] = {
  {
    'Atividade incessante‡Неустанный труд‡Rastlose Aktivität‡끊임없는 유령의 활동‡Actividad incansable‡Actividad incansable‡L\'agitation des sans-repos‡幽灵的活动‡不安的活動',
    nil,
    'Leve 10 Essências Fantasmagóricas para o Arquimago Alturus nos arredores da torre de Karazhan.‡Принесите 10 призрачных сущностей верховному магу Альтуру, находящемуся у входа в Каражан.‡Bringt 10 geisterhafte Essenzen zu Erzmagier Alturus außerhalb von Karazhan.‡카라잔 밖에 있는 대마법사 알투루스에게 유령의 정수 10개를 가져가야 합니다.‡Lleva 10 esencias fantasmales al archimago Alturus en las afueras de Karazhan.‡Lleva 10 esencias fantasmales al archimago Alturus en las afueras de Karazhan.‡Apportez 10 Essences fantomatiques à l\'Archimage Alturus, à l\'extérieur de Karazhan.‡将10个幽灵精华交给卡拉赞外的大法师奥图鲁斯。‡帶10個鬼魅精華給卡拉贊外面的大法師艾特羅斯。',
  }
},
[9826] = {
  {
    'Contato de Dalaran‡Вести из Даларана‡Dalarankontaktpersonen‡달라란에서의 전갈‡Contacto de Dalaran‡Contacto de Dalaran‡Un envoyé de Dalaran‡联络达拉然‡達拉然的聯繫',
    nil,
    'Leve o Relatório de Alturus para o Arquimago Cedric nos arredores da Cratera de Dalaran.‡Доставьте письмо Альтуруса верховному магу Седрику на окраину кратера Даларана.‡Bringt Alturus\' Bericht zu Erzmagier Cedric am Rande des Dalarankraters.‡달라란 구덩이 외곽에 있는 대마법사 세드릭에게 알투루스의 보고서를 가져가야 합니다.‡Lleva el informe de Alturus al archimago Cedric en la afueras del Cráter de Dalaran.‡Lleva el informe de Alturus al archimago Cedric en la afueras del Cráter de Dalaran.‡Apportez le Rapport d’Alturus à l’Archimage Cédric, à la périphérie du Cratère de Dalaran.‡将奥图鲁斯的报告交给达拉然巨坑外的大法师塞德瑞克。‡將艾特羅斯的報告帶給達拉然陷坑郊區的大法師賽卓克。',
  }
},
[9827] = {
  {
    'Basídio definhado‡Высохшая базидия‡Siechendes Basidium‡말라붙은 담자기‡Basidio marchito‡Basidio marchito‡Le baside racorni‡枯萎的孢芽‡枯萎的孢子臺',
    nil,
    'Leve o Basídio Definhado para Ruam em Telredor, no Pântano Zíngaro.‡Отнесите высохшую базидию Руаму в Телредор, что в Зангартопи.‡Bringt das siechende Basidium zu Ruam in Telredor in den Zangarmarschen.‡장가르 습지대의 텔레도르에 있는 루암에게 말라붙은 담자기를 가져가야 합니다.‡Lleva el basidio marchito a Ruam a Telredor, en la Marisma de Zangar.‡Lleva el basidio marchito a Ruam a Telredor, en la Marisma de Zangar.‡Apportez le Baside racorni à Ruam à Telredor, au Marécage de Zangar.‡将枯萎的孢芽交给赞加沼泽中泰雷多尔的鲁埃姆。‡到贊格沼澤的泰倫多爾，將枯萎的孢子臺帶給洛安瑪。',
  }
},
[9828] = {
  {
    'Basídio definhado‡Высохшая базидия‡Siechendes Basidium‡말라붙은 담자기‡Basidio marchito‡Basidio marchito‡Le baside racorni‡枯萎的孢芽‡枯萎的孢子臺',
    nil,
    'Leve o Basídio Definhado para Reavij no Mocó do Rato Lamacento, no Pântano Zíngaro.‡Отнесите высохшую базидию Реавижу на заставу Болотной Крысы, что в Зангартопи.‡Bringt das siechende Basidium zu Reavij im Sumpfrattenposten in den Zangarmarschen.‡장가르 습지대의 늪쥐 감시초소에 있는 레아비즈에게 말라붙은 담자기를 가져가야 합니다.‡Lleva el basidio marchito a Reavij a la Avanzada Rata del Pantano, en la Marisma de Zangar.‡Lleva el basidio marchito a Reavij a la Avanzada Rata del Pantano, en la Marisma de Zangar.‡Apportez le Baside racorni à Reavij au poste du Rat des marais, au Marécage de Zangar.‡将枯萎的孢芽交给赞加沼泽中沼泽鼠岗哨的里维伊。‡到贊格沼澤的斯溫派特崗哨，將枯萎的孢子臺帶給瑞伏基。',
  }
},
[9829] = {
  {
    'Hadggar‡Кадгар‡Khadgar‡카드가‡Khadgar‡Khadgar‡Khadgar‡卡德加‡卡德加',
    nil,
    'Entregue o Relatório de Alturus para Hadggar, em Shattrath, que fica na Mata Terokkar.‡Доставьте письмо Альтура Кадгару в Шаттрат - город в лесу Тероккар.‡Bringt Alturus\' Bericht zu Khadgar in Shattrath in den Wäldern von Terokkar.‡테로카르 숲의 샤트라스에 있는 카드가에게 알투루스의 보고서를 전달해야 합니다.‡Lleva el informe de Alturus a Khadgar en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Lleva el informe de Alturus a Khadgar en la Ciudad de Shattrath, en el Bosque de Terokkar.‡Remettez le Rapport d\'Alturus à Khadgar, à Shattrath dans la forêt de Terokkar.‡将奥图鲁斯的报告交给泰罗卡森林中沙塔斯城的卡德加。‡將艾特羅斯的報告送到泰洛卡森林給撒塔斯城的卡德加。',
  }
},
[9830] = {
  {
    'Peçonha do sangrador‡Яд паразита‡Blutergift‡반딧불이 독‡Veneno letal‡Veneno letal‡Venin d\'aiguillonneur‡沼泽中的毒液‡刺針毒素',
    nil,
    'Traga 6 Peçonhas de Sangrador Pantanoso para Puluu no Porto Orebor.‡Принесите 6 порций яда болотного паразита Пулуу в прибежище Оребор.‡Bringt 6 Einheiten Sumpflichtblutergift zu Puluu in der Oreborzuflucht.‡오레보르 피난처에 있는 풀루우에게 흡혈 수렁등불 반딧불이 독 6개를 가져가야 합니다.‡Lleva 6 unidades de veneno de sangrador Luz pantanosa a Puluu en el Puerto Orebor.‡Lleva 6 unidades de veneno de sangrador Luz pantanosa a Puluu en el Puerto Orebor.‡Apportez 6 doses de Venin de suce-sang des Furoles à Puluu, au Havre d\'Orebor.‡将6份沼光抽血者的毒液交给奥雷柏尔营地的普尔鲁。‡帶6份沼光流血者毒囊給奧雷伯爾港的保魯。',
  }
},
[9831] = {
  {
    'Entrando em Karazhan‡Вход в Каражан‡Nach Karazhan‡카라잔으로...‡La entrada a Karazhan‡La entrada a Karazhan‡L\'entrée de Karazhan‡卡拉赞的钥匙‡卡拉贊的入口',
    nil,
    'Hadggar quer que você entre no Labirinto Soturno em Auchindoun e recupere o Primeiro Fragmento de Chave de um Recipiente Arcano escondido lá.‡Пройдите в Темный лабиринт в Аукиндоне, найдите там волшебный контейнер и возьмите из него первый фрагмент ключа, после чего вернитесь к Кадгару.‡Khadgar möchte, dass Ihr das Schattenlabyrinth von Auchindoun betretet und das erste Schlüsselfragment aus einem versteckten arkanen Behälter besorgt.‡카드가가 아킨둔의 어둠의 미궁으로 들어가서 그곳에 숨겨진 마법 단지에서 첫 번째 열쇠 조각을 꺼내오라고 부탁했습니다.‡Khadgar quiere que entres en el Laberinto de las Sombras en Auchindoun y recuperes el primer trozo de la llave de un contenedor arcano que está escondido allí.‡Khadgar quiere que entres en el Laberinto de las Sombras en Auchindoun y recuperes el primer trozo de la llave de un contenedor arcano que está escondido allí.‡Khadgar veut que vous entriez dans le Labyrinthe des ombres d\'Auchindoun pour récupérer le Premier fragment de la clé, dans le Récipient arcanique qui y est caché.‡卡德加要求你进入奥金顿的暗影迷宫中，回收储藏在那里的一个奥术容器中的第一块钥匙碎片。‡卡德加要你進入奧齊頓的暗影迷宮並從藏在那裡的秘法容器取得第一塊鑰匙碎片。',
  }
},
[9832] = {
  {
    'O segundo e o terceiro fragmentos‡Второй и третий фрагменты‡Das zweite und das dritte Fragment‡두 번째와 세 번째 조각‡El segundo y tercer trozo‡El segundo y tercer trozo‡Le deuxième et le troisième fragments‡第二块和第三块‡第二和第三個碎片',
    nil,
    'Obtenha o Segundo Fragmento de Chave de um Recipiente Arcano no Reservatório Presacurva, e o Terceiro Fragmento de Chave de um Recipiente Arcano na Bastilha da Tormenta. Fale novamente com Hadggar em Shattrath quando completar a tarefa.‡Добудьте второй фрагмент ключа из волшебного контейнера в резервуаре Кривого Клыка, а третий фрагмент ключа – из волшебного контейнера в Крепости Бурь, после чего вернитесь к Кадгару в Шаттрат.‡Besorgt das zweite Schlüsselfragment aus einem arkanen Behälter im Echsenkessel und das dritte Schlüsselfragment aus einem arkanen Behälter in der Festung der Stürme. Kehrt dann zu Khadgar in Shattrath zurück.‡갈퀴송곳니 저수지 안의 마법 단지에서 두 번째 열쇠 조각을, 폭풍우 요새 내부의 마법 단지에서 세 번째 열쇠 조각을 찾아야 합니다. 모두 찾은 후 샤트라스에 있는 카드가에게 돌아가십시오.‡Consigue el segundo trozo de la llave, que está en un contenedor arcano en la Reserva Colmillo Torcido, y el tercer trozo de la llave, que está en otro contenedor arcano en El Castillo de la Tempestad. Vuelve a ver a Khadgar en la Ciudad de Shattrath cuando lo hayas hecho.‡Consigue el segundo trozo de la llave, que está en un contenedor arcano en la Reserva Colmillo Torcido, y el tercer trozo de la llave, que está en otro contenedor arcano en El Castillo de la Tempestad. Vuelve a ver a Khadgar en la Ciudad de Shattrath cuando lo hayas hecho.‡Trouver le Deuxième fragment de la clé dans un récipient arcanique à l\'intérieur du Réservoir de Glissecroc, et le Troisième fragment de la clé dans un récipient arcanique au Donjon de la tempête. Une fois que ce sera fait, revenir auprès de Khadgar à Shattrath.‡从盘牙水库内的一个奥术容器中拿到第二块钥匙碎片，从风暴要塞内的一个奥术容器中拿到第三块钥匙碎片。任务完成之后向沙塔斯城的卡德加复命。‡在盤牙蓄湖的秘法容器裡取得第二塊鑰匙碎片，風暴要塞的秘法容器裡取得第三塊鑰匙碎片。完成任務後回到撒塔斯城的卡德加那裡。',
  }
},
[9833] = {
  {
    'Linhas de comunicação‡Линии связи‡Verbesserung der Kommunikation‡연락망‡Líneas de comunicación‡Líneas de comunicación‡Les lignes de communication‡通讯路线‡溝通管道',
    nil,
    'Puluu em Porto Orebor quer que você mate 12 Fatiadores Presamangue.‡Убейте 12 болотных терзателей по просьбе Пулуу из прибежища Оребор.‡Puluu in der Oreborzuflucht möchte, dass Ihr 12 Marschenfangschlitzer tötet.‡오레보르 피난처에 있는 풀루우가 칼날턱 늪송곳니 가오리 12마리를 처치해 달라고 부탁했습니다.‡Puluu, en el Puerto Orebor quiere que mates 12 cercenadores Colmillo de la Marisma.‡Puluu, en el Puerto Orebor quiere que mates 12 cercenadores Colmillo de la Marisma.‡Puluu, du Havre d\'Orebor, veut que vous tuiez 12 Trancheurs Croc-du-marais.‡奥雷柏尔营地的普尔鲁要你杀死12个沼牙切割者。‡奧雷伯爾港的保魯要你去殺死12個沼牙分割者。',
  }
},
[9834] = {
  {
    'Armadura natural‡Природная броня‡Natürliche Rüstung‡자연의 갑옷‡Armadura natural‡Armadura natural‡Une armure naturelle‡天然的护甲‡自然護甲',
    nil,
    'Traga 8 Couros de Garrocharco para Maktu no Porto Orebor.‡Принесите 8 шкур болотных твердозубов Макту в прибежище Оребор.‡Bringt 8 Fennklauenbälge zu Maktu in der Oreborzuflucht.‡오레보르 피난처에 있는 막투에게 늪발톱 히드라 가죽 8개를 가져가야 합니다.‡Lleva 8 pellejos de Zarpacieno a Maktu en el Puerto Orebor.‡Lleva 8 pellejos de Zarpacieno a Maktu en el Puerto Orebor.‡Apportez 8 Peaux de tourbegriffes à Maktu au Havre d\'Orebor.‡将8张泥爪皮交给奥雷柏尔营地的玛克图。‡帶8塊沼爪皮給奧雷伯爾港的瑪克吐。',
  }
},
[9835] = {
  {
    'Transgressão Ango\'rosh‡Вторжение клана Анго\'рош‡Vordringen der Ango\'rosh‡앙고로쉬의 침략‡Invasión de los Ango\'rosh‡Invasión de los Ango\'rosh‡Les empiètements des Ango\'rosh‡安葛洛什的威胁‡安格拉斯入侵',
    nil,
    'Mate 10 Ogros Ango\'rosh e 5 Xamãs Ango\'rosh e fale novamente com Ikuti, em Porto Orebor.‡Убейте 10 огров из клана Анго\'рош и 5 шаманов из клана Анго\'рош и вернитесь к Икути в прибежище Оребор.‡Tötet 10 Oger der Ango\'rosh und 5 Schamanen der Ango\'rosh und kehrt dann zu Ikuti in der Oreborzuflucht zurück.‡앙고로쉬 오우거 10마리, 앙고로쉬일족 주술사 5마리를 처치한 후 오레보르 피난처에 있는 이쿠티에게 돌아가야 합니다.‡Mata 10 ogros Ango\'rosh y 5 chamanes Ango\'rosh. Después vuelve a ver a Ikuti en el Puerto Orebor.‡Mata 10 ogros Ango\'rosh y 5 chamanes Ango\'rosh. Después vuelve a ver a Ikuti en el Puerto Orebor.‡Tuez 10 Ogres Ango\'rosh et 5 Chamans Ango\'rosh, puis retournez voir Ikuti au Havre d\'Orebor.‡杀死10个安葛洛什食人魔和5个安葛洛什萨满祭司，然后返回奥雷柏尔营地向伊库提复命。‡殺死10個安格拉斯巨魔和5個安格拉斯薩滿再回到奧雷伯爾港的伊庫堤那裡。',
  }
},
[9836] = {
  {
    'O toque do mestre‡Разрешение учителя‡Die Berührung des Meisters‡메디브와의 만남‡El toque del maestro‡El toque del maestro‡Le toucher du maître‡麦迪文的触摸‡大師之觸',
    nil,
    'Vá até as Cavernas do Tempo e convença Medivh a habilitar a Chave Restaurada do Aprendiz.‡Отправляйтесь в Пещеры Времени и уговорите Медива дать разрешение на использование Восстановленного ключа.‡Geht in die Höhlen der Zeit und überzeugt Medivh davon, den wiederhergestellten Schlüssel des Lehrlings zu aktivieren.‡시간의 동굴 안에 들어간 후 메디브를 설득하여 복원된 수습생의 열쇠를 활성화해야 합니다.‡Ve a las Cavernas del Tiempo y convence a Medivh para que active tu llave de aprendiz restaurada.‡Ve a las Cavernas del Tiempo y convence a Medivh para que active tu llave de aprendiz restaurada.‡Rendez-vous aux Grottes du temps et persuadez Medivh d\'accepter votre Clé de l\'apprenti réparée.‡进入时光之穴，说服麦迪文让复原的学徒钥匙重新获得打开卡拉赞大门的能力。‡進入時光之穴說服麥迪文讓復原的初生之鑰恢復能力。',
  }
},
[9837] = {
  {
    'Retorno a Hadggar‡Возвращение к Кадгару‡Rückkehr zu Khadgar‡카드가에게 돌아가기‡Regresa junto a Khadgar‡Regresa junto a Khadgar‡Retour vers Khadgar‡返回卡德加身边‡回到卡德加那裡',
    nil,
    'Fale novamente com Hadggar em Shattrath e mostre a Chave do Mestre.‡Вернитесь в Шаттрат к Кадгару и покажите ему хозяйский ключ.‡Kehrt zu Khadgar in Shattrath zurück und zeigt ihm den Schlüssel des Meisters.‡샤트라스에 있는 카드가에게 돌아가서 주인의 열쇠를 보여 주어야 합니다.‡Vuelve a ver a Khadgar en la Ciudad de Shattrath y enséñale la llave del maestro.‡Vuelve a ver a Khadgar en la Ciudad de Shattrath y enséñale la llave del maestro.‡Retournez voir Khadgar à Shattrath, et montrez-lui à la Clé du maître.‡将麦迪文的钥匙交给沙塔斯城的卡德加。‡回到撒塔斯城的卡德加那裡並給他大師之鑰。',
  }
},
[9838] = {
  {
    'O Olho Violeta‡Аметистовое Око‡Das Violette Auge‡보랏빛 눈‡El Ojo Violeta‡El Ojo Violeta‡L\'Œil pourpre‡紫罗兰之眼‡紫羅蘭之眼',
    nil,
    'Fale com o Arquimago Alturus nos arredores de Karazhan.‡Поговорите с верховным магом Альтуром, который находится снаружи Каражана.‡Sprecht mit Erzmagier Alturus außerhalb von Karazhan.‡카라잔 밖에 있는 대마법사 알투루스와 대화해야 합니다.‡Habla con el archimago Alturus fuera de Karazhan.‡Habla con el archimago Alturus fuera de Karazhan.‡Parlez à l\'archimage Alturus à l\'extérieur de Karazhan.‡与卡拉赞外的大法师奥图鲁斯谈一谈。‡和卡拉贊外的大法師艾特羅斯談談。',
  }
},
[9839] = {
  {
    'Lorde Supremo Punho de Sangue‡Властитель Кровавый Кулак‡Oberanführer Schmetterfaust‡대군주 고어피스트‡Señor supremo Puño Sajante‡Señor supremo Puño Sajante‡Le suzerain Poing-sanglant‡戈尔费斯大王‡血拳主宰',
    nil,
    'Ikuti quer que você mate o Lorde Supremo Punho de Sangue e 10 Espancadores Ango\'rosh. Fale novamente com Ikuti no Porto Orebor, uma vez que tenha completado a tarefa.‡Убейте властителя Кровавого Кулака и 10 извергов из клана Анго\'рош по просьбе Икути. Выполнив задачу, вернитесь в прибежище Оребор.‡Ikuti möchte, dass Ihr Oberanführer Schmetterfaust und 10 Raufer der Ango\'rosh tötet. Kehrt zur Oreborzuflucht zurück, wenn Ihr die Aufgabe erfüllt habt.‡대군주 고어피스트와 앙고로쉬일족 싸움꾼 10마리를 처치한 후 오레보르 피난처에 있는 이쿠티에게 돌아가야 합니다.‡Ikuti quiere que mates al señor supremo Puño Sajante y a 10 aplastadores Ango\'rosh. Vuelve al Puerto Orebor cuando hayas completado la tarea.‡Ikuti quiere que mates al señor supremo Puño Sajante y a 10 aplastadores Ango\'rosh. Vuelve al Puerto Orebor cuando hayas completado la tarea.‡Ikuti veut que vous tuiez le Suzerain Poing-sanglant et 10 Marteleurs Ango\'rosh. Lorsque vous aurez terminé cette quête, retournez au Havre d\'Orebor.‡杀死戈尔费斯大王和10个安葛洛什殴斗者，完成任务后向奥雷柏尔营地的伊库提复命。‡伊庫堤要你去殺了血拳主宰和10個安格拉斯蠻槌兵。完成任務後回到奧雷伯爾港。',
  }
},
[9840] = {
  {
    'Avaliando a situação‡Оценка ситуации‡Einschätzung der Situation‡내부 상황 파악‡Evaluando la situación‡Evaluando la situación‡Évaluer la situation‡评估事态‡評估狀況',
    nil,
    'Encontre Koren dentro de Karazhan.‡Найдите Корена в Каражане.‡Findet Koren in Karazhan.‡카라잔 안에 있는 코렌을 찾아야 합니다.‡Encuentra a Koren en Karazhan.‡Encuentra a Koren en Karazhan.‡Trouvez Koren à l\'intérieur de Karazhan.‡进入卡拉赞寻找库雷恩。‡找到卡拉贊裡的卡爾侖。',
  }
},
[9841] = {
  {
    'Aguilhoando aguilhantes‡Поделом гнусным тварям!‡Tückische Mücken‡벌처럼 쏘라‡Aguijoneando los aguijoneros‡Aguijoneando los aguijoneros‡Aiguillonner les dards‡清除沼光抽血者‡以牙還牙',
    nil,
    'Mate 8 Sangradores Pantanosos e fale novamente com Gambarinka, em Zabra\'jin.‡Убейте 8 болотных паразитов и вернитесь к Гамбаринке в Забра\'джин.‡Tötet 8 Sumpflichtbluter und kehrt dann zu Gambarinka in Zabra\'jin zurück.‡흡혈 수렁등불 반딧불이 8마리를 해치운 후 자브라진에 있는 감바린카에게 돌아가십시오.‡Mata 8 sangradores Luz Pantanosa y vuelve a ver a Gambarinka en Zabra\'jin.‡Mata 8 sangradores Luz Pantanosa y vuelve a ver a Gambarinka en Zabra\'jin.‡Tuez 8 Suce-sang des furoles et retournez voir Gambarinka à Zabra\'jin.‡杀死8个沼光抽血者，然后向萨布拉金的加巴林卡复命。‡殺死8個沼光流血者再回薩布拉金的坎巴利卡那裡。',
  }
},
[9842] = {
  {
    'As mais afiadas lâminas‡Острейшие резцы‡Die schärfsten Klingen‡최고로 날카로운 칼날턱‡Las hojas más afiladas‡Las hojas más afiladas‡Les lames les mieux affûtées‡最锋利的刀刃‡最鋒利的劍',
    nil,
    'Traga 10 Lâminas de Corte Presamangue para Gambarinka, em Zabra\'jin.‡Принесите 10 зубов болотного терзателя Гамбаринке в Забра\'джине.‡Bringt 10 Marschenfangschlitzerklingen zu Gambarinka in Zabra\'jin.‡자브라진에 있는 감바린카에게 늪송곳니 가오리 칼날턱 10개를 가져가야 합니다.‡Lleva 10 hojas de cercenadores Colmillo de la Marisma a Gambarinka en Zabra\'jin.‡Lleva 10 hojas de cercenadores Colmillo de la Marisma a Gambarinka en Zabra\'jin.‡Apportez 10 Lames de trancheurs Croc-du-marais à Gambarinka à Zabra\'jin.‡将10柄沼牙切割者之刃交给萨布拉金的加巴林卡。‡帶10把沼牙分割者之刃給薩布拉金的坎巴利卡。',
  }
},
[9843] = {
  {
    'Anotações de Keanna‡Записи Кинны‡Keannas Aufzeichnungen‡킨나의 기록‡Los apuntes de Keanna‡Los apuntes de Keanna‡Le journal de Keanna‡金娜的日记‡琪安娜的日誌',
    nil,
    'Vasculhe os Aposentos de Hóspedes em Karazhan, encontre as Anotações de Keanna e leve-as para o Arquimago Alturus nos arredores de Karazhan.‡Найдите Гостевые залы в Каражане, а в них - записи Кеанны, и доставьте их верховному магу Альтуру.‡Durchsucht die Gästezimmer in Karazhan nach Keannas Aufzeichnungen und bringt sie zu Erzmagier Alturus außerhalb von Karazhan.‡카라잔 안에 있는 객실을 뒤져서 킨나의 기록을 찾은 후 카라잔 밖에 있는 대마법사 알투루스에게 가져가야 합니다.‡Busca los apuntes de Keanna en Los Aposentos de Invitados, en Karazhan, y llévaselos al archimago Alturus fuera de Karazhan.‡Busca los apuntes de Keanna en Los Aposentos de los Invitados, en Karazhan, y llévaselos al archimago Alturus fuera de Karazhan.‡Fouillez les Appartements des hôtes à l\'intérieur de Karazhan à la recherche du Journal de Keanna, et apportez-le à l\'archimage Alturus à l\'extérieur de Karazhan.‡在卡拉赞的会客间搜寻金娜的日记，然后将它交给卡拉赞外的大法师奥图鲁斯。‡搜索卡拉贊的客房尋找琪安娜的日誌並帶給卡拉贊外的大法師艾特羅斯。',
  }
},
[9844] = {
  {
    'Uma presença demoníaca‡Присутствие демонов‡Eine dämonische Präsenz‡불타는 군단의 첩자‡Una presencia demoníaca‡Una presencia demoníaca‡Une présence démoniaque‡恶魔的气息‡惡魔存在',
    nil,
    'O Arquimago Alturus quer que você destrua a Presença Demoníaca no topo da torre de Karazhan.‡Верховный маг Альтур просит вас уничтожить демона на вершине башни Каражана.‡Erzmagier Alturus möchte, dass Ihr die dämonische Präsenz an der Turmspitze von Karazhan zerstört.‡대마법사 알투루스가 카라잔의 꼭대기에 있는 불타는 군단의 첩자를 처치해 달라고 부탁했습니다.‡El archimago Alturus quiere que destruyas la presencia demoníaca de la parte superior de Karazhan.‡El archimago Alturus quiere que destruyas la presencia demoníaca de la parte superior de Karazhan.‡L\'Archimage Alturus veut que vous détruisiez la Présence démoniaque au sommet de Karazhan.‡大法师奥图鲁斯要求你消灭出现在卡拉赞顶部的恶魔。‡大法師艾特羅斯要你去摧毀卡拉贊頂端的惡魔存在。',
  }
},
[9845] = {
  {
    'Lançando a isca para a vitória‡Не распугивайте рыбу!‡Anglerunglück‡낚시터 수호‡Competición de pesca‡Competición de pesca‡À la pêche aux ennuis‡下钩钓鱼‡擊敗釣魚者的對手',
    nil,
    'Mate 10 Espancadores Garrocharcos e fale novamente com Zurjaya, em Zabra\'jin.‡Убейте 10 болотных твердозубов и вернитесь к Зурджайе в Забра\'джин.‡Tötet 10 Fennklauenhauer und kehrt dann zu Zurjaya in Zabra\'jin zurück.‡무쇠꼬리 늪발톱 히드라 10마리를 해치운 후 자브라진에 있는 주르자야에게 돌아가십시오.‡Mata 10 vándalos Zarpacieno y vuelve a ver a Zurjaya en Zabra\'jin.‡Mata 10 descarnadores Zarpacieno y vuelve a ver a Zurjaya en Zabra\'jin.‡Tuez 10 Vandales tourbegriffe, puis retournez voir Zurjaya à Zabra\'jin.‡杀死10个泥爪毁坏者，然后向萨布拉金的苏尔加亚复命。‡殺死10個沼爪痛擊者再回到薩布拉金的祖賈亞那裡。',
  }
},
[9846] = {
  {
    'Espíritos do Charco das Feras‡Духи Дикотопи‡Geister der Wildfenn‡야생늪일족의 정령‡Espíritus de los Feropantanos‡Espíritus de los Feropantanos‡Esprits des Tourbe-farouche‡蛮沼之灵‡菲拉芬靈魂',
    nil,
    'Traga 10 Totens Protetores do Charco das Feras para a Vidente Janidi, em Zabra\'jin.‡Принесите 10 тотемов-хранителей Дикотопи ясновидящей Джаниди в Забра\'джин.‡Bringt 10 Schutztotems von Wildfenn zu Seherin Janidi in Zabra\'jin.‡자브라진에 있는 현자 자니디에게 야생늪일족 가호의 토템 10개를 가져가야 합니다.‡Entrega 10 tótems de protección Feropantano al vidente Janidi en Zabra\'jin.‡Entrega 10 tótems de protección Feropantano al vidente Janidi en Zabra\'jin.‡Apportez 10 Totems de protection Tourbe-farouche à la Prophétesse Janidi à Zabra\'jin.‡将10根蛮沼保护图腾交给萨布拉金的先知亚尼迪。‡帶10個菲拉芬防護圖騰給薩布拉金的先知賈尼迪。',
  }
},
[9847] = {
  {
    'Um espírito aliado?‡Дух-союзник?‡Ein verbündeter Geist?‡영혼과 동맹을?‡¿Un espíritu aliado?‡¿Un espíritu aliado?‡Un esprit allié ?‡灵魂之盟？‡靈魂助手?',
    nil,
    'Leve o Totem do Charco das Feras até os pés das escadas das Ruínas de Boha\'mu e ponha-o no chão. Relate suas descobertas para a Vidente Janidi, em Zabra\'jin.‡Отнесите тотем Дикотопи к подножию лестницы руин Боха\'му и установите его на землю. Расскажите о том, что вы видели, ясновидящей Джаниди в Забра\'джине.‡Bringt das Wildfenntotem an den Fuß der Treppe in den Ruinen von Boha\'mu und verankert es im Boden. Berichtet Seherin Janidi in Zabra\'jin von Euren Beobachtungen.‡야생늪일족 토템을 가지고 보하무 폐허의 계단 맨 아래로 가서 토템을 설치해야 합니다. 그런 다음 자브라진의 현자 자니디에게 가서 발견한 내용을 보고하십시오.‡Lleva el Tótem Feropantano hasta el pie de las escaleras de las Ruinas Boha\'mu y colócalo en el suelo. Informa sobre tus descubrimientos al vidente Janidi en Zabra\'jin.‡Lleva el Tótem Feropantano hasta el pie de las escaleras de las Ruinas Boha\'mu y colócalo en el suelo. Informa sobre tus descubrimientos al vidente Janidi en Zabra\'jin.‡Plantez le totem Tourbe-farouche dans le sol au pied de l\'escalier des ruines de Boha\'mu. Ensuite, allez raconter vos découvertes au prophète Janidi, à Zabra\'jin.‡前往博哈姆废墟，将蛮沼图腾插在台阶底部的地面上。然后返回萨布拉金，向先知亚尼迪汇报你的发现。‡帶著菲拉芬圖騰到波哈姆廢墟的樓梯底部並將它插在地上。將你的發現回報給薩布拉金的先知賈尼迪。',
  }
},
[9848] = {
  {
    'Segredos do povo Lamadaga‡Тайны Остротопи‡Geheimnisse des Dolchfennstamms‡비수늪의 비밀‡Secretos de los Dagapantano‡Secretos de los Dagapantano‡Les secrets des Tourbedagues‡匕潭的秘密‡匕首沼地的秘密',
    nil,
    'Traga o Manual de Venenos Lamadaga e a Ampola de Veneno lamadaga para Timóteo Dinis em Porto Orebor.‡Принесите справочник по ядам Остротопи и фиал яда Остротопи Тимоти Даниэльсу в прибежище Оребор.‡Bringt das Gifthandbuch von Dolchfenn und eine Giftphiole von Dolchfenn zu Timothy Daniels in der Oreborzuflucht.‡오레보르 피난처에 있는 티모시 다니엘에게 비수늪일족 독 조제법과 비수늪일족 독병을 가져가야 합니다.‡Lleva el manual de venenos de Dagapantano y un Vial de veneno de Dagapantano a Timothy Daniels en el Puerto Orebor.‡Lleva el manual de venenos de Dagapantano y un Vial de veneno de Dagapantano a Timothy Daniels en el Puerto Orebor.‡Timothy Daniels, du Havre d\'Orebor, veut que vous lui rameniez le Manuel de poison Tourbedague et une Fiole de poison Tourbedague.‡将匕潭毒药手册和一只匕潭毒药瓶交给奥雷柏尔营地的迪莫斯·丹尼斯。‡將匕首沼地毒藥手冊和匕首沼地毒藥瓶帶給奧雷伯爾港的提莫斯·丹尼爾。',
  }
},
[9849] = {
  {
    'Despedaçando o véu‡Сорвать личину‡Die Maskerade durchschauen‡파괴된 비밀의 장막‡Rompiendo el velo‡Rompiendo el velo‡Briser le voile‡打碎外壳‡粉碎外表',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua 30 Lacaios de Gurok.‡Убейте 30 прислужников Гурока.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr 30 Diener von Gurok tötet.‡나그란드의 정령의 옥좌에 있는 고르다우그가 구로크의 하수인 30마리를 해치워 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand te ha pedido que mates a 30 esbirros de Gurok.‡Gordawg de El Trono de los Elementos en Nagrand te ha pedido que mates a 30 esbirros de Gurok.‡Gordawg, du Trône des éléments en Nagrand, vous a demandé de tuer 30 Serviteurs de Gurok.‡纳格兰元素王座的戈达乌要你杀死30个古罗克的爪牙。‡納葛蘭，元素王座的葛爾道格要你殺死30個古羅克的爪牙。',
  }
},
[9850] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Mate 12 Fenocerontes Adultos e conte a Rosarães Guima, no Safári Rosarães, em Nagrand, sobre a sua proeza.‡Убейте 12 самцов копытня и вернитесь к Хемингу Эрнестуэю в его охотничий лагерь в Награнде.‡Tötet 12 Grollhufbullen und sprecht anschließend mit Hemet Nesingwary bei Nesingwarys Safari in Nagrand, um Euer Jagdgeschick zu beweisen.‡수컷 갈래발굽 12마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 당신의 사냥 실력을 보여줘야 합니다.‡Mata a 12 uñagrietas dominantes y ve a hablar con Hemet Nesingwary en el Safari Nesingwary, en Nagrand, sobre tu progreso.‡Mata a 12 uñagrietas dominantes y ve a hablar con Hemet Nesingwary en el Safari Nesingwary, en Nagrand, sobre tu progreso.‡Tuez 12 Étalons sabots-fourchus, puis allez raconter vos exploits à Hemet Nesingwary, au safari de Nesingwary en Nagrand.‡杀死12头裂蹄公牛，然后向纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里复命。‡殺死12隻公裂蹄再到納葛蘭和奈辛瓦里狩獵的赫米特·奈辛瓦里談談你的本領。',
  }
},
[9851] = {
  {
    'Proficiência em fenocerontes‡Охота на копытней‡Beherrschen der Grollhufjagd‡갈래발굽 사냥법 익히기‡Cacería de uñagrietas‡Cacería de uñagrietas‡Maîtrise de la chasse aux sabots-fourchus‡狩猎裂蹄牛‡裂蹄專精',
    nil,
    'Pegue o Chifre de Banthar e fale novamente com Rosarães Guima, no Safári Rosarães, em Nagrand.‡Добудьте рог Бантар и отнесите его Хемингу Эрнестуэю в лагерь Эрнестуэя в Награнде.‡Erlangt das Horn von Banthar und kehrt anschließend zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand zurück.‡나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 반타르의 뿔을 가져가야 합니다.‡Consigue el cuerno de Banthar y llévaselo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Consigue el cuerno de Banthar y llévaselo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Hemet Nesingwary, du safari de Nesingwary en Nagrand, veut que vous lui rameniez la Corne de Banthar.‡将班塔尔的犄角交给纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里。‡取得班薩爾之角再回到納葛蘭找奈辛瓦里狩獵隊的赫米特·奈辛瓦里。',
  }
},
[9852] = {
  {
    'O vale-tudo de sangue‡Опасный спорт‡Die ultimative Beute‡궁극의 사냥감‡El deporte sangriento definitivo‡El deporte sangriento definitivo‡Le plus gros des gibiers‡终极挑战‡最後的浴血之戰',
    nil,
    'Entregue o Coração de Colmilhã para Rosarães Guima no Safári Rosarães, em Nagrand.‡Принесите сердце Клыкач Хемингу Эрнестуэю в его лагерь в Награнде.‡Bringt das Herz von Zahna zu Hemet Nesingwary bei Nesingwarys Safari in Nagrand.‡나그란드의 네싱워리 탐험대에 있는 헤멧 네싱워리에게 뿔엄니 심장을 가져가야 합니다.‡Lleva el corazón de Colmillo a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Lleva el corazón de Eburnia a Hemet Nesingwary en el Safari Nesingwary, en Nagrand.‡Apportez le Cœur de Longues-défenses à Hemet Nesingwary au safari de Nesingwary en Nagrand.‡将塔丝克之心交给纳格兰奈辛瓦里狩猎队营地的赫米特·奈辛瓦里。‡將長牙之心帶到納葛蘭交給奈辛瓦里狩獵的赫米特·奈辛瓦里。',
  }
},
[9853] = {
  {
    'Gurok, o Usurpador‡Гурок Узурпатор‡Gurok der Thronräuber‡강탈자 구로크‡Gurok el Usurpador‡Gurok el Usurpador‡Gurok l\'Usurpateur‡侵占者古罗克‡『篡位者』古羅克',
    nil,
    'Gordawg, do Trono dos Elementos, em Nagrand, quer que você destrua Gurok, o Usurpador e lhe traga a Cabeça Terrena de Gurok.‡Убейте Гурока Узурпатора и принесите его голову Гордаугу к Трону стихий.‡Gordawg am Thron der Elemente in Nagrand möchte, dass Ihr Gurok den Thronräuber zerstört und Guroks irdenen Kopf besorgt.‡나그란드의 정령의 옥좌에 있는 고르다우그가 강탈자 구로크를 해치우고 구로크의 바위머리를 가져다 달라고 부탁했습니다.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que destruyas a Gurok el Usurpador y le lleves la cabeza terránea de Gurok.‡Gordawg de El Trono de los Elementos en Nagrand ha pedido que destruyas a Gurok el Usurpador y le lleves la cabeza terránea de Gurok.‡Gordawg, du Trône des éléments en Nagrand, vous a demandé de détruire Gurok l\'Usurpateur et de lui ramener la Tête de terre de Gurok.‡杀死侵占者古罗克，将古罗克的徽记交给纳格兰元素王座的戈达乌。‡納葛蘭，元素王座的葛爾道格要你殺了『篡位者』古羅克並將古羅克的大地頭盔帶回來。',
  }
},
[9854] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Mate 12 Rocas-dos-ventos e fale novamente com o Fio no Safári Rosarães, em Nagrand.‡Убейте 12 ветрухов и вернитесь к Фитцу в охотничий лагерь Эрнестуэя в Награнде.‡Tötet 12 Windrocs und kehrt dann zu Fitz bei Nesingwarys Safari in Nagrand zurück.‡바람올빼미 12마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 피츠에게 돌아가야 합니다.‡Mata 12 vientorrocs y después vuelve a ver a Fitz en el Safari Nesingwary de Nagrand.‡Mata 12 vientorrocs y después vuelve a ver a Fitz en el Safari Nesingwary de Nagrand.‡Tuez 12 Venterocs et retournez voir Fitz au safari de Nesingwary en Nagrand.‡杀死12只风鹏，然后向纳格兰奈辛瓦里狩猎队营地的“好儿子”沙度·远行者复命。‡殺死12隻風翼貓頭鷹再回到納葛蘭找奈辛瓦里狩獵隊的費茲。',
  }
},
[9855] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Cace 12 Rocas-dos-ventos Vorazes e fale novamente com Fio no Safári Rosarães, em Nagrand.‡Добудьте 12 прожорливых ветрухов и вернитесь к Фитцу в лагерь Эрнестуэя в Награнде.‡Tötet 12 gefräßige Windrocs und kehrt dann zu Fitz bei Nesingwarys Safari in Nagrand zurück.‡굶주린 바람올빼미 12마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 피츠에게 돌아가야 합니다.‡Caza 12 vientorrocs voraces y regresa entonces junto a Fitz en el Safari Nesingwary de Nagrand.‡Caza 12 vientorrocs voraces y regresa entonces junto a Fitz en el Safari Nesingwary de Nagrand.‡Abattez 12 Venterocs voraces, puis retournez voir Fitz au safari de Nesingwary en Nagrand.‡杀死12只饥饿的风鹏，然后向纳格兰奈辛瓦里狩猎队营地的“好儿子”沙度·远行者复命。‡獵殺12隻飢餓的風翼貓頭鷹再回到納葛蘭找奈辛瓦里狩獵隊的費茲。',
  }
},
[9856] = {
  {
    'Proficiência em rocas-dos-ventos‡Охота на ветрухов‡Beherrschen der Windrocjagd‡바람올빼미 사냥법 익히기‡Cacería de vientorrocs‡Cacería de vientorrocs‡Maîtrise de la chasse aux venterocs‡狩猎风鹏‡風翼專精',
    nil,
    'Traga o Olho da Rancatripa para o Fio no Safári Rosarães, em Nagrand.‡Принесите глаз Потрошительницы Фитцу в охотничий лагерь Эрнестуэя в Награнде.‡Bringt das Auge von Aaskralle zu Fitz bei Nesingwarys Safari in Nagrand.‡나그란드의 네싱워리 탐험대에 있는 피츠에게 굶주린 검은갈고리의 눈을 가져가야 합니다.‡Lleva el ojo de Arrancatripas a Fitz al Safari Nesingwary en Nagrand.‡Lleva el ojo de Arrancatripas a Fitz al Safari Nesingwary en Nagrand.‡Fitz, du safari de Nesingwary en Nagrand, veut que vous lui rameniez l\'Œil d\'Arrache-tripes.‡将裂肠者的眼睛交给纳格兰奈辛瓦里狩猎队营地的"好儿子"沙度·远行者。‡將卡特瑞普之眼帶到納葛蘭給奈辛瓦里狩獵隊薩杜費茲。',
  }
},
[9857] = {
  {
    'Proficiência em talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Mate 12 Cervos Talbuque e fale novamente com Manuelzão no Safári Rosarães, em Nagrand.‡Убейте 12 талбуков-самцов и возвращайтесь к Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Tötet 12 Talbukhirsche und kehrt dann zu Harold Fährten bei Nesingwarys Safari in Nagrand zurück.‡줄무늬 탈부크 12마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 돌아가야 합니다.‡Mata 12 venados talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Mata 12 venados talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Tuez 12 Cerfs talbuks, puis retournez voir Harold Lane, au safari de Nesingwary en Nagrand.‡杀死12头塔布雄羊，然后向纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩复命。‡殺死12隻塔巴克雄鹿再回到納葛蘭找奈辛瓦里狩獵隊的哈洛德·蘭恩。',
  }
},
[9858] = {
  {
    'Proficiência em talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Mate 12 Talbuques Comespinho e fale novamente com Manuelzão no Safári Rosarães, em Nagrand.‡Убейте 12 талбуков-шипоедов и возвращайтесь к Гарольду Лейну в лагерь Эрнестуэя в Награнде.‡Erlegt 12 Talbukdornzehrer und kehrt dann zu Harold Fährten bei Nesingwarys Safari in Nagrand zurück.‡가시먹이 탈부크 12마리를 처치한 후 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 돌아가야 합니다.‡Caza 12 raspaespinas talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Caza 12 raspaespinas talbuk y vuelve a ver a Harold Sendero en el Safari Nesingwary, en Nagrand.‡Chassez 12 Talbuks Broutépine, puis retournez voir Harold Lane, au safari de Nesingwary en Nagrand.‡杀死12头塔布羊食棘者，然后向纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩复命。‡獵捕12隻塔巴克食棘者再回到納葛蘭找奈辛瓦里狩獵隊的哈洛德·蘭恩。',
  }
},
[9859] = {
  {
    'Mestre dos talbuques‡Охота на талбуков‡Beherrschen der Talbukjagd‡탈부크 사냥법 익히기‡Cacería de talbuks‡Cacería de talbuks‡Maîtrise de la chasse aux talbuks‡狩猎塔布羊‡塔巴克專精',
    nil,
    'Consiga o Casco de Bach\'lor e entregue-o para Manuelzão, no Safári Rosarães, em Nagrand.‡Добудьте копыто Хол\'стяка и принесите его Гарольду Лейну в охотничий лагерь Эрнестуэя в Награнде.‡Besorgt den Huf von Bach\'lor und bringt ihn zu Harold Fährten bei Nesingwarys Safari in Nagrand.‡바취로의 발굽을 나그란드의 네싱워리 탐험대에 있는 해럴드 레인에게 가져가야 합니다.‡Consigue la pezuña de Bach\'lor y llévasela a Harold Sendero, en el Safari Nesingwary, en Nagrand.‡Consigue la pezuña de Bach\'lor y llévasela a Harold Sendero, en el Safari Nesingwary, en Nagrand.‡Récupérez le Sabot de Bach\'lor et remettez-le à Harold Lane, au safari de Nesingwary en Nagrand.‡将巴克洛尔的蹄子交给纳格兰奈辛瓦里狩猎队营地的哈罗德·兰恩。‡取得巴奇洛爾之蹄並帶回納葛蘭交給奈辛瓦里狩獵隊的哈洛德·蘭恩。',
  }
},
[9860] = {
  {
    'A nova diretriz‡Новое направление‡Neue Anweisungen‡새로운 지령‡La nueva directiva‡La nueva directiva‡La nouvelle directive‡新的指示‡新的指令',
    nil,
    'Fale com o Arquimago Cedric nos arredores da Cratera de Dalaran.‡Поговорите с верховным магом Седриком на окраине кратера Даларана.‡Sprecht mit Erzmagier Cedric am Rande des Dalarankraters.‡달라란 구덩이 외곽에 있는 대마법사 세드릭과 대화해야 합니다.‡Habla con el archimago Cedric en las afueras del Cráter Dalaran.‡Habla con el archimago Cedric en las afueras del Cráter Dalaran.‡Parlez à l’Archimage Cédric à la périphérie du Cratère de Dalaran.‡与达拉然巨坑外的大法师塞德瑞克谈一谈。‡和達拉然陷坑郊區的大法師賽卓克談談。',
  }
},
[9861] = {
  {
    'Ventos uivantes‡Вой-Ветер‡Der heulende Wind‡울부짖는 바람‡El viento aullador‡El viento aullador‡Le vent hurlant‡呼嚎之风‡哀嚎之風',
    nil,
    'Encontre alguém no Trono dos Elementos que fale kalimaico e mostre-lhe o Vento Uivante.‡Разыщите у Трона стихий кого-нибудь, кто знает язык калимаг, и покажите ему или ей Вой-Ветра.‡Sucht beim Thron der Elemente nach jemandem, der Kalimag sprechen kann und zeigt der Person den heulenden Wind.‡정령의 옥좌에서 칼리마그 말을 할 줄 아는 이를 찾아서 울부짖는 바람을 보여주어야 합니다.‡Ve a El Trono de los Elementos, encuentra a alguien que hable Kalimag y enséñale el viento aullador.‡Ve a El Trono de los Elementos, encuentra a alguien que hable Kalimag y enséñale el viento aullador.‡Trouvez quelqu\'un qui parle le kalimag au Trône des éléments et montrez-lui le Vent hurlant.‡返回元素王座寻找某个会讲古卡利姆多语的人，将呼嚎之风交给他。‡在元素王座找到會講卡林多語的人再讓他看看哀嚎之風。',
  }
},
[9862] = {
  {
    'Corruptores Sangue-de-lodo‡Разлагатели Темной Крови‡Bösewichte der Finsterblut‡수렁피일족 파괴자‡Corruptores Sangreoscura‡Corruptores Sangreoscura‡Les corrupteurs bourbesang‡暗血腐蚀者‡黑暗之血腐敗者',
    nil,
    'O Elementalista Morgh, do Trono dos Elementos, em Nagrand, quer que você mate 5 Putrefadores Sangue-de-lodo.‡Убейте 5 разлагателей из племени Темной Крови по просьбе повелителя стихий Морха, находящегося у Трона Стихий.‡Elementarist Morgh beim Thron der Elemente in Nagrand möchte, dass Ihr 5 Läuterer der Finsterblut tötet.‡나그란드의 정령의 옥좌에 있는 정령술사 모르그가 수렁피일족 파괴자 5명을 해치워 달라고 부탁했습니다.‡El elementalista Morgh en El Trono de los Elementos, en Nagrand, quiere que mates 5 putrefactores Sangreoscura.‡El elementalista Morgh en El Trono de los Elementos, en Nagrand, quiere que mates 5 putrefactores Sangreoscura.‡L’élémentaliste Morgh, du Trône des éléments en Nagrand, veut que vous tuiez 5 Putréfacteurs bourbesang.‡纳格兰元素王座的元素师莫格要你杀死5个暗血净化者。‡納葛蘭，元素王座的元素師莫夫要你去殺死5個黑暗之血腐化者。',
  }
},
[9863] = {
  {
    'Idolatria vil‡Вражеские святыни‡Abscheulicher Götzendienst‡타락한 우상 숭배‡Idolatría vil‡Idolatría vil‡Vile idolâtrie‡邪恶的信仰‡邪惡的塑像',
    nil,
    'O Clarividente Kurkush, de Garadar, em Nagrand, quer que você lhe traga 10 Ídolos Sangue-de-lodo.‡Принесите 10 идолов Темной Крови предсказателю Куркашу в Гарадар.‡Weissager Kurkush in Garadar in Nagrand möchte, dass Ihr ihm 10 Finsterblutgötzen bringt.‡나그란드의 가라다르에 있는 선견자 쿠르쿠쉬가 수렁피 우상 10개를 가져다 달라고 부탁했습니다.‡El clarividente Kurkush en Garadar, en Nagrand, quiere que le lleves 10 ídolos Sangreoscura.‡El clarividente Kurkush en Garadar, en Nagrand, quiere que le lleves 10 ídolos Sangreoscura.‡Le long-voyant Kurkush, de Garadar en Nagrand, veut que vous lui rameniez 10 Idoles bourbesang.‡将10个暗血神像交给纳格兰加拉达尔的先知古库斯。‡納葛蘭，卡拉達爾的先知可庫許要你幫他帶來10個黑暗之血塑像。',
  }
},
[9864] = {
  {
    'O destacamento perdido‡Пропавший отряд‡Der verschollene Kampftrupp‡사라진 전투 부대‡El destacamento de guerra desaparecido‡El destacamento de guerra desaparecido‡La troupe manquante‡失踪的战斗小队‡失蹤的戰友',
    nil,
    'Encontre o destacamento de Garadar.‡Отыщите пропавший гарадарский отряд.‡Sucht den verschollenen Kriegstrupp von Garadar.‡실종된 가라다르 전투 부대를 찾아야 합니다.‡Intenta encontrar el destacamento de guerra de Garadar desaparecido.‡Intenta encontrar el destacamento de guerra de Garadar desaparecido.‡Tentez de retrouver la troupe de Garadar manquante.‡找到失踪的加拉达尔战斗小队。‡試著找到失蹤的卡拉達爾戰友。',
  }
},
[9865] = {
  {
    'Seu nome era vingança‡Да, были воины в наше время...‡Chroniken eines Kriegers‡한때는 전사였지만...‡Su nombre era Venganza‡Su nombre era Venganza‡L\'âme des guerriers‡我们曾是战士‡一朝為戰士',
    nil,
    'Mate 20 Catadores Sangue-de-lodo e 10 Saqueadores Sangue-de-lodo.‡Убейте 20 падальщиков из племени Темной Крови и 10 налетчиков из племени Темной Крови.‡Tötet 20 Strauchdiebe der Finsterblut und 10 Räuber der Finsterblut.‡수렁피일족 청소부 20명, 수렁피일족 약탈자 10명을 해치워야 합니다.‡Mata a 20 carroñeros y a 10 asaltantes Sangreoscura.‡Mata a 20 carroñeros y a 10 asaltantes Sangreoscura.‡Tuez 20 Charognards bourbesang et 10 Écumeurs bourbesang.‡消灭20个暗血清道夫和10个暗血掠夺者。‡殺死20個黑暗之血拾荒者以及10個黑暗之血劫掠者。',
  }
},
[9866] = {
  {
    'Ele vai correr o mundo...‡Он будет странствовать по земле...‡Weiter...‡대지를 향해 나아가는 자...‡Recorrerá la tierra...‡Recorrerá la tierra...‡Et il parcourra la Terre...‡他要游历世界......‡他將走遍大地……',
    nil,
    'Relate a notícia para o Clarividente Corhuk em Garadar.‡Доставьте известие предсказателю Корхуку в Гарадар.‡Bringt die Nachricht zu Weissager Corhuk in Garadar.‡가라다르에 있는 선견자 코르후크에게 소식을 전해야 합니다.‡Da la noticia al clarividente Corhuk en Garadar.‡Da la noticia al clarividente Corhuk en Garadar.‡Apportez la nouvelle au Long-voyant Corhuk, à Garadar.‡返回加拉达尔，将消息告诉先知考尔胡克。‡將消息送給卡拉達爾的先知科霍克。',
  }
},
[9867] = {
  {
    'Chefes Sangue-de-lodo...‡Главари Темной Крови‡Anführer der Finsterblut...‡수렁피 지휘관...‡Los jefes Sangreoscura‡Los jefes Sangreoscura‡Les chefs Bourbesang...‡暗血领袖‡黑暗之血領導者……',
    nil,
    'O Clarividente Margadesh, de Garadar, em Nagrand, quer que você lhe traga a Cabeça de Ortor Sangue-de-lodo.‡Принесите предсказателю Маргадешу в Гарадар голову Ортора Темной Крови.‡Bringt Ortor von Finsterbluts Kopf zu Weissager Margadesh in Garadar in Nagrand.‡나그란드의 가라다르에 있는 선견자 마르가데쉬가 수렁피일족의 오르토르를 처치하고 그 증거를 가져오라고 부탁했습니다.‡El clarividente Margadesh de Garadar, en Nagrand, quiere que le lleves la cabeza de Ortur de Sangreoscura.‡El clarividente Margadesh de Garadar, en Nagrand, quiere que le lleves la cabeza de Ortur de Sangreoscura.‡Le long-voyant Margadesh à Garadar en Nagrand veut que vous lui rameniez la Tête d\'Ortor de Bourbesang.‡将暗血酋长奥托尔的徽记交给纳格兰加拉达尔的先知玛加迪。‡納葛蘭，卡拉達爾的先知馬卡戴斯要你幫他把黑暗之血奧拓爾的頭顱帶來。',
  }
},
[9868] = {
  {
    'O totem de Kar\'dash‡Тотем Кардаша‡Das Totem von Kar\'dash‡카르다쉬의 토템‡El tótem de Kar\'dash‡El tótem de Kar\'dash‡Le totem de Kar\'dash‡卡达什图腾‡卡達許圖騰',
    nil,
    'Escolte o Cativo Mag\'har para fora do Posto Solavera. Caso você consiga, fale com Garrosh, em Garadar.‡Помогите пленному маг\'хару бежать с заставы Солнечного Источника. Расскажите Гаррошу в Гарадаре обо всем, что вам удалось узнать.‡Begleitet den festgehaltenen Mag\'har aus dem Sonnenwindposten hinaus. Sprecht mit Garrosh in Garadar, wenn Ihr erfolgreich wart.‡태양여울 주둔지에 있는 마그하르 포로를 구출해야 합니다. 성공하면 가라다르에 있는 가로쉬와 대화해야 합니다.‡Ayuda al cautivo Mag\'har a salir del Puesto Primasol. Después ve a hablar con Garrosh a Garadar.‡Ayuda al cautivo Mag\'har a salir del Puesto Primasol. Después ve a hablar con Garrosh a Garadar.‡Escortez le Captif Mag\'har hors du poste de Berceau-de-l\'été. Si vous y parvenez, allez parler à Garrosh, à Garadar.‡护送玛格汉俘虏逃离日泉岗哨，完成任务后返回加拉达尔，向加尔鲁什复命。‡護送瑪格哈俘虜離開日春崗哨。如果你成功的話就和卡拉達爾的卡爾洛斯談談。',
  }
},
[9869] = {
  {
    'O Trono dos Elementos‡Трон стихий‡Der Thron der Elemente‡정령의 옥좌‡El Trono de los Elementos‡El Trono de los Elementos‡Le Trône des éléments‡元素王座‡元素王座',
    nil,
    'O Elementalista Ioki quer que você vá ao Trono dos Elementos e fale com a Elementalista Sharvak.‡Поговорите с повелительницей стихий Шарвак у Трона стихий.‡Elementarist Ioki möchte, dass Ihr zum Thron der Elemente reist und mit Elementaristin Sharvak sprecht.‡정령술사 아이오키가 정령의 옥좌로 가서 정령술사 샤르바크에게 소식을 전해달라고 부탁했습니다.‡Elementalista Ioki quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡Elementalista Ioki quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡L\'élémentaliste Ioki veut que vous vous rendiez au Trône des éléments et que vous parliez à l\'élémentaliste Sharvak.‡元素师犹基希望你前往元素王座，与元素师沙尔瓦克谈一谈。‡元素師洛奇要你前往元素王座和元素師莎爾瓦克談談。',
  }
},
[9870] = {
  {
    'O Trono dos Elementos‡Трон стихий‡Der Thron der Elemente‡정령의 옥좌‡El Trono de los Elementos‡El Trono de los Elementos‡Le Trône des éléments‡元素王座‡元素王座',
    nil,
    'O Elementalista Yal\'hah quer que você vá ao Trono dos Elementos e fale com a Elementalista Sharvak.‡Поговорите с повелительницей стихий Шарвак у Трона стихий.‡Elementarist Yal\'hah möchte, dass Ihr zum Thron der Elemente reist und mit Elementaristin Sharvak sprecht.‡정령술사 얄하가 정령의 옥좌로 가서 정령술사 샤르바크와 대화해 보라고 부탁했습니다.‡El elementalista Yal\'hah quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡El elementalista Yal\'hah quiere que vayas a El Trono de los Elementos y hables con la elementalista Sharvak.‡L\'élémentaliste Yal\'hah veut que vous vous rendiez au Trône des éléments et que vous parliez à l\'élémentaliste Sharvak.‡元素师亚尔哈希望你前往元素王座，与元素师沙尔瓦克谈一谈。‡元素師亞哈要你前往元素王座和元素師莎爾瓦克談談。',
  }
},
[9871] = {
  {
    'Invasores Sangue-de-lodo‡Захватчики из племени Темной Крови‡Eindringlinge der Finsterblut‡수렁피일족 침략자‡Invasores Sangreoscura‡Invasores Sangreoscura‡Les envahisseurs bourbesang‡暗血入侵者‡黑暗之血入侵者',
    nil,
    'Entregue os planos de invasão dos Sangue-de-lodo a Arechron, na vila de Telaar, em Nagrand.‡Передайте планы вторжения Темной Крови Арехрону в Телаар, что в Награнде.‡Bringt die Invasionspläne der Finsterblut zu Arechron nach Telaar in Nagrand.‡나그란드의 텔라아르에 있는 아레크론에게 수렁피일족 침공 계획서를 가져가야 합니다.‡Lleva los planes de invasión de los Sangreoscura a Arechron a Telaar, en Nagrand.‡Lleva los planes de invasión de los Sangreoscura a Arechron a Telaar, en Nagrand.‡Apportez les Plans d’invasion bourbesang à Arechron à Telaar, en Nagrand.‡将暗血入侵计划交给纳格兰的塔拉的阿雷克隆。‡到納葛蘭的泰拉，把黑暗之血攻擊計畫帶給阿爾克隆。',
  }
},
[9872] = {
  {
    'Invasores Sangue-de-lodo‡Захватчики из племени Темной Крови‡Eindringlinge der Finsterblut‡수렁피일족 침략자‡Invasores Sangreoscura‡Invasores Sangreoscura‡Les envahisseurs bourbesang‡暗血入侵者‡黑暗之血入侵者',
    nil,
    'Entregue os planos de invasão dos Sangue-de-lodo para Garrosh.‡Передайте планы вторжения Темной Крови Гаррошу.‡Bringt die Invasionspläne der Finsterblut zu Garrosh.‡가로쉬에게 수렁피일족 침공 계획서를 가져가야 합니다.‡Lleva los planes de invasión Sangreoscura a Garrosh.‡Lleva los planes de invasión Sangreoscura a Garrosh.‡Apportez les Plans d\'invasion bourbesang à Garrosh.‡将暗血入侵计划交给加尔鲁什。‡將黑暗之血攻擊計畫帶給卡爾洛斯。',
  }
},
[9873] = {
  {
    'Ortor, meu velho amigo...‡Ортор, мой старый друг...‡Mein alter Freund Ortor...‡나의 오랜 친구 오르토르‡Mi viejo amigo Ortur‡Mi viejo amigo Ortur‡Ortor, mon vieil ami...‡奥托尔，我的老朋友......‡我的老友奧拓爾……',
    nil,
    'Arechron, da vila de Telaar, em Nagrand, quer que você mate Ortor Sangue-de-lodo.‡Арехрон из Телаара в Награнде поручил вам убить Ортора Темную Кровь.‡Arechron in Telaar in Nagrand möchte, dass Ihr Ortor von Finsterblut tötet.‡나그란드의 텔라아르에 있는 아레크론이 수렁피일족의 오르토르를 처치해 달라고 부탁했습니다.‡Arechron de Telaar, en Nagrand, quiere que mates a Ortur de Sangreoscura.‡Arechron de Telaar, en Nagrand, quiere que mates a Ortur de Sangreoscura.‡Arechron, de Telaar en Nagrand, veut que vous tuiez Ortor de Bourbesang.‡杀死暗血酋长奥托尔，然后向纳格兰塔拉的阿雷克隆复命。‡納葛蘭，泰拉的阿爾克隆要你去殺了黑暗之血奧拓爾。',
  }
},
[9874] = {
  {
    'Cessar a propagação‡Остановить заразу‡Die Ausbreitung eindämmen‡오염 확산 방지‡Deteniendo la propagación‡Deteniendo la propagación‡Arrêter la contamination‡阻止污染‡阻止蔓延',
    nil,
    'Otumbo, o Prudente, da vila de Telaar, em Nagrand, quer que você use a tocha de fogo líquido para destruir 10 cadáveres de habitantes de Solavera. Devolva a tocha de fogo líquido ao completar a tarefa.‡Сожгите 10 трупов жителей заставы Солнечного Источника с помощью факела жидкого огня. Когда исполните поручение, верните факел Отонбу Ведуну.‡Otonbu der Weise in Telaar in Nagrand möchte, dass Ihr die Fackel des flüssigen Feuers benutzt, um 10 Leichen von Bewohnern von Sonnenwind zu zerstören. Bringt die Fackel des flüssigen Feuers zurück, wenn Ihr fertig seid.‡나그란드의 텔라아르에 있는 현자 오톤부가 액화의 횃불을 사용하여 태양여울 마을 주민의 시체 10구를 태워 달라고 부탁했습니다. 일을 마치면 액화의 횃불을 돌려줘야 합니다.‡Otonbu el Sabio de Telaar, en Nagrand, quiere que uses la antorcha de fuego líquido para destruir 10 cadáveres de habitantes de Primasol. Devuélvele la antorcha de fuego líquido cuando hayas terminado.|n‡Otonbu el Sabio de Telaar, en Nagrand, quiere que uses la antorcha de fuego líquido para destruir 10 cadáveres de habitantes de Primasol. Devuélvele la antorcha de fuego líquido cuando hayas terminado.|n‡Otonbu le Sage, à Telaar en Nagrand, veut que vous utilisiez la Torche de feu liquide pour détruire 10 Cadavres de villageois du Berceau-de-l\'été. Lorsque vous aurez terminé, rendez-lui la Torche de feu liquide.‡用魔油火炬烧掉10具日泉村民的遗体，然后向纳格兰塔拉的先知欧图布复命，并归还魔油火炬。‡納葛蘭，泰拉的『賢者』歐塔布要你使用液態火炬摧毀10個日春崗哨居民屍體。完成任務後將液態火炬交回。',
  }
},
[9875] = {
  {
    'Espécie não catalogada‡Неизвестный науке вид‡Nicht katalogisierte Gattung‡미분류된 식물종 전달‡Especie sin catalogar‡Especie sin catalogar‡Une espèce non cataloguée‡未归类的植物‡未編目的品種',
    nil,
    'Leve a Espécie Não Catalogada para Laurana Thar\'well no Refúgio Cenariano, no Pântano Zíngaro.‡Принесите неизвестный науке вид Лоранне Тар\'велл в Кенарийский приют в Зангартопи.‡Bringt die nicht katalogisierte Gattung zu Lauranna Thar\'well in der Zuflucht des Cenarius in den Zangarmarschen.‡장가르 습지대의 세나리온 야영지에 있는 라우란나 사르웰에게 미분류된 식물종을 가져가야 합니다.‡Lleva la especie sin catalogar a Lauranna Thar\'well en el Refugio Cenarion, en la Marisma de Zangar.‡Lleva la especie sin catalogar a Lauranna Thar\'well en el Refugio Cenarion, en la Marisma de Zangar.‡Apportez l\'Espèce non cataloguée à Lauranna Thar\'well au Refuge cénarien dans le marécage de Zangar.‡将未归类的植物交给赞加沼泽塞纳里奥庇护所的劳兰娜·萨维尔。‡將未編目的品種帶到贊格沼澤給塞納里奧避難所的羅安娜·薩威爾。',
  }
},
[9876] = {
  {
    'Incursão malsucedida‡Провалившийся рейд‡Fehlgeschlagene Operation‡실패한 조사‡Incursión fallida‡Incursión fallida‡Une incursion manquée‡失踪的先遣队‡入侵失敗',
    nil,
    'Ysiel Cantavento quer que você procure por pistas dos Druidas da Expedição Cenariana perto da entrada do Reservatório Presacurva, no Pântano Zíngaro.‡По просьбе Исиэли Песни Ветра отыщите следы друидов из Кенарийской экспедиции у входа в Резервуар Кривого Клыка , что в Зангартопи.‡Ysiel Windsänger möchte, dass Ihr am Eingang des Echsenkessels in den Zangarmarschen nach Lebenszeichen der Druiden der Expedition des Cenarius Ausschau haltet.‡이시엘 윈드싱어가 장가르 습지대의 갈퀴송곳니 저수지 입구 근처에서 세나리온 원정대 드루이드들의 흔적을 찾아 달라고 부탁했습니다.‡Ysiel Vientocantor quiere que busques pistas de los druidas de la Expedición Cenarion cerca de la entrada de la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Ysiel Vientocantor quiere que busques pistas de los druidas de la Expedición Cenarion cerca de la entrada de la Reserva Colmillo Torcido, en la Marisma de Zangar.‡Ysiel Chantelevent veut que vous recherchiez des signes des druides de l\'Expédition cénarienne près de l\'entrée du réservoir de Glissecroc, au Marécage de Zangar.‡伊谢尔·风歌要你前往赞加沼泽的盘牙水库，在入口附近搜寻塞纳里奥远征队德鲁伊的下落。‡伊斯歐·風詠要你去贊格沼澤的盤牙蓄湖入口附近，尋找塞納里奧遠征隊德魯伊。',
  }
},
[9877] = {
  {
    'Um trago restaurador‡Приводящее в сознание зелье‡Ein Regenerationsgebräu‡복원의 비약‡Una pócima reconstituyente‡Una pócima reconstituyente‡Un breuvage de restauration‡疗伤药膏‡恢復藥劑',
    nil,
    'Fale com o Boticário Reinaldo em Tranquillien.‡Поговорите с аптекарем Рензитеном в Транквиллионе.‡Sprecht mit Apotheker Renzithen in Tristessa.‡트랜퀼리엔에 있는 연금술사 렌지센과 대화해야 합니다.‡Habla con el boticario Renzithen en Tranquillien.‡Habla con el boticario Renzithen en Tranquillien.‡Parlez à l\'apothicaire Renzithen à Tranquillien.‡与塔奎林的药剂师雷兹特恩谈一谈。‡和安寧地的藥劑師倫澤紳談談。',
  }
},
[9878] = {
  {
    'Resolvendo o problema‡Устранение проблемы‡Die Lösung des Problems‡문제 해결‡Resolviendo el problema‡Resolviendo el problema‡La résolution du problème‡解决问题‡解決問題',
    nil,
    'Poli\'lukluk, o Sábio, da vila de Telaar, em Nagrand, quer que você mate 10 carniceiros Sangue-de-lodo e 5 atacantes Sangue-de-lodo.‡Убейте 10 падальщиков и 5 налетчиков из племени Темной Крови.‡Poli\'lukluk der Weisere in Telaar in Nagrand möchte, dass Ihr 10 Strauchdiebe der Finsterblut und 5 Räuber der Finsterblut tötet.‡나그란드의 텔라아르에 있는 대현자 폴리루크루크가 수렁피일족 청소부 10명, 수렁피일족 약탈자 5명을 처치해 달라고 부탁했습니다.‡Poli\'lukluk el Más Sabio en Telaar, en Nagrand, quiere que mates 10 carroñeros Sangreoscura y 5 asaltantes Sangreoscura.‡Poli\'lukluk el Más Sabio en Telaar, en Nagrand, quiere que mates 10 carroñeros Sangreoscura y 5 asaltantes Sangreoscura.‡Poli\'lukluk le Malin, de Telaar en Nagrand, veut que vous tuiez 10 Charognards bourbesang et 5 Écumeurs bourbesang.‡消灭10个暗血清道夫和5个暗血掠夺者，然后向纳格兰塔拉的智者普里鲁鲁克复命。‡納葛蘭，泰拉的『智者』寶利露克露克要你殺死10個黑暗之血食腐者和5個黑暗之血劫掠者。',
  }
},
[9879] = {
  {
    'O totem de Kar\'dash‡Тотем Кардаша‡Das Totem von Kar\'dash‡카르다쉬의 토템‡El tótem de Kar\'dash‡El tótem de Kar\'dash‡Le totem de Kar\'dash‡卡达什图腾‡卡達許圖騰',
    nil,
    'Escolte o Kurenai Cativo para fora de Posto Sol Nascente. Caso você consiga, fale com Arechron, na vila de Telaar.‡Помогите куренайскому пленнику бежать с заставы Солнечного Источника. Расскажите Арехрону из Телаара обо всем, что вам удалось узнать.‡Begleitet den gefangenen Kurenai aus dem Sonnenwindposten. Sprecht mit Arechron in Telaar, wenn Ihr erfolgreich wart.‡태양여울 주둔지에 있는 쿠레나이 포로를 호위한 후, 텔라아르에 있는 아레크론과 대화해야 합니다.‡Escolta al cautivo Kurenai hasta salir del Puesto Primasol. Ve a hablar con Arechron en Telaar si tienes éxito.‡Escolta al cautivo Kurenai hasta salir del Puesto Primasol. Ve a hablar con Arechron en Telaar si tienes éxito.‡Escortez le Captif kurenaï hors du poste de Berceau-de-l\'été. Si vous y parvenez, allez parler à Arechron, à Telaar.‡护送库雷尼俘虏逃离日泉岗哨，完成任务后返回塔拉，向阿雷克隆复命。‡護送卡爾奈俘虜離開日春崗哨。成功後再和泰拉的阿爾克隆談談。',
  }
},
[9880] = {
  {
    'Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap‡Hellfire Penninsula: -pn - A - ToWoW - Hellfire Turnin Cap',
