[24792] = {
  {
    '‡Засланный шпион‡V-Mann‡잠복근무‡El topo‡El topo‡Un infiltré‡打入内部‡裡應外合',
    nil,
    '‡Найдите следователя Феззена Клейстра в Крепости Темного Клыка.‡Meldet Euch bei Ermittler Fezzen Kupferstapel auf Burg Schattenfang.‡그림자송곳니 성채에 있는 수사관 페젠 브라스택스에게 보고해야 합니다.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Faites votre rapport à l\'Enquêteur Fezzen Desfaits au Donjon d\'Ombrecroc.‡向影牙城堡的调查员费岑·布莱斯塔克报告。‡',
  }
},
[24793] = {
  {
    '‡Засланный шпион‡V-Mann‡잠복근무‡El topo‡El topo‡Un infiltré‡打入内部‡裡應外合',
    nil,
    '‡Найдите следователя Феззена Клейстра в Крепости Темного Клыка.‡Meldet Euch bei Ermittler Fezzen Kupferstapel auf Burg Schattenfang.‡그림자송곳니 성채에 있는 수사관 페젠 브라스택스에게 보고해야 합니다.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Preséntate ante el investigador Fezzen Arreolatón en el Castillo de Colmillo Oscuro.‡Faites votre rapport à l\'Enquêteur Fezzen Desfaits au Donjon d\'Ombrecroc.‡向影牙城堡的调查员费岑·布莱斯塔克报告。‡',
  }
},
[24795] = {
  {
    '‡Победа Серебряного союза‡Ein Sieg für den Silberbund‡은빛 서약단의 승리‡Una victoria para El Pacto de Plata‡Una victoria para El Pacto de Plata‡Une victoire pour le Concordat argenté‡银色盟约的胜利‡白銀誓盟的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡',
  }
},
[24796] = {
  {
    '‡Победа Серебряного союза‡Ein Sieg für den Silberbund‡은빛 서약단의 승리‡Una victoria para El Pacto de Plata‡Una victoria para El Pacto de Plata‡Une victoire pour le Concordat argenté‡银色盟约的胜利‡白銀誓盟的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Верисе Ветрокрылой в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Vereesa Windläufer in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 베리사 윈드러너에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada a Vereesa Brisaveloz a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada a Vereesa Brisaveloz a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à Vereesa Coursevent à la Citadelle Pourpre, à Dalaran.‡将奎尔德拉交给达拉然紫罗兰城堡中的温蕾萨·风行者。‡',
  }
},
[24798] = {
  {
    '‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡',
  }
},
[24799] = {
  {
    '‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Вершительнице правосудия Мариэль Чистосердечной на ристалище Серебряного Турнира.‡Bringt das wiederhergestellte Quel\'Delar zu Justiziarin Mariel Treuherz beim Argentumturnierplatz.‡‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Llévale la Quel\'Delar restaurada a la justicar Mariel Corazón Veraz a los Campos del Torneo Argenta.‡Rapportez Quel\'Delar réparée à la Justicière Mariel Cœur-vrai, dans l\'Enceinte du tournoi d\'Argent.‡将奎尔德拉交给银色比武场的裁决者玛蕾尔·图哈特。‡',
  }
},
[24800] = {
  {
    '‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Верховному магу Этасу Похитителю Солнца в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Erzmagier Aethas Sonnenhäscher in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 대마법사 에이타스 선리버에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à l\'Archimage Aethas Saccage-soleil à la Citadelle Pourpre, à Dalaran.‡‡',
  }
},
[24801] = {
  {
    '‡Победа Похитителей Солнца‡Ein Sieg für die Sonnenhäscher‡선리버의 승리‡Una victoria para los Atracasol‡Una victoria para los Atracasol‡Une victoire pour les Saccage-soleil‡夺日者的胜利‡奪日者的勝利',
    nil,
    '‡Принесите восстановленный Кель\'Делар Верховному магу Этасу Похитителю Солнца в Аметистовую цитадель Даларана.‡Bringt das wiederhergestellte Quel\'Delar zu Erzmagier Aethas Sonnenhäscher in der Violetten Zitadelle in Dalaran.‡달라란의 보랏빛 성채에 있는 대마법사 에이타스 선리버에게 복원된 쿠엘델라를 가져가야 합니다.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Llévale la Quel\'Delar restaurada al archimago Aethas Atracasol a la Ciudadela Violeta de Dalaran.‡Rapportez Quel\'Delar réparée à l\'Archimage Aethas Saccage-soleil à la Citadelle Pourpre, à Dalaran.‡‡',
  }
},
[24802] = {
  {
    '‡Гнев Короля-лича‡Der Zorn des Lichkönigs‡리치 왕의 분노‡La cólera del Rey Exánime‡La cólera del Rey Exánime‡La colère du roi-liche‡巫妖王之怒‡巫妖王之怒',
    nil,
    '‡Найдите леди Сильвану Ветрокрылую и выберитесь из Залов Отражений.‡Findet Fürstin Sylvanas Windläufer und flieht aus den Hallen der Reflexion.‡‡Encuentra a Lady Sylvanas Brisaveloz y escapa de Las Cámaras de Reflexión.‡Encuentra a Lady Sylvanas Brisaveloz y escapa de Las Cámaras de Reflexión.‡Trouvez Dame Sylvanas Coursevent et enfuyez-vous des Salles des Reflets.‡‡',
  }
},
[24803] = {
