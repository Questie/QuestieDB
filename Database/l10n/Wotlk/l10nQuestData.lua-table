[7871] = {
  {
    '‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡¡Expulsa al invasor!‡¡Expulsa al invasor!‡Triomphez des envahisseurs!‡击败入侵者！ (PvP)‡',
    nil,
    '‡Войдите в Ущелье Песни Войны, одержите победу над Ордой, получите почетный знак Ущелья Песни Войны и вернитесь с ним к часовому Дальной Песне в рощу Среброкрылых.‡Betretet die Kriegshymnenschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Kriegshymnenschlucht und kehrt zur Schildwache Weltensang am Hain der Silberschwingen zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Chanteguerres, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Chanteguerres. Puis revenez voir la sentinelle Chanteloin au bosquet d\'Aile-argent.‡进入战歌峡谷并击败部落小队，取得战歌峡谷荣誉奖章后向银翼树林哨兵轻歌回覆。‡',
  }
},
[7872] = {
  {
    'Aniquile os invasores!‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡¡Expulsa al invasor!‡¡Expulsa al invasor!‡Triomphez des envahisseurs !‡击败入侵者！‡擊敗入侵者!',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Horda, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue à Sentinela Cantálgures no Bosque Asa de Prata.‡Войдите в ущелье Песни Войны, одержите победу над Ордой, получите почетный знак ущелья Песни Войны и вернитесь с ним к часовой Дальней Песне в рощу Среброкрылых.‡Betretet die Kriegshymnenschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Kriegshymnenschlucht und kehrt zur Schildwache Weltensang am Hain der Silberschwingen zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 돌아가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Chanteguerres, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Chanteguerres. Puis revenez voir la sentinelle Chanteloin au bosquet d\'Aile-argent.‡进入战歌峡谷抵御部落小队的攻击，获得一枚银翼功勋奖章，然后向银翼树林中的哨兵艾蒂亚·轻歌回复。‡進入戰歌峽谷並擊敗部落小隊，取得戰歌峽谷榮譽獎章後向銀翼樹林哨兵輕歌回覆。',
  }
},
[7873] = {
  {
    'Aniquile os invasores!‡Долой захватчиков!‡Besiegt die Eindringlinge!‡침략자 처단!‡¡Expulsa al invasor!‡¡Expulsa al invasor!‡Triomphez des envahisseurs !‡击败入侵者！‡擊敗入侵者!',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Horda, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue à Sentinela Cantálgures no Bosque Asa de Prata.‡Войдите в ущелье Песни Войны, одержите победу над Ордой, получите почетный знак ущелья Песни Войны и вернитесь с ним к часовой Дальней Песне в рощу Среброкрылых.‡Betretet die Kriegshymnenschlucht und besiegt die Streitkräfte der Horde. Verdient Euch ein Ehrenabzeichen der Kriegshymnenschlucht und kehrt zur Schildwache Weltensang am Hain der Silberschwingen zurück.‡전쟁노래 협곡으로 들어가 호드를 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 은빛날개 숲에 있는 파수꾼 파송에게 돌아가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entra en la Garganta Grito de Guerra y derrota a la Horda, obtén una marca de Honor Grito de Guerra y vuelve con la centinela Cantolejano en el Claro Ala de Plata.‡Entrez dans le goulet des Chanteguerres, triomphez de la Horde et gagnez une Marque d\'honneur du goulet des Chanteguerres. Puis revenez voir la sentinelle Chanteloin au bosquet d\'Aile-argent.‡进入战歌峡谷抵御部落小队的攻击，获得一枚银翼功勋奖章，然后向银翼树林中的哨兵艾蒂亚·轻歌回复。‡進入戰歌峽谷並擊敗部落小隊，取得戰歌峽谷榮譽獎章後向銀翼樹林哨兵輕歌回覆。',
  }
},
[7874] = {
  {
    '‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silberschwingen‡‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡',
    nil,
    '‡Войдите в Ущелье Песни Войны, одержите победу над Альянсом, получите почетный знак ущелья Песни Войны и вернитесь с ним к капитану Лободробу в лагерь Мор\'шан.‡Betretet die Kriegshymnenschlucht und besiegt die Streitkräfte der Allianz. Erwerbt ein Ehrenabzeichen der Kriegshymnenschlucht und kehrt anschließend zu Hauptmann Schädelbrecher im Stützpunkt Mor\'shan zurück.‡‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entrez dans le goulet des Chanteguerres, triomphez de l\'Alliance et obtenez une Marque d\'honneur du goulet des Chanteguerres. Puis revenez voir le capitaine Fracasse-crâne au campement de Mor\'shan.‡进入战歌峡谷击败联盟小队，获得一枚战歌峡谷荣誉奖章，然后向莫尔杉营地的沙塔尔·碎颅覆命。‡',
  }
},
[7875] = {
  {
    'Domine os usurpadores da Asa de Prata‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silberschwingen‡은빛날개 분쟁 진압‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡鎮壓銀翼部隊',
    nil,
    'Vá à Ravina Brado Guerreiro, derrote a Aliança, obtenha uma Marca de Honra da Ravina Brado Guerreiro e a entregue ao Capitão Estilhaça-crânio no Campo-base Mor\'shan.‡Войдите в ущелье Песни Войны, одержите победу над Альянсом, получите почетный знак ущелья Песни Войны и вернитесь с ним к капитану Лободробу в лагерь Мор\'шан.‡Betretet die Kriegshymnenschlucht und besiegt die Streitkräfte der Allianz. Erwerbt ein Ehrenabzeichen der Kriegshymnenschlucht und kehrt anschließend zu Hauptmann Schädelbrecher im Stützpunkt Mor\'shan zurück.‡전쟁노래 협곡으로 진입하여 얼라이언스 진영을 무찌르고 전쟁노래 협곡 명예 훈장을 얻어 몰샨 주둔지에 있는 부대장 쉐터스컬에게 가져가야 합니다.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entra en la Garganta Grito de Guerra y derrota a la Alianza, obtén una marca de Honor de la Garganta Grito de Guerra y llévasela al capitán Trizacráneo en el Campamento de Mor\'shan.‡Entrez dans le goulet des Chanteguerres, triomphez de l\'Alliance et obtenez une Marque d\'honneur du goulet des Chanteguerres. Puis revenez voir le capitaine Fracasse-crâne au campement de Mor\'shan.‡进入战歌峡谷击败联盟小队，获得一枚战歌荣誉奖章，然后向莫尔杉营地的沙塔尔·碎颅复命。‡進入戰歌峽谷擊敗聯盟小隊，獲得一枚戰歌峽谷榮譽獎章，然後向莫爾杉營地的沙塔爾·碎顱覆命。',
  }
},
[7876] = {
  {
    'Domine os usurpadores da Asa de Prata‡Громи захватчиков-Среброкрылых!‡Bezwingt die Eindringlinge der Silberschwingen‡은빛날개 분쟁 진압‡Acaba con los usurpadores Ala de Plata‡Acaba con los usurpadores Ala de Plata‡Écrasez les usurpateurs d\'Aile-argent‡镇压银翼部队‡鎮壓銀翼部隊',
