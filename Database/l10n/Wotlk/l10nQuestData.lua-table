[25283] = {
  {
    '‡Готовим речь‡Die Rede vorbereiten‡‡Preparar el discurso‡Preparar el discurso‡La rédaction du discours‡演讲练习‡研擬講稿',
    nil,
    '‡Используйте Гномское воспроизводящее устройство перед Оззи Триггервольтом, который живет на севере от Караноса, Милли Перосвист из Поселка Сталежара и Тогом Ржавозубом, которого можно найти перед таверной Караноса. Прокрутив все речи, вернитесь к Тоби Зимехану.‡Benutzt das Gnomische Abspielgerät vor Ozzie Wechselvolt nördlich von Kharanos, Milli Federpfiff bei Stahlrosts Depot und Tog Rostspross vor der Gaststätte in Kharanos. Kehrt zu Toby Zeigrad zurück, wenn alle Reden gehalten wurden.‡‡Utiliza el dispositivo de reproducción gnómico delante de Ozzie Voltiflop al norte de Kharanos, Milli Plumasilba en el Almacén de Brasacerada y Tog Oxidentado fuera de la posada de Kharanos. Vuelve con Toby Relogiro cuando hayas dado todos los discursos.‡Utiliza el dispositivo de reproducción gnómico delante de Ozzie Voltiflop al norte de Kharanos, Milli Plumasilba en el Almacén de Brasacerada y Tog Oxidentado fuera de la posada de Kharanos. Vuelve con Toby Relogiro cuando hayas dado todos los discursos.‡Utilisez l\'Appareil d\'enregistrement gnome à côté d\'Ozzie Virevolt au nord de Kharanos, de Milli Siffleplume au Dépôt de Grillacier et de Tog Rouilletympan à l\'extérieur de l\'auberge de Kharanos. Retournez voir Toby Zeigrenage lorsque tous les discours ont été prononcés.‡分别在卡拉诺斯北边的奥齐·电环面前，钢架补给站的米利·羽哨面前和卡拉诺斯旅店外面的托格·锈链面前使用侏儒播放器。当所有演讲都播放完毕之后，回去见托比·速轮。‡',
  }
},
[25285] = {
  {
    '‡Входит и выходит!‡Rein und Raus‡‡Dentro y fuera‡Dentro y fuera‡Dedans, dehors‡有进有出‡進進出出',
    nil,
    '‡Испытайте систему катапультирования в танке-пауке.‡Testet den Schleudersitz des Mechanopanzers mit Schleudersitzsystem.‡‡Prueba el sistema de eyección del mecanotanque eyector.‡Prueba el sistema de eyección del mecanotanque eyector.‡Testez le système d\'éjection du Mécano-tank éjecteur.‡测试弹射型步行坦克的弹射系统。‡',
  }
},
[25286] = {
  {
    '‡Слова, что нужно произнести‡Wortübermittlung‡연설문 전달‡Entrega de palabras‡Entrega de palabras‡Le discours de la libération‡递送演讲稿‡遞送演講稿',
    nil,
    '‡Передайте речь капитану Ступу Искражу, который ждет вас в Поселке Сталежара.‡Gebt die Rede Hauptmann Tret Funkdüse bei Stahlrosts Depot.‡‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Apportez le discours au Capitaine Chape Étincetuyère au Dépôt de Grillacier.‡将演讲稿交给钢架补给站的崔德·火钻队长。‡',
  }
},
[25287] = {
  {
    '‡Слова, что нужно произнести‡Wortübermittlung‡연설문 전달‡Entrega de palabras‡Entrega de palabras‡Le discours de la libération‡递送演讲稿‡演說稿',
    nil,
    '‡Отправляйтесь на "Петарде" из Поселка Сталежара к главному механику Меггакруту и передайте ему речь Тоби.‡Benutzt die Flugmaschine "Donnerschlag" bei Stahlrosts Depot, um zu Hochtüftler Mekkadrill zu fliegen, und stellt ihm Tobys Rede zu.‡스틸그릴의 정비소 밖에 있는 \'천둥번개\'를 타고 땜장이왕 멕카토크에게 토비의 연설문을 가져가야 합니다.‡Sube al "Velocirrayo" desde el Almacén de Brasacerada hasta el Manitas Mayor Mekkatorque y entrégale el discurso de Toby.‡Sube al "Velocirrayo" desde el Almacén de Brasacerada hasta el Manitas Mayor Mekkatorque y entrégale el discurso de Toby.‡Montez à bord du « Coup de tonnerre », au Dépôt de Grillacier, qui vous mènera jusqu\'au Grand Bricoleur Mekkanivelle et présentez le discours de Toby.‡登上钢架补给站的“雷光号”，前往大工匠梅卡托克那里，将托比的发言稿交给他。‡',
  }
},
[25289] = {
  {
    '‡Шаг вперед...‡Ein Schritt nach vorn...‡‡El paso siguiente...‡El paso siguiente...‡Un pas en avant…‡向前一步……‡向前一步……',
    nil,
    '‡Испытайте маневренность танка-паука.‡Testet die Manövrierbarkeit des krabbelnden Mechanopanzers.‡‡Prueba la maniobrabilidad del mecanotanque de escabullida.‡Prueba la maniobrabilidad del mecanotanque de escabullida.‡Tester la maniabilité du Mécano-tank mobile.‡‡',
  }
},
[25293] = {
  {
    '‡Пропавшие‡Die Vermissten‡‡Los desaparecidos‡Los desaparecidos‡Disparitions‡失踪人口‡失蹤人口',
    nil,
    '‡Надев маскировку под сектанта, поговорите с сектантом Кагарном, сектантом Агтаром, сектантом Токкой и сектантом Рокгарой. Все они находятся на Свиноферме в Дуротаре.‡Sprecht, während Ihr Eure Kultistenverkleidung tragt, mit Kultist Kagarn, Kultist Agtar, Kultistin Tokka und Kultistin Rokaga auf dem Scheckeneberhof in Durotar.‡‡Mientras llevas puesto tu disfraz del culto, habla con el cultor Kagarn, el cultor Agtar, la cultora Tokka y la cultora Rokaga en La Pocilga en Durotar.‡Mientras llevas puesto tu disfraz del culto, habla con el cultor Kagarn, el cultor Agtar, la cultora Tokka y la cultora Rokaga en La Pocilga en Durotar.‡Revêtez le Déguisement du Culte et allez parler aux Sectateurs Kagarn, Agtar, Tokka et Rokaga à la Ferme Rêche-pourceau, en Durotar.‡‡',
  }
},
[25295] = {
  {
    '‡Шквальный огонь‡Feuer drücken‡속사포 시험‡Dispara‡Dispara‡Tirez!‡猛烈的炮火‡開火',
    nil,
    '‡Испытайте оружейные системы механотанка на ближайших целях.‡Testet die Waffensysteme des schießenden Mechanopanzers an den Zielen in der Nähe.‡가까운 표적에 공격형 기계보행전차의 속사포를 시험해야 합니다.‡Prueba los sistemas armamentísticos del mecanotanque con los objetivos cercanos.‡Prueba los sistemas armamentísticos del mecanotanque con los objetivos cercanos.‡Testez les systèmes de tir du Mécano-tank canardeur sur des cibles à proximité.‡利用附近的目标来测试射击型步行坦克的武器系统。‡',
  }
},
[25306] = {
  {
    'Você está no exército agora!‡Теперь ты в армии, гном!‡Ihr seid jetzt in der Gnarmee!‡노움 군대!‡¡Gnome digas que estás en el ejército!‡¡Gnome digas que estás en el ejército!‡L\'armée gnome‡你参军了！‡你現在入伍啦!',
    nil,
    '[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description‡[ph] Log Description',
  }
},
[25393] = {
  {
    '‡Операция Гномреган‡Operation: Gnomeregan‡놈리건 작전‡Operación: Gnomeregan‡Operación: Gnomeregan‡Opération Gnomeregan‡诺莫瑞根行动‡行動:諾姆瑞根',
    nil,
    '‡Помогите королю Меггакруту при осаде Гномрегана.‡Helft König Mekkadrill beim Angriff auf Gnomeregan.‡멕카토크 왕을 도와 놈리건을 되찾아야 합니다.‡Ayuda al rey Mekkatorque con el asalto a Gnomeregan.‡Ayuda al rey Mekkatorque con el asalto a Gnomeregan.‡Aidez le Roi Mekkanivelle lors de l\'assaut de Gnomeregan.‡参与梅卡托克国王进攻诺莫瑞根的战斗。‡',
  }
},
[25444] = {
  {
    'É sépe né léve é pé‡Идеальные шпионы‡Die perfekten Spione‡완벽한 비밀요원‡E\'pías pe\'fectos‡E\'pías pe\'fectos‡De parfaits espions‡完美的间谍‡完美間諜',
    nil,
    'Capture 5 Sapos Sen\'jin e sintonize a visão deles com a de Vanira no seu Totem-sentinela.‡Поймайте 5 сен\'джинских лягушек и заговорите их, объединив их зрение со зрением Ваниры у сторожевого тотема.‡Fangt 5 Frösche aus Sen\'jin und stimmt sie bei Vaniras Totem des Wachens auf ihre Sicht ab.‡센진 개구리 5마리를 잡아와 바니라의 감시의 토템의 주문에 걸리도록 해야 합니다.‡Captura a 5 ranas de Sen\'jin y armonízalas con la visión de Vanira en su Tótem avizor.‡Captura a 5 ranas de Sen\'jin y armonízalas con la visión de Vanira en su Tótem avizor.‡Capturez 5 Grenouilles de Sen\'jin et harmonisez-les avec la vue de Vanira grâce à son Totem sentinelle.‡捉住5只森金青蛙，把它们带到瓦妮拉的岗哨图腾旁，在她的面前对它们施法。‡捕捉5隻森金蛙，在凡妮拉的崗哨圖騰讓凡妮拉和捕捉到的青蛙進行視覺同調。',
  }
},
[25445] = {
  {
    '‡Падение Залазана‡Zalazanes Sturz‡잘라제인의 최후‡La caída de Zalazane‡La caída de Zalazane‡La chute de Zalazane‡扎拉赞恩的末日‡札拉贊恩之殞',
    nil,
    '‡Помогите Вол\'джину отвоевать Острова Эха.‡Helft Vol\'jin die Echoinseln zurückzuerobern und Zalazane zu töten.‡볼진이 메아리 섬을 되찾고 잘라제인을 처치하도록 도와야 합니다.‡Ayuda a Vol\'jin a recuperar las Islas del Eco y a matar a Zalazane.‡Ayuda a Vol\'jin a recuperar las Islas del Eco y a matar a Zalazane.‡Aidez Vol\'jin à reprendre les Îles de l\'Écho et à tuer Zalazane.‡‡',
  }
},
[25446] = {
  {
    '‡Лягушачий десант‡Frösche frei!‡개구리 투하!‡¡Ranas fuera!‡¡Ranas fuera!‡Lâcher de grenouilles!‡丢青蛙！‡起飛！放蛙！',
    nil,
    '‡Оседлав летучую мышь, воспользуйтесь мешком лягушек, чтобы сбросить 12 заговоренных лягушек на острова Эха.‡Benutzt, während Ihr Euch auf dem Rücken einer Fledermaus befindet, den Sack Frösche, um 12 abgestimmte Frösche bei den Markierungen auf den Echoinseln zu platzieren.‡박쥐를 타고 가는 동안 개구리 자루에 있는 주문에 걸린 개구리 12마리를 메아리 섬에 표시된 지역에 던져 넣어야 합니다.‡Montado sobre un murciélago, utiliza el saco de ranas para colocar 12 ranas armonizadas en los marcadores de las Islas del Eco.‡Montado sobre un murciélago, utiliza el saco de ranas para colocar 12 ranas armonizadas en los marcadores de las Islas del Eco.‡Tout en chevauchant une chauve-souris, utilisez le Sac de grenouilles pour placer 12 Grenouilles harmonisées sur les marqueurs des Îles de l\'Écho.‡‡',
  }
},
[25461] = {
  {
    '‡Вербовочный троллинг‡Freiwillige Trolle vor!‡‡Con-trol de voluntarios‡Con-trol de voluntarios‡Engagez-vous, qu\'ils disaient‡巨魔志愿兵‡搜尋志願者',
    nil,
    '‡С помощью барабанов войны Вол\'джина завербуйте 5 троллей-горожан Колючего Холма.|n|nЕсли вам нужен транспорт до Колючего Холма, поговорите с укротителем Марнлеком.‡Benutzt Vol\'jins Kriegstrommeln, um 5 Trollbürger in Klingenhügel zu rekrutieren.|n|nIhr könnt mit Tierführer Marnlek sprechen, um eine Fledermaus nach Klingenhügel zu bekommen.‡‡Usa los tambores de guerra de Vol\'jin para reclutar a 5 ciudadanos trols en Cerrotajo.|n|nPuedes hablar con el cuidador Marnlek para conseguir un viaje en murciélago hasta Cerrotajo.‡Usa los tambores de guerra de Vol\'jin para reclutar a 5 ciudadanos trols en Cerrotajo.|n|nPuedes hablar con el cuidador Marnlek para conseguir un viaje en murciélago hasta Cerrotajo.‡Utilisez les Tambours de guerre de Vol\'jin pour recruter 5 Citoyens trolls à Tranchecolline.|n|nVous pouvez parler au Dresseur Marnlek pour obtenir un tour en chauve-souris jusqu\'à Tranchecolline.‡‡',
  }
},
[25470] = {
  {
    '‡Повелительница тигров‡Herrin der Tiger‡‡Señora de los tigres‡Señora de los tigres‡La dame des tigres‡猛虎女王‡虎群仕女',
    nil,
    '‡Почувствовав в себе дух тигра, выманите тигрицу-матриарха из убежища и победите ее в битве, используя новые умения.‡Lockt die Tigermatriarchin aus ihrem Versteck, während Ihr vom Geist des Tigers erfüllt seid, und benutzt Eure neuen Fähigkeiten, um sie im Kampf zu besiegen.‡‡Mientras estás imbuido con el espíritu del tigre, atrae a la matriarca tigresa para que salga de su escondrijo y utiliza tus nuevas facultades para superarla en el combate.‡Mientras estás imbuido con el espíritu del tigre, atrae a la matriarca tigresa para que salga de su escondrijo y utiliza tus nuevas facultades para superarla en el combate.‡Pendant que vous êtes $Gimprégné:imprégnée; de l\'Esprit du tigre, attirez la Matriarche des tigres et utilisez vos nouvelles compétences pour l\'affronter et la vaincre.‡‡',
  }
},
[25480] = {
  {
    '‡Танец духов‡Tanz der Geister‡‡Danza de los e\'píritus‡Danza de los e\'píritus‡La danse des esprits‡英灵的舞蹈‡眾魂之舞',
    nil,
    '‡Когда вы будете готовы к общению с духами, поговорите с знахарем Хез\'током , который ждет вас рядом с кругом ритуальных танцев.‡Sprecht beim Kreis der Ritualtänzer außerhalb von Sen\'jin mit Hexendoktor Hez\'tok, wenn Ihr bereit seid, die Omen zu konsultieren.‡‡Habla con el médico brujo Hez\'tok cerca del círculo de bailarines rituales fuera del Poblado Sen\'jin cuando estés $Gpreparado:preparada; para consultar los augurios.‡Habla con el médico brujo Hez\'tok cerca del círculo de bailarines rituales fuera del Poblado Sen\'jin cuando estés $Gpreparado:preparada; para consultar los augurios.‡Parlez au Féticheur Hez\'tok près du cercle des danseurs rituels aux abords du Village de Sen\'jin lorsque vous êtes $Gprêt:prête; à faire appel aux augures.‡‡',
  }
},
[25482] = {
  {
    'Masmorra de Evento Mundial – Cavaleiro Sem Cabeça‡World Event Dungeon - Headless Horseman‡World Event Dungeon - Headless Horseman‡이벤트 던전 - 저주받은 기사‡World Event Dungeon - Headless Horseman‡World Event Dungeon - Headless Horseman‡Donjon d\'évènement saisonnier - Cavalier sans tête‡地下城世界事件 - 无头骑士‡世界事件地城 - 無頭騎士',
    nil,
    nil,
  }
},
[25483] = {
  {
    'Masmorra de Evento Mundial – Coren Cervatroz‡World Event Dungeon - Coren Direbrew‡World Event Dungeon - Coren Direbrew‡이벤트 던전 - 코렌 다이어브루‡World Event Dungeon - Coren Direbrew‡World Event Dungeon - Coren Direbrew‡Donjon d\'évènement saisonnier - Coren Navrebière‡地下城世界事件 - 科林·烈酒‡世界事件地城 - 寇仁·恐酒',
    nil,
    nil,
  }
},
[25484] = {
  {
    'Masmorra de Evento Mundial – Ahune‡World Event Dungeon - Ahune‡World Event Dungeon - Ahune‡이벤트 던전 - 아훈‡World Event Dungeon - Ahune‡World Event Dungeon - Ahune‡Donjon d\'évènement saisonnier - Ahune‡地下城世界事件 - 埃霍恩‡世界事件地城 - 艾胡恩',
    nil,
    nil,
  }
},
[25485] = {
  {
    'Masmorra de Evento Mundial – Hummel‡World Event Dungeon - Hummel‡World Event Dungeon - Hummel‡이벤트 던전 - 훔멜‡World Event Dungeon - Hummel‡World Event Dungeon - Hummel‡Donjon d\'évènement saisonnier - Hummel‡地下城世界事件 - 汉摩尔‡世界事件地城 - 胡默爾',
    nil,
    nil,
  }
},
[25495] = {
  {
    '‡Подготовка к битве‡Vorbereitung auf die Schlacht‡전투 준비‡Preparándose p\'a la batalla‡Preparándose p\'a la batalla‡Préparation au combat‡战争准备‡開戰準備',
    nil,
    '‡Встретьтесь с Вол\'джином на острове к востоку от военного лагеря. Если вам нужен транспорт, поговорите с укротителем Марнлеком.‡Sprecht mit Tierführer Marnlek, um einen Flug zum Sammelpunkt zu bekommen. Trefft Euch auf der Insel östlich des Kriegslagers mit Vol\'jin.‡조련사 만렉과 대화하고 집결지로 날아가십시오. 전투 야영지 동쪽에 있는 섬에서 볼진을 만나야 합니다.‡Habla con el cuidador Marnlek para volar hasta la zona de escala. Encuéntrate con Vol\'jin en la isla al este del campamento de guerra.‡Habla con el cuidador Marnlek para volar hasta la zona de escala. Encuéntrate con Vol\'jin en la isla al este del campamento de guerra.‡Parlez au Dresseur Marnlek pour obtenir un vol vers la zone de rassemblement. Retrouvez Vol\'jin sur l\'île à l\'est du Camp de guerre.‡‡',
  }
},
[25500] = {
  {
    '‡Слова, что нужно произнести‡Wortübermittlung‡연설문 전달‡Entrega de palabras‡Entrega de palabras‡Le discours de la libération‡递送演讲稿‡',
    nil,
    '‡Передайте речь капитану Ступу Искражу, который ждет вас в Поселке Сталежара.‡Gebt die Rede Hauptmann Tret Funkdüse bei Stahlrosts Depot.‡‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Dale el discurso al capitán Tread Chispaboquilla en el Almacén de Brasacerada.‡Apportez le discours au Capitaine Chape Étincetuyère au Dépôt de Grillacier.‡将演讲稿交给钢架补给站的崔德·火钻队长。‡',
  }
},
[26012] = {
  {
    '‡Беда в храме Драконьего Покоя‡Ärger im Wyrmruhtempel‡고룡쉼터의 골칫거리‡Problemas en Reposo del Dragón‡Problemas en Reposo del Dragón‡Troubles au Repos du ver‡龙眠之灾‡龍眠神殿的麻煩',
    nil,
    '‡Поговорите с Красом в храме Драконьего Покоя, что в Драконьем Погосте.‡Sprecht mit Krasus im Wyrmruhtempel in der Drachenöde.‡용의 안식처에 있는 고룡쉼터 사원에서 크라서스와 대화해야 합니다.‡Habla con Krasus en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Habla con Krasus en el Templo del Reposo del Dragón en el Cementerio de Dragones.‡Parlez à Krasus, au Temple du Repos du ver, dans la Désolation des dragons.‡前往龙骨荒野，和龙眠神殿中的克拉苏斯交谈。‡',
  }
},
[26013] = {
  {
    '‡Нападение на святилище‡Angriff auf das Sanktum‡공격받은 성소‡Asalto al Sagrario‡Asalto al Sagrario‡Assaut sur le sanctum‡突袭红玉圣殿‡對聖所的攻擊',
    nil,
    '‡Осмотрите Рубиновое святилище под храмом Драконьего Покоя.‡Untersucht das Rubinsanktum unterhalb des Wyrmruhtempels.‡고룡쉼터 사원 아래에 있는 루비 성소를 조사해야 합니다.‡Investiga el Sagrario Rubí bajo el Templo del Reposo del Dragón.‡Investiga el Sagrario Rubí bajo el Templo del Reposo del Dragón.‡Menez une enquête au Sanctum Rubis, sous le Temple du Repos du ver.‡调查龙眠神殿之下的红玉圣殿。‡',
  }
},
[26034] = {
  {
    '‡Сумеречный разрушитель‡Der Zwielichtzerstörer‡황혼의 파괴자‡El Destructor del Crepúsculo‡El Destructor del Crepúsculo‡Le destructeur du Crépuscule‡暮光毁灭者‡暮光毀滅者',
    nil,
    '‡Победите Халиона и отразите нападение на Рубиновое святилище.‡Besiegt Halion und drängt die Invasion des Rubinsanktums zurück.‡할리온을 처치하고 루비 성소 습격자들을 물리쳐야 합니다.‡Derrota a Halion y repele la invasión del Sagrario Rubí.‡Derrota a Halion y repele la invasión del Sagrario Rubí.‡Détruisez Halion et repoussez les envahisseurs qui ont investi le Sanctum Rubis.‡击败海里昂和入侵红玉圣殿的敌人。‡',
  }
},
