[8778] = {
  {
    'A Brigada de Altaforja vai botar pra explodir!‡Взрывчатка для дружины Стальгорна‡Die Eisenschmiedebrigade braucht Sprengstoff!‡아이언포지 여단에 폭탄 공급!‡La Brigada de Forjaz necesita explosivos‡¡La Brigada de Forjaz necesita explosivos!‡La brigade de Forgefer a besoin d\'explosifs !‡铁炉堡军团需要爆炸品！‡鐵爐堡兵團需要爆裂物!',
    nil,
    'Leve 6 Óleos de Imolação, 5 Combustíveis de Foguete Goblínico e 10 Pós Explosivos Densos para a Arcanista Molabico, que está perto de Colme\'Zora, em Silithus. Você também precisa entregar as Instruções de Logística IV para completar esta tarefa.‡Принесите 6 бутылок воспламеняющей смеси, 5 бочонков гоблинского ракетного топлива и 10 порций концентрированного взрывчатого вещества чародею Форсунчику возле улья Зора в Силитусе. Кроме того, принесите тыловое задание IV.‡Bringt Arkanist Sprinkelstaub nahe des Zoraschwarmbaus in Silithus 6 Öle des Feuerbrandes, 5 Einheiten Goblinraketentreibstoff und 10 Einheiten dichtes Sprengpulver. Ihr benötigt auch Logistikeinsatz IV, um diese Aufgabe abschließen zu können.‡실리더스의 하이브조라 근처에 있는 비전술사 노즐스프링에게 제물의 기름 6개, 고블린 로켓 연료 5개, 강도 높은 화약 10개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 IV도 함께 가져가야 합니다.‡Lleva 6 aceites de inmolación, 5 combustibles de cohete goblin y 10 unidades de pólvora densa al arcanista Bocafuente cerca de Colmen\'Zora en Silithus. También debes llevar el Informe de tareas logísticas IV para poder completar la misión.‡Lleva 6 aceites de inmolación, 5 combustibles de cohete goblin y 10 unidades de pólvora densa al arcanista Bocafuente cerca de Colmen\'Zora en Silithus. También debes llevar el Informe de tareas logísticas IV para poder completar la misión.‡Apporter 6 Huiles d\'immolation, 5 doses de Carburant de fusée gobelin et 10 doses de Poudre d\'explosion dense à l\'arcaniste Tuyèraressort, près de la Ruche\'Zora en Silithus. Vous devez aussi apporter le Briefing logistique IV pour terminer cette quête.‡把6瓶献祭之油、5瓶地精火箭燃油和10份致密炸药粉交给希利苏斯地区的佐拉虫巢附近的奥术师诺斯宾。你还必须带着后勤任务简报 IV才能完成这个任务。‡把6瓶獻祭之油、5瓶哥布林火箭燃油和10份緻密火藥粉交給希利蘇斯地區的佐拉蟲巢附近的秘術師諾斯賓。你還必須帶著後勤任務簡報 IV才能完成這個任務。',
  }
},
[8779] = {
  {
    'Matérias-primas de vidência‡Материалы для гадания‡Magische Materialien‡수정점 재료‡Materiales de visión‡Materiales de visión‡Le matériel de divination‡研究材料‡研究材料',
    nil,
    'Leve 1 Estilhaço Brilhante Grande, 1 Estilhaço Radiante Grande e 1 Esmeralda Enorme para a Geóloga Matarriso, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística V para concluir esta missão.‡Принесите 1 большой сияющий осколок, 1 большой светозарный осколок и 1 огромный изумруд геологу Ехидной в крепость Кенария в Силитусе. Также принесите тыловое задание V.‡Bringt 1 großen glänzenden Splitter, 1 großen strahlenden Splitter und einen gewaltigen Smaragd zu Geologin Lerchenbann auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz V, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 지질학자 락스베인에게 눈부신 큰 결정, 찬란하게 빛나는 큰 결정, 거대한 에메랄드를 각각 1개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 V도 함께 가져가야 합니다.‡Lleva 1 fragmento luminoso grande, 1 fragmento radiante grande y 1 esmeralda enorme a la Geóloga Trotuina en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas V para poder completar la misión.‡Lleva 1 fragmento luminoso grande, 1 fragmento radiante grande y 1 esmeralda enorme a la Geóloga Trotuina en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas V para poder completar la misión.‡Apporter un 1 Grand éclat brillant, 1 Gros éclat irradiant et 1 Enorme émeraude à la géologue Fablemort, au Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique V pour terminer cette quête.‡把1份大块魔光碎片、1份大块强光碎片和1块巨型绿宝石交给希利苏斯塞纳里奥要塞的地质学家拉克斯班。你还必须随身带着后勤任务简报 V才能完成这个任务。‡將一個大塊魔光裂片，一個大塊強光裂片和一個巨型翡翠帶到希利蘇斯給塞納里奧城堡的地理學家拉克斯班。你還必須將後勤任務簡報 V帶去才能完成這個任務。',
  }
},
[8780] = {
  {
    'Kits de armadura para o campo‡Комплекты брони‡Rüstungssets für den Feldeinsatz‡전장에 방어구 키트 공급‡Refuerzos para armadura para el campo de batalla‡Refuerzos para armadura para el campo de batalla‡Des renforts d\'armure pour le champ de bataille‡战场上的护甲片‡戰場上的護甲片',
    nil,
    'Leve 8 Kits de Armadura Rústica e 8 Kits de Armadura Pesada para Jenila Fortemalho no Posto Avançado da Brigada de Altaforja, perto da Colme\'Zora, em Silithus. Você também precisa entregar as Instruções de Logística VII para concluir a missão.‡Принесите 8 комплектов грубой брони и 8 накладок из толстой кожи Джанеле Твердомолот на заставу дружины Стальгорна возле улья Зора в Силитусе. Кроме того, сдайте тыловую задачу VII.‡Bringt 8 unverwüstliche Rüstungssets und 8 schwere Rüstungsset zu Janela Starkhammer am Posten der Eisenschmiedebrigade beim Zoraschwarmbau in Silithus. Ihr benötigt auch Logistikeinsatz VII, um diese Aufgabe abschließen zu können.‡실리더스의 하이브조라 근처 아이언포지 여단 주둔지에 있는 자넬라 스타우트해머에게 튼튼한 방어구 키트와 고급 방어구 키트를 각각 8개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 VII도 함께 가져가야 합니다.‡Lleva 8 complementos bastos para armadura y 8 complementos pesados para armadura a Janela Martillotenaz en la Avanzada de la Brigada de Forjaz, cerca de Colmen\'Zora, en Silithus. También debes llevar el Informe de tareas logísticas VII para poder completar la misión.‡Lleva 8 refuerzos para armadura bastos y 8 refuerzos para armadura pesados a Janela Martillotenaz en la Avanzada de la Brigada de Forjaz, cerca de Colmen\'Zora, en Silithus. También debes llevar el Informe de tareas logísticas VII para poder completar la misión.‡Apportez 8 Renforts d\'armure robustes et 8 Renforts d\'armure lourds à Janela Rudemartel, à l\'avant-poste de la brigade de Forgefer, près de la Ruche\'Zora. Vous devez aussi apporter le Briefing logistique VII pour terminer cette quête.‡将8块毛皮护甲片和8块重型护甲片交给佐拉虫巢附近的珍妮拉·钢锤。你还必须随身带着后勤任务简报 VII才能完成这个任务。‡將8塊毛皮護甲片和8塊重型護甲片交給佐拉蟲巢附近的珍妮拉·頑錘。你還必須將後勤任務簡報 VII帶去才能完成這個任務。',
  }
},
[8781] = {
  {
    'Armas para o campo‡Нехватка оружия‡Waffen für den Feldeinsatz‡전장에 무기 공급‡Armas para el campo de batalla‡Armas para el campo de batalla‡Des armes pour le champ de bataille‡战场上的武器‡戰場上的武器',
    nil,
    'Leve 2 Espadas Largas de Lunaço para Jenila Fortemalho no Posto Avançado da Brigada de Altaforja, perto da Colme\'Zora. Você também precisa entregar as Instruções de Logística VI para concluir a missão.‡Принесите 2 палаша из лунной стали Джанеле Твердомолот на заставу дружины Стальгорна возле улья Зора в Силитусе. Кроме того, сдайте тыловую задачу VI.‡Bringt 2 Mondstahlbreitschwerter zu Janela Starkhammer am Posten der Eisenschmiedebrigade beim Zoraschwarmbau. Ihr benötigt auch Logistikeinsatz VI, um diese Aufgabe abschließen zu können.‡하이브조라 외곽의 아이언포지 여단 주둔지에 있는 자넬라 스타우트해머에게 달의 강철 브로드소드 2개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 VI도 함께 가져가야 합니다.‡Lleva 2 espadas de acero lunar a Janela Martillotenaz en la Avanzada de la Brigada de Forjaz, en las afueras de Colmen\'Zora. También debes llevar el Informe de tareas logísticas VI para poder completar la misión.‡Lleva 2 espadas anchas de acero lunar a Janela Martillotenaz en la Avanzada de la Brigada de Forjaz, en las afueras de Colmen\'Zora. También debes llevar el Informe de tareas logísticas VI para poder completar la misión.‡Apportez 2 Epées d\'acier lunaire à Janela Rudemartel, à l\'avant-poste de la brigade de Forgefer, près de la Ruche\'Zora. Vous devez aussi apporter le Briefing logistique VI pour terminer cette quête.‡将2把月钢宽剑交给佐拉虫巢附近的珍妮拉·钢锤。你还必须随身带着后勤任务简报 VI才能完成这个任务。‡將2把月鋼寬劍帶到佐拉蟲巢外的鐵爐堡兵團前哨給珍妮拉·頑錘。你還必須將後勤任務簡報 VI帶去才能完成這個任務。',
  }
},
[8782] = {
  {
    'Suprimentos de uniformização‡Поставки формы‡Uniformnachschub‡제복 공급‡Suministros para uniformes‡Suministros para uniformes‡La question des uniformes‡制服供应‡制服供應',
    nil,
    'Leve 1 Lunatrama, 2 Peças de Runatrama e 1 Seda de Aranha Ferroteia para o Arauto do Vento Chifre Altivo, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística VIII para concluir esta missão.‡Принесите 1 кусок луноткани, 2 рулона рунической ткани и 1 железношелковую паутину призывательнице ветров Гордый Рог в крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу VIII.‡Bringt 1 Einheit Mondstoff, 2 Runenstoffballen und 1 Einheit Eisenweberseide zu Windruferin Prachthorn auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz VIII, um diese Aufgabe abschließen zu können.‡실리더스 세나리온 요새에 있는 바람소환사 프라우드혼에게 달빛 옷감 1개, 룬무늬 두루마리 2개, 그리고 강철그물 거미줄 1개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 VIII도 함께 가져가야 합니다.‡Lleva 1 tela lunar, 2 madejas de paño rúnico y 1 seda de araña Tejehierro a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas VIII para poder completar la misión.‡Lleva 1 tela lunar, 2 madejas de paño rúnico y 1 seda de araña Tejehierro a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas VIII para poder completar la misión.‡Remettre 1 Etoffe lunaire, 2 Rouleaux d\'étoffe runique et 1 Soie d\'araignée toilacier à l\'Imploratrice céleste Corne-fière au Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique VIII pour terminer cette quête.‡把1块月布、2卷符文布卷和1份铁网蛛丝交给塞纳里奥要塞的唤风者梅恩·长角。你还必须随身带着后勤任务简报 VIII才能完成这个任务。‡把1塊月布、2卷符文布卷和1份鐵網蛛絲交給喚風者傲角。你還必須將後勤任務簡報 VIII帶去才能完成這個任務。',
  }
},
[8783] = {
  {
    'Materiais extraordinários e onde se encontram‡Необычные материалы‡Besondere Materialien‡특별한 재료‡Materiales encantados‡Materiales encantados‡Des matériaux extraordinaires‡特殊的材料‡特殊的材料',
    nil,
    'Leve 2 Barras de Tório Encantado e 2 Couros Encantados para Vargus, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística IX para concluir a missão.‡Принесите Варгусу из крепости Кенария в Силитусе 2 зачарованных ториевых слитка и 2 куска зачарованной кожи. Кроме того, принесите тыловое задание IX.‡Bringt Vargus auf Burg Cenarius in Silithus 2 verzauberte Thoriumbarren und 2 Einheiten verzaubertes Leder. Ihr benötigt auch Logistikeinsatz IX, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 바르구스에게 마력 깃든 토륨 주괴 2개, 마력 깃든 가죽 2개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 IX도 함께 가져가야 합니다.‡Lleva 2 barras de torio encantado y 2 cueros encantados a Vargus en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas IX para poder completar la misión.‡Lleva 2 barras de torio encantado y 2 cueros encantados a Vargus en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas IX para poder completar la misión.‡Remettre 2 Barres de thorium enchanté et 2 Cuirs enchantés à Vargus au Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique IX pour terminer cette quête.‡把2块魔化瑟银锭和2块魔化皮交给希利苏斯塞纳里奥要塞的瓦古斯。你还必须随身带着后勤任务简报 IX才能完成这个任务。‡帶2個附魔瑟銀錠和2塊附魔皮革到希利蘇斯給塞納里奧城堡的瓦古斯。你還必須將後勤任務簡報 IX帶去才能完成這個任務。',
  }
},
[8784] = {
  {
    'Segredos dos Qiraji‡Секреты Кираи‡Geheimnisse der Qiraji‡퀴라지의 비밀‡Los secretos de los qiraji‡Los secretos de los qiraji‡Les secrets des Qiraji‡其拉的秘密‡其拉軍的秘密',
    nil,
    'Leve o Artefato Qiraji Antigo aos dragões escondidos perto da entrada do templo.‡Принесите древний киражский артефакт драконам, которые укрылись в храме, недалеко от входа.‡Bringt das uralte Qirajiartefakt zu den Drachen, die sich nahe des Tempeleingangs versteckt halten.‡신전 입구 근처에 숨어 있는 용족에게 고대 퀴라지 유물을 가져가야 합니다.‡Llévale el artefacto antiguo qiraji a los dragones ocultos cerca de la entrada del templo.|n‡Llévale el artefacto antiguo qiraji a los dragones ocultos cerca de la entrada del templo.|n‡Remettre l\'Ancien artefact qiraji aux dragons qui se cachent près de l\'entrée du temple.‡把上古其拉神器交给隐藏在神殿入口处的龙类。‡將這個上古其拉神器帶給藏在神廟入口附近的巨龍。',
  }
},
[8785] = {
  {
    'A Legião de Orgrimmar precisa de mojo!‡Амулеты для легиона Оргриммара‡Die Orgrimmarlegion braucht Mojo!‡오그리마 군단에 모조 공급!‡¡La Legión de Orgrimmar necesita mojo!‡¡La Legión de Orgrimmar necesita mojo!‡La légion d\'Orgrimmar a besoin de mojo !‡奥格瑞玛军团需要魔精！‡奧格瑪軍團需要魔精油!',
    nil,
    'Leve 6 Mojos Poderosos, 6 Frascos de Mojo Grande e 8 Óleos de Imolação para a Sacerdotisa Sombria Shai, que fica perto de Colme\'Régia, em Silithus. Você também precisa entregar as Instruções de Logística IV para completar esta tarefa.‡Принесите 6 мощных амулетов, 6 бутылей большого колдунства и 8 бутылок воспламеняющей смеси жрице Тьмы Шаи к улью Регал в Силитус. Кроме того, принесите тыловое задание IV.‡Bringt Schattenpriesterin Shai nahe des Regalschwarmbaus in Silithus 6 Einheiten mächtiges Mojo, 6 Fläschchen großes Mojo und 8 Öle des Feuerbrandes. Ihr benötigt auch Logistikeinsatz IV, um diese Aufgabe abschließen zu können.‡실리더스의 하이브레갈 근처에 있는 어둠의여사제 샤이에게 제물의 기름 8개, 왕모조 물약 6개, 강력한 모조 6개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 IV도 함께 가져가야 합니다.‡Lleva 6 mojos potentes, 6 frascos de gran mojo y 8 aceites de inmolación a la sacerdotisa de las Sombras Shai cerca de Colmen\'Regal, en Silithus. También debes llevar el Informe de tareas logísticas IV para poder completar la misión.‡Lleva 6 mojos potentes, 6 frascos de gran mojo y 8 aceites de inmolación a la sacerdotisa de las Sombras Shai cerca de Colmen\'Regal, en Silithus. También debes llevar el Informe de tareas logísticas IV para poder completar la misión.‡Apporter 6 Mojos puissants, 6 Flacons de grand mojo et 8 Huiles d\'immolation à la Prêtresse des ombres Shai, près de la Ruche\'Regal en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique IV.‡把6份强力魔精、6份大瓶魔精和8份献祭之油交给希利苏斯地区的雷戈虫巢附近的暗影祭司沙艾。你还必须随身带着后勤任务简报 IV才能完成这个任务。‡帶6瓶特強魔精油，6個瓶裝大魔精和8瓶獻祭之油到希利蘇斯給雷戈蟲巢附近的暗影牧師珊雅。你還必須將後勤任務簡報 IV帶去才能完成這個任務。',
  }
},
[8786] = {
  {
    'Armas para o campo‡Нехватка оружия‡Waffen für den Feldeinsatz‡전장에 무기 공급‡Armas para el campo de batalla‡Armas para el campo de batalla‡Des armes pour le champ de bataille‡战场上的武器‡戰場上的武器',
    nil,
    'Leve 3 Machados Sólidos de Ferro para Merok Passo Longo no acampamento da Legião de Orgrimmar, do lado de fora da Colme\'Régia. Você também precisa entregar as Instruções de Logística VI para concluir a missão.‡Принесите 3 массивных железных топора Мероку Долгому Шагу в лагерь легиона Оргриммара рядом с ульем Регал. Кроме того, сдайте тыловую задачу VI.‡Bring 3 massive Eisenäxte zu Merok Langschreiter im Lager der Orgrimmarlegion außerhalb des Regalschwarmbaus. Ihr benötigt auch Logistikeinsatz VI, um diese Aufgabe abschließen zu können.‡하이브레갈 외곽 오그리마 군단 주둔지에 있는 메로크 롱스트라이드에게 큰 철제 도끼 3개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 VI도 함께 가져가야 합니다.‡Lleva 3 hachas de hierro macizo a Merok Zancada Larga en el campamento de la Legión de Orgrimmar, en las afueras de Colmen\'Regal. También debes llevar el Informe de tareas logísticas VI para poder completar la misión.‡Lleva 3 hachas de hierro macizo a Merok Zancada Larga en el campamento de la Legión de Orgrimmar, en las afueras de Colmen\'Regal. También debes llevar el Informe de tareas logísticas VI para poder completar la misión.‡Remettre 3 Haches massives en fer à Merok Long-pas, au camp de la légion d\'Orgrimmar, à l\'extérieur de la Ruche\'Regal. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique VI.‡将3把巨型铁斧交给雷戈虫巢附近的梅洛克·远途。你还必须随身带着后勤任务简报 VI才能完成这个任务。‡帶3把巨型鐵斧到雷戈蟲巢外面的奧格瑪軍團營地，交給梅洛克·遠途。你還必須將後勤任務簡報 VI帶去才能完成這個任務。',
  }
},
[8787] = {
  {
    'Kits de armadura para o campo‡Комплекты брони‡Rüstungssets für den Feldeinsatz‡전장에 방어구 키트 공급‡Refuerzos para armadura para el campo de batalla‡Refuerzos para armadura para el campo de batalla‡Des renforts d\'armure pour le champ de bataille‡战场上的护甲片‡戰場上的護甲片',
    nil,
    'Leve 8 Kits de Armadura Rústica e 8 Kits de Armadura Pesada para Merok Passo Longo perto de Colme\'Régia. Você também precisa entregar as Instruções de Logística VII para concluir a missão.‡Принесите 8 комплектов грубой брони и 8 накладок из толстой кожи Мероку Долгому Шагу к улью Регал. Кроме того, сдайте тыловую задачу VII.‡Bringt 8 unverwüstliche Rüstungssets und 8 schwere Rüstungsset zu Merok Langschreiter nahe des Regalschwarmbaus. Ihr benötigt auch Logistikeinsatz VII, um diese Aufgabe abschließen zu können.‡하이브레갈 부근에 있는 메로크 롱스트라이드에게 튼튼한 방어구 키트와 고급 방어구 키트를 각각 8개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 VII도 함께 가져가야 합니다.‡Lleva 8 refuerzos para armadura bastos y 8 refuerzos para armadura pesados a Merok Zancada Larga, cerca de Colmen\'Regal. También debes llevar el Informe de tareas logísticas VII para poder completar la misión.‡Lleva 8 refuerzos para armadura bastos y 8 refuerzos para armadura pesados a Merok Zancada Larga, cerca de Colmen\'Regal. También debes llevar el Informe de tareas logísticas VII para poder completar la misión.‡Apportez 8 Renforts d\'armure robustes et 8 Renforts d\'armure lourds à Merok Long-pas près de la Ruche\'Regal. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique VII.‡将8块毛皮护甲片和8块重型护甲片交给雷戈虫巢附近的梅洛克·远途。你还必须随身带着后勤任务简报 VII才能完成这个任务。‡帶8塊毛皮護甲片和8塊重型護甲片給雷戈蟲巢附近的梅洛克·遠途。你還必須將後勤任務簡報 VII帶去才能完成這個任務。',
  }
},
[8788] = {
  {
    'Um presente chacoalhado gentilmente‡Слегка помятый подарок‡Ein leicht geschütteltes Geschenk‡누가 살짝 흔들어 본 선물‡Un obsequio ligeramente agitado‡Un obsequio ligeramente agitado‡Un cadeau secoué doucement‡轻轻摇晃过的礼品‡輕輕搖晃過的禮物',
    nil,
    nil,
  }
},
[8789] = {
  {
    'Armamentos Imperiais Qiraji‡Киражское императорское оружие‡Imperiale Qirajiwaffen‡제국의 퀴라지 무기‡Armamentos imperiales qiraji‡Armamentos imperiales qiraji‡Les armes impériales qiraji‡其拉帝王武器‡其拉帝王武器',
    nil,
    'Arygos, no Templo de Ahn\'Qiraj, criará Armamentos Infundidos em Elemêntio para você. Para tanto, entregue-lhe Armamentos Imperiais Qirajis e 3 Minérios de Elemêntio.‡Аригос в Храме Ан\'Киража создаст для вас усиленное элементием оружие, если вы принесете ему киражское имперское оружие и 3 куска элементиевой руды.‡Arygos im Tempel von Ahn\'Qiraj wird Euch mit Elementium erfüllte Ausrüstung herstellen, wenn Ihr ihm imperiale Qirajiwaffen und 3 Einheiten Elementiumerz bringt.‡안퀴라즈 사원에 있는 아리고스에게 제국의 퀴라지 무기와 엘레멘티움 광석 3개를 가지고 가면 엘레멘티움을 주입한 무기를 만들어 줄 것입니다.‡Arygos en el Templo de Ahn\'Qiraj creará armamento imbuido de Elementium para ti si le llevas armamento imperial qiraji y 3 menas de Elementium.‡Arygos en el Templo de Ahn\'Qiraj creará armamento imbuido de elementium para ti si le llevas armamento imperial qiraji y 3 menas de elementium.‡Arygos, dans le temple d\'Ahn\'Qiraj, vous fabriquera des armes imprégnées d\'élémentium si vous lui procurez des Armes impériales qiraji et 3 Minerais d\'élémentium.‡把其拉帝王武器和3块源质矿石交给安其拉神殿的亚雷戈斯，他会帮你制作使用源质强化过的武器。‡把其拉帝王武器和3塊源質礦石交給安其拉神廟的亞雷戈斯，他會幫你製作使用源質灌注的武器。',
  }
},
[8790] = {
  {
    'Paramentos Imperiais Qiraji‡Киражские императорские регалии‡Imperiale Qirajiinsignien‡제국의 퀴라지 표장‡Atavío imperial qiraji‡Atavío imperial qiraji‡La tenue de parade impériale qiraji‡其拉帝王徽记‡其拉帝王標誌',
    nil,
    'Merithra do Sonho, no Templo de Ahn\'Qiraj, criará Armamentos Infundidos em Elemêntio para você. Para tanto, entregue-lhe Paramentos Imperiais Qiraji e 3 Minérios de Elemêntio.|n‡Меритра из Сна в Храме Ан\'Киража может создать для вас усиленное элементием оружие, если вы принесете ей киражские имперские регалии и 3 куска элементиевой руды.‡Merithra des Traums im Tempel von Ahn\'Qiraj wird Euch mit Elementium erfüllte Ausrüstung herstellen. Bringt ihr dazu imperiale Qirajiinsignien und 3 Einheiten Elementiumerz.‡안퀴라즈 사원에 있는 꿈의 메리스라에게 제국의 퀴라지 표장과 엘레멘티움 광석 3개를 가지고 가면 엘레멘티움을 주입한 무기를 만들어 줄 것입니다.‡Merithra del Sueño en el Templo de Ahn\'Qiraj creará armamento imbuido de Elementium para ti si le llevas regalos imperiales qiraji y 3 menas de Elementium.‡Merithra del Sueño en el Templo de Ahn\'Qiraj creará armamento imbuido de elementium para ti si le llevas un atavío imperial qiraji y 3 menas de elementium.|n‡Merithra du Rêve, au temple d\'Ahn\'Qiraj, vous fabriquera des armes imprégnées d\'élémentium si vous lui ramenez une Tenue de parade impériale qiraji et 3 Minerais d\'élémentium.‡把其拉帝王徽记和3块源质矿石交给安其拉神殿的梦境之龙麦琳瑟拉，她会帮你制作使用源质强化过的武器。‡如果你能將其拉帝王徽記和3個源質礦石帶給安其拉神廟『夢境之龍』麥琳瑟拉，她就能為你製作源質灌注的武器。',
  }
},
[8791] = {
  {
    'A queda de Ossirian‡Повергнутый Оссириан‡Der Untergang von Ossirian‡오시리안 처치‡La caída de Osirio‡La caída de Osirio‡La chute d\'Ossirian‡奥斯里安之死‡奧斯里安的隕落',
    nil,
    'Entregue a Cabeça de Ossirian, o Imaculado, ao Comandante Mar\'alith no Forte Cenariano, que fica em Silithus.‡Принесите голову Оссириана Неуязвимого командору Мар\'алиту в крепость Кенария.‡Bringt den Kopf von Ossirian dem Narbenlosen zu Kommandant Mar\'alith auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 지휘관 마랄리스에게 무적의 오시리안의 머리를 가지고 가야 합니다.‡Entrégale la cabeza de Osirio el Sinmarcas al comandante Mar\'alith de Fuerte Cenarion en Silithus.|n‡Entrégale la cabeza de Osirio el Sinmarcas al comandante Mar\'alith de Fuerte Cenarion en Silithus.|n‡Remettez la Tête d\'Ossirian l\'Intouché au commandant Mar\'alith, au Fort cénarien en Silithus.‡将无疤者奥斯里安的徽记交给希利苏斯塞纳里奥要塞的指挥官玛尔利斯。‡將『無疤者』奧斯里安的頭顱帶到希利蘇斯給塞納里奧城堡的指揮官瑪爾利斯。',
  }
},
[8792] = {
  {
    'A Horda precisa de você!‡Орде нужна твоя помощь!‡Die Horde braucht Euch!‡호드 지원!‡¡La Horda te necesita!‡¡La Horda te necesita!‡La Horde a besoin de votre aide !‡部落需要你的帮助！‡部落需要你的幫助!',
    nil,
    'Fale com o Senhor da Guerra Gorchuk no Vale dos Espíritos em Orgrimmar.‡Поговорите с вождем Горчуком на аллее Духов Оргриммара.‡Sprecht mit Kriegsherr Gorchuk im Tal der Geister in Orgrimmar.‡오그리마, 정기의 골짜기에 있는 장군 고르척과 대화해야 합니다.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Parler au seigneur de guerre Gorchuk, dans la vallée des Esprits d\'Orgrimmar.‡和奥格瑞玛精神谷的督军格尔库克谈一谈。‡和奧格瑪精神谷的督軍格爾庫克交談。',
  }
},
[8793] = {
  {
    'A Horda precisa de você!‡Орде нужна твоя помощь!‡Die Horde braucht Euch!‡호드 지원!‡¡La Horda te necesita!‡¡La Horda te necesita!‡La Horde a besoin de votre aide !‡部落需要你的帮助！‡部落需要你的幫助!',
    nil,
    'Fale com o Senhor da Guerra Gorchuk no Vale dos Espíritos em Orgrimmar.‡Поговорите с вождем Горчуком на аллее Духов Оргриммара.‡Sprecht mit Kriegsherr Gorchuk im Tal der Geister in Orgrimmar.‡오그리마, 정기의 골짜기에 있는 장군 고르척과 대화해야 합니다.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Parler au seigneur de guerre Gorchuk, dans la vallée des Esprits d\'Orgrimmar.‡和奥格瑞玛精神谷的督军格尔库克谈一谈。‡和奧格瑪精神谷的督軍格爾庫克交談。',
  }
},
[8794] = {
  {
    'A Horda precisa de você!‡Орде нужна твоя помощь!‡Die Horde braucht Euch!‡호드 지원!‡¡La Horda te necesita!‡¡La Horda te necesita!‡La Horde a besoin de votre aide !‡部落需要你的帮助！‡部落需要你的幫助!',
    nil,
    'Fale com o Senhor da Guerra Gorchuk no Vale dos Espíritos em Orgrimmar.‡Поговорите с вождем Горчуком на аллее Духов Оргриммара.‡Sprecht mit Kriegsherr Gorchuk im Tal der Geister in Orgrimmar.‡오그리마, 정기의 골짜기에 있는 장군 고르척과 대화해야 합니다.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Habla con el señor de la guerra Gorchuk en el Valle de los Espíritus de Orgrimmar.‡Parler au seigneur de guerre Gorchuk, dans la vallée des Esprits d\'Orgrimmar.‡和奥格瑞玛精神谷的督军格尔库克谈一谈。‡和奧格瑪精神谷的督軍格爾庫克交談。',
  }
},
[8795] = {
  {
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要你的幫助!',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится в Палатах войны Стальгорна.‡Sprecht mit Feldmarschall Schneefall im Militärviertel von Eisenschmiede.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el alguacil de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Tombeneige dans la Garde militaire de Forgefer.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的戰場元帥斯諾·落雪交談。',
  }
},
[8796] = {
  {
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要你的幫助!',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится в Палатах войны Стальгорна.‡Sprecht mit Feldmarschall Schneefall im Militärviertel von Eisenschmiede.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el alguacil de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Tombeneige dans la Garde militaire de Forgefer.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的戰場元帥斯諾·落雪交談。',
  }
},
[8797] = {
  {
    'A Aliança precisa de você!‡Альянсу нужна твоя помощь!‡Die Allianz braucht Euch!‡얼라이언스 지원자 모집!‡¡La Alianza te necesita!‡¡La Alianza te necesita!‡L\'Alliance a besoin de votre aide !‡联盟需要你的帮助！‡聯盟需要你的幫助!',
    nil,
    'Fale com o Marechal-de-campo Nevado na Ala Militar de Altaforja.‡Поговорите с фельдмаршалом Снежной Лавиной, который находится в Палатах войны Стальгорна.‡Sprecht mit Feldmarschall Schneefall im Militärviertel von Eisenschmiede.‡아이언포지의 군사 지구에 있는 야전사령관 스노우폴과 대화하십시오.‡Habla con el alguacil de campo Nevanur en La Sala Militar de Forjaz.‡Habla con el mariscal de campo Nevanur en La Sala Militar de Forjaz.‡Parler au grand maréchal Tombeneige dans la Garde militaire de Forgefer.‡和铁炉堡军事区的大元帅斯诺·落雪谈一谈。‡和鐵爐堡軍事區的戰場元帥斯諾·落雪交談。',
  }
},
[8798] = {
  {
    'Um yeti para chamar de seu‡Твой собственный Йети‡Euer eigener Yeti‡나만의 기계설인‡Un yeti propio‡Un yeti propio‡Un yéti rien que pour vous‡你自己的机械雪人‡你自己的機械雪人',
    nil,
    nil,
  }
},
[8799] = {
  {
    'O herói da ocasião‡Герой дня‡Der Held des Tages‡오늘의 영웅‡El héroe del día‡El héroe del día‡Le héros du jour‡大英雄！‡節日英雄',
    nil,
    'Deposite 1 punhado de Sal Rochafunda e 5 moedas de ouro em qualquer Secadora de Azevinho para receber 5 Azevinhos Secos.‡Принесите 1 порцию глубокоскальной соли и 5 золотых монет к сушилке для остролиста, чтобы получить 5 сушеных остролистов.‡Bringt 1 Tiefsteinsalz und 5 Goldstücke zum Tannenzweigkonservierer. Ihr werdet 5 konservierte Tannenzweige erhalten.‡호랑가시나무 보존기에 깊은바위 소금 한 줌과 5골드를 넣으면 보존된 호랑가시나무를 받게 될 것입니다.‡Lleva 1 porción de sal de roca y 5 monedas de oro al conservante de acebo; recibirás 5 acebos conservados.‡Lleva 1 porción de sal de roca y 5 monedas de oro al conservante de acebo; recibirás 5 acebos conservados.‡Placer 1 Sel de Fonderoc et 5 pièces d\'or dans un Préservateur de houx, et vous recevrez 5 Houx préservés.‡将1份石中盐和5个金币交给冬青树储藏器，以换取5棵冬青树。‡攜帶1份石中鹽及5個金幣到冬青保存機去，你可以獲得5份保存的冬青。',
  }
},
[8800] = {
  {
    'Equipamento de batalha do Forte Cenariano‡Броня Кенария‡Schlachtrüstung des Cenarius‡세나리온 전투장비‡Equipamiento de Cenarius‡Equipamiento de Cenarius‡La tenue de combat cénarienne‡塞纳里奥的装备‡塞納里奧戰鬥工具',
    nil,
    'Apresente-se a Vargus no Forte Cenariano, em Silithus.‡Поговорите с Варгусом в крепости Кенария в Силитусе.‡Sprecht mit Vargus auf Burg Cenarius in Silithus.‡실리더스의 세나리온 요새에 있는 바르구스와 대화해야 합니다.‡Habla con Vargus en el Fuerte Cenarion, en Silithus.‡Habla con Vargus en el Fuerte Cenarion, en Silithus.‡Parlez à Vargus, au Fort cénarien en Silithus.‡与希利苏斯塞纳里奥要塞的瓦古斯谈一谈。‡到希利蘇斯和塞納里奧城堡的瓦古斯談談。',
  }
},
[8801] = {
  {
    'O legado de C\'Thun‡Наследие К\'Туна‡C\'Thuns Vermächtnis‡쑨의 유물‡El legado de C\'Thun‡El legado de C\'Thun‡L\'héritage de C\'Thun‡克苏恩的遗产‡克蘇恩的遺產',
    nil,
    'Leve o Olho de C\'Thun para Celestrasz no Templo de Ahn\'Qiraj.‡Принесите Глаз К\'Туна Келестрасу в Храм Ан\'Кирая.‡Bringt Caelastrasz im Tempel von Ahn\'Qiraj das Auge von C\'Thun.‡안퀴라즈 사원에 있는 캘레스트라즈에게 쑨의 눈을 가져가야 합니다.‡Llévale el ojo de C\'Thun a Caelastrasz en el Templo de Ahn\'Qiraj.‡Llévale el ojo de C\'Thun a Caelastrasz en el Templo de Ahn\'Qiraj.‡Remettre l\'Oeil de C\'Thun a Caelastrasz, dans le temple d\'Ahn\'Qiraj.‡将克苏恩之眼交给安其拉神殿的凯雷斯特拉兹。‡將克蘇恩之眼帶給安其拉神廟的凱雷斯塔茲。',
  }
},
[8802] = {
  {
    'O salvador de Kalimdor‡Спаситель Калимдора‡Der Retter von Kalimdor‡칼림도어의 구세주‡La salvación de Kalimdor‡La salvación de Kalimdor‡Le sauveur de Kalimdor‡卡利姆多的救世主‡卡林多的救星',
    nil,
    'Leve o Olho de C\'Thun para Anacronos nas Cavernas do Tempo.‡Принесите глаз К\'Туна Анахроносу в Пещеры Времени.‡Bringt Anachronos in den Höhlen der Zeit das Auge von C\'Thun.‡시간의 동굴에 있는 아나크로노스에게 쑨의 눈을 가져가야 합니다.‡Llévale el ojo de C\'Thun a Anacronos en las Cavernas del Tiempo.‡Llévale el ojo de C\'Thun a Anacronos en las Cavernas del Tiempo.‡Apporter l\'Oeil de C\'Thun à Anachronos dans les Grottes du temps.‡把克苏恩之眼交给时光之穴的阿纳克洛斯。‡把克蘇恩之眼帶給時光之穴的安納克羅斯。',
  }
},
[8803] = {
  {
    'Um presente festivo‡Подарок в разноцветной упаковке‡Ein Festtagsgeschenk‡축제 선물‡Un obsequio festivo‡Un obsequio festivo‡Un cadeau de fête‡节日礼物‡節慶禮物',
    nil,
    nil,
  }
},
[8804] = {
  {
    'Kits de sobrevivência no deserto‡Неприкосновенный запас‡Wüstenüberlebenspaket‡사막 긴급구호 물자‡Material de supervivencia en el desierto‡Material de supervivencia en el desierto‡Survivre dans le désert‡沙漠生存包‡沙漠生存包',
    nil,
    'Leve 4 Globos de Água, 4 Antipeçonhas Poderosos e 4 Bolinhos Defumados do Deserto para Calandrath na estalagem do Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística I para completar esta tarefa.‡Принесите 4 сферы воды, 4 мощных противоядия и 4 копченые пустынные клецки Каландрате в таверну в крепости Кенария в Силитусе. Кроме того, сдайте тыловую задачу I.‡Bringt 4 Kugeln des Wassers, 4 mächtige Gegengifte und 4 geräucherte Wüstenknödel zu Calandrath in der Taverne von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz I, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새 여관에 있는 캘랜드라스에게 물의 보주, 강력한 해독제, 훈제 사막 경단을 각각 4개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 I도 함께 가져가야 합니다.‡Lleva 4 globos de agua, 4 contravenenos potentes y 4 albóndigas del desierto ahumadas a Calandrath en la taberna del Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas I para poder completar la misión.‡Lleva 4 globos de agua, 4 contravenenos potentes y 4 albóndigas del desierto ahumadas a Calandrath en la taberna del Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas I para poder completar la misión.‡Ramener 4 Globes d\'eau, 4 Anti-venins puissants et 4 Boulettes fumées du désert à Calandrath, à l\'auberge du Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique I.‡把4份纯水之球、4份特效抗毒药剂和4份烤鲑鱼交给希利苏斯塞纳里奥要塞的卡兰德拉斯。你还必须随身带着后勤任务简报 I才能完成这个任务。‡帶4個純水之球，4個特強抗毒藥劑和4個沙漠肉丸子帶到希利蘇斯給塞納里奧城堡旅店的卡蘭德拉斯。你還必須將後勤任務簡報 I帶去才能完成這個任務。',
  }
},
[8805] = {
  {
    'Botas para a guarda‡Сапоги для стражей‡Stiefel für die Wache‡경비대에 장화 공급‡Botas para la guardia‡Botas para la guardia‡Des bottes pour la garde‡卫兵的护甲片‡衛兵的靴子',
    nil,
    'Leve 3 Botas Ornadas de Mithril para Vish Kozus, Capitão da Guarda, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística II para concluir a missão.‡Принесите 3 пары изысканных мифриловых сапог Вишу Коцусу, капитану стражи крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу II.‡Bringt 3 Paar verschnörkelte Mithrilstiefel zu Vish Kozus, Hauptmann der Wache von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz II, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 경비대장 비쉬 코주스에게 화려한 미스릴 장화 3개와 병참 임무 지령 II를 가져가야 합니다.‡Lleva 3 botas de mitril ornamentado a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas II para poder completar la misión.‡Lleva 3 botas de mitril ornamentado a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas II para poder completar la misión.‡Remettre 3 Bottes ornées en mithril à Vish Kozus, capitaine de la garde du Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique II.‡把3双精制秘银战靴交给希利苏斯塞纳里奥要塞的维斯·库鲁兹。你还必须随身带着后勤任务简报 II才能完成这个任务。‡將3雙華麗秘銀戰靴帶到希利蘇斯給塞納里奧城堡的守衛隊長維斯·庫魯茲。你還必須將後勤任務簡報 II帶去才能完成這個任務。',
  }
},
[8806] = {
  {
    'Pedras de amolar para a guarda‡Шлифовальные камни‡Schleifsteine für die Wache‡경비대에 연마석 공급‡Piedra de pulir para la guardia‡Piedra de pulir para la guardia‡Des silex à aiguiser pour la Garde‡卫兵的磨刀石‡衛兵的砂輪',
    nil,
    'Leve 10 Pedras de Amolar Densas, 10 Pedras de Amolar Maciças e 10 Pedras de Amolar Pesadas para Vish Kozus, Capitão da Guarda, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística III para concluir a missão.‡Принесите 10 массивных шлифовальных камней, 10 твердых шлифовальных камней и 10 тяжелых точильных камней Вишу Коцусу, капитану стражи в крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу III.‡Bringt 10 verdichtete Schleifsteine, 10 robuste Schleifsteine und 10 schwere Schleifsteine zu Vish Kozus, Hauptmann der Wache von Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz III, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 경비대장 비쉬 코주스에게 강도 높은 연마석, 견고한 연마석, 단단한 연마석을 각각 10개씩 모아서 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 III도 함께 가져가야 합니다.‡Lleva 10 piedras de pulir densas, 10 piedras de pulir sólidas y 10 piedras de pulir pesadas a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas III para poder completar la misión.‡Lleva 10 piedras de pulir densas, 10 piedras de pulir sólidas y 10 piedras de pulir pesadas a Vish Kozus, Capitán de la guardia del Fuerte Cenarion en Silithus. También debes llevar el Informe de tareas logísticas III para poder completar la misión.‡Apporter 10 Silex à aiguiser denses, 10 Silex à aiguiser solides et 10 Silex à aiguiser lourds à Vish Kozus, capitaine de la garde du Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique III.‡把10块致密砂轮、10块坚固的砂轮和10块重砂轮交给希利苏斯塞纳里奥要塞的维斯·库鲁兹。你还必须随身带着后勤任务简报 III才能完成这个任务。‡將10個緻密砂輪，10個堅固的砂輪和10個重砂輪帶到希利蘇斯給塞納里奧城堡的守衛隊長維斯·庫魯茲。你還必須將後勤任務簡報 III帶去才能完成這個任務。',
  }
},
[8807] = {
  {
    'Matérias-primas de vidência‡Материалы для гадания‡Magische Materialien‡수정점 재료‡Materiales de visión‡Materiales de visión‡Le matériel de divination‡研究材料‡研究材料',
    nil,
    'Leve 1 Estilhaço Brilhante Grande, 1 Estilhaço Radiante Grande e 1 Esmeralda Enorme para a Geóloga Matarriso, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística V para concluir esta missão.‡Принесите 1 большой сияющий осколок, 1 большой светозарный осколок и 1 огромный изумруд геологу Ехидной в крепость Кенария в Силитусе. Также принесите тыловое задание V.‡Bringt 1 großen glänzenden Splitter, 1 großen strahlenden Splitter und 1 gewaltigen Smaragd zu Geologin Lerchenbann auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz V, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 지질학자 락스베인에게 눈부신 큰 결정, 찬란하게 빛나는 큰 결정, 거대한 에메랄드를 각각 1개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 V도 함께 가져가야 합니다.‡Lleva 1 fragmento luminoso grande, 1 fragmento radiante grande y 1 esmeralda enorme a la Geóloga Trotuina en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas V para poder completar la misión.‡Lleva 1 fragmento luminoso grande, 1 fragmento radiante grande y 1 esmeralda enorme a la Geóloga Trotuina en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas V para poder completar la misión.‡Apporter un 1 Grand éclat brillant, 1 Gros éclat irradiant et 1 Enorme émeraude à la géologue Fablemort, au Fort cénarien en Silithus. Pour terminer cette quête, vous devez aussi apporter le Briefing logistique V.‡把1份大块魔光碎片、1份大块强光碎片和1块巨型绿宝石交给希利苏斯塞纳里奥要塞的地质学家拉克斯班。你还必须随身带着后勤任务简报 V才能完成这个任务。‡將1個大塊魔光裂片，1個大塊強光裂片和1個巨型翡翠帶到希利蘇斯給塞納里奧城堡的地理學家拉克斯班。你還必須將後勤任務簡報 V 帶去才能完成這個任務。',
  }
},
[8808] = {
  {
    'Suprimentos de uniformização‡Поставки формы‡Uniformnachschub‡제복 공급‡Suministros para uniformes‡Suministros para uniformes‡La question des uniformes‡制服供应‡制服供應',
    nil,
    'Leve 1 Lunatrama, 2 Peças de Runatrama e 1 Seda de Aranha Ferroteia para o Arauto do Vento Chifre Altivo no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística VIII para cumprir esta missão.‡Принесите 1 кусок луноткани, 2 рулона рунической ткани и 1 железношелковую паутину призывательнице ветров Гордый Рог в крепости Кенария в Силитусе. Кроме того сдайте тыловую задачу VIII.‡Bringt 1 Einheit Mondstoff, 2 Runenstoffballen und 1 Einheit Eisenweberseide zu Windruferin Prachthorn auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz VIII, um diese Aufgabe abschließen zu können.‡바람소환사 프라우드혼에게 달빛 옷감 1개, 룬무늬 두루마리 2개, 강철그물 거미줄 1개를 가져가야 합니다. 또한, 이 임무를 완료하려면 병참 임무 지령 VIII도 함께 가져가야 합니다.‡Lleva 1 tela lunar, 2 madejas de paño rúnico y 1 seda de araña Tejehierro a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas VIII para poder completar la misión.‡Lleva 1 tela lunar, 2 madejas de paño rúnico y 1 seda de araña Tejehierro a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas VIII para poder completar la misión.‡Remettre 1 Etoffe lunaire, 2 Rouleaux d\'étoffe runique et 1 Soie d\'araignée toilacier à l\'Imploratrice céleste Corne-fière au Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique VIII pour terminer cette quête.‡把1块月布、2卷符文布卷和1份铁网蛛丝交给塞纳里奥要塞的唤风者梅恩·长角。你还必须随身带着后勤任务简报 VIII才能完成这个任务。‡將1塊月布，2個符文布卷和1個鐵網蛛絲帶到希利蘇斯給塞納里奧城堡的喚風者傲角。你還必須將後勤任務簡報 VIII帶去才能完成這個任務。',
  }
},
[8809] = {
  {
    'Materiais extraordinários e onde se encontram‡Необычные материалы‡Besondere Materialien‡특별한 재료‡Materiales encantados‡Materiales encantados‡Des matériaux extraordinaires‡特殊的材料‡特殊的材料',
    nil,
    'Leve 2 Barras de Tório Encantado e 2 Couros Encantados para Vargus, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística IX para concluir a missão.‡Принесите Варгусу из крепости Кенария в Силитусе 2 зачарованных ториевых слитка и 2 куска зачарованной кожи. Кроме того, принесите тыловое задание IX.‡Bringt Vargus auf Burg Cenarius in Silithus 2 verzauberte Thoriumbarren und 2 Einheiten verzaubertes Leder. Ihr benötigt auch Logistikeinsatz IX, um diese Aufgabe abschließen zu können.‡실리더스의 세나리온 요새에 있는 바르구스에게 마력 깃든 토륨 주괴 2개, 마력 깃든 가죽 2개를 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 IX도 함께 가져가야 합니다.‡Lleva 2 barras de torio encantado y 2 cueros encantados a Vargus en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas IX para poder completar la misión.‡Lleva 2 barras de torio encantado y 2 cueros encantados a Vargus en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas IX para poder completar la misión.‡Remettre 2 Barres de thorium enchanté et 2 Cuirs enchantés à Vargus au Fort cénarien en Silithus. Vous devez aussi apporter le Briefing logistique IX pour terminer cette quête.‡把2块魔化瑟银锭和2块魔化皮交给希利苏斯塞纳里奥要塞的瓦古斯。你还必须随身带着后勤任务简报 IX才能完成这个任务。‡將2個附魔瑟銀錠和2塊附魔皮到希利蘇斯給塞納里奧城堡的瓦古斯。你還必須將後勤任務簡報 IX帶去才能完成這個任務。',
  }
},
[8810] = {
  {
    'Bandagens para o campo‡Запас бинтов‡Verbände für den Feldeinsatz‡전장에 붕대 공급‡Vendas para el campo de batalla‡Vendas para el campo de batalla‡Des bandages pour la campagne‡战场上的绷带‡戰場上的繃帶',
    nil,
    'Leve 30 Bandagens Grossas de Runatrama, 30 Bandagens Grossas de Seda e 30 Bandagens Grossas de Magitrama para o Arauto do Vento Chifre Altivo, no Forte Cenariano, em Silithus. Você também precisa entregar as Instruções de Logística X para concluir esta missão.‡Принесите 30 плотных бинтов из рунической ткани, 30 плотных шелковых бинтов и 30 плотных бинтов из магической ткани призывательнице ветров Гордый Рог в крепость Кенария в Силитусе. Кроме того сдайте тыловую задачу X.‡Bringt 30 schwere Runenstoffverbände, 30 schwere Seidenverbände und 30 schwere Magiestoffverbände zu Windruferin Prachthorn auf Burg Cenarius in Silithus. Ihr benötigt auch Logistikeinsatz X, um diese Aufgabe abschließen zu können.‡실리더스 세나리온 요새에 있는 바람소환사 프라우드혼에게 두꺼운 룬매듭 붕대, 두꺼운 마법 붕대, 두꺼운 비단 붕대를 각각 30개씩 가져가야 합니다. 또한, 이 퀘스트를 완료하려면 병참 임무 지령 X도 함께 가져가야 합니다.‡Lleva 30 vendas de paño rúnico gruesas, 30 vendas de seda gruesas y 30 vendas de tejido mágico gruesas a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas X para poder completar la misión.‡Lleva 30 vendas de paño rúnico gruesas, 30 vendas de seda gruesas y 30 vendas de tejido mágico gruesas a Clamavientos Cuerno Digno en el Fuerte Cenarion, en Silithus. También debes llevar el Informe de tareas logísticas X para poder completar la misión.‡Apportez 30 Bandages épais en étoffe runique, 30 Bandages épais en soie et 30 Bandages épais en tisse-mage à l\'imploratrice céleste Corne-fière. Vous devez aussi apporter le Briefing logistique X pour terminer cette quête.‡把30根重符文绷带，30根厚丝质绷带和30根厚绒线绷带带给唤风者梅恩·长角。你还必须随身带着后勤任务简报 X才能完成这个任务。‡將30個厚符文布繃帶，30個厚絲質繃帶和30個厚魔紋繃帶到希利蘇斯給塞納里奧城堡的喚風者傲角。你還必須將後勤任務簡報 X帶去才能完成這個任務。',
  }
},
[8811] = {
  {
    'Um sinete de comenda‡Один рекомендательный жетон‡Ein Belobigungsabzeichen‡무공 훈장 1개‡Un sello de honor‡Un sello de honor‡Une chevalière de mérite‡一枚荣誉徽章‡一枚榮譽徽章',
    nil,
    nil,
  }
},
[8812] = {
  {
    'Um sinete de comenda‡Один рекомендательный жетон‡Ein Belobigungsabzeichen‡무공 훈장 1개‡Un sello de honor‡Un sello de honor‡Une chevalière de mérite‡一枚荣誉徽章‡一枚榮譽徽章',
    nil,
    nil,
  }
},
[8813] = {
  {
    'Um sinete de comenda‡Один рекомендательный жетон‡Ein Belobigungsabzeichen‡무공 훈장 1개‡Un sello de honor‡Un sello de honor‡Une chevalière de mérite‡一枚荣誉徽章‡一枚榮譽徽章',
