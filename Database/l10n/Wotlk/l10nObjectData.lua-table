[191941] = {
  '‡ВПЕРВЫЕ В ПРОДАЖЕ! Заколдованные боеприпасы из Азерота и не только!‡NEU! Verzauberte Munition aus Azeroth und darüber hinaus!‡신상품 완비! 아제로스와 각지에서 들여온 마법이 부여된 각종 탄약!‡¡NUEVA MERCANCÍA! ¡Munición encantada de Azeroth y más allá!‡¡NUEVA MERCANCÍA! ¡Munición encantada de Azeroth y más allá!‡NOUVEAUTÉ EN MAGASIN ! Munitions enchantées d\'Azeroth et au-delà !‡全新上架！来自艾泽拉斯和异世界的弹药箭矢！‡大拍賣!從艾澤拉斯來的附魔彈藥還有其他的!'
},
[191942] = {
  '‡Все, что вам нужно – и что не нужно, тоже!‡Alles, was Ihr jemals brauchen könntet - und noch viel mehr!‡당신에게 필요한 모든 것, 그리고 불필요한 것 다수!‡Todo lo que necesitas: ¡y lo que no también!‡Todo lo que necesitas: ¡y lo que no también!‡Tout ce que vous pourrez jamais souhaiter - Et plus encore !‡你所需的一切——还有你不需要的！‡你所有需要的東西 - 還有你不需要的!'
},
[191943] = {
